/* A period inside a closing quotation ends the enclosing sentence too. The
   closed productions record that grammatical fact; no punctuation is inserted
   by the tokenizer and an unquoted program still needs its final period. */
/* A leading time is a program only inside an already announced ability. */
program_sentence ::= program_return_duplicate_perpetual | program_untap_target_linked_phasing | program_revealed_hand_choice_cast_grant | program_sentence_perpetual_quoted_activation | program_sentence_animated_quoted_static | program_exile_copy_return | program_sentence_observed_event_hand_exile | program_sentence_perpetual_casting_grants | program_sentence_action_once | program_sentence_delayed_combat | ordinary_program_sentence | counter_receipt_double_sentence | counter_receipt_goad_sentence | program_sentence_conditional_instead | program_sentence_hand_perpetual | program_sentence_random_hand_perpetual | program_search_exile_permission | program_search_exile_cast_one | program_each_search_exile_cast | program_sentence_chosen_hand_spell_perpetual | program_sentence_revealed_mana_entry | program_sentence_chosen_combat_damage | program_sentence_face_down_hand | program_sentence_exile_grant_cast | program_sentence_seek_free_cast | program_each_exiles_top_play_permission | program_sentence_graveyard_cast_tax | program_sentence_reveal_die_result | program_sentence_random_hand_type_branch | program_self_bonus_controller_sacrifice | program_sentence_mana_next_entry | program_sentence_if_quoted_type_change | emblem_turn_pair_sentence | program_sentence_each_hand_perpetual | receipt_sacrifice_sentence | program_exile_copy_grant | program_chosen_opponent_permanent_restrictions | counter_target_land_followup_quoted | program_sentence_look_permanents_total_value | program_transform_enchantment_attach_controlled | program_chosen_color_combat_trigger | program_random_library_conditional_cast | program_sentence_attached_aura_grant | program_quoted_defining_token_creation | program_sentence_target_discard_draw | optional_copy_quoted_sentence | program_sentence_counter_animated | program_sentence_attached_named_aura | program_optional_untap_control_then_grant | program_counter_land_type_duration | program_sentence_target_vehicle_grants | opponent_targets_phasing_program | program_tap_population_divided_damage | program_event_controller_payment_draw | program_animated_quoted_turn | exchange_failure_sentence | program_untap_optional_retained_land | program_sentence_graveyard_each_grant | returned_target_cast_grant_sentence

/* This limits a successful performance, not the number of triggers. The
   offer owns the complete coordinated program. Declining it or failing a
   required payment leaves the offer available later in the turn.
   Its payment is required after accepting the offer (`clause_required_if_you_do`). */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PlayersDo{players:One(AbilityController), any_one:false, optional:true, once_each_turn:true, body:[Program($program)], otherwise:[]}}]} */
program_sentence_action_once ::= "you" "may" program "." action_once_suffix

/* @sem () */
action_once_suffix ::= "do" "this" "only" "once" "each" "turn" "."

ordinary_program_sentence ::= program_conditional_copy_exception | program_sentence_may_reflexive_quoted | program_sentence_mana_life_persists | program_sentence_search_and_move | program_sentence_die_table | program_sentence_added_die_table | program_sentence_seek_engines | program_sentence_delayed_coin | program_sentence_indefinite_bonus | program_sentence_repeat_mana | program_sentence_move_attachment | program_sentence_plain | program_sentence_quoted | program_sentence_reflexive_modal | program_sentence_reduced_payment | program_tap_x_attack_rewards | explored_self_optional_copy | program_sentence_counter_choice_reflexive_modal | program_sentence_chosen_attackers | program_look_attacking_return | program_damage_other_controller_type_grant | active_control_payment_sentence | program_sentence_indefinite_keyword_trigger | program_counters_controlled_target_conditional_animation

/* @sem $program */
program_sentence_plain ::= program "."

/* @sem Program::Program{instructions:$instructions_quoted} */
program_sentence_quoted ::= instructions_quoted

instructions_quoted ::= instructions_named_token_departure | instructions_conjure_perpetual | instructions_conjured_duplicate_grant | clause_quoted | instructions_before_quoted | instructions_between_quoted | instructions_closed_before_quoted | instructions_if_you_do_quoted | instructions_paid_token_quoted | instructions_chosen_hand_perpetual | instructions_opponent_tap_if_done_quoted | instructions_damage_excess_boon | instructions_named_legendary_scoped | instructions_named_artifact_token_quoted | instructions_exile_card_if_quoted_creation | instructions_then_no_counters_quoted_creation | instructions_same_name_perpetual | instructions_required_if_you_do_quoted | instructions_exile_top_grant_cast_condition | instructions_linked_duplicate_perpetual | instructions_linked_pair_duplicates_perpetual

/* A final quoted grant closes both the token-only continuation and the paid
   conditional sentence. Its dependent effects still share the creation receipt. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[$conditional_token_creation, ...$conditional_token_followups_quoted]}, otherwise:Program{}}] */
instructions_paid_token_quoted ::= "you" "may" payment "." "if" "you" "do" "," conditional_token_creation "." conditional_token_followups_quoted

conditional_token_followups_quoted ::= conditional_token_quoted_one | conditional_token_quoted_more
/* @sem Instruction::[$conditional_token_grant_quoted] */
conditional_token_quoted_one ::= conditional_token_grant_quoted
/* @sem Instruction::[$conditional_token_followup, ...$conditional_token_followups_quoted] */
conditional_token_quoted_more ::= conditional_token_followup "." conditional_token_followups_quoted

/* @sem Instruction::Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($created_reference), changes:$closed_grants, duration:Indefinite, evaluation:Snapshot}} */
conditional_token_grant_quoted ::= created_reference ("gains" | "gain") closed_grants

/* The final quoted ability closes the paid action's conditional sentence. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:$clause_quoted}, otherwise:Program{}}] */
instructions_if_you_do_quoted ::= "you" "may" payment "." "if" "you" "do" "," clause_quoted

/* A leading conditional sentence can precede a final quoted token ability. */
/* @sem Instruction::[...$clause_closed, ...$instructions_quoted] */
instructions_closed_before_quoted ::= clause_closed "." NEWLINE? instructions_quoted

instructions_before_quoted ::= before_quoted_reveal_split | before_quoted_period | before_quoted_then | conjoined_before_quoted
/* A spell can break its line before the final quoted grant. */
/* @sem Instruction::[...$clause, ...$instructions_quoted] */
before_quoted_period ::= clause sequencer NEWLINE? instructions_quoted
/* @sem Vec<Instruction>::@then_sequence($clause_before_then, $instructions_quoted) */
before_quoted_then ::= clause_before_then "," "then" instructions_quoted

/* @sem Instruction::[...$clause_quoted, ...$instructions_quoted] */
instructions_between_quoted ::= clause_quoted instructions_quoted

/* @sem Instruction::[...$clause_quoted, ...$instructions] */
instructions_after_quoted ::= clause_quoted "then"? instructions

clause_quoted ::= clause_operation_create_quoted | clause_perpetual_grant_quoted | clause_entry_counter_boon | clause_continuous_grant_quoted | clause_continuous_pump_grant_quoted | clause_post_move_grant_quoted | clause_imperative_quoted | clause_you_quoted | clause_third_quoted | clause_may_quoted | clause_emblem_quoted | clause_emblem_pair_quoted | clause_emblem_graveyard_permission | clause_emblem_hand_and_trigger | clause_copy_quoted | clause_emblem_single_quoted | clause_exile_grant_turn_ability | clause_named_spell_grant_quoted | clause_one_time_boon | clause_copy_permanent_grants | clause_one_time_cast_perpetual_boon | clause_created_gains_quoted | clause_prior_aura_two_activations | goaded_grant_quoted | clause_operation_you_create_quoted

/* An emblem's final quoted sentence also closes its enclosing sentence. */
/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::CreateEmblem{actor:One(PlayerRef::AbilityController), abilities:[$token_quoted_sentence]}}] */
clause_emblem_quoted ::= "you" "get" "an" "emblem" "with" token_quoted_sentence

/* @sem @apply(PlayerSet::One(PlayerRef::AbilityController), $verbs_base_quoted) */
clause_imperative_quoted ::= verbs_base_quoted

/* @sem @apply(PlayerSet::One(PlayerRef::AbilityController), $verbs_base_quoted) */
clause_you_quoted ::= "you" verbs_base_quoted

/* @sem @apply($players_singular, $verbs_third_quoted) */
clause_third_quoted ::= players_singular verbs_third_quoted

/* @sem Instruction::[Instruction::Optional{decider:AbilityController, body:Program{instructions:$clause_imperative_quoted}}] */
clause_may_quoted ::= "you" "may" clause_imperative_quoted

verbs_base_quoted ::= verb_base_quoted_list | verb_base_attacking_quoted_list | verbs_base_before_quoted

/* @sem Instruction::[$verb_base_quoted] */
verb_base_quoted_list ::= verb_base_quoted

/* @sem Instruction::[...$verbs_base, ...$verb_base_quoted_list] */
verbs_base_before_quoted ::= verbs_base "and" verb_base_quoted_list

/* @sem Instruction::Effect{result:@next, operation:$create_quoted_operation} */
verb_base_quoted ::= create_quoted_operation

create_quoted_operation ::= create_base_quoted | create_each_defined_leading_quoted

verbs_third_quoted ::= verb_third_quoted_list | verbs_third_before_quoted

/* @sem Instruction::[$verb_third_quoted] */
verb_third_quoted_list ::= verb_third_quoted

/* @sem Instruction::[...$verbs_third, ...$verb_third_quoted_list] */
verbs_third_before_quoted ::= verbs_third "and" verb_third_quoted_list

/* @sem Instruction::Effect{result:@next, operation:$create_third_quoted} */
verb_third_quoted ::= create_third_quoted

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:$token_groups_quoted, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_base_quoted ::= "create" token_groups_quoted

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:$token_groups_quoted, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_third_quoted ::= "creates" token_groups_quoted

token_groups_quoted ::= token_groups_quoted_one | token_groups_quoted_pair | token_groups_quoted_list

/* @sem TokenSpec::[$token_group_quoted] */
token_groups_quoted_one ::= token_group_quoted

/* @sem TokenSpec::[$token_group, $token_group_quoted] */
token_groups_quoted_pair ::= token_group "and" token_group_quoted

/* @sem TokenSpec::[$token_group, ...$token_groups_quoted_tail] */
token_groups_quoted_list ::= token_group "," token_groups_quoted_tail

token_groups_quoted_tail ::= token_groups_quoted_last | token_groups_quoted_more

/* @sem TokenSpec::[$token_group_quoted] */
token_groups_quoted_last ::= "and" token_group_quoted

/* @sem TokenSpec::[$token_group, ...$token_groups_quoted_tail] */
token_groups_quoted_more ::= token_group "," token_groups_quoted_tail

token_group_quoted ::= token_named_x_quoted | token_defined_named_after_quoted | token_defined_quoted | token_copy_quoted | token_equal_then_quoted | token_explicit_artifact_quoted | token_defined_named_activation_after
/* @sem TokenSpec::TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:$token_recipe_quoted} */
token_defined_quoted ::= token_amount token_recipe_quoted

/* The quoted ability's period closes the creation sentence too. */
/* @sem TokenSpec::TokenSpec{amount:$token_copy_quantity, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:$copy_exceptions_closed}} */
token_copy_quoted ::= token_copy_quantity object_ref "," "except" copy_exceptions_closed

token_recipe_quoted ::= token_recipe_quoted_standard | token_creature_recipe_quoted

token_description_quoted ::= token_description_with_quoted | token_description_after_quoted
    | token_description_with_then_quoted | token_description_after_then_quoted

/* @sem $token_abilities_quoted */
token_description_with_quoted ::= "with" token_abilities_quoted

/* @sem $token_abilities_quoted */
token_description_after_quoted ::= "." token_ability_subject token_abilities_quoted

/* @sem Ability::[...$token_abilities, ...$token_description_quoted] */
token_description_with_then_quoted ::= "with" token_abilities token_description_quoted

/* @sem Ability::[...$token_abilities, ...$token_description_quoted] */
token_description_after_then_quoted ::= "." token_ability_subject token_abilities token_description_quoted

token_abilities_quoted ::= nested_token_abilities_quoted | token_abilities_quoted_one | token_abilities_quoted_pair | token_abilities_quoted_list

/* @sem Ability::[$token_quoted_sentence] */
token_abilities_quoted_one ::= token_quoted_sentence

/* @sem Ability::[$token_ability, $token_quoted_sentence] */
token_abilities_quoted_pair ::= token_ability "and" token_quoted_sentence

/* @sem Ability::[$token_ability, ...$token_abilities_quoted_tail] */
token_abilities_quoted_list ::= token_ability "," token_abilities_quoted_tail

token_abilities_quoted_tail ::= token_abilities_quoted_last | token_abilities_quoted_more

/* @sem Ability::[$token_quoted_sentence] */
token_abilities_quoted_last ::= "and" token_quoted_sentence

/* @sem Ability::[$token_ability, ...$token_abilities_quoted_tail] */
token_abilities_quoted_more ::= token_ability "," token_abilities_quoted_tail

/* A quoted keyword without a period does not end the enclosing sentence. */
/* @sem Ability::@holder($token_ability_sentence) */
token_quoted_sentence ::= '"' token_ability_sentence '"'

token_ability_sentence ::= static_controlled_subtype_single_quote | static_assign_as_unblocked | departure_granted_triggers | triggered_counter_receipt_opponent | triggered_counter_receipt_optional | ordered_named_reveal_discard | paired_combat_leave_delayed | triggered_once_entry | harnessed_turn_trigger | replacement_holder_combat_half_draw | casting_spend_any_type | triggered_cast_entry_counters | replacement_mana_type_single | static_player_color_spending | static_quoted_grant | max_speed_sentence | reminded_action_ability | labelled_action_reminder | spell_ability | activated_ability | activated_forecast | activated_boast | activated_power_up | activated_limited | activated_loyalty | triggered_ability | triggered_once | triggered_if | triggered_cast_if | triggered_turn | triggered_turn_if | static_ability | static_conditional | static_conditional_first | static_conditional_first_closed | static_during_turn | static_player_prohibition | static_player_prohibition_if | replacement_ability | replacement_clause | token_defining_both | token_defining_power | token_defining_toughness | token_labelled_sentence | emblem_cast_spell_grant | emblem_cast_spell_cost | triggered_life_amount_pump | quoted_cumulative_mana | quoted_cumulative_words | quoted_bands_with_others | static_untap_each_other_untap | activated_untap_symbol | static_ordinary_ability | source_cast_trigger | additional_trigger_source_or_emblem | graveyard_optional_library_replacement | activated_creature_damage_override | replacement_untap_counter_payment | plural_entry_replacement | emblem_play_linked_any_color | static_free_cast_from_own_zone | token_death_subject_trigger | static_keyword_and_single_quoted_activation

/* A final quoted sentence closes a duration-led grant too. The existing
   token_quoted_sentence enforces its inner period and resets the holder. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$closed_grants, duration:$duration, evaluation:Snapshot}}] */
clause_continuous_grant_quoted ::= duration "," affected ("gains" | "gain") closed_grants
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[...$change_pump, ...$closed_grants], duration:$duration, evaluation:Snapshot}}] */
clause_continuous_pump_grant_quoted ::= duration "," affected change_pump "and" ("gains" | "gain") closed_grants

closed_grants ::= closed_player_rule_pair | closed_activation_pair | closed_grant_word_ward | closed_grant_ability | closed_grant_keyword_prefix | closed_grant_exhaust | closed_grant_pair | closed_grant_keyword_comma_and | closed_grant_keyword_comma | closed_unattach_payment_grant | closed_activation_aim_pair | closed_two_quoted_grants
/* @sem Change::[GrantAbility($token_quoted_sentence)] */
closed_grant_ability ::= token_quoted_sentence
/* @sem Change::[$grant_keyword, ...$closed_grants] */
closed_grant_keyword_prefix ::= grant_keyword "and" closed_grants

/* The ability's own closing period also ends this perpetual grant. Scalar
   references retain the current moved/selected object; closed_grants resets
   the holder. Private graveyard cards use the pinned AnyZone/AddAbility form. */
clause_perpetual_grant_quoted ::= topmost_library_perpetual_clause | perpetual_graveyard_copy_grant | perpetual_random_event_hand_grant | perpetual_quote_scalar_grant | perpetual_quote_cards_grant | perpetual_quote_choose_grant | perpetual_quote_exile_grant | perpetual_hand_capped_grant | perpetual_defending_hand_grant | perpetual_quote_population_replacement
/* @sem Instruction::[Effect{result:@next, operation:CreatePerpetualEffect{objects:$perpetual_quote_scalar, changes:$closed_grants}}] */
perpetual_quote_scalar_grant ::= perpetual_quote_scalar "perpetually" ("gains" | "gain") closed_grants
/* @sem ObjectSet::One($perpetual_quote_reference) */
perpetual_quote_scalar ::= perpetual_quote_reference
perpetual_quote_reference ::= self_ref | exiled_card_ref | target_object | attached_ref | target_card

/* InZone restricts the AnyZone query to existing cards in this graveyard.
   card_permanent supplies all six permanent card types, not Creature only.
   token_quoted_sentence resets the granted holder inside the typed operand. */
/* @sem Instruction::[Effect{result:@next, operation:EffectOn{subject:Objects(AnyZone(AllOf([$card_noun, InZone(Players{zone:Graveyard, players:One($zone_owner)})]))), effects:[Term{family:PerpetualEffect, form:AddAbility, operands:[Ability($token_quoted_sentence)]}]}}] */
perpetual_quote_cards_grant ::= "all"? card_noun "cards" "in" zone_owner "graveyard" "perpetually" ("gains" | "gain") token_quoted_sentence

/* A literal choice establishes this one current card; generic @it does not
   establish a selection receipt. Require a card noun even after qualities. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$perpetual_chosen_card_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$closed_grants}}] */
perpetual_quote_choose_grant ::= "choose" ("a" | "an") perpetual_chosen_card_filter "card" "in" "your" "hand" "." "it" "perpetually" "gains" closed_grants
perpetual_chosen_card_filter ::= card_noun | filter_instant_or_sorcery | perpetual_chosen_card_qualified
/* @sem @and($quality, $perpetual_chosen_card_filter) */
perpetual_chosen_card_qualified ::= quality perpetual_chosen_card_filter

/* An explicit exile followed immediately by this grant names its actual
   resulting incarnation, without reopening ordinary bare-pronoun fallback. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_object), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:@exile_followup(One(Result{result:@prior, phase:After, index:0})), changes:$closed_grants}}] */
perpetual_quote_exile_grant ::= "exile" target_object "." "it" "perpetually" "gains" closed_grants

/* A casting rule printed on the granted card; no surrounding source query. */
/* @sem Ability::Casting(SpendAsThoughAnyType) */
casting_spend_any_type ::= "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "this" "spell" "."

/* The singular duplicate owns this immediately following printed grant. */
/* @sem Instruction::[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Duplicate(One($conjured_duplicate_target)), count:Constant(1), destination:Hand(CardArrival{counters:[], states:[]})}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$closed_grants}}] */
instructions_conjured_duplicate_grant ::= "conjure" "a" "duplicate" "of" conjured_duplicate_target "into" "your" "hand" "." "it" "perpetually" "gains" closed_grants

conjured_duplicate_target ::= target_card | target_card_opponent_graveyard

/* A granted group owns two independent event scopes inside its new holder.
   Destination-sensitive bodies must bind before equal bodies can be merged. */
departure_granted_triggers ::= departure_granted_separate | departure_granted_joined

/* @sem Ability::Triggers([@scope(Ability::Triggered{event:ZoneChange{objects:$death_exile_object, from:Battlefield, to:Graveyard}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}), @scope(Ability::Triggered{event:ZoneChange{objects:$death_exile_object, from:Battlefield, to:Exile}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})]) */
departure_granted_separate ::= ("when" | "whenever") death_exile_object "," program_sentence

/* @sem Ability::Triggers([@scope(Ability::Triggered{event:@either_event(EventSpec::ZoneChange{objects:$death_exile_object, from:Battlefield, to:Graveyard}, EventSpec::ZoneChange{objects:$death_exile_object, from:Battlefield, to:Exile}), limits:TriggerLimits{}, announcement:@announcement, body:$departure_independent_sentence})]) */
departure_granted_joined ::= ("when" | "whenever") death_exile_object "," departure_independent_sentence

departure_independent_sentence ::= departure_draw_sentence | departure_life_sentence | departure_damage_sentence | departure_destroy_sentence | death_library_independent_sentence

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}]} */
departure_draw_sentence ::= "draw" card_count "."
/* @sem Program::Program{instructions:[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:$number}}]} */
departure_life_sentence ::= "you"? "gain" number "life" "."
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Players(One(AbilityController)), amount:$number, preventable:true}}]} */
departure_damage_sentence ::= self_explicit_ref "deals" number "damage" "to" "you" "."
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Destroy{objects:One($target_object), regeneration:true}}]} */
departure_destroy_sentence ::= "destroy" target_object "."

/* A quoted worded ward price carries its own sentence-ending period. */
/* @sem Change::[GrantKeyword(Ward(Cost{parts:$keyword_word_parts}))] */
closed_grant_word_ward ::= '"' ("ward" | "↑" "ward") keyword_word_parts '"'

/* Two separately quoted abilities retain the emblem as their holder. */
/* @sem Instruction::[Effect{result:@next, operation:CreateEmblem{actor:One(AbilityController), abilities:[$emblem_open_static, $token_quoted_sentence]}}] */
clause_emblem_pair_quoted ::= "you" "get" "an" "emblem" "with" emblem_open_static "and" token_quoted_sentence

/* @sem Ability::@holder(Ability::Static{kind:Ordinary, affected:Objects($affected), changes:$static_changes}) */
emblem_open_static ::= '"' affected static_changes '"'

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$perpetual_hand_casting_grants}]} */
program_sentence_perpetual_casting_grants ::= perpetual_hand_casting_grants

/* Quoted mechanics compose with any ordinary grant subject. */
/* @sem Ability::Mechanic{mechanic:CumulativeUpkeep, cost:Cost{parts:$keyword_mana_parts}} */
quoted_cumulative_mana ::= "cumulative" "upkeep" keyword_mana_parts "."

/* @sem Ability::Mechanic{mechanic:CumulativeUpkeep, cost:Cost{parts:$keyword_word_parts}} */
quoted_cumulative_words ::= "cumulative" "upkeep" keyword_word_parts

/* @sem Ability::Mechanic{mechanic:BandsWithOthers, filter:$filter_plural} */
quoted_bands_with_others ::= "↓" "bands" "with" "other" filter_plural "."

/* The random selection and its perpetual grant share the actual selection receipt.
   The quoted ability creates a fresh holder and scope. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(EventSubject)}, kind:Card, filter:$adjective_nontype}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$closed_grants}}] */
perpetual_random_event_hand_grant ::= "a" "random" adjective_nontype "card" "in" "that" "player's" "hand" "perpetually" "gains" closed_grants

/* @sem Instruction::[$verb_base_attacking_quoted] */
verb_base_attacking_quoted_list ::= verb_base_attacking_quoted

/* @sem Instruction::Effect{result:@next, operation:$create_prefix_attacking_quoted} */
verb_base_attacking_quoted ::= create_prefix_attacking_quoted

token_recipe_quote_base ::= token_recipe_base | token_named_artifact_base

/* The entry modifier belongs to the creation, not to the token recipe. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[$token_prefix_attacking_quoted], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_prefix_attacking_quoted ::= "create" token_prefix_attacking_quoted

/* @sem TokenSpec::TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:$token_recipe_quoted} */
token_prefix_attacking_quoted ::= token_amount "tapped" "and" "attacking" token_recipe_quoted

/* An explicit token name remains separate from its colors and types. */
/* @sem TokenRecipe::Defined{name:Explicit($created_token_name), colors:$token_colors, card_types:[Artifact]} */
token_named_artifact_base ::= token_colors "artifact" "token" "named" created_token_name

/* The emblem owns its quoted graveyard permission; the loyalty cost is supplied by the enclosing activation. */
/* @sem Instruction::[Effect{result:@next, operation:CreateEmblem{actor:One(AbilityController), abilities:[$emblem_graveyard_permission]}}] */
clause_emblem_graveyard_permission ::= "you" "get" "an" "emblem" "with" '"' emblem_graveyard_permission '"'

emblem_graveyard_permission ::= emblem_cast_graveyard_exile | emblem_play_land_cast_permanent

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:$cast_kind_pair_spells}, terms:_{cost:Normal, into_exile:true}})]}) */
emblem_cast_graveyard_exile ::= "you" "may" "cast" cast_kind_pair_spells "from" "your" "graveyard" "." "if" "a" "spell" "cast" "this" "way" "would" "be" "put" "into" "your" "graveyard" "," "exile" "it" "instead" "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:CardType(Land)}), from:Graveyard, action:PlayLand, filter:Any}), PlayerRule(PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)])})]}) */
emblem_play_land_cast_permanent ::= "you" "may" "play" "lands" "and" "cast" "permanent" "spells" "from" "your" "graveyard" "."

/* The first quotation has no final period, while the triggered ability does. */
/* @sem Instruction::[Effect{result:@next, operation:CreateEmblem{actor:One(AbilityController), abilities:[$emblem_open_hand_size, $emblem_owned_card_return]}}] */
clause_emblem_hand_and_trigger ::= "you" "get" "an" "emblem" "with" emblem_open_hand_size "and" emblem_owned_card_return

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(HandSize(Unlimited))]}) */
emblem_open_hand_size ::= '"' "you" "have" "no" "maximum" "hand" "size" '"'

/* This return is tied to the destination of the card entering its owner's graveyard. */
/* @sem Ability::@scope(Ability::Triggered{event:ZoneChange{objects:AllOf([$graveyard_card_unqualified, OwnedBy(One(AbilityController)), Not(Token)]), to:Graveyard}, limits:_{}, announcement:@announcement, body:_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]}}) */
emblem_owned_card_return ::= '"' "whenever" graveyard_card_unqualified "is" "put" "into" "your" "graveyard" "from" "anywhere" "," "you" "may" "return" "it" "to" "your" "hand" "." '"'

/* A later conditional replaces the earlier instruction rather than following it. */
/* @sem Program::Program{instructions:[If{condition:$condition_control_named_pair, then:$program_2, otherwise:$program}]} */
program_sentence_conditional_instead ::= program "." "if" condition_control_named_pair "," program "instead" "."

/* The granted exhaust activation retains the holder and its own scope. */
/* @sem Change::[GrantAbility(@holder($activated_exhaust))] */
closed_grant_exhaust ::= '"' activated_exhaust '"'

/* The quoted sentence supplies its own terminal period. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$hand_cards_perpetual_reduction}]} */
program_sentence_hand_perpetual ::= hand_cards_perpetual_reduction

/* @sem Program::Program{instructions:$instructions_random_hand_grant_cast_discount} */
program_sentence_random_hand_perpetual ::= instructions_random_hand_grant_cast_discount

/* @sem Program::Program{instructions:$instructions_choose_hand_perpetual} */
program_sentence_chosen_hand_spell_perpetual ::= instructions_choose_hand_perpetual

/* A quoted conjunction of player prohibitions grants each rule to the same holder. */
/* @sem Change::[GrantAbility(@holder($player_rule_ability)), GrantAbility(@holder($player_rule_ability_2))] */
closed_player_rule_pair ::= '"' player_rule_ability "and" player_rule_ability "." '"'

/* The quantity and the following intrinsic abilities independently qualify the recipe. */
/* @sem TokenSpec::TokenSpec{amount:$value, words:CreatingEffect, recipe:@token_abilities($token_recipe_quote_base, $token_description_after_quoted)} */
token_equal_then_quoted ::= "a" "number" "of" token_recipe_quote_base "equal" "to" value token_description_after_quoted

/* The anaphor in this continuation names the source introduced by the first clause. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$source_explores}, $optional_source_copy]} */
explored_self_optional_copy ::= source_explores "." "then" optional_source_copy "."

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Explore{object:Source}} */
source_explores ::= "this" "creature" "explores"

/* @sem Instruction::Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), $noun, ControlledBy(One(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[CopyOf{object:Result{result:@prior, phase:After, index:0}, exceptions:[]}], duration:$duration, evaluation:Snapshot}}]}} */
optional_source_copy ::= "you" "may" "have" "it" "become" "a" "copy" "of" "another" noun "you" "control" duration

/* The event's player owns the exiled card; payment and its continuation remain linked. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(Zone(_{scope:Shared(Exile), kind:Card, filter:OwnedBy(One(EventSubject))})), kind:$counter_kind, amount:Count(Exactly(Constant(1))), selection:_{player:AbilityController, count:Exactly(Constant(1))}}]}]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Constant(1)}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$number, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{}}]} */
quoted_remove_owned_counter_draw_tokens ::= "you" "may" "remove" "a" counter_kind "counter" "from" "a" "card" "that" "player" "owns" "in" "exile" "." "if" "you" "do" "," "draw" "a" "card" "and" "create" number token_named_recipe "tokens"

/* The two sentences describe one damage action with a conditional amount.
   Both branches retain the same announced target and granted holder. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$creature_damage_override} */
activated_creature_damage_override ::= cost ":" creature_damage_override

/* @sem Program::Program{instructions:[If{condition:ObjectMatches{object:Source, filter:$subtype}, then:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:$noun, players:All})), amount:$number_digits_2, preventable:true}}]}, otherwise:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Targets(0), amount:$number_digits, preventable:true}}]}}]} */
creature_damage_override ::= "this" "creature" "deals" number_digits "damage" "to" "target" "player" "or" noun "." "if" "this" "creature" "is" "a" subtype "," "it" "deals" number_digits "damage" "instead" "."

/* A graveyard target receives an ability scoped to the card's graveyard. */
/* @sem Instruction::[Effect{result:@next, operation:CreatePerpetualEffect{objects:One($perpetual_graveyard_target), changes:[GrantAbility($graveyard_exile_copy_activation)]}}] */
perpetual_graveyard_copy_grant ::= perpetual_graveyard_target "perpetually" "gains" '"' graveyard_exile_copy_activation '"'

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($card_filter, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0} */
perpetual_graveyard_target ::= "target" card_filter "card" "in" "your" "graveyard"

/* The quoted token ability closes a coordinated action sentence. */
/* @sem Instruction::[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:$token_groups_quoted, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
clause_operation_create_quoted ::= operation "and" "create" token_groups_quoted /* @prefer always */

/* Two separately scoped granted abilities; only the final quote closes the sentence. */
/* @sem Change::[GrantAbility(@holder($replacement_enters_counters_clause)), GrantAbility($token_quoted_sentence)] */
closed_grant_pair ::= '"' replacement_enters_counters_clause '"' "and" token_quoted_sentence

/* The damage operation and its excess-damage consumer share one marked result.
   The boon owns its cast event and its independently announced targets. */
/* @sem Instruction::[Effect{result:@mark, operation:$deal_damage}, If{condition:Compare{left:ExcessDamage{result:@marked, to:Any}, test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:Note(Number(ExcessDamage{result:@marked, to:Any}))}, $excess_boon]}, otherwise:Program{}}] */
instructions_damage_excess_boon ::= deal_damage "." "if" "excess" "damage" "was" "dealt" "this" "way" "," "note" "that" "excess" "damage" "," "then" excess_boon

/* @sem Instruction::Effect{result:@next, operation:@scope(Operation::CreateTrigger{event:$event_cast, duration:Indefinite, announcement:@announcement, body:Program{instructions:[$excess_boon_effect]}, once:true})} */
excess_boon ::= "you" "get" "a" "one-time" "boon" "with" '"' "when" event_cast "," excess_boon_effect "." '"'

excess_boon_effect ::= excess_boon_pump | excess_boon_damage

/* @sem Instruction::Effect{result:@next, operation:CreatePerpetualEffect{objects:One(EventSubject), changes:[Pump{power:Noted{measure:Number}, toughness:Constant(0)}]}} */
excess_boon_pump ::= "it" "perpetually" "gets" "+" "X" "/" "+" "0" "," "where" "X" "is" "the" "noted" "number"

/* @sem Instruction::Effect{result:@next, operation:DealDamage{source:Source, recipients:$recipients, amount:Noted{measure:Number}, preventable:true}} */
excess_boon_damage ::= "this" "boon" "deals" "damage" "equal" "to" "the" "noted" "number" "to" recipients

/* Explicit names and quoted abilities are operands of the created recipe. */
/* @sem TokenSpec::TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:Defined{name:Explicit(Banana), colors:$token_colors, card_types:[Artifact], abilities:$token_abilities_quoted}} */
token_explicit_artifact_quoted ::= token_amount token_colors "artifact" "token" "named" "Banana" "with" token_abilities_quoted

/* @sem Instruction::[Effect{result:@next, operation:CreateEmblem{actor:One(AbilityController), abilities:[@holder($loyalty_activation_permission)]}}] */
clause_emblem_single_quoted ::= "you" "get" "an" "emblem" "with" "'" loyalty_activation_permission "'"

/* A counter condition follows the completed action; the quote belongs to the token. */
/* @sem Instruction::[Effect{result:@next, operation:$operation}, If{condition:$condition_no_counters, then:Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(AbilityController), $create_base_quoted)}]}, otherwise:Program{}}] */
instructions_then_no_counters_quoted_creation ::= operation "." "then" "if" condition_no_counters "," create_base_quoted

/* The tested result is the arrival of this exact single-card exile producer. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One($target_any_card_a_graveyard), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$card_filter}, then:Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(AbilityController), $create_base_quoted)}]}, otherwise:Program{}}] */
instructions_exile_card_if_quoted_creation ::= "exile" target_any_card_a_graveyard "." "if" "a" card_filter "card" "is" "exiled" "this" "way" "," create_base_quoted

/* The selected pile is the result of this separation, chosen by the active player. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:SeparatePiles{separator:AbilityController, chooser:$player_ref, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One($player_ref))])}}}, Effect{result:@next, operation:ChangeCombat{change:OnlyAttackers{objects:Selected(@marked)}}}]} */
program_sentence_chosen_attackers ::= "separate" "all" "creatures" player_ref "controls" "into" "two" "piles" "." "only" "creatures" "in" "the" "pile" "of" "their" "choice" "can" "attack" "this" "turn" "."

/* A hand population and its grant are independent of any preceding action.
   The quoted ability establishes its own holder and stack scope. */
/* @sem Instruction::[Effect{result:@next, operation:CreatePerpetualEffect{objects:$perpetual_hand_capped_population, changes:$closed_grants}}] */
perpetual_hand_capped_grant ::= perpetual_hand_capped_population "perpetually" "gain" closed_grants

/* @sem ObjectSet::Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AllOf([$adjective_nontype, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])}) */
perpetual_hand_capped_population ::= adjective_nontype "cards" "in" "your" "hand" "with" "mana" "value" value "or" "less"

/* The receipt and its destination are proved by the adjacent exile producer.
   The granted permission belongs to each exiled card, not the original source. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:EffectOn{subject:Objects(Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([InSet(Transition{result:@prior, phase:After}), $filter_phrase])})), effects:[Term{family:ExiledCardEffect, form:AddAbility, operands:[Ability(Scoped{zones:[Exile], condition:$condition, ability:Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Source), from:Exile, action:CastSpell, filter:Any})]})})]}]}}]} */
program_sentence_exile_grant_cast ::= exile_top_cards_of_your_library "." filter_phrase "cards" "exiled" "this" "way" "gain" '"' "you" "may" "cast" "this" "card" "from" "exile" "as" "long" "as" condition "." '"'

/* The defending player belongs to the attack event, while the quoted ability has its own holder. */
/* @sem Instruction::[Effect{result:@next, operation:CreatePerpetualEffect{objects:Zone(_{scope:Players{zone:Hand, players:One(DefendingPlayerOf(EventSubject))}, kind:Card, filter:$adjective_nontype}), changes:$closed_grants}}] */
perpetual_defending_hand_grant ::= "each" adjective_nontype "card" "in" "defending" "player's" "hand" "perpetually" "gains" closed_grants

/* Comma-separated keyword grants continue into a final quoted ability. */
/* @sem Change::[$grant_keyword, ...$closed_grants] */
closed_grant_keyword_comma ::= grant_keyword "," closed_grants

/* @sem Change::[$grant_keyword, ...$closed_grants] */
closed_grant_keyword_comma_and ::= grant_keyword "," "and" closed_grants

/* The quoted replacement closes the perpetual grant sentence. */
/* @sem Instruction::[Effect{result:@next, operation:CreatePerpetualEffect{objects:$affected, changes:$perpetual_gain_replacement}}] */
perpetual_quote_population_replacement ::= affected "perpetually" perpetual_gain_replacement

/* The death-event subject is the object that deals this damage. */
/* @sem Ability::Triggered{event:$event_self_dies, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$death_subject_damage}]}} */
token_death_subject_trigger ::= "when" event_self_dies "," death_subject_damage "."

/* @sem Operation::DealDamage{source:EventSubject, recipients:$recipients, amount:$number, preventable:true} */
death_subject_damage ::= "it" "deals" number "damage" "to" recipients

/* An intervening condition can introduce an explicit controller instruction. */
/* @sem Ability::Triggered{event:$event_clause, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$clause_you_quoted}} */
/* @prefer always */
triggered_if_you_quoted ::= event_clause "," "if" condition "," clause_you_quoted

/* A named source here identifies the spell, not an antecedent permanent. */
/* @sem Instruction::[Effect{result:@next, operation:ChangeSpell{subject:One(Source), changes:$spell_gains_quoted_trigger}}] */
clause_named_spell_grant_quoted ::= SELF_NAME spell_gains_quoted_trigger

/* Required payment and its quoted conditional follow-up share the receipt. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:false}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:$clause_quoted}, otherwise:Program{}}] */
instructions_required_if_you_do_quoted ::= payment "." "if" "you" "do" "," clause_quoted

/* A one-time boon creates a single-use trigger with its own event and body. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:$event_clause, duration:Indefinite, announcement:@announcement, body:$program, once:true}}] */
clause_one_time_boon ::= "you" "get" "a" "one-time" "boon" "with" '"' event_clause "," program "." '"'

/* The quoted callback closes the surrounding optional reflexive sentence. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:$reflexive_pay_operation}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:Program{instructions:$clause_quoted}})}]}}]} */
program_sentence_may_reflexive_quoted ::= "you" "may" reflexive_pay_operation "." "when" "you" "do" "," clause_quoted

/* The quoted sentence supplies its own final punctuation. */
/* @sem Program::Program{instructions:[If{condition:ObjectMatches{object:$self_ref, filter:$filter_phrase}, then:Program{instructions:[Effect{result:@next, operation:$indefinite_quoted_type_change}]}, otherwise:Program{}}]} */
program_sentence_if_quoted_type_change ::= "if" self_ref "is" "a" filter_phrase "," indefinite_quoted_type_change

/* Two independently scoped abilities on the same emblem. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateEmblem{actor:One(AbilityController), abilities:[@scope($emblem_turn_clause), @scope($emblem_turn_clause_2)]}}]} */
emblem_turn_pair_sentence ::= "you" "get" "an" "emblem" "with" '"' emblem_turn_clause '"' "and" '"' emblem_turn_clause "." '"'

/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$program} */
emblem_turn_clause ::= "at" turn_event "," program

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$each_hand_card_perpetual_reduction}]} */
program_sentence_each_hand_perpetual ::= each_hand_card_perpetual_reduction

/* The payment and its later unattachment test form one activation contract. */
/* @sem Change::[GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[TapSymbol, Unattach(GrantingObject)]}, limits:_{}, body:$unattach_payment_damage_program, announcement:@announcement}))] */
closed_unattach_payment_grant ::= '"' "{" "T" "}" "," "↑" "unattach" self_named ":" unattach_payment_damage_program '"'

/* The conditional continuation is tied to the entering spell's event subject;
   the quoted consequence itself retains its own producer and receipt. */
/* @sem Instruction::[...$entry_kicked_prefix, $entry_kicked_conditional_quoted] */
entry_kicked_quoted_followup ::= entry_kicked_prefix "." entry_kicked_conditional_quoted

entry_kicked_prefix ::= clause | personal_graveyard_return_clause

/* @sem Instruction::[Effect{result:@next, operation:$personal_graveyard_return_hand}] */
personal_graveyard_return_clause ::= personal_graveyard_return_hand

/* @sem Instruction::If{condition:ObjectMatches{object:Source, filter:State(Kicked)}, then:Program{instructions:$conditional_duplicate_grant}, otherwise:Program{}} */
entry_kicked_conditional_quoted ::= "if" "this" "spell" "was" "kicked" "," conditional_duplicate_grant

/* @sem Ability::Triggered{event:$event_self_enters, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$entry_kicked_quoted_followup}} */
triggered_entry_kicked_quoted_followup ::= "when" event_self_enters "," entry_kicked_quoted_followup

/* The in-zone spelling is the default within this conditional duplicate phrase. */
/* @prefer always */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:InZone(Players{zone:Graveyard, players:OpponentsOf(AbilityController)})}), index:0} */
conditional_duplicate_opponent_card ::= "target" "card" "in" "an" "opponent's" "graveyard"

/* @prefer always */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($card_filter, ObjectFilter::InZone(Players{zone:Graveyard, players:OpponentsOf(PlayerRef::AbilityController)}))}), index:0} */
conditional_duplicate_opponent_filtered ::= "target" card_filter "card" "in" "an" "opponent's" "graveyard"

conditional_duplicate_target ::= conditional_duplicate_opponent_card | conditional_duplicate_opponent_filtered | conditional_duplicate_your_card | conditional_duplicate_your_filtered | conjured_duplicate_target

/* @sem Instruction::[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Duplicate(One($conditional_duplicate_target)), count:Constant(1), destination:Hand(CardArrival{counters:[], states:[]})}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$closed_grants}}] */
conditional_duplicate_grant ::= "conjure" "a" "duplicate" "of" conditional_duplicate_target "into" "your" "hand" "." "it" "perpetually" "gains" closed_grants

/* @prefer always */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}), index:0} */
conditional_duplicate_your_card ::= "target" "card" "in" "your" "graveyard"

/* @prefer always */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($card_filter, ObjectFilter::InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}))}), index:0} */
conditional_duplicate_your_filtered ::= "target" card_filter "card" "in" "your" "graveyard"

/* The copy consumes the actual exile arrival, and the grant consumes the
   token creation receipt. Keeping the three instructions together proves both links. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([AnyOf([$adjective_color, $adjective_color_2, $adjective_color_3]), $noun, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Result{result:@prior, phase:After, index:0}, exceptions:[CopyException::SetPowerToughness{power:$number_digits, toughness:$number_digits_2}]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Created(@prior)), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}]} */
program_exile_copy_grant ::= "exile" "target" adjective_color "," adjective_color "," "or" adjective_color noun "card" "from" "your" "graveyard" "." "create" "a" "token" "that's" "a" "copy" "of" "that" "card" "," "except" "it's" number_digits "/" number_digits "." "it" "gains" keyword_name duration "."

/* The follow-up refers to the targeted land, while the quoted activation gets
   its own ability frame. The placed and tested counter kinds are independent. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Land)}), index:0})), kind:$counter_kind, amount:Constant(1)}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:0, index:0})), changes:[RemoveAllLandTypes, RemoveAllAbilities, GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program_sentence}))], duration:WhileMatches{object:Affected, filter:Counters(_{kind:$counter_kind_2, comparison:Greater, value:Constant(0)})}, evaluation:Snapshot}}]} */
counter_target_land_followup_quoted ::= "put" "a" counter_kind "counter" "on" "target" "land" "." "for" "as" "long" "as" "that" "land" "has" "a" counter_kind "counter" "on" "it" "," "it" "loses" "all" "land" "types" "and" "abilities" "and" "has" '"' cost ":" program_sentence '"'

/* The quoted final sentence supplies its own period. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$quoted_static_animation_operation}]} */
program_sentence_animated_quoted_static ::= quoted_static_animation_operation

/* @sem Instruction::[Effect{result:@next, operation:$topmost_library_perpetual}] */
topmost_library_perpetual_clause ::= topmost_library_perpetual

/* A singular named token can state a death-triggered ability in a following sentence. */
/* @prefer always */
/* @sem TokenSpec::TokenSpec{amount:$named_token_singular_amount, words:CreatingEffect, recipe:@token_abilities($token_recipe_explicit_name, $named_token_death_abilities)} */
token_defined_named_after_quoted ::= named_token_singular_amount token_recipe_explicit_name "." "it" "has" named_token_death_abilities

/* @prefer always */
/* @sem Ability::@holder(Ability::Triggered{event:ZoneChange{objects:SameObject(Source), from:Battlefield, to:Graveyard}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}) */
named_token_death_quote ::= '"' "when" "this" "token" "dies" "," program_sentence '"'

/* @prefer always */
/* @sem Ability::[$named_token_death_quote] */
named_token_death_abilities ::= named_token_death_quote

/* @sem Expr::Constant(1) */
named_token_singular_amount ::= "a"

/* A closed quotation ends the grant sentence and retains the created batch. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($created_gains_subject), changes:$closed_grants, duration:Indefinite, evaluation:Snapshot}}] */
clause_created_gains_quoted ::= created_gains_subject "gains" closed_grants

/* The condition and fight belong to the newly created token holder. */
/* @sem Ability::Triggered{event:ZoneChange{objects:SameObject(Source), to:Battlefield}, intervening_if:ObjectMatches{object:Source, filter:$filter_phrase}, limits:_{}, body:_{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:Source, second:$target_up_to_one}}}]}, announcement:@announcement} */
/* @prefer always */
token_entry_conditional_fight ::= "when" "this" "token" "enters" "," "if" "it's" "a" filter_phrase "," "it" "fights" target_up_to_one "."

/* @sem Program::Program{instructions:$instructions_conditional_copy_exception} */
program_conditional_copy_exception ::= instructions_conditional_copy_exception

/* @sem Instruction::[Effect{result:@next, operation:$prior_result_aura_two_activations}] */
clause_prior_aura_two_activations ::= prior_result_aura_two_activations

/* @sem TokenRecipe::@token_abilities($token_recipe_quote_base, $token_description_quoted) */
token_recipe_quoted_standard ::= token_recipe_quote_base token_description_quoted

/* This anaphor refers to the creature tokens just described. */
/* @sem TokenRecipe::@token_abilities($token_creature_statless_singular, $token_creature_description_quoted) */
token_creature_recipe_quoted ::= token_creature_statless_singular token_creature_description_quoted

/* @sem $token_abilities_quoted */
token_creature_description_quoted ::= "." "those" "creatures" "have" token_abilities_quoted

/* A leading live count composes with a recipe whose quoted ability closes the sentence. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:$leading_count_each, words:CreatingEffect, recipe:$token_recipe_quoted}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_each_defined_leading_quoted ::= "for" "each" leading_count_each "," "create" "a" token_recipe_quoted

/* The quoted activation already supplies the sentence-final punctuation. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$perpetual_quoted_activation_grant}]} */
program_sentence_perpetual_quoted_activation ::= perpetual_quoted_activation_grant

/* X describes the named batch; the quoted abilities belong to its tokens. */
/* @sem TokenSpec::TokenSpec{amount:$value, words:CreatingEffect, recipe:@token_abilities($token_recipe_explicit_name_plural, $named_x_token_abilities)} */
token_named_x_quoted ::= "X" token_recipe_explicit_name_plural "," "where" "X" "is" value "." "the" "tokens" "have" named_x_token_abilities

/* Prefer the explicit token holder in this quoted creation context. */
named_x_token_abilities ::= named_x_attack_abilities | token_abilities_quoted

/* @prefer always */
/* @sem Ability::[$named_x_attack_quote] */
named_x_attack_abilities ::= named_x_attack_quote

/* @prefer always */
/* @sem Ability::@holder(Ability::Triggered{event:Object{event:Attacks, objects:SameObject(Source)}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}) */
named_x_attack_quote ::= '"' "whenever" "this" "token" "attacks" "," program_sentence '"'

/* A singular named token can state an intrinsic activation in a following sentence. */
/* @prefer always */
/* @sem TokenSpec::TokenSpec{amount:$named_token_singular_amount, words:CreatingEffect, recipe:@token_abilities($token_recipe_explicit_name, $token_named_activation_abilities)} */
token_defined_named_activation_after ::= named_token_singular_amount token_recipe_explicit_name "." "it" "has" token_named_activation_abilities

/* @sem Ability::[$token_named_activation_quote] */
token_named_activation_abilities ::= token_named_activation_quote

/* @sem Ability::@holder($activated_ability) */
token_named_activation_quote ::= '"' activated_ability '"'

/* A duplicate and its immediately following changes share the conjure receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Duplicate(One($target_card_exiled_with_source)), count:Constant(1), destination:Hand(CardArrival{counters:[], states:[]})}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$linked_duplicate_changes}}] */
instructions_linked_duplicate_perpetual ::= "conjure" "a" "duplicate" "of" target_card_exiled_with_source "into" "your" "hand" "." "the" "duplicate" "perpetually" linked_duplicate_changes

linked_duplicate_changes ::= linked_duplicate_grants | linked_duplicate_pump_grants

/* @sem $closed_grants */
linked_duplicate_grants ::= "gains" closed_grants

/* @sem Change::[...$linked_duplicate_pump, ...$closed_grants] */
linked_duplicate_pump_grants ::= linked_duplicate_pump "and" "gains" closed_grants

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}] */
linked_duplicate_pump ::= "gets" signed "/" signed

/* The two optional targets form the population copied by the conjure action. */
/* @sem Instruction::[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Duplicate(Union([One($linked_optional_target), One($linked_optional_target_2)])), count:Constant(1), destination:Hand(CardArrival{counters:[], states:[]})}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@prior, phase:After})}), changes:$closed_grants}}] */
instructions_linked_pair_duplicates_perpetual ::= "choose" linked_optional_target "and" linked_optional_target "from" "among" "cards" "exiled" "with" "this" "creature" "." "conjure" "a" "duplicate" "of" "each" "of" "those" "cards" "into" "your" "hand" "." "the" "duplicates" "perpetually" "gain" closed_grants

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Exile]}), count:UpTo(Constant(1)), filter:AllOf([$linked_optional_card_filter, ExiledWith(Source)])}), index:0} */
linked_optional_target ::= "up" "to" "one" "target" linked_optional_card_filter "card"

linked_optional_card_filter ::= noun | filter_instant_or_sorcery

/* @sem Change::[GrantAbility($token_quoted_sentence), GrantAbility($token_quoted_sentence_2)] */
closed_two_quoted_grants ::= token_quoted_sentence "↓" "and" token_quoted_sentence

/* The target introduces both the excluded creature and its controller for the
   following snapshot effect. The quoted ability belongs to each affected creature. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$damage_opponents_creature}, Effect{result:@next, operation:$other_target_controller_type_grant}]} */
program_damage_other_controller_type_grant ::= damage_opponents_creature "." other_target_controller_type_grant

/* @sem Operation::DealDamage{source:Source, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun_creature, ControlledBy(OpponentsOf(AbilityController))])}), index:0})), amount:$number, preventable:true} */
damage_opponents_creature ::= SELF_NAME "deals" number "damage" "to" "target" noun_creature "an" "opponent" "controls"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Target{slot:@last_slot, index:0})), $noun_creature, ControlledBy(One(ControllerOf(Target{slot:@last_slot, index:0})))])}), changes:[CreatureTypes{mode:Add, types:Listed([@subtype_name($subtype)])}, GrantAbility(Static(_{kind:Ordinary, affected:Objects(One(Source)), changes:[Rule(Prohibit(Block(AnyOf([$subtype_plural, $subtype_plural_2]))))]}))], duration:Indefinite, evaluation:Snapshot} */
other_target_controller_type_grant ::= "each" "other" noun_creature "that" "player" "controls" "becomes" "a" subtype "in" "addition" "to" "its" "other" "types" "and" "gains" '"' "this" "creature" "can't" "block" subtype_plural "or" subtype_plural "." '"'

/* A separated library selection may precede a quoted instruction. */
/* @sem Instruction::[...$dig_reveal_split, ...$instructions_quoted] */
before_quoted_reveal_split ::= dig_reveal_split "." instructions_quoted

/* A leading duration wraps the animation; its quoted definition is a separate ability. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$counter_animated_operation}]} */
program_sentence_counter_animated ::= counter_animated_operation

/* A nested quotation switches delimiters while each ability binds its own holder. */
/* @sem Ability::[$nested_token_quoted] */
nested_token_abilities_quoted ::= nested_token_quoted

/* @sem Ability::@holder($nested_token_trigger) */
nested_token_quoted ::= '"' nested_token_trigger '"'

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$nested_token_creation_program} */
nested_token_trigger ::= event_clause "," nested_token_creation_program

/* @sem Program::Program{instructions:[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$nested_token_group], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]} */
nested_token_creation_program ::= "create" nested_token_group

/* @sem TokenSpec::TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:@token_abilities($token_recipe_quote_base, $nested_single_ability_list)} */
nested_token_group ::= token_amount token_recipe_quote_base "with" nested_single_ability_list

/* @sem Ability::[@holder($triggered_ability)] */
nested_single_ability_list ::= "'" triggered_ability "'"

/* @sem Program::Program{instructions:$instructions_attached_named_aura_quoted} */
program_sentence_attached_named_aura ::= instructions_attached_named_aura_quoted

/* A conditional replacement selects between complete programs. */
/* @sem Program::Program{instructions:[If{condition:$condition, then:$program_2, otherwise:$program}]} */
program_sentence_prefix_conditional_instead ::= program "." "if" condition "," "instead" program "."

/* The revealed filtered population and choice have the same hand and filter;
   the perpetual change applies to the actual chosen card. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Reveal{objects:Zone(_{scope:Players{zone:Hand, players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0})}, kind:Card, filter:$adjective_nontype})}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(Target{slot:0, index:0})}, kind:Card, filter:$adjective_nontype}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:[GrantAbility($quoted_perpetual_cast_trigger)]}}]} */
program_revealed_hand_choice_cast_grant ::= "target" "opponent" "reveals" "each" adjective_nontype "card" "in" "their" "hand" "." "you" "choose" "one" "of" "them" "." "that" "card" "perpetually" "gains" quoted_perpetual_cast_trigger

/* The chosen target supplies both the animation and its shared characteristic. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_object)), changes:[SetArtifactType(Vehicle), SetCardTypes([Artifact]), SetBasePowerToughness{power:ObjectProperty{object:$target_object, property:ManaValue, information:CurrentOrLastKnown}, toughness:ObjectProperty{object:$target_object, property:ManaValue, information:CurrentOrLastKnown}}, GrantAbility(@holder($crew_ability)), GrantAbility(@holder($vehicle_die_damage_trigger))], duration:$duration, evaluation:Snapshot}}]} */
program_sentence_target_vehicle_grants ::= "choose" target_object "." duration "," "it" "becomes" "a" "Vehicle" "artifact" "with" "base" "power" "and" "toughness" "each" "equal" "to" "its" "mana" "value" "," "and" "it" "gains" crew_ability "and" '"' "Crash" "Land" "—" vehicle_die_damage_trigger '"'

/* A rolled result is shared by the comparison and the subsequent damage. */
/* @sem Ability::Triggered{event:Damage{source_kind:Permanent, sources:SameObject(Source), recipients:Any, kind:Any, grouping:Source, subject:Source}, limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:$roll_die_action}, If{condition:Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:Equal, value:ObjectProperty{object:Source, property:ManaValue, information:CurrentOrLastKnown}}}, then:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:One(Source)})}, Effect{result:@next, operation:DealDamage{source:Source, recipients:$recipients, amount:DieResult(@marked), preventable:true}}]}, otherwise:_{}}]}} */
vehicle_die_damage_trigger ::= "whenever" "this" "Vehicle" "deals" "damage" "," roll_die_action "." "if" "the" "result" "is" "equal" "to" "this" "Vehicle's" "mana" "value" "," "sacrifice" "this" "Vehicle" "," "then" "it" "deals" "that" "much" "damage" "to" recipients "."

/* The single-quoted activation belongs to each affected permanent, not the emblem. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected_plural), changes:[GrantKeyword($keyword_value), GrantAbility(@holder($activated_ability))]} */
static_keyword_and_single_quoted_activation ::= affected_plural "have" keyword_value "and" "'" activated_ability "'"

quoted_static_animation_operation ::= indefinite_animated_quoted_static | indefinite_creature_quoted_static

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$graveyard_each_card_temporary_grant}]} */
program_sentence_graveyard_each_grant ::= graveyard_each_card_temporary_grant

/* A coordinated preceding sentence composes with a closed quoted grant. */
/* @sem Instruction::[...$conjoined, ...$instructions_quoted] */
conjoined_before_quoted ::= conjoined "." instructions_quoted

/* Both effects apply to the same referenced object; the static grant has its
   own holder and the indefinite goad remains a live rule. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members(One($it_ordinary_pronoun))), changes:[Rule(GoadedBy(AbilityController))], duration:Indefinite, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members(One($it_ordinary_pronoun))), changes:[GrantAbility(@holder(Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes})))], duration:Indefinite, evaluation:Snapshot}}] */
goaded_grant_quoted ::= "it's" "goaded" "for" "the" "rest" "of" "the" "game" "and" it_ordinary_pronoun "gains" '"' affected static_changes "." '"'

/* The explicit creator is the ability controller, independent of the first action. */
/* @sem Instruction::[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:$token_groups_quoted, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
clause_operation_you_create_quoted ::= operation "and" "you" "create" token_groups_quoted
