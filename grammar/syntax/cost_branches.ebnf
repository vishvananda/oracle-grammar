/* The same source spell is specialized only after its references are bound.
   Each native branch keeps its own announcement. No text rewrite is applied. */
/* @sem $keyword_payment */
kicker_branch_header ::= "kicker" keyword_payment
/* @sem Cost::@agree($keyword_payment, $additional_payment) */
kicker_branch_reminded_header ::= "kicker" keyword_payment "(" "you" "may" additional_payment "as" "you" "cast" "this" "spell" "." ")"

/* @sem Ability::@kicker_branch($kicker_branch_header, Ability::Spell{announcement:@announcement, body:$kicker_branch_program}) */
spell_kicker_branch ::= kicker_branch_header NEWLINE kicker_branch_program
/* @sem Ability::WithPresentation{reminder:true, ability:@kicker_branch($kicker_branch_reminded_header, Ability::Spell{announcement:@announcement, body:$kicker_branch_program})} */
spell_kicker_branch_reminded ::= kicker_branch_reminded_header NEWLINE kicker_branch_program
/* @sem Ability::WithPresentation{label:$ability_label, reminder:false, ability:@kicker_branch($kicker_branch_header, Ability::Spell{announcement:@announcement, body:$kicker_branch_program})} */
spell_kicker_branch_labelled ::= ability_label "—" kicker_branch_header NEWLINE kicker_branch_program
/* @sem Ability::WithPresentation{label:$ability_label, reminder:true, ability:@kicker_branch($kicker_branch_reminded_header, Ability::Spell{announcement:@announcement, body:$kicker_branch_program})} */
spell_kicker_branch_labelled_reminded ::= ability_label "—" kicker_branch_reminded_header NEWLINE kicker_branch_program

/* "As an additional cost to cast this spell, you may blight 1. ... If this spell's
   additional cost was paid, you gain 2 life": like a kicker, one branch for each
   answer to the spell's test of its own optional cost. */
/* @sem Ability::@additional_branch($branch_optional_cost, Ability::Spell{announcement:@announcement, body:$kicker_branch_program}) */
spell_additional_branch ::= optional_cost_opening branch_optional_cost "." NEWLINE kicker_branch_program
/* "you may blight 1", "you may pay {2}{R}" */
branch_optional_cost ::= cost | alternative_mana

/* Overload changes "target" in the spell's text to "each" (CR 702.96b); the binder
   derives that spell from the ordinary one. */
/* @sem Ability::@overload_branch($keyword_payment, Ability::Spell{announcement:@announcement, body:$program_sentence}) */
spell_overload ::= program_sentence NEWLINE "overload" keyword_payment
/* Awaken N (CR 702.113): cast for its awaken cost, the spell also puts N +1/+1 counters
   on target land you control, which becomes a 0/0 Elemental creature with haste. The
   paid spell has that one more target, after the spell's own, and one more
   instruction; the other spell is the text as written. */
/* @sem Ability::CostBranch{keyword:Awaken, cost:$keyword_payment, paid:@scope(Ability::Spell{announcement:@announcement, body:_{instructions:[...$instructions, $awaken_land]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:_{instructions:$instructions}})} */
spell_awaken ::= instructions "." NEWLINE awaken_land "―" keyword_payment
/* @sem Instruction::Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Awaken{object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Land), ControlledBy(One(AbilityController))])}), index:0}, amount:$number}}} */
awaken_land ::= "awaken" number

kicker_branch_program ::= kicker_target_additional_count_pump | seek_conditional_program | search_reveal_chosen_type_paid_destination | kicker_distinct_return_program | kicker_distinct_damage_program | kicker_exile_receipt_override | kicker_prevent_another_source | program_sentence | kicker_override_sentence | kicker_override_before | kicker_override_after | kicker_override_both | kicker_prevention_exception | retirement_target_damage_conditional | retirement_population_override | retirement_population_add_those | retirement_population_add_they | conditional_damage_to_creature_controller | program_discard_maximum_conditional | prevention_target_override_program | kicker_search_either_replacement | kicker_next_cast_conjure_discard | controlled_power_damage_kicked | kicker_population_conditional_additional | kicker_search_battlefield_animation | chosen_creatures_conditional_counter_fight | kicker_destroy_distinct_targets | kicker_conditional_extra_target_damage | conditional_then_opponent_damage_program | kicker_prior_action_spell_damage | kicker_destroy_target_property_damage | kicker_destroy_target_property_damage_target_source | damage_recipient_conditional_program | kicker_return_duplicate_program | branch_program_gift_phase_lock_exile | kicker_override_after_sequence | destroy_creature_conditional_stat_damage | kicker_exile_top_override_permission | kicker_fraction_mill_override
/* "Prevent all combat damage that would be dealt this turn. If this spell's additional
   cost was paid, this effect doesn't affect combat damage that would be dealt by red
   creatures": the paid prevention spares damage those sources deal. */
/* @sem Program::Program{instructions:[If{condition:$condition, then:_{instructions:[Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Permanent, sources:Not($filter_plural), recipients:Any, kind:Combat, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:EndOfTurn, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}}}]}, otherwise:_{instructions:[Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:Any, kind:Combat, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:EndOfTurn, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}}}]}}]} */
kicker_prevention_exception ::= "prevent" "all" "combat" "damage" "that" "would" "be" "dealt" "this" "turn" "." "if" condition "," "this" "effect" "doesn't" "affect" "combat" "damage" "that" "would" "be" "dealt" "by" filter_plural "."
/* @sem Program::Program{instructions:$kicker_override} */
kicker_override_sentence ::= kicker_override
/* @sem Program::Program{instructions:[...$instructions, ...$kicker_override]} */
kicker_override_before ::= instructions "." NEWLINE? kicker_override
/* @sem Program::Program{instructions:[...$kicker_override, ...$instructions]} */
kicker_override_after ::= kicker_override NEWLINE? instructions "."
/* @sem Program::Program{instructions:[...$instructions, ...$kicker_override, ...$instructions_2]} */
kicker_override_both ::= instructions "." NEWLINE? kicker_override NEWLINE? instructions "."
/* One preceding sentence supplies the ordinary action. References in the new
   sentence can still name that sentence's announced target. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:$kicker_replacement_clause}, otherwise:Program{instructions:$clause}}] */
kicker_override ::= clause "." NEWLINE? "if" condition "," kicker_replacement_clause "."
kicker_replacement_clause ::= kicker_replacement_standard | kicker_replacement_counted_search

/* Entwine changes how many modes are selected; each branch retains the same
   independently scoped mode programs and target announcements. */
/* @sem Ability::CostBranch{keyword:Entwine, cost:$keyword_payment, paid:Spell{announcement:_{modes:ModeSelection{count:ModeCount{minimum:@length($modes), maximum:@length($modes)}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}}}, body:Program{}}, unpaid:Spell{announcement:_{modes:ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}}}, body:Program{}}} */
spell_entwine ::= "choose" "one" "—" NEWLINE modes NEWLINE "entwine" keyword_payment

/* Kicker changes the number of chosen modes; each mode keeps its own target
   announcement in both casting branches. */
/* @sem Ability::CostBranch{keyword:Kicker, cost:$keyword_payment, paid:Spell{announcement:_{modes:ModeSelection{count:ModeCount{minimum:Constant(0), maximum:@length($modes)}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}}}, body:Program{}}, unpaid:Spell{announcement:_{modes:ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}}}, body:Program{}}} */
spell_modal_kicker ::= "kicker" keyword_payment NEWLINE "choose" "one" "." "if" "this" "spell" "was" "kicked" "," "choose" "any" "number" "instead" "." NEWLINE modes

/* Two independent optional costs, not one combined payment or a mode choice. */
/* @sem Ability::[Mechanic{mechanic:Kicker, cost:$keyword_payment}, Mechanic{mechanic:Kicker, cost:$keyword_payment_2}] */
line_dual_kicker ::= "kicker" keyword_payment "and" "/" "or" keyword_payment

/* These legacy Operand terms are the pinned IR's typed KickedWith payload. */
/* @sem Operand::[$kicker_operand] */
kicker_operands_one ::= kicker_operand
/* @sem Operand::[$kicker_operand, ...$kicker_operands] */
kicker_operands_more ::= kicker_operand kicker_operands
kicker_operands ::= kicker_operands_one | kicker_operands_more
kicker_operand ::= kicker_operand_generic | kicker_operand_white | kicker_operand_blue | kicker_operand_black | kicker_operand_red | kicker_operand_green | kicker_operand_snow
/* @sem Operand::Term{family:ManaSymbol, form:ManaCostGeneric, operands:[Integer($number)]} */
kicker_operand_generic ::= "{" NUMBER "}"
/* @sem Operand::Term{family:ManaSymbol, form:ManaCostW, operands:[]} */
kicker_operand_white ::= "{W}"
/* @sem Operand::Term{family:ManaSymbol, form:ManaCostU, operands:[]} */
kicker_operand_blue ::= "{U}"
/* @sem Operand::Term{family:ManaSymbol, form:ManaCostB, operands:[]} */
kicker_operand_black ::= "{B}"
/* @sem Operand::Term{family:ManaSymbol, form:ManaCostR, operands:[]} */
kicker_operand_red ::= "{R}"
/* @sem Operand::Term{family:ManaSymbol, form:ManaCostG, operands:[]} */
kicker_operand_green ::= "{G}"
/* @sem Operand::Term{family:ManaSymbol, form:ManaCostS, operands:[]} */
kicker_operand_snow ::= "{S}"

/* Conditional entry counter/ability changes share the existing grants grammar.
   The condition tests the entering source, while granted abilities receive
   a fresh holder through grant_ability. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_ref)}, body:Program{instructions:[If{condition:ObjectMatches{object:@self, filter:$kicker_entry_test}, then:Program{instructions:$kicker_entry_changes}, otherwise:Program{}}]}}) */
kicker_entry_conditional ::= "if" self_ref "was" kicker_entry_test "," "it" "enters" "with" kicker_entry_changes "."

kicker_entry_test ::= kicker_test_with | kicker_test_twice | kicker_test_any
/* @sem ObjectFilter::KickedWith($kicker_operands) */
kicker_test_with ::= "kicked" "with" "its" kicker_operands "kicker"
/* @sem ObjectFilter::State(KickedTwice) */
kicker_test_twice ::= "kicked" "twice"
/* @sem ObjectFilter::State(Kicked) */
kicker_test_any ::= "kicked"

kicker_entry_changes ::= kicker_entry_counters | kicker_entry_counters_and_grants
/* @sem Instruction::[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$counter_amount})}}] */
kicker_entry_counters ::= counter_amount counter_kind ("counter" | "counters") "on" "it"
/* @sem Instruction::[...$kicker_entry_counters, Effect{result:@next, operation:ModifyEvent{change:Entry(Changes($grants))}}] */
kicker_entry_counters_and_grants ::= kicker_entry_counters "and" "with" grants

/* The quoted ability's inner period also closes the enclosing sentence. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_ref)}, body:Program{instructions:[If{condition:ObjectMatches{object:@self, filter:$kicker_entry_test}, then:Program{instructions:[...$kicker_entry_counters, Effect{result:@next, operation:ModifyEvent{change:Entry(Changes([$grant_ability]))}}]}, otherwise:Program{}}]}}) */
kicker_entry_conditional_quoted ::= "if" self_ref "was" kicker_entry_test "," "it" "enters" "with" kicker_entry_counters "and" "with" grant_ability

/* The kicked search replaces the ordinary search. Shared following actions
   use the actual search selection in each independently scoped spell branch. */
/* @sem Ability::[CostBranch{keyword:Kicker, cost:$keyword_payment, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:$kicker_search_pair}, Effect{result:@next, operation:$found_reveal}, ...$search_follow]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:$search}, Effect{result:@next, operation:$found_reveal}, ...$search_follow]}})}] */
line_kicker_search_override ::= "kicker" keyword_payment NEWLINE search "." "if" "this" "spell" "was" "kicked" "," "instead" kicker_search_pair "." found_reveal search_follow "."
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[SearchChoice{filter:$search_filter, count:UpTo(Constant(1))}, SearchChoice{filter:$search_filter_2, count:UpTo(Constant(1))}]} */
kicker_search_pair ::= "search" "your" "library" "for" ("a" | "an") search_filter "and" ("a" | "an") search_filter

/* The optional kicker payment grants this ability to the same source spell. */
/* @sem Ability::KickedHas{cost:$keyword_payment, ability:$keyword_ability} */
kicker_conditional_keyword ::= "kicker" keyword_payment NEWLINE "if" "this" "spell" "was" "kicked" "," "it" "has" keyword_ability "."

/* These spending restrictions modify the kicker payment rather than the entry
   replacement in the following paragraph. */
/* @sem Ability::Modified{ability:Mechanic{mechanic:Kicker, cost:$keyword_payment}, modifier:Term{family:CastModifier, form:SpendOnlyColoredManaOnXAndAtMostOneManaOfEachColor, operands:[]}} */
kicker_colored_spending ::= "kicker" keyword_payment NEWLINE "spend" "only" "colored" "mana" "on" "X" "." "no" "more" "than" "one" "mana" "of" "each" "color" "may" "be" "spent" "this" "way" "."

/* A common root spell postlude belongs to both exhaustive casting branches. */
/* @sem Ability::[@kicker_branch($kicker_branch_header, Ability::Spell{announcement:@announcement, body:Program{instructions:[...$instructions, ...$instructions_2]}})] */
line_kicker_branch_paragraphs ::= kicker_branch_header NEWLINE instructions "." NEWLINE instructions "."

/* Required and optional conditional choices have different lower bounds. Both
   forms name exactly two modes; each keeps its own announcement namespace. */
conditional_modes ::= conditional_modes_required | conditional_modes_optional
/* @sem Mode::[$mode, $mode_2] */
conditional_two_modes ::= mode NEWLINE mode
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Conditional{condition:$condition, then:Constant(2), otherwise:Constant(1)}, maximum:Conditional{condition:$condition, then:Constant(2), otherwise:Constant(1)}}, options:$conditional_two_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
conditional_modes_required ::= "choose" "one" "." "if" condition "," "choose" "both" "instead" "." NEWLINE conditional_two_modes
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Conditional{condition:$condition, then:Constant(2), otherwise:Constant(1)}}, options:$conditional_two_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
conditional_modes_optional ::= "choose" "one" "." "if" condition "," "you" "may" "choose" "both" "instead" "." NEWLINE conditional_two_modes
/* @sem Ability::Spell{announcement:Announcement{modes:$conditional_modes}, body:Program{}} */
conditional_spell_modal ::= conditional_modes
/* @sem Ability::Triggered{event:ZoneChange{objects:$event_object, to:Battlefield}, limits:TriggerLimits{}, announcement:Announcement{modes:$conditional_modes}, body:Program{}} */
conditional_entry_modal ::= ("when" | "whenever") event_object "enters" "," conditional_modes
/* @sem Ability::Triggered{event:$event_scheme, limits:TriggerLimits{}, announcement:Announcement{modes:$conditional_modes}, body:Program{}} */
conditional_scheme_modal ::= ("when" | "whenever") event_scheme "," conditional_modes
/* An own cast trigger functions on the stack. Its count condition observes
   the matched spell, independently of any targets chosen in the modes. */
/* @sem Ability::Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:Spell{event:Cast, players:One(AbilityController), spells:$event_self}, limits:TriggerLimits{}, announcement:Announcement{modes:$conditional_modes}, body:Program{}})} */
conditional_cast_modal ::= ("when" | "whenever") "you" "cast" event_self "," conditional_modes

/* A stack-time restriction is independent of the resolution-time payment
   branches. The single printed kicker header supplies their actual cost. */
/* @sem Ability::Scoped{zones:[Stack], ability:Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Stack), kind:Spell, filter:SameObject(Source)}), changes:[Rule(Prohibit(Counter))]}} */
stack_uncounterable_declaration ::= "this" "spell" "can't" "be" "countered" "."

/* @sem Ability::[$stack_uncounterable_declaration, CostBranch{keyword:Kicker, cost:$kicker_branch_header, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any})), amount:$number_2, preventable:false}}]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any})), amount:$number, preventable:true}}]}})}] */
line_kicker_uncounterable_damage ::= kicker_branch_header NEWLINE stack_uncounterable_declaration NEWLINE self_explicit_ref "deals" number "damage" "to" "any" "target" "." "if" "this" "spell" "was" "kicked" "," "instead" "it" "deals" number "damage" "to" "that" "permanent" "or" "player" "and" "the" "damage" "can't" "be" "prevented" "."

/* The actual payer chooses one sacrifice, independent of ability control. */
/* @sem Cost::Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly(Constant(1))}]} */
payment_sacrifice_choice ::= "sacrifice" ("a" | "an") filter_phrase "of" "their" "choice"

/* The replacement retains the same token recipe in both casting branches. */
/* @sem Ability::CostBranch{keyword:Kicker, cost:$keyword_payment, paid:@scope(Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$number_words, words:CreatingEffect, recipe:$replacement_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$replacement_initial_count, words:CreatingEffect, recipe:$replacement_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}})} */
spell_kicker_token_replacement ::= "kicker" keyword_payment NEWLINE "create" replacement_initial_count replacement_token_recipe "." "if" "this" "spell" "was" "kicked" "," "create" number_words "of" "those" "tokens" "instead" "."

/* Madness replaces both actions, keeping their quantities independently bound. */
/* @sem Ability::CostBranch{keyword:Madness, cost:$keyword_payment, paid:@scope(Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$number_x, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:$number_x_2}}]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$number_words, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:$number_digits}}]}})} */
spell_madness_token_life_replacement ::= "madness" keyword_payment NEWLINE "create" number_words "tapped" token_recipe "and" "you" "gain" number_digits "life" "." "if" "this" "spell's" "madness" "cost" "was" "paid" "," "instead" "create" number_x "of" "those" "tokens" "and" "you" "gain" number_x "life" "."

/* The unbracketed instructions occur in both independently bound spell branches;
   the bracketed instruction applies only when cleave was not paid. */
/* @sem Ability::CostBranch{keyword:Cleave, cost:$cost, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[...$instructions, $cleave_hand_size_reduction]}})} */
spell_cleave_hand_size_branch ::= "cleave" cost NEWLINE instructions "." "[" cleave_hand_size_reduction "." "]"

/* @sem Instruction::Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(HandSize(Adjust(@negate($number))))], duration:Indefinite, evaluation:LiveObjects}} */
cleave_hand_size_reduction ::= "Your" "maximum" "hand" "size" "is" "reduced" "by" number "for" "the" "rest" "of" "the" "game"

/* The common prefix is independently bound in both teamwork branches. The
   unless clause is performed only in the unpaid branch. */
/* @sem Ability::CostBranch{keyword:Teamwork, cost:Cost{parts:[Teamwork($number)]}, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[...$instructions, ...$clause]}})} */
spell_teamwork_unless_branch ::= "teamwork" NUMBER NEWLINE instructions "." "then" clause "unless" "this" "spell" "was" "cast" "using" "teamwork" "."

/* A conditional extra source adds a distinct target to the prevention set.
   The two source descriptions must agree; each branch announces its own set. */
/* @sem Program::Program{instructions:[If{condition:$condition, then:_{instructions:[Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Permanent, sources:InSet(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(2)), filter:@agree($filter_phrase, $filter_phrase_2)}))), recipients:Any, kind:Combat, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:EndOfTurn, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}}}]}, otherwise:_{instructions:[Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Permanent, sources:SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@agree($filter_phrase, $filter_phrase_2)}), index:0}), recipients:Any, kind:Combat, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:EndOfTurn, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}}}]}}]} */
kicker_prevent_another_source ::= "prevent" "all" "combat" "damage" "target" filter_phrase "would" "deal" "this" "turn" "." "if" condition "," "prevent" "all" "combat" "damage" "another" "target" filter_phrase "would" "deal" "this" "turn" "."

/* The abbreviated replacement repeats the complete distributed prevention
   contract, changing only its allocation. Both alternatives announce targets. */
/* @sem Operation::CreateReplacement{event:Damage(DamageEvent{source_kind:Any, sources:Any, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:UpTo($number), filter:Any, distribute:$number})), kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:DamageToEach(Expr::DistributedShare(@share)), duration:EndOfTurn, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevent_distributed_this_way ::= "prevent" "the" "next" number "damage" "this" "way"

/* This variant proves the omitted continuation uses the same turn window. */
/* @sem Operation::CreateReplacement{event:Damage(DamageEvent{source_kind:Any, sources:Any, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:UpTo($number), filter:Any, distribute:$number})), kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:DamageToEach(Expr::DistributedShare(@share)), duration:EndOfTurn, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevent_distributed_this_turn ::= "prevent" "the" "next" number "damage" "that" "would" "be" "dealt" "this" "turn" "to" "any" "number" "of" "targets" "," "divided" "as" "you" "choose"

/* @sem Ability::CostBranch{keyword:Kicker, cost:$kicker_branch_header, paid:@scope(Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$prevent_distributed_this_way}]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$prevent_distributed_this_turn}]}})} */
spell_kicker_distributed_override ::= kicker_branch_header NEWLINE prevent_distributed_this_turn "." "if" "this" "spell" "was" "kicked" "," prevent_distributed_this_way "instead" "."

/* The bracketed filter applies only to the unpaid count. Both spells count
   the same controlled population and preserve independent result scopes. */
/* @sem Ability::CostBranch{keyword:Cleave, cost:$cost, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$controlled_singular_population})}}]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($controlled_singular_population, $modifier_with_keyword)})}}]}})} */
spell_cleave_count_controlled ::= "cleave" cost NEWLINE "draw" "a" "card" "for" "each" controlled_singular_population "[" modifier_with_keyword "]" "."

/* The count is scoped to either of the two explicit exile producers. */
/* @sem Program::Program{instructions:[If{condition:$condition_cast_kicked, then:_{instructions:[Effect{result:@next, operation:$exile_target_players_graveyard}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:CountObjects(Matching{objects:Transition{result:@prior, phase:After}, filter:$card_filter}), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:_{instructions:[Effect{result:@next, operation:$exile_single_graveyard_targets}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:CountObjects(Matching{objects:Transition{result:@prior, phase:After}, filter:$card_filter}), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}]} */
kicker_exile_receipt_override ::= exile_single_graveyard_targets "." "if" condition_cast_kicked "," "instead" exile_target_players_graveyard "." "create" "a" token_recipe "for" "each" card_filter "card" "exiled" "this" "way" "."

/* @sem Operation::Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo($count_plural), filter:Any, constraints:[CommonProperty(Owners)]})), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_single_graveyard_targets ::= "exile" "up" "to" count_plural "target" "cards" "from" "a" "single" "graveyard"

/* A repeated population is checked against its antecedent in both directions. */
/* @sem PlayerRef::AbilityController */
retirement_population_controller_you ::= "you" "control"

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0} */
retirement_population_controller_target ::= "target" "player" "controls"

retirement_population_controller ::= retirement_population_controller_you | retirement_population_controller_target

/* @sem Change::[Change::Pump{power:$signed, toughness:$signed_2}] */
retirement_plural_pump ::= "get" signed "/" signed

/* @sem $grants */
retirement_plural_gain ::= "gain" grants

retirement_plural_changes ::= retirement_plural_pump | retirement_plural_gain

/* @sem Program::Program{instructions:[If{condition:ObjectMatches{object:@self, filter:State(Kicked)}, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($filter_plural, $filter_plural_2), ControlledBy(One($retirement_population_controller))])}), changes:$retirement_plural_changes_2, duration:EndOfTurn, evaluation:Snapshot}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($filter_plural, $filter_plural_2), ControlledBy(One($retirement_population_controller))])}), changes:$retirement_plural_changes, duration:EndOfTurn, evaluation:Snapshot}}]}}]} */
retirement_population_override ::= filter_plural retirement_population_controller retirement_plural_changes "until" "end" "of" "turn" "." "if" "this" "spell" "was" "kicked" "," "those" filter_plural retirement_plural_changes "until" "end" "of" "turn" "instead" "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($filter_plural, $filter_plural_2), ControlledBy(One($retirement_population_controller))])}), changes:$retirement_plural_changes, duration:EndOfTurn, evaluation:Snapshot}}, If{condition:ObjectMatches{object:@self, filter:State(Kicked)}, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($filter_plural, $filter_plural_2), ControlledBy(One($retirement_population_controller))])}), changes:$retirement_plural_changes_2, duration:EndOfTurn, evaluation:Snapshot}}]}, otherwise:Program{}}]} */
retirement_population_add_those ::= filter_plural retirement_population_controller retirement_plural_changes "until" "end" "of" "turn" "." "if" "this" "spell" "was" "kicked" "," "those" filter_plural "also" retirement_plural_changes "until" "end" "of" "turn" "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One($retirement_population_controller))])}), changes:$retirement_plural_changes, duration:EndOfTurn, evaluation:Snapshot}}, If{condition:ObjectMatches{object:@self, filter:State(Kicked)}, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One($retirement_population_controller))])}), changes:$retirement_plural_changes_2, duration:EndOfTurn, evaluation:Snapshot}}]}, otherwise:Program{}}]} */
retirement_population_add_they ::= filter_plural retirement_population_controller retirement_plural_changes "until" "end" "of" "turn" "." "if" "this" "spell" "was" "kicked" "," "they" retirement_plural_changes "until" "end" "of" "turn" "."

/* The announced target is also the source of the subsequent delayed event. */
/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:SameObject(Target{slot:0, index:0}), recipients:Any, kind:Combat, grouping:Source, subject:Source}) */
retirement_target_combat_event ::= "whenever" "that" "creature" "deals" "combat" "damage"

/* @sem Instruction::[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:EventAmount}}] */
retirement_damage_life ::= "you" "gain" "life" "equal" "to" "that" "damage"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$noun_creature}), index:0})), changes:$retirement_singular_gain, duration:EndOfTurn, evaluation:Snapshot}}, If{condition:ObjectMatches{object:@self, filter:State(Kicked)}, then:Program{instructions:[Effect{result:@next, operation:CreateTrigger{event:$retirement_target_combat_event, duration:EndOfTurn, body:_{instructions:$retirement_damage_life}, announcement:_{}}}]}, otherwise:Program{}}]} */
retirement_target_damage_conditional ::= "target" noun_creature retirement_singular_gain "until" "end" "of" "turn" "." retirement_target_combat_event "this" "turn" "," "if" "this" "spell" "was" "kicked" "," retirement_damage_life "."

/* @sem $grants */
retirement_singular_gain ::= "gains" grants

/* A promised gift is fixed at casting time. The repeated source denotes
   the same object in both sentences. */
/* @prefer always */
/* @sem Program::Program{instructions:[If{condition:$condition_gift_promised, then:Program{instructions:[Effect{result:@next, operation:DealDamageParts{source:Source, parts:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0})), amount:$number}, _{recipients:Players(One(ControllerOf(Target{slot:@last_slot, index:0}))), amount:$number_2}], preventable:true}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Target{slot:@last_slot, index:0})), amount:$number, preventable:true}}]}}]} */
conditional_damage_to_creature_controller ::= SELF_NAME "deals" number "damage" "to" "target" "creature" "." "if" condition_gift_promised "," SELF_NAME "also" "deals" number "damage" "to" "that" "creature's" "controller" "."

/* Entwine for an announced number of modes. The options are shared by both
   branches, while the paid branch selects every option. */
/* @sem Ability::CostBranch{keyword:Entwine, cost:$keyword_payment, paid:Spell{announcement:_{modes:ModeSelection{count:ModeCount{minimum:@length($entwine_opponent_graveyard_modes), maximum:@length($entwine_opponent_graveyard_modes)}, options:$entwine_opponent_graveyard_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}}}, body:Program{}}, unpaid:Spell{announcement:_{modes:ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$entwine_opponent_graveyard_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}}}, body:Program{}}} */
spell_entwine_opponent_graveyards ::= "choose" number_words "—" NEWLINE entwine_opponent_graveyard_modes NEWLINE "entwine" keyword_payment

/* This list scopes the possessive graveyard spelling to its modal setting;
   surrounding modes remain independently compositional. */
/* @sem Mode::[$entwine_opponent_sacrifice_mode, $entwine_opponent_graveyard_mode, ...$modes] */
entwine_opponent_graveyard_modes ::= entwine_opponent_sacrifice_mode NEWLINE entwine_opponent_graveyard_mode NEWLINE modes

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:OpponentsOf(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$sacrifice_choice_filter}, choose:AsManyAsCan($counter_amount)})}]}, weight:1}) */
entwine_opponent_sacrifice_mode ::= "•" "each" "opponent" "sacrifices" counter_amount sacrifice_choice_filter "of" "their" "choice" "."

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Zone{scope:Players{zone:Graveyard, players:OpponentsOf(AbilityController)}, kind:Card, filter:Any}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}, weight:1}) */
entwine_opponent_graveyard_mode ::= "•" "exile" "all" "opponents'" "graveyards" "."

/* Scope the maximum to the discarding player's hand, and keep the following
   conditional in the same spell so its player reference remains bound. */
/* @sem Program::Program{instructions:[...$discard_maximum_hand, If{condition:$condition_beheld, then:Program{instructions:$discard_player_graveyard}, otherwise:Program{}}]} */
program_discard_maximum_conditional ::= discard_maximum_hand "." "if" condition_beheld "," discard_player_graveyard "."

/* Declining a sacrifice payment performs the following instructions. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[$cost_sacrifice]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:$instructions}, otherwise:Program{}}] */
instructions_unless_sacrifice ::= "unless" "you" cost_sacrifice "," instructions

/* Both alternatives use the same selected-card continuation. */
/* @sem Ability::CostBranch{keyword:Cleave, cost:$cost, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:Any, count:AsManyAsCan(Constant(1))}]}}, ...$search_selected_it_to_hand_shuffle]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:$card_filter, count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, ...$search_selected_it_to_hand_shuffle]}})} */
spell_cleave_search_selected ::= "cleave" cost NEWLINE "search" "your" "library" "for" "a" "[" card_filter "]" "card" "," "[" "reveal" "it" "," "]" search_selected_it_to_hand_shuffle "."

/* The abbreviated second search changes only the quantity. */
/* @sem Ability::CostBranch{keyword:Kicker, cost:$keyword_payment, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:@agree($card_filter, $card_filter_2), count:UpTo($value)}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, ...$search_selected_it_to_hand_shuffle]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:@agree($card_filter, $card_filter_2), count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, ...$search_selected_it_to_hand_shuffle]}})} */
spell_kicker_search_selected ::= "kicker" keyword_payment NEWLINE "search" "your" "library" "for" "a" card_filter "card" "," "reveal" "it" "," search_selected_it_to_hand_shuffle "." "if" "this" "spell" "was" "kicked" "," "search" "your" "library" "for" value card_filter "cards" "instead" "of" "one" "."

/* Each alternative has an independent announcement and damage operation. */
/* @sem Ability::CostBranch{keyword:Madness, cost:$keyword_payment, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$spell_divided_damage_instead}]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$spell_divided_damage}]}})} */
spell_madness_divided_replacement ::= "madness" keyword_payment NEWLINE spell_divided_damage "." "if" "this" "spell's" "madness" "cost" "was" "paid" "," spell_divided_damage_instead "."

/* The second shield refers to the sole damage recipient announced by the first. */
/* @sem Program::Program{instructions:[If{condition:$condition, then:_{instructions:[Effect{result:@next, operation:$prevention_same_target}]}, otherwise:_{instructions:[Effect{result:@next, operation:$prevention_targeted}]}}]} */
prevention_target_override_program ::= prevention_targeted "." "if" condition "," prevention_same_target "instead" "."

/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:$prevent_to_any_target, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:TotalDamage($number), duration:$prevent_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevention_targeted ::= "prevent" "the" "next" number "damage" "that" "would" "be" "dealt" "to" prevent_to_any_target prevent_duration

/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:Target{slot:0, index:0}, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:TotalDamage($number), duration:$prevent_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevention_same_target ::= "prevent" "the" "next" number "damage" "that" "would" "be" "dealt" "to" "that" "permanent" "or" "player" prevent_duration

/* The first operation creates the extra turn used by both dependent effects. */
/* @sem Ability::CostBranch{keyword:Cleave, cost:$cost, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$cleave_take_extra_turn}, Effect{result:@next, operation:$cleave_extra_turn_damage}, ...$clause_2]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$cleave_take_extra_turn}, Effect{result:@next, operation:$cleave_extra_turn_damage}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:ExtraTurn(0), body:Program{instructions:$clause}}}, ...$clause_2]}})} */
spell_cleave_extra_turn_delayed ::= "cleave" cost NEWLINE cleave_take_extra_turn "." cleave_extra_turn_damage "." "[" "At" "the" "beginning" "of" "that" "turn's" "end" "step" "," clause "." "]" NEWLINE clause "."

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::TakeExtraTurn{}} */
cleave_take_extra_turn ::= "take" "an" "extra" "turn" "after" "this" "one"

/* @sem Operation::GameEffect{until:ExtraTurn(0), effect:Term{family:GameEffect, form:DamageCantBePrevented}} */
cleave_extra_turn_damage ::= "during" "that" "turn" "," "damage" "can't" "be" "prevented"

/* A choice of an owned permanent or a revealed card supplies the corresponding
   branch's property measurement. The two cost filters are independent. */
/* @sem Ability::CostOptions{keyword:AdditionalCost, options:[[_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($noun, $noun_2), ControlledBy(One(AbilityController))])}, count:AsManyAsCan(Constant(1))}}]}}]}, @scope(Ability::Spell{body:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_phrase}), index:0})), amount:ObjectProperty{object:Earlier{what:Selected}, property:$stat, information:CurrentOrLastKnown}, preventable:true}}]}, announcement:@announcement})], [_{parts:[Reveal{count:Exactly(Constant(1)), filter:$card_filter}]}, @scope(Ability::Spell{body:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_phrase}), index:0})), amount:Earlier{what:Revealed, measure:Of($stat)}, preventable:true}}]}, announcement:@announcement})]]} */
choice_reveal_property_damage ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "choose" "a" noun "you" "control" "or" "reveal" "a" card_filter "card" "from" "your" "hand" "." NEWLINE SELF_NAME "deals" "damage" "equal" "to" "the" stat "of" "the" noun "you" "chose" "or" "the" "card" "you" "revealed" "to" "target" filter_phrase "."

/* Both branches retain the same search choice and its result. The paid branch
   replaces revealing and the hand move; the conditional shuffle is retained. */
/* @sem Program::Program{instructions:[If{condition:ObjectMatches{object:Source, filter:State(Kicked)}, then:Program{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_many], also:[Graveyard], either:true}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, If{condition:Searched(@marked), then:Program{instructions:[Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:Program{}}]}, otherwise:Program{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_many], also:[Graveyard], either:true}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, If{condition:Searched(@marked), then:Program{instructions:[Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:Program{}}]}}]} */
kicker_search_either_replacement ::= "search" "your" "library" "and" "/" "or" "graveyard" "for" search_choice_many "," "reveal" "them" "," "and" "put" "them" "into" "your" "hand" "." "if" "you" "search" "your" "library" "this" "way" "," "shuffle" "." "if" "this" "spell" "was" "kicked" "," "put" "those" "cards" "onto" "the" "battlefield" "instead" "of" "putting" "them" "into" "your" "hand" "."

/* The delayed discard names the result of this exact conjure in the trigger. */
/* @sem Program::Program{instructions:[If{condition:ObjectMatches{object:Source, filter:State(Kicked)}, then:_{instructions:[Effect{result:@next, operation:CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:$spell_filter}, duration:$this_duration, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$conjure_cast_subject_duplicate}]}, once:true}}]}, otherwise:_{instructions:[Effect{result:@next, operation:CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:$spell_filter}, duration:$this_duration, announcement:@announcement, body:_{instructions:[Effect{result:@mark, operation:$conjure_cast_subject_duplicate}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:One(AbilityController)}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:DiscardObjects{objects:One(Result{result:@marked, phase:After, index:0})}}]}}}]}, once:true}}]}}]} */
kicker_next_cast_conjure_discard ::= "when" "you" "next" "cast" spell_filter this_duration "," conjure_cast_subject_duplicate "." "if" "this" "spell" "wasn't" "kicked" "," "discard" "the" "duplicate" "at" "the" "beginning" "of" "your" "next" "end" "step" "."

/* Kicker can replace an announced target's qualifying property while a shared
   continuation acts on the target chosen in the corresponding spell branch. */
/* @sem Ability::CostBranch{keyword:Kicker, cost:$keyword_payment, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@agree($noun, @agree($noun_2, $noun_3))}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, $chosen_target_life]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([@agree($noun, @agree($noun_2, $noun_3)), $modifier_mana_value_bound])}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, $chosen_target_life]}})} */
spell_kicker_target_qualification ::= "kicker" keyword_payment NEWLINE "choose" "target" noun modifier_mana_value_bound "." "if" "this" "spell" "was" "kicked" "," "instead" "choose" "target" noun "." "exile" "the" "chosen" noun "," "then" chosen_target_life "."

/* The controller and measured property both refer to the announced object,
   whose current or last known information survives the preceding move. */
/* @sem Instruction::Effect{result:@next, operation:GainLife{players:One(ControllerOf(Target{slot:0, index:0})), amount:ObjectProperty{object:Target{slot:0, index:0}, property:$stat, information:CurrentOrLastKnown}}} */
chosen_target_life ::= "its" "controller" "gains" "life" "equal" "to" "its" stat

/* Alternative selection costs specialize one independently scoped spell per choice. */
/* @sem Ability::CostOptions{keyword:AdditionalCost, options:[[$casting_controlled_choice, @scope(Ability::Spell{body:$chosen_choice_program, announcement:@announcement})], [$casting_warped_choice, @scope(Ability::Spell{body:$chosen_choice_program, announcement:@announcement})]]} */
spell_alternative_selection ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "choose" casting_controlled_choice "or" casting_warped_choice "." NEWLINE chosen_choice_program

/* @sem Cost::Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}, count:AsManyAsCan(Constant(1))}}]}}]} */
casting_controlled_choice ::= "a" "creature" "you" "control"

/* @sem Cost::Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Exile), kind:Card, filter:AllOf([State(Warped), CardType(Creature), OwnedBy(One(AbilityController))])}, count:AsManyAsCan(Constant(1))}}]}}]} */
casting_warped_choice ::= "a" "warped" "creature" "card" "you" "own" "in" "exile"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:$recipients, amount:ObjectProperty{object:Earlier{what:Selected}, property:$stat, information:CurrentOrLastKnown}, preventable:true}}]} */
chosen_choice_program ::= self_explicit_ref "deals" "damage" "equal" "to" "the" stat "of" "the" "chosen" "creature" "or" "card" "to" recipients "."

/* Cleave removes the target's bracketed subtype while leaving both effects intact. */
/* @sem Ability::CostBranch{keyword:Cleave, cost:$cost, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0})), amount:$number_digits, preventable:true}}, Effect{result:@next, operation:$you_gain_life}]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$subtype, CardType(Creature)])}), index:0})), amount:$number_digits, preventable:true}}, Effect{result:@next, operation:$you_gain_life}]}})} */
spell_cleave_subtype_damage_life ::= "cleave" cost NEWLINE SELF_NAME "deals" number_digits "damage" "to" "target" "[" subtype "]" "creature" "." you_gain_life "."

/* Conditional second damage has its own announced target only in the paid branch. */
/* @sem Program::Program{instructions:[If{condition:ObjectMatches{object:Source, filter:State(Kicked)}, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(2)), filter:Any}), index:0}, amount:$number_digits, preventable:true}}, Effect{result:@next, operation:DealDamage{source:Source, recipients:Target{slot:0, index:1}, amount:$number_digits_2, preventable:true}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any})), amount:$number_digits, preventable:true}}]}}]} */
kicker_distinct_damage_program ::= SELF_NAME "deals" number_digits "damage" "to" "any" "target" "." "if" "this" "spell" "was" "kicked" "," "it" "deals" number_digits "damage" "to" "another" "target" "."

/* The definition supplies both unpaid amounts; the paid branch uses announced X.
   Targets, the counted population and the cleave mana remain independent operands. */
/* @sem Ability::CostBranch{keyword:Cleave, cost:_{parts:[ManaWithX{mana:$mana_symbols}]}, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_phrase}), index:0})), amount:AnnouncedX, preventable:true}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:AnnouncedX}}]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_phrase}), index:0})), amount:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$plural, ControlledBy(One(AbilityController))])}), preventable:true}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$plural, ControlledBy(One(AbilityController))])})}}]}})} */
spell_cleave_damage_life_count ::= "cleave" mana_symbols NEWLINE self_explicit_ref "deals" "X" "damage" "to" "target" filter_phrase "and" "you" "gain" "X" "life" "." "[" "X" "is" "the" "number" "of" plural "you" "control" "." "]"

/* The kicked branch changes the amount while keeping both announced targets. */
/* @sem Program::Program{instructions:[If{condition:ObjectMatches{object:@self, filter:State(Kicked)}, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([@agree($noun, $noun_3), ControlledBy(One(AbilityController))])}), index:0}, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun_2, ControlledBy(OpponentsOf(AbilityController))])}), index:0})), amount:Multiply(Constant(2), ObjectProperty{object:Target{slot:0, index:0}, property:Power, information:CurrentOrLastKnown}), preventable:true}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([@agree($noun, $noun_3), ControlledBy(One(AbilityController))])}), index:0}, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun_2, ControlledBy(OpponentsOf(AbilityController))])}), index:0})), amount:ObjectProperty{object:Target{slot:0, index:0}, property:Power, information:CurrentOrLastKnown}, preventable:true}}]}}]} */
controlled_power_damage_kicked ::= "target" noun "you" "control" "deals" "damage" "equal" "to" "its" "power" "to" "target" noun "an" "opponent" "controls" "." "if" "this" "spell" "was" "kicked" "," "the" noun "you" "control" "deals" "twice" "that" "much" "damage" "instead" "."

/* Two independently described populations receive snapshot effects; kicker
   decides only whether the second instruction happens. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One($retirement_population_controller))])}), changes:$retirement_plural_changes, duration:EndOfTurn, evaluation:Snapshot}}, If{condition:ObjectMatches{object:@self, filter:State(Kicked)}, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$kicker_additional_population, ControlledBy(One($retirement_population_controller_2))])}), changes:$kicker_additional_pump, duration:EndOfTurn, evaluation:Snapshot}}]}, otherwise:Program{}}]} */
kicker_population_conditional_additional ::= filter_plural retirement_population_controller retirement_plural_changes "until" "end" "of" "turn" "." "if" "this" "spell" "was" "kicked" "," kicker_additional_population retirement_population_controller kicker_additional_pump "until" "end" "of" "turn" "."

/* @sem @and($kicker_creature_subtype, ObjectFilter::CardType(Creature)) */
kicker_additional_population ::= kicker_creature_subtype "creatures"

kicker_creature_subtype ::= creature_subtype | kicker_zombie_capitalized

/* @sem $noun_zombie_folded */
kicker_zombie_capitalized ::= "↑" noun_zombie_folded

/* @sem Change::[Change::Pump{power:$signed, toughness:$signed_2}] */
kicker_additional_pump ::= "get" "an" "additional" signed "/" signed

/* The follow-up is tied to the preceding search's tapped battlefield move.
   Both descriptions of the selected population must agree. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:@agree($card_filter, $filter_plural), count:UpTo($count)}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}, If{condition:$condition_cast_kicked, then:Program{instructions:[Effect{result:@next, operation:SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($card_filter, $filter_plural), InSet(Recorded(1))])}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Transition{result:1, phase:After}), changes:[SetBasePowerToughness{power:$value, toughness:$value_2}, Colors{mode:Set, colors:[$mana_color_word]}, AddCardType(Creature), GrantKeyword($keyword_value)], duration:Indefinite, evaluation:Snapshot}}]}, otherwise:Program{}}]} */
kicker_search_battlefield_animation ::= "search" "your" "library" "for" "up" "to" count card_filter "cards" "," "put" "them" "onto" "the" "battlefield" "tapped" "," "then" "shuffle" "." NEWLINE "if" condition_cast_kicked "," "untap" "all" filter_plural "put" "onto" "the" "battlefield" "this" "way" "." "they" "become" value "/" value mana_color_word "creatures" "with" keyword_value "that" "are" "still" "lands" "."

/* Both choices are announced independently of the conditional placement. */
/* @sem Program::Program{instructions:[If{condition:$condition_gift_promised, then:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:0, index:0})), kind:$counter_kind, amount:Constant(1)}]}}]}, otherwise:Program{}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), index:0}, second:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(OthersThan(AbilityController))])}), index:0}}}}]} */
chosen_creatures_conditional_counter_fight ::= "choose" "target" "creature" "you" "control" "and" "target" "creature" "you" "don't" "control" "." "put" "a" counter_kind "counter" "on" "the" "creature" "you" "control" "if" condition_gift_promised "." "then" "those" "creatures" "fight" "each" "other" "."

/* The first quantity and recipe are shared by both branch specializations. */
replacement_initial_count ::= replacement_initial_words | replacement_initial_article

/* @sem $number_words */
replacement_initial_words ::= number_words

/* @prefer always */
/* @sem Expr::Constant(1) */
replacement_initial_article ::= "a"

replacement_token_recipe ::= token_recipe | replacement_copy_recipe

/* @sem TokenRecipe::Copy{object:$object_ref, exceptions:[]} */
replacement_copy_recipe ::= "token" "that's" "a" "copy" "of" object_ref

/* The cleave payment removes the subtype restriction but retains the target and move. */
/* @sem Ability::CostBranch{keyword:Cleave, cost:$cost, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$cleave_subtype_pair, CardType(Creature)])}), index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}})} */
spell_cleave_return_subtype_pair ::= "cleave" cost NEWLINE "return" "target" "[" cleave_subtype_pair "]" "creature" "to" "its" "owner's" "hand" "."

/* A bracketed target modifier applies only when the cleave cost is unpaid.
   Both branches independently announce the target and move it to its owner. */
/* @sem Ability::CostBranch{keyword:Cleave, cost:$cost, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_phrase}), index:0}), destination:$cleave_return_destination, qualifiers:[]}}]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($filter_phrase, $cleave_target_modifier)}), index:0}), destination:$cleave_return_destination, qualifiers:[]}}]}})} */
spell_cleave_return_modified_target ::= "cleave" cost NEWLINE "return" "target" filter_phrase "[" cleave_target_modifier "]" "to" cleave_return_destination "."

cleave_target_modifier ::= modifier_you_control | modifier_opponent_controls

cleave_return_destination ::= put_exiled_singular_hand | put_exiled_singular_graveyard

/* The conditional return announces a distinct second target only when kicked. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_phrase}), index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, If{condition:ObjectMatches{object:Source, filter:State(Kicked)}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(SameObject(Target{slot:0, index:0})), $filter_phrase_2])}), index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{}}]} */
kicker_distinct_return_program ::= "return" "target" filter_phrase "to" "its" "owner's" "hand" "." "if" "this" "spell" "was" "kicked" "," "return" "another" "target" filter_phrase "to" "its" "owner's" "hand" "."

/* The cost test specializes a searched card's destination; the search and its
   reveal are shared within each branch, and the chosen-type test uses that
   exact selection. The two search operands are required to agree on printing. */
/* @sem Program::Program{instructions:[If{condition:$condition_additional_paid, then:Program{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_filtered]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, If{condition:Compare{left:CountObjects(Matching{objects:Selected(@marked), filter:Chosen(CreatureType)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}]}, otherwise:Program{}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:Program{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_filtered]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}}]} */
search_reveal_chosen_type_paid_destination ::= "search" "your" "library" "for" search_choice_filtered "," "reveal" "it" "," "put" "it" "into" "your" "hand" "," "then" "shuffle" "." "if" condition_additional_paid "and" "the" "revealed" "card" "is" "the" "chosen" "type" "," "put" "that" "card" "onto" "the" "battlefield" "instead" "of" "putting" "it" "into" "your" "hand" "."

/* A conditional destruction announces a distinct second target only when kicked. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Destroy{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_phrase}), index:0}), regeneration:true}}, If{condition:ObjectMatches{object:@self, filter:State(Kicked)}, then:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(Target{slot:0, index:0})), $filter_phrase_2)}), index:0}), regeneration:true}}]}, otherwise:Program{}}]} */
kicker_destroy_distinct_targets ::= "destroy" "target" filter_phrase "." "if" "this" "spell" "was" "kicked" "," "destroy" "another" "target" filter_phrase "."

/* The seek establishes the card referent for the conditional follow-up. */
/* @prefer always */
/* @sem Program::Program{instructions:[Group(Program{instructions:$clause_seek_card}), ...$seek_conditional_put]} */
seek_conditional_program ::= clause_seek_card "." seek_conditional_put "."

seek_conditional_put ::= seek_conditional_put_tapped | seek_conditional_put_untapped

/* @prefer always */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:Move{objects:One($current_card_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{}}] */
seek_conditional_put_tapped ::= "if" condition "," "put" current_card_ref "onto" "the" "battlefield" "tapped"

/* @prefer always */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:Move{objects:One($current_card_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{}}] */
seek_conditional_put_untapped ::= "if" condition "," "put" current_card_ref "onto" "the" "battlefield"

/* Both parts are one damage event in the paid branch. */
/* @prefer always */
/* @sem Program::Program{instructions:[If{condition:$condition_cast_kicked, then:Program{instructions:[Effect{result:@next, operation:DealDamageParts{source:Source, parts:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$noun}), index:0})), amount:$number}, _{recipients:$recipients_player_or_walker, amount:$number_2}], preventable:true}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Target{slot:@last_slot, index:0})), amount:$number, preventable:true}}]}}]} */
kicker_conditional_extra_target_damage ::= SELF_NAME "deals" number "damage" "to" "target" noun "." "if" condition_cast_kicked "," "it" "also" "deals" number "damage" "to" recipients_player_or_walker "."

/* A conditional creation precedes the separately announced per-opponent damage. */
/* @sem Program::Program{instructions:[If{condition:$condition_cast_kicked, then:Program{instructions:[Effect{result:@next, operation:$create_one_defined}]}, otherwise:Program{}}, ...$opponent_chosen_damage]} */
conditional_then_opponent_damage_program ::= "if" condition_cast_kicked "," create_one_defined "." NEWLINE opponent_chosen_damage "."

/* The common prefix is independently bound in each teamwork branch. */
/* @sem Ability::CostBranch{keyword:Teamwork, cost:Cost{parts:[Teamwork($number)]}, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[...$clause_top_exile_play_those, ...$clause]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:$clause_top_exile_play_those}})} */
/* @prefer always */
spell_teamwork_paid_exile_branch ::= "teamwork" NUMBER NEWLINE clause_top_exile_play_those "." "if" "this" "spell" "was" "cast" "using" "teamwork" "," clause "."

/* A kicked spell may add damage to a distinct target after an ordinary action. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$spared_return}, If{condition:ObjectMatches{object:Source, filter:State(Kicked)}, then:Program{instructions:[$kicker_damage_another]}, otherwise:Program{}}]} */
kicker_prior_action_spell_damage ::= spared_return "." "if" "this" "spell" "was" "kicked" "," kicker_damage_another "."

/* @sem Instruction::Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(Target{slot:0, index:0})), $filter_phrase)}), index:0})), amount:$number, preventable:true}} */
kicker_spell_damage_another ::= "it" "deals" number "damage" "to" "another" "target" filter_phrase /* @prefer always */

/* The spell deals damage measured from the attempted destruction target, even if destruction fails. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Destroy{objects:One($target_permanent), regeneration:true}}, If{condition:ObjectMatches{object:Source, filter:State(Kicked)}, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One($target_permanent_2)), amount:ObjectProperty{object:Target{slot:0, index:0}, property:$stat_mana_value, information:CurrentOrLastKnown}, preventable:true}}]}, otherwise:Program{}}]} */
kicker_destroy_target_property_damage ::= "destroy" target_permanent "." "if" "this" "spell" "was" "kicked" "," "it" "deals" "damage" "equal" "to" "that" "permanent's" stat_mana_value "to" target_permanent "."

/* The repeated noun identifies the two sacrifice options and the option tested
   by the follow-up. The common destruction is bound independently in each spell. */
/* @sem ObjectFilter::@agree($filter_head, $filter_head_2) */
modified_sacrifice_choice ::= "sacrifice" "a" filter_head "or" "sacrifice" "a" "modified" filter_head

/* @sem Ability::CostOptions{keyword:AdditionalCostOption, options:[[_{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($modified_sacrifice_choice, $filter_head)}, choose:Exactly(Constant(1))}]}, @scope(Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$destroy}]}})], [_{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($modified_sacrifice_choice, $filter_head), Modified])}, choose:Exactly(Constant(1))}]}, @scope(Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$destroy}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}]}})]]} */
spell_modified_sacrifice_choice ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," modified_sacrifice_choice "." NEWLINE destroy "." "if" "the" "modified" filter_head "was" "sacrificed" "," "draw" card_count "."

/* @sem $clause */
kicker_replacement_standard ::= "instead" clause | clause "instead"

/* A replacement search keeps its own selection and follow-up episode. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:$filter_phrase, count:UpTo($value)}]}}, ...$search_plural_follow] */
kicker_replacement_counted_search ::= "instead" "search" "your" "library" "for" value filter_phrase "cards" search_plural_follow

kicker_damage_another ::= kicker_spell_damage_another | kicker_prior_target_damage_another

/* The pronoun can also refer to the previously announced target. */
/* @sem Instruction::Effect{result:@next, operation:DealDamage{source:Target{slot:0, index:0}, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(Target{slot:0, index:0})), $filter_phrase)}), index:0})), amount:$number, preventable:true}} */
kicker_prior_target_damage_another ::= "it" "deals" number "damage" "to" "another" "target" filter_phrase

/* The pronoun also permits the destroyed target as damage source. Preserve that
   distinct reading with the same independent target and property operands. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Destroy{objects:One($target_permanent), regeneration:true}}, If{condition:ObjectMatches{object:Source, filter:State(Kicked)}, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Target{slot:0, index:0}, recipients:Objects(One($target_permanent_2)), amount:ObjectProperty{object:Target{slot:0, index:0}, property:$stat_mana_value, information:CurrentOrLastKnown}, preventable:true}}]}, otherwise:Program{}}]} */
kicker_destroy_target_property_damage_target_source ::= "destroy" target_permanent "." "if" "this" "spell" "was" "kicked" "," "it" "deals" "damage" "equal" "to" "that" "permanent's" stat_mana_value "to" target_permanent "."

/* A bracketed spell qualifier is removed from the target when cleave is paid. */
/* @sem Ability::CostBranch{keyword:Cleave, cost:$keyword_payment, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:$stack_spell_filter}), index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:@and($stack_spell_filter, $bracketed_cast_origin)}), index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}})} */
spell_cleave_counter_qualified ::= "cleave" keyword_payment NEWLINE "counter" "target" stack_spell_filter "[" bracketed_cast_origin "]" "."

/* Damage has one announced recipient; the conditional rider refers to that
   recipient, including when it is not a creature. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$damage_any_target_shared}, If{condition:$condition, then:Program{instructions:$damage_recipient_creature_rider}, otherwise:Program{}}]} */
damage_recipient_conditional_program ::= damage_any_target_shared "." "if" condition "," damage_recipient_creature_rider "."

/* The returned arrival supplies the duplicate; its conjured arrival receives the grant. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$return_target_to_owner}, If{condition:$condition_cast_kicked, then:Program{instructions:$duplicate_returned_card_perpetual}, otherwise:Program{}}]} */
kicker_return_duplicate_program ::= return_target_to_owner "." "if" condition_cast_kicked "," duplicate_returned_card_perpetual

/* @sem Operation::Move{objects:One($return_duplicate_target), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_target_to_owner ::= "return" return_duplicate_target "to" "its" "owner's" "hand"

/* @sem Instruction::[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Duplicate(One(Result{result:@prior, phase:After, index:0})), count:Constant(1), destination:Hand(CardArrival{counters:[], states:[]})}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$conjured_perpetual_changes}}] */
duplicate_returned_card_perpetual ::= "conjure" "a" "duplicate" "of" "that" "card" "into" "your" "hand" "." "it" "perpetually" conjured_perpetual_changes

return_duplicate_target ::= return_duplicate_qualified_target | target_permanent

/* @prefer always */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($adjective_nontoken, $adjective_nontype)}), index:0} */
return_duplicate_qualified_target ::= "target" adjective_nontoken "," adjective_nontype "permanent"

/* A bracketed target quality is removed when cleave is paid; the action and
   target kind remain the same in both independently announced spell branches. */
/* @sem Ability::CostBranch{keyword:Cleave, cost:$cost, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$noun_atomic}), index:0}), regeneration:true}}]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($quality_unscoped, $noun_atomic)}), index:0}), regeneration:true}}]}})} */
spell_cleave_destroy_qualified_target ::= "cleave" cost NEWLINE "destroy" "target" "[" quality_unscoped "]" noun_atomic "."

/* Cleaving a qualifier changes only the filter on the same destroyed population. */
/* @sem Ability::CostBranch{keyword:Cleave, cost:$cost, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, regeneration:true}}]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, $modifier_mana_value_bound)}, regeneration:true}}]}})} */
spell_cleave_destroy_qualified_population ::= "cleave" cost NEWLINE "destroy" "all" filter_plural "[" modifier_mana_value_bound "]" "."

/* The two typed costs prove that the condition names the singleton input
   of the same behold payment. */
/* @sem Ability::CostBranch{keyword:AdditionalCost, cost:@agree($behold_branch_header, $beheld_branch_test), paid:@scope(Ability::Spell{announcement:@announcement, body:_{instructions:[...$instructions, Effect{result:@next, operation:$beheld_perpetual_pump}]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:_{instructions:$instructions}})} */
spell_behold_perpetual_branch ::= behold_branch_header NEWLINE instructions "." beheld_branch_test "," beheld_perpetual_pump "."

/* @sem Cost::Cost{parts:[$cost_behold]} */
behold_branch_header ::= optional_cost_opening cost_behold "."

/* @sem Cost::Cost{parts:[Behold{count:Constant(1), what:$behold_kind}]} */
beheld_branch_test ::= "if" ("a" | "an") behold_kind "was" "beheld"

/* @sem Operation::CreatePerpetualEffect{objects:One(Query{objects:CostObjects{payment:Branch, component:[0], view:Inputs, phase:Before}, index:0}), changes:[Pump{power:$signed, toughness:$signed_2}]} */
beheld_perpetual_pump ::= "it" "perpetually" "gets" signed "/" signed

/* A single targeted snapshot gains a counted additional change when kicked. */
/* @sem Program::Program{instructions:[If{condition:ObjectMatches{object:Source, filter:State(Kicked)}, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($kicker_pump_creature)), changes:[Pump{power:$signed, toughness:$signed_2}, Pump{power:@times($signed_3, $count_each_graveyard), toughness:@times($signed_4, $count_each_graveyard)}], duration:EndOfTurn, evaluation:Snapshot}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($kicker_pump_creature)), changes:[Pump{power:$signed, toughness:$signed_2}], duration:EndOfTurn, evaluation:Snapshot}}]}}]} */
kicker_target_additional_count_pump ::= kicker_pump_creature "gets" signed "/" signed "until" "end" "of" "turn" "." "if" "this" "spell" "was" "kicked" "," "that" "creature" "gets" "an" "additional" signed "/" signed "until" "end" "of" "turn" "for" "each" count_each_graveyard "."

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$noun_creature}), index:0} */
kicker_pump_creature ::= "target" noun_creature

/* Overload changes the animated target to each matching permanent and places
   the follow-up counters on every permanent affected by that animation. */
/* @sem Ability::CostBranch{keyword:Overload, cost:$keyword_payment, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))}), changes:[SetBasePowerToughness{power:$number_digits, toughness:$number_digits_2}, AddCardType(Artifact), AddCardType(Creature)], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Affected(@prior)), kind:$counter_kind, amount:$counter_amount}]}}]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))}), index:0})), changes:[SetBasePowerToughness{power:$number_digits, toughness:$number_digits_2}, AddCardType(Artifact), AddCardType(Creature)], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:@last_slot, index:0})), kind:$counter_kind, amount:$counter_amount}]}}]}})} */
spell_overload_animate_counters ::= "target" filter_phrase "you" "control" "becomes" "a" number_digits "/" number_digits "artifact" "creature" "." "put" counter_amount counter_kind "counters" "on" "each" "artifact" "that" "became" "a" "creature" "this" "way" "." NEWLINE "overload" keyword_payment

/* Keep the multi-paragraph gift promise life-lock/protection-from-everything body bound with its trailing paragraph so abilities_more cannot split off a second root Spell. */
/* @sem Program::Program{instructions:[...$instructions, If{condition:$condition, then:Program{instructions:[...$clause, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(LifeTotalLocked), PlayerRule(GrantKeyword(Protection(Objects{kind:Any, filter:Any})))], duration:$duration, evaluation:LiveObjects}}]}, otherwise:Program{}}, ...$instructions_2]} */
branch_program_gift_phase_lock_exile ::= instructions "." "if" condition "," clause "," "and" duration "," "your" "life" "total" "can't" "change" "and" "you" "gain" "protection" "from" "everything" "." NEWLINE instructions "."

/* An optional additional-cost spell overriding combat control with full-turn control
   and exiling itself in both casting branches (preventing split CostBranch + Spell). */
/* @sem Ability::@additional_branch($branch_optional_cost, Ability::Spell{announcement:@announcement, body:Program{instructions:[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:TowardPlayer{actor:One(AbilityController), action:ControlNextTurn, player:Target{slot:@last_slot, index:0}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:TowardPlayer{actor:One(AbilityController), action:ControlNextCombat, player:$player_ref}}]}}, Effect{result:@next, operation:Move{objects:One(Source), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}) */
spell_additional_control_override_exile ::= optional_cost_opening branch_optional_cost "." NEWLINE "you" "control" player_ref "during" "their" "next" "combat" "phase" "." "if" condition "," "you" "control" "that" "player" "during" "their" "next" "turn" "instead" "." NEWLINE "exile" SELF_NAME "."

/* Cleave removes the bracketed mana-value restriction from the revealed-hand choice. */
/* @sem Ability::CostBranch{keyword:Cleave, cost:$cost, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Reveal{objects:Zone(_{scope:Players{zone:Hand, players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0})}, kind:Card, filter:Any})}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(2)), zone:Hand}, filter:@and($card_filter, ObjectFilter::OwnedBy(One(Target{slot:0, index:0})))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:DiscardObjects{objects:One(Result{result:@prior, phase:After, index:0})}}]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Reveal{objects:Zone(_{scope:Players{zone:Hand, players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0})}, kind:Card, filter:Any})}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(2)), zone:Hand}, filter:@and(ObjectFilter::AllOf([$card_filter, $modifier_mana_value_bound]), ObjectFilter::OwnedBy(One(Target{slot:0, index:0})))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:DiscardObjects{objects:One(Result{result:@prior, phase:After, index:0})}}]}})} */
spell_cleave_reveal_choose_discard ::= "cleave" cost NEWLINE "target" "player" "reveals" "their" "hand" "." "you" "choose" "a" card_filter "card" "from" "it" "[" modifier_mana_value_bound "]" "." "that" "player" "discards" "that" "card" "."

/* Overload turns the chosen controlled target into each qualifying permanent you control. */
/* @sem Ability::CostBranch{keyword:Overload, cost:$keyword_payment, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyEach{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun_atomic, CardType(Creature), ControlledBy(One(AbilityController))])}, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun_atomic, CardType(Creature), ControlledBy(One(AbilityController))])}), index:0}, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}})} */
spell_overload_choose_copy ::= "choose" "target" noun_atomic "creature" "you" "control" "." "for" "each" "creature" "chosen" "this" "way" "," "create" "a" "token" "that's" "a" "copy" "of" "it" "." NEWLINE "overload" keyword_payment

/* Overload exiles every qualifying card from your graveyard and copies each exiled card. */
/* @sem Ability::CostBranch{keyword:Overload, cost:$keyword_payment, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AnyOf([$spell_instant, $card_word])}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CopyCards{actor:One(AbilityController), objects:Transition{result:@prior, phase:After}, times:Constant(1)}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Copies(@prior), count:AnyNumber, cost:Free}}]}}, Effect{result:@next, operation:Move{objects:One(Source), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([AnyOf([$spell_instant, $card_word]), InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CopyCards{actor:One(AbilityController), objects:One(Result{result:@prior, phase:After, index:0}), times:Constant(1)}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Copies(@prior), count:Exactly(Constant(1)), cost:Free}}]}}, Effect{result:@next, operation:Move{objects:One(Source), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}})} */
spell_overload_graveyard_exile_copy ::= "exile" "target" "card" "that's" "an" spell_instant "or" card_word "from" "your" "graveyard" "." "for" "each" "card" "exiled" "this" "way" "," "copy" "it" "," "and" "you" "may" "cast" "the" "copy" "without" "paying" "its" "mana" "cost" "." "exile" SELF_NAME "." NEWLINE "overload" keyword_payment

/* A graveyard shuffle followed by two clauses in a branch that also carries a trailing instruction. */
/* @sem Instruction::[...$shuffle_own_graveyard, ...$clause, ...$clause_2] */
kicker_replacement_sequence ::= "instead" shuffle_own_graveyard "," clause "," "and" clause

/* @prefer always */
/* @sem Program::Program{instructions:[If{condition:$condition, then:Program{instructions:$kicker_replacement_sequence}, otherwise:Program{instructions:$clause}}, ...$instructions]} */
kicker_override_after_sequence ::= clause "." "if" condition "," kicker_replacement_sequence "." NEWLINE instructions "."

/* A paid teamwork spell adds its conditional follow-up to the common program. */
/* @sem Ability::CostBranch{keyword:Teamwork, cost:Cost{parts:[Teamwork($number)]}, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[...$instructions, ...$teamwork_followup]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions}})} */
spell_teamwork_also_branch ::= "teamwork" NUMBER NEWLINE instructions "." "also" teamwork_followup "if" "this" "spell" "was" "cast" "using" "teamwork" "."

teamwork_followup ::= teamwork_named_counter_followup | clause

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($that_noun)), kind:$counter_kind, amount:$counter_amount}]}}] */
teamwork_named_counter_followup ::= "put" counter_amount counter_kind "counter" "on" that_noun

/* Both branches instantiate the same conditional control instruction in
   separate spell scopes, preserving each branch's own target announcement. */
/* @sem Ability::CostBranch{keyword:Madness, cost:$keyword_payment, paid:@scope(Ability::Spell{body:_{instructions:$conditional_control_creature_2}, announcement:@announcement}), unpaid:@scope(Ability::Spell{body:_{instructions:$conditional_control_creature}, announcement:@announcement})} */
spell_madness_control_stat_ceiling ::= "madness" keyword_payment NEWLINE "gain" "control" "of" "target" conditional_control_creature "." "if" "this" "spell's" "madness" "cost" "was" "paid" "," "instead" "gain" "control" "of" "that" conditional_control_creature "."

/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$destroy_noncolor_creature_no_regeneration}, If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:$damage_target_creature_controller_stat}]}, otherwise:Program{}}]} */
destroy_creature_conditional_stat_damage ::= destroy_noncolor_creature_no_regeneration "." "if" condition "," damage_target_creature_controller_stat "."

/* Each branch owns both the selected exile and its subsequent permission, so
   the permission refers to that branch's actual exile arrival. */
/* @sem Program::Program{instructions:[If{condition:$condition_additional_paid, then:Program{instructions:[Effect{result:@next, operation:$exile_top_instead}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:Either, filter:Any})], duration:$duration, evaluation:LiveObjects}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:Either, filter:Any})], duration:$duration, evaluation:LiveObjects}}]}}]} */
/* @prefer always */
kicker_exile_top_override_permission ::= exile_top_cards_of_your_library "." "if" condition_additional_paid "," exile_top_instead "instead" "." duration "," "you" "may" "play" "those" "cards" "."

/* A replacement mill counts each affected player's own library. */
/* @sem Program::Program{instructions:[If{condition:$condition_cast_kicked, then:Program{instructions:$fraction_mill_plural}, otherwise:Program{instructions:$clause}}]} */
kicker_fraction_mill_override ::= clause "." "if" condition_cast_kicked "," "instead" fraction_mill_plural "."

/* The common program is bound independently in both spell scopes. */
/* @sem Ability::CostBranch{keyword:Teamwork, cost:Cost{parts:[Teamwork($number)]}, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[...$instructions, ...$teamwork_if_followup]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions}})} */
spell_teamwork_if_paid_branch ::= "teamwork" NUMBER NEWLINE instructions "." "if" "this" "spell" "was" "cast" "using" "teamwork" "," teamwork_if_followup "."

teamwork_if_followup ::= teamwork_if_draw | clause

/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}] */
teamwork_if_draw ::= "draw" card_count
