event_filtered_transforms ::= event_a "transforms"

event_filtered_enters_transformed ::= transformed_entry_plain | transformed_entry_controlled

/* @sem EventSpec::ZoneChange{objects:@and($event_a, ObjectFilter::State(Transformed)), to:Battlefield} */
transformed_entry_plain ::= event_a "enters" "transformed"

/* @sem EventSpec::Player{event:EntersUnderControl, players:All, objects:@and($controlled_entrant, ObjectFilter::State(Transformed))} */
transformed_entry_controlled ::= controlled_entrant "enters" "transformed"

/* @sem EventSpec::@either_event($event_filtered_transforms, $event_filtered_enters_transformed) */
event_transform_or_transformed_entry ::= event_filtered_transforms "or" event_filtered_enters_transformed

/* The first occurrence wraps the independently modeled card movement batch. */
/* @sem EventSpec::FirstEachTurn($event_cards_put_into_your_graveyard) */
event_first_cards_to_your_graveyard ::= event_cards_put_into_your_graveyard "for" "the" "first" "time" "each" "turn"

/* A gerund event can qualify a triggered ability independently of its holder. */
