singular_combat_attacks ::= "attacks"

/* @sem ObjectEvent::Blocks */
singular_combat_blocks ::= "blocks"

/* @sem ObjectEvent::BecomesBlocked */
singular_combat_blocked ::= "becomes" "blocked"

/* @sem PlayerHistory::PermanentEntered(AllOf([Not(SameObject(Source)), $filter_phrase])) */
historical_entry_under_your_control ::= "another" filter_phrase "enter" "the" "battlefield" "under" "your" "control"

