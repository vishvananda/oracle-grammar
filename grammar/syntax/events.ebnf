attach_second_choice ::= attach_choose_creature_type | attach_choose_color

/* @sem Operand::Term{family:AttachAction, form:ChooseACardName, operands:[Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Creature}]}]} */
attach_choose_creature_name ::= "choose" "a" "creature" "card" "name"

