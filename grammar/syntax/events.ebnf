attach_choose_creature_type ::= "a" "creature" "type"

/* @sem Operand::Term{family:AttachAction, form:ChooseAColor, operands:[Term{family:ChoosableColor, form:AnyColor}]} */
attach_choose_color ::= "a" "color"

attached_choice_host ::= attached_choice_creature | attached_choice_land | attached_choice_artifact

/* @sem $noun_creature */
attached_choice_creature ::= "a" noun_creature

/* @sem $noun_land */
attached_choice_land ::= "a" noun_land

/* @sem $noun_artifact */
attached_choice_artifact ::= "an" noun_artifact

/* The location and event frame a counter-driven return program. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$graveyard_local_event, intervening_if:ObjectMatches{object:Source, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}, limits:TriggerLimits{}, announcement:@announcement, body:$graveyard_symbol_counter_program})} */
graveyard_symbol_counter_trigger ::= graveyard_local_event "," "if" "this" "card" "is" "in" "your" "graveyard" "," graveyard_symbol_counter_program "."

/* @sem Program::Program{instructions:[$graveyard_symbol_counter_put, $graveyard_counter_return_perpetual]} */
graveyard_symbol_counter_program ::= graveyard_symbol_counter_put "." graveyard_counter_return_perpetual

/* @sem Instruction::Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Source)), kind:$counter_kind, amount:CountManaSymbols{objects:One(EventSubject), colors:[$graveyard_count_symbol]}}]}} */
graveyard_symbol_counter_put ::= "put" "a" counter_kind "counter" "on" "this" "card" "for" "each" graveyard_count_symbol "in" "that" "spell's" "mana" "cost"

/* @sem Instruction::If{condition:Compare{left:CountCounters(_{recipients:Objects(Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:SameObject(Source)})), kind:$counter_kind, information:CurrentOrLastKnown}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, then:_{instructions:[Effect{result:@next, operation:Move{objects:One(Source), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:[Pump{power:$signed, toughness:$signed_2}]}}]}, otherwise:_{}} */
graveyard_counter_return_perpetual ::= "if" "this" "card" "has" number "or" "more" counter_kind "counters" "on" "it" "," "return" "it" "to" "the" "battlefield" "and" "it" "perpetually" "gets" signed "/" signed

graveyard_count_symbol ::= graveyard_symbol_white | graveyard_symbol_blue | graveyard_symbol_black | graveyard_symbol_red | graveyard_symbol_green

/* @sem ManaColor::White */
graveyard_symbol_white ::= "{" "W" "}"

/* @sem ManaColor::Blue */
graveyard_symbol_blue ::= "{" "U" "}"

/* @sem ManaColor::Black */
graveyard_symbol_black ::= "{" "B" "}"

/* @sem ManaColor::Red */
graveyard_symbol_red ::= "{" "R" "}"

/* @sem ManaColor::Green */
graveyard_symbol_green ::= "{" "G" "}"

/* A whole batch can combine an owned private-zone movement with a separately
   caused battlefield movement. Each branch keeps its own object filter. */
/* @sem EventSpec::Batch{event:AnyOf([$private_exile_batch_event, $controlled_exile_batch_event]), per:Whole} */
private_or_controlled_exile_batch_clause ::= "whenever" private_exile_batch_event "or" controlled_exile_batch_event

/* @sem EventSpec::ZoneChange{objects:$event_owned_cards, from:$private_exile_origin, to:Exile} */
private_exile_batch_event ::= "one" "or" "more" event_owned_cards "are" "put" "into" "exile" "from" "your" private_exile_origin

private_exile_origin ::= private_exile_hand | ordered_zone

/* @sem EventZone::Hand */
private_exile_hand ::= "hand"

/* @sem EventSpec::Caused{cause:ControlledBy(One(AbilityController)), event:ZoneChange{objects:$controlled_exile_permanents, from:Battlefield, to:Exile}} */
controlled_exile_batch_event ::= "a" "spell" "or" "ability" "you" "control" "exiles" "one" "or" "more" controlled_exile_permanents "from" "the" "battlefield"

controlled_exile_permanents ::= controlled_exile_any_permanents | controlled_exile_filtered_permanents

/* @sem ObjectFilter::Any */
controlled_exile_any_permanents ::= "permanents"

/* @sem $filter_plural */
controlled_exile_filtered_permanents ::= filter_plural

/* The canonical event union may present the same alternatives in reverse order. */
/* @sem EventSpec::Batch{event:AnyOf([$controlled_exile_batch_event, $private_exile_batch_event]), per:Whole} */
private_or_controlled_exile_batch_clause_reverse ::= "whenever" private_exile_batch_event "or" controlled_exile_batch_event

/* The combined event is the canonical inverse of the two independently bound triggers. */
/* @sem EventSpec::@either_event(EventSpec::Object{event:PhasesOut, objects:$event_self}, EventSpec::Object{event:LeavesBattlefield, objects:$event_self}) */
event_phases_out_or_leaves ::= event_self "phases" "out" "or" "leaves" "the" "battlefield"

/* A card's plotted trigger functions in every zone and owns its body and targets. */
/* @sem EventSpec::Object{event:Plotted, objects:SameObject(Source)} */
plotted_source_event ::= "when" "this" "card" "becomes" "plotted"

/* @sem Ability::Scoped{zones:[Battlefield, Graveyard, Hand, Library, Stack, Exile, Command, Ante], ability:@scope(Ability::Triggered{event:$plotted_source_event, limits:TriggerLimits{}, announcement:@announcement, body:$plotted_source_body})} */
plotted_source_trigger ::= plotted_source_event "," plotted_source_body

plotted_source_body ::= plotted_source_damage | program_sentence

/* The event introduces the source card, so its pronoun can name that source. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:$recipients, amount:$number, preventable:true}}]} */
plotted_source_damage ::= "it" "deals" number "damage" "to" recipients "."

/* Casting the holder from its graveyard makes the triggered ability graveyard-local. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$cast_source_from_graveyard_program})} */
graveyard_source_cast_trigger ::= event_clause "," cast_source_from_graveyard_program "."

/* A reveal-and-selection program can follow any supported event clause. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$revealed_type_program} */
triggered_revealed_type_program ::= event_clause "," revealed_type_program "."
