vent_first_draw_each_turn | event_one_other_attack | event_you_roll_a_die | event_state_matching_object | event_pair_attack_different_players | event_controller_attack_with_pair | event_all_population_attacks | event_unblocked_attack_count | event_entry_tap_state | event_object_noncombat_damage_player | event_roll_result | event_reference_or_equipped_damage | event_indefinite_blocked_count | event_player_discards_filtered_card | event_leaves_or_becomes_untapped | event_you_discard_filtered_batch | event_named_counter_change | event_self_entry_from_zone | event_controlled_batch_combat_players | event_copy_third | event_opponent_attacks_another_defender | event_cast_nth_in_a_turn | event_group_attacks_players | event_cast_ordinal_postqualified | event_quantified_plural_put_counters | event_you_put_sticker_on_object | event_batch_attack_opponents_walkers | event_batch_attack_opponents | event_team_attacks_exactly | event_owned_graveyard_alternatives | event_entry_or_death | event_reference_or_indefinite_death | event_four_alternatives_becomes_tapped | event_third_copy_spell | event_reference_and_one_other_attacks | event_reference_and_many_others_attack | event_player_attacks_plural_defenders | event_attack_at_least_qualified | event_you_attacks_named_defender | event_opponent_cast_nth_nontype | event_you_put_single_named_counter | event_you_draw_ordinal_pair | event_cast_during_turn_except_ordinal | event_ordinal_draw_during_steps | event_entry_during_combat | event_entry_while_condition | event_permanent_damage_you_or_object | event_damage_permanent_or_player | event_target_pair_by_stack_source | event_damage_player_or_object | event_subject_attacks_or_enters_attacking | event_controlled_entry_or_object_transition | event_linked_name_land_tapped_for_mana | event_battlefield_exile_put | event_controlled_entry_with_counter | event_entry_with_counter | event_exiled_from_battlefield | event_third_ability_of | event_entry_causes_trigger | event_a_player_cast_ordinal | event_cast_first_time_each_turn | event_player_plays_linked_exile | event_entry_or_target_spell | event_you_play_linked_exile_card | event_player_plays_linked_exile_card | event_entry_or_spell_target | event_passive_nth_filtered_spell_turn | event_you_discard_card_alternative | event_nth_spell_of_turn_cast | event_player_chooses_targets | event_qualified_controlled_source_damage | event_self_dies_or_another_put_graveyard | event_except_entry | event_unspecified_counters_put_on_reference | event_counted_creatures_attack

event_once ::= event_self_enters | event_self_dies | event_self_leaves

/* @sem EventSpec::ZoneChange{objects:$event_self, to:Battlefield} */
event_self_enters ::= event_self ("enters" | "enter")

/* @sem EventSpec::ZoneChange{objects:$event_self, from:Battlefield, to:Graveyard} */
event_self_dies ::= event_self "dies"

/* @sem EventSpec::Object{event:LeavesBattlefield, objects:$event_self} */
event_self_leaves ::= event_self "leaves" "the" "battlefield"

event_object ::= event_equal_stats_controlled | event_controlled_singular_relative | event_controlled_with_counters | event_controlled_with_counters_an | event_another_controlled | event_legendary_with_counters | event_self | event_a | event_another | event_owned | event_attached | event_target | event_linked_battlefield_creature | event_above_base_controlled | event_controlled_subtype | event_color_nontoken | event_chosen_land_type_controlled | event_controlled_attached_alternative | event_chosen_creature | event_source_token_subject | event_saddled_controlled | event_controlled_mana_subject | event_controlled_mana_subject_an

/* A recalled singular object keeps its identity in face-up and source-damage
   events, including delayed triggers about a previously named object. */
event_singular_subject ::= event_object | event_referenced_subject | event_equipped_controlled_other | event_singular_turned_up_this_turn | event_singular_turned_up_this_turn_an
/* @sem ObjectFilter::SameObject($object_ref) */
event_referenced_subject ::= object_ref

/* @sem ObjectFilter::SameObject($attached_ref) */
event_attached ::= attached_ref

event_self ::= event_holder | event_named

/* Keep the holder's fixed identity in the forest; introducing a symbolic self
   here duplicates each ordinary enter/die reading before contextual binding. */
/* @sem ObjectFilter::SameObject(ObjectRef::Source) */
event_holder ::= self_holder_text

/* @sem ObjectFilter::SameObject(ObjectRef::@named_source) */
event_named ::= self_named

/* @sem $filter_phrase */
event_a ::= ("a" | "an") filter_phrase

/* @sem @and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $filter_phrase) */
event_another ::= "another" filter_phrase

/* @sem EventSpec::ZoneChange{objects:$event_object, to:Battlefield} */
event_enters ::= event_object "enters"

/* The native player event retains the written controller restriction in its
   object filter. Its object binding is the entrant, not that controller. */
event_controlled_enters ::= controlled_entry_prefix | controlled_entry_your_suffix | controlled_entry_opponent_suffix

/* @sem EventSpec::Player{event:EntersUnderControl, players:All, objects:$controlled_entrant} */
controlled_entry_prefix ::= controlled_entrant "enters"

/* @sem EventSpec::Player{event:EntersUnderControl, players:All, objects:@and($filter_phrase, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController)))} */
controlled_entry_your_suffix ::= ("a" | "an") filter_phrase "enters" "under" "your" "control"

/* @sem EventSpec::Player{event:EntersUnderControl, players:All, objects:@and($filter_phrase, ObjectFilter::ControlledBy(OpponentsOf(PlayerRef::AbilityController)))} */
controlled_entry_opponent_suffix ::= ("a" | "an") filter_phrase "enters" "under" "an" "opponent's" "control"

/* Original lowering forms still print from edited/source IR. The pinned native
   canonicalizer proves when they share the normal form above; parsing retains
   every distinct meaning, including bodies that observe an entry role. */
event_controlled_enters_original ::= controlled_entry_prefix_original | controlled_entry_your_suffix_original | controlled_entry_opponent_suffix_original

/* Putting a named kind of sticker on a permanent of a kind. */
/* @sem EventSpec::Player{event:$sticker_put_event, players:One(PlayerRef::AbilityController), objects:$filter_phrase} */
event_you_put_kind_sticker ::= "you" "put" ("a" | "an") sticker_put_event "sticker" "on" ("a" | "an") filter_phrase

sticker_put_event ::= sticker_put_name | sticker_put_art | sticker_put_ability
/* @sem PlayerEvent::PutsNameSticker */
sticker_put_name ::= "name"
/* @sem PlayerEvent::PutsArtSticker */
sticker_put_art ::= "art"
/* @sem PlayerEvent::PutsAbilitySticker */
sticker_put_ability ::= "ability"

/* @sem EventSpec::Player{event:PlacesSticker, players:One(PlayerRef::AbilityController)} */
event_you_place_sticker ::= "you" "place" "a" "sticker"

/* @sem EventSpec::Player{event:EntersUnderControl, players:One(PlayerRef::AbilityController), objects:$controlled_entrant} */
controlled_entry_prefix_original ::= controlled_entrant "enters"

/* @sem EventSpec::Player{event:EntersUnderControl, players:One(PlayerRef::AbilityController), objects:$filter_phrase} */
controlled_entry_your_suffix_original ::= ("a" | "an") filter_phrase "enters" "under" "your" "control"

/* @sem EventSpec::Player{event:EntersUnderControl, players:OpponentsOf(PlayerRef::AbilityController), objects:$filter_phrase} */
controlled_entry_opponent_suffix_original ::= ("a" | "an") filter_phrase "enters" "under" "an" "opponent's" "control"

/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:$event_self, to:Battlefield}, EventSpec::Player{event:EntersUnderControl, players:One(PlayerRef::AbilityController), objects:$controlled_entrant_another}) */
event_controlled_self_or_enters_original ::= event_self "or" controlled_entrant_another "enters"

/* The same normal form composes below a batch wrapper; EventGroup still names
   exactly this event's entrants, and quantity remains a count of that group. */
/* @sem EventSpec::Batch{event:Player{event:EntersUnderControl, players:All, objects:$controlled_entry_plural_filter}, per:Whole} */
event_many_controlled_enter ::= "one" "or" "more" controlled_entry_plural_filter "enter"

controlled_entry_plural_filter ::= controlled_entry_plural_plain | controlled_entry_plural_modified
controlled_entry_controller ::= modifier_you_control | modifier_opponent_controls | modifier_opponents_control | modifier_player_controls | modifier_they_control

/* @sem ObjectFilter::@and($filter_plural, $controlled_entry_controller) */
controlled_entry_plural_plain ::= filter_plural controlled_entry_controller

/* @sem ObjectFilter::@and($filter_plural, $controlled_entry_controller, $modifiers) */
controlled_entry_plural_modified ::= filter_plural controlled_entry_controller modifiers

/* Equal shared bodies may canonicalize to one Either; print that form too. */
/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:$event_self, to:Battlefield}, EventSpec::Player{event:EntersUnderControl, players:All, objects:$controlled_entrant_another}) */
event_controlled_self_or_enters ::= event_self "or" controlled_entrant_another "enters"

controlled_entrant ::= controlled_entrant_a | controlled_entrant_another
/* @sem ObjectFilter::$controlled_entry_filter */
controlled_entrant_a ::= ("a" | "an") controlled_entry_filter
/* @sem ObjectFilter::@and(ObjectFilter::Not(SameObject(Source)), $controlled_entry_filter) */
controlled_entrant_another ::= "another" controlled_entry_filter

controlled_entry_filter ::= controlled_entry_plain | controlled_entry_modified
/* @sem ObjectFilter::@and($filter_phrase, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController))) */
controlled_entry_plain ::= filter_phrase "you" "control"
/* @sem ObjectFilter::@and($filter_phrase, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController)), $modifiers) */
controlled_entry_modified ::= filter_phrase "you" "control" modifiers

/* @sem EventSpec::Batch{event:Attack{attackers:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $filter_plural), by:One(PlayerRef::AbilityController), defenders:Any}, per:Whole} */
event_attack_with_others ::= "you" "attack" "with" "one" "or" "more" "other" filter_plural

/* @sem EventSpec::ZoneChange{objects:@and($filter_phrase, ObjectFilter::OwnedBy(OthersThan(PlayerRef::AbilityController)), ObjectFilter::OwnedBy(All)), from:Battlefield, to:Graveyard} */
event_owned_by_other_to_graveyard ::= ("a" | "an") filter_phrase "owned" "by" "another" "player" "is" "put" "into" "a" "graveyard" "from" "the" "battlefield"

/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:$entry_or_unlock_filter, to:Battlefield}, EventSpec::Player{event:FullyUnlocksRoom, players:One(PlayerRef::AbilityController), objects:Subtype(Room)}) */
event_enters_or_unlock ::= entry_or_unlock_filter "enters" "and" "whenever" "you" "fully" "unlock" "a" "Room"

/* @sem EventSpec::Caused{cause:Any, event:Player{event:Shuffles, players:All}} */
event_shuffle_caused ::= "a" "spell" "or" "ability" "causes" "a" "player" "to" "shuffle" "their" "library"

/* @sem EventSpec::Object{event:Countered, objects:Cast{by:One(PlayerRef::AbilityController)}} */
event_countered ::= "a" "spell" "you've" "cast" "is" "countered"

/* @sem EventSpec::Filtered{event:Damage(DamageEvent{source_kind:Any, sources:Any, recipients:Players(OpponentsOf(PlayerRef::AbilityController)), kind:Any, grouping:SourceRecipient, subject:Source}), condition:Compare{left:Expr::EventAmount, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}} */
event_dealt_at_least ::= "an" "opponent" "is" "dealt" number "or" "more" "damage" "by" "a" "single" "source"

/* @sem EventSpec::Player{event:RollsDice, players:One(PlayerRef::AbilityController)} */
event_dice ::= "you" "roll" "one" "or" "more" "dice"

/* @sem EventSpec::Filtered{event:NthEachTurn{event:Spell{event:Cast, players:One(PlayerRef::AbilityController), spells:Any}, test:NumberTest::Compare{comparison:Equal, value:Expr::Constant(1)}}, condition:ExistsPlayer{players:OpponentsOf(PlayerRef::AbilityController), binding:0, condition:PlayerIsActive(Bound(0))}} */
event_first_spell_opponents_turn ::= "you" "cast" "your" "first" "spell" "during" "each" "opponent's" "turn"

/* @sem EventSpec::@either_event(EventSpec::Player{event:CreatesToken, players:One(PlayerRef::AbilityController), objects:Token}, EventSpec::Player{event:Sacrifices, players:One(PlayerRef::AbilityController), objects:Token}) */
event_create_or_sacrifice ::= "you" "create" "or" "sacrifice" "a" "token"

/* @sem EventSpec::BecomesTarget{objects:$event_object, kind:SpellOrAbility, by:Term{family:SpellsAndAbilities, form:ControlledByAPlayer, operands:[Players(OpponentsOf(PlayerRef::AbilityController))]}} */
event_target_by_opponent ::= event_object "becomes" "the" "target" "of" "a" "spell" "or" "ability" "an" "opponent" "controls"

/* @sem EventSpec::BecomesTarget{objects:$event_object, kind:SpellOrAbility, by:Term{family:SpellsAndAbilities, form:ControlledByAPlayer, operands:[Players(One(PlayerRef::AbilityController))]}} */
event_target_by_you ::= event_object "becomes" "the" "target" "of" "a" "spell" "or" "ability" "you" "control"

/* Valiant: only the first time each turn it becomes your target. */
/* @sem EventSpec::FirstEachTurn($event_target_by_you) */
event_target_by_you_first ::= event_target_by_you "for" "the" "first" "time" "each" "turn"

/* Your spell or ability is what counters the spell. */
/* @sem EventSpec::Caused{cause:ControlledBy(One(PlayerRef::AbilityController)), event:Object{event:Countered, objects:Any}} */
event_yours_counters_spell ::= "a" "spell" "or" "ability" "you" "control" "counters" "a" "spell"

/* @sem EventSpec::Damage(DamageEvent{source_kind:Any, sources:Any, recipients:Objects($event_filter), kind:Any, grouping:Recipient, subject:Recipient}) */
event_dealt_damage_object ::= event_filter "is" "dealt" "damage"

/* @sem $filter_phrase */
event_filter ::= ("a" | "an") filter_phrase

/* @sem EventSpec::Damage(DamageEvent{source_kind:Spell, sources:$spell_filter, recipients:Players(OpponentsOf(PlayerRef::AbilityController)), kind:Any, grouping:SourceRecipient, subject:Source}) */
event_spell_deals_damage ::= spell_filter "deals" "damage" "to" "an" "opponent"

/* The header names the damage's source explicitly, before EventSubject is bound. */
/* @sem EventSpec::Damage(DamageEvent{source_kind:Spell, sources:@and($spell_filter, ObjectFilter::OnStack(SingleTarget), ObjectFilter::TargetsAny(Recipients::Objects(ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:ObjectFilter::CardType(Creature)}))), recipients:Objects(ObjectFilter::SameObject(ObjectRef::SoleTargetOf(ObjectRef::Damage(Source)))), kind:Any, grouping:SourceRecipient, subject:Source}) */
event_spell_single_target_damage ::= spell_filter "that" "targets" "only" "a" "single" "creature" "deals" "damage" "to" "that" "creature"

/* @sem EventSpec::ZoneChange{objects:@and($card_filter, ObjectFilter::OwnedBy(OpponentsOf(PlayerRef::AbilityController)), ObjectFilter::Not(ObjectFilter::Token)), to:Graveyard} */
event_card_to_graveyard_opponent ::= ("a" | "an") card_filter "card" "is" "put" "into" "an" "opponent's" "graveyard" "from" "anywhere"

/* @sem EventSpec::ZoneChange{objects:@and($filter_phrase, ObjectFilter::OwnedBy(All)), from:Battlefield, to:Hand} */
event_returned_to_hand ::= ("a" | "an") filter_phrase "is" "returned" "to" "a" "player's" "hand"

/* @prefer always */
/* @sem EventSpec::NthEachTurn{event:Spell{event:Cast, players:All, spells:$spell_adjectives}, test:NumberTest::Compare{comparison:Equal, value:Expr::Constant(1)}} */
event_first_spell_player ::= "a" "player" "casts" "their" "first" spell_adjectives "spell" "each" "turn"

/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:$event_self, to:Battlefield}, EventSpec::Spell{event:Cast, players:One(PlayerRef::AbilityController), spells:$spell_filter}) */
event_self_enters_or_cast ::= event_self "enters" "and" "whenever" "you" "cast" spell_filter

/* @sem EventSpec::Attack{attackers:$filter_phrase, defenders:PlayersAndPlaneswalkers(One(PlayerRef::AbilityController))} */
event_attacks_you_walkers ::= ("a" | "an") filter_phrase "attacks" "you" "or" "a" "planeswalker" "you" "control"

/* @sem EventSpec::Attack{attackers:$filter_phrase, defenders:Players(OpponentsOf(PlayerRef::AbilityController))} */
event_attacks_opponents ::= ("a" | "an") filter_phrase "attacks" "one" "of" "your" "opponents"

/* @sem EventSpec::Damage(DamageEvent{source_kind:Permanent, sources:$event_object, recipients:Objects($filter_phrase), kind:Combat, grouping:SourceRecipient, subject:Source}) */
event_combat_damage_object ::= event_object "deals" "combat" "damage" "to" ("a" | "an") filter_phrase

/* @sem EventSpec::@either_event(EventSpec::Damage(DamageEvent{source_kind:Permanent, sources:$event_object, recipients:Objects($filter_phrase), kind:Any, grouping:SourceRecipient, subject:Source}), EventSpec::Damage(DamageEvent{source_kind:Permanent, sources:$event_object, recipients:Players(OpponentsOf(PlayerRef::AbilityController)), kind:Any, grouping:SourceRecipient, subject:Source})) */
event_damage_object_or_opponent ::= event_object "deals" "damage" "to" ("a" | "an") filter_phrase "or" "opponent"

/* @sem EventSpec::Player{event:Proliferates, players:One(PlayerRef::AbilityController)} */
event_proliferate ::= "you" "proliferate"

/* @sem EventSpec::FirstEachTurn(Player{event:Surveils, players:One(PlayerRef::AbilityController)}) */
event_surveil_first ::= "you" "surveil" "for" "the" "first" "time" "each" "turn"

/* @sem EventSpec::Activated{players:One(PlayerRef::AbilityController), abilities:$activated_loyalty_ability} */
event_loyalty ::= "you" "activate" activated_loyalty_ability

/* @sem EventSpec::Activated{players:One(PlayerRef::AbilityController), abilities:$activated_ordinary_ability} */
event_ability_of ::= "you" "activate" activated_ordinary_ability

/* @sem EventSpec::Batch{event:Attack{attackers:$filter_plural, defenders:Players(One(PlayerRef::AbilityController))}, per:Defender} */
event_creatures_attack_you ::= "one" "or" "more" filter_plural "attack" "you"

/* @sem EventSpec::Spell{event:Cast, players:One(PlayerRef::AbilityController), spells:Cast{from:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}}} */
event_cast_from_graveyard ::= "you" "cast" "a" "spell" "from" "your" "graveyard"

/* @sem EventSpec::Filtered{event:Object{event:LeavesGraveyard, objects:InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)})}, condition:PlayerIsActive(AbilityController)} */
event_leaves_graveyard_your_turn ::= "a" "card" "leaves" "your" "graveyard" "during" "your" "turn"

/* @sem EventSpec::Batch{event:Counters{change:Put, objects:$filter_phrase, by:One(PlayerRef::AbilityController)}, per:Subject} */
event_counter_put ::= "you" "put" "a" "counter" "on" ("a" | "an") filter_phrase

/* @sem EventSpec::ZoneChange{objects:$filter_plural, from:Battlefield, to:Graveyard} */
event_die_many_your ::= filter_plural "die"

/* @sem EventSpec::Object{event:AttacksAndIsNotBlocked, objects:$event_object} */
event_unblocked ::= event_object "attacks" "and" "isn't" "blocked"

/* @sem EventSpec::Object{event:BecomesUntapped, objects:$event_object} */
event_becomes_untapped ::= event_object "becomes" "untapped"

/* @sem EventSpec::BecomesTarget{objects:$event_object, kind:SpellOrAbility, by:Term{family:SpellsAndAbilities, form:AnySpellOrAbility}} */
event_target_spell_or_ability ::= event_object "becomes" "the" "target" "of" "a" "spell" "or" "ability"

/* @sem EventSpec::BecomesTarget{objects:$event_target_subject, kind:Spell, by:Filter($spell_filter)} */
event_target_spell ::= event_target_subject "becomes" "the" "target" "of" spell_filter

/* @sem EventSpec::Player{event:TapsForMana, players:$event_player, objects:$filter_phrase} */
event_taps_for_mana ::= event_player "taps" ("a" | "an") filter_phrase "for" "mana"

/* @sem EventSpec::Object{event:TurnsFaceUp, objects:$filter_phrase} */
event_turned_up ::= ("a" | "an") filter_phrase "is" "turned" "face" "up"

/* Naming this scheme establishes the holder as the following object pronoun.
   The player setting it in motion remains a separate event participant. */
/* @sem EventSpec::Player{event:SetsSchemeInMotion, players:One(PlayerRef::AbilityController), objects:SameObject(@remember_object(ObjectRef::Source))} */
event_scheme ::= "you" "set" "this" "scheme" "in" "motion"

/* @sem EventSpec::Object{event:Specializes, objects:$event_object} */
event_specializes ::= event_object "specializes"

/* @sem EventSpec::Batch{event:Attack{attackers:$filter_plural, defenders:Any}, per:Whole} */
event_creatures_attack ::= "one" "or" "more" filter_plural "attack"

/* @sem EventSpec::Batch{event:Object{event:LeavesGraveyard, objects:InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)})}, per:Whole} */
event_cards_leave ::= "one" "or" "more" "cards" "leave" "your" "graveyard"

/* One trigger per simultaneous matching group, even without a group operand
   in its body. Limited, event-free consumers may use the separate single form. */
/* @sem EventSpec::Batch{event:ZoneChange{objects:$event_many, from:Battlefield, to:Graveyard}, per:Whole} */
event_many_die ::= "one" "or" "more" event_many "die"

/* This fragment is reachable only through the guarded once-per-turn ability. */
event_many_die_limited ::= limited_many_die | limited_many_put_graveyard

/* @sem $event_many_die_limited */
limited_death_clause ::= ("when" | "whenever") event_many_die_limited

event_many ::= filter_plural | event_many_other

/* @sem @and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $filter_plural) */
event_many_other ::= "other" filter_plural

/* @sem EventSpec::Batch{event:Counters{change:Put, kind:PowerToughness(1, 1), objects:$event_object}, per:Subject} */
event_counters_put ::= "one" "or" "more" "+" "1" "/" "+" "1" "counters" "are" "put" "on" event_object

/* @sem EventSpec::NthEachTurn{event:Player{event:Draws, players:$event_player}, test:NumberTest::Compare{comparison:Equal, value:$ordinal}} */
event_draw_nth ::= event_player "draws" "their" ordinal "card" "each" "turn"

/* @sem EventSpec::Player{event:EntersUnderControl, players:All, objects:@and($filter_plain, ObjectFilter::ControlledBy(OpponentsOf(PlayerRef::AbilityController)))} */
event_enters_under_opponent ::= ("a" | "an") filter_plain "an" "opponent" "controls" "enters"

event_enters_under_opponent_original ::= event_enters_under_opponent_plain_original | event_qualified_controlled_entry | event_qualified_controlled_entry_filter

/* @sem EventSpec::Player{event:LosesLife, players:One(PlayerRef::AbilityController)} */
event_you_lose_life ::= "you" "lose" "life"

/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:$event_self, to:Battlefield}, EventSpec::Object{event:Attacks, objects:$event_self}) */
/* @prefer always */
event_enters_or_attacks ::= event_self "enters" "or" "attacks"

/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:$event_self, to:Battlefield}, EventSpec::Damage(DamageEvent{source_kind:Permanent, sources:$event_self, recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source})) */
event_enters_or_combat_damage ::= event_self "enters" "or" "deals" "combat" "damage" "to" "a" "player"

/* @sem EventSpec::Damage(DamageEvent{source_kind:Permanent, sources:$event_singular_subject, recipients:Any, kind:Combat, grouping:Source, subject:Source}) */
event_combat_damage ::= event_singular_subject "deals" "combat" "damage"

/* @sem EventSpec::ZoneChange{objects:@and($event_object, ObjectFilter::OwnedBy(One(PlayerRef::AbilityController))), from:Battlefield, to:Graveyard} */
event_put_your_graveyard ::= event_object "is" "put" "into" "your" "graveyard" "from" "the" "battlefield"

/* @sem EventSpec::ZoneChange{objects:$event_object, from:Battlefield, to:Graveyard} */
event_dies ::= event_object "dies"

/* @sem EventSpec::Object{event:LeavesBattlefield, objects:$event_object} */
event_leaves ::= event_object "leaves" "the" "battlefield"

/* @sem EventSpec::Object{event:Attacks, objects:$event_attack_subject} */
event_attacks ::= event_attack_subject "attacks"

/* @sem EventSpec::Object{event:Blocks, objects:$event_object} */
event_blocks ::= event_object "blocks"

/* @sem EventSpec::Object{event:BecomesBlocked, objects:$event_singular_subject} */
event_becomes_blocked ::= event_singular_subject "becomes" "blocked"

/* @sem EventSpec::@either_event(EventSpec::Object{event:Blocks, objects:$event_object}, EventSpec::Object{event:BecomesBlocked, objects:$event_object}) */
event_blocks_or_blocked_once ::= event_object "blocks" "or" "becomes" "blocked"

/* @sem EventSpec::Damage(DamageEvent{source_kind:Permanent, sources:$event_singular_subject, recipients:Players($combat_damage_player_set), kind:Combat, grouping:SourceRecipient, subject:Source}) */
event_combat_damage_player ::= event_singular_subject "deals" "combat" "damage" "to" combat_damage_player_set

/* @sem EventSpec::Damage(DamageEvent{source_kind:Permanent, sources:$event_object, recipients:Players(All), kind:Any, grouping:SourceRecipient, subject:Source}) */
event_damage_player ::= event_object "deals" "damage" "to" "a" "player"

/* @sem EventSpec::Damage(DamageEvent{source_kind:Permanent, sources:$event_object, recipients:Objects($filter_phrase), kind:Any, grouping:SourceRecipient, subject:Source}) */
event_damage_object ::= event_object "deals" "damage" "to" ("a" | "an") filter_phrase

/* @sem EventSpec::Damage(DamageEvent{source_kind:Permanent, sources:$event_singular_subject, recipients:Any, kind:Any, grouping:Source, subject:Source}) */
event_damage ::= event_singular_subject "deals" "damage"

/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:SameObject(ObjectRef::Source), to:Battlefield}, EventSpec::ZoneChange{objects:$event_another, to:Battlefield}) */
event_self_or_enters ::= self_text "or" event_another "enters"

/* Both disjoint arms retain the explicitly named source, including a creator
   inside a granted ability. The uncapped and event-reading form stays separate. */
/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:$event_self, from:Battlefield, to:Graveyard}, EventSpec::ZoneChange{objects:@and(ObjectFilter::Not($event_self), $filter_phrase), from:Battlefield, to:Graveyard}) */
event_self_or_dies ::= event_self "or" "another" filter_phrase "dies"

/* Another excludes the explicitly named object, including in a granted
   ability where the creating card and the ability holder are distinct. */
/* @sem EventSpec::@either_event(EventSpec::Object{event:LeavesBattlefield, objects:$event_self}, EventSpec::Object{event:LeavesBattlefield, objects:@and(ObjectFilter::Not($event_self), $filter_phrase)}) */
event_self_or_leaves ::= event_self "or" "another" filter_phrase "leaves" "the" "battlefield"

/* Both arms bind the same printed clause independently. Only ordinary
   unlimited triggers are admitted; a leading intervening-if or shared limit
   must not become two independent resolution conditions or limits. */
/* @sem Ability::[@scope(Ability::Triggered{event:Object{event:Attacks, objects:$event_self}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$self_attached_attack_body}}), @scope(Ability::Triggered{event:Object{event:Attacks, objects:$event_attached}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$self_attached_attack_body}})] */
line_self_or_attached_attacks ::= ("when" | "whenever") event_self "or" event_attached "attacks" "," self_attached_attack_body "."

self_attached_attack_body ::= clause_operation | clause_imperative | clause_you | clause_third

/* @sem EventSpec::@either_event(EventSpec::Object{event:Attacks, objects:SameObject(ObjectRef::Source)}, EventSpec::Object{event:Attacks, objects:$event_another}) */
event_self_or_attacks ::= self_text "or" event_another "attacks"

/* @sem EventSpec::@either_event(EventSpec::Pair{event:Blocks, objects:$event_object, others:$filter_phrase}, EventSpec::Pair{event:BecomesBlockedBy, objects:$event_object, others:$filter_phrase}) */
event_blocks_or_blocked ::= event_object "blocks" "or" "becomes" "blocked" "by" ("a" | "an") filter_phrase

/* @sem EventSpec::Pair{event:BecomesBlockedBy, objects:$event_object, others:$combat_blocker_filter} */
event_blocked_by ::= event_object "becomes" "blocked" "by" ("a" | "an") combat_blocker_filter

/* @sem EventSpec::Pair{event:Blocks, objects:$event_object, others:$combat_attacker_filter} */
event_blocks_object ::= event_object "blocks" ("a" | "an") combat_attacker_filter

/* @sem EventSpec::Damage(DamageEvent{source_kind:Any, sources:Any, recipients:Objects($event_object), kind:Any, grouping:Recipient, subject:Recipient}) */
event_dealt_damage ::= event_object "is" "dealt" "damage"

/* @sem EventSpec::Damage(DamageEvent{source_kind:Any, sources:Any, recipients:Objects($event_object), kind:Combat, grouping:Recipient, subject:Recipient}) */
event_dealt_combat_damage ::= event_object "is" "dealt" "combat" "damage"

event_put_graveyard ::= event_put_unqualified_graveyard | event_put_player_graveyard

/* @sem EventSpec::@departure_controller(EventSpec::ZoneChange{objects:@and($event_object, ObjectFilter::OwnedBy(All)), from:Battlefield, to:Graveyard}, $event_object) */
event_put_unqualified_graveyard ::= event_object "is" "put" "into" "a" "graveyard" ("from" "the" "battlefield")?

/* @sem EventSpec::ZoneChange{objects:@and($event_object, ObjectFilter::OwnedBy(All)), from:Battlefield, to:Graveyard} */
event_put_player_graveyard ::= event_object "is" "put" "into" "a" "player's" "graveyard" "from" "the" "battlefield"

/* @sem EventSpec::ZoneChange{objects:@and($event_object, ObjectFilter::OwnedBy(OpponentsOf(PlayerRef::AbilityController))), from:Battlefield, to:Graveyard} */
event_put_opponent_graveyard ::= event_object "is" "put" "into" "an" "opponent's" "graveyard" "from" "the" "battlefield"

/* @sem EventSpec::Object{event:BecomesTapped, objects:$event_object} */
event_becomes_tapped ::= event_object "becomes" "tapped"

/* @sem EventSpec::Damage(DamageEvent{source_kind:Permanent, sources:$event_singular_subject, recipients:Players(OpponentsOf(PlayerRef::AbilityController)), kind:Combat, grouping:SourceRecipient, subject:Source}) */
event_combat_damage_opponent ::= event_singular_subject "deals" "combat" "damage" "to" "an" "opponent"

/* @sem EventSpec::Damage(DamageEvent{source_kind:Permanent, sources:$event_object, recipients:Players(OpponentsOf(PlayerRef::AbilityController)), kind:Any, grouping:SourceRecipient, subject:Source}) */
event_damage_opponent ::= event_object "deals" "damage" "to" "an" "opponent"

/* @sem EventSpec::Damage(DamageEvent{source_kind:Permanent, sources:$event_object, recipients:Players(One(PlayerRef::AbilityController)), kind:Any, grouping:SourceRecipient, subject:Source}) */
event_damage_you ::= event_object "deals" "damage" "to" "you"

/* A damage source of any kind: a spell, a permanent or a card. */
/* @sem EventSpec::Damage(DamageEvent{source_kind:Any, sources:$damage_source, recipients:$source_damage_recipient, kind:Any, grouping:SourceRecipient, subject:Source}) */
event_source_damage ::= damage_source "deals" "damage" "to" source_damage_recipient
/* @sem EventSpec::Damage(DamageEvent{source_kind:Any, sources:$damage_source, recipients:$source_damage_recipient, kind:Noncombat, grouping:SourceRecipient, subject:Source}) */
event_source_noncombat_damage ::= damage_source "deals" "noncombat" "damage" "to" source_damage_recipient
/* "To you or a permanent you control": each recipient is its own damage event. */
/* @sem EventSpec::@either_event(EventSpec::Damage(DamageEvent{source_kind:Any, sources:$damage_source, recipients:Players(One(PlayerRef::AbilityController)), kind:Any, grouping:SourceRecipient, subject:Source}), EventSpec::Damage(DamageEvent{source_kind:Any, sources:$damage_source, recipients:Objects($filter_phrase), kind:Any, grouping:SourceRecipient, subject:Source})) */
event_source_damage_you_or ::= damage_source "deals" "damage" "to" "you" "or" ("a" | "an") filter_phrase
source_damage_recipient ::= damage_to | source_damage_other_player | source_damage_self | source_damage_one_or_more_opponents
/* @sem DamageRecipients::Objects($event_self) */
source_damage_self ::= event_self
/* @sem DamageRecipients::Players(OthersThan(PlayerRef::AbilityController)) */
source_damage_other_player ::= "another" "player"

/* @sem EventSpec::Player{event:Draws, players:One(PlayerRef::AbilityController)} */
event_draw ::= "you" "draw" "a" "card"

/* @sem EventSpec::Player{event:Draws, players:$event_player} */
event_draw_third ::= event_player "draws" "a" "card"

/* @sem EventSpec::Discard{players:One(PlayerRef::AbilityController), cards:Any, kind:Any, grouping:Card} */
event_discard ::= "you" "discard" "a" "card"

/* @sem EventSpec::Discard{players:$event_player, cards:Any, kind:Any, grouping:Card} */
event_discard_third ::= event_player "discards" "a" "card"

/* @sem EventSpec::Discard{players:One(PlayerRef::AbilityController), cards:Any, kind:CausedBy(ControlledBy(OpponentsOf(AbilityController))), grouping:Card} */
event_opponent_discard ::= opponent_spell_or_ability "causes" "you" "to" "discard" "a" "card"


/* @sem EventSpec::Player{event:Sacrifices, players:$event_player, objects:$filter_phrase} */
event_sacrifice_third ::= event_player "sacrifices" ("a" | "an") filter_phrase

/* @prefer always */
/* @sem EventSpec::NthEachTurn{event:Spell{event:Cast, players:One(PlayerRef::AbilityController), spells:Any}, test:NumberTest::Compare{comparison:Equal, value:$cast_spell_ordinal}} */
event_cast_nth ::= "you" "cast" "your" cast_spell_ordinal "spell" "each" "turn"

/* @sem EventSpec::NthEachTurn{event:Spell{event:Cast, players:$event_player, spells:Any}, test:NumberTest::Compare{comparison:Equal, value:$ordinal}} */
event_cast_nth_third ::= event_player "casts" "their" ordinal "spell" "each" "turn"

ordinal ::= ordinal_second | ordinal_third | ordinal_fourth | ordinal_sixth | ordinal_twelfth

/* @sem Expr::Constant(2) */
ordinal_second ::= "second"
/* @sem Expr::Constant(3) */
ordinal_third ::= "third"

/* @sem EventSpec::Batch{event:Attack{attackers:$event_many, by:One(PlayerRef::AbilityController), defenders:Any}, per:Whole} */
event_attack_with ::= "you" "attack" "with" "one" "or" "more" event_many

/* @sem EventSpec::Batch{event:Attack{attackers:$filter_plural, by:One(PlayerRef::AbilityController), defenders:Any}, per:Whole, count:[GreaterOrEqual, $count]} */
event_attack_with_count ::= "you" "attack" "with" count "or" "more" filter_plural

/* @sem EventSpec::Batch{event:Attack{attackers:$filter_plural, by:$event_player, defenders:Any}, per:Whole, count:[GreaterOrEqual, $count]} */
event_attacks_with_count ::= event_player "attacks" "with" count "or" "more" filter_plural

/* @sem EventSpec::Batch{event:Attack{attackers:$filter_plural, defenders:Any}, per:Whole, count:[GreaterOrEqual, $count], including:Source} */
event_self_and_others_attack ::= self_text "and" "at" "least" count "other" filter_plural "attack"

/* @sem EventSpec::Discard{players:One(PlayerRef::AbilityController), cards:Any, kind:Any, grouping:Player} */
event_discard_many ::= "you" "discard" "one" "or" "more" "cards"

/* @sem EventSpec::Player{event:Sacrifices, players:One(PlayerRef::AbilityController), objects:$event_many} */
event_sacrifice_many ::= "you" "sacrifice" "one" "or" "more" event_many

/* @sem EventSpec::Batch{event:ZoneChange{objects:$filter_plural, to:Battlefield}, per:Whole} */
event_many_enter ::= "one" "or" "more" filter_plural "enter"

/* @sem EventSpec::@either_event(EventSpec::Spell{event:Cast, players:One(PlayerRef::AbilityController), spells:$spell_filter}, EventSpec::Spell{event:Copy, players:One(PlayerRef::AbilityController), spells:$spell_filter}) */
event_cast_or_copy ::= "you" "cast" "or" "copy" spell_filter

spell_filter ::= spell_unshared_library_creature_type | spell_targets_recipient_or_permanent | spell_targets_controlled | spell_linked_name | spell_shared_color_or_mana_value | spell_any | spell_your_commander | spell_filtered | spell_modified | spell_targets | spell_targets_only_self | spell_targets_only_single | spell_any_targets_only_self | spell_any_targets_only_single | spell_described | spell_postqualified | spell_color_disjunction | spell_targets_permanent | spell_targeting_a_permanent | spell_targeting_an_permanent

/* "Your commander" is the commander you own (CR 903.3), whoever casts it. */
/* @sem @and(ObjectFilter::State(Commander), ObjectFilter::OwnedBy(One(PlayerRef::AbilityController))) */
spell_your_commander ::= "your" "commander"

/* The explicit you-cast subject proves that your hand is this spell caster's
   hand. Keep this origin contract out of third-party spell filters. */
/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:@and($spell_filter, ObjectFilter::Cast{from:Players{zone:Hand, players:One(CasterOf(Candidate))}})} */
event_cast_from_hand ::= "you" "cast" spell_filter "from" "your" "hand"

/* "From anywhere other than your hand" says "your" only after "you cast"; another
   caster's hand is "their hand". */
/* @sem EventSpec::Spell{event:Cast, players:One(PlayerRef::AbilityController), spells:Not(Cast{from:Players{zone:Hand, players:One(CasterOf(Candidate))}})} */
event_cast_not_from_hand ::= "you" "cast" "a" "spell" "from" "anywhere" "other" "than" "your" "hand"
/* @sem EventSpec::Spell{event:Cast, players:$event_player, spells:Not(Cast{from:Players{zone:Hand, players:One(CasterOf(Candidate))}})} */
event_cast_third_not_from_hand ::= event_player "casts" "a" "spell" "from" "anywhere" "other" "than" "their" "hand"

/* @sem @and($spell_adjectives, $modifiers) */
spell_described ::= ("a" | "an") spell_adjectives "spell" modifiers

/* @sem ObjectFilter::Any */
spell_any ::= ("a" | "an") "spell"

/* @sem $spell_adjectives */
spell_filtered ::= ("a" | "an") spell_adjectives "spell"

/* @sem $modifiers */
spell_modified ::= ("a" | "an") "spell" modifiers

/* @sem ObjectFilter::TargetsAny(Objects(One($self_ref))) */
spell_targets ::= ("a" | "an") "spell" "that" "targets" self_ref

/* "That targets only" one object: the spell has a single target, and it is that
   object, or one permanent of that description. */
/* @sem @and($spell_adjectives, @and(ObjectFilter::OnStack(SingleTarget), ObjectFilter::TargetsAny(Objects(One($self_ref))))) */
spell_targets_only_self ::= ("a" | "an") spell_adjectives "spell" "that" "targets" "only" self_ref
/* @sem @and($spell_adjectives, @and(ObjectFilter::OnStack(SingleTarget), ObjectFilter::TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase})))) */
spell_targets_only_single ::= ("a" | "an") spell_adjectives "spell" "that" "targets" "only" "a" "single" filter_phrase
/* @sem @and(ObjectFilter::OnStack(SingleTarget), ObjectFilter::TargetsAny(Objects(One($self_ref)))) */
spell_any_targets_only_self ::= "a" "spell" "that" "targets" "only" self_ref
/* @sem @and(ObjectFilter::OnStack(SingleTarget), ObjectFilter::TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}))) */
spell_any_targets_only_single ::= "a" "spell" "that" "targets" "only" "a" "single" filter_phrase

spell_adjectives ::= spell_branch_either | spell_adjective | spell_adjective_either | spell_adjective_list | spell_qualified | spell_subtype_qualified | spell_subtype_nonpermanent

/* Stack objects retain card-type qualifications: a permanent spell is not an
   arbitrary spell. The same domain applies in every adjective position. */
/* @sem @and($spell_prefix, $spell_adjectives) */
spell_qualified ::= spell_prefix spell_adjectives

spell_prefix ::= spell_colored | quality | spell_non_subtype_noun | adjective_either | adjective_and_or | spell_subtype_either

/* A subtype qualifies its own atomic spell branch before a written disjunction. */
/* @sem @and($subtype, $spell_domain_atomic) */
spell_subtype_qualified ::= subtype spell_domain_atomic

spell_domain_atomic ::= spell_domain_adjective | spell_domain_atomic_qualified | spell_subtype_qualified
/* @sem @and($spell_prefix, $spell_domain_atomic) */
spell_domain_atomic_qualified ::= spell_prefix spell_domain_atomic

spell_atomic ::= spell_adjective | spell_atomic_qualified | spell_subtype_qualified | spell_subtype_nonpermanent
/* @sem @and($spell_prefix, $spell_atomic) */
spell_atomic_qualified ::= spell_prefix spell_atomic

/* Either written order prints from the canonical union. */
/* @sem ObjectFilter::AnyOf(@unordered([$spell_adjective, $spell_adjective_2])) */
spell_adjective_either ::= spell_adjective "or" spell_adjective

spell_branch_either ::= spell_branch_either_written | spell_branch_either_reversed

/* Equivalent operand orders let canonical native unions retain either lexical branch order. */
/* @sem ObjectFilter::AnyOf([$spell_subtype_qualified, $spell_atomic]) */
spell_branch_either_written ::= spell_subtype_qualified "or" spell_atomic
/* @sem ObjectFilter::AnyOf([$spell_atomic, $spell_subtype_qualified]) */
spell_branch_either_reversed ::= spell_subtype_qualified "or" spell_atomic

/* @sem ObjectFilter::AnyOf([...$spell_adjective_commas, $spell_adjective]) */
spell_adjective_list ::= spell_adjective_commas "or" spell_adjective

spell_adjective_commas ::= spell_adjective_commas_more | spell_adjective_commas_last
/* @sem ObjectFilter::[$spell_adjective, ...$spell_adjective_commas] */
spell_adjective_commas_more ::= spell_adjective "," spell_adjective_commas
/* @sem ObjectFilter::[$spell_adjective] */
spell_adjective_commas_last ::= spell_adjective ","

spell_adjective ::= spell_modal_adjective | spell_domain_adjective | spell_instant | spell_sorcery
spell_domain_adjective ::= quality | spell_noun
spell_noun ::= spell_non_subtype_noun | subtype_spelled
spell_non_subtype_noun ::= noun_outlaw | noun_creature | noun_artifact | noun_enchantment | noun_land | noun_planeswalker | card_permanent
    | noun_token | noun_battle | noun_commander | noun_wall_folded


/* @sem ObjectFilter::CardType(Instant) */
spell_instant ::= "instant"
/* @sem ObjectFilter::CardType(Sorcery) */
spell_sorcery ::= "sorcery"

/* @sem EventSpec::Spell{event:Cast, players:One(PlayerRef::AbilityController), spells:$cast_spell_filter} */
event_cast ::= "you" "cast" cast_spell_filter
/* A cast during an opponent's turn. */
/* @sem EventSpec::Filtered{event:Spell{event:Cast, players:One(PlayerRef::AbilityController), spells:$spell_filter}, condition:ExistsPlayer{players:OpponentsOf(PlayerRef::AbilityController), binding:0, condition:PlayerIsActive(Bound(0))}} */
event_cast_opponents_turn ::= "you" "cast" spell_filter "during" "an" "opponent's" "turn"

/* @sem EventSpec::Spell{event:Cast, players:$event_player, spells:$third_cast_spell_filter} */
event_cast_third ::= event_player "casts" third_cast_spell_filter

event_player ::= event_an_opponent | event_a_player | event_another_player | event_enchanted_player | event_enchanted_opponent

/* @sem PlayerSet::OpponentsOf(PlayerRef::AbilityController) */
event_an_opponent ::= "an" "opponent"

/* @sem PlayerSet::All */
event_a_player ::= "a" "player"

/* @sem PlayerSet::OthersThan(PlayerRef::AbilityController) */
event_another_player ::= "another" "player"

/* A Curse's player: the player this Aura enchants. */
/* @sem PlayerSet::One(PlayerRef::EnchantedBy(ObjectRef::Source)) */
event_enchanted_player ::= "enchanted" "player"

/* The named permanent constrains the event's player. The active player is
   that event subject, independently of the ability holder and the name. */
/* @sem EventSpec::Filtered{event:Player{event:$named_controller_action, players:Intersection([$event_player, Matching{binding:0, condition:Controls{player:Bound(0), filter:@and($filter_phrase, ObjectFilter::Name(@card_name)), minimum:1}}])}, condition:PlayerIsActive(EventSubject)} */
event_named_controller_own_turn ::= event_player "who" "controls" ("a" | "an") filter_phrase "named" SELF_NAME named_controller_action "during" "their" "turn"

named_controller_action ::= named_controller_draw | named_controller_gain_life
/* @sem PlayerEvent::Draws */
named_controller_draw ::= "draws" "a" "card"
/* @sem PlayerEvent::GainsLife */
named_controller_gain_life ::= "gains" "life"

/* @sem EventSpec::Player{event:GainsLife, players:One(PlayerRef::AbilityController)} */
event_gain_life ::= "you" "gain" "life"

/* @sem EventSpec::Player{event:GainsLife, players:$event_player} */
event_gain_life_third ::= event_player "gains" "life"

/* @sem EventSpec::Player{event:LosesLife, players:$event_player} */
event_lose_life ::= event_player "loses" "life"

/* Points in a turn. */
turn_event ::= turn_first_upkeep_each_turn | turn_first_combat_end_your_turn | turn_monarch_end | turn_end_combat_your_turn | turn_first_main | turn_end_any | turn_end_combat | turn_controller_upkeep | turn_controller_draw | turn_controller_end | turn_upkeep | turn_draw | turn_end | turn_combat | turn_combat_each | turn_second_main | turn_each_main | turn_each_postcombat_main | turn_first_game_upkeep | turn_each_end_step | turn_each_first_main | turn_chosen_upkeep | turn_each_end | turn_enchanted_postcombat | turn_enchanted_main | turn_combat_opponent

/* These headers name two independent trigger events. The shared inverse tries
   both event bindings, while the alternative index preserves the written order. */
/* @sem EventSpec::@either_event($event_clause, $turn_event) */
event_clause_and_turn_event ::= event_clause "and" "at" turn_event | "at" turn_event "and" event_clause

/* @sem EventSpec::Turn{point:CombatBegins, players:All} */
turn_combat_each ::= "the" "beginning" "of" "each" "combat"

/* @sem EventSpec::Turn{point:SecondMainPhaseBegins, players:$turn_owner} */
turn_second_main ::= "the" "beginning" "of" turn_owner "second" "main" "phase"

/* Each main phase of your turn, or only those after combat. */
/* @sem EventSpec::Turn{point:MainPhaseBegins, players:One(PlayerRef::AbilityController)} */
turn_each_main ::= "the" "beginning" "of" "each" "of" "your" "main" "phases"
/* @sem EventSpec::Turn{point:PostcombatMainPhaseBegins, players:One(PlayerRef::AbilityController)} */
turn_each_postcombat_main ::= "the" "beginning" "of" "each" "of" "your" "postcombat" "main" "phases"

/* @sem EventSpec::Turn{point:UpkeepBegins, players:$turn_owner} */
turn_upkeep ::= "the" "beginning" "of" turn_owner "upkeep"

/* @sem EventSpec::Turn{point:DrawStepBegins, players:$turn_owner} */
turn_draw ::= "the" "beginning" "of" turn_owner "draw" "step"

/* A recurring end-step trigger has no restricted turn owner. */
/* @sem EventSpec::Turn{point:EndStepBegins, players:All} */
turn_end_any ::= "the" "beginning" "of" "the" "end" "step"

/* @sem EventSpec::Turn{point:EndStepBegins, players:$turn_owner} */
turn_end ::= "the" "beginning" "of" turn_owner "end" "step"

/* @sem EventSpec::Turn{point:CombatBegins, players:One(PlayerRef::AbilityController)} */
turn_combat ::= "the" "beginning" "of" "combat" "on" "your" "turn"

turn_owner ::= owner_your_opponents | owner_you | players_possessive | owner_enchanted

/* A Curse's trigger names its enchanted player's turn. */
/* @sem PlayerSet::One(PlayerRef::EnchantedBy(Source)) */
owner_enchanted ::= "enchanted" "player's"

/* "Each opponent's", "each other player's", "each player's": the players whose
   turns, libraries or graveyards are named one by one. */
players_possessive ::= owner_opponent | owner_all | owner_others

/* @sem PlayerSet::OthersThan(PlayerRef::AbilityController) */
owner_others ::= "each" "other" "player's"

/* @sem PlayerSet::One(PlayerRef::AbilityController) */
owner_you ::= "your"
/* @sem PlayerSet::OpponentsOf(PlayerRef::AbilityController) */
owner_opponent ::= "each" "opponent's"
/* @sem PlayerSet::All */
owner_all ::= "each" ("player's")?

/* List order follows the canonical IR; the words still name entering first. */
/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:$event_object, from:Battlefield, to:Graveyard}, EventSpec::ZoneChange{objects:$event_object, to:Battlefield}) */
event_enters_or_dies ::= event_object "enters" "or" "dies"


/* A card's owner supplies "your graveyard"; a controller filter cannot replace
   that restriction when the event can originate outside the battlefield. */
/* @sem EventSpec::ZoneChangeFromElsewhere{objects:@and($card_filter, ObjectFilter::OwnedBy(One(PlayerRef::AbilityController))), except:[Battlefield], to:Graveyard} */
event_card_from_elsewhere ::= ("a" | "an") card_filter "card" "is" "put" "into" "your" "graveyard" "from" "anywhere" "other" "than" "the" "battlefield"

/* @sem EventSpec::Object{event:TurnsFaceUp, objects:$event_singular_subject} */
event_turns_face_up ::= event_singular_subject "is" "turned" "face" "up"

/* A state trigger: it fires when the count first reaches the threshold. */
/* @sem EventSpec::State{condition:ObjectMatches{object:$object_ref, filter:Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$value})}} */
event_counter_threshold ::= "there" "are" value "or" "more" counter_kind "counters" "on" object_ref

/* Native normalization combines equivalent trigger bodies into one Either event. */
/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:$event_self, to:Battlefield}, EventSpec::Object{event:TurnsFaceUp, objects:$event_self}) */
event_enters_or_face_up ::= event_self "enters" "or" "is" "turned" "face" "up"

/* The shared pronoun names the explicitly stated entering source, not an
   arbitrary event subject. Separate triggers retain independent bindings. */
/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:$event_self, to:Battlefield}, EventSpec::Player{event:Sacrifices, players:One(PlayerRef::AbilityController), objects:$event_self}) */
event_enters_and_sacrificed ::= event_self "enters" "and" ("when" | "whenever") "you" "sacrifice" "it"
/* @sem EventSpec::Player{event:Sacrifices, players:One(PlayerRef::AbilityController), objects:$event_self} */
event_self_sacrificed ::= "you" "sacrifice" event_self

/* This target is announced by the effect creating a trigger. An ordinary
   triggered ability cannot announce a target before its own event occurs. */
/* @sem ObjectFilter::SameObject($target_object) */
event_target ::= target_object

/* Both alternatives require an origin on the battlefield. */
/* Both branches describe the same permanent leaving the battlefield. The
   destination phrase carries the second arrival zone, including its wording. */
/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:$event_object, from:Battlefield, to:Graveyard}, EventSpec::ZoneChange{objects:$event_object, from:Battlefield, to:$death_alternative_destination}) */
event_dies_or_exiled_battlefield ::= event_object "dies" "or" "is" "put" "into" death_alternative_destination

/* Bind each destination incarnation independently before native normalization.
   Permanent-object wording may omit the explicit battlefield origin. Keeping
   this shorthand on the split-body form preserves each destination's identity. */
line_dies_or_exiled_battlefield ::= line_departure_separate | line_departure_joined

/* @sem Ability::[Triggered{event:ZoneChange{objects:$death_exile_object, from:Battlefield, to:Graveyard}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}, Triggered{event:ZoneChange{objects:$death_exile_object, from:Battlefield, to:Exile}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}] */
line_departure_separate ::= ("when" | "whenever") death_exile_object "," program_sentence

/* Equal event-independent bodies have one canonical Either event. The spelling
   companion never substitutes a destination-dependent return body. */
/* @sem Ability::[Triggered{event:@either_event(EventSpec::ZoneChange{objects:$death_exile_object, from:Battlefield, to:Graveyard}, EventSpec::ZoneChange{objects:$death_exile_object, from:Battlefield, to:Exile}), limits:TriggerLimits{}, announcement:@announcement, body:$departure_independent_sentence}] */
line_departure_joined ::= ("when" | "whenever") death_exile_object "," departure_independent_sentence

/* @sem $event_object */
death_exile_object ::= event_object "dies" "or" "is" "put" "into" "exile" ("from" "the" "battlefield")?

/* An additional functioning zone belongs to this source's one trigger. Bind the
   shared program independently in each ability; adjacent abilities stay outside. */
/* @sem Ability::[Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}, Scoped{zones:[Exile], ability:@scope(Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})}] */
line_additional_exile_trigger ::= event_clause "," program_sentence "this" "ability" "also" "triggers" "if" "this" "card" "is" "in" "exile" "."

/* One ordinary trigger body composes with either event-header order above. */
/* @sem Ability::Triggered{event:$event_clause_and_turn_event, limits:_{}, announcement:@announcement, body:$program} */
triggered_event_clause_and_turn_event ::= event_clause_and_turn_event "," program "."

/* A controller-named turn header names an object as well as a player. Binding
   captures that object/player for demonstratives in the body; an explicit
   enchanted/equipped description in the body remains a live attachment read. */
/* @sem EventSpec::Turn{point:UpkeepBegins, players:One(ControllerOf($turn_controller_object))} */
turn_controller_upkeep ::= "the" "beginning" "of" "the" "upkeep" "of" turn_controller_object "controller"
/* @sem EventSpec::Turn{point:DrawStepBegins, players:One(ControllerOf($turn_controller_object))} */
turn_controller_draw ::= "the" "beginning" "of" "the" "draw" "step" "of" turn_controller_object "controller"
/* @sem EventSpec::Turn{point:EndStepBegins, players:One(ControllerOf($turn_controller_object))} */
turn_controller_end ::= "the" "beginning" "of" "the" "end" "step" "of" turn_controller_object "controller"

turn_controller_object ::= turn_controller_enchanted | turn_controller_equipped | turn_controller_self
/* @sem ObjectRef::@enchanted_operand(ObjectRef::AttachedTo(Source)) */
turn_controller_enchanted ::= "enchanted" turn_controller_possessive_noun
/* @sem ObjectRef::@remember_operand(ObjectRef::AttachedTo(Source)) */
turn_controller_equipped ::= ("equipped" | "fortified") turn_controller_possessive_noun
/* @sem ObjectRef::Source */
turn_controller_self ::= "this" turn_controller_possessive_noun
/* @sem () */
turn_controller_possessive_noun ::= "creature's" | "permanent's" | "artifact's" | "enchantment's" | "land's" | "planeswalker's" | "battle's"


/* Trigger suppression concerns the event that causes a trigger, rather than
   only abilities of the entering/dying objects. A shared filter is applied
   independently to both zone changes. */
line_trigger_suppression ::= line_suppress_entering_abilities_of | line_suppress_entering | line_suppress_dying | line_suppress_entering_dying
/* @sem Ability::[TriggerRule{cause:ZoneChange{objects:$filter_plural, to:Battlefield}, rule:DoesntTrigger}] */
line_suppress_entering ::= filter_plural "entering" "don't" "cause" "abilities" "to" "trigger" "."
/* @sem Ability::[TriggerRule{cause:ZoneChange{objects:$filter_plural, from:Battlefield, to:Graveyard}, rule:DoesntTrigger}] */
line_suppress_dying ::= filter_plural "dying" "don't" "cause" "abilities" "to" "trigger" "."
/* @sem Ability::[TriggerRule{cause:ZoneChange{objects:$filter_plural, to:Battlefield}, rule:DoesntTrigger}, TriggerRule{cause:ZoneChange{objects:$filter_plural, from:Battlefield, to:Graveyard}, rule:DoesntTrigger}] */
line_suppress_entering_dying ::= filter_plural "entering" "or" "dying" "don't" "cause" "abilities" "to" "trigger" "."

/* Player and object target occurrences are disjoint. Bind the shared closed
   body separately for each event; neither arm introduces an ability limit. */
/* @sem Ability::[Triggered{event:@either_event(EventSpec::Player{event:BecomesTarget, players:One(AbilityController), objects:ControlledBy(OpponentsOf(AbilityController))}, EventSpec::BecomesTarget{objects:$event_object, kind:SpellOrAbility, by:Term{family:SpellsAndAbilities, form:ControlledByAPlayer, operands:[Players(OpponentsOf(AbilityController))]}}), limits:TriggerLimits{}, announcement:@announcement, body:$target_union_program_sentence}] */
line_target_player_or_object ::= ("when" | "whenever") "you" "or" event_object "becomes" "the" "target" "of" "a" "spell" "or" "ability" "an" "opponent" "controls" "," target_union_program_sentence

/* Closed single sentences deliberately exclude trailing additional-draw or
   per-turn-limit paragraphs, whose shared scopes require separate contracts. */
target_union_program_sentence ::= target_union_single_sentence | target_union_optional_draw_followup

target_union_body ::= clause_operation | clause_imperative | clause_you | clause_you_life | target_union_optional | target_union_counter
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:$target_union_optional_body}}] */
target_union_optional ::= "you" "may" target_union_optional_body

target_union_optional_body ::= clause_operation | clause_imperative

/* @prefer always */
/* The payer is the controller captured with the targeting stack item, not the
   targeted player, targeted permanent's controller, or ability source owner. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf(EventStackObject), cost:$target_union_payment, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(EventStackObject), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}] */
target_union_counter ::= "counter" "that" "spell" "or" "ability" "unless" target_union_payer "pays" target_union_payment
/* @sem () */
target_union_payer ::= "its" "controller" | "that" "player"


target_union_payment ::= counter_unless_cost | target_union_life_cost
/* @sem Cost::Cost{parts:[Life($number)]} */
target_union_life_cost ::= number "life"

/* Bind tap and activation bodies separately: the activation's actor is a player,
   while its object subject is the permanent providing that ability. */
/* @sem Ability::[Triggered{event:Object{event:BecomesTapped, objects:$event_object}, limits:TriggerLimits{}, announcement:@announcement, body:$tap_activation_program_sentence}, Triggered{event:$event_tapless_activation, limits:TriggerLimits{}, announcement:@announcement, body:$tap_activation_program_sentence}] */
line_tapped_or_activation ::= ("when" | "whenever") event_object "becomes" "tapped" "or" event_tapless_activation "," tap_activation_program_sentence

/* Closed ordinary sentences do not split shared per-turn/total limits. */
/* @sem Program::Program{instructions:$tap_activation_body} */
tap_activation_program_sentence ::= tap_activation_body "."
tap_activation_body ::= clause_operation | clause_imperative | clause_you | clause_you_life

/* No mana/non-mana exclusion: only the printed tap-symbol-in-cost predicate. */
/* @sem EventSpec::Activated{players:$event_player, abilities:AllOf([AbilityOf($tapless_ability_source), Not(OnStack(TapSymbolInCost))])} */
event_tapless_activation ::= event_player "activates" tapless_ability_source "without" "{" "T" "}" "in" "its" "activation" "cost"

tapless_ability_source ::= tapless_ability_of | tapless_ability_possessive
/* @sem $event_object */
tapless_ability_of ::= "an" "ability" "of" event_object
/* @sem $tapless_possessive_kind */
tapless_ability_possessive ::= ("a" | "an") tapless_possessive_kind "ability"

tapless_possessive_kind ::= tapless_artifact_possessive | tapless_creature_possessive | tapless_land_possessive | tapless_permanent_possessive
/* @sem ObjectFilter::CardType(Artifact) */
tapless_artifact_possessive ::= "artifact's"
/* @sem ObjectFilter::CardType(Creature) */
tapless_creature_possessive ::= "creature's"
/* @sem ObjectFilter::CardType(Land) */
tapless_land_possessive ::= "land's"
/* @sem ObjectFilter::Any */
tapless_permanent_possessive ::= "permanent's"

/* Passive damage says nothing about an individual source. One occurrence per
   recipient damage event is distinct from source/recipient combat triggers. */
/* @sem EventSpec::Damage(DamageEvent{source_kind:Any, sources:Any, recipients:Players($passive_combat_player), kind:Combat, grouping:Recipient, subject:Recipient}) */
event_passive_combat_recipient ::= "combat" "damage" "is" "dealt" "to" passive_combat_player

passive_combat_player ::= passive_combat_you | passive_combat_any | passive_combat_opponent
/* @sem PlayerSet::One(PlayerRef::AbilityController) */
passive_combat_you ::= "you"
/* @sem PlayerSet::All */
passive_combat_any ::= "a" "player"
/* @sem PlayerSet::OpponentsOf(PlayerRef::AbilityController) */
passive_combat_opponent ::= "an" "opponent"

/* The player rule changes the draw procedure; only its actual first-card
   revelation supplies the following trigger. This is not a Draw trigger. */
/* @sem Ability::[$first_draw_reveal_rule, Triggered{event:Player{event:RevealsFirstCardDrawn, players:One(AbilityController), objects:$card_filter}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}] */
line_first_draw_reveal ::= first_draw_reveal_rule "whenever" "you" "reveal" ("a" | "an") card_filter "card" "this" "way" "," program_sentence

/* The copy is made from the revealed card; the optional cast consumes that copy. */
/* @sem Ability::[$first_draw_reveal_rule, Triggered{event:Player{event:RevealsFirstCardDrawn, players:One(AbilityController), objects:$card_filter}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:CopyCards{actor:One(AbilityController), objects:One(EventSubject), times:Constant(1)}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Copies(@marked), count:Exactly(Constant(1)), terms:_{cost:Reduced($kicker_operand_generic), into_exile:false, effects:[], flash:false, may_look:false}}}]}}]}}] */
line_first_draw_copy ::= first_draw_reveal_rule "whenever" "you" "reveal" ("a" | "an") card_filter "card" "this" "way" "," "copy" "that" "card" "and" "you" "may" "cast" "the" "copy" "." "that" "copy" "costs" kicker_operand_generic "less" "to" "cast" "."

first_draw_reveal_rule ::= first_draw_reveal_required | first_draw_reveal_optional
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(RevealDraws{first_during:All, optional:false})]} */
first_draw_reveal_required ::= "reveal" "the" "first" "card" "you" "draw" "each" "turn" "."
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(RevealDraws{first_during:All, optional:true})]} */
first_draw_reveal_optional ::= "you" "may" "reveal" "the" "first" "card" "you" "draw" "each" "turn" "as" "you" "draw" "it" "."

/* A private-zone origin constrains the entering object's owner independently
   of its battlefield controller. This is an entry event, not a death event. */
/* @sem EventSpec::ZoneChange{objects:@and($event_object, ObjectFilter::OwnedBy(One(AbilityController))), from:$greatest_card_zone, to:Battlefield} */
event_enters_owned_origin ::= event_object "enters" "from" "your" greatest_card_zone

/* The EventSpec form prints the native canonical merge of equal trigger bodies. */
/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:@and($event_self, ObjectFilter::OwnedBy(One(AbilityController))), from:$greatest_card_zone, to:Battlefield}, EventSpec::ZoneChange{objects:@and($event_another, ObjectFilter::OwnedBy(One(AbilityController))), from:$greatest_card_zone, to:Battlefield}) */
event_pair_enters_owned_origin ::= event_self "or" event_another "enters" "from" "your" greatest_card_zone

/* Independently edited origin operands cannot share one printed suffix. */
/* @sem EventSpec::@either_event(EventSpec::$event_enters_owned_origin, EventSpec::$event_enters_owned_origin_2) */
event_two_owned_origins ::= event_enters_owned_origin "or" event_enters_owned_origin

/* Naming a player establishes the typed defender separately from the attacker. */
/* @sem EventSpec::Attack{attackers:$event_object, defenders:Players(All)} */
event_attacks_player ::= event_object "attacks" "a" "player"

/* @sem EventSpec::AnyOf([Object{event:Attacks, objects:$event_object}, Object{event:Blocks, objects:$event_object}]) */
event_attacks_or_blocks ::= event_object "attacks" "or" "blocks"

/* Standalone leading timing is a recurring turn trigger. */
/* @sem EventSpec::Turn{point:CombatEnds, players:All} */
turn_end_combat ::= "end" "of" "combat"

/* A subtype shared by written instant/sorcery alternatives stays shared. */
/* @sem @and($subtype, $spell_nonpermanent) */
spell_subtype_nonpermanent ::= subtype spell_nonpermanent
spell_nonpermanent ::= spell_instant | spell_sorcery | spell_instant_or_sorcery | spell_nonpermanent_qualified | spell_subtype_nonpermanent
/* @sem @and($spell_prefix, $spell_nonpermanent) */
spell_nonpermanent_qualified ::= spell_prefix spell_nonpermanent
/* @sem ObjectFilter::AnyOf([$spell_instant, $spell_sorcery]) */
spell_instant_or_sorcery ::= spell_instant "or" spell_sorcery
/* @sem ObjectFilter::AnyOf([$subtype, $subtype_2]) */
spell_subtype_either ::= subtype "or" subtype

/* These scalar fragments are reachable only from the guarded owning ability. */
limited_entry_clause ::= limited_controlled_entry_clause | limited_plain_entry_clause
/* @sem EventSpec::Player{event:EntersUnderControl, players:All, objects:$controlled_entry_plural_filter} */
limited_controlled_entry_clause ::= ("when" | "whenever") "one" "or" "more" controlled_entry_plural_filter "enter"
/* @sem EventSpec::ZoneChange{objects:$filter_plural, to:Battlefield} */
limited_plain_entry_clause ::= ("when" | "whenever") "one" "or" "more" filter_plural "enter"

/* The first explicit self names both arms; saddled qualifies only the attack.
   Reusing that lexical reference keeps granted holder and creator distinct. */
/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:SameObject($self_explicit_ref), to:Battlefield}, EventSpec::Filtered{event:Object{event:Attacks, objects:SameObject($self_explicit_ref)}, condition:ObjectMatches{object:$self_explicit_ref, filter:State(Saddled)}}) */
event_self_enters_saddled_attack ::= self_explicit_ref "enters" "and" "whenever" "it" "attacks" "while" "saddled"

/* One shared event frame remains a proper alternative. Another retains its
   written filter and explicit Not(SameObject(Source)); no global role alias. */
/* @sem EventSpec::@either_event(EventSpec::Object{event:TurnsFaceUp, objects:$event_self}, EventSpec::Object{event:TurnsFaceUp, objects:@and(ObjectFilter::Not($event_self), $filter_phrase)}) */
event_own_or_other_faceup ::= event_self "or" "another" filter_phrase "is" "turned" "face" "up"


/* Conjuring a batch containing other cards is one player event, not a loop
   over its cards or a distinguished first-card reference. */
/* @sem EventSpec::Player{event:ConjuresOther, players:One(AbilityController)} */
event_conjures_other ::= "you" "conjure" "one" "or" "more" "other" "cards"

/* The suffix belongs to this one root trigger. A single raw typed reading is
   reused, then bound independently in its default and graveyard owners. */
/* @sem Ability::[$graveyard_suffix_trigger, Scoped{zones:[Graveyard], ability:@scope($graveyard_suffix_trigger)}] */
line_additional_graveyard_trigger ::= graveyard_suffix_trigger "this" "ability" "also" "triggers" "if" "this" "card" "is" "in" "your" "graveyard" "."

graveyard_suffix_trigger ::= graveyard_suffix_plain | graveyard_suffix_if
/* @sem Ability::Triggered{event:$graveyard_suffix_header, limits:TriggerLimits{}, announcement:@announcement, body:$graveyard_suffix_body} */
graveyard_suffix_plain ::= graveyard_suffix_header "," graveyard_suffix_body
/* @sem Ability::Triggered{event:$graveyard_suffix_header, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$graveyard_suffix_body} */
graveyard_suffix_if ::= graveyard_suffix_header "," "if" condition "," graveyard_suffix_body

graveyard_suffix_header ::= graveyard_suffix_turn | graveyard_suffix_cast | graveyard_suffix_conjure
/* @sem $graveyard_suffix_turn_event */
graveyard_suffix_turn ::= "at" graveyard_suffix_turn_event
graveyard_suffix_turn_event ::= turn_upkeep | turn_draw | turn_end | turn_combat | turn_combat_each | turn_second_main | turn_end_combat
/* @sem $event_cast */
graveyard_suffix_cast ::= ("when" | "whenever") event_cast
/* @sem $event_conjures_other */
graveyard_suffix_conjure ::= ("when" | "whenever") event_conjures_other

/* An owned immediate self-pump avoids partial legacy where-X recipes. Fixed
   amounts may precede ordinary instructions; an X definition stays local to
   its own first instruction and cannot acquire a later tail's operands. */
graveyard_suffix_body ::= graveyard_suffix_fixed_last | graveyard_suffix_fixed_tail | graveyard_suffix_where
/* @sem $graveyard_suffix_fixed_program */
graveyard_suffix_fixed_last ::= graveyard_suffix_fixed_program "."
/* @sem Program::Program{instructions:[...$graveyard_suffix_fixed_instructions, ...$instructions]} */
graveyard_suffix_fixed_tail ::= graveyard_suffix_fixed_instructions "." instructions "."
/* @sem @where($graveyard_suffix_x_program, $value) */
graveyard_suffix_where ::= graveyard_suffix_x_program "," "where" "X" "is" value "."

/* @sem Program::Program{instructions:$graveyard_suffix_fixed_instructions} */
graveyard_suffix_fixed_program ::= graveyard_suffix_fixed_instructions
/* @sem Instruction::[Effect{result:@next, operation:CreatePerpetualEffect{objects:One($self_explicit_ref), changes:$graveyard_suffix_fixed_pump}}] */
graveyard_suffix_fixed_instructions ::= self_explicit_ref "perpetually" graveyard_suffix_fixed_pump
/* @sem Change::[Pump{power:$graveyard_suffix_signed, toughness:$graveyard_suffix_signed_2}] */
graveyard_suffix_fixed_pump ::= "gets" graveyard_suffix_signed "/" graveyard_suffix_signed
graveyard_suffix_signed ::= graveyard_suffix_plus | graveyard_suffix_minus
/* @sem $number_digits */
graveyard_suffix_plus ::= "+" number_digits
/* @sem @negate($number_digits) */
graveyard_suffix_minus ::= "-" number_digits

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:One($self_explicit_ref), changes:$change_pump}}]} */
graveyard_suffix_x_program ::= self_explicit_ref "perpetually" change_pump

/* @sem EventSpec::Player{event:RingTempts, players:One(AbilityController)} */
event_ring_tempts_you ::= "the" "Ring" "tempts" "you"

/* @sem EventSpec::Object{event:FinalChapterResolves, objects:$chapter_ability_object} */
event_final_chapter_resolves ::= chapter_ability_object "resolves"


/* The event's damage source supplies the relative owner/controller, rather
   than an unrelated lexical source or a free continuous-effect candidate. */
/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:$event_object, recipients:Players(One($damage_subject_player)), kind:Any, grouping:SourceRecipient, subject:Source}) */
event_damage_subject_player ::= event_object "deals" "damage" "to" damage_subject_player
/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:$event_object, recipients:Players(One($damage_subject_player)), kind:Combat, grouping:SourceRecipient, subject:Source}) */
event_combat_damage_subject_player ::= event_object "deals" "combat" "damage" "to" damage_subject_player
damage_subject_player ::= damage_subject_owner | damage_subject_controller
/* @sem PlayerRef::OwnerOf(Damage(Source)) */
damage_subject_owner ::= "its" "owner"
/* @sem PlayerRef::ControllerOf(Damage(Source)) */
damage_subject_controller ::= "its" "controller"

/* The same written actor participates in either event. */
/* @sem EventSpec::@either_event(EventSpec::Player{event:PlaysLand, players:One(AbilityController), objects:CardType(Land)}, EventSpec::Spell{event:Cast, players:One(AbilityController), spells:$land_spell_cast_filter}) */
event_land_or_spell_you ::= "you" "play" "a" "land" "or" "cast" land_spell_cast_filter

/* @sem EventSpec::@either_event(EventSpec::Player{event:PlaysLand, players:$event_player, objects:CardType(Land)}, EventSpec::Spell{event:Cast, players:$event_player, spells:$land_spell_cast_filter}) */
event_land_or_spell_player ::= event_player "plays" "a" "land" "or" "casts" land_spell_cast_filter

/* A trailing origin/target modifier can qualify both event alternatives. It
   must not enter through a cast-only child of this unqualified union. */
land_spell_cast_filter ::= spell_any | spell_filtered

/* Some printed names take plural verbs while still naming this one object.
   A holder pronoun does not enter this name-only spelling alternative. */
/* @sem EventSpec::@either_event(EventSpec::Object{event:Attacks, objects:$event_named}, EventSpec::Object{event:Blocks, objects:$event_named}) */
event_named_attack_or_block ::= event_named "attack" "or" "block"

/* The explicit permanent noun contributes its six card types in an event
   filter, independently of the face-down state and controller restriction. */
/* @sem EventSpec::Object{event:TurnsFaceUp, objects:@and(ObjectFilter::State(FaceDown), @and($card_permanent, ObjectFilter::ControlledBy(One(AbilityController))))} */
event_face_down_permanent_up ::= "a" "face-down" card_permanent "you" "control" "is" "turned" "face" "up"

/* The enchanted player controls the entrant; the enchantment's ability
   controller independently performs its subsequent instructions. */
/* @sem EventSpec::Player{event:EntersUnderControl, players:All, objects:@and($filter_phrase, ObjectFilter::ControlledBy(One(EnchantedBy(Source))))} */
event_enchanted_player_entry ::= ("a" | "an") filter_phrase "enchanted" "player" "controls" "enters"

/* Any of these four bend actions is one player event. The later all-four
   history condition is a separate resolution-time check. */
/* @sem EventSpec::Player{event:Bends, players:One(AbilityController)} */
event_bends_all_kinds ::= "you" "waterbend" "," "earthbend" "," "firebend" "," "or" "airbend"

/* "Whenever enchanted player is attacked": one event per attacked player, however many
   creatures attack them. */
/* @sem EventSpec::Batch{event:Attack{attackers:Any, defenders:Players($event_player)}, per:Defender} */
event_player_attacked ::= event_player "is" "attacked"

/* @sem EventSpec::Damage(_{source_kind:Any, sources:Any, recipients:Players($event_player), kind:Any, grouping:Recipient, subject:Recipient}) */
event_player_dealt_damage ::= event_player "is" "dealt" "damage"

/* @sem EventSpec::Player{event:LosesGame, players:$event_losing_player} */
event_player_loses_game ::= event_losing_player "loses" "the" "game"

/* One persistent chosen player supplies both event alternatives. */
/* @sem EventSpec::@either_event(EventSpec::Batch{event:Attack{attackers:Any, defenders:Players(One(Chosen))}, per:Defender}, EventSpec::Player{event:BecomesTarget, players:One(Chosen), objects:Any}) */
event_chosen_player_attacked_or_targeted ::= "the" "chosen" "player" "is" "attacked" "or" "becomes" "the" "target" "of" "a" "spell" "or" "ability"

/* @sem EventSpec::Player{event:Attacks, players:One(AbilityController)} */
event_controller_attacks ::= "you" "attack"

/* Attacking a player triggers once for each defending player attacked. */
/* @sem EventSpec::Batch{event:Attack{attackers:Any, by:One(AbilityController), defenders:Players(All)}, per:Defender} */
event_you_attack_player ::= "you" "attack" "a" "player"
/* @sem EventSpec::Batch{event:Attack{attackers:$filter_plural, by:One(AbilityController), defenders:Players(All)}, per:Defender} */
event_you_attack_player_with ::= "you" "attack" "a" "player" "with" "one" "or" "more" filter_plural
/* @sem EventSpec::Batch{event:Attack{attackers:$filter_plural, defenders:Players(All)}, per:Defender} */
event_creatures_attack_player ::= "one" "or" "more" filter_plural "attack" "a" "player"
/* @sem EventSpec::Batch{event:Attack{attackers:$filter_plural, defenders:Players(All)}, per:Defender, count:[GreaterOrEqual, $count_plural]} */
event_several_attack_player ::= count_plural "or" "more" filter_plural "attack" "a" "player"
/* @sem EventSpec::AnyOf([Batch{event:Attack{attackers:$filter_plural, by:One(AbilityController), defenders:Objects($filter_phrase)}, per:Defender}, Batch{event:Attack{attackers:$filter_plural, by:One(AbilityController), defenders:Players(All)}, per:Defender}]) */
event_you_attack_player_or_with ::= "you" "attack" "a" "player" "or" filter_phrase "with" "one" "or" "more" filter_plural

/* A plain article does not exclude the source. Keep that meaning distinct
   from `another`, and use the shared event union in both directions. */
/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:$event_self, to:Battlefield}, EventSpec::Player{event:EntersUnderControl, players:All, objects:$controlled_entrant_a}) */
event_controlled_self_or_a_enters ::= event_self "or" controlled_entrant_a "enters"

/* The explicit entrant supplies both event and cast test, including a named
   creator inside a granted ability. No unbound scalar pronoun is introduced. */
/* @sem Ability::Triggered{event:ZoneChange{objects:SameObject($self_ref), to:Battlefield}, intervening_if:ObjectMatches{object:$self_ref, filter:Cast{by:One(AbilityController)}}, limits:TriggerLimits{}, announcement:@announcement, body:$cast_entry_destroy_program} */
triggered_self_entry_if_cast ::= ("when" | "whenever") self_ref "enters" "," "if" "you" "cast" "it" "," cast_entry_destroy_program

/* This opt-in body has no unproved target-introduction/otherwise anaphors. */
cast_entry_destroy_program ::= cast_entry_destroy_only | exile_each_opponent_controller_draw

/* A departed holder's counter count is last-known information. Both echoes use
   that count, and `other` excludes the named owner rather than the controller. */
/* @sem Ability::Triggered{event:ZoneChange{objects:SameObject($self_explicit_ref), from:Battlefield, to:Graveyard}, intervening_if:ObjectMatches{object:$self_explicit_ref, filter:Counters{kind:$counter_kind, comparison:GreaterOrEqual, value:$counter_echo_threshold}}, limits:TriggerLimits{}, announcement:Announcement{}, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(OwnerOf($self_explicit_ref)), amount:CountCounters{recipients:Objects(One($self_explicit_ref)), kind:$counter_kind, information:CurrentOrLastKnown}}}, Effect{result:@next, operation:LoseLife{players:OthersThan(OwnerOf($self_explicit_ref)), amount:CountCounters{recipients:Objects(One($self_explicit_ref)), kind:$counter_kind, information:CurrentOrLastKnown}}}]}} */
triggered_counter_owner_echo ::= ("when" | "whenever") self_explicit_ref "dies" "," "if" "it" "had" counter_echo_threshold "or" "more" counter_kind "counters" "on" "it" "," "its" "owner" "draws" "that" "many" "cards" "and" "each" "other" "player" "loses" "that" "much" "life" "."

/* The threshold is written, rather than an undeclared announced X. */
counter_echo_threshold ::= number_digits | number_words

/* Chaos ensues for every player. */
/* @sem EventSpec::Player{event:ChaosEnsues, players:All} */
event_chaos_ensues ::= "chaos" "ensues"

/* Planes. "When you planeswalk to Littjara and at the beginning of your upkeep" is one
   trigger whose event is either moment, unlike two repeated trigger headers. */
/* @sem EventSpec::Player{event:Planeswalks, players:One(PlayerRef::AbilityController), objects:SameObject($self_explicit_ref)} */
event_planeswalk_to ::= "you" "planeswalk" "to" self_explicit_ref
/* @sem EventSpec::Player{event:PlaneswalksAway, players:One(PlayerRef::AbilityController), objects:SameObject($self_explicit_ref)} */
event_planeswalk_away ::= "you" "planeswalk" "away" "from" self_explicit_ref
/* @sem EventSpec::AnyOf([Player{event:Planeswalks, players:One(PlayerRef::AbilityController), objects:SameObject($self_explicit_ref)}, $planeswalk_turn]) */
event_planeswalk_or_turn ::= "you" "planeswalk" "to" self_explicit_ref "and" "at" planeswalk_turn
planeswalk_turn ::= turn_event | turn_first_main | turn_first_upkeep
/* @sem EventSpec::Turn{point:FirstMainPhaseBegins, players:One(PlayerRef::AbilityController)} */
turn_first_main ::= "the" "beginning" "of" "your" "first" "main" "phase"
/* @sem EventSpec::FirstEachGame(Turn{point:UpkeepBegins, players:All}) */
turn_first_upkeep ::= "the" "beginning" "of" "the" "first" "upkeep" "of" "the" "game"

/* One trigger per player dealt combat damage by the group. */
/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:$filter_plural, recipients:Players(All), kind:$group_damage_kind, grouping:Recipient, subject:Source}) */
event_group_combat_damage_to_player ::= "one" "or" "more" filter_plural "deal" group_damage_kind "to" "a" "player"

/* Your second draw each turn. */
/* @prefer always */
/* @sem EventSpec::NthEachTurn{event:Player{event:Draws, players:One(AbilityController)}, test:NumberTest::Compare{comparison:Equal, value:Constant(2)}} */
event_second_draw_each_turn ::= "you" "draw" "your" "second" "card" "each" "turn"

/* A matching creature attacking alone. */
/* @sem EventSpec::Object{event:AttacksAlone, objects:$filter_phrase} */
event_a_attacks_alone ::= "a" filter_phrase "attacks" "alone"

/* A named creature attacking alone. */
/* @sem EventSpec::Object{event:AttacksAlone, objects:SameObject($object_ref)} */
event_object_attacks_alone ::= object_ref "attacks" "alone"

/* Unlocking this Room door. */
/* @sem EventSpec::Player{event:UnlocksDoor, players:One(AbilityController), objects:SameObject(Source)} */
event_unlock_this_door ::= "you" "unlock" "this" "door"

/* Attacking while saddled filters the attack event by state. */
/* @sem EventSpec::Filtered{event:Object{event:Attacks, objects:SameObject($object_ref)}, condition:ObjectMatches{object:$object_ref, filter:State(Saddled)}} */
event_attacks_while_saddled ::= object_ref "attacks" "while" "saddled"

/* A state trigger when you control none of a kind. */
/* @sem EventSpec::State{condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}} */
event_control_none ::= "you" "control" "no" filter_plural


/* A creature dealt damage this turn by the named source dies. */
/* @sem EventSpec::ZoneChange{objects:AllOf([$filter_phrase, Condition(Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:SameObject($object_ref), recipients:Objects(SameObject(Candidate)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}})]), from:Battlefield, to:Graveyard} */
event_damaged_by_dies ::= counter_amount filter_phrase "dealt" "damage" "by" object_ref "this" "turn" "dies"

/* Exploiting pairs the exploiter with the sacrificed creature. */
/* @sem EventSpec::Pair{event:Exploits, objects:SameObject($object_ref), others:$filter_phrase} */
event_exploits ::= object_ref "exploits" "a" filter_phrase

/* Transforming into this face. */
/* @sem EventSpec::Object{event:Transforms, objects:SameObject($object_ref)} */
event_transforms_into_self ::= object_ref "transforms" "into" SELF_NAME

/* A named object dying. */
/* @sem EventSpec::ZoneChange{objects:SameObject($object_ref), from:Battlefield, to:Graveyard} */
event_object_dies ::= object_ref "dies"

/* "That creature" named earlier leaving the battlefield. */
/* @sem EventSpec::Object{event:LeavesBattlefield, objects:SameObject($that_noun)} */
event_that_noun_leaves ::= that_noun "leaves" "the" "battlefield"

/* Sacrificing a matching permanent other than this one. */
/* @sem EventSpec::Player{event:Sacrifices, players:One(AbilityController), objects:AllOf([Not(SameObject(Source)), $filter_phrase])} */
event_sacrifice_another ::= "you" "sacrifice" "another" filter_phrase

/* Becoming monstrous. */
/* @sem EventSpec::Object{event:BecomesMonstrous, objects:SameObject($object_ref)} */
event_becomes_monstrous ::= object_ref "becomes" "monstrous"

/* You tapping a matching or referenced permanent for mana. */
/* @sem EventSpec::Player{event:TapsForMana, players:One(AbilityController), objects:$event_mana_tap_subject} */
event_tap_for_mana ::= "you" "tap" event_mana_tap_subject "for" "mana"

/* A named permanent becoming tapped for mana. */
/* @sem EventSpec::Object{event:TappedForMana, objects:SameObject($object_ref)} */
event_tapped_for_mana ::= object_ref "is" "tapped" "for" "mana"

/* @sem EventSpec::Object{event:TappedForMana, objects:$filter_phrase} */
event_filtered_tapped_for_mana ::= ("a" | "an") filter_phrase "is" "tapped" "for" "mana"

/* You scrying. */
/* @sem EventSpec::Player{event:Scries, players:One(AbilityController)} */
event_you_scry ::= "you" "scry"

/* "Whenever you roll a die's highest natural result": a natural 20 on a d20. */
/* @sem EventSpec::Player{event:RollsHighestNatural, players:One(AbilityController)} */
event_you_roll_highest_natural ::= "you" "roll" "a" "die's" "highest" "natural" "result"

/* Entering or leaving the battlefield. */
/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:$entry_or_leave_subject, to:Battlefield}, EventSpec::Object{event:LeavesBattlefield, objects:$entry_or_leave_subject}) */
event_enters_or_leaves ::= entry_or_leave_subject "enters" "or" "leaves" "the" "battlefield"

/* "When this enchantment enters and at the beginning of your upkeep": one ability that
   triggers on either event. */
/* @sem EventSpec::AnyOf([ZoneChange{objects:SameObject($object_ref), to:Battlefield}, $turn_event]) */
event_enters_and_turn ::= object_ref "enters" "and" "at" turn_event

/* Expending a number of mana this turn. */
/* @sem EventSpec::NthEachTurn{event:Player{event:Expends, players:One(AbilityController)}, test:NumberTest::Compare{comparison:Equal, value:$value}} */
event_expend ::= "you" "expend" value

/* Trigger events taken over from seeded rules, in their original Oracle words. */
/* @sem EventSpec::Player{event:EncountersPhenomenon, players:One(AbilityController), objects:SameObject($object_ref)} */
event_encounter_phenomenon ::= "you" "encounter" object_ref

/* @sem EventSpec::Discard(_{players:One(AbilityController), cards:Any, kind:Any, grouping:Card}) */
event_cycle_or_discard ::= "you" "cycle" "or" "discard" "a" "card"
/* @sem EventSpec::Discard(_{players:One(AbilityController), cards:$cycling_card_noun, kind:Cycling, grouping:Card}) */
event_cycle_card ::= "you" "cycle" cycling_card_noun

/* @sem EventSpec::Batch{event:Object{event:LeavesGraveyard, objects:AllOf([$filter_phrase, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}, per:Whole} */
event_cards_leave_your_graveyard ::= "one" "or" "more" filter_phrase "cards" "leave" "your" "graveyard"

/* @sem EventSpec::Player{event:DayNightChanges, players:All} */
event_day_night_changes ::= "day" "becomes" "night" "or" "night" "becomes" "day"

/* @sem EventSpec::AnyOf([ZoneChange{objects:SameObject($object_ref), to:Battlefield}, Object{event:Transforms, objects:SameObject($object_ref_2)}]) */
event_enters_or_transforms_into ::= object_ref "enters" "or" "transforms" "into" object_ref

/* @sem EventSpec::Filtered{event:Object{event:Attacks, objects:SameObject($object_ref)}, condition:$condition} */
event_attacks_while ::= object_ref "attacks" "while" condition

/* The same singular recipient phrase serves named and unspecified counter events. */
/* @sem EventSpec::Batch{event:Counters(_{change:Put, kind:$counter_kind, objects:$event_singular_subject, by:One(AbilityController)}), per:Subject} */
event_you_put_counters ::= "you" "put" "one" "or" "more" counter_kind "counters" "on" event_singular_subject

/* @sem EventSpec::ClassLevel{objects:SameObject($object_ref), level:$value} */
event_becomes_level ::= object_ref "becomes" "level" value

/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:State(Kicked)} */
event_cast_kicked_spell ::= "you" "cast" "a" "kicked" "spell"

/* @sem EventSpec::Discard(_{players:All, cards:Any, kind:Cycling, grouping:Card}) */
event_player_cycles ::= "a" "player" "cycles" "a" "card"

/* @sem EventSpec::Attack{attackers:$filter_phrase, defenders:Players(One(AbilityController))} */
event_attacks_you ::= "a" filter_phrase "attacks" "you"

/* @sem EventSpec::AnyOf([ZoneChange{objects:SameObject($object_ref), to:Battlefield}, ZoneChange{objects:State(HauntedBySource), from:Battlefield, to:Graveyard}]) */
event_enters_or_haunted_dies ::= object_ref "enters" "or" "the" "creature" "it" "haunts" "dies"

/* @sem EventSpec::Batch{event:ZoneChange{objects:AllOf([$filter_phrase, OwnedBy(One(AbilityController)), Not(Token)]), to:Graveyard}, per:Whole} */
event_cards_put_into_your_graveyard ::= "one" "or" "more" filter_phrase "cards" "are" "put" "into" "your" "graveyard" "from" "anywhere"

/* @sem EventSpec::Damage(_{source_kind:Any, sources:Any, recipients:Players(One(AbilityController)), kind:$group_damage_kind, grouping:Recipient, subject:Recipient}) */
event_you_are_dealt_damage ::= "you're" "dealt" group_damage_kind

/* @prefer always */
/* @sem EventSpec::NthEachTurn{event:Spell{event:Cast, players:One(AbilityController), spells:$cast_turn_filter}, test:NumberTest::Compare{comparison:Equal, value:Constant(1)}} */
event_cast_first_spell_each_turn ::= "you" "cast" "your" "first" cast_turn_filter "spell" "each" "turn"

/* @sem EventSpec::Discard(_{players:One(AbilityController), cards:$filter_phrase, kind:Any, grouping:Card}) */
event_discard_filtered_card ::= "you" "discard" "a" filter_phrase "card"

/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:$filter_phrase, recipients:Players(One(AbilityController)), kind:Combat, grouping:SourceRecipient, subject:Source}) */
event_combat_damage_to_you ::= "a" filter_phrase "deals" "combat" "damage" "to" "you"


/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:OwnedBy(OthersThan(AbilityController))} */
event_cast_spell_you_dont_own ::= "you" "cast" "a" "spell" "you" "don't" "own"

/* @sem EventSpec::FirstEachTurn(BecomesTarget(_{objects:SameObject($object_ref), kind:SpellOrAbility, by:Term{family:SpellsAndAbilities, form:AnySpellOrAbility}})) */
event_first_targeted_each_turn ::= object_ref "becomes" "the" "target" "of" "a" "spell" "or" "ability" "for" "the" "first" "time" "each" "turn"

/* @sem EventSpec::ZoneChange{objects:AllOf([$filter_phrase, OwnedBy(One(AbilityController)), Not(Token)]), to:Graveyard} */
event_card_put_into_your_graveyard ::= "a" filter_phrase "card" "is" "put" "into" "your" "graveyard" "from" "anywhere"

/* @sem EventSpec::Player{event:CommitsCrime, players:One(AbilityController)} */
event_commit_crime ::= "you" "commit" "a" "crime"

/* @sem EventSpec::AnyOf([ZoneChange{objects:SameObject($object_ref), to:Battlefield}, Object{event:Specializes, objects:SameObject($object_ref)}]) */
event_enters_or_specializes ::= object_ref "enters" "or" "specializes"

/* @sem EventSpec::ZoneChange{objects:AllOf([OwnedBy(OpponentsOf(AbilityController)), Not(Token)]), to:Graveyard} */
event_card_put_into_opponent_graveyard ::= "a" "card" "is" "put" "into" "an" "opponent's" "graveyard" "from" "anywhere"

/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:AllOf([$adjective_color, $adjective_color_2])} */
event_cast_two_color_spell ::= "you" "cast" "a" "spell" "that's" "both" adjective_color "and" adjective_color

/* Historical deaths test the departing incarnation, including the damage
   predicate; the resolution separately projects its first graveyard object. */
/* @sem EventSpec::ZoneChange{objects:@and($filter_phrase, ObjectFilter::Condition(Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:SameObject($object_ref), recipients:Objects(SameObject(Candidate)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})), from:Battlefield, to:Graveyard} */
historical_damaged_death ::= ("a" | "an") filter_phrase "dealt" "damage" "by" object_ref "this" "turn" "died"

/* Both uses share the one declared historical predicate. Resolving this query
   re-evaluates deaths this turn, rather than capturing them at trigger time. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:Compare{left:EventHistory{event:$historical_damaged_death, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:FromHistoryDestinations{event:$historical_damaged_death, window:ThisTurn}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:$historical_return_followup}]}} */
triggered_historical_death_return ::= "at" turn_event "," "if" historical_damaged_death "," "put" "that" "card" "onto" "the" "battlefield" "under" "your" "control" "." historical_return_followup "."

/* A card's owner determines which graveyard receives it. Keep the subject
   filter independent of the destination phrase for parsing and printing. */
/* @sem EventSpec::ZoneChange{objects:$graveyard_card_movement, to:Graveyard} */
event_card_graveyard_anywhere ::= graveyard_card_movement "from" "anywhere"

graveyard_card_movement ::= graveyard_card_singular_movement | graveyard_card_plural_movement
/* @sem ObjectFilter::AllOf([$graveyard_card_subject, $graveyard_singular_owner, Not(Token)]) */
graveyard_card_singular_movement ::= graveyard_card_subject "is" "put" "into" graveyard_singular_owner
/* @sem ObjectFilter::AllOf([$filter_phrase, $graveyard_plural_owner, Not(Token)]) */
graveyard_card_plural_movement ::= "one" "or" "more" filter_phrase "cards" "are" "put" "into" graveyard_plural_owner

graveyard_card_subject ::= graveyard_card_unqualified | graveyard_card_another | graveyard_card_filtered
/* @sem ObjectFilter::Any */
graveyard_card_unqualified ::= "a" "card"
/* @sem ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)) */
graveyard_card_another ::= "another" "card"
/* @sem $graveyard_card_filter */
graveyard_card_filtered ::= "a" graveyard_card_filter "card"
graveyard_card_filter ::= filter_phrase | adjective_noncolor

graveyard_singular_owner ::= graveyard_your_owner | graveyard_any_owner | graveyard_player_owner
/* @sem ObjectFilter::OwnedBy(One(PlayerRef::AbilityController)) */
graveyard_your_owner ::= "your" "graveyard"
/* @sem ObjectFilter::OwnedBy(All) */
graveyard_any_owner ::= "a" "graveyard"
/* @sem ObjectFilter::OwnedBy(All) */
graveyard_player_owner ::= "a" "player's" "graveyard"
graveyard_plural_owner ::= graveyard_plural_all
/* @sem ObjectFilter::OwnedBy(All) */
graveyard_plural_all ::= "graveyards"

/* The event and its subject remain intact inside the first-occurrence wrapper. */
/* @sem EventSpec::FirstEachTurn($event_attacks) */
event_attacks_first_each_turn ::= event_attacks "for" "the" "first" "time" "each" "turn"

/* @sem EventSpec::Batch{event:Counters{change:Put, kind:$counter_kind, objects:$event_a}, per:Subject} */
event_singular_put_counters ::= "one" "or" "more" counter_kind "counters" "are" "put" "on" event_a

/* @sem EventSpec::Batch{event:Counters(_{change:Put, objects:$event_singular_subject, by:One(AbilityController)}), per:Subject} */
event_you_put_unspecified_counters ::= "you" "put" "one" "or" "more" "counters" "on" event_singular_subject

/* @sem EventSpec::Batch{event:Counters(_{change:Removed, objects:$event_singular_subject}), per:Subject} */
event_removed_counters ::= "one" "or" "more" "counters" "are" "removed" "from" event_singular_subject

/* @sem EventSpec::Batch{event:Counters(_{change:Put, kind:$counter_kind, objects:$filter_plural}), per:Whole} */
/* @prefer always */
event_plural_put_counters ::= "one" "or" "more" counter_kind "counters" "are" "put" "on" filter_plural

/* A filtered spell retains its explicit origin and its caster. */
/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:@and($spell_filter, ObjectFilter::Cast{from:Players{zone:Graveyard, players:One(AbilityController)}})} */
event_cast_filtered_from_graveyard ::= "you" "cast" spell_filter "from" "your" "graveyard"

/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:@and($spell_filter, ObjectFilter::Cast{from:Players{zone:Library, players:One(CasterOf(Candidate))}})} */
event_cast_filtered_from_library ::= "you" "cast" spell_filter "from" "your" "library"

/* A shared plural source retains its filter and controller independently. */
combat_group_source ::= combat_group_filter | combat_group_compound_controlled | combat_group_suspected_controlled

/* @sem ObjectFilter::$filter_plural */
combat_group_filter ::= "one" "or" "more" filter_plural

/* @sem @and($filter_phrase, @and($filter_plural, ObjectFilter::ControlledBy(One(AbilityController)))) */
combat_group_compound_controlled ::= "one" "or" "more" filter_phrase filter_plural "you" "control"

/* A per-recipient trigger and a batch trigger have different occurrence boundaries. */
/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:$combat_group_source, recipients:Players($combat_single_recipient), kind:Combat, grouping:Recipient, subject:Source}) */
event_group_combat_recipient ::= combat_group_source "deal" "combat" "damage" "to" combat_single_recipient

combat_single_recipient ::= combat_recipient_you | combat_recipient_player

/* @sem PlayerSet::One(AbilityController) */
combat_recipient_you ::= "you"

/* @sem PlayerSet::All */
combat_recipient_player ::= "a" "player"

/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:$combat_group_source, recipients:Players($combat_batch_recipients), kind:Combat, grouping:Batch, subject:Source}) */
event_group_combat_batch ::= combat_group_source "deal" "combat" "damage" "to" combat_batch_recipients

combat_batch_recipients ::= combat_batch_players | combat_batch_opponents

/* @sem PlayerSet::All */
combat_batch_players ::= "one" "or" "more" "players"

/* @sem PlayerSet::OpponentsOf(AbilityController) */
combat_batch_opponents ::= "one" "or" "more" "of" "your" "opponents"

/* @sem EventSpec::Damage(_{source_kind:Any, sources:Any, recipients:Objects($combat_group_source), kind:ExcessNoncombat, grouping:Batch, subject:Recipient}) */
event_group_excess_noncombat ::= combat_group_source "are" "dealt" "excess" "noncombat" "damage"

/* @sem EventSpec::Damage(_{source_kind:Any, sources:Any, recipients:Objects($event_object), kind:Noncombat, grouping:Recipient, subject:Recipient}) */
event_dealt_noncombat ::= event_object "is" "dealt" "noncombat" "damage"

/* Attacker selection and defender selection compose independently. */
/* @sem EventSpec::Attack{attackers:$filter_phrase, defenders:$attack_defender} */
event_filter_attacks_defender ::= "a" filter_phrase "attacks" attack_defender

/* @sem EventSpec::Attack{attackers:SameObject($object_ref), defenders:$attack_defender} */
event_object_attacks_defender ::= object_ref "attacks" attack_defender

attack_defender ::= attack_defender_you_and_walker | attack_defender_control_count | attack_defender_object | attack_defender_enchanted | attack_defender_opponents_walkers | attack_defender_more_life | attack_defender_monarch | attack_defender_most_life

/* @sem AttackDefenders::Objects($filter_phrase) */
attack_defender_object ::= "a" filter_phrase

/* @sem AttackDefenders::Players(One(EnchantedBy(Source))) */
attack_defender_enchanted ::= "enchanted" "player"

/* @sem AttackDefenders::PlayersAndPlaneswalkers(OpponentsOf(AbilityController)) */
attack_defender_opponents_walkers ::= "one" "of" "your" "opponents" "or" "a" "planeswalker" "an" "opponent" "controls"

/* @sem AttackDefenders::Players(Matching{binding:0, condition:Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:Greater, value:PlayerNumber{player:AbilityController, number:Life}}}}) */
attack_defender_more_life ::= "a" "player" "who" "has" "more" "life" "than" "you"

/* @sem AttackDefenders::Players(Matching{binding:0, condition:PlayerState{player:Bound(0), state:Monarch}}) */
attack_defender_monarch ::= "the" "monarch"

/* @sem AttackDefenders::Players(Matching{binding:0, condition:Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:Equal, value:AmongPlayers{players:All, number:Life, aggregation:Maximum}}}}) */
attack_defender_most_life ::= "the" "player" "with" "the" "most" "life" "or" "tied" "for" "most" "life"

/* A player attacking preserves the player event subject. */
/* @sem EventSpec::Player{event:Attacks, players:$event_player} */
event_player_attacks ::= event_player "attacks"

/* A whole batch of objects sharing the same event. */
/* @sem EventSpec::Batch{event:Object{event:$batch_object_action, objects:$batch_object_filter}, per:Whole} */
event_batch_objects ::= "one" "or" "more" batch_object_filter batch_object_action

batch_object_filter ::= filter_plural

batch_object_action ::= batch_object_tapped | batch_object_blocked | batch_object_blocks | batch_object_leaves | batch_object_leaves_without_dying | batch_object_fights

/* @sem ObjectEvent::BecomesTapped */
batch_object_tapped ::= "become" "tapped"

/* @sem ObjectEvent::BecomesBlocked */
batch_object_blocked ::= "become" "blocked"

/* @sem ObjectEvent::Blocks */
batch_object_blocks ::= "block"

/* @sem ObjectEvent::LeavesBattlefield */
batch_object_leaves ::= "leave" "the" "battlefield"

/* @sem ObjectEvent::LeavesWithoutDying */
batch_object_leaves_without_dying ::= "leave" "the" "battlefield" "without" "dying"

/* Land-play events retain the player and the filter as independent operands. */
/* @sem EventSpec::Player{event:PlaysLand, players:$land_play_actor, objects:$played_land_filter} */
event_play_land ::= land_play_actor played_land_filter

land_play_actor ::= land_play_you | land_play_third

/* @sem PlayerSet::One(PlayerRef::AbilityController) */
land_play_you ::= "you" "play"

/* @sem $event_player */
land_play_third ::= event_player "plays"

played_land_filter ::= played_land_a | played_land_an | event_another

/* @sem $filter_phrase */
played_land_a ::= "a" filter_phrase

/* @sem $filter_phrase */
played_land_an ::= "an" filter_phrase

/* The exiled holder is the event subject; each event retains its actor and change. */
exiled_holder_counter_event ::= exiled_holder_last_counter_event | exiled_holder_removed_counter_event | exiled_holder_you_remove_counter_event

/* @sem EventSpec::Counters(_{change:LastRemoved, kind:$counter_kind, objects:SameObject(Source)}) */
exiled_holder_last_counter_event ::= "when" "the" "last" counter_kind "counter" "is" "removed" "from" "this" "card"

/* @sem EventSpec::Counters(_{change:Removed, kind:$counter_kind, objects:SameObject(Source)}) */
exiled_holder_removed_counter_event ::= "whenever" "a" counter_kind "counter" "is" "removed" "from" "this" "card"

/* @sem EventSpec::Counters(_{change:Removed, kind:$counter_kind, objects:SameObject(Source), by:One(AbilityController)}) */
exiled_holder_you_remove_counter_event ::= "whenever" "you" "remove" "a" counter_kind "counter" "from" "this" "card"

/* The explicit holder reference proves that the exile scope belongs to this ability. */
/* @sem Ability::Scoped{zones:[Exile], ability:@scope(Ability::Triggered{event:$exiled_holder_counter_event, limits:_{}, announcement:@announcement, body:$program})} */
triggered_exiled_holder_event ::= exiled_holder_counter_event "while" "it's" "exiled" "," program "."

/* A state trigger observes a reusable condition, rather than an action event. */
/* @sem EventSpec::State{condition:$state_trigger_condition} */
event_state_condition ::= state_trigger_condition

state_trigger_condition ::= condition_named_counters_fewer_him | condition_battlefield_none | condition_state_controller_count | condition_state_controller_life | condition_state_opponents_none | condition_existential_hand | condition_existential_graveyard_count | condition_holder_no_named_counters | condition_holder_counters_at_least

/* A graveyard-local trigger composes its event, its explicit location test,
   and a resolution program. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$graveyard_local_event, intervening_if:$graveyard_local_condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})} */
graveyard_local_trigger_if ::= graveyard_local_event "," "if" graveyard_local_condition "," program_sentence

/* @sem $turn_event */
graveyard_local_turn ::= "at" turn_event

graveyard_local_event ::= graveyard_local_turn | event_clause

/* @sem Condition::ObjectMatches{object:$self_ref, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})} */
graveyard_local_present ::= self_ref "is" "in" "your" "graveyard"

/* @sem Condition::GraveyardPosition{card:$self_ref, player:AbilityController, above:$filter_phrase, comparison:GreaterOrEqual, amount:$counter_amount} */
graveyard_local_position ::= self_ref "is" "in" "your" "graveyard" "with" counter_amount filter_phrase "card" "directly" "above" "it"

graveyard_local_condition ::= graveyard_local_present | graveyard_local_position | graveyard_local_above_threshold | graveyard_local_only_card

/* The return instruction supplies the zone in which this ability functions. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$graveyard_local_event, limits:TriggerLimits{}, announcement:@announcement, body:$graveyard_return_payment})} */
graveyard_return_trigger ::= graveyard_local_event "," graveyard_return_payment "."

graveyard_return_payment ::= graveyard_return_hand_payment | graveyard_return_battlefield_payment

/* @sem Operation::Move{objects:One($self_ref), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
local_return_hand ::= "return" self_ref "from" "your" "graveyard" "to" "your" "hand"

/* This payment explicitly moves the holder from its graveyard. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$event_clause, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$graveyard_exile_payment})} */
graveyard_exile_trigger_if ::= event_clause "," "if" condition "," graveyard_exile_payment "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Move{selections:[_{objects:One(Source)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}}]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:$program, otherwise:Program{}}]} */
graveyard_exile_payment ::= "you" "may" "exile" self_card "from" "your" "graveyard" "." "if" "you" "do" "," program

/* @sem EventSpec::Object{event:LeavesGraveyard, objects:AllOf([$filter_phrase, InZone(Players{zone:Graveyard, players:OpponentsOf(AbilityController)})])} */
event_opponent_graveyard_card_leaves ::= "a" filter_phrase "card" "leaves" "an" "opponent's" "graveyard"

/* The self-return program establishes the graveyard activation zone. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$graveyard_turn_self_program})} */
scoped_turn_self_return ::= "at" turn_event "," graveyard_turn_self_program

/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$turn_event, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$graveyard_turn_self_program})} */
scoped_turn_if_self_return ::= "at" turn_event "," "if" condition "," graveyard_turn_self_program

/* Ownership is independent of control. */
/* @sem @and(ObjectFilter::OwnedBy(One(PlayerRef::AbilityController)), $filter_phrase) */
event_owned ::= "your" filter_phrase

/* The plural verb retains the referenced object identity. */
/* @sem EventSpec::Object{event:Attacks, objects:$event_referenced_subject} */
event_referenced_attack ::= event_referenced_subject "attack"

/* @sem EventSpec::Player{event:TapsPermanent, players:One(AbilityController), objects:$tap_event_objects} */
event_you_tap_filtered ::= "you" "tap" tap_event_objects

/* @sem ObjectFilter::$filter_phrase */
tap_event_singular_a ::= "a" filter_phrase

/* @sem ObjectFilter::$filter_phrase */
tap_event_singular_an ::= "an" filter_phrase

/* @sem ObjectFilter::$filter_plural */
tap_event_plural ::= "one" "or" "more" filter_plural

tap_event_objects ::= tap_event_singular_a | tap_event_singular_an | tap_event_plural

/* The first occurrence wraps an independently constructed life event. */
/* @sem EventSpec::FirstEachTurn($event_life_change) */
event_first_life_each_turn ::= event_life_change "for" "the" "first" "time" "each" "turn"

event_life_change ::= event_you_lose_life | event_lose_life | event_gain_life | event_gain_life_third

/* The event subject is also the active player during their own turn. */
/* @sem EventSpec::FirstEachTurn(Player{event:$event_life_action_third, players:Intersection([$event_player, One(PlayerRef::Active)])}) */
event_first_life_own_turn ::= event_player event_life_action_third "for" "the" "first" "time" "during" "each" "of" "their" "turns"

event_life_action_third ::= event_loses_life_action | event_gains_life_action

/* @sem PlayerEvent::LosesLife */
event_loses_life_action ::= "loses" "life"

/* @sem PlayerEvent::GainsLife */
event_gains_life_action ::= "gains" "life"

/* The subject keeps the card filter and owner separate from the batch movement. */
/* @sem ObjectFilter::OwnedBy(One(AbilityController)) */
event_owned_cards_plain ::= "cards"

/* @sem ObjectFilter::AllOf([$filter_phrase, OwnedBy(One(AbilityController))]) */
event_owned_cards_filtered ::= filter_phrase "cards"

event_owned_cards ::= event_owned_cards_plain | event_owned_cards_filtered

/* @sem EventSpec::Batch{event:ZoneChange{objects:$event_owned_cards, from:Library, to:Graveyard}, per:Whole} */
event_owned_cards_from_library ::= "one" "or" "more" event_owned_cards "are" "put" "into" "your" "graveyard" "from" "your" "library"

/* @sem EventSpec::Object{event:Explores, objects:$event_object} */
event_explores ::= event_object "explores"

/* @sem EventSpec::FirstEachTurn($event_gain_life) */
event_gain_life_first_each_turn ::= event_gain_life "for" "the" "first" "time" "each" "turn"

/* Player actions share the actor and filtered object while retaining the action. */
/* @sem EventSpec::Player{event:$you_object_action_verb, players:One(PlayerRef::AbilityController), objects:$event_a} */
event_you_object_action ::= "you" you_object_action_verb event_a

you_object_action_verb ::= you_object_action_exert | you_object_action_sacrifice | you_object_action_visit

/* @sem PlayerEvent::Exerts */
you_object_action_exert ::= "exert"

/* @sem PlayerEvent::Sacrifices */
you_object_action_sacrifice ::= "sacrifice"

/* The player and sacrificed object retain independent filters. */
/* @sem EventSpec::Player{event:Sacrifices, players:$event_player, objects:$event_another} */
event_player_sacrifices_another ::= event_player "sacrifices" event_another

/* @sem EventSpec::Player{event:Sacrifices, players:All, objects:$event_many} */
event_players_sacrifice_many ::= "one" "or" "more" "players" "sacrifice" "one" "or" "more" event_many

/* Both sides retain their own object filter or explicit reference. */
/* @sem EventSpec::Pair{event:BecomesAttachedTo, objects:$attachment_event_operand, others:$attachment_event_operand_2} */
event_becomes_attached ::= attachment_event_operand "becomes" "attached" "to" attachment_event_operand

attachment_event_operand ::= event_a | event_referenced_subject

/* Singular action histories count occurrences, preserving the acting player. */
controller_history_action ::= controller_history_attack | controller_history_play_land

/* @sem EventSpec::Player{event:Attacks, players:One(AbilityController)} */
controller_history_attack ::= "attack" "with" "a" "creature"

/* @sem EventSpec::Player{event:PlaysLand, players:One(AbilityController), objects:Any} */
controller_history_play_land ::= "play" "a" "land"

/* The suspended source's triggered ability functions in exile. The condition
   and the body remain separate operands, including any optional player's choice. */
/* @sem Condition::ObjectMatches{object:Source, filter:State(Suspended)} */
suspended_source_condition ::= "this" "card" "is" "suspended"

/* @sem Ability::Scoped{zones:[Exile], ability:@scope(Ability::Triggered{event:$event_clause, intervening_if:$suspended_source_condition, limits:TriggerLimits{}, announcement:@announcement, body:$suspended_trigger_body})} */
suspended_source_trigger ::= event_clause "," "if" suspended_source_condition "," suspended_trigger_body

suspended_trigger_body ::= program_sentence | player_optional_program_sentence

/* @sem Program::Program{instructions:[Optional{decider:$player_ref, body:$program}]} */
player_optional_program_sentence ::= player_ref "may" program "."

/* The historical recipient is the counted opponent, not the damage source. */
/* @sem Expr::CountPlayers(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:EventHistory{event:Damage(_{source_kind:Any, sources:Any, recipients:Players(One(Bound(0))), kind:$historical_damage_kind, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}])) */
damaged_opponent_count ::= "dealt" historical_damage_kind "this" "turn"

historical_damage_kind ::= historical_any_damage | historical_combat_damage

/* @sem DamageKind::Any */
historical_any_damage ::= "damage"

/* @sem DamageKind::Combat */
historical_combat_damage ::= "combat" "damage"

/* Completion retains the completing player independently of the ability holder.
   Subject and verb agree before the shared event is constructed. */
/* @sem EventSpec::Player{event:CompletesDungeon, players:$dungeon_completer} */
event_complete_dungeon ::= dungeon_completer "a" "dungeon"

dungeon_completer ::= dungeon_completer_you | dungeon_completer_third

/* @sem PlayerSet::One(PlayerRef::AbilityController) */
dungeon_completer_you ::= "you" "complete"

/* @sem $event_player */
dungeon_completer_third ::= event_player "completes"

/* One event for a player attacking a named defending player. */
/* @sem EventSpec::Batch{event:Attack{attackers:Any, by:$event_player, defenders:Players($attack_player_defender)}, per:Defender} */
event_player_attacks_defender ::= event_player "attacks" attack_player_defender

attack_player_defender ::= attack_player_you | attack_player_opponent | attack_player_initiative_holder

/* Both alternatives retain the same event actor and current spell filter. */
/* @sem EventSpec::@either_event(EventSpec::Spell{event:Cast, players:$event_player, spells:$spell_filter}, EventSpec::Spell{event:Copy, players:$event_player, spells:$spell_filter}) */
event_cast_or_copy_third ::= event_player "casts" "or" "copies" spell_filter

/* A spell cast and an ability activation share the written actor. */
/* @sem EventSpec::@either_event(EventSpec::Spell{event:Cast, players:$event_player, spells:$spell_filter}, EventSpec::Activated{players:$event_player, abilities:Any}) */
event_cast_or_activate_third ::= event_player "casts" spell_filter "or" "activates" "an" "ability"

/* The paired pronouns refer to the cast spell or activated ability of this
   same event; this condition is confined to that paired trigger. */
/* @sem Ability::Triggered{event:$event_cast_or_activate_third, intervening_if:ObjectMatches{object:EventSubject, filter:ManaSpentFrom($filter_phrase)}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence} */
triggered_cast_or_activate_mana_when ::= "when" event_cast_or_activate_third "," "if" "mana" "from" "a" filter_phrase "was" "spent" "to" "cast" "it" "or" "activate" "it" "," program_sentence

/* @sem Ability::Triggered{event:$event_cast_or_activate_third, intervening_if:ObjectMatches{object:EventSubject, filter:ManaSpentFrom($filter_phrase)}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence} */
triggered_cast_or_activate_mana_whenever ::= "whenever" event_cast_or_activate_third "," "if" "mana" "from" "a" filter_phrase "was" "spent" "to" "cast" "it" "or" "activate" "it" "," program_sentence

/* The graveyard's possessor is the card's owner, not an action performer. */
/* @sem EventSpec::ZoneChange{objects:AllOf([$filter_phrase, OwnedBy(One(AbilityController))]), to:Graveyard} */
owned_card_graveyard_arrival ::= ("a" | "an") filter_phrase "card" "was" "put" "into" "your" "graveyard"

/* @sem EventSpec::ZoneChange{objects:OwnedBy(One(AbilityController)), to:Graveyard} */
owned_cards_graveyard_arrival ::= "cards" "were" "put" "into" "your" "graveyard"

/* @sem ObjectFilter::AllOf([Not(SameObject($object_ref)), AllOf([State(Equipped), $filter_phrase, ControlledBy(One(AbilityController))])]) */
event_equipped_controlled_other ::= "an" "equipped" filter_phrase "you" "control" "other" "than" object_ref

/* @sem EventSpec::AnyOf([Object{event:Attacks, objects:$event_singular_subject}, ZoneChange{objects:$event_singular_subject, from:Battlefield, to:Graveyard}]) */
event_singular_attacks_or_dies ::= event_singular_subject "attacks" "or" "dies"

/* A spell's type and linked-card name constraint are independent filters. */
/* @sem @and($spell_adjectives, $linked_name_filter) */
spell_linked_name ::= "a" spell_adjectives "spell" linked_name_filter

/* The compared object remains an operand of both shared-property tests. */
/* @sem ObjectFilter::AnyOf([Shares{property:Colors, with:$linked_exiled_card}, Shares{property:ManaValues, with:$linked_exiled_card}]) */
spell_shared_color_or_mana_value ::= "a" "spell" "that" "shares" "a" "color" "or" "mana" "value" "with" linked_exiled_card

/* The entering object and each action remain independent operands. */
/* @sem Ability::AsEvent{object:$object_ref, event:EntersOrTurnsFaceUp, actions:List([$entry_face_action])} */
as_entry_or_face_up ::= "as" object_ref "enters" "or" "is" "turned" "face" "up" "," entry_face_action "."

entry_face_action ::= entry_face_pt_choice | entry_face_count_counters

/* @sem Operand::Term{family:EnterOrFaceUpAction, form:EntersWithPTOfChoice, operands:[$entry_face_pt, $entry_face_pt_2]} */
entry_face_pt_choice ::= "it" "becomes" "your" "choice" "of" entry_face_pt "or" entry_face_pt

/* @sem Operand::Term{family:PT, form:PT, operands:[Integer($number), Integer($number_2)]} */
entry_face_pt ::= NUMBER "/" NUMBER

/* @sem Operand::Term{family:EnterOrFaceUpAction, form:EntersWithNumberCounters, operands:[Number($value), $entry_face_pt_counter]} */
entry_face_count_counters ::= "put" "X" entry_face_pt_counter "counters" "on" "it" "," "where" "X" "is" value

/* @sem Operand::Term{family:CounterType, form:PTCounter, operands:[Integer($number), Integer($number_2)]} */
entry_face_pt_counter ::= "+" NUMBER "/" "+" NUMBER

/* A turn trigger can sequence an operation before a scoped random-exile permission. */
/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$operation}, ...$random_graveyard_exile_play]}} */
turn_operation_random_exile_play ::= "at" turn_event "," operation "," "then" random_graveyard_exile_play "."

/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:_{instructions:$random_graveyard_exile_cast}} */
turn_random_exile_cast ::= "at" turn_event "," random_graveyard_exile_cast "."

/* A chosen target is the subject of a later death event; the delayed program
   is independently composed and retains the event's subject. */
/* @sem Ability::Spell{body:Program{instructions:[Effect{result:@next, operation:CreateTrigger{event:ZoneChange{objects:SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0}), from:Battlefield, to:Graveyard}, duration:$this_duration, body:$death_followup_program, announcement:_{}}}]}, announcement:@announcement} */
spell_choose_creature_death ::= "choose" "target" "creature" "." "when" "that" "creature" "dies" this_duration "," death_followup_program "."

death_followup_program ::= death_owner_return_program | death_lesser_search_program | death_exile_top_choose_play_program | death_target_controller_damage_program

/* These event filters refer to the previously announced target. */
/* @sem EventSpec::ZoneChange{objects:AllOf([SameObject(Target{slot:@last_slot, index:0}), ControlledBy(One(AbilityController))]), from:Battlefield, to:Graveyard} */
controlled_target_death_event ::= "it" "dies" "under" "your" "control"

/* @sem EventSpec::ZoneChange{objects:AllOf([$noun, Condition(Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:SameObject(Target{slot:@last_slot, index:0}), recipients:Objects(SameObject(Candidate)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})]), from:Battlefield, to:Graveyard} */
damaged_target_death_event ::= "a" noun "dealt" "damage" "by" "that" "creature" "dies"

/* @sem EventSpec::ExploresCard{objects:$event_object, cards:$explored_card_filter} */
event_explores_filtered_card ::= event_object "explores" ("a" | "an") explored_card_filter "card"

/* Copy events retain the actor and each independently described spell filter. */
/* @sem EventSpec::Spell{event:Copy, players:One(PlayerRef::AbilityController), spells:$spell_filter} */
event_you_copy_spell ::= "you" "copy" spell_filter

/* The acting player and the object filter are independent event operands. */
/* @sem EventSpec::Player{event:PutsOntoBattlefield, players:$event_player, objects:$event_a} */
event_player_puts_onto_battlefield ::= event_player "puts" event_a "onto" "the" "battlefield"

event_mana_tap_subject ::= event_a | event_referenced_subject

/* The linked creature retains the source of the earlier battlefield move. */
/* @sem ObjectFilter::MadeBy($object_ref) */
event_linked_battlefield_creature ::= "the" "creature" "put" "onto" "the" "battlefield" "with" object_ref

/* @sem EventSpec::ZoneChange{objects:$event_many, from:Battlefield, to:Graveyard} */
limited_many_die ::= "one" "or" "more" event_many "die"

/* @sem EventSpec::ZoneChange{objects:@and($controlled_entry_plural_filter, ObjectFilter::OwnedBy(All)), from:Battlefield, to:Graveyard} */
limited_many_put_graveyard ::= "one" "or" "more" controlled_entry_plural_filter "are" "put" "into" "a" "graveyard" "from" "the" "battlefield"

/* The attacking player is independent of the ownership and identity of the
   selected attackers. The same filter phrases can serve either selection. */
/* @sem EventSpec::Attack{attackers:$attack_selected, by:One(PlayerRef::AbilityController), defenders:Any} */
event_attack_with_selected ::= "you" "attack" "with" attack_selected

attack_selected ::= attack_selected_owned | attack_selected_opponent_owned | attack_selected_ref_or_owned

/* @sem ObjectFilter::AllOf([OwnedBy(One(PlayerRef::AbilityController)), $filter_phrase]) */
attack_selected_owned ::= "your" filter_phrase

/* @sem ObjectFilter::AllOf([$filter_phrase, OwnedBy(OpponentsOf(PlayerRef::AbilityController))]) */
attack_selected_opponent_owned ::= "a" filter_phrase "an" "opponent" "owns"

/* @sem ObjectFilter::AnyOf([SameObject($object_ref), $attack_selected_owned]) */
attack_selected_ref_or_owned ::= object_ref "and" "/" "or" attack_selected_owned

/* State triggers share the underlying battlefield condition with other contexts. */
/* @sem EventSpec::State{condition:$state_battlefield_condition} */
event_battlefield_state ::= state_battlefield_condition

/* The threshold and the type of cards above the holder are independent operands. */
/* @sem Condition::GraveyardPosition{card:$self_ref, player:AbilityController, above:$filter_phrase, comparison:GreaterOrEqual, amount:$value} */
graveyard_local_above_threshold ::= self_ref "is" "in" "your" "graveyard" "with" value "or" "more" filter_phrase "cards" "above" "it"

/* The same filter applies to the holder and to the counted graveyard cards. */
/* @sem Condition::AllOf([ObjectMatches{object:$self_ref, filter:$filter_phrase}, Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Equal, value:Constant(1)}}]) */
graveyard_local_only_card ::= self_ref "is" "the" "only" filter_phrase "card" "in" "your" "graveyard"

/* A single event subject can move to either written destination. */
/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:@and($event_object, ObjectFilter::OwnedBy(All)), from:Battlefield, to:Graveyard}, EventSpec::ZoneChange{objects:$event_object, from:Battlefield, to:Exile}) */
event_put_graveyard_or_exile ::= event_object "is" "put" "into" "a" "graveyard" "from" "the" "battlefield" "or" "is" "put" "into" "exile" "from" "the" "battlefield"

/* The other subject retains its own filter and excludes the referenced object. */
/* @sem EventSpec::AnyOf([ZoneChange{objects:AllOf([SameObject($object_ref), OwnedBy(All)]), from:Battlefield, to:Graveyard}, ZoneChange{objects:SameObject($object_ref), from:Battlefield, to:Exile}, ZoneChange{objects:AllOf([Not(SameObject($object_ref)), $filter_phrase, OwnedBy(All)]), from:Battlefield, to:Graveyard}, ZoneChange{objects:AllOf([Not(SameObject($object_ref)), $filter_phrase]), from:Battlefield, to:Exile}]) */
event_reference_or_another_put_graveyard_or_exile ::= object_ref "or" "another" filter_phrase "is" "put" "into" "a" "graveyard" "from" "the" "battlefield" "or" "is" "put" "into" "exile" "from" "the" "battlefield"

/* Event subjects preserve who cast the spell or controlled the permanent. */
opponent_caused_event ::= opponent_countered_cast_event | opponent_destroyed_controlled_event

/* @sem EventSpec::Object{event:Countered, objects:AllOf([$filter_phrase, Cast{by:One(AbilityController)}])} */
opponent_countered_cast_event ::= filter_phrase "spell" "you" "cast" "this" "turn" "was" "countered"

/* @sem EventSpec::Object{event:Destroyed, objects:AllOf([$filter_phrase, ControlledBy(One(AbilityController))])} */
opponent_destroyed_controlled_event ::= filter_phrase "under" "your" "control" "was" "destroyed" "this" "turn"

/* Subject-elided event lists keep each event's own count and filter. */
/* @sem EventSpec::Batch{event:Attack{attackers:$filter_plural, by:OpponentsOf(AbilityController), defenders:Players(One(AbilityController))}, per:Defender, count:[GreaterOrEqual, $value]} */
event_opponent_attack_you_count ::= "an" "opponent" "attacks" "you" "with" value "or" "more" filter_plural

/* @sem EventSpec::NthEachTurn{event:Player{event:Draws, players:OpponentsOf(AbilityController)}, test:NumberTest::Compare{comparison:Equal, value:$ordinal}} */
event_opponent_draw_nth_elided ::= "draws" "their" ordinal "card" "each" "turn"

/* @sem EventSpec::NthEachTurn{event:Spell{event:Cast, players:OpponentsOf(AbilityController), spells:Any}, test:NumberTest::Compare{comparison:Equal, value:$ordinal}} */
event_opponent_cast_nth_elided ::= "casts" "their" ordinal "spell" "each" "turn"

/* @sem EventSpec::AnyOf([$event_opponent_attack_you_count, $event_opponent_draw_nth_elided, $event_opponent_cast_nth_elided]) */
event_clause_opponent_three ::= "whenever" event_opponent_attack_you_count "," event_opponent_draw_nth_elided "," "or" event_opponent_cast_nth_elided

/* @sem EventSpec::Batch{event:Attack{attackers:Any, by:One(AbilityController), defenders:PlayersAndPlaneswalkers(One(EnchantedBy(Source)))}, per:Defender} */
event_you_attack_enchanted_walkers ::= "you" "attack" "enchanted" "opponent" "or" "a" "planeswalker" "they" "control"

/* @sem EventSpec::Batch{event:Attack{attackers:Any, by:One(EnchantedBy(Source)), defenders:PlayersAndPlaneswalkers(One(AbilityController))}, per:Defender} */
event_enchanted_attack_you_walkers ::= "they" "attack" "you" "or" "a" "planeswalker" "you" "control"

/* @sem EventSpec::@either_event($event_you_attack_enchanted_walkers, $event_enchanted_attack_you_walkers) */
event_clause_enchanted_mutual_attack ::= "when" event_you_attack_enchanted_walkers "or" "when" event_enchanted_attack_you_walkers

/* The inflected prefixes share the same recipient and damage event. */
damage_you_passive ::= damage_you_were | damage_you_have_been

/* @sem PlayerSet::One(PlayerRef::AbilityController) */
damage_you_were ::= "you" "were" "dealt"

/* @sem PlayerSet::One(PlayerRef::AbilityController) */
damage_you_have_been ::= "you've" "been" "dealt"

/* @sem EventSpec::Damage(_{source_kind:Any, sources:Any, recipients:Players($damage_you_passive), kind:Any, grouping:SourceRecipient, subject:Recipient}) */
damage_to_you_prefix ::= damage_you_passive

/* @sem EventSpec::Damage(_{source_kind:Spell, sources:AllOf([$adjective_color, AnyOf([CardType(Instant), CardType(Sorcery)])]), recipients:Players($damage_you_were), kind:Any, grouping:SourceRecipient, subject:Recipient}) */
damage_spell_history ::= damage_you_were "damage" "this" "turn" "by" "a" adjective_color "instant" "or" "sorcery" "spell"

/* @sem EventSpec::Damage(_{source_kind:Any, sources:Any, recipients:Objects(AllOf([$filter_phrase, ControlledBy(OpponentsOf(AbilityController))])), kind:Excess, grouping:SourceRecipient, subject:Source}) */
damage_excess_history ::= filter_phrase "an" "opponent" "controlled" "was" "dealt" "excess" "damage" "this" "turn"

/* The caster and the spell filter remain independent of the origin. */
/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:@and($spell_filter, ObjectFilter::Cast{from:Shared(Exile)})} */
event_cast_filtered_from_exile ::= "you" "cast" spell_filter "from" "exile"

/* Explicit holder conditions establish the zone of the ability itself. */
/* @sem Ability::Scoped{zones:[Exile], ability:@scope(Ability::Triggered{event:$event_clause, intervening_if:$exiled_holder_condition, limits:TriggerLimits{}, announcement:@announcement, body:$exiled_holder_program})} */
triggered_exile_holder_if ::= event_clause "," "if" exiled_holder_condition "," exiled_holder_program "."

/* @sem Ability::Scoped{zones:[Exile], ability:@scope(Ability::Triggered{event:$turn_event, intervening_if:$exiled_holder_condition, limits:TriggerLimits{}, announcement:@announcement, body:$exiled_holder_program})} */
triggered_exile_holder_turn_if ::= "at" turn_event "," "if" exiled_holder_condition "," exiled_holder_program "."

/* The selected creature belongs to the spell's announcement; the delayed
   trigger's event keeps its own damage source and grouping. */
selected_damage_event ::= selected_damage_any | selected_damage_attacker

selected_damage_creature ::= noun_creature | head_right_shared

/* @sem EventSpec::Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$selected_damage_creature}), index:0})), kind:Any, grouping:Recipient, subject:Recipient}) */
selected_damage_any ::= "choose" "target" selected_damage_creature "." "whenever" "that" "creature" "is" "dealt" "damage"

/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:AllOf([Attacking, CardType(Creature)]), recipients:Objects(SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$selected_damage_creature}), index:0})), kind:Any, grouping:SourceRecipient, subject:Source}) */
selected_damage_attacker ::= "choose" "target" selected_damage_creature "." "whenever" "that" "creature" "is" "dealt" "damage" "by" "an" "attacking" "creature"

/* The window modifies the actual event, preserving its subject. */
/* @sem EventSpec::Filtered{event:$event_enters, condition:$cast_window_declare_attackers} */
event_during_window ::= event_enters "during" cast_window_declare_attackers

/* A revealed draw retains the written player and the card predicate independently. */
/* @sem EventSpec::Player{event:DrawsRevealedCard, players:$revealed_draw_player, objects:$revealed_draw_card} */
event_draw_revealed ::= revealed_draw_player "draws" "a" revealed_draw_card

revealed_draw_player ::= event_player | revealed_draw_chosen_player

/* @sem PlayerSet::One(PlayerRef::Chosen) */
revealed_draw_chosen_player ::= "the" "chosen" "player"

revealed_draw_card ::= revealed_draw_filtered_card | revealed_draw_negative_card | revealed_draw_modified_card

/* @sem $filter_phrase */
revealed_draw_filtered_card ::= filter_phrase "card"

/* @sem $adjective_nontype */
revealed_draw_negative_card ::= adjective_nontype "card"

/* @sem $modifier_chosen_name */
revealed_draw_modified_card ::= "card" modifier_chosen_name

/* The first occurrence wraps a complete event, preserving its subject and grouping. */
/* @sem EventSpec::FirstEachTurn($event_first_each_turn_operand) */
event_first_each_turn_shared ::= event_first_each_turn_operand "for" "the" "first" "time" "each" "turn"

event_first_each_turn_operand ::= event_combat_damage_player | event_dealt_damage | event_object_becomes_crewed | event_you_investigate | event_holder_counters_put | event_you_scry | event_discard_many | event_active_discard_many | event_cycle_card


/* Filter the cast itself by the stated condition or controller timing. */
/* @sem EventSpec::Filtered{event:Spell{event:Cast, players:One(PlayerRef::AbilityController), spells:$spell_filter}, condition:$condition} */
event_cast_while ::= "you" "cast" spell_filter "while" condition

/* @sem EventSpec::Filtered{event:Spell{event:Cast, players:One(PlayerRef::AbilityController), spells:$spell_filter}, condition:PlayerIsActive(AbilityController)} */
event_cast_during_your_turn ::= "you" "cast" spell_filter "during" "your" "turn"

/* @sem EventSpec::Filtered{event:Spell{event:Cast, players:One(PlayerRef::AbilityController), spells:$spell_filter}, condition:AllOf([PlayerIsActive(AbilityController), Window(MainPhase)])} */
event_cast_during_your_main_phase ::= "you" "cast" spell_filter "during" "your" "main" "phase"

/* Zone changes retain the origin and the ownership or origin-zone constraint. */
/* @sem EventSpec::ZoneChange{objects:AllOf([$filter_phrase, OwnedBy(One(AbilityController))]), from:Library, to:Hand} */
event_owned_library_to_hand ::= "a" filter_phrase "card" "is" "put" "into" "your" "hand" "from" "your" "library"

/* @sem EventSpec::ZoneChange{objects:InZone(Players{zone:Graveyard, players:One(AbilityController)}), from:Graveyard, to:Hand} */
event_graveyard_to_hand ::= "a" "card" "in" "your" "graveyard" "is" "put" "into" "your" "hand"

/* The source-bound event fixes the referent of “another”. */
/* @sem EventSpec::Filtered{event:Object{event:Attacks, objects:$event_self}, condition:$condition_source_no_other_control} */
event_source_attacks_while ::= event_self "attacks" "while" condition_source_no_other_control

/* The step qualifier composes with independently defined object events. */
/* @sem EventSpec::Filtered{event:$event_during_step_base, condition:$condition_your_untap_step} */
event_during_your_untap_step ::= event_during_step_base "during" condition_your_untap_step

event_during_step_base ::= event_becomes_untapped | event_becomes_tapped | event_attacks

/* Play and cast alternatives share their actor; the two origin phrases retain
   independent filters, while the linked form shares one card population. */
/* @sem EventSpec::@either_event(EventSpec::Player{event:PlaysLandFromExile, players:One(AbilityController), objects:$played_exile_filter}, EventSpec::Spell{event:Cast, players:One(AbilityController), spells:$cast_exile_filter}) */
event_exile_play_cast_you ::= "you" "play" played_exile_filter "or" "cast" cast_exile_filter

/* @sem EventSpec::@either_event(EventSpec::Player{event:PlaysLandFromExile, players:$event_player, objects:$played_exile_filter}, EventSpec::Spell{event:Cast, players:$event_player, spells:$cast_exile_filter}) */
event_exile_play_cast_player ::= event_player "plays" played_exile_filter "or" "casts" cast_exile_filter

/* @sem $filter_phrase */
played_exile_filter ::= "a" filter_phrase "from" "exile"

/* @sem ObjectFilter::Cast{from:Shared(Exile)} */
cast_exile_filter ::= "a" "spell" "from" "exile"

/* @sem EventSpec::@either_event(EventSpec::Player{event:PlaysLandFromExile, players:One(AbilityController), objects:AllOf([$filter_phrase, InSet($linked_exile_cards)])}, EventSpec::Spell{event:Cast, players:One(AbilityController), spells:CastFromAmong($linked_exile_cards)}) */
event_linked_play_cast_you ::= "you" "play" "a" filter_phrase "or" "cast" "a" "spell" "from" "among" linked_exile_cards

/* First upkeep of the game, or of a specified player's game. */
/* @sem EventSpec::FirstEachGame(Turn{point:UpkeepBegins, players:$first_upkeep_players}) */
turn_first_game_upkeep ::= "the" "beginning" "of" first_upkeep_players "first" "upkeep"

/* @sem PlayerSet::All */
first_upkeep_all ::= "the"

/* @sem PlayerSet::One(AbilityController) */
first_upkeep_you ::= "your"

/* @sem PlayerSet::OthersThan(AbilityController) */
first_upkeep_other ::= "each" "other" "player's"

first_upkeep_players ::= first_upkeep_all | first_upkeep_you | first_upkeep_other

/* A named object and a disjoint filtered population retain their separate
   event subjects. The shared filter phrase carries its own qualifiers. */
/* @sem EventSpec::AnyOf([ZoneChange{objects:SameObject($object_ref), from:Battlefield, to:Graveyard}, ZoneChange{objects:@and(ObjectFilter::Not(ObjectFilter::SameObject($object_ref)), $filter_phrase), from:Battlefield, to:Graveyard}]) */
event_referenced_or_another_dies ::= object_ref "or" "another" filter_phrase "dies"

/* @sem EventSpec::AnyOf([ZoneChange{objects:@and(ObjectFilter::SameObject($object_ref), ObjectFilter::OwnedBy(All)), from:Battlefield, to:Graveyard}, ZoneChange{objects:@and(ObjectFilter::Not(ObjectFilter::SameObject($object_ref)), $filter_phrase, ObjectFilter::OwnedBy(All)), from:Battlefield, to:Graveyard}]) */
event_referenced_or_another_put_graveyard ::= object_ref "or" "another" filter_phrase "is" "put" "into" "a" "graveyard" "from" "the" "battlefield"

/* @sem EventSpec::AnyOf([ZoneChange{objects:SameObject($object_ref), from:Battlefield, to:Graveyard}, ZoneChange{objects:@and(ObjectFilter::Not(ObjectFilter::SameObject($object_ref)), $filter_phrase), from:Battlefield, to:Graveyard}, Damage(_{source_kind:Permanent, sources:SameObject($object_ref), recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source}), Damage(_{source_kind:Permanent, sources:@and(ObjectFilter::Not(ObjectFilter::SameObject($object_ref)), $filter_phrase), recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source})]) */
event_referenced_or_another_dies_or_combat_player ::= object_ref "or" "another" filter_phrase "dies" "or" "deals" "combat" "damage" "to" "a" "player"

/* The counter's antecedent is the stack object in this specific event. */
/* @sem Ability::Triggered{event:$event_target_by_opponent, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$target_union_counter}} */
targeted_by_opponent_counter_ability ::= "whenever" event_target_by_opponent "," target_union_counter "."

/* @sem EventSpec::BecomesTarget{objects:$event_object, kind:Spell, by:Filter(ControlledBy(OpponentsOf(AbilityController)))} */
event_target_spell_by_opponent ::= event_object "becomes" "the" "target" "of" "a" "spell" "an" "opponent" "controls"

/* @sem Ability::Triggered{event:$event_target_spell_by_opponent, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$counter_event_spell_unless_discard}} */
targeted_by_opponent_spell_counter_ability ::= "whenever" event_target_spell_by_opponent "," counter_event_spell_unless_discard "."

/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf(EventStackObject), cost:Cost{parts:[Discard{count:Constant(1), filter:Any}]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(EventStackObject), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}] */
counter_event_spell_unless_discard ::= "counter" "that" "spell" "unless" "its" "controller" "discards" "a" "card"

/* Shared filtered events preserve the event and its independently scoped condition. */
/* @sem EventSpec::Filtered{event:$event_controller_attacks, condition:$condition} */
event_filtered_while ::= event_controller_attacks "while" condition

filtered_controller_turn_event ::= event_energy_controller | event_sacrifice_another | event_lose_life | event_commit_crime | event_cards_exiled_from_graveyards_battlefield

/* @sem EventSpec::Filtered{event:$filtered_controller_turn_event, condition:PlayerIsActive(AbilityController)} */
event_filtered_controller_turn ::= filtered_controller_turn_event "during" "your" "turn"

filtered_subject_turn_event ::= event_gain_life | event_you_lose_life

/* @sem EventSpec::Filtered{event:$filtered_subject_turn_event, condition:PlayerIsActive(EventSubject)} */
event_filtered_subject_turn ::= filtered_subject_turn_event "during" "your" "turn"

/* @sem EventSpec::Filtered{event:$event_draw, condition:ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))}} */
event_filtered_opponent_turn ::= event_draw "during" "an" "opponent's" "turn"

/* DrawsCard is distinct from the unqualified Draws event. */
/* @sem EventSpec::Player{event:DrawsCard, players:$event_player} */
event_draw_card_third ::= event_player "draws" "a" "card"

/* @sem EventSpec::Filtered{event:$event_draw_card_third, condition:Not(FirstDrawInOwnDrawStep(EventSubject))} */
event_draw_except_first ::= event_draw_card_third "except" "the" "first" "one" "they" "draw" "in" "each" "of" "their" "draw" "steps"

/* A cast and its independently expressed timing or state restriction. */
/* @sem EventSpec::Filtered{event:$cast_event, condition:$cast_event_condition} */
event_cast_conditioned ::= cast_event cast_event_condition

cast_event ::= event_cast | event_cast_third | event_cast_from_hand

cast_event_condition ::= window_your_turn | window_during | cast_event_while

/* @sem $condition */
cast_event_while ::= "while" condition

/* The caster is the active player from the named player set, including in multiplayer games. */
/* @sem EventSpec::Filtered{event:Spell{event:Cast, players:One(Active), spells:$spell_filter}, condition:ExistsPlayer{players:$event_player, binding:0, condition:PlayerIsActive(Bound(0))}} */
event_cast_active_turn ::= event_player "casts" spell_filter "during" "their" "turn"

/* Damage events retain source and recipient grouping independently. */
/* @sem EventSpec::Damage(_{source_kind:Spell, sources:@and($spell_filter, ObjectFilter::ControlledBy(One(AbilityController))), recipients:Any, kind:Any, grouping:Source, subject:Source}) */
event_controlled_spell_damage ::= spell_filter "you" "control" "deals" "damage"

/* @sem EventSpec::Damage(_{source_kind:Any, sources:Any, recipients:Players($event_player), kind:Noncombat, grouping:Recipient, subject:Recipient}) */
event_player_noncombat_damage ::= event_player "is" "dealt" "noncombat" "damage"

/* @sem EventSpec::Damage(_{source_kind:Any, sources:Any, recipients:Players($damage_recipient_player), kind:Any, grouping:Recipient, subject:Recipient}) */
event_damage_to_player ::= "damage" "is" "dealt" "to" damage_recipient_player

/* @sem EventSpec::Damage(_{source_kind:Any, sources:Any, recipients:Players($damage_recipient_player), kind:Prevented, grouping:Recipient, subject:Recipient}) */
event_prevented_to_player ::= "damage" "that" "would" "be" "dealt" "to" damage_recipient_player "is" "prevented"

damage_recipient_player ::= passive_combat_you | event_player | damage_chosen_players

/* @sem PlayerSet::Matching{binding:0, condition:ValueChosenIs(Bound(0))} */
damage_chosen_players ::= "one" "of" "the" "chosen" "players"

/* A death event and its independently bound temporal or zone qualification. */
event_death_base ::= event_dies | event_object_dies

/* @sem EventSpec::Filtered{event:$event_death_base, condition:$death_qualifier} */
event_qualified_death ::= event_death_base death_qualifier

death_qualifier ::= death_during_your_turn | death_during_combat | death_while_in_your_graveyard

/* @sem Condition::PlayerIsActive(AbilityController) */
death_during_your_turn ::= "during" "your" "turn"

/* @sem Condition::Window(Combat) */
death_during_combat ::= "during" "combat"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})} */
death_while_in_your_graveyard ::= "while" object_ref "is" "in" "your" "graveyard"

/* The subject supplies the actor of a per-card discard history. */
/* @sem EventSpec::Discard{players:One($history_discard_subject), cards:Any, kind:Any, grouping:Card} */
history_discard_event ::= history_discard_subject "discarded"

history_discard_subject ::= history_discard_you | history_discard_youve

/* @prefer always */
/* @sem PlayerRef::AbilityController */
history_discard_you ::= "you"

/* @sem PlayerRef::AbilityController */
history_discard_youve ::= "you've"

/* The triggering event and the holder of the resulting ability are independent. */
/* @sem Ability::TriggerRule{cause:$retrigger_cause, abilities:AbilityOf($retrigger_cause_holder), rule:TriggersAgain} */
additional_trigger_from_cause ::= "if" retrigger_cause "causes" "a" "triggered" "ability" "of" retrigger_cause_holder "to" "trigger" "," "that" "ability" "triggers" "an" "additional" "time" "."

retrigger_cause ::= retrigger_entry_an | retrigger_entry_a | retrigger_dying_cause | retrigger_attack_cause | retrigger_target_cause | retrigger_damage_cause | retrigger_combat_damage_cause | retrigger_entry_cause

/* @sem EventSpec::Attack{attackers:$event_a, defenders:Any} */
retrigger_attack_cause ::= event_a "attacking"

/* @sem EventSpec::BecomesTarget(_{objects:$event_a, kind:SpellOrAbility, by:Term{family:SpellsAndAbilities, form:AnySpellOrAbility}}) */
retrigger_target_cause ::= event_a "becoming" "the" "target" "of" "a" "spell" "or" "ability"

/* @sem EventSpec::Damage(_{source_kind:Any, sources:Any, recipients:Objects($event_a), kind:Any, grouping:Recipient, subject:Recipient}) */
retrigger_damage_cause ::= event_a "being" "dealt" "damage"

/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:$event_a, recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source}) */
retrigger_combat_damage_cause ::= event_a "dealing" "combat" "damage" "to" "a" "player"

/* @sem $filter_phrase */
retrigger_cause_holder ::= "a" filter_phrase

/* A selected ability population can be reused with the same retrigger clause. */
/* @sem Ability::TriggerRule{abilities:$retrigger_ability_population, rule:TriggersAgain} */
additional_trigger_for_population ::= "if" "a" "triggered" "ability" "of" retrigger_ability_population "triggers" "," "that" "ability" "triggers" "an" "additional" "time" "."

retrigger_ability_population ::= retrigger_ability_union | retrigger_colorless_population | retrigger_object_or_attached

/* @sem ObjectFilter::AbilityOf(AllOf([AnyOf([$filter_phrase, AllOf([Not(SameObject(Source)), $filter_phrase_2])]), ControlledBy(One(AbilityController))])) */
retrigger_ability_union ::= "a" filter_phrase "or" "another" filter_phrase "you" "control"

/* @sem ObjectFilter::AnyOf([AllOf([OnStack(Spell), Colorless, $filter_phrase]), AbilityOf(AllOf([Not(SameObject(Source)), Colorless, Any, $filter_phrase]))]) */
retrigger_colorless_population ::= "a" "colorless" "spell" "you" "control" "or" "another" "colorless" filter_phrase

/* The player and the milled card filter are independent event operands. */
/* @sem EventSpec::Player{event:MillsCard, players:$event_player, objects:$adjective_nontype} */
event_player_mills_filtered_card ::= event_player "mills" "a" adjective_nontype "card"

/* A phase-in event shares the referenced subject with its optional controlled
   other-object alternative. The two references name the same object. */
event_phase_subject ::= event_referenced_subject | event_ref_or_another_controlled

/* @sem ObjectFilter::AnyOf([SameObject($object_ref), AllOf([Not(SameObject($object_ref)), $filter_phrase, ControlledBy(One(AbilityController))])]) */
event_ref_or_another_controlled ::= object_ref "or" "another" filter_phrase "you" "control"

/* @sem EventSpec::Object{event:PhasesIn, objects:$event_phase_subject} */
event_phases_in ::= event_phase_subject "phases" "in"

/* The actor and event subject are independent of the mana description. */
/* @sem EventSpec::TappedForManaOf{objects:$tap_event_singular_a, by:One(AbilityController), mana:$event_mana_kind} */
event_you_tap_for_mana_kind ::= "you" "tap" tap_event_singular_a "for" event_mana_kind

/* @sem EventSpec::TappedForManaOf{objects:$tap_event_singular_a, mana:$event_mana_kind} */
event_passive_tapped_for_mana_kind ::= tap_event_singular_a "is" "tapped" "for" event_mana_kind

/* The demonstrative color is bound to the chosen color in this event. */
/* @sem EventSpec::TappedForManaOf{objects:$tap_event_singular_a, mana:$event_mana_chosen_color} */
event_passive_chosen_mana ::= tap_event_singular_a "is" "tapped" "for" event_mana_chosen_color

chosen_mana_event_clause ::= chosen_mana_tapped_clause | event_when_ability_causes_chosen_mana | event_whenever_ability_causes_chosen_mana

/* @sem Ability::Triggered{event:$chosen_mana_event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$add_referenced_chosen_mana}]}} */
triggered_chosen_mana_reference ::= chosen_mana_event_clause "," add_referenced_chosen_mana "."

/* A condition qualifies a complete player event, preserving its participants. */
/* @sem EventSpec::Filtered{event:$conditionable_player_event, condition:$condition} */
event_conditioned_while ::= conditionable_player_event "while" condition

/* @sem EventSpec::Filtered{event:$conditionable_player_event, condition:PlayerIsActive(AbilityController)} */
event_conditioned_your_turn ::= conditionable_player_event "during" "your" "turn"

conditionable_player_event ::= event_source_noncombat_damage | event_source_damage | event_tap_for_mana | event_you_seek_cards | event_you_scry | event_cards_put_zone

/* @sem EventSpec::Player{event:Seeks, players:One(AbilityController)} */
event_you_seek_cards ::= "you" "seek" "one" "or" "more" "cards"

/* The first occurrence is counted per turn, with the controller's active turn
   separately constraining the event. The wrapped event retains its own subject. */
/* @sem EventSpec::Filtered{event:FirstEachTurn($event_first_during_your_turn_base), condition:PlayerIsActive(AbilityController)} */
event_first_during_your_turn ::= event_first_during_your_turn_base "for" "the" "first" "time" "during" "each" "of" "your" "turns"

event_first_during_your_turn_base ::= event_gain_life | event_referenced_becomes_tapped

/* @sem EventSpec::Object{event:BecomesTapped, objects:$event_singular_subject} */
event_referenced_becomes_tapped ::= event_singular_subject "becomes" "tapped"

/* Both event operands retain their own filter and origin. */
/* @sem EventSpec::@either_event($event_exile_cast, $event_exile_entry) */
event_exile_cast_or_entry ::= event_exile_cast ("or" | "and" "whenever") event_exile_entry

/* @sem EventSpec::Spell{event:Cast, players:One(PlayerRef::AbilityController), spells:@and($spell_filter, ObjectFilter::Cast{from:Shared(Exile)})} */
event_exile_cast ::= "you" "cast" spell_filter "from" "exile"

/* @sem EventSpec::ZoneChange{objects:$event_object, from:Exile, to:Battlefield} */
event_exile_entry ::= event_object "enters" "from" "exile"

/* A shared player and independent action alternatives form one trigger.
   Base and third-person forms remain separate for agreement. */
/* @sem EventSpec::AnyOf([Player{event:$player_event_base, players:One(AbilityController)}, Player{event:$player_event_base_second, players:One(AbilityController)}]) */
event_player_choice_base ::= "you" player_event_base "or" player_event_base_second

player_event_base_second ::= player_event_base

player_event_base ::= player_event_scry_base | player_event_surveil_base | player_event_search_base

/* @sem PlayerEvent::Scries */
player_event_scry_base ::= "scry"

/* @sem PlayerEvent::Surveils */
player_event_surveil_base ::= "surveil"

/* @sem PlayerEvent::SearchesLibrary */
player_event_search_base ::= "search" "your" "library"

/* @sem EventSpec::AnyOf([Player{event:$player_event_third, players:$event_choice_player}, Player{event:$player_event_third_second, players:$event_choice_player}, Player{event:$player_event_third_third, players:$event_choice_player}]) */
event_player_choice_third ::= event_choice_player player_event_third "," player_event_third_second "," "or" player_event_third_third

/* @sem PlayerSet::OpponentsOf(AbilityController) */
event_choice_player ::= "an" "opponent"

player_event_third_second ::= player_event_third

player_event_third_third ::= player_event_third

player_event_third ::= player_event_scry_third | player_event_surveil_third | player_event_search_third

/* @sem PlayerEvent::Scries */
player_event_scry_third ::= "scries"

/* @sem PlayerEvent::Surveils */
player_event_surveil_third ::= "surveils"

/* @sem PlayerEvent::SearchesLibrary */
player_event_search_third ::= "searches" "their" "library"

/* A transform's subject and the action performed as it transforms are independent. */
/* @sem Ability::AsEvent{object:$object_ref, event:Transforms, actions:List([$transform_as_action])} */
as_transform_action ::= "as" object_ref "transforms" "into" transform_as_action "."

transform_as_action ::= transform_choose_player | transform_attach_player

/* The name denotes the face, while the choice retains its player population. */
/* @sem Operand::Term{family:TransformAction, form:ChooseAPlayer, operands:[Players($transform_player_choice)]} */
transform_choose_player ::= SELF_NAME "," "choose" transform_player_choice

/* @sem Operand::Term{family:TransformAction, form:AttachPermanentToAPlayer, operands:[Object($object_ref), Players($transform_player_choice)]} */
transform_attach_player ::= object_ref "," "attach" "it" "to" transform_player_choice

transform_player_choice ::= transform_any_player | transform_opponent | transform_active_opponent | transform_chosen_opponent

/* @sem PlayerSet::All */
transform_any_player ::= "a" "player"

/* @sem PlayerSet::OpponentsOf(PlayerRef::AbilityController) */
transform_opponent ::= "an" "opponent"

/* @sem PlayerSet::OpponentsOf(PlayerRef::Active) */
transform_active_opponent ::= "an" "opponent" "of" "the" "active" "player"

/* @sem PlayerSet::OpponentsOf(PlayerRef::Chosen) */
transform_chosen_opponent ::= "an" "opponent" "of" "the" "chosen" "player"

/* Typed history event phrases keep the actor and object filter explicit. */
/* @sem EventSpec::Player{event:CreatesToken, players:One(AbilityController), objects:Any} */
history_token_event ::= "you" "created"

/* @sem EventSpec::Player{event:Draws, players:One(AbilityController)} */
history_draw_event ::= "you" "drew"

/* @sem EventSpec::Player{event:LosesLife, players:One(AbilityController)} */
history_life_loss_event ::= "you" "lost"

/* @sem EventSpec::Object{event:LeavesGraveyard, objects:InZone(Players{zone:Graveyard, players:One(AbilityController)})} */
history_graveyard_departure ::= "left" "your" "graveyard"

/* @sem EventSpec::Player{event:Sacrifices, players:One(AbilityController), objects:$filter_phrase} */
history_sacrifice_event ::= "you've" "sacrificed" "a" filter_phrase

/* Past actions carry their actor and any object filter independently. */
past_you_event ::= past_you_lost_life | past_you_surveilled | past_you_visited_attraction | past_you_sacrificed_permanent | past_you_sacrificed_an

/* @sem EventSpec::Player{event:LosesLife, players:One(AbilityController)} */
past_you_lost_life ::= "lost" "life"

/* @sem EventSpec::Player{event:Surveils, players:One(AbilityController)} */
past_you_surveilled ::= "surveilled"

/* @sem EventSpec::Player{event:VisitsAttraction, players:One(AbilityController), objects:Any} */
past_you_visited_attraction ::= "visited" "an" "Attraction"

/* @sem EventSpec::Player{event:Sacrifices, players:One(AbilityController), objects:Any} */
past_you_sacrificed_permanent ::= "sacrificed" "a" "permanent"

/* @sem EventSpec::Player{event:Sacrifices, players:One(AbilityController), objects:$filter_phrase} */
past_you_sacrificed_an ::= "sacrificed" "an" filter_phrase

/* @sem EventSpec::Player{event:RollsADie, players:One(AbilityController)} */
past_you_roll_event ::= "rolled"

/* The other event participant is the enlisted creature. */
/* @sem EventSpec::Pair{event:Enlists, objects:$event_self, others:$filter_phrase} */
event_enlists_filtered ::= event_self "enlists" "a" filter_phrase

/* @sem Program::Program{instructions:$instructions_may_conjure_duplicate_change} */
program_enlist_conjure_duplicate ::= instructions_may_conjure_duplicate_change

/* @sem Ability::Triggered{event:$event_enlists_filtered, limits:TriggerLimits{}, announcement:@announcement, body:$program_enlist_conjure_duplicate} */
triggered_enlist_conjure_duplicate ::= "whenever" event_enlists_filtered "," program_enlist_conjure_duplicate "."

/* Attachment events retain the host as EventOther for the triggered body. */
/* @sem EventSpec::Pair{event:EntersAttachedTo, objects:SameObject(Source), others:CardType(Creature)} */
attachment_aura_enters_creature ::= "when" self_aura "enters" "attached" "to" "a" "creature"

/* @sem EventSpec::Pair{event:BecomesAttachedTo, objects:SameObject(Source), others:CardType(Creature)} */
attachment_equipment_becomes_creature ::= "whenever" self_equipment "becomes" "attached" "to" "a" "creature"

/* The amount refers to the counters tested on the departing event subject.
   Keep the condition and count together so no unrelated antecedent can print. */
/* @sem Ability::Triggered{event:$counter_departure_clause, intervening_if:ObjectMatches{object:EventSubject, filter:Counters{comparison:Greater, value:Constant(0)}}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:CountCounters{recipients:Objects(One(EventSubject)), information:CurrentOrLastKnown}}]}}]}}]}} */
triggered_departure_counter_transfer ::= counter_departure_clause "," "if" "it" "had" "one" "or" "more" "counters" "on" "it" "," "you" "may" "put" "that" "number" "of" counter_kind "counters" "on" affected "."

/* @sem $event_put_graveyard */
