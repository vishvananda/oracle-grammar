/* @sem EventSpec::AnyOf([Object{event:$shared_state_event, objects:$event_singular_subject}, Damage(_{source_kind:Any, sources:Any, recipients:Objects($event_singular_subject), kind:$shared_damage_kind, grouping:Recipient, subject:Recipient})]) */
