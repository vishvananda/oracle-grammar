/* @sem @and($spell_filter, $third_cast_spell_qualifier) */
third_cast_qualified_spell ::= spell_filter third_cast_spell_qualifier

third_cast_spell_qualifier ::= third_cast_unowned | cast_property_equal | cast_three_properties_equal

/* @sem ObjectFilter::OwnedBy(OthersThan(Prior(That))) */
third_cast_unowned ::= "they" "don't" "own"

/* @sem ObjectFilter::Property{property:$cast_property, test:NumberTest::Compare{comparison:Equal, value:$cast_comparison_value}} */
cast_property_equal ::= "with" cast_property "equal" "to" cast_comparison_value

/* @sem ObjectFilter::AnyOf([Property{property:$cast_property, test:NumberTest::Compare{comparison:Equal, value:$cast_comparison_value}}, Property{property:$cast_property_2, test:NumberTest::Compare{comparison:Equal, value:$cast_comparison_value}}, Property{property:$cast_property_3, test:NumberTest::Compare{comparison:Equal, value:$cast_comparison_value}}]) */
cast_three_properties_equal ::= "with" cast_property "," cast_property "," "or" cast_property "equal" "to" cast_comparison_value

