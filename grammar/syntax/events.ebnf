/* The repeated nonland restriction proves that X counts this mill event's
   filtered batch; no unrelated event may supply this EventAmount. */
/* @sem Ability::Triggered{event:Batch{event:Player{event:MillsCard, players:All, objects:Not(CardType(Land))}, per:Whole}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(EventAmount), filter:$filter_plural}))), kind:$counter_kind, amount:Constant(1)}]}}]}} */
triggered_nonland_mill_batch_counters ::= "whenever" "one" "or" "more" "nonland" "cards" "are" "milled" "," "put" "a" counter_kind "counter" "on" "each" "of" "up" "to" "X" "target" filter_plural "," "where" "X" "is" "the" "number" "of" "nonland" "cards" "milled" "this" "way" "."

/* Singular excess damage retains the damaged object's identity and the kind. */
