/* @sem EventSpec::ZoneChange{objects:$event_object, from:Battlefield, to:Exile} */
event_exiled_from_battlefield ::= event_object "is" "exiled" "from" "the" "battlefield"

/* The same plural population is observed for each alternative whole batch. */
