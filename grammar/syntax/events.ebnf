/* A simultaneous batch preserves the discarding players and the card filter. */
/* @sem EventSpec::Batch{event:Discard(_{players:$combat_batch_recipients, cards:$batch_discard_cards, kind:Any, grouping:Player}), per:Whole} */
event_batch_discard ::= combat_batch_recipients "discard" "one" "or" "more" batch_discard_cards

batch_discard_cards ::= batch_discard_any_cards | batch_discard_filtered_cards

/* @sem ObjectFilter::Any */
batch_discard_any_cards ::= "cards"

/* @sem $card_filter */
batch_discard_filtered_cards ::= card_filter "cards"

/* The filter describes the card that was played, including lands. */
/* @sem PlayerHistory::PlayedFromExile($played_card_filter) */
played_from_exile_history ::= "play" "a" played_card_filter "from" "exile"

played_card_filter ::= played_any_card | played_filtered_card

/* @sem ObjectFilter::Any */
played_any_card ::= "card"

/* @sem $card_filter */
played_filtered_card ::= card_filter "card"

/* The first occurrence is tracked for each event subject independently. */
/* @sem EventSpec::FirstForObjectEachTurn($first_object_event) */
event_first_for_object_each_turn ::= first_object_event "for" "the" "first" "time" "each" "turn"

first_object_event ::= first_object_action_event | first_object_damage_players | first_object_unspecified_counters | event_referenced_counters_put

first_object_action ::= first_object_saddled | first_object_mutates | first_object_monstrous

/* @sem ObjectEvent::BecomesSaddled */
first_object_saddled ::= "becomes" "saddled"

/* @sem ObjectEvent::Mutates */
first_object_mutates ::= "mutates"

/* @sem ObjectEvent::BecomesMonstrous */
first_object_monstrous ::= "becomes" "monstrous"

/* @sem PlayerEvent::VisitsAttraction */
you_object_action_visit ::= "visit"

/* An attack event can itself cause an ability of its attacking creature to trigger. */
/* @sem EventSpec::Attack{attackers:$filter_phrase, defenders:Any} */
attack_as_trigger_cause ::= "a" filter_phrase "attacking"

/* @sem EventSpec::CausesTrigger{cause:$trigger_cause_creature, own_ability:true} */
event_causes_own_trigger ::= trigger_cause_creature "causes" "a" "triggered" "ability" "of" "that" "creature" "to" "trigger"

/* Both participants are independently filtered; the event's other object
   remains available to the trigger body as EventOther. */
/* @sem EventSpec::Pair{event:BecomesUnattachedFrom, objects:$event_singular_subject, others:$event_a} */
event_becomes_unattached ::= event_singular_subject "becomes" "unattached" "from" event_a

/* The detached host is the event's second object, not a combat pair. */
/* @sem Ability::Triggered{event:$event_becomes_unattached, limits:TriggerLimits{}, announcement:@announcement, body:$unattached_host_program} */
triggered_unattached_host ::= "whenever" event_becomes_unattached "," unattached_host_program

unattached_host_program ::= unattached_host_sacrifice | unattached_host_destroy

/* The subject is an owned object, independent of its controller. */
/* @sem EventSpec::ZoneChange{objects:$event_owned, to:Command} */
event_owned_put_command_anywhere ::= event_owned "is" "put" "into" "the" "command" "zone" "from" "anywhere"

/* The step and actor are tied to the ability controller; the population is shared with tap events. */
/* @sem EventSpec::Player{event:$own_untap_step_event, players:One(AbilityController), objects:$tap_event_plural} */
event_you_untap_in_own_step ::= "you" "untap" tap_event_plural own_untap_step_event

/* @sem PlayerEvent::UntapsDuringUntapStep */
own_untap_step_event ::= "during" "your" "untap" "step"

/* The entering objects and their controller are independent operands. */
/* @sem EventSpec::Player{event:EntersUnplayed, players:$unplayed_entry_controller, objects:$filter_plural} */
event_unplayed_entry ::= "one" "or" "more" filter_plural "enter" "under" unplayed_entry_controller "control" "without" "being" "played"

unplayed_entry_controller ::= unplayed_entry_opponent | unplayed_entry_you | unplayed_entry_player

/* @sem PlayerSet::OpponentsOf(PlayerRef::AbilityController) */
unplayed_entry_opponent ::= "an" "opponent's"

/* @sem PlayerSet::One(PlayerRef::AbilityController) */
unplayed_entry_you ::= "your"

/* @sem PlayerSet::All */
unplayed_entry_player ::= "a" "player's"

/* @sem EventSpec::Player{event:Investigates, players:One(PlayerRef::AbilityController)} */
event_you_investigate ::= "you" "investigate"

/* The payer and the object whose upkeep is paid remain separate operands. */
/* @sem EventSpec::Player{event:PaysCumulativeUpkeep, players:One(AbilityController), objects:SameObject($self_possessive)} */
event_you_pay_cumulative_upkeep ::= "you" "pay" self_possessive "cumulative" "upkeep"

/* The source zone's owner and the moved card filter are independent operands. */
/* @sem EventSpec::Batch{event:ZoneChange{objects:@and($exiled_batch_card_filter, ObjectFilter::OwnedBy(One(PlayerRef::AbilityController))), from:$greatest_card_zone, to:Exile}, per:Whole} */
event_owned_cards_to_exile ::= "one" "or" "more" exiled_batch_card_filter "are" "put" "into" "exile" "from" "your" greatest_card_zone

exiled_batch_card_filter ::= exiled_batch_any_cards | exiled_batch_filtered_cards

/* @sem ObjectFilter::Any */
exiled_batch_any_cards ::= "cards"

/* @sem $card_filter */
exiled_batch_filtered_cards ::= card_filter "cards"

/* A drawing event and the holder of the triggered ability are independent. */
/* @sem EventSpec::Player{event:Draws, players:$event_player} */
retrigger_drawing_cause ::= event_player "drawing" "a" "card"

/* @sem Ability::TriggerRule{cause:$retrigger_drawing_cause, abilities:AbilityOf($retrigger_holder), rule:TriggersAgain} */
ability_drawing_causes_retrigger ::= "if" retrigger_drawing_cause "causes" "a" "triggered" "ability" "of" retrigger_holder "to" "trigger" "," "that" "ability" "triggers" "an" "additional" "time" "."

/* The first-occurrence condition repeats the exact counter kind and refers to
   the same permanent as the batch event. Keep both halves in one event phrase. */
/* @sem EventSpec::FirstForObjectEachTurn(Batch{event:Counters{change:Put, kind:PowerToughness(1, 1), objects:$first_counter_permanent}, per:Subject}) */
first_counters_on_permanent_clause ::= ("when" | "whenever") "one" "or" "more" "+" "1" "/" "+" "1" "counters" "are" "put" "on" first_counter_permanent "," "if" "it's" "the" "first" "time" "+" "1" "/" "+" "1" "counters" "have" "been" "put" "on" "that" "permanent" "this" "turn"

first_counter_permanent ::= first_counter_other_controlled_permanent | first_counter_controlled_permanent

/* @sem @and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), ObjectFilter::ControlledBy(PlayerSet::One(PlayerRef::AbilityController))) */
first_counter_other_controlled_permanent ::= "another" "permanent" "you" "control"

/* @sem ObjectFilter::ControlledBy(PlayerSet::One(PlayerRef::AbilityController)) */
first_counter_controlled_permanent ::= "a" "permanent" "you" "control"

/* @sem EventSpec::FirstEachTurn($event_you_create_token_batch) */
event_first_each_turn_batch ::= event_you_create_token_batch "for" "the" "first" "time" "each" "turn"

/* @sem EventSpec::Batch{event:Player{event:CreatesToken, players:One(PlayerRef::AbilityController), objects:Any}, per:Whole} */
event_you_create_token_batch ::= "you" "create" "one" "or" "more" "tokens"

/* The keyword identifies the activated ability on the stack; its source is
   separately identified so neither the activator nor holder is inferred. */
/* @sem EventSpec::Activated{players:One(AbilityController), abilities:AllOf([OnStack(Keyword($activation_keyword)), AbilityOf($activation_ability_holder)])} */
event_you_activate_source_keyword ::= "you" "activate" activation_ability_holder activation_keyword "ability"

/* @sem ObjectFilter::SameObject(Source) */
activation_ability_holder ::= "this" "creature's"

activation_keyword ::= activation_keyword_outlast | activation_keyword_equip | activation_keyword_ninjutsu

/* @sem AbilityKeyword::Outlast */
activation_keyword_outlast ::= "outlast"

/* @sem AbilityKeyword::Equip */
activation_keyword_equip ::= "equip"

/* @sem AbilityKeyword::Ninjutsu */
activation_keyword_ninjutsu ::= "ninjutsu"

/* A singular subject is shared by each independently named object event. */
/* @sem EventSpec::AnyOf(@unordered([Object{event:$object_event_choice_third, objects:$event_singular_subject}, Object{event:$object_event_choice_third_second, objects:$event_singular_subject}])) */
event_object_choice_third ::= event_singular_subject object_event_choice_third "or" object_event_choice_third_second

object_event_choice_third_second ::= object_event_choice_third

object_event_choice_third ::= object_event_choice_specializes | object_event_choice_attacks | object_event_choice_blocks

/* @sem ObjectEvent::Specializes */
object_event_choice_specializes ::= "specializes"

/* @sem ObjectEvent::Attacks */
object_event_choice_attacks ::= "attacks"

/* @sem ObjectEvent::Blocks */
object_event_choice_blocks ::= "blocks"

/* Singular controlled subjects and their object events compose independently. */
/* @sem EventSpec::Object{event:$singular_object_action, objects:$controlled_entrant} */
event_controlled_object_action ::= controlled_entrant singular_object_action

singular_object_action ::= singular_object_leaves_without_dying | singular_object_leaves_if_not_die | singular_object_leaves

/* @sem ObjectEvent::LeavesWithoutDying */
/* @prefer always */
singular_object_leaves_without_dying ::= "leaves" "the" "battlefield" "without" "dying"

/* @sem ObjectEvent::LeavesBattlefield */
singular_object_leaves ::= "leaves" "the" "battlefield"

/* The chosen-value predicate identifies the previously chosen player. */
/* @sem PlayerSet::Matching{binding:0, condition:ValueChosenIs(Bound(0))} */
event_chosen_value_player ::= "the" "chosen" "player"

event_losing_player ::= event_player | event_chosen_value_player

/* A singular subject shares its identity across entry and a state transition. */
/* @sem EventSpec::AnyOf([ZoneChange{objects:$event_singular_subject, to:Battlefield}, Object{event:$event_object_transition, objects:$event_singular_subject}]) */
event_enters_or_object_transition ::= event_singular_subject "enters" "or" event_object_transition

event_object_transition ::= event_transition_tapped | event_transition_untapped | event_transition_attacks

/* @sem ObjectEvent::BecomesTapped */
event_transition_tapped ::= "becomes" "tapped"

/* @sem ObjectEvent::BecomesUntapped */
event_transition_untapped ::= "becomes" "untapped"

/* Independent event subjects retain their own filters in the disjunction. */
/* @sem EventSpec::Object{event:Transforms, objects:$event_a} */
event_filtered_transforms ::= event_a "transforms"

event_filtered_enters_transformed ::= transformed_entry_plain | transformed_entry_controlled

/* @sem EventSpec::ZoneChange{objects:@and($event_a, ObjectFilter::State(Transformed)), to:Battlefield} */
transformed_entry_plain ::= event_a "enters" "transformed"

/* @sem EventSpec::Player{event:EntersUnderControl, players:All, objects:@and($controlled_entrant, ObjectFilter::State(Transformed))} */
transformed_entry_controlled ::= controlled_entrant "enters" "transformed"

/* @sem EventSpec::@either_event($event_filtered_transforms, $event_filtered_enters_transformed) */
event_transform_or_transformed_entry ::= event_filtered_transforms "or" event_filtered_enters_transformed

/* The first occurrence wraps the independently modeled card movement batch. */
/* @sem EventSpec::FirstEachTurn($event_cards_put_into_your_graveyard) */
event_first_cards_to_your_graveyard ::= event_cards_put_into_your_graveyard "for" "the" "first" "time" "each" "turn"

/* A gerund event can qualify a triggered ability independently of its holder. */
/* @sem EventSpec::ZoneChange{objects:$filter_phrase, from:Battlefield, to:Graveyard} */
trigger_cause_dying ::= ("a" | "an") filter_phrase "dying"

/* A holder transforming into this face can also be used as one branch of a
   combined trigger; both branches retain the holder as their subject. */
/* @sem EventSpec::Object{event:Transforms, objects:$event_holder} */
event_holder_transforms_into_face ::= event_holder "transforms" "into" SELF_NAME

/* @sem EventSpec::@either_event($event_holder_transforms_into_face, EventSpec::ZoneChange{objects:SameObject(ObjectRef::Source), from:Battlefield, to:Graveyard}) */
event_holder_transforms_into_face_or_dies ::= event_holder_transforms_into_face "or" "dies"

/* Either the referenced object or the creature it equips is the event subject.
   The action is shared so the same subject construction composes with each
   supported singular object event. */
/* @sem EventSpec::AnyOf([Object{event:$singular_combat_event, objects:SameObject($object_ref)}, Object{event:$singular_combat_event, objects:SameObject(AttachedTo($object_ref))}]) */
event_reference_or_equipped_action ::= object_ref "or" "equipped" "creature" singular_combat_event

singular_combat_event ::= singular_combat_attacks | singular_combat_blocks | singular_combat_blocked

/* @sem ObjectEvent::Attacks */
singular_combat_attacks ::= "attacks"

/* @sem ObjectEvent::Blocks */
singular_combat_blocks ::= "blocks"

/* @sem ObjectEvent::BecomesBlocked */
singular_combat_blocked ::= "becomes" "blocked"

/* @sem PlayerHistory::PermanentEntered(AllOf([Not(SameObject(Source)), $filter_phrase])) */
historical_entry_under_your_control ::= "another" filter_phrase "enter" "the" "battlefield" "under" "your" "control"

/* An activation qualifier wraps an independently represented event. */
/* @sem EventSpec::WhileActivating{event:$event_during_activation, players:One(AbilityController), abilities:OnStack(Keyword(Craft))} */
event_while_you_activate ::= event_during_activation "while" "you're" "activating" "a" "craft" "ability"

event_during_activation ::= event_exiled_from_battlefield | event_dies | event_enters

/* @sem EventSpec::ZoneChange{objects:$exiled_battlefield_subject, from:Battlefield, to:Exile} */
event_exiled_from_battlefield ::= exiled_battlefield_subject "is" "exiled" "from" "the" "battlefield"

/* The same plural population is observed for each alternative whole batch. */
/* @sem EventSpec::AnyOf([Batch{event:Object{event:$batch_object_action, objects:$batch_object_filter}, per:Whole}, Batch{event:Object{event:$batch_object_action_second, objects:$batch_object_filter}, per:Whole}]) */
event_clause_batch_alternatives ::= "whenever" "one" "or" "more" batch_object_filter batch_object_action "or" batch_object_action_second

/* The inverse also enumerates the other surface order of the unordered events. */
/* @sem EventSpec::AnyOf([Batch{event:Object{event:$batch_object_action_second, objects:$batch_object_filter}, per:Whole}, Batch{event:Object{event:$batch_object_action, objects:$batch_object_filter}, per:Whole}]) */
event_clause_batch_alternatives_reversed ::= "whenever" "one" "or" "more" batch_object_filter batch_object_action "or" batch_object_action_second

batch_object_action_second ::= batch_object_action

/* @sem ObjectEvent::Fights */
batch_object_fights ::= "fight"

/* A single third-person actor supplies both alternatives. */
/* @sem EventSpec::AnyOf([Discard(_{players:$event_player, cards:Any, kind:Any, grouping:Card}), Player{event:Mills, players:$event_player}]) */
event_discard_or_mill_third ::= event_player "discards" "a" "card" "or" "mills" "one" "or" "more" "cards"

/* A list of subtype alternatives shares the written spell domain. */
/* @sem @and(ObjectFilter::AnyOf(@unordered([$subtype_spelled, $subtype_spelled_2, $subtype_spelled_3])), $spell_domain_atomic) */
spell_subtype_list_domain ::= subtype_spelled "," subtype_spelled "," "or" subtype_spelled spell_domain_atomic

/* Each spell branch retains its own suffix qualification. */
/* @sem ObjectFilter::AnyOf([$spell_bare_plain, $spell_bare_modified]) */
spell_union ::= "a" spell_bare_plain "or" spell_bare_modified

/* @sem $spell_adjectives */
spell_bare_plain ::= spell_adjectives "spell"

/* @sem @and($spell_adjectives, $cast_spell_qualifier) */
spell_bare_modified ::= spell_adjectives "spell" cast_spell_qualifier

/* @sem PlayerSet::One(PlayerRef::Chosen) */
event_chosen_player ::= "the" "chosen" "player"

/* These operands qualify the spell being cast. */
cast_spell_filter ::= cast_spell_parity | spell_filter | cast_another_qualified_spell | cast_spell_described | cast_spell_subtype_list | spell_union | cast_spell_qualified_any | cast_spell_union_articles

/* @sem @and($spell_adjectives, $cast_spell_qualifier) */
cast_spell_described ::= "a" spell_adjectives "spell" cast_spell_qualifier

/* @sem $spell_subtype_list_domain */
cast_spell_subtype_list ::= "a" spell_subtype_list_domain "spell"

cast_spell_qualifier ::= cast_spell_has_adventure | cast_spell_one_chosen_names | cast_spell_doctors_companion | cast_spell_power_choices | cast_spell_not_owned | cast_spell_convoke | cast_spell_not_starting_deck | cast_spell_color_count | cast_spell_hand_history

/* @sem EventSpec::Spell{event:Cast, players:$event_chosen_player, spells:Any} */
event_chosen_player_cast ::= event_chosen_player "casts" "a" "spell"

/* Spell and card qualifiers retain their independent filter operands. */
/* @sem ObjectFilter::State(HasAdventure) */
cast_spell_has_adventure ::= "that" "has" "an" "Adventure"

/* @sem ObjectFilter::Chosen(CardName) */
cast_spell_one_chosen_names ::= "with" "one" "of" "the" "chosen" "names"

/* @sem ObjectFilter::HasKeywordFamily(DoctorsCompanion) */
cast_spell_doctors_companion ::= "with" "doctor's" "companion"

/* @sem ObjectFilter::Property{property:$stat_power, test:NumberTest::AnyOf([NumberTest::Compare{comparison:Equal, value:$value}, NumberTest::Compare{comparison:Equal, value:$value_2}, NumberTest::Compare{comparison:Equal, value:$value_3}])} */
cast_spell_power_choices ::= "with" stat_power value "," value "," "or" value

/* A sacrifice names the exact object independently of the event context. */
/* @sem ObjectFilter::SameObject($object_ref) */
sacrificed_reference ::= "sacrifice" object_ref

/* @sem EventSpec::Player{event:SacrificesForEmerge, players:One(AbilityController), objects:$sacrificed_reference} */
event_you_sacrifice_reference_for_emerge ::= "you" sacrificed_reference "while" "casting" "a" "spell" "with" "emerge"

/* @sem EventSpec::@either_event($event_when, $event_you_solve_case) */
event_when_and_whenever_solve_case ::= event_when "and" "whenever" event_you_solve_case

/* @sem EventSpec::Player{event:SolvesCase, players:One(AbilityController)} */
event_you_solve_case ::= "you" "solve" "a" "Case"

/* The two holders retain their independent object and filter operands. */
/* @sem ObjectFilter::AbilityOf(AnyOf([SameObject($object_ref), $filter_phrase])) */
retrigger_object_or_attached ::= object_ref "or" "an" filter_phrase

/* The event cause is independent of the holder of an ability it triggers. */
/* @sem EventSpec::Object{event:TurnsFaceUp, objects:AllOf([$filter_phrase, Any])} */
retrigger_turning_face_up ::= "turning" "a" filter_phrase "face" "up"

/* A player attack is grouped by the attacked player; its condition is an
   event filter, not an intervening-if on the resulting ability. */
/* @sem EventSpec::Batch{event:Attack{attackers:Any, by:$event_player, defenders:Players(One(AbilityController))}, per:Defender} */
event_player_attacks_you_batch ::= event_player "attacks" "you"

/* @sem EventSpec::Filtered{event:$event_player_attacks_you_batch, condition:$condition} */
event_player_attacks_you_while ::= event_player_attacks_you_batch "while" condition

/* @sem EventSpec::Caused{cause:$caused_spell_ability, event:$caused_card_exile_batch} */
event_caused_card_exile ::= caused_spell_ability "causes" caused_card_exile_batch

/* @sem ObjectFilter::ControlledBy(One(PlayerRef::AbilityController)) */
caused_spell_ability_you ::= "a" "spell" "or" "ability" "you" "control"

/* @sem ObjectFilter::ControlledBy(OpponentsOf(PlayerRef::AbilityController)) */
caused_spell_ability_opponent ::= "a" "spell" "or" "ability" "an" "opponent" "controls"

caused_spell_ability ::= caused_spell_ability_you | caused_spell_ability_opponent

/* @sem EventSpec::Batch{event:ZoneChange{objects:$caused_card_owner, from:$caused_card_origin, to:Exile}, per:Whole} */
caused_card_exile_batch ::= "one" "or" "more" "cards" "to" "be" "exiled" "from" caused_card_owner caused_card_origin

/* @sem ObjectFilter::OwnedBy(OpponentsOf(PlayerRef::AbilityController)) */
caused_card_owner_opponent ::= "an" "opponent's"

caused_card_owner ::= caused_card_owner_opponent

/* @sem Zone::Library */
caused_card_origin_library ::= "library"

/* @sem Zone::Graveyard */
caused_card_origin_graveyard ::= "graveyard"

caused_card_origin ::= caused_card_origin_library | caused_card_origin_graveyard

/* Extend the same object event with a player recipient; the actor remains the controller. */
/* @sem EventSpec::AnyOf([$event_you_put_unspecified_counters, CountersOnPlayer{by:One(AbilityController), players:All}]) */
event_you_put_counters_or_player ::= event_you_put_unspecified_counters "or" "player"

/* The land and spell alternatives retain their independent filters. */
/* @sem EventSpec::@either_event(EventSpec::Player{event:PlaysLand, players:$land_play_you, objects:$played_land_filter}, EventSpec::Spell{event:Cast, players:$land_play_you, spells:$land_spell_cast_filter}) */
event_filtered_land_or_spell_you ::= land_play_you played_land_filter "or" "cast" land_spell_cast_filter

/* Each alternative retains its own event subject; the shared verb applies to both. */
/* @sem EventSpec::@either_event(EventSpec::Object{event:AttacksAlone, objects:$event_referenced_subject}, EventSpec::Object{event:AttacksAlone, objects:$filter_phrase}) */
event_referenced_or_indefinite_attacks_alone ::= event_referenced_subject "or" "a" filter_phrase "attacks" "alone"

/* A cause and its event remain independent semantic operands. */
/* @sem EventSpec::Caused{cause:$event_cause, event:$caused_event} */
event_caused_by_spell_or_ability ::= event_cause "causes" caused_event

event_cause ::= event_cause_opponent | event_cause_you

/* @sem ObjectFilter::ControlledBy(OpponentsOf(PlayerRef::AbilityController)) */
event_cause_opponent ::= "a" "spell" "or" "ability" "an" "opponent" "controls"

/* @sem ObjectFilter::ControlledBy(One(PlayerRef::AbilityController)) */
event_cause_you ::= "a" "spell" "or" "ability" "you" "control"

/* @sem EventSpec::ZoneChange{objects:@and($filter_phrase, ObjectFilter::OwnedBy(One(PlayerRef::AbilityController))), from:Battlefield, to:Graveyard} */
caused_event ::= "a" filter_phrase "to" "be" "put" "into" "your" "graveyard" "from" "the" "battlefield"

/* The attachment host and the action are independently composable operands. */
/* @sem Ability::AsEvent{object:$object_ref, event:$as_attachment_event, actions:List([$as_attachment_action])} */
as_attachment_ability ::= "as" object_ref as_attachment_event "," as_attachment_action "."

as_attachment_event ::= as_attachment_event_a | as_attachment_event_an

/* @sem AsEvent::BecomesAttachedTo($filter_phrase) */
