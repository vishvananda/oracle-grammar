event_controller_combat_subtype_group ::= "a" combat_source_subtype_group "you" "control" "deals" "combat" "damage" "to" "a" "player"

/* Both event alternatives are restricted to the same linked exile population. */
/* @sem EventSpec::AnyOf([Player{event:PlaysLandFromExile, players:One(AbilityController), objects:AllOf([CardType(Land), InSet(Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($self_explicit_ref)}))])}, Spell{event:Cast, players:One(AbilityController), spells:AllOf([$land_spell_cast_filter, CastFromAmong(Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($self_explicit_ref)}))])}]) */
event_land_spell_linked_exile ::= "you" "play" "a" "land" "or" "cast" land_spell_cast_filter "from" "among" "cards" "exiled" "with" self_explicit_ref

/* The active opponent supplies the subject of this turn event. */
/* @sem PlayerSet::OpponentsOf(PlayerRef::AbilityController) */
owner_your_opponents ::= "your" "opponents'"

/* The plural pronoun in the payment refers to the opposing turn player. */
/* @sem EventSpec::Turn{point:EndStepBegins, players:$owner_your_opponents} */
opponents_end_event ::= "the" "beginning" "of" owner_your_opponents "end" "step"

/* @sem EventSpec::Turn{point:UpkeepBegins, players:$owner_your_opponents} */
opponents_upkeep_event ::= "the" "beginning" "of" owner_your_opponents "upkeep"

opponents_turn_event ::= opponents_end_event | opponents_upkeep_event

/* @sem Ability::Triggered{event:$opponents_turn_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$event_subject_optional_payment}} */
triggered_opponents_optional_payment ::= "at" opponents_turn_event "," event_subject_optional_payment "."

/* A control-loss event retains the player and the specific object independently. */
event_control_loss_base_subject ::= player_rule_you | player_keyword_many

/* @sem EventSpec::Player{event:LosesControl, players:$event_control_loss_base_subject, objects:SameObject($object_ref)} */
event_control_loss_base ::= event_control_loss_base_subject "lose" "control" "of" object_ref

/* @sem EventSpec::Player{event:LosesControl, players:$players_singular, objects:SameObject($object_ref)} */
event_control_loss_third ::= players_singular "loses" "control" "of" object_ref

/* A singular card departure keeps its filter and its graveyard owner distinct. */
/* @sem EventSpec::Object{event:LeavesGraveyard, objects:AllOf([$graveyard_vowel_card_filter, InZone(Players{zone:Graveyard, players:One(AbilityController)})])} */
whenever_filtered_card_leaves_your_graveyard ::= "whenever" "an" graveyard_vowel_card_filter "card" "leaves" "your" "graveyard"

graveyard_vowel_card_filter ::= filter_instant_or_sorcery | spell_instant | noun_artifact | noun_enchantment

/* Life lost in this body is the amount of this trigger's life-loss event. */
/* @sem Ability::Triggered{event:$event_you_lose_life, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$gain_per_life_lost_event}]}} */
triggered_gain_per_life_lost ::= "whenever" event_you_lose_life "," gain_per_life_lost_event "."

/* @sem Operation::GainLife{players:One(AbilityController), amount:@times($count, $life_lost_event_amount)} */
gain_per_life_lost_event ::= "you" "gain" count "life" life_lost_event_amount

/* Attachment choices retain the source and the host filter as separate operands. */
/* @sem Ability::AsEvent{object:$self_explicit_ref, event:BecomesAttachedTo($attached_choice_host), actions:List([$attach_choose_creature_name, $attach_second_choice])} */
as_attached_two_choices ::= "as" self_explicit_ref "becomes" "attached" "to" attached_choice_host "," attach_choose_creature_name "and" attach_second_choice "."

attach_second_choice ::= attach_choose_creature_type | attach_choose_color

/* @sem Operand::Term{family:AttachAction, form:ChooseACardName, operands:[Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Creature}]}]} */
attach_choose_creature_name ::= "choose" "a" "creature" "card" "name"

/* @sem Operand::Term{family:AttachAction, form:ChooseACreatureType} */
attach_choose_creature_type ::= "a" "creature" "type"

/* @sem Operand::Term{family:AttachAction, form:ChooseAColor, operands:[Term{family:ChoosableColor, form:AnyColor}]} */
attach_choose_color ::= "a" "color"

attached_choice_host ::= attached_choice_creature | attached_choice_land | attached_choice_artifact

/* @sem $noun_creature */
attached_choice_creature ::= "a" noun_creature

/* @sem $noun_land */
attached_choice_land ::= "a" noun_land

/* @sem $noun_artifact */
attached_choice_artifact ::= "an" noun_artifact

/* The location and event frame a counter-driven return program. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$graveyard_local_event, intervening_if:ObjectMatches{object:Source, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}, limits:TriggerLimits{}, announcement:@announcement, body:$graveyard_symbol_counter_program})} */
graveyard_symbol_counter_trigger ::= graveyard_local_event "," "if" "this" "card" "is" "in" "your" "graveyard" "," graveyard_symbol_counter_program "."

/* @sem Program::Program{instructions:[$graveyard_symbol_counter_put, $graveyard_counter_return_perpetual]} */
graveyard_symbol_counter_program ::= graveyard_symbol_counter_put "." graveyard_counter_return_perpetual

/* @sem Instruction::Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Source)), kind:$counter_kind, amount:CountManaSymbols{objects:One(EventSubject), colors:[$graveyard_count_symbol]}}]}} */
graveyard_symbol_counter_put ::= "put" "a" counter_kind "counter" "on" "this" "card" "for" "each" graveyard_count_symbol "in" "that" "spell's" "mana" "cost"

/* @sem Instruction::If{condition:Compare{left:CountCounters(_{recipients:Objects(Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:SameObject(Source)})), kind:$counter_kind, information:CurrentOrLastKnown}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, then:_{instructions:[Effect{result:@next, operation:Move{objects:One(Source), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:[Pump{power:$signed, toughness:$signed_2}]}}]}, otherwise:_{}} */
graveyard_counter_return_perpetual ::= "if" "this" "card" "has" number "or" "more" counter_kind "counters" "on" "it" "," "return" "it" "to" "the" "battlefield" "and" "it" "perpetually" "gets" signed "/" signed

graveyard_count_symbol ::= graveyard_symbol_white | graveyard_symbol_blue | graveyard_symbol_black | graveyard_symbol_red | graveyard_symbol_green

/* @sem ManaColor::White */
graveyard_symbol_white ::= "{" "W" "}"

/* @sem ManaColor::Blue */
graveyard_symbol_blue ::= "{" "U" "}"

/* @sem ManaColor::Black */
graveyard_symbol_black ::= "{" "B" "}"

/* @sem ManaColor::Red */
graveyard_symbol_red ::= "{" "R" "}"

/* @sem ManaColor::Green */
graveyard_symbol_green ::= "{" "G" "}"

/* A whole batch can combine an owned private-zone movement with a separately
   caused battlefield movement. Each branch keeps its own object filter. */
/* @sem EventSpec::Batch{event:AnyOf([$private_exile_batch_event, $controlled_exile_batch_event]), per:Whole} */
private_or_controlled_exile_batch_clause ::= "whenever" private_exile_batch_event "or" controlled_exile_batch_event

/* @sem EventSpec::ZoneChange{objects:$event_owned_cards, from:$private_exile_origin, to:Exile} */
private_exile_batch_event ::= "one" "or" "more" event_owned_cards "are" "put" "into" "exile" "from" "your" private_exile_origin

private_exile_origin ::= private_exile_hand | ordered_zone

/* @sem EventZone::Hand */
private_exile_hand ::= "hand"

/* @sem EventSpec::Caused{cause:ControlledBy(One(AbilityController)), event:ZoneChange{objects:$controlled_exile_permanents, from:Battlefield, to:Exile}} */
controlled_exile_batch_event ::= "a" "spell" "or" "ability" "you" "control" "exiles" "one" "or" "more" controlled_exile_permanents "from" "the" "battlefield"

controlled_exile_permanents ::= controlled_exile_any_permanents | controlled_exile_filtered_permanents

/* @sem ObjectFilter::Any */
controlled_exile_any_permanents ::= "permanents"

/* @sem $filter_plural */
controlled_exile_filtered_permanents ::= filter_plural

/* The canonical event union may present the same alternatives in reverse order. */
/* @sem EventSpec::Batch{event:AnyOf([$controlled_exile_batch_event, $private_exile_batch_event]), per:Whole} */
private_or_controlled_exile_batch_clause_reverse ::= "whenever" private_exile_batch_event "or" controlled_exile_batch_event

/* The combined event is the canonical inverse of the two independently bound triggers. */
/* @sem EventSpec::@either_event(EventSpec::Object{event:PhasesOut, objects:$event_self}, EventSpec::Object{event:LeavesBattlefield, objects:$event_self}) */
event_phases_out_or_leaves ::= event_self "phases" "out" "or" "leaves" "the" "battlefield"

/* A card's plotted trigger functions in every zone and owns its body and targets. */
/* @sem EventSpec::Object{event:Plotted, objects:SameObject(Source)} */
plotted_source_event ::= "when" "this" "card" "becomes" "plotted"

/* @sem Ability::Scoped{zones:[Battlefield, Graveyard, Hand, Library, Stack, Exile, Command, Ante], ability:@scope(Ability::Triggered{event:$plotted_source_event, limits:TriggerLimits{}, announcement:@announcement, body:$plotted_source_body})} */
plotted_source_trigger ::= plotted_source_event "," plotted_source_body

plotted_source_body ::= plotted_source_damage | program_sentence

/* The event introduces the source card, so its pronoun can name that source. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:$recipients, amount:$number, preventable:true}}]} */
plotted_source_damage ::= "it" "deals" number "damage" "to" recipients "."

/* Casting the holder from its graveyard makes the triggered ability graveyard-local. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$cast_source_from_graveyard_program})} */
graveyard_source_cast_trigger ::= event_clause "," cast_source_from_graveyard_program "."

/* A reveal-and-selection program can follow any supported event clause. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$revealed_type_program} */
triggered_revealed_type_program ::= event_clause "," revealed_type_program "."

/* The same holder is the attacking object and determines the defender. */
/* @sem Ability::Triggered{event:Object{event:Attacks, objects:SameObject(@self)}, limits:_{}, announcement:@announcement, body:$defending_choice_graveyard_draw} */
triggered_attack_defender_choice_draw ::= "whenever" self_holder_text "attacks" "," defending_choice_graveyard_draw

/* A batch of damage to opponents is grouped by the recipient event. */
/* @sem EventSpec::Damage(_{source_kind:Any, sources:Any, recipients:Players(OpponentsOf(AbilityController)), kind:$group_damage_kind, grouping:Batch, subject:Recipient}) */
event_opponents_passive_damage_batch ::= "your" "opponents" "are" "dealt" group_damage_kind

retirement_timed_event ::= retirement_attacks_you_or_self | retirement_combat_damage_self

/* @sem EventSpec::@either_event(EventSpec::Attack{attackers:$noun, defenders:Players(One(AbilityController))}, EventSpec::Attack{attackers:$noun, defenders:Objects(SameObject(Source))}) */
retirement_attacks_you_or_self ::= "a" noun "attacks" "you" "or" SELF_NAME

/* @sem EventSpec::Damage(DamageEvent{source_kind:Permanent, sources:$noun, recipients:Objects(SameObject(Source)), kind:Combat, grouping:SourceRecipient, subject:Source}) */
retirement_combat_damage_self ::= "a" noun "deals" "combat" "damage" "to" SELF_NAME

/* Damage source and recipient remain separate event identities. */
/* @sem ObjectFilter::@and($filter_phrase, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController)), ObjectFilter::State(PowerAboveBase)) */
event_above_base_controlled ::= "a" filter_phrase "you" "control" "with" "power" "greater" "than" "its" "base" "power"

/* One or more defending planeswalkers are part of the attack event, not a count of exiled cards. */
/* @sem EventSpec::Batch{event:Attack{attackers:Any, by:OpponentsOf(AbilityController), defenders:PlayersAndPlaneswalkers(One(AbilityController))}, per:Defender} */
event_opponent_attacks_you_walkers ::= "an" "opponent" "attacks" "you" "and" "/" "or" "one" "or" "more" "planeswalkers" "you" "control"

/* The matched owner phrase ties the library and graveyard to the same player. */
/* @sem EventSpec::ZoneChange{objects:AllOf([$library_graveyard_card_subject, $library_graveyard_owner]), from:Library, to:Graveyard} */
event_your_library_card_to_your_graveyard ::= library_graveyard_card_subject "card" "is" "put" "into" library_graveyard_owner

/* @prefer always */
/* @sem ObjectFilter::OwnedBy(One(PlayerRef::AbilityController)) */
library_graveyard_yours ::= "your" "graveyard" "from" "your" "library"

library_graveyard_card_subject ::= library_graveyard_card_a | library_graveyard_card_an

/* @sem $library_graveyard_card_a_type */
library_graveyard_card_a ::= "a" library_graveyard_card_a_type

/* @sem $library_graveyard_card_an_type */
library_graveyard_card_an ::= "an" library_graveyard_card_an_type

library_graveyard_card_a_type ::= library_graveyard_permanent | noun_creature | noun_land | noun_planeswalker | noun_battle

library_graveyard_card_an_type ::= noun_artifact | noun_enchantment

/* @sem ObjectFilter::AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]) */
library_graveyard_permanent ::= "permanent"

/* @sem EventSpec::Discard(_{players:One(AbilityController), cards:$adjective_nontype, kind:Any, grouping:Card}) */
event_discard_non_type_card ::= "you" "discard" "a" adjective_nontype "card"

/* The exclusion is the actual resolution payment's exile arrival, scoped with
   its producer. The source, source zone, filter and visibility remain operands. */
/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$linked_hand_exchange_program} */
linked_hand_exchange_trigger ::= "at" turn_event "," linked_hand_exchange_program

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Move{selections:[_{objects:Zone{scope:Players{zone:$hand_exile_zone, players:One(AbilityController)}, kind:Card, filter:$hand_exile_card_filter}}], destination:Exile{visibility:$hand_exile_visibility, arrival:ExileArrival{counters:[], states:[]}}}]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:Move{objects:Zone{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(One(AbilityController)), ExiledWith($self_explicit_ref), Not(InSet(CostObjects{payment:Resolution(0), component:[0], view:Performed, phase:After}))])}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{}}]} */
linked_hand_exchange_program ::= "you" "may" "exile" "all" hand_exile_card_filter "from" "your" hand_exile_zone hand_exile_visibility "." "if" "you" "do" "," "put" "all" "other" "cards" "you" "own" "exiled" "with" self_explicit_ref "into" "your" "hand" "."

/* @sem EventSpec::Object{event:Attacks, objects:$event_named} */
event_named_attack ::= event_named "attack"

/* A singular event subject retains the object that phased out. */
/* @sem EventSpec::Object{event:PhasesOut, objects:SameObject($object_ref)} */
event_phases_out ::= object_ref "phases" "out"

combat_damage_player_set ::= combat_damage_any_player | combat_damage_player_more_permanents | event_enchanted_player

/* @sem PlayerSet::All */
combat_damage_any_player ::= "a" "player"

/* @sem PlayerSet::Matching{binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}), test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])})}}} */
combat_damage_player_more_permanents ::= "a" "player" "who" "controls" "more" filter_plural "than" "you"

/* The cast spell is explicitly a planeswalker, which licenses its later
   planeswalker anaphor while retaining the subtype as an operand. */
/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:@and($subtype, ObjectFilter::CardType(Planeswalker))} */
event_cast_subtype_planeswalker ::= "you" "cast" "a" subtype "planeswalker" "spell"

/* @sem $event_cast_subtype_planeswalker */
when_cast_subtype_planeswalker ::= "when" event_cast_subtype_planeswalker

/* Both movements count cards owned by the ability controller. */
/* @sem Expr::EventHistory{event:AnyOf([ZoneChange{objects:OwnedBy(One(AbilityController)), from:Hand, to:Graveyard}, ZoneChange{objects:OwnedBy(One(AbilityController)), from:Library, to:Graveyard}]), window:ThisTurn, measure:Occurrences} */
graveyard_hand_library_history ::= "the" "number" "of" "cards" "that" "were" "put" "into" "your" "graveyard" "from" "your" "hand" "or" "library" "this" "turn"

/* Covercast operates while the card is outside the battlefield. Its cast event
   supplies the antecedent of the mana-spent condition. */
/* @sem Ability::Scoped{zones:[Hand, Library, Graveyard, Exile, Stack], ability:@scope(Ability::Triggered{event:$covercast_event, intervening_if:$covercast_mana_condition, limits:TriggerLimits{}, body:$covercast_program, announcement:@announcement})} */
covercast_trigger ::= "Covercast" "—" "whenever" covercast_event "," "if" covercast_mana_condition "," covercast_program

/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:@and($filter_phrase, ObjectFilter::Not(SameObject(Source)))} */
covercast_event ::= "you" "cast" "another" filter_phrase "spell"

/* @sem Condition::Compare{left:ManaSpent{object:EventSubject, filter:SpentManaFilter{}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$spent_least}} */
covercast_mana_condition ::= spent_least "mana" "was" "spent" "to" "cast" "it"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Intensify{cards:SameObject(Source), owner:AbilityController}}]} */
covercast_program ::= "this" "card" "intensifies" "."

/* The actor and the controller of the counter recipient are independent roles. */
/* @sem EventSpec::Counters{change:Put, kind:$counter_kind, objects:@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController))), by:One(AbilityController)} */
event_clause_you_put_single_counter_controlled ::= "whenever" "you" "put" "a" counter_kind "counter" "on" "a" filter_phrase "you" "control"

/* Explicit presence in the controller's graveyard scopes this trigger there. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$event_clause, intervening_if:$condition_self_in_your_graveyard_and, limits:TriggerLimits{}, announcement:@announcement, body:$graveyard_presence_body})} */
graveyard_presence_trigger ::= event_clause "," "if" condition_self_in_your_graveyard_and "," graveyard_presence_body

graveyard_presence_body ::= graveyard_trigger_cast_self | program_sentence

/* This source card's arrival in its owner's graveyard gives the trigger its
   graveyard scope; the resolution program remains independently composable. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$own_library_graveyard_event, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})} */
triggered_own_library_graveyard ::= own_graveyard_trigger_word own_library_graveyard_event "," program_sentence

own_graveyard_trigger_word ::= own_graveyard_when | own_graveyard_whenever

/* @prefer always */
/* @sem () */
own_graveyard_when ::= "when"

/* @sem () */
own_graveyard_whenever ::= "whenever"

/* @sem EventSpec::ZoneChange{objects:AllOf([SameObject(Source), OwnedBy(One(AbilityController))]), from:$own_graveyard_origin, to:Graveyard} */
own_library_graveyard_event ::= self_card "is" "put" "into" "your" "graveyard" "from" "your" own_graveyard_origin

own_graveyard_origin ::= own_graveyard_library | own_graveyard_hand

/* @sem Zone::Library */
own_graveyard_library ::= "library"

/* @sem Zone::Hand */
own_graveyard_hand ::= "hand"

/* @sem EventSpec::Damage{source_kind:Permanent, sources:SameObject($target_permanent), recipients:Objects($delayed_damage_recipient), kind:Combat, grouping:SourceRecipient, subject:Source} */
delayed_target_damage_event ::= target_permanent "deals" "combat" "damage" "to" "a" delayed_damage_recipient

/* @sem ObjectFilter::CardType(Creature) */
delayed_damage_recipient ::= "creature"

/* Compose a graveyard batch with the controller's turn restriction. */
/* @sem EventSpec::Filtered{event:$event_cards_leave, condition:ExistsPlayer{players:One(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))}} */
event_graveyard_batch_during_your_turn ::= event_cards_leave "during" "your" "turn"

/* @prefer always */
/* @sem EventSpec::Filtered{event:$graveyard_filtered_batch, condition:PlayerIsActive(AbilityController)} */
event_filtered_graveyard_batch_during_your_turn ::= graveyard_filtered_batch "during" "your" "turn"

graveyard_filtered_batch ::= event_graveyard_union_batch | event_cards_leave_your_graveyard

/* The explicit union retains both independent filter operands. */
/* @prefer always */
/* @sem ObjectFilter::AnyOf([$filter_phrase, $filter_phrase_2]) */
graveyard_card_union ::= filter_phrase "and" "/" "or" filter_phrase

/* @prefer always */
/* @sem EventSpec::Batch{event:Object{event:LeavesGraveyard, objects:AllOf([$graveyard_card_union, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}, per:Whole} */
event_graveyard_union_batch ::= "one" "or" "more" graveyard_card_union "cards" "leave" "your" "graveyard"

/* Moving the holder from its graveyard establishes the ability's active zone. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$graveyard_holder_library_program})} */
graveyard_holder_library_trigger ::= event_clause "," graveyard_holder_library_program "."

/* The source arrival itself establishes the graveyard scope. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$holder_library_graveyard_event, limits:TriggerLimits{}, announcement:@announcement, body:$holder_graveyard_program})} */
holder_library_graveyard_trigger ::= "when" holder_library_graveyard_event "," holder_graveyard_program "."

/* @sem EventSpec::ZoneChange{objects:AllOf([SameObject(Source), OwnedBy(One(AbilityController))]), from:Library, to:Graveyard} */
holder_library_graveyard_event ::= "this" "card" "is" "put" "into" "your" "graveyard" "from" "your" "library"

/* @sem Program::Program{instructions:$shuffle_own_graveyard} */
holder_graveyard_program ::= shuffle_own_graveyard

/* A cast spell or activated ability with X retains the triggering stack object. */
/* @sem EventSpec::SpellOrActivation{players:One(AbilityController), spells:AllOf([AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]), State(HasX)]), abilities:AllOf([OnStack(XInCost), Not(OnStack(Mana))])} */
event_permanent_x_or_nonmana_activation ::= "whenever" "you" "cast" "a" "permanent" "spell" "with" "{" "X" "}" "in" "its" "mana" "cost" "or" "activate" "an" "ability" "with" "{" "X" "}" "in" "its" "activation" "cost" "that" "isn't" "a" "mana" "ability"

/* @sem EventSpec::SpellOrActivation{players:One(AbilityController), spells:AllOf([$stack_target_spell_filter, OnStack(SingleTarget), TargetsAny(Objects($affected))]), abilities:AllOf([OnStack(SingleTarget), TargetsAny(Objects(One(@named_source)))])} */
event_cast_or_activate_single_target_an ::= "whenever" "you" "cast" "an" stack_target_spell_filter "spell" "that" "targets" "only" affected "or" "activate" "an" "ability" "that" "targets" "only" SELF_NAME

stack_target_spell_filter ::= filter_phrase | stack_target_type_pair

/* @sem ObjectFilter::AnyOf([$stack_target_first_type, $stack_target_second_type]) */
stack_target_type_pair ::= stack_target_first_type "or" stack_target_second_type

stack_target_first_type ::= noun_artifact | noun_enchantment | spell_instant

stack_target_second_type ::= spell_sorcery | spell_instant | noun_artifact | noun_enchantment | noun_creature | noun_planeswalker | noun_battle

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:Program{instructions:$seek_perpetual_instruction}} */
triggered_seek_perpetual_shared ::= event_clause "," seek_perpetual_instruction

/* @sem Ability::Triggered{event:$event_clause, limits:_{per_turn:1}, announcement:@announcement, body:Program{instructions:$optional_action_reveal_followup}} */
triggered_optional_reveal_once_shared ::= event_clause "," optional_action_reveal_followup "." "this" "ability" "triggers" "only" "once" "each" "turn" "."

/* The upkeep player is the payer; the conditional instruction uses its receipt. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:EventSubject, cost:$payment_sacrifice_choice, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[$suspended_source_counter_placement]}, otherwise:Program{}}]} */
suspended_player_payment_body ::= "that" "player" "may" payment_sacrifice_choice "." "if" "the" "player" "does" "," suspended_source_counter_placement "."

/* @sem Ability::Scoped{zones:[Exile], ability:@scope(Ability::Triggered{event:$suspended_each_player_upkeep, intervening_if:$suspended_source_condition, limits:TriggerLimits{}, announcement:@announcement, body:$suspended_player_payment_body})} */
suspended_turn_payment_trigger ::= "at" suspended_each_player_upkeep "," "if" suspended_source_condition "," suspended_player_payment_body

/* The source-zone condition scopes the ability; the event and body compose independently. */
/* @sem Ability::Scoped{zones:[Command, Battlefield], ability:@scope(Ability::Triggered{event:$event_clause, intervening_if:ObjectMatches{object:Source, filter:AnyOf([InZone(Shared(Command)), InZone(Shared(Battlefield))])}, limits:TriggerLimits{}, announcement:@announcement, body:$scoped_paid_token_program})} */
command_battlefield_source_trigger ::= event_clause "," "if" self_named "is" "in" "the" "command" "zone" "or" "on" "the" "battlefield" "," scoped_paid_token_program

/* These spellings keep the turn subject and exiled card explicit. */
/* @sem EventSpec::Turn{point:UpkeepBegins, players:All} */
suspended_each_player_upkeep ::= "the" "beginning" "of" "each" "player's" "upkeep"

/* @sem Instruction::Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Source)), kind:$counter_kind, amount:$suspended_plural_number}]}} */
suspended_source_counter_placement ::= "put" suspended_plural_number counter_kind "counters" "on" "this" "card"

suspended_plural_number ::= n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10 | n11 | n12 | n13 | n14 | n15 | n20 | n30 | number_hundred

/* Plural recipients share one batch, independently of the damage kind. */
/* @sem EventSpec::Damage(_{source_kind:Any, sources:Any, recipients:Players($plural_damage_recipients), kind:$historical_damage_kind, grouping:Batch, subject:Recipient}) */
event_plural_players_dealt_damage ::= plural_damage_recipients "are" "dealt" historical_damage_kind

plural_damage_recipients ::= plural_damage_opponents | plural_damage_players

/* @sem PlayerSet::OpponentsOf(AbilityController) */
plural_damage_opponents ::= "your" "opponents"

/* @sem PlayerSet::All */
plural_damage_players ::= "players"

/* An explicit noncombat damage event retains its source and player recipient. */
/* @sem EventSpec::Damage(DamageEvent{source_kind:Any, sources:$event_singular_subject, recipients:Players(All), kind:Noncombat, grouping:SourceRecipient, subject:Source}) */
event_noncombat_damage_player ::= event_singular_subject "deals" "noncombat" "damage" "to" "a" "player"

/* @sem EventSpec::Player{event:SetsSchemeInMotion, players:One($scheme_event_player), objects:SameObject(@remember_object(ObjectRef::Source))} */
event_scheme_other ::= scheme_event_player "sets" "this" "scheme" "in" "motion"

scheme_event_player ::= active_player_ref

/* The cast event establishes the spell used by the target selection. */
/* @sem Ability::Triggered{event:$event_cast_from_hand, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$normal_cast_selected_card}]}}]}} */
trigger_cast_from_hand_normal_cast ::= "whenever" event_cast_from_hand "," "you" "may" normal_cast_selected_card "."

/* The singular discard event establishes the card referred to by it. */
/* @sem Ability::Triggered{event:$event_discard_non_type_card, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$cast_discarded_card}]}}]}} */
trigger_discard_normal_cast ::= "whenever" event_discard_non_type_card "," "you" "may" cast_discarded_card "."

/* The event and its produced mana are kept in the same trigger scope. */
/* @sem Ability::Triggered{event:$fortified_mana_event, limits:TriggerLimits{}, announcement:@announcement, body:$fortified_mana_followup} */
fortified_mana_trigger ::= "whenever" fortified_mana_event "," fortified_mana_followup "."

/* @sem EventSpec::Object{event:TappedForMana, objects:SameObject(AttachedTo(Source))} */
fortified_mana_event ::= "fortified" "land" "is" "tapped" "for" "mana"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$put_counters_direct}, If{condition:ObjectMatches{object:$that_noun, filter:SharesColorWithMana(ProducedByEvent)}, then:Program{instructions:[Effect{result:@next, operation:$operation_imperative}]}, otherwise:Program{}}]} */
fortified_mana_followup ::= put_counters_direct "." "if" that_noun "shares" "a" "color" "with" "the" "mana" "that" "land" "produced" "," operation_imperative

/* @sem EventSpec::Turn{point:CombatBegins, players:OpponentsOf(PlayerRef::AbilityController)} */
turn_combat_opponent ::= "the" "beginning" "of" "combat" "on" "each" "opponent's" "turn"

/* The actor and the predicate on the scheme are independent operands. */
/* @sem EventSpec::Player{event:SetsSchemeInMotion, players:$player_rule_you, objects:$scheme_motion_qualifier} */
event_you_set_qualified_scheme ::= player_rule_you "set" "a" scheme_motion_qualifier "scheme" "in" "motion"

/* @sem EventSpec::Player{event:SetsSchemeInMotion, players:$event_player, objects:$scheme_motion_qualifier} */
event_player_sets_qualified_scheme ::= event_player "sets" "a" scheme_motion_qualifier "scheme" "in" "motion"

/* One batch includes the named object and the qualified distinct population. */
/* @sem EventSpec::Batch{event:ZoneChange{objects:$referenced_or_other_plural, to:Battlefield}, per:Whole} */
event_referenced_or_other_batch_enters ::= referenced_or_other_plural "enter"

/* Stack-event identity is shared by its condition and dependent program. */
/* @sem EventSpec::OntoStack(ObjectFilter::Any) */
event_spell_or_ability_onto_stack ::= "a" "spell" "or" "ability" "is" "put" "onto" "the" "stack"

/* @sem Condition::ObjectMatches{object:EventStackObject, filter:OnStack(SingleTarget)} */
stack_event_single_target_condition ::= "it" "has" "a" "single" "target"

/* @sem Ability::Triggered{event:$stack_event_clause, intervening_if:$stack_event_single_target_condition, limits:TriggerLimits{}, announcement:@announcement, body:$stack_event_program_sentence} */
triggered_stack_single_target ::= stack_event_clause "," "if" stack_event_single_target_condition "," stack_event_program_sentence

/* @sem $event_spell_or_ability_onto_stack */
stack_event_clause ::= "whenever" event_spell_or_ability_onto_stack

stack_event_program_sentence ::= stack_event_retarget_sentence | program_sentence

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$stack_event_retarget_action}]} */
stack_event_retarget_sentence ::= stack_event_retarget_action "."

/* The caster owns the hand from which the triggering spell is cast. */
/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:@and($spell_filter, ObjectFilter::Cast{from:Players{zone:Hand, players:One(CasterOf(Candidate))}})} */
event_next_cast_from_hand ::= "you" "next" "cast" spell_filter "from" "your" "hand"

/* An event union keeps the tapped subject and the activation actor independent. */
/* @sem EventSpec::@either_event(EventSpec::Object{event:BecomesTapped, objects:$event_object}, EventSpec::$event_tapless_activation) */
event_tapped_or_tapless_activation ::= event_object "becomes" "tapped" "or" event_tapless_activation

/* Keep standalone all-player activation wording available independently. */
/* @sem EventSpec::Activated{players:All, abilities:AllOf([AbilityOf($tapless_ability_source), Not(OnStack(TapSymbolInCost))])} */
event_tapless_all_player ::= "a" "player" "activates" tapless_ability_source "without" "{" "T" "}" "in" "its" "activation" "cost"

/* The quoted ability has its own holder and closes the enclosing sentence. */
/* @sem Ability::AsEvent{object:$object_ref, event:Transforms, actions:List([$transform_emblem_action])} */
as_transform_emblem ::= "as" object_ref "transforms" "into" transform_emblem_action

/* @sem Operand::Term{family:TransformAction, form:GetAnEmblem, operands:[Ability($token_quoted_sentence)]} */
transform_emblem_action ::= SELF_NAME "," "you" "get" "an" "emblem" "with" token_quoted_sentence

/* Each recipient is a separate event, with the same printed damage amount. */
/* @sem EventSpec::AnyOf([Filtered{event:Damage(_{source_kind:Any, sources:$damage_source, recipients:Players(All), kind:Any, grouping:SourceRecipient, subject:Source}), condition:Compare{left:EventAmount, test:NumberTest::Compare{comparison:Equal, value:$value}}}, Filtered{event:Damage(_{source_kind:Any, sources:$damage_source, recipients:Objects($filter_phrase), kind:Any, grouping:SourceRecipient, subject:Source}), condition:Compare{left:EventAmount, test:NumberTest::Compare{comparison:Equal, value:$value}}}]) */
event_exact_damage_object_or_player ::= damage_source "deals" "exactly" value "damage" "to" ("a" | "an") filter_phrase "or" "player"

/* A closed action can end with a quoted ability whose period is inside the quote. */
/* @sem Ability::AsEvent{object:$object_ref, event:EntersOrTurnsFaceUp, actions:List([$entry_face_closed_action])} */
as_entry_or_face_up_closed ::= "as" object_ref "enters" "or" "is" "turned" "face" "up" "," entry_face_closed_action

entry_face_closed_action ::= entry_face_optional_copy

/* The chosen copy model, duration, and added ability remain independent operands. */
/* @sem Operand::Term{family:EnterOrFaceUpAction, form:MayActions, operands:[Term{family:EnterOrFaceUpAction, form:EnterAsACopyOfAPermanentUntil, operands:[Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Not(SameObject($object_ref))])}), $entry_face_copy_effects, $entry_face_copy_duration]}]} */
entry_face_optional_copy ::= "you" "may" "choose" "another" filter_phrase "on" "the" "battlefield" "." "if" "you" "do" "," entry_face_copy_duration "," "it" "becomes" "a" "copy" "of" object_ref "," "except" entry_face_copy_effects

/* @sem Operand::Duration(WhileMatches{object:$object_ref, filter:Not(State(FaceDown))}) */
entry_face_copy_duration ::= "until" object_ref "is" "turned" "face" "down"

/* @sem Operand::Term{family:CopyEffects, form:CopyEffects, operands:[Term{family:CopyEffect, form:AddAbility, operands:[Ability(@scope($entry_face_granted_trigger))]}]} */
entry_face_copy_effects ::= "it" "has" '"' entry_face_granted_trigger '"'

/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$program} */
entry_face_granted_trigger ::= "at" turn_event "," program "."

/* The controlled entrant spelling retains the normalized player-entry event for printing. */
/* @sem EventSpec::@either_event(EventSpec::Player{event:EntersUnderControl, players:All, objects:$controlled_entrant}, EventSpec::Player{event:FullyUnlocksRoom, players:One(PlayerRef::AbilityController), objects:Subtype(Room)}) */
event_controlled_enters_or_unlock ::= controlled_entrant "enters" "and" "whenever" "you" "fully" "unlock" "a" "Room"

/* A damage event and its follow-up share the same permanent-or-player recipient.
   Keeping the pair scoped prevents an unrelated event from supplying the anaphor. */
/* @sem Ability::Triggered{event:AnyOf([Filtered{event:Damage(_{source_kind:Any, sources:$damage_event_source, recipients:Players(All), kind:Any, grouping:SourceRecipient, subject:Source}), condition:Compare{left:EventAmount, test:NumberTest::Compare{comparison:Equal, value:$number}}}, Filtered{event:Damage(_{source_kind:Any, sources:$damage_event_source, recipients:Objects(Any), kind:Any, grouping:SourceRecipient, subject:Source}), condition:Compare{left:EventAmount, test:NumberTest::Compare{comparison:Equal, value:$number}}}]), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:DamagedByEvent, amount:$number_2, preventable:true}}]}} */
triggered_damage_event_recipient ::= "whenever" damage_event_source "deals" "exactly" number "damage" "to" "a" "permanent" "or" "player" "," damage_source_ref "deals" number "damage" "to" "that" "permanent" "or" "player" "."

damage_event_source ::= damage_source | damage_event_another_controlled_source

/* @sem ObjectFilter::AllOf([Not(SameObject(Source)), ControlledBy(One(AbilityController))]) */
damage_event_another_controlled_source ::= "another" "source" "you" "control"

/* @sem $event_passive_chosen_mana */
chosen_mana_tapped_clause ::= "whenever" event_passive_chosen_mana

/* An entrant's ownership and its entering controller are independent. */
event_owned_entrant_under_control ::= event_owned_entrant_original | event_owned_entrant_normalized

/* @sem EventSpec::Player{event:EntersUnderControl, players:One(AbilityController), objects:$owned_entrant_filter} */
event_owned_entrant_original ::= "a" owned_entrant_filter "enters" "the" "battlefield" "under" "your" "control"

/* @sem EventSpec::Player{event:EntersUnderControl, players:All, objects:@and($owned_entrant_filter, ObjectFilter::ControlledBy(One(AbilityController)))} */
event_owned_entrant_normalized ::= "a" owned_entrant_filter "enters" "the" "battlefield" "under" "your" "control"

/* The owner introduced by this entry event is the antecedent of "they". */
/* @sem Ability::Triggered{event:$event_owned_entrant_under_control, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:@apply(PlayerSet::One(PlayerRef::OwnerOf(ObjectRef::EventSubject)), $verbs_base)}} */
triggered_owned_entrant_owner ::= "whenever" event_owned_entrant_under_control "," "they" verbs_base "."

/* Target populations are independent of the player activating the ability. */
/* @sem ObjectFilter::AnyOf([TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase})), TargetsAny(Players(All))]) */
ability_targeting_permanent_or_player ::= "that" "targets" "a" filter_phrase "or" "player"

/* @sem EventSpec::Activated{players:One(AbilityController), abilities:$ability_targeting_permanent_or_player} */
event_clause_you_activate_targeting_ability ::= "whenever" "you" "activate" "an" "ability" ability_targeting_permanent_or_player

/* A team-qualified population keeps its controller distinct from the entrant. */
/* @sem ObjectFilter::AllOf([$filter_phrase, ControlledBy(Matching{binding:0, condition:SameTeam{player:Bound(0), other:AbilityController}})]) */
team_controlled_entry_filter ::= filter_phrase "your" "team" "controls"

/* @sem ObjectFilter::AllOf([Not(SameObject(Source)), $team_controlled_entry_filter]) */
team_other_entrant ::= "another" team_controlled_entry_filter

/* @sem EventSpec::AnyOf([ZoneChange{objects:$event_holder, to:Battlefield}, Player{event:EntersUnderControl, players:All, objects:$team_other_entrant}]) */
team_self_or_other_entry ::= event_holder "or" team_other_entrant "enters"

/* @sem EventSpec::$team_self_or_other_entry */
whenever_team_other_entry ::= "whenever" team_self_or_other_entry

/* A resolving spell's replacement retains the triggering event's subject. */
/* @sem Operation::EffectOn{subject:Objects(One(EventSubject)), effects:[Term{family:SpellEffect, form:ResolvesIntoExileInsteadOfGraveyard}]} */
resolving_event_spell_to_exile ::= "exile" "it" "instead" "of" "putting" "it" "into" "a" "graveyard" "as" "it" "resolves"

spell_type_after_an ::= spell_instant | noun_artifact | noun_enchantment

spell_type_after_or ::= spell_instant | spell_sorcery | noun_artifact | noun_enchantment | noun_creature | noun_battle | noun_planeswalker

/* @sem EventSpec::Spell{event:Cast, players:All, spells:AnyOf([$spell_type_after_an, $spell_type_after_or])} */
event_player_casts_two_spell_types_an ::= "a" "player" "casts" "an" spell_type_after_an "or" spell_type_after_or "spell"

/* @sem Ability::Triggered{event:$event_player_casts_two_spell_types_an, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$resolving_event_spell_to_exile}]}} */
triggered_cast_exile_on_resolution ::= "whenever" event_player_casts_two_spell_types_an "," resolving_event_spell_to_exile "."

/* @sem EventSpec::Turn{point:EndStepBegins, players:One(AbilityController)} */
delayed_move_your_end ::= "the" "beginning" "of" "your" "next" "end" "step"

/* @sem EventSpec::Turn{point:EndStepBegins, players:All} */
delayed_move_any_end ::= "the" "beginning" "of" "the" "next" "end" "step"

delayed_move_end_event ::= delayed_move_your_end | delayed_move_any_end | delayed_move_any_upkeep

/* Independent filters describe the sacrifice and the card moving to the graveyard. */
/* @sem EventSpec::AnyOf([Player{event:Sacrifices, players:One(AbilityController), objects:$filter_phrase}, ZoneChange{objects:@and($filter_phrase_2, ObjectFilter::OwnedBy(One(AbilityController))), from:Hand, to:Graveyard}, ZoneChange{objects:@and($filter_phrase_2, ObjectFilter::OwnedBy(One(AbilityController))), from:Library, to:Graveyard}]) */
event_sacrifice_and_owned_card_graveyard ::= "you" "sacrifice" "a" filter_phrase "and" "whenever" "a" filter_phrase "card" "is" "put" "into" "your" "graveyard" "from" "your" "hand" "or" "library"

/* @sem Ability::[Triggered{event:$event_sacrifice_and_owned_card_graveyard, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$delayed_event_graveyard_move}]}}] */
line_sacrifice_and_owned_card_delayed ::= "whenever" event_sacrifice_and_owned_card_graveyard "," delayed_event_graveyard_move "."

/* @sem EventSpec::Turn{point:EndStepBegins, players:All} */
resolving_return_time ::= "at" "the" "beginning" "of" "the" "next" "end" "step"

/* The spell targets at least one member of the controlled population. */
/* @sem @and($spell_adjectives, ObjectFilter::TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$controlled_entry_filter}))) */
spell_targets_controlled ::= "an" spell_adjectives "spell" "that" "targets" "a" controlled_entry_filter

/* A batch of named counters removed from the specified object. */
/* @sem EventSpec::Batch{event:Counters(_{change:Removed, kind:$counter_kind, objects:$event_singular_subject}), per:Subject} */
event_named_counter_removal ::= "one" "or" "more" counter_kind "counters" "are" "removed" "from" event_singular_subject

/* A trigger composes the counter event and the conditional reflexive sequence. */
/* @sem Ability::Triggered{event:$event_named_counter_removal, limits:_{}, announcement:@announcement, body:$program_then_conditional_reflexive} */
triggered_named_counter_conditional_reflexive ::= "whenever" event_named_counter_removal "," program_then_conditional_reflexive "."

/* The event records the creator, independently of the token controller. */
/* @sem ReplacementEvent::FirstEachTurn(Tokens{tokens:Any, creators:One(AbilityController)}) */
first_tokens_you_would_create ::= "the" "first" "time" "you" "would" "create" "one" "or" "more" "tokens" "each" "turn"

/* A colored creature and a spell of that color contribute separate damage events. */
/* @sem Ability::[Triggered{event:@either_event(EventSpec::Damage(_{source_kind:Permanent, sources:@and($adjective_color, ObjectFilter::CardType(Creature)), recipients:Any, kind:Any, grouping:Source, subject:Source}), EventSpec::Damage(_{source_kind:Spell, sources:$adjective_color, recipients:Any, kind:Any, grouping:Source, subject:Source})), limits:_{}, body:$colored_pair_damage_body, announcement:@announcement}] */
line_colored_creature_or_spell_damage ::= "whenever" "a" adjective_color "creature" "or" "spell" "deals" "damage" "," colored_pair_damage_body

/* The same source is the event subject and the ability’s sole target. */
/* @sem EventSpec::BecomesTarget{objects:$event_self, kind:Ability, by:Term{family:Abilities, form:TargetsOnlySinglePermanent, operands:[Object(Source)]}} */
event_ability_targets_only_source ::= event_self "becomes" "the" "target" "of" "an" "ability" "that" "targets" "only" "it"

/* The quoted trigger is scoped to its newly granted ability holder. */
/* @sem Operand::Term{family:PerpetualEffect, form:AddAbility, operands:[Ability(@scope(Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$program}))]} */
perpetual_granted_trigger ::= "gains" '"' "at" turn_event "," program "." '"'

/* Independent event alternatives retain their event identities. */
/* @prefer always */
/* @sem EventSpec::AnyOf([$event_when, $graveyard_card_departure]) */
event_when_and_graveyard_departure ::= event_when "and" "whenever" graveyard_card_departure

/* @sem EventSpec::Object{event:LeavesGraveyard, objects:AllOf([$graveyard_departure_filter, InZone(Players{zone:Graveyard, players:One(AbilityController)})])} */
graveyard_card_departure ::= "a" graveyard_departure_filter "card" "leaves" "your" "graveyard"

graveyard_departure_filter ::= noun_land | noun_creature | non_land | non_creature | non_artifact | non_enchantment | non_planeswalker

/* The damaged creature is the recipient of this particular damage event. */
/* @sem Ability::Triggered{event:Damage{source_kind:Permanent, sources:$event_object, recipients:Objects(CardType(Creature)), kind:Combat, grouping:SourceRecipient, subject:Source}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Damage(Recipient)), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}} */
combat_creature_recipient_exile_trigger ::= "whenever" event_object "deals" "combat" "damage" "to" "a" "creature" "," "exile" "that" "creature" "."

/* A singular controlled subtype retains the attacker as event subject. */
/* @sem ObjectFilter::AllOf([$subtype, ControlledBy(One(AbilityController))]) */
event_controlled_subtype ::= "a" subtype "you" "control"

/* An explicit exiled source supplies the scope; the counter condition and
   resolving program remain independent operands. */
/* @sem Ability::Scoped{zones:[Exile], ability:@scope(Ability::Triggered{event:$turn_event, intervening_if:$exiled_source_counter_condition, limits:TriggerLimits{}, announcement:@announcement, body:$exiled_source_counter_program})} */
exiled_source_counter_turn_trigger ::= "at" turn_event "," "if" exiled_source_counter_condition "," exiled_source_counter_program "."

/* @sem Condition::ObjectMatches{object:Source, filter:Counters{kind:$counter_kind, comparison:Greater, value:Constant(0)}} */
exiled_source_counter_condition ::= "this" "card" "is" "exiled" "with" "a" counter_kind "counter" "on" "it"

/* The state carries the controlling player independently of the holder's owner. */
/* @sem EventSpec::StateWithPlayer{condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([SameObject(Source), ControlledBy(OthersThan(OwnerOf(Source)))])}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, player:ControllerOf(Source)} */
event_nonowner_controls_holder ::= "when" "a" "player" "other" "than" "this" "creature's" "owner" "controls" "it"

/* Compose a player-bearing event with a dependent payment program. */
/* @sem Ability::Triggered{event:$event_nonowner_controls_holder, limits:TriggerLimits{}, announcement:@announcement, body:$event_player_sacrifice_program} */
triggered_event_player_sacrifice ::= event_nonowner_controls_holder "," event_player_sacrifice_program "."

/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$draw_counter_damage_receipt_program} */
triggered_turn_draw_counter_damage ::= "at" turn_event "," draw_counter_damage_receipt_program

/* A trigger active in the command zone and on the battlefield. */
/* @sem Ability::Scoped{zones:[Command, Battlefield], ability:@scope(Ability::Triggered{event:$turn_event, intervening_if:ObjectMatches{object:Source, filter:AnyOf([InZone(Shared(Command)), InZone(Shared(Battlefield))])}, limits:_{}, body:$program_sentence, announcement:@announcement})} */
command_battlefield_turn_trigger ::= "at" turn_event "," "if" self_text "is" "in" "the" "command" "zone" "or" "on" "the" "battlefield" "," program_sentence

/* The explicit return of this card establishes the graveyard ability scope. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$event_clause, intervening_if:$entrant_graveyard_origin_condition, limits:TriggerLimits{}, announcement:@announcement, body:$delayed_graveyard_self_program})} */
graveyard_entrant_origin_trigger ::= event_clause "," "if" entrant_graveyard_origin_condition "," delayed_graveyard_self_program

/* @sem Condition::ObjectMatches{object:EventSubject, filter:AnyOf([EnteredFrom(Players{zone:Graveyard, players:One(AbilityController)}), Cast{by:One(AbilityController), from:Players{zone:Graveyard, players:One(AbilityController)}}])} */
entrant_graveyard_origin_condition ::= "it" "entered" "from" "your" "graveyard" "or" "you" "cast" "it" "from" "your" "graveyard"

/* The source spell is cast by its controller from that caster’s hand. */
/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:AllOf([SameObject(Source), Cast{from:Players{zone:Hand, players:One(CasterOf(Candidate))}}])} */
cast_source_from_hand_header ::= "when" "you" "cast" "this" "spell" "from" "your" "hand"

/* A third-party caster's origin follows that caster, not the ability holder. */
/* @sem EventSpec::Spell{event:Cast, players:$event_player, spells:@and($spell_filter, ObjectFilter::Cast{from:Players{zone:$caster_origin_zone, players:One(CasterOf(Candidate))}})} */
event_player_casts_from_own_zone ::= event_player "casts" spell_filter "from" "their" caster_origin_zone

/* @sem Zone::Hand */
caster_origin_hand ::= "hand"

/* @sem Zone::Graveyard */
caster_origin_graveyard ::= "graveyard"

/* @sem Zone::Library */
caster_origin_library ::= "library"

caster_origin_zone ::= caster_origin_hand | caster_origin_graveyard | caster_origin_library

/* The payment and its exclusion are scoped together: the excluded cards are
   the actual arrivals of this exact exile payment. */
/* @sem Ability::Triggered{event:$event_player_casts_from_own_zone, limits:TriggerLimits{}, announcement:@announcement, body:$event_exile_linked_cast_program} */
triggered_cast_origin_exile_linked ::= "whenever" event_player_casts_from_own_zone "," event_exile_linked_cast_program

/* The placement count, counter kind and holder are independent operands. */
/* @sem EventSpec::NthCounter{kind:$nth_counter_kind, objects:$event_self, nth:$ordinal} */
event_nth_counter_source ::= "the" ordinal nth_counter_kind "counter" "is" "put" "on" event_self

nth_counter_kind ::= nth_counter_plan | nth_counter_hour

/* @sem Operand::Vocabulary{family:CounterType, form:PlanCounter} */
nth_counter_plan ::= "plan"

/* @sem Operand::Vocabulary{family:CounterType, form:HourCounter} */
nth_counter_hour ::= "hour"

/* @sem Expr::Constant(4) */
ordinal_fourth ::= "fourth"

/* @sem Expr::Constant(6) */
ordinal_sixth ::= "sixth"

/* @sem Expr::Constant(12) */
ordinal_twelfth ::= "twelfth"

/* In this frame the counter recipient is the source introduced immediately
   before the sacrifice pronoun; the reflexive callback owns its targets. */
/* @sem Ability::Triggered{event:$event_nth_counter_source, limits:TriggerLimits{}, announcement:Announcement{}, body:Program{instructions:$nth_source_sacrifice_callback}} */
nth_source_sacrifice_trigger ::= "when" event_nth_counter_source "," nth_source_sacrifice_callback "."

/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:_{instructions:$instructions_random_hand_cast_trigger}} */
turn_random_hand_cast_trigger ::= "at" turn_event "," instructions_random_hand_cast_trigger

/* Control passes to the ability controller from a different player. */
/* @sem EventSpec::ControlChanges{objects:SameObject(Source), to:One(AbilityController), from:OthersThan(AbilityController)} */
event_you_gain_source_control_other ::= "you" "gain" "control" "of" "this" "enchantment" "from" "another" "player"

/* An opponent is a narrower previous controller than any other player. */
/* @sem EventSpec::ControlChanges{objects:SameObject(Source), to:One(AbilityController), from:OpponentsOf(AbilityController)} */
event_you_gain_source_control_opponent ::= "you" "gain" "control" "of" "this" "enchantment" "from" "an" "opponent"

/* The event subject is retained as both the payer and the countered spell. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:EventSubject, cost:_{parts:[Mana($mana_symbols)]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:_{instructions:[Effect{result:@next, operation:Counter{objects:One(EventSubject), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:_{}}] */
first_spell_consequence ::= "counter" "that" "spell" "unless" "that" "player" "pays" mana_symbols

/* The drawing player supplies the event subject for follow-up references. */
/* @sem EventSpec::NthEachTurn{event:Player{event:Draws, players:$event_player}, test:NumberTest::Compare{comparison:Equal, value:Constant(1)}} */
event_first_draw_each_turn ::= event_player "draws" "their" "first" "card" "each" "turn"

/* A caused draw retains the source-card filter and the ability controller. */
/* @sem ReplacementEvent::DrawCausedBy{players:One(AbilityController), abilities:AbilityOf(AllOf([Not(SameObject(Source)), $adjective_nontype]))} */
cycling_ability_draw_event ::= "a" "cycling" "ability" "of" "another" adjective_nontype "card" "would" "cause" "you" "to" "draw" "a" "card"

/* The hand event tracks ownership; the battlefield event tracks the cause's
   controller independently of the exiled permanent's characteristics. */
/* @sem EventSpec::Batch{event:AnyOf([ZoneChange{objects:OwnedBy(One(AbilityController)), from:Hand, to:Exile}, Caused{cause:ControlledBy(One(AbilityController)), event:ZoneChange{objects:$filter_plural, from:Battlefield, to:Exile}}]), per:Whole} */
controlled_exile_or_own_hand_event ::= "whenever" "one" "or" "more" "cards" "are" "put" "into" "exile" "from" "your" "hand" "or" "a" "spell" "or" "ability" "you" "control" "exiles" "one" "or" "more" filter_plural "from" "the" "battlefield"

/* @sem EventSpec::Discard(_{players:One(AbilityController), cards:$discard_batch_cards, kind:Any, grouping:Player}) */
event_you_discard_filtered_batch ::= "you" "discard" discard_batch_cards

/* @sem Ability::Triggered{event:$event_you_discard_filtered_batch, limits:TriggerLimits{}, announcement:@announcement, body:$discard_group_exile_cast_program} */
triggered_discard_group_exile_cast ::= "whenever" event_you_discard_filtered_batch "," discard_group_exile_cast_program "."

/* The activation target remains the object matched at departure; ownership fixes the graveyard. */
/* @sem EventSpec::ZoneChange{objects:AllOf([SameObject($target_permanent), OwnedBy(One(AbilityController))]), from:Battlefield, to:Graveyard} */
target_put_your_graveyard_event ::= target_permanent "is" "put" "into" "your" "graveyard"

/* The anaphoric cast event is scoped to the preceding unqualified first-spell
   grant. Its other mana payer remains the independently bound draw recipient. */
/* @sem Ability::[$first_unqualified_spell_turn_grant, $first_spell_other_payer_trigger] */
first_spell_grant_payer_line ::= first_unqualified_spell_turn_grant first_spell_other_payer_trigger

/* @sem Ability::Triggered{event:Filtered{event:Spell{event:Cast, players:One(AbilityController), spells:NthCast{ordinal:Constant(1), spells:Any, by:One(AbilityController), scope:Turn}}, condition:PlayerIsActive(AbilityController)}, intervening_if:ObjectMatches{object:EventSubject, filter:ManaSpent{payers:OthersThan(AbilityController), comparison:GreaterOrEqual, value:Constant(1)}}, limits:_{}, body:_{instructions:[Effect{result:@next, operation:Draw{players:Union([One(AbilityController), Matching{binding:0, condition:ObjectMatches{object:EventSubject, filter:ManaSpent{payers:One(Bound(0)), comparison:GreaterOrEqual, value:Constant(1)}}}]), amount:$card_count}}]}, announcement:@announcement} */
first_spell_other_payer_trigger ::= "when" "you" "cast" "that" "spell" "," "if" "another" "player" "spent" "mana" "to" "cast" "it" "," "you" "and" "that" "player" "each" "draw" card_count "."

/* The announced creature is both the damage recipient and the delayed event subject. */
/* @sem Ability::Spell{body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0})), amount:$number, preventable:true}}, Effect{result:@next, operation:CreateTrigger{event:ZoneChange{objects:SameObject(Target{slot:@last_slot, index:0}), from:Battlefield, to:Graveyard}, duration:$this_duration, body:$death_followup_program, announcement:_{}}}]}, announcement:@announcement} */
spell_damage_creature_death ::= SELF_NAME "deals" number "damage" "to" "target" "creature" "." "when" "that" "creature" "dies" this_duration "," death_followup_program "."

/* The defender references belong to this source attack, including the exile receipt. */
/* @sem Ability::Triggered{event:Object{event:Attacks, objects:$event_self}, intervening_if:$condition_defending_hand_more_than_you, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$instructions_defender_top_cast_after_attack}} */
triggered_source_attack_defender_hand ::= "whenever" event_self "attacks" "," "if" condition_defending_hand_more_than_you "," instructions_defender_top_cast_after_attack "."

/* The count belongs to the defending player, not the attacking controller. */
/* @sem AttackDefenders::Players(Matching{binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$plural, ControlledBy(One(Bound(0)))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count_plural}}}) */
attack_defender_control_count ::= "a" "player" "who" "controls" count_plural "or" "more" plural

/* The written possessive names the caster of the spell. */
/* @sem EventSpec::Spell{event:Cast, players:OpponentsOf(AbilityController), spells:@and($spell_filter, ObjectFilter::Cast{from:Players{zone:Hand, players:One(CasterOf(Candidate))}})} */
event_third_cast_from_hand ::= "an" "opponent" "casts" spell_filter "from" "their" "hand"

/* @sem Ability::Triggered{event:$event_third_cast_from_hand, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$instructions_optional_reveal_shared_counter}} */
ability_opponent_cast_from_hand ::= "whenever" event_third_cast_from_hand "," instructions_optional_reveal_shared_counter "."

/* The source joins the same attack batch as the filtered other attackers. */
/* @prefer always */
/* @sem EventSpec::Batch{event:Attack{attackers:$filter_phrase, defenders:Any}, per:Whole, count:[GreaterOrEqual, Constant(1)], including:$self_explicit_ref} */
event_one_other_attack ::= self_explicit_ref "and" "at" "least" "one" "other" filter_phrase "attack"

/* @sem EventSpec::Player{event:RollsADie, players:One(PlayerRef::AbilityController)} */
event_you_roll_a_die ::= "you" "roll" "a" "die"

/* Class levels are reached once; prefer the ordinary one-time trigger wording. */
/* @prefer always */
/* @sem EventSpec::ClassLevel{objects:SameObject(Source), level:$value} */
event_clause_class_level_when ::= "when" "this" "Class" "becomes" "level" value

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$hand_exile_owner_tax_program} */
triggered_hand_exile_owner_tax ::= event_clause "," hand_exile_owner_tax_program

/* @sem ObjectFilter::State(Modal) */
spell_modal_adjective ::= "modal"

/* State-trigger subjects preserve the filter assembled by the phrase. */
/* @sem EventSpec::ObjectBecomes($state_matching_object) */
event_state_matching_object ::= state_matching_object

state_matching_object ::= state_counter_object | state_other_printing_object

/* @sem ObjectFilter::AllOf([$filter_phrase, $state_counter_threshold]) */
state_counter_object ::= "a" filter_phrase "has" state_counter_threshold

/* @sem ObjectFilter::Counters{kind:$counter_kind, comparison:GreaterOrEqual, value:$value} */
state_counter_threshold ::= value "or" "more" counter_kind "counters" "on" "it"

/* @sem ObjectFilter::AllOf([Not(SameObject(Source)), $filter_plural, $first_printing_filter]) */
state_other_printing_object ::= "one" "or" "more" "other" filter_plural "with" first_printing_filter "are" "on" "the" "battlefield"

/* @sem ObjectFilter::NameFirstPrintedIn(ArabianNights) */
first_printing_filter ::= "a" "name" "originally" "printed" "in" "the" "Arabian" "Nights" "expansion"

/* A second attacker is distinct from the explicit object; AttacksWith carries
   that distinction instead of embedding it in the filter. */
/* @sem $filter_phrase */
attack_another_filter ::= "and" "another" filter_phrase

/* @sem EventSpec::AttacksWith{object:$object_ref, others:$attack_another_filter, count:[GreaterOrEqual, Constant(1)], different_defenders:true} */
event_pair_attack_different_players ::= object_ref attack_another_filter "attack" "different" "players"

/* @sem EventSpec::AttacksWith{object:$object_ref, others:$attack_another_filter, count:[GreaterOrEqual, Constant(1)], by:One(AbilityController)} */
event_controller_attack_with_pair ::= "you" "attack" "with" object_ref attack_another_filter

/* @sem EventSpec::AllAttack($all_plural_population) */
event_all_population_attacks ::= all_plural_population "attack"

/* A counted unblocked attack keeps its attacker filter and defending player independent. */
/* @sem EventSpec::AttackUnblocked{attackers:$filter_plural, defenders:Players($attack_player_defender), count:[GreaterOrEqual, $unblocked_attack_minimum]} */
event_unblocked_attack_count ::= unblocked_attack_minimum filter_plural "attack" attack_player_defender "and" "aren't" "blocked"

/* @sem Expr::$value */
unblocked_attack_minimum ::= value "or" "more"

/* A scheme's set-in-motion action retains the population eligible for its choice. */
/* @sem Ability::BeforeGame{when:SetInMotion, body:List([$scheme_motion_action])} */
scheme_motion_ability ::= "as" "you" "set" "this" "scheme" "in" "motion" "," scheme_motion_action "."

/* @sem Operand::Term{family:SetInMotionAction, form:ChooseAPlayer, operands:[Players($scheme_choice_player)]} */
scheme_motion_action ::= "choose" scheme_choice_player

scheme_choice_player ::= transform_any_player | transform_opponent | transform_active_opponent

counted_zone_history ::= history_opponent_controlled_death | history_battlefield_graveyard_arrival

/* @sem EventSpec::ZoneChange{objects:AllOf([$filter_phrase, ControlledBy(OpponentsOf(AbilityController))]), from:Battlefield, to:Graveyard} */
history_opponent_controlled_death ::= filter_phrase "died" "under" "an" "opponent's" "control"

/* @sem EventSpec::ZoneChange{objects:AllOf([$filter_phrase, OwnedBy(All)]), from:Battlefield, to:Graveyard} */
history_battlefield_graveyard_arrival ::= filter_phrase "was" "put" "into" "a" "graveyard" "from" "the" "battlefield"

/* @sem EventSpec::ZoneChange{objects:AllOf([$filter_plural, ControlledBy(One(AbilityController))]), from:Battlefield, to:Graveyard} */
plural_zone_history ::= filter_plural "died" "under" "your" "control"

other_zone_history ::= history_other_target_death | history_other_source_controlled_death | history_referenced_or_another_entry_controlled | history_alternative_controlled_entry

/* @sem EventSpec::ZoneChange{objects:AllOf([Not(SameObject(Target{slot:0, index:0})), $filter_phrase]), from:Battlefield, to:Graveyard} */
history_other_target_death ::= "another" filter_phrase "died"

/* @sem EventSpec::ZoneChange{objects:AllOf([Not(SameObject(Source)), $filter_phrase, ControlledBy(One(AbilityController))]), from:Battlefield, to:Graveyard} */
history_other_source_controlled_death ::= "another" filter_phrase "died" "under" "your" "control"

/* A singular entry subject and its entry state are independent filters. */
entry_tap_state ::= adjective_tapped | adjective_untapped

/* @sem EventSpec::ZoneChange{objects:@and($event_singular_subject, $entry_tap_state), to:Battlefield} */
event_entry_tap_state ::= event_singular_subject "enters" entry_tap_state

/* @sem EventSpec::Damage(DamageEvent{source_kind:Any, sources:$event_object, recipients:Players(All), kind:Noncombat, grouping:SourceRecipient, subject:Source}) */
event_object_noncombat_damage_player ::= event_object "deals" "noncombat" "damage" "to" "a" "player"

/* Die-result tests qualify the roll event without changing its actor. */
/* @sem EventSpec::Filtered{event:Player{event:RollsADie, players:One(AbilityController)}, condition:Compare{left:EventAmount, test:$die_result_test}} */
event_roll_result ::= "you" "roll" "a" die_result_test

die_result_test ::= die_result_exact | die_result_minimum | die_result_either

/* @sem NumberTest::Compare{comparison:Equal, value:$value} */
die_result_exact ::= value

/* @sem NumberTest::Compare{comparison:GreaterOrEqual, value:$value} */
die_result_minimum ::= value "or" "higher"

/* @sem NumberTest::AnyOf([NumberTest::Compare{comparison:Equal, value:$value}, NumberTest::Compare{comparison:Equal, value:$value_2}]) */
die_result_either ::= value "or" value

/* Restrict the event destination consumed by this paired continuation to the
   holder's actual death, and keep the target table in a target-free header. */
/* @sem Ability::Triggered{event:$event_self_dies, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$instructions_conjure_death_pair}} */
triggered_conjure_death_pair ::= "when" event_self_dies "," instructions_conjure_death_pair "."

/* @sem Ability::Triggered{event:$event_self_enters, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence_target_die_ranges} */
triggered_entry_target_die_ranges ::= "when" event_self_enters "," program_sentence_target_die_ranges

/* One subject participates in each independently named action or is targeted
   by the independently described spell. */
/* @sem EventSpec::AnyOf(@unordered([Object{event:$object_event_choice_third, objects:$event_singular_subject}, Object{event:$object_event_choice_third_second, objects:$event_singular_subject}, BecomesTarget(_{objects:$event_singular_subject, kind:Spell, by:Filter($spell_filter)})])) */
referenced_actions_or_spell_target ::= event_singular_subject object_event_choice_third "," object_event_choice_third_second "," "or" "becomes" "the" "target" "of" spell_filter

/* @sem EventSpec::$referenced_actions_or_spell_target */
referenced_actions_or_target_clause ::= "whenever" referenced_actions_or_spell_target

/* The reference and its equipped creature independently deal the same kind of
   damage to the same player population, retaining each source as the subject. */
/* @sem EventSpec::AnyOf([Damage(_{source_kind:Permanent, sources:SameObject($object_ref), recipients:Players($passive_combat_player), kind:$shared_damage_kind, grouping:SourceRecipient, subject:Source}), Damage(_{source_kind:Permanent, sources:SameObject(AttachedTo($object_ref)), recipients:Players($passive_combat_player), kind:$shared_damage_kind, grouping:SourceRecipient, subject:Source})]) */
event_reference_or_equipped_damage ::= object_ref "or" "equipped" "creature" "deals" shared_damage_kind "to" passive_combat_player

/* Historical object events capture the affected filter independently of the quantifier. */
history_some_object_event ::= history_opponent_controlled_entry | history_owned_card_departure | history_owned_card_departure_an | history_controlled_exploration | history_owned_any_card_departure

/* @sem EventSpec::Object{event:LeavesGraveyard, objects:AllOf([$filter_phrase, OwnedBy(One(AbilityController))])} */
history_owned_card_departure ::= "a" filter_phrase "card" "left" "your" "graveyard"

/* @sem EventSpec::Object{event:Explores, objects:AllOf([ControlledBy(One(AbilityController)), $filter_phrase])} */
history_controlled_exploration ::= "a" filter_phrase "you" "controlled" "explored"

history_no_object_event ::= history_plural_battlefield_departure

/* @sem EventSpec::Object{event:LeavesBattlefield, objects:$filter_plural} */
history_plural_battlefield_departure ::= filter_plural "left" "the" "battlefield"

/* @sem EventSpec::Object{event:LeavesGraveyard, objects:AllOf([$filter_phrase, OwnedBy(One(AbilityController))])} */
history_owned_card_departure_an ::= "an" filter_phrase "card" "left" "your" "graveyard"

/* This trigger establishes that the named plural antecedent is the damage source. */
/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:$plural_creature, recipients:Players($combat_single_recipient), kind:Combat, grouping:Recipient, subject:Source}) */
event_creature_group_combat_recipient ::= "one" "or" "more" plural_creature "deal" "combat" "damage" "to" combat_single_recipient

/* @sem EventSpec::Filtered{event:$event_creature_group_combat_recipient, condition:$condition} */
event_creature_group_combat_while ::= event_creature_group_combat_recipient "while" condition

/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:Damage(Source), tapped:true}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Damage(Source)), kind:$counter_kind, amount:Constant(1)}]}}] */
damage_creatures_tap_counter_one ::= "tap" "those" "creatures" "and" "put" "a" counter_kind "counter" "on" "each" "of" "them"

/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:Damage(Source), tapped:true}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Damage(Source)), kind:$counter_kind, amount:$number_words}]}}] */
damage_creatures_tap_counter_many ::= "tap" "those" "creatures" "and" "put" number_words counter_kind "counters" "on" "each" "of" "them"

damage_creatures_tap_counters ::= damage_creatures_tap_counter_one | damage_creatures_tap_counter_many

/* The event and body are scoped together so these anaphors cannot bind a different batch. */
/* @sem Ability::Triggered{event:$event_creature_group_combat_while, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$damage_creatures_tap_counters}} */
triggered_damage_creatures_tap_counters ::= "whenever" event_creature_group_combat_while "," damage_creatures_tap_counters "."

/* A counted set of blockers is paired with the independently described subject. */
/* @sem EventSpec::Batch{event:Pair{event:BecomesBlockedBy, objects:$event_a, others:$filter_plural}, per:Subject, count:[GreaterOrEqual, $value]} */
event_indefinite_blocked_count ::= event_a "becomes" "blocked" "by" value "or" "more" filter_plural

/* The event subject is excluded from the counted battlefield population. */
/* @sem Condition::Compare{left:CountObjects(Difference{objects:$affected, excluding:One(EventSubject)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_other_battlefield_threshold ::= "there" "are" value "or" "more" "other" affected "on" "the" "battlefield"

/* @sem Ability::Triggered{event:ZoneChange{objects:CardType(Creature), to:Battlefield}, intervening_if:$condition_other_battlefield_threshold, limits:_{}, announcement:@announcement, body:$program_exile_subject_delayed_return} */
triggered_other_threshold_exile_return ::= "whenever" "a" "creature" "enters" "," "if" condition_other_battlefield_threshold "," program_exile_subject_delayed_return

/* The event destination used by these programs is the holder's graveyard arrival. */
/* @sem Ability::Triggered{event:$event_self_dies, limits:_{}, announcement:@announcement, body:$death_exile_receipt_program} */
triggered_death_exile_receipt ::= "when" event_self_dies "," death_exile_receipt_program

death_exile_receipt_program ::= program_exile_dead_evidence_return | program_exile_dead_choose_delayed_return

/* The actor and card filter remain independent operands of the discard event. */
/* @sem EventSpec::Discard(_{players:$event_player, cards:$discard_card_filter, kind:Any, grouping:Card}) */
event_player_discards_filtered_card ::= event_player "discards" "a" discard_card_filter "card"

/* A trigger may follow its first instructions with a separately announced
   callback conditioned on the number of times that ability has resolved. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[...$conjoined, ...$resolution_count_callback]}} */
triggered_resolution_count_callback ::= event_clause "," conjoined "." resolution_count_callback "."

/* A battlefield departure retains the opponent controller and its owner separately. */
/* @sem EventSpec::ZoneChange{objects:@and($noun, ObjectFilter::ControlledBy(OpponentsOf(AbilityController)), ObjectFilter::OwnedBy(All)), from:Battlefield, to:Graveyard} */
event_opponent_controlled_graveyard ::= "a" noun "an" "opponent" "controls" "is" "put" "into" "a" "graveyard"

/* The payer refers to the controller of the event subject, not its owner. */
/* @sem Ability::Triggered{event:$event_opponent_controlled_graveyard, limits:TriggerLimits{}, announcement:@announcement, body:$event_controller_unless_life_program} */
triggered_opponent_departure_unless_life ::= "whenever" event_opponent_controlled_graveyard "," event_controller_unless_life_program "."

/* Another object controlled by the ability controller. */
/* @sem ObjectFilter::@and(ObjectFilter::Not(SameObject(Source)), $filter_phrase, ObjectFilter::ControlledBy(One(AbilityController))) */
event_another_controlled ::= "another" filter_phrase "you" "control"

/* @prefer always */
/* @sem ObjectFilter::AllOf([$adjective_color, Not(Token), $noun]) */
event_color_nontoken ::= "a" adjective_color "nontoken" noun

/* The self-return establishes the zone of the triggered ability. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$event_clause, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$graveyard_paid_return_program})} */
graveyard_paid_return_trigger_if ::= event_clause "," "if" condition "," graveyard_paid_return_program "."

/* A resolution payment and its successful-payment branch share the same receipt. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:$graveyard_paid_return}]}, otherwise:Program{}}]} */
graveyard_paid_return_program ::= "you" "may" payment "." "if" "you" "do" "," graveyard_paid_return

graveyard_paid_return ::= graveyard_return_attacking | local_return_hand

/* @sem Operation::Move{objects:One(Source), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}, qualifiers:[]} */
graveyard_return_attacking ::= "return" self_card "from" "your" "graveyard" "to" "the" "battlefield" "tapped" "and" "attacking"

/* The turn event supplies the subject of the optional counter decision. */
/* @sem Ability::Triggered{event:$counter_choice_turn_event, limits:_{}, announcement:@announcement, body:$program_event_counter_choice_threshold} */
triggered_turn_counter_choice_threshold ::= "at" counter_choice_turn_event "," program_event_counter_choice_threshold "."

counter_choice_turn_event ::= counter_choice_each_upkeep | turn_event

/* @prefer always */
/* @sem EventSpec::Turn{point:UpkeepBegins, players:All} */
counter_choice_each_upkeep ::= "the" "beginning" "of" "each" "player's" "upkeep"

/* The limit permits the guarded scalar entry form when the body does not read the event. */
/* @sem Ability::@event_free_once(Ability::Triggered{event:$limited_entry_clause, limits:TriggerLimits{per_turn:1}, announcement:@announcement, body:Program{instructions:$clause_seek_then_tapped_battlefield}}) */
triggered_once_entry_seek_arrival ::= limited_entry_clause "," clause_seek_then_tapped_battlefield "." "this" "ability" "triggers" "only" "once" "each" "turn" "."

/* The upkeep player chooses the target, and the later effect follows that same land. */
/* @sem Ability::Triggered{event:$suspended_each_player_upkeep, limits:_{}, announcement:@announcement, body:$upkeep_counter_land_body} */
upkeep_counter_land_trigger ::= "at" suspended_each_player_upkeep "," upkeep_counter_land_body

/* @sem EventSpec::Turn{point:UpkeepBegins, players:All} */
parity_each_upkeep ::= "the" "beginning" "of" "each" "upkeep"

parity_count_turn ::= parity_each_upkeep | turn_event

/* @sem Ability::Triggered{event:$parity_count_turn, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[@resolution($parity_odd_pump_mana), $parity_even_pump_mana]}} */
parity_count_trigger ::= "at" parity_count_turn "," "count" "the" "number" "of" "permanents" "." parity_odd_pump_mana parity_even_pump_mana

/* The away event keeps the acting player as an independent operand. */
/* @sem EventSpec::Player{event:PlaneswalksAway, players:$event_player} */
planar_away_event ::= event_player "planeswalks" "away" "from" "a" "plane"

/* The warp payment is a property of the cast spell. */
/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:State(Warped)} */
event_cast_warp_cost ::= "you" "cast" "a" "spell" "for" "its" "warp" "cost"

/* The explicit return of this card fixes the scope of the trigger. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$graveyard_return_event, limits:TriggerLimits{}, announcement:@announcement, body:$graveyard_return_perpetual_program})} */
graveyard_return_perpetual_trigger ::= graveyard_return_event "," graveyard_return_perpetual_program "."

graveyard_return_event ::= graveyard_return_warp_when | event_clause

/* @prefer always */
/* @sem $event_cast_warp_cost */
graveyard_return_warp_when ::= "when" event_cast_warp_cost

/* Both alternatives concern the same event subject. */
/* @sem EventSpec::AnyOf([Object{event:LeavesBattlefield, objects:$event_object}, Object{event:BecomesUntapped, objects:$event_object}]) */
event_leaves_or_becomes_untapped ::= event_object "leaves" "the" "battlefield" "or" "becomes" "untapped"

/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:$local_return_hand}]}, otherwise:Program{}}]} */
graveyard_return_hand_payment ::= "you" "may" payment "." "if" "you" "do" "," local_return_hand

/* The return supplies the zone; the receipt connects this payment to its branch. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$graveyard_defined_mana_payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:$graveyard_return_mentioned_card}]}, otherwise:Program{}}]} */
graveyard_return_battlefield_payment ::= "you" "may" graveyard_defined_mana_payment "." "if" "you" "do" "," graveyard_return_mentioned_card

/* The payment names this card before the pronoun. */
/* @sem Operation::Move{objects:One(Source), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
graveyard_return_mentioned_card ::= "return" "it" "from" "your" "graveyard" "to" "the" "battlefield"

/* @sem Cost::Cost{parts:[ManaWithX{mana:[X, ...$mana_symbols], x:Expr::ObjectProperty{object:Source, property:$graveyard_card_stat, information:CurrentOrLastKnown}}]} */
graveyard_defined_mana_payment ::= "pay" "{" "X" "}" mana_symbols "," "where" "X" "is" "this" "card's" graveyard_card_stat

graveyard_card_stat ::= stat_power | stat_toughness

library_graveyard_owner ::= library_graveyard_yours | library_graveyard_opponents

/* @sem ObjectFilter::OwnedBy(OpponentsOf(PlayerRef::AbilityController)) */
library_graveyard_opponents ::= "an" "opponent's" "graveyard" "from" "their" "library"

discard_batch_cards ::= batch_nontype_cards | batch_filtered_cards

/* This event consumes the immediately preceding damage result. */
/* @sem EventSpec::ZoneChange{objects:AllOf([$filter_phrase, DamagedBy(@prior)]), from:Battlefield, to:Graveyard} */
event_damaged_this_way_dies ::= "a" filter_phrase "dealt" "damage" "this" "way" "dies"

/* Count each opponent as recipient of damage from either specified source. */
/* @sem Expr::CountPlayers(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:AnyOf([SameObject($object_ref), $filter_phrase]), recipients:Players(One(Bound(0))), kind:$historical_damage_kind, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}}}])) */
damage_opponent_source_count ::= "the" "number" "of" "your" "opponents" "who" "were" "dealt" historical_damage_kind "by" object_ref "or" counter_amount filter_phrase "this" "turn"

/* The previously announced target supplies the controller of the delayed damage recipient. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(One(ControllerOf(Target{slot:@last_slot, index:0}))), amount:$number, preventable:true}}]} */
death_target_controller_damage_program ::= SELF_NAME "deals" number "damage" "to" "the" "creature's" "controller"

/* The event supplies the defending player used by the linked mana program. */
/* @sem Ability::Triggered{event:Object{event:AttacksAndIsNotBlocked, objects:$event_holder}, limits:_{}, announcement:@announcement, body:$defending_mana_loss_delayed_program} */
triggered_unblocked_defending_mana_loss ::= "whenever" event_holder "attacks" "and" "isn't" "blocked" "," defending_mana_loss_delayed_program

/* @sem EventSpec::Turn{point:DrawStepBegins, players:One(AbilityController)} */
source_tapped_turn_event ::= "the" "beginning" "of" "each" "of" "your" "draw" "steps"

/* @sem EventSpec::AnyOf([Object{event:LeavesBattlefield, objects:SameObject(Source)}, Object{event:BecomesUntapped, objects:SameObject(Source)}]) */
source_leaves_or_untaps ::= "this" "creature" "leaves" "the" "battlefield" "or" "becomes" "untapped"

/* The death event establishes the graveyard arrival used by both phrases. */
/* @sem Ability::Triggered{event:$event_self_dies, limits:_{}, announcement:@announcement, body:$death_arrival_perpetual_program} */
triggered_death_arrival_perpetual ::= "when" event_self_dies "," death_arrival_perpetual_program "."

/* @sem Program::Program{instructions:[...$death_arrival_perpetual_change, $death_arrival_stat_return]} */
death_arrival_perpetual_program ::= death_arrival_perpetual_change "." "then" death_arrival_stat_return

/* @sem Instruction::[Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), changes:$graveyard_suffix_fixed_pump}}] */
death_arrival_perpetual_change ::= "it" "perpetually" graveyard_suffix_fixed_pump

/* @sem Instruction::If{condition:ObjectMatches{object:Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}, filter:Property{property:$stat, test:NumberTest::Compare{comparison:$bound, value:$number}}}, then:_{instructions:[Effect{result:@next, operation:Move{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), destination:$battlefield_control, qualifiers:[]}}]}, otherwise:_{}} */
death_arrival_stat_return ::= "if" "that" "card's" stat "is" number "or" bound "," "return" "it" "to" "the" "battlefield" battlefield_control

/* The delayed death trigger refers to the object selected by the placement. */
/* @prefer always */
/* @sem Ability::Triggered{event:$counter_target_source_attack_clause, limits:TriggerLimits{}, announcement:@announcement, body:$counter_target_death_program} */
triggered_counter_target_death ::= counter_target_source_attack_clause "," counter_target_death_program "."

/* @sem Program::Program{instructions:[$counter_target_placement, $counter_target_death_followup]} */
counter_target_death_program ::= counter_target_placement "." counter_target_death_followup

/* @sem Instruction::Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(SameObject(Source)), $noun_creature, Counters{kind:$vowel_named_counter_2, comparison:Equal, value:Constant(0)}])}), index:0})), kind:$vowel_named_counter, amount:Constant(1)}]}} */
counter_target_placement ::= "put" "an" vowel_named_counter "counter" "on" "another" "target" noun_creature "without" "an" vowel_named_counter "counter" "on" "it"

/* @sem Instruction::Effect{result:@next, operation:CreateDelayedTrigger{event:ZoneChange{objects:SameObject(Target{slot:0, index:0}), from:Battlefield, to:Graveyard}, start:Immediately, intervening_if:ObjectMatches{object:EventSubject, filter:Counters{kind:$vowel_named_counter, comparison:Greater, value:Constant(0)}}, body:$counter_target_death_body}} */
counter_target_death_followup ::= "when" "that" "creature" "dies" "," "if" "it" "has" "an" vowel_named_counter "counter" "on" "it" "," counter_target_death_body

/* @sem EventSpec::Object{event:Attacks, objects:$event_self} */
counter_target_source_attack_clause ::= "whenever" event_self "attacks"

counter_target_death_body ::= counter_target_joined_body | program

/* @prefer always */
/* @sem Program::Program{instructions:$instructions_more_and} */
counter_target_joined_body ::= instructions_more_and

/* The article is valid for both supported named counter forms. */
vowel_named_counter ::= cn_egg | cn_oil

/* A counter event keeps its kind, change and object filter independent. */
/* @sem EventSpec::Counters(_{change:$counter_event_change, kind:$counter_kind, objects:$counter_event_object}) */
event_named_counter_change ::= "a" counter_kind "counter" "is" counter_event_change counter_event_object

counter_event_change ::= counter_event_put | counter_event_removed

/* @sem CounterChange::Put */
counter_event_put ::= "put" "on"

/* @sem CounterChange::Removed */
counter_event_removed ::= "removed" "from"

counter_event_object ::= counter_event_filtered | counter_event_referenced

/* @sem ObjectFilter::$filter_phrase */
counter_event_filtered ::= "a" filter_phrase

/* @sem ObjectFilter::SameObject($object_ref) */
counter_event_referenced ::= object_ref

/* @sem CounterChange::LastRemoved */
counter_removal_last ::= "the" "last"

/* @sem CounterChange::Removed */
counter_removal_one ::= "a"

counter_removal_quantity ::= counter_removal_last | counter_removal_one

/* @sem EventSpec::Counters(_{change:$counter_removal_quantity, kind:$counter_kind, objects:SameObject($object_ref), by:One(AbilityController)}) */
event_you_remove_named_counter ::= "you" "remove" counter_removal_quantity counter_kind "counter" "from" object_ref

/* @sem EventSpec::$event_you_remove_named_counter */
when_you_remove_named_counter ::= "when" event_you_remove_named_counter

/* An intervening cast condition and a graveyard return retain separate operands. */
/* @sem Condition::ObjectMatches{object:EventSubject, filter:NthCast{ordinal:$ordinal, spells:$filter_phrase, by:One(AbilityController), scope:Turn}} */
event_subject_nth_cast_condition ::= "it's" "the" ordinal filter_phrase "spell" "you" "cast" "this" "turn"

/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$event_clause, intervening_if:$event_subject_nth_cast_condition, limits:_{}, announcement:@announcement, body:$graveyard_self_program})} */
triggered_graveyard_self_cast_if ::= event_clause "," "if" event_subject_nth_cast_condition "," graveyard_self_program

/* The historic measure is scoped to the graveyard-leaving batch that supplies it. */
/* @sem Ability::Triggered{event:$event_cards_leave, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PlayersDo{players:One(AbilityController), any_one:false, optional:true, once_each_turn:true, body:[Program($created_graveyard_counter_program)], otherwise:[]}}]}} */
graveyard_batch_optional_created_counters ::= "whenever" event_cards_leave "," "you" "may" created_graveyard_counter_program "." action_once_suffix

/* Preserve the player and count of a discard event in the first-occurrence wrapper. */
/* @sem EventSpec::Discard{players:One(PlayerRef::Active), cards:Any, kind:Any, grouping:Player} */
event_active_discard_many ::= "the" "active" "player" "discards" "one" "or" "more" "cards"

/* The event supplies the count used by this draw instruction. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$event_count_draw_instructions}} */
triggered_event_count_draw ::= event_clause "," event_count_draw_instructions "."

event_count_draw_instructions ::= target_count_instructions | active_event_count_draw

/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(Active), amount:EventAmount}}] */
active_event_count_draw ::= "the" "active" "player" "draws" "that" "many" "cards"

/* A quoted death trigger is evaluated relative to the granted holder. */
/* @sem Ability::Triggered{event:$event_self_dies, limits:TriggerLimits{}, announcement:@announcement, body:$opponents_draw_gain_program} */
counter_granted_ability ::= "when" event_self_dies "," opponents_draw_gain_program "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Draw{players:OpponentsOf(AbilityController), amount:Constant(1)}}, Effect{result:@next, operation:GainLife{players:OpponentsOf(AbilityController), amount:$number}}]} */
opponents_draw_gain_program ::= "each" "opponent" "draws" "a" "card" "and" "gains" number "life"

/* @sem Program::Program{instructions:[$opponent_target_counter_placement, $target_counter_grant]} */
opponent_counter_grant_program ::= opponent_target_counter_placement "." target_counter_grant

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$opponent_counter_grant_program} */
triggered_opponent_counter_grant ::= "at" turn_event "," opponent_counter_grant_program

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$optional_return_creature_property_program} */
turn_optional_return_creature_property ::= "at" turn_event "," optional_return_creature_property_program "."

/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$optional_return_counter_base_grant_program} */
triggered_optional_return_counter_base_grant ::= "at" turn_event "," optional_return_counter_base_grant_program

/* The source and origin are independent operands of the entry event. */
/* @sem EventSpec::ZoneChange{objects:$event_self, from:$self_entry_origin, to:Battlefield} */
event_self_entry_from_zone ::= event_self "enters" "from" self_entry_origin

self_entry_origin ::= self_entry_hand | put_zone_exile

/* @sem Zone::Hand */
self_entry_hand ::= "a" "hand"

/* A controlled singular object's counters qualify the subject across events. */
/* @sem @and($controlled_entry_plain, ObjectFilter::Counters(_{comparison:Greater, value:Constant(0)})) */
event_controlled_with_counters ::= "a" controlled_entry_plain "with" "one" "or" "more" "counters" "on" "it"

/* @sem @and($controlled_entry_plain, ObjectFilter::Counters(_{comparison:Greater, value:Constant(0)})) */
event_controlled_with_counters_an ::= "an" controlled_entry_plain "with" "one" "or" "more" "counters" "on" "it"

/* The death subject supplies the counter count, and the permission refers to
   this specific top-of-library exile receipt. */
/* @sem EventSpec::ZoneChange{objects:$controlled_counter_subject, from:Battlefield, to:Graveyard} */
controlled_counter_death ::= controlled_counter_subject "dies"

controlled_counter_subject ::= event_controlled_with_counters | event_controlled_with_counters_an

/* @sem Ability::Triggered{event:$controlled_counter_death, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:CountCounters{recipients:Objects(One(EventSubject)), information:CurrentOrLastKnown}, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:$play_those_cards_permission}]}} */
triggered_counter_death_exile_play ::= "whenever" controlled_counter_death "," "exile" "that" "many" "cards" "from" "the" "top" "of" "your" "library" "." play_those_cards_permission "."

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$paid_x_return_counter_program} */
triggered_paid_x_return_counter ::= event_clause "," paid_x_return_counter_program "."

/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:SameObject($object_ref), recipients:Players(One(Bound(0))), kind:Combat, grouping:SourceRecipient, subject:Recipient}) */
bound_player_combat_damage_by_object ::= "combat" "damage" "by" object_ref

/* The source is the antecedent of the masculine pronoun in this entry clause. */
/* @sem Ability::Triggered{event:$event_self_enters, limits:TriggerLimits{}, announcement:@announcement, body:$entry_sacrifice_him_unless_program} */
triggered_entry_sacrifice_him_unless ::= "when" event_self_enters "," entry_sacrifice_him_unless_program "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$cost_sacrifice_life_opponent_draw, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:One(Source)})}]}, otherwise:Program{}}]} */
entry_sacrifice_him_unless_program ::= "sacrifice" "him" "unless" "you" cost_sacrifice_life_opponent_draw

/* One batch contains all controlled sources and all players damaged together. */
/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:AllOf([$plural, ControlledBy(One(AbilityController))]), recipients:Players(All), kind:Combat, grouping:Batch, subject:Source}) */
event_controlled_batch_combat_players ::= "one" "or" "more" plural "you" "control" "deal" "combat" "damage" "to" "one" "or" "more" "players"

/* The explanatory count is scoped to its matching trigger event. */
/* @sem Ability::Triggered{event:Player{event:Scries, players:One(AbilityController)}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$scry_event_sized_operation}]}} */
triggered_scry_event_sized_counter ::= "whenever" "you" "scry" "," scry_event_sized_operation "," "where" "X" "is" "the" "number" "of" "cards" "looked" "at" "while" "scrying" "this" "way" "."

/* @sem Ability::Triggered{event:Batch{event:Player{event:MillsCard, players:All, objects:Not(CardType(Land))}, per:Whole}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$event_sized_target_counter}]}} */
triggered_nonland_mill_event_sized_counter ::= "whenever" "one" "or" "more" "nonland" "cards" "are" "milled" "," event_sized_target_counter "," "where" "X" "is" "the" "number" "of" "nonland" "cards" "milled" "this" "way" "."

/* @sem EventSpec::Object{event:Attacks, objects:$event_self} */
event_holder_attacks_for_defender_choice ::= event_self "attacks"

/* @sem Ability::Triggered{event:$event_holder_attacks_for_defender_choice, limits:_{}, body:_{instructions:$choice_defender_sacrifice_or_control_attack}, announcement:@announcement} */
triggered_attack_defender_villainous ::= "whenever" event_holder_attacks_for_defender_choice "," choice_defender_sacrifice_or_control_attack "."

/* This trigger composes with a producer-scoped mill and payment program. */
/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$program_each_mill_exile_copy} */
triggered_each_mill_exile_copy ::= "at" turn_event "," program_each_mill_exile_copy

/* The condition's population is also the random choice's population. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:Compare{left:CountObjects(Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Result{result:@marked, phase:After, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}]}} */
triggered_linked_random_free_cast ::= "at" turn_event "," "if" "there" "are" value "or" "more" "cards" "exiled" "with" object_ref "," "choose" "one" "of" "them" "at" "random" "." "you" "may" "cast" "it" "without" "paying" "its" "mana" "cost" "."

/* The subject of this entry is explicitly a creature, licensing the later
   creature and controller anaphors without changing their identities. */
/* @sem EventSpec::ZoneChange{objects:$entry_damage_creature, to:Battlefield} */
entry_damage_event ::= "whenever" "a" entry_damage_creature "enters"

entry_damage_creature ::= noun_creature | entry_damage_qualified_creature

/* @sem ObjectFilter::@and($adjective, $noun_creature) */
entry_damage_qualified_creature ::= adjective noun_creature

/* @sem Ability::Triggered{event:$entry_damage_event, limits:TriggerLimits{}, announcement:@announcement, body:$entry_controller_damage_program} */
entry_controller_damage_trigger ::= entry_damage_event "," entry_controller_damage_program "."

/* The subject of a death event owns the card returned by this delayed trigger. */
/* @sem Ability::Triggered{event:$event_self_dies, limits:_{}, announcement:@announcement, body:$owner_upkeep_return_program} */
shared_self_death_owner_upkeep ::= "when" event_self_dies "," owner_upkeep_return_program "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:UpkeepBegins, players:One(OwnerOf(EventSubject))}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}]}}}]} */
owner_upkeep_return_program ::= "return" "it" "to" "the" "battlefield" "tapped" "under" "its" "owner's" "control" "at" "the" "beginning" "of" "their" "next" "upkeep"

/* The event and the receipt-scoped program compose independently. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$top_exile_followup_program} */
triggered_top_exile_followup ::= event_clause "," top_exile_followup_program

top_exile_followup_program ::= program_top_exile_type_stats | program_top_exile_dungeon_play

/* @sem Ability::Triggered{event:$aura_upkeep_enchantment_event, limits:_{}, announcement:@announcement, body:$aura_upkeep_prevent_damage} */
aura_upkeep_enchantment ::= "at" aura_upkeep_enchantment_event "," aura_upkeep_prevent_damage "."

/* @sem EventSpec::Turn{point:UpkeepBegins, players:One(ControllerOf(@enchanted_operand(ObjectRef::AttachedTo(Source))))} */
aura_upkeep_enchantment_event ::= "the" "beginning" "of" "the" "upkeep" "of" "enchanted" "enchantment's" "controller"

/* The entry event has no announced target, so the shared limit points to the
   first target introduced by the following operation. */
/* @prefer always */
/* @sem Ability::Triggered{event:ZoneChange{objects:$event_self, to:Battlefield}, limits:_{}, announcement:@announcement, body:_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:$exile_shared_battlefield_graveyard_targets}]}}]}} */
shared_entry_optional_exile_groups ::= "when" event_self "enters" "," "you" "may" exile_shared_battlefield_graveyard_targets "."

/* A controlled entrant is the event subject, independently of its controller. */
/* @sem EventSpec::Player{event:EntersUnderControl, players:All, objects:$controlled_entrant} */
event_controlled_entrant_zone ::= controlled_entrant "enters"

/* @sem Condition::ObjectMatches{object:EventSubject, filter:Not(MadeBy(Source))} */
condition_entrant_not_put_by_ability ::= "it" "wasn't" "put" "onto" "the" "battlefield" "with" "this" "ability"

/* The comparison in the hand-entry instruction refers to this event subject. */
/* @sem Ability::Triggered{event:$event_controlled_entrant_zone, intervening_if:$condition_entrant_not_put_by_ability, limits:_{}, announcement:@announcement, body:_{instructions:$optional_event_stat_hand_entry}} */
triggered_optional_event_stat_entry ::= "whenever" event_controlled_entrant_zone "," "if" condition_entrant_not_put_by_ability "," optional_event_stat_hand_entry "."

/* A quoted damage trigger keeps its own ability frame. */
/* @sem Ability::Triggered{event:$event_combat_damage_player, limits:_{}, announcement:@announcement, body:$ring_threshold_recipient_loss} */
quoted_damage_ring_threshold ::= "whenever" event_combat_damage_player "," ring_threshold_recipient_loss

/* The attachment and creature host are separate event participants. */
/* @sem EventSpec::Pair{event:BecomesAttachedTo, objects:SameObject($object_ref), others:$attachment_host_creature_filter} */
shared_attachment_creature_event ::= "whenever" object_ref "becomes" "attached" "to" "a" attachment_host_creature_filter

attachment_host_creature_filter ::= noun_creature | attachment_host_colored_creature

/* @sem @and($adjective_color, $noun_creature) */
attachment_host_colored_creature ::= adjective_color noun_creature

/* @sem Ability::Triggered{event:$shared_attachment_creature_event, limits:TriggerLimits{}, announcement:@announcement, body:$attachment_host_state_program} */
shared_attachment_host_trigger ::= shared_attachment_creature_event "," attachment_host_state_program "."

/* Turn events can carry the same resolution payment program as other triggers. */
/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$optional_cost_paid_program} */
turn_optional_cost_paid ::= "at" turn_event "," optional_cost_paid_program

/* The batch and its origin threshold refer to the same event group. */
/* @sem EventSpec::Batch{event:Player{event:EntersUnderControl, players:All, objects:AllOf([Not(SameObject(Source)), $filter_plural, ControlledBy(One(AbilityController))])}, per:Whole} */
event_other_controlled_batch_entry ::= "other" filter_plural "you" "control" "enter"

/* @sem Ability::Triggered{event:$event_other_controlled_batch_entry, intervening_if:Compare{left:CountObjects(Matching{objects:EventGroup, filter:$event_group_graveyard_origin_plural}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}, limits:TriggerLimits{per_turn:1}, announcement:@announcement, body:$event_group_copy_program} */
triggered_batch_origin_once ::= "whenever" value "or" "more" event_other_controlled_batch_entry "," "if" "they" event_group_graveyard_origin_plural "," event_group_copy_program "." "this" "ability" "triggers" "only" "once" "each" "turn" "."

/* The attachment and host are distinct event roles; the comparison reads the attachment. */
/* @prefer always */
/* @sem EventSpec::Pair{event:BecomesAttachedTo, objects:AllOf([Subtype(Aura), ControlledBy(One(AbilityController))]), others:AllOf([$adjective_nontype, ControlledBy(OpponentsOf(AbilityController)), Property{property:ManaValue, test:NumberTest::Compare{comparison:$stat_comparison, value:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}}])} */
event_aura_attachment_value ::= "an" "Aura" "you" "control" "becomes" "attached" "to" "a" adjective_nontype "permanent" "an" "opponent" "controls" "with" "mana" "value" stat_comparison "that" "Aura's" "mana" "value"

/* Compose the event and effect without losing either event role. */
/* @prefer always */
/* @sem Ability::Triggered{event:$event_aura_attachment_value, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$gain_control_event_other_while_attached}]}} */
attachment_value_control_trigger ::= "whenever" event_aura_attachment_value "," gain_control_event_other_while_attached "."

/* @sem Ability::Triggered{event:$event_many_die, limits:TriggerLimits{}, announcement:Announcement{}, body:$program_postfix_sacrifice_callback} */
triggered_batch_death_postfix_sacrifice ::= "whenever" event_many_die "," program_postfix_sacrifice_callback "."

/* These event forms introduce no announced targets before the combat pair. */
/* @sem EventSpec::Filtered{event:$event_self_enters, condition:$cast_window_declare_attackers} */
reassign_self_entry_attackers ::= event_self_enters "during" cast_window_declare_attackers

/* @sem EventSpec::Filtered{event:$event_self_enters, condition:$cast_window_declare_blockers} */
reassign_self_entry_blockers ::= event_self_enters "during" cast_window_declare_blockers

reassign_self_entry_event ::= reassign_self_entry_attackers | reassign_self_entry_blockers | event_self_enters

/* @sem Ability::Triggered{event:$reassign_self_entry_event, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence_reassign_attackers} */
reassign_self_entry_trigger ::= "when" reassign_self_entry_event "," program_sentence_reassign_attackers

/* A keyword qualification is reusable independently of the cast event. */
/* @sem ObjectFilter::HasKeyword($keyword_name) */
cast_spell_keyword_qualifier ::= "that" "has" keyword_name

/* The same postposed spell qualifiers compose with the another-spell form. */
/* @sem $cast_another_spell_qualifier */
cast_another_qualified_spell ::= "another" "spell" cast_another_spell_qualifier

/* The follow-up consumes the damage receipt produced in the same program. */
/* @sem Ability::Triggered{event:$damage_receipt_event, limits:TriggerLimits{}, announcement:@announcement, body:$damage_receipt_life_program} */
triggered_damage_receipt_life ::= "whenever" damage_receipt_event "," damage_receipt_life_program "."

damage_receipt_event ::= event_dealt_damage | event_dealt_combat_damage

/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:EventSubject, recipients:$damage_receipt_target, amount:$damage_receipt_amount, preventable:true}}, If{condition:Compare{left:CountPlayers(Intersection([DamagedBy(@last_result), All])), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(DamagedBy(@prior)), changes:[PlayerRule(Prohibit(GainLife))], duration:Indefinite, evaluation:LiveObjects}}]}, otherwise:Program{}}]} */
damage_receipt_life_program ::= "it" "deals" damage_receipt_amount "damage" "to" damage_receipt_target "." "if" "a" "player" "is" "dealt" "damage" "this" "way" "," "they" "can't" "gain" "life" "for" "the" "rest" "of" "the" "game"

/* @sem Expr::EventAmount */
damage_receipt_event_amount ::= "that" "much"

damage_receipt_amount ::= damage_receipt_event_amount | number

/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Not(SameObject(EventSubject))})) */
damage_receipt_other_target ::= "any" "other" "target"

/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly($count_plural), filter:Not(SameObject(EventSubject))})) */
damage_receipt_other_targets ::= count_plural "other" "targets"

damage_receipt_target ::= damage_receipt_other_target | damage_receipt_other_targets | recipients_any_target

/* Combat ends during the controller’s turn, regardless of combat owner. */
/* @sem EventSpec::Filtered{event:Turn{point:CombatEnds, players:All}, condition:PlayerIsActive(AbilityController)} */
turn_end_combat_your_turn ::= "the" "end" "of" "combat" "on" "your" "turn"

/* @sem EventSpec::Spell{event:Copy, players:$event_player, spells:$third_cast_spell_filter} */
event_copy_third ::= event_player "copies" third_cast_spell_filter

/* The blocking object is the other member of this event's block pair. */
/* @sem EventSpec::Pair{event:BecomesBlockedBy, objects:$event_holder, others:AllOf([$noun, Chosen(Color)])} */
event_blocked_by_chosen_color ::= event_holder "becomes" "blocked" "by" "a" noun "of" "that" "color"

/* The turn event binds the player referenced by the offered control transfer. */
/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$program_turn_player_control_attached_untap} */
triggered_turn_player_control_attached_untap ::= "at" turn_event "," program_turn_player_control_attached_untap

/* @sem EventSpec::Object{event:Trains, objects:SameObject($object_ref)} */
event_object_trains_shared ::= "whenever" object_ref "trains"

/* The attached land is the event subject, independently of the Aura. */
/* @sem EventSpec::Object{event:BecomesTapped, objects:SameObject(AttachedTo(Source))} */
attached_land_becomes_tapped ::= "when" "enchanted" "land" "becomes" "tapped"

/* @sem Ability::Triggered{event:$attached_land_becomes_tapped, limits:_{}, announcement:@announcement, body:Program{instructions:[...$destroy_event_subject, $event_land_controller_attach_choice]}} */
triggered_attached_land_action ::= attached_land_becomes_tapped "," destroy_event_subject "." event_land_controller_attach_choice "."

/* The chosen land type and controller constrain the same event subject. */
/* @sem ObjectFilter::AllOf([$event_chosen_land_type, $modifier_opponent_controls]) */
event_chosen_land_type_controlled ::= event_chosen_land_type modifier_opponent_controls

/* @sem ObjectFilter::AllOf([$filter_phrase, Chosen(LandType)]) */
event_chosen_land_type ::= "a" filter_phrase "of" "the" "chosen" "type"

/* The repeated creature and counter category refer to the same batch subject. */
/* @sem EventSpec::FirstForObjectEachTurn(Batch{event:Counters{change:Put, objects:$first_counter_creature}, per:Subject}) */
first_any_counters_on_creature_clause ::= "whenever" "one" "or" "more" "counters" "are" "put" "on" first_counter_creature "," "if" "it's" "the" "first" "time" "counters" "have" "been" "put" "on" "that" "creature" "this" "turn"

/* @sem @and($noun_creature, $modifier_you_control) */
first_counter_creature ::= "a" noun_creature modifier_you_control

/* The cast event supplies the spell referenced by the paid copy continuation. */
/* @sem Ability::Triggered{event:$event_cast, limits:TriggerLimits{}, announcement:@announcement, body:$paid_cast_copy_program} */
triggered_paid_cast_copy ::= "whenever" event_cast "," paid_cast_copy_program

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Mana($mana_symbols)]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:Same}}]}, otherwise:Program{}}]} */
paid_cast_copy_program ::= "you" "may" "pay" mana_symbols "." "if" "you" "do" "," "copy" "it" "."

/* A turn trigger composes with a complete, receipt-scoped two-sentence program. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:$condition, limits:_{}, announcement:@announcement, body:$fronted_exile_card_program} */
triggered_turn_if_fronted_permission ::= "at" turn_event "," "if" condition "," fronted_exile_card_program "."

/* @sem EventSpec::Discard{players:One(AbilityController), cards:Not(SameObject(Source)), kind:Cycling, grouping:Card} */
other_card_cycling_event ::= "whenever" "you" "cycle" "another" "card"

/* The self-referencing card trigger operates across zones. */
/* @sem Ability::Scoped{zones:[Battlefield, Graveyard, Hand, Library, Stack, Exile, Command, Ante], ability:@scope(Ability::Triggered{event:$other_card_cycling_event, limits:TriggerLimits{}, announcement:@announcement, body:$optional_payment_return_program})} */
other_card_cycling_trigger ::= other_card_cycling_event "," optional_payment_return_program

/* @sem PlayerSet::One(PlayerRef::AbilityController) */
attack_player_you ::= "you"

/* @sem PlayerSet::OpponentsOf(PlayerRef::AbilityController) */
attack_player_opponent ::= "one" "of" "your" "opponents"

/* Attack actor and defending opponent retain separate player sets. */
/* @sem EventSpec::Batch{event:Attack{attackers:Any, by:$event_an_opponent, defenders:Players($attack_player_opponent)}, per:Defender} */
event_opponent_attacks_another_defender ::= event_an_opponent "attacks" "another" attack_player_opponent

/* @sem EventSpec::NthEachTurn{event:Spell{event:Cast, players:One(AbilityController), spells:Any}, test:NumberTest::Compare{comparison:Equal, value:$cast_turn_ordinal}} */
event_cast_nth_in_a_turn ::= "you" "cast" "your" cast_turn_ordinal "spell" "in" "a" "turn"

/* A single event union may trigger any ordinary ability body. */
/* @sem EventSpec::AnyOf([Player{event:DiscardsAtRandom, players:One(AbilityController)}, Player{event:FlipsCoins, players:One(AbilityController)}, Player{event:RollsDice, players:One(AbilityController)}, Player{event:SelectsModeAtRandom, players:One(AbilityController)}, Player{event:SelectsTargetsAtRandom, players:One(AbilityController)}]) */
event_random_choices_union ::= "whenever" "you" "discard" "one" "or" "more" "cards" "at" "random" "," "select" "one" "or" "more" "targets" "at" "random" "," "choose" "one" "or" "more" "modes" "at" "random" "," "flip" "one" "or" "more" "coins" "," "or" "roll" "one" "or" "more" "dice"

/* @sem Ability::Triggered{event:ZoneChange{objects:SameObject(Source), to:Battlefield}, limits:_{}, announcement:@announcement, body:$program_exile_x_owner_permission} */
triggered_entry_exile_owned_permission ::= "when" "this" "enchantment" "enters" "," program_exile_x_owner_permission "."

/* The event and its consumer are scoped together: EventAmount counts the damaged opponents in this batch. */
/* @sem Ability::Triggered{event:Damage(_{source_kind:Permanent, sources:$combat_group_source, recipients:Players(OpponentsOf(AbilityController)), kind:Combat, grouping:Batch, subject:Source}), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Draw{count:EventAmount}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:Discard{players:One(AbilityController), amount:EventAmount}}]}, otherwise:Program{}}]}} */
triggered_opponent_batch_draw_discard ::= "whenever" combat_group_source "deal" "combat" "damage" "to" "one" "or" "more" "of" "your" "opponents" "," "you" "may" "draw" "cards" "equal" "to" "the" "number" "of" "opponents" "dealt" "damage" "this" "way" "." "if" "you" "do" "," "discard" "that" "many" "cards" "."

/* A singular object with a bounded power retains its independent filter and threshold. */
/* @sem ObjectFilter::AllOf([$noun, Property{property:Power, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}]) */
event_power_at_most ::= "a" noun "with" "power" number "or" "less"

/* @sem EventSpec::ZoneChange{objects:@and($event_power_at_most, ObjectFilter::OwnedBy(One(PlayerRef::AbilityController))), from:Battlefield, to:Graveyard} */
event_owned_power_graveyard ::= event_power_at_most "is" "put" "into" "your" "graveyard" "from" "the" "battlefield"

/* The difference is scoped to the two properties compared by this trigger. */
/* @sem Ability::Triggered{event:$event_dies, intervening_if:ObjectMatches{object:EventSubject, filter:@agree(ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:Greater, value:ObjectProperty{object:$self_possessive, property:$stat, information:CurrentOrLastKnown}}}, ObjectFilter::Property{property:$stat_2, test:NumberTest::Compare{comparison:Greater, value:ObjectProperty{object:$self_possessive, property:$stat_2, information:CurrentOrLastKnown}}})}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($self_explicit_ref)), kind:$counter_kind, amount:Subtract([ObjectProperty{object:EventSubject, property:$stat, information:CurrentOrLastKnown}, ObjectProperty{object:$self_possessive, property:$stat, information:CurrentOrLastKnown}])}]}}]}} */
triggered_death_property_difference ::= "whenever" event_dies "," "if" "it" "had" stat "greater" "than" self_possessive stat "," "put" "a" "number" "of" counter_kind "counters" "on" self_explicit_ref "equal" "to" "the" "difference" "."

/* A death can be qualified by damage from the ability's source this turn. */
/* @sem EventSpec::ZoneChange{objects:AllOf([$attachment_host_creature_filter, Condition(Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:SameObject(Source), recipients:Objects(SameObject(Candidate)), kind:$received_damage_kind, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:Compare{comparison:GreaterOrEqual, value:Constant(1)}})]), from:Battlefield, to:Graveyard} */
source_damage_death_clause ::= "whenever" "a" attachment_host_creature_filter "dealt" received_damage_kind "by" "this" "creature" "this" "turn" "dies"

/* @sem Ability::Triggered{event:$source_damage_death_clause, limits:TriggerLimits{}, announcement:@announcement, body:$delayed_event_card_return_program} */
triggered_delayed_event_card_return ::= source_damage_death_clause "," delayed_event_card_return_program "."

/* @sem EventSpec::Turn{point:UpkeepBegins, players:All} */
delayed_move_any_upkeep ::= "the" "beginning" "of" "the" "next" "upkeep"

return_next_step ::= delayed_move_end_event | delayed_move_any_upkeep

/* A spell may target either the named recipient or a permanent in the described population. */
/* @sem ObjectFilter::AnyOf([TargetsAny($recipients), TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}))]) */
spell_targets_recipient_or_permanent ::= "a" "spell" "that" "targets" recipients "or" ("a" | "an") filter_phrase

/* A conditional event composes with the source's Aura and linked return. */
/* @prefer always */
/* @sem Ability::Triggered{event:$event_this_enchantment_entry, intervening_if:$event_subject_zone_condition, limits:_{}, announcement:@announcement, body:_{instructions:[$aura_with_made_host, ...$aura_return_attach_delayed_sacrifice]}} */
aura_linked_return_trigger ::= event_this_enchantment_entry "," "if" event_subject_zone_condition "," aura_with_made_host aura_return_attach_delayed_sacrifice "."

/* The contracted subject of the following condition is this entering enchantment. */
/* @sem EventSpec::ZoneChange{objects:SameObject(Source), to:Battlefield} */
event_this_enchantment_entry ::= "when" "this" "enchantment" "enters"

/* A trigger limit applies to the complete event and operation. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{per_turn:1}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$once_per_turn_operation}]}} */
shared_once_per_turn_operation_trigger ::= event_clause "," once_per_turn_operation "." "this" "ability" "triggers" "only" "once" "each" "turn" "."

once_per_turn_operation ::= intensify_owned_named | operation

/* A spell targeting a permanent of the described kind, with no single-target restriction. */
/* @sem ObjectFilter::TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase})) */
spell_targeting_a_permanent ::= "a" "spell" "that" "targets" "a" filter_phrase

/* @sem ObjectFilter::TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase})) */
spell_targeting_an_permanent ::= "a" "spell" "that" "targets" "an" filter_phrase

/* A batch across all attacked players, retaining the attacker filter. */
/* @sem EventSpec::Batch{event:Attack{attackers:$filter_plural, defenders:Players(All)}, per:Whole} */
event_group_attacks_players ::= "one" "or" "more" filter_plural "attack" "one" "or" "more" "players"

/* @sem Ability::Triggered{event:Object{event:Attacks, objects:$event_self}, limits:_{}, announcement:@announcement, body:Program{instructions:$counter_target_two_type_branches}} */
/* @prefer always */
triggered_counter_target_type_branches ::= "whenever" event_self "attacks" "," counter_target_two_type_branches "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:One(EventOther)}}]} */
unattached_host_sacrifice ::= "sacrifice" "that" "permanent" "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Destroy{objects:One(EventOther), regeneration:true}}]} */
unattached_host_destroy ::= "destroy" "that" "permanent" "."

/* A mentor pair keeps the mentored object separate from the mentoring source. */
/* @sem EventSpec::Pair{event:Mentors, objects:SameObject($object_ref), others:$filter_phrase} */
mentor_pair_event ::= object_ref "mentors" "a" filter_phrase

/* The anaphor here refers to the other participant of the mentor pair. */
/* @sem Ability::Triggered{event:$mentor_pair_event, limits:TriggerLimits{}, announcement:@announcement, body:$mentor_program} */
mentor_other_trigger ::= "whenever" mentor_pair_event "," mentor_program

mentor_program ::= mentor_other_program | program_sentence

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$mentor_other_operation}]} */
mentor_other_program ::= mentor_other_operation "."

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(One(EventOther)), kind:$counter_kind, amount:Constant(1)}]} */
mentor_other_counter ::= "put" "a" counter_kind "counter" "on" "that" "creature"

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(One(EventOther)), kind:$counter_kind, amount:Expr::@plural_amount($counter_amount)}]} */
mentor_other_counters ::= "put" counter_amount counter_kind "counters" "on" "that" "creature"

mentor_other_operation ::= mentor_other_counter | mentor_other_counters

/* The crewed Vehicle is the other participant, retained by the consequence. */
/* @sem EventSpec::Pair{event:Crews, objects:SameObject(Source), others:Subtype(Vehicle)} */
event_this_creature_crews_vehicle ::= "whenever" "this" "creature" "crews" "a" "Vehicle"

/* @sem Ability::Triggered{event:$event_this_creature_crews_vehicle, limits:_{}, announcement:@announcement, body:$crewed_vehicle_keyword_sacrifice_program} */
triggered_crewed_vehicle_keyword_sacrifice ::= event_this_creature_crews_vehicle "," crewed_vehicle_keyword_sacrifice_program "."

/* A singular creature blocker remains the same participant in the delayed body. */
/* @sem EventSpec::Pair{event:BecomesBlockedBy, objects:SameObject($self_explicit_ref), others:$additional_creature_spell_filter} */
event_self_blocked_by_creature ::= "whenever" self_explicit_ref "becomes" "blocked" "by" "a" additional_creature_spell_filter

/* @sem Ability::Triggered{event:$event_self_blocked_by_creature, limits:TriggerLimits{}, announcement:@announcement, body:$blocker_delayed_sacrifice_token} */
triggered_blocker_delayed_sacrifice ::= event_self_blocked_by_creature "," blocker_delayed_sacrifice_token "."

/* This event supplies the creature referent in the quoted boon. */
/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:CardType(Creature)} */
boon_creature_cast_event ::= "when" "you" "cast" "a" "creature" "spell"

/* The same boon can follow any supported trigger, including enlist. */
/* @sem Ability::Triggered{event:$one_time_boon_outer_event, limits:TriggerLimits{}, announcement:@announcement, body:$program_one_time_entry_boon} */
triggered_one_time_entry_boon ::= one_time_boon_outer_event "," program_one_time_entry_boon

one_time_boon_outer_event ::= event_clause | enlist_boon_outer_event

/* @sem $event_enlists_filtered */
enlist_boon_outer_event ::= "whenever" event_enlists_filtered

/* An ordinal counts only spells matching the postposed cost qualifier. */
/* @sem EventSpec::NthEachTurn{event:Spell{event:Cast, players:One(AbilityController), spells:$ordinal_spell_cost_qualifier}, test:NumberTest::Compare{comparison:Equal, value:$ordinal_spell_number}} */
event_cast_ordinal_postqualified ::= "you" "cast" "your" ordinal_spell_number "spell" ordinal_spell_cost_qualifier "each" "turn"

ordinal_spell_number ::= ordinal_first | ordinal

ordinal_spell_cost_qualifier ::= spell_with_x_cost | spell_with_phyrexian_cost

/* @sem ObjectFilter::State(HasX) */
spell_with_x_cost ::= "with" "{" "X" "}" "in" "its" "mana" "cost"

/* A named source and a separately filtered permanent each produce a damage event. */
/* @sem EventSpec::AnyOf([Damage{source_kind:Permanent, sources:SameObject($object_ref), recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source}, Damage{source_kind:Permanent, sources:$filter_phrase, recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source}]) */
shared_source_or_filtered_combat_event ::= "whenever" object_ref "or" "an" filter_phrase "deals" "combat" "damage" "to" "a" "player"

/* A resolution choice, rather than the trigger itself, has the turn limit. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PlayersDo{players:One(AbilityController), any_one:false, optional:true, once_each_turn:true, body:[Program{instructions:[Effect{result:@next, operation:$shared_once_resolution_operation}]}], otherwise:[]}}]}} */
shared_trigger_optional_once_action ::= event_clause "," "you" "may" shared_once_resolution_operation "." "do" "this" "only" "once" "each" "turn" "."

/* The excluded ordinal counts the controller's unfiltered spell casts. */
/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:$spell_any} */
controller_cast_any_spell ::= "you" "cast" spell_any

/* @sem NumberTest::Compare{comparison:NotEqual, value:$cast_excluded_ordinal} */
controller_cast_excluded_ordinal ::= "other" "than" "your" cast_excluded_ordinal "spell" "each" "turn"

/* @sem EventSpec::NthEachTurn{event:$controller_cast_any_spell, test:$controller_cast_excluded_ordinal} */
controller_cast_except_ordinal_clause ::= "whenever" controller_cast_any_spell controller_cast_excluded_ordinal

/* Operations here are enclosed by the matching scry event and count explanation. */
scry_event_sized_operation ::= event_sized_target_counter | event_sized_target_tap

/* The excess-damage event supplies the amount consumed by the amass action. */
/* @sem Ability::Triggered{event:$event_singular_excess_damage, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$amass_excess_damage}]}} */
triggered_amass_excess_damage ::= "whenever" event_singular_excess_damage "," amass_excess_damage "."

/* Combat on an opponent's turn supplies the event subject to its body. */
/* @sem EventSpec::Turn{point:CombatBegins, players:OpponentsOf(AbilityController)} */
opponent_combat_event ::= "the" "beginning" "of" "combat" "on" "each" "opponent's" "turn"

/* @sem Ability::Triggered{event:$opponent_combat_event, limits:_{}, announcement:@announcement, body:$opponent_combat_payment_body} */
triggered_opponent_combat_payment ::= "at" opponent_combat_event "," opponent_combat_payment_body

/* @sem Ability::Triggered{event:$opponent_combat_event, intervening_if:$condition, limits:_{}, announcement:@announcement, body:$combat_x_payment_program} */
triggered_opponent_combat_if_payment ::= "at" opponent_combat_event "," "if" condition "," combat_x_payment_program

/* @sem Ability::Triggered{event:$turn_combat, limits:_{}, announcement:@announcement, body:$combat_optional_grant_program} */
triggered_combat_optional_grant ::= "at" turn_combat "," combat_optional_grant_program

/* @sem Ability::Triggered{event:$turn_combat, limits:_{}, announcement:@announcement, body:$dice_table_program} */
triggered_combat_dice_table ::= "at" turn_combat "," dice_table_program

/* A defending player's planeswalkers and that player share the attack batch. */
/* @sem EventSpec::Batch{event:Attack{attackers:Any, by:OpponentsOf(AbilityController), defenders:PlayersAndPlaneswalkers(One(AbilityController))}, per:Defender} */
event_opponent_attacks_you_planeswalkers ::= "an" "opponent" "attacks" "you" "and" "/" "or" "planeswalkers" "you" "control"

/* The selected group remains an announcement target of the outer ability. */
/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:InSet($selected_two_creature_targets), recipients:Any, kind:Combat, grouping:Source, subject:Source}) */
selected_group_combat_event ::= "choose" selected_two_creature_targets "." "until" "your" "next" "turn" "," "whenever" "either" "of" "those" "creatures" "deals" "combat" "damage"

/* The two legal sole-target domains are preserved independently. */
/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:AllOf([$filter_instant_or_sorcery, AnyOf([AllOf([OnStack(SingleTarget), TargetsAny(Players(OpponentsOf(AbilityController)))]), AllOf([OnStack(SingleTarget), TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:ControlledBy(OpponentsOf(AbilityController))}))])])])} */
event_next_cast_opponent_single ::= "when" "you" "next" "cast" "an" filter_instant_or_sorcery "spell" "that" "targets" "only" "a" "single" "opponent" "or" "a" "single" "permanent" "an" "opponent" "controls"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(2)), filter:CardType(Creature)})) */
selected_two_creature_targets ::= "up" "to" "two" "target" "creatures"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$destroy}]} */
cast_entry_destroy_only ::= destroy "."

/* A source attacks in the same batch as at least one creature of the named subtype. */
/* @sem EventSpec::Batch{event:Attack{attackers:$subtype, defenders:Any}, per:Whole, count:[GreaterOrEqual, Constant(1)], including:$self_explicit_ref} */
event_source_and_subtype_attack ::= self_explicit_ref "and" "at" "least" "one" subtype "attack"

/* @sem EventSpec::$event_source_and_subtype_attack */
clause_source_and_subtype_attack ::= "whenever" event_source_and_subtype_attack

/* The bound in this payment is the amount of this exact life-gain event. */
/* @sem Ability::Triggered{event:$event_gain_life, limits:TriggerLimits{}, announcement:@announcement, body:$life_gained_bounded_x_payment} */
life_gain_bounded_payment_trigger ::= "whenever" event_gain_life "," life_gained_bounded_x_payment

/* @prefer always */
/* @sem EventSpec::Turn{point:UpkeepBegins, players:One(ControllerOf(@enchanted_operand(ObjectRef::AttachedTo(Source))))} */
aura_creature_controller_upkeep ::= "the" "beginning" "of" "the" "upkeep" "of" "enchanted" "creature's" "controller"

/* @sem EventSpec::Turn{point:EndStepBegins, players:One(ControllerOf(@enchanted_operand(ObjectRef::AttachedTo(Source))))} */
aura_creature_controller_end_step ::= "the" "beginning" "of" "the" "end" "step" "of" "enchanted" "creature's" "controller"

/* @sem EventSpec::Turn{point:DrawStepBegins, players:One(ControllerOf(@enchanted_operand(ObjectRef::AttachedTo(Source))))} */
aura_creature_controller_draw_step ::= "the" "beginning" "of" "the" "draw" "step" "of" "enchanted" "creature's" "controller"

/* @sem EventSpec::Turn{point:EndStepBegins, players:Matching{binding:0, condition:PlayerState{player:Bound(0), state:Monarch}}} */
turn_monarch_end ::= "the" "beginning" "of" "the" "monarch's" "end" "step"

/* Keep the unqualified end-step spelling for this reusable condition and any body. */
/* @prefer always */
/* @sem Ability::Triggered{event:$turn_end_any, intervening_if:$attachment_threshold_condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence} */
triggered_end_step_attachment_threshold ::= "at" turn_end_any "," "if" attachment_threshold_condition "," program_sentence

/* This phrase's other-permanent exclusion is anchored to the damage source. */
/* @sem Ability::Triggered{event:Damage(_{source_kind:Permanent, sources:$event_self, recipients:Players($combat_damage_player_set), kind:Combat, grouping:SourceRecipient, subject:Source}), limits:TriggerLimits{}, announcement:@announcement, body:$program_optional_other_sacrifice_draw_life} */
triggered_self_combat_sacrifice_receipt ::= "whenever" event_self "deals" "combat" "damage" "to" combat_damage_player_set "," program_optional_other_sacrifice_draw_life "."

/* The becoming player is the ability controller; the trigger composes with any program. */
/* @sem EventSpec::Player{event:BecomesMonarch, players:One(AbilityController)} */
event_whenever_you_become_monarch ::= "whenever" "you" "become" "the" "monarch"

/* The same-value instruction is meaningful only under the discover event that
   supplies its amount. Keep that event and its consumer in one contract. */
/* @sem EventSpec::$controller_discovers */
discover_controller_event_clause ::= "whenever" "you" controller_discovers

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Discover{amount:EventAmount}}}]} */
discover_again_event_value_program ::= "discover" "again" "for" "the" "same" "value" "."

/* @prefer always */
/* @sem Ability::Triggered{event:$discover_controller_event_clause, limits:TriggerLimits{per_turn:1}, announcement:@announcement, body:$discover_again_event_value_program} */
discover_again_limited_trigger ::= discover_controller_event_clause "," discover_again_event_value_program "this" "ability" "triggers" "only" "once" "each" "turn" "."

/* @prefer always */
/* @sem Ability::Triggered{event:$discover_controller_event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$discover_again_event_value_program} */
discover_again_trigger ::= discover_controller_event_clause "," discover_again_event_value_program

/* @prefer always */
/* @sem Ability::Triggered{event:$discover_controller_event_clause, limits:TriggerLimits{per_turn:2}, announcement:@announcement, body:$discover_again_event_value_program} */
discover_again_twice_trigger ::= discover_controller_event_clause "," discover_again_event_value_program "this" "ability" "triggers" "only" "twice" "each" "turn" "."

/* Fixed amounts compose independently of the discover-event value. */
/* @sem Ability::Triggered{event:$discover_controller_event_clause, limits:TriggerLimits{per_turn:1}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$discover_literal_action}]}} */
discover_fixed_limited_trigger ::= discover_controller_event_clause "," discover_literal_action "." "this" "ability" "triggers" "only" "once" "each" "turn" "."

/* @sem Ability::Triggered{event:$discover_controller_event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$discover_literal_action}]}} */
discover_fixed_trigger ::= discover_controller_event_clause "," discover_literal_action "."

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Discover{amount:$discover_literal_number}} */
discover_literal_action ::= "discover" discover_literal_number

discover_literal_number ::= number_digits | number_words

discover_shared_trigger ::= discover_again_limited_trigger | discover_again_trigger | discover_again_twice_trigger | discover_fixed_limited_trigger | discover_fixed_trigger

/* @sem Ability::$discover_shared_trigger */
discover_shared_ability ::= discover_shared_trigger

/* A simultaneous placement across a quantified population is one batch. */
/* @sem EventSpec::Batch{event:Counters(_{change:Put, kind:$counter_kind, objects:$filter_plural}), per:Whole} */
event_quantified_plural_put_counters ::= "one" "or" "more" counter_kind "counters" "are" "put" "on" "one" "or" "more" filter_plural

/* The plural anaphor in the recipe refers to this creature death batch. */
/* @sem EventSpec::Batch{event:ZoneChange{objects:AllOf([Not(Token), CardType(Creature), ControlledBy(One(AbilityController))]), from:Battlefield, to:Graveyard}, per:Whole} */
controlled_nontoken_creature_death_batch ::= "one" "or" "more" "nontoken" "creatures" "you" "control" "die"

/* @sem EventSpec::Batch{event:ZoneChange{objects:AllOf([CardType(Creature), ControlledBy(One(AbilityController))]), from:Battlefield, to:Graveyard}, per:Whole} */
controlled_creature_death_batch ::= "one" "or" "more" "creatures" "you" "control" "die"

batch_creature_death ::= controlled_nontoken_creature_death_batch | controlled_creature_death_batch

/* @sem Ability::Triggered{event:$batch_creature_death, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$create_batch_stat_token}]}} */
triggered_batch_creature_stat_token ::= "whenever" batch_creature_death "," create_batch_stat_token "."

cast_spell_ordinal ::= ordinal_first | ordinal

/* A single source's damage to a group of objects and players. */
/* @sem DamageRecipients::ObjectsAndPlayers{objects:$filter_plural, players:All} */
damage_batch_objects_and_players ::= "one" "or" "more" filter_plural "and" "/" "or" "players"

/* @sem EventSpec::Damage(DamageEvent{source_kind:Any, sources:$source_color_yours, recipients:$damage_batch_objects_and_players, kind:Any, grouping:Source, subject:Source}) */
controlled_colored_source_damage_batch ::= source_color_yours "deals" "damage" "to" damage_batch_objects_and_players

/* @sem EventSpec::$controlled_colored_source_damage_batch */
whenever_controlled_colored_source_damage_batch ::= "whenever" controlled_colored_source_damage_batch

/* Restrict the anaphor in the delayed action to a block-pair event. */
/* @sem Ability::Triggered{event:$event_blocks_object, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$combat_pair_delayed_return}]}} */
triggered_block_pair_delayed_return ::= "whenever" event_blocks_object "," combat_pair_delayed_return "."

/* The sticker recipient and the actor remain independent. */
/* @sem EventSpec::Player{event:PutsSticker, players:One(AbilityController), objects:SameObject($object_ref)} */
event_you_put_sticker_on_object ::= "you" "put" "a" "sticker" "on" object_ref

/* The damage event binds a source object and a recipient player independently. */
/* @sem Ability::Triggered{event:$event_combat_damage_player, limits:_{}, announcement:@announcement, body:$program_hidden_event_player_card} */
triggered_combat_player_hidden_card ::= "whenever" event_combat_damage_player "," program_hidden_event_player_card

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$program_conditional_postposed_else} */
triggered_postposed_conditional ::= event_clause "," program_conditional_postposed_else "."

/* Batch attackers remain grouped by the defending player. */
/* @sem EventSpec::Batch{event:Attack{attackers:$filter_plural, defenders:PlayersAndPlaneswalkers(OpponentsOf(AbilityController))}, per:Defender} */
event_batch_attack_opponents_walkers ::= "one" "or" "more" filter_plural "attack" "one" "of" "your" "opponents" "or" "a" "planeswalker" "they" "control"

/* @sem EventSpec::Batch{event:Attack{attackers:$filter_plural, defenders:Players(OpponentsOf(AbilityController))}, per:Defender} */
event_batch_attack_opponents ::= "one" "or" "more" filter_plural "attack" "one" "of" "your" "opponents"

/* The attacker and the counted population are independent operands. */
/* @sem EventSpec::Batch{event:Attack{attackers:$filter_plural, by:$exact_attack_actor, defenders:Any}, per:Whole, count:[Equal, $value]} */
event_team_attacks_exactly ::= exact_attack_actor "with" "exactly" value filter_plural

/* The entrant's controller is part of the caused event, independently of
   the ability whose trigger is copied. */
/* @sem EventSpec::ZoneChange{objects:@and($noun_creature, ObjectFilter::ControlledBy($entry_cause_controller)), to:Battlefield} */
entry_as_trigger_cause ::= "a" noun_creature "entering" "under" entry_cause_controller "control"

/* @sem PlayerSet::OpponentsOf(PlayerRef::AbilityController) */
entry_cause_opponent ::= "an" "opponent's"

/* @sem PlayerSet::One(PlayerRef::AbilityController) */
entry_cause_your ::= "your"

entry_cause_controller ::= entry_cause_opponent | entry_cause_your

trigger_cause_creature ::= attack_as_trigger_cause | entry_as_trigger_cause

/* A turn trigger can contain a complete conditional replacement sentence. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence_prefix_conditional_instead} */
triggered_turn_if_replacement_sentence ::= "at" turn_event "," "if" condition "," program_sentence_prefix_conditional_instead

/* The creature antecedent is the dying enchanted creature returned by the body. */
/* @sem Ability::Triggered{event:$kin_enchanted_creature_death, limits:TriggerLimits{}, announcement:@announcement, body:$program_event_return_delayed_attachment} */
trigger_enchanted_return_attachment ::= "when" kin_enchanted_creature_death "," program_event_return_delayed_attachment "."

/* A reusable event and a scoped target/return instruction sequence. */
/* @sem Ability::Triggered{event:$event_controller_attacks, limits:TriggerLimits{}, body:Program{instructions:$retirement_attacker_unblockable_return}, announcement:@announcement} */
retirement_trigger_attacker_return ::= "whenever" event_controller_attacks "," retirement_attacker_unblockable_return "."

/* A recurring turn event can use the scoped exile-and-copy payment program. */
/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$exile_graveyard_card_copy_token_program} */
triggered_turn_exile_graveyard_copy ::= "at" turn_event "," exile_graveyard_card_copy_token_program

/* Name the active player explicitly when a trigger body refers to that player. */
/* @sem EventSpec::Turn{point:$explicit_each_player_step, players:All} */
explicit_each_player_turn ::= "the" "beginning" "of" "each" "player's" explicit_each_player_step

explicit_each_player_step ::= explicit_each_upkeep | explicit_each_draw_step | explicit_each_end_step

/* @sem TurnPoint::UpkeepBegins */
explicit_each_upkeep ::= "upkeep"

/* @sem TurnPoint::DrawStepBegins */
explicit_each_draw_step ::= "draw" "step"

/* @sem TurnPoint::EndStepBegins */
explicit_each_end_step ::= "end" "step"

/* @prefer always */
/* @sem Ability::Triggered{event:$explicit_each_player_turn, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$instructions_random_hand_exile_play_cleanup}} */
triggered_each_player_random_hand_permission ::= "at" explicit_each_player_turn "," instructions_random_hand_exile_play_cleanup "."

/* The defending population shares the batch across all attacks. */
/* @sem EventSpec::Batch{event:Attack{attackers:Any, defenders:Players($combat_batch_recipients)}, per:Whole} */
event_passive_attacked_batch ::= combat_batch_recipients "are" "attacked"

/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$self_damage_unless_other_sacrifice_tap_program} */
triggered_turn_self_damage_unless_other_sacrifice_tap ::= "at" turn_event "," self_damage_unless_other_sacrifice_tap_program

/* Compose independent arrivals, preserving each event and its object filter. */
/* @sem EventSpec::AnyOf([$event_put_your_graveyard, $event_card_from_elsewhere]) */
event_owned_graveyard_alternatives ::= event_put_your_graveyard "or" event_card_from_elsewhere

/* The same singular subject supplies both alternative events. */
/* @sem EventSpec::AnyOf([Damage(_{source_kind:Permanent, sources:$event_singular_subject, recipients:Players($combat_damage_player_set), kind:$shared_damage_kind, grouping:SourceRecipient, subject:Source}), ZoneChange{objects:$event_singular_subject, from:Battlefield, to:Graveyard}]) */
shared_damage_or_death_clause ::= "whenever" event_singular_subject "deals" shared_damage_kind "to" combat_damage_player_set "or" "dies"

/* Compose independently specified entry and death events. */
/* @sem EventSpec::AnyOf([$event_enters, $event_dies]) */
event_entry_or_death ::= event_enters "or" event_dies

/* The pronoun refers to the trigger's event subject; the placement remains
   reusable across event clauses and retains the counter operands. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(EventSubject)), kind:$counter_kind, amount:$counter_amount}]}}]} */
event_subject_her_counter_program ::= "put" counter_amount counter_kind named_event_counter_word "on" "her"

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$event_subject_her_counter_program} */
triggered_event_subject_her_counter ::= event_clause "," event_subject_her_counter_program "."

/* The referenced group is the batch of attacking creatures, not all attackers. */
/* @sem EventSpec::Batch{event:Attack{attackers:@and($subtype_negated, ObjectFilter::CardType(Creature)), by:One(AbilityController), defenders:Any}, per:Whole, count:[GreaterOrEqual, $count]} */
event_attack_with_non_subtype_creatures ::= "whenever" "you" "attack" "with" count "or" "more" subtype_negated "creatures"

/* @sem EventSpec::Batch{event:Attack{attackers:CardType(Creature), by:One(AbilityController), defenders:Any}, per:Whole, count:[GreaterOrEqual, $count]} */
event_attack_with_creatures_shared ::= "whenever" "you" "attack" "with" count "or" "more" "creatures"

attack_creature_batch_clause ::= event_attack_with_non_subtype_creatures | event_attack_with_creatures_shared

/* @sem Ability::Triggered{event:$attack_creature_batch_clause, limits:TriggerLimits{}, announcement:@announcement, body:$event_group_counter_program} */
triggered_attacker_group_counters ::= attack_creature_batch_clause "," event_group_counter_program "."

death_alternative_destination ::= death_destination_exile | death_destination_command

/* @sem Zone::Exile */
/* @prefer always */
death_destination_exile ::= "exile" "from" "the" "battlefield"

/* @sem Zone::Command */
death_destination_command ::= "the" "command" "zone"

/* The count refers to the kind tested on the event subject; the placed kind
   and the recipient are independent operands. */
/* @sem Ability::Triggered{event:$event_clause, intervening_if:ObjectMatches{object:EventSubject, filter:Counters{kind:$counter_kind, comparison:Greater, value:Constant(0)}}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind_2, amount:CountCounters{recipients:Objects(One(EventSubject)), kind:$counter_kind, information:CurrentOrLastKnown}}]}}]}}]}} */
triggered_event_counter_kind_transfer ::= event_clause "," "if" "it" "had" "one" "or" "more" counter_kind "counters" "on" "it" "," "you" "may" "put" "that" "many" counter_kind "counters" "on" affected "."

/* Both subjects retain their own filters when the shared death verb applies. */
/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:$event_referenced_subject, from:Battlefield, to:Graveyard}, EventSpec::ZoneChange{objects:$event_a, from:Battlefield, to:Graveyard}) */
event_reference_or_indefinite_death ::= event_referenced_subject "or" event_a "dies"

/* The event binds the recipient used by the compositional counter action. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$put_event_subject_him_counters}]}} */
triggered_event_subject_him_counters ::= event_clause "," put_event_subject_him_counters "."

/* @sem StackTrait::Keyword(Boast) */
/* @prefer always */
activation_trait_boast ::= "boast"

/* @sem StackTrait::Keyword(PowerUp) */
activation_trait_power_up ::= "power-up"

/* A repeated trigger word joins two independently specified events. */
/* @sem EventSpec::@either_event($event_enters, $event_activation_you) */
/* @prefer always */
entry_and_activation_clause ::= "whenever" event_enters "and" "whenever" event_activation_you

/* The native controlled-entry form also prints its current operands. */
/* @sem EventSpec::@either_event($event_controlled_enters, $event_activation_you) */
/* @prefer always */
controlled_entry_and_activation_clause ::= "whenever" event_controlled_enters "and" "whenever" event_activation_you

/* A singular event over four independently described alternatives. */
/* @sem EventSpec::Object{event:BecomesTapped, objects:$event_four_alternative_filter} */
event_four_alternatives_becomes_tapped ::= "a" event_four_alternative_filter "becomes" "tapped"

/* @sem ObjectFilter::AnyOf([$filter_plain, $filter_plain_2, $filter_plain_3, $filter_plain_4]) */
event_four_alternative_filter ::= filter_plain "," filter_plain "," filter_plain "," "or" filter_plain

/* A once-per-turn sentence qualifies an intervening-if trigger as a whole. */
/* @sem TriggerLimits::TriggerLimits{per_turn:1} */
trigger_once_each_turn_suffix ::= "this" "ability" "triggers" "only" "once" "each" "turn" "."

/* @sem Ability::Triggered{event:$event_clause, intervening_if:$condition, limits:$trigger_once_each_turn_suffix, announcement:@announcement, body:$program_sentence} */
triggered_if_with_limit ::= event_clause "," "if" condition "," program_sentence trigger_once_each_turn_suffix

/* The source's death establishes the graveyard event destination. */
/* @sem Ability::Triggered{event:$event_self_dies, limits:TriggerLimits{}, announcement:@announcement, body:$optional_action_event_graveyard} */
triggered_death_optional_action_followup ::= "when" event_self_dies "," optional_action_event_graveyard "."

/* @prefer always */
/* @sem Program::Program{instructions:$target_union_body} */
target_union_single_sentence ::= target_union_body "."

/* The additional draw is conditional on choosing the first draw. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Draw{count:$card_count}]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[If{condition:$target_union_followup_condition, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$target_union_extra_count}}]}}]}, otherwise:Program{}}]}, otherwise:Program{}}]} */
target_union_optional_draw_followup ::= "you" "may" "draw" card_count "." "you" "may" "draw" target_union_extra_count "if" target_union_followup_condition "."

target_union_followup_condition ::= target_union_named_enchanted | condition

/* @prefer always */
/* @sem Condition::ObjectMatches{object:$self_ref_named, filter:State(Enchanted)} */
target_union_named_enchanted ::= self_ref_named "is" "enchanted"

target_union_extra_count ::= target_union_extra_one | target_union_extra_many

/* @sem Expr::Constant(1) */
target_union_extra_one ::= "an" "additional" "card"

/* @sem $count */
target_union_extra_many ::= count "additional" "cards"

/* @sem Ability::Triggered{event:$turn_event, intervening_if:$condition_control, limits:_{}, announcement:@announcement, body:$look_sacrifice_mana_value_entry} */
triggered_turn_control_sacrifice_entry ::= "at" turn_event "," "if" condition_control "," look_sacrifice_mana_value_entry

/* Copy events retain the copying player and the spell filter. */
/* @sem EventSpec::Spell{event:Copy, players:$event_player, spells:$third_cast_spell_filter} */
event_third_copy_spell ::= event_player "copies" third_cast_spell_filter

/* The single-target anaphor and retargeted object refer to this spell event. */
spell_retarget_event ::= event_cast | event_cast_third | event_cast_from_hand | event_third_copy_spell | event_you_copy_spell

/* @sem Ability::Triggered{event:$spell_retarget_event, intervening_if:$condition_event_spell_single_target, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$spell_event_retarget_action}]}} */
triggered_spell_single_target_retarget ::= "whenever" spell_retarget_event "," "if" condition_event_spell_single_target "," spell_event_retarget_action "."

/* This event fixes the attachment to a land; the event subject remains the
   land even if the Aura later becomes attached elsewhere. */
/* @sem EventSpec::Object{event:BecomesTapped, objects:SameObject(AttachedTo(Source))} */
shared_enchanted_land_tapped ::= "when" "enchanted" "land" "becomes" "tapped"

/* @sem Ability::Triggered{event:$shared_enchanted_land_tapped, limits:_{}, announcement:@announcement, body:Program{instructions:[...$shared_event_subject_damage_pair, ...$shared_event_controller_attach_choice]}} */
shared_enchanted_land_damage_trigger ::= shared_enchanted_land_tapped "," shared_event_subject_damage_pair "." shared_event_controller_attach_choice "."

/* The roll result belongs to the visit event, and the return phrase proves the
   holder's graveyard scope. Each component retains its own operands. */
/* @sem EventSpec::Player{event:RollsToVisit, players:One(AbilityController)} */
visit_attractions_roll_event ::= "whenever" "you" "roll" "to" "visit" "your" "Attractions"

/* @sem Condition::Compare{left:EventAmount, test:$die_result_test} */
visit_attractions_roll_condition ::= "you" "roll" "a" die_result_test

/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$delayed_graveyard_self_move}]}}]} */
optional_graveyard_self_battlefield_return ::= "you" "may" delayed_graveyard_self_move "."

/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$visit_attractions_roll_event, intervening_if:$visit_attractions_roll_condition, limits:TriggerLimits{}, announcement:@announcement, body:$optional_graveyard_self_battlefield_return})} */
graveyard_visit_roll_trigger ::= visit_attractions_roll_event "," "if" visit_attractions_roll_condition "," optional_graveyard_self_battlefield_return

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$optional_sacrifice_shared_choice} */
turn_optional_sacrifice_shared_choice ::= "at" turn_event "," optional_sacrifice_shared_choice

/* A cast spell's mana value is compared with the current counter population. */
/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:CountCounters(_{recipients:Objects(One($self_ref_holder)), kind:$counter_kind, information:CurrentOrLastKnown})}}} */
event_cast_mana_value_equal_counters ::= "whenever" "you" "cast" "a" "spell" "with" "mana" "value" "equal" "to" "the" "number" "of" counter_kind "counters" "on" self_ref_holder

/* The amount anaphor is licensed by this particular mana-value event. */
/* @sem Ability::Triggered{event:$event_cast_mana_value_equal_counters, limits:TriggerLimits{}, announcement:@announcement, body:$cast_mana_value_damage_then_program} */
triggered_cast_mana_value_damage_then ::= event_cast_mana_value_equal_counters "," cast_mana_value_damage_then_program

/* An opponent-controlled attacker remains the subject of the event. */
/* @sem EventSpec::Object{event:Attacks, objects:AllOf([$noun, ControlledBy(OpponentsOf(AbilityController))])} */
shared_opponent_attacker ::= "whenever" "a" noun "an" "opponent" "controls" "attacks"

/* @sem Ability::Triggered{event:$shared_opponent_attacker, intervening_if:$shared_you_defending_attacker, limits:TriggerLimits{}, announcement:@announcement, body:$shared_event_controller_unless_mana} */
shared_opponent_attacker_defending_trigger ::= shared_opponent_attacker "," "if" shared_you_defending_attacker "," shared_event_controller_unless_mana "."

/* The first combat ending during the ability controller’s turn. */
/* @sem EventSpec::Filtered{event:FirstEachTurn(Turn{point:CombatEnds, players:All}), condition:PlayerIsActive(AbilityController)} */
turn_first_combat_end_your_turn ::= "the" "end" "of" "the" "first" "combat" "phase" "on" "your" "turn"

/* A counter placement followed by a conditional replacement of another
   placement remains a sequence: the first action is never conditional. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$put_counters_direct}, ...$instead_counters_leading]} */
counter_then_conditional_counter_program ::= put_counters_direct "." NEWLINE? instead_counters_leading "."

/* @prefer always */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$counter_then_conditional_counter_program} */
triggered_counter_then_conditional ::= event_clause "," counter_then_conditional_counter_program

/* The repeated population belongs to the intervening condition and to the
   choice consumed by the copy. Keep the references in this one scope. */
/* @sem Ability::Triggered{event:$event_cast, intervening_if:Controls{player:AbilityController, filter:AllOf([@agree(@agree($plural_atomic, $plural_atomic_2), $noun), Not(SameObject(Source)), TargetableBy(EventSubject)]), minimum:1}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree(@agree($plural_atomic, $plural_atomic_2), $noun), ControlledBy(One(AbilityController)), Not(SameObject(Source)), TargetableBy(EventSubject)])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:To(One(Result{result:@prior, phase:After, index:0}))}}]}} */
triggered_cast_choose_legal_copy ::= "whenever" event_cast "," "if" "you" "control" "one" "or" "more" "other" plural_atomic "that" "spell" "could" "target" "," "choose" "one" "of" "those" plural_atomic "." "copy" "that" "spell" "." "the" "copy" "targets" "the" "chosen" noun "."

/* The sole target belongs to an opponent, independently of the spell's kind. */
/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:@and($spell_adjectives, @and(ObjectFilter::OnStack(SingleTarget), ObjectFilter::TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(OpponentsOf(AbilityController)))}))))} */
event_cast_single_opponent_permanent ::= "you" "cast" "an" spell_adjectives "spell" "that" "targets" "only" "a" "single" filter_phrase "an" "opponent" "controls"

/* The trigger, its intervening condition, and its offered action compose. */
/* @sem Ability::Triggered{event:$event_cast, intervening_if:$condition_first_three_cast_types, limits:_{}, announcement:@announcement, body:$optional_opponent_draw_followup} */
triggered_first_cast_types_offer ::= "whenever" event_cast "," "if" condition_first_three_cast_types "," optional_opponent_draw_followup

/* This cast event proves that the spell's sole target is the ability source. */
event_cast_only_source ::= event_cast_only_source_either | event_cast_only_source_general

/* Prefer the ordinary two-branch spelling over a comma-list for this event. */
/* @prefer always */
/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:@and($spell_adjective_either, @and(ObjectFilter::OnStack(SingleTarget), ObjectFilter::TargetsAny(Objects(One($self_ref)))))} */
event_cast_only_source_either ::= "you" "cast" ("a" | "an") spell_adjective_either "spell" "that" "targets" "only" self_ref

/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:$spell_targets_only_self} */
event_cast_only_source_general ::= "you" "cast" spell_targets_only_self

/* The paired action's "other" excludes the source proved by the event. */
/* @sem Ability::Triggered{event:$event_cast_only_source, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$clause_copy_spell_each_other_controlled}} */
triggered_cast_only_source_copy_others ::= "whenever" event_cast_only_source "," clause_copy_spell_each_other_controlled "."

/* The postposed condition refers to this same departing subject. */
/* @sem ObjectEvent::LeavesWithoutDying */
singular_object_leaves_if_not_die ::= "leaves" "the" "battlefield" "," "if" "it" "didn't" "die"

/* A singular event subject retains its own controller and state restrictions. */
/* @sem ObjectFilter::@and($filter_phrase, $modifier_you_control, $modifier_singular_enchanted_or_equipped) */
event_controlled_singular_relative ::= "a" filter_phrase modifier_you_control modifier_singular_enchanted_or_equipped

/* The defending player is determined by the unblocked event's attacker. */
/* @sem Condition::Compare{left:CountPlayers(Intersection([One(AbilityController), One(DefendingPlayerOf(EventSubject))])), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
unblocked_defending_controller ::= "you're" "the" "defending" "player"

/* The blocking token refers to the attacker introduced by this event. */
/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[$token_group], entry:BattlefieldArrival{tapped:false, counters:[], states:[Blocking(EventSubject)]}} */
create_token_blocking_event_subject ::= "create" token_group "that's" "blocking" "that" "creature"

/* The event, condition and token program share the same attacker identity. */
/* @sem Ability::Triggered{event:$event_unblocked, intervening_if:$unblocked_defending_controller, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$create_token_blocking_event_subject}]}} */
triggered_unblocked_defending_controller ::= "whenever" event_unblocked "," "if" unblocked_defending_controller "," create_token_blocking_event_subject "."

/* A cast whose sole target is a controlled permanent matching either kind. */
/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:AllOf([$single_controlled_target_cast_intro, TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$controlled_target_kind_pair, ControlledBy(One(AbilityController))])}))])} */
event_cast_single_controlled_kind_pair ::= single_controlled_target_cast_intro controlled_target_kind_pair "you" "control"

/* @sem ObjectFilter::OnStack(SingleTarget) */
single_controlled_target_cast_intro ::= "you" "cast" "a" "spell" "that" "targets" "only" "a" "single"

controlled_target_kind_pair ::= controlled_target_noncreature_or_creature | controlled_target_any_kind_pair

/* @sem ObjectFilter::AnyOf([$noun_noncreature, $noun_creature]) */
/* @prefer always */
controlled_target_noncreature_or_creature ::= noun_noncreature "or" noun_creature

/* @sem ObjectFilter::AnyOf([$noun, $noun_2]) */
controlled_target_any_kind_pair ::= noun "or" noun

/* Zone-entry spelling retains the entrant's controller restriction. */
/* @sem EventSpec::ZoneChange{objects:$controlled_entry_filter, to:Battlefield} */
shared_controlled_entry_zone_clause ::= "whenever" "a" controlled_entry_filter "enters"

/* The pronoun in the linked-token population names this departing holder. */
/* @sem Ability::Triggered{event:$event_self_leaves, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$delayed_linked_token_move}]}} */
triggered_source_leaves_linked_tokens ::= "when" event_self_leaves "," delayed_linked_token_move "."

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$program_unless_player_pays_defined_x} */
triggered_unless_player_pays_defined_x ::= event_clause "," program_unless_player_pays_defined_x "."

/* The ordinal is per casting player, over the qualified spells. */
/* @sem EventSpec::NthEachTurn{event:Spell{event:Cast, players:$event_player, spells:$spell_adjectives}, test:NumberTest::Compare{comparison:Equal, value:Expr::Constant(1)}} */
event_clause_player_first_qualified_spell ::= "whenever" event_player "casts" "their" "first" spell_adjectives "spell" "each" "turn"

/* @sem Ability::Triggered{event:$event_clause, intervening_if:$shared_holder_is_a_filter, limits:TriggerLimits{}, announcement:@announcement, body:$shared_it_becomes_vowel_type} */
shared_trigger_holder_condition_animation ::= event_clause "," "if" shared_holder_is_a_filter "," shared_it_becomes_vowel_type

/* The condition supplies the object and counter kind counted by the token's
   entry, so the anaphor cannot escape this trigger's scope. */
/* @sem Ability::Triggered{event:$event_self_dies, intervening_if:ObjectMatches{object:Source, filter:@agree(ObjectFilter::Counters{kind:$counter_kind, comparison:GreaterOrEqual, value:$value}, ObjectFilter::Counters{kind:$counter_kind_2, comparison:GreaterOrEqual, value:$value})}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_move_any_end, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:Copy{object:EventSubject, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Divide{numerator:CountCounters{recipients:Objects(One(EventSubject)), kind:$counter_kind, information:CurrentOrLastKnown}, denominator:Constant(2), rounding:$rounding_words}]], states:[]}}}]}}}]}} */
triggered_death_counter_copy_entry ::= "when" event_self_dies "," "if" "it" "had" value "or" "more" counter_kind "counters" "on" "it" "," "create" token_copy_single "it" "at" delayed_move_any_end "." "the" "token" "enters" "with" "half" "that" "many" counter_kind "counters" "on" "it" "," rounding_words "."

/* The explicit self-entry event proves the cost condition's event subject. */
/* @sem Ability::Triggered{event:$event_self_enters, limits:_{}, announcement:@announcement, body:$entry_subject_cost_replacement} */
triggered_self_entry_cost_replacement ::= "when" event_self_enters "," entry_subject_cost_replacement

/* Restrict the anaphor in the payment program to this creature recipient. */
/* @sem EventSpec::Damage{source_kind:Permanent, sources:$event_object, recipients:Objects(CardType(Creature)), kind:Combat, grouping:SourceRecipient, subject:Source} */
combat_damage_creature_payment_event ::= event_object "deals" "combat" "damage" "to" "a" "creature"

/* @prefer always */
/* @sem Ability::Triggered{event:$combat_damage_creature_payment_event, limits:TriggerLimits{}, announcement:@announcement, body:$damaged_creature_controller_unless_program} */
combat_damage_creature_unless_payment_trigger ::= "whenever" combat_damage_creature_payment_event "," damaged_creature_controller_unless_program "."

/* @sem EventSpec::Turn{point:EndStepBegins, players:One(Chosen)} */
chosen_player_next_end_event ::= "the" "beginning" "of" "that" "player's" "next" "end" "step"

/* Damage is grouped by the damaging creature and the attached planeswalker;
   the event subject is the creature, not the Aura or its host. */
/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:$attached_host_damage_creature, recipients:Objects(SameObject(AttachedTo(Source))), kind:Any, grouping:SourceRecipient, subject:Source}) */
attached_planeswalker_damage_event ::= "whenever" "a" attached_host_damage_creature "deals" "damage" "to" "enchanted" "planeswalker"

attached_host_damage_creature ::= noun_creature | attached_host_damage_colored_creature

/* @sem @and($adjective_color, $noun_creature) */
attached_host_damage_colored_creature ::= adjective_color noun_creature

/* The creature event and its demonstrative action share the event subject. */
/* @sem Ability::Triggered{event:$attached_planeswalker_damage_event, limits:_{}, announcement:@announcement, body:_{instructions:$retirement_event_action}} */
attached_planeswalker_damage_trigger ::= attached_planeswalker_damage_event "," retirement_event_action "."

/* @sem Expr::EventHistory{event:Damage(_{source_kind:Any, sources:Any, recipients:ObjectsAndPlayers{objects:Any, players:All}, kind:Any, grouping:SourceRecipient, subject:Source}), window:ThisTurn, measure:MostFromOneSource} */
damage_history_definition ::= "the" "greatest" "amount" "of" "damage" "dealt" "by" "a" "source" "to" "a" "permanent" "or" "player" "this" "turn"

/* A referenced object or another controlled legendary object crews a matching object. */
/* @sem EventSpec::AnyOf([Pair{event:Crews, objects:SameObject($object_ref), others:$filter_phrase_2}, Pair{event:Crews, objects:AllOf([Not(SameObject($object_ref)), Supertype(Legendary), $filter_phrase, ControlledBy(One(AbilityController))]), others:$filter_phrase_2}]) */
event_reference_or_another_crews ::= object_ref "or" "another" "legendary" filter_phrase "you" "control" "crews" "a" filter_phrase

/* The roll condition uses this triggering roll, never another event amount. */
/* @prefer always */
/* @sem Ability::Triggered{event:$event_roll_result, limits:TriggerLimits{}, announcement:@announcement, body:$roll_trigger_program} */
roll_trigger_with_tests ::= "whenever" event_roll_result "," roll_trigger_program "."

/* @sem Program::Program{instructions:[...$roll_effect, ...$roll_test_followups]} */
roll_trigger_program ::= roll_effect "." roll_test_followups

roll_test_followups ::= roll_test_followup | roll_test_followup_more

/* @sem Instruction::[If{condition:$condition_trigger_roll_comparison, then:Program{instructions:$roll_effect}, otherwise:Program{}}] */
roll_test_followup ::= "if" condition_trigger_roll_comparison "," roll_effect

/* @sem Instruction::[...$roll_test_followup, ...$roll_test_followups] */
roll_test_followup_more ::= roll_test_followup "." roll_test_followups

/* A continuous effect cannot replace the triggering roll before its tests. */
/* @sem Instruction::[Effect{result:@next, operation:$continuous_snapshot}] */
roll_effect ::= continuous_snapshot

/* Compose an event with two actions that independently refer to its subject. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$event_subject_him_counters_then_grant} */
triggered_event_subject_him_counter_then_grant ::= event_clause "," event_subject_him_counters_then_grant "."

/* The pair is fixed by the attack event, and the damage trigger refers to the
   snapshot result rather than re-evaluating the attacking population. */
/* @sem Ability::Triggered{event:Batch{event:Attack{attackers:CardType(Creature), by:One(AbilityController), defenders:Any}, per:Whole, count:[Equal, Constant(2)]}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[...$attacking_pair_snapshot, Effect{result:@next, operation:$operation}, $attacking_pair_combat_trigger]}} */
triggered_attacking_pair_snapshot ::= "whenever" "you" "attack" "with" "exactly" "two" "creatures" "," attacking_pair_snapshot "," "then" operation "." attacking_pair_combat_trigger "."

/* @sem Instruction::[Effect{result:@mark, operation:CreateContinuousEffect{source:Source, affected:Objects(EventGroup), changes:$static_changes, duration:$duration, evaluation:Snapshot}}] */
attacking_pair_snapshot ::= "those" "creatures" static_changes duration

/* @sem Instruction::Effect{result:@next, operation:CreateTrigger{event:Damage(_{source_kind:Permanent, sources:InSet(Affected(@marked)), recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source}), duration:EndOfCombat, announcement:@announcement, body:$program}} */
attacking_pair_combat_trigger ::= "whenever" "either" "of" "those" "creatures" "deals" "combat" "damage" "to" "a" "player" "this" "combat" "," program

/* Damage and its creature recipient stay together when the amount is compared
   with a characteristic of that same recipient. */
/* @sem EventSpec::Damage{source_kind:Any, sources:$damage_source, recipients:Objects(CardType(Creature)), kind:$event_damage_kind, grouping:SourceRecipient, subject:Source} */
creature_stat_damage_event ::= damage_source "deals" event_damage_kind "to" "a" "creature"

/* @sem Condition::Compare{left:EventAmount, test:NumberTest::Compare{comparison:Equal, value:ObjectProperty{object:Damage(Recipient), property:$creature_stat, information:CurrentOrLastKnown}}} */
creature_damage_stat_comparison ::= "equal" "to" "that" "creature's" creature_stat

/* @sem Ability::Triggered{event:$creature_stat_damage_event, intervening_if:$creature_damage_stat_comparison, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence} */
creature_damage_stat_trigger ::= "whenever" creature_stat_damage_event creature_damage_stat_comparison "," program_sentence

/* The combat event establishes the antecedent for this damage-source batch. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Damage(Source)), kind:$counter_kind, amount:$counter_amount}]} */
damage_source_group_counter ::= "put" counter_amount counter_kind "counter" "on" "each" "of" "those" "creatures"

/* @sem Instruction::[Effect{result:@next, operation:$damage_source_group_counter}, Effect{result:@next, operation:$operation}] */
damage_source_group_counter_followup ::= damage_source_group_counter "and" operation

/* @sem Ability::Triggered{event:$event_group_combat_recipient, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$damage_source_group_counter_followup}} */
triggered_damage_source_group_counter_followup ::= "whenever" event_group_combat_recipient "," damage_source_group_counter_followup "."

/* @sem EventSpec::Batch{event:Attack{attackers:$filter_plural, by:$event_player, defenders:Any}, per:Whole} */
event_player_attacks_with_plural ::= event_player "attacks" "with" filter_plural

/* The referenced attacker joins a batch counted over the other attackers.
   Singular and plural phrases retain their own agreement. */
/* @sem EventSpec::Batch{event:Attack{attackers:$one_other_attack_population, defenders:Any}, per:Whole, count:[GreaterOrEqual, Constant(1)], including:$object_ref} */
event_reference_and_one_other_attacks ::= object_ref "and" one_other_attack_population "attack"

/* @sem EventSpec::Batch{event:Attack{attackers:$other_attack_population, defenders:Any}, per:Whole, count:[GreaterOrEqual, $count_plural], including:$object_ref} */
event_reference_and_many_others_attack ::= object_ref "and" "at" "least" count_plural other_attack_population "attack"

/* @sem ObjectFilter::$filter_phrase */
one_other_attack_population ::= "at" "least" "one" "other" filter_phrase

/* @sem ObjectFilter::$filter_plural */
other_attack_population ::= "other" filter_plural

/* The definition of X refers to this exact life-gain event. */
/* @sem Ability::Triggered{event:$event_gain_life, limits:_{}, announcement:@announcement, body:_{instructions:$random_hand_life_event_perpetual}} */
triggered_random_hand_life_event ::= "whenever" event_gain_life "," random_hand_life_event_perpetual "," "where" "X" "is" "the" "amount" "of" "life" "you" "gained" "."

/* A third-person attacker and a plural defender population are independent. */
/* @sem EventSpec::Batch{event:Attack{attackers:Any, by:$event_player, defenders:$attack_plural_defenders}, per:Whole} */
event_player_attacks_plural_defenders ::= event_player "attacks" attack_plural_defenders

/* @sem AttackDefenders::Objects($filter_plural) */
attack_plural_defenders ::= "one" "or" "more" filter_plural

/* Grouping by player preserves the entire simultaneous discard event. */
/* @sem EventSpec::Discard{players:One(AbilityController), cards:Any, kind:CausedBy(ControlledBy($discard_cause_controller)), grouping:Player} */
caused_discard_any_cards ::= discard_cause_controller "causes" "you" "to" "discard" "cards"

/* @sem EventSpec::Discard{players:One(AbilityController), cards:$batch_filtered_objects, kind:CausedBy(ControlledBy($discard_cause_controller)), grouping:Player} */
caused_discard_filtered_cards ::= discard_cause_controller "causes" "you" "to" "discard" batch_filtered_objects "cards"

caused_discard_group_event ::= caused_discard_any_cards | caused_discard_filtered_cards

/* @sem PlayerSet::OpponentsOf(AbilityController) */
discard_cause_opponent ::= opponent_spell_or_ability

/* @sem PlayerSet::One(AbilityController) */
discard_cause_you ::= "a" "spell" "or" "ability" "you" "control"

discard_cause_controller ::= discard_cause_opponent | discard_cause_you | discard_cause_active_opponent

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$program_exile_event_library_counter_followup} */
triggered_exile_event_library_counter_followup ::= event_clause "," program_exile_event_library_counter_followup

/* The next attack refers to the ability controller as the attacking player. */
/* @sem EventSpec::Player{event:Attacks, players:One(AbilityController)} */
next_player_attack_event ::= "you" "next" "attack"

/* A counted attack and its qualifying plural population compose independently. */
/* @sem EventSpec::Batch{event:Attack{attackers:$attack_qualified_plural, by:One(AbilityController), defenders:Any}, per:Whole, count:[GreaterOrEqual, $attack_threshold]} */
event_attack_at_least_qualified ::= "you" "attack" "with" "at" "least" attack_threshold attack_qualified_plural

attack_threshold ::= attack_threshold_words | value

/* @prefer always */
attack_threshold_words ::= count_plural

/* @sem ObjectFilter::AllOf([$filter_plural, AnyOf([HasKeyword($keyword_name), HasKeyword($keyword_name_2), HasKeyword($keyword_name_3), HasKeyword($keyword_name_4)])]) */
attack_qualified_plural ::= filter_plural "that" "have" keyword_name "," keyword_name "," keyword_name "," "and" "/" "or" keyword_name

/* The attacker and defending player are independently represented in the batch. */
/* @sem EventSpec::Batch{event:Attack{attackers:Any, by:One(AbilityController), defenders:Players($attack_player_defender)}, per:Defender} */
event_you_attacks_named_defender ::= "you" "attack" attack_player_defender

/* @sem PlayerSet::One(PlayerRef::Holder(Initiative)) */
attack_player_initiative_holder ::= "the" "player" "who" "has" "the" "initiative"

/* A singular controlled event subject with a disjunctive attachment state. */
/* @prefer always */
/* @sem @and($noun, ObjectFilter::ControlledBy(One(AbilityController)), $past_attached_alternative) */
event_controlled_attached_alternative ::= "a" noun "you" "control" "that's" past_attached_alternative

/* @sem EventSpec::NthEachTurn{event:Spell{event:Cast, players:OpponentsOf(AbilityController), spells:$adjective_nontype}, test:NumberTest::Compare{comparison:Equal, value:$opponent_cast_ordinal}} */
event_opponent_cast_nth_nontype ::= "an" "opponent" "casts" "their" opponent_cast_ordinal adjective_nontype "spell" "each" "turn"

opponent_cast_ordinal ::= resolution_first | ordinal

/* A single named counter placement by the ability controller. */
/* @sem EventSpec::Counters{change:Put, kind:$counter_kind, objects:$filter_phrase, by:One(AbilityController)} */
event_you_put_single_named_counter ::= "you" "put" "a" counter_kind "counter" "on" "a" filter_phrase

/* Each comparison is tied to the event that supplies its operand. */
/* @sem Ability::Triggered{event:$event_cast_nth, limits:TriggerLimits{}, announcement:@announcement, body:$revealed_top_cast_program} */
triggered_revealed_top_lesser ::= "whenever" event_cast_nth "," revealed_top_cast_program

/* @sem Ability::Triggered{event:$event_combat_damage_player, limits:TriggerLimits{}, announcement:@announcement, body:$looked_top_damage_program} */
triggered_looked_top_damage ::= "whenever" event_combat_damage_player "," looked_top_damage_program

/* @sem Ability::Triggered{event:$event_cast_first_spell_each_turn, limits:TriggerLimits{}, announcement:@announcement, body:$revealed_top_cast_program} */
triggered_first_revealed_top_lesser ::= "whenever" event_cast_first_spell_each_turn "," revealed_top_cast_program

/* @prefer always */
/* @sem EventSpec::NthEachTurn{event:Spell{event:Cast, players:One(AbilityController), spells:Any}, test:NumberTest::Compare{comparison:Equal, value:$cast_turn_ordinal}} */
event_cast_numbered_spell_turn ::= "you" "cast" "your" cast_turn_ordinal "spell" "each" "turn"

/* @sem Ability::Triggered{event:$event_cast_numbered_spell_turn, limits:TriggerLimits{}, announcement:@announcement, body:$revealed_top_cast_program} */
triggered_numbered_cast_revealed_top ::= "whenever" event_cast_numbered_spell_turn "," revealed_top_cast_program

/* Both ordinal tests count draws by the ability controller each turn. */
/* @sem EventSpec::NthEachTurn{event:Player{event:Draws, players:One(AbilityController)}, test:$draw_ordinal_pair} */
event_you_draw_ordinal_pair ::= "you" "draw" "your" draw_ordinal_pair "card" "each" "turn"

/* @sem NumberTest::AnyOf([NumberTest::Compare{comparison:Equal, value:$resolution_ordinal}, NumberTest::Compare{comparison:Equal, value:$resolution_ordinal_2}]) */
draw_ordinal_pair ::= resolution_ordinal "or" resolution_ordinal

/* A previously selected creature remains the subject of each singular event. */
/* @sem ObjectFilter::InSet(Earlier{what:Selected}) */
event_chosen_creature ::= "the" "chosen" "creature"

/* The ordinal counts the controller's unqualified casts, independently of the turn filter. */
/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:Any} */
event_you_cast_any_spell ::= "you" "cast" "a" "spell"

/* @sem NumberTest::Compare{comparison:NotEqual, value:$cast_excluded_ordinal} */
cast_except_your_ordinal_this_turn ::= "other" "than" "your" cast_excluded_ordinal "spell" "that" "turn"

/* @sem EventSpec::Filtered{event:NthEachTurn{event:$event_you_cast_any_spell, test:$cast_except_your_ordinal_this_turn}, condition:PlayerIsActive(AbilityController)} */
event_cast_during_turn_except_ordinal ::= event_you_cast_any_spell "during" "your" "turn" cast_except_your_ordinal_this_turn

/* A token linked to its creating source remains the event subject. */
/* @sem ObjectFilter::AllOf([Token, MadeBy(Source)]) */
event_source_token_subject ::= "the" "token"

/* The ordinal counts die rolls by the ability's controller each turn. */
roll_ordinal ::= ordinal_first | ordinal

/* @prefer recurs */
/* @sem EventSpec::NthEachTurn{event:Player{event:RollsADie, players:One(AbilityController)}, test:NumberTest::Compare{comparison:Equal, value:$roll_ordinal}} */
whenever_you_roll_ordinal_die ::= "whenever" "you" "roll" "your" roll_ordinal "die" "each" "turn"

/* The event proves the departing host used by the Aura return program. */
/* @sem Ability::Triggered{event:$kin_enchanted_creature_death, limits:_{}, announcement:@announcement, body:Program{instructions:$aura_random_choice_return}} */
triggered_aura_random_return ::= "when" kin_enchanted_creature_death "," aura_random_choice_return "."

/* A first-card draw event and its draw-step window compose independently. */
/* @sem EventSpec::NthEachTurn{event:Player{event:DrawsCard, players:One(AbilityController)}, test:NumberTest::Compare{comparison:Equal, value:Constant(1)}} */
controller_ordinal_card_draw ::= "you" "draw" "your" "first" "card"

/* @sem EventSpec::Filtered{event:$controller_ordinal_card_draw, condition:$controller_draw_step_window} */
event_ordinal_draw_during_steps ::= controller_ordinal_card_draw controller_draw_step_window

/* @sem Condition::Window(DrawStep) */
controller_draw_step_window ::= "during" "each" "of" "your" "draw" "steps"

/* A trigger can carry the complete damage receipt and conditional grant. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$saddled_damage_perpetual_program} */
triggered_saddled_damage_perpetual ::= event_clause "," saddled_damage_perpetual_program

/* The spell's caster supplies the event-relative exclusion. */
/* @sem Ability::Triggered{event:$copy_other_player_cast_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$clause_other_players_copy_event}} */
triggered_other_players_copy ::= copy_other_player_cast_event "," clause_other_players_copy_event "."

/* @sem EventSpec::$event_cast_third */
copy_other_player_cast_event ::= "whenever" event_cast_third

/* A complete event and its scoped choice/return program. */
/* @sem Ability::Triggered{event:$defending_source_attack_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$defending_choice_return_value}} */
triggered_defending_choice_return_value ::= defending_source_attack_event "," defending_choice_return_value "."

/* The defending player is the defender of this attack source. */
/* @sem EventSpec::Object{event:Attacks, objects:$event_self} */
defending_source_attack_when ::= "when" event_self "attacks"

/* @sem EventSpec::Object{event:Attacks, objects:$event_self} */
/* @prefer always */
defending_source_attack_whenever ::= "whenever" event_self "attacks"

defending_source_attack_event ::= defending_source_attack_when | defending_source_attack_whenever

/* The source named in the condition is the antecedent of the counter recipient. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:$condition_self_damage_another_turn, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Source)), kind:$counter_kind, amount:$counter_a}]}}]}} */
triggered_self_history_counter_him ::= "at" turn_event "," "if" condition_self_damage_another_turn "," "put" counter_a counter_kind "counter" "on" "him" "."

/* A combat window qualifies the entering event without changing its subject. */
entry_combat_event ::= event_enters | event_controlled_enters

/* @sem EventSpec::Filtered{event:$entry_combat_event, condition:Window(Combat)} */
event_entry_during_combat ::= entry_combat_event "during" "combat"

/* The condition qualifies the entry event, retaining its subject and controller. */
/* @sem EventSpec::Filtered{event:$conditioned_entry_event, condition:$condition} */
event_entry_while_condition ::= conditioned_entry_event "while" condition

conditioned_entry_event ::= event_enters | event_controlled_enters

/* Group the damage event by the controller of its creature sources. */
/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:$chosen_creature_filter, recipients:Players(OpponentsOf(AbilityController)), kind:Combat, grouping:SourceController, subject:Source}) */
creature_controller_combat_event ::= "whenever" "one" "or" "more" chosen_creature_filter "deal" "combat" "damage" "to" "one" "or" "more" "of" "your" "opponents"

/* The event establishes the controller referred to by this continuation. */
/* @sem Ability::Triggered{event:$creature_controller_combat_event, limits:TriggerLimits{}, announcement:@announcement, body:$creature_controller_shared_draw} */
creature_controller_combat_trigger ::= creature_controller_combat_event "," creature_controller_shared_draw "."

/* The occurrence is grouped by damaged player; the source population stays controlled. */
/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:AllOf([$subtype_plural, ControlledBy(One(AbilityController))]), recipients:Players(All), kind:Combat, grouping:Recipient, subject:Source}) */
event_controlled_subtypes_combat_player ::= "one" "or" "more" subtype_plural "you" "control" "deal" "combat" "damage" "to" "a" "player"

/* The reference "another" is relative to this ability's holder. */
/* @sem Ability::Triggered{event:Object{event:TurnsFaceUp, objects:$event_self}, limits:TriggerLimits{}, announcement:@announcement, body:$program_exile_other_controlled_or_controller_token} */
triggered_faceup_exile_controlled_or_token ::= "when" event_self "is" "turned" "face" "up" "," program_exile_other_controlled_or_controller_token

/* @sem Ability::Triggered{event:ZoneChange{objects:$event_self, to:Battlefield}, limits:TriggerLimits{}, announcement:@announcement, body:$program_exile_other_controlled_or_controller_token} */
triggered_entry_exile_controlled_or_token ::= "when" event_self "enters" "," program_exile_other_controlled_or_controller_token

/* Battlefield entry is independent of the holder of the triggered ability. */
/* @sem EventSpec::ZoneChange{objects:$filter_phrase, to:Battlefield} */
retrigger_entry_an ::= "an" filter_phrase "entering"

/* @sem EventSpec::ZoneChange{objects:$filter_phrase, to:Battlefield} */
retrigger_entry_a ::= "a" filter_phrase "entering"

/* @sem EventSpec::ZoneChange{objects:$filter_phrase, to:Battlefield} */
retrigger_entry_cause ::= "a" filter_phrase "entering" "the" "battlefield"

/* A permanent damages either the controller or a described permanent. */
/* @sem EventSpec::AnyOf([Damage(_{source_kind:Permanent, sources:$event_object, recipients:Players(One(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Source}), Damage(_{source_kind:Permanent, sources:$event_object, recipients:Objects($filter_phrase), kind:Any, grouping:SourceRecipient, subject:Source})]) */
event_permanent_damage_you_or_object ::= event_object "deals" "damage" "to" "you" "or" "a" filter_phrase

/* A singular permanent source deals damage separately to a described permanent or a player. */
/* @sem EventSpec::AnyOf([Damage(_{source_kind:Permanent, sources:$event_object, recipients:Objects($damage_recipient_filter), kind:Any, grouping:SourceRecipient, subject:Source}), Damage(_{source_kind:Permanent, sources:$event_object, recipients:Players(All), kind:Any, grouping:SourceRecipient, subject:Source})]) */
event_damage_permanent_or_player ::= event_object "deals" "damage" "to" damage_recipient_filter "or" "player"

/* @sem $filter_phrase */
damage_recipient_filter ::= ("a" | "an") filter_phrase

/* Independent permanent and spell subjects retain their own filters. */
targeted_controlled_spell_subject ::= targeted_controlled_spell_a | targeted_controlled_spell_an

/* @sem @and(ObjectFilter::OnStack(Spell), @and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))) */
targeted_controlled_spell_a ::= "a" filter_phrase "spell" "you" "control"

/* @sem @and(ObjectFilter::OnStack(Spell), @and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))) */
targeted_controlled_spell_an ::= "an" filter_phrase "spell" "you" "control"

/* @sem Operand::Term{family:SpellsAndAbilities, form:ControlledByAPlayer, operands:[Players(OpponentsOf(AbilityController))]} */
targeting_opponent_spell_or_ability ::= "a" "spell" "or" "ability" "an" "opponent" "controls"

/* @sem EventSpec::@either_event(EventSpec::BecomesTarget(_{objects:$event_a, kind:SpellOrAbility, by:$targeting_opponent_spell_or_ability}), EventSpec::BecomesTarget(_{objects:$targeted_controlled_spell_subject, kind:SpellOrAbility, by:$targeting_opponent_spell_or_ability})) */
event_target_pair_by_stack_source ::= event_a "or" targeted_controlled_spell_subject "becomes" "the" "target" "of" targeting_opponent_spell_or_ability

/* A passive cast event retains the spell filter independently of its caster. */
/* @sem EventSpec::Filtered{event:Spell{event:Cast, players:All, spells:$spell_filter}, condition:PlayerIsActive(AbilityController)} */
shared_passive_cast_own_turn ::= "whenever" spell_filter "is" "cast" "during" "your" "turn"

/* The cast event supplies the antecedent for the history expression in the body. */
/* @sem Ability::Triggered{event:$shared_passive_cast_own_turn, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$shared_cast_history_damage}]}} */
shared_cast_history_trigger ::= shared_passive_cast_own_turn "," shared_cast_history_damage "."

/* A singular permanent deals a kind of damage to either recipient. */
/* @sem EventSpec::AnyOf([Damage(_{source_kind:Permanent, sources:$event_singular_subject, recipients:Players(All), kind:$shared_damage_kind, grouping:SourceRecipient, subject:Source}), Damage(_{source_kind:Permanent, sources:$event_singular_subject, recipients:Objects($filter_phrase), kind:$shared_damage_kind, grouping:SourceRecipient, subject:Source})]) */
event_damage_player_or_object ::= event_singular_subject "deals" shared_damage_kind "to" "a" "player" "or" filter_phrase

/* The quoted trigger is evaluated by the granted land's controller. */
/* @sem Ability::Triggered{event:Turn{point:UpkeepBegins, players:One(AbilityController)}, limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(One(AbilityController)), amount:$number_digits, preventable:true}}]}} */
land_upkeep_damage_trigger ::= "at" "the" "beginning" "of" "your" "upkeep" "," "this" "land" "deals" number_digits "damage" "to" "you" "."

/* Resolution choices share their outer once-per-turn sentence. */
shared_once_resolution_operation ::= shared_copy_controlled_operation | once_lesser_event_return

/* Scoped to bodies of the controller's life-loss trigger. */
/* @sem Expr::EventAmount */
life_lost_event_amount ::= "for" "each" "1" "life" "you" "lost"

/* The intervening life-gain condition supplies the quantity referred to by
   "that many"; keep the condition and distribution in the same production. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:Compare{left:EventHistory{event:Player{event:GainsLife, players:One(AbilityController)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(EventHistory{event:Player{event:GainsLife, players:One(AbilityController)}, window:ThisTurn, measure:TotalAmount}), filter:AllOf([Not(SameObject(Source)), $plural]), distribute:EventHistory{event:Player{event:GainsLife, players:One(AbilityController)}, window:ThisTurn, measure:TotalAmount}}))), kind:$counter_kind, amount:DistributedShare(@share)}]}}]}} */
triggered_life_gained_counter_distribution ::= "at" turn_event "," "if" "you" "gained" "life" "this" "turn" "," "distribute" "up" "to" "that" "many" counter_kind "counters" "among" "any" "number" "of" "other" "target" plural "."

/* This scoped callback follows an explicit named source counter condition. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$transform_source_him}]} */
named_source_him_program ::= transform_source_him

/* @sem Ability::Triggered{event:State{condition:$condition_named_counters_fewer_him}, limits:TriggerLimits{}, announcement:@announcement, body:$named_source_him_program} */
triggered_named_counter_him_callback ::= "when" condition_named_counters_fewer_him "," named_source_him_program "."

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$operation_delayed_return_program} */
triggered_operation_delayed_return ::= event_clause "," operation_delayed_return_program

/* The named holder supplies the antecedent of the later source pronoun. */
/* @sem EventSpec::State{condition:ObjectMatches{object:$self_ref_named, filter:Counters(_{kind:$counter_kind, comparison:Equal, value:Constant(0)})}} */
event_named_no_counters ::= "when" self_ref_named "has" "no" counter_kind "counters" "on" "it"

/* The sacrifice is a required resolution payment; its result gates the followup. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Sacrifice{objects:One(Source)}]}, optional:false}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:$conjoined}, otherwise:Program{}}]} */
program_sacrifice_named_source_if_done ::= "sacrifice" "it" "." "if" "you" "do" "," conjoined

/* @sem Ability::Triggered{event:$event_named_no_counters, limits:TriggerLimits{}, announcement:@announcement, body:$program_sacrifice_named_source_if_done} */
triggered_named_no_counters_sacrifice ::= event_named_no_counters "," program_sacrifice_named_source_if_done "."

/* @sem ObjectEvent::Attacks */
event_transition_attacks ::= "attacks"

/* The named object and the distinct filtered alternatives share the entry controller. */
/* @sem ObjectFilter::AnyOf([AllOf([Not(SameObject($object_ref)), $filter_phrase]), SameObject($object_ref)]) */
history_referenced_or_another ::= object_ref "or" "another" filter_phrase

/* @sem EventSpec::ZoneChange{objects:AllOf([ControlledBy(One(AbilityController)), $history_referenced_or_another]), to:Battlefield} */
history_referenced_or_another_entry_controlled ::= history_referenced_or_another "entered" "the" "battlefield" "under" "your" "control"

/* The comparison is to the granted ability holder, not the outer source. */
/* @sem EventSpec::ZoneChange{objects:AllOf([$noun, ControlledBy(One(AbilityController)), Property{property:$stat, test:NumberTest::Compare{comparison:Greater, value:ObjectProperty{object:Source, property:$stat, information:CurrentOrLastKnown}}}]), from:Battlefield, to:Graveyard} */
granted_controlled_greater_stat_death ::= "when" "a" noun "you" "control" "with" "greater" stat "than" "this" "card" "dies"

/* A controlled entrant expressed as a zone change, preserving the entrant as subject. */
/* @sem EventSpec::ZoneChange{objects:$controlled_entrant, to:Battlefield} */
event_controlled_entrant_zone_change ::= controlled_entrant "enters"

/* @sem EventSpec::$event_controlled_entrant_zone_change */
whenever_controlled_entrant_zone_change ::= "whenever" event_controlled_entrant_zone_change

/* The same subject qualifies both the attack and the attacking entry. */
/* @sem EventSpec::AnyOf([Object{event:Attacks, objects:$controlled_entrant}, Player{event:EntersUnderControl, players:All, objects:@and($controlled_entrant, ObjectFilter::Attacking)}]) */
event_subject_attacks_or_enters_attacking ::= controlled_entrant "attacks" "or" "enters" "attacking"

/* These event forms prove that the subject measured in the body is a creature that died. */
creature_death_for_characteristic ::= controlled_creature_death_for_characteristic | any_creature_death_for_characteristic

/* @sem EventSpec::ZoneChange{objects:AllOf([CardType(Creature), ControlledBy(One(AbilityController))]), from:Battlefield, to:Graveyard} */
controlled_creature_death_for_characteristic ::= "a" "creature" "you" "control" "dies"

/* @sem EventSpec::ZoneChange{objects:CardType(Creature), from:Battlefield, to:Graveyard} */
any_creature_death_for_characteristic ::= "a" "creature" "dies"

/* @sem Ability::Triggered{event:$creature_death_for_characteristic, limits:TriggerLimits{}, announcement:@announcement, body:$death_characteristic_counter_program} */
creature_death_characteristic_counter_trigger ::= "whenever" creature_death_for_characteristic "," death_characteristic_counter_program "."

/* The entry normal form records the entrant's written controller filter. */
/* @sem EventSpec::AnyOf([Object{event:$event_object_transition, objects:$controlled_entrant}, Player{event:EntersUnderControl, players:All, objects:$controlled_entrant}]) */
event_controlled_entry_or_object_transition ::= controlled_entrant "enters" "or" event_object_transition

/* The controller of the dying object is the payer named by the following pronoun. */
/* @sem EventSpec::ZoneChange{objects:AllOf([$filter_phrase, ControlledBy(OpponentsOf(AbilityController))]), from:Battlefield, to:Graveyard} */
event_opponent_controlled_dies ::= "whenever" "a" filter_phrase "an" "opponent" "controls" "dies"

/* An existential state trigger keeps the opponent bound within the life test. */
/* @sem EventSpec::State{condition:ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}}} */
event_opponent_life_at_most ::= "when" "an" "opponent" "has" number "or" "less" "life"

/* The source attack determines the defending player for the shared program. */
/* @prefer always */
/* @sem Ability::Triggered{event:Object{event:Attacks, objects:$event_self}, limits:_{}, announcement:@announcement, body:$shared_defender_discard_extreme_program} */
triggered_attack_defender_discard_extreme ::= "whenever" event_self "attacks" "," shared_defender_discard_extreme_program "."

/* An entry event retains the filter and the controller at the event. */
/* @sem EventSpec::ZoneChange{objects:@and($filter_phrase, ObjectFilter::ControlledBy(OpponentsOf(AbilityController))), to:Battlefield} */
history_opponent_controlled_entry ::= "a" filter_phrase "entered" "the" "battlefield" "under" "an" "opponent's" "control"

/* The exclusion belongs to the first alternative, not the whole union. */
/* @sem ObjectFilter::AnyOf([AllOf([Not(SameObject(Source)), $filter_phrase]), $filter_phrase_2]) */
other_or_an_filter ::= "another" filter_phrase "or" "an" filter_phrase

/* @sem EventSpec::ZoneChange{objects:AllOf([ControlledBy(One(AbilityController)), $other_or_an_filter]), to:Battlefield} */
history_alternative_controlled_entry ::= other_or_an_filter "entered" "the" "battlefield" "under" "your" "control"

/* Keep the "that many" payment in the scope of its mana-value antecedent. */
/* @sem Ability::Triggered{event:$event_dies, intervening_if:$event_mana_value_was_at_least, limits:TriggerLimits{}, announcement:@announcement, body:$event_mana_value_counter_payment_return} */
triggered_death_mana_value_counter_payment ::= "whenever" event_dies "," "if" event_mana_value_was_at_least "," event_mana_value_counter_payment_return "."

/* Independent entry and death triggers share a body but retain their event identities. */
/* @sem Ability::[Triggered{event:ZoneChange{objects:$event_self, to:Battlefield}, limits:TriggerLimits{}, announcement:@announcement, body:$program}, Triggered{event:ZoneChange{objects:@and(ObjectFilter::Not($event_self), $filter_phrase), from:Battlefield, to:Graveyard}, limits:TriggerLimits{}, announcement:@announcement, body:$program}] */
line_self_enters_or_another_dies ::= "whenever" event_self "enters" "or" "another" filter_phrase "dies" "," program "."

/* An activation of an ability of a planeswalker with the chosen type. */
/* @sem EventSpec::Activated{players:One(AbilityController), abilities:AbilityOf(AllOf([CardType(Planeswalker), Chosen(PlaneswalkerType)]))} */
event_chosen_walker_activation ::= "you" "activate" "an" "ability" "of" "a" "planeswalker" "of" "that" "type"

/* The opponent remains the activating player. */
/* @sem EventSpec::Activated{players:OpponentsOf(AbilityController), abilities:AbilityOf(AllOf([CardType(Planeswalker), Chosen(PlaneswalkerType)]))} */
event_chosen_walker_opponent_activation ::= "an" "opponent" "activates" "an" "ability" "of" "a" "planeswalker" "of" "that" "type"

/* A clash event scopes the otherwise ambiguous winning outcome. */
/* @sem Ability::Triggered{event:Player{event:Clashes, players:One(AbilityController)}, limits:TriggerLimits{}, announcement:@announcement, body:$clash_outcome_program} */
shared_clash_outcome_trigger ::= "whenever" "you" "clash" "," clash_outcome_program "."

clash_outcome_program ::= clash_tap_outcome_program | clash_paid_outcome_program

/* @sem Instruction::[If{condition:Outcome(WonClash), then:$then_condition_program, otherwise:Program{}}] */
clash_won_followup ::= "if" "you" "won" "," then_condition_program

/* @prefer always */
/* @sem ObjectFilter::AllOf([OnStack(Loyalty), AbilityOf($filter_phrase)]) */
activated_loyalty_filtered ::= "a" "loyalty" "ability" "of" ("a" | "an") filter_phrase

/* @sem ObjectFilter::AllOf([OnStack(Loyalty), AbilityOf(SameObject($object_ref))]) */
activated_loyalty_referenced ::= "a" "loyalty" "ability" "of" object_ref

/* The following action is scoped to the immediately preceding battlefield arrival. */
historical_return_followup ::= operation | postposed_arrival_action

/* @sem Operation::CreateDelayedTrigger{event:$event_clause, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:$arrival_sacrifice_action}]}} */
postposed_arrival_action ::= arrival_sacrifice_action event_clause

/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:$returned_arrival_it}) */
arrival_sacrifice_action ::= "sacrifice" returned_arrival_it

/* This continuation is reachable only after the first result of the paired move. */
/* @sem ObjectSet::Transition{result:0, phase:After} */
returned_arrival_it ::= "it"

/* A departure from your graveyard refers to cards owned by the controller. */
/* @sem EventSpec::Object{event:LeavesGraveyard, objects:AllOf([Any, OwnedBy(One(AbilityController))])} */
history_owned_any_card_departure ::= "a" "card" "left" "your" "graveyard"

/* The linked-name qualifier remains an independently reusable filter. */
/* @sem EventSpec::Object{event:TappedForMana, objects:AllOf([CardType(Land), $linked_name_single])} */
event_linked_name_land_tapped_for_mana ::= "a" "land" linked_name_single "is" "tapped" "for" "mana"

/* The discarded holder is the event subject; the cause controller remains independent. */
/* @sem EventSpec::Discard{players:One(AbilityController), cards:SameObject(Source), kind:CausedBy(ControlledBy($discard_cause_controller)), grouping:Card} */
caused_discard_source_event ::= discard_cause_controller "causes" "you" "to" "discard" "this" "card"

source_discard_return_program ::= delayed_graveyard_self_program | delayed_graveyard_self_your_end_program | delayed_graveyard_self_next_upkeep_program | immediate_then_delayed_self_return

/* A holder's discard trigger functions in all zones and owns its delayed program. */
/* @sem Ability::Scoped{zones:[Battlefield, Graveyard, Hand, Library, Stack, Exile, Command, Ante], ability:@scope(Ability::Triggered{event:$caused_discard_source_event, limits:TriggerLimits{}, announcement:@announcement, body:$source_discard_return_program})} */
source_discard_scoped_trigger ::= "when" caused_discard_source_event "," source_discard_return_program

/* @sem PlayerSet::OpponentsOf(Active) */
discard_cause_active_opponent ::= "a" "spell" "or" "ability" "an" "opponent" "of" "the" "active" "player" "controls"

/* A singular event subject and its explicit movement destination compose. */
/* @sem EventSpec::ZoneChange{objects:$event_object, from:Battlefield, to:$battlefield_exile_put_destination} */
event_battlefield_exile_put ::= event_object "is" "put" "into" battlefield_exile_put_destination "from" "the" "battlefield"

/* @sem Zone::Exile */
battlefield_exile_put_destination ::= "exile"

/* Both alternatives retain the same controlled object population. */
/* @prefer always */
/* @sem EventSpec::@either_event(EventSpec::Object{event:Attacks, objects:@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))}, EventSpec::Player{event:EntersUnderControl, players:All, objects:@and(@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController))), ObjectFilter::Attacking)}) */
controlled_attacks_or_enters_attacking ::= "whenever" "a" filter_phrase "you" "control" "attacks" "or" "enters" "attacking"

/* A singular entrant carries its own filter independently of the counter state. */
entry_counter_subject ::= controlled_entrant | event_singular_subject

/* @sem ObjectFilter::Counters(_{comparison:GreaterOrEqual, value:Constant(1)}) */
entry_one_counter ::= "with" "a" "counter" "on" "it"

/* @sem EventSpec::ZoneChange{objects:AllOf([$entry_counter_subject, $entry_one_counter]), to:Battlefield} */
event_entry_with_counter ::= entry_counter_subject "enters" entry_one_counter

/* The controlled-entry canonical form retains the same entrant and counter filter. */
/* @sem EventSpec::Player{event:EntersUnderControl, players:All, objects:AllOf([$controlled_entrant, $entry_one_counter])} */
event_controlled_entry_with_counter ::= controlled_entrant "enters" entry_one_counter

/* A turn event supplies the subject for an optional payment program. */
/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$event_player_paid_program} */
turn_event_player_paid ::= "at" turn_event "," event_player_paid_program "."

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$optional_any_resource_draw_program} */
turn_optional_any_resource_draw ::= "at" turn_event "," optional_any_resource_draw_program

/* @prefer always */
/* @sem ObjectFilter::Not(OnStack(Mana)) */
activation_nonmana_unqualified ::= "an" "ability" "that" "isn't" "a" "mana" "ability"

/* @prefer always */
/* @sem ObjectFilter::AllOf([AbilityOf($filter_phrase), Not(OnStack(Mana))]) */
activation_nonmana_of_filter ::= "an" "ability" "of" "a" filter_phrase "that" "isn't" "a" "mana" "ability"

/* The threshold refers to the triggering subject, not the ability source. */
/* @sem Ability::Triggered{event:$event_clause, intervening_if:$event_subject_other_control_threshold, limits:TriggerLimits{}, announcement:@announcement, body:$optional_have_program} */
triggered_event_subject_threshold ::= event_clause "," "if" event_subject_other_control_threshold "," optional_have_program "."

/* Both branches keep their independent subjects and players. */
/* @sem EventSpec::AnyOf([$event_clause, $event_control_loss_base]) */
event_clause_or_control_loss ::= event_clause "or" event_control_loss_base

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$returned_hand_card_type_program} */
triggered_returned_hand_card_type ::= event_clause "," returned_hand_card_type_program

exact_attack_actor ::= exact_attack_controller | exact_attack_team

/* @sem PlayerSet::One(AbilityController) */
exact_attack_controller ::= "you" "attack"

/* @prefer always */
/* @sem PlayerSet::Matching{binding:0, condition:SameTeam{player:Bound(0), other:AbilityController}} */
exact_attack_team ::= "your" "team" "attacks"

/* A fresh trigger frame guarantees that the two fighters occupy its first two slots. */
/* @sem Ability::Triggered{event:$event_once, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$fight_opponent_death_replacement}} */
triggered_fight_opponent_death_replacement ::= "when" event_once "," fight_opponent_death_replacement "."

exiled_battlefield_subject ::= event_object | exiled_battlefield_other_subject

/* @sem ObjectFilter::@and($filter_phrase, ObjectFilter::Not(ObjectFilter::SameObject($object_ref))) */
exiled_battlefield_other_subject ::= "a" filter_phrase "other" "than" object_ref

/* Third-person activators retain the described ability holder. */
/* @sem EventSpec::Activated{players:$event_player, abilities:$activated_ordinary_ability} */
event_third_ability_of ::= event_player "activates" activated_ordinary_ability

/* The amount restrictions apply independently to damage and caused life loss. */
/* @sem EventSpec::Filtered{event:Damage(_{source_kind:Any, sources:ControlledBy(One(AbilityController)), recipients:Players(One(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Source}), condition:Compare{left:EventAmount, test:Compare{comparison:Equal, value:$number_digits}}} */
event_controlled_source_exact_damage_you ::= "a" "source" "you" "control" "deals" "exactly" number_digits "damage" "to" "you"

/* @sem EventSpec::Filtered{event:Player{event:LosesLife, players:One(AbilityController)}, condition:Compare{left:EventAmount, test:Compare{comparison:Equal, value:$number_digits}}} */
caused_exact_life_loss_you ::= "you" "to" "lose" "exactly" number_digits "life"

/* @sem EventSpec::Caused{cause:$event_cause, event:$caused_exact_life_loss_you} */
event_caused_exact_life_loss ::= event_cause "causes" caused_exact_life_loss_you

/* @sem EventSpec::AnyOf(@unordered([$event_controlled_source_exact_damage_you, $event_caused_exact_life_loss])) */
event_clause_controlled_damage_and_caused_loss ::= "whenever" event_controlled_source_exact_damage_you "and" "whenever" event_caused_exact_life_loss

/* An explicit resolution-count sentence follows any initial clause. */
/* @prefer always */
/* @sem Ability::Triggered{event:$event_clause_controlled_damage_and_caused_loss, limits:_{}, announcement:@announcement, body:Program{instructions:[...$clause, If{condition:$condition_nth_resolution_this_turn, then:$then_condition_program, otherwise:Program{}}]}} */
triggered_pair_with_resolution_followup ::= event_clause_controlled_damage_and_caused_loss "," clause "." "if" condition_nth_resolution_this_turn "," then_condition_program "."

/* A threshold on the result of the ability controller's die roll. */
/* @sem EventSpec::Filtered{event:Player{event:RollsADie, players:One(AbilityController)}, condition:Compare{left:EventAmount, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}} */
rolled_at_least_event ::= "whenever" "you" "roll" "a" value "or" "higher"

/* The cast origin belongs to the caster, while the resolution effect applies
   to the spell that caused this trigger. */
/* @sem Operation::EffectOn{subject:Objects(One(EventSubject)), effects:[Term{family:SpellEffect, form:AsResolves, operands:[List([Term{family:ResolveAction, form:ExileResolvingSpell}])]}]} */
cast_event_resolving_spell_exile ::= "exile" "it" "instead" "of" "putting" "it" "into" "a" "graveyard" "as" "it" "resolves"

/* @sem Ability::Triggered{event:$event_player_casts_from_own_zone, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$cast_event_resolving_spell_exile}]}} */
triggered_cast_origin_resolving_exile ::= "whenever" event_player_casts_from_own_zone "," cast_event_resolving_spell_exile "."

/* The mandatory choice is dispatched as a trigger, outside optional-program syntax. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$clause_exile_any_affected_until}} */
triggered_exile_any_affected_until ::= event_clause "," clause_exile_any_affected_until "."

/* A simultaneous group of controlled permanents moves from the battlefield. */
/* @sem EventSpec::Batch{event:ZoneChange{objects:AllOf([$filter_plural, ControlledBy(One(AbilityController)), OwnedBy(All)]), from:Battlefield, to:Graveyard}, per:Whole} */
event_controlled_batch_graveyard ::= "one" "or" "more" filter_plural "you" "control" "are" "put" "into" "a" "graveyard" "from" "the" "battlefield"

/* @sem Ability::Triggered{event:$event_controlled_batch_graveyard, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence} */
triggered_controlled_batch_graveyard ::= "whenever" event_controlled_batch_graveyard "," program_sentence

damage_dealing_event ::= event_damage | event_combat_damage

/* Any supported event can introduce the scoped library and energy choice. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$top_card_energy_or_play_program} */
triggered_top_card_energy_or_play ::= event_clause "," top_card_energy_or_play_program

/* Compose an event, its subject condition, and the resolution program. */
/* @sem Ability::Triggered{event:$event_clause, intervening_if:$event_subject_is_a_filter, limits:_{}, announcement:@announcement, body:$program} */
triggered_event_subject_filter ::= event_clause "," "if" event_subject_is_a_filter "," program "."

/* The sticker outcome is bound to the placement event, not an arbitrary event. */
/* @sem Ability::Triggered{event:$event_you_place_sticker, limits:TriggerLimits{}, announcement:@announcement, body:$sticker_art_replacement_program} */
triggered_sticker_art_replacement ::= "whenever" event_you_place_sticker "," sticker_art_replacement_program

/* Both branches remain complete programs and print from their current operands. */
/* @sem Program::Program{instructions:[If{condition:Outcome(ArtSticker), then:$program_2, otherwise:$program}]} */
sticker_art_replacement_program ::= program "." "if" "it's" "an" "art" "sticker" "," "instead" program "."

/* The creature event establishes the antecedent for the control comparison. */
/* @sem EventSpec::Batch{event:Counters{change:Put, kind:$counter_kind, objects:CardType(Creature)}, per:Subject} */
creature_counter_batch_event ::= "one" "or" "more" counter_kind "counters" "are" "put" "on" "a" "creature"

/* @sem Ability::Triggered{event:$creature_counter_batch_event, limits:TriggerLimits{}, announcement:@announcement, body:$creature_control_branch} */
triggered_creature_counter_control_branch ::= "whenever" creature_counter_batch_event "," creature_control_branch "."

/* The event supplies the life quantity for the scoped payment and reward. */
/* @sem Ability::Triggered{event:$event_gain_life, limits:TriggerLimits{}, announcement:@announcement, body:$life_gain_paid_draw_program} */
/* @prefer always */
triggered_life_gain_paid_draw ::= "whenever" event_gain_life "," life_gain_paid_draw_program "."

/* Any matching entry may cause the referenced triggered ability. */
/* @sem EventSpec::CausesTrigger{cause:ZoneChange{objects:$filter_phrase, to:Battlefield}} */
event_entry_causes_trigger ::= "a" filter_phrase "entering" "causes" "a" "triggered" "ability" "to" "trigger"

/* The indefinite death event supplies the card referred to by the delayed return. */
/* @sem EventSpec::ZoneChange{objects:$event_a, from:Battlefield, to:Graveyard} */
shared_indefinite_death ::= event_a "dies"

/* This wrapper keeps the first-card reference inside its death-event scope. */
/* @sem Ability::Triggered{event:$shared_indefinite_death, intervening_if:$shared_other_battlefield_condition, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$shared_first_card_delayed_return}]}} */
shared_death_other_delayed_return ::= "whenever" shared_indefinite_death "," "if" shared_other_battlefield_condition "," shared_first_card_delayed_return "."

/* The shortfall phrase shares its threshold between the trigger condition and draw. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:Compare{left:CountObjects(Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})), test:NumberTest::Compare{comparison:Less, value:$hand_shortfall_draw_threshold}}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Subtract([$hand_shortfall_draw_threshold, CountObjects(Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}))])}}]}} */
trigger_hand_shortfall_draw ::= "at" turn_event "," hand_shortfall_draw_threshold "."

/* The printed population is shared by both entry origins. */
/* @sem ObjectFilter::$filter_plural */
entry_many_subject ::= "one" "or" "more" filter_plural "enter"

/* @sem Zone::Exile */
entry_recorded_exile_origin ::= "entered" "from" "exile"

/* @sem ZoneScope::Shared(Exile) */
entry_cast_exile_origin ::= "was" "cast" "from" "exile"

/* @sem EventSpec::AnyOf([ZoneChange{objects:$entry_many_subject, from:$entry_recorded_exile_origin, to:Battlefield}, ZoneChange{objects:AllOf([$entry_many_subject, Cast{from:$entry_cast_exile_origin}]), to:Battlefield}]) */
event_many_enter_from_or_cast_from ::= entry_many_subject "," "if" "one" "or" "more" "of" "them" entry_recorded_exile_origin "or" entry_cast_exile_origin

/* The event supplies the creature referenced by both the placement and its value. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(EventSubject)), kind:$counter_kind, amount:ObjectProperty{object:EventSubject, property:$creature_stat, information:CurrentOrLastKnown}}]}}]} */
event_creature_property_counter_program ::= "put" counter_kind "counters" "on" "that" "creature" "equal" "to" "its" creature_stat

/* Both sides must name creatures for the later creature anaphor. */
faceup_creature_self ::= faceup_this_creature | event_named

/* @sem ObjectFilter::SameObject(ObjectRef::Source) */
faceup_this_creature ::= self_creature

/* The paired event keeps its independently triggered arms and the shared body. */
/* @sem Ability::[Triggered{event:Object{event:TurnsFaceUp, objects:$faceup_creature_self}, limits:TriggerLimits{}, announcement:@announcement, body:$event_creature_property_counter_program}, Triggered{event:Object{event:TurnsFaceUp, objects:@and(ObjectFilter::Not($faceup_creature_self), $chosen_counter_creature)}, limits:TriggerLimits{}, announcement:@announcement, body:$event_creature_property_counter_program}] */
triggered_faceup_creature_property_counters ::= "whenever" faceup_creature_self "or" "another" chosen_counter_creature "is" "turned" "face" "up" "," event_creature_property_counter_program "."

/* Two independently filtered deaths form one event alternative. */
/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:$death_attacking_head, from:Battlefield, to:Graveyard}, EventSpec::ZoneChange{objects:$death_blocking_head, from:Battlefield, to:Graveyard}) */
event_pair_combat_deaths ::= "whenever" death_attacking_head "or" death_blocking_head "dies"

/* @sem ObjectFilter::@and(ObjectFilter::Attacking, $filter_plain) */
death_attacking_head ::= "an" "attacking" filter_plain

/* @sem ObjectFilter::@and(ObjectFilter::Blocking, $filter_plain) */
death_blocking_head ::= "a" "blocking" filter_plain

/* The source location establishes both the active zones and intervening condition. */
/* @sem Ability::Scoped{zones:[Command, Battlefield], ability:@scope(Ability::Triggered{event:$event_clause, intervening_if:$source_command_or_battlefield, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})} */
source_command_battlefield_trigger ::= event_clause "," "if" source_command_or_battlefield "," program_sentence

/* @sem Condition::ObjectMatches{object:$self_explicit_ref, filter:AnyOf([InZone(Shared(Command)), InZone(Shared(Battlefield))])} */
source_command_or_battlefield ::= self_explicit_ref "is" "in" "the" "command" "zone" "or" "on" "the" "battlefield"

/* A source in either zone can acquire a perpetual change. The permission
   applies to that same source incarnation while it is in its graveyard. */
/* @sem Ability::Scoped{zones:[Graveyard, Battlefield], ability:@scope(Ability::Triggered{event:$event_you_player_action, intervening_if:AnyOf([ObjectMatches{object:Source, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}, ObjectMatches{object:Source, filter:InZone(Shared(Battlefield))}]), limits:_{}, body:$source_zone_perpetual_permission_body, announcement:@announcement})} */
scoped_source_zone_perpetual_permission ::= "whenever" event_you_player_action "," "if" SELF_NAME "is" "in" "your" "graveyard" "or" "on" "the" "battlefield" "," source_zone_perpetual_permission_body

/* Both branches retain the same current perpetual change; only the graveyard
   branch has a permission to cast that source incarnation from that zone. */
/* @sem Program::Program{instructions:[If{condition:ObjectMatches{object:Source, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}, then:_{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Source), changes:$static_singular_pump}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Source), from:Graveyard, action:CastSpell, filter:Any})], duration:EndOfTurn, evaluation:LiveObjects}}]}, otherwise:_{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Source), changes:$static_singular_pump}}]}}]} */
source_zone_perpetual_permission_body ::= "it" "perpetually" static_singular_pump "." "you" "may" "cast" "it" "from" "your" "graveyard" "this" "turn" "."

/* The source-attacks event supplies the active-player proof needed by the
   delayed program; do not use that program with an arbitrary event. */
/* @sem Ability::Triggered{event:EventSpec::Object{event:Attacks, objects:$event_self}, limits:TriggerLimits{}, announcement:@announcement, body:$source_attack_next_main_program} */
source_attack_next_main_trigger ::= "whenever" event_self "attacks" "," source_attack_next_main_program

/* A player's ordinal spell is counted separately for that casting player. */
/* @sem EventSpec::NthEachTurn{event:Spell{event:Cast, players:All, spells:Any}, test:NumberTest::Compare{comparison:Equal, value:$cast_spell_ordinal}} */
event_a_player_cast_ordinal ::= "a" "player" "casts" "their" cast_spell_ordinal "spell" "each" "turn"

/* A colored spell is any spell that is not colorless. */
/* @sem ObjectFilter::Not(Colorless) */
spell_colored ::= "colored"

/* The ordinal qualifies the entire cast event and its spell filter. */
/* @sem EventSpec::NthEachTurn{event:$event_cast, test:NumberTest::Compare{comparison:Equal, value:Constant(1)}} */
event_cast_first_time_each_turn ::= event_cast "for" "the" "first" "time" "each" "turn"

/* Any supported event can trigger the shared owned-name intensification. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$intensify_owned_named}]}} */
triggered_owned_named_intensify ::= event_clause "," intensify_owned_named "."

/* @prefer always */
/* @sem Ability::[Triggered{event:ZoneChange{objects:$event_self, to:Battlefield}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}, Triggered{event:ZoneChange{objects:$event_self, from:Battlefield, to:Graveyard}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}] */
line_pair_self_enters_or_dies ::= "when" event_self "enters" "or" "dies" "," program_sentence

/* @prefer always */
/* @sem Ability::[...$line_pair_self_enters_or_dies] */
line_entry_death_pair ::= line_pair_self_enters_or_dies

cast_another_spell_qualifier ::= cast_spell_keyword_qualifier | cast_spell_qualifier

/* Alternative payment programs share the combat event binding. */
opponent_combat_payment_body ::= combat_payment_program | event_player_declined_exile_program

/* A cast event provides the spell for subsequent mana-spent conditions. */
/* @sem Ability::Triggered{event:$event_cast, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[...$clause, $cast_mana_conditional, $cast_mana_damage_conditional]}} */
triggered_cast_mana_followups ::= "whenever" event_cast "," clause "." cast_mana_conditional "." cast_mana_damage_conditional "."

/* @sem Instruction::If{condition:$cast_event_mana_threshold, then:Program{instructions:$clause}, otherwise:Program{}} */
cast_mana_conditional ::= "if" cast_event_mana_threshold "," clause

/* The damage amount refers to the same spell whose mana was measured in this condition. */
/* @sem Instruction::If{condition:$cast_event_mana_threshold, then:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:One($self_ref_named)})}, Effect{result:@next, operation:DealDamage{source:$self_ref_named, recipients:$recipients, amount:ManaSpent{object:EventSubject, filter:SpentManaFilter{}, aggregation:Count}, preventable:true}}]}, otherwise:Program{}} */
cast_mana_damage_conditional ::= "if" cast_event_mana_threshold "," "sacrifice" self_ref_named "and" "it" "deals" "that" "much" "damage" "to" recipients

/* @sem Condition::Compare{left:ManaSpent{object:EventSubject, filter:SpentManaFilter{}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$spent_least}} */
cast_event_mana_threshold ::= spent_least "mana" "was" "spent" "to" "cast" "that" "spell"

/* The prime population supplies the later counter count, and the singleton
   token creation supplies the recipient. Keep both links within this scope. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:AllOf([$condition_one, IsPrime(CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, filter:ControlledBy(One(AbilityController))}))]), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$named_single_legendary_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@prior)), kind:$counter_kind, amount:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])})}]}}]}} */
triggered_prime_population_named_token ::= "at" turn_event "," "if" condition_one "and" "you" "control" "a" "prime" "number" "of" filter_plural "," "create" named_single_legendary_token "," "then" "put" "that" "many" counter_kind "counters" "on" "it" "."

/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:$filter_plural, recipients:Any, kind:Combat, grouping:SourceRecipient, subject:Recipient}) */
filtered_combat_damage_would_deal ::= "combat" "damage" filter_plural "would" "deal"

/* A trailing limit qualifies the whole triggered program. */
/* @sem Ability::Triggered{event:$event_clause, limits:$trigger_once_each_turn_suffix, announcement:@announcement, body:$program_conjure_duplicate_perpetual_sentence} */
triggered_duplicate_program_with_limit ::= event_clause "," program_conjure_duplicate_perpetual_sentence trigger_once_each_turn_suffix

/* The player and the linked exile population remain independent operands. */
/* @sem EventSpec::Player{event:PlaysCardFromExile, players:$event_player, objects:InSet($linked_exile_singular)} */
event_player_plays_linked_exile ::= event_player "plays" "a" "card" linked_exile_singular

/* A completed operation may be followed by a counter-threshold instruction. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$operation}, ...$clause_counter_threshold_remove_and]} */
program_then_counter_threshold ::= operation "." "then" clause_counter_threshold_remove_and

/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$program_then_counter_threshold} */
triggered_turn_then_counter_threshold ::= "at" turn_event "," program_then_counter_threshold

/* The condition and entry modification share the triggering spell. */
/* @sem Ability::Triggered{event:$cast_creature_snow_event, intervening_if:$spell_own_color_snow_spent, limits:TriggerLimits{}, announcement:@announcement, body:$cast_creature_entry_counter_program} */
triggered_snow_spent_entry_counter ::= cast_creature_snow_event "," "if" spell_own_color_snow_spent "," cast_creature_entry_counter_program

/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:$additional_creature_spell_filter} */
cast_creature_snow_event ::= "whenever" "you" "cast" "a" additional_creature_spell_filter "spell"

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$graveyard_cards_perpetual}]}} */
triggered_graveyard_cards_perpetual ::= event_clause "," graveyard_cards_perpetual "."

/* A turn trigger can perform an operation before a resolution-time branch. */
/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$operation}, $resolution_if_otherwise]}} */
turn_operation_resolution_branch ::= "at" turn_event "," operation "." resolution_if_otherwise

/* @sem ObjectFilter::AllOf([AbilityOf($filter_phrase), Not(OnStack(Mana))]) */
activation_nonmana_of_vowel_filter ::= "an" "ability" "of" "an" filter_phrase "that" "isn't" "a" "mana" "ability"

/* The entrant's own power and toughness are compared, independently of its
   controller and other characteristics. */
/* @sem ObjectFilter::State(PowerEqualsToughness) */
entry_equal_power_toughness ::= "with" "power" "equal" "to" "its" "toughness"

/* @sem ObjectFilter::@and($filter_phrase, $modifier_you_control, $entry_equal_power_toughness) */
entry_controlled_equal_stats ::= filter_phrase modifier_you_control entry_equal_power_toughness

/* @sem EventSpec::ZoneChange{objects:$entry_controlled_equal_stats, to:Battlefield} */
event_controlled_equal_stats_entry ::= "whenever" ("a" | "an") entry_controlled_equal_stats "enters"

/* The controlled-entry normal form keeps the same subject and controller. */
/* @sem EventSpec::Player{event:EntersUnderControl, players:All, objects:$entry_controlled_equal_stats} */
event_controlled_equal_stats_entry_normalized ::= "whenever" ("a" | "an") entry_controlled_equal_stats "enters"

/* Keep the payment and its event-bound card in one triggered ability. */
/* @sem Ability::Triggered{event:$event_card_to_graveyard_opponent, limits:TriggerLimits{}, announcement:@announcement, body:$graveyard_event_paid_entry} */
triggered_graveyard_event_paid_entry ::= "whenever" event_card_to_graveyard_opponent "," graveyard_event_paid_entry "."

/* A past event-subject test can qualify a named-land return program. */
/* @sem Ability::Triggered{event:$event_clause, intervening_if:$condition_she_was_kind, limits:TriggerLimits{}, announcement:@announcement, body:$program_return_tapped_named_land} */
triggered_she_past_named_land_return ::= event_clause "," "if" condition_she_was_kind "," program_return_tapped_named_land

/* The source's explicit return establishes the graveyard scope; the draw
   ordinal and destination remain independent operands. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$collector_draw_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$delayed_graveyard_self_move}]}})} */
graveyard_ordinal_draw_self_return ::= "when" collector_draw_event "," delayed_graveyard_self_move "."

/* The repeated type scopes the ordinal to casts of that same spell type. */
/* @sem NumberTest::Compare{comparison:NotEqual, value:$cast_excluded_ordinal} */
cast_except_instant_ordinal ::= "other" "than" "the" cast_excluded_ordinal "instant" "spell" "that" "player" "casts" "each" "turn"

/* @sem NumberTest::Compare{comparison:NotEqual, value:$cast_excluded_ordinal} */
cast_except_sorcery_ordinal ::= "other" "than" "the" cast_excluded_ordinal "sorcery" "spell" "that" "player" "casts" "each" "turn"

/* @sem EventSpec::NthEachTurn{event:Spell{event:Cast, players:$event_player, spells:CardType(Instant)}, test:$cast_except_instant_ordinal} */
event_cast_except_instant ::= event_player "casts" "an" "instant" "spell" cast_except_instant_ordinal

/* @sem EventSpec::NthEachTurn{event:Spell{event:Cast, players:$event_player, spells:CardType(Sorcery)}, test:$cast_except_sorcery_ordinal} */
event_cast_except_sorcery ::= event_player "casts" "a" "sorcery" "spell" cast_except_sorcery_ordinal

/* @sem EventSpec::$event_cast_except_instant */
whenever_cast_except_instant ::= "whenever" event_cast_except_instant

/* @sem EventSpec::$event_cast_except_sorcery */
whenever_cast_except_sorcery ::= "whenever" event_cast_except_sorcery

/* Independently described entry and spell-targeting events share a trigger. */
/* @sem EventSpec::@either_event($event_enters, $event_target_spell) */
event_entry_or_target_spell ::= event_enters "or" event_target_spell

/* The played card is drawn from the linked exile population. */
/* @sem EventSpec::Player{event:PlaysCardFromExile, players:One(AbilityController), objects:$played_linked_exile_card} */
event_you_play_linked_exile_card ::= "you" "play" played_linked_exile_card

/* @sem EventSpec::Player{event:PlaysCardFromExile, players:$event_player, objects:$played_linked_exile_card} */
event_player_plays_linked_exile_card ::= event_player "plays" played_linked_exile_card

/* @sem PlayerEvent::WinsClash */
player_event_action_win_clash ::= "win" "a" "clash"

/* A controlled saddled subject composes with singular object events. */
/* @sem ObjectFilter::AllOf([State(Saddled), $filter_phrase, ControlledBy(One(AbilityController))]) */
event_saddled_controlled ::= "a" "saddled" filter_phrase "you" "control"

/* The entry and the targeting event share the same written subject. */
/* @sem EventSpec::AnyOf([ZoneChange{objects:$event_object, to:Battlefield}, BecomesTarget(_{objects:$event_object, kind:Spell, by:Filter($spell_filter)})]) */
event_entry_or_spell_target ::= event_object "enters" "or" "becomes" "the" "target" "of" spell_filter

/* The ordinal counts spells matching the written filter across all players. */
/* @sem EventSpec::NthEachTurn{event:Spell{event:Cast, players:All, spells:$adjective_nontype}, test:NumberTest::Compare{comparison:Equal, value:$passive_spell_ordinal}} */
event_passive_nth_filtered_spell_turn ::= "the" passive_spell_ordinal adjective_nontype "spell" "of" "a" "turn" "is" "cast"

passive_spell_ordinal ::= passive_spell_first | ordinal

/* @sem Expr::Constant(1) */
passive_spell_first ::= "first"

/* @sem ObjectFilter::AllOf([$filter_phrase, ControlledBy(One(AbilityController)), HasActivatedAbility(Mana)]) */
event_controlled_mana_subject ::= "a" filter_phrase "you" "control" "with" "a" "mana" "ability"

/* @sem ObjectFilter::AllOf([$filter_phrase, ControlledBy(One(AbilityController)), HasActivatedAbility(Mana)]) */
event_controlled_mana_subject_an ::= "an" filter_phrase "you" "control" "with" "a" "mana" "ability"

/* This event supplies the creature named by the following counter quantity. */
/* @sem EventSpec::ZoneChange{objects:@and($noun_creature, ObjectFilter::ControlledBy(One(AbilityController)), ObjectFilter::Counters(_{comparison:Greater, value:Constant(0)})), from:Battlefield, to:Graveyard} */
counter_creature_death_clause ::= "whenever" "a" noun_creature "you" "control" "with" "a" "counter" "on" "it" "dies"

/* The event and the once-per-turn return are independent typed phrases. */
/* @sem Ability::Triggered{event:$counter_creature_death_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PlayersDo{players:One(AbilityController), any_one:false, optional:true, once_each_turn:true, body:[Program{instructions:[Effect{result:@next, operation:PlayersDo{players:One(AbilityController), optional:true, once_each_turn:true, body:[Program{instructions:[Effect{result:@next, operation:$return_counter_bound_card_hand}]}]}}]}], otherwise:[]}}]}} */
triggered_counter_creature_once_return ::= counter_creature_death_clause "," "you" "may" return_counter_bound_card_hand "." "do" "this" "only" "once" "each" "turn" "."

/* One trigger for the group declared by the attacking opponent. */
/* @sem EventSpec::Batch{event:Attack{attackers:$filter_plural, by:OpponentsOf(AbilityController), defenders:Any}, per:Whole} */
opponent_attacks_with_one_or_more ::= "whenever" "an" "opponent" "attacks" "with" "one" "or" "more" filter_plural

/* The defender choice belongs to the same attacking opponent as the control grant. */
/* @sem Ability::Triggered{event:$opponent_attacks_with_one_or_more, intervening_if:$join_attack_condition, limits:TriggerLimits{}, announcement:@announcement, body:$opponent_control_join_attack_program} */
opponent_attack_control_join_trigger ::= opponent_attacks_with_one_or_more "," "if" join_attack_condition "," opponent_control_join_attack_program

/* @sem Condition::ObjectMatches{object:Source, filter:$condition_state} */
join_attack_condition ::= SELF_NAME "is" condition_state

/* The repeated filter proves that every event member qualifies for the choice. */
/* @prefer always */
/* @sem Ability::Triggered{event:Batch{event:AnyOf([ZoneChange{objects:AllOf([@agree(@agree($filter_plural, $filter_phrase), $filter_phrase_2), ControlledBy(One(AbilityController))]), from:Battlefield, to:Exile}, ZoneChange{objects:AllOf([@agree(@agree($filter_plural, $filter_phrase), $filter_phrase_2), InZone(Players{zone:Graveyard, players:One(AbilityController)})]), from:Graveyard, to:Exile}]), per:Whole}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:EventGroup, count:AsManyAsCan($counter_amount)}}]}}, Effect{result:@next, operation:$chosen_card_prefix_copy}]}} */
triggered_exiled_matching_choice ::= "whenever" "one" "or" "more" filter_plural "you" "control" "and" "/" "or" filter_phrase "cards" "in" "your" "graveyard" "are" "put" "into" "exile" "," "you" "may" "choose" counter_amount filter_phrase "card" "from" "among" "them" "." chosen_card_prefix_copy "."

/* The continuation can also remain inside the optional choice. */
/* @sem Ability::Triggered{event:Batch{event:AnyOf([ZoneChange{objects:AllOf([@agree(@agree($filter_plural, $filter_phrase), $filter_phrase_2), ControlledBy(One(AbilityController))]), from:Battlefield, to:Exile}, ZoneChange{objects:AllOf([@agree(@agree($filter_plural, $filter_phrase), $filter_phrase_2), InZone(Players{zone:Graveyard, players:One(AbilityController)})]), from:Graveyard, to:Exile}]), per:Whole}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:EventGroup, count:AsManyAsCan($counter_amount)}}, Effect{result:@next, operation:$chosen_card_prefix_copy}]}}]}} */
triggered_exiled_matching_choice_optional_copy ::= "whenever" "one" "or" "more" filter_plural "you" "control" "and" "/" "or" filter_phrase "cards" "in" "your" "graveyard" "are" "put" "into" "exile" "," "you" "may" "choose" counter_amount filter_phrase "card" "from" "among" "them" "." chosen_card_prefix_copy "."

/* @sem EventSpec::Discard(_{players:One(AbilityController), cards:$card_filter_or_keyword_family, kind:Any, grouping:Card}) */
event_you_discard_card_alternative ::= "you" "discard" card_filter_or_keyword_family

/* An individual attack names the defending opponent as its event subject. */
/* @sem EventSpec::Attack{attackers:SameObject($object_ref), defenders:Players(OpponentsOf(AbilityController))} */
event_reference_attacks_an_opponent ::= object_ref "attacks" "an" "opponent"

/* Scope the entry's defender reference to the opponent of this attack. */
/* @sem Ability::Triggered{event:$event_reference_attacks_an_opponent, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$optional_hand_entry_attacked_opponent}} */
trigger_attack_opponent_hand_entry ::= "whenever" event_reference_attacks_an_opponent "," optional_hand_entry_attacked_opponent "."

/* The damage event establishes the antecedent of its base power. */
/* @sem Ability::Triggered{event:$event_combat_damage_player, limits:_{}, announcement:@announcement, body:$draw_damage_source_base_power} */
/* @prefer always */
triggered_combat_draw_source_base_power ::= "whenever" event_combat_damage_player "," draw_damage_source_base_power "."

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$paid_removed_counters_tokens} */
triggered_paid_removed_counters_tokens ::= "at" turn_event "," paid_removed_counters_tokens

/* The attack event supplies both the creator and its opposing defender. */
/* @sem Ability::Triggered{event:$event_player_attacks_opponent, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@apply($attack_event_creator, $create_tapped_attacking_player_third)}]}} */
trigger_attack_player_tapped_token ::= "whenever" event_player_attacks_opponent "," attack_event_creator create_tapped_attacking_player_third "."

/* @sem EventSpec::Batch{event:Attack{attackers:Any, by:$event_player, defenders:Players($attack_player_opponent)}, per:Defender} */
event_player_attacks_opponent ::= event_player "attacks" attack_player_opponent

attack_event_creator ::= attack_event_creator_named | players_singular

/* @prefer always */
/* @sem PlayerSet::One(PlayerRef::EventSubject) */
attack_event_creator_named ::= "that" "attacking" "player"

/* The next first main phase is distinct from the next main phase. */
/* @sem EventSpec::Turn{point:FirstMainPhaseBegins, players:One(AbilityController)} */
scheduled_your_next_first_main ::= "the" "beginning" "of" "your" "next" "first" "main" "phase"

scheduled_turn_event ::= scheduled_your_next_first_main | delayed_your_upkeep | delayed_move_your_end

/* Both independent triggers retain the same subject and body. */
/* @sem Ability::[Triggered{event:ZoneChange{objects:$entry_or_leave_subject, to:Battlefield}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}, Triggered{event:Object{event:LeavesBattlefield, objects:$entry_or_leave_subject}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}] */
/* @prefer always */
triggered_enters_or_leaves_shared ::= "when" entry_or_leave_subject "enters" "or" "leaves" "the" "battlefield" "," program_sentence

/* @sem EventSpec::Player{event:WinsClash, players:One(AbilityController)} */
event_clause_you_win_clash ::= "whenever" "you" "win" "a" "clash"

/* The difference is bound to the compared spell in this intervening condition. */
/* @sem Ability::Triggered{event:$event_clause, intervening_if:$condition_mana_spent_below_value, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:LoseLife{players:$players_singular, amount:Subtract([ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}, ManaSpent{object:EventSubject, filter:_{}, aggregation:Count}])}}]}} */
triggered_spending_difference_life ::= event_clause "," "if" condition_mana_spent_below_value "," players_singular "loses" "life" "equal" "to" "the" "difference" "."

/* A death or an owned source moving from either hidden zone to its graveyard. */
/* @sem EventSpec::AnyOf([ZoneChange{objects:SameObject(Source), from:Battlefield, to:Graveyard}, ZoneChange{objects:AllOf([SameObject(Source), OwnedBy(One(AbilityController))]), from:Hand, to:Graveyard}, ZoneChange{objects:AllOf([SameObject(Source), OwnedBy(One(AbilityController))]), from:Library, to:Graveyard}]) */
source_death_or_owned_hidden_graveyard ::= "when" "this" "creature" "dies" "or" "is" "put" "into" "your" "graveyard" "from" "your" "hand" "or" "library"

/* The body remains an independent operation so its current count is printable. */
/* @sem Ability::Triggered{event:$source_death_or_owned_hidden_graveyard, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$conjure_self_unspecified_owner_graveyard}]}} */
source_hidden_graveyard_conjure_trigger ::= source_death_or_owned_hidden_graveyard "," conjure_self_unspecified_owner_graveyard "."

/* The granted ability's event and payment body retain their own scope. */
/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$holder_declined_payment_program} */
holder_unless_trigger ::= "at" turn_event "," holder_declined_payment_program "."

/* A goaded qualifier composes with the written singular population. */
/* @prefer always */
/* @sem @and($adjective_goaded, $filter_phrase) */
goaded_singular_event_subject ::= "a" adjective_goaded filter_phrase

event_one_opponent_subject ::= event_singular_subject | goaded_singular_event_subject

/* A suspected controlled population can be used by distinct group events. */
/* @sem ObjectFilter::@and(ObjectFilter::State(Suspected), $filter_plural, ObjectFilter::ControlledBy(One(AbilityController))) */
suspected_controlled_plural ::= "suspected" filter_plural "you" "control"

/* @sem ObjectFilter::$suspected_controlled_plural */
combat_group_suspected_controlled ::= "one" "or" "more" suspected_controlled_plural

/* @sem EventSpec::Batch{event:Attack{attackers:$suspected_controlled_plural, defenders:Any}, per:Whole} */
event_suspected_controlled_attack ::= "whenever" "one" "or" "more" suspected_controlled_plural "attack"

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$program_top_exile_play_those} */
triggered_turn_top_exile_play ::= "at" turn_event "," program_top_exile_play_those

/* The damage event supplies the amount used by both later X operands. */
retirement_damage_player_event ::= event_combat_damage_player | event_damage_player | event_combat_damage_opponent | event_damage_opponent

/* @prefer always */
/* @sem Expr::EventAmount */
retirement_damage_event_amount ::= "the" "amount" "of" "damage" "dealt"

/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(EventSubject)}, kind:Card, filter:Any}, count:$retirement_damage_event_amount, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
retirement_damage_exile_top ::= "exile" "the" "top" "X" "cards" "of" "their" "library" "," "where" "X" "is" retirement_damage_event_amount

/* @sem NumberTest::Compare{comparison:LessOrEqual, value:EventAmount} */
retirement_damage_mana_at_most ::= "X" "or" "less" /* @prefer always */

/* @sem NumberTest::Compare{comparison:Less, value:EventAmount} */
retirement_damage_mana_less ::= "less" "than" "X"

retirement_damage_mana_test ::= retirement_damage_mana_at_most | retirement_damage_mana_less

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Transition{result:@prior, phase:After}, filter:Property{property:ManaValue, test:$retirement_damage_mana_test}}, count:AnyNumber, cost:Free} */
retirement_damage_cast_arrivals ::= "you" "may" "cast" "any" "number" "of" "spells" "with" "mana" "value" retirement_damage_mana_test "from" "among" "them" "without" "paying" "their" "mana" "costs"

/* @prefer always */
/* @sem Ability::Triggered{event:$retirement_damage_player_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$retirement_damage_exile_top}, Effect{result:@next, operation:$retirement_damage_cast_arrivals}]}} */
retirement_damage_exile_cast_trigger ::= "whenever" retirement_damage_player_event "," retirement_damage_exile_top "." retirement_damage_cast_arrivals "." /* @prefer always */

/* @prefer always */
/* @sem Ability::[$retirement_damage_exile_cast_trigger] */
retirement_damage_exile_cast_line ::= retirement_damage_exile_cast_trigger

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$tap_objects}, ...$clash_won_followup]} */
clash_tap_outcome_program ::= tap_objects "." clash_won_followup

/* The payment branch contains the creation and its clash-dependent continuation. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@marked), then:$clash_created_outcome_program, otherwise:Program{}}]} */
clash_paid_outcome_program ::= "you" "may" payment "." "if" "you" "do" "," clash_created_outcome_program

/* @sem Program::Program{instructions:[$conditional_token_creation, ...$clash_won_followup]} */
clash_created_outcome_program ::= conditional_token_creation "." clash_won_followup

/* The damage source is the triggering spell; the recipient is the holder. */
/* @sem EventSpec::Damage(_{source_kind:Spell, sources:$spell_filter, recipients:Objects(SameObject(Source)), kind:$spell_holder_damage_kind, grouping:SourceRecipient, subject:Source}) */
event_spell_damages_holder_creature ::= spell_filter "deals" spell_holder_damage_kind "to" "this" "creature"

/* The event supplies the amount and spell identity to this damage response. */
/* @sem Ability::Triggered{event:$event_spell_damages_holder_creature, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$spell_damage_response_choice}]}} */
triggered_spell_damage_response ::= "whenever" event_spell_damages_holder_creature "," spell_damage_response_choice "."

spell_damage_response_choice ::= spell_damage_response | spell_damage_response_unpreventable

/* @sem Operation::DealDamage{source:$self_ref_holder, recipients:$spell_damage_response_recipient, amount:$damage_receipt_amount, preventable:true} */
spell_damage_response ::= self_ref_holder "deals" damage_receipt_amount "damage" "to" spell_damage_response_recipient

/* @sem Operation::DealDamage{source:$self_ref_holder, recipients:$spell_damage_response_recipient, amount:$damage_receipt_amount, preventable:false} */
spell_damage_response_unpreventable ::= self_ref_holder "deals" damage_receipt_amount "damage" "to" spell_damage_response_recipient "." "this" "damage" "can't" "be" "prevented"

/* @sem Recipients::Players(One(ControllerOf(EventSubject))) */
spell_damage_response_controller ::= "that" "spell's" "controller"

/* @sem Recipients::Players(One(AbilityController)) */
spell_damage_response_you ::= "you"

spell_damage_response_recipient ::= spell_damage_response_controller | spell_damage_response_you

/* @sem DamageKind::Any */
spell_holder_damage_any ::= "damage"

/* @sem DamageKind::Noncombat */
spell_holder_damage_noncombat ::= "noncombat" "damage"

spell_holder_damage_kind ::= spell_holder_damage_any | spell_holder_damage_noncombat

/* The spell mentioned by the spending measure is this cast event's subject. */
/* @sem Ability::Triggered{event:$event_cast, limits:TriggerLimits{}, announcement:@announcement, body:$cast_spending_counters_then_threshold} */
triggered_cast_spending_counters ::= "whenever" event_cast "," cast_spending_counters_then_threshold

/* The self damage event scopes both the event amount and the damaged actor. */
/* @sem Ability::Triggered{event:$self_damage_event, limits:TriggerLimits{}, announcement:@announcement, body:$self_damage_reflection_program} */
triggered_self_damage_reflection ::= "whenever" self_damage_event "," self_damage_reflection_program "."

/* @sem EventSpec::Damage(DamageEvent{source_kind:Any, sources:Any, recipients:Objects($event_self), kind:$shared_damage_kind, grouping:Recipient, subject:Recipient}) */
self_damage_event ::= event_self "is" "dealt" shared_damage_kind

/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_damage_actor, recipients:$self_damage_target, amount:$damage_receipt_amount, preventable:true}}]} */
self_damage_reflection_program ::= self_damage_actor "deals" damage_receipt_amount "damage" "to" self_damage_target

/* @sem ObjectRef::EventSubject */
self_damage_actor_he ::= "he"

/* @sem ObjectRef::EventSubject */
self_damage_actor_it ::= "it"

self_damage_actor ::= self_damage_actor_he | self_damage_actor_it

/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Not(SameObject(Source))})) */
self_damage_other_target ::= "any" "other" "target"

self_damage_target ::= self_damage_other_target

draw_ordinal ::= ordinal | draw_ordinal_fifth

/* @sem Expr::Constant(5) */
draw_ordinal_fifth ::= "fifth"

/* Controller draw ordinals compose with any ordinary triggered program. */
/* @sem Ability::Triggered{event:$event_you_draw_ordinal, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence} */
triggered_controller_nth_draw ::= "whenever" event_you_draw_ordinal "," program_sentence

/* A graveyard-local return retains the draw event and movement operands. */
/* @prefer always */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$collector_draw_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$delayed_graveyard_self_move}]}})} */
triggered_nth_draw_graveyard_return ::= "when" collector_draw_event "," delayed_graveyard_self_move "."

/* The ordinal counts all spells cast during the turn, regardless of caster. */
/* @sem EventSpec::NthEachTurn{event:Spell{event:Cast, players:All, spells:Any}, test:NumberTest::Compare{comparison:Equal, value:$ordinal}} */
event_nth_spell_of_turn_cast ::= "the" ordinal "spell" "of" "a" "turn" "is" "cast"

/* The same player and their planeswalkers form the defending population. */
/* @sem AttackDefenders::PlayersAndPlaneswalkers(One(AbilityController)) */
attack_defender_you_and_walker ::= "you" "and" "/" "or" "a" "planeswalker" "you" "control"

/* @sem DamageRecipients::Players(OpponentsOf(PlayerRef::AbilityController)) */
source_damage_one_or_more_opponents ::= "one" "or" "more" "of" "your" "opponents"

/* The first upkeep retains its actual turn owner. */
/* @sem EventSpec::FirstEachTurn(Turn{point:UpkeepBegins, players:$turn_owner}) */
turn_first_upkeep_each_turn ::= "the" "beginning" "of" turn_owner "first" "upkeep" "each" "turn"

/* A target selection event, independent of later trigger restrictions. */
/* @sem EventSpec::TargetsChosen{players:All, objects:Any} */
event_player_chooses_targets ::= "a" "player" "chooses" "one" "or" "more" "targets"

/* @sem Ability::[Triggered{event:Player{event:GameBegins, players:All}, limits:_{}, body:_{instructions:[Effect{result:@next, operation:$choose_value}]}, announcement:@announcement}] */
line_game_begins_choice ::= "at" "the" "beginning" "of" "the" "game" "," choose_value "."

/* The active player is the drawing player; the ordinal counts that player's draws. */
/* @sem EventSpec::NthEachTurn{event:Player{event:DrawsCard, players:One(Active)}, test:NumberTest::Compare{comparison:Equal, value:$cast_spell_ordinal}} */
active_player_ordinal_draw ::= "a" "player" "draws" "their" cast_spell_ordinal "card" "during" "their" "turn"

/* @sem EventSpec::$active_player_ordinal_draw */
active_player_ordinal_draw_clause ::= "whenever" active_player_ordinal_draw

/* Compare the spell against the stated card population in its controller's library. */
/* @sem @and($spell_library_type_base, $spell_unshared_library_type) */
spell_unshared_library_creature_type ::= spell_library_type_base spell_unshared_library_type

spell_library_type_base ::= spell_filtered | spell_any

/* @sem ObjectFilter::Not(SharesWithAny{property:CreatureTypes, with:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}}) */
spell_unshared_library_type ::= "that" "doesn't" "share" "a" "creature" "type" "with" "a" filter_phrase "card" "in" "your" "library"

/* Transform actions keep the copied population and counter population independent. */
/* @sem Ability::AsEvent{object:Source, event:Transforms, actions:List([$transform_linked_copy, $transform_linked_counters])} */
as_transform_linked_copy ::= "as" "this" "creature" "transforms" "into" SELF_NAME "," transform_linked_copy "." transform_linked_counters "."

/* @sem Operand::Term{family:TransformAction, form:BecomeACopyOfAnExiledCard, operands:[Objects(Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$noun, ExiledWith(Source)])}), $transform_copy_exceptions]} */
transform_linked_copy ::= "it" "becomes" "a" "copy" "of" ("a" | "an") noun "card" "exiled" "with" "it" "," "except" transform_copy_exceptions

/* @sem Operand::Term{family:CopyEffects, form:CopyEffects, operands:[Term{family:CopyEffect, form:SetName, operands:[Text(@card_name)]}, Term{family:CopyEffect, form:SetPT, operands:[$entry_face_pt]}, Term{family:CopyEffect, form:AddSupertypes, operands:[Vocabulary{family:SuperType, form:Legendary}]}, Term{family:CopyEffect, form:AddColor, operands:[Term{family:SettableColor, form:SimpleColorList, operands:[$perpetual_simple_color, $perpetual_simple_color_2]}]}, Term{family:CopyEffect, form:AddCreatureTypes, operands:[$choice_creature_type_plain]}]} */
transform_copy_exceptions ::= "its" "name" "is" SELF_NAME "," "it's" entry_face_pt "," "and" "it's" "a" "legendary" perpetual_simple_color "and" perpetual_simple_color choice_creature_type_plain "in" "addition" "to" "its" "other" "colors" "and" "types"

/* @sem Operand::Term{family:TransformAction, form:TransformsWithNumberCounters, operands:[Number(CountObjects(Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$noun, ExiledWith(Source)])})), $entry_face_pt_counter]} */
transform_linked_counters ::= "put" "a" "number" "of" entry_face_pt_counter "counters" "on" SELF_NAME "equal" "to" "the" "number" "of" noun "cards" "exiled" "with" "it"

/* The source can be a spell, permanent, or card; both qualifiers apply to it. */
/* @sem ObjectFilter::@and($damage_source_quality, $modifier_you_control) */
qualified_controlled_damage_source ::= "a" damage_source_quality "source" modifier_you_control

damage_source_quality ::= adjective_nontype | adjective_color

/* @sem EventSpec::Damage(_{source_kind:Any, sources:$qualified_controlled_damage_source, recipients:Any, kind:$event_damage_kind, grouping:Source, subject:Source}) */
event_qualified_controlled_source_damage ::= qualified_controlled_damage_source "deals" event_damage_kind

/* A cast trigger composes the event with its resolution-time program. */
/* @sem Ability::Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:$repeat_cast_plain, limits:TriggerLimits{}, announcement:@announcement, body:$cast_subject_conditional_copy})} */
source_cast_conditional_copy_trigger ::= repeat_cast_plain "," cast_subject_conditional_copy

/* A shared actor performs either paired action; preserve both object filters. */
/* @sem EventSpec::AnyOf([Pair{event:Saddles, objects:SameObject($object_ref), others:$filter_phrase}, Pair{event:Crews, objects:SameObject($object_ref), others:$filter_phrase_2}]) */
shared_saddles_or_crews_event ::= object_ref "saddles" "a" filter_phrase "or" "crews" "a" filter_phrase

/* The controller must be active and the event must occur in a main phase. */
/* @sem EventSpec::Filtered{event:$shared_saddles_or_crews_event, condition:AllOf([PlayerIsActive(AbilityController), Window(MainPhase)])} */
shared_saddles_or_crews_main_clause ::= "whenever" shared_saddles_or_crews_event "during" "your" "main" "phase"

/* The entering objects and the holders of suppressed abilities are independent. */
/* @sem Ability::[TriggerRule{cause:ZoneChange{objects:$filter_plural, to:Battlefield}, abilities:AbilityOf($filter_plural_2), rule:DoesntTrigger}] */
line_suppress_entering_abilities_of ::= filter_plural "entering" "don't" "cause" "abilities" "of" filter_plural "to" "trigger" "."

/* @sem ObjectFilter::State(HybridInCost) */
spell_with_hybrid_cost ::= "with" "hybrid" "mana" "in" "its" "mana" "cost"

/* The two branches share the subject of the triggering zone change. */
/* @sem EventSpec::AnyOf([ZoneChange{objects:@and($event_self, ObjectFilter::OwnedBy(All)), from:Battlefield, to:Graveyard}, ZoneChange{objects:@and(ObjectFilter::Not($event_self), $filter_phrase, ObjectFilter::OwnedBy(All)), from:Battlefield, to:Graveyard}]) */
event_self_dies_or_another_put_graveyard ::= event_self "dies" "or" "another" filter_phrase "is" "put" "into" "a" "graveyard" "from" "the" "battlefield"

/* A turn trigger can carry the scoped least-stat selection and its pump. */
/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:_{instructions:$instructions_choose_least_opponent_pump}} */
triggered_turn_choose_least_opponent_pump ::= "at" turn_event "," instructions_choose_least_opponent_pump "."

/* @sem Ability::Triggered{event:$turn_upkeep, limits:TriggerLimits{}, announcement:@announcement, body:$upkeep_player_mill_mana_tokens_program} */
triggered_upkeep_player_receipt ::= "at" turn_upkeep "," upkeep_player_mill_mana_tokens_program

/* The parity test applies to the cast spell's mana value. */
cast_spell_parity ::= cast_spell_odd_mana | cast_spell_even_mana

/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:SameParity, value:Constant(1)}} */
cast_spell_odd_mana ::= "a" "spell" "with" "an" "odd" "mana" "value"

/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:SameParity, value:Constant(0)}} */
cast_spell_even_mana ::= "a" "spell" "with" "an" "even" "mana" "value"

/* The activated ability's holder is restricted to the battlefield. */
/* @sem EventSpec::Activated{players:$event_player, abilities:AbilityOf(@and($filter_phrase, ObjectFilter::InZone(Shared(Battlefield))))} */
battlefield_ability_activation_clause ::= "whenever" event_player "activates" "an" "ability" "of" "an" filter_phrase "on" "the" "battlefield"

/* The stack object is the ability, independently of its activating player. */
/* @sem Condition::ObjectMatches{object:EventStackObject, filter:Not(OnStack(Mana))} */
activated_ability_nonmana_condition ::= "it" "isn't" "a" "mana" "ability"

/* @sem Ability::Triggered{event:$battlefield_ability_activation_clause, intervening_if:$activated_ability_nonmana_condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence} */
triggered_battlefield_ability_condition ::= battlefield_ability_activation_clause "," "if" activated_ability_nonmana_condition "," program_sentence

/* A third-person coin winner keeps the printed event player set. */
/* @sem EventSpec::Player{event:WinsCoinFlip, players:$event_player} */
coin_flip_winner_clause ::= "whenever" event_player "wins" "a" "coin" "flip"

/* The once-only limit applies to the complete triggering event. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{total:1}, announcement:@announcement, body:$program_seek_cloak_shared} */
triggered_once_seek_cloak_shared ::= event_clause "," program_seek_cloak_shared "this" "ability" "triggers" "only" "once" "."

/* A spell can be compared independently with controlled permanents and cards
   in its controller's graveyard. The property is creature types, not colors. */
/* @sem ObjectFilter::Not(AnyOf(@unordered([SharesWithAny{property:CreatureTypes, with:$shared_type_controlled_population}, SharesWithAny{property:CreatureTypes, with:$shared_type_graveyard_population}]))) */
spell_not_sharing_creature_type ::= "that" "doesn't" "share" "a" "creature" "type" "with" shared_type_controlled_population "or" shared_type_graveyard_population

/* Both damage branches share the same damaged player set. */
/* @sem EventSpec::AnyOf([Damage(_{source_kind:Spell, sources:AllOf([$adjective_color, $filter_phrase, ControlledBy(One(AbilityController))]), recipients:Players($event_player), kind:Any, grouping:SourceRecipient, subject:Source}), Damage(_{source_kind:Permanent, sources:$filter_phrase_2, recipients:Players($event_player), kind:Any, grouping:SourceRecipient, subject:Source})]) */
event_player_dealt_damage_by_spell_or_permanent ::= event_player "is" "dealt" "damage" "by" ("a" | "an") adjective_color filter_phrase "spell" "you" "control" "or" "by" ("a" | "an") filter_phrase

/* A triggered ability that functions while its source is on the battlefield or in exile. */
/* @sem Ability::Scoped{zones:[Exile, Battlefield], ability:@scope(Ability::Triggered{event:$event_clause, intervening_if:ObjectMatches{object:@remember_object($self_explicit_ref), filter:AnyOf([InZone(Shared(Exile)), InZone(Shared(Battlefield))])}, limits:TriggerLimits{}, announcement:@announcement, body:$battlefield_or_exile_program})} */
triggered_battlefield_or_exile ::= event_clause "," "if" self_explicit_ref "is" "on" "the" "battlefield" "or" "in" "exile" "," battlefield_or_exile_program "."

battlefield_or_exile_program ::= program | program_then_if_it_on_battlefield

/* Follow-up zone test on the remembered source inside a battlefield-or-exile trigger. */
/* @sem Program::Program{instructions:[...$clause, If{condition:ObjectMatches{object:@it, filter:InZone(Shared(Battlefield))}, then:$then_condition_program, otherwise:Program{}}]} */
program_then_if_it_on_battlefield ::= clause "." "then" "if" "it's" "on" "the" "battlefield" "," then_condition_program

/* The intervening-if introduces the damaged player's counter-bearing permanents
   that the combat-damage source's controller chooses from, gains control of, and untaps. */
/* @sem Ability::Triggered{event:Damage(_{source_kind:Permanent, sources:$noun, recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source}), intervening_if:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)}), ControlledBy(One(EventSubject))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:ChooseObjects{player:ControllerOf(EventSubject), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($filter_plural, $filter_plural_2), Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)}), ControlledBy(One(EventSubject))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@marked, phase:After, index:0})), changes:[SetController(ControllerOf(EventSubject))], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:SetTapped{objects:One(Result{result:@marked, phase:After, index:0}), tapped:false}}]}} */
triggered_combat_damage_steal_countered ::= "whenever" "a" noun "deals" "combat" "damage" "to" "a" "player" "," "if" "that" "player" "controls" "one" "or" "more" filter_plural "with" counter_kind "counters" "on" "them" "," "that" "creature's" "controller" "gains" "control" "of" "one" "of" "those" filter_plural "of" "their" "choice" "and" "untaps" "it" "."

/* Reanimating an enchanted graveyard card swaps the Aura's graveyard enchant
   ability for battlefield attachment and ties the leave-battlefield sacrifice
   to the reanimated creature's controller. */
/* @sem Ability::Triggered{event:ZoneChange{objects:SameObject(Source), to:Battlefield}, intervening_if:ObjectMatches{object:EventSubject, filter:InZone(Shared(Battlefield))}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[LosesAbility(Term{family:CheckHasable, form:Enchant, operands:[Objects(Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$noun})]}), GrantAbility(Enchant{hosts:Permanents(AllOf([@agree($noun, $noun_2), MadeBy(Source)]))})], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@mark, operation:Move{objects:One(AttachedTo(Source)), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Attach{attachments:One(Source), host:Result{result:@marked, phase:After, index:0}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Object{event:LeavesBattlefield, objects:SameObject(Source)}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(ControllerOf(Result{result:@marked, phase:After, index:0})), objects:One(Result{result:@marked, phase:After, index:0})})}]}}}]}} */
triggered_aura_reanimate_return ::= "when" "this" "Aura" "enters" "," "if" "it's" "on" "the" "battlefield" "," "it" "loses" '"' "↓" "enchant" noun "card" "in" "a" "graveyard" '"' "and" "gains" '"' "↓" "enchant" noun "put" "onto" "the" "battlefield" "with" "this" "Aura" "." '"' "return" "enchanted" "creature" "card" "to" "the" "battlefield" "under" "your" "control" "and" "attach" "this" "Aura" "to" "it" "." "when" "this" "Aura" "leaves" "the" "battlefield" "," "that" "creature's" "controller" "sacrifices" "it" "."

/* A turn trigger can resolve a postposed conditional with two programs. */
/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$program_conditional_postposed_else} */
triggered_turn_postposed_conditional ::= "at" turn_event "," program_conditional_postposed_else "."

/* @prefer always */
/* @sem Ability::Triggered{event:$collector_draw_event, limits:TriggerLimits{total:1}, announcement:@announcement, body:$once_ordinal_draw_body} */
triggered_once_ordinal_draw ::= "when" collector_draw_event "," once_ordinal_draw_body "."

once_ordinal_draw_body ::= once_ordinal_draw_self_return | program

/* @prefer always */
/* @sem Program::Program{instructions:$instructions_self_exile_return_her_transformed} */
once_ordinal_draw_self_return ::= instructions_self_exile_return_her_transformed

event_attack_subject ::= event_object | goaded_singular_event_subject

/* A past land play retains the controller as actor. */
/* @sem EventSpec::Player{event:PlaysLand, players:One(AbilityController), objects:Any} */
past_controller_land_play ::= "played"

/* An event subject can use the same controlled, equal-stat population. */
/* @sem ObjectFilter::$entry_controlled_equal_stats */
event_equal_stats_controlled ::= ("a" | "an") entry_controlled_equal_stats

/* The condition supplies the antecedent for this scoped action. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:$condition_enchanted_host_attached_creature, limits:TriggerLimits{}, announcement:@announcement, body:$attached_host_creature_program} */
triggered_turn_attached_host_creature ::= "at" turn_event "," "if" condition_enchanted_host_attached_creature "," attached_host_creature_program

/* @sem EventSpec::ZoneChange{objects:$entry_subject_except_kind, to:Battlefield} */
event_except_entry ::= entry_subject_except_kind "enters"

/* @sem ObjectFilter::Not($filter_phrase) */
entry_subject_except_kind ::= "a" "permanent" "other" "than" "a" filter_phrase

/* Unspecified counters retain the referenced event subject within its ability scope. */
/* @sem EventSpec::Batch{event:Counters{change:Put, objects:SameObject($object_ref)}, per:Subject} */
first_object_unspecified_counters ::= "one" "or" "more" "counters" "are" "put" "on" object_ref

/* The intervening condition and defending-player program are independent. */
/* @prefer always */
/* @sem Ability::Triggered{event:$defending_source_attack_whenever, intervening_if:$condition_completed_dungeon, limits:TriggerLimits{}, announcement:@announcement, body:$defending_exile_counter_life} */
triggered_attack_conditional_defender_exile_count ::= defending_source_attack_whenever "," "if" condition_completed_dungeon "," defending_exile_counter_life "."

/* The stationing object is the event subject; the source is stationed. */
/* @sem EventSpec::Pair{event:Stations, objects:$noun, others:SameObject(Source)} */
event_clause_station_source ::= "whenever" "a" noun "stations" "this" "Spacecraft"

/* A counter batch retains its named kind and referenced subject. */
/* @sem EventSpec::Batch{event:Counters{change:Put, kind:$counter_kind, objects:SameObject($object_ref)}, per:Subject} */
event_referenced_counters_put ::= "one" "or" "more" counter_kind "counters" "are" "put" "on" object_ref

/* The same event composes with ordinary triggered abilities. */
/* @sem EventSpec::NthCounter{kind:$entry_face_pt_counter, objects:$event_self, nth:$nth_counter_ordinal} */
nth_counter_placed_clause ::= "when" "the" nth_counter_ordinal entry_face_pt_counter "counter" "is" "put" "on" event_self

nth_counter_ordinal ::= ordinal | nth_counter_tenth

/* @sem Expr::Constant(10) */
nth_counter_tenth ::= "tenth"

/* Track the selected permanent and trigger on its graveyard arrival. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:ZoneChange{objects:AllOf([SameObject($target_another), OwnedBy(All)]), from:Battlefield, to:Graveyard}, duration:$this_duration, body:$chosen_graveyard_followup, announcement:_{}}}] */
instructions_chosen_graveyard_trigger ::= "choose" target_another "." "when" "it's" "put" "into" "a" "graveyard" this_duration "," chosen_graveyard_followup

/* The pronoun in the return refers to the holder named by the condition. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:$condition_holder_lacks_counter, limits:TriggerLimits{}, announcement:@announcement, body:$program_return_trigger_source_to_owner_hand} */
triggered_holder_lacks_counter_return ::= "at" turn_event "," "if" condition_holder_lacks_counter "," program_return_trigger_source_to_owner_hand

/* @sem Ability::Triggered{event:$event_cast, limits:_{}, announcement:@announcement, body:$earthbend_cast_spell_followup} */
trigger_cast_earthbend_followup ::= "whenever" event_cast "," earthbend_cast_spell_followup "."

/* The quantity belongs to this mill batch; keep the consumer under its event. */
/* @sem Ability::Triggered{event:$event_cards_milled_batch, limits:TriggerLimits{}, announcement:@announcement, body:$mill_batch_optional_tokens} */
triggered_mill_batch_optional_tokens ::= "whenever" event_cards_milled_batch "," mill_batch_optional_tokens

/* @sem Program::_{instructions:[Effect{result:@next, operation:PlayersDo{players:One(AbilityController), any_one:false, optional:true, once_each_turn:true, body:[Program(_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:EventAmount, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]})], otherwise:[]}}]} */
mill_batch_optional_tokens ::= "you" "may" "create" "that" "many" token_recipe "." "do" "this" "only" "once" "each" "turn" "."

/* A batch retains the affected object's identity as its event subject. */
/* @sem EventSpec::Batch{event:Counters(_{change:Removed, kind:$counter_kind, objects:$event_self}), per:Subject} */
shared_named_counter_removal ::= "whenever" "one" "or" "more" counter_kind "counters" "are" "removed" "from" event_self

/* @sem Ability::Triggered{event:$shared_named_counter_removal, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$shared_she_event_amount_damage}]}} */
shared_counter_removal_damage_trigger ::= shared_named_counter_removal "," shared_she_event_amount_damage "."

/* One batch for each referenced recipient of unspecified counter placements. */
/* @sem EventSpec::Batch{event:Counters(_{change:Put, objects:SameObject($object_ref)}), per:Subject} */
event_unspecified_counters_put_on_reference ::= "one" "or" "more" "counters" "are" "put" "on" object_ref

/* A whole attack batch counts the qualifying creatures, even when different
   opponents control them. The controller filter is not the attack actor. */
/* @sem EventSpec::Batch{event:Attack{attackers:AllOf([$plural, ControlledBy(OpponentsOf(AbilityController))]), defenders:Any}, per:Whole, count:[GreaterOrEqual, $number]} */
event_opponents_controlled_attack_count ::= "whenever" number "or" "more" plural "your" "opponents" "control" "attack"

/* A whole combat attack batch meeting a printed minimum. */
/* @sem EventSpec::Batch{event:Attack{attackers:$filter_plural, defenders:Any}, per:Whole, count:[GreaterOrEqual, $count_plural]} */
event_counted_creatures_attack ::= count_plural "or" "more" filter_plural "attack"

/* Compose a cast event, its intervening condition, and a dependent program. */
/* @sem Ability::Triggered{event:$event_player_casts_two_spell_types_an, intervening_if:$condition_event_spell_targets_only_source_creature, limits:_{}, announcement:@announcement, body:$program_copy_event_for_other_legal_targets} */
triggered_cast_condition_copy_legal_targets ::= "whenever" event_player_casts_two_spell_types_an "," "if" condition_event_spell_targets_only_source_creature "," program_copy_event_for_other_legal_targets

/* The follow-up refers to the sole creature targeted by this cast event. */
/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:AllOf([OnStack(SingleTarget), TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}))])} */
event_cast_single_creature ::= "whenever" "you" "cast" "a" "spell" "that" "targets" "only" "a" "single" "creature"

/* @sem Ability::Triggered{event:$event_cast_single_creature, limits:TriggerLimits{}, announcement:@announcement, body:$sole_target_conditional_program} */
triggered_single_creature_followup ::= event_cast_single_creature "," sole_target_conditional_program
