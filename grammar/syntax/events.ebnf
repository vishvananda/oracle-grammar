/* @sem EventSpec::Player{event:LosesControl, players:$players_singular, objects:SameObject($object_ref)} */
event_control_loss_third ::= players_singular "loses" "control" "of" object_ref

/* A singular card departure keeps its filter and its graveyard owner distinct. */
