/* Activation filters preserve the stack ability and its source independently. */
/* @sem EventSpec::Activated{players:One(AbilityController), abilities:OnStack(Keyword(Ninjutsu))} */
event_activation_ninjutsu ::= "you" "activate" "a" "ninjutsu" "ability"

/* @sem EventSpec::Activated{players:One(AbilityController), abilities:AllOf([AbilityOf(AnyOf([$noun, $noun_2])), Not(OnStack(Mana))])} */
event_activation_nonmana_owned_pair ::= "you" "activate" "an" "ability" "of" "an" noun "or" noun "that" "isn't" "a" "mana" "ability"

/* These phrases identify the stack object that the following copy refers to. */
activation_copy_filter ::= activation_copy_nonmana | activation_copy_exhaust_nonmana

/* @sem ObjectFilter::Not(OnStack(Mana)) */
activation_copy_nonmana ::= "an" "ability" "that" "isn't" "a" "mana" "ability"

/* @sem ObjectFilter::AllOf([OnStack(Keyword(Exhaust)), Not(OnStack(Mana))]) */
activation_copy_exhaust_nonmana ::= "an" "exhaust" "ability" "that" "isn't" "a" "mana" "ability"

/* @sem EventSpec::Activated{players:One(AbilityController), abilities:$activation_copy_filter} */
activation_copy_event ::= "whenever" "you" "activate" activation_copy_filter

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventStackObject, times:Constant(1), targets:May}}]} */
activation_copy_program ::= "copy" "it" "." "you" "may" "choose" "new" "targets" "for" "the" "copy" "."

/* @sem Ability::Triggered{event:$activation_copy_event, limits:TriggerLimits{}, announcement:@announcement, body:$activation_copy_program} */
triggered_activation_copy ::= activation_copy_event "," activation_copy_program

/* One event applies to the referenced object or a distinct controlled object. */
/* @sem EventSpec::AnyOf([Object{event:$singular_object_action, objects:SameObject($object_ref)}, Object{event:$singular_object_action, objects:AllOf([Not(SameObject($object_ref)), $controlled_entry_filter])}]) */
event_referenced_or_another_controlled ::= object_ref "or" "another" controlled_entry_filter singular_object_action

/* A command-zone trigger is active where its own explicit subject is located. */
/* @sem Condition::ObjectMatches{object:$self_explicit_ref, filter:InZone(Shared(Command))} */
condition_self_in_command ::= self_explicit_ref "is" "in" "the" "command" "zone"

/* @sem Ability::Scoped{zones:[Command], ability:@scope(Ability::Triggered{event:$turn_event, intervening_if:$condition_self_in_command, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})} */
triggered_turn_self_in_command ::= "at" turn_event "," "if" condition_self_in_command "," program_sentence

/* An entry from outside hand and an independent spell cast are alternatives. */
/* @sem EventSpec::@either_event($event_entry_outside_hand, $event_cast_not_from_hand) */
event_entry_or_cast_outside_hand ::= event_entry_outside_hand "or" event_cast_not_from_hand

/* @sem EventSpec::ZoneChangeFromElsewhere{objects:$filter_phrase, except:[Hand], to:Battlefield} */
event_entry_outside_hand ::= "a" filter_phrase "enters" "from" "anywhere" "other" "than" "your" "hand"

/* The gaining player and the permanent type remain independent event operands. */
/* @sem EventSpec::ControlChanges{objects:$control_change_object, to:$event_player, from:One(AbilityController)} */
event_player_gains_control_from_you ::= event_player "gains" "control" "of" control_change_object "from" "you"

control_change_object ::= control_change_a | control_change_an

/* @sem $control_change_a_noun */
control_change_a ::= "a" control_change_a_noun

/* @sem $control_change_an_noun */
control_change_an ::= "an" control_change_an_noun

control_change_a_noun ::= card_permanent | noun_creature | noun_land | noun_planeswalker | noun_battle

control_change_an_noun ::= noun_artifact | noun_enchantment

/* A player action applies separately to the referenced object and the other population. */
/* @sem EventSpec::AnyOf([Player{event:Sacrifices, players:$sacrifice_event_actor, objects:SameObject($object_ref)}, Player{event:Sacrifices, players:$sacrifice_event_actor, objects:AllOf([Not(SameObject($object_ref)), $filter_phrase])}]) */
event_sacrifice_referenced_or_another ::= sacrifice_event_actor object_ref "or" "another" filter_phrase

sacrifice_event_actor ::= sacrifice_event_you | sacrifice_event_third

/* @sem PlayerSet::One(PlayerRef::AbilityController) */
sacrifice_event_you ::= "you" "sacrifice"

/* @sem $event_player */
sacrifice_event_third ::= event_player "sacrifices"

/* A single unspecified counter placed on each matching subject. */
/* @sem EventSpec::Batch{event:Counters(_{change:Put, objects:$filter_phrase}), per:Subject} */
event_clause_counter_put_on ::= "whenever" "a" "counter" "is" "put" "on" "a" filter_phrase

/* The result is bound by the enclosing damage-and-trigger instruction pair. */
/* @sem EventSpec::ZoneChange{objects:AllOf([$filter_phrase, ControlledBy(One(AbilityController)), DamagedBy(@prior)]), from:Battlefield, to:Graveyard} */
event_controlled_damaged_this_way_dies ::= "a" filter_phrase "you" "control" "dealt" "damage" "this" "way" "dies"

/* The pair shares both its subject and the opposing combat group. */
/* @sem EventSpec::AnyOf([Batch{event:Pair{event:Blocks, objects:$event_singular_subject, others:$combat_group_filter}, per:Subject}, Batch{event:Pair{event:BecomesBlockedBy, objects:$event_singular_subject, others:$combat_group_filter}, per:Subject}]) */
event_blocks_or_blocked_group ::= event_singular_subject "blocks" "or" "becomes" "blocked" "by" combat_group_filter

/* The two populations retain independent filters and departure zones. */
/* @sem EventSpec::ZoneChange{objects:$filter_plural, from:Battlefield, to:Exile} */
exiled_battlefield_population ::= filter_plural

/* @sem EventSpec::ZoneChange{objects:@and($filter_phrase, ObjectFilter::InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)})), from:Graveyard, to:Exile} */
exiled_own_graveyard_population ::= filter_phrase "cards" "in" "your" "graveyard"

/* @sem EventSpec::AnyOf([$exiled_battlefield_population, $exiled_own_graveyard_population]) */
exiled_populations ::= exiled_battlefield_population "and" "/" "or" exiled_own_graveyard_population

/* @sem EventSpec::Batch{event:$exiled_populations, per:Whole} */
event_batch_exiled_origins ::= "one" "or" "more" exiled_populations "are" "put" "into" "exile"

/* Join an entry event with an independently phrased card-play event. */
/* @sem EventSpec::@either_event($event_enters, $event_you_play_type_count) */
entry_and_card_play_clause ::= "when" event_enters "and" "whenever" event_you_play_type_count

/* @sem EventSpec::Player{event:PlaysCard, players:One(AbilityController), objects:$played_card_type_count} */
event_you_play_type_count ::= "you" "play" "a" played_card_type_count

/* @sem ObjectFilter::Property{property:CardTypeCount, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
played_card_type_count ::= "card" "with" value "or" "more" "card" "types"

/* @sem EventSpec::SpellTargeting{players:One(AbilityController), spells:$st_aura, targets:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$aura_target_of_opponent}} */
event_cast_targeting_filtered ::= "you" "cast" "an" st_aura "spell" "that" "targets" aura_target_of_opponent

/* @sem ObjectFilter::AllOf([$aura_target_object_type, ControlledBy(OpponentsOf(AbilityController))]) */
aura_target_of_opponent ::= aura_target_object_type "an" "opponent" "controls"

aura_target_object_type ::= aura_target_creature | aura_target_artifact

/* @sem $noun_creature */
aura_target_creature ::= "a" noun_creature

/* @sem $noun_artifact */
aura_target_artifact ::= "an" noun_artifact

/* The graveyard possessor is the owner; the excluded origin is explicit. */
/* @sem EventSpec::ZoneChangeFromElsewhere{objects:@and($random_cards, ObjectFilter::OwnedBy(One(AbilityController))), except:[Battlefield], to:Graveyard} */
owned_cards_elsewhere_event ::= random_cards "were" "put" "into" "your" "graveyard" "from" "anywhere" "other" "than" "the" "battlefield"

/* Convoke records the creature's contribution to the specified spell. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:History{event:Convoked($object_ref), window:ThisGame}} */
convoke_history_population ::= "a" "creature" "that" "convoked" object_ref

/* The comparison is relative to the other member of the current block pair. */
combat_blocker_filter ::= filter_phrase | combat_blocker_lesser_power

combat_attacker_filter ::= filter_phrase | combat_attacker_lesser_power

/* @sem ObjectFilter::AllOf([$filter_phrase, Property{property:Power, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:BlockPair(Attacker), property:Power, information:CurrentOrLastKnown}}}]) */
combat_blocker_lesser_power ::= filter_phrase "with" "lesser" "power"

/* @sem ObjectFilter::AllOf([$filter_phrase, Property{property:Power, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:BlockPair(Blocker), property:Power, information:CurrentOrLastKnown}}}]) */
combat_attacker_lesser_power ::= filter_phrase "with" "lesser" "power"

/* The ability filter is shared by activation events and activation history. */
activated_ability_object ::= activated_loyalty_ability | activated_ordinary_ability

/* @sem ObjectFilter::AllOf([OnStack(Loyalty), AbilityOf($filter_phrase)]) */
activated_loyalty_ability ::= "a" "loyalty" "ability" "of" ("a" | "an") filter_phrase

/* @sem ObjectFilter::AbilityOf($filter_phrase) */
activated_ordinary_ability ::= "an" "ability" "of" ("a" | "an") filter_phrase

/* A referenced permanent and a distinct matching object returning to their owner's hand.
   The origin remains an operand of both event alternatives. */
/* @sem EventSpec::AnyOf([ZoneChange{objects:AllOf([SameObject($object_ref), OwnedBy(One(AbilityController))]), from:$return_pair_origin, to:Hand}, ZoneChange{objects:AllOf([Not(SameObject($object_ref)), $filter_phrase, OwnedBy(One(AbilityController))]), from:$return_pair_origin, to:Hand}]) */
event_referenced_or_another_returned_owned ::= object_ref "or" "another" filter_phrase "is" "returned" "to" "your" "hand" "from" return_pair_origin

return_pair_origin ::= return_pair_battlefield | return_pair_graveyard

/* @sem Zone::Battlefield */
return_pair_battlefield ::= "the" "battlefield"

/* @sem Zone::Graveyard */
return_pair_graveyard ::= "the" "graveyard"

/* The event amount is the number of targets of the cast spell. */
/* @sem EventSpec::SpellTargeting{players:One(AbilityController), spells:Any, count:[GreaterOrEqual, $value]} */
cast_spell_target_threshold ::= "whenever" "you" "cast" "a" "spell" "with" value "or" "more" "targets"

/* The event-scoped body may refer to that target count. */
/* @sem Ability::Triggered{event:$cast_spell_target_threshold, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$target_count_instructions}} */
triggered_spell_target_count ::= cast_spell_target_threshold "," target_count_instructions "."

/* The normalized entry event keeps the same controlled subject as the leave event. */
/* @sem EventSpec::@either_event(EventSpec::Player{event:EntersUnderControl, players:All, objects:$controlled_entrant}, EventSpec::Object{event:LeavesBattlefield, objects:$controlled_entrant}) */
event_controlled_enters_or_leaves ::= controlled_entrant "enters" "or" "leaves" "the" "battlefield"

entry_or_leave_subject ::= entry_or_leave_reference | controlled_entrant

/* @sem ObjectFilter::SameObject($object_ref) */
entry_or_leave_reference ::= object_ref

entry_or_unlock_filter ::= event_filter | referenced_or_another_controlled

/* The exclusion refers to the same explicit object, not necessarily the ability holder. */
/* @sem ObjectFilter::AnyOf([SameObject($object_ref), AllOf([Not(SameObject($object_ref)), $controlled_entry_filter])]) */
referenced_or_another_controlled ::= object_ref "or" "another" controlled_entry_filter

/* The ordinal applies to casts matching both the spell filter and its origin. */
/* @sem EventSpec::NthEachTurn{event:Spell{event:Cast, players:One(AbilityController), spells:@and($cast_turn_filter, $cast_turn_origin)}, test:NumberTest::Compare{comparison:Equal, value:$cast_turn_ordinal}} */
event_cast_nth_filtered_from_graveyard ::= "you" "cast" "your" cast_turn_ordinal cast_turn_filter "spell" "from" "your" cast_turn_origin "each" "turn"

cast_turn_ordinal ::= cast_turn_first | ordinal

/* @sem Expr::Constant(1) */
cast_turn_first ::= "first"

cast_turn_filter ::= filter_phrase | spell_instant | spell_sorcery

/* @sem ObjectFilter::Cast{from:Players{zone:Graveyard, players:One(AbilityController)}} */
cast_turn_origin_graveyard ::= "graveyard"

/* @sem ObjectFilter::Cast{from:Players{zone:Library, players:One(AbilityController)}} */
cast_turn_origin_library ::= "library"

cast_turn_origin ::= cast_turn_origin_graveyard | cast_turn_origin_library

/* The attaching object, host filter and craft-card choice retain their own operands. */
/* @sem Ability::AsEvent{object:$object_ref, event:BecomesAttachedTo($attachment_eligible), actions:List([$attachment_choose_craft_card])} */
as_attached_choose_craft_card ::= "as" object_ref "becomes" "attached" "to" attachment_eligible "," attachment_choose_craft_card "."

/* The two event operands retain their own filters and origin zones. */
/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:@and($spell_filter, ObjectFilter::Cast{from:Players{zone:$your_zone, players:One(AbilityController)}})} */
event_you_cast_from_your_zone ::= "you" "cast" spell_filter "from" your_zone

/* @sem EventSpec::Activated{players:One(AbilityController), abilities:AbilityOf(@and($random_card_one, ObjectFilter::InZone(Players{zone:$your_zone, players:One(AbilityController)})))} */
event_activate_card_ability_in_your_zone ::= "activate" "an" "ability" "of" ("a" | "an") random_card_one "in" your_zone

/* @sem EventSpec::@either_event($event_you_cast_from_your_zone, $event_activate_card_ability_in_your_zone) */
event_cast_or_activate_card_ability ::= event_you_cast_from_your_zone "or" event_activate_card_ability_in_your_zone

/* @sem EventSpec::$event_cast_or_activate_card_ability */
whenever_cast_or_activate_card_ability ::= "whenever" event_cast_or_activate_card_ability

/* A holder's departure from its own graveyard establishes the ability zone.
   The movement and the triggered program remain independent operands. */
/* @sem ObjectRef::@self */
graveyard_holder_ref ::= self_card

/* @sem EventSpec::ZoneChange{objects:AllOf([SameObject($graveyard_holder_ref), InZone(Players{zone:Graveyard, players:One(AbilityController)})]), from:Graveyard, to:Hand} */
event_holder_graveyard_to_hand ::= graveyard_holder_ref "is" "put" "into" "your" "hand" "from" "your" "graveyard"

/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$event_holder_graveyard_to_hand, limits:_{}, announcement:@announcement, body:$program})} */
graveyard_holder_movement_trigger ::= "when" event_holder_graveyard_to_hand "," program "."

/* Shared entry wording for triggered phrases that observe another controlled permanent. */
/* @sem EventSpec::Player{event:EntersUnderControl, players:All, objects:$controlled_entrant_another} */
retirement_other_controlled_entry ::= "whenever" controlled_entrant_another "enters"

/* @sem Ability::Triggered{event:$retirement_other_controlled_entry, limits:TriggerLimits{}, announcement:@announcement, body:$retirement_entry_program} */
retirement_entry_trigger ::= retirement_other_controlled_entry "," retirement_entry_program

retirement_entry_program ::= retirement_perpetual_keywords | retirement_choice_payment_counter

/* This sentence describes the fixed set of abilities copied from the entrant. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Source), changes:[GainAbilitiesOf{objects:One(EventSubject), kinds:List([Term{family:CheckHasable, form:Flying}, Term{family:CheckHasable, form:FirstStrike}, Term{family:CheckHasable, form:DoubleStrike}, Term{family:CheckHasable, form:Deathtouch}, Term{family:CheckHasable, form:Haste}, Term{family:CheckHasable, form:AnyHexproof}, Term{family:CheckHasable, form:Indestructible}, Term{family:CheckHasable, form:Lifelink}, Term{family:CheckHasable, form:Menace}, Term{family:CheckHasable, form:Reach}, Term{family:CheckHasable, form:Trample}, Term{family:CheckHasable, form:Vigilance}])}]}}]} */
retirement_perpetual_keywords ::= "this" "creature" "perpetually" "gains" "flying" "if" "that" "creature" "has" "flying" "." "the" "same" "is" "true" "for" "first" "strike" "," "double" "strike" "," "deathtouch" "," "haste" "," "hexproof" "," "indestructible" "," "lifelink" "," "menace" "," "reach" "," "trample" "," "and" "vigilance" "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Choice([Cost{parts:[Mana($mana_symbols)]}, Cost{parts:[Mana($mana_symbols_2)]}, Cost{parts:[Mana($mana_symbols_3)]}])]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($self_explicit_ref)), kind:$counter_kind, amount:$counter_amount}]}}]}, otherwise:Program{}}]} */
retirement_choice_payment_counter ::= "you" "may" "pay" mana_symbols "," mana_symbols "," "or" mana_symbols "." "if" "you" "do" "," "put" counter_amount counter_kind "counter" "on" self_explicit_ref "."

/* @sem Ability::Triggered{event:$retirement_other_controlled_entry, intervening_if:ObjectMatches{object:Source, filter:Name('Awestruck Cygnet')}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Intensify{cards:Name('Awestruck Cygnet'), owner:AbilityController}}]}} */
retirement_entry_intensify ::= retirement_other_controlled_entry "," "if" "this" "creature" "is" "named" SELF_NAME "," "cards" "you" "own" "named" SELF_NAME "intensify" "."

/* The entrant excludes the source and retains the controller at entry. */
/* @sem EventSpec::ZoneChange{objects:@and($event_another, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController))), to:Battlefield} */
historical_you_had_entry ::= "you" "had" event_another "enter" "the" "battlefield" "under" "your" "control"

/* The actor is supplied by the enclosing existential player binding. */
/* @sem EventSpec::Discard{players:One(Bound(0)), cards:Any, kind:Any, grouping:Card} */
bound_discard_event ::= "discarded"

/* The source and the independently filtered other entrant share an origin. */
/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:@and(ObjectFilter::SameObject($object_ref), ObjectFilter::OwnedBy(All)), from:Graveyard, to:Battlefield}, EventSpec::ZoneChange{objects:@and(ObjectFilter::Not(SameObject($object_ref)), $filter_phrase, ObjectFilter::OwnedBy(All)), from:Graveyard, to:Battlefield}) */
event_reference_or_another_enters_from_graveyard ::= object_ref "or" "another" filter_phrase "enters" "from" "a" "graveyard"

/* Face-up events and their optional attachment actions compose independently. */
/* @sem Ability::AsEvent{object:$object_ref, event:TurnsFaceUp, actions:List([$face_up_action])} */
as_turns_face_up ::= "as" object_ref "is" "turned" "face" "up" "," face_up_action "."

/* @sem Operand::Term{family:FaceUpAction, form:MayActions, operands:[$face_up_attach]} */
face_up_action ::= "you" "may" face_up_attach

/* @sem Operand::Term{family:FaceUpAction, form:AttachPermanentToAPermanent, operands:[Object($object_ref), Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase})]} */
face_up_attach ::= "attach" object_ref "to" "a" filter_phrase

/* A cast-or-copy event keeps the same spell filter in both alternatives. */
/* @sem EventSpec::@either_event(EventSpec::Spell{event:Cast, players:One(PlayerRef::AbilityController), spells:$spell_filter}, EventSpec::Spell{event:Copy, players:One(PlayerRef::AbilityController), spells:$spell_filter}) */
event_you_casting_or_copying ::= "you" "casting" "or" "copying" spell_filter

/* @sem Ability::TriggerRule{cause:$event_you_casting_or_copying, abilities:AbilityOf($filter_phrase), rule:TriggersAgain} */
trigger_rule_caused_ability_again ::= "if" event_you_casting_or_copying "causes" "a" "triggered" "ability" "of" "a" filter_phrase "to" "trigger" "," "that" "ability" "triggers" "an" "additional" "time" "."

/* Dying and the population of abilities are independent operands. */
/* @sem EventSpec::ZoneChange{objects:$filter_phrase, from:Battlefield, to:Graveyard} */
retrigger_dying_cause ::= "a" filter_phrase "dying"

/* @sem Ability::TriggerRule{cause:$retrigger_cause, abilities:$retrigger_source_or_emblem, rule:TriggersAgain} */
additional_trigger_source_or_emblem ::= "if" retrigger_cause "causes" "a" "triggered" "ability" "of" retrigger_source_or_emblem "to" "trigger" "," "that" "ability" "triggers" "an" "additional" "time" "."

/* @sem ObjectFilter::AnyOf([AbilityOf(SameObject($object_ref)), AllOf([OnStack(OfEmblem), ControlledBy(One(AbilityController))])]) */
retrigger_source_or_emblem ::= object_ref "or" "an" "emblem" "you" "own"

/* A repeated whenever joins independently batched event occurrences. */
/* @sem EventSpec::@either_event($event_phase_batch, $event_exile_batch) */
event_batch_pair ::= event_phase_batch "and" "whenever" event_exile_batch

/* The phase subject keeps the explicit permanent-type filter. */
/* @sem EventSpec::Batch{event:Object{event:PhasesOut, objects:$phase_batch_filter}, per:Whole} */
event_phase_batch ::= "one" "or" "more" phase_batch_filter "phase" "out"

phase_batch_filter ::= phase_batch_other | phase_batch_noun

/* @sem @and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $phase_batch_noun) */
phase_batch_other ::= "other" phase_batch_noun

phase_batch_noun ::= phase_batch_permanents | plural_creature | plural_artifact | plural_enchantment | plural_land | plural_planeswalker

/* @sem ObjectFilter::AnyOf([ObjectFilter::CardType(Artifact), ObjectFilter::CardType(Battle), ObjectFilter::CardType(Creature), ObjectFilter::CardType(Enchantment), ObjectFilter::CardType(Land), ObjectFilter::CardType(Planeswalker)]) */
phase_batch_permanents ::= "permanents"

/* A batch of cards arriving in exile, from an unrestricted origin. */
/* @sem EventSpec::Batch{event:ZoneChange{objects:$exile_batch_cards, to:Exile}, per:Whole} */
event_exile_batch ::= "one" "or" "more" exile_batch_cards "are" "put" "into" "exile" "from" "anywhere"

exile_batch_cards ::= exile_batch_other_cards | exile_batch_all_cards

/* @sem ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)) */
exile_batch_other_cards ::= "other" "cards"

/* @sem ObjectFilter::Any */
exile_batch_all_cards ::= "cards"

/* A named source with plural agreement shares the event and subject operands. */
/* @sem EventSpec::Object{event:$named_become_state, objects:$event_named} */
event_named_become_state ::= event_named named_become_state

/* The plural pronoun refers to this named trigger's single event subject. */
/* @sem Ability::Triggered{event:$event_named_become_state, limits:TriggerLimits{}, announcement:@announcement, body:$named_event_counter_body} */
named_event_counter_trigger ::= ("when" | "whenever") event_named_become_state "," named_event_counter_body "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(EventSubject)), kind:$counter_kind, amount:$counter_amount}]}}]} */
named_event_counter_body ::= "put" counter_amount counter_kind named_event_counter_word "on" "them"

/* @sem () */
named_event_counter_singular ::= "counter"

/* @sem () */
named_event_counter_plural ::= "counters"

named_event_counter_word ::= named_event_counter_singular | named_event_counter_plural

named_become_state ::= named_become_tapped | named_become_untapped

/* @sem ObjectEvent::BecomesTapped */
named_become_tapped ::= "become" "tapped"

/* @sem ObjectEvent::BecomesUntapped */
named_become_untapped ::= "become" "untapped"

/* Spell descriptions and their trailing constraints compose independently. */
/* @sem @and($spell_post_base, $spell_post_constraint) */
spell_postqualified ::= spell_post_base spell_post_constraint

spell_post_base ::= spell_any | spell_filtered

spell_post_constraint ::= spell_using_teamwork | spell_with_cascade | spell_with_phyrexian_cost | spell_with_single_target | spell_targeting_self

/* @sem ObjectFilter::State(CostPaid(Teamwork)) */
spell_using_teamwork ::= "using" "teamwork"

/* @sem ObjectFilter::HasKeywordFamily(Cascade) */
spell_with_cascade ::= "with" "cascade"

/* @sem ObjectFilter::State(PhyrexianInCost) */
spell_with_phyrexian_cost ::= "with" "{" "H" "}" "in" "its" "mana" "cost"

/* @sem ObjectFilter::OnStack(SingleTarget) */
spell_with_single_target ::= "with" "a" "single" "target"

/* @sem ObjectFilter::TargetsAny(Objects(One($self_ref))) */
spell_targeting_self ::= "that" "targets" self_ref

/* @sem $spell_color_four */
