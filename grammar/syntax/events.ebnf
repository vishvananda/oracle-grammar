gain_per_life_lost_event ::= "you" "gain" count "life" "for" "each" "1" "life" "you" "lost"

/* Attachment choices retain the source and the host filter as separate operands. */
/* @sem Ability::AsEvent{object:$self_explicit_ref, event:BecomesAttachedTo($attached_choice_host), actions:List([$attach_choose_creature_name, $attach_second_choice])} */
