turn_enchanted_main ::= "the" "beginning" "of" "each" "of" "enchanted" "player's" "main" "phases"

/* Damage predicates compose with the event's source and recipient identity. */
/* @sem Condition::Compare{left:EventAmount, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
damage_event_threshold ::= value "or" "more" "damage"

/* @sem EventSpec::Filtered{event:Damage(_{source_kind:Permanent, sources:$event_singular_subject, recipients:Any, kind:Any, grouping:Source, subject:Source}), condition:$damage_event_threshold} */
event_damage_threshold_source ::= event_singular_subject "deals" damage_event_threshold

/* @sem EventSpec::Filtered{event:Damage(_{source_kind:Permanent, sources:$event_singular_subject, recipients:Players(OpponentsOf(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Source}), condition:$damage_event_threshold} */
event_damage_threshold_opponent ::= event_singular_subject "deals" damage_event_threshold "to" "an" "opponent"

/* @sem EventSpec::Filtered{event:Damage(_{source_kind:Any, sources:Any, recipients:Objects($event_singular_subject), kind:Any, grouping:Recipient, subject:Recipient}), condition:$damage_event_threshold} */
event_damage_threshold_recipient ::= event_singular_subject "is" "dealt" damage_event_threshold

/* @sem EventSpec::Filtered{event:$event_combat_damage, condition:PlayerIsActive(AbilityController)} */
event_damage_during_your_turn ::= event_combat_damage "during" "your" "turn"

/* A combat-damage recipient is filtered independently of the source. */
/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:$event_singular_subject, recipients:Players(Matching{binding:0, condition:Compare{left:CountCounters(_{recipients:Players(One(Bound(0))), kind:$counter_kind, information:CurrentOrLastKnown}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}}), kind:Combat, grouping:SourceRecipient, subject:Source}) */
event_combat_player_without_counter ::= event_singular_subject "deals" "combat" "damage" "to" "a" "player" "who" "doesn't" "have" "a" counter_kind "counter"

/* Simultaneous entry of a named object and/or other controlled permanents. */
/* @sem EventSpec::AnyOf([ZoneChange{objects:SameObject($object_ref), to:Battlefield}, ZoneChange{objects:AllOf([Not(SameObject($object_ref)), $filter_plural, ControlledBy(One(AbilityController))]), to:Battlefield}]) */
event_named_and_other_controlled_enter ::= object_ref "and" "/" "or" "one" "or" "more" "other" filter_plural "you" "control" "enter"

/* A singular object's two passive events share the same subject filter. */
/* @sem EventSpec::AnyOf([Object{event:Sacrificed, objects:$passive_pair_subject}, Object{event:Destroyed, objects:$passive_pair_subject}]) */
event_passive_object_pair ::= passive_pair_subject "is" "sacrificed" "or" "destroyed"

passive_pair_subject ::= passive_pair_a | passive_pair_an

/* @sem $filter_phrase */
passive_pair_a ::= "a" filter_phrase

/* @sem $filter_phrase */
passive_pair_an ::= "an" filter_phrase

/* @sem EventSpec::Player{event:EntersUnderControl, players:OpponentsOf(PlayerRef::AbilityController), objects:$filter_plain} */
event_enters_under_opponent_plain_original ::= ("a" | "an") filter_plain "an" "opponent" "controls" "enters"

/* A controller and a linked-name qualification are independent entry operands. */
/* @sem EventSpec::Player{event:EntersUnderControl, players:$entry_named_controller, objects:@and($filter_phrase, $linked_name_filter)} */
event_qualified_controlled_entry ::= "a" filter_phrase entry_named_controller linked_name_filter "enters"

/* @sem PlayerSet::OpponentsOf(PlayerRef::AbilityController) */
entry_named_controller ::= "an" "opponent" "controls"

/* The controlled-object reading retains the same independent phrase operands. */
/* @sem EventSpec::Player{event:EntersUnderControl, players:All, objects:AllOf([$filter_phrase, $linked_name_filter, ControlledBy($entry_named_controller)])} */
event_qualified_controlled_entry_filter ::= "a" filter_phrase entry_named_controller linked_name_filter "enters"

/* A source and a second described permanent share the damage event's kind and recipient. */
/* @sem EventSpec::AnyOf([Damage(_{source_kind:Permanent, sources:SameObject($self_explicit_ref), recipients:$damage_pair_recipient, kind:$prevent_damage, grouping:SourceRecipient, subject:Source}), Damage(_{source_kind:Permanent, sources:$damage_pair_other, recipients:$damage_pair_recipient, kind:$prevent_damage, grouping:SourceRecipient, subject:Source})]) */
event_damage_source_pair ::= self_explicit_ref "or" damage_pair_other "deals" prevent_damage "to" damage_pair_recipient

damage_pair_other ::= damage_pair_attached | damage_pair_another

/* @sem ObjectFilter::SameObject($enchanted_creature_ref) */
damage_pair_attached ::= enchanted_creature_ref

/* @sem ObjectFilter::AllOf([Not(SameObject(ObjectRef::Source)), $filter_phrase]) */
damage_pair_another ::= "another" filter_phrase

damage_pair_recipient ::= damage_to_player | damage_to

/* Both paired recipients are separate occurrences, with the same damage kind. */
/* @sem EventSpec::AnyOf([Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject($object_ref)), kind:$prevent_damage, grouping:Recipient, subject:Recipient}), Damage(_{source_kind:Any, sources:Any, recipients:Objects(AllOf([PairedWith(SameObject($object_ref)), $filter_phrase])), kind:$prevent_damage, grouping:Recipient, subject:Recipient})]) */
event_damage_paired_recipients ::= object_ref "or" "a" filter_phrase "it's" "paired" "with" "is" "dealt" prevent_damage

/* The controller and a described permanent receive independent occurrences. */
/* @sem EventSpec::AnyOf([Damage(_{source_kind:Any, sources:Any, recipients:Players(One(AbilityController)), kind:$prevent_damage, grouping:Recipient, subject:Recipient}), Damage(_{source_kind:Any, sources:Any, recipients:Objects($filter_phrase), kind:$prevent_damage, grouping:Recipient, subject:Recipient})]) */
event_damage_you_or_object ::= prevent_damage "is" "dealt" "to" "you" "or" "a" filter_phrase

/* A different permanent dies after damage from a permanent controlled by the ability controller. */
/* @sem EventSpec::ZoneChange{objects:AllOf([Not(SameObject(Source)), AllOf([$filter_phrase, Condition(Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:AllOf([$filter_phrase_2, ControlledBy(One(AbilityController))]), recipients:Objects(SameObject(Candidate)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})])]), from:Battlefield, to:Graveyard} */
event_other_damaged_by_controlled_dies ::= "another" filter_phrase "dealt" "damage" "this" "turn" "by" "a" filter_phrase "you" "controlled" "dies"

/* A coordinated list keeps each action as a separate event of the same player. */
/* @sem EventSpec::AnyOf(@unordered([$controller_research_action, ...$controller_research_tail])) */
event_controller_research_list ::= "you" controller_research_action controller_research_tail

controller_research_tail ::= controller_research_final | controller_research_more

/* @sem EventSpec::[$controller_research_action] */
controller_research_final ::= ","? "or" controller_research_action

/* @sem EventSpec::[$controller_research_action, ...$controller_research_tail] */
controller_research_more ::= "," controller_research_action controller_research_tail

controller_research_action ::= controller_discovers | controller_investigates | controller_scries | controller_surveils | controller_seeks_cards

/* @sem EventSpec::Player{event:Discovers, players:One(AbilityController)} */
controller_discovers ::= "discover"

/* @sem EventSpec::Player{event:Investigates, players:One(AbilityController)} */
controller_investigates ::= "investigate"

/* @sem EventSpec::Player{event:Scries, players:One(AbilityController)} */
controller_scries ::= "scry"

/* @sem EventSpec::Player{event:Surveils, players:One(AbilityController)} */
controller_surveils ::= "surveil"

/* @sem EventSpec::Player{event:Seeks, players:One(AbilityController)} */
controller_seeks_cards ::= "seek" "one" "or" "more" "cards"

/* A fixed-width list provides a direct inverse for five coordinated actions. */
/* @prefer always */
/* @sem EventSpec::AnyOf([$controller_discovers, $controller_investigates, $controller_scries, $controller_surveils, $controller_seeks_cards]) */
event_controller_research_five ::= "you" controller_discovers "," controller_investigates "," controller_scries "," controller_surveils "," "or" controller_seeks_cards

/* @sem ObjectFilter::AnyOf([$adjective_attacking, $adjective_blocking]) */
combat_attacking_or_blocking ::= adjective_attacking "or" adjective_blocking

/* @sem EventSpec::ZoneChange{objects:@and($adjective_goaded, $combat_attacking_or_blocking, $filter_phrase), from:Battlefield, to:Graveyard} */
event_goaded_combat_dies ::= "a" adjective_goaded combat_attacking_or_blocking filter_phrase "dies"

/* @sem EventSpec::Object{event:Crewed, objects:$event_object} */
event_becomes_crewed ::= event_object "becomes" "crewed"

/* A combat-damage recipient supplies the antecedent for these independent
   postconditions. Each sentence tests its own condition at resolution. */
/* @sem Instruction::If{condition:$damaged_player_comparison, then:Program{instructions:$clause_imperative}, otherwise:Program{}} */
damaged_player_conditional_imperative ::= clause_imperative "if" damaged_player_comparison

/* @sem Instruction::If{condition:$damaged_player_comparison, then:Program{instructions:$clause_you}, otherwise:Program{}} */
damaged_player_conditional_you ::= clause_you "if" damaged_player_comparison

/* @sem Ability::Triggered{event:$event_combat_damage_player, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[@resolution($damaged_player_conditional_imperative), $damaged_player_conditional_you, $damaged_player_conditional_you_2]}} */
triggered_damage_player_conditional_three ::= "whenever" event_combat_damage_player "," damaged_player_conditional_imperative "." "then" damaged_player_conditional_you "." "then" damaged_player_conditional_you "."

/* The paired combat events share a scoped event-subject redirect program. */
/* @sem Ability::[Triggered{event:AnyOf([Object{event:Attacks, objects:$event_object}, Object{event:Blocks, objects:$event_object}]), limits:TriggerLimits{}, announcement:@announcement, body:$coin_event_subject_redirect}] */
line_combat_coin_redirect ::= "whenever" event_object "attacks" "or" "blocks" "," coin_event_subject_redirect "."

/* Third-person cast qualifiers bind their anaphor to the event's actor. */
