event_enters_or_object_transition ::= event_singular_subject "enters" "or" event_object_transition

event_object_transition ::= event_transition_tapped | event_transition_untapped

/* @sem ObjectEvent::BecomesTapped */
event_transition_tapped ::= "becomes" "tapped"

/* @sem ObjectEvent::BecomesUntapped */
event_transition_untapped ::= "becomes" "untapped"

/* Independent event subjects retain their own filters in the disjunction. */
