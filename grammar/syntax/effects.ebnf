   branches and target identities remain tied to their announcements. */
/* @sem Vec<Instruction>::@unlabelled_instructions($instead_graveyard_pair_hand_paragraph) */
instead_graveyard_pair_hand ::= instead_graveyard_pair_hand_paragraph

/* @sem Ability::@optional_ability_label(Spell{announcement:@announcement, body:Program{instructions:[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:Move{objects:Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:AnyOf([SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($pair_graveyard_card, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0}), SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(Target{slot:0, index:0})), $pair_graveyard_card_2, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0})])}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:One(Source), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:0, index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Targets(1), destination:$pair_library_destination, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:One(Source), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}]}}, $spell_paragraph_break) */
instead_graveyard_pair_hand_paragraph ::= "return" "target" pair_graveyard_card "from" "your" "graveyard" "to" "your" "hand" "." "put" "up" "to" "one" "other" "target" pair_graveyard_card "from" "your" "graveyard" pair_library_destination "." "exile" SELF_NAME "." spell_paragraph_break "if" condition "," "instead" "return" "those" "cards" "to" "your" "hand" "and" "exile" SELF_NAME

pair_graveyard_card ::= hand_one_any | exiled_card_test

pair_library_destination ::= self_put_top | top_reveal_bottom

/* A named player can choose to pay a sacrifice cost during resolution. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$player_ref, cost:$resolving_sacrifice_choice_cost, optional:true}}] */
clause_player_optional_sacrifice_choice ::= player_ref "may" resolving_sacrifice_choice_cost "of" "their" "choice"

/* A named player's optional choice can prevent a separately stated action. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$player_ref, cost:$third_discard_or_sacrifice_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:$operation}]}, otherwise:Program{}}] */
clause_unless_discard_or_sacrifice ::= operation "unless" player_ref third_discard_or_sacrifice_cost

/* @sem Cost::Cost{parts:[Choice([$third_discard_cost, $third_sacrifice_choice_cost])]} */
third_discard_or_sacrifice_cost ::= third_discard_cost "or" third_sacrifice_choice_cost "of" "their" "choice"

/* @sem Cost::Cost{parts:[Discard{count:$card_count, filter:Any}]} */
third_discard_cost ::= "discards" card_count

/* Repeat the complete preceding instruction sequence once. */
/* @sem Instruction::[RepeatableWithLimit{amount:Constant(2), body:Program{instructions:[...$repeat_once_body, Effect{result:@next, operation:RepeatProcess}]}}] */
instructions_repeat_once_shared ::= repeat_once_body "." "repeat" "this" "process" "once"

repeat_once_body ::= clause_unless_discard_or_sacrifice

random_copy_count ::= exiled_threshold_words | value

/* The opponent's target establishes the controller and the power source. */
/* opponent_controlled_damage_source is shared as goad_opponent_target. */

/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(SameObject(Target{slot:0, index:0})), $noun, ControlledBy(One(ControllerOf(Target{slot:0, index:0})))])}), index:0}) */
another_target_same_controller ::= "another" "target" noun "that" "player" "controls"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Target{slot:0, index:0})), CardType(Creature), ControlledBy(One(ControllerOf(Target{slot:0, index:0})))])} */
each_other_same_controller ::= "each" "other" "creature" "that" "player" "controls"

/* @sem Operation::DealDamage{source:$goad_opponent_target, recipients:Objects($another_target_same_controller), amount:ObjectProperty{object:Target{slot:0, index:0}, property:Power, information:CurrentOrLastKnown}, preventable:true} */
opponent_target_power_damage ::= goad_opponent_target "deals" "damage" "equal" "to" "its" "power" "to" another_target_same_controller

/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$fight_excess_opponent_target, recipients:Objects($each_other_same_controller), amount:ObjectProperty{object:Target{slot:0, index:0}, property:Power, information:CurrentOrLastKnown}, preventable:true}}, Effect{result:@next, operation:DealDamageFromEach{sources:$each_other_same_controller, recipients:Objects(One(Target{slot:0, index:0})), amount:ObjectProperty{object:Affected, property:Power, information:CurrentOrLastKnown}}}] */
opponent_population_mutual_damage ::= fight_excess_opponent_target "deals" "damage" "equal" "to" "its" "power" "to" each_other_same_controller "," "then" "each" "of" "those" "creatures" "deals" "damage" "equal" "to" "its" "power" "to" "that" "creature"

/* The condition tests the before receipt of this exact single-target destruction. */
/* @sem Instruction::[Effect{result:@mark, operation:Destroy{objects:One($target_object), regeneration:true}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:Before, index:0}, filter:$destroyed_receipt_filter}, then:Program{instructions:$clause}, otherwise:Program{}}] */
instructions_destroy_receipt_condition ::= "destroy" target_object "." NEWLINE? "if" destroyed_receipt_filter "was" "destroyed" "this" "way" "," clause

destroyed_receipt_filter ::= destroyed_receipt_an | destroyed_receipt_controlled_or

/* @sem $filter_phrase */
destroyed_receipt_an ::= "an" filter_phrase

/* @sem ObjectFilter::AnyOf([AllOf([Any, ControlledBy(One(AbilityController))]), $filter_phrase]) */
destroyed_receipt_controlled_or ::= "a" "permanent" "you" "controlled" "or" "a" filter_phrase

/* Fractional actions share the trailing rounding sentence but retain each action. */
/* @sem Expr::Divide{numerator:ObjectProperty{object:EventSubject, property:SpellX, information:CurrentOrLastKnown}, denominator:Constant(2), rounding:Down} */
fraction_x_down ::= "half" "X"

/* @sem Operation::GainLife{players:One(AbilityController), amount:$fraction_x_down} */
fraction_x_gain ::= "gain" fraction_x_down "life"

/* @sem Operation::Draw{players:One(AbilityController), amount:$fraction_x_down} */
fraction_x_draw ::= "draw" fraction_x_down "cards"

fraction_x_action ::= fraction_x_gain | fraction_x_draw

/* @sem Instruction::[Effect{result:@next, operation:$fraction_x_action}, ...$fraction_x_actions] */
fraction_x_actions_more ::= fraction_x_action "and" fraction_x_actions

/* @sem Instruction::[Effect{result:@next, operation:$fraction_x_action}] */
fraction_x_actions_one ::= fraction_x_action

fraction_x_actions ::= fraction_x_actions_more | fraction_x_actions_one

/* @sem Instruction::[...$fraction_x_actions] */
instructions_fractional_x_sequence ::= "you" fraction_x_actions "." "round" "down" "each" "time"

/* X is the source spell's announced value in its own cast trigger. */
/* @sem Ability::Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:Spell{event:Cast, players:One(AbilityController), spells:SameObject(Source)}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$instructions_fractional_x_sequence}})} */
triggered_own_cast_fractional_actions ::= "when" "you" "cast" "this" "spell" "," instructions_fractional_x_sequence "."

/* The condition tests the result of this exact destroy operation. */
/* @sem Instruction::[Effect{result:@mark, operation:Destroy{objects:One($target_object), regeneration:true}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:Before, index:0}, filter:$filter_phrase}, then:Program{instructions:$clause}, otherwise:Program{}}] */
instructions_destroyed_receipt_if ::= "destroy" target_object "." NEWLINE? "if" "that" filter_phrase "is" "destroyed" "this" "way" "," clause

/* One action or one of three indefinite abilities for the referred object. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[Program{instructions:[Effect{result:@next, operation:$operation}]}, Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[GrantAbility(Mechanic{mechanic:Banding})], duration:Indefinite, evaluation:Snapshot}}]}, Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[GrantKeyword($keyword_value)], duration:Indefinite, evaluation:Snapshot}}]}, Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[GrantKeyword($keyword_value_2)], duration:Indefinite, evaluation:Snapshot}}]}]}] */
choice_operation_or_indefinite_abilities ::= operation "or" affected "gains" "banding" "," keyword_value "," "or" keyword_value

/* Optional untapping and its payment-dependent consequence share one scoped program. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[ChangeTapState{selections:[_{objects:$affected}]}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:$program, otherwise:Program{}}] */
instructions_optional_untap_followup ::= "you" "may" "untap" affected "." "if" "you" "do" "," program

/* A chosen singular permanent and its following action share the choice receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$player_ref, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($choice_permanent_head, $choice_permanent_repeat), $modifiers])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:$chosen_permanent_action}] */
chosen_creature_sequence ::= player_ref "chooses" "a" choice_permanent_head modifiers "." NEWLINE? chosen_permanent_action "that" choice_permanent_repeat

chosen_permanent_action ::= destroy_chosen_permanent | exile_chosen_permanent

/* @sem Operation::Destroy{objects:One(Result{result:@prior, phase:After, index:0}), regeneration:true} */
destroy_chosen_permanent ::= "destroy"

/* @sem Operation::Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_chosen_permanent ::= "exile"

/* @sem ObjectFilter::$choice_permanent_kind */
choice_permanent_head ::= choice_permanent_kind

/* @sem ObjectFilter::$choice_permanent_kind */
choice_permanent_repeat ::= choice_permanent_kind

choice_permanent_kind ::= noun_creature | noun_land

/* The prior target retains its other types while the named counter remains. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@last_slot, index:0})), changes:[AddLandType($counter_followup_land_type)], duration:WhileMatches{object:Affected, filter:Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})}, evaluation:Snapshot} */
counter_land_type_followup ::= "that" "land" "is" counter_followup_land_type "in" "addition" "to" "its" "other" "types" "for" "as" "long" "as" "it" "has" "a" counter_kind "counter" "on" "it"

counter_followup_land_type ::= counter_followup_island | counter_followup_forest | counter_followup_swamp | counter_followup_mountain | counter_followup_plains

/* @sem LandType::Island */
counter_followup_island ::= "an" "Island"

/* @sem LandType::Forest */
counter_followup_forest ::= "a" "Forest"

/* @sem LandType::Swamp */
counter_followup_swamp ::= "a" "Swamp"

/* @sem LandType::Mountain */
counter_followup_mountain ::= "a" "Mountain"

/* @sem LandType::Plains */
counter_followup_plains ::= "a" "Plains"

/* The owner shuffles the referenced permanent into their own library. */
/* @sem Operation::Move{objects:One($object_ref), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{}}, qualifiers:[]} */
owner_shuffles_referenced_permanent ::= "the" "owner" "of" object_ref "shuffles" "it" "into" "their" "library"

/* Third-person discovery retains its subject and amount. */
/* @sem Operation::Keyword{actor:@subject, action:KeywordAction::Discover{amount:$value}} */
discover_third ::= "discovers" value

/* This sequence proves that the player and object in the follow-up are the
   owner and original target named by the immediately preceding shuffle. */
/* @sem Vec<Instruction>::@then_sequence($owner_target_shuffle_clause, $owner_target_discover_clause) */
owner_shuffle_then_discover ::= owner_target_shuffle_clause "." "then" owner_target_discover_clause

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_object), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{}}, qualifiers:[]}}] */
owner_target_shuffle_clause ::= "the" "owner" "of" target_object "shuffles" "it" "into" "their" "library"

/* The follow-up can use the shared third-person keyword action with its
   defined amount. The enclosing sequence proves the target-owner antecedent. */
/* @sem Instruction::[Effect{result:@next, operation:@where(@apply(PlayerSet::One(PlayerRef::OwnerOf(Target{slot:@last_slot, index:0})), $discover_x_third), $owner_target_property)}] */
owner_target_discover_clause ::= "that" "player" discover_x_third "," "where" "X" "is" owner_target_property

/* @sem Operation::Keyword{actor:@subject, action:KeywordAction::Discover{amount:AnnouncedX}} */
discover_x_third ::= "discovers" "X"

/* @sem Expr::ObjectProperty{object:Target{slot:@last_slot, index:0}, property:ManaValue, information:CurrentOrLastKnown} */
owner_target_property ::= "its" "mana" "value"

/* A live population defines the number of unspecified counters removed. */
/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), amount:Count(Exactly($controlled_population_definition))}]} */
remove_defined_population_counters ::= "remove" "X" "counters" "from" affected "," "where" "X" "is" controlled_population_definition

/* The draw is performed by the owner of the target named in the shuffle. */
/* @sem Vec<Instruction>::@then_sequence($owner_target_shuffle_clause, $owner_target_draw_clause) */
owner_shuffle_then_draw ::= owner_target_shuffle_clause "," "then" owner_target_draw_clause

/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(OwnerOf(Target{slot:@last_slot, index:0})), amount:$card_count}}] */
owner_target_draw_clause ::= "draws" card_count

/* The historical source is the same source that deals this damage. */
/* @sem Operation::DealDamage{source:@self, recipients:$previously_damaged_opponent_and_permanent, amount:$number, preventable:true} */
source_damage_previously_damaged ::= "this" "creature" "deals" number "damage" "to" previously_damaged_opponent_and_permanent

/* The entry predicate and replacement program retain their own operands. */
/* @sem Operation::CreateReplacement{event:$opponent_controlled_entry_event, limit:UntilExpired, duration:$this_duration, body:$entry_under_your_control_program} */
timed_entry_control_replacement ::= "if" opponent_controlled_entry_event this_duration "," entry_under_your_control_program "instead"

/* @sem ReplacementEvent::Enter{objects:AllOf([$filter_phrase, ControlledBy(OpponentsOf(AbilityController))])} */
opponent_controlled_entry_event ::= "a" filter_phrase "would" "enter" "the" "battlefield" "under" "an" "opponent's" "control"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetController(AbilityController)}}]} */
entry_under_your_control_program ::= "it" "enters" "under" "your" "control"

/* The expressed subject governs all three successive actions. */
/* @sem Instruction::[$verb_base, $verb_base_2, $verb_base_3] */
verbs_base_serial_then ::= verb_base "," verb_base "," "then" verb_base

/* A player loop scopes the bound payer in the receipt-aware body. */
