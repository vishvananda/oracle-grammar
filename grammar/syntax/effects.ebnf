spell_controller_copies_target ::= "the" "controller" "of" retarget_instant_sorcery "copies" "it" "." "that" "player" "may" "choose" "new" "targets" "for" "the" "copy"

/* Each opponent supplies at most one controlled target; one shared value determines each placement. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:OpponentsOf(AbilityController), each:UpTo(Constant(1))}, filter:CardType(Creature)}))), kind:$counter_kind, amount:$value}]} */
opponent_target_defined_counters ::= "for" "each" "opponent" "," "put" "X" counter_kind "counters" "on" "up" "to" "one" "target" "creature" "that" "player" "controls" "," "where" "X" "is" value

/* Each selected permanent supplies its own copy; the exception applies to each copy. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyEach{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, exceptions:$copy_exceptions_plain}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_copy_each_except ::= "for" "each" filter_phrase "," "create" "a" "token" "that's" "a" "copy" "of" "that" "creature" "," "except" copy_exceptions_plain

/* The source and the described other object receive the same perpetual change. */
/* @sem Operation::CreatePerpetualEffect{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf(@unordered([SameObject($self_explicit_ref), SameObject($that_noun)]))}, changes:[Pump{power:$signed, toughness:$signed_2}]} */
