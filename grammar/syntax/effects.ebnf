draft_one_source ::= "draft" "a" "card" "from" self_named "'s" "spellbook"

/* A bound player chooses the complete personal discard-and-draw program. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Discard{players:One(Bound(0)), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any})}}, Effect{result:@next, operation:Draw{players:One(Bound(0)), amount:$card_count}}]} */
bound_hand_draw ::= "discard" "their" "hand" "and" "draw" card_count

/* @sem Instruction::[ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:$bound_hand_draw}]}}] */
clause_plural_may_hand_draw ::= hand_plural_players "may" bound_hand_draw

/* Both arms retain their own named player, draw and discard operands. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:$player_draw_discard_pair_2}, otherwise:Program{instructions:$player_draw_discard_pair}}] */
instead_leading_draw_discard ::= player_draw_discard_pair "." "if" condition "," "instead" player_draw_discard_pair

/* @sem @apply($players_singular, $draw_discard_pair_verbs) */
player_draw_discard_pair ::= players_singular draw_discard_pair_verbs

/* @sem Instruction::[Effect{result:@next, operation:$draw_third}, Effect{result:@next, operation:$discard_third}] */
draw_discard_pair_verbs ::= draw_third "," "then" discard_third

/* "Another" is licensed only within a sequence after a random discard. */
/* @sem Instruction::[Effect{result:@next, operation:@apply($players_singular, $discard_random_third)}, ...$random_extra_unless_paid] */
instructions_random_discard_extra ::= players_singular discard_random_third "." "then" random_extra_unless_paid

/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$player_ref, cost:$resolving_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Discard{players:One($player_ref), amount:Constant(1), random:true}}]}, otherwise:Program{}}] */
random_extra_unless_paid ::= player_ref "discards" "another" "card" "at" "random" "unless" "they" "pay" resolving_cost

/* Sequential instructions retain the conditional branch and its selection. */
/* @sem Instruction::[Effect{result:@next, operation:$operation}, If{condition:$condition_was_cast_from_exile, then:_{instructions:$choose_each_player_then_destroy}, otherwise:_{}}] */
operation_cast_origin_choice ::= operation "." "if" condition_was_cast_from_exile "," choose_each_player_then_destroy

/* @sem Instruction::[Effect{result:@next, operation:$operation}, ...$linked_extra_counter_entry] */
operation_linked_counter_entry ::= operation "," "then" linked_extra_counter_entry

/* The past control test refers to the attempted target, even if destruction
   did not produce a transition. The following clause keeps its own operands. */
/* @sem Instruction::[Effect{result:@mark, operation:Destroy{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:CardType(Artifact)}), index:0}), regeneration:true}}, If{condition:ObjectMatches{object:Target{slot:@last_slot, index:0}, filter:ControlledBy(One(AbilityController))}, then:Program{instructions:$clause}, otherwise:Program{}}] */
clause_destroy_controlled_artifact ::= "destroy" "target" "artifact" "." NEWLINE? "if" "you" "controlled" "that" "artifact" "," clause

/* A condition may replace damage to a creature with destroying that same
   announced target. The source, damage amount and condition stay independent. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:CardType(Creature)}), index:0}), regeneration:true}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:Objects(One(Target{slot:@last_slot, index:0})), amount:$number, preventable:true}}]}}] */
instructions_damage_creature_destroy_instead ::= damage_source_ref "deals" number "damage" "to" "target" "creature" "." NEWLINE? "if" condition "," "destroy" "the" "creature" "instead"

/* Each source deals the specified damage to its own controller. */
/* @sem Operation::DealDamageFromEach{sources:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$noun}, recipients:Players(One(ControllerOf(Affected))), amount:$number} */
each_permanent_damage_controller ::= "each" noun "deals" number "damage" "to" "its" "controller"

/* The returned card is bounded by the last known mana value of the event subject. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}}])}, count:AsManyAsCan($counter_a)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
graveyard_return_less_died ::= "return" counter_a filter_phrase "card" "with" "lesser" "mana" "value" "than" "the" "creature" "that" "died" "from" "your" "graveyard" "to" "your" "hand"

/* The discard and receipt consumer share one scope, including in the inverse. */
/* @sem Instruction::[Effect{result:@next, operation:Discard{players:One(AbilityController), amount:$card_count, random:false}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}, count:AsManyAsCan(CountObjects(Transition{result:@prior, phase:Before}))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
discard_return_per_card ::= "discard" card_count "," "then" "return" "a" "card" "from" "your" "graveyard" "to" "your" "hand" "for" "each" "card" "discarded" "this" "way"

/* A controlled target can be the damage dealer in multiple constructions. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ControlledBy(One(AbilityController))])}), index:0} */
controlled_damage_source ::= "target" noun "you" "control"

/* @sem Operation::DealDamage{source:$controlled_damage_source, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Not(SameObject(Target{slot:0, index:0}))})), amount:ObjectProperty{object:Target{slot:0, index:0}, property:Power, information:CurrentOrLastKnown}, preventable:true} */
controlled_target_power_damage ::= controlled_damage_source "deals" "damage" "equal" "to" "its" "power" "to" "any" "other" "target"

/* @sem Operation::DealDamage{source:$controlled_damage_source, recipients:Union([Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any, constraints:[DifferentFromTarget(0)]})), Objects(One(Target{slot:0, index:0}))]), amount:ObjectProperty{object:Target{slot:0, index:0}, property:Power, information:CurrentOrLastKnown}, preventable:true} */
controlled_target_self_power_damage ::= controlled_damage_source "deals" "X" "damage" "to" "any" "other" "target" "and" "X" "damage" "to" "itself" "," "where" "X" "is" "its" "power"

/* The sacrifice refers to the dealer, not the later damage target. */
/* @sem Instruction::[Effect{result:@next, operation:$controlled_target_power_damage}, Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:One(Target{slot:0, index:0})}}] */
controlled_damage_then_sacrifice ::= controlled_target_power_damage "." "then" "sacrifice" "it"

/* The announced target and comparison compose with both resolution branches. */
/* @sem Instruction::[If{condition:$chosen_card_property_condition, then:$program, otherwise:$program_2}] */
instructions_chosen_card_conditional ::= chosen_card_property_condition "," program "." "otherwise" "," program

/* @sem Instruction::[Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instead_seek_single ::= "seek" "a" card_filter "card"

/* The defining clause supplies the same announced quantity to the target
   bound and the distribution, while the two populations stay independent. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo($distribution_graveyard_count), filter:$filter_plural, distribute:$distribution_graveyard_count}))), kind:$counter_kind, amount:DistributedShare(@share)}]} */
distribute_counters_graveyard_count ::= "distribute" "X" counter_kind "counters" "among" "any" "number" "of" "target" filter_plural "," distribution_graveyard_count

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$card_filter}) */
distribution_graveyard_count ::= "where" "X" "is" "the" "number" "of" card_filter "cards" "in" "your" "graveyard" "as" "you" "cast" "this" "spell"

/* The announced player identifies both the controlled pool and its counted half. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One($target_player))])}, count:AsManyAsCan(Divide{numerator:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Target{slot:@last_slot, index:0}))])}), denominator:Constant(2), rounding:$rounding_words})}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_chosen_player_half_return ::= "choose" target_player "." "return" "half" "the" filter_plural "they" "control" "to" "their" "owner's" "hand" "," rounding_words

/* The player loop supplies the actor to the reusable sacrifice operation. */
/* @sem Instruction::[ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_sacrifice_except}]}}] */
instructions_each_keep_controlled ::= hand_plural_players bound_sacrifice_except

/* @sem Operation::SacrificeAllBut{players:One(Bound(0)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, keep:$value} */
bound_sacrifice_except ::= "sacrifices" "all" filter_plural "they" "control" "except" "for" value

/* @sem Instruction::[ForEachPlayer{players:$players_control_threshold_more, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_choose_keep}]}}] */
instructions_threshold_keep_controlled ::= players_control_threshold_more bound_choose_keep

/* @sem Operation::SacrificeAllBut{players:One(Bound(0)), objects:$affected, keep:$value} */
bound_choose_keep ::= "chooses" value affected "they" "control" "and" "sacrifices" "the" "rest"

/* Conditional replacement damage to the same announced group.  The first
   clause introduces the target group; the anaphor retains that exact slot. */
/* @sem Vec<Instruction>::@unlabelled_instructions($instructions_damage_instead_group_paragraph) */
instructions_damage_instead_group ::= instructions_damage_instead_group_paragraph

/* @sem Ability::@optional_ability_label(Spell{announcement:@announcement, body:Program{instructions:[@repeated_damage_actor(Instruction::If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref_2, recipients:$recipients_each_of_targets, amount:$number_2, preventable:true}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:Targets(@last_slot), amount:$number, preventable:true}}]}})]}}, $spell_paragraph_join) */
instructions_damage_instead_group_paragraph ::= damage_source_ref "deals" number "damage" "to" recipients_each_of_targets "." spell_paragraph_join damage_source_ref "deals" number "damage" "to" "each" "of" "those" "permanents" "and" "/" "or" "players" "instead" "if" condition

/* Additional combat phases begin after the current main phase. */
/* @sem Operation::AddPhases{actor:One(AbilityController), phases:Combat, count:$number} */
additional_combat_phases ::= "after" "this" "main" "phase" "," "there" "are" number "additional" "combat" "phases"

/* The temporary trigger owns its nested instruction and the written turn event. */
/* @sem Operation::CreateTrigger{event:$turn_event, duration:$this_duration, announcement:@announcement, body:Program{instructions:$clause_operation}} */
temporary_turn_event_trigger ::= "at" turn_event this_duration "," clause_operation

/* Each player's own hand is evaluated independently before later phases. */
/* @sem Instruction::[ForEachPlayer{players:$players_each, binding:0, body:Program{instructions:[Effect{result:@next, operation:Discard{players:One(Bound(0)), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any})}}]}}] */
each_player_discard_hand ::= players_each "discards" hand_words

/* The omitted subject is each player, and each chooses from their own graveyard. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:$each_player_return_cards}, count:UpTo($count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
each_player_return_own_graveyard_tail ::= "returns" "up" "to" count each_player_return_cards "from" "their" "graveyard" "to" "their" "hand"

/* @sem Instruction::[...$each_player_discard_hand, ...$each_player_return_own_graveyard_tail] */
instructions_each_player_discard_return ::= each_player_discard_hand "," "then" each_player_return_own_graveyard_tail

each_player_return_cards ::= random_any_cards | search_filter_many

/* A resolution choice combines independently meaningful instruction branches. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[Program{instructions:$resolution_choice_branch}, Program{instructions:$resolution_choice_branch_2}]}] */
clause_resolution_branch_choice ::= resolution_choice_branch "or" resolution_choice_branch

resolution_choice_branch ::= graveyard_return_required | unlock_selected_locked_door | resolution_turn_face_up | resolution_put_one_counter

/* Select the permanent at resolution; the actor and chooser are the controller. */
/* @sem Instruction::[Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, chooser:Players(One(AbilityController)), count:Exactly(Constant(1))}], action:KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::UnlockDoor, objects:Prepared(@selection_id(0))}}}] */
unlock_selected_locked_door ::= "unlock" "a" "locked" "door" "of" "a" filter_phrase

/* The event player chooses a sacrifice payment before taking damage. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:EventSubject, cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$noun}, choose:Exactly(Constant(1))}]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:Players(One(EventSubject)), amount:$number, preventable:true}}]}, otherwise:Program{}}] */
clause_event_player_damage_unless_sacrifice ::= damage_source_ref "deals" number "damage" "to" "that" "player" "unless" "they" "sacrifice" "a" noun "of" "their" "choice"

/* Phasing can be replaced by a separately expressed movement instruction. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:$instead_moves_action}, otherwise:Program{instructions:[Effect{result:@next, operation:$object_phases_out}]}}] */
instead_phase_move ::= object_phases_out "." NEWLINE? "if" condition "," instead_moves_action "instead"

/* The counter designation and destination remain independent operands. */
/* @sem Operation::DuplicateCounters{from:CounterSource::On(Objects(One(@event_subject))), to:Objects($affected), copies:All, kind:$event_counter_designation} */
event_counter_duplication ::= "put" event_counter_designation "counters" "on" affected

/* A separate payment decision is made by each member of the player set. */
/* @sem Instruction::[ForEachPlayer{players:$players_each, binding:0, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:Bound(0), cost:$resolving_sacrifice_choice_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:@apply(PlayerSet::One(Bound(0)), $verbs_third)}, otherwise:Program{}}]}}] */
/* @prefer always */
clause_each_unless_sacrifice_choice ::= players_each verbs_third "unless" "they" resolving_sacrifice_choice_cost "of" "their" "choice"

/* The bound player's return choice and the owner's destination are independent. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(Bound(0))))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]} */
bound_return_controlled_hand ::= "returns" "a" filter_phrase "they" "control" "to" "its" "owner's" "hand"

/* @sem Instruction::[ForEachPlayer{players:$players_each, binding:0, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:Bound(0), cost:$controller_life_payment, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:$bound_return_controlled_hand, otherwise:Program{}}]}}] */
clause_each_return_unless_life ::= players_each bound_return_controlled_hand "unless" "they" "pay" controller_life_payment

/* The controller's decision applies only to this iteration's object. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf(Bound(0)), cost:$controller_life_payment, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(ControllerOf(Bound(0))), objects:One(Bound(0))})}]}, otherwise:Program{}}] */
bound_controller_sacrifice_unless_life ::= "its" "controller" "sacrifices" "it" "unless" "they" "pay" controller_life_payment

/* @sem Instruction::[ForEachObject{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$noun}, binding:0, body:Program{instructions:$bound_controller_sacrifice_unless_life}}] */
clause_each_object_controller_decision ::= "for" "each" noun "," bound_controller_sacrifice_unless_life

/* The selected damage recipient is controlled by the chooser. The enclosing
   action excludes its actual source from this population. */
/* @sem ObjectFilter::@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController))) */
other_controlled_damage_kind ::= "another" filter_phrase "you" "control"

/* The damage and follow-up share the choice's result and payment condition. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject($object_ref)), $other_controlled_damage_kind])}, count:AsManyAsCan(Constant(1))}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Objects(One(Result{result:@prior, phase:After, index:0})), amount:$value, preventable:true}}, ...$conjoined]}, otherwise:Program{}}] */
clause_optional_other_damage_followup ::= "you" "may" "have" object_ref "deal" value "damage" "to" other_controlled_damage_kind "." "if" "you" "do" "," conjoined

/* The recipient set and counted attached permanents remain independent operands. */
/* @sem Operation::Draw{players:$other_event_player_targets, amount:$attached_event_player_count} */
draw_attached_to_event_player ::= other_event_player_targets "each" "draw" "cards" "equal" "to" attached_event_player_count

/* @sem PlayerSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:AnyNumber, filter:Any, players:OthersThan(EventSubject)})) */
other_event_player_targets ::= "any" "number" "of" "target" "players" "other" "than" "that" "player"

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$subtype_plural, AttachedToPlayer(EventSubject)])}) */
attached_event_player_count ::= "the" "number" "of" subtype_plural "attached" "to" "that" "player"

/* @sem Instruction::[If{condition:$condition, then:Program{instructions:$instead_sacrifice_action_2}, otherwise:Program{instructions:$instead_sacrifice_action}}] */
instead_sacrifice_front ::= instead_sacrifice_action "." NEWLINE? "if" condition "," "instead" instead_sacrifice_action

/* @sem @apply($players_singular, $instead_sacrifice_instruction) */
instead_sacrifice_plain ::= players_singular instead_sacrifice_instruction

/* Each player's maximum is calculated among that player's controlled population. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(Bound(0)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Property{property:Power, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}, property:Power, aggregation:Maximum}}}])}, choose:AsManyAsCan($counter_amount)})}]}}] */
sacrifice_greatest_power_each ::= players_singular "sacrifices" counter_amount filter_phrase "with" "the" "greatest" "power" "among" filter_plural "they" "control"

/* A source spell divides its damage among any number of announced recipients. */
/* @sem Operation::DealDamage{source:$self_explicit_ref, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:UpTo($number), filter:Any, distribute:$number})), amount:Expr::DistributedShare(@share), preventable:true} */
spell_divided_damage ::= self_explicit_ref "deals" number "damage" "divided" "as" "you" "choose" "among" "any" "number" "of" "targets"

/* This continuation re-announces the same kind of recipient for its branch. */
/* @sem Operation::DealDamage{source:Source, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:UpTo($number), filter:Any, distribute:$number})), amount:Expr::DistributedShare(@share), preventable:true} */
spell_divided_damage_instead ::= "it" "deals" number "damage" "divided" "as" "you" "choose" "among" "those" "permanents" "and" "/" "or" "players" "instead"

/* The same two eligibility filters appear in both alternatives.  The second
   sentence refers to the first sentence's target, not a new player. */
/* @sem Vec<Instruction>::@unlabelled_instructions($instead_sacrifice_either_both_paragraph) */
instead_sacrifice_either_both ::= instead_sacrifice_either_both_paragraph

/* @sem Ability::@optional_ability_label(Spell{announcement:@announcement, body:Program{instructions:[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:Together([Sacrifice{players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0}), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($filter_nonlist_head, $filter_nonlist_head_3)}, choose:Exactly(Constant(1))}, Sacrifice{players:One(Target{slot:0, index:0}), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($filter_nonlist_head_2, $filter_nonlist_head_4)}, choose:Exactly(Constant(1))}])}]}, otherwise:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(Target{slot:0, index:0}), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([@agree($filter_nonlist_head, $filter_nonlist_head_3), @agree($filter_nonlist_head_2, $filter_nonlist_head_4)])}, choose:AsManyAsCan(Constant(1))})}]}}]}}, $spell_paragraph_break) */
instead_sacrifice_either_both_paragraph ::= "target" "player" "sacrifices" "a" filter_nonlist_head "or" filter_nonlist_head "of" "their" "choice" "." spell_paragraph_break "if" condition "," "instead" "that" "player" "sacrifices" "a" filter_nonlist_head "and" "a" filter_nonlist_head "of" "their" "choice"

/* The linked exile target stays a card and keeps the source identity. */
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Exile]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ExiledWith(Source)])}), index:0}) */
conjure_linked_target_card ::= "target" noun "card" "exiled" "with" "this" "creature"

/* Both sentences describe one continuous rule on the announced creature. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0})), changes:[Rule(Prohibit(Regenerate)), Rule(Unique(DamageToItUnpreventable))], duration:EndOfTurn, evaluation:LiveObjects} */
target_creature_regeneration_damage_rule ::= "target" "creature" "can't" "be" "regenerated" "this" "turn" "." "damage" "that" "would" "be" "dealt" "to" "that" "creature" "this" "turn" "can't" "be" "prevented" "or" "dealt" "instead" "to" "another" "permanent" "or" "player"

/* A conditional replacement composes the original discard and the alternative
   revealed-hand choice. Both amounts and the condition are current operands. */
/* @sem Vec<Instruction>::@unlabelled_instructions($instead_discard_hand_choice_paragraph) */
instead_discard_hand_choice ::= instead_discard_hand_choice_paragraph

/* @sem Ability::@optional_ability_label(Spell{announcement:@announcement, body:Program{instructions:[If{condition:$condition, then:Program{instructions:$instead_revealed_hand_choice}, otherwise:Program{instructions:$instead_target_discard}}]}}, $spell_paragraph_break) */
instead_discard_hand_choice_paragraph ::= instead_target_discard "." spell_paragraph_break "if" condition "," "instead" instead_revealed_hand_choice

/* @sem Instruction::[Effect{result:@next, operation:Discard{players:One($target_player), amount:$card_count, random:false}}] */
instead_target_discard ::= target_player "discards" card_count

/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One(@that_player)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(@that_player)}, kind:Card, filter:Any}, count:AsManyAsCan($card_count)}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}] */
instead_revealed_hand_choice ::= "that" "player" "reveals" "their" "hand" "," "you" "choose" card_count "from" "it" "," "then" "that" "player" "discards" "those" "cards"

/* The possessive identifies the same targeted permanent whose owner moves it. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$owner_target_kind}), index:0} */
owner_target_permanent ::= "target" owner_target_kind

owner_target_kind ::= chosen_color_creature | chosen_color_artifact | chosen_color_enchantment | chosen_color_land | chosen_color_permanent

/* The possessive identifies the moved object and its owner. */
/* @sem Operation::Move{objects:One($owner_possessive_shuffle_object), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
owner_shuffles_target_into_library ::= owner_possessive_shuffle_object "owner" "shuffles" "it" "into" "their" "library"

/* Choice and battlefield destination are retained independently. */
/* @sem Operation::Conjure{actor:One(AbilityController), card:$conjured_chosen_book, count:$card_count, destination:Battlefield(BattlefieldArrival{tapped:false, counters:[], states:[]})} */
conjure_choice_battlefield ::= "conjure" card_count conjured_chosen_book "onto" "the" "battlefield"

/* A loyalty ability on the stack retains the filter on its source. */
/* @sem Operation::Counter{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Ability, zones:[Stack]}), count:Exactly(Constant(1)), filter:AllOf([OnStack(Loyalty), AbilityOf($noun)])}), index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None} */
counter_target_loyalty_of ::= "counter" "target" "loyalty" "ability" "of" "a" noun

/* The replacement qualifies the spells cast under this permission. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:Any}), origins:CardPlayOrigins([Graveyard]), action:CastSpell, filter:$cast_spells_filter}, terms:_{cost:Normal, into_exile:true}})], duration:$duration, evaluation:LiveObjects} */
graveyard_cast_redirect_permission ::= duration "," "you" "may" "cast" cast_spells_filter "from" "any" "graveyard" "." "if" "a" "spell" "cast" "this" "way" "would" "be" "put" "into" "a" "graveyard" "," "exile" "it" "instead"

/* Plural recipients and the life amount are independently composable. */
/* @sem Operation::GainLife{players:$shared_life_recipients, amount:$life_phrase} */
shared_plural_life_gain ::= shared_life_recipients "each" "gain" life_phrase

/* A counted permanent belongs to the player bound by the enclosing loop. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))])}) */
bound_permanent_each_count ::= filter_phrase "they" "control"

/* @sem Operation::LoseLife{players:One(Bound(0)), amount:$bound_permanent_each_count} */
bound_loses_life_each ::= "loses" "1" "life" "for" "each" bound_permanent_each_count

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_loses_life_each}]}}] */
instructions_bound_permanent_count ::= players_singular bound_loses_life_each

/* Control and ownership both refer to the enclosing player binding. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0))), OwnedBy(OthersThan(Bound(0)))])}) */
bound_controlled_unowned_count ::= "the" "number" "of" filter_plural "they" "control" "but" "don't" "own"

/* Each action resolves for the entire player population before the next. */
/* @sem Instruction::[ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(Bound(0)), amount:$bound_controlled_unowned_count}}]}}, ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:Discard{players:One(Bound(0)), amount:$bound_controlled_unowned_count}}]}}] */
instructions_bound_shared_count_pair ::= hand_plural_players "loses" "life" "and" "discards" "cards" "equal" "to" bound_controlled_unowned_count

/* Both alternatives carry complete search receipts into their own hand moves;
   the final shuffle is shared in the surface but belongs to either branch. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:$search_hand_episode_2}, otherwise:Program{instructions:$search_hand_episode}}] */
instead_shared_search_hand ::= search_hand_episode "." "if" condition "," "instead" search_hand_episode "." "then" "shuffle"

/* Compose an event-card move with its event controller's optional life payment. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:ControllerOf(EventSubject), cost:Cost{parts:[Life($number)]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:$event_graveyard_battlefield_move}]}, otherwise:Program{}}]} */
event_controller_unless_life_program ::= event_graveyard_battlefield_move "unless" "that" "opponent" "pays" number "life"

/* @sem Operation::Conjure{actor:One(AbilityController), card:Each([$referenced_card_name, $referenced_card_name_2, $referenced_card_name_3]), count:Constant(1), destination:Library{position:Shuffled, arrival:CardArrival{counters:[], states:[]}}} */
conjure_three_named_shuffled_library ::= "conjure" "cards" "named" referenced_card_name "," referenced_card_name "," "and" referenced_card_name "into" "your" "library" "," "then" "shuffle"

/* The counted receipt belongs to this tap action, and both nouns describe the
   same population. Keeping the pair together also guards the print inverse. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(Tapped), @agree($plural, $plural_2), ControlledBy(One(EventSubject)), $object_did_not_attack_turn])}, tapped:true}}, Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Players(One(EventSubject)), amount:CountObjects(Transition{result:@prior, phase:Before}), preventable:true}}]} */
program_tap_nonattackers_receipt_damage ::= "tap" "all" "untapped" plural "that" "player" "controls" "that" object_did_not_attack_turn "." self_explicit_ref "deals" "damage" "to" "the" "player" "equal" "to" "the" "number" "of" plural "tapped" "this" "way"

/* @sem Ability::Triggered{event:$tap_count_each_player_end, limits:_{}, announcement:@announcement, body:$program_tap_nonattackers_receipt_damage} */
trigger_end_tap_nonattackers_receipt_damage ::= "at" tap_count_each_player_end "," program_tap_nonattackers_receipt_damage "."

/* The card filter and duration are independent operands of the game effect. */
/* @sem Operation::GameEffect{until:$exile_entry_prohibition_duration, effect:Term{family:GameEffect, form:CardsCantEnterTheBattlefieldFromExile, operands:[Filter($global_card_filter)]}} */
exile_entry_prohibition ::= global_card_filter "can't" "enter" "from" "exile" exile_entry_prohibition_duration

exile_entry_prohibition_duration ::= this_turn | this_combat

/* A planar-die rule composes with its independently expressed deadline. */
/* @sem Operation::GameEffect{until:$planar_game_effect_duration, effect:Term{family:GameEffect, form:PlanarDieBlanksRollsAreChaos}} */
planar_blank_game_effect ::= "each" "blank" "roll" "of" "the" "planar" "die" "is" "a" "{" "CHAOS" "}" "roll" planar_game_effect_duration

planar_game_effect_duration ::= planar_away_deadline | planar_roll_deadline | until_end_of_turn

/* @sem Duration::UntilEvent($planar_away_event) */
planar_away_deadline ::= "until" planar_away_event

/* @sem Duration::UntilEvent($event_planar_roll) */
planar_roll_deadline ::= "until" event_planar_roll

/* @sem Operation::Keyword{actor:One(AbilityController), action:DrawGame} */
game_draw_operation ::= "the" "game" "is" "a" "draw"

/* The announcement creates one target plus one more for every kick of this spell.
   The following damage refers to exactly that announced group. */
/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Add([Constant(1), TimesKicked(Source)])), filter:Any})) */
kicked_damage_targets ::= "choose" "any" "target" "," "then" "choose" "another" "target" "for" "each" "time" "this" "spell" "was" "kicked"

/* @sem Operation::DealDamage{source:$damage_source_ref, recipients:$kicked_damage_targets, amount:$number, preventable:true} */
kicked_target_damage ::= kicked_damage_targets "." damage_source_ref "deals" number "damage" "to" "each" "of" "them"

/* Separate announced choosers for two serial destruction effects. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:One($target_choice_yours), regeneration:true}}, Effect{result:@next, operation:Destroy{objects:One($target_choice_opponent), regeneration:true}}] */
instructions_destroy_chosen_pair ::= "destroy" target_choice_yours "," "then" "destroy" target_choice_opponent

/* Both target groups share the stated total; other excludes the event subject. */
/* @sem Operation::Move{objects:Union([Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:$exile_pair_count, filter:AllOf([Not(SameObject(@event_subject)), $filter_plural])})), Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:$exile_pair_count, filter:$card_filter, constraints:[SharesLimitWith(0)]}))]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_other_targets_two_zones ::= "exile" exile_pair_count "other" "target" filter_plural "from" "the" "battlefield" "and" "/" "or" card_filter "cards" "from" "graveyards"

/* @sem Count::@plural_count($target_up_to) */
exile_pair_count ::= target_up_to

/* The same controlled population supplies both the choice and the extreme.
   Agreement prevents a narrower named choice from changing its domain. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$target_opponent, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:Extreme{among:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($filter_nonlist_head, $plural_head), ControlledBy(One($target_opponent))])}, property:$stat, highest:true}}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
controlled_extreme_exile ::= target_opponent "exiles" "a" filter_nonlist_head "they" "control" "with" "the" "greatest" stat "among" plural_head "they" "control"

/* The replacement retains the named token recipe in both branches. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$value, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}] */
instead_named_token_count ::= "create" "a" token_named_recipe "token" "." "create" value "of" "those" "tokens" "instead" "if" condition

/* The next damage event uses the target creature as its recipient and subject. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$noun_creature}), index:0})), kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:NextOccurrence, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:Destroy{objects:One(EventSubject), regeneration:true}}]}} */
next_damage_destroy_target_creature ::= "the" "next" "time" "damage" "would" "be" "dealt" "to" "target" noun_creature this_duration "," "destroy" "that" "creature" "instead"

/* Prevention has its own cap, recipient, and duration. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject($target_permanent)), kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:TotalDamage($value), duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevent_next_damage_target ::= "prevent" "the" "next" value "damage" "that" "would" "be" "dealt" "to" target_permanent this_duration

/* Both actions belong to the named player; the hand uses that same player. */
/* @sem Instruction::[Effect{result:@next, operation:@apply(PlayerSet::One($player_ref), $verb_operation_third)}, Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($player_ref)}, kind:Card, filter:Any}}}] */
clause_player_action_reveal_hand ::= player_ref verb_operation_third "and" "reveals" "their" "hand"

/* Scope the performed-action test to its actual destroy producer. */
/* @sem Instruction::[Effect{result:@mark, operation:Destroy{objects:One($target_object), regeneration:true}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:Before, index:0}, filter:$filter_phrase}, then:Program{instructions:$clause_player_may_search}, otherwise:Program{instructions:$clause_player_may_search_2}}] */
clause_destroy_kind_search_alternative ::= "destroy" target_object "." "if" "a" filter_phrase "was" "destroyed" "this" "way" "," clause_player_may_search "." "otherwise" "," clause_player_may_search

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$clause_destroy_kind_search_alternative}} */
spell_destroy_kind_search_alternative ::= clause_destroy_kind_search_alternative "."

/* Both branches refer to the one announced player; the loss verbs carry their
   own current amounts and can be reused independently of this contrast. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One($instead_loss_target), $lose_life_amount_2)}]}, otherwise:Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One($instead_loss_target), $lose_life_amount)}]}}] */
instead_target_player_loss ::= instead_loss_target lose_life_amount "." NEWLINE? "if" condition "," "that" "player" lose_life_amount "instead"

instead_loss_target ::= target_player | target_opponent

/* Keep the destroy producer and its before-receipt together in both directions. */
/* @sem Instruction::[Effect{result:@mark, operation:Destroy{objects:$destroy_object_set, regeneration:true}}, ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(Bound(0)), amount:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])})}}]}}] */
destroy_controlled_receipt_life ::= "destroy" destroy_object_set "." NEWLINE? players_singular "loses" "life" "equal" "to" "the" "number" "of" filter_plural "they" "controlled" "that" "were" "destroyed" "this" "way"

/* The final action may instead be sequenced with then. */
/* @sem Instruction::[$verb_third, $verb_third_2, $verb_third_3] */
verbs_third_serial_then ::= verb_third "," verb_third "," "then" verb_third

/* The two action families retain their own operands; the trailing condition tests the referenced object. */
/* @sem Instruction::[If{condition:$replacement_object_condition, then:Program{instructions:$instead_counters_action}, otherwise:Program{instructions:$instead_pump_action}}] */
instead_pump_counters_postposed ::= instead_pump_action "." NEWLINE? instead_counters_action "instead" "if" replacement_object_condition

/* The chosen damage source and replacement event share the choice receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:DamageSources($damage_source), count:Exactly(Constant(1))}}, Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Any, sources:SameObject(Result{result:@prior, phase:Before, index:0}), recipients:$replacement_damage_to, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:NextOccurrence, duration:$this_duration, body:$prevent_and_reflect_damage_body}}] */
chosen_source_next_damage ::= "the" "next" "time" damage_source "of" "your" "choice" "would" "deal" "damage" "to" replacement_damage_to this_duration "," prevent_and_reflect_damage_body

/* The reflected amount is the result of this body's prevention. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, Effect{result:@next, operation:DealDamage{source:$self_ref_named, recipients:Players(One(ControllerOf(Damage(Source)))), amount:Performed(@prior), preventable:true}}]} */
prevent_and_reflect_damage_body ::= "prevent" "that" "damage" "." "if" "damage" "is" "prevented" "this" "way" "," self_ref_named "deals" "that" "much" "damage" "to" "that" "source's" "controller"

/* An opponent's graveyard identifies the owner of the returned card. */
/* @sem Operation::Move{objects:One($target_opponent_creature_graveyard), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[]}}, qualifiers:[]} */
return_opponent_card_with_counter ::= "return" target_opponent_creature_graveyard "to" "the" "battlefield" "under" "their" "control" "with" "a" counter_kind "counter" "on" "it"

/* The later creature anaphor requires a creature-card target. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and(ObjectFilter::CardType(Creature), ObjectFilter::InZone(Players{zone:Graveyard, players:OpponentsOf(PlayerRef::AbilityController)}))}), index:0} */
target_opponent_creature_graveyard ::= "target" "creature" "card" "from" "an" "opponent's" "graveyard"

/* A qualifying topmost card receives the stated perpetual changes. */
/* @sem Operation::CreatePerpetualEffect{objects:$topmost_library_card, changes:$library_perpetual_changes} */
topmost_library_perpetual ::= topmost_library_card "perpetually" library_perpetual_changes

/* The acting player chooses cards from that same player's hand. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$target_player_ref, objects:Zone{scope:Players{zone:Hand, players:One($target_player_ref)}, kind:Card, filter:Any}, count:AsManyAsCan($hand_exile_fixed_count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
player_exiles_hand_cards ::= target_player_ref "exiles" hand_exile_fixed_count "from" "their" "hand"

/* A following third-person verb keeps the player just named. */
/* @sem Instruction::[...$player_exiles_hand_cards, Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::Target{slot:@last_slot, index:0}), $hand_exile_followup)}] */
player_exiles_hand_and_verb ::= player_exiles_hand_cards "and" hand_exile_followup

target_player_ref ::= target_player | target_opponent

/* These follow-ups introduce no additional target; the latest slot remains the
   player who chose from their hand. */
hand_exile_followup ::= hand_exile_loses_life | hand_exile_gains_life

/* @sem Operation::LoseLife{players:@subject, amount:$life_number} */
hand_exile_loses_life ::= "loses" life_number

/* @sem Operation::GainLife{players:@subject, amount:$life_number} */
hand_exile_gains_life ::= "gains" life_number

hand_exile_fixed_count ::= card_count_one | card_count_many

/* Entry predicates and destination programs compose with a temporary replacement. */
/* @sem Operation::CreateReplacement{event:$uncast_entry_event, limit:UntilExpired, duration:$duration, body:$replacement_exile_it} */
timed_uncast_entry_replacement ::= duration "," "if" uncast_entry_event "," replacement_exile_it

/* @sem ReplacementEvent::Enter{objects:AllOf([$filter_phrase, Not(Cast{})])} */
uncast_entry_event ::= "a" filter_phrase "would" "enter" "and" "it" "wasn't" "cast"

/* The count is a live population, counter total, or explicit turn history. */
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:@subject, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan($sacrifice_per_count)}) */
sacrifice_choice_per_count_third ::= "sacrifices" "a" filter_phrase "of" "their" "choice" "for" "each" sacrifice_per_count

sacrifice_per_count ::= count_each_card_hand | count_each_card_graveyard | count_each_object_counter | count_each_put_into_your_graveyard | count_each_permanent | count_each_controlled

/* A free ticket sticker retains its independent kind, ceiling and recipient. */
/* @sem Operation::PutStickers(_{actor:One(AbilityController), kind:$ticket_sticker_kind, objects:$affected, ticket_cost:[LessOrEqual, $ticket_sticker_ceiling]}) */
put_ticket_sticker_free ::= "put" ticket_sticker_kind "sticker" "with" "ticket" "cost" ticket_sticker_ceiling "or" "less" "on" affected "without" "paying" "that" "sticker's" "ticket" "cost"

ticket_sticker_kind ::= ticket_ability_kind | ticket_pt_kind

/* @sem StickerKind::Ability */
ticket_ability_kind ::= "an" "ability"

/* @sem StickerKind::PowerToughness */
ticket_pt_kind ::= "a" "power" "and" "toughness"

ticket_sticker_ceiling ::= ticket_cast_x | number_digits

/* @sem Expr::CastX(ObjectRef::EventSubject) */
ticket_cast_x ::= "X"

/* This inverse is used only by the self-entry wrapper, where the subject is the source. */
/* @sem Operation::PutStickers(_{actor:One(AbilityController), kind:$ticket_sticker_kind, objects:$affected, ticket_cost:[LessOrEqual, CastX(Source)]}) */
self_entry_ticket_sticker ::= "put" ticket_sticker_kind "sticker" "with" "ticket" "cost" "X" "or" "less" "on" affected "without" "paying" "that" "sticker's" "ticket" "cost"

/* The entry event proves that its subject and source are the same object. */
/* @sem Ability::Triggered{event:ZoneChange{objects:$event_self, to:Battlefield}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$self_entry_ticket_sticker}]}}]}} */
self_entry_optional_ticket_sticker ::= "when" event_self "enters" "," "you" "may" self_entry_ticket_sticker "."

/* The multiplier is an event count, independent of the damage recipient. */
/* @sem Operation::DealDamage{source:$damage_source_ref, recipients:$recipients, amount:Multiply([$number, $damage_history_count]), preventable:true} */
deal_damage_per_history ::= damage_source_ref "deals" number "damage" "to" recipients "for" "each" damage_history_count

damage_history_count ::= count_each_drawn_card | count_each_discarded_turn | count_each_controlled | count_each_graveyard | count_each_card_graveyard

/* Both follow-ups refer to the marked damage, not the intervening tap. */
/* @sem Instruction::[Effect{result:@mark, operation:$deal_damage_divided_any_number}, Effect{result:@next, operation:SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::DamagedBy(@marked))}, tapped:true}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(DamagedBy(@marked)), changes:[PlayerRule(Prohibit(CastSpell{filter:$adjective_nontype}))], duration:$this_duration, evaluation:LiveObjects}}] */
instructions_divided_damage_restriction ::= deal_damage_divided_any_number "." "tap" "each" filter_phrase "dealt" "damage" "this" "way" "." "players" "dealt" "damage" "this" "way" "can't" "cast" adjective_nontype "spells" this_duration

/* Keep the damage producer together with its singular receipt consumer. */
/* @sem Instruction::[Effect{result:@next, operation:$deal_damage}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun, DamagedBy(@prior)])}), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot}}] */
instructions_damage_receipt_pump ::= deal_damage "." "if" "a" noun "is" "dealt" "damage" "this" "way" "," "it" "gets" signed "/" signed duration

/* Both sentences describe one destruction of the same creature. */
/* @sem Operation::Destroy{objects:One($destroy_singular_creature), regeneration:false} */
destroy_creature_no_regeneration ::= "destroy" destroy_singular_creature "." "the" "creature" "can't" "be" "regenerated"

destroy_singular_creature ::= destroy_named_creature | paid_copy_creature_target | enchanted_creature_ref | destroy_target_non_type_creature | destroy_target_two_non_types_creature

/* @sem ObjectRef::@remember_operand($named_creature) */
destroy_named_creature ::= named_creature

/* A damage-producing instruction and its receipt-dependent condition stay together. */
/* @sem Instruction::[Effect{result:@next, operation:$deal_damage}, If{condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$damage_receipt_filter, DamagedBy(@prior)])}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$damage_receipt_followup}, otherwise:Program{}}] */
instructions_damage_conditional_receipt ::= deal_damage "." NEWLINE? "if" "a" damage_receipt_filter "is" "dealt" "damage" "this" "way" "," damage_receipt_followup

/* @prefer always */
/* @sem ObjectFilter::AllOf([Colorless, $filter_phrase]) */
colorless_damage_filter ::= "colorless" filter_phrase

/* Each matching player executes the action with that player as its subject. */
/* @sem Instruction::[ForEachPlayer{players:$players_exact_life, binding:0, body:Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::Bound(0)), $verb_operation_third)}]}}] */
instructions_each_exact_life_action ::= players_exact_life verb_operation_third

/* @sem Instruction::[ForEachPlayer{players:$players_opponents_attacking, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_controlled_tap_action}]}}] */
clause_attacking_player_bound_action ::= players_opponents_attacking bound_controlled_tap_action

/* One card exile and its two independent type tests share the same arrival. */
/* @sem Vec<Instruction>::[Effect{result:@mark, operation:Move{objects:One($target_card), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$filter_phrase}, then:$program, otherwise:Program{}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$filter_phrase_2}, then:$program_2, otherwise:Program{}}, If{condition:Not(AnyOf([ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$filter_phrase}, ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$filter_phrase_2}])), then:$program_3, otherwise:Program{}}] */
instructions_exile_single_card_type_branches ::= "exile" target_card "." "if" "it" "was" "a" filter_phrase "card" "," program "." "if" "it" "was" "a" filter_phrase "card" "," program "." "otherwise" "," program

/* The referenced player owns the single card exiled from an opponent's graveyard.
   Keep the producer and the post-move test together for inverse printing. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One($exile_opponent_graveyard_target), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$filter_phrase}, then:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(OwnerOf(Result{result:@marked, phase:After, index:0})), amount:$number}}]}, otherwise:Program{}}] */
instructions_exiled_opponent_card_kind_loss ::= "exile" exile_opponent_graveyard_target "." "if" "it" "was" ("a" | "an") filter_phrase "card" "," "that" "player" "loses" number "life"

exile_opponent_graveyard_target ::= target_any_card_opponent_graveyard | target_card_opponent_graveyard

/* The opponent is chosen when the delayed event occurs, not when it is scheduled. */
/* @sem Operation::CreateDelayedTrigger{event:$opponent_control_time, start:Immediately, body:Program{instructions:$clause_opponent_gains_control}} */
delayed_opponent_control ::= clause_opponent_gains_control "at" opponent_control_time

opponent_control_time ::= delayed_move_end_event | delayed_move_any_upkeep

/* The delayed action expires if this turn ends before combat does. */
/* @sem Operation::CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, expires:EndOfTurn, body:Program{instructions:[Effect{result:@next, operation:$destroy}]}} */
delayed_this_turn_end_combat ::= "at" "this" "turn's" "next" "end" "of" "combat" "," destroy

redirect_damage_limit ::= redirect_damage_limit_next | redirect_damage_limit_all

/* @sem ReplacementLimit::TotalDamage($value) */
redirect_damage_limit_next ::= "the" "next" value

/* @sem ReplacementLimit::UntilExpired */
redirect_damage_limit_all ::= "all"

/* Two distinct graveyard targets get separate default destinations, while a
