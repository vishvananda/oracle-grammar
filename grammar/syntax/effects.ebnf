each_unless_discard_part ::= cost_discard | cost_discard_many

/* @sem Instruction::[ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:Bound(0), cost:Cost{parts:[$each_unless_discard_part]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:@apply(PlayerSet::One(Bound(0)), $verbs_third)}, otherwise:Program{}}]}}] */
clause_each_unless_discard ::= hand_plural_players verbs_third "unless" "they" each_unless_discard_part

/* Plain third-person sacrifice without "of their choice". */
