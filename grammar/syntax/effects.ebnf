/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:@apply(PlayerSet::One(AbilityController), $discard_hand_base)}]}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:@written_x(Expr::CountObjects(Transition{result:@marked, phase:Before}))}}, If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(OpponentsOf(AbilityController)), amount:@written_x(Expr::CountObjects(Transition{result:@marked, phase:Before})), preventable:true}}]}, otherwise:Program{}}] */
instructions_optional_discard_hand_x_actions ::= "you" "may" discard_hand_base "." "draw" "X" "cards" "," "where" "X" "is" "the" "number" "of" "cards" "discarded" "this" "way" "." "if" condition "," SELF_NAME "deals" "X" "damage" "to" "each" "opponent"

/* The source supplies both the damage and the power; the other target excludes it. */
