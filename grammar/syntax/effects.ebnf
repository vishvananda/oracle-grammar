/* @sem Operation::PutStickers(_{actor:One(AbilityController), kind:$sticker_kind, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, OwnedBy(One(AbilityController))])}, amount:Constant(2), any_number:true}) */
