damage_existing_recipients ::= recipients

/* @sem Recipients::Objects($tap_qualified_attacker_target) */
damage_qualified_attacker_recipients ::= tap_qualified_attacker_target

/* A singular target's counter qualification belongs to its announced filter. */
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($filter_phrase, ObjectFilter::Counters(_{comparison:Equal, value:Constant(0)}))}), index:0}) */
destroy_target_without_counters ::= "target" filter_phrase "with" "no" "counters" "on" "it"

/* A conditional destination replaces a graveyard return, retaining both actions. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:$instead_graveyard_entry}, otherwise:Program{instructions:$instead_graveyard_hand}}] */
instead_graveyard_redirect ::= instead_graveyard_hand "." NEWLINE? "if" condition "," instead_graveyard_entry "instead"

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($redirect_own_graveyard_target), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instead_graveyard_hand ::= "return" redirect_own_graveyard_target "to" "your" "hand"

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$affected, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
instead_graveyard_entry ::= "return" affected "card" "to" "the" "battlefield"

/* The hand recipient is also the owner of this graveyard target. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($card_filter, $return_mana_bound, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0} */
redirect_own_graveyard_target ::= "target" card_filter "card" return_mana_bound "from" "your" "graveyard"

/* A draw can measure damage received by a player set in a stated turn. */
/* @prefer always */
/* @sem Instruction::[$verb_base, Effect{result:@next, operation:Draw{players:@subject, amount:$draw_damage_history_amount}}] */
verbs_base_and_history_draw ::= verb_base "and" "draw" "cards" "equal" "to" draw_damage_history_amount

/* @sem Expr::EventHistory{event:Damage(DamageEvent{source_kind:Any, sources:Any, recipients:Players($players_singular), kind:$historical_damage_kind, grouping:SourceRecipient, subject:Recipient}), window:$draw_damage_history_window, measure:TotalAmount} */
draw_damage_history_amount ::= "the" historical_damage_kind "dealt" "to" players_singular draw_damage_history_window

