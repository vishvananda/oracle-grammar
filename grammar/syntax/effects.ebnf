/* The explicit book key is independent of the source card. */
/* @sem Operation::DraftFromSpellbook{actor:One(AbilityController), spellbook:Beleren, times:Constant(1)} */
draft_beleren_book ::= "draft" "a" "card" "from" "the" "Beleren" "Spellbook"
