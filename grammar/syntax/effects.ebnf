instructions_for_each_player_mill_return ::= "for" players_singular "," mill_return_unless_bound_pays

/* The singular mill and return share one receipt; the payment belongs to the loop player. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$controller_mill_one}, Effect{result:@next, operation:PayCost{player:Bound(0), cost:Cost{parts:[Life($value)]}, optional:true}}, If{condition:Not(PaymentChosen(1)), then:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:0, phase:After, index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{}}]} */
mill_return_unless_bound_pays ::= controller_mill_one "," "then" "return" "that" "card" "from" "your" "graveyard" "to" "your" "hand" "unless" "that" "player" "pays" value "life"

/* @sem Operation::Mill{players:One(AbilityController), amount:Constant(1)} */
controller_mill_one ::= "you" "mill" "a" "card"

/* The postposed timing composes with any supported destroy object set. */
/* @sem Operation::CreateDelayedTrigger{event:$turn_end_combat, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:$destroy}]}} */
delayed_destroy_at_combat_end ::= destroy "at" turn_end_combat

/* The replacement counters the same announced spell without the payment. */
/* @sem Vec<Instruction>::@unlabelled_instructions($instead_counter_unless_replaced_paragraph) */
instead_counter_unless_replaced ::= instead_counter_unless_replaced_paragraph

/* @sem Ability::@optional_ability_label(Spell{announcement:@announcement, body:Program{instructions:[If{condition:$condition, then:Program{instructions:$instead_counter_named}, otherwise:Program{instructions:$clause_counter_unless_plain}}]}}, $spell_paragraph_join) */
instead_counter_unless_replaced_paragraph ::= clause_counter_unless_plain "." spell_paragraph_join "if" condition "," instead_counter_named "instead"

/* The player named in the action also chooses which alternative to pay. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:$player_ref, cost:Cost{parts:[Choice([$third_sacrifice_choice_cost, $third_discard_cost])]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:@apply(PlayerSet::One($player_ref), $verbs_third)}, otherwise:Program{}}] */
clause_player_unless_that_player_sacrifice_or_discard ::= player_ref verbs_third "unless" "that" "player" third_sacrifice_choice_cost "of" "their" "choice" "or" third_discard_cost

conditional_damage_recipient ::= recipients_any_target | recipients_player_or_walker

/* The leading adverb replaces the immediately preceding counter action. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:$counter_replacement_action_2}, otherwise:Program{instructions:$counter_replacement_action}}] */
instead_counters_leading ::= counter_replacement_action "." NEWLINE? "if" condition "," "instead" counter_replacement_action

counter_replacement_action ::= counter_replacement_one | counter_replacement_many

/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($that_noun)), kind:$counter_kind, amount:Constant(1)}]}}] */
counter_replacement_one ::= "put" "a" counter_kind "counter" "on" that_noun

/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($that_noun)), kind:$counter_kind, amount:$number_words}]}}] */
counter_replacement_many ::= "put" number_words counter_kind "counters" "on" that_noun

/* Both alternatives affect the same explicitly stated population; the second
   sentence's plural anaphor cannot select a different set. */
/* @sem Instruction::[If{condition:ObjectMatches{object:EventSubject, filter:$subtype}, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($instead_other_controlled_creatures), changes:[Pump{power:$signed_3, toughness:$signed_4}], duration:$duration_2, evaluation:Snapshot}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($instead_other_controlled_creatures), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot}}]}}] */
instead_controlled_creatures_event_subtype ::= instead_other_controlled_creatures "get" signed "/" signed duration "." NEWLINE? "if" "that" "land" "is" "a" subtype "," "those" "creatures" "get" signed "/" signed duration "instead"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), CardType(Creature), ControlledBy(One(AbilityController))])} */
instead_other_controlled_creatures ::= "other" "creatures" "you" "control"

/* A named player may have a source deal damage to them to prevent an action. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:$player_ref, cost:Cost{parts:[PlayerAction{player:$player_ref, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(One($player_ref)), amount:$value, preventable:true}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:@apply(PlayerSet::One($player_ref), $verbs_third)}, otherwise:Program{}}] */
clause_singular_unless_has_damage ::= player_ref verbs_third "unless" "that" "player" "has" object_ref "deal" value "damage" "to" "them"

/* The damaged creature's controller may pay to prevent the stated program. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:ControllerOf(Damage(Recipient)), cost:$cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:$program, otherwise:Program{}}]} */
damaged_creature_controller_unless_program ::= program "unless" "that" "creature's" "controller" "pays" cost

/* A divided total and target cap share the damage dealer's current property. */
/* @sem Operation::DealDamage{source:$divided_damage_dealer, recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(ObjectProperty{object:$divided_damage_dealer, property:$stat, information:CurrentOrLastKnown}), filter:$divided_x_object_filter, distribute:ObjectProperty{object:$divided_damage_dealer, property:$stat, information:CurrentOrLastKnown}}))), amount:DistributedShare(@share), preventable:true} */
deal_damage_divided_source_stat ::= divided_damage_dealer "deals" "X" "damage" divided_x_object_filter "," "where" "X" "is" "its" stat

/* @sem ObjectFilter::$filter_plural */
divided_x_object_filter ::= "divided" "as" "you" "choose" "among" "up" "to" "X" "target" filter_plural

/* Dealer references here cannot introduce an additional target. */
divided_damage_dealer ::= self_ref | it_ordinary_pronoun | that_noun

/* The definition applies to both the distributed total and its target bound.
   This sentence is admitted only in an activation body. */
/* @sem @where(Program::Program{instructions:[Effect{result:@next, operation:$activation_x_divided_damage}]}, $value_greatest) */
activation_defined_divided_sentence ::= activation_x_divided_damage "," "where" "X" "is" value_greatest "as" "you" "activate" "this" "ability" "."

/* @sem Operation::DealDamage{source:$damage_source_ref, recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(AnnouncedX), filter:$plural_and_or, distribute:AnnouncedX}))), amount:Expr::DistributedShare(@share), preventable:true} */
activation_x_divided_damage ::= damage_source_ref "deals" "X" "damage" "divided" "as" "you" "choose" "among" "any" "number" "of" "target" plural_and_or

/* The stated counter total belongs to the damage source named in this clause. */
/* @sem Operation::DealDamage{source:$self_ref_holder, recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(CountCounters{recipients:Objects(One($self_ref_holder)), kind:$counter_kind, information:CurrentOrLastKnown}), filter:$filter_plural, distribute:CountCounters{recipients:Objects(One($self_ref_holder)), kind:$counter_kind, information:CurrentOrLastKnown}}))), amount:Expr::DistributedShare(@share), preventable:true} */
deal_damage_divided_counter_total ::= self_ref_holder "deals" "X" "damage" "divided" "as" "you" "choose" "among" "any" "number" "of" "target" filter_plural "," "where" "X" "is" "the" "number" "of" counter_kind "counters" "on" "it"

/* A defined total also bounds the number of recipients. The expression is
   shared by the distribution and its target limit. */
/* @sem Operation::DealDamage{source:$damage_source_ref, recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo($damage_history_definition), filter:$filter_plural, distribute:$damage_history_definition}))), amount:Expr::DistributedShare(@share), preventable:true} */
deal_damage_divided_defined_objects ::= damage_source_ref "deals" "X" "damage" "divided" "as" "you" "choose" "among" "any" "number" "of" "target" filter_plural "," "where" "X" "is" damage_history_definition

/* A shared base-verb chain applies to both the controller and attack actor. */
/* @sem @apply($controller_and_attacker, $verbs_base_more) */
clause_controller_and_attacker_each ::= controller_and_attacker "each" verbs_base_more

/* The repeated target noun must agree; the condition tests the original
   target even if destruction fails. The dependent damage names its host. */
/* @sem Instruction::[Effect{result:@mark, operation:Destroy{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@agree($noun, $noun_2)}), index:0}), regeneration:true}}, If{condition:ObjectMatches{object:Target{slot:@last_slot, index:0}, filter:AttachedTo(InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}))}, then:Program{instructions:$damage_attached_target_creature}, otherwise:Program{}}] */
clause_destroy_attached_creature ::= "destroy" "target" noun "." NEWLINE? "if" "that" noun "was" "attached" "to" "a" "creature" "," damage_attached_target_creature

/* Scoped to a preceding test that establishes the attached creature. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:Objects(One(AttachedTo(Target{slot:@last_slot, index:0}))), amount:$number, preventable:true}}] */
damage_attached_target_creature ::= damage_source_ref "deals" number "damage" "to" "that" "creature"

/* A destroy receipt is consumed only within its producer's instruction sequence. */
/* @sem Instruction::[Effect{result:@mark, operation:Destroy{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:AnyNumber, filter:$filter_plural})), regeneration:true}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController))])}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Result{result:@prior, phase:After, index:0})), kind:$counter_kind, amount:Multiply([$number, CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$filter_phrase_2})])}]}}] */
clause_destroy_choice_counter_receipt ::= "destroy" "any" "number" "of" "target" filter_plural "." "choose" "a" filter_phrase "you" "control" "." "put" number counter_kind "counters" "on" "it" "for" "each" filter_phrase "destroyed" "this" "way"

/* @sem @apply($you_and_player_set, $create_tapped_base) */
operation_you_and_player_each_tapped ::= you_and_player_set "each" create_tapped_base

/* The delayed removal is tied to this distribution's targets, share and counter kind. */
/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Between{minimum:Constant(1), maximum:$distribution_target_range}, filter:CardType(Creature), distribute:$counter_distribution_total}))), kind:PowerToughness(1, 1), amount:DistributedShare(@share)}]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CleanupStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(Targets(@last_slot)), kind:PowerToughness(1, 1), amount:Count(Exactly(DistributedShare(@share)))}]}}]}}}] */
distributed_counter_temporary_cleanup ::= "distribute" counter_distribution_total "+" "1" "/" "+" "1" "counters" "among" distribution_target_range "target" "creatures" "." "for" "each" "+" "1" "/" "+" "1" "counter" "you" "put" "on" "a" "creature" "this" "way" "," "remove" "a" "+" "1" "/" "+" "1" "counter" "from" "that" "creature" "at" "the" "beginning" "of" "the" "next" "cleanup" "step"

/* A one-time delayed trigger carries its event, window and complete program. */
/* @sem Operation::CreateTrigger{event:$next_player_attack_event, duration:$this_duration, announcement:@announcement, body:$program, once:true} */
next_player_event_trigger ::= "when" next_player_attack_event this_duration "," program

/* The delayed event supplies the spell whose X is measured by its body. */
/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:State(HasX)} */
event_next_cast_spell_x ::= "when" "you" "next" "cast" "a" "spell" "with" "{" "X" "}" "in" "its" "mana" "cost"

/* @sem Instruction::[Effect{result:@next, operation:$operation_you}, Effect{result:@next, operation:$fraction_x_action}] */
next_cast_fractional_body ::= operation_you "and" fraction_x_action "," "rounded" "down"

/* @sem Operation::CreateTrigger{event:$event_next_cast_spell_x, duration:$this_duration, announcement:@announcement, body:Program{instructions:$next_cast_fractional_body}, once:true} */
next_cast_delayed_fractional ::= event_next_cast_spell_x this_duration "," next_cast_fractional_body

/* The receipt is scoped to this complete per-player sacrifice sequence. */
/* @sem Instruction::[ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(Bound(0)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), Property{property:Power, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(Bound(0)))])}, property:Power, aggregation:Maximum}}}])}, choose:AsManyAsCan(Constant(1))})}]}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:Aggregate{objects:Transition{result:@prior, phase:Before}, property:Power, aggregation:Maximum}}}] */
instructions_each_sacrifice_maximum_power_life ::= hand_plural_players "sacrifices" "a" "creature" "with" "the" "greatest" "power" "among" "creatures" "they" "control" "." "you" "gain" "life" "equal" "to" "the" "greatest" "power" "among" "creatures" "sacrificed" "this" "way"

/* The payment operation is shared by player loops and their scoped consumers. */
/* @sem Operation::PayAnyAmount{actor:One(Bound(0)), resource:Mana} */
bound_any_mana_payment ::= "may" "pay" "any" "amount" "of" "mana"

/* @sem Operation::PayAnyAmount{actor:One(Bound(0)), resource:Life} */
bound_any_life_payment ::= "may" "pay" "any" "amount" "of" "life"

bound_any_payment ::= bound_any_mana_payment | bound_any_life_payment

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_any_payment}]}}] */
shared_each_payment ::= players_singular bound_any_payment

/* This pair proves the exact resource, producer and recipient for the receipt. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_any_mana_payment}]}}, Effect{result:@next, operation:CreateTokens{players:All, tokens:[TokenSpec{amount:Performed(@prior), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
shared_each_payment_tokens ::= "each" "player" bound_any_mana_payment "." "then" "each" "player" "creates" "a" "number" "of" token_recipe "equal" "to" "the" "amount" "of" "mana" "they" "paid" "this" "way"

/* A threshold sentence modifies the total distributed by the preceding X damage. */
/* @sem Expr::Conditional{condition:Compare{left:ObjectProperty{object:Source, property:SpellX, information:CurrentOrLastKnown}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number_digits}}, then:Multiply([Constant(2), AnnouncedX]), otherwise:AnnouncedX} */
x_divided_threshold_total ::= "." "if" "X" "is" number_digits "or" "more" "," SELF_NAME "deals" "twice" "X" "damage" "divided" "as" "you" "choose" "among" "them" "instead"

/* @sem Operation::DealDamage{source:$self_ref_named, recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:$divided_count, filter:$plural_and_or, distribute:$x_divided_threshold_total}))), amount:DistributedShare(@share), preventable:true} */
conditional_x_divided_damage ::= self_ref_named "deals" "X" "damage" "divided" "as" "you" "choose" "among" divided_count "target" plural_and_or x_divided_threshold_total

/* The optional single-card exile and both independent tests share its result. */
/* @sem Vec<Instruction>::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:Move{objects:One($target_card), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$single_exile_arrival_filter}, then:Program{instructions:$clause}, otherwise:Program{}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$single_exile_arrival_filter_2}, then:Program{instructions:$clause_2}, otherwise:Program{}}] */
optional_single_exile_two_tests ::= "you" "may" "exile" target_card "." "if" single_exile_arrival_filter "," clause "." "if" single_exile_arrival_filter "," clause

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$optional_single_exile_two_tests}} */
triggered_optional_single_exile_two_tests ::= event_clause "," optional_single_exile_two_tests "."

/* The history is evaluated separately for each affected player. */
/* @sem Operation::LoseLife{players:@subject, amount:$recipient_life_lost_history} */
lose_life_recipient_history ::= "loses" "life" "equal" "to" recipient_life_lost_history

/* Each member of the triggering group supplies the object duplicated. */
/* @sem Operation::Conjure{actor:One(AbilityController), card:Duplicate(EventGroup), count:$event_duplicate_count, destination:Battlefield(BattlefieldArrival{tapped:false, counters:[], states:[]})} */
conjure_each_event_group ::= "for" "each" "of" "them" "," "conjure" event_duplicate_count "of" "it" "onto" "the" "battlefield"

event_duplicate_count ::= event_duplicate_one | event_duplicate_many

/* @sem Expr::Constant(1) */
event_duplicate_one ::= "a" "duplicate"

/* @sem $count_plural */
event_duplicate_many ::= count_plural "duplicates"

/* This operation is scoped to a cast trigger, whose subject is the named spell. */
/* @sem Operation::DealDamage{source:$self_explicit_ref, recipients:$recipients, amount:Add([$number, $shared_before_cast_history]), preventable:true} */
shared_cast_history_damage ::= self_explicit_ref "deals" "damage" "to" recipients "equal" "to" number "plus" shared_before_cast_history

/* Each recipient is also the controller of the counted chosen-color population. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:Players(One(Bound(0))), amount:$chosen_color_each_player_count, preventable:true}}]}}] */
damage_each_player_chosen_color_count ::= damage_source_ref "deals" "damage" "to" "each" "player" "equal" "to" chosen_color_each_player_count

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$plural, Chosen(Color), ControlledBy(One(Bound(0)))])}) */
chosen_color_each_player_count ::= "the" "number" "of" plural "of" "that" "color" "that" "player" "controls"

/* The second sentence refers to the entire previously announced player set.
   Both clauses use the ordinary group-action vocabulary and share one target. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:@apply($announced_many_players, $uniform_group_third)}, otherwise:Program{instructions:@apply(PlayerSet::Targets(@last_slot), $uniform_player_one)}}] */
instead_announced_group_action ::= announced_many_players "each" uniform_player_one "." NEWLINE? "if" condition "," "each" "of" "those" "players" uniform_group_third "instead"

uniform_group_third ::= uniform_group_mills | uniform_group_draws | uniform_group_discards | uniform_group_gains | uniform_group_loses

/* @sem Instruction::[Effect{result:@next, operation:Mill{players:@subject, amount:$uniform_card_count}}] */
uniform_group_mills ::= "mills" uniform_card_count

/* @sem Instruction::[Effect{result:@next, operation:Draw{players:@subject, amount:$uniform_card_count}}] */
uniform_group_draws ::= "draws" uniform_card_count

/* @sem Instruction::[Effect{result:@next, operation:Discard{players:@subject, amount:$uniform_card_count, random:false}}] */
uniform_group_discards ::= "discards" uniform_card_count

/* @sem Instruction::[Effect{result:@next, operation:GainLife{players:@subject, amount:$uniform_number}}] */
uniform_group_gains ::= "gains" uniform_number "life"

/* @sem Instruction::[Effect{result:@next, operation:LoseLife{players:@subject, amount:$uniform_number}}] */
uniform_group_loses ::= "loses" uniform_number "life"

/* The postposed qualifier names the previously chosen card type. */
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:@subject, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, $sacrifice_chosen_card_type)}, choose:AsManyAsCan(Constant(1))}) */
sacrifice_choice_chosen_card_type_singular ::= "sacrifices" counter_choice_one filter_phrase "of" "their" "choice" sacrifice_chosen_card_type

/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:@subject, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, $sacrifice_chosen_card_type)}, choose:AsManyAsCan($sacrifice_chosen_plural_count)}) */
sacrifice_choice_chosen_card_type_plural ::= "sacrifices" sacrifice_chosen_plural_count filter_plural "of" "their" "choice" sacrifice_chosen_card_type

sacrifice_chosen_plural_count ::= count_plural | number_digits | number_x

/* @sem ObjectFilter::Chosen(CardType) */
sacrifice_chosen_card_type ::= "of" "that" "type"

sacrifice_choice_modifier ::= modifiers | sacrifice_controlled_since_turn_modifier | sacrifice_combat_history_modifier

/* The sacrificing player controls the chosen permanent, providing the
   antecedent for this otherwise ambiguous relative pronoun. */
/* @sem ObjectFilter::State(ControlledSinceTurnBegan) */
sacrifice_controlled_since_turn_modifier ::= "that" "they" "controlled" "since" "the" "beginning" "of" "the" "turn"

/* A player loop applies an independently specified action to each bound player. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_return_to_battlefield}]}}] */
instructions_each_bound_return ::= players_singular bound_return_to_battlefield

/* @sem Operation::Move{objects:$bound_owned_linked_cards, destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
bound_return_to_battlefield ::= "returns" "to" "the" "battlefield" bound_owned_linked_cards

/* @sem Operation::DealDamage{source:$damage_source_ref, recipients:$recipients, amount:$value_twice, preventable:true} */
deal_damage_scaled_value ::= damage_source_ref "deals" value_twice "damage" "to" recipients

/* A replacement may scale the first damage amount while naming its own source
   and recipient. The condition is an independent, composable predicate. */
/* @sem Instruction::[@repeated_damage_actor(Instruction::If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$object_ref_2, recipients:Objects($affected_2), amount:Multiply([Constant(2), $value]), preventable:true}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Objects($affected), amount:$value, preventable:true}}]}})] */
instead_damage_scaled_amount ::= object_ref "deals" "damage" "to" affected "equal" "to" value "." NEWLINE? "if" condition "," object_ref "deals" "twice" "that" "much" "damage" "to" affected "instead"

/* A divided allocation is replaced by a fixed amount to each member of the same target group. */
/* @sem Instruction::[@repeated_damage_actor(Instruction::If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref_2, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:$divided_count, filter:Any, distribute:$number})), amount:$number_2, preventable:true}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:Targets(@last_slot), amount:DistributedShare(@share), preventable:true}}]}})] */
instructions_divided_damage_instead_group ::= damage_source_ref "deals" number "damage" "divided" "as" "you" "choose" "among" divided_count "targets" "." NEWLINE? "if" condition "," "instead" damage_source_ref "deals" number "damage" "to" "each" "of" "those" "permanents" "and" "/" "or" "players"

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:CardType, terms:_{count:Exactly(Constant(1)), options:[]}} */
unrestricted_card_type_choice ::= "card" "type"

/* A named player performs a subject-neutral draw phrase. */
/* @sem @apply($players_singular, $draw_base) */
have_player_draw ::= "have" players_singular draw_base

/* The player loop binds the chooser, graveyard owner and entering controller. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:$bound_graveyard_put}}] */
instructions_each_bound_graveyard_put ::= players_singular bound_graveyard_put

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:$bounded_card_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
bound_graveyard_put ::= "puts" "a" bounded_card_filter "from" "their" "graveyard" "onto" "the" "battlefield"

/* The counted recipients are the result of this exact color-based placement. */
/* @sem Instruction::[Effect{result:@mark, operation:PutChosenCounters{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($creature_subtype, $subtype_plural), ControlledBy(One(AbilityController))])}, choice:OnePerColor(PowerToughness(1, 1))}}, If{condition:Compare{left:CountObjects(Affected(@marked)), test:NumberTest::Compare{comparison:Equal, value:$value}}, then:Program{instructions:$conjoined}, otherwise:Program{}}] */
instructions_color_counter_receipt ::= "for" "each" "color" "," "put" "a" "+" "1" "/" "+" "1" "counter" "on" "a" creature_subtype "you" "control" "of" "that" "color" "." NEWLINE? "if" "you" "put" "+" "1" "/" "+" "1" "counters" "on" value subtype_plural "this" "way" "," conjoined

/* A willing opponent supplies the payer; the selected sacrifice stays a cost. */
/* @sem Operation::PayCost{player:$willing_payment_opponent, cost:$willing_opponent_payment, optional:true} */
optional_willing_choice_payment ::= willing_payment_opponent "may" willing_opponent_payment

willing_opponent_payment ::= chosen_sacrifice_payment | willing_opponent_damage_payment

/* The willing opponent is the actor and the recipient of the damage. */
/* @sem Cost::Cost{parts:[PlayerAction{player:FirstWilling(OpponentsOf(AbilityController)), body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(One(FirstWilling(OpponentsOf(AbilityController)))), amount:$value, preventable:true}}]}}]} */
willing_opponent_damage_payment ::= "have" object_ref "deal" value "damage" "to" "them"

/* The following branch consumes precisely the preceding optional payment. */
/* @sem Instruction::[Effect{result:@mark, operation:$optional_willing_choice_payment}, If{condition:PaymentChosen(@marked), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
instructions_willing_payment_if_done ::= optional_willing_choice_payment "." "if" "a" "player" "does" "," conjoined

/* The destroy producer and its singular before receipt stay in the same scope. */
/* @sem Operation::Destroy{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:$filter_phrase})), regeneration:true} */
destroy_optional_single_target ::= "destroy" "up" "to" "one" "target" filter_phrase

/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(ControllerOf(Result{result:@marked, phase:Before, index:0})), amount:$card_count}}] */
destroyed_receipt_controller_draw ::= "its" "controller" "draws" card_count

/* @sem Instruction::[Effect{result:@mark, operation:$destroy_optional_single_target}, If{condition:ObjectMatches{object:Result{result:@marked, phase:Before, index:0}, filter:$destroyed_single_followup_filter}, then:Program{instructions:$destroyed_receipt_controller_draw}, otherwise:Program{}}] */
instructions_destroy_single_receipt_followup ::= destroy_optional_single_target "." "if" destroyed_single_followup_filter "is" "destroyed" "this" "way" "," destroyed_receipt_controller_draw

destroyed_single_followup_filter ::= destroyed_receipt_an | played_land_a | destroyed_receipt_controlled_or

/* The bound player supplies the controller for the random attachment choice. */
/* @sem Instruction::[ForEachPlayer{players:$players_with_controlled_permanent, binding:0, body:$random_named_copy_attachment}] */
instructions_controlled_player_random_copy ::= "for" players_with_controlled_permanent "," random_named_copy_attachment

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))])}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:CopyNamed{name:$random_copy_card_name, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo(Result{result:@prior, phase:After, index:0})]}}}]} */
random_named_copy_attachment ::= "create" "a" "token" "that's" "a" "copy" "of" "a" "card" "named" random_copy_card_name "and" "attach" "it" "to" "a" filter_phrase "that" "player" "controls" "chosen" "at" "random"

random_copy_card_name ::= card_name_arrest_copy | referenced_card_name

/* @sem String::Arrest */
card_name_arrest_copy ::= "Arrest"

/* The tested card is the single arrival of this specific graveyard-to-hand move. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Move{objects:One($target_card_your_graveyard), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$filter_phrase}, then:$program, otherwise:Program{}}]} */
returned_hand_card_type_program ::= "return" target_card_your_graveyard "to" "your" "hand" "." "if" "that" "card" "is" "a" filter_phrase "card" "," program "."

/* The remaining life is measured for the player who loses it. */
/* @sem Operation::LoseLife{players:@subject, amount:@recipient_value(Recipients::Players(@subject), $life_all_but)} */
lose_life_all_but_base ::= "lose" life_all_but

/* @sem Operation::LoseLife{players:@subject, amount:@recipient_value(Recipients::Players(@subject), $life_all_but)} */
lose_life_all_but_third ::= "loses" life_all_but

/* The second creation inherits the described recipe, with its own count and entry state. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$counter_amount_2, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}}]}}] */
instead_tapped_tokens_attacking ::= "create" counter_amount "tapped" token_recipe "." NEWLINE? "if" condition "," "instead" "create" counter_amount "of" "those" "tokens" "that" "are" "tapped" "and" "attacking"

/* A conditional replacement chooses between two independent ordinary actions. */
/* @prefer always */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:$conjure_named_battlefield}]}, otherwise:Program{instructions:$instead_action}}] */
instead_action_leading_replacement ::= instead_action "." NEWLINE? "if" condition "," "instead" conjure_named_battlefield

/* A player may choose to have a source damage that same player. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$player_ref, cost:Cost{parts:[PlayerAction{player:$player_ref, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(One($player_ref)), amount:$value, preventable:true}}]}}]}, optional:true}}] */
optional_player_have_damage ::= player_ref "may" "have" object_ref "deal" value "damage" "to" "them"

/* @sem Instruction::[...$optional_player_have_damage, If{condition:Not(PaymentChosen(@prior)), then:$program, otherwise:Program{}}] */
clause_declined_player_damage ::= optional_player_have_damage "." "if" "that" "player" "doesn't" "," program

/* The target's controller may choose the source dealing damage to that same player. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:ControllerOf($target_permanent), cost:Cost{parts:[PlayerAction{player:ControllerOf($target_permanent), body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(One(ControllerOf($target_permanent))), amount:$number, preventable:true}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One($target_permanent), regeneration:true}}]}, otherwise:Program{}}] */
clause_destroy_controller_damage_choice ::= "destroy" target_permanent "unless" "its" "controller" "has" "this" "creature" "deal" number "damage" "to" "them"

next_damage_event ::= next_self_damage_event | next_damage_by_object

/* The second quantity replaces the first shield for the same damage recipient,
   damage kind and duration; the conditional checks that announced recipient. */
/* @sem Instruction::[If{condition:$prevention_recipient_condition, then:Program{instructions:[Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:$prevent_to_any_target, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), limit:TotalDamage($value_2), duration:$prevent_duration, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:Target{slot:@last_slot, index:0}, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), limit:TotalDamage($value), duration:$prevent_duration, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}}}]}}] */
instead_recipient_prevention ::= "prevent" "the" "next" value prevent_damage "that" "would" "be" "dealt" "to" prevent_to_any_target prevent_duration "." NEWLINE? "if" prevention_recipient_condition "," "prevent" "the" "next" value "damage" "instead"

/* @sem Condition::ObjectMatches{object:RecipientObject{slot:@last_slot, index:0}, filter:$filter_phrase} */
prevention_recipient_condition ::= "it's" "a" filter_phrase

/* Compose a private-zone population with its retained animation and granted abilities. */
/* @sem Operation::CreatePerpetualEffect{objects:$hand_library_filtered_cards, changes:$perpetual_retained_granted_changes} */
perpetual_filtered_cards_changes ::= hand_library_filtered_cards "perpetually" perpetual_retained_granted_changes

/* @sem Change::[...$retained_plural_animation, ...$perpetual_keyword_abilities] */
perpetual_retained_granted_changes ::= retained_plural_animation "and" "gain" perpetual_keyword_abilities

/* @sem Change::[GrantAbility(Keyword($keyword_value)), GrantAbility(Keyword($keyword_value_2))] */
perpetual_keyword_abilities ::= keyword_value "and" keyword_value

/* The card is the current event or other bound card, resolved by context. */
/* @sem Operation::Move{objects:One($current_card_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]} */
put_current_card_under_control ::= "put" current_card_ref "onto" "the" "battlefield" "under" "your" "control"

/* A controlled creature's keyword condition modifies damage to a creature.
   The repeated operands bind both branches and the excess recipient together. */
/* @sem Instruction::[If{condition:$conditional_excess_test, then:Program{instructions:[Effect{result:@next, operation:DealDamageWith{source:$excess_controlled_creature, recipients:Objects(One($excess_other_creature)), amount:$excess_source_stat, rider:ExcessTo(ControllerOf(Target{slot:1, index:0}))}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Target{slot:0, index:0}, recipients:Objects(One(Target{slot:1, index:0})), amount:$excess_source_stat, preventable:true}}]}}] */
conditional_excess_creature_damage ::= excess_controlled_creature "deals" "damage" "equal" "to" excess_source_stat "to" excess_other_creature "." NEWLINE? "if" conditional_excess_test "," "excess" "damage" "is" "dealt" "to" "that" "creature's" "controller" "instead"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$excess_damage_creature, ControlledBy(One(AbilityController))])}), index:0} */
excess_controlled_creature ::= "target" excess_damage_creature "you" "control"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$excess_damage_creature, $modifier_not_controlled])}), index:0} */
excess_other_creature ::= "target" excess_damage_creature modifier_not_controlled

/* This complete spell owns its two target slots; the phrase itself supplies the instructions. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$conditional_excess_creature_damage}} */
spell_conditional_excess_creature_damage ::= conditional_excess_creature_damage "."

/* The controlled-creature anaphor is scoped to the first target of this spell. */
conditional_excess_test ::= controlled_excess_keyword_test | condition_your_turn | condition_citys_blessing

/* @sem Condition::ObjectMatches{object:Target{slot:0, index:0}, filter:HasKeyword($keyword_value)} */
controlled_excess_keyword_test ::= "the" "creature" "you" "control" "has" keyword_value

/* The possessive names this spell's first target, without introducing another target. */
/* @sem Expr::ObjectProperty{object:Target{slot:0, index:0}, property:$creature_stat, information:CurrentOrLastKnown} */
excess_source_stat ::= "its" creature_stat

/* The program's event-relative operands are scoped to this cast event. */
/* @sem Ability::Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:Spell{event:Cast, players:One(AbilityController), spells:SameObject(Source)}, limits:TriggerLimits{}, announcement:@announcement, body:$cast_event_reveal_take_shuffle})} */
trigger_own_spell_cast_program ::= "when" "you" "cast" "this" "spell" "," cast_event_reveal_take_shuffle

/* Longer serial lists retain each action and the shared subject. */
/* @sem Instruction::[$verb_third, ...$verbs_third_serial_tail] */
verbs_third_serial_chain ::= verb_third "," verbs_third_serial_tail

verbs_third_serial_tail ::= verbs_third_serial_then | verbs_third_serial_chain

/* @sem ObjectFilter::@agree($noun, $noun_2) */
each_same_kind_destroy ::= "for" "each" noun "," "destroy" "that" noun

/* The repeated noun denotes the same iterated kind; each object's payment
   decisions produce the unpaid population consumed by destruction. */
/* @sem Instruction::[ForEachObject{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$each_same_kind_destroy}, binding:0, body:Program{instructions:[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:Bound(0), cost:$controller_life_payment, optional:true}}]}}]}}, Effect{result:@next, operation:Destroy{objects:Unpaid(@marked), regeneration:true}}] */
clause_each_same_object_unless_any_life ::= each_same_kind_destroy "unless" "any" "player" "pays" controller_life_payment

/* An earlier selection is excluded from the stated battlefield population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(InSet(Earlier{what:Selected})), $filter_plural])} */
destroy_other_earlier_selected ::= "all" "other" filter_plural

/* @sem Instruction::[$verb_third, ...$verbs_third_serial_then] */
verbs_third_serial_prefix_then ::= verb_third "," verbs_third_serial_then

/* The chosen pile is the previously selected battlefield population; the
   clause supplies the sacrificing players. */
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:@subject, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:InPile(None)}}) */
sacrifice_chosen_pile_third ::= "sacrifices" "the" "creatures" "in" "their" "chosen" "pile"

/* @sem Operation::DealDamage{source:$self_explicit_ref, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Not(SameObject($self_explicit_ref))})), amount:$number, preventable:true} */
deal_damage_source_other ::= self_explicit_ref "deals" number "damage" "to" "any" "other" "target"

/* @sem Operation::CreatePerpetualEffect{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), changes:$static_changes} */
graveyard_cards_perpetual ::= filter_phrase "cards" "in" "your" "graveyard" "perpetually" static_changes

/* Keep the damage producer and its receipt in one instruction sequence. */
/* @sem Instruction::[Effect{result:@next, operation:$population_damage}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($damage_receipt_plural), changes:[Rule(Prohibit(Regenerate))], duration:$this_duration, evaluation:LiveObjects}}] */
instructions_population_damage_receipt ::= population_damage "." damage_receipt_plural "can't" "be" "regenerated" this_duration

/* @sem Operation::DealDamage{source:$damage_source_ref, recipients:$recipients_objects_and_players, amount:$number, preventable:true} */
population_damage ::= damage_source_ref "deals" number "damage" "to" recipients_objects_and_players

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, DamagedBy(@prior)])} */
damage_receipt_plural ::= filter_plural "dealt" "damage" "this" "way"

/* Both branches retain their current movement operands and antecedents. */
/* @prefer always */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:$instead_leading_destination}, otherwise:Program{instructions:$instead_return_to_your_hand}}] */
instead_moves_leading ::= instead_return_to_your_hand "." NEWLINE? "if" condition "," "instead" instead_leading_destination

instead_leading_destination ::= instead_return_current_card_battlefield | instead_moves_plain

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card_your_graveyard), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instead_return_to_your_hand ::= "return" target_card_your_graveyard "to" "your" "hand"

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:@zone_members(ObjectSet::One($current_card_ref)), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
instead_return_current_card_battlefield ::= "return" current_card_ref "to" "the" "battlefield"

/* The other target excludes the actual attached damage source. */
/* @sem Operation::DealDamage{source:$attached_ref, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Not(SameObject($attached_ref))})), amount:ObjectProperty{object:$attached_ref, property:$stat, information:CurrentOrLastKnown}, preventable:true} */
attached_deals_own_property_other_target ::= attached_ref "deals" "damage" "equal" "to" "its" stat "to" "any" "other" "target"

/* Remove an unrestricted number of counters of any kind from the affected objects. */
/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), amount:Count(AnyNumber)}]} */
remove_any_number_counters ::= "remove" "any" "number" "of" "counters" "from" affected

/* Apply the selected players to the shared token-creation action. */
/* @sem Operation::@apply($announced_all_players, $create_base) */
target_players_each_create ::= announced_all_players "each" create_base

damage_amount ::= number | damage_amount_product

/* @sem Expr::Multiply([$value, $number]) */
damage_amount_product ::= value "times" number

/* A complete per-player payment episode can be selected as either branch. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:$instead_payment_episode_2}, otherwise:Program{instructions:$instead_payment_episode}}] */
instead_leading_payment ::= instead_payment_episode "." NEWLINE? "if" condition "," "instead" instead_payment_episode

instead_payment_episode ::= player_loses_life_unless_cost | player_optional_cost_or_lose_life

/* A time-bounded damage replacement retains its damage kind and redirect recipient. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:Players(One(AbilityController)), kind:$shared_damage_kind, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage($redirect_destination)}}]}} */
all_damage_redirect_you ::= "all" shared_damage_kind "that" "would" "be" "dealt" "to" "you" this_duration "is" "dealt" "to" redirect_destination "instead"

damage_amount_first ::= preferred_sticker_letter_amount | value

/* @prefer always */
/* @sem $sticker_letter_count */
preferred_sticker_letter_amount ::= sticker_letter_count

/* @sem Operation::DealDamage{source:$self_ref_named, recipients:$recipients, amount:$number, preventable:true} */
deal_damage_named_plural ::= self_ref_named "deal" number "damage" "to" recipients

/* The subject of the verb owns the hand being sampled. */
/* @sem Expr::$card_count */
reveal_random_hand_count ::= "reveals" card_count "at" "random" "from" "their" "hand"

/* The conjoined action and random reveal share the printed subject. */
/* @sem Instruction::[Effect{result:@next, operation:@apply($players_singular, $verb_operation_third)}, Effect{result:@next, operation:RevealFromHand{actor:$players_singular, cards:Any, count:$reveal_random_hand_count, at_random:true}}] */
clause_player_action_then_random_reveal ::= players_singular verb_operation_third "," "then" reveal_random_hand_count

/* The fractional loss is evaluated separately for each named player.
   Restrict this reading to a conditional consequence to avoid changing
   standalone third-person loss clauses. */
/* @sem Instruction::[ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(Bound(0)), amount:Divide{numerator:PlayerNumber{player:Bound(0), number:Life}, denominator:Constant(2), rounding:$rounding_words}}}]}}] */
conditional_each_half_life ::= hand_plural_players "loses" "half" "their" "life" "," rounding_words

damage_equal_value ::= value | damage_twice_devoured_count

/* @prefer always */
/* @sem @times(Expr::Constant(2), $damage_devoured_count) */
damage_twice_devoured_count ::= "twice" damage_devoured_count

/* @sem Expr::Earlier{what:Devoured, measure:Count, filter:$filter_plural} */
damage_devoured_count ::= "the" "number" "of" filter_plural "it" "devoured"

damage_receipt_followup ::= conjoined | clause_you_sacrifice_choice

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$sacrifice_choice}] */
clause_you_sacrifice_choice ::= "you" sacrifice_choice

damage_receipt_filter ::= colorless_damage_filter | noncolor_damage_filter

/* @sem ObjectFilter::@and($adjective_noncolor, $noun) */
noncolor_damage_filter ::= adjective_noncolor noun

/* The distributed amount also caps the number of targets in a union. */
/* @sem Operation::DealDamage{source:$damage_source_ref, recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo($number), filter:$plural_and_or, distribute:$number}))), amount:Expr::DistributedShare(@share), preventable:true} */
deal_damage_divided_union ::= damage_source_ref "deals" number "damage" "divided" "as" "you" "choose" "among" "any" "number" "of" "target" plural_and_or

/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:@subject, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:AsManyAsCan($number_words)}) */
sacrifice_choice_plural_base ::= "sacrifice" number_words filter_plural "of" "their" "choice"

/* Explicit action alternatives retain the condition and each branch independently. */
/* @sem Instruction::[If{condition:$instead_front_condition, then:Program{instructions:$instead_front_replacement}, otherwise:Program{instructions:$instead_draw_action}}] */
instead_front_action ::= instead_draw_action "." "if" instead_front_condition "," "instead" instead_front_replacement

instead_front_condition ::= condition | condition_spell_intensity_equal | condition_named_spell_intensity_equal

/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::TakeExtraTurn{}}}] */
instead_front_replacement ::= "take" "an" "extra" "turn" "after" "this" "one"

/* A temporary trigger groups controlled combat damage by damaged player. */
/* The damaged population is tied to the immediately preceding damage action. */
/* @sem Instruction::[Effect{result:@mark, operation:$deal_damage}, Effect{result:@next, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, DamagedBy(@marked)])}, regeneration:true}}] */
instructions_damage_destroy_receipt ::= deal_damage "." NEWLINE? "if" "a" filter_phrase "is" "dealt" "damage" "this" "way" "," "destroy" "it"

/* Conditional replacement tests the referred object in the surrounding ability. */
/* @sem Instruction::[If{condition:$replacement_object_condition, then:Program{instructions:$instead_counters_action_2}, otherwise:Program{instructions:$instead_counters_action}}] */
instead_counters_referred_kind ::= instead_counters_action "." NEWLINE? "if" replacement_object_condition "," instead_counters_action "instead"

/* A conditional replacement repeats both announced damage recipients. */
/* @sem Vec<Instruction>::@unlabelled_instructions($instructions_conditional_split_damage_paragraph) */
instructions_conditional_split_damage ::= instructions_conditional_split_damage_paragraph

/* @sem Ability::@optional_ability_label(Spell{announcement:@announcement, body:Program{instructions:[@repeated_damage_actor(Instruction::If{condition:$condition_had_enter_under, then:Program{instructions:[Effect{result:@next, operation:DealDamageParts{source:$damage_source_ref_2, parts:[_{recipients:$recipients_player_or_walker, amount:$number_3}, _{recipients:$split_controlled_creature_target, amount:$number_4}], preventable:true}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamageParts{source:$damage_source_ref, parts:[_{recipients:Targets(0), amount:$number}, _{recipients:Objects(One(Target{slot:1, index:0})), amount:$number_2}], preventable:true}}]}})]}}, $spell_paragraph_break) */
instructions_conditional_split_damage_paragraph ::= damage_source_ref "deals" number "damage" "to" recipients_player_or_walker "and" number "damage" "to" split_controlled_creature_target "." spell_paragraph_break "if" condition_had_enter_under "," damage_source_ref "deals" number "damage" "to" "that" "player" "or" "planeswalker" "and" number "damage" "to" "that" "creature" "instead"

/* The later creature anaphor names this exact controlled target. */
/* @sem Recipients::Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(PlayerOrControllerOf(Targets(@last_slot))))])}), index:0})) */
split_controlled_creature_target ::= "target" "creature" "that" "player" "or" "that" "planeswalker's" "controller" "controls"

/* The source object and destination are independent current operands. */
/* @sem Operation::Conjure{actor:One(AbilityController), card:Duplicate(One($target_card)), count:$counter_a, destination:$conjure_top_library} */
conjure_duplicate_top_library ::= "conjure" counter_a "duplicate" "of" target_card conjure_top_library

/* Each player chooses one of the printed costs; the action uses that same player. */
/* @sem Cost::Cost{parts:[Choice([$third_sacrifice_choice_cost, $third_discard_cost])]} */
third_sacrifice_or_discard_cost ::= third_sacrifice_choice_cost "or" third_discard_cost

/* @sem Instruction::[ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:Bound(0), cost:$third_sacrifice_or_discard_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:@apply(PlayerSet::One(Bound(0)), $verbs_third)}, otherwise:Program{}}]}}] */
clause_each_unless_that_player_choice ::= hand_plural_players verbs_third "unless" "that" "player" third_sacrifice_or_discard_cost

/* The player returning the permanent chooses it. */
that_player_return_owner_hand ::= that_player_return_owner_actor

/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$that_player, cost:$cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:$that_player_return_owner_hand}, otherwise:Program{}}] */
clause_that_player_action_unless_pay ::= that_player that_player_return_owner_hand "unless" "they" cost

/* Each player's qualifying choice and maximum use that same controlled population. */
/* @sem Instruction::[ForEachPlayer{players:$players_each_opponent, binding:0, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(Bound(0)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(Bound(0))), Property{property:$stat, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))])}, property:$stat, aggregation:Maximum}}}])}, choose:AsManyAsCan(Constant(1))})}]}}] */
shared_each_sacrifice_controlled_extreme ::= players_each_opponent "sacrifices" "a" filter_phrase "they" "control" "with" "the" "greatest" stat

owner_possessive_shuffle_object ::= owner_target_permanent | exchange_stat_holder

/* The named player loses life measured by a live battlefield population. */
/* @sem Operation::LoseLife{players:@subject, amount:$live_battlefield_count} */
lose_live_counted_life ::= "lose" "life" "equal" "to" live_battlefield_count

live_battlefield_count ::= value_number_on_battlefield | controlled_population_definition

/* @sem @apply($players_singular, $lose_live_counted_life) */
have_player_lose_counted_life ::= "have" players_singular lose_live_counted_life

/* The controller may choose to have the named player lose the stated amount of life. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:LoseLife{players:$players_singular, amount:$value}}]}}] */
clause_may_have_player_lose_life ::= "you" "may" "have" players_singular "lose" value "life"

/* The second sentence qualifies the same creature population. */
/* @sem Operation::Destroy{objects:$creatures_except_object, regeneration:false} */
destroy_creatures_except_no_regeneration ::= "destroy" creatures_except_object "." "those" "creatures" "can't" "be" "regenerated"

/* A gendered anaphor identifies the previously mentioned object, whose controller performs the verb. */
/* @sem PlayerSet::One(PlayerRef::ControllerOf($her_ref)) */
her_controller_player ::= her_ref "controller"

/* @sem @apply($her_controller_player, $lose_life_amount) */
her_controller_operation ::= her_controller_player lose_life_amount

/* Quoted abilities retain the granted permanent as their holder. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(KeywordCost{keyword:TurnFaceUp, cards:SameObject(Source), change:Reduce(List([$single_generic_reduction]))})]}) */
quoted_faceup_cost_reduction ::= '"' self_permanent "costs" single_generic_reduction "less" "to" "turn" "face" "up" '"'

/* @sem EventSpec::Object{event:TurnsFaceUp, objects:SameObject(Source)} */
quoted_holder_faceup_event ::= "when" self_permanent "is" "turned" "face" "up"

/* @sem Ability::Triggered{event:$quoted_holder_faceup_event, intervening_if:ObjectMatches{object:Source, filter:$filter_phrase}, limits:_{}, announcement:@announcement, body:$program} */
quoted_intervening_trigger ::= '"' quoted_holder_faceup_event "," "if" "it's" "a" filter_phrase "," program "." '"'

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($affected), changes:[GrantAbility(@holder($quoted_faceup_cost_reduction)), GrantAbility(@holder($quoted_intervening_trigger))], duration:Indefinite, evaluation:Snapshot} */
continuous_quoted_faceup_grants ::= affected "gains" quoted_faceup_cost_reduction "and" quoted_intervening_trigger

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$clause, Effect{result:@next, operation:$continuous_quoted_faceup_grants}]}} */
spell_then_quoted_faceup_grants ::= clause "." "then" continuous_quoted_faceup_grants

/* An alternative move can replace a destroy instruction under the stated condition. */
/* @sem Instruction::[If{condition:$instead_move_condition, then:Program{instructions:$instead_moves_action}, otherwise:Program{instructions:$instead_destroy_action}}] */
instead_destroy_move ::= instead_destroy_action "." NEWLINE? "if" instead_move_condition "," instead_moves_action "instead"

instead_move_condition ::= instead_named_object_kind | condition

/* @prefer always */
/* @sem Condition::ObjectMatches{object:$that_noun, filter:$filter_phrase} */
instead_named_object_kind ::= that_noun "is" "a" filter_phrase

/* Each actor's private library stays bound to that actor through the action. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:$personal_library_action}]}}] */
instructions_personal_library_action ::= players_singular personal_library_action

personal_library_action ::= personal_ante_ordered_cards

/* @sem Operation::Move{objects:$personal_ordered_library_cards, destination:Ante(CardArrival{counters:[], states:[]}), qualifiers:[]} */
personal_ante_ordered_cards ::= "antes" personal_ordered_library_cards

/* Each resolution branch retains its own operation and object reference. */
/* @sem Instruction::[Effect{result:@next, operation:$turn_object_face_up}] */
resolution_turn_face_up ::= turn_object_face_up

/* @sem Instruction::[Effect{result:@next, operation:$resolution_counter_placement}] */
resolution_put_one_counter ::= resolution_counter_placement

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(One($object_ref)), kind:$counter_kind, amount:Constant(1)}]} */
resolution_counter_placement ::= "put" "a" counter_kind "counter" "on" object_ref

/* Bind the excess amount to the immediately preceding damage producer in both directions. */
/* @sem Instruction::[Effect{result:@next, operation:$deal_damage}, Effect{result:@next, operation:$excess_keyword_pump}] */
instructions_damage_excess_keyword_pump ::= deal_damage "." excess_keyword_pump

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[GrantKeyword($keyword_value), Pump{power:ExcessDamage{result:@prior, to:Any}, toughness:$value}], duration:$duration, evaluation:Snapshot} */
excess_keyword_pump ::= affected "gains" keyword_value "and" "gets" "+" "X" "/" "+" value duration "," "where" "X" "is" "the" "amount" "of" "excess" "damage" "dealt" "this" "way"

/* A single any-target damage instruction supplies the recipient of the following change. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:$recipients_any_target, amount:$damage_amount, preventable:true}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(RecipientObject{slot:@last_slot, index:0})), changes:$static_changes, duration:$this_duration, evaluation:LiveObjects}}] */
single_damage_recipient_changes ::= damage_source_ref "deals" damage_amount "damage" "to" recipients_any_target "." "a" "creature" "dealt" "damage" "this" "way" static_changes this_duration

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:$single_damage_recipient_changes}} */
activated_single_damage_recipient_changes ::= cost ":" single_damage_recipient_changes "."

/* The same object leaving or untapping creates a delayed triggered program. */
/* @sem Operation::CreateDelayedTrigger{event:$event_leaves_or_becomes_untapped, start:Immediately, body:$program} */
delayed_leaves_or_untaps_program ::= "when" event_leaves_or_becomes_untapped "," program

/* A named player performs two actions and receives counters. Each verb retains
   the same player; the counter recipient is explicit in the placement. */
/* @sem Instruction::[Effect{result:@next, operation:@apply($players_singular, $verb_operation_third)}, Effect{result:@next, operation:@apply($players_singular, $verb_operation_third_2)}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Players($players_singular), kind:$counter_kind, amount:$value}]}}] */
clause_player_two_actions_gets_counters ::= players_singular verb_operation_third "," verb_operation_third "," "and" "gets" value counter_kind "counters"

/* The counter and its conditional consumer share one receipt. Restricting the
   producer here keeps both recognition and inverse printing tied to countering. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$counter_up_to_one_ability}, If{condition:Compare{left:CountObjects(Matching{objects:Recorded(@last_result), filter:AnyOf([$noun, $noun_2, $noun_3])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Recorded{result:@prior})), changes:[RemoveAllAbilities], duration:WhileOnBattlefield(Source), evaluation:Snapshot}}]}, otherwise:Program{}}]} */
counter_ability_source_loss_program ::= counter_up_to_one_ability "." "if" "an" "ability" "of" "an" noun "," noun "," "or" noun "is" "countered" "this" "way" "," "that" "permanent" "loses" "all" "abilities" "for" "as" "long" "as" "this" "creature" "remains" "on" "the" "battlefield" "."

/* @sem Operation::Counter{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Ability, zones:[Stack]}), count:UpTo(Constant(1)), filter:AnyOf([OnStack(Activated), OnStack(Triggered)])}), index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None} */
counter_up_to_one_ability ::= "counter" "up" "to" "one" "target" "activated" "or" "triggered" "ability"

/* The second damage target excludes the earlier target, independently of the source. */
/* @sem Operation::DealDamage{source:$self_explicit_ref, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Not(SameObject(Target{slot:@last_slot, index:0}))})), amount:$number, preventable:true} */
deal_damage_other_prior_target ::= self_explicit_ref "deals" number "damage" "to" "any" "other" "target"

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:@that_player, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan($counter_amount)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
that_player_return_owner_actor ::= "returns" counter_amount filter_phrase "to" "its" "owner's" "hand"

/* The floor qualifies this reduction, and both numbers remain operands. */
/* @sem Operation::ReduceSpeed{player:@that_opponent, amount:$value, floor:$value_2} */
reduce_opponent_speed_floor ::= "reduce" "that" "opponent's" "speed" "by" value "." "this" "effect" "can't" "reduce" "their" "speed" "below" value

/* The singular destruction and its conditional receipt share one result. */
/* @sem Instruction::[Effect{result:@mark, operation:Destroy{objects:One($target_object), regeneration:true}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:Before, index:0}, filter:$filter_phrase}, then:Program{instructions:[$destroyed_creature_controller_damage]}, otherwise:Program{}}] */
instructions_destroy_creature_death_followup ::= "destroy" target_object "." NEWLINE? "if" "a" filter_phrase "dies" "this" "way" "," destroyed_creature_controller_damage

/* The controller and characteristic refer to the same destruction receipt. */
/* @sem Instruction::Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(One(ControllerOf(Recorded{result:@marked}))), amount:ObjectProperty{object:Recorded{result:@marked}, property:$creature_stat, information:CurrentOrLastKnown}, preventable:true}} */
destroyed_creature_controller_damage ::= object_ref "deals" "damage" "to" "that" "creature's" "controller" "equal" "to" "the" "creature's" creature_stat

/* A scheduled upkeep retains its complete delayed program. */
/* @sem Operation::CreateDelayedTrigger{event:$delayed_your_upkeep, start:Immediately, body:$program} */
delayed_upkeep_program ::= "at" delayed_your_upkeep "," program

/* Each player independently chooses a filtered discard payment; the same
   bound player performs the fallback verb if the payment is declined. */
/* @sem Instruction::[ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:Bound(0), cost:Cost{parts:[$cost_discard_filtered]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:@apply(PlayerSet::One(Bound(0)), $verbs_third)}, otherwise:Program{}}]}}] */
clause_each_unless_filtered_discard ::= hand_plural_players verbs_third "unless" "they" cost_discard_filtered

/* The amount and recipient are independent operands. */
/* @sem Operation::DealDamage{source:$damage_source_ref, recipients:$recipients, amount:$look_where_creature_types, preventable:true} */
deal_damage_defined_creature_types ::= damage_source_ref "deals" "X" "damage" "to" recipients "," "where" "X" "is" look_where_creature_types

/* Count a live object population before using its value. */
countable_object_value ::= value_number_of | value_number_cards | value_number_on_battlefield

/* @sem Expr::$countable_object_value */
counted_object_value ::= "count" countable_object_value

/* @sem Operation::SetLifeTotal{players:One(AbilityController), amount:$counted_object_value} */
set_your_life_total_counted ::= counted_object_value "." "your" "life" "total" "becomes" "that" "number"

/* Both sentences refer to the same plural population. */
/* @sem Operation::Destroy{objects:$objects_other_sharing_color, regeneration:false} */
destroy_shared_color_no_regeneration ::= "destroy" objects_other_sharing_color "." "they" "can't" "be" "regenerated" /* @prefer always */

/* A plural population and its combat relation are shared by destruction forms. */
/* @sem Operation::Destroy{objects:$combat_counterpart_population, regeneration:false} */
destroy_combat_population_no_regeneration ::= "destroy" combat_counterpart_population "." "they" "can't" "be" "regenerated"

/* The exception is a separate population, evaluated for the event player. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($adjective_untapped, $filter_plural, ObjectFilter::ControlledBy(One(EventSubject)), $nonattacking_this_combat, ObjectFilter::Not(AllOf([$filter_plural_2, Not(State(ControlledSinceTurnBegan))])))} */
destroy_event_player_nonattackers_except_new ::= "all" adjective_untapped filter_plural "that" "player" "controls" nonattacking_this_combat "," "except" "for" filter_plural "the" "player" "hasn't" "controlled" "continuously" "since" "the" "beginning" "of" "the" "turn"

/* The sacrifice population and player set repeat the selection domain. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($filter_phrase, $filter_plural), ControlledBy(One(Bound(0)))])}, count:AsManyAsCan($counter_a)}}]}}, Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:All, objects:Unselected(@prior)})}] */
instructions_each_choose_unselected_sacrifice ::= "for" "each" "player" "," "choose" counter_a filter_phrase "that" "player" "controls" "." "each" "player" "sacrifices" "all" filter_plural "they" "control" "not" "chosen" "this" "way"

/* Attachments are chosen from a controlled battlefield population; the host is the event subject. */
/* @sem Operation::AttachChosen{actor:One(AbilityController), attachments:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$attachment_subtype_pair, ControlledBy(One(AbilityController))])}, count:AnyNumber, hosts:One($it_ordinary_pronoun)} */
attach_controlled_subtype_pair_to_event ::= "attach" "any" "number" "of" attachment_subtype_pair "you" "control" "to" it_ordinary_pronoun

/* @sem ObjectFilter::AnyOf([$subtype_plural, $subtype]) */
attachment_subtype_pair ::= subtype_plural "and" subtype

/* Keep the choice and its anaphoric consumer in the same instruction sequence. */
/* @sem Instruction::[Effect{result:@next, operation:$random_attacker_choice}, Effect{result:@next, operation:$random_attacker_destroy}] */
instructions_random_attacker_followup ::= random_attacker_choice "." NEWLINE? random_attacker_destroy

/* The amount measures the spell that caused the enclosing cast trigger. */
/* @sem Operation::DealDamage{source:$damage_source_ref, recipients:$recipients, amount:ObjectProperty{object:EventSubject, property:ColorCount, information:CurrentOrLastKnown}, preventable:true} */
cast_spell_color_damage ::= damage_source_ref "deals" "X" "damage" "to" recipients "," "where" "X" "is" "the" "number" "of" "colors" "that" "spell" "is"

damage_object_condition ::= condition | condition_that_target_color

/* A conditional damage amount selects the measured casting-time object. */
/* @sem Instruction::[@repeated_damage_actor(Instruction::If{condition:$cast_revealed_card, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref_2, recipients:Objects($target_object_set), amount:Earlier{what:Revealed, measure:Of($stat)}, preventable:true}}]}, otherwise:Program{instructions:[If{condition:$cast_chose_permanent, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref_2, recipients:Objects(One(Target{slot:@last_slot, index:0})), amount:Earlier{what:Selected, measure:Of($stat)}, preventable:true}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:Objects(One(Target{slot:@last_slot, index:0})), amount:$number, preventable:true}}]}}]}})] */
instructions_cast_choice_damage ::= damage_source_ref "deals" number "damage" "to" target_object_set "." NEWLINE? "if" cast_revealed_card "or" cast_chose_permanent "as" "you" "cast" "this" "spell" "," damage_source_ref "deals" "damage" "equal" "to" "the" stat "of" "that" "card" "or" "creature" "instead"

/* @sem Ability::Spell{body:Program{instructions:$instructions_cast_choice_damage}, announcement:@announcement} */
spell_cast_choice_damage ::= instructions_cast_choice_damage "."

/* Both alternatives create the same defined token; the condition replaces only its amount. */
/* @sem Instruction::[If{condition:$token_override_condition, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:$single_token_recipe_with}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$single_token_recipe_with}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}] */
instead_single_token_quantity ::= "create" "a" single_token_recipe_with "." "if" token_override_condition "," "create" counter_amount "of" "those" "tokens" "instead"

/* The spell is the source of this conditional instruction. */
/* @prefer always */
/* @sem Condition::ObjectMatches{object:Source, filter:$past_object_predicate} */
token_override_spell_past ::= "this" "spell" "was" past_object_predicate

token_override_condition ::= token_override_spell_past | condition

/* Each return phrase retains its own selection and battlefield controller. */
/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, Chosen(CreatureType)])}), count:UpTo($value), constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}} */
return_chosen_type_up_to ::= "return" "up" "to" value filter_phrase "cards" "of" "that" "type" "from" "your" "graveyard" "to" "the" "battlefield"

/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, Chosen(CreatureType)])}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_chosen_type_all ::= "return" "all" filter_phrase "cards" "of" "that" "type" "from" "your" "graveyard" "to" "the" "battlefield"

/* The damage producer and its single announced recipient stay together. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:$recipients_any_target, amount:$number, preventable:true}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(RecipientObject{slot:@last_slot, index:0})), changes:[Rule(Prohibit(Regenerate))], duration:$this_duration, evaluation:LiveObjects}}] */
single_target_damage_no_regeneration ::= damage_source_ref "deals" number "damage" "to" recipients_any_target "." "a" "creature" "dealt" "damage" "this" "way" "can't" "be" "regenerated" this_duration

/* @sem Ability::Activated{origin:Ordinary, cost:$activation_cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:$single_target_damage_no_regeneration}} */
activated_single_target_damage_no_regeneration ::= activation_cost ":" single_target_damage_no_regeneration "."

/* The target and its combat state belong to the action, independent of any follow-up. */
/* target_unblocked_attacker_becomes_blocked is shared as unblocked_attacker_becomes_blocked. */

/* Select tied leaders independently of the action each one performs. */
/* @sem Instruction::[ForEachPlayer{players:$players_tied_most_controlled, binding:0, body:Program{instructions:[Effect{result:@next, operation:$selected_player_action}]}}] */
instructions_selected_player_action ::= players_tied_most_controlled selected_player_action

selected_player_action ::= selected_player_investigates | selected_player_populates

/* @sem Operation::Keyword{actor:One(Bound(0)), action:KeywordAction::Investigate{}} */
selected_player_investigates ::= "investigates"

/* @sem Operation::Keyword{actor:One(Bound(0)), action:KeywordAction::Populate{}} */
selected_player_populates ::= "populates"

/* A targeted player and the new total are independent operands. */
/* @sem Operation::SetLifeTotal{players:One($target_possessive), amount:$value} */
set_target_life_total ::= target_possessive "life" "total" "becomes" value

/* A single named player performs two actions around a counter placement. */
/* @sem Instruction::[Effect{result:@next, operation:@apply($players_singular, $verb_operation_third)}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Players($players_singular), kind:$counter_kind, amount:$received_counter_amount}]}}, Effect{result:@next, operation:@apply($players_singular, $verb_operation_third_2)}] */
clause_player_actions_around_counter ::= players_singular verb_operation_third "," "gets" received_counter_amount counter_kind "counter" "," "then" verb_operation_third

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:$clause_player_actions_around_counter}} */
activated_player_actions_around_counter ::= cost ":" clause_player_actions_around_counter "."

/* The announced target is also the prior player in this library fraction. */
/* @sem Operation::Mill{players:One($target_player), amount:$target_personal_library_fraction} */
target_personal_library_mill ::= target_player "mills" target_personal_library_fraction

/* @sem Expr::Divide{numerator:CountObjects(Zone{scope:Players{zone:Library, players:One(Prior(That))}, kind:Card, filter:Any}), denominator:Constant(2), rounding:$rounding_words} */
target_personal_library_fraction ::= "half" "their" "library" "," rounding_words

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$target_personal_library_mill}]}} */
triggered_target_personal_library_mill ::= event_clause "," target_personal_library_mill "."

/* Both branches retain their own players, filters, and choice quantities. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:$fraction_sacrifice_plural_as_many}, otherwise:Program{instructions:$plural_sacrifice_choice}}] */
instead_fractional_sacrifice ::= plural_sacrifice_choice "." NEWLINE? "if" condition "," "instead" fraction_sacrifice_plural_as_many

/* @sem Instruction::[Effect{result:@next, operation:@apply($hand_plural_players, $sacrifice_choice_third_plain)}] */
plural_sacrifice_choice ::= hand_plural_players sacrifice_choice_third_plain

/* Bind the graveyard wording to the destroy action that produced the receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Destroy{objects:$destroy_object_set, regeneration:true}}, ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(One(Bound(0))), amount:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0))), OwnedBy($players_singular)])}), preventable:true}}]}}] */
destroy_controlled_receipt_damage ::= "destroy" destroy_object_set "." NEWLINE? object_ref "deals" "damage" "to" players_singular "equal" "to" "the" "number" "of" filter_plural "they" "controlled" "that" "were" "put" "into" "a" "graveyard" "this" "way"

/* A relative combat history qualifies the eligible sacrifice population. */
/* @sem ObjectFilter::AnyOf([Condition(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}), State(BlockedThisTurn)]) */
sacrifice_combat_history_modifier ::= "that" "attacked" "or" "blocked" "this" "turn"

/* Both alternatives refer to the same actor and qualified population; the
   quantities and the condition are independent operands. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:$players_singular, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:ObjectFilter::@and(ObjectFilter::@agree($filter_phrase, $filter_plural), $sacrifice_choice_modifier)}, choose:AsManyAsCan($value)})}]}, otherwise:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:$players_singular, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:ObjectFilter::@and(ObjectFilter::@agree($filter_phrase, $filter_plural), $sacrifice_choice_modifier)}, choose:AsManyAsCan($counter_amount)})}]}}] */
instead_sacrifice_qualified_population ::= players_singular "sacrifices" counter_amount filter_phrase "of" "their" "choice" sacrifice_choice_modifier "." NEWLINE? "if" condition "," "that" "player" "sacrifices" value "of" "those" filter_plural "of" "their" "choice" "instead" /* @prefer always */

/* @prefer always */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instead_sacrifice_qualified_population}} */
spell_instead_qualified_sacrifice ::= instead_sacrifice_qualified_population "."

/* The conditional consumes the before receipt of this optional single-target destruction. */
/* @sem Instruction::[Effect{result:@mark, operation:$destroy_optional_single_target}, If{condition:ObjectMatches{object:Result{result:@marked, phase:Before, index:0}, filter:ControlledBy(One(AbilityController))}, then:Program{instructions:$clause}, otherwise:Program{}}] */
instructions_destroy_optional_prior_control ::= destroy_optional_single_target "." NEWLINE? "if" "you" "controlled" "that" "permanent" "," clause

/* Ordinary object sources for a distributed damage producer in a scoped pair. */
/* @sem Operation::DealDamage{source:$object_ref, recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo($number), filter:$filter_plural, distribute:$number}))), amount:Expr::DistributedShare(@share), preventable:true} */
divided_object_damage_producer ::= object_ref "deals" number "damage" "divided" "as" "you" "choose" "among" "any" "number" "of" "target" filter_plural

/* Replacing blocker declaration with random pile assignment for the stated duration. */
/* @sem Operation::GameEffect{until:$this_duration, effect:Term{family:GameEffect, form:DefendingPlayersChooseCreaturesToDefendAttackersAtRandom}} */
random_blocker_piles_game_effect ::= this_duration "," "instead" "of" "declaring" "blockers" "," "each" "defending" "player" "chooses" "any" "number" "of" "creatures" "they" "control" "and" "divides" "them" "into" "a" "number" "of" "piles" "equal" "to" "the" "number" "of" "attacking" "creatures" "for" "whom" "that" "player" "is" "the" "defending" "player" "." "creatures" "those" "players" "control" "that" "can" "block" "additional" "creatures" "may" "likewise" "be" "put" "into" "additional" "piles" "." "assign" "each" "pile" "to" "a" "different" "one" "of" "those" "attacking" "creatures" "at" "random" "." "each" "creature" "in" "a" "pile" "that" "can" "block" "the" "creature" "that" "pile" "is" "assigned" "to" "does" "so"

/* The previously mentioned event player performs a third-person operation. */
/* @sem @apply(PlayerSet::One(PlayerRef::EventSubject), $create_third) */
operation_event_subject_the_player ::= "the" "player" create_third

/* Scoped damage equal to the triggering spell's mana value to a noncommander target. */
/* @prefer always */
/* @sem $deal_damage_that_spell_mv_noncommander */
deal_damage_that_spell_mv_noncommander_pref ::= deal_damage_that_spell_mv_noncommander

/* @prefer always */
/* @sem Operation::DealDamage{source:$damage_source_ref, recipients:$recipients_any_target_not_commander, amount:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}, preventable:true} */
deal_damage_that_spell_mv_noncommander ::= damage_source_ref "deals" "damage" "equal" "to" "that" "spell's" "mana" "value" "to" recipients_any_target_not_commander

/* Move a single counter of any kind between two objects. */
/* @sem Operation::MoveCounters(_{actor:One(AbilityController), from:$affected, to:$affected_2, amount:One}) */
move_any_one_counter_onto ::= "move" "a" "counter" "from" affected "onto" affected

/* Deals damage equal to counters on this source to a target opponent previously damaged by it. */
/* @sem Operation::DealDamage{source:$self_explicit_ref, recipients:Players(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:SameObject(Source), recipients:Players(One(Bound(0))), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisGame, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}])}), index:0})), amount:CountCounters(_{recipients:Objects(One(Source)), kind:$counter_kind, information:CurrentOrLastKnown}), preventable:true} */
source_deals_counter_damage_previously_damaged_opponent ::= self_explicit_ref "deals" "X" "damage" "to" "target" "opponent" "previously" "dealt" "damage" "by" "it" "," "where" "X" "is" "the" "number" "of" counter_kind "counters" "on" "it"

/* At end of combat this turn, tap and freeze each permanent blocked by a prior target group. */
/* @sem Operation::CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, expires:EndOfTurn, body:Program{instructions:[Effect{result:@next, operation:SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Condition(Compare{left:EventHistory{event:Pair{event:BecomesBlockedBy, objects:SameObject(Candidate), others:InSet(Targets(@last_slot))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number_words}})])}, tapped:true}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Condition(Compare{left:EventHistory{event:Pair{event:BecomesBlockedBy, objects:SameObject(Candidate), others:InSet(Targets(@last_slot))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number_words}}), @agree($filter_phrase, $filter_plural)])}), changes:[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})], duration:DuringControllersNextUntapStep, evaluation:LiveObjects}}]}} */
delayed_end_combat_tap_freeze_blocked_by_targets ::= "at" "this" "turn's" "next" "end" "of" "combat" "," "tap" "each" filter_phrase "that" "was" "blocked" "by" number_words "of" "those" filter_plural "this" "turn" "and" "it" "doesn't" "untap" "during" "its" "controller's" "next" "untap" "step"

/* Conditional discard composes a replacement hand observation and selected-set loss. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:$comma_hand_pick_then_loss}, otherwise:Program{instructions:[Effect{result:@next, operation:@apply($players_singular, $discard_third)}]}}] */
instead_discard_hand_pick ::= players_singular discard_third "." NEWLINE? "if" condition "," "instead" comma_hand_pick_then_loss

/* @sem Instruction::[...$comma_hand_choice, Effect{result:@next, operation:$hand_loss_selected}] */
comma_hand_pick_then_loss ::= comma_hand_choice "," "then" hand_loss_selected

/* Definite (non-X) mill counts for 'have [player] mill' so where-X triggers do not duplicate through program_where/program_where_snapshot. */
/* @sem Operation::Mill{players:$players_singular, amount:$definite_mill_count} */
have_player_mill_count ::= "have" players_singular "mill" definite_mill_count

definite_mill_count ::= card_count_one | definite_mill_many
/* @sem $definite_mill_number */
definite_mill_many ::= definite_mill_number "cards"
definite_mill_number ::= number_words | number_digits

/* Direct where-X optional mill without BindValue snapshot duplication. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Mill{players:$players_singular, amount:$value}}]}}]} */
program_may_have_player_mill_where ::= "you" "may" "have" players_singular "mill" "X" "cards" "," "where" "X" "is" value

/* The whole attack batch supplies the divided total. */
/* @sem Operation::DealDamage{source:$damage_source_ref, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:UpTo(EventAmount), filter:Any, distribute:EventAmount})), amount:Expr::DistributedShare(@share), preventable:true} */
attack_batch_divided_damage ::= damage_source_ref "deals" "that" "much" "damage" "divided" "as" "you" "choose" "among" "any" "number" "of" "targets"

/* One amount is dealt to each of two independently specified recipient groups. */
/* @sem Operation::DealDamage{source:$object_ref, recipients:Union([$recipients, $recipients_2]), amount:$value, preventable:true} */
shared_equal_damage_two_recipients ::= object_ref "deals" "damage" "equal" "to" value "to" recipients "and" "that" "much" "damage" "to" recipients

/* Each player makes an independent survivor choice, followed by counted tapped token creation. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(Bound(0)), $sacrifice_choose_keep_third)}]}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects($affected), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}}] */
instructions_each_choose_keep_you_tapped_tokens ::= players_singular sacrifice_choose_keep_third "." "then" "you" "create" "a" "tapped" token_named_recipe "token" "for" affected

/* @sem Recipients::Players(Matching{binding:0, condition:Not(PlayerState{player:Bound(0), state:$possessed_player_state})}) */
recipients_without_player_state ::= "each" "player" "who" "doesn't" "have" possessed_player_state

/* Direct source-bound damage to players lacking a player state, avoiding damage_source_ref CostObjects duplication. */
/* @sem Operation::DealDamage{source:$object_ref, recipients:$recipients_without_player_state, amount:$value, preventable:true} */
deal_damage_players_without_state ::= object_ref "deals" value "damage" "to" recipients_without_player_state

/* A single color choice applies to both alternatives. Player and object
   recipients retain their separate continuous effects. */
/* @sem Vec<Instruction>::@unlabelled_instructions($instead_chosen_color_protection_group_paragraph) */
instead_chosen_color_protection_group ::= instead_chosen_color_protection_group_paragraph

/* @sem Ability::@optional_ability_label(Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$protection_color_choice}, If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(GrantKeyword(Protection(Objects(_{kind:Any, filter:Chosen(Color)}))))], duration:$duration_2, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($objects_each), changes:[GrantKeyword(Protection(Objects(_{kind:Any, filter:Chosen(Color)})))], duration:$duration_2, evaluation:Snapshot}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_object)), changes:[GrantKeyword(Protection(Objects(_{kind:Any, filter:Chosen(Color)})))], duration:$duration, evaluation:Snapshot}}]}}]}}, $spell_paragraph_break) */
instead_chosen_color_protection_group_paragraph ::= target_object "gains" "protection" "from" protection_color_choice duration "." spell_paragraph_break "if" condition "," "instead" "you" "and" objects_each "gain" "protection" "from" "the" "color" "of" "your" "choice" duration

/* After a preceding move, "Then destroy all other..." covers the remaining matching populations. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:$three_battlefield_other_attached_populations, regeneration:true}}] */
clause_then_destroy_other_attached_populations ::= "then" "destroy" three_battlefield_other_attached_populations

/* @sem Operation::MoveCounters{actor:One(AbilityController), from:One($self_ref_holder), to:One(EventSubject), kind:$counter_kind, amount:One} */
move_holder_counter_to_event_planeswalker ::= "move" "a" counter_kind "counter" "from" self_ref_holder "onto" "that" "planeswalker"

/* The two alternatives share the recipe and entry, but have independent quantities. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$value, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}}]}}] */
instead_tapped_token_quantity_where ::= "create" token_amount "tapped" token_recipe "." NEWLINE? "if" condition "," "instead" "create" "X" "of" "those" "tokens" "," "where" "X" "is" value

/* A targeted player's optional draw determines two independent continuations. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:$target_opponent, cost:Cost{parts:[Draw{count:$number}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$instructions_target_hand_look_cast}, otherwise:$program}]} */
program_target_draw_payment_branches ::= target_opponent "may" "draw" number "cards" "." "if" "they" "do" "," instructions_target_hand_look_cast "." "if" "they" "don't" "," program

/* The counted private-zone cards belong to the player receiving the damage. */
/* @sem Operation::DealDamage{source:$damage_source_ref, recipients:Players(One($player_ref)), amount:CountObjects(Zone{scope:Players{zone:$greatest_card_zone, players:One($player_ref)}, kind:Card, filter:$card_filter}), preventable:true} */
damage_player_private_card_count ::= damage_source_ref "deals" "damage" "to" player_ref "equal" "to" "the" "number" "of" card_filter "cards" "in" "that" "player's" greatest_card_zone

/* A controlled dealer measures its own characteristic before an opposing target. */
/* @sem Operation::DealDamage{source:@move_after_actor($controlled_damage_source), recipients:Objects(One($opposing_union_target)), amount:@damage_actor_value($value), preventable:true} */
controlled_damage_opposing_target ::= controlled_damage_source "deals" "damage" "equal" "to" value "to" opposing_union_target

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([AnyOf([$noun, $noun_2]), ControlledBy(OthersThan(AbilityController))])}), index:0} */
opposing_union_target ::= "target" noun "or" noun "you" "don't" "control"

/* Copy the named source's counters to the stated recipient. */
/* @sem Operation::DuplicateCounters{from:CounterSource::On(Objects(One($named_possessive_ref))), to:Objects(One($counter_transfer_creature)), copies:All} */
source_counters_to_affected ::= "put" named_possessive_ref "counters" "on" counter_transfer_creature

/* The chosen attachment was attached to the named object before it left. */
/* @sem Operation::AttachChosen{actor:One(AbilityController), attachments:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$subtype, WasAttachedTo($self_ref_named)])}, count:Exactly(Constant(1)), hosts:One($counter_transfer_creature)} */
attach_previously_attached_to_named ::= "attach" "an" subtype "that" "was" "attached" "to" self_ref_named "to" counter_transfer_creature

/* This singular anaphor needs an earlier creature in the same ability. */
/* @sem ObjectRef::@qualified_object(ObjectKind::Permanent, ObjectFilter::CardType(Creature)) */
counter_transfer_creature ::= "that" "creature"

/* The subject selects the affected objects before destroying that selection. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$destroy_choice_actor, objects:$affected, count:AsManyAsCan($value)}}, Effect{result:@next, operation:Destroy{objects:Selected(@prior), regeneration:true}}] */
clause_destroy_choice ::= destroy_choice_actor value affected

destroy_choice_actor ::= destroy_choice_you | destroy_choice_player

/* @sem PlayerRef::AbilityController */
destroy_choice_you ::= "you" "destroy"

/* @sem PlayerRef::$player_ref */
destroy_choice_player ::= player_ref "destroys"

/* The triggering player can pay a counter cost to avoid the independently composed program. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:$event_counter_payer_words, cost:$event_player_single_counter_payment, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:$program_plain, otherwise:Program{}}]} */
program_event_counter_payment_fallback ::= program_plain "unless" event_counter_payer_words event_player_single_counter_payment

/* Used only by the matching Equipment-unattachment activation: the earlier
   quantity is the mana value of the Equipment paid in that activation. */
/* @sem Operation::DealDamage{source:Source, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:$divided_count, filter:Any, distribute:Earlier{what:Unattached, measure:Of(ManaValue)}})), amount:DistributedShare(@share), preventable:true} */
unattached_equipment_divided_damage_he ::= "he" "deals" "damage" "equal" "to" "that" "Equipment's" "mana" "value" "divided" "as" "you" "choose" "among" divided_count "targets"

/* The callback is evaluated within the prevention replacement and names its
   own ModifyEvent receipt. Recipients, sources, duration and damage target
   remain independent operands of the composed phrase. */
/* @sem Operation::CreateReplacement{event:Damage{source_kind:Any, sources:$prevent_by_other_sources, recipients:$prevent_callback_recipients, kind:Any, grouping:SourceRecipient, subject:Recipient}, limit:UntilExpired, duration:$this_duration, body:Program{instructions:[Effect{result:@mark, operation:ModifyEvent{change:PreventDamage}}, $prevent_damage_optional_callback]}} */
prevent_filtered_damage_callback ::= "prevent" "all" "damage" "that" "would" "be" "dealt" "to" prevent_callback_recipients this_duration "by" prevent_by_other_sources "." prevent_damage_optional_callback

/* @sem DamageRecipients::ObjectsAndPlayers{objects:ControlledBy(One(AbilityController)), players:One(AbilityController)} */
prevent_callback_recipients ::= "you" "and" "permanents" "you" "control"

/* The condition and amount share the prevention result, never an unrelated
   preceding action. */
/* @sem Instruction::If{condition:Compare{left:Performed(@marked), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref_named, recipients:Objects($target_object_set), amount:Performed(@marked), preventable:true}}]}}]}, otherwise:Program{}} */
prevent_damage_optional_callback ::= "if" "damage" "is" "prevented" "this" "way" "," "you" "may" "have" self_ref_named "deal" "that" "much" "damage" "to" target_object_set

/* Then marks the continuation without changing its optional choice. */
/* @sem $graveyard_return_optional */
clause_then_graveyard_return_optional ::= "then" graveyard_return_optional

/* The host is an announced target; this does not add an anaphoric reading. */
/* @sem Operation::AttachChosen{actor:One(AbilityController), attachments:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$subtype_plural, ControlledBy(One(AbilityController))])}, count:AnyNumber, hosts:One($target_object)} */
attach_controlled_subtype_to_target ::= "attach" "any" "number" "of" subtype_plural "you" "control" "to" target_object

/* Bind the conditional death to the receipt of the preceding creature destruction. */
/* @sem Instruction::[Effect{result:@mark, operation:Destroy{objects:One($death_token_creature_target), regeneration:true}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:Before, index:0}, filter:Any}, then:Program{instructions:$clause_create_death_stated_stats_token}, otherwise:Program{}}] */
instructions_destroy_creature_death_token ::= "destroy" death_token_creature_target "." NEWLINE? "if" "that" "creature" "dies" "this" "way" "," clause_create_death_stated_stats_token

death_token_creature_target ::= unregenerable_target | target_qualified_creature

/* A temporary event trigger can carry a token creation as its own body. */
/* @sem Operation::CreateTrigger{event:$event_clause, duration:$this_duration, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$create_quoted_block_token}]}} */
temporary_event_quoted_token_trigger ::= event_clause this_duration "," create_quoted_block_token

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:$temporary_event_quoted_token_trigger}]}} */
spell_operation_temporary_token_trigger ::= operation "." temporary_event_quoted_token_trigger

/* The holder supplies the property measured for both allocation and target limit. */
/* @sem Operation::DealDamage{source:$self_ref_holder, recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(ObjectProperty{object:$self_ref_holder, property:$creature_stat, information:CurrentOrLastKnown}), filter:$filter_plural, distribute:ObjectProperty{object:$self_ref_holder, property:$creature_stat, information:CurrentOrLastKnown}}))), amount:Expr::DistributedShare(@share), preventable:true} */
deal_damage_self_stat_divided_objects ::= self_ref_holder "deals" "damage" "equal" "to" "its" creature_stat "divided" "as" "you" "choose" "among" "any" "number" "of" "target" filter_plural

/* The target introduction proves both subsequent land references, even if destruction fails. */
/* @sem Instruction::[Effect{result:@mark, operation:Destroy{objects:One($scoped_target_land), regeneration:true}}, If{condition:ObjectMatches{object:$scoped_target_land, filter:$adjective}, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:Players(One(ControllerOf($scoped_target_land))), amount:$number, preventable:true}}]}, otherwise:Program{}}] */
clause_destroy_land_controller_damage ::= "destroy" scoped_target_land "." NEWLINE? "if" "that" "land" "was" adjective "," damage_source_ref "deals" number "damage" "to" "the" "land's" "controller"

/* @sem Count::Exactly(Expr::AnnouncedX) */
divided_exact_x ::= "X"

/* The threatened target is also the subject whose damage is removed. */
/* @sem Operation::CreateReplacement{event:Object{event:Destroyed, objects:SameObject($target_object)}, limit:NextOccurrence, duration:$this_duration, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::RemoveAllDamage{object:EventSubject}}}]}} */
next_destruction_remove_damage ::= "the" "next" "time" target_object "would" "be" "destroyed" this_duration "," "remove" "all" "damage" "marked" "on" "it" "instead"

/* The action and historical population remain independent. */
/* @sem Operation::SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, Condition(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})])}, tapped:true} */
tap_all_that_attacked ::= "tap" "all" filter_plural "that" "attacked" "this" "turn"

/* A conditional replacement repeats the named source and the announced permanent;
   scry belongs only to the replacement branch. */
/* @sem Instruction::[If{condition:$damage_scry_condition, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One($target_permanent)), amount:$number_2, preventable:true}}, Effect{result:@next, operation:Scry{players:One(AbilityController), amount:$number_3}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Target{slot:@last_slot, index:0})), amount:$number, preventable:true}}]}}] */
instead_target_damage_scry ::= SELF_NAME "deals" number "damage" "to" target_permanent "." "if" damage_scry_condition "," "instead" "it" "deals" number "damage" "to" "that" "permanent" "and" "you" "scry" number

damage_scry_condition ::= damage_scry_bargained | condition

/* @prefer always */
/* @sem Condition::ObjectMatches{object:Source, filter:State(Bargained)} */
damage_scry_bargained ::= "this" "spell" "was" "bargained"

/* The vote recipient and the performer are the same bound player. */
/* @sem Instruction::[ForEachPlayer{players:Matching{binding:0, condition:PlayerState{player:Bound(0), state:ReceivedAVote}}, binding:0, body:Program{instructions:[Effect{result:@next, operation:$voted_player_action}]}}] */
instructions_voted_player_action ::= "each" "player" voted_player_action

voted_player_action ::= voted_player_draw | voted_player_discard | voted_player_mill

/* @sem Operation::Draw{players:One(Bound(0)), amount:$bound_received_vote_count} */
voted_player_draw ::= "draws" "a" "card" "for" "each" bound_received_vote_count

/* @sem Operation::Discard{players:One(Bound(0)), amount:$bound_received_vote_count, random:false} */
voted_player_discard ::= "discards" "a" "card" "for" "each" bound_received_vote_count

/* @sem Operation::Mill{players:One(Bound(0)), amount:$bound_received_vote_count} */
voted_player_mill ::= "mills" "a" "card" "for" "each" bound_received_vote_count

/* @sem Expr::Votes(Player(Bound(0))) */
bound_received_vote_count ::= "vote" "they" "received"

/* @prefer always */
/* @sem Instruction::[@repeated_damage_actor(Instruction::If{condition:$damage_recipient_type_pair, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$it_ordinary_pronoun, recipients:$recipients_any_target, amount:$number_2, preventable:true}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:Targets(@last_slot), amount:$number, preventable:true}}]}})] */
instructions_damage_recipient_instead ::= damage_source_ref "deals" number "damage" "to" recipients_any_target "." it_ordinary_pronoun "deals" number "damage" "instead" "if" damage_recipient_type_pair

/* This condition is scoped to the immediately preceding any-target damage. */
/* @sem Condition::ObjectMatches{object:RecipientObject{slot:@last_slot, index:0}, filter:@or($noun, $noun_2)} */
damage_recipient_type_pair ::= "that" "target" "is" "a" noun "or" noun

/* One announced damage recipient can be referenced by a subsequent sentence. */
/* damage_single_any_target is shared as single_target_damage. */

/* Keep the damage producer and both consumers in one scope; the two noun
   phrases must describe the same population. */
/* @sem Instruction::[Effect{result:@mark, operation:$deal_damage}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($filter_phrase, $filter_phrase_2), DamagedBy(@marked)])}), changes:$change_loses_keyword, duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateReplacement{event:ZoneChange{objects:AllOf([@agree($filter_phrase, $filter_phrase_2), DamagedBy(@marked)]), from:Battlefield, to:Graveyard}, limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}}}] */
instructions_damage_loss_die_exile ::= deal_damage "." "if" "a" filter_phrase "is" "dealt" "damage" "this" "way" "," "it" change_loses_keyword duration "." "if" "that" filter_phrase "would" "die" this_duration "," "exile" "it" "instead"

/* A pair of spent mana scales both pump operands; keyword grants remain independent. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($affected), changes:[Pump{power:@times($signed, $spent_pair_count), toughness:@times($signed_2, $spent_pair_count)}, GrantKeyword($keyword_value), GrantKeyword($keyword_value_2)], duration:$duration, evaluation:Snapshot} */
spent_pair_pump_keywords ::= spent_pair_count "," affected "gets" signed "/" signed "and" "gains" keyword_value "and" keyword_value duration

/* The selected permanent and comparison population share both types and controller. */
/* @sem Instruction::[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One($target_opponent), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:Extreme{among:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([AnyOf([@agree($noun, $plural), @agree($noun_2, $plural_2)]), ControlledBy(One($target_opponent))])}, property:$stat, highest:true}}, choose:AsManyAsCan(Constant(1))})}] */
clause_opponent_sacrifice_extreme_union ::= target_opponent "sacrifices" "a" noun "or" noun "they" "control" "with" "the" "greatest" stat "among" plural "and" plural "they" "control"

/* Each player decides separately; the fallback retains that player as actor. */
/* @sem Instruction::[ForEachPlayer{players:$loop_player_population, binding:0, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:Bound(0), cost:$resolving_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(Bound(0)), $sacrifice_choice_third_plain)}]}, otherwise:Program{}}]}}] */
clause_loop_sacrifice_unless_pay ::= loop_player_population sacrifice_choice_third_plain "unless" "they" "pay" resolving_cost

/* A referenced permanent's controller performs the keyword action. */
/* @sem @apply(PlayerSet::One($its_controller), $controller_keyword_third) */
referenced_controller_keyword ::= its_controller controller_keyword_third

/* @sem Operation::Keyword{actor:@subject, action:KeywordAction::Investigate{}} */
controller_keyword_third ::= "investigates"

damage_single_recipients ::= damage_existing_recipients | damage_qualified_attacker_recipients

