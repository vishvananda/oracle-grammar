/* Distributing any stated number of stickers across any number of owned permanents. */
/* @sem Operation::PutStickers(_{actor:One(AbilityController), kind:$sticker_kind, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, OwnedBy(One(AbilityController))])}, amount:$value, any_number:true}) */
