/* The damage action and its resulting damaged population remain adjacent. */
/* @sem Instruction::[Effect{result:@next, operation:$damage_any_target_shared}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($damage_receipt_singular), changes:[Rule(Prohibit(Regenerate))], duration:$this_duration, evaluation:LiveObjects}}] */
