count_source_her_counters ::= "the" "number" "of" counter_kind "counters" "on" "her"

/* The counter placement precedes the choice of loss quantity. The two printed
   alternatives still apply a single loss to the same announced target. */
/* @sem Instruction::[Effect{result:@next, operation:$put_counters_direct}, If{condition:$condition, then:_{instructions:[Effect{result:@next, operation:LoseLife{players:One($target_opponent),amount:$value_2}}]}, otherwise:_{instructions:[Effect{result:@next, operation:LoseLife{players:One($target_opponent),amount:$value}}]}}] */
instructions_put_counters_then_loss_alternative ::= put_counters_direct "." target_opponent "loses" value "life" "." "that" "player" "loses" value "life" "instead" "if" condition

/* The followup tests cards actually drawn, including any replacement. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:Draw{players:One(AbilityController), amount:@written_x($value)}}, If{condition:Compare{left:Performed(@marked), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:Discard{players:One(AbilityController), amount:$card_count}}]}, otherwise:Program{}}]}}] */
instructions_optional_draw_receipt_discard ::= "you" "may" "draw" "X" "cards" "," "where" "X" "is" value "." "if" "you" "draw" "one" "or" "more" "cards" "this" "way" "," "discard" card_count

/* Declining the optional discard leaves its observed subset empty. All later
