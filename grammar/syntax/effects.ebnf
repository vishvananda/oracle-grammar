source_his_power_damage_other ::= self_ref_named "deals" "damage" "equal" "to" "his" "power" "to" self_damage_other_target

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($destroy_non_qualifier, ObjectFilter::CardType(Creature))}), index:0} */
destroy_target_non_type_creature ::= "target" destroy_non_qualifier "creature"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($destroy_non_qualifier, $destroy_non_qualifier_2, ObjectFilter::CardType(Creature))}), index:0} */
destroy_target_two_non_types_creature ::= "target" destroy_non_qualifier "," destroy_non_qualifier "creature"

destroy_non_qualifier ::= adjective_nontype | non_black

/* The added creature type and scoped definition persist with the existing types. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_ref)), changes:[AddCardType(Creature), CreatureTypes{mode:Add, types:Listed($becomes_types)}, GrantAbility(@holder($granted_creature_definition))], duration:Indefinite, evaluation:Snapshot} */
indefinite_self_creature_defining_grant ::= self_ref "becomes" "a" becomes_types "creature" "in" "addition" "to" "its" "other" "types" "and" "gains" '"' granted_creature_definition '"'

/* A granted definition belongs to the newly animated holder, not an intrinsic CDA. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(One(Source)), changes:[SetPower($value), SetToughness($value)]} */
granted_creature_definition ::= "this" "creature's" "power" "and" "toughness" "are" "each" "equal" "to" value "."

/* The spell controller copies and may select new targets for that copy. */
