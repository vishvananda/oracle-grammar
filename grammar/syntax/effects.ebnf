/* Draw replacements may alter the tally, so inspect the draw receipt. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Draw{players:One(AbilityController), amount:$card_count_for_every_group}}, If{condition:Compare{left:Performed(@marked), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, then:_{instructions:$clause}, otherwise:_{}}]} */
program_draw_group_then_counted ::= "draw" card_count_for_every_group "." "if" "you" "draw" number "or" "more" "cards" "this" "way" "," clause "."

/* Evaluate the condition before doing either alternative. */
/* @sem Instruction::[If{condition:$condition_feminine_power_at_least, then:Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(AbilityController), $draw_base)}]}, otherwise:Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(AbilityController), $surveil_base)}]}}] */
instead_surveil_draw ::= surveil_base "." "if" condition_feminine_power_at_least "," "instead" draw_base

/* Both counter reads use the source after the earlier counter placement. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$put_counters_direct}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$count_source_her_counters}}, If{condition:Compare{left:CountCounters{recipients:Objects(One(Source)), kind:$counter_kind, information:CurrentOrLastKnown}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, then:_{instructions:[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:One(Source)}}]}, otherwise:_{}}]} */
program_feminine_counter_draw_sacrifice ::= put_counters_direct "," "then" "draw" "X" "cards" "," "where" "X" "is" count_source_her_counters "." "then" "if" "she" "has" number "or" "more" counter_kind "counters" "on" "her" "," "sacrifice" "her" "."

