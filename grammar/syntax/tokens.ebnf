/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:$aura_curse_token_name, colors:$token_colors, supertypes:[Legendary], card_types:[Enchantment], subtypes:$token_subtypes, abilities:[$enchant_player, @holder($replacement_enchanted_life_factor)]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[AttachedToPlayer($aura_player_target)]}}}] */
