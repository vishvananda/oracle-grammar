token_defined_x_tapped ::= "X" "tapped" token_recipe "," "where" "X" "is" token_x_prior_counters

/* @sem Expr::CountCounters(_{recipients:Objects($affected), information:CurrentOrLastKnown}) */
token_x_prior_counters ::= "the" "number" "of" "counters" affected "had" "on" "it"

/* The definition of X supplies the amount independently of the token recipe. */
