token_recipe_basic_land_named_plural ::= token_colors "land" "tokens" "named" land_token_name "that" "are" "every" "basic" "land" "type"

land_token_name ::= land_token_name_everywhere | created_token_name

/* @sem String::'Everywhere' */
land_token_name_everywhere ::= "Everywhere"

/* A copied controlled permanent is the target of this token recipe. */
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ControlledBy(One(AbilityController))])}), index:0}, exceptions:[]}} */
controlled_target_copy_token ::= "token" "that's" "a" "copy" "of" "target" noun "you" "control"

/* The delayed sacrifice consumes the receipt of this particular creation. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[$controlled_target_copy_token], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_move_any_end, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(@marked)})}]}}}]} */
program_attacking_copy_sacrifice ::= "create" "a" "tapped" "and" "attacking" controlled_target_copy_token "." "sacrifice" "the" "token" "at" delayed_move_any_end

/* The entry payment determines both characteristics of this token recipe. */
/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[Game(LifePaid), Game(LifePaid)]}) */
token_recipe_life_paid_entry ::= "X" "/" "X" token_colors token_subtypes token_types "token" "," "where" "X" "is" "the" "life" "paid" "as" "this" "artifact" "entered"

chosen_creature_token ::= chosen_creature_token_fixed | chosen_creature_token_counter_stats

/* @prefer always */
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:FromSubtypes, chosen_color:true, chosen_creature_type:true, card_types:[Creature], power_toughness:[$token_stat, $token_stat_2]}} */
chosen_creature_token_fixed ::= "a" token_stat "/" token_stat "creature" "token" "of" "the" "chosen" "color" "and" "type"

/* A single X definition supplies both statistics, retaining its current counter operands. */
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:FromSubtypes, chosen_color:true, chosen_creature_type:true, card_types:[Creature], power_toughness:[$activation_counter_count, $activation_counter_count]}} */
chosen_creature_token_counter_stats ::= counter_amount "X" "/" "X" "creature" "token" "of" "the" "chosen" "color" "and" "type" "," "where" "X" "is" activation_counter_count

/* The definition supplies both statistics of the created token. */
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[Multiply([$value, $value_2]), Multiply([$value, $value_2])]}} */
token_variable_square_product ::= "an" "X" "/" "X" token_colors token_subtypes token_types "token" "," "where" "X" "is" value "times" value

/* A later temporary grant refers to the preceding created object. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($created_gains_subject), changes:$grants, duration:$duration, evaluation:Snapshot}}] */
clause_created_gains_duration ::= created_gains_subject "gains" grants duration

