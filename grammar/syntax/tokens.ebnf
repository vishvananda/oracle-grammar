/* The population is supplied by the ordinary affected-set grammar. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:CopyEach{objects:$affected, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_copy_affected_permanent ::= "for" affected "," "create" counter_amount "token" "that's" "a" "copy" "of" "that" "permanent"

/* Token amount counts mana symbols in the current population. */
/* @sem TokenSpec::TokenSpec{amount:CountManaSymbols{objects:$affected, colors:[$token_color]}, words:CreatingEffect, recipe:$token_recipe} */
token_defined_mana_each ::= "a" token_recipe "for" "each" token_color "mana" "symbol" "in" "the" "mana" "costs" "of" affected

/* @sem TokenName::Explicit(Angelo) */
explicit_token_angelo ::= "Angelo"

/* A spell's mana value supplies the quantity, independently of the recipe. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_spell_mana_value_third ::= "creates" "X" token_recipe "," "where" "X" "is" "the" "spell's" "mana" "value"

/* Vibranium has its own intrinsic artifact ability and restriction. */
/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Vibranium], abilities:[Keyword(Indestructible), @scope(Ability::Activated{origin:Ordinary, cost:_{parts:[TapSymbol]}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:Amount{color:Colorless, amount:Constant(1)}, restriction:Not(CastSpell(Not(CardType(Artifact))))}}]}})]} */
tn_vibranium ::= "Vibranium"

/* A leading, independently measured amount applies to one tapped named token. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:$count_each_mana_source, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}) */
create_each_named_tapped_mana ::= "for" "each" count_each_mana_source "," "create" "a" "tapped" token_named_recipe "token"

/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:[White, Blue, Black, Red, Green], card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2], abilities:$token_abilities}) */
token_recipe_all_colors_with ::= token_stat "/" token_stat token_subtypes token_types "token" "with" token_abilities "that's" "all" "colors"

/* @sem String::'Carnivore' */
created_name_carnivore ::= "Carnivore"

/* The plural subject identifies the preceding creation batch; the rule lasts while the source remains. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($created_tokens_goaded_subject), changes:[Rule(GoadedBy(AbilityController))], duration:WhileOnBattlefield(Source), evaluation:LiveObjects}}] */
clause_created_tokens_goaded ::= created_tokens_goaded_subject "are" "goaded" "for" "as" "long" "as" "this" "Saga" "remains" "on" "the" "battlefield"

/* @sem ObjectSet::@created_reference */
created_tokens_goaded_subject ::= "the" "tokens"

/* A final quoted intrinsic ability contains its own full stop. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:@token_abilities($token_recipe_plain, $chapter_quoted_token_abilities)}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]} */
chapter_quoted_token_program ::= "create" token_amount token_recipe_plain "with" chapter_quoted_token_abilities

chapter_quoted_token_abilities ::= chapter_token_attack_abilities | chapter_other_quoted_abilities

/* Named token identities are independent of their characteristics. */
/* @sem String::'Minor Demon' */
created_name_minor_demon ::= "Minor" "Demon"

/* @sem String::'Kelp' */
created_name_kelp ::= "Kelp"

/* @sem String::'Ballistic Boulder' */
created_name_ballistic_boulder ::= "Ballistic" "Boulder"

/* Colors may follow the description of the token. */
/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2]}) */
token_recipe_post_colors ::= token_stat "/" token_stat token_subtypes token_types "token" "that's" token_colors

/* Singular copy descriptions can take a singular entry-state clause. */
/* @sem TokenSpec::TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:[]}} */
token_copy_singular ::= token_copy_single object_ref

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[$token_copy_singular], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_copy_singular_attacking ::= "create" token_copy_singular "and" "that's" "tapped" "and" "attacking"

/* The following sentence describes the intrinsic abilities of this batch. */
/* @sem TokenSpec::TokenSpec{amount:$value, words:CreatingEffect, recipe:@token_abilities($token_recipe_base, $token_abilities_after)} */
token_defined_equal_after ::= "a" "number" "of" token_recipe_base "equal" "to" value token_abilities_after

/* A singular token recipe, used when one token is created per occurrence. */
/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2]}) */
singular_counted_token_recipe ::= token_stat "/" token_stat token_colors token_subtypes token_types "token"

/* The pronoun is valid only within the source-regeneration trigger below. */
/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:ObjectProperty{object:Source, property:RegenerationsThisTurn, information:CurrentOrLastKnown}, words:CreatingEffect, recipe:$singular_counted_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
create_for_source_regenerations ::= "create" "a" singular_counted_token_recipe "for" "each" "time" "it" "regenerated" "this" "turn"

/* @sem TokenRecipe::Defined{name:Explicit(Walker), colors:[Black], card_types:[Creature], subtypes:[Zombie], power_toughness:[Constant(2), Constant(2)]} */
tn_walker ::= "Walker"

/* Coin-outcome counts apply to the complete token recipe. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[_{amount:CountCoinOutcomes{source:CoinCountSource::Latest, outcome:Won}, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_coin_wins_attacking ::= "for" "each" "flip" "you" "win" "," "create" "a" token_recipe "that's" "tapped" "and" "attacking"

/* Both receipt references are scoped to their mill and exile producers. */
/* @sem Instruction::[Effect{result:@next, operation:Mill{players:All, amount:$card_count_many}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@prior, phase:After}, filter:$filter_phrase}, count:UpTo($count_plural)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[Aggregate{objects:Transition{result:@prior, phase:After}, property:$receipt_stat, aggregation:Sum}, Aggregate{objects:Transition{result:@prior, phase:After}, property:$receipt_stat, aggregation:Sum}]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
instructions_mill_exile_stat_token ::= "each" "player" "mills" card_count_many "." "exile" "up" "to" count_plural filter_phrase "cards" "put" "into" "graveyards" "this" "way" "." "create" counter_amount "X" "/" "X" token_colors token_subtypes token_types "token" "," "where" "X" "is" "the" "total" receipt_stat "of" "the" "cards" "exiled" "this" "way"

/* The delayed sacrifice refers to the tokens created by this instruction. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$linked_copy_added_type}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(@marked)})}]}}}] */
clause_linked_copy_combat_cleanup ::= "create" "a" "tapped" "and" "attacking" linked_copy_added_type "." "sacrifice" "that" "token" "at" "end" "of" "combat"

/* @sem TokenRecipe::Copy{object:Query{objects:Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}, index:0}, exceptions:[CopyException::AddCreatureTypes([@subtype_name($creature_subtype)])]} */
linked_copy_added_type ::= "token" "that's" "a" "copy" "of" "the" "exiled" "card" "," "except" "it's" "an" creature_subtype "in" "addition" "to" "its" "other" "types"

/* A separate Aura is attached to each announced creature. Its following sentence
   describes intrinsic abilities of those tokens, not a later grant. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[$attached_aura_each]}} */
attached_aura_each_spell ::= attached_aura_each

/* @sem Instruction::ForEachObject{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:$target_up_to, filter:CardType(Creature)})), binding:0, body:Program{instructions:[Effect{result:@next, operation:$attached_aura_creation}]}} */
attached_aura_each ::= "for" "each" "of" target_up_to "target" "creatures" "," attached_aura_creation

/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:Explicit('Smoke Blessing'), colors:[$token_color], card_types:[Enchantment], subtypes:[Aura], abilities:[Enchant{hosts:Permanents(CardType(Creature))}, $attached_aura_death_trigger]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo(Bound(0))]}} */
attached_aura_creation ::= "create" "a" token_color "Aura" "enchantment" "token" "named" "Smoke" "Blessing" "attached" "to" "that" "creature" "." "those" "tokens" "have" "enchant" "creature" "and" '"' attached_aura_death_trigger '"'

/* @sem Ability::@scope(Ability::Triggered{event:ZoneChange{objects:SameObject(AttachedTo(Source)), from:Battlefield, to:Graveyard}, limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:EventSubject, recipients:Players(One(ControllerOf(EventSubject))), amount:$number_digits, preventable:true}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}) */
attached_aura_death_trigger ::= "when" "enchanted" "creature" "dies" "," "it" "deals" number_digits "damage" "to" "its" "controller" "and" "you" "create" "a" token_named_recipe "token" "."

/* @sem Expr::CountCounters{recipients:Objects($affected), kind:$counter_kind, information:CurrentOrLastKnown} */
leading_count_object_counter ::= counter_kind "counter" "on" affected

/* Named rules tokens retain their intrinsic name separately from created recipes. */
/* @sem TokenRecipe::Named('Feroz''s Ban') */
tn_feroz_ban ::= "Feroz's" "Ban"

/* Named legendary recipes retain their own abilities and holder scopes. */
/* @sem TokenName::Explicit('Tamiyo''s Notebook') */
notebook_token_name ::= "Tamiyo's" "Notebook"

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$cast_spells_filter, modifier:$spell_cost_change})]}) */
quoted_spell_cost_no_period ::= cast_spells_filter "you" "cast" "cost" spell_cost_change "to" "cast"

/* @sem Ability::[@holder($quoted_spell_cost_no_period), $token_quoted_sentence] */
quoted_cost_and_sentence ::= '"' quoted_spell_cost_no_period '"' "and" token_quoted_sentence

/* @sem TokenSpec::TokenSpec{amount:$counter_a, words:CreatingEffect, recipe:Defined{name:$notebook_token_name, supertypes:[Legendary], colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, abilities:$quoted_cost_and_sentence}} */
named_legendary_scoped_token ::= notebook_token_name "," counter_a "legendary" token_colors token_subtypes token_types "token" "with" quoted_cost_and_sentence

/* A following sentence describes intrinsic abilities of the attached token. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$counter_a, words:CreatingEffect, recipe:Defined{name:Explicit(Mask), colors:$token_colors, card_types:[Enchantment], subtypes:[Aura], abilities:[$enchant_permanents, $bare_umbra_armor]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo($object_ref)]}}}] */
instructions_named_attached_aura ::= "create" counter_a token_colors "Aura" "enchantment" "token" "named" "Mask" "attached" "to" object_ref "." "the" "token" "has" enchant_permanents "and" bare_umbra_armor

/* Exile and the conditional copy share the attempted target and its before receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One($object_ref), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:Before, index:0}, filter:Not($filter_phrase)}, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:$copy_colored_creature_keyword}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{}}] */
instructions_exile_conditional_modified_copy ::= "exile" object_ref "." "if" "it" "wasn't" "an" filter_phrase "," "create" "a" "token" "that's" "a" "copy" "of" "it" "," "except" copy_colored_creature_keyword

/* @sem Vec<CopyException>::[SetPowerToughness{power:$token_stat, toughness:$token_stat_2}, Colors{mode:Set, colors:Listed([$token_color])}, AddCreatureTypes($token_subtypes), AddCardTypes([Creature]), AddAbilities([Keyword($keyword_value)])] */
copy_colored_creature_keyword ::= "it's" "a" token_stat "/" token_stat token_color token_subtypes "creature" "with" keyword_value "in" "addition" "to" "its" "other" "types"

/* The inner final period closes the enclosing creation sentence. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$named_legendary_scoped_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
instructions_named_legendary_scoped ::= "create" named_legendary_scoped_token

/* Token names are independent of their colors, creature types, and statistics. */
/* @sem TokenName::Explicit(Mowu) */
explicit_token_mowu ::= "Mowu"

/* @sem TokenName::Explicit('Primo, the Indivisible') */
explicit_token_primo ::= "Primo" "," "the" "Indivisible"

/* @sem TokenName::Explicit('Scion of the Deep') */
explicit_token_scion_deep ::= "Scion" "of" "the" "Deep"

/* The creation occurs only if both choices exist. The two statistics remain independent. */
/* @sem Instruction::[If{condition:AllOf([ValueChosen(Color), ValueChosen(CreatureType)]), then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:FromSubtypes, chosen_color:true, chosen_creature_type:true, card_types:[Creature], power_toughness:[$token_stat, $token_stat_2]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{}}] */
instructions_chosen_creature_token ::= "create" "a" token_stat "/" token_stat "creature" "token" "of" "the" "chosen" "color" "and" "type"

/* A named artifact token carries its own scoped activated ability. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$token_amount, words:CreatingEffect, recipe:$named_artifact_quoted_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
instructions_named_artifact_token_quoted ::= "create" token_amount named_artifact_quoted_recipe

/* @sem TokenRecipe::Defined(_{name:Explicit('Etherium Cell'), card_types:[Artifact], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program})]}) */
named_artifact_quoted_recipe ::= "colorless" "artifact" "token" "named" "Etherium" "Cell" "with" '"' cost ":" program "." '"'

/* The trailing definition supplies the amount, independently of the token recipe. */
/* @sem TokenSpec::TokenSpec{amount:$graveyard_hand_library_history, words:CreatingEffect, recipe:$token_recipe} */
token_history_x_tapped ::= "X" "tapped" token_recipe "," "where" "X" "is" graveyard_hand_library_history

/* The X definition supplies the amount while the recipe remains independently composable. */
/* @sem TokenSpec::TokenSpec{amount:$token_damage_x_amount, words:CreatingEffect, recipe:$token_recipe} */
token_defined_damage_x ::= "X" token_recipe "," "where" "X" "is" token_damage_x_amount

/* @sem TokenSpec::TokenSpec{amount:$token_damage_x_amount, words:CreatingEffect, recipe:$token_recipe_quoted_comma} */
token_defined_damage_x_quoted ::= "X" token_recipe_quoted_comma "where" "X" "is" token_damage_x_amount

/* @sem TokenRecipe::@token_abilities($token_recipe_base, $token_comma_abilities) */
token_recipe_quoted_comma ::= token_recipe_base "with" token_comma_abilities

/* @sem Ability::[$token_comma_static] */
token_comma_abilities ::= token_comma_static

/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:$static_changes} */
token_comma_static ::= '"' affected static_changes "," '"' 

token_damage_x_amount ::= token_damage_opponents | token_damage_object

/* @sem Expr::EventHistory{event:Damage(_{source_kind:Any, sources:Any, recipients:Players(OpponentsOf(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:TotalAmount} */
token_damage_opponents ::= "the" "damage" "dealt" "to" "your" "opponents" "this" "turn"

/* @sem Expr::EventHistory{event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject($object_ref)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:TotalAmount} */
token_damage_object ::= "the" "amount" "of" "damage" "dealt" "to" object_ref "this" "turn"

/* Keep the payment and its created token's grant and delayed exile in one branch. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$pay_mana, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[$conditional_token_creation, $conditional_token_grant, $scoped_token_exile_end]}, otherwise:Program{}}]} */
scoped_paid_token_program ::= "you" "may" pay_mana "." "if" "you" "do" "," conditional_token_creation "." conditional_token_grant "." scoped_token_exile_end "."

/* @sem Instruction::Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:$created_reference, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}} */
scoped_token_exile_end ::= "exile" created_reference "at" "the" "beginning" "of" "the" "next" "end" "step"

/* This plural recipe keeps the creation and its later sacrifice in one scope. */
/* @sem TokenSpec::TokenSpec{amount:$number, words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2]}} */
temporary_attacking_token_group ::= number token_stat "/" token_stat token_colors token_subtypes token_types "tokens"

/* @sem Operation::CreateTrigger{event:$event, duration:$this_duration, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[$temporary_attacking_token_group], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(@marked)})}]}}}]}} */
temporary_trigger_attacking_tokens ::= "whenever" event this_duration "," "create" temporary_attacking_token_group "that" "are" "tapped" "and" "attacking" "." "sacrifice" "them" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$temporary_trigger_attacking_tokens}]}} */
activated_temporary_trigger_attacking_tokens ::= cost ":" temporary_trigger_attacking_tokens "."

/* A blocking token enters in combat against the announced attacker. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[Blocking(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$filter_phrase, AttackingDefender(Players(One(AbilityController)))])}), index:0})]}}) */
create_blocking_single ::= "create" "a" token_recipe "that's" "blocking" "target" filter_phrase "attacking" "you"

/* The token's literal name is independent of its source and characteristics. */
/* @sem String::'Ajani''s Pridemate' */
created_name_ajanis_pridemate ::= "Ajani" "'s" "Pridemate"

/* The first action completes before the independent condition and creation. */
/* @sem Instruction::[Effect{result:@next, operation:$operation}, If{condition:$condition_no_counters, then:Program{instructions:[$conditional_token_creation]}, otherwise:Program{}}] */
instructions_then_conditional_creation ::= operation "." "then" "if" condition_no_counters "," conditional_token_creation

/* Both branches use the same current recipe; only the quantity is replaced. */
/* @sem Instruction::[If{condition:$condition_control_named_pair, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$counter_amount_2, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}] */
instructions_token_quantity_override ::= "create" counter_amount token_recipe "." "create" counter_amount "of" "those" "tokens" "instead" "if" condition_control_named_pair

/* A token population keeps its written qualifier and subsequent modifiers. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::Token, $modifiers)} */
qualified_token_population ::= filter_phrase "token" modifiers

/* Each selected token supplies the antecedent for its own copy. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyEach{objects:$qualified_token_population, exceptions:[]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_attacking_copy_each_token ::= "for" "each" qualified_token_population "," "create" "a" "tapped" "and" "attacking" "token" "that's" "a" "copy" "of" "that" "token"

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:$copy_token_plural_amount, words:CreatingEffect, recipe:CopyEach{objects:$qualified_token_population, exceptions:[]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_attacking_copies_each_token ::= "for" "each" qualified_token_population "," "create" copy_token_plural_amount "tapped" "and" "attacking" "tokens" "that" "are" "copies" "of" "that" "token"

copy_token_plural_amount ::= n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10 | n11 | n12 | n13 | n14 | n15 | n20 | n30

/* A choice list composes token alternatives without fixing their recipes. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$token_group], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
token_choice_option ::= token_group

/* @sem Program::[$token_choice_option] */
token_choice_last ::= "or" token_choice_option

/* @sem Program::[$token_choice_option, ...$token_choice_tail] */
token_choice_more ::= token_choice_option "," token_choice_tail

token_choice_tail ::= token_choice_last | token_choice_more

/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[$token_choice_option, ...$token_choice_tail]}] */
clause_create_token_choice ::= "create" "your" "choice" "of" token_choice_option "," token_choice_tail

/* A single token already on the battlefield has its own quoted ability. */
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:@token_abilities($singular_counted_token_recipe, $before_game_quoted_abilities)} */
before_game_single_token ::= "a" singular_counted_token_recipe "on" "the" "battlefield" "." "it" "has" before_game_quoted_abilities

/* @sem Ability::[$token_quoted] */
before_game_quoted_abilities ::= token_quoted

/* @sem Ability::BeforeGame{when:GameBegins, body:List([Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$before_game_single_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}])} */
before_game_with_token ::= "you" "begin" "the" "game" "with" before_game_single_token

/* The shared trailing definition supplies both token characteristics. Limit the
   history expression to a producer-independent life total for this turn. */
/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$value_life_gained_turn, $value_life_gained_turn]}) */
token_recipe_equal_history ::= "X" "/" "X" token_colors token_subtypes token_types "tokens" "," "where" "X" "is" value_life_gained_turn

/* The cost and consumer are one phrase: the measured object is the single
   creature sacrificed as component zero of this casting cost. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:Exactly(Constant(1))}]}, repetition:Once}), Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:ObjectProperty{object:Query{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Inputs, phase:Before}, index:0}, property:$casting_sacrifice_stat, information:CurrentOrLastKnown}, words:CreatingEffect, recipe:$casting_sacrifice_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]}}] */
line_casting_sacrifice_tokens ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "sacrifice" "a" "creature" "." NEWLINE "create" "X" casting_sacrifice_token_recipe "where" "X" "is" "the" "sacrificed" "creature's" casting_sacrifice_stat "."

casting_sacrifice_stat ::= stat_power | stat_toughness

/* The quotation's comma ends the triggered ability before the where clause. */
/* @sem TokenRecipe::@token_abilities($token_recipe_base, $casting_sacrifice_token_ability) */
casting_sacrifice_token_recipe ::= token_recipe_base "with" casting_sacrifice_token_ability

/* @sem Ability::[@scope(Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$program})] */
casting_sacrifice_token_ability ::= '"' event_clause "," program "," '"'

/* A named token can state all colors after its name and list intrinsic abilities. */
/* @sem TokenRecipe::Defined(_{name:Explicit($created_token_name), colors:[White, Blue, Black, Red, Green], card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2]}) */
token_recipe_named_all_colors ::= token_stat "/" token_stat token_subtypes token_types "token" "named" created_token_name "that's" "all" "colors"

/* @sem TokenRecipe::@token_abilities($token_recipe_named_all_colors, $token_ability_description) */
token_recipe_named_all_colors_with ::= token_recipe_named_all_colors token_ability_description

/* @sem String::'Reliquary Dragon' */
created_name_reliquary_dragon ::= "Reliquary" "Dragon"

/* The closing quotation carries the sentence's period. The list must end in
   a quoted ability so that the enclosing activation need not add another. */
/* @sem Ability::[$token_quoted] */
token_final_quoted_last ::= "and" token_quoted

/* @sem Ability::[$token_ability, ...$token_final_quoted_tail] */
token_final_quoted_more ::= token_ability "," token_final_quoted_tail

token_final_quoted_tail ::= token_final_quoted_last | token_final_quoted_more

/* @sem Ability::[$token_ability, ...$token_final_quoted_tail] */
token_final_quoted_list ::= token_ability "," token_final_quoted_tail

/* @sem TokenRecipe::@token_abilities($token_recipe_named_all_colors, $token_final_quoted_list) */
token_named_colors_final_quote ::= token_recipe_named_all_colors "." "it" "has" token_final_quoted_list

/* @sem Operation::@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:$token_named_colors_final_quote}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_named_colors_final_quote ::= "create" token_amount token_named_colors_final_quote

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$create_named_colors_final_quote}]}} */
activated_token_final_quote_limited ::= cost ":" create_named_colors_final_quote activation_limits "."

/* A single copied token establishes the antecedent of its delayed exile. */
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:$copy_exceptions_plain}} */
single_copy_token_with_exceptions ::= token_copy_single object_ref "," "except" copy_exceptions_plain

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[$single_copy_token_with_exceptions], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Created(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}]} */
program_single_copy_exile_combat ::= "create" single_copy_token_with_exceptions "." "exile" "it" "at" "end" "of" "combat"

/* The grant and cleanup refer to the same preceding creation. */
/* @sem Instruction::[$conditional_token_grant, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:$created_ordinary_singular, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}] */
conditional_token_grant_exile ::= conditional_token_grant "." "exile" created_ordinary_singular "at" "the" "beginning" "of" "the" "next" "end" "step"

/* The host is chosen from the current event group, not a prior token. */
/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:Rules, recipe:$role_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[AttachedToChosen(InSet(EventGroup))]}} */
create_role_on_event_member ::= "create" "a" role_recipe "token" "attached" "to" "one" "of" "them"

/* A temporary grant applies to the batch created earlier in this program. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($created_gain_subject), changes:$grants, duration:$duration, evaluation:Snapshot}}] */
clause_created_temporary_gain ::= created_gain_subject "gain" grants duration

/* The immediately created singular token is the animated object. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Created(@marked)), changes:[SetBasePowerToughness{power:$token_stat, toughness:$token_stat_2}, AddCardType(Artifact), AddCardType(Creature), GrantKeyword($keyword_name)], duration:Indefinite, evaluation:Snapshot}}] */
instructions_named_token_animation ::= "create" "a" token_named_recipe "token" "." "it" "becomes" "a" token_stat "/" token_stat "artifact" "creature" "and" "gains" keyword_name

/* @prefer always */
/* @sem Ability::[$chapter_token_attack_quoted] */
chapter_token_attack_abilities ::= chapter_token_attack_quoted

/* @sem Ability::[$token_quoted] */
chapter_other_quoted_abilities ::= token_quoted

/* The attack event belongs to the newly created token; its body composes independently. */
/* @prefer always */
/* @sem Ability::@holder(Ability::Triggered{event:Object{event:Attacks, objects:SameObject(Source)}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}) */
chapter_token_attack_quoted ::= '"' "whenever" "this" "token" "attacks" "," program_sentence '"'

/* A linked exiled card and its copy exceptions retain independent operands. */
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyOne{objects:$token_exiled_card, exceptions:$copy_exceptions_plain}} */
token_copy_exiled_modified ::= "a" "token" "that's" "a" "copy" "of" token_exiled_card "," "except" copy_exceptions_plain

/* The Cursed Role sets its enchanted creature’s base power and toughness. */
/* @sem TokenRecipe::Defined{name:Explicit(Cursed), card_types:[Enchantment], subtypes:[Aura, Role], abilities:[Enchant{hosts:Permanents(CardType(Creature))}, Static(_{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[SetBasePowerToughness{power:Constant(1), toughness:Constant(1)}]})]} */
cursed_role_recipe ::= "Cursed" "Role"

/* Random Oracle copies compose their population and the comparison's object. */
/* @sem TokenSpec::TokenSpec{amount:$token_copy_quantity, words:CreatingEffect, recipe:CopyAtRandom{cards:$random_oracle_copy_cards}} */
token_copy_random_oracle ::= token_copy_quantity "a" "random" random_oracle_copy_cards

/* @sem Operand::Term{family:CardsInOracle, form:And, operands:[$random_oracle_excluded_type, Term{family:CardsInOracle, form:IsCreatureType, operands:[Vocabulary{family:CreatureType, form:@subtype_name($creature_subtype)}]}, Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Creature}]}, Term{family:CardsInOracle, form:ManaValueIs, operands:[Comparison([Equal, ObjectProperty{object:$object_ref, property:ManaValue, information:CurrentOrLastKnown}])]}]} */
random_oracle_copy_cards ::= random_oracle_excluded_type creature_subtype "creature" "card" "with" "the" "same" "mana" "value" "as" object_ref

/* @sem Operand::Term{family:CardsInOracle, form:IsNonCreatureType, operands:[Vocabulary{family:CreatureType, form:Shapeshifter}]} */
random_oracle_excluded_type ::= "non-Shapeshifter"

/* The token's two statistics both measure the grouped damage event. This
   recipe is used only by the scoped grouped-creature-damage trigger below. */
/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[EventAmount, EventAmount], abilities:[Keyword($keyword_value)]}) */
group_damage_token_recipe ::= "X" "/" "X" token_colors token_subtypes token_types "token" "with" keyword_value

/* The recipient grouping proves that the damage amount is that dealt by the
   triggering creatures to the one player referenced in the where-clause. */
/* @sem Ability::Triggered{event:Damage{source_kind:Permanent, sources:AllOf([CardType(Creature), ControlledBy(One(AbilityController)), HasKeyword($keyword_value)]), recipients:Players(All), kind:Combat, grouping:Recipient, subject:Source}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$group_damage_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]}} */
triggered_group_damage_token ::= "whenever" "one" "or" "more" "creatures" "you" "control" "with" keyword_value "deal" "combat" "damage" "to" "a" "player" "," "create" "an" group_damage_token_recipe "," "where" "X" "is" "the" "amount" "of" "damage" "those" "creatures" "dealt" "to" "that" "player" "."

/* The creation and its anaphoric counter placement share the creation receipt. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$create_one_defined}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@prior)), kind:$counter_kind, amount:Earlier{what:LeftGraveyard, measure:Greatest(ManaValue)}}]}}]} */
created_graveyard_counter_program ::= create_one_defined "," "then" "put" "a" "number" "of" counter_kind "counters" "on" "it" "equal" "to" "the" "greatest" "mana" "value" "among" "those" "cards"

/* A required life payment and its dependent creation share the same value. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[Life($value)]}}}, If{condition:PaymentChosen(@last_result), then:_{instructions:[Effect{result:@next, operation:$create_one_defined}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@prior)), kind:$counter_kind, amount:$value}]}}]}, otherwise:_{}}]} */
paid_created_counter_program ::= "pay" "X" "life" "," "where" "X" "is" value "." "if" "you" "do" "," create_one_defined "and" "put" "X" counter_kind "counters" "on" "it"

/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
create_one_defined ::= "create" "a" token_recipe

/* The discard itself supplies the receipt counted by the following token instruction. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}, Effect{result:@mark, operation:Discard{players:One(AbilityController), amount:$card_count_2, random:false}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountDistinct{objects:Transition{result:@marked, phase:After}, property:CardTypes}, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]}} */
spell_draw_discard_distinct_tokens ::= "draw" card_count "," "then" "discard" card_count "." "create" "a" token_recipe "for" "each" "card" "type" "among" "cards" "discarded" "this" "way" "."

/* The measured removal is exactly the second component of this activation. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}), kind:PowerToughness(1, 1), amount:AmongThem(AtLeast(Constant(1)))}]}]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:$token_colors, card_types:[Creature], subtypes:$token_subtypes, power_toughness:[PaidCountersRemoved{payment:Activation, component:[1]}, PaidCountersRemoved{payment:Activation, component:[1]}]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]}} */
activated_remove_among_scaled_token ::= cost_mana "," "↑" "remove" "one" "or" "more" "+" "1" "/" "+" "1" "counters" "from" "among" filter_plural "you" "control" ":" "create" "an" "X" "/" "X" token_colors token_subtypes "creature" "token" "," "where" "X" "is" "the" "number" "of" "+" "1" "/" "+" "1" "counters" "removed" "this" "way" "."

/* One creation is replaced by a different count of the same recipe and entry. */
/* @sem Program::Program{instructions:[If{condition:$condition_died, then:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$count_plural, words:CreatingEffect, recipe:$singular_counted_token_recipe}], entry:BattlefieldArrival{tapped:true}}}]}, otherwise:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$singular_counted_token_recipe}], entry:BattlefieldArrival{tapped:true}}}]}}]} */
program_tapped_token_death_replacement ::= "create" "a" "tapped" singular_counted_token_recipe "." "if" condition_died "," "create" count_plural "of" "those" "tokens" "instead" "."

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$program_tapped_token_death_replacement} */
triggered_tapped_token_death_replacement ::= "at" turn_event "," program_tapped_token_death_replacement

/* @sem String::'Nalaar Aetherjet' */
created_name_nalaar_aetherjet ::= "Nalaar" "Aetherjet"

/* Only the enclosing exile-payment activation may supply this receipt. */
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:$paid_exile_token_name, supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2], abilities:[Keyword($keyword_value)], abilities_of:[CostObjects{payment:Activation, component:[1], view:Performed, phase:After}, List([Term{family:CheckHasable, form:TriggeredAbility}])]}} */
paid_exile_legendary_token ::= paid_exile_token_name "," counter_amount "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token" "with" keyword_value "and" "all" "triggered" "abilities" "of" "the" "exiled" "cards"

paid_exile_token_name ::= paid_exile_name_vecna | explicit_legendary_name

/* @sem TokenName::Explicit(Vecna) */
paid_exile_name_vecna ::= "Vecna"

/* The name is independent of the token characteristics. */
/* @sem String::'Wirefly' */
created_name_wirefly ::= "Wirefly"

/* A named token count reads the Before receipt of the immediately preceding
   destroy or sacrifice action. Keeping both instructions in the same production
   constrains the inverse to the action named by the text. */
/* @sem Instruction::[Effect{result:@mark, operation:$destroy}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$filter_phrase}), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}})}] */
instructions_destroy_receipt_named_tapped ::= destroy "." "for" "each" filter_phrase "destroyed" "this" "way" "," "you" "create" "a" "tapped" token_named_recipe "token"

/* @sem Instruction::[Effect{result:@mark, operation:@sacrificed_result(Operation::Sacrifice{players:OpponentsOf(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Constant(1))})}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$filter_phrase_2}), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
instructions_opponents_sacrifice_receipt_named ::= "each" "opponent" "sacrifices" "an" filter_phrase "." "for" "each" filter_phrase "sacrificed" "this" "way" "," "you" "create" "a" token_named_recipe "token"

/* The alternative uses the same token recipe as the ordinary creation. */
/* @sem Program::Program{instructions:[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}]} */
shared_token_conditional_instead ::= "create" token_amount token_recipe "." "if" condition "," "create" counter_amount "of" "those" "tokens" "instead" "."

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$shared_token_conditional_instead} */
shared_trigger_token_conditional ::= event_clause "," shared_token_conditional_instead

/* The delayed sacrifice consumes the tokens created by this same instruction. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[$token_copy_exiled_plural], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:One(AbilityController)}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(@marked)})}]}}}] */
instructions_linked_copy_sacrifice_own_end ::= "create" token_copy_exiled_plural "." "sacrifice" "them" "at" "the" "beginning" "of" "your" "next" "end" "step"

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[...$instructions_linked_copy_sacrifice_own_end]}} */
triggered_linked_copy_sacrifice_own_end ::= event_clause "," instructions_linked_copy_sacrifice_own_end "."
