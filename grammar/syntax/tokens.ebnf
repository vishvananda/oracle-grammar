/* @prefer always */
/* The copy consumes the arrival of this exile, while its recipient is the target's controller. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:@and(ObjectFilter::Not(SameObject(Source)), @and($adjective_nontype, ObjectFilter::Not(Token)))}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateTokens{players:One(ControllerOf(Target{slot:0, index:0})), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Result{result:@marked, phase:After, index:0}, exceptions:$copy_nonlegendary_added_card_type}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
exile_target_controller_copy ::= "exile" "up" "to" "one" "other" "target" adjective_nontype "," "nontoken" "permanent" "." "its" "controller" "creates" "a" "token" "that's" "a" "copy" "of" "it" "," "except" copy_nonlegendary_added_card_type

copy_nonlegendary_added_card_type ::= copy_nonlegendary_artifact | copy_nonlegendary_enchantment

/* @sem Vec<CopyException>::[CopyException::RemoveSupertypes([Legendary]), CopyException::AddCardTypes([Artifact])] */
copy_nonlegendary_artifact ::= "it's" "not" "legendary" "and" "it's" "an" "artifact" "in" "addition" "to" "its" "other" "types"

/* @prefer always */
/* @sem Vec<CopyException>::[CopyException::RemoveSupertypes([Legendary]), CopyException::AddCardTypes([Enchantment])] */
copy_nonlegendary_enchantment ::= "it's" "not" "legendary" "and" "it's" "an" "enchantment" "in" "addition" "to" "its" "other" "types"

/* @sem Ability::Triggered{event:$event_self_enters, limits:_{}, announcement:@announcement, body:Program{instructions:$exile_target_controller_copy}} */
triggered_exile_controller_copy ::= "when" event_self_enters "," exile_target_controller_copy "."

/* The damage event supplies the amount; the immediately created token is the recipient. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$create_one_defined}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@prior)), kind:$counter_kind, amount:EventAmount}]}}]} */
created_damage_counter_program ::= create_one_defined "." "put" "a" "number" "of" counter_kind "counters" "on" "it" "equal" "to" "the" "damage" "dealt"

/* @sem Ability::Triggered{event:$event_group_combat_damage_to_player, limits:TriggerLimits{}, announcement:@announcement, body:$created_damage_counter_program} */
triggered_group_damage_created_counters ::= "whenever" event_group_combat_damage_to_player "," created_damage_counter_program "."

/* The delayed action refers to this creation's result, irrespective of earlier effects. */
/* @sem Instruction::[Effect{result:@mark, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyEach{objects:$owned_exile_card_with_counter, exceptions:[]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}})}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Created(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}] */
instructions_copy_owned_exile_combat ::= "for" "each" owned_exile_card_with_counter "," "create" "a" "tapped" "and" "attacking" "token" "that's" "a" "copy" "of" "it" "." "exile" "those" "tokens" "at" "end" "of" "combat"

/* The Rock name proves that the named sacrifice pays with this granting token. */
/* @sem TokenRecipe::Defined{ name:Explicit(Rock), colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, abilities:[$token_rock_quoted, $keyword_equip] } */
token_recipe_rock_equipment ::= token_colors token_subtypes token_types "token" "named" "Rock" "with" token_rock_quoted "and" keyword_equip

/* @sem Ability::@holder($token_equipped_sacrifice_damage) */
token_rock_quoted ::= '"' token_equipped_sacrifice_damage '"'

/* This grant belongs to the equipped creature; sacrificing Rock pays with the granting Equipment. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[GrantAbility(@scope($equipped_rock_damage_activation))]} */
token_equipped_sacrifice_damage ::= "equipped" "creature" "has" "'" equipped_rock_damage_activation

/* @sem Ability::Activated{origin:Ordinary, cost:_{parts:[Mana($mana_symbols), TapSymbol, Sacrifice{objects:One(GrantingObject)}]}, limits:_{}, body:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any})), amount:$number, preventable:true}}]}, announcement:@announcement} */
equipped_rock_damage_activation ::= mana_symbols "," "{" "T" "}" "," "↑" "sacrifice" "Rock" ":" "this" "creature" "deals" number "damage" "to" "any" "target'"

/* A per-controller population binds the creator and each copied permanent to
   the same controller. The object set is reusable independently of creation. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun_creature, $noun_token, ControlledBy(One(Bound(0)))])} */
controller_creature_token_population ::= noun_creature noun_token "on" "the" "battlefield"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun_creature, ControlledBy(One(Bound(0)))])} */
controller_creature_population ::= noun_creature "on" "the" "battlefield"

controller_copy_population ::= controller_creature_token_population | controller_creature_population

/* @sem $counter_a */
controller_copy_token_singular ::= counter_a "token"

/* @sem $controller_copy_plural_amount */
controller_copy_token_plural ::= controller_copy_plural_amount "tokens"

controller_copy_plural_amount ::= n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10

controller_copy_token_quantity ::= controller_copy_token_singular | controller_copy_token_plural

/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(Bound(0)), tokens:[_{amount:$controller_copy_token_quantity, words:CreatingEffect, recipe:CopyEach{objects:$controller_copy_population, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}] */
clause_controller_copy_each ::= "for" "each" controller_copy_population "," "its" "controller" "creates" controller_copy_token_quantity "that's" "a" "copy" "of" "that" "creature"

/* Two token alternatives share the imperative and each keeps its own result. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[$token_choice_option, $token_choice_option_2]}] */
/* @prefer always */
clause_create_token_pair_choice ::= "create" token_choice_option "or" token_choice_option

/* The quoted activation is scoped to the created land's ability holder. */
/* @sem TokenSpec::TokenSpec{amount:$counter_a, words:CreatingEffect, recipe:Defined{name:Explicit($created_land_token_name), card_types:[Land], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program})]}} */
tapped_named_land_spec ::= counter_a "tapped" "land" "token" "named" created_land_token_name "with" '"' cost ":" program "." '"'

/* @sem String::Sanctum */
created_land_token_name ::= "Sanctum"

/* @sem TokenSpec::TokenSpec{amount:$count_plural, words:CreatingEffect, recipe:Defined{name:Explicit($created_land_token_name), card_types:[Land], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program})]}} */
tapped_named_lands_spec ::= count_plural "tapped" "land" "tokens" "named" created_land_token_name "with" '"' cost ":" program "." '"'

/* The explicit token name is independent of the creating source. */
/* @sem String::'Koma''s Coil' */
created_name_komas_coil ::= "Koma's" "Coil"

/* The created token recipe and the counted history population are independent. */
/* @sem TokenSpec::TokenSpec{amount:EventHistory{event:Player{event:CreatesToken, players:One(AbilityController), objects:$filter_phrase}, window:ThisTurn, measure:Occurrences}, words:Rules, recipe:$token_named_recipe} */
token_named_created_history ::= "X" token_named_recipe "tokens" "," "where" "X" "is" "the" "number" "of" filter_phrase "tokens" "you" "created" "this" "turn"

/* The die-result binder identifies the roll in the enclosing program. */
/* @sem TokenSpec::TokenSpec{amount:$value_die_result, words:Rules, recipe:$token_named_recipe} */
token_named_die_equal ::= "a" "number" "of" token_named_recipe "tokens" "equal" "to" value_die_result

/* A single explicitly named legendary token supplies the antecedent for both delayed effects. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:$explicit_legendary_name, supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$event_clause, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Created(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Object{event:LeavesBattlefield, objects:InSet(Created(@marked))}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:One($self_explicit_ref)}}]}}}]} */
created_legendary_token_linked_departures ::= "create" explicit_legendary_name "," "a" "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token" "." "exile" "that" "token" event_clause "." "sacrifice" self_explicit_ref "when" "that" "token" "leaves" "the" "battlefield" "."

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$created_legendary_token_linked_departures} */
triggered_created_legendary_linked_departures ::= event_clause "," created_legendary_token_linked_departures

/* @sem TokenRecipe::Named('Black Lotus') */
tn_black_lotus ::= "Black" "Lotus"

/* The chosen Oracle card type and mana value are independent operands. */
/* @sem TokenSpec::TokenSpec{amount:$token_copy_quantity, words:CreatingEffect, recipe:CopyAtRandom{cards:$random_mana_copy_cards}} */
token_copy_random_mana_card ::= token_copy_quantity random_mana_copy_cards "chosen" "at" "random"

/* @sem Operand::Term{family:CardsInOracle, form:And, operands:[$random_copy_card_type, Term{family:CardsInOracle, form:ManaValueIs, operands:[Comparison([Equal, $number])]}]} */
random_mana_copy_cards ::= random_copy_card_type "card" "with" "mana" "value" number

random_copy_card_type ::= random_copy_creature | random_copy_artifact | random_copy_instant | random_copy_sorcery

/* @sem $card_name_creature */
random_copy_creature ::= "a" card_name_creature

/* @sem $conjured_oracle_artifact */
random_copy_artifact ::= "an" conjured_oracle_artifact

/* @sem $conjured_oracle_instant */
random_copy_instant ::= "an" conjured_oracle_instant

/* @sem $conjured_oracle_sorcery */
random_copy_sorcery ::= "a" conjured_oracle_sorcery

/* @prefer always */
/* @sem Operand::Term{family:CardsInOracle, form:And, operands:[$random_oracle_excluded_type, Term{family:CardsInOracle, form:IsCreatureType, operands:[Vocabulary{family:CreatureType, form:@subtype_name($creature_subtype)}]}, Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Creature}]}, Term{family:CardsInOracle, form:ManaValueIs, operands:[Comparison([Equal, ObjectProperty{object:$object_ref, property:ManaValue, information:CurrentOrLastKnown}])]}]} */
random_oracle_copy_same_value ::= random_oracle_excluded_type creature_subtype "creature" "card" "with" "the" "same" "mana" "value" "as" object_ref

/* @sem Operand::Term{family:CardsInOracle, form:And, operands:[$conjured_oracle_type, Term{family:CardsInOracle, form:ManaValueIs, operands:[Comparison([Equal, $number])]}]} */
random_oracle_copy_mana_value ::= conjured_oracle_type "card" "with" "mana" "value" number

/* @sem TokenName::Explicit(Boo) */
explicit_token_boo ::= "Boo"

/* The amount is the damage from this specific preceding loop, not an
   arbitrary performed-action receipt. Both the comparison and damage use the
   same current population filter. */
/* @sem Instruction::ForEachPlayer{players:Intersection([$players_singular, Matching{binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}), test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])})}}}]), binding:0, body:_{instructions:[Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(One(Bound(0))), amount:Subtract(CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}), CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])})), preventable:true}}]}} */
controlled_difference_damage_loop ::= object_ref "deals" "damage" "to" players_singular "who" "controls" "more" filter_plural "than" "you" "equal" "to" "the" "difference"

/* @sem Instruction::[ $controlled_difference_damage_loop, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Performed(@prior), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}} ] */
controlled_difference_damage_named_tokens ::= controlled_difference_damage_loop "." "then" "create" "a" "number" "of" token_named_recipe "tokens" "equal" "to" "the" "damage" "dealt" "this" "way"

/* @prefer always */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$controlled_difference_damage_named_tokens}} */
spell_controlled_difference_damage_named_tokens ::= controlled_difference_damage_named_tokens "."

/* The cleanup is tied to the receipt produced by the preceding copy loop. */
/* @sem Program::Program{instructions:[...$blocking_copy_loop, $blocking_copy_cleanup]} */
program_blocking_copies_cleanup ::= blocking_copy_loop "." blocking_copy_cleanup

/* @sem Instruction::[ForEachObject{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, AttackingDefender(PlayersAndPlaneswalkers(One(AbilityController)))])}, binding:0, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Bound(0), exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[Blocking(Bound(0))]}}}]}}] */
blocking_copy_loop ::= "for" "each" filter_phrase "attacking" "you" "or" "a" "planeswalker" "you" "control" "," "create" "a" "token" "that's" "a" "copy" "of" "that" "creature" "and" "that's" "blocking" "that" "creature"

/* @sem Instruction::Effect{result:@next, operation:CreateDelayedTrigger{event:$token_cleanup_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Created(0), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}} */
blocking_copy_cleanup ::= "exile" "those" "tokens" "at" token_cleanup_event

/* Each created token is required to attack the player bound by the loop. */
/* @sem Program::Program{instructions:[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@next, operation:$create_one_defined}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Created(@prior)), changes:[Rule(RequireCombat{action:Attack(Players(One(Bound(0)))), amount:AtLeast(Constant(1))})], duration:Indefinite, evaluation:LiveObjects}}]}}]} */
per_opponent_create_attacking_token ::= "for" "each" "opponent" "," create_one_defined "that" "attacks" "that" "player" "each" "combat" "if" "able"

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$per_opponent_create_attacking_token} */
triggered_per_opponent_attacking_token ::= event_clause "," per_opponent_create_attacking_token "."

/* This recipe is used only within the scoped two-player exchange below. */
/* @sem TokenRecipe::Defined{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[Maximum(Subtract(PlayerNumber{player:Target{slot:0, index:0}, number:Life}, PlayerNumber{player:Target{slot:1, index:0}, number:Life}), Subtract(PlayerNumber{player:Target{slot:1, index:0}, number:Life}, PlayerNumber{player:Target{slot:0, index:0}, number:Life})), Maximum(Subtract(PlayerNumber{player:Target{slot:0, index:0}, number:Life}, PlayerNumber{player:Target{slot:1, index:0}, number:Life}), Subtract(PlayerNumber{player:Target{slot:1, index:0}, number:Life}, PlayerNumber{player:Target{slot:0, index:0}, number:Life}))]} */
exchange_life_difference_token_recipe ::= "X" "/" "X" token_colors token_subtypes token_types "token" "," "where" "X" "is" "the" "difference" "between" "those" "players'" "life" "totals"

/* The counted battlefield population and the copied event subject are independent. */
/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[_{amount:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(DefendingPlayerOf(Source)))])}), words:CreatingEffect, recipe:Copy{object:EventSubject, exceptions:[]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}} */
create_counted_attacking_event_copies ::= "create" "X" "tokens" "that" "are" "copies" "of" "it" "and" "that" "are" "tapped" "and" "attacking" "," "where" "X" "is" "the" "number" "of" filter_plural "defending" "player" "controls"

/* @sem Ability::Triggered{event:Object{event:Attacks, objects:$event_holder}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$create_counted_attacking_event_copies}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Move{objects:Created(@back(3)), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}]}} */
trigger_counted_attacking_copies ::= "whenever" event_holder "attacks" "," create_counted_attacking_event_copies "." "exile" "the" "tokens" "at" "the" "beginning" "of" "the" "next" "end" "step" "."

/* Payment and its per-player token count are paired in one program. */
/* @sem Program::Program{instructions:[ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@mark, operation:PayAnyAmount{actor:One(Bound(0)), resource:Mana}}]}}, Effect{result:@next, operation:CreateTokens{players:All, tokens:[_{amount:Performed(@marked), words:CreatingEffect, recipe:$paid_mana_plural_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
program_each_mana_paid_tokens ::= "each" "player" "may" "pay" "any" "amount" "of" "mana" "." "then" "each" "player" "creates" "a" "number" "of" paid_mana_plural_token_recipe "equal" "to" "the" "amount" "of" "mana" "they" "paid" "this" "way"

/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2]}) */
paid_mana_plural_token_recipe ::= token_stat "/" token_stat token_colors token_subtypes token_types "tokens"

/* The damage recipients create the token, and its creation receipt identifies the goaded object. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:CreateTokens{players:One(EventSubject), tokens:[$token_defined_quoted], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Created(@marked)), changes:[Rule(GoadedBy(AbilityController))], duration:Indefinite, evaluation:LiveObjects}}]} */
combat_recipient_creates_goaded_token ::= "that" "player" "creates" token_defined_quoted "the" "token" "is" "goaded" "for" "the" "rest" "of" "the" "game"

/* @sem Ability::Triggered{event:$event_controlled_subtypes_combat_player, limits:TriggerLimits{}, announcement:@announcement, body:$combat_recipient_creates_goaded_token} */
triggered_controlled_group_recipient_token ::= "whenever" event_controlled_subtypes_combat_player "," combat_recipient_creates_goaded_token "."

/* A granted combat-end ability belongs to the resulting copy. */
/* @sem CopyException::AddAbilities([@scope(Ability::Triggered{event:Turn{point:CombatEnds, players:All}, limits:_{}, announcement:@announcement, body:$program})]) */
copy_end_combat_ability ::= "it" "has" '"' "at" "end" "of" "combat" "," program "." '"'

/* A token count may be an announced amount reduced by a stated amount. */
/* @sem Expr::Subtract([$number_x, $number_words]) */
token_amount_difference ::= number_x "minus" number_words

/* A player who chose a first object creates their own copy; the copy
   exception remains an independent operand of the token recipe. */
/* @sem Instruction::[ForEachPlayer{players:Matching{binding:0, condition:ChoseNth{player:Bound(0), nth:1}}, binding:0, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(Bound(0)), tokens:[$first_chosen_copy_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}] */
each_player_copies_first_chosen ::= "each" "player" "creates" first_chosen_copy_token

first_chosen_copy_token ::= first_chosen_copy_singular | first_chosen_copy_plural

/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:NthChosen{index:0, by:Bound(0)}, exceptions:$copy_exceptions_plain}} */
first_chosen_copy_singular ::= "a" "token" "that's" "a" "copy" "of" "the" "first" "creature" "they" "chose" "," "except" copy_exceptions_plain

/* @sem TokenSpec::TokenSpec{amount:$copy_token_plural_amount, words:CreatingEffect, recipe:Copy{object:NthChosen{index:0, by:Bound(0)}, exceptions:$copy_exceptions_plain}} */
first_chosen_copy_plural ::= copy_token_plural_amount "tokens" "that" "are" "copies" "of" "the" "first" "creature" "they" "chose" "," "except" copy_exceptions_plain

/* Both followups refer to the token produced by the enclosing creation. */
/* @sem Instruction::[$conditional_token_grant, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:$created_ordinary_singular})}]}}}] */
conditional_token_grant_sacrifice ::= conditional_token_grant "." "sacrifice" created_ordinary_singular "at" "the" "beginning" "of" "the" "next" "end" "step"

/* A named token and its two intrinsic abilities retain the token holder. */
/* @sem TokenName::Explicit(Cragflame) */
explicit_token_cragflame ::= "Cragflame"

/* @sem Ability::Static{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Pump{power:$signed, toughness:$signed_2}, GrantKeyword($keyword_name), GrantKeyword($keyword_name_2), GrantKeyword($keyword_name_3)]} */
equipped_creature_pump_three_keywords ::= "equipped" "creature" "gets" signed "/" signed "and" "has" keyword_name "," keyword_name "," "and" keyword_name

/* @sem Ability::[@holder($equipped_creature_pump_three_keywords), @holder($keyword_equip)] */
equipment_quoted_pump_and_equip ::= '"' equipped_creature_pump_three_keywords '"' "and" keyword_equip

/* @sem TokenSpec::TokenSpec{amount:$counter_a, words:CreatingEffect, recipe:Defined{name:$explicit_legendary_name, supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, abilities:$equipment_quoted_abilities}} */
named_legendary_equipment_token ::= explicit_legendary_name "," counter_a "legendary" token_colors token_subtypes token_types "token" "with" equipment_quoted_abilities

/* A list of checked abilities and its controlled population define this X. */
/* @sem Operand::List([$sharing_kind, ...$sharing_kind_tail]) */
counted_ability_list ::= sharing_kind "," sharing_kind_tail

/* @sem Program::Program{instructions:[Effect{result:@next, operation:BindValue{value:AbilitiesAmong{abilities:$counted_ability_list, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$plural, ControlledBy(One(AbilityController))])}}}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:BoundValue(@prior), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
create_tokens_abilities_among ::= "create" "X" token_named_recipe "tokens" "," "where" "X" "is" "the" "number" "of" "abilities" "from" "among" counted_ability_list "found" "among" plural "you" "control" "."

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$create_tokens_abilities_among} */
triggered_create_tokens_abilities_among ::= event_clause "," create_tokens_abilities_among

/* Named tokens can be counted by a ballot result; the recipe remains independent. */
/* @sem TokenSpec::TokenSpec{amount:$scaled_vote_total, words:Rules, recipe:$token_named_recipe} */
token_named_equal_vote_total ::= "a" "number" "of" token_named_recipe "tokens" "equal" "to" scaled_vote_total

/* @sem @times(Expr::Constant(2), $vote_total_value) */
scaled_vote_total ::= "twice" vote_total_value

/* @sem Expr::Votes(Word($vote_word)) */
vote_total_value ::= "the" "number" "of" vote_word "votes"

/* An explicit name is independent of a statless token's characteristics. */
/* @sem TokenRecipe::Defined(_{name:Explicit($created_token_name), colors:$token_colors, card_types:$token_types}) */
token_recipe_statless_named ::= token_colors token_types "token" "named" created_token_name

/* @sem TokenRecipe::Defined(_{name:Explicit($created_token_name), colors:$token_colors, card_types:$token_types}) */
token_recipe_statless_named_plural ::= token_colors token_types "tokens" "named" created_token_name

/* @sem String::'Scrap' */
created_name_scrap ::= "Scrap"

/* @sem TokenName::Explicit('Ashaya, the Awoken World') */
explicit_token_ashaya ::= "Ashaya" "," "the" "Awoken" "World"

/* Copy each member of the triggering event group; its members remain distinct. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$event_group_tapped_copy_quantity, words:CreatingEffect, recipe:CopyEach{objects:EventGroup, exceptions:[]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}}] */
clause_event_group_copy_tapped ::= "for" "each" "of" "them" "," "create" event_group_tapped_copy_quantity "it"

event_group_tapped_copy_quantity ::= event_group_tapped_copy_single | event_group_tapped_copy_plural

/* @sem Expr::Constant(1) */
event_group_tapped_copy_single ::= "a" "tapped" "token" "that's" "a" "copy" "of"

/* @sem $copy_token_plural_amount */
event_group_tapped_copy_plural ::= copy_token_plural_amount "tapped" "tokens" "that" "are" "copies" "of"

/* Singular creation requires a singular token noun in both directions. */
created_singular_recipe ::= singular_counted_token_recipe | created_singular_recipe_untyped

/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2]}) */
created_singular_recipe_untyped ::= token_stat "/" token_stat token_colors token_types "token"

/* The repeated recipe binds the anaphor in both alternatives, including on print. */
/* @sem Program::Program{instructions:[If{condition:Compare{left:EventAmount, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$singular_counted_token_recipe}, $token_group], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$singular_counted_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}]} */
/* @prefer always */
rolled_token_alternative ::= "create" "a" singular_counted_token_recipe "." "if" "you" "rolled" value "or" "higher" "," "instead" "create" "that" "token" "and" token_group

/* @sem Ability::Triggered{event:$rolled_at_least_event, limits:TriggerLimits{}, announcement:@announcement, body:$rolled_token_alternative} */
/* @prefer always */
triggered_roll_token_alternative ::= rolled_at_least_event "," rolled_token_alternative "."

/* A singular copy of the previously mentioned object keeps its replacement characteristics. */
/* @sem TokenSpec::TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:Copy{object:$it_ref, exceptions:$copy_token_characteristics}} */
token_copy_characteristics_it ::= token_copy_single it_ref "," "except" copy_token_characteristics

/* @sem TokenName::Explicit(Kaldra) */
explicit_token_kaldra ::= "Kaldra"

/* The replacement reuses exactly the preceding token recipe; the emerge
   condition identifies the casting sacrifice whose characteristic is measured. */
/* @sem Program::Program{instructions:[If{condition:ObjectMatches{object:@event_subject, filter:State(CostPaid(Emerge))}, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Earlier{what:Sacrificed, measure:Of($casting_sacrifice_stat)}, words:CreatingEffect, recipe:$singular_counted_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$singular_counted_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}]} */
program_emerge_token_replacement ::= "create" "a" singular_counted_token_recipe "." "if" "this" "creature's" "emerge" "cost" "was" "paid" "," "instead" "create" "X" "of" "those" "tokens" "," "where" "X" "is" "the" "sacrificed" "creature's" casting_sacrifice_stat "."

/* The event subject must be the source mentioned by the emerge condition. */
/* @sem Ability::Triggered{event:$event_self_enters, limits:TriggerLimits{}, announcement:@announcement, body:$program_emerge_token_replacement} */
triggered_self_entry_emerge_tokens ::= "when" event_self_enters "," program_emerge_token_replacement

/* Both branches describe the same copied object and entry state; only the
   amount changes when the separately stated condition holds. */
/* @sem Program::Program{instructions:[If{condition:ObjectMatches{object:$object_ref, filter:$copy_override_filter}, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:[]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:[]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}]}}]} */
copy_attacking_conditional_quantity ::= "create" "a" "tapped" "and" "attacking" "token" "that's" "a" "copy" "of" object_ref "." "if" "that" "creature" "is" "a" copy_override_filter "," "create" counter_amount "of" "those" "tokens" "instead" "."

/* @sem ObjectFilter::AnyOf(@unordered([$subtype_spelled, ...$subtype_or_three])) */
copy_override_filter ::= subtype_spelled "," subtype_or_three

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$copy_attacking_conditional_quantity} */
triggered_copy_conditional_quantity ::= event_clause "," copy_attacking_conditional_quantity

/* Keep the graveyard move and its token count in the same receipt scope. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:$linked_exiled_each, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Transition{result:@marked, phase:After}), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
instructions_linked_graveyard_tokens ::= "put" linked_exiled_each "into" "its" "owner's" "graveyard" "," "then" "create" "a" token_recipe "for" "each" "card" "put" "into" "a" "graveyard" "this" "way"

/* @sem Instruction::[...$instructions_linked_graveyard_tokens, ...$instructions] */
instructions_linked_graveyard_tokens_more ::= instructions_linked_graveyard_tokens "." instructions

/* A statless named snow artifact carries its own quoted ability. */
/* @sem String::'Replicated Ring' */
created_name_replicated_ring ::= "Replicated" "Ring"

/* @sem TokenRecipe::Defined{name:Explicit($created_token_name), supertypes:[Snow], card_types:[Artifact], abilities:[$token_quoted]} */
named_snow_artifact_recipe ::= "colorless" "snow" "artifact" "tokens" "named" created_token_name "with" token_quoted

/* @sem TokenSpec::TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:Copy{object:$that_noun, exceptions:$copy_token_characteristics}} */
token_copy_characteristics ::= token_copy_single that_noun "," "except" copy_token_characteristics

/* Explicitly named statless tokens can carry independently scoped abilities. */
/* @sem TokenRecipe::Defined{name:Explicit($created_token_name), colors:$token_colors, card_types:$token_types, abilities:[$token_quoted, @holder($activated_ability)]} */
token_recipe_named_statless ::= token_colors token_types "token" "named" created_token_name "with" token_quoted "and" '"' activated_ability '"'

/* @sem String::'Meteorite' */
created_name_meteorite ::= "Meteorite"

/* The entering token is both the event subject and the damage source. */
/* @sem Ability::Triggered{event:ZoneChange{objects:SameObject(Source), to:Battlefield}, limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:EventSubject, recipients:$recipients, amount:$number, preventable:true}}]}} */
token_entry_damage_quoted ::= "when" "this" "token" "enters" "," "it" "deals" number "damage" "to" recipients

/* The final quoted ability supplies the enclosing sentence's period. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:$token_recipe_named_statless}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}}]}} */
triggered_tapped_token_final_quote ::= event_clause "," "create" token_amount "tapped" token_recipe_named_statless

/* A completed coin series supplies the quantity; the recipe remains independent. */
/* @sem Expr::CountCoinOutcomes{source:CoinCountSource::Latest, outcome:Won} */
coin_flips_won_count ::= "flip" "you" "won"

/* @sem TokenRecipe::Copy{object:$object_ref, exceptions:[]} */
counted_copy_recipe ::= "token" "that's" "a" "copy" "of" object_ref

counted_coin_token_recipe ::= counted_copy_recipe | token_recipe

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:$coin_flips_won_count, words:CreatingEffect, recipe:$counted_coin_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_per_coin_won ::= "for" "each" coin_flips_won_count "," "create" "a" counted_coin_token_recipe

/* A token's quoted rules use the token as holder, including its own controller. */
/* @sem Ability::@holder(Ability::Static{kind:Ordinary, affected:Objects(One(Source)), changes:$rule_cant_block}) */
quoted_token_cannot_block ::= '"' "this" "token" rule_cant_block '"'

/* @sem Ability::@holder(Ability::Triggered{event:$turn_upkeep, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(One(AbilityController)), amount:$number_digits, preventable:true}}]}}) */
quoted_token_upkeep_damage ::= '"' "at" turn_upkeep "," "this" "token" "deals" number_digits "damage" "to" "you" "." '"'

/* @sem Ability::[$quoted_token_cannot_block, $quoted_token_upkeep_damage] */
quoted_token_block_and_upkeep ::= quoted_token_cannot_block "and" quoted_token_upkeep_damage

/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:@token_abilities($singular_counted_token_recipe, $quoted_token_block_and_upkeep)} */
token_with_block_and_upkeep ::= "a" singular_counted_token_recipe "with" quoted_token_block_and_upkeep

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(EventSubject), tokens:[$token_with_block_and_upkeep], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
damaged_player_creates_scoped_token ::= "that" "player" "creates" token_with_block_and_upkeep

/* @sem Ability::Triggered{event:$event_combat_damage_player, limits:TriggerLimits{}, announcement:@announcement, body:$damaged_player_creates_scoped_token} */
triggered_damage_player_creates_scoped_token ::= "whenever" event_combat_damage_player "," damaged_player_creates_scoped_token

