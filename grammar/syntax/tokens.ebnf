token_recipe_explicit_plural ::= token_stat "/" token_stat token_colors token_subtypes token_types "tokens" "named" created_token_name

/* @sem String::'Kobolds of Kher Keep' */
created_name_kobolds ::= "Kobolds" "of" "Kher" "Keep"

/* These two forms keep the exile and its property consumer in one scope. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One($target_card_a_graveyard), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:ObjectProperty{object:$target_card_a_graveyard, property:$receipt_stat, information:CurrentOrLastKnown}, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
instructions_exile_target_token_stat ::= "exile" target_card_a_graveyard "," "then" "create" "X" token_recipe "," "where" "X" "is" "the" "exiled" "card's" receipt_stat

