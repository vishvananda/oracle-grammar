token_recipe_each_have ::= token_recipe_plain "." "they" "each" "have" token_abilities

/* The count is explicitly tied to this removal payment's first component. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$cost_remove_any_counters]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:PaidCountersRemoved{payment:Resolution(@marked), component:[0]}, words:CreatingEffect, recipe:$token_recipe_each_have}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{}}]} */
paid_removed_counters_tokens ::= "you" "may" cost_remove_any_counters "." "if" "you" "do" "," "create" "that" "many" token_recipe_each_have

/* The subject creates a tapped token attacking the explicitly named player. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[$token_group_tapped], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{player:EventOtherPlayer}]}}) */
create_tapped_attacking_player_third ::= "creates" token_group_tapped "that's" "attacking" "that" "opponent"

/* Independent operations precede a token whose quoted ability closes the sentence. */
chapter_operation_quoted_token ::= chapter_phase_union_then_token | chapter_generic_operation_then_token

/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$chapter_phase_union}, Effect{result:@next, operation:$chapter_quoted_token_creation}]} */
chapter_phase_union_then_token ::= chapter_phase_union "." chapter_quoted_token_creation

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:$chapter_quoted_token_creation}]} */
chapter_generic_operation_then_token ::= operation "." chapter_quoted_token_creation

