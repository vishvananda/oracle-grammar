/* Token creation. A token's words list colors, subtypes, card types and abilities in that order. */

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:$token_groups, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_base ::= "create" token_groups

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:$token_groups, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_third ::= "creates" token_groups

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:$token_groups_tapped, entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}) */
create_tapped_base ::= "create" token_groups_tapped

/* "For each land you control, create a Treasure token": a leading count is the
   amount of the one token named after it. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:$leading_count_each, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_each_defined_leading ::= "for" "each" leading_count_each "," "create" ("a" | "an") token_recipe

/* "For each creature token you control, create a token that's a copy of that creature":
   one copy of each such permanent. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyEach{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_copy_each_leading ::= "for" "each" filter_phrase "," "create" "a" "token" "that's" "a" "copy" "of" copy_each_referent
/* @sem () */
copy_each_referent ::= "it" | "that" "creature" | "that" "permanent"
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:$leading_count_each, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_each_named_leading ::= "for" "each" leading_count_each "," "create" ("a" | "an") token_named_recipe "token"
/* A leading count names present permanents. "This way" counts name a producing
   instruction, which a sentence boundary can separate from @prior. */
leading_count_each ::= count_each_vote | count_spells_cast_this_turn | count_attached_to_him | count_controlled_either | count_each_permanent | count_each_other

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:$token_groups_tapped, entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}) */
create_tapped_third ::= "creates" token_groups_tapped

/* Entry states belong to the creation operation, rather than later tap or
   combat instructions. The ordinary subject binder supplies the creator. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:$token_groups, entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_attacking_base ::= "create" token_groups "that" "are" "tapped" "and" "attacking"

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:$token_groups, entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_attacking_third ::= "creates" token_groups "that" "are" "tapped" "and" "attacking"

/* A dependent token sentence stays with the conditional creation. Ordinary
   following instructions remain outside the payment branch. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[$conditional_token_creation, ...$conditional_token_followups]}, otherwise:Program{}}] */
clause_paid_token_followups ::= "you" "may" payment "." "if" "you" "do" "," conditional_token_creation "." conditional_token_followups

/* @sem Instruction::Effect{result:@next, operation:@apply(PlayerSet::One(AbilityController), $conditional_creation_operation)} */
conditional_token_creation ::= conditional_creation_operation

conditional_creation_operation ::= create_base | create_tapped_base | create_attacking_base

/* @sem Instruction::[$conditional_token_followup] */
conditional_token_followups_one ::= conditional_token_followup
/* @sem Instruction::[$conditional_token_followup, ...$conditional_token_followups] */
conditional_token_followups_more ::= conditional_token_followup "." conditional_token_followups
conditional_token_followups ::= conditional_token_followups_one | conditional_token_followups_more

conditional_token_followup ::= conditional_token_change | conditional_token_grant | conditional_token_cleanup

/* @sem Instruction::Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($created_reference), changes:$changes, duration:$duration, evaluation:Snapshot}} */
conditional_token_change ::= created_reference changes duration

/* An undated grant lasts indefinitely; its holder is the created token. */
/* @sem Instruction::Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($created_reference), changes:$change_grant, duration:Indefinite, evaluation:Snapshot}} */
conditional_token_grant ::= created_reference change_grant
/* "Create a token that's a copy of target creature you control. It gains haste.": an
   undated grant to the tokens just created lasts indefinitely. The subject names the
   created batch, so the clause refuses where nothing was created. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($created_gains_subject), changes:$grants, duration:Indefinite, evaluation:Snapshot}}] */
clause_created_gains ::= created_gains_subject "gains" grants
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($created_gain_subject), changes:$grants, duration:Indefinite, evaluation:Snapshot}}] */
clause_created_gain ::= created_gain_subject "gain" grants
created_gains_subject ::= created_ordinary_singular | created_named_reference
created_gain_subject ::= created_group_reference | created_batch_reference

/* The condition is tested when the delayed ability resolves. It neither gates
   registration nor becomes an intervening-if test on the delayed trigger. */
/* @sem Instruction::Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[If{condition:Not($condition), then:Program{instructions:[Effect{result:@next, operation:Move{objects:$created_reference, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{}}]}}} */
conditional_token_cleanup ::= "at" "the" "beginning" "of" "the" "next" "end" "step" "," "exile" created_reference "unless" condition

/* A coordinated list is one simultaneous token-creation batch. */
token_groups ::= token_groups_one | token_groups_pair | token_groups_list

/* @sem TokenSpec::[$token_group] */
token_groups_one ::= token_group

/* @sem TokenSpec::[$token_group, $token_group_2] */
token_groups_pair ::= token_group "and" token_group

/* @sem TokenSpec::[$token_group, ...$token_groups_tail] */
token_groups_list ::= token_group "," token_groups_tail

token_groups_tail ::= token_groups_last | token_groups_more

/* @sem TokenSpec::[$token_group] */
token_groups_last ::= "and" token_group

/* @sem TokenSpec::[$token_group, ...$token_groups_tail] */
token_groups_more ::= token_group "," token_groups_tail

token_groups_tapped ::= token_groups_tapped_one | token_groups_tapped_pair | token_groups_tapped_list

/* @sem TokenSpec::[$token_group_tapped] */
token_groups_tapped_one ::= token_group_tapped

/* @sem TokenSpec::[$token_group_tapped, $token_group_tapped_2] */
token_groups_tapped_pair ::= token_group_tapped "and" token_group_tapped

/* @sem TokenSpec::[$token_group_tapped, ...$token_groups_tapped_tail] */
token_groups_tapped_list ::= token_group_tapped "," token_groups_tapped_tail

token_groups_tapped_tail ::= token_groups_tapped_last | token_groups_tapped_more

/* @sem TokenSpec::[$token_group_tapped] */
token_groups_tapped_last ::= "and" token_group_tapped

/* @sem TokenSpec::[$token_group_tapped, ...$token_groups_tapped_tail] */
token_groups_tapped_more ::= token_group_tapped "," token_groups_tapped_tail

token_group ::= token_defined_x_where | token_walker_group | token_explicit_legendary | token_cherubael | token_hollow_sentinel | token_defined | token_defined_each | token_defined_equal | token_named | token_named_each | token_copy | token_legendary_named | token_defined_opponent_hand_count | token_devoured_power | token_named_equal | token_named_half_event_x | token_descents_group | token_defined_mana_each

token_copy ::= token_copy_plural_dragon | token_copy_plain | token_copy_modified | token_copy_exiled_plain | token_copy_exiled_singular | token_copy_exiled_plural | token_copy_commander | token_copy_modified_plural

/* @sem TokenSpec::TokenSpec{amount:$token_copy_quantity, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:[]}} */
token_copy_plain ::= token_copy_quantity object_ref

/* The quantity describes the tokens; the article before copy is literal. */
token_copy_quantity ::= token_copy_single | token_copy_plural
/* @sem Expr::Constant(1) */
token_copy_single ::= "a" "token" "that's" "a" "copy" "of"
/* @sem $count */
token_copy_plural ::= count "tokens" "that" "are" "copies" "of"

/* @sem TokenSpec::TokenSpec{amount:$token_copy_quantity, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:$copy_exceptions_plain}} */
token_copy_modified ::= token_copy_quantity object_ref "," "except" copy_exceptions_plain

/* The word `tapped` follows the count, so the count and description stay one phrase. */
token_group_tapped ::= token_defined_tapped | token_defined_each_tapped | token_named_tapped | token_copy_plain_tapped | token_copy_plural_tapped | token_copy_modified_tapped | token_copy_characteristics_tapped | token_defined_x_tapped

/* @sem TokenSpec::TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:$token_recipe} */
token_defined ::= token_amount token_recipe

/* @sem TokenSpec::TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:$token_recipe} */
token_defined_tapped ::= token_amount "tapped" token_recipe

/* @sem TokenSpec::TokenSpec{amount:$count_each, words:CreatingEffect, recipe:$token_recipe} */
token_defined_each ::= ("a" | "an") token_recipe "for" "each" count_each

/* @sem TokenSpec::TokenSpec{amount:$count_each, words:CreatingEffect, recipe:$token_recipe} */
token_defined_each_tapped ::= ("a" | "an") "tapped" token_recipe "for" "each" count_each

/* @sem TokenSpec::TokenSpec{amount:$value, words:CreatingEffect, recipe:$token_recipe} */
token_defined_equal ::= "a" "number" "of" token_recipe "equal" "to" value

token_amount ::= counter_amount | token_that_many

/* @sem @that_many */
token_that_many ::= "that" "many"

/* @sem TokenSpec::TokenSpec{amount:$token_amount, words:Rules, recipe:$token_named_recipe} */
token_named ::= token_amount token_named_recipe ("token" | "tokens")

/* @sem TokenSpec::TokenSpec{amount:$token_amount, words:Rules, recipe:$token_named_recipe} */
token_named_tapped ::= token_amount "tapped" token_named_recipe ("token" | "tokens")

/* @sem TokenSpec::TokenSpec{amount:$count_each, words:Rules, recipe:$token_named_recipe} */
token_named_each ::= ("a" | "an") token_named_recipe "token" "for" "each" count_each

token_recipe ::= token_recipe_post_colors | token_recipe_explicit_plural | token_recipe_history_max | token_recipe_base | token_recipe_with | token_recipe_explicit_name | token_recipe_explicit_name_with | token_recipe_all_colors | token_recipe_all_colors_with

token_recipe_base ::= token_recipe_named | token_recipe_plain | token_recipe_no_subtype | token_recipe_statless | token_recipe_explicit_name_plural | token_recipe_explicit_plaguebearer

/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2]}) */
token_recipe_plain ::= token_stat "/" token_stat token_colors token_subtypes token_types ("token" | "tokens")

/* @sem TokenRecipe::@token_abilities($token_recipe_base, $token_ability_description) */
token_recipe_with ::= token_recipe_base token_ability_description

/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2]}) */
token_recipe_no_subtype ::= token_stat "/" token_stat token_colors token_types ("token" | "tokens")


/* A characteristic-defining ability can supply statistics instead of numerals. */
/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[Expr::Constant(0), Expr::Constant(0)]}) */
token_recipe_statless ::= token_colors token_subtypes token_types ("token" | "tokens")


/* Oracle's following sentence states intrinsic token abilities too. It is part
   of the recipe, rather than an instruction granting an ability after creation. */
token_ability_description ::= token_abilities_with | token_abilities_after | token_abilities_with_more | token_abilities_after_more

/* @sem $token_abilities */
token_abilities_with ::= "with" token_abilities

/* @sem $token_abilities */
token_abilities_after ::= "." token_ability_subject token_abilities

/* @sem Ability::[...$token_abilities, ...$token_ability_description] */
token_abilities_with_more ::= "with" token_abilities token_ability_description

/* @sem Ability::[...$token_abilities, ...$token_ability_description] */
token_abilities_after_more ::= "." token_ability_subject token_abilities token_ability_description

/* @sem () */
token_ability_subject ::= "it" "has" | "they" "have"

token_abilities ::= token_ability_one | token_ability_two | token_ability_list | reminder_group_abilities

/* @sem Ability::[$token_ability] */
token_ability_one ::= token_ability

/* @sem Ability::[$token_ability, $token_ability_2] */
token_ability_two ::= token_ability "and" token_ability

/* @sem Ability::[$token_ability, ...$token_ability_tail] */
token_ability_list ::= token_ability "," token_ability_tail

token_ability_tail ::= token_ability_last | token_ability_list

/* @sem Ability::[$token_ability] */
token_ability_last ::= "and" token_ability

token_ability ::= token_crew | keyword_ability | token_quoted | token_toxic

/* @sem Ability::Mechanic{mechanic:Toxic, amount:$number} */
token_toxic ::= "toxic" number

/* What is quoted is a whole ability: "this" is the token and "you" its controller. */
/* @sem Ability::@holder($token_ability_body) */
token_quoted ::= '"' token_ability_body '"'

token_ability_body ::= static_ability | max_speed_ability | token_ability_sentence | keyword_ability | mined_ability | token_labelled_keyword

/* A characteristic-defining ability here describes the token itself. */
/* @sem Ability::Static{kind:CharacteristicDefining{contributes_to_color_identity:true}, affected:Objects(One(ObjectRef::Source)), changes:[Change::SetBasePowerToughness{power:$value, toughness:$value}]} */
token_defining_both ::= holder_possessive "power" "and" "toughness" "are" "each" "equal" "to" value "."

/* @sem Ability::Static{kind:CharacteristicDefining{contributes_to_color_identity:true}, affected:Objects(One(ObjectRef::Source)), changes:[Change::SetPower($value)]} */
token_defining_power ::= holder_possessive "power" "is" "equal" "to" value "."

/* @sem Ability::Static{kind:CharacteristicDefining{contributes_to_color_identity:true}, affected:Objects(One(ObjectRef::Source)), changes:[Change::SetToughness($value)]} */
token_defining_toughness ::= holder_possessive "toughness" "is" "equal" "to" value "."

token_stat ::= number_digits | number_x

token_colors ::= token_colorless | token_color_one | token_color_two | token_color_three

/* @sem ManaColor::[] */
token_colorless ::= "colorless"
/* @sem ManaColor::[$token_color] */
token_color_one ::= token_color
/* @sem ManaColor::[$token_color, $token_color_2] */
token_color_two ::= token_color "and" token_color
/* @sem ManaColor::[$token_color, $token_color_2, $token_color_3] */
token_color_three ::= token_color "," token_color "," "and" token_color

token_color ::= tc_white | tc_blue | tc_black | tc_red | tc_green

/* @sem ManaColor::White */
tc_white ::= "white"
/* @sem ManaColor::Blue */
tc_blue ::= "blue"
/* @sem ManaColor::Black */
tc_black ::= "black"
/* @sem ManaColor::Red */
tc_red ::= "red"
/* @sem ManaColor::Green */
tc_green ::= "green"

token_subtypes ::= token_subtype_one | token_subtype_more

/* @sem SubType::[@subtype_name($subtype)] */
token_subtype_one ::= subtype

/* @sem SubType::[@subtype_name($subtype), ...$token_subtypes] */
token_subtype_more ::= subtype token_subtypes

token_types ::= tt_creature | tt_artifact_creature | tt_enchantment_creature | tt_land_creature | tt_enchantment_artifact_creature | tt_artifact

/* @sem CardType::[Creature] */
tt_creature ::= "creature"
/* @sem CardType::[Artifact, Creature] */
tt_artifact_creature ::= "artifact" "creature"
/* @sem CardType::[Enchantment, Creature] */
tt_enchantment_creature ::= "enchantment" "creature"
/* @sem CardType::[Land, Creature] */
tt_land_creature ::= "land" "creature"

token_named_recipe ::= tn_shard | tn_powerstone | tn_blood | tn_clue | tn_food | tn_gold | tn_junk | tn_lander | tn_map | tn_mutagen | tn_treasure | tn_spellgorger_weird | tn_mutavault | tn_tarmogoyf | tn_scryb_sprites | tn_baneslayer_angel | tn_vibranium

/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Blood], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[Mana([Generic(1)]), TapSymbol, Discard{count:Expr::Constant(1), filter:Any}, Sacrifice{objects:One(Source)}]}, limits:_{}, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Expr::Constant(1)}}]}})]} */
tn_blood ::= "Blood"

/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Clue], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[Mana([Generic(2)]), Sacrifice{objects:One(Source)}]}, limits:_{}, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Expr::Constant(1)}}]}})]} */
tn_clue ::= "Clue"

/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Food], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[Mana([Generic(2)]), TapSymbol, Sacrifice{objects:One(Source)}]}, limits:_{}, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:Constant(3)}}]}})]} */
tn_food ::= "Food"

/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Junk], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[TapSymbol, Sacrifice{objects:One(Source)}]}, limits:_{sorcery:true}, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Expr::Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:EndOfTurn, evaluation:LiveObjects}}]}})]} */
tn_junk ::= "Junk"

/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Lander], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[Mana([Generic(2)]), TapSymbol, Sacrifice{objects:One(Source)}]}, limits:_{}, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:@and(ObjectFilter::Supertype(Basic), ObjectFilter::CardType(Land)), count:UpTo(Expr::Constant(1))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}})]} */
tn_lander ::= "Lander"

/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Map], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[Mana([Generic(1)]), TapSymbol, Sacrifice{objects:One(Source)}]}, limits:_{sorcery:true}, announcement:_{targets:[_{slot:0, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}]}, body:_{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Explore{object:Target{slot:0, index:0}}}}]}})]} */
tn_map ::= "Map"

/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Mutagen], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[Mana([Generic(1)]), TapSymbol, Sacrifice{objects:One(Source)}]}, limits:_{sorcery:true}, announcement:_{targets:[_{slot:0, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:CardType(Creature)}]}, body:_{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:0, index:0})), kind:PowerToughness([1, 1]), amount:Expr::Constant(1)}]}}]}})]} */
tn_mutagen ::= "Mutagen"

/* A Gold token sacrifices itself for one mana of any color, without tapping. */
/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Gold], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[Sacrifice{objects:One(Source)}]}, limits:_{}, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:ChooseOne([Amount{color:White, amount:Expr::Constant(1)}, Amount{color:Blue, amount:Expr::Constant(1)}, Amount{color:Black, amount:Expr::Constant(1)}, Amount{color:Red, amount:Expr::Constant(1)}, Amount{color:Green, amount:Expr::Constant(1)}])}}]}})]} */
tn_gold ::= "Gold"
/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Treasure], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[TapSymbol, Sacrifice{objects:One(Source)}]}, limits:_{}, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:ChooseOne([Amount{color:White, amount:Expr::Constant(1)}, Amount{color:Blue, amount:Expr::Constant(1)}, Amount{color:Black, amount:Expr::Constant(1)}, Amount{color:Red, amount:Expr::Constant(1)}, Amount{color:Green, amount:Expr::Constant(1)}])}}]}})]} */
tn_treasure ::= "Treasure"

/* A singular token phrase names the actual produced objects. Replacement effects
   can produce a batch, so native lowering chooses one member before attaching. */
clause_attach_created ::= attach_created_required | attach_created_optional

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$created_attachment_host, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Attach{attachments:$affected, host:Result{result:@prior, phase:After, index:0}}}] */
attach_created_required ::= "attach" affected "to" created_attachment_host

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:$attach_created_required}}] */
attach_created_optional ::= "you" "may" attach_created_required

/* A bare pronoun still needs current token focus. The explicit token noun
   names the prior produced batch even after another object was moved. */
created_attachment_host ::= created_attachment_pronoun | created_attachment_token

/* @sem ObjectSet::@created_reference_single */
created_attachment_pronoun ::= "it"

/* @sem ObjectSet::@created_named_reference */
/* @prefer value(Created) */
created_attachment_token ::= "that" "token"

/* Token copy effects use their own typed container; ordinary CopyOf effects
   cannot be substituted for these copiable token adjustments. */
/* @sem CopyException::AddCardTypes([Artifact]) */
token_copy_add_artifact ::= "it's" "an" "artifact" "in" "addition" "to" "its" "other" "types"

/* The written attachment is an entry state of the new Aura, not a later
   Attach action or a change to the ability holder. A target host is announced
   by whichever Spell/Activated/reflexive owner contains this operation; "it"
   names an object an earlier instruction already chose. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$role_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo($object_ref)]}}) */
create_role_attached ::= "create" role_token "attached" "to" object_ref
/* @sem TokenSpec::TokenSpec{amount:$token_amount, words:Rules, recipe:$role_recipe} */
role_token ::= token_amount role_recipe ("token" | "tokens")
/* A named Role's own abilities never scale with token quantity. */
role_recipe ::= sorcerer_role_recipe | young_hero_role_recipe | wicked_role_recipe | royal_role_recipe | monster_role_recipe | virtuous_role_recipe
/* @sem TokenRecipe::Defined{name:Explicit(Sorcerer), card_types:[Enchantment], subtypes:[Aura, Role], abilities:[Enchant{hosts:Permanents(CardType(Creature))}, Static{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Pump{power:Constant(1), toughness:Constant(1)}, GrantAbility(@scope(Ability::Triggered{event:Object{event:Attacks, objects:SameObject(Source)}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Scry{players:One(AbilityController), amount:Constant(1)}}]}}))]}]} */
sorcerer_role_recipe ::= "Sorcerer" "Role"
/* The granted attack trigger checks the enchanted creature's own toughness
   and puts the counter on the creature that attacked. */
/* @sem TokenRecipe::Defined{name:Explicit('Young Hero'), card_types:[Enchantment], subtypes:[Aura, Role], abilities:[Enchant{hosts:Permanents(CardType(Creature))}, Static{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[GrantAbility(@scope(Ability::Triggered{event:Object{event:Attacks, objects:SameObject(Source)}, intervening_if:ObjectMatches{object:Source, filter:Property{property:Toughness, test:NumberTest::Compare{comparison:LessOrEqual, value:Constant(3)}}}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(EventSubject)), kind:PowerToughness([1, 1]), amount:Constant(1)}]}}]}}))]}]} */
young_hero_role_recipe ::= "Young" "Hero" "Role"
/* The Wicked Role drains each opponent for 1 when it goes to a graveyard. */
/* @sem TokenRecipe::Defined{name:Explicit(Wicked), card_types:[Enchantment], subtypes:[Aura, Role], abilities:[Enchant{hosts:Permanents(CardType(Creature))}, Static(_{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Pump{power:Constant(1), toughness:Constant(1)}]}), @scope(Ability::Triggered{event:ZoneChange{objects:AllOf([SameObject(Source), OwnedBy(All)]), from:Battlefield, to:Graveyard}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:LoseLife{players:OpponentsOf(AbilityController), amount:Constant(1)}}]}})]} */
wicked_role_recipe ::= "Wicked" "Role"
/* The Royal Role grants ward {1}. */
/* @sem TokenRecipe::Defined{name:Explicit(Royal), card_types:[Enchantment], subtypes:[Aura, Role], abilities:[Enchant{hosts:Permanents(CardType(Creature))}, Static(_{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Pump{power:Constant(1), toughness:Constant(1)}, GrantKeyword(Ward{parts:[Mana([Generic(1)])]})]})]} */
royal_role_recipe ::= "Royal" "Role"
/* The Monster Role grants trample. */
/* @sem TokenRecipe::Defined{name:Explicit(Monster), card_types:[Enchantment], subtypes:[Aura, Role], abilities:[Enchant{hosts:Permanents(CardType(Creature))}, Static(_{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Pump{power:Constant(1), toughness:Constant(1)}, GrantKeyword(Trample)]})]} */
monster_role_recipe ::= "Monster" "Role"
/* The Virtuous Role counts the enchantments its creator controls. */
/* @sem TokenRecipe::Defined{name:Explicit(Virtuous), card_types:[Enchantment], subtypes:[Aura, Role], abilities:[Enchant{hosts:Permanents(CardType(Creature))}, Static(_{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Pump{power:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Enchantment), ControlledBy(One(AbilityController))])}), toughness:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Enchantment), ControlledBy(One(AbilityController))])})}]})]} */
virtuous_role_recipe ::= "Virtuous" "Role"

/* The named token is a vocabulary entry. Its variable characteristics are
   operands of its creation, independent of any other mode's target filter. */
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:Explicit('The Hollow Sentinel'), supertypes:[Legendary], card_types:[Artifact, Creature], subtypes:[Phyrexian, Golem], power_toughness:[$number, $number_2]}} */
token_hollow_sentinel ::= "The" "Hollow" "Sentinel" "," "a" "legendary" number "/" number "colorless" "Phyrexian" "Golem" "artifact" "creature" "token"

/* A Powerstone always produces one colorless mana. Its creation count and
   tapped arrival are operands of the surrounding token-creation operation. */
/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Powerstone], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[TapSymbol]}, limits:_{}, announcement:_{}, body:Program{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:Amount{color:Colorless, amount:Constant(1)}, restriction:Not(CastSpell(Not(CardType(Artifact))))}}]}})]} */
tn_powerstone ::= "Powerstone"

/* An explicit token name is part of the recipe, independently of its stats,
   colors and intrinsic abilities. It is not a reference to the creating card. */
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:Explicit(Cherubael), supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$number, $number_2], abilities:$token_ability_description}} */
token_cherubael ::= "Cherubael" "," "a" "legendary" number "/" number token_colors token_subtypes token_types "token" token_ability_description

/* The whole population supplies one creation amount, rather than a sequence
   of independently produced batches. The creator remains the controller. */
/* @sem Instruction::[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:@times($token_amount, Expr::CountPlayers(OpponentsOf(AbilityController))), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
clause_opponent_count_tokens ::= "for" "each" "opponent" "," "you" "create" token_amount token_recipe

/* Parley: every player reveals the top card of their library, the reward counts
   the nonland cards among those revealed, then every player draws a card. */
/* @sem () */
parley_reveal ::= "each" "player" "reveals" "the" "top" "card" "of" "their" "library" "." "for" "each" "nonland" "card" "revealed" "this" "way" ","
/* @sem () */
parley_draw ::= "." "then" "each" "player" "draws" "a" "card"
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:LibraryTops(All)}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:@times($token_amount, Expr::CountObjects(Matching{objects:Observed(@marked), filter:Not(CardType(Land))})), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}, Effect{result:@next, operation:Draw{players:All, amount:Constant(1)}}] */
instructions_parley_tokens ::= parley_reveal "you" "create" token_amount token_recipe parley_draw
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:LibraryTops(All)}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:@times($token_amount, Expr::CountObjects(Matching{objects:Observed(@marked), filter:Not(CardType(Land))})), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}, Effect{result:@next, operation:Draw{players:All, amount:Constant(1)}}] */
instructions_parley_named_tokens ::= parley_reveal "you" "create" token_amount token_named_recipe "token" parley_draw
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:LibraryTops(All)}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:@times($token_amount, Expr::CountObjects(Matching{objects:Observed(@marked), filter:Not(CardType(Land))})), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}})}, Effect{result:@next, operation:Draw{players:All, amount:Constant(1)}}] */
instructions_parley_tapped_tokens ::= parley_reveal "you" "create" token_amount "tapped" token_named_recipe "token" parley_draw
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:LibraryTops(All)}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:Investigate{times:Expr::CountObjects(Matching{objects:Observed(@marked), filter:Not(CardType(Land))})}}}, Effect{result:@next, operation:Draw{players:All, amount:Constant(1)}}] */
instructions_parley_investigate ::= parley_reveal "you" "investigate" parley_draw

/* A scalar destroyed target provides pre-move controller information, even if
   destruction moves it or changes which object its target reference locates. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:One($target_object), regeneration:true}}, Effect{result:@next, operation:CreateTokens{players:One(ControllerOf(Result{result:@prior, phase:Before, index:0})), tokens:$token_groups_tapped, entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}}] */
clause_destroy_controller_tapped_tokens ::= "destroy" target_object "." "its" "controller" "creates" token_groups_tapped

/* Retained mined entry points delegate to this owned construction. Token
   quantity never scales the mana ability of each individual Powerstone. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_amount, words:Rules, recipe:$tn_powerstone}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}) */
create_powerstones_tapped ::= "create" token_amount "tapped" tn_powerstone ("token" | "tokens")

/* The entry states belong to the creation batch, including every replacement
   copy. Later token anaphors use that exact Created result. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:[]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_copy_tapped_attacking ::= "create" "a" "tapped" "and" "attacking" "token" "that's" "a" "copy" "of" object_ref

/* The counters on the written source are counted at resolution, independently
   of the created batch that receives the new counters. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($created_reference), kind:$counter_kind, amount:CountCounters{recipients:Objects(One($object_ref)), kind:$counter_kind_2, information:CurrentOrLastKnown}}]} */
put_created_counters_for_counters ::= "put" ("a" | "one") counter_kind "counter" "on" created_reference "for" "each" counter_kind "counter" "on" object_ref

/* Explicit names and the token characteristics are independent operands. */
token_explicit_legendary ::= token_explicit_legendary_plain | token_explicit_legendary_with
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:$explicit_legendary_name, supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2]}} */
token_explicit_legendary_plain ::= explicit_legendary_name "," counter_amount "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token"
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:$explicit_legendary_name, supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2], abilities:$token_ability_description}} */
token_explicit_legendary_with ::= explicit_legendary_name "," counter_amount "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token" token_ability_description
explicit_legendary_name ::= explicit_voja | explicit_voja_fenstalker | explicit_voja_friend | explicit_token_tiny | explicit_token_stangg_twin | explicit_token_tuktuk_returned | explicit_token_urami | explicit_token_darkstar | explicit_token_karox | explicit_token_marit_lage | explicit_token_angelo
/* @sem TokenName::Explicit(Tiny) */
explicit_token_tiny ::= "Tiny"
/* @sem TokenName::Explicit('Stangg Twin') */
explicit_token_stangg_twin ::= SELF_NAME "Twin"
/* @sem TokenName::Explicit('Tuktuk the Returned') */
explicit_token_tuktuk_returned ::= SELF_NAME "the" "Returned"

/* Explicit names are independent of the token's characteristics and abilities. */
/* @sem TokenRecipe::Defined(_{name:Explicit($created_token_name), colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2]}) */
token_recipe_explicit_name ::= token_stat "/" token_stat token_colors token_subtypes token_types "token" "named" created_token_name

/* @sem TokenRecipe::Defined(_{name:Explicit($created_token_name), colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2], abilities:$token_abilities}) */
token_recipe_explicit_name_with ::= token_stat "/" token_stat token_colors token_subtypes token_types "token" "with" token_abilities "named" created_token_name

/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:[White, Blue, Black, Red, Green], card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2]}) */
token_recipe_all_colors ::= token_stat "/" token_stat token_subtypes token_types "token" "that's" "all" "colors"

/* @sem CardType::[Enchantment, Artifact, Creature] */
tt_enchantment_artifact_creature ::= "enchantment" "artifact" "creature"

created_token_name ::= created_name_minor_demon | created_name_kelp | created_name_ballistic_boulder | created_name_blue_horror | card_name_storm_crow | created_name_wood | created_name_wasp | created_name_butterfly | created_name_metallic_sliver | created_name_feather | card_name_kobolds_of_kher_keep | created_name_kobolds | created_name_carnivore

/* @sem String::'Wood' */
created_name_wood ::= "Wood"

/* @sem String::'Wasp' */
created_name_wasp ::= "Wasp"

/* @sem String::'Butterfly' */
created_name_butterfly ::= "Butterfly"

/* @sem String::'Metallic Sliver' */
created_name_metallic_sliver ::= "Metallic" "Sliver"

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, AttachedTo(SameObject(Source))])}) */
count_attached_to_him ::= filter_phrase "attached" "to" "him"

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController)), AnyOf([$filter_phrase_2, $filter_phrase_3])])}) */
count_controlled_either ::= filter_phrase "you" "control" "that's" "a" filter_phrase "or" "a" filter_phrase

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Attacking, Modified, $filter_phrase, ControlledBy(One(AbilityController))])} */
attacking_modified_controlled ::= "attacking" "modified" filter_phrase "you" "control"

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:CopyEach{objects:$attacking_modified_controlled, exceptions:[]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_attacking_copies_each ::= "for" "each" attacking_modified_controlled "," "create" counter_amount "tapped" "and" "attacking" "token" "that's" "a" "copy" "of" "that" "creature"

/* @sem Instruction::[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyEach{objects:$each_opponent_targets, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
clause_copy_each_opponent_target ::= "for" "each" "opponent" "," "you" "create" "a" "token" "that's" "a" "copy" "of" each_opponent_targets

/* The exiled population and copy exceptions retain their independent operands. */
/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)} */
token_exiled_card ::= "a" "card" "exiled" "with" object_ref

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_phrase, ExiledWith($object_ref)])} */
token_exiled_filtered_card ::= "a" filter_phrase "card" "exiled" "with" object_ref

/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyOne{objects:$token_exiled_card, exceptions:[]}} */
token_copy_exiled_plain ::= "a" "token" "that's" "a" "copy" "of" token_exiled_card

/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyOne{objects:$token_exiled_filtered_card, exceptions:$token_copy_singular_exceptions}} */
token_copy_exiled_singular ::= "a" "token" "that's" "a" "copy" "of" token_exiled_filtered_card "," "except" token_copy_singular_exceptions

/* @sem TokenSpec::TokenSpec{amount:$count, words:CreatingEffect, recipe:CopyOne{objects:$token_exiled_filtered_card, exceptions:$token_copy_plural_exceptions}} */
token_copy_exiled_plural ::= count "tokens" "that" "are" "copies" "of" token_exiled_filtered_card "," "except" token_copy_plural_exceptions

/* @sem Vec<CopyException>::[CopyException::SetPowerToughness{power:$value, toughness:$value_2}, CopyException::AddAbilities([Keyword($keyword_value)]), CopyException::AddAbilities([Keyword($keyword_value_2)])] */
token_copy_singular_stats ::= "it's" value "/" value "and" "has" keyword_value "and" keyword_value

/* @sem Vec<CopyException>::[CopyException::AddAbilities([Keyword($keyword_value)]), CopyException::AddAbilities([Keyword($keyword_value_2)])] */
token_copy_singular_keywords ::= "it" "has" keyword_value "and" keyword_value

token_copy_singular_exceptions ::= token_copy_singular_stats | token_copy_singular_keywords

/* @sem Vec<CopyException>::[CopyException::SetPowerToughness{power:$value, toughness:$value_2}, CopyException::AddAbilities([Keyword($keyword_value)])] */
token_copy_plural_exceptions ::= "they're" value "/" value "and" "have" keyword_value

/* The crew ability belongs to the created token, not the creator. */
/* @sem Ability::@scope($crew_ability) */
token_crew ::= crew_ability

/* @sem CardType::[Artifact] */
tt_artifact ::= "artifact"

/* Named and unnamed recipes share the same characteristic and ability phrases. */
/* @sem TokenRecipe::Defined(_{name:Explicit($vehicle_token_name), colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2]}) */
token_recipe_named ::= token_stat "/" token_stat token_colors token_subtypes token_types "token" "named" vehicle_token_name

/* @sem String::'Zeppelin' */
vehicle_token_name ::= "Zeppelin"

/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:Explicit('The Blackjack'), supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2], abilities:$token_ability_description}} */
token_legendary_named ::= "The" "Blackjack" "," "a" "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token" token_ability_description

/* The count is defined after the recipe; it counts opponents independently by hand size. */
/* @sem TokenSpec::TokenSpec{amount:$opponents_hand_threshold_count, words:CreatingEffect, recipe:$token_recipe} */
token_defined_opponent_hand_count ::= "X" token_recipe "," "where" "X" "is" opponents_hand_threshold_count

/* @sem Expr::CountPlayers(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:CountObjects(Zone(_{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any})), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}}}])) */
opponents_hand_threshold_count ::= "the" "number" "of" "your" "opponents" "with" count "or" "more" "cards" "in" "hand"

/* The target group and each copy quantity are independent operands. */
/* @sem Instruction::[ForEachObject{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly($number), filter:Any})), binding:0, body:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$number_2, words:CreatingEffect, recipe:Copy{object:Bound(0), exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}] */
instructions_each_target_copies ::= "for" "each" "of" number "target" "permanents" "," "create" number "tokens" "that" "are" "copies" "of" "that" "permanent"

/* The counted permanents and recipient share the loop's player binding. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(Bound(0)), tokens:[_{amount:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(Tapped), $filter_phrase, ControlledBy(One(Bound(0)))])}), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}] */
clause_players_create_per_untapped ::= players_singular "creates" "a" token_recipe "for" "each" "untapped" filter_phrase "they" "control"

/* The selected opponents remain the controllers of the counted population. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:AnyNumber, filter:Any, players:OpponentsOf(AbilityController)})))])}), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
instructions_chosen_opponents_tokens ::= "choose" "any" "number" "of" "target" "opponents" "." "create" "X" token_recipe "," "where" "X" "is" "the" "number" "of" filter_plural "those" "opponents" "control"

/* Each alternative is a separate action and carries its own token recipe. */
/* @sem Operation::ChooseAtRandom(_{kind:Action, options:[$random_green_option, $random_green_option_2, $random_green_option_3, $random_green_option_4]}) */
random_green_token_choice ::= "create" "a" "green" "creature" "token" "that's" random_green_option "," random_green_option "," random_green_option "," "or" random_green_option "," "chosen" "at" "random"

random_green_option ::= random_green_plain | random_green_keyword

/* @sem Operand::List([Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:[Green], card_types:[Creature], subtypes:[@subtype_name($subtype)], power_toughness:[$value, $value_2]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}]) */
random_green_plain ::= counter_amount value "/" value subtype

/* @sem Operand::List([Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:[Green], card_types:[Creature], subtypes:[@subtype_name($subtype)], power_toughness:[$value, $value_2], abilities:[Keyword($keyword_value)]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}]) */
random_green_keyword ::= counter_amount value "/" value subtype "with" keyword_value

/* A leading spell count is the controller's cast-event history. */
/* @sem Expr::EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:Any}, window:ThisTurn, measure:Occurrences} */
count_spells_cast_this_turn ::= "spell" "you've" "cast" "this" "turn"

/* The same defined quantity supplies both token characteristics. */
/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_spell_max, $token_spell_max], abilities:$token_abilities}) */
token_recipe_history_max ::= "X" "/" "X" token_colors token_subtypes token_types "token" "with" token_abilities "," "where" "X" "is" token_spell_max

/* @sem Expr::EventHistory{event:Spell{event:Cast, players:All, spells:AllOf([$token_spell_history_filter, Cast{by:One(AbilityController)}])}, window:ThisTurn, measure:Property([ManaValue, Maximum])} */
token_spell_max ::= "the" "greatest" "mana" "value" "among" token_spell_history_filter "spells" "you've" "cast" "this" "turn"

/* @sem ObjectFilter::AnyOf([$spell_adjective, $spell_adjective_2]) */
token_spell_history_filter ::= spell_adjective "and" spell_adjective

/* The separate entry sentence modifies the creation itself. The name in the
   singular form is fixed on both sides, so it cannot name an unrelated token. */
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:Explicit(Ragavan), supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2]}} */
attacking_ragavan_spec ::= "Ragavan" "," counter_amount "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token"

/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[$attacking_ragavan_spec], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}} */
create_named_attacking_sentence ::= "create" attacking_ragavan_spec "." "Ragavan" "enters" "tapped" "and" "attacking"

/* The historical count is self-contained: receipt-derived counts require a
   producer proof and are deliberately excluded from this phrase. */
/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$count_each_discarded_turn, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:$token_copy_exception}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}} */
create_counted_copy_attacking_sentence ::= "for" "each" count_each_discarded_turn "," "create" "a" "token" "that's" "a" "copy" "of" object_ref "," "except" token_copy_exception "." "the" "tokens" "enter" "tapped" "and" "attacking"

/* @sem Vec<CopyException>::[CopyException::RemoveSupertypes([Legendary])] */
token_copy_exception ::= "the" "token" "isn't" "legendary"

/* @sem Instruction::Effect{result:@next, operation:CreateDelayedTrigger{event:$token_cleanup_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Created(0), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}} */
token_cleanup_singular ::= "exile" "that" "token" "at" token_cleanup_event

/* @sem Instruction::Effect{result:@next, operation:CreateDelayedTrigger{event:$token_cleanup_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Created(0), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}} */
token_cleanup_plural ::= "exile" "the" "tokens" "at" token_cleanup_event

token_cleanup_event ::= turn_end_combat | token_cleanup_end_step

/* @sem EventSpec::Turn{point:EndStepBegins, players:All} */
token_cleanup_end_step ::= "the" "beginning" "of" "the" "next" "end" "step"

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$create_named_attacking_sentence}, $token_cleanup_singular]}} */
triggered_named_attacking_token_cleanup ::= event_clause "," create_named_attacking_sentence "." token_cleanup_singular "."

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$create_counted_copy_attacking_sentence}, $token_cleanup_plural]}} */
triggered_counted_copy_attacking_cleanup ::= event_clause "," create_counted_copy_attacking_sentence "." token_cleanup_plural "."

/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Enchantment], subtypes:[Shard], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[Mana([Generic(2)]), Sacrifice{objects:One(Source)}]}, limits:_{}, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:Scry{players:One(AbilityController), amount:Constant(1)}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Constant(1)}}]}})]} */
tn_shard ::= "Shard"

/* The singular token and all three options share this creation receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, ChooseOne{decider:AbilityController, options:[Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@marked)), kind:$counter_kind, amount:$counter_amount}]}}]}, Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@marked)), kind:$counter_kind_2, amount:$counter_amount_2}]}}]}, Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@marked)), kind:$counter_kind_3, amount:$counter_amount_3}]}}]}]}] */
clause_created_counter_choice ::= "create" "a" token_recipe "." "put" "your" "choice" "of" counter_amount counter_kind "counter" "," counter_amount counter_kind "counter" "," "or" counter_amount counter_kind "counter" "on" "it"

/* The mill operation is part of the same contract as its transition receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:Mill{players:One(AbilityController), amount:$card_count}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@last_result, phase:After}, filter:$adjective_color}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@marked)), kind:$counter_kind, amount:$counter_amount}]}}]}, otherwise:Program{}}] */
clause_created_mill_counter ::= "create" "a" token_recipe "," "then" "mill" card_count "." "put" counter_amount counter_kind "counter" "on" "the" "token" "if" "a" adjective_color "card" "was" "milled" "this" "way"

/* The announced targets are copied individually; the result binds the created batch. */
/* @sem Instruction::[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyEach{objects:$copy_chosen_creatures, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
clause_copy_chosen_creatures ::= "choose" copy_chosen_creatures "." "for" "each" "of" "those" "creatures" "," "create" "a" "token" "that's" "a" "copy" "of" "that" "creature"

/* @sem Instruction::[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:CopyEach{objects:$copy_chosen_creatures, exceptions:[CopyException::AddAbilities([Keyword($keyword_value)])]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
clause_copy_chosen_creatures_with_keyword ::= "choose" copy_chosen_creatures "." "for" "each" "of" "them" "," "create" token_copy_single "that" "creature" "," "except" "it" "has" keyword_value

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:$plural_target_count_any, filter:@and(ObjectFilter::CardType(Creature), $copy_chosen_controller)})) */
copy_chosen_creatures ::= plural_target_count_any "target" "creatures" copy_chosen_controller

/* @sem ObjectFilter::ControlledBy(One(AbilityController)) */
copy_chosen_controller_own ::= "you" "control"

/* @sem ObjectFilter::ControlledBy(OthersThan(AbilityController)) */
copy_chosen_controller_other ::= "you" "don't" "control"

copy_chosen_controller ::= copy_chosen_controller_own | copy_chosen_controller_other

/* The cleanup refers to the batch created by the preceding copy instruction. */
/* @sem Instruction::[...$clause_copy_chosen_creatures_with_keyword, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Move{objects:$created_batch_reference, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}] */
instructions_copy_chosen_keyword_cleanup ::= clause_copy_chosen_creatures_with_keyword "." "exile" created_batch_reference "at" "the" "beginning" "of" "the" "next" "end" "step"

/* @sem String::'Feather' */
created_name_feather ::= "Feather"

/* Both token statistics refer to the power of the devoured event object. */
/* @sem TokenSpec::TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[Earlier{what:Devoured, measure:Of(Power)}, Earlier{what:Devoured, measure:Of(Power)}]}} */
token_devoured_power ::= token_amount "X" "/" "X" token_colors token_subtypes token_types "token" "," "where" "X" "is" "the" "devoured" "creature's" "power"

/* @sem TokenRecipe::Named('Spellgorger Weird') */
tn_spellgorger_weird ::= "Spellgorger" "Weird"

/* The counted population also identifies the different opponents fought by
   the created batch. Both noun forms must denote the same filter. */
/* @sem Instruction::[Effect{result:@mark, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($filter_phrase, $filter_plural), ControlledBy(OpponentsOf(AbilityController))])}), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}, Effect{result:@next, operation:FightEach{fighters:Created(@marked), others:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($filter_phrase, $filter_plural), ControlledBy(OpponentsOf(AbilityController))])}}}] */
create_each_opponent_and_fight ::= "for" "each" filter_phrase "your" "opponents" "control" "," "create" "a" token_recipe "." "each" "of" "those" "tokens" "fights" "a" "different" "one" "of" "those" filter_plural

/* Named rules-defined token recipes compose with the ordinary arrival and amount. */
/* @sem TokenRecipe::Named(Mutavault) */
tn_mutavault ::= "Mutavault"
/* @sem TokenRecipe::Named(Tarmogoyf) */
tn_tarmogoyf ::= "Tarmogoyf"

/* Tapped copy creation shares the copy target and exception operands. */
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:[]}} */
token_copy_plain_tapped ::= "a" "tapped" "token" "that's" "a" "copy" "of" object_ref
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:$copy_exceptions_plain}} */
token_copy_modified_tapped ::= "a" "tapped" "token" "that's" "a" "copy" "of" object_ref "," "except" copy_exceptions_plain

/* A commander copy selects from the owned commander population. */
/* @sem TokenSpec::TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:CopyOne{objects:AnyZone(AllOf([State(Commander), OwnedBy(One(AbilityController))])), exceptions:[$copy_not_legendary]}} */
token_copy_commander ::= token_copy_single "your" "commander" "," "except" copy_not_legendary
/* @sem CopyException::RemoveSupertypes([Legendary]) */
copy_not_legendary ::= "it's" "not" "legendary"

/* A copy exception specifies the copied token's replacement characteristics. */
/* @sem Vec<CopyException>::[CopyException::SetPowerToughness{power:$value, toughness:$value_2}, CopyException::Colors{mode:Set, colors:Listed($token_colors)}, CopyException::SetTypes{card_types:[Creature], subtypes:$token_subtypes}] */
copy_token_characteristics ::= "it's" "a" value "/" value token_colors token_subtypes
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:$copy_token_characteristics}} */
token_copy_characteristics_tapped ::= "a" "tapped" "token" "that's" "a" "copy" "of" object_ref "," "except" copy_token_characteristics

/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:Explicit('First Mate Ragavan'), supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2]}} */
cast_alternative_token ::= "First" "Mate" "Ragavan" "," counter_amount "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token"

/* A named token's death trigger belongs to that token's own holder. */
/* @sem TokenName::Explicit(Smaug) */
explicit_token_smaug ::= "Smaug"

/* @sem Ability::Triggered{event:ZoneChange{objects:SameObject(Source), from:Battlefield, to:Graveyard}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$chapter_plural_token_count, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}} */
token_named_death_treasure ::= "when" "Smaug" "dies" "," "create" chapter_plural_token_count token_named_recipe "tokens" "."

/* Named legendary token with two keywords and an intrinsic quoted trigger. */
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:$explicit_token_smaug, supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2], abilities:[Keyword($keyword_name), Keyword($keyword_name_2), @holder($token_named_death_treasure)]}} */
chapter_quoted_token ::= explicit_token_smaug "," counter_amount "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token" "with" keyword_name "," keyword_name "," "and" '"' token_named_death_treasure '"'

chapter_plural_token_count ::= n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10 | n11 | n12 | n13 | n14 | n15 | n20 | n30

/* Names and token characteristics are independent operands. */
