/* Token creation. A token's words list colors, subtypes, card types and abilities in that order. */

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:$token_groups, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_base ::= "create" token_groups

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:$token_groups, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_third ::= "creates" token_groups

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:$token_groups_tapped, entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}) */
create_tapped_base ::= "create" token_groups_tapped

/* "For each land you control, create a Treasure token": a leading count is the
   amount of the one token named after it. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:$leading_count_each, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_each_defined_leading ::= "for" "each" leading_count_each "," "create" ("a" | "an") token_recipe

/* "For each creature token you control, create a token that's a copy of that creature":
   one copy of each such permanent. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyEach{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_copy_each_leading ::= "for" "each" filter_phrase "," "create" "a" "token" "that's" "a" "copy" "of" copy_each_referent
/* @sem () */
copy_each_referent ::= "it" | "that" "creature" | "that" "permanent"
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:$leading_count_each, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_each_named_leading ::= "for" "each" leading_count_each "," "create" ("a" | "an") token_named_recipe "token"
/* Receipt counts need a separately proved producer; these counts are live or
   use the explicitly named object's current-or-last-known counters. */
leading_count_each ::= count_each_you_put_counter_on_this_turn | count_each_vote | count_spells_cast_this_turn | count_attached_to_him | count_controlled_either | count_each_permanent | count_each_other | count_each_graveyard | count_each_card_graveyard | leading_count_object_counter | count_each_you_controlled_died

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:$token_groups_tapped, entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}) */
create_tapped_third ::= "creates" token_groups_tapped

/* Entry states belong to the creation operation, rather than later tap or
   combat instructions. The ordinary subject binder supplies the creator. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:$token_groups, entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_attacking_base ::= "create" token_groups "that" "are" "tapped" "and" "attacking"

/* @sem TokenSpec::TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:$token_recipe} */
token_group_attacking ::= token_amount "tapped" "and" "attacking" token_recipe

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[$token_group_attacking], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_attacking_before_recipe ::= "create" token_group_attacking

/* The count determines the batch size. The entry attack's defender is
   independent of the opponents in the history count. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:$preposed_attacking_quantity, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_attacking_quantity ::= "for" "each" preposed_attacking_quantity "," "create" ("a" | "an") "tapped" "and" "attacking" token_recipe

preposed_attacking_quantity ::= count_each_opponent_attacked_turn | count_each_attacking_creature

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Attacking, $filter_phrase)}) */
count_each_attacking_creature ::= "attacking" filter_phrase

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:@apply(PlayerSet::One(AbilityController), $create_attacking_before_recipe)}, Effect{result:@next, operation:CreateDelayedTrigger{event:$turn_end_combat, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Move{objects:Created(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]}}}]} */
program_exile_attacking_token_end_combat ::= create_attacking_before_recipe "." "exile" "that" "token" "at" turn_end_combat "."

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:$token_groups, entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_attacking_third ::= "creates" token_groups "that" "are" "tapped" "and" "attacking"

/* A dependent token sentence stays with the conditional creation. Ordinary
   following instructions remain outside the payment branch. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[$conditional_token_creation, ...$conditional_token_followups]}, otherwise:Program{}}] */
clause_paid_token_followups ::= "you" "may" payment "." "if" "you" "do" "," conditional_token_creation "." conditional_token_followups

/* @sem Instruction::Effect{result:@next, operation:@apply(PlayerSet::One(AbilityController), $conditional_creation_operation)} */
conditional_token_creation ::= conditional_creation_operation

conditional_creation_operation ::= create_base | create_tapped_base | create_attacking_base

/* @sem Instruction::[$conditional_token_followup] */
conditional_token_followups_one ::= conditional_token_followup
/* @sem Instruction::[$conditional_token_followup, ...$conditional_token_followups] */
conditional_token_followups_more ::= conditional_token_followup "." conditional_token_followups
conditional_token_followups ::= conditional_token_gains_exile | conditional_token_grant_sacrifice | conditional_token_grant_exile | conditional_token_followups_one | conditional_token_followups_more

conditional_token_followup ::= conditional_token_change | conditional_token_grant | conditional_token_cleanup | conditional_token_exile_named

/* @sem Instruction::Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($created_reference), changes:$changes, duration:$duration, evaluation:Snapshot}} */
conditional_token_change ::= created_reference changes duration

/* An undated grant lasts indefinitely; its holder is the created token. */
/* @sem Instruction::Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($created_reference), changes:$change_grant, duration:Indefinite, evaluation:Snapshot}} */
conditional_token_grant ::= created_reference change_grant
/* "Create a token that's a copy of target creature you control. It gains haste.": an
   undated grant to the tokens just created lasts indefinitely. The subject names the
   created batch, so the clause refuses where nothing was created. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($created_gains_subject), changes:$grants, duration:Indefinite, evaluation:Snapshot}}] */
clause_created_gains ::= created_gains_subject "gains" grants
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($created_gain_subject), changes:$grants, duration:Indefinite, evaluation:Snapshot}}] */
clause_created_gain ::= created_gain_subject "gain" grants
created_gains_subject ::= created_ordinary_singular | created_named_reference
created_gain_subject ::= created_group_reference | created_batch_reference

/* The condition is tested when the delayed ability resolves. It neither gates
   registration nor becomes an intervening-if test on the delayed trigger. */
/* @sem Instruction::Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[If{condition:Not($condition), then:Program{instructions:[Effect{result:@next, operation:Move{objects:$created_reference, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{}}]}}} */
conditional_token_cleanup ::= "at" "the" "beginning" "of" "the" "next" "end" "step" "," "exile" created_reference "unless" condition

/* A coordinated list is one simultaneous token-creation batch. */
token_groups ::= token_groups_one | token_groups_pair | token_groups_list

/* @sem TokenSpec::[$token_group] */
token_groups_one ::= token_group

/* @sem TokenSpec::[$token_group, $token_group_2] */
token_groups_pair ::= token_group "and" token_group

/* @sem TokenSpec::[$token_group, ...$token_groups_tail] */
token_groups_list ::= token_group "," token_groups_tail

token_groups_tail ::= token_groups_last | token_groups_list

/* @sem TokenSpec::[$token_group] */
token_groups_last ::= "and" token_group

token_groups_tapped ::= token_groups_tapped_one | token_groups_tapped_pair | token_groups_tapped_list

/* @sem TokenSpec::[$token_group_tapped] */
token_groups_tapped_one ::= token_group_tapped

/* @sem TokenSpec::[$token_group_tapped, $token_group_tapped_2] */
token_groups_tapped_pair ::= token_group_tapped "and" token_group_tapped

/* @sem TokenSpec::[$token_group_tapped, ...$token_groups_tapped_tail] */
token_groups_tapped_list ::= token_group_tapped "," token_groups_tapped_tail

token_groups_tapped_tail ::= token_groups_tapped_last | token_groups_tapped_list

/* @sem TokenSpec::[$token_group_tapped] */
token_groups_tapped_last ::= "and" token_group_tapped

token_group ::= token_zabu_landfall | token_legendary_titled_no_ability | token_defined_source_stat_quoted | token_legendary_titled | token_history_quoted_other | named_legendary_equipment_token | token_named_created_history | token_defined_x_attacking_you | named_legendary_scoped_token | token_defined_x_where | token_walker_group | token_explicit_legendary | token_cherubael | token_hollow_sentinel | token_defined | token_defined_each | token_defined_equal | token_named | token_named_each | token_copy | token_legendary_named | token_defined_opponent_hand_count | token_devoured_power | token_named_equal | token_named_half_event_x | token_descents_group | token_defined_mana_each | token_defined_equal_after | token_defined_damage_x | token_defined_damage_x_quoted | named_legendary_defining_token | token_named_die_equal | token_named_equal_vote_total | token_variable_square_product | token_defined_named_graveyard | token_copy_stats_added_type | token_named_equal_its_stat | token_defined_live_graveyard_single | token_defined_live_graveyard_plural | token_named_mana_spent_equal | token_defined_equal_opponent_comparison | token_named_equal_nontoken_entries | token_defined_with_opponent_control_count_h3

token_copy ::= token_copy_enchanted_stats | token_copy_characteristics_it | token_copy_plural_dragon | token_copy_plain | token_copy_population | token_copy_modified | token_copy_exiled_plain | token_copy_exiled_singular | token_copy_exiled_plural | token_copy_commander | token_copy_modified_plural | token_copy_exiled_modified | token_copy_random_oracle | token_copy_random_mana_card | token_copy_characteristics | token_copy_characteristics_target | token_copy_nonlegendary_singular | token_copy_half_creature | token_copy_artifact_unpunctuated | token_copy_explicit_token_exception

/* @sem TokenSpec::TokenSpec{amount:$token_copy_quantity, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:[]}} */
token_copy_plain ::= token_copy_quantity object_ref

/* The quantity describes the tokens; the article before copy is literal. */
token_copy_quantity ::= token_copy_single | token_copy_plural
/* @sem Expr::Constant(1) */
token_copy_single ::= "a" "token" "that's" "a" "copy" "of"
/* @sem $count */
token_copy_plural ::= count "tokens" "that" "are" "copies" "of"

/* @sem TokenSpec::TokenSpec{amount:$token_copy_quantity, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:$copy_exceptions_plain}} */
token_copy_modified ::= token_copy_quantity object_ref "," "except" copy_exceptions_plain

/* The word `tapped` follows the count, so the count and description stay one phrase. */
token_group_tapped ::= token_named_other_tapped | token_defined_tapped | token_defined_each_tapped | token_named_tapped | token_named_equal_tapped | token_copy_plain_tapped | token_copy_plural_tapped | token_copy_modified_tapped | token_copy_characteristics_tapped | token_defined_x_tapped | token_history_x_tapped

/* @sem TokenSpec::TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:$token_recipe} */
token_defined ::= token_amount token_recipe

/* @sem TokenSpec::TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:$token_recipe} */
token_defined_tapped ::= token_amount "tapped" token_recipe

/* @sem TokenSpec::TokenSpec{amount:$count_each, words:CreatingEffect, recipe:$token_recipe} */
token_defined_each ::= ("a" | "an") token_recipe "for" "each" count_each

/* @sem TokenSpec::TokenSpec{amount:$count_each, words:CreatingEffect, recipe:$token_recipe} */
token_defined_each_tapped ::= ("a" | "an") "tapped" token_recipe "for" "each" count_each

/* @sem TokenSpec::TokenSpec{amount:$value, words:CreatingEffect, recipe:$token_recipe} */
token_defined_equal ::= "a" "number" "of" token_recipe "equal" "to" value

token_amount ::= counter_amount | token_that_many | token_amount_difference | token_amount_twice

/* @sem @that_many */
token_that_many ::= "that" "many"

/* @sem TokenSpec::TokenSpec{amount:$token_amount, words:Rules, recipe:$token_named_recipe} */
token_named ::= token_amount token_named_recipe ("token" | "tokens")

/* @sem TokenSpec::TokenSpec{amount:$token_amount, words:Rules, recipe:$token_named_recipe} */
token_named_tapped ::= token_amount "tapped" token_named_recipe ("token" | "tokens")

/* @sem TokenSpec::TokenSpec{amount:$count_each, words:Rules, recipe:$token_named_recipe} */
token_named_each ::= ("a" | "an") token_named_recipe "token" "for" "each" count_each

/* A named token is created for each member of a live other-object population. */
/* @sem TokenSpec::TokenSpec{amount:$count_each_other, words:Rules, recipe:$token_named_recipe} */
token_named_other_tapped ::= "a" "tapped" token_named_recipe "token" "for" "each" count_each_other

token_recipe ::= token_statless_named_before_abilities | token_artifact_stats_implicit_color_with | named_equipment_token_pump | named_snow_artifact_recipe | token_recipe_rock_equipment | token_recipe_quoted_defining_offset | token_recipe_equal_history | token_recipe_post_colors | token_recipe_explicit_plural | token_recipe_history_max | token_recipe_base | token_recipe_with | token_recipe_explicit_name | token_recipe_explicit_name_with | token_recipe_all_colors | token_recipe_all_colors_with | token_recipe_named_all_colors_with | token_recipe_named_all_colors | token_recipe_basic_land_named | token_recipe_basic_land_named_plural | token_recipe_life_paid_entry | token_recipe_unlocked_doors | token_recipe_named_statless_with | token_recipe_statless_keyword_defining | token_recipe_equal_stats | token_named_before_abilities

token_recipe_base ::= token_recipe_named_subtyped_statless | token_recipe_named_subtyped_land | token_recipe_statless_named | token_recipe_statless_named_plural | token_recipe_explicit_name | token_recipe_named | token_recipe_plain | token_recipe_no_subtype | token_recipe_statless | token_recipe_explicit_name_plural | token_recipe_explicit_plaguebearer

/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2]}) */
token_recipe_plain ::= token_stat "/" token_stat token_colors token_subtypes token_types ("token" | "tokens")

/* @sem TokenRecipe::@token_abilities($token_recipe_base, $token_ability_description) */
token_recipe_with ::= token_recipe_base token_ability_description

/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2]}) */
token_recipe_no_subtype ::= token_stat "/" token_stat token_colors token_types ("token" | "tokens")

/* A characteristic-defining ability can supply statistics instead of numerals. */
/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[Expr::Constant(0), Expr::Constant(0)]}) */
token_recipe_statless ::= token_colors token_subtypes token_types ("token" | "tokens")

/* Oracle's following sentence states intrinsic token abilities too. It is part
   of the recipe, rather than an instruction granting an ability after creation. */
token_ability_description ::= token_abilities_with | token_abilities_after | token_abilities_with_more | token_abilities_after_more

/* @sem $token_abilities */
token_abilities_with ::= "with" token_abilities

/* @sem $token_abilities */
token_abilities_after ::= "." token_ability_subject token_abilities

/* @sem Ability::[...$token_abilities, ...$token_ability_description] */
token_abilities_with_more ::= "with" token_abilities token_ability_description

/* @sem Ability::[...$token_abilities, ...$token_ability_description] */
token_abilities_after_more ::= "." token_ability_subject token_abilities token_ability_description

/* @sem () */
token_ability_subject ::= "it" "has" | "they" "have"

token_abilities ::= token_intrinsic_keyword_equipment | token_ability_one | token_ability_two | token_ability_list | reminder_group_abilities

/* @sem Ability::[$token_ability] */
token_ability_one ::= token_ability

/* @sem Ability::[$token_ability, $token_ability_2] */
token_ability_two ::= token_ability "and" token_ability

/* @sem Ability::[$token_ability, ...$token_ability_tail] */
token_ability_list ::= token_ability "," token_ability_tail

token_ability_tail ::= token_ability_last | token_ability_list

/* @sem Ability::[$token_ability] */
token_ability_last ::= "and" token_ability

token_ability ::= token_crew | keyword_ability | token_quoted | token_toxic

/* @sem Ability::Mechanic{mechanic:Toxic, amount:$number} */
token_toxic ::= "toxic" number

/* What is quoted is a whole ability: "this" is the token and "you" its controller. */
/* @sem Ability::@holder($token_ability_body) */
token_quoted ::= '"' token_ability_body '"'

token_ability_body ::= token_targeted_sacrifice | token_upkeep_sacrifice_failure | token_entry_damage_quoted | static_ability | max_speed_ability | token_ability_sentence | keyword_ability | mined_ability | token_labelled_keyword | token_cannot_be_enchanted | activated_ability | token_prevent_self_damage | token_controlled_subtype_keyword

/* A characteristic-defining ability here describes the token itself. */
/* @sem Ability::Static{kind:CharacteristicDefining{contributes_to_color_identity:true}, affected:Objects(One(ObjectRef::Source)), changes:[Change::SetBasePowerToughness{power:$value, toughness:$value}]} */
token_defining_both ::= holder_possessive "power" "and" "toughness" "are" "each" "equal" "to" value "."

/* @sem Ability::Static{kind:CharacteristicDefining{contributes_to_color_identity:true}, affected:Objects(One(ObjectRef::Source)), changes:[Change::SetPower($value)]} */
token_defining_power ::= holder_possessive "power" "is" "equal" "to" value "."

/* @sem Ability::Static{kind:CharacteristicDefining{contributes_to_color_identity:true}, affected:Objects(One(ObjectRef::Source)), changes:[Change::SetToughness($value)]} */
token_defining_toughness ::= holder_possessive "toughness" "is" "equal" "to" value "."

token_stat ::= number_digits | number_x

token_colors ::= token_colorless | token_color_one | token_color_two | token_color_three

/* @sem ManaColor::[] */
token_colorless ::= "colorless"
/* @sem ManaColor::[$token_color] */
token_color_one ::= token_color
/* @sem ManaColor::[$token_color, $token_color_2] */
token_color_two ::= token_color "and" token_color
/* @sem ManaColor::[$token_color, $token_color_2, $token_color_3] */
token_color_three ::= token_color "," token_color "," "and" token_color

token_color ::= dc_white | dc_blue | dc_black | dc_red | dc_green

token_subtypes ::= token_subtype_one | token_subtype_more

/* @sem SubType::[@subtype_name($subtype)] */
token_subtype_one ::= subtype

/* @sem SubType::[@subtype_name($subtype), ...$token_subtypes] */
token_subtype_more ::= subtype token_subtypes

token_types ::= tt_creature | tt_artifact_creature | tt_enchantment_creature | tt_land_creature | tt_enchantment_artifact_creature | tt_artifact

/* @sem CardType::[Creature] */
tt_creature ::= "creature"
/* @sem CardType::[Artifact, Creature] */
tt_artifact_creature ::= "artifact" "creature"
/* @sem CardType::[Enchantment, Creature] */
tt_enchantment_creature ::= "enchantment" "creature"
/* @sem CardType::[Land, Creature] */
tt_land_creature ::= "land" "creature"

token_named_recipe ::= tn_heartwood | tn_lord_of_the_pit | tn_black_lotus | tn_shard | tn_powerstone | tn_blood | tn_clue | tn_food | tn_gold | tn_junk | tn_lander | tn_map | tn_mutagen | tn_treasure | tn_spellgorger_weird | tn_mutavault | tn_tarmogoyf | tn_scryb_sprites | tn_baneslayer_angel | tn_vibranium | tn_walker | tn_feroz_ban | tn_giant_badger | tn_akroma_angel_of_wrath | tn_gingerbrute

/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Blood], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[Mana([Generic(1)]), TapSymbol, Discard{count:Expr::Constant(1), filter:Any}, Sacrifice{objects:One(Source)}]}, limits:_{}, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Expr::Constant(1)}}]}})]} */
tn_blood ::= "Blood"

/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Clue], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[Mana([Generic(2)]), Sacrifice{objects:One(Source)}]}, limits:_{}, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Expr::Constant(1)}}]}})]} */
tn_clue ::= "Clue"

/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Food], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[Mana([Generic(2)]), TapSymbol, Sacrifice{objects:One(Source)}]}, limits:_{}, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:Constant(3)}}]}})]} */
tn_food ::= "Food"

/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Junk], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[TapSymbol, Sacrifice{objects:One(Source)}]}, limits:_{sorcery:true}, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Expr::Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:EndOfTurn, evaluation:LiveObjects}}]}})]} */
tn_junk ::= "Junk"

/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Lander], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[Mana([Generic(2)]), TapSymbol, Sacrifice{objects:One(Source)}]}, limits:_{}, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:@and(ObjectFilter::Supertype(Basic), ObjectFilter::CardType(Land)), count:UpTo(Expr::Constant(1))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}})]} */
tn_lander ::= "Lander"

/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Map], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[Mana([Generic(1)]), TapSymbol, Sacrifice{objects:One(Source)}]}, limits:_{sorcery:true}, announcement:_{targets:[_{slot:0, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}]}, body:_{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Explore{object:Target{slot:0, index:0}}}}]}})]} */
tn_map ::= "Map"

/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Mutagen], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[Mana([Generic(1)]), TapSymbol, Sacrifice{objects:One(Source)}]}, limits:_{sorcery:true}, announcement:_{targets:[_{slot:0, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:CardType(Creature)}]}, body:_{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:0, index:0})), kind:PowerToughness([1, 1]), amount:Expr::Constant(1)}]}}]}})]} */
tn_mutagen ::= "Mutagen"

/* A Gold token sacrifices itself for one mana of any color, without tapping. */
/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Gold], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[Sacrifice{objects:One(Source)}]}, limits:_{}, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:ChooseOne([Amount{color:White, amount:Expr::Constant(1)}, Amount{color:Blue, amount:Expr::Constant(1)}, Amount{color:Black, amount:Expr::Constant(1)}, Amount{color:Red, amount:Expr::Constant(1)}, Amount{color:Green, amount:Expr::Constant(1)}])}}]}})]} */
tn_gold ::= "Gold"
/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Treasure], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[TapSymbol, Sacrifice{objects:One(Source)}]}, limits:_{}, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:ChooseOne([Amount{color:White, amount:Expr::Constant(1)}, Amount{color:Blue, amount:Expr::Constant(1)}, Amount{color:Black, amount:Expr::Constant(1)}, Amount{color:Red, amount:Expr::Constant(1)}, Amount{color:Green, amount:Expr::Constant(1)}])}}]}})]} */
tn_treasure ::= "Treasure"

/* A singular token phrase names the actual produced objects. Replacement effects
   can produce a batch, so native lowering chooses one member before attaching. */
clause_attach_created ::= attach_created_required | attach_created_optional

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$created_attachment_host, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Attach{attachments:$affected, host:Result{result:@prior, phase:After, index:0}}}] */
attach_created_required ::= "attach" affected "to" created_attachment_host

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:$attach_created_required}}] */
attach_created_optional ::= "you" "may" attach_created_required

/* A bare pronoun still needs current token focus. The explicit token noun
   names the prior produced batch even after another object was moved. */
created_attachment_host ::= created_ordinary_singular | created_attachment_token | created_attachment_the_token

/* @sem ObjectSet::@created_named_reference */
/* @prefer value(Created) */
created_attachment_token ::= "that" "token"

/* Token copy effects use their own typed container; ordinary CopyOf effects
   cannot be substituted for these copiable token adjustments. */
/* @sem CopyException::AddCardTypes([Artifact]) */
token_copy_add_artifact ::= "it's" "an" "artifact" "in" "addition" "to" "its" "other" "types"

/* The written attachment is an entry state of the new Aura, not a later
   Attach action or a change to the ability holder. A target host is announced
   by whichever Spell/Activated/reflexive owner contains this operation; "it"
   names an object an earlier instruction already chose. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$role_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo($object_ref)]}}) */
create_role_attached ::= "create" role_token "attached" "to" object_ref
/* @sem TokenSpec::TokenSpec{amount:$token_amount, words:Rules, recipe:$role_recipe} */
role_token ::= token_amount role_recipe ("token" | "tokens")
/* A named Role's own abilities never scale with token quantity. */
role_recipe ::= cursed_role_recipe | sorcerer_role_recipe | young_hero_role_recipe | wicked_role_recipe | royal_role_recipe | monster_role_recipe | virtuous_role_recipe
/* @sem TokenRecipe::Defined{name:Explicit(Sorcerer), card_types:[Enchantment], subtypes:[Aura, Role], abilities:[Enchant{hosts:Permanents(CardType(Creature))}, Static{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Pump{power:Constant(1), toughness:Constant(1)}, GrantAbility(@scope(Ability::Triggered{event:Object{event:Attacks, objects:SameObject(Source)}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Scry{players:One(AbilityController), amount:Constant(1)}}]}}))]}]} */
sorcerer_role_recipe ::= "Sorcerer" "Role"
/* The granted attack trigger checks the enchanted creature's own toughness
   and puts the counter on the creature that attacked. */
/* @sem TokenRecipe::Defined{name:Explicit('Young Hero'), card_types:[Enchantment], subtypes:[Aura, Role], abilities:[Enchant{hosts:Permanents(CardType(Creature))}, Static{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[GrantAbility(@scope(Ability::Triggered{event:Object{event:Attacks, objects:SameObject(Source)}, intervening_if:ObjectMatches{object:Source, filter:Property{property:Toughness, test:NumberTest::Compare{comparison:LessOrEqual, value:Constant(3)}}}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(@event_subject)), kind:PowerToughness([1, 1]), amount:Constant(1)}]}}]}}))]}]} */
young_hero_role_recipe ::= "Young" "Hero" "Role"
/* The Wicked Role drains each opponent for 1 when it goes to a graveyard. */
/* @sem TokenRecipe::Defined{name:Explicit(Wicked), card_types:[Enchantment], subtypes:[Aura, Role], abilities:[Enchant{hosts:Permanents(CardType(Creature))}, Static(_{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Pump{power:Constant(1), toughness:Constant(1)}]}), @scope(Ability::Triggered{event:ZoneChange{objects:AllOf([SameObject(Source), OwnedBy(All)]), from:Battlefield, to:Graveyard}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:LoseLife{players:OpponentsOf(AbilityController), amount:Constant(1)}}]}})]} */
wicked_role_recipe ::= "Wicked" "Role"
/* The Royal Role grants ward {1}. */
/* @sem TokenRecipe::Defined{name:Explicit(Royal), card_types:[Enchantment], subtypes:[Aura, Role], abilities:[Enchant{hosts:Permanents(CardType(Creature))}, Static(_{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Pump{power:Constant(1), toughness:Constant(1)}, GrantKeyword(Ward{parts:[Mana([Generic(1)])]})]})]} */
royal_role_recipe ::= "Royal" "Role"
/* The Monster Role grants trample. */
/* @sem TokenRecipe::Defined{name:Explicit(Monster), card_types:[Enchantment], subtypes:[Aura, Role], abilities:[Enchant{hosts:Permanents(CardType(Creature))}, Static(_{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Pump{power:Constant(1), toughness:Constant(1)}, GrantKeyword(Trample)]})]} */
monster_role_recipe ::= "Monster" "Role"
/* The Virtuous Role counts the enchantments its creator controls. */
/* @sem TokenRecipe::Defined{name:Explicit(Virtuous), card_types:[Enchantment], subtypes:[Aura, Role], abilities:[Enchant{hosts:Permanents(CardType(Creature))}, Static(_{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Pump{power:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Enchantment), ControlledBy(One(AbilityController))])}), toughness:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Enchantment), ControlledBy(One(AbilityController))])})}]})]} */
virtuous_role_recipe ::= "Virtuous" "Role"

/* The named token is a vocabulary entry. Its variable characteristics are
   operands of its creation, independent of any other mode's target filter. */
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:Explicit('The Hollow Sentinel'), supertypes:[Legendary], card_types:[Artifact, Creature], subtypes:[Phyrexian, Golem], power_toughness:[$number, $number_2]}} */
token_hollow_sentinel ::= "The" "Hollow" "Sentinel" "," "a" "legendary" number "/" number "colorless" "Phyrexian" "Golem" "artifact" "creature" "token"

/* A Powerstone always produces one colorless mana. Its creation count and
   tapped arrival are operands of the surrounding token-creation operation. */
/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Powerstone], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[TapSymbol]}, limits:_{}, announcement:_{}, body:Program{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:Amount{color:Colorless, amount:Constant(1)}, restriction:Not(CastSpell(Not(CardType(Artifact))))}}]}})]} */
tn_powerstone ::= "Powerstone"

/* An explicit token name is part of the recipe, independently of its stats,
   colors and intrinsic abilities. It is not a reference to the creating card. */
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:Explicit(Cherubael), supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$number, $number_2], abilities:$token_ability_description}} */
token_cherubael ::= "Cherubael" "," "a" "legendary" number "/" number token_colors token_subtypes token_types "token" token_ability_description

/* The whole population supplies one creation amount, rather than a sequence
   of independently produced batches. The creator remains the controller. */
/* @sem Instruction::[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:@times($token_amount, Expr::CountPlayers(OpponentsOf(AbilityController))), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
clause_opponent_count_tokens ::= "for" "each" "opponent" "," "you" "create" token_amount token_recipe

/* Parley: every player reveals the top card of their library, the reward counts
   the nonland cards among those revealed, then every player draws a card. */
/* @sem () */
parley_reveal ::= "each" "player" "reveals" "the" "top" "card" "of" "their" "library" "." "for" "each" "nonland" "card" "revealed" "this" "way" ","
/* @sem () */
parley_draw ::= "." "then" "each" "player" "draws" "a" "card"
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:LibraryTops(All)}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:@times($token_amount, Expr::CountObjects(Matching{objects:Observed(@marked), filter:Not(CardType(Land))})), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}, Effect{result:@next, operation:Draw{players:All, amount:Constant(1)}}] */
instructions_parley_tokens ::= parley_reveal "you" "create" token_amount token_recipe parley_draw
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:LibraryTops(All)}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:@times($token_amount, Expr::CountObjects(Matching{objects:Observed(@marked), filter:Not(CardType(Land))})), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}, Effect{result:@next, operation:Draw{players:All, amount:Constant(1)}}] */
instructions_parley_named_tokens ::= parley_reveal "you" "create" token_amount token_named_recipe "token" parley_draw
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:LibraryTops(All)}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:@times($token_amount, Expr::CountObjects(Matching{objects:Observed(@marked), filter:Not(CardType(Land))})), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}})}, Effect{result:@next, operation:Draw{players:All, amount:Constant(1)}}] */
instructions_parley_tapped_tokens ::= parley_reveal "you" "create" token_amount "tapped" token_named_recipe "token" parley_draw
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:LibraryTops(All)}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:Investigate{times:Expr::CountObjects(Matching{objects:Observed(@marked), filter:Not(CardType(Land))})}}}, Effect{result:@next, operation:Draw{players:All, amount:Constant(1)}}] */
instructions_parley_investigate ::= parley_reveal "you" "investigate" parley_draw

/* A scalar destroyed target provides pre-move controller information, even if
   destruction moves it or changes which object its target reference locates. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:One($target_object), regeneration:true}}, Effect{result:@next, operation:CreateTokens{players:One(ControllerOf($target_object)), tokens:$token_groups_tapped, entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}}] */
clause_destroy_controller_tapped_tokens ::= "destroy" target_object "." "its" "controller" "creates" token_groups_tapped

/* Retained mined entry points delegate to this owned construction. Token
   quantity never scales the mana ability of each individual Powerstone. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_amount, words:Rules, recipe:$tn_powerstone}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}) */
create_powerstones_tapped ::= "create" token_amount "tapped" tn_powerstone ("token" | "tokens")

/* The entry states belong to the creation batch, including every replacement
   copy. Later token anaphors use that exact Created result. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:[]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_copy_tapped_attacking ::= "create" "a" "tapped" "and" "attacking" "token" "that's" "a" "copy" "of" object_ref

/* The counters on the written source are counted at resolution, independently
   of the created batch that receives the new counters. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($created_reference), kind:$counter_kind, amount:CountCounters{recipients:Objects(One($object_ref)), kind:$counter_kind_2, information:CurrentOrLastKnown}}]} */
put_created_counters_for_counters ::= "put" ("a" | "one") counter_kind "counter" "on" created_reference "for" "each" counter_kind "counter" "on" object_ref

/* Explicit names and the token characteristics are independent operands. */
token_explicit_legendary ::= token_explicit_legendary_plain | token_explicit_legendary_with
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:$explicit_legendary_name, supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2]}} */
token_explicit_legendary_plain ::= explicit_legendary_name "," counter_amount "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token"
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:$explicit_legendary_name, supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2], abilities:$token_ability_description}} */
token_explicit_legendary_with ::= explicit_legendary_name "," counter_amount "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token" token_ability_description
explicit_legendary_name ::= explicit_token_cragflame | explicit_token_boo | explicit_token_jumblebones | explicit_token_mowu | explicit_token_primo | explicit_token_scion_deep | explicit_voja | explicit_voja_fenstalker | explicit_voja_friend | explicit_token_tiny | explicit_token_stangg_twin | explicit_token_tuktuk_returned | explicit_token_urami | explicit_token_darkstar | explicit_token_karox | explicit_token_marit_lage | explicit_token_angelo | explicit_token_ashaya | explicit_token_kaldra | explicit_token_avacyn | explicit_token_ravage | explicit_token_laserbeak | explicit_token_guenhwyvar | explicit_token_frost_tongue | explicit_token_phobos | explicit_token_keimi
/* @sem TokenName::Explicit(Tiny) */
explicit_token_tiny ::= "Tiny"
/* @sem TokenName::Explicit('Stangg Twin') */
explicit_token_stangg_twin ::= SELF_NAME "Twin"
/* @sem TokenName::Explicit('Tuktuk the Returned') */
explicit_token_tuktuk_returned ::= SELF_NAME "the" "Returned"

/* Explicit names are independent of the token's characteristics and abilities. */
/* @sem TokenRecipe::Defined(_{name:Explicit($created_token_name), colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2]}) */
token_recipe_explicit_name ::= token_stat "/" token_stat token_colors token_subtypes token_types "token" "named" created_token_name

/* @sem TokenRecipe::Defined(_{name:Explicit($created_token_name), colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2], abilities:$token_abilities}) */
token_recipe_explicit_name_with ::= token_stat "/" token_stat token_colors token_subtypes token_types "token" "with" token_abilities "named" created_token_name

/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:[White, Blue, Black, Red, Green], card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2]}) */
token_recipe_all_colors ::= token_stat "/" token_stat token_subtypes token_types "token" "that's" "all" "colors"

/* @sem CardType::[Enchantment, Artifact, Creature] */
tt_enchantment_artifact_creature ::= "enchantment" "artifact" "creature"

created_token_name ::= created_name_lotus | created_name_doombot | created_name_stoneforged_blade | created_name_new_planet | card_name_wolves_of_the_hunt | created_name_replicated_ring | created_name_scrap | created_name_komas_coil | created_name_hornet | created_name_nalaar_aetherjet | created_name_ajanis_pridemate | created_name_minor_demon | created_name_kelp | created_name_ballistic_boulder | created_name_blue_horror | card_name_storm_crow | created_name_wood | created_name_wasp | created_name_butterfly | created_name_metallic_sliver | created_name_feather | card_name_kobolds_of_kher_keep | created_name_kobolds | created_name_carnivore | created_name_reliquary_dragon | card_name_wirefly | created_name_festering_goblin | created_name_moloid | created_name_spark_elemental | card_name_llanowar_elves | created_name_mark_of_rani | created_name_meteorite | created_name_sword | created_name_cloud_sprite | created_name_koma_coil | card_name_ornithopter | created_name_twin | created_name_cordyceps_infected | card_name_lightning_rager | created_name_goldmeadow_harrier | created_name_cadet | created_name_stone_boulder | created_name_phantasmal_angel

/* @sem String::'Wood' */
created_name_wood ::= "Wood"

/* @sem String::'Wasp' */
created_name_wasp ::= "Wasp"

/* @sem String::'Butterfly' */
created_name_butterfly ::= "Butterfly"

/* @sem String::'Metallic Sliver' */
created_name_metallic_sliver ::= "Metallic" "Sliver"

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, AttachedTo(SameObject(Source))])}) */
count_attached_to_him ::= filter_phrase "attached" "to" "him"

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController)), AnyOf([$filter_phrase_2, $filter_phrase_3])])}) */
count_controlled_either ::= filter_phrase "you" "control" "that's" "a" filter_phrase "or" "a" filter_phrase

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Attacking, Modified, $filter_phrase, ControlledBy(One(AbilityController))])} */
attacking_modified_controlled ::= "attacking" "modified" filter_phrase "you" "control"

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:CopyEach{objects:$attacking_modified_controlled, exceptions:[]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_attacking_copies_each ::= "for" "each" attacking_modified_controlled "," "create" counter_amount "tapped" "and" "attacking" "token" "that's" "a" "copy" "of" "that" "creature"

/* @sem Instruction::[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyEach{objects:$each_opponent_targets, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
clause_copy_each_opponent_target ::= "for" "each" "opponent" "," "you" "create" "a" "token" "that's" "a" "copy" "of" each_opponent_targets

/* The exiled population and copy exceptions retain their independent operands. */
/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)} */
token_exiled_card ::= "a" "card" "exiled" "with" object_ref

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_phrase, ExiledWith($object_ref)])} */
token_exiled_filtered_card ::= "a" filter_phrase "card" "exiled" "with" object_ref

/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyOne{objects:$token_exiled_card, exceptions:[]}} */
token_copy_exiled_plain ::= "a" "token" "that's" "a" "copy" "of" token_exiled_card

/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyOne{objects:$token_exiled_filtered_card, exceptions:$token_copy_singular_exceptions}} */
token_copy_exiled_singular ::= "a" "token" "that's" "a" "copy" "of" token_exiled_filtered_card "," "except" token_copy_singular_exceptions

/* @sem TokenSpec::TokenSpec{amount:$count, words:CreatingEffect, recipe:CopyOne{objects:$token_exiled_filtered_card, exceptions:$token_copy_plural_exceptions}} */
token_copy_exiled_plural ::= count "tokens" "that" "are" "copies" "of" token_exiled_filtered_card "," "except" token_copy_plural_exceptions

/* @sem Vec<CopyException>::[CopyException::SetPowerToughness{power:$value, toughness:$value_2}, CopyException::AddAbilities([Keyword($keyword_value)]), CopyException::AddAbilities([Keyword($keyword_value_2)])] */
token_copy_singular_stats ::= "it's" value "/" value "and" "has" keyword_value "and" keyword_value

/* @sem Vec<CopyException>::[CopyException::AddAbilities([Keyword($keyword_value)]), CopyException::AddAbilities([Keyword($keyword_value_2)])] */
token_copy_singular_keywords ::= "it" "has" keyword_value "and" keyword_value

token_copy_singular_exceptions ::= token_copy_singular_stats | token_copy_singular_keywords

/* @sem Vec<CopyException>::[CopyException::SetPowerToughness{power:$value, toughness:$value_2}, CopyException::AddAbilities([Keyword($keyword_value)])] */
token_copy_plural_exceptions ::= "they're" value "/" value "and" "have" keyword_value

/* The crew ability belongs to the created token, not the creator. */
/* @sem Ability::@scope($crew_ability) */
token_crew ::= crew_ability

/* @sem CardType::[Artifact] */
tt_artifact ::= "artifact"

/* Named and unnamed recipes share the same characteristic and ability phrases. */
/* @sem TokenRecipe::Defined(_{name:Explicit($vehicle_token_name), colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2]}) */
token_recipe_named ::= token_stat "/" token_stat token_colors token_subtypes token_types "token" "named" vehicle_token_name

/* @sem String::'Zeppelin' */
vehicle_token_name ::= "Zeppelin"

/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:Explicit('The Blackjack'), supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2], abilities:$token_ability_description}} */
token_legendary_named ::= "The" "Blackjack" "," "a" "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token" token_ability_description

/* The count is defined after the recipe; it counts opponents independently by hand size. */
/* @sem TokenSpec::TokenSpec{amount:$opponents_hand_threshold_count, words:CreatingEffect, recipe:$token_recipe} */
token_defined_opponent_hand_count ::= "X" token_recipe "," "where" "X" "is" opponents_hand_threshold_count

/* @sem Expr::CountPlayers(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:CountObjects(Zone(_{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any})), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}}}])) */
opponents_hand_threshold_count ::= "the" "number" "of" "your" "opponents" "with" count "or" "more" "cards" "in" "hand"

/* The target group and each copy quantity are independent operands. */
/* @sem Instruction::[ForEachObject{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly($number), filter:Any})), binding:0, body:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$number_2, words:CreatingEffect, recipe:Copy{object:Bound(0), exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}] */
instructions_each_target_copies ::= "for" "each" "of" number "target" "permanents" "," "create" number "tokens" "that" "are" "copies" "of" "that" "permanent"

/* The counted permanents and recipient share the loop's player binding. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(Bound(0)), tokens:[_{amount:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(Tapped), $filter_phrase, ControlledBy(One(Bound(0)))])}), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}] */
clause_players_create_per_untapped ::= players_singular "creates" "a" token_recipe "for" "each" "untapped" filter_phrase "they" "control"

/* The selected opponents remain the controllers of the counted population. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:AnyNumber, filter:Any, players:OpponentsOf(AbilityController)})))])}), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
instructions_chosen_opponents_tokens ::= "choose" "any" "number" "of" "target" "opponents" "." "create" "X" token_recipe "," "where" "X" "is" "the" "number" "of" filter_plural "those" "opponents" "control"

/* Each alternative is a separate action and carries its own token recipe. */
/* @sem Operation::ChooseAtRandom(_{kind:Action, options:$random_green_options}) */
random_green_token_choice ::= "create" "a" "green" "creature" "token" "that's" random_green_options "," "chosen" "at" "random"

/* @sem Operand::[$random_green_option, ...$random_green_options_tail] */
random_green_options ::= random_green_option "," random_green_options_tail

random_green_options_tail ::= random_green_options_last_pair | random_green_options
/* @sem Operand::[$random_green_option, $random_green_option_2] */
random_green_options_last_pair ::= random_green_option "," "or" random_green_option

random_green_option ::= random_green_plain | random_green_keyword

/* @sem Operand::List([Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:[Green], card_types:[Creature], subtypes:[@subtype_name($subtype)], power_toughness:[$value, $value_2]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}]) */
random_green_plain ::= counter_amount value "/" value subtype

/* @sem Operand::List([Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:[Green], card_types:[Creature], subtypes:[@subtype_name($subtype)], power_toughness:[$value, $value_2], abilities:[Keyword($keyword_value)]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}]) */
random_green_keyword ::= counter_amount value "/" value subtype "with" keyword_value

/* A leading spell count is the controller's cast-event history. */
/* @sem Expr::EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:Any}, window:ThisTurn, measure:Occurrences} */
count_spells_cast_this_turn ::= "spell" "you've" "cast" "this" "turn"

/* The same defined quantity supplies both token characteristics. */
/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_spell_max, $token_spell_max], abilities:$token_abilities}) */
token_recipe_history_max ::= "X" "/" "X" token_colors token_subtypes token_types "token" "with" token_abilities "," "where" "X" "is" token_spell_max

/* @sem Expr::EventHistory{event:Spell{event:Cast, players:All, spells:AllOf([$token_spell_history_filter, Cast{by:One(AbilityController)}])}, window:ThisTurn, measure:Property([ManaValue, Maximum])} */
token_spell_max ::= "the" "greatest" "mana" "value" "among" token_spell_history_filter "spells" "you've" "cast" "this" "turn"

/* @sem ObjectFilter::AnyOf([$spell_adjective, $spell_adjective_2]) */
token_spell_history_filter ::= spell_adjective "and" spell_adjective

/* The separate entry sentence modifies the creation itself. The name in the
   singular form is fixed on both sides, so it cannot name an unrelated token. */
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:Explicit(Ragavan), supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2]}} */
attacking_ragavan_spec ::= "Ragavan" "," counter_amount "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token"

/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[$attacking_ragavan_spec], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}} */
create_named_attacking_sentence ::= "create" attacking_ragavan_spec "." "Ragavan" "enters" "tapped" "and" "attacking"

/* The historical count is self-contained: receipt-derived counts require a
   producer proof and are deliberately excluded from this phrase. */
/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$count_each_discarded_turn, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:$token_copy_exception}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}} */
create_counted_copy_attacking_sentence ::= "for" "each" count_each_discarded_turn "," "create" "a" "token" "that's" "a" "copy" "of" object_ref "," "except" token_copy_exception "." "the" "tokens" "enter" "tapped" "and" "attacking"

/* @sem Vec<CopyException>::[CopyException::RemoveSupertypes([Legendary])] */
token_copy_exception ::= "the" "token" "isn't" "legendary"

/* @sem Instruction::Effect{result:@next, operation:CreateDelayedTrigger{event:$token_cleanup_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Created(0), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}} */
token_cleanup_singular ::= "exile" "that" "token" "at" token_cleanup_event

/* @sem Instruction::Effect{result:@next, operation:CreateDelayedTrigger{event:$token_cleanup_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Created(0), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}} */
token_cleanup_plural ::= "exile" "the" "tokens" "at" token_cleanup_event

token_cleanup_event ::= turn_end_combat | delayed_move_any_end

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$create_named_attacking_sentence}, $token_cleanup_singular]}} */
triggered_named_attacking_token_cleanup ::= event_clause "," create_named_attacking_sentence "." token_cleanup_singular "."

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$create_counted_copy_attacking_sentence}, $token_cleanup_plural]}} */
triggered_counted_copy_attacking_cleanup ::= event_clause "," create_counted_copy_attacking_sentence "." token_cleanup_plural "."

/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Enchantment], subtypes:[Shard], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[Mana([Generic(2)]), Sacrifice{objects:One(Source)}]}, limits:_{}, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:Scry{players:One(AbilityController), amount:Constant(1)}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Constant(1)}}]}})]} */
tn_shard ::= "Shard"

/* The singular token and all three options share this creation receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, ChooseOne{decider:AbilityController, options:[Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@marked)), kind:$counter_kind, amount:$counter_amount}]}}]}, Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@marked)), kind:$counter_kind_2, amount:$counter_amount_2}]}}]}, Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@marked)), kind:$counter_kind_3, amount:$counter_amount_3}]}}]}]}] */
/* @prefer always */
clause_created_counter_choice ::= "create" "a" token_recipe "." "put" "your" "choice" "of" counter_amount counter_kind "counter" "," counter_amount counter_kind "counter" "," "or" counter_amount counter_kind "counter" "on" "it"

/* The mill operation is part of the same contract as its transition receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:Mill{players:One(AbilityController), amount:$card_count}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@last_result, phase:After}, filter:$adjective_color}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@marked)), kind:$counter_kind, amount:$counter_amount}]}}]}, otherwise:Program{}}] */
clause_created_mill_counter ::= "create" "a" token_recipe "," "then" "mill" card_count "." "put" counter_amount counter_kind "counter" "on" "the" "token" "if" "a" adjective_color "card" "was" "milled" "this" "way"

/* The announced targets are copied individually; the result binds the created batch. */
/* @sem Instruction::[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyEach{objects:$copy_chosen_creatures, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
clause_copy_chosen_creatures ::= "choose" copy_chosen_creatures "." "for" "each" "of" "those" "creatures" "," "create" "a" "token" "that's" "a" "copy" "of" "that" "creature"

/* @sem Instruction::[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:CopyEach{objects:$copy_chosen_creatures, exceptions:[CopyException::AddAbilities([Keyword($keyword_value)])]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
clause_copy_chosen_creatures_with_keyword ::= "choose" copy_chosen_creatures "." "for" "each" "of" "them" "," "create" token_copy_single "that" "creature" "," "except" "it" "has" keyword_value

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:$plural_target_count_any, filter:@and(ObjectFilter::CardType(Creature), $copy_chosen_controller)})) */
copy_chosen_creatures ::= plural_target_count_any "target" "creatures" copy_chosen_controller

/* @sem ObjectFilter::ControlledBy(One(AbilityController)) */
copy_chosen_controller_own ::= "you" "control"

/* @sem ObjectFilter::ControlledBy(OthersThan(AbilityController)) */
copy_chosen_controller_other ::= "you" "don't" "control"

copy_chosen_controller ::= copy_chosen_controller_own | copy_chosen_controller_other

/* The cleanup refers to the batch created by the preceding copy instruction. */
/* @sem Instruction::[...$clause_copy_chosen_creatures_with_keyword, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Move{objects:$created_batch_reference, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}] */
instructions_copy_chosen_keyword_cleanup ::= clause_copy_chosen_creatures_with_keyword "." "exile" created_batch_reference "at" "the" "beginning" "of" "the" "next" "end" "step"

/* @sem String::'Feather' */
created_name_feather ::= "Feather"

/* Both token statistics refer to the power of the devoured event object. */
/* @sem TokenSpec::TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[Earlier{what:Devoured, measure:Of(Power)}, Earlier{what:Devoured, measure:Of(Power)}]}} */
token_devoured_power ::= token_amount "X" "/" "X" token_colors token_subtypes token_types "token" "," "where" "X" "is" "the" "devoured" "creature's" "power"

/* @sem TokenRecipe::Named('Spellgorger Weird') */
tn_spellgorger_weird ::= "Spellgorger" "Weird"

/* The counted population also identifies the different opponents fought by
   the created batch. Both noun forms must denote the same filter. */
/* @sem Instruction::[Effect{result:@mark, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($filter_phrase, $filter_plural), ControlledBy(OpponentsOf(AbilityController))])}), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}, Effect{result:@next, operation:FightEach{fighters:Created(@marked), others:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($filter_phrase, $filter_plural), ControlledBy(OpponentsOf(AbilityController))])}}}] */
create_each_opponent_and_fight ::= "for" "each" filter_phrase "your" "opponents" "control" "," "create" "a" token_recipe "." "each" "of" "those" "tokens" "fights" "a" "different" "one" "of" "those" filter_plural

/* Named rules-defined token recipes compose with the ordinary arrival and amount. */
/* @sem TokenRecipe::Named(Mutavault) */
tn_mutavault ::= "Mutavault"
/* @sem TokenRecipe::Named(Tarmogoyf) */
tn_tarmogoyf ::= "Tarmogoyf"

/* Tapped copy creation shares the copy target and exception operands. */
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:[]}} */
token_copy_plain_tapped ::= "a" "tapped" "token" "that's" "a" "copy" "of" object_ref
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:$copy_exceptions_plain}} */
token_copy_modified_tapped ::= "a" "tapped" "token" "that's" "a" "copy" "of" object_ref "," "except" copy_exceptions_plain

/* A commander copy selects from the owned commander population. */
/* @sem TokenSpec::TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:CopyOne{objects:AnyZone(AllOf([State(Commander), OwnedBy(One(AbilityController))])), exceptions:[$copy_not_legendary]}} */
token_copy_commander ::= token_copy_single "your" "commander" "," "except" copy_not_legendary
/* @sem CopyException::RemoveSupertypes([Legendary]) */
copy_not_legendary ::= "it's" "not" "legendary"

/* A copy exception specifies the copied token's replacement characteristics. */
/* @sem Vec<CopyException>::[CopyException::SetPowerToughness{power:$value, toughness:$value_2}, CopyException::Colors{mode:Set, colors:Listed($token_colors)}, CopyException::SetTypes{card_types:[Creature], subtypes:$token_subtypes}] */
copy_token_characteristics ::= "it's" "a" value "/" value token_colors token_subtypes
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:$copy_token_characteristics}} */
token_copy_characteristics_tapped ::= "a" "tapped" "token" "that's" "a" "copy" "of" object_ref "," "except" copy_token_characteristics

/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:Explicit('First Mate Ragavan'), supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2]}} */
cast_alternative_token ::= "First" "Mate" "Ragavan" "," counter_amount "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token"

/* A named token's death trigger belongs to that token's own holder. */
/* @sem TokenName::Explicit(Smaug) */
explicit_token_smaug ::= "Smaug"

/* @sem Ability::Triggered{event:ZoneChange{objects:SameObject(Source), from:Battlefield, to:Graveyard}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$chapter_plural_token_count, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}} */
token_named_death_treasure ::= "when" "Smaug" "dies" "," "create" chapter_plural_token_count token_named_recipe "tokens" "."

/* Named legendary token with two keywords and an intrinsic quoted trigger. */
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:$explicit_token_smaug, supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2], abilities:[Keyword($keyword_name), Keyword($keyword_name_2), @holder($token_named_death_treasure)]}} */
chapter_quoted_token ::= explicit_token_smaug "," counter_amount "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token" "with" keyword_name "," keyword_name "," "and" '"' token_named_death_treasure '"'

chapter_plural_token_count ::= n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10 | n11 | n12 | n13 | n14 | n15 | n20 | n30

/* Names and token characteristics are independent operands. */
/* @sem TokenName::Explicit(Voja) */
explicit_voja ::= "Voja"

/* @sem TokenName::Explicit('Voja Fenstalker') */
explicit_voja_fenstalker ::= "Voja" "Fenstalker"

/* @sem TokenName::Explicit('Voja, Friend to Elves') */
explicit_voja_friend ::= "Voja" "," "↑" "friend" "to" "Elves"

/* Walker's intrinsic characteristics do not vary with the quantity created. */
/* @sem TokenSpec::TokenSpec{amount:$count, words:Rules, recipe:Defined{name:Explicit(Walker), colors:[Black], card_types:[Creature], subtypes:[Zombie], power_toughness:[Constant(2), Constant(2)]}} */
token_walker_group ::= count "Walker" "tokens"

/* The plural exception agrees with the copied batch. */
/* @sem TokenSpec::TokenSpec{amount:$count, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:$copy_plural_stats_types_keyword}} */
token_copy_plural_dragon ::= count "tokens" "that" "are" "copies" "of" object_ref "," "except" copy_plural_stats_types_keyword

/* @sem Vec<CopyException>::[SetPowerToughness{power:$token_stat, toughness:$token_stat_2}, AddCreatureTypes($becomes_types), AddCardTypes([Creature]), AddAbilities([Keyword($keyword_value)])] */
copy_plural_stats_types_keyword ::= "they're" token_stat "/" token_stat becomes_types "creatures" "in" "addition" "to" "their" "other" "types" "," "and" "they" "have" keyword_value

/* @sem TokenRecipe::Defined{name:FromSubtypes, colors:[$token_color], card_types:[Creature], subtypes:[@subtype_name($creature_subtype)], power_toughness:[Aggregate{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}), property:ManaValue, aggregation:Sum}, Aggregate{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}), property:ManaValue, aggregation:Sum}]} */
linked_exile_value_token ::= "X" "/" "X" token_color creature_subtype "creature" "token" "," "where" "X" "is" "the" "mana" "value" "of" "the" "exiled" "card"

/* Plural copy wording retains the copied object and each exception. */
/* @sem TokenSpec::TokenSpec{amount:$count, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:$copy_plural_exceptions}} */
token_copy_modified_plural ::= count "tokens" "that" "are" "copies" "of" object_ref "," "except" copy_plural_exceptions

/* @sem Vec<CopyException>::[$copy_plural_remove_legendary] */
copy_plural_exceptions_one ::= copy_plural_remove_legendary

/* @sem Vec<CopyException>::[$copy_plural_stats, $copy_plural_remove_legendary_2] */
copy_plural_exceptions_stats ::= copy_plural_stats "and" copy_plural_remove_legendary_2

copy_plural_exceptions ::= copy_plural_exceptions_one | copy_plural_exceptions_stats | copy_plural_creature_stats_two_keywords

/* @sem CopyException::RemoveSupertypes([Legendary]) */
copy_plural_remove_legendary ::= "they're" "not" "legendary"

/* @sem CopyException::RemoveSupertypes([Legendary]) */
copy_plural_remove_legendary_2 ::= "they" "aren't" "legendary"

/* @sem CopyException::SetPowerToughness{power:$value, toughness:$value_2} */
copy_plural_stats ::= "they're" value "/" value

/* @sem TokenSpec::TokenSpec{amount:$count, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:[]}} */
token_copy_plural_tapped ::= count "tapped" "tokens" "that" "are" "copies" "of" object_ref

/* @sem TokenName::Explicit(Urami) */
explicit_token_urami ::= "Urami"

/* @sem TokenRecipe::Named('Scryb Sprites') */
tn_scryb_sprites ::= "Scryb" "Sprites"

/* Named token recipes compose with a measured quantity. */
/* @sem TokenSpec::TokenSpec{amount:$value_opponents, words:Rules, recipe:$token_named_recipe} */
token_named_equal ::= "a" "number" "of" token_named_recipe "tokens" "equal" "to" value_opponents

/* The triggering object's cast X is distinct from a spell's announced X. */
/* @sem TokenSpec::TokenSpec{amount:Divide{numerator:CastX(EventSubject), denominator:Constant(2), rounding:$rounding_words}, words:Rules, recipe:$token_named_recipe} */
token_named_half_event_x ::= "half" "X" token_named_recipe "tokens" "," rounding_words

/* Explicit names remain separate from the token characteristics. */
/* @sem TokenName::Explicit(Darkstar) */
explicit_token_darkstar ::= "Darkstar"

/* @sem TokenName::Explicit('Karox Bladewing') */
explicit_token_karox ::= "Karox" "Bladewing"

/* @sem TokenName::Explicit('Marit Lage') */
explicit_token_marit_lage ::= "Marit" "Lage"

/* Plural named recipes compose with independently specified abilities. */
/* @sem TokenRecipe::Defined{name:Explicit($created_token_name), colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2]} */
token_recipe_explicit_name_plural ::= token_stat "/" token_stat token_colors token_subtypes token_types "tokens" "named" created_token_name

/* @sem String::'Blue Horror' */
created_name_blue_horror ::= "Blue" "Horror"

/* @sem TokenSpec::TokenSpec{amount:$token_x_prior_counters, words:CreatingEffect, recipe:$token_recipe} */
token_defined_x_tapped ::= "X" "tapped" token_recipe "," "where" "X" "is" token_x_prior_counters

/* @sem Expr::CountCounters(_{recipients:Objects($affected), information:CurrentOrLastKnown}) */
token_x_prior_counters ::= "the" "number" "of" "counters" affected "had" "on" "it"

/* The definition of X supplies the amount independently of the token recipe. */
/* @sem TokenSpec::TokenSpec{amount:$value_mana_spent, words:CreatingEffect, recipe:$token_recipe} */
token_defined_x_where ::= "X" token_recipe "," "where" "X" "is" value_mana_spent

/* @sem TokenRecipe::Defined(_{name:Explicit($created_token_name), colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2]}) */
token_recipe_explicit_plural ::= token_stat "/" token_stat token_colors token_subtypes token_types "tokens" "named" created_token_name

/* @sem String::'Kobolds of Kher Keep' */
created_name_kobolds ::= "Kobolds" "of" "Kher" "Keep"

/* These two forms keep the exile and its property consumer in one scope. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One($target_card_a_graveyard), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:ObjectProperty{object:$target_card_a_graveyard, property:$receipt_stat, information:CurrentOrLastKnown}, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
instructions_exile_target_token_stat ::= "exile" target_card_a_graveyard "," "then" "create" "X" token_recipe "," "where" "X" "is" "the" "exiled" "card's" receipt_stat

/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One($target_card_your_graveyard), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:$receipt_stat, information:CurrentOrLastKnown}, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
instructions_exile_own_target_token_stat ::= "exile" target_card_your_graveyard "." "create" "X" token_recipe "," "where" "X" "is" "the" "exiled" "card's" receipt_stat

/* The count and token recipe are independent; the quoted ability belongs to the token. */
/* @sem TokenSpec::TokenSpec{amount:PlayerNumber{player:AbilityController, number:DescentsThisTurn}, words:CreatingEffect, recipe:$token_descents_recipe} */
token_descents_group ::= "X" token_descents_recipe "where" "X" "is" "the" "number" "of" "times" "you" "descended" "this" "turn"

/* @sem TokenRecipe::@token_abilities($token_recipe_base, $token_comma_static_ability) */
token_descents_recipe ::= token_recipe_base "with" token_comma_static_ability

/* @sem Ability::[Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes})] */
token_comma_static_ability ::= '"' affected static_changes "," '"'

/* Keep the mill and receipt consumer in one inverse contract. */
/* @sem ObjectFilter::$filter_phrase */
mill_receipt_card ::= filter_phrase "card"

/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count_many}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$mill_receipt_card}), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
instructions_mill_receipt_tokens ::= "mill" card_count_many "." "for" "each" mill_receipt_card "milled" "this" "way" "," "create" "a" token_recipe

/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:All, amount:$card_count_many}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$mill_receipt_card}), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}})}] */
instructions_all_mill_receipt_tokens ::= "each" "player" "mills" card_count_many "." "for" "each" mill_receipt_card "put" "into" "a" "graveyard" "this" "way" "," "you" "create" "a" "tapped" token_recipe

/* @sem TokenRecipe::Named('Baneslayer Angel') */
tn_baneslayer_angel ::= "Baneslayer" "Angel"

/* Explicit names compose with the ordinary token characteristics. */
/* @sem TokenRecipe::Defined(_{name:Explicit('Plaguebearer of Nurgle'), colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2]}) */
token_recipe_explicit_plaguebearer ::= token_stat "/" token_stat token_colors token_subtypes token_types "token" "named" "Plaguebearer" "of" "Nurgle"

/* The population is supplied by the ordinary affected-set grammar. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:CopyEach{objects:$affected, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_copy_affected_permanent ::= "for" affected "," "create" counter_amount "token" "that's" "a" "copy" "of" "that" "permanent"

/* Token amount counts mana symbols in the current population. */
/* @sem TokenSpec::TokenSpec{amount:CountManaSymbols{objects:$affected, colors:[$token_color]}, words:CreatingEffect, recipe:$token_recipe} */
token_defined_mana_each ::= "a" token_recipe "for" "each" token_color "mana" "symbol" "in" "the" "mana" "costs" "of" affected

/* @sem TokenName::Explicit(Angelo) */
explicit_token_angelo ::= "Angelo"

/* A spell's mana value supplies the quantity, independently of the recipe. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_spell_mana_value_third ::= "creates" "X" token_recipe "," "where" "X" "is" "the" "spell's" "mana" "value"

/* Vibranium has its own intrinsic artifact ability and restriction. */
/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], subtypes:[Vibranium], abilities:[Keyword(Indestructible), @scope(Ability::Activated{origin:Ordinary, cost:_{parts:[TapSymbol]}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:Amount{color:Colorless, amount:Constant(1)}, restriction:Not(CastSpell(Not(CardType(Artifact))))}}]}})]} */
tn_vibranium ::= "Vibranium"

/* A leading, independently measured amount applies to one tapped named token. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:$count_each_mana_source, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}) */
create_each_named_tapped_mana ::= "for" "each" count_each_mana_source "," "create" "a" "tapped" token_named_recipe "token"

/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:[White, Blue, Black, Red, Green], card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2], abilities:$token_abilities}) */
token_recipe_all_colors_with ::= token_stat "/" token_stat token_subtypes token_types "token" "with" token_abilities "that's" "all" "colors"

/* @sem String::'Carnivore' */
created_name_carnivore ::= "Carnivore"

/* The plural subject identifies the preceding creation batch; the rule lasts while the source remains. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($created_tokens_goaded_subject), changes:[Rule(GoadedBy(AbilityController))], duration:WhileOnBattlefield(Source), evaluation:LiveObjects}}] */
clause_created_tokens_goaded ::= created_tokens_goaded_subject "are" "goaded" "for" "as" "long" "as" "this" "Saga" "remains" "on" "the" "battlefield"

/* @sem ObjectSet::@created_reference */
created_tokens_goaded_subject ::= "the" "tokens"

/* A final quoted intrinsic ability contains its own full stop. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:@token_abilities($token_recipe_plain, $chapter_quoted_token_abilities)}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]} */
chapter_quoted_token_program ::= "create" token_amount token_recipe_plain "with" chapter_quoted_token_abilities

chapter_quoted_token_abilities ::= chapter_vanishing_quoted_abilities | chapter_token_attack_abilities | target_other_quote_list | chapter_token_abilities_list

/* Named token identities are independent of their characteristics. */
/* @sem String::'Minor Demon' */
created_name_minor_demon ::= "Minor" "Demon"

/* @sem String::'Kelp' */
created_name_kelp ::= "Kelp"

/* @sem String::'Ballistic Boulder' */
created_name_ballistic_boulder ::= "Ballistic" "Boulder"

/* Colors may follow the description of the token. */
/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2]}) */
token_recipe_post_colors ::= token_stat "/" token_stat token_subtypes token_types "token" "that's" token_colors

/* Singular copy descriptions can take a singular entry-state clause. */
/* @sem TokenSpec::TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:[]}} */
token_copy_singular ::= token_copy_single object_ref

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[$token_copy_singular], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_copy_singular_attacking ::= "create" token_copy_singular "and" "that's" "tapped" "and" "attacking"

/* The following sentence describes the intrinsic abilities of this batch. */
/* @sem TokenSpec::TokenSpec{amount:$value, words:CreatingEffect, recipe:@token_abilities($token_recipe_base, $token_abilities_after)} */
token_defined_equal_after ::= "a" "number" "of" token_recipe_base "equal" "to" value token_abilities_after

/* A singular token recipe, used when one token is created per occurrence. */
/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2]}) */
singular_counted_token_recipe ::= token_stat "/" token_stat token_colors token_subtypes token_types "token"

/* The pronoun is valid only within the source-regeneration trigger below. */
/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:ObjectProperty{object:Source, property:RegenerationsThisTurn, information:CurrentOrLastKnown}, words:CreatingEffect, recipe:$singular_counted_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
create_for_source_regenerations ::= "create" "a" singular_counted_token_recipe "for" "each" "time" "it" "regenerated" "this" "turn"

/* @sem TokenRecipe::Defined{name:Explicit(Walker), colors:[Black], card_types:[Creature], subtypes:[Zombie], power_toughness:[Constant(2), Constant(2)]} */
tn_walker ::= "Walker"

/* Coin-outcome counts apply to the complete token recipe. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[_{amount:CountCoinOutcomes{source:CoinCountSource::Latest, outcome:Won}, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_coin_wins_attacking ::= "for" "each" "flip" "you" "win" "," "create" "a" token_recipe "that's" "tapped" "and" "attacking"

/* Both receipt references are scoped to their mill and exile producers. */
/* @sem Instruction::[Effect{result:@next, operation:Mill{players:All, amount:$card_count_many}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@prior, phase:After}, filter:$filter_phrase}, count:UpTo($count_plural)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[Aggregate{objects:Transition{result:@prior, phase:After}, property:$receipt_stat, aggregation:Sum}, Aggregate{objects:Transition{result:@prior, phase:After}, property:$receipt_stat, aggregation:Sum}]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
instructions_mill_exile_stat_token ::= "each" "player" "mills" card_count_many "." "exile" "up" "to" count_plural filter_phrase "cards" "put" "into" "graveyards" "this" "way" "." "create" counter_amount "X" "/" "X" token_colors token_subtypes token_types "token" "," "where" "X" "is" "the" "total" receipt_stat "of" "the" "cards" "exiled" "this" "way"

/* The delayed sacrifice refers to the tokens created by this instruction. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$linked_copy_added_type}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(@marked)})}]}}}] */
/* @prefer always */
clause_linked_copy_combat_cleanup ::= "create" "a" "tapped" "and" "attacking" linked_copy_added_type "." "sacrifice" "that" "token" "at" "end" "of" "combat"

/* @sem TokenRecipe::Copy{object:Query{objects:Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}, index:0}, exceptions:[CopyException::AddCreatureTypes([@subtype_name($creature_subtype)])]} */
linked_copy_added_type ::= "token" "that's" "a" "copy" "of" "the" "exiled" "card" "," "except" "it's" "an" creature_subtype "in" "addition" "to" "its" "other" "types"

/* A separate Aura is attached to each announced creature. Its following sentence
   describes intrinsic abilities of those tokens, not a later grant. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[$attached_aura_each]}} */
attached_aura_each_spell ::= attached_aura_each

/* @sem Instruction::ForEachObject{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:$target_up_to, filter:CardType(Creature)})), binding:0, body:Program{instructions:[Effect{result:@next, operation:$attached_aura_creation}]}} */
attached_aura_each ::= "for" "each" "of" target_up_to "target" "creatures" "," attached_aura_creation

/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:Explicit('Smoke Blessing'), colors:[$token_color], card_types:[Enchantment], subtypes:[Aura], abilities:[Enchant{hosts:Permanents(CardType(Creature))}, $attached_aura_death_trigger]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo(Bound(0))]}} */
attached_aura_creation ::= "create" "a" token_color "Aura" "enchantment" "token" "named" "Smoke" "Blessing" "attached" "to" "that" "creature" "." "those" "tokens" "have" "enchant" "creature" "and" '"' attached_aura_death_trigger '"'

/* @sem Ability::@scope(Ability::Triggered{event:ZoneChange{objects:SameObject(AttachedTo(Source)), from:Battlefield, to:Graveyard}, limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:EventSubject, recipients:Players(One(ControllerOf(EventSubject))), amount:$number_digits, preventable:true}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}) */
attached_aura_death_trigger ::= "when" "enchanted" "creature" "dies" "," "it" "deals" number_digits "damage" "to" "its" "controller" "and" "you" "create" "a" token_named_recipe "token" "."

/* @sem Expr::CountCounters{recipients:Objects($affected), kind:$counter_kind, information:CurrentOrLastKnown} */
leading_count_object_counter ::= counter_kind "counter" "on" affected

/* Named rules tokens retain their intrinsic name separately from created recipes. */
/* @sem TokenRecipe::Named('Feroz''s Ban') */
tn_feroz_ban ::= "Feroz's" "Ban"

/* Named legendary recipes retain their own abilities and holder scopes. */
/* @sem TokenName::Explicit('Tamiyo''s Notebook') */
notebook_token_name ::= "Tamiyo's" "Notebook"

/* @sem Ability::[@holder($conditional_cast_cost_body), $token_quoted_sentence] */
quoted_cost_and_sentence ::= '"' conditional_cast_cost_body '"' "and" token_quoted_sentence

/* @sem TokenSpec::TokenSpec{amount:$counter_a, words:CreatingEffect, recipe:Defined{name:$notebook_token_name, supertypes:[Legendary], colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, abilities:$quoted_cost_and_sentence}} */
named_legendary_scoped_token ::= notebook_token_name "," counter_a "legendary" token_colors token_subtypes token_types "token" "with" quoted_cost_and_sentence

/* A following sentence describes intrinsic abilities of the attached token. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$counter_a, words:CreatingEffect, recipe:Defined{name:Explicit(Mask), colors:$token_colors, card_types:[Enchantment], subtypes:[Aura], abilities:[$enchant_permanents, $bare_umbra_armor]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo($object_ref)]}}}] */
instructions_named_attached_aura ::= "create" counter_a token_colors "Aura" "enchantment" "token" "named" "Mask" "attached" "to" object_ref "." "the" "token" "has" enchant_permanents "and" bare_umbra_armor

/* Exile and the conditional copy share the attempted target and its before receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One($object_ref), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:Before, index:0}, filter:Not($filter_phrase)}, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:$copy_colored_creature_keyword}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{}}] */
instructions_exile_conditional_modified_copy ::= "exile" object_ref "." "if" "it" "wasn't" "an" filter_phrase "," "create" "a" "token" "that's" "a" "copy" "of" "it" "," "except" copy_colored_creature_keyword

/* @sem Vec<CopyException>::[SetPowerToughness{power:$token_stat, toughness:$token_stat_2}, Colors{mode:Set, colors:Listed([$token_color])}, AddCreatureTypes($token_subtypes), AddCardTypes([Creature]), AddAbilities([Keyword($keyword_value)])] */
copy_colored_creature_keyword ::= "it's" "a" token_stat "/" token_stat token_color token_subtypes "creature" "with" keyword_value "in" "addition" "to" "its" "other" "types"

/* The inner final period closes the enclosing creation sentence. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$named_legendary_scoped_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
instructions_named_legendary_scoped ::= "create" named_legendary_scoped_token

/* Token names are independent of their colors, creature types, and statistics. */
/* @sem TokenName::Explicit(Mowu) */
explicit_token_mowu ::= "Mowu"

/* @sem TokenName::Explicit('Primo, the Indivisible') */
explicit_token_primo ::= "Primo" "," "the" "Indivisible"

/* @sem TokenName::Explicit('Scion of the Deep') */
explicit_token_scion_deep ::= "Scion" "of" "the" "Deep"

/* The creation occurs only if both choices exist. */
/* @sem Instruction::[If{condition:AllOf([ValueChosen(Color), ValueChosen(CreatureType)]), then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$chosen_creature_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{}}] */
instructions_chosen_creature_token ::= "create" chosen_creature_token

/* A named artifact token carries its own scoped activated ability. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$token_amount, words:CreatingEffect, recipe:$named_artifact_quoted_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
instructions_named_artifact_token_quoted ::= "create" token_amount named_artifact_quoted_recipe

named_artifact_quoted_recipe ::= named_artifact_quoted_etherium | named_snow_quoted_recipe | named_artifact_departure_recipe

/* The trailing definition supplies the amount, independently of the token recipe. */
/* @sem TokenSpec::TokenSpec{amount:$graveyard_hand_library_history, words:CreatingEffect, recipe:$token_recipe} */
token_history_x_tapped ::= "X" "tapped" token_recipe "," "where" "X" "is" graveyard_hand_library_history

/* The X definition supplies the amount while the recipe remains independently composable. */
/* @sem TokenSpec::TokenSpec{amount:$token_damage_x_amount, words:CreatingEffect, recipe:$token_recipe} */
token_defined_damage_x ::= "X" token_recipe "," "where" "X" "is" token_damage_x_amount

/* @sem TokenSpec::TokenSpec{amount:$token_damage_x_amount, words:CreatingEffect, recipe:$token_recipe_quoted_comma} */
token_defined_damage_x_quoted ::= "X" token_recipe_quoted_comma "where" "X" "is" token_damage_x_amount

/* @sem TokenRecipe::@token_abilities($token_recipe_base, $token_comma_abilities) */
token_recipe_quoted_comma ::= token_recipe_base "with" token_comma_abilities

/* @sem Ability::[$token_comma_static] */
token_comma_abilities ::= token_comma_static

/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:$static_changes} */
token_comma_static ::= '"' affected static_changes "," '"' 

token_damage_x_amount ::= token_damage_opponents | token_damage_object

/* @sem Expr::EventHistory{event:Damage(_{source_kind:Any, sources:Any, recipients:Players(OpponentsOf(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:TotalAmount} */
token_damage_opponents ::= "the" "damage" "dealt" "to" "your" "opponents" "this" "turn"

/* @sem Expr::EventHistory{event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject($object_ref)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:TotalAmount} */
token_damage_object ::= "the" "amount" "of" "damage" "dealt" "to" object_ref "this" "turn"

/* Keep the payment and its created token's grant and delayed exile in one branch. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$pay_mana, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[$conditional_token_creation, $conditional_token_grant, $scoped_token_exile_end]}, otherwise:Program{}}]} */
scoped_paid_token_program ::= "you" "may" pay_mana "." "if" "you" "do" "," conditional_token_creation "." conditional_token_grant "." scoped_token_exile_end "."

/* @sem Instruction::Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:$created_reference, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}} */
scoped_token_exile_end ::= "exile" created_reference "at" "the" "beginning" "of" "the" "next" "end" "step"

/* @sem Operation::CreateTrigger{event:$event, duration:$this_duration, announcement:@announcement, body:$temporary_attacking_tokens_program} */
temporary_trigger_attacking_tokens ::= "whenever" event this_duration "," temporary_attacking_tokens_program

/* @prefer always */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$temporary_trigger_attacking_tokens}]}} */
activated_temporary_trigger_attacking_tokens ::= cost ":" temporary_trigger_attacking_tokens "."

/* A blocking token enters in combat against the announced attacker. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[Blocking(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$filter_phrase, AttackingDefender(Players(One(AbilityController)))])}), index:0})]}}) */
create_blocking_single ::= "create" "a" token_recipe "that's" "blocking" "target" filter_phrase "attacking" "you"

/* The token's literal name is independent of its source and characteristics. */
/* @sem String::'Ajani''s Pridemate' */
created_name_ajanis_pridemate ::= "Ajani's" "Pridemate"

/* The first action completes before the independent condition and creation. */
/* @sem Instruction::[Effect{result:@next, operation:$operation}, If{condition:$condition_no_counters, then:Program{instructions:[$conditional_token_creation]}, otherwise:Program{}}] */
instructions_then_conditional_creation ::= operation "." "then" "if" condition_no_counters "," conditional_token_creation

/* Both branches use the same current recipe; only the quantity is replaced. */
/* @sem Instruction::[If{condition:$condition_control_named_pair, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$counter_amount_2, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}] */
instructions_token_quantity_override ::= "create" counter_amount token_recipe "." "create" counter_amount "of" "those" "tokens" "instead" "if" condition_control_named_pair

/* A token population keeps its written qualifier and subsequent modifiers. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::Token, $modifiers)} */
qualified_token_population ::= filter_phrase "token" modifiers

/* Each selected token supplies the antecedent for its own copy. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyEach{objects:$qualified_token_population, exceptions:[]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_attacking_copy_each_token ::= "for" "each" qualified_token_population "," "create" "a" "tapped" "and" "attacking" "token" "that's" "a" "copy" "of" "that" "token"

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:$copy_token_plural_amount, words:CreatingEffect, recipe:CopyEach{objects:$qualified_token_population, exceptions:[]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_attacking_copies_each_token ::= "for" "each" qualified_token_population "," "create" copy_token_plural_amount "tapped" "and" "attacking" "tokens" "that" "are" "copies" "of" "that" "token"

copy_token_plural_amount ::= n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10 | n11 | n12 | n13 | n14 | n15 | n20 | n30

/* A choice list composes token alternatives without fixing their recipes. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$token_group], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
token_choice_option ::= token_group

/* @sem Program::[$token_choice_option] */
token_choice_last ::= "or" token_choice_option

/* @sem Program::[$token_choice_option, ...$token_choice_tail] */
token_choice_more ::= token_choice_option "," token_choice_tail

token_choice_tail ::= token_choice_last | token_choice_more

/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[$token_choice_option, ...$token_choice_tail]}] */
clause_create_token_choice ::= "create" "your" "choice" "of" token_choice_option "," token_choice_tail

/* A single token already on the battlefield has its own quoted ability. */
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:@token_abilities($singular_counted_token_recipe, $target_other_quote_list)} */
before_game_single_token ::= "a" singular_counted_token_recipe "on" "the" "battlefield" "." "it" "has" target_other_quote_list

/* @sem Ability::BeforeGame{when:GameBegins, body:List([Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$before_game_single_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}])} */
before_game_with_token ::= "you" "begin" "the" "game" "with" before_game_single_token

/* The shared trailing definition supplies both token characteristics. Limit the
   history expression to a producer-independent life total for this turn. */
/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$value_life_gained_turn, $value_life_gained_turn]}) */
token_recipe_equal_history ::= "X" "/" "X" token_colors token_subtypes token_types "tokens" "," "where" "X" "is" value_life_gained_turn

/* The cost and consumer are one phrase: the measured object is the single
   creature sacrificed as component zero of this casting cost. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:Exactly(Constant(1))}]}, repetition:Once}), Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:ObjectProperty{object:Query{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Inputs, phase:Before}, index:0}, property:$casting_sacrifice_stat, information:CurrentOrLastKnown}, words:CreatingEffect, recipe:$casting_sacrifice_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]}}] */
line_casting_sacrifice_tokens ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "sacrifice" "a" "creature" "." NEWLINE "create" "X" casting_sacrifice_token_recipe "where" "X" "is" "the" "sacrificed" "creature's" casting_sacrifice_stat "."

casting_sacrifice_stat ::= stat_power | stat_toughness

/* The quotation's comma ends the triggered ability before the where clause. */
/* @sem TokenRecipe::@token_abilities($token_recipe_base, $casting_sacrifice_token_ability) */
casting_sacrifice_token_recipe ::= token_recipe_base "with" casting_sacrifice_token_ability

/* @sem Ability::[@scope(Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$program})] */
casting_sacrifice_token_ability ::= '"' event_clause "," program "," '"'

/* A named token can state all colors after its name and list intrinsic abilities. */
/* @sem TokenRecipe::Defined(_{name:Explicit($created_token_name), colors:[White, Blue, Black, Red, Green], card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2]}) */
token_recipe_named_all_colors ::= token_stat "/" token_stat token_subtypes token_types "token" "named" created_token_name "that's" "all" "colors"

/* @sem TokenRecipe::@token_abilities($token_recipe_named_all_colors, $token_ability_description) */
token_recipe_named_all_colors_with ::= token_recipe_named_all_colors token_ability_description

/* @sem String::'Reliquary Dragon' */
created_name_reliquary_dragon ::= "Reliquary" "Dragon"

/* The closing quotation carries the sentence's period. The list must end in
   a quoted ability so that the enclosing activation need not add another. */
/* @sem Ability::[$token_quoted] */
token_final_quoted_last ::= "and" token_quoted

token_final_quoted_tail ::= token_final_quoted_last | token_final_quoted_list

/* @sem Ability::[$token_ability, ...$token_final_quoted_tail] */
token_final_quoted_list ::= token_ability "," token_final_quoted_tail

/* @sem TokenRecipe::@token_abilities($token_recipe_named_all_colors, $token_final_quoted_list) */
token_named_colors_final_quote ::= token_recipe_named_all_colors "." "it" "has" token_final_quoted_list

/* @sem Operation::@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:$token_named_colors_final_quote}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_named_colors_final_quote ::= "create" token_amount token_named_colors_final_quote

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$create_named_colors_final_quote}]}} */
activated_token_final_quote_limited ::= cost ":" create_named_colors_final_quote activation_limits "."

/* A single copied token establishes the antecedent of its delayed exile. */
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:$copy_exceptions_plain}} */
single_copy_token_with_exceptions ::= token_copy_single object_ref "," "except" copy_exceptions_plain

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[$single_copy_token_with_exceptions], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Created(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}]} */
program_single_copy_exile_combat ::= "create" single_copy_token_with_exceptions "." "exile" "it" "at" "end" "of" "combat"

/* The grant and cleanup refer to the same preceding creation. */
/* @sem Instruction::[$conditional_token_grant, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:$created_ordinary_singular, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}] */
conditional_token_grant_exile ::= conditional_token_grant "." "exile" created_ordinary_singular "at" "the" "beginning" "of" "the" "next" "end" "step"

/* The host is chosen from the current event group, not a prior token. */
/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:Rules, recipe:$role_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[AttachedToChosen(InSet(EventGroup))]}} */
create_role_on_event_member ::= "create" "a" role_recipe "token" "attached" "to" "one" "of" "them"

/* A temporary grant applies to the batch created earlier in this program. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($created_gain_subject), changes:$grants, duration:$duration, evaluation:Snapshot}}] */
clause_created_temporary_gain ::= created_gain_subject "gain" grants duration

/* The immediately created singular token is the animated object. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Created(@marked)), changes:[SetBasePowerToughness{power:$token_stat, toughness:$token_stat_2}, AddCardType(Artifact), AddCardType(Creature), GrantKeyword($keyword_name)], duration:Indefinite, evaluation:Snapshot}}] */
instructions_named_token_animation ::= "create" "a" token_named_recipe "token" "." "it" "becomes" "a" token_stat "/" token_stat "artifact" "creature" "and" "gains" keyword_name

/* @prefer always */
/* @sem Ability::[$named_x_attack_quote] */
chapter_token_attack_abilities ::= named_x_attack_quote

/* The attack event belongs to the newly created token; its body composes independently. */
/* chapter_token_attack_quoted is shared as named_x_attack_quote. */

/* A linked exiled card and its copy exceptions retain independent operands. */
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyOne{objects:$token_exiled_card, exceptions:$copy_exceptions_plain}} */
token_copy_exiled_modified ::= "a" "token" "that's" "a" "copy" "of" token_exiled_card "," "except" copy_exceptions_plain

/* The Cursed Role sets its enchanted creature’s base power and toughness. */
/* @sem TokenRecipe::Defined{name:Explicit(Cursed), card_types:[Enchantment], subtypes:[Aura, Role], abilities:[Enchant{hosts:Permanents(CardType(Creature))}, Static(_{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[SetBasePowerToughness{power:Constant(1), toughness:Constant(1)}]})]} */
cursed_role_recipe ::= "Cursed" "Role"

/* Random Oracle copies compose their population and the comparison's object. */
/* @sem TokenSpec::TokenSpec{amount:$token_copy_quantity, words:CreatingEffect, recipe:CopyAtRandom{cards:$random_oracle_copy_cards}} */
token_copy_random_oracle ::= token_copy_quantity "a" "random" random_oracle_copy_cards

random_oracle_copy_cards ::= random_oracle_copy_same_value | random_oracle_copy_mana_value

/* @sem Operand::Term{family:CardsInOracle, form:IsNonCreatureType, operands:[Vocabulary{family:CreatureType, form:Shapeshifter}]} */
random_oracle_excluded_type ::= "non-Shapeshifter"

/* The token's two statistics both measure the grouped damage event. This
   recipe is used only by the scoped grouped-creature-damage trigger below. */
/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[EventAmount, EventAmount], abilities:[Keyword($keyword_value)]}) */
group_damage_token_recipe ::= "X" "/" "X" token_colors token_subtypes token_types "token" "with" keyword_value

/* The recipient grouping proves that the damage amount is that dealt by the
   triggering creatures to the one player referenced in the where-clause. */
/* @sem Ability::Triggered{event:Damage{source_kind:Permanent, sources:AllOf([CardType(Creature), ControlledBy(One(AbilityController)), HasKeyword($keyword_value)]), recipients:Players(All), kind:Combat, grouping:Recipient, subject:Source}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$group_damage_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]}} */
triggered_group_damage_token ::= "whenever" "one" "or" "more" "creatures" "you" "control" "with" keyword_value "deal" "combat" "damage" "to" "a" "player" "," "create" "an" group_damage_token_recipe "," "where" "X" "is" "the" "amount" "of" "damage" "those" "creatures" "dealt" "to" "that" "player" "."

/* The creation and its anaphoric counter placement share the creation receipt. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$create_one_defined}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@prior)), kind:$counter_kind, amount:Earlier{what:LeftGraveyard, measure:Greatest(ManaValue)}}]}}]} */
created_graveyard_counter_program ::= create_one_defined "," "then" "put" "a" "number" "of" counter_kind "counters" "on" "it" "equal" "to" "the" "greatest" "mana" "value" "among" "those" "cards"

/* A required life payment and its dependent creation share the same value. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[Life($value)]}}}, If{condition:PaymentChosen(@last_result), then:_{instructions:[Effect{result:@next, operation:$create_one_defined}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@prior)), kind:$counter_kind, amount:$value}]}}]}, otherwise:_{}}]} */
paid_created_counter_program ::= "pay" "X" "life" "," "where" "X" "is" value "." "if" "you" "do" "," create_one_defined "and" "put" "X" counter_kind "counters" "on" "it"

/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
create_one_defined ::= "create" "a" token_recipe

/* The discard itself supplies the receipt counted by the following token instruction. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}, Effect{result:@mark, operation:Discard{players:One(AbilityController), amount:$card_count_2, random:false}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountDistinct{objects:Transition{result:@marked, phase:After}, property:CardTypes}, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]}} */
spell_draw_discard_distinct_tokens ::= "draw" card_count "," "then" "discard" card_count "." "create" "a" token_recipe "for" "each" "card" "type" "among" "cards" "discarded" "this" "way" "."

/* The measured removal is exactly the second component of this activation. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}), kind:PowerToughness(1, 1), amount:AmongThem(AtLeast(Constant(1)))}]}]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:$token_colors, card_types:[Creature], subtypes:$token_subtypes, power_toughness:[PaidCountersRemoved{payment:Activation, component:[1]}, PaidCountersRemoved{payment:Activation, component:[1]}]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]}} */
activated_remove_among_scaled_token ::= cost_mana "," "↑" "remove" "one" "or" "more" "+" "1" "/" "+" "1" "counters" "from" "among" filter_plural "you" "control" ":" "create" "an" "X" "/" "X" token_colors token_subtypes "creature" "token" "," "where" "X" "is" "the" "number" "of" "+" "1" "/" "+" "1" "counters" "removed" "this" "way" "."

/* One creation is replaced by a different count of the same recipe and entry. */
/* @sem Program::Program{instructions:[If{condition:$condition_died, then:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$count_plural, words:CreatingEffect, recipe:$singular_counted_token_recipe}], entry:BattlefieldArrival{tapped:true}}}]}, otherwise:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$singular_counted_token_recipe}], entry:BattlefieldArrival{tapped:true}}}]}}]} */
program_tapped_token_death_replacement ::= "create" "a" "tapped" singular_counted_token_recipe "." "if" condition_died "," "create" count_plural "of" "those" "tokens" "instead" "."

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$program_tapped_token_death_replacement} */
triggered_tapped_token_death_replacement ::= "at" turn_event "," program_tapped_token_death_replacement

/* @sem String::'Nalaar Aetherjet' */
created_name_nalaar_aetherjet ::= "Nalaar" "Aetherjet"

/* Only the enclosing exile-payment activation may supply this receipt. */
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:$paid_exile_token_name, supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2], abilities:[Keyword($keyword_value)], abilities_of:[CostObjects{payment:Activation, component:[1], view:Performed, phase:After}, List([Term{family:CheckHasable, form:TriggeredAbility}])]}} */
paid_exile_legendary_token ::= paid_exile_token_name "," counter_amount "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token" "with" keyword_value "and" "all" "triggered" "abilities" "of" "the" "exiled" "cards"

paid_exile_token_name ::= paid_exile_name_vecna | explicit_legendary_name

/* @sem TokenName::Explicit(Vecna) */
paid_exile_name_vecna ::= "Vecna"

/* The name is independent of the token characteristics. */
/* created_name_wirefly is shared as card_name_wirefly. */

/* A named token count reads the Before receipt of the immediately preceding
   destroy or sacrifice action. Keeping both instructions in the same production
   constrains the inverse to the action named by the text. */
/* @sem Instruction::[Effect{result:@mark, operation:$destroy}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$filter_phrase}), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}})}] */
instructions_destroy_receipt_named_tapped ::= destroy "." "for" "each" filter_phrase "destroyed" "this" "way" "," "you" "create" "a" "tapped" token_named_recipe "token"

/* @sem Instruction::[Effect{result:@mark, operation:@sacrificed_result(Operation::Sacrifice{players:OpponentsOf(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Constant(1))})}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$filter_phrase_2}), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
instructions_opponents_sacrifice_receipt_named ::= "each" "opponent" "sacrifices" "an" filter_phrase "." "for" "each" filter_phrase "sacrificed" "this" "way" "," "you" "create" "a" token_named_recipe "token"

/* The alternative uses the same token recipe as the ordinary creation. */
/* @sem Program::Program{instructions:[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}]} */
shared_token_conditional_instead ::= "create" token_amount token_recipe "." "if" condition "," "create" counter_amount "of" "those" "tokens" "instead" "."

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$shared_token_conditional_instead} */
shared_trigger_token_conditional ::= event_clause "," shared_token_conditional_instead

/* The delayed sacrifice consumes the tokens created by this same instruction. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[$token_copy_exiled_plural], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:One(AbilityController)}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(@marked)})}]}}}] */
instructions_linked_copy_sacrifice_own_end ::= "create" token_copy_exiled_plural "." "sacrifice" "them" "at" "the" "beginning" "of" "your" "next" "end" "step"

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[...$instructions_linked_copy_sacrifice_own_end]}} */
triggered_linked_copy_sacrifice_own_end ::= event_clause "," instructions_linked_copy_sacrifice_own_end "."

/* One implied choice between targets in different zones; each option owns its target. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$copy_token_plural_amount, words:CreatingEffect, recipe:Copy{object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:$copy_choice_graveyard_type}), index:0}, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$copy_token_plural_amount, words:CreatingEffect, recipe:Copy{object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$copy_choice_battlefield_type}), index:0}, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied} */
copy_choice_zone_modes ::= "choose" "target" copy_choice_graveyard_type "card" "in" "a" "graveyard" "or" copy_choice_battlefield_type "on" "the" "battlefield" "." "create" copy_token_plural_amount "tokens" "that" "are" "copies" "of" "it" "."

copy_choice_graveyard_type ::= noun_artifact | noun_creature | noun_enchantment | noun_land

copy_choice_battlefield_type ::= noun_artifact | noun_creature | noun_enchantment | noun_land

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[Loyalty($loyalty_heading)]}, limits:ActivationLimits{sorcery:true}, announcement:Announcement{modes:$copy_choice_zone_modes}, body:Program{}} */
loyalty_copy_choice_zones ::= loyalty_heading ":" copy_choice_zone_modes

/* @sem String::'Festering Goblin' */
created_name_festering_goblin ::= "Festering" "Goblin"

/* An explicitly named token can carry a prohibition and a scoped departure
   trigger. The card named by the return remains an independent operand. */
/* @sem TokenName::Explicit(Jumblebones) */
explicit_token_jumblebones ::= "Jumblebones"

/* @sem Ability::Static{kind:Ordinary, affected:Objects(One(Source)), changes:[Rule(Prohibit(Block(Any)))]} */
jumblebones_cannot_block ::= "Jumblebones" "can't" "block"

/* @sem Ability::Triggered{event:Object{event:LeavesBattlefield, objects:SameObject(Source)}, limits:_{}, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([Name($referenced_card_name), InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, announcement:@announcement} */
named_token_departure_return ::= "when" "Jumblebones" "leaves" "the" "battlefield" "," "return" "target" "card" "named" referenced_card_name "from" "your" "graveyard" "to" "your" "hand" "."

/* @sem Ability::[@holder($jumblebones_cannot_block), @holder($named_token_departure_return)] */
quoted_named_token_departure_abilities ::= "with" '"' jumblebones_cannot_block '"' "and" '"' named_token_departure_return '"'

/* @sem TokenSpec::TokenSpec{amount:$counter_a, words:CreatingEffect, recipe:Defined{name:$explicit_token_jumblebones, supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2], abilities:$quoted_named_token_departure_abilities}} */
