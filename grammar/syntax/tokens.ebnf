singular_cleanup_stated_stats_token ::= "a" token_colors token_subtypes token_types "token" "." "its" "power" "is" "equal" "to" value "and" "its" "toughness" "is" "equal" "to" value

/* @sem Instruction::Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_move_any_end, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(@marked)})}]}}} */
singular_created_token_sacrifice_cleanup ::= "sacrifice" "the" "token" "at" delayed_move_any_end

/* @sem Instruction::Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_move_any_end, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(@marked)})}]}}} */
singular_created_it_sacrifice_any_end ::= "sacrifice" "it" "at" delayed_move_any_end

/* @sem Instruction::[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[$singular_cleanup_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, $singular_created_it_sacrifice_any_end] */
singular_creation_it_sacrifice_any_end ::= "create" singular_cleanup_token "." singular_created_it_sacrifice_any_end

/* @sem Instruction::[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[$singular_cleanup_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, $singular_created_token_sacrifice_cleanup] */
singular_creation_token_sacrifice ::= "create" singular_cleanup_token "." singular_created_token_sacrifice_cleanup

/* A measured named-token quantity keeps the referenced object's stat and the
   entry state independent. Restrict the anaphor to the supported stat forms. */
token_equal_its_stat ::= value_power | value_toughness

/* @sem TokenSpec::TokenSpec{amount:$token_equal_its_stat, words:Rules, recipe:$token_named_recipe} */
token_named_equal_tapped ::= "a" "number" "of" "tapped" token_named_recipe "tokens" "equal" "to" token_equal_its_stat

/* @sem TokenSpec::TokenSpec{amount:$token_equal_its_stat, words:Rules, recipe:$token_named_recipe} */
token_named_equal_its_stat ::= "a" "number" "of" token_named_recipe "tokens" "equal" "to" token_equal_its_stat

/* Each iteration attaches its Role to the same controlled subtype member. */
/* @sem Instruction::[ForEachObject{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($creature_subtype, $creature_subtype_2), ControlledBy(One(AbilityController))])}, binding:0, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$role_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo(Bound(0))]}}}]}}] */
clause_each_controlled_subtype_role ::= "for" "each" creature_subtype "you" "control" "," "create" role_token "attached" "to" "that" creature_subtype

/* The exclusion is tied to this creation, including when operands are edited. */
/* @sem Instruction::[Effect{result:@mark, operation:@apply(PlayerSet::One(AbilityController), $create_base)}, Effect{result:@next, operation:Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(InSet(Created(@marked))), $filter_phrase, $filter_plural, ControlledBy(One(AbilityController))])}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
created_then_exile_other_controlled ::= create_base "." "then" "exile" "all" "other" filter_phrase filter_plural "you" "control"

/* Keep the singular creation and its combat-end sacrifice in one scope. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[$singular_cleanup_defined_token], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(@marked)})}]}}}]} */
singular_attacking_token_combat_sacrifice ::= "create" singular_cleanup_defined_token "that's" "tapped" "and" "attacking" "." "sacrifice" "that" "token" "at" "end" "of" "combat"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:$singular_attacking_token_combat_sacrifice, otherwise:Program{}}]} */
paid_singular_attacking_token_cleanup ::= "you" "may" payment "." "if" "you" "do" "," singular_attacking_token_combat_sacrifice

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$paid_singular_attacking_token_cleanup} */
triggered_paid_singular_combat_token ::= event_clause "," paid_singular_attacking_token_cleanup "."

/* @prefer always */
/* @sem Ability::[$token_ability, $token_ability_2, @holder($triggered_each_end_step)] */
token_named_end_multiple ::= token_ability "," token_ability "," "and" '"' triggered_each_end_step '"'

/* @sem Ability::[Mechanic{mechanic:BandsWithOthers, filter:AllOf([$filter_plural, Name($created_token_name)])}] */
token_named_end_bands ::= '"' "↓" "bands" "with" "other" filter_plural "named" created_token_name "." '"'

/* The copied population is linked to this ability's source, independently of
   the opponent attacked by each token. */
/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)} */
loop_linked_exiled_cards ::= "the" "exiled" "card"

/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyEach{objects:$loop_linked_exiled_cards, exceptions:[]}} */
loop_tapped_linked_copy ::= "a" "tapped" "token" "that's" "a" "copy" "of" loop_linked_exiled_cards

/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:CopyEach{objects:$loop_linked_exiled_cards, exceptions:[]}} */
loop_tapped_linked_copies ::= counter_amount "tapped" "tokens" "that" "are" "copies" "of" loop_linked_exiled_cards

loop_tapped_copy_spec ::= loop_tapped_linked_copy | loop_tapped_linked_copies

/* The delayed sacrifice consumes the creation result inside this exact loop. */
/* @sem Program::Program{instructions:[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[$loop_tapped_copy_spec], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{player:Bound(0)}]}}}]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_move_end_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(@marked)})}]}}}]} */
per_opponent_linked_copy_cleanup ::= "for" "each" "opponent" "," "create" loop_tapped_copy_spec "attacking" "that" "opponent" "." "at" delayed_move_end_event "," "sacrifice" "those" "tokens"

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$per_opponent_linked_copy_cleanup} */
triggered_per_opponent_linked_copy_cleanup ::= event_clause "," per_opponent_linked_copy_cleanup "."

/* The second sentence refers to this creation's result, not a live token population. */
/* @sem Instruction::[Effect{result:@mark, operation:@apply($players_singular, $create_tapped_third)}, Effect{result:@next, operation:KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Goad{until:Indefinite}, objects:Created(@marked)}}] */
instructions_created_tokens_goaded ::= players_singular create_tapped_third "." "the" "tokens" "are" "goaded" "for" "the" "rest" "of" "the" "game"

/* A single token enters in combat; its recipe and X definition remain operands. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$attacking_x_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_attacking_x_where ::= "create" "a" "tapped" "and" "attacking" attacking_x_recipe

/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$value, $value], abilities:[Keyword($keyword_name)]}) */
attacking_x_recipe ::= "X" "/" "X" token_colors token_subtypes token_types "token" "with" keyword_name "," "where" "X" "is" value

/* The bound host is the object selected by the enclosing loop. */
/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:Rules, recipe:$role_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo(Bound(0))]}} */
create_role_on_each_singular ::= "create" "a" role_recipe "token" "attached" "to" "that" "creature"

/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$number, words:Rules, recipe:$role_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo(Bound(0))]}} */
create_role_on_each_plural ::= "create" number role_recipe "tokens" "attached" "to" "that" "creature"

create_role_on_each ::= create_role_on_each_singular | create_role_on_each_plural

/* @sem Instruction::[ForEachObject{objects:$affected, binding:0, body:Program{instructions:[Effect{result:@next, operation:$create_role_on_each}]}}] */
for_each_create_attached_role ::= "for" affected "," create_role_on_each

/* X token quantities require the plural spelling, while retaining the recipe operands. */
/* mill_mana_plural_token_recipe is shared as paid_mana_plural_token_recipe. */

/* @sem TokenName::Explicit(Ravage) */
explicit_token_ravage ::= "Ravage"

/* @sem TokenName::Explicit(Laserbeak) */
explicit_token_laserbeak ::= "Laserbeak"

/* Both followups refer to the immediately created token's receipt. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($created_ordinary_singular), changes:$grants, duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:$created_ordinary_singular_2, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}] */
conditional_token_gains_exile ::= created_ordinary_singular "gains" grants "." "exile" created_ordinary_singular "at" "the" "beginning" "of" "the" "next" "end" "step"

/* A copy's replacement characteristics and keyword retain independent operands. */
/* @sem Vec<CopyException>::[...$copy_token_characteristics, CopyException::AddAbilities([Keyword($keyword_value)])] */
copy_characteristics_with_keyword ::= copy_token_characteristics "with" keyword_value

/* Copy creation retains the copied object and its replacement characteristics. */
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:$copy_characteristics_with_keyword}} */
attacking_copy_characteristics_spec ::= counter_amount "tapped" "and" "attacking" "token" "that's" "a" "copy" "of" object_ref "," "except" copy_characteristics_with_keyword

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[$attacking_copy_characteristics_spec], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_attacking_copy_with_characteristics ::= "create" attacking_copy_characteristics_spec

/* The created permanent must have the named subtype. */
/* @sem Instruction::[Effect{result:@next, operation:PutCountersEach{amount:$created_plural_counter_number, kind:Named(LoreCounter), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([InSet($created_ordinary_singular), Subtype(Saga)])}, up_to:true}}] */
clause_created_if_subtype_counters ::= "if" "it's" "a" "Saga" "," "put" "up" "to" created_plural_counter_number "lore" "counters" "on" created_ordinary_singular

/* The delayed sacrifice keeps the token receipt and the controller's end step. */
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:One(AbilityController)}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:$created_ordinary_singular}}]}}}] */
clause_created_sacrifice_your_next_end ::= "sacrifice" created_ordinary_singular "at" "the" "beginning" "of" "your" "next" "end" "step"

created_plural_counter_number ::= n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10 | n11 | n12 | n13 | n14 | n15 | n20 | n30 | number_hundred

/* An exile selection and its successful payment govern both token creation and
   the following sentence about the created token. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$cost_exile_permanent]}, optional:false}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[$conditional_token_creation, ...$conditional_token_followups]}, otherwise:Program{}}] */
clause_exile_payment_token_followups ::= cost_exile_permanent "." "if" "you" "do" "," conditional_token_creation "." conditional_token_followups

/* Bind the destruction and its counted Before receipt in both directions. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:$destroy}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$prior_controlled_nontoken_filter}), words:CreatingEffect, recipe:$singular_counted_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}} */
spell_destroy_prior_controlled_tokens ::= destroy "." NEWLINE? "then" "create" "a" singular_counted_token_recipe "for" "each" prior_controlled_nontoken_filter "that" "was" "destroyed" "this" "way" "."

/* The final period belongs to the quoted ability; its holder is the token. */
/* @sem TokenRecipe::@token_abilities($token_recipe_base, $chapter_quoted_token_abilities) */
token_recipe_final_quote ::= token_recipe_base "with" chapter_quoted_token_abilities

/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountPlayers($players_singular), words:CreatingEffect, recipe:$token_recipe_final_quote}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
clause_per_player_quoted_token ::= "for" players_singular "," "you" "create" "a" token_recipe_final_quote

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$clause_per_player_quoted_token}} */
spell_per_player_quoted_token ::= clause_per_player_quoted_token

/* The counted receipt is produced by returning the battlefield creatures to
   their owners' hands in this same spell, not by an arbitrary prior action. */
/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Multiply([$token_amount, CountPlayers(Intersection([$players_singular, Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:Transition{result:@prior, phase:Before}, filter:ControlledBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}]))]), words:CreatingEffect, recipe:$return_count_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}} */
spell_return_creatures_controller_tokens ::= "return" "all" "creatures" "to" "their" "owners'" "hands" "." "for" players_singular "who" "controlled" "a" "creature" "returned" "this" "way" "," "you" "create" token_amount return_count_token_recipe

/* @sem TokenRecipe::@token_abilities($token_recipe_base, $return_count_abilities) */
return_count_token_recipe ::= token_recipe_base "with" return_count_abilities

/* @sem Ability::[$keyword_ability, $token_quoted] */
return_count_abilities ::= keyword_ability "and" token_quoted

/* The counted excess belongs to this immediately preceding damage to one target creature. */
/* @sem Instruction::[Effect{result:@mark, operation:DealDamage{source:$damage_source_ref, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0})), amount:$number, preventable:true}}, If{condition:Compare{left:ExcessDamage{result:@marked, to:Any}, test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:ExcessDamage{result:@marked, to:Any}, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{}}] */
instructions_damage_excess_named_tokens ::= damage_source_ref "deals" number "damage" "to" "target" "creature" "." "create" "a" "number" "of" token_named_recipe "tokens" "equal" "to" "the" "amount" "of" "excess" "damage" "dealt" "to" "that" "creature" "this" "way"

/* @sem TokenRecipe::Named('Lord of the Pit') */
tn_lord_of_the_pit ::= "Lord" "of" "the" "Pit"

/* @sem TokenRecipe::Named(Gingerbrute) */
tn_gingerbrute ::= "Gingerbrute"

/* The counter placement refers to the token produced by this creation, while
   the quantity is the X announced for the spell in the enclosing cast event. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$create_one_defined}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@prior)), kind:$counter_kind, amount:CastX(EventSubject)}]}}]} */
created_cast_x_counter_program ::= create_one_defined "," "then" "put" "X" counter_kind "counters" "on" "it"

/* Both alternatives copy the same target; the conditional changes only the
   number created when that target has the stated subtype. */
/* @sem Program::Program{instructions:[If{condition:ObjectMatches{object:$copy_target_controlled_token, filter:$subtype_spelled}, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$copy_token_plural_amount, words:CreatingEffect, recipe:Copy{object:$copy_target_controlled_token, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:Copy{object:$copy_target_controlled_token, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}]} */
conditional_controlled_token_copy_quantity ::= "create" token_copy_single copy_target_controlled_token "." "if" "that" "token" "is" "a" subtype_spelled "," "instead" "create" copy_token_plural_amount "tokens" "that" "are" "copies" "of" "it" "."

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:AllOf([Token, ControlledBy(One(AbilityController))])}), index:0} */
copy_target_controlled_token ::= "target" "token" "you" "control"

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$conditional_controlled_token_copy_quantity} */
triggered_conditional_token_copy_quantity ::= event_clause "," conditional_controlled_token_copy_quantity

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$conditional_controlled_token_copy_quantity} */
turn_conditional_token_copy_quantity ::= "at" turn_event "," conditional_controlled_token_copy_quantity

/* A singular copied token may drop its legendary supertype. */
/* @sem TokenSpec::TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:[$copy_not_legendary]}} */
token_copy_nonlegendary_singular ::= token_copy_single object_ref "," "except" copy_not_legendary

/* @sem TokenName::Explicit(Guenhwyvar) */
explicit_token_guenhwyvar ::= "Guenhwyvar"

/* @prefer always */
/* @sem TokenRecipe::Defined(_{name:Explicit('Etherium Cell'), card_types:[Artifact], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program})]}) */
named_artifact_quoted_etherium ::= "colorless" "artifact" "token" "named" "Etherium" "Cell" "with" '"' cost ":" program "." '"'

/* The recipe and quoted ability remain separate from the creating action. */
/* @sem TokenRecipe::Defined(_{name:Explicit($snow_token_name), colors:$token_colors, supertypes:[Snow], card_types:$token_types, abilities:[@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program})]}) */
named_snow_quoted_recipe ::= token_colors "snow" token_types "token" "named" snow_token_name "with" '"' cost ":" program "." '"'

/* @sem String::'Icy Manalith' */
snow_token_name ::= "Icy" "Manalith"

/* Copied tokens gain creature type and two independent keyword abilities. */
/* @sem Vec<CopyException>::[SetPowerToughness{power:$value, toughness:$value_2}, AddCardTypes([Creature]), AddAbilities([Keyword($keyword_value)]), AddAbilities([Keyword($keyword_value_2)])] */
copy_plural_creature_stats_two_keywords ::= "they're" value "/" value "creatures" "in" "addition" "to" "their" "other" "types" "and" "they" "have" keyword_value "and" keyword_value

/* Named statless tokens retain their own intrinsic abilities. */
/* @sem TokenRecipe::Defined(_{name:Explicit($created_token_name), colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, abilities:$token_intrinsic_pair}) */
token_recipe_named_statless_with ::= token_colors token_subtypes token_types "token" "named" created_token_name "with" token_intrinsic_pair

/* @sem String::Sword */
created_name_sword ::= "Sword"

/* @sem Ability::Static{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Pump{power:$signed, toughness:$signed_2}]} */
token_equipped_pump ::= "equipped" "creature" "gets" signed "/" signed

/* @sem Ability::@holder($token_equipped_pump) */
token_quoted_equipped_pump ::= '"' token_equipped_pump '"'

/* @sem Ability::@holder($keyword_equip) */
token_equip_scoped ::= keyword_equip

/* @sem Ability::[$token_quoted_equipped_pump, $token_equip_scoped] */
token_intrinsic_pair ::= token_quoted_equipped_pump "and" token_equip_scoped

/* @sem String::'Cloud Sprite' */
created_name_cloud_sprite ::= "Cloud" "Sprite"

/* Two created tokens are the antecedent of the distributed counter choice. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(2), words:CreatingEffect, recipe:$pair_quoted_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:DuplicateCounters{from:CounterSource::On(Objects($affected)), to:Objects(Created(@marked)), copies:OneOfEachKindDistributed}}] */
clause_created_pair_counter_kinds ::= "create" "two" pair_quoted_token_recipe "then" "for" "each" "kind" "of" "counter" "among" affected "," "put" "a" "counter" "of" "that" "kind" "on" "either" "of" "those" "tokens"

/* @sem TokenRecipe::@token_abilities($paid_mana_plural_token_recipe, $pair_quoted_static) */
pair_quoted_token_recipe ::= paid_mana_plural_token_recipe "with" pair_quoted_static

/* @sem Ability::[Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes})] */
pair_quoted_static ::= '"' affected static_changes "." '"'

/* Keep the anaphor tied to the creature group announced by the preceding grant. */
/* @sem Instruction::[Effect{result:@next, operation:$target_creatures_each_change}, ...$clause_each_target_role_attached] */
instructions_target_creatures_role ::= target_creatures_each_change "." clause_each_target_role_attached

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:$plural_target_count_any, filter:CardType(Creature)}))), changes:$grants, duration:$duration, evaluation:Snapshot} */
target_creatures_each_change ::= plural_target_count_any "target" "creatures" "each" "gain" grants duration

/* Each member of the announced target group receives its own Role. */
/* @sem Instruction::[ForEachObject{objects:Targets(@last_slot), binding:0, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$each_attached_role_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo(Bound(0))]}}}]}}] */
clause_each_target_role_attached ::= "for" "each" "of" "those" "creatures" "," "create" each_attached_role_token "attached" "to" "it"

each_attached_role_token ::= each_attached_role_one | each_attached_role_many

/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:Rules, recipe:$role_recipe} */
each_attached_role_one ::= "a" role_recipe "token"

/* @sem TokenSpec::TokenSpec{amount:$count_plural, words:Rules, recipe:$role_recipe} */
each_attached_role_many ::= count_plural role_recipe "tokens"

/* A singular defined creature token with intrinsic abilities. */
/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2], abilities:$token_abilities}) */
single_token_recipe_with ::= token_stat "/" token_stat token_colors token_subtypes token_types "token" "with" token_abilities

/* Both branches create the same current recipe, with independent quantities. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:$plural_token_activated_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$counter_amount_2, words:CreatingEffect, recipe:$plural_token_activated_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}] */
instructions_conditional_shared_token_recipe ::= "if" condition "," "create" counter_amount plural_token_activated_recipe "otherwise" "," "create" counter_amount "of" "those" "tokens"

/* The following sentence specifies an intrinsic ability of every created token. */
/* @sem TokenRecipe::@token_abilities($token_recipe_base, $plural_token_activated_abilities) */
plural_token_activated_recipe ::= token_recipe_base "." "they" "have" '"' plural_token_activated_abilities '"'

/* @sem Ability::[$plural_token_activated_ability] */
plural_token_activated_abilities ::= plural_token_activated_ability

/* @sem Ability::@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program}) */
plural_token_activated_ability ::= cost ":" program "."

/* Copy entry counters belong to the token's arrival, not to its copiable values. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[$token_copy_singular], entry:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[]}}) */
create_copy_extra_counter ::= "create" token_copy_singular "," "except" "it" "enters" "with" "an" "additional" counter_kind "counter" "on" "it"

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[$token_copy_singular], entry:BattlefieldArrival{tapped:false, counters:[[$counter_kind, $copy_extra_counter_count]], states:[]}}) */
create_copy_extra_counters ::= "create" token_copy_singular "," "except" "it" "enters" "with" copy_extra_counter_count "additional" counter_kind "counters" "on" "it"

copy_extra_counter_count ::= n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10 | n11 | n12 | n13 | n14 | n15 | n20 | n30 | number_hundred | number_x

/* A single new token enters with counters counted over the existing population. */
/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[[$counter_kind, CountObjects($affected)]], states:[]} */
token_entry_other_population ::= "the" "token" "enters" "with" "X" counter_kind "counters" "on" "it" "," "where" "X" "is" "the" "number" "of" "other" affected

/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$token_recipe}], entry:$token_entry_other_population}}] */
instructions_create_single_token_with_entry ::= "create" "a" token_recipe "." token_entry_other_population

/* The delayed sacrifice consumes the result of this single token creation. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[$single_copy_token_with_exceptions], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(@marked)})}]}}}]} */
program_single_copy_sacrifice_end ::= "create" single_copy_token_with_exceptions "." "sacrifice" "it" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* Both copied characteristics measure the previously named creature. */
/* @sem Vec<CopyException>::[SetPowerToughness{power:Divide{numerator:ObjectProperty{object:@it, property:Power, information:CurrentOrLastKnown}, denominator:Constant(2), rounding:$fraction_round_each}, toughness:Divide{numerator:ObjectProperty{object:@it, property:Toughness, information:CurrentOrLastKnown}, denominator:Constant(2), rounding:$fraction_round_each}}] */
copy_plural_half_creature_stats ::= "their" "power" "is" "half" "that" "creature's" "power" "and" "their" "toughness" "is" "half" "that" "creature's" "toughness" "." fraction_round_each

/* @sem TokenSpec::TokenSpec{amount:$count, words:CreatingEffect, recipe:Copy{object:@it, exceptions:$copy_plural_half_creature_stats}} */
token_copy_half_creature ::= count "tokens" "that" "are" "copies" "of" "that" "creature" "," "except" copy_plural_half_creature_stats

/* A copied token's quoted ability is scoped to its holder; the next sentence
   modifies the created token batch. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$token_copy_quoted_traits], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Created(@prior)), changes:$changes, duration:$duration, evaluation:Snapshot}}]} */
program_copy_quoted_then_change ::= "create" token_copy_quoted_traits "it" changes duration "."

/* @sem TokenSpec::TokenSpec{amount:$token_copy_quantity, words:CreatingEffect, recipe:Copy{object:$linked_exiled_card, exceptions:$copy_stats_types_quoted}} */
token_copy_quoted_traits ::= token_copy_quantity linked_exiled_card "," "except" copy_stats_types_quoted

/* The quoted intrinsic definition supplies both statistics of a statless token. */
/* @prefer always */
/* @sem TokenRecipe::@token_abilities($token_recipe_statless, $token_keyword_defining_abilities) */
token_recipe_statless_keyword_defining ::= token_recipe_statless "with" token_keyword_defining_abilities

/* @sem Ability::[$keyword_ability, @holder($token_defining_both)] */
token_keyword_defining_abilities ::= keyword_ability "and" '"' token_defining_both '"'

/* A quoted defining sentence contains the creation's final period. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:$token_recipe_statless_keyword_defining}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
program_statless_keyword_defining ::= "create" token_amount token_recipe_statless_keyword_defining

/* @prefer always */
/* @sem Ability::Spell{announcement:@announcement, body:$program_statless_keyword_defining} */
spell_statless_keyword_defining ::= program_statless_keyword_defining

/* Creation and the following departure trigger share the created result. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:@token_abilities($token_recipe_base, $token_keyword_upkeep_sentence)}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateTrigger{event:Object{event:LeavesBattlefield, objects:InSet(Created(@marked))}, duration:Indefinite, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:EventSubject, recipients:Union([Players(One(AbilityController)), Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_head, ControlledBy(One(AbilityController))])})]), amount:$number_digits, preventable:true}}]}, once:true, announcement:_{}}}] */
instructions_create_departure_damage ::= "create" "a" token_recipe_base token_keyword_upkeep_sentence "when" "it" "leaves" "the" "battlefield" "," "it" "deals" number_digits "damage" "to" "you" "and" "each" filter_head "you" "control"

/* The following sentence supplies the token's intrinsic abilities. */
/* @sem Ability::[Keyword($keyword_name), Mechanic{mechanic:CumulativeUpkeep, cost:Cost{parts:[Mana($mana_symbols)]}}] */
token_keyword_upkeep_sentence ::= "." "it" "has" keyword_name "and" '"' "cumulative" "upkeep" mana_symbols "." '"'

/* Keep the singular creation and its delayed sacrifice in one receipt scope. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$token_recipe_explicit_name_with}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(@marked)})}]}}}] */
clause_named_attacking_token_combat_sacrifice ::= "create" "a" token_recipe_explicit_name_with "that's" "tapped" "and" "attacking" "." "sacrifice" "that" "token" "at" "end" "of" "combat"

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:Program{instructions:[...$clause_named_attacking_token_combat_sacrifice]}} */
triggered_named_attacking_token_combat_sacrifice ::= event_clause "," clause_named_attacking_token_combat_sacrifice "."

/* A token name is independent of its variable characteristics. */
/* @sem String::'Koma''s Coil' */
created_name_koma_coil ::= "Koma's" "Coil"

/* A named statless land retains its subtype and intrinsic abilities independently. */
/* @sem TokenRecipe::Defined(_{name:Explicit($created_token_name), card_types:[Land], subtypes:$token_subtypes}) */
token_recipe_named_subtyped_land ::= token_subtypes "land" "token" "named" created_token_name

/* @sem String::'New Planet' */
created_name_new_planet ::= "New" "Planet"

/* The final quoted intrinsic ability closes the creation sentence. */
/* @sem TokenRecipe::@token_abilities($token_recipe_named_subtyped_land, $target_other_quote_list) */
token_named_land_final_quote ::= token_recipe_named_subtyped_land "with" target_other_quote_list

/* @sem Instruction::[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:$token_named_land_final_quote}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}})}] */
instructions_tapped_named_land_quoted ::= "create" token_amount "tapped" token_named_land_final_quote

/* The enclosing attack or damage event supplies the token quantity. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:EventAmount, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_named_event_quantity ::= "create" "that" "many" token_named_recipe "tokens"

/* The counted exile history and the token's intrinsic pump are independent operands. */
/* @sem TokenSpec::TokenSpec{amount:$opponents_exiled_history, words:CreatingEffect, recipe:$token_other_pump_recipe} */
token_history_quoted_other ::= "X" token_other_pump_recipe "where" "X" "is" opponents_exiled_history

/* @sem Expr::EventHistory{event:ZoneChange{objects:AllOf([$filter_plural, ControlledBy(OpponentsOf(AbilityController))]), from:Battlefield, to:Exile}, window:ThisTurn, measure:Occurrences} */
opponents_exiled_history ::= "the" "number" "of" filter_plural "that" "were" "exiled" "under" "your" "opponents'" "control" "this" "turn"

/* @sem TokenRecipe::@token_abilities($token_recipe_base, $token_other_pump_list) */
token_other_pump_recipe ::= token_recipe_base "with" token_other_pump_list

/* @sem Ability::[$token_other_pump] */
token_other_pump_list ::= token_other_pump

/* @sem Ability::Static{kind:Ordinary, affected:Objects(One(Source)), changes:[Pump{power:@times($signed, $token_other_controlled_count), toughness:@times($signed_2, $token_other_controlled_count)}]} */
token_other_pump ::= '"' "this" "token" "gets" signed "/" signed "for" "each" token_other_controlled_count "," '"'

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Affected)), $filter_phrase, ControlledBy(One(AbilityController))])}) */
token_other_controlled_count ::= "other" filter_phrase "you" "control"

/* The named arrival is the host of each copy; the delayed sacrifice refers to
   the copies created in that loop. Both written names must agree. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:$attacking_token_name, supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}, ForEachObject{objects:Created(0), binding:0, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$counter_amount_2, words:CreatingEffect, recipe:CopyEach{objects:$affected, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo(Bound(0))]}}}]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(1)})}]}}}]} */
named_attacking_token_attachment_copies ::= "create" attacking_token_name "," counter_amount "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token" "." "it" "enters" "tapped" "and" "attacking" "." "for" affected "," "create" counter_amount "token" "that's" "a" "copy" "of" "it" "attached" "to" "Stangg" "Twin" "." "sacrifice" "all" "tokens" "created" "this" "way" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* @sem Ability::Triggered{event:$event_attacks, limits:TriggerLimits{}, announcement:@announcement, body:$named_attacking_token_attachment_copies} */
triggered_named_attacking_attachment_copies ::= "whenever" event_attacks "," named_attacking_token_attachment_copies "."

/* @sem TokenName::Explicit('Stangg Twin') */
attacking_token_name ::= "Stangg" "Twin"

/* Create both token groups in one batch; the quoted ability belongs to the second. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$token_named, TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:@token_abilities($token_recipe_plain, $paired_token_quoted_cost)}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]} */
paired_quoted_tokens_program ::= "create" token_named "and" token_amount token_recipe_plain "with" paired_token_quoted_cost

/* @sem Ability::[@holder($static_spells_cost_less)] */
paired_token_quoted_cost ::= '"' static_spells_cost_less '"'

/* Independent expressions define the two token statistics. */
/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$value, $value_2]}) */
token_recipe_equal_stats ::= token_colors token_subtypes token_types "token" "with" "power" "equal" "to" value "and" "toughness" "equal" "to" value

/* The exile and its consumer are kept together so the receipt cannot name an
   unrelated previous operation. Token characteristics are independent operands. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@mark, operation:Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(Bound(0)))])}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:All, tokens:[TokenSpec{amount:CountObjects(Transition{result:@marked, phase:Before}), words:CreatingEffect, recipe:$token_recipe_plain}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
each_exile_creatures_receipt_tokens ::= "each" "player" "exiles" "all" "creatures" "they" "control" "and" "creates" "X" token_recipe_plain "," "where" "X" "is" "the" "total" "power" "of" "the" "creatures" "they" "exiled" "this" "way"

/* @sem Instruction::[...$each_exile_creatures_receipt_tokens, ...$instructions] */
each_exile_creatures_receipt_tokens_followup ::= each_exile_creatures_receipt_tokens "." "then" instructions

/* The named token refers to the creation in this payment branch. */
/* @sem Instruction::Effect{result:@next, operation:CreateDelayedTrigger{event:$token_cleanup_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:$created_named_reference, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}} */
conditional_token_exile_named ::= "exile" created_named_reference "at" token_cleanup_event

/* The captured amount supplies both statistics of the created token. */
/* @sem TokenRecipe::Defined{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[BoundValue(@marked), BoundValue(@marked)], abilities:$token_ability_description} */
captured_stat_token_recipe ::= "X" "/" "X" token_colors token_subtypes token_types "token" token_ability_description

/* A copied token's granted reduction belongs to the copy, not its creator. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(ActivationCost{abilities:AllOf([AbilityOf(SameObject(Source)), OnStack(Keyword(Equip))]), change:Reduce($generic_reduction_symbols)})]}) */
copied_equipment_equip_reduction ::= "this" "Equipment's" "equip" "abilities" "cost" generic_reduction_symbols "less" "to" "activate" "."

/* @sem CopyException::AddAbilities([@scope($copied_equipment_equip_reduction)]) */
copy_granted_equip_reduction ::= "it" "has" '"' copied_equipment_equip_reduction '"'

/* @sem TokenSpec::TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:[$copy_granted_equip_reduction]}} */
token_copy_granted_equip ::= token_copy_single object_ref "," "except" copy_granted_equip_reduction

/* The delayed instruction consumes the immediately preceding token creation. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[$token_copy_granted_equip], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:UpkeepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(@marked)})}]}}}]}} */
triggered_copied_token_upkeep_sacrifice ::= event_clause "," "create" token_copy_granted_equip "sacrifice" "that" "token" "at" "the" "beginning" "of" "the" "next" "upkeep" "."

/* A singular target payment supplies the copied card. Keep the payment,
   its copy and the token cleanup in one scope so both receipts are proved. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Move{selections:[_{objects:One($target_card_your_graveyard)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[$paid_card_copy_creation, $paid_copy_cleanup]}, otherwise:Program{}}] */
clause_exile_card_copy_cleanup ::= "you" "may" "exile" target_card_your_graveyard "." "if" "you" "do" "," paid_card_copy_creation "." paid_copy_cleanup

/* @sem Instruction::Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:Copy{object:Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0}, exceptions:$copy_exceptions_plain}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})} */
paid_card_copy_creation ::= "create" token_copy_single "that" "card" "," "except" copy_exceptions_plain

/* @sem Instruction::Effect{result:@next, operation:CreateDelayedTrigger{event:$token_cleanup_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:$created_ordinary_singular, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}} */
paid_copy_cleanup ::= "exile" created_ordinary_singular "at" token_cleanup_event

/* The plural token antecedent and both conditional branches share the same
   current token operands, while retaining separate effect results. */
/* @sem TokenSpec::TokenSpec{amount:$count, words:CreatingEffect, recipe:Defined{ name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2]}} */
sneak_plural_token ::= count token_stat "/" token_stat token_colors token_subtypes token_types "tokens"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[If{condition:ObjectMatches{object:Source, filter:State(CostPaid(Sneak))}, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$sneak_plural_token], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$sneak_plural_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}]}} */
spell_sneak_created_tokens ::= "create" sneak_plural_token "." "if" "this" "spell's" "sneak" "cost" "was" "paid" "," "they" "enter" "tapped" "and" "attacking" "."

/* Imperative token creation with a keyword scaled by counters your opponents have. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$shared_opponents_counter_count, words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2], abilities:[Keyword($keyword_value)]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
clause_create_for_opponents_counters ::= "create" ("a" | "an") token_stat "/" token_stat token_colors token_subtypes token_types "token" "with" keyword_value "for" "each" shared_opponents_counter_count

/* A final quoted ability carries the sentence punctuation. */
/* @sem Ability::[$token_ability, ...$chapter_token_abilities_tail] */
chapter_token_abilities_list ::= token_ability "," chapter_token_abilities_tail

chapter_token_abilities_tail ::= token_final_quoted_last | chapter_token_abilities_list

/* @prefer always */
/* @sem @times(Expr::Constant(2), $number) */
token_amount_twice ::= "twice" number

/* The preceding token creation supplies the affected batch. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($created_tokens_goaded_subject), changes:[Rule(GoadedBy(AbilityController))], duration:Indefinite, evaluation:LiveObjects}}] */
clause_created_tokens_goaded_indefinite ::= created_tokens_goaded_subject "are" "goaded" "for" "the" "rest" "of" "the" "game"

/* A Land Mine token with its sacrifice-damage activation, paired with the following
   coin flip so damage_source_ref does not add a CostObjects duplicate and 'Then' prints by default. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[Mana($mana_symbols), Sacrifice{objects:One(Source)}]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Attacking, $noun, Not(HasKeyword($keyword_name))])}), index:0})), amount:$number, preventable:true}}]}} */
token_sacrifice_damage_attacking_without ::= mana_symbols "," "↑" "sacrifice" "this" "token" ":" "this" "token" "deals" number "damage" "to" "target" "attacking" noun "without" keyword_name "."

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:Explicit('Land Mine'), card_types:[Artifact], abilities:[@scope($token_sacrifice_damage_attacking_without)]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, ...$clause_flip_coin_if] */
instructions_create_land_mine_then_flip ::= "create" "a" "colorless" "artifact" "token" "named" "Land" "Mine" "with" '"' token_sacrifice_damage_attacking_without '"' "then" clause_flip_coin_if

/* Scoped Tombspawn token recipe for per-player graveyard creation (prevents create_third EventSubject leak). */
/* @sem TokenRecipe::Defined(_{name:Explicit('Tombspawn'), colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2], abilities:[Keyword($keyword_value)]}) */
token_recipe_named_tombspawn ::= token_stat "/" token_stat token_colors token_subtypes token_types "token" "with" keyword_value "named" "Tombspawn"

/* Each creator counts cards in that player's graveyard. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(Bound(0)), tokens:[TokenSpec{amount:$bound_graveyard_card_count, words:CreatingEffect, recipe:$token_recipe_named_tombspawn}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}] */
clause_players_create_per_graveyard_card ::= players_singular "creates" "a" token_recipe_named_tombspawn bound_graveyard_card_count

/* A copy token referencing the prior target card with fixed stats, an added subtype, and a keyword. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Target{slot:@last_slot, index:0}, exceptions:[CopyException::SetPowerToughness{power:$value, toughness:$value_2}, CopyException::AddCreatureTypes($becomes_types), CopyException::AddAbilities([Keyword($keyword_value)])]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_copy_target_stats_subtype_keyword ::= "create" "a" "token" "that's" "a" "copy" "of" "that" "card" "," "except" "it's" value "/" value "," "it's" "a" becomes_types "in" "addition" "to" "its" "other" "types" "," "and" "it" "has" keyword_value

/* Named Equipment abilities retain the created token as their holder. */
/* @sem TokenName::Explicit('Icingdeath, Frost Tongue') */
explicit_token_frost_tongue ::= SELF_NAME "," "Frost" "Tongue"

equipment_quoted_abilities ::= equipment_quoted_pump_and_equip | equipment_quoted_pump_attack_equip

/* @sem Ability::Triggered{event:Object{event:Attacks, objects:SameObject(AttachedTo(Source))}, limits:TriggerLimits{}, body:Program{instructions:[Effect{result:@next, operation:SetTapped{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ControlledBy(One(DefendingPlayerOf(EventSubject)))])}), index:0}), tapped:true}}]}, announcement:@announcement} */
equipment_attack_tap_defender ::= "whenever" "equipped" "creature" "attacks" "," "tap" "target" noun "defending" "player" "controls"

/* @sem Ability::[@holder($token_equipped_pump), @holder($equipment_attack_tap_defender), @holder($keyword_equip)] */
equipment_quoted_pump_attack_equip ::= '"' token_equipped_pump "," '"' '"' equipment_attack_tap_defender "," '"' "and" keyword_equip

/* Copy tokens created by each opponent/player are goaded for the rest of the game. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:CreateTokens{players:$players_singular, tokens:[TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Created(@marked)), changes:[Rule(GoadedBy(AbilityController))], duration:Indefinite, evaluation:LiveObjects}}]} */
program_each_copy_tokens_goaded_indefinite ::= players_singular "creates" "a" "token" "that's" "a" "copy" "of" object_ref "." "the" "tokens" "are" "goaded" "for" "the" "rest" "of" "the" "game"

/* @sem Ability::@holder($token_ability_body) */
token_single_quoted ::= "'" token_ability_body "'"

/* The defined copy count and both followups share the token creation receipt. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$copy_cast_count, words:CreatingEffect, recipe:Copy{object:$target_another, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Created(@marked)), changes:[GrantKeyword($keyword_name)], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$token_cleanup_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Created(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]}}}]} */
copy_cast_history_grant_cleanup ::= "create" "X" "tokens" "that" "are" "copies" "of" target_another "," "where" "X" "is" copy_cast_count "." "they" "gain" keyword_name "." "exile" "them" "at" token_cleanup_event "."

/* @sem Expr::Add($number_words, EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:AnyOf([$spell_adjective, $spell_adjective_2])}, window:ThisTurn, measure:Occurrences}) */
copy_cast_count ::= number_words "plus" "the" "number" "of" spell_adjective "and" spell_adjective "spells" "you've" "cast" "this" "turn"

/* @sem Ability::[$token_quoted] */
token_abilities_after_batch ::= "." "the" "tokens" "have" token_quoted

/* The count and following intrinsic ability both describe the created batch. */
/* @sem TokenSpec::TokenSpec{amount:$value, words:CreatingEffect, recipe:@token_abilities($token_recipe_base, $token_abilities_after_batch)} */
token_defined_x_after ::= "X" token_recipe_base "," "where" "X" "is" value token_abilities_after_batch

/* @sem Instruction::[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$token_defined_x_after], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
instructions_create_x_quoted ::= "create" token_defined_x_after

/* Keep the moved card and the token characteristics in one producer-consumer scope. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One($target_card_your_graveyard), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:Power, information:CurrentOrLastKnown}, ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:Toughness, information:CurrentOrLastKnown}]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
instructions_exile_card_stat_token ::= "exile" target_card_your_graveyard "." "create" "a" token_colors token_subtypes token_types "token" "." "its" "power" "is" "equal" "to" "that" "card's" "power" "and" "its" "toughness" "is" "equal" "to" "that" "card's" "toughness"

/* The two following characteristic expressions belong to the token recipe. */
/* @sem TokenRecipe::Defined{name:Explicit($created_token_name), colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$value, $value_2]} */
token_named_separate_stats ::= token_colors token_subtypes token_types "token" "named" created_token_name "that's" "attacking" "." "its" "power" "is" "equal" "to" value "and" "its" "toughness" "is" "equal" "to" value

/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$token_named_separate_stats}], entry:BattlefieldArrival{tapped:false, counters:[], states:[Attacking{}]}} */
create_named_separate_stats ::= "create" "a" token_named_separate_stats

/* @sem Instruction::Effect{result:@next, operation:CreateDelayedTrigger{event:$token_cleanup_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(0)})}]}}} */
token_sacrifice_cleanup ::= "sacrifice" "the" "token" "at" token_cleanup_event

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$create_named_separate_stats}, $token_sacrifice_cleanup]}} */
triggered_named_stats_cleanup ::= event_clause "," create_named_separate_stats "." token_sacrifice_cleanup "."

/* @sem String::'Twin' */
created_name_twin ::= "Twin"

/* The target and created token are linked within this complete program: the
   delayed sacrifice consumes precisely the token creation receipt. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(Token), CardType(Creature), AttackingDefender(Players(One(EventOtherPlayer)))])}), index:0}, exceptions:$entry_copy_stats_tail}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{player:EventOtherPlayer}]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$token_cleanup_event, start:Immediately, body:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(@marked)})}]}}}]} */
attacked_player_copy_cleanup_program ::= "choose" "target" "nontoken" "creature" "that's" "attacking" "that" "player" "." "create" "a" "token" "that's" "a" "copy" "of" "that" "creature" entry_copy_stats_tail "the" "token" "enters" "tapped" "and" "attacking" "that" "player" "." "sacrifice" "it" "at" token_cleanup_event

/* This event binds the defender used by the linked program. */
/* @sem Ability::Triggered{event:$attacked_player_copy_event, limits:TriggerLimits{}, announcement:@announcement, body:$attacked_player_copy_cleanup_program} */
attacked_player_copy_trigger ::= "whenever" attacked_player_copy_event "," attacked_player_copy_cleanup_program "."

attacked_player_copy_event ::= event_you_attack_player | event_you_attack_player_with

/* Three token options inherit the color and card types in the heading. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2], abilities:$token_abilities}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes_2, power_toughness:[$token_stat_3, $token_stat_4], abilities:$token_abilities_2}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes_3, power_toughness:[$token_stat_5, $token_stat_6], abilities:$token_abilities_quoted}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:Random}} */
random_shared_token_characteristics ::= "choose" "one" "at" "random" "." "create" "a" token_colors token_types "token" "with" "those" "characteristics" "." NEWLINE "•" token_stat "/" token_stat token_subtypes "with" token_abilities "." NEWLINE "•" token_stat "/" token_stat token_subtypes "with" token_abilities "." NEWLINE "•" token_stat "/" token_stat token_subtypes "with" token_abilities_quoted

/* The plural pronoun names precisely the tokens produced by this creation. */
/* @sem Instruction::[Effect{result:@next, operation:@apply(PlayerSet::One(AbilityController), $created_damage_producer)}, Effect{result:@next, operation:DealDamageFromEach{sources:Created(@prior), recipients:$recipients, amount:$value}}] */
instructions_created_each_damage ::= created_damage_producer "." "they" "each" "deal" value "damage" "to" recipients

created_damage_producer ::= create_tapped_base | create_base

/* Both characteristics share a live graveyard population, independent of any action receipt. */
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_live_graveyard_count, $token_live_graveyard_count]}} */
token_defined_live_graveyard_single ::= counter_a "X" "/" "X" token_colors token_subtypes token_types "token" "," "where" "X" "is" token_live_graveyard_count

/* @sem TokenSpec::TokenSpec{amount:$count_plural, words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_live_graveyard_count, $token_live_graveyard_count]}} */
token_defined_live_graveyard_plural ::= count_plural "X" "/" "X" token_colors token_subtypes token_types "tokens" "," "where" "X" "is" token_live_graveyard_count

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One($zone_owner)}, kind:Card, filter:$card_filter}) */
token_live_graveyard_count ::= "the" "number" "of" card_filter "cards" "in" zone_owner "graveyard"

/* A copy for each card in the controller's graveyard, with independently
   specified replacement characteristics for each token. */
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase} */
copy_each_your_graveyard_card ::= filter_phrase "card" "in" "your" "graveyard"

/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyEach{objects:$copy_each_your_graveyard_card, exceptions:$copy_token_characteristics}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_copy_each_graveyard_modified ::= "for" "each" copy_each_your_graveyard_card "," "create" "a" "token" "that's" "a" "copy" "of" "it" "," "except" copy_token_characteristics

/* The batch damage event supplies the number of opponents dealt damage. */
/* @sem Ability::Triggered{event:$event_group_damage_opponents, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:EventAmount, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}} */
triggered_damage_opponents_named_tokens ::= "whenever" event_group_damage_opponents "," "you" "create" "a" token_named_recipe "token" "for" "each" "opponent" "dealt" "damage" "."

/* The copy's independent name and added characteristics are copiable values. */
/* @sem String::'Mishra''s Warform' */
copy_warform_literal_name ::= "Mishra's" "Warform"

copy_created_literal_name ::= copy_warform_literal_name | referenced_card_name

/* @sem Vec<CopyException>::[CopyException::SetName($copy_created_literal_name), ...$copy_artifact_creature_exceptions] */
copy_named_characteristics ::= "its" "name" "is" copy_created_literal_name "and" copy_artifact_creature_exceptions

/* The creation, temporary grant, and delayed sacrifice share one token receipt. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$copy_controlled_noncreature_target, exceptions:$copy_named_characteristics}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Created(@marked)), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(@marked)})}]}}}]} */
program_copy_named_temporary_sacrifice ::= "create" "a" "token" "that's" "a" "copy" "of" copy_controlled_noncreature_target "," "except" copy_named_characteristics "." "it" "gains" keyword_name duration "." "sacrifice" "it" "at" "the" "beginning" "of" "the" "next" "end" "step" "."

/* The first quote in a pair may omit its final period; each ability has the token as holder. */
/* @sem Ability::[@holder(Ability::Static{kind:Ordinary, affected:Objects($static_affected), changes:$static_changes}), $token_quoted] */
token_quoted_static_pair ::= '"' static_affected static_changes '"' "and" token_quoted

/* A final quoted ability carries the sentence's final period. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:$players_singular, tokens:[TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:@token_abilities($token_recipe_base, $token_quoted_static_pair)}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
program_sentence_player_quoted_token_pair ::= players_singular "creates" token_amount token_recipe_base "with" token_quoted_static_pair

/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$singular_cleanup_stated_stats_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
clause_create_death_stated_stats_token ::= "create" singular_cleanup_stated_stats_token

/* @sem TokenName::Explicit(Phobos) */
explicit_token_phobos ::= "Phobos"

/* A quoted static rule belongs to the newly created token's holder. */
/* @sem Ability::@holder(Ability::Static{kind:Ordinary, affected:Objects(One(Source)), changes:$rule_cant_block}) */
quoted_token_cannot_block_sentence ::= '"' "this" "token" rule_cant_block "." '"'

/* @sem Ability::[$quoted_token_cannot_block_sentence] */
quoted_token_block_abilities ::= quoted_token_cannot_block_sentence

/* @sem TokenRecipe::@token_abilities($token_recipe_base, $quoted_token_block_abilities) */
token_recipe_quoted_block ::= token_recipe_base "with" quoted_token_block_abilities

/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:$token_recipe_quoted_block}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
create_quoted_block_token ::= "create" token_amount token_recipe_quoted_block

/* Choice operands retain the intrinsic abilities on each independently described token. */
/* @sem Operand::Term{family:CreatableToken, form:TokenWithPT, operands:[$entry_face_pt, Term{family:TokenColorList, form:Colors, operands:[$perpetual_simple_color]}, List([]), List([Vocabulary{family:CardType, form:Creature}]), Term{family:TokenSubtypes, form:SubtypesList, operands:[$choice_token_subtype]}, List($choice_token_abilities)]} */
choice_token_operand ::= "a" entry_face_pt perpetual_simple_color choice_token_subtype "creature" "token" "with" choice_token_abilities

choice_token_subtype ::= choice_token_angel | choice_token_demon | choice_token_elemental | choice_token_pirate

/* @sem Operand::Vocabulary{family:SubType, form:Angel} */
choice_token_angel ::= "Angel"

/* @sem Operand::Vocabulary{family:SubType, form:Demon} */
choice_token_demon ::= "Demon"

/* @sem Operand::Vocabulary{family:SubType, form:Elemental} */
choice_token_elemental ::= "Elemental"

/* @sem Operand::Vocabulary{family:SubType, form:Pirate} */
choice_token_pirate ::= "Pirate"

choice_token_abilities ::= choice_token_one_keyword | choice_token_two_keywords_trigger

/* @sem Operand::[Ability(Keyword($keyword_value))] */
choice_token_one_keyword ::= keyword_value

/* @sem Operand::[Ability(Keyword($keyword_value)), Ability(Keyword($keyword_value_2)), Ability(@scope(Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$cost}}, If{condition:Not(PaymentChosen(@prior)), then:$program, otherwise:_{}}]}}))] */
choice_token_two_keywords_trigger ::= keyword_value "," keyword_value "," "and" '"' "at" turn_event "," cost "." "if" "you" "can't" "," program "." '"'

/* The choice actor and each of the two token descriptions are independent. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseAction{actor:$players_singular, options:[List([$choice_token_operand]), List([]), List([$choice_token_operand_2]), List([])]}}]} */
players_choose_token_program ::= players_singular "creates" "their" "choice" "of" choice_token_operand "or" choice_token_operand

/* The explicit name is independent of the token recipe. */
/* @sem String::'Cordyceps Infected' */
created_name_cordyceps_infected ::= "Cordyceps" "Infected"

/* A named plural recipe and the amount of mana are independently printable operands. */
/* @prefer always */
/* @sem TokenSpec::TokenSpec{amount:$exile_mana_spent, words:CreatingEffect, recipe:$token_recipe_explicit_plural} */
token_named_mana_spent_equal ::= "a" "number" "of" token_recipe_explicit_plural "equal" "to" exile_mana_spent

/* The referenced spell is the operand whose paid mana is counted. */
/* token_mana_spent is shared as exile_mana_spent. */

/* Keep the casting payment and the measured population in one scope. The two
   population phrases must describe the same sacrificed objects. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($filter_plural, $filter_plural_2)}, choose:AnyNumber}]}, repetition:Once}), Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[Aggregate{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Performed, phase:Before}, property:$casting_sacrifice_stat, aggregation:Sum}, Aggregate{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Performed, phase:Before}, property:$casting_sacrifice_stat, aggregation:Sum}], abilities:$token_abilities}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]}}] */
line_casting_sacrifice_total_token ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "sacrifice" "any" "number" "of" filter_plural "." NEWLINE "create" token_amount "X" "/" "X" token_colors token_subtypes token_types "token" "with" token_abilities "," "where" "X" "is" "the" "total" casting_sacrifice_stat "of" "the" "sacrificed" filter_plural "."

/* The count uses the named player's present graveyard, filtered by arrival this turn. */
/* @sem Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One(@that_player)}, kind:Card, filter:AllOf([$adjective_nontype, ArrivedThisTurn{from:Battlefield}])}) */
count_that_player_battlefield_arrivals ::= adjective_nontype "card" "in" "that" "player's" "graveyard" "that" "was" "put" "there" "from" "the" "battlefield" "this" "turn"

/* @sem TokenSpec::TokenSpec{amount:$count_that_player_battlefield_arrivals, words:Rules, recipe:$token_named_recipe} */
token_named_each_tapped_arrival ::= "a" "tapped" token_named_recipe "token" "for" "each" count_that_player_battlefield_arrivals

/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$token_named_each_tapped_arrival], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}}] */
clause_you_named_tapped_arrivals ::= "you" "create" token_named_each_tapped_arrival

/* Explicit names remain independent of token characteristics. */
/* created_name_lightning_rager is shared as card_name_lightning_rager. */

/* @sem TokenName::Explicit(Keimi) */
explicit_token_keimi ::= "Keimi"

/* A quoted intrinsic ability closes the creation sentence with its own period. */
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:$explicit_legendary_name, supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2], abilities:[$token_quoted]}} */
token_explicit_legendary_quoted ::= explicit_legendary_name "," counter_amount "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token" "with" token_quoted

/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$token_explicit_legendary_quoted], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
instructions_explicit_legendary_quoted ::= "create" token_explicit_legendary_quoted

/* A named Aura carries an intrinsic quoted ability in its own holder scope. */
/* @sem Instruction::Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$counter_a, words:CreatingEffect, recipe:Defined{name:Explicit(Contract), colors:$token_colors, card_types:[Enchantment], subtypes:[Aura], abilities:[$enchant_permanents, @scope($attached_aura_conditional_trigger)]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo($object_ref)]}}} */
create_attached_aura_quoted ::= "create" counter_a token_colors "Aura" "enchantment" "token" "named" "Contract" "attached" "to" object_ref "." "the" "token" "has" enchant_permanents "and" '"' attached_aura_conditional_trigger '"'

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[If{condition:ObjectMatches{object:EventSubject, filter:AttackingDefender(Players(OpponentsOf(AbilityController)))}, then:$program, otherwise:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(ControllerOf(EventSubject)), amount:$value}}]}}]}} */
attached_aura_conditional_trigger ::= event_clause "," program "if" "it's" "attacking" "one" "of" "your" "opponents" "." "otherwise" "," "its" "controller" "loses" value "life" "."

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[$create_attached_aura_quoted]}} */
triggered_attached_aura_quoted ::= event_clause "," create_attached_aura_quoted

/* The named token is the copy, and its two characteristics are independent. */
/* @sem CopyException::SetPowerToughness{power:$value, toughness:$value_2} */
copy_enchanted_token_stats ::= "the" "token" "is" value "/" value

/* @sem TokenSpec::TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:Copy{object:$enchanted_creature_ref, exceptions:[$copy_enchanted_token_stats]}} */
token_copy_enchanted_stats ::= token_copy_single enchanted_creature_ref "," "except" copy_enchanted_token_stats

/* The same population is compared for each opponent and the ability controller. */
/* opponents_controlling_more_than_you is shared as opponents_control_more_count_h3. */

/* @sem TokenSpec::TokenSpec{amount:$opponents_control_more_count_h3, words:CreatingEffect, recipe:$token_recipe} */
token_defined_equal_opponent_comparison ::= "a" "number" "of" token_recipe "equal" "to" opponents_control_more_count_h3

/* The unpunctuated artifact exception applies to a copy token, and its
   quantity and copied object remain independently composable. */
/* @sem TokenSpec::TokenSpec{amount:$token_copy_quantity, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:[$token_copy_added_card_type]}} */
token_copy_artifact_unpunctuated ::= token_copy_quantity object_ref "except" token_copy_added_card_type

token_copy_added_card_type ::= token_copy_add_artifact | copy_add_enchantment_type

/* The count reads the before receipt of the immediately preceding destroy. */
/* @sem Instruction::[Effect{result:@mark, operation:$destroy}, ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(Bound(0)), tokens:[TokenSpec{amount:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))])}), words:CreatingEffect, recipe:$token_recipe_with}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}] */
instructions_destroy_controller_receipt_tokens ::= destroy "." "for" "each" filter_phrase "destroyed" "this" "way" "," "its" "controller" "creates" "a" token_recipe_with

/* A named token recipe and an independently filtered entry-history count. */
/* @sem TokenSpec::TokenSpec{amount:$nontoken_entries_yours, words:Rules, recipe:$token_named_recipe} */
token_named_equal_nontoken_entries ::= "a" "number" "of" token_named_recipe "tokens" "equal" "to" nontoken_entries_yours

/* A singular copy can describe the exception by naming the created token. */
/* @sem TokenSpec::TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:$copy_explicit_token_exceptions}} */
token_copy_explicit_token_exception ::= token_copy_single object_ref "," "except" copy_explicit_token_exceptions

/* @sem Vec<CopyException>::[$copy_explicit_token_nonlegendary] */
copy_explicit_token_exceptions ::= copy_explicit_token_nonlegendary

/* @sem CopyException::RemoveSupertypes([Legendary]) */
copy_explicit_token_nonlegendary ::= "the" "token" "isn't" "legendary"

/* The created artifact owns its departure trigger and its damage target. */
/* @sem TokenRecipe::Defined{name:Explicit($departure_token_name), card_types:[Artifact], abilities:[@scope(Ability::Triggered{event:Object{event:LeavesBattlefield, objects:SameObject(Source)}, limits:_{}, body:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any})), amount:$number, preventable:true}}]}, announcement:@announcement})]} */
named_artifact_departure_recipe ::= "colorless" "artifact" "token" "named" departure_token_name "with" '"' "when" "this" "token" "leaves" "the" "battlefield" "," "it" "deals" number "damage" "to" "any" "target" "." '"'

/* @sem String::'Munitions' */
departure_token_name ::= "Munitions"

/* The replacement quantity applies to the same current recipe in both branches.
   The condition names the creature whose death triggered this ability. */
/* @sem Program::Program{instructions:[If{condition:ObjectMatches{object:EventSubject, filter:Property{property:Power, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}}, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:$death_override_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$death_override_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}]} */
death_token_quantity_override ::= "create" "a" death_override_token_recipe "if" "the" "creature" "had" "power" number "or" "greater" "," "create" counter_amount "of" "those" "tokens" "instead" "."

death_override_token_recipe ::= token_recipe_quoted_block

/* @sem Ability::Triggered{event:$event_self_or_dies, limits:TriggerLimits{}, announcement:@announcement, body:$death_token_quantity_override} */
death_shared_token_quantity_trigger ::= "whenever" event_self_or_dies "," death_token_quantity_override

/* The payment and its failure branch share the token holder and payment receipt. */
/* @prefer always */
/* @sem Ability::Triggered{event:$turn_upkeep, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[$cost_sacrifice_another]}, optional:false}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(One(AbilityController)), amount:$number_digits, preventable:true}}]}, otherwise:Program{}}]}} */
token_upkeep_sacrifice_failure ::= "at" turn_upkeep "," cost_sacrifice_another "." "if" "you" "can't" "," "this" "token" "deals" number_digits "damage" "to" "you" "."

/* The quoted replacement belongs to the newly created token. */
/* @prefer always */
/* @sem $token_prevent_self_damage_sentence */
token_prevent_self_damage ::= token_prevent_self_damage_sentence

/* @prefer always */
/* @sem Ability::Replacement{active:Battlefield, event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject(Source)), kind:Any, grouping:SourceRecipient, subject:Recipient}), body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
token_prevent_self_damage_sentence ::= "prevent" "all" "damage" "that" "would" "be" "dealt" "to" "this" "token" "."

/* A token's static grant applies to a controlled subtype population. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$subtype_plural, ControlledBy(One(AbilityController))])}), changes:[GrantKeyword($keyword_name)]}) */
token_controlled_subtype_keyword ::= subtype_plural "you" "control" "have" keyword_name "."

/* Vanishing can precede another quoted intrinsic ability. */
/* @sem Ability::[Ability::Mechanic{mechanic:VanishingEnters, amount:$number}, $token_quoted] */
chapter_vanishing_quoted_abilities ::= "vanishing" number "and" token_quoted

/* A statless named token keeps its explicit name and subtype independently. */
/* @sem TokenRecipe::Defined(_{name:Explicit($created_token_name), colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes}) */
token_recipe_named_subtyped_statless ::= token_colors token_subtypes token_types "token" "named" created_token_name

/* @sem String::'Stoneforged Blade' */
created_name_stoneforged_blade ::= "Stoneforged" "Blade"

/* Intrinsic abilities belong to the created Equipment, including its equip frame. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Pump{power:$signed, toughness:$signed_2}, GrantKeyword($keyword_name)]} */
token_equipped_pump_keyword ::= "equipped" "creature" "gets" signed "/" signed "and" "has" keyword_name

/* @sem Ability::[Keyword($keyword_name), @holder($token_equipped_pump_keyword), @holder($keyword_equip)] */
token_intrinsic_keyword_equipment ::= keyword_name "," '"' token_equipped_pump_keyword "," '"' "and" keyword_equip

/* @sem String::'Goldmeadow Harrier' */
created_name_goldmeadow_harrier ::= "Goldmeadow" "Harrier"

/* The copy exceptions describe each member of the created attacking batch. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:@subject, tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:$copy_exceptions_plain}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_modified_copy_tapped_attacking ::= "create" "a" "tapped" "and" "attacking" "token" "that's" "a" "copy" "of" object_ref "," "except" copy_exceptions_plain

/* X tokens with abilities where X counts opponents controlling more of a population than you. */
/* @prefer always */
/* @sem TokenSpec::TokenSpec{amount:$opponents_control_more_count_h3, words:CreatingEffect, recipe:$token_recipe_with} */
token_defined_with_opponent_control_count_h3 ::= "X" token_recipe_with "," "where" "X" "is" opponents_control_more_count_h3

/* @sem Expr::CountPlayers(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}), test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])})}}}])) */
opponents_control_more_count_h3 ::= "the" "number" "of" "opponents" "who" "control" "more" filter_plural "than" "you"

/* Each player except a referenced player creates tokens. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:OthersThan($player_ref), tokens:$token_groups, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
each_player_other_than_creates_h3 ::= "each" "player" "other" "than" player_ref "creates" token_groups

/* @sem Operation::@created_result(Operation::CreateTokens{players:OthersThan($player_ref), tokens:$token_groups, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
each_player_except_creates_h3 ::= "each" "player" "except" player_ref "creates" token_groups


/* Each repetition of the protected creature name must agree with the granted ability. */
/* @sem Ability::[Mechanic{mechanic:BandsWithOthers, filter:AllOf([CardType(Creature), @agree(ObjectFilter::Name($created_token_name), @agree(ObjectFilter::Name($created_token_name_2), @agree(ObjectFilter::Name($created_token_name_3), @agree(ObjectFilter::Name($created_token_name_4), ObjectFilter::Name($created_token_name_5)))))])}] */
token_named_bands_reminded ::= '"' "↓" "bands" "with" "other" "creatures" "named" created_token_name "." '"' "(" "any" "creatures" "named" created_token_name "can" "attack" "in" "a" "band" "as" "long" "as" "at" "least" "one" "has" '"' "↓" "bands" "with" "other" "creatures" "named" created_token_name "." '"' "bands" "are" "blocked" "as" "a" "group" "." "if" "at" "least" "two" "creatures" "named" created_token_name "you" "control" "," "one" "of" "which" "has" '"' "↓" "bands" "with" "other" "creatures" "named" created_token_name "," '"' "are" "blocking" "or" "being" "blocked" "by" "the" "same" "creature" "," "you" "divide" "that" "creature's" "combat" "damage" "," "not" "its" "controller" "," "among" "any" "of" "the" "creatures" "it's" "being" "blocked" "by" "or" "is" "blocking" "." ")"

/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:Explicit($titled_token_name), supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2], abilities:$token_ability_description}} */
token_legendary_titled ::= titled_token_name "," "a" "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token" token_ability_description

titled_token_name ::= titled_token_porthos | titled_token_murf
/* @sem String::'Porthos' */
titled_token_porthos ::= "Porthos"
/* @sem String::'Murf' */
titled_token_murf ::= "Murf"

/* Read only the pre-destruction characteristics of the successfully destroyed batch. */
/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$destroy}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Matching{objects:Transition{result:@prior, phase:Before}, filter:$filter_plural}), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{}}}]}} */
spell_destroy_counted_token_receipt ::= destroy "." "create" "X" token_recipe "," "where" "X" "is" "the" "number" "of" filter_plural "destroyed" "this" "way" "."

/* The value is read from the source, including last-known battlefield stats. */
/* @sem TokenSpec::TokenSpec{amount:$value_self_stat, words:CreatingEffect, recipe:$token_recipe_quoted_comma} */
token_defined_source_stat_quoted ::= "X" token_recipe_quoted_comma "where" "X" "is" value_self_stat

/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:Explicit($titled_token_name), supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2]}} */
token_legendary_titled_no_ability ::= titled_token_name "," "a" "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token"

/* Choose the color after creating the batch. The affected artifact creatures
   are those controlled at the point the protection is granted. */
/* @sem Ability::WithPresentation{reminder:true,ability:Spell{announcement:@announcement,body:_{instructions:[Effect{result:@next,operation:@apply(PlayerSet::One(AbilityController),$create_base)},Effect{result:@next,operation:$protection_grant_choice},Effect{result:@next,operation:CreateContinuousEffect{source:Source,affected:Objects($affected),changes:[GrantKeyword(Protection(Objects(_{kind:Any,filter:Chosen(Color)})))],duration:$duration,evaluation:Snapshot}}]}}} */
spell_create_then_protect_color_choice ::= create_base "," "then" affected "gain" "protection" "from" protection_grant_choice duration "." "(" "they" "can't" "be" "blocked" "," "targeted" "," "dealt" "damage" "," "enchanted" "," "or" "equipped" "by" "anything" "of" "that" "color" "." ")"

/* Count each still-controlled recipient once, regardless of how many
   counters this player put on it or whether the counters remain there. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield),kind:Permanent,filter:AllOf([$filter_phrase,ControlledBy(One(AbilityController)),Condition(Compare{left:EventHistory{event:Counters{change:Put,objects:SameObject(Candidate),by:One(AbilityController)},window:ThisTurn,measure:Occurrences},test:NumberTest::Compare{comparison:GreaterOrEqual,value:Constant(1)}})])}) */
count_each_you_put_counter_on_this_turn ::= filter_phrase "you" "control" "that" "you've" "put" "a" "counter" "on" "this" "turn"

/* Evaluate the alternative amount before token creation and after the
   counter placement. This is one creation batch whichever amount is used. */
/* @sem Instruction::[Effect{result:@next,operation:$put_counters_direct},Effect{result:@next,operation:CreateTokens{players:One(AbilityController),tokens:[TokenSpec{amount:Conditional{condition:$condition,then:$number,otherwise:Constant(1)},words:CreatingEffect,recipe:$token_recipe}],entry:BattlefieldArrival{}}}] */
instructions_put_counter_create_variable_batch ::= put_counters_direct "." "create" "a" token_recipe "." "if" condition "," "create" number "of" "those" "tokens" "instead"

/* Determine target slots independently for the two announced casting branches. */
/* @sem Ability::@optional_cost_reminder(Ability::CostBranch{keyword:Kicker,cost:$kicker_branch_header,unpaid:@scope(Ability::Spell{announcement:@announcement,body:_{instructions:[Effect{result:@next,operation:@apply(PlayerSet::One(AbilityController),$create_base)}]}}),paid:@scope(Ability::Spell{announcement:@announcement,body:_{instructions:[Effect{result:@next,operation:$copy_each_target_player_creature}]}})},$kicker_branch_note) */
spell_kicker_copy_opponent_population ::= kicker_branch_header kicker_branch_note? NEWLINE create_base "." "if" "this" "spell" "was" "kicked" "," "instead" copy_each_target_player_creature "."

/* @sem Operation::CreateTokens{players:One(AbilityController),tokens:[TokenSpec{amount:Constant(1),words:CreatingEffect,recipe:CopyEach{objects:Zone{scope:Shared(Battlefield),kind:Permanent,filter:AllOf([$filter_phrase,ControlledBy(One($target_opponent))])},exceptions:$copy_exceptions_plain}}],entry:BattlefieldArrival{}} */
copy_each_target_player_creature ::= "for" "each" filter_phrase target_opponent "controls" "," "create" "a" "token" "that's" "a" "copy" "of" "that" "creature" "," "except" copy_exceptions_plain

/* Copies are created from the legal announced targets in one batch. The
   subsequent grant and delayed exile both refer to the actual tokens made. */
/* @sem Ability::WithPresentation{reminder:true,ability:Spell{announcement:@announcement,body:_{instructions:[Effect{result:@mark,operation:CreateTokens{players:One(AbilityController),tokens:[TokenSpec{amount:Constant(1),words:CreatingEffect,recipe:CopyEach{objects:$chosen_x_copy_targets,exceptions:[AddAbilities([Keyword(Changeling)])]}}],entry:BattlefieldArrival{}}},Effect{result:@next,operation:CreateContinuousEffect{source:Source,affected:Objects(Created(@marked)),changes:$grants,duration:Indefinite,evaluation:Snapshot}},Effect{result:@next,operation:CreateDelayedTrigger{event:$delayed_move_any_end,start:Immediately,body:_{instructions:[Effect{result:@next,operation:Move{objects:Created(@marked),destination:Exile{visibility:FaceUp,arrival:ExileArrival{}},qualifiers:[]}}]}}}]}}} */
spell_chosen_targets_create_copy_cleanup ::= "choose" chosen_x_copy_targets "." "for" "each" "of" "them" "," "create" "a" "token" "that's" "a" "copy" "of" "that" "creature" "," "except" "it" "has" "changeling" "." "those" "tokens" "gain" grants "." "exile" "those" "tokens" "at" delayed_move_any_end "." "(" "they're" "every" "creature" "type" "." ")"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot,kind:Object(_{kind:Permanent,zones:[Battlefield]}),count:Exactly(AnnouncedX),filter:AllOf([CardType(Creature),ControlledBy(OpponentsOf(AbilityController))])})) */
chosen_x_copy_targets ::= "X" "target" "creatures" "your" "opponents" "control"

/* The named Equipment has two separate abilities and attaches only from this
   creation receipt. Its pump follows the host currently equipped by it. */
/* @sem Instruction::[Effect{result:@mark,operation:CreateTokens{players:One(AbilityController),tokens:[TokenSpec{amount:Constant(1),words:CreatingEffect,recipe:$named_equipment_token_pump}],entry:BattlefieldArrival{}}},Effect{result:@next,operation:Attach{attachments:Created(@marked),host:$self_explicit_ref}}] */
instructions_create_named_equipment_attach ::= "create" "a" named_equipment_token_pump "." "attach" "it" "to" self_explicit_ref

/* @sem TokenRecipe::Defined{name:Explicit($named_equipment_token_name),colors:$token_colors,card_types:$token_types,subtypes:$token_subtypes,abilities:[@holder($equipment_token_quote_pump),$keyword_equip]} */
named_equipment_token_pump ::= token_colors token_subtypes token_types "token" "named" named_equipment_token_name "with" '"' equipment_token_quote_pump '"' "and" keyword_equip

named_equipment_token_name ::= named_equipment_wasteland_guide | named_equipment_neuroflux | named_equipment_axe | named_equipment_sturdy_shield

/* @sem String::'Neuroflux Heirloom' */
named_equipment_neuroflux ::= "Neuroflux" "Heirloom"

equipment_token_quote_pump ::= equipment_quote_fixed_pump | equipment_quote_counter_pump

/* @sem Ability::Static{kind:Ordinary,affected:Objects(One(AttachedTo(Source))),changes:[Pump{power:$signed,toughness:$signed_2}]} */
equipment_quote_fixed_pump ::= "equipped" "creature" "gets" signed "/" signed

/* @sem Ability::Static{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Pump{power:$equipment_quote_counter_population, toughness:$equipment_quote_counter_population}]} */
equipment_quote_counter_pump ::= "equipped" "creature" "gets" "+" "1" "/" "+" "1" "for" "each" equipment_quote_counter_population

/* @sem Expr::CountCounters{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(AbilityController)))}), kind:$counter_kind, information:CurrentOrLastKnown} */
equipment_quote_counter_population ::= counter_kind "counter" "among" filter_plural "you" "control"

/* @sem String::'Cadet' */
created_name_cadet ::= "Cadet"

/* @sem TokenRecipe::Defined{name:Explicit(Heartwood), colors:[Red, Green], card_types:[Artifact], abilities:[@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[TapSymbol]}, limits:_{}, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:ChooseOne([Amount{color:Red, amount:Constant(1)}, Amount{color:Green, amount:Constant(1)}])}}]}})]} */
tn_heartwood ::= "Heartwood"

/* Both amounts use the definition at the end of the printed sentence. */
/* @sem Instruction::[Effect{result:@mark, operation:@apply(PlayerSet::One(AbilityController), $create_base)}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@marked)), kind:$counter_kind, amount:@written_x($value)}]}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:@written_x($value)}}] */
instructions_create_counted_counters_and_life ::= create_base "." "put" "X" counter_kind "counters" "on" "each" "of" "them" "and" "you" "gain" "X" "life" "," "where" "X" "is" value

/* The variable payment supplies the number of tokens, including zero. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[Mana($mana_symbols), TapSymbol, $cost_remove_any_counters]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:PaidCountersRemoved{payment:Activation,component:[2]}, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{}}}]}} */
activated_counter_removal_tokens ::= mana_symbols "," "{" "T" "}" "," "↑" cost_remove_any_counters ":" "create" "that" "many" token_recipe "."


/* The name introducing the token is the name used by its quoted trigger. */
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:Explicit(Galactus), supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2], abilities:[$keyword_ability, $keyword_ability_2, @holder(@scope(Ability::Triggered{event:Object{event:Attacks, objects:SameObject(Source)}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}))]}} */
token_galactus_attack ::= "Galactus" "," counter_amount "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token" "with" keyword_ability "," keyword_ability "," "and" '"' "whenever" "Galactus" "attacks" "," program_sentence '"'

/* @sem String::'Doombot' */
created_name_doombot ::= "Doombot"

/* @sem String::'Axe' */
named_equipment_axe ::= "Axe"

/* @sem String::'Stone Boulder' */
created_name_stone_boulder ::= "Stone" "Boulder"

/* Additional tokens use the written recipe and a rounded-down game-wide life total. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{}}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Divide{numerator:EventHistory{event:Player{event:GainsLife, players:One(AbilityController)}, window:ThisGame, measure:TotalAmount}, denominator:$number, rounding:Down}, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{}}}] */
create_additional_life_groups ::= "create" "a" token_recipe "." "for" "every" number "life" "you" "gained" "this" "game" "," "create" "an" "additional" "one" "of" "those" "tokens"

/* Every planar die roll this turn counts independently of the roller. */
/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:EventHistory{event:Player{event:RollsPlanarDie, players:All}, window:ThisTurn, measure:Occurrences}, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
create_for_planar_die_rolls ::= "create" "a" token_recipe "for" "each" "time" "the" "planar" "die" "was" "rolled" "this" "turn"

/* Name and intrinsic abilities are independent token recipe operands. */
/* @sem TokenRecipe::Defined(_{name:Explicit($created_token_name), colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2], abilities:$token_abilities}) */
token_named_before_abilities ::= token_stat "/" token_stat token_colors token_subtypes token_types "token" "named" created_token_name "with" token_abilities

/* @sem String::'Phantasmal Angel' */
created_name_phantasmal_angel ::= "Phantasmal" "Angel"

/* The quoted token is the target and the sacrifice object. */
/* @sem Ability::Triggered{event:BecomesTarget{objects:SameObject(Source), kind:SpellOrAbility, by:Term{family:SpellsAndAbilities, form:AnySpellOrAbility}}, limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:One(Source)}}]}} */
token_targeted_sacrifice ::= "when" "this" "token" "becomes" "the" "target" "of" "a" "spell" "or" "ability" "," "sacrifice" "it" "."

/* @sem String::'Sturdy Shield' */
named_equipment_sturdy_shield ::= "Sturdy" "Shield"

/* @sem Ability::BeforeGame{when:GameBegins, body:List([Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}])} */
before_game_starting_token ::= "you" "start" "the" "game" "with" "a" token_named_recipe "token"

/* A named token owns its quoted landfall ability and its own counter placement. */
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:Explicit('Zabu'), supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2], abilities:[@holder(Ability::WithPresentation{label:'Landfall', reminder:false, ability:Triggered{event:$event_controlled_enters, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Source)), kind:$counter_kind, amount:$counter_a}]}}]}}})]}} */
token_zabu_landfall ::= "Zabu" "," counter_amount "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token" "with" '"' "landfall" "—" "whenever" event_controlled_enters "," "put" counter_a counter_kind "counter" "on" "Zabu" "." '"'

/* The written arrival states are part of the creation and apply to the full resulting batch. */
/* @sem Instruction::[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:[]}}], entry:$populate_token_arrival_tapped_attacking})}] */
instructions_copy_with_arrival_sentence ::= "create" "a" "token" "that's" "a" "copy" "of" object_ref "." populate_token_arrival_tapped_attacking

/* The entering holder, rather than an arbitrary copy, supplies the token recipe. */
/* @sem Ability::Triggered{event:ZoneChange{objects:$event_self, to:Battlefield}, intervening_if:ObjectMatches{object:Source, filter:Not(Token)}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$number_words, words:CreatingEffect, recipe:Copy{object:Source, exceptions:[RemoveSupertypes([Legendary])]}}], entry:BattlefieldArrival{}}}]}} */
plural_nontoken_entry_self_copies ::= "when" event_self "enter" "," "if" "they're" "not" "a" "token" "," "create" number_words "tokens" "that" "are" "copies" "of" "them" "," "except" "the" "tokens" "aren't" "legendary" "."

/* The created token receives copies of the departed event subject's last known counters. */
/* @sem Instruction::[Effect{result:@mark, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{}})}, Effect{result:@next, operation:DuplicateCounters{from:CounterSource::On(Objects(One(@event_subject))), to:Objects(Created(@marked)), copies:All}}] */
create_then_duplicate_departed_counters ::= "create" "a" token_recipe "," "then" "put" "this" "creature's" "counters" "on" "that" "token"

/* An artifact token without stated colors is colorless; its abilities belong to it. */
/* @sem TokenRecipe::Defined{ name:FromSubtypes, colors:[], card_types:[Artifact], subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2], abilities:$token_abilities } */
token_artifact_stats_implicit_color_with ::= token_stat "/" token_stat token_subtypes "artifact" "token" "with" token_abilities

/* Counters are placed on the exact token just created. */
/* @sem Instruction::[Effect{result:@next, operation:$create_one_defined}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@prior)), kind:$counter_kind, amount:$number}]}}] */
create_and_put_counters ::= create_one_defined "and" "put" number counter_kind "counters" "on" "it"

/* @sem String::'Lotus' */
created_name_lotus ::= "Lotus"

/* @sem TokenRecipe::Defined(_{name:Explicit($created_token_name), colors:$token_colors, card_types:$token_types, abilities:$token_abilities}) */
token_statless_named_before_abilities ::= token_colors token_types "token" "named" created_token_name "with" token_abilities

/* Each token carries its own triggered ability; its source is the copy. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyEach{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One($target_player))])}, exceptions:[AddAbilities([Keyword(Haste), @scope(Ability::Triggered{event:Turn{point:EndStepBegins, players:All}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[If{condition:Not(Controls{player:AbilityController, filter:CardType(Planeswalker), minimum:1}), then:Program{instructions:[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:One(Source)}}]}, otherwise:Program{}}]}})])]}}], entry:BattlefieldArrival{}}}]}} */
face_copy_token_spell ::= "for" "each" "creature" target_player "controls" "," "create" "a" "token" "that's" "a" "copy" "of" "that" "creature" "," "except" "it" "has" "haste" "and" '"' "at" "the" "beginning" "of" "the" "end" "step" "," "if" "you" "don't" "control" "a" "planeswalker" "," "sacrifice" "this" "token" "." '"'

/* @sem String::'Wasteland Survival Guide' */
named_equipment_wasteland_guide ::= "Wasteland" "Survival" "Guide"
