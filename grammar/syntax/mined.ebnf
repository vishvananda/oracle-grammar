/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, SharesWithAny{property:CreatureTypes, with:CostObjects{payment:Activation, component:[0], view:Performed, phase:Before}}])}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}]}} */
m_cost_you_may_program ::= cost ":" "you" "may" "put" "a" filter_phrase "card" "from" "your" "hand" "that" "shares" "a" "creature" "type" "with" "each" "creature" "tapped" "this" "way" "onto" "the" "battlefield" "."

