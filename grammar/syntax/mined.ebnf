/* 75 cards, level:instructions, e.g. When this artifact enters, search your library for a basic Plains, Swamp, or Forest card, reveal it, */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:$filter_phrase, count:UpTo($counter_amount)}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(0), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
m_search_your_library_for_counter_amount_filter_phrase_card ::= "search" "your" "library" "for" counter_amount filter_phrase "card" "," "reveal" "it" "," "put" "it" "into" "your" "hand" "," "then" "shuffle"


/* 19 cards, level:instructions, e.g. {3}{G}, {T}, Sacrifice this land: Search your library for up to two basic land cards, put them onto  */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:$filter_phrase, count:UpTo($value)}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
m_search_your_library_for_up_to_value ::= "search" "your" "library" "for" "up" "to" value filter_phrase "cards" "," "put" "them" "onto" "the" "battlefield" "tapped" "," "then" "shuffle"

/* 5 cards, level:ability, e.g. If you control two or more other lands, this land enters tapped. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:_{instructions:[If{condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject($object_ref)), $filter_plural, ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}, then:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}]}, otherwise:_{}}]}}) */
m_if_you_control_value_or_more_other ::= "if" "you" "control" value "or" "more" "other" filter_plural "," object_ref "enters" "tapped" "."

/* 5 cards, level:instructions, e.g. Whenever you cast an Adventure spell, you may copy it. You may choose new targets for the copy. */
/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$object_ref, times:Constant(1), targets:May}}]}}] */
m_you_may_copy_object_ref_you_may_choose ::= "you" "may" "copy" object_ref "." "you" "may" "choose" "new" "targets" "for" "the" "copy"


/* 5 cards, level:condition, e.g. Whenever an artifact or creature an opponent controls enters untapped, they may tap that permanent.  */
/* @sem Condition::Not(PaymentChosen(0)) */
m_they_don_t ::= "they" "don't"

/* 5 cards, level:operation, e.g. {U}, Sacrifice an Island: Target land becomes an Island until end of turn. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[SetLandType(Vocabulary{family:LandType, form:Island})], duration:$duration, evaluation:Snapshot} */
m_affected_becomes_an_island_until_end_of ::= affected "becomes" "an" "Island" duration

/* 5 cards, level:condition, e.g. Return target creature to its owner's hand. If its mana value was 3 or less, scry 1. */
/* @sem Condition::ObjectMatches{object:Target{slot:0, index:0}, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}} */
m_its_mana_value_was_value_or_less ::= "its" "mana" "value" "was" value "or" "less"

/* 4 cards, level:operation, e.g. When this creature enters, each opponent sacrifices a creature. */
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:$players_singular, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan($counter_amount)}) */
