/* Each controller resolves a tie inside the printed kind's greatest-value
   population. Finish the first exchange before choosing the second pair, and
   always attempt the second exchange, even if the first has no legal pair. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:Extreme{among:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($exchange_kind, ObjectFilter::ControlledBy(One(AbilityController)))}, property:ManaValue, highest:true}}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:ChooseObjects{player:$player_ref, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:Extreme{among:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($exchange_kind, ObjectFilter::ControlledBy(One($player_ref)))}, property:ManaValue, highest:true}}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::ExchangeControl{first:Result{result:@back(3), phase:After, index:0}, second:Result{result:@back(2), phase:After, index:0}}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:Extreme{among:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($exchange_other_kind, ObjectFilter::ControlledBy(One(AbilityController)))}, property:ManaValue, highest:true}}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:ChooseObjects{player:$player_ref, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:Extreme{among:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($exchange_other_kind, ObjectFilter::ControlledBy(One($player_ref)))}, property:ManaValue, highest:true}}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::ExchangeControl{first:Result{result:@back(3), phase:After, index:0}, second:Result{result:@back(2), phase:After, index:0}}}}] */
instructions_exchange_greatest ::= "you" "and" player_ref "exchange" "control" "of" "the" exchange_kind "you" "each" "control" "with" "the" "greatest" "mana" "value" "." NEWLINE? "then" "exchange" "control" "of" exchange_other_kind "the" "same" "way" "." NEWLINE? "if" "two" "or" "more" "permanents" "a" "player" "controls" "are" "tied" "for" "greatest" "," "their" "controller" "chooses" "one" "of" "them"

exchange_kind ::= noun_creature | noun_artifact | noun_enchantment | noun_land | noun_planeswalker | noun_battle | noun_permanent
exchange_other_kind ::= plural_creature | plural_artifact | plural_enchantment | plural_land | plural_planeswalker | exchange_plural_battle | plural_permanent
/* @sem ObjectFilter::CardType(Battle) */
exchange_plural_battle ::= "battles"

/* Exchange two independently selected controlled permanents, comparing the second to the first. */
/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::ExchangeControl{first:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$exchange_permanent_filter, ControlledBy(One(AbilityController))])}), index:0}, second:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$exchange_permanent_filter_2, ControlledBy(OpponentsOf(AbilityController)), Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:ObjectProperty{object:Target{slot:@last_slot, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}])}), index:0}}}}]}}] */
instructions_may_exchange_value ::= "you" "may" "exchange" "control" "of" "target" exchange_permanent_filter "you" "control" "and" "target" exchange_permanent_filter "an" "opponent" "controls" "with" "equal" "or" "lesser" "mana" "value"

exchange_permanent_filter ::= exchange_nonland_permanent | noun_creature | noun_artifact | noun_enchantment | noun_land
/* @sem ObjectFilter::Not(CardType(Land)) */
exchange_nonland_permanent ::= "nonland" "permanent"

/* The follow-up refers to the very spell in the exchange, and its current
   controller chooses its targets after the exchange. */
/* @sem Instruction::[Effect{result:@next, operation:Exchange{kind:Control, first:Object($exchange_target_spell), second:Object($object_ref)}}, Optional{decider:ControllerOf($exchange_target_spell), body:_{instructions:[Effect{result:@next, operation:Retarget{actor:One(ControllerOf($exchange_target_spell)), object:$exchange_target_spell, targets:May}}]}}] */
instructions_exchange_spell_retarget ::= "exchange" "control" "of" exchange_target_spell "and" object_ref "." "then" "the" "spell's" "controller" "may" "choose" "new" "targets" "for" "it"
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:$adjective_nontype}), index:0} */
exchange_target_spell ::= "target" adjective_nontype "spell"

/* The event spell and the holder are independent objects in the exchange. */
/* @sem Operation::Exchange{kind:Control, first:Object(EventSubject), second:Object($self_ref_holder)} */
exchange_holder_event_spell ::= "exchange" "control" "of" self_ref_holder "and" "that" "spell"

/* @sem Operation::Retarget{actor:One(AbilityController), object:EventSubject, targets:May} */
retarget_event_spell_optional ::= "you" "may" "choose" "new" "targets" "for" "the" "spell"

/* @sem Operation::Retarget{actor:One(AbilityController), object:EventSubject, targets:Must} */
retarget_event_spell_required ::= "choose" "new" "targets" "for" "the" "spell"

retarget_event_spell_followup ::= retarget_event_spell_optional | retarget_event_spell_required

/* The follow-up uses the choice receipt of the preceding player action. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:$exchange_holder_event_spell}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:_{instructions:[Effect{result:@next, operation:$retarget_event_spell_followup}]}, otherwise:_{}}]} */
optional_exchange_event_spell_followup ::= "you" "may" exchange_holder_event_spell "." "if" "you" "do" "," retarget_event_spell_followup "."

/* @sem Ability::Triggered{event:$event_cast_third, limits:TriggerLimits{}, announcement:@announcement, body:$optional_exchange_event_spell_followup} */
cast_exchange_holder_trigger ::= "whenever" event_cast_third "," optional_exchange_event_spell_followup
