/* Each controller resolves a tie inside the printed kind's greatest-value
   population. Finish the first exchange before choosing the second pair, and
   always attempt the second exchange, even if the first has no legal pair. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:Extreme{among:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($exchange_kind, ObjectFilter::ControlledBy(One(AbilityController)))}, property:ManaValue, highest:true}}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:ChooseObjects{player:$player_ref, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:Extreme{among:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($exchange_kind, ObjectFilter::ControlledBy(One($player_ref)))}, property:ManaValue, highest:true}}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::ExchangeControl{first:Result{result:@back(3), phase:After, index:0}, second:Result{result:@back(2), phase:After, index:0}}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:Extreme{among:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($exchange_other_kind, ObjectFilter::ControlledBy(One(AbilityController)))}, property:ManaValue, highest:true}}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:ChooseObjects{player:$player_ref, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:Extreme{among:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($exchange_other_kind, ObjectFilter::ControlledBy(One($player_ref)))}, property:ManaValue, highest:true}}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::ExchangeControl{first:Result{result:@back(3), phase:After, index:0}, second:Result{result:@back(2), phase:After, index:0}}}}] */
instructions_exchange_greatest ::= "you" "and" player_ref "exchange" "control" "of" "the" exchange_kind "you" "each" "control" "with" "the" "greatest" "mana" "value" "." NEWLINE? "then" "exchange" "control" "of" exchange_other_kind "the" "same" "way" "." NEWLINE? "if" "two" "or" "more" "permanents" "a" "player" "controls" "are" "tied" "for" "greatest" "," "their" "controller" "chooses" "one" "of" "them"

exchange_kind ::= noun_creature | noun_artifact | noun_enchantment | noun_land | noun_planeswalker | noun_battle | noun_permanent
exchange_other_kind ::= plural_creature | plural_artifact | plural_enchantment | plural_land | plural_planeswalker | exchange_plural_battle | plural_permanent
/* @sem ObjectFilter::CardType(Battle) */
exchange_plural_battle ::= "battles"
