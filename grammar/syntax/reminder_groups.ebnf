reminder_group_3_231 ::= reminder_head "," reminder_head reminder_last_separator reminder_head "(" reminder_clause reminder_join reminder_clause reminder_join reminder_clause "." ")"

/* @sem Keyword::[WithReminder{keyword:@agree($reminder_head, $reminder_clause_2), reminder:true}, WithReminder{keyword:@agree($reminder_head_2, $reminder_clause_3), reminder:true}, WithReminder{keyword:@agree($reminder_head_3, $reminder_clause), reminder:true}] */
reminder_group_3_312 ::= reminder_head "," reminder_head reminder_last_separator reminder_head "(" reminder_clause reminder_join reminder_clause reminder_join reminder_clause "." ")"

/* @sem Keyword::[WithReminder{keyword:@agree($reminder_head, $reminder_clause_3), reminder:true}, WithReminder{keyword:@agree($reminder_head_2, $reminder_clause_2), reminder:true}, WithReminder{keyword:@agree($reminder_head_3, $reminder_clause), reminder:true}] */
reminder_group_3_321 ::= reminder_head "," reminder_head reminder_last_separator reminder_head "(" reminder_clause reminder_join reminder_clause reminder_join reminder_clause "." ")"

combined_reminder_keywords ::= reminder_group_2_1 | reminder_group_2_2 | reminder_group_2_12 | reminder_group_2_21 | reminder_group_3_1 | reminder_group_3_2 | reminder_group_3_3 | reminder_group_3_12 | reminder_group_3_13 | reminder_group_3_21 | reminder_group_3_23 | reminder_group_3_31 | reminder_group_3_32 | reminder_group_3_123 | reminder_group_3_132 | reminder_group_3_213 | reminder_group_3_231 | reminder_group_3_312 | reminder_group_3_321

reminder_clause ::= reminder_keyword_flying | reminder_keyword_trample | reminder_keyword_lifelink | reminder_keyword_deathtouch | reminder_keyword_vigilance | reminder_keyword_haste | reminder_keyword_reach | reminder_keyword_first_strike | reminder_keyword_double_strike | reminder_keyword_indestructible | reminder_keyword_hexproof | reminder_keyword_shroud | reminder_keyword_menace | reminder_keyword_defender | reminder_keyword_flash | reminder_keyword_fear | reminder_keyword_intimidate | reminder_keyword_infect | reminder_keyword_wither | reminder_keyword_prowess | reminder_keyword_flanking | reminder_keyword_horsemanship | reminder_keyword_shadow | reminder_keyword_skulk | ward_reminder_clause | protection_reminder_clause | walk_reminder_clause

