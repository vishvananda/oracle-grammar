/* Groups of two or three keywords may share reminders. Each described
   instance keeps its flag. Every matching assignment is a grammar reading. */
/* @sem @keyword_abilities($combined_reminder_keywords) */
reminder_group_abilities ::= combined_reminder_keywords
/* @sem @keyword_changes($combined_reminder_keywords) */
reminder_group_grants ::= combined_reminder_keywords

reminder_head ::= keyword_name | keyword_protection | keyword_protection_each | keyword_hexproof_from | keyword_walk | keyword_ward | keyword_ward_tight

/* @sem () */
reminder_pair_separator ::= "," | "and"
/* @sem () */
reminder_last_separator ::= "," | "and" | "," "and"
/* @sem () */
reminder_join ::= "." | "," "and" | "and"

/* @sem Keyword::[WithReminder{keyword:@agree($reminder_head, $reminder_clause), reminder:true}, $reminder_head_2] */
reminder_group_2_1 ::= reminder_head reminder_pair_separator reminder_head "(" reminder_clause "." ")"

/* @sem Keyword::[$reminder_head, WithReminder{keyword:@agree($reminder_head_2, $reminder_clause), reminder:true}] */
reminder_group_2_2 ::= reminder_head reminder_pair_separator reminder_head "(" reminder_clause "." ")"

/* @sem Keyword::[WithReminder{keyword:@agree($reminder_head, $reminder_clause), reminder:true}, WithReminder{keyword:@agree($reminder_head_2, $reminder_clause_2), reminder:true}] */
reminder_group_2_12 ::= reminder_head reminder_pair_separator reminder_head "(" reminder_clause reminder_join reminder_clause "." ")"

/* @sem Keyword::[WithReminder{keyword:@agree($reminder_head, $reminder_clause_2), reminder:true}, WithReminder{keyword:@agree($reminder_head_2, $reminder_clause), reminder:true}] */
reminder_group_2_21 ::= reminder_head reminder_pair_separator reminder_head "(" reminder_clause reminder_join reminder_clause "." ")"

/* @sem Keyword::[WithReminder{keyword:@agree($reminder_head, $reminder_clause), reminder:true}, $reminder_head_2, $reminder_head_3] */
reminder_group_3_1 ::= reminder_head "," reminder_head reminder_last_separator reminder_head "(" reminder_clause "." ")"

/* @sem Keyword::[$reminder_head, WithReminder{keyword:@agree($reminder_head_2, $reminder_clause), reminder:true}, $reminder_head_3] */
reminder_group_3_2 ::= reminder_head "," reminder_head reminder_last_separator reminder_head "(" reminder_clause "." ")"

/* @sem Keyword::[$reminder_head, $reminder_head_2, WithReminder{keyword:@agree($reminder_head_3, $reminder_clause), reminder:true}] */
reminder_group_3_3 ::= reminder_head "," reminder_head reminder_last_separator reminder_head "(" reminder_clause "." ")"

/* @sem Keyword::[WithReminder{keyword:@agree($reminder_head, $reminder_clause), reminder:true}, WithReminder{keyword:@agree($reminder_head_2, $reminder_clause_2), reminder:true}, $reminder_head_3] */
reminder_group_3_12 ::= reminder_head "," reminder_head reminder_last_separator reminder_head "(" reminder_clause reminder_join reminder_clause "." ")"

/* @sem Keyword::[WithReminder{keyword:@agree($reminder_head, $reminder_clause), reminder:true}, $reminder_head_2, WithReminder{keyword:@agree($reminder_head_3, $reminder_clause_2), reminder:true}] */
reminder_group_3_13 ::= reminder_head "," reminder_head reminder_last_separator reminder_head "(" reminder_clause reminder_join reminder_clause "." ")"

/* @sem Keyword::[WithReminder{keyword:@agree($reminder_head, $reminder_clause_2), reminder:true}, WithReminder{keyword:@agree($reminder_head_2, $reminder_clause), reminder:true}, $reminder_head_3] */
reminder_group_3_21 ::= reminder_head "," reminder_head reminder_last_separator reminder_head "(" reminder_clause reminder_join reminder_clause "." ")"

/* @sem Keyword::[$reminder_head, WithReminder{keyword:@agree($reminder_head_2, $reminder_clause), reminder:true}, WithReminder{keyword:@agree($reminder_head_3, $reminder_clause_2), reminder:true}] */
reminder_group_3_23 ::= reminder_head "," reminder_head reminder_last_separator reminder_head "(" reminder_clause reminder_join reminder_clause "." ")"

/* @sem Keyword::[WithReminder{keyword:@agree($reminder_head, $reminder_clause_2), reminder:true}, $reminder_head_2, WithReminder{keyword:@agree($reminder_head_3, $reminder_clause), reminder:true}] */
reminder_group_3_31 ::= reminder_head "," reminder_head reminder_last_separator reminder_head "(" reminder_clause reminder_join reminder_clause "." ")"

/* @sem Keyword::[$reminder_head, WithReminder{keyword:@agree($reminder_head_2, $reminder_clause_2), reminder:true}, WithReminder{keyword:@agree($reminder_head_3, $reminder_clause), reminder:true}] */
reminder_group_3_32 ::= reminder_head "," reminder_head reminder_last_separator reminder_head "(" reminder_clause reminder_join reminder_clause "." ")"

/* @sem Keyword::[WithReminder{keyword:@agree($reminder_head, $reminder_clause), reminder:true}, WithReminder{keyword:@agree($reminder_head_2, $reminder_clause_2), reminder:true}, WithReminder{keyword:@agree($reminder_head_3, $reminder_clause_3), reminder:true}] */
reminder_group_3_123 ::= reminder_head "," reminder_head reminder_last_separator reminder_head "(" reminder_clause reminder_join reminder_clause reminder_join reminder_clause "." ")"

