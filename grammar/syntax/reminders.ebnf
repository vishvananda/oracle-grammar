/* Reminder words are templates, not effect text or bindings. Each flag belongs
   to one keyword instance and is read by the same inverse declaration. */

/* These flags belong to the intrinsic Keyword in StaticKind, while the ability
   itself remains a native characteristic-defining Static ability. */
/* @sem Keyword::WithReminder{keyword:$kn_devoid, reminder:true} */
reminded_devoid_keyword ::= kn_devoid "(" "this" "card" "has" "no" "color" "." ")"

/* @sem Keyword::WithReminder{keyword:$kn_changeling, reminder:true} */
reminded_changeling_keyword ::= kn_changeling "(" "this" "card" "is" "every" "creature" "type" "." ")"

keyword_reminded ::= reminded_flying | reminded_trample | reminded_lifelink | reminded_deathtouch
    | reminded_vigilance | reminded_haste | reminded_reach | reminded_first_strike
    | reminded_double_strike | reminded_indestructible | reminded_hexproof | reminded_shroud
    | reminded_menace | reminded_defender | reminded_flash | reminded_fear | reminded_intimidate
    | reminded_infect | reminded_wither | reminded_prowess | reminded_flanking
    | reminded_horsemanship | reminded_shadow | reminded_skulk
    | reminded_ward | reminded_protection | reminded_walk

/* @sem Keyword::WithReminder{keyword:$kn_flying, reminder:true} */
reminded_flying ::= kn_flying "(" reminder_flying ")"
/* @sem Keyword::WithReminder{keyword:$kn_trample, reminder:true} */
reminded_trample ::= kn_trample "(" reminder_trample ")"
/* @sem Keyword::WithReminder{keyword:$kn_lifelink, reminder:true} */
reminded_lifelink ::= kn_lifelink "(" reminder_lifelink ")"
/* @sem Keyword::WithReminder{keyword:$kn_deathtouch, reminder:true} */
reminded_deathtouch ::= kn_deathtouch "(" reminder_deathtouch ")"
/* @sem Keyword::WithReminder{keyword:$kn_vigilance, reminder:true} */
reminded_vigilance ::= kn_vigilance "(" reminder_vigilance ")"
/* @sem Keyword::WithReminder{keyword:$kn_haste, reminder:true} */
reminded_haste ::= kn_haste "(" reminder_haste ")"
/* @sem Keyword::WithReminder{keyword:$kn_reach, reminder:true} */
reminded_reach ::= kn_reach "(" reminder_reach ")"
/* @sem Keyword::WithReminder{keyword:$kn_first_strike, reminder:true} */
reminded_first_strike ::= kn_first_strike "(" reminder_first_strike ")"
/* @sem Keyword::WithReminder{keyword:$kn_double_strike, reminder:true} */
reminded_double_strike ::= kn_double_strike "(" reminder_double_strike ")"
/* @sem Keyword::WithReminder{keyword:$kn_indestructible, reminder:true} */
reminded_indestructible ::= kn_indestructible "(" reminder_indestructible ")"
/* @sem Keyword::WithReminder{keyword:$kn_hexproof, reminder:true} */
reminded_hexproof ::= kn_hexproof "(" reminder_hexproof ")"
/* @sem Keyword::WithReminder{keyword:$kn_shroud, reminder:true} */
reminded_shroud ::= kn_shroud "(" reminder_shroud ")"
/* @sem Keyword::WithReminder{keyword:$kn_menace, reminder:true} */
reminded_menace ::= kn_menace "(" reminder_menace ")"
/* @sem Keyword::WithReminder{keyword:$kn_defender, reminder:true} */
reminded_defender ::= kn_defender "(" reminder_defender ")"
/* @sem Keyword::WithReminder{keyword:$kn_flash, reminder:true} */
reminded_flash ::= kn_flash "(" reminder_flash ")"
/* @sem Keyword::WithReminder{keyword:$kn_fear, reminder:true} */
reminded_fear ::= kn_fear "(" reminder_fear ")"
/* @sem Keyword::WithReminder{keyword:$kn_intimidate, reminder:true} */
reminded_intimidate ::= kn_intimidate "(" reminder_intimidate ")"
/* @sem Keyword::WithReminder{keyword:$kn_infect, reminder:true} */
reminded_infect ::= kn_infect "(" reminder_infect ")"
/* @sem Keyword::WithReminder{keyword:$kn_wither, reminder:true} */
reminded_wither ::= kn_wither "(" reminder_wither ")"
/* @sem Keyword::WithReminder{keyword:$kn_prowess, reminder:true} */
reminded_prowess ::= kn_prowess "(" reminder_prowess ")"
/* @sem Keyword::WithReminder{keyword:$kn_flanking, reminder:true} */
reminded_flanking ::= kn_flanking "(" reminder_flanking ")"
/* @sem Keyword::WithReminder{keyword:$kn_horsemanship, reminder:true} */
reminded_horsemanship ::= kn_horsemanship "(" reminder_horsemanship ")"
/* @sem Keyword::WithReminder{keyword:$kn_shadow, reminder:true} */
reminded_shadow ::= kn_shadow "(" reminder_shadow ")"
/* @sem Keyword::WithReminder{keyword:$kn_skulk, reminder:true} */
reminded_skulk ::= kn_skulk "(" reminder_skulk ")"

/* These subjects never introduce an object, event, target or ability holder. */
/* @sem () */
reminder_subject ::= reminder_self_text | "it" | self_pronoun
/* Names in reminder text carry spelling without the main text's legendary-name
   preference. Creature/Artifact/etc. still use the actual holder's context. */
/* @sem () */
reminder_self_text ::= self_holder_text | reminder_named
/* @sem () */
reminder_named ::= SELF_NAME
/* @sem () */
reminder_source ::= reminder_subject | "this"
/* @sem () */
reminder_pronoun ::= "it" | "he" | "she"
/* @sem () */
reminder_attacking ::= "it's" | "he's" | "she's" | "they're"

/* @sem () */
reminder_flying ::= reminder_flying_clause "."
/* @sem () */
reminder_flying_clause ::= reminder_subject "can't" "be" "blocked" "except" "by" "creatures" "with" "flying" "or" "reach"
/* @sem () */
reminder_trample ::= reminder_trample_clause "."
/* @sem () */
reminder_trample_clause ::= reminder_subject "can" "deal" "excess" "combat" "damage" "to" "the" "player" ("or" "planeswalker")? reminder_attacking "attacking"
/* @sem () */
reminder_lifelink ::= reminder_lifelink_clause "."
/* @sem () */
reminder_lifelink_clause ::= "damage" "dealt" "by" reminder_subject "also" "causes" "you" "to" "gain" "that" "much" "life"
/* @sem () */
reminder_deathtouch ::= reminder_deathtouch_clause "."
/* @sem () */
reminder_deathtouch_clause ::= "any" "amount" "of" "damage" reminder_source "deals" "to" "a" "creature" "is" "enough" "to" "destroy" "it"
/* @sem () */
reminder_vigilance ::= reminder_vigilance_clause "."
/* @sem () */
reminder_vigilance_clause ::= "attacking" "doesn't" "cause" reminder_subject "to" "tap"
/* @sem () */
reminder_haste ::= reminder_haste_clause "."
/* @sem () */
reminder_haste_clause ::= reminder_subject "can" "attack" ("and" "{" "T" "}")? "as" "soon" "as" reminder_pronoun "comes" "under" "your" "control"
/* @sem () */
reminder_reach ::= reminder_reach_clause "."
/* @sem () */
reminder_reach_clause ::= reminder_subject "can" "block" "creatures" "with" "flying"
/* @sem () */
reminder_first_strike ::= reminder_first_strike_clause "."
/* @sem () */
reminder_first_strike_clause ::= reminder_subject "deals" "combat" "damage" "before" "creatures" "without" "first" "strike"
/* @sem () */
reminder_double_strike ::= reminder_double_strike_clause "."
/* @sem () */
reminder_double_strike_clause ::= reminder_subject "deals" "both" "first-strike" "and" "regular" "combat" "damage"
/* @sem () */
reminder_indestructible ::= reminder_indestructible_clause "." reminder_indestructible_zero?
/* @sem () */
reminder_indestructible_clause ::= ("damage" "and")? "effects" "that" "say" '"' "↓" "destroy" '"' "don't" "destroy" reminder_subject
/* @sem () */
reminder_indestructible_zero ::= "if" "its" "toughness" "is" "0" "or" "less" "," ("it" "still" "dies" | "it's" "still" "put" "into" "its" "owner's" "graveyard") "."
/* @sem () */
reminder_hexproof ::= reminder_hexproof_clause "."
/* @sem () */
reminder_hexproof_clause ::= reminder_subject "can't" "be" "the" "target" "of" "spells" "or" "abilities" "your" "opponents" "control"
/* @sem () */
reminder_shroud ::= reminder_shroud_clause "."
/* @sem () */
reminder_shroud_clause ::= (reminder_subject | "a" "permanent" "with" "shroud") "can't" "be" "the" "target" "of" "spells" "or" "abilities"
/* @sem () */
reminder_menace ::= reminder_menace_clause "."
/* @sem () */
reminder_menace_clause ::= reminder_subject "can't" "be" "blocked" "except" "by" "two" "or" "more" "creatures"
/* @sem () */
reminder_defender ::= reminder_defender_clause "."
/* @sem () */
reminder_defender_clause ::= reminder_subject "can't" "attack"
/* @sem () */
reminder_flash ::= reminder_flash_clause "."
/* @sem () */
reminder_flash_clause ::= "you" "may" "cast" ("this" "spell" | "this" "card") "any" "time" "you" "could" "cast" "an" "instant"
/* @sem () */
reminder_fear ::= reminder_fear_clause "."
/* @sem () */
reminder_fear_clause ::= reminder_subject "can't" "be" "blocked" "except" "by" "artifact" "creatures" "and" "/" "or" "black" "creatures"
/* @sem () */
reminder_intimidate ::= reminder_intimidate_clause "."
/* @sem () */
reminder_intimidate_clause ::= (reminder_subject | "a" "creature" "with" "intimidate") "can't" "be" "blocked" "except" "by" "artifact" "creatures" "and" "/" "or" "creatures" "that" "share" "a" "color" "with" "it"
/* @sem () */
reminder_infect ::= reminder_infect_clause "."
/* @sem () */
reminder_infect_clause ::= reminder_subject "deals" "damage" "to" "creatures" "in" "the" "form" "of" "-" "1" "/" "-" "1" "counters" "and" "to" "players" "in" "the" "form" "of" "poison" "counters"
/* @sem () */
reminder_wither ::= reminder_wither_clause "."
/* @sem () */
reminder_wither_clause ::= reminder_source "deals" "damage" "to" "creatures" "in" "the" "form" "of" "-" "1" "/" "-" "1" "counters"
/* @sem () */
reminder_prowess ::= reminder_prowess_clause "."
/* @sem () */
reminder_prowess_clause ::= "whenever" "you" "cast" "a" "noncreature" "spell" "," reminder_subject "gets" "+" "1" "/" "+" "1" "until" "end" "of" "turn"
/* @sem () */
reminder_flanking ::= reminder_flanking_clause "."
/* @sem () */
reminder_flanking_clause ::= "whenever" "a" "creature" "without" "flanking" "blocks" reminder_subject "," "the" "blocking" "creature" "gets" "-" "1" "/" "-" "1" "until" "end" "of" "turn"
/* @sem () */
reminder_horsemanship ::= reminder_horsemanship_clause "."
/* @sem () */
reminder_horsemanship_clause ::= reminder_subject "can't" "be" "blocked" "except" "by" "creatures" "with" "horsemanship"
/* @sem () */
reminder_shadow ::= reminder_shadow_clause "."
/* @sem () */
reminder_shadow_clause ::= reminder_subject "can" "block" "or" "be" "blocked" "by" "only" "creatures" "with" "shadow"
/* @sem () */
reminder_skulk ::= reminder_skulk_clause "."
/* @sem () */
reminder_skulk_clause ::= reminder_subject "can't" "be" "blocked" "by" "creatures" "with" "greater" "power"

/* Repeated costs and qualities must agree, including when printing edited IR. */
/* @sem Keyword::WithReminder{keyword:@agree($ward_reminder_head, $ward_reminder_body), reminder:true} */
reminded_ward ::= ward_reminder_head "(" ward_reminder_body ")"
ward_reminder_head ::= keyword_ward | keyword_ward_tight

/* @sem $ward_reminder_clause */
ward_reminder_body ::= ward_reminder_clause "."
/* @sem Keyword::Ward($ward_reminder_payment) */
ward_reminder_clause ::= "whenever" reminder_subject "becomes" "the" "target" "of" "a" "spell" "or" "ability" "an" "opponent" "controls" "," "counter" "it" "unless" "that" "player" ward_reminder_payment
ward_reminder_payment ::= ward_reminder_mana | ward_reminder_life | ward_reminder_discard
/* @sem Cost::Cost{parts:[Mana($mana_symbols)]} */
ward_reminder_mana ::= "pays" mana_symbols
/* @sem Cost::Cost{parts:[Life($number)]} */
ward_reminder_life ::= "pays" number "life"
/* @sem Cost::Cost{parts:[Discard{count:$card_count, filter:Any}]} */
ward_reminder_discard ::= "discards" card_count

/* @sem Keyword::WithReminder{keyword:@agree($keyword_protection, $reminder_protection), reminder:true} */
reminded_protection ::= keyword_protection "(" reminder_protection ")"
/* @sem $protection_reminder_clause */
reminder_protection ::= protection_reminder_clause "."
/* @sem Keyword::Protection(Objects{kind:Any, filter:$reminder_protection_quality}) */
protection_reminder_clause ::= reminder_subject "can't" "be" "blocked" "," "targeted" "," "dealt" "damage" "," ("enchanted" "," "or" "equipped" | "or" "enchanted") "by" "anything" reminder_protection_quality
reminder_protection_quality ::= adjective_color | adjective_monocolored | adjective_multicolored

/* @sem Keyword::WithReminder{keyword:@agree($keyword_walk, $walk_reminder_clause), reminder:true} */
reminded_walk ::= keyword_walk "(" walk_reminder_clause "." ")"
/* @sem Keyword::Landwalk($reminder_walk_land) */
walk_reminder_clause ::= reminder_subject "can't" "be" "blocked" "as" "long" "as" "defending" "player" "controls" ("a" | "an") reminder_walk_land
reminder_walk_land ::= st_plains | st_island | st_swamp | st_mountain | st_forest
    | reminder_walk_legendary | reminder_walk_nonbasic | reminder_walk_snow_forest | reminder_walk_snow_swamp
/* @sem ObjectFilter::Supertype(Legendary) */
reminder_walk_legendary ::= "legendary" "land"
/* @sem ObjectFilter::Not(ObjectFilter::Supertype(Basic)) */
reminder_walk_nonbasic ::= "nonbasic" "land"
/* @sem ObjectFilter::@and(ObjectFilter::Supertype(Snow), ObjectFilter::Subtype(Forest)) */
reminder_walk_snow_forest ::= "snow" "Forest"
/* @sem ObjectFilter::@and(ObjectFilter::Supertype(Snow), ObjectFilter::Subtype(Swamp)) */
reminder_walk_snow_swamp ::= "snow" "Swamp"
