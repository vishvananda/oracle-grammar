/* Optional recipients and spending qualifications share the same mana action. */

mana_clause ::= mana_clause_plain | mana_clause_plain_you | mana_clause_optional | instead_mana

/* @sem Instruction::[Effect{result:@next, operation:$mana_clause_operation}] */
mana_clause_plain ::= mana_clause_operation
/* @sem Instruction::[Effect{result:@next, operation:$add_mana}] */
mana_clause_plain_you ::= "you" add_mana
mana_clause_operation ::= mana_add_equal_event_stat | mana_add_for_target_cards | add_mana | add_mana_player | add_mana_any_combination | mana_add_counted | mana_add_counted_chosen | mana_add_event_amount_one_color | mana_add_per_history | mana_add_event_combination

/* Count the cards in the targeted player's stated zone for each unit. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:$count_each_target_private_cards, production:$mana_for_each_existing, choice:Once}} */
mana_add_for_target_cards ::= "add" mana_for_each_existing "for" "each" count_each_target_private_cards

/* Counted units retain their production and choice independently. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:$value, production:$mana_production, choice:Once}} */
mana_add_counted ::= "add" value mana_production
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:$value, production:Amount{color:Chosen, amount:Constant(1)}, choice:Once}} */
mana_add_counted_chosen ::= "add" value "mana" "of" "the" "chosen" "color"

mana_clause_optional ::= mana_clause_you_may | mana_clause_player_may
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$add_mana}]}}] */
mana_clause_you_may ::= "you" "may" add_mana
/* @sem Instruction::[Optional{decider:$player_ref, body:Program{instructions:[Effect{result:@next, operation:AddMana{players:One($player_ref), mana:$mana_production}}]}}] */
mana_clause_player_may ::= player_ref "may" "add" ("an" "additional")? mana_production

/* Both alternatives retain their own player, choice and receipt. The final
   qualification applies to whichever production actually occurs. */
/* @sem Vec<Instruction>::@restricted_mana($mana_clause, $mana_spending) */
mana_clause_restricted ::= mana_clause "." mana_spending

/* Mana that triggers when it's spent on a spell: the trigger is the mana's own
   restriction, and the rest of the ability is its body. */
instructions_mana_spent_trigger ::= instructions_mana_spent_active | instructions_mana_spent_passive

mana_spending ::= mana_spend_only | mana_can_spend_only | mana_cannot_spend | mana_persists | mana_persists_combat | mana_spend_only_countered | mana_spent_gives_riot | mana_spent_gives_uncounterable | mana_spend_x_cost | mana_spent_on_changes | mana_spent_counter
/* @sem $mana_use */
mana_spend_only ::= "spend" "this" "mana" "only" "to" mana_use
/* @sem $mana_use */
mana_can_spend_only ::= "this" "mana" "can" "be" "spent" "only" "to" mana_use
/* @sem ManaUse::Not($mana_use) */
mana_cannot_spend ::= "this" "mana" ("can't" | "cannot") "be" "spent" "to" mana_use
/* Mana kept through step and phase ends until the effect expires (CR 106.4). */
/* @sem ManaUse::Persists($until_end_of_turn) */
mana_persists ::= until_end_of_turn "," "you" "don't" "lose" "this" "mana" "as" "steps" "and" "phases" "end"
/* @sem ManaUse::Persists($until_end_of_combat) */
mana_persists_combat ::= until_end_of_combat "," "you" "don't" "lose" "this" "mana" "as" "steps" "end"

mana_use ::= mana_use_manifest_morph | mana_use_power_up | mana_use_colorless_or_ability | mana_use_chosen_type_pair | mana_use_unowned_spells | mana_use_face_down_or_turn | mana_use_atom | mana_use_either | mana_use_comma_either | mana_use_ability_or_cast | mana_use_three | mana_use_artifact_cast_or_ability | mana_use_cast_activate_pay_colorless | mana_use_cast_chosen_or_activate
/* @sem ManaUse::Either([$mana_use_atom, ...$mana_use_tail]) */
mana_use_either ::= mana_use_atom "or" mana_use_tail
mana_use_tail ::= mana_use_last | mana_use_more
/* @sem ManaUse::[$mana_use_later] */
mana_use_last ::= mana_use_later
/* @sem ManaUse::[$mana_use_later, ...$mana_use_tail] */
mana_use_more ::= mana_use_later "or" mana_use_tail
mana_use_later ::= mana_use_later_atom | mana_use_later_activate_one

mana_use_atom ::= mana_use_foretell | mana_use_cast | mana_use_activate | mana_use_activate_sources | mana_use_activate_source | mana_use_activate_permanents | mana_use_activate_permanent | mana_use_pay | mana_use_equip | mana_use_turn_plural_face_up

/* Reuse the shared plural spell filters; full singular phrases can also
   share one cast verb, as in "an instant or sorcery spell or a kicked spell". */
/* @sem ManaUse::CastSpell($mana_cast_filter) */
mana_use_cast ::= "cast" mana_cast_filter
mana_cast_filter ::= mana_spells_from_own_graveyard | spells_exact_color_count | cast_spells_filter | mana_spell_one | mana_spell_alternatives | mana_kicked_spells | mana_spells_outside_starting_deck | mana_spells_monocolored_chosen | mana_spell_color_count_without_x | mana_spells_value_or_x | mana_spell_outside_zone | mana_last_linked_card | mana_spell_with_keyword | mana_spells_flashback_graveyard | mana_commander_cast_filter | mana_spells_with_x_cost | mana_spells_without_abilities | mana_spell_from_your_graveyard
/* @sem ObjectFilter::Not(InStartingDeck(One(AbilityController))) */
mana_spells_outside_starting_deck ::= "spells" "that" "aren't" "from" "your" "starting" "deck"
/* @sem ObjectFilter::AllOf([Property{property:ColorCount, test:NumberTest::Compare{comparison:Equal, value:Constant(1)}}, Chosen(Color)]) */
mana_spells_monocolored_chosen ::= "monocolored" "spells" "of" "that" "color"
mana_spell_one ::= mana_spell_one_kind | mana_spell_one_any | mana_spell_one_chosen
/* @sem $mana_spell_filter */
mana_spell_one_kind ::= ("a" | "an") mana_spell_filter "spell"
/* @sem ObjectFilter::Any */
mana_spell_one_any ::= "a" "spell"
/* @sem ObjectFilter::@or($mana_spell_one, $mana_spell_alternative) */
mana_spell_alternatives ::= mana_spell_one "or" mana_spell_alternative
mana_spell_alternative ::= mana_spell_one | mana_spell_alternatives
mana_spell_filter ::= filter_phrase | card_filter | quality | mana_kicked
/* @sem ObjectFilter::State(Kicked) */
mana_kicked ::= "kicked"
/* @sem $mana_kicked */
mana_kicked_spells ::= mana_kicked "spells"
/* The explicit creature head supplies the kind of stored type choice. */
/* @sem @and(ObjectFilter::CardType(Creature), ObjectFilter::Chosen(CreatureType)) */
mana_spell_one_chosen ::= ("a" | "an") "creature" "spell" "of" "the" "chosen" "type"

/* Source wording permits objects outside the battlefield. Unadorned
   permanent nouns retain the permanent-only contract. */
/* @sem ManaUse::ActivateAbility{sources:Any, permanents_only:false} */
mana_use_activate ::= "activate" "abilities"
/* @sem ManaUse::ActivateAbility{sources:$mana_spell_filter, permanents_only:false} */
mana_use_activate_sources ::= "activate" "abilities" "of" mana_spell_filter "sources"
/* @sem ManaUse::ActivateAbility{sources:$mana_spell_filter, permanents_only:false} */
mana_use_activate_source ::= "activate" ("a" | "an") "ability" "of" ("a" | "an") mana_spell_filter "source"
/* @sem ManaUse::ActivateAbility{sources:$filter_plural, permanents_only:true} */
mana_use_activate_permanents ::= "activate" "abilities" "of" filter_plural
/* @sem ManaUse::ActivateAbility{sources:$filter_phrase, permanents_only:true} */
mana_use_activate_permanent ::= "activate" ("a" | "an") "ability" "of" ("a" | "an") filter_phrase

/* @sem ManaUse::Purpose($mana_purpose) */
mana_use_pay ::= "pay" mana_purpose
mana_purpose ::= mana_purpose_cumulative | mana_purpose_disturb | mana_purpose_generic | mana_purpose_colorless_cost
/* @sem ManaPurpose::CumulativeUpkeep */
mana_purpose_cumulative ::= "cumulative" "upkeep" "costs"

/* Both alternatives use the same explicit producible mana type. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:Repeat{amount:$value, production:$mana_could_produce_type, choice:Once}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:$mana_could_produce_type}}]}}] */
instructions_mana_producible_instead ::= "add" mana_could_produce_type "." "if" condition "," "add" value "mana" "of" "that" "type" "instead"

/* The consequence is scoped to the player whose unspent mana is lost. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(AsManaEmpties{mana:Vocabulary{family:UnspentMana, form:AnyUnspentMana}, then:List([Program{instructions:[$mana_loss_consequence]}])})]}) */
static_unspent_mana_consequence ::= "a" "player" "losing" "unspent" "mana" "causes" mana_loss_consequence "."

/* @sem Instruction::Effect{result:@next, operation:LoseLife{players:One(Prior(That)), amount:Game(ManaLostThisWay)}} */
mana_loss_consequence ::= "that" "player" "to" "lose" "that" "much" "life"

/* Mana descriptions for events retain their typed production. */
event_mana_kind ::= event_mana_colorless | event_mana_chosen_color

/* @sem Operand::Term{family:ManaProduce, form:ManaProduceC} */
event_mana_colorless ::= "{" "C" "}"

/* @sem Operand::Term{family:ManaProduce, form:ManaOfTheChosenColor} */
event_mana_chosen_color ::= "mana" "of" "the" "chosen" "color"

/* Used only with an event that identifies the referenced chosen color. */
add_referenced_chosen_mana ::= add_referenced_chosen_mana_player | add_referenced_chosen_mana_you

/* A casting restriction names the colors allowed for the X payment. */
/* @sem Ability::Casting(RestrictMana{portion:X, filter:Colors($casting_mana_colors)}) */
casting_restrict_x_mana ::= "spend" "only" casting_mana_colors "mana" "on" "X" "."

/* @sem ManaColor::[$mana_color_word, $mana_color_word_2] */
casting_mana_colors ::= mana_color_word "and" "/" "or" mana_color_word

/* @sem ManaUse::Either([$mana_use_cast_freerunning, $mana_use_activate_source]) */
mana_use_comma_either ::= mana_use_cast_freerunning "," "or" "to" mana_use_activate_source

/* @sem ManaUse::CastSpell(@or($mana_spell_one, $mana_spell_freerunning)) */
mana_use_cast_freerunning ::= "cast" mana_spell_one "or" mana_spell_freerunning

/* @sem ObjectFilter::HasKeywordFamily(Freerunning) */
mana_spell_freerunning ::= "a" "spell" "that" "has" "freerunning"

/* @sem ObjectFilter::AllOf([Property{property:ColorCount, test:NumberTest::Compare{comparison:Greater, value:$value}}, Not(State(HasX))]) */
mana_spell_color_count_without_x ::= "a" "spell" "that's" value "or" "more" "colors" "without" "{" "X" "}" "in" "its" "mana" "cost"

/* @sem ObjectFilter::AnyOf([Property{property:ManaValue, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}, State(HasX)]) */
mana_spells_value_or_x ::= "spells" "with" "mana" "value" value "or" "greater" "or" "spells" "with" "{" "X" "}" "in" "their" "mana" "costs"

/* @sem ManaUse::ActivateAbility{sources:Any, permanents_only:false} */
mana_use_activate_one ::= "activate" "an" "ability"

/* @sem ManaPurpose::DisturbCost */
mana_purpose_disturb ::= "a" "disturb" "cost"

/* @sem ManaPurpose::GenericCost */
mana_purpose_generic ::= "generic" "mana" "costs"

/* @prefer always */
/* @sem ManaUse::Either([$mana_use_activate_one, $mana_use_cast]) */
mana_use_ability_or_cast ::= mana_use_activate_one "or" mana_use_cast

/* @sem ManaUse::Either([$mana_use_cast, $mana_use_unlock, $mana_use_turn_face_up]) */
mana_use_three ::= mana_use_cast "," mana_use_unlock "," "or" mana_use_turn_face_up

/* @sem ManaUse::Purpose(AbilityKeyword(Equip)) */
mana_use_equip ::= "activate" "an" "equip" "ability"

/* @sem ManaUse::Purpose(UnlockDoor) */
mana_use_unlock ::= "unlock" "a" "door"

/* @sem ManaUse::Purpose(TurnFaceUp($filter_phrase)) */
mana_use_turn_face_up ::= "turn" "a" filter_phrase "face" "up"

/* @sem ManaPurpose::CostContaining(Term{family:ManaSymbol, form:ManaCostC}) */
mana_purpose_colorless_cost ::= "a" "cost" "that" "contains" "{" "C" "}"

/* @sem ObjectFilter::@and(ObjectFilter::CardType(Creature), ObjectFilter::Chosen(CreatureType)) */
mana_spell_chosen_type ::= "a" "spell" "of" "the" "chosen" "type"

/* @sem ManaUse::ActivateAbility{sources:@and(ObjectFilter::CardType(Creature), ObjectFilter::Chosen(CreatureType)), permanents_only:false} */
mana_use_chosen_source ::= "activate" "an" "ability" "of" "a" "source" "of" "the" "chosen" "type"

/* @sem ManaUse::All([CastSpell($mana_cast_filter), SpentGives{spells:Any, effects:[Term{family:SpellEffect, form:CantBeCountered}]}]) */
mana_spend_only_countered ::= "spend" "this" "mana" "only" "to" "cast" mana_cast_filter "," "and" "that" "spell" "can't" "be" "countered"

/* @sem ManaUse::CastSpell(ObjectFilter::CardType(Artifact)) */
mana_use_cast_artifact_singular ::= "cast" "an" "artifact" "spell"

/* @sem ManaUse::Either([$mana_use_cast_artifact_singular, $mana_use_activate_one]) */
mana_use_artifact_cast_or_ability ::= mana_use_cast_artifact_singular "or" mana_use_activate_one

/* A three-purpose restriction retains the written split around its mana cost. */
/* @prefer always */
/* @sem ManaUse::Either([$mana_use_cast, $mana_use_activate_permanent, $mana_use_pay_colorless_cost]) */
mana_use_cast_activate_pay_colorless ::= mana_use_cast "," mana_use_activate_permanent "," "or" mana_use_pay_colorless_cost

/* @sem ManaUse::Purpose($mana_purpose_colorless_cost) */
mana_use_pay_colorless_cost ::= "pay" mana_purpose_colorless_cost

/* @sem ManaUse::Either([CastSpell($mana_spell_chosen_type), $mana_use_chosen_source]) */
mana_use_cast_chosen_or_activate ::= "cast" mana_spell_chosen_type "or" mana_use_chosen_source

/* A defined X keeps its complete value as the ward payment's operand. */
/* @sem Cost::Cost{parts:[ManaWithX{mana:[X], x:$value}]} */
ward_defined_x_cost ::= "{" "X" "}" "," "where" "X" "is" value

/* The named holder's intrinsic keyword uses the current payment definition. */
/* @sem Ability::Keyword(Ward($ward_defined_x_cost)) */
self_ward_defined_x ::= SELF_NAME "has" "ward" ward_defined_x_cost "."

/* @sem ObjectFilter::Not(Cast{from:$card_zone_one}) */
mana_spell_outside_zone ::= "a" "spell" "from" "anywhere" "other" "than" card_zone_one

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[If{condition:$condition, then:Program{instructions:$mana_clause_plain_2}, otherwise:Program{instructions:$mana_clause_plain}}]}} */
activated_conditional_mana_alternative ::= cost ":" mana_clause_plain "." "if" condition "," "instead" mana_clause_plain "."

/* A linked card is selected from the exiled cards of its own source. */
/* @sem ObjectFilter::SameObject(Query{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}), index:0}) */
mana_last_linked_card ::= "the" "last" "card" "exiled" "with" object_ref

/* Spending purposes retain the filters on each independently named use. */
/* @sem ManaUse::Either([CastSpell($filter_phrase), Purpose(TurnFaceUp(State(Manifested))), Purpose(MorphCost)]) */
mana_use_manifest_morph ::= "cast" "a" filter_phrase "spell" "," "pay" "a" "mana" "cost" "to" "turn" "a" "manifested" "creature" "face" "up" "," "or" "pay" "a" "morph" "cost"

/* @sem ManaUse::Purpose(AbilityKeyword(PowerUp)) */
mana_use_power_up ::= "activate" "power-up" "abilities"

/* @prefer always */
/* @sem ManaUse::Either([CastSpell(Colorless), ActivateAbility{sources:Any, permanents_only:false}]) */
mana_use_colorless_or_ability ::= "cast" "a" "colorless" "spell" "or" "to" "activate" "an" "ability"

/* @sem ManaUse::Either([CastSpell(AllOf([$filter_phrase, Chosen(CreatureType)])), ActivateAbility{sources:AllOf([$filter_phrase_2, Chosen(CreatureType)]), permanents_only:false}]) */
mana_use_chosen_type_pair ::= "cast" "a" filter_phrase "spell" "of" "the" "chosen" "type" "or" "activate" "an" "ability" "of" "a" filter_phrase "source" "of" "the" "chosen" "type"

/* @sem ManaUse::CastSpell(OwnedBy(OthersThan(AbilityController))) */
mana_use_unowned_spells ::= "cast" "spells" "you" "don't" "own"

/* @prefer always */
/* @sem ManaUse::Either([CastSpell(State(FaceDown)), Purpose(TurnFaceUp($filter_plural))]) */
mana_use_face_down_or_turn ::= "cast" "face-down" "spells" "or" "to" "turn" filter_plural "face" "up"

/* The persistence sentence qualifies the mana action, not the life gain. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:$mana_production, restriction:$mana_persists}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:$value}}]} */
program_sentence_mana_life_persists ::= "add" mana_production "and" "you" "gain" value "life" "." mana_persists "."

/* The spell receiving riot is the one paid for with this mana. */
/* @sem ManaUse::SpentGives{spells:$filter_phrase, effects:[Term{family:SpellEffect, form:Riot}]} */
mana_spent_gives_riot ::= "if" "that" "mana" "is" "spent" "on" "a" filter_phrase "spell" "," "it" "gains" "riot"

/* A player activates mana abilities of a described population. */
/* @sem Operation::KeywordEach{actor:$players_singular, action:ObjectKeywordAction::ActivateManaAbility, objects:$affected} */
mana_abilities_of_population ::= players_singular "activates" "a" "mana" "ability" "of" affected

/* Keep the loss and its receipt in one production so the printed receipt has
   the same producer in both directions. */
/* @sem Instruction::[Effect{result:@next, operation:Together([$mana_abilities_of_population, Keyword{actor:$players_singular, action:KeywordAction::LoseUnspentMana}])}, Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:LostThisWay(@prior)}}] */
instructions_mana_abilities_lost_receipt ::= mana_abilities_of_population "." "then" players_singular "loses" "all" "unspent" "mana" "and" "you" "add" "the" "mana" "lost" "this" "way"

/* A replacement of mana that would otherwise be lost. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(UnspentManaBecomes($mana_color_word))]} */
static_unspent_mana_becomes ::= "if" "you" "would" "lose" "unspent" "mana" "," "that" "mana" "becomes" mana_color_word "instead" "."

/* Spending consequences are independent of the producing mana clause. */
/* @sem ManaUse::Purpose(XCost) */
mana_spend_x_cost ::= "spend" "this" "mana" "only" "on" "costs" "that" "contain" "{" "X" "}"

/* @prefer always */
/* @sem ManaUse::SpentOn{spells:$filter_phrase, changes:$static_changes, until:EndOfTurn} */
mana_spent_on_changes_turn ::= "if" "that" "mana" "is" "spent" "on" "a" filter_phrase "spell" "," "it" static_changes "until" "end" "of" "turn"

/* @sem ManaUse::SpentOn{spells:$filter_phrase, changes:$static_changes, until:Indefinite} */
mana_spent_on_changes_indefinite ::= "if" "that" "mana" "is" "spent" "on" "a" filter_phrase "spell" "," "it" static_changes

mana_spent_on_changes ::= mana_spent_on_changes_turn | mana_any_spent_on_changes_turn | mana_spent_on_changes_indefinite

/* Both spend wordings share the same spell filter and entry consequence. */
/* @sem ManaUse::SpentGives{spells:$mana_spent_counter_head, effects:[Term{family:EnterFlag, form:EntersWithACounter, operands:[Term{family:CounterType, form:PTCounter, operands:[Integer(1), Integer(1)]}]}]} */
mana_spent_counter ::= mana_spent_counter_head "," "that" "creature" "enters" "with" "an" "additional" "+" "1" "/" "+" "1" "counter" "on" "it"

mana_spent_counter_head ::= mana_spent_counter_on | mana_spent_counter_cast | mana_spent_counter_that_cast

/* @prefer always */
/* @sem $filter_phrase */
mana_spent_counter_on ::= "if" "that" "mana" "is" "spent" "on" "a" filter_phrase "spell"

/* @prefer always */
/* @sem $filter_phrase */
mana_spent_counter_cast ::= "if" "this" "mana" "is" "spent" "to" "cast" "a" filter_phrase "spell"

/* @sem ObjectFilter::HasKeyword($mana_spell_keyword) */
mana_spell_with_keyword ::= "a" "spell" "with" mana_spell_keyword

/* @sem ObjectFilter::AllOf([HasKeywordFamily(Flashback), Cast{from:Players{zone:Graveyard, players:All}}]) */
mana_spells_flashback_graveyard ::= "spells" "with" "flashback" "from" "a" "graveyard"

/* A payment option grants a mana-ability timing rule. */
/* @sem Change::[PlayerRule(LifeForManaAbility{life:$value, mana:$life_mana_result})] */
life_for_mana_rule ::= "any" "time" "you" "could" "activate" "a" "mana" "ability" "," "you" "may" "pay" value "life" "." "if" "you" "do" "," "add" life_mana_result

/* @sem Operand::Vocabulary{family:ManaProduceSymbol, form:ManaProduceC} */
life_mana_result ::= "{" "C" "}"

/* The permission's filter and spending restriction remain independent operands. */
/* @sem Change::[PlayerRule(TapOthersForMana{permanents:$filter_plural, modifier:$tap_others_spending})] */
tap_others_mana_rule ::= "you" "may" "tap" filter_plural "you" "don't" "control" "for" "mana" "." tap_others_spending

/* @sem Operand::Term{family:ManaUseModifier, form:CanOnlySpendOnSpells, operands:[Filter($mana_cast_filter)]} */
tap_others_spending ::= "spend" "this" "mana" "only" "to" "cast" mana_cast_filter

/* @prefer always */
/* A two-color production followed by a plural spell union keeps the printed
   alternatives tied to the restriction's two current filters. */
/* @sem Instruction::[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:$mana_two_distinct_colors, restriction:CastSpell(AnyOf([$noun, $noun_2]))}}] */
mana_distinct_colors_cast_union ::= "add" mana_two_distinct_colors "." "spend" "this" "mana" "only" "to" "cast" noun "or" noun "spells"

/* The pronoun refers to the singular recipient of this mana production. */
/* @sem Vec<Instruction>::@restricted_mana($mana_player_clause, $mana_persists_they) */
mana_player_persistent ::= mana_player_clause "." mana_persists_they

/* @sem Instruction::[Effect{result:@next, operation:$add_mana_player}] */
mana_player_clause ::= add_mana_player

/* @sem ManaUse::Persists($until_end_of_turn) */
mana_persists_they ::= until_end_of_turn "," "they" "don't" "lose" "this" "mana" "as" "steps" "and" "phases" "end"

/* The receipt amount is anchored to the sole removal cost of this activation. */
/* @sem Instruction::[Effect{result:@next, operation:AddMana{players:$players_singular, mana:Repeat{amount:PaidCountersRemoved{payment:Activation, component:[0]}, production:$mana_production, choice:Once}}}] */
mana_player_paid_counters ::= players_singular "adds" "that" "much" mana_production

/* @sem Vec<Instruction>::@restricted_mana($mana_player_paid_counters, $mana_spending) */
mana_player_paid_restricted ::= mana_player_paid_counters "." mana_spending

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_remove_kind_at_least_among]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[...$mana_player_paid_restricted, ...$instructions]}} */
activated_counter_payment_mana ::= cost_remove_kind_at_least_among ":" mana_player_paid_restricted "." instructions "."

/* Capture the population once for both consequences. */
/* @sem Instruction::[Effect{result:@mark, operation:BindValue{value:$counted_mana_population}}, Effect{result:@next, operation:$counted_mana_action}, Effect{result:@next, operation:$counted_life_action}] */
instructions_counted_mana_life ::= "for" "each" counted_mana_population "," counted_mana_action "and" counted_life_action

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One($target_possessive)}, kind:Card, filter:$card_filter}) */
counted_mana_population ::= card_filter "card" "in" target_possessive "graveyard"
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:BoundValue(@marked), production:$mana_production, choice:Once}} */
counted_mana_action ::= "add" mana_production
/* @sem Operation::GainLife{players:One(AbilityController), amount:BoundValue(@marked)} */
counted_life_action ::= "you" "gain" "1" "life"

/* Written fixed counts compose with subsequent instructions without accepting
   the distinct X-where wording used for dynamic quantities. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:$number_words, production:$mana_production, choice:Once}} */
mana_add_counted_words ::= "add" number_words mana_production

/* The input receipt is the singleton creature in this casting cost. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:ObjectProperty{object:Query{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown}, production:$mana_production, choice:Once}} */
mana_from_sacrificed_creature_cost ::= "add" "an" "amount" "of" mana_production "equal" "to" "the" "sacrificed" "creature's" "mana" "value"

/* @sem Ability::[Casting(AdditionalCost{cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:Exactly(Constant(1))}]}, optional:false, repetition:Once}), Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$mana_from_sacrificed_creature_cost}]}}] */
line_sacrifice_cost_mana_value ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "sacrifice" "a" "creature" "." NEWLINE mana_from_sacrificed_creature_cost "."

/* @sem Operation::AddMana{players:$players_singular, mana:Amount{color:Chosen, amount:$value}} */
add_referenced_chosen_mana_player ::= players_singular "adds" "an" "additional" value "mana" "of" "that" "color"

/* The event keeps the ability's source, recipient and produced mana independent. */
/* @sem EventSpec::ManaAdded{abilities:AbilityOf($mana_ability_holder), players:One(AbilityController), mana:$event_mana_chosen_color} */
event_ability_causes_chosen_mana ::= mana_ability_holder "causes" "you" "to" "add" "one" "or" "more" event_mana_chosen_color

mana_ability_holder ::= mana_ability_land | mana_ability_creature | mana_ability_artifact | mana_ability_permanent

/* @sem ObjectFilter::CardType(Land) */
mana_ability_land ::= "a" "land's" "ability"

/* @sem ObjectFilter::CardType(Creature) */
mana_ability_creature ::= "a" "creature's" "ability"

/* @sem ObjectFilter::CardType(Artifact) */
mana_ability_artifact ::= "an" "artifact's" "ability"

/* @sem ObjectFilter::Any */
mana_ability_permanent ::= "a" "permanent's" "ability"

/* @sem EventSpec::$event_ability_causes_chosen_mana */
event_when_ability_causes_chosen_mana ::= "when" event_ability_causes_chosen_mana

/* @sem EventSpec::$event_ability_causes_chosen_mana */
event_whenever_ability_causes_chosen_mana ::= "whenever" event_ability_causes_chosen_mana

/* The event licenses the reference to the chosen color. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Amount{color:Chosen, amount:$value}} */
add_referenced_chosen_mana_you ::= "add" "an" "additional" value "mana" "of" "that" "color"

/* The spending trigger belongs to this mana and expires this turn. */
/* @sem Instruction::[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:$mana_production, restriction:WhenSpent{spells:$spell_filter, this_turn:true, body:Program($program)}}}] */
instructions_mana_spent_this_turn ::= "add" mana_production "." "when" "you" "spend" "this" "mana" "to" "cast" spell_filter "this" "turn" "," program

/* Colorless and colored outcomes share the same player replacement frame. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule($unspent_mana_replacement)]} */
shared_unspent_mana_replacement ::= "if" "you" "would" "lose" "unspent" "mana" "," "that" "mana" unspent_mana_replacement "instead" "."

unspent_mana_replacement ::= unspent_mana_colorless | unspent_mana_colored

/* @sem PlayerRule::UnspentManaBecomes(None) */
unspent_mana_colorless ::= "becomes" "colorless"

/* @sem PlayerRule::UnspentManaBecomes($mana_color_word) */
unspent_mana_colored ::= "becomes" mana_color_word

/* A chosen player receives the literal mana following the choice. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_a_player}, Effect{result:@next, operation:$chosen_player_literal_mana}] */
instructions_choose_player_literal_mana ::= choose_a_player "." chosen_player_literal_mana

/* @sem Operation::AddMana{players:One(Chosen), mana:$chosen_player_mana} */
chosen_player_literal_mana ::= "that" "player" "adds" chosen_player_mana

/* The defending player performs both actions together; the controlled population
   remains an operand of the mana ability action. */
/* @sem Operation::Together([KeywordEach{actor:One(DefendingPlayerOf(Source)), action:ObjectKeywordAction::ActivateManaAbility, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun, ControlledBy(One(DefendingPlayerOf(Source)))])}}, Keyword{actor:One(DefendingPlayerOf(Source)), action:KeywordAction::LoseUnspentMana}]) */
defending_mana_abilities_and_loss ::= "defending" "player" "activate" "a" "mana" "ability" "of" "each" noun "they" "control" "and" "lose" "all" "unspent" "mana"

/* Keep the mana-loss producer and its delayed count in the same contract. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:DefendingPlayerOf(Source), body:_{instructions:[Effect{result:@next, operation:$defending_mana_abilities_and_loss}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[Rule(CombatDamage(NoAssignment))], duration:$this_duration, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:MainPhaseBegins, players:All}, start:Immediately, expires:EndOfTurn, body:_{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:Repeat{amount:Game(ManaLostThisWay), production:Amount{color:Colorless, amount:Constant(1)}, choice:Once}}}]}}}]}, otherwise:_{}}]} */
defending_mana_loss_delayed_program ::= "you" "may" "have" defending_mana_abilities_and_loss "." "if" "you" "do" "," "this" "creature" "assigns" "no" "combat" "damage" this_duration "and" "at" "the" "beginning" "of" "your" "next" "main" "phase" "this" "turn" "," "you" "add" "an" "amount" "of" "{" "C" "}" "equal" "to" "the" "amount" "of" "mana" "that" "player" "lost" "this" "way" "."

mana_spell_keyword ::= keyword_name | kn_devoid

/* Any portion of the produced mana qualifies the spell in the same way. */
/* @sem ManaUse::SpentOn{spells:$filter_phrase, changes:$static_changes, until:EndOfTurn} */
mana_any_spent_on_changes_turn ::= "if" "any" "of" "that" "mana" "is" "spent" "on" "a" filter_phrase "spell" "," "it" static_changes "until" "end" "of" "turn"

/* A defined count is bound once, then shared by independent mana branches. */
/* @sem Instruction::[Effect{result:@mark, operation:BindValue{value:$value}}, ChooseOne{decider:AbilityController, options:[Program{instructions:$defined_mana_branch}, Program{instructions:$defined_mana_branch_2}]}] */
instructions_defined_mana_choice ::= "add" defined_mana_branch "or" defined_mana_branch "," "where" "X" "is" value

/* @sem Instruction::[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:Repeat{amount:BoundValue(@marked), production:$mana_production, choice:Once}}}] */
defined_mana_branch ::= "X" mana_production

/* A paid land is named only inside the activation that selects it. */
/* @sem ManaProduction::CouldProduce{objects:One(Query{objects:CostObjects{payment:Activation, component:[1], view:Inputs, phase:Before}, index:0}), colors_only:false} */
paid_land_mana_type ::= "one" "mana" "of" "any" "type" "that" "land" "could" "produce"

/* @sem ManaProduction::CouldProduce{objects:One(Query{objects:CostObjects{payment:Activation, component:[1], view:Inputs, phase:Before}, index:0}), colors_only:true} */
paid_land_mana_color ::= "one" "mana" "of" "any" "color" "that" "land" "could" "produce"

paid_land_mana ::= paid_land_mana_type | paid_land_mana_color

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_tap, $cost_untap_tapped_land]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:$paid_land_mana}}]}} */
activated_untap_land_mana ::= cost_tap "," "↑" cost_untap_tapped_land ":" "add" paid_land_mana "."

/* The repeated object description is checked against the sacrifice payment by
   the enclosing activation; it is not an independently scoped antecedent. */
/* @sem $filter_phrase */
sacrificed_mana_description ::= "one" "mana" "of" "any" "type" "the" "sacrificed" filter_phrase "could" "produce"

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($filter_phrase, $sacrificed_mana_description)}, choose:Exactly(Constant(1))}]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:CouldProduce{objects:Earlier{what:Sacrificed}, colors_only:false}}}]}} */
activated_sacrifice_producible_mana_a ::= "sacrifice" "a" filter_phrase ":" "add" sacrificed_mana_description "."

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($filter_phrase, $sacrificed_mana_description)}, choose:Exactly(Constant(1))}]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:CouldProduce{objects:Earlier{what:Sacrificed}, colors_only:false}}}]}} */
activated_sacrifice_producible_mana_an ::= "sacrifice" "an" filter_phrase ":" "add" sacrificed_mana_description "."

/* The counted receipt is the sacrifice in the second activation-cost component;
   matching the two filters keeps the printed population tied to that producer. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[TapSymbol, Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($filter_plural, $filter_head)}, choose:AtLeast(Constant(1))}]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$choose_a_color}, Effect{result:@next, operation:AddMana{players:$players_singular, mana:Repeat{amount:Multiply([$value, CountObjects(CostObjects{payment:Activation, component:[1], view:Performed, phase:Before})]), production:Amount{color:Chosen, amount:Constant(1)}, choice:Once}}}]}} */
activated_sacrifice_chosen_mana ::= "{" "T" "}" "," "↑" "sacrifice" "one" "or" "more" filter_plural ":" choose_a_color "." players_singular "adds" value "mana" "of" "the" "chosen" "color" "for" "each" filter_head "sacrificed" "this" "way" "."

/* The activation cost fixes the receipt's component and its sacrificed object.
   The mana and spending qualification remain independently composable. */
/* @prefer always */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:ObjectProperty{object:Query{objects:CostObjects{payment:Activation, component:[1], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown}, production:$mana_production, choice:Once}} */
mana_from_activation_artifact_cost ::= "add" "an" "amount" "of" mana_production "equal" "to" "the" "sacrificed" "artifact's" "mana" "value"

/* @sem Instruction::[Effect{result:@next, operation:$mana_from_activation_artifact_cost}] */
mana_activation_artifact_clause ::= mana_from_activation_artifact_cost

/* @sem Vec<Instruction>::@restricted_mana($mana_activation_artifact_clause, $mana_spending) */
mana_activation_artifact_restricted ::= mana_activation_artifact_clause "." mana_spending

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[TapSymbol, Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Artifact)}, choose:Exactly(Constant(1))}]}, limits:_{}, announcement:@announcement, body:Program{instructions:$mana_activation_artifact_restricted}} */
ability_artifact_cost_mana ::= "{T}" "," "↑" "sacrifice" "an" "artifact" ":" mana_activation_artifact_restricted "."

/* @sem Instruction::[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:$mana_production, restriction:WhenSpent{spells:$spell_filter, body:Program($program)}}}] */
instructions_mana_spent_active ::= "add" mana_production "." "when" "you" "spend" "this" "mana" "to" "cast" spell_filter "," program

/* The passive subject refers to the mana just produced; the nested body is
   evaluated in the spending event and refers to that event's spell. */
/* @sem Instruction::[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:$mana_production, restriction:WhenSpent{spells:$spell_filter, body:Program($spent_spell_body)}}}] */
instructions_mana_spent_passive ::= "add" mana_production "." "when" "that" "mana" "is" "spent" "to" "cast" spell_filter "," spent_spell_body

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:May}}]} */
spent_spell_body ::= "copy" "that" "spell" "and" "you" "may" "choose" "new" "targets" "for" "the" "copy"

/* The spell color count is an independent current filter operand. */
/* @sem ObjectFilter::Property{property:ColorCount, test:NumberTest::Compare{comparison:Equal, value:$value}} */
spells_exact_color_count ::= "spells" "with" "exactly" value "colors"

/* A single creature payment and its property receipt are one contract. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $retirement_choice_creature_filter)}, choose:Exactly(Constant(1))}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:Repeat{amount:ObjectProperty{object:Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Inputs, phase:Before}, index:0}, property:$creature_stat, information:CurrentOrLastKnown}, production:$mana_production, choice:Once}, restriction:$mana_persists_combat}}]}, otherwise:Program{}}] */
optional_other_creature_payment_mana ::= "you" "may" "sacrifice" "another" retirement_choice_creature_filter "." "if" "you" "do" "," "add" "an" "amount" "of" mana_production "equal" "to" "the" "sacrificed" "creature's" creature_stat "." mana_persists_combat

/* A choice of player can supply the actor of a following third-person action. */
/* @sem Instruction::[Effect{result:@next, operation:$choice_tail_player}, Effect{result:@next, operation:$chosen_player_action}] */
instructions_chosen_player_action ::= choice_tail_player "of" "your" "choice" chosen_player_action

chosen_player_action ::= chosen_player_adds_mana

/* @sem Operation::AddMana{players:One(Chosen), mana:$mana_production} */
chosen_player_adds_mana ::= "adds" mana_production

/* The enclosing attack-batch trigger supplies the count being doubled. */
/* @sem ManaProduction::Repeat{amount:Multiply([Constant(2), EventAmount]), production:$mana_production, choice:Once} */
attack_batch_twice_mana ::= "twice" "that" "much" mana_production

/* @prefer always */
/* @sem Ability::Triggered{event:$event_creatures_attack, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:$attack_batch_twice_mana}}]}} */
attack_batch_twice_mana_trigger ::= "whenever" event_creatures_attack "," "add" attack_batch_twice_mana "."

/* @sem $mana_use_atom */
mana_use_later_atom ::= "to"? mana_use_atom

/* @sem $mana_use_activate_one */
mana_use_later_activate_one ::= "to" mana_use_activate_one

/* An anaphoric stat remains bound to its actual antecedent. Restrict this
   reusable phrase to stat wording; cost receipts need their own proof. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:$mana_equal_anaphoric_stat, production:$mana_production, choice:Once}} */
mana_add_equal_event_stat ::= "add" "an" "amount" "of" mana_production "equal" "to" mana_equal_anaphoric_stat

mana_equal_anaphoric_stat ::= value_power | value_toughness

/* The triggering event supplies the quantity; one color is chosen once. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:EventAmount, production:ChooseOne([Amount{color:White, amount:Constant(1)}, Amount{color:Blue, amount:Constant(1)}, Amount{color:Black, amount:Constant(1)}, Amount{color:Red, amount:Constant(1)}, Amount{color:Green, amount:Constant(1)}]), choice:Once}} */
mana_add_event_amount_one_color ::= "add" "that" "much" "mana" "of" "any" "one" "color"

/* The history quantity is independent of the mana produced and its spending restriction. */
/* @sem Expr::EventHistory{event:Player{event:Draws, players:One(AbilityController)}, window:ThisTurn, measure:Occurrences} */
mana_drawn_this_turn_count ::= "each" "card" "you've" "drawn" "this" "turn"

/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:$mana_drawn_this_turn_count, production:$mana_production, choice:Once}} */
mana_add_per_history ::= "add" mana_production "for" mana_drawn_this_turn_count

/* A commander is identified by its commander state in the casting restriction. */
/* @sem ObjectFilter::State(Commander) */
mana_commander_cast_filter ::= "your" "commander"

/* @sem ObjectFilter::State(HasX) */
mana_spells_with_x_cost ::= "spells" "with" "{" "X" "}" "in" "their" "mana" "costs"

/* @sem ManaUse::Purpose(Foretell) */
mana_use_foretell ::= "foretell" "a" "card" "from" "your" "hand"

/* @sem $filter_phrase */
mana_spent_counter_that_cast ::= "if" "that" "mana" "is" "spent" "to" "cast" "a" filter_phrase "spell"

/* @sem ManaUse::Purpose(TurnFaceUp($filter_plural)) */
mana_use_turn_plural_face_up ::= "turn" filter_plural "face" "up"

/* The affected spell is the one on which this mana was spent. */
/* @sem ManaUse::SpentGives{spells:$mana_spell_one, effects:[Term{family:SpellEffect, form:CantBeCountered}]} */
mana_spent_gives_uncounterable ::= "if" "that" "mana" "is" "spent" "on" mana_spell_one "," "that" "spell" "can't" "be" "countered"

/* Spending can trigger a program for either casting a spell or activating an ability. */
/* @sem Instruction::[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:$mana_production, restriction:WhenSpent{spells:$spell_filter, abilities:true, body:Program($spent_spell_or_ability_program)}}}] */
instructions_mana_spent_spell_or_ability ::= "add" mana_production "." "when" "you" "spend" "this" "mana" "to" "cast" spell_filter "or" "activate" "an" "ability" "," spent_spell_or_ability_program

spent_spell_or_ability_program ::= spent_stack_copy_program | spent_mana_draw_program

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$paid_success_draw}]} */
spent_mana_draw_program ::= paid_success_draw

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventStackObject, times:Constant(1), targets:May}}]} */
spent_stack_copy_program ::= "copy" "that" "spell" "or" "ability" "." "you" "may" "choose" "new" "targets" "for" "the" "copy"

/* @sem ObjectFilter::AllOf([$filter_phrase, State(NoAbilities)]) */
mana_spells_without_abilities ::= filter_phrase "spells" "with" "no" "abilities"

/* This operation is used only where the enclosing activation proves that the
   second cost component removes counters. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:PaidCountersRemoved{payment:Activation, component:[1]}, production:$mana_production, choice:Once}} */
paid_removal_that_much_mana ::= "add" "that" "much" mana_production

/* @sem Ability::Activated{origin:Ordinary, cost:_{parts:[TapSymbol, $cost_remove_at_least_counters]}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$paid_removal_that_much_mana}]}} */
activated_tap_counter_payment_mana ::= "{" "T" "}" "," "↑" cost_remove_at_least_counters ":" paid_removal_that_much_mana "."

/* The event supplies the quantity; each unit independently chooses a listed color. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:EventAmount, production:$mana_combination_pair, choice:EachUnit}} */
mana_add_event_combination ::= "add" "that" "much" "mana" "in" "any" "combination" "of" mana_combination_pair

/* @sem ManaProduction::ChooseOne([$mana_unit, $mana_unit_2]) */
mana_combination_pair ::= mana_unit "and" "/" "or" mana_unit

/* @sem Instruction::[Effect{result:@next, operation:AddMana{players:$players_singular, mana:Repeat{amount:CountObjects($affected), production:$mana_for_each_existing, choice:Once}}}] */
clause_player_adds_per_affected ::= players_singular "adds" mana_for_each_existing "for" affected

/* The graveyard belongs to the ability controller, not every player. */
/* @sem ObjectFilter::Cast{from:Players{zone:Graveyard, players:One(AbilityController)}} */
mana_spell_from_your_graveyard ::= "a" "spell" "from" "your" "graveyard"

/* A player's mana production and a separately measured damage event. */
/* @sem Instruction::[Effect{result:@next, operation:$add_mana_player}, Effect{result:@next, operation:$damage_to_event_player}] */
mana_player_and_event_damage ::= add_mana_player "," "and" damage_to_event_player

/* @sem Operation::DealDamage{source:$damage_source_ref, recipients:Players(One(@that_player)), amount:$number, preventable:true} */
damage_to_event_player ::= damage_source_ref "deals" number "damage" "to" "the" "player"

/* The named private graveyard belongs to the ability controller. */
/* @sem ObjectFilter::Cast{from:Players{zone:Graveyard, players:One(AbilityController)}} */
mana_spells_from_own_graveyard ::= "spells" "from" "your" "graveyard"

/* Different-color production composes with the existing spending contracts. */
/* @sem ManaProduction::DifferentColors(2) */
mana_two_different_colors ::= "two" "mana" "of" "different" "colors"

/* @sem Instruction::[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:$mana_two_different_colors}}] */
mana_distinct_clause ::= "add" mana_two_different_colors

/* @sem Vec<Instruction>::@restricted_mana($mana_distinct_clause, $mana_spending) */
mana_distinct_clause_restricted ::= mana_distinct_clause "." mana_spending

/* The spending event supplies the spell subject for the resolution action. */
/* @sem Instruction::[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:$mana_production, restriction:WhenSpent{spells:$spell_filter, body:Program($spent_event_program)}}}] */
instructions_mana_spent_active_event ::= "add" mana_production "." "when" "you" "spend" "this" "mana" "to" "cast" spell_filter "," spent_event_program

/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$spent_event_resolving_exile}]}}]} */
spent_event_program ::= "you" "may" spent_event_resolving_exile

/* @sem Operation::EffectOn{subject:Objects(One(EventSubject)), effects:[Term{family:SpellEffect, form:AsResolves, operands:[List([Term{family:ResolveAction, form:ExileResolvingSpell}])]}]} */
spent_event_resolving_exile ::= "exile" "that" "spell" "instead" "of" "putting" "it" "into" "its" "owner's" "graveyard" "as" "it" "resolves"
