/* Numbers and amounts. */
number ::= number_digits | number_words | number_x | number_x_plus

/* @sem Expr::Add(Expr::AnnouncedX, $number_digits) */
number_x_plus ::= "X" "plus" number_digits

/* Oracle spells out card counts and writes damage and life in digits. */
count ::= number_words | number_digits | number_x

/* @sem Expr::Constant($number) */
number_digits ::= NUMBER

/* @sem Expr::AnnouncedX */
number_x ::= "X"

/* A spelled count more than one. */
count_plural ::= n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10 | n11 | n12 | n13 | n14 | n15 | n20 | n30

number_words ::= n1 | n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10 | n11 | n12 | n13 | n14 | n15 | n20 | n30 | number_hundred

/* @sem Expr::Constant(1) */
n1 ::= "one"
/* @sem Expr::Constant(2) */
n2 ::= "two"
/* @sem Expr::Constant(3) */
n3 ::= "three"
/* @sem Expr::Constant(4) */
n4 ::= "four"
/* @sem Expr::Constant(5) */
n5 ::= "five"
/* @sem Expr::Constant(6) */
n6 ::= "six"
/* @sem Expr::Constant(7) */
n7 ::= "seven"
/* @sem Expr::Constant(8) */
n8 ::= "eight"
/* @sem Expr::Constant(9) */
n9 ::= "nine"
/* @sem Expr::Constant(10) */
n10 ::= "ten"
/* @sem Expr::Constant(11) */
n11 ::= "eleven"
/* @sem Expr::Constant(12) */
n12 ::= "twelve"
/* @sem Expr::Constant(13) */
n13 ::= "thirteen"
/* @sem Expr::Constant(14) */
n14 ::= "fourteen"
/* @sem Expr::Constant(15) */
n15 ::= "fifteen"
/* @sem Expr::Constant(20) */
n20 ::= "twenty"

card_count ::= card_count_multiplied | card_count_prior_plus | card_count_additional_each | card_count_one | card_count_many | card_count_additional | card_count_that_many | card_count_each | card_count_each_many | card_count_equal | card_count_half

/* @sem Expr::Constant(1) */
card_count_one ::= ("a" | "one" | "an" "additional") "card"

/* @sem $count */
card_count_additional ::= count "additional" "cards"

/* @sem $count */
card_count_many ::= count "cards"

/* @sem @that_many */
card_count_that_many ::= "that" "many" "cards"

/* @sem $count_each */
card_count_each ::= ("a" | "one") "card" "for" "each" count_each

/* @sem @times($count, $count_each) */
card_count_each_many ::= count "cards" "for" "each" count_each

/* @sem $value */
card_count_equal ::= "cards" "equal" "to" value

/* @sem Expr::Divide{numerator:$value_atom, denominator:Expr::Constant(2), rounding:$rounding_words} */
card_count_half ::= "half" value_atom "cards" "," rounding_words

count_each ::= count_each_population_sum | count_each_counter_population_sum | count_each_kind_among_population | count_each_different_power | count_each_devoured | count_each_players_drew | count_each_vote | count_each_self_attack_game | count_each_you_sacrificed_types | count_each_object_counter | count_each_player_counter | mined_each | count_each_commander_cast | count_each_discarded_turn | count_each_type_cast | count_each_opponent_fewer | count_each_party | count_each_permanent | count_each_other | count_each_hand | count_each_graveyard | count_each_card_hand | count_each_card_graveyard | count_each_destroyed | count_each_tapped | count_each_discarded | count_each_discarded_any | count_each_discarded_event | count_each_exiled_any | count_each_revealed_any | count_each_died | count_each_put_into_your_graveyard | count_each_land_type | count_each_color_among | count_each_color_spent | count_each_time_kicked | count_each_counter_on | count_each_attacked | count_each_you_attacked_with | count_each_spell_cast_history | count_each_attacking_you | count_each_chosen_type | count_each_damaged_opponent | count_each_opponents_graveyards | count_each_cycling_graveyard | count_each_opponents_life_lost | count_each_opponents_cards_drawn | count_each_urzas_controlled | count_each_exile_opponents_owned | count_each_exile_foretold_owned | count_each_exile_linked | count_each_attacked_player | count_each_counters_you_put_controlled | count_each_tapped_three_kinds | count_each_players_entered | count_each_cycled_or_discarded | count_each_distinct_among_battlefield | count_each_creature_types_among | count_each_filtered_exile_linked | count_each_filtered_library | count_each_distinct_mana_values | count_each_any_cast_excluding_origin | count_each_spell_cast_excluding_origin | count_each_different_mana_values | count_each_affected_counter | count_each_sticker_names | count_each_lost_players | count_each_completed_dungeon | count_each_opponents_could_produce_colorless | count_each_crew_subject | count_each_card_plural_zone | count_each_attacked_player_history | count_each_live_population_pair | count_each_linked_name | count_each_name_sticker | count_each_qualified_players | count_each_combat_sources | count_each_opponent_damaged_turn | count_each_even_die | count_each_opponent_did | count_each_phased_creature | count_each_controlled_departure | count_each_player_life_history

/* @sem Expr::Add($count_controlled_other, $count_live_graveyard) */
count_each_population_sum ::= count_controlled_other "and" "each" count_live_graveyard
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([ControlledBy(One(AbilityController)), Not(SameObject(Source)), $filter_phrase])}) */
count_controlled_other ::= "other" filter_phrase "you" "control"
count_live_graveyard ::= count_each_graveyard | count_each_card_graveyard

/* @sem Expr::Add($count_counters_on_players, $count_counters_on_population) */
count_each_counter_population_sum ::= "counter" "among" count_counters_on_players "and" count_counters_on_population
/* @sem Expr::CountCounters(_{recipients:Players(All), information:CurrentOrLastKnown}) */
count_counters_on_players ::= "players"
/* @sem Expr::CountCounters(_{recipients:Objects($counter_battlefield_population), information:CurrentOrLastKnown}) */
count_counters_on_population ::= counter_battlefield_population

/* @sem Expr::EventHistory{event:$commander_cast_history, window:ThisGame, measure:Occurrences} */
count_each_commander_cast ::= "time" commander_cast_history
/* @sem EventSpec::Filtered{event:Spell{event:Cast, players:One(AbilityController), spells:State(Commander)}, condition:WasCastFrom{object:EventSubject, zone:Command}} */
commander_cast_history ::= "you've" "cast" ("a" | "your") "commander" "from" "the" "command" "zone" "this" "game"

/* @sem $discarded_this_turn */
count_each_discarded_turn ::= "card" discarded_this_turn

/* @sem Expr::EventHistory{event:Discard{players:One(PlayerRef::AbilityController), cards:Any, kind:Any, grouping:Card}, window:ThisTurn, measure:Occurrences} */
discarded_this_turn ::= "you've" "discarded" "this" "turn"

/* @sem $discarded_this_turn */
value_cards_discarded ::= "the" "number" "of" "cards" discarded_this_turn

/* @sem Expr::EventHistory{event:Spell{event:Cast, players:All, spells:Cast{by:One(PlayerRef::AbilityController)}}, window:ThisTurn, measure:Distinct(CardTypes)} */
count_each_type_cast ::= "card" "type" "among" "spells" "you've" "cast" "this" "turn"

/* @sem Expr::CountPlayers(Matching{binding:0, condition:Compare{left:Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(Bound(0))))}), test:NumberTest::Compare{comparison:Less, value:Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController)))})}}}) */
count_each_opponent_fewer ::= "opponent" "who" "controls" "fewer" filter_plural "than" "you"

/* @sem Expr::PartySize(AbilityController) */
count_each_party ::= "creature" "in" "your" "party"

/* @sem Expr::CountObjects(Matching{objects:Transition{result:@prior, phase:After}, filter:$card_filter}) */
count_each_discarded ::= card_filter "card" "discarded" "this" "way"
/* Every card discarded this way, counted as the cards it took from the hand. */
/* @sem Expr::CountObjects(Transition{result:@prior, phase:Before}) */
count_each_discarded_any ::= "card" "discarded" "this" "way"
/* A direct discard trigger's first effect can count its triggering batch;
   an earlier discard action keeps the separate transition-receipt reading. */
/* @sem Expr::@discard_event_amount */
count_each_discarded_event ::= "card" "discarded" "this" "way"
/* Every card exiled this way, counted as the cards the move took. */
/* @sem Expr::CountObjects(Transition{result:@prior, phase:Before}) */
count_each_exiled_any ::= "card" "exiled" "this" "way"
/* Every card revealed this way, counted as the cards chosen for the reveal. */
/* @sem Expr::CountObjects(Selected(@marked)) */
count_each_revealed_any ::= "card" "revealed" "this" "way"

/* @sem Expr::EventHistory{event:ZoneChange{objects:$filter_phrase, from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Occurrences} */
count_each_died ::= filter_phrase "that" "died" "this" "turn"
/* "For each creature put into your graveyard from the battlefield this turn": every
   such move counts, by the card's owner. */
/* @sem Expr::EventHistory{event:ZoneChange{objects:@and($filter_phrase, ObjectFilter::OwnedBy(One(PlayerRef::AbilityController))), from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Occurrences} */
count_each_put_into_your_graveyard ::= filter_phrase "put" "into" "your" "graveyard" "from" "the" "battlefield" "this" "turn"

/* @sem Expr::CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, property:BasicLandTypes} */
count_each_land_type ::= "basic" "land" "type" "among" filter_plural

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}) */
count_each_permanent ::= filter_phrase ("on" "the" "battlefield")?

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@pump_other_ref(ObjectRef::@it))), $other_count_filter)}) */
count_each_other ::= "other" other_count_filter

/* Keep the original generic phrase without a battlefield suffix. The extra
   explicit suffix is proved only for creature/subtype nouns in this family. */
other_count_filter ::= filter_phrase | other_battlefield_count_filter
/* @sem $other_battlefield_count_noun */
other_battlefield_count_filter ::= other_battlefield_count_noun "on" "the" "battlefield"
other_battlefield_count_noun ::= noun_creature | subtype

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Hand, players:One($zone_owner)}, kind:Card, filter:Any}) */
count_each_card_hand ::= "card" "in" zone_owner "hand"

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One($zone_owner)}, kind:Card, filter:Any}) */
count_each_card_graveyard ::= "card" "in" zone_owner "graveyard"

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Hand, players:One($zone_owner)}, kind:Card, filter:$card_filter}) */
count_each_hand ::= card_filter "card" "in" zone_owner "hand"

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One($zone_owner)}, kind:Card, filter:$card_filter}) */
count_each_graveyard ::= card_filter "card" "in" zone_owner "graveyard"

/* @sem Expr::CountObjects(Matching{objects:Transition{result:@prior, phase:Before}, filter:$filter_phrase}) */
count_each_destroyed ::= filter_phrase "destroyed" "this" "way"
/* Every creature tapped this way, counted as the creatures the tap took. */
/* @sem Expr::CountObjects(Transition{result:@prior, phase:Before}) */
count_each_tapped ::= "creature" "tapped" "this" "way"

/* What a card can be, away from the battlefield. `permanent` narrows nothing on the
   battlefield, but among cards it excludes instants and sorceries. */
card_filter ::= mined_cards | card_word | card_stacked | card_stacked_comma | card_stacked_either | card_stacked_type | card_or | card_list | card_filter_and | card_qualified_three | card_union_repeated_plural | card_named_or_an

card_word ::= quality | card_noun | spell_instant | spell_sorcery

card_noun ::= noun_outlaw | noun_creature | noun_artifact | noun_enchantment | noun_land | noun_planeswalker
    | noun_token | noun_battle | subtype | card_permanent

/* The one word for every permanent type outranks writing the types out. */
/* @prefer always */
/* @sem ObjectFilter::AnyOf([ObjectFilter::CardType(Artifact), ObjectFilter::CardType(Battle), ObjectFilter::CardType(Creature), ObjectFilter::CardType(Enchantment), ObjectFilter::CardType(Land), ObjectFilter::CardType(Planeswalker)]) */
card_permanent ::= "permanent"

/* @sem @and($quality, $card_filter) */
card_stacked ::= quality card_filter

/* @sem @and($quality, $card_filter) */
card_stacked_comma ::= quality "," card_filter

/* @sem @and(ObjectFilter::AnyOf([$quality, $quality_2]), $card_word) */
card_stacked_either ::= quality "or" quality card_word

/* @sem @and($card_noun, $card_noun_2) */
card_stacked_type ::= card_noun card_noun

/* @sem ObjectFilter::AnyOf([$card_word, $card_word_2]) */
card_or ::= card_word union_or card_word

/* Three or more kinds in a list: "a Knight, Aura, Equipment, or legendary artifact
   card". The last kind may be stacked. */
/* @sem ObjectFilter::AnyOf([...$card_commas, $card_list_item]) */
card_list ::= card_commas union_or card_list_item

card_commas ::= card_commas_more | card_commas_last

/* @sem ObjectFilter::[$card_word, ...$card_commas] */
card_commas_more ::= card_word "," card_commas

/* @sem ObjectFilter::[$card_word, $card_word_2] */
card_commas_last ::= card_word "," card_word ","

card_list_item ::= card_word | card_stacked

/* @sem ObjectFilter::AnyOf([$card_word, $card_word_2]) */
card_filter_and ::= card_word "and" card_word

zone_owner ::= zone_your | zone_their | zone_that_player | zone_its_controller | zone_chosen_player

/* One player whose library or graveyard is named: yours, an event's, a target's or
   the defending player's. */
player_possessive ::= zone_owner | target_possessive | possessive_defending

/* @sem PlayerRef::Chosen */
zone_chosen_player ::= "the" "chosen" "player's"

/* @sem PlayerRef::ControllerOf(@it) */
zone_its_controller ::= "its" "controller's"

/* @sem PlayerRef::AbilityController */
zone_your ::= "your"
/* @sem @that_player */
zone_their ::= "their"
/* @sem @that_player */
zone_that_player ::= "that" "player's"

/* "Target player's" or "target opponent's" announces the one player whose hand,
   library or graveyard is named. */
target_possessive ::= possessive_target_player | possessive_target_opponent
/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Expr::Constant(1)), filter:Any, players:All}), index:0} */
possessive_target_player ::= "target" "player's"
/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Expr::Constant(1)), filter:Any, players:OpponentsOf(PlayerRef::AbilityController)}), index:0} */
possessive_target_opponent ::= "target" "opponent's"
/* @sem PlayerRef::@defending */
possessive_defending ::= "defending" "player's"

life_phrase ::= life_amount | life_half | life_per_chosen_color

/* Every life amount except half the player's own life. */
life_amount ::= life_equal_history | life_craft_card_stat | life_number | life_that_much | life_each | life_equal | life_half_your | life_twice | life_per_player | life_product | life_caused_events

/* @sem @times(Expr::Constant(2), $life_phrase) */
life_twice ::= "twice" life_phrase

/* @sem Expr::Divide{numerator:Expr::PlayerNumber{player:@that_player, number:Life}, denominator:Expr::Constant(2), rounding:$rounding_words} */
life_half ::= "half" "their" "life" "," rounding_words

/* @sem Expr::Divide{numerator:Expr::PlayerNumber{player:PlayerRef::AbilityController, number:Life}, denominator:Expr::Constant(2), rounding:$rounding_words} */
life_half_your ::= "half" "your" "life" "," rounding_words

rounding_words ::= rounded_up | rounded_down

/* @sem Rounding::Up */
rounded_up ::= "rounded" "up"
/* @sem Rounding::Down */
rounded_down ::= "rounded" "down"

/* @sem $value */
life_equal ::= "life" "equal" "to" value

/* @sem $number */
life_number ::= number "life"

/* @sem @that_much */
life_that_much ::= "that" "much" "life"

/* @sem @times($number, $count_each) */
life_each ::= number "life" "for" "each" count_each

/* Values a sentence can be equal to. */
value ::= value_greater | value_atom | value_sum | value_difference

/* @sem Expr::Add($value_atom, $value) */
value_sum ::= value_atom "plus" value

/* @sem Expr::Subtract($value_atom, $value) */
value_difference ::= value_atom "minus" value

value_constant ::= number_digits | number_words | number_x

value_atom ::= value_number_they_control | shared_literal_fold_fbbc6baeec88 | value_draft_removed_named | value_discarded_by_player | value_die_result | value_cast_since_last_turn | value_chosen_creature_population | value_shared_countered | value_shared_other_four_subtypes | value_shared_saga_mana | value_times_mutated | value_your_life | mined_value | value_constant | value_number_of | value_power | value_toughness | value_mana_value | value_that_card_stat | value_revealed_card_stat | value_discarded_card_stat | value_powers_among | value_your_speed | value_that_much | value_twice | value_number_cards | value_life_lost | value_life_gained_turn | value_mana_spent | value_sacrificed | value_sacrificed_result | value_stat_of | value_number_on_battlefield | value_number_other | value_greatest | value_greatest_pair | value_colors_among | value_land_types_among | value_card_types | value_devotion | value_party | value_number_died | value_half | value_damage_dealt | value_self_stat | value_self_loyalty | value_power_of_target | value_damage_already | value_cards_drawn | value_cards_discarded | value_died_yours | value_entered_yours | value_sacrificed_count | value_noun_stat | value_turns_begun | value_excess | value_colors_spent | value_damage_to_you | value_life_lost_all | value_damage_already_it | value_as_cast | value_destroyed_yours | value_died_this_way | value_revealed_this_way | value_spells_cast_by | value_total_population | value_total_mana_other_cast | value_counters_on_object | value_all_counters_on_object | value_player_counters | value_opponents | value_created_stat | value_differently_named | value_spells_you_cast | value_tokens_created | value_kind_counters_on_population | value_counters_among_population | value_starting_life | value_target_creature_possessive_stat | value_damaged_opponents | value_snow_mana_spent | value_opponents_attacked_turn | value_life_at_turn_beginning | value_cards_cycled_or_discarded | value_self_intensity | value_object_intensity | value_number_put_graveyards | value_battlefield_keyword_count | value_total_number_cards | value_greatest_populations | value_controlled_population | value_damage_his_power | value_damage_its_intensity | value_chosen_die_result | value_qualified_players | value_owned_controlled_you | value_opponents_owned_controlled_opponents | value_owned_controlled_opponents

/* Live objects and cast-event history are different populations. */
/* @sem Expr::Aggregate{objects:$greatest_population, property:$stat, aggregation:Sum} */
value_total_population ::= "the" "total" stat "of" greatest_population

/* @sem Expr::EventHistory{event:Spell{event:Cast, players:All, spells:@and(ObjectFilter::Not(SameObject(Source)), ObjectFilter::Cast{by:One(AbilityController)})}, window:ThisTurn, measure:Property(ManaValue, Sum)} */
value_total_mana_other_cast ::= "the" "total" "mana" "value" "of" "other" "spells" "you've" "cast" "this" "turn"

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}) */
value_number_of ::= "the" "number" "of" filter_plural

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}) */
value_number_on_battlefield ::= "the" "number" "of" filter_plural "on" "the" "battlefield"

/* @sem Expr::@its_stat(Expr::ObjectProperty{object:@it, property:Power, information:CurrentOrLastKnown}) */
value_power ::= "its" "power"

/* @sem Expr::@its_stat(Expr::ObjectProperty{object:@it, property:Toughness, information:CurrentOrLastKnown}) */
value_toughness ::= "its" "toughness"

/* @sem Expr::ObjectProperty{object:@move_after_property(ObjectRef::@it), property:ManaValue, information:CurrentOrLastKnown} */
value_mana_value ::= "its" "mana" "value"

/* "That card" is the one card the instruction just before revealed, discarded,
   exiled, moved or paid. With no such producer it names nothing. */
/* @sem Expr::ObjectProperty{object:ObjectRef::@card_receipt, property:$receipt_stat, information:CurrentOrLastKnown} */
value_that_card_stat ::= "that" "card's" receipt_stat
/* "The revealed card" and "the discarded card" name only a reveal's or a discard's card. */
/* @sem Expr::ObjectProperty{object:ObjectRef::@revealed_card_receipt, property:$receipt_stat, information:CurrentOrLastKnown} */
value_revealed_card_stat ::= "the" "revealed" "card's" receipt_stat
/* @sem Expr::ObjectProperty{object:ObjectRef::@discarded_card_receipt, property:$receipt_stat, information:CurrentOrLastKnown} */
value_discarded_card_stat ::= "the" "discarded" "card's" receipt_stat
receipt_stat ::= stat_power | stat_toughness | stat_mana_value

/* A requested single token can become several through replacement effects.
   Its characteristic measures the produced batch, not an arbitrary first token. */
/* @sem Expr::Aggregate{objects:$created_stat_possessive, property:$stat, aggregation:Sum} */
value_created_stat ::= created_stat_possessive stat

created_stat_possessive ::= created_stat_implicit | created_stat_named
/* @sem ObjectSet::@created_reference_single */
created_stat_implicit ::= "its"
/* @sem ObjectSet::@created_named_reference */
/* @prefer value(Created) */
created_stat_named ::= ("that" | "the") "token's"

/* @sem @that_much */
value_that_much ::= "that" "much"

/* @sem @times(Expr::Constant(2), $value) */
value_twice ::= "twice" value

/* @sem Expr::CountObjects($card_population) */
value_number_cards ::= "the" "number" "of" card_population

card_population ::= card_population_stickered_vowel | card_population_stickered_consonant | card_population_plain | card_population_filtered | card_population_named | card_population_cycling | card_population_same_name | card_population_linked | card_population_linked_any
/* @sem ObjectSet::Zone{scope:$card_zone_scope, kind:Card, filter:Any} */
card_population_plain ::= "cards" "in" card_zone_scope
/* @sem ObjectSet::Zone{scope:$card_zone_scope, kind:Card, filter:$card_filter} */
card_population_filtered ::= card_filter "cards" "in" card_zone_scope
/* @sem ObjectSet::Zone{scope:$card_zone_scope, kind:Card, filter:Name(@card_name)} */
card_population_named ::= "cards" "named" SELF_NAME "in" card_zone_scope
/* @sem ObjectSet::Zone{scope:$card_zone_scope, kind:Card, filter:HasActivatedAbility(Cycling)} */
card_population_cycling ::= "cards" "with" "a" "cycling" "ability" "in" card_zone_scope
/* @sem ObjectSet::Zone{scope:$card_zone_scope, kind:Card, filter:SharesNameWith(@it)} */
card_population_same_name ::= "cards" "in" card_zone_scope "with" "the" "same" "name" "as" "that" "spell"

/* A linked exile population names its anchor explicitly. Costs that merely
   exile cards do not silently become source-linked permanent queries. */
/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:@and(ObjectFilter::ExiledWith($object_ref), $card_filter)} */
card_population_linked ::= card_filter "cards" "exiled" "with" object_ref

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)} */
card_population_linked_any ::= "cards" "exiled" "with" object_ref

/* The cards of one player's named zone, or of every player's graveyard or hand. */
card_zone_scope ::= card_zone_one | card_zone_all_graveyards | card_zone_all_hands
/* @sem ZoneScope::Players{zone:$greatest_card_zone, players:One($player_possessive)} */
card_zone_one ::= player_possessive greatest_card_zone
/* @sem ZoneScope::Players{zone:Graveyard, players:All} */
card_zone_all_graveyards ::= "all" "graveyards"
/* @sem ZoneScope::Players{zone:Hand, players:All} */
card_zone_all_hands ::= "all" "players'" "hands"

/* @sem Expr::Performed(@prior) */
value_life_lost ::= "the" "life" "lost" "this" "way"

/* "Where X is the amount of life you gained this turn": the total, not the occasions. */
/* @sem Expr::EventHistory{event:Player{event:GainsLife, players:One(PlayerRef::AbilityController)}, window:ThisTurn, measure:TotalAmount} */
value_life_gained_turn ::= "the" "amount" "of" "life" "you" "gained" "this" "turn"

/* @sem Expr::ManaSpent{object:$spent_spell, filter:SpentManaFilter{}, aggregation:Count} */
value_mana_spent ::= "the" "amount" "of" "mana" "spent" "to" "cast" spent_spell

/* Naming the sacrificed creature makes it the object a later "its" reads. */
/* @sem Expr::ObjectProperty{object:@remember_object(ObjectRef::Query{objects:CostObjects{payment:Activation, component:[@cost_index], view:Inputs, phase:Before}, index:0}), property:$stat, information:CurrentOrLastKnown} */
value_sacrificed ::= "the" "sacrificed" noun_word stat

/* A resolution sacrifice ("If you do" payment or "When you do" receipt) names
   its one object's information before the action. */
/* @sem Expr::ObjectProperty{object:@sacrificed_object, property:$stat, information:CurrentOrLastKnown} */
value_sacrificed_result ::= "the" "sacrificed" noun_word stat

/* @sem Expr::ObjectProperty{object:$it_possessive, property:$stat, information:CurrentOrLastKnown} */
value_stat_of ::= it_possessive stat

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@pump_other_ref(ObjectRef::@it))), $filter_plural)}) */
value_number_other ::= "the" "number" "of" "other" filter_plural

/* Property and population are independent. Card-zone ownership must not turn
   into battlefield control, and other excludes the enclosing ability's object. */
/* @sem Expr::Aggregate{objects:$greatest_population, property:$stat, aggregation:Maximum} */
value_greatest ::= "the" "greatest" stat "among" greatest_population

/* @sem Expr::Maximum(Aggregate{objects:$greatest_population, property:$stat, aggregation:Maximum}, Aggregate{objects:$greatest_population, property:$stat_2, aggregation:Maximum}) */
value_greatest_pair ::= "the" "greatest" stat "and/or" stat "among" greatest_population

greatest_population ::= craft_exiled_cards | greatest_battlefield | greatest_other_battlefield | card_population | greatest_exile_cards
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural} */
greatest_battlefield ::= filter_plural
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(SameObject(@it)), $filter_plural)} */
greatest_other_battlefield ::= "other" filter_plural
greatest_card_zone ::= greatest_hand | greatest_graveyard | greatest_library
/* @sem ZoneName::Hand */
greatest_hand ::= "hand"
/* @sem ZoneName::Graveyard */
greatest_graveyard ::= "graveyard"
/* @sem ZoneName::Library */
greatest_library ::= "library"

/* @sem Expr::CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, property:Colors} */
value_colors_among ::= "the" "number" "of" "colors" "among" filter_plural

/* @sem Expr::CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, property:Powers} */
value_powers_among ::= "the" "number" "of" "different" "powers" "among" filter_plural

/* @sem Expr::PlayerNumber{player:AbilityController, number:Speed} */
value_your_speed ::= "your" "speed"

/* @sem Expr::CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, property:BasicLandTypes} */
value_land_types_among ::= "the" "number" "of" "basic" "land" "types" "among" filter_plural

/* @sem Expr::CountDistinct{objects:$card_types_population, property:CardTypes} */
value_card_types ::= "the" "number" "of" "card" "types" "among" card_types_population

/* @sem Expr::CountManaSymbols{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:ControlledBy(One(PlayerRef::AbilityController))}, colors:[$devotion_color]} */
value_devotion ::= "your" "devotion" "to" devotion_color

devotion_color ::= dc_chosen | dc_white | dc_blue | dc_black | dc_red | dc_green

/* @sem ManaColor::White */
dc_white ::= "white"
/* @sem ManaColor::Blue */
dc_blue ::= "blue"
/* @sem ManaColor::Black */
dc_black ::= "black"
/* @sem ManaColor::Red */
dc_red ::= "red"
/* @sem ManaColor::Green */
dc_green ::= "green"

/* @sem Expr::PartySize(AbilityController) */
value_party ::= "the" "number" "of" "creatures" "in" "your" "party"

/* @sem Expr::EventHistory{event:ZoneChange{objects:$filter_plural, from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Occurrences} */
value_number_died ::= "the" "number" "of" filter_plural "that" "died" "this" "turn"

/* @sem Expr::Divide{numerator:$value_atom, denominator:Expr::Constant(2), rounding:$rounding_words} */
value_half ::= "half" value_atom "," rounding_words

/* @sem Expr::Performed(@prior) */
value_damage_dealt ::= "the" "damage" "dealt" "this" "way"

it_possessive ::= named_possessive | spell_possessive

named_possessive ::= named_creature_possessive | named_other_possessive

/* The existing words retain creature provenance through direct/snapshot X. */
/* @sem ObjectRef::@activation_creature_property(ObjectRef::@qualified_object(ObjectKind::Permanent, ObjectFilter::CardType(Creature))) */
named_creature_possessive ::= "that" "creature's"

/* @sem ObjectRef::@named_object */
named_other_possessive ::= "that" ("artifact's" | "enchantment's" | "land's" | "permanent's" | "planeswalker's")

/* @sem ObjectRef::@qualified_object(ObjectKind::Spell, ObjectFilter::Any) */
spell_possessive ::= "that" "spell's"

/* @sem () */
noun_word ::= "creature's" | "artifact's" | "enchantment's" | "land's" | "permanent's"

/* @sem Expr::ObjectProperty{object:$self_possessive, property:$stat, information:CurrentOrLastKnown} */
value_self_stat ::= self_possessive stat
/* @sem Expr::ObjectProperty{object:$self_possessive, property:Loyalty, information:CurrentOrLastKnown} */
value_self_loyalty ::= self_possessive "loyalty"

self_possessive ::= holder_possessive_ref | named_possessive_ref

/* @sem ObjectRef::@self */
holder_possessive_ref ::= holder_possessive

/* @prefer value(GrantingObject) */
/* @sem ObjectRef::@named_source */
named_possessive_ref ::= self_named "'s"

/* The card's own noun, possessive. */
holder_possessive ::= holder_creature_possessive | holder_artifact_possessive | holder_enchantment_possessive | holder_land_possessive | holder_permanent_possessive | holder_token_possessive | holder_vehicle_possessive | holder_equipment_possessive

/* @prefer type(Creature) */
/* @sem () */
holder_creature_possessive ::= "this" "creature's"
/* @prefer type(Artifact) */
/* @sem () */
holder_artifact_possessive ::= "this" "artifact's"
/* @prefer type(Enchantment) */
/* @sem () */
holder_enchantment_possessive ::= "this" "enchantment's"
/* @prefer type(Land) */
/* @sem () */
holder_land_possessive ::= "this" "land's"
/* @sem () */
holder_permanent_possessive ::= "this" "permanent's"
/* @prefer type(Token) */
/* @sem () */
holder_token_possessive ::= "this" "token's"

/* @sem Expr::ObjectProperty{object:$object_ref, property:$stat, information:CurrentOrLastKnown} */
value_power_of_target ::= "the" stat "of" object_ref

/* @sem Expr::EventHistory{event:Damage(DamageEvent{source_kind:Any, sources:Any, recipients:Players(One(@that_player)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:TotalAmount} */
value_damage_already ::= "the" "damage" "already" "dealt" "to" "that" "player" "this" "turn"

/* @sem Expr::EventHistory{event:Player{event:Draws, players:One($history_draw_actor)}, window:ThisTurn, measure:Occurrences} */
value_cards_drawn ::= "the" "number" "of" "cards" history_draw_actor "drawn" "this" "turn"

/* @sem Expr::EventHistory{event:ZoneChange{objects:@and($filter_plural, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController))), from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Occurrences} */
value_died_yours ::= "the" "number" "of" filter_plural "that" "died" "under" "your" "control" "this" "turn"
/* @sem Expr::EventHistory{event:ZoneChange{objects:@and($filter_plural, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController))), to:Battlefield}, window:ThisTurn, measure:Occurrences} */
value_entered_yours ::= "the" "number" "of" filter_plural "that" "entered" "the" "battlefield" "under" "your" "control" "this" "turn"

/* @sem Expr::EventHistory{event:Player{event:Sacrifices, players:One(PlayerRef::AbilityController), objects:$filter_plural}, window:ThisTurn, measure:Occurrences} */
value_sacrificed_count ::= "the" "number" "of" filter_plural "you've" "sacrificed" "this" "turn"

/* @sem Expr::ObjectProperty{object:@named_object, property:$stat, information:CurrentOrLastKnown} */
value_noun_stat ::= "the" noun_word stat

/* @sem Expr::PlayerNumber{player:AbilityController, number:TurnsBegun} */
value_turns_begun ::= "the" "number" "of" "turns" "you" "have" "begun"

/* @sem Expr::ExcessDamage{result:@prior, to:Any} */
value_excess ::= "the" "excess" "damage" "dealt" "this" "way"

/* @sem Expr::ManaSpent{object:Source, filter:SpentManaFilter{}, aggregation:DistinctColors} */
value_colors_spent ::= "the" "number" "of" "colors" "of" "mana" "spent" "to" "cast" "this" "spell"

/* @sem Expr::EventHistory{event:Damage(DamageEvent{source_kind:Any, sources:Any, recipients:Players(One(PlayerRef::AbilityController)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:TotalAmount} */
value_damage_to_you ::= "the" "damage" "dealt" "to" "you" "this" "turn"

/* @sem Expr::Maximum($value_atom, $value_atom_2) */
value_greater ::= value_atom "or" value_atom "," "whichever" "is" "greater"

/* @sem Expr::EventHistory{event:Player{event:LosesLife, players:All}, window:ThisTurn, measure:TotalAmount} */
value_life_lost_all ::= "the" "total" "life" "lost" "by" "all" "players" "this" "turn"

/* @sem Expr::EventHistory{event:Damage(DamageEvent{source_kind:Any, sources:Any, recipients:Objects(SameObject(@it)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:TotalAmount} */
value_damage_already_it ::= "the" "damage" "already" "dealt" "to" "it" "this" "turn"

/* The IR reads this number on resolution, not as the spell was cast. */
/* @sem $value_number_on_battlefield */
value_as_cast ::= value_number_on_battlefield "as" "you" "cast" "this" "spell"

/* @sem Expr::CountObjects(Matching{objects:Transition{result:@prior, phase:Before}, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController)))}) */
value_destroyed_yours ::= "the" "number" "of" filter_plural "you" "controlled" "that" "were" "destroyed" "this" "way"

/* @sem Expr::CountObjects(Matching{objects:Transition{result:@prior, phase:Before}, filter:$filter_plural}) */
value_died_this_way ::= "the" "number" "of" filter_plural "that" "died" "this" "way"
/* @sem Expr::CountObjects(Selected(@marked)) */
value_revealed_this_way ::= "the" "number" "of" "cards" "revealed" "this" "way"

/* @sem Expr::EventHistory{event:Spell{event:Cast, players:One(@that_player), spells:$spell_adjectives}, window:ThisTurn, measure:Occurrences} */
value_spells_cast_by ::= "the" "number" "of" spell_adjectives "spells" "they've" "cast" "this" "turn"

/* @sem Expr::PlayerNumber{player:PlayerRef::AbilityController, number:Life} */
value_your_life ::= "your" "life" "total"

/* Adjacent integer alternatives are an inclusive interval. An arbitrary
   nonadjacent disjunction is not a range: one or three must not permit two. */
target_adjacent_range ::= target_range_one_two | target_range_two_three | target_range_three_four | target_range_four_five
/* @sem Count::Between{minimum:Constant(1), maximum:Constant(2)} */
target_range_one_two ::= ("one" | "1") "or" ("two" | "2")
/* @sem Count::Between{minimum:Constant(2), maximum:Constant(3)} */
target_range_two_three ::= ("two" | "2") "or" ("three" | "3")
/* @sem Count::Between{minimum:Constant(3), maximum:Constant(4)} */
target_range_three_four ::= ("three" | "3") "or" ("four" | "4")
/* @sem Count::Between{minimum:Constant(4), maximum:Constant(5)} */
target_range_four_five ::= ("four" | "4") "or" ("five" | "5")

/* Player counters are not counters on the source or on permanents. */
/* @sem Expr::CountCounters{recipients:Players(One(PlayerRef::AbilityController)), kind:$counter_kind, information:CurrentOrLastKnown} */
count_each_player_counter ::= counter_kind "counter" "you" "have"

/* A permanent counter count keeps its written recipient separate from player counters. */
/* @sem Expr::CountCounters{recipients:Objects($affected), kind:$counter_kind, information:CurrentOrLastKnown} */
count_each_object_counter ::= counter_kind ("counter" | "counters") "on" affected

/* The printed actor is the sacrificing player, not a current controller filter. */
/* @sem Expr::EventHistory{event:Player{event:Sacrifices, players:One(AbilityController), objects:$filter_plural}, window:ThisTurn, measure:Distinct(CardTypes)} */
count_each_you_sacrificed_types ::= "card" "type" "among" filter_plural "you've" "sacrificed" "this" "turn"

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(AbilityController)), ObjectFilter::Counters{kind:$counter_kind, comparison:Greater, value:Constant(0)})}) */
value_shared_countered ::= "the" "number" "of" filter_plural "you" "control" "with" counter_kind "counters" "on" "them"
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([AnyOf(@unordered([$value_shared_subtype_plural, $value_shared_subtype_plural_2, $value_shared_subtype_plural_3, $value_shared_subtype_plural_4])), ControlledBy(One(AbilityController)), Not(SameObject(Source))])}) */
value_shared_other_four_subtypes ::= "the" "number" "of" "other" value_shared_subtype_plural "," value_shared_subtype_plural "," value_shared_subtype_plural ","? "and" value_shared_subtype_plural "you" "control"
/* The named Saga must have a proven lexical referent, normally the final
   chapter's event subject. An unrelated object cannot supply this property. */
/* @sem Expr::ObjectProperty{object:@qualified_object(ObjectKind::Permanent, ObjectFilter::Subtype(Saga)), property:ManaValue, information:CurrentOrLastKnown} */
value_shared_saga_mana ::= "that" "Saga's" "mana" "value"

value_shared_subtype_plural ::= subtype_plural | value_shared_marked_bats | value_shared_marked_goblins | value_shared_marked_rats
/* These words also occur in lower case in the seeded vocabulary. A comma
   preserves their capital with an explicit spelling token. */
/* @sem ObjectFilter::Subtype(Bat) */
value_shared_marked_bats ::= "↑" "bats"
/* @sem ObjectFilter::Subtype(Goblin) */
value_shared_marked_goblins ::= "↑" "goblins"
/* @sem ObjectFilter::Subtype(Rat) */
value_shared_marked_rats ::= "↑" "rats"

/* @sem Expr::TimesMutated($object_ref) */
value_times_mutated ::= "the" "number" "of" "times" object_ref "has" "mutated"

/* The printed self reference supplies the object identity for the whole-game
   attack history, independently of any currently counted battlefield group. */
/* @sem Expr::EventHistory{event:Object{event:Attacks, objects:SameObject($self_explicit_ref)}, window:ThisGame, measure:Occurrences} */
count_each_self_attack_game ::= "time" self_explicit_ref "attacked" "this" "game"

/* Chosen creature type is persistent choice information. It filters the live
   battlefield population and is not a currently supplied literal subtype. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::CardType(Creature), ObjectFilter::Chosen(CreatureType))}) */
value_chosen_creature_population ::= "the" "number" "of" "creatures" "of" "the" "chosen" "type" "on" "the" "battlefield"

/* The beginning of the last turn names a history window, independently of
   the current turn or a trigger's entry/turn-face-up event. */
/* @sem Expr::EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:$card_filter}, window:SinceLastTurnOf(AbilityController), measure:Occurrences} */
value_cast_since_last_turn ::= "the" "number" "of" card_filter "spells" "you've" "cast" "since" "the" "beginning" "of" "your" "last" "turn"

/* @sem Expr::EventHistory{event:Player{event:Sacrifices, players:One(AbilityController), objects:$filter_plural}, window:ThisTurn, measure:Occurrences} */
sacrifice_history_one_or_more ::= "you" "sacrificed" "one" "or" "more" filter_plural "this" "turn"

/* The counters of a kind on one object. */
/* @sem Expr::CountCounters(_{recipients:Objects(One($object_ref)), kind:$counter_kind, information:CurrentOrLastKnown}) */
value_counters_on_object ::= "the" "number" "of" counter_kind "counters" "on" object_ref

/* Every counter on the object, whatever its kind. */
/* @sem Expr::CountCounters(_{recipients:Objects($affected), information:CurrentOrLastKnown}) */
value_all_counters_on_object ::= "the" "number" "of" "counters" "on" affected

/* Player counters are not counters on the source or on permanents. */
/* @sem Expr::CountCounters{recipients:Players(One(PlayerRef::AbilityController)), kind:$counter_kind, information:CurrentOrLastKnown} */
value_player_counters ::= "the" "number" "of" counter_kind "counters" "you" "have"

/* @sem Expr::CountPlayers(OpponentsOf(PlayerRef::AbilityController)) */
value_opponents ::= "the" "number" "of" "opponents" "you" "have"

/* @sem Expr::CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, property:Names} */
value_differently_named ::= "the" "number" "of" "differently" "named" filter_plural

/* @sem Expr::EventHistory{event:Spell{event:Cast, players:One(PlayerRef::AbilityController), spells:Any}, window:ThisTurn, measure:Occurrences} */
value_spells_you_cast ::= "the" "number" "of" "spells" "you've" "cast" "this" "turn"

/* Every created object is a token, so the history names no further filter. */
/* @sem Expr::EventHistory{event:Player{event:CreatesToken, players:One(PlayerRef::AbilityController), objects:Any}, window:ThisTurn, measure:Occurrences} */
value_tokens_created ::= "the" "number" "of" "tokens" "you" "created" "this" "turn"

/* Per-each counts taken over from seeded rules, in their original Oracle words. */
/* @sem Expr::CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, property:Colors} */
count_each_color_among ::= "color" "among" filter_plural
/* @sem Expr::ManaSpent{object:$spent_spell, filter:SpentManaFilter{}, aggregation:DistinctColors} */
count_each_color_spent ::= "color" "of" "mana" "spent" "to" "cast" spent_spell

/* @sem Expr::TimesKicked($object_ref) */
count_each_time_kicked ::= "time" object_ref "was" "kicked"

/* @sem Expr::CountCounters(_{recipients:Objects(One($object_ref)), information:CurrentOrLastKnown}) */
count_each_counter_on ::= "counter" "on" object_ref

/* "Equal to the result": the die rolled just before. */
/* @sem Expr::DieResult(@die_roll) */
value_die_result ::= "the" "result"

/* The amount counts the chosen colors of the referenced object. */
/* @sem Expr::ChosenColorsOf(@it) */
life_per_chosen_color ::= "1" "life" "for" "each" "of" "the" "chosen" "colors" "it" "is"

/* Quantity phrases retain their own populations and event history. */
/* @sem Expr::Add([CountObjects(Transition{result:@prior, phase:Before}), $value]) */
card_count_prior_plus ::= "that" "many" "cards" "plus" value

/* @sem $count_each */
card_count_additional_each ::= "an" "additional" "card" "for" "each" count_each

/* @sem Expr::CountDistinct{objects:$affected, property:Powers} */
count_each_different_power ::= "different" "power" "among" affected

/* @sem Expr::Earlier{what:Devoured, measure:Count, filter:$filter_phrase} */
count_each_devoured ::= filter_phrase "it" "devoured"

/* @sem Expr::CountPlayers(Intersection([$count_each_player_population, Matching{binding:0, condition:Compare{left:EventHistory{event:Player{event:Draws, players:One(Bound(0))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}}])) */
count_each_players_drew ::= count_each_player_population "who" "drew" value "or" "more" "cards" "this" "turn"

/* @sem Expr::EventHistory{event:Discard{players:$players_singular, cards:Any, kind:Any, grouping:Card}, window:ThisTurn, measure:Occurrences} */
value_discarded_by_player ::= "the" "number" "of" "cards" players_singular "discarded" "this" "turn"

count_each_player_population ::= count_each_opponent_population | count_each_any_player_population

/* @sem PlayerSet::OpponentsOf(AbilityController) */
count_each_opponent_population ::= "opponent"

/* @sem PlayerSet::All */
count_each_any_player_population ::= "player"

/* @sem Expr::Constant(30) */
n30 ::= "thirty"

/* History quantities and draft notes retain their measured population and name. */
/* @sem Expr::EventHistory{event:Player{event:GainsLife, players:One(AbilityController)}, window:ThisTurn, measure:TotalAmount} */
value_entry_life_gained ::= "the" "amount" "of" "life" "you've" "gained" "this" "turn"

/* @sem Expr::EventHistory{event:Player{event:LosesLife, players:OpponentsOf(AbilityController)}, window:ThisTurn, measure:TotalAmount} */
value_entry_opponents_life_lost ::= "the" "total" "life" "lost" "by" "your" "opponents" "this" "turn"

/* @sem Expr::DraftNoted{note:_{kind:Removed, player:AbilityController, card:@card_name}} */
value_draft_removed_named ::= "the" "number" "of" "cards" "you" "removed" "from" "the" "draft" "with" "cards" "named" SELF_NAME

/* @sem Expr::CountCounters(_{recipients:Objects($counter_battlefield_population), kind:$counter_kind, information:CurrentOrLastKnown}) */
count_each_kind_among_population ::= counter_kind "counter" "among" counter_battlefield_population

/* @sem Expr::CountCounters(_{recipients:Objects($counter_battlefield_population), kind:$counter_kind, information:CurrentOrLastKnown}) */
value_kind_counters_on_population ::= "the" "number" "of" counter_kind "counters" "on" counter_battlefield_population

/* @sem Expr::CountCounters(_{recipients:Objects($counter_battlefield_population), information:CurrentOrLastKnown}) */
value_counters_among_population ::= "the" "number" "of" "counters" "among" counter_battlefield_population

/* Attack occurrences during this turn, with the attacking population preserved. */
/* @sem Expr::EventHistory{event:Object{event:Attacks, objects:$filter_phrase}, window:ThisTurn, measure:Occurrences} */
count_each_attacked ::= filter_phrase "that" "attacked" "this" "turn"

/* @sem Expr::EventHistory{event:Object{event:Attacks, objects:AllOf([$filter_phrase, ControlledBy(One(AbilityController))])}, window:ThisTurn, measure:Occurrences} */
count_each_you_attacked_with ::= filter_phrase "you" "attacked" "with" "this" "turn"

/* Count cast events using the independently stated spell filter and caster. */
/* @sem Expr::EventHistory{event:Spell{event:Cast, players:$cast_history_players, spells:$cast_history_spell}, window:ThisTurn, measure:Occurrences} */
count_each_spell_cast_history ::= cast_history_spell cast_history_players "this" "turn"

cast_history_spell ::= cast_history_any_spell | cast_history_other_spell | cast_history_filtered_spell

/* @sem ObjectFilter::Any */
cast_history_any_spell ::= "spell"

/* @sem ObjectFilter::Not(SameObject(Source)) */
cast_history_other_spell ::= "other" "spell"

/* @sem $spell_adjectives */
cast_history_filtered_spell ::= spell_adjectives "spell"

cast_history_players ::= cast_history_all | cast_history_you | cast_history_they | cast_history_opponents

/* @sem PlayerSet::All */
cast_history_all ::= "cast"

/* @sem PlayerSet::One(AbilityController) */
