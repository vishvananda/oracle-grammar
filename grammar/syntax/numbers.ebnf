count_each_goaded_controlled ::= "goaded" filter_phrase "you" "control"

/* Maximum property of the current controlled battlefield population. */
/* @sem Expr::Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(AbilityController)))}, property:$stat, aggregation:Maximum} */
greatest_controlled_stat ::= "the" "greatest" stat "among" filter_plural "you" "control"

/* Live exile cards remain filtered by their owner. */
/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:OwnedBy(OpponentsOf(AbilityController))} */
card_population_opponents_owned_exile ::= "cards" "your" "opponents" "own" "in" "exile"

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:OwnedBy(One(AbilityController))} */
card_population_owned_exile ::= "cards" "you" "own" "in" "exile"

/* Measure each candidate player separately over the current turn. */
/* @sem Expr::AmongPlayers{players:$choice_life_candidates, number:CardsDrawnThisTurn, aggregation:$extreme_aggregation} */
value_extreme_cards_drawn ::= "the" extreme_aggregation "number" "of" "cards" choice_life_candidates "has" "drawn" "this" "turn"

/* Energy history is measured for the named actor, independent of its use. */
/* @sem Expr::AmongPlayers{players:One($history_draw_actor), number:EnergyPaidOrLostThisTurn, aggregation:Sum} */
count_each_energy_paid_or_lost_plain ::= "{" "E" "}" history_draw_actor "paid" "or" "lost" "this" "turn"

/* @sem Expr::Divide{numerator:Expr::PlayerNumber{player:@that_player, number:Life}, denominator:Expr::Constant(3), rounding:$rounding_words} */
life_third ::= "a" "third" "of" "their" "life" "," rounding_words

life_own_fraction ::= life_half | life_third

/* The mentioned sticker supplies the measured letters. */
/* @sem Expr::Stickers{objects:$sticker_mentioned, measure:UniqueVowels} */
value_unique_sticker_vowels ::= "the" "number" "of" "unique" "vowels" "on" sticker_mentioned

/* A sum retains both the stated base and the independently counted events. */
/* @sem Expr::Add([$card_count_many, $card_count_additional_each]) */
card_count_plus_additional_each ::= card_count_many "plus" card_count_additional_each

/* @sem Expr::EventHistory{event:Filtered{event:Spell{event:Cast, players:One(@that_player), spells:State(Commander)}, condition:WasCastFrom{object:EventSubject, zone:$their_commander_origin}}, window:$their_commander_window, measure:Occurrences} */
count_each_their_commander_cast ::= "time" "they've" "cast" "a" "commander" "from" "the" their_commander_origin their_commander_window

their_commander_origin ::= their_commander_origin_command | hand_exile_graveyard

/* @sem Zone::Command */
their_commander_origin_command ::= "command" "zone"

their_commander_window ::= history_graveyard_game | bound_attack_this_turn

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$adjective_nontype, $modifier_you_own, $modifier_named_counters_on_them])} */
/* @prefer always */
card_population_owned_exile_counters ::= adjective_nontype "cards" modifier_you_own "in" "exile" modifier_named_counters_on_them

/* @sem Expr::EventHistory{event:ZoneChange{objects:$filter_plural, from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Property(Power, Sum)} */
value_total_power_died ::= "the" "total" "power" "of" filter_plural "that" "died" "this" "turn"

/* Count the players separately from the action using this turn-history measure. */
/* @sem Expr::CountPlayers(Matching{binding:0, condition:Compare{left:EventHistory{event:Discard(_{players:One(Bound(0)), cards:Any, kind:Any, grouping:Card}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$card_count}}}) */
count_each_discarding_players ::= "player" "who" "discarded" card_count "this" "turn"

/* A matched event group can also supply the population of a maximum. */
greatest_maximum_population ::= group_pronoun | greatest_population

/* Count other controlled permanents sharing the named referent. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject($object_ref)), $filter_phrase, ControlledBy(One(AbilityController)), SharesNameWith($object_ref)])}) */
count_each_other_controlled_same_name ::= "other" filter_phrase "you" "control" "with" "the" "same" "name" "as" object_ref

/* Distinct costs count the stated live card population, independently of mana values. */
/* @sem Expr::CountDistinct{objects:$card_population, property:ManaCosts} */
count_each_distinct_mana_costs ::= "different" "mana" "cost" "among" card_population

/* Each zone counts the union once, with ownership applied to shared exile. */
/* @sem Expr::Add([CountObjects(Zone{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(One(AbilityController)), AnyOf([$filter_plural, Name(@card_name)])])}), CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AnyOf([$filter_plural, Name(@card_name)])})]) */
value_owned_exile_graveyard_union ::= "the" "total" "number" "of" "cards" "you" "own" "in" "exile" "and" "in" "your" "graveyard" "that" "are" filter_plural "or" "are" "named" SELF_NAME

/* @sem Expr::Add($value_atom, $value_owned_exile_graveyard_union) */
owned_zones_plus_value ::= value_atom "plus" value_owned_exile_graveyard_union

/* Damage from other sources with a specified name, measured at this recipient. */
/* @sem Expr::EventHistory{event:Damage(_{source_kind:Any, sources:AllOf([Not(SameObject($self_ref_holder)), Name($referenced_card_name)]), recipients:Objects(SameObject($self_ref_holder)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:TotalAmount} */
history_other_named_damage ::= "the" "amount" "of" "damage" "dealt" "to" self_ref_holder "this" "turn" "by" "other" "sources" "named" referenced_card_name

history_damage_sum ::= history_damage_named_sum | history_damage_outside_hand_sum

/* The target retains its own announced filter and identity. */
/* @sem Expr::Noted{object:$target_permanent, measure:CreatureTypes} */
card_count_noted_target_creature_types ::= "a" "card" "for" "each" "creature" "type" "noted" "for" target_permanent

count_each_additional ::= count_each | count_each_opponent_hand_bounded

/* Count each opponent against that opponent’s own hand. */
/* @sem Expr::CountPlayers(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:$bound_words, value:$count}}}])) */
count_each_opponent_hand_bounded ::= "opponent" "who" "has" count bound_words "cards" "in" "hand"

/* The keyword and owner independently filter the live exile population. */
/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$exiled_keyword_family, OwnedBy(One(AbilityController))])} */
card_population_owned_keyword_exile ::= "cards" "with" exiled_keyword_family "you" "own" "in" "exile"

/* A shared creature head qualifies both subtype alternatives. */
/* @sem @and(ObjectFilter::AnyOf([$subtype, $subtype_2]), $noun_creature) */
card_subtype_union_creature ::= subtype "or" subtype noun_creature

/* Cast occurrences retain the caster and the source-spell exclusion. */
/* @sem Expr::EventHistory{event:Spell{event:Cast, players:All, spells:AllOf([Not(SameObject(Source)), Cast{by:One(AbilityController)}])}, window:ThisTurn, measure:Occurrences} */
history_other_spells_cast ::= "the" "number" "of" "other" "spells" "you've" "cast" "this" "turn"

/* @sem Expr::Add([$value_atom, $history_other_spells_cast]) */
other_spells_sum ::= value_atom "plus" history_other_spells_cast

/* @prefer always */
/* @sem Expr::Add([$value, $history_other_named_damage]) */
history_damage_named_sum ::= value "plus" history_other_named_damage

/* @sem Expr::Add([$value, $history_spells_cast_outside_hand]) */
history_damage_outside_hand_sum ::= value "plus" history_spells_cast_outside_hand

/* @sem Expr::EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:Not(Cast{from:Players{zone:Hand, players:One(CasterOf(Candidate))}})}, window:ThisTurn, measure:Occurrences} */
history_spells_cast_outside_hand ::= "the" "number" "of" "spells" "you've" "cast" "from" "anywhere" "other" "than" "your" "hand" "this" "turn"

/* Passive wording counts casts by the ability controller from the stated origin. */
/* @sem Expr::EventHistory{event:Filtered{event:Spell{event:Cast, players:One(AbilityController), spells:State(Commander)}, condition:WasCastFrom{object:EventSubject, zone:$their_commander_origin}}, window:$their_commander_window, measure:Occurrences} */
count_each_passive_commander_cast ::= "time" "it's" "been" "cast" "from" "the" their_commander_origin their_commander_window

/* A live controlled population is measured once before the consuming actions. */
/* @sem Expr::Divide{numerator:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$plural, ControlledBy(One(AbilityController))])}), denominator:Constant(2), rounding:$rounding_words} */
half_controlled_permanent_count ::= "half" "the" "number" "of" plural "you" "control" "," rounding_words

/* The threshold and hand owner are independent operands of this live count. */
/* @sem Expr::CountObjects(Zone{scope:Players{zone:Hand, players:One($zone_owner)}, kind:Card, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}}) */
count_each_hand_mana_value_minimum ::= "card" "in" zone_owner "hand" "with" "mana" "value" value "or" "greater"

/* The number of wins from the latest coin-flip process. */
/* @prefer always */
/* @sem Expr::CountCoinOutcomes{source:Latest, outcome:Won} */
count_each_flip_won ::= "flip" "you" "won"

/* Count the live battlefield population controlled by the ability controller's team. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(Matching{binding:0, condition:SameTeam{player:Bound(0), other:AbilityController}})])}) */
value_team_controlled_count ::= "the" "number" "of" filter_plural "your" "team" "controls"

/* The announced permanent supplies the property used by any enclosing expression. */
/* @sem Expr::ObjectProperty{object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$adjective_nontype}), index:0}, property:$stat, information:CurrentOrLastKnown} */
value_target_filtered_permanent_possessive_stat ::= "target" adjective_nontype "permanent's" stat

/* A single filter applies independently to owned exile cards and to the
   controller's graveyard. The expression can compose with surrounding sums. */
/* @sem Expr::Add([CountObjects(Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_phrase, OwnedBy(One(AbilityController))])})), CountObjects(Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}))]) */
owned_exile_and_graveyard_count ::= filter_phrase "cards" "you" "own" "in" "exile" "and" "in" "your" "graveyard"

/* @sem $owned_exile_and_graveyard_count */
value_total_owned_exile_graveyard ::= "the" "total" "number" "of" owned_exile_and_graveyard_count

/* A live controlled population sharing a creature type with a referenced object. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController)), Shares{property:CreatureTypes, with:$object_ref}])}) */
value_controlled_sharing_creature_type ::= "the" "number" "of" filter_plural "you" "control" "that" "share" "a" "creature" "type" "with" object_ref

/* The same card filter applies to owned exiled cards and your graveyard. */
/* @sem Expr::Add([CountObjects(Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$card_filter, OwnedBy(One(AbilityController))])}), CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$card_filter})]) */
count_each_owned_exile_and_graveyard ::= card_filter "card" "you" "own" "in" "exile" "and" "in" "your" "graveyard"

/* Both zones count the same described cards; exile additionally requires ownership. */
/* @prefer always */
/* @sem Expr::Add([CountObjects(Zone(_{scope:Shared(Exile), kind:Card, filter:@and($owned_zone_card_qualifier, ObjectFilter::OwnedBy(One(AbilityController)))})), CountObjects(Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$owned_zone_card_qualifier}))]) */
count_each_owned_exile_graveyard ::= "card" "you" "own" "in" "exile" "and" "in" "your" "graveyard" owned_zone_card_qualifier

/* Written conjunction denotes either spell type in this counting context. */
/* @sem ObjectFilter::AnyOf(@unordered([$spell_adjective, $spell_adjective_2])) */
cast_history_and_spell ::= spell_adjective "and" spell_adjective "spell"

/* A live population, filtered by its controller and this turn’s attack history. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy($players_singular), Condition(Not(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}))])}) */
value_controlled_nonattackers ::= "the" "number" "of" filter_plural players_singular "controls" "that" "didn't" "attack" "this" "turn"

/* @sem Expr::EventHistory{event:$damage_history_total_event, window:ThisTurn, measure:TotalAmount} */
value_damage_history_total ::= "the" damage_history_total_event

/* Count other matching battlefield permanents with the named keyword. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(@pump_other_ref(ObjectRef::@it))), $filter_phrase, HasKeyword($keyword_value)])}) */
count_each_other_keyword_battlefield ::= "other" filter_phrase "on" "the" "battlefield" "with" keyword_value

/* A single live population counts each controlled permanent in the union once. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_three_heads_and_or, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController)))}) */
count_each_controlled_three_and_or ::= filter_three_heads_and_or "you" "control"

/* @sem Expr::EventHistory{event:$filtered_damage_history_event, window:ThisTurn, measure:TotalAmount} */
value_filtered_damage_history ::= "the" filtered_damage_history_event

/* @sem Expr::CountDistinct{objects:$craft_exiled_cards, property:Colors} */
value_craft_colors ::= "the" "number" "of" "colors" "among" craft_exiled_cards

/* @sem Expr::CountDistinct{objects:$craft_exiled_cards, property:BasicLandTypes} */
value_craft_land_types ::= "the" "number" "of" "basic" "land" "types" "among" craft_exiled_cards

/* The last life total noted for the ability source remains source-specific. */
/* @sem Expr::Noted{object:Source, measure:LifeTotal} */
value_last_noted_life_total ::= "the" "last" "noted" "life" "total" "for" "this" "enchantment"

/* Count the mana spent on the referenced spell, independent of the enclosing effect. */
/* @sem Expr::ManaSpent{object:$spent_to_cast_object, filter:SpentManaFilter{}, aggregation:Count} */
cast_mana_count ::= "mana" spent_to_cast_object

/* @sem $object_ref */
spent_to_cast_object ::= "spent" "to" "cast" object_ref

/* Count nontoken arrivals under the ability controller this turn. */
/* @sem Expr::EventHistory{event:ZoneChange{objects:AllOf([Not(Token), $filter_plural, ControlledBy(One(AbilityController))]), to:Battlefield}, window:ThisTurn, measure:Occurrences} */
nontoken_entries_yours ::= "the" "number" "of" "nontoken" filter_plural "you" "had" "enter" "the" "battlefield" "under" "your" "control" "this" "turn"

/* Each opponent is counted once when their own life-loss or life-gain event occurred. */
/* @sem Expr::CountPlayers(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:EventHistory{event:Player{event:$life_history_event, players:One(Bound(0))}, window:$life_history_window, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}])) */
count_each_opponent_life_history ::= "opponent" "who" life_history_event "life" life_history_window

/* Maximum life total across all players. */
/* @sem Expr::AmongPlayers{players:All, number:Life, aggregation:Maximum} */
value_highest_life_all_players_h3 ::= "the" "highest" "life" "total" "among" "all" "players"


count_each_energy_paid_or_lost ::= count_each_energy_paid_or_lost_plain | count_each_energy_paid_or_lost_reminded
/* @sem Expr::AmongPlayers{players:One($history_draw_actor), number:EnergyPaidOrLostThisTurn, aggregation:Sum} */
count_each_energy_paid_or_lost_reminded ::= "{" "E" "}" "(" "↓" "energy" "counter" ")" history_draw_actor "paid" "or" "lost" "this" "turn"

/* @sem Expr::EventHistory{event:Player{event:FacesDilemma, players:One(AbilityController)}, window:ThisTurn, measure:Occurrences} */
count_each_dilemma_faced ::= "dilemma" "you've" "faced" "this" "turn"

/* @sem Expr::CountDistinct{objects:$affected, property:CreatureTypes} */
value_distinct_creature_types ::= "the" "number" "of" "creature" "types" "among" affected

/* Divide the number of distinct types into complete groups. */
/* @sem Expr::Divide{numerator:CountDistinct{objects:$affected, property:CreatureTypes}, denominator:$number, rounding:Down} */
count_each_group_of_creature_types ::= number "creature" "types" "among" affected

/* @sem Expr::CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($plural, ObjectFilter::ControlledBy(One(AbilityController)))}, property:Names} */
differently_named_controlled_population ::= "differently" "named" plural

/* @sem $count_each_group_of_creature_types */
card_count_for_every_group ::= "a" "card" "for" "every" count_each_group_of_creature_types

/* Count cards that actually moved, checking their pre-exile characteristics. */
/* @sem Expr::CountObjects(Matching{objects:Transition{result:@prior, phase:Before}, filter:$filter_phrase}) */
value_filtered_exiled_card_receipt ::= "the" "number" "of" filter_phrase "cards" "exiled" "this" "way"

/* The subject of "other" is this ability's holder. The attachment
   belongs to the counted object and need not share its controller. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield),kind:Permanent,filter:AllOf([Not(SameObject(Source)),$filter_plural,ControlledBy(One(AbilityController)),HasAttached($subtype)])}) */
value_other_controlled_attached_subtype ::= "the" "number" "of" "other" filter_plural "you" "control" "with" "a" subtype "attached" "to" "them"
