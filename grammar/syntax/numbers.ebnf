/* @sem PlayerSet::OpponentsOf(AbilityController) */
counted_opponent_plain ::= "opponent" "you" "have"

/* @sem PlayerSet::Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:$counted_opponent_singular_condition}]) */
counted_opponent_qualified ::= "opponent" counted_opponent_singular_condition

/* @sem PlayerSet::Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:$counted_opponent_plural_condition}]) */
counted_opponents_qualified ::= "opponents" counted_opponent_plural_condition

/* @sem Condition::PlayerAttacks{attacker:AbilityController, defender:Bound(0)} */
counted_opponent_singular_condition ::= "you're" "attacking"

counted_opponent_plural_condition ::= counted_opponents_being_attacked | counted_opponents_controlling_an

/* @sem Condition::PlayerState{player:Bound(0), state:BeingAttacked} */
counted_opponents_being_attacked ::= "being" "attacked"

/* @sem Condition::Controls{player:Bound(0), filter:$filter_phrase, minimum:1} */
counted_opponents_controlling_an ::= "who" "control" "an" filter_phrase

/* Distinct controlled permanent sources, not damage instances or recipients. */
/* @sem Expr::EventHistory{event:Damage(_{source_kind:Permanent, sources:AllOf([$filter_phrase, ControlledBy(One(AbilityController))]), recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source}), window:ThisTurn, measure:DistinctSources} */
count_each_combat_sources ::= filter_phrase "you" "controlled" "that" "dealt" "combat" "damage" "to" "a" "player" "this" "turn"

/* @sem Expr::ManaSpentFrom{object:$spent_spell, sources:$filter_phrase} */
count_each_mana_source ::= "mana" "from" "a" filter_phrase "spent" "to" "cast" spent_spell

/* The spell named by the surrounding spell event. */
/* @sem Expr::ObjectProperty{object:@qualified_object(ObjectKind::Spell, ObjectFilter::Any), property:ManaValue, information:CurrentOrLastKnown} */
value_event_spell_mana ::= "that" "spell's" "mana" "value"

/* Live populations compose without assuming an action receipt. */
/* @sem Expr::Add($count_controlled_population, $count_live_graveyard) */
count_each_controlled_population_sum ::= count_controlled_population "and" "each" count_live_graveyard

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController))])}) */
count_controlled_population ::= filter_phrase "you" "control"

/* The plural population is controlled by the player established in this clause. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(@that_player)))}) */
value_number_they_control ::= "the" "number" "of" filter_plural "they" "control"

/* @sem Expr::Multiply([$value, $card_count]) */
card_count_multiplied ::= value "times" card_count

/* The controller's commander identity is a player quantity. */
/* @sem Expr::PlayerNumber{player:AbilityController, number:CommanderColorIdentity} */
value_commander_identity ::= "the" "number" "of" "colors" "in" "your" "commanders'" "color" "identity"

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($plural, ObjectFilter::AllOf([OwnedBy(OpponentsOf(AbilityController)), ControlledBy(OpponentsOf(AbilityController))]))}) */
value_opponents_owned_controlled_opponents ::= "the" "number" "of" plural "your" "opponents" "own" "that" "your" "opponents" "control"

/* The owner and controller are independent roles in this population. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($plural, ObjectFilter::AllOf([OwnedBy(One(AbilityController)), ControlledBy(OpponentsOf(AbilityController))]))}) */
value_owned_controlled_opponents ::= "the" "number" "of" plural "you" "own" "that" "your" "opponents" "control"

/* Keep ownership and control as separate population filters. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($plural, ObjectFilter::AllOf([OwnedBy(One(AbilityController)), ControlledBy(One(AbilityController))]))}) */
value_owned_controlled_you ::= "the" "number" "of" plural "you" "own" "that" "you" "control"

/* Products and event counts are numeric phrases shared by life actions. */
/* @sem Expr::Multiply([$value, $number]) */
life_product ::= value "times" number "life"

/* @sem Expr::Multiply([$value, EventHistory{event:Caused{cause:Any, event:AnyOf([Player{event:GroupsIntoPiles, players:All}, Player{event:Guesses, players:All}])}, window:ThisTurn, measure:DistinctCauses}]) */
life_caused_events ::= value "life" "for" "each" "spell" "or" "ability" "that" "caused" "one" "or" "more" "players" "to" "guess" "or" "to" "group" "cards" "or" "permanents" "into" "a" "pile" "this" "turn"

/* @sem Expr::CountPlayers(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:EventHistory{event:Damage(_{source_kind:Any, sources:Any, recipients:Players(One(Bound(0))), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}])) */
count_each_opponent_damaged_turn ::= "opponent" "who" "was" "dealt" "damage" "this" "turn"

/* Count the even results of the current roll. */
/* @sem Expr::Dice(Matching([SameParity, Constant(0)])) */
count_each_even_die ::= "even" "result"

/* Count players who performed the preceding optional action. */
/* @sem Expr::CountPlayers(Matching{binding:0, condition:PlayerTook{player:Bound(0), result:@prior}}) */
count_each_opponent_did ::= "opponent" "who" "does"

/* Count the recorded objects of the preceding phase-out action. */
/* @sem Expr::CountObjects(Recorded(@prior)) */
count_each_phased_creature ::= "creature" "that" "phased" "out" "this" "way"

/* Count occurrences for a population leaving while controlled by you. */
/* @sem Expr::EventHistory{event:Object{event:LeavesBattlefield, objects:@and($filter_phrase, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController)))}, window:ThisTurn, measure:Occurrences} */
count_each_controlled_departure ::= filter_phrase "that" "left" "the" "battlefield" "under" "your" "control" "this" "turn"

/* The controller is evaluated on the departing permanent in each death event. */
/* @sem Expr::EventHistory{event:ZoneChange{objects:@and($filter_phrase, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController))), from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Occurrences} */
count_each_you_controlled_died ::= filter_phrase "you" "controlled" "that" "died" "this" "turn"

/* The history measures life, not the number of loss events. */
/* @sem Expr::EventHistory{event:Player{event:LosesLife, players:OpponentsOf(AbilityController)}, window:ThisTurn, measure:TotalAmount} */
history_life_opponents_lost ::= "the" "total" "amount" "of" "life" "your" "opponents" "have" "lost" "this" "turn"

/* @sem Expr::EventHistory{event:Player{event:LosesLife, players:One(AbilityController)}, window:ThisTurn, measure:TotalAmount} */
history_life_you_lost ::= "the" "total" "amount" "of" "life" "you" "have" "lost" "this" "turn"

history_life_total ::= history_life_opponents_lost | history_life_you_lost

/* @sem Expr::Aggregate{objects:$owned_commander_battlefield_or_command, property:ManaValue, aggregation:Maximum} */
value_greatest_owned_commander_mana ::= "the" "greatest" "mana" "value" "of" owned_commander_battlefield_or_command

/* @sem Expr::CountCounters(_{recipients:Objects($affected), kind:$counter_kind, information:CurrentOrLastKnown}) */
counter_population_quantity ::= "the" "number" "of" counter_kind "counters" "on" affected

/* Evaluate the life event independently for each bound player. */
/* @sem Expr::CountPlayers(Matching{binding:0, condition:Compare{left:EventHistory{event:Player{event:$life_history_event, players:One(Bound(0))}, window:$life_history_window, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}) */
count_each_player_life_history ::= "player" "who" life_history_event "life" life_history_window
