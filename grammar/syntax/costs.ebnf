/* Costs and mana symbols. */
/* @sem Cost::Cost{parts:$cost_parts} */
cost ::= cost_parts

cost_parts ::= cost_parts_one | cost_parts_more | cost_remove_counters_and_sacrifice

/* "Remove three quest counters from this enchantment and sacrifice it": "it" is the
   source the counters come off. */
/* @sem CostPart::[$cost_remove_counters, CostPart::Sacrifice{objects:One(ObjectRef::Source)}] */
cost_remove_counters_and_sacrifice ::= cost_remove_counters "and" "sacrifice" "it"

/* @sem CostPart::[$cost_part] */
cost_parts_one ::= cost_part

/* @sem CostPart::[$cost_part, ...$cost_parts_later] */
cost_parts_more ::= cost_part "," cost_parts_later

cost_parts_later ::= cost_parts_one_later | cost_parts_more_later | cost_sacrifice_many_and_self | cost_exile_many_and_self

/* @sem CostPart::[CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:Exactly($count)}, CostPart::Sacrifice{objects:One(ObjectRef::Source)}] */
cost_sacrifice_many_and_self ::= "↑" "sacrifice" count filter_plural "and" self_text

/* @sem CostPart::[CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, choose:Exactly($count)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}, CostPart::Move{selections:[CostObjectSelection{objects:One(ObjectRef::Source)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}] */
cost_exile_many_and_self ::= "↑" "exile" count "cards" "from" "your" "graveyard" "and" self_text

/* @sem CostPart::[$cost_part_later] */
cost_parts_one_later ::= cost_part_later

/* @sem CostPart::[$cost_part_later, ...$cost_parts_later] */
cost_parts_more_later ::= cost_part_later "," cost_parts_later

cost_part_later ::= cost_symbols | cost_word_later

/* @sem $cost_words */
cost_word_later ::= "↑" cost_words

cost_part ::= cost_symbols | cost_words

cost_symbols ::= cost_mana | cost_tap

cost_words ::= mined_cost | cost_words_owned
    | cost_return_to_owners_hand

/* Explicit verb-led payments exclude mined mana-only shorthand. */
cost_words_owned ::= cost_opponent_token_creation | cost_energy | cost_life | cost_blight | cost_pay_repeated_mana | cost_sacrifice_self | cost_sacrifice | cost_sacrifice_another | cost_sacrifice_many
    | cost_discard | cost_discard_filtered | cost_discard_many | cost_tap_untapped | cost_tap_untapped_many | cost_tap_another_untapped
    | cost_exile_permanent | cost_exile_graveyard | cost_exile_card_graveyard | cost_exile_cards_graveyard | cost_exile_kind_cards_graveyard | cost_exile_hand | cost_discard_random
    | cost_remove_pt_counter | cost_life_half | cost_discard_filtered_many | cost_discard_hand | cost_return_self
    | cost_exile_self | cost_remove_counters | cost_remove_any_counters | cost_collect_evidence | cost_exert | cost_discard_either_kind | cost_exile_top | cost_exile_graveyard_top | cost_return_many | cost_sacrifice_another_or | cost_reveal_self_hand
    | cost_behold | cost_behold_many | cost_behold_exile | cost_waterbend | cost_hand_on_top
    | cost_put_counter_on | cost_remove_a_counter_from | cost_remove_all_counters_from | cost_pay_for_each
    | cost_mill | cost_unattach_named_source

/* Waterbend {N}: tapped artifacts and creatures pay for that generic mana. */
/* @sem CostPart::Waterbend($mana_symbols) */
cost_waterbend ::= "waterbend" mana_symbols

/* CR 701.61: behold a creature type, by choosing such a permanent you
   control or revealing such a card from your hand. */
/* @sem CostPart::Behold{count:Constant(1), what:$behold_kind} */
cost_behold ::= "behold" ("a" | "an") behold_kind
/* "Behold three Elementals": one is "behold an Elemental". */
/* @sem CostPart::Behold{count:@plural_amount($value), what:$behold_kinds} */
cost_behold_many ::= "behold" value behold_kinds
/* @sem CostPart::BeholdAndExile($behold_kind) */
cost_behold_exile ::= "behold" ("a" | "an") behold_kind "and" "exile" "it"
behold_kind ::= behold_type | behold_type_creature
/* @sem Operand::Term{family:CardsInHand, form:IsCreatureType, operands:[Vocabulary{family:CreatureType, form:@subtype_name($creature_subtype)}]} */
behold_type ::= creature_subtype
/* @sem Operand::Term{family:CardsInHand, form:And, operands:[Term{family:CardsInHand, form:IsCreatureType, operands:[Vocabulary{family:CreatureType, form:@subtype_name($creature_subtype)}]}, Term{family:CardsInHand, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Creature}]}]} */
behold_type_creature ::= creature_subtype "creature"
/* @sem Operand::Term{family:CardsInHand, form:IsCreatureType, operands:[Vocabulary{family:CreatureType, form:@subtype_name($subtype_plural)}]} */
behold_kinds ::= subtype_plural

/* @sem CostPart::Reveal{count:Exactly(Constant(1)), filter:SameObject($self_explicit_ref)} */
cost_reveal_self_hand ::= "reveal" self_explicit_ref "from" "your" "hand"

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:One(ObjectRef::Source)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_self ::= "exile" self_text

/* An ability paid by moving this card out of a zone works only from that zone. */
activated_from_zone ::= activated_exile_self_after_limited | activated_graveyard_quoted_limited | activated_exile_self | activated_exile_self_after | activated_discard_self | activated_discard_self_after
    | activated_graveyard_return | activated_graveyard_return_limited

/* Returning this card explicitly from the graveyard scopes the whole
   activation there, including any preceding action and its announced targets. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[...$instructions, $graveyard_self_hand]}})} */
activated_graveyard_return ::= cost ":" instructions "." graveyard_self_hand "."

/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:Program{instructions:[...$instructions, $graveyard_self_hand]}})} */
activated_graveyard_return_limited ::= cost ":" instructions "." graveyard_self_hand "." activation_limits "."

/* @sem Instruction::Effect{result:@next, operation:Move{objects:One(@self), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}} */
graveyard_self_hand ::= "return" "this" "card" "from" "your" "graveyard" "to" "your" "hand"

/* Exiling this card from your hand or graveyard is a cost paid there, so the
   ability works only in that zone. */
/* @sem Ability::Scoped{zones:[$your_zone], ability:@scope(Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[CostPart::Move{selections:[CostObjectSelection{objects:One(ObjectRef::Source)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}, limits:ActivationLimits{}, announcement:@announcement, body:$program})} */
activated_exile_self ::= "exile" self_text "from" your_zone ":" program "."

/* @sem Ability::Scoped{zones:[$your_zone], ability:@scope(Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[...$cost_parts, CostPart::Move{selections:[CostObjectSelection{objects:One(ObjectRef::Source)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}, limits:ActivationLimits{}, announcement:@announcement, body:$program})} */
activated_exile_self_after ::= cost_parts "," "↑" "exile" self_text "from" your_zone ":" program "."

/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[CostPart::Discard{count:Expr::Constant(1), filter:SameObject(ObjectRef::Source)}]}, limits:ActivationLimits{}, announcement:@announcement, body:$program})} */
activated_discard_self ::= "discard" self_text ":" program "."

/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[...$cost_parts, CostPart::Discard{count:Expr::Constant(1), filter:SameObject(ObjectRef::Source)}]}, limits:ActivationLimits{}, announcement:@announcement, body:$program})} */
activated_discard_self_after ::= cost_parts "," "↑" "discard" self_text ":" program "."

/* @sem CostPart::RemoveCounters{removals:[CounterRemoval{player:AbilityController, recipients:Objects(One($self_explicit_ref)), kind:$counter_kind, amount:Count(Exactly($counter_amount))}]} */
cost_remove_counters ::= "remove" counter_amount counter_kind ("counter" | "counters") "from" self_explicit_ref

/* @sem CostPart::RemoveCounters{removals:[CounterRemoval{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:Count(AnyNumber)}]} */
cost_remove_any_counters ::= "remove" "any" "number" "of" counter_kind "counters" "from" affected

/* @sem CostPart::TapSymbol */
cost_tap ::= "{T}"

/* @sem CostPart::Life($number) */
cost_life ::= "pay" number "life"

/* @sem CostPart::Sacrifice{objects:One($self_explicit_ref)} */
cost_sacrifice_self ::= "sacrifice" self_explicit_ref

/* @sem CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly(Expr::Constant(1))} */
cost_sacrifice ::= "sacrifice" ("a" | "an") filter_phrase

/* Exiling a permanent as a cost: one of the described permanents on the battlefield. */
/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly(Expr::Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_permanent ::= "exile" ("a" | "an") filter_phrase

/* @sem CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $filter_phrase)}, choose:Exactly(Expr::Constant(1))} */
cost_sacrifice_another ::= "sacrifice" "another" filter_phrase

/* @sem CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:Exactly($count)} */
cost_sacrifice_many ::= "sacrifice" count filter_plural

/* @sem CostPart::Discard{count:Expr::Constant(1), filter:Any} */
cost_discard ::= "discard" ("a" | "an") "card"

/* @sem CostPart::Discard{count:Expr::Constant(1), filter:$card_filter} */
cost_discard_filtered ::= "discard" ("a" | "an") card_filter "card"

/* @sem CostPart::Discard{count:$count, filter:Any} */
cost_discard_many ::= "discard" count "cards"

/* @sem CostPart::ChangeTapState{selections:[CostObjectSelection{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::Tapped), $filter_phrase)}, choose:Exactly(Expr::Constant(1))}], tapped:true} */
cost_tap_untapped ::= "tap" ("a" | "an") "untapped" filter_phrase

/* @sem CostPart::ChangeTapState{selections:[CostObjectSelection{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::Tapped), $filter_plural)}, choose:Exactly($count)}], tapped:true} */
cost_tap_untapped_many ::= "tap" count "untapped" filter_plural

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:$card_filter}, choose:Exactly(Expr::Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_graveyard ::= "exile" ("a" | "an") card_filter "card" "from" "your" "graveyard"

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, choose:Exactly(Expr::Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_card_graveyard ::= "exile" "a" "card" "from" "your" "graveyard"

/* Exiling a card of a kind from your hand. */
/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Hand, players:One(PlayerRef::AbilityController)}, kind:Card, filter:$card_filter}, choose:Exactly(Expr::Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_hand ::= "exile" ("a" | "an") card_filter "card" "from" "your" "hand"

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, choose:Exactly($count)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_cards_graveyard ::= "exile" count "cards" "from" "your" "graveyard"

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:$card_filter}, choose:Exactly($count)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_kind_cards_graveyard ::= "exile" count card_filter "cards" "from" "your" "graveyard"

/* @sem CostPart::Discard{count:$count_or_a, filter:Any, random:true} */
cost_discard_random ::= "discard" count_or_a "at" "random"

count_or_a ::= count_a_card | count_cards

/* @sem Expr::Constant(1) */
count_a_card ::= "a" "card"

/* @sem $count */
count_cards ::= count "cards"

/* @sem CostPart::RemoveCounters{removals:[CounterRemoval{player:AbilityController, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}), kind:PowerToughness(1, 1), amount:Count(Exactly(Expr::Constant(1))), selection:SelectionChoice{player:AbilityController, count:Exactly(Expr::Constant(1))}}]} */
cost_remove_pt_counter ::= "remove" "a" "+" "1" "/" "+" "1" "counter" "from" ("a" | "an") filter_phrase

/* @sem CostPart::Discard{count:$count, filter:$card_filter} */
cost_discard_filtered_many ::= "discard" count card_filter "cards"

/* @sem CostPart::DiscardHand */
cost_discard_hand ::= "discard" "your" "hand"

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:One(ObjectRef::Source)}], destination:OwnersHand(CardArrival{counters:[], states:[]})} */
cost_return_self ::= "return" self_text "to" "its" "owner's" "hand"

/* @sem CostPart::Discard{count:Expr::Constant(1), filter:AnyOf([$card_filter, $card_filter_2])} */
cost_discard_either_kind ::= "discard" ("a" | "an") card_filter "card" "or" card_filter "card"

/* @sem CostPart::Exert(ObjectRef::Source) */
cost_exert ::= "exert" self_text

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:$number, from:Top}, choose:Exactly($number)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_top ::= "exile" "the" "top" number "cards" "of" "your" "library"

/* "Exile the top creature card of your graveyard": the card the graveyard's order and
   the written kind pick out, not a chosen one. The kind filters the graveyard before
   its top card is taken. */
cost_exile_graveyard_top ::= cost_exile_graveyard_card | cost_exile_graveyard_kind
/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Take{objects:Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:Expr::Constant(1), from:$ordered_end}}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_graveyard_card ::= "exile" "the" ordered_end "card" "of" "your" "graveyard"
/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Take{objects:Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:$card_filter}, count:Expr::Constant(1), from:$ordered_end}}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_graveyard_kind ::= "exile" "the" ordered_end card_filter "card" "of" "your" "graveyard"

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:Exactly($count)}], destination:OwnersHand(CardArrival{counters:[], states:[]})} */
cost_return_many ::= "return" count filter_plural "to" "their" "owner's" "hand"

/* @sem CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $noun), $filter_phrase])}, choose:Exactly(Expr::Constant(1))} */
cost_sacrifice_another_or ::= "sacrifice" "another" noun "or" ("a" | "an") filter_phrase

/* @sem CostPart::Keyword{action:CollectEvidence, amount:$number} */
cost_collect_evidence ::= "collect" "evidence" number

/* @sem CostPart::Life(Expr::Divide{numerator:Expr::PlayerNumber{player:PlayerRef::AbilityController, number:Life}, denominator:Expr::Constant(2), rounding:$rounding_words}) */
cost_life_half ::= "pay" "half" "your" "life" "," rounding_words

/* @sem CostPart::Mana($mana_symbols) */
cost_mana ::= mana_symbols

mana_symbols ::= mana_symbols_one | mana_symbols_more

/* @sem ManaSymbol::[$mana_symbol] */
mana_symbols_one ::= mana_symbol

/* @sem ManaSymbol::[$mana_symbol, ...$mana_symbols] */
mana_symbols_more ::= mana_symbol mana_symbols

mana_symbol ::= mana_colorless | mana_generic | mana_white | mana_blue | mana_black | mana_red | mana_green | mana_x | mana_snow
    | mana_hybrid | mana_phyrexian

/* @sem ManaSymbol::Snow */
mana_snow ::= "{S}"

/* @sem ManaSymbol::Hybrid($mana_letter, $mana_letter_2) */
mana_hybrid ::= "{" mana_letter "/" mana_letter "}"

/* A colored symbol that can be paid with 2 life instead. */
/* @sem ManaSymbol::Phyrexian([$mana_letter]) */
mana_phyrexian ::= "{" mana_letter "/" "P" "}"

mana_letter ::= letter_white | letter_blue | letter_black | letter_red | letter_green

/* @sem ManaColor::White */
letter_white ::= "W"
/* @sem ManaColor::Blue */
letter_blue ::= "U"
/* @sem ManaColor::Black */
letter_black ::= "B"
/* @sem ManaColor::Red */
letter_red ::= "R"
/* @sem ManaColor::Green */
letter_green ::= "G"

/* @sem ManaSymbol::Generic($number) */
mana_generic ::= "{" NUMBER "}"

/* An amount of generic mana, as in `cost {2} less`. */
braced_amount ::= braced_number | braced_x
/* @sem Expr::Constant($number) */
braced_number ::= "{" NUMBER "}"
/* @sem Expr::AnnouncedX */
braced_x ::= "{" "X" "}"

/* The printed generic reduction is a factor, not the number of counted objects;
   {1} for each is the count itself. */
/* @sem Ability::Casting(ReduceCost([_{amount:@times($braced_number, $count_each)}])) */
casting_reduction_each ::= "this" "spell" "costs" braced_number "less" "to" "cast" "for" "each" count_each "."

/* A following reduction modifies the offered payment, before deciding whether
   the holder is sacrificed. It cannot create a second sacrifice instruction. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:_{parts:[ManaReducedForEach{mana:$mana_symbols, reduction:$generic_reduction_symbols, per:$count_each}]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:_{instructions:[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:One($self_ref)}}]}, otherwise:_{}}]} */
program_sentence_reduced_payment ::= "sacrifice" self_ref "unless" "you" "pay" mana_symbols "." "this" "cost" "is" "reduced" "by" generic_reduction_symbols "for" "each" count_each "."

/* @sem Operand::List([Term{family:CostReductionSymbol, form:CostReduceGeneric, operands:[Integer($number)]}]) */
generic_reduction_symbols ::= "{" NUMBER "}"

/* @sem ManaSymbol::Color(White) */
mana_white ::= "{W}"
/* @sem ManaSymbol::Color(Blue) */
mana_blue ::= "{U}"
/* @sem ManaSymbol::Color(Black) */
mana_black ::= "{B}"
/* @sem ManaSymbol::Color(Red) */
mana_red ::= "{R}"
/* @sem ManaSymbol::Color(Green) */
mana_green ::= "{G}"
/* @sem ManaSymbol::X */
mana_x ::= "{X}"

/* @sem ManaSymbol::Color(Colorless) */
mana_colorless ::= "{C}"

/* Another excludes the current ability holder without implying a card type. */
/* @sem CostPart::ChangeTapState{selections:[CostObjectSelection{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), ObjectFilter::Not(ObjectFilter::Tapped), $filter_phrase)}, choose:Exactly(Expr::Constant(1))}], tapped:true} */
cost_tap_another_untapped ::= "tap" "another" "untapped" filter_phrase

/* Each condition independently reduces the source spell's generic cost.
   The continuation is not a conjunctive condition or an additional game action. */
conditional_casting_reductions ::= conditional_reductions_compact | conditional_reductions_sentences
/* @sem Ability::[Casting(If{condition:$condition, rule:ReduceCost([_{amount:$braced_amount}])}), Casting(If{condition:$condition_2, rule:ReduceCost([_{amount:$braced_amount_2}])})] */
conditional_reductions_compact ::= "this" "spell" "costs" braced_amount "less" "to" "cast" "if" condition "and" braced_amount "less" "to" "cast" "if" condition "."
/* @sem Ability::[Casting(If{condition:$condition, rule:ReduceCost([_{amount:$braced_amount}])}), Casting(If{condition:$condition_2, rule:ReduceCost([_{amount:$braced_amount_2}])})] */
conditional_reductions_sentences ::= "this" "spell" "costs" braced_amount "less" "to" "cast" "if" condition "." "it" "also" "costs" braced_amount "less" "to" "cast" "if" condition "."

/* Named cost actions are performed by the payer of their enclosing Cost. */
/* @sem CostPart::Keyword{action:Blight, amount:$value} */
cost_blight ::= "blight" value

/* The number repeats the printed mana unit; it is not generic mana. */
/* @sem CostPart::Repeated{part:Mana($mana_symbols), times:$number} */
cost_pay_repeated_mana ::= "pay" number mana_symbols


/* A resolving instruction modifies one future spell, not this permanent or
   every later spell. Omitting "this turn" retains the pending modifier. */
/* @sem Operation::ChangeSpell{subject:$next_cost_subject, changes:[SpellCost(Reduce{reductions:[_{amount:$braced_number}], spill_into_generic:true})]} */
next_filtered_spell_reduction ::= next_cost_subject "costs" braced_number "less" "to" "cast"

next_cost_subject ::= next_cost_filtered_turn | next_cost_filtered_pending | next_cost_any_turn | next_cost_any_pending
/* @sem SpellSubject::Next{spells:$next_cost_filter, player:AbilityController, this_turn:true, from_hand:false} */
next_cost_filtered_turn ::= "the" "next" next_cost_filter "spell" "you" "cast" "this" "turn"
/* @sem SpellSubject::Next{spells:$next_cost_filter, player:AbilityController, this_turn:false, from_hand:false} */
next_cost_filtered_pending ::= "the" "next" next_cost_filter "spell" "you" "cast"
/* @sem SpellSubject::Next{spells:Any, player:AbilityController, this_turn:true, from_hand:false} */
next_cost_any_turn ::= "the" "next" "spell" "you" "cast" "this" "turn"
/* @sem SpellSubject::Next{spells:Any, player:AbilityController, this_turn:false, from_hand:false} */
next_cost_any_pending ::= "the" "next" "spell" "you" "cast"

next_cost_filter ::= filter_phrase | adjective_nontype

/* A final quoted ability's period closes the activation body. The following
   activation limit belongs to the outer ability, not to the granted holder. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:$program_sentence_quoted})} */
activated_graveyard_quoted_limited ::= cost "from" "your" "graveyard" ":" program_sentence_quoted activation_limits "."

/* The chosen opponent performs this cost action. The body repeats that same
   actor operand; it is not token creation by the ability's controller. */
/* @sem CostPart::PlayerAction{player:$cost_token_actor, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One($cost_token_actor), tokens:$token_groups, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}} */
cost_opponent_token_creation ::= "have" cost_token_actor "create" token_groups
/* @sem PlayerRef::OneOf(OpponentsOf(AbilityController)) */
cost_token_actor ::= "an" "opponent"

/* A written this-card exile cost proves the holder's activation zone.
   Following restrictions apply to the same complete activated ability. */
/* @sem Ability::Scoped{zones:[$your_zone], ability:@scope(Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[...$cost_parts, Move{selections:[_{objects:One(Source)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}}]}, limits:$activation_limits, announcement:@announcement, body:$program_sentence})} */
activated_exile_self_after_limited ::= cost_parts "," "↑" "exile" "this" "card" "from" your_zone ":" program_sentence activation_limits "."

/* An ability that returns its own card from your graveyard works there. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$self_graveyard_return}]}})} */
activated_self_graveyard_return ::= cost ":" self_graveyard_return "."
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$self_graveyard_return}]}})} */
activated_self_graveyard_return_limited ::= cost ":" self_graveyard_return "." activation_limits "."
self_graveyard_return ::= self_return_and_optional_card | self_return_hand | self_return_battlefield | self_return_battlefield_attached | self_return_battlefield_tapped | self_return_battlefield_counter | self_return_battlefield_tapped_counter
/* @sem Operation::Move{objects:One($self_ref), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
self_return_hand ::= "return" self_ref "from" "your" "graveyard" "to" "your" "hand"
/* @sem Operation::Move{objects:One($self_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
self_return_battlefield ::= "return" self_ref "from" "your" "graveyard" "to" "the" "battlefield"
/* An Aura returns attached to its new host. */
/* @sem Operation::Move{objects:One($self_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo($object_ref)]}}, qualifiers:[]} */
self_return_battlefield_attached ::= "return" self_ref "from" "your" "graveyard" "to" "the" "battlefield" "attached" "to" object_ref
/* @sem Operation::Move{objects:One($self_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]} */
self_return_battlefield_tapped ::= "return" self_ref "from" "your" "graveyard" "to" "the" "battlefield" "tapped"
/* @sem Operation::Move{objects:One($self_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, $entry_counter_amount]], states:[]}}, qualifiers:[]} */
self_return_battlefield_counter ::= "return" self_ref "from" "your" "graveyard" "to" "the" "battlefield" "with" entry_counter_amount counter_kind "counter" "on" "it"
/* @sem Operation::Move{objects:One($self_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[[$counter_kind, $entry_counter_amount]], states:[]}}, qualifiers:[]} */
self_return_battlefield_tapped_counter ::= "return" self_ref "from" "your" "graveyard" "to" "the" "battlefield" "tapped" "with" entry_counter_amount counter_kind "counter" "on" "it"

/* An ability that puts its own card from your hand or graveyard somewhere
   else works only while the card is in that zone. Oracle text returns a card
   from a graveyard to the battlefield (`self_return_battlefield`) but puts one
   from a hand onto it, so only the hand takes the plain battlefield here. */
/* @sem Ability::Scoped{zones:[$your_zone], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Source), destination:$self_put_destination, qualifiers:[]}}]}})} */
activated_self_zone_put ::= cost ":" "put" "this" "card" "from" your_zone self_put_destination "."
/* @sem Ability::Scoped{zones:[$your_zone], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Source), destination:$self_put_destination, qualifiers:[]}}]}})} */
activated_self_zone_put_limited ::= cost ":" "put" "this" "card" "from" your_zone self_put_destination "." activation_limits "."
/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Source), destination:$self_put_battlefield, qualifiers:[]}}]}})} */
activated_self_hand_put ::= cost ":" "put" "this" "card" "from" "your" "hand" self_put_battlefield "."
/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Source), destination:$self_put_battlefield, qualifiers:[]}}]}})} */
activated_self_hand_put_limited ::= cost ":" "put" "this" "card" "from" "your" "hand" self_put_battlefield "." activation_limits "."
self_put_destination ::= self_put_top | self_put_depth | self_put_battlefield_transformed
/* @sem MovementDestination::Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
self_put_top ::= "on" "top" "of" "your" "library"
/* @sem MovementDestination::Library{position:FromTop($library_depth), order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
self_put_depth ::= "into" "your" "library" library_depth "from" "the" "top"
/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
self_put_battlefield ::= "onto" "the" "battlefield"
/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:$transformed_entry} */
self_put_battlefield_transformed ::= "onto" "the" "battlefield" transformed_entry

/* An additional cost to cast this spell. */
/* @sem Ability::Casting(AdditionalCost{cost:$cost, repetition:Once}) */
casting_additional_cost ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," cost "."

/* An additional cost with a choice of payments. */
/* @sem Ability::Casting(AdditionalCost{cost:_{parts:[Choice([$cost, $cost_2])]}, repetition:Once}) */
casting_additional_cost_choice ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," cost "or" "pay" cost "."

/* An optional additional cost. */
/* @sem Ability::Casting(AdditionalCost{cost:$cost, optional:true, repetition:Once}) */
casting_optional_additional_cost ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "you" "may" cost "."

/* Any number of one optional payment, each buying "{N} less": the spell's cost falls
   by one reduction for each single payment, so the rule records the single unit. */
casting_reduce_for_each_paid ::= reduce_sacrifice_creatures | reduce_sacrifice_permanents | reduce_tap_creatures | reduce_exile_graveyard_cards | reduce_exile_hand_cards | reduce_remove_counters
/* @sem () */
optional_cost_opening ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "you" "may"
/* @sem () */
reduce_for_each_opening ::= "." "this" "spell" "costs"
/* @sem Ability::Casting(ReduceForEachPaid{reductions:[_{amount:$braced_amount}], cost:_{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:Exactly(Constant(1))}]}}) */
reduce_sacrifice_creatures ::= optional_cost_opening "sacrifice" "any" "number" "of" "creatures" reduce_for_each_opening braced_amount "less" "to" "cast" "for" "each" "creature" "sacrificed" "this" "way" "."
/* @sem Ability::Casting(ReduceForEachPaid{reductions:[_{amount:$braced_amount}], cost:_{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:Exactly(Constant(1))}]}}) */
reduce_sacrifice_permanents ::= optional_cost_opening "sacrifice" "any" "number" "of" filter_plural reduce_for_each_opening braced_amount "less" "to" "cast" "for" "each" "permanent" "sacrificed" "this" "way" "."
/* @sem Ability::Casting(ReduceForEachPaid{reductions:[_{amount:$braced_amount}], cost:_{parts:[ChangeTapState{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:Exactly(Constant(1))}], tapped:true, symbol:false}]}}) */
reduce_tap_creatures ::= optional_cost_opening "tap" "any" "number" "of" filter_plural reduce_for_each_opening braced_amount "less" "to" "cast" "for" "each" "creature" "tapped" "this" "way" "."
/* @sem Ability::Casting(ReduceForEachPaid{reductions:[_{amount:$braced_amount}], cost:_{parts:[Move{selections:[_{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$card_filter}, choose:Exactly(Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}) */
reduce_exile_graveyard_cards ::= optional_cost_opening "exile" "any" "number" "of" card_filter "cards" "from" "your" "graveyard" reduce_for_each_opening braced_amount "less" "to" "cast" "for" "each" "card" "exiled" "this" "way" "."
/* @sem Ability::Casting(ReduceForEachPaid{reductions:[_{amount:$braced_amount}], cost:_{parts:[Move{selections:[_{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}, choose:Exactly(Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}) */
reduce_exile_hand_cards ::= optional_cost_opening "exile" "any" "number" "of" card_filter "cards" "from" "your" "hand" reduce_for_each_opening braced_amount "less" "to" "cast" "for" "each" "card" "exiled" "this" "way" "."
/* @sem Ability::Casting(ReduceForEachPaid{reductions:[_{amount:$braced_amount}], cost:_{parts:[RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}), kind:$counter_kind, amount:Count(Exactly(Constant(1))), selection:_{player:AbilityController, count:Exactly(Constant(1))}}]}]}}) */
reduce_remove_counters ::= optional_cost_opening "remove" "any" "number" "of" counter_kind "counters" "from" "among" filter_plural reduce_for_each_opening braced_amount "less" "to" "cast" "for" "each" "counter" "removed" "this" "way" "."

/* An additional cost for each target beyond the first. */
/* @sem Ability::Casting(AdditionalCost{cost:$cost, repetition:TargetsBeyond(1)}) */
casting_cost_per_extra_target ::= "this" "spell" "costs" cost "more" "to" "cast" "for" "each" "target" "beyond" "the" "first" "."

/* A spell that can't be countered, while on the stack. */
/* @sem Ability::Scoped{zones:[Stack], ability:Static(_{kind:Ordinary, affected:Objects(Zone(_{scope:Shared(Stack), kind:Spell, filter:SameObject($object_ref)})), changes:[Rule(Prohibit(Counter))]})} */
casting_uncounterable ::= object_ref "can't" "be" "countered" "."

/* Spells already on the stack under your control can't be countered. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($cross_spells), changes:[Rule(Prohibit(Counter))]}) */
static_spells_uncounterable ::= cross_spells "can't" "be" "countered" "."

/* A reduction while a condition holds. */
/* @sem Ability::Casting(If{condition:$condition, rule:ReduceCost([_{amount:$braced_amount}])}) */
casting_reduction_if ::= "this" "spell" "costs" braced_amount "less" "to" "cast" "if" condition "."

/* A reduction when the spell targets a kind of permanent. */
/* @sem Ability::Casting(If{condition:TargetsMatch(_{object:$object_ref, kind:Permanent, filter:$filter_phrase}), rule:ReduceCost([_{amount:$braced_amount}])}) */
casting_reduction_if_targets ::= object_ref "costs" braced_amount "less" "to" "cast" "if" "it" "targets" "a" filter_phrase "."

/* A reduction of X, defined after. */
/* @sem Ability::Casting(ReduceCost([_{amount:$value}])) */
casting_reduction_x ::= "this" "spell" "costs" "{" "X" "}" "less" "to" "cast" "," "where" "X" "is" value "."

/* An alternative cost, perhaps only while a condition holds, before or after it. */
casting_alternative_cost ::= casting_alternative_plain | casting_alternative_if | casting_alternative_if_after

/* @sem Ability::Casting(AlternativeCost($alternative_payment)) */
casting_alternative_plain ::= "you" "may" alternative_payment rather_than_mana_cost "."

/* @sem Ability::Casting(If{condition:$condition, rule:AlternativeCost($alternative_payment)}) */
casting_alternative_if ::= "if" condition "," "you" "may" alternative_payment rather_than_mana_cost "."

/* @sem Ability::Casting(If{condition:$condition, rule:AlternativeCost($alternative_payment)}) */
casting_alternative_if_after ::= "you" "may" alternative_payment rather_than_mana_cost "if" condition "."

/* @sem () */
rather_than_mana_cost ::= "rather" "than" "pay" "this" "spell's" "mana" "cost"

/* The same payment for the spells you cast, not for this one: a rule of yours. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$your_cast_spells, modifier:Alternate{cost:Alternate(Cost($alternative_payment))}})]}) */
static_alternative_spell_cost ::= "you" "may" alternative_payment "rather" "than" "pay" "the" "mana" "cost" "for" your_cast_spells "."
your_cast_spells ::= your_cast_spells_any | your_cast_spells_kind
/* @sem ObjectFilter::Any */
your_cast_spells_any ::= "spells" "you" "cast"
/* @sem $spell_adjectives */
your_cast_spells_kind ::= spell_adjectives "spells" "you" "cast"

/* One payment, two joined by `and`, or mana the player pays: `you may pay {1}{U}`. */
alternative_payment ::= alternative_words | alternative_words_two | alternative_mana | alternative_mana_and_words

/* @sem Cost::Cost{parts:[$cost_words]} */
alternative_words ::= cost_words

/* @sem Cost::Cost{parts:[$cost_words, $cost_words_2]} */
alternative_words_two ::= cost_words "and" cost_words

/* @sem Cost::Cost{parts:[$cost_mana]} */
alternative_mana ::= "pay" cost_mana

/* "Pay {1} and return a basic land you control to its owner's hand": mana first. */
/* @sem Cost::Cost{parts:[$cost_mana, $cost_words]} */
alternative_mana_and_words ::= "pay" cost_mana "and" cost_words

/* Cast only while being attacked during declare attackers. */
/* @sem Ability::Casting(Require(AllOf([Window(DeclareAttackers), PlayerState{player:AbilityController, state:BeingAttacked}]))) */
casting_only_when_attacked ::= "cast" "this" "spell" "only" "during" "the" "declare" "attackers" "step" "and" "only" "if" "you've" "been" "attacked" "this" "step" "."

/* A casting timing restriction names its window. Conjoined parts keep their
   written order. */
/* @sem Ability::Casting(Require($cast_window)) */
casting_only_during ::= "cast" "this" "spell" "only" "during" cast_window "."
cast_window ::= cast_window_combat | cast_window_declare_blockers | cast_window_declare_attackers | cast_window_combat_after | cast_window_combat_before | cast_window_combat_opponent | cast_window_combat_yours | cast_window_combat_yours_before | cast_window_blockers_opponent | cast_window_your_attackers | cast_window_your_end_step | cast_window_your_turn | cast_window_opponent_turn | cast_window_opponent_upkeep | cast_window_opponent_after_upkeep | cast_window_opponent_before_attackers
/* @sem Condition::Window(Combat) */
cast_window_combat ::= "combat"
/* @sem Condition::Window(DeclareBlockers) */
cast_window_declare_blockers ::= "the" "declare" "blockers" "step"
/* @sem Condition::Window(DeclareAttackers) */
cast_window_declare_attackers ::= "the" "declare" "attackers" "step"
/* @sem Condition::AllOf([Window(Combat), Window(AfterBlockersDeclared)]) */
cast_window_combat_after ::= "combat" "after" "blockers" "are" "declared"
/* @sem Condition::AllOf([Window(Combat), Window(BeforeBlockersDeclared)]) */
cast_window_combat_before ::= "combat" "before" "blockers" "are" "declared"
/* @sem Condition::AllOf([Window(Combat), ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))}]) */
cast_window_combat_opponent ::= "combat" "on" "an" "opponent's" "turn"
/* @sem Condition::AllOf([PlayerIsActive(AbilityController), Window(Combat)]) */
cast_window_combat_yours ::= "combat" "on" "your" "turn"
/* @sem Condition::AllOf([PlayerIsActive(AbilityController), Window(Combat), Window(BeforeBlockersDeclared)]) */
cast_window_combat_yours_before ::= "combat" "on" "your" "turn" "before" "blockers" "are" "declared"
/* @sem Condition::AllOf([Window(DeclareBlockers), ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))}]) */
cast_window_blockers_opponent ::= "the" "declare" "blockers" "step" "on" "an" "opponent's" "turn"
/* @sem Condition::AllOf([PlayerIsActive(AbilityController), Window(DeclareAttackers)]) */
cast_window_your_attackers ::= "your" "declare" "attackers" "step"
/* @sem Condition::AllOf([PlayerIsActive(AbilityController), Window(EndStep)]) */
cast_window_your_end_step ::= "your" "end" "step"
/* @sem Condition::PlayerIsActive(AbilityController) */
cast_window_your_turn ::= "your" "turn"
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))} */
cast_window_opponent_turn ::= "an" "opponent's" "turn"
/* @sem Condition::AllOf([ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))}, Window(Upkeep)]) */
cast_window_opponent_upkeep ::= "an" "opponent's" "upkeep"
/* @sem Condition::AllOf([ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))}, Window(AfterUpkeep)]) */
cast_window_opponent_after_upkeep ::= "an" "opponent's" "turn" "after" "their" "upkeep" "step"
/* @sem Condition::AllOf([ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))}, Window(BeforeAttackersDeclared)]) */
cast_window_opponent_before_attackers ::= "an" "opponent's" "turn" "," "before" "attackers" "are" "declared"

/* Returning a permanent to its owner's hand as a cost. */
/* @sem CostPart::Move{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly(Constant(1))}], destination:OwnersHand(CardArrival{counters:[], states:[]})} */
cost_return_to_owners_hand ::= "return" ("a" | "an") filter_phrase "to" "its" "owner's" "hand"

/* Flash for an extra payment to cast it. */
/* @sem Ability::Casting(Flash{additional_cost:$cost}) */
casting_flash_paid ::= "you" "may" "cast" "this" "spell" "as" "though" "it" "had" "flash" "if" "you" "pay" cost "more" "to" "cast" "it" "."

/* Flash while a condition holds. */
/* @sem Ability::Casting(If{condition:$condition, rule:Flash{}}) */
casting_flash_if ::= "you" "may" "cast" "this" "spell" "as" "though" "it" "had" "flash" "if" condition "."
/* @sem Ability::Casting(If{condition:$condition, rule:Flash{}}) */
casting_flash_if_first ::= ("if" | "as" "long" "as") condition "," "you" "may" "cast" "this" "spell" "as" "though" "it" "had" "flash" "."
/* Casting for free while a condition holds. */
/* @sem Ability::Casting(If{condition:$condition, rule:AlternativeCost{parts:[]}}) */
casting_free_if_first ::= "if" condition "," "you" "may" "cast" "this" "spell" "without" "paying" "its" "mana" "cost" "."

/* Flash whose permanent, cast when a sorcery couldn't be, is sacrificed at the next cleanup step. */
/* @sem Ability::Casting(FlashWithRider(Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CleanupStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(ControllerOf(Earlier{what:SpellBecame})), objects:One(Earlier{what:SpellBecame})})}]}}}]})) */
casting_flash_sacrificed ::= "you" "may" "cast" "this" "spell" "as" "though" "it" "had" "flash" "." "if" "you" "cast" "it" "any" "time" "a" "sorcery" "couldn't" "have" "been" "cast" "," "the" "controller" "of" "the" "permanent" "it" "becomes" "sacrifices" "it" "at" "the" "beginning" "of" "the" "next" "cleanup" "step" "."

/* Cost parts taken over from seeded rules, in their original Oracle words. */
/* @sem CostPart::PutCounters([_{recipients:Objects(One($object_ref)), kind:$counter_kind, amount:Constant(1)}]) */
cost_put_counter_on ::= "put" "a" counter_kind "counter" "on" object_ref

/* @sem CostPart::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($object_ref)), amount:Count(Exactly(Constant(1)))}]} */
cost_remove_a_counter_from ::= "remove" "a" "counter" "from" object_ref

/* @sem CostPart::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($object_ref)), kind:$counter_kind, amount:All}]} */
cost_remove_all_counters_from ::= "remove" "all" counter_kind "counters" "from" object_ref

/* @sem CostPart::Repeated{part:Mana($mana_symbols), times:$count_each} */
cost_pay_for_each ::= "pay" mana_symbols "for" "each" count_each

/* @sem CostPart::Mill{count:$card_count} */
cost_mill ::= "mill" card_count

/* A limited alternative generic payment for a spell selected by origin and type. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$exile_cast_spell, modifier:Alternate{cost:Alternate($generic_alternative), limit:EachTurn(1)}})]}) */
static_once_alternative_exile_cost ::= "once" "each" "turn" "," "you" "may" "pay" generic_alternative "rather" "than" "pay" "the" "mana" "cost" "for" exile_cast_spell "."
/* @sem Operand::List([Term{family:ManaSymbol, form:ManaCostGeneric, operands:[Integer($number)]}]) */
generic_alternative ::= "{" NUMBER "}"

/* Participial costs following a permission to cast. */
cast_additional_cost_part ::= cast_discard_cost_part | cast_remove_among_cost_part

/* @sem CostPart::Discard{count:$card_count, filter:Any} */
cast_discard_cost_part ::= "discarding" card_count

/* @sem CostPart::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), amount:AmongThem(Exactly($value))}]} */
cast_remove_among_cost_part ::= "removing" value "counters" "from" "among" affected

/* A self card and an independently announced optional card move together. */
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:AnyOf([SameObject(Source), SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:AllOf([Not(SameObject(Source)), $noun, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0})])}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
self_return_and_optional_card ::= "return" "this" "card" "and" "up" "to" "one" "other" "target" noun "card" "from" "your" "graveyard" "to" "the" "battlefield"

/* A named object in a granted ability retains the granting source identity. */
/* @sem CostPart::Unattach($self_ref_named) */
cost_unattach_named_source ::= "unattach" self_ref_named
