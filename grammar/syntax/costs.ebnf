/* Costs and mana symbols. */
cost ::= cost_standard | cost_pay_mana_or_words | cost_reattach_player_subtype

cost_parts ::= cost_parts_one | cost_parts_more | cost_parts_and | cost_sacrifice_three | cost_remove_counters_and_sacrifice | cost_sacrifice_self_and_another | cost_sacrifice_self_and_one | cost_sacrifice_affected_and_many | cost_sacrifice_pair | cost_remove_counter_return | cost_remove_counters_return | cost_sacrifice_source_and_qualified | cost_sacrifice_two_and_self | cost_tap_controlled_and_sacrifice

/* "Remove three quest counters from this enchantment and sacrifice it": "it" is the
   source the counters come off. */
/* @sem CostPart::[$cost_remove_counters, CostPart::Sacrifice{objects:One(ObjectRef::Source)}] */
cost_remove_counters_and_sacrifice ::= cost_remove_counters "and" "sacrifice" "it"

/* @sem CostPart::[$cost_part] */
cost_parts_one ::= cost_part

/* @sem CostPart::[$cost_part, ...$cost_parts_later] */
cost_parts_more ::= cost_part "," cost_parts_later

cost_parts_later ::= cost_parts_one_later | cost_parts_more_later | cost_parts_and_later | cost_sacrifice_three_later | cost_sacrifice_many_and_self | cost_sacrifice_self_and_many | cost_exile_many_and_self | cost_sacrifice_self_and_another_later | cost_remove_counters_and_sacrifice_later | cost_sacrifice_pair_later | cost_remove_counter_return_later | cost_remove_counters_return_later | cost_sacrifice_source_and_qualified_later

/* @sem CostPart::[CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:Exactly($count)}, CostPart::Sacrifice{objects:One(ObjectRef::Source)}] */
cost_sacrifice_many_and_self ::= "↑" "sacrifice" count filter_plural "and" self_text

/* @sem CostPart::[CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, choose:Exactly($count)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}, CostPart::Move{selections:[CostObjectSelection{objects:One(ObjectRef::Source)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}] */
cost_exile_many_and_self ::= "↑" "exile" count "cards" "from" "your" "graveyard" "and" self_text

/* @sem CostPart::[$cost_part_later] */
cost_parts_one_later ::= cost_part_later

/* @sem CostPart::[$cost_part_later, ...$cost_parts_later] */
cost_parts_more_later ::= cost_part_later "," cost_parts_later

cost_part_later ::= cost_symbols | cost_word_later

/* @sem $cost_words */
cost_word_later ::= "↑" cost_words

cost_part ::= cost_symbols | cost_words | cost_three_word_choices

cost_symbols ::= cost_mana | cost_tap | cost_untap_symbol

cost_words ::= mined_cost | cost_words_owned

/* Explicit verb-led payments exclude mined mana-only shorthand. */
cost_words_owned ::= cost_exile_graveyard_equal_value | cost_exile_graveyard_mana_value | cost_exile_graveyard_selection | cost_opponent_token_creation | cost_energy | cost_life | cost_blight | cost_pay_repeated_mana | cost_sacrifice_self | cost_sacrifice | cost_sacrifice_another | cost_sacrifice_many | cost_discard | cost_discard_filtered | cost_discard_many | cost_tap_untapped | cost_tap_untapped_many | cost_tap_another_untapped | cost_exile_permanent | cost_exile_graveyard | cost_exile_card_graveyard | cost_exile_cards_graveyard | cost_exile_kind_cards_graveyard | cost_exile_hand | cost_discard_random | cost_remove_pt_counter | cost_life_half | cost_discard_filtered_many | cost_discard_hand | cost_return_self | cost_exile_self | cost_remove_counters | cost_remove_any_counters | cost_collect_evidence | cost_exert | cost_discard_either_kind | cost_exile_top | cost_exile_graveyard_top | cost_return_many | cost_sacrifice_another_or | cost_reveal_self_hand | cost_behold | cost_behold_many | cost_behold_exile | cost_waterbend | cost_put_counter_on | cost_remove_a_counter_from | cost_remove_all_counters_from | cost_pay_for_each | cost_mill | cost_unattach_named_source | cost_constrained_selection | cost_exile_hand_selection | cost_put_counter_on_selected | cost_tap_counted_filter | cost_untap_counted_filter | cost_untap_single_filter | cost_reveal_filtered_hand | cost_return_to_owners_hand | cost_discard_postmodified | cost_discard_referenced_card | cost_object_action | cost_discard_either_card | cost_exile_any_graveyard_kind | cost_sacrifice_affected | cost_pay_mana_any_number | cost_add_mana | cost_sacrifice_half | cost_opponent_gains_life | cost_player_action_shared | cost_choose_number_between | cost_performed_library_move | cost_flip_coin_series | cost_choose_type_action | cost_exile_single_graveyard_selection | cost_exile_top_one | cost_or_choice | cost_exile_hand_mana_value_one | cost_exile_hand_mana_value_many | cost_put_exiled_card_graveyard | cost_remove_selected_counter | cost_remove_selected_named_counter | cost_exile_top_card | cost_remove_unspecified_count | cost_remove_unspecified_among | cost_remove_kind_among | cost_remove_kind_at_least_among | cost_remove_kind_count | cost_tap_named_source | cost_roll_die | cost_exile_card_hand | cost_sacrifice_description | cost_life_measured | cost_reveal_announced_hand_selection | cost_tap_any_population | cost_have_player_gain_control | cost_put_single_graveyard_cards | cost_sacrifice_copy_receipt | cost_return_unblocked_attacker | cost_reveal_chosen_value | cost_sacrifice_up_to | cost_mana_or_word_payment | cost_discard_or_qualified_card | cost_remove_one_of_two_counter_kinds | cost_remove_selected_count

/* Waterbend {N}: tapped artifacts and creatures pay for that generic mana. */
/* @sem CostPart::Waterbend($mana_symbols) */
cost_waterbend ::= "waterbend" mana_symbols

/* CR 701.61: behold a creature type, by choosing such a permanent you
   control or revealing such a card from your hand. */
/* @sem CostPart::Behold{count:Constant(1), what:$behold_kind} */
cost_behold ::= "behold" ("a" | "an") behold_kind
/* "Behold three Elementals": one is "behold an Elemental". */
/* @sem CostPart::Behold{count:@plural_amount($value), what:$behold_kinds} */
cost_behold_many ::= "behold" value behold_kinds
/* @sem CostPart::BeholdAndExile($behold_kind) */
cost_behold_exile ::= "behold" ("a" | "an") behold_kind "and" "exile" "it"
behold_kind ::= behold_type | behold_type_creature
/* @sem Operand::Term{family:CardsInHand, form:IsCreatureType, operands:[Vocabulary{family:CreatureType, form:@subtype_name($creature_subtype)}]} */
behold_type ::= creature_subtype
/* @sem Operand::Term{family:CardsInHand, form:And, operands:[Term{family:CardsInHand, form:IsCreatureType, operands:[Vocabulary{family:CreatureType, form:@subtype_name($creature_subtype)}]}, Term{family:CardsInHand, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Creature}]}]} */
behold_type_creature ::= creature_subtype "creature"
/* @sem Operand::Term{family:CardsInHand, form:IsCreatureType, operands:[Vocabulary{family:CreatureType, form:@subtype_name($subtype_plural)}]} */
behold_kinds ::= subtype_plural

/* @sem CostPart::Reveal{count:Exactly(Constant(1)), filter:SameObject($self_explicit_ref)} */
cost_reveal_self_hand ::= "reveal" self_explicit_ref "from" "your" "hand"

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:One(ObjectRef::Source)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_self ::= "exile" self_text

/* An ability paid by moving this card out of a zone works only from that zone. */
activated_from_zone ::= activated_reveal_self_hand_limited | activated_suspended_source | activated_exile_self_after_limited | activated_graveyard_quoted_limited | activated_exile_self | activated_exile_self_after | activated_discard_self | activated_discard_self_after | activated_graveyard_return | activated_graveyard_return_limited | activated_discard_self_after_population_limited | activated_discard_self_population_limited | activated_exile_self_limited | activated_discard_self_limited | activated_discard_self_after_limited | activated_exile_self_and_named_limited

/* Returning this card explicitly from the graveyard scopes the whole
   activation there, including any preceding action and its announced targets. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[...$instructions, $graveyard_self_hand]}})} */
activated_graveyard_return ::= cost ":" instructions "." graveyard_self_hand "."

/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:Program{instructions:[...$instructions, $graveyard_self_hand]}})} */
activated_graveyard_return_limited ::= cost ":" instructions "." graveyard_self_hand "." activation_limits "."

/* @sem Instruction::Effect{result:@next, operation:Move{objects:One(@self), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}} */
graveyard_self_hand ::= "return" "this" "card" "from" "your" "graveyard" "to" "your" "hand"

/* Exiling this card from your hand or graveyard is a cost paid there, so the
   ability works only in that zone. */
/* @sem Ability::Scoped{zones:[$your_zone], ability:@scope(Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[CostPart::Move{selections:[CostObjectSelection{objects:One(ObjectRef::Source)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}, limits:ActivationLimits{}, announcement:@announcement, body:$program})} */
activated_exile_self ::= "exile" self_text "from" your_zone ":" program "."

/* @sem Ability::Scoped{zones:[$your_zone], ability:@scope(Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[...$cost_parts, CostPart::Move{selections:[CostObjectSelection{objects:One(ObjectRef::Source)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}, limits:ActivationLimits{}, announcement:@announcement, body:$program})} */
activated_exile_self_after ::= cost_parts "," "↑" "exile" self_text "from" your_zone ":" program "."

/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[CostPart::Discard{count:Expr::Constant(1), filter:SameObject(ObjectRef::Source)}]}, limits:ActivationLimits{}, announcement:@announcement, body:$program})} */
activated_discard_self ::= "discard" self_text ":" program "."

/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[...$cost_parts, CostPart::Discard{count:Expr::Constant(1), filter:SameObject(ObjectRef::Source)}]}, limits:ActivationLimits{}, announcement:@announcement, body:$program_sentence})} */
activated_discard_self_after ::= cost_parts "," "↑" "discard" self_text ":" program_sentence

/* @sem CostPart::RemoveCounters{removals:[CounterRemoval{player:AbilityController, recipients:Objects(One($self_explicit_ref)), kind:$counter_kind, amount:Count(Exactly($counter_amount))}]} */
cost_remove_counters ::= "remove" counter_amount counter_kind ("counter" | "counters") "from" self_explicit_ref

/* @sem CostPart::RemoveCounters{removals:[CounterRemoval{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:Count(AnyNumber)}]} */
cost_remove_any_counters ::= "remove" "any" "number" "of" counter_kind "counters" "from" affected

/* @sem CostPart::TapSymbol */
cost_tap ::= "{T}"

/* @sem CostPart::Life($number) */
cost_life ::= "pay" number "life"

/* @sem CostPart::Sacrifice{objects:One($self_explicit_ref)} */
cost_sacrifice_self ::= "sacrifice" self_explicit_ref

/* @sem CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly(Expr::Constant(1))} */
cost_sacrifice ::= "sacrifice" ("a" | "an") filter_phrase

/* Exiling a permanent as a cost: one of the described permanents on the battlefield. */
/* @sem CostPart::Move{selections:$cost_permanent_selections, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_permanent ::= "exile" cost_permanent_selections

/* @sem CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $filter_phrase)}, choose:Exactly(Expr::Constant(1))} */
cost_sacrifice_another ::= "sacrifice" "another" filter_phrase

/* @sem CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:Exactly($count)} */
cost_sacrifice_many ::= "sacrifice" count filter_plural

/* @sem CostPart::Discard{count:Expr::Constant(1), filter:Any} */
cost_discard ::= "discard" ("a" | "an") "card"

/* @sem CostPart::Discard{count:Expr::Constant(1), filter:$card_filter} */
cost_discard_filtered ::= "discard" ("a" | "an") card_filter "card"

/* @sem CostPart::Discard{count:$count, filter:Any} */
cost_discard_many ::= "discard" count "cards"

/* @sem CostPart::ChangeTapState{selections:[CostObjectSelection{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::Tapped), $filter_phrase)}, choose:Exactly(Expr::Constant(1))}], tapped:true} */
cost_tap_untapped ::= "tap" ("a" | "an") "untapped" filter_phrase

/* @sem CostPart::ChangeTapState{selections:[CostObjectSelection{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::Tapped), $filter_plural)}, choose:Exactly($count)}], tapped:true} */
cost_tap_untapped_many ::= "tap" count "untapped" filter_plural

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:$card_filter}, choose:Exactly(Expr::Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_graveyard ::= "exile" ("a" | "an") card_filter "card" "from" "your" "graveyard"

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, choose:Exactly(Expr::Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_card_graveyard ::= "exile" "a" "card" "from" "your" "graveyard"

/* Exiling a card of a kind from your hand. */
/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Hand, players:One(PlayerRef::AbilityController)}, kind:Card, filter:$card_filter}, choose:Exactly(Expr::Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_hand ::= "exile" ("a" | "an") card_filter "card" "from" "your" "hand"

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, choose:Exactly($count)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_cards_graveyard ::= "exile" count "cards" "from" "your" "graveyard"

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:$card_filter}, choose:Exactly($count)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_kind_cards_graveyard ::= "exile" count card_filter "cards" "from" "your" "graveyard"

/* @sem CostPart::Discard{count:$count_or_a, filter:Any, random:true} */
cost_discard_random ::= "discard" count_or_a "at" "random"

count_or_a ::= count_a_card | count_cards

/* @sem Expr::Constant(1) */
count_a_card ::= "a" "card"

/* @sem $count */
count_cards ::= count "cards"

/* @sem CostPart::RemoveCounters{removals:[CounterRemoval{player:AbilityController, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}), kind:PowerToughness(1, 1), amount:Count(Exactly(Expr::Constant(1))), selection:SelectionChoice{player:AbilityController, count:Exactly(Expr::Constant(1))}}]} */
cost_remove_pt_counter ::= "remove" "a" "+" "1" "/" "+" "1" "counter" "from" ("a" | "an") filter_phrase

/* @sem CostPart::Discard{count:$count, filter:$card_filter} */
cost_discard_filtered_many ::= "discard" count card_filter "cards"

/* @sem CostPart::DiscardHand */
cost_discard_hand ::= "discard" "your" "hand"

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:One(ObjectRef::Source)}], destination:OwnersHand(CardArrival{counters:[], states:[]})} */
cost_return_self ::= "return" self_text "to" "its" "owner's" "hand"

/* @sem CostPart::Discard{count:Expr::Constant(1), filter:AnyOf(@unordered([$card_filter, $card_filter_2]))} */
cost_discard_either_kind ::= "discard" ("a" | "an") card_filter "card" "or" card_filter "card"

/* @sem CostPart::Exert(ObjectRef::Source) */
cost_exert ::= "exert" self_text

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:@plural_amount($number), from:Top}, choose:Exactly(@plural_amount($number))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_top ::= "exile" "the" "top" number "cards" "of" "your" "library"

/* "Exile the top creature card of your graveyard": the card the graveyard's order and
   the written kind pick out, not a chosen one. The kind filters the graveyard before
   its top card is taken. */
cost_exile_graveyard_top ::= cost_exile_graveyard_card | cost_exile_graveyard_kind
/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Take{objects:Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:Expr::Constant(1), from:$ordered_end}}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_graveyard_card ::= "exile" "the" ordered_end "card" "of" "your" "graveyard"
/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Take{objects:Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:$card_filter}, count:Expr::Constant(1), from:$ordered_end}}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_graveyard_kind ::= "exile" "the" ordered_end card_filter "card" "of" "your" "graveyard"

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:Exactly($count)}], destination:OwnersHand(CardArrival{counters:[], states:[]})} */
cost_return_many ::= "return" count filter_plural "to" "their" "owner's" "hand"

/* @sem CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $noun), $filter_phrase])}, choose:Exactly(Expr::Constant(1))} */
cost_sacrifice_another_or ::= "sacrifice" "another" noun "or" ("a" | "an") filter_phrase

/* @sem CostPart::Keyword{action:CollectEvidence, amount:$evidence_amount} */
cost_collect_evidence ::= "collect" "evidence" evidence_amount

/* @sem CostPart::Life(Expr::Divide{numerator:Expr::PlayerNumber{player:PlayerRef::AbilityController, number:Life}, denominator:Expr::Constant(2), rounding:$rounding_words}) */
cost_life_half ::= "pay" "half" "your" "life" "," rounding_words

/* @sem CostPart::Mana($mana_symbols) */
cost_mana ::= mana_symbols

mana_symbols ::= mana_symbols_one | mana_symbols_more

/* @sem ManaSymbol::[$mana_symbol] */
mana_symbols_one ::= mana_symbol

/* @sem ManaSymbol::[$mana_symbol, ...$mana_symbols] */
mana_symbols_more ::= mana_symbol mana_symbols

mana_symbol ::= mana_colorless | mana_generic | mana_white | mana_blue | mana_black | mana_red | mana_green | mana_x | mana_snow
    | mana_hybrid | mana_phyrexian

/* @sem ManaSymbol::Snow */
mana_snow ::= "{S}"

/* @sem ManaSymbol::Hybrid($mana_letter, $mana_letter_2) */
mana_hybrid ::= "{" mana_letter "/" mana_letter "}"

/* A colored symbol that can be paid with 2 life instead. */
/* @sem ManaSymbol::Phyrexian([$mana_letter]) */
mana_phyrexian ::= "{" mana_letter "/" "P" "}"

mana_letter ::= letter_white | letter_blue | letter_black | letter_red | letter_green

/* @sem ManaColor::White */
letter_white ::= "W"
/* @sem ManaColor::Blue */
letter_blue ::= "U"
/* @sem ManaColor::Black */
letter_black ::= "B"
/* @sem ManaColor::Red */
letter_red ::= "R"
/* @sem ManaColor::Green */
letter_green ::= "G"

/* @sem ManaSymbol::Generic($number) */
mana_generic ::= "{" NUMBER "}"

/* An amount of generic mana, as in `cost {2} less`. */
braced_amount ::= braced_number | braced_x
/* @sem Expr::Constant($number) */
braced_number ::= "{" NUMBER "}"
/* @sem Expr::AnnouncedX */
braced_x ::= "{" "X" "}"

/* The printed generic reduction is a factor, not the number of counted objects;
   {1} for each is the count itself. */
/* @sem Ability::Casting(ReduceCost([_{amount:@times($braced_number, $casting_reduction_count)}])) */
casting_reduction_each ::= "this" "spell" "costs" braced_number "less" "to" "cast" "for" "each" casting_reduction_count "."

/* A following reduction modifies the offered payment, before deciding whether
   the holder is sacrificed. It cannot create a second sacrifice instruction. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:_{parts:[ManaReducedForEach{mana:$mana_symbols, reduction:$generic_reduction_symbols, per:$count_each}]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:_{instructions:[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:One($self_ref)}}]}, otherwise:_{}}]} */
program_sentence_reduced_payment ::= "sacrifice" self_ref "unless" "you" "pay" mana_symbols "." "this" "cost" "is" "reduced" "by" generic_reduction_symbols "for" "each" count_each "."

/* @sem Operand::List([Term{family:CostReductionSymbol, form:CostReduceGeneric, operands:[Integer($number)]}]) */
generic_reduction_symbols ::= "{" NUMBER "}"

/* @sem ManaSymbol::Color(White) */
mana_white ::= "{W}"
/* @sem ManaSymbol::Color(Blue) */
mana_blue ::= "{U}"
/* @sem ManaSymbol::Color(Black) */
mana_black ::= "{B}"
/* @sem ManaSymbol::Color(Red) */
mana_red ::= "{R}"
/* @sem ManaSymbol::Color(Green) */
mana_green ::= "{G}"
/* @sem ManaSymbol::X */
mana_x ::= "{X}"

/* @sem ManaSymbol::Color(Colorless) */
mana_colorless ::= "{C}"

/* Another excludes the current ability holder without implying a card type. */
/* @sem CostPart::ChangeTapState{selections:[CostObjectSelection{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), ObjectFilter::Not(ObjectFilter::Tapped), $filter_phrase)}, choose:Exactly(Expr::Constant(1))}], tapped:true} */
cost_tap_another_untapped ::= "tap" "another" "untapped" filter_phrase

/* Each condition independently reduces the source spell's generic cost.
   The continuation is not a conjunctive condition or an additional game action. */
conditional_casting_reductions ::= conditional_reductions_compact | conditional_reductions_sentences
/* @sem Ability::[Casting(If{condition:$condition, rule:ReduceCost([_{amount:$braced_amount}])}), Casting(If{condition:$condition_2, rule:ReduceCost([_{amount:$braced_amount_2}])})] */
conditional_reductions_compact ::= "this" "spell" "costs" braced_amount "less" "to" "cast" "if" condition "and" braced_amount "less" "to" "cast" "if" condition "."
/* @sem Ability::[Casting(If{condition:$condition, rule:ReduceCost([_{amount:$braced_amount}])}), Casting(If{condition:$condition_2, rule:ReduceCost([_{amount:$braced_amount_2}])})] */
conditional_reductions_sentences ::= "this" "spell" "costs" braced_amount "less" "to" "cast" "if" condition "." "it" "also" "costs" braced_amount "less" "to" "cast" "if" condition "."

/* Named cost actions are performed by the payer of their enclosing Cost. */
/* @sem CostPart::Keyword{action:Blight, amount:$value} */
cost_blight ::= "blight" value

/* The number repeats the printed mana unit; it is not generic mana. */
/* @sem CostPart::Repeated{part:Mana($mana_symbols), times:$number} */
cost_pay_repeated_mana ::= "pay" number mana_symbols


/* A resolving instruction modifies one future spell, not this permanent or
   every later spell. Omitting "this turn" retains the pending modifier. */
/* @sem Operation::ChangeSpell{subject:$next_cost_subject, changes:[SpellCost(Reduce{reductions:[_{amount:$braced_number}], spill_into_generic:true})]} */
next_filtered_spell_reduction ::= next_cost_subject "costs" braced_number "less" "to" "cast"

next_cost_subject ::= next_cost_filtered_turn | next_cost_filtered_pending | next_cost_any_turn | next_cost_any_pending
/* @sem SpellSubject::Next{spells:$next_cost_filter, player:AbilityController, this_turn:true, from_hand:false} */
next_cost_filtered_turn ::= "the" "next" next_cost_filter "spell" "you" "cast" "this" "turn"
/* @sem SpellSubject::Next{spells:$next_cost_filter, player:AbilityController, this_turn:false, from_hand:false} */
next_cost_filtered_pending ::= "the" "next" next_cost_filter "spell" "you" "cast"
/* @sem SpellSubject::Next{spells:Any, player:AbilityController, this_turn:true, from_hand:false} */
next_cost_any_turn ::= "the" "next" "spell" "you" "cast" "this" "turn"
/* @sem SpellSubject::Next{spells:Any, player:AbilityController, this_turn:false, from_hand:false} */
next_cost_any_pending ::= "the" "next" "spell" "you" "cast"

next_cost_filter ::= filter_phrase | adjective_nontype

/* A final quoted ability's period closes the activation body. The following
   activation limit belongs to the outer ability, not to the granted holder. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:$program_sentence_quoted})} */
activated_graveyard_quoted_limited ::= cost "from" "your" "graveyard" ":" program_sentence_quoted activation_limits "."

/* The chosen opponent performs this cost action. The body repeats that same
   actor operand; it is not token creation by the ability's controller. */
/* @sem CostPart::PlayerAction{player:$cost_token_actor, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One($cost_token_actor), tokens:$token_groups, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}} */
cost_opponent_token_creation ::= "have" cost_token_actor "create" token_groups
/* @sem PlayerRef::OneOf(OpponentsOf(AbilityController)) */
cost_token_actor ::= "an" "opponent"

/* A written this-card exile cost proves the holder's activation zone.
   Following restrictions apply to the same complete activated ability. */
/* @sem Ability::Scoped{zones:[$your_zone], ability:@scope(Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[...$cost_parts, Move{selections:[_{objects:One(Source)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}}]}, limits:$activation_limits, announcement:@announcement, body:$program_sentence})} */
activated_exile_self_after_limited ::= cost_parts "," "↑" "exile" "this" "card" "from" your_zone ":" program_sentence activation_limits "."

/* An ability that returns its own card from your graveyard works there. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$self_graveyard_return}]}})} */
activated_self_graveyard_return ::= cost ":" self_graveyard_return "."
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$self_graveyard_return}]}})} */
activated_self_graveyard_return_limited ::= cost ":" self_graveyard_return "." activation_limits "."
self_graveyard_return ::= self_return_battlefield_tapped_attacking | self_return_battlefield_tapped_attacking_counter | self_return_and_optional_card | self_return_hand | self_return_battlefield | self_return_battlefield_attached | self_return_battlefield_tapped | self_return_battlefield_counter | self_return_battlefield_tapped_counter | self_return_battlefield_transformed | self_return_battlefield_face_choice | self_return_with_target_tapped
/* @sem Operation::Move{objects:One($self_ref), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
self_return_hand ::= "return" self_ref "from" "your" "graveyard" "to" "your" "hand"
/* @sem Operation::Move{objects:One($self_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
self_return_battlefield ::= "return" self_ref "from" "your" "graveyard" "to" "the" "battlefield"
/* An Aura returns attached to its new host. */
/* @sem Operation::Move{objects:One($self_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo($object_ref)]}}, qualifiers:[]} */
self_return_battlefield_attached ::= "return" self_ref "from" "your" "graveyard" "to" "the" "battlefield" "attached" "to" object_ref
/* @sem Operation::Move{objects:One($self_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]} */
self_return_battlefield_tapped ::= "return" self_ref "from" "your" "graveyard" "to" "the" "battlefield" "tapped"
/* @sem Operation::Move{objects:One($self_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, $entry_counter_amount]], states:[]}}, qualifiers:[]} */
self_return_battlefield_counter ::= "return" self_ref "from" "your" "graveyard" "to" "the" "battlefield" "with" entry_counter_amount counter_kind "counter" "on" "it"
/* @sem Operation::Move{objects:One($self_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[[$counter_kind, $entry_counter_amount]], states:[]}}, qualifiers:[]} */
self_return_battlefield_tapped_counter ::= "return" self_ref "from" "your" "graveyard" "to" "the" "battlefield" "tapped" "with" entry_counter_amount counter_kind "counter" "on" "it"

/* An ability that puts its own card from your hand or graveyard somewhere
   else works only while the card is in that zone. Oracle text returns a card
   from a graveyard to the battlefield (`self_return_battlefield`) but puts one
   from a hand onto it, so only the hand takes the plain battlefield here. */
/* @sem Ability::Scoped{zones:[$your_zone], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Source), destination:$self_put_destination, qualifiers:[]}}]}})} */
activated_self_zone_put ::= cost ":" "put" "this" "card" "from" your_zone self_put_destination "."
/* @sem Ability::Scoped{zones:[$your_zone], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Source), destination:$self_put_destination, qualifiers:[]}}]}})} */
activated_self_zone_put_limited ::= cost ":" "put" "this" "card" "from" your_zone self_put_destination "." activation_limits "."
/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Source), destination:$self_put_battlefield, qualifiers:[]}}]}})} */
activated_self_hand_put ::= cost ":" "put" "this" "card" "from" "your" "hand" self_put_battlefield "."
/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Source), destination:$self_put_battlefield, qualifiers:[]}}]}})} */
activated_self_hand_put_limited ::= cost ":" "put" "this" "card" "from" "your" "hand" self_put_battlefield "." activation_limits "."
self_put_destination ::= self_put_top | self_put_depth | self_put_battlefield_transformed
/* @sem MovementDestination::Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
self_put_top ::= "on" "top" "of" "your" "library"
/* @sem MovementDestination::Library{position:FromTop($library_depth), order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
self_put_depth ::= "into" "your" "library" library_depth "from" "the" "top"
self_put_battlefield ::= self_put_battlefield_plain | self_put_battlefield_tapped_attacking
/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:$transformed_entry} */
self_put_battlefield_transformed ::= "onto" "the" "battlefield" transformed_entry

/* An additional cost to cast this spell. */
/* @sem Ability::Casting(AdditionalCost{cost:$casting_additional_payment, repetition:Once}) */
casting_additional_cost ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," casting_additional_payment "."

/* An additional cost with a choice of payments. */
/* @sem Ability::Casting(AdditionalCost{cost:_{parts:[Choice([$casting_payment_before_alternative, $cost])]}, repetition:Once}) */
casting_additional_cost_choice ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," casting_payment_before_alternative "or" "pay" cost "."

/* An optional additional cost. */
/* @sem Ability::Casting(AdditionalCost{cost:$cost, optional:true, repetition:Once}) */
casting_optional_additional_cost ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "you" "may" cost "."

/* Any number of one optional payment, each buying "{N} less": the spell's cost falls
   by one reduction for each single payment, so the rule records the single unit. */
casting_reduce_for_each_paid ::= reduce_collect_evidence | reduce_sacrifice_creatures | reduce_sacrifice_permanents | reduce_tap_creatures | reduce_exile_graveyard_cards | reduce_exile_hand_cards | reduce_remove_counters
/* @sem () */
optional_cost_opening ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "you" "may"
/* @sem () */
reduce_for_each_opening ::= "." "this" "spell" "costs"
/* @sem Ability::Casting(ReduceForEachPaid{reductions:[_{amount:$braced_amount}], cost:_{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:Exactly(Constant(1))}]}}) */
reduce_sacrifice_creatures ::= optional_cost_opening "sacrifice" "any" "number" "of" "creatures" reduce_for_each_opening braced_amount "less" "to" "cast" "for" "each" "creature" "sacrificed" "this" "way" "."
/* @sem Ability::Casting(ReduceForEachPaid{reductions:[_{amount:$braced_amount}], cost:_{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:Exactly(Constant(1))}]}}) */
reduce_sacrifice_permanents ::= optional_cost_opening "sacrifice" "any" "number" "of" filter_plural reduce_for_each_opening braced_amount "less" "to" "cast" "for" "each" "permanent" "sacrificed" "this" "way" "."
/* @sem Ability::Casting(ReduceForEachPaid{reductions:[_{amount:$braced_amount}], cost:_{parts:[ChangeTapState{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:Exactly(Constant(1))}], tapped:true, symbol:false}]}}) */
reduce_tap_creatures ::= optional_cost_opening "tap" "any" "number" "of" filter_plural reduce_for_each_opening braced_amount "less" "to" "cast" "for" "each" "creature" "tapped" "this" "way" "."
/* @sem Ability::Casting(ReduceForEachPaid{reductions:[_{amount:$braced_amount}], cost:_{parts:[Move{selections:[_{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$card_filter}, choose:Exactly(Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}) */
reduce_exile_graveyard_cards ::= optional_cost_opening "exile" "any" "number" "of" card_filter "cards" "from" "your" "graveyard" reduce_for_each_opening braced_amount "less" "to" "cast" "for" "each" "card" "exiled" "this" "way" "."
/* @sem Ability::Casting(ReduceForEachPaid{reductions:[_{amount:$braced_amount}], cost:_{parts:[Move{selections:[_{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}, choose:Exactly(Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}) */
reduce_exile_hand_cards ::= optional_cost_opening "exile" "any" "number" "of" card_filter "cards" "from" "your" "hand" reduce_for_each_opening braced_amount "less" "to" "cast" "for" "each" "card" "exiled" "this" "way" "."
/* @sem Ability::Casting(ReduceForEachPaid{reductions:[_{amount:$braced_amount}], cost:_{parts:[RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}), kind:$counter_kind, amount:Count(Exactly(Constant(1))), selection:_{player:AbilityController, count:Exactly(Constant(1))}}]}]}}) */
reduce_remove_counters ::= optional_cost_opening "remove" "any" "number" "of" counter_kind "counters" "from" "among" filter_plural reduce_for_each_opening braced_amount "less" "to" "cast" "for" "each" "counter" "removed" "this" "way" "."

/* An additional cost for each target beyond the first. */
/* @sem Ability::Casting(AdditionalCost{cost:$cost, repetition:TargetsBeyond(1)}) */
casting_cost_per_extra_target ::= "this" "spell" "costs" cost "more" "to" "cast" "for" "each" "target" "beyond" "the" "first" "."

/* A spell that can't be countered, while on the stack. */
/* @sem Ability::Scoped{zones:[Stack], ability:Static(_{kind:Ordinary, affected:Objects(Zone(_{scope:Shared(Stack), kind:Spell, filter:SameObject($object_ref)})), changes:[Rule(Prohibit(Counter))]})} */
casting_uncounterable ::= object_ref "can't" "be" "countered" "."

/* Spells already on the stack under your control can't be countered. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($cross_spells), changes:[Rule(Prohibit(Counter))]}) */
static_spells_uncounterable ::= cross_spells "can't" "be" "countered" "."

/* A reduction while a condition holds. */
/* @sem Ability::Casting(If{condition:$condition, rule:ReduceCost([_{amount:$braced_amount}])}) */
casting_reduction_if ::= "this" "spell" "costs" braced_amount "less" "to" "cast" ("if" | "as" "long" "as") condition "."

/* A cost adjustment when the spell targets a kind of permanent. */
/* @sem Ability::Casting(If{condition:TargetsMatch(_{object:$object_ref, kind:Permanent, filter:$filter_phrase}), rule:$target_cast_cost_adjustment}) */
casting_reduction_if_targets ::= object_ref target_cast_cost_adjustment "if" "it" "targets" "a" filter_phrase "."

/* A reduction of X, defined after. */
/* @sem Ability::Casting(ReduceCost([_{amount:$value}])) */
casting_reduction_x ::= "this" "spell" "costs" "{" "X" "}" "less" "to" "cast" "," "where" "X" "is" value "."

/* An alternative cost, perhaps only while a condition holds, before or after it. */
casting_alternative_cost ::= casting_alternative_plain | casting_alternative_if | casting_alternative_if_after | casting_alternative_if_preposed | casting_alternative_if_prefix | casting_alternative_treasure

/* @sem Ability::Casting(AlternativeCost($alternative_payment)) */
casting_alternative_plain ::= "you" "may" alternative_payment rather_than_mana_cost "."

/* @sem Ability::Casting(If{condition:$condition, rule:AlternativeCost($alternative_payment)}) */
casting_alternative_if ::= "if" condition "," "you" "may" alternative_payment rather_than_mana_cost "."

/* @sem Ability::Casting(If{condition:$condition, rule:AlternativeCost($alternative_payment)}) */
casting_alternative_if_after ::= "you" "may" alternative_payment rather_than_mana_cost "if" condition "."

/* @sem () */
rather_than_mana_cost ::= "rather" "than" "pay" "this" "spell's" "mana" "cost"

/* The same payment for the spells you cast, not for this one: a rule of yours. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$your_cast_spells, modifier:Alternate{cost:Alternate(Cost($alternative_payment))}})]}) */
static_alternative_spell_cost ::= "you" "may" alternative_payment "rather" "than" "pay" "the" "mana" "cost" "for" your_cast_spells "."
your_cast_spells ::= your_cast_spells_any | your_cast_spells_kind
/* @sem ObjectFilter::Any */
your_cast_spells_any ::= "spells" "you" "cast"
/* @sem $spell_adjectives */
your_cast_spells_kind ::= spell_adjectives "spells" "you" "cast"

/* One payment, two joined by `and`, or mana the player pays: `you may pay {1}{U}`. */
alternative_payment ::= alternative_discard_filtered_and_another | alternative_discard_filtered_and_others | alternative_words | alternative_words_two | alternative_mana | alternative_mana_and_words | alternative_other_players_gain_life | alternative_have_gain_life

/* @sem Cost::Cost{parts:[$cost_words]} */
alternative_words ::= cost_words

/* @sem Cost::Cost{parts:[$cost_words, $cost_words_2]} */
alternative_words_two ::= cost_words "and" cost_words

/* @sem Cost::Cost{parts:[$cost_mana]} */
alternative_mana ::= "pay" cost_mana

/* "Pay {1} and return a basic land you control to its owner's hand": mana first. */
/* @sem Cost::Cost{parts:[$cost_mana, $cost_words]} */
alternative_mana_and_words ::= "pay" cost_mana "and" cost_words

/* Cast only while being attacked during declare attackers. */
/* @sem Ability::Casting(Require($window_attacked_declare_attackers)) */
casting_only_when_attacked ::= "cast" "this" "spell" "only" window_attacked_declare_attackers "."

/* A casting timing restriction names its window. Conjoined parts keep their
   written order. */
/* @sem Ability::Casting(Require($cast_timing)) */
casting_only_during ::= "cast" "this" "spell" "only" cast_timing "."
cast_window ::= cast_window_combat | cast_window_declare_blockers | cast_window_declare_attackers | cast_window_combat_after | cast_window_combat_before | cast_window_combat_opponent | cast_window_combat_yours | cast_window_combat_yours_before | cast_window_blockers_opponent | cast_window_your_attackers | cast_window_your_end_step | cast_window_your_turn | cast_window_opponent_turn | cast_window_opponent_upkeep | cast_window_opponent_after_upkeep | cast_window_opponent_before_attackers
/* @sem Condition::Window(Combat) */
cast_window_combat ::= "combat"
/* @sem Condition::Window(DeclareBlockers) */
cast_window_declare_blockers ::= "the" "declare" "blockers" "step"
/* @sem Condition::Window(DeclareAttackers) */
cast_window_declare_attackers ::= "the" "declare" "attackers" "step"
/* @sem Condition::AllOf([Window(Combat), Window(AfterBlockersDeclared)]) */
cast_window_combat_after ::= "combat" "after" "blockers" "are" "declared"
/* @sem Condition::AllOf([Window(Combat), Window(BeforeBlockersDeclared)]) */
cast_window_combat_before ::= "combat" "before" "blockers" "are" "declared"
/* @sem Condition::AllOf([Window(Combat), ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))}]) */
cast_window_combat_opponent ::= "combat" "on" "an" "opponent's" "turn"
/* @sem Condition::AllOf([PlayerIsActive(AbilityController), Window(Combat)]) */
cast_window_combat_yours ::= "combat" "on" "your" "turn"
/* @sem Condition::AllOf([PlayerIsActive(AbilityController), Window(Combat), Window(BeforeBlockersDeclared)]) */
cast_window_combat_yours_before ::= "combat" "on" "your" "turn" "before" "blockers" "are" "declared"
/* @sem Condition::AllOf([Window(DeclareBlockers), ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))}]) */
cast_window_blockers_opponent ::= "the" "declare" "blockers" "step" "on" "an" "opponent's" "turn"
/* @sem Condition::AllOf([PlayerIsActive(AbilityController), Window(DeclareAttackers)]) */
cast_window_your_attackers ::= "your" "declare" "attackers" "step"
/* @sem Condition::AllOf([PlayerIsActive(AbilityController), Window(EndStep)]) */
cast_window_your_end_step ::= "your" "end" "step"
/* @sem Condition::PlayerIsActive(AbilityController) */
cast_window_your_turn ::= "your" "turn"
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))} */
cast_window_opponent_turn ::= "an" "opponent's" "turn"
/* @sem Condition::AllOf([ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))}, Window(Upkeep)]) */
cast_window_opponent_upkeep ::= "an" "opponent's" "upkeep"
/* @sem Condition::AllOf([ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))}, Window(AfterUpkeep)]) */
cast_window_opponent_after_upkeep ::= "an" "opponent's" "turn" "after" "their" "upkeep" "step"
/* @sem Condition::AllOf([ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))}, Window(BeforeAttackersDeclared)]) */
cast_window_opponent_before_attackers ::= "an" "opponent's" "turn" "," "before" "attackers" "are" "declared"

/* Returning a permanent to its owner's hand as a cost. */
/* @sem CostPart::Move{selections:[$cost_one_permanent_selection], destination:$cost_owner_hand_destination} */
cost_return_to_owners_hand ::= "return" cost_one_permanent_selection cost_owner_hand_destination

/* Flash for an extra payment to cast it. */
/* @sem Ability::Casting(Flash{additional_cost:$cost}) */
casting_flash_paid ::= "you" "may" "cast" "this" "spell" "as" "though" "it" "had" "flash" "if" "you" "pay" cost "more" "to" "cast" "it" "."

/* Flash while a condition holds. */
/* @sem Ability::Casting(If{condition:$condition, rule:Flash{}}) */
casting_flash_if ::= "you" "may" "cast" "this" "spell" "as" "though" "it" "had" "flash" "if" condition "."
/* @sem Ability::Casting(If{condition:$condition, rule:Flash{}}) */
casting_flash_if_first ::= ("if" | "as" "long" "as") condition "," "you" "may" "cast" "this" "spell" "as" "though" "it" "had" "flash" "."
/* Casting for free while a condition holds. */
/* @sem Ability::Casting(If{condition:$condition, rule:AlternativeCost{parts:[]}}) */
casting_free_if_first ::= "if" condition "," "you" "may" "cast" "this" "spell" "without" "paying" "its" "mana" "cost" "."

/* Flash whose permanent, cast when a sorcery couldn't be, is sacrificed at the next cleanup step. */
/* @sem Ability::Casting(FlashWithRider(Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CleanupStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(ControllerOf(Earlier{what:SpellBecame})), objects:One(Earlier{what:SpellBecame})})}]}}}]})) */
casting_flash_sacrificed ::= "you" "may" "cast" "this" "spell" "as" "though" "it" "had" "flash" "." "if" "you" "cast" "it" "any" "time" "a" "sorcery" "couldn't" "have" "been" "cast" "," "the" "controller" "of" "the" "permanent" "it" "becomes" "sacrifices" "it" "at" "the" "beginning" "of" "the" "next" "cleanup" "step" "."

/* Cost parts taken over from seeded rules, in their original Oracle words. */
/* @sem CostPart::PutCounters([_{recipients:Objects(One($object_ref)), kind:$counter_kind, amount:Constant(1)}]) */
cost_put_counter_on ::= "put" "a" counter_kind "counter" "on" object_ref

/* @sem CostPart::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($object_ref)), amount:Count(Exactly(Constant(1)))}]} */
cost_remove_a_counter_from ::= "remove" "a" "counter" "from" object_ref

/* @sem CostPart::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($object_ref)), kind:$counter_kind, amount:All}]} */
cost_remove_all_counters_from ::= "remove" "all" counter_kind "counters" "from" object_ref

/* @sem CostPart::Repeated{part:Mana($mana_symbols), times:$count_each} */
cost_pay_for_each ::= "pay" mana_symbols "for" "each" count_each

/* @sem CostPart::Mill{count:$card_count} */
cost_mill ::= "mill" card_count

/* A limited alternative generic payment for a spell selected by origin and type. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:$limited_exile_alternative}) */
static_once_alternative_exile_cost ::= "once" "each" "turn" "," limited_exile_alternative "."
/* @sem Operand::List([Term{family:ManaSymbol, form:ManaCostGeneric, operands:[Integer($number)]}]) */
generic_alternative ::= "{" NUMBER "}"

/* Participial costs following a permission to cast. */
cast_additional_cost_part ::= cast_discard_cost_part | cast_remove_among_cost_part | cast_sacrifice_permanent_cost | cast_remove_counter_permanent_cost | cast_exile_graveyard_filtered | cast_exile_graveyard_another

/* @sem CostPart::Discard{count:$card_count, filter:Any} */
cast_discard_cost_part ::= "discarding" card_count

/* @sem CostPart::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), amount:AmongThem(Exactly($value))}]} */
cast_remove_among_cost_part ::= "removing" value "counters" "from" "among" affected

/* A self card and an independently announced optional card move together. */
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:AnyOf([SameObject(Source), SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:AllOf([Not(SameObject(Source)), $noun, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0})])}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
self_return_and_optional_card ::= "return" "this" "card" "and" "up" "to" "one" "other" "target" noun "card" "from" "your" "graveyard" "to" "the" "battlefield"

/* A named object in a granted ability retains the granting source identity. */
/* @sem CostPart::Unattach($self_ref_named) */
cost_unattach_named_source ::= "unattach" self_ref_named

/* Selection constraints qualify the complete payment, retaining its operands. */
/* @sem CostPart::Constrained{part:$cost_constraint_payment, constraints:[$cost_selection_constraint]} */
cost_constrained_selection ::= cost_constraint_payment cost_selection_constraint

cost_constraint_payment ::= cost_discard_many | cost_discard_filtered_many | cost_reveal_hand_many | cost_tap_population | cost_sacrifice_many | cost_sacrifice_any_population | cost_tap_any_other_controlled | cost_exile_battlefield_at_least | cost_exile_graveyard_selection | cost_exile_any_graveyard_filtered

/* @sem CostPart::Reveal{count:Exactly($card_count), filter:Any} */
cost_reveal_hand_many ::= "reveal" card_count "from" "your" "hand"

/* @sem CostPart::ChangeTapState{selections:[_{objects:$affected, choose:Exactly($value)}], tapped:true} */
cost_tap_population ::= "tap" value affected

cost_selection_constraint ::= cost_constraint_different_names | cost_constraint_same_name | cost_constraint_shared_color | cost_constraint_shared_creature_type | cost_constraint_total_power | cost_constraint_total_mana_value | cost_constraint_distinct_card_types | cost_constraint_total_mana_minimum

/* @sem SelectionConstraint::DifferentNames */
cost_constraint_different_names ::= "with" "different" "names"

/* @sem SelectionConstraint::CommonProperty(Names) */
cost_constraint_same_name ::= "with" "the" "same" "name"

/* @sem SelectionConstraint::CommonProperty(Colors) */
cost_constraint_shared_color ::= "that" "share" "a" "color"

/* @sem SelectionConstraint::CommonProperty(CreatureTypes) */
cost_constraint_shared_creature_type ::= "that" "share" "a" "creature" "type"

/* The selection phrase supplies both the hand population and the count. */
/* @sem CostPart::Move{selections:[$hand_cost_selection], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_hand_selection ::= "exile" hand_cost_selection

/* @sem CostPart::PutCounters([_{recipients:Objects($cost_selected_permanent), kind:$counter_kind, amount:Constant(1), selection:_{player:AbilityController, count:Exactly(Constant(1))}}]) */
cost_put_counter_on_selected ::= "put" "a" counter_kind "counter" "on" cost_selected_permanent

/* A coordinated sacrifice names three independent payments. */
cost_sacrifice_item ::= cost_sacrifice_item_a | cost_sacrifice_item_an

/* @sem CostPart::[$cost_sacrifice_item, $cost_sacrifice_item_2, $cost_sacrifice_item_3] */
cost_sacrifice_three ::= "sacrifice" cost_sacrifice_item "," cost_sacrifice_item "," "and" cost_sacrifice_item

/* @sem $cost_sacrifice_three */
cost_sacrifice_three_later ::= "↑" cost_sacrifice_three

/* Counted selections compose the payment with the complete battlefield filter. */
/* @sem CostPart::ChangeTapState{selections:[CostObjectSelection{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:Exactly($count_plural)}], tapped:true} */
cost_tap_counted_filter ::= "tap" count_plural filter_plural

/* @sem CostPart::ChangeTapState{selections:[CostObjectSelection{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:Exactly($count_plural)}], tapped:false} */
cost_untap_counted_filter ::= "untap" count_plural filter_plural

/* @sem CostPart::ChangeTapState{selections:[CostObjectSelection{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly(Expr::Constant(1))}], tapped:false} */
cost_untap_single_filter ::= "untap" "a" filter_phrase

/* Reveal a selected card from the payer’s hand, with its current filter. */
/* @sem CostPart::Reveal{count:Exactly(Constant(1)), filter:$card_filter} */
cost_reveal_filtered_hand ::= "reveal" "a" card_filter "card" "in" "your" "hand"

cost_one_permanent_selection ::= cost_one_controlled_permanent | cost_another_nontoken_controlled | cost_one_plain_permanent

/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
cost_owner_hand_destination ::= "to" "its" "owner's" "hand"

/* A graveyard payment shares its move with independently selected count and filter. */
/* @sem CostPart::Move{selections:[$graveyard_exile_selection], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_graveyard_selection ::= "exile" graveyard_exile_selection

graveyard_exile_selection ::= graveyard_exile_at_least | graveyard_exile_other | graveyard_exile_any_other
/* @sem CostObjectSelection::CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, choose:AtLeast($value)} */
graveyard_exile_at_least ::= value "or" "more" filter_phrase "cards" "from" "your" "graveyard"
/* @sem CostObjectSelection::CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Not(SameObject(Source))}, choose:Exactly($value)} */
graveyard_exile_other ::= value "other" "cards" "from" "your" "graveyard"

/* @sem CostPart::Discard{count:$card_count, filter:$modifier_mana_value_numeric} */
cost_discard_postmodified ::= "discard" card_count modifier_mana_value_numeric

/* @sem CostPart::Discard{count:Constant(1), filter:$last_drawn_card_filter} */
cost_discard_referenced_card ::= "discard" last_drawn_card_filter

/* Exile selections share the movement destination while retaining each choice. */
/* @sem CostObjectSelection::[$cost_one_permanent_selection] */
cost_permanent_selections_one ::= cost_one_permanent_selection

/* @sem CostObjectSelection::[$cost_one_permanent_selection, $cost_one_permanent_selection_2] */
cost_permanent_selections_pair ::= cost_one_permanent_selection "and" cost_one_permanent_selection

/* @sem CostObjectSelection::[CostObjectSelection{objects:One(Source)}, CostObjectSelection{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), AnyOf([$filter_plural, $filter_plural_2]), ControlledBy(One(AbilityController))])}, choose:Exactly($value)}] */
cost_permanent_selections_self_and_other ::= self_text "and" value "other" filter_plural "and" "/" "or" filter_plural "you" "control"

cost_permanent_selections ::= cost_permanent_selections_one | cost_permanent_selections_pair | cost_permanent_selections_self_and_other | cost_permanent_selections_affected_named_pair

/* Participial payments retain the independent counter and permanent selections. */
/* @sem CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly(Constant(1))} */
cast_sacrifice_permanent_cost ::= "sacrificing" ("a" | "an") filter_phrase

/* @sem CostPart::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}), amount:Count(Exactly(Constant(1))), selection:_{player:AbilityController, count:Exactly(Constant(1))}}]} */
cast_remove_counter_permanent_cost ::= "removing" "a" "counter" "from" ("a" | "an") filter_phrase

/* The pronoun refers to the one card selected by this single exile payment.
   Keeping the producer and consumer together makes the inverse prove the receipt. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[$cost_exile_graveyard]}, limits:$activation_limits, announcement:@announcement, body:Program{instructions:[$play_exile_payment_optional]}} */
activated_single_graveyard_exile_play_limited ::= cost_exile_graveyard ":" play_exile_payment_optional "." activation_limits "."

/* @sem Instruction::Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:Either, cards:One(Query{objects:CostObjects{payment:Activation, component:[0], view:Performed, phase:After}, index:0}), count:Exactly(Constant(1)), cost:Normal}}]}} */
play_exile_payment_optional ::= "you" "may" "play" "it"

/* The explicit origin establishes the activation zone. */
/* @sem Ability::Scoped{zones:[Exile], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$exiled_holder_put_tapped}]}})} */
activated_exile_holder_limited ::= cost ":" exiled_holder_put_tapped "." activation_limits "."

/* Any-number payments retain the chosen population for a following constraint. */
/* @sem CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:AnyNumber} */
cost_sacrifice_any_population ::= "sacrifice" "any" "number" "of" filter_plural

/* @sem CostPart::ChangeTapState{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(Tapped), $filter_plural, ControlledBy(One(AbilityController)), Not(SameObject($object_ref))])}, choose:AnyNumber}], tapped:true} */
cost_tap_any_other_controlled ::= "tap" "any" "number" "of" "untapped" filter_plural "you" "control" "other" "than" object_ref

/* @sem SelectionConstraint::TotalProperty{property:Power, comparison:GreaterOrEqual, amount:$value} */
cost_constraint_total_power ::= "with" "total" "power" value "or" "greater"

/* The casting card is already on the stack when its additional cost is paid. */
/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, choose:Exactly($value)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
graveyard_other_exile_payment ::= "exiling" value "other" "cards" "from" "your" "graveyard"

/* Participial exile costs preserve the selected population and its destination. */
/* @sem CostPart::Move{selections:[_{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), choose:Exactly($value)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cast_exile_graveyard_filtered ::= "exiling" value filter_phrase "cards" "from" "your" "graveyard"

/* @sem CostPart::Move{selections:[_{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([Not(SameObject(Source)), $filter_phrase])}), choose:Exactly(Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cast_exile_graveyard_another ::= "exiling" "another" filter_phrase "card" "from" "your" "graveyard"

/* @sem CostPart::Move{selections:[_{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Not(SameObject(Source))}), choose:Exactly($value)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cast_exile_graveyard_other ::= "exiling" value "other" "cards" "from" "your" "graveyard"

/* Alternate payments for the first use of a costed keyword each turn. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(KeywordCost{keyword:$first_keyword_cost_subject, cards:Any, change:Alternate($kicker_operand_generic), first_each_turn:true})]}) */
static_first_keyword_alternate ::= "you" "may" "pay" kicker_operand_generic "rather" "than" "pay" "the" first_keyword_cost_subject "."

first_keyword_cost_subject ::= first_equip_cost_subject | first_unearth_cost_subject | first_cycling_cost_subject | first_power_up_cost_subject

/* @sem CostedKeyword::Equip */
first_equip_cost_subject ::= "equip" "cost" "of" "the" "first" "equip" "ability" "you" "activate" "each" "turn"

/* @sem CostedKeyword::Unearth */
first_unearth_cost_subject ::= "unearth" "cost" "of" "the" "first" "unearth" "ability" "you" "activate" "each" "turn"

/* @sem CostedKeyword::Cycling */
first_cycling_cost_subject ::= "cycling" "cost" "of" "the" "first" "card" "you" "cycle" "each" "turn"

/* @sem CostedKeyword::PowerUp */
first_power_up_cost_subject ::= "power-up" "cost" "of" "the" "first" "power-up" "ability" "you" "activate" "during" "each" "of" "your" "turns"

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(KeywordCost{keyword:Echo, cards:$filter_plural, change:Alternate(Cost($cost))})]}) */
static_echo_alternate ::= "you" "may" "pay" cost "rather" "than" "pay" "the" "echo" "cost" "for" filter_plural "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$filter_phrase, modifier:Alternate{cost:Alternate(Cost{parts:[ManaWithX{mana:[X], x:Earlier{what:It, measure:Of(ManaValue)}}]})}})]}) */
static_mana_value_alternate ::= "you" "may" "pay" "{" "X" "}" "rather" "than" "pay" "the" "mana" "cost" "for" filter_phrase "spells" "you" "cast" "," "where" "X" "is" "that" "spell's" "mana" "value" "."

/* An object action cost composes its action with its selected population. */
/* @sem CostPart::ObjectAction{objects:$cost_action_objects, action:$cost_object_action_verb} */
cost_object_action ::= cost_object_action_verb cost_action_objects

/* @sem CostObjectAction::GainControl */
cost_object_action_gain_control ::= "gain" "control" "of"

/* @sem CostObjectAction::Suspect */
cost_object_action_suspect ::= "suspect"

cost_object_action_verb ::= cost_object_action_gain_control | cost_object_action_suspect

/* The returned holder enters attacking with the specified counter. */
/* @sem Operation::Move{objects:One($self_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[[$counter_kind, $entry_counter_amount]], states:[Attacking{}]}}, qualifiers:[]} */
self_return_battlefield_tapped_attacking_counter ::= "return" self_ref "from" "your" "graveyard" "to" "the" "battlefield" "tapped" "and" "attacking" "with" entry_counter_amount counter_kind "counter" "on" "it"

/* @sem Ability::Casting(RestrictMana{portion:All, filter:$mana_payment_produced_by}) */
casting_spend_only_payment_filter ::= "spend" "only" mana_payment_produced_by "to" "cast" "this" "spell" "."

/* A colored mana reduction per counted object keeps the color and count independent. */
/* @sem Ability::Casting(ReduceCost([_{color:$mana_letter, amount:$count_each}])) */
casting_colored_reduction_each ::= "this" "spell" "costs" "{" mana_letter "}" "less" "to" "cast" "for" "each" count_each "."

/* @sem $cost */
payment_per_chosen_creature ::= "pay" cost "for" "each" "creature" "chosen" "this" "way"

/* @sem CostPart::Discard{count:Constant(1), filter:AnyOf(@unordered([$singular_filtered_card, $singular_filtered_card_2]))} */
cost_discard_either_card ::= "discard" singular_filtered_card "or" singular_filtered_card

/* The conditional reduction is tied to this particular evidence payment. */
/* @sem Ability::Casting(ReduceForEachPaid{reductions:[_{amount:$braced_amount}], cost:_{parts:[$cost_collect_evidence]}}) */
reduce_collect_evidence ::= optional_cost_opening cost_collect_evidence reduce_for_each_opening braced_amount "less" "to" "cast" "if" "evidence" "was" "collected" "."

/* @sem Cost::Cost{parts:$cost_parts} */
cost_standard ::= cost_parts

/* A choice between a mana payment and a verb-led payment. */
/* @sem Cost::Cost{parts:[Choice([Cost::Cost{parts:[$cost_mana]}, Cost::Cost{parts:[$cost_words_owned]}])]} */
cost_pay_mana_or_words ::= "pay" cost_mana "or" cost_words_owned

/* Three alternative verb-led payments, each retaining its own cost. */
/* @sem CostPart::Choice([_{parts:[$cost_words_owned]}, _{parts:[$cost_words_owned_2]}, _{parts:[$cost_words_owned_3]}]) */
cost_three_word_choices ::= cost_words_owned "," cost_words_owned "," "or" cost_words_owned

/* A payment can choose a matching card from any graveyard. */
/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$card_filter}, choose:Exactly(Expr::Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_any_graveyard_kind ::= "exile" "a" card_filter "card" "from" "a" "graveyard"

/* The same current reduction operand composes with either condition order. */
/* @sem CastingRule::ReduceCost([_{amount:$braced_amount}]) */
source_spell_reduction ::= "this" "spell" "costs" braced_amount "less" "to" "cast"

/* @sem Ability::Casting(If{condition:$condition, rule:$source_spell_reduction}) */
casting_if_reduction ::= "if" condition "," source_spell_reduction "."

/* Two independently expressed payments joined by “and”. */
/* @sem CostPart::[$cost_part, $cost_part_2] */
cost_parts_and ::= cost_part "and" cost_part

/* Sacrifice every object described by the current object set. */
/* @sem CostPart::Sacrifice{objects:$affected} */
cost_sacrifice_affected ::= "sacrifice" affected

/* A conditional reduction during a named casting window. */
/* @sem Ability::Casting(If{condition:$cast_window, rule:ReduceCost([_{amount:$braced_amount}])}) */
casting_reduction_during ::= "this" "spell" "costs" braced_amount "less" "to" "cast" "during" cast_window "."

/* X fixes the announced target count at activation. The effect's fixed pump
   and keyword do not read that count again during resolution. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:$activation_target_pump_defined} */
activated_target_pump_defined ::= cost ":" activation_target_pump_defined "." activation_limits "."

/* @sem @where(Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($activation_x_targets), changes:[Pump{power:$signed_literal, toughness:$signed_literal_2}, GrantKeyword($keyword_value)], duration:$duration, evaluation:Snapshot}}]}, $value) */
activation_target_pump_defined ::= activation_x_targets "get" signed_literal "/" signed_literal "and" "gain" keyword_value duration "," "where" "X" "is" value "as" "you" "activate" "this" "ability"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(AnnouncedX), filter:$filter_plural})) */
activation_x_targets ::= "up" "to" "X" "target" filter_plural

/* A capped reduction preserves both the per-item factor and the maximum. */
/* @sem Ability::Casting(ReduceCost([_{amount:Minimum([@times($braced_number, $count_each), $braced_amount])}])) */
casting_reduction_each_capped ::= "this" "spell" "costs" braced_number "less" "to" "cast" "for" "each" count_each "." "this" "effect" "can't" "reduce" "the" "amount" "of" "mana" "this" "spell" "costs" "by" "more" "than" braced_amount "."

/* A repeatable mana payment retains its complete current symbol list. */
/* @sem CostPart::ManaAnyNumberOfTimes($mana_symbols) */
cost_pay_mana_any_number ::= "pay" mana_symbols "any" "number" "of" "times"

/* The payment and its dependent seek form one scope: the inverse must prove
   the referenced receipt is this singular discard, not another payment. */
discard_one_payment ::= cost_discard | cost_discard_filtered

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$discard_one_payment]}, optional:false}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Not(SharesWithAny{property:CardTypes, with:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}})}, count:$seek_plural_count, constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{}}] */
instructions_discard_seek_unshared ::= discard_one_payment "." "if" "you" "do" "," "seek" seek_plural_count "cards" "that" "don't" "share" "a" "card" "type" "with" "the" "discarded" "card"

/* A gerund payment can qualify casting permission and other cost contexts. */
/* @sem Cost::Cost{parts:[$cost_tapping_population]} */
gerund_cost ::= cost_tapping_population

/* @sem CostPart::ChangeTapState{selections:[_{objects:$affected, choose:Exactly($value)}], tapped:true} */
cost_tapping_population ::= "tapping" value affected

/* The additional payment buys the flash timing permission. */
/* @sem Ability::Casting(Flash{additional_cost:$gerund_cost}) */
casting_flash_by_payment ::= "you" "may" "cast" "this" "spell" "as" "though" "it" "had" "flash" "by" gerund_cost "in" "addition" "to" "paying" "its" "other" "costs" "."

/* A filtered card and a separate additional discard are distinct cost parts. */
/* @sem Cost::Cost{parts:[Discard{count:Constant(1), filter:$filter_phrase}, Discard{count:Constant(1), filter:Any}]} */
alternative_discard_filtered_and_another ::= "discard" ("a" | "an") filter_phrase "card" "and" "another" "card"

/* @sem Cost::Cost{parts:[Discard{count:Constant(1), filter:$filter_phrase}, Discard{count:$count_plural, filter:Any}]} */
alternative_discard_filtered_and_others ::= "discard" ("a" | "an") filter_phrase "card" "and" count_plural "other" "cards"

casting_reduction_count ::= casting_history_drawn_card | casting_history_sacrificed_permanent | count_each_life_history | count_each | count_each_controlled_and_zone

/* Alternative complete payments retain each branch as its own cost. */
/* @sem Cost::Cost{parts:[Choice([Cost::Cost{parts:$cost_parts}, Cost::Cost{parts:$cost_parts_2}])]} */
cost_choice ::= cost_parts "or" cost_parts

casting_additional_payment ::= cost | cost_choice

/* @sem Ability::Casting(If{condition:$condition, rule:ReduceCost($casting_reduction_generic_colored)}) */
casting_reduction_colored_if ::= "this" "spell" "costs" casting_reduction_generic_colored "less" "to" "cast" "if" condition "."

/* @sem ManaReduction::[_{amount:$braced_amount}, ...$colored_cost_reductions] */
casting_reduction_generic_colored ::= braced_amount colored_cost_reductions

/* A selected card revealed from the payer’s hand as a cost. */
/* @sem CostPart::Reveal{count:Exactly(Constant(1)), filter:$filter_phrase} */
cost_reveal_filtered_from_hand ::= "reveal" "a" filter_phrase "card" "from" "your" "hand"

/* @sem Ability::Casting(AdditionalCost{cost:_{parts:[$cost_reveal_filtered_from_hand]}, repetition:Once}) */
casting_additional_reveal ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," cost_reveal_filtered_from_hand "."

/* A card revealed from the payer's hand as a cost. */
/* @sem CostPart::Reveal{count:Exactly(Constant(1)), filter:$filter_phrase} */
cost_reveal_filtered_hand_a ::= "reveal" "a" filter_phrase "card" "from" "your" "hand"

/* @sem CostPart::Reveal{count:Exactly(Constant(1)), filter:$filter_phrase} */
cost_reveal_filtered_hand_an ::= "reveal" "an" filter_phrase "card" "from" "your" "hand"

casting_payment_before_alternative ::= cost | casting_reveal_choice_payment | casting_keyword_choice_payment

/* @sem Cost::Cost{parts:[$casting_reveal_choice_part]} */
casting_reveal_choice_payment ::= casting_reveal_choice_part

casting_reveal_choice_part ::= cost_reveal_filtered_hand_a | cost_reveal_filtered_hand_an

target_cast_cost_adjustment ::= target_cast_cost_more | target_cast_cost_less

/* @sem CastingRule::AdditionalCost{cost:$cost, repetition:Once} */
target_cast_cost_more ::= "costs" cost "more" "to" "cast"

/* @sem CastingRule::ReduceCost([_{amount:$braced_amount}]) */
target_cast_cost_less ::= "costs" braced_amount "less" "to" "cast"

/* A conditional difference defines the reduction directly, including its
   zero floor, rather than adding a separate conditional casting rule. */
/* @sem Ability::Casting(ReduceCost([_{amount:$life_difference_below}])) */
casting_reduction_life_difference ::= life_difference_below "," "this" "spell" "costs" "{" "X" "}" "less" "to" "cast" "," "where" "X" "is" "the" "difference" "."

/* The ability controller determines the opponent population allowed to activate. */
/* @sem ActivationLimits::ActivationLimits{modifiers:[Change::ActivationRule(OnlyBy(OpponentsOf(AbilityController)))]} */
limit_opponents_only ::= "only" "your" "opponents" "may" "activate" "this" "ability"

/* @sem Ability::Casting(AdditionalCost{cost:_{parts:[$cost_sacrifice_any_population]}, repetition:Once}) */
casting_additional_sacrifice_population ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," cost_sacrifice_any_population "."

/* @sem Ability::Casting(AdditionalCost{cost:_{parts:[$cost_sacrifice_any_population]}, optional:true, repetition:Once}) */
casting_optional_additional_sacrifice_population ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "you" "may" cost_sacrifice_any_population "."

/* @sem Ability::Casting(AdditionalCost{cost:_{parts:[$casting_reveal_selected_hand_card]}, optional:true, repetition:Once}) */
casting_optional_reveal_selected_hand_card ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "you" "may" casting_reveal_selected_hand_card "."

casting_reveal_selected_hand_card ::= casting_reveal_selected_hand_card_a | casting_reveal_selected_hand_card_an

/* Reveal a selected filtered card from the payer’s hand. */
/* @sem CostPart::Reveal{count:Exactly(Constant(1)), filter:$card_filter} */
casting_reveal_selected_hand_card_a ::= "reveal" "a" card_filter "card" "from" "your" "hand"

/* @sem CostPart::Reveal{count:Exactly(Constant(1)), filter:$card_filter} */
casting_reveal_selected_hand_card_an ::= "reveal" "an" card_filter "card" "from" "your" "hand"

/* @sem Ability::Casting(If{condition:TargetsMatch(_{object:ObjectRef::Source, kind:Permanent, filter:$filter_phrase}), rule:ReduceCost([_{amount:$braced_amount}])}) */
casting_reduction_if_source_targets_an ::= "this" "spell" "costs" braced_amount "less" "to" "cast" "if" "it" "targets" "an" filter_phrase "."

/* @sem Ability::Casting(If{condition:TargetsMatch(_{object:ObjectRef::Source, kind:Permanent, filter:$casting_flash_target_filter}), rule:Flash{}}) */
casting_flash_if_targets ::= "you" "may" "cast" "this" "spell" "as" "though" "it" "had" "flash" "if" "it" "targets" casting_flash_target_filter "."

casting_flash_target_filter ::= casting_flash_target_a | casting_flash_target_an

/* @sem $filter_phrase */
casting_flash_target_a ::= "a" filter_phrase

/* @sem $filter_phrase */
casting_flash_target_an ::= "an" filter_phrase

/* @sem Ability::Casting(AdditionalCost{cost:_{parts:[Choice([_{parts:[$casting_reveal_an_card_hand]}, $cost])]}, repetition:Once}) */
casting_additional_reveal_or_pay ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," casting_reveal_an_card_hand "or" "pay" cost "."

/* @sem CostPart::Reveal{count:Exactly(Constant(1)), filter:$filter_phrase} */
casting_reveal_an_card_hand ::= "reveal" "an" filter_phrase "card" "from" "your" "hand"

/* The alternative payment applies independently to each mana in this activation. */
/* @sem Change::[ActivationRule(ManaInstead(Cost::Cost{parts:[$cost_words_owned]}))] */
activation_mana_instead ::= "for" "each" "mana" "in" "this" "ability's" "activation" "cost" "," "you" "may" cost_words_owned "rather" "than" "pay" "that" "mana"

/* Both alternatives share the controller named by the casting condition. */
/* @sem Condition::AnyOf([Controls{player:$condition_control_subject, filter:$filter_phrase, minimum:1}, Controls{player:$condition_control_subject, filter:$filter_phrase_2, minimum:1}]) */
casting_either_controlled_condition ::= condition_control_subject "a" filter_phrase "or" "a" filter_phrase

/* @sem Ability::Casting(If{condition:$casting_either_controlled_condition, rule:ReduceCost([_{amount:$braced_amount}])}) */
casting_reduction_if_either_controlled ::= "this" "spell" "costs" braced_amount "less" "to" "cast" "if" casting_either_controlled_condition "."

/* An exhaust activation retains its own use limit and a separately stated
   timing window, independently of its cost and action program. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:_{once:true, condition:$cast_window, keyword:Exhaust}, announcement:@announcement, body:$program_sentence} */
activated_exhaust_during ::= "exhaust" "—" cost ":" program_sentence "activate" "only" "during" cast_window "."

/* A conditional increase composes a turn window with a mana payment. */
/* @sem Ability::Casting(If{condition:$casting_cost_turn, rule:AdditionalCost{cost:$casting_more_mana, repetition:Once}}) */
casting_turn_additional_mana ::= "during" casting_cost_turn "," "this" "spell" "costs" casting_more_mana "more" "to" "cast" "."

/* @sem Cost::Cost{parts:[$cost_mana]} */
casting_more_mana ::= cost_mana

/* Mana produced by the player paying this cost remains theirs. */
/* @sem CostPart::PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$add_mana}]}} */
cost_add_mana ::= add_mana

/* The population chosen for sacrifice is also the population counted. */
/* @sem CostPart::Sacrifice{objects:$affected, choose:Exactly(Expr::Divide{numerator:CountObjects($affected), denominator:Constant(2), rounding:$rounding_words})} */
cost_sacrifice_half ::= "sacrifice" "half" "the" affected "," rounding_words

/* The source is paid first, so the later population contains only other creatures. */
/* @sem CostPart::[Sacrifice{objects:One(Source)}, Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($subtype_negated, ObjectFilter::CardType(Creature))}, choose:AnyNumber}] */
cost_self_and_other_noncreatures ::= "sacrifice" "this" "creature" "and" "any" "number" "of" "other" subtype_negated "creatures"

/* Both counted receipts are fixed by this enclosing activation, including their
   order; this phrase is not valid for an unrelated sacrifice or cost. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[TapSymbol, ...$cost_self_and_other_noncreatures]}, limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Union([CostObjects{payment:Activation, component:[1], view:Performed, phase:Before}, CostObjects{payment:Activation, component:[2], view:Performed, phase:Before}])), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}} */
activated_sacrifice_pair_token_receipt ::= "{" "T" "}" "," "↑" cost_self_and_other_noncreatures ":" "create" "a" token_recipe "for" "each" "creature" "sacrificed" "this" "way" "."

/* @sem Ability::Casting(If{condition:$condition, rule:AlternativeCost($alternative_payment)}) */
casting_alternative_if_preposed ::= "if" condition "," rather_than_mana_cost "," "you" "may" alternative_payment "."

/* @sem Cost::Cost{parts:[EachPlayerAction{players:OthersThan(AbilityController), action:Term{family:CostPlayerAction, form:GainLife, operands:[Number($value)]}}]} */
alternative_other_players_gain_life ::= "have" "each" "other" "player" "gain" value "life"

/* A keyword action can be one complete alternative to another payment. */
/* @sem Cost::Cost{parts:[$casting_keyword_choice_part]} */
casting_keyword_choice_payment ::= casting_keyword_choice_part

/* @sem CostPart::Keyword{action:Forage} */
casting_keyword_choice_part ::= "forage"

/* @sem Cost::Cost{parts:[ManaAnyNumberOfTimes($mana_symbols), ManaAnyNumberOfTimes($mana_symbols_2)]} */
cost_repeated_mana_pair ::= "pay" mana_symbols "and" "/" "or" mana_symbols "any" "number" "of" "times"

/* @sem Ability::Casting(AdditionalCost{cost:$cost_repeated_mana_pair, optional:true, repetition:Once}) */
casting_optional_repeated_mana_pair ::= optional_cost_opening cost_repeated_mana_pair "."

/* @sem ManaReduction::[_{amount:$braced_amount}] */
casting_reduction_turn_generic ::= braced_amount

casting_reduction_turn_amounts ::= casting_reduction_generic_colored | casting_reduction_turn_generic

/* @sem Ability::Casting(If{condition:$window_your_turn, rule:ReduceCost($casting_reduction_turn_amounts)}) */
casting_reduction_preposed_turn ::= window_your_turn "," "this" "spell" "costs" casting_reduction_turn_amounts "less" "to" "cast" "."

/* @sem ActivationLimits::ActivationLimits{sorcery:true, modifiers:[Change::ActivationRule(OnlyBy(OpponentsOf(AbilityController)))]} */
limit_opponents_sorcery ::= "only" "your" "opponents" "may" "activate" "this" "ability" "and" "only" "as" "a" "sorcery"

/* The host supplies the mana cost; the payment does not change its controller. */
/* @sem CostPart::ManaCostOf(@enchanted_creature_operand(ObjectRef::AttachedTo(Source))) */
cost_enchanted_creature_mana ::= "pay" "enchanted" "creature's" "mana" "cost"

/* The named opponent gains life as the cost is paid. */
/* @sem CostPart::PlayerAction{player:$cost_token_actor, body:Program{instructions:[Effect{result:@next, operation:GainLife{players:One($cost_token_actor), amount:$value}}]}} */
cost_opponent_gains_life ::= cost_token_actor "gains" value "life"

/* The chosen opponent controls the matching permanent. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Controls{player:Bound(0), filter:$adjective_color, minimum:1}} */
casting_opponent_controls_color ::= "an" "opponent" "controls" "a" adjective_color "permanent"

/* @sem Ability::Casting(If{condition:$casting_opponent_controls_color, rule:ReduceCost([_{amount:$braced_number}])}) */
casting_reduction_opponent_controls_color ::= "this" "spell" "costs" braced_number "less" "to" "cast" "if" casting_opponent_controls_color "."

/* @sem ActivationLimits::ActivationLimits{condition:Controls{player:AbilityController, filter:AnyOf(@unordered([$filter_phrase, $filter_phrase_2])), minimum:1}} */
limit_controlled_either_a_an ::= "activate" "only" "if" "you" "control" "a" filter_phrase "or" "an" filter_phrase

/* @sem ActivationLimits::ActivationLimits{condition:Controls{player:AbilityController, filter:AnyOf([$filter_phrase, $filter_phrase_2]), minimum:1}} */
limit_controlled_either_an_a ::= "activate" "only" "if" "you" "control" "an" filter_phrase "or" "a" filter_phrase

/* A player-action cost wraps an independently meaningful instruction sequence. */
/* @sem CostPart::PlayerAction{player:AbilityController, body:Program{instructions:$cost_player_action_body}} */
cost_player_action_shared ::= cost_player_action_body

cost_player_action_body ::= clause_hand_on_top | cost_reveal_hand_instruction

/* @sem Instruction::[Effect{result:@next, operation:$hand_observation_yours}] */
cost_reveal_hand_instruction ::= hand_observation_yours

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AnyOf([$card_word, $card_word_2, State(HasAdventure)])} */
reduction_adventure_graveyard_population ::= "cards" "in" "your" "graveyard" "that" "are" card_word "cards" "," card_word "cards" "," "and" "/" "or" "have" "an" "Adventure"

/* @sem Ability::Casting(ReduceCost([_{amount:CountObjects($reduction_adventure_graveyard_population)}])) */
casting_reduction_adventure_graveyard ::= "this" "spell" "costs" "{" "X" "}" "less" "to" "cast" "," "where" "X" "is" "the" "number" "of" reduction_adventure_graveyard_population "."

/* A live card population scales the extra mana paid for this activation. */
/* @sem ActivationLimits::ActivationLimits{modifiers:[Change::ActivationRule(Cost{modifier:Increase{parts:[Repeated{part:Mana($mana_symbols), times:$activation_cost_population}]}})]} */
limit_cost_more_each ::= "this" "ability" "costs" mana_symbols "more" "to" "activate" "for" "each" activation_cost_population

activation_cost_population ::= count_each_card_hand | count_each_hand | count_each_card_graveyard | count_each_graveyard

/* The second cost component is the very exile payment measured by this token.
   Keeping the producer and consumer together makes the receipt valid in both directions. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, $cost_exile_graveyard_selection]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:$token_colors, card_types:[Creature], subtypes:$token_subtypes, power_toughness:[Multiply([Constant(2), CountObjects(CostObjects{payment:Activation, component:[1], view:Inputs, phase:Before})]), Multiply([Constant(2), CountObjects(CostObjects{payment:Activation, component:[1], view:Inputs, phase:Before})])]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}})}]}} */
activated_exile_payment_scaled_token ::= cost_mana "," "↑" cost_exile_graveyard_selection ":" "create" token_amount "tapped" "X" "/" "X" token_colors token_subtypes "creature" "token" "," "where" "X" "is" "twice" "the" "number" "of" "cards" "exiled" "this" "way" "."

/* A suspended source exists in exile; the restriction belongs to this activation. */
/* @sem Ability::Scoped{zones:[Exile], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{condition:$suspended_source_condition}, announcement:@announcement, body:$program_sentence})} */
activated_suspended_source ::= cost ":" program_sentence "activate" "only" "if" suspended_source_condition "."

/* The pronoun refers to this spell and the checked target is itself a spell or ability. */
/* @sem Condition::TargetsMatch(_{object:Source, kind:Any, filter:TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}))}) */
casting_source_targets_targeting_stack_object ::= "it" "targets" "a" "spell" "or" "ability" "that" "targets" "a" filter_phrase

/* @sem Ability::Casting(If{condition:$casting_source_targets_targeting_stack_object, rule:ReduceCost([_{amount:$braced_amount}])}) */
casting_reduction_when_source_targets_targeting_stack_object ::= "this" "spell" "costs" braced_amount "less" "to" "cast" "if" casting_source_targets_targeting_stack_object "."

/* The source and the counted population are separate payments, in printed order. */
/* @sem CostPart::[CostPart::Sacrifice{objects:One($self_explicit_ref)}, CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:Exactly($count)}] */
cost_sacrifice_self_and_many ::= "↑" "sacrifice" self_explicit_ref "and" count filter_plural

/* The noted mana belongs to this activation's payment. Keep the note inside
   the activation while sharing its preceding operation and limit operands. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:$activation_mana_note_program} */
activated_mana_note_limited ::= cost ":" activation_mana_note_program activation_limits "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:Note(ManaSpent{})}]} */
activation_mana_note_program ::= operation "." "note" "the" "type" "of" "mana" "spent" "to" "pay" "this" "activation" "cost" "."

/* @sem CostPart::ChangeTapState{selections:[_{objects:One(Source)}], tapped:false, symbol:true} */
cost_untap_symbol ::= "{Q}"

/* A bounded number choice can be paid as a player action. The operation
   retains the same chooser and bounds used outside costs. */
/* @sem CostPart::PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$choose_number_between}]}} */
cost_choose_number_between ::= choose_number_between

/* Live populations do not require a prior action receipt. */
/* @sem Change::[ActivationRule(Cost{modifier:Reduce{reductions:[ManaReduction{amount:@times($braced_amount, $activation_live_count)}], spill_into_generic:true}})] */
activation_live_reduction ::= "this" "ability" "costs" braced_amount "less" "to" "activate" "for" "each" activation_live_count

activation_live_count ::= count_each_land_type | count_each_permanent | activation_count_other_source | count_each_other | count_each_card_hand | count_each_card_graveyard

/* A conditional casting reduction with the condition stated first. */
/* @sem Ability::Casting(If{condition:$condition, rule:ReduceCost([_{amount:$braced_amount}])}) */
casting_reduction_if_first ::= "if" condition "," "this" "spell" "costs" braced_amount "less" "to" "cast" "."

/* The acting player pays by performing the same move available as an effect. */
/* @sem CostPart::PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$move_object_owners_library}]}} */
cost_performed_library_move ::= move_object_owners_library

/* @sem Ability::Casting(If{condition:$condition, rule:AlternativeCost($alternative_payment)}) */
casting_alternative_if_prefix ::= "if" condition "," rather_than_mana_cost "," "you" "may" alternative_payment "."

/* The acting player is also the recipient of the life. */
/* @sem Cost::Cost{parts:[PlayerAction{player:$alternative_life_actor, body:Program{instructions:[Effect{result:@next, operation:GainLife{players:One($alternative_life_actor), amount:$value}}]}}]} */
alternative_have_gain_life ::= "have" alternative_life_actor "gain" value "life"

/* A self-zone activation restriction also fixes the activation's zone. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:$limit_self_in_your_graveyard, announcement:@announcement, body:$program_sentence})} */
activated_self_graveyard_restriction ::= cost ":" program_sentence limit_self_in_your_graveyard "."

/* A player-action payment retains its actor and the coin operation. */
/* @sem CostPart::PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$cost_coin_series}]}} */
cost_flip_coin_series ::= cost_coin_series

/* A chosen type can itself be a cost action by the casting player. */
/* @sem CostPart::PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$cost_type_choice}]}} */
cost_choose_type_action ::= cost_type_choice

cost_type_choice ::= choose_creature_type_plain | choose_land_type | choose_basic_land_type | choose_planeswalker_type

/* A generic amount and one blue mana are independently reduced when the condition holds. */
/* @sem ActivationLimits::ActivationLimits{modifiers:[ActivationRule(Cost{modifier:Reduce{reductions:[_{amount:$braced_amount}, _{color:Blue, amount:Constant(1)}], spill_into_generic:true}, condition:$condition})]} */
limit_conditional_blue_reduction ::= "this" "ability" "costs" braced_amount "{" "U" "}" "less" "to" "activate" "if" condition

/* A reduction while a condition holds. */
/* @sem Ability::Casting(If{condition:$casting_target_card_condition, rule:ReduceCost([_{amount:$braced_amount}])}) */
casting_reduction_if_target_card ::= "this" "spell" "costs" braced_amount "less" "to" "cast" "if" casting_target_card_condition "."

/* The pronoun refers to the spell whose cost is being reduced. */
/* @sem Condition::TargetsMatch(_{object:Source, kind:Card, filter:@and($filter_phrase, $modifier_mana_value_numeric)}) */
casting_target_card_condition ::= "it" "targets" "a" filter_phrase "card" modifier_mana_value_numeric

/* X is fixed by the current count of the stated counters and recipient. */
/* @sem ActivationLimits::ActivationLimits{modifiers:[Change::ActivationRule(XIs(NumberTest::Compare{comparison:Equal, value:$activation_counter_count}))]} */
limit_x_counter_count ::= "x" "is" activation_counter_count

/* A tap payment with a color and untapped restriction on an independently named object. */
/* @sem Ability::Activated{origin:Ordinary, cost:$payment_tap, limits:$limit_color_untapped_once, announcement:@announcement, body:$program_sentence} */
activated_tap_color_untapped_once ::= payment_tap ":" program_sentence limit_color_untapped_once "."

/* @sem ActivationLimits::ActivationLimits{once_each_turn:true, condition:Condition::ObjectMatches{object:$object_ref, filter:AllOf([$adjective_color, Not(Tapped)])}} */
limit_color_untapped_once ::= "activate" "only" "if" object_ref "is" adjective_color "and" "untapped" "and" "only" "once" "each" "turn"

/* The source and the separately selected permanent are paid together. */
/* @sem CostPart::[CostPart::Sacrifice{objects:One($self_explicit_ref)}, CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly(Expr::Constant(1))}] */
cost_sacrifice_self_and_another ::= "sacrifice" self_explicit_ref "and" "another" filter_phrase

/* @sem $cost_sacrifice_self_and_another */
cost_sacrifice_self_and_another_later ::= "↑" cost_sacrifice_self_and_another

/* A conditional reduction belongs to the activated ability's own limits. */
/* @sem Change::[ActivationRule(Cost{modifier:Reduce{reductions:$activation_mana_reductions, spill_into_generic:true}, condition:$condition})] */
conditional_activation_reduction ::= "this" "ability" "costs" activation_mana_reductions "less" "to" "activate" "if" condition

activation_mana_reductions ::= activation_mana_reductions_colored | activation_mana_reductions_generic

/* @sem ActivationLimits::ActivationLimits{modifiers:$conditional_activation_reduction} */
limit_conditional_reduction ::= conditional_activation_reduction

/* @sem ActivationLimits::ActivationLimits{once_each_turn:true, modifiers:$conditional_activation_reduction} */
limit_conditional_reduction_once ::= conditional_activation_reduction "." "activate" "only" "once" "each" "turn"

/* @sem $cost_remove_counters_and_sacrifice */
cost_remove_counters_and_sacrifice_later ::= "↑" cost_remove_counters_and_sacrifice

/* A lower-bounded battlefield selection can pay a constrained exile cost. */
/* @sem CostPart::Move{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:AtLeast($value)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_battlefield_at_least ::= "exile" value "or" "more" filter_plural

/* @sem SelectionConstraint::TotalProperty{property:ManaValue, comparison:Equal, amount:$number} */
cost_constraint_total_mana_value ::= "with" "total" "mana" "value" number

/* A single paid choice keeps both source-zone branches and their selection rules together. */
/* @sem CostPart::Choice([_{parts:[Move{selections:[_{objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])}), choose:Exactly($counter_amount)}], destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, _{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])}), count:AsManyAsCan($counter_amount)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}]}]) */
hand_graveyard_entry_choice ::= "put" counter_amount filter_phrase "card" "with" "mana" "value" value "or" "less" "from" "your" "hand" "or" "graveyard" "onto" "the" "battlefield"

/* A coordinated payment retains two independent sacrifice selections. */
/* @sem CostPart::[CostPart::Sacrifice{objects:$affected}, $cost_sacrifice_item] */
cost_sacrifice_self_and_one ::= "sacrifice" affected "and" cost_sacrifice_item

/* @sem CostPart::[CostPart::Sacrifice{objects:$affected}, CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:Exactly($count)}] */
cost_sacrifice_affected_and_many ::= "sacrifice" affected "and" count filter_plural

/* @sem CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly(Expr::Constant(1))} */
cost_sacrifice_item_a ::= "a" filter_phrase

/* @sem CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly(Expr::Constant(1))} */
cost_sacrifice_item_an ::= "an" filter_phrase

/* @sem Ability::Casting(If{condition:$condition_opponent_controls_a, rule:$source_spell_reduction}) */
casting_reduction_if_opponent_controls ::= source_spell_reduction "if" condition_opponent_controls_a "."

/* Exiling a selection from one graveyard preserves the shared owner constraint. */
/* @sem CostPart::Constrained{part:Move{selections:[$single_graveyard_card_selection], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}, constraints:[CommonProperty(Owners)]} */
cost_exile_single_graveyard_selection ::= "exile" single_graveyard_card_selection

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, choose:Exactly(Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_top_one ::= "exile" "the" "top" "card" "of" "your" "library"

/* A self-move from the command zone establishes the activation zone. */
/* @sem Ability::Scoped{zones:[Command], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$command_self_entry}]}})} */
activated_command_self_entry ::= cost ":" command_self_entry "."

/* A transfer from the source followed by a grant and a zero-counter conversion. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:Program{instructions:$transfer_source_grant_convert}} */
activated_transfer_source_grant_convert ::= cost ":" transfer_source_grant_convert "." activation_limits "."

/* @sem Instruction::[Effect{result:@next, operation:MoveCounters{actor:One(AbilityController), from:One(Source), to:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(SameObject(Source)), CardType(Artifact)])}), index:0}), kind:PowerToughness([1, 1]), amount:Exactly(AnnouncedX)}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:0, index:0})), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}, If{condition:ObjectMatches{object:Source, filter:Counters(_{kind:PowerToughness([1, 1]), comparison:Equal, value:Constant(0)})}, then:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Convert{object:Source}}}]}, otherwise:Program{}}] */
transfer_source_grant_convert ::= "move" "X" "+" "1" "/" "+" "1" "counters" "from" SELF_NAME "onto" "another" "target" "artifact" "." "that" "artifact" "gains" keyword_name duration "." "if" SELF_NAME "has" "no" "+" "1" "/" "+" "1" "counters" "on" "it" "," "convert" "it"

/* A choice combines independently described payment parts. */
/* @sem CostPart::Choice([_{parts:[$cost_reveal_card_from_hand]}, _{parts:[$cost_choose_one_permanent]}]) */
cost_or_choice ::= cost_reveal_card_from_hand "or" cost_choose_one_permanent

/* @sem CostPart::Reveal{count:Exactly(Constant(1)), filter:$filter_phrase} */
cost_reveal_card_from_hand ::= "reveal" "a" filter_phrase "card" "from" "your" "hand"

/* @sem CostPart::PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan(Constant(1))}}]}} */
cost_choose_one_permanent ::= "choose" "a" filter_phrase

/* A self-discard payment scopes the activation to hand; its independent
   population reduction applies to the activation rather than its body. */
/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[...$cost_parts, CostPart::Discard{count:Expr::Constant(1), filter:SameObject(ObjectRef::Source)}]}, limits:$activation_population_limit, announcement:@announcement, body:$program_sentence})} */
activated_discard_self_after_population_limited ::= cost_parts "," "↑" "discard" self_text ":" program_sentence activation_population_limit "."

/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[CostPart::Discard{count:Expr::Constant(1), filter:SameObject(ObjectRef::Source)}]}, limits:$activation_population_limit, announcement:@announcement, body:$program_sentence})} */
activated_discard_self_population_limited ::= "discard" self_text ":" program_sentence activation_population_limit "."

/* Restrict the count to a live battlefield population, not an unproved action receipt. */
/* @sem ActivationLimits::ActivationLimits{modifiers:[Change::ActivationRule(Cost{modifier:Reduce{reductions:[ManaReduction{amount:@times($braced_amount, $count_each_permanent)}], spill_into_generic:true}})]} */
activation_population_limit ::= "this" "ability" "costs" braced_amount "less" "to" "activate" "for" "each" count_each_permanent

/* @sem CostPart::[$cost_sacrifice_item, $cost_sacrifice_item_2] */
cost_sacrifice_pair ::= "sacrifice" cost_sacrifice_item "and" cost_sacrifice_item

/* @sem $cost_sacrifice_pair */
cost_sacrifice_pair_later ::= "↑" cost_sacrifice_pair

/* The pronoun returns the same explicit object that supplied the counters. */
/* @sem CostPart::[RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($self_explicit_ref)), kind:$counter_kind, amount:Count(Exactly(Constant(1)))}]}, Move{selections:[_{objects:One($self_explicit_ref)}], destination:OwnersHand(CardArrival{})}] */
cost_remove_counter_return ::= "remove" cost_counter_article counter_kind "counter" "from" self_explicit_ref "and" "return" "it" "to" "its" "owner's" "hand"

/* @sem CostPart::[RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($self_explicit_ref)), kind:$counter_kind, amount:Count(Exactly(@plural_amount($value)))}]}, Move{selections:[_{objects:One($self_explicit_ref)}], destination:OwnersHand(CardArrival{})}] */
cost_remove_counters_return ::= "remove" value counter_kind "counters" "from" self_explicit_ref "and" "return" "it" "to" "its" "owner's" "hand"

cost_counter_article ::= cost_counter_article_a | cost_counter_article_an

/* @sem () */
cost_counter_article_a ::= "a"

/* @sem () */
cost_counter_article_an ::= "an"

/* @sem $cost_remove_counter_return */
cost_remove_counter_return_later ::= "↑" cost_remove_counter_return

/* @sem $cost_remove_counters_return */
cost_remove_counters_return_later ::= "↑" cost_remove_counters_return

/* A single discard payment scopes the receipt used by the following conditional. */
discard_one_receipt_cost ::= cost_discard | cost_discard_filtered

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$discard_one_receipt_cost]}, limits:$activation_limits, announcement:@announcement, body:$discard_receipt_program} */
activated_discard_receipt ::= discard_one_receipt_cost ":" discard_receipt_program "." activation_limits "."

/* Any player may activate this ability while its source is on the stack. */
/* @sem Ability::Scoped{zones:[Stack], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{activators:All}, announcement:@announcement, body:$program_sentence})} */
activated_any_player_stack ::= cost ":" program_sentence "any" "player" "may" "activate" "this" "ability" "but" "only" "if" SELF_NAME "is" "on" "the" "stack" "."

/* A casting payment followed by a bound on the announced value. */
/* @sem Ability::[$casting_additional_cost, $casting_announced_x_cap] */
casting_additional_cost_with_x_cap ::= casting_additional_cost casting_announced_x_cap

/* @sem Ability::Casting(Require(Compare{left:AnnouncedX, test:NumberTest::Compare{comparison:LessOrEqual, value:$value_greatest}})) */
casting_announced_x_cap ::= "x" "can't" "be" "greater" "than" value_greatest "."

/* The filter and mana-value qualifier compose in a hand-exile payment. */
/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Hand, players:One(PlayerRef::AbilityController)}, kind:Card, filter:@and($adjective_color, $modifier_mana_value_exact)}, choose:Exactly(Expr::Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_hand_mana_value_one ::= "exile" "a" adjective_color "card" modifier_mana_value_exact "from" "your" "hand"

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Hand, players:One(PlayerRef::AbilityController)}, kind:Card, filter:@and($adjective_color, $modifier_mana_value_exact)}, choose:Exactly($count)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_hand_mana_value_many ::= "exile" count adjective_color "cards" modifier_mana_value_exact "from" "your" "hand"

/* The card-selection phrase carries its owner and exile link into the payment. */
/* @sem CostPart::ExiledToGraveyard($exiled_card_to_owner_graveyard) */
cost_put_exiled_card_graveyard ::= "put" exiled_card_to_owner_graveyard

/* One selected permanent supplies the source of a counter payment. */
/* @sem CostPart::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counter_payment_source}), amount:Count(Exactly(Constant(1))), selection:_{player:AbilityController, count:Exactly(Constant(1))}}]} */
cost_remove_selected_counter ::= "remove" "a" "counter" "from" counter_payment_source

/* @sem CostPart::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counter_payment_source}), kind:$counter_kind, amount:Count(Exactly(Constant(1))), selection:_{player:AbilityController, count:Exactly(Constant(1))}}]} */
cost_remove_selected_named_counter ::= "remove" "a" counter_kind "counter" "from" counter_payment_source

/* The second cost component is the removal paid for this scaled pump. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:Multiply([$value, PaidCountersRemoved{payment:Activation, component:[1]}]), toughness:Multiply([$value_2, PaidCountersRemoved{payment:Activation, component:[1]}])}], duration:$duration, evaluation:Snapshot} */
paid_removal_pump ::= "for" "each" "counter" "removed" "," affected "gets" "+" value "/" "+" value duration

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, $cost_remove_counters]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$paid_removal_pump}]}} */
activated_paid_removal_pump ::= cost_mana "," "↑" cost_remove_counters ":" paid_removal_pump "."

/* Shared casting contexts for opponent cast history. */
casting_opponent_history ::= casting_opponent_draw_threshold | casting_opponent_searched_library | casting_opponent_spell_threshold | casting_opponent_filtered_history

/* @sem Ability::Casting(If{condition:$casting_opponent_history, rule:AlternativeCost($alternative_payment)}) */
casting_alternative_opponent_history ::= "if" casting_opponent_history "," "you" "may" alternative_payment rather_than_mana_cost "."

/* @sem Ability::Casting(If{condition:$casting_opponent_spell_threshold, rule:ReduceCost([_{color:$mana_letter, amount:Constant(1)}])}) */
casting_colored_reduction_opponent_history ::= "this" "spell" "costs" "{" mana_letter "}" "less" "to" "cast" "if" casting_opponent_spell_threshold "."

/* @sem Ability::Casting(If{condition:$casting_first_spell_game, rule:AlternativeCost{parts:[]}}) */
casting_free_first_game ::= "if" casting_first_spell_game "," "you" "may" "cast" "it" "without" "paying" "its" "mana" "cost" "."

/* The two spell kinds share a cast-history count in this reduction. */
/* @sem Expr::EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:AnyOf([$spell_adjective, $spell_adjective_2])}, window:ThisTurn, measure:Occurrences} */
casting_each_spell_kind_history ::= spell_adjective "and" spell_adjective "spell" "you've" "cast" "this" "turn"

/* @sem Ability::Casting(ReduceCost([_{color:$mana_letter, amount:$casting_each_spell_kind_history}])) */
casting_colored_reduction_spell_history ::= "this" "spell" "costs" "{" mana_letter "}" "less" "to" "cast" "for" "each" casting_each_spell_kind_history "."

/* Two independent sacrifice payments share the printed verb. */
/* @sem CostPart::[Sacrifice{objects:One($sacrifice_land_self_ref)}, Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$sacrifice_land_companion}, choose:Exactly(Expr::Constant(1))}] */
cost_sacrifice_source_and_qualified ::= "sacrifice" sacrifice_land_self_ref "and" sacrifice_land_companion

/* @sem ObjectRef::@self */
sacrifice_land_self_ref ::= self_land

sacrifice_land_companion ::= sacrifice_land_companion_a | sacrifice_land_companion_an

/* @sem $filter_phrase */
sacrifice_land_companion_a ::= "a" filter_phrase

/* @sem $filter_phrase */
sacrifice_land_companion_an ::= "an" filter_phrase

/* @sem $cost_sacrifice_source_and_qualified */
cost_sacrifice_source_and_qualified_later ::= "↑" cost_sacrifice_source_and_qualified

/* The source exile payment proves its activation zone; the limit applies to the complete body. */
/* @sem Ability::Scoped{zones:[$your_zone], ability:@scope(Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[Move{selections:[_{objects:One(Source)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}}]}, limits:$activation_limits, announcement:@announcement, body:$program_sentence})} */
activated_exile_self_limited ::= "exile" "this" "card" "from" your_zone ":" program_sentence activation_limits "."

/* The singular top card is an ordered selection from the controller's library. */
/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:Expr::Constant(1), from:Top}, choose:Exactly(Expr::Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_top_card ::= "exile" "the" "top" "card" "of" "your" "library"

/* The selected spell supplies the earlier mana value for this alternate cost. */
/* @sem PlayCost::Alternate(Cost{parts:[Life(Earlier{what:It, measure:Of(ManaValue)})]}) */
cast_alternative_terms ::= "by" "paying" "life" "equal" "to" "its" "mana" "value" "rather" "than" "paying" "its" "mana" "cost"

/* Limited free casting combines an independently specified spell filter, origin,
   and per-turn allowance. The affected player owns both source zones. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:@and($limited_free_spell, $limited_free_origins), modifier:$limited_free_timing})]}) */
static_limited_free_cast ::= limited_free_timing "," "you" "may" "cast" limited_free_spell limited_free_origins "without" "paying" "its" "mana" "cost" "."

limited_free_timing ::= limited_free_once | limited_free_twice

/* @sem SpellCostModifier::AlternateDuring{cost:Free, limit:EachTurn(1), during:One(Affected)} */
limited_free_once ::= "once" "during" "each" "of" "your" "turns"

/* @sem SpellCostModifier::AlternateDuring{cost:Free, limit:EachTurn(2), during:One(Affected)} */
limited_free_twice ::= "twice" "during" "each" "of" "your" "turns"

limited_free_spell ::= limited_free_any_spell | limited_free_kind_spell

/* @sem ObjectFilter::Any */
limited_free_any_spell ::= "a" "spell"

/* @sem $card_filter */
limited_free_kind_spell ::= "a" card_filter "spell"

/* @sem ObjectFilter::InSet(Union([Zone(_{scope:Players{zone:Hand, players:One(Affected)}, kind:Card, filter:Any}), Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:$limited_free_top_count, from:Top}])) */
limited_free_origins ::= "from" "your" "hand" "or" limited_free_top_count "of" "your" "library"

limited_free_top_count ::= limited_free_top_one | limited_free_top_two

/* @sem Expr::Constant(1) */
limited_free_top_one ::= "the" "top"

/* @sem Expr::Constant(2) */
limited_free_top_two ::= "the" "top" "two" "cards"

/* The threshold counts card types among the cards selected for the payment. */
/* @sem SelectionConstraint::DistinctCount{property:CardTypes, comparison:GreaterOrEqual, amount:$value} */
cost_constraint_distinct_card_types ::= "with" value "or" "more" "card" "types" "among" "them"

/* @sem CostObjectSelection::CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Not(SameObject(Source))}, choose:AnyNumber} */
graveyard_exile_any_other ::= "any" "number" "of" "other" "cards" "from" "your" "graveyard"

/* The history threshold and sorcery timing both restrict this activation. */
/* @sem ActivationLimits::ActivationLimits{sorcery:true, condition:$controlled_color_noncombat_history} */
limit_controlled_color_damage_sorcery ::= "activate" "only" "if" controlled_color_noncombat_history "and" "only" "as" "a" "sorcery"

/* @sem Condition::Compare{left:EventHistory{event:Damage(_{source_kind:Any, sources:AllOf([$adjective_color, ControlledBy(One(AbilityController))]), recipients:Any, kind:Noncombat, grouping:SourceRecipient, subject:Source}), window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
controlled_color_noncombat_history ::= adjective_color "sources" "you" "controlled" "dealt" value "or" "more" "noncombat" "damage" "this" "turn"

/* The alternative payment is measured against the spell being cast. */
/* @sem CostPart::LifeEqualToOwnManaValue */
cast_life_mana_value_cost ::= "paying" "life" "equal" "to" "its" "mana" "value" "rather" "than" "paying" "its" "mana" "cost"

/* @sem CostPart::LifeEqualToOwnManaValue */
cast_life_mana_values_cost ::= "paying" "life" "equal" "to" "their" "mana" "values" "rather" "than" "paying" "their" "mana" "costs"

/* The final payment can instead sacrifice the ability holder. */
/* @sem CostPart::[$cost_sacrifice_item, $cost_sacrifice_item_2, CostPart::Sacrifice{objects:One($self_explicit_ref)}] */
cost_sacrifice_two_and_self ::= "sacrifice" cost_sacrifice_item "," cost_sacrifice_item "," "and" self_explicit_ref

/* The self-discard payment scopes the activation to hand, including its limit. */
/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[CostPart::Discard{count:Expr::Constant(1), filter:SameObject(ObjectRef::Source)}]}, limits:$activation_limits, announcement:@announcement, body:$program_sentence})} */
activated_discard_self_limited ::= "discard" self_text ":" program_sentence activation_limits "."

/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[...$cost_parts, CostPart::Discard{count:Expr::Constant(1), filter:SameObject(ObjectRef::Source)}]}, limits:$activation_limits, announcement:@announcement, body:$program_sentence})} */
activated_discard_self_after_limited ::= cost_parts "," "↑" "discard" self_text ":" program_sentence activation_limits "."

/* The complete payment and its consumers share one scope: X counts this
   payment's performed tap selections before the state change. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[ChangeTapState{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(Tapped), $subtype, ControlledBy(One(AbilityController))])}, choose:AnyNumber}], tapped:true}]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:_{instructions:[Effect{result:@next, operation:BindValue{value:CountObjects(CostObjects{payment:Resolution(0), component:[0], view:Performed, phase:Before})}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[Pump{power:BoundValue(@prior), toughness:Constant(0)}], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:DealDamage{source:Source, recipients:AttackedBy(Source), amount:BoundValue(@back(3)), preventable:true}}]}, otherwise:_{}}]} */
program_tap_x_attack_rewards ::= "you" "may" "tap" "X" "untapped" subtype "you" "control" "." "if" "you" "do" "," "this" "creature" "gets" "+" "X" "/" "+" "0" duration "and" "deals" "X" "damage" "to" "the" "player" "or" "planeswalker" "it's" "attacking" "."

/* Counter removal costs retain the recipient population and distribution. */
/* @sem CostPart::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), amount:Count(Exactly($value))}]} */
cost_remove_unspecified_count ::= "remove" value "counters" "from" affected

/* @sem CostPart::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), amount:AmongThem(Exactly($value))}]} */
cost_remove_unspecified_among ::= "remove" value "counters" "from" "among" affected

/* @sem CostPart::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:AmongThem(Exactly($number))}]} */
cost_remove_kind_among ::= "remove" number counter_kind "counters" "from" "among" affected

/* @sem CostPart::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:AmongThem(AtLeast($value))}]} */
cost_remove_kind_at_least_among ::= "remove" value "or" "more" counter_kind "counters" "from" "among" affected

/* @sem CostPart::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:Count(Exactly($counter_removal_plural_amount))}]} */
cost_remove_kind_count ::= "remove" counter_removal_plural_amount counter_kind "counters" "from" affected

counter_removal_plural_amount ::= count_plural | number_x | energy_fifty

/* The note describes the payment of this activation, after its preceding instructions. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:$activation_mana_amount_note_program} */
activated_mana_amount_note_limited ::= cost ":" activation_mana_amount_note_program activation_limits "."

/* @sem Program::Program{instructions:[...$instructions, Effect{result:@next, operation:$operation}, Effect{result:@next, operation:Note(ManaSpent{amount:true})}]} */
activation_mana_amount_note_program ::= instructions "." operation "and" "note" "the" "type" "and" "amount" "of" "mana" "spent" "to" "pay" "this" "activation" "cost" "."

/* The named granting object is distinct from the ability holder. */
/* @sem CostPart::ChangeTapState{selections:[_{objects:One($self_ref_named)}], tapped:true} */
cost_tap_named_source ::= "tap" self_ref_named

/* Choice wording describes the same sacrifice cost, with its current filter and count. */
/* @sem Cost::Cost{parts:[$ignore_sacrifice_part]} */
ignore_sacrifice_choice ::= ignore_sacrifice_part "of" "their" "choice"
ignore_sacrifice_part ::= cost_sacrifice | cost_sacrifice_many

/* Resolution payments retain the chosen cost component and its operands. */
/* @sem Operation::PayCost{player:AbilityController, cost:Cost{parts:[$resolution_selection_payment]}, optional:true} */
optional_shared_resolution_payment ::= "you" "may" resolution_selection_payment

resolution_selection_payment ::= cost_tap_any_population | resolution_reveal_x_hand


/* @sem CostPart::Reveal{count:AnyNumber, filter:$adjective_color} */
resolution_reveal_x_hand ::= "reveal" "X" adjective_color "cards" "in" "your" "hand"

/* The payment and both uses of its input receipt stay within one branch. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$resolution_reveal_x_hand]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_permanent)), changes:[Pump{power:Multiply([Constant(-1), CountObjects(CostObjects{payment:Resolution(@marked), component:[0], view:Inputs, phase:Before})]), toughness:Multiply([Constant(-1), CountObjects(CostObjects{payment:Resolution(@marked), component:[0], view:Inputs, phase:Before})])}], duration:$duration, evaluation:Snapshot}}]}, otherwise:Program{}}] */
resolution_reveal_x_pump ::= "you" "may" resolution_reveal_x_hand "." "if" "you" "do" "," target_permanent "gets" "-" "X" "/" "-" "X" duration

/* The performed tap receipt is counted only within its own payment branch. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$resolution_tap_creatures]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($self_explicit_ref)), changes:[Pump{power:CountObjects(CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:Before}), toughness:CountObjects(CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:Before})}], duration:$duration, evaluation:Snapshot}}]}, otherwise:Program{}}] */
resolution_tap_creature_pump ::= "you" "may" resolution_tap_creatures "." self_explicit_ref "gets" "+" "1" "/" "+" "1" duration "for" "each" "creature" "tapped" "this" "way"

/* @sem CostPart::ChangeTapState{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(Tapped), CardType(Creature), ControlledBy(One(AbilityController))])}, choose:AnyNumber}], tapped:true} */
resolution_tap_creatures ::= "tap" "any" "number" "of" "untapped" "creatures" "you" "control"

/* @sem CostObjectSelection::CostObjectSelection{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly(Constant(1))} */
cost_one_plain_permanent ::= ("a" | "an") filter_phrase

/* The selection excludes the ability holder and retains its written filter. */
/* @sem CostObjectSelection::CostObjectSelection{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(SameObject(Source)), ObjectFilter::Not(Token), $filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))}, choose:Exactly(Constant(1))} */
cost_another_nontoken_controlled ::= "another" "nontoken" filter_phrase "you" "control"

/* A die roll can be paid as an action by the ability controller. */
/* @sem CostPart::PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$roll_die_action}]}} */
cost_roll_die ::= roll_die_action

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Hand, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, choose:Exactly(Expr::Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_card_hand ::= "exile" "a" "card" "from" "your" "hand"

/* @sem CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$sacrifice_description}, choose:Exactly(Expr::Constant(1))} */
cost_sacrifice_description ::= "sacrifice" ("a" | "an") sacrifice_description

/* This paired reduction keeps the paid sacrifice and the earlier sacrifice history
   as separate operands, including their independently printed amounts. */
/* @sem Ability::[Casting(ReduceForEachPaid{reductions:[_{amount:$braced_amount}], cost:_{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$paired_sacrifice_population}, choose:Exactly(Constant(1))}]}}), Casting(ReduceCost([_{amount:Multiply([$braced_amount_2, EventHistory{event:Player{event:Sacrifices, players:One(AbilityController), objects:$noun_either}, window:ThisTurn, measure:Occurrences}])}]))] */
casting_paired_sacrifice_reductions ::= optional_cost_opening "sacrifice" "any" "number" "of" paired_sacrifice_population reduce_for_each_opening braced_amount "less" "to" "cast" "for" "each" "permanent" "sacrificed" "this" "way" "and" braced_amount "less" "to" "cast" "for" "each" "other" noun_either "you've" "sacrificed" "this" "turn" "."

/* @sem ObjectFilter::AnyOf([$plural_2, $plural]) */
paired_sacrifice_population ::= plural "and" "/" "or" plural

/* The mana and source exile are the two actual cost components. Both uses
   below refer to the arrival of that exact exile payment. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:Cost{parts:[Mana($mana_symbols), Move{selections:[_{objects:One(Source)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}, limits:$limit_sorcery, announcement:@announcement, body:Program{instructions:$graveyard_exile_copy_body}})} */
graveyard_exile_copy_activation ::= mana_symbols "," "↑" "exile" "this" "card" "from" "your" "graveyard" ":" graveyard_exile_copy_body "." limit_sorcery "."

graveyard_exile_copy_body ::= graveyard_exile_copy_original | graveyard_exile_sized_token

/* @sem CopyException::[SetPowerToughness{power:$value, toughness:$value_2}, Colors{mode:Set, colors:Listed([$mana_color_word])}, AddCreatureTypes($becomes_types)] */
graveyard_copy_traits ::= "it's" "a" value "/" value mana_color_word becomes_types "in" "addition" "to" "its" "other" "types"

/* Life payments compose with bounded, independently described quantities. */
/* @sem CostPart::Life($payment_life_quantity) */
cost_life_measured ::= "pay" payment_life_quantity

payment_life_quantity ::= payment_life_equal | payment_life_each_hand | payment_life_each_counter

/* @sem $payment_equal_value */
payment_life_equal ::= "life" "equal" "to" payment_equal_value

payment_equal_value ::= value_commander_identity

/* @sem $count_each_card_hand */
payment_life_each_hand ::= "1" "life" "for" "each" count_each_card_hand

/* @sem Expr::Multiply([$value, $payment_counter_count]) */
payment_life_each_counter ::= value "life" "for" "each" payment_counter_count

/* @sem Expr::CountCounters(_{recipients:Objects(One($object_ref)), kind:$counter_kind, information:CurrentOrLastKnown}) */
payment_counter_count ::= counter_kind "counter" "on" object_ref

/* A ward's stated object is the ability holder, including copied abilities. */
/* @sem Expr::ObjectProperty{object:AbilityHolder, property:$stat, information:CurrentOrLastKnown} */
payment_holder_stat ::= payment_holder_possessive stat

payment_holder_possessive ::= holder_possessive | payment_named_possessive

/* @sem () */
payment_named_possessive ::= self_named "'s"

/* This quantity is exposed only inside a ward cost. */
/* @sem CostPart::Life($payment_holder_stat) */
cost_ward_holder_life ::= "pay" "life" "equal" "to" payment_holder_stat

/* Keep this comparison scoped to its leading casting reduction shape. */
/* @sem Ability::Casting(If{condition:$condition_opponent_margin, rule:$source_spell_reduction}) */
casting_opponent_margin_reduction ::= "if" condition_opponent_margin "," source_spell_reduction "."

/* A variable counter-removal payment records the selected amount in its cost. */
/* @sem CostPart::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:Count(AtLeast($value))}]} */
cost_remove_at_least_counters ::= "remove" value "or" "more" counter_kind "counters" "from" affected

/* The enclosing activation fixes the receipt at the second payment component.
   Its damage clause can compose with any subsequent instructions. */
/* @sem Ability::Activated{origin:Ordinary, cost:_{parts:[Mana($mana_symbols), $cost_remove_at_least_counters]}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$paid_counter_damage}, ...$instructions]}} */
activation_counter_damage_followed ::= mana_symbols "," "↑" cost_remove_at_least_counters ":" paid_counter_damage "." instructions "."

/* @sem Ability::Activated{origin:Ordinary, cost:_{parts:[Mana($mana_symbols), $cost_remove_at_least_counters]}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$paid_counter_damage}]}} */
activation_counter_damage ::= mana_symbols "," "↑" cost_remove_at_least_counters ":" paid_counter_damage "."

/* This phrase is only dispatched inside the proved activation above. */
/* @sem Operation::DealDamage{source:$object_ref, recipients:Objects($affected), amount:PaidCountersRemoved{payment:Activation, component:[1]}, preventable:true} */
paid_counter_damage ::= object_ref "deals" "that" "much" "damage" "to" affected

/* One selection for each named controlled permanent, sharing the printed filter. */
/* @sem CostObjectSelection::[_{objects:$affected}, ...$controlled_named_pair_selections] */
cost_permanent_selections_affected_named_pair ::= affected "and" controlled_named_pair_selections

/* @sem CostObjectSelection::[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController)), Name($referenced_card_name)])}, choose:Exactly(Constant(1))}, _{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController)), Name($referenced_card_name_2)])}, choose:Exactly(Constant(1))}] */
controlled_named_pair_selections ::= filter_plural "you" "control" "named" referenced_card_name "and" referenced_card_name

/* The same ordinary activation works in its default zone and in the graveyard. */
/* @sem Ability::[$activated_ability, Scoped{zones:[Graveyard], ability:@scope($activated_ability)}] */
line_activation_battlefield_or_graveyard ::= activated_ability "activate" "only" "if" self_text "is" "on" "the" "battlefield" "or" "in" "your" "graveyard" "."

/* An optional additional payment and its consequence are composed by the
   enclosing spell-cost rule; the payer remains the ability controller. */
/* @sem Operand::Cost{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:PayAnyAmount{actor:One(AbilityController), resource:Mana}}]}}]} */
optional_any_mana_payment ::= "pay" "any" "amount" "of" "mana"

/* A cost modifier and its defining expression stay separate from the mechanic. */
/* @sem Operand::Term{family:CastModifier, form:ReduceCostX, operands:[List([Vocabulary{family:CostReductionSymbolX, form:CostReduceX}]), Number($value_greatest_owned_commander_mana)]} */
cast_this_way_reduced_by_commander ::= "this" "spell" "costs" "{" "X" "}" "less" "to" "cast" "this" "way" "," "where" "X" "is" value_greatest_owned_commander_mana

/* @sem Ability::Modified{ability:Mechanic{mechanic:Flashback, cost:$cost}, modifier:$cast_this_way_reduced_by_commander} */
flashback_with_cast_reduction ::= "flashback" cost "." cast_this_way_reduced_by_commander "."

/* @sem Cost::Cost{parts:[Move{selections:[_{objects:Zone{scope:Players{zone:Graveyard, players:One(ControllerOf(AttachedTo(Source)))}, kind:Card, filter:Any}, choose:Exactly($number)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]} */
host_controller_graveyard_exile_cost ::= "exile" number "cards" "from" "their" "graveyard"

/* The explicit source-zone condition permits this activation in the graveyard. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{condition:$source_graveyard_property_condition}, announcement:@announcement, body:$program_sentence})} */
activated_source_graveyard_property ::= cost ":" program_sentence "activate" "only" "if" source_graveyard_property_condition "."

/* The X definition scopes the linked-card program, independently of its cost. */
/* @sem Program::Program{instructions:$clause_copy_linked_free} */
linked_copy_program ::= clause_copy_linked_free "."

linked_activation_program ::= linked_copy_program | program_sentence

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:_{modifiers:[ActivationRule(XIs(NumberTest::Compare{comparison:Equal, value:ObjectProperty{object:$linked_exiled_card, property:ManaValue, information:CurrentOrLastKnown}}))]}, announcement:@announcement, body:$linked_activation_program} */
activated_linked_card_mana_value ::= cost ":" linked_activation_program "x" "is" "the" "mana" "value" "of" linked_exiled_card "."

/* The payment keeps the selected card and its mana cost together. */
/* @sem CostPart::[$cost_exile_graveyard, ManaCostOf(Earlier{what:Exiled})] */
cost_exile_and_pay_mana ::= cost_exile_graveyard "and" "pay" "its" "mana" "cost"

/* A singular card's mana-value restriction composes with its type. */
/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:@and($card_filter, $modifier_mana_value_exact)}, choose:Exactly(Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_graveyard_mana_value ::= "exile" ("a" | "an") card_filter "card" modifier_mana_value_exact "from" "your" "graveyard"

/* The copy phrase is scoped to the singular graveyard-exile payment. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:$cost_exile_and_pay_mana}, limits:$activation_limits, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$copy_paid_card_operation}]}} */
paid_card_copy_activation ::= cost_exile_and_pay_mana ":" copy_paid_card_operation "." activation_limits "."

copy_paid_card_operation ::= copy_paid_card | copy_paid_card_plural

/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Query{objects:CostObjects{payment:Activation, component:[0], view:Performed, phase:After}, index:0}, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
copy_paid_card ::= "create" "a" "token" "that's" "a" "copy" "of" "that" "card"

/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$count, words:CreatingEffect, recipe:Copy{object:Query{objects:CostObjects{payment:Activation, component:[0], view:Performed, phase:After}, index:0}, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
copy_paid_card_plural ::= "create" count "tokens" "that" "are" "copies" "of" "that" "card"

/* X is fixed by the number of matching cards revealed from the payer’s hand. */
/* @sem CostPart::@announced_x(CostPart::Reveal{count:AnyNumber, filter:$announced_hand_card_selection}) */
cost_reveal_announced_hand_selection ::= "reveal" announced_hand_card_selection

/* Keep the sacrifice payment and its tested before-state in one card line.
   Agreement binds the printed description to the cost's actual population. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost::Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($cast_sacrifice_head, $filter_phrase)}, choose:Exactly(Expr::Constant(1))}]}, repetition:Once}), Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$operation}, If{condition:Compare{left:CountObjects(Matching{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Performed, phase:Before}, filter:$cast_sacrifice_quality}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:$operation_2}]}, otherwise:Program{}}]}}] */
line_cast_sacrifice_test ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "sacrifice" cast_sacrifice_head "." NEWLINE operation "." "if" "the" "sacrificed" filter_phrase "was" cast_sacrifice_quality "," operation "."

cast_sacrifice_head ::= cast_sacrifice_head_a | cast_sacrifice_head_an

/* @sem $filter_phrase */
cast_sacrifice_head_a ::= "a" filter_phrase

/* @sem $filter_phrase */
cast_sacrifice_head_an ::= "an" filter_phrase

cast_sacrifice_quality ::= cast_sacrifice_quality_adjective | cast_sacrifice_quality_a | cast_sacrifice_quality_an

/* @sem $adjectives */
cast_sacrifice_quality_adjective ::= adjectives

/* @sem $filter_phrase */
cast_sacrifice_quality_a ::= "a" filter_phrase

/* @sem $filter_phrase */
cast_sacrifice_quality_an ::= "an" filter_phrase

/* @sem CostPart::ChangeTapState{selections:[_{objects:$affected, choose:AnyNumber}], tapped:true} */
cost_tap_any_population ::= "tap" "any" "number" "of" affected

/* @sem CostPart::[$cost_remove_kind_among, $cost_sacrifice_affected] */
cost_parts_and_later ::= "↑" cost_remove_kind_among "and" cost_sacrifice_affected

/* The performer of this payment is the new controller. */
/* @sem CostPart::PlayerAction{player:$control_payment_actor, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($object_ref)), changes:[SetController($control_payment_actor)], duration:Indefinite, evaluation:Snapshot}}]}} */
cost_have_player_gain_control ::= "have" control_payment_actor "gain" "control" "of" object_ref

control_payment_actor ::= control_payment_opponent | player_ref

/* @sem PlayerRef::OneOf(OpponentsOf(AbilityController)) */
control_payment_opponent ::= "an" "opponent"

evidence_amount ::= number | evidence_targeted_mana_value

/* The announced targets supply the total used to pay the keyword cost. */
/* @sem Expr::Earlier{what:Targeted, measure:Total(ManaValue)} */
evidence_targeted_mana_value ::= "X" "," "where" "X" "is" "the" "total" "mana" "value" "of" "the" "permanents" "this" "spell" "targets"

/* A single graveyard constrains the selection independently of its destination. */
/* @sem CostPart::SinglePlayersCards(Move{selections:[$cost_single_graveyard_cards], destination:$cost_plural_owner_library}) */
cost_put_single_graveyard_cards ::= "put" cost_single_graveyard_cards cost_plural_owner_library

/* @sem CostObjectSelection::CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:Any}, choose:Exactly($card_count_many)} */
cost_single_graveyard_cards ::= card_count_many "from" "a" "single" "graveyard"

/* The condition and the casting permission have independent operands. */
/* @sem Ability::Casting(If{condition:$condition, rule:AlternativeCostWithFlash{}}) */
casting_creature_free_with_flash_if ::= "if" condition "," "you" "may" "cast" "this" "creature" "without" "paying" "its" "mana" "cost" "and" "as" "though" "it" "had" "flash" "."

/* Participial casting costs can combine independently specified payments. */
/* @sem CostPart::Life($value) */
cast_pay_life_part ::= "paying" value "life"

/* @sem CostPart::[$cast_pay_life_part, $cast_additional_cost_part] */
cast_life_and_additional_parts ::= cast_pay_life_part "and" cast_additional_cost_part

/* The callback counts the same sacrifice result; both object descriptions must agree. */
/* @sem CostPart::PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($filter_plural, $filter_head)}, choose:AnyNumber}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:Source, times:CountObjects(Transition{result:@reflexive_performed, phase:Before}), targets:Same, exceptions:[]}}]}})}]}} */
cost_sacrifice_copy_receipt ::= "sacrifice" "one" "or" "more" filter_plural "." "when" "you" "do" "," "copy" "this" "spell" "for" "each" filter_head "sacrificed" "this" "way"

/* A target-free named-card conjuration can also be activated from the graveyard. */
/* @sem Ability::[Activated{origin:Ordinary, cost:$cost, limits:_{}, body:_{instructions:[Effect{result:@next, operation:$conjure_named_hand}]}, announcement:@announcement}, Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, body:_{instructions:[Effect{result:@next, operation:$conjure_named_hand}]}, announcement:@announcement})}] */
line_activated_also_graveyard_conjure ::= cost ":" conjure_named_hand "." "you" "may" "also" "activate" "this" "ability" "while" "this" "card" "is" "in" "your" "graveyard" "."

/* One controlled, unblocked attacker returns to its owner's hand as a cost. */
/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([State(Unblocked), Attacking, $filter_phrase, ControlledBy(One(AbilityController))])}, choose:Exactly(Constant(1))}], destination:OwnersHand(CardArrival{counters:[], states:[]})} */
cost_return_unblocked_attacker ::= "return" "an" "unblocked" "attacking" filter_phrase "you" "control" "to" "its" "owner's" "hand"

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
self_put_battlefield_plain ::= "onto" "the" "battlefield"

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}} */
self_put_battlefield_tapped_attacking ::= "onto" "the" "battlefield" "tapped" "and" "attacking"

/* A sacrifice program used as an additional casting payment. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Constant(1))})}]} */
cast_sacrificing_a_permanent ::= "sacrificing" "a" filter_phrase

/* @sem Program::Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Constant(1))})}]} */
cast_sacrificing_an_permanent ::= "sacrificing" "an" filter_phrase

cast_sacrificing_permanent ::= cast_sacrificing_a_permanent | cast_sacrificing_an_permanent

/* The selection and its total mana value constraint compose independently. */
/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$card_filter}, choose:AnyNumber}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_any_graveyard_filtered ::= "exile" "any" "number" "of" card_filter "cards" "from" "your" "graveyard"

/* @sem SelectionConstraint::TotalProperty{property:ManaValue, comparison:GreaterOrEqual, amount:$value} */
cost_constraint_total_mana_minimum ::= "with" "total" "mana" "value" value "or" "greater"

/* The payer is the player affected by the alternative cost rule. */
/* @sem CostPart::RemoveCounters{removals:[_{player:Affected, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}), kind:$counter_kind, amount:AmongThem(Exactly(Constant(1)))}]} */
affected_counter_payment ::= "remove" "a" counter_kind "counter" "from" "a" filter_phrase

/* The explicit restriction also establishes the activation zone. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{condition:ObjectMatches{object:Source, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}}, body:$program_sentence, announcement:@announcement})} */
activated_only_own_graveyard ::= cost ":" program_sentence "activate" "only" "if" "this" "card" "is" "in" "your" "graveyard" "."

/* Exiling this card from the graveyard scopes the activation there; the other
   selected cards have their own explicit name and exclude the source. */
/* @sem CostPart::Move{selections:[_{objects:One(Source)}, _{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([Not(SameObject(Source)), Name($referenced_card_name)])}), choose:Exactly($value)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_self_and_named ::= "exile" "this" "card" "and" value "other" "cards" "named" referenced_card_name "from" "your" "graveyard"

/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_exile_self_and_named]}, limits:$activation_limits, announcement:@announcement, body:$program})} */
activated_exile_self_and_named_limited ::= cost_exile_self_and_named ":" program "." activation_limits "."

/* A granted ability can pay by exiling its granting object. */
/* @sem Cost::Cost{parts:[Mana($mana_symbols), Move{selections:[_{objects:One(GrantingObject)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]} */
granting_object_exile_cost ::= mana_symbols "," "↑" "exile" SELF_NAME

/* A graveyard return establishes the activation zone; the grant is attached
   to the exact arriving object, and the reduction counts a live population. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{modifiers:[ActivationRule(Cost{modifier:Reduce{reductions:[_{amount:@times($braced_number, $count_each_land_type)}], spill_into_generic:true}})]}, announcement:@announcement, body:Program{instructions:[...$graveyard_return_quoted_grant]}})} */
activated_graveyard_return_grant_reduced ::= cost ":" graveyard_return_quoted_grant "this" "ability" "costs" braced_number "less" "to" "activate" "for" "each" count_each_land_type "."

/* @sem Instruction::[Effect{result:@next, operation:$self_graveyard_return}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[GrantAbility(@holder($graveyard_return_granted_ability))], duration:Indefinite, evaluation:Snapshot}}] */
graveyard_return_quoted_grant ::= self_graveyard_return "." "it" "gains" '"' graveyard_return_granted_ability '"'

/* A modal activation whose timing limit follows its choice header. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{sorcery:true}, announcement:Announcement{modes:ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}}}, body:Program{}} */
activated_modal_sorcery_header ::= cost ":" "choose" number_words "." "activate" "only" "as" "a" "sorcery" "." NEWLINE modes

/* An activation can continue a preceding instruction with the owner's choice. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[...$draw_optional_hand_entry, ...$clause_owner_draw_hand_entry]}} */
activated_owner_draw_followup ::= cost ":" draw_optional_hand_entry "." clause_owner_draw_hand_entry "."

/* A die table governed by a graveyard-only activation keeps the roll and each
   independent result row in the same scoped ability. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{condition:ObjectMatches{object:Source, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}}, announcement:@announcement, body:Program{instructions:[...$die_table_head, ...$graveyard_die_rows]}})} */
activated_graveyard_die_table ::= cost ":" die_table_head "." "activate" "only" "if" "this" "card" "is" "in" "your" "graveyard" "." NEWLINE graveyard_die_rows

/* The card is in its controller's graveyard, so its owner is that player. */
graveyard_die_rows ::= graveyard_die_rows_one | graveyard_die_rows_more

/* @sem Instruction::[$graveyard_die_row] */
graveyard_die_rows_one ::= graveyard_die_row

/* @sem Instruction::[$graveyard_die_row, ...$graveyard_die_rows] */
graveyard_die_rows_more ::= graveyard_die_row NEWLINE graveyard_die_rows

graveyard_die_row ::= graveyard_die_range | graveyard_die_exact

/* @sem Instruction::If{condition:AllOf([Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:LessOrEqual, value:$number_2}}]), then:$graveyard_die_program, otherwise:_{}} */
graveyard_die_range ::= number "―" number "|" graveyard_die_program

/* @sem Instruction::If{condition:Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:Equal, value:$number}}, then:$graveyard_die_program, otherwise:_{}} */
graveyard_die_exact ::= number "|" graveyard_die_program

graveyard_die_program ::= graveyard_die_self_top | graveyard_die_self_hand | graveyard_die_self_tapped | program_sentence

/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One(Source), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{}}, qualifiers:[]}}]} */
graveyard_die_self_top ::= "put" "this" "card" "on" "top" "of" "your" "library" "."

/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One(Source), destination:OwnersHand(CardArrival{}), qualifiers:[]}}]} */
graveyard_die_self_hand ::= "return" "this" "card" "to" "your" "hand" "."

/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One(Source), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true}}, qualifiers:[]}}]} */
graveyard_die_self_tapped ::= "return" "this" "card" "to" "the" "battlefield" "tapped" "."

/* A controlled untapped permanent and an independent sacrifice form one payment. */
/* @sem CostPart::[$cost_tap_controlled_untapped, $cost_sacrifice] */
cost_tap_controlled_and_sacrifice ::= cost_tap_controlled_untapped "and" cost_sacrifice

/* @sem CostPart::ChangeTapState{selections:[CostObjectSelection{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(Tapped), $filter_phrase, ControlledBy(One(AbilityController))])}, choose:Exactly(Constant(1))}], tapped:true} */
cost_tap_controlled_untapped ::= "tap" "an" "untapped" filter_phrase "you" "control"

/* Reveal the value previously chosen by the activating player. */
/* @sem CostPart::RevealChoice($revealed_choice_kind) */
cost_reveal_chosen_value ::= "reveal" "the" revealed_choice_kind "you" "chose"

revealed_choice_kind ::= revealed_player | revealed_creature_type | revealed_card_type | revealed_color | revealed_number

/* @sem ValueKind::CreatureType */
revealed_creature_type ::= "creature" "type"

/* @sem ValueKind::CardType */
revealed_card_type ::= "card" "type"

/* @sem ValueKind::Color */
revealed_color ::= "color"

/* @sem ValueKind::Number */
revealed_number ::= "number"

cast_timing ::= cast_timing_during | cast_timing_after_combat

/* @sem $cast_window */
cast_timing_during ::= "during" cast_window

/* @sem Condition::Window(AfterCombat) */
cast_timing_after_combat ::= "after" "combat"

/* Commander tax is fixed at {2} per prior cast; the IR operand is the
   independently stated life payment, not the generic mana amount. */
/* @sem $number_digits */
life_payment_that_many_times ::= "pay" number_digits "life" "that" "many" "times"

/* @sem Ability::Casting(TaxPaidAsLife($life_payment_that_many_times)) */
casting_commander_tax_as_life ::= "rather" "than" "pay" "{" "2" "}" "for" "each" "previous" "time" "you've" "cast" "this" "spell" "from" "the" "command" "zone" "this" "game" "," life_payment_that_many_times "."

/* @sem Ability::Casting(Require($window_before_declaration)) */
casting_only_before_declaration ::= "cast" "this" "spell" "only" window_before_declaration "."

/* A teamwork header supplies the optional cost used by a casting permission. */
/* @sem Cost::Cost{parts:[Teamwork($number)]} */
teamwork_cast_cost ::= "teamwork" NUMBER

/* @sem Ability::Casting(Flash{additional_cost:$teamwork_cast_cost}) */
teamwork_flash_permission ::= teamwork_cast_cost NEWLINE "you" "may" "cast" "this" "spell" "as" "though" "it" "had" "flash" "if" "it's" "cast" "using" "teamwork" "."

/* The restriction applies to the alternative payment as a whole. */
/* @sem Ability::Casting(AlternativeCost($treasure_alternative_payment)) */
casting_alternative_treasure ::= "you" "may" treasure_alternative_payment

/* @sem Cost::Cost{parts:[ManaFromTreasure($mana_symbols)]} */
treasure_alternative_payment ::= "pay" mana_symbols rather_than_mana_cost "." "spend" "only" "mana" "produced" "by" "Treasures" "to" "cast" "it" "this" "way" "."

/* The additional payment supplies the cost to cast at flash speed. */
/* @sem Ability::Casting(Flash{additional_cost:_{parts:[$flash_behold_payment]}}) */
casting_flash_behold_payment ::= "you" "may" "cast" "this" "spell" "as" "though" "it" "had" "flash" "if" "you" flash_behold_payment "as" "an" "additional" "cost" "to" "cast" "it" "."

flash_behold_payment ::= cost_behold | cost_behold_many

/* @sem Change::[PlayerRule(SpellCost{spells:$limited_cast_spell, modifier:Alternate{cost:Alternate($generic_alternative), limit:EachTurn(1)}})] */
limited_exile_alternative ::= "you" "may" "pay" generic_alternative "rather" "than" "pay" "the" "mana" "cost" "for" limited_cast_spell

/* @sem Ability::Conditional{condition:PlayerIsActive(AbilityController), then:[Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:$limited_exile_alternative})]} */
own_turn_limited_exile_alternative ::= "once" "during" "each" "of" "your" "turns" "," limited_exile_alternative "."

/* Counts keep the historical actor and event separately from the reduction. */
/* @sem Expr::EventHistory{event:Player{event:Draws, players:One(AbilityController)}, window:ThisTurn, measure:Occurrences} */
casting_history_drawn_card ::= "card" "you've" "drawn" "this" "turn"

/* Sacrifice events only apply to permanents, irrespective of their controller. */
/* @sem Expr::EventHistory{event:Player{event:Sacrifices, players:All, objects:Any}, window:ThisTurn, measure:Occurrences} */
casting_history_sacrificed_permanent ::= "permanent" "sacrificed" "this" "turn"

/* The payment is explicitly the sole removal component of this activation. */
/* @sem Expr::Divide{numerator:PaidCountersRemoved{payment:Activation, component:[0]}, denominator:$value, rounding:Down} */
paid_counter_groups ::= "for" "each" value "counters" "removed" "this" "way"

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::TakeExtraTurn{times:$paid_counter_groups}} */
extra_turn_per_paid_counter_group ::= paid_counter_groups "," "take" "an" "extra" "turn" "after" "this" "one"

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_remove_all_counters_from]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$extra_turn_per_paid_counter_group}]}} */
activated_remove_counters_extra_turn ::= cost_remove_all_counters_from ":" extra_turn_per_paid_counter_group "."

/* @sem Operation::Move{objects:One($self_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}, qualifiers:[]} */
self_return_battlefield_tapped_attacking ::= "return" self_ref "from" "your" "graveyard" "to" "the" "battlefield" "tapped" "and" "attacking"

/* The selected hand card and its bounded characteristic stay in one payment. */
/* @sem CostPart::Move{selections:[_{objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, Property{property:TotalPowerAndToughness, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])}), choose:Exactly($counter_amount)}], destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}} */
hand_total_stats_entry ::= "put" counter_amount filter_phrase "card" "with" "total" "power" "and" "toughness" value "or" "less" "from" "your" "hand" "onto" "the" "battlefield"

/* The optional payment and sacrifice share the holder as their source. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$holder_mana_payment, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:One($payment_self_creature)})}]}, otherwise:_{}}]} */
holder_unless_payment_program ::= "sacrifice" payment_self_creature "unless" "you" "pay" holder_mana_payment "."

/* @sem Cost::Cost{parts:[ManaCostOf(Source)]} */
holder_mana_cost_payment ::= "its" "mana" "cost"

holder_mana_payment ::= holder_mana_cost_payment | holder_mana_symbols

/* @sem ObjectRef::@self */
payment_self_creature ::= self_creature

/* One controlled permanent returned as a payment retains its controller. */
/* @sem CostObjectSelection::CostObjectSelection{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun, ControlledBy(One(AbilityController))])}, choose:Exactly(Constant(1))} */
cost_one_controlled_permanent ::= "a" noun "you" "control"

/* @sem ValueKind::Player */
revealed_player ::= "player"

/* The activation fixes the second component as a +1/+1 counter payment. */
/* @sem CostPart::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($self_explicit_ref)), kind:PowerToughness([1, 1]), amount:Count(AtLeast($value))}]} */
cost_remove_at_least_plus_counters ::= "remove" value "or" "more" "+" "1" "/" "+" "1" "counters" "from" self_explicit_ref

/* This consumer is dispatched only with the matching payment below. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, Property{property:Power, test:NumberTest::Compare{comparison:LessOrEqual, value:PaidCountersRemoved{payment:Activation, component:[1]}}}])}), index:0})), changes:[SetController(AbilityController)], duration:Indefinite, evaluation:Snapshot} */
paid_plus_counters_control ::= "gain" "control" "of" "target" noun "with" "power" "less" "than" "or" "equal" "to" "the" "number" "of" "+" "1" "/" "+" "1" "counters" "removed" "this" "way"

/* @sem Ability::Activated{origin:Ordinary, cost:_{parts:[TapSymbol, $cost_remove_at_least_plus_counters]}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$paid_plus_counters_control}]}} */
activated_paid_plus_counters_control ::= "{" "T" "}" "," "↑" cost_remove_at_least_plus_counters ":" paid_plus_counters_control "."

/* The copy refers to the single creature-type permanent paid in the third
   activation component; keep this phrase inside the scoped activation below. */
/* @sem TokenSpec::TokenSpec{amount:$token_copy_plural, words:CreatingEffect, recipe:Copy{object:Query{objects:CostObjects{payment:Activation, component:[2], view:Inputs, phase:Before}, index:0}, exceptions:[]}} */
token_copy_sacrificed_activation_creature ::= token_copy_plural "the" "sacrificed" "creature"

/* @sem CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $creature_subtype)}, choose:Exactly(Expr::Constant(1))} */
cost_sacrifice_another_creature_type ::= "sacrifice" "another" creature_subtype

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, $cost_tap, $cost_sacrifice_another_creature_type]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$token_copy_sacrificed_activation_creature], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]}} */
activated_copy_sacrificed_creature ::= cost_mana "," cost_tap "," "↑" cost_sacrifice_another_creature_type ":" "create" token_copy_sacrificed_activation_creature "."

/* Entry variants share the scoped self-return activation and trigger frames. */
/* @sem Operation::Move{objects:One($self_ref), destination:Battlefield{controller:Player(AbilityController), arrival:$transformed_entry}, qualifiers:[]} */
self_return_battlefield_transformed ::= "return" self_ref "from" "your" "graveyard" "to" "the" "battlefield" transformed_entry

/* @sem Operation::Move{objects:One($self_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[Optional{decider:AbilityController, entry:BattlefieldArrival{tapped:false, counters:[], states:[FaceDown]}}]}}, qualifiers:[]} */
self_return_battlefield_face_choice ::= "return" self_ref "from" "your" "graveyard" "to" "the" "battlefield" "face" "up" "or" "face" "down"

/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:AnyOf([SameObject(Source), SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$noun, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0})])}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]} */
self_return_with_target_tapped ::= "return" "this" "card" "and" "target" noun "card" "from" "your" "graveyard" "to" "the" "battlefield" "tapped"

/* The adjacent singular return establishes the arrival receipt used by the grant. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$self_return_battlefield_attached}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:[GrantAbility($token_quoted_sentence)]}}]} */
self_return_attached_perpetual ::= self_return_battlefield_attached "." "this" "Aura" "perpetually" "gains" token_quoted_sentence

/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:$self_return_attached_perpetual})} */
activated_self_return_perpetual ::= cost ":" self_return_attached_perpetual activation_limits "."

/* @sem Cost::Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly($counter_a)}]} */
attack_sacrifice_payment ::= "sacrifices" counter_a filter_phrase "of" "their" "choice"

/* Scope the color measurement to the third, singleton creature payment. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, TapSymbol, Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:Exactly(Constant(1))}]}, limits:$activation_limits, announcement:@announcement, body:$sacrificed_creature_color_search_cast} */
activated_sacrificed_creature_color_search ::= cost_mana "," "{T}" "," "↑" "sacrifice" "a" "creature" ":" sacrificed_creature_color_search_cast "." activation_limits "."

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, TapSymbol, Sacrifice{objects:One(Source)}]}, limits:_{}, announcement:@announcement, body:$opponent_search_exile_upkeep_program} */
activated_sacrifice_self_search_upkeep ::= cost_mana "," "{T}" "," "↑" "sacrifice" "this" "artifact" ":" opponent_search_exile_upkeep_program "."

/* The copied abilities come from this activation's exile payment, component 1.
   Keeping the payment and consumer together proves the receipt in both directions. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[TapSymbol, $cost_exile_permanent]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$paid_exile_legendary_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]}} */
activated_exile_abilities_token ::= "{" "T" "}" "," "↑" cost_exile_permanent ":" "create" paid_exile_legendary_token "."

/* The copy refers to the singular second activation payment, not a prior effect.
   Both descriptions constrain that same sacrificed object. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), ObjectFilter::@agree($filter_phrase, $filter_phrase_2))}, choose:Exactly(Constant(1))}]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($self_explicit_ref)), changes:[CopyOf{object:Query{objects:CostObjects{payment:Activation, component:[1], view:Inputs, phase:Before}, index:0}, exceptions:$copy_exceptions_plain}], duration:Indefinite, evaluation:Snapshot}}]}} */
activated_sacrifice_copy_payment ::= cost_mana "," "↑" "sacrifice" "another" filter_phrase ":" self_explicit_ref "becomes" "a" "copy" "of" "the" "sacrificed" filter_phrase "," "except" copy_exceptions_plain "."

/* A target performs the draw as a component of the payer's resolution cost. */
/* @sem CostPart::PlayerAction{player:$target_opponent, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One($target_opponent), amount:$card_count}}]}} */
cost_have_target_opponent_draw ::= "have" target_opponent "draw" card_count

/* @sem Cost::Cost{parts:[$cost_sacrifice_many, $cost_life, $cost_have_target_opponent_draw]} */
cost_sacrifice_life_opponent_draw ::= cost_sacrifice_many "," cost_life "," "and" cost_have_target_opponent_draw

/* Compose an ordinary activation with the word substitution program. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:_{instructions:$color_word_upkeep_program}} */
activated_color_word_upkeep ::= cost ":" color_word_upkeep_program

/* The choice is an activation cost, while transfer targets are announced. */
/* @sem Ability::Activated{origin:Ordinary, cost:_{parts:[...$cost_parts, PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:$choose_checkable_ability}]}}]}, limits:_{}, announcement:@announcement, body:_{instructions:$chosen_ability_transfer_program}} */
activated_choose_ability_transfer ::= cost_parts "," "↑" choose_checkable_ability ":" chosen_ability_transfer_program

/* The named source's subtype gates its self animation. */
/* @sem Ability::Activated{origin:Ordinary, cost:_{parts:[Mana($mana_symbols)]}, limits:_{}, announcement:@announcement, body:_{instructions:[If{condition:ObjectMatches{object:Source, filter:$subtype}, then:_{instructions:[Effect{result:@next, operation:$self_type_quoted_damage_animation}]}, otherwise:_{}}]}} */
activated_self_subtype_quoted_animation ::= mana_symbols ":" "if" SELF_NAME "is" "a" subtype "," self_type_quoted_damage_animation

/* Revealing the source from hand makes this activation available there. */
/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[...$cost_parts, $cost_reveal_self_hand]}, limits:$activation_limits, announcement:@announcement, body:$program_sentence})} */
activated_reveal_self_hand_limited ::= cost_parts "," "↑" cost_reveal_self_hand ":" program_sentence activation_limits "."

/* The number of cards paid is the value stated after the zone. */
/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, choose:Exactly($value)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
cost_exile_graveyard_equal_value ::= "exile" "cards" "from" "your" "graveyard" "equal" "to" value

/* @prefer always */
/* @sem Vec<ManaReduction>::[ManaReduction{amount:$braced_amount}, ...$colored_reductions] */
activation_mana_reductions_colored ::= braced_amount colored_reductions

/* @sem Vec<ManaReduction>::[ManaReduction{amount:$braced_amount}] */
activation_mana_reductions_generic ::= braced_amount

/* A voluntary resolution payment and its success-dependent continuation. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$cost, optional:true}}, If{condition:PaymentChosen(@marked), then:$program, otherwise:Program{}}]} */
optional_cost_paid_program ::= "you" "may" cost "." "if" "you" "do" "," program "."

/* The reduction and its condition qualify the preceding activation mechanic. */
/* @sem Operand::Term{family:ActivateModifier, form:ReduceCostIf, operands:[Condition($condition), $generic_reduction_symbols]} */
activation_mechanic_reduction_if ::= "this" "ability" "costs" generic_reduction_symbols "less" "to" "activate" "if" condition

/* These keyword costs are activated abilities. */
activation_mechanic_name ::= mechanic_specialize_name | mechanic_outlast_name | mechanic_transmute_name

/* @sem Ability::Modified{ability:Mechanic{mechanic:$activation_mechanic_name, cost:$cost}, modifier:$activation_mechanic_reduction_if} */
activation_mechanic_conditional_reduction ::= activation_mechanic_name cost "." activation_mechanic_reduction_if "."

/* Scope the comparison to the immediately preceding singular discard payment. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$discard_one_payment]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:Property{property:$discarded_same_property, test:NumberTest::Compare{comparison:Equal, value:ObjectProperty{object:Query{objects:CostObjects{payment:Resolution(0), component:[0], view:Inputs, phase:Before}, index:0}, property:$discarded_same_property, information:CurrentOrLastKnown}}}, count:UpTo(Constant(1))}]}}, ...$search_follow]}, otherwise:Program{}}]} */
program_discard_same_value_search ::= "you" "may" discard_one_payment "." "if" "you" "do" "," "search" "your" "library" "for" "a" "card" discarded_same_property search_follow

/* @sem ObjectProperty::ManaValue */
discarded_same_property ::= "with" "the" "same" "mana" "value" "as" "that" "card"

/* This wrapper starts a fresh ability result frame for the payment receipt. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$program_discard_same_value_search} */
triggered_discard_same_value_search ::= event_clause "," program_discard_same_value_search "."

/* Scope the receipt consumer to a mana payment followed by the single
   creature sacrifice that supplies component 1. */
/* @sem CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:Exactly(Constant(1))} */
cost_single_creature_sacrifice ::= "sacrifice" "a" "creature"

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, $cost_single_creature_sacrifice]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_same_mana_as_activation_sacrifice}, regeneration:true}}]}} */
activated_sacrifice_same_mana_destroy ::= cost_mana "," "↑" cost_single_creature_sacrifice ":" "destroy" "each" filter_same_mana_as_activation_sacrifice "."

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_other_than_tapped_activation_creature}), index:0} */
target_other_than_tapped_activation_creature ::= "target" filter_other_than_tapped_activation_creature

/* The activation's sole tap cost supplies the exact receipt in its target. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[ChangeTapState{selections:[_{objects:One(AttachedTo(Source))}], tapped:true, symbol:false}]}, limits:ActivationLimits{condition:ObjectMatches{object:AttachedTo(Source), filter:Not(Tapped)}}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_other_than_tapped_activation_creature)), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot}}]}} */
activated_tap_attached_other_pump ::= "tap" "enchanted" "creature" ":" target_other_than_tapped_activation_creature "gets" signed "/" signed duration "." "activate" "only" "if" "enchanted" "creature" "is" "untapped" "."

/* Keep the casting payment and its dependent spell in one producer-consumer
   scope so an unrelated casting cost cannot print as a sacrifice. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost{parts:[$cost_single_creature_sacrifice]}, optional:false, repetition:Once}), Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_shared_type_cast_sacrifice}, regeneration:false}}]}}] */
line_sacrifice_shared_type_destroy ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," cost_single_creature_sacrifice "." NEWLINE "destroy" "all" filter_shared_type_cast_sacrifice "." "they" "can't" "be" "regenerated" "."

/* A bounded sacrifice selects from the stated battlefield population. */
/* @sem CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:UpTo($value)} */
cost_sacrifice_up_to ::= "sacrifice" "up" "to" value filter_plural

/* The unique sacrifice is the second cost component in this complete activation. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_tap, $cost_sacrifice_up_to]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[If{condition:$sacrificed_type_count_condition, then:Program{instructions:$conjoined}, otherwise:Program{}}]}} */
activated_tap_sacrifice_type_threshold ::= cost_tap "," "↑" cost_sacrifice_up_to ":" "if" sacrificed_type_count_condition "," conjoined "."

/* @sem Condition::Compare{left:$second_sacrifice_card_type_count, test:$condition_at_least} */
sacrificed_type_count_condition ::= "there" "were" condition_at_least second_sacrifice_card_type_count

/* @sem Expr::CountDistinct{objects:CostObjects{payment:Activation, component:[1], view:Performed, phase:Before}, property:CardTypes} */
second_sacrifice_card_type_count ::= "card" "types" "among" "the" "sacrificed" "permanents"

/* The defending player chooses whether to pay the sacrifice cost. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:DefendingPlayerOf(EventSubject), cost:_{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$noun}, choose:Exactly(Constant(1))}]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[GrantAbility(Static(_{kind:Ordinary, affected:Objects(One(Source)), changes:[Rule(Prohibit(BeBlocked(Any)))]}))], duration:$duration, evaluation:Snapshot}}]}, otherwise:_{}}]} */
shared_defender_sacrifice_evasion ::= "it" "gains" '"' "↓" "this" "creature" "can't" "be" "blocked" '"' duration "unless" "defending" "player" "sacrifices" "a" noun "of" "their" "choice"

/* @sem Ability::Triggered{event:Object{event:Attacks, objects:$event_self}, limits:TriggerLimits{}, announcement:@announcement, body:$shared_defender_sacrifice_evasion} */
shared_self_attack_defender_payment ::= "whenever" event_self "attacks" "," shared_defender_sacrifice_evasion "."

/* Alternative payments reuse complete cost parts and preserve each branch. */
cost_word_after_mana ::= cost_discard | cost_discard_many | cost_discard_filtered | cost_remove_a_counter_from | cost_life | cost_sacrifice | cost_exile_hand

/* @sem CostPart::Choice([_{parts:[$cost_mana]}, _{parts:[$cost_word_after_mana]}]) */
cost_mana_or_word_payment ::= "pay" cost_mana "or" cost_word_after_mana

/* The second discard omits its verb, but remains a separate payment. */
/* @sem CostPart::Discard{count:Constant(1), filter:$filter_phrase} */
cost_discard_an_filtered_card ::= "discard" "an" filter_phrase "card"

/* @sem CostPart::Discard{count:Constant(1), filter:@and($filter_phrase, $modifier_with_keyword)} */
cost_qualified_card_discard ::= "a" filter_phrase "card" modifier_with_keyword

/* @sem CostPart::Choice([_{parts:[$cost_discard_an_filtered_card]}, _{parts:[$cost_qualified_card_discard]}]) */
cost_discard_or_qualified_card ::= cost_discard_an_filtered_card "or" cost_qualified_card_discard

/* Either counter kind is removed from one selected battlefield permanent.
   The selected population and both counter kinds remain independent operands. */
/* @sem CostPart::Choice([Cost{parts:[RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counter_payment_source}), kind:$counter_kind, amount:Count(Exactly(Constant(1))), selection:_{player:AbilityController, count:Exactly(Constant(1))}}]}]}, Cost{parts:[RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counter_payment_source}), kind:$counter_kind_2, amount:Count(Exactly(Constant(1))), selection:_{player:AbilityController, count:Exactly(Constant(1))}}]}]}]) */
cost_remove_one_of_two_counter_kinds ::= "remove" "a" counter_kind "counter" "or" "a" counter_kind "counter" "from" counter_payment_source

/* The printed sacrificed creature is the sole creature paid by this activation.
   Keep that producer and its counted mana symbols in the same ability scope. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:Exactly(Constant(1))}]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$damage_sacrificed_creature_symbols}]}} */
activated_sacrifice_creature_symbols ::= cost_mana "," "↑" "sacrifice" "a" "creature" ":" damage_sacrificed_creature_symbols "."

/* @sem Operation::DealDamage{source:$damage_source_ref, recipients:$recipients, amount:$sacrificed_creature_symbols, preventable:true} */
damage_sacrificed_creature_symbols ::= damage_source_ref "deals" "damage" "to" recipients "equal" "to" sacrificed_creature_symbols

/* @sem Expr::CountManaSymbols{objects:Earlier{what:Sacrificed}, colors:[$sacrifice_symbol_color]} */
sacrificed_creature_symbols ::= "the" "number" "of" sacrifice_symbol_color "mana" "symbols" "in" "the" "sacrificed" "creature's" "mana" "cost"

sacrifice_symbol_color ::= dc_white | dc_blue | dc_black | dc_red | dc_green

/* The selected single land supplies a later mana-production reference. */
/* @sem CostPart::ChangeTapState{selections:[CostObjectSelection{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Tapped, ObjectFilter::CardType(Land), $paid_land_controller)}, choose:Exactly(Expr::Constant(1))}], tapped:false} */
cost_untap_tapped_land ::= "untap" "a" "tapped" "land" paid_land_controller

paid_land_controller ::= modifier_opponent_controls | modifier_you_control

/* A cast restriction qualifies the preceding alternate-cost mechanic. */
/* @sem Ability::Modified{ability:$flashback_word_cost_mechanic, modifier:$cast_this_way_x_nonzero} */
modified_flashback_cast_restriction ::= flashback_word_cost_mechanic cast_this_way_x_nonzero "."

/* @sem Ability::Mechanic{mechanic:Flashback, cost:$cost} */
flashback_word_cost_mechanic ::= "flashback" "―" cost "."

/* @sem Operand::Term{family:CastModifier, form:XCantBeZero} */
cast_this_way_x_nonzero ::= "if" "you" "cast" "this" "spell" "this" "way" "," "↑" "x" "can't" "be" "0"

/* A cost-bearing activated mechanic can carry an explicit activation condition. */
/* @sem Ability::Modified{ability:$conditional_activated_mechanic, modifier:$activate_only_if_modifier} */
conditional_mechanic_activation ::= conditional_activated_mechanic "." activate_only_if_modifier "."

/* @sem Ability::Mechanic{mechanic:$activated_mechanic_name, cost:$keyword_payment} */
conditional_activated_mechanic ::= activated_mechanic_name keyword_payment

activated_mechanic_name ::= mechanic_specialize_name | mechanic_scavenge_name | mechanic_encore_name | mechanic_embalm_name | mechanic_eternalize_name | mechanic_outlast_name | mechanic_transmute_name | mechanic_reconfigure_name | mechanic_fortify_name | mechanic_aura_swap_name | mechanic_transfigure_name

/* @sem Operand::Term{family:ActivateModifier, form:ActivateOnlyIf, operands:[Condition($condition)]} */
activate_only_if_modifier ::= "activate" "only" "if" condition

/* In an activation modifier, other excludes the source of that ability. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $other_count_filter)}) */
activation_count_other_source ::= "other" other_count_filter

/* Scope the consumer with the exact singleton creature casting payment it names. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:Exactly(Constant(1))}]}, repetition:Once}), Spell{announcement:@announcement, body:Program{instructions:$casting_sacrifice_life_then_operation}}] */
line_casting_sacrifice_life_then_operation ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "sacrifice" "a" "creature" "." NEWLINE casting_sacrifice_life_then_operation "."

/* The written definition is scoped to its actual cost producer. The shared
   pump fragment leaves X symbolic until the enclosing payment binds it. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:Multiply([Constant(-1), AnnouncedX]), toughness:Multiply([Constant(-1), AnnouncedX])}], duration:$duration, evaluation:Snapshot} */
receipt_negative_pump ::= affected "gets" "-" "X" "/" "-" "X" duration

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:AnnouncedX, toughness:AnnouncedX}], duration:$duration, evaluation:Snapshot} */
receipt_positive_pump ::= affected "gets" "+" "X" "/" "+" "X" duration

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}, choose:AnyNumber}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
receipt_exile_any_graveyard ::= "exile" "any" "number" "of" "cards" "from" "your" "graveyard"

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[TapSymbol, $receipt_exile_any_graveyard]}, limits:ActivationLimits{}, announcement:@announcement, body:@where(Program::Program{instructions:[Effect{result:@next, operation:$receipt_negative_pump}]}, Expr::CountObjects(CostObjects{payment:Activation, component:[1], view:Inputs, phase:Before}))} */
activated_exile_count_pump ::= "{" "T" "}" "," "↑" receipt_exile_any_graveyard ":" receipt_negative_pump "," "where" "X" "is" "the" "number" "of" "cards" "exiled" "this" "way" "."

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, $discard_one_receipt_cost]}, limits:ActivationLimits{}, announcement:@announcement, body:@where(Program::Program{instructions:[Effect{result:@next, operation:$receipt_positive_pump}]}, Expr::ObjectProperty{object:Query{objects:CostObjects{payment:Activation, component:[1], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown})} */
activated_discard_value_pump ::= cost_mana "," "↑" discard_one_receipt_cost ":" receipt_positive_pump "," "where" "X" "is" "the" "discarded" "card's" "mana" "value" "."

/* @sem CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:Exactly(Constant(1))} */
receipt_cast_sacrifice_creature ::= "sacrifice" "a" "creature"

/* @sem Ability::[Casting(AdditionalCost{cost:Cost{parts:[$receipt_cast_sacrifice_creature]}, optional:false, repetition:Once}), Spell{announcement:@announcement, body:@where(Program::Program{instructions:[Effect{result:@next, operation:$receipt_negative_pump}]}, Expr::ObjectProperty{object:Query{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Inputs, phase:Before}, index:0}, property:Power, information:CurrentOrLastKnown})}] */
line_cast_sacrifice_power_pump ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," receipt_cast_sacrifice_creature "." NEWLINE receipt_negative_pump "," "where" "X" "is" "the" "sacrificed" "creature's" "power" "."

/* This payment's bound refers to the enclosing life-gain event. */
/* @sem Cost::Cost{parts:[ManaXBounded{mana:[X], comparison:$life_bound_comparison, value:EventAmount}]} */
life_gained_bounded_x_cost ::= "pay" "{" "X" "}" "," "where" "X" "is" life_bound_comparison "the" "amount" "of" "life" "you" "gained"

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$life_gained_bounded_x_cost, optional:true}}, If{condition:PaymentChosen(@marked), then:$program, otherwise:Program{}}]} */
life_gained_bounded_x_payment ::= "you" "may" life_gained_bounded_x_cost "." "if" "you" "do" "," program "."

/* @prefer always */
/* @sem Comparison::LessOrEqual */
life_bound_at_most ::= "less" "than" "or" "equal" "to"

/* @sem Comparison::GreaterOrEqual */
life_bound_at_least ::= "greater" "than" "or" "equal" "to"

/* @sem Comparison::Greater */
life_bound_greater ::= "greater" "than"

life_bound_comparison ::= life_bound_at_most | life_bound_at_least | life_bound_greater

/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Query{objects:CostObjects{payment:Activation, component:[1], view:Performed, phase:After}, index:0}, exceptions:$graveyard_copy_traits}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:Move{objects:@exile_followup(InZone{objects:One(Query{objects:CostObjects{payment:Activation, component:[1], view:Performed, phase:After}, index:0}), zone:Exile}), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
/* @prefer always */
graveyard_exile_copy_original ::= "create" "a" "token" "that's" "a" "copy" "of" "it" "," "except" graveyard_copy_traits "." "shuffle" "the" "exiled" "card" "into" "its" "owner's" "library"

/* The token size measures the actual source card paid as component one. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[ObjectProperty{object:Query{objects:CostObjects{payment:Activation, component:[1], view:Inputs, phase:Before}, index:0}, property:$creature_stat, information:CurrentOrLastKnown}, ObjectProperty{object:Query{objects:CostObjects{payment:Activation, component:[1], view:Inputs, phase:Before}, index:0}, property:$creature_stat, information:CurrentOrLastKnown}]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
graveyard_exile_sized_token ::= "create" "an" "X" "/" "X" token_colors token_subtypes token_types "token" "," "where" "X" "is" "this" "card's" creature_stat

/* Keep the receipt address attached to the single-card discard producer. */
/* @sem CostPart::Discard{count:Expr::Constant(1), filter:AnyOf(@unordered([$card_filter, $card_filter_2]))} */
discard_one_either_filter ::= "discard" "a" card_filter "or" card_filter "card"

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, $discard_one_either_filter]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$discard_value_artifact_animation}]}} */
activated_discard_value_animation ::= cost_mana "," "↑" discard_one_either_filter ":" discard_value_artifact_animation "."

/* An X restriction qualifies the preceding casting mechanic independently of
   the mechanic's payment and retains that payment for inverse printing. */
/* @sem Operand::Term{family:CastModifier, form:XCantBeZero} */
cast_x_cant_be_zero ::= "x" "can't" "be" "0"

/* @sem Ability::Modified{ability:$keyword_kicker, modifier:$cast_x_cant_be_zero} */
kicker_with_cast_x_restriction ::= keyword_kicker "." cast_x_cant_be_zero "."

/* A trailing definition fixes X for the activation. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{modifiers:[ActivationRule(XIs(NumberTest::Compare{comparison:Equal, value:$value}))]}, announcement:@announcement, body:$program_sentence} */
activated_defined_x ::= cost ":" program_sentence "x" "is" value "."

/* Keep the casting sacrifice and its counted reference in the same production:
   the repeated filter proves which payment the consumer measures. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($filter_plural, $filter_phrase)}, choose:AnyNumber}]}, optional:true, repetition:Once}), Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:LoseLife{players:$players_singular, amount:Add([$value, Multiply([$value_2, CountObjects(CostObjects{payment:Casting{ability:0}, component:[0], view:Performed, phase:Before})])])}}, ...$instructions]}}] */
casting_sacrifice_scaled_life_followup ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "you" "may" "sacrifice" "any" "number" "of" filter_plural "." NEWLINE players_singular "loses" value "life" "plus" value "life" "for" "each" filter_phrase "sacrificed" "this" "way" "." instructions "."

/* The sole payment removes exactly the kind named by the pump's receipt. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($self_explicit_ref)), kind:PowerToughness([1, 1]), amount:All}]}]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$paid_pt_counter_removal_pump}]}} */
activated_all_pt_counter_pump ::= "remove" "all" "+" "1" "/" "+" "1" "counters" "from" self_explicit_ref ":" paid_pt_counter_removal_pump "."

/* Reassign a permanent of the named subtype from the controller to an opponent. */
/* @sem Cost::Cost{parts:[ObjectAction{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$subtype, AttachedToPlayer(AbilityController)])}, action:AttachToPlayer(OpponentsOf(AbilityController))}]} */
cost_reattach_player_subtype ::= "attach" "a" subtype "attached" "to" "you" "to" "one" "of" "your" "opponents"

/* The casting payment proves the singleton named by the shared receipt phrase. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost{parts:[$receipt_cast_sacrifice_creature]}, optional:false, repetition:Once}), Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$casting_sacrifice_draw}]}}] */
line_casting_sacrifice_draw ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," receipt_cast_sacrifice_creature "." NEWLINE casting_sacrifice_draw "."

/* @sem Operation::Draw{players:One(AbilityController), amount:$casting_sacrificed_creature_stat} */
casting_sacrifice_draw ::= "draw" "cards" "equal" "to" casting_sacrificed_creature_stat

/* A chosen permanent supplies the requested number of counters. */
/* @sem CostPart::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counter_payment_source}), amount:Count(Exactly($number)), selection:_{player:AbilityController, count:Exactly(Constant(1))}}]} */
cost_remove_selected_count ::= "remove" number "counters" "from" counter_payment_source

/* Two complete alternative mana payments. */
/* @sem Cost::Cost{parts:[Choice([_{parts:[Mana($mana_symbols)]}, _{parts:[Mana($mana_symbols_2)]}])]} */
alternative_mana_payment ::= mana_symbols "or" mana_symbols

/* A player may pay one mana cost or choose between two. */
unpaid_mana_payment ::= alternative_mana_payment | single_mana_payment

/* @sem Cost::Cost{parts:[Mana($mana_symbols)]} */
single_mana_payment ::= mana_symbols

/* The second activation component is a singleton discard, so the conditional
   clause can refer to that payment's input card in both directions. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, $discard_one_receipt_cost]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:$activation_discard_value_counter}} */
activated_discard_value_counter ::= cost_mana "," "↑" discard_one_receipt_cost ":" activation_discard_value_counter "."

/* @sem Instruction::[If{condition:ObjectMatches{object:$target_stack_spell, filter:Property{property:$stat_mana_value, test:NumberTest::Compare{comparison:Equal, value:ObjectProperty{object:Query{objects:CostObjects{payment:Activation, component:[1], view:Inputs, phase:Before}, index:0}, property:$stat_mana_value, information:CurrentOrLastKnown}}}}, then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One($target_stack_spell), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}] */
activation_discard_value_counter ::= "counter" target_stack_spell "if" "it" "has" "the" "same" stat_mana_value "as" "the" "discarded" "card"

/* This activation binds the third, singular exile-to-graveyard payment to the
   subsequent comparison. The payment's selected population remains an operand. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, $cost_tap, $cost_put_exiled_card_graveyard]}, limits:ActivationLimits{}, announcement:@announcement, body:$paid_card_name_counter} */
activated_paid_card_name_counter ::= cost_mana "," cost_tap "," "↑" cost_put_exiled_card_graveyard ":" paid_card_name_counter "."

/* @sem Program::Program{instructions:[If{condition:ObjectMatches{object:$target_stack_spell, filter:SharesNameWith(Query{objects:CostObjects{payment:Activation, component:[2], view:Performed, phase:After}, index:0})}, then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One($target_stack_spell), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}]} */
paid_card_name_counter ::= "counter" target_stack_spell "if" "it" "has" "the" "same" "name" "as" "that" "card"

/* A single sacrificed permanent establishes the antecedent for the choice. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$cost_sacrifice]}, optional:true}}, If{condition:PaymentChosen(@marked), then:$shared_sacrifice_declined_program, otherwise:Program{}}]} */
optional_sacrifice_shared_choice ::= "you" "may" cost_sacrifice "." "if" "you" "do" "," shared_sacrifice_declined_program "."

/* The removal is the third cost component, so the damage measures this payment. */
/* @sem Operation::DealDamage{source:$object_ref, recipients:Objects($affected), amount:PaidCountersRemoved{payment:Activation, component:[2]}, preventable:true} */
paid_third_counter_damage ::= object_ref "deals" "that" "much" "damage" "to" affected

/* Scope the payment receipt to the removal cost that produces it. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[Mana($mana_symbols), TapSymbol, $cost_remove_all_counters_from]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$paid_third_counter_damage}]}} */
activation_tap_remove_all_damage ::= mana_symbols "," "{" "T" "}" "," "↑" cost_remove_all_counters_from ":" paid_third_counter_damage "."

/* The third payment component is the removal that determines the damage. */
/* @sem CostPart::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($self_explicit_ref)), kind:$counter_kind, amount:Count(AnyNumber)}]} */
cost_remove_any_self_counters ::= "remove" "any" "number" "of" counter_kind "counters" "from" self_explicit_ref

/* The pronoun repeats the object from which the counters were removed. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, $cost_tap, $cost_remove_any_self_counters]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:@self, recipients:$recipients, amount:PaidCountersRemoved{payment:Activation, component:[2]}, preventable:true}}]}} */
activation_remove_self_counters_damage ::= cost_mana "," cost_tap "," "↑" cost_remove_any_self_counters ":" "it" "deals" "that" "much" "damage" "to" recipients "."

/* A single permanent moved to exile as the activation payment supplies the
   card referred to by the permission, including when printed from edited IR. */
/* @sem CostPart::Move{selections:[$cost_one_permanent_selection], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
face_up_single_permanent_payment ::= "exile" cost_one_permanent_selection "face" "up"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Query{objects:CostObjects{payment:Activation, component:[0], view:Performed, phase:After}, index:0}), from:Exile, action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects} */
play_activation_exiled_card ::= "you" "may" "play" "that" "card" this_duration

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$face_up_single_permanent_payment]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$play_activation_exiled_card}]}} */
activated_face_up_payment_play ::= face_up_single_permanent_payment ":" play_activation_exiled_card "."

/* The source's controller makes the payment and receives the conditional draw. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:ControllerOf(EventSubject), cost:Cost{parts:[$cost_life]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:Draw{players:One(ControllerOf(EventSubject)), amount:$card_count}}]}, otherwise:Program{}}]} */
program_event_controller_payment_draw ::= "its" "controller" "may" cost_life "." "if" "they" "do" "," "they" "draw" card_count "."

/* A player may pay a defined X to prevent the ensuing program. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:$player_ref, cost:$ward_defined_x_cost, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:$program, otherwise:Program{}}]} */
program_unless_player_pays_defined_x ::= program "unless" player_ref "pays" ward_defined_x_cost

/* @sem CostPart::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($self_explicit_ref)), kind:Named(EyeballCounter), amount:All}]} */
cost_all_eyeball_counters ::= "remove" "all" "eyeball" "counters" "from" self_explicit_ref

/* The singular creature cost supplies component 1 of this activation.  Both
   replacement branches and the tested property remain independently editable. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_tap, $cost_single_creature_sacrifice]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:$activation_sacrifice_stat_replacement}} */
activated_sacrifice_stat_replacement ::= cost_tap "," "↑" cost_single_creature_sacrifice ":" activation_sacrifice_stat_replacement "."

/* @sem Instruction::[If{condition:ObjectMatches{object:Query{objects:CostObjects{payment:Activation, component:[1], view:Inputs, phase:Before}, index:0}, filter:Property{property:$stat, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}}, then:Program{instructions:$instead_action_2}, otherwise:Program{instructions:$instead_action}}] */
activation_sacrifice_stat_replacement ::= instead_action "." NEWLINE? "if" "the" "sacrificed" "creature's" stat "was" value "or" "greater" "," instead_action "instead"

/* The inspected object is the single permanent paid in the second component;
   both printed descriptions constrain that same payment. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), ObjectFilter::@agree($filter_phrase, $filter_phrase_2))}, choose:Exactly(Constant(1))}]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[If{condition:ObjectMatches{object:Query{objects:CostObjects{payment:Activation, component:[1], view:Inputs, phase:Before}, index:0}, filter:$paid_sacrifice_state}, then:Program{instructions:$instead_draw_action_2}, otherwise:Program{instructions:$instead_draw_action}}]}} */
activated_sacrifice_state_draw_instead ::= cost_mana "," "↑" "sacrifice" "another" filter_phrase ":" instead_draw_action "." "if" "the" "sacrificed" filter_phrase "was" paid_sacrifice_state "," instead_draw_action "instead" "."

/* @sem ObjectFilter::State(Suspected) */
paid_sacrifice_suspected ::= "suspected"

paid_sacrifice_state ::= paid_sacrifice_suspected

/* @sem Cost::Cost{parts:[Mana($mana_symbols)]} */
holder_mana_symbols ::= mana_symbols

/* A single sacrifice component fixes the activation receipt used by the
   conditional phrase; no other payment can supply that receipt. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[$cost_mana, $cost_sacrifice_another]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[$activation_receipt_pump, If{condition:$activation_sacrifice_receipt_condition, then:$then_condition_program, otherwise:Program{}}]}} */
activated_mana_sacrifice_receipt ::= cost_mana "," "↑" cost_sacrifice_another ":" activation_receipt_pump "." "if" activation_sacrifice_receipt_condition "," then_condition_program "."

/* @sem Condition::Compare{left:CountObjects(Matching{objects:CostObjects{payment:Activation, component:[1], view:Performed, phase:Before}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
activation_sacrifice_receipt_condition ::= "a" filter_phrase "was" "sacrificed" "this" "way"

/* A pump cannot introduce another sacrifice receipt between payment and test. */
/* @sem Instruction::Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($self_explicit_ref)), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot}} */
activation_receipt_pump ::= self_explicit_ref "gets" signed "/" signed duration

/* The second component is exactly one discarded card; the receipt test is
   scoped to this activation and retains its pre-discard characteristics. */
discard_receipt_first_cost ::= cost_tap | cost_mana

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$discard_receipt_first_cost, $discard_one_receipt_cost]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[...$instructions, If{condition:$discard_payment_card_was, then:$program, otherwise:Program{}}]}} */
activated_discard_payment_test ::= discard_receipt_first_cost "," "↑" discard_one_receipt_cost ":" instructions "." "if" discard_payment_card_was "," program "."
