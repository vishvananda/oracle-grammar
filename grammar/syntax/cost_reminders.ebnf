/* Payment spelling and reminder text do not add game actions or targets. */
keyword_cost_parts ::= keyword_mana_parts | keyword_word_parts | keyword_choice_parts | keyword_reduced_mana_parts | keyword_choice_mana_energy
/* @sem CostPart::[Mana($mana_symbols)] */
keyword_mana_parts ::= mana_symbols
/* @sem $keyword_word_cost_parts */
keyword_word_parts ::= ("―" | "—") keyword_word_cost_parts "."
keyword_word_cost_parts ::= keyword_word_cost_one | keyword_word_cost_more | keyword_mixed_cost | keyword_mana_life_parts
/* @sem CostPart::[$keyword_word_cost] */
keyword_word_cost_one ::= keyword_word_cost
/* @sem CostPart::[$keyword_word_cost, ...$cost_parts_later] */
keyword_word_cost_more ::= keyword_word_cost "," cost_parts_later

/* @sem Cost::Cost{parts:$keyword_cost_parts} */
keyword_payment ::= keyword_cost_parts

/* Cycling's printed payment excludes its one implicit discard of the source. */
/* @sem Cost::Cost{parts:[...$keyword_cost_parts, Discard{count:Constant(1), filter:SameObject(Source)}]} */
cycling_cost ::= keyword_cost_parts
/* @sem Cost::Cost{parts:[...$cost_parts, Discard{count:Constant(1), filter:SameObject(Source)}]} */
cycling_reminder_cost ::= cost_parts "," "↑" "discard" "this" "card"

/* The target phrase supplies the complete controlled-creature restriction. */
equip_target_phrase ::= equip_target_creature | equip_target_commander
/* @prefer always */
/* @sem ObjectFilter::AllOf([CardType(Creature), ControlledBy(One(AbilityController))]) */
equip_target_creature ::= "equip"
/* @sem ObjectFilter::AllOf([CardType(Creature), State(Commander), ControlledBy(One(AbilityController))]) */
equip_target_commander ::= "equip" "commander"

/* @sem Ability::Activated{origin:Equip, cost:$keyword_payment, limits:_{sorcery:true}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Attach{attachments:One(Source), host:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$equip_target_phrase}), index:0}}}]}} */
keyword_equip ::= equip_target_phrase keyword_payment

/* An equip line with its own once-each-turn limit is a whole ability line. */
/* @sem Ability::Activated{origin:Equip, cost:Cost{parts:$keyword_mana_parts}, limits:_{once_each_turn:true, sorcery:true}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Attach{attachments:One(Source), host:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), index:0}}}]}} */
keyword_equip_once ::= "equip" keyword_mana_parts "." "activate" "only" "once" "each" "turn" "."
/* A word payment ends with its own period. */
/* @sem Ability::Activated{origin:Equip, cost:Cost{parts:$keyword_word_parts}, limits:_{once_each_turn:true, sorcery:true}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Attach{attachments:One(Source), host:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), index:0}}}]}} */
keyword_equip_once_word ::= "equip" keyword_word_parts "activate" "only" "once" "each" "turn" "."

/* The equip target remains a creature; its printed quality further restricts
   that creature instead of being ignored by the old whole-keyword seed. */
/* @sem Ability::Activated{origin:Equip, cost:$keyword_payment, limits:_{sorcery:true}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Attach{attachments:One(Source), host:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::CardType(Creature), ObjectFilter::Supertype(Legendary), $filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))}), index:0}}}]}} */
keyword_equip_legendary ::= "equip" "legendary" filter_phrase keyword_payment

/* A printed qualified equip remains the native filtered mechanic descriptor. */
/* @sem Ability::Mechanic{mechanic:Equip, cost:$keyword_payment, filter:CardType(Planeswalker)} */
keyword_equip_planeswalker ::= "equip" "planeswalker" keyword_payment

/* @sem Ability::WithPresentation{reminder:true, ability:Ability::Activated{origin:Equip, cost:@agree($keyword_payment, $cost), limits:_{sorcery:true}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Attach{attachments:One(Source), host:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), index:0}}}]}}} */
reminded_equip ::= "equip" keyword_payment "(" cost ":" "attach" "to" "target" "creature" "you" "control" "." "equip" "only" "as" "a" "sorcery" "." ")"

/* @sem Ability::WithPresentation{label:$ability_label, reminder:true, ability:Ability::Activated{origin:Equip, cost:@agree($keyword_payment, $cost), limits:_{sorcery:true}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Attach{attachments:One(Source), host:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), index:0}}}]}}} */
labelled_equip_reminder ::= ability_label "—" "equip" keyword_payment "(" cost ":" "attach" "to" "target" "creature" "you" "control" "." "equip" "only" "as" "a" "sorcery" "." ")"

/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Cycling{}, cost:$cycling_cost, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Constant(1)}}]}})} */
keyword_cycling ::= "cycling" cycling_cost

/* @sem Ability::WithPresentation{reminder:true, ability:Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Cycling{}, cost:@agree($cycling_cost, $cycling_reminder_cost), limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Constant(1)}}]}})}} */
reminded_cycling ::= "cycling" cycling_cost "(" cycling_reminder_cost ":" "draw" "a" "card" "." ")"

/* @sem Ability::WithPresentation{label:$ability_label, reminder:true, ability:Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Cycling{}, cost:@agree($cycling_cost, $cycling_reminder_cost), limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Constant(1)}}]}})}} */
labelled_cycling_reminder ::= ability_label "—" "cycling" cycling_cost "(" cycling_reminder_cost ":" "draw" "a" "card" "." ")"

/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Cycling{search:@and(ObjectFilter::Supertype(Basic), ObjectFilter::CardType(Land))}, cost:$cycling_cost, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:@and(ObjectFilter::Supertype(Basic), ObjectFilter::CardType(Land)), count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}})} */
keyword_basic_landcycling ::= "basic" "landcycling" cycling_cost

/* @sem Ability::WithPresentation{reminder:true, ability:Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Cycling{search:@and(ObjectFilter::Supertype(Basic), ObjectFilter::CardType(Land))}, cost:@agree($cycling_cost, $cycling_reminder_cost), limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:@and(ObjectFilter::Supertype(Basic), ObjectFilter::CardType(Land)), count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}})}} */
reminded_basic_landcycling ::= "basic" "landcycling" cycling_cost "(" cycling_reminder_cost ":" "search" "your" "library" "for" "a" "basic" "land" "card" "," "reveal" "it" "," "put" "it" "into" "your" "hand" "," "then" "shuffle" "." ")"

/* @sem Ability::WithPresentation{label:$ability_label, reminder:true, ability:Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Cycling{search:@and(ObjectFilter::Supertype(Basic), ObjectFilter::CardType(Land))}, cost:@agree($cycling_cost, $cycling_reminder_cost), limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:@and(ObjectFilter::Supertype(Basic), ObjectFilter::CardType(Land)), count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}})}} */
labelled_basic_landcycling_reminder ::= ability_label "—" "basic" "landcycling" cycling_cost "(" cycling_reminder_cost ":" "search" "your" "library" "for" "a" "basic" "land" "card" "," "reveal" "it" "," "put" "it" "into" "your" "hand" "," "then" "shuffle" "." ")"

/* A nonmana payment can include mana before its worded components. */
/* @sem CostPart::[$cost_mana, ...$keyword_after_mana] */
keyword_mixed_cost ::= cost_mana "," keyword_after_mana
keyword_after_mana ::= keyword_after_mana_one | keyword_after_mana_more
/* @sem CostPart::[$keyword_word_cost] */
keyword_after_mana_one ::= "↑" keyword_word_cost
/* @sem CostPart::[$keyword_word_cost, ...$cost_parts_later] */
keyword_after_mana_more ::= "↑" keyword_word_cost "," cost_parts_later

/* Worded keyword costs exclude bare mana shorthand; leaves own their meanings. */
keyword_word_cost ::= keyword_cost_forage | cost_words_owned | keyword_word_cost_capital | keyword_nonmana_mined_cost | keyword_draw_cost

/* Capital spelling changes the price token, never its payer or meaning. */
/* @sem $cost_words_owned */
keyword_word_cost_capital ::= "↑" cost_words_owned
keyword_nonmana_mined_cost ::= m_sacrifice_value_affected | m_exile_counter_amount_instant_or_sorcery_spell_you | m_sacrifice_counter_amount_suspected_filter_phrase | m_exile_counter_amount_spell_you_control | m_remove_a_counter_kind_counter_from_a_filter_phrase | m_shuffle_a_card_from_your_hand_into | tail_costpart

/* A three-way subtype restriction is a creature filter shared by equip costs. */
/* @sem ObjectFilter::AllOf([CardType(Creature), AnyOf([$subtype, $subtype_2, $subtype_3])]) */
equip_three_types ::= subtype "," subtype "," "or" subtype

/* @sem Ability::Activated{origin:Equip, cost:$keyword_payment, limits:_{sorcery:true}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Attach{attachments:One(Source), host:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$equip_three_types, ControlledBy(One(AbilityController))])}), index:0}}}]}} */
keyword_equip_three_types ::= "equip" equip_three_types keyword_payment

/* The reduction names the equip target's property, keeping the target itself
   in the activation announcement. The one-mana color rate is fixed. */
/* @sem Ability::Activated{origin:Equip, cost:$keyword_payment, limits:_{sorcery:true, modifiers:[ActivationRule(Cost{modifier:Reduce{reductions:[_{amount:$equip_target_reduction}], spill_into_generic:true}})]}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Attach{attachments:One(Source), host:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), index:0}}}]}} */
keyword_equip_target_reduction ::= "equip" keyword_payment "." equip_target_reduction
 equip_target_reduction ::= equip_target_stat_reduction | equip_target_color_reduction

/* @sem Expr::ObjectProperty{object:Target{slot:0, index:0}, property:$stat, information:CurrentOrLastKnown} */
equip_target_stat_reduction ::= "this" "ability" "costs" "{" "X" "}" "less" "to" "activate" "," "where" "X" "is" "the" stat "of" "the" "creature" "it" "targets" "."

/* @sem Expr::ObjectProperty{object:Target{slot:0, index:0}, property:ColorCount, information:CurrentOrLastKnown} */
equip_target_color_reduction ::= "this" "ability" "costs" "{" "1" "}" "less" "to" "activate" "for" "each" "color" "of" "the" "creature" "it" "targets" "."

/* A choice retains each complete payment as its own cost. */
/* @sem CostPart::[Choice([$cost, $cost_2])] */
keyword_choice_parts ::= cost "or" cost

/* These parts are shared by mechanics with worded payments. */
/* @sem CostPart::Draw{count:$card_count} */
keyword_draw_cost ::= "draw" card_count

/* @sem CostPart::[Mana($mana_symbols), Life($value)] */
keyword_mana_life_parts ::= "pay" mana_symbols "and" value "life"

/* @sem CostPart::[ManaReducedForEach{mana:$mana_symbols, reduction:$generic_reduction_symbols, per:$count_each}] */
keyword_reduced_mana_parts ::= mana_symbols "." "this" "cost" "is" "reduced" "by" generic_reduction_symbols "for" "each" count_each "."

/* Either payment retains its own current operands. */
/* @sem CostPart::[Choice([$cost, Cost::Cost{parts:[Energy($energy_amount)]}])] */
keyword_choice_mana_energy ::= "―" "pay" cost "or" energy_amount "."

/* An equip ability retains its target and attaches the source; its conditional cost modifier is shared with other activated abilities. */
/* @sem Ability::Activated{origin:Equip, cost:$keyword_payment, limits:_{sorcery:true, modifiers:$conditional_activation_reduction}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Attach{attachments:One(Source), host:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), index:0}}}]}} */
equip_conditional_activation_reduction ::= "equip" keyword_payment "." conditional_activation_reduction "."

/* A subtype qualification restricts the equipped creature, independently of payment. */
/* @sem ObjectFilter::AllOf([CardType(Creature), $subtype]) */
equip_creature_subtype ::= subtype

/* @sem Ability::Activated{origin:Equip, cost:$keyword_payment, limits:_{sorcery:true}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Attach{attachments:One(Source), host:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$equip_creature_subtype, ControlledBy(One(AbilityController))])}), index:0}}}]}} */
keyword_equip_subtype ::= "equip" equip_creature_subtype keyword_payment

/* Compose the equip action with a live population-based activation reduction. */
/* @sem Ability::Activated{origin:Equip, cost:$keyword_payment, limits:_{sorcery:true, modifiers:$activation_live_reduction}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Attach{attachments:One(Source), host:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), index:0}}}]}} */
equip_live_reduction ::= "equip" keyword_payment "." activation_live_reduction "."

/* @sem CostPart::Keyword{action:Forage} */
keyword_cost_forage ::= "forage"
