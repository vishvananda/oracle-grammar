/* Payment spelling and reminder text do not add game actions or targets. */
keyword_cost_parts ::= keyword_mana_parts | keyword_word_parts
/* @sem CostPart::[Mana($mana_symbols)] */
keyword_mana_parts ::= mana_symbols
/* @sem $keyword_word_cost_parts */
keyword_word_parts ::= ("―" | "—") keyword_word_cost_parts "."
keyword_word_cost_parts ::= keyword_word_cost_one | keyword_word_cost_more | keyword_mixed_cost
/* @sem CostPart::[$keyword_word_cost] */
keyword_word_cost_one ::= keyword_word_cost
/* @sem CostPart::[$keyword_word_cost, ...$cost_parts_later] */
keyword_word_cost_more ::= keyword_word_cost "," cost_parts_later

/* @sem Cost::Cost{parts:$keyword_cost_parts} */
keyword_payment ::= keyword_cost_parts

/* Cycling's printed payment excludes its one implicit discard of the source. */
/* @sem Cost::Cost{parts:[...$keyword_cost_parts, Discard{count:Constant(1), filter:SameObject(Source)}]} */
cycling_cost ::= keyword_cost_parts
/* @sem Cost::Cost{parts:[...$cost_parts, Discard{count:Constant(1), filter:SameObject(Source)}]} */
cycling_reminder_cost ::= cost_parts "," "↑" "discard" "this" "card"

/* @sem Ability::Activated{origin:Equip, cost:$keyword_payment, limits:_{sorcery:true}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Attach{attachments:One(Source), host:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), index:0}}}]}} */
keyword_equip ::= "equip" keyword_payment

/* A printed qualified equip remains the native filtered mechanic descriptor. */
/* @sem Ability::Mechanic{mechanic:Equip, cost:$keyword_payment, filter:CardType(Planeswalker)} */
keyword_equip_planeswalker ::= "equip" "planeswalker" keyword_payment

/* @sem Ability::WithPresentation{reminder:true, ability:Ability::Activated{origin:Equip, cost:@agree($keyword_payment, $cost), limits:_{sorcery:true}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Attach{attachments:One(Source), host:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), index:0}}}]}}} */
reminded_equip ::= "equip" keyword_payment "(" cost ":" "attach" "to" "target" "creature" "you" "control" "." "equip" "only" "as" "a" "sorcery" "." ")"

/* @sem Ability::WithPresentation{label:$ability_label, reminder:true, ability:Ability::Activated{origin:Equip, cost:@agree($keyword_payment, $cost), limits:_{sorcery:true}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Attach{attachments:One(Source), host:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), index:0}}}]}}} */
labelled_equip_reminder ::= ability_label "—" "equip" keyword_payment "(" cost ":" "attach" "to" "target" "creature" "you" "control" "." "equip" "only" "as" "a" "sorcery" "." ")"

/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Cycling{}, cost:$cycling_cost, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Constant(1)}}]}})} */
keyword_cycling ::= "cycling" cycling_cost

/* @sem Ability::WithPresentation{reminder:true, ability:Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Cycling{}, cost:@agree($cycling_cost, $cycling_reminder_cost), limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Constant(1)}}]}})}} */
reminded_cycling ::= "cycling" cycling_cost "(" cycling_reminder_cost ":" "draw" "a" "card" "." ")"

/* @sem Ability::WithPresentation{label:$ability_label, reminder:true, ability:Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Cycling{}, cost:@agree($cycling_cost, $cycling_reminder_cost), limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Constant(1)}}]}})}} */
labelled_cycling_reminder ::= ability_label "—" "cycling" cycling_cost "(" cycling_reminder_cost ":" "draw" "a" "card" "." ")"

/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Cycling{search:@and(ObjectFilter::Supertype(Basic), ObjectFilter::CardType(Land))}, cost:$cycling_cost, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:@and(ObjectFilter::Supertype(Basic), ObjectFilter::CardType(Land)), count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}})} */
keyword_basic_landcycling ::= "basic" "landcycling" cycling_cost

/* @sem Ability::WithPresentation{reminder:true, ability:Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Cycling{search:@and(ObjectFilter::Supertype(Basic), ObjectFilter::CardType(Land))}, cost:@agree($cycling_cost, $cycling_reminder_cost), limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:@and(ObjectFilter::Supertype(Basic), ObjectFilter::CardType(Land)), count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}})}} */
reminded_basic_landcycling ::= "basic" "landcycling" cycling_cost "(" cycling_reminder_cost ":" "search" "your" "library" "for" "a" "basic" "land" "card" "," "reveal" "it" "," "put" "it" "into" "your" "hand" "," "then" "shuffle" "." ")"

/* @sem Ability::WithPresentation{label:$ability_label, reminder:true, ability:Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Cycling{search:@and(ObjectFilter::Supertype(Basic), ObjectFilter::CardType(Land))}, cost:@agree($cycling_cost, $cycling_reminder_cost), limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:@and(ObjectFilter::Supertype(Basic), ObjectFilter::CardType(Land)), count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}})}} */
labelled_basic_landcycling_reminder ::= ability_label "—" "basic" "landcycling" cycling_cost "(" cycling_reminder_cost ":" "search" "your" "library" "for" "a" "basic" "land" "card" "," "reveal" "it" "," "put" "it" "into" "your" "hand" "," "then" "shuffle" "." ")"

/* A nonmana payment can include mana before its worded components. */
/* @sem CostPart::[$cost_mana, ...$keyword_after_mana] */
keyword_mixed_cost ::= cost_mana "," keyword_after_mana
keyword_after_mana ::= keyword_after_mana_one | keyword_after_mana_more
/* @sem CostPart::[$keyword_word_cost] */
keyword_after_mana_one ::= "↑" keyword_word_cost
/* @sem CostPart::[$keyword_word_cost, ...$cost_parts_later] */
keyword_after_mana_more ::= "↑" keyword_word_cost "," cost_parts_later

/* Worded keyword costs exclude bare mana shorthand; leaves own their meanings. */
keyword_word_cost ::= cost_words_owned | keyword_scalar_cost_capital | keyword_nonmana_mined_cost

/* Capital spelling changes the price token, never its payer or meaning. */
/* @sem $keyword_scalar_cost */
keyword_scalar_cost_capital ::= "↑" keyword_scalar_cost
keyword_scalar_cost ::= cost_life | cost_blight | cost_pay_repeated_mana
keyword_nonmana_mined_cost ::= m_remove_any_number_of_counter_kind_counters_from | m_sacrifice_affected
    | m_sacrifice_value_affected | m_waterbend
    | m_exile_counter_amount_filter_phrase | m_remove_counter_amount_counter_from_counter_amount_filter_phrase | m_put_card_count_from_your_hand_on_top | m_waterbend_2
    | m_untap_counter_amount_filter_phrase | m_exile_card_count_from_your_hand | m_untap_value_affected | m_sacrifice_counter_amount_filter_phrase_of_the_chosen_type
    | m_remove_counter_amount_counter_kind_counter_from_counter_amount_filter_phrase | m_waterbend_3 | m_discard_card_count_with_mana_value_number | m_tap_value_affected | m_remove_value_counters_from_affected
    | m_remove_value_or_more_counter_kind_counters_from_2
    | m_reveal_the_creature_type_you_chose
    | m_waterbend_p2 | m_exile_cards_from_your_graveyard_equal_to | m_sacrifice_up_to_value_affected
    | m_exile_value_or_more_filter_phrase_cards_from | m_remove_fifty_counter_kind_counters_from_affected | m_remove_counter_amount_counter_from_another_filter_phrase_you | m_reveal_card_count_from_your_hand_that_share
    | m_remove_counter_amount_counter_kind_counter_or_counter_amount_counter_kind | m_discard_the_last_card_you_drew_this | m_sacrifice_counter_amount_filter_phrase_named_wood | m_waterbend_2_p2 | m_sacrifice_king_darien
    | m_sacrifice_counter_amount_filter_phrase_or_another_filter_phrase | m_reveal_x_red_cards_from_your_hand | m_exile_affected_and_value_other_filter_plural_and | m_tap_any_number_of_untapped_filter_plural_you
    | m_tap_value_filter_phrase | m_exile_value_filter_phrase_cards_from_a_single | m_exile_counter_amount_instant_or_sorcery_spell_you | m_discard_card_count_with_different_names | m_exile_any_number_of_cards_from_your
    | m_sacrifice_value_or_more_affected | m_remove_counter_amount_counter_kind_counter_from_rasputin | m_remove_number_counter_kind_counters_from_among_affected | m_sacrifice_counter_amount_suspected_filter_phrase | m_reveal_your_hand
    | m_put_a_filter_phrase_card_exiled_with_object_ref | m_sacrifice_counter_amount_black_or_filter_phrase_filter_phrase | m_discard_value_nonland_cards_with_the_same
    | m_exile_counter_amount_spell_you_control | m_remove_value_counters_from_among_affected | m_exile_affected_and_filter_plural_you_control_named | m_exile_counter_amount_filter_phrase_card_from_a_graveyard
    | m_pay_life_equal_to_the_number_of | m_tap_value_affected_that_share_a_creature | m_exile_number_filter_phrase_cards_from_your_graveyard
    | m_return_a_filter_phrase_to_its_owner_s
    | m_remove_a_counter_from_object_ref | m_remove_all_counter_kind_counters_from_object_ref | m_put_a_counter_kind_counter_on_a_filter_phrase | m_waterbend_4 | m_pay_for_each_count_each | m_an_opponent_gains_value_life
    | m_exile_value_green_cards_from_your_hand | m_pay_or_discard_card_count | m_add_r | m_behold_a_kithkin_and_exile_it | m_behold_an_elemental_and_exile_it
    | m_behold_an_elf_and_exile_it | m_behold_a_merfolk_and_exile_it | m_sacrifice_an_filter_phrase_or_discard_card_count | m_pay_an_amount_of_e_equal_to | m_reveal_a_blue_card_in_your_hand | m_reveal_a_filter_phrase_card_from_your_hand
    | m_exile_value_or_more_filter_plural_with_total | m_discard_card_count_or_pay_value_life | m_exile_number_blue_cards_from_your_graveyard
    | m_exile_a_filter_phrase_and_an_filter_phrase | m_pay_or_remove_a_counter_from_object_ref | m_pay_life_for_each_count_each | m_gain_control_of_a_filter_phrase | m_discard_card_count_or_sacrifice_a_filter_phrase
    | m_put_card_count_from_a_single_graveyard_on | m_behold_value_elementals | m_behold_a_kithkin | m_choose_a_number_between_and
    | m_behold_an_elf | m_return_an_filter_phrase_to_its_owner_s | m_behold_a_goblin | m_sacrifice_any_number_of_filter_plural_with_total | m_pay_life_equal_to_this_creature_s
    | m_remove_a_counter_kind_counter_from_a_filter_phrase | m_behold_a_merfolk | m_behold_an_elemental | m_exile_the_top_value_black_cards_of | m_discard_an_filter_phrase_card_or_a_filter_phrase
    | m_pay_half_their_life_rounded_up | m_waterbend_5 | m_put_object_ref_on_the_bottom_of_its | m_pay_value_life_for_each_counter_kind_counter
    | m_sacrifice_value_filter_plural_with_different_names | m_pay_life_equal_to_s_power
    | m_exile_another_filter_phrase_card_from_your_graveyard | m_cast_the_exiled_card_without_paying_its
    | m_put_a_card_exiled_with_object_ref_into_2 | m_mill_card_count_2 | m_put_a_counter_kind_counter_on_object_ref
    | m_unattach_3 | m_exile_value_other_cards_from_your_graveyard | m_behold_a_dragon_or_pay_value | m_suspect_one_of_the_other_creatures | m_shuffle_a_card_from_your_hand_into | m_put_card_count_an_opponent_owns_from_exile
    | m_cast_a_spell_with_mana_value_equal | m_have_an_opponent_gain_control_of_object_ref | tail_costpart
