/* Specialized clauses backed by explicit Unique rule contracts.
   Each comment names the observed card face in the allowed audit population. */

/* Observed card: Angel of Eternal Dawn. */
/* @sem Ability::Unique(NeverNight) */
unique_never_night ::= "it" "can't" "become" "night" "."

/* Observed card: Backup Plan. */
/* @sem Ability::Unique(AdditionalOpeningHand) */
unique_additional_opening_hand ::= "draw" "an" "additional" "hand" "of" "seven" "cards" "as" "the" "game" "begins" "." "before" "taking" "mulligans" "," "shuffle" "all" "but" "one" "of" "your" "hands" "into" "your" "library" "."

/* Observed card: Bell Borca, Spectral Sergeant. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(Unique(NoteExiledManaValue))]}) */
unique_note_exiled_mana_value ::= "note" "the" "mana" "value" "of" "each" "card" "as" "it's" "put" "into" "exile" "."

/* Observed card: Dakkon Blackblade Avatar. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(Unique(ColoredCardsAsRandomBasicLands))]}) */
unique_colored_cards_as_random_basic_lands ::= "you" "may" "play" "any" "colored" "card" "from" "your" "hand" "as" "a" "copy" "of" "a" "basic" "land" "card" "chosen" "at" "random" "that" "can" "produce" "mana" "of" "one" "of" "the" "card's" "colors" "."

/* Observed card: Edgar, King of Figaro. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(Unique(FirstTwoCoinFlipsWin))]}) */
unique_first_two_coin_flips_win ::= "the" "first" "time" "you" "flip" "one" "or" "more" "coins" "each" "turn" "," "those" "coins" "come" "up" "heads" "and" "you" "win" "those" "flips" "."

/* Observed card: Everlasting Torment. */
/* @sem Ability::Unique(AllDamageWithers) */
unique_all_damage_withers ::= "all" "damage" "is" "dealt" "as" "though" "its" "source" "had" "wither" "."

/* Observed card: Power Play. */
/* @sem Ability::Unique(StartingPlayer) */
unique_starting_player ::= "you" "are" "the" "starting" "player" "." "if" "multiple" "players" "would" "be" "the" "starting" "player" "," "one" "of" "those" "players" "is" "chosen" "at" "random" "."
