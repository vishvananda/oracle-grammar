/* @sem Change::[Rule(BlockCapacity(Additional($counter_a)))] */
rule_block_extra_one ::= "can" "block" counter_a "additional" "creature"

/* @sem Change::[Rule(BlockCapacity(Additional($counter_amount)))] */
rule_block_extra_many ::= "can" "block" counter_amount "additional" "creatures"

/* @sem Change::[Rule(Prohibit(BeBlocked(AllOf([$filter_plural, Chosen(Color)]))))] */
rule_blocked_chosen_color ::= "can't" "be" "blocked" "by" filter_plural "of" "that" "color"

/* @sem Change::[Rule(Prohibit(Attack(PlayersAndPlaneswalkers(Matching{binding:0, condition:PlayerIn{player:Bound(0), players:Scoped}}))))] */
rule_attack_scoped_players ::= "can't" "attack" "those" "players" "or" "planeswalkers" "they" "control"

/* @sem Change::[Rule(AttackException{ignore:Defender, defenders:Any})] */
rule_ignore_defender_plural ::= "as" "though" "they" "didn't" "have" "defender"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$rule_ignore_defender_plural, duration:$this_duration, evaluation:LiveObjects} */
continuous_attack_defender_plural ::= affected "can" "attack" this_duration rule_ignore_defender_plural

/* A leading duration applies to the same acquired control as the ordinary
   imperative; the affected query remains independent of the controller. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$acquire_control_change, duration:$duration, evaluation:Snapshot} */
leading_control_effect ::= duration "," acquire_control_change affected

/* @sem Change::[SetController(AbilityController)] */
acquire_control_change ::= "gain" "control" "of"

/* A player rule remains live and applies to the ability's controller. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:$leading_player_rule, duration:$duration, evaluation:LiveObjects} */
leading_player_rule_effect ::= duration "," leading_player_rule

leading_player_rule ::= player_life_lock_and_keyword | player_visibility_rule | player_spending_rule | player_life_floor_rule | player_flash_timing_rule

/* @sem Change::[PlayerRule(Visibility{objects:$affected, audience:AffectedPlayer})] */
player_visibility_rule ::= "you" "may" "look" "at" affected "any" "time"

/* @sem Change::[PlayerRule(SpendColorAs{color:$mana_color_word, on:Anything})] */
player_spending_rule ::= "you" "may" "spend" mana_color_word "mana" "as" "though" "it" "were" "mana" "of" "any" "color"

/* The threshold and final life total are both one; neither is an arbitrary
   independent operand of this wording. */
/* @sem Change::[PlayerRule(DamageLifeFloor(Constant(1)))] */
player_life_floor_rule ::= "damage" "that" "would" "reduce" "your" "life" "total" "to" "less" "than" "1" "reduces" "it" "to" "1" "instead"

/* The possessive supplies the affected object, and the stat change supplies
   the current expression rather than retaining the original card text. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_possessive)), changes:$leading_power_change, duration:$duration, evaluation:Snapshot} */
leading_self_stat_effect ::= duration "," self_possessive leading_power_change

/* @sem Change::[SetPower($value)] */
leading_power_change ::= "base" "power" "becomes" "equal" "to" value

/* The two counted populations retain their independent controllers. */
/* @sem Change::[Rule(BlocksOnlyIf($controller_count_comparison))] */
block_controller_count_rule ::= "can't" "block" "unless" controller_count_comparison

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy($players_singular)])})}} */
controller_count_comparison ::= "you" "control" "more" filter_plural "than" players_singular

/* A defending player's qualifying group is measured by its shared creature types. */
/* @sem Change::[Rule(BlockedByDefender{players:Matching{binding:0, condition:$defender_shared_type_condition}, unless:true})] */
blocked_shared_type_rule ::= "can't" "be" "blocked" "unless" "defending" "player" defender_shared_type_condition

/* @sem Condition::Compare{left:LargestSharedGroup{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(Bound(0)))])}, property:CreatureTypes}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
defender_shared_type_condition ::= "controls" value "or" "more" "creatures" "that" "share" "a" "creature" "type"

/* One payment is imposed independently for each combat action. */
/* @sem Change::[Rule(CombatCost{action:Attack(Any), payer:DeclaringPlayer, cost:$combat_tap_payment}), Rule(CombatCost{action:Block(Any), payer:DeclaringPlayer, cost:$combat_tap_payment})] */
combat_tap_payment_rule ::= "can't" "attack" "or" "block" "unless" "you" combat_tap_payment

/* Both written creature references denote the same selected permanent. */
/* @sem Cost::Cost{parts:[ChangeTapState{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController)), Not(Attacking), Not(Blocking), Not(Tapped)])}, choose:Exactly(Constant(1))}], tapped:true}]} */
combat_tap_payment ::= "tap" "an" "untapped" "creature" "you" "control" "not" "declared" "as" "an" "attacking" "or" "blocking" "creature" "this" "combat"

/* A temporary snapshot of a population with retained creature types. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$retained_plural_animation, duration:$duration, evaluation:Snapshot} */
retained_population_snapshot ::= affected retained_plural_animation duration

/* Combat requirements share their subject and duration. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$temporary_combat_requirement, duration:$this_duration, evaluation:LiveObjects} */
temporary_combat_obligation ::= affected temporary_combat_requirement this_duration "if" "able"

/* @sem Change::[Rule(RequireCombat{action:Attack(Any), amount:AtLeast(Constant(1))}), Rule(RequireCombat{action:Block(Any), amount:AtLeast(Constant(1))})] */
temporary_attack_or_block ::= "attacks" "or" "blocks"

/* @prefer always */
/* @sem Change::[Rule(RequireCombat{action:Attack(Players(One(AbilityController))), amount:AtLeast(Constant(1))})] */
temporary_attack_you ::= "attacks" "you"

temporary_combat_requirement ::= temporary_attack_or_block | temporary_attack_you

/* Temporary reduction uses the same owner and amount operands as static reductions. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(All), changes:[PlayerRule(ActivationCost{abilities:AbilityOf($activation_owner), change:Reduce($generic_reduction_symbols)})], duration:$this_duration, evaluation:LiveObjects} */
temporary_activation_reduction ::= "activated" "abilities" "of" activation_owner "cost" generic_reduction_symbols "less" "to" "activate" this_duration

/* Singular changes without an expiration retain the affected target's identity. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($target_up_to_one_other)), changes:$singular_loss, duration:Indefinite, evaluation:Snapshot} */
indefinite_singular_snapshot ::= target_up_to_one_other singular_loss

/* @sem Change::[RemoveAllAbilities] */
singular_loss ::= "loses" "all" "abilities"

/* The repeated doubling is a snapshot of the same target's current power. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($repeated_power_target)), changes:[Pump{power:Multiply([ObjectProperty{object:$repeated_power_target, property:Power, information:CurrentOrLastKnown}, Subtract([Exponentiate(Constant(2), $number), Constant(1)])]), toughness:Constant(0)}], duration:$duration, evaluation:Snapshot} */
repeated_target_power ::= duration "," "double" repeated_power_target "power" number "times"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$repeated_power_noun}), index:0} */
repeated_power_target ::= "target" repeated_power_noun

/* @sem ObjectFilter::CardType(Creature) */
repeated_power_creature ::= "creature's"

/* @sem ObjectFilter::CardType(Artifact) */
repeated_power_artifact ::= "artifact's"

repeated_power_noun ::= repeated_power_creature | repeated_power_artifact

/* The spell population and granted mechanic remain independent operands. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($universal_granted_spells), changes:[GrantAbility($mechanic_bare)]}) */
static_universal_spell_mechanic ::= universal_granted_spells "have" mechanic_bare "."

universal_granted_spells ::= universal_any_spells | universal_filtered_spells

/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:Any} */
universal_any_spells ::= "all" "spells"

/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:$spell_adjective} */
universal_filtered_spells ::= "all" spell_adjective "spells"

/* Singular cast subjects compose independently with the cost modifier. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$singular_cast_cost_subject, modifier:$chosen_color_spell_reduction})]}) */
static_singular_chosen_color_cost ::= singular_cast_cost_subject "you" "cast" "costs" chosen_color_spell_reduction "."

singular_cast_cost_subject ::= singular_cast_cost_any | singular_cast_cost_filtered

/* @sem ObjectFilter::Any */
singular_cast_cost_any ::= "each" "spell"

/* @sem $card_filter */
singular_cast_cost_filtered ::= "each" card_filter "spell"

/* @sem SpellCostModifier::Reduce{reductions:[_{amount:@times($braced_number, Expr::ChosenColorsOf($object_ref))}], spill_into_generic:true} */
chosen_color_spell_reduction ::= braced_number "less" "to" "cast" "for" "each" "of" "the" "chosen" "colors" object_ref "is"

/* A cascade permission composes its card filter and entry condition. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule($cascade_entry_permission)]}) */
static_cascade_entry_permission ::= "as" "you" "cascade" "," cascade_entry_permission "."

cascade_entry_permission ::= cascade_entry_permission_a | cascade_entry_permission_an

/* @sem PlayerRule::CascadePut{filter:$filter_phrase, flags:$cascade_entry_flags} */
cascade_entry_permission_a ::= "you" "may" "put" "a" filter_phrase "card" "from" "among" "the" "exiled" "cards" "onto" "the" "battlefield" cascade_entry_flags

/* @sem PlayerRule::CascadePut{filter:$filter_phrase, flags:$cascade_entry_flags} */
cascade_entry_permission_an ::= "you" "may" "put" "an" filter_phrase "card" "from" "among" "the" "exiled" "cards" "onto" "the" "battlefield" cascade_entry_flags

/* @sem Operand::List([Term{family:EnterFlag, form:EntersTapped}]) */
cascade_entry_flags ::= "tapped"

/* A named holder can ignore a targeting restriction for a specified controller.
   The singular pronoun refers to that same named holder. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_ref_named)), changes:$controlled_targeting_exception, duration:$duration, evaluation:LiveObjects} */
continuous_named_targeting_exception ::= duration "," self_ref_named controlled_targeting_exception

/* @sem Change::[Rule(TargetableDespite{sources:ControlledBy($players_singular), keyword:$targeting_ignored_keyword})] */
controlled_targeting_exception ::= "can" "be" "the" "target" "of" "spells" "and" "abilities" "controlled" "by" players_singular "as" "though" "it" "didn't" "have" targeting_ignored_keyword

/* The choice action is retained inside its optional payment. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:AnyNumber, options:[]}} */
choose_any_colors ::= "the" "color" "or" "colors" "of" "your" "choice"

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$choose_any_colors}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:$object_ref, affected:Objects(One($object_ref)), changes:[ChosenColor{mode:Set}], duration:Indefinite, evaluation:Snapshot}}]}, otherwise:Program{}}] */
optional_object_color_choice ::= "you" "may" "have" object_ref "become" choose_any_colors

/* Duration-first copy wording shares the same current operands as suffix wording. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@copy_subject(ObjectSet::$affected, ObjectRef::$target_card_exile_counter)), changes:[CopyOf{object:$target_card_exile_counter, exceptions:[]}], duration:$duration, evaluation:Snapshot} */
copy_effect_leading_duration ::= duration "," affected "becomes" "a" "copy" "of" target_card_exile_counter

/* A quoted copied ability closes the surrounding sentence. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@copy_subject(ObjectSet::$affected, ObjectRef::$copy_model_ref)), changes:[CopyOf{object:$copy_model_ref, exceptions:$copy_exceptions_closed}], duration:Indefinite, evaluation:Snapshot}}] */
clause_copy_quoted ::= affected "becomes" "a" "copy" "of" copy_model_ref "," "except" copy_exceptions_closed

/* The top creature card and all later references share one movement receipt. */
/* @prefer always */
/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:CardType(Creature)}, count:Constant(1), from:Top}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
top_creature_graveyard_battlefield ::= "return" "the" "top" "creature" "card" "of" "your" "graveyard" "to" "the" "battlefield"

/* @sem Instruction::[Effect{result:@mark, operation:$top_creature_graveyard_battlefield}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@marked, phase:After, index:0})), changes:$static_changes, duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@marked, phase:After, index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}] */
clause_top_creature_grant_exile ::= top_creature_graveyard_battlefield "." "that" "creature" static_changes duration "." "exile" "it" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* Land type choice shares the change operand, including additive and set forms. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:BasicLandType, terms:_{count:Exactly(Constant(1))}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[$chosen_land_type_change], duration:$duration, evaluation:Snapshot}}] */
chosen_land_type_prefix ::= duration "," affected "becomes" "the" "basic" "land" "type" "of" "your" "choice" chosen_land_type_change

/* @sem Change::ChosenType{kind:LandType, mode:Add} */
chosen_land_type_change ::= "in" "addition" "to" "its" "other" "types"

/* A player and an object use different continuous-effect recipient kinds. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[Term{family:ChoosableColor, form:AnyColor}]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players($player_rule_you), changes:[PlayerRule(GrantKeyword(Protection(Objects(_{kind:Any, filter:Chosen(Color)}))))], duration:$duration, evaluation:LiveObjects}}] */
chosen_color_player_protection ::= player_rule_you "gain" "protection" "from" "the" "color" "of" "your" "choice" duration

/* The pronoun is bound to the sole target, so the choice exclusion and the
   affected set cannot name different objects on the inverse path. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{except:[Object($target_object)], random:true, count:Exactly(Constant(1))}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members(ObjectSet::One($target_object))), changes:[$random_color_protection_change], duration:$duration, evaluation:Snapshot}}] */
random_color_protection_target ::= duration "," target_object "gains" random_color_protection_change

/* @sem Change::GrantKeyword(Protection(Objects(_{kind:Any, filter:Chosen(Color)}))) */
random_color_protection_change ::= "protection" "from" "a" "color" "chosen" "at" "random" "from" "colors" "it" "doesn't" "have" "protection" "from"

/* Infinitive changes compose with the ordinary affected set and duration. */
/* @sem Change::[AddCardType(Artifact), AddCardType(Creature)] */
change_become_artifact_creature_singular ::= "become" "an" "artifact" "creature"

/* @sem Change::[Colors{mode:Add, colors:[$mana_color_word]}, CreatureTypes{mode:Add, types:Listed($becomes_types)}, SetBasePowerToughness{power:$value, toughness:$value_2}] */
change_become_colored_base_retained ::= "become" "a" mana_color_word becomes_types "with" "base" "power" "and" "toughness" value "/" value "in" "addition" "to" "its" "other" "colors" "and" "types"

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Artifact), AddCardType(Creature)] */
change_become_named_artifact_retained ::= "become" value "/" value becomes_types "artifact" "creatures" "in" "addition" "to" "their" "other" "types"

/* The named permanent supplies both the source and the expiration identity. */
/* @sem Operation::CreateContinuousEffect{source:$object_ref, affected:Objects($affected), changes:[SetLandType(Vocabulary{family:LandType, form:@subtype_name($basic_land_type_named)})], duration:WhileOnBattlefield($object_ref), evaluation:Snapshot} */
continuous_until_object_leaves ::= affected "become" basic_land_type_named "until" object_ref "leaves" "the" "battlefield"

/* The granted card holds its own graveyard casting permission. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Source), from:Graveyard, action:CastSpell, filter:Any})]})} */
graveyard_quoted_permission ::= "you" "may" "cast" "this" "card" "from" "your" "graveyard"

/* Keep the joint qualifier on the two affected populations while counting the live sources of the bonus. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$plural_compound_and_modified}), changes:[Pump{power:@times($signed, $count_each_controlled_population_sum), toughness:@times($signed_2, $count_each_controlled_population_sum)}]} */
static_pump_compound_population ::= plural_compound_and_modified "get" signed "/" signed "for" "each" count_each_controlled_population_sum "."

/* Team-controlled subtype grants keep their controller predicate in the
   affected battlefield population of the static ability. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([ControlledBy($life_history_team), $static_team_keyword_subtype])}), changes:[$grant_keyword]} */
static_team_subtype_keyword ::= static_team_keyword_subtype life_history_team "controls" "have" grant_keyword "."

static_team_keyword_subtype ::= team_controlled_observed_subtype_plural | st_warrior_pl

/* A shared leading window scopes both player restrictions. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:$you_cannot_lose_rule, duration:$rule_duration, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(OpponentsOf(AbilityController)), changes:$opponents_cannot_win_rule, duration:$rule_duration, evaluation:LiveObjects}}] */
instructions_temporary_game_protection ::= rule_duration "," "you" you_cannot_lose_rule "and" "your" "opponents" opponents_cannot_win_rule

/* @sem Change::[PlayerRule(Prohibit(LoseGame{}))] */
you_cannot_lose_rule ::= "can't" "lose" "the" "game"

/* @sem Change::[PlayerRule(Prohibit(WinGame))] */
opponents_cannot_win_rule ::= "can't" "win" "the" "game"

/* Leading windows apply to a rule affecting the controller. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:$temporary_mana_player_rule, duration:$duration, evaluation:LiveObjects} */
temporary_controller_mana_rule ::= duration "," temporary_mana_player_rule

temporary_mana_player_rule ::= life_for_mana_rule | tap_others_mana_rule | temporary_retain_colored_mana

/* Copy references preserve the preceding selection; exception phrases retain their
   individual ability scopes and current operands. */
selected_copy_ref ::= selected_copy_creature | selected_copy_last_card

/* @sem ObjectRef::Earlier{what:Selected} */
selected_copy_creature ::= "the" "chosen" "creature"

/* @sem ObjectRef::Earlier{what:Selected} */
selected_copy_last_card ::= "the" "last" "chosen" "card"

/* @sem Change::[CopyOf{object:$selected_copy_ref, exceptions:[]}] */
change_selected_copy ::= "is" "a" "copy" "of" selected_copy_ref

/* A landwalk family restriction and its corresponding blocking exception compose
   independently with the affected population and other static changes. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, HasKeywordFamily(Landwalk)])} */
affected_landwalk_family_plural ::= filter_plural "with" "landwalk" "abilities"

/* @sem Change::[Rule(BlockedAsThoughLacking(Term{family:CheckHasable, form:AnyLandwalk}))] */
change_any_landwalk_lacking ::= "can" "be" "blocked" "as" "though" "they" "didn't" "have" "those" "abilities"

/* The demonstrative refers to the landwalk abilities in this population. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected_landwalk_family_plural), changes:$change_any_landwalk_lacking}) */
static_landwalk_family_exception ::= affected_landwalk_family_plural change_any_landwalk_lacking "."

/* Temporary grants use the same card population and mechanic as static grants. */
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$graveyard_grant_filter} */
graveyard_grant_population ::= "each" graveyard_grant_filter "card" "in" "your" "graveyard"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($graveyard_grant_population), changes:[GrantAbility($graveyard_granted_ability)], duration:$duration, evaluation:Snapshot} */
temporary_graveyard_grant ::= graveyard_grant_population "gains" graveyard_granted_ability duration

/* A defined X can feed either one stat or both from the same current expression. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:$graveyard_three_count, toughness:$value}], duration:$duration, evaluation:Snapshot} */
defined_pump_power ::= affected "gets" "+" "X" "/" "+" value duration "," "where" "X" "is" graveyard_three_count

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AnyOf([$filter_phrase, CardType(Instant), CardType(Sorcery)])}) */
graveyard_three_count ::= "the" "number" "of" filter_phrase "," "instant" "," "and" "sorcery" "cards" "in" "your" "graveyard"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:$greatest_union_power, toughness:$greatest_union_power}], duration:$duration, evaluation:Snapshot} */
defined_pump_both ::= affected "gets" "+" "X" "/" "+" "X" duration "," "where" "X" "is" greatest_union_power

/* @sem Expr::Aggregate{objects:Union([$affected, Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}]), property:Power, aggregation:Maximum} */
greatest_union_power ::= "the" "greatest" "power" "among" affected "and" filter_phrase "cards" "in" "your" "graveyard"

/* @sem Change::[Rule(BlockCapacity(Additional($number)))] */
additional_blocks_this_turn ::= "that" "creature" "can" "block" "up" "to" number "additional" "creatures" "this" "turn"

/* The characteristic snapshot and block capacity have different evaluations. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($block_capacity_target)), changes:[Pump{power:$signed, toughness:$signed_2}], duration:EndOfTurn, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($block_capacity_target)), changes:$additional_blocks_this_turn, duration:EndOfTurn, evaluation:LiveObjects}}] */
instructions_pump_then_additional_blocks ::= block_capacity_target "gets" signed "/" signed "until" "end" "of" "turn" "." additional_blocks_this_turn

/* A three-type controlled population can share a keyword and a quoted trigger. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($three_controlled_types), changes:[GrantKeyword($keyword_name), $three_types_quoted_trigger]} */
three_types_keyword_trigger ::= three_controlled_types "have" keyword_name "and" three_types_quoted_trigger

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([AnyOf([$subtype_plural, $subtype_plural_2, $subtype_plural_3]), ControlledBy(One(AbilityController))])} */
three_controlled_types ::= subtype_plural "," subtype_plural "," "and" subtype_plural "you" "control"

/* @sem Change::GrantAbility(@scope(Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$quoted_remove_owned_counter_draw_tokens})) */
three_types_quoted_trigger ::= '"' event_clause "," quoted_remove_owned_counter_draw_tokens "." '"'

/* The granted activation is scoped to its holder; its activator remains the granting controller. */
/* @sem Change::[GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{modifiers:[ActivationRule(OnlyBy(One(Prior(GrantedBy))))]}, announcement:@announcement, body:$program}))] */
change_granted_controller_activation ::= "gains" '"' cost ":" program "." '"' "only" "you" "may" "activate" "this" "ability"

/* The attack condition and static population have independent type operands. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$controlled_type_pump_subject, ControlledBy(One(AbilityController))])}), changes:[Pump{power:$signed, toughness:$signed_2}]} */
controlled_type_plural_pump ::= controlled_type_pump_subject "you" "control" "get" signed "/" signed

/* @sem Ability::Conditional{condition:$controlled_type_attack_history, then:[$controlled_type_plural_pump]} */
conditional_controlled_type_attack_pump ::= "as" "long" "as" controlled_type_attack_history "," controlled_type_plural_pump "."

/* Sentence-initial capitalization is local to the pump subject. */
controlled_type_pump_subject ::= subtype_plural | subtype_marked_merfolk | controlled_type_marked_goblins | controlled_type_lower_humans

/* @sem ObjectFilter::Subtype(Goblin) */
controlled_type_marked_goblins ::= "↑" "goblins"

/* The combat relation belongs to the announced target. */
combat_opposing_target ::= combat_opposing_target_plain | combat_opposing_target_being

/* @prefer always */
/* @sem Expr::Add([$value, ObjectProperty{object:$combat_opposing_target, property:Power, information:CurrentOrLastKnown}]) */
combat_target_power_sum ::= value "plus" "the" "power" "of" combat_opposing_target

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_possessive)), changes:[SetToughness($base_toughness_value)], duration:Indefinite, evaluation:Snapshot} */
set_own_base_toughness ::= self_possessive "base" "toughness" "becomes" "equal" "to" base_toughness_value

/* A bounded graveyard play permission with a separately scoped granted ability. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:Any}), from:Graveyard, action:Either, filter:$graveyard_land_or_permanent_permission}, terms:_{limit:EachTurn(1), during:One(AbilityController), cost:Normal, effects:[List([Term{family:SpellEffect, form:AddAbility, operands:[Ability(@scope($graveyard_permission_death_trigger))]}])]}})]}) */
static_graveyard_land_permanent_grant ::= "once" "during" "each" "of" "your" "turns" "," "you" "may" graveyard_land_or_permanent_permission "." "if" "you" "do" "," "it" "gains" '"' graveyard_permission_death_trigger '"'

/* @sem ObjectFilter::AnyOf([CardType(Land), AllOf([AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]), Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}])]) */
graveyard_land_or_permanent_permission ::= "play" "a" "land" "from" "your" "graveyard" "or" "cast" "a" "permanent" "spell" "with" "mana" "value" number "or" "less" "from" "your" "graveyard"

/* @sem Ability::Triggered{event:ZoneChange{objects:AllOf([SameObject(Source), OwnedBy(All)]), from:Battlefield, to:Graveyard}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:$number}}]}} */
graveyard_permission_death_trigger ::= "when" "this" "permanent" "is" "put" "into" "a" "graveyard" "from" "the" "battlefield" "," "exile" "it" "and" "you" "gain" number "life" "."

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, GrantKeyword($keyword_value)] */
shared_base_keyword ::= "has" "base" "power" "and" "toughness" value "/" value "and" keyword_value

colored_cost_spell_filter ::= chosen_creature_cost_spells | cast_spells_filter

/* Qualifiers bind the affected spell to a chosen or shared creature type. */
/* @sem ObjectFilter::Chosen(CreatureType) */
spell_cost_chosen_creature_type ::= "of" "the" "chosen" "type"

/* @sem ObjectFilter::Shares{property:CreatureTypes, with:$object_ref} */
spell_cost_shared_creature_type ::= "that" "share" "a" "creature" "type" "with" object_ref

/* Filtered spells receive a colored-only reduction, retaining each mana color. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$cast_spells_filter, modifier:Reduce{reductions:$colored_cost_reductions}})]}) */
static_filtered_colored_spell_cost ::= cast_spells_filter "you" "cast" "cost" colored_cost_reductions "less" "to" "cast" "." "this" "effect" "reduces" "only" "the" "amount" "of" "colored" "mana" "you" "pay" "."

/* The implicit choice and its copy share one linked exile population and one
   attachment host. Keeping the pair together proves the result reference. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([InSet(Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)})), $attachment_linked_card_type])}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(EventOther)), changes:[CopyOf{object:Result{result:@prior, phase:After, index:0}, exceptions:[]}], duration:WhileMatches{object:Source, filter:AttachedTo(SameObject(EventOther))}, evaluation:Snapshot}}] */
attachment_linked_card_copy ::= "for" "as" "long" "as" self_equipment "remains" "attached" "to" "it" "," "that" "creature" "becomes" "a" "copy" "of" attachment_linked_card_type "card" "exiled" "with" self_equipment

/* @sem Ability::Triggered{event:$attachment_equipment_becomes_creature, limits:_{}, announcement:@announcement, body:Program{instructions:$attachment_linked_card_copy}} */
triggered_attachment_linked_copy ::= attachment_equipment_becomes_creature "," attachment_linked_card_copy "."

attachment_linked_card_type ::= attachment_linked_consonant_type | attachment_linked_artifact_type

/* @sem $attachment_linked_consonant_noun */
attachment_linked_consonant_type ::= "a" attachment_linked_consonant_noun

attachment_linked_consonant_noun ::= noun_creature | noun_land

/* @sem $noun_artifact */
attachment_linked_artifact_type ::= "an" noun_artifact

/* The exclusion and controller qualify the entire subtype union. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), AllOf([$plural_subtype_list, ControlledBy(One(AbilityController))])])} */
affected_other_controlled_subtype_list ::= "other" plural_subtype_list "you" "control"

/* Base stats and a retained color/type are independent operands. */
/* @sem Change::[...$singular_base_stats, ...$singular_keyword_grant, ...$retained_color_creature_type] */
static_base_keyword_color_type ::= singular_base_stats "," singular_keyword_grant "," "and" retained_color_creature_type

/* @sem Change::[SetBasePowerToughness{power:Expr::AnnouncedX, toughness:Expr::AnnouncedX}] */
static_base_both_x ::= "has" "base" "power" "and" "toughness" "X" "/" "X"

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value}] */
static_have_equal_base_stats ::= "have" "base" "power" "and" "toughness" "each" "equal" "to" value

/* @sem Change::[SetBasePowerToughness{power:$number, toughness:$number_2}, ...$bk_named_artifact_native, ...$grants] */
static_is_animation_with ::= "is" "a" number "/" number bk_named_artifact_native "with" grants

/* The blocking population and the event's object remain independent operands. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Rule(RequireCombat{action:Block(SameObject($object_ref)), amount:AtLeast(Constant(1))})], duration:$this_duration, evaluation:LiveObjects} */
have_block_requirement ::= "have" affected "block" object_ref this_duration "if" "able"

/* One sentence can describe characteristic grants and a separate combat rule
   on the same equipped object. The keyword remains an independent operand. */
/* @sem Ability::[Static(_{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[GrantKeyword($keyword_value), ChosenType(_{kind:CardName, mode:Set}), ChosenType(_{kind:CreatureType, mode:Set})]}), Static(_{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Rule(Prohibit(BeBlocked(Any)))]})] */
line_equipped_keyword_chosen_identity ::= "equipped" "creature" "has" keyword_value "," "it" "can't" "be" "blocked" "," "and" "its" "name" "and" "creature" "type" "are" "the" "last" "chosen" "name" "and" "creature" "type" "."

/* This wording scales both stats by the same current card-type population. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[GrantKeyword($keyword_name), Pump{power:CountDistinct{objects:$card_types_population, property:CardTypes}, toughness:CountDistinct{objects:$card_types_population, property:CardTypes}}], duration:$duration, evaluation:Snapshot} */
source_keyword_card_types_pump ::= duration "," "this" "creature" "gains" keyword_name "and" "gets" "+" "1" "/" "+" "1" "for" "each" "card" "type" "among" card_types_population

/* Conditional static clauses compose a time window with independently typed rules. */
/* @sem Ability::Conditional{condition:$pilot_static_window, then:$pilot_static_body} */
pilot_conditional_static ::= pilot_static_window "," pilot_static_body "."

pilot_static_window ::= window_your_turn | pilot_opponent_end_step

/* @sem Condition::AllOf([ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))}, Window(EndStep)]) */
pilot_opponent_end_step ::= "during" "each" "opponent's" "end" "step"

pilot_static_body ::= pilot_own_zone_play_permission | pilot_flash_permission | pilot_equip_permission | pilot_counted_spell_reduction | pilot_opponent_taxes | pilot_object_and_equip | pilot_player_and_object_hexproof

/* @sem Ability::[Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellTiming{spells:$flash_spells, timing:Flash})]})] */
pilot_flash_permission ::= "you" "may" "cast" flash_spells "as" "though" "they" "had" "flash"

/* @sem Ability::[Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule($player_instant_activation)]})] */
pilot_equip_permission ::= "you" player_instant_activation

/* @sem Ability::[Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$cast_spells_filter, modifier:Reduce{reductions:[_{amount:@times($braced_number, $pilot_counted_affected)}], spill_into_generic:true}})]})] */
pilot_counted_spell_reduction ::= cast_spells_filter "you" "cast" "cost" braced_number "less" "to" "cast" "for" pilot_counted_affected

/* @sem Value::CountObjects($affected) */
pilot_counted_affected ::= affected

/* @sem Ability::[Static(_{kind:Ordinary, affected:Players(OpponentsOf(AbilityController)), changes:[$pilot_spell_tax, $pilot_activation_tax]})] */
pilot_opponent_taxes ::= pilot_spell_tax "and" pilot_activation_tax

/* @sem Change::PlayerRule(SpellCost{spells:$cast_spells_filter, modifier:Increase($cost)}) */
pilot_spell_tax ::= cast_spells_filter "your" "opponents" "cast" "cost" cost "more" "to" "cast"

/* @sem Change::PlayerRule(ActivationCost{abilities:Not(OnStack(Mana)), change:Increase(Cost($cost))}) */
pilot_activation_tax ::= "abilities" "your" "opponents" "activate" "cost" cost "more" "to" "activate" "unless" "they're" "mana" "abilities"

/* @sem Ability::[Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes}), $pilot_equip_reduction] */
pilot_object_and_equip ::= affected static_changes "and" pilot_equip_reduction

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(ActivationCost{abilities:OnStack(Keyword(Equip)), change:Reduce(Term{family:CostReductionSymbol, form:CostReduceGeneric, operands:[Integer($number)]})})]}) */
pilot_equip_reduction ::= "equip" "abilities" "you" "activate" "cost" "{" NUMBER "}" "less" "to" "activate"

/* @sem Ability::[Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(GrantKeyword(Hexproof))]}), Static(_{kind:Ordinary, affected:Objects($affected), changes:[GrantKeyword(Hexproof)]})] */
pilot_player_and_object_hexproof ::= "you" "and" affected "have" "hexproof"

/* A plural animation retains the chosen target set and the granted ability's scope. */
/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, Colors{mode:Set, colors:[$mana_color_word]}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetCardTypes([Creature]), GrantKeyword($keyword_value), GrantKeyword($keyword_value_2), $shared_granted_trigger_closed] */
chosen_plural_colored_animation ::= "become" value "/" value mana_color_word becomes_types "creatures" "with" keyword_value "," keyword_value "," "and" shared_granted_trigger_closed

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($objects_targets_plain), changes:$chosen_plural_colored_animation, duration:$duration, evaluation:Snapshot}}]} */
choose_targets_plural_animation ::= "choose" objects_targets_plain "." duration "," "they" chosen_plural_colored_animation

/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$choose_targets_plural_animation} */
turn_choose_targets_animation ::= "at" turn_event "," choose_targets_plural_animation

/* A shared subject carries both a characteristic grant and a live combat rule. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$grants, duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$be_blocked_requirement, duration:$this_duration, evaluation:LiveObjects}}] */
clause_grant_and_block_requirement ::= affected "gains" grants duration "and" be_blocked_requirement this_duration "if" "able"

/* Both effects refer to the announced object, not the tap result. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:$object_set, tapped:true}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($object_set)), changes:$attached_activation_prohibition, duration:$this_duration, evaluation:LiveObjects}}] */
clause_tap_activation_turn ::= "tap" object_set "." attached_activation_prohibition this_duration

/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:$object_set, tapped:true}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($object_set)), changes:$attached_activation_prohibition, duration:WhileMatches{object:$object_ref, filter:Tapped}, evaluation:LiveObjects}}] */
clause_tap_activation_tapped ::= "tap" object_set "." attached_activation_prohibition "for" "as" "long" "as" object_ref "remains" "tapped"

/* The setter uses the current expression and the holder named by the possessive. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_possessive)), changes:[SetPower($value)], duration:$duration, evaluation:Snapshot} */
have_base_power_equal ::= "have" self_possessive "base" "power" "become" "equal" "to" value duration

/* A continuous goad follows the object controlled by the player previously
   introduced, and ends when that player no longer controls that object. */
/* @sem Duration::WhileControlled{player:ControllerOf($object_ref), object:$object_ref} */
while_they_control_object ::= "for" "as" "long" "as" "they" "control" object_ref

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$change_its_goaded, duration:$while_they_control_object, evaluation:LiveObjects} */
continuous_it_goaded ::= affected change_its_goaded while_they_control_object

/* @sem Change::[Rule(GoadedBy(AbilityController))] */
change_its_goaded ::= "'s" "goaded"

/* Converting a returned object combines independent type, enchant and granted
   ability operands; the return receipt remains the affected incarnation. */
/* @sem Change::[SetCardTypes([Enchantment]), AddEnchantmentType(Vocabulary{family:EnchantmentType, form:Aura}), RemoveAllAbilities, GrantAbility(Enchant{hosts:Permanents($filter_phrase)}), GrantAbility(Static(_{kind:Ordinary, affected:Objects($affected), changes:[GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program}))]}))] */
aura_conversion_changes ::= "an" "Aura" "enchantment" "with" "enchant" filter_phrase "and" '"' affected "has" "'" cost ":" program "." "'" '"'

/* @sem Operation::CreateContinuousEffect{source:$object_ref, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:$aura_conversion_changes, duration:Indefinite, evaluation:Snapshot} */
returned_aura_conversion ::= "it's" aura_conversion_changes object_ref "loses" "all" "other" "abilities"

static_rule_player ::= players_singular | players_chosen_shared

/* Third-person draw rules share the player subject with other player rules. */
/* @sem PlayerRule::RevealDraws{} */
player_reveals_drawn_cards ::= "reveals" "each" "card" "they" "draw"

/* Possessive subjects supply the affected player independently of the value. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players($hand_size_possessive), changes:[PlayerRule(HandSize(Set($hand_size_value)))]}) */
static_possessive_hand_size_set ::= hand_size_possessive "maximum" "hand" "size" "is" hand_size_value "."

hand_size_possessive ::= hand_size_yours | hand_size_chosen

/* @sem PlayerSet::One(Chosen) */
hand_size_chosen ::= "the" "chosen" "player's"

/* The same filtered spell population feeds each of the two player rules. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$spell_cost_threshold, modifier:$spell_cost_change}), PlayerRule(SpellsHaveAbilities{spells:$spell_cost_threshold, abilities:List([Term{family:SpellEffect, form:CantBeCountered}])})]}) */
static_threshold_cost_protection ::= "spells" "you" "cast" spell_cost_threshold "cost" spell_cost_change "to" "cast" "and" "can't" "be" "countered" "."

/* Plural spell grants use a filtered population and an independent effect. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellsHaveAbilities{spells:$spell_cost_threshold, abilities:List([$spell_mana_grant_effect])})]}) */
static_threshold_spell_grant ::= "spells" "you" "cast" spell_cost_threshold "have" spell_mana_grant_effect "."

/* Each target independently scales an increase to the specified cost. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players($target_tax_casters), changes:[PlayerRule(SpellCost{spells:$cast_spells_filter, modifier:Scaled{change:Increase(Cost($cost)), per:EachTarget}})]}) */
static_target_scaled_increase ::= cast_spells_filter target_tax_casters "cast" "cost" cost "more" "to" "cast" "for" "each" "target" "."

/* The repeated flying clause fixes the first copied kind; the remaining
   listed kinds and the opposing population are separate semantic operands. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[GainAbilitiesOf{objects:$opponent_flying_origin, kinds:List([Term{family:CheckHasable, form:Flying}, $copied_check_kind, $copied_check_kind_2, $copied_check_kind_3])}]} */
static_copy_opponent_flying_kinds ::= "as" "long" "as" opponent_flying_origin "," affected "has" "flying" "." "the" "same" "is" "true" "for" copied_check_kind "," copied_check_kind "," "and" copied_check_kind "."

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([ControlledBy(OpponentsOf(AbilityController)), $filter_phrase, $modifier_not_named_self])} */
opponent_flying_origin ::= "an" "opponent" "controls" "a" filter_phrase "with" "flying" modifier_not_named_self

copied_check_kind ::= lost_flying | lost_first_strike | lost_trample | lost_defender | copied_check_any_color_protection

/* @sem Operand::Term{family:CheckHasable, form:AnyProtectionFromColor, operands:[]} */
copied_check_any_color_protection ::= "protection" "from" "any" "color"

/* A linked exile permission retains both the linked object and spending terms. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$permission_linked_exile_cards, from:Exile, action:Either, filter:Any}, terms:_{cost:Normal, spend_as:AnyColor}})]}) */
static_play_linked_any_color ::= "you" "may" "play" permission_linked_exile_cards "," "and" "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "those" "spells" "."

/* A visibility grant and a separately scoped triggered ability share one holder. */
/* @sem Change::GrantAbility(Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, audience:AffectedPlayer})]})) */
shared_granted_look_top ::= '"' "you" "may" "look" "at" "the" "top" "card" "of" "your" "library" "any" "time" '"'

/* @sem Change::[$shared_granted_look_top, $shared_granted_trigger_closed] */
shared_look_trigger_changes ::= "has" shared_granted_look_top "and" shared_granted_trigger_closed

/* The frequency and the permission are independent operands. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:$top_library_cast_permission, terms:_{limit:$top_cast_turn_limit, cost:Normal}})]}) */
static_top_library_cast_limited ::= top_cast_turn_limit "," "you" "may" top_library_cast_permission "."

 top_cast_turn_limit ::= top_cast_once | top_cast_twice

/* @sem PlayLimit::EachTurn(1) */
top_cast_once ::= "once" "each" "turn"

/* @sem PlayLimit::EachTurn(2) */
top_cast_twice ::= "twice" "each" "turn"

/* @sem PlayerRule::PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, from:Library, action:CastSpell, filter:$top_cast_shared_filter} */
top_library_cast_permission ::= "cast" "a" "spell" "from" "the" "top" "of" "your" "library" "if" "it" top_cast_shared_filter

/* A single cast retains its own limit and the controller's graveyard. */
/* @sem Change::[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:$filter_phrase}, terms:_{limit:Total(1), cost:Normal}})] */
graveyard_cast_single_changes ::= "cast" "a" filter_phrase "spell" "from" "your" "graveyard"

/* The named attacker and the first creature refer to the triggering object. */
/* @prefer always */
/* @sem ObjectSet::One(EventSubject) */
event_attacker_subject ::= "the" "creature" "that" "attacked"

/* @sem ObjectSet::One(EventSubject) */
event_first_creature ::= "the" "first" "creature"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($event_snapshot_subject), changes:$static_changes, duration:$duration, evaluation:Snapshot} */
event_subject_snapshot ::= event_snapshot_subject static_changes duration

/* @sem Change::[Rule(CombatDamage(NoAssignment))] */
no_combat_assignment_singular ::= "assigns" "no" "combat" "damage"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($event_first_creature), changes:$no_combat_assignment_singular, duration:$this_duration, evaluation:LiveObjects} */
event_subject_rule ::= event_first_creature no_combat_assignment_singular this_duration

/* A player selector and an object are independent operands of control. */
/* @sem PlayerRef::Seat{of:AbilityController, side:Right} */
control_right_player ::= "the" "player" "to" "your" "right"

/* @sem PlayerRef::Seat{of:AbilityController, side:Left} */
control_left_player ::= "the" "player" "to" "your" "left"

/* @sem PlayerRef::Extreme{players:All, number:Permanents($filter_plural), highest:true} */
control_most_player ::= "the" "player" "who" "controls" "the" "most" filter_plural

control_indefinite_player ::= control_right_player | control_left_player | control_most_player | control_random_target_opponent

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[SetController($control_indefinite_player)], duration:Indefinite, evaluation:Snapshot} */
control_indefinite ::= control_indefinite_player "gains" "control" "of" affected

/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($subtype_tokens, $modifier_you_control)}), changes:[$grant_keyword]} */
static_subtype_token_keyword ::= subtype_tokens modifier_you_control "have" grant_keyword "."

/* Both conditions limit the duration, and each names its own object. */
/* @sem Duration::Either([WhileControlled{player:AbilityController, object:$object_ref}, WhileMatches{object:$object_ref_2, filter:Tapped}]) */
while_you_control_and_tapped ::= "for" "as" "long" "as" "you" "control" object_ref "and" object_ref "remains" "tapped"

/* Permission for the next played card of the current filter. */
/* @sem Instruction::[Effect{result:@next, operation:EffectOn{subject:Players(One(AbilityController)), effects:[Term{family:FuturePlayerEffect, form:NextCardPlayedThisCanCanBePlayedAsThoughItHadFlash, operands:[Filter($noun)]}]}}] */
clause_next_card_flash ::= "the" "next" noun "card" "you" "play" "this" "turn" "can" "be" "played" "as" "though" "it" "had" "flash"

/* A line break may separate consecutive instructions of the same spell. */
/* @sem Instruction::[...$clause_next_card_flash, ...$instructions] */
instructions_next_card_newline ::= clause_next_card_flash "." NEWLINE instructions

/* A timed cost modifier preserves the casting player and the full spell filter. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players($players_singular), changes:[PlayerRule(SpellCost{spells:$timed_spell_filter, modifier:$spell_cost_less})], duration:$duration, evaluation:LiveObjects}}] */
clause_timed_spell_cost ::= duration "," timed_spell_filter players_singular "casts" "cost" spell_cost_less "to" "cast"

/* @sem ObjectFilter::AnyOf([$spell_adjective, $spell_adjective_2, $filter_phrase]) */
timed_spell_filter ::= spell_adjective "," spell_adjective "," "and" filter_phrase "spells"

/* A singular optional target is reused for both effects. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_up_to_one)), changes:$change_pump, duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_up_to_one)), changes:[Rule(Prohibit(Activate(Any)))], duration:$duration, evaluation:LiveObjects}}] */
clause_target_pump_prohibit_activation ::= duration "," target_up_to_one change_pump "and" "its" "activated" "abilities" "can't" "be" "activated"

/* The where-definition is shared by both statistics and is evaluated when the
   temporary effect resolves. Each printed shape has one verb inflection. */
/* @sem Operation::@where(Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:AnnouncedX, toughness:AnnouncedX}], duration:$duration, evaluation:Snapshot}, $pump_definition) */
continuous_defined_equal_pump ::= affected "gets" "+" "X" "/" "+" "X" duration "," "where" "X" "is" pump_definition

/* @sem Operation::@where(Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:AnnouncedX, toughness:$value}], duration:$duration, evaluation:Snapshot}, $pump_definition) */
continuous_defined_power_pump ::= affected "gets" "+" "X" "/" "+" value duration "," "where" "X" "is" pump_definition

pump_definition ::= pump_counter_population_definition | pump_energy_definition | pump_mana_symbols_definition | pump_stat_difference_definition

/* @sem Expr::PlayerNumber{player:AbilityController, number:Energy} */
pump_energy_definition ::= "the" "amount" "of" "{" "E" "}" "you" "have"

/* @sem Expr::CountManaSymbols{objects:$affected, colors:[$mana_color_word]} */
pump_mana_symbols_definition ::= "the" "number" "of" mana_color_word "mana" "symbols" "in" "the" "mana" "costs" "of" affected

/* @sem Expr::Maximum([Subtract([ObjectProperty{object:$pump_stat_possessive, property:$stat, information:CurrentOrLastKnown}, ObjectProperty{object:$pump_stat_possessive, property:$stat_2, information:CurrentOrLastKnown}]), Subtract([ObjectProperty{object:$pump_stat_possessive, property:$stat_2, information:CurrentOrLastKnown}, ObjectProperty{object:$pump_stat_possessive, property:$stat, information:CurrentOrLastKnown}])]) */
pump_stat_difference_definition ::= "the" "difference" "between" pump_stat_possessive stat "and" stat

pump_stat_possessive ::= it_possessive | pump_its_possessive

/* @sem ObjectRef::@it */
pump_its_possessive ::= "its"

/* The antecedent is this card while it is on top of its controller's library.
   The joined changes share that same top-card query. */
/* @sem Ability::WhileOnTopOfLibrary([Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:$top_card_anaphoric_changes})]) */
while_self_on_library_top ::= "as" "long" "as" "this" "card" "is" "the" "top" "card" "of" "your" "library" "," top_card_anaphoric_changes "."

/* @sem Change::[PlayerRule(Visibility{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, audience:AffectedPlayer}), ...$top_card_anaphoric_permission] */
top_card_anaphoric_changes ::= "you" "may" "look" "at" "it" "any" "time" "and" "you" "may" top_card_anaphoric_permission

top_card_anaphoric_permission ::= top_cast_it | top_play_it

/* @sem Change::[PlayerRule(PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, from:Library, action:CastSpell, filter:Any})] */
top_cast_it ::= "cast" "it"

/* @sem Change::[PlayerRule(PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, from:Library, action:Either, filter:Any})] */
top_play_it ::= "play" "it"

/* A once-per-turn free cast retains both the spell filter and its linked population. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$linked_exile_this_turn, from:Exile, action:CastSpell, filter:$spell_property_comparison}, terms:_{limit:EachTurn(1), cost:Free}})]}) */
static_once_free_linked_cast ::= "once" "each" "turn" "," "you" "may" "cast" "a" "spell" spell_property_comparison "from" "among" linked_exile_this_turn "without" "paying" "its" "mana" "cost" "."

/* @sem ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:$stat_comparison, value:$value}} */
spell_property_comparison ::= "with" stat stat_comparison value

/* A singular subject retains its other types while acquiring these creature characteristics. */
/* @sem Change::[SetBasePowerToughness{power:$number, toughness:$number_2}, CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Creature), ...$grants] */
static_retained_stats_creature_keywords ::= "is" "a" number "/" number becomes_types "creature" "with" grants "in" "addition" "to" "its" "other" "types"

/* The restricted defender is the player whose last-turn history is tested. */
/* @sem Change::[Rule(Prohibit(Attack(Players(Matching{binding:0, condition:Not(PlayerIn{player:Bound(0), players:$defender_history})}))))] */
rule_attack_player_unless_history ::= "can't" "attack" "a" "player" "unless" "that" "player" defender_history "during" "their" "last" "turn"

/* The payment and its entry consequence share one spell-cost scope. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$additional_creature_spell_filter, modifier:OptionalAdditional{cost:$optional_any_mana_payment, effects:$paid_mana_entry_counters}})]}) */
optional_creature_spell_entry_payment ::= "as" "an" "additional" "cost" "to" "cast" additional_creature_spell_filter "spells" "," "you" "may" optional_any_mana_payment "." "if" "you" "do" "," paid_mana_entry_counters "."

/* @sem Operand::List([Term{family:EnterFlag, form:EntersWithNumberCounters, operands:[Number(Game(ManaPaidThisWay)), $entry_face_pt_counter]}]) */
paid_mana_entry_counters ::= "that" "creature" "enters" "with" "that" "many" "additional" entry_face_pt_counter "counters" "on" "it"

/* A spell's cast origin and its historical mana-value ceiling are independent
   operands; the where-clause defines the value used by the spell filter. */
/* @sem Ability::Conditional{condition:PlayerIsActive(AbilityController), then:[$static_history_spell_grant]} */
static_history_spell_grant_during_turn ::= "during" "your" "turn" "," static_history_spell_grant

/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Stack), kind:Spell, filter:@and($history_cast_filter, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:$history_threshold_comparison, value:$history_life_total}})}), changes:[GrantAbility(@holder($spell_mechanic))]} */
static_history_spell_grant ::= history_cast_filter "with" "mana" "value" "X" history_threshold_comparison "have" spell_mechanic "," "where" "X" "is" history_life_total "."

/* @sem ObjectFilter::Cast{by:One(AbilityController), from:$history_cast_origin} */
history_cast_filter ::= "spells" "you" "cast" "from" history_cast_origin

history_cast_origin ::= history_cast_hand | cast_origin_graveyard | cast_origin_exile

/* @sem ZoneScope::Players{zone:Hand, players:One(AbilityController)} */
history_cast_hand ::= "your" "hand"

/* @sem Comparison::LessOrEqual */
history_threshold_less ::= "or" "less"

/* @sem Comparison::GreaterOrEqual */
history_threshold_more ::= "or" "more"

history_threshold_comparison ::= history_threshold_less | history_threshold_more

/* The named granting permanent remains distinct from the emblem holder. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$emblem_granting_exile_cards, from:Exile, action:Either, filter:Any}, terms:_{cost:Normal, spend_as:$emblem_spending_kind}})]}) */
emblem_play_linked_any_color ::= "you" "may" "play" emblem_granting_exile_cards "," "and" "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" emblem_spending_kind "to" "cast" "those" "spells" "."

/* @sem SpendAs::AnyColor */
emblem_spending_color ::= "any" "color"

/* @sem SpendAs::AnyType */
emblem_spending_type ::= "any" "type"

emblem_spending_kind ::= emblem_spending_color | emblem_spending_type

/* The permission belongs to the ability's controller; the filtered objects
   remain the independent owners of the loyalty abilities. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(ActivationGrant{abilities:AllOf([OnStack(Loyalty), AbilityOf($filter_plural)]), grant:InstantSpeedDuring(All)})]} */
loyalty_activation_permission ::= "you" "may" "activate" "loyalty" "abilities" "of" filter_plural "on" "any" "player's" "turn" "any" "time" "you" "could" "cast" "an" "instant" "."

/* The restriction and the payment are separate phrases. Both player references
   are the enchanted creature's controller, not the Aura's controller. */
/* @sem Ability::PayToIgnore{subjects:Objects(One($enchanted_creature_ref)), rules:$host_combat_activation_restrictions, payer:ControllerOf(AttachedTo(Source)), cost:$host_controller_graveyard_exile_cost, until:EndOfTurn} */
pay_to_ignore_host_restrictions ::= enchanted_creature_ref host_combat_activation_restrictions "." "its" "controller" "may" host_controller_graveyard_exile_cost "for" "that" "player" "to" "ignore" "this" "effect" "until" "end" "of" "turn" "."

/* @sem Operand::List([$host_cant_attack, $host_cant_block, $host_abilities_cant_activate]) */
host_combat_activation_restrictions ::= host_cant_attack "or" host_cant_block "," "and" host_abilities_cant_activate

/* @sem Operand::Term{family:PermanentRule, form:CantAttack} */
host_cant_attack ::= "can't" "attack"

/* @sem Operand::Term{family:PermanentRule, form:CantBlock} */
host_cant_block ::= "block"

/* @sem Operand::Term{family:PermanentRule, form:AbilitiesCantBeActivated} */
host_abilities_cant_activate ::= "its" "activated" "abilities" "can't" "be" "activated"

/* A condition and the card's graveyard location scope its flashback permission. */
/* @sem Ability::Scoped{zones:[Graveyard], condition:$condition, ability:$keyword_flashback} */
conditional_graveyard_flashback ::= "as" "long" "as" condition "and" "this" "card" "is" "in" "your" "graveyard" "," "it" "has" keyword_flashback "."

/* Plural populations receive a temporary stat bonus and a keyword together. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($affected_plural), changes:[...$plural_pump_change, ...$plural_gain_change], duration:$duration, evaluation:Snapshot} */
continuous_plural_pump_grant ::= affected_plural plural_pump_change "and" plural_gain_change duration

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}] */
plural_pump_change ::= "get" signed "/" signed

/* @sem Change::[GrantKeyword($keyword_value)] */
plural_gain_change ::= "gain" keyword_value

/* The affected batch of the preceding action retains its result identity. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Affected(@prior)), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot} */
prior_creatures_pump ::= "those" "creatures" "get" signed "/" signed duration

/* A targeting exception applies separately to players and controlled permanents. */
/* @sem Ability::[Static{kind:Ordinary, affected:Players($permission_players), changes:[PlayerRule(TargetableDespite{sources:ControlledBy(One(AbilityController)), keyword:$permission_keyword})]}, Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([ControlledBy($permission_controllers), HasKeywordFamily($permission_keyword)])}), changes:[Rule(TargetableDespite{sources:ControlledBy(One(AbilityController)), keyword:$permission_keyword})]}] */
line_targeting_permission ::= permission_players "and" "permanents" permission_controllers "control" permission_keyword "."

permission_players ::= player_keyword_many | hexproof_you

permission_controllers ::= player_keyword_many | permission_you

/* @sem PlayerSet::One(AbilityController) */
permission_you ::= "you"

permission_keyword ::= permission_hexproof

/* @sem KeywordFamily::Hexproof */
permission_hexproof ::= "with" "hexproof" "can" "be" "the" "targets" "of" "spells" "and" "abilities" "you" "control" "as" "though" "they" "didn't" "have" "hexproof"

/* A target's temporary changes and its separately created combat trigger. */
/* @sem Ability::Spell{body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($controlled_subtype_target)), changes:[Pump{power:$signed, toughness:$signed_2}, GrantKeyword($keyword_name)], duration:EndOfTurn, evaluation:Snapshot}}, Effect{result:@next, operation:CreateTrigger{event:Damage{source_kind:Permanent, sources:SameObject($controlled_subtype_target), recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source}, duration:EndOfTurn, body:$combat_exile_play_program, announcement:_{}}}]}, announcement:@announcement} */
spell_controlled_target_combat_program ::= controlled_subtype_target "gets" signed "/" signed "and" "gains" keyword_name "until" "end" "of" "turn" "." "whenever" "it" "deals" "combat" "damage" "to" "a" "player" "this" "turn" "," combat_exile_play_program

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$subtype, ControlledBy(One(AbilityController))])}), index:0} */
controlled_subtype_target ::= "target" subtype "you" "control"

/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($blocked_controlled_target)), changes:[Pump{power:$signed, toughness:$signed_2}, GrantKeyword($keyword_name), GrantAbility(@scope(Ability::Triggered{event:Damage{source_kind:Permanent, sources:SameObject(Source), recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source}, limits:_{}, announcement:@announcement, body:$combat_look_exile_cast_program}))], duration:$duration, evaluation:Snapshot}}]}} */
spell_blocked_target_granted_combat ::= duration "," blocked_controlled_target "gets" signed "/" signed "and" "gains" keyword_name "and" '"' "whenever" "this" "creature" "deals" "combat" "damage" "to" "a" "player" "," combat_look_exile_cast_program '"'

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([State(Blocked), $noun, ControlledBy(One(AbilityController))])}), index:0} */
blocked_controlled_target ::= "target" "blocked" noun "you" "control"

/* The scry event supplies the number of cards looked at by that event. */
/* @sem Ability::Triggered{event:$event_you_scry, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:@times($value, Expr::EventAmount), toughness:@times($value_2, Expr::EventAmount)}], duration:$duration, evaluation:Snapshot}}]}} */
triggered_scry_count_pump ::= "whenever" event_you_scry "," affected "gets" "+" value "/" "+" value duration "for" "each" "card" "looked" "at" "while" "scrying" "this" "way" "."

/* The comparison consumes the immediately preceding captured quantity. */
/* @sem Instruction::[Effect{result:@next, operation:$count_counter_population}, Effect{result:@next, operation:$counter_comparison_effect}] */
instructions_count_counter_comparison ::= count_counter_population "." counter_comparison_effect

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, Property{property:$stat, test:NumberTest::Compare{comparison:$stat_comparison, value:BoundValue(@prior)}}])}), changes:$static_changes, duration:$this_duration, evaluation:LiveObjects} */
counter_comparison_effect ::= filter_plural "with" stat stat_comparison "that" "number" static_changes this_duration

copy_prefix_exceptions ::= copy_land_with_keyword | copy_vehicle_artifact_retained | copy_artifact_retained | copy_stats_vehicle_keyword

/* @sem Vec<CopyException>::[CopyException::AddArtifactTypes([Vehicle]), CopyException::AddCardTypes([Artifact])] */
copy_vehicle_artifact_retained ::= "it's" "a" "Vehicle" "artifact" "in" "addition" "to" "its" "other" "types"

/* The attacking population excludes the triggering subject and snapshots at resolution. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(EventSubject)), $noun, AttackingDefender(Players(OpponentsOf(AbilityController)))])}), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot}}] */
instructions_other_attacking_pump ::= "each" "other" noun "that's" "attacking" "one" "of" "your" "opponents" "gets" signed "/" signed duration

/* A counter recipient is also the attacker and recipient of the delayed grant. */
/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0})), kind:$counter_kind, amount:Constant(1)}]}}, Effect{result:@next, operation:CreateTrigger{event:Attack{attackers:SameObject(Target{slot:0, index:0}), defenders:Players(One(Holder(Monarch)))}, duration:EndOfTurn, body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:0, index:0})), changes:[GrantKeyword($keyword_name), GrantKeyword($keyword_name_2)], duration:EndOfTurn, evaluation:Snapshot}}]}, announcement:_{}}}] */
clause_counter_monarch_attack ::= "put" "a" counter_kind "counter" "on" "target" "creature" "." "whenever" "that" "creature" "attacks" "the" "monarch" "this" "turn" "," "it" "gains" keyword_name "and" keyword_name "until" "end" "of" "turn"

/* A union keeps the first population independent of the source exclusion on the second. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([$filter_plural, $entry_other_controlled])} */
affected_union_with_other_controlled ::= filter_plural "and" entry_other_controlled

/* A quoted limited trigger composes its event, program and per-turn limit. */
/* @sem Ability::Triggered{event:$quoted_turn_filtered_event, limits:_{per_turn:1}, announcement:@announcement, body:$program_sentence} */
quoted_turn_limited_trigger ::= quoted_turn_filtered_event "," program_sentence "this" "ability" "triggers" "only" "once" "each" "turn" "."

quoted_turn_filtered_event ::= quoted_whenever_during_your_turn | quoted_when_during_your_turn

/* @sem EventSpec::Filtered{event:$event_whenever, condition:PlayerIsActive(AbilityController)} */
quoted_whenever_during_your_turn ::= event_whenever "during" "your" "turn"

/* @sem EventSpec::Filtered{event:$event_when, condition:PlayerIsActive(AbilityController)} */
quoted_when_during_your_turn ::= event_when "during" "your" "turn"

/* Separate permissions share the affected player's other-player graveyard scope. */
/* @sem Change::[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:OthersThan(Affected)}, kind:Card, filter:Any}), from:Graveyard, action:PlayLand, filter:Any}, terms:_{cost:Normal}})] */
other_graveyards_land_permission ::= "play" "lands"

/* @sem Change::[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:OthersThan(Affected)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:Any}, terms:_{cost:Normal}})] */
other_graveyards_spell_permission ::= "cast" "spells"

/* @sem Change::[...$other_graveyards_land_permission, ...$other_graveyards_spell_permission] */
other_graveyards_both_permissions ::= other_graveyards_land_permission "and" other_graveyards_spell_permission

other_graveyards_permissions ::= other_graveyards_both_permissions | other_graveyards_land_permission | other_graveyards_spell_permission

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:$other_graveyards_permissions, duration:$this_duration, evaluation:LiveObjects} */
other_graveyards_temporary_permission ::= "you" "may" other_graveyards_permissions "from" "other" "players'" "graveyards" this_duration "as" "though" "those" "cards" "were" "in" "your" "graveyard"

/* A static grant can operate while the granting spell is on the stack. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[$grant_quoted_activation]} */
static_population_has_quoted_activation ::= affected "has" grant_quoted_activation

/* @sem Ability::Scoped{zones:[Stack], ability:$static_population_has_quoted_activation} */
stack_scoped_population_activation ::= "as" "long" "as" SELF_NAME "is" "on" "the" "stack" "," static_population_has_quoted_activation

/* The linked choice and copy consume the same source and choice receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([$noun_atomic, InSet(Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}))])}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreateContinuousEffect{source:$object_ref, affected:Objects($affected), changes:[CopyOf{object:Result{result:@prior, phase:After, index:0}, exceptions:[]}], duration:Indefinite, evaluation:Snapshot}}] */
instructions_copy_linked_card ::= affected "becomes" "a" "copy" "of" "a" noun_atomic "card" "exiled" "with" object_ref

/* A perpetual change applies to the current matching cards in your graveyard. */
/* @sem Instruction::[Effect{result:@next, operation:CreatePerpetualEffect{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), changes:$static_changes}}] */
clause_each_graveyard_card_perpetual ::= "each" filter_phrase "card" "in" "your" "graveyard" "perpetually" static_changes

/* Shared graveyard populations keep their owner, filter, and exclusion. */
/* @sem Expr::CountObjects($defining_graveyard_population) */
defining_graveyard_count ::= "the" "number" "of" defining_graveyard_population

/* @sem Expr::CountManaSymbols{objects:$defining_graveyard_population, colors:[$mana_color_word]} */
defining_graveyard_symbols ::= "the" "number" "of" mana_color_word "mana" "symbols" "in" "the" "mana" "costs" "of" defining_graveyard_population

defining_graveyard_population ::= defining_your_graveyard_cards | defining_your_graveyard_other_cards | defining_opponents_graveyard_cards | defining_opponents_graveyard_filtered_cards

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any} */
defining_your_graveyard_cards ::= "cards" "in" "your" "graveyard"

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, Not(SameObject(Source))])} */
defining_your_graveyard_other_cards ::= "other" filter_phrase "cards" "in" "your" "graveyard"

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:OpponentsOf(AbilityController)}, kind:Card, filter:Any} */
defining_opponents_graveyard_cards ::= "cards" "in" "your" "opponents'" "graveyards"

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:OpponentsOf(AbilityController)}, kind:Card, filter:$filter_phrase} */
defining_opponents_graveyard_filtered_cards ::= filter_phrase "cards" "in" "your" "opponents'" "graveyards"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun, ControlledBy(One(AbilityController))])} */
affected_controlled_each_noun ::= "each" noun "you" "control"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$adjective_nontype, ControlledBy(One(AbilityController))])} */
affected_controlled_each_nontype ::= "each" adjective_nontype "permanent" "you" "control"

/* @sem Change::[Colors{mode:Set, colors:[White, Blue, Black, Red, Green]}] */
controlled_each_all_colors ::= "all" "colors"

/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word]}] */
controlled_each_one_color ::= mana_color_word

controlled_each_color_value ::= controlled_each_all_colors | controlled_each_one_color

/* @sem $controlled_each_color_value */
controlled_each_color_set ::= "is" controlled_each_color_value

/* The named source grants an other-spell reduction while in either zone. */
/* @sem ObjectFilter::AllOf([Not(SameObject($self_ref_named)), $cast_kind_spells]) */
command_zone_other_spells ::= "as" "long" "as" self_ref_named "is" "in" "the" "command" "zone" "or" "on" "the" "battlefield" "," "other" cast_kind_spells

/* @sem Ability::Scoped{zones:[Command, Battlefield], ability:Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$command_zone_other_spells, modifier:$spell_cost_change})]})} */
command_zone_other_spell_cost ::= command_zone_other_spells "you" "cast" "cost" spell_cost_change "to" "cast" "."

/* A graveyard permission with a composed additional payment. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$graveyard_cast_phrase, from:Graveyard, action:CastSpell, filter:Any}, terms:_{cost:Additional(Cost{parts:$cast_life_and_additional_parts})}})]})} */
static_graveyard_cast_composed_cost ::= graveyard_cast_phrase "by" cast_life_and_additional_parts "in" "addition" "to" "paying" "its" "other" "costs" "."

/* A draft-linked population and the copied keyword list are independent operands. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[GainAbilitiesOf{objects:$draft_removed_flying_cards, kinds:$draft_shared_keyword_list}]}) */
static_draft_shared_keywords ::= draft_removed_flying_cards "," affected "has" "flying" "." "the" "same" "is" "true" "for" draft_shared_keyword_list "."

draft_removed_flying_cards ::= draft_removed_flying_a | draft_removed_flying_an

/* @sem ObjectSet::OutsideTheGame(AllOf([$filter_phrase, DraftNoted(_{kind:Removed, player:AbilityController, card:@card_name})])) */
draft_removed_flying_a ::= "if" "you" "removed" "a" filter_phrase "card" "with" "flying" "from" "the" "draft" "with" "cards" "named" SELF_NAME

/* @sem ObjectSet::OutsideTheGame(AllOf([$filter_phrase, DraftNoted(_{kind:Removed, player:AbilityController, card:@card_name})])) */
draft_removed_flying_an ::= "if" "you" "removed" "an" filter_phrase "card" "with" "flying" "from" "the" "draft" "with" "cards" "named" SELF_NAME

/* @sem Operand::List([Term{family:CheckHasable, form:Flying}, Term{family:CheckHasable, form:FirstStrike}, Term{family:CheckHasable, form:DoubleStrike}, Term{family:CheckHasable, form:Deathtouch}, Term{family:CheckHasable, form:Haste}, Term{family:CheckHasable, form:AnyHexproof}, Term{family:CheckHasable, form:Indestructible}, Term{family:CheckHasable, form:Lifelink}, Term{family:CheckHasable, form:Menace}, Term{family:CheckHasable, form:Reach}, Term{family:CheckHasable, form:Vigilance}]) */
draft_shared_keyword_list ::= "first" "strike" "," "double" "strike" "," "deathtouch" "," "haste" "," "hexproof" "," "indestructible" "," "lifelink" "," "menace" "," "reach" "," "and" "vigilance"

/* Two separately quoted grants retain independent ability scopes on the same holder. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[$shared_granted_activation_open, $shared_granted_trigger_closed]} */
static_shared_activation_trigger ::= affected "has" shared_granted_activation_open "and" shared_granted_trigger_closed

/* A colored subtype form supplies independent color, subtype and base stats. */
/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word]}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, AddCardType(Creature), SetBasePowerToughness{power:$number_digits, toughness:$number_digits_2}] */
colored_subtype_form_stats ::= "is" "a" mana_color_word becomes_types "with" "base" "power" "and" "toughness" number_digits "/" number_digits

/* The goad rule applies separately to the same affected object. */
/* @sem Ability::[Static{kind:Ordinary, affected:Objects($affected), changes:[...$colored_subtype_form_stats, ...$grants]}, Static{kind:Ordinary, affected:Objects($affected), changes:$change_is_goaded}] */
static_form_grants_goad ::= affected colored_subtype_form_stats "," "has" grants "," "and" change_is_goaded "."

/* A once-per-turn permission is a special action; its callback follows that action. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpecialAction{body:Program{instructions:[Effect{result:@next, operation:WithReflexive{action:$top_play_or_cast_action, when:YouDo, body:Program($program)}}]}, limit:EachTurn(1)})]}) */
static_once_each_turn_top_action_reflexive ::= "once" "each" "turn" "," "you" "may" top_play_or_cast_action "." "when" "you" "do" "," program "."

/* Each arm has its own filter, and spell casting excludes lands. */
/* @sem Operation::PlayWith{actor:One(AbilityController), action:Either, cards:Matching{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, filter:AnyOf([$filter_phrase, AllOf([Not(CardType(Land)), $top_spell_filter])])}, count:Exactly($counter_amount), terms:_{cost:Normal}} */
top_play_or_cast_action ::= "play" counter_amount filter_phrase "or" "cast" "a" top_spell_filter "spell" "from" "the" "top" "of" "your" "library"

top_spell_filter ::= adjective_historic | adjective_legendary | adjective_color

/* @sem Change::[...$top_permissions] */
top_play_permissions_normal ::= "you" "may" top_permissions "from" "the" "top" "of" "your" "library"

/* The alternative applies to spells cast under this particular permission. */
/* @sem Change::[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, from:Library, action:Either, filter:Any}, terms:_{cost:Alternate(Cost{parts:[$top_spell_alternative_cost]})}})] */
top_play_permissions_life ::= "you" "may" "play" "cards" "from" "the" "top" "of" "your" "library" "." top_spell_alternative_cost

/* @sem CostPart::LifeEqualToOwnManaValue */
top_spell_alternative_cost ::= "if" "you" "cast" "a" "spell" "this" "way" "," "pay" "life" "equal" "to" "its" "mana" "value" "rather" "than" "pay" "its" "mana" "cost"

/* The exile replacement applies to the spell granted by this permission. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:$graveyard_permission_spell_filter}, terms:_{limit:EachTurn(1), during:One(AbilityController), cost:Additional(List([Program($cast_sacrificing_permanent)])), into_exile:true}})]}) */
static_once_graveyard_cast_sacrifice_exile ::= "once" "during" "each" "of" "your" "turns" "," "you" "may" "cast" "an" graveyard_permission_spell_filter "spell" "from" "your" "graveyard" "by" cast_sacrificing_permanent "in" "addition" "to" "paying" "its" "other" "costs" "." "if" "a" "spell" "cast" "this" "way" "would" "be" "put" "into" "your" "graveyard" "," "exile" "it" "instead" "."

graveyard_permission_spell_filter ::= card_filter | filter_instant_or_sorcery

/* A final quoted ability supplies the sentence's closing period. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[...$change_pump, ...$closed_trigger_grants]} */
static_pump_and_closed_grants ::= affected change_pump "and" "has" closed_trigger_grants

closed_trigger_grants ::= closed_trigger_grant | closed_trigger_grants_more

/* @sem Change::[$grant, ...$closed_trigger_grants] */
closed_trigger_grants_more ::= grant "," "and"? closed_trigger_grants

/* @sem Change::[$closed_trigger_grant_item] */
closed_trigger_grant ::= closed_trigger_grant_item

/* @sem Change::GrantAbility(@holder($combat_creature_recipient_exile_trigger)) */
closed_trigger_grant_item ::= '"' combat_creature_recipient_exile_trigger '"'

/* A shared threshold applies to both members of the controlled union. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([AnyOf([$filter_phrase, $filter_phrase_2]), ControlledBy(One(AbilityController)), $modifier_mana_value_bound])} */
affected_controlled_pair_mana_bound ::= "each" filter_phrase "and" filter_phrase "you" "control" modifier_mana_value_bound

/* This singular animation retains other types, and its three changes remain independent. */
/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Creature)] */
change_retained_typed_creature_stats ::= "is" "a" value "/" value becomes_types "creature" "in" "addition" "to" "its" "other" "types"

/* A final quoted ability supplies the enclosing sentence's period. */
/* @sem Ability::Conditional{condition:$static_turn_window, then:[Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes_closed})]} */
static_during_turn_closed ::= static_turn_window "," affected static_changes_closed

/* Redirected deaths and the resulting hand restriction share a replacement frame. */
/* @sem Ability::Replacement{active:Battlefield, event:$hand_return_death_event, body:Program{instructions:[Effect{result:@next, operation:$hand_return_redirect}, Effect{result:@next, operation:$hand_arrival_restriction}]}} */
replacement_death_hand_with_rule ::= "if" hand_return_death_event "," hand_return_redirect "." hand_arrival_restriction "."

/* @sem EventSpec::ZoneChange{objects:$die_exile_objects, from:Battlefield, to:Graveyard} */
hand_return_death_event ::= die_exile_objects "would" "die"

/* @sem Operation::ModifyEvent{change:SetDestination(OwnersHand)} */
hand_return_redirect ::= "return" "it" "to" "its" "owner's" "hand" "instead"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(OwnerOf(Query{objects:InZone{objects:One(EventDestination), zone:Hand}, index:0}))), changes:[PlayerRule(Visibility{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Hand}, index:0}), audience:Everyone}), PlayerRule(Prohibit(PlayCard(SameObject(Query{objects:InZone{objects:One(EventDestination), zone:Hand}, index:0}))))], duration:UntilNextTurn(OwnerOf(Query{objects:InZone{objects:One(EventDestination), zone:Hand}, index:0})), evaluation:LiveObjects} */
hand_arrival_restriction ::= "until" "that" "player's" "next" "turn" "," "that" "player" "plays" "with" "that" "card" "revealed" "in" "their" "hand" "and" "can't" "play" "it"

/* A replacement active everywhere redirects this source from its stated origin. */
/* @sem Ability::Replacement{active:Everywhere, event:ZoneChange{objects:SameObject(Source), from:$hand_return_origin, to:Graveyard}, body:Program{instructions:[Effect{result:@next, operation:$hand_return_redirect}, Effect{result:@next, operation:$hand_arrival_restriction}]}} */
replacement_source_zone_hand_with_rule ::= "if" "this" "card" "would" "be" "put" "into" "a" "graveyard" "from" hand_return_origin "," hand_return_redirect "." hand_arrival_restriction "."

hand_return_origin ::= hand_return_from_library | hand_return_from_exile

/* @sem Zone::Library */
hand_return_from_library ::= "a" "library"

/* @sem Zone::Exile */
hand_return_from_exile ::= "exile"

/* The controller restriction applies to both members of the type union. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$entry_opponents_union} */
affected_opponents_union ::= entry_opponents_union

/* A limited graveyard permission can grant a replacement ability to the played object. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:Any}), from:Graveyard, action:Either, filter:$graveyard_play_or_cast_filter}, terms:_{limit:EachTurn(1), during:One(AbilityController), cost:Normal, effects:[List([Term{family:SpellEffect, form:AddAbility, operands:[Ability($graveyard_play_granted_replacement)]}])]}})]}) */
static_graveyard_play_grant ::= "once" "during" "each" "of" "your" "turns" "," "you" "may" graveyard_play_or_cast_filter "from" "your" "graveyard" "." "if" "you" "do" "," "it" "gains" '"' graveyard_play_granted_replacement '"'

/* @sem ObjectFilter::AnyOf([$filter_phrase, AllOf([$filter_phrase_2, AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)])])]) */
graveyard_play_or_cast_filter ::= "play" "a" filter_phrase "or" "cast" "a" filter_phrase "spell"

/* Land-play permission keeps the outside population and cost independent. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:OutsideTheGame($outside_play_lands), from:Outside, action:PlayLand, filter:Any}, terms:_{cost:Normal}})], duration:EndOfTurn, evaluation:LiveObjects}}] */
outside_land_play_this_turn ::= "this" "turn" "," "you" "may" "play" outside_play_lands "from" "outside" "the" "game"

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:$outside_land_play_this_turn}} */
activated_outside_land_play ::= cost ":" outside_land_play_this_turn "."

/* @sem ObjectFilter::CardType(Land) */
outside_play_lands_plain ::= "lands"

/* @sem @and($quality, ObjectFilter::CardType(Land)) */
outside_play_lands_qualified ::= quality "lands"

outside_play_lands ::= outside_play_lands_plain | outside_play_lands_qualified

/* A spell's ordinal, target population and colored reduction are independent. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$targeted_ordered_spell, modifier:Reduce{reductions:$colored_cost_reductions}})]}) */
static_targeted_ordered_colored_cost ::= targeted_ordered_spell "costs" colored_cost_reductions "less" "to" "cast" "." "this" "effect" "reduces" "only" "the" "amount" "of" "colored" "mana" "you" "pay" "."

/* @sem ObjectFilter::NthCast{ordinal:$cast_order, spells:TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase})), by:One(AbilityController), scope:Turn} */
targeted_ordered_spell ::= "the" cast_order "spell" "you" "cast" "during" "each" "of" "your" "turns" "that" "targets" ("a" | "an") filter_phrase

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellTiming{spells:$enchant_qualified_spells, timing:Flash})]}) */
static_enchant_spells_flash ::= "you" "may" "cast" enchant_qualified_spells "as" "though" "they" "had" "flash" "."

/* @sem ObjectFilter::AllOf([$filter_phrase, CouldEnchant(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase_2})]) */
enchant_qualified_spells ::= filter_phrase "spells" "with" "enchant" filter_phrase

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(KeywordCost{keyword:Crew, cards:SameObject($object_ref), change:Alternate(Cost{parts:[$affected_counter_payment]})})]}) */
static_crew_counter_alternative ::= "you" "may" affected_counter_payment "rather" "than" "pay" object_ref "'s" "crew" "cost" "."

/* The explicitly named source provides the ordinary self-reference print. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(KeywordCost{keyword:Crew, cards:SameObject($self_ref_named), change:Alternate(Cost{parts:[$affected_counter_payment]})})]}) */
static_named_crew_counter_alternative ::= "you" "may" affected_counter_payment "rather" "than" "pay" self_ref_named "'s" "crew" "cost" "."

/* The first player introduces the target; the second reference is resolved in context. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players($players_singular), changes:[PlayerRule(Prohibit(CastSpell{filter:Any})), PlayerRule(Prohibit(Activate(Any))), PlayerRule(Visibility{objects:Zone(_{scope:Players{zone:Hand, players:One(Affected)}, kind:Card, filter:Any}), audience:Everyone})], duration:EndOfTurn, evaluation:LiveObjects}}] */
chosen_player_hand_restriction ::= "choose" players_singular "." "this" "turn" "," "that" "player" "can't" "cast" "spells" "or" "activate" "abilities" "and" "plays" "with" "their" "hand" "revealed"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Hand, players:One($zone_that_player)}, kind:Card, filter:Any}), from:Hand, action:PlayLand, filter:Any}, terms:_{cost:Normal}}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Hand, players:One($zone_that_player)}, kind:Card, filter:Any}), from:Hand, action:CastSpell, filter:Any}, terms:_{cost:Normal}})], duration:EndOfTurn, evaluation:LiveObjects}}] */
clause_play_referenced_hand ::= "you" "may" "play" "lands" "and" "cast" "spells" "from" zone_that_player "hand" "this" "turn"

/* A keyword and a quoted trigger are independent changes to one holder. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[GrantKeyword($keyword_value), $shared_granted_trigger_closed]} */
shared_keyword_and_trigger_static ::= affected "has" keyword_value "and" shared_granted_trigger_closed

/* A captured definition drives a temporary reduction on the selected spells. */
/* @sem Instruction::[Effect{result:@mark, operation:BindValue{value:$captured_spell_cost_value}}, Effect{result:@next, operation:EffectOn{subject:EachSpell(@and(ObjectFilter::Cast{by:One(AbilityController)}, ObjectFilter::Cast{from:$cast_origin})), effects:[Term{family:SpellEffect, form:DecreaseManaCostX, operands:[List([Vocabulary{family:CostReductionSymbolX, form:CostReduceX}]), Number(BoundValue(@marked))]}], until:EndOfTurn}}] */
clause_captured_exile_cast_reduction ::= "spells" "you" "cast" "from" cast_origin "this" "turn" "cost" "{" "X" "}" "less" "to" "cast" "," "where" "X" "is" captured_spell_cost_value

captured_spell_cost_value ::= defined_attacked_players | value

/* The limit belongs to each granted trigger and its holder. */
/* @sem Change::GrantAbility(@scope(Ability::Triggered{event:$event_clause, limits:_{per_turn:2}, announcement:@announcement, body:$program})) */
shared_granted_trigger_twice ::= '"' event_clause "," program "." "this" "ability" "triggers" "only" "twice" "each" "turn" "." '"'

/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[$shared_granted_trigger_twice]} */
static_plural_granted_trigger_twice ::= affected "have" shared_granted_trigger_twice

/* @sem ObjectSet::Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter} */
each_card_in_your_hand ::= "each" card_filter "card" "in" "your" "hand"

/* @sem ObjectSet::Zone{scope:Players{zone:Hand, players:All}, kind:Card, filter:$card_filter} */
each_card_in_each_players_hand ::= "each" card_filter "card" "in" "each" "player's" "hand"

/* The alternative foretell payment belongs to the controller's first card. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(KeywordCost{keyword:Foretell, cards:Any, change:Alternate($first_foretell_payment), first_each_turn:true})]}) */
first_foretell_alternative ::= "the" "first" "card" "you" "foretell" "each" "turn" "costs" first_foretell_payment "to" "foretell" "."

/* @sem Operand::Term{family:ManaSymbol, form:ManaCostGeneric, operands:[Integer($number)]} */
first_foretell_payment ::= "{" NUMBER "}"

/* A pump and a granted activation with its own cost and limits. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[Pump{power:$signed, toughness:$signed_2}, GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:$granting_object_exile_cost, limits:$limit_holder_power_reduction_sorcery, announcement:@announcement, body:$granted_explicit_player_program}))]} */
static_pump_grant_limited_exile ::= affected "gets" signed "/" signed "and" "has" '"' granting_object_exile_cost ":" granted_explicit_player_program "." limit_holder_power_reduction_sorcery "." '"'

/* Explicit controller wording in a granted activation. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$player_action_base}]} */
granted_explicit_player_program ::= "you" player_action_base

/* The equipped ability belongs to each affected permanent. */
/* @sem Change::GrantAbility(@holder($keyword_equip)) */
grant_equipment_keyword ::= keyword_equip

/* The population and its origin are shared by all three permissions. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:$own_cast_zone, players:One(AbilityController)}, kind:Card, filter:$permission_history}), from:$own_cast_zone, action:PlayLand, filter:Any}, terms:_{cost:Normal}}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:$own_cast_zone, players:One(AbilityController)}, kind:Card, filter:$permission_history}), from:$own_cast_zone, action:CastSpell, filter:Any}, terms:_{cost:Normal}}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:$own_cast_zone, players:One(AbilityController)}, kind:Card, filter:$permission_history}), from:$own_cast_zone, action:CastSpell, filter:Any}, terms:_{cost:Alternate(Cost{parts:[$permission_alternate_cost]})}})]}) */
static_history_lands_spells ::= "you" "may" "play" "lands" "and" "cast" "spells" "from" "among" "cards" "in" own_cast_zone permission_history "." "if" "you" "cast" "a" "spell" "this" "way" "," "you" permission_alternate_cost "."

permission_history ::= permission_surveilled_history | drawn_cards_history

/* @sem ObjectFilter::History{event:Surveilled, window:ThisTurn} */
permission_surveilled_history ::= "you've" "surveilled" "this" "turn"

/* @sem CostPart::LifeEqualToOwnManaValue */
permission_alternate_cost ::= "pay" "life" "equal" "to" "its" "mana" "value" "rather" "than" "paying" "its" "mana" "cost"

/* The grant refers to the creature arriving from this specific choice and move. */
/* @sem Instruction::[...$opponent_choice_creature_entry, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:$grants, duration:Indefinite, evaluation:Snapshot}}] */
clause_opponent_choice_entry_grant ::= opponent_choice_creature_entry "." "that" "creature" "gains" grants

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$target_opponent, objects:Zone{scope:Players{zone:Graveyard, players:One($target_opponent)}, kind:Card, filter:CardType(Creature)}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}] */
opponent_choice_creature_entry ::= target_opponent "puts" "a" "creature" "card" "of" "their" "choice" "from" "their" "graveyard" "onto" "the" "battlefield" "under" "your" "control"

/* @sem Operand::Term{family:SpellEffect, form:Cascade} */
first_spell_effect_cascade ::= "cascade"

/* The unqualified first spell and its granted effect are independent of the
   threshold-qualified form above. */
/* @sem Ability::Conditional{condition:PlayerIsActive(AbilityController), then:[Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellsHaveAbilities{spells:Any, nth_each_turn:Constant(1), abilities:List([$first_spell_effect])})]})]} */
first_unqualified_spell_turn_grant ::= "the" "first" "spell" "you" "cast" "during" "each" "of" "your" "turns" "has" first_spell_effect "."

/* @sem Operand::Term{family:SpellEffect, form:Assist} */
first_spell_effect_assist ::= "assist"

/* @sem Change::GrantAbility(@scope(Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$draw_discard_property_program})) */
shared_draw_discard_trigger_closed ::= '"' event_clause "," draw_discard_property_program "." '"'

/* @sem Change::GrantAbility(@scope(Ability::Triggered{event:Object{event:Attacks, objects:SameObject(Source)}, limits:_{}, announcement:@announcement, body:$shared_defender_graveyard_copy_program})) */
shared_defender_copy_trigger_closed ::= '"' "whenever" "this" "creature" "attacks" "," shared_defender_graveyard_copy_program "." '"'

/* The returned incarnation is shared by the grant, delayed exile, and
   replacement; the complete move anchors every reference in both directions. */
/* @sem Instruction::[Effect{result:@mark, operation:$post_grant_move}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@marked, phase:After, index:0})), changes:$grants, duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@marked, phase:After, index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}, Effect{result:@next, operation:CreateReplacement{event:Object{event:LeavesBattlefield, objects:SameObject(Result{result:@marked, phase:After, index:0})}, limit:NextOccurrence, duration:EndOfTurn, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}}}] */
clause_post_move_grant_delayed_exile_replacement ::= post_grant_move "." "it" "gains" grants "." "exile" "it" "at" "the" "beginning" "of" "the" "next" "end" "step" "." "if" "it" "would" "leave" "the" "battlefield" "," "exile" "it" "instead" "of" "putting" "it" "anywhere" "else"

/* Any event clause may frame the scoped move-and-followups program. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$clause_post_move_grant_delayed_exile_replacement}} */
triggered_post_move_grant_delayed_exile ::= event_clause "," clause_post_move_grant_delayed_exile_replacement "."

/* The land subject proves the retained land type; the two statistics and
   the duration remain independent operands of the continuous effect. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Land), ControlledBy(One(AbilityController))])}), changes:[SetBasePowerToughness{power:$value, toughness:$value_2}, AddCardType(Creature)], duration:$duration, evaluation:Snapshot} */
controlled_lands_retained_animation ::= duration "," "lands" "you" "control" "become" value "/" value "creatures" "that" "are" "still" "lands"

/* Implied spell-or-permanent target alternatives share a modal wrapper. */
/* @sem @scope(Mode::Mode{body:Program{}, weight:1, announcement:Announcement{modes:$word_replacement_choice}}) */
word_replacement_mode ::= "•" word_replacement_choice "."

word_replacement_choice ::= word_replacement_creature_type_except_choice | word_replacement_land_choice | word_replacement_land_explicit | word_replacement_color_choice

/* @sem ModeSelection::_{count:_{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{body:_{instructions:[Effect{result:@next, operation:ChooseValue(_{choosers:One(AbilityController), kind:BasicLandType, terms:_{count:Exactly(Constant(2))}})}, Effect{result:@next, operation:ChangeSpell{subject:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:$stack_spell_filter}), index:0}), changes:[ReplaceWord{from:Vocabulary{family:LandTypeWord, form:TheFirstChosenLandType}, to:Vocabulary{family:LandTypeWord, form:TheSecondChosenLandType}}]}}]}, weight:1, announcement:@announcement}), @scope(Mode::Mode{body:_{instructions:[Effect{result:@next, operation:ChooseValue(_{choosers:One(AbilityController), kind:BasicLandType, terms:_{count:Exactly(Constant(2))}})}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_phrase}), index:0})), changes:[ReplaceWord{from:Vocabulary{family:LandTypeWord, form:TheFirstChosenLandType}, to:Vocabulary{family:LandTypeWord, form:TheSecondChosenLandType}}], duration:Indefinite, evaluation:Snapshot}}]}, weight:1, announcement:@announcement})], rules:_{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:Implied} */
/* @prefer always */
word_replacement_land_choice ::= "change" "the" "text" "of" "target" stack_spell_filter "or" filter_phrase "by" "replacing" "all" "instances" "of" "one" "basic" "land" "type" "with" "another"

/* @sem ModeSelection::_{count:_{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{body:_{instructions:[Effect{result:@next, operation:ChooseValue(_{choosers:One(AbilityController), kind:ColorWord, terms:_{count:Exactly(Constant(2))}})}, Effect{result:@next, operation:ChangeSpell{subject:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:Any}), index:0}), changes:[ReplaceWord{from:Vocabulary{family:ColorWord, form:TheFirstChosenColorWord}, to:Vocabulary{family:ColorWord, form:TheSecondChosenColorWord}}]}}]}, weight:1, announcement:@announcement}), @scope(Mode::Mode{body:_{instructions:[Effect{result:@next, operation:ChooseValue(_{choosers:One(AbilityController), kind:ColorWord, terms:_{count:Exactly(Constant(2))}})}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:Any}), index:0})), changes:[ReplaceWord{from:Vocabulary{family:ColorWord, form:TheFirstChosenColorWord}, to:Vocabulary{family:ColorWord, form:TheSecondChosenColorWord}}], duration:Indefinite, evaluation:Snapshot}}]}, weight:1, announcement:@announcement})], rules:_{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:Implied} */
word_replacement_color_choice ::= "change" "the" "text" "of" "target" "spell" "or" "permanent" "by" "replacing" "all" "instances" "of" "one" "color" "word" "with" "another"

/* Bind the written X over a reusable numeric change and its affected set. */
/* @sem Operation::@where(Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$change_gets_defined_power, duration:$duration, evaluation:Snapshot}, $value) */
continuous_defined_x_snapshot ::= affected change_gets_defined_power duration "," "where" "X" "is" value

/* @sem Change::[Pump{power:AnnouncedX, toughness:$signed}] */
change_gets_defined_power ::= "gets" "+" "X" "/" signed

/* Both requirements share the same affected population. */
/* @sem Change::[Rule(RequireCombat{action:Attack(Any), amount:AtLeast(Constant(1))}), Rule(RequireCombat{action:Block(Any), amount:AtLeast(Constant(1))})] */
rule_attack_or_block_each_combat ::= "attacks" "or" "blocks" "each" "combat" "if" "able"

/* Postposed rules keep the subject separate from the change they describe. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:$cleanup_marked_rule} */
static_postposed_cleanup ::= "damage" "isn't" "removed" "from" affected cleanup_marked_rule "."

/* @sem Change::[Rule(DamageStaysMarked)] */
cleanup_marked_rule ::= "during" "cleanup" "steps"

/* The any-zone set retains the current object operand across the movement. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($counter_follow_subject), changes:$counter_follow_rule} */
static_postposed_counters ::= "counters" "remain" "on" counter_follow_subject counter_follow_rule "."

/* @sem ObjectSet::AnyZone(SameObject($object_ref)) */
counter_follow_subject ::= object_ref

/* @sem Change::[Rule(Unique(CountersFollowBetweenZones))] */
counter_follow_rule ::= "as" "it" "moves" "to" "any" "zone" "other" "than" "a" "player's" "hand" "or" "library"

/* Both instructions use the same printed population, evaluated at resolution. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:$objects_all}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($objects_all), changes:$grants, duration:$duration, evaluation:Snapshot}}] */
instructions_untap_population_grants ::= "untap" objects_all "." "they" "gain" grants duration

/* The producer's captured affected set remains the subject of both follow-ups. */
/* @sem Instruction::[Effect{result:@mark, operation:$gain_control_opponents_until_turn}, ...$untap_them_grant] */
instructions_control_untap_them ::= gain_control_opponents_until_turn "." untap_them_grant

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(OpponentsOf(PlayerRef::AbilityController)))}), changes:[SetController(AbilityController)], duration:$until_end_of_turn, evaluation:Snapshot} */
gain_control_opponents_until_turn ::= "gain" "control" "of" "all" filter_plural "your" "opponents" "control" until_end_of_turn

/* @sem Instruction::[Effect{result:@mark, operation:$exchange_creature_control}, ...$untap_those_creatures_grant] */
instructions_exchange_untap_creatures ::= exchange_creature_control "." untap_those_creatures_grant

/* @sem Operation::Exchange{kind:Control, first:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}), second:Player($player_ref), until:$duration} */
exchange_creature_control ::= "you" "and" player_ref "each" "gain" "control" "of" "all" "creatures" "the" "other" "controls" duration

/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:Affected(@marked)}}, $affected_grant_followup] */
untap_them_grant ::= "untap" "them" "." "they" affected_grant_followup

/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:Affected(@marked)}}, $affected_grant_followup] */
untap_those_creatures_grant ::= "untap" "those" "creatures" "." "those" "creatures" affected_grant_followup

/* @sem Instruction::Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Affected(@marked)), changes:$grants, duration:$duration, evaluation:Snapshot}} */
affected_grant_followup ::= "gain" grants duration

/* A condition qualifies any supported linked-exile permission. */
/* @sem Ability::Conditional{condition:$condition, then:[Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:$turn_exile_permissions})]} */
conditional_exile_permission ::= turn_exile_permissions "as" "long" "as" condition "."

/* A choice and its dependent continuous change share one duration and subject. */
/* @sem Change::GrantKeyword(HexproofFrom(Objects(_{kind:Any, filter:Chosen(Color)}))) */
chosen_color_hexproof_grant ::= "hexproof" "from" "that" "color"

/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[Term{family:ChoosableColor, form:AnyColor}]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[ChosenColor{mode:Set}, $chosen_color_hexproof_grant], duration:$duration, evaluation:Snapshot}}] */
clause_leading_color_choice_grant ::= duration "," affected "becomes" "the" "color" "of" "your" "choice" "and" "gains" chosen_color_hexproof_grant

/* A creature population is captured by the characteristic effect, so its
   conditional follow-up untaps exactly that same population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::CardType(Creature), $plural_control_modifier)} */
snapshot_controlled_creature_population ::= "creatures" plural_control_modifier

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($snapshot_controlled_creature_population), changes:[Pump{power:$signed_literal, toughness:$signed_literal_2}], duration:$duration, evaluation:Snapshot} */
snapshot_controlled_creature_pump ::= snapshot_controlled_creature_population "get" signed_literal "/" signed_literal duration

/* @sem Vec<Instruction>::[Effect{result:@next, operation:$snapshot_controlled_creature_pump}, If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:SetTapped{objects:Affected(@prior), tapped:false}}]}, otherwise:Program{}}] */
conditional_untap_pumped_creatures ::= snapshot_controlled_creature_pump "." "if" condition "," "untap" "those" "creatures"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$conditional_untap_pumped_creatures}} */
spell_conditional_untap_pumped_creatures ::= conditional_untap_pumped_creatures "."

/* Quantities are evaluated for the affected object, or for the controller's opponents. */
/* @sem Expr::CountCounters(_{recipients:Players(OpponentsOf(AbilityController)), kind:$counter_kind, information:CurrentOrLastKnown}) */
shared_opponents_counter_count ::= counter_kind "counter" "your" "opponents" "have"

/* @sem Expr::ObjectProperty{object:Affected, property:ColorCount, information:CurrentOrLastKnown} */
shared_affected_color_count ::= "of" "its" "colors"

/* @sem Expr::Minimum([CountDistinct{objects:One(Affected), property:CreatureTypes}, $value]) */
shared_affected_creature_type_maximum ::= "of" "its" "creature" "types" "," "to" "a" "maximum" "of" value

/* @sem Expr::ObjectProperty{object:Affected, property:BushidoValue, information:CurrentOrLastKnown} */
shared_affected_bushido_count ::= "point" "of" "bushido" "it" "has"

/* Player subjects and their turn rules compose independently. */
/* @sem Ability::Static{kind:Ordinary, affected:Players($players_singular), changes:[PlayerRule($singular_turn_player_rule)]} */
static_singular_turn_player_rule ::= players_singular singular_turn_player_rule "."

singular_turn_player_rule ::= turn_player_draw_limit | turn_player_sorcery_timing | turn_player_additional_land | turn_player_additional_lands

/* @sem PlayerRule::LimitPerTurn{action:Draw, amount:$turn_draw_count} */
turn_player_draw_limit ::= "can't" "draw" "more" "than" turn_draw_count "each" "turn"

turn_draw_count ::= turn_draw_one | turn_draw_many

/* @sem Expr::Constant(1) */
turn_draw_one ::= "one" "card"

/* @sem $count_plural */
turn_draw_many ::= count_plural "cards"

/* @sem PlayerRule::SpellTiming{spells:Any, timing:SorceryOnly} */
turn_player_sorcery_timing ::= "can" "cast" "spells" "only" "any" "time" "they" "could" "cast" "a" "sorcery"

/* @sem PlayerRule::AdditionalLandPlays(Exactly($counter_a)) */
turn_player_additional_land ::= "may" "play" counter_a "additional" "land" "on" "each" "of" "their" "turns"

/* @sem Ability::Static{kind:Ordinary, affected:Players($player_keyword_all), changes:[PlayerRule($plural_turn_player_rule)]} */
static_plural_turn_player_rule ::= player_keyword_all plural_turn_player_rule "."

/* @sem PlayerRule::AdditionalLandPlays(Exactly($count_plural)) */
turn_player_additional_lands ::= "may" "play" count_plural "additional" "lands" "on" "each" "of" "their" "turns"

plural_turn_player_rule ::= turn_player_untap_limit | turn_player_untap_limit_many | turn_player_skip_untap | turn_player_sorcery_timing | turn_player_own_turn_cast_timing

/* @sem PlayerRule::UntapLimit{permanents:$filter_phrase, amount:Expr::Constant(1)} */
turn_player_untap_limit ::= "can't" "untap" "more" "than" "one" filter_phrase "during" "their" "untap" "steps"

/* @sem PlayerRule::UntapLimit{permanents:$filter_plural, amount:$count_plural} */
turn_player_untap_limit_many ::= "can't" "untap" "more" "than" count_plural filter_plural "during" "their" "untap" "steps"

/* @sem PlayerRule::Skip(Untap) */
turn_player_skip_untap ::= "skip" "their" "untap" "steps"

/* The cause filter and the player's action retain independent operands. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(CantBeCaused{action:$caused_player_action, by:$causing_spells_abilities})]} */
static_controller_cause_restriction ::= causing_spells_abilities "can't" "cause" "you" "to" caused_player_action "."

causing_spells_abilities ::= causing_opponents_spells_abilities | causing_your_spells_abilities | causing_active_opponents_spells_abilities

/* @sem ObjectFilter::ControlledBy(OpponentsOf(AbilityController)) */
causing_opponents_spells_abilities ::= "spells" "and" "abilities" "your" "opponents" "control"

/* @sem ObjectFilter::ControlledBy(One(AbilityController)) */
causing_your_spells_abilities ::= "spells" "and" "abilities" "you" "control"

/* @sem ObjectFilter::ControlledBy(OpponentsOf(Active)) */
causing_active_opponents_spells_abilities ::= "spells" "and" "abilities" "the" "active" "player's" "opponents" "control"

caused_player_action ::= caused_sacrifice | player_prohibit_draw

/* @sem PlayerAction::Sacrifice{objects:$filter_plural} */
caused_sacrifice ::= "sacrifice" filter_plural

/* The activated ability's kind, target population and reduction are independent. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(ActivationCost{abilities:$shared_targeted_activation, change:Reduce($generic_reduction_symbols)})]} */
shared_you_targeted_activation_reduction ::= shared_targeted_activation "cost" generic_reduction_symbols "less" "to" "activate" "."

/* @sem ObjectFilter::AllOf([OnStack($shared_activation_kind), TargetsAny(Objects($affected))]) */
shared_targeted_activation ::= shared_activation_kind "abilities" "you" "activate" "that" "target" affected

/* Payment prohibitions retain both the sacrificed population and payment purposes. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(All), changes:$shared_payment_prohibitions} */
shared_players_payment_prohibition ::= "players" "can't" shared_payment_prohibitions "."

/* @sem Change::[PlayerRule(Prohibit(PayLife(Spells(Any)))), PlayerRule(Prohibit(PayLife(Abilities(Any)))), PlayerRule(Prohibit(Sacrifice{objects:$filter_plural, paying:Spells(Any)})), PlayerRule(Prohibit(Sacrifice{objects:$filter_plural, paying:Abilities(Any)}))] */
shared_payment_prohibitions ::= "pay" "life" "or" "sacrifice" filter_plural "to" "cast" "spells" "or" "activate" "abilities"

/* @prefer always */
/* @sem Expr::$defining_sacrificed_as_entered */
defining_named_sacrifice_count ::= defining_sacrificed_as_entered

/* The entering object is the holder of this defining ability. */
/* @sem Expr::CountObjects(Matching{objects:SacrificedAsEntered(@self), filter:$filter_plural}) */
defining_sacrificed_as_entered ::= "the" "number" "of" filter_plural "sacrificed" "as" "it" "entered"

/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:$spell_population_filter} */
prohibited_spells_restricted ::= spell_population_filter

spell_population_filter ::= spell_population_filter_controlled_list | spell_population_filter_controlled | spell_population_filter_power | spell_population_filter_mana | spell_population_filter_x

/* @sem @and(ObjectFilter::AnyOf([...$spell_type_commas, $spell_type_head]), ObjectFilter::ControlledBy(One(PlayerRef::AbilityController))) */
spell_population_filter_controlled_list ::= spell_type_commas "and" spell_type_head "spells" "you" "control"

spell_type_head ::= spell_instant | spell_sorcery | noun

spell_type_commas ::= spell_type_commas_more | spell_type_commas_last

/* @sem ObjectFilter::[$spell_type_head, ...$spell_type_commas] */
spell_type_commas_more ::= spell_type_head "," spell_type_commas

/* @sem ObjectFilter::[$spell_type_head] */
spell_type_commas_last ::= spell_type_head ","

/* @sem @and($filter_phrase, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController))) */
spell_population_filter_controlled ::= filter_phrase "spells" "you" "control"

spell_population_kind ::= adjective_nontype | filter_phrase

/* @sem @and($spell_population_kind, $spell_cost_power_threshold) */
spell_population_filter_power ::= spell_population_kind "spells" spell_cost_power_threshold

/* @sem @and($spell_population_kind, $spell_cost_mana_threshold) */
spell_population_filter_mana ::= spell_population_kind "spells" spell_cost_mana_threshold

/* @sem @and($spell_population_kind, ObjectFilter::State(HasX)) */
spell_population_filter_x ::= spell_population_kind "spells" "with" "{" "X" "}" "in" "their" "mana" "costs"

/* A second timed change applies to the population affected by the copy. */
/* @sem Instruction::[Effect{result:@next, operation:$copy_effect_for_followup}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Affected(@prior)), changes:$static_changes, duration:$duration, evaluation:Snapshot}}] */
clause_copy_then_changes ::= copy_effect_for_followup "and" static_changes duration

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@copy_subject(ObjectSet::$affected, ObjectRef::$copy_followup_model)), changes:[CopyOf{object:$copy_followup_model, exceptions:[]}], duration:$copy_followup_duration, evaluation:Snapshot} */
copy_effect_for_followup ::= affected "becomes" "a" "copy" "of" copy_followup_model copy_followup_duration

copy_followup_model ::= copy_followup_target | copy_model_ref

/* @prefer always */
/* @sem ObjectRef::$target_permanent */
copy_followup_target ::= target_permanent

copy_followup_duration ::= copy_followup_end_of_turn | duration

/* @prefer always */
/* @sem Duration::EndOfTurn */
copy_followup_end_of_turn ::= "until" "end" "of" "turn"

/* The excluded target and its controller are independent operands of the live
   population. This follow-up requires an already announced singleton target. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Target{slot:@last_slot, index:0})), $plural, ControlledBy(One(ControllerOf(Target{slot:@last_slot, index:0})))])}), changes:[Rule(Prohibit(Block(Any)))], duration:$this_duration, evaluation:LiveObjects} */
other_target_controller_block_prohibition ::= "other" plural "that" "player" "controls" "can't" "block" this_duration

/* The explicit creature callback anchors both the untap and the player to the
   same announced object; keep the two-sentence anaphor scoped together. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:One(Target{slot:@last_slot, index:0}), tapped:false}}, Effect{result:@next, operation:$other_target_controller_block_prohibition}] */
untap_target_other_controller_block ::= "untap" "that" "creature" "." other_target_controller_block_prohibition

/* A die adjustment retains its independently composed payment cost. */
/* @sem PlayerRule::DiceChange{cost:Cost($cost)} */
player_paid_die_adjustment ::= "you" "may" cost "." "if" "you" "do" "," "increase" "or" "decrease" "the" "result" "by" "1"

/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule($player_paid_die_adjustment)]} */
static_after_controller_die_roll ::= "after" "you" "roll" "a" "die" "," player_paid_die_adjustment "."

/* All three actions refer to the same explicitly named population. Keep both
   durations independent and print each from its current operand. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:$control_population, tapped:false}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($control_population), changes:[SetController(AbilityController)], duration:$population_control_duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($control_population), changes:[GrantKeyword($control_population_keyword)], duration:$duration, evaluation:Snapshot}}] */
instructions_untap_population_control_grants ::= "untap" control_population "and" "gain" "control" "of" "them" population_control_duration "." "they" "gain" control_population_keyword duration

/* Controller-qualified filters are excluded: gaining control could change
   their membership between the two effects. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$control_population_type} */
control_population ::= "all" control_population_type

control_population_type ::= plural_creature | plural_artifact | plural_enchantment | plural_land | plural_planeswalker | plural_permanent

/* Mid-sentence keyword spellings do not have the title-case alternative. */
control_population_keyword ::= control_keyword_haste | control_keyword_flying | control_keyword_trample | control_keyword_vigilance

/* @sem Keyword::Haste */
control_keyword_haste ::= "haste"

/* @sem Keyword::Flying */
control_keyword_flying ::= "flying"

/* @sem Keyword::Trample */
control_keyword_trample ::= "trample"

/* @sem Keyword::Vigilance */
control_keyword_vigilance ::= "vigilance"

population_control_duration ::= population_control_end_turn | duration

/* @prefer always */
/* @sem Duration::EndOfTurn */
population_control_end_turn ::= "until" "end" "of" "turn"

/* @prefer always */
/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:$instructions_untap_population_control_grants}} */
spell_untap_population_control_grants ::= instructions_untap_population_control_grants "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(ActivationCost{abilities:AllOf([AbilityOf($activation_owner), Not(OnStack(Mana))]), change:Increase($kicker_operand_generic)})]}) */
static_nonmana_activation_cost_more ::= "activated" "abilities" "of" activation_owner "cost" kicker_operand_generic "more" "to" "activate" "unless" "they're" "mana" "abilities" "."

/* Universal keyword costs share the keyword and current payment adjustment. */
/* @prefer always */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(KeywordCost{keyword:$universal_payment_keyword, cards:Any, change:$keyword_payment_change})]}) */
static_universal_keyword_payment ::= "all" universal_payment_keyword "costs" "cost" keyword_payment_change "."

universal_payment_keyword ::= payment_keyword | universal_morph_keyword

/* @sem Mechanic::Morph */
universal_morph_keyword ::= "morph"

/* A variable reduction is shared independently of its affected ability population. */
/* @sem ActivationCostChange::ReduceX{amount:List([Vocabulary{family:CostReductionSymbolX, form:CostReduceX}]), times:$value} */
activation_cost_variable_reduction ::= "{" "X" "}" "less" "to" "activate" "," "where" "X" "is" value

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(ActivationCost{abilities:AbilityOf($activation_owner), change:$activation_cost_variable_reduction, floor:1})]}) */
static_activation_variable_floor ::= "activated" "abilities" "of" activation_owner "cost" activation_cost_variable_reduction "." "this" "effect" "can't" "reduce" "the" "mana" "in" "that" "cost" "to" "less" "than" "one" "mana" "."

/* A life payment buys a reduction in one specified colored mana symbol.
   Keep the reduction symbol and its explanatory color together. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:AllOf([$filter_phrase, AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)])]), modifier:PayToReduce{cost:Cost(Cost{parts:[$cost_life]}), mana:$life_payment_reduction}})]} */
shared_life_payment_spell_reduction ::= "as" "an" "additional" "cost" "to" "cast" filter_phrase "spells" "," "you" "may" cost_life "." life_payment_reduction

life_payment_reduction ::= life_payment_reduction_blue | life_payment_reduction_white | life_payment_reduction_black | life_payment_reduction_red | life_payment_reduction_green

/* @sem Operand::List([Term{family:ManaSymbol, form:ManaCostU}]) */
life_payment_reduction_blue ::= "those" "spells" "cost" "{" "U" "}" "less" "to" "cast" "if" "you" "paid" "life" "this" "way" "." "this" "effect" "reduces" "only" "the" "amount" "of" "blue" "mana" "you" "pay" "."

/* @sem Operand::List([Term{family:ManaSymbol, form:ManaCostW}]) */
life_payment_reduction_white ::= "those" "spells" "cost" "{" "W" "}" "less" "to" "cast" "if" "you" "paid" "life" "this" "way" "." "this" "effect" "reduces" "only" "the" "amount" "of" "white" "mana" "you" "pay" "."

/* @sem Operand::List([Term{family:ManaSymbol, form:ManaCostB}]) */
life_payment_reduction_black ::= "those" "spells" "cost" "{" "B" "}" "less" "to" "cast" "if" "you" "paid" "life" "this" "way" "." "this" "effect" "reduces" "only" "the" "amount" "of" "black" "mana" "you" "pay" "."

/* @sem Operand::List([Term{family:ManaSymbol, form:ManaCostR}]) */
life_payment_reduction_red ::= "those" "spells" "cost" "{" "R" "}" "less" "to" "cast" "if" "you" "paid" "life" "this" "way" "." "this" "effect" "reduces" "only" "the" "amount" "of" "red" "mana" "you" "pay" "."

/* @sem Operand::List([Term{family:ManaSymbol, form:ManaCostG}]) */
life_payment_reduction_green ::= "those" "spells" "cost" "{" "G" "}" "less" "to" "cast" "if" "you" "paid" "life" "this" "way" "." "this" "effect" "reduces" "only" "the" "amount" "of" "green" "mana" "you" "pay" "."

/* A paid die-result adjustment keeps its payment and usage limit as operands. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule($paid_die_adjustment)]}) */
static_paid_die_adjustment ::= "after" "you" "roll" "a" "die" "," paid_die_adjustment

/* @sem PlayerRule::DiceChange{cost:Cost($cost), limit:$turn_cast_limit} */
paid_die_adjustment ::= "you" "may" cost "." "if" "you" "do" "," "increase" "or" "decrease" "the" "result" "by" "1" "." "do" "this" "only" turn_cast_limit "each" "turn" "."

/* A controlled subtype population copies the target already named in this program. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$copy_controlled_subtype, ControlledBy(One(AbilityController))])}), changes:[CopyOf{object:Target{slot:@last_slot, index:0}, exceptions:[]}], duration:UntilNext{point:EndStepBegins, players:All}, evaluation:Snapshot} */
controlled_subtypes_copy_target_until_end ::= copy_controlled_subtype "you" "control" "become" "copies" "of" "it" "until" "the" "next" "end" "step"

/* Sentence-initial Clues folds to the existing lower-case vocabulary token. */
copy_controlled_subtype ::= subtype_plural | copy_controlled_clues

/* @sem ObjectFilter::Subtype(Clue) */
copy_controlled_clues ::= "clues"

/* Conditional protection clauses share the stated subject and duration. */
/* @sem Instruction::If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), changes:[GrantKeyword(Protection(Objects(_{kind:Any, filter:$adjective_color})))], duration:EndOfTurn, evaluation:Snapshot}}]}, otherwise:Program{}} */
controlled_creatures_conditional_protection ::= "from" adjective_color "if" condition

/* @sem Instruction::[$controlled_creatures_conditional_protection] */
controlled_creatures_protection_last ::= "," "and" controlled_creatures_conditional_protection

/* @sem Instruction::[$controlled_creatures_conditional_protection, ...$controlled_creatures_protection_tail] */
controlled_creatures_protection_more ::= "," controlled_creatures_conditional_protection controlled_creatures_protection_tail

controlled_creatures_protection_tail ::= controlled_creatures_protection_last | controlled_creatures_protection_more

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[$controlled_creatures_conditional_protection, ...$controlled_creatures_protection_tail]}} */
spell_conditional_controlled_creature_protections ::= "until" "end" "of" "turn" "," "creatures" "you" "control" "gain" "protection" controlled_creatures_conditional_protection controlled_creatures_protection_tail "."

/* Threshold and affected population are independent operands. */
/* @sem Ability::Conditional{condition:$condition_control_subtype_or_more, then:[$controlled_type_plural_pump]} */
conditional_control_subtype_pump ::= "as" "long" "as" condition_control_subtype_or_more "," "↑" controlled_type_plural_pump "."

/* @sem ObjectFilter::Subtype(Human) */
controlled_type_lower_humans ::= "humans"

/* A conditional definition of X supplies both stat operands in each branch.
   The two counted populations and the cap's property and offset are independent. */
/* @sem Ability::Conditional{condition:ObjectMatches{object:AttachedTo(Source), filter:$host_defined_state}, then:[Static(_{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Pump{power:@times($defined_x_sign, $host_defending_count), toughness:@times($defined_y_sign, Expr::Minimum($host_defending_count, Subtract(ObjectProperty{object:AttachedTo(Source), property:$stat, information:CurrentOrLastKnown}, $number_digits)))}]})], otherwise:[Static(_{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Pump{power:@times($defined_x_sign, $host_controller_count), toughness:@times($defined_y_sign, Expr::Minimum($host_controller_count, Subtract(ObjectProperty{object:AttachedTo(Source), property:$stat, information:CurrentOrLastKnown}, $number_digits)))}]})]} */
host_conditional_capped_stats ::= "enchanted" "creature" "gets" defined_x_sign "/" defined_y_sign "." "if" "that" "creature" "is" host_defined_state "," "↑" "x" "is" host_defending_count "." "otherwise" "," "↑" "x" "is" host_controller_count "." "y" "is" "equal" "to" "X" "or" "to" "enchanted" "creature's" stat "minus" number_digits "," "whichever" "is" "smaller" "."

host_defined_state ::= adjective_attacking | adjective_blocking | adjective_tapped | adjective_untapped

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(DefendingPlayerOf(AttachedTo(Source)))))}) */
host_defending_count ::= "the" "number" "of" filter_plural "defending" "player" "controls"

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(ControllerOf(AttachedTo(Source)))))}) */
host_controller_count ::= "the" "number" "of" filter_plural "its" "controller" "controls"

/* A granted turn trigger retains its holder and composes its payment body. */
/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$holder_unless_payment_program} */
retirement_quoted_turn_payment ::= "at" turn_event "," holder_unless_payment_program

/* Spell kind and target restriction both constrain the spells whose cost changes. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:@and($cast_spells_filter, $target_tax_spells), modifier:$spell_cost_change})]}) */
static_filtered_targeted_spell_cost ::= cast_spells_filter "you" "cast" "that" "target" target_tax_spells "cost" spell_cost_change "to" "cast" "."

/* A life payment reduces the white mana required by the described spells. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$colored_permanent_spell_filter, modifier:PayToReduce{cost:Cost(_{parts:[$cost_life]}), mana:List([Term{family:ManaSymbol, form:ManaCostW}])}})]}) */
optional_life_white_spell_reduction ::= "as" "an" "additional" "cost" "to" "cast" colored_permanent_spell_filter "spells" "," "you" "may" cost_life "." "those" "spells" "cost" "{" "W" "}" "less" "to" "cast" "if" "you" "paid" "life" "this" "way" "." "this" "effect" "reduces" "only" "the" "amount" "of" "white" "mana" "you" "pay" "."

/* The spell population and the life-for-black-mana payment are reusable
   phrases; the latter keeps the repeated black symbol and color in agreement. */
/* @sem ObjectFilter::AllOf([Color($mana_color_word), AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)])]) */
colored_permanent_spell_population ::= mana_color_word "permanent" "spells"

/* @sem SpellCostModifier::PayToReduce{cost:Cost(_{parts:[$cost_life]}), mana:List([Term{family:ManaSymbol, form:ManaCostB}])} */
life_for_black_spell_reduction ::= "you" "may" cost_life "." "those" "spells" "cost" "{" "B" "}" "less" "to" "cast" "if" "you" "paid" "life" "this" "way" "." "this" "effect" "reduces" "only" "the" "amount" "of" "black" "mana" "you" "pay"

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$colored_permanent_spell_population, modifier:$life_for_black_spell_reduction})]}) */
static_life_for_black_permanent_spells ::= "as" "an" "additional" "cost" "to" "cast" colored_permanent_spell_population "," life_for_black_spell_reduction "."

/* An optional life payment reduces a specific colored component of the cost. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$paid_reduction_spells, modifier:$life_for_green_reduction})]}) */
static_life_paid_spell_reduction ::= "as" "an" "additional" "cost" "to" "cast" paid_reduction_spells "," "you" "may" life_for_green_reduction

/* @sem ObjectFilter::AllOf([$adjective_color, AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)])]) */
paid_reduction_spells ::= adjective_color "permanent" "spells"

/* @sem SpellCostModifier::PayToReduce{cost:Cost{parts:[$cost_life]}, mana:List([Term{family:ManaSymbol, form:ManaCostG}])} */
life_for_green_reduction ::= cost_life "." "those" "spells" "cost" "{" "G" "}" "less" "to" "cast" "if" "you" "paid" "life" "this" "way" "." "this" "effect" "reduces" "only" "the" "amount" "of" "green" "mana" "you" "pay" "."

/* The target supplies the antecedent of the creature-specific exception. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_ref_holder)), changes:[CopyOf{object:$enchanted_creature_target, exceptions:[$copy_creature_keep_color, ...$copy_exceptions_plain]}], duration:Indefinite, evaluation:Snapshot} */
copy_become_creature_keep_color ::= self_ref_holder "become" "a" "copy" "of" enchanted_creature_target "," "except" copy_creature_keep_color "and" copy_exceptions_plain

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$noun_artifact}), index:0} */
copy_artifact_target ::= "target" noun_artifact

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_ref_holder)), changes:[CopyOf{object:$copy_artifact_target, exceptions:[$copy_artifact_keep_color, ...$copy_exceptions_plain]}], duration:Indefinite, evaluation:Snapshot} */
copy_become_artifact_keep_color ::= self_ref_holder "become" "a" "copy" "of" copy_artifact_target "," "except" copy_artifact_keep_color "and" copy_exceptions_plain

/* The controller and the affected objects receive separate continuous effects. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(GrantKeyword(Protection(Players($shared_protection_player))))], duration:$shared_protection_duration, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[GrantKeyword(Protection(Players($shared_protection_player)))], duration:$shared_protection_duration, evaluation:Snapshot}}] */
clause_you_and_target_protection ::= "you" "and" affected "each" "gain" "protection" "from" shared_protection_player shared_protection_duration

shared_protection_player ::= players_chosen_shared | players_singular

shared_protection_duration ::= shared_protection_end_of_turn | until_next_end_step | until_beginning_next_upkeep | duration_die_roll_earliest | until_end_of_combat | until_your_next_turn | until_end_of_your_next_turn | this_turn | this_combat | until_end_of_next_upkeep | until_next_upkeep | while_you_control | while_on_battlefield | until_player_planeswalks | while_you_control_and_tapped

/* @prefer always */
/* @sem Duration::EndOfTurn */
shared_protection_end_of_turn ::= "until" "end" "of" "turn"

/* A self bonus without an expiry remains in effect indefinitely. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:$self_bonus_changes, duration:Indefinite, evaluation:Snapshot} */
self_indefinite_bonus ::= "this" "creature" self_bonus_changes

/* @sem Change::[...$singular_pump, ...$self_gains_keyword] */
self_bonus_changes ::= singular_pump "and" self_gains_keyword

/* @sem Change::[GrantKeyword($keyword_name)] */
self_gains_keyword ::= "gains" keyword_name

/* The stat and subtype animation retains the original types and grants abilities. */
/* @sem Change::[...$retained_creature_animation, ...$grants] */
retained_animation_with_grants ::= retained_creature_animation "with" grants "in" "addition" "to" "its" "other" "types"

/* The target selection and its later singular reference share one target slot. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($optional_controlled_union_nontoken_target)), changes:$retained_animation_with_grants, duration:$duration, evaluation:Snapshot}}] */
instructions_optional_target_retained_animation ::= optional_controlled_union_nontoken_target "." duration "," "it" "becomes" retained_animation_with_grants

/* @sem ArtifactType::Equipment */
added_equipment_type ::= "Equipment"

/* A controlled subtype-token population shares additive characteristics and grants. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($subtype_tokens, $modifier_you_control)}), changes:$additive_artifact_grants} */
static_subtype_tokens_additive_grants ::= subtype_tokens modifier_you_control additive_artifact_grants "."

/* @sem Change::[...$token_additive_artifact_change, ...$grants] */
additive_artifact_grants ::= token_additive_artifact_change "and" "have" grants

token_additive_artifact_change ::= additive_artifact_change | change_add_equipment_type

/* @sem Change::[AddArtifactType($added_equipment_type)] */
change_add_equipment_type ::= "are" added_equipment_type "in" "addition" "to" "their" "other" "types"

/* An indefinite type change and its quoted trigger affect the same object. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[CreatureTypes{mode:Set, types:Listed($becomes_types)}, $shared_granted_trigger_closed], duration:Indefinite, evaluation:Snapshot} */
indefinite_quoted_type_change ::= "it" "becomes" "a" becomes_types "and" "gains" shared_granted_trigger_closed

/* A distributive leading duration applies one snapshot change set to each target. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$plural_base_grant_retained_color_type, duration:$duration, evaluation:Snapshot} */
duration_each_affected_changes ::= duration "," affected "each" plural_base_grant_retained_color_type

/* Base stats, granted keyword, and retained color and creature types are independent changes. */
/* @sem Change::[...$static_plural_base_stats, GrantKeyword($keyword_value), ...$plural_retained_color_type] */
plural_base_grant_retained_color_type ::= static_plural_base_stats "," "gain" keyword_value "," "and" plural_retained_color_type

/* @sem Change::[Colors{mode:Add, colors:[$mana_color_word]}, CreatureTypes{mode:Add, types:Listed($cross_creature_types)}] */
plural_retained_color_type ::= "become" mana_color_word cross_creature_types "in" "addition" "to" "their" "other" "colors" "and" "types"

/* A duration-led rule applies to a specifically targeted tapped permanent. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Tapped, $tapped_rule_creature])}), index:0})), changes:$tapped_rule_skip_untap, duration:$source_tapped_duration, evaluation:LiveObjects}}] */
source_tapped_target_untap_rule ::= source_tapped_duration "," "target" "tapped" tapped_rule_creature tapped_rule_skip_untap

/* @sem Duration::WhileMatches{object:Source, filter:Tapped} */
source_tapped_duration ::= "for" "as" "long" "as" "this" "creature" "remains" "tapped"

/* @sem Change::[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})] */
tapped_rule_skip_untap ::= "doesn't" "untap" "during" "its" "controller's" "untap" "step"

tapped_rule_creature ::= noun_creature | tapped_rule_qualified_creature

/* @sem @and($quality_unscoped, $noun_creature) */
tapped_rule_qualified_creature ::= quality_unscoped noun_creature

/* Replacing two creature types does not add a card type. */
/* @sem Change::[CreatureTypes{mode:Set, types:Listed([@subtype_name($creature_subtype), @subtype_name($creature_subtype_2)])}] */
static_is_two_creature_types ::= "is" "a" creature_subtype creature_subtype

/* Spell effect and owned origin are independent of the spell filter. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellsHaveAbilities{spells:$filter_phrase, from:$own_cast_zone, abilities:List([$first_spell_effect])})]}) */
static_owned_origin_spell_effect ::= filter_phrase "spells" "you" "cast" "from" own_cast_zone "have" first_spell_effect "."

/* The reduction and the zone supplying foretold cards are independent. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(KeywordCost{keyword:Foretell, cards:Any, change:Reduce($kicker_operand_generic)}), PlayerRule(KeywordAccess{keyword:Foretell, cards:Any, from:$own_cast_zone, during:All})]}) */
static_foretell_cost_access ::= "foretelling" "cards" "from" own_cast_zone "costs" kicker_operand_generic "less" "and" "can" "be" "done" "on" "any" "player's" "turn" "."

/* Own-hand casting permissions compose a selected spell population with its terms. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[$own_hand_cast_permission_change]}) */
static_own_hand_cast_permission ::= own_hand_cast_permission_change "."

own_hand_cast_permission_change ::= own_hand_once_free_cast | own_hand_energy_flash_cast

/* @sem Change::PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Hand, players:One(Affected)}, kind:Card, filter:Any}), from:Hand, action:CastSpell, filter:$own_hand_disjunct_spell}, terms:_{limit:EachTurn(1), cost:Free}}) */
own_hand_once_free_cast ::= "once" "during" "each" "of" "your" "turns" "," "you" "may" "cast" own_hand_disjunct_spell "from" "your" "hand" "without" "paying" "its" "mana" "cost"

/* @sem ObjectFilter::@or($adjective_nontype, $filter_phrase) */
own_hand_disjunct_spell ::= "a" adjective_nontype "or" filter_phrase "spell"

/* @sem Change::PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Hand, players:One(Affected)}, kind:Card, filter:Any}), from:Hand, action:CastSpell, filter:$own_hand_mana_value_spells}, terms:$own_hand_energy_flash_terms}) */
own_hand_energy_flash_cast ::= "you" "may" "cast" own_hand_mana_value_spells own_hand_energy_flash_terms

/* @sem ObjectFilter::AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}]) */
own_hand_mana_value_spells ::= filter_phrase "spells" "with" "mana" "value" value "or" "less"

/* The one energy symbol is the payment; the later article identifies one spell. */
/* @sem PlayTerms::PlayTerms{cost:Alternate(Cost{parts:[Energy(Constant(1))]}), flash:true} */
own_hand_energy_flash_terms ::= "by" "paying" "{" "E" "}" "rather" "than" "paying" "their" "mana" "costs" "." "if" "you" "cast" "a" "spell" "this" "way" "," "you" "may" "cast" "it" "as" "though" "it" "had" "flash"

/* Graveyard card subjects retain the controller of the ability as zone owner. */
/* @sem ObjectFilter::AllOf([$filter_phrase, InZone(Players{zone:Graveyard, players:One(AbilityController)})]) */
activation_owner_graveyard_cards ::= filter_phrase "cards" "in" "your" "graveyard"

/* A play-only permission ranges over the filtered card population itself. */
/* @sem Change::[PlayerRule(PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:$filter_plural}), from:Graveyard, action:PlayLand, filter:Any})] */
graveyard_play_only ::= "play" filter_plural

/* The spell filter and its mana-value bound are independent operands. */
/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value_counters_on_object}} */
graveyard_mana_value_bound ::= "with" "mana" "value" "less" "than" "or" "equal" "to" value_counters_on_object

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:AllOf([$filter_phrase, $graveyard_mana_value_bound])}, terms:_{limit:EachTurn(1), during:One(AbilityController), cost:Normal}})]}) */
static_once_graveyard_bounded_cast ::= "once" "during" "each" "of" "your" "turns" "," "you" "may" "cast" "an" filter_phrase "spell" "from" "your" "graveyard" graveyard_mana_value_bound "."

/* Restrictions compose while sharing the affected player population. */
/* @sem Change::PlayerRule(Prohibit(CastSpell{from:Players{zone:Graveyard, players:All}, filter:Any})) */
prohibit_graveyard_cast ::= "cast" "spells" "from" "graveyards"

/* @sem Change::PlayerRule(Prohibit(Activate(Of(InZone(Players{zone:Graveyard, players:All}))))) */
prohibit_graveyard_activation ::= "activate" "abilities" "of" "cards" "in" "graveyards"

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[$prohibit_graveyard_cast, $prohibit_graveyard_activation]}) */
static_players_graveyard_restrictions ::= "players" "can't" prohibit_graveyard_cast "or" prohibit_graveyard_activation "."

/* The per-type limit is a reusable operand. The spell phrase is restricted
   to permanent spells so the shared filter does not exclude playable lands. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[$graveyard_each_type_permission]}) */
static_graveyard_each_type_permission ::= "during" "each" "of" "your" "turns" "," graveyard_each_type_permission "."

/* @sem Change::PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:Any}), from:Graveyard, action:Either, filter:Any}, terms:_{limit:$graveyard_per_type_limit, during:One(AbilityController), cost:Normal}}) */
graveyard_each_type_permission ::= "you" "may" "play" "a" "land" "and" "cast" "a" "permanent" "spell" graveyard_per_type_limit "from" "your" "graveyard"

/* @sem PlayLimit::OnePerCardType(Permanent) */
graveyard_per_type_limit ::= "of" "each" "permanent" "type"

/* The artifact anaphor is restricted to the artifact spell population. Entry
   modifications and the additional payment are independently composable. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[$graveyard_artifact_paid_entry]}) */
static_graveyard_artifact_paid_entry ::= graveyard_artifact_paid_entry "."

/* @sem Change::PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:CardType(Artifact)}, terms:_{cost:Additional(Cost{parts:[$graveyard_additional_life]}), effects:[$cast_entry_effects]}}) */
graveyard_artifact_paid_entry ::= "you" "may" "cast" "artifact" "spells" "from" "your" "graveyard" "by" graveyard_additional_life "in" "addition" "to" "paying" "their" "other" "costs" "." "if" "you" "cast" "a" "spell" "this" "way" "," "that" "artifact" cast_entry_effects

/* @sem CostPart::Life($value) */
graveyard_additional_life ::= "paying" value "life"

/* Conditional self descriptions share the same creature animation operands. */
/* @sem Ability::Conditional{condition:$condition, then:[Static{kind:Ordinary, affected:Objects(One(Source)), changes:$indefinite_creature_animation}], otherwise:[]} */
conditional_he_creature_description ::= "as" "long" "as" condition "," "he's" indefinite_creature_animation "."

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, AddCardType(Creature)] */
retained_base_creature ::= "a" value "/" value "creature" "in" "addition" "to" "its" "other" "types"

/* @sem Change::[...$retained_base_creature, GrantAbility($mechanic_numbered_keyword)] */
retained_base_creature_mechanic ::= retained_base_creature "and" "it" "has" mechanic_numbered_keyword

/* @sem Ability::Conditional{condition:$condition, then:[Static{kind:Ordinary, affected:Objects(One(Source)), changes:$retained_base_creature_mechanic}], otherwise:[]} */
conditional_it_retained_base ::= "as" "long" "as" condition "," "it's" retained_base_creature_mechanic "."

/* The two turn branches retain their independently specified subjects and values. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[SetBasePowerToughness{power:$value, toughness:$value}]} */
turn_equal_base_stat ::= affected "'s" "power" "and" "toughness" "are" "each" "equal" "to" value "."

/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[SetBasePowerToughness{power:$value, toughness:$value}]} */
turn_fixed_base_stat ::= affected "'s" "power" "and" "toughness" "are" "each" value "."

/* @sem Ability::Conditional{condition:PlayerIsActive(AbilityController), then:[$turn_equal_base_stat], otherwise:[$turn_fixed_base_stat]} */
conditional_turn_base_stats ::= "during" "your" "turn" "," turn_equal_base_stat "during" "turns" "other" "than" "yours" "," turn_fixed_base_stat

/* A leading condition gates a complete static ability. */
/* @sem Ability::Conditional{condition:$condition_holder_unblocked, then:[$static_holder_assign_defender]} */
shared_conditional_static_action_if ::= "if" condition_holder_unblocked "," static_holder_assign_defender

/* @sem Ability::Conditional{condition:$condition, then:[$static_untap_each_other_untap]} */
shared_conditional_static_action_long ::= "as" "long" "as" condition "," static_untap_each_other_untap

/* The holder assigns to a permanent controlled by its defending player. */
/* @sem Change::[Rule(AssignDamageTo{permanents:AllOf([$noun, ControlledBy(One(DefendingPlayerOf(Source)))])})] */
change_assign_defending_permanent ::= "assign" "its" "combat" "damage" "to" "a" noun "defending" "player" "controls"

/* @sem Ability::Static{kind:Ordinary, affected:Objects(One(Source)), changes:$change_assign_defending_permanent} */
static_holder_assign_defender ::= "you" "may" "have" "it" change_assign_defending_permanent "."

/* The condition's player is the controller of the same attached object. */
/* @sem Ability::Conditional{condition:Not(PlayerState{player:ControllerOf($attached_ref), state:Monarch}), then:[Static{kind:Ordinary, affected:Objects(One($attached_ref)), changes:$rule_skip_untap_controller}]} */
attached_controller_untap_unless_monarch ::= attached_ref rule_skip_untap_controller "unless" "that" "player" "is" "the" "monarch" "."

/* A shared permission combines the spending wording with its typed uses. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:$permission_spending_clause}) */
permission_spend_any_color ::= "you" "may" "spend" permission_spending_clause "."

permission_spending_clause ::= permission_any_color_clause | permission_color_activation_clause

/* @sem Change::$permission_spending_uses */
permission_any_color_clause ::= "mana" "as" "though" "it" "were" "mana" "of" "any" "color" permission_spending_uses

permission_spending_uses ::= permission_activate_filtered | permission_cast_chosen_value | permission_foreign_cast_activate

/* @sem Change::[PlayerRule(SpendManaAs{spend_as:AnyColor, on:Abilities(AbilityOf($filter_plural))})] */
permission_activate_filtered ::= "to" "activate" "abilities" "of" filter_plural

/* @sem Change::[PlayerRule(SpendManaAs{spend_as:AnyColor, on:Spells(AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:ChosenNumber}}]))})] */
permission_cast_chosen_value ::= "to" "cast" filter_phrase "spells" "with" "mana" "value" "equal" "to" "the" "chosen" "number"

/* @sem Change::[PlayerRule(SpendManaAs{spend_as:AnyColor, on:Spells(OwnedBy(OthersThan(AbilityController)))}), PlayerRule(SpendManaAs{spend_as:AnyColor, on:Abilities(AbilityOf(AllOf([Any, $filter_plural, OwnedBy(OthersThan(AbilityController))])))})] */
permission_foreign_cast_activate ::= "to" "cast" "spells" "you" "don't" "own" "or" "to" "activate" "abilities" "of" filter_plural "but" "don't" "own"

/* @sem Change::[PlayerRule(SpendColorAs{color:$mana_color_word, on:Abilities(AbilityOf(SameObject($object_ref)))})] */
permission_color_activation_clause ::= mana_color_word "mana" "as" "though" object_ref "were" "mana" "of" "any" "color" "to" "pay" "the" "activation" "costs" "of" "this" "creature's" "abilities"

/* The plural subject is the population whose members must share a color. */
/* @sem Ability::Conditional{condition:SubsetMeets{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, comparison:Equal, amount:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}), constraints:[CommonProperty(Colors)]}, then:[Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}), changes:$static_changes}], otherwise:[]} */
shared_population_color_static ::= filter_plural static_changes "as" "long" "as" "they" "all" "share" "a" "color" "."

/* The adjacent condition refers to the same attacking population just granted a keyword. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Attacking, CardType(Creature), ControlledBy(One(AbilityController))])} */
attacking_creatures_you_control_group ::= "attacking" "creatures" "you" "control"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($attacking_creatures_you_control_group), changes:[GrantKeyword($keyword_value)], duration:$duration, evaluation:Snapshot}}, If{condition:SubsetMeets{objects:$attacking_creatures_you_control_group, comparison:Equal, amount:CountObjects($attacking_creatures_you_control_group), constraints:[TotalProperty{property:Power, comparison:GreaterOrEqual, amount:$value}]}, then:$then_condition_program, otherwise:Program{}}] */
instructions_attackers_grant_threshold ::= attacking_creatures_you_control_group "gain" keyword_value duration "." "if" "those" "creatures" "have" "total" "power" value "or" "greater" "," then_condition_program

/* The repeated color denotes the affected population in both positions. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($colored_creatures_plural, $colored_creature_singular)}), changes:[Rule(CombatCost{action:Attack(Any), payer:DeclaringPlayer, cost:$attack_sacrifice_payment})]}) */
static_colored_attack_sacrifice ::= colored_creatures_plural "can't" "attack" "unless" "their" "controller" attack_sacrifice_payment "for" "each" colored_creature_singular "they" "control" "that's" "attacking" "."

/* @sem ObjectFilter::AllOf([Color($mana_color_word), CardType(Creature)]) */
colored_creatures_plural ::= mana_color_word "creatures"

/* @sem ObjectFilter::AllOf([Color($mana_color_word), CardType(Creature)]) */
colored_creature_singular ::= mana_color_word "creature"

/* A source's explicitly enumerated added types define its characteristics. */
/* @sem Ability::Static(_{kind:CharacteristicDefining{contributes_to_color_identity:true}, affected:Objects(One(Source)), changes:[CreatureTypes{mode:Add, types:Listed($added_type_list)}]}) */
static_self_also_type_list ::= SELF_NAME "is" "also" "a" added_type_list "."

/* @sem CreatureType::[@subtype_name($subtype), @subtype_name($subtype_2), @subtype_name($subtype_3), @subtype_name($subtype_4)] */
added_type_list ::= subtype "," subtype "," subtype "," "and" subtype

/* The follow-up grants a new keyword after removing the old abilities. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[...$base_subtypes, RemoveAllAbilities, GrantKeyword($keyword_value)]}) */
static_type_base_keyword_loss ::= affected "is" base_subtypes "." "it" "has" keyword_value "and" "loses" "all" "other" "abilities" "."

/* The later loss removes other abilities; the written keyword is retained. */
/* @sem Change::[...$base_artifact_creature, RemoveAllAbilities, GrantKeyword($keyword_value)] */
static_artifact_base_keyword_loss ::= "is" base_artifact_creature "and" "has" keyword_value "," "and" "it" "loses" "all" "other" "abilities" "," "card" "types" "," "and" "creature" "types"

/* A counter-qualified exile population independently supplies copied traits. */
/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_phrase, Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})])}) */
shared_countered_exile_flying_an ::= "as" "long" "as" "an" "exiled" filter_phrase "card" "with" "a" counter_kind "counter" "on" "it" "has" "flying"

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[GainAbilitiesOf{objects:$shared_countered_exile_flying_an, kinds:$craft_shared_traits}]}) */
static_countered_exile_shared_traits ::= shared_countered_exile_flying_an "," affected craft_shared_traits "."

/* @sem PlayerSet::OpponentsOf(AbilityController) */
target_choice_opponents ::= "while" "an" "opponent" "is" "choosing" "targets" "as" "part" "of" "casting" "a" "spell" "they" "control" "or" "activating" "an" "ability" "they" "control"

/* @sem PlayerRule::TargetsMustInclude($filter_phrase) */
target_choice_requirement ::= "that" "player" "must" "choose" "at" "least" "one" filter_phrase "on" "the" "battlefield" "if" "able"

/* @sem Ability::Static{kind:Ordinary, affected:Players($target_choice_opponents), changes:[PlayerRule($target_choice_requirement)]} */
static_target_choice_requirement ::= target_choice_opponents "," target_choice_requirement "."

/* Copy each listed ability from the controlled matching population. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[GainAbilitiesOf{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController))])}, kinds:List([Term{family:CheckHasable, form:Flying}, ...$sharing_kind_tail])}], duration:$duration, evaluation:Snapshot}}] */
share_controlled_flying_singular ::= affected "gains" "flying" duration "if" "you" "control" "a" filter_phrase "with" "flying" "." "the" "same" "is" "true" "for" sharing_kind_tail

/* @sem Cost::Cost{parts:[Life($value)]} */
attack_planeswalker_payment_life ::= value "life" "for" "each" "of" "those" "creatures"

/* Combat restrictions apply to the live affected population. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$attack_you_or_planeswalkers_cost_rule, duration:$duration, evaluation:LiveObjects} */
duration_affected_attack_cost ::= duration "," affected attack_you_or_planeswalkers_cost_rule

/* The two changes share a target and a turn-long snapshot. The counted
   population and both pairs of signed values remain independent operands. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($target_object)), changes:$additional_count_pump_changes, duration:EndOfTurn, evaluation:Snapshot} */
continuous_target_additional_count_pump ::= target_object additional_count_pump_changes

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}, Pump{power:@times($signed_3, $count_controlled_population), toughness:@times($signed_4, $count_controlled_population)}] */
additional_count_pump_changes ::= "gets" signed "/" signed "until" "end" "of" "turn" "." "it" "gets" "an" "additional" signed "/" signed "until" "end" "of" "turn" "for" "each" count_controlled_population

/* A singular target receives a live rule restriction and a separately fixed
   characteristic change; their durations and target remain independent. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_object)), changes:$rule_change, duration:$this_turn, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_object)), changes:$retained_singular_type, duration:$duration, evaluation:Snapshot}}] */
clause_rule_type_pair ::= target_object rule_change this_turn "and" retained_singular_type duration

/* @sem Change::[CreatureTypes{mode:Add, types:Listed($becomes_types)}] */
retained_singular_type ::= "becomes" "a" becomes_types "in" "addition" "to" "its" "other" "types"

/* @sem Instruction::[...$clause_rule_type_pair, ...$instructions] */
instructions_rule_type_newline ::= clause_rule_type_pair "." NEWLINE instructions

/* @sem Mechanic::Buyback */
universal_buyback_keyword ::= "buyback"

unqualified_payment_keyword ::= universal_payment_keyword | universal_buyback_keyword

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(KeywordCost{keyword:$unqualified_payment_keyword, cards:Any, change:$keyword_payment_change})]}) */
static_unqualified_keyword_payment ::= unqualified_payment_keyword "costs" "cost" keyword_payment_change "."

/* The prohibition wording applies to the previously selected permanent. */
/* @sem Change::[Rule(Prohibit(Attack(Any))), Rule(Prohibit(Block(Any))), Rule(Prohibit(Activate(Any)))] */
chosen_permanent_combat_activation_restrictions ::= "it" "can't" "attack" "or" "block" "," "and" "its" "activated" "abilities" "can't" "be" "activated"

/* A shared duration applies to two independently affected populations. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($object_ref)), changes:$singular_pump, duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}), changes:[$grant_keyword], duration:$duration, evaluation:Snapshot}}] */
clause_shared_temporary_changes ::= object_ref singular_pump "and" filter_plural "gain" grant_keyword duration

/* Both effects use the same creature population; the second governs how those
   creatures block, independently of the blocking requirement itself. */
/* @sem ObjectFilter::AllOf([CardType(Creature), $plural_control_modifier]) */
blocking_controlled_creatures ::= "creatures" plural_control_modifier

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$blocking_controlled_creatures}), changes:[Rule(RequireCombat{action:Block(Any), amount:AtLeast(Constant(1))})], duration:$this_duration, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Decides(HowCreaturesBlock($blocking_controlled_creatures)))], duration:$this_duration, evaluation:LiveObjects}}] */
clause_blocking_population_choice ::= blocking_controlled_creatures "block" this_duration "if" "able" "," "and" "you" "choose" "how" "those" "creatures" "block"

/* A plural population can become a named creature with granted keywords. */
/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, AddCardType(Creature), ...$grants] */
plural_animation_with_grants ::= "become" value "/" value becomes_types "creatures" "with" grants

/* An animation can specify a different base size under a condition. Both
   branches retain the artifact and creature type additions. */
/* @sem Change::[AddCardType(Artifact), AddCardType(Creature), SetBasePowerToughness{power:$value, toughness:$value_2}] */
change_becomes_artifact_creature_base ::= "becomes" "an" "artifact" "creature" "with" "base" "power" "and" "toughness" value "/" value

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}] */
change_artifact_animation_alternative_base ::= "has" "base" "power" "and" "toughness" value "/" value

/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($object_one)), changes:[AddCardType(Artifact), AddCardType(Creature), ...$change_artifact_animation_alternative_base], duration:EndOfTurn, evaluation:Snapshot}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($object_one)), changes:$change_becomes_artifact_creature_base, duration:EndOfTurn, evaluation:Snapshot}}]}}] */
instead_artifact_animation ::= "until" "end" "of" "turn" "," object_one change_becomes_artifact_creature_base "." "if" condition "," "it" change_artifact_animation_alternative_base "until" "end" "of" "turn" "instead"

/* Replace color words on a controlled enchantment and grant it upkeep.
   Both the target color and upkeep cost remain independent operands. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:ColorWord, terms:_{count:Exactly(Constant(2)), options:[]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$adjective_color, CardType(Enchantment), ControlledBy(One(AbilityController)), Not(HasKeywordFamily(CumulativeUpkeep))])}), index:0})), changes:[ReplaceWord{from:Vocabulary{family:ColorWord, form:TheFirstChosenColorWord}, to:Vocabulary{family:ColorWord, form:TheSecondChosenColorWord}}, GrantAbility(Mechanic{mechanic:CumulativeUpkeep, cost:_{parts:[Mana($mana_symbols)]}})], duration:Indefinite, evaluation:Snapshot}}] */
color_word_upkeep_program ::= "change" "the" "text" "of" "target" adjective_color "enchantment" "you" "control" "that" "doesn't" "have" "cumulative" "upkeep" "by" "replacing" "all" "instances" "of" "one" "color" "word" "with" "another" "." "that" "enchantment" "gains" '"' "cumulative" "upkeep" mana_symbols "." '"'

/* One selected ability moves between distinct targets for the stated duration. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, Chosen(Ability)])}), index:0})), changes:[LosesAbility(Term{family:CheckHasable, form:TheChosenAbility})], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(SameObject(Target{slot:0, index:0})), $noun_2])}), index:0})), changes:[ChosenAbility], duration:$duration, evaluation:Snapshot}}] */
chosen_ability_transfer_program ::= duration "," "target" noun "with" "the" "chosen" "ability" "loses" "it" "and" "another" "target" noun "gains" "it" "."

/* Both follow-ups refer to the control effect’s captured population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([AnyOf([State(Goaded), State(Suspected)]), CardType(Creature)])} */
control_all_untap_goaded_or_suspected ::= "all" "goaded" "and/or" "suspected" "creatures"

/* A shared stat-and-color description keeps both numerical operands editable. */
/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, Colors{mode:Set, colors:[$mana_color_word]}] */
colored_plural_stats ::= value "/" value mana_color_word

/* The land remains a land while the creature card type is added. */
/* @sem Change::[...$colored_plural_stats, AddCardType(Creature)] */
retained_colored_land_animation ::= "are" colored_plural_stats "creatures" "that" "are" "still" "lands"

/* Both type additions are explicit, and each subtype is its own operand. */
/* @sem Change::[...$colored_plural_stats, CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Creature), AddLandType($retained_land_singular), AddCardType(Land)] */
retained_colored_dual_animation ::= "are" colored_plural_stats becomes_types "creatures" "and" retained_land_singular "lands" "in" "addition" "to" "their" "other" "types"

/* A plural animation composes its type and stats with the ordinary grant list.
   An explicit retention note applies its own inverse transformation. */
/* @sem Change::[...$plural_named_animation, ...$grants] */
plural_granted_animation ::= plural_named_animation "with" grants

/* The counted objects share a creature type with the trigger's subject. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(EventSubject)), $noun, ControlledBy(One(ControllerOf(EventSubject))), Shares{property:CreatureTypes, with:EventSubject}])}) */
shared_attacker_controller_count ::= "other" noun "its" "controller" "controls" "that" "shares" "a" "creature" "type" "with" "it"

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(EventSubject)), Attacking, $noun, Shares{property:CreatureTypes, with:EventSubject}])}) */
shared_attacking_type_count ::= "other" "attacking" noun "that" "shares" "a" "creature" "type" "with" "it"

shared_event_type_count ::= shared_attacker_controller_count | shared_attacking_type_count | other_attacking_event_subtype_count

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(EventSubject)), changes:[Pump{power:@times($signed, $shared_event_type_count), toughness:@times($signed_2, $shared_event_type_count)}], duration:$duration, evaluation:Snapshot}}]} */
shared_event_subject_count_pump ::= "it" "gets" signed "/" signed duration "for" "each" shared_event_type_count

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$shared_event_subject_count_pump} */
shared_event_subject_count_trigger ::= event_clause "," shared_event_subject_count_pump "."

/* Each affected attacker has its own defending player. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController)), ObjectFilter::AttackingDefender(Players(All)))} */
affected_each_controlled_attacking_player ::= "each" filter_phrase "you" "control" "attacking" "a" "player"

/* Keep the defender-relative count inside the attacker population's scope. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($affected_each_controlled_attacking_player), changes:[Pump{power:@times($signed, Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(PlayerRef::DefendingPlayerOf(Affected))))})), toughness:@times($signed_2, Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(PlayerRef::DefendingPlayerOf(Affected))))}))}], duration:$duration, evaluation:Snapshot} */
continuous_attacker_defender_count ::= affected_each_controlled_attacking_player "gets" signed "/" signed duration "for" "each" filter_phrase "that" "player" "controls"

/* The quoted sentence closes the static effect and introduces its own holder. */
/* @sem Ability::Conditional{condition:$shared_static_step_window, then:[$static_quoted_grant]} */
shared_step_quoted_static ::= shared_static_step_window "," static_quoted_grant

shared_static_step_window ::= window_during_your_end_step | window_during_your_upkeep_step

/* Temporary play permissions share their linked populations with other clauses.
   The explicit self reference proves that the effect source and link coincide. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:$permission_self_owned_linked, from:Exile, action:Either, filter:Any})], duration:$duration, evaluation:LiveObjects} */
linked_self_owned_play ::= duration "," "you" "may" "play" permission_self_owned_linked

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$permission_self_linked_single, from:Exile, action:Either, filter:Any}, terms:_{limit:Total(1), cost:Normal}})], duration:$duration, evaluation:LiveObjects} */
linked_self_single_play ::= duration "," "you" "may" "play" permission_self_linked_single

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$permission_self_linked_single, from:Exile, action:Either, filter:Any}, terms:_{limit:Total(1), cost:Free}})], duration:$duration, evaluation:LiveObjects} */
linked_self_single_play_free ::= duration "," "you" "may" "play" permission_self_linked_single "without" "paying" "its" "mana" "cost"

/* The event amount and its consumer are scoped to the same resolving mana ability. */
/* @sem Ability::Triggered{event:$holder_mana_resolution, limits:_{per_turn:1}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$holder_mana_counter_placement}]}} */
holder_mana_counter_trigger ::= holder_mana_resolution "," holder_mana_counter_placement "." "this" "ability" "triggers" "only" "once" "each" "turn" "."

/* @sem EventSpec::Resolves(AllOf([OnStack(Mana), AbilityOf(SameObject(Source))])) */
holder_mana_resolution ::= "whenever" "a" "mana" "ability" "of" "this" "creature" "resolves"

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(One(Source)), kind:$counter_kind, amount:EventAmount}]} */
holder_mana_counter_placement ::= "put" "a" "number" "of" counter_kind "counters" "on" "it" "equal" "to" "the" "amount" "of" "mana" "this" "creature" "produced"

/* @sem Change::[$shared_granted_activation_open, $granted_aim_removal_damage] */
closed_activation_aim_pair ::= shared_granted_activation_open "and" granted_aim_removal_damage

/* The named counter in the damage sentence is exactly the one removed in
   this activation's second payment component. The complete activation keeps
   that proof local, including the holder and the named granting object. */
/* @sem Change::GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[TapSymbol, RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($self_explicit_ref)), kind:Named(AimCounter), amount:All}]}]}, limits:_{}, body:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any})), amount:PaidCountersRemoved{payment:Activation, component:[1]}, preventable:true}}]}, announcement:@announcement})) */
granted_aim_removal_damage ::= '"' "{" "T" "}" "," "↑" "remove" "all" "aim" "counters" "from" self_explicit_ref ":" "this" "creature" "deals" "damage" "to" "any" "target" "equal" "to" "the" "number" "of" "aim" "counters" "removed" "this" "way" "." '"'

/* Joined land and spell permissions share the top card, while the cast terms
   apply only to the spell permission. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[...$top_play_lands, $top_cast_with_terms]}) */
static_top_lands_and_cast_terms ::= "you" "may" top_play_lands "and" top_cast_with_terms "."

/* @sem Change::PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, from:Library, action:CastSpell, filter:$cast_spells_filter}, terms:$top_library_cast_terms}) */
top_cast_with_terms ::= "cast" cast_spells_filter "from" "the" "top" "of" "your" "library" "." top_library_cast_terms

top_library_cast_terms ::= top_library_life_terms | top_library_entry_terms

/* @sem PlayTerms::PlayTerms{cost:Alternate(Cost{parts:[LifeEqualToOwnManaValue]})} */
top_library_life_terms ::= "if" "you" "cast" "a" "spell" "this" "way" "," "pay" "life" "equal" "to" "its" "mana" "value" "rather" "than" "pay" "its" "mana" "cost"

/* @sem PlayTerms::PlayTerms{cost:Normal, effects:[Filter($filter_phrase), List([$next_flash_entry_counter])]} */
top_library_entry_terms ::= "if" "you" "cast" "a" filter_phrase "spell" "this" "way" "," next_flash_entry_counter

/* Each permission ranges over the top card of each player's library. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[...$any_library_play_lands, ...$any_library_cast_spells]}) */
static_any_library_permissions ::= "you" "may" any_library_play_lands "and" any_library_cast_spells "from" "the" "top" "of" "any" "player's" "library" "."

/* @sem Change::[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:LibraryTops(All), from:Library, action:PlayLand, filter:Any}, terms:_{cost:Normal}})] */
any_library_play_lands ::= "play" "lands"

/* @sem Change::[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:LibraryTops(All), from:Library, action:CastSpell, filter:$cast_spells_filter}, terms:_{cost:Normal}})] */
any_library_cast_spells ::= "cast" cast_spells_filter

/* Plot access keeps the card filter as an operand. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[$top_library_plot_access]}) */
static_top_library_plot ::= "you" "may" top_library_plot_access "."

/* @sem Change::PlayerRule(KeywordAccess{keyword:Plot, cards:$adjective_nontype, from:Library}) */
top_library_plot_access ::= "plot" adjective_nontype "cards" "from" "the" "top" "of" "your" "library"

/* A self animation replaces creature types and grants the quoted ability. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[CreatureTypes{mode:Set, types:Listed($becomes_types)}, GrantAbility(@scope($quoted_damage_ring_threshold))], duration:Indefinite, evaluation:Snapshot} */
self_type_quoted_damage_animation ::= "it" "becomes" "a" becomes_types "with" '"' quoted_damage_ring_threshold '"'

/* Keep a protection exception with the preceding change in the same static ability. */
/* @prefer always */
/* @sem Change::[...$static_change, ...$change_protection_keeps] */
static_changes_protection_keeps ::= static_change "and" change_protection_keeps

/* @sem Operand::Term{family:ProtectableColor, form:AnyColor} */
protectable_each_color ::= "each" "color"

/* The exclusion refers to the source, while the defender retains the player reference. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), $filter_plural, ControlledBy(One(AbilityController)), AttackingDefender(Players($players_singular))])} */
affected_other_controlled_attacking_player ::= "other" filter_plural "you" "control" "attacking" players_singular

/* A graveyard population can supply each ability in a shared keyword list. */
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase} */
sharing_graveyard_card ::= "a" filter_phrase "card" "in" "your" "graveyard"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[GainAbilitiesOf{objects:$sharing_graveyard_card, kinds:List([Term{family:CheckHasable, form:Flying}, ...$sharing_kind_tail])}], duration:$duration, evaluation:Snapshot}}] */
share_graveyard_flying ::= affected "gain" "flying" duration "if" sharing_graveyard_card "has" "flying" "." "the" "same" "is" "true" "for" sharing_kind_tail

/* @sem Operand::Term{family:CheckHasable, form:Shroud} */
sharing_shroud ::= "shroud"

/* A matching card population supplies the listed abilities independently. */
shared_graveyard_flying_card ::= shared_graveyard_flying_a | shared_graveyard_flying_an

/* @sem ObjectSet::Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$filter_phrase}) */
shared_graveyard_flying_a ::= "as" "long" "as" "a" filter_phrase "card" "with" "flying" "is" "in" "a" "graveyard"

/* @sem ObjectSet::Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$filter_phrase}) */
shared_graveyard_flying_an ::= "as" "long" "as" "an" filter_phrase "card" "with" "flying" "is" "in" "a" "graveyard"

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[GainAbilitiesOf{objects:$shared_graveyard_flying_card, kinds:List([Term{family:CheckHasable, form:Flying}, ...$sharing_kind_tail])}]}) */
static_graveyard_shared_flying ::= shared_graveyard_flying_card "," affected "has" "flying" "." "the" "same" "is" "true" "for" sharing_kind_tail "."

/* A temporary grant may state that the granted mechanic costs the holder's mana cost. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($encore_grant_subject)), changes:[GrantAbility($encore_own_mana_grant)], duration:$duration, evaluation:Snapshot} */
continuous_grant_own_mana_cost ::= encore_grant_subject "gains" encore_own_mana_grant duration "." "the" "encore" "cost" "is" "equal" "to" "its" "mana" "cost"

/* @sem Ability::Mechanic{mechanic:Encore, cost:_{parts:[ManaCostOf(Source)]}} */
encore_own_mana_grant ::= "encore"

encore_grant_subject ::= encore_grant_owned_target | affected

/* @prefer always */
/* @sem ObjectSet::One($choose_cast_graveyard_target) */
encore_grant_owned_target ::= choose_cast_graveyard_target

/* A temporary permission for the current top graveyard card; the replacement
   applies to spells cast through this permission. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:$top_graveyard_cast_redirect, duration:$duration, evaluation:LiveObjects} */
temporary_top_graveyard_cast_redirect ::= duration "," "you" "may" top_graveyard_cast_redirect

/* @sem Change::[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, from:Graveyard, action:CastSpell, filter:$cast_spells_filter}, terms:_{cost:Normal, into_exile:true}})] */
top_graveyard_cast_redirect ::= "cast" cast_spells_filter "from" "the" "top" "of" "your" "graveyard" "." "if" "a" "spell" "cast" "this" "way" "would" "be" "put" "into" "a" "graveyard" "," "exile" "it" "instead"

becomes_creature_subtype ::= creature_subtype | st_assemblyworker_hyphen

/* Retain all existing types while adding the independently selected land type. */
/* @sem Change::[AddLandType(Island)] */
shared_add_island_type ::= "becomes" "an" "Island" "in" "addition" "to" "its" "other" "types"

/* @sem Change::[AddLandType($retained_land_singular)] */
/* @prefer always */
shared_add_basic_land_type ::= "becomes" "a" retained_land_singular "in" "addition" "to" "its" "other" "types"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[AddCardType(Artifact), AddCardType(Creature)], duration:Indefinite, evaluation:Snapshot} */
indefinite_artifact_creature ::= affected "becomes" "an" "artifact" "creature"

/* The recipient holds the mechanic; its Source in the cost is that holder. */
/* @sem Ability::Mechanic{mechanic:Embalm, cost:Cost{parts:[ManaCostOf(Source)]}} */
temporary_embalm_own_mana ::= "embalm"

/* Subject and duration compose independently with the granted ability. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($temporary_grant_subject)), changes:[GrantAbility(@holder($temporary_embalm_own_mana))], duration:$duration, evaluation:Snapshot} */
temporary_grant_equal_own_mana ::= temporary_grant_subject "gains" temporary_embalm_own_mana duration "." "the" "embalm" "cost" "is" "equal" "to" "its" "mana" "cost"

/* This sentence's conventional in-zone wording is local to this grant. */
temporary_grant_subject ::= temporary_grant_target_in_graveyard | affected

/* @prefer always */
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and($card_filter, ObjectFilter::InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}))}), index:0}) */
temporary_grant_target_in_graveyard ::= "target" card_filter "card" "in" "your" "graveyard"

/* Choose one member of a stated pool and apply a shared defined pump. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$choice_ref_or_controlled_named, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[Pump{power:$value, toughness:$value}], duration:$duration, evaluation:Snapshot}}] */
instructions_choice_union_defined_pump ::= choice_ref_or_controlled_named "gets" "+" "X" "/" "+" "X" duration "," "where" "X" "is" value

/* An animated artifact can gain two keywords and a separately scoped static ability. */
/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, AddCardType(Artifact), AddCardType(Creature), GrantKeyword($keyword_value), GrantKeyword($keyword_value_2), GrantAbility(Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes}))] */
indefinite_artifact_keyword_static_animation ::= "a" value "/" value becomes_types "artifact" "creature" "and" "gains" keyword_value "," keyword_value "," "and" '"' affected static_changes "." '"'

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$indefinite_artifact_keyword_static_animation, duration:Indefinite, evaluation:Snapshot} */
indefinite_animated_quoted_static ::= affected "becomes" indefinite_artifact_keyword_static_animation

/* The two attack restrictions retain the controller and controlled population. */
/* @sem Change::[Rule(Prohibit(Attack(Players(One(AbilityController))))), Rule(Prohibit(Attack(Objects(AllOf([$controlled_attack_noun, ControlledBy(One(AbilityController))])))))] */
change_cant_attack_you_or_controlled ::= "can't" "attack" "you" "or" "a" controlled_attack_noun "you" "control"

controlled_attack_noun ::= noun_permanent | noun_creature | noun_land | noun_planeswalker | noun_token | noun_battle

/* @sem Change::[Rule(Prohibit(Block(AllOf([$filter_plural, ControlledBy(One(AbilityController))]))))] */
change_cant_block_controlled ::= "can't" "block" filter_plural "you" "control"

/* @sem Change::[...$change_is_goaded, ...$change_cant_attack_you_or_controlled, ...$change_cant_block_controlled] */
returned_creature_combat_changes ::= change_is_goaded "," change_cant_attack_you_or_controlled "," "and" change_cant_block_controlled

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:$returned_creature_combat_changes, duration:WhileMatches{object:Result{result:@prior, phase:After, index:0}, filter:Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})}, evaluation:LiveObjects} */
returned_creature_counter_combat ::= "for" "as" "long" "as" "that" "creature" "has" "a" counter_kind "counter" "on" "it" "," "it" returned_creature_combat_changes

/* Scope the anaphoric result to the immediately preceding return. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$return_opponent_card_with_counter}, Effect{result:@next, operation:$returned_creature_counter_combat}]}} */
spell_return_counter_combat ::= return_opponent_card_with_counter "." returned_creature_counter_combat "."

/* The target and duration compose independently of the granted card's cost. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members(ObjectSet::One($harmonize_grant_subject))), changes:[GrantAbility(Mechanic{mechanic:Harmonize, cost:$harmonize_own_mana_cost})], duration:$duration, evaluation:Snapshot} */
temporary_harmonize_mana_cost ::= harmonize_grant_subject "gains" "harmonize" duration harmonize_own_mana_cost

/* @sem Cost::Cost{parts:[ManaCostOf(Source)]} */
harmonize_own_mana_cost ::= "." "its" "harmonize" "cost" "is" "equal" "to" "its" "mana" "cost"

/* Prefer the in-zone wording for this grant without changing other card targets. */
harmonize_grant_subject ::= harmonize_target_in_your_graveyard | object_ref

/* @prefer always */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and($card_filter, ObjectFilter::InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}))}), index:0} */
harmonize_target_in_your_graveyard ::= "target" card_filter "card" "in" "your" "graveyard"

owned_commander_granted_ability ::= shared_granted_trigger_closed | shared_quoted_room_rule

/* The quoted rule belongs to each granted ability holder. */
/* @sem Change::GrantAbility($shared_room_retrigger_rule) */
shared_quoted_room_rule ::= '"' shared_room_retrigger_rule '"'

/* @sem Ability::TriggerRule{abilities:$shared_room_ability_population, rule:$room_trigger_behavior} */
shared_room_retrigger_rule ::= shared_room_ability_population room_trigger_behavior "."

/* A dungeon's room abilities are controlled by the player who owns it. */
/* @sem ObjectFilter::AllOf([OnStack(DungeonRoom), ControlledBy($room_dungeon_owner)]) */
shared_room_ability_population ::= "Room" "abilities" "of" "dungeons" room_dungeon_owner

/* @sem Ability::Conditional{condition:ObjectMatches{object:Source, filter:Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})}, then:[Static(_{kind:Ordinary, affected:Objects(One(Source)), changes:[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})]})]} */
counter_untap_granted ::= "this" "creature" "doesn't" "untap" "during" "your" "untap" "step" "if" "it" "has" "a" counter_kind "counter" "on" "it"

/* @sem Ability::Triggered{event:Turn{point:UpkeepBegins, players:One(AbilityController)}, limits:_{}, body:_{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One(Source)), kind:$counter_kind, amount:Count(Exactly(Constant(1)))}]}}]}, announcement:@announcement} */
counter_upkeep_granted ::= "at" "the" "beginning" "of" "your" "upkeep" "," "remove" "a" counter_kind "counter" "from" "this" "creature" "."

/* The prior target is captured before the distinct blocking target is announced. */
/* @sem ObjectRef::Target{slot:@last_slot, index:0} */
combat_prior_target ::= ("↓")?

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($target_another)), changes:[Rule(RequireCombat{action:Block(SameObject($combat_prior_target)), amount:AtLeast(Constant(1))})], duration:$this_duration, evaluation:LiveObjects} */
combat_another_target_blocks_prior ::= combat_prior_target target_another "blocks" "it" this_duration "if" "able"

/* A quoted static cost rule is granted to each owned commander holder. */
/* @sem Change::GrantAbility(@holder($static_ordered_spell_cost)) */
quoted_ordered_spell_cost_grant ::= '"' static_ordered_spell_cost '"'

/* @sem Ability::Static{kind:Ordinary, affected:Objects($owned_commander_plural), changes:[$quoted_ordered_spell_cost_grant]} */
owned_commander_quoted_cost ::= owned_commander_plural "have" quoted_ordered_spell_cost_grant

/* An unqualified quoted static grant retains the granted ability's subject. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[GrantAbility($static_postposed_cleanup)], duration:Indefinite, evaluation:Snapshot} */
continuous_quoted_static_indefinite ::= affected "gains" '"' static_postposed_cleanup '"'

/* The leading duration scopes both the pump and the selected ability. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Ability, terms:_{count:Exactly(Constant(1)), options:$pump_keyword_options}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:$signed, toughness:$signed_2}, ChosenAbility], duration:$duration, evaluation:Snapshot}}] */
clause_prefix_pump_keyword_choice ::= duration "," affected "gets" signed "/" signed "and" "gains" "your" "choice" "of" pump_keyword_options

/* Options carry the full keyword value, including qualified protection. */
pump_keyword_options ::= pump_keyword_pair | pump_keyword_many

/* @sem Operand::[Ability(Keyword($keyword_value)), Ability(Keyword($keyword_value_2))] */
pump_keyword_pair ::= keyword_value "or" keyword_value

/* @sem Operand::[Ability(Keyword($keyword_value)), ...$pump_keyword_tail] */
pump_keyword_many ::= keyword_value "," pump_keyword_tail

pump_keyword_tail ::= pump_keyword_last | pump_keyword_options

/* @sem Operand::[Ability(Keyword($keyword_value))] */
pump_keyword_last ::= "or" keyword_value

/* A named creature target is the antecedent of each subsequent color test. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:@and($noun_creature, $modifier_you_control)})) */
chosen_creature_target ::= "up" "to" "one" "target" noun_creature modifier_you_control

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}] */
chosen_creature_pump ::= "gets" signed "/" signed

/* @sem $grants */
chosen_creature_grant ::= "gains" grants

/* @sem Instruction::If{condition:ObjectMatches{object:Target{slot:@last_slot, index:0}, filter:$adjective_color}, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Targets(@last_slot)), changes:$chosen_creature_grant, duration:EndOfTurn, evaluation:Snapshot}}]}, otherwise:Program{}} */
chosen_creature_color_grant ::= chosen_creature_grant "if" "it's" adjective_color

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($chosen_creature_target), changes:$chosen_creature_pump, duration:EndOfTurn, evaluation:Snapshot}}, $chosen_creature_color_grant, $chosen_creature_color_grant_2] */
instructions_chosen_creature_changes ::= "choose" chosen_creature_target "." "until" "end" "of" "turn" "," "that" "creature" chosen_creature_pump "," chosen_creature_color_grant "," "and" chosen_creature_color_grant

/* A timed characteristic change is reusable in either arm of a conditional. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$static_changes, duration:$duration, evaluation:Snapshot}}]} */
timed_characteristic_program ::= affected static_changes duration

/* @sem Instruction::[If{condition:$condition, then:$timed_characteristic_program_2, otherwise:$timed_characteristic_program}] */
instructions_conditional_timed_alternative ::= timed_characteristic_program "." "if" condition "," timed_characteristic_program "instead"

/* @prefer always */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, AnyOf([BlockingObject($self_explicit_ref), BlockedByObject($self_explicit_ref)])])}), index:0} */
combat_opposing_target_plain ::= "target" noun "blocking" "or" "blocked" "by" self_explicit_ref

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, AnyOf([BlockingObject($self_explicit_ref), BlockedByObject($self_explicit_ref)])])}), index:0} */
combat_opposing_target_being ::= "target" noun "blocking" "or" "being" "blocked" "by" self_explicit_ref

/* The two assignments share their target and end-of-turn snapshot. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_possessive)), changes:[SetPower(Subtract([ObjectProperty{object:$combat_opposing_target, property:Toughness, information:CurrentOrLastKnown}, $number_digits])), SetToughness(Add([$number_digits_2, $combat_relative_power_ref]))], duration:EndOfTurn, evaluation:Snapshot} */
combat_relative_stats ::= self_possessive "power" "becomes" "the" "toughness" "of" combat_opposing_target "minus" number_digits "until" "end" "of" "turn" "," "and" "its" "toughness" "becomes" number_digits "plus" combat_relative_power_ref "until" "end" "of" "turn"

/* The second characteristic refers to the previously announced target. */
/* @sem Expr::ObjectProperty{object:@named_object, property:Power, information:CurrentOrLastKnown} */
combat_relative_power_ref ::= "the" "power" "of" "that" "creature"

/* The repeated plural population is shared by both pumps. The mana payment
   retains its own payer and result; neither pump inherits its amount. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected_plural)), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:PayCost{player:FirstWilling(All), cost:Cost{parts:[$cost_mana]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected_plural)), changes:[Pump{power:$signed_3, toughness:$signed_4}], duration:$duration_2, evaluation:Snapshot}}]}, otherwise:Program{}}] */
clause_plural_pump_unless_payment ::= affected_plural "get" signed "/" signed duration "." "they" "get" "an" "additional" signed "/" signed duration "unless" "any" "player" "pays" cost_mana

/* The same referenced object is excluded and supplies the creature types compared. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject($object_ref)), $filter_phrase, ControlledBy(One(AbilityController)), Shares{property:CreatureTypes, with:$object_ref}])}) */
shared_other_controlled_sharing_creature_type_count ::= "other" filter_phrase "you" "control" "that" "shares" "a" "creature" "type" "with" object_ref

/* @sem ObjectFilter::AllOf([$filter_plural, ControlledBy(One(EnchantedBy(Source)))]) */
entry_enchanted_player_controlled ::= filter_plural "enchanted" "player" "controls"

/* An Aura conversion grants two independently scoped activations to its host. */
/* @sem Change::[SetCardTypes([Enchantment]), AddEnchantmentType(Vocabulary{family:EnchantmentType, form:Aura}), GrantAbility(Enchant{hosts:Permanents($filter_phrase)}), GrantAbility(Static(_{kind:Ordinary, affected:Objects($affected), changes:[GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program})), GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:$cost_2, limits:_{}, announcement:@announcement, body:$program_2}))]}))] */
aura_two_activations_changes ::= "an" "Aura" "enchantment" "with" "enchant" filter_phrase "and" '"' affected "has" "'" cost ":" program "'" "and" "'" cost ":" program "." "'" '"'

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:$aura_two_activations_changes, duration:Indefinite, evaluation:Snapshot} */
prior_result_aura_two_activations ::= "it's" aura_two_activations_changes

/* The random color excludes the same object that receives protection.
   The quality can be reused by other bounded grants with the same antecedent. */
/* @sem Change::GrantKeyword(Protection(Objects(_{kind:Any, filter:Chosen(Color)}))) */
random_unprotected_color_quality ::= "protection" "from" "a" "color" "chosen" "at" "random" "from" "colors" "it" "doesn't" "have" "protection" "from"

/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{except:[Object($object_ref)], random:true, count:Exactly(Constant(1))}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($object_ref)), changes:[$random_unprotected_color_quality], duration:$duration, evaluation:Snapshot}}] */
instructions_random_unprotected_color ::= duration "," object_ref "gains" random_unprotected_color_quality

/* The compared population is independent of the recipient of the landwalk. */
/* @sem ObjectFilter::SharesWithAny{property:BasicLandTypes, with:$affected} */
basic_land_types_among ::= "for" "each" "basic" "land" "type" "among" affected

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($static_affected), changes:[GrantKeyword(Landwalk($basic_land_types_among))]}) */
static_among_landwalk_has ::= basic_land_types_among "," static_affected "has" "landwalk" "of" "that" "type" "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($static_affected), changes:[GrantKeyword(Landwalk($basic_land_types_among))]}) */
static_among_landwalk_have ::= basic_land_types_among "," static_affected "have" "landwalk" "of" "that" "type" "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Ability, terms:_{count:Exactly(Constant(1)), options:[Ability(Keyword($keyword_name)), Ability(Keyword($keyword_name_2))]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject(Source), SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo($number), filter:AllOf([Not(SameObject(Source)), $noun, ControlledBy(One(AbilityController))])}), index:0})])}), changes:[ChosenAbility], duration:$duration, evaluation:Snapshot}}]} */
shared_source_and_other_choice ::= "this" "creature" "and" "up" "to" number "other" "target" noun "you" "control" "both" "gain" "your" "choice" "of" keyword_name "or" keyword_name duration

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo($number), filter:AllOf([AnyOf([$noun, CardType(Creature), $noun_2]), ControlledBy(OpponentsOf(AbilityController))])}), index:0})), changes:[RemoveAllAbilities], duration:$duration, evaluation:Snapshot}}, If{condition:ObjectMatches{object:Target{slot:0, index:0}, filter:CardType(Creature)}, then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:0, index:0})), changes:[SetBasePowerToughness{power:$number_2, toughness:$number_3}], duration:$duration_2, evaluation:Snapshot}}]}, otherwise:_{}}]} */
shared_target_ability_loss_conditional_base ::= "up" "to" number "target" noun "," "creature" "," "or" noun "an" "opponent" "controls" "loses" "all" "abilities" duration "." "if" "it's" "a" "creature" "," "it" "also" "has" "base" "power" "and" "toughness" number "/" number duration

fronted_permission_duration ::= until_end_of_combat_next_turn | until_end_of_turn | until_end_of_combat | until_end_of_your_next_turn

/* @sem Duration::EndOfCombatOnNextTurn(PlayerRef::AbilityController) */
until_end_of_combat_next_turn ::= "until" "end" "of" "combat" "on" "your" "next" "turn"

/* Singular cast-spell subjects carry their filter independently of the rule. */
spell_cast_singular_filter ::= spell_cast_named_filter | spell_cast_color_pair | spell_cast_exact_colors

/* @sem ObjectFilter::$filter_phrase */
spell_cast_named_filter ::= "a" filter_phrase

/* @sem ObjectFilter::AnyOf([$adjective_color, $adjective_color_2]) */
spell_cast_color_pair ::= adjective_color "or" adjective_color

/* @sem ObjectFilter::Property{property:ColorCount, test:NumberTest::Compare{comparison:Equal, value:$value}} */
spell_cast_exact_colors ::= "exactly" value "colors"

/* @sem ObjectFilter::$spell_cast_singular_filter */
spell_cast_qualified_subject ::= "each" "spell" "you" "cast" "that's" spell_cast_singular_filter

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$spell_cast_qualified_subject, modifier:$spell_cost_change})]}) */
static_qualified_spell_cost ::= spell_cast_qualified_subject "costs" spell_cost_change "to" "cast" "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellsHaveAbilities{spells:$spell_cast_qualified_subject, abilities:List([$spell_granted_effect])})]}) */
static_qualified_spell_grant ::= spell_cast_qualified_subject "has" spell_granted_effect "."

spell_granted_effect ::= spell_granted_replicate | spell_mana_grant_effect

/* @sem Operand::Term{family:SpellEffect, form:Replicate, operands:[Cost($cost)]} */
spell_granted_replicate ::= "replicate" cost

/* A possessive attachment names the same object as the ordinary owner phrase. */
/* @sem ObjectFilter::SameObject(AttachedTo(Source)) */
activation_attached_owner ::= "enchanted" "artifact's"

/* @sem Operand::Term{family:CostReductionSymbol, form:CostReduceGeneric, operands:[Integer($number)]} */
activation_generic_reduction ::= "{" NUMBER "}"

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(ActivationCost{abilities:AbilityOf($activation_attached_owner), change:Reduce($activation_generic_reduction), floor:1})]}) */
static_attached_activation_floor ::= activation_attached_owner "activated" "abilities" "cost" activation_generic_reduction "less" "to" "activate" "." "this" "effect" "can't" "reduce" "the" "mana" "in" "that" "cost" "to" "less" "than" "one" "mana" "."

/* The caster is the attached object's controller, not the Aura's controller. */
/* @sem PlayerSet::One(ControllerOf(AttachedTo(Source))) */
attached_controller_caster ::= "enchanted" "creature's" "controller"

/* @sem Ability::Static(_{kind:Ordinary, affected:Players($attached_controller_caster), changes:[PlayerRule(Prohibit(CastSpell{filter:$card_filter}))]}) */
static_attached_controller_cast_ban ::= attached_controller_caster "can't" "cast" card_filter "spells" "."

/* Plural animation preserves existing types. The explicit retention sentence
   is admitted only for a land population, and is semantically redundant. */
/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, AddCardType(Creature)] */
plural_creature_animation ::= "become" value "/" value "creatures"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$land_population_filter} */
land_population ::= "all" land_population_filter

land_population_filter ::= plural_land | land_population_controlled

/* @sem @and(ObjectFilter::CardType(Land), $land_control_modifier) */
land_population_controlled ::= plural_land land_control_modifier

land_control_modifier ::= modifier_you_control | modifier_player_controls

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($retained_land_population)), changes:$plural_creature_animation, duration:$duration, evaluation:Snapshot} */
land_animation_retained ::= retained_land_population plural_creature_animation duration "." "they're" "still" "lands"

/* Both options affect the same independently bound target. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_permanent)), changes:[Pump{power:$value, toughness:$value}], duration:$duration, evaluation:Snapshot}}]}, _{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_permanent)), changes:[Pump{power:Multiply([Constant(-1), $value]), toughness:Multiply([Constant(-1), $value])}], duration:$duration, evaluation:Snapshot}}]}]}] */
clause_target_symmetric_pump_choice ::= target_permanent "gets" "+" "X" "/" "+" "X" "or" "-" "X" "/" "-" "X" duration "," "where" "X" "is" value

/* The requirement and combat window refer to the same announced target. */
/* @sem Operation::EffectOn{subject:Objects(One($target_permanent)), effects:[Vocabulary{family:PermanentRule, form:AttacksEachCombatIfAble}], until:UntilNext{point:CombatEnds, players:One(ControllerOf($target_permanent))}} */
required_target_next_combat_attack ::= target_permanent "attacks" "during" "its" "controller's" "next" "combat" "phase" "if" "able"

/* A source becomes an Aura with a host restriction tied to its own action. */
/* @prefer always */
/* @sem Instruction::Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[AddEnchantmentType(Vocabulary{family:EnchantmentType, form:Aura}), GrantAbility(Enchant{hosts:Permanents(AllOf([$noun, MadeBy(Source)]))})], duration:Indefinite, evaluation:Snapshot}} */
aura_with_made_host ::= "it" "becomes" "an" "Aura" "with" '"' "↓" "enchant" noun "put" "onto" "the" "battlefield" "with" SELF_NAME "." '"'

/* A land's own quoted characteristic ability follows the animated holder. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:$colored_creature_quoted_stats, duration:$duration, evaluation:Snapshot} */
source_land_quoted_animation ::= duration "," self_land colored_creature_quoted_stats "it's" "still" "a" "land"

/* @sem Change::[Colors{mode:Set, colors:$token_colors}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, AddCardType(Creature), GrantAbility(Static(_{kind:Ordinary, affected:Objects(One(Source)), changes:[SetPower($value), SetToughness($value)]}))] */
colored_creature_quoted_stats ::= "becomes" "a" token_colors becomes_types "creature" "with" '"' "this" "creature's" "power" "and" "toughness" "are" "each" "equal" "to" value "." '"'

/* Set a color while adding a creature subtype without removing existing types. */
/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word]}, CreatureTypes{mode:Add, types:Listed($becomes_types)}] */
change_becomes_colored_retained_type ::= "becomes" "a" mana_color_word becomes_types "in" "addition" "to" "its" "other" "types"

/* @sem Change::[CreatureTypes{mode:Add, types:Listed($becomes_types)}] */
change_becomes_added_type_his ::= "becomes" "a" becomes_types "in" "addition" "to" "his" "other" "types"

/* A colored creature animation retains its other colors and types. */
/* @sem Change::[Colors{mode:Add, colors:[$mana_color_word]}, CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Creature), SetBasePowerToughness{power:$value, toughness:$value_2}] */
change_becomes_colored_creature_retained_base ::= "becomes" "a" mana_color_word becomes_types "creature" "with" "base" "power" "and" "toughness" value "/" value "in" "addition" "to" "its" "other" "colors" "and" "types"

/* Prefer the leading duration for this retained creature animation. */
/* @prefer always */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$change_becomes_colored_creature_retained_base, duration:$duration, evaluation:Snapshot} */
duration_colored_retained_animation ::= duration "," affected change_becomes_colored_creature_retained_base

entry_unless_condition ::= entry_colors_spent_condition | condition_cast_another_typed_spell

/* A named colored creature animation replaces the card types, and composes
   with independently granted keywords or other changes. */
/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, Colors{mode:Set, colors:[$mana_color_word]}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetCardTypes([Creature])] */
change_colored_named_creature_replacement ::= "becomes" "a" value "/" value mana_color_word becomes_types "creature"

/* A lasting color and base-stat change; each operand comes from the current effect. */
/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word]}, SetBasePowerToughness{power:$value, toughness:$value_2}] */
shared_color_base_changes ::= "becomes" mana_color_word "and" "has" "base" "power" "and" "toughness" value "/" value

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$shared_color_base_changes, duration:Indefinite, evaluation:Snapshot} */
shared_indefinite_color_base ::= affected shared_color_base_changes

/* The exchange result identifies the creatures receiving the follow-up grant. */
/* @sem Instruction::[Effect{result:@mark, operation:$exchange_creature_control}, $affected_grant_followup] */
clause_exchange_creatures_grant ::= exchange_creature_control "." "those" "creatures" affected_grant_followup

/* A temporary snapshot grants a quoted trigger to the described population.
   The trigger is scoped to each recipient rather than the granting source. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(State(FaceDown)), Not(Token), $filter_plural, ControlledBy(One(AbilityController))])} */
face_up_nontoken_controlled_population ::= "face-up" "nontoken" filter_plural "you" "control"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($face_up_nontoken_controlled_population), changes:[GrantAbility(@scope(Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$program}))], duration:$duration, evaluation:Snapshot} */
temporary_population_trigger_grant ::= duration "," face_up_nontoken_controlled_population "gain" '"' event_clause "," program "." '"'

/* The possessive identifies the ability's owner; its kind and added cost
   remain independent operands of the activating player's rule. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(ActivationCost{abilities:AllOf([OnStack($shared_activation_kind), AbilityOf($activation_possessive_owner)]), change:$activation_added_loyalty})]} */
static_you_possessive_activation_cost ::= activation_possessive_owner shared_activation_kind "abilities" "you" "activate" "cost" activation_added_loyalty "to" "activate" "."

activation_possessive_owner ::= activation_possessive_planeswalkers | activation_possessive_creatures | activation_possessive_artifacts

/* @sem ObjectFilter::CardType(Planeswalker) */
activation_possessive_planeswalkers ::= "planeswalkers'"

/* @sem ObjectFilter::CardType(Creature) */
activation_possessive_creatures ::= "creatures'"

/* @sem ObjectFilter::CardType(Artifact) */
activation_possessive_artifacts ::= "artifacts'"

/* @sem ActivationCostChange::Increase(Cost{parts:[Loyalty($value)]}) */
activation_added_loyalty ::= "an" "additional" "[" "+" value "]"

/* @sem PlayerRule::SpellTiming{spells:$flash_spells, timing:OwnTurnOnly} */
turn_player_own_turn_cast_timing ::= "can" "cast" flash_spells "only" "during" "their" "own" "turns"

/* The affected players, ability holder filter, and ability kind are independent. */
/* @sem Ability::Static{kind:Ordinary, affected:Players($player_rule_subject), changes:[PlayerRule(Prohibit(Activate(All([Of($activation_possessive_type), Is($shared_activation_kind)]))))]} */
static_player_possessive_activation_ban ::= player_rule_subject "can't" "activate" activation_possessive_type shared_activation_kind "abilities" "."

activation_possessive_type ::= activation_possessive_planeswalkers | activation_possessive_creatures | activation_possessive_artifacts | activation_possessive_lands | activation_possessive_enchantments

/* @sem ObjectFilter::CardType(Land) */
activation_possessive_lands ::= "lands'"

/* @sem ObjectFilter::CardType(Enchantment) */
activation_possessive_enchantments ::= "enchantments'"

/* Count all counters on the specified controlled battlefield population. */
/* @sem Expr::CountCounters(_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(AbilityController)))}), information:CurrentOrLastKnown}) */
pump_counter_population_definition ::= "the" "number" "of" "counters" "on" filter_plural "you" "control"

/* Prefer the shared pump and protection list as one sentence. */
/* @prefer always */
/* @sem Change::[...$change_pump, ...$change_protection_types_keeps] */
static_pump_protection_types_keeps ::= change_pump "and" change_protection_types_keeps

/* Type protection retains the independently named object, and composes with other static changes. */
/* @sem Change::[GrantAbility(ProtectionExcept{from:Term{family:Protectable, form:FromTypes, operands:[Filter($filter_plural)]}, keeps:$affected})] */
change_protection_types_keeps ::= "has" "protection" "from" filter_plural "." "this" "effect" "doesn't" "remove" affected

/* A second sentence adds a creature type to the same singular affected object. */
/* @sem Change::[CreatureTypes{mode:Add, types:Listed([@subtype_name($subtype)])}] */
retained_singular_creature_type_sentence ::= "it's" "a" subtype "in" "addition" "to" "its" "other" "types"

/* A final quoted activation supplies the preceding sentence's period. */
/* @sem Change::[$grant, ...$quoted_activation_grant_tail] */
quoted_activation_grants ::= grant "," quoted_activation_grant_tail

/* @sem Change::[$grant_quoted_activation] */
quoted_activation_grant_last ::= "and" grant_quoted_activation

/* @sem Change::[$grant, ...$quoted_activation_grant_tail] */
quoted_activation_grant_more ::= grant "," quoted_activation_grant_tail

quoted_activation_grant_tail ::= quoted_activation_grant_last | quoted_activation_grant_more

/* @sem Change::[...$static_singular_pump, ...$quoted_activation_grants] */
static_changes_with_quoted_final ::= static_singular_pump "and" "has" quoted_activation_grants

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(One($scalar_static_subject)), changes:[...$static_changes_with_quoted_final, ...$retained_singular_creature_type_sentence]}) */
static_changes_retained_type_sentence ::= scalar_static_subject static_changes_with_quoted_final retained_singular_creature_type_sentence "."

/* The pronoun refers to the expressed object; both branches retain that identity. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($object_ref), AllOf([CardType(Creature), Shares{property:CreatureTypes, with:$object_ref}])])} */
shared_type_with_referent_population ::= object_ref "and" "other" "creatures" "that" "share" "a" "creature" "type" "with" "it"

/* A death subject and its singular event-bound destination are independent. */
/* @sem ReplacementEvent::ZoneChange{objects:$die_exile_objects, from:Battlefield, to:Graveyard} */
replacement_death_subject_event ::= die_exile_objects "would" "die"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(OwnersLibraryShuffled)}}]} */
replacement_death_shuffle_outcome ::= "shuffle" "it" "into" "its" "owner's" "library" "instead"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_death_subject_event, body:$replacement_death_shuffle_outcome} */
replacement_death_redirect_shared ::= "if" replacement_death_subject_event "," replacement_death_shuffle_outcome "."

/* The color count refers to the same controlled creature population as the
   pump. Reuse the complete query in both places so edited operands print safely. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$controlled_creature_type, $plural_creature, $modifier_you_control])} */
controlled_subtype_creatures ::= controlled_creature_type plural_creature modifier_you_control

/* @sem Operation::@where(Operation::CreateContinuousEffect{source:Source, affected:Objects($controlled_subtype_creatures), changes:$defined_pump_changes, duration:$duration, evaluation:Snapshot}, Expr::CountDistinct{objects:$controlled_subtype_creatures, property:Colors}) */
controlled_creature_color_pump ::= controlled_subtype_creatures defined_pump_changes duration "," "where" "X" "is" "the" "number" "of" "colors" "among" "those" "creatures"

/* The counted attackers exclude the event subject itself. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(EventSubject)), Attacking, $counted_attacking_noun])}) */
other_attacking_event_subtype_count ::= "other" "attacking" counted_attacking_noun

counted_attacking_noun ::= noun | self_name_as_counted_subtype

/* A subtype can have exactly the same spelling as this card’s name. */
/* @sem ObjectFilter::Subtype($referenced_self_name) */
self_name_as_counted_subtype ::= referenced_self_name

/* A temporary discount on a color union, with its amount defined by a value. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$turn_qualified_spell_colors, modifier:Reduce{reductions:[_{amount:$turn_qualified_cost_value}], spill_into_generic:true}})], duration:$this_duration, evaluation:LiveObjects} */
turn_qualified_spell_cost_where ::= "spells" "you" "cast" this_duration "that" "are" turn_qualified_spell_colors "cost" "{" "X" "}" "less" "to" "cast" "," "where" "X" "is" turn_qualified_cost_value

turn_qualified_cost_value ::= return_bound_value | value_constant | value_your_life

/* @sem ObjectFilter::AnyOf([$adjective_color, $adjective_color_2]) */
turn_qualified_spell_colors ::= adjective_color "and" "/" "or" adjective_color

/* The quotation supplies the closing sentence punctuation. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@copy_subject(ObjectSet::$affected, ObjectRef::$copy_model_ref)), changes:[CopyOf{object:$copy_model_ref, exceptions:$copy_stats_and_quoted_ability}], duration:$duration, evaluation:Snapshot} */
copy_become_duration_quoted ::= affected "become" "a" "copy" "of" copy_model_ref duration "," "except" copy_stats_and_quoted_ability

/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$copy_become_duration_quoted}]}}]} */
optional_copy_quoted_sentence ::= "you" "may" "have" copy_become_duration_quoted

/* The added names belong to all cards matching the stated nonlegendary filter. */
/* @sem Change::[AddNames(AllOf([$filter_phrase, Not(Supertype(Legendary))]))] */
change_has_all_nonlegendary_names ::= "has" "all" "names" "of" "nonlegendary" filter_phrase "cards" "in" "addition" "to" "its" "name"

/* Keep a pump and name addition together when they share a subject. */
/* @prefer always */
/* @sem Change::[...$change_pump, ...$change_has_all_nonlegendary_names] */
static_pump_and_added_names ::= change_pump "and" change_has_all_nonlegendary_names

/* The granted definition counts counters on its stated referent. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(One(Source)), changes:[SetPower(CountCounters(_{recipients:Objects($affected), kind:$counter_kind, information:CurrentOrLastKnown})), SetToughness(CountCounters(_{recipients:Objects($affected), kind:$counter_kind, information:CurrentOrLastKnown}))]}) */
counter_defined_creature_static ::= "this" "creature's" "power" "and" "toughness" "are" "each" "equal" "to" "the" "number" "of" counter_kind "counters" "on" affected "."

/* @sem Change::[CreatureTypes{mode:Set, types:Listed($becomes_types)}, AddCardType(Artifact), AddCardType(Creature), GrantAbility($counter_defined_creature_static)] */
counter_defined_artifact_animation ::= "a" becomes_types "artifact" "creature" "with" '"' counter_defined_creature_static '"'

counter_animated_operation ::= counter_artifact_animated_operation | counter_retained_animated_operation

/* An indefinite characteristic change fixes its current affected objects. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$animation_plain, duration:Indefinite, evaluation:Snapshot} */
indefinite_have_change ::= affected "become" animation_plain

/* The printed sticker-bearing object supplies the copied abilities, independently of the affected object. */
/* @sem Change::[GainAbilitiesOf{objects:One($object_ref), kinds:List([Term{family:CheckHasable, form:AbilityStickerAbility}])}] */
change_sticker_abilities_on_object ::= "has" "all" "abilities" "of" "ability" "stickers" "on" object_ref

/* Keep the shared pump and copied-sticker changes in one sentence. */
/* @prefer always */
/* @sem Change::[...$change_pump, ...$change_sticker_abilities_on_object] */
sticker_pump_changes ::= change_pump "and" change_sticker_abilities_on_object

tapped_continuous_changes ::= static_changes | tapped_artifact_base_change

/* @prefer always */
/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, AddCardType(Artifact), AddCardType(Creature)] */
tapped_artifact_base_change ::= "becomes" "a" value "/" value "artifact" "creature"

/* @sem Change::[PlayerRule($player_retain_colored_mana)] */
temporary_retain_colored_mana ::= "you" player_retain_colored_mana

/* A plural player subject and spell filter independently qualify the paired timing rules. */
/* @sem Change::[PlayerRule(SpellTiming{spells:$cast_spells_filter, timing:OwnTurnOnly}), PlayerRule(ActivationTiming(OwnTurnOnly))] */
plural_cast_activation_own_turn ::= "can" "cast" cast_spells_filter "and" "activate" "abilities" "only" "during" "their" "own" "turns"

/* @sem Ability::Static{kind:Ordinary, affected:Players($player_keyword_many), changes:$plural_cast_activation_own_turn} */
static_plural_cast_activation_own_turn ::= player_keyword_many plural_cast_activation_own_turn "."

/* @sem SpellTiming::OwnTurnOnly */
plural_player_own_turn_timing ::= "only" "during" "their" "own" "turns"

/* @sem SpellTiming::SorceryOnly */
plural_player_sorcery_timing ::= "only" "any" "time" "they" "could" "cast" "a" "sorcery"

plural_player_timing ::= plural_player_own_turn_timing | plural_player_sorcery_timing

/* @sem Change::[PlayerRule(SpellTiming{spells:$cast_spells_filter, timing:$plural_player_timing}), PlayerRule(ActivationTiming($plural_player_timing_2))] */
plural_cast_activation_separate_timing ::= "can" "cast" cast_spells_filter plural_player_timing "and" "activate" "abilities" plural_player_timing

/* @sem Ability::Static{kind:Ordinary, affected:Players($player_keyword_many), changes:$plural_cast_activation_separate_timing} */
static_plural_cast_activation_separate_timing ::= player_keyword_many plural_cast_activation_separate_timing "."

/* The affected population and duration are independent operands of the switch. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$switch_possessive_population}), changes:$switch_characteristics, duration:$duration, evaluation:Snapshot} */
switch_each_population_stats ::= "switch" "each" switch_possessive_population switch_characteristics duration

switch_possessive_population ::= switch_creature_possessive | switch_artifact_possessive | switch_land_possessive | switch_permanent_possessive

/* @sem ObjectFilter::CardType(Creature) */
switch_creature_possessive ::= "creature's"

/* @sem ObjectFilter::CardType(Artifact) */
switch_artifact_possessive ::= "artifact's"

/* @sem ObjectFilter::CardType(Land) */
switch_land_possessive ::= "land's"

/* @sem ObjectFilter::Any */
switch_permanent_possessive ::= "permanent's"

/* An activation fixes the target count from its stated controlled population.
   Characteristic changes and the blocking rule retain their separate modes. */
/* @sem Program::@where(Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($controlled_x_targets), changes:$static_changes, duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($controlled_x_targets), changes:[Rule(Prohibit(BeBlocked(Not($blocker_exception_filter))))], duration:$rule_duration, evaluation:LiveObjects}}]}, $controlled_x_definition) */
program_controlled_x_grant_block ::= controlled_x_targets "each" static_changes duration "and" "can't" "be" "blocked" rule_duration "except" "by" blocker_exception_filter "," "where" "X" "is" controlled_x_definition "as" "you" "activate" "this" "ability"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(AnnouncedX), filter:AllOf([$plural, ControlledBy(One(AbilityController))])})) */
controlled_x_targets ::= "up" "to" "X" "target" plural "you" "control"

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$plural, ControlledBy(One(AbilityController))])}) */
controlled_x_definition ::= "the" "number" "of" plural "you" "control"

/* The enclosing activation proves that component 1 is a single discarded card. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_explicit_ref)), changes:[SetBasePowerToughness{power:ObjectProperty{object:Query{objects:CostObjects{payment:Activation, component:[1], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown}, toughness:ObjectProperty{object:Query{objects:CostObjects{payment:Activation, component:[1], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown}}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, AddCardType(Artifact), AddCardType(Creature)], duration:$duration, evaluation:Snapshot} */
discard_value_artifact_animation ::= self_explicit_ref "becomes" "an" "X" "/" "X" becomes_types "artifact" "creature" duration "," "where" "X" "is" "the" "discarded" "card's" "mana" "value"

/* The defined mechanic reads the same attached object named as its holder. */
/* @sem Ability::Mechanic{mechanic:$valued_keyword_name, amount:ObjectProperty{object:AttachedTo(Source), property:$creature_stat, information:CurrentOrLastKnown}} */
attached_defined_mechanic ::= valued_keyword_name "X" "," "where" "X" "is" "its" creature_stat

/* @sem Ability::Static{kind:Ordinary, affected:Objects(One($attached_ref)), changes:[GrantKeyword($keyword_name), GrantAbility($attached_defined_mechanic)]} */
static_attached_keyword_defined_mechanic ::= attached_ref "has" keyword_name "and" attached_defined_mechanic "."

/* @sem Expr::Constant(99) */
block_extra_ninety_nine ::= "ninety-nine" "creatures" "each" "combat"

/* Both negative statistics read the same live population at resolution. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:Multiply(Constant(-1), $controlled_population_definition), toughness:Multiply(Constant(-1), $controlled_population_definition)}], duration:$duration, evaluation:Snapshot} */
continuous_negative_population_pump ::= affected "gets" "-" "X" "/" "-" "X" duration "," "where" "X" "is" controlled_population_definition

/* The quoted combat event and its counter-kind count share the event source. */
/* @sem Change::GrantAbility(@scope(Ability::Triggered{event:$granted_creature_combat_player, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountDistinct{objects:One(EventSubject), property:CounterTypes}}}]}})) */
grant_combat_counter_kind_draw ::= '"' "whenever" granted_creature_combat_player "," "draw" "a" "card" "for" "each" "kind" "of" "counter" "on" "it" '"'

/* Two independent continuous effects retain the target and granted holder. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_object)), changes:[$temporary_quoted_trigger], duration:EndOfTurn, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@last_slot, index:0})), changes:[Rule(Prohibit(BeBlocked(Any)))], duration:EndOfTurn, evaluation:LiveObjects}}] */
instructions_target_quoted_grant_unblockable ::= "until" "end" "of" "turn" "," target_object "gains" temporary_quoted_trigger "and" "it" "can't" "be" "blocked" "this" "turn"

temporary_quoted_trigger ::= grant_combat_counter_kind_draw | grant_unpunctuated_trigger

/* The granted holder is a creature even when the granting source is not. */
/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:SameObject(Source), recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source}) */
granted_creature_combat_player ::= "this" "creature" "deals" "combat" "damage" "to" "a" "player"

/* Activated keyword costs can scale with a counted battlefield population. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(KeywordCost{keyword:$scaled_activation_keyword, cards:Any, change:Reduce($generic_reduction_symbols), per:CountObjects($affected)})]}) */
static_scaled_keyword_activation_cost ::= scaled_activation_keyword "abilities" "you" "activate" "cost" generic_reduction_symbols "less" "to" "activate" "for" affected "."

