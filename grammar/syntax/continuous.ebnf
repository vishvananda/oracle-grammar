scaled_activation_boast ::= "boast"

/* @sem Mechanic::Cycling */
scaled_activation_cycling ::= "cycling"

/* The chosen singleton is an announced target, reused by the animation. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($chosen_controlled_optional_target)), changes:$artifact_keyword_animation, duration:$duration, evaluation:Snapshot}}] */
chosen_controlled_target_animation ::= "choose" "up" "to" "one" chosen_controlled_optional_target "." duration "," "it" artifact_keyword_animation

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:AllOf([$noun, ControlledBy(One(AbilityController))])}), index:0} */
chosen_controlled_optional_target ::= "target" noun "you" "control"

/* @prefer always */
/* @sem Change::[AddCardType(Artifact), AddCardType(Creature), GrantKeyword($keyword_value)] */
artifact_keyword_animation ::= "becomes" "an" "artifact" "creature" "and" "gains" keyword_value

/* @sem Duration::ThroughNextTurn */
through_next_turn ::= "this" "turn" "and" "next" "turn"

/* The same targeting restriction applies to both players and a live object
   population; preserve the stack-object filter for each effect. */
paired_target_source ::= paired_target_spells_activated | paired_target_spells

/* @sem ObjectFilter::AnyOf([OnStack(Activated), OnStack(Spell)]) */
paired_target_spells_activated ::= "spells" "or" "activated" "abilities"

/* @sem ObjectFilter::OnStack(Spell) */
paired_target_spells ::= "spells"

paired_leading_duration ::= through_next_turn | until_end_of_turn | paired_this_turn

/* @prefer always */
/* @sem Duration::EndOfTurn */
paired_this_turn ::= "this" "turn"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($affected_plural), changes:$rule_changes, duration:$paired_leading_duration, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(All), changes:[PlayerRule(Prohibit(BeTargeted($paired_target_source)))], duration:$paired_leading_duration, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($affected_plural_2), changes:[Rule(Prohibit(BeTargeted($paired_target_source)))], duration:$paired_leading_duration, evaluation:LiveObjects}}] */
clause_timed_rule_and_paired_target_ban ::= paired_leading_duration "," affected_plural rule_changes "," "and" "players" "and" affected_plural "can't" "be" "the" "targets" "of" paired_target_source

/* The chosen target supplies colors; the affected population is independent.
   Repeating the noun ties the anaphor to the announced target. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[GrantKeyword(Protection(Objects(_{kind:Any, filter:SharesColorWith(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([@agree($noun_atomic, $chosen_color_possessive), ControlledBy(One(AbilityController))])}), index:0})})))], duration:$duration, evaluation:Snapshot} */
chosen_target_colors_protection ::= "choose" "target" noun_atomic "you" "control" "." affected "gain" "protection" "from" "each" "of" "that" chosen_color_possessive "colors" duration

chosen_color_possessive ::= chosen_color_permanent | chosen_color_creature | chosen_color_artifact | chosen_color_enchantment | chosen_color_land | chosen_color_planeswalker

/* @sem ObjectFilter::Any */
chosen_color_permanent ::= "permanent's"

/* @sem ObjectFilter::CardType(Creature) */
chosen_color_creature ::= "creature's"

/* @sem ObjectFilter::CardType(Artifact) */
chosen_color_artifact ::= "artifact's"

/* @sem ObjectFilter::CardType(Enchantment) */
chosen_color_enchantment ::= "enchantment's"

/* @sem ObjectFilter::CardType(Land) */
chosen_color_land ::= "land's"

/* @sem ObjectFilter::CardType(Planeswalker) */
chosen_color_planeswalker ::= "planeswalker's"

/* A per-population generic reduction keeps its factor and live set independent. */
/* @sem SpellCostModifier::Reduce{reductions:[_{amount:@times($braced_number, Expr::CountObjects($affected))}], spill_into_generic:true} */
spell_cost_less_per_population ::= braced_number "less" "to" "cast" "for" affected

/* A player's spell class and the reduction are separate operands. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$cast_spells_filter, modifier:$spell_cost_less_per_population})]}) */
static_cast_population_reduction ::= cast_spells_filter "you" "cast" "cost" spell_cost_less_per_population "."

/* The turn window wraps the independently described static ability. */
/* @sem Ability::Conditional{condition:$window_your_turn, then:[$static_cast_population_reduction]} */
turn_cast_population_reduction ::= window_your_turn "," static_cast_population_reduction

/* The quoted activation belongs to the affected permanent, independently of the source. */
/* @sem Change::[...$singular_artifact_type_change, RemoveAllAbilities, GrantAbility($granted_activated_unpunctuated)] */
shared_artifact_replacement_activation ::= "becomes" "a" singular_artifact_type_change "with" granted_activated_unpunctuated "and" "loses" "all" "other" "card" "types" "and" "abilities"

/* This pump is used only inside an activation that proves its counter payment. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:Multiply([$signed_literal, PaidCountersRemoved{payment:Activation, component:[0]}]), toughness:Multiply([$signed_literal_2, PaidCountersRemoved{payment:Activation, component:[0]}])}], duration:$duration, evaluation:Snapshot} */
paid_pt_counter_removal_pump ::= affected "gets" signed_literal "/" signed_literal duration "for" "each" "+" "1" "/" "+" "1" "counter" "removed" "this" "way"

/* A single subject has a snapshot change and a live combat requirement. */
