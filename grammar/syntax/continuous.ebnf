/* @sem PlayerRule::MustAttack{attackers:$filter_phrase, defenders:Any, count:[GreaterOrEqual, $value]} */
player_attack_count_rule ::= "must" "attack" "with" "at" "least" value filter_phrase "each" "combat" "if" "able"

/* @sem PlayerRule::MustAttack{attackers:Any, defenders:$controller_attack_defenders} */
player_attack_controller_rule ::= "must" "attack" controller_attack_defenders "with" "at" "least" "one" "creature" "each" "combat" "if" "able"

/* @sem AttackDefenders::PlayersAndPlaneswalkers(One(AbilityController)) */
controller_attack_defenders ::= "you" "or" "a" "planeswalker" "you" "control"

/* @sem PlayerRule::Skip(Untap) */
player_skip_untap_rule ::= "skips" "their" "untap" "step"

/* @sem Ability::Static{kind:Ordinary, affected:Players(All), changes:[PlayerRule($plural_player_continuous_rule)]} */
