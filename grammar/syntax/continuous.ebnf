indefinite_keyword_trigger_changes ::= "gains" keyword_value "and" shared_granted_trigger_closed

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$indefinite_keyword_trigger_changes, duration:Indefinite, evaluation:Snapshot}}]} */
program_sentence_indefinite_keyword_trigger ::= affected indefinite_keyword_trigger_changes

/* The named player owns the expiration turn. */
/* @sem Duration::UntilNextTurn($named_next_turn_player) */
until_named_next_turn ::= "until" named_next_turn_player "next" "turn"

/* @sem PlayerRef::Chosen */
named_next_turn_chosen ::= "the" "chosen" "player's"

/* @sem PlayerRef::Active */
named_next_turn_active ::= "the" "active" "player's"

named_next_turn_player ::= named_next_turn_chosen | named_next_turn_active

entry_each_counter_count ::= entry_existing_count | count_each

/* The entering event subject is not part of the already-present population. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::EventSubject)), $filter_phrase, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController)))}) */
entry_existing_count ::= filter_phrase "you" "already" "control"

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}] */
base_stats_pair ::= value "/" value

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$base_stats_pair, duration:Indefinite, evaluation:Snapshot} */
population_base_stats_indefinite ::= "the" "base" "power" "and" "toughness" "of" affected "become" base_stats_pair

/* The damage event binds the subject whose current or last-known property is drawn. */
