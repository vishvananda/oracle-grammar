/* Continuous effects: what changes, what it changes and for how long. */

/* Changes that alter characteristics fix their affected objects when the effect
   starts; changes to rules follow the objects that match while it lasts (CR 611.2c). */
continuous_snapshot ::= continuous_each_snapshot | continuous_keyword_pump_own_power | qualified_creature_literal_pump | continuous_snapshot_plain | continuous_spell_grant | copied_base_stats
    | continuous_lose_all_become

/* "Loses all abilities and becomes" a new creature until the duration ends; the
   layers, not the written order, decide how the changes combine. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[RemoveAllAbilities, ...$base_animation], duration:$duration, evaluation:Snapshot} */
continuous_lose_all_become ::= duration "," affected "loses" "all" "abilities" "and" "becomes" base_animation

/* A continuous effect on one card target outside the battlefield applies only
   while that card stays in the zone it was targeted in. */
/* @sem Operation::@implicit_return_grant(Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$changes, duration:$duration, evaluation:Snapshot}) */
continuous_snapshot_plain ::= affected changes ("↓")? duration

/* A cast spell keeps a temporary grant as the permanent it becomes. The binder
   admits this form, and refuses the continuous effect, only for that spell. */
/* @sem Operation::ChangeSpell{subject:One($it_ref), changes:[Continuing{changes:$changes, until:$duration}]} */
continuous_spell_grant ::= it_ref changes duration

/* The explicit object is introduced once. Its following empty expression
   reads that established object, after contextual target filters are bound. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_possessive)), changes:$copied_base_change, duration:$duration, evaluation:Snapshot} */
copied_base_stats ::= self_possessive copied_base_change duration

/* @sem Change::[SetBasePowerToughness{power:ObjectProperty{object:$copied_stat_object, property:Power, information:CurrentOrLastKnown}, toughness:$copied_toughness}] */
copied_base_change ::= "base" "power" "and" "toughness" ("become" | "becomes") "equal" "to" "the" "power" "and" "toughness" "of" copied_stat_object copied_toughness

copied_stat_object ::= target_object
/* @sem Expr::ObjectProperty{object:@named_object, property:Toughness, information:CurrentOrLastKnown} */
copied_toughness ::= ("↓")?

/* A leading duration changes the same game rules as a trailing duration. The
   affected object query remains live; no characteristic snapshot is created. */
continuous_live ::= continuous_live_plural_target_ban | continuous_live_trailing | continuous_live_leading | continuous_live_except_by | continuous_live_cant_block_object | continuous_live_plural_opponent_colored_target_ban | continuous_live_source_power_block | continuous_live_object_next_turn | continuous_live_controlled
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$rule_changes, duration:$rule_duration, evaluation:LiveObjects} */
continuous_live_trailing ::= affected rule_changes ("↓")? rule_duration
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$rule_changes, duration:$duration, evaluation:LiveObjects} */
continuous_live_leading ::= duration "," affected rule_changes
/* "Can't be blocked this turn except by" puts its duration before its exception. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Rule(Prohibit(BeBlocked(Not($blocker_exception_filter))))], duration:$rule_duration, evaluation:LiveObjects} */
continuous_live_except_by ::= affected "can't" "be" "blocked" rule_duration "except" "by" blocker_exception_filter
/* For a while, blocking one object is forbidden; a static ability says the same as
   "can't be blocked by" on that object. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Rule(Prohibit(Block(SameObject($object_ref))))], duration:$rule_duration, evaluation:LiveObjects} */
continuous_live_cant_block_object ::= affected "can't" "block" object_ref rule_duration

/* After its verb, a rule change ends at end of turn "this turn", never "until end of
   turn" (Oracle has no such sentence); "Until end of turn," may still lead. */
rule_duration ::= until_player_planeswalks | duration_die_roll_earliest | until_end_of_combat | until_your_next_turn | until_end_of_your_next_turn | this_turn | this_combat | until_end_of_next_upkeep | until_next_upkeep
    | until_next_end_step | while_you_control | while_on_battlefield

/* The effect is created by the ability holder. The named attacker is the
   block requirement's operand, independently of that source. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Rule(RequireCombat{action:Block(SameObject($object_ref)), amount:AtLeast(Constant(1))})], duration:$this_duration, evaluation:LiveObjects} */
combat_block_requirement ::= affected "blocks" object_ref this_duration "if" "able"

/* The requirement follows its affected population while a characteristic
   bonus fixes its recipients. Sharing a subject does not share those gates. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$be_blocked_requirement, duration:$this_duration, evaluation:LiveObjects} */
combat_be_blocked_requirement ::= affected be_blocked_requirement this_duration "if" "able"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$be_blocked_requirement, duration:$this_duration, evaluation:LiveObjects}}] */
clause_pump_and_block_requirement ::= affected ("gets" | "get") signed "/" signed duration "and" be_blocked_requirement this_duration "if" "able"

/* Actor and object targets occupy their own textual positions. The object
   phrase supplies the entire group, rather than a literal numbered slot. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($object_set), changes:[SetController($control_other_player)], duration:$duration, evaluation:Snapshot} */
gain_control_player ::= control_other_player "gains" "control" "of" object_set duration

control_other_player ::= target_player | target_opponent | that_player | defending_player | its_controller | its_owner | target_player_dealt | stack_controller

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($object_set), changes:[SetController(AbilityController)], duration:$duration, evaluation:Snapshot} */
gain_control_you ::= "you"? "gain" "control" "of" object_set duration

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Rule(RequireCombat{action:Block(Any), amount:AtLeast(Constant(1))})], duration:$this_duration, evaluation:LiveObjects} */
combat_block_any_requirement ::= affected ("blocks" | "block") this_duration "if" "able"

/* A plain plural follow-up keeps the population captured before counter
   placement, including objects that cannot receive counters. */
clause_counter_group ::= clause_original_counter_group

/* Untapping refers to the recorded recipients, not a new battlefield query.
   The follow-up starts after the first result has been allocated. */
/* @sem Instruction::[Effect{result:@next, operation:$continuous_snapshot}, $untap_affected] */
clause_continuous_untap ::= continuous_snapshot "." untap_affected

/* @sem Instruction::[Effect{result:@next, operation:$recorded_counter_choice}, $untap_affected] */
clause_chosen_counters_untap ::= recorded_counter_choice "." untap_affected

recorded_counter_choice ::= put_counters_choice | put_counters_many_choices

/* @sem Instruction::Effect{result:@next, operation:SetTapped{objects:Affected(@prior)}} */
untap_affected ::= "untap" "them"

/* Announced targets remain targets even if a counter replacement changes
   which objects actually receive counters. Both mentions share the same slot. */
/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($objects_targets), kind:$counter_kind, amount:$counter_amount}]}}, Effect{result:@next, operation:SetTapped{objects:$objects_targets}}] */
clause_target_counters_untap ::= "put" counter_amount counter_kind ("counter" | "counters") "on" objects_targets "." "untap" "them"

/* @sem () */
counter_group_reference ::= "they" | "those" "creatures" | "those" "permanents"

/* A repeated subject can be omitted after a damage clause. Keep that subject
   explicitly, rather than treating any bare characteristic change as the source. */
/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::DealDamage{source:$object_ref, recipients:$recipients, amount:$number, preventable:true}}, Instruction::Effect{result:@next, operation:Operation::CreateContinuousEffect{source:Source, affected:Objects(One($object_ref)), changes:$changes, duration:$duration, evaluation:Snapshot}}] */
clause_damage_and_change ::= object_ref "deals" number "damage" "to" recipients "and" changes duration

affected ::= cross_spells | owned_commander_population | affected_keyword_plural | affected_targets_each | affected_pair_each | group_subject | object_set | affected_plural | affected_other | counter_choice_reference | affected_chosen_planeswalker_plural | affected_without_keyword_pair | affected_without_keyword_pair_reverse | controlled_not_owned_each | affected_each_counter_an | affected_nth_chosen_type | objects_each_counter_qualified | affected_all_attacking_defender | named_and_other_controlled_population

counter_choice_reference ::= counter_choice_singular_reference | counter_choice_group_reference
/* @sem ObjectSet::@counter_reference_single */
counter_choice_singular_reference ::= "it" | "that" "creature"
/* @sem ObjectSet::@counter_reference */
counter_choice_group_reference ::= "those" "creatures" | "those" "permanents" | "they"

/* @sem ObjectSet::@distributive_pump_subject(ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}) */
affected_plural ::= filter_plural

/* @sem ObjectSet::@distributive_pump_subject(ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$contextual_other_filter}) */
affected_other ::= contextual_other_filter

/* The old mined plural route and direct affected-set route share one reference
   contract, so a constant Source cannot survive as a competing meaning. */
/* @sem ObjectFilter::@other_filter(ObjectFilter::@and(ObjectFilter::Not(ObjectFilter::SameObject(@other_reference(ObjectFilter::$filter_plural))), $filter_plural)) */
contextual_other_filter ::= "other" filter_plural

duration ::= duration_die_roll_earliest | until_end_of_turn | until_end_of_combat | until_your_next_turn | until_end_of_your_next_turn | this_turn | this_combat | until_end_of_next_upkeep | until_next_upkeep
    | until_next_end_step | while_you_control | while_on_battlefield

/* "For as long as you control this creature": the effect ends when you stop
   controlling that object. */
/* @sem Duration::WhileControlled{player:AbilityController, object:$object_ref} */
while_you_control ::= "for" "as" "long" "as" "you" "control" object_ref

/* The duration follows its named object independently of the effect's source. */
/* @sem Duration::WhileOnBattlefield($object_ref) */
while_on_battlefield ::= "for" "as" "long" "as" object_ref "remains" "on" "the" "battlefield"

/* @sem Duration::EndOfTurn */
until_end_of_turn ::= "until" "end" "of" "turn"
/* @sem Duration::EndOfCombat */
until_end_of_combat ::= "until" "end" "of" "combat"
/* @sem Duration::UntilNextTurn(PlayerRef::AbilityController) */
until_your_next_turn ::= "until" "your" "next" "turn"
/* @sem Duration::UntilEndOfNextTurn(PlayerRef::AbilityController) */
until_end_of_your_next_turn ::= "until" "the" "end" "of" "your" "next" "turn"
/* @sem Duration::EndOfTurn */
this_turn ::= "this" "turn"
/* @sem Duration::EndOfCombat */
this_combat ::= "this" "combat"

/* Schema179 distinguishes an entire next upkeep from its beginning. The
   deadline names a scalar player independently of the effect's object holder. */
/* @sem Duration::UntilEndOfNextUpkeep($next_upkeep_player) */
until_end_of_next_upkeep ::= "until" "the" "end" "of" next_upkeep_player "next" "upkeep"
/* @sem Duration::UntilNext{point:UpkeepBegins, players:One($next_upkeep_player)} */
until_next_upkeep ::= "until" next_upkeep_player "next" "upkeep"

/* @sem Duration::UntilNext{point:EndStepBegins, players:One($next_upkeep_player)} */
until_next_end_step ::= "until" next_upkeep_player "next" "end" "step"

next_upkeep_player ::= zone_your | zone_that_player

/* A deadline a sentence states after its verb. */
this_duration ::= this_turn | this_combat

changes ::= changes_pump_and_creature_types | change | changes_and | changes_comma

/* @sem Change::[...$change, ...$changes] */
changes_and ::= change "and" changes

/* @sem Change::[...$change, ...$changes] */
changes_comma ::= change "," "and"? changes

change ::= pilot_animation_change | change_add_color_card_type | change_color_of_mana | change_loses_keyword | change_lose_keyword | change_lose_all_abilities | change_has_base_power_toughness | change_is_all_creature_types | change_is_basic_land_type | change_are_basic_land_type | change_supertype_snow | change_color_set | change_pump | change_grant | change_pump_for_each_sum | change_pump_for_each | change_becomes | change_also_type | change_becomes_with_add | change_become_artifact_creatures | change_become_artifact_creatures_base | change_loses_creature_types | change_lose_creature_types | change_add_artifact_subtype | change_add_food_artifact | change_is_legendary | change_are_legendary | change_is_every_basic_land_type | change_are_every_basic_land_type | change_set_only_card_type | change_have_base_toughness | change_is_three_basic_land_types | change_lose_keywords | change_loses_keywords

/* "Loses all creature types": an empty creature type list replaces the old one. */
/* @sem Change::[CreatureTypes{mode:Set, types:Listed([])}] */
change_loses_creature_types ::= "loses" "all" "creature" "types"
/* @sem Change::[CreatureTypes{mode:Set, types:Listed([])}] */
change_lose_creature_types ::= "lose" "all" "creature" "types"
/* "Equipped creature gets +1/+1 and is all creature types." */
/* @sem Change::[CreatureTypes{mode:Set, types:All}] */
change_is_all_creature_types ::= "is" "all" "creature" "types"

/* A basic land type replaces the land's old land types (CR 305.7). */
/* @sem Change::[SetLandType(Vocabulary{family:LandType, form:@subtype_name($basic_land_type_named)})] */
change_is_basic_land_type ::= "is" basic_land_type_named
/* @sem Change::[SetLandType(Vocabulary{family:LandType, form:@subtype_name($basic_land_types)})] */
change_are_basic_land_type ::= "are" basic_land_types
basic_land_type_named ::= basic_land_type_a | basic_land_type_an
/* @sem $basic_land_type_consonant */
basic_land_type_a ::= "a" basic_land_type_consonant
/* @sem $st_island */
basic_land_type_an ::= "an" st_island
basic_land_type_consonant ::= st_plains | st_swamp | st_mountain | st_forest
basic_land_types ::= st_plains | st_island_pl | st_swamp_pl | st_mountain_pl | st_forest_pl

/* Artifacts and Vehicles "become artifact creatures": both types are added, so
   their other types stay (CR 205.1b). */
/* @sem Change::[AddCardType(Artifact), AddCardType(Creature)] */
change_become_artifact_creatures ::= "become" "artifact" "creatures"
/* @sem Change::[AddCardType(Artifact), AddCardType(Creature), SetBasePowerToughness{power:$value, toughness:$value_2}] */
change_become_artifact_creatures_base ::= "become" "artifact" "creatures" "with" "base" "power" "and" "toughness" value "/" value

/* @sem Change::[Change::Pump{power:@times($signed, $count_each), toughness:@times($signed_2, $count_each)}] */
change_pump_for_each ::= ("gets" | "get") signed "/" signed "for" "each" count_each

/* Color-only resolution effects replace the color set, independently of
   card types. An omitted duration uses the existing Indefinite/Snapshot route;
   explicit durations still compose through continuous_snapshot. */
/* @sem Change::[Colors{mode:Set, colors:$token_colors}] */
change_color_set ::= ("becomes" | "become") token_colors

/* Explicit retention composes separately from ordinary type replacement. */
change_becomes ::= change_becomes_legendary | change_becomes_plain | change_becomes_with | change_becomes_base

/* @sem $animation_plain */
change_becomes_plain ::= ("becomes" | "become" | "is" | "are") animation_plain

/* @sem $animation_with */
change_becomes_with ::= ("becomes" | "become" | "is" | "are") animation_with

animation_description ::= animation_plain | animation_with
/* @sem Change::[Change::SetBasePowerToughness{power:$number, toughness:$number_2}, ...$becomes_kind] */
animation_plain ::= ("a" | "an") number "/" number becomes_kind
/* @sem Change::[Change::SetBasePowerToughness{power:$number, toughness:$number_2}, ...$becomes_kind, ...$grants] */
animation_with ::= ("a" | "an") number "/" number becomes_kind "with" grants

/* A named subtype list replaces the old creature types; no card-type word
   means no new card type. Artifact creatures retain their prior card types. */
/* @sem $base_animation */
change_becomes_base ::= ("becomes" | "become") base_animation

base_animation ::= base_subtypes | base_colored_subtypes | base_subtypes_retained | base_artifact_creature | base_artifact_creature_native
/* A color word sets the color as well; no card-type word means no new card type. */
/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word]}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetBasePowerToughness{power:$value, toughness:$value_2}] */
base_colored_subtypes ::= ("a" | "an") mana_color_word becomes_types "with" "base" "power" "and" "toughness" value "/" value
/* @sem Change::[CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetBasePowerToughness{power:$value, toughness:$value_2}] */
base_subtypes ::= ("a" | "an") becomes_types "with" "base" "power" "and" "toughness" value "/" value
/* @sem Change::[CreatureTypes{mode:Add, types:Listed($becomes_types)}, SetBasePowerToughness{power:$value, toughness:$value_2}] */
base_subtypes_retained ::= ("a" | "an") becomes_types "with" "base" "power" "and" "toughness" value "/" value retention_addition
/* @sem Change::[CreatureTypes{mode:Set, types:Listed($becomes_types)}, AddCardType(Artifact), AddCardType(Creature), SetBasePowerToughness{power:$value, toughness:$value_2}] */
base_artifact_creature ::= ("a" | "an") becomes_types "artifact" "creature" "with" "base" "power" "and" "toughness" value "/" value
/* @sem Change::[CreatureTypes{mode:Set, types:Listed($becomes_types)}, AddCardType(Artifact), AddCardType(Creature), SetBasePowerToughness{power:$value, toughness:$value_2}] */
base_artifact_creature_native ::= ("a" | "an") becomes_types "artifact" "creature" "with" "base" "power" "and" "toughness" value "/" value

base_changes ::= pilot_animation_change | change_color_set | change_becomes_base | base_changes_and | base_changes_keywords
/* @sem Change::[...$change_becomes_base, ...$changes] */
base_changes_and ::= change_becomes_base "and" changes
/* @sem Change::[...$change_becomes_base, ...$grants] */
base_changes_keywords ::= change_becomes_base "," grants

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$base_changes, duration:Indefinite, evaluation:Snapshot} */
continuous_base_indefinite ::= affected base_changes

/* @sem $animation_description */
dynamic_animation ::= ("becomes" | "become") animation_description
/* @sem $animation_description */
static_animation ::= ("is" | "are") animation_description

/* @sem Change::[Change::SetBasePowerToughness{power:$number, toughness:$number_2}, ...$becomes_kind, GrantAbility(@holder($token_ability_sentence))] */
animation_quoted ::= ("becomes" | "become") ("a" | "an") number "/" number becomes_kind "with" '"' token_ability_sentence '"'

change_becomes_with_add ::= retained_change

becomes_kind ::= bk_two_colors_named_artifact | bk_two_colors_named_artifact_native | bk_creature | bk_artifact | bk_named | bk_named_artifact | bk_color | bk_color_named | bk_color_named_artifact | bk_two_colors_named
    | bk_artifact_native | bk_named_artifact_native | bk_color_named_artifact_native

/* The published IR contract gives the exact Artifact+Creature SetCardTypes pair
   CR 205.1b's additive meaning. Keep the explicit AddCardType representation
   too. Creature subtype replacement remains its independent change. */
/* @sem Change::[AddCardType(Artifact), AddCardType(Creature)] */
bk_artifact_native ::= "artifact" "creature"
/* @sem Change::[CreatureTypes{mode:Set, types:Listed($becomes_types)}, AddCardType(Artifact), AddCardType(Creature)] */
bk_named_artifact_native ::= becomes_types "artifact" "creature"
/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word]}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, AddCardType(Artifact), AddCardType(Creature)] */
bk_color_named_artifact_native ::= mana_color_word becomes_types "artifact" "creature"

/* @sem Change::[Change::AddCardType(Creature)] */
bk_creature ::= "creature"
/* @sem Change::[Change::AddCardType(Artifact), Change::AddCardType(Creature)] */
bk_artifact ::= "artifact" "creature"
/* @sem Change::[Change::CreatureTypes{mode:Set, types:Listed($becomes_types)}, Change::AddCardType(Creature)] */
bk_named ::= becomes_types "creature"
/* @sem Change::[Change::CreatureTypes{mode:Set, types:Listed($becomes_types)}, Change::AddCardType(Artifact), Change::AddCardType(Creature)] */
bk_named_artifact ::= becomes_types "artifact" "creature"
/* @sem Change::[Change::Colors{mode:Set, colors:[$mana_color_word]}, Change::AddCardType(Creature)] */
bk_color ::= mana_color_word "creature"
/* @sem Change::[Change::Colors{mode:Set, colors:[$mana_color_word]}, Change::CreatureTypes{mode:Set, types:Listed($becomes_types)}, Change::AddCardType(Creature)] */
bk_color_named ::= mana_color_word becomes_types "creature"
/* @sem Change::[Change::Colors{mode:Set, colors:[$mana_color_word]}, Change::CreatureTypes{mode:Set, types:Listed($becomes_types)}, Change::AddCardType(Artifact), Change::AddCardType(Creature)] */
bk_color_named_artifact ::= mana_color_word becomes_types "artifact" "creature"
/* @sem Change::[Change::Colors{mode:Set, colors:[$mana_color_word, $mana_color_word_2]}, Change::CreatureTypes{mode:Set, types:Listed($becomes_types)}, Change::AddCardType(Creature)] */
bk_two_colors_named ::= mana_color_word "and" mana_color_word becomes_types "creature"

mana_color_word ::= mcw_white | mcw_blue | mcw_black | mcw_red | mcw_green

/* @sem ManaColor::White */
mcw_white ::= "white"
/* @sem ManaColor::Blue */
mcw_blue ::= "blue"
/* @sem ManaColor::Black */
mcw_black ::= "black"
/* @sem ManaColor::Red */
mcw_red ::= "red"
/* @sem ManaColor::Green */
mcw_green ::= "green"

becomes_types ::= becomes_type_one | becomes_type_more

/* @sem CreatureType::[@subtype_name($subtype)] */
becomes_type_one ::= subtype

/* @sem CreatureType::[@subtype_name($subtype), ...$becomes_types] */
becomes_type_more ::= subtype becomes_types

/* @sem Change::[Change::CreatureTypes{mode:Add, types:Listed($becomes_types)}] */
change_also_type ::= ("is" | "are" | "becomes" | "become") ("a" | "an")? becomes_types "in" "addition" "to" ("its" | "their") "other" ("creature")? "types"

/* Bonuses counted out over a set, with the count last in the sentence. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Change::Pump{power:@times($signed, $count_each), toughness:@times($signed_2, $count_each)}], duration:$duration, evaluation:Snapshot} */
continuous_for_each ::= affected ("gets" | "get") signed "/" signed duration "for" "each" count_each

/* @sem Change::[Change::Pump{power:$signed, toughness:$signed_2}] */
change_pump ::= ("gets" | "get") ("an" "additional")? signed "/" signed

signed ::= signed_plus | signed_minus

signed_number ::= number_digits | number_x

/* @sem $signed_number */
signed_plus ::= "+" signed_number

/* @sem @negate($signed_number) */
signed_minus ::= "-" signed_number

/* @sem $grants */
change_grant ::= ("gains" | "gain" | "has" | "have") grants

grants ::= grant_one | grant_two | grant_many | reminder_group_grants

/* @sem Change::[$grant] */
grant_one ::= grant

/* @sem Change::[$grant, $grant_2] */
grant_two ::= grant "and" grant

/* @sem Change::[$grant, ...$grant_tail] */
grant_many ::= grant "," grant_tail

grant_tail ::= grant_last | grant_many

/* @sem Change::[$grant] */
grant_last ::= "and" grant

grant ::= grant_quoted_activation | grant_departure_triggers | grant_keyword | grant_ability | grant_native_mechanic | grant_protection_each | grant_all_creature_types | grant_basic_land_types | grant_recorded_colors | grant_unpunctuated_trigger | grant_crew_ability

/* "Gains all creature types", "a 2/2 creature with all creature types": every creature
   type replaces the old ones (CR 205.3m), like a changeling's characteristic. */
/* @sem Change::CreatureTypes{mode:Set, types:All} */
grant_all_creature_types ::= "all" "creature" "types"

/* A granted list of protections, each introduced by its own "from", is one
   protection keyword from each quality. The reference reads a group in such a
   list as any object, not only a permanent. */
/* @sem Change::GrantKeyword(Protection(Each([$protection_each_quality, ...$protection_each_tail]))) */
grant_protection_each ::= "protection" "from" protection_each_quality protection_each_tail
protection_each_tail ::= protection_each_last | protection_each_more
/* @sem Protection::[$protection_each_quality] */
protection_each_last ::= ","? "and" "from" protection_each_quality
/* @sem Protection::[$protection_each_quality, ...$protection_each_tail] */
protection_each_more ::= "," "from" protection_each_quality protection_each_tail
protection_each_quality ::= protection_each_all_colors | protection_object_quality | protection_all_spells | protection_colored_spells | protection_color_spells

/* @sem Change::GrantKeyword($keyword_value) */
grant_keyword ::= keyword_value

/* What is quoted is a whole ability of the object that gets it. */
/* @sem Change::GrantAbility(@holder($ability)) */
grant_ability ::= '"' ability '"'

/* @sem Change::GrantAbility(@holder($departure_granted_triggers)) */
grant_departure_triggers ::= '"' departure_granted_triggers '"'

rule_changes ::= rule_change | rule_changes_and

/* @sem Change::[...$rule_change, ...$rule_changes] */
rule_changes_and ::= rule_change "and" rule_changes

rule_change ::= combat_attack_block_you | combat_attack_block_controller | attack_group_also_rule | attack_planeswalker_only_cost_rule | defender_damage_sg | defender_damage_pl | rule_block_unlimited | rule_declared_blocker_cost | rule_skip_untap_controller | rule_defending_attack | rule_cant_attack_you | rule_cant_attack_you_only | rule_block_limit | rule_attack_haste | rule_cant_block | rule_cant_be_blocked | rule_cant_be_blocked_by | rule_cant_attack | rule_cant_attack_or_block | rule_cant_attack_player_again | rule_attack_unless_paid | rule_attack_block_unless_paid | rule_block_only | rule_attacks_if_able | rule_blocks_if_able | rule_cant_become_suspected | rule_cant_be_sacrificed | rule_no_combat_assignment | rule_must_be_blocked | rule_tap_power | rule_cant_be_targeted | rule_prohibit_action | change_only_attack_alone | change_cant_attack_block_extra | attack_group_requirement | attack_you_cost_rule | attack_you_or_planeswalkers_cost_rule | attack_you_pay_cost_rule | block_payment_rule | block_group_rule | block_comparison_rule | rule_blocked_greater_power | change_skip_controllers_untap

/* A spell is a stack object of kind Spell; "abilities" are every other stack
   object, and an ability "from" a source is an ability of that source. "Spells or
   abilities your opponents control" bans every opposing stack object, so it names
   no stack kind; "X spells or abilities from X sources" is one ban per kind. */
/* @sem $target_ban */
rule_cant_be_targeted ::= "can't" "be" "the" "target" "of" target_ban
/* @sem $target_ban */
target_ban_plural ::= "can't" "be" "the" "targets" "of" target_ban

target_ban ::= target_ban_any | target_ban_opponents | target_ban_spells | target_ban_kind_spells | target_ban_kind_spells_opponents
    | target_ban_spells_or_sources | target_ban_abilities_from | target_ban_abilities_opponents
/* @sem Change::[Rule(Prohibit(BeTargeted(Any)))] */
target_ban_any ::= "spells" "or" "abilities"
/* @sem Change::[Rule(Prohibit(BeTargeted(ControlledBy(OpponentsOf(AbilityController)))))] */
target_ban_opponents ::= "spells" "or" "abilities" "your" "opponents" "control"
/* A spell-only ban leaves activated and triggered abilities free to target, and is
   not controller-limited hexproof. */
/* @sem Change::[Rule(Prohibit(BeTargeted(OnStack(Spell))))] */
target_ban_spells ::= "spells"
/* @sem Change::[Rule(Prohibit(BeTargeted(@and(ObjectFilter::OnStack(Spell), $spell_adjectives))))] */
target_ban_kind_spells ::= spell_adjectives "spells"
/* @sem Change::[Rule(Prohibit(BeTargeted(@and(ObjectFilter::OnStack(Spell), @and($spell_adjectives, ObjectFilter::ControlledBy(OpponentsOf(AbilityController)))))))] */
target_ban_kind_spells_opponents ::= spell_adjectives "spells" "your" "opponents" "control"
/* @sem Change::[Rule(Prohibit(BeTargeted(@and(ObjectFilter::OnStack(Spell), $spell_adjectives)))), Rule(Prohibit(BeTargeted(@and(ObjectFilter::Not(OnStack(Spell)), ObjectFilter::AbilityOf($spell_adjectives_2)))))] */
target_ban_spells_or_sources ::= spell_adjectives "spells" "or" "abilities" "from" spell_adjectives "sources"
/* @sem Change::[Rule(Prohibit(BeTargeted(@and(ObjectFilter::Not(OnStack(Spell)), ObjectFilter::AbilityOf($spell_adjectives)))))] */
target_ban_abilities_from ::= "abilities" "from" spell_adjectives "sources"
/* @sem Change::[Rule(Prohibit(BeTargeted(@and(ObjectFilter::Not(OnStack(Spell)), ObjectFilter::ControlledBy(OpponentsOf(AbilityController))))))] */
target_ban_abilities_opponents ::= "abilities" "your" "opponents" "control"

/* The plural subject takes "the targets"; it is never a spelling for one object. */
/* @sem Ability::[Static(_{kind:Ordinary, affected:Objects($affected_plural), changes:$target_ban_plural})] */
line_plural_target_ban ::= affected_plural target_ban_plural "."

/* Crewing, saddling and stationing count more power, or toughness instead.
   Crew comes first whatever the order of the words. */
rule_tap_power ::= tap_power_crew | tap_power_saddle_crew | tap_power_crew_station | tap_toughness_crew | tap_toughness_saddle_crew | tap_toughness_station
/* @sem Change::[Rule(TapPowerBonus{cost:Crew, bonus:$value})] */
tap_power_crew ::= "crews" "Vehicles" "as" "though" "its" "power" "were" value "greater"
/* @sem Change::[Rule(TapPowerBonus{cost:Crew, bonus:$value}), Rule(TapPowerBonus{cost:Saddle, bonus:$value})] */
tap_power_saddle_crew ::= "saddles" "Mounts" "and" "crews" "Vehicles" "as" "though" "its" "power" "were" value "greater"
/* @sem Change::[Rule(TapPowerBonus{cost:Crew, bonus:$value}), Rule(TapPowerBonus{cost:Station, bonus:$value})] */
tap_power_crew_station ::= "crews" "Vehicles" "and" "stations" "permanents" "as" "though" "its" "power" "were" value "greater"
/* @sem Change::[Rule(TapCostUsesToughness(Crew))] */
tap_toughness_crew ::= "crews" "Vehicles" "using" "its" "toughness" "rather" "than" "its" "power"
/* @sem Change::[Rule(TapCostUsesToughness(Crew)), Rule(TapCostUsesToughness(Saddle))] */
tap_toughness_saddle_crew ::= "saddles" "Mounts" "and" "crews" "Vehicles" "using" "its" "toughness" "rather" "than" "its" "power"
/* @sem Change::[Rule(TapCostUsesToughness(Station))] */
tap_toughness_station ::= "stations" "permanents" "using" "its" "toughness" "rather" "than" "its" "power"

/* @sem $be_blocked_requirement */
rule_must_be_blocked ::= be_blocked_requirement "if" "able"
be_blocked_requirement ::= be_blocked_plain | be_blocked_each_combat

/* @sem Change::[Rule(CombatDamage(NoAssignment))] */
rule_no_combat_assignment ::= ("assigns" | "assign") "no" "combat" "damage"

/* @sem Change::[Rule(Prohibit(Sacrifice))] */
rule_cant_be_sacrificed ::= "can't" "be" "sacrificed"

/* @sem Change::[Change::Rule(Prohibit(BecomeSuspected))] */
rule_cant_become_suspected ::= "can't" "become" "suspected"

/* @sem Change::[Change::Rule(Prohibit(Block(Any)))] */
rule_cant_block ::= "can't" "block"
/* @sem Change::[Change::Rule(Prohibit(Attack(PlayersAndPlaneswalkers(One(PlayerRef::AbilityController)))))] */
rule_cant_attack_you ::= "can't" "attack" "you" "or" "planeswalkers" "you" "control"
/* @sem Change::[Rule(Prohibit(Attack(Players(One(PlayerRef::AbilityController)))))] */
rule_cant_attack_you_only ::= "can't" "attack" "you"
/* @sem Change::[Change::Rule(CombatGroup{role:BlockedAttacker, participants:Any, others_only:false, comparison:LessOrEqual, amount:Expr::Constant(1)})] */
rule_block_limit ::= "can't" "be" "blocked" "by" "more" "than" "one" "creature"
/* @sem Change::[Change::Rule(AttackException{ignore:SummoningSickness, defenders:Any})] */
rule_attack_haste ::= "can" "attack" "as" "though" ("it" "had" | "they" "had") "haste"
/* @sem Change::[Change::Rule(Prohibit(BeBlocked(Any)))] */
rule_cant_be_blocked ::= "can't" "be" "blocked"
/* @sem Change::[Change::Rule(Prohibit(BeBlocked($filter_plural)))] */
rule_cant_be_blocked_by ::= "can't" "be" "blocked" "by" filter_plural
/* @sem Change::[Change::Rule(Prohibit(Attack(Any)))] */
rule_cant_attack ::= "can't" "attack"
/* @sem Change::[Change::Rule(Prohibit(Attack(Any))), Change::Rule(Prohibit(Block(Any)))] */
rule_cant_attack_or_block ::= "can't" "attack" "or" "block"
/* @sem Change::[Change::Rule(Prohibit(Attack(Players(Matching{binding:0, condition:PlayerDid{player:Bound(0), event:AttackedBy(SameObject($object_ref)), window:ThisTurn}}))))] */
rule_cant_attack_player_again ::= "can't" "attack" "a" "player" object_ref "has" "already" "attacked" "this" "turn"

/* Its controller, as the declaring player, pays to attack or block with it. */
/* @sem Change::[Rule(CombatCost{action:Attack(Any), payer:DeclaringPlayer, cost:_{parts:[Mana($mana_symbols)]}})] */
rule_attack_unless_paid ::= "can't" "attack" "unless" "its" "controller" "pays" mana_symbols
/* @sem Change::[Rule(CombatCost{action:Block(Any), payer:DeclaringPlayer, cost:_{parts:[Mana($mana_symbols)]}}), Rule(CombatCost{action:Attack(Any), payer:DeclaringPlayer, cost:_{parts:[Mana($mana_symbols)]}})] */
rule_attack_block_unless_paid ::= "can't" "attack" "or" "block" "unless" "its" "controller" "pays" mana_symbols
/* @sem Change::[Change::Rule(Prohibit(Block(Not($filter_plural))))] */
rule_block_only ::= "can" "block" "only" filter_plural
/* @sem Change::[Change::Rule(RequireCombat{action:Attack(Any), amount:AtLeast(Expr::Constant(1))})] */
rule_attacks_if_able ::= ("attacks" | "attack") "each" "combat" "if" "able"
/* @sem Change::[Change::Rule(RequireCombat{action:Block(Any), amount:AtLeast(Expr::Constant(1))})] */
rule_blocks_if_able ::= ("blocks" | "block") "each" "combat" "if" "able"

static_ability ::= static_humans_have_chosen_abilities | static_drawn_cards_spell_cost | static_controlled_defender | static_counter_placement_list | static_defender_control_restriction | static_exert_without_followup | static_possessive_activation_ban | static_chosen_activation_ban | static_combat_activation_restrictions | static_counter_removal_prohibition | static_cast_graveyard_using_sneak | static_graveyard_cards_grant_during_turn | static_graveyard_card_grant | static_graveyard_cards_grant | static_combat_cap | static_alternative_spell_cost | static_linked_card_stats | static_linked_card_power_keyword | static_target_tax | static_target_activation_tax | static_global_legend_rule | static_spell_keywords | static_opponent_attack_haste | static_graveyard_card_exact_color_jump_start | static_attached_counter_population | scalar_subject_static_condition | scalar_subject_static_otherwise | static_ordinary_ability | static_pump_ability | static_definition_during_turn | static_definition_if | static_paired_both | static_paired_each | static_play_lands_from_graveyard | static_self_chosen_type_add | static_self_chosen_color | static_self_skip_untap_if | static_grant_then_lose_other | static_continuing_animation | static_attached_color_pump | static_grouped_count_pump | static_controller_assignment | static_window_suffix | static_self_chosen_land_type_add | static_controlled_each_change | static_scalar_pump_override | static_attached_retained_color_type | static_extreme_population | static_untap_with_named_counter | static_unless_shares_most_common_color | static_untap_with_nonmana_ability | static_each_object_state | scalar_static_alternative | static_graveyard_permissions | static_graveyard_card_grant_during_turn | static_each_qualified_pump | scalar_subject_static_kind | static_attacked_population | static_linked_exile_threshold | static_loss_and_quoted_activation

/* Each combat's attacking or blocking group holds at most this many creatures, and
   every creature is subject to the cap. A cap on attacking one defender is the
   AttackCap ability instead. */
static_combat_cap ::= combat_cap_one | combat_cap_many | attack_cap_one | attack_cap_many
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}), changes:[Rule(CombatGroup{role:$combat_cap_role, participants:Any, others_only:false, comparison:LessOrEqual, amount:Expr::Constant(1)})]}) */
combat_cap_one ::= "no" "more" "than" "one" "creature" "can" combat_cap_role "each" "combat" "."
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}), changes:[Rule(CombatGroup{role:$combat_cap_role, participants:Any, others_only:false, comparison:LessOrEqual, amount:$count_plural})]}) */
combat_cap_many ::= "no" "more" "than" count_plural "creatures" "can" combat_cap_role "each" "combat" "."
combat_cap_role ::= combat_cap_attack | combat_cap_block
/* @sem CombatRole::Attacker */
combat_cap_attack ::= "attack"
/* @sem CombatRole::Blocker */
combat_cap_block ::= "block"
/* @sem Ability::AttackCap{defender:$attack_cap_defender, amount:Expr::Constant(1)} */
attack_cap_one ::= "no" "more" "than" "one" "creature" "can" "attack" attack_cap_defender "each" "combat" "."
/* @sem Ability::AttackCap{defender:$attack_cap_defender, amount:$count_plural} */
attack_cap_many ::= "no" "more" "than" count_plural "creatures" "can" "attack" attack_cap_defender "each" "combat" "."
attack_cap_defender ::= attack_cap_you | attack_cap_self
/* @sem Recipients::Players(One(PlayerRef::AbilityController)) */
attack_cap_you ::= "you"
/* @sem Recipients::Objects(One($self_ref)) */
attack_cap_self ::= self_ref

/* Linked card variables read current characteristics in exile. A copied exile
   trigger may link several cards; CR 607.3 adds all their answers. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[Pump{power:@times($defined_x_sign, Expr::Aggregate{objects:$linked_stat_cards, property:$stat, aggregation:Sum}), toughness:@times($defined_y_sign, Expr::Aggregate{objects:$linked_stat_cards, property:$stat_2, aggregation:Sum})}]} */
static_linked_card_stats ::= affected ("gets" | "get") defined_x_sign "/" defined_y_sign "," "where" "X" "is" linked_stat_cards stat "and" "Y" "is" "its" stat "."

/* "The exiled creature card's" keeps only creature cards. "The exiled card's" keeps every
   linked card, such as an exiled Vehicle, whose printed power still counts (CR 208.3). */
linked_stat_cards ::= linked_stat_cards_of_kind | linked_stat_cards_any
/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:@and(ObjectFilter::ExiledWith(Source), $card_filter)} */
linked_stat_cards_of_kind ::= "the" "exiled" card_filter "card's"
/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:ObjectFilter::ExiledWith(Source)} */
linked_stat_cards_any ::= "the" "exiled" "card's"

/* A keyword and a linked-card X bonus in one sentence, as on Drach'Nyen. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[GrantKeyword($keyword_value), Pump{power:@times($defined_x_sign, Expr::Aggregate{objects:$linked_stat_cards, property:$stat, aggregation:Sum}), toughness:$signed}]} */
static_linked_card_power_keyword ::= affected "has" keyword_value "and" "gets" defined_x_sign "/" signed "," "where" "X" "is" linked_stat_cards stat "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($static_affected), changes:$static_changes}) */
static_ordinary_ability ::= static_affected static_changes "."

/* Soulbond's pair: "both creatures" and "each of those creatures" name this creature
   and the creature it's paired with. */
/* @sem Ability::Conditional{condition:ObjectMatches{object:$self_ref, filter:State(Paired)}, then:[Static(_{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($self_ref), SameObject(PairedWith($self_ref))])}), changes:$paired_both_changes})]} */
static_paired_both ::= "as" "long" "as" self_ref "is" "paired" "with" "another" "creature" "," "both" "creatures" paired_both_changes
/* @sem Ability::Conditional{condition:ObjectMatches{object:$self_ref, filter:State(Paired)}, then:[Static(_{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($self_ref), SameObject(PairedWith($self_ref))])}), changes:$paired_each_changes})]} */
static_paired_each ::= "as" "long" "as" self_ref "is" "paired" "with" "another" "creature" "," "each" "of" "those" "creatures" paired_each_changes
paired_both_changes ::= paired_changes_sentence | static_changes_closed_have
paired_each_changes ::= paired_changes_sentence | static_changes_closed_has
/* @sem $static_changes */
paired_changes_sentence ::= static_changes "."

/* This new count route owns only lexical distributive populations and explicit
   self references. Scalar attached hosts retain their previous learned routes. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($static_pump_subject), changes:$static_pump_changes} */
static_pump_ability ::= static_pump_subject static_pump_changes "."

static_pump_subject ::= objects_each | objects_each_other | objects_all | objects_all_other | affected_plural | affected_other | static_pump_self
/* @sem ObjectSet::One($self_ref) */
static_pump_self ::= self_ref

static_pump_changes ::= static_pump_change | static_pump_changes_more
static_pump_change ::= static_change | change_pump_for_each
/* @sem Change::[...$static_pump_change, ...$static_pump_changes] */
static_pump_changes_more ::= static_pump_change ("and" | "," "and"?) static_pump_changes

/* This numeric definition must actually name X. A mana symbol {X} is a
   different operand and cannot silently retain its unbound spending meaning. */
/* @sem Ability::@where(Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_numeric_x}), $static_definition_value) */
static_ability_where ::= affected static_numeric_x "," "where" "X" "is" static_definition_value "."

/* Define X over the complete change list, including earlier bonuses.
   Require a written numeric X; a mana symbol alone does not define a bonus. */
/* @sem @where($static_numeric_changes, $value) */
defined_changes ::= static_numeric_changes "," "where" "X" "is" value

static_numeric_changes ::= static_numeric_x | static_numeric_prefix | static_numeric_suffix
/* @sem Change::[...$static_change, ...$static_numeric_changes] */
static_numeric_prefix ::= static_change ("and" | "," "and"?) static_numeric_changes
/* @sem Change::[...$static_numeric_x, ...$static_changes_plain] */
static_numeric_suffix ::= static_numeric_x ("and" | "," "and"?) static_changes_plain

/* Independent written definitions apply only to their own stat operand. */
/* @sem Change::[Pump{power:@times($defined_x_sign, $value), toughness:@times($defined_y_sign, $value_2)}] */
change_independent_stats_where ::= ("gets" | "get") defined_x_sign "/" defined_y_sign "," "where" "X" "is" value "," "and" "Y" "is" value

defined_x_sign ::= defined_positive_x | defined_negative_x
defined_y_sign ::= defined_positive_y | defined_negative_y
/* @sem Expr::Constant(1) */
defined_positive_x ::= "+" "X"
/* @sem Expr::Constant(-1) */
defined_negative_x ::= "-" "X"
/* @sem Expr::Constant(1) */
defined_positive_y ::= "+" "Y"
/* @sem Expr::Constant(-1) */
defined_negative_y ::= "-" "Y"

static_numeric_x ::= static_power_x | static_toughness_x
/* @sem Change::[Pump{power:$static_signed_x, toughness:$signed}] */
static_power_x ::= ("gets" | "get") static_signed_x "/" signed
/* @sem Change::[Pump{power:$signed, toughness:$static_signed_x}] */
static_toughness_x ::= ("gets" | "get") signed "/" static_signed_x

static_signed_x ::= static_positive_x | static_negative_x
/* @sem Expr::AnnouncedX */
static_positive_x ::= "+" "X"
/* @sem Expr::@negate(Expr::AnnouncedX) */
static_negative_x ::= "-" "X"

/* A perpetual modifier uses the current scalar card, including the actual
   hand incarnation introduced by a preceding seek. It retains edited changes. */
/* @sem Instruction::[Effect{result:@next, operation:CreatePerpetualEffect{objects:One($object_ref), changes:$static_changes}}] */
clause_perpetual_card_changes ::= object_ref "perpetually" static_changes

static_changes ::= static_pump_keyword_color_type | static_changes_plain | defined_changes | change_independent_stats_where | static_creature_base | static_retained_creature | retained_plural_animation | static_base_and_retained_types | static_base_grant_and_retained_types
static_changes_plain ::= static_change | static_changes_and

/* @sem Instruction::[Effect{result:@next, operation:$copy_effect_duration}] */
clause_copy_for_duration ::= copy_effect_duration

/* A copy's written other-population contrasts with that copied object. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@copy_subject(ObjectSet::$affected, ObjectRef::$copy_model_ref)), changes:[CopyOf{object:$copy_model_ref, exceptions:[]}], duration:$duration, evaluation:Snapshot} */
copy_effect_duration ::= affected "becomes" "a" "copy" "of" copy_model_ref duration

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@copy_subject(ObjectSet::$affected, ObjectRef::$copy_model_ref)), changes:[CopyOf{object:$copy_model_ref, exceptions:$copy_exceptions_plain}], duration:$duration, evaluation:Snapshot} */
copy_effect_duration_except ::= affected "becomes" "a" "copy" "of" copy_model_ref duration "," "except" copy_exceptions_plain

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@copy_subject(ObjectSet::$affected, ObjectRef::$copy_model_ref)), changes:[CopyOf{object:$copy_model_ref, exceptions:[]}], duration:Indefinite, evaluation:Snapshot} */
copy_effect_indefinite ::= affected "becomes" "a" "copy" "of" copy_model_ref

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@copy_subject(ObjectSet::$affected, ObjectRef::$copy_model_ref)), changes:[CopyOf{object:$copy_model_ref, exceptions:$copy_exceptions_plain}], duration:Indefinite, evaluation:Snapshot} */
copy_effect_indefinite_except ::= affected "becomes" "a" "copy" "of" copy_model_ref "," "except" copy_exceptions_plain

/* "You may have this creature become a copy of target creature": the controller may
   decline the copy. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$copy_become}]}}] */
clause_may_have_copy ::= "you" "may" "have" copy_become
copy_become ::= copy_become_duration | copy_become_duration_except | copy_become_indefinite | copy_become_indefinite_except
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@copy_subject(ObjectSet::$affected, ObjectRef::$copy_model_ref)), changes:[CopyOf{object:$copy_model_ref, exceptions:[]}], duration:$duration, evaluation:Snapshot} */
copy_become_duration ::= affected "become" "a" "copy" "of" copy_model_ref duration
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@copy_subject(ObjectSet::$affected, ObjectRef::$copy_model_ref)), changes:[CopyOf{object:$copy_model_ref, exceptions:$copy_exceptions_plain}], duration:$duration, evaluation:Snapshot} */
copy_become_duration_except ::= affected "become" "a" "copy" "of" copy_model_ref duration "," "except" copy_exceptions_plain
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@copy_subject(ObjectSet::$affected, ObjectRef::$copy_model_ref)), changes:[CopyOf{object:$copy_model_ref, exceptions:[]}], duration:Indefinite, evaluation:Snapshot} */
copy_become_indefinite ::= affected "become" "a" "copy" "of" copy_model_ref
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@copy_subject(ObjectSet::$affected, ObjectRef::$copy_model_ref)), changes:[CopyOf{object:$copy_model_ref, exceptions:$copy_exceptions_plain}], duration:Indefinite, evaluation:Snapshot} */
copy_become_indefinite_except ::= affected "become" "a" "copy" "of" copy_model_ref "," "except" copy_exceptions_plain

/* A proved noun view comes from the current announcement's operands.
   Plain target/query references still use the ordinary reference grammar. */
copy_model_ref ::= copy_model_qualified | object_ref
/* @prefer symbol(qualified_object) */
copy_model_qualified ::= that_noun

/* @sem Change::[...$static_change, ...$static_changes_plain] */
static_changes_and ::= static_change ("and" | "," "and"?) static_changes_plain

static_change ::= change_landwalk_lacking | change_color_of_mana | change_loses_keyword | change_lose_keyword | change_lose_all_abilities | change_loses_creature_types | change_lose_creature_types | change_is_all_creature_types | change_is_basic_land_type | change_are_basic_land_type | blocks_as_though_landwalk | blocks_as_though_had_reach | trait_copy_change | change_pump | change_grant | rule_change | change_protection_keeps | mined_change | change_unblockable_except_by | change_has_base_power_toughness | change_skip_controllers_untap | change_cant_block_kind | change_block_additional | change_block_permission | change_attachment_permission | change_is_goaded | change_cant_block_or_be_blocked_by | change_cant_attack_alone | change_combat_activation_its | change_combat_activation_their | change_gained_abilities | change_gained_nonmana | change_gained_spending | change_gained_chosen_nonloyalty | static_are_color | static_are_colorless | static_are_retained_creature_type | static_is_colorless_basic_land | static_add_plural_card_type | static_add_singular_card_type | static_is_artifact_creature | static_base_stats_each_affected | change_is_colored_creature_base | change_is_named_base_grant | change_creature_base_in_addition | change_artifact_creature_mana_value | change_is_colored_creature_type | change_chosen_type_add_plural | change_chosen_land_type_singular | change_is_legendary | change_are_legendary | change_is_every_basic_land_type | change_are_every_basic_land_type | static_is_chosen_color | static_are_chosen_color | change_add_land_type_singular | private_land_type_add | change_add_land_card_type_plural | change_retained_typed_artifact_base | change_named_two_color_creature_base | vehicle_artifact_with_crew_change | static_remove_singular_card_type | change_set_only_card_type | change_have_chosen_abilities | change_have_base_toughness | static_add_creature_type_a | static_add_creature_type_an | change_pump_for_each | change_is_three_basic_land_types | change_lose_keywords | change_loses_keywords | change_turn_face_up_ban | change_pump_life_players | change_pump_stored_results | static_have_grants_and_dungeon_pump | change_is_every_land_type_add | change_are_nth_chosen_land_type | shared_equal_count_pump | shared_pump_and_singular_color | shared_pump_and_blockers | change_every_creature_type_singular | change_set_artifact_with_activation | change_pump_each_affected_attack | change_gained_limited | change_gained_craft | change_gained_shared_keywords | change_gained_abilities_plural | change_gained_craft_traits | change_linked_card_equal_stats | change_loses_land_types_and_abilities | change_isnt_creature | change_sticker_abilities
/* "Enchanted creature has protection from black. This effect doesn't remove this Aura.":
   the protection names the object it keeps attached. */
/* @sem Change::[GrantAbility(ProtectionExcept{from:Term{family:Protectable, form:FromColor, operands:[$protectable_color]}, keeps:$affected})] */
change_protection_keeps ::= "has" "protection" "from" protectable_color "." "this" "effect" "doesn't" "remove" affected
protectable_color ::= protectable_chosen_color | protectable_white | protectable_blue | protectable_black | protectable_red | protectable_green
/* @sem Operand::Term{family:ProtectableColor, form:TheChosenColor} */
protectable_chosen_color ::= "the" "chosen" "color"
/* @sem Operand::Term{family:ProtectableColor, form:Colors, operands:[Vocabulary{family:Color, form:White}]} */
protectable_white ::= "white"
/* @sem Operand::Term{family:ProtectableColor, form:Colors, operands:[Vocabulary{family:Color, form:Blue}]} */
protectable_blue ::= "blue"
/* @sem Operand::Term{family:ProtectableColor, form:Colors, operands:[Vocabulary{family:Color, form:Black}]} */
protectable_black ::= "black"
/* @sem Operand::Term{family:ProtectableColor, form:Colors, operands:[Vocabulary{family:Color, form:Red}]} */
protectable_red ::= "red"
/* @sem Operand::Term{family:ProtectableColor, form:Colors, operands:[Vocabulary{family:Color, form:Green}]} */
protectable_green ::= "green"



/* Retention changes the copied creature-type operation, not its statistics. */
trait_copy_change ::= trait_copy_replace | trait_copy_add | trait_copy_note | trait_copy_other_note

/* @sem Change::[SetPower(ObjectProperty{object:$trait_copy_source, property:Power, information:CurrentOrLastKnown}), SetToughness(ObjectProperty{object:$trait_copy_source, property:Toughness, information:CurrentOrLastKnown}), CreatureTypesOf{object:$trait_copy_source, mode:Set}] */
trait_copy_replace ::= trait_copy_source

/* The IR retains types, but has no operand naming a particular retained type.
   Prefer a neutral spelling that remains valid after editing the card. */
/* @prefer always */
/* @sem Change::[SetPower(ObjectProperty{object:$trait_copy_source, property:Power, information:CurrentOrLastKnown}), SetToughness(ObjectProperty{object:$trait_copy_source, property:Toughness, information:CurrentOrLastKnown}), CreatureTypesOf{object:$trait_copy_source, mode:Add}] */
trait_copy_add ::= trait_copy_source trait_copy_addition

/* @sem () */
trait_copy_addition ::= "in" "addition" "to" ("its" | "their") "other" "creature" "types"

/* @sem Change::[SetPower(ObjectProperty{object:$trait_copy_source, property:Power, information:CurrentOrLastKnown}), SetToughness(ObjectProperty{object:$trait_copy_source, property:Toughness, information:CurrentOrLastKnown}), CreatureTypesOf{object:$trait_copy_source, mode:Add}] */
trait_copy_note ::= trait_copy_source "." (trait_copy_retention_note | trait_copy_retention_plural)

/* @sem () */
trait_copy_retention_note ::= ("it's" | "he's" | "she's") "still" ("a" | "an") creature_type_word

/* @sem () */
trait_copy_retention_plural ::= "they're" "still" creature_type_plural_word

/* Card types and noncreature subtypes were never replaced by CreatureTypesOf. */
/* @sem Change::[SetPower(ObjectProperty{object:$trait_copy_source, property:Power, information:CurrentOrLastKnown}), SetToughness(ObjectProperty{object:$trait_copy_source, property:Toughness, information:CurrentOrLastKnown}), CreatureTypesOf{object:$trait_copy_source, mode:Set}] */
trait_copy_other_note ::= trait_copy_source "." trait_copy_other_retention

trait_copy_other_retention ::= retention_note | trait_copy_other_single | trait_copy_other_plural

/* @sem () */
trait_copy_other_single ::= ("it's" | "he's" | "she's") "still" ("a" | "an") other_subtype_word

/* @sem () */
trait_copy_other_plural ::= "they're" "still" other_subtype_plural_word

/* @sem ObjectRef::$object_ref */
trait_copy_source ::= ("has" | "have") "the" "power" "," "toughness" "," "and" "creature" "types" "of" object_ref

/* @sem Ability::Conditional{condition:$static_state_condition, then:[Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes})]} */
static_conditional ::= affected static_changes "as" "long" "as" static_state_condition "."

/* A static that holds while its card is in your graveyard functions there. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes})} */
static_in_graveyard ::= "as" "long" "as" "this" "card" "is" "in" "your" "graveyard" "," affected static_changes "."
/* @sem Ability::Scoped{zones:[Graveyard], condition:$condition, ability:Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes})} */
static_in_graveyard_and ::= "as" "long" "as" "this" "card" "is" "in" "your" "graveyard" "and" condition "," affected static_changes "."

/* @sem Ability::Conditional{condition:$static_state_condition, then:[Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes})]} */
static_conditional_first ::= "as" "long" "as" static_state_condition "," affected static_changes "."
/* @sem Ability::Conditional{condition:$condition, then:[Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes_closed})]} */
static_conditional_first_closed ::= "as" "long" "as" condition "," affected static_changes_closed

/* @sem Ability::@where(Ability::Conditional{condition:$condition, then:[Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_numeric_x})]}, $value) */
static_conditional_first_where ::= "as" "long" "as" condition "," affected static_numeric_x "," "where" "X" "is" value "."

/* @sem Ability::Conditional{condition:Not($condition), then:[Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes})]} */
static_unless ::= affected static_changes "unless" condition "."

/* Flash for the card's casters has its own native ability. A quoted ability's
   printed creator name must not silently become its holder: only explicit
   holder words use this production inside granted or token abilities. */
holder_flash_if ::= holder_flash_if_after | holder_flash_if_before

/* @sem Ability::FlashIf($condition) */
holder_flash_if_after ::= self_holder_text "has" "flash" "as" "long" "as" condition "."

/* @sem Ability::FlashIf($condition) */
holder_flash_if_before ::= "as" "long" "as" condition "," self_holder_text "has" "flash" "."

/* Named self references are safe here because line is the card-level root,
   never the quoted-ability root. Keep creator references in ordinary statics. */
line_named_flash_if ::= named_flash_if_after | named_flash_if_before

/* @sem Ability::[FlashIf($condition)] */
named_flash_if_after ::= self_named "has" "flash" "as" "long" "as" condition "."

/* @sem Ability::[FlashIf($condition)] */
named_flash_if_before ::= "as" "long" "as" condition "," self_named "has" "flash" "."

/* @sem Ability::Conditional{condition:$static_turn_window, then:[Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes})]} */
static_during_turn ::= static_turn_window "," affected static_changes "." | affected static_changes static_turn_window "."

static_turn_window ::= window_your_turn | window_other_turns | window_turn_as_long_as
/* @sem Condition::ExistsPlayer{players:OthersThan(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))} */
window_other_turns ::= "during" "turns" "other" "than" "yours"

/* Definition words retain their context until references are bound (CR604.3a).
   Only an intrinsic, unconditional definition of the holder is a CDA. */
/* @sem Ability::@defining_static(Ability::Static{kind:Ordinary, affected:Objects(One($self_possessive)), changes:[Change::SetBasePowerToughness{power:ChosenNumber, toughness:Subtract([$value, ChosenNumber])}]}) */
static_defining_chosen_split ::= self_possessive "power" "is" "equal" "to" "the" "last" "chosen" "number" "and" "its" "toughness" "is" "equal" "to" value "minus" "that" "number" "."

/* @sem Ability::@defining_static(Ability::Static{kind:Ordinary, affected:Objects(One($self_possessive)), changes:[Change::SetBasePowerToughness{power:$value, toughness:$value}]}) */
static_defining_both ::= self_possessive "power" "and" "toughness" "are" "each" "equal" "to" value "."

/* @sem Ability::@defining_static(Ability::Static{kind:Ordinary, affected:Objects(One($self_possessive)), changes:[Change::SetPower($value)]}) */
static_defining_power ::= self_possessive "power" "is" "equal" "to" value "."

/* @sem Ability::@defining_static(Ability::Static{kind:Ordinary, affected:Objects(One($self_possessive)), changes:[Change::SetToughness($value)]}) */
static_defining_toughness ::= self_possessive "toughness" "is" "equal" "to" value "."

/* @sem Ability::@defining_static(Ability::Static{kind:Ordinary, affected:Objects(One($self_explicit_ref)), changes:[Change::CreatureTypes{mode:Set, types:All}]}) */
static_defining_every_type ::= self_explicit_ref "is" "every" "creature" "type" "."

static_definition ::= static_defining_both | static_defining_power | static_defining_toughness | static_defining_every_type
/* @sem Ability::Conditional{condition:$static_turn_window, then:[$static_definition]} */
static_definition_during_turn ::= static_turn_window "," static_definition
/* @sem Ability::Conditional{condition:$condition, then:[$static_definition]} */
static_definition_if ::= "as" "long" "as" condition "," static_definition

replacement_ability ::= replacement_entry_history_where | replacement_entry_three_choices | replacement_entry_unless_spent | replacement_entry_condition | replacement_enters_counter_choice | replacement_die_exile | replacement_entry_state | kicker_entry_conditional | kicker_entry_conditional_quoted | entry_optional_payment | replacement_enters_tapped | replacement_enters_counters | replacement_enters_counters_where | replacement_enters_counters_if | replacement_spent_enters_counters | replacement_enters_counters_for_each | replacement_enters_counters_equal | replacement_enters_exile_counters
    | replacement_each_enters_counters | replacement_each_enters_counters_for_each | replacement_each_enters_counters_equal | replacement_each_enters_counters_where

/* Dying permanents matching the filter go to exile instead; `it` is the dying
   permanent, not this source. */
/* @sem Ability::Replacement{active:Battlefield, event:ZoneChange{objects:$die_exile_objects, from:Battlefield, to:Graveyard}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}} */
replacement_die_exile ::= "if" die_exile_objects "would" "die" "," "exile" "it" "instead" "."
die_exile_objects ::= die_exile_any | die_exile_other | die_exile_damaged | die_exile_self
/* @sem ObjectFilter::SameObject($self_explicit_ref) */
die_exile_self ::= self_explicit_ref
/* A creature this turn's damage marks: dealt damage by an object, or by a source you controlled. */
/* @sem @and($filter_phrase, $die_damage_history) */
die_exile_damaged ::= ("a" | "an") filter_phrase die_damage_history
die_damage_history ::= modifier_dealt_damage_by | modifier_dealt_damage_by_yours
/* @sem $filter_phrase */
die_exile_any ::= ("a" | "an") filter_phrase
/* @sem @and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $filter_phrase) */
die_exile_other ::= "another" filter_phrase

/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_ref)}, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:SetTapped(true)}}]}}) */
replacement_enters_tapped ::= self_ref "enters" "tapped" "."

/* @sem $replacement_enters_counters_clause */
replacement_enters_counters ::= replacement_enters_counters_clause "."

/* @sem Ability::@where($replacement_enters_counters_clause, $value) */
replacement_enters_counters_where ::= replacement_enters_counters_clause "," "where" "X" "is" value "."

replacement_enters_counters_clause ::= replacement_enters_counter_one | replacement_enters_counters_many

/* The entering permanent's prospective controller supplies "you" in its
   replacement condition; a granted ability keeps its independent controller. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_ref)}, body:Program{instructions:[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters{kind:$counter_kind, amount:$counter_amount}}}]}, otherwise:Program{}}]}}) */
replacement_enters_counters_if ::= self_ref "enters" "with" counter_amount counter_kind ("counter" | "counters") "on" "it" "if" condition "."
/* "Your choice of a deathtouch counter or a lifelink counter": one of the two kinds. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_ref)}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Entry(CountersOfChoice{kinds:[$counter_kind, $counter_kind_2], amount:$counter_amount})}}]}}) */
replacement_enters_counter_choice ::= self_ref "enters" "with" "your" "choice" "of" counter_amount counter_kind "counter" "or" "a" counter_kind "counter" "on" "it" "."
/* Mana spent to cast the entering permanent is known as it enters, so a leading
   spent-mana test (adamant) stays inside its replacement. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_ref)}, body:Program{instructions:[If{condition:$spent_mana_condition, then:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters{kind:$counter_kind, amount:$counter_amount}}}]}, otherwise:Program{}}]}}) */
replacement_spent_enters_counters ::= "if" spent_mana_condition "," self_ref "enters" "with" counter_amount counter_kind ("counter" | "counters") "on" "it" "."
spent_mana_condition ::= condition_total_mana_spent | condition_typed_mana_spent | condition_symbol_spent | condition_symbol_pair_spent

/* The counted history's predicate names the historical object, independently
   of the incoming permanent whose prospective controller supplies "you". */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_ref)}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters{kind:$counter_kind, amount:@times($counter_amount, $count_each)}}}]}}) */
replacement_enters_counters_for_each ::= self_ref "enters" "with" counter_amount counter_kind ("counter" | "counters") "on" ("it" | "him" | "her") "for" "each" count_each "."

/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_ref)}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters{kind:$counter_kind, amount:$value}}}]}}) */
replacement_enters_counters_equal ::= self_ref "enters" "with" "a" "number" "of" counter_kind "counters" "on" ("it" | "him" | "her") "equal" "to" value "."

/* Each other incoming object of a kind, or each one, enters with more counters
   while this permanent is on the battlefield. */
/* @sem Ability::Replacement{active:Battlefield, event:Enter{objects:$entry_each_objects}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$entry_counter_amount})}}]}} */
replacement_each_enters_counters ::= entry_each_objects "enters" "with" entry_counter_amount counter_kind ("counter" | "counters") "on" "it" "."
/* @sem Ability::Replacement{active:Battlefield, event:Enter{objects:$entry_each_objects}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:@times($counter_amount, $count_each)})}}]}} */
replacement_each_enters_counters_for_each ::= entry_each_objects "enters" "with" counter_amount "additional" counter_kind "counter" "on" "it" "for" "each" count_each "."
/* @sem Ability::Replacement{active:Battlefield, event:Enter{objects:$entry_each_objects}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$value})}}]}} */
replacement_each_enters_counters_equal ::= entry_each_objects "enters" "with" "a" "number" "of" "additional" counter_kind "counters" "on" "it" "equal" "to" value "."
/* @sem Ability::Replacement{active:Battlefield, event:Enter{objects:$entry_each_objects}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$value})}}]}} */
replacement_each_enters_counters_where ::= entry_each_objects "enters" "with" "an" "additional" "X" counter_kind "counters" "on" "it" "," "where" "X" "is" value "."

entry_each_objects ::= entry_each_other | entry_each_one | entry_each_controlled_not_hand_cast
/* @sem ObjectFilter::@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $filter_phrase) */
entry_each_other ::= "each" "other" filter_phrase
/* @sem ObjectFilter::$filter_phrase */
entry_each_one ::= "each" filter_phrase

enchant_ability ::= enchant_composed_hosts | enchant_permanents | enchant_player | enchant_opponent
/* @sem Ability::Enchant{hosts:Permanents($filter_phrase)} */
enchant_permanents ::= "enchant" filter_phrase
/* @sem Ability::Enchant{hosts:Players(All)} */
enchant_player ::= "enchant" "player"
/* @sem Ability::Enchant{hosts:Players(OpponentsOf(AbilityController))} */
enchant_opponent ::= "enchant" "opponent"

/* A battlefield replacement changes incoming objects; it is distinct from
   the source-only replacement active while that source is entering. */
replacement_entry_state ::= replacement_entry_tapped | replacement_entry_untapped | replacement_entry_copy
/* @sem Ability::Replacement{active:Battlefield, event:Enter{objects:$entry_objects}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}]}} */
replacement_entry_tapped ::= entry_objects "enter" "tapped" "."
/* @sem Ability::Replacement{active:Battlefield, event:Enter{objects:$entry_objects}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(false)}}]}} */
replacement_entry_untapped ::= entry_objects "enter" "untapped" "."

/* The condition's explicit object distinguishes a named creator from a
   granted ability's holder. The replacement's incoming-object filter is separate. */
/* @sem Ability::Conditional{condition:ObjectMatches{object:$self_explicit_ref, filter:$condition_state}, then:[$replacement_entry_state], otherwise:[]} */
replacement_entry_condition ::= "as" "long" "as" self_explicit_ref "is" condition_state "," replacement_entry_state

entry_objects ::= entry_other_objects | entry_opponents_union | filter_plural
/* @sem ObjectFilter::@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $filter_plural) */
entry_other_objects ::= "other" filter_plural

/* A defending player also protects any battle being attacked (CR 508.5).
   Explicit player/planeswalker wording continues to use its narrower selector. */
/* @sem Change::[Rule(Prohibit(Attack(DefendingPlayers(Matching{binding:0, condition:Not($defending_attack_requirement)}))))] */
rule_defending_attack ::= "can't" "attack" "unless" defending_attack_requirement

defending_attack_requirement ::= defending_attack_controls | defending_attack_controls_either
    | defending_attack_controls_many | defending_attack_state | defending_attack_graveyard
    | defending_attack_outnumber

/* @sem Condition::Controls{player:Bound(0), filter:$filter_phrase, minimum:1} */
defending_attack_controls ::= "defending" "player" "controls" ("a" | "an") filter_phrase

/* @sem Condition::AnyOf([Controls{player:Bound(0), filter:$filter_phrase, minimum:1}, Controls{player:Bound(0), filter:$filter_phrase_2, minimum:1}]) */
defending_attack_controls_either ::= "defending" "player" "controls" ("a" | "an") filter_phrase "or" ("a" | "an") filter_phrase

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
defending_attack_controls_many ::= "defending" "player" "controls" number "or" "more" filter_plural

/* @sem Condition::PlayerState{player:Bound(0), state:$defending_attack_state_value} */
defending_attack_state ::= "defending" "player" "is" defending_attack_state_value

/* @sem PlayerState::Poisoned */
defending_attack_poisoned ::= "poisoned"

/* @sem PlayerState::Monarch */
defending_attack_monarch ::= "the" "monarch"

defending_attack_state_value ::= defending_attack_poisoned | defending_attack_monarch

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
defending_attack_graveyard ::= "defending" "player" "has" value "or" "more" "cards" "in" "their" "graveyard"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])})}} */
defending_attack_outnumber ::= "you" "control" "more" filter_plural "than" "defending" "player"

/* One written characteristic change applies independently to three populations.
   Battlefield control, spell control and card ownership are separate selectors;
   the final population explicitly excludes the battlefield. */
/* @sem Ability::[Static{kind:Ordinary, affected:Objects($cross_battlefield_subject), changes:$cross_characteristics}, Static{kind:Ordinary, affected:Objects($cross_spells), changes:$cross_characteristics}, Static{kind:Ordinary, affected:Objects($cross_owned_cards), changes:$cross_characteristics}] */
line_cross_zone_characteristics ::= cross_battlefield_subject cross_characteristics "." "the" "same" "is" "true" "for" cross_spells "and" cross_owned_cards "."

cross_battlefield_subject ::= cross_explicit_battlefield | cross_battlefield_filter | cross_battlefield_other | cross_battlefield_pair | cross_battlefield_pair_reverse
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural} */
cross_battlefield_filter ::= ("all")? filter_plural
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(SameObject(@self)), $filter_plural)} */
cross_battlefield_other ::= "other" filter_plural
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([$filter_plural, $filter_plural_2])} */
cross_battlefield_pair ::= filter_plural "and" filter_plural
/* Either is native-canonicalized as a set. Both declarations preserve the
   written member order through an exact key without changing its meaning. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([$filter_plural_2, $filter_plural])} */
cross_battlefield_pair_reverse ::= filter_plural "and" filter_plural

cross_spells ::= cross_spells_any | cross_spells_filtered
/* Spells on the stack you control, or that you cast. */
spell_holders ::= cross_spells | spells_you_cast | mechanic_each_cast_spell
/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:@and($cast_spells_filter, ObjectFilter::Cast{by:One(PlayerRef::AbilityController)})} */
spells_you_cast ::= cast_spells_filter "you" "cast"
/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:ControlledBy(One(AbilityController))} */
cross_spells_any ::= "spells" "you" "control"
/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:@and($card_filter, ObjectFilter::ControlledBy(One(AbilityController)))} */
cross_spells_filtered ::= card_filter "spells" "you" "control"

cross_owned_cards ::= cross_owned_any | cross_owned_filtered
/* @sem ObjectSet::AnyZone(@and(ObjectFilter::OwnedBy(One(AbilityController)), ObjectFilter::Not(InZone(Shared(Battlefield))))) */
cross_owned_any ::= "cards" "you" "own" "that" "aren't" "on" "the" "battlefield"
/* @sem ObjectSet::AnyZone(@and($card_filter, ObjectFilter::OwnedBy(One(AbilityController)), ObjectFilter::Not(InZone(Shared(Battlefield))))) */
cross_owned_filtered ::= card_filter "cards" "you" "own" "that" "aren't" "on" "the" "battlefield"

cross_characteristics ::= cross_characteristic_types | change_grant
/* @sem $cross_traits */
cross_characteristic_types ::= "are" cross_traits

cross_traits ::= cross_trait | cross_colors_and_card_type
/* @sem Change::[...$cross_colors, ...$cross_added_types] */
cross_colors_and_card_type ::= cross_colors "and" cross_added_types

cross_trait ::= cross_chosen_type | cross_chosen_type_add | cross_all_types | cross_added_types | cross_named_types | cross_named_types_add | cross_colors
/* @sem Change::[ChosenType{kind:CreatureType, mode:Set}] */
cross_chosen_type ::= "the" "chosen" ("creature")? "type"
/* @sem Change::[ChosenType{kind:CreatureType, mode:Add}] */
cross_chosen_type_add ::= "the" "chosen" ("creature")? "type" "in" "addition" "to" "their" "other" ("creature")? "types"
/* @sem Change::[CreatureTypes{mode:Set, types:All}] */
cross_all_types ::= "every" "creature" "type"
/* @sem Change::[CreatureTypes{mode:Set, types:Listed($cross_creature_types)}] */
cross_named_types ::= cross_creature_types
/* @sem Change::[CreatureTypes{mode:Add, types:Listed($cross_creature_types)}] */
cross_named_types_add ::= cross_creature_types "in" "addition" "to" "their" "other" ("creature")? "types"

cross_creature_types ::= cross_creature_type | cross_creature_types_more
cross_creature_type ::= cross_creature_type_plural
/* @sem CreatureType::[...$cross_creature_type, ...$cross_creature_types] */
cross_creature_types_more ::= cross_creature_type "and" cross_creature_types
/* @sem CreatureType::[@subtype_name($subtype_plural)] */
cross_creature_type_plural ::= subtype_plural

/* @sem Change::[AddCardType($cross_card_type)] */
cross_added_types ::= cross_card_type "in" "addition" "to" "their" "other" "types"
cross_card_type ::= cross_artifact_type | cross_enchantment_type | cross_creature_card_type | cross_land_type
/* @sem CardType::Artifact */
cross_artifact_type ::= "artifacts"
/* @sem CardType::Enchantment */
cross_enchantment_type ::= "enchantments"
/* @sem CardType::Creature */
cross_creature_card_type ::= "creatures"
/* @sem CardType::Land */
cross_land_type ::= "lands"

/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word]}] */
cross_colors ::= mana_color_word

/* A minimum blocker group also excludes creatures outside the group filter. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[Rule(Prohibit(BeBlocked(Not($filter_plural)))), Rule(CombatGroup{role:BlockedAttacker, participants:$filter_plural, comparison:GreaterOrEqual, amount:$value})]}) */
static_minimum_blockers ::= affected "can't" "be" "blocked" "except" "by" value "or" "more" filter_plural "."

/* Removal and prohibition remain distinct native changes. Each paired
   clause constrains both mentions to one native CheckHasable term. Hexproof
   suppression covers every hexproof variant rather than granting a keyword. */
line_ability_suppression ::= suppression_flying | suppression_first_strike | suppression_trample | suppression_hexproof | suppression_deathtouch

/* @sem Ability::[Static(_{kind:Ordinary, affected:Objects($affected), changes:[LosesAbility(Term{family:CheckHasable, form:Flying}), Rule(CantGainAbility(Term{family:CheckHasable, form:Flying}))]})] */
suppression_flying ::= affected ("lose" | "loses") "flying" "and" "can't" "have" "or" "gain" "flying" "."

/* @sem Ability::[Static(_{kind:Ordinary, affected:Objects($affected), changes:[LosesAbility(Term{family:CheckHasable, form:FirstStrike}), Rule(CantGainAbility(Term{family:CheckHasable, form:FirstStrike}))]})] */
suppression_first_strike ::= affected ("lose" | "loses") "first" "strike" "and" "can't" "have" "or" "gain" "first" "strike" "."

/* @sem Ability::[Static(_{kind:Ordinary, affected:Objects($affected), changes:[LosesAbility(Term{family:CheckHasable, form:Trample}), Rule(CantGainAbility(Term{family:CheckHasable, form:Trample}))]})] */
suppression_trample ::= affected ("lose" | "loses") "trample" "and" "can't" "have" "or" "gain" "trample" "."

/* @sem Ability::[Static(_{kind:Ordinary, affected:Objects($affected), changes:[LosesAbility(Term{family:CheckHasable, form:AnyHexproof}), Rule(CantGainAbility(Term{family:CheckHasable, form:AnyHexproof}))]})] */
suppression_hexproof ::= affected ("lose" | "loses") "hexproof" "and" "can't" "have" "or" "gain" "hexproof" "."

/* @sem Ability::[Static(_{kind:Ordinary, affected:Objects($affected), changes:[LosesAbility(Term{family:CheckHasable, form:Deathtouch}), Rule(CantGainAbility(Term{family:CheckHasable, form:Deathtouch}))]})] */
suppression_deathtouch ::= affected ("lose" | "loses") "deathtouch" "and" "can't" "have" "or" "gain" "deathtouch" "."

/* Entry state and a continuing property are separate native abilities. Only
   the replacement's body uses the entering controller's prospective scope. */
/* @sem Ability::[@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_ref)}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}]}}), Static{kind:Ordinary, affected:Objects(One($self_ref)), changes:$entry_continuing_changes}] */
line_entry_tapped_and_changes ::= self_ref "enters" "tapped" "and" entry_continuing_changes "."

/* @sem Change::[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})] */
entry_self_skip_untap ::= "doesn't" "untap" "during" "your" "untap" "step"

entry_continuing_changes ::= static_changes | entry_self_skip_untap

/* The possessive names this affected permanent's controller, including when
   the permanent is controlled by an opponent of the Aura's controller. */
/* @sem Change::[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})] */
rule_skip_untap_controller ::= "doesn't" "untap" "during" "its" "controller's" "untap" "step"
    | "don't" "untap" "during" "their" "untap" "step"

/* The source's own permanent controller is the speaker of this standalone
   self-reference. Do not expose the `your` form to generic affected subjects. */
/* @sem Ability::[Static{kind:Ordinary, affected:Objects(One($self_ref_holder)), changes:$entry_self_skip_untap}] */
line_self_skip_untap ::= self_ref_holder entry_self_skip_untap "."

/* An explicit original-set receipt precedes the first effect. Neither later
   characteristics nor control changes may change the plural antecedent. */
immediate_affected_set ::= objects_each | objects_each_other | objects_all | objects_all_other | affected_plural | affected_other

clause_counters_same_group ::= clause_original_counter_group

/* @sem Instruction::[Effect{result:@mark, operation:NoteObjects{objects:$immediate_affected_set}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Selected(@marked)), changes:[Pump{power:ObjectProperty{object:Affected, property:Power, information:CurrentOrLastKnown}, toughness:Constant(0)}], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Selected(@marked)), changes:$changes, duration:$duration_2, evaluation:Snapshot}}] */
clause_double_power_same_group ::= "double" "the" "power" "of" immediate_affected_set duration "." counter_group_reference changes duration

/* The characteristic bonus is unconditional. Only the blocking prohibition
   has the stated owner-defender exception; owner and controller differ. */
/* @sem Ability::[Static(_{kind:Ordinary, affected:Objects(One($object_ref)), changes:[Pump{power:$signed, toughness:$signed_2}]}), Conditional{condition:Not(ObjectMatches{object:$object_ref, filter:AnyOf([AttackingDefender(Objects(ControlledBy(One(OwnerOf($object_ref))))), AttackingDefender(Players(One(OwnerOf($object_ref))))])}), then:[Static(_{kind:Ordinary, affected:Objects(One($object_ref)), changes:[Rule(Prohibit(BeBlocked(Any)))]})], otherwise:[]}] */
line_pump_owner_attack_exception ::= object_ref "gets" signed "/" signed "and" "can't" "be" "blocked" "unless" "it's" "attacking" "its" "owner" "or" "a" "permanent" "its" "owner" "controls" "."

/* An announced target and a characteristic bonus describe a resolution effect,
   rather than a permanent's static characteristic declaration. Omission of a
   duration leaves that effect indefinite; explicit durations use their own rule. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($target_object)), changes:$indefinite_bonus_changes, duration:Indefinite, evaluation:Snapshot} */
continuous_bonus_indefinite ::= target_object indefinite_bonus_changes

indefinite_bonus_changes ::= change_pump | indefinite_bonus_changes_and
/* @sem Change::[...$change_pump, ...$changes] */
indefinite_bonus_changes_and ::= change_pump "and" changes

/* No-duration bonuses are complete sentences, never an operation fragment
   following a shared leading duration and a coordinating conjunction. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$continuous_bonus_indefinite}]} */
program_sentence_indefinite_bonus ::= continuous_bonus_indefinite "."

/* Coordinated characteristics and restrictions share one live host. Native
   canonicalization merges adjacent statics with this same kind and subject,
   so declare that merged form directly for both recognition and printing. */
/* @sem Ability::[Static(_{kind:Ordinary, affected:Objects(One($attached_ref)), changes:[...$attached_characteristics, ...$attached_restriction]})] */
line_attached_restrictions ::= attached_ref attached_characteristics (","? "and") attached_restriction "."

/* A rule and "can't be enchanted by other Auras" on the host of this Aura. */
/* @sem Ability::[Static(_{kind:Ordinary, affected:Objects(One($attached_ref)), changes:[...$rule_change, ...$attached_other_auras]})] */
line_attached_rule_other_auras ::= attached_ref rule_change "and" attached_other_auras "."

attached_characteristics ::= changes | attached_type_set

attached_restriction ::= rule_change | attached_activation_prohibition | attached_all_blockers
    | attached_matching_blocker | attached_other_auras

/* @sem Change::[Rule(Prohibit(Activate(Any)))] */
attached_activation_prohibition ::= "its" "activated" "abilities" "can't" "be" "activated"

/* Every creature able to block the host must do so; no creature is forced to
   attack, and the requirement remains on that host rather than on the Aura. */
/* @sem Change::[Rule(RequireCombat{action:BeBlocked(CardType(Creature)), amount:Each})] */
attached_all_blockers ::= "all" "creatures" "able" "to" "block" "it" "do" "so"

/* Setting just creature subtypes does not add Creature or overwrite colors. */
/* @sem Change::[CreatureTypes{mode:Set, types:Listed($becomes_types)}] */
attached_type_set ::= "is" ("a" | "an") becomes_types

/* One eligible matching blocker suffices. Existing restrictions and blocking
   costs still govern whether it is able; this is not exactly one or all. */
/* @sem Change::[Rule(RequireCombat{action:BeBlocked($filter_phrase), amount:AtLeast(Constant(1))})] */
attached_matching_blocker ::= "must" "be" "blocked" "by" ("a" | "an") filter_phrase "if" "able"

/* The source Aura remains allowed, while other Auras cannot remain attached.
   The excluded object is the Aura source, independently of the attached host. */
/* @sem Change::[Rule(Prohibit(BeAttachedBy{attachments:@and(ObjectFilter::Not(SameObject(Source)), ObjectFilter::Subtype(Aura)), keep_existing:false}))] */
attached_other_auras ::= "can't" "be" "enchanted" "by" "other" "Auras"

/* Unquoted mechanics are abilities of each recipient, distinct from Keyword. */
/* @sem Change::GrantAbility(@holder($granted_mechanic)) */
grant_native_mechanic ::= granted_mechanic

granted_mechanic ::= bare_rebound | bare_dethrone | bare_evolve | bare_exploit | bare_extort | granted_valued_mechanic | bare_battle_cry | bare_persist | mechanic_numbered_keyword | bare_jump_start | bare_exalted | granted_affinity | granted_replicate_mana_cost | granted_replicate_cost | bare_melee | bare_myriad | bare_provoke | bare_read_ahead | granted_poisonous | granted_outlast | bare_undying | mechanic_banding
/* @sem Ability::Mechanic{mechanic:Affinity, filter:$filter_plural} */
granted_affinity ::= "affinity" "for" filter_plural
/* Source belongs to the receiving spell, not the static granting permanent. */
/* @sem Ability::Mechanic{mechanic:Replicate, cost:Cost{parts:[ManaCostOf(Source)]}} */
granted_replicate_mana_cost ::= "replicate" "." "the" "replicate" "cost" "is" "equal" "to" "its" "mana" "cost"

/* Cast-time grants have distinct native spell-object and casting-player
   readings. Keep both; neither is an equality alias for the other. Source in
   each granted cost is the receiving spell, not the granting permanent. */
static_mechanic_grant ::= static_spell_mana_grant_with_cost_reduction | static_spell_mana_grant | static_spell_keyword_cost_reduction | static_spell_mechanic_grant | static_object_mechanic_grant
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellsHaveAbilities{spells:$spell_mana_grant_subject, abilities:List([$spell_mana_grant_effect])})]} */
static_spell_mana_grant ::= spell_mana_grant_subject ("has" | "have") spell_mana_grant_effect "."

spell_mana_grant_subject ::= spell_mana_grant_plain | spell_mana_grant_threshold | spell_mana_grant_all
/* @sem $card_filter */
spell_mana_grant_plain ::= "each" card_filter "spell" "you" "cast"
/* @sem @and($card_filter, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$spell_mana_grant_constant}}) */
spell_mana_grant_threshold ::= "each" card_filter "spell" "you" "cast" "with" "mana" "value" spell_mana_grant_constant "or" "greater"
/* @sem ObjectFilter::Any */
spell_mana_grant_all ::= "spells" "you" "cast" | "each" "spell" "you" "cast"
spell_mana_grant_constant ::= number_words | number_digits

spell_mana_grant_effect ::= spell_effect_affinity_population | spell_mana_grant_replicate | spell_mana_grant_blitz | spell_effect_delve | spell_effect_ripple
/* @sem Operand::Term{family:SpellEffect, form:Replicate, operands:[Cost{parts:[ManaCostOf(Source)]}]} */
spell_mana_grant_replicate ::= "replicate" "." "the" "replicate" "cost" "is" "equal" "to" "its" "mana" "cost"
/* @sem Operand::Term{family:SpellEffect, form:Blitz, operands:[Cost{parts:[ManaCostOf(Source)]}]} */
spell_mana_grant_blitz ::= "blitz" "." "the" "blitz" "cost" "is" "equal" "to" "its" "mana" "cost"

/* The stack-object reading retains the casting proposal's actor/origin filter
   and the holder scope of the granted mechanic. Permanent grants stay objects. */
/* Cast-time mechanics granted to spells, not to permanents in general. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($spell_holders), changes:[GrantAbility(@holder($spell_mechanic))]} */
static_spell_mechanic_grant ::= spell_holders ("has" | "have") spell_mechanic "."
spell_mechanic ::= bare_storm | mechanic_convoke | bare_cascade | bare_improvise | bare_demonstrate | bare_conspire | mechanic_cost_keyword
/* @sem Ability::Static{kind:Ordinary, affected:Objects($mechanic_grant_subject), changes:[GrantAbility(@holder($granted_mechanic))]} */
static_object_mechanic_grant ::= mechanic_grant_subject ("has" | "have") granted_mechanic "."

/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:@and($card_filter, ObjectFilter::Cast{by:One(AbilityController)})} */
mechanic_each_cast_spell ::= "each" card_filter "spell" "you" "cast"

/* Existing lowercase Clues vocabulary folds the sentence-initial spelling.
   Keep that declared spelling local to these typed mechanic grants. */
mechanic_grant_subject ::= mechanic_clues | mechanic_modified_clues
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:Subtype(Clue)} */
mechanic_clues ::= "clues"
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Subtype(Clue), $modifiers)} */
mechanic_modified_clues ::= "clues" modifiers

/* @sem Ability::Mechanic{mechanic:Replicate, cost:$cost} */
granted_replicate_cost ::= "replicate" cost

/* Mixed player/object recipients use different native keyword changes. These
   live static groups never turn the player into an object or grant the source
   an ability meant for its controlled recipients. */
line_hexproof_recipients ::= hexproof_player_objects | hexproof_player_object_list

/* @sem Ability::[Static{kind:Ordinary, affected:Players($hexproof_players), changes:[PlayerRule(GrantKeyword(Hexproof))]}, $hexproof_object_grant] */
hexproof_player_objects ::= hexproof_players "and" hexproof_object_grant "have" "hexproof" "."

/* @sem Ability::[Static{kind:Ordinary, affected:Players($hexproof_players), changes:[PlayerRule(GrantKeyword(Hexproof))]}, $hexproof_object_grant, $hexproof_object_grant_2] */
hexproof_player_object_list ::= hexproof_players "," hexproof_object_grant "," "and" hexproof_object_grant "have" "hexproof" "."

hexproof_players ::= hexproof_you | player_keyword_many
/* @sem PlayerSet::One(AbilityController) */
hexproof_you ::= "you"

/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$hexproof_object_filter}), changes:[GrantKeyword(Hexproof)]} */
hexproof_object_grant ::= hexproof_object_filter

hexproof_object_filter ::= filter_plural | contextual_other_filter

/* A one-shot grant to a player and to objects is two effects: the player's rule is
   live, while the objects are fixed when it resolves. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(GrantKeyword(Hexproof))], duration:$duration, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}), changes:[GrantKeyword(Hexproof)], duration:$duration, evaluation:Snapshot}}] */
clause_you_and_objects_gain_hexproof ::= "you" "and" filter_plural "gain" "hexproof" duration

/* A complete battlefield move names at most one object; its following grant
   uses the existing moved-incarnation pronoun contract. No bare indefinite
   grant operation is exposed after a possibly shared leading duration. */
/* @sem Instruction::[Effect{result:@next, operation:$post_grant_move}, Effect{result:@next, operation:@return_grant(Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:$grants, duration:Indefinite, evaluation:Snapshot})}] */
clause_post_move_grant ::= post_grant_move ("." | "and") "it" "gains" grants

post_grant_move ::= post_grant_move_controlled | post_grant_move_owned
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set(ObjectSet::One($post_grant_object))), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
post_grant_move_controlled ::= ("return" | "put") post_grant_object ("to" | "onto") "the" "battlefield" ("under" "your" "control")?
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set(ObjectSet::One($post_grant_object))), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
post_grant_move_owned ::= ("return" | "put") post_grant_object ("to" | "onto") "the" "battlefield" "under" owner_possessive "control"

post_grant_object ::= returning_card_ref | post_grant_card_pronoun | target_card
/* The existing return marker refuses a bare uncaptured Source fallback. */
/* @sem ObjectRef::@return_ref($it_ref) */
post_grant_card_pronoun ::= it_ref

/* The delayed action retains exactly the scalar move receipt across the
   intervening grant. It never treats the continuous-effect receipt as a token
   or re-queries the old graveyard target. */
/* @sem Instruction::[Effect{result:@mark, operation:$post_grant_move}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@marked, phase:After, index:0})), changes:$grants, duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:$post_grant_turn_point, players:One(AbilityController)}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@marked, phase:After, index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}] */
clause_post_move_grant_exile ::= post_grant_move "." "it" "gains" grants "." "exile" "it" "at" "the" "beginning" "of" "your" "next" post_grant_turn_point

post_grant_turn_point ::= post_grant_upkeep | post_grant_end_step
/* @sem TurnPoint::UpkeepBegins */
post_grant_upkeep ::= "upkeep"
/* @sem TurnPoint::EndStepBegins */
post_grant_end_step ::= "end" "step"

/* The quoted ability belongs to the newly moved object. Its Source and you
   reset at @holder, while the granting effect retains its creating source. */
/* @sem Instruction::[Effect{result:@next, operation:$post_grant_move}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[GrantAbility(@holder($ability))], duration:Indefinite, evaluation:Snapshot}}] */
clause_post_move_grant_quoted ::= post_grant_move "." "it" "gains" '"' ability '"'

/* BeBlocked already applies the cost once per declared blocker. The printed
   per-blocker wording does not add a second multiplier to its inner cost. */
/* @sem Change::[Rule(CombatCost{action:BeBlocked(Any), payer:DeclaringPlayer, cost:_{parts:[Mana($mana_symbols)]}})] */
rule_declared_blocker_cost ::= "can't" "be" "blocked" "unless" "defending" "player" "pays" mana_symbols "for" "each" "creature" "they" "control" "that's" "blocking" "it"

/* A single conjured card is an After result, not a token Created batch. The
   explicit producer supplies count one and the literal battlefield zone. */
/* @sem Instruction::[Effect{result:@mark, operation:$conjure_single_battlefield}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@marked, phase:After, index:0})), changes:$conjure_keywords, duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@marked, phase:After, index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}] */
clause_conjure_grant_exile ::= conjure_single_battlefield "." "that" "creature" "gains" conjure_keywords "." "exile" "it" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* @sem Operation::Conjure{actor:One(AbilityController), card:Random(Filter(@and(ObjectFilter::CardType(Creature), ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:$conjure_mana_value}}))), count:Constant(1), destination:Battlefield(BattlefieldArrival{tapped:false, counters:[], states:[]})} */
conjure_single_battlefield ::= "conjure" ("a" | "one") "random" "creature" "card" "with" "mana" "value" conjure_mana_value

/* One eager property read belongs to this producer; the where-X phrase does
   not capture or redefine X in the later grant or an independent holder. */
/* @sem $value */
conjure_value_inline ::= value "onto" "the" "battlefield"
/* @sem $value */
conjure_value_where ::= "X" "onto" "the" "battlefield" "," "where" "X" "is" value
conjure_mana_value ::= conjure_value_inline | conjure_value_where

/* Payment and its decision remain inside the delayed program. The explicit
   Created noun uses the actual singular creation receipt, never Source. */
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:One(AbilityController)}, start:Immediately, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:@created_named_reference}}]}, otherwise:Program{}}]}}}] */
clause_created_delayed_unless ::= "at" "the" "beginning" "of" "your" "next" "end" "step" "," "sacrifice" "it" "unless" "you" payment

/* Parameter-free keywords cannot accidentally import the producer's local X
   definition into another amount or an independent granted ability. */
conjure_keywords ::= conjure_keyword_one | conjure_keyword_more
/* @sem Change::[GrantKeyword($keyword_name)] */
conjure_keyword_one ::= keyword_name
/* @sem Change::[GrantKeyword($keyword_name), ...$conjure_keywords] */
conjure_keyword_more ::= keyword_name "and" conjure_keywords

/* Pronouns repeat exactly the preceding static population. Both bonus and
   keyword remain under one ongoing condition. */
/* @sem Ability::[Static(_{kind:Ordinary, affected:Objects($static_followup_affected), changes:$static_changes}), Conditional{condition:$condition, then:[Static(_{kind:Ordinary, affected:Objects($static_followup_affected), changes:$conditional_followup_changes})]}] */
line_static_conditional_followup ::= static_followup_affected static_changes "." ("it" | "they") conditional_followup_changes "as" "long" "as" condition "."
    | static_followup_affected static_changes "." "as" "long" "as" condition "," ("it" | "they") "also"? conditional_followup_changes "."

conditional_followup_changes ::= static_changes | static_additional_changes
/* @sem Change::[Pump{power:$signed, toughness:$signed_2}, ...$static_changes] */
static_additional_changes ::= ("gets" | "get") "an" "additional" signed "/" signed "and" static_changes

/* Chosen creature type is justified by the explicit creature domain. Keep this
   population local to static continuations: an unrestricted noun modifier
   would misread lands whose earlier choice has kind LandType. */
static_followup_affected ::= affected | static_followup_chosen_creatures
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::CardType(Creature), @and($modifier_you_control, ObjectFilter::Chosen(CreatureType)))} */
static_followup_chosen_creatures ::= "creatures" modifier_you_control "of" "the" "chosen" "type"

/* A battlefield population and a private-zone card population remain separate
   native static abilities, even when Oracle shares their characteristic verb. */
line_private_zone_static ::= line_private_zone_static_legacy | line_plural_private_zone_static

/* @sem Ability::[Static{kind:Ordinary, affected:Objects($cross_battlefield_subject), changes:$private_static_changes}, Static{kind:Ordinary, affected:Objects($private_static_subject), changes:$private_static_changes}] */
line_private_zone_static_legacy ::= cross_battlefield_subject "and" private_static_subject private_static_changes "."

static_private_zone ::= static_private_zone_legacy | static_plural_private_zone

/* @sem Ability::Static{kind:Ordinary, affected:Objects($private_static_subject), changes:$private_static_changes} */
static_private_zone_legacy ::= private_static_subject private_static_changes "."

private_static_subject ::= card_population

/* @sem Ability::Static{kind:Ordinary, affected:Objects($cross_battlefield_subject), changes:$static_basic} */
static_battlefield_basic ::= cross_battlefield_subject static_basic "."

private_static_changes ::= private_land_type_add | target_ban_plural | static_changes | static_basic

/* Basic is a supertype; it never grants any basic land subtype or mana ability. */
/* @sem Change::[AddSupertype(Basic)] */
static_basic ::= "are" "basic"

/* Each distributes one continuous change over the explicit holder/target pair. */
/* @sem ObjectSet::$objects_self_and_target */
affected_pair_each ::= objects_self_and_target "each"

/* The final quoted sentence closes a static grant's outer sentence as well. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:$static_changes_closed} */
static_quoted_grant ::= affected static_changes_closed

/* A change list whose last change grants a quoted ability: "gets +2/+2 and has flying
   and "{R}: …"". Its quote closes the sentence. */
static_changes_closed ::= static_changes_closed_has | static_changes_closed_have | static_changes_closed_more | static_base_closed_grants | static_base_closed_grants_oxford
/* @sem $closed_grants */
static_changes_closed_has ::= "has" closed_grants
/* @sem $closed_grants */
static_changes_closed_have ::= "have" closed_grants
/* @sem Change::[...$static_change, ...$static_changes_closed] */
static_changes_closed_more ::= static_change ("and" | "," "and"?) static_changes_closed

/* Losing all abilities comes before the quoted ability the holder then has. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[RemoveAllAbilities, ...$closed_grants]} */
static_lose_all_quoted_grant ::= affected ("loses" | "lose") "all" "abilities" "and" ("has" | "have") closed_grants

/* Shared color changes retain three native populations. AnyZone here is the
   card domain with the battlefield excluded; stack spells and battlefield
   permanents are independent, unrestricted by controller or owner. */
/* @sem Ability::[Static{kind:Ordinary, affected:Objects($global_nonbattlefield_cards), changes:$global_color_changes}, Static{kind:Ordinary, affected:Objects($global_stack_spells), changes:$global_color_changes}, Static{kind:Ordinary, affected:Objects($cross_battlefield_subject), changes:$global_color_changes}] */
line_global_cross_zone_colors ::= "all" global_nonbattlefield_cards "," global_stack_spells "," "and" cross_battlefield_subject "are" global_color_changes "."

/* @sem ObjectSet::AnyZone(@and(ObjectFilter::$global_card_filter, ObjectFilter::Not(InZone(Shared(Battlefield))))) */
global_nonbattlefield_cards ::= global_card_filter "that" "aren't" "on" "the" "battlefield"

global_card_filter ::= global_cards_any | global_cards_filtered
/* @sem ObjectFilter::Any */
global_cards_any ::= "cards"
/* @sem ObjectFilter::$card_filter */
global_cards_filtered ::= card_filter "cards"

/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:Any} */
global_stack_spells ::= "spells"

global_color_changes ::= global_colors_set | global_colors_add | global_chosen_color_set | global_chosen_color_add
/* @sem Change::[Colors{mode:Set, colors:$token_colors}] */
global_colors_set ::= token_colors
/* @sem Change::[Colors{mode:Add, colors:$token_colors}] */
global_colors_add ::= token_colors "in" "addition" "to" "their" "other" "colors"
/* @sem Change::[ChosenColor{mode:Set}] */
global_chosen_color_set ::= "the" "chosen" "color"
/* @sem Change::[ChosenColor{mode:Add}] */
global_chosen_color_add ::= "the" "chosen" "color" "in" "addition" "to" "their" "other" "colors"

/* "Target permanent becomes the color of your choice until end of turn": the color is
   chosen as the effect resolves, then the affected objects become that color. Without a
   duration the color lasts indefinitely. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[Term{family:ChoosableColor, form:AnyColor}]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[ChosenColor{mode:Set}], duration:$duration, evaluation:Snapshot}}] */
clause_becomes_color_choice ::= affected "becomes" "the" "color" "of" "your" "choice" duration
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[Term{family:ChoosableColor, form:AnyColor}]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[ChosenColor{mode:Set}], duration:$duration, evaluation:Snapshot}}] */
clause_become_color_choice ::= affected "become" "the" "color" "of" "your" "choice" duration
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[Term{family:ChoosableColor, form:AnyColor}]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[ChosenColor{mode:Set}], duration:Indefinite, evaluation:Snapshot}}] */
clause_becomes_color_choice_indefinite ::= affected "becomes" "the" "color" "of" "your" "choice"
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:AnyNumber, options:[]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[ChosenColor{mode:Set}], duration:$duration, evaluation:Snapshot}}] */
clause_becomes_colors_choice ::= affected "becomes" "the" "color" "or" "colors" "of" "your" "choice" duration
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:AnyNumber, options:[]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[ChosenColor{mode:Set}], duration:Indefinite, evaluation:Snapshot}}] */
clause_becomes_colors_choice_indefinite ::= affected "becomes" "the" "color" "or" "colors" "of" "your" "choice"
/* "This creature gets +1/+1 and becomes the color of your choice until end of turn." */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[Term{family:ChoosableColor, form:AnyColor}]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[...$changes, ChosenColor{mode:Set}], duration:$duration, evaluation:Snapshot}}] */
clause_changes_and_color_choice ::= affected changes "and" "becomes" "the" "color" "of" "your" "choice" duration

/* Spending permission changes no mana color and creates no mana. Its player
   population is independent of the three object populations above. */
/* @sem Ability::Static{kind:Ordinary, affected:Players($color_spending_players), changes:[PlayerRule(SpendManaAs{spend_as:AnyColor, on:Anything})]} */
static_player_color_spending ::= color_spending_players "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "."

color_spending_players ::= color_spending_all | color_spending_you
/* @sem PlayerSet::All */
color_spending_all ::= "players" | "all" "players"
/* @sem PlayerSet::One(AbilityController) */
color_spending_you ::= "you"

/* Each listed change has its own condition. The subject is shared by exact
   semantic-hole identity; conditions never become one enclosing gate. Lists
   are bounded to two through five items and end at the sentence period. */
line_independent_static_list ::= independent_static_two | independent_static_three | independent_static_four | independent_static_five

/* Only scalar self/attached subjects are proved here. A plural subject needs
   per-affected condition binding and is deliberately outside this family. */
/* @sem ObjectSet::One($independent_static_object) */
independent_static_subject ::= independent_static_object
independent_static_object ::= self_ref | attached_ref

/* These gates read an independent controller population, never a pronoun whose
   antecedent would require new subject binding. */
/* @sem Condition::Controls{player:AbilityController, filter:$noun, minimum:1} */
independent_static_gate ::= ("as" "long" "as" | "if") "you" "control" ("a" | "an") noun

independent_static_changes ::= change_pump | change_grant | independent_static_keyword | independent_static_activated
/* @sem Change::[GrantKeyword($keyword_value)] */
independent_static_keyword ::= keyword_value

/* @sem () */
independent_static_last ::= "," "and" | "and"

/* @sem Ability::[Conditional{condition:$independent_static_gate, then:[Static{kind:Ordinary, affected:Objects($independent_static_subject), changes:$independent_static_changes}], otherwise:[]}, Conditional{condition:$independent_static_gate_2, then:[Static{kind:Ordinary, affected:Objects($independent_static_subject), changes:$independent_static_changes_2}], otherwise:[]}] */
independent_static_two ::= independent_static_subject independent_static_changes independent_static_gate independent_static_last independent_static_changes independent_static_gate "."

/* @sem Ability::[Conditional{condition:$independent_static_gate, then:[Static{kind:Ordinary, affected:Objects($independent_static_subject), changes:$independent_static_changes}], otherwise:[]}, Conditional{condition:$independent_static_gate_2, then:[Static{kind:Ordinary, affected:Objects($independent_static_subject), changes:$independent_static_changes_2}], otherwise:[]}, Conditional{condition:$independent_static_gate_3, then:[Static{kind:Ordinary, affected:Objects($independent_static_subject), changes:$independent_static_changes_3}], otherwise:[]}] */
independent_static_three ::= independent_static_subject independent_static_changes independent_static_gate "," independent_static_changes independent_static_gate independent_static_last independent_static_changes independent_static_gate "."

/* @sem Ability::[Conditional{condition:$independent_static_gate, then:[Static{kind:Ordinary, affected:Objects($independent_static_subject), changes:$independent_static_changes}], otherwise:[]}, Conditional{condition:$independent_static_gate_2, then:[Static{kind:Ordinary, affected:Objects($independent_static_subject), changes:$independent_static_changes_2}], otherwise:[]}, Conditional{condition:$independent_static_gate_3, then:[Static{kind:Ordinary, affected:Objects($independent_static_subject), changes:$independent_static_changes_3}], otherwise:[]}, Conditional{condition:$independent_static_gate_4, then:[Static{kind:Ordinary, affected:Objects($independent_static_subject), changes:$independent_static_changes_4}], otherwise:[]}] */
independent_static_four ::= independent_static_subject independent_static_changes independent_static_gate "," independent_static_changes independent_static_gate "," independent_static_changes independent_static_gate independent_static_last independent_static_changes independent_static_gate "."

/* @sem Ability::[Conditional{condition:$independent_static_gate, then:[Static{kind:Ordinary, affected:Objects($independent_static_subject), changes:$independent_static_changes}], otherwise:[]}, Conditional{condition:$independent_static_gate_2, then:[Static{kind:Ordinary, affected:Objects($independent_static_subject), changes:$independent_static_changes_2}], otherwise:[]}, Conditional{condition:$independent_static_gate_3, then:[Static{kind:Ordinary, affected:Objects($independent_static_subject), changes:$independent_static_changes_3}], otherwise:[]}, Conditional{condition:$independent_static_gate_4, then:[Static{kind:Ordinary, affected:Objects($independent_static_subject), changes:$independent_static_changes_4}], otherwise:[]}, Conditional{condition:$independent_static_gate_5, then:[Static{kind:Ordinary, affected:Objects($independent_static_subject), changes:$independent_static_changes_5}], otherwise:[]}] */
independent_static_five ::= independent_static_subject independent_static_changes independent_static_gate "," independent_static_changes independent_static_gate "," independent_static_changes independent_static_gate "," independent_static_changes independent_static_gate independent_static_last independent_static_changes independent_static_gate "."


/* A quoted activation without an inner period remains part of this item's
   conditional predicate. Its holder is independent of the creating source. */
/* @sem Change::[GrantAbility(@holder(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program}))] */
independent_static_activated ::= '"' cost ":" program '"'

/* Resolving paired loss and grant fixes the same affected objects for both
   changes. No duration wording means the created effect is indefinite. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[LosesAbility(Term{family:CheckHasable, form:Defender}), GrantKeyword($keyword_value)], duration:Indefinite, evaluation:Snapshot} */
keyword_loss_gain_indefinite ::= affected "loses" "defender" "and" "gains" keyword_value

/* The explicit scalar subject owns both the static recipient and its state
   test. Plural subjects require a separate per-object condition contract. */
/* @sem Ability::Conditional{condition:ObjectMatches{object:$scalar_static_subject, filter:$scalar_static_state}, then:[Static{kind:Ordinary, affected:Objects(One($scalar_static_subject)), changes:$static_changes}], otherwise:[]} */
scalar_subject_static_condition ::= scalar_static_subject static_changes "as" "long" "as" "it's" scalar_static_state "."
scalar_static_subject ::= self_ref | attached_ref
scalar_static_state ::= adjective_untapped | adjective_tapped | adjective_attacking | adjective_blocking | scalar_static_attacking_alone
/* @sem ObjectFilter::State(AttackingAlone) */
scalar_static_attacking_alone ::= "attacking" "alone"

/* "Enchanted creature gets +2/+2 as long as it's a Vampire. Otherwise, it gets -2/-2.":
   the second static applies to the same subject while its test fails. */
/* @sem Ability::Conditional{condition:ObjectMatches{object:$scalar_static_subject, filter:$scalar_otherwise_test}, then:[Static{kind:Ordinary, affected:Objects(One($scalar_static_subject)), changes:$static_changes}], otherwise:[Static{kind:Ordinary, affected:Objects(One($scalar_static_subject)), changes:$static_changes_2}]} */
scalar_subject_static_otherwise ::= scalar_static_subject static_changes "as" "long" "as" "it's" scalar_otherwise_test "." "otherwise" "," "it" static_changes "."
scalar_otherwise_test ::= scalar_static_state | scalar_otherwise_kind | adjective_color
/* @sem $filter_phrase */
scalar_otherwise_kind ::= ("a" | "an") filter_phrase

/* The scalar optional-other target has a lexical antecedent, independently
   of the operation's effect receipt. Keep this opt-in to characteristic changes;
   generic verbs retain their existing target/pronoun ownership contracts. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($other_target_up_to)), changes:$static_changes, duration:$duration, evaluation:Snapshot} */
optional_other_static_snapshot ::= other_target_up_to static_changes duration

/* "Each" is a subject-side quantifier; the effect still receives the complete
   announced target set. It is not a trailing modifier on imperative objects. */
/* @sem ObjectSet::$objects_targets */
affected_targets_each ::= objects_targets "each"

/* The controller chooses one ability for the stated affected population. The
   temporary and perpetual producers remain distinct operations. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Ability, terms:_{count:Exactly(Constant(1)), options:$choice_keyword_options}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($choice_keyword_subject), changes:[ChosenAbility], duration:$duration, evaluation:Snapshot}}] */
clause_keyword_choice_temporary ::= choice_keyword_subject ("gains" | "gain") "your" "choice" "of" choice_keyword_options duration

/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Ability, terms:_{count:Exactly(Constant(1)), options:$choice_keyword_options}}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:$choice_keyword_subject, changes:[ChosenAbility]}}] */
clause_keyword_choice_perpetual ::= choice_keyword_subject "perpetually" ("gains" | "gain") "your" "choice" "of" choice_keyword_options

clause_keyword_choice ::= clause_keyword_choice_temporary | clause_keyword_choice_perpetual

/* A crewing relation names the prior object before this target is introduced.
   Candidate is the creature being selected; current_it is the outer referent. */
choice_keyword_subject ::= affected | choice_keyword_crewed_target
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, Condition(Compare{left:EventHistory{event:Pair{event:Crews, objects:SameObject(Candidate), others:SameObject(@current_it)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})])}), index:0}) */
choice_keyword_crewed_target ::= "target" noun "that" "crewed" "it" "this" "turn"

/* Bare keywords carry no nested payment/holder context. Preserve option order
   and the current operands for lists of two or more choices. */
choice_keyword_options ::= choice_keyword_pair | choice_keyword_many
/* @sem Operand::[Ability(Keyword($keyword_name)), Ability(Keyword($keyword_name_2))] */
choice_keyword_pair ::= keyword_name "or" keyword_name
/* @sem Operand::[Ability(Keyword($keyword_name)), ...$choice_keyword_tail] */
choice_keyword_many ::= keyword_name "," choice_keyword_tail
choice_keyword_tail ::= choice_keyword_last | choice_keyword_options
/* @sem Operand::[Ability(Keyword($keyword_name))] */
choice_keyword_last ::= "or" keyword_name

/* The eligibility belongs to the granting population, not the received ability. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($nonbattlefield_owned_subject), changes:[GrantAbility(@holder($nonbattlefield_granted_ability))]} */
static_nonbattlefield_owned_grant ::= nonbattlefield_owned_subject nonbattlefield_granted_ability "."
nonbattlefield_owned_subject ::= nonbattlefield_plural_subject_verb | nonbattlefield_singular_subject_verb
/* @sem $nonbattlefield_owned_plural */
nonbattlefield_plural_subject_verb ::= nonbattlefield_owned_plural "have"
/* @sem $nonbattlefield_owned_singular */
nonbattlefield_singular_subject_verb ::= nonbattlefield_owned_singular "has"
/* @sem ObjectSet::AnyZone(@and($filter_phrase, ObjectFilter::OwnedBy(One(AbilityController)), ObjectFilter::Not(InZone(Shared(Battlefield))))) */
nonbattlefield_owned_plural ::= filter_phrase "cards" "you" "own" "that" "aren't" "on" "the" "battlefield"
/* @sem ObjectSet::AnyZone(@and($filter_phrase, ObjectFilter::OwnedBy(One(AbilityController)), ObjectFilter::Not(InZone(Shared(Battlefield))))) */
nonbattlefield_owned_singular ::= "each" filter_phrase "card" "you" "own" "that" "isn't" "on" "the" "battlefield"
nonbattlefield_granted_ability ::= nonbattlefield_granted_keyword | nonbattlefield_granted_madness
/* @sem Ability::Keyword($keyword_value) */
nonbattlefield_granted_keyword ::= keyword_value
/* The granted card is Source for its own madness cost; the granter is not. */
/* @sem Ability::Mechanic{mechanic:Madness, cost:Cost{parts:[ManaCostOf(Source)]}} */
nonbattlefield_granted_madness ::= "madness" "." "the" "madness" "cost" "is" "equal" "to" "its" "mana" "cost"

/* A shared written subject supplies both populations. Characteristic changes
   snapshot their recipients; the conjoined rule keeps the same live query. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($shared_rule_subject), changes:$shared_rule_characteristics, duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($shared_rule_subject), changes:$rule_changes, duration:$this_duration, evaluation:LiveObjects}}] */
clause_shared_population_rule ::= shared_rule_subject shared_rule_characteristics duration "and" rule_changes this_duration

/* Only explicit noun, target and holder subjects enter this composition.
   Implicit pronoun/receipt continuations keep their separate contracts. */
shared_rule_subject ::= immediate_affected_set | affected_targets_each | affected_pair_each | shared_rule_object
/* @sem ObjectSet::One($shared_rule_reference) */
shared_rule_object ::= shared_rule_reference
shared_rule_reference ::= target_object | self_explicit_ref | attached_ref

/* This explicit capture is equivalent to the earlier effect's recorded
   affected set; preserve that original receipt reading as well. */
/* @sem Instruction::[Effect{result:@mark, operation:NoteObjects{objects:$immediate_affected_set}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Selected(@marked)), changes:$change_pump, duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:SetTapped{objects:Selected(@marked)}}] */
clause_selected_continuous_untap ::= immediate_affected_set change_pump duration "." "untap" "them"

/* An explicit temporary base-setting has the same independently determined
   characteristic and rule populations as an ordinary characteristic bonus. */
shared_rule_characteristics ::= changes | shared_rule_base_stats
/* @sem Change::[SetBasePowerToughness{power:$number, toughness:$number_2}] */
shared_rule_base_stats ::= ("has" | "have") "base" "power" "and" "toughness" number "/" number

/* The permission changes the blocking limit, independently of any preceding
   characteristic snapshot; it retains that same explicitly written subject. */
/* @sem Change::[Rule(BlockCapacity(Unlimited))] */
rule_block_unlimited ::= "can" "block" "any" "number" "of" "creatures"

/* A duration-first control change and its coordinated keyword share the one
   explicit target. This creates one characteristic snapshot, not a second target. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($target_object)), changes:[SetController(AbilityController), GrantKeyword($keyword_value)], duration:$duration, evaluation:Snapshot} */
gain_control_and_keyword ::= duration "," "you" "gain" "control" "of" target_object "and" "it" "gains" keyword_value

/* These two spellings share one counter Pump meaning. The joined form
   preserves the two explicit host sentences as one native Static. */
static_attached_counter_population ::= static_attached_counter_plain | static_attached_counter_joined

/* @sem Ability::Static{kind:Ordinary, affected:Objects(One(ObjectRef::@enchanted_creature_operand(ObjectRef::AttachedTo(Source)))), changes:[$attached_counter_pump]} */
static_attached_counter_plain ::= attached_counter_pump "."

/* @sem Ability::Static{kind:Ordinary, affected:Objects(One(ObjectRef::@enchanted_creature_operand(ObjectRef::AttachedTo(Source)))), changes:[$attached_counter_pump, ...$attached_counter_follow]} */
static_attached_counter_joined ::= attached_counter_pump "." NEWLINE "enchanted" "creature" attached_counter_follow

/* @sem Change::Pump{power:@times($signed, Expr::CountCounters{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::CardType(Creature), ObjectFilter::ControlledBy(One(AbilityController)), ObjectFilter::Not(ObjectFilter::SameObject(AttachedTo(Source))))}), kind:$counter_kind, information:CurrentOrLastKnown}), toughness:@times($signed_2, Expr::CountCounters{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::CardType(Creature), ObjectFilter::ControlledBy(One(AbilityController)), ObjectFilter::Not(ObjectFilter::SameObject(AttachedTo(Source))))}), kind:$counter_kind, information:CurrentOrLastKnown})} */
attached_counter_pump ::= "enchanted" "creature" "gets" signed "/" signed "for" "each" counter_kind ("counter" | "counters") "on" "other" "creatures" "you" "control"

/* The existing quoted-sentence rule owns its closing inner period. Ordinary
   unquoted changes still require their own terminal period. */
attached_counter_follow ::= attached_counter_follow_plain | attached_counter_follow_quoted
/* @sem $static_changes */
attached_counter_follow_plain ::= static_changes "."
/* @sem $closed_grants */
attached_counter_follow_quoted ::= ("has" | "have") closed_grants

/* The receiving player is the caster. Cast's origin narrows the spells, not
   the zone of the rule's affected player or the ability holder. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellsHaveAbilities{spells:@and($cast_spells_filter, $cast_origin_filter), abilities:List([Term{family:SpellEffect, form:Convoke}])})]} */
static_exile_convoke ::= cast_spells_filter "you" "cast" cast_origin_filter "have" "convoke" "."

/* A separate requirement for every matching creature able to block the written
   attacker. This is the attacker-owned view of the existing blocker-owned
   requirement; the holder remains the continuous effect's source. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($object_ref)), changes:[Rule(RequireCombat{action:BeBlocked($filter_plural), amount:Each})], duration:$this_duration, evaluation:LiveObjects} */
all_matching_blockers_attacker_view ::= "all" filter_plural "able" "to" "block" object_ref this_duration "do" "so"

/* The explicitly introduced one-creature target, not the source or the
   successful counter participants, remains the following noun's referent. */
/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($counter_keyword_creature_target)), kind:$counter_kind, amount:$counter_amount}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($counter_keyword_creature_target)), changes:[$grant_keyword], duration:$duration, evaluation:Snapshot}}] */
clause_counter_target_keyword ::= "put" counter_amount counter_kind ("counter" | "counters") "on" counter_keyword_creature_target ","? "and" "that" "creature" "gains" grant_keyword duration

/* This lexical subset positively proves the subsequent creature noun. It
   shares the existing another-target holder/reference policy verbatim. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Not(SameObject(@another_target_reference(ObjectFilter::AllOf([CardType(Creature), ControlledBy(One(AbilityController))])))), ObjectFilter::CardType(Creature), ObjectFilter::ControlledBy(One(AbilityController)))}), index:0} */
counter_keyword_creature_target ::= "another" "target" "creature" "you" "control"

/* Explicit private-card populations retain owner versus controller and zone
   predicates. AnyZone here never includes the battlefield. */
/* @sem ObjectSet::AnyZone(@and(ObjectFilter::$card_filter, ObjectFilter::OwnedBy(One(AbilityController)), ObjectFilter::Not(InZone(Shared(Battlefield))))) */
private_owned_nonbattlefield_cards ::= card_filter "cards" "you" "own" "that" "aren't" "on" "the" "battlefield"
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$card_filter} */
private_all_graveyard_cards ::= card_filter "cards" "in" "graveyards"
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:Any} */
private_any_graveyard_cards ::= "cards" "in" "graveyards"
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural} */
cross_explicit_battlefield ::= filter_plural "on" "the" "battlefield"

/* These shared characteristic changes use the same explicit plural subject
   owner as the existing private-zone static rule, never a temporary grant. */
/* @sem Change::[AddLandType($private_land_plural)] */
private_land_type_add ::= "are" private_land_plural "in" "addition" "to" "their" "other" "types"
private_land_plural ::= private_deserts | private_forests | private_islands | private_swamps | private_mountains | private_plains
/* @sem LandType::Desert */
private_deserts ::= "Deserts"
/* @sem LandType::Forest */
private_forests ::= "Forests"
/* @sem LandType::Island */
private_islands ::= "Islands"
/* @sem LandType::Swamp */
private_swamps ::= "Swamps"
/* @sem LandType::Mountain */
private_mountains ::= "Mountains"
/* @sem LandType::Plains */
private_plains ::= "Plains"

/* New explicitly plural subjects never flow into singular has/gets grammar.
   Legacy greatest_* owners keep their existing checked declarations unchanged. */
plural_private_subject ::= private_owned_nonbattlefield_cards | private_all_graveyard_cards | private_any_graveyard_cards
/* @sem Ability::[Static{kind:Ordinary, affected:Objects($cross_battlefield_subject), changes:$plural_private_changes}, Static{kind:Ordinary, affected:Objects($plural_private_subject), changes:$plural_private_changes}] */
line_plural_private_zone_static ::= cross_battlefield_subject "and" plural_private_subject plural_private_changes "."
/* @sem Ability::Static{kind:Ordinary, affected:Objects($plural_private_subject), changes:$plural_private_changes} */
static_plural_private_zone ::= plural_private_subject plural_private_changes "."
plural_private_changes ::= plural_private_change | plural_private_changes_more
/* @sem Change::[...$plural_private_change, ...$plural_private_changes] */
plural_private_changes_more ::= plural_private_change ("and" | "," "and"?) plural_private_changes
plural_private_change ::= private_land_type_add | target_ban_plural | static_basic | plural_private_pump | plural_private_grant
/* @sem Change::[Pump{power:$signed, toughness:$signed_2}] */
plural_private_pump ::= "get" signed "/" signed
/* Same granted-ability owner as the established nonbattlefield-owned grants:
   Flash keywords are not a second GrantKeyword representation of those words. */
/* @sem Change::[GrantAbility(@holder($nonbattlefield_granted_ability))] */
plural_private_grant ::= ("have" | "gain") nonbattlefield_granted_ability

/* The written plural antecedent is the population before the first action,
   including objects that cannot receive the counters. */
/* @sem Instruction::[Effect{result:@mark, operation:NoteObjects{objects:$immediate_affected_set}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Selected(@marked)), kind:$counter_kind, amount:$counter_amount}]}}, ...$original_counter_followup] */
clause_original_counter_group ::= "put" counter_amount counter_kind ("counter" | "counters") "on" immediate_affected_set ("and" | ".") original_counter_followup

original_counter_followup ::= original_counter_changes | original_counter_untap | original_counter_gain_life
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Selected(@marked)), changes:$changes, duration:$duration, evaluation:Snapshot}}] */
original_counter_changes ::= counter_group_reference changes duration
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:Selected(@marked), tapped:false}}] */
original_counter_untap ::= "untap" original_counter_count_words
/* @sem Instruction::[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:@times($number, Expr::CountObjects(Selected(@marked)))}}] */
original_counter_gain_life ::= "you" "gain" number "life" "for" "each" "of" original_counter_count_words
/* @sem () */
original_counter_count_words ::= "those" ("creatures" | "permanents")

/* CR205.1a-b: named subtype changes replace; explicit retention adds. Card
   type retention is independent of this creature-subtype mode. */
/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word, $mana_color_word_2]}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, AddCardType(Artifact), AddCardType(Creature)] */
bk_two_colors_named_artifact ::= mana_color_word "and" mana_color_word becomes_types "artifact" "creature"
/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word, $mana_color_word_2]}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, AddCardType(Artifact), AddCardType(Creature)] */
bk_two_colors_named_artifact_native ::= mana_color_word "and" mana_color_word becomes_types "artifact" "creature"

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:CreatureType, terms:_{except:[Vocabulary{family:CreatureType, form:@subtype_name($creature_subtype)}], count:Exactly(Constant(1))}} */
choose_creature_type_excluding ::= "choose" "a" "creature" "type" "other" "than" creature_subtype
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:CreatureType, terms:_{count:Exactly(Constant(1))}} */
choose_creature_type_plain ::= "choose" "a" "creature" "type"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[ChosenType{kind:CreatureType, mode:Set}], duration:$duration, evaluation:Snapshot} */
continuous_chosen_creature_type ::= affected "becomes" "that" "type" duration
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[ChosenType{kind:CreatureType, mode:Add}], duration:$duration, evaluation:Snapshot} */
continuous_chosen_creature_type_retained ::= affected "becomes" "that" "type" retention_addition duration

/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:CreatureType, terms:_{count:Exactly(Constant(1))}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[ChosenType{kind:CreatureType, mode:Set}], duration:$duration, evaluation:Snapshot}}] */
clause_creature_type_choice_timed ::= affected "becomes" "the" "creature" "type" "of" "your" "choice" duration
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:CreatureType, terms:_{count:Exactly(Constant(1))}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[ChosenType{kind:CreatureType, mode:Set}], duration:Indefinite, evaluation:Snapshot}}] */
clause_creature_type_choice_indefinite ::= affected "becomes" "the" "creature" "type" "of" "your" "choice"
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:BasicLandType, terms:_{count:Exactly(Constant(1))}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[ChosenType{kind:LandType, mode:Set}], duration:$duration, evaluation:Snapshot}}] */
clause_basic_land_type_choice_timed ::= affected "becomes" "the" "basic" "land" "type" "of" "your" "choice" duration

/* That-type wording takes its kind from this explicit choice sentence. It
   cannot escape as an independent creature-typed operation after a land choice. */
/* @sem Instruction::[Effect{result:@next, operation:$creature_type_choice_operation}, Effect{result:@next, operation:$creature_type_chosen_change}] */
clause_choose_creature_type_change ::= creature_type_choice_operation "." creature_type_chosen_change
creature_type_choice_operation ::= choose_creature_type_plain | choose_creature_type_excluding
creature_type_chosen_change ::= continuous_chosen_creature_type | continuous_chosen_creature_type_retained

/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:BasicLandType, terms:_{count:Exactly(Constant(1))}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[ChosenType{kind:LandType, mode:Set}], duration:$duration, evaluation:Snapshot}}] */
clause_choose_basic_land_type_change ::= "choose" "a" "basic" "land" "type" "." affected "becomes" "that" "type" duration

/* An explicit type noun also supports edited/persistent choices, independently
   of a preceding choice of another kind. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[ChosenType{kind:CreatureType, mode:Set}], duration:$duration, evaluation:Snapshot} */
continuous_chosen_creature_type_explicit ::= affected "becomes" "the" "chosen" "creature" "type" duration

/* Adjacent rules of this same player merge natively. Declare the complete span
   as well, so printing a merged IR never drops either the grant or reduction. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellsHaveAbilities{spells:$spell_mana_grant_subject, abilities:List([$spell_mana_grant_effect])}), $spell_blitz_cost_rule]} */
static_spell_mana_grant_with_cost_reduction ::= spell_mana_grant_subject ("has" | "have") spell_mana_grant_effect "." NEWLINE spell_blitz_cost_rule "."
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[$spell_blitz_cost_rule]} */
static_spell_keyword_cost_reduction ::= spell_blitz_cost_rule "."
/* @sem Change::PlayerRule(KeywordCost{keyword:Blitz, cards:Any, change:Reduce($spell_generic_reduction), per:$count_each_commander_cast}) */
spell_blitz_cost_rule ::= "blitz" "costs" "you" "pay" "cost" spell_generic_reduction "less" "for" "each" count_each_commander_cast
/* @sem Operand::List([Term{family:ManaSymbol, form:ManaCostGeneric, operands:[Integer($number)]}]) */
spell_generic_reduction ::= "{" NUMBER "}"

/* The color-count qualifier belongs to the graveyard card population. The
   granted mechanic is held by each receiving card. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:@and($card_filter, $filter_exact_color_count)}), changes:[GrantAbility(Mechanic{mechanic:JumpStart})]} */
static_graveyard_card_exact_color_jump_start ::= "each" card_filter "card" "in" "your" "graveyard" filter_exact_color_count "has" "jump-start" "."

/* Reach overrides flying only for the stated attacking population; it grants
   no persistent keyword and leaves other evasion rules in force. */
/* @sem Change::[Rule(BlocksDespite{attackers:$filter_plural, evasion:Flying})] */
blocks_as_though_had_reach ::= "can" "block" filter_plural "as" "though" "it" "had" "reach"

/* Each population retains its zone and selector. A shared trait phrase does
   not turn spell control into casting or battlefield control into ownership. */
/* @sem Ability::[Static{kind:Ordinary, affected:Objects($cross_battlefield_subject), changes:$cross_characteristics}, Static{kind:Ordinary, affected:Objects($cross_spells), changes:$cross_characteristics}] */
line_battlefield_and_stack_traits ::= cross_battlefield_subject "and" cross_spells cross_characteristics "."

/* Damage-source color is distinct from changing the object's actual colors.
   The pinned permanent and spell domains use their respective native changes. */
/* @sem Ability::[Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$damage_source_color_filter}), changes:[Rule(Unique(ColorlessSourceOfDamage))]}, Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Stack), kind:Spell, filter:$damage_source_color_filter}), changes:[ColorlessDamageSource]}] */
line_mixed_damage_zone ::= damage_source_color_filter "permanents" "and" "spells" "are" "colorless" "sources" "of" "damage" "."
damage_source_color_filter ::= adjective_color | damage_source_color_pair
/* @sem ObjectFilter::AnyOf(@unordered([$adjective_color, $adjective_color_2])) */
damage_source_color_pair ::= adjective_color "and" "/" "or" adjective_color

/* Ignore summoning sickness only for attacks at the stated defenders. This
   grants no Haste keyword and makes no exception for other players. The plural
   follow-up requires a plural subject. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected_plural), changes:$rule_attack_haste_opponent_defenders} */
static_opponent_attack_haste ::= ("all")? affected_plural rule_attack_haste_opponent_defenders "."
/* @sem Change::[Rule(AttackException{ignore:SummoningSickness, defenders:PlayersAndPlaneswalkers(OpponentsOf(PlayerRef::AbilityController))})] */
rule_attack_haste_opponent_defenders ::= "can" "attack" "your" "opponents" "and" "planeswalkers" "your" "opponents" "control" "as" "though" "those" "creatures" "had" "haste"

/* @sem Change::[Rule(BlocksDespite{attackers:Any, evasion:Landwalk})] */
blocks_as_though_landwalk ::= "can" "block" "creatures" "with" "landwalk" "abilities" "as" "though" "they" "didn't" "have" "those" "abilities"

/* Either deadline ends the effect at its first matching event. The die face
   is an event amount, independent of the affected objects or ability holder. */
/* @sem Duration::Either([$until_end_of_turn, UntilEvent(Filtered{event:Player{event:RollsADie, players:All}, condition:Compare{left:EventAmount, test:NumberTest::Compare{comparison:Equal, value:$number}}})]) */
duration_die_roll_earliest ::= until_end_of_turn "," "or" "until" "any" "player" "rolls" "a" number "," "whichever" "comes" "first"

/* Rule changes follow the live population, while the base statistics snapshot
   the same operands. Each written deadline belongs to its own effect. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$rule_changes, duration:$this_duration, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[SetBasePowerToughness{power:$number, toughness:$number_2}], duration:$duration, evaluation:Snapshot}}] */
clause_live_then_base_stats ::= affected rule_changes this_duration "and" ("has" | "have") "base" "power" "and" "toughness" number "/" number duration

/* The owner belongs to this explicitly named object, including a receiving
   holder inside a grant. No attacker or previous target supplies its owner. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(One($self_explicit_ref)), changes:[Rule(Prohibit(Attack(Players(One(OwnerOf($self_explicit_ref))))))]} */
static_cant_attack_owner ::= self_explicit_ref "can't" "attack" "its" "owner" "."

/* The stated player fixes both the step and expiry. Every creature is subject
   to the rule, including one another player untaps during that step. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}), changes:[Rule(UntapStep{players:One($possessive_target_player), behavior:Skip})], duration:DuringNextUntapStep($possessive_target_player), evaluation:LiveObjects} */
creatures_skip_target_next_untap ::= "creatures" "don't" "untap" "during" possessive_target_player "next" "untap" "step"

/* Player protection and creature protection retain distinct recipients. */
/* @sem Ability::[Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(GrantKeyword(Protection(Objects{kind:Any, filter:Chosen(CardType)})))]}, Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), changes:[GrantKeyword(Protection(Objects{kind:Any, filter:Chosen(CardType)}))]}] */
line_player_creature_chosen_protection ::= "you" "and" "creatures" "you" "control" "have" "protection" "from" "the" "chosen" "card" "type" "."

/* Both stated spell populations get timing permission, without a permission
   to play them from another zone or a change to their other restrictions. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellTiming{spells:AnyOf(@unordered([$card_filter, $card_filter_2])), timing:Flash})]} */
static_spell_filter_pair_flash ::= "you" "may" "cast" card_filter "spells" "and" card_filter "spells" "as" "though" "they" "had" "flash" "."

/* The cause filters and the controlled ability holders are independent.
   Entering and leaving remain two native trigger-rule entries. */
/* @sem Ability::[TriggerRule{cause:ZoneChange{objects:AnyOf(@unordered([$filter_phrase, $filter_phrase_2])), to:Battlefield}, abilities:AbilityOf(ControlledBy(One(AbilityController))), rule:TriggersAgain}, TriggerRule{cause:Object{event:LeavesBattlefield, objects:AnyOf(@unordered([$filter_phrase, $filter_phrase_2]))}, abilities:AbilityOf(ControlledBy(One(AbilityController))), rule:TriggersAgain}] */
line_additional_enter_leave_triggers ::= "if" ("a" | "an") filter_phrase "or" ("a" | "an") filter_phrase "entering" "or" "leaving" "the" "battlefield" "causes" "a" "triggered" "ability" "of" "a" "permanent" "you" "control" "to" "trigger" "," "that" "ability" "triggers" "an" "additional" "time" "."

/* "If a triggered ability of a Doctor you control triggers, that ability triggers an
   additional time": every trigger of those permanents' abilities happens twice. */
/* @sem Ability::[TriggerRule{abilities:AbilityOf($retrigger_holder), rule:TriggersAgain}] */
line_triggers_additional ::= "if" "a" "triggered" "ability" "of" retrigger_holder "triggers" "," retrigger_ref "triggers" "an" "additional" "time" "."
retrigger_holder ::= retrigger_holder_one | retrigger_holder_another
/* @sem $filter_phrase */
retrigger_holder_one ::= ("a" | "an") filter_phrase
/* @sem @and(ObjectFilter::Not(ObjectFilter::SameObject(Source)), $filter_phrase) */
retrigger_holder_another ::= "another" filter_phrase
/* @sem () */
retrigger_ref ::= "that" "ability" | "it"

/* @sem Change::[RemoveAllAbilities] */
change_lose_all_abilities ::= ("loses" | "lose") "all" "abilities"

/* A definite creature antecedent supports literal boosts here. Variable boosts
   retain their existing definition-scope rules rather than opening an unbound X. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($boosted_creature)), changes:[Pump{power:$signed_literal, toughness:$signed_literal_2}], duration:$duration, evaluation:Snapshot} */
qualified_creature_literal_pump ::= boosted_creature ("gets" | "get") signed_literal "/" signed_literal duration
/* @sem ObjectRef::@qualified_object(ObjectKind::Permanent, ObjectFilter::CardType(Creature)) */
boosted_creature ::= "the" "creature"
signed_literal ::= signed_literal_plus | signed_literal_minus
/* @sem $number_digits */
signed_literal_plus ::= "+" number_digits
/* @sem Expr::@negate($number_digits) */
signed_literal_minus ::= "-" number_digits

/* Adjacent statements preserve independent conditions and one explicit host. */

/* @sem Ability::[$static_conditional_first, $static_conditional] */
line_inline_conditional_statics ::= static_conditional_first static_conditional

/* @sem Ability::[Static{kind:Ordinary, affected:Objects(One($attached_ref)), changes:$static_changes}, Conditional{condition:ObjectMatches{object:$attached_ref, filter:$host_static_quality}, then:[Static{kind:Ordinary, affected:Objects(One($attached_ref)), changes:$conditional_followup_changes}]}, Conditional{condition:ObjectMatches{object:$attached_ref, filter:$host_static_quality_2}, then:[Static{kind:Ordinary, affected:Objects(One($attached_ref)), changes:$conditional_followup_changes_2}]}] */
line_host_two_conditions ::= attached_ref static_changes "." "as" "long" "as" host_static_quality "," "it" conditional_followup_changes "." "as" "long" "as" host_static_quality "," "it" conditional_followup_changes "."

/* @sem $quality */
host_static_quality ::= ("it's" | "it" "is") quality

/* @sem Ability::[Static{kind:Ordinary, affected:Objects(One($attached_ref)), changes:[...$base_subtypes, ...$attached_restriction_pair]}] */
line_host_base_restrictions ::= attached_ref "is" base_subtypes "." "it" attached_restriction_pair "."

/* The host's next sentence loses its abilities before it has the quoted one. */
/* @sem Ability::[Static{kind:Ordinary, affected:Objects(One($attached_ref)), changes:$static_changes}, Static{kind:Ordinary, affected:Objects(One($attached_ref)), changes:[RemoveAllAbilities, ...$closed_grants]}] */
line_host_lose_all_quoted_grant ::= attached_ref static_changes "." "it" "loses" "all" "abilities" "and" "has" closed_grants

/* These simultaneous restrictions share their host; printing may use either order. */
/* @sem Change::[...$change_lose_all_abilities, ...$rule_change] */
attached_restriction_pair ::= rule_change "and" change_lose_all_abilities
    | change_lose_all_abilities "and" rule_change

/* The unqualified legend rule exemption applies to every battlefield permanent. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:Any}), changes:[Rule(LegendRuleExempt)]} */
static_global_legend_rule ::= "the" '"' ("↓")? "legend" "rule" '"' "doesn't" "apply" "."

/* The explicit local X definition supplies every X in this one modifier. */
/* @sem Operation::@where(Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[GrantKeyword($keyword_value), Pump{power:AnnouncedX, toughness:$value}], duration:$duration, evaluation:Snapshot}, Expr::ObjectProperty{object:Affected, property:$stat, information:CurrentOrLastKnown}) */
continuous_keyword_pump_own_power ::= affected "gains" keyword_value "and" "gets" "+" "X" "/" "+" value duration "," "where" "X" "is" "its" stat

/* Every written condition qualifies its own simultaneous keyword grant. */
line_conditional_keyword_arms ::= conditional_keywords_2 | conditional_keywords_3 | conditional_keywords_4 | conditional_keywords_5

/* @sem Ability::[Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, $conditional_keyword_quality)}), changes:[GrantKeyword($keyword_value)] }, Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, $conditional_keyword_quality_2)}), changes:[GrantKeyword($keyword_value_2)] }] */
conditional_keywords_2 ::= "each" filter_phrase "has" keyword_value "if" conditional_keyword_quality (",")? "and" keyword_value "if" conditional_keyword_quality "."

/* @sem Ability::[Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, $conditional_keyword_quality)}), changes:[GrantKeyword($keyword_value)] }, Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, $conditional_keyword_quality_2)}), changes:[GrantKeyword($keyword_value_2)] }, Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, $conditional_keyword_quality_3)}), changes:[GrantKeyword($keyword_value_3)] }] */
conditional_keywords_3 ::= "each" filter_phrase "has" keyword_value "if" conditional_keyword_quality "," keyword_value "if" conditional_keyword_quality (",")? "and" keyword_value "if" conditional_keyword_quality "."

/* @sem Ability::[Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, $conditional_keyword_quality)}), changes:[GrantKeyword($keyword_value)] }, Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, $conditional_keyword_quality_2)}), changes:[GrantKeyword($keyword_value_2)] }, Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, $conditional_keyword_quality_3)}), changes:[GrantKeyword($keyword_value_3)] }, Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, $conditional_keyword_quality_4)}), changes:[GrantKeyword($keyword_value_4)] }] */
conditional_keywords_4 ::= "each" filter_phrase "has" keyword_value "if" conditional_keyword_quality "," keyword_value "if" conditional_keyword_quality "," keyword_value "if" conditional_keyword_quality (",")? "and" keyword_value "if" conditional_keyword_quality "."

/* @sem Ability::[Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, $conditional_keyword_quality)}), changes:[GrantKeyword($keyword_value)] }, Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, $conditional_keyword_quality_2)}), changes:[GrantKeyword($keyword_value_2)] }, Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, $conditional_keyword_quality_3)}), changes:[GrantKeyword($keyword_value_3)] }, Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, $conditional_keyword_quality_4)}), changes:[GrantKeyword($keyword_value_4)] }, Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, $conditional_keyword_quality_5)}), changes:[GrantKeyword($keyword_value_5)] }] */
conditional_keywords_5 ::= "each" filter_phrase "has" keyword_value "if" conditional_keyword_quality "," keyword_value "if" conditional_keyword_quality "," keyword_value "if" conditional_keyword_quality "," keyword_value "if" conditional_keyword_quality (",")? "and" keyword_value "if" conditional_keyword_quality "."

/* @sem $quality */
conditional_keyword_quality ::= ("it's" | "it" "is") quality

/* Player protection uses the player-rule constructor; the accompanying
   permanents receive the same source quality as an ordinary keyword. */
/* @sem Ability::[Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(GrantKeyword(Protection($protection_source_quality)))]}, Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}), changes:[GrantKeyword(Protection($protection_source_quality))]}] */
line_player_objects_protection ::= "you" "and" filter_plural "have" "protection" "from" protection_source_quality "."

/* Only a kind of creature can block. */
/* @sem Change::[Rule(Prohibit(BeBlocked(Not($filter_plural))))] */
change_unblockable_except_by ::= "can't" "be" "blocked" "except" "by" filter_plural

/* A set base power and toughness. */
/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}] */
change_has_base_power_toughness ::= ("has" | "have") "base" "power" "and" "toughness" value "/" value

/* Each affected permanent skips its controller's untap. */
/* @sem Change::[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})] */
change_skip_controllers_untap ::= "don't" "untap" "during" "their" "controllers'" "untap" "steps"

/* A prohibition on blocking a kind of creature. */
/* @sem Change::[Rule(Prohibit(Block($filter_plural)))] */
change_cant_block_kind ::= "can't" "block" filter_plural

/* Additional blocks each combat. */
/* @sem Change::[Rule(BlockCapacity(Additional($counter_amount)))] */
change_block_additional ::= "can" "block" counter_amount "additional" "creature" "each" "combat"

/* Goaded by the ability's controller. */
/* @sem Change::[Rule(GoadedBy(AbilityController))] */
change_is_goaded ::= "is" "goaded"

/* Skipping its controller's next untap. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})], duration:DuringControllersNextUntapStep, evaluation:LiveObjects} */
skip_controllers_next_untap ::= affected "doesn't" "untap" "during" "its" "controller's" "next" "untap" "step"
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($untap_plural_subject)), changes:[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})], duration:DuringControllersNextUntapStep, evaluation:LiveObjects} */
skip_controllers_next_untap_plural ::= untap_plural_subject "don't" "untap" "during" "their" "controllers'" "next" "untap" "steps"
/* Oracle also gives a set one shared "controller's next untap step"; it means the same. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($untap_plural_subject)), changes:[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})], duration:DuringControllersNextUntapStep, evaluation:LiveObjects} */
skip_controller_next_untap_shared ::= untap_plural_subject "don't" "untap" "during" "their" "controller's" "next" "untap" "step"
/* A plural verb takes a plural subject, never a distributive "each of". */
untap_plural_subject ::= objects_targets_plain | those_creatures | group_permanents | group_subject

/* Skipping your next untap. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Rule(UntapStep{players:One(AbilityController), behavior:Skip})], duration:DuringNextUntapStep(AbilityController), evaluation:LiveObjects} */
skip_your_next_untap ::= affected ("doesn't" | "don't") "untap" "during" "your" "next" "untap" "step"

/* A stated leading duration scopes both literal bonuses. Computed shared
   values retain their separate capture contract. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$change_literal_pump, duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($affected_2), changes:$change_literal_pump_2, duration:$duration, evaluation:Snapshot}}] */
clause_shared_duration_changes ::= duration "," affected change_literal_pump "and" affected change_literal_pump

/* @sem Change::[Pump{power:$signed_literal, toughness:$signed_literal_2}] */
change_literal_pump ::= ("gets" | "get") signed_literal "/" signed_literal

/* A leading duration over static changes. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$static_changes, duration:$duration, evaluation:Snapshot} */
duration_affected_static_changes ::= duration "," affected static_changes

/* A leading duration over changes. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$changes, duration:$duration, evaluation:Snapshot} */
duration_affected_changes ::= duration "," affected changes

/* Base power and toughness for a duration. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[SetBasePowerToughness{power:$value, toughness:$value_2}], duration:$duration, evaluation:Snapshot} */
base_power_toughness_for_duration ::= affected "has" "base" "power" "and" "toughness" value "/" value duration

/* Additional changes for a duration. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$static_changes, duration:$duration, evaluation:Snapshot} */
affected_also_changes ::= affected "also" static_changes duration

/* Becoming an artifact creature for a duration. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[AddCardType(Artifact), AddCardType(Creature)], duration:$duration, evaluation:Snapshot} */
becomes_artifact_creature ::= affected "becomes" "an" "artifact" "creature" duration

/* Attacking as though without defender. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Rule(AttackException{ignore:Defender, defenders:Any})], duration:$this_duration, evaluation:LiveObjects} */
attack_despite_defender ::= affected "can" "attack" this_duration "as" "though" "it" "didn't" "have" "defender"

/* Changes while the source remains tapped. */
/* @sem Operation::CreateContinuousEffect{source:$object_ref, affected:Objects($affected), changes:$static_changes, duration:WhileMatches{object:$object_ref, filter:Tapped}, evaluation:Snapshot} */
changes_while_tapped ::= affected static_changes "for" "as" "long" "as" object_ref "remains" "tapped"

/* Losing flying for a duration. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[LosesAbility(Term{family:CheckHasable, form:Flying})], duration:$duration, evaluation:Snapshot} */
loses_flying ::= affected "loses" "flying" duration

/* A requirement to attack. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Rule(RequireCombat{action:Attack(Any), amount:AtLeast(Constant(1))})], duration:$this_duration, evaluation:LiveObjects} */
attacks_if_able ::= affected "attacks" this_duration "if" "able"

/* Changes to a group of objects. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:$changes}) */
static_affected_changes ::= affected changes "."

/* Changes that apply while a trailing condition holds. */
/* @sem Ability::Conditional{condition:$condition, then:[Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes})]} */
static_changes_if ::= affected static_changes "if" condition "."

/* Changes while an opponent controls a kind of permanent. */
/* @sem Ability::Conditional{condition:ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Controls{player:Bound(0), filter:$filter_phrase, minimum:1}}, then:[Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes})]} */
static_changes_while_opponent_controls ::= affected static_changes "as" "long" "as" "an" "opponent" "controls" "a" filter_phrase "."

/* Not a creature while a condition holds. */
/* @sem Ability::Conditional{condition:$condition, then:[Static(_{kind:Ordinary, affected:Objects($affected), changes:[RemoveCardType(Creature)]})]} */
static_not_a_creature_while ::= "as" "long" "as" condition "," affected "isn't" "a" "creature" "."

/* Changes to creatures of the chosen type. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, Chosen(CreatureType)])}), changes:$static_changes}) */
static_chosen_type_changes ::= filter_plural "of" "the" "chosen" "type" static_changes "."

/* A pump and a granted trigger. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[Pump{power:$signed, toughness:$signed_2}, GrantAbility(@scope(Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$program}))]}) */
static_pump_and_grant_trigger ::= affected "gets" signed "/" signed "and" "has" '"' event_clause "," program "." '"'

/* A pump and a granted activated ability. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[Pump{power:$signed, toughness:$signed_2}, GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program}))]}) */
static_pump_and_grant_activated ::= affected "gets" signed "/" signed "and" "has" '"' cost ":" program "." '"'

/* No attacking, blocking or activated abilities. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[Rule(Prohibit(Attack(Any))), Rule(Prohibit(Block(Any))), Rule(Prohibit(Activate(Any)))]}) */
static_cant_attack_block_or_activate ::= affected "can't" "attack" "or" "block" "," "and" "its" "activated" "abilities" "can't" "be" "activated" "."

/* All able blockers of a kind must block. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[Rule(RequireCombat{action:BeBlocked($filter_plural), amount:Each})]}) */
static_must_be_blocked_by_all ::= "all" filter_plural "able" "to" "block" affected "do" "so" "."

/* Creatures with less power can't block. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, Property{property:Power, test:NumberTest::Compare{comparison:Less, value:$value}}])}), changes:[Rule(Prohibit(Block(SameObject($object_ref))))]}) */
static_low_power_cant_block ::= filter_plural "with" "power" "less" "than" value "can't" "block" object_ref "."

/* You may choose not to untap. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Optional})]}) */
static_may_not_untap ::= "you" "may" "choose" "not" "to" "untap" affected "during" "your" "untap" "step" "."

/* Untapping during each other player's untap step. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[Rule(UntapStep{players:OthersThan(AbilityController), behavior:Additional})]}) */
static_untap_each_other_untap ::= "untap" affected "during" "each" "other" "player's" "untap" "step" "."

/* Exerting as it attacks. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[Rule(MayExert(Program($exert_callback_program)))]}) */
static_may_exert ::= "you" "may" "exert" affected "as" "it" "attacks" "." "when" "you" "do" "," exert_callback_program "."

/* You control the affected objects. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[SetController(AbilityController)]}) */
static_you_control ::= "you" "control" affected "."

/* Looking at your library's top card any time. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[$top_private_visibility]}) */
static_look_at_top_card ::= "you" "may" "look" "at" top_private_visibility "any" "time" "."

/* Playing with your library's top card revealed. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, audience:Everyone})]}) */
static_top_card_revealed ::= "play" "with" "the" "top" "card" "of" "your" "library" "revealed" "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Players($hands_revealed_players), changes:[PlayerRule(Visibility{objects:Zone(_{scope:Players{zone:Hand, players:One(Affected)}, kind:Card, filter:Any}), audience:Everyone})]}) */
static_hands_revealed ::= hands_revealed_players "play" "with" "their" "hands" "revealed" "."
hands_revealed_players ::= hands_revealed_all | hands_revealed_opponents
/* @sem PlayerSet::All */
hands_revealed_all ::= "players"
/* @sem PlayerSet::OpponentsOf(PlayerRef::AbilityController) */
hands_revealed_opponents ::= "your" "opponents"
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:Zone(_{scope:Players{zone:Hand, players:One(Affected)}, kind:Card, filter:Any}), audience:Everyone})]}) */
static_hand_revealed ::= "play" "with" "your" "hand" "revealed" "."

/* A card's own graveyard permission works while that card is in the graveyard. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Source), from:Graveyard, action:CastSpell, filter:Any})]})} */
static_cast_self_from_graveyard ::= "you" "may" "cast" "this" "card" "from" "your" "graveyard" "."

/* Playing or casting from your library's top. "Play lands", "cast creature spells" and
   "play cards" are one permission each; "and" joins two of them. A condition governs
   the whole static. For a duration, looking at the top card any time adds its visibility
   first; a static joined that way stays seeded, since canonical form joins two separate
   same-player lines into the same static and the joined sentence would print for both. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:$top_play_permissions}) */
static_cast_from_top ::= top_play_permissions "."
/* Being the chosen creature type too characterizes the creature (CR 604.3). A land's
   chosen type is a land type, so only "this creature" says it here. */
/* @sem Ability::Static{kind:CharacteristicDefining{contributes_to_color_identity:true}, affected:Objects(One(Source)), changes:[ChosenType{kind:CreatureType, mode:Add}]} */
static_self_chosen_type_add ::= "this" "creature" "is" "the" "chosen" "type" "in" "addition" "to" "its" "other" "types" "."
/* @sem Ability::Static{kind:Ordinary, affected:Objects(One($self_ref)), changes:[ChosenColor{mode:Set}]} */
static_self_chosen_color ::= self_ref "is" "the" "chosen" "color" "."
/* Skipping untap only while a condition holds. */
/* @sem Ability::Conditional{condition:$condition, then:[Static{kind:Ordinary, affected:Objects(One($self_ref)), changes:[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})]}]} */
static_self_skip_untap_if ::= self_ref "doesn't" "untap" "during" "your" "untap" "step" "if" condition "."
/* Lands, played from the graveyard as from a hand. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:CardType(Land)}), from:Graveyard, action:PlayLand, filter:Any})]}) */
static_play_lands_from_graveyard ::= "you" "may" "play" "lands" "from" "your" "graveyard" "."
/* "Once during each of your turns, you may cast a creature spell from your graveyard":
   one spell each turn, cast only during your own turns. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:$card_filter}, terms:_{limit:EachTurn(1), during:One(AbilityController), cost:Normal}})]}) */
static_once_each_turn_graveyard_cast ::= "once" "during" "each" "of" "your" "turns" "," "you" "may" "cast" ("a" | "an") card_filter "spell" "from" "your" "graveyard" "."
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:@and($card_filter, $modifiers)}, terms:_{limit:EachTurn(1), during:One(AbilityController), cost:Normal}})]}) */
static_once_each_turn_graveyard_cast_with ::= "once" "during" "each" "of" "your" "turns" "," "you" "may" "cast" ("a" | "an") card_filter "spell" modifiers "from" "your" "graveyard" "."
/* @sem Ability::Conditional{condition:$condition, then:[Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:$top_play_permissions})]} */
static_cast_from_top_if ::= "as" "long" "as" condition "," top_play_permissions "."
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:$top_look_and_play, duration:$duration, evaluation:LiveObjects} */
effect_look_and_play_from_top ::= duration "," top_look_and_play

/* @sem Change::[PlayerRule(Visibility{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, audience:AffectedPlayer}), ...$top_play_permissions] */
top_look_and_play ::= "you" "may" "look" "at" "the" "top" "card" "of" "your" "library" "any" "time" ","? "and" top_play_permissions

/* @sem Change::[...$top_permissions] */
top_play_permissions ::= "you" "may" top_permissions "from" "the" "top" "of" "your" "library"
top_permissions ::= top_permission | top_permission_pair
/* @sem Change::[...$top_permission, ...$top_permission_2] */
top_permission_pair ::= top_permission "and" top_permission
top_permission ::= top_play_lands | top_play_kind_lands | top_cast_spells | top_play_cards
/* @sem Change::[PlayerRule(PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, from:Library, action:PlayLand, filter:Any})] */
top_play_lands ::= "play" "lands"
/* @sem Change::[PlayerRule(PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, from:Library, action:PlayLand, filter:$plural_kind})] */
top_play_kind_lands ::= "play" plural_kind "lands"
/* @sem Change::[PlayerRule(PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, from:Library, action:CastSpell, filter:$cast_spells_filter})] */
top_cast_spells ::= "cast" cast_spells_filter
/* @sem Change::[PlayerRule(PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, from:Library, action:Either, filter:Any})] */
top_play_cards ::= "play" "cards"

/* Plural spells of a kind: "spells", "creature spells", "noncreature spells", "Cleric,
   Rogue, and Wizard spells", "artifact spells and colorless spells", "spells with mana
   value 4 or greater", "creature spells of the chosen type". */
cast_spells_filter ::= cast_folded_zombie_spells | cast_adjective_list_spells | cast_any_spells | cast_kind_spells | cast_kind_pair_spells | cast_kind_list_spells | cast_two_kinds_spells | cast_modified_spells | cast_kind_modified_spells | cast_chosen_type_spells
plural_kind ::= filter_phrase | quality
/* @sem ObjectFilter::Any */
cast_any_spells ::= "spells"
/* @sem $plural_kind */
cast_kind_spells ::= plural_kind "spells"
/* @sem ObjectFilter::AnyOf([$spell_adjective, $spell_adjective_2]) */
cast_kind_pair_spells ::= spell_adjective "and" spell_adjective "spells"
/* @sem ObjectFilter::AnyOf([...$noun_commas, $noun]) */
cast_kind_list_spells ::= noun_commas union_and noun "spells"
/* @sem ObjectFilter::AnyOf([$plural_kind, $plural_kind_2]) */
cast_two_kinds_spells ::= plural_kind "spells" "and" plural_kind "spells"
/* @sem $modifiers */
cast_modified_spells ::= "spells" modifiers
/* @sem @and($filter_phrase, $modifiers) */
cast_kind_modified_spells ::= filter_phrase "spells" modifiers
/* @sem @and($filter_phrase, ObjectFilter::Chosen(CreatureType)) */
cast_chosen_type_spells ::= filter_phrase "spells" "of" "the" "chosen" "type"

/* Your spells of a kind cost less, more or extra life. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$cast_spells_filter, modifier:$spell_cost_change})]}) */
static_spells_cost_less ::= cast_spells_filter "you" "cast" "cost" spell_cost_change "to" "cast" "."
/* Spells of one kind cost less, more or extra life for every player. The
   reference writes pairs and modified groups ("with the chosen name") as an
   effect on the spells instead, so this takes only a single kind. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(SpellCost{spells:$cast_kind_spells, modifier:$spell_cost_change})]}) */
static_all_spells_cost ::= cast_kind_spells "cost" spell_cost_change "to" "cast" "."
/* The cast origin narrows which of the caster's spells the rule covers. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:@and($cast_spells_filter, $cast_origin_filter), modifier:$spell_cost_change})]}) */
static_spells_from_cost_less ::= cast_spells_filter "you" "cast" cast_origin_filter "cost" spell_cost_change "to" "cast" "."
cast_origin_filter ::= cast_origin_one | cast_origin_either
/* @sem ObjectFilter::Cast{from:$cast_origin} */
cast_origin_one ::= "from" cast_origin
/* @sem ObjectFilter::AnyOf([Cast{from:$cast_origin}, Cast{from:$cast_origin_2}]) */
cast_origin_either ::= "from" cast_origin "or" "from" cast_origin
cast_origin ::= cast_origin_graveyard | cast_origin_exile | cast_origin_all_graveyards
/* @sem ZoneScope::Players{zone:Graveyard, players:One(AbilityController)} */
cast_origin_graveyard ::= "your" "graveyard"
/* @sem ZoneScope::Shared(Exile) */
cast_origin_exile ::= "exile"

/* The drawn-card history and cost modifier are independent operands. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(Zone(_{scope:Shared(Stack), kind:Spell, filter:$drawn_cards_history})), changes:[SpellCost($spell_cost_change)]}) */
static_drawn_cards_spell_cost ::= "spells" "cast" "from" "among" "cards" drawn_cards_history "cost" spell_cost_change "to" "cast" "."
/* @sem ObjectFilter::History{event:Drawn($drawn_cards_player), window:ThisTurn} */
drawn_cards_history ::= drawn_cards_player "drew" "this" "turn"
drawn_cards_player ::= drawn_cards_you | drawn_cards_opponents
/* @sem PlayerSet::One(AbilityController) */
drawn_cards_you ::= "you"
/* @sem PlayerSet::OpponentsOf(AbilityController) */
drawn_cards_opponents ::= "your" "opponents"

/* A tax on the chosen name's spells some player casts is on those spells. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(Zone(_{scope:Shared(Stack), kind:Spell, filter:AllOf([Chosen(CardName), Cast{by:$players_singular}])})), changes:[SpellCost(Increase($cost))]}) */
static_named_spells_player_casts_cost ::= "spells" "with" "the" "chosen" "name" players_singular "casts" "cost" cost "more" "to" "cast" "."
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(Zone(_{scope:Shared(Stack), kind:Spell, filter:AllOf([Cast{by:OpponentsOf(AbilityController)}, Chosen(CardName)])})), changes:[SpellCost(Increase($cost))]}) */
static_opponent_named_spells_cost ::= "spells" "your" "opponents" "cast" "with" "the" "chosen" "name" "cost" cost "more" "to" "cast" "."
/* With no caster named, every player's spells with the chosen name cost more. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(Zone(_{scope:Shared(Stack), kind:Spell, filter:Chosen(CardName)})), changes:[SpellCost(Increase($cost))]}) */
static_named_spells_cost ::= "spells" "with" "the" "chosen" "name" "cost" cost "more" "to" "cast" "."

/* `{X}` less, where X is a value: the reduction is that value. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$cast_spells_filter, modifier:Reduce{reductions:[_{amount:$value}], spill_into_generic:true}})]}) */
static_spells_cost_less_where ::= cast_spells_filter "you" "cast" "cost" "{" "X" "}" "less" "to" "cast" "," "where" "X" "is" value "."

/* The printed generic reduction is a factor of the counted objects, as for this spell. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$cast_spells_filter, modifier:Reduce{reductions:[_{amount:@times($braced_number, $count_each)}], spill_into_generic:true}})]}) */
static_spells_cost_less_each ::= cast_spells_filter "you" "cast" "cost" braced_number "less" "to" "cast" "for" "each" count_each "."

/* Spells or abilities aimed at things cost more, less or extra life. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players($target_tax_casters), changes:[PlayerRule(SpellCost{spells:$target_tax_spells, modifier:$spell_cost_change})]}) */
static_target_tax ::= "spells" target_tax_casters "cast" "that" "target" target_tax_spells "cost" spell_cost_change "to" "cast" "."
/* @sem Ability::Static(_{kind:Ordinary, affected:Players($target_tax_casters), changes:[PlayerRule(ActivationCost{abilities:$target_tax_spells, change:Increase(Cost($cost))})]}) */
static_target_activation_tax ::= "abilities" target_tax_casters "activate" "that" "target" target_tax_spells "cost" cost "more" "to" "activate" "."
target_tax_casters ::= target_tax_opponents | target_tax_you
/* @sem PlayerSet::OpponentsOf(AbilityController) */
target_tax_opponents ::= "your" "opponents"
/* @sem PlayerSet::One(AbilityController) */
target_tax_you ::= "you"
target_tax_spells ::= target_tax_objects_only | target_tax_you_or | target_tax_you_only | target_tax_a_player | target_tax_enchanted_player
/* @sem ObjectFilter::TargetsAny(Players(One(AbilityController))) */
target_tax_you_only ::= "you"
/* @sem ObjectFilter::TargetsAny(Players(All)) */
target_tax_a_player ::= "a" "player"
/* @sem ObjectFilter::TargetsAny(Objects($target_tax_objects)) */
target_tax_objects_only ::= target_tax_objects
/* @sem ObjectFilter::AnyOf([TargetsAny(Players(One(AbilityController))), TargetsAny(Objects($target_tax_objects))]) */
target_tax_you_or ::= "you" "or" target_tax_objects
target_tax_objects ::= affected | target_tax_permanent
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$target_tax_filter} */
target_tax_permanent ::= target_tax_filter
target_tax_filter ::= target_tax_single | target_tax_plural
/* @sem ObjectFilter::$filter_phrase */
target_tax_single ::= ("a" | "an") filter_phrase
/* @sem ObjectFilter::$filter_plural */
target_tax_plural ::= "one" "or" "more" filter_plural
spell_cost_change ::= spell_cost_more | spell_cost_less | spell_cost_life | spell_cost_colored_less
/* @sem SpellCostModifier::Increase($cost) */
spell_cost_more ::= cost "more"
/* @sem SpellCostModifier::Reduce{reductions:[_{amount:$braced_amount}], spill_into_generic:true} */
spell_cost_less ::= braced_amount "less"
/* @sem SpellCostModifier::Increase{parts:[Life($value)]} */
spell_cost_life ::= "an" "additional" value "life"

/* Activated abilities of a group can't be activated, or only their mana abilities can. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[Rule(Prohibit(Activate(Any)))]}) */
static_activation_prohibited ::= "activated" "abilities" "of" affected "can't" "be" "activated" "."
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[Rule(Prohibit(Activate(Not(Mana))))]}) */
static_activation_prohibited_nonmana ::= "activated" "abilities" "of" affected "can't" "be" "activated" "unless" "they're" "mana" "abilities" "."

/* Abilities of sources with the chosen name, wherever those sources are. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(Prohibit(Activate(Of(Chosen(CardName)))))]}) */
static_named_activation_prohibited ::= "activated" "abilities" "of" "sources" "with" "the" "chosen" "name" "can't" "be" "activated" "."
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(Prohibit(Activate(All([Of(Chosen(CardName)), Not(Mana)]))))]}) */
static_named_activation_prohibited_nonmana ::= "activated" "abilities" "of" "sources" "with" "the" "chosen" "name" "can't" "be" "activated" "unless" "they're" "mana" "abilities" "."
/* Spells with the chosen name can't be cast by anyone. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(Zone{scope:Shared(Stack), kind:Spell, filter:Chosen(CardName)}), changes:[Rule(Prohibit(Cast))]}) */
static_named_spells_uncastable ::= "spells" "with" "the" "chosen" "name" "can't" "be" "cast" "."

/* Activated abilities of a group, or of one object, cost less or more to
   activate. A reduction that "can't reduce the mana in that cost to less than
   one mana" has a floor of one. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(ActivationCost{abilities:AbilityOf($activation_owner), change:Reduce($generic_reduction_symbols)})]}) */
static_activation_cost_less ::= "activated" "abilities" "of" activation_owner "cost" generic_reduction_symbols "less" "to" "activate" "."
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(ActivationCost{abilities:AbilityOf($activation_owner), change:Reduce($generic_reduction_symbols), floor:1})]}) */
static_activation_cost_less_floor ::= "activated" "abilities" "of" activation_owner "cost" generic_reduction_symbols "less" "to" "activate" "." "this" "effect" "can't" "reduce" "the" "mana" "in" "that" "cost" "to" "less" "than" "one" "mana" "."
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(ActivationCost{abilities:AbilityOf($activation_owner), change:Increase($kicker_operand_generic)})]}) */
static_activation_cost_more ::= "activated" "abilities" "of" activation_owner "cost" kicker_operand_generic "more" "to" "activate" "."
activation_owner ::= activation_owner_group | activation_owner_one | activation_owner_named
/* @sem ObjectFilter::Chosen(CardName) */
activation_owner_named ::= "sources" "with" "the" "chosen" "name"
/* @sem ObjectFilter::$filter_plural */
activation_owner_group ::= filter_plural
/* @sem ObjectFilter::SameObject($object_ref) */
activation_owner_one ::= object_ref

/* No maximum hand size. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(HandSize(Unlimited))]}) */
static_no_maximum_hand_size ::= "you" "have" "no" "maximum" "hand" "size" "."
/* "You may look at cards exiled with this creature": the linked face-down cards. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}), audience:AffectedPlayer})]}) */
static_look_exiled_with ::= "you" "may" "look" "at" "cards" "exiled" "with" object_ref "."
/* A resolving "you have no maximum hand size for the rest of the game" never ends. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(HandSize(Unlimited))], duration:Indefinite, evaluation:LiveObjects}}] */
clause_no_maximum_hand_size_rest ::= "you" "have" "no" "maximum" "hand" "size" "for" "the" "rest" "of" "the" "game"
/* A reduced maximum hand size lowers it by the printed amount. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players($hand_size_players), changes:[PlayerRule(HandSize(Adjust(@negate($number))))]}) */
static_maximum_hand_size_reduced ::= hand_size_players "maximum" "hand" "size" "is" "reduced" "by" number "."
hand_size_players ::= hand_size_yours | hand_size_opponents
/* @sem PlayerSet::One(AbilityController) */
hand_size_yours ::= "your"
/* @sem PlayerSet::OpponentsOf(AbilityController) */
hand_size_opponents ::= "each" "opponent's"

/* Additional land plays. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(AdditionalLandPlays(Exactly($counter_amount)))]}) */
static_additional_land_plays ::= "you" "may" "play" counter_amount "additional" "land" "on" "each" "of" "your" "turns" "."

/* Skipping your draw step. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(Skip(Draw))]}) */
static_skip_draw_step ::= "skip" "your" "draw" "step" "."

/* Static abilities and changes taken over from seeded rules, in their original Oracle words. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(HandSize(Unlimited))]}) */
static_players_no_maximum_hand_size ::= "players" "have" "no" "maximum" "hand" "size" "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(HandSize(Set($hand_size_value)))]}) */
static_maximum_hand_size_set ::= "your" "maximum" "hand" "size" "is" hand_size_value "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[Rule(LegendRuleExempt)]}) */
static_legend_rule_exempt ::= "the" '"' "↓" "legend" "rule" '"' "doesn't" "apply" "to" affected "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(Prohibit(LoseGame{reason:NonpositiveLife}))]}) */
static_no_zero_life_loss ::= "you" "don't" "lose" "the" "game" "for" "having" "0" "or" "less" "life" "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellTiming{spells:$filter_phrase, timing:Flash})]}) */
static_cast_as_though_flash ::= "you" "may" "cast" filter_phrase "spells" "as" "though" "they" "had" "flash" "."

/* Spell kinds a flash permission names: every spell, or spells of a card kind
   ("sorcery", "noncreature", "colorless") that a creature noun does not spell. */
flash_spells ::= flash_spells_any | flash_spells_kind
/* @sem ObjectFilter::Any */
flash_spells_any ::= "spells"
/* @sem $card_filter */
flash_spells_kind ::= card_filter "spells"
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellTiming{spells:$flash_spells, timing:Flash})]}) */
static_cast_kind_as_though_flash ::= "you" "may" "cast" flash_spells "as" "though" "they" "had" "flash" "."
/* "Players may cast enchantment spells as though they had flash": everyone's rule. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(SpellTiming{spells:$flash_spells, timing:Flash})]}) */
static_players_cast_as_though_flash ::= ("players" | "any" "player") "may" "cast" flash_spells "as" "though" "they" "had" "flash" "."
/* "You may cast spells this turn as though they had flash": a rule for you that lasts
   the stated time, applied to each spell as you cast it. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellTiming{spells:$flash_spells, timing:Flash})], duration:$this_duration, evaluation:LiveObjects}}] */
clause_cast_as_though_flash ::= "you" "may" "cast" flash_spells this_duration "as" "though" "they" "had" "flash"

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[Rule(CombatDamage(AsUnblocked{optional:true}))]}) */
static_assign_as_unblocked ::= "you" "may" "have" affected "assign" "its" "combat" "damage" "as" "though" "it" "weren't" "blocked" "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[Rule(CombatGroup{role:Attacker, participants:Any, comparison:Greater, amount:Constant(1)}), Rule(CombatGroup{role:Blocker, participants:Any, comparison:Greater, amount:Constant(1)})]}) */
static_cant_attack_or_block_alone ::= affected "can't" "attack" "or" "block" "alone" "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Players($players_singular), changes:[PlayerRule(LimitPerTurn{action:CastSpell{filter:Any}, amount:$value})]}) */
static_cast_limit_per_turn ::= players_singular "can't" "cast" "more" "than" value "spell" "each" "turn" "."

/* @sem Change::[Rule(Prohibit(Block($filter_plural))), Rule(Prohibit(BeBlocked($filter_plural)))] */
change_cant_block_or_be_blocked_by ::= "can't" "block" "or" "be" "blocked" "by" filter_plural

/* @sem Change::[Rule(CombatGroup{role:Attacker, participants:Any, comparison:Greater, amount:Constant(1)})] */
change_cant_attack_alone ::= "can't" "attack" "alone"

/* Each receiving graveyard card holds its granted mechanic and its cost. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$graveyard_grant_filter}), changes:[GrantAbility(@holder($graveyard_granted_ability))]} */
static_graveyard_card_grant ::= "each" graveyard_grant_filter "card" "in" "your" "graveyard" "has" graveyard_granted_ability "."
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$graveyard_grant_filter}), changes:[GrantAbility(@holder($graveyard_granted_ability))]} */
static_graveyard_cards_grant ::= graveyard_grant_filter "cards" "in" "your" "graveyard" "have" graveyard_granted_ability "."
graveyard_grant_filter ::= graveyard_grant_qualified_union | card_word | card_stacked_type | card_or | card_filter_and | graveyard_grant_qualified | graveyard_grant_subtype_pair | graveyard_grant_colors_creature
graveyard_granted_ability ::= graveyard_flashback | mechanic_cost_keyword | mechanic_valued_keyword | keyword_unearth | bare_retrace | graveyard_granted_scavenge | graveyard_granted_unearth | graveyard_granted_mayhem
/* @sem Ability::Mechanic{mechanic:Scavenge, cost:Cost{parts:[ManaCostOf(Source)]}} */
graveyard_granted_scavenge ::= "scavenge" "." "the" "scavenge" "cost" "is" "equal" "to" "its" "mana" "cost"
/* @sem Ability::Mechanic{mechanic:Unearth, cost:Cost{parts:[ManaCostOf(Source)]}} */
graveyard_granted_unearth ::= "unearth" "." "the" "unearth" "cost" "is" "equal" "to" "the" "card's" "mana" "cost"
/* @sem Ability::Mechanic{mechanic:Mayhem, cost:Cost{parts:[ManaCostOf(Source)]}} */
graveyard_granted_mayhem ::= "mayhem" "." "the" "mayhem" "cost" "is" "equal" "to" "its" "mana" "cost"

/* Sentence-initial Merfolk folds because an existing lowercase literal is in the vocabulary. */
/* @sem ObjectFilter::AnyOf(@unordered([$graveyard_grant_first_subtype, $subtype])) */
graveyard_grant_subtype_pair ::= graveyard_grant_first_subtype "and" subtype
graveyard_grant_first_subtype ::= subtype | graveyard_grant_merfolk_folded
/* @sem ObjectFilter::Subtype(Merfolk) */
graveyard_grant_merfolk_folded ::= "merfolk"
/* A shared creature head qualifies every color in this three-color list. */
/* @sem ObjectFilter::AllOf([CardType(Creature), AnyOf(@unordered([Color($mana_color_word), Color($mana_color_word_2), Color($mana_color_word_3)]))]) */
graveyard_grant_colors_creature ::= mana_color_word "," mana_color_word "," "and" "/" "or" mana_color_word "creature"
/* @sem Ability::Conditional{condition:PlayerIsActive(AbilityController), then:[$static_graveyard_cards_grant], otherwise:[]} */
static_graveyard_cards_grant_during_turn ::= "during" "your" "turn" "," static_graveyard_cards_grant

/* Keep shared color heads separate from a list of independently qualified cards. */
/* @sem @and($quality, $graveyard_grant_filter) */
graveyard_grant_qualified ::= quality graveyard_grant_filter

/* A graveyard casting permission uses the receiving card's own sneak ability. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}, from:Graveyard, action:CastSpell, filter:$card_filter}, terms:_{cost:Using(Sneak)}})]} */
static_cast_graveyard_using_sneak ::= "you" "may" "cast" card_filter "spells" "from" "your" "graveyard" "using" "their" "sneak" "abilities" "."

/* Keyword removal shares its native check term; each inflection owns one
   print shape, independently of the affected object's source identity. */
/* @sem Change::[LosesAbility($lost_keyword)] */
change_loses_keyword ::= "loses" lost_keyword
/* @sem Change::[LosesAbility($lost_keyword)] */
change_lose_keyword ::= "lose" lost_keyword
lost_keyword ::= lost_flying | lost_first_strike | lost_trample | lost_defender | lost_infect | lost_nonmana_abilities | lost_this_ability | lost_shadow | lost_landwalk
/* @sem Operand::Term{family:CheckHasable, form:Flying, operands:[]} */
lost_flying ::= "flying"
/* @sem Operand::Term{family:CheckHasable, form:FirstStrike, operands:[]} */
lost_first_strike ::= "first" "strike"
/* @sem Operand::Term{family:CheckHasable, form:Trample, operands:[]} */
lost_trample ::= "trample"
/* @sem Operand::Term{family:CheckHasable, form:Defender, operands:[]} */
lost_defender ::= "defender"

/* The creature types replace the previous list; no card type is added. */
change_creature_types ::= change_creature_types_a | change_creature_types_an
/* @sem $creature_type_replacement */
change_creature_types_a ::= "becomes" "a" creature_type_replacement
/* @sem $creature_type_replacement */
change_creature_types_an ::= "becomes" "an" creature_type_replacement
/* @sem Change::[CreatureTypes{mode:Set, types:Listed($becomes_types)}] */
creature_type_replacement ::= becomes_types

/* The color follows the preceding mana result, not a free color choice. */
/* @sem Change::[ColorOfMana{mode:Set, mana:@prior}] */
change_color_of_mana ::= "becomes" "that" "color"

/* @sem Ability::Mechanic{mechanic:BattleCry} */
bare_battle_cry ::= "battle" "cry"

/* A stat bonus and its replacement creature types form one characteristic list. */
/* @sem Change::[...$change_pump, ...$change_creature_types] */
changes_pump_and_creature_types ::= change_pump "and" change_creature_types

/* Blocking permissions share the verb while retaining each distinct rule and
   its own current operands. The shadow rationales are separate print shapes. */
/* @sem Change::[Rule($block_permission)] */
change_block_permission ::= "can" "block" block_permission
block_permission ::= block_capacity_permission | block_tapped_permission | block_shadow_permission
/* @sem RuleChange::BlockCapacity(Additional($block_extra_count)) */
block_capacity_permission ::= "an" "additional" block_extra_count
block_extra_count ::= block_extra_singular | block_extra_plural | block_extra_per_object
/* @sem Expr::Constant(1) */
block_extra_singular ::= "creature" "each" "combat"
/* @sem Expr::$count_plural */
block_extra_plural ::= count_plural "creatures" "each" "combat"
/* @sem Expr::CountObjects($affected) */
block_extra_per_object ::= "creature" "each" "combat" "for" affected
/* @sem RuleChange::BlockWhileTapped */
block_tapped_permission ::= "as" "though" "they" "were" "untapped"
/* @sem RuleChange::BlocksDespite{attackers:Any, evasion:$block_shadow_rationale} */
block_shadow_permission ::= "creatures" "with" "shadow" block_shadow_rationale
block_shadow_rationale ::= block_shadow_holder | block_shadow_attackers
/* @sem BlockEvasion::Shadow */
block_shadow_holder ::= "as" "though" "it" "had" "shadow"
/* @sem BlockEvasion::Shadow */
block_shadow_attackers ::= "as" "though" "they" "didn't" "have" "shadow"

/* Attachment eligibility is a filter, independent of the equipment holder. */
/* @sem Change::[Rule(AttachOnlyTo($attachment_eligible))] */
change_attachment_permission ::= "can" "be" "attached" "only" "to" attachment_eligible

/* Shared numeric mechanics retain their current amount on the granted ability. */
/* @sem Ability::Mechanic{mechanic:$granted_valued_name, amount:$value} */
granted_valued_mechanic ::= granted_valued_name value

granted_valued_name ::= mechanic_renown_name | mechanic_afterlife_name | mechanic_fabricate_name | granted_frenzy_name

/* @sem Mechanic::Frenzy */
granted_frenzy_name ::= "frenzy"

/* Prohibited actions compose with any ordinary affected population or other rule. */
/* @sem Change::[Rule(Prohibit($prohibited_object_action))] */
rule_prohibit_action ::= "can't" prohibited_object_action

prohibited_object_action ::= prohibit_phase_in | prohibit_transform | prohibit_be_beamed | prohibit_receive_named_them | prohibit_receive_any_it

/* @sem ObjectAction::PhaseIn */
prohibit_phase_in ::= "phase" "in"

/* @sem ObjectAction::Transform */
prohibit_transform ::= "transform"

/* @sem ObjectAction::BeBeamedUp */
prohibit_be_beamed ::= "be" "beamed" "up"

/* @sem ObjectAction::ReceiveCounters($counter_kind) */
prohibit_receive_named_them ::= "have" counter_kind "counters" "put" "on" "them"

/* @sem ObjectAction::ReceiveCounters(None) */
prohibit_receive_any_it ::= "have" "counters" "put" "on" "it"

/* A counter-first sentence still affects the objects from which counters leave. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[Rule(Prohibit(LoseCounters($counter_kind)))]} */
static_counter_removal_prohibition ::= counter_kind "counters" "can't" "be" "removed" "from" affected "."

/* @sem Ability::Mechanic{mechanic:Poisonous, amount:$value} */
granted_poisonous ::= "poisonous" value

/* @sem Ability::Mechanic{mechanic:Outlast, cost:Cost{parts:[Mana($mana_symbols)]}} */
granted_outlast ::= "outlast" mana_symbols

/* A combat prohibition composes with the independently stated third action. */
/* @sem Change::[Rule(Prohibit(Attack(Any))), Rule(Prohibit(Block(Any))), ...$combat_prohibited_extra] */
change_cant_attack_block_extra ::= "can't" "attack" "," "block" "," "or" combat_prohibited_extra

combat_prohibited_extra ::= combat_prohibited_crew | combat_prohibited_transform

/* @sem Change::[Rule(Prohibit(Crew))] */
combat_prohibited_crew ::= "crew" "Vehicles"

/* @sem Change::[Rule(Prohibit(Transform))] */
combat_prohibited_transform ::= "transform"

/* This count constrains the attacking group, not the affected population. */
/* @sem Change::[Rule(CombatGroup{role:Attacker, participants:Any, comparison:Equal, amount:Constant(1)})] */
change_only_attack_alone ::= "can" "only" "attack" "alone"

/* Possessive agreement is kept separate while sharing the ability restriction. */
/* @sem Change::[...$combat_prohibition, ...$activation_restriction] */
change_combat_activation_its ::= combat_prohibition "," "and" "its" activation_restriction

/* @sem Change::[...$combat_prohibition, ...$activation_restriction] */
change_combat_activation_their ::= combat_prohibition "," "and" "their" activation_restriction

combat_prohibition ::= change_cant_attack_block_extra | rule_cant_attack_or_block

activation_restriction ::= activation_restriction_tap | activation_restriction_nonmana

/* @sem Change::[Rule(Prohibit(Activate(Is(TapSymbolInCost))))] */
activation_restriction_tap ::= "activated" "abilities" "with" "{" "T" "}" "in" "their" "costs" "can't" "be" "activated"

/* @sem Change::[Rule(Prohibit(Activate(Not(Mana))))] */
activation_restriction_nonmana ::= "activated" "abilities" "can't" "be" "activated" "unless" "they're" "mana" "abilities"

/* Shared attack restrictions compose the action scope with its payment. */
/* @sem Change::[Rule(CombatGroup{role:Attacker, participants:$filter_plural, others_only:true, comparison:GreaterOrEqual, amount:$value})] */
attack_group_clause ::= "at" "least" value "other" filter_plural "attack"

/* @sem $attack_group_clause */
attack_group_requirement ::= "can't" "attack" "unless" attack_group_clause

/* @sem Change::[Rule(CombatCost{action:Attack(Any), payer:DeclaringPlayer, cost:$attack_you_cost_clause})] */
attack_you_pay_cost_rule ::= "can't" "attack" attack_you_cost_clause

/* @sem $cost */
attack_you_cost_clause ::= "unless" "you" cost

/* @sem Change::[Rule(CombatCost{action:Attack(Players(One(AbilityController))), payer:DeclaringPlayer, cost:$attack_player_payment})] */
attack_you_cost_rule ::= "can't" "attack" "you" "unless" "their" "controller" "pays" attack_player_payment

/* @sem Change::[Rule(CombatCost{action:Attack(PlayersAndPlaneswalkers(One(AbilityController))), payer:DeclaringPlayer, cost:$attack_planeswalker_payment})] */
attack_you_or_planeswalkers_cost_rule ::= "can't" "attack" "you" "or" "planeswalkers" "you" "control" "unless" "their" "controller" "pays" attack_planeswalker_payment

attack_player_payment ::= attack_player_payment_fixed | attack_player_payment_x

/* @sem $cost */
attack_player_payment_fixed ::= cost "for" "each" "creature" "they" "control" "that's" "attacking" "you"

/* @sem Cost::Cost{parts:[ManaWithX{mana:[X], x:$value}]} */
attack_player_payment_x ::= "{" "X" "}" "for" "each" "creature" "they" "control" "that's" "attacking" "you" "," "where" "X" "is" value

attack_planeswalker_payment ::= attack_planeswalker_payment_fixed | attack_planeswalker_payment_x

/* @sem $cost */
attack_planeswalker_payment_fixed ::= cost "for" "each" "of" "those" "creatures"

/* @sem Cost::Cost{parts:[ManaWithX{mana:[X], x:$value}]} */
attack_planeswalker_payment_x ::= "{" "X" "}" "for" "each" "of" "those" "creatures" "," "where" "X" "is" value

/* Player-facing continuous permissions and restrictions share the same
   controller and retain the operands of each rule for inverse printing. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule($controller_player_rule)]} */
controller_player_static ::= "you" controller_player_rule "."

controller_player_rule ::= player_retain_colored_mana | player_cast_limit_one | player_cast_limit_many | player_haste_activation | player_face_down_visibility | player_unlimited_lands

/* @sem PlayerRule::RetainMana{colors:[$mana_color_word]} */
player_retain_colored_mana ::= "don't" "lose" "unspent" mana_color_word "mana" "as" "steps" "and" "phases" "end"

/* @sem PlayerRule::LimitPerTurn{action:CastSpell{filter:Any}, amount:Expr::Constant(1)} */
player_cast_limit_one ::= "can't" "cast" "more" "than" "one" "spell" "each" "turn"

/* @sem PlayerRule::LimitPerTurn{action:CastSpell{filter:Any}, amount:$count_plural} */
player_cast_limit_many ::= "can't" "cast" "more" "than" count_plural "spells" "each" "turn"

/* @sem PlayerRule::ActivationGrant{abilities:AbilityOf($filter_plural), grant:AsThoughHaste} */
player_haste_activation ::= "may" "activate" "abilities" "of" filter_plural "as" "though" "those" "creatures" "had" "haste"

/* @sem PlayerRule::Visibility{objects:$affected, audience:AffectedPlayer} */
player_face_down_visibility ::= "may" "look" "at" "face-down" affected "any" "time"

/* @sem PlayerRule::AdditionalLandPlays(AnyNumber) */
player_unlimited_lands ::= "may" "play" "any" "number" "of" "lands" "on" "each" "of" "your" "turns"

/* Player rules share their affected player and keep each change composable. */
/* @sem Ability::Static{kind:Ordinary, affected:Players($player_rule_you), changes:$controller_rule_changes} */
static_controller_rules ::= player_rule_you controller_rule_changes "."

controller_rule_changes ::= controller_rule_one | controller_rule_join

/* @sem Change::[$controller_rule_change] */
controller_rule_one ::= controller_rule_change

/* @sem Change::[$controller_rule_change, ...$controller_rule_changes] */
controller_rule_join ::= controller_rule_change "and" controller_rule_changes

controller_rule_change ::= controller_untap_limit | controller_search_decision | controller_bottom_draw | controller_radiation_life | controller_hand_unlimited | controller_nonpositive_survival

/* @sem Change::PlayerRule(UntapLimit{permanents:$filter_phrase, amount:$value}) */
controller_untap_limit ::= "can't" "untap" "more" "than" value filter_phrase "during" "your" "untap" "step"

/* @sem Change::PlayerRule(Decides(SearchesOf(OpponentsOf(AbilityController)))) */
controller_search_decision ::= "control" "your" "opponents" "while" "they're" "searching" "their" "libraries"

/* @sem Change::PlayerRule(Unique(DrawsFromBottomOfLibrary)) */
controller_bottom_draw ::= "draw" "cards" "from" "the" "bottom" "of" "your" "library" "rather" "than" "the" "top"

/* @sem Change::PlayerRule(Unique(RadiationGainsLife)) */
controller_radiation_life ::= "gain" "life" "rather" "than" "lose" "life" "from" "radiation"

/* @sem Change::PlayerRule(HandSize(Unlimited)) */
controller_hand_unlimited ::= "have" "no" "maximum" "hand" "size"

/* @sem Change::PlayerRule(Prohibit(LoseGame{reason:NonpositiveLife})) */
controller_nonpositive_survival ::= "don't" "lose" "the" "game" "for" "having" "0" "or" "less" "life"

/* Combat payment wording composes the blocked population with the payment. */
block_payment_rule ::= block_payment_filtered | block_payment_any

/* @sem Change::[Rule(CombatCost{action:Block($filter_plural), payer:DeclaringPlayer, cost:$block_payment_filtered_suffix})] */
block_payment_filtered ::= "can't" "block" filter_plural block_payment_filtered_suffix

block_payment_filtered_suffix ::= block_payment_you | block_payment_life

/* @sem $alternative_mana */
block_payment_you ::= "unless" "you" alternative_mana

/* @sem Cost::Cost{parts:[Life($value)]} */
block_payment_life ::= "unless" "their" "controller" "pays" value "life" "for" "each" "blocking" "creature" "they" "control"

/* @sem Change::[Rule(CombatCost{action:Block(Any), payer:DeclaringPlayer, cost:$block_payment_mana})] */
block_payment_any ::= "can't" "block" block_payment_mana

/* @sem Cost::Cost{parts:[Mana($mana_symbols)]} */
block_payment_mana ::= "unless" "their" "controller" "pays" mana_symbols "for" "each" "of" "those" "creatures"

/* A blocker must be joined by other members of the stated population. */
/* @sem $block_group_requirement */
block_group_rule ::= "can't" "block" block_group_requirement

block_group_requirement ::= block_group_greater | block_group_minimum

/* @sem Change::[Rule(CombatGroup{role:Blocker, participants:$block_group_population, others_only:true, comparison:Greater, amount:Constant(0)})] */
block_group_greater ::= "unless" "a" block_group_population "also" "blocks"

/* @sem @and($filter_phrase, ObjectFilter::Property{property:Power, test:NumberTest::Compare{comparison:Greater, value:ObjectProperty{object:Affected, property:Power, information:CurrentOrLastKnown}}}) */
block_group_population ::= filter_phrase "with" "greater" "power"

/* @sem Change::[Rule(CombatGroup{role:Blocker, participants:$filter_plural, others_only:true, comparison:GreaterOrEqual, amount:$value})] */
block_group_minimum ::= "unless" "at" "least" value "other" filter_plural "block"

/* A comparison against the enchanted creature's current toughness. */
/* @sem Change::[Rule(Prohibit(Block($block_compared_population)))] */
block_comparison_rule ::= "can't" "block" block_compared_population

/* @sem @and($filter_plural, ObjectFilter::Property{property:Power, test:NumberTest::Compare{comparison:GreaterOrEqual, value:ObjectProperty{object:AttachedTo(Source), property:Toughness, information:CurrentOrLastKnown}}}) */
block_compared_population ::= filter_plural "with" "power" "equal" "to" "or" "greater" "than" "the" "enchanted" "creature's" "toughness"

/* A source population and the ability kinds are independent operands of the
   continuous change. The singular and combined kind phrases share this lens. */
/* @sem Change::[GainAbilitiesOf{objects:$ability_origin_set, kinds:$copied_ability_kinds}] */
change_gained_abilities ::= "has" "all" copied_ability_kinds "abilities" "of" ability_origin_set

copied_ability_kinds ::= copied_activated_kinds | copied_triggered_kinds | copied_activated_triggered_kinds

/* @sem Operand::List([Term{family:CheckHasable, form:ActivatedAbility}]) */
copied_activated_kinds ::= "activated"

/* @sem Operand::List([Term{family:CheckHasable, form:ActivatedAbility}, Term{family:CheckHasable, form:TriggeredAbility}]) */
copied_activated_triggered_kinds ::= "activated" "and" "triggered"

ability_origin_set ::= affected | ability_origin_battlefield | ability_origin_last_choice | ability_origin_controlled_different_name | ability_origin_exiled_linked | ability_origin_exiled_filtered | ability_origin_exiled_counters | ability_origin_owned_exiled_counters | linked_filtered_ability_origin | ability_origin_all_graveyards

/* @sem $affected */
ability_origin_battlefield ::= affected "on" "the" "battlefield"

/* @sem ObjectSet::One(Earlier{what:Selected}) */
ability_origin_last_choice ::= "the" "last" "chosen" "card"

/* @sem Change::[GainAbilitiesOf{objects:$ability_origin_set, kinds:List([Term{family:CheckHasable, form:And, operands:[$copied_activated_heading, $copied_nonmana_exclusion]}])}] */
change_gained_nonmana ::= "has" "all" copied_activated_heading "of" ability_origin_set copied_nonmana_exclusion

/* @sem Change::[GainAbilitiesOf{objects:$ability_origin_set, kinds:$copied_activated_heading, spend_as:$copied_abilities_any_color}] */
change_gained_spending ::= "has" "all" copied_activated_heading "of" ability_origin_set "." copied_abilities_any_color

/* @sem Change::[GainAbilitiesOf{objects:One($copied_chosen_permanent), kinds:Term{family:ActivatedAbilities, form:And, operands:[Term{family:ActivatedAbilities, form:AbilityOfPermanent, operands:[Object($copied_chosen_permanent)]}, Term{family:ActivatedAbilities, form:NonLoyaltyAbility}]}, spend_as:$copied_abilities_any_color}] */
change_gained_chosen_nonloyalty ::= "has" "all" "activated" "abilities" "of" copied_chosen_permanent "except" "for" "loyalty" "abilities" "." copied_abilities_any_color

/* @sem SpendAs::AnyColor */
copied_abilities_any_color ::= "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "activate" "those" "abilities"

/* @sem ObjectRef::Chosen */
copied_chosen_permanent ::= "the" "chosen" "permanent"

/* @sem Operand::Term{family:CheckHasable, form:ActivatedAbility} */
copied_activated_heading ::= "activated" "abilities"

/* @sem Operand::Term{family:CheckHasable, form:NonManaAbility} */
copied_nonmana_exclusion ::= "except" "mana" "abilities"

/* Defender conditions keep the attacked player's identity separate from the holder. */
/* @sem Condition::Controls{player:DefendingPlayerOf(Source), filter:$defender_untapped_filter, minimum:1} */
defender_controls_untapped ::= "defending" "player" "controls" "an" "untapped" defender_untapped_filter

defender_untapped_filter ::= defender_untapped_plain | defender_untapped_power | defender_untapped_power_less

/* @sem ObjectFilter::AllOf([Not(Tapped), $noun]) */
defender_untapped_plain ::= noun

/* @sem ObjectFilter::AllOf([Not(Tapped), $noun, Property{property:Power, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}]) */
defender_untapped_power ::= noun "with" "power" number "or" "greater"

/* @sem Ability::Static{kind:Ordinary, affected:Objects(One($self_explicit_ref)), changes:[Rule(CantAttackDefenderIf($defender_controls_untapped))]} */
static_defender_control_restriction ::= self_explicit_ref "can't" "attack" "if" defender_controls_untapped "."

/* The exert permission is independent of any linked effect. */
/* @sem Change::[Rule(MayExert(None))] */
exert_permission ::= "you" "may" "exert"

/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:$exert_permission} */
static_exert_without_followup ::= exert_permission affected "as" "it" "attacks" "."

/* Reusable activation restrictions share the current subject. */
/* @sem Change::[Rule(Prohibit(Activate(Any)))] */
activation_prohibition ::= "can't" "be" "activated"

/* @sem $activation_prohibition */
activation_ban ::= "activated" "abilities" activation_prohibition

/* @sem Change::[Rule(Prohibit(Activate(Not(Mana))))] */
activation_ban_nonmana ::= "activated" "abilities" "can't" "be" "activated" "unless" "they're" "mana" "abilities"

/* @sem ObjectSet::One(@enchanted_creature_operand(ObjectRef::AttachedTo(Source))) */
possessive_enchanted_holder ::= "enchanted" "creature's"

/* @sem Ability::Static{kind:Ordinary, affected:Objects($possessive_enchanted_holder), changes:$activation_ban} */
static_possessive_activation_ban ::= possessive_enchanted_holder activation_ban "."

/* @sem ObjectSet::One(Chosen) */
chosen_permanent_holder ::= "the" "chosen" "permanent"

/* @sem Ability::Static{kind:Ordinary, affected:Objects($chosen_permanent_holder), changes:$activation_prohibition} */
static_chosen_activation_ban ::= "activated" "abilities" "of" chosen_permanent_holder activation_prohibition "."

/* @sem Change::[Rule(Prohibit(Attack(Any))), Rule(Prohibit(Block(Any))), Rule(Prohibit(Crew))] */
combat_and_crew_ban ::= "can't" "attack" "," "block" "," "or" "crew" "Vehicles"

/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[...$combat_and_crew_ban, ...$activation_ban_nonmana]} */
static_combat_activation_restrictions ::= affected combat_and_crew_ban "." "its" activation_ban_nonmana "."

/* @sem Operand::Term{family:SpellEffect, form:Delve} */
spell_effect_delve ::= "delve"

/* @sem Operand::Term{family:SpellEffect, form:Ripple, operands:[Number($value)]} */
spell_effect_ripple ::= "ripple" value

/* @sem ObjectFilter::TargetsAny(Players(One(EnchantedBy(Source)))) */
target_tax_enchanted_player ::= "enchanted" "player"

/* Ownership is a restriction on the spells, independent of their caster. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:@and($cast_spells_filter, $cast_ownership_filter), modifier:$spell_cost_change})]}) */
static_cast_owned_cost ::= cast_spells_filter "you" "cast" cast_ownership_filter "cost" spell_cost_change "to" "cast" "."

/* @sem ObjectFilter::OwnedBy(OthersThan(AbilityController)) */
cast_ownership_filter ::= "but" "don't" "own"

/* Scaling is distinct from a generic amount multiplied by a live count. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$cast_spells_filter, modifier:Scaled{change:Reduce($generic_reduction_symbols), per:EachTarget}})]}) */
static_cast_target_scaled_cost ::= cast_spells_filter "you" "cast" "cost" generic_reduction_symbols "less" "to" "cast" "for" "each" "target" "."

/* A sequence of colored symbols retains each reduction separately. */
/* @sem SpellCostModifier::Reduce{reductions:$colored_reductions, spill_into_generic:true} */
spell_cost_colored_less ::= colored_reductions "less"

/* @sem Vec<ManaReduction>::[$colored_reduction, ...$colored_reductions] */
colored_reductions_more ::= colored_reduction colored_reductions

/* @sem Vec<ManaReduction>::[$colored_reduction] */
colored_reductions_one ::= colored_reduction

colored_reductions ::= colored_reductions_more | colored_reductions_one

colored_reduction ::= reduction_white | reduction_blue | reduction_black | reduction_red | reduction_green

/* @sem ManaReduction::_{color:White, amount:Constant(1)} */
reduction_white ::= "{" "W" "}"

/* @sem ManaReduction::_{color:Blue, amount:Constant(1)} */
reduction_blue ::= "{" "U" "}"

/* @sem ManaReduction::_{color:Black, amount:Constant(1)} */
reduction_black ::= "{" "B" "}"

/* @sem ManaReduction::_{color:Red, amount:Constant(1)} */
reduction_red ::= "{" "R" "}"

/* @sem ManaReduction::_{color:Green, amount:Constant(1)} */
reduction_green ::= "{" "G" "}"

/* Stack spell populations and granted abilities compose independently. The
   singular form keeps the casting player and per-turn ordinal on the filter. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($first_cast_spell_subject), changes:[GrantAbility(@holder($stack_granted_mechanic))]} */
static_first_cast_spell_grant ::= first_cast_spell_subject "has" stack_granted_mechanic "."

/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:NthCast{ordinal:Constant(1), spells:$first_cast_spell_filter, by:One(AbilityController), scope:Turn}} */
first_cast_spell_subject ::= "the" "first" first_cast_spell_filter "spell" "you" "cast" "each" "turn"

first_cast_spell_filter ::= filter_phrase | adjective_nontype | adjective_historic

stack_granted_mechanic ::= mechanic_convoke | bare_improvise | bare_demonstrate | bare_rebound | granted_sticker_kicker

/* @sem Ability::Mechanic{mechanic:StickerKicker, cost:$cost} */
granted_sticker_kicker ::= "sticker" "kicker" cost

/* @sem Ability::Static{kind:Ordinary, affected:Objects($plural_stack_spell_subject), changes:[GrantAbility(@holder($stack_granted_mechanic))]} */
static_plural_stack_spell_grant ::= plural_stack_spell_subject "have" stack_granted_mechanic "."

plural_stack_spell_subject ::= plural_cast_spell_subject | plural_any_spell_pair

/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:@and($filter_phrase, ObjectFilter::Cast{by:One(AbilityController)})} */
plural_cast_spell_subject ::= filter_phrase "spells" "you" "cast"

/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:AnyOf([$card_word, $card_word_2])} */
plural_any_spell_pair ::= card_word "and" card_word "spells"

/* A player restriction built from the linked-name predicate. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players($player_keyword_many), changes:[PlayerRule(Prohibit(CastSpell{filter:$linked_name_filter}))]}) */
static_linked_name_cast_ban ::= player_keyword_many "can't" "cast" "spells" linked_name_filter "."

/* Cast-time spell effects keep the origin separate from the spell filter. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellsHaveAbilities{spells:$adjective_nontype, from:Exile, abilities:List([$exile_spell_effect])})]}) */
static_exile_spell_effect ::= "each" adjective_nontype "spell" "you" "cast" "from" "exile" "has" exile_spell_effect "."

/* @sem Operand::Term{family:SpellEffect, form:Conspire} */
exile_spell_effect ::= "conspire"

/* A per-player cast permission uses the affected player for both turn and ownership. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$other_owned_linked_cards, from:Exile, action:CastSpell, filter:Any}, terms:_{limit:EachTurn(1), during:One(Affected), cost:Normal, spend_as:AnyType}})]}) */
static_each_turn_linked_cast ::= "during" "each" "player's" "turn" "," "that" "player" "may" "cast" "a" "spell" "from" "among" other_owned_linked_cards "," "and" "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "it" "."

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(OthersThan(Affected)), ExiledWith($object_ref)])}) */
other_owned_linked_cards ::= "the" "cards" "they" "don't" "own" "exiled" "with" object_ref

/* @sem Ability::Replacement{active:Battlefield, event:Enter{objects:$entry_objects}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Entry(CopyOf{objects:$affected, exceptions:[]})}}]}} */
replacement_entry_copy ::= entry_objects "enter" "as" "a" "copy" "of" affected "."

/* @sem ObjectFilter::AllOf([AnyOf([$filter_plural, $filter_plural_2]), ControlledBy(OpponentsOf(AbilityController))]) */
entry_opponents_union ::= filter_plural "and" filter_plural "your" "opponents" "control"

/* The doubled characteristics are evaluated on each affected object when the
   effect starts. The possessive and of-phrases supply independent subjects. */
double_characteristics ::= double_possessive_characteristics | double_of_characteristics

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($double_possessive_subject), changes:$double_stat_change, duration:$duration, evaluation:Snapshot} */
double_possessive_characteristics ::= "double" double_possessive_subject double_stat_change duration

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$double_stat_change, duration:$duration, evaluation:Snapshot} */
double_of_characteristics ::= "double" "the" double_stat_change "of" affected duration

double_possessive_subject ::= double_event_possessive | double_equipped_possessive

/* @sem ObjectSet::One(EventSubject) */
double_event_possessive ::= "its"

/* @sem ObjectSet::One(AttachedTo(Source)) */
double_equipped_possessive ::= "equipped" "creature's"

double_stat_change ::= double_power_and_toughness | double_power | double_toughness

/* @sem Change::[Pump{power:ObjectProperty{object:Affected, property:Power, information:CurrentOrLastKnown}, toughness:ObjectProperty{object:Affected, property:Toughness, information:CurrentOrLastKnown}}] */
double_power_and_toughness ::= "power" "and" "toughness"

/* @sem Change::[Pump{power:ObjectProperty{object:Affected, property:Power, information:CurrentOrLastKnown}, toughness:Constant(0)}] */
double_power ::= "power"

/* @sem Change::[Pump{power:Constant(0), toughness:ObjectProperty{object:Affected, property:Toughness, information:CurrentOrLastKnown}}] */
double_toughness ::= "toughness"

/* Quoted abilities and type additions compose as changes to the same holder.
   The punctuation belongs to the surrounding list, while each ability keeps
   its own scope and announcement. */
/* @sem Change::GrantAbility(@scope(Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$program})) */
shared_granted_trigger_comma ::= '"' event_clause "," program "," '"'

/* @sem Change::GrantAbility(@scope(Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$program})) */
shared_granted_trigger_open ::= '"' event_clause "," program '"'

/* @sem Change::GrantAbility(@scope(Ability::Triggered{event:$event_clause, intervening_if:$condition, limits:_{}, announcement:@announcement, body:$program})) */
shared_granted_trigger_if_closed ::= '"' event_clause "," "if" condition "," program "." '"'

/* @sem Change::GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program})) */
shared_granted_activation_closed ::= '"' cost ":" program "." '"'

/* @sem Change::GrantAbility(Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(HandSize(Unlimited))]})) */
shared_granted_unlimited_hand ::= '"' "you" "have" "no" "maximum" "hand" "size" '"'

/* @sem Change::CreatureTypes{mode:Add, types:Listed([@subtype_name($subtype)])} */
shared_added_singular_type ::= "is" "a" subtype "in" "addition" "to" "its" "other" "types"

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}, $shared_granted_trigger_comma, $shared_added_singular_type] */
shared_pump_trigger_type_changes ::= "gets" signed "/" signed "," "has" shared_granted_trigger_comma "and" shared_added_singular_type

/* @sem Change::[$shared_granted_trigger_open, $shared_added_singular_type] */
shared_trigger_type_changes ::= "has" shared_granted_trigger_open "and" shared_added_singular_type

/* @sem Change::[$shared_granted_trigger_open, $shared_granted_activation_closed] */
shared_trigger_activation_changes ::= "has" shared_granted_trigger_open "and" shared_granted_activation_closed

/* @sem Change::[$shared_granted_unlimited_hand, $shared_granted_trigger_if_closed] */
shared_hand_trigger_changes ::= "has" shared_granted_unlimited_hand "and" shared_granted_trigger_if_closed

/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:$shared_type_grant_changes} */
shared_type_grant_static ::= affected shared_type_grant_changes "."

shared_type_grant_changes ::= shared_pump_type_receipt_trigger_changes | shared_pump_trigger_type_changes | shared_trigger_type_changes

/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:$shared_quoted_pair_changes} */
shared_quoted_pair_static ::= affected shared_quoted_pair_changes

shared_quoted_pair_changes ::= shared_trigger_activation_changes | shared_hand_trigger_changes | shared_loyalty_pair_changes

/* Graveyard casting permissions compose with independent cost and condition phrases. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$affected, from:Graveyard, action:CastSpell, filter:Any}, terms:_{cost:Additional(Cost{parts:[$cast_additional_cost_part]})}})]})} */
static_graveyard_cast_additional ::= "you" "may" "cast" affected "from" "your" "graveyard" "by" cast_additional_cost_part "in" "addition" "to" "paying" "its" "other" "costs" "."

/* @sem Ability::Scoped{zones:[Graveyard], condition:$condition, ability:Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:$graveyard_cast_phrase, from:Graveyard, action:CastSpell, filter:Any})]})} */
static_graveyard_cast_condition ::= graveyard_cast_phrase "as" "long" "as" condition "."

/* @sem ObjectSet::$cast_permission_cards */
graveyard_cast_phrase ::= cast_permission_cards "from" "your" "graveyard"

/* @sem Ability::Scoped{zones:[Graveyard], ability:Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$graveyard_cast_phrase, from:Graveyard, action:CastSpell, filter:Any}, terms:_{cost:Using($graveyard_cast_mechanic)}})]})} */
static_graveyard_cast_using ::= graveyard_cast_phrase "using" "its" graveyard_cast_mechanic "ability" "."

/* @sem Mechanic::Blitz */
graveyard_cast_blitz ::= "blitz"

/* @sem Mechanic::Mutate */
graveyard_cast_mutate ::= "mutate"

graveyard_cast_mechanic ::= graveyard_cast_blitz | graveyard_cast_mutate

/* @sem Ability::Scoped{zones:[Graveyard], condition:$condition, ability:Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$graveyard_cast_phrase, from:Graveyard, action:CastSpell, filter:Any}, terms:_{cost:Alternate(Cost($cost)), into_exile:true}})]})} */
static_graveyard_cast_alternate ::= "as" "long" "as" condition "," graveyard_cast_phrase "by" "paying" cost "rather" "than" "paying" "its" "mana" "cost" "." "if" "you" "cast" "this" "card" "this" "way" "and" "it" "would" "be" "put" "into" "your" "graveyard" "," "exile" "it" "instead" "."

/* Keyword qualification and the named evasion rule keep separate operands. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, HasKeyword($keyword_value)])} */
affected_keyword_plural ::= filter_plural "with" keyword_value

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun, ControlledBy(One(AbilityController))])} */
affected_controlled_each ::= "each" noun "you" "control"

/* @sem Change::[Rule(BlockedAsThoughLacking(Term{family:CheckHasable, form:Landwalk, operands:[Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$walk_land_filter})]}))] */
change_landwalk_lacking ::= "can" "be" "blocked" "as" "though" "they" "didn't" "have" walk_land_filter

walk_land_filter ::= walk_land_plains | walk_land_island | walk_land_swamp | walk_land_mountain | walk_land_forest

/* @sem ObjectFilter::Subtype(Plains) */
walk_land_plains ::= "plainswalk"

/* @sem ObjectFilter::Subtype(Island) */
walk_land_island ::= "islandwalk"

/* @sem ObjectFilter::Subtype(Swamp) */
walk_land_swamp ::= "swampwalk"

/* @sem ObjectFilter::Subtype(Mountain) */
walk_land_mountain ::= "mountainwalk"

/* @sem ObjectFilter::Subtype(Forest) */
walk_land_forest ::= "forestwalk"

/* @sem Change::[Rule(BlockedByDefender{players:Matching{binding:0, condition:$defending_attack_requirement}})] */
change_defending_cannot_block ::= "can't" "be" "blocked" "as" "long" "as" defending_attack_requirement

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counter_placement_population}), changes:[Rule(Prohibit(ReceiveCounters(None)))]}) */
static_counter_placement_list ::= "counters" "can't" "be" "put" "on" counter_placement_population "."

/* @sem ObjectFilter::AnyOf([$filter_plural, $filter_plural_2, $filter_plural_3, $filter_plural_4]) */
counter_placement_population ::= filter_plural "," filter_plural "," filter_plural "," "or" filter_plural

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected_controlled_each), changes:$change_defending_cannot_block}) */
static_controlled_defender ::= affected_controlled_each change_defending_cannot_block "."

/* The entry frame is shared by different lists and choice quantities. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_ref)}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Entry($entry_three_counter_choice)}}]}}) */
replacement_entry_three_choices ::= self_ref "enters" "with" entry_three_counter_choice "."

entry_three_counter_choice ::= entry_one_of_three_counters | entry_distinct_three_counters

/* @sem BattlefieldState::CountersOfChoice{kinds:[$counter_kind, $counter_kind_2, $counter_kind_3], amount:$counter_amount} */
entry_one_of_three_counters ::= "your" "choice" "of" counter_amount counter_kind "," counter_kind "," "or" counter_kind "counter" "on" "it"

/* @sem BattlefieldState::CountersOfChoice{kinds:[$counter_kind, $counter_kind_2, $counter_kind_3], amount:$value, distinct:true} */
entry_distinct_three_counters ::= "your" "choice" "of" value "different" "counters" "on" "it" "from" "among" counter_kind "," counter_kind "," "and" counter_kind

/* The prospective controller supplies the conditional entry frame. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_ref)}, body:_{instructions:[If{condition:Not($entry_colors_spent_condition), then:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$counter_amount})}}]}, otherwise:_{}}]}}) */
replacement_entry_unless_spent ::= self_ref "enters" "with" counter_amount counter_kind "counters" "on" "it" "unless" entry_colors_spent_condition "."

/* @sem Condition::Compare{left:ManaSpent{object:@it, filter:_{}, aggregation:DistinctColors}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
entry_colors_spent_condition ::= value "or" "more" "colors" "of" "mana" "were" "spent" "to" "cast" "it"

/* Bind the history quantity inside the prospective controller's entry frame. */
/* @sem Ability::@entering_controller(Ability::@where($replacement_enters_counters_clause, $entry_history_value)) */
replacement_entry_history_where ::= replacement_enters_counters_clause "," "where" "X" "is" entry_history_value "."

entry_history_value ::= value_entry_life_gained | value_entry_opponents_life_lost

/* The same turn restriction composes with independent permission clauses. */
/* @sem Ability::Conditional{condition:PlayerIsActive(AbilityController), then:[Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:$turn_exile_permissions})]} */
turn_exile_permission ::= "during" "your" "turn" "," turn_exile_permissions "."

/* @sem Ability::Conditional{condition:AllOf([PlayerIsActive(AbilityController), $condition]), then:[Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:$turn_exile_permissions})]} */
turn_exile_permission_if ::= "during" "your" "turn" "," "if" condition "," turn_exile_permissions "."

turn_exile_permissions ::= exile_lands_and_spells | exile_cast_flash | exile_cast_additional | exile_play_linked | exile_play_counter | exile_play_life

/* @sem Change::[PlayerRule(PlayPermission{cards:$permission_linked_exile_cards, from:Exile, action:PlayLand, filter:Any}), PlayerRule(PlayPermission{cards:$permission_linked_exile_cards, from:Exile, action:CastSpell, filter:Any})] */
exile_lands_and_spells ::= "you" "may" "play" "lands" "and" "cast" "spells" "from" "among" permission_linked_exile_cards

/* @sem Change::[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$permission_linked_exile_cards, from:Exile, action:CastSpell, filter:Any}, terms:_{cost:Normal, spend_as:AnyType, flash:true}})] */
exile_cast_flash ::= "you" "may" "cast" permission_linked_exile_cards "and" "you" "may" "cast" "them" "as" "though" "they" "had" "flash" "." "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "those" "spells"

/* @sem Change::[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$permission_owned_linked_exile_cards, from:Exile, action:CastSpell, filter:$filter_phrase}, terms:_{cost:Additional(Cost{parts:[RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), amount:AmongThem(Exactly($value))}]}]})}})] */
exile_cast_additional ::= "you" "may" "cast" filter_phrase "spells" "from" "among" permission_owned_linked_exile_cards "by" "removing" value "counters" "from" "among" affected "in" "addition" "to" "paying" "their" "other" "costs"

/* @sem Change::[PlayerRule(PlayPermission{cards:$permission_linked_exile_cards, from:Exile, action:Either, filter:Any})] */
exile_play_linked ::= "you" "may" "play" permission_linked_exile_cards

/* @sem Change::[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$permission_others_counter_exile_cards, from:Exile, action:Either, filter:Any}, terms:_{cost:Normal, spend_as:AnyType}})] */
exile_play_counter ::= "you" "may" "play" permission_others_counter_exile_cards "," "and" "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "those" "spells"

/* @sem Change::[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$permission_linked_exile_cards, from:Exile, action:Either, filter:Any}, terms:_{cost:Alternate(Cost{parts:[LifeEqualToOwnManaValue]})}})] */
exile_play_life ::= "you" "may" "play" permission_linked_exile_cards "." "if" "you" "cast" "a" "spell" "this" "way" "," "pay" "life" "equal" "to" "its" "mana" "value" "rather" "than" "pay" "its" "mana" "cost"

/* Color and type changes retain independent operands for inverse printing. */
/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word]}] */
static_are_color ::= "are" mana_color_word

/* @sem Change::[Colors{mode:Set, colors:[]}] */
static_are_colorless ::= "are" "colorless"

/* @sem Change::[CreatureTypes{mode:Add, types:Listed($cross_creature_types)}] */
static_are_retained_creature_type ::= "are" cross_creature_types "in" "addition" "to" "their" "other" "creature" "types"

/* @sem Change::[Colors{mode:Set, colors:[]}, SetLandType(Vocabulary{family:LandType, form:@subtype_name($basic_land_type_consonant)}), SetCardTypes([Land])] */
static_is_colorless_basic_land ::= "is" "a" "colorless" basic_land_type_consonant "land"

/* @sem Change::[Colors{mode:Add, colors:[$mana_color_word]}, AddCardType($added_singular_card_type)] */
change_add_color_card_type ::= "becomes" "a" mana_color_word added_singular_card_type "in" "addition" "to" "its" "other" "colors" "and" "types"

added_singular_card_type ::= added_artifact | added_enchantment | added_creature | added_land

/* @sem CardType::Artifact */
added_artifact ::= "artifact"

/* @sem CardType::Enchantment */
added_enchantment ::= "enchantment"

/* @sem CardType::Creature */
added_creature ::= "creature"

/* @sem CardType::Land */
added_land ::= "land"

/* Prefer the leading duration for an additive color and type change. */
/* @prefer always */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$change_add_color_card_type, duration:$duration, evaluation:Snapshot} */
duration_added_color_type ::= duration "," affected change_add_color_card_type

/* Additive card types share the same typed vocabulary across subjects. */
/* @sem $cross_added_types */
static_add_plural_card_type ::= "are" cross_added_types

/* @sem Change::[AddCardType($singular_added_card_type)] */
static_add_singular_card_type ::= "is" "a" singular_added_card_type "in" "addition" "to" "its" "other" "types"

singular_added_card_type ::= singular_a_card_type

/* @sem $bk_artifact_native */
static_is_artifact_creature ::= "is" "an" bk_artifact_native

/* @sem Change::[SetBasePowerToughness{power:$affected_characteristic, toughness:$affected_characteristic}] */
static_base_stats_each_affected ::= "has" "base" "power" "and" "base" "toughness" "each" "equal" "to" affected_characteristic

/* @sem Expr::ObjectProperty{object:Affected, property:ManaValue, information:CurrentOrLastKnown} */
affected_characteristic ::= "its" "mana" "value"

/* A colored creature replacement and its base stats remain independent operands. */
/* @sem Change::[...$legendary_colored_creature, SetBasePowerToughness{power:$value, toughness:$value_2}] */
change_is_colored_creature_base ::= "is" "a" legendary_colored_creature "with" "base" "power" "and" "toughness" value "/" value

/* A subtype, stats, quoted activation, and literal name each contribute changes. */
/* @sem Change::[...$base_subtypes, ...$independent_static_activated, SetName($referenced_card_name)] */
change_is_named_base_grant ::= "is" base_subtypes "and" independent_static_activated "named" referenced_card_name

/* Grant first in the text; removal is applied before the new ability. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[RemoveAllAbilities, ...$independent_static_activated]} */
static_grant_then_lose_other ::= affected "have" independent_static_activated "and" "lose" "all" "other" "abilities" "."

/* The continuation belongs to this static effect and keeps its affected set. */
/* @sem Ability::Static{kind:ContinuesAfterLeaving(EndOfTurn), affected:Objects($affected), changes:[RemoveAllAbilities, ...$artifact_mana_value_animation]} */
static_continuing_animation ::= affected "loses" "all" "abilities" "and" "becomes" artifact_mana_value_animation "." "if" "this" "enchantment" "leaves" "the" "battlefield" "," "this" "effect" "continues" "until" "end" "of" "turn" "."

/* @sem Change::[AddCardType(Artifact), AddCardType(Creature), SetBasePowerToughness{power:ObjectProperty{object:Affected, property:ManaValue, information:CurrentOrLastKnown}, toughness:ObjectProperty{object:Affected, property:ManaValue, information:CurrentOrLastKnown}}] */
artifact_mana_value_animation ::= "an" "artifact" "creature" "with" "power" "and" "toughness" "each" "equal" "to" "its" "mana" "value"

/* Type additions retain other types; the two stats remain independent operands. */
/* @sem Change::[AddCardType(Creature), SetBasePowerToughness{power:$value, toughness:$value_2}] */
change_creature_base_in_addition ::= "is" "a" "creature" "with" "base" "power" "and" "toughness" value "/" value "in" "addition" "to" "its" "other" "types"

/* Each affected object's own mana value determines its base stats. */
/* @sem Change::[AddCardType(Artifact), AddCardType(Creature), SetBasePowerToughness{power:ObjectProperty{object:Affected, property:ManaValue, information:CurrentOrLastKnown}, toughness:ObjectProperty{object:Affected, property:ManaValue, information:CurrentOrLastKnown}}] */
change_artifact_creature_mana_value ::= "is" "an" "artifact" "creature" "with" "power" "and" "toughness" "each" "equal" "to" "its" "mana" "value"

/* A color and a creature type are both replacement characteristics. */
/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word]}, CreatureTypes{mode:Set, types:Listed($becomes_types)}] */
change_is_colored_creature_type ::= "is" "a" mana_color_word becomes_types

/* The count belongs to the attached host, not the Aura or Equipment. */
attached_color_subject ::= attached_color_enchanted | attached_color_equipped

/* @sem ObjectSet::One(AttachedTo(Source)) */
attached_color_enchanted ::= "enchanted" "creature"

/* @sem ObjectSet::One(AttachedTo(Source)) */
attached_color_equipped ::= "equipped" "creature"

/* @sem Expr::ObjectProperty{object:AttachedTo(Source), property:ColorCount, information:CurrentOrLastKnown} */
attached_color_count ::= "each" "of" "its" "colors"

/* @sem Change::[Pump{power:@times($signed, $attached_color_count), toughness:@times($signed_2, $attached_color_count)}] */
attached_color_pump ::= "gets" signed "/" signed "for" attached_color_count

/* @sem Ability::Static{kind:Ordinary, affected:Objects($attached_color_subject), changes:$attached_color_pump} */
static_attached_color_pump ::= attached_color_subject attached_color_pump "."

/* A grouped count rounds down before applying each written bonus. */
/* @sem Expr::Divide{numerator:CountObjects($affected), denominator:$value, rounding:Down} */
grouped_population_count ::= "for" "every" value affected

/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[Pump{power:Multiply([$value, $grouped_population_count]), toughness:Multiply([$value_2, $grouped_population_count])}]} */
static_grouped_count_pump ::= grouped_population_count "," affected "get" "+" value "/" "+" value "."

/* Chosen subtype wording composes with the affected population. */
/* @sem Change::[ChosenType{kind:$chosen_type_kind, mode:Add}] */
change_chosen_type_add_plural ::= "are" "the" chosen_type_kind "in" "addition" "to" "their" "other" "types"

/* @sem Change::[ChosenType{kind:$chosen_land_type_kind, mode:Set}] */
change_chosen_land_type_singular ::= "is" "the" chosen_land_type_kind

chosen_type_kind ::= chosen_creature_type_kind | chosen_land_type_kind

/* @sem ValueKind::CreatureType */
chosen_creature_type_kind ::= "chosen" "creature" "type"

/* @sem ValueKind::LandType */
chosen_land_type_kind ::= "chosen" "type"

/* The condition's explicitly named subject is also the antecedent of "it". */
/* @sem Ability::Conditional{condition:ObjectMatches{object:$attached_ref, filter:$anaphoric_kind_test}, then:[Static(_{kind:Ordinary, affected:Objects(One($attached_ref)), changes:$attached_anaphoric_changes})]} */
attached_anaphoric_conditional ::= "as" "long" "as" attached_ref anaphoric_kind_test "," "it's" attached_anaphoric_changes "."

/* @sem ObjectFilter::$filter_phrase */
anaphoric_kind_test_positive ::= "is" "a" filter_phrase

/* @sem ObjectFilter::Not($filter_phrase) */
anaphoric_kind_test_negative ::= "isn't" "a" filter_phrase

anaphoric_kind_test ::= anaphoric_kind_test_positive | anaphoric_kind_test_negative

attached_anaphoric_changes ::= anaphoric_creature_retained | anaphoric_attached_artifact_stats

/* @sem Change::[AddCardType(Creature)] */
anaphoric_creature_retained ::= "a" "creature" "in" "addition" "to" "its" "other" "types"

/* @sem Change::[AddCardType(Artifact), AddCardType(Creature), SetBasePowerToughness{power:ObjectProperty{object:AttachedTo(Source), property:ManaValue, information:CurrentOrLastKnown}, toughness:ObjectProperty{object:AttachedTo(Source), property:ManaValue, information:CurrentOrLastKnown}}] */
anaphoric_attached_artifact_stats ::= "an" "artifact" "creature" "with" "power" "and" "toughness" "each" "equal" "to" "its" "mana" "value"

/* @sem Ability::Conditional{condition:ObjectMatches{object:$self_explicit_ref, filter:Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$value})}, then:[Static(_{kind:Ordinary, affected:Objects(One($self_explicit_ref)), changes:$anaphoric_artifact_creature})]} */
self_counter_anaphoric_conditional ::= "as" "long" "as" self_explicit_ref "has" value "or" "more" counter_kind "counters" "on" "it" "," "it's" anaphoric_artifact_creature "."

/* @sem Change::[AddCardType(Artifact), AddCardType(Creature)] */
anaphoric_artifact_creature ::= "an" "artifact" "creature"

/* @sem Operand::Term{family:CheckHasable, form:Infect, operands:[]} */
lost_infect ::= "infect"

/* @sem Operand::Term{family:CheckHasable, form:NonManaAbility, operands:[]} */
lost_nonmana_abilities ::= "all" "abilities" "except" "mana" "abilities"

/* @sem Operand::Term{family:CheckHasable, form:ThisAbility, operands:[]} */
lost_this_ability ::= "this" "ability"

/* Additive artifact characteristics compose with other static changes. */
/* @sem Change::[AddArtifactType($added_artifact_subtype)] */
change_add_artifact_subtype ::= "are" added_artifact_subtype "in" "addition" "to" "their" "other" "types"

added_artifact_subtype ::= added_food_type | added_clue_type

/* @sem ArtifactType::Food */
added_food_type ::= "Foods"

/* @sem ArtifactType::Clue */
added_clue_type ::= "Clues"

/* @sem Change::[AddArtifactType(Food), AddCardType(Artifact)] */
change_add_food_artifact ::= "are" "Food" "artifacts" "in" "addition" "to" "their" "other" "types"

/* A granted activation creates its own ability scope and holder. */
/* @sem Change::GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program})) */
grant_quoted_activation ::= '"' cost ":" program "." '"'

/* A final quoted activation carries the sentence's own period. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[...$additive_artifact_change, $grant_quoted_activation]}) */
static_additive_quoted_activation ::= affected additive_artifact_change "and" "have" grant_quoted_activation

additive_artifact_change ::= change_add_artifact_subtype | change_add_food_artifact

/* The adjective supplies the shared change; agreement is spelled separately. */
/* @sem $legendary_change */
change_is_legendary ::= "is" legendary_change

/* @sem $legendary_change */
change_are_legendary ::= "are" legendary_change

/* @sem Change::[AddSupertype(Legendary)] */
legendary_change ::= "legendary"

/* Agreement and possessive spelling are separate; the land-type change is shared. */
/* @sem $every_basic_land_type_addition */
change_is_every_basic_land_type ::= "is" every_basic_land_type_addition "its" "other" "types"

/* @sem $every_basic_land_type_addition */
change_are_every_basic_land_type ::= "are" every_basic_land_type_addition "their" "other" "types"

/* @sem Change::[LandTypes{scope:Basic, mode:Add}] */
every_basic_land_type_addition ::= "every" "basic" "land" "type" "in" "addition" "to"

/* The ordinal applies to the qualifying spells cast by the ability controller. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($ordinal_cast_subject), changes:[GrantAbility(@holder($spell_mechanic))]} */
static_first_cast_mechanic ::= ordinal_cast_subject "has" spell_mechanic "."

ordinal_cast_subject ::= ordinal_cast_any | ordinal_cast_mana_source | ordinal_cast_origin_exception

/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:NthCast{ordinal:Constant(1), spells:Any, by:One(AbilityController), scope:Turn}} */
ordinal_cast_any ::= "the" "first" "spell" "you" "cast" "each" "turn"

/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:NthCast{ordinal:Constant(1), spells:ManaSpentFrom($filter_phrase), by:One(AbilityController), scope:Turn}} */
ordinal_cast_mana_source ::= "the" "first" "spell" "you" "cast" "each" "turn" "that" "mana" "from" ("a" | "an") filter_phrase "was" "spent" "to" "cast"

/* Quoted trigger bodies and creature-type additions are independent changes. */
/* @sem Program::Program{instructions:[If{condition:$condition, then:$program, otherwise:$program_2}]} */
shared_postcondition_otherwise_body ::= program "if" condition "." "otherwise" "," program

/* @sem Change::GrantAbility(@scope(Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$shared_postcondition_otherwise_body})) */
shared_granted_trigger_conditional_closed ::= '"' event_clause "," shared_postcondition_otherwise_body "." '"'

/* @sem Change::GrantAbility(@scope(Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$program})) */
shared_granted_trigger_closed ::= '"' event_clause "," program "." '"'

/* @sem Change::CreatureTypes{mode:Add, types:Listed([@subtype_name($subtype)])} */
shared_added_singular_creature_type ::= "is" "a" subtype "in" "addition" "to" "its" "other" "creature" "types"

/* @sem Change::[$shared_added_singular_creature_type, $shared_granted_trigger_closed] */
shared_creature_type_and_trigger ::= shared_added_singular_creature_type "and" "has" shared_granted_trigger_closed

/* @sem Change::[$shared_granted_trigger_conditional_closed] */
shared_plural_conditional_grant ::= "have" shared_granted_trigger_conditional_closed

/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:$shared_closed_grant_changes} */
shared_closed_grant_static ::= affected shared_closed_grant_changes

shared_closed_grant_changes ::= shared_type_and_pair_trigger | shared_creature_type_and_trigger | shared_plural_conditional_grant

/* Quoted loyalty activations share their holder but retain independent scopes,
   costs and programs. Only the final quote carries the closing period. */
/* @sem Change::GrantAbility(@holder(Ability::Activated{origin:Ordinary, cost:Cost{parts:[Loyalty($loyalty)]}, limits:ActivationLimits{sorcery:true}, announcement:@announcement, body:$program})) */
shared_loyalty_open ::= '"' "[" loyalty "]" ":" program '"'

/* @sem Change::GrantAbility(@holder($activated_loyalty)) */
shared_loyalty_closed ::= '"' activated_loyalty '"'

/* @sem Change::[$shared_loyalty_open, $shared_loyalty_closed] */
shared_loyalty_pair_changes ::= "have" shared_loyalty_open "and" shared_loyalty_closed

/* Singular and plural clauses share the chosen-color change operand. */
/* @sem $global_chosen_color_set */
static_is_chosen_color ::= "is" global_chosen_color_set

/* @sem $global_chosen_color_set */
static_are_chosen_color ::= "are" global_chosen_color_set

/* The controller and the affected objects are independent operands. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[SetController($static_controller_phrase)]}) */
static_controller_assignment ::= static_controller_phrase affected "."

static_controller_phrase ::= static_controller_you | static_controller_monarch

/* @sem PlayerRef::AbilityController */
static_controller_you ::= "you" "control"

/* @sem PlayerRef::Holder(Monarch) */
static_controller_monarch ::= "the" "monarch" "controls"

/* The turn restriction belongs to the ability controller; the first-spell
   ordinal, threshold and granted spell effect remain independent operands. */
/* @sem Ability::Conditional{condition:PlayerIsActive(AbilityController), then:[Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellsHaveAbilities{spells:$first_spell_threshold, nth_each_turn:Constant(1), abilities:List([$first_spell_effect])})]})]} */
first_spell_turn_grant ::= "the" "first" "spell" "you" "cast" "during" "each" "of" "your" "turns" first_spell_threshold "has" first_spell_effect "."

/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
first_spell_threshold ::= "with" "mana" "value" value "or" "greater"

/* @sem Operand::Term{family:SpellEffect, form:Cascade} */
first_spell_effect ::= "cascade"

/* The alternative amount and the keyword cost being replaced are separate
   operands. The turn condition applies to the player receiving the rule. */
/* @sem Ability::Conditional{condition:PlayerIsActive(AbilityController), then:[Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(KeywordCost{keyword:$first_activation_keyword, cards:Any, change:Alternate($first_activation_payment), first_each_turn:true})]})]} */
first_activation_alternative ::= "you" "may" "pay" first_activation_payment "rather" "than" "pay" "the" first_activation_keyword "you" "activate" "during" "each" "of" "your" "turns" "."

/* @sem CostedKeyword::Equip */
first_activation_keyword ::= "equip" "cost" "of" "the" "first" "equip" "ability"

/* @sem Operand::Term{family:ManaSymbol, form:ManaCostGeneric, operands:[Integer($number)]} */
first_activation_payment ::= "{" NUMBER "}"

/* A spell's cost can repeat a cost part for a quantity tied to that spell.
   The two subject shapes keep singular and plural agreement independent. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(Zone(_{scope:Shared(Stack), kind:Spell, filter:$filter_phrase})), changes:[SpellCost($repeated_spell_cost_change)]}) */
static_each_spell_repeated_cost ::= "each" filter_phrase "spell" "costs" repeated_spell_cost_change "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(Zone(_{scope:Shared(Stack), kind:Spell, filter:Any})), changes:[SpellCost($repeated_spell_cost_change)]}) */
static_spells_repeated_cost ::= "spells" "cost" repeated_spell_cost_change "."

repeated_spell_cost_change ::= repeated_spell_mana_cost | repeated_spell_sacrifice_cost

/* @sem SpellCostModifier::Increase{parts:[Repeated{part:Mana($mana_symbols), times:$spell_controller_permanent_count}]} */
repeated_spell_mana_cost ::= mana_symbols "more" "to" "cast" "for" "each" spell_controller_permanent_count

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(ControllerOf(Candidate)))])}) */
spell_controller_permanent_count ::= filter_phrase "its" "controller" "controls"

/* @sem SpellCostModifier::Increase{parts:[Repeated{part:$cost_sacrifice, times:$spell_mana_symbol_count}]} */
repeated_spell_sacrifice_cost ::= "an" "additional" '"' cost_sacrifice '"' "to" "cast" "for" "each" spell_mana_symbol_count

/* @sem Expr::CountManaSymbols{objects:One(Affected), colors:[$devotion_color]} */
spell_mana_symbol_count ::= devotion_color "mana" "symbol" "in" "their" "mana" "costs"

/* A trailing defending-player condition composes with ordinary static changes. */
/* @sem Ability::Conditional{condition:$condition_defending_control, then:[Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes})]} */
static_defending_control_conditional ::= affected static_changes "as" "long" "as" condition_defending_control "."

/* The turn window and the action's operands are independently composed. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpecialAction{body:Program{instructions:[Effect{result:@next, operation:$once_turn_play_operation}]}, limit:EachTurn(1)})]}) */
static_once_each_turn_play ::= "once" "each" "turn" "," "you" "may" once_turn_play_operation "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpecialAction{body:Program{instructions:[Effect{result:@next, operation:$once_turn_play_operation}]}, limit:EachTurn(1), during:One(AbilityController)})]}) */
static_once_during_your_turn_play ::= "once" "during" "each" "of" "your" "turns" "," "you" "may" once_turn_play_operation "."

/* The affected hand belongs to the grantor; cycling's Source is the receiving card. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($each_hand_card), changes:[GrantAbility($hand_card_granted_ability)]} */
static_each_hand_card_grant ::= each_hand_card "has" hand_card_granted_ability "."

/* @sem ObjectSet::Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter} */
each_hand_card ::= "each" card_filter "card" "in" "your" "hand"

hand_card_granted_ability ::= keyword_cycling

/* Spells cast by the emblem controller are affected on the stack. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($emblem_cast_spell_subject), changes:[GrantAbility(@holder($bare_storm))]} */
emblem_cast_spell_grant ::= emblem_cast_spell_subject "have" bare_storm "."

/* @sem Ability::Static{kind:Ordinary, affected:Objects($emblem_cast_spell_subject), changes:[SpellCost($spell_cost_less)]} */
emblem_cast_spell_cost ::= emblem_cast_spell_subject "cost" spell_cost_less "to" "cast" "."

/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:@and($cast_spells_filter, ObjectFilter::Cast{by:One(AbilityController)})} */
emblem_cast_spell_subject ::= cast_spells_filter "you" "cast"

/* A top-card casting permission with a separately composed additional cost. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, from:Library, action:CastSpell, filter:$cast_spells_filter}, terms:_{cost:Additional(Cost{parts:[$cast_additional_cost_part]})}})]}) */
static_top_cast_additional ::= "you" "may" "cast" cast_spells_filter "from" "the" "top" "of" "your" "library" "by" cast_additional_cost_part "in" "addition" "to" "paying" "their" "other" "costs" "."

/* The counted attachments and the static change share the same scalar host. */
/* @sem Ability::Conditional{condition:Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$subtype}, filter:AttachedTo(SameObject($attachment_count_subject))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, then:[Static(_{kind:Ordinary, affected:Objects(One($attachment_count_subject)), changes:$attachment_count_changes})]} */
static_attachment_count ::= attachment_count_subject attachment_count_changes "as" "long" "as" number "or" "more" subtype "are" "attached" "to" "it" "."

attachment_count_subject ::= self_explicit_ref | equipped_ref

attachment_count_changes ::= attachment_count_has | attachment_count_gets

/* @sem $grants */
attachment_count_has ::= "has" grants

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}] */
attachment_count_gets ::= "gets" signed "/" signed

/* The life-gain event and its amount definition form one contract. */
/* @sem Ability::Triggered{event:$event_gain_life, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($affected), changes:[Pump{power:EventAmount, toughness:EventAmount}], duration:$duration, evaluation:Snapshot}}]}} */
triggered_life_amount_pump ::= "whenever" event_gain_life "," affected "gets" "+" "X" "/" "+" "X" duration "," "where" "X" "is" "the" "amount" "of" "life" "you" "gained" "."

exert_callback_program ::= program | exert_callback_pump_rule

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($affected), changes:$shared_rule_characteristics, duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($affected), changes:$rule_changes, duration:$this_duration, evaluation:LiveObjects}}]} */
exert_callback_pump_rule ::= affected shared_rule_characteristics duration "and" rule_changes this_duration

/* A condition can gate a complete static permission or player prohibition. */
/* @sem Ability::Conditional{condition:$condition, then:[$conditional_static_body]} */
conditional_static_first ::= "if" condition "," conditional_static_body

conditional_static_body ::= static_may_exert | static_player_prohibition

/* A type addition and a scoped trigger share the same affected holder. */
/* @sem Change::[Pump{power:$signed, toughness:$signed_2}, $shared_added_singular_type, $shared_receipt_trigger_closed] */
shared_pump_type_receipt_trigger_changes ::= "gets" signed "/" signed "," shared_added_singular_type "," "and" "has" shared_receipt_trigger_closed

/* @sem Change::GrantAbility(@scope(Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$draw_discard_property_program})) */
shared_receipt_trigger_closed ::= '"' event_clause "," draw_discard_property_program "." '"'

/* Quoted final sentence supplies the closing punctuation of this static ability. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:$shared_pump_type_receipt_trigger_changes} */
shared_type_receipt_grant_static ::= affected shared_pump_type_receipt_trigger_changes

/* The subject and the two independently chosen keyword operands compose here. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Ability, terms:_{count:Exactly(Constant(1)), options:[Ability(Keyword($keyword_value)), Ability(Keyword($keyword_value_2))]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($object_set), changes:[ChosenAbility], duration:$duration, evaluation:Snapshot}}] */
instructions_gains_keyword_choice ::= object_set "gains" "your" "choice" "of" keyword_value "or" keyword_value duration

/* Cast-history subjects and player rules compose without changing the player
   bound by the history predicate or the player affected by the rule. */
static_cast_history_player_rule ::= static_cast_history_spell_limit | static_attack_history_spell_limit

/* @sem Ability::Static(_{kind:Ordinary, affected:Players($history_first_active_player), changes:[$history_free_spell]}) */
static_first_spell_player_rule ::= history_first_active_player history_free_spell "."

history_rule_players ::= history_each_player | history_selected_players

/* @sem PlayerSet::Matching{binding:0, condition:$bound_cast_history} */
history_each_player ::= "each" "player" "who" "has" bound_cast_history

/* @sem PlayerSet::Intersection([$players_singular, Matching{binding:0, condition:$bound_cast_history}]) */
history_selected_players ::= players_singular "who" bound_cast_history

/* @sem PlayerSet::Intersection([One(Active), Matching{binding:0, condition:Not(Compare{left:EventHistory{event:Spell{event:Cast, players:One(Bound(0)), spells:Any}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})}]) */
history_first_active_player ::= "the" "first" "spell" "each" "player" "casts" "during" "each" "of" "their" "turns"

bound_cast_history ::= bound_cast_any | bound_cast_filtered

/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(Bound(0)), spells:Any}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_a}} */
bound_cast_any ::= "cast" counter_a "spell" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(Bound(0)), spells:$spell_adjectives}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_a}} */
bound_cast_filtered ::= "cast" counter_a spell_adjectives "spell" "this" "turn"

history_player_rule ::= history_prohibit_attack | history_prohibit_cast

/* @sem Change::PlayerRule(Prohibit(AttackWith(Any))) */
history_prohibit_attack ::= "can't" "attack" "with" "creatures"

/* @sem Change::PlayerRule(Prohibit(CastSpell{filter:$cast_spells_filter})) */
history_prohibit_cast ::= "can't" "cast" "additional" cast_spells_filter

/* @sem Change::PlayerRule(SpellCost{spells:Any, modifier:Alternate{cost:Free}}) */
history_free_spell ::= "may" "be" "cast" "without" "paying" "its" "mana" "cost"

/* A cost change scaled by the affected player's cast history. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(SpellCost{spells:$scaled_spell_subject, modifier:$scaled_cast_modifier})]}) */
static_scaled_spell_cost ::= scaled_spell_subject "a" "player" "casts" "costs" scaled_cast_modifier "."

/* @sem ObjectFilter::Any */
scaled_spell_subject ::= "each" "spell"

/* @sem SpellCostModifier::Scaled{change:Increase(Cost($cost)), per:Times(EventHistory{event:Spell{event:Cast, players:One(Affected), spells:Any}, window:ThisTurn, measure:Occurrences})} */
scaled_cast_modifier ::= cost "more" "to" "cast" "for" "each" "other" "spell" "that" "player" "has" "cast" "this" "turn"

/* Independently counted populations contribute to both pump operands. */
/* @sem Change::[Pump{power:@times($signed, Expr::Add([$count_each, $count_each_2])), toughness:@times($signed_2, Expr::Add([$count_each, $count_each_2]))}] */
change_pump_for_each_sum ::= "gets" signed "/" signed "for" "each" count_each "and" "each" count_each

/* Conditional self descriptions reuse the same static change phrases. */
/* @sem $base_subtypes */
static_creature_base ::= "is" base_subtypes

/* @sem Change::[CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Creature)] */
retained_creature_description ::= "a" becomes_types "creature" "in" "addition" "to" "its" "other" "types"

/* @sem $retained_creature_description */
static_retained_creature ::= "is" retained_creature_description

/* @sem Change::[...$base_subtypes, ...$rule_cant_be_blocked] */
self_base_unblockable ::= base_subtypes "and" rule_cant_be_blocked

/* @sem Ability::Conditional{condition:$condition, then:[Static{kind:Ordinary, affected:Objects(One(Source)), changes:$self_base_unblockable}], otherwise:[]} */
conditional_its_base_rules ::= "as" "long" "as" condition "," "it's" self_base_unblockable "."

/* @sem Ability::Conditional{condition:$condition, then:[Static{kind:Ordinary, affected:Objects(One(Source)), changes:$retained_creature_description}], otherwise:[]} */
conditional_its_retained_creature ::= "as" "long" "as" condition "," "it's" retained_creature_description "."

/* @sem Change::[...$base_subtypes, ...$closed_grants] */
static_base_closed_grants ::= "is" base_subtypes "," closed_grants

/* @sem Change::[...$base_subtypes, ...$closed_grants_oxford] */
static_base_closed_grants_oxford ::= "is" base_subtypes "," closed_grants_oxford

/* @sem Change::[$grant_keyword, ...$closed_grants] */
closed_grants_oxford ::= grant_keyword "," "and" closed_grants

/* Attack requirements keep the attacker population separate from the dragged
   population. The opponent form ties the latter to the attacker's controller. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(OpponentsOf(AbilityController)))}), changes:[$drag_opponent_requirement]}) */
static_opponent_attack_drag ::= "if" "a" filter_phrase "an" "opponent" "controls" "attacks" "," drag_opponent_requirement "."

/* @sem Change::Rule(AttackDrags($filter_plural)) */
drag_opponent_requirement ::= "all" filter_plural "that" "opponent" "controls" "attack" "if" "able"

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counter_attack_filter}), changes:[$drag_counter_requirement]}) */
static_counter_attack_drag ::= "if" "a" counter_attack_filter "attacks" "," drag_counter_requirement "."

/* @sem Change::Rule(AttackDrags($counter_drag_filter)) */
drag_counter_requirement ::= "all" counter_drag_filter "attack" "if" "able"

/* The ability being reduced and its target filter are independent operands. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(One(Source)), changes:[Rule(OwnActivationCost{abilities:AllOf([OnStack(Keyword(Equip)), TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}))]), change:Reduce($generic_reduction_symbols)})]}) */
static_equip_target_reduction ::= "this" "Equipment's" "equip" "ability" "costs" generic_reduction_symbols "less" "to" "activate" "if" "it" "targets" "a" filter_phrase "."

/* A spell population and its independent stack rule compose in both directions. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($prohibited_spell_population), changes:$spell_prohibition_changes} */
static_prohibited_spell_population ::= prohibited_spell_population spell_prohibition_changes "."

prohibited_spell_population ::= prohibited_spells_all | prohibited_spells_typed | prohibited_spells_shared_type | cross_spells

/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:Any} */
prohibited_spells_all ::= "spells"

/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:$card_filter} */
prohibited_spells_typed ::= card_filter "spells"

/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:SharesWithAny{property:CardTypes, with:$shared_type_library_tops}} */
prohibited_spells_shared_type ::= "spells" "that" "share" "a" "card" "type" "with" shared_type_library_tops

shared_type_library_tops ::= library_tops | any_library_tops

/* @sem ObjectSet::LibraryTops(All) */
any_library_tops ::= "the" "top" "card" "of" "a" "library"

spell_prohibition_changes ::= spell_cant_be_countered | spell_cant_be_cast

/* @sem Change::[Change::Rule(Prohibit(Counter))] */
spell_cant_be_countered ::= "can't" "be" "countered"

/* @sem Change::[Change::Rule(Prohibit(Cast))] */
spell_cant_be_cast ::= "can't" "be" "cast"

/* Casting permissions with a separately described additional payment. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:$filter_phrase}, terms:_{limit:EachTurn(1), during:One(AbilityController), cost:Additional(Cost{parts:[$graveyard_other_exile_payment]})}})]}) */
static_once_graveyard_cast_payment ::= "once" "during" "each" "of" "your" "turns" "," "you" "may" "cast" ("a" | "an") filter_phrase "spell" "from" "your" "graveyard" "by" graveyard_other_exile_payment "in" "addition" "to" "paying" "its" "other" "costs" "."

/* A cast restriction for a spell class from two public zones. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(Prohibit(CastSpell{from:Players{zone:Graveyard, players:All}, filter:$cast_spells_filter})), PlayerRule(Prohibit(CastSpell{from:Shared(Exile), filter:$cast_spells_filter}))]}) */
static_cast_public_zones_prohibition ::= "players" "can't" "cast" cast_spells_filter "from" "graveyards" "or" "exile" "."

/* The caster set, origin filter and cost change are independent operands. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players($target_tax_casters), changes:[PlayerRule(SpellCost{spells:$cast_origin_filter, modifier:$spell_cost_change})]}) */
static_casters_origin_cost ::= "spells" target_tax_casters "cast" cast_origin_filter "cost" spell_cost_change "to" "cast" "."

/* @sem ZoneScope::Players{zone:Graveyard, players:All} */
cast_origin_all_graveyards ::= "graveyards"

/* A plural pronoun in this construction refers to the counted population.
   The controlling restriction qualifies the count, not the subsequent population. */
/* @sem Change::[Rule(LegendRuleExempt)] */
population_legend_exemption ::= "the" '"' "↓" "legend" "rule" '"' "doesn't" "apply" "to" "them"

/* @sem Ability::Conditional{condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$named_plural_population}), test:NumberTest::Compare{comparison:Equal, value:$value}}, then:[Static(_{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$named_plural_population}), changes:$population_legend_exemption})]} */
conditional_battlefield_named_population ::= "if" "there" "are" "exactly" value named_plural_population "on" "the" "battlefield" "," population_legend_exemption "."

/* @sem Ability::Conditional{condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($named_plural_population, ObjectFilter::ControlledBy(One(AbilityController)))}), test:NumberTest::Compare{comparison:Equal, value:$value}}, then:[Static(_{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$named_plural_population}), changes:$population_legend_exemption})]} */
conditional_controlled_named_population ::= "if" "you" "control" "exactly" value named_plural_population "," population_legend_exemption "."

/* Alternate graveyard casting payments compose mana with a separate exile cost. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$graveyard_cast_phrase, from:Graveyard, action:CastSpell, filter:Any}, terms:_{cost:Alternate(Cost{parts:[Mana($mana_symbols), $cast_exile_graveyard_other]})}})]})} */
static_graveyard_cast_mana_and_exile ::= graveyard_cast_phrase "by" "paying" mana_symbols "and" cast_exile_graveyard_other "rather" "than" "paying" "its" "mana" "cost" "."

/* Player-level rules retain the affected player separately from spell filters. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(All), changes:[PlayerRule(SpellsHaveAbilities{spells:$shared_granted_spell_filter, abilities:List([$shared_spell_effect])})]} */
static_shared_spell_grant ::= shared_granted_spell_filter "have" shared_spell_effect "."

shared_granted_spell_filter ::= shared_non_type_spells | shared_cast_type_spells

/* @sem ObjectFilter::$adjective_nontype */
shared_non_type_spells ::= adjective_nontype "spells"

/* @sem ObjectFilter::$shared_spell_type_pair */
shared_cast_type_spells ::= shared_spell_type_pair "spells" "players" "cast"

/* @sem ObjectFilter::AnyOf([$card_word, $card_word_2]) */
shared_spell_type_pair ::= card_word "and" card_word

shared_spell_effect ::= shared_spell_convoke | shared_spell_demonstrate

/* @sem Operand::Term{family:SpellEffect, form:Convoke} */
shared_spell_convoke ::= "convoke"

/* @sem Operand::Term{family:SpellEffect, form:Demonstrate} */
shared_spell_demonstrate ::= "demonstrate"

/* The kind and owner of an ability are independent of its cost change. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(All), changes:[PlayerRule(ActivationCost{abilities:AllOf([OnStack($shared_activation_kind), AbilityOf($activation_owner)]), change:$shared_activation_change})]} */
static_shared_activation_cost ::= shared_activation_kind "abilities" "of" activation_owner "cost" shared_activation_change "to" "activate" "."

shared_activation_kind ::= shared_loyalty_kind | shared_mana_kind | shared_equip_kind | shared_exhaust_kind

/* @sem StackTrait::Loyalty */
shared_loyalty_kind ::= "loyalty"

/* @sem StackTrait::Mana */
shared_mana_kind ::= "mana"

shared_activation_change ::= shared_activation_increase | shared_activation_life

/* @sem ActivationCostChange::Increase(Cost($cost)) */
shared_activation_increase ::= cost "more"

/* @sem ActivationCostChange::Additional{parts:[Life($value)]} */
shared_activation_life ::= "an" "additional" value "life"

/* Unspent mana changes to the stated color for its affected player. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(UnspentManaBecomes($mana_color_word))]} */
static_unspent_mana_color ::= "if" "you" "would" "lose" "unspent" "mana" "," "that" "mana" "becomes" mana_color_word "instead" "."

/* A nonmana-ability spending permission retains its source object. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(All), changes:[PlayerRule(SpendManaAs{spend_as:AnyType, on:Abilities($shared_nonmana_abilities)})]} */
static_any_type_ability_spending ::= "mana" "of" "any" "type" "can" "be" "spent" "to" "activate" shared_nonmana_abilities "."

/* @sem ObjectFilter::AllOf([AbilityOf(SameObject($object_ref)), Not(OnStack(Mana))]) */
shared_nonmana_abilities ::= object_ref "'s" "abilities"

/* Each distributes one snapshot over the already selected population. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$static_changes, duration:$duration, evaluation:Snapshot} */
continuous_each_snapshot ::= affected "each" static_changes duration

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Creature)] */
retained_plural_animation ::= "become" value "/" value becomes_types "creatures" "in" "addition" "to" "their" "other" "types"

/* @sem Change::LandTypes{scope:Basic, mode:Add} */
grant_basic_land_types ::= "all" "basic" "land" "types"

/* @sem Change::GrantKeyword(Protection(Objects(_{kind:Any, filter:SharesColorWith(Recorded{result:@prior})}))) */
grant_recorded_colors ::= "protection" "from" "each" "of" "that" "creature's" "colors"

/* @sem Change::GrantAbility(@scope(Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$program})) */
grant_unpunctuated_trigger ::= '"' event_clause "," program '"'

/* Spell-cost subjects and modifiers compose independently for all casters. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(SpellCost{spells:$global_cost_spells, modifier:$spell_cost_change})]}) */
static_global_spell_cost ::= global_cost_spells "cost" spell_cost_change "to" "cast" "."

global_cost_spells ::= cast_any_spells | global_chosen_card_spells | global_targeted_spells

/* @sem ObjectFilter::Chosen(CardType) */
global_chosen_card_spells ::= "spells" "of" "the" "chosen" "type"

/* @sem ObjectFilter::TargetsAny(Objects($affected)) */
global_targeted_spells ::= "spells" "that" "target" affected

/* The filter is shared by both consequences of a player's spell rule. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$keyword_cost_spells, modifier:$spell_cost_change}), PlayerRule(SpellsHaveAbilities{spells:$keyword_cost_spells, abilities:List([Term{family:SpellEffect, form:CantBeCountered}])})]}) */
static_keyword_spell_cost_protection ::= keyword_cost_spells "you" "cast" "cost" spell_cost_change "to" "cast" "and" "can't" "be" "countered" "."

/* @sem ObjectFilter::HasKeyword($keyword_value) */
keyword_cost_spells ::= "spells" "with" keyword_value

/* Colored reductions do not spill into generic mana. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$chosen_creature_cost_spells, modifier:Reduce{reductions:$colored_cost_reductions}})]}) */
static_chosen_colored_spell_cost ::= chosen_creature_cost_spells "you" "cast" "cost" colored_cost_reductions "less" "to" "cast" "." "this" "effect" "reduces" "only" "the" "amount" "of" "colored" "mana" "you" "pay" "."

/* @sem ObjectFilter::Chosen(CreatureType) */
chosen_creature_cost_spells ::= "spells" "of" "the" "chosen" "type"

colored_cost_reductions ::= colored_cost_one | colored_cost_many

/* @sem ManaReduction::[$colored_cost_unit] */
colored_cost_one ::= colored_cost_unit

/* @sem ManaReduction::[$colored_cost_unit, ...$colored_cost_reductions] */
colored_cost_many ::= colored_cost_unit colored_cost_reductions

/* @sem ManaReduction::_{color:$colored_cost_color, amount:Constant(1)} */
colored_cost_unit ::= colored_cost_color

colored_cost_color ::= mc_white | mc_blue | mc_black | mc_red | mc_green

/* Player spell costs compose the printed spell population and its qualifier. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:@and($cast_spells_filter, $spell_cost_threshold), modifier:$spell_cost_change})]}) */
static_qualified_cast_cost ::= cast_spells_filter "you" "cast" spell_cost_threshold "cost" spell_cost_change "to" "cast" "."

spell_cost_threshold ::= spell_cost_mana_threshold | spell_cost_power_threshold | spell_cost_shared_card_type

/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
spell_cost_mana_threshold ::= "with" "mana" "value" value "or" "greater"

/* @sem ObjectFilter::Property{property:Power, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
spell_cost_power_threshold ::= "with" "power" value "or" "greater"

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(OpponentsOf(AbilityController)), changes:[PlayerRule(SpellCost{spells:$cast_spells_filter, modifier:$spell_cost_change})]}) */
static_opponents_cast_cost ::= cast_spells_filter "your" "opponents" "cast" "cost" spell_cost_change "to" "cast" "."

/* Keyword payment adjustments retain the payer and current symbol operand. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players($target_tax_casters), changes:[PlayerRule(KeywordCost{keyword:$payment_keyword, cards:Any, change:$keyword_payment_change})]}) */
static_keyword_payment_change ::= payment_keyword "costs" target_tax_casters "pay" "cost" keyword_payment_change "."

/* @sem Mechanic::Flashback */
payment_keyword ::= "flashback"

keyword_payment_change ::= keyword_payment_less | keyword_payment_more

/* @sem KeywordCostChange::Reduce($kicker_operand_generic) */
keyword_payment_less ::= kicker_operand_generic "less"

/* @sem KeywordCostChange::Increase($kicker_operand_generic) */
keyword_payment_more ::= kicker_operand_generic "more"

/* A life substitution keeps the symbol independent of the life amount. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(LifeForMana{life:$value, symbol:$kicker_operand})]}) */
static_life_for_mana ::= "for" "each" kicker_operand "in" "a" "cost" "," "you" "may" "pay" value "life" "rather" "than" "pay" "that" "mana" "."

/* Indefinite singular animations compose their current statistics, type changes,
   and granted keywords, preserving the distinct card-type contracts. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$indefinite_animation_changes, duration:Indefinite, evaluation:Snapshot} */
indefinite_named_animation ::= affected "becomes" indefinite_animation_changes

indefinite_animation_changes ::= indefinite_plain_creature_animation | indefinite_creature_animation | indefinite_artifact_animation | indefinite_subtype_animation

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetCardTypes([Creature]), ...$animation_grants] */
indefinite_creature_animation ::= "a" value "/" value becomes_types "creature" "with" animation_grants

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, AddCardType(Artifact), AddCardType(Creature), CreatureTypes{mode:Set, types:Listed($becomes_types)}, ...$animation_grants] */
indefinite_artifact_animation ::= "a" value "/" value becomes_types "artifact" "creature" "with" animation_grants

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, ...$animation_grants] */
indefinite_subtype_animation ::= "a" value "/" value becomes_types "and" "gains" animation_grants

animation_grants ::= grants | animation_spell_color_protection

/* @sem Change::[GrantKeyword(Protection(Objects(_{kind:Any, filter:SharesColorWith(EventSubject)})))] */
animation_spell_color_protection ::= "protection" "from" "each" "of" "that" "spell's" "colors"

/* A graveyard casting permission composes with its payment and entry terms. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$affected, from:Graveyard, action:CastSpell, filter:Any}, terms:$graveyard_cast_terms})]})} */
static_graveyard_cast_terms ::= "you" "may" "cast" affected "from" "your" "graveyard" graveyard_cast_terms "."

graveyard_cast_terms ::= graveyard_cast_alternate_sacrifice | graveyard_cast_alternate | graveyard_cast_alternate_counters | graveyard_cast_warp | graveyard_cast_extra_each

/* @sem PlayTerms::PlayTerms{cost:Alternate(Cost($cost))} */
graveyard_cast_alternate ::= "by" "paying" cost "rather" "than" "paying" "its" "mana" "cost"

/* @sem PlayTerms::PlayTerms{cost:Alternate(Cost($graveyard_cast_sacrifice_cost))} */
graveyard_cast_alternate_sacrifice ::= "by" "paying" graveyard_cast_sacrifice_cost "rather" "than" "paying" "its" "mana" "cost"

/* @sem Cost::Cost{parts:[Mana($mana_symbols), Sacrifice{objects:$affected, choose:Exactly($value)}]} */
graveyard_cast_sacrifice_cost ::= mana_symbols "and" "sacrificing" value affected

/* @sem PlayTerms::PlayTerms{cost:Alternate(Cost($cost)), effects:[List([Term{family:EnterFlag, form:EntersWithNumberCounters, operands:[Number($value), Term{family:CounterType, form:PTCounter, operands:[Integer(1), Integer(1)]}]}])]} */
graveyard_cast_alternate_counters ::= "by" "paying" cost "rather" "than" "paying" "its" "mana" "cost" "." "if" "you" "do" "," "it" "enters" "with" value "+" "1" "/" "+" "1" "counters" "on" "it"

/* @sem PlayTerms::PlayTerms{cost:Using(Warp)} */
graveyard_cast_warp ::= "using" "its" "warp" "ability"

/* @sem PlayTerms::PlayTerms{cost:Additional(Cost{parts:[Repeated{part:Mana($mana_symbols), times:CountObjects(Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([Not(SameObject($object_ref)), $filter_phrase])}))}]})} */
graveyard_cast_extra_each ::= "if" "you" "pay" mana_symbols "more" "to" "cast" object_ref "for" "each" "other" filter_phrase "card" "in" "your" "graveyard"

/* @sem Ability::Scoped{zones:[Graveyard], condition:$condition, ability:Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$affected, from:Graveyard, action:CastSpell, filter:Any}, terms:_{cost:Normal, effects:[$graveyard_entry_counter]}})]})} */
static_graveyard_cast_if_entry ::= "you" "may" "cast" affected "from" "your" "graveyard" "if" condition "." "if" "you" "do" "," graveyard_entry_counter "."

/* @sem Operand::List([Term{family:EnterFlag, form:EntersWithACounter, operands:[Term{family:CounterType, form:PTCounter, operands:[Integer(1), Integer(1)]}]}]) */
graveyard_entry_counter ::= "this" "creature" "enters" "with" "a" "+" "1" "/" "+" "1" "counter" "on" "it"

/* The subtype remains an independent operand when prior land types are retained. */
/* @sem Change::[AddLandType($retained_land_singular)] */
change_add_land_type_singular ::= "is" "a" retained_land_singular "in" "addition" "to" "its" "other" "land" "types"

/* @sem Change::[AddLandType($retained_land_singular), AddCardType(Land)] */
change_add_land_card_type_plural ::= "are" retained_land_singular "lands" "in" "addition" "to" "their" "other" "types"

retained_land_singular ::= retained_forest | retained_swamp | retained_mountain

/* @sem LandType::Forest */
retained_forest ::= "Forest"

/* @sem LandType::Swamp */
retained_swamp ::= "Swamp"

/* @sem LandType::Mountain */
retained_mountain ::= "Mountain"

/* Retained subtype and card types compose with independently selected base stats. */
/* @sem Change::[CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Artifact), AddCardType(Creature), SetBasePowerToughness{power:$value, toughness:$value_2}] */
change_retained_typed_artifact_base ::= "is" "a" becomes_types "artifact" "creature" "with" "base" "power" "and" "toughness" value "/" value "in" "addition" "to" "its" "other" "types"

/* Replacement colors, creature types, stats and literal name are independent. */
/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word, $mana_color_word_2]}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetCardTypes([Creature]), SetBasePowerToughness{power:$value, toughness:$value_2}, SetName($referenced_card_name)] */
change_named_two_color_creature_base ::= "is" "a" mana_color_word "and" mana_color_word becomes_types "creature" "with" "base" "power" "and" "toughness" value "/" value "named" referenced_card_name

/* A player's casting permission carries the same zone in its source and card set. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:$own_cast_zone, players:One(Affected)}, kind:Card, filter:Any}), from:$own_cast_zone, action:CastSpell, filter:$cast_spells_filter}, terms:_{cost:Free}})]}) */
static_free_cast_from_own_zone ::= "you" "may" "cast" cast_spells_filter "from" own_cast_zone "without" "paying" "their" "mana" "costs" "."

/* @sem Zone::Hand */
own_cast_hand ::= "your" "hand"

/* @sem Zone::Graveyard */
own_cast_graveyard ::= "your" "graveyard"

/* @sem Zone::Library */
own_cast_library ::= "your" "library"

own_cast_zone ::= own_cast_hand | own_cast_graveyard | own_cast_library

/* Plural player subjects use their own zones, not the ability holder's zone. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players($player_keyword_many), changes:[PlayerRule(Prohibit(CastOutside($their_cast_zone)))]}) */
static_cast_only_from_their_zone ::= player_keyword_many "can't" "cast" "spells" "from" "anywhere" "other" "than" their_cast_zone "."

/* @sem Zone::Hand */
their_cast_hands ::= "their" "hands"

/* @sem Zone::Graveyard */
their_cast_graveyards ::= "their" "graveyards"

/* @sem Zone::Library */
their_cast_libraries ::= "their" "libraries"

their_cast_zone ::= their_cast_hands | their_cast_graveyards | their_cast_libraries

/* A turn-scoped permission can carry an independent persistent condition. */
/* @sem Ability::Conditional{condition:AllOf([PlayerIsActive(AbilityController), $condition_after_or_if]), then:[Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:$turn_exile_permissions})]} */
turn_exile_permission_as_long_as ::= "during" "your" "turn" "," "as" "long" "as" condition_after_or_if "," turn_exile_permissions "."

/* Ownership and the commander designation are independent of the holder's controller. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([State(Commander), $filter_plural, OwnedBy(One(AbilityController))])} */
owned_commander_population ::= "commander" filter_plural "you" "own"

/* Plural pump and a list of granted abilities share the same affected set. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[Pump{power:$signed, toughness:$signed_2}, ...$shared_comma_grants]} */
shared_plural_pump_grants ::= affected "get" signed "/" signed "and" "have" shared_comma_grants

shared_comma_grants ::= shared_comma_keyword_grants | shared_comma_ward_grant

/* @sem Change::[$grant_keyword, ...$shared_comma_grants] */
shared_comma_keyword_grants ::= grant_keyword "," shared_comma_grants

/* @sem Change::[GrantKeyword(Ward($cost)), $shared_granted_turn_closed] */
shared_comma_ward_grant ::= '"' "ward" "―" cost "," '"' "and" shared_granted_turn_closed

/* @sem Change::GrantAbility(@scope(Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$program})) */
shared_granted_turn_closed ::= '"' "at" turn_event "," program "." '"'

/* The other population excludes the attachment event's host, independently of
   the population's remaining characteristics. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(SameObject(EventOther)), $filter_phrase)}), changes:[CopyOf{object:EventOther, exceptions:[]}], duration:Indefinite, evaluation:Snapshot}}] */
attachment_other_population_copy ::= "each" "other" filter_phrase "becomes" "a" "copy" "of" "that" "creature"

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(EventOther)), changes:[CopyOf{object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Not(SameObject(EventOther)), $filter_phrase)}), index:0}, exceptions:[]}], duration:WhileMatches{object:Source, filter:AttachedTo(SameObject(EventOther))}, evaluation:Snapshot}}]}}] */
attachment_optional_copy ::= "for" "as" "long" "as" self_equipment "remains" "attached" "to" "it" "," "you" "may" "have" "that" "creature" "become" "a" "copy" "of" "another" "target" filter_phrase

/* @sem Ability::Triggered{event:$attachment_aura_enters_creature, limits:_{}, announcement:@announcement, body:Program{instructions:$attachment_other_population_copy}} */
triggered_attachment_population_copy ::= attachment_aura_enters_creature "," attachment_other_population_copy "."

/* @sem Ability::Triggered{event:$attachment_equipment_becomes_creature, limits:_{}, announcement:@announcement, body:Program{instructions:$attachment_optional_copy}} */
triggered_attachment_optional_copy ::= attachment_equipment_becomes_creature "," attachment_optional_copy "."

/* The follow-ups use the same snapshot captured by the control effect. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateContinuousEffect{source:Source, affected:Objects($control_all_untap_population), changes:[SetController(AbilityController)], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:SetTapped{objects:Affected(@marked), tapped:false}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Affected(@marked)), changes:$grants, duration:$duration_2, evaluation:Snapshot}}] */
clause_control_all_untap_grant ::= "gain" "control" "of" control_all_untap_population duration "." "untap" "them" "." "they" "gain" grants duration

control_all_untap_population ::= control_all_untap_creatures | control_all_untap_negated_permanents

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)} */
control_all_untap_creatures ::= "all" "creatures"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:Not(CardType($control_all_untap_excluded_type))} */
control_all_untap_negated_permanents ::= "all" control_all_untap_excluded_type "permanents"

control_all_untap_excluded_type ::= control_all_untap_nonland | control_all_untap_noncreature

/* @sem CardType::Land */
control_all_untap_nonland ::= "nonland"

/* @sem CardType::Creature */
control_all_untap_noncreature ::= "noncreature"

/* A type setting and a granted crew ability compose independently; the
   final anaphor refers to the subject of this static change. */
/* @sem Change::[...$vehicle_artifact_type, ...$it_loses_other_card_types, $grant_crew_ability] */
vehicle_artifact_with_crew_change ::= vehicle_artifact_type "with" grant_crew_ability "and" it_loses_other_card_types

/* @sem Change::[SetArtifactType(Vehicle)] */
vehicle_artifact_type ::= "is" "a" "Vehicle" "artifact"

/* @sem Change::[SetCardTypes([Artifact])] */
it_loses_other_card_types ::= "it" "loses" "all" "other" "card" "types"

/* Crew is an activated ability of each recipient of the grant. */
/* @sem Change::GrantAbility(@holder($crew_ability)) */
grant_crew_ability ::= crew_ability

/* Each attacker binds the payer and the creature whose blockers receive the grant. */
/* @sem Instruction::[ForEachObject{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Attacking, CardType(Creature), Not(HasKeyword($keyword_name))])}, binding:0, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:ControllerOf(Bound(0)), cost:Cost{parts:[Mana($mana_symbols)]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController)), BlockingObject(Bound(0))])}), changes:[GrantKeyword($keyword_name_2)], duration:$duration, evaluation:Snapshot}}]}, otherwise:Program{}}]}}] */
instructions_attacker_controller_payment ::= "for" "each" "attacking" "creature" "without" keyword_name "," "its" "controller" "may" "pay" mana_symbols "." "if" "that" "player" "doesn't" "," "creatures" "you" "control" "blocking" "that" "creature" "gain" keyword_name duration

/* The turn restriction governs the entire graveyard permission. The two
   permission clauses retain their own card populations and cast effects. */
/* @sem Ability::Conditional{condition:PlayerIsActive(AbilityController), then:[Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[$turn_graveyard_permission]})]} */
once_each_turn_graveyard_permission ::= "once" "during" "each" "of" "your" "turns" "," turn_graveyard_permission

turn_graveyard_permission ::= turn_graveyard_artifact_tapped | turn_graveyard_permanent_perpetual

/* @sem Change::PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:CardType(Artifact)}, terms:_{limit:EachTurn(1), cost:Normal, effects:[List([$cast_artifact_entry_effect])]}}) */
turn_graveyard_artifact_tapped ::= "you" "may" "cast" "an" "artifact" "spell" "from" "your" "graveyard" "." cast_artifact_entry_effect

/* @sem Operand::Term{family:SpellEffect, form:EntersTapped} */
cast_artifact_entry_effect ::= "if" "you" "cast" "a" "spell" "this" "way" "," "that" "artifact" "enters" "tapped" "."

/* @sem Change::PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([Not(Subtype(Aura)), $filter_phrase, AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)])])}), from:Graveyard, action:CastSpell, filter:AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)])}, terms:_{limit:EachTurn(1), cost:Normal, effects:[List([$cast_perpetual_creature_effect])]}}) */
turn_graveyard_permanent_perpetual ::= "you" "may" "cast" "a" "permanent" "spell" "from" "among" "non-Aura" "," filter_phrase "cards" "in" "your" "graveyard" "." cast_perpetual_creature_effect

/* @sem Operand::Term{family:SpellEffect, form:CastWithPerpetualEffect, operands:[Term{family:PerpetualEffect, form:SetPT, operands:[Term{family:PT, form:PT, operands:[Integer($number), Integer($number_2)]}]}, Term{family:PerpetualEffect, form:AddCreatureType, operands:[Vocabulary{family:CreatureType, form:@subtype_name($creature_subtype)}]}, Term{family:PerpetualEffect, form:AddCardtype, operands:[Vocabulary{family:CardType, form:Creature}]}]} */
cast_perpetual_creature_effect ::= "if" "you" "do" "," "it" "perpetually" "becomes" "a" NUMBER "/" NUMBER creature_subtype "creature" "in" "addition" "to" "its" "other" "types" "."

/* A per-combat blocker cap expires with the stated turn. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$rule_block_limit, duration:$this_duration, evaluation:LiveObjects} */
combat_block_cap_this_turn ::= affected rule_block_limit "each" "combat" this_duration

/* Card type operands are independent; only consonant-sound articles use "a". */
/* @sem Change::[RemoveCardType($singular_a_card_type)] */
static_remove_singular_card_type ::= "isn't" "a" singular_a_card_type

singular_a_card_type ::= added_creature | added_land | singular_planeswalker_card_type

/* @sem CardType::Planeswalker */
singular_planeswalker_card_type ::= "planeswalker"

hand_size_value ::= value | hand_size_equal_value

/* @sem $value */
