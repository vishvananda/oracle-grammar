continuous_live_object_next_turn ::= object_ref rule_changes "during" "its" "controller's" "next" "turn"

/* @sem ObjectFilter::TargetsAny(Players(One(Active))) */
target_tax_active_player ::= "the" "active" "player"

/* Sentence-initial subtype spelling for the chosen-abilities clause. */
