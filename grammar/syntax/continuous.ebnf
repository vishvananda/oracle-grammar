stack_source_target_tax ::= "spells" "that" "target" "it" "cost" spell_cost_change "to" "cast" "."

/* The named subject is also the antecedent of the additive type change. */
/* @sem Ability::Conditional{condition:ObjectMatches{object:$self_explicit_ref, filter:$self_zone_test}, then:[Static(_{kind:Ordinary, affected:Objects(One($self_explicit_ref)), changes:$anaphoric_add_card_type})]} */
self_zone_add_type ::= "as" "long" "as" self_explicit_ref self_zone_test "," "it's" anaphoric_add_card_type "."

