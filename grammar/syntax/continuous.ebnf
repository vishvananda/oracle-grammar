only_card_type_vowel ::= "an" vowel_card_type

/* @sem $consonant_card_type */
only_card_type_consonant ::= "a" consonant_card_type

vowel_card_type ::= added_artifact | added_enchantment

consonant_card_type ::= added_creature | added_land

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected_plural)), changes:$target_ban_kind_spells_opponents, duration:$rule_duration, evaluation:LiveObjects} */
continuous_live_plural_opponent_colored_target_ban ::= affected_plural "can't" "be" "the" "targets" "of" target_ban_kind_spells_opponents ("↓")? rule_duration

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_explicit_ref)), changes:$rule_blocked_greater_source_power, duration:$this_combat, evaluation:LiveObjects} */
continuous_live_source_power_block ::= self_explicit_ref rule_blocked_greater_source_power this_combat

/* @prefer always */
