/* @sem PlayerRule::Skip(Upkeep) */
plural_player_continuous_rule ::= "skip" "their" "upkeep" "steps"

/* The suffix window is supplied by the enclosing static condition. */
/* @sem Change::[Rule(Prohibit(TurnFaceUp))] */
change_turn_face_up_ban ::= "can't" "be" "turned" "face" "up"

/* A blocker requirement names the attacker and the eligible blocking filter. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[Rule(RequireCombat{action:BeBlocked($filter_plural), amount:Each})]} */
shared_all_blockers_static ::= "all" filter_plural "able" "to" "block" affected "do" "so" "."

/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[Rule(CombatDamage(AsUnblocked{optional:true}))]} */
shared_each_assignment_static ::= "for" affected "," "you" "may" "have" "that" "creature" "assign" "its" "combat" "damage" "as" "though" "it" "weren't" "blocked" "."

/* @sem Ability::Conditional{condition:$condition, then:[$shared_conditional_combat_static]} */
shared_conditional_combat ::= "as" "long" "as" condition "," shared_conditional_combat_static

shared_conditional_combat_static ::= shared_all_blockers_static | shared_each_assignment_static | shared_artifact_protection_static

/* @sem Change::[Rule(ActivationsEachTurn{abilities:OnStack(Keyword(Boast)), times:Constant(2)})] */
shared_boast_twice ::= "can" "boast" "twice" "during" "each" "of" "your" "turns" "rather" "than" "once"

/* @sem Ability::Conditional{condition:PlayerIsActive(AbilityController), then:[Static{kind:Ordinary, affected:Objects($affected), changes:$shared_boast_twice}]} */
shared_boast_turn_static ::= affected shared_boast_twice "."

/* The artifact noun is also the antecedent of the final sentence. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(CardType(Creature)), CardType(Artifact), ControlledBy(One(AbilityController))])} */
shared_noncreature_artifacts_controlled ::= "noncreature" "artifacts" "you" "control"

/* The attached objects named by both sentences are Auras. */
/* @sem Change::[Rule(Prohibit(BeAttachedBy{attachments:Subtype(Aura), keep_existing:true})), Rule(Prohibit(ChangeControl)), GrantKeyword($keyword_value)] */
shared_artifact_protection_changes ::= "can't" "be" "enchanted" "," "they" "have" keyword_value "," "and" "other" "players" "can't" "gain" "control" "of" "them" "." "this" "effect" "doesn't" "remove" "Auras" "already" "attached" "to" "those" "artifacts" "."

/* @sem Ability::Static{kind:Ordinary, affected:Objects($shared_noncreature_artifacts_controlled), changes:$shared_artifact_protection_changes} */
shared_artifact_protection_static ::= shared_noncreature_artifacts_controlled shared_artifact_protection_changes

/* A suffix window qualifies the complete restriction; keep the written
   restriction as a typed change so edited subjects remain independent. */
/* @prefer always */
/* @sem Ability::Conditional{condition:$static_suffix_window, then:[Static{kind:Ordinary, affected:Objects($affected), changes:$scoped_turn_restriction}]} */
scoped_suffix_restriction ::= affected scoped_turn_restriction static_suffix_window "."

scoped_turn_restriction ::= change_turn_face_up_ban | rule_cant_block

/* The count's bound player supplies the life total and its own starting life. */
/* @sem Expr::CountPlayers(Intersection([$players_singular, Matching{binding:0, condition:Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:Less, value:Divide{numerator:StartingLife(Prior(That)), denominator:Constant(2), rounding:Up}}}}])) */
count_players_below_half ::= players_singular "whose" "life" "total" "is" "less" "than" "half" "their" "starting" "life" "total"

/* @sem Change::[Pump{power:Multiply($value, $count_players_below_half), toughness:Multiply($value_2, $count_players_below_half)}] */
change_pump_life_players ::= "gets" "+" value "/" "+" value "for" count_players_below_half

/* @sem Expr::Dice(MostEqual) */
stored_results_same_count ::= "the" "greatest" "number" "of" "stored" "results" "on" "it" "of" "the" "same" "value"

/* @sem Change::[Pump{power:$stored_results_same_count, toughness:$stored_results_same_count}] */
change_pump_stored_results ::= "gets" "+" "X" "/" "+" "X" "," "where" "X" "is" stored_results_same_count

/* This scoped sequence retains the independently editable bonus, keyword, color and subtype. */
/* @sem Change::[...$singular_pump, ...$singular_keyword_grant, ...$retained_color_creature_type] */
static_pump_keyword_color_type ::= singular_pump "," singular_keyword_grant "," "and" retained_color_creature_type

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}] */
singular_pump ::= "gets" signed "/" signed

/* @sem Change::[GrantKeyword($keyword_name)] */
singular_keyword_grant ::= "has" keyword_name

/* @sem Change::[Colors{mode:Add, colors:[$mana_color_word]}, CreatureTypes{mode:Add, types:Listed($becomes_types)}] */
retained_color_creature_type ::= "is" "a" mana_color_word becomes_types "in" "addition" "to" "its" "other" "colors" "and" "types"

/* A granted spell effect counts a live population, independently of the spell filter. */
/* @sem Operand::Term{family:SpellEffect, form:Affinity, operands:[Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$subtype_plural})]} */
spell_effect_affinity_population ::= "affinity" "for" subtype_plural

/* Activated-ability costs repeat an independently described cost part per symbol. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(All), changes:[PlayerRule(ActivationCost{abilities:Any, change:$activation_repeated_cost})]} */
static_repeated_activation_cost ::= "activated" "abilities" "cost" activation_repeated_cost "."

/* @sem ActivationCostChange::Additional{parts:[Repeated{part:$cost_sacrifice, times:ActivationCostSymbols([$devotion_color])}]} */
activation_repeated_cost ::= "an" "additional" '"' cost_sacrifice '"' "to" "activate" "for" "each" devotion_color "mana" "symbol" "in" "their" "activation" "costs"

/* A singular affected player supplies the controller of the counted population. */
/* @sem Ability::Static{kind:Ordinary, affected:Players($players_singular), changes:[PlayerRule(Prohibit(CastSpell{filter:@and($adjective_nontype, $affected_control_mana_threshold)}))]} */
static_singular_cast_threshold ::= players_singular "can't" "cast" adjective_nontype "spells" affected_control_mana_threshold "."

/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Affected))])})}} */
affected_control_mana_threshold ::= "with" "mana" "value" "greater" "than" "the" "number" "of" filter_plural "that" "player" "controls"

/* A first-cast population and a counted colored reduction are separate operands. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$first_cast_filter_player, modifier:$colored_counted_reduction})]} */
static_first_cast_counted_cost ::= first_cast_filter_player "costs" colored_counted_reduction "."

/* @sem ObjectFilter::NthCast{ordinal:Constant(1), spells:$first_cast_pair, by:One(AbilityController), scope:Turn} */
first_cast_filter_player ::= "the" "first" first_cast_pair "spell" "you" "cast" "each" "turn"

/* @sem ObjectFilter::AnyOf([$spell_instant, $spell_sorcery]) */
first_cast_pair ::= spell_instant "or" spell_sorcery

/* @sem SpellCostModifier::Reduce{reductions:[_{color:$counted_reduction_color, amount:$controlled_counter_count}], spill_into_generic:true} */
colored_counted_reduction ::= counted_reduction_color "less" "to" "cast" "for" "each" controlled_counter_count

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController)), Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})])}) */
controlled_counter_count ::= filter_phrase "you" "control" "with" "a" counter_kind "counter" "on" "it"

counted_reduction_color ::= counted_reduction_white | counted_reduction_blue | counted_reduction_black | counted_reduction_red | counted_reduction_green

/* @sem ManaColor::White */
counted_reduction_white ::= "{" "W" "}"

/* @sem ManaColor::Blue */
counted_reduction_blue ::= "{" "U" "}"

/* @sem ManaColor::Black */
counted_reduction_black ::= "{" "B" "}"

/* @sem ManaColor::Red */
counted_reduction_red ::= "{" "R" "}"

/* @sem ManaColor::Green */
counted_reduction_green ::= "{" "G" "}"

/* The singular subject is both the affected object and the history subject. */
/* @sem Ability::Conditional{condition:ObjectMatches{object:$scalar_static_subject, filter:$scalar_last_turn_history}, then:[Static{kind:Ordinary, affected:Objects(One($scalar_static_subject)), changes:$static_changes}], otherwise:[]} */
scalar_last_turn_conditional ::= scalar_static_subject static_changes "if" "it" scalar_last_turn_history "."

/* The speaker's untap step is valid here only for the source itself. */
/* @sem Ability::Conditional{condition:ObjectMatches{object:$self_ref_holder, filter:$scalar_last_turn_history}, then:[Static{kind:Ordinary, affected:Objects(One($self_ref_holder)), changes:$entry_self_skip_untap}], otherwise:[]} */
self_skip_last_turn_conditional ::= self_ref_holder entry_self_skip_untap "if" "it" scalar_last_turn_history "."

/* Within a Case, the joined permissions belong to the solved ability frame. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, audience:AffectedPlayer}), ...$case_top_permissions]}) */
case_top_look_and_play ::= "you" "may" "look" "at" "the" "top" "card" "of" "your" "library" "any" "time" case_top_permissions "."

case_top_permissions ::= case_top_filtered_permissions | case_top_all_permissions

/* @sem Change::[...$top_play_lands, ...$case_top_filtered_cast] */
case_top_filtered_permissions ::= "," "and" "you" "may" top_play_lands "and" case_top_filtered_cast "from" "the" "top" "of" "your" "library"

/* @sem Change::[...$top_play_lands, ...$case_top_all_cast] */
case_top_all_permissions ::= "and" "you" "may" top_play_lands "and" case_top_all_cast "from" "the" "top" "of" "your" "library"

/* @sem Change::[PlayerRule(PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, from:Library, action:CastSpell, filter:$case_top_cast_filter})] */
case_top_filtered_cast ::= "cast" case_top_cast_filter

case_top_cast_filter ::= cast_kind_spells | cast_kind_pair_spells | cast_kind_list_spells | cast_two_kinds_spells | cast_modified_spells | cast_kind_modified_spells | cast_chosen_type_spells

/* @sem Change::[PlayerRule(PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, from:Library, action:CastSpell, filter:$cast_any_spells})] */
case_top_all_cast ::= "cast" cast_any_spells

/* The qualifying state belongs to the live battlefield population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, State(NoAbilities)])} */
static_abilityless_population ::= filter_plural "with" "no" "abilities"

/* @sem Change::[RemoveSupertype(Legendary)] */
strip_conditional_legendary ::= "isn't" "legendary"

/* @sem Change::[RemoveSupertype(Snow)] */
strip_conditional_snow ::= "isn't" "snow"

conditional_supertype_removal ::= strip_conditional_legendary | strip_conditional_snow

/* @sem Condition::ObjectMatches{object:ObjectRef::@it, filter:Token} */
conditional_supertype_is_token ::= "it's" "a" "token"

/* @sem Condition::ObjectMatches{object:ObjectRef::@it, filter:Any} */
conditional_supertype_is_permanent ::= "it's" "a" "permanent"

condition_supertype_removal_object_kind ::= conditional_supertype_is_token | conditional_supertype_is_permanent

/* @sem Ability::Conditional{condition:$condition_supertype_removal_object_kind, then:[Static(_{kind:Ordinary, affected:Objects($affected), changes:$conditional_supertype_removal})]} */
static_conditional_supertype_removal ::= affected conditional_supertype_removal "if" condition_supertype_removal_object_kind "."

/* An extreme selects from the named population, retaining the complete query. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:Extreme{among:$extreme_subject, property:$extreme_property, highest:true}} */
affected_extreme_population ::= extreme_subject "with" "the" "greatest" extreme_property

extreme_subject ::= objects_each | objects_all

extreme_property ::= stat_mana_value | stat_power | stat_toughness

/* The extreme selects the static effect's complete affected population. */
/* @prefer always */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected_extreme_population), changes:$static_changes} */
static_extreme_population ::= affected_extreme_population static_changes "."

/* Both colors select members of the same creature population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([AnyOf([$adjective_color, $adjective_color_2]), CardType(Creature)])} */
static_affected_repeated_colored_creatures ::= adjective_color "creatures" "and" adjective_color "creatures"

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($static_affected_repeated_colored_creatures), changes:$static_changes}) */
static_repeated_colored_creatures ::= static_affected_repeated_colored_creatures static_changes "."

/* The counter selects the permanent whose controller's untap step is skipped. */
/* @prefer always */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:Counters{kind:$untap_an_counter, comparison:Greater, value:Constant(0)}}), changes:[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})]} */
static_untap_with_named_counter ::= "each" "permanent" "with" "an" untap_an_counter "counter" "on" "it" "doesn't" "untap" "during" "its" "controller's" "untap" "step" "."

untap_an_counter ::= cn_age | cn_hourglass | cn_ice

/* The color exception applies to this static effect on the affected object. */
/* @prefer always */
/* @sem Ability::Conditional{condition:Not($condition_shares_most_common_color), then:[Ability::Static{kind:Ordinary, affected:Objects($affected), changes:$static_changes}]} */
static_unless_shares_most_common_color ::= affected static_changes "unless" condition_shares_most_common_color "."

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, AttackingDefender(Players(One(AbilityController)))])} */
affected_attackers_of_controller ::= filter_plural "attacking" "you"

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected_attackers_of_controller), changes:$static_changes}) */
static_attackers_of_controller ::= affected_attackers_of_controller static_changes "."

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase} */
affected_graveyard_card_each ::= "each" filter_phrase "card" "in" "your" "graveyard"

/* @sem Change::[ChosenType{kind:CreatureType, mode:Add}] */
change_add_chosen_creature_type_singular ::= "has" "the" "chosen" "creature" "type" "in" "addition" "to" "its" "other" "types"

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected_graveyard_card_each), changes:$change_add_chosen_creature_type_singular}) */
static_graveyard_add_chosen_type ::= affected_graveyard_card_each change_add_chosen_creature_type_singular "."

/* @sem Condition::AnyOf([Controls{player:AbilityController, filter:$filter_phrase, minimum:1}, Controls{player:AbilityController, filter:$filter_phrase_2, minimum:1}]) */
attack_allowed_with_either_controlled_kind ::= "you" "control" "a" filter_phrase "or" "a" filter_phrase

/* @sem Ability::Conditional{condition:Not($attack_allowed_with_either_controlled_kind), then:[Static(_{kind:Ordinary, affected:Objects(One(Source)), changes:$rule_cant_attack})]} */
static_source_attack_requires_either_controlled_kind ::= self_creature rule_cant_attack "unless" attack_allowed_with_either_controlled_kind "."

/* The written filter qualifies the affected permanent whose controller's untap step is skipped. */
/* @prefer always */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, $modifier_with_nonmana_activated_ability])}), changes:[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})]} */
static_untap_with_nonmana_ability ::= "each" filter_phrase modifier_with_nonmana_activated_ability "doesn't" "untap" "during" "its" "controller's" "untap" "step" "."

/* A repeated source group retains the nested all-colors protection. */
/* @sem Protection::Each([Objects{kind:Any, filter:Color(White)}, Objects{kind:Any, filter:Color(Blue)}, Objects{kind:Any, filter:Color(Black)}, Objects{kind:Any, filter:Color(Red)}, Objects{kind:Any, filter:Color(Green)}]) */
protection_each_all_colors ::= "each" "color"

/* Keep the two keyword grants and the count-dependent bonus on the same population. */
/* @prefer always */
/* @sem Change::[$grant_keyword, $grant_keyword_2, Pump{power:@times($signed_plus, $count_each_completed_dungeon), toughness:@times($signed_plus_2, $count_each_completed_dungeon)}] */
static_have_grants_and_dungeon_pump ::= "have" grant_keyword "and" grant_keyword "and" "get" signed_plus "/" signed_plus "for" "each" count_each_completed_dungeon

/* Defender's untapped population retains the power comparison. */
/* @sem ObjectFilter::AllOf([Not(Tapped), $noun, Property{property:Power, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}]) */
defender_untapped_power_less ::= noun "with" "power" number "or" "less"

/* The unrestricted counter prohibition applies to spells and abilities together. */
/* @sem ObjectSet::AnyZone(Any) */
counterable_spells_and_abilities ::= "spells" "and" "abilities"

/* @sem Ability::Static{kind:Ordinary, affected:Objects($counterable_spells_and_abilities), changes:$spell_cant_be_countered} */
static_counterable_population ::= counterable_spells_and_abilities spell_cant_be_countered "."

/* Assignment can include the defending player's controlled permanents. */
/* @sem Change::[Rule(AssignDamageTo{players:DefendingPlayerOf(Source), permanents:AllOf([$plural, ControlledBy(One(DefendingPlayerOf(Source)))])})] */
divided_defender_assignment ::= "assign" "this" "creature's" "combat" "damage" "divided" "as" "you" "choose" "among" "defending" "player" "and" "/" "or" "any" "number" "of" plural "they" "control"

/* @sem Ability::Static{kind:Ordinary, affected:Objects(One(Source)), changes:$divided_defender_assignment} */
static_divided_defender_assignment ::= "you" "may" divided_defender_assignment "."

/* Masculine references have their own print shape. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[Rule(MayExert(Program($exert_callback_program)))]}) */
static_may_exert_he ::= "you" "may" "exert" affected "as" "he" "attacks" "." "when" "you" "do" "," exert_callback_program "."

/* @sem Change::[Rule(CombatDamage(AsUnblocked{optional:true}))] */
combat_assign_unblocked_he ::= "assign" "his" "combat" "damage" "as" "though" "he" "weren't" "blocked"

/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:$combat_assign_unblocked_he} */
static_assign_unblocked_he ::= "you" "may" "have" affected combat_assign_unblocked_he "."

/* A quoted triggered ability belongs to the affected holder. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[GrantAbility(@holder($retirement_quoted_trigger))]} */
retirement_singular_grant ::= affected "has" '"' retirement_quoted_trigger '"'

/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[GrantAbility(@holder($retirement_quoted_trigger))]} */
retirement_plural_grant ::= affected "have" '"' retirement_quoted_trigger '"'

retirement_quoted_trigger ::= retirement_created_attachment_trigger | retirement_counter_batch_trigger | retirement_each_player_trigger

/* The second action counts attachments to the named object, excluding the granting object. */
/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$token_group], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@prior)), kind:$counter_kind, amount:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, AttachedTo(SameObject($object_ref)), Not(SameObject(GrantingObject))])})}]}}]}} */
retirement_created_attachment_trigger ::= event_clause "," "create" token_group "." "put" "a" counter_kind "counter" "on" "that" "token" "for" "each" filter_phrase "attached" "to" object_ref "other" "than" SELF_NAME "."

/* The event and the additional counter are independent typed operands. */
/* @sem Ability::Triggered{event:Batch{event:Counters(_{change:Put, kind:$counter_kind, objects:SameObject(Source)}), per:Subject}, limits:_{per_turn:1}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(EventSubject)), kind:$counter_kind_2, amount:Constant(1)}]}}]}} */
retirement_counter_batch_trigger ::= "whenever" "one" "or" "more" counter_kind "counters" "are" "put" "on" "this" "permanent" "," "put" "an" "additional" counter_kind "counter" "on" "it" "." "this" "ability" "triggers" "only" "once" "each" "turn" "."

/* The loop's optional placement and its receipt-dependent protection stay together. */
/* @sem Ability::Triggered{event:$retirement_entry_upkeep_event, limits:_{}, announcement:@announcement, body:$retirement_each_player_counter_protection} */
retirement_each_player_trigger ::= retirement_entry_upkeep_event "," retirement_each_player_counter_protection

/* @sem EventSpec::AnyOf([ZoneChange{objects:SameObject(Source), to:Battlefield}, Turn{point:UpkeepBegins, players:One(AbilityController)}]) */
retirement_entry_upkeep_event ::= "when" "this" "creature" "enters" "and" "at" "the" "beginning" "of" "your" "upkeep"

/* @sem Program::Program{instructions:[ForEachPlayer{players:All, binding:0, body:_{instructions:[Optional{decider:Bound(0), body:_{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(Bound(0)))])}), kind:$counter_kind, amount:$number_words, selection:_{player:Bound(0), count:AsManyAsCan(Constant(1))}}]}}]}}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(GrantKeyword(Protection(Players(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:PlayerTook{player:Bound(0), result:@prior}}])))))], duration:UntilNextTurn(AbilityController), evaluation:LiveObjects}}]} */
retirement_each_player_counter_protection ::= "each" "player" "may" "put" number_words counter_kind "counters" "on" "a" "creature" "they" "control" "." "for" "each" "opponent" "who" "does" "," "you" "gain" "protection" "from" "that" "player" "until" "your" "next" "turn" "."

/* The trailing condition is evaluated for each member of the subject population. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, $each_object_state)}), changes:$static_changes}) */
static_each_object_state ::= "each" filter_phrase static_changes each_object_state "."

/* @sem ObjectFilter::Not(Attacking) */
each_object_state ::= "as" "long" "as" "it's" "not" "attacking"

/* The excluded keywords and population remain independent typed operands. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, Not(HasKeyword($keyword_value)), Not(HasKeyword($keyword_value_2))])} */
affected_without_keyword_pair ::= filter_plural "without" keyword_value "or" keyword_value

/* Preserve either written keyword order through the same exclusion meaning. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, Not(HasKeyword($keyword_value_2)), Not(HasKeyword($keyword_value))])} */
affected_without_keyword_pair_reverse ::= filter_plural "without" keyword_value "or" keyword_value

/* @sem Ability::Conditional{condition:$condition, then:[Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes})]} */
static_changes_as_long_as ::= affected static_changes "as" "long" "as" condition "."

/* The controller and owner are independent properties of each battlefield object. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController)), OwnedBy(OthersThan(AbilityController))])} */
controlled_not_owned_each ::= "each" filter_phrase "you" "control" "but" "don't" "own"

/* A stack-only conditional wraps an independently composable spell grant. */
/* @sem Ability::Scoped{zones:[Stack], condition:$condition, ability:$conditional_stack_grant} */
conditional_stack_ability ::= conditional_stack_grant "as" "long" "as" condition "."

/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Stack), kind:Spell, filter:SameObject(Source)}), changes:[GrantAbility($spell_mechanic)]} */
conditional_stack_grant ::= self_spell "has" spell_mechanic

/* A final quoted ability closes the scoped static sentence. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes_closed})} */
static_in_graveyard_closed ::= "as" "long" "as" "this" "card" "is" "in" "your" "graveyard" "," affected static_changes_closed

/* Compose two independently expressed static abilities as conditional arms. */
/* @sem Ability::Conditional{condition:$condition, then:[$static_ordinary_ability], otherwise:[$static_ordinary_ability_2]} */
shared_conditional_static_otherwise ::= "as" "long" "as" condition "," static_ordinary_ability "otherwise" "," static_ordinary_ability

/* Word substitution retains the independent affected population and vocabulary operands. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($word_text_population), changes:[ReplaceWord{from:$word_replacement_source, to:$word_replacement_destination}]}) */
static_word_substitution ::= "all" "instances" "of" word_replacement_source "in" "the" "text" "of" word_text_population "are" "changed" "to" word_replacement_destination "."

/* @sem Operand::Vocabulary{family:Color, form:AnyColor} */
word_replacement_source ::= "color" "words"

/* @sem Operand::Vocabulary{family:Color, form:TheChosenColor} */
word_replacement_destination_chosen ::= "the" "chosen" "color" "word"

/* @sem Operand::Vocabulary{family:Color, form:White} */
word_replacement_destination_white ::= "the" "white" "color" "word"

/* @sem Operand::Vocabulary{family:Color, form:Blue} */
word_replacement_destination_blue ::= "the" "blue" "color" "word"

/* @sem Operand::Vocabulary{family:Color, form:Black} */
word_replacement_destination_black ::= "the" "black" "color" "word"

/* @sem Operand::Vocabulary{family:Color, form:Red} */
word_replacement_destination_red ::= "the" "red" "color" "word"

/* @sem Operand::Vocabulary{family:Color, form:Green} */
word_replacement_destination_green ::= "the" "green" "color" "word"

word_replacement_destination ::= word_replacement_destination_chosen | word_replacement_destination_white | word_replacement_destination_blue | word_replacement_destination_black | word_replacement_destination_red | word_replacement_destination_green

/* @sem ObjectSet::Union([$affected, Zone(_{scope:Shared(Stack), kind:Spell, filter:Any})]) */
word_text_population ::= "spells" "and" affected

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetCardTypes([Creature])] */
indefinite_plain_creature_animation ::= "a" value "/" value becomes_types "creature"

/* Both branches describe the same singular subject; the turn window is a
   condition on the ability rather than a duration on either change. */
/* @sem Ability::Conditional{condition:$static_turn_window, then:[Static(_{kind:Ordinary, affected:Objects(One($scalar_static_subject)), changes:$static_changes})], otherwise:[Static(_{kind:Ordinary, affected:Objects(One($scalar_static_subject)), changes:$static_changes_2})]} */
scalar_static_turn_otherwise ::= scalar_static_subject static_changes static_turn_window "." "otherwise" "," "it" static_changes "."

/* Each qualifying permanent is affected independently. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counter_filter_an} */
affected_each_counter_an ::= "each" counter_filter_an

/* @sem Change::[LandTypes{scope:All, mode:Add}] */
change_is_every_land_type_add ::= "is" "every" "land" "type" "in" "addition" "to" "its" "other" "types"

/* An ordinal choice qualifies the current battlefield population independently of its change. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::NthChosen(0))} */
affected_first_chosen_type ::= filter_plural "of" "the" "first" "chosen" "type"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::NthChosen(1))} */
affected_second_chosen_type ::= filter_plural "of" "the" "second" "chosen" "type"

affected_nth_chosen_type ::= affected_first_chosen_type | affected_second_chosen_type

/* The destination land type is an independent chosen value. */
/* @sem Change::[SetLandType(Term{family:LandTypeVariable, form:TheFirstChosenLandType})] */
change_are_first_chosen_land_type ::= "are" "the" "first" "chosen" "type"

/* @sem Change::[SetLandType(Term{family:LandTypeVariable, form:TheSecondChosenLandType})] */
change_are_second_chosen_land_type ::= "are" "the" "second" "chosen" "type"

change_are_nth_chosen_land_type ::= change_are_first_chosen_land_type | change_are_second_chosen_land_type

/* A unit bonus tracks one named quantity for each affected object. */
/* @sem Change::[Pump{power:$shared_pump_count, toughness:$shared_pump_count}] */
shared_equal_count_pump ::= "gets" "+" "1" "/" "+" "1" "for" "each" shared_pump_count

shared_pump_count ::= shared_unspent_mana_count | shared_unspent_color_count | shared_own_mana_symbols_count | shared_own_type_count

/* @sem Expr::PlayerNumber{player:AbilityController, number:UnspentMana} */
shared_unspent_mana_count ::= "unspent" "mana" "you" "have"

/* @sem Expr::PlayerNumber{player:AbilityController, number:UnspentManaOf($mana_color_word)} */
shared_unspent_color_count ::= "unspent" mana_color_word "mana" "you" "have"

/* @sem Expr::CountManaSymbols{objects:One(Affected), colors:[$mana_color_word]} */
shared_own_mana_symbols_count ::= mana_color_word "mana" "symbol" "in" "its" "mana" "cost"

/* @sem Expr::Add([Add([ObjectProperty{object:Affected, property:SupertypeCount, information:CurrentOrLastKnown}, CountDistinct{objects:One(Affected), property:CardTypes}]), ObjectProperty{object:Affected, property:SubtypeCount, information:CurrentOrLastKnown}]) */
shared_own_type_count ::= "supertype" "," "card" "type" "," "and" "subtype" "it" "has"

/* Keep the singular color spelling with the accompanying static bonus. */
/* @sem Change::[Pump{power:$signed, toughness:$signed_2}, Colors{mode:Set, colors:[$mana_color_word]}] */
shared_pump_and_singular_color ::= "gets" signed "/" signed "and" "is" mana_color_word

/* @sem Change::[Rule(RequireCombat{action:BeBlocked($filter_plural), amount:Each})] */
shared_blockers_requirement ::= "all" filter_plural "able" "to" "block" "it" "do" "so"

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}, ...$shared_blockers_requirement] */
shared_pump_and_blockers ::= "gets" signed "/" signed "and" shared_blockers_requirement

/* Conditional player rules retain the condition and the complete static body. */
/* @sem Ability::Conditional{condition:$condition, then:[$shared_conditional_player_body]} */
shared_as_long_as_player_rule ::= "as" "long" "as" condition "," shared_conditional_player_body

shared_conditional_player_body ::= static_cast_kind_as_though_flash | static_cycling_alternate_payment | static_player_prohibition | shared_damage_no_life_loss | shared_damage_life_floor

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(KeywordCost{keyword:Cycling, cards:Any, change:Alternate($kicker_operand_generic)})]}) */
static_cycling_alternate_payment ::= "you" "may" "pay" kicker_operand_generic "rather" "than" "pay" "cycling" "costs" "."

/* The creature holder and defending player are both the source of this rule. */
/* @prefer always */
/* @sem Ability::Conditional{condition:ObjectMatches{object:Source, filter:$condition_state}, then:[Static(_{kind:Ordinary, affected:Players(One(DefendingPlayerOf(Source))), changes:[PlayerRule(Prohibit(CastSpell{filter:$cast_spells_filter}))]})]} */
shared_creature_defender_cast_limit ::= "as" "long" "as" self_creature "is" condition_state "," "defending" "player" "can't" "cast" cast_spells_filter "."

/* A combat window scopes an ordinary player prohibition. */
/* @prefer always */
/* @sem Ability::Conditional{condition:Window(Combat), then:[Static(_{kind:Ordinary, affected:Players(All), changes:$paired_combat_player_rules})]} */
shared_combat_player_rule ::= "during" "combat" "," "players" "can't" paired_combat_player_rules "."

/* @sem Change::[PlayerRule(Prohibit($player_prohibit_typed_spells)), PlayerRule(Prohibit($player_prohibit_activate_nonmana))] */
paired_combat_player_rules ::= player_prohibit_typed_spells "or" player_prohibit_activate_nonmana

/* Both declarations carry the same current payment operand. */
/* @sem Change::[Rule(CombatCost{action:Attack(Any), payer:DeclaringPlayer, cost:$combat_payment}), Rule(CombatCost{action:Block(Any), payer:DeclaringPlayer, cost:$combat_payment})] */
combat_attack_block_you ::= "can't" "attack" "or" "block" "unless" "you" combat_payment

/* @sem Change::[Rule(CombatCost{action:Block(Any), payer:DeclaringPlayer, cost:$combat_payment_pays}), Rule(CombatCost{action:Attack(Any), payer:DeclaringPlayer, cost:$combat_payment_pays})] */
combat_attack_block_controller ::= "can't" "attack" "or" "block" "unless" "its" "controller" combat_payment_pays

combat_payment ::= combat_payment_fixed | combat_payment_repeated | combat_payment_counters

/* @sem Cost::Cost{parts:[Mana($mana_symbols)]} */
combat_payment_fixed ::= "pay" mana_symbols

/* @sem Cost::Cost{parts:[$cost_pay_for_each]} */
combat_payment_repeated ::= cost_pay_for_each

/* @sem Cost::Cost{parts:[Repeated{part:Mana($mana_symbols), times:CountCounters(_{recipients:Objects(One($object_ref)), kind:$counter_kind, information:CurrentOrLastKnown})}]} */
combat_payment_counters ::= "pay" mana_symbols "for" "each" counter_kind "counter" "on" object_ref

/* @sem Cost::Cost{parts:[Repeated{part:Mana($mana_symbols), times:$count_each}]} */
combat_payment_pays ::= "pays" mana_symbols "for" "each" count_each

/* The attacking companion's population is independent of the subject. */
/* @sem Change::[Rule(CombatGroup{role:Attacker, participants:$attack_companion, others_only:true, comparison:Greater, amount:Constant(0)})] */
attack_group_also_rule ::= "can't" "attack" "unless" "a" attack_companion "also" "attacks"

attack_companion ::= filter_phrase | attack_companion_greater

/* @sem @and($filter_phrase, ObjectFilter::Property{property:Power, test:NumberTest::Compare{comparison:Greater, value:ObjectProperty{object:Source, property:Power, information:CurrentOrLastKnown}}}) */
attack_companion_greater ::= filter_phrase "with" "greater" "power"

/* The payment sentence repeats this specific defended population. */
/* @sem Change::[Rule(CombatCost{action:Attack(Objects($planeswalker_controlled_filter)), payer:DeclaringPlayer, cost:$attack_planeswalker_only_payment})] */
attack_planeswalker_only_cost_rule ::= "can't" "attack" planeswalker_controlled_filter "unless" "their" "controller" "pays" attack_planeswalker_only_payment

/* @sem ObjectFilter::AllOf([CardType(Planeswalker), ControlledBy(One(AbilityController))]) */
planeswalker_controlled_filter ::= "planeswalkers" "you" "control"

/* @sem $cost */
attack_planeswalker_only_payment ::= cost "for" "each" "creature" "they" "control" "that's" "attacking" "a" "planeswalker" "you" "control"

/* @prefer always */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_ref)}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters{kind:$counter_kind, amount:$value_greatest_exile_mana}}}]}}) */
replacement_enters_exile_counters ::= self_ref "enters" "with" "a" "number" "of" counter_kind "counters" "on" "it" "equal" "to" value_greatest_exile_mana "."

/* Keep the named object and plural population inside their shared turn window. */
/* @sem Ability::Conditional{condition:$window_your_turn, then:[Static(_{kind:Ordinary, affected:Objects($objects_ref_and_plural), changes:$static_changes})]} */
static_during_your_turn_coordinated ::= window_your_turn "," objects_ref_and_plural static_changes "."

/* The singular subject has every creature type. */
/* @sem Vec<Change>::@defining_changes([CreatureTypes{mode:Set, types:All}]) */
change_every_creature_type_singular ::= "is" "every" "creature" "type"

/* The defender remains an independent player operand of the battlefield population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, $attacking_defender_you])} */
affected_all_attacking_defender ::= "all" filter_plural attacking_defender_you

/* @sem Operand::List([Term{family:CheckHasable, form:TriggeredAbility}]) */
copied_triggered_kinds ::= "triggered"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController)), Not(SharesNameWithAny($affected))])} */
ability_origin_controlled_different_name ::= filter_plural "you" "control" "that" "don't" "have" "the" "same" "name" "as" affected

/* A singular distributive subject keeps its parity predicate and population
   together so a static grant prints the subject's current filter. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:SameParity, value:ChosenParity}}])} */
chosen_parity_each_subject ::= "each" filter_phrase "with" "mana" "value" "of" "the" "chosen" "quality"

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($chosen_parity_each_subject), changes:$grants}) */
static_each_parity_has ::= chosen_parity_each_subject "has" grants "."

/* Type replacement and the granted activation compose within the affected holder's scope. */
/* @sem Change::[...$singular_artifact_type_change, RemoveAllAbilities, $comma_quoted_activation] */
change_set_artifact_with_activation ::= "is" "a" singular_artifact_type_change "with" comma_quoted_activation "and" "it" "loses" "all" "other" "abilities"

/* @sem Change::[SetArtifactType($singular_artifact_type), SetCardTypes([Artifact])] */
singular_artifact_type_change ::= singular_artifact_type "artifact"

singular_artifact_type ::= singular_treasure_type | singular_food_type | singular_clue_type

/* @sem ArtifactType::Treasure */
singular_treasure_type ::= "Treasure"

/* @sem ArtifactType::Food */
singular_food_type ::= "Food"

/* @sem ArtifactType::Clue */
singular_clue_type ::= "Clue"

/* @sem Change::GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program})) */
comma_quoted_activation ::= '"' cost ":" program "," '"'

/* A card at a named end of a zone receives the mechanic as its own ability;
   Source in its cost therefore belongs to that card. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($ordered_grant_card), changes:[GrantAbility(@holder($ordered_granted_mechanic))]} */
static_ordered_card_mechanic ::= ordered_grant_card "has" ordered_granted_mechanic "."

/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:$ordered_zone, players:One($player_possessive)}, kind:Card, filter:Any}, count:Constant(1), from:$ordered_end} */
ordered_grant_card ::= "the" ordered_end "card" "of" player_possessive ordered_zone

ordered_granted_mechanic ::= granted_mechanic | granted_plot_mana_cost

/* @sem Ability::Mechanic{mechanic:Plot, cost:Cost{parts:[ManaCostOf(Source)]}} */
granted_plot_mana_cost ::= "plot" "." "the" "plot" "cost" "is" "equal" "to" "its" "mana" "cost"

/* The pronoun counts attacks of each affected object, independently. */
/* @sem Expr::EventHistory{event:Object{event:Attacks, objects:SameObject(Affected)}, window:ThisTurn, measure:Occurrences} */
affected_attack_occurrences ::= "time" "it" "has" "attacked" "this" "turn"

/* @sem Change::[Pump{power:@times($signed, $affected_attack_occurrences), toughness:@times($signed_2, $affected_attack_occurrences)}] */
change_pump_each_affected_attack ::= "gets" signed "/" signed "for" "each" affected_attack_occurrences

/* The named object is included independently of the other controlled population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($object_ref), AllOf([Not(SameObject($object_ref)), $filter_plural, ControlledBy(One(AbilityController))])])} */
named_and_other_controlled_population ::= object_ref "and" "other" filter_plural "you" "control"

/* @sem Change::PlayerRule(Visibility{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, audience:AffectedPlayer}) */
top_private_visibility ::= "the" "top" "card" "of" "your" "library"

/* Library visibility applies separately to each affected player's own library. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players($hands_revealed_players), changes:[PlayerRule(Visibility{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, audience:Everyone})]}) */
static_players_top_revealed ::= hands_revealed_players "play" "with" "the" "top" "card" "of" "their" "libraries" "revealed" "."

/* Two visible populations share the same viewer and timing. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[$top_private_visibility, PlayerRule($face_down_visibility)]}) */
static_top_and_face_down_visibility ::= "you" "may" "look" "at" top_private_visibility "and" "at" face_down_visibility "any" "time" "."

/* @sem PlayerRule::Visibility{objects:$affected, audience:AffectedPlayer} */
face_down_visibility ::= "face-down" affected

/* Once-per-turn permissions share a singular spell filter and library location. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[$top_once_cast_change]}) */
static_top_once_cast ::= "once" "each" "turn" "," "you" "may" top_once_cast_change "."

/* @sem Change::PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, from:Library, action:CastSpell, filter:$top_singular_spell_filter}, terms:_{limit:EachTurn(1), cost:Normal}}) */
top_once_cast_change ::= "cast" top_singular_spell_filter "from" "the" "top" "of" "your" "library"

top_singular_spell_filter ::= top_singular_power_spell | top_singular_instant_sorcery_spell

/* @sem ObjectFilter::AllOf([$filter_phrase, Property{property:Power, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}]) */
top_singular_power_spell ::= "a" filter_phrase "spell" "with" "power" value "or" "less"

/* @sem ObjectFilter::AnyOf([CardType(Instant), CardType(Sorcery)]) */
top_singular_instant_sorcery_spell ::= "an" "instant" "or" "sorcery" "spell"

/* Consequences are paired with the spell population they actually describe. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[$top_cast_consequence_change]}) */
static_top_cast_consequence ::= "you" "may" top_cast_consequence_change "."

top_cast_consequence_change ::= top_cast_flash_change | top_cast_keyword_change

/* @sem Change::PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, from:Library, action:CastSpell, filter:$top_nontype_spells}, terms:$top_cast_flash_terms}) */
top_cast_flash_change ::= "cast" top_nontype_spells "from" "the" "top" "of" "your" "library" "." top_cast_flash_terms

/* @sem Change::PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, from:Library, action:CastSpell, filter:$top_creature_power_spells}, terms:$top_cast_keyword_terms}) */
top_cast_keyword_change ::= "cast" top_creature_power_spells "from" "the" "top" "of" "your" "library" "." top_cast_keyword_terms

/* @sem $adjective_nontype */
top_nontype_spells ::= adjective_nontype "spells"

/* @sem ObjectFilter::AllOf([CardType(Creature), Property{property:Power, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}]) */
top_creature_power_spells ::= "creature" "spells" "with" "power" value "or" "greater"

/* @sem PlayTerms::PlayTerms{cost:Normal, flash:true} */
top_cast_flash_terms ::= "if" "you" "cast" "a" "spell" "this" "way" "," "you" "may" "cast" "it" "as" "though" "it" "had" "flash"

/* @sem PlayTerms::PlayTerms{cost:Normal, effects:[List([Term{family:SpellEffect, form:AddAbilityUntil, operands:[Ability(Keyword($keyword_value)), Duration(EndOfTurn)]}])]} */
top_cast_keyword_terms ::= "if" "you" "cast" "a" "creature" "spell" "this" "way" "," "it" "gains" keyword_value "until" "end" "of" "turn"

static_state_condition ::= condition | condition_opponent_controls_an

/* Both clauses describe the named scalar subject; the second changes replace
   the first when the type test holds. Each bonus retains its own operands. */
/* @sem Ability::Conditional{condition:ObjectMatches{object:$scalar_static_subject, filter:$scalar_otherwise_kind}, then:[Static{kind:Ordinary, affected:Objects(One($scalar_static_subject)), changes:$scalar_singular_bonus_2}], otherwise:[Static{kind:Ordinary, affected:Objects(One($scalar_static_subject)), changes:$scalar_singular_bonus}]} */
scalar_static_alternative ::= scalar_static_subject scalar_singular_bonus "." "if" "it's" scalar_otherwise_kind "," "it" scalar_singular_bonus "instead" "."

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}] */
scalar_singular_bonus ::= "gets" signed "/" signed

/* A turn condition wraps the shared static change and its scoped activation. */
/* @sem Ability::Conditional{condition:$static_turn_window, then:[$static_additive_quoted_activation]} */
static_turn_additive_quoted_activation ::= static_turn_window "," static_additive_quoted_activation

/* A source's retained creature characteristics apply in every nonbattlefield zone. */
/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Creature)] */
retained_typed_base_description ::= "a" value "/" value becomes_types "creature" "in" "addition" "to" "its" "other" "types"

/* @sem Ability::Scoped{zones:[Hand, Library, Graveyard, Exile, Stack, Command], ability:Static(_{kind:Ordinary, affected:Objects(AnyZone(SameObject($self_explicit_ref))), changes:$retained_typed_base_description})} */
source_off_battlefield_retained_creature ::= "as" "long" "as" self_explicit_ref "isn't" "on" "the" "battlefield" "," "it's" retained_typed_base_description "."

/* The excluded origin belongs to the candidate spell's caster. */
/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:NthCast{ordinal:Constant(1), spells:$ordinal_cast_excluded_origin, by:One(AbilityController), scope:Turn}} */
ordinal_cast_origin_exception ::= "the" "first" "spell" "you" "cast" ordinal_cast_excluded_origin "each" "turn"

/* @sem ObjectFilter::Not(Cast{from:Players{zone:$ordinal_cast_private_zone, players:One(CasterOf(Candidate))}}) */
ordinal_cast_excluded_origin ::= "from" "anywhere" "other" "than" "your" ordinal_cast_private_zone

ordinal_cast_private_zone ::= ordinal_cast_hand | ordinal_cast_graveyard

/* @sem ZoneName::Hand */
ordinal_cast_hand ::= "hand"

/* @sem ZoneName::Graveyard */
ordinal_cast_graveyard ::= "graveyard"

/* Player rules compose with their stated temporal condition. */
/* @sem Ability::Conditional{condition:$static_turn_window, then:[$static_spells_cost_less]} */
shared_turn_spell_cost ::= static_turn_window "," static_spells_cost_less

/* @sem Ability::Conditional{condition:$shared_player_window, then:[$player_rule_ability]} */
shared_player_rule_window_suffix ::= player_rule_ability shared_player_window "."

shared_player_window ::= window_your_turn | shared_combat_window
/* @sem Condition::Window(Combat) */
shared_combat_window ::= "during" "combat"

/* @sem Ability::Conditional{condition:$window_your_turn, then:[$shared_cast_activation_rule]} */
shared_turn_cast_activation_rule ::= window_your_turn "," shared_cast_activation_rule "."

/* @sem Ability::Static{kind:Ordinary, affected:Players($player_rule_subject), changes:[PlayerRule(Prohibit(CastSpell{filter:Any})), PlayerRule(Prohibit(Activate(Of($shared_three_filters))))]} */
shared_cast_activation_rule ::= player_rule_subject "can't" "cast" "spells" "or" "activate" "abilities" "of" shared_three_filters

/* @sem ObjectFilter::AnyOf([$filter_plural, $filter_plural_2, $filter_plural_3]) */
shared_three_filters ::= filter_plural "," filter_plural "," "or" filter_plural

/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(DamageDoesNotCauseLifeLoss)]} */
shared_damage_no_life_loss ::= "damage" "doesn't" "cause" "you" "to" "lose" "life" "."

/* Both mentions must denote the same floor for the inverse as well. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(DamageLifeFloor(@agree($value, $value_2)))]} */
shared_damage_life_floor ::= "damage" "that" "would" "reduce" "your" "life" "total" "to" "less" "than" value "reduces" "it" "to" value "instead" "."

/* A comma-separated spell-type union composes with either caster and cost change. */
/* @sem ObjectFilter::AnyOf([...$spell_adjective_commas, $spell_adjective]) */
cast_adjective_list_spells ::= spell_adjective_commas "and" spell_adjective "spells"

/* The cost and the kind of ability remain independent. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(All), changes:[PlayerRule(ActivationCost{abilities:AllOf([OnStack($shared_activation_kind), AbilityOf(AllOf([Not(SameObject(Source)), Any, $filter_plural]))]), change:Reduce($generic_reduction_symbols)})]} */
static_other_kind_activation_cost ::= shared_activation_kind "abilities" "of" "other" filter_plural "cost" generic_reduction_symbols "less" "to" "activate" "."

/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(ActivationCost{abilities:AllOf([OnStack($shared_activation_kind), AbilityOf(AllOf([Not(SameObject(Source)), $filter_phrase]))]), change:Reduce($generic_reduction_symbols)})]} */
static_you_other_kind_activation_cost ::= shared_activation_kind "abilities" "you" "activate" "of" "other" filter_phrase "cost" generic_reduction_symbols "less" "to" "activate" "."

/* @sem StackTrait::Keyword(Equip) */
shared_equip_kind ::= "equip"

/* @sem StackTrait::Keyword(Exhaust) */
shared_exhaust_kind ::= "exhaust"

/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(ActivationCost{abilities:OnStack($shared_activation_kind), change:Reduce($single_generic_reduction)})]} */
static_you_kind_cost_reduction ::= shared_activation_kind "costs" "you" "pay" "cost" single_generic_reduction "less" "."

/* @sem Operand::Term{family:CostReductionSymbol, form:CostReduceGeneric, operands:[Integer($number)]} */
single_generic_reduction ::= "{" NUMBER "}"

/* @sem Ability::Static{kind:Ordinary, affected:Players(One(EnchantedBy(Source))), changes:[PlayerRule(Prohibit(Activate($activation_exceptions))) ]} */
static_enchanted_player_activation_ban ::= "enchanted" "player" "can't" "activate" "abilities" "that" activation_exceptions "."

/* @sem ActivationFilter::All([Not(Mana), Not(Is(Loyalty))]) */
activation_exceptions ::= "aren't" "mana" "abilities" "or" "loyalty" "abilities"

/* Shared card types constrain the cast spell independently of its cost. */
/* @sem ObjectFilter::Shares{property:CardTypes, with:$linked_exiled_card} */
spell_cost_shared_card_type ::= "that" "share" "a" "card" "type" "with" linked_exiled_card

/* Each affected player keeps their own linked exile population. */
/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledBy{player:Affected, with:$object_ref}}) */
affected_linked_exile_cards ::= "cards" "they" "exiled" "with" object_ref

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledBy{player:Affected, with:$object_ref, this_turn:true}}) */
affected_linked_exile_cards_turn ::= "cards" "they" "exiled" "with" object_ref "this" "turn"

/* @sem Ability::Static(_{kind:Ordinary, affected:Players($players_singular), changes:[PlayerRule(Visibility{objects:$affected_linked_exile_cards, audience:AffectedPlayer}), PlayerRule(PlayPermission{cards:$affected_linked_exile_cards, from:Exile, action:PlayLand, filter:Any}), PlayerRule(PlayPermission{cards:$affected_linked_exile_cards, from:Exile, action:CastSpell, filter:Any})]}) */
linked_exile_visibility_permission ::= players_singular "may" "look" "at" affected_linked_exile_cards "," "and" "they" "may" "play" "lands" "and" "cast" "spells" "from" "among" "those" "cards" "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Players($players_singular), changes:[PlayerRule(PlayPermission{cards:$affected_linked_exile_cards_turn, from:Exile, action:PlayLand, filter:Any}), PlayerRule(PlayPermission{cards:$affected_linked_exile_cards_turn, from:Exile, action:CastSpell, filter:Any})]}) */
linked_exile_turn_permission ::= players_singular "may" "play" "lands" "and" "cast" "spells" "from" "among" affected_linked_exile_cards_turn "."

/* A shared-value count is tied to the spell affected by this cost rule. */
/* @sem Expr::SharedValues{object:Affected, property:CardTypes, with:$permission_linked_exile_cards} */
cast_shared_card_type_count ::= "card" "type" "they" "share" "with" permission_linked_exile_cards

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$cast_spells_filter, modifier:Reduce{reductions:[_{amount:$cast_shared_card_type_count}], spill_into_generic:true}})]}) */
shared_card_type_cast_reduction ::= cast_spells_filter "you" "cast" "cost" "{" "1" "}" "less" "to" "cast" "for" "each" cast_shared_card_type_count "."

/* The source population remains independently printable from the copied kinds. */
/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}) */
ability_origin_exiled_linked ::= "all" "cards" "exiled" "with" object_ref

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_phrase, ExiledWith($object_ref)])}) */
ability_origin_exiled_filtered ::= "all" filter_phrase "cards" "exiled" "with" object_ref

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})}) */
ability_origin_exiled_counters ::= "all" "cards" "in" "exile" "with" counter_kind "counters" "on" "them"

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(One(AbilityController)), Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})])}) */
ability_origin_owned_exiled_counters ::= "all" "cards" "you" "own" "in" "exile" "with" counter_kind "counters" "on" "them"

/* @sem Change::[GainAbilitiesOf{objects:$ability_origin_set, kinds:$copied_ability_kinds, once_each_turn:true}] */
change_gained_limited ::= "has" "all" copied_ability_kinds "abilities" "of" ability_origin_set "." "you" "may" "activate" "each" "of" "those" "abilities" "only" "once" "each" "turn"

/* @sem Change::[GainAbilitiesOf{objects:$craft_ability_origin, kinds:$copied_activated_singular, once_each_turn:true}] */
change_gained_craft ::= "has" "each" copied_activated_singular "of" craft_ability_origin "." "you" "may" "activate" "each" "of" "those" "abilities" "only" "once" "each" "turn"

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}) */
craft_ability_origin ::= "the" "exiled" "cards" "used" "to" "craft" object_ref

/* @sem Operand::List([Term{family:CheckHasable, form:ActivatedAbility}]) */
copied_activated_singular ::= "activated" "ability"

/* @sem Change::[GainAbilitiesOf{objects:$shared_keyword_origin, kinds:$shared_keyword_kinds}] */
change_gained_shared_keywords ::= "has" "flying" "as" "long" "as" shared_keyword_origin "has" "flying" "." "the" "same" "is" "true" "for" shared_keyword_kinds

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}) */
shared_keyword_origin ::= "a" "card" "exiled" "with" object_ref

/* @sem Operand::List([Term{family:CheckHasable, form:Flying}, Term{family:CheckHasable, form:FirstStrike}, Term{family:CheckHasable, form:DoubleStrike}, Term{family:CheckHasable, form:Deathtouch}, Term{family:CheckHasable, form:Haste}, Term{family:CheckHasable, form:AnyHexproof}, Term{family:CheckHasable, form:Indestructible}, Term{family:CheckHasable, form:Lifelink}, Term{family:CheckHasable, form:Menace}, Term{family:CheckHasable, form:Reach}, Term{family:CheckHasable, form:Trample}, Term{family:CheckHasable, form:Vigilance}]) */
shared_keyword_kinds ::= "first" "strike" "," "double" "strike" "," "deathtouch" "," "haste" "," "hexproof" "," "indestructible" "," "lifelink" "," "menace" "," "reach" "," "trample" "," "and" "vigilance"

/* A list of abilities shared among the affected population. */
/* @sem Operand::Term{family:CheckHasable, form:Flying} */
sharing_flying ::= "flying"

/* @sem Operand::Term{family:CheckHasable, form:Fear} */
sharing_fear ::= "fear"

/* @sem Operand::Term{family:CheckHasable, form:FirstStrike} */
sharing_firststrike ::= "first" "strike"

/* @sem Operand::Term{family:CheckHasable, form:Deathtouch} */
sharing_deathtouch ::= "deathtouch"

/* @sem Operand::Term{family:CheckHasable, form:DoubleStrike} */
sharing_doublestrike ::= "double" "strike"

/* @sem Operand::Term{family:CheckHasable, form:Haste} */
sharing_haste ::= "haste"

/* @sem Operand::Term{family:CheckHasable, form:AnyHexproof} */
sharing_anyhexproof ::= "hexproof"

/* @sem Operand::Term{family:CheckHasable, form:Indestructible} */
sharing_indestructible ::= "indestructible"

/* @sem Operand::Term{family:CheckHasable, form:Lifelink} */
sharing_lifelink ::= "lifelink"

/* @sem Operand::Term{family:CheckHasable, form:Menace} */
sharing_menace ::= "menace"

/* @sem Operand::Term{family:CheckHasable, form:Reach} */
sharing_reach ::= "reach"

/* @sem Operand::Term{family:CheckHasable, form:Skulk} */
sharing_skulk ::= "skulk"

/* @sem Operand::Term{family:CheckHasable, form:Trample} */
sharing_trample ::= "trample"

/* @sem Operand::Term{family:CheckHasable, form:Vigilance} */
sharing_vigilance ::= "vigilance"

/* @sem Operand::Term{family:CheckHasable, form:AnyLandwalk} */
sharing_anylandwalk ::= "landwalk"

/* @sem Operand::Term{family:CheckHasable, form:AnyProtection} */
sharing_anyprotection ::= "protection"

sharing_kind ::= sharing_flying | sharing_fear | sharing_firststrike | sharing_deathtouch | sharing_doublestrike | sharing_haste | sharing_anyhexproof | sharing_indestructible | sharing_lifelink | sharing_menace | sharing_reach | sharing_skulk | sharing_trample | sharing_vigilance | sharing_anylandwalk | sharing_anyprotection

/* @sem Operand::[$sharing_kind] */
sharing_kind_last ::= "and" sharing_kind

/* @sem Operand::[$sharing_kind, ...$sharing_kind_tail] */
sharing_kind_more ::= sharing_kind "," sharing_kind_tail

sharing_kind_tail ::= sharing_kind_last | sharing_kind_more

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[GainAbilitiesOf{objects:$affected, kinds:List([Term{family:CheckHasable, form:Flying}, ...$sharing_kind_tail])}], duration:$duration, evaluation:Snapshot}}] */
share_flying ::= affected "gain" "flying" duration "if" "a" "creature" "you" "control" "has" "flying" "." "the" "same" "is" "true" "for" sharing_kind_tail

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[GainAbilitiesOf{objects:$affected, kinds:List([Term{family:CheckHasable, form:FirstStrike}, ...$sharing_kind_tail])}], duration:$duration, evaluation:Snapshot}}] */
share_firststrike ::= affected "gain" "first" "strike" duration "if" "a" "creature" "you" "control" "has" "first" "strike" "." "the" "same" "is" "true" "for" sharing_kind_tail

/* Replacement stat change gated by control of a named permanent. */
/* @sem Condition::Controls{player:AbilityController, filter:AllOf([$filter_phrase, Name($referenced_card_name)]), minimum:1} */
control_named_filter ::= "you" "control" "a" filter_phrase "named" referenced_card_name

/* @sem Instruction::[If{condition:$control_named_filter, then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$static_changes_2, duration:EndOfTurn, evaluation:Snapshot}}]}, otherwise:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($affected_2), changes:$static_changes, duration:EndOfTurn, evaluation:Snapshot}}]}}] */
conditional_stat_replacement ::= affected static_changes "until" "end" "of" "turn" "." affected static_changes "instead" "if" control_named_filter

/* An attachment condition can gate a complete player-facing static ability. */
/* @sem Ability::Conditional{condition:$attachment_condition, then:[$attachment_player_static]} */
attachment_conditional_player ::= "as" "long" "as" attachment_condition "," attachment_player_static

/* @sem Ability::$static_no_zero_life_loss */
attachment_player_static ::= static_no_zero_life_loss

/* The turn restriction is part of the condition on the prohibition. */
/* @sem Ability::Conditional{condition:AllOf([$attachment_condition, PlayerIsActive(AbilityController)]), then:[$opponent_cast_prohibition]} */
attachment_conditional_turn_prohibition ::= "as" "long" "as" attachment_condition "," opponent_cast_prohibition "during" "your" "turn" "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(OpponentsOf(AbilityController)), changes:[PlayerRule(Prohibit(CastSpell{filter:Any}))]}) */
opponent_cast_prohibition ::= "your" "opponents" "can't" "cast" "spells"

/* Keep the targeted population and the cost reduction independently editable. */
/* @sem Ability::Conditional{condition:PlayerIsActive(AbilityController), then:[Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(ActivationCost{abilities:$first_targeted_activation, change:Reduce($generic_reduction_symbols)})]})]} */
first_targeted_activation_reduction ::= first_targeted_activation "costs" generic_reduction_symbols "less" "to" "activate" "."

/* @sem ObjectFilter::NthCast{ordinal:$counter_amount, spells:TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase})), by:One(AbilityController), scope:Turn} */
first_targeted_activation ::= "the" "first" "activated" "ability" "you" "activate" "during" "your" "turn" "that" "targets" counter_amount filter_phrase

/* @sem Condition::ObjectMatches{object:$object_ref, filter:$modifier_attached_to_a} */
attachment_condition ::= object_ref "is" modifier_attached_to_a

/* Graveyard permissions compose a play arm and a cast arm, keeping their filters independent. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:$graveyard_permissions}) */
static_graveyard_permissions ::= "you" "may" graveyard_permissions "from" "your" "graveyard" "."

graveyard_permissions ::= graveyard_cast_permission | graveyard_permission_pair

/* @sem Change::[...$graveyard_play_permission, ...$graveyard_cast_permission] */
graveyard_permission_pair ::= graveyard_play_permission "and" graveyard_cast_permission

/* @sem Change::[PlayerRule(PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:AllOf([$filter_plural, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), from:Graveyard, action:PlayLand, filter:Any})] */
graveyard_play_permission ::= "play" filter_plural

/* @sem Change::[PlayerRule(PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:$graveyard_spell_filter})] */
graveyard_cast_permission ::= "cast" graveyard_spell_filter

graveyard_spell_filter ::= cast_any_spells | graveyard_subtype_spells | spells_having_activated_ability

/* @sem $cycling_ability_filter */
spells_having_activated_ability ::= "spells" "that" "have" "a" cycling_ability_filter

/* @sem ObjectFilter::HasActivatedAbility(Cycling) */
cycling_ability_filter ::= "cycling" "ability"

/* @sem $subtype */
graveyard_subtype_spells ::= subtype "spells"

/* A turn gate composes with the singular graveyard-card grant. */
/* @sem Ability::Conditional{condition:PlayerIsActive(AbilityController), then:[$turn_graveyard_card_grant], otherwise:[]} */
static_graveyard_card_grant_during_turn ::= "during" "your" "turn" "," turn_graveyard_card_grant

turn_graveyard_card_grant ::= static_graveyard_card_grant_qualified_flashback | static_graveyard_card_grant_union_flashback | static_graveyard_card_grant

/* @prefer always */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$graveyard_grant_qualified_union}), changes:[GrantAbility(@holder($graveyard_flashback_that))]} */
static_graveyard_card_grant_qualified_flashback ::= "each" graveyard_grant_qualified_union "card" "in" "your" "graveyard" "has" graveyard_flashback_that "."

/* @prefer always */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$card_filter_and}), changes:[GrantAbility(@holder($graveyard_flashback_its))]} */
static_graveyard_card_grant_union_flashback ::= "each" card_filter_and "card" "in" "your" "graveyard" "has" graveyard_flashback_its "."

/* @sem Ability::Casting(Permission{origin:Flashback, player:OwnerOf(Source), from:Players{zone:Graveyard, players:One(OwnerOf(Source))}, require:AnyOf([CardType(Instant), CardType(Sorcery)]), cost:$graveyard_flashback_that_cost, leave_stack:Exile}) */
graveyard_flashback_that ::= "flashback" graveyard_flashback_that_cost

/* @sem Ability::Casting(Permission{origin:Flashback, player:OwnerOf(Source), from:Players{zone:Graveyard, players:One(OwnerOf(Source))}, require:AnyOf([CardType(Instant), CardType(Sorcery)]), cost:$graveyard_flashback_its_cost, leave_stack:Exile}) */
graveyard_flashback_its ::= "flashback" graveyard_flashback_its_cost

/* The adjective qualifies the whole union of card types. */
/* @sem ObjectFilter::AllOf([$quality, $card_filter_and]) */
graveyard_grant_qualified_union ::= quality card_filter_and

/* Flashback belongs to each receiving card and uses its owner. */
/* @sem Ability::Casting(Permission{origin:Flashback, player:OwnerOf(Source), from:Players{zone:Graveyard, players:One(OwnerOf(Source))}, require:AnyOf([CardType(Instant), CardType(Sorcery)]), cost:$graveyard_flashback_cost, leave_stack:Exile}) */
graveyard_flashback ::= "flashback" graveyard_flashback_cost

graveyard_flashback_cost ::= cost | graveyard_flashback_its_cost | graveyard_flashback_that_cost

/* @sem Cost::Cost{parts:[ManaCostOf(Source)]} */
graveyard_flashback_its_cost ::= "." "its" "flashback" "cost" "is" "equal" "to" "its" "mana" "cost"

/* @sem Cost::Cost{parts:[ManaCostOf(Source)]} */
graveyard_flashback_that_cost ::= "." "the" "flashback" "cost" "is" "equal" "to" "that" "card's" "mana" "cost"

/* Leading duration applies to the copy and its copiable exceptions. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@copy_subject(ObjectSet::$affected, ObjectRef::$target_permanent)), changes:[CopyOf{object:$target_permanent, exceptions:$copy_leading_stats_and_current}], duration:$duration, evaluation:Snapshot} */
copy_leading_duration_except ::= duration "," affected "becomes" "a" "copy" "of" target_permanent "," "except" copy_leading_stats_and_current

/* The attacked permanent and the subject's controller are independent roles. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($target_up_to_one)), changes:[Rule(RequireCombat{action:Attack(Objects(SameObject($self_ref))), amount:AtLeast(Constant(1))})], duration:DuringNextTurn(ControllerOf($target_up_to_one)), evaluation:LiveObjects} */
required_target_attack_source ::= target_up_to_one "attacks" self_ref "during" "its" "controller's" "next" "turn" "if" "able"

/* A snapshot ability removal and live combat restrictions share one duration. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_another)), changes:[RemoveAllAbilities], duration:WhileMatches{object:$self_ref, filter:Tapped}, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_another)), changes:[Rule(Prohibit(Attack(Any))), Rule(Prohibit(Block(Any)))], duration:WhileMatches{object:$self_ref, filter:Tapped}, evaluation:LiveObjects}}] */
clause_tapped_remove_combat ::= "for" "as" "long" "as" self_ref "remains" "tapped" "," target_another "loses" "all" "abilities" "and" "can't" "attack" "or" "block"

/* @sem CopyException::[$copy_fixed_stats, $copy_has_current] */
copy_leading_stats_and_current ::= copy_fixed_stats "and" copy_has_current

/* Cost changes on a filtered population of spells on the stack. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(Zone(_{scope:Shared(Stack), kind:Spell, filter:$spell_cost_object_subject})), changes:[SpellCost($spell_cost_change)]}) */
static_spell_object_cost ::= spell_cost_object_subject "cost" spell_cost_change "to" "cast" "."

spell_cost_object_subject ::= spell_cost_filter_pair | modified_spells_you_cast

/* @sem ObjectFilter::AnyOf([$filter_phrase, $filter_phrase_2]) */
spell_cost_filter_pair ::= filter_phrase "spells" "and" filter_phrase "spells"

/* @sem @and($cast_modified_spells, ObjectFilter::Cast{by:One(AbilityController)}) */
modified_spells_you_cast ::= cast_modified_spells "you" "cast"

/* @sem Change::[CreatureTypes{mode:Add, types:Listed($cross_creature_types)}] */
static_are_retained_types ::= "are" cross_creature_types "in" "addition" "to" "their" "other" "types"

/* @sem Change::[...$static_plural_base_stats, ...$static_are_retained_types] */
static_base_and_retained_types ::= static_plural_base_stats "and" static_are_retained_types

/* @sem Change::[...$static_plural_base_stats, GrantKeyword($keyword_value), ...$static_are_retained_types] */
static_base_grant_and_retained_types ::= static_plural_base_stats "," "have" keyword_value "," "and" static_are_retained_types

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}] */
static_plural_base_stats ::= "have" "base" "power" "and" "toughness" value "/" value

/* A controlled union of other subtypes receives a single stat change. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), AllOf([$plural_subtype_list, ControlledBy(One(AbilityController))])])}), changes:[Pump{power:$signed, toughness:$signed_2}]} */
static_other_controlled_subtype_list_pump ::= "other" plural_subtype_list "you" "control" "get" signed "/" signed "."

/* The folded lexical spelling is scoped to this controlled population. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun_zombie_folded, $plural, ControlledBy(One(AbilityController))])}), changes:[Pump{power:$signed, toughness:$signed_2}]} */
static_controlled_zombie_population_pump ::= noun_zombie_folded plural "you" "control" "get" signed "/" signed "."

/* @sem Change::[GainAbilitiesOf{objects:$ability_origin_set, kinds:$copied_ability_kinds}] */
change_gained_abilities_plural ::= "have" "all" copied_ability_kinds "abilities" "of" ability_origin_set

/* @sem Change::[GainAbilitiesOf{objects:$craft_trait_origin, kinds:$craft_shared_traits}] */
change_gained_craft_traits ::= "has" "flying" "as" "long" "as" craft_trait_origin craft_shared_traits

/* @sem Operand::List([Term{family:CheckHasable, form:Flying}, Term{family:CheckHasable, form:FirstStrike}, Term{family:CheckHasable, form:DoubleStrike}, Term{family:CheckHasable, form:Deathtouch}, Term{family:CheckHasable, form:Haste}, Term{family:CheckHasable, form:AnyHexproof}, Term{family:CheckHasable, form:Indestructible}, Term{family:CheckHasable, form:Lifelink}, Term{family:CheckHasable, form:Menace}, Term{family:CheckHasable, form:AnyProtection}, Term{family:CheckHasable, form:Reach}, Term{family:CheckHasable, form:Trample}, Term{family:CheckHasable, form:Vigilance}]) */
craft_shared_traits ::= "has" "flying" "." "the" "same" "is" "true" "for" "first" "strike" "," "double" "strike" "," "deathtouch" "," "haste" "," "hexproof" "," "indestructible" "," "lifelink" "," "menace" "," "protection" "," "reach" "," "trample" "," "and" "vigilance"

/* Per-object kind tests restrict each member of a live static population. */
/* @sem ObjectFilter::$filter_phrase */
static_kind_as_long_as_a ::= "as" "long" "as" "it's" "a" filter_phrase

/* @sem ObjectFilter::$filter_phrase */
static_kind_as_long_as_an ::= "as" "long" "as" "it's" "an" filter_phrase

/* @sem ObjectFilter::CardType(Creature) */
static_kind_as_long_as_creature ::= "as" "long" "as" "it's" "a" "creature"

static_kind_as_long_as ::= static_kind_as_long_as_creature | static_kind_as_long_as_a | static_kind_as_long_as_an

/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, $static_kind_as_long_as])}), changes:$static_singular_pump} */
static_each_qualified_pump ::= "each" filter_phrase static_singular_pump static_kind_as_long_as "."

/* @sem Ability::Conditional{condition:ObjectMatches{object:$scalar_static_subject, filter:$static_kind_as_long_as}, then:[Static{kind:Ordinary, affected:Objects(One($scalar_static_subject)), changes:$static_singular_pump}], otherwise:[]} */
scalar_subject_static_kind ::= scalar_static_subject static_singular_pump static_kind_as_long_as "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, $modifier_attacked_controllers_last_turn])}), changes:$static_changes}) */
static_attacked_population ::= filter_plural modifier_attacked_controllers_last_turn static_changes "."

/* Reductions for a controller's keyword activations keep the payer distinct. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(ActivationCost{abilities:OnStack(Keyword(Equip)), change:Reduce(Term{family:CostReductionSymbol, form:CostReduceGeneric, operands:[Integer($number)]})})]}) */
static_you_activate_equip_reduction ::= "equip" "abilities" "you" "activate" "cost" "{" NUMBER "}" "less" "to" "activate" "."

/* An animated land retains land type and grants a definition to its new holder. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($animated_controlled_land)), changes:[AddCardType(Creature), GrantKeyword($keyword_name), GrantAbility(Static(_{kind:Ordinary, affected:Objects(One(Source)), changes:[SetPower($value), SetToughness($value)]}))], duration:Indefinite, evaluation:Snapshot} */
animate_land_with_definition ::= animated_controlled_land "becomes" "a" "creature" "with" keyword_name "and" '"' "this" "creature's" "power" "and" "toughness" "are" "each" "equal" "to" value "." '"' "it's" "still" "a" "land"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Land), ControlledBy(One(AbilityController))])}), index:0} */
animated_controlled_land ::= "target" "land" "you" "control"

/* The attacker is the trigger subject, not the newly announced blocker. */
/* @sem Ability::Triggered{event:$event_attacks, limits:_{}, body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Rule(RequireCombat{action:Block(SameObject(@event_subject)), amount:AtLeast(Constant(1))})], duration:EndOfCombat, evaluation:LiveObjects}}]}, announcement:@announcement} */
triggered_attacker_block_requirement ::= "whenever" event_attacks "," affected "blocks" "it" "this" "combat" "if" "able" "."

/* A linked card supplies one shared characteristic for both base stats. */
/* @sem Change::[SetBasePowerToughness{power:ObjectProperty{object:$linked_exiled_card_possessive, property:$receipt_stat, information:CurrentOrLastKnown}, toughness:ObjectProperty{object:$linked_exiled_card_possessive, property:$receipt_stat, information:CurrentOrLastKnown}}] */
change_linked_card_equal_stats ::= "'s" "power" "and" "toughness" "are" "each" "equal" "to" linked_exiled_card_possessive receipt_stat

/* @sem Ability::Conditional{condition:$condition_linked_exile_threshold, then:[Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes})]} */
static_linked_exile_threshold ::= "as" "long" "as" condition_linked_exile_threshold "," affected static_changes "."

/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_ref)}, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$entry_counter_amount})}}]}}) */
replacement_enters_counter_one ::= self_ref "enters" "with" entry_counter_amount counter_kind "counter" "on" "it"

/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_ref)}, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$entry_counter_amount})}}]}}) */
replacement_enters_counters_many ::= self_ref "enters" "with" entry_counter_amount counter_kind "counters" "on" "it"

/* Both branches and the anaphoric counter test refer to the singular subject. */
/* @sem Ability::Conditional{condition:ObjectMatches{object:$scalar_explicit_subject, filter:$scalar_counter_test}, then:[Static{kind:Ordinary, affected:Objects(One($scalar_explicit_subject)), changes:$static_changes}], otherwise:[Static{kind:Ordinary, affected:Objects(One($scalar_explicit_subject)), changes:$static_changes_2}]} */
scalar_counter_static_otherwise ::= scalar_explicit_subject static_changes "as" "long" "as" "it" scalar_counter_test "." "otherwise" "," "it" static_changes "."

scalar_explicit_subject ::= self_explicit_ref | attached_ref

/* A controlled incoming object retains both its token restriction and cast origin. */
/* @sem ObjectFilter::AllOf([Not(Token), $filter_phrase, ControlledBy(One(AbilityController)), Not(Cast{from:Players{zone:Hand, players:One(AbilityController)}})]) */
entry_each_controlled_not_hand_cast ::= "each" "nontoken" filter_phrase "you" "control" "that" "wasn't" "cast" "from" "your" "hand"

/* Singular entry subjects and their modifications compose independently. */
/* @sem Ability::Replacement{active:Battlefield, event:$singular_entry_event, body:_{instructions:[Effect{result:@next, operation:$singular_entry_change}]}} */
singular_entry_replacement ::= singular_entry_event singular_entry_change "."

/* @sem ReplacementEvent::Enter{objects:$entry_each_objects} */
singular_entry_event ::= entry_each_objects "enters"

singular_entry_change ::= singular_entry_additional_one | singular_entry_additional_many

/* @sem Operation::ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$counter_amount})} */
singular_entry_additional_one ::= "with" counter_amount "additional" counter_kind "counter" "on" "it"

/* @sem Operation::ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$value})} */
singular_entry_additional_many ::= "with" value "additional" counter_kind "counters" "on" "it"

/* Turn and condition modifiers compose with player permissions. */
/* @sem Ability::Conditional{condition:AllOf([PlayerIsActive(AbilityController), $condition]), then:[$player_exhaust_permission]} */
turn_conditional_player_permission ::= "during" "your" "turn" "," "as" "long" "as" condition "," player_exhaust_permission

/* @sem Ability::Conditional{condition:$condition, then:[$player_exhaust_permission]} */
conditional_player_permission ::= "as" "long" "as" condition "," player_exhaust_permission

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(ActivationGrant{abilities:OnStack(Keyword(Exhaust)), grant:AsThoughNotActivated})]}) */
player_exhaust_permission ::= "you" "may" "activate" "exhaust" "abilities" "as" "though" "they" "haven't" "been" "activated" "."

/* Temporary permissions compose player rules with their duration. */
temporary_graveyard_permission ::= temporary_graveyard_permission_first | temporary_graveyard_permission_last | temporary_graveyard_permission_comma | temporary_graveyard_adventure

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:$graveyard_play_changes, duration:$duration, evaluation:LiveObjects} */
temporary_graveyard_permission_first ::= duration "," "you" "may" graveyard_play_changes

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:$graveyard_cast_changes, duration:$this_duration, evaluation:LiveObjects} */
temporary_graveyard_permission_last ::= "you" "may" graveyard_cast_changes this_duration

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:$graveyard_cast_changes, duration:$this_duration, evaluation:LiveObjects} */
temporary_graveyard_permission_comma ::= "you" "may" graveyard_cast_changes this_duration ","

/* @sem Change::[PlayerRule(PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:$filter_plural}), from:Graveyard, action:PlayLand, filter:Any}), ...$graveyard_cast_changes] */
graveyard_play_changes ::= "play" filter_plural "and" graveyard_cast_changes

graveyard_cast_changes ::= graveyard_cast_all_changes | graveyard_cast_filtered_changes

/* @sem Change::[PlayerRule(PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:Any})] */
graveyard_cast_all_changes ::= "cast" "spells" "from" "your" "graveyard"

/* @sem Change::[PlayerRule(PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:$filter_phrase})] */
graveyard_cast_filtered_changes ::= "cast" filter_phrase "spells" "from" "your" "graveyard"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$cast_permission_cards, from:Graveyard, action:CastSpell, filter:Any}, terms:$adventure_cast_terms})], duration:$duration, evaluation:LiveObjects} */
temporary_graveyard_adventure ::= cast_permission_cards "from" "your" "graveyard" adventure_cast_terms duration

/* @sem PlayTerms::PlayTerms{cost:Using(Adventure)} */
adventure_cast_terms ::= "as" "an" "Adventure"

/* The cast origin and cost modifier retain independent operands. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$cast_origin_one, modifier:$spell_cost_less})], duration:$this_duration, evaluation:LiveObjects} */
temporary_graveyard_cost ::= "spells" "you" "cast" cast_origin_one this_duration "cost" spell_cost_less "to" "cast"

/* The copied ability source population is independent of the recipient. */
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$filter_phrase} */
ability_origin_all_graveyards ::= "all" filter_phrase "cards" "in" "all" "graveyards"

/* A singular antecedent in the condition can be the affected object. */
/* @prefer always */
/* @sem Ability::Conditional{condition:$condition_object_on_battlefield, then:[Static{kind:Ordinary, affected:Objects(One($it_ordinary_pronoun)), changes:$static_changes}]} */
static_conditional_first_it ::= "as" "long" "as" condition_object_on_battlefield "," it_ordinary_pronoun static_changes "."

enchant_composed_host ::= enchant_graveyard_cards | enchant_host_with_another_attachment

/* @sem Ability::Enchant{hosts:$enchant_composed_host} */
enchant_composed_hosts ::= "enchant" enchant_composed_host

/* Land type removal and ability removal are separate ordered changes. */
/* @sem Change::[RemoveAllLandTypes, RemoveAllAbilities] */
change_loses_land_types_and_abilities ::= "loses" "all" "land" "types" "and" "abilities"

/* The first quoted activation is open; the last closes the sentence. */
/* @sem Change::GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program})) */
shared_granted_activation_open ::= '"' cost ":" program '"'

/* @sem Change::[$shared_granted_activation_open, $shared_granted_activation_closed] */
closed_activation_pair ::= shared_granted_activation_open "and" shared_granted_activation_closed

/* A singular subject loses its creature card type while this change applies. */
/* @sem Change::[RemoveCardType(Creature)] */
change_isnt_creature ::= "isn't" "a" "creature"

/* A plural population loses land types and abilities, then receives an
   independently scoped activated ability. Each phrase supplies its own meaning. */
/* @sem Change::[RemoveAllLandTypes, RemoveAllAbilities] */
change_lose_land_types_and_abilities ::= "lose" "all" "land" "types" "and" "abilities"

/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[...$change_lose_land_types_and_abilities, $grant_quoted_activation]} */
static_loss_and_quoted_activation ::= affected change_lose_land_types_and_abilities "," "and" "they" "gain" grant_quoted_activation

/* The singular self-card permission supplies the antecedent for the replacement. */
/* @sem ObjectSet::One(Source) */
graveyard_cast_self_phrase ::= "you" "may" "cast" "this" "card" "from" "your" "graveyard"

/* @sem Ability::Scoped{zones:[Graveyard], condition:$condition, ability:Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$graveyard_cast_self_phrase, from:Graveyard, action:CastSpell, filter:Any}, terms:_{cost:Normal, into_exile:true}})]})} */
static_graveyard_cast_condition_exile ::= graveyard_cast_self_phrase "as" "long" "as" condition "." "if" "you" "cast" "it" "this" "way" "and" "it" "would" "be" "put" "into" "your" "graveyard" "," "exile" "it" "instead" "."

/* The antecedent and the text source both denote the top card of your graveyard.
   Keep this construction scoped so that an unrelated condition cannot bind it. */
/* @sem Ability::Conditional{condition:$condition_top_your_graveyard_kind, then:[Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:$graveyard_top_text_with_ability})]} */
static_top_graveyard_text_if ::= "as" "long" "as" condition_top_your_graveyard_kind "," affected graveyard_top_text_with_ability

/* @sem Change::[TextOf{object:Query{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}), index:0}, plus:List([Ability(@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program}))])}] */
graveyard_top_text_with_ability ::= "has" "the" "full" "text" "of" "that" "card" "and" "has" "the" "text" '"' cost ":" program "." '"'

/* The two events and type change remain independent current operands. */
/* @sem Change::GrantAbility(@scope(Ability::Triggered{event:$shared_pair_event_clauses, limits:_{}, announcement:@announcement, body:$program})) */
shared_granted_pair_trigger ::= '"' shared_pair_event_clauses "," program "." '"'

/* @sem Change::[$shared_added_singular_type, $shared_granted_pair_trigger] */
shared_type_and_pair_trigger ::= shared_added_singular_type "and" "has" shared_granted_pair_trigger

/* The anaphor is scoped to the top-card condition immediately before it. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController)), SharesColorWithAny(Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top})])} */
top_card_shared_color_subject ::= filter_plural "you" "control" "that" "share" "a" "color" "with" "that" "card"

/* @sem Condition::ObjectMatches{object:Query{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, index:0}, filter:$card_filter} */
your_top_card_condition ::= "the" "top" "card" "of" "your" "library" "is" "a" card_filter "card"

/* @sem Ability::Conditional{condition:$your_top_card_condition, then:[Static(_{kind:Ordinary, affected:Objects($top_card_shared_color_subject), changes:$static_changes})]} */
static_top_card_shared_color ::= "as" "long" "as" your_top_card_condition "," top_card_shared_color_subject static_changes "."

/* Plural additional land plays retain the amount independently of the stage. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(AdditionalLandPlays(Exactly($count_plural)))]}) */
static_additional_lands ::= "you" "may" "play" count_plural "additional" "lands" "on" "each" "of" "your" "turns" "."

/* @prefer always */
/* @sem Ability::@defining_static(Ability::Static{kind:Ordinary, affected:Objects(One($named_possessive_ref)), changes:[Change::SetBasePowerToughness{power:$defining_named_stat_value, toughness:$defining_named_stat_value}]}) */
static_defining_named_values ::= named_possessive_ref "power" "and" "toughness" "are" "each" "equal" "to" defining_named_stat_value "."

/* @sem Ability::@defining_static(Ability::Static{kind:Ordinary, affected:Objects(One($holder_possessive_ref)), changes:[Change::SetBasePowerToughness{power:$defining_holder_stat_value, toughness:$defining_holder_stat_value}]}) */
static_defining_holder_values ::= holder_possessive_ref "power" "and" "toughness" "are" "each" "equal" "to" defining_holder_stat_value "."

/* These quantities are scoped to intrinsic stat definitions, leaving other
   consumers of value and their existing readings unchanged. */
defining_named_stat_value ::= defining_max_hand | defining_half_max_life | defining_difference_opponent | defining_difference_max_player

defining_holder_stat_value ::= defining_symbols | defining_difference_max_player

/* @sem Expr::AmongPlayers{players:OpponentsOf(AbilityController), number:CardsInHand, aggregation:Maximum} */
defining_max_hand ::= "the" "number" "of" "cards" "in" "the" "hand" "of" "the" "opponent" "with" "the" "most" "cards" "in" "hand"

/* @sem Expr::AmongPlayers{players:OpponentsOf(AbilityController), number:Life, aggregation:Maximum} */
defining_max_opponent_life ::= "the" "highest" "life" "total" "among" "your" "opponents"

/* @sem Expr::AmongPlayers{players:All, number:Life, aggregation:Maximum} */
defining_max_player_life ::= "the" "highest" "life" "total" "among" "players"

/* @sem Expr::AmongPlayers{players:OpponentsOf(AbilityController), number:Life, aggregation:Maximum} */
defining_opponent_most_life ::= "the" "life" "total" "of" "an" "opponent" "with" "the" "most" "life"

/* @sem Expr::Divide{numerator:$defining_max_opponent_life, denominator:Constant(2), rounding:Up} */
defining_half_max_life ::= "half" defining_max_opponent_life "," "rounded" "up"

/* @sem Expr::Subtract($value_atom, $defining_max_player_life) */
defining_difference_max_player ::= value_atom "minus" defining_max_player_life

/* @sem Expr::Subtract($value_your_life, $defining_opponent_most_life) */
defining_difference_opponent ::= value_your_life "minus" defining_opponent_most_life

/* @sem Expr::CountManaSymbols{objects:$affected, colors:[$devotion_color]} */
defining_symbols ::= "the" "number" "of" devotion_color "mana" "symbols" "in" "the" "mana" "costs" "of" affected

/* Singular animation phrases compose with the existing snapshot routes. */
pilot_animation_change ::= artifact_base_keyword_change | artifact_equal_stats_change | illusion_equal_stats_change

/* @sem Change::[AddCardType(Artifact), AddCardType(Creature), SetBasePowerToughness{power:$value, toughness:$value_2}, GrantKeyword($keyword_value)] */
artifact_base_keyword_change ::= "becomes" "an" "artifact" "creature" "with" "base" "power" "and" "toughness" value "/" value "and" "gains" keyword_value

/* @sem Change::[AddCardType(Artifact), AddCardType(Creature), SetBasePowerToughness{power:$value, toughness:$value}] */
artifact_equal_stats_change ::= "becomes" "an" "artifact" "creature" "with" "power" "and" "toughness" "each" "equal" "to" value

/* @sem Change::[AddCardType($vowel_card_type)] */
retained_vowel_type_change ::= "becomes" "an" vowel_card_type "in" "addition" "to" "its" "other" "types"

/* @sem Change::[CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetCardTypes([Creature]), SetBasePowerToughness{power:$value, toughness:$value}] */
illusion_equal_stats_change ::= "becomes" "an" becomes_types "creature" "with" "power" "and" "toughness" "each" "equal" "to" value

/* This duration binds both the source and the battlefield residence to one object. */
/* @sem Operation::CreateContinuousEffect{source:$object_ref, affected:Objects($affected), changes:$pilot_land_change, duration:WhileOnBattlefield($object_ref), evaluation:Snapshot} */
pilot_land_while_present ::= affected pilot_land_change "for" "as" "long" "as" object_ref "remains" "on" "the" "battlefield"

/* @sem Change::[SetLandType(Vocabulary{family:LandType, form:@subtype_name($basic_land_type_named)})] */
pilot_land_change ::= "becomes" basic_land_type_named

/* The event restriction belongs to this complete effect, not every duration. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$pilot_enchantment_change, duration:UntilEvent(Spell{event:Cast, players:All, spells:$filter_phrase}), evaluation:Snapshot} */
pilot_until_spell_cast ::= affected pilot_enchantment_change "until" "a" "player" "casts" "a" filter_phrase "spell"

/* @sem Change::[SetCardTypes([Enchantment]), RemoveAllAbilities] */
pilot_enchantment_change ::= "becomes" "an" "enchantment" "and" "loses" "all" "abilities"

/* A resolution effect adds a type to one target or a referred object. */
retained_type_addition_subject ::= qualified_set | object_one

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($retained_type_addition_subject)), changes:$retained_vowel_type_change, duration:Indefinite, evaluation:Snapshot} */
continuous_single_type_addition ::= retained_type_addition_subject retained_vowel_type_change

/* Temporary spell costs share the static spell filter and modifier grammar. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$turn_spell_discount_filter, modifier:$spell_cost_less})], duration:$this_duration, evaluation:LiveObjects} */
turn_spell_cost_operation ::= turn_spell_discount_filter "you" "cast" this_duration "cost" spell_cost_less "to" "cast"

/* Two printed spell families share the same temporary discount operation. */
turn_spell_discount_filter ::= turn_spell_discount_artifact | turn_spell_discount_instant_sorcery

/* @sem $noun_artifact */
turn_spell_discount_artifact ::= noun_artifact "spells"

/* @sem ObjectFilter::AnyOf([$spell_instant, $spell_sorcery]) */
turn_spell_discount_instant_sorcery ::= spell_instant "and" spell_sorcery "spells"

/* @sem PlayerRule::ActivationGrant{abilities:AllOf([OnStack(Loyalty), AbilityOf($filter_phrase)]), grant:AdditionalTimes($value)} */
loyalty_extra_activation_grant ::= "for" "each" filter_phrase "," "you" "may" "activate" value "of" "its" "loyalty" "abilities" "once"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule($loyalty_extra_activation_grant)], duration:$this_duration, evaluation:LiveObjects} */
loyalty_extra_activation_operation ::= loyalty_extra_activation_grant this_duration "as" "though" "none" "of" "its" "loyalty" "abilities" "have" "been" "activated" "this" "turn"

/* The choice phrase constructs the choice; the surrounding clause applies it. */
/* @sem Instruction::[Effect{result:@next, operation:$stat_exchange_choice}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:ChosenPowerToughness{result:@prior}, toughness:ChosenPowerToughness{result:@prior, toughness:true}}], duration:$duration, evaluation:Snapshot}}] */
instructions_chosen_stat_pump ::= affected "gets" stat_exchange_choice duration

stat_exchange_choice ::= stat_exchange_one | stat_exchange_two

/* @sem Operation::ChoosePowerToughness{player:AbilityController, options:[[1, -1], [-1, 1]]} */
stat_exchange_one ::= "+" "1" "/" "-" "1" "or" "-" "1" "/" "+" "1"

/* @sem Operation::ChoosePowerToughness{player:AbilityController, options:[[2, -2], [-2, 2]]} */
stat_exchange_two ::= "+" "2" "/" "-" "2" "or" "-" "2" "/" "+" "2"

/* @sem $noun_zombie_folded */
cast_folded_zombie_spells ::= noun_zombie_folded "spells"

/* A cast-time condition applies to the source spell's counter prohibition. */
/* @sem Ability::Scoped{zones:[Stack], condition:$condition_revealed_or_controlled_as_cast, ability:$stack_self_counter_prohibition} */
stack_cast_condition_prohibition ::= "if" condition_revealed_or_controlled_as_cast "," stack_self_counter_prohibition "."

/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Stack), kind:Spell, filter:SameObject(Source)}), changes:$spell_cant_be_countered} */
stack_self_counter_prohibition ::= self_spell spell_cant_be_countered

/* The copied ability kind and each source population remain separate operands. */
/* @sem Change::[GainAbilitiesOf{objects:$sticker_owned_battlefield, kinds:$sticker_copied_kind}, GainAbilitiesOf{objects:$sticker_graveyard_cards, kinds:$sticker_copied_kind}] */
change_sticker_abilities ::= "has" "all" "abilities" "of" sticker_copied_kind "on" sticker_owned_battlefield "and" sticker_graveyard_cards

/* @sem Operand::List([Term{family:CheckHasable, form:StickerAbility}]) */
sticker_copied_kind ::= "ability" "stickers"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(Source)), $filter_plural, ObjectFilter::OwnedBy(One(AbilityController)))} */
sticker_owned_battlefield ::= "other" filter_plural "you" "own"

sticker_graveyard_cards ::= sticker_graveyard_all | sticker_graveyard_filtered

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any} */
sticker_graveyard_all ::= "cards" "in" "your" "graveyard"

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase} */
sticker_graveyard_filtered ::= filter_phrase "cards" "in" "your" "graveyard"

/* A plural battlefield filter can carry any closed quoted grant. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}), changes:$closed_grants} */
static_filtered_closed_grant ::= filter_phrase "have" closed_grants

/* @sem Ability::Static(_{kind:Ordinary, affected:Players($history_rule_players), changes:[$history_player_rule]}) */
static_cast_history_spell_limit ::= history_rule_players history_player_rule "."

/* The casting restriction after attacking has its own exact wording. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players($history_attacked_players), changes:[PlayerRule(Prohibit(CastSpell{filter:$cast_spells_filter}))]}) */
static_attack_history_spell_limit ::= history_attacked_players "can't" "cast" cast_spells_filter "."

/* @sem PlayerSet::Intersection([$players_singular, Matching{binding:0, condition:$bound_attack_with_one}]) */
history_attacked_players ::= players_singular "who" bound_attack_with_one

/* The attacking object was controlled by the player bound in the subject. */
/* @sem Condition::Compare{left:EventHistory{event:Object{event:Attacks, objects:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))])}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_a}} */
bound_attack_with_one ::= "attacked" "with" counter_a filter_phrase "this" "turn"
