shared_singular_gain_and_colorless_type ::= "gains" grants "and" singular_colorless_retained_card_type

/* @sem Change::[Colors{mode:Set, colors:[]}, AddCardType($added_singular_card_type)] */
singular_colorless_retained_card_type ::= "becomes" "a" "colorless" added_singular_card_type "in" "addition" "to" "its" "other" "types"

/* A requirement for each matching blocker is expressed on the attacked object. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Rule(RequireCombat{action:BeBlocked($filter_plural), amount:Each})], duration:$this_duration, evaluation:LiveObjects} */
all_population_block_attacker ::= "all" filter_plural "block" affected this_duration "if" "able"

/* The pronoun refers to the attacker that caused the event, not the blocker. */
/* @sem Ability::Triggered{event:$event_attacks, limits:_{}, body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Rule(RequireCombat{action:Block(SameObject(@event_subject)), amount:AtLeast(Constant(1))})], duration:EndOfCombat, evaluation:LiveObjects}}]}, announcement:@announcement} */
triggered_when_attacker_block_requirement ::= "when" event_attacks "," affected "blocks" "it" "this" "combat" "if" "able" "."

/* Keyword activations retain the activating player and the payment adjustment. */
