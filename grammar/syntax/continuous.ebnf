timed_entry_tapped ::= entry_tapped_event this_duration

/* The same source subject governs both a characteristic change or damage and
   the following untap restriction. Keep the step player and window together. */
/* @sem Duration::DuringNextUntapStep(AbilityController) */
source_skip_your_untap_window ::= "doesn't" "untap" "during" "your" "next" "untap" "step"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($self_explicit_ref)), changes:$changes, duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($self_explicit_ref)), changes:[Rule(UntapStep{players:One(AbilityController), behavior:Skip})], duration:$source_skip_your_untap_window, evaluation:LiveObjects}}] */
source_change_and_skip_untap ::= self_explicit_ref changes duration "and" source_skip_your_untap_window

/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:$recipients, amount:$number, preventable:true}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($self_explicit_ref)), changes:[Rule(UntapStep{players:One(AbilityController), behavior:Skip})], duration:$source_skip_your_untap_window, evaluation:LiveObjects}}] */
source_damage_and_skip_untap ::= self_explicit_ref "deals" number "damage" "to" recipients "and" source_skip_your_untap_window

/* A lasting grant and a colorless retained card type are independently editable. */
