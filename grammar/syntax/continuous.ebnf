base_toughness_change ::= "base" "toughness" value

/* @sem $base_toughness_change */
change_have_base_toughness ::= "have" base_toughness_change

/* @sem Operation::ChangeCombat{change:OnlyBlockers($chosen_pile_blockers)} */
only_pile_members_block ::= "only" chosen_pile_blockers "can" "block" "this" "turn"

