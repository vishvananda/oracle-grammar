line_cause_additional_trigger ::= "if" trigger_cause_dying "causes" "a" "triggered" "ability" "of" retrigger_holder "to" "trigger" "," "that" "ability" "triggers" "an" "additional" "time" "."

/* Three named basic land types replace the land's previous land types. */
/* @sem Change::[SetLandType(List([Vocabulary{family:LandType, form:@subtype_name($basic_land_type_named)}, Vocabulary{family:LandType, form:@subtype_name($basic_land_type_second)}, Vocabulary{family:LandType, form:@subtype_name($basic_land_type_third)}]))] */
