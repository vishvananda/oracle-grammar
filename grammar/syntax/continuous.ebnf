change_combat_subject_draw_grant ::= "gains" '"' "whenever" event_combat_damage_player "," combat_subject_draw_program "," '"'

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:ObjectProperty{object:EventSubject, property:$combat_subject_draw_property, information:CurrentOrLastKnown}}}]} */
combat_subject_draw_program ::= "draw" "cards" "equal" "to" "its" combat_subject_draw_property

