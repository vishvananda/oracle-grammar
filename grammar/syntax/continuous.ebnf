lost_keyword_list ::= lost_keyword "and" lost_keyword_tail

/* @sem Change::[LosesAbility($lost_keyword)] */
lost_keyword_tail ::= lost_keyword

/* @sem Operand::Term{family:CheckHasable, form:Landwalk, operands:[Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$walk_land_filter})]} */
lost_landwalk ::= walk_land_filter

/* A subject and its changes form a reusable static clause; a conjunction
   keeps each subject and its changes independently bound. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:$static_changes} */
static_subject_clause ::= affected static_changes

/* @sem Ability::[$static_subject_clause, $static_subject_clause_2] */
static_subject_pair ::= static_subject_clause "and" static_subject_clause

/* @sem Ability::Conditional{condition:$condition, then:$static_subject_pair} */
conditional_static_pair ::= "as" "long" "as" condition "," static_subject_pair "."

/* Singular controlled populations share the same static-effect frame. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected_controlled_each), changes:$controlled_each_change}) */
static_controlled_each_change ::= affected_controlled_each controlled_each_change "."

controlled_each_change ::= change_chosen_creature_type_add_singular

/* @sem Change::[ChosenType{kind:CreatureType, mode:Add}] */
change_chosen_creature_type_add_singular ::= "is" "the" "chosen" "type" "in" "addition" "to" "its" "other" "types"

/* The named planeswalker population fixes the chosen type domain. */
