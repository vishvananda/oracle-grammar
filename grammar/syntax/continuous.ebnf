continuous_live_source_power_block ::= affected m_can_t_be_blocked_by_filter_plural_with this_combat

/* @sem Change::[Rule(RequireCombat{action:BeBlocked(Any), amount:AtLeast(Constant(1))})] */
be_blocked_plain ::= "must" "be" "blocked"

/* @sem Change::[Rule(RequireCombat{action:BeBlocked(Any), amount:AtLeast(Constant(1))})] */
be_blocked_each_combat ::= "must" "be" "blocked" "each" "combat"

/* Keyword operands share the ordinary characteristic-loss phrase. */
/* @sem Operand::Term{family:CheckHasable, form:Shadow, operands:[]} */
lost_shadow ::= "shadow"

/* The deadline is an event over all players. */
/* @sem Duration::UntilEvent(Player{event:PlaneswalksAway, players:All}) */
until_player_planeswalks ::= "until" "a" "player" "planeswalks"

/* The controlling reference also supplies the originating object. */
