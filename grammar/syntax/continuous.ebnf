consonant_card_type ::= added_creature | added_land

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected_plural)), changes:$target_ban_kind_spells_opponents, duration:$rule_duration, evaluation:LiveObjects} */
continuous_live_plural_opponent_colored_target_ban ::= affected_plural "can't" "be" "the" "targets" "of" target_ban_kind_spells_opponents ("↓")? rule_duration

