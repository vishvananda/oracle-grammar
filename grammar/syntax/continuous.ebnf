affected_chosen_planeswalker_plural ::= plural_planeswalker modifier_you_control "of" "the" "chosen" "type"

/* A singular subject supplies the antecedent of the replacement sentence.
   Both pump operands remain independent and the condition selects one change. */
/* @sem Change::[Pump{power:$signed, toughness:$signed_2}] */
static_singular_pump ::= "gets" signed "/" signed

/* @sem Ability::Conditional{condition:$condition, then:[Static{kind:Ordinary, affected:Objects(One($scalar_static_subject)), changes:$static_singular_pump_2}], otherwise:[Static{kind:Ordinary, affected:Objects(One($scalar_static_subject)), changes:$static_singular_pump}]} */
static_scalar_pump_override ::= scalar_static_subject static_singular_pump "." "it" static_singular_pump "instead" "as" "long" "as" condition "."

/* The pump and added color/type preserve their independent current operands. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($attached_color_subject), changes:[...$attached_signed_pump, ...$retained_color_type]} */
