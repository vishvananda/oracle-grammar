/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$attack_pair_change, duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Rule(RequireCombat{action:Attack(Any), amount:AtLeast(Constant(1))})], duration:$this_duration, evaluation:LiveObjects}}] */
clause_change_attack_requirement ::= affected attack_pair_change duration "and" "attacks" this_duration "if" "able"

entry_tapped_event ::= entry_tapped_plural | entry_tapped_chosen_parity

