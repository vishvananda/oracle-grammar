static_keyword_activation_payment ::= keyword_activation_subject "abilities" "you" "activate" "cost" keyword_payment_change "to" "activate" "."

/* @sem Mechanic::Cycling */
keyword_activation_subject ::= "cycling"

/* An indefinite grant shares its affected object and gives the quoted ability
