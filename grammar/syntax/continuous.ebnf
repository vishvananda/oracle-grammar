/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected_plural)), changes:$target_ban_kind_spells, duration:$rule_duration, evaluation:LiveObjects} */
continuous_live_plural_target_ban ::= affected_plural "can't" "be" "the" "targets" "of" target_ban_kind_spells ("↓")? rule_duration

/* A blocker exception can name either of two independent populations. */
blocker_exception_filter ::= filter_plural | blocker_exception_union

/* @sem ObjectFilter::AnyOf([$filter_plural, $filter_plural_2]) */
blocker_exception_union ::= filter_plural "and" "/" "or" filter_plural

/* Compare a prospective blocker's power with the triggering object. */
/* @sem Change::[Rule(Prohibit(BeBlocked(AllOf([$filter_plural, Property{property:Power, test:NumberTest::Compare{comparison:Greater, value:ObjectProperty{object:EventSubject, property:Power, information:CurrentOrLastKnown}}}]))))] */
rule_blocked_greater_power ::= "can't" "be" "blocked" "by" filter_plural "with" "greater" "power"

/* Rule changes follow their affected objects while the named source stays tapped. */
/* @sem Operation::CreateContinuousEffect{source:$object_ref, affected:Objects($affected), changes:$rule_change, duration:WhileMatches{object:$object_ref, filter:Tapped}, evaluation:LiveObjects} */
live_rule_while_tapped ::= affected rule_change "for" "as" "long" "as" object_ref "remains" "tapped"

/* The two anaphors have separate print shapes for the same controller-relative window. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})], duration:$controller_next_window, evaluation:LiveObjects} */
skip_plural_controller_window ::= affected controller_next_window

controller_next_window ::= their_next_untap_window | that_players_next_untap_window

/* @sem Duration::DuringControllersNextUntapStep */
their_next_untap_window ::= "don't" "untap" "during" "their" "next" "untap" "step"

/* @sem Duration::DuringControllersNextUntapStep */
that_players_next_untap_window ::= "don't" "untap" "during" "that" "player's" "next" "untap" "step"

/* Both abilities belong to the chosen permanent, with separate trigger scope. */
/* @sem Change::GrantAbility(Replacement{active:Battlefield, event:Object{event:LeavesBattlefield, objects:SameObject(Source)}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}}) */
grant_departure_exile ::= '"' "if" "this" "creature" "would" "leave" "the" "battlefield" "," "exile" "it" "instead" "of" "putting" "it" "anywhere" "else" '"'

/* @sem Change::GrantAbility(@scope(Ability::Triggered{event:ZoneChange{objects:SameObject(Source), from:Battlefield, to:Exile}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}})) */
grant_exile_arrival_token ::= '"' "when" "this" "creature" "is" "put" "into" "exile" "," "create" "a" token_recipe "." '"'

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ControlledBy(One(AbilityController))])}), index:0})), changes:[$grant_departure_exile, $grant_exile_arrival_token], duration:$duration, evaluation:Snapshot}}] */
clause_choose_grant_departure ::= "choose" "target" noun "you" "control" "." duration "," "it" "gains" grant_departure_exile "and" grant_exile_arrival_token

/* A replacement of the whole card-type set retains its typed operand. */
/* @sem Change::[SetCardTypes([$only_card_type])] */
