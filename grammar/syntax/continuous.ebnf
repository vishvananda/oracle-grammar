anaphoric_add_card_type ::= "a" anaphoric_added_type "in" "addition" "to" "its" "other" "types"

anaphoric_added_type ::= added_land | added_creature

/* The host named by the subject is also the antecedent of the condition. */
/* @sem Ability::Conditional{condition:ObjectMatches{object:$attached_ref, filter:$condition_supertype}, then:[Static(_{kind:Ordinary, affected:Objects(One($attached_ref)), changes:$static_changes})]} */
attached_supertype_conditional ::= attached_ref static_changes "as" "long" "as" "it's" condition_supertype "."

/* Capture the explicitly creature-typed population before the follow-up. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::CardType(Creature), $modifier_mana_value_numeric)}), changes:[RemoveAllAbilities], duration:$duration, evaluation:Snapshot} */
creature_mana_value_remove_abilities ::= "each" "creature" modifier_mana_value_numeric "loses" "all" "abilities" duration

/* @sem Instruction::Effect{result:@next, operation:Destroy{objects:Affected(@prior), regeneration:true}} */
destroy_affected_creatures ::= "destroy" "those" "creatures"

/* @sem Instruction::[Effect{result:@next, operation:$creature_mana_value_remove_abilities}, $destroy_affected_creatures] */
clause_creature_change_destroy ::= creature_mana_value_remove_abilities "." destroy_affected_creatures

/* The casting subject composes with independently scoped zone permissions. */
/* @sem ObjectSet::$affected */
cast_permission_cards ::= "you" "may" "cast" affected

/* @sem Ability::Scoped{zones:[Exile], ability:Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:$cast_permission_cards, from:Exile, action:CastSpell, filter:Any})]})} */
static_exile_cast_permission ::= cast_permission_cards "from" "exile" "."

/* A single loss verb distributes over each independently named ability. */
/* @sem $lost_keyword_list */
