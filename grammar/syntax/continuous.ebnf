static_also_while_control_many ::= affected "also" static_changes_plain "as" "long" "as" condition_control_many "."

/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[...$base_subtypes, RemoveAllAbilities]} */
static_is_base_subtypes_lose_abilities ::= affected "is" base_subtypes "and" "loses" "all" "abilities" "."

/* Compose an event cause with the separately described ability holder. */
