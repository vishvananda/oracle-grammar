/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Exile]}), count:Exactly(Constant(1)), filter:AllOf([$noun, InSet(Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}))])}), index:0} */
copy_target_card_exiled_with_it ::= "target" noun "card" "exiled" "with" "it"

/* @sem Vec<CopyException>::[$copy_fixed_stats, $copy_current_payload] */
copy_stats_has_current ::= copy_fixed_stats "and" "has" copy_current_payload

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_ref_named)), changes:[CopyOf{object:$copy_target_card_exiled_with_it, exceptions:$copy_stats_has_current}], duration:Indefinite, evaluation:Snapshot} */
copy_self_linked_card_stats ::= self_ref_named "becomes" "a" "copy" "of" copy_target_card_exiled_with_it "," "except" copy_stats_has_current

/* The entrant is the antecedent of "it" even when the recipient is named
   between the event and the copy action. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@copy_subject(ObjectSet::$affected, ObjectRef::EventSubject)), changes:[CopyOf{object:EventSubject, exceptions:$copy_exceptions_plain}], duration:$duration, evaluation:Snapshot} */
event_copy_become_duration_except ::= affected "become" "a" "copy" "of" "it" duration "," "except" copy_exceptions_plain

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$event_copy_become_duration_except}]}}]}} */
triggered_optional_event_copy ::= event_clause "," "you" "may" "have" event_copy_become_duration_except "."

/* The quoted activation has its own holder and announcement. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($controlled_subtype_population), changes:[$single_quoted_activation]} */
static_controlled_subtype_single_quote ::= controlled_subtype_population "have" single_quoted_activation

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$subtype_plural, ControlledBy(One(AbilityController))])} */
controlled_subtype_population ::= subtype_plural "you" "control"

/* @sem Change::GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$single_quoted_body})) */
single_quoted_activation ::= "'" cost ":" single_quoted_body "." "'"

single_quoted_body ::= quoted_land_damage_body | program

/* The explicit land source is scoped to this quoted activation. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:$recipients_any_target, amount:$number, preventable:true}}]} */
quoted_land_damage_body ::= "this" "land" "deals" number "damage" "to" recipients_any_target

/* @prefer always */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$counter_defined_artifact_animation, duration:$duration, evaluation:Snapshot} */
counter_artifact_animated_operation ::= duration "," affected "becomes" counter_defined_artifact_animation

/* The quoted definition belongs to the animated object's granted ability. */
/* @sem Change::[CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Creature), GrantAbility($counter_defined_creature_static)] */
counter_defined_retained_animation ::= "a" becomes_types "creature" "in" "addition" "to" "its" "other" "types" "and" "gains" '"' counter_defined_creature_static '"'

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$counter_defined_retained_animation, duration:$duration, evaluation:Snapshot} */
counter_retained_animated_operation ::= duration "," affected "becomes" counter_defined_retained_animation

/* An animation sets its creature subtype while adding the two card types. */
/* @sem Change::[SetBasePowerToughness{power:$number_digits, toughness:$number_digits_2}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, AddCardType(Artifact), AddCardType(Creature)] */
conditional_artifact_animation_changes ::= number_digits "/" number_digits becomes_types "artifact" "creature"

/* The controlled population, targeted source, duration and spending color are
   independent operands of the temporary ability-copying effect. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$subtype, ControlledBy(One(AbilityController))])}), changes:[GainAbilitiesOf{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ControlledBy(OpponentsOf(AbilityController))])}), index:0}), kinds:Term{family:CheckHasable, form:ActivatedAbility}, spend_as:ColorAsAnyColor($mana_color_word)}], duration:$duration, evaluation:Snapshot}}]} */
controlled_type_copy_activated_program ::= "each" subtype "you" "control" "gains" "all" "activated" "abilities" "of" "target" noun "an" "opponent" "controls" duration "." "you" "may" "spend" mana_color_word "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "activate" "those" "abilities"

/* @sem ObjectFilter::NthCast{ordinal:$cast_order, spells:State(HasX), by:One(AbilityController), scope:Turn} */
ordered_x_cast_spell ::= "the" cast_order "spell" "you" "cast" "with" "{" "X" "}" "in" "its" "mana" "cost" "each" "turn"

ordered_spell_cost_tail ::= ordered_spell_cost_plain | ordered_spell_cost_per_counter

/* @sem $spell_cost_change */
ordered_spell_cost_plain ::= spell_cost_change "to" "cast" /* @prefer always */

/* @sem SpellCostModifier::Reduce{reductions:[_{amount:@times($braced_number, $ordered_counter_count)}], spill_into_generic:true} */
ordered_spell_cost_per_counter ::= braced_number "less" "to" "cast" "for" "each" ordered_counter_count

/* @sem Expr::CountCounters(_{recipients:Objects($affected), kind:$counter_kind, information:CurrentOrLastKnown}) */
ordered_counter_count ::= counter_kind "counter" "on" affected

/* Both plural follow-ups use the movement's own arrival receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$put_single_graveyard_targets}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Transition{result:@marked, phase:After}), changes:$static_changes, duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Transition{result:@marked, phase:After}})}]}}}] */
put_graveyard_targets_grant_sacrifice ::= put_single_graveyard_targets "." "they" static_changes duration "." "sacrifice" "them" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$put_graveyard_targets_grant_sacrifice}} */
put_graveyard_targets_grant_sacrifice_spell ::= put_graveyard_targets_grant_sacrifice "."

/* Spell timing permission retains the current spell filter. */
/* @sem Change::[PlayerRule(SpellTiming{spells:$flash_spells, timing:Flash})] */
player_flash_timing_rule ::= "you" "may" "cast" flash_spells "as" "though" "they" "had" "flash"

/* This duration is scoped to a delayed turn event by its enclosing body. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$changes, duration:EndOfTurn, evaluation:Snapshot} */
delayed_turn_snapshot ::= affected changes "until" "the" "end" "of" "that" "turn"

/* @sem Change::[Rule(GoadedBy(AbilityController))] */
change_are_goaded ::= "are" "goaded"

/* A controlled subtype population receives a characteristic for the stated duration. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$controlled_grant_subject, ControlledBy(One(AbilityController))])}), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot} */
controlled_subtype_temporary_keyword ::= controlled_grant_subject "you" "control" "gain" keyword_name duration

controlled_grant_subject ::= subtype_plural | controlled_type_lower_humans

/* A quoted final ability supplies the sentence's terminal punctuation. */
/* @sem Change::[GrantKeyword($keyword_value), GrantAbility(@holder($retirement_quoted_turn_payment))] */
animation_keyword_quoted_turn_grants ::= keyword_value "and" '"' retirement_quoted_turn_payment '"'

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetCardTypes([Creature]), ...$animation_keyword_quoted_turn_grants] */
animation_quoted_turn_changes ::= "a" value "/" value becomes_types "creature" "with" animation_keyword_quoted_turn_grants

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$animation_quoted_turn_changes, duration:Indefinite, evaluation:Snapshot}}]} */
program_animated_quoted_turn ::= affected "becomes" animation_quoted_turn_changes

/* A plural population restricted to objects with no counters of any kind. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, Counters(_{comparison:Equal, value:Constant(0)})])} */
affected_without_counters ::= filter_plural "with" "no" "counters" "on" "them"

/* A permanent can become a creature with a quoted static ability. */
/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetCardTypes([Creature]), GrantAbility(Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes}))] */
creature_quoted_static_animation ::= "a" value "/" value becomes_types "creature" "with" '"' affected static_changes "." '"'

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$creature_quoted_static_animation, duration:Indefinite, evaluation:Snapshot} */
indefinite_creature_quoted_static ::= affected "becomes" creature_quoted_static_animation

/* A plural population with a keyword family can be subject to a targeting exception. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::HasKeywordFamily(Hexproof))} */
targeting_keyword_population ::= filter_plural "with" "hexproof"

/* @sem Change::[Rule(TargetableDespite{sources:ControlledBy(One(AbilityController)), keyword:$targeting_ignored_keyword})] */
plural_you_control_targeting_exception ::= "can" "be" "the" "targets" "of" "spells" "and" "abilities" "you" "control" "as" "though" "they" "didn't" "have" targeting_ignored_keyword

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($targeting_keyword_population), changes:$plural_you_control_targeting_exception}) */
static_keyword_population_targeting ::= targeting_keyword_population plural_you_control_targeting_exception "."

/* A live controlled population, with its abilityless qualifier on each member. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController)), $modifier_no_abilities])} */
each_controlled_abilityless_population ::= "each" filter_phrase "you" "control" modifier_no_abilities

/* A named player's window is independent of the affected objects' controllers. */
/* @sem Duration::DuringNextUntapStep(@that_player) */
leading_that_players_next_untap ::= "during" "that" "player's" "next" "untap" "step"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(@that_player)))}), changes:[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})], duration:$leading_that_players_next_untap, evaluation:LiveObjects} */
leading_named_untap_skip ::= leading_that_players_next_untap "," filter_plural "they" "control" "don't" "untap"

/* A population controlled by any member of the ability controller’s team. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy($life_history_team)])} */
affected_team_controlled ::= filter_plural life_history_team "controls"

/* The receiving card supplies its own mana cost and the excluded source of the exile payment. */
/* @sem Ability::Mechanic{mechanic:Escape, cost:Cost{parts:[ManaCostOf(Source), $cost_exile_graveyard_selection]}} */
graveyard_granted_escape ::= "escape" "." "the" "escape" "cost" "is" "equal" "to" "the" "card's" "mana" "cost" "plus" cost_exile_graveyard_selection

/* @sem Change::[AddCardType(Artifact)] */
change_become_artifacts_retained ::= "become" "artifacts" "in" "addition" "to" "their" "other" "types"

/* A defined pump and a keyword share the affected population and duration. */
/* @sem Operation::@where(Operation::CreateContinuousEffect{source:Source, affected:Objects($defined_pump_keyword_subject), changes:$defined_pump_keyword_changes, duration:$duration, evaluation:Snapshot}, $defined_pump_keyword_value) */
continuous_defined_pump_keyword ::= defined_pump_keyword_subject defined_pump_keyword_changes duration "," "where" "X" "is" defined_pump_keyword_value

defined_pump_keyword_subject ::= selected_each_subject | affected

/* @sem ObjectSet::Selected(@prior) */
selected_each_subject ::= "each" "of" "them"

defined_pump_keyword_changes ::= defined_pump_then_keyword | defined_keyword_then_pump

defined_pump_keyword_value ::= defined_pump_keyword_self_stat | value | distinct_counter_kinds_among

/* @prefer always */
/* @sem $value_self_stat */
defined_pump_keyword_self_stat ::= value_self_stat

/* The explicit retention sentence is valid for a previously targeted land set. */
/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Creature)] */
plural_retained_land_creature_changes ::= "become" value "/" value becomes_types "creatures" "." "they're" "still" "lands"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Targets(@last_slot)), changes:$plural_retained_land_creature_changes, duration:Indefinite, evaluation:Snapshot} */
target_lands_retained_animation ::= "they" plural_retained_land_creature_changes

/* The card population and its own-zone origin remain separate operands. */
/* @sem Ability::[Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Zone(_{scope:Players{zone:$own_cast_zone, players:One(AbilityController)}, kind:Card, filter:$random_cards}), from:$own_cast_zone, action:Either, filter:Any})]})] */
pilot_own_zone_play_permission ::= "you" "may" "play" random_cards "from" own_cast_zone

/* The window scopes a reusable graveyard-casting permission. */
/* @sem Ability::Conditional{condition:$window_your_turn, then:[$graveyard_creature_cast_entry]} */
shared_turn_graveyard_creature_cast ::= window_your_turn "," graveyard_creature_cast_entry

/* The modifier describes the spell; the follow-up applies to that creature. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}), from:Graveyard, action:CastSpell, filter:@and(ObjectFilter::CardType(Creature), $modifiers)}, terms:_{cost:Normal, effects:[$graveyard_cast_creature_entry]}})]}) */
graveyard_creature_cast_entry ::= "you" "may" "cast" "creature" "spells" modifiers "from" "your" "graveyard" "." graveyard_cast_creature_entry

/* @sem Operand::List([Term{family:SpellEffect, form:EntersWithACounter, operands:[Vocabulary{family:CounterType, form:FinalityCounter}]}]) */
graveyard_cast_creature_entry ::= "if" "you" "cast" "a" "spell" "this" "way" "," "that" "creature" "enters" "with" "a" "finality" "counter" "on" "it" "."

/* Retaining the land type makes the new creature types additive. */
/* @sem Change::[...$retained_creature_animation, ...$grants] */
retained_creature_animation_grants ::= retained_creature_animation "with" grants

/* Hand-based keyword actions share their card filter and cost adjustment. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(KeywordCost{keyword:$hand_keyword_action, cards:$hand_keyword_cards, change:Reduce($single_generic_reduction)})]}) */
static_hand_keyword_reduction ::= hand_keyword_action hand_keyword_cards "from" "your" "hand" "costs" single_generic_reduction "less" "."

hand_keyword_action ::= hand_keyword_plot | hand_keyword_foretell

/* @sem Mechanic::Plot */
hand_keyword_plot ::= "plotting"

/* @sem Mechanic::Foretell */
hand_keyword_foretell ::= "foretelling"

hand_keyword_cards ::= hand_keyword_any_cards | hand_keyword_filtered_cards

/* @sem ObjectFilter::Any */
hand_keyword_any_cards ::= "cards"

/* @sem ObjectFilter::$filter_phrase */
hand_keyword_filtered_cards ::= filter_phrase "cards"

/* A turn restriction wraps a cast permission with its own zone, filter and payment. */
/* @sem Ability::Conditional{condition:$cast_window_your_turn, then:[Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[$turn_zone_additional_cast]})]} */
turn_zone_additional_permission ::= "during" cast_window_your_turn "," turn_zone_additional_cast "."

/* @sem Change::PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:$own_cast_zone, players:One(AbilityController)}, kind:Card, filter:Any}), from:$own_cast_zone, action:CastSpell, filter:$cast_spells_filter}, terms:_{cost:Additional(Cost{parts:[$cast_pay_life_part]})}}) */
turn_zone_additional_cast ::= "you" "may" "cast" cast_spells_filter "from" own_cast_zone "by" cast_pay_life_part "in" "addition" "to" "their" "other" "costs"

/* The zone and generic reduction remain independent operands of the rule. */
/* @sem ObjectFilter::AllOf([Any, InZone(Players{zone:$own_cast_zone, players:One(AbilityController)})]) */
activation_owner_zone_cards ::= "cards" "in" own_cast_zone

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(ActivationCost{abilities:AbilityOf($activation_owner), change:Reduce($activation_generic_reduction), floor:1})]}) */
static_activation_ability_cost_floor ::= "activated" "abilities" "of" activation_owner "cost" activation_generic_reduction "less" "to" "activate" "." "this" "effect" "can't" "reduce" "the" "mana" "in" "that" "ability's" "activation" "cost" "to" "less" "than" "one" "mana" "."

/* Both choices replace the same affected objects for the written duration. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[RemoveAllAbilities, ...$replacement_creature_form], duration:$duration, evaluation:Snapshot}}]}, Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[RemoveAllAbilities, ...$replacement_creature_form_2], duration:$duration, evaluation:Snapshot}}]}]}] */
clause_choice_replacement_animation ::= duration "," affected "loses" "all" "abilities" "and" "becomes" "your" "choice" "of" replacement_creature_form "or" replacement_creature_form

/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word]}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetCardTypes([Creature]), SetBasePowerToughness{power:$value, toughness:$value_2}] */
replacement_creature_form ::= "a" mana_color_word becomes_types "creature" "with" "base" "power" "and" "toughness" value "/" value

plural_kind_existing ::= filter_phrase | quality | noun_elemental_folded /* @prefer always */

/* The permission belongs to the individual card receiving the ability. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Source), from:Graveyard, action:Either, filter:Any}, terms:_{cost:Normal}})]})} */
graveyard_quoted_play_permission ::= "you" "may" "play" "this" "card" "from" "your" "graveyard"

/* All players’ current cards in the named private zone. */
/* @sem ObjectSet::Zone{scope:Players{zone:Hand, players:All}, kind:Card, filter:Any} */
private_any_hands_cards ::= "cards" "in" "hands"

/* @sem ObjectSet::Zone{scope:Players{zone:Library, players:All}, kind:Card, filter:Any} */
private_any_libraries_cards ::= "cards" "in" "libraries"

/* @sem Change::[RemoveAllAbilities] */
private_plural_lose_all_abilities ::= "lose" "all" "abilities"

/* The chosen player owns both the requirement and its next-turn window. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One($next_turn_target_possessive)), changes:[PlayerRule(MustAttack{attackers:$plural, defenders:Objects(SameObject(Source))})], duration:DuringNextTurn($next_turn_target_possessive), evaluation:LiveObjects} */
next_turn_target_player_attack_source ::= "during" next_turn_target_possessive "next" "turn" "," plural "that" "player" "controls" "attack" SELF_NAME "if" "able"

next_turn_target_possessive ::= next_turn_target_opponent_possessive | next_turn_target_player_possessive

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Expr::Constant(1)), filter:Any, players:OpponentsOf(PlayerRef::AbilityController)}), index:0} */
next_turn_target_opponent_possessive ::= "target" "opponent's"

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Expr::Constant(1)), filter:Any, players:All}), index:0} */
next_turn_target_player_possessive ::= "target" "player's"

/* The mana-source restriction belongs to each cast spell on the stack. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Stack), kind:Spell, filter:@and($mana_grant_cast_subject, $mana_grant_source_qualification)}), changes:[GrantAbility(@holder($mana_grant_spell_mechanic))]} */
static_mana_source_spell_grant ::= mana_grant_cast_subject "has" mana_grant_spell_mechanic mana_grant_source_qualification "."

/* @sem ObjectFilter::Cast{by:One(AbilityController)} */
mana_grant_cast_subject ::= "each" "spell" "you" "cast"

mana_grant_spell_mechanic ::= bare_split_second | spell_mechanic

mana_grant_source_qualification ::= mana_grant_source_an | mana_grant_source_a

/* @sem ObjectFilter::ManaSpentFrom($filter_phrase) */
mana_grant_source_an ::= "if" "mana" "from" "an" filter_phrase "was" "spent" "to" "cast" "it"

/* @sem ObjectFilter::ManaSpentFrom($filter_phrase) */
mana_grant_source_a ::= "if" "mana" "from" "a" filter_phrase "was" "spent" "to" "cast" "it"

/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:@and($card_filter, @and(ObjectFilter::Cast{by:One(AbilityController)}, $cast_color_threshold))} */
mechanic_each_cast_color_threshold ::= "each" card_filter "spell" "you" "cast" "that's" cast_color_threshold

/* @sem ObjectFilter::Property{property:ColorCount, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
cast_color_threshold ::= value "or" "more" "colors"

/* The stated creature types are added while the land types remain. */
/* @sem Change::[...$colored_plural_stats, CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Creature)] */
retained_colored_typed_land_animation ::= "are" colored_plural_stats becomes_types "creatures" "that" "are" "still" "lands"

/* The controller qualifies the named basic land subtype population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($controlled_land_subtype, $modifier_you_control)} */
controlled_basic_land_population ::= controlled_land_subtype modifier_you_control

controlled_land_subtype ::= controlled_land_forest | st_island_pl | st_swamp_pl | st_mountain_pl | st_plains

/* @sem ObjectFilter::Subtype(Forest) */
controlled_land_forest ::= "forests"

/* A static animation retains the planeswalker card type while setting creature subtypes. */
/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, AddCardType(Creature), GrantKeyword($keyword_name)] */
static_retained_walker_creature_keyword ::= "is" "a" value "/" value becomes_types "creature" "with" keyword_name "that's" "still" "a" "planeswalker"

/* @sem Mechanic::Bestow */
graveyard_cast_bestow ::= "bestow"

/* The cast phrase supplies the antecedent for the entry term. */
/* @sem PlayTerms::PlayTerms{cost:Normal, effects:[$graveyard_cast_entry_effect]} */
graveyard_cast_finality_entry ::= "." "if" "you" "do" "," graveyard_cast_entry_effect

/* @sem Operand::List([Term{family:EnterFlag, form:EntersWithACounter, operands:[Vocabulary{family:CounterType, form:FinalityCounter}]}]) */
graveyard_cast_entry_effect ::= "it" "enters" "with" "a" "finality" "counter" "on" "it"

/* @sem Ability::Scoped{zones:[Graveyard], condition:$condition, ability:Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:$graveyard_cast_phrase, from:Graveyard, action:CastSpell, filter:Any})]})} */
static_graveyard_cast_if ::= graveyard_cast_phrase "if" condition "."

/* Exactly one blocker is a distinct combat rule, shared by static and timed effects. */
/* @sem Change::[Rule(Unique(BlockedByExactlyOne))] */
be_blocked_exactly_one ::= "must" "be" "blocked" "by" "exactly" "one" "creature"

/* The defending player chooses assignment for each member of this population. */
/* @sem Change::PlayerRule(Decides(CombatDamageOf(AllOf([$filter_phrase, $attacking_defender_you])))) */
defender_combat_damage_assignment ::= "assign" "the" "combat" "damage" "of" "each" filter_phrase attacking_defender_you

/* The second sentence specifies the distribution among that attacker's blockers. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[$defender_combat_damage_assignment]}) */
static_defender_combat_assignment ::= "rather" "than" "the" "attacking" "player" "," "you" defender_combat_damage_assignment "." "you" "can" "divide" "that" "creature's" "combat" "damage" "as" "you" "choose" "among" "any" "of" "the" "creatures" "blocking" "it" "."

/* The affected population and the step player remain independent. */
/* @sem Change::[Rule(UntapStep{players:$additional_untap_players, behavior:Additional})] */
change_untap_additional_step ::= "untap" "during" additional_untap_players "untap" "step"

/* @sem PlayerSet::All */
additional_untap_players_all ::= "each" "player's"

/* @sem PlayerSet::One(AbilityController) */
additional_untap_players_you ::= "your"

/* @sem PlayerSet::OpponentsOf(AbilityController) */
additional_untap_players_opponents ::= "each" "opponent's"

additional_untap_players ::= additional_untap_players_all | additional_untap_players_you | additional_untap_players_opponents

/* Repeated names identify the same source; each combat rule retains its operands. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(One(Source)), changes:[...$rule_change, ...$rule_change_2]} */
shared_self_repeated_combat_rules ::= SELF_NAME rule_change "," "and" SELF_NAME rule_change "."

/* @sem Change::[Rule(RequireCombat{action:BeBlocked(Any), amount:AtLeast($value)})] */
be_blocked_minimum ::= "must" "be" "blocked" "by" value "or" "more" "creatures"

/* A plural population remains the subject of both coordinated restrictions. */
/* @sem Ability::[Static{kind:Ordinary, affected:Objects($affected_plural), changes:$plural_combat_restrictions}] */
line_plural_combat_restrictions ::= affected_plural plural_combat_restrictions "."

/* @sem Change::[...$plural_combat_first, ...$plural_combat_second] */
plural_combat_restrictions ::= plural_combat_first "," "and" "they" plural_combat_second

plural_combat_first ::= rule_cant_block | rule_cant_attack

plural_combat_second ::= rule_cant_attack_you | rule_cant_attack_you_only | rule_cant_block | rule_cant_attack

/* A singular subtype replacement composes with other changes. */
/* @sem Change::[CreatureTypes{mode:Set, types:Listed([@subtype_name($vowel_creature_subtype)])}] */
change_becomes_subtype_an ::= "becomes" "an" vowel_creature_subtype

vowel_creature_subtype ::= st_advisor | st_aetherborn | st_ally | st_angel | st_ape | st_archer | st_artificer | st_assassin | st_avatar | st_elemental | st_elf | st_eye | st_illusion | st_insect | st_octopus | st_ogre | st_ooze | st_orc

leading_duration_changes ::= leading_keyword_toughness_changes | changes | leading_subtype_changes | leading_consonant_subtype_changes | leading_pump_retained_artifact

/* @sem Change::[...$change_becomes_subtype_an, ...$change, ...$changes] */
leading_subtype_changes ::= change_becomes_subtype_an "," change "," "and" changes

/* A static pump counts other controlled permanents relative to the affected object. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[Pump{power:@times($signed, Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Affected)), $filter_phrase, ControlledBy(One(AbilityController))])})), toughness:@times($signed_2, Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Affected)), $filter_phrase, ControlledBy(One(AbilityController))])}))}]} */
static_pump_other_controlled ::= affected "gets" signed "/" signed "for" "each" "other" filter_phrase "you" "control" "."

/* A singular subject takes a subtype and base stats with a list of granted abilities. */
/* @sem Change::[...$base_animation, ...$grants] */
change_singular_base_keywords ::= "becomes" base_animation "," grants

/* Each choice term is retained as an operand for recognition and printing. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Ability, terms:_{count:Exactly(Constant(1)), options:[$sharing_kind, $sharing_kind_2, $sharing_kind_3]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[LosesAbility(Term{family:CheckHasable, form:TheChosenAbility})], duration:$duration, evaluation:Snapshot}}] */
instructions_loses_chosen_keywords ::= affected "loses" "your" "choice" "of" sharing_kind "," sharing_kind "," "or" sharing_kind duration

/* A timed tax applies to opponents as players, preserving its live spell filter. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(OpponentsOf(AbilityController)), changes:[PlayerRule(SpellCost{spells:Any, modifier:Increase{parts:[Mana($mana_symbols)]}})], duration:$duration, evaluation:LiveObjects}}] */
clause_opponents_timed_spell_tax ::= duration "," "spells" "your" "opponents" "cast" "cost" mana_symbols "more" "to" "cast"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$noun_creature}), index:0} */
counter_type_creature_target ::= "target" noun_creature

/* The announced creature is both the counter recipient and the continuous
   effect's subject; the placement and duration counters are independent operands. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($counter_type_creature_target)), kind:$counter_kind, amount:Constant(1)}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($counter_type_creature_target)), changes:[CreatureTypes{mode:Add, types:Listed($becomes_types)}], duration:WhileMatches{object:$counter_type_creature_target, filter:Counters(_{kind:$counter_kind_2, comparison:Greater, value:Constant(0)})}, evaluation:Snapshot}}]} */
counter_creature_type_while_present ::= "put" "a" counter_kind "counter" "on" counter_type_creature_target "." "for" "as" "long" "as" "that" "creature" "has" "a" counter_kind "counter" "on" "it" "," "it's" "a" becomes_types "in" "addition" "to" "its" "other" "types" "."

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$counter_creature_type_while_present} */
activated_counter_creature_type ::= cost ":" counter_creature_type_while_present

/* The duration refers to the target itself, not the counter-placement receipt. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@last_slot, index:0})), changes:[GrantAbility(@scope($land_upkeep_damage_trigger))], duration:WhileMatches{object:Target{slot:@last_slot, index:0}, filter:Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})}, evaluation:Snapshot} */
counter_land_grant ::= "for" "as" "long" "as" "that" "land" "has" "a" counter_kind "counter" "on" "it" "," "it" "has" '"' land_upkeep_damage_trigger '"'

/* The suspend-access rule keeps the eligible cards as an independent filter.
   Its timing and mana-value counters are inherent in the Suspend access contract. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule($hand_suspend_access)]} */
static_hand_suspend_access ::= "any" "time" "you" "could" "cast" "a" "sorcery" "," "you" hand_suspend_access "."

/* @sem PlayerRule::KeywordAccess{keyword:Suspend, cards:$hand_suspend_filter, from:Hand} */
hand_suspend_access ::= "may" "exile" "a" hand_suspend_filter "card" "from" "your" "hand" "with" "X" "time" "counters" "on" "it" "," "where" "X" "is" "its" "mana" "value" "." "if" "the" "exiled" "card" "doesn't" "have" "suspend" "," "it" "gains" "suspend"

hand_suspend_filter ::= adjective_nontype | adjective_color

/* A casting origin and threshold qualify the spell population; each quoted
   spell effect remains an independent granted operand. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellsHaveAbilities{spells:@and($cast_spells_filter, $spell_cost_threshold), from:Hand, abilities:List([$spell_mana_grant_effect, $spell_mana_grant_effect_2])})]}) */
static_hand_cast_quoted_effects ::= cast_spells_filter "you" "cast" "from" "your" "hand" spell_cost_threshold "have" '"' spell_mana_grant_effect "," spell_mana_grant_effect "." '"'

/* The permission's player and spell filter remain separate operands. */
/* @sem Ability::Static{kind:Ordinary, affected:Players($color_spending_players), changes:[$spell_color_spending]} */
static_spell_color_spending ::= color_spending_players spell_color_spending "."

/* @sem Change::PlayerRule(SpendManaAs{spend_as:AnyColor, on:Spells($filter_phrase)}) */
spell_color_spending ::= "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" filter_phrase "spells"

/* Activation filters and generic reductions compose independently. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(ActivationCost{abilities:$you_activation_filter, change:Reduce($generic_reduction_symbols), floor:1})]} */
static_you_activation_reduction_floor ::= "abilities" "you" "activate" you_activation_filter "cost" generic_reduction_symbols "less" "to" "activate" "." "this" "effect" "can't" "reduce" "the" "mana" "in" "that" "cost" "to" "less" "than" "one" "mana" "."

/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(ActivationCost{abilities:$you_activation_filter, change:Reduce($generic_reduction_symbols)})]} */
static_you_activation_reduction ::= "abilities" "you" "activate" you_activation_filter "cost" generic_reduction_symbols "less" "to" "activate" "."

you_activation_filter ::= you_activation_nonmana | you_activation_mana

/* @sem ObjectFilter::Not(OnStack(Mana)) */
you_activation_nonmana ::= "that" "aren't" "mana" "abilities"

/* @sem ObjectFilter::OnStack(Mana) */
you_activation_mana ::= "that" "are" "mana" "abilities"

/* The cost belongs to each receiving card, and is reduced by the printed amount. */
/* @sem Ability::Mechanic{mechanic:Miracle, cost:_{parts:[ManaCostReduced{reduction:$single_generic_reduction}]}} */
hand_card_miracle_reduced ::= "miracle" "." "its" "miracle" "cost" "is" "equal" "to" "its" "mana" "cost" "reduced" "by" single_generic_reduction

/* A casting-player grant composes the spell filter, origin, and granted term. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellsHaveAbilities{spells:$filter_phrase, from:Hand, abilities:List([$hand_cast_spell_effect])})]} */
static_hand_cast_spell_grant ::= filter_phrase "spells" "you" "cast" "from" "your" "hand" "have" hand_cast_spell_effect "."

/* @sem Operand::Term{family:SpellEffect, form:Blitz, operands:[Cost($cost)]} */
hand_cast_spell_effect ::= "blitz" cost

/* This receipt expression is only used within the matching casting-cost scope. */
/* @sem Expr::CountObjects(CostObjects{payment:Casting{ability:0}, component:[0], view:Performed, phase:Before}) */
casting_sacrificed_creature_count ::= "for" "each" "creature" "sacrificed" "this" "way"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:Multiply([$value, $casting_sacrificed_creature_count]), toughness:Multiply([$value_2, $casting_sacrificed_creature_count])}], duration:$duration, evaluation:Snapshot} */
casting_sacrifice_count_pump ::= affected "gets" "+" value "/" "+" value duration casting_sacrificed_creature_count

/* An activation cost increase and its excluded ability kind are independent. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(ActivationCost{abilities:Not(OnStack($shared_activation_kind)), change:Increase($kicker_operand_generic)})]}) */
static_activation_cost_except_kind ::= "activated" "abilities" "cost" kicker_operand_generic "more" "to" "activate" "unless" "they're" shared_activation_kind "abilities" "."

/* The possessive selects the affected players; the value supplies the adjustment. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players($hand_size_players), changes:[PlayerRule(HandSize(Adjust($value)))]}) */
static_maximum_hand_size_increase ::= hand_size_players "maximum" "hand" "size" "is" "increased" "by" value "."

/* A quoted additional payment applies to abilities of the described holders. */
/* @sem PlayerRule::ActivationCost{abilities:AbilityOf($filter_plural), change:Additional($cost)} */
activation_additional_payment_rule ::= "activated" "abilities" "of" filter_plural "cost" "an" "additional" '"' cost '"' "to" "activate"

/* @sem Ability::Static{kind:Ordinary, affected:Players(All), changes:[PlayerRule($activation_additional_payment_rule)]} */
static_activation_additional_payment ::= activation_additional_payment_rule "."

/* A mana-value bound composes with any supported spell-kind filter. */
/* @sem ObjectFilter::AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}]) */
limited_mana_value_spells ::= filter_phrase "spells" "with" "mana" "value" value "or" "less"

/* @sem PlayTerms::PlayTerms{cost:Free, flash:true} */
free_flash_plural_cast_terms ::= "without" "paying" "their" "mana" "costs" "and" "as" "though" "they" "had" "flash"

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Hand, players:One(Affected)}, kind:Card, filter:Any}), from:Hand, action:CastSpell, filter:$limited_mana_value_spells}, terms:$free_flash_plural_cast_terms})]}) */
any_player_limited_free_cast ::= "any" "player" "may" "cast" limited_mana_value_spells free_flash_plural_cast_terms "."

/* The color count refers to the explicit target, not an arbitrary affected set.
   The scaled change is reusable independently of the effect's duration. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($target_permanent)), changes:$target_color_scaled_change, duration:$duration, evaluation:Snapshot} */
targeted_color_scaled_snapshot ::= target_permanent target_color_scaled_change duration "for" "each" "of" "its" "colors"

/* @sem Change::[Pump{power:Multiply([$value, ObjectProperty{object:@named_object, property:ColorCount, information:CurrentOrLastKnown}]), toughness:Multiply([$value_2, ObjectProperty{object:@named_object, property:ColorCount, information:CurrentOrLastKnown}])}] */
target_color_scaled_change ::= "gets" "+" value "/" "+" value

/* A singular affected population can lose its abilities while retaining its
   existing types and receiving new base characteristics. */
/* @sem Change::[...$singular_loss, ...$singular_retained_subtype, ...$singular_base_stats] */
loss_retained_type_stats ::= singular_loss "," singular_retained_subtype "," "and" singular_base_stats

/* @sem Change::[CreatureTypes{mode:Add, types:Listed($becomes_types)}] */
singular_retained_subtype ::= "becomes" "a" becomes_types "in" "addition" "to" "its" "other" "types"

/* A permanent-spell subtype and the granted alternate casting cost are independent. */
/* @sem ObjectFilter::AllOf([$shared_cast_permanent_subtype, AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)])]) */
shared_typed_permanent_spells ::= shared_cast_permanent_subtype "permanent" "spells"

/* @sem Operand::Term{family:SpellEffect, form:Evoke, operands:[Cost{parts:[Mana($mana_symbols)]}]} */
shared_evoke_cast_grant ::= "evoke" mana_symbols

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellsHaveAbilities{spells:$shared_typed_permanent_spells, from:Hand, abilities:List([$shared_evoke_cast_grant])})]}) */
static_hand_cast_evoke_grant ::= shared_typed_permanent_spells "you" "cast" "from" "your" "hand" "gain" shared_evoke_cast_grant "as" "you" "cast" "them" "."

shared_cast_permanent_subtype ::= creature_subtype | shared_cast_elemental_subtype

/* @sem ObjectFilter::Subtype(Elemental) */
shared_cast_elemental_subtype ::= "elemental"

/* @sem ObjectFilter::Not(Cast{from:Players{zone:Hand, players:One(CasterOf(Candidate))}}) */
cast_origin_except_caster_hand ::= "from" "anywhere" "other" "than" "your" "hand"

/* The source filter and the targeted objects are independent ability predicates. */
/* @sem ObjectFilter::AllOf([AbilityOf($filter_phrase), TargetsAny(Objects($affected))]) */
targeted_activated_abilities ::= "activated" "abilities" "of" filter_phrase "that" "target" affected

/* @sem Ability::Static{kind:Ordinary, affected:Players(All), changes:[PlayerRule(ActivationCost{abilities:$targeted_activated_abilities, change:Reduce($generic_reduction_symbols)})]} */
static_targeted_activation_reduction ::= targeted_activated_abilities "cost" generic_reduction_symbols "less" "to" "activate" "."

/* The loss and the new colored creature form are independent changes in the
   same indefinite snapshot; each operand remains available to the printer. */
/* @sem Change::[...$singular_loss, ...$colored_creature_form] */
loss_colored_creature_change ::= singular_loss "and" "becomes" colored_creature_form

/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word]}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetCardTypes([Creature]), SetBasePowerToughness{power:$value, toughness:$value_2}] */
colored_creature_form ::= "a" mana_color_word becomes_types "creature" "with" "base" "power" "and" "toughness" value "/" value

/* A plural hand population grants each card its own costed mechanic. */
/* @prefer always */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($hand_cards_population), changes:[GrantAbility(@holder($hand_granted_cost_mechanic))]} */
static_hand_cards_cost_mechanic ::= hand_cards_population "have" hand_granted_cost_mechanic "."

/* @sem Ability::Mechanic{mechanic:$hand_cost_mechanic_name, cost:Cost{parts:[Mana($mana_symbols)]}} */
hand_granted_cost_mechanic ::= hand_cost_mechanic_name mana_symbols

hand_cost_mechanic_name ::= hand_mechanic_warp | hand_mechanic_miracle | hand_mechanic_ninjutsu | hand_mechanic_foretell

/* @sem Mechanic::Warp */
hand_mechanic_warp ::= "warp"

/* @sem Mechanic::Miracle */
hand_mechanic_miracle ::= "miracle"

/* @sem Mechanic::Ninjutsu */
hand_mechanic_ninjutsu ::= "ninjutsu"

/* @sem Mechanic::Foretell */
hand_mechanic_foretell ::= "foretell"

/* A card population and its granted mechanic are independent operands. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($hand_grant_population), changes:[GrantAbility($hand_granted_mechanic)]} */
static_hand_card_mechanic ::= hand_grant_population "have" hand_granted_mechanic "."

/* @sem ObjectSet::Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$grant_hand_card_filter} */
hand_grant_population ::= grant_hand_card_filter "in" "your" "hand"

grant_hand_card_filter ::= grant_hand_card_filter_pair | grant_hand_card_filter_single

/* @sem ObjectFilter::AnyOf([$filter_phrase, $filter_phrase_2]) */
grant_hand_card_filter_pair ::= filter_phrase "cards" "and" filter_phrase "cards"

/* @sem ObjectFilter::$noun_atomic */
grant_hand_card_filter_single ::= noun_atomic "cards"

/* @sem Ability::Mechanic{mechanic:Warp, cost:$cost} */
hand_granted_mechanic ::= "warp" cost

/* Timed loss composes a subject with an independently typed keyword change. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$change_lose_keyword, duration:$duration, evaluation:Snapshot} */
timed_plural_keyword_loss ::= affected change_lose_keyword duration

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$change_loses_keyword, duration:$duration, evaluation:Snapshot} */
timed_singular_keyword_loss ::= affected change_loses_keyword duration

/* @sem Operand::Term{family:CheckHasable, form:Indestructible, operands:[]} */
lost_indestructible ::= "indestructible"

/* A hand population and its granted mechanic retain their separate operands. */
/* @sem ObjectSet::Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AllOf([$adjective_nontype, Not(HasKeywordFamily(Foretell))])} */
foretell_eligible_hand_cards ::= "each" adjective_nontype "card" "in" "your" "hand" "without" "foretell"

/* @sem Ability::Static{kind:Ordinary, affected:Objects($foretell_eligible_hand_cards), changes:[GrantAbility($foretell_reduced_grant)]} */
static_grant_reduced_foretell ::= foretell_eligible_hand_cards "has" foretell_reduced_grant "."

/* The offset repeats the same measured value in both characteristics. */
/* @sem Change::SetBasePowerToughness{power:$value, toughness:Add([$value, $value_2])} */
defining_power_with_toughness_offset ::= "power" "is" "equal" "to" value "and" "its" "toughness" "is" "equal" "to" "that" "number" "plus" value

/* @prefer always */
/* @sem Ability::@defining_static(Ability::Static{kind:Ordinary, affected:Objects(One($named_possessive_ref)), changes:[$defining_power_with_toughness_offset]}) */
static_named_power_with_offset ::= named_possessive_ref defining_power_with_toughness_offset "."

/* Preserve the leading wording for the phase prohibition when printing. */
/* @prefer always */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$rule_cant_phase_out, duration:$duration, evaluation:LiveObjects} */
continuous_phase_rule_leading ::= duration "," affected rule_cant_phase_out

/* A prohibition applies to the affected objects for the enclosing duration. */
/* @sem Change::[Rule(Prohibit(PhaseOut))] */
rule_cant_phase_out ::= "can't" "phase" "out"

/* The same linked-exile permission also stands alone as a static ability. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:$exile_lands_and_spells}) */
static_linked_exile_permissions ::= exile_lands_and_spells "."

/* A choice between two named land types retains both vocabulary operands. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:LandType, terms:_{count:Exactly(Constant(1)), options:[$article_land_type, $article_land_type_2]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[ChosenType(_{kind:LandType, mode:Add})], duration:$duration, evaluation:Snapshot}}] */
clause_land_type_pair_timed ::= affected "becomes" article_land_type "or" article_land_type duration

article_land_type ::= article_land_type_a | article_land_type_an

/* @sem Operand::$consonant_choice_land_type */
article_land_type_a ::= "a" consonant_choice_land_type

/* @sem Operand::$choice_land_type_island */
article_land_type_an ::= "an" choice_land_type_island

consonant_choice_land_type ::= choice_land_type_plains | choice_land_type_swamp | choice_land_type_mountain | choice_land_type_forest

/* Linked exile permissions share the same card population and casting terms. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:$linked_lands_cast_changes}) */
static_linked_lands_cast ::= linked_lands_cast_changes "."

/* @sem Change::[PlayerRule(PlayPermission{cards:$linked_permission_population, from:Exile, action:PlayLand, filter:Any}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$linked_permission_population, from:Exile, action:CastSpell, filter:Any}, terms:$linked_cast_spending_terms})] */
linked_lands_cast_changes ::= "you" "may" "play" "lands" "and" "cast" "spells" "from" "among" linked_permission_population "." linked_cast_spending_terms

linked_permission_population ::= permission_linked_exile_cards | permission_owned_linked_exile_cards

linked_cast_spending_terms ::= linked_cast_spending_any_color | linked_cast_spending_any_type

/* @sem PlayTerms::PlayTerms{cost:Normal, spend_as:AnyColor} */
linked_cast_spending_any_color ::= "if" "you" "cast" "a" "spell" "this" "way" "," "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "it"

/* @sem PlayTerms::PlayTerms{cost:Normal, spend_as:AnyType} */
linked_cast_spending_any_type ::= "if" "you" "cast" "a" "spell" "this" "way" "," "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "type" "to" "cast" "it"

/* A spell population, a cost modifier, and its caster's turn exception compose. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players($spell_cost_turn_casters), changes:[PlayerRule(SpellCost{spells:$each_spell_cost_filter, modifier:$spell_cost_change})]}) */
static_controller_turn_spell_cost ::= each_spell_cost_filter "costs" spell_cost_change "to" "cast" spell_cost_turn_casters "."

each_spell_cost_filter ::= each_unfiltered_cost_spell | each_filtered_cost_spell

/* @sem ObjectFilter::Any */
each_unfiltered_cost_spell ::= "each" "spell"

/* @sem ObjectFilter::$filter_phrase */
each_filtered_cost_spell ::= "each" filter_phrase "spell"

/* @sem PlayerSet::OthersThan(Active) */
spell_cost_turn_casters ::= "except" "during" "its" "controller's" "turn"

/* A singular cast population and a reduction per matching target compose independently. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$target_count_cast_subject, modifier:$spell_cost_per_matching_target})]}) */
static_singular_target_count_cost ::= target_count_cast_subject "you" "cast" "costs" spell_cost_per_matching_target "."

/* The affected spell supplies the target set; the filter and reduction factor are operands. */
/* @sem SpellCostModifier::Reduce{reductions:[_{amount:@times($braced_number, Expr::CountObjects(Matching{objects:TargetsOf(Affected), filter:$filter_phrase}))}], spill_into_generic:true} */
spell_cost_per_matching_target ::= braced_number "less" "to" "cast" "for" "each" filter_phrase "it" "targets"

/* Prefer the conjunction spelling for this singular cost construction. */
target_count_cast_subject ::= target_count_cast_union | target_count_cast_single | singular_cast_cost_any

/* @sem $card_filter_and */
target_count_cast_union ::= "each" card_filter_and "spell" /* @prefer always */

/* @sem $card_word */
target_count_cast_single ::= "each" card_word "spell"

/* Capture the controlled creature population once for both follow-ups. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateContinuousEffect{source:Source, affected:Objects($controlled_creature_population), changes:[SetController(AbilityController)], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:SetTapped{objects:Affected(@marked), tapped:false}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Affected(@marked)), changes:$grants, duration:$duration_2, evaluation:Snapshot}}] */
clause_control_creatures_untap_grant ::= "gain" "control" "of" controlled_creature_population duration "." "untap" "those" "creatures" "." "they" "gain" grants duration

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One($control_creature_player))])} */
controlled_creature_population ::= "all" "creatures" control_creature_player "controls"

control_creature_player ::= target_opponent | target_player

/* The paired prohibitions share a player effect; the sacrifice operand is the
   population of the immediately preceding characteristic effect. */
/* @sem Instruction::Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Prohibit(AttackInto(Players(One($that_player))))), PlayerRule(Prohibit(Sacrifice{objects:InSet(Affected(@prior))}))], duration:EndOfTurn, evaluation:LiveObjects}} */
clause_restrict_attack_sacrifice_prior ::= "you" "can't" "attack" that_player "this" "turn" "." "you" "can't" "sacrifice" "those" "creatures" "this" "turn"

/* The unconditional frame shares its permission clause with turn restrictions. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:$exile_lands_and_spells}) */
static_exile_lands_and_spells ::= exile_lands_and_spells "."

/* Linked exile sources and the playable population are independent operands. */
/* @sem Change::PlayerRule(PlayPermission{cards:Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_plural, ExiledWith($linked_exile_card_source)])}), from:Exile, action:PlayLand, filter:Any}) */
linked_exile_land_play_change ::= "play" filter_plural "from" "among" linked_exile_card_source

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[$linked_exile_land_play_change]}) */
static_linked_exile_land_play ::= "you" "may" linked_exile_land_play_change "."

/* A plural spell limit qualifies the linked permission as a whole. */
/* @sem PlayLimit::EachTurn(2) */
linked_cast_limit_two ::= "two" "spells"

/* @sem PlayLimit::EachTurn(3) */
linked_cast_limit_three ::= "three" "spells"

linked_cast_plural_limit ::= linked_cast_limit_two | linked_cast_limit_three

/* @sem Change::PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$permission_linked_exile_cards, from:Exile, action:CastSpell, filter:Any}, terms:_{limit:$linked_cast_plural_limit, cost:Normal}}) */
linked_cast_plural_permission ::= "you" "may" "cast" "spells" "from" "among" permission_linked_exile_cards "." "you" "can't" "cast" "more" "than" linked_cast_plural_limit "this" "way" "each" "turn"

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[$linked_cast_plural_permission]}) */
static_linked_cast_plural_permission ::= linked_cast_plural_permission "."

/* Both permissions refer to the same population; spending applies only to spells. */
/* @sem Change::[PlayerRule(PlayPermission{cards:$exiled_by_you_with_counters, from:Exile, action:PlayLand, filter:Any}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$exiled_by_you_with_counters, from:Exile, action:CastSpell, filter:$cast_spells_filter}, terms:_{cost:Normal, spend_as:AnyColor}})] */
exiled_counter_land_and_spell_permissions ::= "you" "may" "play" "lands" "and" "cast" cast_spells_filter "from" "among" exiled_by_you_with_counters "," "and" "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "those" "spells"

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:$exiled_counter_land_and_spell_permissions}) */
static_exiled_counter_permissions ::= exiled_counter_land_and_spell_permissions "."

/* Randomly chosen abilities are granted to the subject of the triggering event. */
/* @sem Operand::Ability(Keyword($keyword_name)) */
random_grant_option_keyword ::= keyword_name

/* @sem Operand::Ability(Keyword(Protection(Objects(_{kind:Any, filter:$adjective_color})))) */
random_grant_option_protection ::= "protection" "from" adjective_color

random_grant_option ::= random_grant_option_keyword | random_grant_option_protection

/* @sem Operand::[$random_grant_option, $random_grant_option_2, $random_grant_option_3, $random_grant_option_4, $random_grant_option_5, $random_grant_option_6, $random_grant_option_7] */
random_grant_seven_options ::= random_grant_option "," random_grant_option "," random_grant_option "," random_grant_option "," random_grant_option "," random_grant_option "," "and" random_grant_option

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Ability, terms:_{options:$random_grant_seven_options, random:true, count:Exactly($number)}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(EventSubject)), changes:[ChosenAbility], duration:Indefinite, evaluation:Snapshot}}]} */
random_grant_event_subject_program ::= "it" "gains" number "abilities" "chosen" "at" "random" "from" "among" random_grant_seven_options "."

random_grant_event ::= event_clause | whenever_controlled_entrant_zone_change

/* @sem Ability::Triggered{event:$random_grant_event, limits:_{}, announcement:@announcement, body:$random_grant_event_subject_program} */
triggered_random_grant_event_subject ::= random_grant_event "," random_grant_event_subject_program

/* The intervening condition establishes the antecedent of "it". */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[SetBasePowerToughness{power:$number_digits, toughness:$number_digits_2}, CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Creature)], duration:Indefinite, evaluation:Snapshot} */
source_becomes_typed_creature ::= "it" "becomes" "a" number_digits "/" number_digits becomes_types "creature"

/* Keyword payment reductions retain the payer, mechanic and generic amount. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players($target_tax_casters), changes:[PlayerRule(KeywordCost{keyword:$reduced_payment_keyword, cards:Any, change:Reduce($keyword_reduction_amount)})]}) */
static_keyword_payment_reduction ::= reduced_payment_keyword "costs" target_tax_casters "pay" "cost" keyword_reduction_amount "less" "."

/* @sem Mechanic::Dash */
reduced_payment_keyword ::= "dash"

/* @sem Operand::Term{family:CostReductionSymbol, form:CostReduceGeneric, operands:[Integer($number)]} */
keyword_reduction_amount ::= "{" NUMBER "}"

/* The controlled subtype population is fixed when the keyword is granted. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$controlled_grant_subtype, ControlledBy(One(AbilityController))])}), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot} */
continuous_controlled_subtypes_grant ::= controlled_grant_subtype "you" "control" "gain" keyword_name duration

controlled_grant_subtype ::= controlled_grant_humans | subtype_plural

/* @sem ObjectFilter::Subtype(Human) */
controlled_grant_humans ::= "humans"

/* A plural land population retains its land type while gaining creature stats. */
/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, AddCardType(Creature)] */
static_retained_land_creature_stats ::= "are" value "/" value "creatures" "that" "are" "still" "lands"

/* A three-part controlled population can share a temporary keyword grant. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$controlled_three_subject, ControlledBy(One(AbilityController))])}), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot} */
controlled_three_subject_temporary_keyword ::= controlled_three_subject "you" "control" "gain" keyword_name duration

/* @sem ObjectFilter::AnyOf([$controlled_three_first_subtype, $subtype_plural, $filter_plural_adjectives]) */
controlled_three_subject ::= controlled_three_first_subtype "," subtype_plural "," "and" filter_plural_adjectives

/* @sem ObjectFilter::Subtype(Aura) */
controlled_three_first_subtype ::= "auras"

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController), constraints:[AtRandom]}), index:0} */
control_random_target_opponent ::= "target" "opponent" "chosen" "at" "random"

/* A legendary animation names the resulting object and retains its printed keyword. */
/* @sem Change::[AddSupertype(Legendary), SetBasePowerToughness{power:$number, toughness:$number_2}, ...$legendary_creature_kind, GrantKeyword($keyword_name), SetName($referenced_card_name)] */
animation_legendary_named ::= "a" "legendary" number "/" number legendary_creature_kind "with" keyword_name "named" referenced_card_name

/* The crewed Vehicle is the other participant in a paired event. */
/* @sem ObjectSet::One(EventOther) */
event_other_vehicle_subject ::= "that" "Vehicle"

event_snapshot_subject ::= event_attacker_subject | event_other_vehicle_subject

/* @sem Ability::Mechanic{mechanic:Freerunning, cost:$cost} */
granted_freerunning ::= "freerunning" cost

/* The named creature population is the producer of both later references. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$pump_attacking_creatures}), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot}}, If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:SetTapped{objects:Affected(@marked), tapped:false}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Affected(@marked)), changes:[Pump{power:$signed_3, toughness:$signed_4}], duration:$duration_2, evaluation:Snapshot}}]}, otherwise:Program{}}] */
creature_pump_conditional_untap ::= pump_attacking_creatures "get" signed "/" signed duration "." "if" condition "," "untap" "those" "creatures" "and" "they" "get" "an" "additional" signed "/" signed duration

/* @sem ObjectFilter::AllOf([Attacking, CardType(Creature)]) */
pump_attacking_creatures ::= "attacking" "creatures"

/* The event subject is the player receiving control. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[SetController(EventSubject)], duration:Indefinite, evaluation:Snapshot} */
event_player_gains_control ::= "they" "gain" "control" "of" affected

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:CreatureType, terms:_{count:Exactly(Constant(1))}} */
embedded_creature_type_choice ::= "the" "creature" "type" "of" "your" "choice"

/* @sem Instruction::[Effect{result:@next, operation:$embedded_creature_type_choice}, Effect{result:@next, operation:CreateContinuousEffect{source:$object_ref, affected:Objects(One($object_ref)), changes:[ChosenType{kind:CreatureType, mode:Add}], duration:$duration, evaluation:Snapshot}}] */
clause_ref_add_creature_type_choice ::= object_ref "becomes" embedded_creature_type_choice "in" "addition" "to" "its" "other" "types" duration

/* This anaphor is only used inside the explicit target-choice program. */
/* @sem Change::[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})] */
chosen_creature_skip_next_untap ::= "the" "chosen" "creature" "doesn't" "untap" "during" "its" "controller's" "next" "untap" "step"

/* Base stats and a retained keyword apply after other abilities are removed. */
/* @sem Change::[...$static_singular_base_stats, RemoveAllAbilities, GrantKeyword($keyword_value)] */
static_base_keyword_other_loss ::= static_singular_base_stats "," "has" keyword_value "," "and" "loses" "all" "other" "abilities"

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}] */
static_singular_base_stats ::= "has" "base" "power" "and" "toughness" value "/" value

/* The noted player's draft record and the combat count remain independent. */
/* @sem PlayerSet::Matching{binding:0, condition:NotedForDraft{player:Bound(0), note:_{kind:Player, player:AbilityController, card:$referenced_card_name}}} */
noted_draft_player ::= "player" "you" "noted" "for" "cards" "named" referenced_card_name

/* @sem PlayerSet::Matching{binding:0, condition:NotedForDraft{player:Bound(0), note:_{kind:Player, player:AbilityController, card:$referenced_card_name}}} */
noted_draft_players ::= "players" "you" "noted" "for" "cards" "named" referenced_card_name

/* @sem Change::[Rule(RequireCombat{action:Attack(Players($noted_draft_player)), amount:AtLeast(Constant(1))})] */
rule_attack_noted_player ::= "attacks" "a" noted_draft_player "each" "combat" "if" "able"

/* @sem Change::[Rule(RequireCombat{action:Attack(Players($noted_draft_players)), amount:AtLeast(@plural_amount($noted_plural_amount))})] */
rule_attack_noted_players ::= "attacks" noted_plural_amount noted_draft_players "each" "combat" "if" "able"

noted_plural_amount ::= noted_plural_words | counter_amount

/* @prefer always */
/* @sem Expr::$number_words */
noted_plural_words ::= number_words

/* A retained-land sentence is valid only for an explicitly land population.
   The creature description composes the independent stats and keyword grant. */
/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, AddCardType(Creature), GrantKeyword($keyword_value)] */
plural_creature_stats_keyword ::= "are" value "/" value "creatures" "with" keyword_value

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Land), $land_control_modifier])} */
controlled_land_population ::= "lands" land_control_modifier

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($controlled_land_population), changes:$plural_creature_stats_keyword}) */
static_controlled_land_retained_keyword ::= controlled_land_population plural_creature_stats_keyword "." "they're" "still" "lands" "."

/* The possessive below is anchored to the self subject, not an arbitrary affected object. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(One($self_ref)), changes:$self_owner_combat_changes}) */
self_owner_combat_static ::= self_ref self_owner_combat_changes "."

self_owner_combat_changes ::= self_owner_attack_ban | self_rule_before_owner_ban

/* @sem Change::[...$rule_change, ...$self_owner_combat_changes] */
self_rule_before_owner_ban ::= rule_change "and" self_owner_combat_changes

/* @sem Change::[Rule(Prohibit(Attack(PlayersAndPlaneswalkers(One(OwnerOf(Source))))))] */
self_owner_attack_ban ::= "can't" "attack" "its" "owner" "or" "planeswalkers" "its" "owner" "controls"

/* The written population and the player whose untap step it is are independent. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($objects_all), changes:[Rule(UntapStep{players:$additional_untap_players, behavior:Additional})]} */
static_additional_untap_population ::= "untap" objects_all "during" additional_untap_players "untap" "step" "."

/* The type replacement and base stats form one reusable singular characteristic change. */
/* @sem Change::[CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetCardTypes([Creature]), SetBasePowerToughness{power:$value, toughness:$value_2}] */
shared_is_creature_form ::= "is" "a" becomes_types "creature" "with" "base" "power" "and" "toughness" value "/" value

/* @prefer always */
/* @sem Change::[...$singular_loss, ...$shared_is_creature_form] */
shared_loss_and_creature_form ::= singular_loss "and" shared_is_creature_form

/* The anaphoric count is scoped to the immediately preceding graveyard-type threshold. */
/* @sem Expr::Subtract([$value, CountDistinct{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}), property:CardTypes}]) */
graveyard_types_hand_size_value ::= "equal" "to" value "minus" "the" "number" "of" "those" "card" "types"

/* @sem Ability::Static(_{kind:Ordinary, affected:Players($hand_size_players), changes:[PlayerRule(HandSize(Set($graveyard_types_hand_size_value)))]}) */
graveyard_types_hand_size_rule ::= hand_size_players "maximum" "hand" "size" "is" graveyard_types_hand_size_value "."

/* @sem Ability::Conditional{condition:$graveyard_card_types_threshold, then:[$graveyard_types_hand_size_rule]} */
graveyard_types_conditional_hand_size ::= "as" "long" "as" graveyard_card_types_threshold "," graveyard_types_hand_size_rule

/* The affected objects share one evaluated base-stat value. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[SetBasePowerToughness{power:$value, toughness:$value}], duration:$duration, evaluation:Snapshot} */
have_equal_base_stats ::= "have" "the" "base" "power" "and" "toughness" "of" affected "become" "equal" "to" value duration

/* @prefer always */
/* @sem Change::[LosesAbility($lost_keyword), ...$lost_keyword_tail] */
lost_keyword_pair ::= lost_keyword "and" lost_keyword_tail

/* A comma-separated loss list distributes one verb over each named term. */
/* @sem Change::[LosesAbility($lost_list_keyword), ...$lost_comma_tail] */
lost_comma_list ::= lost_list_keyword "," lost_comma_tail

lost_comma_tail ::= lost_comma_more | lost_comma_final

/* @sem Change::[LosesAbility($lost_list_keyword), ...$lost_comma_tail] */
lost_comma_more ::= lost_list_keyword "," lost_comma_tail

/* @sem Change::[LosesAbility($lost_list_keyword)] */
lost_comma_final ::= "and" lost_list_keyword

lost_list_keyword ::= lost_keyword | lost_list_hexproof | lost_list_protection | lost_list_shroud | lost_list_ward

/* @sem Operand::Term{family:CheckHasable, form:AnyHexproof, operands:[]} */
lost_list_hexproof ::= "hexproof"

/* @sem Operand::Term{family:CheckHasable, form:AnyProtection, operands:[]} */
lost_list_protection ::= "protection"

/* @sem Operand::Term{family:CheckHasable, form:Shroud, operands:[]} */
lost_list_shroud ::= "shroud"

/* @sem Operand::Term{family:CheckHasable, form:AnyWard, operands:[]} */
lost_list_ward ::= "ward"

/* Each characteristic is measured from the revealed card at resolution. */
/* @sem Expr::Earlier{what:Revealed, measure:Of(Power)} */
observed_card_power ::= "that" "card's" "power"

/* @sem Expr::Earlier{what:Revealed, measure:Of(Toughness)} */
observed_card_toughness ::= "that" "card's" "toughness"

/* @sem Expr::@times(Expr::Constant(2), $observed_card_power) */
observed_power_twice ::= "twice" observed_card_power

/* @sem Expr::@times(Expr::Constant(2), $observed_card_toughness) */
observed_toughness_twice ::= "twice" observed_card_toughness

/* @sem Change::[SetPower($observed_power_twice), SetToughness($observed_toughness_twice)] */
observed_base_stats ::= "base" "power" "becomes" observed_power_twice "and" "its" "base" "toughness" "becomes" observed_toughness_twice

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_possessive)), changes:$observed_base_stats, duration:$duration, evaluation:Snapshot} */
leading_observed_base_stats ::= duration "," self_possessive observed_base_stats

/* The exclusion, controller and both independently described kinds qualify the same population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), $filter_phrase, ControlledBy(One(AbilityController)), $filter_phrase_2])} */
affected_each_other_controlled_kind ::= "each" "other" filter_phrase "you" "control" "that's" "a" filter_phrase

/* A granted trigger retains its own event and the holder as its source. */
/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$quoted_optional_exile_program} */
quoted_temporary_exile_trigger ::= event_clause "," quoted_optional_exile_program "."

/* Prefer the bare plural for this quoted grant without changing other populations. */
/* @prefer always */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected_plural), changes:[GrantAbility(@holder($quoted_temporary_exile_trigger))]} */
plural_quoted_temporary_exile_grant ::= affected_plural "have" '"' quoted_temporary_exile_trigger '"'

/* Color and type changes retain independent operands for inverse printing. */
/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word]}] */
static_is_color ::= "is" mana_color_word

/* A target group composes with characteristic changes and their duration. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($objects_announced_x_targets), changes:$changes, duration:$duration, evaluation:Snapshot} */
continuous_x_group_snapshot ::= objects_announced_x_targets changes duration

/* The land permission and spell permission retain their independent filters. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:AllOf([CardType(Land), InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), from:Graveyard, action:PlayLand, filter:Any}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}), from:Graveyard, action:CastSpell, filter:CardType(Creature)}, terms:_{cost:Normal, effects:[$graveyard_cast_creature_entry]}})]}) */
static_graveyard_land_spell_entry ::= "you" "may" "play" "lands" "and" "cast" "creature" "spells" "from" "your" "graveyard" "." graveyard_cast_creature_entry

/* A pump and a numbered granted mechanic compose without changing the
   preferred spelling of independent mechanic grants. */
/* @sem Change::[...$singular_pump, ...$singular_gains_valued_mechanic] */
changes_pump_and_valued_mechanic ::= singular_pump "and" singular_gains_valued_mechanic

/* @sem Change::[GrantAbility(@holder($pump_granted_valued_mechanic))] */
singular_gains_valued_mechanic ::= "gains" pump_granted_valued_mechanic

/* @sem Ability::Mechanic{mechanic:$pump_granted_valued_name, amount:$value} */
pump_granted_valued_mechanic ::= pump_granted_valued_name value

pump_granted_valued_name ::= defined_amount_mechanic_name | granted_valued_name

/* A pump and an additive artifact type apply to the same subject. */
/* @sem Change::[...$static_singular_pump, ...$singular_retained_artifact] */
static_pump_and_retained_artifact ::= static_singular_pump "and" singular_retained_artifact

/* @sem Change::[AddCardType(Artifact)] */
singular_retained_artifact ::= "is" "an" "artifact" "in" "addition" "to" "its" "other" "types"

/* A static subject is the battlefield population controlled by the enchanted player. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$entry_enchanted_player_controlled} */
static_enchanted_player_population ::= entry_enchanted_player_controlled

/* A graveyard threshold qualifies the source spell's protection on the stack. */
/* @sem Ability::Scoped{zones:[Stack], condition:$condition_graveyard_either_kind_threshold, ability:$stack_self_counter_prohibition} */
stack_graveyard_threshold_prohibition ::= "if" condition_graveyard_either_kind_threshold "," stack_self_counter_prohibition "."

/* The characteristic pair is reusable independently of the affected set. */
/* @sem Change::[SwitchPowerToughness] */
switch_characteristics ::= "power" "and" "toughness"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$switch_characteristics, duration:$duration, evaluation:Snapshot} */
continuous_switch_characteristics ::= "switch" "the" switch_characteristics "of" affected duration

/* A shared X defines both base characteristics for a fixed population. */
/* @sem Operation::@where(Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$base_stats_x_change, duration:$duration, evaluation:Snapshot}, $owned_public_zone_count) */
duration_plural_defined_base_stats ::= duration "," affected "have" "base" "power" "and" "toughness" base_stats_x_change "," "where" "X" "is" owned_public_zone_count

/* A retained creature subtype and a separately scoped quoted trigger. */
/* @sem Change::CreatureTypes{mode:Add, types:Listed([@subtype_name($subtype)])} */
shared_added_a_type ::= "is" "a" subtype "in" "addition" "to" "its" "other" "types"

/* @sem Change::[$shared_added_a_type, $shared_granted_trigger_closed] */
shared_a_type_and_trigger ::= shared_added_a_type "and" "has" shared_granted_trigger_closed

/* A permanent may be protected from being attacked. */
/* @sem Change::[Rule(Prohibit(BeAttacked))] */
rule_cant_be_attacked ::= "can't" "be" "attacked"

/* @sem Change::[Rule(Prohibit(BeTargeted(OnStack(Triggered))))] */
target_ban_triggered ::= "triggered" "abilities"

/* @sem Change::[Rule(Prohibit(BeTargeted(OnStack(Activated))))] */
target_ban_activated ::= "activated" "abilities"

static_unless_condition ::= condition | condition_attacked_or_blocked_turn

/* A controlled disjunction of creature subtypes is a reusable static subject. */
/* @sem ObjectFilter::AnyOf([$subtype, $five_subtype_after_comma, $five_subtype_after_comma_2, $five_subtype_after_comma_3, $subtype_2]) */
controlled_five_subtype_union ::= subtype "," five_subtype_after_comma "," five_subtype_after_comma "," five_subtype_after_comma "," "and" subtype

/* @prefer always */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$controlled_five_subtype_union, CardType(Creature), ControlledBy(One(AbilityController))])} */
controlled_five_subtypes_each ::= "each" controlled_five_subtype_union "creature" "you" "control"

/* @prefer always */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($controlled_five_subtypes_each), changes:$five_subtype_static_changes}) */
static_five_subtype_changes ::= controlled_five_subtypes_each five_subtype_static_changes "."

five_subtype_static_changes ::= static_added_type_and_valued_grant | static_changes

/* @prefer always */
/* @sem Change::[...$static_add_creature_type_a, GrantAbility($five_subject_valued_mechanic)] */
static_added_type_and_valued_grant ::= static_add_creature_type_a "and" "has" five_subject_valued_mechanic

five_subject_valued_mechanic ::= granted_valued_mechanic | five_subject_saddle

/* @sem Ability::Mechanic{mechanic:Saddle, amount:$value} */
five_subject_saddle ::= "saddle" value

five_subtype_after_comma ::= subtype | comma_capital_cat

/* @sem ObjectFilter::Subtype(Cat) */
comma_capital_cat ::= "↑" "cat"

/* @sem Change::[...$static_is_color, ...$closed_grants] */
static_color_and_closed_grants ::= static_is_color "and" "has" closed_grants

/* @sem Operand::Term{family:CheckHasable, form:AnyBandsWithOthers, operands:[]} */
lost_bands_with_other ::= "all" '"' "↓" "bands" "with" "other" '"' "abilities"

/* A singular subject loses a named ability for the stated duration. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$change_loses_keyword, duration:$duration, evaluation:Snapshot} */
affected_loses_keyword_duration ::= affected change_loses_keyword duration

/* A singular color change followed by the final quoted grant. */
/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word]}, ...$static_changes_closed] */
static_color_closed_more ::= "is" mana_color_word "," "and" static_changes_closed

/* Both follow-ups name the same previously affected population. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:Affected(@prior), tapped:false}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Affected(@back(3))), changes:$plural_additional_pump, duration:$duration, evaluation:Snapshot}}] */
prior_creatures_untap_additional ::= "untap" "those" "creatures" "and" "they" plural_additional_pump duration

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}] */
plural_additional_pump ::= "get" "an" "additional" signed "/" signed

/* A complete choice program is replaced when the subsequent condition holds. */
/* @sem Program::Program{instructions:$instructions_gains_keyword_choice} */
choice_keyword_fallback ::= instructions_gains_keyword_choice

/* @sem Instruction::[If{condition:$choice_replacement_condition, then:$program, otherwise:$choice_keyword_fallback}] */
instructions_choice_conditional_instead ::= choice_keyword_fallback "." "if" choice_replacement_condition "," program "instead"

/* @sem Condition::ObjectMatches{object:$that_noun, filter:$replacement_named_state} */
choice_replacement_condition ::= that_noun "is" replacement_named_state

replacement_named_state ::= it_state | condition_state

/* Choosing the replaced type is implicit in this text-changing instruction. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:CreatureType, terms:_{count:Exactly(Constant(1)), options:[]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[ReplaceWord{from:Term{family:CreatureTypeVariable, form:TheChosenCreatureType}, to:Vocabulary{family:CreatureType, form:@subtype_name($creature_subtype)}}], duration:Indefinite, evaluation:Snapshot}}] */
instructions_replace_creature_type_word ::= "change" "the" "text" "of" affected "by" "replacing" "all" "instances" "of" "one" "creature" "type" "with" creature_subtype

/* A creature population gets temporary changes, then that same population is untapped. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($pump_untap_creatures), changes:[...$plural_pump_change, ...$plural_gain_change], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:SetTapped{objects:$pump_untap_creatures}}] */
instructions_creature_pump_grant_untap ::= pump_untap_creatures plural_pump_change "and" plural_gain_change duration "." "untap" "those" "creatures"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::CardType(Creature), $pump_untap_controller)} */
pump_untap_creatures ::= "creatures" pump_untap_controller

pump_untap_controller ::= modifier_you_control | modifier_not_controlled | modifier_opponent_controls

/* This producer guarantees that the affected snapshot consists of creatures,
   so the follow-up names precisely that recorded population. */
/* @sem Instruction::[Effect{result:@next, operation:$controlled_creatures_snapshot}, $untap_affected_creatures] */
clause_creatures_snapshot_untap ::= controlled_creatures_snapshot "." untap_affected_creatures

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), $creature_controller_modifier])}), changes:$plural_snapshot_change, duration:$duration, evaluation:Snapshot} */
controlled_creatures_snapshot ::= "creatures" creature_controller_modifier plural_snapshot_change duration

creature_controller_modifier ::= modifier_you_control | modifier_opponents_control

plural_snapshot_change ::= plural_snapshot_pump | plural_snapshot_grant

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}] */
plural_snapshot_pump ::= "get" signed "/" signed

/* @sem $grants */
plural_snapshot_grant ::= "gain" grants

/* @sem Instruction::Effect{result:@next, operation:SetTapped{objects:Affected(@prior)}} */
untap_affected_creatures ::= "untap" "those" "creatures"

/* A controlled target remains the same object through untapping and a temporary grant. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$control_untap_creature_filter}), index:0})), changes:[SetController(AbilityController)], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:SetTapped{objects:One(Target{slot:0, index:0}), tapped:false}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:0, index:0})), changes:[GrantKeyword($keyword_name)], duration:$duration_2, evaluation:Snapshot}}] */
control_untap_creature_keyword ::= "gain" "control" "of" "target" control_untap_creature_filter duration "." "untap" "that" "creature" "." "it" "gains" keyword_name duration

control_untap_creature_filter ::= noun_creature | control_untap_qualified_creature

/* @sem @and($adjective, $noun_creature) */
control_untap_qualified_creature ::= adjective noun_creature

/* The quoted ability is scoped to the granted holder. */
/* @sem Instruction::[Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Target{slot:0, index:0}), changes:[GrantAbility($creature_quoted_static)]}}] */
target_perpetual_quoted_grant ::= "it" "perpetually" "gains" creature_quoted_static

/* @sem Ability::Static{kind:Ordinary, affected:Objects(One(Source)), changes:$creature_quoted_changes} */
creature_quoted_static ::= '"' "this" "creature" creature_quoted_changes "." '"'

creature_quoted_changes ::= creature_quoted_attack | creature_quoted_block

/* @sem Change::[Rule(RequireCombat{action:Attack(Any), amount:AtLeast(Constant(1))})] */
creature_quoted_attack ::= "attacks" "each" "combat" "if" "able"

/* @sem Change::[Rule(RequireCombat{action:Block(Any), amount:AtLeast(Constant(1))})] */
creature_quoted_block ::= "blocks" "each" "combat" "if" "able"

/* @prefer always */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$control_untap_creature_keyword, ...$target_perpetual_quoted_grant]}} */
spell_control_untap_perpetual ::= control_untap_creature_keyword "." target_perpetual_quoted_grant

/* @sem Operand::Term{family:CheckHasable, form:AnyLandwalk, operands:[]} */
lost_any_landwalk ::= "all" "landwalk" "abilities"

/* A loss and a type replacement share the same affected set and duration. */
/* @sem Change::[...$change_loses_keyword, ...$change_creature_types] */
changes_keyword_loss_and_creature_types ::= change_loses_keyword "and" change_creature_types

lost_keyword_singular ::= lost_flanking | lost_keyword

/* @sem Operand::Term{family:CheckHasable, form:Flanking, operands:[]} */
lost_flanking ::= "flanking"

/* An animated permanent can explicitly lose its Equipment subtype. */
/* @sem Change::[...$animation_plain, RemoveSubtype(Equipment)] */
change_animation_loses_equipment ::= "becomes" animation_plain "that's" "no" "longer" "an" "Equipment"

/* The same origin supplies both the permission and the restriction. */
/* @sem Ability::[Scoped{zones:[$own_cast_zone], ability:Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Source), from:$own_cast_zone, action:CastSpell, filter:Any})]})}, Casting(Require(WasCastFrom{object:Source, zone:$own_cast_zone}))] */
source_cast_only_own_zone ::= "you" "may" "cast" "this" "card" "from" own_cast_zone "," "but" "not" "from" "anywhere" "else" "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:$cast_spells_filter})]}) */
cast_filtered_from_graveyard ::= "you" "may" "cast" cast_spells_filter "from" "your" "graveyard" "."

/* @sem Ability::Conditional{condition:$condition_self_on_battlefield, then:[$cast_filtered_from_graveyard]} */
conditional_cast_filtered_from_graveyard ::= "as" "long" "as" condition_self_on_battlefield "," cast_filtered_from_graveyard

room_trigger_behavior ::= room_trigger_again | room_trigger_never

/* @prefer always */
/* @sem TriggerRule::TriggersAgain */
room_trigger_again ::= "trigger" "an" "additional" "time"

/* @sem TriggerRule::DoesntTrigger */
room_trigger_never ::= "don't" "trigger"

room_dungeon_owner ::= room_dungeon_you_own | room_dungeon_active_owns | room_dungeon_each_owns

/* @prefer always */
/* @sem PlayerSet::One(AbilityController) */
room_dungeon_you_own ::= "you" "own"

/* @sem PlayerSet::One(Active) */
room_dungeon_active_owns ::= "the" "active" "player" "owns"

/* @sem PlayerSet::All */
room_dungeon_each_owns ::= "each" "player" "owns"

/* The two eligible blocker populations share the same exception filter as timed effects. */
/* @sem Change::[Rule(Prohibit(BeBlocked(Not($blocker_exception_union))))] */
rule_cant_be_blocked_except_union ::= "can't" "be" "blocked" "except" "by" blocker_exception_union

/* A singular card assumes a creature type and receives two perpetual changes. */
/* @sem Change::[CreatureTypes{mode:Set, types:Listed($becomes_type_one)}, Pump{power:$signed, toughness:$signed_2}, GrantKeyword($keyword_value)] */
perpetual_type_pump_keyword ::= "becomes" "a" becomes_type_one "," "gets" signed "/" signed "," "and" "gains" keyword_value

/* These changes apply together to the already established creature population. */
/* @sem Change::[Rule(RequireCombat{action:Attack(Any), amount:AtLeast(Constant(1))}), ...$rule_cant_attack_you] */
removed_creatures_combat_rules ::= "each" "of" "those" "creatures" "attacks" "that" "combat" "if" "able" "." "they" rule_cant_attack_you "that" "combat"

/* A temporary free cast permission follows the targeted card and redirects the resulting spell. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One($free_cast_target_from_your_graveyard), from:Graveyard, action:CastSpell, filter:Any}, terms:_{cost:Free, into_exile:true}})], duration:$duration, evaluation:LiveObjects} */
free_target_graveyard_cast_redirect ::= duration "," "you" "may" "cast" free_cast_target_from_your_graveyard "without" "paying" "its" "mana" "cost" "." "if" "that" "spell" "would" "be" "put" "into" "your" "graveyard" "," "exile" "it" "instead"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and($card_filter, ObjectFilter::InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}))}), index:0} */
free_cast_target_from_your_graveyard ::= "target" card_filter "card" "from" "your" "graveyard"

/* The counted counters belong to each affected permanent. */
/* @sem Change::[SetCardTypes([Creature]), SetBasePowerToughness{power:CountCounters(_{recipients:Objects(One(Affected)), kind:$counter_kind, information:CurrentOrLastKnown}), toughness:CountCounters(_{recipients:Objects(One(Affected)), kind:$counter_kind, information:CurrentOrLastKnown})}] */
shared_counter_creature_form ::= "is" "a" "creature" "with" "power" "and" "toughness" "each" "equal" "to" "the" "number" "of" counter_kind "counters" "on" "it"

/* @sem Change::[...$singular_loss, ...$shared_counter_creature_form] */
shared_loss_counter_creature_form ::= singular_loss "and" shared_counter_creature_form

/* @prefer always */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($each_positive_counter_population), changes:$shared_loss_counter_creature_form} */
static_each_counter_characteristic ::= each_positive_counter_population shared_loss_counter_creature_form "."

/* A cast permission and its filtered spell change retain independent operands. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[$top_cast_with_closed_terms]}) */
static_top_cast_with_terms ::= "you" "may" top_cast_with_closed_terms

/* @sem Change::PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, from:Library, action:CastSpell, filter:$cast_spells_filter}, terms:$top_library_granted_trigger_terms}) */
top_cast_with_closed_terms ::= "cast" cast_spells_filter "from" "the" "top" "of" "your" "library" "." top_library_granted_trigger_terms

/* The quoted trigger has its own holder, announcement, and body. */
/* @sem PlayTerms::PlayTerms{cost:Normal, effects:[Filter($filter_phrase), Program{instructions:[Effect{result:@next, operation:ChangeSpell{subject:One(EventSubject), changes:[$top_cast_granted_trigger]}}]}]} */
top_library_granted_trigger_terms ::= "when" "you" "cast" "an" filter_phrase "spell" "this" "way" "," "it" "gains" top_cast_granted_trigger

/* The entering holder is a permanent; this form remains valid for any spell type. */
top_cast_granted_trigger ::= top_cast_permanent_entry_trigger | shared_granted_trigger_closed

/* @prefer always */
/* @sem Change::GrantAbility(@scope(Ability::Triggered{event:ZoneChange{objects:SameObject(Source), to:Battlefield}, limits:_{}, announcement:@announcement, body:$program})) */
top_cast_permanent_entry_trigger ::= '"' "when" "this" "permanent" "enters" "," program "." '"'

/* The toughness change and its own-object definition compose at snapshot time. */
/* @sem Operation::@where(Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$change_gets_defined_toughness, duration:$duration, evaluation:Snapshot}, $affected_mana_definition) */
continuous_own_mana_defined_snapshot ::= affected change_gets_defined_toughness duration "," "where" "X" "is" affected_mana_definition

/* @sem Change::[Pump{power:$value, toughness:AnnouncedX}] */
change_gets_defined_toughness ::= "gets" "+" value "/" "+" "X"

/* @sem Expr::ObjectProperty{object:Affected, property:ManaValue, information:CurrentOrLastKnown} */
affected_mana_definition ::= "its" "mana" "value"

/* A controlled basic-land population grants a separately scoped activation. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$mana_list_land, ControlledBy(One(AbilityController))])}), changes:[$single_quoted_activation]} */
static_controlled_land_single_quote ::= mana_list_land "you" "control" "have" single_quoted_activation

/* Singular hand populations share the same independently costed mechanic. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($paired_perpetual_hand), changes:[GrantAbility(@holder($hand_granted_cost_mechanic))]} */
static_each_hand_card_cost_mechanic ::= paired_perpetual_hand "has" hand_granted_cost_mechanic "."

/* A singular target receives both the capacity and its follow-up requirement.
   Both sentences describe the same turn and the same live effect. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($defender_block_target)), changes:[...$rule_block_unlimited, ...$block_each_attacker], duration:EndOfTurn, evaluation:LiveObjects} */
continuous_block_all_attackers ::= defender_block_target rule_block_unlimited "this" "turn" "." block_each_attacker

/* @sem Change::[Rule(RequireCombat{action:Block(Any), amount:Each})] */
block_each_attacker ::= "it" "blocks" "each" "attacking" "creature" "this" "turn" "if" "able"

/* A choice followed by a timed player rule retains the chosen value and the
   independently named affected players, duration, and rule. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$choose_value}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players($players_singular), changes:[PlayerRule($singular_shared_player_rule)], duration:$duration, evaluation:LiveObjects}}]} */
program_choice_timed_player_rule ::= choose_value "." duration "," players_singular singular_shared_player_rule "."

/* The rule restricts the event player, not the controller of the ability. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(EventSubject)), changes:[PlayerRule(Prohibit(AttackInto($recipients)))], duration:$this_duration, evaluation:LiveObjects} */
event_player_creatures_attack_prohibition ::= "creatures" "they" "control" "can't" "attack" recipients this_duration

/* @sem Change::[AddCardType(Artifact), AddCardType(Creature)] */
change_becomes_artifact_creature ::= "becomes" "an" "artifact" "creature"

/* @sem Change::[...$change_becomes_artifact_creature, ...$singular_pump_change] */
changes_artifact_animation_and_pump ::= change_becomes_artifact_creature "and" singular_pump_change

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}] */
singular_pump_change ::= "gets" signed "/" signed

/* A referenced object supplies both the source and affected object of this effect. */
/* @sem Operation::CreateContinuousEffect{source:$self_explicit_ref, affected:Objects(One($self_explicit_ref)), changes:$singular_pump, duration:$duration, evaluation:Snapshot} */
referenced_singular_temporary_pump ::= self_explicit_ref singular_pump duration

/* The counted cards and the numeric offset remain independent operands. */
/* @sem Expr::Add($number_digits, $return_graveyard_card_count) */
graveyard_card_count_sum ::= number_digits "plus" return_graveyard_card_count

base_toughness_value ::= combat_target_power_sum | graveyard_card_count_sum

/* @sem $base_toughness_change */
change_has_base_toughness ::= "has" base_toughness_change

/* @prefer always */
/* @sem Change::[...$change_grant, ...$change_has_base_toughness] */
leading_keyword_toughness_changes ::= change_grant "and" change_has_base_toughness

/* An attack-history condition composes with a singular top-card permission. */
/* @sem Ability::Conditional{condition:$condition_object_attack_history, then:[Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:$top_play_single_card})]} */
attack_history_top_permission ::= "as" "long" "as" condition_object_attack_history "," top_play_single_card "."

/* @sem Change::[PlayerRule(PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, from:Library, action:PlayLand, filter:Any}), PlayerRule(PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, from:Library, action:CastSpell, filter:Any})] */
top_play_single_card ::= "you" "may" "play" "the" "top" "card" "of" "your" "library"

/* An unqualified protection grant fixes its recipient indefinitely. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[GrantKeyword($keyword_protection)], duration:Indefinite, evaluation:Snapshot} */
indefinite_protection_grant ::= affected "gains" keyword_protection

/* A durationless grant fixes the affected population at resolution. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected_plural)), changes:$grants, duration:Indefinite, evaluation:Snapshot}}] */
indefinite_population_changes ::= affected_plural "gain" grants

/* A definite creature refers to the previously established creature; the
   quoted trigger has its own holder and ability scope. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$program} */
unpunctuated_granted_trigger ::= event_clause "," program

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($boosted_creature)), changes:[GrantAbility(@holder($unpunctuated_granted_trigger))], duration:$duration, evaluation:Snapshot} */
qualified_creature_timed_quoted_grant ::= boosted_creature "gains" '"' unpunctuated_granted_trigger '"' duration

/* The moved incarnation anchors the grant, delayed action and replacement.
   The replacement lasts while that incarnation remains on the battlefield. */
/* @sem Instruction::[Effect{result:@mark, operation:$post_grant_move}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@marked, phase:After, index:0})), changes:$grants, duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@marked, phase:After, index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}, Effect{result:@next, operation:CreateReplacement{event:Object{event:LeavesBattlefield, objects:SameObject(Result{result:@marked, phase:After, index:0})}, limit:UntilExpired, duration:WhileOnBattlefield(Result{result:@marked, phase:After, index:0}), body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}}}] */
clause_move_grant_exile_while_present ::= post_grant_move "." "it" "gains" grants "." "exile" "it" "at" "the" "beginning" "of" "the" "next" "end" "step" "." "if" "it" "would" "leave" "the" "battlefield" "," "exile" "it" "instead" "of" "putting" "it" "anywhere" "else"

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:Program{instructions:$clause_move_grant_exile_while_present}} */
activated_move_grant_exile_while_present ::= cost ":" clause_move_grant_exile_while_present "." activation_limits "."

/* The paired creature is the partner of the previously mentioned object. */
/* @sem Instruction::[If{condition:ObjectMatches{object:@it, filter:State(Paired)}, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(PairedWith(@it))), changes:$singular_pump, duration:$duration, evaluation:Snapshot}}]}, otherwise:Program{}}] */
clause_paired_creature_also_changes ::= "if" "it's" "paired" "with" "a" "creature" "," "that" "creature" "also" singular_pump duration

/* Timed prohibitions compose a player population with two actions from graveyards. */
/* @sem PlayerSet::OthersThan(AbilityController) */
graveyard_restriction_other_players ::= "other" "players"

/* @sem PlayerSet::All */
graveyard_restriction_all_players ::= "players"

graveyard_restriction_subject ::= graveyard_restriction_other_players | graveyard_restriction_all_players

/* @sem Change::PlayerRule(Prohibit(PlayLand{from:Players{zone:Graveyard, players:All}, filter:Any})) */
graveyard_restrict_play_lands ::= "play" "lands"

/* @sem Change::PlayerRule(Prohibit(CastSpell{from:Players{zone:Graveyard, players:All}, filter:$cast_spells_filter})) */
graveyard_restrict_cast_spells ::= "cast" cast_spells_filter

/* @sem Change::[$graveyard_restrict_play_lands, $graveyard_restrict_cast_spells] */
graveyard_restrict_land_and_spells ::= graveyard_restrict_play_lands "or" graveyard_restrict_cast_spells "from" "their" "graveyards"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players($graveyard_restriction_subject), changes:$graveyard_restrict_land_and_spells, duration:$this_duration, evaluation:LiveObjects} */
timed_graveyard_player_restriction ::= graveyard_restriction_subject "can't" graveyard_restrict_land_and_spells this_duration

/* Controlled subtype tokens receive the stated keyword grants. */
/* @prefer always */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$controlled_subtype_tokens}), changes:$controlled_token_multiple_grants} */
static_controlled_subtype_tokens_grants ::= controlled_subtype_tokens "have" controlled_token_multiple_grants "."

controlled_token_multiple_grants ::= grant_two | grant_many

/* A temporary singular type change adds the named creature type. Keeping this
   in the timed phrase avoids introducing it into unrelated change contexts. */
/* @sem Change::[CreatureTypes{mode:Add, types:Listed($becomes_type_one)}] */
shared_timed_added_creature_type ::= "becomes" "a" becomes_type_one

/* The combat requirement refers to the arrivals from this particular battlefield move. */
/* @sem Instruction::[Effect{result:@next, operation:$put_opponent_graveyard_targets_battlefield}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Transition{result:@prior, phase:After}), changes:$arrival_combat_requirement, duration:Indefinite, evaluation:LiveObjects}}] */
opponent_graveyard_entry_combat ::= put_opponent_graveyard_targets_battlefield "." "each" "of" "those" "creatures" arrival_combat_requirement

arrival_combat_requirement ::= arrival_attack_owner | arrival_attack_controller

/* @sem Change::[Rule(RequireCombat{action:Attack(Players(One(OwnerOf(Affected)))), amount:AtLeast(Constant(1))})] */
arrival_attack_owner ::= "attacks" "its" "owner" "each" "combat" "if" "able"

/* @sem Change::[Rule(RequireCombat{action:Attack(Players(One(ControllerOf(Affected)))), amount:AtLeast(Constant(1))})] */
arrival_attack_controller ::= "attacks" "its" "controller" "each" "combat" "if" "able"

/* Control a selected permanent while the named source stays tapped. */
/* @sem Operation::CreateContinuousEffect{source:$object_ref, affected:Objects(One($target_population_compared)), changes:[SetController(AbilityController)], duration:WhileMatches{object:$object_ref, filter:Tapped}, evaluation:Snapshot} */
control_population_compared_while_tapped ::= "gain" "control" "of" target_population_compared "for" "as" "long" "as" object_ref "remains" "tapped"

/* The attached population and its controlled host are independent filters;
   the granted ability belongs to each member of the attached population. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($controlled_host_attachment_population), changes:[GrantAbility(@holder($mechanic_bare))]} */
static_controlled_host_attachment_mechanic ::= controlled_host_attachment_population "have" mechanic_bare "."

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($attachment_plural_kind, ObjectFilter::AttachedTo(InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($plural_head, ObjectFilter::ControlledBy(One(AbilityController)))})))} */
controlled_host_attachment_population ::= attachment_plural_kind "attached" "to" plural_head "you" "control"

attachment_plural_kind ::= attachment_auras | plural_head

/* @sem ObjectFilter::Subtype(Aura) */
attachment_auras ::= "auras"

/* @sem Ability::Static{kind:Ordinary, affected:Objects($controlled_host_equipment_population), changes:[GrantAbility(@holder($mechanic_bare))]} */
static_controlled_host_equipment_mechanic ::= controlled_host_equipment_population "has" mechanic_bare "."

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($st_equipment, ObjectFilter::AttachedTo(InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($plural_head, ObjectFilter::ControlledBy(One(AbilityController)))})))} */
controlled_host_equipment_population ::= st_equipment "attached" "to" plural_head "you" "control"

/* The retained land animation sets color and adds creature types independently. */
/* @sem Change::[SetBasePowerToughness{power:$number, toughness:$number_2}, Colors{mode:Set, colors:[$mana_color_word]}, CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Creature)] */
retained_land_colored_form ::= "an" number "/" number mana_color_word becomes_types "creature"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:$retained_land_colored_form, duration:$duration, evaluation:Snapshot}}]} */
retained_land_animation_sentence ::= duration "," self_land "becomes" retained_land_colored_form "." "it's" "still" "a" "land" "."

/* A leading next-turn deadline scopes a temporary reduction on the caster's spells. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$cast_spells_filter, modifier:$spell_cost_less})], duration:$leading_spell_cost_deadline, evaluation:LiveObjects} */
leading_deadline_spell_cost ::= leading_spell_cost_deadline "," cast_spells_filter "you" "cast" "cost" spell_cost_less "to" "cast"

leading_spell_cost_deadline ::= until_your_next_turn | until_end_of_your_next_turn | until_named_next_turn

/* The same pump composes with a list of independently represented abilities. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Ability, terms:_{count:Exactly(Constant(1)), options:$choice_ability_list}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:$signed, toughness:$signed_2}, ChosenAbility], duration:$duration, evaluation:Snapshot}}] */
clause_pump_ability_list ::= affected "gets" signed "/" signed "and" "gains" "your" "choice" "of" choice_ability_list duration

/* Both effects apply to the previously mentioned singular object. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($it_ordinary_pronoun)), changes:$shared_indefinite_change, duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($it_ordinary_pronoun)), changes:$attached_activation_prohibition, duration:Indefinite, evaluation:LiveObjects}}] */
pronoun_characteristic_activation_ban ::= it_ordinary_pronoun shared_indefinite_change "." attached_activation_prohibition

/* The numeric animation reuses the additive artifact-creature type phrase. */
/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, ...$bk_artifact_native] */
indefinite_artifact_base_animation ::= "a" value "/" value bk_artifact_native

/* A final protection grant refers to the most recent color already chosen. */
/* @sem Change::[GrantKeyword(Protection(Objects(_{kind:Any, filter:Chosen(Color)})))] */
static_last_chosen_protection ::= "has" "protection" "from" "the" "last" "chosen" "color"

/* This shared list composes any preceding static change with that grant. */
/* @sem Change::[...$static_change, ...$static_last_chosen_protection] */
static_changes_last_chosen_protection ::= static_change "and" static_last_chosen_protection

/* An announced-X target group with a current power ceiling. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(AnnouncedX), filter:AllOf([$plural, Property{property:Power, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}])})) */
power_bounded_x_targets ::= "x" "target" plural "with" "power" number "or" "less"

/* A plural controlled population uses the existing optional copy wrapper. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($controlled_subtype_population), changes:[CopyOf{object:$copy_model_ref, exceptions:[]}], duration:$duration, evaluation:Snapshot} */
copy_become_controlled_plural ::= controlled_subtype_population "become" "copies" "of" copy_model_ref duration

/* A named card count remains a live population across all graveyards. */
/* @sem Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:Name($referenced_card_name)}) */
shared_named_graveyard_card_count ::= "card" "named" referenced_card_name "in" "each" "graveyard"

/* Keep a singular pump and its protection list in the same ability. */
/* @prefer always */
/* @sem Change::[...$singular_pump, $grant_protection_each] */
static_pump_and_protection_list ::= singular_pump "and" "has" grant_protection_each

/* Plural attackers and their chosen player remain separate operands. */
/* @sem Change::[Rule(RequireCombat{action:Attack(Players(One($plural_attack_player))), amount:AtLeast(Constant(1))})] */
plural_attack_named_player ::= "attack" plural_attack_player "each" "combat" "if" "able"

plural_attack_player ::= plural_attack_attached_controller | plural_attack_attached_owner | plural_attack_you

/* @sem PlayerRef::ControllerOf(AttachedTo(Source)) */
plural_attack_attached_controller ::= "enchanted" "creature's" "controller"

/* @sem PlayerRef::OwnerOf(AttachedTo(Source)) */
plural_attack_attached_owner ::= "the" "owner" "of" "enchanted" "creature"

/* @sem PlayerRef::AbilityController */
plural_attack_you ::= "you"

/* The anaphoric parity property is confined to this temporary population,
   leaving the distributive chosen-quality subject's default wording intact. */
/* @sem ObjectFilter::Property{property:$chosen_parity_stat, test:NumberTest::Compare{comparison:SameParity, value:ChosenParity}} */
that_quality_property ::= chosen_parity_stat "of" "that" "quality"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, $that_quality_property])} */
that_quality_population ::= filter_plural "with" that_quality_property

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($temporary_live_population), changes:$static_changes, duration:$this_duration, evaluation:LiveObjects} */
live_qualified_population_effect ::= temporary_live_population static_changes this_duration

/* The chosen creature type refines the independently described other population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), $filter_plural, Chosen(CreatureType)])} */
other_chosen_creature_type_population ::= "other" filter_plural "of" "that" "type"

scaled_pump_subject ::= scaled_pump_existing_subject | scaled_pump_controlled_color_target

scaled_pump_existing_subject ::= affected /* @prefer always */

/* Three color alternatives share one controlled target and its noun. */
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([AnyOf([$adjective_color, $adjective_color_2, $adjective_color_3]), $noun, ControlledBy(One(AbilityController))])}), index:0}) */
scaled_pump_controlled_color_target ::= "target" adjective_color "," adjective_color "," "or" adjective_color noun "you" "control"

/* The embedded type choice precedes the temporary population change. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:CreatureType, terms:_{count:Exactly(Constant(1)), options:[]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($choice_type_battlefield_population), changes:$static_changes, duration:$duration, evaluation:Snapshot}}] */
instructions_choice_type_temporary ::= choice_type_battlefield_population static_changes duration

/* A subtype and base-stat replacement can also grant protection from players. */
/* @sem Change::[...$base_subtypes, $grant_player_protection] */
shared_subtype_base_player_protection ::= "becomes" base_subtypes "and" grant_player_protection

/* A player's devotion bonus applies to every color and color combination. */
/* @sem Change::PlayerRule(DevotionBonus($value)) */
devotion_bonus_change ::= "devotion" "to" "each" "color" "and" "each" "combination" "of" "colors" "is" "increased" "by" value

/* @sem Ability::Static(_{kind:Ordinary, affected:Players($hand_size_players), changes:[$devotion_bonus_change]}) */
static_devotion_bonus ::= hand_size_players devotion_bonus_change "."

/* Separate static effects share their live population. */
/* @sem Ability::[Static{kind:Ordinary, affected:Objects($controlled_not_owned_population), changes:[Pump{power:$signed, toughness:$signed_2}]}, Static{kind:Ordinary, affected:Objects($controlled_not_owned_population), changes:[Rule(Prohibit(Sacrifice))]}] */
static_controlled_not_owned_pump ::= controlled_not_owned_population "get" signed "/" signed "and" "can't" "be" "sacrificed" "."

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController)), OwnedBy(OthersThan(AbilityController))])} */
controlled_not_owned_population ::= filter_plural "you" "control" "but" "don't" "own"

/* The linked population is shared by visibility and its play permissions. */
look_at_linked_exile_cards ::= look_at_linked_exile_plain | look_at_linked_exile_definite

linked_exile_look_and_play_changes ::= linked_exile_look_and_play_base | linked_exile_look_and_play_followed

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:$linked_exile_look_and_play_changes}) */
static_linked_exile_look_and_play ::= linked_exile_look_and_play_changes "."

/* A spell filter describes which spells cannot counter the controller’s spells. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellsHaveAbilities{spells:Any, abilities:List([Term{family:SpellEffect, form:CantBeCounteredBySpells, operands:[Filter($spell_adjectives)]}])})], duration:$this_duration, evaluation:LiveObjects} */
temporary_controlled_spells_counter_protection ::= "spells" "you" "control" "can't" "be" "countered" "by" spell_adjectives "spells" this_duration

/* A leading turn or combat window retains the live population for a per-blocker payment. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$block_cost_each_controller, duration:$this_duration, evaluation:LiveObjects} */
leading_live_block_cost ::= this_duration "," affected block_cost_each_controller

/* @sem Change::[Rule(CombatCost{action:Block(Any), payer:DeclaringPlayer, cost:$cost})] */
block_cost_each_controller ::= "can't" "block" "unless" "their" "controller" "pays" cost "for" "each" "blocking" "creature" "they" "control"

/* A targeted graveyard cast permission carries its own replacement consequence. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One($cast_own_graveyard_target), from:Graveyard, action:CastSpell, filter:Any}, terms:_{cost:Normal, into_exile:true}})], duration:$this_duration, evaluation:LiveObjects} */
temporary_target_graveyard_cast_exile ::= "you" "may" "cast" cast_own_graveyard_target this_duration "." "if" "that" "spell" "would" "be" "put" "into" "your" "graveyard" "," "exile" "it" "instead"

cast_own_graveyard_target ::= target_card_your_graveyard | target_any_card_your_graveyard

/* A source color definition and its explicit color-identity exclusion share
   the same compositional color change. */
/* @sem Ability::Static(_{kind:CharacteristicDefining{contributes_to_color_identity:false}, affected:Objects(One($self_ref_named)), changes:$controlled_each_color_value}) */
static_color_definition_excluded ::= self_ref_named "is" controlled_each_color_value "." "this" "ability" "doesn't" "affect" "its" "color" "identity" "."

/* @sem Ability::Static(_{kind:CharacteristicDefining{contributes_to_color_identity:true}, affected:Objects(One($self_ref_named)), changes:$controlled_each_color_value}) */
static_color_definition_included ::= self_ref_named "is" controlled_each_color_value "."

/* @prefer always */
/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word]}] */
cross_one_color ::= mana_color_word

/* @sem Change::[Colors{mode:Set, colors:[White, Blue, Black, Red, Green]}] */
cross_all_colors ::= "all" "colors"

/* The standalone source definition uses the card's name as its subject. */
/* @sem Ability::Static{kind:CharacteristicDefining{contributes_to_color_identity:true}, affected:Objects(One(Source)), changes:$source_definition_colors} */
source_named_color_definition ::= self_named "is" source_definition_colors "."

/* The linked callback owns its target announcement and program scope. */
/* @sem Ability::@scope(Ability::Spell{announcement:@announcement, body:$program_attacking_copy_sacrifice}) */
exert_scoped_copy_callback ::= program_attacking_copy_sacrifice

/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected), changes:[Rule(MayExert(Ability($exert_scoped_copy_callback)))]} */
static_exert_scoped_copy ::= "you" "may" "exert" affected "as" "it" "attacks" "." "when" "you" "do" "," exert_scoped_copy_callback "."

/* The five colors replace the previous color set. */
/* @sem Change::[Colors{mode:Set, colors:[White, Blue, Black, Red, Green]}] */
change_becomes_all_colors ::= "becomes" "all" "colors"

/* The holder and measured expression are independent operands of the setter. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_possessive)), changes:$base_power_equal_change, duration:Indefinite, evaluation:Snapshot} */
self_base_power_equal_indefinite ::= self_possessive base_power_equal_change

/* @sem Change::[SetPower($base_power_equal_value)] */
base_power_equal_change ::= "base" "power" "becomes" "equal" "to" base_power_equal_value

base_power_equal_value ::= base_power_equal_target_value | value

/* @prefer always */
base_power_equal_target_value ::= value_target_creature_possessive_stat

/* A granted mechanic can define its X using the receiving card. */
/* @sem Ability::Mechanic{mechanic:$cost_keyword_name, cost:Cost{parts:[ManaWithX{mana:[X], x:$value}]}} */
graveyard_granted_variable_mechanic ::= cost_keyword_name "{" "X" "}" "," "where" "X" "is" value

/* Singular artifact animation with independently specified base stats. */
/* @sem Change::[AddCardType(Artifact), AddCardType(Creature), SetBasePowerToughness{power:$value, toughness:$value_2}] */
artifact_base_stats_change ::= "becomes" "an" "artifact" "creature" "with" "base" "power" "and" "toughness" value "/" value

/* @sem Ability::Mechanic{mechanic:Encore, cost:Cost{parts:[ManaCostOf(Source)]}} */
graveyard_granted_encore ::= "encore" "." "its" "encore" "cost" "is" "equal" "to" "its" "mana" "cost"

/* @sem Change::[AddCardType(Artifact), AddCardType(Creature), SetBasePowerToughness{power:$value, toughness:$value_2}] */
artifact_base_change ::= "becomes" "an" "artifact" "creature" "with" "base" "power" "and" "toughness" value "/" value

/* The defined X reuses the same entry-counter clause and population expression
   used in other contexts; entering-controller binding applies to both. */
/* @sem Ability::@where($replacement_enters_counters_clause, $greatest_union_power) */
replacement_entry_greatest_union_where ::= replacement_enters_counters_clause "," "where" "X" "is" greatest_union_power "."

/* Temporary spell costs for the player identified by the event. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(EventSubject)), changes:[PlayerRule(SpellCost{spells:$cast_spells_filter, modifier:$spell_cost_change})], duration:$this_duration, evaluation:LiveObjects} */
event_player_turn_spell_cost ::= cast_spells_filter "they" "cast" this_duration "cost" spell_cost_change "to" "cast"

/* A loyalty ability selection retains the actual object that owns the abilities. */
/* @sem ObjectFilter::AllOf([OnStack(Loyalty), AbilityOf(SameObject($object_ref))]) */
loyalty_abilities_of_object ::= "the" "loyalty" "abilities" "of" object_ref

/* @sem Expr::Constant(1) */
loyalty_twice_per_turn ::= "twice" "each" "turn" "rather" "than" "only" "once"

/* @sem Expr::Constant(2) */
loyalty_thrice_per_turn ::= "three" "times" "each" "turn" "rather" "than" "only" "once"

loyalty_additional_activation_count ::= loyalty_twice_per_turn | loyalty_thrice_per_turn

/* @sem PlayerRule::ActivationGrant{abilities:$loyalty_abilities_of_object, grant:AdditionalTimes($loyalty_additional_activation_count)} */
loyalty_additional_activation_rule ::= "you" "may" "activate" loyalty_abilities_of_object loyalty_additional_activation_count

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule($loyalty_additional_activation_rule)]}) */
loyalty_additional_activation_static ::= loyalty_additional_activation_rule "."

/* Spending mana for an object's abilities keeps the payer and holder distinct. */
/* @sem Ability::Static{kind:Ordinary, affected:Players($ability_spending_players), changes:[PlayerRule(SpendManaAs{spend_as:$ability_spending_kind, on:Abilities($ability_spending_holder)})]} */
static_ability_spending_permission ::= ability_spending_players "may" ability_spending_kind "to" "pay" "the" "activation" "costs" "of" ability_spending_holder "."

ability_spending_kind ::= ability_spending_any_color | ability_spending_any_type | ability_spending_colorless

/* @sem SpendAs::AnyColor */
ability_spending_any_color ::= "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color"

/* @sem SpendAs::AnyType */
ability_spending_any_type ::= "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "type"

/* @sem SpendAs::ColorlessAsAnyColor */
ability_spending_colorless ::= "spend" "colorless" "mana" "as" "though" "it" "were" "mana" "of" "any" "color"

/* @sem ObjectFilter::AbilityOf(SameObject($self_possessive)) */
ability_spending_holder ::= self_possessive "abilities"

ability_spending_players ::= color_spending_players | ability_spending_active_player

/* @sem PlayerSet::One(Active) */
ability_spending_active_player ::= "the" "active" "player"

/* A free casting cost applies to a separately described spell population. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:@and($cast_spells_filter, $free_cast_mana_ceiling), modifier:Alternate{cost:Free}})]}) */
static_free_cast_mana_ceiling ::= "you" "may" "cast" cast_spells_filter free_cast_mana_ceiling "without" "paying" "their" "mana" "costs" "."

/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}} */
free_cast_mana_ceiling ::= "with" "mana" "value" "less" "than" "or" "equal" "to" value

/* Both effects refer to the same affected objects, with separate evaluation modes. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Rule(Prohibit(BeBlocked(Any)))], duration:$this_duration, evaluation:LiveObjects}}] */
clause_pump_cant_be_blocked ::= affected "gets" signed "/" signed duration "and" "can't" "be" "blocked" this_duration

/* Retained creature types are additive while the two card types are added. */
/* @sem Change::[CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Artifact), AddCardType(Creature)] */
change_becomes_named_artifact_retained ::= "becomes" "a" becomes_types "artifact" "creature" "in" "addition" "to" "its" "other" "types"

entry_copy_subject ::= entry_copy_plural_subject | entry_copy_each_subject

/* @prefer always */
/* @sem $entry_objects */
entry_copy_plural_subject ::= entry_objects "enter"

/* @sem $filter_phrase */
entry_copy_each_subject ::= "each" filter_phrase "enters"

/* Temporary discounts can qualify the caster's spells after the duration. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$temporary_spell_qualification, modifier:$spell_cost_where_value})], duration:$this_duration, evaluation:LiveObjects} */
temporary_qualified_spell_cost ::= "spells" "you" "cast" this_duration temporary_spell_qualification "cost" spell_cost_where_value

/* @sem ObjectFilter::$damage_source_color_filter */
temporary_spell_qualification ::= "that" "are" damage_source_color_filter

/* @sem SpellCostModifier::Reduce{reductions:[_{amount:$value}], spill_into_generic:true} */
spell_cost_where_value ::= "{" "X" "}" "less" "to" "cast" "," "where" "X" "is" value

/* A kind of spell and its alternate payment are independently reusable. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$cast_kind_spells, modifier:$plural_free_cast_modifier})]}) */
static_kind_alternate_cast_cost ::= "you" "may" "cast" cast_kind_spells plural_free_cast_modifier "."

/* @sem SpellCostModifier::Alternate{cost:Free} */
plural_free_cast_modifier ::= "without" "paying" "their" "mana" "costs"

/* Independent restrictions on the ability controller compose in one sentence. */
/* @prefer always */
/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule($player_own_turn_cast_timing), PlayerRule($player_cast_no_more_than_many)]} */
static_controller_cast_restrictions ::= "you" player_own_turn_cast_timing "and" "you" player_cast_no_more_than_many "."

/* @sem PlayerRule::SpellTiming{spells:$flash_spells, timing:OwnTurnOnly} */
player_own_turn_cast_timing ::= "can" "cast" flash_spells "only" "during" "your" "turn"

/* @sem PlayerRule::LimitPerTurn{action:CastSpell{filter:Any}, amount:$count_plural} */
player_cast_no_more_than_many ::= "can" "cast" "no" "more" "than" count_plural "spells" "each" "turn"

/* The definite creature is bound to the previously established permanent.
   The condition identifies the recipients of its damage in the same turn. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$damage_recipient_history_condition} */
affected_damage_recipient_condition ::= "if" damage_recipient_history_condition "," "the" "creature" "dealt" "damage"

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:SameObject($boosted_creature), recipients:Objects(SameObject(Candidate)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$singular_creature_article}}) */
damage_recipient_history_condition ::= boosted_creature "deals" "damage" "to" singular_creature_article "creature" "this" "turn"

/* @sem Expr::Constant(1) */
singular_creature_article ::= "a"

/* An animation can add both card types without setting base statistics. */
/* @sem Change::[AddCardType(Artifact), AddCardType(Creature)] */
change_becomes_artifact_creature_indefinite ::= "becomes" "an" "artifact" "creature"

/* A resolution effect with no stated duration persists indefinitely. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$static_changes, duration:Indefinite, evaluation:Snapshot}}] */
conditional_static_changes_indefinite ::= affected static_changes

/* @prefer always */
/* @sem ReplacementEvent::Enter{objects:$entry_objects} */
entry_tapped_plural ::= entry_objects "enter" "tapped"

/* @sem ReplacementEvent::Enter{objects:$entry_each_different_parity} */
entry_tapped_chosen_parity ::= entry_each_different_parity "enters" "tapped"

/* @sem ObjectFilter::AllOf([$filter_phrase, Property{property:$chosen_parity_stat, test:NumberTest::Compare{comparison:DifferentParity, value:ChosenParity}}]) */
entry_each_different_parity ::= "each" filter_phrase "without" chosen_parity_stat "of" "the" "chosen" "quality"

/* The color is an operand of the lost protection, independent of subject and duration. */
/* @sem Operand::Term{family:CheckHasable, form:ProtectionFromColor, operands:[$choice_color]} */
lost_protection_color ::= "protection" "from" choice_color

/* The enclosing choice supplies the chosen card referred to by "it". */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($affected), changes:[CopyOf{object:Earlier{what:Selected}, exceptions:$copy_exceptions_plain}], duration:$duration, evaluation:Snapshot} */
chosen_card_prefix_copy ::= duration "," affected "becomes" "a" "copy" "of" "it" "," "except" copy_exceptions_plain

/* A named source's anaphor carries the same source through the condition and changes. */
/* @sem Ability::Conditional{condition:AllOf([$window_your_turn, $named_source_positive_counters_him]), then:[Static(_{kind:Ordinary, affected:Objects(One(Source)), changes:$named_source_creature_and_keyword})]} */
turn_named_source_creature ::= window_your_turn "," "as" "long" "as" named_source_positive_counters_him "," "he's" named_source_creature_and_keyword "."

/* @sem Change::[...$indefinite_plain_creature_animation, GrantKeyword($keyword_value)] */
named_source_creature_and_keyword ::= indefinite_plain_creature_animation "and" "has" keyword_value

/* @sem Ability::[$turn_named_source_creature] */
line_turn_named_source_creature ::= turn_named_source_creature

/* An indefinite self-keyword change is a complete effect, usable in any program. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:$self_indefinite_keyword_changes, duration:Indefinite, evaluation:Snapshot} */
self_indefinite_keyword_change ::= "this" "creature" self_indefinite_keyword_changes

self_indefinite_keyword_changes ::= self_gains_keyword | change_loses_keyword

/* Only used with the matching single-creature exile payment. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($affected), changes:[CopyOf{object:Query{objects:CostObjects{payment:Activation, component:[1], view:Performed, phase:After}, index:0}, exceptions:[$copy_granted_sentence]}], duration:Indefinite, evaluation:Snapshot} */
/* @prefer always */
copy_paid_creature_with_ability ::= affected "becomes" "a" "copy" "of" "the" "exiled" "creature" "," "except" copy_granted_sentence

/* Spell type and post-cast characteristic are independent filters. */
/* @sem ObjectFilter::AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]) */
qualified_permanent_spell_kind ::= "permanent"

qualified_cast_spell_kind ::= qualified_permanent_spell_kind | noun_artifact | noun_battle | noun_creature | noun_enchantment | noun_land | noun_planeswalker | spell_instant | spell_sorcery

/* @sem ObjectFilter::State(HasAdventure) */
plural_spell_has_adventure ::= "that" "have" "an" "Adventure"

/* @sem ObjectFilter::@and($qualified_cast_spell_kind, $plural_spell_has_adventure) */
qualified_plural_cast_subject ::= qualified_cast_spell_kind "spells" "you" "cast" plural_spell_has_adventure

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$qualified_plural_cast_subject, modifier:$spell_cost_change})]}) */
static_qualified_plural_cast_cost ::= qualified_plural_cast_subject "cost" spell_cost_change "to" "cast" "."

/* The conditional access body shares the same top-card permissions as the
   self-on-top form; the condition retains its own controller and filter. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:$top_card_anaphoric_changes}) */
static_top_card_anaphoric_access ::= top_card_anaphoric_changes "."

/* @sem Ability::Conditional{condition:$condition_top_card_counted_a, then:[$static_top_card_anaphoric_access]} */
conditional_top_card_access ::= "as" "long" "as" condition_top_card_counted_a "," static_top_card_anaphoric_access

/* The tested attached object is also the antecedent of the following "it". */
/* @sem Ability::Conditional{condition:ExistsPlayer{players:$attached_control_players, binding:0, condition:Controls{player:Bound(0), filter:SameObject($attached_ref), minimum:1}}, then:[Static{kind:Ordinary, affected:Objects(One($attached_ref)), changes:$static_changes}], otherwise:[$conditional_static_arm]} */
conditional_attached_control_otherwise ::= "as" "long" "as" attached_control_players "controls" attached_ref "," "it" static_changes "." "otherwise" "," conditional_static_arm

/* @sem PlayerSet::OthersThan(AbilityController) */
attached_control_other_player ::= "another" "player"

/* @sem PlayerSet::OpponentsOf(AbilityController) */
attached_control_opponent ::= "an" "opponent"

attached_control_players ::= attached_control_other_player | attached_control_opponent

conditional_static_arm ::= static_ordinary_ability | aura_host_umbra_static

/* Umbra armor is represented as the protection granted to this Aura's host. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(One(AttachedTo($umbra_aura_ref))), changes:[GrantAbility($bare_umbra_armor)]} */
aura_host_umbra_static ::= umbra_aura_ref "has" bare_umbra_armor "."

/* @sem ObjectRef::@self */
umbra_aura_ref ::= self_aura

/* The defending players and their planeswalkers share the same opponent set. */
/* @sem ObjectFilter::AttackingDefender(PlayersAndPlaneswalkers(OpponentsOf(AbilityController))) */
modifier_attacking_opponents_and_walkers ::= "attacking" "your" "opponents" "and" "/" "or" "planeswalkers" "they" "control"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, $modifier_attacking_opponents_and_walkers])} */
affected_attacking_opponents_and_walkers ::= filter_plural modifier_attacking_opponents_and_walkers

/* A chosen creature type qualifies a temporary battlefield population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, Chosen(CreatureType)])} */
snapshot_chosen_creature_type_population ::= "all" filter_plural "of" "that" "type"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($snapshot_chosen_creature_type_population), changes:$changes, duration:$duration, evaluation:Snapshot} */
continuous_chosen_type_population_snapshot ::= snapshot_chosen_creature_type_population changes duration

/* The attached restriction applies to the same affected objects. */
/* @sem Change::[...$rule_change, ...$attached_activation_prohibition] */
rule_changes_attached_activation ::= rule_change "and" attached_activation_prohibition

/* @prefer always */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($subtype_tokens, $modifier_you_control)}), changes:$grant_two} */
static_subtype_token_grant_pair ::= subtype_tokens modifier_you_control "have" grant_two "."

/* A granted keyword survives removal of the object's other abilities. */
/* @sem Change::[RemoveAllAbilities, GrantKeyword($keyword_value)] */
retained_keyword_after_loss ::= "has" keyword_value "," "loses" "all" "other" "abilities"

/* The retained keyword and added color/type compose as a punctuated change list. */
/* @prefer always */
/* @sem Change::[...$retained_keyword_after_loss, ...$retained_color_creature_type] */
retained_keyword_and_added_color_type ::= retained_keyword_after_loss "," "and" retained_color_creature_type

/* A base-power change and a quoted grant are independent changes. */
/* @sem Change::[SetPower($value)] */
static_base_power_change ::= "has" "base" "power" value

/* @sem Change::[...$static_base_power_change, ...$base_power_closed_grants] */
static_base_power_closed_grant ::= static_base_power_change "and" "has" base_power_closed_grants

base_power_closed_grants ::= closed_grants | closed_holder_unless_trigger

/* The quoted trigger retains its own holder, event, condition, and program. */
/* @sem Change::GrantAbility(@scope(Ability::Triggered{event:$event_clause, intervening_if:$condition, limits:_{}, announcement:@announcement, body:$program_each_opponent_token_creation})) */
shared_granted_if_opponent_tokens ::= '"' event_clause "," "if" condition "," program_each_opponent_token_creation "." '"'

/* @sem Ability::Static{kind:Ordinary, affected:Objects($owned_commander_plural), changes:[$shared_granted_if_opponent_tokens]} */
owned_commander_granted_if_opponent_tokens ::= owned_commander_plural "have" shared_granted_if_opponent_tokens

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$switch_characteristics, duration:$duration, evaluation:Snapshot} */
switch_affected_characteristics ::= "switch" affected "'s" switch_characteristics duration

/* The quoted activation belongs to the newly animated object. */
/* @sem Change::[SetBasePowerToughness{power:$number, toughness:$number_2}, Colors{mode:Set, colors:[$mana_color_word]}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, AddCardType(Creature), GrantAbility(@scope($quoted_creature_regeneration))] */
retained_colored_quoted_regeneration ::= "becomes" "a" number "/" number mana_color_word becomes_types "creature" "with" '"' quoted_creature_regeneration '"'

/* @sem Ability::Activated{origin:Ordinary, cost:_{parts:[Mana($mana_symbols)]}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CreateRegenerationShields{objects:One(Source)}}]}} */
quoted_creature_regeneration ::= mana_symbols ":" "regenerate" "this" "creature"

/* A singular temporary change retains its subject and individual changes. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($object_ref)), changes:$singular_pump, duration:$duration, evaluation:Snapshot} */
willing_declined_effect ::= object_ref singular_pump duration

/* A life-total rule and a granted keyword share the same player and window. */
/* @sem Change::[PlayerRule(LifeTotalLocked), PlayerRule(GrantKeyword($life_lock_keyword))] */
player_life_lock_and_keyword ::= "your" "life" "total" "can't" "change" "and" "you" "gain" life_lock_keyword

life_lock_keyword ::= life_lock_protection_all_spells | player_keyword

/* @sem PlayerKeyword::Protection(Objects{kind:Spell, filter:Any}) */
life_lock_protection_all_spells ::= "protection" "from" "all" "spells"

/* The definite phrasing composes the copied kind with its independent origin. */
/* @sem Change::[GainAbilitiesOf{objects:$ability_origin_set, kinds:$copied_definite_ability_kinds}] */
change_gained_the_abilities ::= "has" "the" copied_definite_ability_kinds "abilities" "of" ability_origin_set

copied_definite_ability_kinds ::= copied_loyalty_kinds | copied_ability_kinds

/* @sem Operand::List([Term{family:CheckHasable, form:LoyaltyAbility}]) */
copied_loyalty_kinds ::= "loyalty"

/* This self-origin form does not overlap the separate all-other population rule. */
/* @sem Change::[GainAbilitiesOf{objects:One($self_explicit_ref), kinds:$copied_loyalty_kinds}] */
change_gained_all_loyalty_self ::= "has" "all" copied_loyalty_kinds "abilities" "of" self_explicit_ref

/* Compose the singular ability loss with a colored subtype and base stats.
   Keep the copular alternative scoped here so it does not add independent
   readings to other static changes. */
/* @sem Change::[RemoveAllAbilities] */
static_loses_all_abilities ::= "loses" "all" "abilities"

/* @sem $base_colored_subtypes */
static_is_colored_subtypes_base ::= "is" base_colored_subtypes

/* @sem Change::[...$static_loses_all_abilities, ...$static_is_colored_subtypes_base] */
static_loss_and_colored_base ::= static_loses_all_abilities "and" static_is_colored_subtypes_base

/* A linked card's current property defines the written bonus in this static
   change list. Keep this separate from action-result receipt expressions. */
/* @sem @where($linked_property_changes, $linked_property_value) */
linked_property_defined_changes ::= linked_property_changes "," "where" "X" "is" linked_property_value

linked_property_changes ::= linked_property_changes_more | linked_property_pump

/* @sem Change::[...$static_change, ...$linked_property_changes] */
linked_property_changes_more ::= static_change "and" linked_property_changes

/* @sem Change::[Pump{power:AnnouncedX, toughness:AnnouncedX}] */
linked_property_pump ::= "gets" "+" "X" "/" "+" "X"

/* @sem Expr::ObjectProperty{object:$linked_exiled_card_possessive, property:$receipt_stat, information:CurrentOrLastKnown} */
linked_property_value ::= linked_exiled_card_possessive receipt_stat

/* A player's spell-cost rule can be conditioned independently of its subject and modifier. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$cast_spells_filter, modifier:$spell_cost_change})]}) */
conditional_cast_cost_body ::= cast_spells_filter "you" "cast" "cost" spell_cost_change "to" "cast"

/* @sem Ability::Conditional{condition:$condition_graveyard_filtered_size, then:[$conditional_cast_cost_body]} */
conditional_cast_cost_as_long_as ::= conditional_cast_cost_body "as" "long" "as" condition_graveyard_filtered_size "."

/* Keep both choices and the dependent population within the same program. */
/* @sem Instruction::[Effect{result:@next, operation:Together([ChooseValue{choosers:One(AbilityController), kind:LandType, terms:_{count:Exactly(Constant(1)), options:[]}}, ChooseValue{choosers:One(AbilityController), kind:BasicLandType, terms:_{count:Exactly(Constant(1)), options:[]}}])}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun, NthChosen(0)])}), changes:[SetLandType(Term{family:LandTypeVariable, form:TheSecondChosenLandType})], duration:$duration, evaluation:Snapshot}}] */
instructions_chosen_land_type_change ::= "choose" "a" "land" "type" "and" "a" "basic" "land" "type" "." "each" noun "of" "the" "first" "chosen" "type" "becomes" "the" "second" "chosen" "type" duration

/* The named source is also the antecedent of its measured stat. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[Pump{power:ObjectProperty{object:Source, property:$self_pump_stat, information:CurrentOrLastKnown}, toughness:ObjectProperty{object:Source, property:$self_pump_stat, information:CurrentOrLastKnown}}], duration:$duration, evaluation:Snapshot} */
self_defined_stat_pump ::= self_named "gets" "+" "X" "/" "+" "X" duration "," "where" "X" "is" "its" self_pump_stat

self_pump_stat ::= stat_power | stat_toughness

/* Explicit self references avoid treating an anaphoric type replacement as an addition. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_explicit_ref)), changes:[AddCardType($vowel_card_type)], duration:Indefinite, evaluation:Snapshot} */
continuous_explicit_self_vowel_type ::= self_explicit_ref "becomes" "an" vowel_card_type

/* A timed player prohibition composes the subject, spell filter and ability holder. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players($player_rule_subject), changes:$cast_loyalty_prohibition, duration:$this_duration, evaluation:LiveObjects} */
timed_cast_loyalty_prohibition ::= player_rule_subject cast_loyalty_prohibition this_duration

/* @sem Change::[PlayerRule(Prohibit(CastSpell{filter:$cast_spells_filter})), PlayerRule(Prohibit(Activate(All([Is(Loyalty), Of($activation_possessive_type)]))))] */
cast_loyalty_prohibition ::= "can't" "cast" cast_spells_filter "or" "activate" activation_possessive_type "loyalty" "abilities"

/* Indefinite loss by a previously mentioned singular object. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members(One($it_ordinary_pronoun))), changes:$change_loses_keyword, duration:Indefinite, evaluation:Snapshot} */
indefinite_referenced_keyword_loss ::= it_ordinary_pronoun change_loses_keyword

/* The named tapped object supplies both the source and the expiration test.
   The target phrase independently retains the opponent's announcement choice. */
/* @sem Operation::CreateContinuousEffect{source:$object_ref, affected:Objects(One($opponent_choice_controlled_target)), changes:$acquire_control_change, duration:WhileMatches{object:$object_ref, filter:Tapped}, evaluation:Snapshot} */
leading_tapped_acquire_choice ::= "for" "as" "long" "as" object_ref "remains" "tapped" "," acquire_control_change opponent_choice_controlled_target

/* A linked card population supplies each listed ability independently.  The
   explicit middle pair keeps this list distinct from shorter linked forms. */
/* @sem Operand::[$sharing_kind] */
linked_trait_prefix_last ::= sharing_kind ","

/* @sem Operand::[$sharing_kind, ...$linked_trait_prefix] */
linked_trait_prefix_more ::= sharing_kind "," linked_trait_prefix

linked_trait_prefix ::= linked_trait_prefix_last | linked_trait_prefix_more

/* @sem Operand::List([Term{family:CheckHasable, form:Flying}, ...$linked_trait_prefix, Term{family:CheckHasable, form:Menace}, Term{family:CheckHasable, form:AnyProtection}, ...$sharing_kind_tail]) */
linked_trait_list ::= linked_trait_prefix "menace" "," "protection" "," sharing_kind_tail

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[GainAbilitiesOf{objects:$shared_keyword_origin, kinds:$linked_trait_list}]}) */
static_linked_shared_traits ::= "as" "long" "as" shared_keyword_origin "has" "flying" "," affected "has" "flying" "." "the" "same" "is" "true" "for" linked_trait_list "."

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(ObjectRef::@it)), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot} */
anaphoric_additional_grant ::= "it" "also" "gains" keyword_name duration

/* Repeated plural heads describe one controlled population of either color. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([AnyOf([$adjective_color, $adjective_color_2]), @agree($plural, $plural_2), ControlledBy(One(AbilityController))])} */
controlled_two_color_repeated_population ::= adjective_color plural "and" adjective_color plural "you" "control"

/* A plural subject shares the existing combat and activation restrictions. */
/* @sem Change::[...$combat_prohibition, ...$activation_restriction] */
change_combat_activation_their_plain ::= combat_prohibition "and" "their" activation_restriction

/* @sem Change::[Rule(Prohibit(Activate(Any)))] */
activation_restriction_all ::= "activated" "abilities" "can't" "be" "activated"

/* The replacement belongs to each affected commander's ability holder. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($owned_commander_population), changes:[GrantAbility($first_draw_look_split)]} */
owned_commander_first_draw_grant ::= owned_commander_population "have" '"' first_draw_look_split '"'

/* A plural additive artifact type and a list of granted abilities share the
   affected population; each granted ability retains its own holder. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected_plural), changes:$plural_additive_grants}) */
static_plural_additive_grants ::= affected_plural plural_additive_grants "."

/* @sem Change::[...$coordinated_additive_artifact, ...$quoted_equip_grants] */
plural_additive_grants ::= coordinated_additive_artifact "and" "have" quoted_equip_grants

/* @sem Change::[AddArtifactType($coordinated_artifact_type)] */
coordinated_additive_artifact ::= "are" coordinated_artifact_type "in" "addition" "to" "their" "other" "types"

coordinated_artifact_type ::= coordinated_equipment_type | added_food_type | added_clue_type

/* @sem ArtifactType::Equipment */
coordinated_equipment_type ::= "Equipment"

/* @sem Change::[$quoted_comma_static_grant, $subtype_equip_grant, $plain_equip_grant] */
quoted_equip_grants ::= quoted_comma_static_grant subtype_equip_grant "," "and" plain_equip_grant

/* @sem Change::GrantAbility(@holder(Ability::Static{kind:Ordinary, affected:Objects($affected), changes:$static_changes})) */
quoted_comma_static_grant ::= '"' affected static_changes "," '"'

/* @sem Change::GrantAbility(@holder($shared_subtype_equip)) */
subtype_equip_grant ::= shared_subtype_equip

/* @sem Change::GrantAbility(@holder($keyword_equip)) */
plain_equip_grant ::= keyword_equip

/* A singular subject can lose a vowel-article card type during an effect. */
/* @sem Change::[RemoveCardType($vowel_card_type)] */
change_remove_vowel_card_type ::= "isn't" "an" vowel_card_type

/* A leading duration can scope a change followed by loss of a card type. */
/* @prefer always */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[...$change, ...$change_remove_vowel_card_type], duration:$duration, evaluation:Snapshot} */
duration_affected_removal_changes ::= duration "," affected change "and" change_remove_vowel_card_type

/* The entering object and the condition retain their independent operands. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:Program{instructions:[If{condition:$entry_turn_condition, then:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}]}, otherwise:Program{}}]}}) */
replacement_enters_tapped_if ::= object_ref "enters" "tapped" "if" entry_turn_condition "."

entry_turn_condition ::= condition_not_your_turn | condition_your_turn

/* A single affected object receives a base toughness for a duration. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[SetToughness($value)], duration:$duration, evaluation:Snapshot} */
base_toughness_for_duration ::= affected "has" "base" "toughness" value duration

/* An optional typed artifact animation composes with a preceding value definition. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, AddCardType(Artifact), AddCardType(Creature), GrantKeyword($keyword_value)], duration:$until_end_of_turn, evaluation:Snapshot}}]}}] */
clause_optional_typed_artifact_animation ::= until_end_of_turn "," "you" "may" "have" affected "become" "an" value "/" value becomes_types "artifact" "creature" "with" keyword_value

/* The definition is scoped to the roll and its optional animation. */
/* @sem @where(Program::Program{instructions:[Effect{result:@next, operation:$animation_roll_die}, ...$clause_optional_typed_artifact_animation]}, $value_die_result) */
program_roll_optional_typed_animation ::= animation_roll_die "." clause_optional_typed_artifact_animation "," "where" "X" "is" value_die_result

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:$program_roll_optional_typed_animation} */
activated_roll_optional_typed_animation ::= cost ":" program_roll_optional_typed_animation "."

/* Prefer notation only in this animation context; other die-roll defaults remain unchanged. */
animation_roll_die ::= animation_roll_d6_notation | roll_die_action

/* @prefer always */
/* @sem Operation::$roll_d6_notation */
animation_roll_d6_notation ::= roll_d6_notation

/* The affected object loses the currently resolving ability indefinitely. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[LosesAbility($lost_this_ability)], duration:Indefinite, evaluation:Snapshot} */
continuous_loses_current_ability ::= affected "loses" lost_this_ability

retained_land_population ::= land_population | controlled_basic_land_population

/* @sem ModeSelection::_{count:_{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{body:_{instructions:[Effect{result:@next, operation:ChooseValue(_{choosers:One(AbilityController), kind:BasicLandType, terms:_{count:Exactly($count_plural)}})}, Effect{result:@next, operation:ChangeSpell{subject:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:$stack_spell_filter}), index:0}), changes:[ReplaceWord{from:Vocabulary{family:LandTypeWord, form:TheFirstChosenLandType}, to:Vocabulary{family:LandTypeWord, form:TheSecondChosenLandType}}]}}]}, weight:1, announcement:@announcement}), @scope(Mode::Mode{body:_{instructions:[Effect{result:@next, operation:ChooseValue(_{choosers:One(AbilityController), kind:BasicLandType, terms:_{count:Exactly($count_plural)}})}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_phrase}), index:0})), changes:[ReplaceWord{from:Vocabulary{family:LandTypeWord, form:TheFirstChosenLandType}, to:Vocabulary{family:LandTypeWord, form:TheSecondChosenLandType}}], duration:Indefinite, evaluation:Snapshot}}]}, weight:1, announcement:@announcement})], rules:_{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:Implied} */
word_replacement_land_explicit ::= "choose" count_plural "basic" "land" "types" "." "change" "the" "text" "of" "target" stack_spell_filter "or" filter_phrase "by" "replacing" "all" "instances" "of" "the" "first" "with" "the" "second"

/* The shared target alternatives can also constitute a spell by themselves. */
/* @sem Ability::Spell{announcement:_{modes:$word_replacement_choice}, body:_{}} */
spell_word_replacement_shared ::= word_replacement_choice "."

/* A distributive singular subject grants a valued mechanic to each holder. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($objects_each)), changes:[$grant_valued_mechanic], duration:$duration, evaluation:Snapshot} */
/* @prefer always */
continuous_each_valued_grant ::= objects_each "gains" grant_valued_mechanic duration

/* @sem Change::GrantAbility(@holder($granted_valued_mechanic)) */
grant_valued_mechanic ::= granted_valued_mechanic

/* The possessive identifies the affected object independently of the switched pair. */
/* @sem ObjectSet::One(EventSubject) */
switch_event_possessive ::= "its"

/* @sem ObjectSet::One(Source) */
switch_source_possessive ::= "this" "creature's"

switch_possessive_subject ::= switch_event_possessive | switch_source_possessive

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($switch_possessive_subject), changes:$switch_characteristics, duration:$duration, evaluation:Snapshot} */
switch_possessive_stats ::= "switch" switch_possessive_subject switch_characteristics duration

/* Select the linked card before applying the copy to the affected objects. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$linked_exile_copy_card, count:AsManyAsCan(Constant(1))}}]}}, If{condition:Outcome(CostPaid), then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($affected), changes:[CopyOf{object:Result{result:@prior, phase:After, index:0}, exceptions:[]}], duration:$duration, evaluation:Snapshot}}]}, otherwise:Program{}}] */
clause_optional_linked_copy ::= "you" "may" "have" affected "become" "a" "copy" "of" linked_exile_copy_card duration

/* A singular antecedent keeps its identity across the type change. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($it_ordinary_pronoun)), changes:$retained_singular_type, duration:Indefinite, evaluation:Snapshot} */
retained_type_followup ::= it_ordinary_pronoun retained_singular_type

/* Preserve the attachment population and the receiving ability holder. */
/* @prefer always */
/* @sem ObjectSet::@distributive_pump_subject(ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$plural_attached_to_population}) */
affected_attached_population ::= plural_attached_to_population

/* @prefer always */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected_attached_population), changes:[GrantAbility(@holder($bare_umbra_armor))]} */
static_attached_population_umbra ::= affected_attached_population "have" bare_umbra_armor "."

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$indefinite_plain_artifact_animation, duration:Indefinite, evaluation:Snapshot} */
conditional_artifact_animation ::= affected "becomes" indefinite_plain_artifact_animation

/* @sem Instruction::[Effect{result:@next, operation:$conditional_artifact_animation}] */
conditional_artifact_animation_body ::= conditional_artifact_animation

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, AddCardType(Artifact), AddCardType(Creature)] */
indefinite_plain_artifact_animation ::= "a" value "/" value becomes_types "artifact" "creature"

/* A singular subtype replacement composes with subsequent timed changes. */
/* @sem Change::[CreatureTypes{mode:Set, types:Listed([@subtype_name($consonant_timed_subtype)])}] */
change_becomes_consonant_subtype ::= "becomes" "a" consonant_timed_subtype

consonant_timed_subtype ::= st_dragon | st_werewolf | st_goblin | st_knight | st_warrior | st_wizard

/* @sem Change::[...$change_becomes_consonant_subtype, ...$change, ...$changes] */
leading_consonant_subtype_changes ::= change_becomes_consonant_subtype "," change "," "and" changes

/* The same announced object supplies both the affected permanent and the
   controller whose next untap step ends the change. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members(One($target_object))), changes:[SetLandType(Vocabulary{family:LandType, form:@subtype_name($basic_land_type_named)})], duration:UntilNextUntapStep(ControllerOf($target_object)), evaluation:Snapshot} */
continuous_target_basic_land_controller_untap ::= target_object "becomes" basic_land_type_named "until" "its" "controller's" "next" "untap" "step"

/* @sem PlayerRule::SurveilBonus($count_plural) */
player_surveil_bonus_many ::= "may" "look" "at" "an" "additional" count_plural "cards" "each" "time" "you" "surveil"

/* @sem PlayerRule::SurveilBonus(Expr::Constant(1)) */
player_surveil_bonus_one ::= "may" "look" "at" "an" "additional" "card" "each" "time" "you" "surveil"

/* Linked exile permission and its independent per-turn casting limit. */
/* @sem PlayerRule::PlayPermission{cards:$permission_linked_exile_cards, from:Exile, action:CastSpell, filter:$cast_spells_filter} */
linked_exile_cast_permission ::= "cast" cast_spells_filter "from" "among" permission_linked_exile_cards

linked_cast_turn_limit ::= linked_cast_one_per_turn | linked_cast_two_per_turn

/* @sem PlayLimit::EachTurn(1) */
linked_cast_one_per_turn ::= "you" "can't" "cast" "more" "than" "one" "spell" "this" "way" "each" "turn"

/* @sem PlayLimit::EachTurn(2) */
linked_cast_two_per_turn ::= "you" "can't" "cast" "more" "than" "two" "spells" "this" "way" "each" "turn"

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:$linked_exile_cast_permission, terms:_{limit:$linked_cast_turn_limit, cost:Normal}})]}) */
static_linked_cast_limited ::= "you" "may" linked_exile_cast_permission "." linked_cast_turn_limit "."

/* The permission and its spending term share the same card population. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$permission_exile_owned_counter_cards, from:Exile, action:CastSpell, filter:Any}, terms:_{cost:Normal, spend_as:$permission_spell_spending}})]}) */
static_cast_exile_population_spending ::= "you" "may" "cast" "spells" "from" "among" permission_exile_owned_counter_cards "," "and" permission_spell_spending "."

permission_spell_spending ::= permission_snow_spell_spending | permission_any_color_spell_spending

/* @sem SpendAs::SnowAsAnyColor */
permission_snow_spell_spending ::= "you" "may" "spend" "mana" "from" "snow" "sources" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "those" "spells"

/* @sem SpendAs::AnyColor */
permission_any_color_spell_spending ::= "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "those" "spells"

/* The permission and the other-mana restriction form a single player rule. */
/* @sem Change::[PlayerRule(SpendColorAs{color:$mana_color_word, others_colorless:true, on:Anything})] */
spend_color_other_colorless ::= "you" "may" "spend" mana_color_word "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "." "you" "may" "spend" "other" "mana" "only" "as" "though" "it" "were" "colorless" "mana"

/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:$spend_color_other_colorless} */
static_spend_color_other_colorless ::= spend_color_other_colorless "."

/* A condition can scope a sequence of separate static effects on one object. */
/* @sem Ability::Conditional{condition:$condition, then:$shared_condition_static_sequence} */
shared_condition_static_sequence_ability ::= "as" "long" "as" condition "," shared_condition_static_sequence "."

/* @sem Ability::[Static(_{kind:Ordinary, affected:Objects(One($object_ref)), changes:[...$conditional_keyword_grant, ...$attached_matching_blocker]})] */
shared_condition_static_sequence ::= object_ref conditional_keyword_grant "and" attached_matching_blocker

/* @sem Change::[GrantKeyword($keyword_value)] */
conditional_keyword_grant ::= "has" keyword_value

/* The spell filter and the linked card population remain independent operands. */
/* @sem Change::[PlayerRule(PlayPermission{cards:$permission_linked_exile_cards, from:Exile, action:CastSpell, filter:$cast_spells_filter})] */
exile_cast_linked_spells ::= "you" "may" "cast" cast_spells_filter "from" "among" permission_linked_exile_cards

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:$exile_cast_linked_spells}) */
static_cast_linked_spells ::= exile_cast_linked_spells "."

/* A postnominal type union qualifies the graveyard card population. */
/* @sem ObjectFilter::AnyOf([$filter_phrase, $filter_phrase_2, $filter_phrase_3, $filter_phrase_4]) */
graveyard_four_filter_union ::= filter_phrase "," filter_phrase "," filter_phrase "," "and" "/" "or" filter_phrase

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, $graveyard_four_filter_union])} */
graveyard_qualified_card_population ::= "each" filter_phrase "card" "in" "your" "graveyard" "that's" "a" graveyard_four_filter_union

/* @sem Ability::Static{kind:Ordinary, affected:Objects($graveyard_qualified_card_population), changes:[GrantAbility(@holder($graveyard_granted_ability))]} */
static_qualified_graveyard_grant ::= graveyard_qualified_card_population "has" graveyard_granted_ability "."

/* The permission and its entry term share the announced card target. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One($target_card_your_graveyard), from:Graveyard, action:Either, filter:Any}, terms:_{cost:Normal, effects:[List([Term{family:SpellEffect, form:EntersTapped}])]}})], duration:$this_duration, evaluation:LiveObjects} */
play_graveyard_target_enters_tapped ::= "you" "may" "play" target_card_your_graveyard this_duration "." "if" "you" "do" "," "it" "enters" "tapped"

/* Keyword and timing remain independent operands of the player permission. */
/* @sem PlayerRule::ActivationGrant{abilities:OnStack(Keyword($activation_keyword)), grant:InstantSpeed} */
player_instant_activation ::= "may" "activate" activation_keyword "abilities" "any" "time" "you" "could" "cast" "an" "instant"

/* @sem Expr::Stickers{objects:$affected, measure:NamesBeginningWith(Term{family:Letter, form:TheChosenLetter})} */
count_each_chosen_letter_sticker ::= "name" "sticker" "on" affected "that" "begins" "with" "the" "chosen" "letter"

/* @sem Expr::ManaOf{mana:SpentOnEventCost, filter:_{colors:[Black, Red]}} */
count_each_event_cost_black_red ::= "{" "B" "}" "or" "{" "R" "}" "spent" "this" "way"

/* @sem UniqueObjectRule::BlockedByExactlyOne */
unique_blocked_by_exactly_one ::= "must" "be" "blocked" "by" "exactly" "one" "creature" "if" "able"

/* @sem UniqueObjectRule::DestroyedOnlyBySingleSource */
unique_destroyed_only_by_single_source ::= "can't" "be" "destroyed" "by" lethal_damage "unless" lethal_damage "dealt" "by" single_damage_source "is" "marked" "on" "it"

/* @sem UniqueObjectRule::BlockedOnlyByAll */
unique_blocked_only_by_all ::= "can't" "be" "blocked" "unless" "all" "creatures" "defending" "player" "controls" "block" "it"

/* @sem Ability::Static{kind:Ordinary, affected:Objects($any_zone_source_card), changes:[Rule(Unique(CastWhileSearched))]} */
unique_cast_while_searched ::= "while" "you're" "searching" "your" "library" "," "you" "may" "cast" any_zone_source_card "from" "your" "library" "."

/* @sem Ability::Unique(NeverNight) */
unique_never_night ::= "it" "can't" "become" "night" "."

/* @sem Ability::Unique(AdditionalOpeningHand) */
unique_additional_opening_hand ::= "draw" "an" "additional" "hand" "of" "seven" "cards" "as" "the" "game" "begins" "." "before" "taking" "mulligans" "," "shuffle" "all" "but" "one" "of" "your" "hands" "into" "your" "library" "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(Unique(NoteExiledManaValue))]}) */
unique_note_exiled_mana_value ::= "note" "the" "mana" "value" "of" "each" "card" "as" "it's" "put" "into" "exile" "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(Unique(ColoredCardsAsRandomBasicLands))]}) */
unique_colored_cards_as_random_basic_lands ::= "you" "may" "play" "any" "colored" "card" "from" "your" "hand" "as" "a" "copy" "of" "a" "basic" "land" "card" "chosen" "at" "random" "that" "can" "produce" "mana" "of" "one" "of" "the" "card's" "colors" "."

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(Unique(FirstTwoCoinFlipsWin))]}) */
unique_first_two_coin_flips_win ::= "the" "first" "time" "you" "flip" "one" "or" "more" "coins" "each" "turn" "," "those" "coins" "come" "up" "heads" "and" "you" "win" "those" "flips" "."

/* @sem Ability::Unique(AllDamageWithers) */
unique_all_damage_withers ::= "all" "damage" "is" "dealt" "as" "though" "its" "source" "had" "wither" "."

/* @sem Ability::Unique(StartingPlayer) */
unique_starting_player ::= "you" "are" "the" "starting" "player" "." "if" "multiple" "players" "would" "be" "the" "starting" "player" "," "one" "of" "those" "players" "is" "chosen" "at" "random" "."

/* A leading duration modifies the named source's copy effect. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_ref_named)), changes:[CopyOf{object:$copy_model_ref, exceptions:[]}], duration:$duration, evaluation:Snapshot} */
copy_named_source_leading_duration ::= duration "," self_ref_named "becomes" "a" "copy" "of" copy_model_ref

/* A common predicate applies independently to controlled permanents, controlled
   spells and owned cards in zones other than the battlefield and stack. */
/* @sem Ability::[Static{kind:Ordinary, affected:Objects($cross_battlefield_subject), changes:$cross_have_traits}, Static{kind:Ordinary, affected:Objects($cross_spells), changes:$cross_have_traits}, Static{kind:Ordinary, affected:Objects($cross_owned_outside_battlefield_stack), changes:$cross_have_traits}] */
line_cross_zone_have_traits ::= cross_battlefield_subject "," cross_spells "," "and" cross_owned_outside_battlefield_stack cross_have_traits "."

/* @sem ObjectSet::AnyZone(@and($card_filter, ObjectFilter::OwnedBy(One(AbilityController)), ObjectFilter::Not(InZone(Shared(Battlefield))), ObjectFilter::Not(InZone(Shared(Stack))))) */
cross_owned_outside_battlefield_stack ::= card_filter "cards" "you" "own" "in" "any" "zone" "other" "than" "the" "battlefield" "or" "the" "stack"

/* @sem $cross_traits */
cross_have_traits ::= "have" cross_traits

/* @sem Ability::[...$line_game_begins_choice, ...$line_cross_zone_have_traits] */
line_game_choice_cross_zone_traits ::= line_game_begins_choice line_cross_zone_have_traits

/* The controller and chosen creature type both constrain the announced target. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($noun, ObjectFilter::ControlledBy(One(AbilityController)), ObjectFilter::Chosen(CreatureType))}), index:0} */
copy_model_controlled_chosen_type ::= "target" noun "you" "control" "of" "the" "chosen" "type"

/* @sem Vec<CopyException>::[CopyException::AddCardTypes([Artifact])] */
copy_artifact_retained ::= "it's" "an" "artifact" "in" "addition" "to" "its" "other" "types"

protection_kept ::= protection_kept_plain | protection_kept_attached

/* @prefer always */
protection_kept_plain ::= affected

/* ProtectionExcept retains the already attached objects; their filter remains explicit. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural} */
protection_kept_attached ::= filter_plural "that" "are" "already" "attached" "to" "it"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$contextual_other_filter} */
ability_origin_all_other_battlefield ::= "all" contextual_other_filter "on" "the" "battlefield"

/* A controlled other permanent retains its own combat-state predicate. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(SameObject(Source)), $filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)), ObjectFilter::Not(AnyOf([Attacking, Blocking])))}), changes:$retirement_resting_pump} */
retirement_other_controlled_resting ::= "each" "other" filter_phrase "you" "control" retirement_resting_pump "as" "long" "as" "it's" "not" "attacking" "or" "blocking" "."

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}] */
retirement_resting_pump ::= "gets" signed "/" signed

/* Controller and owner remain independent across these two populations. */
/* @sem ObjectSet::AnyZone(@and($card_filter, ObjectFilter::OwnedBy(One(AbilityController)), ObjectFilter::Not(InZone(Shared(Battlefield))), ObjectFilter::Not(InZone(Shared(Stack))))) */
retirement_owned_cards_outside_battlefield_stack ::= card_filter "cards" "you" "own" "in" "any" "zone" "other" "than" "the" "battlefield" "or" "the" "stack"

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}] */
retirement_cross_plural_pump ::= "get" signed "/" signed

/* @sem Ability::[Static{kind:Ordinary, affected:Objects($cross_spells), changes:$retirement_cross_plural_pump}, Static{kind:Ordinary, affected:Objects($retirement_owned_cards_outside_battlefield_stack), changes:$retirement_cross_plural_pump}] */
retirement_spells_and_owned_cards_pump ::= cross_spells "and" retirement_owned_cards_outside_battlefield_stack retirement_cross_plural_pump "."

/* The anaphor denotes the controlled population introduced by the condition. */
/* @sem Ability::Conditional{condition:Controls{player:AbilityController, filter:$draft_noted_name_creatures, minimum:1}, then:[Static(_{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject(Source), AllOf([$draft_noted_name_creatures, ControlledBy(One(AbilityController))])])}), changes:$shared_plural_static_changes})]} */
shared_controlled_noted_creatures_static ::= "as" "long" "as" "you" "control" "one" "or" "more" draft_noted_name_creatures "," "this" "creature" "and" "those" "creatures" shared_plural_static_changes "."

/* @sem Change::[...$plural_pump_change, GrantKeyword($keyword_name)] */
shared_plural_pump_have_keyword ::= plural_pump_change "and" "have" keyword_name

shared_plural_static_changes ::= plural_pump_change | shared_plural_pump_have_keyword

/* Keep the optional placement and its player-specific combat restriction in one receipt scope. */
/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$each_player_counter_attack_restriction} */
shared_each_player_counter_attack_trigger ::= "at" turn_event "," each_player_counter_attack_restriction

/* @sem Program::Program{instructions:[ForEachPlayer{players:All, binding:0, body:_{instructions:[Optional{decider:Bound(0), body:_{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))])}), kind:$counter_kind, amount:$count_plural, selection:_{player:Bound(0), count:AsManyAsCan(Constant(1))}}]}}]}}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(Matching{binding:0, condition:PlayerTook{player:Bound(0), result:@prior}})])}), changes:[Rule(Prohibit(Attack(PlayersAndPlaneswalkers(One(AbilityController)))))], duration:UntilNextTurn(AbilityController), evaluation:LiveObjects}}]} */
each_player_counter_attack_restriction ::= "each" "player" "may" "put" count_plural counter_kind "counters" "on" "a" filter_phrase "they" "control" "." "if" "a" "player" "does" "," filter_plural "that" "player" "controls" "can't" "attack" "you" "or" "planeswalkers" "you" "control" "until" "your" "next" "turn" "."

/* A singular distributive spell population retains its cast filter. */
/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:@and($filter_phrase, ObjectFilter::Cast{by:One(AbilityController)})} */
each_cast_filtered_spell ::= "each" filter_phrase "spell" "you" "cast"

/* @sem Ability::Mechanic{mechanic:Emerge, cost:_{parts:[ManaCostOf(Source)]}} */
granted_emerge_own_mana_cost ::= "emerge" "." "the" "emerge" "cost" "is" "equal" "to" "its" "mana" "cost"

/* @sem Ability::Static{kind:Ordinary, affected:Objects($each_cast_filtered_spell), changes:[GrantAbility(@holder($granted_emerge_own_mana_cost))]} */
static_each_cast_spell_emerge ::= each_cast_filtered_spell "has" granted_emerge_own_mana_cost "."

/* Each recipient supplies its own colors, independently of the granting source. */
/* @sem Change::[GrantKeyword($own_color_hexproof)] */
change_has_own_color_hexproof ::= "has" own_color_hexproof

/* @sem Keyword::HexproofFrom(Objects(_{kind:Any, filter:SharesColorWith(Affected)})) */
own_color_hexproof ::= "hexproof" "from" "each" "of" "its" "colors"

/* A cast boon can grant just the singular pump. */
/* @sem $static_singular_pump */
cast_boon_pump_only ::= static_singular_pump

/* The land and spell permissions have independent per-turn allowances. */
/* @sem Ability::Conditional{condition:PlayerIsActive(AbilityController), then:[Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$recent_graveyard_permission_cards, from:Graveyard, action:PlayLand, filter:Any}, terms:_{limit:EachTurn(1), cost:Normal}}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$recent_graveyard_permission_cards, from:Graveyard, action:CastSpell, filter:$turn_history_spell}, terms:_{limit:EachTurn(1), cost:Normal}})]})]} */
recent_graveyard_land_and_spell_permission ::= "during" "each" "of" "your" "turns" "," "you" "may" "play" "a" "land" "and" "cast" turn_history_spell "from" "among" recent_graveyard_permission_cards "."

/* @sem ObjectSet::Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:ArrivedThisTurn{from:$recent_graveyard_origin}}) */
recent_graveyard_permission_cards ::= "cards" "in" "graveyards" "that" "were" "put" "there" "from" recent_graveyard_origin "this" "turn"

recent_graveyard_origin ::= recent_graveyard_libraries | recent_graveyard_battlefield

/* @sem Zone::Library */
recent_graveyard_libraries ::= "libraries"

/* @sem Zone::Battlefield */
recent_graveyard_battlefield ::= "the" "battlefield"

/* Each written characteristic and granted ability remains independently editable. */
/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, AddCardType(Artifact), AddCardType(Creature), RemoveAllAbilities, GrantKeyword($keyword_value), GrantAbility(Mechanic{mechanic:Toxic, amount:$value_3})] */
animation_artifact_loss_grants ::= "becomes" "a" value "/" value becomes_types "artifact" "creature" "," "loses" "all" "abilities" "," "and" "gains" keyword_value "and" "toxic" value

/* Cast-time grants retain the caster, spell filter and current mechanic cost. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellsHaveAbilities{spells:$cast_spells_filter, abilities:List([$cast_granted_offspring])})]}) */
shared_cast_granted_offspring ::= cast_spells_filter "you" "cast" "gain" cast_granted_offspring "as" "you" "cast" "them" "."

/* @sem Operand::Term{family:SpellEffect, form:Offspring, operands:[$cast_offspring_generic]} */
cast_granted_offspring ::= "offspring" cast_offspring_generic

/* @sem Operand::Term{family:ManaSymbol, form:ManaCostGeneric, operands:[Integer($number)]} */
cast_offspring_generic ::= "{" NUMBER "}"

/* The plural graveyards population includes every player; the grant belongs to each card. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($private_all_graveyard_cards), changes:[GrantAbility(@holder($graveyard_granted_ability))]} */
static_all_graveyard_cards_grant ::= private_all_graveyard_cards "have" graveyard_granted_ability "."

/* @sem Cost::Cost{parts:[ManaCostOf(Source)]} */
graveyard_flashback_card_cost ::= "." "the" "flashback" "cost" "is" "equal" "to" "the" "card's" "mana" "cost"

/* Text-changing creature-type replacement with one excluded replacement type. */
/* @sem ModeSelection::_{count:_{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{body:_{instructions:[Effect{result:@next, operation:ChooseValue(_{choosers:One(AbilityController), kind:CreatureType, terms:_{except:[Vocabulary{family:CreatureType, form:@subtype_name($creature_subtype)}], count:Exactly(Constant(2))}})}, Effect{result:@next, operation:ChangeSpell{subject:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:Any}), index:0}), changes:[ReplaceWord{from:Vocabulary{family:CreatureTypeWord, form:TheFirstChosenCreatureType}, to:Vocabulary{family:CreatureTypeWord, form:TheSecondChosenCreatureType}}]}}]}, weight:1, announcement:@announcement}), @scope(Mode::Mode{body:_{instructions:[Effect{result:@next, operation:ChooseValue(_{choosers:One(AbilityController), kind:CreatureType, terms:_{except:[Vocabulary{family:CreatureType, form:@subtype_name($creature_subtype)}], count:Exactly(Constant(2))}})}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:Any}), index:0})), changes:[ReplaceWord{from:Vocabulary{family:CreatureTypeWord, form:TheFirstChosenCreatureType}, to:Vocabulary{family:CreatureTypeWord, form:TheSecondChosenCreatureType}}], duration:Indefinite, evaluation:Snapshot}}]}, weight:1, announcement:@announcement})], rules:_{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:Implied} */
word_replacement_creature_type_except_choice ::= "change" "the" "text" "of" "target" "spell" "or" "permanent" "by" "replacing" "all" "instances" "of" "one" "creature" "type" "with" "another" "." "the" "new" "creature" "type" "can't" "be" creature_subtype

/* A shared per-turn exile play permission whose follow-up exiles from the acting player's library. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($self_ref_holder)}), from:Exile, action:Either, filter:AnyOf([CardType(Land), Any])}, terms:_{limit:EachTurn(1), during:One(Affected), cost:Normal, spend_as:AnyColor, effects:[Program{instructions:[Effect{result:@next, operation:$affected_library_exile}]}]}})]}) */
static_each_turn_exiled_play_exile_top ::= "during" "each" "player's" "turn" "," "that" "player" "may" "play" "a" "land" "or" "cast" "a" "spell" "from" "among" "cards" "exiled" "with" self_ref_holder "," "and" "they" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "that" "spell" "." "when" "they" "do" "," affected_library_exile "."

/* A singular distribution composes with Equipment changes and retains its filters. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($equipment_distribution), changes:$equipment_defined_x_changes} */
static_artifacts_equipment_mana_value ::= equipment_distribution equipment_defined_x_changes "."

/* A conditional static ability can grant a holder upkeep payment trigger. */
/* @sem Ability::Conditional{condition:$condition, then:[Static{kind:Ordinary, affected:Objects($affected), changes:[GrantAbility(@holder($retirement_quoted_turn_payment))]}], otherwise:[]} */
conditional_retirement_turn_payment ::= "as" "long" "as" condition "," affected "has" '"' retirement_quoted_turn_payment '"'

/* A plural population receives the stated base characteristics. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[SetBasePowerToughness{power:$value, toughness:$value_2}], duration:$duration, evaluation:Snapshot} */
base_power_toughness_plural_duration ::= affected "have" "base" "power" "and" "toughness" value "/" value duration

/* @prefer always */
/* @sem Change::[Pump{power:AnnouncedX, toughness:AnnouncedX}, GrantKeyword($keyword_value)] */
defined_pump_then_keyword ::= "gets" "+" "X" "/" "+" "X" "and" "gains" keyword_value

/* @sem Change::[GrantKeyword($keyword_value), Pump{power:AnnouncedX, toughness:AnnouncedX}] */
defined_keyword_then_pump ::= "gains" keyword_value "and" "gets" "+" "X" "/" "+" "X"

/* @sem Expr::CountDistinct{objects:$affected, property:CounterTypes} */
distinct_counter_kinds_among ::= "the" "number" "of" "different" "kinds" "of" "counters" "among" affected

/* Each sentence binds its own combat condition and live counted population. */
/* @sem Ability::Conditional{condition:ObjectMatches{object:Source, filter:$combat_count_state}, then:[Static{kind:Ordinary, affected:Objects(One(Source)), changes:[SetBasePowerToughness{power:$conditional_combat_stat_population_count, toughness:$conditional_combat_stat_population_count}]}]} */
combat_conditional_count_stats ::= "as" "long" "as" SELF_NAME combat_count_state "," "its" "power" "and" "toughness" "are" "each" "equal" "to" conditional_combat_stat_population_count "."

/* @sem ObjectFilter::Not(Attacking) */
combat_count_not_attacking ::= "isn't" "attacking"

/* @sem ObjectFilter::Attacking */
combat_count_attacking ::= "is" "attacking"

combat_count_state ::= combat_count_not_attacking | combat_count_attacking

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($subtype_plural, ObjectFilter::ControlledBy(One(AbilityController)))}) */
combat_population_you ::= "the" "number" "of" subtype_plural "you" "control"

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($subtype_plural, ObjectFilter::ControlledBy(One(DefendingPlayerOf(Source))))}) */
combat_population_defender ::= "the" "number" "of" subtype_plural "defending" "player" "controls"

conditional_combat_stat_population_count ::= combat_population_you | combat_population_defender

/* @sem Ability::[$combat_conditional_count_stats, $combat_conditional_count_stats_2] */
line_combat_conditional_counts ::= combat_conditional_count_stats combat_conditional_count_stats

/* Preserve the target and the source defining the duration. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($target_object)), changes:[SetLandType(Vocabulary{family:LandType, form:@subtype_name($basic_land_type_named)})], duration:WhileOnBattlefield($self_explicit_ref), evaluation:Snapshot} */
becomes_basic_until_self_leaves ::= target_object "becomes" basic_land_type_named "until" self_explicit_ref "leaves" "the" "battlefield"

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$becomes_basic_until_self_leaves}]}} */
activated_basic_until_source_leaves ::= cost ":" becomes_basic_until_self_leaves "."

/* A controlled subtype population receives both a stat change and granted abilities. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$temporary_controlled_subtype, ControlledBy(One(AbilityController))])}), changes:$plural_pump_and_grants, duration:$duration, evaluation:Snapshot} */
controlled_subtype_pump_grant_snapshot ::= temporary_controlled_subtype "you" "control" plural_pump_and_grants duration

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}, ...$grants] */
plural_pump_and_grants ::= "get" signed "/" signed "and" "gain" grants

temporary_controlled_subtype ::= controlled_grant_subject | plural_marked_bats | plural_marked_rats | subtype_marked_merfolk | controlled_type_marked_goblins

temporary_live_population ::= temporary_live_quality | repeated_color_population

temporary_live_quality ::= that_quality_population /* @prefer always */

/* A repeated noun belongs to both color alternatives. Keep this phrase local to
   the continuous effect; damage-event sources have their own union contract. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([AnyOf([$adjective_color, $adjective_color_2]), @agree($plural_atomic, $plural_atomic_2)])} */
repeated_color_population ::= adjective_color plural_atomic "and" adjective_color plural_atomic

/* A controlled subtype population shares one additive type and its grants. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($additive_controlled_subtype_population), changes:$additive_artifact_grants} */
static_controlled_subtype_additive_grants ::= additive_controlled_subtype_population additive_artifact_grants "."

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$copy_controlled_subtype, ControlledBy(One(AbilityController))])} */
additive_controlled_subtype_population ::= copy_controlled_subtype "you" "control"

/* Each attacking creature incurs its declaring controller's payment. */
/* @sem Change::[Rule(CombatCost{action:Attack(Any), payer:DeclaringPlayer, cost:$cost})] */
attack_cost_each_controller ::= "can't" "attack" "unless" "their" "controller" "pays" cost "for" "each" "attacking" "creature" "they" "control"

/* Both changes share the leading duration and affected subject. */
/* @prefer always */
/* @sem Change::[...$static_singular_pump, ...$change_becomes_retained_artifact] */
leading_pump_retained_artifact ::= static_singular_pump "and" change_becomes_retained_artifact

/* An additive card type retains the subject’s other types. */
/* @sem Change::[AddCardType(Artifact)] */
change_becomes_retained_artifact ::= "becomes" "an" "artifact" "in" "addition" "to" "its" "other" "types"

/* @sem ObjectFilter::$subtype */
scalar_static_subtype ::= "a" subtype

/* A singular object gains the Aura type and the specified enchant ability. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($affected), changes:[AddEnchantmentType(Vocabulary{family:EnchantmentType, form:Aura}), GrantAbility(Enchant{hosts:Permanents($filter_phrase)})], duration:Indefinite, evaluation:Snapshot}}] */
become_aura_with_enchant ::= affected "becomes" "an" "Aura" "with" "enchant" filter_phrase

/* The antecedent receives each independently specified perpetual grant. */
/* @prefer always */
/* @sem Operation::CreatePerpetualEffect{objects:One(EventSubject), changes:$grants} */
event_creature_perpetual_grants ::= "that" "creature" "perpetually" "gains" grants

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$event_creature_perpetual_grants}] */
instructions_event_creature_perpetual_grants ::= event_creature_perpetual_grants

/* @prefer always */
/* @sem Program::Program{instructions:$instructions_event_creature_perpetual_grants} */
program_event_creature_perpetual_grants ::= instructions_event_creature_perpetual_grants

/* @prefer always */
/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$program_event_creature_perpetual_grants} */
triggered_event_creature_perpetual_grants ::= event_clause "," program_event_creature_perpetual_grants "."

/* Set the named object’s base power from the current expression. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($named_possessive_ref)), changes:[SetPower($value)], duration:$duration, evaluation:Snapshot} */
continuous_set_named_base_power ::= named_possessive_ref "base" "power" "become" value duration

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($target_object)), changes:[Rule(RequireCombat{action:Block(SameObject(Source)), amount:AtLeast(Constant(1))})], duration:$this_duration, evaluation:LiveObjects} */
shared_holder_block_requirement ::= target_object "blocks" "it" this_duration "if" "able"

/* Independent characteristic changes share the enclosing recipient and duration. */
/* @sem Change::[...$singular_base_stats, ...$singular_gains_keyword, ...$singular_remove_creature_type] */
singular_base_grant_remove_type ::= singular_base_stats "," singular_gains_keyword "," "and" singular_remove_creature_type

/* @sem Change::[GrantKeyword($keyword_value)] */
singular_gains_keyword ::= "gains" keyword_value

singular_remove_creature_type ::= singular_remove_creature_type_a | singular_remove_creature_type_an

/* Article domains keep inverse printing grammatical for edited types. */
/* @sem Change::[RemoveSubtype(@subtype_name($removable_creature_type_a))] */
singular_remove_creature_type_a ::= "isn't" "a" removable_creature_type_a

removable_creature_type_a ::= st_human | st_goblin | st_werewolf | st_wizard | st_warrior | st_soldier | st_zombie

/* @sem Change::[RemoveSubtype(@subtype_name($removable_creature_type_an))] */
singular_remove_creature_type_an ::= "isn't" "an" removable_creature_type_an

removable_creature_type_an ::= st_angel | st_elf | st_ogre

/* Compose independent characteristic and ability changes under one duration. */
/* @sem Change::[$grant] */
change_gains_single_grant ::= "gains" grant

/* @sem Change::[...$change_has_base_power_singular, ...$change_gains_single_grant] */
base_power_and_grant ::= change_has_base_power_singular "and" change_gains_single_grant

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$base_power_and_grant, duration:$duration, evaluation:Snapshot} */
/* @prefer always */
continuous_leading_snapshot ::= duration "," affected base_power_and_grant

/* Spell types qualify the stack objects, independently of the other list members. */
/* @sem Protection::Objects{kind:Spell, filter:$protection_spell_type} */
protection_typed_spell ::= protection_spell_type "spells"

protection_spell_type ::= spell_instant | spell_sorcery

/* A shared player restriction keeps its counted permanent filter and limit. */
/* @sem Change::PlayerRule(UntapLimit{permanents:$filter_plural, amount:$value}) */
players_untap_limit_change ::= "untap" "more" "than" value filter_plural "during" "their" "untap" "steps"

/* @sem Ability::Static{kind:Ordinary, affected:Players(All), changes:[$players_untap_limit_change]} */
static_players_untap_limit ::= "players" "can't" players_untap_limit_change "."

/* A retained enchantment-creature change may follow two other changes. */
/* @prefer always */
/* @sem Change::[...$change, ...$change_2, ...$change_retained_enchantment_creature] */
retained_enchantment_changes ::= change "," change "," "and" change_retained_enchantment_creature

/* @prefer always */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$retained_enchantment_changes, duration:$duration, evaluation:Snapshot} */
continuous_snapshot_leading ::= duration "," affected retained_enchantment_changes

/* Explicit retention adds the named creature subtypes and both card types. */
/* @sem Change::[CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Enchantment), AddCardType(Creature)] */
change_retained_enchantment_creature ::= "becomes" "a" becomes_types "enchantment" "creature" "in" "addition" "to" "its" "other" "types"

/* The affected object's current stat supplies the negative toughness change. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:$signed, toughness:Multiply([Constant(-1), Subtract([ObjectProperty{object:Affected, property:$stat, information:CurrentOrLastKnown}, $number])])}], duration:$duration, evaluation:Snapshot} */
continuous_own_stat_difference_pump ::= affected "gets" signed "/" "-" "X" duration "," "where" "X" "is" "its" stat "minus" number

/* Each phrase denotes one snapshot pump; the pair shares its end-of-turn scope. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}), changes:$plural_private_pump, duration:EndOfTurn, evaluation:Snapshot} */
plural_end_turn_pump_phrase ::= filter_plural plural_private_pump

/* @sem Instruction::[Effect{result:@next, operation:$plural_end_turn_pump_phrase}, Effect{result:@next, operation:$plural_end_turn_pump_phrase_2}] */
clause_paired_plural_end_turn ::= plural_end_turn_pump_phrase "and" plural_end_turn_pump_phrase "until" "end" "of" "turn"

/* The quoted ability keeps its own holder and trigger scope; the player who
   cast the granting spell remains the prior granting player. */
/* @sem Change::GrantAbility(@scope(Ability::Triggered{event:$grant_damage_casting_player_event, limits:_{}, announcement:@announcement, body:$grant_damage_body})) */
grant_cast_player_damage_trigger ::= '"' "when" grant_damage_casting_player_event "," grant_damage_body "." '"'

/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:SameObject(Source), recipients:Players(One(Prior(GrantedBy))), kind:Any, grouping:SourceRecipient, subject:Source}) */
grant_damage_casting_player_event ::= self_permanent "deals" "damage" "to" "the" "player" "who" "cast" SELF_NAME

 grant_damage_body ::= grant_damage_self_sacrifice_then | program

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:One(Source)}}, ...$instructions]} */
/* @prefer always */
grant_damage_self_sacrifice_then ::= "sacrifice" self_permanent "." instructions

/* The enclosing activation proves the land sacrifice and its receipt. */
/* @sem Keyword::Landwalk(Shares{property:LandTypes, with:Query{objects:CostObjects{payment:Activation, component:[1], view:Inputs, phase:Before}, index:0}}) */
landwalk_sacrificed_land_keyword ::= "landwalk" "of" "each" "of" "the" "land" "types" "of" "the" "sacrificed" "land"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[GrantKeyword($landwalk_sacrificed_land_keyword)], duration:$duration, evaluation:Snapshot} */
landwalk_sacrifice_effect ::= affected "gains" landwalk_sacrificed_land_keyword duration

/* Both thresholds describe the same minimum spell cost. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(SpellCost{spells:Any, modifier:Minimum(@agree($value, $value_2))})]}) */
shared_spell_cost_floor ::= "each" "spell" "that" "would" "cost" "less" "than" value "mana" "to" "cast" "costs" value "mana" "to" "cast" "."

/* A leading duration can scope a list of characteristic changes ending in
   a quoted activation. The quoted ability owns its own holder and period. */
/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$timed_quoted_changes, duration:$duration, evaluation:Snapshot}}]}} */
spell_timed_quoted_changes ::= duration "," affected timed_quoted_changes

timed_quoted_changes ::= timed_quoted_more | timed_quoted_final

/* @sem Change::[...$timed_characteristic_change, ...$timed_quoted_changes] */
timed_quoted_more ::= timed_characteristic_change "," timed_quoted_changes

/* @sem Change::[$grant_quoted_activation] */
timed_quoted_final ::= "and" "gains" grant_quoted_activation

timed_characteristic_change ::= change_color_set | change_pump

/* A single-creature pump can be reused in cast-conditioned spell modes. */
/* @sem Change::Pump{power:$signed, toughness:$signed_2} */
cast_conditioned_initial_pump ::= "gets" signed "/" signed "until" "end" "of" "turn"

/* @sem Change::Pump{power:$signed, toughness:$signed_2} */
cast_conditioned_extra_pump ::= "that" "creature" "gets" "an" "additional" signed "/" signed "until" "end" "of" "turn"

/* @sem Condition::Controls{player:AbilityController, filter:$creature_subtype, minimum:1} */
cast_conditioned_subtype_control ::= "if" "you" "controlled" "a" creature_subtype "as" "you" "cast" "this" "spell"

/* The conditional mode fixes the condition at casting and retains the same
   target and initial change in both branches. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0})), changes:[$cast_conditioned_initial_pump, $cast_conditioned_extra_pump], duration:EndOfTurn, evaluation:Snapshot}}]}, weight:1, requires:$cast_conditioned_subtype_control}), @scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0})), changes:[$cast_conditioned_initial_pump], duration:EndOfTurn, evaluation:Snapshot}}]}, weight:1, requires:Not($cast_conditioned_subtype_control)})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied} */
cast_conditioned_creature_pumps ::= "target" "creature" cast_conditioned_initial_pump "." cast_conditioned_extra_pump cast_conditioned_subtype_control "."

/* @sem Ability::Spell{announcement:_{modes:$cast_conditioned_creature_pumps}, body:_{}} */
spell_cast_conditioned_creature_pumps ::= cast_conditioned_creature_pumps

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($adjective_nontype, ObjectFilter::Not(Subtype(Equipment)), $noun)} */
equipment_distribution ::= "each" adjective_nontype "," "non-Equipment" noun

/* The definition binds both the equip payment and the quoted bonus to the
   Equipment's mana value. Keep the two uses in the same phrase. */
/* @sem Change::[AddArtifactType(Equipment), GrantAbility(@scope($equipment_defined_x_equip)), GrantAbility($equipment_defined_x_pump)] */
equipment_defined_x_changes ::= "is" "an" "Equipment" "with" equipment_defined_x_equip "and" '"' equipment_defined_x_pump "," '"' "where" "X" "is" "that" "artifact's" "mana" "value"

/* @sem Ability::Activated{origin:Equip, cost:Cost{parts:[ManaWithX{mana:[X], x:ObjectProperty{object:Source, property:ManaValue, information:CurrentOrLastKnown}}]}, limits:ActivationLimits{sorcery:true}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Attach{attachments:One(Source), host:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$equip_target_phrase}), index:0}}}]}} */
equipment_defined_x_equip ::= equip_target_phrase "{" "X" "}"

equipment_defined_x_pump ::= equipment_defined_x_pump_source | equipment_defined_x_pump_affected

/* @prefer always */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Pump{power:ObjectProperty{object:Source, property:ManaValue, information:CurrentOrLastKnown}, toughness:$signed_literal}]} */
equipment_defined_x_pump_source ::= "equipped" "creature" "gets" "+" "X" "/" signed_literal

/* Preserve the independently supported affected-object reading. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Pump{power:ObjectProperty{object:Affected, property:ManaValue, information:CurrentOrLastKnown}, toughness:$signed_literal}]} */
equipment_defined_x_pump_affected ::= "equipped" "creature" "gets" "+" "X" "/" signed_literal

/* The receiving card is the source of its granted embalm cost. */
/* @sem Ability::Mechanic{mechanic:Embalm, cost:Cost{parts:[ManaCostOf(Source)]}} */
graveyard_granted_embalm ::= "embalm" "." "its" "embalm" "cost" "is" "equal" "to" "its" "mana" "cost"

/* Retained types accompany a temporary animation of the affected object. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$retained_creature_animation, duration:$duration, evaluation:Snapshot} */
affected_retained_creature_animation ::= affected "becomes" retained_creature_animation duration "." retention_note

/* The second clause refers back to the same singular affected object. */
/* @sem Change::[...$static_change, ...$static_numeric_x] */
static_numeric_anaphor_prefix ::= static_change "," "and" "it" static_numeric_x

/* The granted trigger composes a turn event with the attached-cost payment. */
/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$attached_cost_sacrifice_program} */
retirement_quoted_attached_cost_turn ::= "at" turn_event "," attached_cost_sacrifice_program

/* An artifact host grants this reusable turn/payment trigger to that host. */
/* @prefer always */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(One($attached_payment_artifact)), changes:[GrantAbility(@holder($retirement_quoted_attached_cost_turn))]} */
attached_artifact_payment_grant ::= attached_payment_artifact "has" '"' retirement_quoted_attached_cost_turn '"'

/* @sem ObjectRef::@enchanted_operand(ObjectRef::AttachedTo(Source)) */
attached_payment_artifact ::= "enchanted" "artifact"

/* Attached combat restriction and separately scoped granted activation. */
/* @prefer always */
/* @sem Ability::[Static{kind:Ordinary, affected:Objects(One($attached_ref)), changes:$rule_cant_attack_or_block}, Static{kind:Ordinary, affected:Objects(One($attached_ref)), changes:[$attached_limited_grant]}] */
attached_combat_limited_grant ::= attached_ref rule_cant_attack_or_block "and" "has" attached_limited_grant

/* @sem Change::GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:$grantor_sacrifice_draw_program})) */
attached_limited_grant ::= '"' cost ":" grantor_sacrifice_draw_program "." activation_limits "." '"'

/* Preserve the independently supported combined permission reading. */
/* @sem Ability::Conditional{condition:PlayerIsActive(AbilityController), then:[Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[$recent_graveyard_combined_permission]})]} */
recent_graveyard_combined_turn_permission ::= "during" "each" "of" "your" "turns" "," recent_graveyard_combined_permission "."

/* @sem Change::PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$recent_graveyard_permission_cards, from:Graveyard, action:Either, filter:$turn_history_any_spell}, terms:_{limit:EachTurn(1), cost:Normal}}) */
recent_graveyard_combined_permission ::= "you" "may" "play" "a" "land" "and" "cast" turn_history_any_spell "from" "among" recent_graveyard_permission_cards

/* The card's identity is independent of the zone in which the rule applies. */
/* @sem ObjectSet::AnyZone(SameObject(Source)) */
any_zone_source_card ::= self_card

/* Unique object rules share their change wrapper and retain their own meaning. */
/* @sem Change::[Rule(Unique($unique_object_rule))] */
shared_unique_object_change ::= unique_object_rule

unique_object_rule ::= unique_blocked_by_exactly_one | unique_destroyed_only_by_single_source | unique_blocked_only_by_all

/* Shared damage wording; the enclosing rule supplies its full restriction. */
/* @sem () */
lethal_damage ::= "lethal" "damage"

/* @sem () */
single_damage_source ::= "a" "single" "source"

/* The copied model is an announced permanent target. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_ref_named)), changes:[CopyOf{object:$target_permanent, exceptions:[]}], duration:$duration, evaluation:Snapshot} */
copy_named_source_target_leading_duration ::= duration "," self_ref_named "becomes" "a" "copy" "of" target_permanent

/* A repeated +1/+1 applies independently to each listed keyword class.
   The two explicit examples establish the amount used by “and so on”. */
/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:Program{instructions:[...$so_on_explicit_pump, ...$so_on_explicit_pump_2, ...$so_on_pump_list]}} */
trigger_keyword_so_on_pumps ::= "at" turn_event "," "until" "end" "of" "turn" "," "each" "other" "creature" "you" "control" "gets" so_on_explicit_pump "," so_on_explicit_pump "," "and" "so" "on" "for" so_on_pump_list "."

/* @sem Instruction::$so_on_pump_effect */
so_on_explicit_pump ::= "+" "1" "/" "+" "1" "if" "it" "has" so_on_pump_effect

so_on_pump_list ::= so_on_pump_cons | so_on_pump_last

/* @sem Instruction::[...$so_on_pump_effect, ...$so_on_pump_list] */
so_on_pump_cons ::= so_on_pump_effect "," so_on_pump_list

/* @sem Instruction::$so_on_pump_effect */
so_on_pump_last ::= "and" so_on_pump_effect

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), CardType(Creature), ControlledBy(One(AbilityController)), $so_on_keyword_filter])}), changes:[Pump{power:Constant(1), toughness:Constant(1)}], duration:EndOfTurn, evaluation:Snapshot}}] */
so_on_pump_effect ::= so_on_keyword_filter

so_on_keyword_filter ::= so_on_regular_keyword | so_on_hexproof | so_on_protection | so_on_partner

/* @sem ObjectFilter::HasKeyword($so_on_keyword_name) */
so_on_regular_keyword ::= so_on_keyword_name

/* Hexproof without a qualifier denotes the family, not a particular instance. */
/* @sem ObjectFilter::HasKeywordFamily(Hexproof) */
so_on_hexproof ::= "hexproof"

/* @sem ObjectFilter::HasKeywordFamily(Protection) */
so_on_protection ::= "protection"

/* @sem ObjectFilter::HasKeywordFamily(Partner) */
so_on_partner ::= "partner"

so_on_keyword_name ::= kn_islandwalk | kn_flying | kn_first_strike | kn_double_strike | kn_trample | kn_lifelink | kn_deathtouch | kn_vigilance | kn_haste | kn_reach | kn_indestructible | kn_shroud | kn_menace | kn_defender | kn_flash | kn_fear | kn_intimidate | kn_infect | kn_wither | kn_prowess | kn_flanking | kn_horsemanship | kn_shadow | kn_skulk

/* The linked card population and the shared keyword list are independent. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[GainAbilitiesOf{objects:$delve_shared_origin, kinds:List([Term{family:CheckHasable, form:Flying}, ...$sharing_kind_tail])}]}) */
static_delve_shared_keywords ::= delve_shared_origin "," affected "has" "flying" "." "the" "same" "is" "true" "for" sharing_kind_tail "."

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}) */
delve_shared_origin ::= "if" "a" "creature" "card" "with" "flying" "was" "exiled" "with" "this" "creature's" "delve" "ability"

/* Compose the controlled target sequence with damage to a distinct target. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$control_untap_creature_keyword, Effect{result:@next, operation:$deal_damage_other_prior_target}]}} */
spell_control_untap_other_damage ::= control_untap_creature_keyword "." deal_damage_other_prior_target "."

equal_stat_value ::= linked_property_value | defining_life_paid_entering

/* @sem Expr::Game(LifePaid) */
defining_life_paid_entering ::= "the" "life" "paid" "as" "it" "entered"

/* The granted trigger retains its event and the property-difference program. */
/* @prefer always */
/* @sem Ability::Triggered{event:Object{event:Attacks, objects:SameObject(Source)}, limits:_{}, announcement:@announcement, body:$defender_tap_property_difference_program} */
defender_property_difference_trigger ::= "whenever" "this" "creature" "attacks" "," defender_tap_property_difference_program "."

/* The spending term is shared independently from the temporary action that uses it. */
/* @sem PlayTerms::PlayTerms{cost:Normal, spend_as:AnyType} */
spell_mana_cost_any_type ::= "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "type" "to" "pay" "that" "spell's" "mana" "cost"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(SpecialAction{body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), count:Exactly(Constant(1)), terms:$spell_mana_cost_any_type}}]}, limit:Total(1)})], duration:$this_duration, evaluation:LiveObjects} */
temporary_one_spell_spending ::= "for" "one" "spell" this_duration "," spell_mana_cost_any_type

/* The player recipient and the planeswalker controller identify one population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($plural, ObjectFilter::ControlledBy(One(PlayerRef::PlayerOrControllerOf(Targets(@last_slot)))))} */
affected_target_player_walker_controlled ::= plural "controlled" "by" "that" "player" "or" "by" "that" "planeswalker's" "controller"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($affected_target_player_walker_controlled), changes:$rule_changes, duration:$rule_duration, evaluation:LiveObjects} */
target_controller_rule ::= affected_target_player_walker_controlled rule_changes rule_duration

/* Ability loss and a colorless type replacement preserve existing card types. */
/* @sem Change::[...$singular_loss, ...$colorless_typed_base_form] */
shared_loss_and_colorless_form ::= singular_loss "and" "is" colorless_typed_base_form

/* @sem Change::[Colors{mode:Set, colors:[]}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetBasePowerToughness{power:$value, toughness:$value_2}] */
colorless_typed_base_form ::= "a" "colorless" becomes_types "with" "base" "power" "and" "toughness" value "/" value

affected_library_exile ::= affected_library_exile_one | affected_library_exile_many | controller_library_exile_one | controller_library_exile_many

/* @sem Operation::Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:$ordered_end}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]} */
affected_library_exile_one ::= "exile" "the" ordered_end "card" "of" "their" "library"

/* @sem Operation::Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:$count_plural, from:$ordered_end}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]} */
affected_library_exile_many ::= "exile" "the" ordered_end count_plural "cards" "of" "their" "library"

/* Preserve the independent controller-library reading of the follow-up. */
/* @sem Operation::Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:$ordered_end}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]} */
controller_library_exile_one ::= "exile" "the" ordered_end "card" "of" "their" "library"

/* @sem Operation::Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$count_plural, from:$ordered_end}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]} */
controller_library_exile_many ::= "exile" "the" ordered_end count_plural "cards" "of" "their" "library"

/* A leading duration can scope a keyword loss and subsequent grants. */
/* @prefer always */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[...$change_loses_keyword, ...$grant_two], duration:$duration, evaluation:Snapshot} */
continuous_leading_keyword_loss ::= duration "," affected change_loses_keyword "and" "gains" grant_two

/* @sem Operand::Term{family:CheckHasable, form:AnyHexproof, operands:[]} */
lost_hexproof ::= "hexproof"

/* An optional other target retains its target-exclusion anchor. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@copy_subject(ObjectSet::$affected, ObjectRef::$copy_other_target)), changes:[CopyOf{object:$copy_other_target, exceptions:[]}], duration:$duration, evaluation:Snapshot} */
copy_effect_leading_shared ::= duration "," affected "becomes" "a" "copy" "of" copy_other_target

/* The other object is distinct from the already named copy subject. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:@and(ObjectFilter::Not(SameObject(@current_named_object)), $filter_phrase)}), index:0} */
copy_other_target ::= "up" "to" "one" "other" "target" filter_phrase

/* The prohibition applies to the current battlefield population through combat. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$plural}), changes:[Rule(Prohibit(Attack(Any)))], duration:EndOfCombat, evaluation:LiveObjects} */
combat_plural_attack_prohibition ::= plural "can't" "attack" "this" "combat"

/* A comma can close a quoted static clause before the enclosing sentence continues.
   The granted holder supplies the embedded ability's Source and controller. */
/* @sem Change::GrantAbility(@holder(Ability::Static(_{kind:Ordinary, affected:Objects($static_affected), changes:$static_changes}))) */
grant_quoted_static_comma ::= '"' static_affected static_changes "," '"'

/* A leading duration applies independently to the three announced targets. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ControlledBy(OpponentsOf(AbilityController))])}), index:0})), changes:$singular_pump, duration:$until_your_next_turn, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:AllOf([Not(SameObject(Target{slot:0, index:0})), $noun_2])}))), changes:$singular_pump_2, duration:$until_your_next_turn, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:AllOf([Not(SameObject(Target{slot:0, index:0})), Not(SameObject(Target{slot:1, index:0})), $noun_3])}))), changes:$singular_pump_3, duration:$until_your_next_turn, evaluation:Snapshot}}] */
instructions_timed_three_distinct_pumps ::= until_your_next_turn "," "target" noun "an" "opponent" "controls" singular_pump "," "up" "to" "one" "other" "target" noun singular_pump "," "and" "up" "to" "one" "other" "target" noun singular_pump

/* Keep the entry and both uses of its returned incarnation in one contract. */
/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$noun_creature, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}])}), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[Named(FinalityCounter), Constant(1)]], states:[]}}, qualifiers:[]} */
post_grant_finality_graveyard_entry ::= "put" "target" noun_creature "card" "with" "mana" "value" number "or" "less" "from" "a" "graveyard" "onto" "the" "battlefield" "under" "your" "control" "with" "a" "finality" "counter" "on" "it"

/* @sem Instruction::[Effect{result:@mark, operation:$post_grant_finality_graveyard_entry}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@marked, phase:After, index:0})), changes:$grants, duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:$post_grant_turn_point, players:One(AbilityController)}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@marked, phase:After, index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}] */
clause_finality_entry_grant_exile ::= post_grant_finality_graveyard_entry "." "that" "creature" "gains" grants "." "at" "the" "beginning" "of" "your" "next" post_grant_turn_point "," "exile" "that" "creature"

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:Program{instructions:$clause_finality_entry_grant_exile}} */
triggered_finality_entry_grant_exile ::= event_clause "," clause_finality_entry_grant_exile "."

/* A battlefield arrival receives independently scoped quoted abilities. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$post_grant_move}, Effect{result:@next, operation:@return_grant(Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[$grant, $shared_granted_trigger_closed], duration:Indefinite, evaluation:Snapshot})}]} */
program_sentence_arrival_grant_pair ::= post_grant_move "." "it" "gains" grant "and" shared_granted_trigger_closed

/* Keep the recorded population tied to the snapshot that created it.  The
   repeated noun must agree even though its modifiers occur only once. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::@agree($plural, $plural_2), $modifiers)}), changes:$changes, duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(InSet(Recorded(@prior))), kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}}}] */
instructions_snapshot_prevent_recorded ::= plural modifiers changes duration "." "prevent" "all" "damage" "that" "would" "be" "dealt" "to" "those" plural this_duration

/* @sem Instruction::[...$instructions_snapshot_prevent_recorded, ...$instructions] */
instructions_snapshot_prevent_recorded_more ::= instructions_snapshot_prevent_recorded "." instructions

choice_entry_subject ::= choice_normal_entry | choice_escaped_entry

/* @prefer always */
/* @sem ObjectFilter::SameObject($self_ref) */
choice_normal_entry ::= self_ref "enters"

/* @sem ObjectFilter::AllOf([SameObject($object_ref), State(Escaped)]) */
choice_escaped_entry ::= object_ref "escapes"

/* @sem EventChange::Entry(CountersOfChoice{kinds:[$counter_kind, $counter_kind_2], amount:$counter_amount}) */
entry_counter_choice ::= "your" "choice" "of" counter_amount counter_kind "counter" "or" "a" counter_kind "counter"

/* A combat requirement and a named-control exception compose independently. */
/* @sem Change::[Rule(RequireCombat{action:Attack(Players($opponent_most_life)), amount:AtLeast(Constant(1))})] */
change_attacks_most_life ::= "attacks" opponent_most_life "each" "combat" "if" "able"

/* @sem Ability::Conditional{condition:Not($control_named_filter), then:[Static(_{kind:Ordinary, affected:Objects($affected), changes:$change_attacks_most_life})]} */
static_attack_named_exception ::= affected change_attacks_most_life "unless" control_named_filter "."

/* @sem Change::Rule(Unique(LethalDamageUsesPower)) */
lethal_damage_uses_power ::= "is" "determined" "by" "their" "power" "rather" "than" "their" "toughness"

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[$lethal_damage_uses_power]}) */
static_lethal_damage_rule ::= "lethal" "damage" "dealt" "to" affected lethal_damage_uses_power "."

/* A temporary pump counts the controller's filtered permanents at cast time. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:@times($signed, $cast_controlled_count), toughness:@times($signed_2, $cast_controlled_count)}], duration:$duration, evaluation:Snapshot} */
continuous_additional_cast_count ::= affected "gets" "an" "additional" signed "/" signed duration "for" "each" cast_controlled_count

/* @sem Expr::AsOf{moment:ThisSpellCast, value:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))})} */
cast_controlled_count ::= filter_phrase "you" "controlled" "as" "you" "cast" "this" "spell"

/* The optional blocker is distinct from the earlier compatible target; the
   pronoun continues to name that earlier target, not the new blocker. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@another_target_reference(ObjectFilter::$filter_phrase))), $filter_phrase)}))), changes:[Rule(RequireCombat{action:Block(SameObject(@another_target_reference(ObjectFilter::$filter_phrase))), amount:AtLeast(Constant(1))})], duration:$this_duration, evaluation:LiveObjects} */
optional_other_target_blocks_prior ::= "up" "to" "one" "other" "target" filter_phrase "blocks" "it" this_duration "if" "able"

/* Keep the original population, including creatures that receive no counter. */
/* @sem Instruction::[Effect{result:@mark, operation:NoteObjects{objects:$shared_counter_group_creatures}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Selected(@marked)), kind:$counter_kind, amount:Constant(1)}]}}, Effect{result:@next, operation:SetTapped{objects:Selected(@marked), tapped:true}}] */
shared_counter_group_tap ::= "put" "a" counter_kind "counter" "on" shared_counter_group_creatures "and" "tap" "those" "creatures" "."

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Selected(@marked)), changes:[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})], duration:WhileMatches{object:Affected, filter:Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})}, evaluation:LiveObjects}}] */
shared_counter_group_untap_rule ::= "each" "of" "those" "creatures" "doesn't" "untap" "during" "its" "controller's" "untap" "step" "for" "as" "long" "as" "it" "has" "a" counter_kind "counter" "on" "it" "."

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Selected(@marked)), changes:[GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[Mana($mana_symbols)]}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One(Source)), kind:$counter_kind, amount:Count(Exactly(Constant(1)))}]}}]}}))], duration:Indefinite, evaluation:Snapshot}}] */
shared_counter_group_grant_removal ::= "each" "of" "those" "creatures" "gains" '"' mana_symbols ":" "remove" "a" counter_kind "counter" "from" "this" "creature" "." '"'

/* @sem Program::Program{instructions:[...$shared_counter_group_tap, ...$shared_counter_group_untap_rule, ...$shared_counter_group_grant_removal]} */
shared_counter_group_program ::= shared_counter_group_tap shared_counter_group_untap_rule shared_counter_group_grant_removal

/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$shared_counter_group_program} */
shared_counter_group_turn_trigger ::= "at" turn_event "," shared_counter_group_program

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::CardType(Creature), $modifier_nonnumeric)} */
shared_counter_group_creatures ::= "each" "creature" modifier_nonnumeric

/* The quoted ability belongs to each transformed permanent. */
/* @sem Change::[SetArtifactType($singular_artifact_type), SetCardTypes([Artifact]), RemoveAllAbilities, $unpunctuated_quoted_activation] */
plural_artifact_conversion_grant ::= "become" singular_artifact_type "artifacts" "with" unpunctuated_quoted_activation "and" "lose" "all" "other" "abilities"

unpunctuated_quoted_activation ::= unpunctuated_artifact_activation | unpunctuated_generic_activation

/* @prefer always */
/* @sem Change::GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:$artifact_self_tap_sacrifice_cost, limits:_{}, announcement:@announcement, body:$program})) */
unpunctuated_artifact_activation ::= '"' artifact_self_tap_sacrifice_cost ":" program '"'

/* @sem Change::GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program})) */
unpunctuated_generic_activation ::= '"' cost ":" program '"'

/* Selection and continuation share the same announced target group. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:$self_explicit_ref, affected:Objects($per_player_other_union_targets), changes:$plural_artifact_conversion_grant, duration:WhileOnBattlefield($self_explicit_ref), evaluation:Snapshot}}] */
per_player_target_conversion ::= "for" "each" "player" "," "choose" per_player_other_union_targets "." "for" "as" "long" "as" self_explicit_ref "remains" "on" "the" "battlefield" "," "the" "chosen" "permanents" plural_artifact_conversion_grant "."

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:_{instructions:$per_player_target_conversion}} */
triggered_per_player_target_conversion ::= event_clause "," per_player_target_conversion

/* A chosen group retains its announcement and the current base statistics. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:AnyNumber, filter:$filter_plural}))), changes:[SetBasePowerToughness{power:$value, toughness:$value_2}], duration:Indefinite, evaluation:Snapshot} */
continuous_any_targets_base_stats ::= "any" "number" "of" "target" filter_plural "have" "base" "power" "and" "toughness" value "/" value

/* A matching attacker imposes an attack requirement on the separately named subject. */
/* @sem Change::[Rule(AttacksWhenAttacking($filter_phrase))] */
attack_requirement_trigger ::= "if" "a" filter_phrase "attacks"

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:$attack_requirement_trigger}) */
static_attack_requirement_prefix ::= attack_requirement_trigger "," affected "also" "attacks" "if" "able" "."

/* Controller-relative cause restrictions compose the affected players and action. */
/* @sem Ability::Static{kind:Ordinary, affected:Players($cause_controller_players), changes:[PlayerRule(CantBeCaused{action:$cause_controller_action, by:Not(ControlledBy(One(Affected)))})]} */
static_cause_controller_restriction ::= "spells" "and" "abilities" cause_controller_players "control" "can't" "cause" "their" "controller" "to" cause_controller_action "."

/* @sem PlayerSet::OpponentsOf(AbilityController) */
cause_controller_opponents ::= "your" "opponents"

/* @sem PlayerSet::One(AbilityController) */
cause_controller_you ::= "you"

cause_controller_players ::= cause_controller_opponents | cause_controller_you

cause_controller_action ::= cause_controller_search | player_prohibit_draw | player_prohibit_discard

/* @sem PlayerAction::SearchLibraries */
cause_controller_search ::= "search" "their" "library"

source_definition_colors ::= cross_colors | source_definition_colorless

/* @sem Change::[Colors{mode:Set, colors:[]}] */
source_definition_colorless ::= "colorless"

/* A plural population perpetually acquires an independently scoped ability. */
/* @sem Operation::CreatePerpetualEffect{objects:$affected, changes:[GrantAbility(@scope($perpetual_quoted_event_trigger))]} */
perpetual_population_quoted_trigger ::= affected "perpetually" "gain" '"' perpetual_quoted_event_trigger '"'

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$perpetual_quoted_event_program} */
perpetual_quoted_event_trigger ::= event_clause "," perpetual_quoted_event_program "."

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$perpetual_population_quoted_trigger}]}} */
triggered_perpetual_population_quote ::= event_clause "," perpetual_population_quoted_trigger

/* A timed source animation composes with other instructions. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_explicit_ref)), changes:$artifact_keyword_animation, duration:$duration, evaluation:Snapshot} */
source_timed_keyword_animation ::= duration "," self_explicit_ref artifact_keyword_animation

/* A choice to animate the source includes its conditional subtype loss in the
   same continuous effect. The subject and its later pronoun are the source. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$self_animation_with_loss}]}}] */
optional_self_animation ::= "you" "may" "have" self_animation_with_loss

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_explicit_ref)), changes:[...$animation_with, ...$animation_equipment_loss], duration:Indefinite, evaluation:Snapshot} */
self_animation_with_loss ::= self_explicit_ref "become" animation_with "." "if" "you" "do" "," animation_equipment_loss

/* @sem Change::[RemoveSubtype(Equipment)] */
animation_equipment_loss ::= "it" "isn't" "an" "Equipment"

/* A final quoted ability supplies the enclosing sentence's punctuation. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[$leading_quoted_grant], duration:$duration, evaluation:Snapshot} */
leading_quoted_ability_grant ::= duration "," affected "gains" leading_quoted_grant

leading_quoted_grant ::= preferred_damage_history_grant | grant_ability

/* @prefer always */
/* @sem Change::GrantAbility(@holder($static_damaged_cannot_regenerate)) */
preferred_damage_history_grant ::= '"' static_damaged_cannot_regenerate '"' 

/* Damage history belongs to the source named within the granted ability. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, Condition(Compare{left:EventHistory{event:Damage{source_kind:Permanent, sources:SameObject($object_ref), recipients:Objects(SameObject(Candidate)), kind:Any, grouping:SourceRecipient, subject:Recipient}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})])}), changes:[Rule(Prohibit(Regenerate))]} */
static_damaged_cannot_regenerate ::= filter_plural "dealt" "damage" "by" object_ref "this" "turn" "can't" "be" "regenerated" "this" "turn" "."

/* The enclosing reveal sequence supplies the antecedent for that card. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($affected), changes:[CopyOf{object:Earlier{what:Revealed}, exceptions:$copy_exceptions_plain}], duration:$duration, evaluation:Snapshot} */
copy_revealed_for_duration ::= affected "becomes" "a" "copy" "of" "that" "card" duration "," "except" copy_exceptions_plain

/* The replacement belongs to the arriving object, not the grant source. */
/* @sem Instruction::[Effect{result:@next, operation:$post_grant_move}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[GrantAbility(@holder($post_move_replacement_ability))], duration:Indefinite, evaluation:Snapshot}}] */
clause_post_move_quoted_replacement ::= post_grant_move "." "it" "gains" '"' post_move_replacement_ability '"'

/* @sem Program::Program{instructions:[...$clause_post_move_quoted_replacement]} */
program_sentence_post_move_quoted_replacement ::= clause_post_move_quoted_replacement

post_move_replacement_ability ::= post_move_creature_replacement | graveyard_return_granted_ability

/* @prefer always */
/* @sem Ability::Replacement{active:Battlefield, event:Object{event:LeavesBattlefield, objects:SameObject(Source)}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}} */
post_move_creature_replacement ::= "if" "this" "creature" "would" "leave" "the" "battlefield" "," "exile" "it" "instead" "of" "putting" "it" "anywhere" "else" "."

/* A singular controlled population gains the written list for a duration. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun, ControlledBy(One(AbilityController))])}), changes:$grants, duration:$duration, evaluation:Snapshot} */
controlled_each_temporary_grants ::= "each" noun "you" "control" "gains" grants duration

/* A duration scopes the same targeting exception for a player set and an object population. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players($permission_players), changes:[PlayerRule(TargetableDespite{sources:ControlledBy(One(AbilityController)), keyword:$permission_keyword})], duration:$targeting_permission_duration, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Rule(TargetableDespite{sources:ControlledBy(One(AbilityController)), keyword:$permission_keyword})], duration:$targeting_permission_duration, evaluation:LiveObjects}}] */
clause_timed_targeting_permission ::= targeting_permission_duration "," permission_players "and" affected permission_keyword

/* @prefer always */
/* @sem Duration::$until_end_of_turn */
targeting_permission_end_turn ::= until_end_of_turn

targeting_permission_duration ::= targeting_permission_end_turn | until_next_end_step | until_beginning_next_upkeep | duration_die_roll_earliest | until_end_of_combat | until_your_next_turn | until_end_of_your_next_turn | until_end_of_next_upkeep | until_next_upkeep | while_you_control | while_on_battlefield | until_player_planeswalks | while_you_control_and_tapped

/* The excluded object and controller both refer to the last announced target. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Target{slot:@last_slot, index:0})), $noun, ControlledBy(One(ControllerOf(Target{slot:@last_slot, index:0})))])} */
other_target_controller_population ::= "each" "other" noun "that" "player" "controls"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($other_target_controller_population), changes:$singular_pump, duration:$duration, evaluation:Snapshot} */
other_target_controller_snapshot ::= other_target_controller_population singular_pump duration

/* A counted bonus for a qualified controlled creature population. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$adjective, CardType(Creature), ControlledBy(One(AbilityController))])}), changes:[Pump{power:$value, toughness:$signed}], duration:$duration, evaluation:Snapshot} */
controlled_creature_counted_pump ::= adjective "creatures" "you" "control" "get" "+" "X" "/" signed duration "," "where" "X" "is" value

/* Snapshot pumps over explicitly named battlefield populations. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot} */
shared_all_population_pump ::= "all" filter_plural "get" signed "/" signed duration

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(OpponentsOf(AbilityController))])}), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot} */
shared_only_opponents_population_pump ::= "only" filter_plural "your" "opponents" "control" "get" signed "/" signed duration

/* A word-replacement choice also forms a complete spell on its own. */
/* @sem Ability::Spell{announcement:_{modes:$word_replacement_choice}, body:Program{}} */
spell_word_replacement_choice ::= word_replacement_choice "."

/* @sem ObjectSet::One($that_noun) */
shared_rule_anaphor ::= that_noun

/* Plural artifact animation retains the object's existing card types. */
/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, AddCardType(Artifact), AddCardType(Creature)] */
plural_artifact_creature_animation ::= "become" value "/" value "artifact" "creatures"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($any_number_controlled_noncreature_targets), changes:$plural_artifact_creature_animation, duration:Indefinite, evaluation:Snapshot} */
controlled_targets_artifact_animation ::= any_number_controlled_noncreature_targets plural_artifact_creature_animation

/* The target whose turn is named also controls the affected population. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$plural, ControlledBy(One($target_hand_owner))])}), changes:$next_turn_plural_combat, duration:DuringNextTurn($target_hand_owner), evaluation:LiveObjects} */
next_turn_controlled_combat ::= "during" target_hand_owner "next" "turn" "," plural "that" "player" "controls" next_turn_plural_combat "if" "able"

/* @sem Change::[Rule(RequireCombat{action:Attack(Players(One(AbilityController))), amount:AtLeast(Constant(1))})] */
next_turn_attack_you ::= "attack" "you"

/* @sem Change::[Rule(RequireCombat{action:Attack(Any), amount:AtLeast(Constant(1))})] */
next_turn_attack ::= "attack"

next_turn_plural_combat ::= next_turn_attack_you | next_turn_attack

/* The shared target receives two separately created temporary effects. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_object)), changes:[SetController(AbilityController)], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_object)), changes:[GrantKeyword($keyword_value)], duration:$duration, evaluation:Snapshot}}] */
clause_control_and_grant_separate ::= duration "," "gain" "control" "of" target_object "and" "it" "gains" keyword_value

/* The counter and grant refer to the same explicitly chosen controlled permanent. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun, ControlledBy(One(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Result{result:@marked, phase:After, index:0})), kind:$counter_kind, amount:Constant(1)}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@marked, phase:After, index:0})), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}]} */
program_sentence_chosen_counter_grant ::= "put" "a" counter_kind "counter" "on" "a" noun "you" "control" "." "it" "gains" keyword_name duration "."

/* A source's intrinsic battlefield ability can share a filtered graveyard population. */
/* @sem Change::[GainAbilitiesOf{objects:$personal_graveyard_filtered_cards, kinds:$copied_ability_kinds}] */
change_gained_personal_graveyard ::= "has" "all" copied_ability_kinds "abilities" "of" personal_graveyard_filtered_cards

/* @sem Ability::Static{kind:Ordinary, affected:Objects(One($self_explicit_ref)), changes:$change_gained_personal_graveyard} */
self_battlefield_graveyard_abilities ::= "as" "long" "as" self_explicit_ref "is" "on" "the" "battlefield" "," "it" change_gained_personal_graveyard "."

/* Add creature types and card type while retaining the subject’s other types. */
/* @sem Change::[CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Creature), SetBasePowerToughness{power:$value, toughness:$value_2}] */
retained_typed_creature_base ::= "is" "a" becomes_types "creature" "with" "base" "power" "and" "toughness" value "/" value "in" "addition" "to" "its" "other" "types"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$plural}), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot} */
population_signed_pump ::= "all" plural "get" signed "/" signed duration

/* A paired event's other participant receives the stated temporary changes. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(EventOther)), changes:$static_changes, duration:$duration, evaluation:Snapshot} */
paired_event_temporary_changes ::= static_changes duration

/* Both effects address the same announced creature, with independent durations. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($double_possessive_target_creature), changes:$double_stat_change, duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($double_possessive_target_creature), changes:$be_blocked_requirement, duration:$this_duration, evaluation:LiveObjects}}] */
shared_doubled_creature_block ::= "double" double_possessive_target_creature double_stat_change duration "." "that" "creature" be_blocked_requirement this_duration "if" "able"

/* The anaphor retains the controlled creature population in both branches. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), $creature_controller_modifier])}), changes:$plural_snapshot_pump_2, duration:$duration_2, evaluation:Snapshot}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), $creature_controller_modifier])}), changes:$plural_snapshot_pump, duration:$duration, evaluation:Snapshot}}]}}] */
controlled_creatures_pump_contrast ::= "creatures" creature_controller_modifier plural_snapshot_pump duration "." NEWLINE? "if" condition "," "those" "creatures" plural_snapshot_pump duration "instead"

/* @prefer always */
/* @sem ObjectSet::$permission_linked_exile_cards */
look_at_linked_exile_plain ::= "you" "may" "look" "at" permission_linked_exile_cards

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)} */
look_at_linked_exile_definite ::= "you" "may" "look" "at" "the" "cards" "exiled" "with" object_ref

/* @prefer always */
/* @sem Change::[PlayerRule(Visibility{objects:$look_at_linked_exile_cards, audience:AffectedPlayer}), PlayerRule(PlayPermission{cards:$look_at_linked_exile_cards, from:Exile, action:PlayLand, filter:Any}), PlayerRule(PlayPermission{cards:$look_at_linked_exile_cards, from:Exile, action:CastSpell, filter:Any})] */
linked_exile_look_and_play_base ::= look_at_linked_exile_cards "," "and" "you" "may" "play" "lands" "and" "cast" "spells" "from" "among" "those" "cards"

/* Adjacent controller rules remain separate sentences after static merging. */
/* @sem Change::[...$linked_exile_look_and_play_base, ...$controller_rule_followups] */
linked_exile_look_and_play_followed ::= linked_exile_look_and_play_base "." controller_rule_followups

controller_rule_followups ::= controller_rule_followup | controller_rule_followup_pair

/* @sem Change::[...$controller_rule_followup, ...$controller_rule_followup_2] */
controller_rule_followup_pair ::= controller_rule_followup "." controller_rule_followup

controller_rule_followup ::= controller_skip_draw_followup | controller_player_rule_followup

/* @sem Change::[PlayerRule(Skip(Draw))] */
controller_skip_draw_followup ::= "skip" "your" "draw" "step"

/* @sem Change::[PlayerRule($controller_player_rule)] */
controller_player_rule_followup ::= "you" controller_player_rule

/* An attacking target retains its independent inclusion and exclusion filters. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Attacking, $subtype, Not($subtype_2)])}), index:0})), changes:[CreatureTypes{mode:Add, types:Listed($becomes_type_one)}], duration:Indefinite, evaluation:Snapshot} */
attacking_filtered_add_type ::= "target" "attacking" subtype "that" "isn't" "a" subtype "becomes" "a" becomes_type_one "in" "addition" "to" "its" "other" "types"

/* The quoted ability receives its own scope and announcement. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$attacking_filtered_add_type}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$spell_gains_quoted_trigger, duration:Indefinite, evaluation:Snapshot}}]} */
program_attacking_type_and_grant ::= attacking_filtered_add_type "." affected spell_gains_quoted_trigger

/* A controlled subtype population and its plural pump remain independent operands. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($controlled_type_pump_subject, $modifier_you_control)} */
static_controlled_type_population ::= controlled_type_pump_subject modifier_you_control

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}] */
static_plural_pump ::= "get" signed "/" signed

/* @sem Ability::Static{kind:Ordinary, affected:Objects($static_controlled_type_population), changes:$static_plural_pump} */
static_controlled_type_pump ::= static_controlled_type_population static_plural_pump "."

/* A mana-value-qualified spell class and the prohibition on casting it.
   Keep this dispatch distinct from stack-object prohibitions. */
/* @sem ObjectFilter::AllOf([$adjective_nontype, Property{property:ManaValue, test:NumberTest::Compare{comparison:$stat_comparison, value:$qualified_spell_mana_operand}}]) */
qualified_spell_mana_filter ::= adjective_nontype "spells" "with" "mana" "value" stat_comparison qualified_spell_mana_operand

qualified_spell_mana_operand ::= qualified_spell_chosen_number | value_constant

/* @sem Expr::ChosenNumber */
qualified_spell_chosen_number ::= "the" "chosen" "number"

/* @sem Ability::Static(_{kind:Ordinary, affected:Players(All), changes:[PlayerRule(Prohibit(CastSpell{filter:$qualified_spell_mana_filter}))]}) */
static_qualified_spell_cast_prohibition ::= qualified_spell_mana_filter "can't" "be" "cast" "."

/* A unit reduction scales with the stated commander cast history. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Stack), kind:Spell, filter:@and($noun_commander, ObjectFilter::OwnedBy(One(AbilityController)))}), changes:[SpellCost(Reduce{reductions:[_{amount:$count_each_passive_commander_cast}], spill_into_generic:true})]} */
static_owned_commander_history_cost ::= "your" noun_commander "costs" "{" "1" "}" "less" "to" "cast" "for" "each" count_each_passive_commander_cast "."

controlled_creature_type ::= subtype | controlled_samurai_type | controlled_samurai_type_capital

/* @sem ObjectFilter::Subtype(Samurai) */
controlled_samurai_type ::= "samurai"

/* @sem ObjectFilter::Subtype(Samurai) */
controlled_samurai_type_capital ::= "↑" "samurai"

/* Temporary changes apply to the expressed controlled creature population. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($controlled_subtype_creatures), changes:$static_changes, duration:$duration, evaluation:Snapshot} */
controlled_subtype_creatures_snapshot ::= controlled_subtype_creatures static_changes duration

/* A single target is introduced before a later conditional refers to it. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($target_permanent)), changes:$singular_pump, duration:$duration, evaluation:Snapshot} */
target_singular_temporary_pump ::= target_permanent singular_pump duration

/* The type branch uses the target introduced by the temporary effect. */
/* @sem Instruction::[Effect{result:@next, operation:$target_singular_temporary_pump}, $target_type_conditional_branch] */
target_pump_type_followup ::= target_singular_temporary_pump "." target_type_conditional_branch

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$target_pump_type_followup}} */
spell_target_pump_type_followup ::= target_pump_type_followup "."

/* An attack-then-block payment retains one shared cost in both rules. */
/* @sem Change::[Rule(CombatCost{action:Attack(Any), payer:DeclaringPlayer, cost:$combat_payment_pays}), Rule(CombatCost{action:Block(Any), payer:DeclaringPlayer, cost:$combat_payment_pays})] */
quoted_combat_attack_block_controller ::= "can't" "attack" "or" "block" "unless" "its" "controller" combat_payment_pays

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:$quoted_combat_attack_block_controller}) */
quoted_combat_payment_static ::= affected quoted_combat_attack_block_controller "."

/* The affected object is the Aura's host, whose controller makes the choice. */
/* @sem ObjectSet::One(AttachedTo(Source)) */
attached_controller_assignment_subject ::= "enchanted" attached_possessive_noun "controller" "may" "have" "it"

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($attached_controller_assignment_subject), changes:$combat_assign_unblocked_neutral}) */
static_attached_controller_assignment ::= attached_controller_assignment_subject combat_assign_unblocked_neutral "."

/* @sem Change::[Rule(CombatDamage(AsUnblocked{optional:true}))] */
combat_assign_unblocked_neutral ::= "assign" "its" "combat" "damage" "as" "though" "it" "weren't" "blocked"

/* The counter follow-up uses the population captured by this snapshot effect. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), CardType(Creature), $plural_control_modifier])} */
snapshot_other_controlled_creature_population ::= "other" "creatures" plural_control_modifier

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($snapshot_other_controlled_creature_population), changes:[Pump{power:$signed_literal, toughness:$signed_literal_2}], duration:$duration, evaluation:Snapshot} */
snapshot_other_controlled_creature_pump ::= snapshot_other_controlled_creature_population "get" signed_literal "/" signed_literal duration

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$snapshot_other_controlled_creature_pump}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Affected(@prior)), kind:$an_named_counter, amount:Constant(1)}]}}]} */
program_other_pump_each_counter ::= snapshot_other_controlled_creature_pump "." "put" "an" an_named_counter "counter" "on" "each" "of" "them"

an_named_counter ::= cn_indestructible | cn_age | cn_aim

/* The caster, spell filter, turn window and cost adjustment remain independent. */
/* @sem Ability::Conditional{condition:$static_turn_window, then:[Static(_{kind:Ordinary, affected:Players($target_tax_casters), changes:[PlayerRule(SpellCost{spells:$cast_spells_filter, modifier:$spell_cost_change})]})]} */
shared_cast_cost_during_turn ::= cast_spells_filter target_tax_casters "cast" static_turn_window "cost" spell_cost_change "to" "cast" "."

/* The plural subject's untap limit remains a player rule, including its
   independently chosen permanent filter and amount. */
/* @sem Change::PlayerRule(UntapLimit{permanents:$filter_plural, amount:$value}) */
opponents_untap_limit_change ::= "can't" "untap" "more" "than" value filter_plural "during" "their" "untap" "steps"

/* @sem Ability::Static{kind:Ordinary, affected:Players(OpponentsOf(AbilityController)), changes:[$opponents_untap_limit_change]} */
static_opponents_untap_limit ::= "your" "opponents" opponents_untap_limit_change "."

/* In an attack trigger, the blocked creature is the attacker, not the target
   chosen as the blocker. The target and the duration remain independent. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Rule(RequireCombat{action:Block(SameObject(@event_subject)), amount:AtLeast(Constant(1))})], duration:$this_duration, evaluation:LiveObjects} */
attack_event_block_requirement ::= "have" affected "block" "it" this_duration "if" "able"

/* The event supplies the antecedent for the combat requirement. */
/* @sem Ability::Triggered{event:$event_attacks, limits:_{}, announcement:@announcement, body:_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:$attack_event_block_requirement}]}}]}} */
attack_event_optional_block_trigger ::= "whenever" event_attacks "," "you" "may" attack_event_block_requirement "."

/* A keyword grant and a counted bonus share one affected population. */
/* @sem Change::[...$change_grant, ...$change_pump_for_each] */
counted_grant_and_pump ::= change_grant "and" change_pump_for_each

/* @prefer always */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$counted_grant_and_pump, duration:$duration, evaluation:Snapshot} */
duration_affected_counted_grant ::= duration "," affected counted_grant_and_pump

/* A singular target remains the subject of both the rule and the conditional grant. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_permanent)), changes:$rule_change, duration:$rule_duration, evaluation:LiveObjects}}, If{condition:ObjectMatches{object:Target{slot:@last_slot, index:0}, filter:$subtype}, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@last_slot, index:0})), changes:$grants, duration:$duration, evaluation:Snapshot}}]}, otherwise:Program{}}] */
instructions_target_rule_conditional_grant ::= target_permanent rule_change rule_duration "." "if" "it's" "a" subtype "," "it" "also" "gains" grants duration

/* A player's casting permission carries the same zone in its source and card set. */
/* @sem Change::[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:$own_cast_zone, players:One(Affected)}, kind:Card, filter:Any}), from:$own_cast_zone, action:CastSpell, filter:$cast_spells_filter}, terms:_{cost:Free}})] */
free_cast_from_own_zone ::= "you" "may" "cast" cast_spells_filter "from" own_cast_zone "without" "paying" "their" "mana" "costs"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:$free_cast_from_own_zone, duration:$duration, evaluation:LiveObjects} */
temporary_free_cast_from_own_zone ::= duration "," free_cast_from_own_zone

/* The player rule follows the spells under that player's control. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellsHaveAbilities{spells:Any, abilities:List([Term{family:SpellEffect, form:CantBeCountered}])})], duration:$this_duration, evaluation:LiveObjects} */
temporary_controlled_spells_uncounterable ::= "spells" "you" "control" "can't" "be" "countered" this_duration

/* The two named qualities apply independently to both recipients. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(GrantKeyword(HexproofFrom(Each([Objects(_{kind:Any, filter:$adjective_color}), Objects(_{kind:Any, filter:$adjective_color_2})]))))], duration:$duration, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}), changes:[GrantKeyword(HexproofFrom(Each([Objects(_{kind:Any, filter:$adjective_color}), Objects(_{kind:Any, filter:$adjective_color_2})])))], duration:$duration, evaluation:Snapshot}}] */
clause_you_and_objects_gain_hexproof_colors ::= "you" "and" filter_plural "gain" "hexproof" "from" adjective_color "and" "from" adjective_color duration

/* Keep the three resolution sentences in one paragraph. */
/* @prefer always */
/* @sem Instruction::[...$clause_imperative_postcondition, Effect{result:@next, operation:$temporary_controlled_spells_uncounterable}, ...$clause_you_and_objects_gain_hexproof_colors] */
instructions_postcondition_uncounterable_hexproof ::= clause_imperative_postcondition "." temporary_controlled_spells_uncounterable "." clause_you_and_objects_gain_hexproof_colors

/* The source is the holder of the token ability. */
/* @prefer always */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[RemoveCardType(Creature)], duration:EndOfTurn, evaluation:Snapshot} */
token_not_creature_until_end ::= self_token "isn't" "a" "creature" "until" "end" "of" "turn"

/* A postposed keyword test qualifies the spell receiving the cost change. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:@and($singular_cast_cost_subject, $condition_keyword_family), modifier:$spell_cost_change})]}) */
static_singular_keyword_qualified_cost ::= singular_cast_cost_subject "you" "cast" "costs" spell_cost_change "to" "cast" "if" "it" "has" condition_keyword_family "."

/* Two-subtype creature list for retained planeswalker animations (avoids colliding with 3-subtype Gideon, Ally of Zendikar's mode:Set tail rule). */
/* @sem CreatureType::[@subtype_name($becomes_creature_subtype), @subtype_name($becomes_creature_subtype_2)] */
retained_walker_type_pair ::= becomes_creature_subtype becomes_creature_subtype

/* A named source retains its planeswalker type while becoming a creature. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_ref_named)), changes:[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Add, types:Listed($retained_walker_type_pair)}, AddCardType(Creature), GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot} */
retained_walker_named_animation ::= duration "," self_ref_named "becomes" "a" value "/" value retained_walker_type_pair "creature" "with" keyword_name "that's" "still" "a" "planeswalker"

/* Standalone ability-body grant on the card-level chosen creature (scoped to program so multi-sentence bolster triggers like Optimus Prime cannot misbind to Chosen). */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($affected_chosen_creature), changes:$static_changes, duration:$duration, evaluation:Snapshot}}]} */
program_chosen_creature_changes ::= affected_chosen_creature static_changes duration

/* Both coordinated populations share the source exclusion, token restriction and controller. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), Not(Token), AnyOf([$filter_plural, $filter_plural_2]), ControlledBy(One(AbilityController))])} */
other_nontoken_controlled_union ::= "other" "nontoken" filter_plural "and" filter_plural "you" "control"

/* @sem Ability::Static{kind:Ordinary, affected:Objects($other_nontoken_controlled_union), changes:[GrantAbility(Mechanic{mechanic:Modular, amount:$value})]} */
static_other_nontoken_union_modular ::= other_nontoken_controlled_union "have" "modular" value "."

/* A control qualifier on the affected population does not qualify blockers. */
/* @sem ObjectFilter::@and($filter_plural, ObjectFilter::Not(State(NoAbilities))) */
blocker_with_abilities ::= filter_plural "with" "abilities"
/* @sem ObjectFilter::@and($controlled_plural_population, ObjectFilter::Not(State(NoAbilities))) */
controlled_blocker_with_abilities ::= controlled_plural_population "with" "abilities"
blocker_ability_qualified ::= blocker_with_abilities | controlled_blocker_with_abilities
/* @sem Change::[Rule(Prohibit(BeBlocked($blocker_ability_qualified)))] */
rule_cant_be_blocked_by_ability_qualified ::= "can't" "be" "blocked" "by" blocker_ability_qualified

/* A temporary pump captures the controlled subtype creature population. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$capitalized_pump_subtype, CardType(Creature), ControlledBy(One(AbilityController))])}), changes:[Pump{power:$signed_literal, toughness:$signed_literal_2}], duration:$duration, evaluation:Snapshot} */
subtype_creatures_controlled_snapshot ::= "↑" capitalized_pump_subtype "creatures" "you" "control" "get" signed_literal "/" signed_literal duration

/* @sem ObjectFilter::Subtype(Samurai) */
capitalized_pump_subtype ::= "samurai"

/* The spell filter and the additional sacrifice are independent operands. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(Affected)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:$graveyard_paid_spell_filter}, terms:_{limit:EachTurn(1), during:One(AbilityController), cost:Additional(Cost{parts:[$cast_sacrifice_permanent_cost]})}})]}) */
static_once_graveyard_cast_additional_sacrifice ::= "once" "during" "each" "of" "your" "turns" "," "you" "may" "cast" graveyard_paid_spell_filter "spell" "from" "your" "graveyard" "by" cast_sacrifice_permanent_cost "in" "addition" "to" "paying" "its" "other" "costs" "."

/* Articles belong to their corresponding spell-type phrases. */
graveyard_paid_spell_filter ::= graveyard_paid_spell_a | graveyard_paid_spell_an
/* @sem ObjectFilter::$graveyard_paid_spell_a_kind */
graveyard_paid_spell_a ::= "a" graveyard_paid_spell_a_kind
graveyard_paid_spell_a_kind ::= qualified_permanent_spell_kind | noun_battle | noun_creature | noun_land | noun_planeswalker | spell_sorcery
/* @sem ObjectFilter::$graveyard_paid_spell_an_kind */
graveyard_paid_spell_an ::= "an" graveyard_paid_spell_an_kind
graveyard_paid_spell_an_kind ::= noun_artifact | noun_enchantment | spell_instant

/* The power threshold is tested after the temporary pump and fires a reflexive trigger with its own target. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($self_explicit_ref)), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot}}, If{condition:ObjectMatches{object:Source, filter:Property{property:Power, test:Compare{comparison:Equal, value:$number}}}, then:@reflexive(Program::Program{instructions:[Effect{result:@next, operation:ReflexiveTrigger{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any})), amount:$number_2, preventable:true}}]}}}]}), otherwise:Program{}}] */
instructions_self_pump_power_reflexive ::= self_explicit_ref "gets" signed "/" signed duration "." "when" "its" "power" "becomes" number "this" "way" "," "it" "deals" number "damage" "to" "any" "target"

/* The announced target creature is the affected object and supplies both measured characteristics. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($triple_target_creature_possessive)), changes:[Pump{power:Multiply([Constant(2), ObjectProperty{object:Target{slot:@last_slot, index:0}, property:Power, information:CurrentOrLastKnown}]), toughness:Multiply([Constant(2), ObjectProperty{object:Target{slot:@last_slot, index:0}, property:Toughness, information:CurrentOrLastKnown}])}], duration:$duration, evaluation:Snapshot} */
triple_target_characteristics ::= "triple" triple_target_creature_possessive "power" "and" "toughness" duration

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0} */
triple_target_creature_possessive ::= "target" "creature's"

/* In a holder attack, another excludes the attacking holder. */
/* @sem Operation::@where(Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $filter_phrase)}), index:0})), changes:$change_gets_defined_power, duration:$duration, evaluation:Snapshot}, $value) */
holder_other_defined_pump ::= "another" "target" filter_phrase change_gets_defined_power duration "," "where" "X" "is" value

/* Switch a battlefield population, retaining the current affected filter. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[SwitchPowerToughness], duration:Indefinite, evaluation:Snapshot} */
switch_battlefield_population ::= "switch" "the" "power" "and" "toughness" "of" affected "on" "the" "battlefield"

/* Retained artifact type and granted abilities compose with any leading duration. */
/* @sem Change::[...$retained_vehicle_stats, ...$two_keywords_and_crew] */
retained_vehicle_stats_grants ::= retained_vehicle_stats "and" two_keywords_and_crew

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, AddArtifactType(Vehicle)] */
retained_vehicle_stats ::= "becomes" "a" value "/" value "Vehicle" "in" "addition" "to" "its" "other" "types"

/* @sem Change::[GrantKeyword($keyword_value), GrantKeyword($keyword_value_2), $grant_crew_ability] */
two_keywords_and_crew ::= "gains" keyword_value "," keyword_value "," "and" grant_crew_ability

/* The other combatant exists only within the paired block trigger below. */
/* @sem Expr::ObjectProperty{object:BlockPair(Other), property:$combat_other_property, information:CurrentOrLastKnown} */
combat_other_stat ::= combat_other_property

/* @sem Property::Power */
combat_other_power ::= "power"

/* @sem Property::Toughness */
combat_other_toughness ::= "toughness"

combat_other_property ::= combat_other_power | combat_other_toughness

/* @sem Change::[SetPower($combat_other_stat), SetToughness($combat_other_stat_2)] */
combat_other_base_stats ::= "base" "power" "and" "toughness" "become" "equal" "to" "that" "creature's" combat_other_stat "and" combat_other_stat

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_possessive)), changes:$combat_other_base_stats, duration:$duration, evaluation:Snapshot} */
combat_other_base_effect ::= self_possessive combat_other_base_stats duration

/* A pair event supplies the antecedent for the combatant's characteristics. */
/* @sem Ability::Triggered{event:$event_blocks_or_blocked, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$combat_other_base_effect}]}} */
combat_pair_stats_when ::= "when" event_blocks_or_blocked "," combat_other_base_effect "."

/* @sem Ability::Triggered{event:$event_blocks_or_blocked, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$combat_other_base_effect}]}} */
/* @prefer always */
combat_pair_stats_whenever ::= "whenever" event_blocks_or_blocked "," combat_other_base_effect "."

/* Prefer a single sentence when a prohibition introduces further changes. */
/* @prefer always */
/* @sem Change::[...$rule_prohibit_action, ...$static_changes_plain] */
static_changes_prohibited_and ::= rule_prohibit_action "and" static_changes_plain

/* @sem ObjectAction::Untap */
prohibit_become_untapped ::= "become" "untapped"

/* A type choice made by this instruction governs the live combat population. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:CreatureType, terms:_{count:Exactly(Constant(1)), options:[]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($chosen_type_population_bare), changes:$chosen_type_combat_change, duration:$this_duration, evaluation:LiveObjects}}] */
instructions_chosen_type_combat ::= chosen_type_population_bare chosen_type_combat_change this_duration "if" "able"

/* @sem Change::[Rule(RequireCombat{action:Attack(Any), amount:AtLeast(Constant(1))})] */
chosen_type_combat_change ::= "attack"

/* The later combat rule refers to the same announced creature target. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($resolution_combat_target)), changes:[Rule(Prohibit(Block(Any)))], duration:$this_duration, evaluation:LiveObjects}}, If{condition:$condition_nth_resolution_this_turn, then:Program{instructions:[Effect{result:@next, operation:EffectOn{subject:Objects(One(Target{slot:@last_slot, index:0})), effects:[Vocabulary{family:PermanentRule, form:AttacksEachCombatIfAble}], until:UntilNext{point:CombatEnds, players:One(ControllerOf(Target{slot:@last_slot, index:0}))}}}]}, otherwise:Program{}}]} */
resolution_combat_program ::= resolution_combat_target "can't" "block" this_duration "." "if" condition_nth_resolution_this_turn "," "that" "creature" "attacks" "during" "its" "controller's" "next" "combat" "phase" "if" "able" "."

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), $resolution_combat_controller])}), index:0} */
resolution_combat_target ::= "target" "creature" resolution_combat_controller

resolution_combat_controller ::= modifier_opponent_controls | modifier_you_control

/* The named type conversion and the subsequent granted abilities are separate
   continuous effects; both retain their current operands. */
/* @sem Change::[AddSupertype(Legendary), AddArtifactType(Equipment), AddCardType(Artifact), SetName($referenced_card_name)] */
named_legendary_equipment_changes ::= "a" "legendary" "Equipment" "artifact" "named" referenced_card_name

/* @sem Ability::Static{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Pump{power:$signed, toughness:$signed_2}]} */
equipped_creature_stat_grant ::= "equipped" "creature" "gets" signed "/" signed

/* @sem Change::[RemoveAllAbilities, GrantAbility(@scope(Ability::Activated{origin:Equip, cost:Cost{parts:[Mana($mana_symbols)]}, limits:_{sorcery:true}, body:_{instructions:[Effect{result:@next, operation:Attach{attachments:One(Source), host:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), index:0}}}]}, announcement:@announcement})), GrantAbility($equipped_creature_stat_grant)] */
equipment_replacement_grants ::= "it" "gains" "equip" mana_symbols "and" '"' equipped_creature_stat_grant '"' "and" "loses" "all" "other" "abilities"

/* A turn-qualified ordered spell and its reduction have independent operands. */
/* @sem @and($subtype_negated, $filter_phrase, ObjectFilter::HasKeyword($keyword_value)) */
ordered_excluded_keyword_filter ::= subtype_negated filter_phrase "spell" "with" keyword_value

/* @sem ObjectFilter::NthCast{ordinal:$cast_order, spells:$ordered_excluded_keyword_filter, by:One(AbilityController), scope:Turn} */
ordered_own_turn_keyword_spell ::= "the" cast_order ordered_excluded_keyword_filter "you" "cast" "during" "each" "of" "your" "turns"

/* @sem Ability::Conditional{condition:PlayerIsActive(AbilityController), then:[Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellCost{spells:$ordered_own_turn_keyword_spell, modifier:$spell_cost_less})]})]} */
own_turn_ordered_spell_cost ::= ordered_own_turn_keyword_spell "costs" spell_cost_less "to" "cast" "."

/* A second, counted pump modifies the same target in the same snapshot. */
/* @sem Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Name($referenced_card_name)}) */
count_named_card_your_graveyard ::= "card" "named" referenced_card_name "in" "your" "graveyard"

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}, Pump{power:@times($signed_3, $count_named_card_your_graveyard), toughness:@times($signed_4, $count_named_card_your_graveyard)}] */
additional_counted_pump_changes ::= "gets" signed "/" signed "until" "end" "of" "turn" "." "it" "gets" "an" "additional" signed "/" signed "until" "end" "of" "turn" "for" "each" count_named_card_your_graveyard

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_object)), changes:$additional_counted_pump_changes, duration:EndOfTurn, evaluation:Snapshot}}] */
instructions_target_additional_counted_pump ::= target_object additional_counted_pump_changes

/* Choosing announces the target; the later anaphor refers to that same object. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($chosen_active_controlled_creature)), changes:[Rule(RequireCombat{action:Attack(Any), amount:AtLeast(Constant(1))})], duration:$this_duration, evaluation:LiveObjects}}] */
chosen_controlled_attack_requirement ::= "choose" chosen_active_controlled_creature "." "that" "creature" "attacks" this_duration "if" "able"

/* A conditional follow-up refers to the same team immediately after the
   first snapshot effect, with no intervening action changing its membership. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($conditional_team), changes:$conditional_team_pump, duration:$duration, evaluation:Snapshot}}, If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($conditional_team), changes:[GrantKeyword($keyword_name)], duration:$duration_2, evaluation:Snapshot}}]}, otherwise:Program{}}] */
clause_creature_group_conditional_grant ::= conditional_team conditional_team_pump duration "." NEWLINE "if" condition "," "those" "creatures" "also" "gain" keyword_name duration

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])} */
conditional_team ::= "creatures" "you" "control"

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}] */
conditional_team_pump ::= "get" signed "/" signed

/* The targets share a creature type, while their controller remains explicit. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly($number), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))]), constraints:[CommonProperty(CreatureTypes)]})) */
affected_shared_creature_type_targets ::= number "target" "creatures" "you" "control" "that" "share" "a" "creature" "type"

/* A leading duration scopes the whole animation, ability removal and grant. */
/* @prefer always */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[...$base_animation, RemoveAllAbilities, ...$grants], duration:$duration, evaluation:Snapshot} */
continuous_become_then_lose_grant ::= duration "," affected "becomes" base_animation "," "loses" "all" "abilities" "," "and" "gains" grants

/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word, $mana_color_word_2]}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetBasePowerToughness{power:$value, toughness:$value_2}] */
base_two_color_subtypes ::= "a" mana_color_word "and" mana_color_word becomes_types "with" "base" "power" "and" "toughness" value "/" value

/* Each qualifier belongs to its own spell or source, and both are controlled by opponents. */
/* @sem Change::[Rule(Prohibit(BeTargeted(@and(ObjectFilter::OnStack(Spell), @and($spell_adjectives, ObjectFilter::ControlledBy(OpponentsOf(AbilityController))))))), Rule(Prohibit(BeTargeted(@and(ObjectFilter::Not(OnStack(Spell)), ObjectFilter::AbilityOf(@and($spell_adjectives_2, ObjectFilter::ControlledBy(OpponentsOf(AbilityController))))))))] */
target_ban_opponent_spells_or_sources ::= spell_adjectives "spells" "your" "opponents" "control" "or" "abilities" "from" spell_adjectives "sources" "your" "opponents" "control"

/* An if-clause composes with an independently typed player rule. */
/* @sem Ability::Conditional{condition:$condition, then:[$shared_conditional_player_body]} */
shared_if_player_rule ::= "if" condition "," shared_conditional_player_body

/* The second sentence refers to the target introduced by the first; both
   bonuses share the explicitly stated end-of-turn expiration. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($target_permanent)), changes:[Pump{power:$signed_literal, toughness:$signed_literal_2}, ...$additional_counted_pump], duration:EndOfTurn, evaluation:Snapshot} */
continuous_target_pump_followup ::= target_permanent "gets" signed_literal "/" signed_literal "until" "end" "of" "turn" "." "it" additional_counted_pump

/* @sem Change::[Pump{power:Multiply([$signed_literal, $named_graveyard_card_count]), toughness:Multiply([$signed_literal_2, $named_graveyard_card_count])}] */
additional_counted_pump ::= "gets" "an" "additional" signed_literal "/" signed_literal "until" "end" "of" "turn" "for" "each" named_graveyard_card_count

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One($zone_owner)}, kind:Card, filter:Name(@card_name)}) */
named_graveyard_card_count ::= "card" "named" SELF_NAME "in" zone_owner "graveyard"

/* A leading duration applies independently to a player rule and a snapshot
   grant to a battlefield population. The shared grant list retains each keyword. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:$life_lock_rule, duration:$duration, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}), changes:$grants, duration:$duration, evaluation:Snapshot}}] */
clause_life_lock_and_grants ::= duration "," life_lock_rule "," "and" filter_plural "gain" grants

/* @sem Change::[PlayerRule(LifeTotalLocked)] */
life_lock_rule ::= "your" "life" "total" "can't" "change"

/* The chosen creature is the sole announced target in this scoped sequence. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($combat_continuously_controlled_target)), changes:[Rule(RequireCombat{action:Attack(Any), amount:AtLeast(Constant(1))})], duration:$this_duration, evaluation:LiveObjects} */
combat_chosen_attack_requirement ::= "choose" combat_continuously_controlled_target "." "that" "creature" "attacks" this_duration "if" "able"

/* The controlled subtype population is fixed when the keyword grants resolve. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$controlled_keyword_subtype, ControlledBy(One(AbilityController))])}), changes:[GrantKeyword($keyword_name), GrantKeyword($keyword_name_2)], duration:$duration, evaluation:Snapshot} */
controlled_subtype_keyword_pair_snapshot ::= controlled_keyword_subtype "you" "control" "gain" keyword_name "and" keyword_name duration

controlled_keyword_subtype ::= subtype_plural | controlled_keyword_humans | controlled_keyword_goblins

/* @sem ObjectFilter::Subtype(Human) */
controlled_keyword_humans ::= "humans"

/* @sem ObjectFilter::Subtype(Goblin) */
controlled_keyword_goblins ::= "goblins"

/* The passive participle identifies the class of attachments prohibited. */
/* @sem Change::[Rule(Prohibit(BeAttachedBy{attachments:Subtype($attachment_passive_type), keep_existing:false}))] */
rule_cant_be_attached_type ::= "can't" "be" attachment_passive_type

attachment_passive_type ::= attachment_passive_equipment | attachment_passive_aura

/* @sem Subtype::Equipment */
attachment_passive_equipment ::= "equipped"

/* @sem Subtype::Aura */
attachment_passive_aura ::= "enchanted"

/* A targeted controlled permanent receives a temporary keyword. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ControlledBy(One(AbilityController))])}), index:0})), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot} */
controlled_target_keyword_grant ::= "target" noun "you" "control" "gains" keyword_name duration

/* A quoted pump is an ability of each affected Equipment. */
/* @sem Change::GrantAbility(@holder(Ability::Static{kind:Ordinary, affected:Objects(One(AttachedTo(Source))), changes:[Pump{power:$signed, toughness:$signed_2}]})) */
grant_quoted_equipped_pump ::= '"' "equipped" "creature" "gets" signed "/" signed '"'

/* The plural subject controls agreement for both additive and granted traits. */
/* @prefer always */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($affected_plural), changes:[...$retained_equipment_type, ...$grants]} */
static_plural_retained_equipment ::= affected_plural retained_equipment_type "and" "have" grants "."

/* @sem Change::[AddArtifactType(Equipment)] */
retained_equipment_type ::= "are" "Equipment" "in" "addition" "to" "their" "other" "types"

/* A singular creature target anchors the relative hand-count definition. */
/* @sem Operation::@where(Operation::CreateContinuousEffect{source:Source, affected:Objects(One($hand_deficit_creature_target)), changes:$change_gets_defined_pair, duration:$duration, evaluation:Snapshot}, $creature_controller_hand_deficit) */
creature_defined_hand_snapshot ::= hand_deficit_creature_target change_gets_defined_pair duration "," "where" "X" "is" creature_controller_hand_deficit

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$hand_deficit_creature_filter}), index:0} */
hand_deficit_creature_target ::= "target" hand_deficit_creature_filter

hand_deficit_creature_filter ::= noun_creature | artifact_creature_filter

/* @sem ObjectFilter::AllOf([CardType(Artifact), CardType(Creature)]) */
artifact_creature_filter ::= "artifact" "creature"

/* @sem Change::[Pump{power:@times($defined_x_sign, Expr::AnnouncedX), toughness:@times($defined_x_sign_2, Expr::AnnouncedX)}] */
change_gets_defined_pair ::= "gets" defined_x_sign "/" defined_x_sign

/* @sem Expr::Subtract([$value, CountObjects(Zone{scope:Players{zone:Hand, players:One(ControllerOf(@it))}, kind:Card, filter:Any})]) */
creature_controller_hand_deficit ::= value "minus" "the" "number" "of" "cards" "in" "that" "creature's" "controller's" "hand"

/* The subtype and controller identify the same battlefield population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($controlled_basic_land_subtype, ObjectFilter::ControlledBy(One(AbilityController)))} */
controlled_basic_land_subject ::= controlled_basic_land_subtype "you" "control"

controlled_basic_land_subtype ::= mana_list_land | st_island_pl | st_mountain_pl

/* The inner activation belongs to each affected land. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects($controlled_basic_land_subject), changes:[GrantAbility(@holder($activated_ability))]} */
controlled_basic_land_single_grant ::= controlled_basic_land_subject "have" "'" activated_ability "'"

/* One condition governs two distinct player restrictions. */
/* @sem Ability::Conditional{condition:$condition, then:[Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:$you_cannot_lose_rule}, Ability::Static{kind:Ordinary, affected:Players(OpponentsOf(AbilityController)), changes:$opponents_cannot_win_rule}]} */
shared_conditional_game_protection ::= "as" "long" "as" condition "," "you" you_cannot_lose_rule "and" "your" "opponents" opponents_cannot_win_rule "."

shared_duration_pump ::= change_literal_pump | shared_duration_x_power | shared_duration_x_toughness

/* @sem Change::[Pump{power:$shared_duration_signed_x, toughness:$signed_literal}] */
shared_duration_x_power ::= "gets" shared_duration_signed_x "/" signed_literal

/* @sem Change::[Pump{power:$signed_literal, toughness:$shared_duration_signed_x}] */
shared_duration_x_toughness ::= "gets" signed_literal "/" shared_duration_signed_x

shared_duration_signed_x ::= shared_duration_plus_x | shared_duration_minus_x

/* @sem Expr::BoundValue(@marked) */
shared_duration_plus_x ::= "+" "X"

/* @sem Expr::Multiply([Constant(-1), BoundValue(@marked)]) */
shared_duration_minus_x ::= "-" "X"

/* The crew history refers to the preceding subject, not the copied target. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(Supertype(Legendary)), $noun, Condition(Compare{left:EventHistory{event:Pair{event:Crews, objects:SameObject(Candidate), others:SameObject(@current_it)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})])}), index:0} */
copy_crewed_nonlegendary_target ::= "target" "nonlegendary" noun "that" "crewed" "it" "this" "turn"

/* Independent copiable exceptions retain their own operands. */
/* @sem Vec<CopyException>::[$copy_fixed_stats, ...$copy_vehicle_artifact_retained, $copy_keyword_ability] */
copy_stats_vehicle_keyword ::= copy_fixed_stats "," copy_vehicle_artifact_retained "," "and" copy_keyword_ability

/* A sequence of distinct target slots can assign each recipient its own pump.
   These clauses are scoped to the three-slot spell wrapper below. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0})), changes:$distinct_target_pump, duration:EndOfTurn, evaluation:Snapshot}}] */
distinct_first_creature_pump ::= "target" "creature" distinct_target_pump

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:AllOf([Not(SameObject(Target{slot:0, index:0})), CardType(Creature)])}), index:0})), changes:$distinct_target_pump, duration:EndOfTurn, evaluation:Snapshot}}] */
distinct_second_creature_pump ::= "up" "to" "one" "other" "target" "creature" distinct_target_pump

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:AllOf([Not(SameObject(Target{slot:0, index:0})), Not(SameObject(Target{slot:1, index:0})), CardType(Creature)])}), index:0})), changes:$distinct_target_pump, duration:EndOfTurn, evaluation:Snapshot}}] */
distinct_third_creature_pump ::= "up" "to" "one" "other" "target" "creature" distinct_target_pump

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}] */
distinct_target_pump ::= "gets" signed "/" signed

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject(Target{slot:0, index:0}), SameObject(Target{slot:1, index:0}), SameObject(Target{slot:2, index:0})])}), changes:[GrantKeyword($keyword_name)], duration:EndOfTurn, evaluation:Snapshot}}] */
distinct_three_creatures_grant ::= "those" "creatures" "gain" keyword_name "until" "end" "of" "turn"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$distinct_first_creature_pump, ...$distinct_second_creature_pump, ...$distinct_third_creature_pump, ...$distinct_three_creatures_grant]}} */
spell_distinct_three_creature_pumps ::= "until" "end" "of" "turn" "," distinct_first_creature_pump "," distinct_second_creature_pump "," "and" distinct_third_creature_pump "." distinct_three_creatures_grant "."

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController)), Property{property:Toughness, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}])}), index:0})), changes:$changes, duration:$duration, evaluation:Snapshot}}] */
controlled_creature_timed_changes ::= "target" "creature" "you" "control" "with" "toughness" number "or" "less" changes duration

/* A counter cap describes the same singular object named by the subject and
   the anaphoric “it”; its kind and maximum remain independent operands. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(One($self_explicit_ref)), changes:$self_counter_limit_change} */
static_self_counter_limit ::= self_explicit_ref self_counter_limit_change "."

/* @sem Change::[Rule(CounterLimit{kind:$counter_kind, max:$value})] */
self_counter_limit_change ::= "can't" "have" "more" "than" value counter_kind "counters" "on" "it"

/* Attack-drag wording composes the affected attacker and required population. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:[$shared_attack_drag_requirement]}) */
shared_affected_attack_drag ::= "if" affected "attacks" "," shared_attack_drag_requirement "."

/* @sem Change::Rule(AttackDrags($filter_plural)) */
shared_attack_drag_requirement ::= "all" filter_plural "attack" "if" "able"
