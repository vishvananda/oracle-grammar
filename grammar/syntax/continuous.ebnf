retained_color_type ::= "is" "a" mana_color_word becomes_types "in" "addition" "to" "its" "other" "colors" "and" "types"

/* Player-facing rules compose independently of the affected population. */
/* @sem Ability::Static{kind:Ordinary, affected:Players(All), changes:[PlayerRule($plural_shared_player_rule)]} */
static_all_shared_player_rule ::= "players" plural_shared_player_rule "."

plural_shared_player_rule ::= player_retain_all_mana | player_reveal_draws

/* @sem PlayerRule::RetainMana{} */
player_retain_all_mana ::= "don't" "lose" "unspent" "mana" "as" "steps" "and" "phases" "end"

/* @sem PlayerRule::RevealDraws{} */
player_reveal_draws ::= "reveal" "each" "card" "they" "draw"

/* @sem Ability::Static{kind:Ordinary, affected:Players($players_singular), changes:[PlayerRule($singular_shared_player_rule)]} */
static_singular_shared_player_rule ::= players_singular singular_shared_player_rule "."

singular_shared_player_rule ::= player_filtered_cast_limit | player_venture_limit | player_direction_attack_limit

/* @sem PlayerRule::LimitPerTurn{action:CastSpell{filter:$limited_spell_filter}, amount:$value} */
player_filtered_cast_limit ::= "can't" "cast" "more" "than" value limited_spell_filter "spell" "each" "turn"

limited_spell_filter ::= adjective_nontype | subtype_negated

/* @sem PlayerRule::LimitPerTurn{action:VentureIntoDungeon, amount:Constant(1)} */
player_venture_limit ::= "can't" "venture" "into" "the" "dungeon" "more" "than" "once" "each" "turn"

/* @sem PlayerRule::AttackOnly(PlayersAndPlaneswalkers(One(InChosenDirection{among:OpponentsOf(AbilityController)}))) */
player_direction_attack_limit ::= "may" "attack" "only" "the" "nearest" "opponent" "in" "the" "last" "chosen" "direction" "and" "planeswalkers" "controlled" "by" "that" "opponent"

/* Player subjects and their continuous rules compose without changing the
   ability holder or the player set. Singular and plural shapes keep agreement. */
/* @sem Ability::Static{kind:Ordinary, affected:Players($players_singular), changes:[PlayerRule($singular_player_continuous_rule)]} */
