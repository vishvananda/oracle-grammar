/* @sem Change::[CreatureTypes{mode:Add, types:Listed($becomes_types)}] */
static_add_creature_type_an ::= "is" "an" becomes_types "in" "addition" "to" "its" "other" "types"

/* The trailing window qualifies the whole ordinary static ability. */
/* @sem Ability::Conditional{condition:$static_suffix_window, then:[Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:$static_changes})]} */
static_window_suffix ::= affected static_changes static_suffix_window "."

static_suffix_window ::= window_extra_turns | window_first_combat_phase | window_main_phase | window_your_turn | window_other_turns

/* The object mentioned in the condition is also the referent of "it's". */
