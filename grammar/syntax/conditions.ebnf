condition ::= condition_one | condition_and | condition_or | condition_or_if

/* @sem Condition::AllOf([$condition_one, $condition_one_2]) */
condition_and ::= condition_one "and" condition_one

/* @sem Condition::AnyOf([$condition_one, $condition_one_2]) */
condition_or ::= condition_one "or" condition_one

condition_one ::= condition_control_distinct_names | condition_die_result_at_most | condition_activation_sacrificed_was | condition_number_bounded | condition_additional_paid | condition_beheld | condition_gift_promised | condition_gift_not_promised | condition_battlefield_none | condition_battlefield_threshold | condition_value_parity | condition_most_votes | condition_most_votes_or_tied | condition_planeswalked_this_turn | condition_battlefield_size | condition_battlefield_other_size | condition_above_starting_life | condition_starting_life_margin | condition_no_hollow_sentinel | condition_shares_card_type | condition_ring_bearer_choice | condition_ring_bearer_choice_other | condition_total_mana_spent | condition_typed_mana_spent | condition_symbol_spent | condition_symbol_pair_spent | condition_it_state | condition_left_battlefield_this_turn | condition_spell_warped_this_turn | condition_not_casters_turn | condition_no_opponent_more_life | condition_attached_named | condition_suspected | condition_not_suspected | condition_kicked_with | condition_kicked_twice | condition_linked_card | condition_it_card | mined_condition | condition_cast_kicked | condition_cast_main_phase | condition_kicked | condition_it_kicked | condition_tribute_unpaid | condition_hand_size | condition_hand_none | condition_control | condition_control_another | condition_attacked_or_blocked_combat | condition_not_your_turn | condition_hand_fewer_than | condition_cast_another_spell | condition_cast_another_typed_spell | condition_control_many | condition_opponents_control_many | condition_control_none | condition_attacked | condition_lost_life | condition_self_is | condition_self_attached | condition_not_type | condition_it_was | condition_died | condition_left_under | condition_entered_under | condition_monarch | condition_cast | condition_graveyard_size | condition_graveyard_filtered_size | condition_graveyard_has | condition_life | condition_any_player_life | condition_opponent_count | condition_gained_life | condition_no_spell | condition_control_both | condition_card_types_graveyard | condition_land_types | condition_poison | condition_commander | condition_lost_amount | condition_no_creatures_died | condition_had_counter | condition_put_counter | condition_all_are | condition_not_their_turn | condition_damage_to_it | condition_that_entered | condition_opponents_control_none | condition_same_color_spent | condition_not_that_players_turn | condition_permanent_cards_graveyard | condition_entered_under_you | condition_defending_no | condition_property_bounded | condition_property_compared | condition_property_equal | condition_object_state | condition_object_color | condition_it_color | condition_escaped | condition_object_has_property | condition_controller_poison | condition_object_is_kind | condition_top_card_kind | condition_object_is_either_kind | condition_mana_values_graveyard | condition_committed_crime | condition_object_has_keyword | condition_object_lacks_keyword | condition_citys_blessing | condition_full_party | condition_counters_at_least | condition_there_are_counters_at_least | condition_has_counter | condition_no_counters | condition_you_cast | condition_you_cast_from_hand | condition_cast_from_graveyard | condition_no_spells_last_turn | condition_player_cast_spells_last_turn | condition_gained_life_this_turn | condition_drawn_at_least | condition_total_power_at_least | condition_searched_this_way | condition_opponent_controls_more | condition_different_powers | condition_equipped | condition_your_turn | condition_completed_dungeon | condition_bargained | condition_opponent_graveyard_at_least | condition_value_compared | condition_object_supertype | condition_entered_this_turn | condition_nth_resolution_this_turn | condition_descended_this_turn | condition_monstrous | condition_enchanted | condition_any_counter | condition_control_not_a | condition_died_under_your_control | condition_died_this_turn_at_least | condition_attacked_total_power | condition_mana_from_spent | condition_cast_spells_this_turn | condition_more_cards_in_hand_than | condition_first_combat_phase | condition_have_initiative | condition_was_cast | condition_evidence_collected | condition_not_starting_player | condition_another_entered_this_turn | condition_permanent_left_this_turn | condition_not_cast_from_hand_this_turn | condition_object_was_predicate | condition_object_was_quality | condition_object_was_nth_cast | condition_it_matches_kind | condition_it_matches_predicate | condition_object_predicate | condition_object_not_predicate | condition_property_parity | condition_most_common_color_tied | condition_most_common_color_chosen_player | condition_control_at_least_other | condition_control_qualified_count | condition_control_shared_group | condition_control_chosen_type_more | condition_cast_instant_sorcery_threshold | condition_entry_and_history | condition_graveyard_count_have | condition_graveyard_count_are | condition_event_group_graveyard_count | condition_controlled_attacking | condition_control_each_color | condition_player_empty_hand | condition_cycled_at_least | condition_owned_graveyard_from_battlefield | condition_existential_hand | condition_no_opponent_history | condition_cast_filtered_threshold | condition_no_controller_history_this_turn | condition_any_graveyard_threshold | condition_object_attack_history | condition_its_night | condition_no_opponent_controls_a | condition_life_events_this_turn | condition_owned_card_arrival | condition_owned_cards_arrival_at_least | condition_object_shares_name | condition_object_lacks_shared_name | condition_library_none | condition_library_you_threshold | condition_library_possessive_threshold | condition_player_life_history | condition_object_was_damage | condition_object_wasnt_damage | condition_named_permanent_present | condition_had_enter_under | condition_self_two_states_counter | condition_opponent_caused_history | condition_not_exerted_this_turn | condition_historical_object | condition_crewed_object | condition_damage_total_history | condition_damage_occurrence_history | condition_damage_excess_history | condition_maximum_life | condition_opponent_entry_plural | condition_opponent_entry_a | condition_opponent_entry_an | condition_defending_player_count | condition_devotion_pair_less | condition_control_unowned_count | condition_discard_history | condition_no_cast_this_turn | condition_history_token_this | condition_history_draw_last | condition_history_draw_this | condition_history_life_last | condition_history_life_total_this | condition_history_graveyard_departure | condition_you_history_this_turn | condition_you_roll_history_this_turn | condition_source_damage_threshold | condition_no_subtype_token | condition_exile_threshold | condition_own_exile_cards | condition_they_own_exile_cards | condition_opponent_cast_filtered_spell | condition_graveyard_cast_or_activation | condition_no_play_from_exile_this_turn | condition_object_wasnt_predicate | condition_opponent_hand_empty | condition_opponent_controls_count | condition_controller_history_this_turn | condition_you_guessed_named_card | condition_you_havent_history | condition_any_counters_at_least | condition_graveyard_position_above | condition_event_subject_attacked_history | condition_player_last_turn_history | condition_you_had_entry_last_turn | condition_object_has_no_named_counters | condition_control_the_extreme | condition_object_past_origin_alternative | condition_object_not_supertype | condition_attacking_threshold | condition_controller_graveyard_at_least | condition_control_counter_an | condition_hand_filtered_threshold | condition_any_player_controls | condition_any_library_size | condition_attacked_with_spacecraft | condition_owned_hand_from_battlefield | condition_exactly_one_attacking | condition_exactly_many_attacking | condition_you_control_object | condition_your_library_empty | condition_control_another_or_an | condition_owned_cards_elsewhere_threshold | condition_all_graveyards_filtered_size | condition_no_activation_this_turn | condition_control_counter_threshold | condition_you_had_entry_this_turn | condition_player_owns_exiled_cards | condition_exact_hand_cards | condition_exact_hand_card | condition_ring_temptations_at_least | condition_existential_discard_history | condition_control_either_named_permanent | condition_graveyard_no_cards | condition_targets_population | condition_as_cast_reveal_or_control | condition_controlled_counter_threshold | condition_control_no_suspected | condition_singular_filtered_card_in_graveyard | condition_opponent_owned_graveyard_arrivals | condition_no_exhaust_activation

/* @sem Condition::PlayerState{player:AbilityController, state:FullParty} */
condition_full_party ::= "you" "have" "a" "full" "party"

/* @sem Condition::PlayerState{player:AbilityController, state:CitysBlessing} */
condition_citys_blessing ::= "you" "have" "the" "city's" "blessing"

/* The predicate keeps its explicitly written object, independently of the
   current event subject or the ability holder. Negation applies to the keyword. */
/* @sem Condition::ObjectMatches{object:@remember_object($object_ref), filter:HasKeyword($keyword_name)} */
condition_object_has_keyword ::= object_ref "has" keyword_name

/* @sem Condition::ObjectMatches{object:@remember_object($object_ref), filter:Not(HasKeyword($keyword_name))} */
condition_object_lacks_keyword ::= object_ref "doesn't" "have" keyword_name

/* @sem Condition::ObjectMatches{object:$object_ref, filter:$filter_phrase} */
condition_object_is_kind ::= object_ref ("is" | "was") ("a" | "an") filter_phrase

/* "If the top card of your library is a land card": what that card is away from the
   battlefield. Its explicit query keeps an unrelated antecedent from crowding
   out the verified spelling with a shorter but unbound pronoun. */
/* @prefer always */
/* @sem Condition::ObjectMatches{object:$ordered_top_card, filter:$card_filter} */
condition_top_card_kind ::= ordered_top_card "is" ("a" | "an") card_filter "card"

/* The predicate describes the linked card, separately from the holder's noun. */
/* @sem Condition::ObjectMatches{object:Earlier{what:LastExiled}, filter:CardType(Creature)} */
condition_linked_card ::= "a" "card" "exiled" "with" self_holder_text "is" "a" "creature" "card"

/* Alternatives test the same explicitly stated subject. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:AnyOf([$filter_phrase, $filter_phrase_2])} */
condition_object_is_either_kind ::= object_ref ("is" | "was") ("a" | "an") filter_phrase "or" ("a" | "an") filter_phrase

/* @sem Condition::ObjectMatches{object:$object_ref, filter:ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:$bound, value:$number}}} */
condition_object_has_property ::= object_ref "has" stat number "or" bound

/* A known object's controller is one player, without an existential binding. */
/* @sem Condition::Compare{left:Expr::CountCounters{recipients:Players(One($its_controller)), kind:Named(PoisonCounter), information:CurrentOrLastKnown}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}} */
condition_controller_poison ::= its_controller "has" count "or" "more" "poison" "counters"

/* A possessive supplies an object, independent of the property and comparison.
   Card names retain the creator; `this creature's` retains the ability holder. */
condition_property_subject ::= condition_property_it | condition_property_named | self_possessive

/* @prefer value(EventSubject) */
/* @sem ObjectRef::@it */
condition_property_it ::= "its"

/* @sem $it_possessive */
condition_property_named ::= it_possessive

/* @sem Condition::ObjectMatches{object:$condition_property_subject, filter:ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:$bound, value:$number}}} */
condition_property_bounded ::= condition_property_subject stat "is" number "or" bound

/* @sem Condition::ObjectMatches{object:$condition_property_subject, filter:ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:$stat_comparison, value:Expr::@in_filter($value)}}} */
condition_property_compared ::= condition_property_subject stat "is" stat_comparison value

/* @sem Condition::ObjectMatches{object:$condition_property_subject, filter:ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:Equal, value:$number}}} */
condition_property_equal ::= condition_property_subject stat "is" number

/* @sem Condition::ObjectMatches{object:$object_ref, filter:$condition_color} */
condition_object_color ::= object_ref "is" condition_color

/* @sem Condition::ObjectMatches{object:@it, filter:$condition_color} */
condition_it_color ::= "it's" condition_color

condition_color ::= adjective_color | adjective_colorless

/* A contracted subject keeps the object `it` names: `if it's renowned`. */
/* @sem Condition::ObjectMatches{object:@it, filter:$it_state} */
condition_it_state ::= "it's" it_state
it_state ::= adjective_enchanted | adjective_equipped | state_renowned | state_bargained
/* @sem ObjectFilter::State(Renowned) */
state_renowned ::= "renowned"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:State(Escaped)} */
condition_escaped ::= object_ref "escaped"

/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Hand, players:One($condition_player)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:$bound_words, value:$count}} */
condition_hand_size ::= condition_player ("has" | "have") count bound_words "cards" "in" "hand"
/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Less, value:$count}} */
condition_hand_fewer_than ::= "you" "have" "fewer" "than" count "cards" "in" "hand"
/* Another spell this turn: any spell you cast this turn other than this one. */
/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:Not(SameObject(Source))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_cast_another_spell ::= "you've" "cast" "another" "spell" "this" "turn"
/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:AllOf([Not(SameObject(Source)), $spell_adjectives])}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_cast_another_typed_spell ::= "you've" "cast" "another" spell_adjectives "spell" "this" "turn"

/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Hand, players:One($condition_player)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Equal, value:Expr::Constant(0)}} */
condition_hand_none ::= condition_player ("has" | "have") "no" "cards" "in" "hand"

condition_player ::= condition_you | condition_that_player

/* @sem PlayerRef::AbilityController */
condition_you ::= "you"

/* @sem @that_player */
condition_that_player ::= "that" "player"

bound_words ::= bound_or_more | bound_or_fewer

/* @sem Comparison::GreaterOrEqual */
bound_or_more ::= "or" "more"

/* @sem Comparison::LessOrEqual */
bound_or_fewer ::= "or" ("fewer" | "less")

/* The subject includes verb agreement; its reference is resolved in the enclosing
   event/target scope. Keep object exclusion separate from the controlling player. */
condition_control_subject ::= condition_control_you | condition_control_other | condition_control_they

/* @sem PlayerRef::AbilityController */
condition_control_you ::= "you" "control"

/* @sem $that_player */
condition_control_other ::= that_player "controls"

/* @sem PlayerRef::@that_player */
condition_control_they ::= "they" "control"

/* @sem Condition::Controls{player:$condition_control_subject, filter:$filter_phrase, minimum:1} */
condition_control ::= condition_control_subject ("a" | "an") filter_phrase

/* @sem Condition::Controls{player:$condition_control_subject, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $filter_phrase), minimum:1} */
condition_control_another ::= condition_control_subject "another" filter_phrase

/* @sem Condition::AllOf([Controls{player:$condition_control_subject, filter:$filter_phrase, minimum:1}, Controls{player:$condition_control_subject, filter:$filter_phrase_2, minimum:1}]) */
condition_control_both ::= condition_control_subject ("a" | "an") filter_phrase "and" ("a" | "an") filter_phrase

/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One($condition_control_subject)))}), test:NumberTest::Compare{comparison:$bound_words, value:$count}} */
condition_control_many ::= condition_control_subject count bound_words filter_plural
/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(OpponentsOf(AbilityController)))}), test:NumberTest::Compare{comparison:$bound_words, value:$count}} */
condition_opponents_control_many ::= "your" "opponents" "control" count bound_words filter_plural

/* @sem Condition::Not(Condition::Controls{player:$condition_control_subject, filter:$filter_plural, minimum:1}) */
condition_control_none ::= condition_control_subject "no" filter_plural

/* @sem Condition::Compare{left:EventHistory{event:Player{event:Attacks, players:One(PlayerRef::AbilityController)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_attacked ::= "you" "attacked" ("with" "creatures")? "this" "turn"

/* @sem Condition::ExistsPlayer{players:$event_player, binding:0, condition:Compare{left:EventHistory{event:Player{event:LosesLife, players:One(PlayerRef::Bound(0))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}} */
condition_lost_life ::= event_player "lost" "life" "this" "turn"

/* @sem Condition::ObjectMatches{object:ObjectRef::Source, filter:$condition_state} */
condition_self_is ::= self_text "is" condition_state

/* @sem Condition::ObjectMatches{object:ObjectRef::Source, filter:$modifier_attached_to_a} */
condition_self_attached ::= self_text "is" modifier_attached_to_a

/* @sem Condition::ObjectMatches{object:$object_ref, filter:Not($filter_phrase)} */
condition_not_type ::= object_ref "isn't" ("a" | "an") filter_phrase

condition_state ::= adjective_tapped | adjective_untapped | adjective_attacking | adjective_blocking

/* @sem Condition::ObjectMatches{object:@it, filter:ObjectFilter::Not($condition_state)} */
condition_it_was ::= "it" "wasn't" condition_state

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:$filter_phrase, from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_died ::= ("a" | "an") filter_phrase "died" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:Object{event:LeavesBattlefield, objects:@and($filter_phrase, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController)))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_left_under ::= ("a" | "an") filter_phrase "left" "the" "battlefield" "under" "your" "control" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:@and($filter_phrase, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController))), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_entered_under ::= ("a" | "an") filter_phrase "entered" "the" "battlefield" "under" "your" "control" "this" "turn"

/* @sem Condition::PlayerState{player:AbilityController, state:Monarch} */
condition_monarch ::= "you're" "the" "monarch"

/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(PlayerRef::AbilityController), spells:$spell_filter}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_cast ::= "you've" "cast" spell_filter "this" "turn"

/* "If there are seven or more lands on the battlefield": the permanents counted where
   they are. */
/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counted_plural}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_battlefield_size ::= "there" "are" value "or" "more" counted_plural "on" "the" "battlefield"

/* The same current population, with its quantity before the noun phrase. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counted_plural}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_battlefield_threshold ::= value "or" "more" counted_plural "are" "on" "the" "battlefield"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counted_plural}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_battlefield_none ::= "no" counted_plural "are" "on" "the" "battlefield" | "there" "are" "no" counted_plural "on" "the" "battlefield"

/* "If there are five or more other creatures on the battlefield": all of them but the
   one the ability is about, the entering creature or this one. */
/* @sem Condition::Compare{left:Expr::CountObjects(Difference{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counted_plural}, excluding:One(@pump_other_ref(ObjectRef::@it))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_battlefield_other_size ::= "there" "are" value "or" "more" "other" counted_plural "on" "the" "battlefield"

/* A counted population; "other" belongs to the count's exclusion, not the filter. */
counted_plural ::= filter_plural_type_prefix | filter_plural_tail | filter_plural_adjectives | filter_plural_comma | mined_plural

/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}} */
condition_graveyard_size ::= "there" "are" count "or" "more" "cards" "in" "your" "graveyard"

/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:$card_filter}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}} */
condition_graveyard_filtered_size ::= "there" "are" count "or" "more" card_filter "cards" "in" "your" "graveyard"

/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:$card_filter}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_graveyard_has ::= ("there's" | "there" "is") ("a" | "an") card_filter "card" "in" "your" "graveyard"

/* @sem Condition::Compare{left:Expr::PlayerNumber{player:$condition_player, number:Life}, test:NumberTest::Compare{comparison:$bound_words, value:$number}} */
condition_life ::= condition_player ("has" | "have") number bound_words "life"
/* Some player's life total is within the bound. */
/* @sem Condition::ExistsPlayer{players:All, binding:0, condition:Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:$bound_words, value:$number}}} */
condition_any_player_life ::= "a" "player" "has" number bound_words "life"
/* @sem Condition::Compare{left:CountPlayers(OpponentsOf(AbilityController)), test:NumberTest::Compare{comparison:$bound_words, value:$count}} */
condition_opponent_count ::= "you" "have" count bound_words "opponents"

/* @sem Condition::Compare{left:EventHistory{event:Player{event:GainsLife, players:One(PlayerRef::AbilityController)}, window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
condition_gained_life ::= "you" "gained" number "or" "more" "life" "this" "turn"

/* @sem Condition::Not(Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(@that_player), spells:Any}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}) */
condition_no_spell ::= "that" "player" "didn't" "cast" "a" "spell" "this" "turn"

/* @sem Condition::Compare{left:Expr::CountDistinct{objects:Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, property:CardTypes}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}} */
condition_card_types_graveyard ::= "there" "are" count "or" "more" "card" "types" "among" "cards" "in" "your" "graveyard"

/* @sem Condition::Compare{left:Expr::CountDistinct{objects:Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, property:ManaValues}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}} */
condition_mana_values_graveyard ::= "there" "are" count "or" "more" "mana" "values" "among" "cards" "in" "your" "graveyard"

/* @sem Condition::PlayerState{player:AbilityController, state:CommittedCrime} */
condition_committed_crime ::= ("you've" | "you" "have") "committed" "a" "crime" "this" "turn"

/* @sem Condition::Compare{left:Expr::CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, property:BasicLandTypes}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}} */
condition_land_types ::= "there" "are" count "or" "more" "basic" "land" "types" "among" filter_plural

/* @sem Condition::ExistsPlayer{players:$event_player, binding:0, condition:Compare{left:Expr::CountCounters{recipients:Players(One(PlayerRef::Bound(0))), kind:Named(PoisonCounter), information:CurrentOrLastKnown}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}}} */
condition_poison ::= event_player "has" count "or" "more" "poison" "counters"

/* @sem Condition::Controls{player:AbilityController, filter:AllOf([State(Commander), OwnedBy(One(PlayerRef::AbilityController))]), minimum:1} */
condition_commander ::= "you" "control" "your" "commander"

/* @sem Condition::ExistsPlayer{players:$event_player, binding:0, condition:Compare{left:EventHistory{event:Player{event:LosesLife, players:One(PlayerRef::Bound(0))}, window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}} */
condition_lost_amount ::= event_player "lost" number "or" "more" "life" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:$filter_plural, from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:Equal, value:Expr::Constant(0)}} */
condition_no_creatures_died ::= "no" filter_plural "died" "this" "turn"

/* @sem Condition::ObjectMatches{object:@it, filter:ObjectFilter::Counters{kind:PowerToughness(1, 1), comparison:Greater, value:Expr::Constant(0)}} */
condition_had_counter ::= "it" "had" "a" "+" "1" "/" "+" "1" "counter" "on" "it"

/* @sem Condition::Compare{left:EventHistory{event:Batch{event:Counters{change:Put, objects:$filter_phrase, by:One(PlayerRef::AbilityController)}, per:Subject}, window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_put_counter ::= "you" "put" "a" "counter" "on" ("a" | "an") filter_phrase "this" "turn"

/* @sem Condition::Compare{left:Expr::CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, filter:ObjectFilter::Not($adjective_color)}), test:NumberTest::Compare{comparison:Equal, value:Expr::Constant(0)}} */
condition_all_are ::= "all" filter_plural "are" adjective_color

/* @sem Condition::Not(Condition::PlayerIsActive(@that_player)) */
condition_not_their_turn ::= "it's" "not" "their" "turn"

/* @sem Condition::ObjectMatches{object:@it, filter:ObjectFilter::Condition(Compare{left:EventHistory{event:Damage(DamageEvent{source_kind:Any, sources:Any, recipients:Objects(SameObject(ObjectRef::Candidate)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}})} */
condition_damage_to_it ::= number "or" "more" "damage" "was" "dealt" "to" "it" "this" "turn"

/* @sem Condition::ObjectMatches{object:@that_object, filter:ObjectFilter::Condition(Compare{left:EventHistory{event:ZoneChange{objects:SameObject(ObjectRef::Candidate), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}})} */
condition_that_entered ::= that_noun_word "entered" "this" "turn"

/* @sem Condition::Compare{left:Expr::CountPlayers(Intersection([OpponentsOf(PlayerRef::AbilityController), Matching{binding:0, condition:Not(Condition::Controls{player:Bound(0), filter:$filter_plural, minimum:1})}])), test:NumberTest::Compare{comparison:Equal, value:Expr::CountPlayers(OpponentsOf(PlayerRef::AbilityController))}} */
condition_opponents_control_none ::= "your" "opponents" "control" "no" filter_plural

/* @sem Condition::Not(Condition::Controls{player:$defending_player, filter:$filter_plural, minimum:1}) */
condition_defending_no ::= defending_player "controls" "no" filter_plural

/* @sem Condition::ExistsPlayer{players:OthersThan(@that_player), binding:0, condition:PlayerIsActive(Bound(0))} */
condition_not_that_players_turn ::= "it's" "not" "that" "player's" "turn"

/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
condition_permanent_cards_graveyard ::= "there" "are" number "or" "more" "permanent" "cards" "in" "your" "graveyard"

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:@and($filter_plural, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController))), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
condition_entered_under_you ::= number "or" "more" filter_plural "entered" "the" "battlefield" "under" "your" "control" "this" "turn"

/* @sem Condition::Compare{left:Expr::ManaSpent{object:EventSubject, filter:SpentManaFilter{}, aggregation:MaximumPerColor}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
condition_same_color_spent ::= "at" "least" number "mana" "of" "the" "same" "color" "was" "spent" "to" "cast" "it"

/* When an activated ability may be activated. */
activation_window ::= window_your_turn | window_before_attackers | window_your_upkeep | window_any_upkeep_step | window_during | window_if | window_life_margin | window_attacked_declare_attackers

/* A life margin names the starting life total before the margin it adds. */
/* @sem Condition::Compare{left:PlayerNumber{player:AbilityController, number:Life}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Add([StartingLife(AbilityController), $value])}} */
window_life_margin ::= "if" "you" "have" "at" "least" value "life" "more" "than" "your" "starting" "life" "total"

/* @sem Condition::PlayerIsActive(AbilityController) */
window_your_turn ::= "during" "your" "turn"

/* An activation window is spelled as a casting window is; "during your turn" has
   its own spelling above. */
/* @sem $activation_cast_window */
window_during ::= "during" activation_cast_window
activation_cast_window ::= activation_window_end_of_combat | cast_window_combat | cast_window_declare_blockers | cast_window_declare_attackers | cast_window_combat_after | cast_window_combat_before | cast_window_combat_opponent | cast_window_combat_yours | cast_window_combat_yours_before | cast_window_blockers_opponent | cast_window_your_attackers | cast_window_your_end_step | cast_window_opponent_turn | cast_window_opponent_upkeep | cast_window_opponent_after_upkeep | cast_window_opponent_before_attackers

/* @sem Condition::AllOf([Condition::PlayerIsActive(AbilityController), Condition::Window(BeforeAttackersDeclared)]) */
window_before_attackers ::= "during" "your" "turn" "," "before" "attackers" "are" "declared"

/* @sem Condition::PlayerState{player:AbilityController, state:InTheirUpkeep} */
window_your_upkeep ::= "during" "your" "upkeep"

/* @sem $condition */
window_if ::= "if" condition

/* @prefer value(ObjectMatches) */
/* @sem Condition::ObjectMatches{object:$self_ref, filter:State(Kicked)} */
condition_kicked ::= self_ref "was" "kicked"

/* Keep the casting-state noun available before the ordinary self-name beam
   ranks the other holder nouns. Keys still recover all the general forms. */
/* @prefer type(Instant) */
/* @prefer type(Sorcery) */
/* @sem Condition::ObjectMatches{object:@self, filter:State(Kicked)} */
condition_cast_kicked ::= "this" "spell" "was" "kicked"

/* The spell's own optional additional cost; a cost branch answers it. */
/* @sem Condition::ObjectMatches{object:@self, filter:State(CostPaid(Additional))} */
condition_additional_paid ::= "this" "spell's" "additional" "cost" "was" "paid"
/* "If a Dragon was beheld": the spell's optional cost was to behold one, and a cost
   branch checks that the cost names the same kind. */
/* @sem Condition::@beheld($behold_kind) */
condition_beheld ::= ("a" | "an") behold_kind "was" "beheld"

/* @prefer type(Instant) */
/* @prefer type(Sorcery) */
/* Naming the spell doesn't make it the focus of a following "other target". */
/* @sem Condition::ObjectMatches{object:Source, filter:State(CastDuringOwnMainPhase)} */
condition_cast_main_phase ::= "you" "cast" "this" "spell" "during" "your" "main" "phase"

/* @prefer value(ObjectMatches) */
/* @sem Condition::ObjectMatches{object:@it, filter:State(Kicked)} */
condition_it_kicked ::= "it" "was" "kicked"
/* Tribute asks about the creature as it entered (CR 702.104). */
/* @sem Condition::ObjectMatches{object:EventSubject, filter:State(TributeNotPaid)} */
condition_tribute_unpaid ::= "tribute" "wasn't" "paid"

condition_it_card ::= condition_card_single | condition_card_either

/* @sem Condition::ObjectMatches{object:@current_it, filter:$card_filter} */
condition_card_single ::= "it's" ("a" | "an") card_filter "card"

/* A card's current characteristics may differ from its departed permanent. */
/* @sem Condition::ObjectMatches{object:@current_it, filter:AnyOf([$card_filter, $card_filter_2])} */
condition_card_either ::= "it's" ("a" | "an") card_filter "or" (("a" | "an"))? card_filter "card"

/* A paid named kicker remains distinct from being kicked at all or twice. */
/* @sem Condition::ObjectMatches{object:$kicked_subject, filter:$kicker_test_with} */
condition_kicked_with ::= kicked_subject "was" kicker_test_with
/* @sem Condition::ObjectMatches{object:$kicked_subject, filter:$kicker_test_twice} */
condition_kicked_twice ::= kicked_subject "was" kicker_test_twice
kicked_subject ::= self_ref | cast_it | cast_this_spell
/* The spell being cast or just cast. */
/* @sem @it */
cast_it ::= "it"
/* @sem @self */
cast_this_spell ::= "this" "spell"

/* Both explicit and contracted subjects retain the object they actually name. */
/* @sem Condition::ObjectMatches{object:$suspected_condition_subject, filter:State(Suspected)} */
condition_suspected ::= suspected_condition_subject "suspected"
/* @sem Condition::ObjectMatches{object:$suspected_condition_subject, filter:Not(State(Suspected))} */
condition_not_suspected ::= suspected_condition_subject "not" "suspected"
suspected_condition_subject ::= suspected_named_condition_subject | suspected_it_condition_subject
/* @sem $object_ref */
suspected_named_condition_subject ::= object_ref "is"
/* @sem ObjectRef::@it */
suspected_it_condition_subject ::= "it's"

/* Existential attachment is independent of the static ability's beneficiary. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Subtype(Equipment), ObjectFilter::Name($referenced_card_name))}, filter:AttachedTo(InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_attached_named ::= ("a" | "an") "Equipment" "named" referenced_card_name "is" "attached" "to" ("a" | "an") filter_phrase

/* @sem Condition::Compare{left:CountPlayers(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:Greater, value:PlayerNumber{player:$life_comparison_player, number:Life}}}}])), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_no_opponent_more_life ::= "no" "opponent" "has" "more" "life" "than" life_comparison_player

life_comparison_player ::= player_ref | life_comparison_you
/* @sem PlayerRef::AbilityController */
life_comparison_you ::= "you"


/* Something of a kind left the battlefield this turn, however it left. */
/* @sem Condition::Compare{left:EventHistory{event:Object{event:LeavesBattlefield, objects:$filter_phrase}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_left_battlefield_this_turn ::= ("a" | "an") filter_phrase "left" "the" "battlefield" "this" "turn"

/* Any player cast a spell for its warp cost this turn. */
/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:All, spells:State(Warped)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_spell_warped_this_turn ::= "a" "spell" "was" "warped" "this" "turn"

/* @sem Condition::Not(PlayerIsActive(@that_player)) */
condition_not_casters_turn ::= "it" "isn't" "that" "player's" "turn"

/* Mana paid to cast a spell, of any type or of one: `at least four mana was spent to cast
   it`, `five or more mana was spent to cast that spell`, `at least three black mana was
   spent to cast this spell`. This is total paid mana, not mana value or a color maximum.
   A written noun requires an already introduced spell, even after an action on the
   source creature. Ordinary If/intervening-if owners retain their own placement. */
/* @sem Condition::Compare{left:Expr::ManaSpent{object:$spent_spell, filter:SpentManaFilter{}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$spent_least}} */
condition_total_mana_spent ::= spent_least "mana" "was" "spent" "to" "cast" spent_spell
/* @sem Condition::Compare{left:Expr::ManaSpent{object:$spent_spell, filter:SpentManaFilter{colors:[$spent_type]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$spent_least}} */
condition_typed_mana_spent ::= spent_least spent_type "mana" "was" "spent" "to" "cast" spent_spell
/* One mana symbol of a color: `{G} was spent to cast this spell`. */
/* @sem Condition::Compare{left:Expr::ManaSpent{object:$spent_spell, filter:SpentManaFilter{colors:[$mana_letter]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_symbol_spent ::= "{" mana_letter "}" "was" "spent" "to" "cast" spent_spell
/* Two symbols of one color: `{W}{W} was spent to cast this spell`. */
/* @sem Condition::Compare{left:Expr::ManaSpent{object:$spent_spell, filter:SpentManaFilter{colors:[$spent_symbol_pair]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(2)}} */
condition_symbol_pair_spent ::= spent_symbol_pair "was" "spent" "to" "cast" spent_spell
spent_symbol_pair ::= spent_pair_white | spent_pair_blue | spent_pair_black | spent_pair_red | spent_pair_green
/* @sem ManaColor::White */
spent_pair_white ::= "{" "W" "}" "{" "W" "}"
/* @sem ManaColor::Blue */
spent_pair_blue ::= "{" "U" "}" "{" "U" "}"
/* @sem ManaColor::Black */
spent_pair_black ::= "{" "B" "}" "{" "B" "}"
/* @sem ManaColor::Red */
spent_pair_red ::= "{" "R" "}" "{" "R" "}"
/* @sem ManaColor::Green */
spent_pair_green ::= "{" "G" "}" "{" "G" "}"

spent_least ::= spent_at_least | spent_or_more
/* @sem $number */
spent_at_least ::= "at" "least" number
/* @sem $number */
spent_or_more ::= number "or" "more"
spent_type ::= mana_color_word | spent_colorless
/* @sem ManaColor::Colorless */
spent_colorless ::= "colorless"
spent_spell ::= cast_it | cast_this_spell | named_spell

/* The player is a lexical antecedent, not necessarily a chosen opponent. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(PlayerRef::@that_player_literal)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})}} */
condition_that_player_more_cards ::= "that" "player" "has" "more" "cards" "in" "hand" "than" "you"

/* This fixed referent is used only in a span that explicitly chooses an opponent. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(Chosen)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})}} */
condition_chosen_player_more_cards ::= "that" "player" "has" "more" "cards" "in" "hand" "than" "you"

/* This is the creature chosen during the Ring event, not a current bearer query. */
/* @sem Condition::RingBearerChosen($filter_phrase) */
condition_ring_bearer_choice ::= "you" "chose" ("a" | "an") filter_phrase "as" "your" "Ring-bearer"
/* @sem Condition::RingBearerChosen(@and(ObjectFilter::Not(SameObject($object_ref)), $filter_phrase)) */
condition_ring_bearer_choice_other ::= "you" "chose" ("a" | "an") filter_phrase "other" "than" object_ref "as" "your" "Ring-bearer"

/* Both objects are explicit: the event object can be compared with a card
   linked to the holder without changing that event's actor. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Shares{property:CardTypes, with:$object_ref_2}} */
condition_shares_card_type ::= object_ref "shares" "a" "card" "type" "with" object_ref

/* A named-token existence check concerns controlled creatures with that name,
   not the identity or characteristics of a target in another mode. */
/* @prefer always */
/* @sem Condition::Not(Controls{player:AbilityController, filter:AllOf([CardType(Creature), Name('The Hollow Sentinel')]), minimum:1}) */
condition_no_hollow_sentinel ::= "you" "don't" "control" "a" "creature" "named" "The" "Hollow" "Sentinel"

/* @sem Condition::Compare{left:PlayerNumber{player:AbilityController, number:Life}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Add([StartingLife(AbilityController), $value])}} */
condition_starting_life_margin ::= "your" "life" "total" "is" "at" "least" value "greater" "than" "your" "starting" "life" "total"

/* @sem Condition::Compare{left:PlayerNumber{player:AbilityController, number:Life}, test:NumberTest::Compare{comparison:Greater, value:StartingLife(AbilityController)}} */
condition_above_starting_life ::= "your" "life" "total" "is" "greater" "than" "your" "starting" "life" "total"

/* At least a number of counters of a kind on an object. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$value})} */
condition_counters_at_least ::= object_ref "has" value "or" "more" counter_kind "counters" "on" "it"

/* At least a number of counters of a kind, phrased as existence. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$value})} */
condition_there_are_counters_at_least ::= "there" "are" value "or" "more" counter_kind "counters" "on" object_ref

/* Any counter of a kind on an object, now or as it last existed. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})} */
condition_has_counter ::= object_ref ("has" | "had") "a" counter_kind "counter" "on" "it"

/* No counters of a kind on an object. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Counters(_{kind:$counter_kind, comparison:Equal, value:Constant(0)})} */
condition_no_counters ::= "there" "are" "no" counter_kind "counters" "on" object_ref

/* You cast the object. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Cast{by:One(AbilityController)}} */
condition_you_cast ::= "you" "cast" object_ref

/* You cast the object from your hand. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Cast{by:One(AbilityController), from:Players{zone:Hand, players:One(AbilityController)}}} */
condition_you_cast_from_hand ::= "you" "cast" object_ref "from" "your" "hand"

/* The object was cast from any graveyard. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Cast{from:Players{zone:Graveyard, players:All}}} */
condition_cast_from_graveyard ::= object_ref "was" "cast" "from" "a" "graveyard"

/* No player cast a spell last turn. */
/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:All, spells:Any}, window:LastTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_no_spells_last_turn ::= "no" "spells" "were" "cast" "last" "turn"

/* Some player cast at least a number of spells last turn. */
/* @sem Condition::ExistsPlayer{players:All, binding:0, condition:Compare{left:EventHistory{event:Spell{event:Cast, players:One(Bound(0)), spells:Any}, window:LastTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}} */
condition_player_cast_spells_last_turn ::= "a" "player" "cast" value "or" "more" "spells" "last" "turn"

/* You gained life this turn. */
/* @sem Condition::Compare{left:EventHistory{event:Player{event:GainsLife, players:One(AbilityController)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_gained_life_this_turn ::= "you" "gained" "life" "this" "turn"

/* You drew at least a number of cards this turn. */
/* @sem Condition::Compare{left:EventHistory{event:Player{event:Draws, players:One(AbilityController)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_drawn_at_least ::= "you've" "drawn" value "or" "more" "cards" "this" "turn"

/* A group whose total power reaches a number. */
/* @sem Condition::Compare{left:Aggregate{objects:$affected, property:Power, aggregation:Sum}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_total_power_at_least ::= affected "have" "total" "power" value "or" "greater"

/* The preceding search happened. */
/* @sem Condition::Searched(0) */
condition_searched_this_way ::= "you" "search" "your" "library" "this" "way"

/* An opponent controls more of a kind than you. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}), test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])})}}} */
condition_opponent_controls_more ::= "an" "opponent" "controls" "more" filter_plural "than" "you"

/* You control a number of creatures with different powers. */
/* @sem Condition::Compare{left:CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}, property:Powers}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_different_powers ::= "you" "control" value "or" "more" filter_plural "with" "different" "powers"

/* The object is equipped. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:State(Equipped)} */
condition_equipped ::= object_ref "is" "equipped"

/* It is your turn. */
/* @sem Condition::PlayerIsActive(AbilityController) */
condition_your_turn ::= "it's" "your" "turn"
/* It is another player's turn. */
/* @sem Condition::ExistsPlayer{players:OthersThan(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))} */
condition_not_your_turn ::= "it's" "not" "your" "turn"

/* You completed a dungeon. */
/* @sem Condition::PlayerState{player:AbilityController, state:CompletedDungeon} */
condition_completed_dungeon ::= "you've" "completed" "a" "dungeon"

/* The spell was bargained. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:State(Bargained)} */
condition_bargained ::= object_ref "was" "bargained"

/* Some opponent has at least a number of cards in their graveyard. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:CountObjects(Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any})), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}} */
condition_opponent_graveyard_at_least ::= "an" "opponent" "has" value "or" "more" "cards" "in" "their" "graveyard"

/* Scalar conditions use the same comparison vocabulary as object statistics. */
/* Direct object properties retain the existing ObjectMatches predicate;
   this production owns computed numeric subjects and captured X values. */
/* @sem Condition::@computed_condition(Condition::Compare{left:$value, test:NumberTest::Compare{comparison:$stat_comparison, value:$value_2}}) */
condition_value_compared ::= value "is" stat_comparison value

/* @sem Condition::@computed_condition(Condition::Compare{left:$value, test:$number_parity}) */
condition_value_parity ::= value "is" number_parity

number_parity ::= number_even | number_odd
/* @sem NumberTest::Compare{comparison:SameParity, value:Constant(0)} */
number_even ::= "even"
/* @sem NumberTest::Compare{comparison:SameParity, value:Constant(1)} */
number_odd ::= "odd"

/* The object entered this turn. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Condition(Compare{left:EventHistory{event:ZoneChange{objects:SameObject(Candidate), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})} */
condition_entered_this_turn ::= object_ref "entered" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:Player{event:Planeswalks, players:One(PlayerRef::AbilityController), objects:SameObject($self_explicit_ref)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_planeswalked_this_turn ::= "you" "planeswalked" "to" self_explicit_ref "this" "turn"

/* Bare supertype adjectives are predicates on the named object. */
/* @prefer value(ObjectMatches) */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$condition_supertype} */
condition_object_supertype ::= object_ref "is" condition_supertype
condition_supertype ::= adjective_legendary | adjective_basic | adjective_nonbasic | adjective_snow | adjective_nonsnow

/* @sem Condition::GiftPromised(true) */
condition_gift_promised ::= "the" "gift" "was" "promised"
/* @sem Condition::GiftPromised(false) */
condition_gift_not_promised ::= "the" "gift" "wasn't" "promised"

/* Numeric thresholds preserve both written operands. A spell-own X is the
   same announced value as its other amounts; independent frames stay distinct. */
/* @sem Condition::@number_condition(Condition::Compare{left:$number, test:NumberTest::Compare{comparison:$bound_words, value:$number_2}}) */
condition_number_bounded ::= number "is" number bound_words

/* Conditions taken over from seeded rules, in their original Oracle words. */
/* How many times this ability has resolved this turn, counting this time. */
/* @sem Condition::Compare{left:TimesResolvedThisTurn, test:NumberTest::Compare{comparison:Equal, value:$resolution_ordinal}} */
condition_nth_resolution_this_turn ::= "this" "is" "the" resolution_ordinal "time" "this" "ability" "has" "resolved" "this" "turn"
resolution_ordinal ::= resolution_first | ordinal | resolution_fourth
/* @sem Expr::Constant(1) */
resolution_first ::= "first"
/* @sem Expr::Constant(4) */
resolution_fourth ::= "fourth"

/* @sem Condition::PlayerState{player:AbilityController, state:Descended} */
condition_descended_this_turn ::= "you" "descended" "this" "turn"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:State(Monstrous)} */
condition_monstrous ::= object_ref "is" "monstrous"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:State(Enchanted)} */
condition_enchanted ::= object_ref "is" "enchanted"

/* Any counter on an object, now or as it last existed. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Counters(_{comparison:Greater, value:Constant(0)})} */
condition_any_counter ::= object_ref ("has" | "had") ("a" "counter" | "counters" | "one" "or" "more" "counters") "on" "it"

/* @sem Condition::Not(Controls{player:AbilityController, filter:$filter_phrase, minimum:1}) */
condition_control_not_a ::= "you" "don't" "control" "a" filter_phrase

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:AllOf([$filter_phrase, ControlledBy(One(AbilityController))]), from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}} */
condition_died_under_your_control ::= counter_amount filter_phrase "died" "under" "your" "control" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:$filter_plural, from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_died_this_turn_at_least ::= value "or" "more" filter_plural "died" "this" "turn"

/* @sem Condition::PlayerDid{player:AbilityController, event:AttackedWithTotalPower([GreaterOrEqual, $value]), window:ThisCombat} */
condition_attacked_total_power ::= "you" "attacked" "with" "creatures" "with" "total" "power" value "or" "greater" "this" "combat"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:ManaSpentFrom($filter_phrase)} */
condition_mana_from_spent ::= "mana" "from" "a" filter_phrase "was" "spent" "to" "cast" object_ref

/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:Any}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_cast_spells_this_turn ::= "you've" "cast" value "or" "more" "spells" "this" "turn"

/* @sem Condition::Compare{left:PlayerNumber{player:AbilityController, number:CardsInHand}, test:NumberTest::Compare{comparison:Greater, value:AmongPlayers{players:$players_singular, number:CardsInHand, aggregation:Maximum}}} */
condition_more_cards_in_hand_than ::= "you" "have" "more" "cards" "in" "hand" "than" players_singular

/* @sem Condition::Window(FirstCombat) */
condition_first_combat_phase ::= "it's" "the" "first" "combat" "phase" "of" "the" "turn"

/* @sem Condition::PlayerState{player:AbilityController, state:Initiative} */
condition_have_initiative ::= "you" "have" "the" "initiative"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:Cast{}} */
condition_was_cast ::= object_ref "was" "cast"

/* @sem Condition::Compare{left:Earlier{what:Evidence, measure:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_evidence_collected ::= "evidence" "was" "collected"

/* @sem Condition::Not(PlayerState{player:AbilityController, state:StartingPlayer}) */
condition_not_starting_player ::= "you" "weren't" "the" "starting" "player"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:AnyOf([Condition(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisCombat, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}), Condition(Compare{left:EventHistory{event:Object{event:Blocks, objects:SameObject(Candidate)}, window:ThisCombat, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})])} */
condition_attacked_or_blocked_combat ::= object_ref "attacked" "or" "blocked" "this" "combat"

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:AllOf([Not(SameObject(Source)), $filter_phrase, ControlledBy(One(AbilityController))]), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_another_entered_this_turn ::= "another" filter_phrase "entered" "the" "battlefield" "under" "your" "control" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:Object{event:LeavesBattlefield, objects:ControlledBy(One(AbilityController))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}} */
condition_permanent_left_this_turn ::= counter_amount "permanent" "you" "controlled" "left" "the" "battlefield" "this" "turn"

/* @sem Condition::Not(Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:Cast{from:Players{zone:Hand, players:One(CasterOf(Candidate))}}}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}}) */
condition_not_cast_from_hand_this_turn ::= "you" "haven't" "cast" counter_amount "spell" "from" "your" "hand" "this" "turn"

/* "If the result is 3 or less": the die rolled just before. */
/* @sem Condition::Compare{left:DieResult(@die_roll), test:NumberTest::Compare{comparison:LessOrEqual, value:$number}} */
condition_die_result_at_most ::= "the" "result" "is" number "or" "less"

/* "If the sacrificed creature was a Human": the object sacrificed to activate this
   ability, as it was when paid. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:CostObjects{payment:Activation, component:[@cost_index], view:Performed, phase:Before}, filter:$sacrificed_quality}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
condition_activation_sacrificed_was ::= "the" "sacrificed" "creature" "was" sacrificed_quality
sacrificed_quality ::= sacrificed_quality_subtype | sacrificed_quality_adjective
/* @sem $subtype */
sacrificed_quality_subtype ::= ("a" | "an") subtype
/* @sem $adjectives */
sacrificed_quality_adjective ::= adjectives

/* Count names across the controlled population, rather than imposing a per-object test. */
/* @sem Condition::Compare{left:Expr::CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One($condition_control_subject)))}, property:Names}, test:NumberTest::Compare{comparison:$bound_words, value:$count}} */
condition_control_distinct_names ::= condition_control_subject count bound_words filter_plural "with" "different" "names"

/* An explicitly named object and its current state are independent operands. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$condition_object_state_filter} */
condition_object_state ::= object_ref "is" condition_object_state_filter
condition_object_state_filter ::= condition_on_battlefield | scalar_static_attacking_alone | adjective_blocked | adjective_tapped | adjective_untapped | state_renowned | condition_state_face_down | condition_state_modified | condition_state_chosen_type
/* @sem ObjectFilter::State(FaceDown) */
condition_state_face_down ::= "face" "down"
/* @sem ObjectFilter::Modified */
condition_state_modified ::= "modified"
/* @sem ObjectFilter::Chosen(CreatureType) */
condition_state_chosen_type ::= "the" "chosen" "type"

/* The past predicate is independent of the named object. Each predicate
   supplies its own filter, including the count in a crew event. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$past_object_predicate} */
condition_object_was_predicate ::= object_ref "was" past_object_predicate

past_object_predicate ::= past_cast_from_shared_zone | adjective_enchanted | adjective_equipped | past_attached_alternative | past_foretold | past_warp_cost | past_crew_count

/* @sem ObjectFilter::AnyOf([State(Enchanted), State(Equipped)]) */
past_attached_alternative ::= "enchanted" "or" "equipped"

/* @sem ObjectFilter::State(Foretold) */
past_foretold ::= "foretold"

/* @sem ObjectFilter::State(Warped) */
past_warp_cost ::= "cast" "for" "its" "warp" "cost"

/* @sem ObjectFilter::Property{property:CrewCount, test:NumberTest::Compare{comparison:Equal, value:$value}} */
past_crew_count ::= "crewed" "by" "exactly" value "creatures"

/* The subject and its past characteristic are independent operands. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$past_object_quality} */
condition_object_was_quality ::= object_ref "was" past_object_quality

past_object_quality ::= adjective_historic | adjective_legendary | adjective_basic | adjective_nonbasic | adjective_tapped | adjective_untapped | past_object_kicked

/* @sem ObjectFilter::State(Kicked) */
past_object_kicked ::= "kicked"

/* The ordinal belongs to the spell, while its caster remains the controller. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:NthCast{ordinal:$ordinal, spells:Any, by:One(AbilityController), scope:Turn}} */
condition_object_was_nth_cast ::= object_ref "was" "the" ordinal "spell" "you" "cast" "this" "turn"

/* A contracted reference binds in its surrounding ability. The type test uses
   the current incarnation after a move, when the context supplies one. */
/* @sem Condition::ObjectMatches{object:@move_after_current_type(ObjectRef::@it), filter:$filter_phrase} */
condition_it_matches_kind ::= "it's" "an" filter_phrase

/* Combat and chosen-characteristic predicates share the same anaphoric subject. */
/* @sem Condition::ObjectMatches{object:@it, filter:$contracted_object_predicate} */
condition_it_matches_predicate ::= "it's" contracted_object_predicate

contracted_object_predicate ::= adjective_attacking | adjective_attacking_or_blocking | contracted_attacking_object | contracted_attacking_player | contracted_chosen_color

/* @sem ObjectFilter::AttackingDefender(Objects($filter_phrase)) */
contracted_attacking_object ::= "attacking" "a" filter_phrase

/* @sem ObjectFilter::Chosen(Color) */
contracted_chosen_color ::= "at" "least" "one" "of" "the" "chosen" "colors"

/* @sem ObjectFilter::AttackingDefender(Players($player_with_maximum_life)) */
contracted_attacking_player ::= "attacking" player_with_maximum_life

/* @sem PlayerSet::Matching{binding:0, condition:Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:Equal, value:AmongPlayers{players:All, number:Life, aggregation:Maximum}}}} */
player_with_maximum_life ::= "the" "player" "with" "the" "most" "life" "or" "tied" "for" "most" "life"

/* Object predicates compose independently of the object they describe. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$object_predicate} */
condition_object_predicate ::= object_ref "is" object_predicate

object_predicate ::= adjective_attacking_or_blocking | predicate_power_toughness | predicate_your_ring_bearer

/* @sem ObjectFilter::AllOf([Property{property:Power, test:NumberTest::Compare{comparison:Equal, value:$value}}, Property{property:Toughness, test:NumberTest::Compare{comparison:Equal, value:$value_2}}]) */
predicate_power_toughness ::= value "/" value

/* @sem ObjectFilter::SameObject(RingBearer(AbilityController)) */
predicate_your_ring_bearer ::= "your" "Ring-bearer"

/* Negation retains both independently specified kinds or the combat union. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$object_negated_predicate} */
condition_object_not_predicate ::= object_ref "isn't" object_negated_predicate

object_negated_predicate ::= predicate_neither_kind | predicate_not_combat

/* @sem ObjectFilter::AllOf([Not($filter_phrase), Not($filter_phrase_2)]) */
predicate_neither_kind ::= "a" filter_phrase "or" filter_phrase

/* @sem ObjectFilter::Not($adjective_attacking_or_blocking) */
predicate_not_combat ::= adjective_attacking_or_blocking

/* The property, subject and parity are independent operands. */
/* @sem Condition::ObjectMatches{object:$condition_property_subject, filter:Property{property:$stat, test:$number_parity}} */
condition_property_parity ::= condition_property_subject stat "is" number_parity

/* The color and population remain independent operands of the comparison. */
most_common_color ::= most_common_white | most_common_blue | most_common_black | most_common_red | most_common_green | most_common_chosen

/* @sem Operand::Vocabulary{family:Color, form:White} */
most_common_white ::= "white"

/* @sem Operand::Vocabulary{family:Color, form:Blue} */
most_common_blue ::= "blue"

/* @sem Operand::Vocabulary{family:Color, form:Black} */
most_common_black ::= "black"

/* @sem Operand::Vocabulary{family:Color, form:Red} */
most_common_red ::= "red"

/* @sem Operand::Vocabulary{family:Color, form:Green} */
most_common_green ::= "green"

/* @sem Operand::Vocabulary{family:Color, form:TheChosenColor} */
most_common_chosen ::= "the" "chosen" "color"

/* @sem Condition::MostCommonColor{color:$most_common_color, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, tied:true} */
condition_most_common_color_tied ::= most_common_color "is" "the" "most" "common" "color" "among" "all" filter_plural "or" "is" "tied" "for" "most" "common"

/* @sem Condition::MostCommonColor{color:$most_common_color, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([ControlledBy(One(Chosen)), $filter_plural])}} */
condition_most_common_color_chosen_player ::= most_common_color "is" "the" "most" "common" "color" "among" filter_plural "the" "chosen" "player" "controls" "but" "isn't" "tied" "for" "most" "common"

/* Explicit source exclusion remains part of the counted population. */
/* @sem @and($filter_plural, ObjectFilter::Not(SameObject(Source))) */
control_other_plural ::= "other" filter_plural

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$control_other_plural, ControlledBy(One($condition_control_subject))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_control_at_least_other ::= condition_control_subject "at" "least" value control_other_plural

/* A plural qualifier combines with any supported plural noun. */
/* @sem @and($filter_plural, ObjectFilter::State(PowerBelowToughness)) */
control_toughness_qualified ::= filter_plural "that" "each" "have" "toughness" "greater" "than" "their" "power"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$control_toughness_qualified, ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_control_qualified_count ::= "you" "control" value "or" "more" control_toughness_qualified

/* Shared properties determine the size of a group within the controlled population. */
control_shared_population ::= control_shared_names | control_shared_creature_types

/* @sem Expr::LargestSharedGroup{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}, property:Names} */
control_shared_names ::= filter_plural "with" "the" "same" "name" "as" "one" "another"

/* @sem Expr::LargestSharedGroup{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}, property:CreatureTypes} */
control_shared_creature_types ::= filter_plural "that" "share" "a" "creature" "type"

/* @sem Condition::Compare{left:$control_shared_population, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_control_shared_group ::= "you" "control" value "or" "more" control_shared_population

/* Both sides count the same chosen type, but different players. */
/* @sem @and($filter_plural, ObjectFilter::Chosen(CreatureType)) */
control_chosen_type_plural ::= filter_plural "of" "that" "type"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$control_chosen_type_plural, ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:Greater, value:AmongPlayers{players:OthersThan(AbilityController), number:Permanents($control_chosen_type_plural), aggregation:Maximum}}} */
condition_control_chosen_type_more ::= "you" "control" "more" control_chosen_type_plural "than" "each" "other" "player"

/* Counts cast events with either printed spell type. */
/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:AnyOf([CardType(Instant), CardType(Sorcery)])}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_cast_instant_sorcery_threshold ::= "you've" "cast" value "or" "more" "instant" "and" "sorcery" "spells" "this" "turn"

/* The final temporal modifier applies to both historical conditions. */
/* @sem Condition::AllOf([Compare{left:EventHistory{event:ZoneChange{objects:AllOf([$filter_phrase, ControlledBy(All)]), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}}, $condition_one]) */
condition_entry_and_history ::= counter_amount filter_phrase "entered" "and" condition_one

/* Counted card phrases keep the card filter independent of the word order. */
graveyard_counted_cards ::= graveyard_any_cards | graveyard_filtered_cards

/* @sem ObjectFilter::Any */
graveyard_any_cards ::= "cards"

/* @sem $filter_phrase */
graveyard_filtered_cards ::= filter_phrase "cards"

/* @sem NumberTest::Compare{comparison:GreaterOrEqual, value:$value} */
condition_at_least ::= value "or" "more"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$graveyard_counted_cards}), test:$condition_at_least} */
condition_graveyard_count_have ::= "you" "have" condition_at_least graveyard_counted_cards "in" "your" "graveyard"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$graveyard_counted_cards}), test:$condition_at_least} */
condition_graveyard_count_are ::= condition_at_least graveyard_counted_cards "are" "in" "your" "graveyard"

/* An event group is filtered by its entry or cast origin, not by current zone. */
/* @sem ObjectFilter::AnyOf([EnteredFrom(Players{zone:Graveyard, players:All}), Cast{from:Players{zone:Graveyard, players:All}}]) */
event_group_graveyard_origin ::= "entered" "from" "a" "graveyard" "or" "was" "cast" "from" "a" "graveyard"

/* @sem Condition::Compare{left:CountObjects(Matching{objects:EventGroup, filter:$event_group_graveyard_origin}), test:$condition_at_least} */
condition_event_group_graveyard_count ::= condition_at_least "of" "them" event_group_graveyard_origin

/* @sem Condition::Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))}, filter:Attacking}), test:Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_controlled_attacking ::= ("a" | "an") filter_phrase "you" "control" "is" "attacking"

/* @sem Condition::Compare{left:CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))}, property:Colors}, test:Compare{comparison:Equal, value:Constant(5)}} */
condition_control_each_color ::= "you" "control" "a" filter_phrase "of" "each" "color"

/* Quantified controller predicates preserve the player binding used by the condition. */
/* @sem Condition::ExistsPlayer{players:One(AbilityController), binding:0, condition:Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counted_plural}, filter:ControlledBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:$bound_words, value:$value}}} */
condition_state_controller_count ::= "you" "control" value bound_words counted_plural

/* @sem Condition::ExistsPlayer{players:One(AbilityController), binding:0, condition:Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:$bound_words, value:$value}}} */
condition_state_controller_life ::= "you" "have" value bound_words "life"

/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counted_plural}, filter:ControlledBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}} */
condition_state_opponents_none ::= "your" "opponents" "control" "no" counted_plural

/* @sem Condition::PlayerDid{player:AbilityController, event:Cycled(GreaterOrEqual, $value, Any), window:ThisTurn} */
condition_cycled_at_least ::= "you" "cycled" value "or" "more" "cards" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:@and($filter_phrase, ObjectFilter::OwnedBy(One(AbilityController))), from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_owned_graveyard_from_battlefield ::= ("a" | "an") filter_phrase "was" "put" "into" "your" "graveyard" "from" "the" "battlefield" "this" "turn"

/* @sem Condition::ExistsPlayer{players:$event_player, binding:0, condition:Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}} */
condition_player_empty_hand ::= event_player "has" "no" "cards" "in" "hand"

/* A quantified player's hand and its independent numerical test. */
/* @sem Condition::ExistsPlayer{players:$event_player, binding:0, condition:Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), test:$existential_hand_test}} */
condition_existential_hand ::= event_player "has" existential_hand_test

existential_hand_test ::= existential_hand_bounded | existential_hand_empty | existential_hand_more_than_you

/* @sem NumberTest::Compare{comparison:$bound_words, value:$value} */
existential_hand_bounded ::= value bound_words "cards" "in" "hand"

/* @sem NumberTest::Compare{comparison:Equal, value:Constant(0)} */
existential_hand_empty ::= "no" "cards" "in" "hand"

/* @sem NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})} */
existential_hand_more_than_you ::= "more" "cards" "in" "hand" "than" "you"

/* Count spell casts for the bound opponent, retaining the named history window. */
/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(Bound(0)), spells:$spell_filter}, window:SinceLastTurnOf(AbilityController), measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
bound_opponent_cast_since_last_turn ::= "cast" spell_filter "since" "your" "last" "turn" "ended"

/* @sem Condition::Compare{left:CountPlayers(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:$bound_opponent_cast_since_last_turn}])), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_no_opponent_history ::= "no" "opponent" bound_opponent_cast_since_last_turn

/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:$counted_spell_kind}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_cast_filtered_threshold ::= "you've" "cast" value "or" "more" counted_spell_kind "spells" "this" "turn"

counted_spell_kind ::= adjective_nontype | spell_kind_union | spell_adjective

/* @sem ObjectFilter::AnyOf([$spell_adjective, $spell_adjective_2]) */
spell_kind_union ::= spell_adjective union_or spell_adjective

/* Negation and the time window compose with independently typed player events. */
/* @sem Condition::Not(Compare{left:EventHistory{event:$controller_history_action, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
condition_no_controller_history_this_turn ::= "you" "didn't" controller_history_action "this" "turn"

/* Both word orders quantify over a single player's graveyard. */
/* @sem Condition::ExistsPlayer{players:All, binding:0, condition:Compare{left:CountObjects(Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any})), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$single_graveyard_threshold}}} */
condition_any_graveyard_threshold ::= single_graveyard_threshold

single_graveyard_threshold ::= graveyard_has_threshold | cards_in_single_graveyard_threshold

/* @sem $value */
graveyard_has_threshold ::= "a" "graveyard" "has" value "or" "more" "cards" "in" "it"

/* @sem $value */
cards_in_single_graveyard_threshold ::= "there" "are" value "or" "more" "cards" "in" "a" "single" "graveyard"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:$object_attack_history} */
condition_object_attack_history ::= object_ref object_attack_history

object_attack_history ::= object_attacked_turn | object_attacked_combat | object_did_not_attack_turn | object_enlisted_combat | object_attacked_defender_turn

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
object_attacked_turn ::= "attacked" "this" "turn"

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisCombat, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
object_attacked_combat ::= "attacked" "this" "combat"

/* @sem ObjectFilter::Condition(Not(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})) */
object_did_not_attack_turn ::= "didn't" "attack" "this" "turn"

/* @sem Condition::ItsNight */
condition_its_night ::= "it's" "night"

/* No opponent in the ability controller’s opponent set controls a matching permanent. */
/* @sem Condition::Compare{left:CountPlayers(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Controls{player:Bound(0), filter:$filter_phrase, minimum:1}}])), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_no_opponent_controls_a ::= "no" "opponent" "controls" "a" filter_phrase

/* Two named life events share the same controller and history window. */
/* @sem Condition::AnyOf([Compare{left:EventHistory{event:Player{event:$life_event_past, players:One(AbilityController)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, Compare{left:EventHistory{event:Player{event:$life_event_past_2, players:One(AbilityController)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}]) */
condition_life_events_this_turn ::= "you" life_event_past "or" life_event_past "life" "this" "turn"

life_event_past ::= life_event_gained | life_event_lost

/* @sem PlayerEvent::GainsLife */
life_event_gained ::= "gained"

/* @sem PlayerEvent::LosesLife */
life_event_lost ::= "lost"

/* An occurrence of an owned card arriving in its owner's graveyard this turn. */
/* @sem Condition::Compare{left:EventHistory{event:$owned_card_graveyard_arrival, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_owned_card_arrival ::= owned_card_graveyard_arrival "from" "anywhere" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$owned_cards_graveyard_arrival, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_owned_cards_arrival_at_least ::= value "or" "more" owned_cards_graveyard_arrival "this" "turn" "from" "anywhere"

/* Name comparisons retain the two populations independently. "Another" excludes
   the subject within the battlefield population; the graveyard uses any card. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase} */
name_other_battlefield ::= "another" filter_phrase

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase} */
name_card_in_your_graveyard ::= "a" filter_phrase "card" "in" "your" "graveyard"

/* @sem ObjectFilter::AnyOf([SharesNameWithAnother($name_other_battlefield), SharesNameWithAny($name_card_in_your_graveyard)]) */
name_matches_either_population ::= "the" "same" "name" "as" name_other_battlefield "or" name_card_in_your_graveyard

/* @sem ObjectFilter::AllOf([Not(SharesNameWithAnother($name_other_battlefield)), Not(SharesNameWithAny($name_card_in_your_graveyard))]) */
name_matches_neither_population ::= "the" "same" "name" "as" name_other_battlefield "or" name_card_in_your_graveyard

/* @sem Condition::ObjectMatches{object:$object_ref, filter:$name_matches_either_population} */
condition_object_shares_name ::= object_ref "has" name_matches_either_population

/* @sem Condition::ObjectMatches{object:$object_ref, filter:$name_matches_neither_population} */
condition_object_lacks_shared_name ::= object_ref "doesn't" "have" name_matches_neither_population

/* The threshold counts distinct types among the controller's graveyard cards. */
/* @sem Condition::Compare{left:CountDistinct{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}), property:CardTypes}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
graveyard_card_types_threshold ::= "there" "are" number "or" "more" "card" "types" "among" "cards" "in" "your" "graveyard"

/* Library count clauses share their population and numerical test operands. */
/* @sem Condition::Compare{left:$library_card_population, test:$library_zero_test} */
condition_library_none ::= "there" "are" library_zero_test library_card_population

/* @sem Condition::Compare{left:$library_card_population, test:$library_threshold_test} */
condition_library_you_threshold ::= "you" "have" library_threshold_test library_card_population

/* @sem Condition::Compare{left:$library_count_subject, test:$library_threshold_test} */
condition_library_possessive_threshold ::= library_count_subject "has" library_threshold_test "cards" "in" "it"

/* @sem NumberTest::Compare{comparison:Equal, value:Constant(0)} */
library_zero_test ::= "no"

/* @sem NumberTest::Compare{comparison:GreaterOrEqual, value:$value} */
library_threshold_test ::= value "or" "more"

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}) */
library_count_subject ::= "your" "library"

library_card_population ::= library_unfiltered_population | library_filtered_population

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}) */
library_unfiltered_population ::= "cards" "in" "your" "library"

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}) */
library_filtered_population ::= filter_phrase "cards" "in" "your" "library"

/* Battlefield existence predicates preserve the written controller and filter. */
state_battlefield_condition ::= state_control_exists | state_control_none | state_color_not_most

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy($state_control_subject)])}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
state_control_exists ::= state_control_subject ("a" | "an") filter_phrase

state_control_subject ::= state_control_you | state_control_opponent

/* @sem PlayerSet::One(PlayerRef::AbilityController) */
state_control_you ::= "you" "control"

/* @sem PlayerSet::OpponentsOf(PlayerRef::AbilityController) */
state_control_opponent ::= "an" "opponent" "controls"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Chosen))])}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
state_control_none ::= "the" "chosen" "player" "controls" "no" filter_plural

/* @sem Condition::Not(MostCommonColor{color:$most_common_color, objects:$state_chosen_population, tied:true}) */
state_color_not_most ::= most_common_color "isn't" "the" "most" "common" "color" "among" state_chosen_population "or" "is" "tied" "for" "most" "common"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Chosen))])} */
state_chosen_population ::= filter_plural "the" "chosen" "player" "controls"

/* A player in the named set experienced a life event in the stated window. */
/* @sem Condition::ExistsPlayer{players:$life_history_players, binding:0, condition:Compare{left:EventHistory{event:Player{event:$life_history_event, players:One(Bound(0))}, window:$life_history_window, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}} */
condition_player_life_history ::= life_history_players life_history_event "life" life_history_window

life_history_players ::= event_player | life_history_team

/* @sem PlayerSet::Matching{binding:0, condition:SameTeam{player:Bound(0), other:AbilityController}} */
life_history_team ::= "your" "team"

life_history_event ::= life_history_gained | life_history_lost

/* @sem PlayerEvent::GainsLife */
life_history_gained ::= "gained"

/* @sem PlayerEvent::LosesLife */
life_history_lost ::= "lost"

life_history_window ::= life_history_this_turn | life_history_last_turn

/* @sem HistoryWindow::ThisTurn */
life_history_this_turn ::= "this" "turn"

/* @sem HistoryWindow::LastTurn */
life_history_last_turn ::= "last" "turn"

/* A historical damage predicate is shared by positive and negative conditions. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Condition($received_damage_history)} */
condition_object_was_damage ::= object_ref "was" received_damage_history

/* @sem Condition::ObjectMatches{object:$object_ref, filter:Condition(Not($received_damage_history))} */
condition_object_wasnt_damage ::= object_ref "wasn't" received_damage_history

/* @sem Condition::Compare{left:EventHistory{event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject(Candidate)), kind:$received_damage_kind, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
received_damage_history ::= "dealt" received_damage_kind "this" "turn"

received_damage_kind ::= historical_any_damage | historical_combat_damage | received_excess_damage

/* @sem DamageKind::Excess */
received_excess_damage ::= "excess" "damage"

/* The defending player is bound to the source whose ability contains this condition. */
/* @sem Condition::Controls{player:$defending_player, filter:$filter_phrase, minimum:1} */
condition_defending_controls_one ::= defending_player "controls" "a" filter_phrase

/* @sem Condition::Compare{left:PlayerNumber{player:$defending_player, number:Permanents($filter_plural)}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:AmongPlayers{players:All, number:Permanents($filter_plural), aggregation:Maximum}}} */
condition_defending_controls_most_tied ::= defending_player "controls" "the" "most" filter_plural "or" "is" "tied" "for" "the" "most"

condition_defending_control ::= condition_defending_controls_one | condition_defending_controls_an | condition_defending_controls_most_tied

/* The named permanent and its kind are independent current operands. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::Name($referenced_card_name))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_named_permanent_present ::= "a" filter_phrase "named" referenced_card_name "is" "on" "the" "battlefield"

/* An entry event under the controller's control, during this turn. */
/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:@and($noun, ObjectFilter::ControlledBy(One(AbilityController))), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_had_enter_under ::= "you" "had" "a" noun "enter" "the" "battlefield" "under" "your" "control" "this" "turn"

/* Two state predicates and a positive counter count describe the same holder. */
/* @sem Condition::ObjectMatches{object:Source, filter:AllOf([$it_state, $it_state_2, Counters(_{comparison:Greater, value:Constant(0)})])} */
condition_self_two_states_counter ::= self_text "is" it_state "," it_state "," "and" "has" "a" "counter" "on" "it"

/* Count a specific event caused by an opponent-controlled spell or ability. */
/* @sem Condition::Compare{left:EventHistory{event:Caused{cause:ControlledBy(OpponentsOf(AbilityController)), event:$opponent_caused_event}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_a}} */
condition_opponent_caused_history ::= counter_a opponent_caused_event "by" "a" "spell" "or" "ability" "an" "opponent" "controlled"

/* Exertion is recorded for the named object, regardless of the player who exerted it. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Condition(Not(Compare{left:EventHistory{event:Player{event:Exerts, players:All, objects:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}))} */
condition_not_exerted_this_turn ::= object_ref "hasn't" "been" "exerted" "this" "turn"

/* Cast history distinguishes the controller's spell count from a specific object. */
/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:Any}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_cast_single_history ::= "you" "cast" "a" "spell" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:Any}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count_plural}} */
condition_cast_plural_history ::= "you" "cast" count_plural "spells" "this" "turn"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:Condition(Compare{left:EventHistory{event:Spell{event:Cast, players:All, spells:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})} */
condition_object_cast_this_turn ::= object_ref "was" "cast" "this" "turn"

/* Historical predicates retain the named object independently of the other participant. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$historical_combat_peer} */
condition_historical_object ::= object_ref historical_combat_peer

/* @sem Condition::ObjectMatches{object:$object_ref, filter:$historical_crew_actor} */
condition_crewed_object ::= historical_crew_actor object_ref "this" "turn"

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Pair{event:Crews, objects:$filter_phrase, others:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
historical_crew_actor ::= "an" filter_phrase "crewed"

/* Damage histories retain the measured event and the printed threshold. */
/* @sem Condition::Compare{left:EventHistory{event:$damage_to_you_prefix, window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_damage_total_history ::= damage_to_you_prefix value "or" "more" "damage" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$damage_spell_history, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_damage_occurrence_history ::= damage_spell_history

/* @sem Condition::Compare{left:EventHistory{event:$damage_excess_history, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}} */
condition_damage_excess_history ::= counter_amount damage_excess_history

exiled_holder_condition ::= exiled_holder_in_exile | exiled_holder_counter_an | exiled_holder_counter_a | exiled_holder_in_exile_counter_a | exiled_holder_in_exile_counter_an

/* @sem Condition::ObjectMatches{object:Source, filter:InZone(Shared(Exile))} */
exiled_holder_in_exile ::= "this" "card" "is" "exiled"

/* @sem Condition::ObjectMatches{object:Source, filter:Counters{kind:$counter_kind, comparison:Greater, value:Constant(0)}} */
exiled_holder_counter_an ::= "this" "card" "is" "exiled" "with" "an" counter_kind "counter" "on" "it"

/* @sem Condition::ObjectMatches{object:Source, filter:Counters{kind:$counter_kind, comparison:Greater, value:Constant(0)}} */
exiled_holder_counter_a ::= "this" "card" "is" "exiled" "with" "a" counter_kind "counter" "on" "it"

/* @sem Condition::ObjectMatches{object:Source, filter:Counters{kind:$counter_kind, comparison:Greater, value:Constant(0)}} */
exiled_holder_in_exile_counter_a ::= "this" "card" "is" "in" "exile" "with" "a" counter_kind "counter" "on" "it"

/* @sem Condition::ObjectMatches{object:Source, filter:Counters{kind:$counter_kind, comparison:Equal, value:Constant(0)}} */
exiled_holder_no_counters ::= "this" "card" "has" "no" counter_kind "counters" "on" "it"

/* @sem Condition::ObjectMatches{object:Source, filter:Counters{kind:$counter_kind, comparison:Greater, value:Constant(0)}} */
exiled_holder_in_exile_counter_an ::= "this" "card" "is" "in" "exile" "with" "an" counter_kind "counter" "on" "it"

/* A tie for the maximum is included in the comparison. */
/* @sem Condition::Compare{left:PlayerNumber{player:AbilityController, number:Life}, test:NumberTest::Compare{comparison:Equal, value:AmongPlayers{players:All, number:Life, aggregation:Maximum}}} */
condition_maximum_life ::= "you" "have" "the" "most" "life" "or" "are" "tied" "for" "most" "life"

/* This qualifier is relative to the source, so only source-bound events use it. */
/* @sem Condition::Not(Controls{player:AbilityController, filter:AllOf([Not(SameObject(ObjectRef::Source)), $filter_phrase]), minimum:1}) */
condition_source_no_other_control ::= "you" "don't" "control" "another" filter_phrase

/* @sem Condition::AllOf([Window(UntapStep), PlayerIsActive(AbilityController)]) */
condition_your_untap_step ::= "your" "untap" "step"

/* Conditions on triggers and activations. */
/* Keep the producer and its consumer in the same inverse pattern: a receipt
   by itself does not establish which action produced it. */
/* @sem Instruction::[Effect{result:@mark, operation:Discard{players:One(AbilityController), amount:$card_count, random:true}}, If{condition:SubsetMeets{objects:Transition{result:@marked, phase:After}, comparison:GreaterOrEqual, amount:$card_count_2, constraints:[CommonProperty(CardTypes)]}, then:Program{instructions:$clause}, otherwise:Program{}}] */
instructions_discard_common_card_type ::= "discard" card_count "at" "random" "." "if" card_count "that" "share" "a" "card" "type" "are" "discarded" "this" "way" "," clause

/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, If{condition:SubsetMeets{objects:Recorded(@marked), comparison:GreaterOrEqual, amount:$card_count_2, constraints:[AllSameProperty(CardTypes)]}, then:Program{instructions:$clause}, otherwise:Program{}}] */
instructions_mill_same_card_types ::= "mill" card_count "." "if" card_count "that" "share" "all" "their" "card" "types" "were" "milled" "this" "way" "," clause

/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:EventHistory{event:ZoneChange{objects:AllOf([$filter_plural, ControlledBy(One(Bound(0)))]), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}} */
condition_opponent_entry_plural ::= "an" "opponent" "had" value "or" "more" filter_plural "enter" "the" "battlefield" "under" "their" "control" "this" "turn"

/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:EventHistory{event:ZoneChange{objects:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))]), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}} */
condition_opponent_entry_a ::= "an" "opponent" "had" "a" filter_phrase "enter" "the" "battlefield" "under" "their" "control" "this" "turn"

/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:EventHistory{event:ZoneChange{objects:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))]), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}} */
condition_opponent_entry_an ::= "an" "opponent" "had" "an" filter_phrase "enter" "the" "battlefield" "under" "their" "control" "this" "turn"

/* Count the defending player of this source, retaining the counted filter. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(DefendingPlayerOf(Source))))}), test:NumberTest::Compare{comparison:$bound_words, value:$count}} */
condition_defending_player_count ::= "defending" "player" "controls" count bound_words filter_plural

/* A two-color devotion counts symbols on permanents controlled by the ability controller. */
/* @sem Condition::Compare{left:CountManaSymbols{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:ControlledBy(One(AbilityController))}, colors:[$mana_color_word, $mana_color_word_2]}, test:NumberTest::Compare{comparison:Less, value:$value}} */
condition_devotion_pair_less ::= "your" "devotion" "to" mana_color_word "and" mana_color_word "is" "less" "than" value

/* Ownership and control are independent restrictions on the counted population. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($counted_plural, ObjectFilter::OwnedBy(OthersThan(AbilityController)), ObjectFilter::ControlledBy(One(AbilityController)))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_control_unowned_count ::= "you" "control" value "or" "more" counted_plural "you" "don't" "own"

/* Compare the per-card discard event history with the stated threshold. */
/* @sem Condition::Compare{left:EventHistory{event:$history_discard_event, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$card_count}} */
condition_discard_history ::= history_discard_event card_count "this" "turn"

/* The subject carries agreement and the spell phrase supplies its current filter. */
condition_no_cast_subject ::= condition_no_cast_you | condition_no_cast_player

/* @sem PlayerRef::AbilityController */
condition_no_cast_you ::= "you" "haven't" "cast"

/* @sem $player_ref */
condition_no_cast_player ::= player_ref "didn't" "cast"

/* @sem Condition::Not(Compare{left:EventHistory{event:Spell{event:Cast, players:One($condition_no_cast_subject), spells:$spell_filter}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
condition_no_cast_this_turn ::= condition_no_cast_subject spell_filter "this" "turn"

/* The second branch retains its own typed predicate. */
/* @sem Condition::AnyOf([$condition_one, $condition_after_or_if]) */
condition_or_if ::= condition_one "or" "if" condition_after_or_if

condition_after_or_if ::= condition_one | condition_history_sacrifice_this

/* @sem Condition::Compare{left:EventHistory{event:$history_token_event, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}} */
condition_history_token_this ::= history_token_event counter_amount "token" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$history_draw_event, window:LastTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$card_count}} */
condition_history_draw_last ::= history_draw_event card_count "last" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$history_draw_event, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_history_draw_this ::= history_draw_event value "or" "more" "cards" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$history_life_loss_event, window:LastTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_history_life_last ::= history_life_loss_event "life" "last" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$history_life_loss_event, window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_history_life_total_this ::= history_life_loss_event value "or" "more" "life" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$history_graveyard_departure, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_history_graveyard_departure ::= value "or" "more" "cards" history_graveyard_departure "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$history_sacrifice_event, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_history_sacrifice_this ::= history_sacrifice_event "this" "turn"

/* Occurrence histories share the same controller and turn window. */
/* @sem Condition::Compare{left:EventHistory{event:$past_you_event, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_you_history_this_turn ::= "you've" past_you_event "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$past_you_roll_event, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_you_roll_history_this_turn ::= "you've" past_you_roll_event value "or" "more" "dice" "this" "turn"

/* One controlled source must have dealt the threshold, rather than the sum of sources. */
/* @sem Condition::Compare{left:EventHistory{event:Damage(_{source_kind:Any, sources:ControlledBy(One(AbilityController)), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Source}), window:ThisTurn, measure:MostFromOneSource}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_source_damage_threshold ::= "a" "source" "you" "controlled" "dealt" value "or" "more" "damage" "this" "turn"

/* A singular token subtype is an independently scoped control test. */
/* @sem Condition::Not(Condition::Controls{player:AbilityController, filter:AllOf([$subtype, Token]), minimum:1}) */
condition_no_subtype_token ::= "you" "don't" "control" "a" subtype "token"

/* The cast origin is a predicate of the named object, independent of the subject. */
/* @sem ObjectFilter::Cast{from:$cast_shared_origin} */
past_cast_from_shared_zone ::= "cast" "from" cast_shared_origin

/* @sem ZoneScope::Shared(Exile) */
cast_shared_origin ::= "exile"

/* Thresholds count the population or distinct property named by the phrase. */
/* @sem Condition::Compare{left:$exile_counted_quantity, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_exile_threshold ::= "there" "are" value "or" "more" exile_counted_quantity

exile_counted_quantity ::= exile_quantity_cards | exile_quantity_types

/* @sem Expr::CountObjects($exile_cards_population) */
exile_quantity_cards ::= exile_cards_population

/* @sem Expr::CountDistinct{objects:$linked_exile_cards, property:CardTypes} */
exile_quantity_types ::= "card" "types" "among" linked_exile_cards

/* @sem Condition::Compare{left:CountObjects(Matching{objects:$owned_exile_population, filter:OwnedBy(One(AbilityController))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$card_count}} */
condition_own_exile_cards ::= "you" "own" card_count owned_exile_population

/* @sem Condition::Compare{left:CountObjects(Matching{objects:$exile_counter_population, filter:OwnedBy(One(EventSubject))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_they_own_exile_cards ::= "they" "own" value "or" "more" exile_counter_population

/* An opponent's cast history retains the quantified player in the event. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:EventHistory{event:Spell{event:Cast, players:One(Bound(0)), spells:$opponent_cast_spell_filter}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}} */
condition_opponent_cast_filtered_spell ::= "an" "opponent" "cast" "a" opponent_cast_spell_filter "spell" "this" "turn"

opponent_cast_spell_filter ::= adjective_color | filter_phrase | opponent_cast_color_union

/* @sem ObjectFilter::AnyOf(@unordered([$adjective_color, $adjective_color_2])) */
opponent_cast_color_union ::= adjective_color "and" "/" "or" adjective_color

/* Both historical predicates share the explicitly written turn window. */
/* @sem Condition::AnyOf(@unordered([$graveyard_cast_history, $graveyard_activation_history])) */
condition_graveyard_cast_or_activation ::= graveyard_cast_history "or" graveyard_activation_history "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:Cast{from:Players{zone:Graveyard, players:All}}}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
graveyard_cast_history ::= "you've" "cast" "a" "spell" "from" "a" "graveyard"

/* @sem Condition::PlayerDid{player:AbilityController, event:ActivatedGraveyardAbility, window:ThisTurn} */
graveyard_activation_history ::= "activated" "an" "ability" "of" "a" "card" "in" "a" "graveyard"

/* A player-history condition composes with the played card's filter. */
/* @sem Condition::Not(PlayerDid{player:AbilityController, event:$played_from_exile_history, window:ThisTurn}) */
condition_no_play_from_exile_this_turn ::= "you" "didn't" played_from_exile_history "this" "turn"

/* A condition governs the complete combat cap, retaining its defender and count. */
/* @sem Ability::Conditional{condition:$condition, then:[$static_combat_cap]} */
conditional_combat_cap ::= "as" "long" "as" condition "," static_combat_cap

/* A negative past predicate keeps the named object independent of the predicate. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Not($negated_past_object_predicate)} */
condition_object_wasnt_predicate ::= object_ref "wasn't" negated_past_object_predicate

negated_past_object_predicate ::= past_object_predicate | past_object_quality | past_sacrificed_history

/* @sem ObjectFilter::History{event:Sacrificed, window:ThisTurn} */
past_sacrificed_history ::= "sacrificed"

/* One opponent is bound throughout the counted population. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(Bound(0))))}), test:NumberTest::Compare{comparison:$bound_words, value:$count}}} */
condition_opponent_controls_count ::= "an" "opponent" "controls" count bound_words filter_plural

/* The empty hand belongs to the same existentially bound opponent. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}} */
condition_opponent_hand_empty ::= "an" "opponent" "has" "no" "cards" "in" "hand"

/* The enlisted object filter and the subject of its history remain independent. */
/* @sem ObjectFilter::History{event:Enlisted($filter_phrase), window:ThisCombat} */
object_enlisted_combat ::= "enlisted" "a" filter_phrase "this" "combat"

/* A casting requirement compares the announced X with a literal threshold. */
/* @sem NumberTest::Compare{comparison:NotEqual, value:$number_digits} */
announced_number_exclusion ::= "can't" "be" number_digits

/* @sem Condition::Compare{left:Expr::AnnouncedX, test:$announced_number_exclusion} */
announced_x_restriction ::= "x" announced_number_exclusion

/* @sem Ability::Casting(Require($announced_x_restriction)) */
casting_announced_x_requirement ::= announced_x_restriction "."

/* A controller's completed history retains its event and current-turn window. */
/* @sem Condition::PlayerDid{player:AbilityController, event:$controller_history_event, window:ThisTurn} */
condition_controller_history_this_turn ::= "you've" controller_history_event "this" "turn"

controller_history_event ::= history_paid_or_lost_energy | history_cycled_cards

/* @sem PlayerHistory::PaidOrLostEnergy(GreaterOrEqual, $value) */
history_paid_or_lost_energy ::= "paid" "or" "lost" value "or" "more" "{" "E" "}"

/* @sem PlayerHistory::Cycled(GreaterOrEqual, $value, Any) */
history_cycled_cards ::= "cycled" value "or" "more" "cards"

/* A casting limit on announced X compared with a battlefield population. */
/* @sem Condition::Compare{left:AnnouncedX, test:NumberTest::Compare{comparison:LessOrEqual, value:$value_number_of}} */
condition_announced_x_count_limit ::= "x" "can't" "be" "greater" "than" value_number_of

/* @sem Ability::Casting(Require($condition_announced_x_count_limit)) */
casting_announced_x_count_limit ::= condition_announced_x_count_limit "."

/* @sem ObjectFilter::History{event:AttackedDefender($filter_phrase), window:ThisTurn} */
object_attacked_defender_turn ::= "attacked" "a" filter_phrase "this" "turn"

/* The drafted name is a literal operand, independent of the ability holder. */
/* @sem Condition::NotedForDraft{player:AbilityController, note:_{kind:Guessed, player:AbilityController, card:$draft_guessed_card_name}} */
condition_you_guessed_named_card ::= "you" "guessed" "correctly" "for" "a" "card" "named" draft_guessed_card_name

draft_guessed_card_name ::= draft_guessed_self_name | referenced_card_name

/* @sem String::@card_name */
draft_guessed_self_name ::= SELF_NAME

/* Player history, its negation and its time window remain independent operands. */
/* @sem Condition::Not(Condition::PlayerDid{player:AbilityController, event:$you_past_history, window:$your_history_window}) */
condition_you_havent_history ::= "you" "haven't" you_past_history your_history_window

you_past_history ::= you_past_dealt_combat_damage | you_past_monarch

/* @sem PlayerHistory::WasDealtCombatDamage */
you_past_dealt_combat_damage ::= "been" "dealt" "combat" "damage"

/* @sem PlayerHistory::WasMonarch */
you_past_monarch ::= "been" "the" "monarch"

your_history_window ::= your_history_since_last_turn | your_history_this_turn

/* @sem HistoryWindow::SinceLastTurnOf(PlayerRef::AbilityController) */
your_history_since_last_turn ::= "since" "your" "last" "turn"

/* @sem HistoryWindow::ThisTurn */
your_history_this_turn ::= "this" "turn"

/* An unqualified counter threshold counts all counter kinds on the object. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Counters(_{comparison:GreaterOrEqual, value:$value})} */
condition_any_counters_at_least ::= object_ref "has" value "or" "more" "counters" "on" "it"

/* @sem Condition::Window(Upkeep) */
window_any_upkeep_step ::= "during" "any" "upkeep" "step"

/* An announced X is bounded by a separately described quantity. */
/* @sem Ability::Casting(Require(Compare{left:$casting_announced_x, test:NumberTest::Compare{comparison:$casting_forbidden_bound, value:$casting_bound_value}})) */
casting_x_forbidden_bound ::= casting_announced_x "can't" "be" casting_forbidden_bound casting_bound_value "."

/* @sem Expr::AnnouncedX */
casting_announced_x ::= "x"

casting_forbidden_bound ::= casting_not_greater | casting_not_less | casting_not_greater_equal | casting_not_less_equal

/* @sem Comparison::LessOrEqual */
casting_not_greater ::= "greater" "than"

/* @sem Comparison::GreaterOrEqual */
casting_not_less ::= "less" "than"

/* @sem Comparison::Less */
casting_not_greater_equal ::= "greater" "than" "or" "equal" "to"

/* @sem Comparison::Greater */
casting_not_less_equal ::= "less" "than" "or" "equal" "to"

casting_bound_value ::= casting_count_players | value_opponents | value_constant

/* @sem Expr::CountPlayers(All) */
casting_count_players ::= "the" "number" "of" "players" "in" "the" "game"

/* @sem Condition::Window(EndOfCombatStep) */
activation_window_end_of_combat ::= "the" "end" "of" "combat" "step"

/* @sem ObjectFilter::State(Bargained) */
state_bargained ::= "bargained"

/* The counted card filter and the referenced card are independent operands. */
/* @sem Condition::GraveyardPosition{card:$object_ref, player:AbilityController, above:$graveyard_counted_cards, comparison:GreaterOrEqual, amount:$value} */
condition_graveyard_position_above ::= value "or" "more" graveyard_counted_cards "are" "above" object_ref

/* @sem Condition::Window(ExtraTurn) */
window_extra_turns ::= "during" "extra" "turns"

/* @sem Condition::Window(FirstCombat) */
window_first_combat_phase ::= "during" "the" "first" "combat" "phase" "of" "the" "turn"

/* @sem Condition::Window(MainPhase) */
window_main_phase ::= "during" "a" "main" "phase"

/* The attacker filter is shared independently of the history condition. */
/* @sem ObjectFilter::AllOf([$filter_phrase, ControlledBy(One(AbilityController))]) */
history_attacker_you_controlled_an ::= "an" filter_phrase "you" "controlled"

/* @sem Condition::PlayerDid{player:EventSubject, event:AttackedBy($history_attacker_you_controlled_an), window:ThisTurn} */
condition_event_subject_attacked_history ::= "they" "were" "attacked" "this" "turn" "by" history_attacker_you_controlled_an

/* The history actor and the owner of the last turn are the same bound player. */
/* @sem Condition::ExistsPlayer{players:$event_player, binding:0, condition:$bound_player_last_turn_history} */
condition_player_last_turn_history ::= event_player bound_player_last_turn_history

/* @sem Condition::PlayerDid{player:Bound(0), event:$player_history_action, window:LastTurnOf(Bound(0))} */
bound_player_last_turn_history ::= player_history_action "during" "their" "last" "turn"

/* @sem PlayerHistory::AttackedPlayer($condition_player) */
player_history_action ::= "attacked" condition_player

/* The window is the ability controller’s own most recent completed turn. */
/* @sem Condition::PlayerDid{player:AbilityController, event:$historical_entry_under_your_control, window:LastTurnOf(AbilityController)} */
condition_you_had_entry_last_turn ::= "you" "had" historical_entry_under_your_control "last" "turn"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:Counters(_{kind:$counter_kind, comparison:Equal, value:Constant(0)})} */
condition_object_has_no_named_counters ::= object_ref "has" "no" counter_kind "counters" "on" "it"

/* Keep the condition in the same scope as references in the retrigger clause. */
/* @sem Ability::Conditional{condition:$condition, then:[$additional_trigger_for_population]} */
conditional_additional_trigger ::= "as" "long" "as" condition "," additional_trigger_for_population

/* Turn windows used by conditional casting costs. */
casting_cost_turn ::= casting_cost_other_turns | casting_cost_your_turn

/* @sem Condition::ExistsPlayer{players:OthersThan(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))} */
casting_cost_other_turns ::= "turns" "other" "than" "yours"

/* @sem Condition::PlayerIsActive(AbilityController) */
casting_cost_your_turn ::= "your" "turn"

/* The controller is independent of the population used for the extreme. */
/* @sem Condition::Controls{player:$condition_control_subject, filter:$battlefield_greatest_mana_tied, minimum:1} */
condition_control_the_extreme ::= condition_control_subject "the" battlefield_greatest_mana_tied

/* A retriggered ability's holder is independent of the condition's population. */
/* @sem ObjectFilter::@and($retrigger_holder, ObjectFilter::ControlledBy(One(AbilityController))) */
conditional_retrigger_holder ::= retrigger_holder "you" "control"

/* The while-clause applies to the retrigger rule, not to its holder filter. */
/* @sem Ability::Conditional{condition:$condition, then:[TriggerRule{abilities:AbilityOf($conditional_retrigger_holder), rule:TriggersAgain}]} */
conditional_retrigger ::= "if" "a" "triggered" "ability" "of" conditional_retrigger_holder "triggers" "while" condition "," "that" "ability" "triggers" "an" "additional" "time" "."

/* A disjunction of independent historical origins for the same object. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:AnyOf([$past_origin_filter, $past_origin_filter_2])} */
condition_object_past_origin_alternative ::= object_ref past_origin_filter "or" past_origin_filter

past_origin_filter ::= past_entered_from_player_zone | past_cast_from_player_zone

/* @sem ObjectFilter::EnteredFrom(Players{zone:$greatest_card_zone, players:One($zone_owner)}) */
past_entered_from_player_zone ::= "entered" "from" zone_owner greatest_card_zone

/* @sem ObjectFilter::Cast{from:Players{zone:$greatest_card_zone, players:One($zone_owner)}} */
past_cast_from_player_zone ::= "was" "cast" "from" zone_owner greatest_card_zone

/* The named object also supplies the antecedent of a following reference. */
/* @sem Condition::ObjectMatches{object:@remember_object($object_ref), filter:Not($condition_supertype)} */
condition_object_not_supertype ::= object_ref "isn't" condition_supertype

/* @sem Condition::PlayerDid{player:Bound(0), event:$bound_attack_event, window:$bound_attack_window} */
bound_player_attack_history ::= bound_attack_event bound_attack_window

/* @sem HistoryWindow::LastTurnOf(Bound(0)) */
bound_attack_last_turn ::= "during" "their" "last" "turn"

/* @sem HistoryWindow::ThisTurn */
bound_attack_this_turn ::= "this" "turn"

bound_attack_window ::= bound_attack_last_turn | bound_attack_this_turn

/* A threshold over the current attacking subset of a population. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:$affected, filter:Attacking}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_attacking_threshold ::= value "or" "more" affected "are" "attacking"

/* Both the step and the attacked-player condition restrict the same ability. */
/* @sem Condition::AllOf([Window(DeclareAttackers), PlayerState{player:AbilityController, state:BeingAttacked}]) */
window_attacked_declare_attackers ::= "during" "the" "declare" "attackers" "step" "and" "only" "if" "you've" "been" "attacked" "this" "step"

/* The controller and the owner of the counted graveyard are the same player. */
/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One($its_controller)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_controller_graveyard_at_least ::= its_controller "has" value "or" "more" "cards" "in" "their" "graveyard"

/* @sem Condition::Controls{player:$defending_player, filter:$noun, minimum:1} */
condition_defending_controls_an ::= defending_player "controls" "an" noun

scalar_last_turn_history ::= scalar_attacked_your_last_turn | scalar_blocked_your_last_turn | scalar_attacked_controller_last_turn | scalar_blocked_controller_last_turn

/* @sem ObjectFilter::History{event:Attacked, window:LastTurnOf(AbilityController)} */
scalar_attacked_your_last_turn ::= "attacked" "during" "your" "last" "turn"

/* @sem ObjectFilter::History{event:Blocked, window:LastTurnOf(AbilityController)} */
scalar_blocked_your_last_turn ::= "blocked" "during" "your" "last" "turn"

/* @sem ObjectFilter::History{event:Attacked, window:LastTurnOf(ControllerOf(Candidate))} */
scalar_attacked_controller_last_turn ::= "attacked" "during" "its" "controller's" "last" "turn"

/* @sem ObjectFilter::History{event:Blocked, window:LastTurnOf(ControllerOf(Candidate))} */
scalar_blocked_controller_last_turn ::= "blocked" "during" "its" "controller's" "last" "turn"

/* A singular controlled permanent with a named vowel-initial counter. */
/* @sem Condition::Controls{player:$condition_control_subject, filter:AllOf([$counter_condition_noun, Counters(_{kind:$counter_kind_vowel, comparison:Greater, value:Constant(0)})]), minimum:1} */
condition_control_counter_an ::= condition_control_subject "a" counter_condition_noun "with" "an" counter_kind_vowel "counter" "on" "it"

counter_kind_vowel ::= cn_acorn | cn_age | cn_oil | cn_omen | cn_ore

counter_condition_noun ::= noun_permanent | noun_creature

/* A color shared with any color tied for the largest population count. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:SharesMostCommonColor($affected)} */
condition_shares_most_common_color ::= object_ref "shares" "a" "color" "with" "the" "most" "common" "color" "among" affected "or" "a" "color" "tied" "for" "most" "common"

/* The test and card filter are shared with other zone-count conditions. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$graveyard_filtered_cards}), test:$condition_at_least} */
condition_hand_filtered_threshold ::= "you" "have" condition_at_least graveyard_filtered_cards "in" "your" "hand"

/* @sem Condition::ExistsPlayer{players:All, binding:0, condition:Controls{player:Bound(0), filter:$filter_phrase, minimum:1}} */
condition_any_player_controls ::= "any" "player" "controls" "a" filter_phrase

/* The library belongs to the quantified player; its count and threshold are
   separate operands so other comparisons can share the same subject. */
/* @sem Condition::ExistsPlayer{players:All, binding:0, condition:Compare{left:$bound_library_count, test:$library_size_test}} */
condition_any_library_size ::= bound_library_count "has" library_size_test "cards" "in" "it"

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}) */
bound_library_count ::= "a" "library"

library_size_test ::= condition_at_least | library_size_at_most

/* @sem NumberTest::Compare{comparison:LessOrEqual, value:$value} */
library_size_at_most ::= value "or" "fewer"

/* The attacking object's controller is recorded at the attack event. */
/* @sem Condition::Compare{left:EventHistory{event:Object{event:Attacks, objects:AllOf([Subtype(Spacecraft), ControlledBy(One(AbilityController))])}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_attacked_with_spacecraft ::= "you" "attacked" "with" "a" "Spacecraft" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:@and($filter_phrase, ObjectFilter::OwnedBy(One(AbilityController))), from:Battlefield, to:Hand}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_owned_hand_from_battlefield ::= ("a" | "an") filter_phrase "was" "put" "into" "your" "hand" "from" "the" "battlefield" "this" "turn"

/* Count attacking permanents independently of who they attack. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Attacking])}), test:NumberTest::Compare{comparison:Equal, value:Constant(1)}} */
condition_exactly_one_attacking ::= "exactly" "one" filter_phrase "is" "attacking"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$counted_plural, Attacking])}), test:NumberTest::Compare{comparison:Equal, value:$count_plural}} */
condition_exactly_many_attacking ::= "exactly" count_plural counted_plural "are" "attacking"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:ControlledBy(One(AbilityController))} */
condition_you_control_object ::= "you" "control" object_ref

/* This condition counts cards in the ability controller’s library. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_your_library_empty ::= "your" "library" "has" "no" "cards" "in" "it"

/* The previously announced player-or-planeswalker target supplies either the
   player or the planeswalker's controller. */
/* @sem Condition::Compare{left:PlayerNumber{player:PlayerOrControllerOf(Targets(0)), number:Life}, test:NumberTest::Compare{comparison:$target_life_comparison, value:PlayerNumber{player:AbilityController, number:Life}}} */
condition_target_player_or_walker_life ::= "that" "player" "or" "that" "planeswalker's" "controller" "has" target_life_comparison "life" "than" "you"

/* @sem Comparison::Greater */
target_life_more ::= "more"

/* @sem Comparison::Less */
target_life_less ::= "less"

target_life_comparison ::= target_life_more | target_life_less

/* The source exclusion belongs only to the first alternative. */
/* @sem Condition::Controls{player:$condition_control_subject, filter:AnyOf([AllOf([Not(SameObject(Source)), $filter_phrase]), $filter_phrase_2]), minimum:1} */
condition_control_another_or_an ::= condition_control_subject "another" filter_phrase "or" "an" filter_phrase

/* Count the recorded arrivals, keeping the event and threshold independent. */
/* @sem Condition::Compare{left:EventHistory{event:$owned_cards_elsewhere_event, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_owned_cards_elsewhere_threshold ::= value "or" "more" owned_cards_elsewhere_event "this" "turn"

/* Count the matching cards across all players’ graveyards. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$filter_phrase}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_all_graveyards_filtered_size ::= "there" "are" value "or" "more" filter_phrase "cards" "total" "in" "all" "graveyards"

/* The negation applies to the occurrence count for the written ability filter. */
/* @sem Condition::Not(Compare{left:EventHistory{event:Activated{players:One(AbilityController), abilities:$activated_ability_object}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
condition_no_activation_this_turn ::= "you" "didn't" "activate" activated_ability_object "this" "turn"

/* This restriction names the same card that holds the activation. */
/* @sem ActivationLimits::ActivationLimits{condition:ObjectMatches{object:$self_ref_holder, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}} */
limit_self_in_your_graveyard ::= "activate" "only" "if" self_ref_holder "is" "in" "your" "graveyard"

/* @sem Condition::Controls{player:$condition_control_subject, filter:AllOf([$filter_phrase, Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$value})]), minimum:1} */
condition_control_counter_threshold ::= condition_control_subject "a" filter_phrase "with" value "or" "more" counter_kind "counters" "on" "it"

/* The player bound by this state condition owns the counted graveyard. */
/* @sem Condition::ExistsPlayer{players:One(AbilityController), binding:0, condition:Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:$graveyard_counted_cards}), test:$graveyard_state_test}} */
condition_existential_graveyard_count ::= "there" "are" graveyard_state_test graveyard_counted_cards "in" "your" "graveyard"

graveyard_state_test ::= graveyard_state_no | graveyard_state_at_least

/* @sem NumberTest::Compare{comparison:Equal, value:Constant(0)} */
graveyard_state_no ::= "no"

/* @sem NumberTest::Compare{comparison:GreaterOrEqual, value:$count} */
graveyard_state_at_least ::= count "or" "more"

/* An individual opponent supplies the controller binding for this predicate. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Controls{player:Bound(0), filter:$filter_phrase, minimum:1}} */
condition_opponent_controls_an ::= "an" "opponent" "controls" "an" filter_phrase

/* An opponent of the ability controller controls a matching permanent. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Controls{player:Bound(0), filter:$filter_phrase, minimum:1}} */
condition_opponent_controls_a ::= "an" "opponent" "controls" "a" filter_phrase

/* A historical entry shares the event predicate independently of its time window. */
/* @sem Condition::Compare{left:EventHistory{event:$historical_you_had_entry, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_you_had_entry_this_turn ::= historical_you_had_entry "this" "turn"

/* The antecedent is the one card moved by the enclosing top-card exile. */
/* @sem Condition::ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$filter_phrase} */
condition_exiled_top_card_type ::= "that" "card" "is" "a" filter_phrase "card"

/* A player owns at least the stated number of cards in the shared exile zone. */
/* @sem Condition::ExistsPlayer{players:$event_player, binding:0, condition:Compare{left:CountObjects(Matching{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:Any}), filter:OwnedBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$owned_exile_card_count}}} */
condition_player_owns_exiled_cards ::= event_player "owns" owned_exile_card_count "in" "exile"

owned_exile_card_count ::= card_count_one | card_count_many

/* Exact hand size belongs to the controller of the ability. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Equal, value:$exact_hand_plural_count}} */
condition_exact_hand_cards ::= "you" "have" "exactly" exact_hand_plural_count "cards" "in" "hand"

exact_hand_plural_count ::= n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10 | n11 | n12 | n13 | n14 | n15 | n20

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Equal, value:Constant(1)}} */
condition_exact_hand_card ::= "you" "have" "exactly" "one" "card" "in" "hand"

/* The count belongs to the ability controller, independently of the Ring-bearer. */
/* @sem Condition::Compare{left:PlayerNumber{player:AbilityController, number:RingTemptations}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_ring_temptations_at_least ::= "the" "Ring" "has" "tempted" "you" value "or" "more" "times" "this" "game"

/* Bind the same player across the population and the historical predicate. */
/* @sem Condition::ExistsPlayer{players:$event_player, binding:0, condition:$bound_discard_history} */
condition_existential_discard_history ::= event_player bound_discard_history

/* @sem Condition::Compare{left:EventHistory{event:$bound_discard_event, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$card_count}} */
bound_discard_history ::= bound_discard_event card_count "this" "turn"

/* Two independently named permanent alternatives retain the controlling player. */
/* @sem Condition::AnyOf([Controls{player:$condition_control_subject, filter:Name($referenced_card_name), minimum:1}, Controls{player:$condition_control_subject, filter:Name($referenced_card_name_2), minimum:1}]) */
condition_control_either_named_permanent ::= condition_control_subject "a" "permanent" "named" referenced_card_name "or" "a" "permanent" "named" referenced_card_name

/* A zero count over the controller's graveyard, with an optional card filter. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$graveyard_counted_cards}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_graveyard_no_cards ::= "there" "are" "no" graveyard_counted_cards "in" "your" "graveyard"

/* Poisoned means having at least one poison counter. */
/* @sem Condition::Compare{left:CountCounters(_{recipients:Players(One($defending_player)), kind:Named(PoisonCounter), information:CurrentOrLastKnown}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
condition_player_poisoned ::= defending_player "is" "poisoned"

/* A casting requirement composes with the condition's own player and history scope. */
/* @sem Ability::Casting(Require($condition)) */
casting_self_unless_condition ::= "you" "can't" "cast" SELF_NAME "unless" condition "."

/* A turn window and a separate condition both constrain the same ability. */
/* @sem Condition::AllOf([$window_your_turn, $condition]) */
window_turn_as_long_as ::= window_your_turn "," "as" "long" "as" condition

/* The battlefield predicate composes with the referenced object. */
/* @sem ObjectFilter::InZone(Shared(Battlefield)) */
condition_on_battlefield ::= "on" "the" "battlefield"

/* A targeted permanent population retains its complete printed filter. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:TargetsAny(Objects($condition_targeted_population))} */
condition_targets_population ::= object_ref "targets" "a" condition_targeted_population

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController)), Chosen(CardName)])} */
condition_targeted_population ::= filter_phrase "you" "control" "with" "the" "chosen" "name"

/* The as-cast alternatives describe the same referenced spell or permanent. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$as_cast_reveal_or_control} */
condition_as_cast_reveal_or_control ::= as_cast_reveal_or_control "as" "you" "cast" object_ref

/* @sem ObjectFilter::AnyOf([Condition(AsCast{player:AbilityController, action:Revealed($filter_phrase)}), Condition(AsCast{player:AbilityController, action:Controlled(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase_2})})]) */
as_cast_reveal_or_control ::= "you" "revealed" "a" filter_phrase "card" "or" "controlled" "a" filter_phrase

/* An announced X is fixed by the counted population at casting time. */
/* @sem Ability::Casting(Require(Compare{left:AnnouncedX, test:NumberTest::Compare{comparison:Equal, value:$value_opponent_graveyard_union}})) */
casting_x_counted_cards ::= "x" "is" value_opponent_graveyard_union "as" "you" "cast" "this" "spell" "."

/* Count the cards linked to the stated object, independently of the consequence. */
/* @sem Condition::Compare{left:CountObjects($permission_linked_exile_cards), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_linked_exile_threshold ::= "there" "are" value "or" "more" permission_linked_exile_cards

/* The stack object and its sole target's kind remain independent operands. */
/* @sem Condition::ObjectMatches{object:@remember_object($condition_stack_target), filter:$sole_target_kind_filter} */
condition_single_target_matches ::= condition_stack_target sole_target_kind_filter

/* @sem ObjectFilter::AllOf([OnStack(SingleTarget), TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}))]) */
sole_target_kind_filter ::= "has" "only" "one" "target" "and" "that" "target" "is" "a" filter_phrase

/* @sem Condition::Controls{player:AbilityController, filter:@and($filter_phrase, $modifier_counter_threshold_on_it), minimum:1} */
condition_controlled_counter_threshold ::= "you" "control" "a" filter_phrase modifier_counter_threshold_on_it

/* @sem Condition::Not(Condition::Controls{player:$condition_control_subject, filter:AllOf([State(Suspected), $filter_plural]), minimum:1}) */
condition_control_no_suspected ::= condition_control_subject "no" "suspected" filter_plural

/* This possessive is used only after an explicit source event. */
/* @sem Condition::ObjectMatches{object:Source, filter:Property{property:$stat, test:NumberTest::Compare{comparison:$bound, value:$number}}} */
condition_source_stat_bounded ::= "its" stat "is" number "or" bound

/* Counter predicate for a previously established singular object. */
/* @sem ObjectFilter::Counters{kind:$counter_kind, comparison:LessOrEqual, value:$value} */
scalar_counter_test ::= "has" value "or" "fewer" counter_kind "counters" "on" "it"

/* A singular card existence test retains its filter and graveyard owner. */
/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:$filter_phrase}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_singular_filtered_card_in_graveyard ::= ("a" | "an") filter_phrase "card" "is" "in" "your" "graveyard"

/* The bound opponent owns the cards whose graveyard arrivals are counted. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:EventHistory{event:ZoneChange{objects:OwnedBy(One(Bound(0))), to:Graveyard}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}} */
condition_opponent_owned_graveyard_arrivals ::= "an" "opponent" "had" value "or" "more" "cards" "put" "into" "their" "graveyard" "from" "anywhere" "this" "turn"

/* The controller has not activated an exhaust ability in the current turn. */
/* @sem Condition::Not(PlayerDid{player:AbilityController, event:ActivatedExhaust, window:ThisTurn}) */
condition_no_exhaust_activation ::= "you" "haven't" "activated" "an" "exhaust" "ability" "this" "turn"
