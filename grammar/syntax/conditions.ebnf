condition ::= condition_control_distinct_pair | condition_first_end_step | condition_other_hand_alternatives_shared | condition_one | condition_and | condition_or | condition_or_if | condition_control_three_alternatives | condition_event_player_conjunction | condition_control_except_and_hand_empty

/* @sem Condition::AllOf([$condition_one, $condition_one_2]) */
condition_and ::= condition_one "and" condition_one

/* @sem Condition::AnyOf([$condition_one, $condition_one_2]) */
condition_or ::= condition_one "or" condition_one

condition_one ::= condition_object_and_other_attacked_combat | condition_first_combat_own_turn | condition_object_color_pair | condition_control_extreme_an | condition_control_extreme_a | condition_player_had_another_entered_turn | condition_not_monarch | activated_ability_nonmana_condition | condition_no_other_attacking_player | condition_history_controlled_damage_to | condition_player_identity | shared_literal_fold_de4a6c23fa99 | condition_control_distinct_names | condition_die_result_at_most | condition_activation_sacrificed_was | condition_number_bounded | condition_additional_paid | condition_beheld | condition_gift_promised | condition_gift_not_promised | condition_battlefield_none | condition_battlefield_threshold | condition_value_parity | condition_most_votes | condition_most_votes_or_tied | condition_planeswalked_this_turn | condition_battlefield_size | condition_battlefield_other_size | condition_above_starting_life | condition_starting_life_margin | condition_no_hollow_sentinel | condition_shares_card_type | condition_ring_bearer_choice | condition_ring_bearer_choice_other | condition_total_mana_spent | condition_typed_mana_spent | condition_symbol_spent | condition_symbol_pair_spent | condition_it_state | condition_left_battlefield_this_turn | condition_spell_warped_this_turn | condition_not_casters_turn | condition_no_opponent_more_life | condition_attached_named | condition_suspected | condition_not_suspected | condition_kicked_with | condition_kicked_twice | condition_linked_card | condition_it_card | mined_condition | condition_cast_kicked | condition_cast_main_phase | condition_kicked | condition_it_kicked | condition_tribute_unpaid | condition_hand_size | condition_hand_none | condition_control | condition_control_another | condition_attacked_or_blocked_combat | condition_not_your_turn | condition_hand_fewer_than | condition_cast_another_spell | condition_cast_another_typed_spell | condition_control_many | condition_opponents_control_many | condition_attacked | condition_lost_life | condition_self_is | condition_self_attached | condition_not_type | condition_it_was | condition_died | condition_left_under | condition_entered_under | condition_monarch | condition_cast | condition_graveyard_size | condition_graveyard_filtered_size | condition_graveyard_has | condition_life | condition_any_player_life | condition_opponent_count | condition_gained_life | condition_no_spell | condition_control_both | condition_card_types_graveyard | condition_land_types | condition_poison | condition_commander | condition_lost_amount | condition_no_creatures_died | condition_had_counter | condition_put_counter | condition_all_are | condition_not_their_turn | condition_damage_to_it | condition_that_entered | condition_opponents_control_none | condition_same_color_spent | condition_not_that_players_turn | condition_permanent_cards_graveyard | condition_entered_under_you | condition_defending_no | condition_property_bounded | condition_property_compared | condition_property_equal | condition_object_state | condition_object_color | condition_it_color | condition_escaped | condition_object_has_property | condition_controller_poison | condition_object_is_kind | condition_top_card_kind | condition_object_is_either_kind | condition_mana_values_graveyard | condition_committed_crime | condition_object_has_keyword | condition_object_lacks_keyword | condition_citys_blessing | condition_full_party | condition_counters_at_least | condition_there_are_counters_at_least | condition_has_counter | condition_no_counters | condition_you_cast | condition_you_cast_from_hand | condition_cast_from_graveyard | condition_no_spells_last_turn | condition_player_cast_spells_last_turn | condition_gained_life_this_turn | condition_drawn_at_least | condition_total_power_at_least | condition_searched_this_way | condition_opponent_controls_more | condition_different_powers | condition_equipped | condition_your_turn | condition_completed_dungeon | condition_bargained | condition_opponent_graveyard_at_least | condition_value_compared | condition_object_supertype | condition_entered_this_turn | condition_nth_resolution_this_turn | condition_descended_this_turn | condition_monstrous | condition_enchanted | condition_any_counter | condition_died_under_your_control | condition_died_this_turn_at_least | condition_attacked_total_power | condition_mana_from_spent | condition_cast_spells_this_turn | condition_more_cards_in_hand_than | condition_first_combat_phase | condition_have_initiative | condition_was_cast | condition_evidence_collected | condition_not_starting_player | condition_another_entered_this_turn | condition_permanent_left_this_turn | condition_not_cast_from_hand_this_turn | condition_object_was_predicate | condition_object_was_quality | condition_object_was_nth_cast | condition_it_matches_kind | condition_it_matches_predicate | condition_object_predicate | condition_object_not_predicate | condition_property_parity | condition_most_common_color_tied | condition_most_common_color_chosen_player | condition_control_at_least_other | condition_control_qualified_count | condition_control_shared_group | condition_control_chosen_type_more | condition_cast_instant_sorcery_threshold | condition_entry_and_history | condition_graveyard_count_have | condition_graveyard_count_are | condition_event_group_graveyard_count | condition_controlled_attacking | condition_control_each_color | condition_player_empty_hand | condition_cycled_at_least | condition_owned_graveyard_from_battlefield | condition_existential_hand | condition_no_opponent_history | condition_cast_filtered_threshold | condition_no_controller_history_this_turn | condition_any_graveyard_threshold | condition_object_attack_history | condition_its_night | condition_no_opponent_controls_a | condition_life_events_this_turn | condition_owned_card_arrival | condition_owned_cards_arrival_at_least | condition_object_shares_name | condition_object_lacks_shared_name | condition_library_none | condition_library_you_threshold | draw_library_threshold_condition | condition_player_life_history | condition_object_was_damage | condition_object_wasnt_damage | condition_named_permanent_present | condition_had_enter_under | condition_self_two_states_counter | condition_opponent_caused_history | condition_not_exerted_this_turn | condition_historical_object | condition_crewed_object | condition_damage_total_history | condition_damage_occurrence_history | condition_damage_excess_history | condition_maximum_life | condition_opponent_entry_plural | condition_opponent_entry_a | condition_opponent_entry_an | condition_defending_player_count | condition_devotion_pair_less | condition_control_unowned_count | condition_discard_history | condition_no_cast_this_turn | condition_history_token_this | condition_history_draw_last | condition_history_draw_this | condition_history_life_last | condition_history_life_total_this | condition_history_graveyard_departure | condition_you_history_this_turn | condition_you_roll_history_this_turn | condition_source_damage_threshold | condition_no_subtype_token | condition_exile_threshold | condition_own_exile_cards | condition_they_own_exile_cards | condition_opponent_cast_filtered_spell | condition_graveyard_cast_or_activation | condition_no_play_from_exile_this_turn | condition_object_wasnt_predicate | condition_opponent_hand_empty | condition_opponent_controls_count | condition_controller_history_this_turn | condition_you_guessed_named_card | condition_you_havent_history | condition_any_counters_at_least | condition_graveyard_position_above | condition_event_subject_attacked_history | condition_player_last_turn_history | condition_you_had_entry_last_turn | condition_object_has_no_named_counters | condition_control_the_extreme | condition_object_past_origin_alternative | condition_object_not_supertype | condition_attacking_threshold | condition_controller_graveyard_at_least | condition_control_counter_an | condition_hand_filtered_threshold | condition_any_player_controls | condition_any_library_size | condition_attacked_with_spacecraft | condition_owned_hand_from_battlefield | condition_exactly_one_attacking | condition_exactly_many_attacking | condition_you_control_object | condition_your_library_empty | condition_control_another_or_an | condition_owned_cards_elsewhere_threshold | condition_all_graveyards_filtered_size | condition_no_activation_this_turn | condition_control_counter_threshold | condition_you_had_entry_this_turn | condition_player_owns_exiled_cards | condition_exact_hand_cards | condition_exact_hand_card | condition_ring_temptations_at_least | condition_existential_discard_history | condition_control_either_named_permanent | condition_graveyard_no_cards | condition_targets_population | condition_as_cast_reveal_or_control | condition_controlled_counter_threshold | condition_control_no_suspected | condition_singular_filtered_card_in_graveyard | condition_opponent_owned_graveyard_arrivals | condition_no_exhaust_activation | condition_targets_permanent | condition_damage_distinct_sources_this_turn | condition_equipped_stat_comparison | condition_you_control_counter_attacked | condition_control_named_pair | condition_you_rolled_value_this_turn | condition_hand_exact_alternatives | condition_player_threshold_shared | condition_control_fewer_shared | condition_property_exact | condition_property_either | condition_possessive_base_change | condition_possessive_cost_paid | condition_attack_subject_pair | condition_attack_subject_single | condition_unspent_mana_at_least | condition_both_life_events_this_turn | condition_controlled_since | condition_cast_in_window | condition_graveyard_fewer_than | condition_graveyard_permanent_type_count | condition_another_attached | condition_control_excluding_two | condition_two_graveyard_card_kinds | condition_cast_not_from_caster_hand | condition_cast_from_caster_hand | condition_cast_other_named_game | condition_he_was_not_type | condition_source_damaged_opponent_turn | condition_object_was_dealt_damage_this_turn | condition_ability_activation_count | condition_coin_outcomes | condition_exiled_linked_count | condition_revealed_named_count | condition_all_players_life | condition_distinct_mana_spent | condition_excess_dealt | condition_graveyard_at_least | shared_literal_fold_764a98aa028f | condition_defending_hand_size | condition_exists_battlefield | condition_blocking_threshold | condition_control_shared_at_least | condition_controlled_object | condition_attached_controlled | condition_discard_family | condition_paid_event_cost | condition_starting_deck_threshold | condition_players_lost_game | condition_object_was_dealt_damage_turn | condition_player_discarded_turn | condition_self_counters_fewer | condition_self_no_counters | condition_self_started_untapped | condition_life_threshold | condition_counter_history_singular | condition_counter_history_plural | replacement_object_has_toxic | condition_mana_spent_less_than | condition_among_at_least | condition_among_exact | condition_player_more_controlled | condition_it_shares_color_with_an | condition_it_shares_color_with_controlled | condition_attached_controller_other | condition_object_has_keyword_family | condition_card_pool_start | condition_active_card_pool_start | condition_possessive_phase | condition_phase_window | condition_player_damage_history | condition_this_creature_regenerated | condition_you_have_gained_life | condition_you_life_comparison | condition_past_object_predicate | condition_exists_bound_player | condition_exists_possessive_player | condition_you_have_player_state | condition_controller_is_state | condition_game_turn | condition_object_origin_history | condition_owned_named_across_zones | condition_cast_both_spells | condition_exactly_one_counter | condition_exactly_many_counters | condition_cast_using_named_cost | condition_mana_sources_threshold | condition_any_matching_dice | condition_any_damage_source | condition_her_additional_paid | condition_source_damage_history | condition_activation_sacrifice_filter | condition_counter_population_threshold | condition_self_power_at_least | condition_holder_on_battlefield | condition_three_zone_card_threshold | condition_spell_alternative_cost_paid | condition_damage_source_filter | condition_owned_three_zone_count | condition_die_result_comparison | condition_own_ordinal_turns | condition_event_group_none_cast | condition_event_group_no_mana_spent | condition_event_group_no_mana_spent_normalized | condition_no_colored_mana_spent | condition_singular_attacking_player | condition_alternative_mana_paid | condition_you_win_bidding | condition_linked_distinct_mana_values | condition_counter_removed_controlled | condition_counter_permanent_graveyard | condition_counter_permanent_graveyard_a | condition_self_on_battlefield | condition_controlled_graveyard_from_battlefield | condition_your_combat_phase | condition_three_private_zones_threshold | condition_counted_zone_history | condition_threshold_zone_history | condition_other_zone_history | condition_devotion_pair_minimum | condition_object_lacks_keyword_family | condition_exists_each_player | condition_targets_filtered_spell | condition_history_some_event_this_turn | condition_history_no_event_this_turn | condition_no_objects_with_history | linked_play_opponent_damage | condition_counters_at_least_him | condition_holder_unblocked | condition_object_counter_test | condition_quantified_player | condition_object_counter_threshold | condition_object_exact_counter | condition_player_combat_damage_threshold | condition_red_green_spent | condition_object_hasnt_dealt_damage_yet | condition_negated_event_outcome | condition_attached_controller_none_other | condition_absent_player_state | condition_event_player_no_counters | condition_objects_with_counter_threshold | condition_not_completed_named_dungeon | condition_combat_population | condition_it_least_stat_tied | condition_battlefield_subject_an | condition_battlefield_subject_a | condition_exists_battlefield_predicate | condition_control_none_keyword | condition_difference_bounded | condition_opponent_life_against_another | condition_not_all_colors | condition_player_starting_life_fraction | condition_player_exact_life | condition_any_linked_exile_cards | condition_snow_mana_spent | condition_self_damage_another_turn | condition_anaphoric_past_spell_kind | condition_active_opponent_turn | condition_dice_count_comparison | condition_the_player_guess_outcome | condition_object_prospective | condition_you_sacrificed_this_turn | condition_card_exile_this_turn | condition_opponent_cast_mana_value | condition_white_distinct_symbol_spent | condition_hand_any_card | condition_hand_more_one_card | condition_hand_more_cards | condition_green_pair_spent | condition_sneak_paid_this_turn | condition_mana_spent_below_value | condition_greatest_power_tied | condition_control_base_comparison_a | condition_control_base_comparison_an | condition_white_other_spent | condition_own_control_object_and_named | condition_opponent_draw_words | condition_opponent_draw_threshold | condition_they_attacked_defender | condition_object_has_relative_stats | condition_not_possessive_phase | condition_control_each_extreme | condition_it_hasnt_dealt_damage_yet | condition_it_shares_most_common_color | condition_this_creature_did_not_attack_turn | condition_you_cast_from_graveyard | condition_you_cast_from_library | condition_there_are_any_counters_at_least | condition_you_didnt_cast_from_zone | condition_play_land_or_cast_outside_hand | condition_opponent_speed_lead | condition_they_attacked_any_defender | condition_object_attack_or_new_control | condition_devotion_pair_less_words | condition_source_attacked_or_blocked_this_turn | condition_mana_from_spent_to_activate | condition_attack_batch_last_turn | condition_controller_played_land_history | condition_control_four | condition_no_other_or_only_named_hand | condition_was_monarch_turn_began | condition_object_didnt_have_keyword_family | condition_history_draw_more_than | condition_history_filtered_threshold | condition_named_source_entered_this_turn | condition_object_is_extreme_kind | condition_other_blocking_one | condition_no_blocking_plural | condition_event_name_linked_exile | condition_object_counter_parity | condition_control_no_named | condition_control_no_named_an | condition_blue_pair_spent | condition_player_more_than_players | condition_colorless_symbol_spent | condition_your_hand_at_least | condition_no_hand_population | condition_event_subject_mv_was_greater | condition_cast_named_spell_pair | condition_control_negated | condition_property_compared_past | condition_past_property_or_less_h3

/* @sem Condition::PlayerState{player:AbilityController, state:FullParty} */
condition_full_party ::= "you" "have" "a" "full" "party"

/* @sem Condition::PlayerState{player:AbilityController, state:CitysBlessing} */
condition_citys_blessing ::= "you" "have" "the" "city's" "blessing"

/* The predicate keeps its explicitly written object, independently of the
   current event subject or the ability holder. Negation applies to the keyword. */
/* @sem Condition::ObjectMatches{object:@remember_object($object_ref), filter:HasKeyword($keyword_name)} */
condition_object_has_keyword ::= object_ref "has" keyword_name

/* @sem Condition::ObjectMatches{object:@remember_object($object_ref), filter:Not(HasKeyword($keyword_name))} */
condition_object_lacks_keyword ::= object_ref "doesn't" "have" keyword_name

/* @sem Condition::ObjectMatches{object:$object_ref, filter:$filter_phrase} */
condition_object_is_kind ::= object_ref ("is" | "was") ("a" | "an") filter_phrase

/* "If the top card of your library is a land card": what that card is away from the
   battlefield. Its explicit query keeps an unrelated antecedent from crowding
   out the verified spelling with a shorter but unbound pronoun. */
/* @prefer always */
/* @sem Condition::ObjectMatches{object:$ordered_top_card, filter:$card_filter} */
condition_top_card_kind ::= ordered_top_card "is" ("a" | "an") card_filter "card"

/* The predicate describes the linked card, separately from the holder's noun. */
/* @sem Condition::ObjectMatches{object:Earlier{what:LastExiled}, filter:CardType(Creature)} */
condition_linked_card ::= "a" "card" "exiled" "with" self_holder_text "is" "a" "creature" "card"

/* Alternatives test the same explicitly stated subject. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:AnyOf([$filter_phrase, $filter_phrase_2])} */
condition_object_is_either_kind ::= object_ref ("is" | "was") ("a" | "an") filter_phrase "or" ("a" | "an") filter_phrase

/* @sem Condition::ObjectMatches{object:$object_ref, filter:ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:$bound, value:$number}}} */
condition_object_has_property ::= object_ref "has" stat number "or" bound

/* Past-tense event-subject mana value threshold. */
/* @sem Condition::ObjectMatches{object:EventSubject, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}} */
condition_event_subject_mv_was_greater ::= "its" "mana" "value" "was" value "or" "greater"

/* A known object's controller is one player, without an existential binding. */
/* @sem Condition::Compare{left:Expr::CountCounters{recipients:Players(One($its_controller)), kind:Named(PoisonCounter), information:CurrentOrLastKnown}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}} */
condition_controller_poison ::= its_controller "has" count "or" "more" "poison" "counters"

/* A possessive supplies an object, independent of the property and comparison.
   Card names retain the creator; `this creature's` retains the ability holder. */
condition_property_subject ::= condition_attached_possessive | condition_property_it | condition_property_named | self_possessive | condition_spell_possessive

/* @prefer value(EventSubject) */
/* @sem ObjectRef::@it */
condition_property_it ::= "its"

/* @sem $it_possessive */
condition_property_named ::= it_possessive

/* @sem Condition::ObjectMatches{object:$condition_property_subject, filter:ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:$bound, value:$number}}} */
condition_property_bounded ::= condition_property_subject stat "is" number "or" bound

/* @sem Condition::ObjectMatches{object:$condition_property_subject, filter:ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:$stat_comparison, value:Expr::@in_filter($value)}}} */
condition_property_compared ::= condition_property_subject stat "is" stat_comparison value

/* @sem Condition::ObjectMatches{object:$condition_property_subject, filter:ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:Equal, value:$number}}} */
condition_property_equal ::= condition_property_subject stat "is" number

/* @sem Condition::ObjectMatches{object:$object_ref, filter:$condition_color} */
condition_object_color ::= object_ref "is" condition_color

/* @sem Condition::ObjectMatches{object:@it, filter:$condition_color} */
condition_it_color ::= "it's" condition_color

condition_color ::= adjective_color | adjective_colorless

/* A contracted subject keeps the object `it` names: `if it's renowned`. */
/* @sem Condition::ObjectMatches{object:@it, filter:$it_state} */
condition_it_state ::= "it's" it_state
it_state ::= adjective_modified | condition_it_face_down | condition_it_enchanted_or_equipped | condition_it_blocking_or_blocked_by | adjective_legendary | adjective_enchanted | adjective_equipped | state_renowned | state_bargained | adjective_blocking
/* @sem ObjectFilter::State(Renowned) */
state_renowned ::= "renowned"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:State(Escaped)} */
condition_escaped ::= object_ref "escaped"

/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Hand, players:One($condition_player)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:$bound_words, value:$count}} */
/* @prefer always */
condition_hand_size ::= condition_player ("has" | "have") count bound_words "cards" "in" "hand"
/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Less, value:$count}} */
condition_hand_fewer_than ::= "you" "have" "fewer" "than" count "cards" "in" "hand"
/* Another spell this turn: any spell you cast this turn other than this one. */
/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:Not(SameObject(Source))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_cast_another_spell ::= "you've" "cast" "another" "spell" "this" "turn"
/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:AllOf([Not(SameObject(Source)), $spell_adjectives])}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_cast_another_typed_spell ::= "you've" "cast" "another" spell_adjectives "spell" "this" "turn"

/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Hand, players:One($condition_player)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Equal, value:Expr::Constant(0)}} */
condition_hand_none ::= condition_player ("has" | "have") "no" "cards" "in" "hand"

condition_player ::= condition_you | condition_that_player

/* @sem PlayerRef::AbilityController */
condition_you ::= "you"

/* @sem @that_player */
condition_that_player ::= "that" "player"

bound_words ::= bound_or_more | bound_or_fewer

/* @sem Comparison::GreaterOrEqual */
bound_or_more ::= "or" "more"

/* @sem Comparison::LessOrEqual */
bound_or_fewer ::= "or" ("fewer" | "less")

/* The subject includes verb agreement; its reference is resolved in the enclosing
   event/target scope. Keep object exclusion separate from the controlling player. */
condition_control_subject ::= condition_control_you | condition_control_other | condition_control_they | condition_control_chosen

/* @sem PlayerRef::AbilityController */
condition_control_you ::= "you" "control"

/* @sem $that_player */
condition_control_other ::= that_player "controls"

/* @sem PlayerRef::@that_player */
condition_control_they ::= "they" "control"

/* @sem Condition::Controls{player:$condition_control_subject, filter:$filter_phrase, minimum:1} */
condition_control ::= condition_control_subject ("a" | "an") filter_phrase

/* @sem Condition::Controls{player:$condition_control_subject, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $filter_phrase), minimum:1} */
condition_control_another ::= condition_control_subject "another" filter_phrase

/* @sem Condition::AllOf([Controls{player:$condition_control_subject, filter:$filter_phrase, minimum:1}, Controls{player:$condition_control_subject, filter:$filter_phrase_2, minimum:1}]) */
condition_control_both ::= condition_control_subject ("a" | "an") filter_phrase "and" ("a" | "an") filter_phrase

/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One($condition_control_subject)))}), test:NumberTest::Compare{comparison:$bound_words, value:$count}} */
condition_control_many ::= condition_control_subject count bound_words filter_plural
/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(OpponentsOf(AbilityController)))}), test:NumberTest::Compare{comparison:$bound_words, value:$count}} */
condition_opponents_control_many ::= "your" "opponents" "control" count bound_words filter_plural

/* @sem Condition::Not(Condition::Controls{player:$condition_control_subject, filter:$filter_plural, minimum:1}) */
condition_control_none ::= condition_control_subject "no" filter_plural

/* @sem Condition::Compare{left:EventHistory{event:Player{event:Attacks, players:One(PlayerRef::AbilityController)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_attacked ::= "you" "attacked" ("with" "creatures")? "this" "turn"

/* @sem Condition::ExistsPlayer{players:$event_player, binding:0, condition:Compare{left:EventHistory{event:Player{event:LosesLife, players:One(PlayerRef::Bound(0))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}} */
condition_lost_life ::= event_player "lost" "life" "this" "turn"

/* @sem Condition::ObjectMatches{object:ObjectRef::Source, filter:$condition_state} */
condition_self_is ::= self_text "is" condition_state

/* @sem Condition::ObjectMatches{object:ObjectRef::Source, filter:$modifier_attached_to_a} */
condition_self_attached ::= self_text "is" modifier_attached_to_a

/* @sem Condition::ObjectMatches{object:$object_ref, filter:Not($filter_phrase)} */
condition_not_type ::= object_ref "isn't" ("a" | "an") filter_phrase

condition_state ::= adjective_tapped | adjective_untapped | adjective_attacking | adjective_blocking

/* @sem Condition::ObjectMatches{object:@it, filter:ObjectFilter::Not($condition_state)} */
condition_it_was ::= "it" "wasn't" condition_state

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:$filter_phrase, from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_died ::= ("a" | "an") filter_phrase "died" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:Object{event:LeavesBattlefield, objects:@and($filter_phrase, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController)))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_left_under ::= ("a" | "an") filter_phrase "left" "the" "battlefield" "under" "your" "control" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:@and($filter_phrase, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController))), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_entered_under ::= ("a" | "an") filter_phrase "entered" "the" "battlefield" "under" "your" "control" "this" "turn"

/* @sem Condition::PlayerState{player:AbilityController, state:Monarch} */
condition_monarch ::= "you're" "the" "monarch"

/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(PlayerRef::AbilityController), spells:$spell_filter}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_cast ::= "you've" "cast" spell_filter "this" "turn"

/* "If there are seven or more lands on the battlefield": the permanents counted where
   they are. */
/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counted_plural}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_battlefield_size ::= "there" "are" value "or" "more" counted_plural "on" "the" "battlefield"

/* The same current population, with its quantity before the noun phrase. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counted_plural}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_battlefield_threshold ::= value "or" "more" counted_plural "are" "on" "the" "battlefield"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counted_plural}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_battlefield_none ::= "no" counted_plural "are" "on" "the" "battlefield" | "there" "are" "no" counted_plural "on" "the" "battlefield"

/* "If there are five or more other creatures on the battlefield": all of them but the
   one the ability is about, the entering creature or this one. */
/* @sem Condition::Compare{left:Expr::CountObjects(Difference{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counted_plural}, excluding:One(@pump_other_ref(ObjectRef::@it))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_battlefield_other_size ::= "there" "are" value "or" "more" "other" counted_plural "on" "the" "battlefield"

/* A counted population; "other" belongs to the count's exclusion, not the filter. */
counted_plural ::= filter_plural_type_prefix | filter_plural_tail | filter_plural_adjectives | filter_plural_comma | mined_plural

/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}} */
condition_graveyard_size ::= "there" "are" count "or" "more" "cards" "in" "your" "graveyard"

/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:$card_filter}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}} */
condition_graveyard_filtered_size ::= "there" "are" count "or" "more" card_filter "cards" "in" "your" "graveyard"

/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:$card_filter}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_graveyard_has ::= ("there's" | "there" "is") ("a" | "an") card_filter "card" "in" "your" "graveyard"

/* @sem Condition::Compare{left:Expr::PlayerNumber{player:$condition_player, number:Life}, test:NumberTest::Compare{comparison:$bound_words, value:$number}} */
condition_life ::= condition_player ("has" | "have") number bound_words "life"
/* Some player's life total is within the bound. */
/* @sem Condition::ExistsPlayer{players:All, binding:0, condition:Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:$bound_words, value:$number}}} */
condition_any_player_life ::= "a" "player" "has" number bound_words "life"
/* @sem Condition::Compare{left:CountPlayers(OpponentsOf(AbilityController)), test:NumberTest::Compare{comparison:$bound_words, value:$count}} */
condition_opponent_count ::= "you" "have" count bound_words "opponents"

/* @sem Condition::Compare{left:EventHistory{event:Player{event:GainsLife, players:One(PlayerRef::AbilityController)}, window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
condition_gained_life ::= "you" "gained" number "or" "more" "life" "this" "turn"

/* @sem Condition::Not(Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(@that_player), spells:Any}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}) */
condition_no_spell ::= "that" "player" "didn't" "cast" "a" "spell" "this" "turn"

/* @sem Condition::Compare{left:Expr::CountDistinct{objects:Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, property:CardTypes}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}} */
condition_card_types_graveyard ::= "there" "are" count "or" "more" "card" "types" "among" "cards" "in" "your" "graveyard"

/* @sem Condition::Compare{left:Expr::CountDistinct{objects:Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, property:ManaValues}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}} */
condition_mana_values_graveyard ::= "there" "are" count "or" "more" "mana" "values" "among" "cards" "in" "your" "graveyard"

/* @sem Condition::PlayerState{player:AbilityController, state:CommittedCrime} */
condition_committed_crime ::= ("you've" | "you" "have") "committed" "a" "crime" "this" "turn"

/* @sem Condition::Compare{left:Expr::CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, property:BasicLandTypes}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}} */
condition_land_types ::= "there" "are" count "or" "more" "basic" "land" "types" "among" filter_plural

/* @sem Condition::ExistsPlayer{players:$event_player, binding:0, condition:Compare{left:Expr::CountCounters{recipients:Players(One(PlayerRef::Bound(0))), kind:Named(PoisonCounter), information:CurrentOrLastKnown}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}}} */
condition_poison ::= event_player "has" count "or" "more" "poison" "counters"

/* @sem Condition::Controls{player:AbilityController, filter:AllOf([State(Commander), OwnedBy(One(PlayerRef::AbilityController))]), minimum:1} */
condition_commander ::= "you" "control" "your" "commander"

/* @sem Condition::ExistsPlayer{players:$event_player, binding:0, condition:Compare{left:EventHistory{event:Player{event:LosesLife, players:One(PlayerRef::Bound(0))}, window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}} */
condition_lost_amount ::= event_player "lost" number "or" "more" "life" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:$filter_plural, from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:Equal, value:Expr::Constant(0)}} */
condition_no_creatures_died ::= "no" filter_plural "died" "this" "turn"

/* @sem Condition::ObjectMatches{object:@it, filter:ObjectFilter::Counters{kind:PowerToughness(1, 1), comparison:Greater, value:Expr::Constant(0)}} */
condition_had_counter ::= "it" "had" "a" "+" "1" "/" "+" "1" "counter" "on" "it"

/* @sem Condition::Compare{left:EventHistory{event:Batch{event:Counters{change:Put, objects:$filter_phrase, by:One(PlayerRef::AbilityController)}, per:Subject}, window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_put_counter ::= "you" "put" "a" "counter" "on" ("a" | "an") filter_phrase "this" "turn"

/* @sem Condition::Compare{left:Expr::CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$all_plural_population}, filter:ObjectFilter::Not($adjective_color)}), test:NumberTest::Compare{comparison:Equal, value:Expr::Constant(0)}} */
condition_all_are ::= all_plural_population "are" adjective_color

/* @sem Condition::Not(Condition::PlayerIsActive(@that_player)) */
condition_not_their_turn ::= "it's" "not" "their" "turn"

/* @sem Condition::ObjectMatches{object:@it, filter:ObjectFilter::Condition(Compare{left:EventHistory{event:Damage(DamageEvent{source_kind:Any, sources:Any, recipients:Objects(SameObject(ObjectRef::Candidate)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}})} */
condition_damage_to_it ::= number "or" "more" "damage" "was" "dealt" "to" "it" "this" "turn"

/* @sem Condition::ObjectMatches{object:@that_object, filter:ObjectFilter::Condition(Compare{left:EventHistory{event:ZoneChange{objects:SameObject(ObjectRef::Candidate), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}})} */
condition_that_entered ::= that_noun_word "entered" "this" "turn"

/* @sem Condition::Compare{left:Expr::CountPlayers(Intersection([OpponentsOf(PlayerRef::AbilityController), Matching{binding:0, condition:Not(Condition::Controls{player:Bound(0), filter:$filter_plural, minimum:1})}])), test:NumberTest::Compare{comparison:Equal, value:Expr::CountPlayers(OpponentsOf(PlayerRef::AbilityController))}} */
condition_opponents_control_none ::= "your" "opponents" "control" "no" filter_plural

/* @sem Condition::Not(Condition::Controls{player:$defending_player, filter:$filter_plural, minimum:1}) */
condition_defending_no ::= defending_player "controls" "no" filter_plural

/* @sem Condition::ExistsPlayer{players:OthersThan(@that_player), binding:0, condition:PlayerIsActive(Bound(0))} */
condition_not_that_players_turn ::= "it's" "not" "that" "player's" "turn"

/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
condition_permanent_cards_graveyard ::= "there" "are" number "or" "more" "permanent" "cards" "in" "your" "graveyard"

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:@and($filter_plural, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController))), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
condition_entered_under_you ::= number "or" "more" filter_plural "entered" "the" "battlefield" "under" "your" "control" "this" "turn"

/* @sem Condition::Compare{left:Expr::ManaSpent{object:EventSubject, filter:SpentManaFilter{}, aggregation:MaximumPerColor}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
condition_same_color_spent ::= "at" "least" number "mana" "of" "the" "same" "color" "was" "spent" "to" "cast" "it"

/* When an activated ability may be activated. */
activation_window ::= window_attacking_opponents_threshold | window_during_and_if | window_your_turn | window_before_attackers | window_your_upkeep | window_any_upkeep_step | window_during | window_if_shared_names | window_if | window_life_margin | window_attacked_declare_attackers | window_before_combat_end | window_opponent_margin | window_before_declaration

/* A life margin names the starting life total before the margin it adds. */
/* @sem $condition_you_life_comparison */
window_life_margin ::= "if" condition_you_life_comparison

/* @sem Condition::PlayerIsActive(AbilityController) */
window_your_turn ::= "during" "your" "turn"

/* An activation window is spelled as a casting window is; "during your turn" has
   its own spelling above. */
/* @sem $activation_cast_window */
window_during ::= "during" activation_cast_window
activation_cast_window ::= activation_window_end_of_combat | cast_window_combat | cast_window_declare_blockers | cast_window_declare_attackers | cast_window_combat_after | cast_window_combat_before | cast_window_combat_opponent | cast_window_combat_yours | cast_window_combat_yours_before | cast_window_blockers_opponent | cast_window_your_attackers | cast_window_your_end_step | cast_window_opponent_turn | cast_window_opponent_upkeep | cast_window_opponent_after_upkeep | cast_window_opponent_before_attackers

/* @sem Condition::AllOf([Condition::PlayerIsActive(AbilityController), Condition::Window(BeforeAttackersDeclared)]) */
window_before_attackers ::= "during" "your" "turn" "," "before" "attackers" "are" "declared"

/* @sem Condition::PlayerState{player:AbilityController, state:InTheirUpkeep} */
window_your_upkeep ::= "during" "your" "upkeep"

/* @sem $condition */
window_if ::= "if" condition

/* @prefer value(ObjectMatches) */
/* @sem Condition::ObjectMatches{object:$self_ref, filter:State(Kicked)} */
condition_kicked ::= self_ref "was" "kicked"

/* Keep the casting-state noun available before the ordinary self-name beam
   ranks the other holder nouns. Keys still recover all the general forms. */
/* @prefer type(Instant) */
/* @prefer type(Sorcery) */
/* @sem Condition::ObjectMatches{object:@self, filter:State(Kicked)} */
condition_cast_kicked ::= "this" "spell" "was" "kicked"

/* A spell's paid-cost predicate retains the specific payment outcome. */
/* @sem $spell_paid_cost_condition */
condition_additional_paid ::= "this" "spell's" spell_paid_cost_condition "cost" "was" "paid"
/* "If a Dragon was beheld": the spell's optional cost was to behold one, and a cost
   branch checks that the cost names the same kind. */
/* @sem Condition::@beheld($behold_kind) */
condition_beheld ::= ("a" | "an") behold_kind "was" "beheld"

/* @prefer type(Instant) */
/* @prefer type(Sorcery) */
/* Naming the spell doesn't make it the focus of a following "other target". */
/* @sem Condition::ObjectMatches{object:Source, filter:State(CastDuringOwnMainPhase)} */
condition_cast_main_phase ::= "you" "cast" "this" "spell" "during" "your" "main" "phase"

/* @prefer value(ObjectMatches) */
/* @sem Condition::ObjectMatches{object:@it, filter:State(Kicked)} */
condition_it_kicked ::= "it" "was" "kicked"
/* Tribute asks about the creature as it entered (CR 702.104). */
/* @sem Condition::ObjectMatches{object:EventSubject, filter:State(TributeNotPaid)} */
condition_tribute_unpaid ::= "tribute" "wasn't" "paid"

condition_it_card ::= condition_card_single | condition_card_either

/* @sem Condition::ObjectMatches{object:@current_it, filter:$card_filter} */
condition_card_single ::= "it's" ("a" | "an") card_filter "card"

/* A card's current characteristics may differ from its departed permanent. */
/* @sem Condition::ObjectMatches{object:@current_it, filter:AnyOf([$card_filter, $card_filter_2])} */
condition_card_either ::= "it's" ("a" | "an") card_filter "or" (("a" | "an"))? card_filter "card"

/* A paid named kicker remains distinct from being kicked at all or twice. */
/* @sem Condition::ObjectMatches{object:$kicked_subject, filter:$kicker_test_with} */
condition_kicked_with ::= kicked_subject "was" kicker_test_with
/* @sem Condition::ObjectMatches{object:$kicked_subject, filter:$kicker_test_twice} */
condition_kicked_twice ::= kicked_subject "was" kicker_test_twice
kicked_subject ::= self_ref | cast_it | cast_this_spell
/* The spell being cast or just cast. */
/* @sem @it */
cast_it ::= "it"
/* @sem @self */
cast_this_spell ::= "this" "spell"

/* Both explicit and contracted subjects retain the object they actually name. */
/* @sem Condition::ObjectMatches{object:$suspected_condition_subject, filter:State(Suspected)} */
condition_suspected ::= suspected_condition_subject "suspected"
/* @sem Condition::ObjectMatches{object:$suspected_condition_subject, filter:Not(State(Suspected))} */
condition_not_suspected ::= suspected_condition_subject "not" "suspected"
suspected_condition_subject ::= suspected_named_condition_subject | suspected_it_condition_subject
/* @sem $object_ref */
suspected_named_condition_subject ::= object_ref "is"
/* @sem ObjectRef::@it */
suspected_it_condition_subject ::= "it's"

/* Existential attachment is independent of the static ability's beneficiary. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Subtype(Equipment), ObjectFilter::Name($referenced_card_name))}, filter:AttachedTo(InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_attached_named ::= ("a" | "an") "Equipment" "named" referenced_card_name "is" "attached" "to" ("a" | "an") filter_phrase

/* @sem Condition::Compare{left:CountPlayers(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:Greater, value:PlayerNumber{player:$life_comparison_player, number:Life}}}}])), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_no_opponent_more_life ::= "no" "opponent" "has" "more" "life" "than" life_comparison_player

life_comparison_player ::= player_ref | condition_you

/* Something of a kind left the battlefield this turn, however it left. */
/* @sem Condition::Compare{left:EventHistory{event:Object{event:LeavesBattlefield, objects:$filter_phrase}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_left_battlefield_this_turn ::= ("a" | "an") filter_phrase "left" "the" "battlefield" "this" "turn"

/* Any player cast a spell for its warp cost this turn. */
/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:All, spells:State(Warped)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_spell_warped_this_turn ::= "a" "spell" "was" "warped" "this" "turn"

/* @sem Condition::Not(PlayerIsActive(@that_player)) */
condition_not_casters_turn ::= "it" "isn't" "that" "player's" "turn"

/* Mana paid to cast a spell, of any type or of one: `at least four mana was spent to cast
   it`, `five or more mana was spent to cast that spell`, `at least three black mana was
   spent to cast this spell`. This is total paid mana, not mana value or a color maximum.
   A written noun requires an already introduced spell, even after an action on the
   source creature. Ordinary If/intervening-if owners retain their own placement. */
/* @sem Condition::Compare{left:Expr::ManaSpent{object:$spent_spell, filter:SpentManaFilter{}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$spent_least}} */
condition_total_mana_spent ::= spent_least "mana" "was" "spent" "to" "cast" spent_spell
/* @sem Condition::Compare{left:Expr::ManaSpent{object:$spent_spell, filter:SpentManaFilter{colors:[$spent_type]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$spent_least}} */
condition_typed_mana_spent ::= spent_least spent_type "mana" "was" "spent" "to" "cast" spent_spell
/* One mana symbol of a color: `{G} was spent to cast this spell`. */
/* @sem Condition::Compare{left:Expr::ManaSpent{object:$spent_spell, filter:SpentManaFilter{colors:[$mana_letter]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_symbol_spent ::= "{" mana_letter "}" "was" "spent" "to" "cast" spent_spell
/* Two symbols of one color: `{W}{W} was spent to cast this spell`. */
/* @sem Condition::Compare{left:Expr::ManaSpent{object:$spent_spell, filter:SpentManaFilter{colors:[$spent_symbol_pair]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(2)}} */
condition_symbol_pair_spent ::= spent_symbol_pair "was" "spent" "to" "cast" spent_spell
spent_symbol_pair ::= spent_pair_white | spent_pair_blue | spent_pair_black | spent_pair_red | spent_pair_green
/* @sem ManaColor::White */
spent_pair_white ::= "{" "W" "}" "{" "W" "}"
/* @sem ManaColor::Blue */
spent_pair_blue ::= "{" "U" "}" "{" "U" "}"
/* @sem ManaColor::Black */
spent_pair_black ::= "{" "B" "}" "{" "B" "}"
/* @sem ManaColor::Red */
spent_pair_red ::= "{" "R" "}" "{" "R" "}"
/* @sem ManaColor::Green */
spent_pair_green ::= "{" "G" "}" "{" "G" "}"

spent_least ::= spent_at_least | spent_or_more
/* @sem $number */
spent_at_least ::= "at" "least" number
/* @sem $number */
spent_or_more ::= number "or" "more"
spent_type ::= mana_color_word | spent_colorless
/* @sem ManaColor::Colorless */
spent_colorless ::= "colorless"
spent_spell ::= cast_it | cast_this_spell | named_spell | cast_her

/* The player is a lexical antecedent, not necessarily a chosen opponent. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(PlayerRef::@that_player_literal)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})}} */
condition_that_player_more_cards ::= "that" "player" "has" "more" "cards" "in" "hand" "than" "you"

/* This fixed referent is used only in a span that explicitly chooses an opponent. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(Chosen)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})}} */
condition_chosen_player_more_cards ::= "that" "player" "has" "more" "cards" "in" "hand" "than" "you"

/* This is the creature chosen during the Ring event, not a current bearer query. */
/* @sem Condition::RingBearerChosen($filter_phrase) */
condition_ring_bearer_choice ::= "you" "chose" ("a" | "an") filter_phrase "as" "your" "Ring-bearer"
/* @sem Condition::RingBearerChosen(@and(ObjectFilter::Not(SameObject($object_ref)), $filter_phrase)) */
condition_ring_bearer_choice_other ::= "you" "chose" ("a" | "an") filter_phrase "other" "than" object_ref "as" "your" "Ring-bearer"

/* Both objects are explicit: the event object can be compared with a card
   linked to the holder without changing that event's actor. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Shares{property:CardTypes, with:$object_ref_2}} */
condition_shares_card_type ::= object_ref "shares" "a" "card" "type" "with" object_ref

/* A named-token existence check concerns controlled creatures with that name,
   not the identity or characteristics of a target in another mode. */
/* @prefer always */
/* @sem Condition::Not(Controls{player:AbilityController, filter:AllOf([CardType(Creature), Name('The Hollow Sentinel')]), minimum:1}) */
condition_no_hollow_sentinel ::= "you" "don't" "control" "a" "creature" "named" "The" "Hollow" "Sentinel"

/* @sem Condition::Compare{left:PlayerNumber{player:AbilityController, number:Life}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Add([StartingLife(AbilityController), $value])}} */
condition_starting_life_margin ::= "your" "life" "total" "is" "at" "least" value "greater" "than" "your" "starting" "life" "total"

/* @sem Condition::Compare{left:PlayerNumber{player:AbilityController, number:Life}, test:NumberTest::Compare{comparison:Greater, value:StartingLife(AbilityController)}} */
condition_above_starting_life ::= "your" "life" "total" "is" "greater" "than" "your" "starting" "life" "total"

/* At least a number of counters of a kind on an object. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$value})} */
condition_counters_at_least ::= object_ref "has" value "or" "more" counter_kind "counters" "on" "it"

/* At least a number of counters of a kind, phrased as existence. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$value})} */
condition_there_are_counters_at_least ::= "there" "are" value "or" "more" counter_kind "counters" "on" object_ref

/* Any counter of a kind on an object, now or as it last existed. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})} */
condition_has_counter ::= object_ref ("has" | "had") "a" counter_kind "counter" "on" "it"

/* No counters of a kind on an object. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Counters(_{kind:$counter_kind, comparison:Equal, value:Constant(0)})} */
condition_no_counters ::= "there" "are" "no" counter_kind "counters" "on" object_ref

/* You cast the object. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Cast{by:One(AbilityController)}} */
condition_you_cast ::= "you" "cast" object_ref

/* You cast the object from your hand. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Cast{by:One(AbilityController), from:Players{zone:Hand, players:One(AbilityController)}}} */
condition_you_cast_from_hand ::= "you" "cast" object_ref "from" "your" "hand"

/* The object was cast from any graveyard. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Cast{from:Players{zone:Graveyard, players:All}}} */
condition_cast_from_graveyard ::= object_ref "was" "cast" "from" "a" "graveyard"

/* No player cast a spell last turn. */
/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:All, spells:Any}, window:LastTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_no_spells_last_turn ::= "no" "spells" "were" "cast" "last" "turn"

/* Some player cast at least a number of spells last turn. */
/* @sem Condition::ExistsPlayer{players:All, binding:0, condition:Compare{left:EventHistory{event:Spell{event:Cast, players:One(Bound(0)), spells:Any}, window:LastTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}} */
condition_player_cast_spells_last_turn ::= "a" "player" "cast" value "or" "more" "spells" "last" "turn"

/* You gained life this turn. */
/* @sem Condition::Compare{left:EventHistory{event:Player{event:GainsLife, players:One(AbilityController)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_gained_life_this_turn ::= "you" "gained" "life" "this" "turn"

/* You drew at least a number of cards this turn. */
/* @sem Condition::Compare{left:EventHistory{event:Player{event:Draws, players:One(AbilityController)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_drawn_at_least ::= "you've" "drawn" value "or" "more" "cards" "this" "turn"

/* A group whose total stat reaches a number. */
/* @sem Condition::Compare{left:Aggregate{objects:$affected, property:$total_stat, aggregation:Sum}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_total_power_at_least ::= affected "have" "total" total_stat value "or" "greater"

/* The preceding search happened. */
/* @sem Condition::Searched(0) */
condition_searched_this_way ::= "you" "search" "your" "library" "this" "way"

/* An opponent controls more of a kind than you. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}), test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])})}}} */
condition_opponent_controls_more ::= "an" "opponent" "controls" "more" filter_plural "than" "you"

/* You control a number of creatures with different powers. */
/* @sem Condition::Compare{left:CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}, property:Powers}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_different_powers ::= "you" "control" value "or" "more" filter_plural "with" "different" "powers"

/* The object is equipped. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:State(Equipped)} */
condition_equipped ::= object_ref "is" "equipped"

/* It is your turn. */
/* @sem Condition::PlayerIsActive(AbilityController) */
condition_your_turn ::= "it's" "your" "turn"
/* It is another player's turn. */
/* @sem Condition::ExistsPlayer{players:OthersThan(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))} */
condition_not_your_turn ::= "it's" "not" "your" "turn"

/* You completed a dungeon. */
/* @sem Condition::PlayerState{player:AbilityController, state:CompletedDungeon} */
condition_completed_dungeon ::= "you've" "completed" "a" "dungeon"

/* The spell was bargained. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:State(Bargained)} */
condition_bargained ::= object_ref "was" "bargained"

/* Some opponent has at least a number of cards in their graveyard. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:CountObjects(Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any})), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}} */
condition_opponent_graveyard_at_least ::= "an" "opponent" "has" value "or" "more" "cards" "in" "their" "graveyard"

/* Scalar conditions use the same comparison vocabulary as object statistics. */
/* Direct object properties retain the existing ObjectMatches predicate;
   this production owns computed numeric subjects and captured X values. */
/* @sem Condition::@computed_condition(Condition::Compare{left:$value, test:NumberTest::Compare{comparison:$stat_comparison, value:$value_2}}) */
condition_value_compared ::= value "is" stat_comparison value

/* @sem Condition::@computed_condition(Condition::Compare{left:$value, test:$number_parity}) */
condition_value_parity ::= value "is" number_parity

number_parity ::= number_even | number_odd
/* @sem NumberTest::Compare{comparison:SameParity, value:Constant(0)} */
number_even ::= "even"
/* @sem NumberTest::Compare{comparison:SameParity, value:Constant(1)} */
number_odd ::= "odd"

/* The object entered this turn. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Condition(Compare{left:EventHistory{event:ZoneChange{objects:SameObject(Candidate), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})} */
condition_entered_this_turn ::= object_ref "entered" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:Player{event:Planeswalks, players:One(PlayerRef::AbilityController), objects:SameObject($self_explicit_ref)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_planeswalked_this_turn ::= "you" "planeswalked" "to" self_explicit_ref "this" "turn"

/* Bare supertype adjectives are predicates on the named object. */
/* @prefer value(ObjectMatches) */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$condition_supertype} */
condition_object_supertype ::= object_ref "is" condition_supertype
condition_supertype ::= adjective_legendary | adjective_basic | adjective_nonbasic | adjective_snow | adjective_nonsnow

/* @sem Condition::GiftPromised(true) */
condition_gift_promised ::= "the" "gift" "was" "promised"
/* @sem Condition::GiftPromised(false) */
condition_gift_not_promised ::= "the" "gift" "wasn't" "promised"

/* Numeric thresholds preserve both written operands. A spell-own X is the
   same announced value as its other amounts; independent frames stay distinct. */
/* @sem Condition::@number_condition(Condition::Compare{left:$number, test:NumberTest::Compare{comparison:$bound_words, value:$number_2}}) */
condition_number_bounded ::= number "is" number bound_words

/* Conditions taken over from seeded rules, in their original Oracle words. */
/* How many times this ability has resolved this turn, counting this time. */
/* @sem Condition::Compare{left:TimesResolvedThisTurn, test:NumberTest::Compare{comparison:Equal, value:$resolution_ordinal}} */
condition_nth_resolution_this_turn ::= "this" "is" "the" resolution_ordinal "time" "this" "ability" "has" "resolved" "this" "turn"
resolution_ordinal ::= ordinal_first | ordinal | library_depth_fourth

/* @sem Condition::PlayerState{player:AbilityController, state:Descended} */
condition_descended_this_turn ::= "you" "descended" "this" "turn"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:State(Monstrous)} */
condition_monstrous ::= object_ref "is" "monstrous"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:State(Enchanted)} */
condition_enchanted ::= object_ref "is" "enchanted"

/* Any counter on an object, now or as it last existed. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Counters(_{comparison:Greater, value:Constant(0)})} */
condition_any_counter ::= object_ref ("has" | "had") ("a" "counter" | "counters" | "one" "or" "more" "counters") "on" "it"

/* @sem Condition::Not(Controls{player:AbilityController, filter:$negative_control_filter, minimum:1}) */
condition_control_not_a ::= "you" "don't" "control" "a" negative_control_filter

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:AllOf([$filter_phrase, ControlledBy(One(AbilityController))]), from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}} */
condition_died_under_your_control ::= counter_amount filter_phrase "died" "under" "your" "control" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:$filter_plural, from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_died_this_turn_at_least ::= value "or" "more" filter_plural "died" "this" "turn"

/* @sem Condition::PlayerDid{player:AbilityController, event:AttackedWithTotalPower([GreaterOrEqual, $value]), window:ThisCombat} */
condition_attacked_total_power ::= "you" "attacked" "with" "creatures" "with" "total" "power" value "or" "greater" "this" "combat"

/* @prefer always */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:ManaSpentFrom($filter_phrase)} */
condition_mana_from_spent ::= "mana" "from" "a" filter_phrase "was" "spent" "to" "cast" object_ref

/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:Any}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_cast_spells_this_turn ::= "you've" "cast" value "or" "more" "spells" "this" "turn"

/* @sem Condition::Compare{left:PlayerNumber{player:AbilityController, number:CardsInHand}, test:NumberTest::Compare{comparison:Greater, value:AmongPlayers{players:$players_singular, number:CardsInHand, aggregation:Maximum}}} */
condition_more_cards_in_hand_than ::= "you" "have" "more" "cards" "in" "hand" "than" players_singular

/* @sem Condition::Window(FirstCombat) */
condition_first_combat_phase ::= "it's" "the" "first" "combat" "phase" "of" "the" "turn"

/* @sem Condition::PlayerState{player:AbilityController, state:Initiative} */
condition_have_initiative ::= "you" "have" "the" "initiative"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:Cast{}} */
condition_was_cast ::= object_ref "was" "cast"

/* @sem Condition::Compare{left:Earlier{what:Evidence, measure:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_evidence_collected ::= "evidence" "was" "collected"

/* The subject and player state are shared across the two tense forms. */
/* @sem Condition::Not(PlayerState{player:$starting_player_negative, state:$starting_player_state}) */
condition_not_starting_player ::= starting_player_negative starting_player_state

/* @sem Condition::ObjectMatches{object:$object_ref, filter:AnyOf([Condition(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisCombat, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}), Condition(Compare{left:EventHistory{event:Object{event:Blocks, objects:SameObject(Candidate)}, window:ThisCombat, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})])} */
condition_attacked_or_blocked_combat ::= object_ref "attacked" "or" "blocked" "this" "combat"

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:AllOf([Not(SameObject(Source)), $filter_phrase, ControlledBy(One(AbilityController))]), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_another_entered_this_turn ::= "another" filter_phrase "entered" "the" "battlefield" "under" "your" "control" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:Object{event:LeavesBattlefield, objects:ControlledBy(One(AbilityController))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}} */
condition_permanent_left_this_turn ::= counter_amount "permanent" "you" "controlled" "left" "the" "battlefield" "this" "turn"

/* @sem Condition::Not(Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:Cast{from:Players{zone:Hand, players:One(CasterOf(Candidate))}}}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}}) */
condition_not_cast_from_hand_this_turn ::= "you" "haven't" "cast" counter_amount "spell" "from" "your" "hand" "this" "turn"

/* "If the result is 3 or less": the die rolled just before. */
/* @sem Condition::Compare{left:DieResult(@die_roll), test:NumberTest::Compare{comparison:LessOrEqual, value:$number}} */
condition_die_result_at_most ::= "the" "result" "is" number "or" "less"

/* "If the sacrificed creature was a Human": the object sacrificed to activate this
   ability, as it was when paid. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:CostObjects{payment:Activation, component:[@cost_index], view:Performed, phase:Before}, filter:$sacrificed_quality}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
condition_activation_sacrificed_was ::= "the" "sacrificed" "creature" "was" sacrificed_quality
sacrificed_quality ::= sacrificed_quality_subtype | sacrificed_quality_adjective
/* @sem $subtype */
sacrificed_quality_subtype ::= ("a" | "an") subtype
/* @sem $adjectives */
sacrificed_quality_adjective ::= adjectives

/* Count names across the controlled population, rather than imposing a per-object test. */
/* @sem Condition::Compare{left:Expr::CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One($condition_control_subject)))}, property:Names}, test:NumberTest::Compare{comparison:$bound_words, value:$count}} */
condition_control_distinct_names ::= condition_control_subject count bound_words filter_plural "with" "different" "names"

/* An explicitly named object and its current state are independent operands. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$condition_object_state_filter} */
condition_object_state ::= object_ref "is" condition_object_state_filter
condition_object_state_filter ::= condition_on_battlefield | scalar_static_attacking_alone | adjective_blocked | adjective_tapped | adjective_untapped | state_renowned | condition_it_face_down | adjective_modified | condition_state_chosen_type

/* @sem ObjectFilter::Chosen(CreatureType) */
condition_state_chosen_type ::= "the" "chosen" "type"

/* The past predicate is independent of the named object. Each predicate
   supplies its own filter, including the count in a crew event. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$past_object_predicate} */
condition_object_was_predicate ::= object_ref "was" past_object_predicate

past_object_predicate ::= past_first_land_played_this_turn | past_cast_from_shared_zone | adjective_enchanted | adjective_equipped | past_attached_alternative | past_foretold | past_warp_cost | past_crew_count

/* @sem ObjectFilter::AnyOf([State(Enchanted), State(Equipped)]) */
past_attached_alternative ::= "enchanted" "or" "equipped"

/* @sem ObjectFilter::State(Foretold) */
past_foretold ::= "foretold"

/* @sem ObjectFilter::State(Warped) */
past_warp_cost ::= "cast" "for" "its" "warp" "cost"

/* @sem ObjectFilter::Property{property:CrewCount, test:NumberTest::Compare{comparison:Equal, value:$value}} */
past_crew_count ::= "crewed" "by" "exactly" value "creatures"

/* The subject and its past characteristic are independent operands. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$past_object_quality} */
condition_object_was_quality ::= object_ref "was" past_object_quality

past_object_quality ::= spell_cast_color_pair | past_all_colors | past_blocked_this_turn | past_combat_alone | adjective_historic | adjective_legendary | adjective_basic | adjective_nonbasic | adjective_tapped | adjective_untapped | mana_kicked

/* The ordinal belongs to the spell, while its caster remains the controller. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:NthCast{ordinal:$ordinal, spells:Any, by:One(AbilityController), scope:Turn}} */
condition_object_was_nth_cast ::= object_ref "was" "the" ordinal "spell" "you" "cast" "this" "turn"

/* A contracted reference binds in its surrounding ability. The type test uses
   the current incarnation after a move, when the context supplies one. */
/* @sem Condition::ObjectMatches{object:@move_after_current_type(ObjectRef::@it), filter:$filter_phrase} */
condition_it_matches_kind ::= "it's" "an" filter_phrase

/* Combat and chosen-characteristic predicates share the same anaphoric subject. */
/* @sem Condition::ObjectMatches{object:@it, filter:$contracted_object_predicate} */
condition_it_matches_predicate ::= "it's" contracted_object_predicate

contracted_object_predicate ::= paired_with_qualified_a | adjective_attacking | adjective_attacking_or_blocking | contracted_attacking_object | contracted_attacking_player | contracted_chosen_color

/* @sem ObjectFilter::AttackingDefender(Objects($filter_phrase)) */
contracted_attacking_object ::= "attacking" "a" filter_phrase

/* @sem ObjectFilter::Chosen(Color) */
contracted_chosen_color ::= "at" "least" "one" "of" "the" "chosen" "colors"

/* @sem ObjectFilter::AttackingDefender(Players($player_with_maximum_life)) */
contracted_attacking_player ::= "attacking" player_with_maximum_life

/* @sem PlayerSet::Matching{binding:0, condition:Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:Equal, value:AmongPlayers{players:All, number:Life, aggregation:Maximum}}}} */
player_with_maximum_life ::= "the" "player" "with" "the" "most" "life" "or" "tied" "for" "most" "life"

/* Object predicates compose independently of the object they describe. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$object_predicate} */
condition_object_predicate ::= object_ref "is" object_predicate

object_predicate ::= adjective_attacking | past_attached_alternative | spell_cast_color_pair | predicate_exact_attachment_one | predicate_exact_attachment_plural | predicate_attachment_minimum | adjective_attacking_or_blocking | predicate_power_toughness | predicate_your_ring_bearer

/* @sem ObjectFilter::AllOf([Property{property:Power, test:NumberTest::Compare{comparison:Equal, value:$value}}, Property{property:Toughness, test:NumberTest::Compare{comparison:Equal, value:$value_2}}]) */
predicate_power_toughness ::= value "/" value

/* @sem ObjectFilter::SameObject(RingBearer(AbilityController)) */
predicate_your_ring_bearer ::= "your" "Ring-bearer"

/* Negation retains both independently specified kinds or the combat union. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$object_negated_predicate} */
condition_object_not_predicate ::= object_ref "isn't" object_negated_predicate

object_negated_predicate ::= predicate_neither_kind | predicate_not_combat

/* @sem ObjectFilter::AllOf([Not($filter_phrase), Not($filter_phrase_2)]) */
predicate_neither_kind ::= "a" filter_phrase "or" filter_phrase

/* @sem ObjectFilter::Not($adjective_attacking_or_blocking) */
predicate_not_combat ::= adjective_attacking_or_blocking

/* The property, subject and parity are independent operands. */
/* @sem Condition::ObjectMatches{object:$condition_property_subject, filter:Property{property:$stat, test:$number_parity}} */
condition_property_parity ::= condition_property_subject stat "is" number_parity

/* The color and population remain independent operands of the comparison. */
most_common_color ::= most_common_white | most_common_blue | most_common_black | most_common_red | most_common_green | most_common_chosen

/* @sem Operand::Vocabulary{family:Color, form:White} */
most_common_white ::= "white"

/* @sem Operand::Vocabulary{family:Color, form:Blue} */
most_common_blue ::= "blue"

/* @sem Operand::Vocabulary{family:Color, form:Black} */
most_common_black ::= "black"

/* @sem Operand::Vocabulary{family:Color, form:Red} */
most_common_red ::= "red"

/* @sem Operand::Vocabulary{family:Color, form:Green} */
most_common_green ::= "green"

/* @sem Operand::Vocabulary{family:Color, form:TheChosenColor} */
most_common_chosen ::= "the" "chosen" "color"

/* @sem Condition::MostCommonColor{color:$most_common_color, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, tied:true} */
condition_most_common_color_tied ::= most_common_color "is" "the" "most" "common" "color" "among" "all" filter_plural "or" "is" "tied" "for" "most" "common"

/* @sem Condition::MostCommonColor{color:$most_common_color, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([ControlledBy(One(Chosen)), $filter_plural])}} */
condition_most_common_color_chosen_player ::= most_common_color "is" "the" "most" "common" "color" "among" filter_plural "the" "chosen" "player" "controls" "but" "isn't" "tied" "for" "most" "common"

/* Explicit source exclusion remains part of the counted population. */
/* @sem @and($filter_plural, ObjectFilter::Not(SameObject(Source))) */
control_other_plural ::= "other" filter_plural

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$control_other_plural, ControlledBy(One($condition_control_subject))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_control_at_least_other ::= condition_control_subject "at" "least" value control_other_plural

/* A plural qualifier combines with any supported plural noun. */
/* @sem @and($filter_plural, ObjectFilter::State(PowerBelowToughness)) */
control_toughness_qualified ::= filter_plural "that" "each" "have" "toughness" "greater" "than" "their" "power"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$control_toughness_qualified, ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_control_qualified_count ::= "you" "control" value "or" "more" control_toughness_qualified

/* Shared properties determine the size of a group within the controlled population. */
control_shared_population ::= control_shared_names | control_shared_creature_types

/* @sem Expr::LargestSharedGroup{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}, property:Names} */
control_shared_names ::= filter_plural "with" "the" "same" "name" "as" "one" "another"

/* @sem Expr::LargestSharedGroup{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}, property:CreatureTypes} */
control_shared_creature_types ::= filter_plural "that" "share" "a" "creature" "type"

/* @sem Condition::Compare{left:$control_shared_population, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_control_shared_group ::= "you" "control" value "or" "more" control_shared_population

/* Both sides count the same chosen type, but different players. */
/* @sem @and($filter_plural, ObjectFilter::Chosen(CreatureType)) */
control_chosen_type_plural ::= filter_plural "of" "that" "type"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$control_chosen_type_plural, ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:Greater, value:AmongPlayers{players:OthersThan(AbilityController), number:Permanents($control_chosen_type_plural), aggregation:Maximum}}} */
condition_control_chosen_type_more ::= "you" "control" "more" control_chosen_type_plural "than" "each" "other" "player"

/* Counts cast events with either printed spell type. */
/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:AnyOf([CardType(Instant), CardType(Sorcery)])}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_cast_instant_sorcery_threshold ::= "you've" "cast" value "or" "more" "instant" "and" "sorcery" "spells" "this" "turn"

/* The final temporal modifier applies to both historical conditions. */
/* @sem Condition::AllOf([Compare{left:EventHistory{event:ZoneChange{objects:AllOf([$filter_phrase, ControlledBy(All)]), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}}, $condition_one]) */
condition_entry_and_history ::= counter_amount filter_phrase "entered" "and" condition_one

/* Counted card phrases keep the card filter independent of the word order. */
graveyard_counted_cards ::= random_any_cards | graveyard_filtered_cards

/* @sem $filter_phrase */
graveyard_filtered_cards ::= filter_phrase "cards"

/* @sem NumberTest::Compare{comparison:GreaterOrEqual, value:$value} */
condition_at_least ::= value "or" "more"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$graveyard_counted_cards}), test:$condition_at_least} */
condition_graveyard_count_have ::= "you" "have" condition_at_least graveyard_counted_cards "in" "your" "graveyard"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$graveyard_counted_cards}), test:$condition_at_least} */
condition_graveyard_count_are ::= condition_at_least graveyard_counted_cards "are" "in" "your" "graveyard"

/* An event group is filtered by its entry or cast origin, not by current zone. */
/* @sem ObjectFilter::AnyOf([EnteredFrom(Players{zone:Graveyard, players:All}), Cast{from:Players{zone:Graveyard, players:All}}]) */
event_group_graveyard_origin ::= "entered" "from" "a" "graveyard" "or" "was" "cast" "from" "a" "graveyard"

/* @sem Condition::Compare{left:CountObjects(Matching{objects:EventGroup, filter:$event_group_graveyard_origin}), test:$condition_at_least} */
condition_event_group_graveyard_count ::= condition_at_least "of" "them" event_group_graveyard_origin

/* @sem Condition::Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))}, filter:Attacking}), test:Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_controlled_attacking ::= ("a" | "an") filter_phrase "you" "control" "is" "attacking"

/* @sem Condition::Compare{left:CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))}, property:Colors}, test:Compare{comparison:Equal, value:Constant(5)}} */
condition_control_each_color ::= "you" "control" "a" filter_phrase "of" "each" "color"

/* Quantified controller predicates preserve the player binding used by the condition. */
/* @sem Condition::ExistsPlayer{players:One(AbilityController), binding:0, condition:Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counted_plural}, filter:ControlledBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:$bound_words, value:$value}}} */
condition_state_controller_count ::= "you" "control" value bound_words counted_plural

/* @sem Condition::ExistsPlayer{players:One(AbilityController), binding:0, condition:Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:$bound_words, value:$value}}} */
condition_state_controller_life ::= "you" "have" value bound_words "life"

/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counted_plural}, filter:ControlledBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}} */
condition_state_opponents_none ::= "your" "opponents" "control" "no" counted_plural

/* @sem Condition::PlayerDid{player:AbilityController, event:Cycled(GreaterOrEqual, $value, Any), window:ThisTurn} */
condition_cycled_at_least ::= "you" "cycled" value "or" "more" "cards" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:@and($filter_phrase, ObjectFilter::OwnedBy(One(AbilityController))), from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_owned_graveyard_from_battlefield ::= ("a" | "an") filter_phrase "was" "put" "into" "your" "graveyard" "from" "the" "battlefield" "this" "turn"

/* @sem Condition::ExistsPlayer{players:$event_player, binding:0, condition:Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}} */
condition_player_empty_hand ::= event_player "has" "no" "cards" "in" "hand"

/* A quantified player's hand and its independent numerical test. */
/* @sem Condition::ExistsPlayer{players:$event_player, binding:0, condition:Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), test:$existential_hand_test}} */
condition_existential_hand ::= event_player "has" existential_hand_test

existential_hand_test ::= existential_hand_bounded | existential_hand_empty | existential_hand_more_than_you | existential_hand_at_least_more_than_you

/* @sem NumberTest::Compare{comparison:$bound_words, value:$value} */
existential_hand_bounded ::= value bound_words "cards" "in" "hand"

/* @sem NumberTest::Compare{comparison:Equal, value:Constant(0)} */
existential_hand_empty ::= "no" "cards" "in" "hand"

/* @sem NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})} */
existential_hand_more_than_you ::= "more" "cards" "in" "hand" "than" "you"

/* Count spell casts for the bound opponent, retaining the named history window. */
/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(Bound(0)), spells:$spell_filter}, window:SinceLastTurnOf(AbilityController), measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
bound_opponent_cast_since_last_turn ::= "cast" spell_filter "since" "your" "last" "turn" "ended"

/* @sem Condition::Compare{left:CountPlayers(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:$bound_opponent_cast_since_last_turn}])), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_no_opponent_history ::= "no" "opponent" bound_opponent_cast_since_last_turn

/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:$counted_spell_kind}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_cast_filtered_threshold ::= "you've" "cast" value "or" "more" counted_spell_kind "spells" "this" "turn"

counted_spell_kind ::= adjective_nontype | spell_kind_union | spell_adjective

/* @sem ObjectFilter::AnyOf([$spell_adjective, $spell_adjective_2]) */
spell_kind_union ::= spell_adjective union_or spell_adjective

/* Negation and the time window compose with independently typed player events. */
/* @sem Condition::Not(Compare{left:EventHistory{event:$controller_history_action, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
condition_no_controller_history_this_turn ::= "you" "didn't" controller_history_action "this" "turn"

/* Both word orders quantify over a single player's graveyard. */
/* @sem Condition::ExistsPlayer{players:All, binding:0, condition:Compare{left:CountObjects(Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any})), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$single_graveyard_threshold}}} */
condition_any_graveyard_threshold ::= single_graveyard_threshold

single_graveyard_threshold ::= graveyard_has_threshold | cards_in_single_graveyard_threshold

/* @sem $value */
graveyard_has_threshold ::= "a" "graveyard" "has" value "or" "more" "cards" "in" "it"

/* @sem $value */
cards_in_single_graveyard_threshold ::= "there" "are" value "or" "more" "cards" "in" "a" "single" "graveyard"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:$object_attack_history} */
condition_object_attack_history ::= object_ref object_attack_history

object_attack_history ::= object_attacked_count_turn | object_attacked_turn | object_attacked_combat | object_did_not_attack_turn | object_enlisted_combat | object_attacked_defender_turn

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
object_attacked_turn ::= "attacked" "this" "turn"

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisCombat, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
object_attacked_combat ::= "attacked" "this" "combat"

/* @sem ObjectFilter::Condition(Not(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})) */
object_did_not_attack_turn ::= "didn't" "attack" "this" "turn"

/* @sem Condition::ItsNight */
condition_its_night ::= "it's" "night"

/* No opponent in the ability controller’s opponent set controls a matching permanent. */
/* @sem Condition::Compare{left:CountPlayers(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Controls{player:Bound(0), filter:$filter_phrase, minimum:1}}])), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_no_opponent_controls_a ::= "no" "opponent" "controls" "a" filter_phrase

/* Two named life events share the same controller and history window. */
/* @sem Condition::AnyOf([Compare{left:EventHistory{event:Player{event:$life_event_past, players:One(AbilityController)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, Compare{left:EventHistory{event:Player{event:$life_event_past_2, players:One(AbilityController)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}]) */
condition_life_events_this_turn ::= "you" life_event_past "or" life_event_past "life" "this" "turn"

life_event_past ::= life_event_gained | life_event_lost

/* @sem PlayerEvent::GainsLife */
life_event_gained ::= "gained"

/* @sem PlayerEvent::LosesLife */
life_event_lost ::= "lost"

/* An occurrence of an owned card arriving in its owner's graveyard this turn. */
/* @sem Condition::Compare{left:EventHistory{event:$owned_card_graveyard_arrival, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_owned_card_arrival ::= owned_card_graveyard_arrival "from" "anywhere" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$owned_cards_graveyard_arrival, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_owned_cards_arrival_at_least ::= value "or" "more" owned_cards_graveyard_arrival "this" "turn" "from" "anywhere"

/* Name comparisons retain the two populations independently. "Another" excludes
   the subject within the battlefield population; the graveyard uses any card. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase} */
name_other_battlefield ::= "another" filter_phrase

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase} */
name_card_in_your_graveyard ::= "a" filter_phrase "card" "in" "your" "graveyard"

/* @sem ObjectFilter::AnyOf([SharesNameWithAnother($name_other_battlefield), SharesNameWithAny($name_card_in_your_graveyard)]) */
name_matches_either_population ::= "the" "same" "name" "as" name_other_battlefield "or" name_card_in_your_graveyard

/* @sem ObjectFilter::AllOf([Not(SharesNameWithAnother($name_other_battlefield)), Not(SharesNameWithAny($name_card_in_your_graveyard))]) */
name_matches_neither_population ::= "the" "same" "name" "as" name_other_battlefield "or" name_card_in_your_graveyard

/* @sem Condition::ObjectMatches{object:$object_ref, filter:$name_matches_either_population} */
condition_object_shares_name ::= object_ref "has" name_matches_either_population

/* @sem Condition::ObjectMatches{object:$object_ref, filter:$name_matches_neither_population} */
condition_object_lacks_shared_name ::= object_ref "doesn't" "have" name_matches_neither_population

/* The threshold counts distinct types among the controller's graveyard cards. */
/* @sem Condition::Compare{left:CountDistinct{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}), property:CardTypes}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
graveyard_card_types_threshold ::= "there" "are" number "or" "more" "card" "types" "among" "cards" "in" "your" "graveyard"

/* Library count clauses share their population and numerical test operands. */
/* @sem Condition::Compare{left:$library_card_population, test:$library_zero_test} */
condition_library_none ::= "there" "are" library_zero_test library_card_population

/* @sem Condition::Compare{left:$library_card_population, test:$condition_at_least} */
condition_library_you_threshold ::= "you" "have" condition_at_least library_card_population

/* @sem NumberTest::Compare{comparison:Equal, value:Constant(0)} */
library_zero_test ::= "no"

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}) */
library_count_subject ::= "your" "library"

library_card_population ::= library_unfiltered_population | library_filtered_population

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}) */
library_unfiltered_population ::= "cards" "in" "your" "library"

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}) */
library_filtered_population ::= filter_phrase "cards" "in" "your" "library"

/* Battlefield existence predicates preserve the written controller and filter. */
state_battlefield_condition ::= state_control_exists | state_control_none | state_color_not_most

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy($state_control_subject)])}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
state_control_exists ::= state_control_subject ("a" | "an") filter_phrase

state_control_subject ::= state_control_you | entry_named_controller

/* @sem PlayerSet::One(PlayerRef::AbilityController) */
state_control_you ::= "you" "control"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Chosen))])}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
state_control_none ::= "the" "chosen" "player" "controls" "no" filter_plural

/* @sem Condition::Not(MostCommonColor{color:$most_common_color, objects:$state_chosen_population, tied:true}) */
state_color_not_most ::= most_common_color "isn't" "the" "most" "common" "color" "among" state_chosen_population "or" "is" "tied" "for" "most" "common"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Chosen))])} */
state_chosen_population ::= filter_plural "the" "chosen" "player" "controls"

/* A player in the named set experienced a life event in the stated window. */
/* @sem Condition::ExistsPlayer{players:$life_history_players, binding:0, condition:Compare{left:EventHistory{event:Player{event:$life_history_event, players:One(Bound(0))}, window:$life_history_window, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}} */
condition_player_life_history ::= life_history_players life_history_event "life" life_history_window

life_history_players ::= event_player | life_history_team

/* @sem PlayerSet::Matching{binding:0, condition:SameTeam{player:Bound(0), other:AbilityController}} */
life_history_team ::= "your" "team"

life_history_event ::= life_event_gained | life_event_lost

life_history_window ::= bound_attack_this_turn | life_history_last_turn

/* @sem HistoryWindow::LastTurn */
life_history_last_turn ::= "last" "turn"

/* A historical damage predicate is shared by positive and negative conditions. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Condition($received_damage_history)} */
condition_object_was_damage ::= object_ref "was" received_damage_history

/* @sem Condition::ObjectMatches{object:$object_ref, filter:Condition(Not($received_damage_history))} */
condition_object_wasnt_damage ::= object_ref "wasn't" received_damage_history

/* @sem Condition::Compare{left:EventHistory{event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject(Candidate)), kind:$received_damage_kind, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
received_damage_history ::= "dealt" received_damage_kind "this" "turn"

received_damage_kind ::= damage_kind_noncombat | historical_any_damage | historical_combat_damage | excess_damage_any

/* The defending player is bound to the source whose ability contains this condition. */
/* @sem Condition::Controls{player:$defending_player, filter:$filter_phrase, minimum:1} */
condition_defending_controls_one ::= defending_player "controls" "a" filter_phrase

/* @sem Condition::Compare{left:PlayerNumber{player:$defending_player, number:Permanents($filter_plural)}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:AmongPlayers{players:All, number:Permanents($filter_plural), aggregation:Maximum}}} */
condition_defending_controls_most_tied ::= defending_player "controls" "the" "most" filter_plural "or" "is" "tied" "for" "the" "most"

condition_defending_control ::= condition_defender_controls_untapped_an | condition_defending_controls_one | condition_defending_controls_an | condition_defending_controls_most_tied

/* The named permanent and its kind are independent current operands. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::Name($referenced_card_name))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_named_permanent_present ::= "a" filter_phrase "named" referenced_card_name "is" "on" "the" "battlefield"

/* An entry event under the controller's control, during this turn. */
/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:@and($noun, ObjectFilter::ControlledBy(One(AbilityController))), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_had_enter_under ::= "you" "had" "a" noun "enter" "the" "battlefield" "under" "your" "control" "this" "turn"

/* Two state predicates and a positive counter count describe the same holder. */
/* @sem Condition::ObjectMatches{object:Source, filter:AllOf([$it_state, $it_state_2, Counters(_{comparison:Greater, value:Constant(0)})])} */
condition_self_two_states_counter ::= self_text "is" it_state "," it_state "," "and" "has" "a" "counter" "on" "it"

/* Count a specific event caused by an opponent-controlled spell or ability. */
/* @sem Condition::Compare{left:EventHistory{event:Caused{cause:ControlledBy(OpponentsOf(AbilityController)), event:$opponent_caused_event}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_a}} */
condition_opponent_caused_history ::= counter_a opponent_caused_event "by" "a" "spell" "or" "ability" "an" "opponent" "controlled"

/* Exertion is recorded for the named object, regardless of the player who exerted it. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Condition(Not(Compare{left:EventHistory{event:Player{event:Exerts, players:All, objects:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}))} */
condition_not_exerted_this_turn ::= object_ref "hasn't" "been" "exerted" "this" "turn"

/* Cast history distinguishes the controller's spell count from a specific object. */
/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:Any}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_cast_single_history ::= "you" "cast" "a" "spell" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:Any}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count_plural}} */
condition_cast_plural_history ::= "you" "cast" count_plural "spells" "this" "turn"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:Condition(Compare{left:EventHistory{event:Spell{event:Cast, players:All, spells:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})} */
condition_object_cast_this_turn ::= object_ref "was" "cast" "this" "turn"

/* Historical predicates retain the named object independently of the other participant. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$historical_combat_peer} */
condition_historical_object ::= object_ref historical_combat_peer

/* @sem Condition::ObjectMatches{object:$object_ref, filter:$historical_crew_actor} */
condition_crewed_object ::= historical_crew_actor object_ref "this" "turn"

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Pair{event:Crews, objects:$filter_phrase, others:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
historical_crew_actor ::= "an" filter_phrase "crewed"

/* Damage histories retain the measured event and the printed threshold. */
/* @sem Condition::Compare{left:EventHistory{event:$damage_to_you_prefix, window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_damage_total_history ::= damage_to_you_prefix value "or" "more" "damage" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$damage_spell_history, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_damage_occurrence_history ::= damage_spell_history

/* @sem Condition::Compare{left:EventHistory{event:$damage_excess_history, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}} */
condition_damage_excess_history ::= counter_amount damage_excess_history

exiled_holder_condition ::= exiled_holder_in_exile | exiled_holder_counter_an | exiled_holder_counter_a | exiled_holder_in_exile_counter_a | exiled_holder_in_exile_counter_an

/* @sem Condition::ObjectMatches{object:Source, filter:InZone(Shared(Exile))} */
exiled_holder_in_exile ::= "this" "card" "is" "exiled"

/* @sem Condition::ObjectMatches{object:Source, filter:Counters{kind:$counter_kind, comparison:Greater, value:Constant(0)}} */
exiled_holder_counter_an ::= "this" "card" "is" "exiled" "with" "an" counter_kind "counter" "on" "it"

/* @sem Condition::ObjectMatches{object:Source, filter:Counters{kind:$counter_kind, comparison:Greater, value:Constant(0)}} */
exiled_holder_counter_a ::= "this" "card" "is" "exiled" "with" "a" counter_kind "counter" "on" "it"

/* @sem Condition::ObjectMatches{object:Source, filter:Counters{kind:$counter_kind, comparison:Greater, value:Constant(0)}} */
exiled_holder_in_exile_counter_a ::= "this" "card" "is" "in" "exile" "with" "a" counter_kind "counter" "on" "it"

/* @sem Condition::ObjectMatches{object:Source, filter:Counters{kind:$counter_kind, comparison:Equal, value:Constant(0)}} */
exiled_holder_no_counters ::= "this" "card" "has" "no" counter_kind "counters" "on" "it"

/* @sem Condition::ObjectMatches{object:Source, filter:Counters{kind:$counter_kind, comparison:Greater, value:Constant(0)}} */
exiled_holder_in_exile_counter_an ::= "this" "card" "is" "in" "exile" "with" "an" counter_kind "counter" "on" "it"

/* A tie for the maximum is included in the comparison. */
/* @sem Condition::Compare{left:PlayerNumber{player:AbilityController, number:Life}, test:NumberTest::Compare{comparison:Equal, value:AmongPlayers{players:All, number:Life, aggregation:Maximum}}} */
condition_maximum_life ::= "you" "have" "the" "most" "life" "or" "are" "tied" "for" "most" "life"

/* This qualifier is relative to the source, so only source-bound events use it. */
/* @sem Condition::Not(Controls{player:AbilityController, filter:AllOf([Not(SameObject(ObjectRef::Source)), $filter_phrase]), minimum:1}) */
condition_source_no_other_control ::= "you" "don't" "control" "another" filter_phrase

/* @sem Condition::AllOf([Window(UntapStep), PlayerIsActive(AbilityController)]) */
condition_your_untap_step ::= "your" "untap" "step"

/* Conditions on triggers and activations. */
/* Keep the producer and its consumer in the same inverse pattern: a receipt
   by itself does not establish which action produced it. */
/* @sem Instruction::[Effect{result:@mark, operation:Discard{players:One(AbilityController), amount:$card_count, random:true}}, If{condition:SubsetMeets{objects:Transition{result:@marked, phase:After}, comparison:GreaterOrEqual, amount:$card_count_2, constraints:[CommonProperty(CardTypes)]}, then:Program{instructions:$clause}, otherwise:Program{}}] */
instructions_discard_common_card_type ::= "discard" card_count "at" "random" "." "if" card_count "that" "share" "a" "card" "type" "are" "discarded" "this" "way" "," clause

/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, If{condition:SubsetMeets{objects:Recorded(@marked), comparison:GreaterOrEqual, amount:$card_count_2, constraints:[AllSameProperty(CardTypes)]}, then:Program{instructions:$clause}, otherwise:Program{}}] */
instructions_mill_same_card_types ::= "mill" card_count "." "if" card_count "that" "share" "all" "their" "card" "types" "were" "milled" "this" "way" "," clause

/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:EventHistory{event:ZoneChange{objects:AllOf([$filter_plural, ControlledBy(One(Bound(0)))]), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}} */
condition_opponent_entry_plural ::= "an" "opponent" "had" value "or" "more" filter_plural "enter" "the" "battlefield" "under" "their" "control" "this" "turn"

/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:EventHistory{event:ZoneChange{objects:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))]), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}} */
condition_opponent_entry_a ::= "an" "opponent" "had" "a" filter_phrase "enter" "the" "battlefield" "under" "their" "control" "this" "turn"

/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:EventHistory{event:ZoneChange{objects:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))]), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}} */
condition_opponent_entry_an ::= "an" "opponent" "had" "an" filter_phrase "enter" "the" "battlefield" "under" "their" "control" "this" "turn"

/* Count the defending player of this source, retaining the counted filter. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(DefendingPlayerOf(Source))))}), test:NumberTest::Compare{comparison:$bound_words, value:$count}} */
condition_defending_player_count ::= "defending" "player" "controls" count bound_words filter_plural

/* A two-color devotion counts symbols on permanents controlled by the ability controller. */
/* @sem Condition::Compare{left:CountManaSymbols{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:ControlledBy(One(AbilityController))}, colors:[$mana_color_word, $mana_color_word_2]}, test:NumberTest::Compare{comparison:Less, value:$value}} */
condition_devotion_pair_less ::= "your" "devotion" "to" mana_color_word "and" mana_color_word "is" "less" "than" value

/* Ownership and control are independent restrictions on the counted population. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($counted_plural, ObjectFilter::OwnedBy(OthersThan(AbilityController)), ObjectFilter::ControlledBy(One(AbilityController)))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_control_unowned_count ::= "you" "control" value "or" "more" counted_plural "you" "don't" "own"

/* Compare the per-card discard event history with the stated threshold. */
/* @sem Condition::Compare{left:EventHistory{event:$history_discard_event, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$card_count}} */
condition_discard_history ::= history_discard_event card_count "this" "turn"

/* The subject carries agreement and the spell phrase supplies its current filter. */
condition_no_cast_subject ::= condition_no_cast_you | condition_no_cast_player

/* @sem PlayerRef::AbilityController */
condition_no_cast_you ::= "you" "haven't" "cast"

/* @sem $player_ref */
condition_no_cast_player ::= player_ref "didn't" "cast"

/* @sem Condition::Not(Compare{left:EventHistory{event:Spell{event:Cast, players:One($condition_no_cast_subject), spells:$spell_filter}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
condition_no_cast_this_turn ::= condition_no_cast_subject spell_filter "this" "turn"

/* The second branch retains its own typed predicate. */
/* @sem Condition::AnyOf([$condition_or_if_first, $condition_after_or_if]) */
condition_or_if ::= condition_or_if_first "or" "if" condition_after_or_if

condition_after_or_if ::= condition_one | condition_history_sacrifice_this

/* @sem Condition::Compare{left:EventHistory{event:$history_token_event, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}} */
condition_history_token_this ::= history_token_event counter_amount "token" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$history_draw_event, window:LastTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$card_count}} */
condition_history_draw_last ::= history_draw_event card_count "last" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$history_draw_event, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_history_draw_this ::= history_draw_event value "or" "more" "cards" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$history_life_loss_event, window:LastTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_history_life_last ::= history_life_loss_event "life" "last" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$history_life_loss_event, window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_history_life_total_this ::= history_life_loss_event value "or" "more" "life" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$history_graveyard_departure, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_history_graveyard_departure ::= value "or" "more" "cards" history_graveyard_departure "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$history_sacrifice_event, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
/* @prefer always */
condition_history_sacrifice_this ::= history_sacrifice_event "this" "turn"

/* Occurrence histories share the same controller and turn window. */
/* @sem Condition::Compare{left:EventHistory{event:$past_you_event, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_you_history_this_turn ::= "you've" past_you_event "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$past_you_roll_event, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_you_roll_history_this_turn ::= "you've" past_you_roll_event value "or" "more" "dice" "this" "turn"

/* One controlled source must have dealt the threshold, rather than the sum of sources. */
/* @sem Condition::Compare{left:EventHistory{event:Damage(_{source_kind:Any, sources:ControlledBy(One(AbilityController)), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Source}), window:ThisTurn, measure:MostFromOneSource}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_source_damage_threshold ::= "a" "source" "you" "controlled" "dealt" value "or" "more" "damage" "this" "turn"

/* A singular token subtype is an independently scoped control test. */
/* @sem Condition::Not(Condition::Controls{player:AbilityController, filter:AllOf([$subtype, Token]), minimum:1}) */
condition_no_subtype_token ::= "you" "don't" "control" "a" subtype "token"

/* The cast origin is a predicate of the named object, independent of the subject. */
/* @sem ObjectFilter::Cast{from:$cast_origin_exile} */
past_cast_from_shared_zone ::= "cast" "from" cast_origin_exile

/* Thresholds count the population or distinct property named by the phrase. */
/* @sem Condition::Compare{left:$exile_counted_quantity, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_exile_threshold ::= "there" "are" value "or" "more" exile_counted_quantity

exile_counted_quantity ::= exile_quantity_cards | exile_quantity_types

/* @sem Expr::CountObjects($exile_cards_population) */
exile_quantity_cards ::= exile_cards_population

/* @sem Expr::CountDistinct{objects:$linked_exile_cards, property:CardTypes} */
exile_quantity_types ::= "card" "types" "among" linked_exile_cards

/* @sem Condition::Compare{left:CountObjects(Matching{objects:$owned_exile_population, filter:OwnedBy(One(AbilityController))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$card_count}} */
condition_own_exile_cards ::= "you" "own" card_count owned_exile_population

/* @sem Condition::Compare{left:CountObjects(Matching{objects:$exile_counter_population, filter:OwnedBy(One(EventSubject))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_they_own_exile_cards ::= "they" "own" value "or" "more" exile_counter_population

/* An opponent's cast history retains the quantified player in the event. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:EventHistory{event:Spell{event:Cast, players:One(Bound(0)), spells:$opponent_cast_spell_filter}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}} */
condition_opponent_cast_filtered_spell ::= "an" "opponent" "cast" "a" opponent_cast_spell_filter "spell" "this" "turn"

opponent_cast_spell_filter ::= adjective_color | filter_phrase | damage_source_color_pair

/* Both historical predicates share the explicitly written turn window. */
/* @sem Condition::AnyOf(@unordered([$graveyard_cast_history, $graveyard_activation_history])) */
condition_graveyard_cast_or_activation ::= graveyard_cast_history "or" graveyard_activation_history "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:Cast{from:Players{zone:Graveyard, players:All}}}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
graveyard_cast_history ::= "you've" "cast" "a" "spell" "from" "a" "graveyard"

/* @sem Condition::PlayerDid{player:AbilityController, event:ActivatedGraveyardAbility, window:ThisTurn} */
graveyard_activation_history ::= "activated" "an" "ability" "of" "a" "card" "in" "a" "graveyard"

/* A player-history condition composes with the played card's filter. */
/* @sem Condition::Not(PlayerDid{player:AbilityController, event:$played_from_exile_history, window:ThisTurn}) */
condition_no_play_from_exile_this_turn ::= "you" "didn't" played_from_exile_history "this" "turn"

/* A condition governs the complete combat cap, retaining its defender and count. */
/* @sem Ability::Conditional{condition:$condition, then:[$static_combat_cap]} */
conditional_combat_cap ::= "as" "long" "as" condition "," static_combat_cap

/* A negative past predicate keeps the named object independent of the predicate. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Not($negated_past_object_predicate)} */
condition_object_wasnt_predicate ::= object_ref "wasn't" negated_past_object_predicate

negated_past_object_predicate ::= past_object_predicate | past_object_quality | past_sacrificed_history | tap_event_singular_a

/* @sem ObjectFilter::History{event:Sacrificed, window:ThisTurn} */
past_sacrificed_history ::= "sacrificed"

/* One opponent is bound throughout the counted population. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(Bound(0))))}), test:NumberTest::Compare{comparison:$bound_words, value:$count}}} */
condition_opponent_controls_count ::= "an" "opponent" "controls" count bound_words filter_plural

/* The empty hand belongs to the same existentially bound opponent. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}} */
condition_opponent_hand_empty ::= "an" "opponent" "has" "no" "cards" "in" "hand"

/* The enlisted object filter and the subject of its history remain independent. */
/* @sem ObjectFilter::History{event:Enlisted($filter_phrase), window:ThisCombat} */
object_enlisted_combat ::= "enlisted" "a" filter_phrase "this" "combat"

/* A casting requirement compares the announced X with a literal threshold. */
/* @sem NumberTest::Compare{comparison:NotEqual, value:$number_digits} */
announced_number_exclusion ::= "can't" "be" number_digits

/* @sem Condition::Compare{left:Expr::AnnouncedX, test:$announced_number_exclusion} */
announced_x_restriction ::= "x" announced_number_exclusion

/* @sem Ability::Casting(Require($announced_x_restriction)) */
casting_announced_x_requirement ::= announced_x_restriction "."

/* A controller's completed history retains its event and current-turn window. */
/* @sem Condition::PlayerDid{player:AbilityController, event:$controller_history_event, window:ThisTurn} */
condition_controller_history_this_turn ::= "you've" controller_history_event "this" "turn"

controller_history_event ::= history_paid_or_lost_energy | history_cycled_cards

/* @sem PlayerHistory::PaidOrLostEnergy(GreaterOrEqual, $value) */
history_paid_or_lost_energy ::= "paid" "or" "lost" value "or" "more" "{" "E" "}"

/* @sem PlayerHistory::Cycled(GreaterOrEqual, $value, Any) */
history_cycled_cards ::= "cycled" value "or" "more" "cards"

/* A casting limit on announced X compared with a battlefield population. */
/* @sem Condition::Compare{left:AnnouncedX, test:NumberTest::Compare{comparison:LessOrEqual, value:$value_number_of}} */
condition_announced_x_count_limit ::= "x" "can't" "be" "greater" "than" value_number_of

/* @sem Ability::Casting(Require($condition_announced_x_count_limit)) */
casting_announced_x_count_limit ::= condition_announced_x_count_limit "."

/* @sem ObjectFilter::History{event:AttackedDefender($filter_phrase), window:ThisTurn} */
object_attacked_defender_turn ::= "attacked" "a" filter_phrase "this" "turn"

/* The drafted name is a literal operand, independent of the ability holder. */
/* @sem Condition::NotedForDraft{player:AbilityController, note:_{kind:Guessed, player:AbilityController, card:$draft_guessed_card_name}} */
condition_you_guessed_named_card ::= "you" "guessed" "correctly" "for" "a" "card" "named" draft_guessed_card_name

draft_guessed_card_name ::= draft_guessed_self_name | referenced_card_name

/* @sem String::@card_name */
draft_guessed_self_name ::= SELF_NAME

/* Player history, its negation and its time window remain independent operands. */
/* @sem Condition::Not(Condition::PlayerDid{player:AbilityController, event:$you_past_history, window:$your_history_window}) */
condition_you_havent_history ::= "you" "haven't" you_past_history your_history_window

you_past_history ::= you_past_dealt_combat_damage | you_past_monarch

/* @sem PlayerHistory::WasDealtCombatDamage */
you_past_dealt_combat_damage ::= "been" "dealt" "combat" "damage"

/* @sem PlayerHistory::WasMonarch */
you_past_monarch ::= "been" "the" "monarch"

your_history_window ::= your_history_since_last_turn | bound_attack_this_turn

/* @sem HistoryWindow::SinceLastTurnOf(PlayerRef::AbilityController) */
your_history_since_last_turn ::= "since" "your" "last" "turn"

/* An unqualified counter threshold counts all counter kinds on the object. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Counters(_{comparison:GreaterOrEqual, value:$value})} */
/* @prefer always */
condition_any_counters_at_least ::= object_ref "has" value "or" "more" "counters" "on" "it"

/* @sem Condition::Window(Upkeep) */
window_any_upkeep_step ::= "during" "any" "upkeep" "step"

/* An announced X is bounded by a separately described quantity. */
/* @sem Ability::Casting(Require(Compare{left:$blocked_target_x, test:NumberTest::Compare{comparison:$casting_forbidden_bound, value:$casting_bound_value}})) */
casting_x_forbidden_bound ::= blocked_target_x "can't" "be" casting_forbidden_bound casting_bound_value "."

casting_forbidden_bound ::= casting_not_greater | casting_not_less | casting_not_greater_equal | casting_not_less_equal

/* @sem Comparison::LessOrEqual */
casting_not_greater ::= "greater" "than"

/* @sem Comparison::GreaterOrEqual */
casting_not_less ::= "less" "than"

/* @sem Comparison::Less */
casting_not_greater_equal ::= "greater" "than" "or" "equal" "to"

/* @sem Comparison::Greater */
casting_not_less_equal ::= "less" "than" "or" "equal" "to"

casting_bound_value ::= casting_count_players | value_opponents | value_constant

/* @sem Expr::CountPlayers(All) */
casting_count_players ::= "the" "number" "of" "players" "in" "the" "game"

/* @sem Condition::Window(EndOfCombatStep) */
activation_window_end_of_combat ::= "the" "end" "of" "combat" "step"

/* @sem ObjectFilter::State(Bargained) */
state_bargained ::= "bargained"

/* The counted card filter and the referenced card are independent operands. */
/* @sem Condition::GraveyardPosition{card:$object_ref, player:AbilityController, above:$graveyard_counted_cards, comparison:GreaterOrEqual, amount:$value} */
condition_graveyard_position_above ::= value "or" "more" graveyard_counted_cards "are" "above" object_ref

/* @sem Condition::Window(ExtraTurn) */
window_extra_turns ::= "during" "extra" "turns"

/* @sem Condition::Window(FirstCombat) */
window_first_combat_phase ::= "during" "the" "first" "combat" "phase" "of" "the" "turn"

/* @sem Condition::Window(MainPhase) */
window_main_phase ::= "during" "a" "main" "phase"

/* The attacker filter is shared independently of the history condition. */
/* @sem ObjectFilter::AllOf([$filter_phrase, ControlledBy(One(AbilityController))]) */
history_attacker_you_controlled_an ::= "an" filter_phrase "you" "controlled"

/* @sem Condition::PlayerDid{player:EventSubject, event:AttackedBy($history_attacker_you_controlled_an), window:ThisTurn} */
condition_event_subject_attacked_history ::= "they" "were" "attacked" "this" "turn" "by" history_attacker_you_controlled_an

/* The history actor and the owner of the last turn are the same bound player. */
/* @sem Condition::ExistsPlayer{players:$event_player, binding:0, condition:$bound_player_last_turn_history} */
condition_player_last_turn_history ::= event_player bound_player_last_turn_history

/* @sem Condition::PlayerDid{player:Bound(0), event:$player_history_action, window:LastTurnOf(Bound(0))} */
bound_player_last_turn_history ::= player_history_action "during" "their" "last" "turn"

/* @sem PlayerHistory::AttackedPlayer($condition_player) */
player_history_action ::= "attacked" condition_player

/* The window is the ability controller’s own most recent completed turn. */
/* @sem Condition::PlayerDid{player:AbilityController, event:$historical_entry_under_your_control, window:LastTurnOf(AbilityController)} */
condition_you_had_entry_last_turn ::= "you" "had" historical_entry_under_your_control "last" "turn"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:Counters(_{kind:$counter_kind, comparison:Equal, value:Constant(0)})} */
condition_object_has_no_named_counters ::= object_ref "has" "no" counter_kind "counters" "on" "it"

/* Keep the condition in the same scope as references in the retrigger clause. */
/* @sem Ability::Conditional{condition:$condition, then:[$additional_trigger_for_population]} */
conditional_additional_trigger ::= "as" "long" "as" condition "," additional_trigger_for_population

/* Turn windows used by conditional casting costs. */
casting_cost_turn ::= casting_cost_other_turns | cast_window_your_turn

/* @sem Condition::ExistsPlayer{players:OthersThan(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))} */
casting_cost_other_turns ::= "turns" "other" "than" "yours"

/* The controller is independent of the population used for the extreme. */
/* @sem Condition::Controls{player:$condition_control_subject, filter:$battlefield_greatest_mana_tied, minimum:1} */
condition_control_the_extreme ::= condition_control_subject "the" battlefield_greatest_mana_tied

/* A retriggered ability's holder is independent of the condition's population. */
/* @sem ObjectFilter::@and($retrigger_holder, ObjectFilter::ControlledBy(One(AbilityController))) */
conditional_retrigger_holder ::= retrigger_holder "you" "control"

/* The while-clause applies to the retrigger rule, not to its holder filter. */
/* @sem Ability::Conditional{condition:$condition, then:[TriggerRule{abilities:AbilityOf($conditional_retrigger_holder), rule:TriggersAgain}]} */
conditional_retrigger ::= "if" "a" "triggered" "ability" "of" conditional_retrigger_holder "triggers" "while" condition "," "that" "ability" "triggers" "an" "additional" "time" "."

/* A disjunction of independent historical origins for the same object. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:AnyOf([$past_origin_filter, $past_origin_filter_2])} */
condition_object_past_origin_alternative ::= object_ref past_origin_filter "or" past_origin_filter

past_origin_filter ::= past_entered_from_player_zone | past_cast_from_player_zone | past_entered_from_any_player_zone | past_controller_cast_from_any_player_zone

/* @sem ObjectFilter::EnteredFrom(Players{zone:$greatest_card_zone, players:One($zone_owner)}) */
past_entered_from_player_zone ::= "entered" "from" zone_owner greatest_card_zone

/* @sem ObjectFilter::Cast{from:Players{zone:$greatest_card_zone, players:One($zone_owner)}} */
past_cast_from_player_zone ::= "was" "cast" "from" zone_owner greatest_card_zone

/* The named object also supplies the antecedent of a following reference. */
/* @sem Condition::ObjectMatches{object:@remember_object($object_ref), filter:Not($condition_supertype)} */
condition_object_not_supertype ::= object_ref "isn't" condition_supertype

/* @sem Condition::PlayerDid{player:Bound(0), event:$bound_attack_event, window:$bound_attack_window} */
bound_player_attack_history ::= bound_attack_event bound_attack_window

/* @sem HistoryWindow::LastTurnOf(Bound(0)) */
bound_attack_last_turn ::= "during" "their" "last" "turn"

/* @sem HistoryWindow::ThisTurn */
bound_attack_this_turn ::= "this" "turn"

bound_attack_window ::= bound_attack_last_turn | bound_attack_this_turn

/* A threshold over the current attacking subset of a population. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:$affected, filter:Attacking}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_attacking_threshold ::= value "or" "more" affected "are" "attacking"

/* Both the step and the attacked-player condition restrict the same ability. */
/* @sem Condition::AllOf([Window(DeclareAttackers), PlayerState{player:AbilityController, state:BeingAttacked}]) */
window_attacked_declare_attackers ::= "during" "the" "declare" "attackers" "step" "and" "only" "if" "you've" "been" "attacked" "this" "step"

/* The controller and the owner of the counted graveyard are the same player. */
/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One($its_controller)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_controller_graveyard_at_least ::= its_controller "has" value "or" "more" "cards" "in" "their" "graveyard"

/* @sem Condition::Controls{player:$defending_player, filter:$noun, minimum:1} */
condition_defending_controls_an ::= defending_player "controls" "an" noun

scalar_last_turn_history ::= scalar_attacked_your_last_turn | scalar_blocked_your_last_turn | scalar_attacked_controller_last_turn | scalar_blocked_controller_last_turn

/* @sem ObjectFilter::History{event:Attacked, window:LastTurnOf(AbilityController)} */
scalar_attacked_your_last_turn ::= "attacked" "during" "your" "last" "turn"

/* @sem ObjectFilter::History{event:Blocked, window:LastTurnOf(AbilityController)} */
scalar_blocked_your_last_turn ::= "blocked" "during" "your" "last" "turn"

/* @sem ObjectFilter::History{event:Attacked, window:LastTurnOf(ControllerOf(Candidate))} */
scalar_attacked_controller_last_turn ::= "attacked" "during" "its" "controller's" "last" "turn"

/* @sem ObjectFilter::History{event:Blocked, window:LastTurnOf(ControllerOf(Candidate))} */
scalar_blocked_controller_last_turn ::= "blocked" "during" "its" "controller's" "last" "turn"

/* A singular controlled permanent with a named vowel-initial counter. */
/* @sem Condition::Controls{player:$condition_control_subject, filter:AllOf([$counter_condition_noun, Counters(_{kind:$counter_kind_vowel, comparison:Greater, value:Constant(0)})]), minimum:1} */
condition_control_counter_an ::= condition_control_subject "a" counter_condition_noun "with" "an" counter_kind_vowel "counter" "on" "it"

counter_kind_vowel ::= cn_acorn | cn_age | cn_oil | cn_omen | cn_ore

counter_condition_noun ::= noun_permanent | noun_creature

/* A color shared with any color tied for the largest population count. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:SharesMostCommonColor($affected)} */
condition_shares_most_common_color ::= object_ref "shares" "a" "color" "with" "the" "most" "common" "color" "among" affected "or" "a" "color" "tied" "for" "most" "common"

/* The test and card filter are shared with other zone-count conditions. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$graveyard_filtered_cards}), test:$condition_at_least} */
condition_hand_filtered_threshold ::= "you" "have" condition_at_least graveyard_filtered_cards "in" "your" "hand"

/* @sem Condition::ExistsPlayer{players:All, binding:0, condition:Controls{player:Bound(0), filter:$filter_phrase, minimum:1}} */
condition_any_player_controls ::= "any" "player" "controls" "a" filter_phrase

/* The library belongs to the quantified player; its count and threshold are
   separate operands so other comparisons can share the same subject. */
/* @sem Condition::ExistsPlayer{players:All, binding:0, condition:Compare{left:$bound_library_count, test:$library_size_test}} */
condition_any_library_size ::= bound_library_count "has" library_size_test "cards" "in" "it"

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}) */
bound_library_count ::= "a" "library"

library_size_test ::= condition_at_least | library_size_at_most

/* @sem NumberTest::Compare{comparison:LessOrEqual, value:$value} */
library_size_at_most ::= value "or" "fewer"

/* The attacking object's controller is recorded at the attack event. */
/* @sem Condition::Compare{left:EventHistory{event:Object{event:Attacks, objects:AllOf([Subtype(Spacecraft), ControlledBy(One(AbilityController))])}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_attacked_with_spacecraft ::= "you" "attacked" "with" "a" "Spacecraft" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:@and($filter_phrase, ObjectFilter::OwnedBy(One(AbilityController))), from:Battlefield, to:Hand}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_owned_hand_from_battlefield ::= ("a" | "an") filter_phrase "was" "put" "into" "your" "hand" "from" "the" "battlefield" "this" "turn"

/* Count attacking permanents independently of who they attack. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Attacking])}), test:NumberTest::Compare{comparison:Equal, value:Constant(1)}} */
condition_exactly_one_attacking ::= "exactly" "one" filter_phrase "is" "attacking"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$counted_plural, Attacking])}), test:NumberTest::Compare{comparison:Equal, value:$count_plural}} */
condition_exactly_many_attacking ::= "exactly" count_plural counted_plural "are" "attacking"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:ControlledBy(One(AbilityController))} */
condition_you_control_object ::= "you" "control" object_ref

/* This condition counts cards in the ability controller’s library. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
/* @prefer always */
condition_your_library_empty ::= "your" "library" "has" "no" "cards" "in" "it"

/* The previously announced player-or-planeswalker target supplies either the
   player or the planeswalker's controller. */
/* @sem Condition::Compare{left:PlayerNumber{player:PlayerOrControllerOf(Targets(0)), number:Life}, test:NumberTest::Compare{comparison:$target_life_comparison, value:PlayerNumber{player:AbilityController, number:Life}}} */
condition_target_player_or_walker_life ::= "that" "player" "or" "that" "planeswalker's" "controller" "has" target_life_comparison "life" "than" "you"

/* @sem Comparison::Less */
target_life_less ::= "less"

target_life_comparison ::= hand_count_more | target_life_less

/* The source exclusion belongs only to the first alternative. */
/* @sem Condition::Controls{player:$condition_control_subject, filter:AnyOf([AllOf([Not(SameObject(Source)), $filter_phrase]), $filter_phrase_2]), minimum:1} */
condition_control_another_or_an ::= condition_control_subject "another" filter_phrase "or" "an" filter_phrase

/* Count the recorded arrivals, keeping the event and threshold independent. */
/* @sem Condition::Compare{left:EventHistory{event:$owned_cards_elsewhere_event, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_owned_cards_elsewhere_threshold ::= value "or" "more" owned_cards_elsewhere_event "this" "turn"

/* Count the matching cards across all players’ graveyards. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$filter_phrase}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_all_graveyards_filtered_size ::= "there" "are" value "or" "more" filter_phrase "cards" "total" "in" "all" "graveyards"

/* The negation applies to the occurrence count for the written ability filter. */
/* @sem Condition::Not(Compare{left:EventHistory{event:Activated{players:One(AbilityController), abilities:$activated_ability_object}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
condition_no_activation_this_turn ::= "you" "didn't" "activate" activated_ability_object "this" "turn"

/* This restriction names the same card that holds the activation. */
/* @sem ActivationLimits::ActivationLimits{condition:ObjectMatches{object:$self_ref_holder, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}} */
limit_self_in_your_graveyard ::= "activate" "only" "if" self_ref_holder "is" "in" "your" "graveyard"

/* @sem Condition::Controls{player:$condition_control_subject, filter:AllOf([$filter_phrase, Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$value})]), minimum:1} */
condition_control_counter_threshold ::= condition_control_subject "a" filter_phrase "with" value "or" "more" counter_kind "counters" "on" "it"

/* The player bound by this state condition owns the counted graveyard. */
/* @sem Condition::ExistsPlayer{players:One(AbilityController), binding:0, condition:Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:$graveyard_counted_cards}), test:$graveyard_state_test}} */
condition_existential_graveyard_count ::= "there" "are" graveyard_state_test graveyard_counted_cards "in" "your" "graveyard"

graveyard_state_test ::= library_zero_test | graveyard_state_at_least

/* @sem NumberTest::Compare{comparison:GreaterOrEqual, value:$count} */
graveyard_state_at_least ::= count "or" "more"

/* An individual opponent supplies the controller binding for this predicate. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Controls{player:Bound(0), filter:$filter_phrase, minimum:1}} */
condition_opponent_controls_an ::= "an" "opponent" "controls" "an" filter_phrase

/* An opponent of the ability controller controls a matching permanent. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Controls{player:Bound(0), filter:$filter_phrase, minimum:1}} */
condition_opponent_controls_a ::= "an" "opponent" "controls" "a" filter_phrase

/* A historical entry shares the event predicate independently of its time window. */
/* @sem Condition::Compare{left:EventHistory{event:$historical_you_had_entry, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_you_had_entry_this_turn ::= historical_you_had_entry "this" "turn"

/* The antecedent is the one card moved by the enclosing top-card exile. */
/* @sem Condition::ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$filter_phrase} */
condition_exiled_top_card_type ::= "that" "card" "is" "a" filter_phrase "card"

/* A player owns at least the stated number of cards in the shared exile zone. */
/* @sem Condition::ExistsPlayer{players:$event_player, binding:0, condition:Compare{left:CountObjects(Matching{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:Any}), filter:OwnedBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$owned_exile_card_count}}} */
condition_player_owns_exiled_cards ::= event_player "owns" owned_exile_card_count "in" "exile"

owned_exile_card_count ::= card_count_one | card_count_many

/* Exact hand size belongs to the controller of the ability. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:$exact_hand_location, players:One(AbilityController)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Equal, value:$exact_hand_plural_count}} */
condition_exact_hand_cards ::= "you" "have" "exactly" exact_hand_plural_count "cards" exact_hand_location

exact_hand_plural_count ::= count_plural | number_x

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:$exact_hand_location, players:One(AbilityController)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Equal, value:Constant(1)}} */
condition_exact_hand_card ::= "you" "have" "exactly" "one" "card" exact_hand_location

/* The count belongs to the ability controller, independently of the Ring-bearer. */
/* @sem Condition::Compare{left:PlayerNumber{player:AbilityController, number:RingTemptations}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_ring_temptations_at_least ::= "the" "Ring" "has" "tempted" "you" value "or" "more" "times" "this" "game"

/* Bind the same player across the population and the historical predicate. */
/* @sem Condition::ExistsPlayer{players:$event_player, binding:0, condition:$bound_discard_history} */
condition_existential_discard_history ::= event_player bound_discard_history

/* @sem Condition::Compare{left:EventHistory{event:$bound_discard_event, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$card_count}} */
bound_discard_history ::= bound_discard_event card_count "this" "turn"

/* Two independently named permanent alternatives retain the controlling player. */
/* @sem Condition::AnyOf([Controls{player:$condition_control_subject, filter:Name($referenced_card_name), minimum:1}, Controls{player:$condition_control_subject, filter:Name($referenced_card_name_2), minimum:1}]) */
condition_control_either_named_permanent ::= condition_control_subject "a" "permanent" "named" referenced_card_name "or" "a" "permanent" "named" referenced_card_name

/* A zero count over the controller's graveyard, with an optional card filter. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$graveyard_counted_cards}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_graveyard_no_cards ::= "there" "are" "no" graveyard_counted_cards "in" "your" "graveyard"

/* Poisoned means having at least one poison counter. */
/* @sem Condition::Compare{left:CountCounters(_{recipients:Players(One($defending_player)), kind:Named(PoisonCounter), information:CurrentOrLastKnown}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
condition_player_poisoned ::= defending_player "is" "poisoned"

/* A casting requirement composes with the condition's own player and history scope. */
/* @sem Ability::Casting(Require($condition)) */
casting_self_unless_condition ::= "you" "can't" "cast" SELF_NAME "unless" condition "."

/* A turn window and a separate condition both constrain the same ability. */
/* @sem Condition::AllOf([$window_your_turn, $condition]) */
window_turn_as_long_as ::= window_your_turn "," "as" "long" "as" condition

/* The battlefield predicate composes with the referenced object. */
/* @sem ObjectFilter::InZone(Shared(Battlefield)) */
condition_on_battlefield ::= "on" "the" "battlefield"

/* A targeted permanent population retains its complete printed filter. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$condition_targeting_filter} */
condition_targets_population ::= object_ref "targets" condition_targeting_filter

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController)), Chosen(CardName)])} */
condition_targeted_population ::= filter_phrase "you" "control" "with" "the" "chosen" "name"

/* The as-cast alternatives describe the same referenced spell or permanent. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$as_cast_reveal_or_control} */
condition_as_cast_reveal_or_control ::= as_cast_reveal_or_control "as" "you" "cast" object_ref

/* @sem ObjectFilter::AnyOf([Condition(AsCast{player:AbilityController, action:Revealed($filter_phrase)}), Condition(AsCast{player:AbilityController, action:Controlled(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase_2})})]) */
as_cast_reveal_or_control ::= "you" "revealed" "a" filter_phrase "card" "or" "controlled" "a" filter_phrase

/* An announced X is fixed by the counted population at casting time. */
/* @sem Ability::Casting(Require(Compare{left:AnnouncedX, test:NumberTest::Compare{comparison:Equal, value:$value_opponent_graveyard_union}})) */
casting_x_counted_cards ::= "x" "is" value_opponent_graveyard_union "as" "you" "cast" "this" "spell" "."

/* Count the cards linked to the stated object, independently of the consequence. */
/* @sem Condition::Compare{left:CountObjects($permission_linked_exile_cards), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_linked_exile_threshold ::= "there" "are" value "or" "more" permission_linked_exile_cards

/* The stack object and its sole target's kind remain independent operands. */
/* @sem Condition::ObjectMatches{object:@remember_object($condition_stack_target), filter:$sole_target_kind_filter} */
condition_single_target_matches ::= condition_stack_target sole_target_kind_filter

/* @sem ObjectFilter::AllOf([OnStack(SingleTarget), TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}))]) */
sole_target_kind_filter ::= "has" "only" "one" "target" "and" "that" "target" "is" "a" filter_phrase

/* @sem Condition::Controls{player:AbilityController, filter:@and($filter_phrase, $modifier_counter_threshold_on_it), minimum:1} */
condition_controlled_counter_threshold ::= "you" "control" "a" filter_phrase modifier_counter_threshold_on_it

/* @sem Condition::Not(Condition::Controls{player:$condition_control_subject, filter:AllOf([State(Suspected), $filter_plural]), minimum:1}) */
condition_control_no_suspected ::= condition_control_subject "no" "suspected" filter_plural

/* This possessive is used only after an explicit source event. */
/* @sem Condition::ObjectMatches{object:Source, filter:Property{property:$stat, test:NumberTest::Compare{comparison:$bound, value:$number}}} */
condition_source_stat_bounded ::= "its" stat "is" number "or" bound

/* Counter predicate for a previously established singular object. */
/* @sem ObjectFilter::Counters{kind:$counter_kind, comparison:LessOrEqual, value:$value} */
scalar_counter_test ::= "has" value "or" "fewer" counter_kind "counters" "on" "it"

/* A singular card existence test retains its filter and graveyard owner. */
/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}, kind:Card, filter:$filter_phrase}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_singular_filtered_card_in_graveyard ::= ("a" | "an") filter_phrase "card" "is" "in" "your" "graveyard"

/* The bound opponent owns the cards whose graveyard arrivals are counted. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:EventHistory{event:ZoneChange{objects:OwnedBy(One(Bound(0))), to:Graveyard}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}} */
condition_opponent_owned_graveyard_arrivals ::= "an" "opponent" "had" value "or" "more" "cards" "put" "into" "their" "graveyard" "from" "anywhere" "this" "turn"

/* The controller has not activated an exhaust ability in the current turn. */
/* @sem Condition::Not(PlayerDid{player:AbilityController, event:ActivatedExhaust, window:ThisTurn}) */
condition_no_exhaust_activation ::= "you" "haven't" "activated" "an" "exhaust" "ability" "this" "turn"

/* The target's filter remains a reusable noun phrase. */
/* @sem Condition::TargetsMatch(_{object:$object_ref, kind:Permanent, filter:$filter_controller_graveyard}) */
condition_targets_permanent ::= object_ref "targets" "a" filter_controller_graveyard

/* The subject of the condition can be referenced by the following clause. */
/* @sem Condition::ObjectMatches{object:@remember_object($object_ref), filter:InZone(Shared(Battlefield))} */
condition_object_on_battlefield ::= object_ref "is" "on" "the" "battlefield"

/* Counts distinct permanent sources that dealt damage to the ability controller. */
/* @sem Condition::Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:$filter_plural, recipients:Players(One(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:DistinctSources}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_damage_distinct_sources_this_turn ::= "you've" "been" "dealt" "damage" "by" value "or" "more" filter_plural "this" "turn"

/* A source condition proves both zones in which this trigger can function. */
/* @sem Condition::AnyOf([ObjectMatches{object:$self_explicit_ref, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}, ObjectMatches{object:$self_explicit_ref, filter:InZone(Shared(Battlefield))}]) */
source_in_graveyard_or_battlefield ::= self_explicit_ref "is" "in" "your" "graveyard" "or" "on" "the" "battlefield"

/* Compare two live properties of the same explicitly named host. */
/* @sem Condition::ObjectMatches{object:$condition_property_equipped, filter:ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:$stat_comparison, value:Expr::ObjectProperty{object:$condition_property_equipped, property:$stat_2, information:CurrentOrLastKnown}}}} */
condition_equipped_stat_comparison ::= condition_property_equipped stat "is" stat_comparison "its" stat

/* The possessive establishes the equipped creature as the following pronoun. */
/* @sem ObjectRef::@remember_operand(ObjectRef::AttachedTo(Source)) */
condition_property_equipped ::= "equipped" "creature's"

/* @sem Condition::Controls{player:AbilityController, filter:$counter_attacked_filter, minimum:1} */
condition_you_control_counter_attacked ::= "you" "control" counter_attacked_filter

/* @sem @and($counter_attack_filter, ObjectFilter::Condition(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}})) */
counter_attacked_filter ::= counter_amount counter_attack_filter "that" "attacked" "this" "turn"

/* Each name identifies a separately controlled member of the same population. */
/* @sem Condition::AllOf([Controls{player:$condition_control_subject, filter:AllOf([$filter_plural, Name($referenced_card_name)]), minimum:1}, Controls{player:$condition_control_subject, filter:AllOf([$filter_plural, Name($referenced_card_name_2)]), minimum:1}]) */
condition_control_named_pair ::= condition_control_subject filter_plural "named" referenced_card_name "and" referenced_card_name

/* @sem Condition::PlayerDid{player:AbilityController, event:RolledDie([Equal, $value]), window:ThisTurn} */
condition_you_rolled_value_this_turn ::= "you've" "rolled" "a" value "this" "turn"

/* This program is used only inside the single-discard activation above: component
   zero is the paid discard, and the test refers to its performed receipt. */
/* @sem Program::Program{instructions:[If{condition:Compare{left:CountObjects(Matching{objects:CostObjects{payment:Activation, component:[0], view:Performed, phase:After}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:$program, otherwise:_{}}]} */
discard_receipt_program ::= "if" "the" "discarded" "card" "was" "a" filter_phrase "card" "," program

/* Two explicitly stated hand-size alternatives share the same player and zone. */
/* @sem Condition::AnyOf([Compare{left:CountObjects(Zone(_{scope:Players{zone:Hand, players:One($condition_you)}, kind:Card, filter:Any})), test:NumberTest::Compare{comparison:Equal, value:$hand_size_alternative}}, Compare{left:CountObjects(Zone(_{scope:Players{zone:Hand, players:One($condition_you)}, kind:Card, filter:Any})), test:NumberTest::Compare{comparison:Equal, value:$hand_size_card_count}}]) */
condition_hand_exact_alternatives ::= condition_you "have" "exactly" hand_size_alternative "or" hand_size_card_count "in" "hand"

hand_size_alternative ::= hand_size_zero | count

/* @sem Expr::Constant(0) */
hand_size_zero ::= "zero"

hand_size_card_count ::= card_count_one | card_count_many

/* The fixed graveyard query also anchors a subsequent reference to that card. */
/* @sem Condition::ObjectMatches{object:Query{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}), index:0}, filter:$card_filter} */
condition_top_your_graveyard_kind ::= "the" "top" "card" "of" "your" "graveyard" "is" "a" card_filter "card"

/* Count battlefield permanents matching the stated blocking population. */
blocking_count_condition ::= blocking_count_one | blocking_count_plural

/* @sem Condition::Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, filter:BlockingObject($object_ref)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
blocking_count_one ::= "at" "least" "one" filter_phrase "is" "blocking" object_ref

/* @sem Condition::Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, filter:BlockingObject($object_ref)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count_plural}} */
blocking_count_plural ::= "at" "least" count_plural filter_plural "are" "blocking" object_ref

/* @sem Expr::LargestSharedGroup{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}, property:Names} */
control_shared_names_short ::= filter_plural "with" "the" "same" "name"

/* The short spelling belongs to this activation limit. */
/* @sem Condition::Compare{left:$control_shared_names_short, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
window_if_shared_names ::= "if" "you" "control" value "or" "more" control_shared_names_short

/* Threshold and population are independent typed operands. */
/* @sem Condition::Compare{left:$threshold_player_measure, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_player_threshold_shared ::= value "or" "more" threshold_player_measure

threshold_player_measure ::= threshold_highest_opponents | threshold_lost_players

/* @sem Expr::CountPlayers(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:PlayerState{player:Bound(0), state:RolledHighest}}])) */
threshold_highest_opponents ::= "opponents" "had" "the" "highest" "result"

/* @sem Expr::Game(PlayersWhoLost) */
threshold_lost_players ::= "players" "have" "lost" "the" "game"

/* The comparison retains the controlled filter on both sides. */
/* @sem Condition::Compare{left:PlayerNumber{player:AbilityController, number:Permanents($filter_plural)}, test:NumberTest::Compare{comparison:Less, value:AmongPlayers{players:$fewer_opponent_phrase, number:Permanents($filter_plural), aggregation:Minimum}}} */
condition_control_fewer_shared ::= "you" "control" "fewer" filter_plural "than" fewer_opponent_phrase

/* Possessive predicates retain the subject independently of their operands. */
/* @sem Condition::ObjectMatches{object:$condition_property_subject, filter:ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:Equal, value:$value}}} */
condition_property_exact ::= condition_property_subject stat "is" "exactly" value

/* @sem ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:$stat_comparison, value:Expr::@in_filter($value)}} */
condition_stat_comparison_filter ::= stat "is" stat_comparison value

/* @sem Condition::ObjectMatches{object:$condition_property_subject, filter:ObjectFilter::AnyOf([$condition_stat_comparison_filter, $condition_stat_comparison_filter_2])} */
condition_property_either ::= condition_property_subject condition_stat_comparison_filter "or" "its" condition_stat_comparison_filter

/* @sem Condition::ObjectMatches{object:$condition_property_subject, filter:$condition_base_change} */
condition_possessive_base_change ::= condition_property_subject condition_base_change

/* @sem ObjectFilter::State(PowerDiffersFromBase) */
condition_base_change ::= "power" "was" "different" "from" "its" "base" "power"

/* @sem Condition::ObjectMatches{object:$condition_property_subject, filter:ObjectFilter::State(CostPaid($condition_alternative_cost_name))} */
condition_possessive_cost_paid ::= condition_property_subject condition_alternative_cost_name "cost" "was" "paid"

condition_alternative_cost_name ::= mechanic_prowl_name | mechanic_spectacle_name | condition_surge_name | discard_madness | condition_additional_cost_name

/* The opponent is quantified once for the entire cast threshold. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:EventHistory{event:Spell{event:Cast, players:One(Bound(0)), spells:Any}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}} */
casting_opponent_spell_threshold ::= "an" "opponent" "cast" value "or" "more" "spells" "this" "turn"

/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:EventHistory{event:Spell{event:Cast, players:One(Bound(0)), spells:$casting_colored_instant_sorcery}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}} */
casting_opponent_filtered_history ::= "an" "opponent" "cast" "a" casting_colored_instant_sorcery "spell" "this" "turn"

/* @sem ObjectFilter::AllOf([$adjective_color, AnyOf([CardType(Instant), CardType(Sorcery)])]) */
casting_colored_instant_sorcery ::= adjective_color "instant" "or" "sorcery"

/* @sem Condition::Not(Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:Any}, window:ThisGame, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
casting_first_spell_game ::= "this" "spell" "is" "the" "first" "spell" "you've" "cast" "this" "game"

/* Two independent observations made by the caster at casting time. */
/* @sem Condition::AnyOf([AsCast{player:AbilityController, action:Revealed($filter_phrase)}, AsCast{player:AbilityController, action:Controlled(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase_2})}]) */
condition_revealed_or_controlled_as_cast ::= "you" "revealed" "a" filter_phrase "card" "or" "controlled" "a" filter_phrase "as" "you" "cast" self_spell

/* Each subject carries its own history test, allowing a shared verb phrase. */
/* @sem Condition::Compare{left:EventHistory{event:Object{event:Attacks, objects:$filter_phrase}, window:ThisCombat, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_attack_subject ::= "a" filter_phrase

/* @sem @and($condition_attack_subject, $condition_attack_subject_2) */
condition_attack_subject_pair ::= condition_attack_subject "and" condition_attack_subject "attacked" "this" "combat"

/* @sem $condition_attack_subject */
condition_attack_subject_single ::= condition_attack_subject "attacked" "this" "combat"

/* The quantity is the controller’s current unspent mana. */
/* @sem Condition::Compare{left:PlayerNumber{player:AbilityController, number:UnspentMana}, test:Compare{comparison:GreaterOrEqual, value:$number_words}} */
condition_unspent_mana_at_least ::= "you" "have" number_words "or" "more" "unspent" "mana"

/* Both past life events happened to the ability controller this turn. */
/* @sem Condition::AllOf([Compare{left:EventHistory{event:Player{event:$life_event_past, players:One(AbilityController)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, Compare{left:EventHistory{event:Player{event:$life_event_past_2, players:One(AbilityController)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}]) */
condition_both_life_events_this_turn ::= "you" life_event_past "and" life_event_past "life" "this" "turn"

/* The object and the duration are separate operands of the control condition. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$control_history_filter} */
condition_controlled_since ::= "you've" "controlled" object_ref control_history_filter

/* @sem ObjectFilter::State(ControlledSinceMostRecentTurn) */
control_history_filter ::= "continuously" "since" "the" "beginning" "of" "your" "most" "recent" "turn"

/* The cast subject and timing remain independently typed. */
/* @sem Condition::ObjectMatches{object:$cast_it, filter:@and(ObjectFilter::Cast{by:One(AbilityController)}, $cast_window_filter)} */
condition_cast_in_window ::= "you" "cast" cast_it cast_window_filter

/* @sem ObjectFilter::State(CastDuringOwnMainPhase) */
cast_window_filter ::= "during" "your" "main" "phase"

/* A reusable card population keeps its filter and graveyard owner in the query. */
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$graveyard_counted_cards} */
graveyard_cards_owned_by_controller ::= graveyard_counted_cards "in" "your" "graveyard"

/* @sem NumberTest::Compare{comparison:Less, value:$value} */
graveyard_fewer_bound ::= "fewer" "than" value

/* @sem Condition::Compare{left:CountObjects($graveyard_cards_owned_by_controller), test:$graveyard_fewer_bound} */
condition_graveyard_fewer_than ::= "there" "are" graveyard_fewer_bound graveyard_cards_owned_by_controller

/* @sem Condition::Compare{left:CountDistinct{objects:$graveyard_cards_owned_by_controller, property:PermanentTypes}, test:$condition_at_least} */
condition_graveyard_permanent_type_count ::= "there" "are" condition_at_least "permanent" "types" "among" graveyard_cards_owned_by_controller

/* Another permanent of the stated kind is attached to the named object.
   Remember the attachment target for an ensuing anaphoric static subject. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), $filter_phrase])}, filter:AttachedTo(SameObject(@remember_object($object_ref)))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_another_attached ::= "another" filter_phrase "is" "attached" "to" object_ref

/* Players are evaluated independently against their own battlefield population. */
/* @sem PlayerSet::Matching{binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}), test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}} */
players_controlling_at_most ::= "that" "player" "controls" value "or" "fewer" filter_plural

/* The two excluded references remain independent of the controller and filter. */
/* @sem Condition::Controls{player:$condition_control_subject, filter:AllOf([$filter_phrase, Any, Not(SameObject($object_ref)), Not(SameObject($object_ref_2))]), minimum:1} */
condition_control_excluding_two ::= condition_control_subject "a" filter_phrase "other" "than" object_ref "or" object_ref

/* The following condition establishes the unique creature for its anaphor. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:Equal, value:Constant(1)}} */
condition_control_exactly_one_creature ::= "you" "control" "exactly" "one" "creature"

/* Each named kind is a separate existential count in the same graveyard. */
/* @sem Condition::AllOf([Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$graveyard_singular_card}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$graveyard_singular_card_2}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}]) */
condition_two_graveyard_card_kinds ::= graveyard_singular_card "and" graveyard_singular_card "are" "in" "your" "graveyard"

graveyard_singular_card ::= graveyard_instant_card | graveyard_sorcery_card | graveyard_creature_card | graveyard_artifact_card | graveyard_land_card

/* @sem $spell_instant */
graveyard_instant_card ::= "an" spell_instant "card"

/* @sem $spell_sorcery */
graveyard_sorcery_card ::= "a" spell_sorcery "card"

/* @sem $noun_creature */
graveyard_creature_card ::= "a" noun_creature "card"

/* @sem $noun_artifact */
graveyard_artifact_card ::= "an" noun_artifact "card"

/* @sem $noun_land */
graveyard_land_card ::= "a" noun_land "card"

/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:PlayerState{player:Bound(0), state:$defending_attack_state_value}} */
shared_literal_fold_de4a6c23fa99 ::= "an" "opponent" "is" defending_attack_state_value

/* Cast origin follows the caster of the object, including copied spells. */
/* @sem Condition::ObjectMatches{object:@self, filter:Cast{from:Players{zone:Hand, players:One(CasterOf(Candidate))}}} */
condition_cast_from_caster_hand ::= self_spell "was" "cast" "from" "your" "hand"

/* The other cast is distinct from the current source and retains its printed name. */
/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:AllOf([Not(SameObject(Source)), Name($referenced_card_name)])}, window:ThisGame, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_cast_other_named_game ::= "you've" "cast" "another" "spell" "named" referenced_card_name "this" "game"

/* @sem Condition::ObjectMatches{object:@self, filter:Not(Cast{from:Players{zone:Hand, players:One(CasterOf(Candidate))}})} */
condition_cast_not_from_caster_hand ::= self_spell "was" "cast" "from" "anywhere" "other" "than" "your" "hand"

/* The past-tense pronoun refers to the event subject in its enclosing frame. */
/* @sem Condition::ObjectMatches{object:@it, filter:ObjectFilter::Not($filter_phrase)} */
condition_he_was_not_type ::= "he" "wasn't" "a" filter_phrase

/* @sem Condition::ObjectMatches{object:Source, filter:Condition(Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:SameObject(Candidate), recipients:Players(OpponentsOf(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Source}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})} */
condition_source_damaged_opponent_turn ::= "this" "creature" "dealt" "damage" "to" "an" "opponent" "this" "turn"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:Condition(Compare{left:EventHistory{event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject(Candidate)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})} */
condition_object_was_dealt_damage_this_turn ::= object_ref "was" "dealt" "damage" "this" "turn"

/* The count belongs to the current ability, including this activation. */
/* @sem Condition::Compare{left:TimesActivatedThisTurn, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_ability_activation_count ::= "this" "ability" "has" "been" "activated" value "or" "more" "times" "this" "turn"

/* Count the heads in the receipt of the preceding coin flip. */
/* @sem Expr::CountCoinOutcomes{source:CoinCountSource::Receipt(@coin_receipt), outcome:Heads} */
condition_flipped_coins ::= "both" "coins" "come" "up"

/* @sem NumberTest::Compare{comparison:Equal, value:Constant(0)} */
coin_outcomes_tails ::= "tails"

/* @sem NumberTest::Compare{comparison:Equal, value:Constant(2)} */
coin_outcomes_heads ::= "heads"

coin_outcomes_test ::= coin_outcomes_tails | coin_outcomes_heads

/* @sem Condition::Compare{left:$condition_flipped_coins, test:$coin_outcomes_test} */
condition_coin_outcomes ::= condition_flipped_coins coin_outcomes_test

/* @sem Expr::Earlier{what:Exiled, measure:Count, filter:Any} */
linked_exiled_count ::= "is" "exiled" "with" "it"

/* @sem Condition::Compare{left:$linked_exiled_count, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$card_count_one}} */
condition_exiled_linked_count ::= card_count_one linked_exiled_count

/* @sem ObjectSet::Matching{objects:Observed(@prior), filter:$modifier_source_name} */
observed_named_card ::= modifier_source_name "was" "revealed" "this" "way"

/* @sem Condition::Compare{left:CountObjects($observed_named_card), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$card_count_one}} */
condition_revealed_named_count ::= card_count_one observed_named_card

/* @sem NumberTest::Compare{comparison:LessOrEqual, value:$value} */
life_or_less_test ::= value "or" "less" "life"

/* @sem Condition::Compare{left:CountPlayers(Intersection([All, Matching{binding:0, condition:Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:$life_or_less_test}}])), test:NumberTest::Compare{comparison:Equal, value:CountPlayers(All)}} */
condition_all_players_life ::= "each" "player" "has" life_or_less_test

/* @sem Expr::ManaSpent{object:Source, filter:_{}, aggregation:DistinctColors} */
activation_mana_colors ::= "colors" "of" "mana" "were" "spent" "to" "activate" "this" "ability"

/* @sem Condition::Compare{left:$activation_mana_colors, test:NumberTest::Compare{comparison:Equal, value:$value}} */
condition_distinct_mana_spent ::= "exactly" value activation_mana_colors

/* @sem Expr::ExcessDamage{result:@prior, to:Any} */
excess_damage_dealt ::= "excess" "damage" "was" "dealt" "this" "way"

/* @sem Condition::Compare{left:$excess_damage_dealt, test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
condition_excess_dealt ::= excess_damage_dealt

replacement_object_condition ::= condition_or_if_it_a | replacement_it_an | replacement_it_blocking | replacement_object_has_toxic

/* @sem Condition::ObjectMatches{object:@it, filter:$filter_phrase} */
replacement_it_an ::= "it's" "an" filter_phrase

/* @prefer always */
/* @sem Condition::ObjectMatches{object:@it, filter:Blocking} */
replacement_it_blocking ::= "it's" "blocking"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:HasKeywordFamily(Toxic)} */
replacement_object_has_toxic ::= object_ref "has" "toxic"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_graveyard_at_least ::= "there" "are" "at" "least" value filter_phrase "cards" "in" "your" "graveyard"

/* @sem Condition::Compare{left:TimesResolvedThisTurn, test:NumberTest::Compare{comparison:Equal, value:$library_ordinal}} */
shared_literal_fold_764a98aa028f ::= "it's" "the" library_ordinal "time"

/* The defending player is tied to the attacking event subject. */
/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Hand, players:One($defending_player)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:LessOrEqual, value:$count}} */
/* @prefer always */
condition_defending_hand_size ::= defending_player "has" count "or" "fewer" "cards" "in" "hand"

/* @sem Expr::CountObjects($battlefield_singular_population) */
battlefield_singular_count ::= battlefield_singular_population "on" "the" "battlefield"

/* @prefer always */
/* @sem Condition::Compare{left:$battlefield_singular_count, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_exists_battlefield ::= "there" "is" "a" battlefield_singular_count

/* Count the matching blockers while retaining the blocked object. */
/* @sem Expr::CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, filter:BlockingObject($object_ref)}) */
blocking_population_count ::= filter_plural "are" "blocking" object_ref

/* @sem Condition::Compare{left:$blocking_population_count, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_blocking_threshold ::= value "or" "more" blocking_population_count

/* @sem Condition::Compare{left:$control_shared_population, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_control_shared_at_least ::= "you" "control" "at" "least" value control_shared_population

/* The attached host supplies the subject of the property test. */
/* @sem ObjectRef::AttachedTo(Source) */
condition_attached_possessive ::= "enchanted" "creature's"

/* The controller and the controlled object are independent operands. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:ControlledBy($condition_controller_set)} */
condition_controlled_object ::= condition_controller_set "controls" object_ref

condition_controller_set ::= fewer_an_opponent | condition_defending_controller

/* @sem PlayerSet::One(DefendingPlayer) */
condition_defending_controller ::= "the" "defending" "player"

/* A controlled attachment and the object it was attached to are separate. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:HasAttached($condition_controlled_attached_filter)} */
condition_attached_controlled ::= "an" condition_controlled_attached_filter "was" "attached" "to" object_ref

/* @sem ObjectFilter::AllOf([$filter_phrase, ControlledBy(One(AbilityController))]) */
condition_controlled_attached_filter ::= filter_phrase "you" "controlled"

/* @sem Condition::ObjectMatches{object:Discarded, filter:HasKeywordFamily($discard_keyword_family)} */
condition_discard_family ::= "it" "has" discard_keyword_family

discard_keyword_family ::= discard_madness | discard_morph

/* @sem KeywordFamily::Madness */
discard_madness ::= "madness"

/* @sem KeywordFamily::Morph */
discard_morph ::= "morph"

/* @sem Condition::ObjectMatches{object:EventSubject, filter:State(CostPaid($cost_keyword_name))} */
condition_paid_event_cost ::= "his" cost_keyword_name "cost" "was" "paid"

/* A threshold over the controller's original deck size. */
/* @sem Condition::Compare{left:PlayerNumber{player:AbilityController, number:StartingDeckSize}, test:$card_count_at_least} */
condition_starting_deck_threshold ::= "you" "had" card_count_at_least "in" "your" "starting" "deck"

/* @sem NumberTest::Compare{comparison:GreaterOrEqual, value:$value} */
card_count_at_least ::= value "or" "more" "cards"

/* Event history belongs to the named object, independent of a later effect's recipient. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Condition(Compare{left:EventHistory{event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject(Candidate)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})} */
condition_object_was_dealt_damage_turn ::= object_ref "was" "dealt" "damage" "this" "turn"

/* The existential binds one player throughout the discard history query. */
/* @sem Condition::ExistsPlayer{players:All, binding:0, condition:Compare{left:EventHistory{event:Discard(_{players:One(Bound(0)), cards:Any, kind:Any, grouping:Card}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$card_count}}} */
condition_player_discarded_turn ::= "a" "player" "discarded" card_count "this" "turn"

/* Count all players who have already lost the game. */
/* @sem Condition::Compare{left:Game(PlayersWhoLost), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
condition_players_lost_game ::= number "or" "more" "players" "have" "lost" "the" "game"

/* Counter thresholds and turn-start state of the explicitly named source. */
/* @sem Condition::ObjectMatches{object:$self_explicit_ref, filter:Counters(_{kind:$counter_kind, comparison:LessOrEqual, value:$number})} */
condition_self_counters_fewer ::= self_explicit_ref "has" number "or" "fewer" counter_kind "counters" "on" "it"

/* @sem Condition::ObjectMatches{object:$self_explicit_ref, filter:Counters(_{kind:$counter_kind, comparison:Equal, value:Constant(0)})} */
condition_self_no_counters ::= self_explicit_ref "has" "no" counter_kind "counters" "on" "it"

/* @sem Condition::ObjectMatches{object:$self_explicit_ref, filter:State(StartedTurnUntapped)} */
condition_self_started_untapped ::= self_explicit_ref "started" "the" "turn" "untapped"

/* A life-total comparison composes its subject and typed number test. */
/* @sem Condition::Compare{left:$value_your_life, test:$life_threshold_test} */
condition_life_threshold ::= value_your_life "is" life_threshold_test

/* @sem NumberTest::Compare{comparison:LessOrEqual, value:$value_constant} */
life_threshold_test_suffix ::= value_constant "or" "less"

/* @sem NumberTest::Compare{comparison:$comparison_less_equal, value:$half_starting_life} */
life_threshold_test_prefix ::= comparison_less_equal half_starting_life

life_threshold_test ::= life_threshold_test_suffix | life_threshold_test_prefix

/* The integer threshold is rounded down. */
/* @sem Expr::Divide{numerator:$starting_life_total, denominator:Constant(2), rounding:Down} */
half_starting_life ::= "half" starting_life_total

/* @sem Expr::StartingLife(AbilityController) */
starting_life_total ::= "your" "starting" "life" "total"

/* Counter placement history keeps the counted event separate from its threshold. */
/* @sem Condition::Compare{left:EventHistory{event:Batch{event:$counter_history_event, per:Subject}, window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_a}} */
condition_counter_history_singular ::= counter_a counter_history_event "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:Batch{event:$counter_history_you_event, per:Subject}, window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_counter_history_plural ::= "you've" "put" value "or" "more" counter_history_you_event "this" "turn"

/* A keyword family has meaning independently of any particular toxic value. */
/* condition_object_has_toxic_family is shared as replacement_object_has_toxic. */

/* Compare the mana spent on the named spell with the current threshold. */
/* @sem Condition::ObjectMatches{object:$mana_spent_that_spell, filter:Condition(Compare{left:ManaSpent{object:Candidate, filter:_{}, aggregation:Count}, test:NumberTest::Compare{comparison:Less, value:$value}})} */
condition_mana_spent_less_than ::= "the" "amount" "of" "mana" "spent" "to" "cast" mana_spent_that_spell "was" "less" "than" value

/* @sem ObjectRef::@remember_operand(ObjectRef::@qualified_object(ObjectKind::Spell, ObjectFilter::Any)) */
mana_spent_that_spell ::= "that" "spell"

/* Battlefield quantities share the threshold comparison and retain their population. */
/* @sem Condition::Compare{left:$battlefield_among_quantity, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_among_at_least ::= "there" "are" value "or" "more" battlefield_among_quantity

/* @sem Condition::Compare{left:$battlefield_among_colors, test:NumberTest::Compare{comparison:Equal, value:$value}} */
condition_among_exact ::= "there" "are" value battlefield_among_colors

battlefield_among_quantity ::= battlefield_among_distinct_land_names | battlefield_among_counters | battlefield_among_door_names | battlefield_among_doors

/* @sem Expr::CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, property:Colors} */
battlefield_among_colors ::= "colors" "among" filter_plural

/* @sem Expr::CountCounters{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}), kind:$counter_kind, information:CurrentOrLastKnown} */
battlefield_among_counters ::= counter_kind "counters" "among" filter_plural

/* @sem Expr::CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, property:UnlockedDoorNames} */
battlefield_among_door_names ::= "different" "names" "among" "unlocked" "doors" "of" filter_plural

/* @sem Expr::CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, filter:State(UnlockedDoor)}) */
battlefield_among_doors ::= "unlocked" "doors" "among" filter_plural

/* Compare the same population under two independently named controllers. */
/* @prefer always */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([ControlledBy($players_singular), $controlled_more_filter])}), test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$controlled_more_filter, ControlledBy(One($condition_you))])})}} */
condition_player_more_controlled ::= players_singular "controls" controlled_more_filter condition_you

/* @sem Condition::ObjectMatches{object:@it, filter:SharesColorWithAny(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase})} */
condition_it_shares_color_with_an ::= "it" "shares" "a" "color" "with" "an" filter_phrase

/* The referent is resolved in the enclosing instruction; the population is live. */
/* @sem Condition::ObjectMatches{object:@it, filter:SharesColorWithAny(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase})} */
condition_it_shares_color_with_controlled ::= "it" "shares" "a" "color" "with" "a" filter_phrase

/* The controller and excluded object both refer to the enchanted permanent. */
/* @sem Condition::Controls{player:$attached_control_subject, filter:$other_than_attached_filter, minimum:1} */
condition_attached_controller_other ::= attached_control_subject other_than_attached_filter

/* @sem ObjectFilter::AllOf([$filter_phrase, Not(SameObject(AttachedTo(Source)))]) */
other_than_attached_filter ::= "another" filter_phrase

/* Restrictions on an enchanted creature can be combined independently of the payment. */
/* @sem Operand::Term{family:PermanentRule, form:CantAttack} */
ignore_restriction_attack ::= "attack"

/* @sem Operand::Term{family:PermanentRule, form:CantBlock} */
ignore_restriction_block ::= "block"

/* @sem Operand::List([$ignore_restriction_attack, $ignore_restriction_block, $host_abilities_cant_activate]) */
ignore_restrictions_combat_activated ::= "can't" ignore_restriction_attack "or" ignore_restriction_block "," "and" host_abilities_cant_activate

/* @sem Operand::List([$ignore_restriction_attack, $ignore_restriction_block]) */
ignore_restrictions_combat ::= "can't" ignore_restriction_attack "or" ignore_restriction_block

ignore_creature_restrictions ::= ignore_restrictions_combat_activated | ignore_restrictions_combat

/* Each predicate carries its operands independently of the named object. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$condition_keyword_family} */
condition_object_has_keyword_family ::= object_ref "has" condition_keyword_family

/* @sem ObjectFilter::HasKeywordFamily($condition_keyword_family_name) */
condition_keyword_family ::= condition_keyword_family_name

/* Only mechanics represented by ObjectFilter::HasKeywordFamily are valid here. */
condition_keyword_family_name ::= granted_rampage_name | mechanic_mutate_name | mechanic_disturb_name | mechanic_cumulative_upkeep_name | mechanic_embalm_name | mechanic_eternalize_name | mechanic_disguise_name

/* The announced permanent is the subject of the following history test. */
/* @sem Condition::ObjectMatches{object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AnyOf([$noun, $noun_2])}), index:0}, filter:Condition($received_damage_history)} */
chosen_target_damage_history ::= "choose" "target" noun "or" noun "." "if" "it" "was" received_damage_history

/* @sem Condition::PlayerState{player:$zone_your, state:$possessive_phase_state} */
condition_possessive_phase ::= "it's" zone_your possessive_phase_state

possessive_phase_state ::= possessive_main_phase | possessive_upkeep_phase

/* @sem PlayerState::InTheirMainPhase */
possessive_main_phase ::= "main" "phase"

/* @sem PlayerState::InTheirUpkeep */
possessive_upkeep_phase ::= "upkeep"

/* @sem Condition::PlayerState{player:$zone_your, state:$card_pool_start_state} */
condition_card_pool_start ::= "every" "card" "in" zone_your "card" "pool" card_pool_start_state

/* @sem PlayerState::WholePoolInDeck */
card_pool_start_state ::= "started" "the" "game" "in" "your" "library" "or" "in" "the" "command" "zone"

/* @sem Condition::PlayerState{player:$life_difference_active, state:$card_pool_start_state_their} */
condition_active_card_pool_start ::= "every" "card" "in" life_difference_active "card" "pool" card_pool_start_state_their

/* @sem PlayerState::WholePoolInDeck */
card_pool_start_state_their ::= "started" "the" "game" "in" "their" "library" "or" "in" "the" "command" "zone"

/* @sem $phase_condition_main */
condition_phase_window ::= "it's" phase_condition_main

/* @sem Condition::Window(MainPhase) */
phase_condition_main ::= "a" "main" "phase"

/* Existential player damage history; the event phrase retains its source and recipient. */
/* @sem Condition::ExistsPlayer{players:$event_player, binding:0, condition:Compare{left:EventHistory{event:$past_bound_player_damage, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}} */
condition_player_damage_history ::= event_player past_bound_player_damage "this" "turn"

past_bound_player_damage ::= past_bound_player_damage_was | past_bound_player_damage_has_been

/* @sem $bound_player_damage_history */
past_bound_player_damage_was ::= "was" "dealt" bound_player_damage_history

/* @sem $bound_player_damage_history */
past_bound_player_damage_has_been ::= "has" "been" "dealt" bound_player_damage_history

/* @sem Condition::ObjectMatches{object:Source, filter:History{event:Regenerated, window:ThisTurn}} */
condition_this_creature_regenerated ::= "this" "creature" "regenerated" "this" "turn"

/* The contracted form retains the same life-gain history threshold. */
/* @sem Condition::Compare{left:EventHistory{event:Player{event:GainsLife, players:One(PlayerRef::AbilityController)}, window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
condition_you_have_gained_life ::= "you've" "gained" number "or" "more" "life" "this" "turn"

/* A face-down permanent's characteristics are hidden at entry. */
/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:@and(ObjectFilter::State(FaceDown), ObjectFilter::ControlledBy(One(AbilityController))), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_face_down_entered_under_you ::= "a" "permanent" "entered" "the" "battlefield" "face" "down" "under" "your" "control" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:Player{event:TurnsFaceUp, players:One(AbilityController), objects:$card_noun}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_you_turned_face_up ::= "you" "turned" "a" card_noun "face" "up" "this" "turn"

/* @sem Condition::AnyOf(@unordered([$condition_face_down_entered_under_you, $condition_you_turned_face_up])) */
condition_face_down_activity ::= condition_face_down_entered_under_you "or" condition_you_turned_face_up

/* @sem ObjectFilter::Property{property:ColorCount, test:NumberTest::Compare{comparison:Equal, value:Constant(5)}} */
past_all_colors ::= "all" "colors"

/* @sem ObjectFilter::State(BlockedThisTurn) */
past_blocked_this_turn ::= "blocked" "this" "turn"

/* @sem ObjectFilter::AnyOf([State(AttackingAlone), State(BlockingAlone)]) */
past_combat_alone ::= "attacking" "or" "blocking" "alone"

/* Life comparisons use the same controller while their tests retain the
   printed threshold and the existential opponent's appropriate extremum. */
/* @sem Condition::Compare{left:PlayerNumber{player:AbilityController, number:Life}, test:$you_life_test} */
condition_you_life_comparison ::= "you" "have" you_life_test

you_life_test ::= you_life_exact | you_life_starting_margin | you_life_less_opponent | you_life_more_opponent

/* @sem NumberTest::Compare{comparison:Equal, value:$value} */
you_life_exact ::= "exactly" value "life"

/* @sem NumberTest::Compare{comparison:GreaterOrEqual, value:Add([StartingLife(AbilityController), $value])} */
you_life_starting_margin ::= "at" "least" value "life" "more" "than" "your" "starting" "life" "total"

/* @sem NumberTest::Compare{comparison:Less, value:AmongPlayers{players:OpponentsOf(AbilityController), number:Life, aggregation:Maximum}} */
you_life_less_opponent ::= "less" "life" "than" "an" "opponent"

/* @sem NumberTest::Compare{comparison:Greater, value:AmongPlayers{players:OpponentsOf(AbilityController), number:Life, aggregation:Minimum}} */
you_life_more_opponent ::= "more" "life" "than" "an" "opponent"

/* Contracted predicates share the referent established by their enclosing phrase. */
/* @sem ObjectFilter::State(FaceDown) */
condition_it_face_down ::= "face" "down"

/* @sem ObjectFilter::AnyOf([$adjective_enchanted, $adjective_equipped]) */
condition_it_enchanted_or_equipped ::= adjective_enchanted "or" adjective_equipped

/* @sem ObjectFilter::AnyOf([BlockedByAny($filter_phrase), BlockingAny($filter_phrase)]) */
condition_it_blocking_or_blocked_by ::= "blocking" "or" "blocked" "by" "a" filter_phrase

/* An explicit subject and its predicate retain separate semantic operands. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$object_condition_predicate} */
condition_past_object_predicate ::= object_ref object_condition_predicate

object_condition_predicate ::= object_condition_required_attack | object_condition_had_property | object_condition_had_no_named_counters | object_condition_had_no_counters | object_condition_cast_or_no_mana | object_condition_devoured_creature

/* @sem ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:$bound, value:$value}} */
object_condition_had_property ::= "had" stat value "or" bound

/* @sem ObjectFilter::Counters{kind:$counter_kind, comparison:Equal, value:Constant(0)} */
object_condition_had_no_named_counters ::= "had" "no" counter_kind "counters" "on" "it"

/* @sem ObjectFilter::Counters{comparison:Equal, value:Constant(0)} */
object_condition_had_no_counters ::= "had" "no" "counters" "on" "it"

/* The quantified subject and every predicate use the same binding. */
/* @sem Condition::ExistsPlayer{players:$existential_condition_players, binding:0, condition:$bound_player_predicate} */
condition_exists_bound_player ::= existential_condition_players bound_player_predicate

existential_condition_players ::= event_a_player | event_an_opponent | controller_or_attacked_player | life_history_team

bound_player_predicate ::= bound_player_controls_none | bound_player_more_life_than | bound_player_has_state | bound_player_controls_another | bound_player_not_being_attacked

/* @sem Condition::Not(Controls{player:Bound(0), filter:$filter_plural, minimum:1}) */
bound_player_controls_none ::= "controls" "no" filter_plural

/* @sem Condition::Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:Greater, value:PlayerNumber{player:$life_comparison_player, number:Life}}} */
bound_player_more_life_than ::= "has" "more" "life" "than" life_comparison_player

/* The quantified player owns both the current and starting life totals. */
/* @sem Condition::ExistsPlayer{players:$existential_possessive_players, binding:0, condition:$bound_possessive_predicate} */
condition_exists_possessive_player ::= existential_possessive_players bound_possessive_predicate

bound_possessive_predicate ::= bound_possessive_life_le_half | bound_possessive_life_lt_half

/* Player-state predicates retain the player supplied by their subject. */
/* @sem Condition::PlayerState{player:$condition_you, state:$possessed_player_state} */
condition_you_have_player_state ::= condition_you "have" possessed_player_state

possessed_player_state ::= state_boon | state_max_speed

/* @sem PlayerState::HasBoon */
state_boon ::= "a" "boon"

/* @sem PlayerState::MaxSpeed */
state_max_speed ::= "max" "speed"

/* @sem Condition::PlayerState{player:$its_controller, state:$adjective_player_state} */
condition_controller_is_state ::= its_controller "is" adjective_player_state

/* @sem PlayerState::Poisoned */
adjective_player_state ::= "poisoned"

/* Attack history retains the type and threshold from this phrase. */
/* @sem Condition::Compare{left:EventHistory{event:Object{event:Attacks, objects:AllOf([$subtype_plural, ControlledBy(One(AbilityController))])}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
controlled_type_attack_history ::= "you" "attacked" "with" number "or" "more" subtype_plural "this" "turn"

/* These comparisons refer to the player receiving the preceding combat damage. */
/* @sem Condition::Compare{left:PlayerNumber{player:EventSubject, number:CardsInHand}, test:NumberTest::Compare{comparison:Greater, value:AmongPlayers{players:OthersThan(EventSubject), number:CardsInHand, aggregation:Maximum}}} */
condition_damaged_player_most_cards ::= "that" "player" "has" "more" "cards" "in" "hand" "than" "each" "other" "player"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(EventSubject))])}), test:NumberTest::Compare{comparison:Greater, value:AmongPlayers{players:OthersThan(EventSubject), number:Permanents($filter_plural), aggregation:Maximum}}} */
condition_damaged_player_most_permanents ::= "that" "player" "controls" "more" filter_plural "than" "each" "other" "player"

/* @sem Condition::Compare{left:CountPlayers(Intersection([OthersThan(EventSubject), Matching{binding:0, condition:Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:PlayerNumber{player:EventSubject, number:Life}}}}])), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_damaged_player_most_life ::= "that" "player" "has" "more" "life" "than" "each" "other" "player"

damaged_player_comparison ::= condition_damaged_player_most_cards | condition_damaged_player_most_permanents | condition_damaged_player_most_life

/* Color alternatives and attachment counts describe the same explicit subject. */
/* predicate_color_alternative is shared as spell_cast_color_pair. */

/* @sem ObjectFilter::AttachedCount{attachments:$filter_phrase, comparison:Equal, value:Constant(1)} */
predicate_exact_attachment_one ::= "enchanted" "by" "exactly" "one" filter_phrase

/* @sem ObjectFilter::AttachedCount{attachments:$filter_plural, comparison:Equal, value:$count_plural} */
predicate_exact_attachment_plural ::= "enchanted" "by" "exactly" count_plural filter_plural

/* Tests on the game turn retain the comparison as a separate operand. */
/* @sem Condition::Compare{left:TurnNumber, test:$game_turn_test} */
condition_game_turn ::= "it's" game_turn_test

/* @sem NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(2)} */
game_turn_after_first ::= "not" "the" "first" "turn" "of" "the" "game"

/* @sem NumberTest::Compare{comparison:Equal, value:Constant(1)} */
game_turn_first ::= "the" "first" "turn" "of" "the" "game"

game_turn_test ::= game_turn_after_first | game_turn_first

/* Origin scopes belong to each historical event independently. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$origin_was_cast} */
condition_object_origin_history ::= object_ref origin_was_cast

/* @sem ObjectFilter::Cast{from:$cast_origin_graveyard} */
origin_was_cast ::= "was" "cast" "from" cast_origin_graveyard

/* A single opponent exceeds your matching battlefield population by a margin. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Add(CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}), $value)}}} */
condition_opponent_margin ::= "an" "opponent" "controls" "at" "least" value "more" filter_plural "than" "you"

/* A margin compares the same bound player’s hand with the controller’s hand. */
/* @sem NumberTest::Compare{comparison:GreaterOrEqual, value:Add([CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), $value])} */
existential_hand_at_least_more_than_you ::= "at" "least" value "more" "cards" "in" "hand" "than" "you"

/* One named population is required in each listed zone. Private zones belong to
   the owner; the shared exile and battlefield populations require ownership. */
/* @sem Condition::AllOf([Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Exile), kind:Card, filter:Name($referenced_card_name)}, filter:OwnedBy(One(AbilityController))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$card_count}}, Compare{left:CountObjects(Zone{scope:$owned_named_zone_after_exile, kind:Card, filter:Name($referenced_card_name)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$card_count}}, Compare{left:CountObjects(Zone{scope:$owned_named_zone_after_hand, kind:Card, filter:Name($referenced_card_name)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$card_count}}, Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Name($referenced_card_name), OwnedBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$card_count}}]) */
condition_owned_named_across_zones ::= "you" "own" card_count "named" referenced_card_name "in" "exile" "," "in" owned_named_zone_after_exile "," "in" owned_named_zone_after_hand "," "and" "on" "the" "battlefield"

/* @sem ZoneScope::Players{zone:Library, players:One(AbilityController)} */
owned_private_library ::= "your" "library"

owned_named_zone_after_exile ::= history_cast_hand | owned_private_library

owned_named_zone_after_hand ::= cast_origin_graveyard | owned_private_library

/* The three ordinal operands independently identify the controller's turns. */
/* @sem Condition::Not(Compare{left:PlayerNumber{player:AbilityController, number:TurnsBegun}, test:NumberTest::AnyOf([NumberTest::Compare{comparison:Equal, value:$resolution_ordinal}, NumberTest::Compare{comparison:Equal, value:$resolution_ordinal_2}, NumberTest::Compare{comparison:Equal, value:$resolution_ordinal_3}])}) */
condition_not_during_own_ordinal_turns ::= "during" "your" resolution_ordinal "," resolution_ordinal "," "or" resolution_ordinal "turns" "of" "the" "game"

/* @sem Ability::Casting(Require($condition_not_during_own_ordinal_turns)) */
casting_self_forbidden_ordinal_turns ::= "you" "can't" "cast" SELF_NAME condition_not_during_own_ordinal_turns "."

/* Either of two explicitly named resolution counts. */
/* @prefer always */
/* @sem Condition::AnyOf([Compare{left:TimesResolvedThisTurn, test:NumberTest::Compare{comparison:Equal, value:$resolution_ordinal}}, Compare{left:TimesResolvedThisTurn, test:NumberTest::Compare{comparison:Equal, value:$resolution_ordinal_2}}]) */
resolution_pair_condition ::= "this" "is" "the" resolution_ordinal "or" resolution_ordinal "time" "this" "ability" "has" "resolved" "this" "turn"

/* Each printed spell describes its own cast event and filter. */
/* @sem Condition::AllOf([Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:$spell_filter}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:$spell_filter_2}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}]) */
condition_cast_both_spells ::= "you've" "cast" "both" spell_filter "and" spell_filter "this" "turn"

/* @sem Condition::Compare{left:AnnouncedX, test:Compare{comparison:NotEqual, value:$excluded_x_number}} */
x_cannot_equal_number ::= "x" "can't" "be" excluded_x_number

excluded_x_number ::= number_digits

/* Possessive spell wording refers to the spell carrying this ability. */
/* @prefer always */
/* @sem ObjectRef::Source */
condition_spell_possessive ::= "this" "spell's"

/* @sem Mechanic::Surge */
condition_surge_name ::= "surge"

/* The event subject and casting method remain independent. */
/* @sem Condition::ObjectMatches{object:$condition_event_they, filter:$condition_cast_using_filter} */
condition_cast_using_named_cost ::= condition_event_they "were" condition_cast_using_filter

/* @sem ObjectRef::EventSubject */
condition_event_they ::= "they"

/* @sem ObjectFilter::State(CostPaid($condition_casting_method)) */
condition_cast_using_filter ::= "cast" "using" condition_casting_method

condition_casting_method ::= mechanic_web_slinging_name | mechanic_prowl_name | condition_surge_name

/* @sem Condition::ObjectMatches{object:$object_ref, filter:$condition_exact_counter_singular} */
condition_exactly_one_counter ::= "there" "is" condition_exact_counter_singular "on" object_ref

/* @sem ObjectFilter::Counters(_{kind:$counter_kind, comparison:Equal, value:$value}) */
condition_exact_counter_singular ::= "exactly" value counter_kind "counter"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:$condition_exact_counter_plural} */
condition_exactly_many_counters ::= "there" "are" condition_exact_counter_plural "on" object_ref

/* @sem ObjectFilter::Counters(_{kind:$counter_kind, comparison:Equal, value:$value}) */
condition_exact_counter_plural ::= "exactly" value counter_kind "counters"

/* @sem Condition::ObjectMatches{object:$spent_cast_object, filter:$condition_spent_from_threshold} */
condition_mana_sources_threshold ::= condition_spent_from_threshold spent_cast_object

/* @sem ObjectFilter::ManaSpent{sources:$filter_plural, comparison:GreaterOrEqual, value:$value} */
condition_spent_from_threshold ::= value "or" "more" "mana" "from" filter_plural "was" "spent"

/* A comparison over the event's dice results. */
/* @sem Expr::Dice(Matching([GreaterOrEqual, $value])) */
dice_results_at_least ::= "those" "results" "was" value "or" "higher"

/* @sem Condition::Compare{left:$dice_results_at_least, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_any_matching_dice ::= "any" "of" dice_results_at_least

/* Sources of the damage in the current event, filtered independently. */
/* @sem ObjectSet::Matching{objects:Damage(Source), filter:$filter_phrase} */
damage_sources_matching ::= "that" "damage" "was" "dealt" "by" "a" filter_phrase

/* @sem Condition::Compare{left:CountObjects($damage_sources_matching), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_any_damage_source ::= "any" "of" damage_sources_matching

/* The pronoun denotes the current ability's source or event subject. */
/* @sem Condition::ObjectMatches{object:@self, filter:State(CostPaid(Additional))} */
condition_her_additional_paid ::= "her" "additional" "cost" "was" "paid"

/* The subject and the historical predicate remain separate operands. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$source_damage_history} */
condition_source_damage_history ::= object_ref source_damage_history

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:SameObject(Candidate), recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
source_damage_history_combat ::= "dealt" "combat" "damage" "to" "a" "player" "this" "turn"

source_damage_history ::= source_damage_history_combat | source_damage_history_object | source_damage_history_total | source_damage_history_player_total

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:SameObject(Candidate), recipients:Objects(SameObject($object_ref)), kind:Any, grouping:SourceRecipient, subject:Source}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
source_damage_history_object ::= "dealt" "damage" "to" object_ref "this" "turn"

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:SameObject(Candidate), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Source}), window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}) */
source_damage_history_total ::= "has" "dealt" value "or" "more" "damage" "this" "turn"

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:SameObject(Candidate), recipients:Players($players_singular), kind:Any, grouping:SourceRecipient, subject:Source}), window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}) */
source_damage_history_player_total ::= "has" "dealt" value "or" "more" "damage" "to" players_singular "this" "turn"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:Cast{from:Shared(Exile)}} */
condition_was_cast_from_exile ::= object_ref "was" "cast" "from" "exile"

total_stat ::= stat_power | stat_toughness

/* The activation payment binding identifies the sacrificed cost component. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:CostObjects{payment:Activation, component:[@cost_index], view:Performed, phase:Before}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
condition_activation_sacrifice_filter ::= "an" filter_phrase "was" "sacrificed" "this" "way"

/* Count counters or distinct counter kinds across the stated population. */
/* @sem Condition::Compare{left:$counter_population_measure, test:$condition_at_least} */
condition_counter_population_threshold ::= "there" "are" condition_at_least counter_population_measure

counter_population_measure ::= counter_population_total | counter_population_kinds

/* @sem Expr::CountCounters{recipients:Objects($affected), information:CurrentOrLastKnown} */
counter_population_total ::= "counters" "among" affected

/* @sem Expr::CountDistinct{objects:$affected, property:CounterTypes} */
counter_population_kinds ::= "different" "kinds" "of" "counters" "among" affected

/* @sem Condition::ObjectMatches{object:Source, filter:Property{property:Power, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}} */
condition_self_power_at_least ::= "this" "creature's" "power" "is" number "or" "more"

/* The intervening condition refers to this ability's holder. */
/* @sem Condition::ObjectMatches{object:Source, filter:InZone(Shared(Battlefield))} */
condition_holder_on_battlefield ::= "this" "creature" "is" "on" "the" "battlefield"

/* The choice announces the card target; the possessive tests that same object. */
/* @sem Condition::ObjectMatches{object:@remember_object($target_card_your_graveyard), filter:Property{property:$stat, test:NumberTest::Compare{comparison:$stat_comparison, value:Expr::@in_filter($value)}}} */
chosen_card_property_condition ::= "choose" target_card_your_graveyard "." "if" "that" "card's" stat "is" stat_comparison value

/* Count matching cards across the controller's graveyard, hand, and library. */
/* @sem Condition::Compare{left:CountObjects(Union([Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$filter_phrase})])), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_three_zone_card_threshold ::= "there" "are" value "or" "more" filter_phrase "cards" "among" "cards" "in" "your" "graveyard" "," "hand" "," "and" "library"

/* A card's own graveyard location and an independently stated condition. */
/* @sem Condition::AllOf([ObjectMatches{object:Source, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}, $condition]) */
condition_self_in_your_graveyard_and ::= "this" "card" "is" "in" "your" "graveyard" "and" condition

/* The possessive refers to the source card explicitly named in its graveyard. */
/* @sem Condition::AllOf([ObjectMatches{object:Source, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}, ObjectMatches{object:Source, filter:Property{property:$stat, test:NumberTest::Compare{comparison:$bound, value:$number}}}]) */
source_graveyard_property_condition ::= "this" "card" "is" "in" "your" "graveyard" "and" "its" stat "is" number "or" bound

/* @sem Condition::ObjectMatches{object:Source, filter:ObjectFilter::State(CostPaid($condition_alternative_cost_name))} */
condition_spell_alternative_cost_paid ::= "this" "spell's" condition_alternative_cost_name "cost" "was" "paid"

/* A live opponent population compared with the ability controller. */
/* @sem PlayerSet::Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$comparison_type, ControlledBy(One(Bound(0)))])}), test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$comparison_type, ControlledBy(One(AbilityController))])})}}}]) */
more_type_opponents ::= "each" "opponent" "who" "controls" "more" comparison_type "than" "you"

comparison_type ::= plural_creature | plural_artifact | plural_enchantment | plural_land

/* The filter applies to sources of the triggering damage. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:Damage(Source), filter:$filter_phrase}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_damage_source_filter ::= "any" "of" "that" "damage" "was" "dealt" "by" "a" filter_phrase

/* Count the same card filter across the controller's three printed zones. */
/* @sem Condition::Compare{left:Expr::CountObjects(Union([Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$card_filter}, Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}, Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$card_filter}])), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}} */
condition_owned_three_zone_count ::= "there" "are" count "or" "more" card_filter "cards" "among" "cards" "in" "your" "graveyard" "," "hand" "," "and" "library"

/* Compare the latest die roll with a value computed in the current scope. */
/* @sem Condition::Compare{left:$value_die_result, test:$die_result_comparison_test} */
condition_die_result_comparison ::= value_die_result "is" die_result_comparison_test

/* @sem NumberTest::Compare{comparison:LessOrEqual, value:$value} */
die_result_upper_test ::= "equal" "to" "or" "less" "than" value

/* Independent ordinals describe turns begun by the relevant controller. */
/* @sem Condition::Compare{left:PlayerNumber{player:AbilityController, number:TurnsBegun}, test:NumberTest::AnyOf([NumberTest::Compare{comparison:Equal, value:$resolution_ordinal}, NumberTest::Compare{comparison:Equal, value:$resolution_ordinal_2}, NumberTest::Compare{comparison:Equal, value:$resolution_ordinal_3}])} */
condition_own_ordinal_turns ::= "it's" "your" resolution_ordinal "," resolution_ordinal "," "or" resolution_ordinal "turn" "of" "the" "game"

/* The event group retains the cards whose entry caused this trigger. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:EventGroup, filter:Cast{}}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_event_group_none_cast ::= "none" "of" "them" "were" "cast"

/* No member of the group had positive mana spent on its cast. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:EventGroup, filter:Not(Condition(Compare{left:ManaSpent{object:Candidate, filter:_{}, aggregation:Count}, test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}))}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_event_group_no_mana_spent ::= "no" "mana" "was" "spent" "to" "cast" "them"

/* Canonical object-bound negation has the same candidate scope. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:EventGroup, filter:Condition(Not(Compare{left:ManaSpent{object:Candidate, filter:_{}, aggregation:Count}, test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}))}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_event_group_no_mana_spent_normalized ::= "no" "mana" "was" "spent" "to" "cast" "them"

/* The event subject is excluded from the comparison population. */
/* @sem Condition::ObjectMatches{object:EventSubject, filter:Property{property:$stat, test:NumberTest::Compare{comparison:Greater, value:Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(EventSubject)), CardType(Creature)])}, property:$stat_2, aggregation:Maximum}}}} */
event_subject_extreme_condition ::= "its" stat "is" "greater" "than" "each" "other" "creature's" stat

/* @sem Condition::Compare{left:ManaSpent{object:$spent_spell, filter:_{colors:[White, Blue, Black, Red, Green]}, aggregation:Count}, test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_no_colored_mana_spent ::= "no" "colored" "mana" "was" "spent" "to" "cast" spent_spell

/* A singular attacker is counted against the named defending player. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, filter:AttackingDefender(Players(One($condition_you)))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_singular_attacking_player ::= "a" filter_phrase "is" "attacking" condition_you

/* The end-of-combat step has not yet ended. */
/* @sem Condition::Window(BeforeEndOfCombatStep) */
window_before_combat_end ::= "before" "the" "end" "of" "combat" "step"

/* This history excludes the cast event's subject in its enclosing trigger. */
/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:Not(SameObject(EventSubject))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
cast_subject_other_spell_condition ::= "you've" "cast" "another" "spell" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:AllOf([Not(SameObject(EventSubject)), $spell_adjectives])}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
cast_subject_other_typed_spell_condition ::= "you've" "cast" "another" spell_adjectives "spell" "this" "turn"

cast_subject_history_condition ::= cast_subject_other_spell_condition | cast_subject_other_typed_spell_condition

/* @sem Condition::ObjectMatches{object:Source, filter:AlternateCostPaid($kicker_operands)} */
condition_alternative_mana_paid ::= "the" kicker_operands "cost" "was" "paid"

/* @sem Condition::Compare{left:CountPlayers(Intersection([One(AbilityController), One(Prior(WinningBidder))])), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
condition_you_win_bidding ::= "you" "win" "the" "bidding"

/* @sem Condition::Compare{left:CountDistinct{objects:Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}, property:ManaValues}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_linked_distinct_mana_values ::= "cards" "with" value "or" "more" "different" "mana" "values" "are" "exiled" "with" object_ref

/* Each historical fact remains usable independently of an activation restriction. */
/* @sem Condition::Compare{left:EventHistory{event:Batch{event:Counters(_{change:Removed, kind:$counter_kind, objects:AllOf([AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]), ControlledBy(One(AbilityController))])}), per:Subject}, window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_a}} */
condition_counter_removed_controlled ::= counter_a counter_kind "counter" "was" "removed" "from" "a" "permanent" "you" "controlled" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:AllOf([Any, Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)}), OwnedBy(All)]), from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_counter_permanent_graveyard ::= "a" "permanent" "with" "an" counter_kind "counter" "on" "it" "was" "put" "into" "a" "graveyard" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:AllOf([Any, Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)}), OwnedBy(All)]), from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_counter_permanent_graveyard_a ::= "a" "permanent" "with" "a" counter_kind "counter" "on" "it" "was" "put" "into" "a" "graveyard" "this" "turn"

/* A game-long count of cycling cards with the written name. */
/* @sem Condition::PlayerDid{player:AbilityController, event:Cycled(GreaterOrEqual, $value, Name($referenced_card_name)), window:ThisGame} */
condition_cycled_named_game ::= "you've" "cycled" "a" "card" "named" referenced_card_name value "or" "more" "times" "this" "game"

/* @sem Condition::ObjectMatches{object:$self_ref, filter:InZone(Shared(Battlefield))} */
condition_self_on_battlefield ::= self_ref "is" "on" "the" "battlefield"

/* @sem Condition::Not(PlayerState{player:AbilityController, state:StartingPlayer}) */
opening_player_condition ::= "you're" "not" "the" "starting" "player"

/* A battlefield object retains its controller and unrestricted ownership in the historical event. */
/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:AllOf([$noun, ControlledBy(One(AbilityController)), OwnedBy(All)]), from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_controlled_graveyard_from_battlefield ::= "a" noun "you" "controlled" "was" "put" "into" "a" "graveyard" "from" "the" "battlefield" "this" "turn"

/* The controller subject avoids introducing an unbound player anaphor. */
/* @sem Condition::Not(Compare{left:EventHistory{event:Spell{event:Cast, players:One($condition_no_cast_you), spells:$spell_filter}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
condition_controller_no_cast_this_turn ::= condition_no_cast_you spell_filter "this" "turn"

/* Compare the event defender’s hand with the ability controller’s hand. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(DefendingPlayerOf(Source))}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})}} */
condition_defending_hand_more_than_you ::= "defending" "player" "has" "more" "cards" "in" "hand" "than" "you"

/* @sem $condition_opponent_margin */
window_opponent_margin ::= "if" condition_opponent_margin

/* Count permanent cards in the controller's graveyard. */
/* @sem Condition::Compare{left:CountObjects(Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)])})), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
graveyard_permanents_threshold ::= "there" "are" number "or" "more" "permanent" "cards" "in" "your" "graveyard"

/* @sem Condition::AllOf([PlayerIsActive(AbilityController), Window(Combat)]) */
condition_your_combat_phase ::= "it's" "your" "combat" "phase"

window_before_declaration ::= casting_before_blockers | casting_before_attackers

/* Timing phrases retain the combat qualifier on the second window. */
/* @sem Condition::AnyOf([$casting_early_window, $casting_combat_window]) */
casting_timing_choice ::= casting_early_window "or" casting_combat_window

casting_early_window ::= casting_before_combat | casting_before_combat_damage

/* @sem Condition::Window(BeforeCombat) */
casting_before_combat ::= "before" "combat"

/* @sem Condition::Window(BeforeCombatDamage) */
casting_before_combat_damage ::= "before" "combat" "damage"

/* @sem Condition::AllOf([Window(Combat), $casting_combat_cutoff]) */
casting_combat_window ::= "during" "combat" casting_combat_cutoff

casting_combat_cutoff ::= casting_before_blockers | casting_before_attackers

/* @sem Condition::Window(BeforeBlockersDeclared) */
casting_before_blockers ::= "before" "blockers" "are" "declared"

/* @sem Condition::Window(BeforeAttackersDeclared) */
casting_before_attackers ::= "before" "attackers" "are" "declared"

/* Count the same filtered cards in each of the controller’s three private zones. */
/* @sem Condition::Compare{left:CountObjects(Union([Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}])), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_three_private_zones_threshold ::= "there" "are" value "or" "more" filter_phrase "cards" "among" "cards" "in" "your" "graveyard" "," "hand" "," "and" "library"

/* @sem Condition::Compare{left:EventHistory{event:$counted_zone_history, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}} */
condition_counted_zone_history ::= counter_amount counted_zone_history "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$plural_zone_history, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_threshold_zone_history ::= value "or" "more" plural_zone_history "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$other_zone_history, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_other_zone_history ::= other_zone_history "this" "turn"

/* The same bound opponent performs the historical action being tested. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:EventHistory{event:Player{event:Draws, players:One(Bound(0))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}} */
casting_opponent_draw_threshold ::= "an" "opponent" "drew" value "or" "more" "cards" "this" "turn"

/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:EventHistory{event:Player{event:SearchesLibrary, players:One(Bound(0))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}} */
casting_opponent_searched_library ::= "an" "opponent" "searched" "their" "library" "this" "turn"

/* A pair retains both color operands for comparisons and printing. */
/* @sem Expr::CountManaSymbols{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:ControlledBy(One(PlayerRef::AbilityController))}, colors:[$mana_color_word, $mana_color_word_2]} */
value_devotion_pair ::= "your" "devotion" "to" mana_color_word "and" mana_color_word

/* @sem Condition::@computed_condition(Condition::Compare{left:$value_devotion_pair, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}) */
condition_devotion_pair_minimum ::= value_devotion_pair "is" value "or" "greater"

/* Keyword families and past obligations are independent predicates on the named object. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Not($condition_keyword_family)} */
condition_object_lacks_keyword_family ::= object_ref "doesn't" "have" condition_keyword_family

/* @sem ObjectFilter::State(HadToAttack) */
object_condition_required_attack ::= "had" "to" "attack" "this" "combat"

/* Each-other comparisons below are scoped to the all-player population. */
/* @sem Condition::ExistsPlayer{players:All, binding:0, condition:$bound_player_each_predicate} */
condition_exists_each_player ::= "a" "player" bound_player_each_predicate

bound_player_each_predicate ::= bound_player_each_life | bound_player_each_hand | bound_player_each_control

/* @sem Condition::Compare{left:CountPlayers(Intersection([One(Bound(0)), One(Extreme{players:All, number:Life, highest:true})])), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
bound_player_each_life ::= "has" "more" "life" "than" "each" "other" "player"

/* @sem Condition::Compare{left:PlayerNumber{player:Bound(0), number:CardsInHand}, test:NumberTest::Compare{comparison:Greater, value:AmongPlayers{players:All, number:CardsInHand, aggregation:Maximum}}} */
bound_player_each_hand ::= "has" "more" "cards" "in" "hand" "than" "each" "other" "player"

/* A spell target shares its filter with other spell descriptions. */
/* @sem Condition::TargetsMatch(_{object:$object_ref, kind:Spell, filter:$targeted_spell_filter}) */
condition_targets_filtered_spell ::= object_ref "targets" targeted_spell_filter

/* @sem $targeted_spell_kind */
targeted_spell_filter ::= "a" targeted_spell_kind "spell"

targeted_spell_kind ::= adjective_color | filter_phrase | spell_sorcery

/* Event occurrences and object populations retain their separate quantifiers. */
/* @sem Condition::Compare{left:EventHistory{event:$history_some_object_event, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_history_some_event_this_turn ::= history_some_object_event "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:$history_no_object_event, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_history_no_event_this_turn ::= "no" history_no_object_event "this" "turn"

/* @sem Condition::Compare{left:CountObjects(Matching{objects:$affected, filter:$object_attacked_turn}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_no_objects_with_history ::= "no" affected object_attacked_turn

condition_targeting_filter ::= condition_targeting_one | condition_targeting_one_or_more | condition_targeting_one_an

/* @sem ObjectFilter::TargetsAny(Objects($condition_targeted_population)) */
condition_targeting_one ::= "a" condition_targeted_population

/* @sem ObjectFilter::TargetsAny(Objects($affected)) */
condition_targeting_one_or_more ::= "one" "or" "more" affected

/* Used only under the matching single-creature casting cost. */
/* @sem Condition::ObjectMatches{object:Target{slot:0, index:0}, filter:Property{property:$stat, test:NumberTest::Compare{comparison:$stat_comparison, value:ObjectProperty{object:Query{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Inputs, phase:Before}, index:0}, property:$stat_2, information:CurrentOrLastKnown}}}} */
casting_sacrifice_comparison ::= "its" stat "is" stat_comparison "the" "sacrificed" "creature's" stat

/* The death subject's graveyard incarnation is both the unspecialize payment
   and the object returned. The conditional cannot bind another payment. */
/* @sem Ability::Triggered{event:$event_self_dies, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$unspecialize_then_return}} */
triggered_dies_unspecialize_return ::= "when" event_self_dies "," unspecialize_then_return "."

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Unspecialize(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0})]}, optional:false}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), destination:$unspecialize_return_destination, qualifiers:[]}}]}, otherwise:Program{}}] */
unspecialize_then_return ::= "it" "unspecializes" "." "if" "it" "unspecializes" "this" "way" "," "return" "it" "to" unspecialize_return_destination

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}} */
unspecialize_return_destination_tapped ::= "the" "battlefield" "tapped"

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
unspecialize_return_destination_untapped ::= "the" "battlefield"

unspecialize_return_destination ::= unspecialize_return_destination_tapped | unspecialize_return_destination_untapped

/* The name in this threshold also supplies the referent of the following pronoun. */
/* @sem Instruction::[If{condition:Compare{left:CountObjects(Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($self_ref_named)})), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, then:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Transform{object:$self_ref_named}}}]}, otherwise:Program{}}] */
clause_linked_source_transform ::= "then" "if" "there" "are" number "or" "more" "cards" "exiled" "with" self_ref_named "," "transform" "it"

/* The source exploited the subject of the enclosing event. */
/* @sem Condition::ObjectMatches{object:Source, filter:History{event:Exploited(EventSubject), window:ThisGame}} */
condition_source_exploited_event ::= "it" "exploited" "that" "creature"

/* An individual opponent received at least the stated total damage this turn. */
/* condition_opponent_damage_threshold is shared as linked_play_opponent_damage. */

/* A threshold counts controlled permanents with the stated subtype. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$subtype_plural, ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
condition_control_subtype_or_more ::= "you" "control" number "or" "more" subtype_plural

/* @sem Condition::ObjectMatches{object:$object_ref, filter:Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$value})} */
condition_counters_at_least_him ::= object_ref "has" value "or" "more" counter_kind "counters" "on" "him"

/* The defending player's qualifying permanent remains a live filter. */
/* @sem Condition::Controls{player:DefendingPlayerOf(Source), filter:AllOf([Not(Tapped), $noun]), minimum:1} */
condition_defender_controls_untapped_an ::= "defending" "player" "controls" "an" "untapped" noun

/* @sem Condition::ObjectMatches{object:$self_explicit_ref, filter:State(Unblocked)} */
condition_holder_unblocked ::= self_explicit_ref "is" "unblocked"

/* The graveyard is that of the target actually exiled by the preceding action. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($opponent_graveyard_target), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, If{condition:Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(OwnerOf($opponent_graveyard_target))}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}, then:Program{instructions:$clause}, otherwise:Program{}}] */
instructions_exile_graveyard_empty ::= "exile" opponent_graveyard_target "." NEWLINE? "if" "no" "cards" "are" "in" "that" "graveyard" "," clause

opponent_graveyard_target ::= target_any_card_opponent_graveyard | target_card_opponent_graveyard

/* The arrival belongs to this optional destruction, not an arbitrary prior action. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:Destroy{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@agree($filter_phrase, $filter_phrase_2)}), index:0}), regeneration:true}}]}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:InZone(Players{zone:Graveyard, players:All})}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$clause}, otherwise:Program{}}] */
instructions_optional_destroy_graveyard_arrival ::= "you" "may" "destroy" "target" filter_phrase "." NEWLINE? "if" "that" filter_phrase "is" "put" "into" "a" "graveyard" "this" "way" "," clause

/* Preserve the independent optional-program scope reading. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:Destroy{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@agree($filter_phrase, $filter_phrase_2)}), index:0}), regeneration:true}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:InZone(Players{zone:Graveyard, players:All})}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$clause}, otherwise:Program{}}]}}] */
instructions_optional_destroy_graveyard_arrival_nested ::= "you" "may" "destroy" "target" filter_phrase "." NEWLINE? "if" "that" filter_phrase "is" "put" "into" "a" "graveyard" "this" "way" "," clause

/* @sem Condition::Compare{left:CountObjects(Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any})), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
own_graveyard_card_threshold ::= "there" "are" number "or" "more" "cards" "in" "your" "graveyard"

/* Counter predicates compose with an independently bound object reference. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$object_counter_test} */
condition_object_counter_test ::= object_ref object_counter_test

object_counter_test ::= counter_test_lacks_named_an_it | counter_test_had_minimum_it | counter_test_has_named_him | counter_test_has_even_it

/* @sem ObjectFilter::Counters{kind:$counter_kind, comparison:GreaterOrEqual, value:$value} */
counter_test_had_minimum_it ::= "had" value "or" "more" counter_kind "counters" "on" "it"

/* @sem ObjectFilter::Counters{kind:$counter_kind, comparison:Greater, value:Constant(0)} */
counter_test_has_named_him ::= "has" "a" counter_kind "counter" "on" "him"

/* @sem ObjectFilter::Counters{comparison:SameParity, value:Constant(0)} */
counter_test_has_even_it ::= "has" "an" "even" "number" "of" "counters" "on" "it"

/* The active player and step both constrain a static effect's window. */
/* @sem Condition::AllOf([PlayerIsActive(AbilityController), Window(EndStep)]) */
window_during_your_end_step ::= "during" "your" "end" "step"

/* @sem Condition::AllOf([PlayerIsActive(AbilityController), Window(Upkeep)]) */
window_during_your_upkeep_step ::= "during" "your" "upkeep"

/* A single quantified player supplies the subject of each predicate. */
/* @sem Condition::ExistsPlayer{players:$quantified_player_set, binding:0, condition:$quantified_player_predicate} */
condition_quantified_player ::= quantified_player_set quantified_player_predicate

quantified_player_set ::= fewer_an_opponent | event_a_player

quantified_player_predicate ::= quantified_player_life | quantified_player_protects

/* @sem Condition::Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:$quantified_life_bound, value:$value}} */
quantified_player_life ::= "has" value quantified_life_bound "life"

quantified_life_bound ::= partition_at_most | bound_or_more

/* @sem Condition::ObjectMatches{object:$object_ref, filter:ProtectedBy(One(Bound(0)))} */
quantified_player_protects ::= "protects" object_ref

/* A strict upper bound on one referenced object’s counters. */
/* @sem ObjectFilter::Counters{kind:$counter_kind, comparison:Less, value:$value} */
object_counter_fewer_than ::= "has" "fewer" "than" value counter_kind "counters" "on" "it"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:$object_counter_fewer_than} */
condition_object_counter_threshold ::= object_ref object_counter_fewer_than

/* @sem Condition::ObjectMatches{object:$object_ref, filter:$condition_exact_counter_plural} */
condition_object_exact_counter ::= object_ref "has" condition_exact_counter_plural "on" "it"

/* The event recipient loses if the controller has reached the threshold. */
/* @sem Program::Program{instructions:[If{condition:$condition_ring_temptations_at_least, then:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(EventSubject), action:KeywordAction::LoseGame}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::RingTempts}}]}}]} */
ring_threshold_recipient_loss ::= "that" "player" "loses" "the" "game" "if" condition_ring_temptations_at_least "." "otherwise" "," "the" "Ring" "tempts" "you" "."

/* @sem ObjectFilter::AnyOf([EnteredFrom(Players{zone:Graveyard, players:All}), Cast{from:Players{zone:Graveyard, players:All}}]) */
event_group_graveyard_origin_plural ::= "entered" "or" "were" "cast" "from" "a" "graveyard"

/* The threshold is measured per player, across combat damage this turn. */
/* @sem Condition::ExistsPlayer{players:All, binding:0, condition:Compare{left:EventHistory{event:Damage(_{source_kind:Any, sources:Any, recipients:Players(One(Bound(0))), kind:Combat, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}} */
condition_player_combat_damage_threshold ::= "a" "player" "was" "dealt" number "or" "more" "combat" "damage" "this" "turn"

/* Both colors must have been spent on this spell. */
/* @sem Condition::AllOf([Compare{left:ManaSpent{object:Source, filter:_{colors:[Red]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, Compare{left:ManaSpent{object:Source, filter:_{colors:[$red_pair_second]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}]) */
condition_red_green_spent ::= "{" "R" "}" "{" red_pair_second "}" "was" "spent" "to" "cast" "this" "spell"

red_pair_second ::= red_pair_white | red_pair_blue | red_pair_black | red_pair_green

/* @sem ManaColor::White */
red_pair_white ::= "W"

/* @sem ManaColor::Blue */
red_pair_blue ::= "U"

/* @sem ManaColor::Black */
red_pair_black ::= "B"

/* @sem ManaColor::Green */
/* @prefer always */
red_pair_green ::= "G"

/* No damage event has been recorded for this permanent during the game. */
/* @sem Condition::ObjectMatches{object:$self_explicit_ref, filter:Condition(Not(Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:SameObject(Candidate), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Source}), window:ThisGame, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}))} */
condition_object_hasnt_dealt_damage_yet ::= self_explicit_ref "hasn't" "dealt" "damage" "yet"

/* The two named permanents are independently required. */
/* @sem Condition::AllOf([Controls{player:AbilityController, filter:AllOf([$noun, Name($referenced_card_name)]), minimum:1}, Controls{player:AbilityController, filter:AllOf([$noun_2, Name($referenced_card_name_2)]), minimum:1}]) */
condition_two_named_types ::= "you" "control" "an" noun "named" referenced_card_name "and" "a" noun "named" referenced_card_name

/* Event outcome is interpreted within the enclosing triggered ability. */
/* @sem Condition::Not($event_outcome_condition) */
condition_negated_event_outcome ::= "it" "isn't" event_outcome_condition

/* @sem Condition::Outcome(TappedForAttacking) */
event_outcome_condition ::= "being" "declared" "as" "an" "attacker"

/* The controller and excluded object both belong to the Aura's attachment. */
/* @sem Condition::Not(Controls{player:$attached_control_subject, filter:$other_attached_filter, minimum:1}) */
condition_attached_controller_none_other ::= attached_control_subject "no" other_attached_filter

/* @sem PlayerRef::ControllerOf(AttachedTo(Source)) */
attached_control_subject ::= "its" "controller" "controls"

/* @sem ObjectFilter::AllOf([$filter_plural, Not(SameObject(AttachedTo(Source)))]) */
other_attached_filter ::= "other" filter_plural

/* The player population and the absence test are independent operands. */
/* @sem Condition::Compare{left:CountPlayers($absent_player_state_population), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_absent_player_state ::= "there" "is" "no" absent_player_state_population

/* @sem PlayerSet::Intersection([All, Matching{binding:0, condition:PlayerState{player:Bound(0), state:Monarch}}]) */
absent_player_state_population ::= "monarch"

/* @sem Condition::Compare{left:$event_player_counter_count, test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_event_player_no_counters ::= "they" "don't" "have" "any" event_player_counter_count

/* @sem Expr::CountCounters(_{recipients:Players(One(@that_player)), kind:$counter_kind, information:CurrentOrLastKnown}) */
event_player_counter_count ::= counter_kind "counters"

/* The population and counter filter are retained independently of the threshold. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:$affected, filter:$present_named_counter}), test:$condition_at_least} */
condition_objects_with_counter_threshold ::= condition_at_least affected "have" "an" present_named_counter "on" "them"

/* @sem ObjectFilter::Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)}) */
present_named_counter ::= counter_kind "counter"

/* Named dungeon completion keeps the player and dungeon as independent operands. */
/* @sem Condition::Not(CompletedDungeon{player:$condition_you, name:$completed_dungeon_name}) */
condition_not_completed_named_dungeon ::= condition_you "haven't" "completed" completed_dungeon_name

completed_dungeon_name ::= completed_dungeon_tomb | completed_dungeon_lost_mine | completed_dungeon_mad_mage

/* @sem String::'Tomb of Annihilation' */
completed_dungeon_tomb ::= "Tomb" "of" "Annihilation"

/* @sem String::'Lost Mine of Phandelver' */
completed_dungeon_lost_mine ::= "Lost" "Mine" "of" "Phandelver"

/* @sem String::'Dungeon of the Mad Mage' */
completed_dungeon_mad_mage ::= "Dungeon" "of" "the" "Mad" "Mage"

/* Count the subset of a battlefield population in a current combat state. */
/* @sem Expr::CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, filter:$combat_population_state}) */
combat_population_count ::= filter_phrase "is" combat_population_state

combat_population_state ::= adjective_attacking | adjective_blocking

/* @sem Condition::Compare{left:$combat_population_count, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}} */
condition_combat_population ::= counter_amount combat_population_count

/* The characteristic is shared by the two printed comparisons. */
/* @sem Condition::ObjectMatches{object:$it_ordinary_pronoun, filter:Property{property:$least_stat_tie, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$plural_head}, property:$least_stat_tie, aggregation:Minimum}}}} */
condition_it_least_stat_tied ::= it_ordinary_pronoun "has" "the" "least" least_stat_tie "among" plural_head "on" "the" "battlefield"

least_stat_tie ::= least_power_tie | least_toughness_tie

/* @sem Property::Power */
least_power_tie ::= "power" "or" "is" "tied" "for" "least" "power"

/* @sem Property::Toughness */
least_toughness_tie ::= "toughness" "or" "is" "tied" "for" "least" "toughness"

/* The subject is the source in the enclosing self-entry trigger. */
/* @sem Condition::ObjectMatches{object:Source, filter:InZone(Shared(Battlefield))} */
event_subject_on_battlefield ::= "it's" "on" "the" "battlefield"

/* @sem Condition::ObjectMatches{object:Source, filter:InZone(Shared(Exile))} */
event_subject_in_exile ::= "it's" "in" "exile"

event_subject_zone_condition ::= event_subject_on_battlefield | event_subject_in_exile

/* The threshold refers to this spell's announced X. */
/* @sem Condition::Compare{left:AnnouncedX, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_announced_x_at_least ::= "X" "is" value "or" "more"

/* The attack history belongs to the controller and to the current turn. */
/* @sem Condition::Compare{left:EventHistory{event:Object{event:Attacks, objects:AllOf([AnyOf([$subtype, $subtype_2]), ControlledBy(One(AbilityController))])}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
attacked_type_pair_condition ::= "you" "attacked" "with" "a" subtype "or" subtype

/* This phrase is scoped by its enclosing producer to the immediately recorded cards. */
/* @sem Condition::SubsetMeets{objects:Recorded(@marked), comparison:GreaterOrEqual, amount:$value, constraints:[CommonProperty(Names)]} */
exiled_cards_shared_name_threshold ::= "if" value "or" "more" "of" "those" "cards" "have" "the" "same" "name"

/* Used only with the mill producer that marks this receipt. */
/* @sem Condition::SubsetMeets{objects:Recorded(@marked), comparison:Equal, amount:$card_count, constraints:[CommonProperty(Colors)]} */
milled_shared_color_condition ::= "if" card_count "that" "share" "a" "color" "were" "milled" "this" "way"

/* Used only inside the immediately enclosing repeatable mill producer. */
/* @sem Condition::SubsetMeets{objects:Matching{objects:Recorded(@marked), filter:$adjective_nontype}, comparison:Equal, amount:$value, constraints:[CommonProperty(Colors)]} */
milled_common_color_condition ::= "if" value adjective_nontype "cards" "that" "share" "a" "color" "were" "milled" "this" "way"

/* A singular battlefield population is shared by existential phrasings. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase} */
battlefield_singular_population ::= filter_phrase

/* @sem Condition::Compare{left:CountObjects($battlefield_singular_population), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_battlefield_subject_an ::= "an" battlefield_singular_population "is" "on" "the" "battlefield"

/* @sem Condition::Compare{left:CountObjects($battlefield_singular_population), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_battlefield_subject_a ::= "a" battlefield_singular_population "is" "on" "the" "battlefield"

/* A battlefield population and its predicate stay separate operands. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:$counter_kind_source_population, filter:$battlefield_present_predicate}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_exists_battlefield_predicate ::= counter_kind_source_population battlefield_present_predicate

battlefield_present_predicate ::= counter_test_has_named_it | counter_test_has_even_it

/* @sem ObjectFilter::Counters{kind:$counter_kind, comparison:Greater, value:Constant(0)} */
counter_test_has_named_it ::= "has" "a" counter_kind "counter" "on" "it"

/* @sem ObjectFilter::AllOf([$filter_phrase, Property{property:Power, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}]) */
receipt_card_power_bound_a ::= "a" filter_phrase "card" "with" "power" "less" "than" "or" "equal" "to" value

/* @sem ObjectFilter::AllOf([$filter_phrase, Property{property:Power, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}]) */
receipt_card_power_bound_an ::= "an" filter_phrase "card" "with" "power" "less" "than" "or" "equal" "to" value

receipt_card_power_bound ::= receipt_card_power_bound_a | receipt_card_power_bound_an

/* The spell whose spending is measured remains an explicit operand. */
/* @sem Condition::Compare{left:ManaSpent{object:$object_ref, filter:_{}, aggregation:MaximumPerColor}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_same_color_spent_object ::= "at" "least" value "mana" "of" "the" "same" "color" "was" "spent" "to" "cast" object_ref

/* @sem Condition::Not(Controls{player:$condition_control_subject, filter:AllOf([$filter_plural, $modifier_with_keyword_family]), minimum:1}) */
condition_control_none_keyword ::= condition_control_subject "no" filter_plural modifier_with_keyword_family

/* The referring target is announced by the enclosing single-target action. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Target{slot:@last_slot, index:0})), SharesNameWith(Target{slot:@last_slot, index:0})])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
other_permanent_same_target_name ::= "another" "permanent" "with" "the" "same" "name" "is" "on" "the" "battlefield"

/* The threshold and attachment kind belong to the object being described. */
/* @sem ObjectFilter::AttachedCount{attachments:$subtype_plural, comparison:GreaterOrEqual, value:$number} */
predicate_attachment_minimum ::= "enchanted" "by" number "or" "more" subtype_plural

/* The explicit subject remains available to a following instruction. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$predicate_attachment_minimum} */
attachment_threshold_condition ::= object_ref "is" predicate_attachment_minimum

/* The producer and test share a player and the discard receipt.  Keeping them
   together proves the meaning of “discards ... this way” in both directions. */
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One($target_player), amount:$card_count}}, Effect{result:@mark, operation:Discard{players:One($target_player), amount:$card_count_2, random:false}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$filter_phrase}), test:Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$clause}, otherwise:Program{}}] */
instructions_draw_discard_filtered_receipt ::= target_player "draws" card_count "," "then" "discards" card_count "." "if" "that" "player" "discards" "an" filter_phrase "card" "this" "way" "," clause

/* A difference compares two independently bound life totals. */
/* @sem Condition::Compare{left:$life_total_difference, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}} */
condition_difference_bounded ::= life_total_difference "is" value "or" "less"

/* @sem Expr::Difference($life_total_operand, $life_total_operand_2) */
life_total_difference ::= "the" "difference" "between" life_total_operand "and" life_total_operand

life_total_operand ::= value_your_life | difference_life_total_possessive

/* @sem Expr::PlayerNumber{player:$target_possessive, number:Life} */
difference_life_total_possessive ::= target_possessive "life" "total"

/* The subject is an opponent, while the comparison population retains its own controller. */
/* @sem Condition::Compare{left:PlayerNumber{player:$opponent_life_subject, number:Life}, test:$another_opponent_life_test} */
condition_opponent_life_against_another ::= opponent_life_subject "has" another_opponent_life_test

opponent_life_subject ::= event_defender_opponent | target_opponent

/* The attack defender is distinct from the event actor. */
/* @sem PlayerRef::EventOtherPlayer */
event_defender_opponent ::= "that" "opponent"

/* @sem NumberTest::Compare{comparison:Greater, value:AmongPlayers{players:OpponentsOf(AbilityController), number:Life, aggregation:Minimum}} */
another_opponent_life_test ::= "more" "life" "than" "another" "of" "your" "opponents"

/* @sem Condition::ObjectMatches{object:$self_explicit_ref, filter:Property{property:ColorCount, test:NumberTest::Compare{comparison:Less, value:Constant(5)}}} */
condition_not_all_colors ::= self_explicit_ref "isn't" "all" "colors"

/* A resolution-time condition chooses between two complete programs. */
/* @sem Program::Program{instructions:[If{condition:$condition, then:$program, otherwise:$program_2}]} */
program_conditional_postposed_else ::= program "if" condition "." "otherwise" "," program

/* @sem Condition::Controls{player:AbilityController, filter:AllOf([$noun, Property{property:$stat, test:NumberTest::Compare{comparison:$bound, value:$number}}]), minimum:1} */
fight_before_condition ::= "you" "control" "a" noun "with" stat number "or" bound

/* The cast or copy event supplies the stack object being tested. */
/* @sem Condition::ObjectMatches{object:EventSubject, filter:OnStack(SingleTarget)} */
condition_event_spell_single_target ::= "it" "has" "a" "single" "target"

/* The single discard and its conditional return share the same receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Discard{players:One(AbilityController), amount:Constant(1), random:true}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:PayCost{player:FirstWilling(All), cost:_{parts:[Life($value)]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@marked, phase:After, index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{}}]}, otherwise:Program{}}] */
instructions_discard_return_unless_paid ::= "discard" "a" "card" "at" "random" "." "if" "you" "discard" "a" filter_phrase "card" "this" "way" "," "return" "it" "from" "your" "graveyard" "to" "the" "battlefield" "unless" "any" "player" "pays" value "life"

/* A singular player reference is the same player as another singular reference. */
/* @sem Condition::Compare{left:CountPlayers(Intersection([One($player_ref), One($identity_player)])), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
condition_player_identity ::= player_ref "is" identity_player

identity_player ::= condition_you | player_ref

/* The same player supplies current and starting life; comparison and divisor
   are shared operands. The threshold rounds up for these two comparisons. */
/* @sem Condition::Compare{left:PlayerNumber{player:$player_ref, number:Life}, test:NumberTest::Compare{comparison:$starting_life_ceil_comparison, value:Divide{numerator:StartingLife($player_ref), denominator:$starting_life_fraction, rounding:Up}}} */
condition_player_starting_life_fraction ::= player_ref "has" starting_life_ceil_comparison starting_life_fraction "their" "starting" "life" "total"

starting_life_ceil_comparison ::= comparison_less | comparison_greater_equal

/* @sem Expr::Constant(2) */
starting_life_fraction ::= "half"

/* A named player and an exact life threshold compose independently. */
/* @sem Condition::Compare{left:PlayerNumber{player:$player_ref, number:Life}, test:$you_life_exact} */
condition_player_exact_life ::= player_ref "has" you_life_exact

/* The defending player is the one associated with this attack's subject. */
/* @sem Condition::Compare{left:CountPlayers(Intersection([One(AbilityController), One(DefendingPlayerOf(EventSubject))])), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
shared_you_defending_attacker ::= "you're" "the" "defending" "player"

/* Each alternative counts casts of its own spell filter this turn. */
/* @sem ObjectFilter::$spell_type_after_or */
first_cast_type_a ::= spell_type_after_or

/* @sem ObjectFilter::$spell_type_after_or */
first_cast_type_b ::= spell_type_after_or

/* @sem Condition::ObjectMatches{object:EventSubject, filter:AnyOf([NthCast{ordinal:Constant(1), spells:$first_cast_type_a, by:One(AbilityController), scope:Turn}, NthCast{ordinal:Constant(1), spells:$first_cast_type_b, by:One(AbilityController), scope:Turn}, NthCast{ordinal:Constant(1), spells:AllOf([$subtype, Not(SameObject(Source))]), by:One(AbilityController), scope:Turn}])} */
condition_first_three_cast_types ::= "it's" "the" "first" first_cast_type_a "spell" "," "the" "first" first_cast_type_b "spell" "," "or" "the" "first" subtype "spell" "other" "than" SELF_NAME "you've" "cast" "this" "turn"

/* The explicit subject supplies the antecedent for the following sentence. */
/* @sem Condition::ObjectMatches{object:@remember_object($self_explicit_ref), filter:$filter_phrase} */
shared_holder_is_a_filter ::= self_explicit_ref "is" "a" filter_phrase

/* A linked exile population is nonempty for the named object. */
/* @sem Condition::ObjectMatches{object:$linked_exile_card_source, filter:Property{property:ExiledCount, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}} */
condition_any_linked_exile_cards ::= "there" "are" linked_exile_card_source

/* The entering source is the event subject in this scoped entry phrase. */
/* @sem Condition::ObjectMatches{object:EventSubject, filter:State(CostPaid($condition_alternative_cost_name))} */
entry_subject_alternative_cost_paid ::= "this" "creature's" condition_alternative_cost_name "cost" "was" "paid"

/* @sem Condition::Not(Compare{left:EventHistory{event:Batch{event:Attack{attackers:Any, by:One(Chosen), defenders:Players(One(AbilityController))}, per:Defender}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
chosen_player_didnt_attack_you ::= "they" "didn't" "attack" "you" "that" "turn"

/* The exploit event identifies the sacrificed creature. This condition is only
   used inside the scoped exploit trigger below, after a draw that cannot replace
   that event's sacrifice. */
/* @sem Condition::Compare{left:Earlier{what:Sacrificed, measure:Count, filter:Property{property:$stat, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
exploit_sacrificed_stat_threshold ::= "the" "exploited" "creature" "had" stat value "or" "greater"

/* @sem Ability::Triggered{event:$event_exploits_subject, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}, If{condition:$exploit_sacrificed_stat_threshold, then:Program{instructions:[Effect{result:@next, operation:$operation}]}, otherwise:Program{}}]}} */
triggered_exploit_draw_stat ::= "whenever" event_exploits_subject "," "draw" card_count "." "if" exploit_sacrificed_stat_threshold "," operation "."

/* Used only by an activation that proves the second cost is a single discard. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:CostObjects{payment:Activation, component:[1], view:Performed, phase:Before}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
discard_payment_card_was ::= "the" "discarded" "card" "was" "a" filter_phrase "card"

/* Compare the triggering roll with a reusable die-result test. */
/* @sem Condition::Compare{left:EventAmount, test:$die_result_minimum} */
condition_trigger_roll_comparison ::= "the" "roll" "was" die_result_minimum

/* A casting reference is shared by snow and source-restricted mana tests. */
/* @sem $object_ref */
spent_cast_object ::= "to" "cast" object_ref

/* @sem Condition::Compare{left:ManaSpent{object:$spent_cast_object, filter:_{snow:true}, aggregation:Count}, test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
condition_snow_mana_spent ::= "{" "S" "}" "was" "spent" spent_cast_object

/* The antecedent is supplied by the enclosing combat-recipient trigger. */
/* @sem Condition::Compare{left:PlayerNumber{player:EventSubject, number:Life}, test:NumberTest::Compare{comparison:$bound_words, value:$number}} */
combat_recipient_life_condition ::= "that" "player" "has" number bound_words "life"

/* The revealed card supplies the comparison value independently of the target. */
/* @sem Condition::ObjectMatches{object:ObjectRef::@it, filter:Property{property:$stat, test:NumberTest::Compare{comparison:$stat_comparison, value:Earlier{what:Revealed, measure:Of($receipt_stat)}}}} */
condition_target_revealed_property ::= "its" stat "is" stat_comparison "the" "revealed" "card's" receipt_stat

/* Two controlled permanent categories and controlled spells share a recipient history. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$controlled_damage_category_history} */
condition_history_controlled_damage_to ::= controlled_damage_category_history "dealt" "damage" "to" object_ref "this" "turn"

/* @sem ObjectFilter::AnyOf([Condition(Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:AllOf([ControlledBy(One(AbilityController)), $damage_source_category]), recipients:Objects(SameObject(Candidate)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}), Condition(Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:AllOf([ControlledBy(One(AbilityController)), $filter_phrase]), recipients:Objects(SameObject(Candidate)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}), Condition(Compare{left:EventHistory{event:Damage(_{source_kind:Spell, sources:ControlledBy(One(AbilityController)), recipients:Objects(SameObject(Candidate)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})]) */
controlled_damage_category_history ::= "a" damage_source_category "," filter_phrase "," "or" "spell" "you" "controlled"

damage_source_category ::= damage_source_giant | filter_phrase

/* @prefer always */
/* @sem ObjectFilter::Subtype(Giant) */
damage_source_giant ::= "Giant"

/* The referenced creature retains its target identity across the preceding move. */
/* @sem Condition::ObjectMatches{object:@it, filter:Not(Token)} */
condition_that_creature_wasnt_token ::= "that" "creature" "wasn't" "a" "token"

exact_hand_location ::= exact_hand_location_plain | exact_hand_location_your

/* @prefer always */
/* @sem Zone::Hand */
exact_hand_location_plain ::= "in" "hand"

/* @sem Zone::Hand */
exact_hand_location_your ::= "in" "your" "hand"

/* A source's damage history excludes that same source from the recipient filter. */
/* @sem Condition::ObjectMatches{object:Source, filter:$self_damage_another_history} */
condition_self_damage_another_turn ::= self_text self_damage_another_history

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:SameObject(Candidate), recipients:Objects(AllOf([Not(SameObject(Source)), $filter_phrase])), kind:Any, grouping:SourceRecipient, subject:Source}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
self_damage_another_history ::= "dealt" "damage" "to" "another" filter_phrase "this" "turn"

/* This filter is used only within a scoped single-card exile producer. */
/* @sem ObjectFilter::$single_exile_card_filter */
single_exile_arrival_filter ::= "a" single_exile_card_filter "card" "is" "exiled" "this" "way"

single_exile_card_filter ::= filter_phrase | adjective_nontype

/* Bind the condition to this controller's discard, including when printing edited IR. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}, Effect{result:@mark, operation:Discard{players:One(AbilityController), amount:$card_count_2, random:false}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$filter_phrase}), test:Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$instructions}, otherwise:Program{}}] */
instructions_you_draw_discard_filtered_receipt ::= "draw" card_count "," "then" "discard" card_count "." "if" "you" "discarded" "an" filter_phrase "card" "this" "way" "," instructions

/* The prior object retains its identity when tested by its former spell characteristics. */
/* @sem Condition::ObjectMatches{object:$it_ordinary_pronoun, filter:$filter_phrase} */
condition_anaphoric_past_spell_kind ::= it_ordinary_pronoun "was" "a" filter_phrase "spell"

/* The enclosing repeatable table starts with its one die roll. */
/* @prefer always */
/* @sem Condition::AllOf([Compare{left:DieResult(0), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}, Compare{left:DieResult(0), test:NumberTest::Compare{comparison:LessOrEqual, value:$value_2}}]) */
repeat_die_range ::= value "―" value

/* Preserve both previously supported antecedent interpretations. */
/* @sem Condition::ObjectMatches{object:Result{result:@marked, phase:Before, index:0}, filter:Counters(_{comparison:Greater, value:Constant(0)})} */
destroy_counter_condition_receipt ::= "that" "artifact" "had" "counters" "on" "it"

/* @sem Condition::ObjectMatches{object:Target{slot:0, index:0}, filter:Counters(_{comparison:Greater, value:Constant(0)})} */
destroy_counter_condition_target ::= "that" "artifact" "had" "counters" "on" "it"

destroy_counter_condition ::= destroy_counter_condition_receipt | destroy_counter_condition_target

/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))} */
condition_active_opponent_turn ::= "it's" "an" "opponent's" "turn"

/* The named source and masculine anaphor refer to the same counter holder. */
/* @sem Condition::ObjectMatches{object:$self_ref_named, filter:Counters(_{kind:$counter_kind, comparison:LessOrEqual, value:$value})} */
condition_named_counters_fewer_him ::= self_ref_named "has" value "or" "fewer" counter_kind "counters" "on" "him"

/* The holder and counter kind are independent operands of this state test. */
/* condition_holder_no_named_counters is shared as condition_self_no_counters. */

/* The paired object must satisfy both the stated kind and the keyword qualifier. */
/* @sem ObjectFilter::PairedWith(@and($filter_phrase, $modifier_with_keyword_family)) */
paired_with_qualified_a ::= "paired" "with" "a" filter_phrase modifier_with_keyword_family

/* The permanent explicitly identifies the ability's source. */
/* @sem Condition::ObjectMatches{object:Source, filter:$noun} */
condition_this_permanent_is_an ::= "this" "permanent" "is" "an" noun

/* State threshold on the explicitly described holder. */
/* @sem Condition::ObjectMatches{object:$self_ref_holder, filter:Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$value})} */
condition_holder_counters_at_least ::= self_ref_holder "has" value "or" "more" counter_kind "counters" "on" "it"

/* The threshold describes the last-known mana value of the event subject. */
/* @sem Condition::ObjectMatches{object:EventSubject, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number_digits}}} */
event_mana_value_was_at_least ::= "its" "mana" "value" "was" number_digits "or" "greater"

/* Other attackers exclude the trigger subject and are counted against the named defender. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:Not(SameObject(EventSubject))}, filter:AttackingDefender(Players($players_singular))}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_no_other_attacking_player ::= "no" "other" "creatures" "are" "attacking" players_singular

/* @prefer always */
/* @sem Condition::ObjectMatches{object:@self, filter:State(CostPaid(Additional))} */
spell_paid_cost_additional ::= "additional"

/* @sem Condition::Outcome(MayhemPaid) */
spell_paid_cost_mayhem ::= "mayhem"

spell_paid_cost_condition ::= spell_paid_cost_additional | spell_paid_cost_mayhem

/* The entry and exile uses refer to different aspects of unearth. Keep the
   condition paired with its event so neither meaning leaks to the other. */
/* @sem Condition::ObjectMatches{object:EventSubject, filter:State(Unearthed)} */
entrant_was_unearthed ::= "it" "was" "unearthed"

/* @sem Condition::Outcome(Unearthed) */
exiled_was_unearthed ::= "it" "was" "unearthed"

unearthed_entry_event ::= unearthed_entry_zone_event | unearthed_entry_player_event

/* @sem EventSpec::ZoneChange{objects:$controlled_entrant, to:Battlefield} */
unearthed_entry_zone_event ::= "whenever" controlled_entrant "enters"

/* @sem EventSpec::Player{event:EntersUnderControl, players:All, objects:$controlled_entrant} */
unearthed_entry_player_event ::= "whenever" controlled_entrant "enters"

/* @sem EventSpec::ZoneChange{objects:$controlled_entrant, from:Battlefield, to:Exile} */
unearthed_exile_event ::= "whenever" controlled_entrant "is" "exiled"

/* @sem Ability::Triggered{event:$unearthed_entry_event, intervening_if:$entrant_was_unearthed, limits:TriggerLimits{}, announcement:@announcement, body:$unearthed_entry_program} */
unearthed_entry_trigger ::= unearthed_entry_event "," "if" entrant_was_unearthed "," unearthed_entry_program

/* @sem Ability::Triggered{event:$unearthed_exile_event, intervening_if:$exiled_was_unearthed, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence} */
unearthed_exile_trigger ::= unearthed_exile_event "," "if" exiled_was_unearthed "," program_sentence

unearthed_entry_program ::= program_sentence | entrant_indefinite_pump

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(EventSubject)), changes:$singular_pump, duration:Indefinite, evaluation:Snapshot}}]} */
entrant_indefinite_pump ::= "it" singular_pump "."

/* Keep the return and its counted receipt together, including its destination. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:AllOf([$filter_plural_2, ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}, then:Program{instructions:$clause}, otherwise:Program{}}] */
instructions_return_owners_hand_threshold ::= "return" "all" filter_plural "to" "their" "owners'" "hands" "." "if" "you" "return" value "or" "more" filter_plural "you" "control" "this" "way" "," clause

/* A die-result population and its count test are independent operands. */
/* @sem Expr::Dice(Matching([Equal, $value])) */
dice_results_you_rolled ::= "you" "rolled" value

/* @sem NumberTest::Compare{comparison:Equal, value:$value} */
dice_count_exact_plural ::= "exactly" value "times"

/* @sem NumberTest::Compare{comparison:Equal, value:Constant(1)} */
dice_count_exact_singular ::= "exactly" "once"

dice_count_test ::= dice_count_exact_plural | dice_count_exact_singular

/* @sem Condition::Compare{left:$dice_results_you_rolled, test:$dice_count_test} */
condition_dice_count_comparison ::= dice_results_you_rolled dice_count_test

/* The subject is stated by the enclosing phrase; the outcome describes the prior guess. */
/* @sem Condition::Outcome(GuessedWrong) */
guess_wrong_outcome ::= "guessed" "wrong"

/* @sem Condition::$guess_wrong_outcome */
condition_the_player_guess_outcome ::= "the" "player" guess_wrong_outcome

/* Prospective actions describe the referenced object, retaining the affected filter. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$prospective_object_filter} */
condition_object_prospective ::= object_ref prospective_object_filter

/* @sem ObjectFilter::WouldDestroy($prospective_destroyed_filter) */
prospective_object_filter ::= "would" "destroy" prospective_destroyed_filter

prospective_destroyed_filter ::= tap_event_singular_a | selected_keyword_filter_an

/* Both predicates apply to the same object, including the cast referenced by it. */
/* @sem ObjectFilter::AnyOf([$object_condition_not_cast, $object_condition_no_mana_cast]) */
object_condition_cast_or_no_mana ::= object_condition_not_cast "or" object_condition_no_mana_cast

/* @sem ObjectFilter::Not(Cast{}) */
object_condition_not_cast ::= "wasn't" "cast"

/* @sem ObjectFilter::Condition(Compare{left:ManaSpent{object:Candidate, filter:_{}, aggregation:Count}, test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}) */
object_condition_no_mana_cast ::= "no" "mana" "was" "spent" "to" "cast" "it"

conditional_combat_state ::= adjective_attacking | adjective_blocking

/* A past sacrifice tests occurrences by the controller, retaining the object filter. */
/* @sem Condition::Compare{left:EventHistory{event:Player{event:Sacrifices, players:One(AbilityController), objects:$filter_phrase}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_you_sacrificed_this_turn ::= "you" "sacrificed" "a" filter_phrase "this" "turn"

/* A card entering exile during this turn is a historical zone-change condition. */
/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:Any, to:Exile}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_card_exile_this_turn ::= "a" "card" "was" "put" "into" "exile" "this" "turn"

/* The producer and its passive test are one contract, including on inverse printing. */
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}, Effect{result:@mark, operation:Discard{players:One(AbilityController), amount:$card_count_2, random:false}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$filter_phrase}), test:Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$instructions}, otherwise:Program{}}] */
instructions_controller_discard_passive_receipt ::= "draw" card_count "," "then" "discard" card_count "." "if" "a" filter_phrase "card" "is" "discarded" "this" "way" "," instructions

/* In an event clause, other members exclude the event's subject. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(EventSubject)), $filter_plural, ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
event_subject_other_control_threshold ::= "you" "control" "at" "least" value "other" filter_plural

/* The bound opponent is the caster of the qualifying spell. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:EventHistory{event:Spell{event:Cast, players:One(Bound(0)), spells:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}} */
condition_opponent_cast_mana_value ::= "an" "opponent" "has" "cast" "a" "spell" "with" "mana" "value" number "or" "less" "this" "turn"

/* The predicate describes the referenced object at the triggering event. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Attacking} */
past_combat_condition ::= object_ref "was" "attacking"

/* A threshold over either of two card kinds in the controller's graveyard. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$repeat_mana_card_union}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
condition_graveyard_either_kind_threshold ::= "there" "are" number "or" "more" repeat_mana_card_union "cards" "in" "your" "graveyard"

/* Count a filtered population in the ability controller's graveyard.  This
   spelling is scoped to its consumer so it does not change other defaults. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$card_filter}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}} */
condition_personal_graveyard_filtered_at_least ::= "there" "are" count "or" "more" card_filter "cards" "in" "your" "graveyard"

/* A combat-history predicate scoped to conditional static rules. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:AnyOf([Condition(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}), State(BlockedThisTurn)])} */
condition_attacked_or_blocked_turn ::= object_ref "attacked" "or" "blocked" "this" "turn"

/* A singular event subject is tested against the independently described kind. */
/* @sem Condition::ObjectMatches{object:EventSubject, filter:$filter_phrase} */
event_subject_is_a_filter ::= "it's" "a" filter_phrase

/* Two distinct colors paid for the same spell. Repeated white uses the separate count-two rule. */
/* @sem Condition::AllOf([Compare{left:ManaSpent{object:$object_ref, filter:_{colors:[White]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, Compare{left:ManaSpent{object:$object_ref, filter:_{colors:[$white_pair_second]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}]) */
condition_white_distinct_symbol_spent ::= "{" "W" "}" "{" white_pair_second "}" "was" "spent" "to" "cast" object_ref

white_pair_second ::= red_pair_blue | red_pair_black | conditional_green_pair_red | letter_green

/* Both explicit tests concern the same triggering creature and are complements. */
/* @sem Program::Program{instructions:[If{condition:ObjectMatches{object:EventSubject, filter:ControlledBy(One(AbilityController))}, then:$program, otherwise:Program{instructions:$event_creature_controller_clause}}]} */
creature_control_branch ::= program "if" "you" "control" "that" "creature" "." "if" "you" "don't" "control" "it" "," event_creature_controller_clause

/* @sem @apply(PlayerSet::One(PlayerRef::ControllerOf(EventSubject)), $verbs_third) */
event_creature_controller_clause ::= "its" "controller" verbs_third

/* The discard and its conditional consumer share the selected player and the Before receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Discard{players:One($randomly_selected_target_player), amount:$card_count, random:false}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:$program, otherwise:Program{}}] */
instructions_selected_player_discard_test ::= randomly_selected_target_player "." "that" "player" "discards" card_count "." "if" "that" "player" "discards" "a" filter_phrase "card" "this" "way" "," program

/* A previously mentioned object must remain on the battlefield. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:InZone(Shared(Battlefield))} */
condition_referenced_still_battlefield ::= object_ref "is" "still" "on" "the" "battlefield"

/* Three alternative controlled populations share the explicit controller. */
/* @sem Condition::AnyOf([Controls{player:$condition_control_subject, filter:$filter_phrase, minimum:1}, Controls{player:$condition_control_subject, filter:$filter_phrase_2, minimum:1}, Controls{player:$condition_control_subject, filter:$filter_phrase_3, minimum:1}]) */
condition_control_three_alternatives ::= condition_control_subject "a" filter_phrase "," "a" filter_phrase "," "or" "a" filter_phrase

/* Scoped to a preceding death, whose subject has already left the battlefield. */
/* @sem Condition::Compare{left:CountObjects($battlefield_singular_population), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
shared_other_battlefield_condition ::= "another" battlefield_singular_population "is" "on" "the" "battlefield"

/* The population and comparison retain independent editable operands. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$hand_singular_card}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
condition_hand_any_card ::= "you" "have" hand_singular_card "in" "hand"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$hand_plural_cards}), test:NumberTest::Compare{comparison:Greater, value:$count_plural}} */
condition_hand_more_cards ::= "you" "have" "more" "than" count_plural hand_plural_cards "in" "hand"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$hand_one_card}), test:NumberTest::Compare{comparison:Greater, value:Constant(1)}} */
condition_hand_more_one_card ::= "you" "have" "more" "than" "one" hand_one_card "in" "hand"

/* The condition is scoped to the immediately preceding whole-hand reveal of
   the event player; no other reveal or intervening action can supply it. */
/* @sem Instruction::[$callback_choose_name, Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One(EventSubject)}, kind:Card, filter:Any}}}, If{condition:Compare{left:CountObjects(Matching{objects:Zone{scope:Players{zone:Hand, players:One(EventSubject)}, kind:Card, filter:Any}, filter:Chosen(CardName)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$card_count_one}}, then:Program{instructions:$instructions}, otherwise:Program{}}] */
instructions_chosen_name_revealed_hand ::= callback_choose_name "." "that" "player" "reveals" "their" "hand" "." "if" card_count_one "with" "the" "chosen" "name" "is" "revealed" "this" "way" "," instructions

/* A casting condition composes the opponent predicate with another condition. */
/* @sem Condition::AllOf([$condition_opponent_controls_an, $condition_one]) */
condition_cast_opponent_and ::= condition_opponent_controls_an "and" condition_one

/* Keep the discard producer and its passive receipt test in one inverse contract. */
/* @sem Instruction::[Effect{result:@mark, operation:Discard{players:One(AbilityController), amount:$card_count, random:false}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count_2}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$filter_phrase}), test:Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$instructions}, otherwise:Program{}}] */
instructions_discard_draw_passive_receipt ::= "discard" card_count "," "then" "draw" card_count "." "if" "a" filter_phrase "card" "is" "discarded" "this" "way" "," instructions

condition_or_if_first ::= condition_one | condition_or_if_it_a

/* @sem Condition::ObjectMatches{object:@it, filter:$filter_phrase} */
condition_or_if_it_a ::= "it's" "a" filter_phrase

/* Distinct colors spent on the same spell are independent requirements. */
/* @sem Condition::AllOf([Compare{left:ManaSpent{object:$spent_spell, filter:_{colors:[Green]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, Compare{left:ManaSpent{object:$spent_spell, filter:_{colors:[$green_pair_second]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}]) */
condition_green_pair_spent ::= "{" "G" "}" "{" green_pair_second "}" "was" "spent" "to" "cast" spent_spell

green_pair_second ::= red_pair_white | red_pair_blue | red_pair_black | conditional_green_pair_red

condition_paid_alternative ::= condition_control_other_event | condition_control_another

/* In this continuation, another excludes the subject of the triggering event. */
/* @sem Condition::Controls{player:$condition_control_subject, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::EventSubject)), $filter_phrase), minimum:1} */
condition_control_other_event ::= condition_control_subject "another" filter_phrase

/* @sem Condition::ObjectMatches{object:Source, filter:State(Bargained)} */
condition_this_spell_bargained ::= "this" "spell" "was" "bargained"

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}) */
object_attacked_count_turn ::= "attacked" number "or" "more" "times" "this" "turn"

/* An empty filtered hand is a count of the controller's actual cards. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_no_filtered_cards_hand ::= "you" "have" "no" filter_phrase "cards" "in" "your" "hand"

/* The gendered self-reference follows the card's own naming convention. */
/* @sem ObjectRef::@self */
cast_her ::= "her"

/* Compare like battlefield populations across all other players. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$plural_head, ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:Greater, value:AmongPlayers{players:OthersThan(AbilityController), number:Permanents($plural_head), aggregation:Maximum}}} */
condition_control_more_each_other ::= "you" "control" "more" plural_head "than" "each" "other" "player"

/* Both restrictions apply to the same activation. */
/* @sem Condition::AllOf([$activation_cast_window, $activation_defending_controls]) */
window_during_and_if ::= "during" activation_cast_window "and" "only" "if" activation_defending_controls

/* The activation restriction names the defending player in its own frame. */
activation_defending_controls ::= activation_defending_controls_one | activation_defending_controls_no_snow

/* The former characteristic applies to the explicitly referenced object. */
/* past_indefinite_filter is shared as tap_event_singular_a. */

die_result_comparison_test ::= die_result_upper_test | die_result_greater_damage | die_result_exact

/* @sem NumberTest::Compare{comparison:Greater, value:EventAmount} */
die_result_greater_damage ::= "greater" "than" "the" "damage" "dealt"

/* The resolving spell itself has this cast ordinal, unlike a casting-time test. */
/* @sem Condition::ObjectMatches{object:Source, filter:NthCast{ordinal:$random_damage_spell_ordinal, spells:Any, by:One(AbilityController), scope:Game}} */
resolution_first_spell_game ::= "this" "spell" "is" "the" random_damage_spell_ordinal "spell" "you've" "cast" "this" "game"

/* The matching population is the card observation from the preceding producer. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:Observed(@prior), filter:SharesNameWithAny(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase})}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}} */
observed_card_shared_name_condition ::= "it" "has" "the" "same" "name" "as" counter_amount filter_phrase

/* The snow mana must match a color of the spell named by the pronoun. */
/* @sem Condition::ObjectMatches{object:$it_ordinary_pronoun, filter:State(SnowManaOfOwnColorSpent)} */
spell_own_color_snow_spent ::= "{" "S" "}" "of" "any" "of" "that" "spell's" "colors" "was" "spent" "to" "cast" it_ordinary_pronoun

/* A resolution-time branch follows an earlier instruction. */
/* @sem Instruction::If{condition:$condition, then:$program, otherwise:$program_2} */
resolution_if_otherwise ::= "if" condition "," program "." "otherwise" "," program "."

/* Independent origin predicates share the enclosing object condition. */
/* @sem ObjectFilter::EnteredFrom(Players{zone:$greatest_card_zone, players:All}) */
past_entered_from_any_player_zone ::= "entered" "from" "a" greatest_card_zone

/* @sem ObjectFilter::Cast{by:One(AbilityController), from:Players{zone:$greatest_card_zone, players:All}} */
past_controller_cast_from_any_player_zone ::= "you" "cast" "it" "from" "a" greatest_card_zone

/* The possessive identifies the holder whose alternative cost was paid. */
/* @sem Condition::ObjectMatches{object:$sneak_cost_subject, filter:State(CostPaidThisTurn(Sneak))} */
condition_sneak_paid_this_turn ::= sneak_cost_subject "sneak" "cost" "was" "paid" "this" "turn"

sneak_cost_subject ::= sneak_cost_her

/* @prefer always */
/* @sem ObjectRef::@self */
sneak_cost_her ::= "her"

/* The past subject is bound by the enclosing event. */
/* @sem Condition::ObjectMatches{object:@it, filter:$filter_phrase} */
condition_she_was_kind ::= "she" "was" "a" filter_phrase

/* Attack occurrences retain the controlled population and threshold. This spelling
   is scoped to activation limits to avoid introducing unrelated condition parses. */
/* activation_attack_history is shared as linked_play_attacked_with. */

/* Both tests measure the same previously mentioned player’s hand. */
/* @sem Condition::AnyOf([Compare{left:CountObjects(Zone(_{scope:Players{zone:Hand, players:One(PlayerRef::@that_player_literal)}, kind:Card, filter:Any})), test:NumberTest::Compare{comparison:Equal, value:$hand_size_alternative}}, Compare{left:CountObjects(Zone(_{scope:Players{zone:Hand, players:One(PlayerRef::@that_player_literal)}, kind:Card, filter:Any})), test:NumberTest::Compare{comparison:Equal, value:$hand_size_card_count}}]) */
condition_they_hand_alternatives ::= "they" "have" "exactly" hand_size_alternative "or" "exactly" hand_size_card_count "in" "hand"

/* The named source is the same object as the masculine counter referent. */
/* @sem Condition::ObjectMatches{object:Source, filter:Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})} */
named_source_positive_counters_him ::= self_named "has" "one" "or" "more" counter_kind "counters" "on" "him"

/* The singular top-card test counts matching cards in the controller's library. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_top_card_counted_a ::= "the" "top" "card" "of" "your" "library" "is" "a" filter_phrase "card"

/* The referenced spell retains its own spending and mana value. */
/* @sem Condition::ObjectMatches{object:EventSubject, filter:State(ManaSpentBelowManaValue)} */
condition_mana_spent_below_value ::= "the" "amount" "of" "mana" "spent" "to" "cast" "it" "was" "less" "than" "its" "mana" "value"

/* Each population keeps the event subject and its own zone. */
/* @prefer always */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:SharesNameWith(EventSubject)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_same_name_graveyard ::= "a" "card" "with" "the" "same" "name" "is" "in" "a" "graveyard"

/* @prefer always */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, SharesNameWith(EventSubject)])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_same_name_battlefield_a ::= "a" filter_phrase "with" "the" "same" "name" "is" "on" "the" "battlefield"

/* @prefer always */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, SharesNameWith(EventSubject)])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_same_name_battlefield_an ::= "an" filter_phrase "with" "the" "same" "name" "is" "on" "the" "battlefield"

/* @prefer always */
/* @sem Condition::AnyOf([$condition_same_name_graveyard, $condition_same_name_battlefield]) */
condition_same_name_zones ::= condition_same_name_graveyard "or" condition_same_name_battlefield

condition_same_name_battlefield ::= condition_same_name_battlefield_a | condition_same_name_battlefield_an

/* The compared object and the population are independently bound. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Property{property:Power, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, property:Power, aggregation:Maximum}}}} */
condition_greatest_power_tied ::= object_ref "has" "the" "greatest" "power" "or" "is" "tied" "for" "greatest" "power" "among" filter_plural "on" "the" "battlefield"

/* A control condition tests the candidate's current statistic against its own base. */
/* @sem Condition::Controls{player:$condition_control_subject, filter:@and($filter_phrase, $candidate_base_comparison), minimum:1} */
condition_control_base_comparison_a ::= condition_control_subject "a" filter_phrase candidate_base_comparison

/* @sem Condition::Controls{player:$condition_control_subject, filter:@and($filter_phrase, $candidate_base_comparison), minimum:1} */
condition_control_base_comparison_an ::= condition_control_subject "an" filter_phrase candidate_base_comparison

/* @sem ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:$stat_comparison, value:Expr::ObjectProperty{object:Candidate, property:$candidate_base_property, information:CurrentOrLastKnown}}} */
candidate_base_comparison ::= "with" stat stat_comparison "its" "base" candidate_base_property

candidate_base_property ::= candidate_base_power | candidate_base_toughness

/* @sem Property::BasePower */
candidate_base_power ::= "power"

/* @sem Property::BaseToughness */
candidate_base_toughness ::= "toughness"

/* @sem Condition::ObjectMatches{object:@it, filter:AnyOf([$subtype, $subtype_2])} */
anaphoric_subtype_pair ::= "it's" "a" subtype "or" subtype

/* Two distinct colors each contribute at least one mana. */
/* @sem Condition::AllOf([Compare{left:ManaSpent{object:Source, filter:_{colors:[White]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, Compare{left:ManaSpent{object:Source, filter:_{colors:[$white_pair_other]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}]) */
condition_white_other_spent ::= "{" "W" "}" "{" white_pair_other "}" "was" "spent" "to" "cast" "this" "spell"

white_pair_other ::= red_pair_blue | red_pair_black | conditional_green_pair_red | red_pair_green

/* The complete hand reveal and adjacent test share the same player and population. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone(_{scope:Players{zone:Hand, players:One($revealed_hand_test_player)}, kind:Card, filter:Any})}}, If{condition:Compare{left:CountObjects(Matching{objects:Zone(_{scope:Players{zone:Hand, players:One($revealed_hand_test_player)}, kind:Card, filter:Any}), filter:$revealed_hand_test_filter}), test:NumberTest::Compare{comparison:Equal, value:$revealed_hand_test_count}}, then:$then_condition_program, otherwise:Program{}}] */
instructions_revealed_hand_exact_count ::= revealed_hand_test_player "reveals" "exactly" revealed_hand_test_count "cards" revealed_hand_test_filter "," then_condition_program

/* @sem $target_opponent */
revealed_hand_test_opponent ::= target_opponent "reveals" "their" "hand" "." "if" "that" "opponent"

/* @sem $target_player */
revealed_hand_test_target_player ::= target_player "reveals" "their" "hand" "." "if" "that" "player"

revealed_hand_test_player ::= revealed_hand_test_opponent | revealed_hand_test_target_player

/* @sem Expr::ChosenNumber */
revealed_hand_chosen_count ::= "the" "chosen" "number" "of"

revealed_hand_test_count ::= revealed_hand_chosen_count | count_plural

revealed_hand_test_filter ::= modifier_chosen_color | modifier_chosen_type

/* This intensity belongs to the resolving spell. */
/* @sem Condition::ObjectMatches{object:Source, filter:Property{property:Intensity, test:NumberTest::Compare{comparison:Equal, value:$number}}} */
condition_spell_intensity_equal ::= "this" "spell's" "intensity" "is" number

/* Both predicates keep their separate object and named battlefield population. */
/* @sem Condition::AllOf([ObjectMatches{object:$object_ref, filter:AllOf([OwnedBy(One(AbilityController)), ControlledBy(One(AbilityController))])}, Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@and($filter_phrase, ObjectFilter::Name($referenced_card_name)), OwnedBy(One(AbilityController)), ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}]) */
condition_own_control_object_and_named ::= "you" "both" "own" "and" "control" object_ref "and" "a" filter_phrase "named" referenced_card_name

/* Only the enclosing single-card exile supplies this arrival. */
/* @sem ObjectFilter::$filter_phrase */
single_exile_was_filter ::= "a" filter_phrase "card" "was" "exiled" "this" "way"

/* Both predicates refer to the player supplied by the enclosing event. */
/* @prefer always */
/* @sem Condition::AllOf([PlayerIn{player:EventSubject, players:$condition_event_player_relation}, $condition_event_player_hand_predicate]) */
condition_event_player_conjunction ::= "the" "player" "is" condition_event_player_relation "and" condition_event_player_hand_predicate

/* @sem PlayerSet::OpponentsOf(AbilityController) */
condition_event_player_relation ::= "your" "opponent"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(EventSubject)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:$bound_words, value:$value}} */
condition_event_player_hand_predicate ::= "has" value bound_words "cards" "in" "hand"

/* One opponent independently satisfies the draw-history threshold. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:EventHistory{event:Player{event:Draws, players:One(Bound(0))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}} */
condition_opponent_draw_threshold ::= "an" "opponent" "has" "drawn" value "or" "more" "cards" "this" "turn"

/* @prefer always */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:EventHistory{event:Player{event:Draws, players:One(Bound(0))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number_words}}} */
condition_opponent_draw_words ::= "an" "opponent" "has" "drawn" number_words "or" "more" "cards" "this" "turn"

/* @prefer always */
/* @sem PlayerSet::All */
existential_possessive_any_player ::= "a" "player's"

existential_possessive_players ::= existential_possessive_any_player | token_replacement_opponents

/* @sem Condition::Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:LessOrEqual, value:Divide{numerator:StartingLife(Bound(0)), denominator:$starting_life_fraction, rounding:Up}}} */
bound_possessive_life_le_half ::= "life" "total" "is" "less" "than" "or" "equal" "to" starting_life_fraction "their" "starting" "life" "total"

/* @sem Condition::Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:Less, value:Divide{numerator:StartingLife(Bound(0)), denominator:$starting_life_fraction, rounding:Up}}} */
bound_possessive_life_lt_half ::= "life" "total" "is" "less" "than" starting_life_fraction "their" "starting" "life" "total"

/* The exile action and its condition share the exact arrival receipt.  The
   destination filter excludes replacement moves to another zone. */
exile_singular_graveyard_target ::= graveyard_any_one | graveyard_typed_one

/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:$exile_singular_graveyard_target, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:InZone(Shared(Exile))}, then:Program{instructions:$clause}, otherwise:Program{}}] */
instructions_exile_graveyard_arrival_if ::= "exile" exile_singular_graveyard_target "." "if" "a" "card" "is" "put" "into" "exile" "this" "way" "," clause

/* The historical attacker is the player introduced by the trigger. */
/* @sem Condition::Compare{left:EventHistory{event:Attack{attackers:Any, by:One(@that_player), defenders:$attack_defender}, window:ThisCombat, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_they_attacked_defender ::= "they" "attacked" attack_defender

/* The two characteristics are compared to the corresponding characteristics
   of the stated object, keeping that object distinct from the subject. */
/* @sem ObjectFilter::AnyOf([Property{property:Power, test:NumberTest::Compare{comparison:Greater, value:ObjectProperty{object:$object_ref, property:Power, information:CurrentOrLastKnown}}}, Property{property:Toughness, test:NumberTest::Compare{comparison:Greater, value:ObjectProperty{object:$object_ref, property:Toughness, information:CurrentOrLastKnown}}}]) */
relative_greater_power_or_toughness ::= "greater" "power" "or" "toughness" "than" object_ref

/* @sem Condition::ObjectMatches{object:$object_ref, filter:$relative_greater_power_or_toughness} */
condition_object_has_relative_stats ::= object_ref "has" relative_greater_power_or_toughness

/* Either property of an attacking event-group member may satisfy the same test. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:EventGroup, filter:AnyOf([Property{property:$creature_stat, test:NumberTest::Compare{comparison:Equal, value:$cast_comparison_value}}, Property{property:$creature_stat_2, test:NumberTest::Compare{comparison:Equal, value:$cast_comparison_value}}])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_event_group_stat_either ::= "any" "of" "those" "creatures" "have" creature_stat "or" creature_stat "equal" "to" cast_comparison_value

/* The comparison excludes the bound player from the competing population. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}), test:NumberTest::Compare{comparison:Greater, value:AmongPlayers{players:OthersThan(Bound(0)), number:Permanents($filter_plural), aggregation:Maximum}}} */
bound_player_each_control ::= "controls" "more" filter_plural "than" "each" "other" "player"

/* Each alternative is independently sufficient to satisfy the control test. */
/* @sem Condition::AnyOf(@unordered([Controls{player:AbilityController, filter:$noun, minimum:1}, Controls{player:AbilityController, filter:$subtype, minimum:1}, Controls{player:AbilityController, filter:$subtype_2, minimum:1}, ...$control_three_kind_tail])) */
condition_control_six_kinds ::= "you" "control" "a" noun "," subtype "," subtype "," control_three_kind_tail

/* @sem Vec<Condition>::@unordered([Controls{player:AbilityController, filter:$subtype, minimum:1}, Controls{player:AbilityController, filter:$subtype_2, minimum:1}, Controls{player:AbilityController, filter:$subtype_3, minimum:1}]) */
control_three_kind_tail ::= subtype "," subtype "," "or" subtype

/* @sem ObjectFilter::ControlledBy(One(Chosen)) */
retarget_controller_chosen ::= "controlled" "by" "the" "chosen" "player"

/* @sem ObjectFilter::ControlledBy(One(AbilityController)) */
retarget_controller_you ::= "controlled" "by" "you"

retarget_controller_filter ::= retarget_controller_chosen | retarget_controller_you

/* @sem ObjectFilter::State(FirstLandPlayedThisTurn) */
past_first_land_played_this_turn ::= "the" "first" "land" "you" "played" "this" "turn"

/* The phase and its player are separate operands. The contracted subject
   describes a time window, not an object referred to by "it". */
/* @sem Condition::Not(PlayerState{player:$zone_your, state:$possessive_phase_state}) */
condition_not_possessive_phase ::= "it" "isn't" zone_your possessive_phase_state

/* The counted objects must themselves be lands, independently of their qualifiers. */
/* @sem Expr::CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Land), AnyOf([Supertype(Basic), $filter_phrase, $filter_phrase_2]), ControlledBy(One(AbilityController))])}, property:Names} */
battlefield_among_distinct_land_names ::= "lands" "with" "different" "names" "among" "the" "basic" "," filter_phrase "," "and" filter_phrase "lands" "you" "control"

/* Every member of the named extreme population must be controlled by you. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:$each_battlefield_extreme, filter:Not(ControlledBy(One(AbilityController)))}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_control_each_extreme ::= "you" "control" each_battlefield_extreme

/* An anaphoric permanent has no recorded damage event in this game. */
/* @sem Condition::ObjectMatches{object:$it_ordinary_pronoun, filter:Condition(Not(Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:SameObject(Candidate), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Source}), window:ThisGame, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}))} */
condition_it_hasnt_dealt_damage_yet ::= it_ordinary_pronoun "hasn't" "dealt" "damage" "yet"

/* The stack object is an activated ability restricted to non-mana abilities. */
/* condition_not_mana_ability is shared as activated_ability_nonmana_condition. */

/* Negated monarch designation test for the ability controller. */
/* @sem Condition::Not(PlayerState{player:AbilityController, state:Monarch}) */
condition_not_monarch ::= "you're" "not" "the" "monarch"

/* The named player had another matching permanent enter under their control this turn. */
/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:AllOf([Not(SameObject(EventSubject)), $filter_phrase, ControlledBy(One($player_ref))]), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_player_had_another_entered_turn ::= player_ref "had" "another" filter_phrase "enter" "the" "battlefield" "under" "their" "control" "this" "turn"

/* Controlling a permanent meeting a battlefield extreme retains its head type in the filter. */
/* @sem Condition::Controls{player:$condition_control_subject, filter:@and($filter_nonlist_head, $modifier_extreme_among), minimum:1} */
condition_control_extreme_a ::= condition_control_subject "a" filter_nonlist_head modifier_extreme_among

/* @sem Condition::Controls{player:$condition_control_subject, filter:@and($filter_nonlist_head, $modifier_extreme_among), minimum:1} */
condition_control_extreme_an ::= condition_control_subject "an" filter_nonlist_head modifier_extreme_among

/* @sem Condition::ObjectMatches{object:@remember_object($object_ref), filter:AnyOf(@unordered([$adjective_color, $adjective_color_2]))} */
condition_object_color_pair ::= object_ref "is" adjective_color "or" adjective_color

/* @sem Condition::AllOf([Window(FirstCombat), PlayerIsActive(AbilityController)]) */
condition_first_combat_own_turn ::= "it's" "the" "first" "combat" "phase" "of" "your" "turn"

/* Land-play history composes its event and its separately counted occurrences. */
/* @sem Condition::Compare{left:EventHistory{event:$past_controller_land_play, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$past_land_count}} */
past_controller_land_history ::= "you've" past_controller_land_play past_land_count "this" "turn"

past_land_count ::= past_one_land | past_many_lands

/* @sem $counter_a */
past_one_land ::= counter_a "land"

/* @sem $count_plural */
past_many_lands ::= count_plural "lands"

/* This test establishes the creature attached to the Aura's enchanted host. */
/* @sem Condition::ObjectMatches{object:$enchanted_other_ref, filter:AttachedTo(InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}))} */
condition_enchanted_host_attached_creature ::= enchanted_other_ref "is" "attached" "to" "a" "creature"

/* A counter absence test on the explicitly identified ability holder. */
/* @sem Condition::ObjectMatches{object:$self_ref_holder, filter:Counters(_{kind:$counter_kind, comparison:Equal, value:Constant(0)})} */
condition_holder_lacks_counter ::= self_ref_holder "doesn't" "have" "a" counter_kind "counter" "on" "it"

/* The event subject is the spell in a cast-triggered ability. */
/* @sem Condition::ObjectMatches{object:EventSubject, filter:$subtype} */
condition_cast_spell_subtype ::= "that" "spell" "is" "a" subtype

/* The compared population remains a live independent operand. */
/* @sem ObjectFilter::SharesMostCommonColor($affected) */
most_common_color_filter ::= "the" "most" "common" "color" "among" affected "or" "a" "color" "tied" "for" "most" "common"

/* @sem Condition::ObjectMatches{object:@it, filter:$most_common_color_filter} */
condition_it_shares_most_common_color ::= "it" "shares" "a" "color" "with" most_common_color_filter

/* Coming under control this turn is a current-control test and a control-duration test. */
/* @sem Condition::ObjectMatches{object:$it_ref, filter:AllOf([ControlledBy(One(AbilityController)), Not(State(ControlledSinceTurnBegan))])} */
condition_came_under_control_this_turn ::= it_ref "came" "under" "your" "control" "this" "turn"

/* A source at the start of an ability needs an explicit antecedent. */
/* @sem Condition::ObjectMatches{object:$self_creature, filter:$object_did_not_attack_turn} */
/* @prefer always */
condition_this_creature_did_not_attack_turn ::= self_creature object_did_not_attack_turn

/* @sem Condition::ObjectMatches{object:$object_ref, filter:Cast{by:One(AbilityController), from:Players{zone:Graveyard, players:One(AbilityController)}}} */
condition_you_cast_from_graveyard ::= "you" "cast" object_ref "from" "your" "graveyard"

/* @sem Condition::ObjectMatches{object:$object_ref, filter:Cast{by:One(AbilityController), from:Players{zone:Library, players:One(AbilityController)}}} */
condition_you_cast_from_library ::= "you" "cast" object_ref "from" "your" "library"

/* A property test can introduce its target before subsequent pronouns. */
/* @prefer always */
/* @sem Condition::ObjectMatches{object:$target_permanent, filter:Property{property:$stat, test:NumberTest::Compare{comparison:$bound, value:$number}}} */
condition_announced_property ::= target_permanent "has" stat number "or" bound

/* @sem Condition::ObjectMatches{object:EventSubject, filter:AllOf([OnStack(SingleTarget), TargetsAny(Objects(One(Source)))])} */
condition_event_spell_targets_only_source_creature ::= "that" "spell" "targets" "only" "this" "creature"

/* Unqualified counters include every kind on the referenced object. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Counters(_{comparison:GreaterOrEqual, value:$value})} */
condition_there_are_any_counters_at_least ::= "there" "are" value "or" "more" "counters" "on" object_ref

/* @sem ActivationLimits::ActivationLimits{condition:Compare{left:$value, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value_2}}} */
activation_value_minimum ::= "activate" "only" "if" value "is" value "or" "greater"

/* The entering subject remains on the battlefield and the controller's
   named population is bounded independently of the event. */
/* @sem Condition::AllOf([ObjectMatches{object:EventSubject, filter:InZone(Shared(Battlefield))}, Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$named_plural_population, ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}]) */
shared_entry_named_count_condition ::= "it's" "on" "the" "battlefield" "and" "you" "control" number "or" "fewer" named_plural_population

/* Within an attack-group trigger, count the attacking permanents at the stated defender. */
/* @prefer always */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$attack_group_defender}, filter:Attacking}), test:$condition_at_least} */
condition_attack_group_defender_count ::= condition_at_least "of" "those" "creatures" "are" attack_group_defender

/* @sem ObjectFilter::AttackingDefender(PlayersAndPlaneswalkers(One(AbilityController))) */
attack_group_defender ::= "attacking" "you" "and" "/" "or" "planeswalkers" "you" "control"

/* Negative cast tests retain the referenced object and the named origin zone. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Not(Cast{from:Players{zone:$greatest_card_zone, players:All}})} */
condition_you_didnt_cast_from_zone ::= "you" "didn't" "cast" object_ref "from" "your" greatest_card_zone

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
no_linked_cards ::= "there" "are" "no" "cards" "exiled" "with" self_enchantment

/* @sem Condition::Controls{player:DefendingPlayer, filter:$filter_phrase, minimum:1} */
/* @prefer always */
activation_defending_controls_one ::= "defending" "player" "controls" "a" filter_phrase

/* @sem Condition::Not(Controls{player:DefendingPlayer, filter:AllOf([Supertype(Snow), $plural]), minimum:1}) */
activation_defending_controls_no_snow ::= "defending" "player" "controls" "no" "snow" plural

/* The same property is compared for the event subject and the holder. */
/* @sem Condition::ObjectMatches{object:EventSubject, filter:Property{property:$creature_stat, test:Compare{comparison:$event_stat_comparison, value:ObjectProperty{object:Source, property:$creature_stat, information:CurrentOrLastKnown}}}} */
/* @prefer always */
event_creature_stat_comparison ::= "that" "creature's" creature_stat "is" event_stat_comparison "this" "creature's"

event_stat_comparison ::= comparison_greater | comparison_less

/* The land play and filtered spell cast share this-turn history and the controller. */
/* @sem Condition::AnyOf([PlayerDid{player:AbilityController, event:PlayedLandNotFromHand, window:ThisTurn}, Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:@and($spell_filter, ObjectFilter::Not(Cast{from:Players{zone:Hand, players:All}}))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}]) */
condition_play_land_or_cast_outside_hand ::= "you've" "played" "a" "land" "or" "cast" spell_filter "this" "turn" "from" "anywhere" "other" "than" "your" "hand"

/* The named opponent is compared with every other player. */
/* @sem Condition::Compare{left:PlayerNumber{player:@that_opponent, number:Speed}, test:NumberTest::Compare{comparison:Greater, value:AmongPlayers{players:OthersThan(@that_opponent), number:Speed, aggregation:Maximum}}} */
condition_opponent_speed_lead ::= "that" "opponent's" "speed" "is" "greater" "than" "each" "other" "player's" "speed"

/* Preserve the independently supported unqualified historical attacker reading. */
/* @sem Condition::Compare{left:EventHistory{event:Attack{attackers:Any, defenders:$attack_defender}, window:ThisCombat, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_they_attacked_any_defender ::= "they" "attacked" attack_defender

/* The condition describes the stated object, with the control exception scoped to it. */
/* @sem Condition::ObjectMatches{object:$self_explicit_ref, filter:AnyOf([Condition(Not(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})), AllOf([ControlledBy(One(AbilityController)), Not(State(ControlledSinceTurnBegan))])])} */
condition_object_attack_or_new_control ::= self_explicit_ref "didn't" "attack" "or" "come" "under" "your" "control" "this" "turn"

/* Used only with the immediately preceding complete-hand reveal payment. */
/* @sem Condition::SubsetMeets{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, comparison:GreaterOrEqual, amount:$value, constraints:[DifferentProperty(ManaValue)]} */
revealed_hand_distinct_values ::= "cards" "with" "at" "least" value "different" "mana" "values" "are" "revealed" "this" "way"

/* Unqualified nonattackers in a combat-triggered effect use this combat. */
/* @sem ObjectFilter::Condition(Not(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisCombat, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})) */
nonattacking_this_combat ::= "that" "didn't" "attack"

/* Devotion thresholds spelled as words retain that form when operands change. */
/* @prefer always */
/* @sem Condition::Compare{left:CountManaSymbols{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:ControlledBy(One(AbilityController))}, colors:[$mana_color_word, $mana_color_word_2]}, test:NumberTest::Compare{comparison:Less, value:$number_words}} */
condition_devotion_pair_less_words ::= "your" "devotion" "to" mana_color_word "and" mana_color_word "is" "less" "than" number_words

/* The condition consumes the immediately preceding discard receipt. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Discard{players:One(AbilityController), amount:Constant(1), random:false}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$adjective_color}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:$program, otherwise:Program{}}]} */
discard_one_color_conditional_program ::= "discard" "a" "card" "." "if" "a" adjective_color "card" "is" "discarded" "this" "way" "," program

/* @sem Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[CostPart::Loyalty($loyalty)]}, limits:ActivationLimits{sorcery:true}, announcement:@announcement, body:$discard_one_color_conditional_program} */
activated_discard_one_color_conditional ::= "[" loyalty "]" ":" discard_one_color_conditional_program "."

/* @sem ObjectFilter::AnyOf([$adjective_color, $adjective_color_2]) */
condition_color_and_or ::= adjective_color "and" "/" "or" adjective_color

/* @sem Condition::ObjectMatches{object:@it, filter:$condition_color_and_or} */
condition_that_target_color ::= "that" "target" "is" condition_color_and_or

/* Casting-time reveal and selection remain separate tests. */
/* @sem Condition::AsCast{player:AbilityController, action:Revealed($filter_phrase)} */
cast_revealed_card ::= "you" "revealed" "a" filter_phrase "card"

/* @sem Condition::AsCast{player:AbilityController, action:Chose(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase})} */
cast_chose_permanent ::= "chose" "a" filter_phrase

/* @sem Condition::ObjectMatches{object:Source, filter:AnyOf([Condition(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}), State(BlockedThisTurn)])} */
condition_source_attacked_or_blocked_this_turn ::= "this" "creature" "attacked" "or" "blocked" "this" "turn"

fewer_opponent_phrase ::= fewer_each_opponent | fewer_an_opponent

/* @prefer always */
/* @sem PlayerSet::OpponentsOf(AbilityController) */
fewer_each_opponent ::= "each" "opponent"

/* @sem PlayerSet::OpponentsOf(AbilityController) */
fewer_an_opponent ::= "an" "opponent"

/* The condition consumes the preceding destruction's singular result. */
/* @sem Instruction::[Effect{result:@mark, operation:Destroy{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$additional_creature_spell_filter}), index:0}), regeneration:true}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:Before, index:0}, filter:Any}, then:Program{instructions:$clause}, otherwise:Program{}}] */
instructions_destroy_creature_dies ::= "destroy" "target" additional_creature_spell_filter "." NEWLINE? "if" "that" "creature" "dies" "this" "way" "," clause

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_destroy_creature_dies}} */
spell_destroy_creature_dies ::= instructions_destroy_creature_dies "."

/* @sem ObjectFilter::State(DevouredACreature) */
object_condition_devoured_creature ::= "devoured" "a" "creature"

/* @sem Condition::ObjectMatches{object:Source, filter:ManaSpentFrom($filter_phrase)} */
condition_mana_from_spent_to_activate ::= "mana" "from" "a" filter_phrase "was" "spent" "to" "activate" "this" "ability"

/* The turn-event subject is the player whose spell history is counted. */
/* @sem Condition::Compare{left:EventHistory{event:Spell{event:Cast, players:One(EventSubject), spells:Any}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
opponent_turn_cast_threshold ::= "they" "cast" value "or" "more" "spells" "this" "turn"

/* The holder's battlefield-entry history is tested for the current turn. */
/* @sem Condition::ObjectMatches{object:$self_ref_holder, filter:Condition(Not(Compare{left:EventHistory{event:ZoneChange{objects:SameObject(Candidate), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}))} */
condition_holder_not_entered_this_turn ::= self_ref_holder "didn't" "enter" "the" "battlefield" "this" "turn"

/* Historical land entry in the audited event-player convention. */
/* @prefer always */
/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:AllOf([Not(SameObject(EventSubject)), ControlledBy(One($player_ref))]), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_event_player_prior_land_entry ::= player_ref "had" "another" "land" "enter" "the" "battlefield" "under" "their" "control" "this" "turn"

/* Other cards exclude the ability source; the named restriction compares names. */
/* @sem @and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::@named_source)), $filter_head) */
other_hand_card_head_shared ::= "other" filter_head "cards"

/* @sem Condition::Compare{left:CountObjects(Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$other_hand_card_head_shared})), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_other_hand_absent_shared ::= "you" "have" "no" other_hand_card_head_shared "in" "hand"

/* @sem Condition::Compare{left:CountObjects(Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:@and($other_hand_card_head_shared, ObjectFilter::Not(ObjectFilter::Name($referenced_card_name)))})), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_other_hand_only_named_shared ::= "the" "only" other_hand_card_head_shared "in" "your" "hand" "are" "named" referenced_card_name

/* Keep both tests in one branch so a separately seeded test cannot change either operand. */
/* @sem Condition::AnyOf([$condition_other_hand_absent_shared, $condition_other_hand_only_named_shared]) */
condition_other_hand_alternatives_shared ::= condition_other_hand_absent_shared "or" "if" condition_other_hand_only_named_shared

/* A combat history test over the currently attacking population. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:Condition(Compare{left:EventHistory{event:Attack{attackers:SameObject(Candidate), defenders:Players(One(AbilityController))}, window:ThisCombat, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})}, filter:Attacking}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_none_those_creatures_attacked_you ::= "none" "of" "those" "creatures" "attacked" "you"

/* The a-form is scoped to the casting condition, preserving other condition contexts. */
/* @sem Condition::AllOf([$condition_opponent_controls_a, $condition_one]) */
condition_cast_opponent_a_and ::= condition_opponent_controls_a "and" condition_one

/* A past attack keeps its attacker and defending player independent. */
/* @sem EventSpec::Batch{event:Attack{attackers:Any, by:One($player_ref), defenders:Players(One($condition_player))}, per:Defender} */
history_player_attack_batch ::= player_ref "attacked" condition_player

/* @sem Condition::Compare{left:EventHistory{event:$history_player_attack_batch, window:LastTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_attack_batch_last_turn ::= history_player_attack_batch "during" "their" "last" "turn"

/* The cast event subject is the spell whose spending is tested. */
/* @sem Condition::ObjectMatches{object:EventSubject, filter:Condition(Not(Compare{left:ManaSpent{object:Candidate, filter:_{colors:[$unspent_mana_symbol]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}))} */
condition_cast_event_symbol_unspent ::= "{" unspent_mana_symbol "}" "wasn't" "spent" "to" "cast" "it"

unspent_mana_symbol ::= mana_letter | unspent_colorless_symbol

/* @sem ManaColor::Colorless */
unspent_colorless_symbol ::= "C"

/* Count entries under the controller without changing the event or threshold. */
/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:AllOf([$filter_plural, ControlledBy(One(AbilityController))]), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_counted_controlled_entries_this_turn ::= "you" "had" value "or" "more" filter_plural "enter" "the" "battlefield" "under" "your" "control" "this" "turn"

/* A leading resolution condition encloses its complete program. */
/* @sem Program::Program{instructions:[If{condition:$condition, then:$program, otherwise:Program{}}]} */
conditional_resolution_program ::= "if" condition "," program

/* Count a qualified card population in each of the same three private zones. */
/* @sem Condition::Compare{left:CountObjects(Union([Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:@and($filter_phrase, $modifier_mana_value_bound)}, Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:@and($filter_phrase, $modifier_mana_value_bound)}, Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:@and($filter_phrase, $modifier_mana_value_bound)}])), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_three_zones_qualified_threshold ::= "there" "are" value "or" "more" filter_phrase "cards" modifier_mana_value_bound "among" "cards" "in" "your" "graveyard" "," "hand" "," "and" "library"

/* Count land plays by the ability controller during the current turn. */
/* @sem Condition::Compare{left:EventHistory{event:$past_controller_land_play, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$past_land_count}} */
condition_controller_played_land_history ::= "you" past_controller_land_play past_land_count "this" "turn"

/* Four separately controlled populations may overlap; each has its own test. */
/* @sem Condition::AllOf([Controls{player:$condition_control_subject, filter:$filter_phrase, minimum:1}, Controls{player:$condition_control_subject, filter:$filter_phrase_2, minimum:1}, Controls{player:$condition_control_subject, filter:$filter_phrase_3, minimum:1}, Controls{player:$condition_control_subject, filter:$filter_phrase_4, minimum:1}]) */
condition_control_four ::= condition_control_subject ("a" | "an") filter_phrase "," ("a" | "an") filter_phrase "," ("a" | "an") filter_phrase "," "and" ("a" | "an") filter_phrase

/* The referenced object is tested with its last known combat state. */
/* condition_object_was_attacking is shared as past_combat_condition. */

/* A source named here is the antecedent of a following counter placement. */
/* @sem Condition::ObjectMatches{object:$self_explicit_ref, filter:Counters(_{kind:$counter_kind, comparison:Equal, value:Constant(0)})} */
condition_source_lacks_counter ::= self_explicit_ref "doesn't" "have" "a" counter_kind "counter" "on" "it"

/* The same opponent is the caster of the qualifying spell. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:EventHistory{event:Spell{event:Cast, players:One(Bound(0)), spells:$spell_adjectives}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}} */
condition_opponent_cast_filtered_this_turn ::= "an" "opponent" "has" "cast" "a" spell_adjectives "spell" "this" "turn"

/* @sem ObjectFilter::TargetsAny(Objects($condition_targeted_population)) */
condition_targeting_one_an ::= "an" condition_targeted_population

/* Keep the disjunction together so unassigned swapped mined rule m_if_the_only_other_filter_phrase_cards_in cannot attach to a standalone first disjunct. */
/* @sem Condition::AnyOf([Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AllOf([Not(SameObject(Source)), @agree($filter_phrase, $filter_phrase_2)])}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}, Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AllOf([AllOf([Not(SameObject(Source)), @agree($filter_phrase, $filter_phrase_2)]), Not(Name($referenced_card_name))])}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}]) */
condition_no_other_or_only_named_hand ::= "you" "have" "no" "other" filter_phrase "cards" "in" "hand" "or" "if" "the" "only" "other" filter_phrase "cards" "in" "your" "hand" "are" "named" referenced_card_name

/* Count the currently damaged members of a battlefield population. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, filter:State(Damaged)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
condition_damaged_population_threshold ::= number "or" "more" filter_plural "are" "damaged"

/* Both origins refer to the event subject; the casting actor stays explicit. */
/* @sem Condition::ObjectMatches{object:EventSubject, filter:AnyOf([EnteredFrom(Players{zone:$greatest_card_zone, players:One(AbilityController)}), Cast{by:One(AbilityController), from:Players{zone:$greatest_card_zone_2, players:One(AbilityController)}}])} */
condition_event_entered_or_cast_from_owned_zone ::= "it" "entered" "from" "your" greatest_card_zone "or" "you" "cast" "it" "from" "your" greatest_card_zone

/* The event subject was cast by the controller from outside their hand. */
/* @sem Condition::ObjectMatches{object:EventSubject, filter:AllOf([Cast{by:One(AbilityController)}, Not(Cast{from:Players{zone:Hand, players:One(AbilityController)}})])} */
entrant_cast_outside_hand ::= "you" "cast" "it" "from" "anywhere" "other" "than" "your" "hand"

/* Scoped named-or-other controlled entry with cast-outside-hand check, avoiding event_controlled_self_or_enters collision. */
/* @sem Ability::Triggered{event:ZoneChange{objects:AnyOf([SameObject(Source), AllOf([Not(SameObject(Source)), $filter_phrase, ControlledBy(One(AbilityController))])]), to:Battlefield}, intervening_if:$entrant_cast_outside_hand, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence} */
triggered_named_entry_cast_outside_hand_if ::= "whenever" SELF_NAME "or" "another" filter_phrase "you" "control" "enters" "," "if" entrant_cast_outside_hand "," program_sentence

/* The linked population must still be in exile when the intervening-if is checked. */
/* @sem Condition::Compare{left:CountObjects(Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)})), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
condition_card_linked_exile_present ::= "a" "card" "is" "exiled" "with" object_ref

/* @sem Condition::PlayerDid{player:AbilityController, event:WasMonarch, window:ThisTurn} */
condition_was_monarch_turn_began ::= "you" "were" "the" "monarch" "as" "the" "turn" "began"

/* Past absence retains both the referenced object and the keyword family. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:Not($past_keyword_family)} */
condition_object_didnt_have_keyword_family ::= object_ref "didn't" "have" past_keyword_family

/* @sem ObjectFilter::HasKeywordFamily(Decayed) */
past_keyword_family_decayed ::= "decayed"

past_keyword_family ::= past_keyword_family_decayed

/* A draw occurrence threshold, retaining the player and the current turn. */
/* @sem Condition::Compare{left:EventHistory{event:$history_draw_perfect_event, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:Greater, value:$card_count}} */
condition_history_draw_more_than ::= history_draw_perfect_event "more" "than" card_count "this" "turn"

/* A resolving target's characteristic is tested after its announcement. */
/* @sem ObjectFilter::Property{property:$creature_stat, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}} */
conditional_creature_stat_ceiling ::= "its" creature_stat "is" number "or" "less"

/* @sem Condition::ObjectMatches{object:$self_ref_holder, filter:Counters{kind:$counter_kind, comparison:Greater, value:Constant(0)}} */
condition_holder_has_named_counters ::= self_ref_holder "has" counter_kind "counters" "on" "it"

/* The condition measures the immediately preceding discard's own before receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Discard{players:One(AbilityController), amount:$card_count, random:true}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:$program, otherwise:Program{}}] */
instructions_discard_filtered_conditional_an ::= "discard" card_count "at" "random" "." "if" "an" filter_phrase "card" "was" "discarded" "this" "way" "," program

/* @sem Instruction::[Effect{result:@mark, operation:Discard{players:One(AbilityController), amount:$card_count, random:true}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:$program, otherwise:Program{}}] */
instructions_discard_filtered_conditional_a ::= "discard" card_count "at" "random" "." "if" "a" filter_phrase "card" "was" "discarded" "this" "way" "," program

/* The linked population belongs to the source, not to a movement receipt. */
/* @sem Condition::ObjectMatches{object:Source, filter:Property{property:ExiledCount, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}} */
condition_source_linked_exile_threshold ::= number "or" "more" "cards" "have" "been" "exiled" "with" "this" "artifact"

/* The event subject's opponents are quantified individually. */
/* @sem Condition::ExistsPlayer{players:OpponentsOf(EventSubject), binding:0, condition:Compare{left:EventHistory{event:Damage(_{source_kind:Any, sources:Any, recipients:Players(One(Bound(0))), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}} */
event_opponent_was_dealt_damage ::= "one" "of" "their" "opponents" "was" "dealt" "damage" "this" "turn"

/* A past object action retains its actor, action and filtered population. */
/* @sem Condition::Compare{left:EventHistory{event:Player{event:$history_filtered_action, players:One($condition_you), objects:$filter_plural}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:$bound_or_more, value:$value}} */
condition_history_filtered_threshold ::= condition_you history_filtered_action value bound_or_more filter_plural "this" "turn"

/* A named source at the start of a condition must retain its explicit antecedent. */
/* @prefer always */
/* @sem Condition::ObjectMatches{object:$self_ref_named, filter:Condition(Compare{left:EventHistory{event:ZoneChange{objects:SameObject(Candidate), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})} */
condition_named_source_entered_this_turn ::= self_ref_named "entered" "this" "turn"

/* The enclosing trigger proves that its subject is the ability holder. */
/* @sem Condition::Not(Controls{player:AbilityController, filter:AllOf([Not(SameObject(EventSubject)), $filter_plural]), minimum:1}) */
condition_control_no_other_shared ::= "you" "control" "no" "other" filter_plural

/* @sem Condition::Window(FirstEndStep) */
condition_first_end_step ::= "it's" "the" "first" "end" "step" "of" "the" "turn"

/* The excluded object and controlled population are independent of the hand. */
/* @sem Condition::Not(Controls{player:AbilityController, filter:@and($filter_plural, ObjectFilter::Not(SameObject($object_ref))), minimum:1}) */
condition_control_none_except ::= "you" "control" "no" filter_plural "other" "than" object_ref

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_have_empty_hand ::= "have" "no" "cards" "in" "hand"

/* @sem Condition::AllOf([$condition_control_none_except, $condition_have_empty_hand]) */
condition_control_except_and_hand_empty ::= condition_control_none_except "and" condition_have_empty_hand

/* Count the controller's current battlefield population, with an exact bound. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}), test:Compare{comparison:Equal, value:$number_words}} */
condition_you_control_exact_count ::= "you" "control" "exactly" number_words filter_plural

/* The controller's draw and its zero-performed test share the same receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Draw{players:One(AbilityController), amount:$card_count}}, If{condition:Compare{left:Performed(@marked), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}, then:Program{instructions:$instructions}, otherwise:Program{}}] */
instructions_controller_draw_zero_receipt ::= "draw" card_count "." "if" "you" "didn't" "draw" "cards" "this" "way" "," instructions

/* The compared object's type and the maximum's population are independent. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$battlefield_extreme_filter} */
condition_object_is_extreme_kind ::= object_ref "is" "a" battlefield_extreme_filter

/* Other blockers exclude the ability source; the blocked object remains explicit. */
/* @prefer always */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(SameObject(Source)), $filter_phrase)}, filter:BlockingObject($blocking_object_ref)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
condition_other_blocking_one ::= "at" "least" "one" "other" filter_phrase "is" "blocking" blocking_object_ref

/* @sem Condition::Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, filter:BlockingObject($blocking_object_ref)}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_no_blocking_plural ::= "no" filter_plural "are" "blocking" blocking_object_ref

blocking_object_ref ::= blocking_named_ref | object_ref

/* @prefer always */
/* @sem $that_noun */
blocking_named_ref ::= that_noun

/* The same quantified subject supplies the holder of a player state. */
/* @sem PlayerSet::Union([One(AbilityController), Matching{binding:0, condition:PlayerAttacks{attacker:AbilityController, defender:Bound(0)}}]) */
controller_or_attacked_player ::= "you" "or" "a" "player" "you're" "attacking"

/* @sem Condition::PlayerState{player:Bound(0), state:$singular_possessed_player_state} */
bound_player_has_state ::= "has" singular_possessed_player_state

singular_possessed_player_state ::= state_initiative | state_boon | state_max_speed

/* @sem PlayerState::Initiative */
state_initiative ::= "the" "initiative"

/* @sem PlayerRef::$chosen_player_ref */
condition_control_chosen ::= chosen_player_ref "controls"

/* The quantified player controls a matching permanent other than the source. */
/* @sem Condition::Controls{player:Bound(0), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $filter_phrase), minimum:1} */
bound_player_controls_another ::= "controls" "another" filter_phrase

/* A threshold over the controller's graveyard, phrased with there are. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$graveyard_counted_cards}), test:$condition_at_least} */
condition_there_graveyard_threshold ::= "there" "are" condition_at_least graveyard_counted_cards "in" "your" "graveyard"

/* @sem Condition::ObjectMatches{object:EventSubject, filter:SharesNameWithAny(Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}))} */
condition_event_name_linked_exile ::= "it" "has" "the" "same" "name" "as" "one" "of" "the" "cards" "exiled" "with" "this" "artifact"

/* Counter parity is independent of the object being tested. */
/* @sem Condition::ObjectMatches{object:$object_ref, filter:$counter_parity_filter} */
condition_object_counter_parity ::= object_ref "has" "an" counter_parity_filter "on" "it"

/* @sem ObjectFilter::Counters{comparison:SameParity, value:$counter_parity_value} */
counter_parity_filter ::= counter_parity_value "number" "of" "counters"

counter_parity_value ::= companion_odd | companion_even

/* A threshold over either of two card kinds in the controller's graveyard. */

/* The controlled kind and the explicit name are independent filters. */
/* @sem Condition::Not(Controls{player:AbilityController, filter:AllOf([$filter_phrase, Name($referenced_card_name)]), minimum:1}) */
condition_control_no_named ::= "you" "don't" "control" "a" filter_phrase "named" referenced_card_name

/* @sem Condition::Not(Controls{player:AbilityController, filter:AllOf([$filter_phrase, Name($referenced_card_name)]), minimum:1}) */
condition_control_no_named_an ::= "you" "don't" "control" "an" filter_phrase "named" referenced_card_name

/* This population is scoped to an attack on the ability controller; only there
   does "another opponent" prove that the controller is excluded. */
/* @sem Condition::ExistsPlayer{players:Intersection([OthersThan(AbilityController), OpponentsOf(EventSubject)]), binding:0, condition:$bound_player_predicate} */
attacker_other_opponent_condition ::= "that" "player" "has" "another" "opponent" "who" bound_player_predicate

/* @sem Condition::Not(PlayerState{player:Bound(0), state:BeingAttacked}) */
bound_player_not_being_attacked ::= "isn't" "being" "attacked"

/* Two different colors spent on this spell remain independent requirements. */
/* @sem Condition::AllOf([Compare{left:ManaSpent{object:Source, filter:_{colors:[Blue]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, Compare{left:ManaSpent{object:Source, filter:_{colors:[$blue_pair_second]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}]) */
condition_blue_pair_spent ::= "{" "U" "}" "{" blue_pair_second "}" "was" "spent" "to" "cast" "this" "spell"

blue_pair_second ::= red_pair_white | red_pair_black | red_pair_green | blue_pair_red

/* @sem Color::Red */
blue_pair_red ::= "R"

starting_player_negative ::= starting_player_wasnt | starting_player_isnt

/* @prefer always */
/* @sem PlayerRef::AbilityController */
starting_player_wasnt ::= "you" "weren't"

/* @sem PlayerRef::AbilityController */
starting_player_isnt ::= "you" "aren't"

/* @sem PlayerState::StartingPlayer */
starting_player_state ::= "the" "starting" "player"

/* The counter kind belongs to the independently bound object. */
/* @sem ObjectFilter::Counters{kind:$counter_kind, comparison:Equal, value:Constant(0)} */
counter_test_lacks_named_an_it ::= "doesn't" "have" "an" counter_kind "counter" "on" "it"

/* The spell is introduced by the enclosing cast event. */
/* @sem Condition::Compare{left:ManaSpent{object:$unpaid_cast_spell, filter:_{}, aggregation:Count}, test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_cast_without_mana ::= "no" "mana" "was" "spent" "to" "cast" unpaid_cast_spell

unpaid_cast_spell ::= unpaid_cast_it | named_spell

/* @prefer always */
unpaid_cast_it ::= cast_it

/* Restrict the anaphor to a singular cast event, retaining its event and body. */
/* @sem Ability::Triggered{event:$event_cast_third, intervening_if:$condition_cast_without_mana, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence} */
triggered_third_cast_without_mana ::= "whenever" event_cast_third "," "if" condition_cast_without_mana "," program_sentence

/* The controlled object is compared with all permanents in the stated population. */
/* @sem Condition::Controls{player:AbilityController, filter:Property{property:Power, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, property:Power, aggregation:Maximum}}}, minimum:1} */
condition_control_greatest_power_tied ::= "you" "control" "the" filter_phrase "with" "the" "greatest" "power" "or" "tied" "for" "the" "greatest" "power"

/* The same filter counts on both sides of the comparison. */
/* @sem ObjectFilter::$filter_plural */
controlled_more_filter ::= "more" filter_plural "than"

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([ControlledBy($players_singular), $controlled_more_filter])}), test:NumberTest::Compare{comparison:Greater, value:AmongPlayers{players:$players_singular_2, number:Permanents($controlled_more_filter), aggregation:Maximum}}} */
condition_player_more_than_players ::= players_singular "controls" controlled_more_filter players_singular

/* @sem CastCost::Additional */
condition_additional_cost_name ::= "additional"

/* A colorless symbol tests mana spent on the identified spell. */
/* @sem Condition::Compare{left:Expr::ManaSpent{object:$spent_spell, filter:SpentManaFilter{colors:[Colorless]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}} */
condition_colorless_symbol_spent ::= "{" "C" "}" "was" "spent" "to" "cast" spent_spell

/* @sem Condition::Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_your_hand_at_least ::= "you" "have" value "or" "more" "cards" "in" "your" "hand"

/* Count the controller's other permanents, excluding the source itself. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$control_other_plural, ControlledBy(One($condition_control_subject))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
condition_control_or_more_other ::= condition_control_subject value "or" "more" control_other_plural

/* A controller's exact count of matching permanents on the battlefield. */
condition_control_exact_count ::= condition_control_exact_one | condition_control_exact_plural

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:Equal, value:Constant(1)}} */
condition_control_exact_one ::= "you" "control" "exactly" "one" filter_phrase

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:Equal, value:$count_plural}} */
condition_control_exact_plural ::= "you" "control" "exactly" count_plural filter_plural

/* The referenced player keeps its context-bound identity. */
/* @sem Condition::PlayerState{player:$that_player_word, state:Monarch} */
condition_referenced_player_monarch ::= that_player_word "is" "the" "monarch"

/* The attack threshold counts distinct defending opponents in this combat window. */
/* @sem Condition::AllOf([Window(DeclareAttackers), Compare{left:CountPlayers(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:PlayerAttacks{attacker:AbilityController, defender:Bound(0)}}])), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}]) */
window_attacking_opponents_threshold ::= "during" "the" "declare" "attackers" "step" "and" "only" "if" "you're" "attacking" value "or" "more" "opponents"

/* The named subject and the excluded subject are the same combatant. */
/* @sem Condition::AllOf([ObjectMatches{object:$object_ref, filter:Condition(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisCombat, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})}, Compare{left:EventHistory{event:Object{event:Attacks, objects:AllOf([Not(SameObject($object_ref)), $filter_plural])}, window:ThisCombat, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}]) */
condition_object_and_other_attacked_combat ::= object_ref "and" "at" "least" value "other" filter_plural "attacked" "this" "combat"

negative_control_filter ::= filter_phrase | negative_control_ring_bearer

/* @sem ObjectFilter::State(RingBearer) */
negative_control_ring_bearer ::= "Ring-bearer"

/* Each controlled population retains its own filter and counted property. */
/* @sem Condition::Compare{left:CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))}, property:BasicLandTypes}, test:NumberTest::Compare{comparison:Equal, value:Constant(5)}} */
condition_control_each_basic_shared ::= "you" "control" "a" filter_phrase "of" "each" "basic" "land" "type"

/* @sem Condition::Compare{left:CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))}, property:Colors}, test:NumberTest::Compare{comparison:Equal, value:Constant(5)}} */
condition_each_color_continuation_shared ::= "a" filter_phrase "of" "each" "color"

/* @sem Condition::AllOf([$condition_control_each_basic_shared, $condition_each_color_continuation_shared]) */
condition_control_distinct_pair ::= condition_control_each_basic_shared "and" condition_each_color_continuation_shared

/* The comparison applies to the subject of the enclosing event. */
/* @sem Condition::ObjectMatches{object:@it, filter:Property{property:Power, test:NumberTest::Compare{comparison:Greater, value:$value}}} */
/* @prefer always */
event_subject_power_greater ::= "its" "power" "is" "greater" "than" value

/* An empty population is counted in its explicitly stated zone. */
/* @sem Condition::Compare{left:CountObjects($filtered_hand_cards), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
condition_no_hand_population ::= "there" "are" "no" filtered_hand_cards

/* Two named spells cast this turn each contribute an independent history test. */
/* @sem Condition::AllOf(@unordered([Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:Name($referenced_card_name)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:Name($referenced_card_name_2)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}])) */
condition_cast_named_spell_pair ::= "you've" "cast" "a" "spell" "named" referenced_card_name "and" "a" "spell" "named" referenced_card_name "this" "turn"

/* Compare complete libraries without changing the target player's identity. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Players{zone:Library, players:One($look_target_opponent)}, kind:Card, filter:Any})}} */
condition_library_more_than_opponent ::= "your" "library" "has" "more" "cards" "in" "it" "than" look_target_opponent "library"

/* A resolution-time comparison selects between two independently composed programs. */
/* @sem Program::Program{instructions:[If{condition:$condition_library_more_than_opponent, then:$program, otherwise:$program_2}]} */
program_library_comparison_else ::= program "if" condition_library_more_than_opponent "." "otherwise" "," program

/* Existing spellings retain their default print priority over the vowel-article form. */
condition_control_negated ::= condition_control_none_preferred | condition_control_not_a_preferred | condition_control_not_an

/* @sem $condition_control_none */
condition_control_none_preferred ::= condition_control_none

/* @sem $condition_control_not_a */
condition_control_not_a_preferred ::= condition_control_not_a

/* @sem Condition::Not(Controls{player:AbilityController, filter:$filter_phrase, minimum:1}) */
condition_control_not_an ::= "you" "don't" "control" "an" filter_phrase

/* @sem Condition::ObjectMatches{object:$condition_property_subject, filter:ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:$stat_comparison, value:Expr::@in_filter($value)}}} */
condition_property_compared_past ::= condition_property_subject stat "was" stat_comparison value

/* Past-tense upper-bounded property comparison keeping explicit subject, stat, and threshold. */
condition_past_property_subject_h3 ::= condition_property_subject | condition_that_spell_possessive_h3

/* @sem ObjectRef::@remember_operand(ObjectRef::@qualified_object(ObjectKind::Spell, ObjectFilter::Any)) */
condition_that_spell_possessive_h3 ::= "that" "spell's"

/* @sem Condition::ObjectMatches{object:$condition_past_property_subject_h3, filter:ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}} */
condition_past_property_or_less_h3 ::= condition_past_property_subject_h3 stat "was" value "or" "less"
