/* Player keywords are player rules, not object characteristics. Their affected
   player set remains live for the duration of a continuous effect. */
continuous_players ::= continuous_players_last | continuous_players_first

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players($player_keyword_gain), changes:$player_keyword_changes, duration:$duration, evaluation:LiveObjects} */
continuous_players_last ::= player_keyword_gain player_keyword_changes duration

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players($player_keyword_gain), changes:$player_keyword_changes, duration:$duration, evaluation:LiveObjects} */
continuous_players_first ::= duration "," player_keyword_gain player_keyword_changes

player_keyword_gain ::= player_keyword_you_gain | player_keyword_other_gains | player_keyword_many_gain

/* @sem PlayerSet::One(PlayerRef::AbilityController) */
player_keyword_you_gain ::= "you" ("gain" | "have")

/* @sem $players_singular */
player_keyword_other_gains ::= players_singular ("gains" | "has")

/* @sem $player_keyword_many */
player_keyword_many_gain ::= player_keyword_many ("gain" | "have")

player_keyword_many ::= player_keyword_all | player_keyword_opponents

/* @sem PlayerSet::All */
player_keyword_all ::= "players" | "all" "players"

/* @sem PlayerSet::OpponentsOf(PlayerRef::AbilityController) */
player_keyword_opponents ::= "your" "opponents" | "all" "opponents"

/* @sem Ability::Static{kind:Ordinary, affected:Players($player_keyword_have), changes:$player_keyword_changes} */
static_player_keywords ::= player_keyword_have player_keyword_changes "."

/* @sem Ability::Conditional{condition:$condition, then:[Ability::Static{kind:Ordinary, affected:Players($player_keyword_have), changes:$player_keyword_changes}]} */
static_player_keywords_if ::= player_keyword_have player_keyword_changes "as" "long" "as" condition "."

player_keyword_have ::= player_keyword_you_have | player_keyword_many_have

/* @sem PlayerSet::One(PlayerRef::AbilityController) */
player_keyword_you_have ::= "you" "have"

/* @sem $player_keyword_many */
player_keyword_many_have ::= player_keyword_many "have"

player_keyword_changes ::= player_keyword_change | player_keyword_changes_and | player_keyword_changes_comma

/* @sem Change::[Change::PlayerRule(GrantKeyword($player_keyword))] */
player_keyword_change ::= player_keyword

/* @sem Change::[...$player_keyword_change, ...$player_keyword_changes] */
player_keyword_changes_and ::= player_keyword_change "and" player_keyword_changes

/* @sem Change::[...$player_keyword_change, ...$player_keyword_changes] */
player_keyword_changes_comma ::= player_keyword_change "," "and"? player_keyword_changes

player_keyword ::= player_hexproof | player_shroud | player_protection | player_hexproof_from | player_protection_each

/* Player prohibitions are rules on players, independently of object keywords. */
player_rule_subject ::= player_rule_attacked_you_or_defender | player_rule_you | player_keyword_many | players_singular

/* @sem PlayerSet::One(PlayerRef::AbilityController) */
player_rule_you ::= "you"

/* @sem Ability::Static{kind:Ordinary, affected:Players($player_rule_subject), changes:$player_prohibitions} */
player_rule_ability ::= player_rule_subject "can't" player_prohibitions

/* @sem $player_rule_ability */
static_player_prohibition ::= player_rule_ability "."

/* @sem Ability::Conditional{condition:$condition, then:[$player_rule_ability]} */
static_player_prohibition_if ::= player_rule_ability "as" "long" "as" condition "."

/* Distinct subjects remain distinct native static abilities. */
/* @sem Ability::[$player_rule_ability, ...$player_rule_list] */
line_player_prohibitions ::= player_rule_ability "and" player_rule_list "."

player_rule_list ::= player_rule_one | player_rule_more
/* @sem Ability::[$player_rule_ability] */
player_rule_one ::= player_rule_ability
/* @sem Ability::[$player_rule_ability, ...$player_rule_list] */
player_rule_more ::= player_rule_ability "and" player_rule_list

player_prohibitions ::= player_prohibition | player_prohibitions_more | zone_cast_prohibitions | player_prohibit_shared_cast_land | player_prohibit_pay_life_pair | player_qualified_prohibition | player_blocker_limit | player_attack_destinations | player_cast_outside_hand
/* @sem Change::[Change::PlayerRule(Prohibit($player_prohibited_action))] */
player_prohibition ::= player_prohibited_action
/* @sem Change::[...$player_prohibition, ...$player_prohibitions] */
player_prohibitions_more ::= player_prohibition ("or" | "and") player_prohibitions

continuous_player_prohibition ::= continuous_event_subject_next_turn | continuous_player_prohibition_last | continuous_player_prohibition_first | continuous_all_player_rules_turn

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players($player_rule_subject), changes:$player_prohibitions, duration:$duration, evaluation:LiveObjects} */
continuous_player_prohibition_last ::= player_rule_subject "can't" player_prohibitions duration

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players($player_rule_subject), changes:$player_prohibitions, duration:$duration, evaluation:LiveObjects} */
continuous_player_prohibition_first ::= duration "," player_rule_subject "can't" player_prohibitions

/* Repeating the same universal subject/deadline continues its rule list. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(All), changes:[...$all_player_rule_turn, ...$all_player_rule_list_turn], duration:EndOfTurn, evaluation:LiveObjects} */
continuous_all_player_rules_turn ::= all_player_rule_turn "and" all_player_rule_list_turn

/* @sem $player_prohibitions */
all_player_rule_turn ::= "players" "can't" player_prohibitions "this" "turn"

all_player_rule_list_turn ::= all_player_rule_turn | all_player_rule_more_turn
/* @sem Change::[...$all_player_rule_turn, ...$all_player_rule_list_turn] */
all_player_rule_more_turn ::= all_player_rule_turn "and" all_player_rule_list_turn

/* @sem PlayerAction::PlayLand{filter:Any} */
player_prohibit_land ::= "play" "lands"

player_prohibited_action ::= player_named_land_prohibition | player_prohibit_attack_creatures | player_prohibit_receive_counters | player_prohibit_land | player_prohibit_spells | player_prohibit_typed_spells | player_prohibit_named_spells | player_prohibit_land_from_zone | player_prohibit_draw | player_prohibit_gain_life | player_prohibit_lose_life | player_prohibit_win | player_prohibit_lose | player_prohibit_search | player_prohibit_discard | player_prohibit_cycle | player_prohibit_counters | player_prohibit_cast_qualified | player_prohibit_pay_life_spells
/* @sem PlayerAction::Draw */
player_prohibit_draw ::= "draw" "cards"
/* @sem PlayerAction::GainLife */
player_prohibit_gain_life ::= "gain" "life"
/* @sem PlayerAction::LoseLife */
player_prohibit_lose_life ::= "lose" "life"
/* @sem PlayerAction::WinGame */
player_prohibit_win ::= "win" "the" "game"
/* @sem PlayerAction::LoseGame{} */
player_prohibit_lose ::= "lose" "the" "game"
/* @sem PlayerAction::SearchLibraries */
player_prohibit_search ::= "search" "libraries"
/* @sem PlayerAction::DiscardCards */
player_prohibit_discard ::= "discard" "cards"

/* @sem PlayerKeyword::Hexproof */
player_hexproof ::= "hexproof"

/* @sem PlayerKeyword::Shroud */
player_shroud ::= "shroud"

/* @sem PlayerKeyword::Protection(Objects{kind:Any, filter:$protection_quality}) */
player_protection ::= "protection" "from" protection_quality

/* @sem PlayerKeyword::HexproofFrom(Objects{kind:Any, filter:$protection_quality}) */
player_hexproof_from ::= "hexproof" "from" protection_quality

/* @sem PlayerKeyword::Protection(Each([Objects{kind:Any, filter:Color(White)}, Objects{kind:Any, filter:Color(Blue)}, Objects{kind:Any, filter:Color(Black)}, Objects{kind:Any, filter:Color(Red)}, Objects{kind:Any, filter:Color(Green)}])) */
player_protection_each ::= "protection" "from" "each" "color"

/* Card-zone origin scopes are independent of the affected players. */
line_zone_entry_prohibitions ::= entry_prohibition_single | zone_entry_pair
/* @sem Ability::[CantEnter{cards:$card_filter, from:$prohibition_card_zone}, CantEnter{cards:$card_filter, from:$prohibition_card_zone_second}] */
zone_entry_pair ::= card_filter "cards" "in" prohibition_card_zone "and" prohibition_card_zone_second "can't" "enter" "the" "battlefield" "."

zone_cast_prohibitions ::= zone_cast_single | zone_cast_pair
/* @sem Change::[PlayerRule(Prohibit(CastSpell{from:$prohibition_card_zone, filter:$zone_cast_filter}))] */
zone_cast_single ::= "cast" zone_cast_filter "from" prohibition_card_zone
/* @sem Change::[PlayerRule(Prohibit(CastSpell{from:$prohibition_card_zone, filter:$zone_cast_filter})), PlayerRule(Prohibit(CastSpell{from:$prohibition_card_zone_second, filter:$zone_cast_filter}))] */
zone_cast_pair ::= "cast" zone_cast_filter "from" prohibition_card_zone "or" prohibition_card_zone_second

zone_cast_filter ::= zone_cast_any | zone_cast_filtered
/* @sem ObjectFilter::Any */
zone_cast_any ::= "spells"
/* @sem $card_filter */
zone_cast_filtered ::= card_filter "spells"

prohibition_card_zone_second ::= prohibition_card_zone
prohibition_card_zone ::= prohibition_graveyards | prohibition_libraries
/* @sem ZoneScope::Players{zone:Graveyard, players:All} */
prohibition_graveyards ::= "graveyards"
/* @sem ZoneScope::Players{zone:Library, players:All} */
prohibition_libraries ::= "libraries"

/* PlayLand already supplies the land action domain; Any adds no unprinted
   further restriction. Origin-zone owners remain independent of rule subjects. */
/* @sem PlayerAction::PlayLand{filter:Any, from:$prohibition_card_zone} */
player_prohibit_land_from_zone ::= "play" "land" "cards" "from" prohibition_card_zone

/* Spell filters use card-type categories on the stack. A permanent spell is one of the
   permanent card types; battlefield's unqualified permanent domain is broader. */
/* @sem PlayerAction::CastSpell{filter:$card_filter} */
player_prohibit_typed_spells ::= "cast" card_filter "spells"
/* @sem PlayerAction::CastSpell{filter:Any} */
player_prohibit_spells ::= "cast" "spells"
/* @sem PlayerAction::CastSpell{filter:Chosen(CardName)} */
player_prohibit_named_spells ::= "cast" "spells" "with" "the" "chosen" "name"

/* These are announced targets. Each verb applies once to the complete set,
   so all players perform one action before the next grouped action starts. */
/* @sem @apply($announced_many_players, $uniform_player_verbs) */
instructions_announced_players ::= announced_many_players "each" uniform_player_verbs
announced_many_players ::= announced_all_players | announced_opponents
/* @sem PlayerSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:AnyNumber, filter:Any, players:All})) */
announced_all_players ::= "any" "number" "of" "target" "players"
/* @sem PlayerSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:AnyNumber, filter:Any, players:OpponentsOf(AbilityController)})) */
announced_opponents ::= "any" "number" "of" "target" "opponents"

/* The group owns all conjoined verbs. A period can start another subject;
   an unspoken imperative after and cannot change the payer to the controller. */
/* @sem Instruction::[...$instructions_announced_players, ...$instructions] */
instructions_announced_players_more ::= instructions_announced_players "." instructions

/* @sem Ability::Static{kind:Ordinary, affected:Objects($spell_holders), changes:$grants} */
static_spell_keywords ::= spell_holders ("has" | "have") grants "."

/* A bulk operation shares one fixed amount. Personal/query-based quantities
   retain the existing explicit ForEachPlayer contract. */
uniform_player_verbs ::= uniform_player_one | uniform_player_more
/* @sem Instruction::[Effect{result:@next, operation:$uniform_player_operation}] */
uniform_player_one ::= uniform_player_operation
/* @sem Instruction::[...$uniform_player_one, ...$uniform_player_verbs] */
uniform_player_more ::= uniform_player_one "and" uniform_player_verbs
uniform_player_operation ::= uniform_mill_defined | uniform_mill | uniform_draw | uniform_discard | uniform_gain | uniform_lose
/* @sem Operation::Mill{players:@subject, amount:$uniform_card_count} */
uniform_mill ::= "mill" uniform_card_count
/* @sem Operation::Draw{players:@subject, amount:$uniform_card_count} */
uniform_draw ::= "draw" uniform_card_count
/* @sem Operation::Discard{players:@subject, amount:$uniform_card_count, random:false} */
uniform_discard ::= "discard" uniform_card_count
/* @sem Operation::GainLife{players:@subject, amount:$uniform_number} */
uniform_gain ::= "gain" uniform_number "life"
/* @sem Operation::LoseLife{players:@subject, amount:$uniform_number} */
uniform_lose ::= "lose" uniform_number "life"
uniform_number ::= number_digits | number_words
uniform_card_count ::= card_count_one | uniform_cards
/* @sem $uniform_number */
uniform_cards ::= uniform_number "cards"

/* @sem EventSpec::Player{event:GivesGift, players:One(AbilityController)} */
event_you_give_gift ::= "you" "give" "a" "gift"

/* @sem PlayerAction::ReceiveCounters($counter_kind) */
player_prohibit_receive_counters ::= "get" counter_kind "counters"

/* Action operands compose with every ordinary player-rule subject and duration. */
/* @sem PlayerAction::Activate(Cycling) */
player_prohibit_cycle ::= "cycle" "cards"

/* @sem PlayerAction::ReceiveCounters(None) */
player_prohibit_counters ::= "get" "counters"

/* @sem PlayerAction::CastSpell{filter:$prohibited_spell_qualifier} */
player_prohibit_cast_qualified ::= "cast" "spells" prohibited_spell_qualifier

prohibited_spell_qualifier ::= prohibited_battlefield_shared_name | prohibited_chosen_type | prohibited_shared_color | prohibited_printed_name

/* @sem ObjectFilter::Chosen(CardType) */
prohibited_chosen_type ::= "of" "the" "chosen" "type"

/* @sem ObjectFilter::Shares{property:Colors, with:Earlier{what:LastCast}} */
prohibited_shared_color ::= "that" "share" "a" "color" "with" "the" "spell" "most" "recently" "cast" "this" "turn"

/* @sem ObjectFilter::NameFirstPrintedIn($prohibited_expansion) */
prohibited_printed_name ::= "with" "a" "name" "originally" "printed" "in" "the" prohibited_expansion "expansion"

prohibited_expansion ::= prohibited_arabian | prohibited_antiquities | prohibited_homelands

/* @sem FirstPrinting::ArabianNights */
prohibited_arabian ::= "Arabian" "Nights"

/* @sem FirstPrinting::Antiquities */
prohibited_antiquities ::= "Antiquities"

/* @sem FirstPrinting::Homelands */
prohibited_homelands ::= "Homelands"

/* @sem Change::[PlayerRule(Prohibit(CastSpell{filter:$prohibited_printed_name})), PlayerRule(Prohibit(PlayLand{filter:$prohibited_printed_name}))] */
player_prohibit_shared_cast_land ::= "cast" "spells" "or" "play" "lands" prohibited_printed_name

/* @sem PlayerAction::PayLife(Spells($pay_life_spell_filter)) */
player_prohibit_pay_life_spells ::= "pay" "life" "to" "cast" pay_life_spell_filter

/* @sem ObjectFilter::Any */
pay_life_spell_filter ::= "spells"

/* @sem Change::[PlayerRule(Prohibit(PayLife(Spells($pay_life_spell_filter)))), PlayerRule(Prohibit(PayLife(Abilities($pay_life_ability_filter))))] */
player_prohibit_pay_life_pair ::= "pay" "life" "to" "cast" pay_life_spell_filter "or" "to" "activate" pay_life_ability_filter

/* @sem ObjectFilter::Not(OnStack(Mana)) */
pay_life_ability_filter ::= "abilities" "that" "aren't" "mana" "abilities"

/* @sem PlayerAction::AttackWith(Any) */
player_prohibit_attack_creatures ::= "attack" "with" "creatures"
player_if_condition ::= condition | condition_cast_single_history | condition_cast_plural_history | condition_object_cast_this_turn
/* @sem Ability::Conditional{condition:$player_if_condition, then:[$player_rule_ability]} */
player_prohibition_if_first ::= "if" player_if_condition "," player_rule_ability "."
/* @sem Ability::Conditional{condition:$player_if_condition, then:[$player_rule_ability]} */
player_prohibition_if_last ::= player_rule_ability "if" player_if_condition "."

/* A targeted opponent compared with the ability controller at activation. */
/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:$noun}), test:Compare{comparison:LessOrEqual, value:Subtract([CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$noun}), $count])}}}])}), index:0} */
opponent_fewer_graveyard_cards ::= "target" "opponent" "who" "has" "at" "least" count "fewer" noun "cards" "in" "their" "graveyard" "than" "you" "do"

/* Counts cards once when cycling also discards the same card. */
/* @sem Expr::PlayerNumber{player:AbilityController, number:CardsCycledOrDiscardedThisTurn} */
cycled_or_discarded_this_turn ::= "you've" "cycled" "or" "discarded" "this" "turn"

/* Qualified actions remain a single prohibition, preserving separate sentences. */
/* @sem Change::[PlayerRule(Prohibit($player_qualified_action))] */
player_qualified_prohibition ::= player_qualified_action

player_qualified_action ::= player_prohibit_cast_spell_filter | player_prohibit_block_qualified

/* A shared spell filter retains the comparison and the affected player's turn count. */
/* @sem PlayerAction::CastSpell{filter:$prohibited_spell_filter} */
player_prohibit_cast_spell_filter ::= "cast" "spells" prohibited_spell_filter

prohibited_spell_filter ::= prohibited_chosen_color | prohibited_mana_value_singular | prohibited_mana_value_plural

/* @sem ObjectFilter::Chosen(Color) */
prohibited_chosen_color ::= "of" "the" "chosen" "color"

/* @sem ObjectFilter::Property{property:ManaValue, test:$prohibited_mana_test} */
prohibited_mana_value_singular ::= "with" "mana" "value" prohibited_mana_test

/* @sem ObjectFilter::Property{property:ManaValue, test:$prohibited_parity} */
prohibited_mana_value_plural ::= "with" prohibited_parity "mana" "values"

prohibited_mana_test ::= prohibited_at_most | prohibited_turns_begun

/* @sem NumberTest::Compare{comparison:LessOrEqual, value:$value} */
prohibited_at_most ::= value "or" "less"

/* @sem NumberTest::Compare{comparison:Greater, value:PlayerNumber{player:Affected, number:TurnsBegun}} */
prohibited_turns_begun ::= "greater" "than" "the" "number" "of" "turns" "they" "have" "begun"

prohibited_parity ::= prohibited_even | prohibited_odd

/* @sem NumberTest::Compare{comparison:SameParity, value:Constant(0)} */
prohibited_even ::= "even"

/* @sem NumberTest::Compare{comparison:SameParity, value:Constant(1)} */
prohibited_odd ::= "odd"

/* @sem PlayerAction::BlockWith(@and($filter_plural, ObjectFilter::Property{property:ManaValue, test:$prohibited_parity})) */
player_prohibit_block_qualified ::= "block" "with" filter_plural "with" prohibited_parity "mana" "values"

/* The searcher and the player receiving the permission are independent.
   Keep each pronoun attached to the clause that establishes its antecedent. */
/* @sem Ability::ExilesSearchedCards{searching:$searched_cards_searcher, player:$searched_cards_permission} */
searched_cards_ability ::= searched_cards_searcher "," "they" "exile" "each" "card" "they" "find" "." searched_cards_permission "."

searched_cards_searcher ::= searched_cards_opponent | searched_cards_active_opponent

/* @sem PlayerSet::OpponentsOf(PlayerRef::AbilityController) */
searched_cards_opponent ::= "while" "an" "opponent" "is" "searching" "their" "library"

/* @sem PlayerSet::OpponentsOf(PlayerRef::Active) */
searched_cards_active_opponent ::= "while" "an" "opponent" "of" "the" "active" "player" "is" "searching" "their" "library"

searched_cards_permission ::= searched_cards_you_permission | searched_cards_active_permission

/* @sem PlayerRef::AbilityController */
searched_cards_you_permission ::= "you" "may" "play" "those" "cards" "for" "as" "long" "as" "they" "remain" "exiled" "," "and" "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "them"

/* @sem PlayerRef::Active */
searched_cards_active_permission ::= "the" "active" "player" "may" "play" "those" "cards" "for" "as" "long" "as" "they" "remain" "exiled" "," "and" "the" "active" "player" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "them"

/* The restriction is a native PayToIgnore term, distinct from static PlayerRule changes. */
/* @sem Operand::List([Term{family:PlayerEffect, form:CantSearchLibraries}]) */
pay_to_ignore_player_restriction ::= "can't" "search" "libraries"

/* Any player pays for that same player; the subject set is explicitly all players. */
/* @sem Ability::PayToIgnore{subjects:Players($player_keyword_all), rules:$pay_to_ignore_player_restriction, cost:$cost, until:EndOfTurn} */
pay_to_ignore_all_player_rule ::= player_keyword_all pay_to_ignore_player_restriction "." "any" "player" "may" "pay" cost "for" "that" "player" "to" "ignore" "this" "effect" "until" "end" "of" "turn" "."

/* The difference is clamped because the reduction applies only below the
   stated starting total. Keep the two player operands independent. */
/* @sem Expr::Maximum(Constant(0), Subtract($life_difference_starting, $life_difference_current)) */
life_difference_below ::= "if" life_difference_current "is" "less" "than" life_difference_starting

/* @sem Expr::PlayerNumber{player:$life_difference_current_player, number:Life} */
life_difference_current ::= life_difference_current_player "life" "total"

life_difference_current_player ::= life_difference_your | life_difference_active

life_difference_starting_player ::= life_difference_your | life_difference_active

/* @sem PlayerRef::AbilityController */
life_difference_your ::= "your"

/* @sem PlayerRef::Active */
life_difference_active ::= "the" "active" "player's"

/* @sem Expr::StartingLife($life_difference_starting_player) */
life_difference_starting ::= life_difference_starting_player "starting" "life" "total"

/* The history condition is evaluated separately for each bound player. */
/* @sem PlayerSet::Matching{binding:0, condition:$bound_player_attack_history} */
attack_history_players ::= "players" "who" bound_player_attack_history

/* The name comparison is against the live battlefield population. */
/* @sem ObjectFilter::SharesNameWithAny(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}) */
prohibited_battlefield_shared_name ::= "with" "the" "same" "name" "as" "a" filter_phrase

/* @sem PlayerAction::PlayLand{filter:AllOf([Not(Supertype(Basic)), $filter_plural, $prohibited_battlefield_shared_name])} */
player_named_land_prohibition ::= "play" "nonbasic" filter_plural prohibited_battlefield_shared_name

/* @sem PlayerAction::Activate(Not(Mana)) */
player_prohibit_activate_nonmana ::= "activate" "abilities" "that" "aren't" "mana" "abilities"

/* @sem PlayerRef::OneOf(OpponentsOf(AbilityController)) */
alternative_life_actor ::= "an" "opponent"

/* The candidate pool and the comparison population are independent. The
   choice is one of the candidates tied at the stated life extreme. */
/* @sem PlayerSet::One(OneOf(Intersection([$choice_life_candidates, Matching{binding:0, condition:Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:Equal, value:AmongPlayers{players:$choice_life_population, number:Life, aggregation:$extreme_aggregation}}}}]))) */
players_chosen_extreme_life ::= "choose" choice_life_candidates "with" "the" extreme_aggregation "life" "total" "among" choice_life_population "." "that" "player"

choice_life_candidates ::= choice_life_opponent | choice_life_player

/* @sem PlayerSet::OpponentsOf(AbilityController) */
choice_life_opponent ::= "an" "opponent"

/* @sem PlayerSet::All */
choice_life_player ::= "a" "player"

choice_life_population ::= choice_life_your_opponents | choice_life_all_players

/* @sem PlayerSet::OpponentsOf(AbilityController) */
choice_life_your_opponents ::= "your" "opponents"

/* @sem PlayerSet::All */
choice_life_all_players ::= "all" "players"

/* A shared, explicitly defined quantity applies equally to every player. */

/* @sem @times(Expr::Constant(2), $value_controlled_population) */
uniform_defined_cards ::= "X" "cards" "," "where" "X" "is" "twice" value_controlled_population

/* @prefer always */
/* @sem Operation::Mill{players:@subject, amount:$uniform_defined_cards} */
uniform_mill_defined ::= "mill" uniform_defined_cards

/* The maximum number of blocking creatures is a player rule. */
/* @sem Change::[PlayerRule(BlockerLimit($value))] */
player_blocker_limit ::= "block" "with" "more" "than" value "creature"

/* Each named destination contributes its own prohibition. */
/* @sem Change::[PlayerRule(Prohibit(AttackInto($recipients))), PlayerRule(Prohibit(AttackInto(Objects($affected))))] */
player_attack_destinations ::= "attack" recipients "or" affected

/* This anaphor and its possessive deadline identify the event subject. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(EventSubject)), changes:$player_prohibitions, duration:DuringNextTurn(EventSubject), evaluation:LiveObjects} */
continuous_event_subject_next_turn ::= "that" "player" "can't" player_prohibitions "during" "their" "next" "turn"

/* The second player retains its own target or anaphoric identity. */
you_and_player_set ::= you_and_named_player_set | you_and_chosen_player_set

/* @sem PlayerSet::Union([One(AbilityController), $players_singular]) */
you_and_named_player_set ::= "you" "and" players_singular

/* @sem PlayerSet::Union([One(AbilityController), One(Chosen)]) */
you_and_chosen_player_set ::= "you" "and" "that" "player"

/* A personal hand is counted separately for every announced player. */
/* @sem Instruction::[ForEachPlayer{players:$announced_many_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:Discard{players:One(Bound(0)), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any})}}]}}] */
instructions_announced_hand ::= announced_many_players "each" "discard" "their" "hands"

/* The same announced player set supplies both phases, even after earlier targets. */
/* @sem Instruction::[ForEachPlayer{players:$announced_many_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:Discard{players:One(Bound(0)), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any})}}]}}, Effect{result:@next, operation:Draw{players:$announced_many_players, amount:$card_count}}] */
instructions_announced_hand_draw ::= announced_many_players "each" "discard" "their" "hands" "," "then" "draw" card_count

/* @sem Instruction::[...$instructions_announced_hand, ...$instructions] */
instructions_announced_hand_more ::= instructions_announced_hand "." instructions

/* @sem Instruction::[...$instructions_announced_hand_draw, ...$instructions] */
instructions_announced_hand_draw_more ::= instructions_announced_hand_draw "." instructions

/* An opponent makes the choice and performs the enclosed action. */
/* @sem Operation::PlayersDo{players:OpponentsOf(AbilityController), any_one:true, optional:true, body:[Program{instructions:$acting_choice_action}]} */
opponent_may_perform_choice ::= "an" "opponent" "may" acting_choice_action

/* Each matching set binds the defender whose own last turn is queried. */
defender_history ::= defender_history_either | defender_history_cast | defender_history_put

/* @sem PlayerSet::Union(@unordered([$defender_history_cast, $defender_history_put])) */
defender_history_either ::= defender_history_cast "or" defender_history_put

/* @sem PlayerSet::Matching{binding:1, condition:PlayerDid{player:Bound(1), event:CastSpell(Any), window:LastTurnOf(Bound(1))}} */
defender_history_cast ::= "cast" "a" "spell"

/* @sem PlayerSet::Matching{binding:1, condition:Compare{left:EventHistory{event:Player{event:PutsOntoBattlefield, players:One(Bound(1)), objects:$filter_phrase}, window:LastTurnOf(Bound(1)), measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}} */
defender_history_put ::= "put" "a" filter_phrase "onto" "the" "battlefield"

/* Preserve the bound attacking player and both alternative defenders. */
/* @sem PlayerSet::Intersection([$players_singular, Union([Matching{binding:0, condition:Compare{left:EventHistory{event:Attack{attackers:Any, by:One(Bound(0)), defenders:Players(One(AbilityController))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}, Matching{binding:0, condition:PlayerDid{player:Bound(0), event:AttackedDefender($filter_phrase), window:ThisTurn}}])]) */
player_rule_attacked_you_or_defender ::= players_singular "who" "attacked" "you" "or" "a" filter_phrase "this" "turn"

/* Each announced player supplies both the mill recipient and counted zone owner. */
/* @sem Instruction::[ForEachPlayer{players:$announced_many_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:Mill{players:One(Bound(0)), amount:CountObjects(Zone{scope:Players{zone:$personal_mill_zone, players:One(Bound(0))}, kind:Card, filter:Any})}}]}}] */
instructions_announced_personal_mill ::= announced_many_players "each" "mill" "cards" "equal" "to" "the" "number" "of" "cards" "in" "their" personal_mill_zone

personal_mill_zone ::= personal_mill_graveyard | personal_mill_hand | personal_mill_library

/* @sem Zone::Graveyard */
personal_mill_graveyard ::= "graveyard"

/* @sem Zone::Hand */
personal_mill_hand ::= "hand"

/* @sem Zone::Library */
personal_mill_library ::= "library"

/* Thresholds count each iterated player's own controlled permanents. */
/* @sem PlayerSet::Matching{binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}} */
players_control_threshold_more ::= "each" "player" "who" "controls" value "or" "more" filter_plural

/* @sem PlayerSet::Matching{binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}), test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}} */
players_control_threshold_fewer ::= "each" "player" "who" "controls" value "or" "fewer" filter_plural

/* Comparison subjects compose with the ordinary player prohibition phrase. */
/* @sem Ability::[Static{kind:Ordinary, affected:Players($more_type_opponents), changes:$player_prohibitions}] */
line_more_opponents_prohibition ::= more_type_opponents "can't" player_prohibitions "."

/* The elliptical sentence repeats the comparison and cast prohibition per type. */
/* @sem Ability::[$comparison_cast_opening, $comparison_cast_repeat, $comparison_cast_repeat_2] */
line_comparison_cast_ellipsis ::= comparison_cast_opening "." "the" "same" "is" "true" "for" comparison_cast_repeat "and" comparison_cast_repeat "."

/* @sem Ability::Static{kind:Ordinary, affected:Players(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$comparison_cast_pair, ControlledBy(One(Bound(0)))])}), test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$comparison_cast_pair, ControlledBy(One(AbilityController))])})}}}])), changes:[PlayerRule(Prohibit(CastSpell{filter:$comparison_cast_pair}))]} */
comparison_cast_opening ::= "each" "opponent" "who" "controls" "more" comparison_cast_pair "spells"

comparison_cast_pair ::= comparison_creature_pair | comparison_artifact_pair | comparison_enchantment_pair

/* @sem ObjectFilter::CardType(Creature) */
comparison_creature_pair ::= "creatures" "than" "you" "can't" "cast" "creature"

/* @sem ObjectFilter::CardType(Artifact) */
comparison_artifact_pair ::= "artifacts" "than" "you" "can't" "cast" "artifact"

/* @sem ObjectFilter::CardType(Enchantment) */
comparison_enchantment_pair ::= "enchantments" "than" "you" "can't" "cast" "enchantment"

/* @sem Ability::Static{kind:Ordinary, affected:Players(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$comparison_spell_type, ControlledBy(One(Bound(0)))])}), test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$comparison_spell_type, ControlledBy(One(AbilityController))])})}}}])), changes:[PlayerRule(Prohibit(CastSpell{filter:$comparison_spell_type}))]} */
comparison_cast_repeat ::= comparison_spell_type

comparison_spell_type ::= plural_creature | plural_artifact | plural_enchantment

/* Players selected by their own current poison counters. */
/* @sem PlayerSet::Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:CountCounters(_{recipients:Players(One(Bound(0))), kind:Named(PoisonCounter), information:CurrentOrLastKnown}), test:Compare{comparison:GreaterOrEqual, value:$count}}}]) */
poisoned_opponents ::= "each" "opponent" "who" "has" count "or" "more" "poison" "counters"

/* @sem Change::[PlayerRule(Prohibit(CastOutside(Hand)))] */
player_cast_outside_hand ::= "cast" "spells" "from" "anywhere" "other" "than" "their" "hands"

/* The history predicate binds the same player as the enclosing player loop. */
/* @sem PlayerSet::Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:EventHistory{event:Player{event:LosesLife, players:One(Bound(0))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}]) */
players_each_opponent_lost_life ::= "each" "opponent" "who" "lost" "life" "this" "turn"

/* @sem PlayerSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:AnyNumber, filter:Any, players:All})) */
graveyard_target_players ::= "any" "number" "of" "target" "players'"

/* The subject carries both the population and its optional origin. */
/* @sem Ability::[$entry_prohibition_subject] */
entry_prohibition_single ::= entry_prohibition_subject "can't" "enter" "the" "battlefield" "."

entry_prohibition_subject ::= entry_subject_any_origin | entry_subject_zone

/* @sem Ability::CantEnter{cards:$filter_plural} */
entry_subject_any_origin ::= filter_plural

/* @sem Ability::CantEnter{cards:$card_filter, from:$prohibition_card_zone} */
entry_subject_zone ::= card_filter "cards" "in" prohibition_card_zone

shared_life_recipients ::= shared_any_target_players | shared_you_and_player

/* @sem PlayerSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:AnyNumber, filter:Any, players:All})) */
shared_any_target_players ::= "any" "number" "of" "target" "players"

/* @sem PlayerSet::Union([One(AbilityController), $players_singular]) */
shared_you_and_player ::= "you" "and" players_singular

/* Both actions use the affected player's same owned zone. */
/* @sem Change::[PlayerRule(Prohibit(PlayLand{from:Players{zone:$own_cast_zone, players:One(Affected)}, filter:Any})), PlayerRule(Prohibit(CastSpell{from:Players{zone:$own_cast_zone, players:One(Affected)}, filter:Any}))] */
player_prohibit_own_zone_land_cast ::= "play" "lands" "or" "cast" "spells" "from" own_cast_zone

/* @sem Ability::Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:$player_prohibit_own_zone_land_cast} */
static_you_prohibit_own_zone ::= "you" "can't" player_prohibit_own_zone_land_cast "."
