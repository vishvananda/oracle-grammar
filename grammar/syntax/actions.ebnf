/* One-step actions, mana and counters. */

/* @sem Operation::AddMana{players:One(PlayerRef::AbilityController), mana:$mana_production} */
add_mana ::= "add" ("an" "additional")? mana_production

/* The named player receives the mana; the ability controller need not do so. */
/* @sem Operation::AddMana{players:$players_singular, mana:$mana_production} */
add_mana_player ::= players_singular "adds" ("an" "additional")? mana_production

mana_production ::= mana_bundle | mana_or | mana_or_list | mana_any_color | mana_any_one_color | mana_or_chosen | mana_could_produce_color | mana_could_produce_type | mana_same_type_produced | mana_commander_identity | mana_colors_linked_card | mana_colors_linked_cards | mana_last_noted_type | mana_last_noted_amount

/* Mana another permanent could make is chosen among its colors, or among its
   types when colorless counts too. */
/* @sem ManaProduction::CouldProduce{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, colors_only:true} */
mana_could_produce_color ::= "one" "mana" "of" "any" "color" "that" ("a" | "an") filter_phrase "could" "produce"
/* @sem ManaProduction::CouldProduce{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, colors_only:false} */
mana_could_produce_type ::= "one" "mana" "of" "any" "type" "that" ("a" | "an") filter_phrase "could" "produce"
/* The tapped permanent of a mana trigger names the mana it just produced. */
/* @sem ManaProduction::SameTypeAsProduced */
mana_same_type_produced ::= "one" "mana" "of" "any" "type" "that" ("land" | "permanent") "produced"

mana_bundle ::= mana_unit | mana_units

/* @sem ManaProduction::Amount{color:$mana_color, amount:Expr::Constant(1)} */
mana_unit ::= mana_color

/* @sem ManaProduction::@literal_mana_sequence($mana_unit, $mana_bundle) */
mana_units ::= mana_unit mana_bundle

/* @sem ManaProduction::ChooseOne([$mana_bundle, $mana_bundle_2]) */
mana_or ::= mana_bundle "or" mana_bundle

/* @sem ManaProduction::ChooseOne([$mana_bundle, ManaProduction::Amount{color:Chosen, amount:Expr::Constant(1)}]) */
mana_or_chosen ::= mana_bundle "or" "one" "mana" "of" "the" "chosen" "color"

/* @sem ManaProduction::ChooseOne([$mana_bundle, ...$mana_or_tail]) */
mana_or_list ::= mana_bundle "," mana_or_tail

mana_or_tail ::= mana_or_last | mana_or_more

/* @sem ManaProduction::[$mana_bundle] */
mana_or_last ::= "or" mana_bundle

/* @sem ManaProduction::[$mana_bundle, ...$mana_or_tail] */
mana_or_more ::= mana_bundle "," mana_or_tail

/* @sem ManaProduction::ChooseOne([ManaProduction::Amount{color:White, amount:$number}, ManaProduction::Amount{color:Blue, amount:$number}, ManaProduction::Amount{color:Black, amount:$number}, ManaProduction::Amount{color:Red, amount:$number}, ManaProduction::Amount{color:Green, amount:$number}]) */
mana_any_color ::= number "mana" "of" "any" "color"
/* One mana of a color in your commander's color identity (CR 903.4). */
/* @sem ManaProduction::CommanderIdentity */
mana_commander_identity ::= "one" "mana" "of" "any" "color" "in" "your" "commander's" "color" "identity"

/* @sem ManaProduction::Repeat{amount:$number, production:ChooseOne([ManaProduction::Amount{color:White, amount:Expr::Constant(1)}, ManaProduction::Amount{color:Blue, amount:Expr::Constant(1)}, ManaProduction::Amount{color:Black, amount:Expr::Constant(1)}, ManaProduction::Amount{color:Red, amount:Expr::Constant(1)}, ManaProduction::Amount{color:Green, amount:Expr::Constant(1)}]), choice:Once} */
mana_any_one_color ::= number "mana" "of" "any" "one" "color"

mana_color ::= mc_white | mc_blue | mc_black | mc_red | mc_green | mc_colorless

/* @sem ManaColor::White */
mc_white ::= "{W}"
/* @sem ManaColor::Blue */
mc_blue ::= "{U}"
/* @sem ManaColor::Black */
mc_black ::= "{B}"
/* @sem ManaColor::Red */
mc_red ::= "{R}"
/* @sem ManaColor::Green */
mc_green ::= "{G}"
/* @sem ManaColor::Colorless */
mc_colorless ::= "{C}"

put_counters ::= put_counters_capped_source_power | put_created_counters_for_counters | put_counters_two_direct | put_counters_direct | put_counters_equal | put_counters_equal_first | put_counters_choice | put_counters_many_choices | put_counters_where_devotion | put_counter_each_battlefield | put_counters_each_battlefield | put_choice_on_each_created | put_counters_each_creature_property | put_counters_above_base_each
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:$counter_amount}]} */
put_counters_direct ::= "put" counter_amount counter_kind ("counter" | "counters") "on" affected
/* A counted placement names its amount after its recipients or before them. */
/* One recipient: a value naming "that creature" after a group would read as
   the source, not as each member. */
/* @sem Operation::PutCounters{placements:[_{recipients:$counted_recipient, kind:$counter_kind, amount:$value}]} */
put_counters_equal ::= "put" "a" "number" "of" counter_kind "counters" "on" counted_recipient "equal" "to" value
counted_recipient ::= counted_object | counted_reference | counted_created
/* @sem Recipients::Objects(One($object_ref)) */
counted_object ::= object_ref
/* @sem Recipients::Objects($counter_choice_singular_reference) */
counted_reference ::= counter_choice_singular_reference
/* @sem Recipients::Objects($created_singular_reference) */
counted_created ::= created_singular_reference
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:$value}]} */
put_counters_equal_first ::= "put" "a" "number" "of" counter_kind "counters" "equal" "to" value "on" affected

/* This recipient is chosen at resolution, without announcing a target. */
/* @sem Operation::@counter_choice(Operation::PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}), kind:$counter_kind, amount:$counter_amount, selection:_{player:AbilityController, count:$counter_single_choice}}]}) */
put_counters_choice ::= "put" counter_amount counter_kind ("counter" | "counters") "on" counter_single_choice filter_phrase
/* @sem Operation::@counter_choice(Operation::PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}), kind:$counter_kind, amount:$counter_amount, selection:_{player:AbilityController, count:$counter_many_choice}}]}) */
put_counters_many_choices ::= "put" counter_amount counter_kind ("counter" | "counters") "on" counter_many_choice filter_plural
counter_single_choice ::= counter_single_required | counter_single_optional
/* @sem Count::AsManyAsCan(Constant(1)) */
counter_single_required ::= counter_choice_one
/* @sem Count::UpTo(Constant(1)) */
counter_single_optional ::= "up" "to" counter_choice_one
/* @sem () */
counter_choice_one ::= "a" | "an" | "one" | "1"
counter_many_choice ::= counter_many_required | counter_many_optional | count_any_number
/* @sem Count::AsManyAsCan($counter_choice_amount) */
counter_many_required ::= counter_choice_amount
/* @sem Count::UpTo($counter_choice_amount) */
counter_many_optional ::= "up" "to" counter_choice_amount
counter_choice_amount ::= number_digits | number_words | number_x

/* @sem Instruction::[Effect{result:@next, operation:$put_counters}] */
clause_you_counters ::= "you" put_counters

/* Coordinated conditions are independent: neither arm can erase the other.
   Both predicates refer to the object named by this counter instruction. */
/* @sem Instruction::[If{condition:ObjectMatches{object:$object_ref, filter:$filter_phrase}, then:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($object_ref)), kind:$counter_kind, amount:$counter_amount}]}}]}, otherwise:Program{}}, If{condition:ObjectMatches{object:$object_ref, filter:$filter_phrase_2}, then:$program, otherwise:Program{}}] */
clause_conditional_counter_pair ::= "put" counter_amount counter_kind ("counter" | "counters") "on" object_ref "if" "it's" ("a" | "an") filter_phrase "and" program "if" "it's" ("a" | "an") filter_phrase

counter_amount ::= counter_a | number_digits | number_words | number_x

/* @sem Expr::Constant(1) */
counter_a ::= "a" | "an"

counter_kind ::= counter_plus | counter_minus | counter_pt | counter_name

/* @sem CounterKind::PowerToughness(1, 1) */
counter_plus ::= "+" "1" "/" "+" "1"

/* @sem CounterKind::PowerToughness(-1, -1) */
counter_minus ::= "-" "1" "/" "-" "1"

/* Other power/toughness counters, as printed: a zero keeps its written sign. */
counter_pt ::= counter_pt_plus1_plus0 | counter_pt_plus2_plus2 | counter_pt_plus0_plus1 | counter_pt_minus0_minus1 | counter_pt_minus0_minus2 | counter_pt_plus1_plus2 | counter_pt_minus2_minus1 | counter_pt_minus2_minus2 | counter_pt_plus0_plus2 | counter_pt_minus1_minus0
/* @sem CounterKind::PowerToughness(1, 0) */
counter_pt_plus1_plus0 ::= "+" "1" "/" "+" "0"
/* @sem CounterKind::PowerToughness(2, 2) */
counter_pt_plus2_plus2 ::= "+" "2" "/" "+" "2"
/* @sem CounterKind::PowerToughness(0, 1) */
counter_pt_plus0_plus1 ::= "+" "0" "/" "+" "1"
/* @sem CounterKind::PowerToughness(0, -1) */
counter_pt_minus0_minus1 ::= "-" "0" "/" "-" "1"
/* @sem CounterKind::PowerToughness(0, -2) */
counter_pt_minus0_minus2 ::= "-" "0" "/" "-" "2"
/* @sem CounterKind::PowerToughness(1, 2) */
counter_pt_plus1_plus2 ::= "+" "1" "/" "+" "2"
/* @sem CounterKind::PowerToughness(-2, -1) */
counter_pt_minus2_minus1 ::= "-" "2" "/" "-" "1"
/* @sem CounterKind::PowerToughness(-2, -2) */
counter_pt_minus2_minus2 ::= "-" "2" "/" "-" "2"
/* @sem CounterKind::PowerToughness(0, 2) */
counter_pt_plus0_plus2 ::= "+" "0" "/" "+" "2"
/* @sem CounterKind::PowerToughness(-1, 0) */
counter_pt_minus1_minus0 ::= "-" "1" "/" "-" "0"

action ::= draw_per_other_cast_history | wish_reveal_owned | copy_effect_indefinite_except | copy_effect_duration_except | copy_effect_indefinite | copy_effect_duration | keyword_action | return_card_attached_to_created_token | remove_from_combat_action | fight_action | connive_object_controller | move_same_controller_counters | move_mixed_target_hand | required_defender_attack | move_linked_cards_hand | manifest_dread | unattach_action | suspect_action | unsuspect_action | goad_while_present | clash_opponent | attach_each_host | attach_counted_to_host | attach_one_to_host | manifest_hand | cloak_hand | manifest_one | cloak_one | attach_objects | tap_objects | untap_objects | regenerate_objects | exile_objects | exile_ordered_face_down | exile_optional_graveyard_card_set | sacrifice_objects | sacrifice_choice | move_hand | move_graveyard | move_top | move_bottom | move_graveyard_top_ordered | move_graveyard_bottom_ordered | move_shuffled | put_optional_graveyard_target_battlefield | move_battlefield | move_battlefield_attached | put_battlefield_attached | move_battlefield_counter | move_battlefield_tapped | move_battlefield_owner | move_battlefield_transformed | move_battlefield_owner_transformed | move_owner_counter_untapped | move_owner_counter_one | move_owner_counter_many | move_battlefield_owner_tapped | reveal_top | look_top | look_objects | prevent_clause | tap_or_untap | create_emblem | reveal_hand | remove_counters_from_affected | remove_all_counters_from_affected | put_that_many_counters | double_counters | put_counter_for_each | recipients_gets_counter | recipients_get_counter | recipients_gets_counters | support_action | choose_a_color | choose_a_card_name | choose_value | choose_cards_in_hand | flip_a_coin | add_mana_player | add_mana_for_affected | add_mana_for_each | add_mana_for_removed_counters | add_alternative_mana_for_removed_counters | add_mana_of_chosen_color | add_mana_any_combination | add_mana_amount_equal | create_tokens_tapped_attacking | create_tokens_attacking_player | abandon_this_scheme | you_gain_life | deal_damage_equal_counters | deal_damage_split_two | exile_target_players_graveyard | exile_all_graveyard_cards | exile_all_graveyards_cards | exile_all_hand_cards | exile_all_hand_face_down | exile_all_library_cards | exile_two_groups | exile_all_graveyards | exile_with_counters | exile_instead_of_dying | entries_with_counters_this_turn | exile_damaged_instead_of_dying | prevent_combat_damage_would_deal | gain_control_of | player_gains_control_of | gain_control_while_controlled | exile_top_cards_of_your_library | then_players_shuffle | look_at_top_x_cards | shuffle_your_library | search_library_for_cards | play_that_card_permission | cast_that_card_permission | cast_that_card_permission_spending | play_those_cards_permission | skip_controllers_next_untap | skip_controllers_next_untap_plural | skip_controller_next_untap_shared | skip_your_next_untap | duration_affected_static_changes | duration_affected_changes | base_power_toughness_for_duration | affected_also_changes | becomes_artifact_creature | attack_despite_defender | changes_while_tapped | loses_flying | attacks_if_able | perpetual_affected_changes | perpetual_prior_base_power | create_tokens_attacking_singular | create_tokens_attacking_plural | create_tokens_blocking_singular | counter_stack_action | return_history_cards_hand | return_arrived_graveyard_cards_hand | return_other_qualified_battlefield | return_each_qualified_battlefield | duration_added_color_type | sacrifice_each_by_controller | double_player_life_total | return_target_stack_spell_hand | note_information | temporary_graveyard_redirect | choose_suspended_remove_event_counters | remove_each_suspended_counters | deal_damage_split_recipients | deal_damage_split_half | exile_hand_graveyard_any | exile_hand_graveyard_cards | redirect_next_damage_to_owner | redirect_next_spell_damage_to_controller | multiply_chosen_creature_combat_damage | combat_reselect_target | combat_reselect_each | add_mana_each_craft_color | redirect_spell_damage_controller | conjure_named_battlefield | conjure_named_battlefield_tapped | move_to_modified_battlefield | return_filtered_permanents_hand | put_exiled_singular | put_exiled_plural | return_each_color_targets_hand | return_graveyard_personal_hand | return_graveyard_all_owners_hand | return_graveyard_selection_hand | return_each_color_hand | deal_damage_evenly_rounded | future_player_cast_effect | choose_creatures_pay_each | live_rule_while_tapped | skip_plural_controller_window | temporary_damage_replacement | temporary_prevent_replacement | op_each_damage_replacement | next_untap_replacement | return_optional_union_graveyard_hand | flip_counted_coins | seek_filtered_top_cards | seek_filtered_top_one | flip_coin_series_until | each_counter_kind_choice | exchange_owned_zones | return_linked_exile_to_owner | attach_each_attachment | player_looks_at_your_top | put_selected_private_cards | linked_card_owner_manifests_dread | player_manifests_dread | remove_plural_counters_from_affected | duplicate_chosen_counter_kind | random_number_choice_three | move_object_owners_library | hand_pick_single | conjure_each_shuffled_library | sacrifice_unless_any_player_pays | turn_targets_face_down_creatures | cast_free_graveyard_many | cast_free_graveyard_bounded_spell | cast_target_with_any_mana | conjure_named_graveyard | conjure_duplicate_graveyard | conjure_sacrificed_duplicate_graveyard | return_scoped_exiled_yours | return_scoped_exiled_owner_each | return_scoped_exiled_owner_plural | prevent_combat_damage_passive | copy_leading_duration_except | required_target_attack_source | perpetual_graveyard_unearth | flip_coin_for_each | draw_for_each_controlled_death | conjure_random_oracle_battlefield | conjure_planets_battlefield | conjure_event_controller_named | you_gain_life_for_each_private_card | damage_excess_to_creature_controller | exchange_two_target_players_life | transfer_counter_one_second | transfer_counter_kind_second | transfer_counters_any_second | transfer_counter_between_targets | move_chosen_spell_owner_library | remove_counter_for_each_live_card | swap_blocking_pair | mixed_target_set_color | look_random_hand_cards | linked_owner_creates_defined | pilot_land_while_present | pilot_until_spell_cast | recipients_gets_twice_event_counters | manifest_from_library | copy_effect_prefix_except | each_player_returns_linked_exile | put_countered_owned_exile_into_hand | put_counter_on_counter_group | discard_same_player_counters | return_with_your_arrival | return_with_owner_arrival | return_owner_counter_changes | move_observed_filtered_to_control | return_event_amount_controlled | move_selected_with_added_identity | exile_observed_face_down | shared_type_change_indefinite | shared_type_change_timed | random_graveyard_return | destroy_each_without_named_counter | move_owner_choice_library | move_your_library_depth | exile_matching_instead_of_dying | hand_cards_perpetual_reduction | subtype_base_keyword_effect | subtype_loss_effect | exile_card_per_player_down | exile_shuffled_pile | move_linked_target_graveyard | return_graveyard_targets_total_value | put_graveyard_population_battlefield | put_battlefield_graveyard_population | put_opponent_graveyard_targets_battlefield | return_battlefield_before_target | shuffle_your_graveyard_cards | shuffle_target_graveyard_cards | shuffle_self_graveyard_union | shuffle_self_common_graveyard_targets | put_other_graveyard_card_bottom | player_chooses_unrestricted_value | graveyard_entry_move_optional | graveyard_entry_move_range | graveyard_entry_return | leading_control_effect | leading_player_rule_effect | leading_self_stat_effect | create_each_tapped_attacking | outside_owned_put_top | outside_owned_shuffle | return_different_graveyard_cards | create_card_copy_one | create_card_copies | turn_selected_face_up | attach_enchanting_to_same_controller | have_player_sacrifice_choice | player_choose_sacrifice_shared | put_three_counters_shared_recipient | put_each_opponents_targets_library_depth | owner_moves_target_library_choice | put_population_owners_shuffle | copy_effect_leading_duration | untap_team_creatures

/* Manifest dread yields one face-down creature for a later singular reference. */
/* @sem Operation::@manifest_result(Operation::Keyword{actor:One(AbilityController), action:KeywordAction::ManifestDread{}}) */
manifest_dread ::= "manifest" "dread"

/* Connive is performed by the named permanent's controller (CR 701.50a-b), the
   current or last-known one. The same lexical object supplies actor and object;
   duplicated target markers retain one slot. */
/* @sem Operation::Keyword{actor:One(ControllerOf($object_ref)), action:KeywordAction::Connive{object:$object_ref}} */
connive_object_controller ::= object_ref "connives"

/* A single object and a plural population use the same native action shape. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Suspect, objects:$object_set} */
suspect_action ::= "suspect" object_set

/* The goad's duration names its own permanent, independently of its recipients. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Goad{until:WhileOnBattlefield($object_ref)}, objects:$affected} */
goad_while_present ::= "as" "long" "as" object_ref "remains" "on" "the" "battlefield" "," affected ("is" | "are") "also" "goaded"

unsuspect_action ::= unsuspect_objects | unsuspect_contracted | unsuspect_conditional

/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Unsuspect, objects:$affected} */
unsuspect_objects ::= affected ("is" | "are") "no" "longer" "suspected"

/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Unsuspect, objects:One(@it)} */
unsuspect_contracted ::= "it's" "no" "longer" "suspected"

/* Removing suspected status already does nothing when that status is absent. */
/* @sem $unsuspect_contracted */
unsuspect_conditional ::= "if" "it's" "suspected" "," unsuspect_contracted

/* Clashing is a game action, not part of a mana payment. */
/* @sem Operation::Clash{actor:One(AbilityController), opponents:OpponentsOf(AbilityController), won:[Program{}], lost:[Program{}]} */
clash_opponent ::= "clash" "with" ("a" | "an") "opponent"

/* Binding the host completes this action's reference focus, after its subject. */
/* Attachment selections and host phrases compose independently. */
/* @sem Operation::AttachEach{actor:One(AbilityController), attachments:$affected, count:$count_any_number, hosts:$attachment_recipient} */
attach_counted_to_host ::= "attach" count_any_number affected "to" attachment_recipient

/* @sem Operation::AttachEach{actor:One(AbilityController), attachments:$object_one, hosts:$attachment_recipient} */
attach_one_to_host ::= "attach" object_one "to" attachment_recipient

attachment_recipient ::= attachment_player_recipient | attachment_target_recipient
/* @sem Recipients::Players(One($player_ref)) */
attachment_player_recipient ::= player_ref
/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any, players:All})) */
attachment_target_recipient ::= "target" "permanent" "or" "player"

/* @sem Operation::Attach{attachments:$attachment_subject, host:@remember_object($attachment_host)} */
attach_objects ::= "attach" attachment_subject "to" attachment_host

/* Each iteration supplies the local host of "it". The count applies to every
   host independently; neither operand is the result of the preceding effect. */
attach_each_host ::= attach_each_optional | attach_each_up_to | attach_each_required | attach_each_required_named

/* @sem Operation::AttachEach{actor:$attach_loop_actor, attachments:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:UpTo(Constant(1)), hosts:Objects($attach_loop_hosts), each_host:true} */
attach_each_optional ::= attach_loop_hosts "," attach_loop_actor "may" "attach" ("a" | "an" | "one") filter_phrase "to" "it"

/* @sem Operation::AttachEach{actor:$attach_loop_actor, attachments:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, count:UpTo($counter_choice_amount), hosts:Objects($attach_loop_hosts), each_host:true} */
attach_each_up_to ::= attach_loop_hosts "," attach_loop_actor "may" "attach" "up" "to" counter_choice_amount filter_plural "to" "it"

/* @sem Operation::AttachEach{actor:One(AbilityController), attachments:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan(Constant(1)), hosts:Objects($attach_loop_hosts), each_host:true} */
attach_each_required ::= attach_loop_hosts "," "you"? "attach" ("a" | "an" | "one") filter_phrase "to" "it"

/* @sem Operation::AttachEach{actor:One($attach_loop_third_actor), attachments:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan(Constant(1)), hosts:Objects($attach_loop_hosts), each_host:true} */
attach_each_required_named ::= attach_loop_hosts "," attach_loop_third_actor "attaches" ("a" | "an" | "one") filter_phrase "to" "it"

attach_loop_third_actor ::= target_player | target_opponent | that_player | defending_player | its_controller | its_owner | stack_controller

attach_loop_hosts ::= attach_loop_created | attach_loop_matching
/* @sem ObjectSet::$created_batch_reference */
attach_loop_created ::= "for" "each" "of" created_batch_reference
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase} */
attach_loop_matching ::= "for" "each" filter_phrase

attach_loop_actor ::= attach_loop_you | attach_loop_named_actor
/* @sem PlayerSet::One(AbilityController) */
attach_loop_you ::= "you"
/* @sem PlayerSet::One($player_ref) */
attach_loop_named_actor ::= player_ref

/* Old instruction-level declarations share the same operation and result. */
/* @sem Instruction::[Effect{result:@next, operation:$attach_each_host}] */
clause_attach_each ::= attach_each_host

/* @sem Operation::SetTapped{objects:$object_set, tapped:true} */
tap_objects ::= "tap" object_set
/* @sem Operation::SetTapped{objects:$object_set} */
untap_objects ::= "untap" object_set
/* @sem Operation::CreateRegenerationShields{objects:$object_set} */
regenerate_objects ::= "regenerate" object_set
/* @sem Operation::@exile_result(Operation::Move{objects:$exile_object_set, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}) */
exile_objects ::= "exile" exile_object_set
/* "Exile the top card of your library face down": the slice, hidden from view. A
   pronoun after a look ("exile it face down") names the looked-at card, which the
   binder does not yet follow; those stay with their own rules. */
/* @sem Operation::Move{objects:$ordered_cards, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_ordered_face_down ::= "exile" ordered_cards "face" "down"
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(PlayerRef::AbilityController), objects:$object_set}) */
sacrifice_objects ::= "sacrifice" object_set

/* A resolving instruction does as much as possible. These selections are not
   activation costs: their result supplies a following reflexive trigger. */
sacrifice_choice ::= sacrifice_counted_union | sacrifice_extreme_selection | sacrifice_one | sacrifice_another | sacrifice_another_or | sacrifice_many
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Constant(1))}) */
sacrifice_one ::= "sacrifice" ("a" | "an") filter_phrase
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@target_contrast(ObjectRef::Source, ObjectFilter::$filter_phrase))), $filter_phrase)}, choose:AsManyAsCan(Constant(1))}) */
sacrifice_another ::= "sacrifice" "another" filter_phrase
/* "Another" qualifies the first alternative only. */
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $filter_phrase), $filter_phrase_2])}, choose:AsManyAsCan(Constant(1))}) */
sacrifice_another_or ::= "sacrifice" "another" filter_phrase "or" ("a" | "an") filter_phrase
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:AsManyAsCan($counter_choice_amount)}) */
sacrifice_many ::= "sacrifice" counter_choice_amount filter_plural

/* Where an object goes. Whose hand or library it is follows from whose card it is. */
/* @sem () */
owners ::= "your" | "its" "owner's" | "their" "owner's" | "their" "owners'" | "their" | "its" | "that" "player's"

/* Explicit ownership is distinct from the ability controller. */
/* @sem () */
owner_possessive ::= "its" "owner's" | "their" "owner's" | "their" "owners'"

battlefield_control ::= battlefield_control_yours | battlefield_control_owner

/* @sem MovementDestination::Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
battlefield_control_yours ::= "under" "your" "control"

/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
battlefield_control_owner ::= "under" owner_possessive "control"

move_hand ::= move_hand_explicit_owner | move_hand_other_possessive | move_linked_card_hand
/* The explicit owner phrase introduces that player for later clauses. */
/* @sem Operation::@owner_return(Operation::Move{objects:@implicit_card_set($affected), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}) */
move_hand_explicit_owner ::= ("return" | "put") affected ("to" | "into") owner_possessive ("hand" | "hands")
/* @sem Operation::Move{objects:@implicit_card_set($affected), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
move_hand_other_possessive ::= ("return" | "put") affected ("to" | "into") hand_other_possessive ("hand" | "hands")
/* @sem () */
hand_other_possessive ::= "your" | "their" | "its" | "that" "player's"
/* A linked population is currently in exile. Its anchor is the named object,
   including the activation's sacrificed holder, not its controller or owner.
   Each card returns to its own owner; singular possessive spelling is allowed. */
/* @sem Operation::Move{objects:Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
move_linked_cards_hand ::= ("return" | "put") "all" "cards" "exiled" "with" object_ref ("to" | "into") "their" ("owner's" | "owners'") ("hand" | "hands")
/* @sem Operation::Move{objects:@implicit_card_set($affected), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]} */
move_graveyard ::= "put" affected "into" owners ("graveyard" | "graveyards")
/* @sem Operation::Move{objects:@implicit_card_set($affected), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
move_top ::= "put" affected "on" "top" "of" owners ("library" | "libraries")
/* @sem Operation::Move{objects:@implicit_card_set($affected), destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
move_bottom ::= "put" affected "on" "the" "bottom" "of" owners ("library" | "libraries")
/* These card targets begin outside the library. DestinationDefault retains
   each receiving library's ordinary ordering and chooser rules. */
/* @sem Operation::Move{objects:$graveyard_target_cards, destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
move_graveyard_top_ordered ::= "put" graveyard_target_cards "on" "top" "of" owners ("library" | "libraries") "in" "any" "order"
/* @sem Operation::Move{objects:$graveyard_target_cards, destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
move_graveyard_bottom_ordered ::= "put" graveyard_target_cards "on" "the" "bottom" "of" owners ("library" | "libraries") "in" "any" "order"
/* @sem Operation::Move{objects:@implicit_card_set($affected), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
move_shuffled ::= "shuffle" affected "into" owners ("library" | "libraries")
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
move_battlefield ::= ("return" | "put") affected ("to" | "onto") "the" "battlefield" ("under" "your" "control")?
/* Prefer the source's `put` wording for this compositional optional graveyard
   target while retaining the shared target phrase and generic move semantics. */
/* @prefer always */
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set(ObjectSet::One($target_card_a_graveyard_up_to_one))), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
put_optional_graveyard_target_battlefield ::= "put" target_card_a_graveyard_up_to_one "onto" "the" "battlefield" "under" "your" "control"
/* An Aura or Equipment that arrives attached names its host: this object, a target or
   what this object is attached to. */
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo($attach_host)]}}, qualifiers:[]} */
move_battlefield_attached ::= "return" affected "to" "the" "battlefield" "attached" "to" attach_host
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo($attach_host)]}}, qualifiers:[]} */
put_battlefield_attached ::= "put" affected "onto" "the" "battlefield" "attached" "to" attach_host
attach_host ::= self_ref | target_object | attached_ref
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, $entry_counter_amount]], states:[]}}, qualifiers:[]} */
move_battlefield_counter ::= ("return" | "put") affected ("to" | "onto") "the" "battlefield" ("under" "your" "control")? "with" entry_counter_amount counter_kind "counter" "on" "it"
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]} */
move_battlefield_tapped ::= ("return" | "put") affected ("to" | "onto") "the" "battlefield" "tapped" ("under" "your" "control")?
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
move_battlefield_owner ::= ("return" | "put") affected ("to" | "onto") "the" "battlefield" "under" owner_possessive "control"
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]} */
move_battlefield_owner_tapped ::= ("return" | "put") affected ("to" | "onto") "the" "battlefield" "tapped" "under" owner_possessive "control"

/* Transformation is an entry state, rather than an instruction after moving.
   Keep the destination's controller and the actual moved objects independent. */
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Player(AbilityController), arrival:$transformed_entry}, qualifiers:[]} */
move_battlefield_transformed ::= ("return" | "put") affected ("to" | "onto") "the" "battlefield" transformed_entry "under" "your" "control"
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Owner, arrival:$transformed_entry}, qualifiers:[]} */
move_battlefield_owner_transformed ::= ("return" | "put") affected ("to" | "onto") "the" "battlefield" transformed_entry "under" owner_possessive "control"

transformed_entry ::= entry_transformed | entry_transformed_tapped
/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[], states:[Transformed]} */
entry_transformed ::= "transformed"
/* @sem BattlefieldArrival::BattlefieldArrival{tapped:true, counters:[], states:[Transformed]} */
entry_transformed_tapped ::= "tapped" "and" "transformed" | "transformed" "and" "tapped"

/* @sem Operation::Mill{players:@subject, amount:$card_count} */
mill_base ::= "mill" card_count
/* @sem Operation::Mill{players:@subject, amount:$card_count} */
mill_third ::= "mills" card_count
/* @sem Operation::Scry{players:@subject, amount:$number} */
scry_base ::= "scry" number
/* @sem Operation::Scry{players:@subject, amount:$value} */
scry_equal ::= "scry" "a" "number" "of" "cards" "equal" "to" value
/* @sem Operation::Scry{players:@subject, amount:$number} */
scry_third ::= "scries" number
/* @sem Operation::Surveil{players:@subject, amount:$number} */
surveil_base ::= "surveil" number
/* @sem Operation::Surveil{players:@subject, amount:$number} */
surveil_third ::= "surveils" number

/* @sem Instruction::[Instruction::Optional{decider:AbilityController, body:Program{instructions:$may_body}}] */
clause_may ::= "you" "may" may_body

/* A then-continuation is part of the same optional resolving action. */
/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:@optional_then($may_body, $conjoined)}}] */
clause_may_then ::= "you" "may" may_body "," "then" conjoined

may_body ::= put_private_card_counter_entry | graveyard_return_single | look_put_then_body | clause_have_continuous | clause_have_deal | clause_player_put_card | clause_imperative | clause_operation | clause_search | clause_search_where_split | clause_search_either | clause_exile_from | clause_put_from | clause_put_from_tapped | copy_ref_may_choose_target | clause_have_retained_animation

/* A cost paid during resolution, and what depends on paying it. */
payment ::= payment_remove_each_selected | payment_mana_and_graveyard_exile | payment_put_counters | payment_return_controlled_permanent | payment_put_hand_card | payment_hand_draw | resolution_life_sacrifice_cost | payment_remove_counters | cost | pay_mana | payment_sacrifice | payment_action | payment_exile | payment_return | payment_tap | payment_draw | payment_have_draw | payment_move_counters_source | payment_return_graveyard_union | payment_mana_and_discard | payment_put_hand_card_attacking | payment_exile_spell_and_named_cards | payment_return_owned_permanent | payment_choice_cost | payment_pair

/* An imperative action has an implicit "you". Other payers use native costs
   or an explicit "have [player]" action, never that implicit performer. */
other_payment ::= payment_have_you_create | payment_mana_and_discard | payment_put_counters | payment_sacrifice_choice | cost | pay_mana | payment_sacrifice | payment_exile | payment_return | payment_tap | payment_draw | payment_have_draw

/* Resolved object references, including damage-event sources, pay the native
   sacrifice cost directly instead of wrapping a sacrifice action as a cost. */
/* @sem Cost::Cost{parts:[CostPart::Sacrifice{objects:$affected}]} */
payment_sacrifice ::= "sacrifice" affected

/* @sem Cost::Cost{parts:[CostPart::Draw{count:$card_count}]} */
payment_draw ::= "draw" card_count

/* A resolving self-payment uses the native counter-removal cost. Its recipient
   is the resolved noun/pronoun, not an assumed source or a retained action body. */
/* @sem Cost::Cost{parts:[RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:Count(Exactly($payment_counter_amount))}]}]} */
payment_remove_counters ::= "remove" payment_counter_amount counter_kind ("counter" | "counters") "from" affected

payment_counter_amount ::= counter_a | number_digits | number_words

/* Putting counters can itself be the resolution cost. Its recipient and the
   payer are independent; the surrounding payment clause binds the receipt. */
/* @sem Cost::Cost{parts:[PutCounters([$counter_direct_placement])]} */
payment_put_counters ::= "put" counter_direct_placement

/* The deciding payer and the player performing this action are independent. */
/* @sem Cost::Cost{parts:[CostPart::PlayerAction{player:$payment_actor, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One($payment_actor), amount:$card_count}}]}}]} */
payment_have_draw ::= "have" payment_actor "draw" card_count

payment_actor ::= payment_you | player_ref

/* @sem PlayerRef::AbilityController */
payment_you ::= "you"

/* @sem Cost::Cost{parts:[CostPart::PlayerAction{player:AbilityController, body:Program{instructions:@offered_action($may_body)}}]} */
payment_action ::= may_body

/* @sem Cost::Cost{parts:[CostPart::Move{selections:[CostObjectSelection{objects:$affected}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]} */
payment_exile ::= "exile" affected

/* @sem Cost::Cost{parts:[CostPart::Move{selections:[CostObjectSelection{objects:$affected}], destination:OwnersHand(CardArrival{counters:[], states:[]})}]} */
payment_return ::= "return" affected "to" owners ("hand" | "hands")

/* @sem Cost::Cost{parts:[CostPart::ChangeTapState{selections:[CostObjectSelection{objects:$affected}], tapped:true}]} */
payment_tap ::= "tap" affected

/* Resolution-time mana X is chosen here unless a surrounding definition supplies it. */
/* @sem Cost::@payment_cost(Cost::Cost{parts:[Mana($mana_symbols)]}, Expr::AnnouncedX) */
resolving_cost_chosen ::= mana_symbols

/* An announced value remains possible when the source spell cost is external. */
/* @sem Cost::@announced_cost(Cost::Cost{parts:[Mana($mana_symbols)]}, Expr::AnnouncedX) */
resolving_cost_announced ::= mana_symbols

resolving_cost ::= resolving_cost_chosen | resolving_cost_announced

/* @sem $resolving_cost */
pay_mana ::= "pay" resolving_cost

/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::PayCost{player:AbilityController, cost:$payment, optional:true}}, Instruction::If{condition:PaymentChosen(@last_result), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_if_you_do ::= "you" "may" payment "." "if" "you" "do" "," conjoined

/* "Discard a card. If you do, draw a card": a required payment that can still fail,
   so the dependent effects test its success. */
/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::PayCost{player:AbilityController, cost:$payment, optional:false}}, Instruction::If{condition:PaymentChosen(@last_result), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_required_if_you_do ::= payment "." "if" "you" "do" "," conjoined

/* "Sacrifice a creature. If you can't, sacrifice this artifact": an action that a
   following "if you can't" tests is a cost paid as the ability resolves (CR 118.12),
   in full or not at all; the dependent effects follow when it was not paid. */
/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::PayCost{player:AbilityController, cost:$payment, optional:false}}, Instruction::If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_required_if_you_cant ::= payment "." "if" "you" "can't" "," conjoined

/* "Sacrifice a creature. Rupture deals damage equal to that creature's power …" and
   "Target player sacrifices an artifact or creature of their choice. Hit deals damage
   to that player equal to that permanent's mana value": damage measured by the
   sacrificed permanent follows a required sacrifice and reads its payment. The damage
   must measure that permanent: an implicit actor its noun proves, or a possessive that
   names it. A written actor's bare "its" reads that actor, so that sacrifice stays a
   plain action. Life or cards measured that way read the sacrifice itself. */
clause_sacrifice_then_damage ::= sacrifice_then_damage_own | sacrifice_then_damage_player
/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::@measured_sacrifice(Operation::PayCost{player:AbilityController, cost:Cost{parts:[$cost_sacrifice]}, optional:false})}, Instruction::If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:$sacrificed_damage}]}, otherwise:Program{}}] */
sacrifice_then_damage_own ::= cost_sacrifice "." sacrificed_damage
/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::@measured_sacrifice(Operation::PayCost{player:$player_ref, cost:Cost{parts:[CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly(Expr::Constant(1))}]}, optional:false})}, Instruction::If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:$sacrificed_damage}]}, otherwise:Program{}}] */
sacrifice_then_damage_player ::= player_ref "sacrifices" ("a" | "an") filter_phrase "of" "their" "choice" "." sacrificed_damage
sacrificed_damage ::= deal_damage_equal | deal_damage_equal_first

/* "You may sacrifice a creature. If you don't, tap this creature": what follows
   happens only when the offered payment is declined. */
/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::PayCost{player:AbilityController, cost:$payment, optional:true}}, Instruction::If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_if_you_dont ::= "you" "may" payment "." "if" "you" "don't" "," conjoined

/* Not taking a conditional offer includes the condition being false. Both
   fallback branches instantiate the same declaration with their own results. */
/* @sem Instruction::[@leading_if(Instruction::If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:$conjoined}, otherwise:Program{}}]}, otherwise:Program{instructions:$conjoined}})] */
clause_if_optional_fallback ::= "if" condition "," "you" "may" payment "." "if" "you" "don't" "," conjoined

/* Both outcomes of one offered payment form one condition and its otherwise branch. */
/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::PayCost{player:AbilityController, cost:$payment, optional:true}}, Instruction::If{condition:PaymentChosen(@last_result), then:Program{instructions:$conjoined}, otherwise:Program{instructions:$conjoined_2}}] */
clause_if_you_do_otherwise ::= "you" "may" payment "." "if" "you" "do" "," conjoined "." "if" "you" "don't" "," conjoined

/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$player_ref, cost:$other_payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_if_they_do ::= player_ref "may" other_payment "." "if" "they" "do" "," conjoined

/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$player_ref, cost:$other_payment, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_if_they_dont ::= player_ref "may" other_payment "." "if" ("they" "don't" | "that" "player" "doesn't" | "that" "opponent" "doesn't") "," conjoined

/* One willing payer completes one optional payment. The chosen payer's own
   graveyard narrows the candidate pool; it is not the ability controller's. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:FirstWilling(All), cost:$willing_exile_payment, optional:true}}, If{condition:$willing_payment_condition, then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_first_willing_exile ::= "any" "player" "may" willing_exile_payment "." willing_payment_condition "," conjoined

/* @sem Cost::Cost{parts:[Move{selections:[_{objects:Zone{scope:Players{zone:Graveyard, players:One(FirstWilling(All))}, kind:Card, filter:Any}, choose:Exactly($card_count)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]} */
willing_exile_payment ::= "exile" card_count "from" "their" "graveyard"

willing_payment_condition ::= willing_payment_done | willing_payment_not_done
/* @sem Condition::PaymentChosen(@marked) */
willing_payment_done ::= "if" "a" "player" "does"
/* @sem Condition::Not(PaymentChosen(@marked)) */
willing_payment_not_done ::= "if" "no" "one" "does"

/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::PayCost{player:AbilityController, cost:$payment, optional:true}}, Instruction::If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Instruction::Effect{result:@next, operation:$operation}]}, otherwise:Program{}}] */
clause_unless_pay ::= operation "unless" "you" payment

/* An optional action keeps its reflexive trigger inside the option. Only the
   trigger announces its targets. Canonical IR flattens instruction groups. */
/* @sem Instruction::[...$reflexive_required, $reflexive_trigger] */
instructions_when_you_do ::= reflexive_required "." reflexive_trigger

reflexive_required ::= clause_operation | clause_imperative | clause_you | clause_third | clause_if_after

instructions_may_when_you_do ::= instructions_may_when_you_do_plain | instructions_may_either_when_you_do

/* @sem Instruction::[Instruction::Optional{decider:AbilityController, body:Program{instructions:[...$reflexive_action, $reflexive_trigger]}}] */
instructions_may_when_you_do_plain ::= "you" "may" reflexive_action "." reflexive_trigger

reflexive_action ::= reflexive_tap_payment | optional_single_card_action | reflexive_counter_removal | variable_discard_reflexive | variable_filtered_discard_reflexive | variable_sacrifice_reflexive | reflexive_action_plain | reflexive_payment

/* @sem Vec<Instruction>::@single_reflexive_base($may_body) */
reflexive_action_plain ::= may_body

/* @sem Instruction::[Instruction::Effect{result:@next, operation:$reflexive_pay_operation}] */
reflexive_payment ::= reflexive_pay_operation

reflexive_pay_operation ::= reflexive_pay_life | reflexive_pay_mana | reflexive_pay_energy

/* @sem Operation::PayCost{player:AbilityController, cost:Cost::Cost{parts:[CostPart::Life($number)]}} */
reflexive_pay_life ::= "pay" number "life"

/* @sem Operation::PayCost{player:AbilityController, cost:$resolving_cost} */
reflexive_pay_mana ::= "pay" resolving_cost

/* Reuse the declared energy resource cost. The enclosing Optional and reflexive
   trigger still own the decision, actual performed result and announcement. */
/* @sem Operation::PayCost{player:AbilityController, cost:Cost::Cost{parts:[$cost_energy]}} */
reflexive_pay_energy ::= cost_energy

/* The payment belongs to the announced spell's controller. The countering
   action and its conditional result still belong to this ability. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf($target_stack_spell), cost:$counter_unless_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@next_slot, index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}] */
clause_counter_unless_plain ::= "counter" target_stack_spell "unless" "its" "controller" "pays" counter_unless_cost
/* "If a Dragon was beheld, counter that spell unless its controller pays {4} instead":
   the spell named earlier, and its controller, pay or lose it. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf($named_spell), cost:$counter_unless_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One($named_spell), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}] */
clause_counter_unless_named ::= "counter" named_spell "unless" "its" "controller" "pays" counter_unless_cost

/* "If they do" names the payment: paying spares the spell and earns the reward. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf($target_stack_spell), cost:$counter_unless_cost, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:$conjoined}, otherwise:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@next_slot, index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}}] */
clause_counter_unless_they_do ::= "counter" target_stack_spell "unless" "its" "controller" "pays" counter_unless_cost "." "if" "they" "do" "," conjoined

/* A targeted permanent's controller may pay to spare it from the action. The
   payment names the target the action announces next; a bare {X} is the
   announced value, as for a counter. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf(Target{slot:@next_slot, index:0}), cost:$counter_unless_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:$spared_action}]}, otherwise:Program{}}] */
clause_spared_unless_paid ::= spared_action "unless" "its" "controller" "pays" counter_unless_cost
spared_action ::= spared_tap | spared_destroy | spared_exile | spared_return
/* @sem Operation::SetTapped{objects:One($target_object), tapped:true} */
spared_tap ::= "tap" target_object
/* @sem Operation::Destroy{objects:One($target_object), regeneration:true} */
spared_destroy ::= "destroy" target_object
/* @sem Operation::Move{objects:One($target_object), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
spared_exile ::= "exile" target_object
/* @sem Operation::Move{objects:One($target_object), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
spared_return ::= "return" target_object "to" "its" "owner's" "hand"

/* "If that spell is countered this way, exile it instead of putting it into its owner's
   graveyard": where the counter puts the spell is part of the counter itself. */
/* @sem Instruction::[Effect{result:@next, operation:Counter{objects:One($target_stack_spell), destination:$countered_destination, destination_when:None}}] */
clause_counter_elsewhere ::= "counter" target_stack_spell "." countered_this_way countered_destination

/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf($target_stack_spell), cost:$counter_unless_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@next_slot, index:0}), destination:$countered_destination, destination_when:None}}]}, otherwise:Program{}}] */
clause_counter_unless_elsewhere ::= "counter" target_stack_spell "unless" "its" "controller" "pays" counter_unless_cost "." countered_this_way countered_destination

/* @sem () */
countered_this_way ::= "if" "that" "spell" "is" "countered" "this" "way" ","

countered_destination ::= countered_exile | countered_library_top | countered_library_bottom | countered_hand
/* @sem MovementDestination::Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}} */
countered_exile ::= "exile" "it" "instead" "of" "putting" "it" "into" "its" "owner's" "graveyard"
/* @sem MovementDestination::Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
countered_library_top ::= "put" "it" "on" "top" "of" "its" "owner's" "library" "instead" "of" "into" "that" "player's" "graveyard"
/* @sem MovementDestination::Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
countered_library_bottom ::= "put" "it" "on" "the" "bottom" "of" "its" "owner's" "library" "instead" "of" "into" "that" "player's" "graveyard"
/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
countered_hand ::= "put" "it" "into" "its" "owner's" "hand" "instead" "of" "into" "that" "player's" "graveyard"

reflexive_trigger ::= reflexive_trigger_plain | reflexive_trigger_if

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, announcement:@announcement, body:$reflexive_callback_program})} */
reflexive_trigger_plain ::= "when" "you" "do" "," reflexive_callback_program

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, condition:$condition, announcement:@announcement, body:$reflexive_callback_program})} */
reflexive_trigger_if ::= "when" "you" "do" "," "if" condition "," reflexive_callback_program


/* @sem Operation::@manifest_result(Operation::Manifest{actor:One(AbilityController), source:TopOfLibrary{player:$top_library_owner, count:Constant(1)}, cloak:false, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
manifest_one ::= "manifest" "the" "top" "card" "of" top_library_owner "library"
/* @sem Operation::@manifest_result(Operation::Manifest{actor:One(AbilityController), source:TopOfLibrary{player:$top_library_owner, count:Constant(1)}, cloak:true, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
cloak_one ::= "cloak" "the" "top" "card" "of" top_library_owner "library"

/* @sem Operation::@manifest_result(Operation::WithSelections{steps:[_{binding:@selection_id(0), objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), chooser:Players(One(AbilityController)), count:Exactly($card_count)}], action:Manifest{actor:One(AbilityController), source:Cards(Prepared(@selection_id(0))), cloak:false, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}) */
manifest_hand ::= "manifest" card_count "from" "your" "hand"
/* @sem Operation::@manifest_result(Operation::WithSelections{steps:[_{binding:@selection_id(0), objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), chooser:Players(One(AbilityController)), count:Exactly($card_count)}], action:Manifest{actor:One(AbilityController), source:Cards(Prepared(@selection_id(0))), cloak:true, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}) */
cloak_hand ::= "cloak" card_count "from" "your" "hand"

/* Optional damage keeps the decider outside the performing source. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:$recipients, amount:$value, preventable:true}}] */
clause_have_deal ::= "have" object_ref "deal" value "damage" "to" recipients

/* A written return operand retains its lexical binding position in seed compositions. */
event_return_object ::= object_ref

/* Returning a card after a departure reads the written operand in its event
   frame. Counter entries are attached to the incoming permanent. */
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[[$counter_kind, Constant(1)]], states:[]}}, qualifiers:[]} */
move_owner_counter_one ::= "return" affected "to" "the" "battlefield" "tapped" "under" owner_possessive "control" "with" "a" counter_kind "counter" "on" "it"
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[]}}, qualifiers:[]} */
move_owner_counter_untapped ::= "return" affected "to" "the" "battlefield" "under" owner_possessive "control" "with" "a" counter_kind "counter" "on" "it"
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[[$counter_kind, $number]], states:[]}}, qualifiers:[]} */
move_owner_counter_many ::= "return" affected "to" "the" "battlefield" "tapped" "under" owner_possessive "control" "with" number counter_kind "counters" "on" "it"

/* "Return it to the battlefield under its owner's control. It's an enchantment.": the
   returning card arrives with enchantment as its only card type. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$affected, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[Changes([SetCardTypes([Enchantment])])]}}, qualifiers:[]}}] */
clause_return_owner_as_enchantment ::= "return" affected "to" "the" "battlefield" "under" owner_possessive "control" "." "it's" "an" "enchantment"

/* A graveyard return tests the same new incarnation it will move. The binder
   supplies CR400.7f only in an enchanted-permanent departure scope. */
/* @sem ObjectRef::@return_ref($self_ref) */
returning_card_ref ::= self_ref

/* Explicit from-your-graveyard restrictions are resolution-time guards, before
   any optional return. They name the current card independently of its owner. */
/* @sem Instruction::[@resolution(Instruction::If{condition:ObjectMatches{object:$returning_card_ref, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One($returning_card_ref), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]}, otherwise:Program{}})] */
clause_graveyard_return_hand ::= "you" "may" "return" returning_card_ref "from" "your" "graveyard" "to" "your" "hand"

/* @sem Instruction::[@resolution(Instruction::If{condition:ObjectMatches{object:$returning_card_ref, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:One($returning_card_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{}})] */
clause_graveyard_return_battlefield ::= "return" returning_card_ref "from" "your" "graveyard" "to" "the" "battlefield"

/* @sem Instruction::[@resolution(Instruction::If{condition:ObjectMatches{object:$returning_card_ref, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One($returning_card_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedToChosen(AllOf([CardType(Creature), Shares{property:CreatureTypes, with:EventSubject}]))]}}, qualifiers:[]}}]}}]}, otherwise:Program{}})] */
clause_graveyard_return_attached ::= "you" "may" "return" returning_card_ref "from" "your" "graveyard" "to" "the" "battlefield" "attached" "to" "a" "creature" "that" "shares" "a" "creature" "type" "with" "that" "creature"

/* The selected permanent's pre-sacrifice information is distinct from the card
   a later action can find. The binder proves scalar cardinality from this action. */
/* @sem @apply($players_singular, $sacrifice_choice_third) */
sacrifice_named_choice ::= players_singular sacrifice_choice_third

/* Secret ballot revelation follows all voters, with the ballot's typed kind. */
clause_secret_vote_reveal ::= secret_optional_object_vote_reveal | secret_player_vote_reveal | secret_other_player_vote_reveal | secret_word_vote_reveal

/* Complete the secret number choices before revealing that kind of choice.
   Keeping the sentences together establishes the revelation's antecedent. */
/* @sem Instruction::[...$secret_number_choices, Effect{result:@next, operation:RevealChoices{kind:Number}}] */
clause_secret_number_reveal ::= secret_number_choices "." "then" "those" "numbers" "are" "revealed"

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseValue{choosers:One(Bound(0)), kind:Number, terms:_{options:$secret_number_bounds, count:Exactly(Constant(1)), secret:true}}}]}}] */
secret_number_choices ::= players_singular "secretly" "chooses" secret_number_bounds

secret_number_bounds ::= secret_number_unrestricted | secret_number_minimum
/* @sem Vec<Operand>::[] */
secret_number_unrestricted ::= "a" "number"
/* @sem Vec<Operand>::[Comparison(GreaterOrEqual, $value)] */
secret_number_minimum ::= "a" "number" value "or" "greater"

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:Players(All), secret:true}}]}}, Effect{result:@next, operation:RevealChoices{kind:Player}}] */
secret_player_vote_reveal ::= players_singular "secretly" "votes" "for" "a" "player" "," "then" "those" "votes" "are" "revealed"

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:Players(OthersThan(Bound(0))), secret:true}}]}}, Effect{result:@next, operation:RevealChoices{kind:Player}}] */
secret_other_player_vote_reveal ::= players_singular "secretly" "votes" "for" "another" "player" "," "then" "those" "votes" "are" "revealed"

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:Words([Truth, Consequences]), secret:true}}]}}, Effect{result:@next, operation:RevealChoices{kind:Word}}] */
secret_word_vote_reveal ::= players_singular "secretly" "votes" "for" "truth" "or" "consequences" "," "then" "those" "votes" "are" "revealed"

/* The damage dealer is an object; the recipient is bound by this vote loop. */
/* @sem Instruction::[ForEachPlayer{players:Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:PlayerState{player:Bound(0), state:ReceivedAVote}}]), binding:0, body:_{instructions:[Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Union([Players(One(Bound(0))), Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))])})]), amount:Multiply($value, Votes(Player(Bound(0)))), preventable:true}}]}}] */
clause_vote_opponent_damage ::= "for" "each" "vote" "an" "opponent" "received" "," object_ref "deals" value "damage" "to" "that" "player" "and" "each" filter_phrase "that" "player" "controls"

/* @sem Instruction::[Effect{result:@next, operation:ChooseAtRandom(_{kind:Player, options:[Players(OpponentsOf(AbilityController))]})}, Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(One(Chosen)), amount:Multiply($value, Votes(Word(Consequences))), preventable:true}}] */
clause_chosen_vote_damage ::= "choose" "an" "opponent" "at" "random" "." object_ref "deals" value "damage" "to" "that" "player" "for" "each" "consequences" "vote"

/* The second-recipient rules start after the first target. Their slot reads
   precede their own target introduction and cannot capture that new target. */
clause_damage_parts ::= clause_damage_controlled_each | clause_damage_controlled_target | clause_damage_same_controller | clause_damage_distinct_pair | clause_damage_distinct_three | clause_damage_opponent_choice
controller_damage_recipient ::= recipients_player_or_walker | recipients_opponent_or_walker

/* @sem Instruction::[Effect{result:@next, operation:DealDamageParts{source:$damage_source_ref, parts:[_{recipients:$controller_damage_recipient, amount:$number}, _{recipients:$controller_damage_each, amount:$number_2}], preventable:true}}] */
clause_damage_controlled_each ::= damage_source_ref "deals" number "damage" "to" controller_damage_recipient "and" number "damage" "to" controller_damage_each

/* @sem Instruction::[Effect{result:@next, operation:DealDamageParts{source:$damage_source_ref, parts:[_{recipients:$controller_damage_recipient, amount:$number}, _{recipients:$controller_damage_second_target, amount:$number_2}], preventable:true}}] */
clause_damage_controlled_target ::= damage_source_ref "deals" number "damage" "to" controller_damage_recipient "and" number "damage" "to" controller_damage_second_target

controller_damage_second_target ::= controller_damage_exact | controller_damage_up_to
/* @sem Recipients::Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:AllOf([$filter_head, ControlledBy(One(PlayerOrControllerOf(Targets(@last_slot))))])}), index:0})) */
controller_damage_exact ::= "target" filter_head "that" "player" "or" "that" "planeswalker's" "controller" "controls"
/* @sem Recipients::Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(Expr::Constant(1)), filter:AllOf([$filter_head, ControlledBy(One(PlayerOrControllerOf(Targets(@last_slot))))])}), index:0})) */
controller_damage_up_to ::= "up" "to" "one" "target" filter_head "that" "player" "or" "that" "planeswalker's" "controller" "controls"

/* @sem Recipients::Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_head, ControlledBy(One(PlayerOrControllerOf(Targets(@last_slot))))])}) */
controller_damage_each ::= "each" filter_head "that" "player" "or" "that" "planeswalker's" "controller" "controls"

/* Each mode owns its announced targets; the reflexive trigger shares only the parent result cursor. */
/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, announcement:Announcement{modes:$reflexive_mode_selection}, body:Program{}})} */
reflexive_trigger_modal ::= "when" "you" "do" "," reflexive_mode_selection

/* The final mode sentence also closes its enclosing reflexive-trigger program. */
program_sentence_reflexive_modal ::= program_sentence_may_reflexive_modal | program_sentence_required_reflexive_modal
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[...$reflexive_action, $reflexive_trigger_modal]}}]} */
program_sentence_may_reflexive_modal ::= "you" "may" reflexive_action "." reflexive_trigger_modal
/* @sem Program::Program{instructions:[...$reflexive_required, $reflexive_trigger_modal]} */
program_sentence_required_reflexive_modal ::= reflexive_required "." reflexive_trigger_modal

/* Reflexive modes own targets but allocate results after the performed action. */
reflexive_mode_selection ::= reflexive_choose_number | reflexive_choose_one_or_both | reflexive_choose_one_or_more
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$reflexive_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
reflexive_choose_number ::= "choose" number_words "—" NEWLINE reflexive_modes
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(2)}, options:$reflexive_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
reflexive_choose_one_or_both ::= "choose" "one" "or" "both" "—" NEWLINE reflexive_modes
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:@length($reflexive_modes)}, options:$reflexive_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
reflexive_choose_one_or_more ::= "choose" "one" "or" "more" "—" NEWLINE reflexive_modes
reflexive_modes ::= reflexive_modes_one | reflexive_modes_more
/* @sem Mode::[$reflexive_mode] */
reflexive_modes_one ::= reflexive_mode
/* @sem Mode::[$reflexive_mode, ...$reflexive_modes] */
reflexive_modes_more ::= reflexive_mode NEWLINE reflexive_modes
/* @sem @reflexive(Mode::Mode{announcement:@announcement, body:$program_sentence, weight:1}) */
reflexive_mode ::= "•" program_sentence

/* The discard wording names an actual preceding single-card discard, not an
   optional-payment decision or an unrelated earlier discard in game history. */
/* @sem Instruction::[...$discard_reflexive_action, $discard_reflexive_trigger] */
instructions_discard_reflexive ::= "you"? discard_reflexive_action "." discard_reflexive_trigger

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[...$discard_reflexive_action, $discard_reflexive_trigger]}}] */
instructions_may_discard_reflexive ::= "you" "may" discard_reflexive_action "." discard_reflexive_trigger

discard_reflexive_action ::= discard_reflexive_unfiltered | discard_reflexive_filtered

/* @sem Instruction::[Effect{result:@next, operation:Discard{players:One(AbilityController), amount:Constant(1)}}] */
discard_reflexive_unfiltered ::= "discard" "a" "card"

/* The filtered choice is not the performed discard receipt. The final Effect
   is DiscardObjects, so the existing reflexive owner reads that actual action.
   AsManyAsCan keeps an empty hand from inventing a successful discard. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}] */
discard_reflexive_filtered ::= "discard" ("a" | "an") card_filter "card"

discard_reflexive_trigger ::= discard_reflexive_plain | discard_reflexive_typed

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, announcement:@announcement, body:$discard_reflexive_body})} */
discard_reflexive_plain ::= "when" "you" "discard" "a" "card" ("this" "way")? "," discard_reflexive_body

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, condition:Compare{left:CountObjects(Matching{objects:Transition{result:@prior, phase:Before}, filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, announcement:@announcement, body:$discard_reflexive_body})} */
discard_reflexive_typed ::= "when" "you" "discard" ("a" | "an") card_filter "card" ("this" "way")? "," discard_reflexive_body

/* An explicit target supplies the continuation's object. General discarded-card
   anaphora remain outside this family until their producer focus is owned. */
discard_reflexive_body ::= discard_reflexive_counters | discard_reflexive_unblockable | discard_reflexive_damage

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[CounterPlacement::_{recipients:Objects(One($target_object)), kind:$counter_kind, amount:$counter_amount}]}}]} */
discard_reflexive_counters ::= "put" counter_amount counter_kind ("counter" | "counters") "on" target_object

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_object)), changes:[Rule(Prohibit(BeBlocked(Any)))], duration:EndOfTurn, evaluation:LiveObjects}}]} */
discard_reflexive_unblockable ::= target_object "can't" "be" "blocked" "this" "turn"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref, recipients:Objects(One($target_object)), amount:$number, preventable:true}}]} */
discard_reflexive_damage ::= self_ref "deals" number "damage" "to" target_object

/* A single discarded card supplies the property, even after the reflexive
   announces a new player target. The receipt is before the discard transition. */
/* @sem $discard_receipt_value_sequence */
instructions_discard_receipt_value ::= "you"? discard_receipt_value_sequence

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:$discard_receipt_value_sequence}}] */
instructions_may_discard_receipt_value ::= "you" "may" discard_receipt_value_sequence

/* @sem Instruction::[Effect{result:@mark, operation:Discard{players:One(AbilityController), amount:Constant(1)}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Mill{players:One($target_player), amount:ObjectProperty{object:Query{objects:Transition{result:@marked, phase:Before}, index:0}, property:$stat, information:CurrentOrLastKnown}}}]}})}] */
discard_receipt_value_sequence ::= "discard" "a" "card" "." "when" "you" "discard" "a" "card" ("this" "way")? "," target_player "mills" "cards" "equal" "to" "its" stat

clause_villainous_each ::= clause_villainous_each_grouped | clause_villainous_each_program

/* Each opponent chooses, while each option retains its own written performer.
   Local bound-player words cannot escape this loop or replace explicit you. */
/* @sem Instruction::[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseAction{actor:One(Bound(0)), options:[List([Program($villainous_option)]), List([Program($villainous_option_2)])], villainous:true}}]}}] */
clause_villainous_each_grouped ::= "each" "opponent" "faces" "a" "villainous" "choice" "—" villainous_option "," "or" villainous_option


/* Both native operand containers carry the same single program. Keep each
   typed form available; neither erases the villainous marker or its chooser. */
/* @sem Instruction::[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseAction{actor:One(Bound(0)), options:[Program($villainous_option), Program($villainous_option_2)], villainous:true}}]}}] */
clause_villainous_each_program ::= "each" "opponent" "faces" "a" "villainous" "choice" "—" villainous_option "," "or" villainous_option

villainous_option ::= villainous_discard_hand | villainous_hand_damage | villainous_sacrifice | villainous_each_damage | villainous_draw_chaos | villainous_you_option | villainous_opponent_option
/* @sem () */
villainous_opponent_words ::= "that" ("player" | "opponent")
/* @sem Program::Program{instructions:@apply(PlayerSet::One(PlayerRef::AbilityController), $verbs_base)} */
villainous_you_option ::= "you" verbs_base
/* @sem Program::Program{instructions:@apply(PlayerSet::One(PlayerRef::Bound(0)), $verbs_third)} */
villainous_opponent_option ::= villainous_opponent_words verbs_third
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Sacrifice{players:One(Bound(0)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$villainous_sacrifice_filter}, choose:AsManyAsCan($counter_amount)}}]} */
villainous_sacrifice ::= villainous_opponent_words "sacrifices" counter_amount villainous_sacrifice_filter "of" "their" "choice"
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Discard{players:One(Bound(0)), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any})}}, Effect{result:@next, operation:Draw{players:One(Bound(0)), amount:Subtract([CountObjects(MovedBy{result:@prior, phase:After, player:Bound(0)}), $value])}}]} */
villainous_discard_hand ::= villainous_opponent_words "discards" "all" "the" "cards" "in" "their" "hand" "," "then" "draws" "that" "many" "cards" "minus" value
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(One(Bound(0))), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), preventable:true}}]} */
villainous_hand_damage ::= "this" "creature" "deals" "damage" "to" villainous_opponent_words "equal" "to" "the" "number" "of" "cards" "in" "their" "hand"
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamageFromEach{sources:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, recipients:Players(One(Bound(0))), amount:$value}}]} */
villainous_each_damage ::= "each" filter_phrase "deals" value "damage" "to" villainous_opponent_words
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::ChaosEnsues}}]} */
villainous_draw_chaos ::= "you" "draw" card_count "and" "chaos" "ensues"


villainous_sacrifice_filter ::= filter_phrase | filter_plural

/* An "is" characteristic following a nontoken battlefield move applies as the
   object enters (CR 611.2e). It belongs to entry, before enters triggers see it;
   a later "becomes" stays a continuous effect. */
entry_subtype_instructions ::= entry_characteristics_more | entry_subtype_return | entry_subtype_put | entry_characteristics_move

/* @sem Instruction::[Effect{result:@next, operation:@arrival_changes($operation, $entry_characteristics)}] */
entry_characteristics_move ::= operation "." entry_characteristics

entry_characteristics ::= entry_stats_type_keyword | entry_that_creature_subtype_changes | entry_subtype_changes | entry_color_subtype_changes | entry_colored_subtype_changes | entry_plural_stats_types_keyword | entry_singular_color_type_stats

/* @sem () */
entry_subject ::= "it's" | ("it" | "that" "creature") "is"

/* "Is black" sets its color; "a black Zombie in addition to its other colors" adds it. */
/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word]}, CreatureTypes{mode:Add, types:Listed($becomes_types)}] */
entry_color_subtype_changes ::= entry_subject mana_color_word "and" "is" ("a" | "an") becomes_types "in" "addition" "to" "its" "other" "creature" "types"

/* @sem Change::[Colors{mode:Add, colors:[$mana_color_word]}, CreatureTypes{mode:Add, types:Listed($becomes_types)}] */
entry_colored_subtype_changes ::= entry_subject ("a" | "an") mana_color_word becomes_types "in" "addition" "to" "its" "other" "colors" "and" "types"

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[Changes($entry_subtype_changes)]}}, qualifiers:[]}}] */
entry_subtype_return ::= "return" target_card "to" "the" "battlefield" "." entry_subtype_changes

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[Changes($entry_subtype_changes)]}}, qualifiers:[]}}] */
entry_subtype_put ::= "put" target_card "onto" "the" "battlefield" "under" "your" "control" "." entry_subtype_changes

/* @sem Change::[CreatureTypes{mode:Add, types:Listed($becomes_types)}] */
entry_subtype_changes ::= entry_subject ("a" | "an")? becomes_types "in" "addition" "to" "its" "other" ("creature")? "types"

/* Move an Aura to a different host sharing one of the printed host types.
   The destination is chosen on resolution, not a second announced target.
   Reusing the typed subject also keeps its slot local after earlier targets. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([AnyOf([CardType(Creature), CardType(Land)]), Not(SameObject($aura_retarget_previous_host)), SharesTypeFrom{types:[Creature, Land], with:$aura_retarget_previous_host}])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Attach{attachments:One($aura_retarget_subject), host:Result{result:@prior, phase:After, index:0}}}] */
clause_aura_retarget ::= "attach" aura_retarget_subject aura_retarget_previous_host
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Subtype(Aura), ObjectFilter::AttachedTo(InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([CardType(Creature), CardType(Land)])})))}), index:0} */
aura_retarget_subject ::= "target" "Aura" "attached" "to" "a" "creature" "or" "land"
/* The later host phrase reads the already introduced Aura, not a candidate
   destination. Its separate hole leaves only the subject as a target introduction. */
/* @sem ObjectRef::AttachedTo(@named_object) */
aura_retarget_previous_host ::= "to" "another" "permanent" "of" "that" "type"

/* One announced graveyard card supplies both alternative destinations. The
   condition names a separate object, even when it changes pronoun focus. */
/* @sem Instruction::[If{condition:ObjectMatches{object:$conditional_return_condition_ref, filter:$filter_head}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[ChooseOne{decider:AbilityController, options:[Program{instructions:[Effect{result:@next, operation:Move{objects:One($conditional_return_target), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, Program{instructions:[Effect{result:@next, operation:Move{objects:One($conditional_return_reference), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}]}]}}]}, otherwise:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One($conditional_return_reference), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]}}] */
conditional_card_return_clause ::= "you" "may" "return" conditional_return_target "to" "your" "hand" "." "if" conditional_return_condition_ref "is" "a" filter_head "," "you" "may" "return" conditional_return_reference "to" "the" "battlefield" "instead"

/* Both explicit filters are operands, not an inferred card name or slot. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($non_land, $card_permanent, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0} */
conditional_return_target ::= "target" non_land card_permanent "card" "from" "your" "graveyard"

/* Reference-only condition syntax introduces no slot between the initial card
   and this suffix. The allocated last slot therefore still names that card. */
conditional_return_condition_ref ::= it_ref | attached_ref | self_ref
/* @sem ObjectRef::Target{slot:@last_slot, index:0} */
conditional_return_reference ::= "that" "nonland" "permanent" "card"

/* Returning either domain is one ordinary Move. Other action families keep
   their own spell/permanent distinction rather than inheriting this target. */
/* @sem Operation::@owner_return(Operation::Move{objects:One($target_spell_or_noun), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}) */
move_mixed_target_hand ::= ("return" | "put") target_spell_or_noun ("to" | "into") owner_possessive ("hand" | "hands")

/* Resolution prose keeps the second cost verb lowercase. Both parts belong
   to the same optional payment; the sacrifice receipt is component one. */
/* @sem Cost::Cost{parts:[$cost_life, $cost_sacrifice]} */
resolution_life_sacrifice_cost ::= cost_life "," cost_sacrifice

/* The draw reads the actual removal receipt, never the initial counter count.
   Keep this two-action clause explicit rather than rebinding bare that-many
   after unrelated actions, token creation, or counter placements. */
/* @sem Instruction::[Effect{result:@mark, operation:$remove_counted_counters}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountersRemoved(@marked)}}] */
clause_remove_draw ::= remove_counted_counters "." "draw" "that" "many" "cards"

remove_counted_counters ::= remove_all_kind_counters | remove_exact_kind_counters | remove_any_kind_counters
/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:All}]} */
remove_all_kind_counters ::= "remove" "all" counter_kind "counters" "from" affected
/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:Count(Exactly($counter_amount))}]} */
remove_exact_kind_counters ::= "remove" counter_amount counter_kind ("counter" | "counters") "from" affected

/* Shared trailing quantity governs both actions and names this actual removal.
   The incomplete draw prefix is not an independent Oracle instruction. */
/* @sem Instruction::[Effect{result:@mark, operation:$remove_counted_counters}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountersRemoved(@marked)}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:CountersRemoved(@marked)}}] */
clause_remove_draw_lose ::= remove_counted_counters "." "you" "draw" "cards" "and" "lose" "life" "equal" "to" "the" "number" "of" "counters" "removed" "this" "way"

/* The permanent domain includes typeless permanents; the printed filter adds
   only actual restrictions, never an enumeration of current card types. */
/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}), amount:AmongThem(AnyNumber)}]} */
remove_any_kind_counters ::= "remove" "any" "number" "of" "counters" "from" "among" filter_plural "on" "the" "battlefield"

/* The where clause belongs to the eager positive branch, after the exact
   optional receipt. Both existing where mappings preserve their own timing. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:$paid_where_program, otherwise:Program{}}] */
/* @prefer always */
clause_if_you_do_where ::= "you" "may" payment "." "if" "you" "do" "," paid_where_program

paid_where_program ::= program_where | program_where_snapshot

/* A complete transfer introduces its singular source target before reading its
   slot in the recipient constraint. No standalone modifier guesses a referent. */
/* @sem Operation::MoveCounters{actor:One(AbilityController), from:One($target_permanent), to:One($same_controller_counter_target), kind:$counter_kind, amount:$same_controller_counter_amount} */
move_same_controller_counters ::= "move" same_controller_counter_amount counter_kind ("counter" | "counters") "from" target_permanent "onto" same_controller_counter_target

/* @sem MovedCounters::One */
same_controller_counter_one ::= "a"
/* @sem MovedCounters::AnyNumber */
same_controller_counter_any ::= "any" "number" "of"
/* @sem MovedCounters::All */
same_controller_counter_all ::= "all"
same_controller_counter_amount ::= same_controller_counter_one | same_controller_counter_any | same_controller_counter_all

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Not(SameObject(Target{slot:@last_slot, index:0})), $filter_phrase, ObjectFilter::ControlledBy(One(ControllerOf(Target{slot:@last_slot, index:0}))))}), index:0} */
same_controller_counter_target ::= "another" "target" filter_phrase "with" "the" "same" "controller"

/* Only the Aura is targeted. The new host is chosen on resolution relative to
   the current host, whose controller can differ from the Aura's controller. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$same_controller_attachment_host}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Attach{attachments:One($same_controller_aura_target), host:Result{result:@prior, phase:After, index:0}}}] */
clause_attach_same_controller ::= "attach" same_controller_aura_target same_controller_attachment_host

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Subtype(Aura), ObjectFilter::AttachedTo(InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:Any})))}), index:0} */
same_controller_aura_target ::= "target" "Aura" "attached" "to" "a" "permanent"

/* The later host phrase reads the already introduced Aura. */
/* @sem @and(ObjectFilter::Not(SameObject(AttachedTo(@named_object))), $filter_phrase, ObjectFilter::ControlledBy(One(ControllerOf(AttachedTo(@named_object))))) */
same_controller_attachment_host ::= "to" "another" filter_phrase "with" "the" "same" "controller"

/* A counter-unless bare {X} uses the announced value. A local scalar must
   supply its explicit definition, never ask the opponent to choose a new X. */
clause_counter_unless_pay ::= clause_counter_unless_plain | clause_counter_unless_named | clause_counter_unless_computed | clause_counter_unless_extra | clause_counter_unless_x_spell | clause_counter_unless_that_spell | clause_counter_unless_that_ability
counter_unless_cost ::= resolving_cost_announced | counter_unless_source_price | counter_unless_per_each

/* A price repeated for each counted object. */
/* @sem Cost::Cost{parts:[Repeated{part:Mana($mana_symbols), times:$count_each}]} */
counter_unless_per_each ::= mana_symbols "for" "each" count_each

/* Direct source quantities retain their supplied-cost representation. */
/* @sem Cost::@payment_cost(Cost::Cost{parts:[Mana($mana_symbols)]}, @inline_counter_price($counter_price_value)) */
counter_unless_source_price ::= mana_symbols "," "where" "X" "is" counter_price_value

/* Capture the explicitly computed payment price before asking its payer.
   Token-order binding introduces the spell target before the value's pronoun,
   although BindValue precedes PayCost in execution order. */
/* @sem Instruction::[Effect{result:@mark, operation:BindValue{value:@captured_counter_price($counter_price_value)}}, Effect{result:@next, operation:PayCost{player:ControllerOf($target_stack_spell), cost:@payment_cost(Cost::Cost{parts:[Mana($mana_symbols)]}, Expr::BoundValue(@marked)), optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@next_slot, index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}] */
clause_counter_unless_computed ::= "counter" target_stack_spell "unless" "its" "controller" "pays" mana_symbols "," "where" "X" "is" counter_price_value

/* Source-counter prices compose without relying on a learned scalar row.
   Explicit holder words preserve the holder/card-name distinction. */
counter_price_value ::= value | counter_price_source_counters
/* @sem Expr::CountCounters{recipients:Objects(One($self_ref_holder)), kind:$counter_kind, information:CurrentOrLastKnown} */
counter_price_source_counters ::= "the" "number" "of" counter_kind "counters" "on" self_ref_holder

/* The repeated connive wording names this exact scalar producer, not whichever
   unrelated operation most recently yielded a result. The continuation has its
   own source position, so producer target introductions bind before its scope. */
/* @sem Instruction::[$connive_receipt_producer, $connive_receipt_continuation] */
instructions_connive_reflexive ::= connive_receipt_producer "." connive_receipt_continuation

/* @sem Instruction::Effect{result:@mark, operation:Keyword{actor:One(ControllerOf($object_ref)), action:KeywordAction::Connive{object:$object_ref}}} */
connive_receipt_producer ::= object_ref "connives"

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$program})} */
connive_receipt_continuation ::= "when" "it" "connives" "this" "way" "," program

/* The compound cost has one chosen-payment receipt, including if drawing
   is replaced. Its conditional trigger closes over that exact payment. */
/* @sem Instruction::[...$hand_draw_reflexive_action, $hand_draw_reflexive_trigger] */
instructions_may_hand_draw_reflexive ::= "you" "may" hand_draw_reflexive_action "." hand_draw_reflexive_trigger

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$payment_hand_draw, optional:true}}] */
hand_draw_reflexive_action ::= payment_hand_draw

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$program})} */
hand_draw_reflexive_trigger ::= "when" "you" "do" "," program

/* A singular actual discard, not a payment choice, supplies the card property.
   Register its reflexive immediately; subsequent draw/seek remains in the parent.
   The target announcement belongs only to the reflexive ability. */
/* @sem Instruction::[...$discard_property_action, $discard_property_callback, ...$discard_property_tail] */
instructions_discard_property_tail ::= "you"? discard_property_action discard_property_tail "." discard_property_callback
/* @sem Instruction::[...$discard_property_action, $discard_property_callback] */
instructions_discard_property ::= "you"? discard_property_action "." discard_property_callback
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[...$discard_property_action, $discard_property_callback]}}] */
instructions_may_discard_property ::= "you" "may" discard_property_action "." discard_property_callback
/* @sem Instruction::[Effect{result:@mark, operation:Discard{players:One(AbilityController), amount:Constant(1)}}] */
discard_property_action ::= "discard" "a" "card"
discard_property_tail ::= discard_property_draw | discard_property_seek
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}] */
discard_property_draw ::= "," "then" "draw" card_count
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
discard_property_seek ::= "," "then" "seek" ("a" | "an") card_filter "card"
discard_property_callback ::= discard_property_plain | discard_property_typed
/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$discard_property_body})} */
discard_property_plain ::= "when" "you" "discard" "a" "card" "this" "way" "," discard_property_body
/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, announcement:@announcement, body:$discard_property_body})} */
discard_property_typed ::= "when" "you" "discard" ("a" | "an") card_filter "card" "this" "way" "," discard_property_body
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref, recipients:$recipients, amount:ObjectProperty{object:Query{objects:Transition{result:@marked, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown}, preventable:true}}]} */
discard_property_body ::= self_ref "deals" "damage" "equal" "to" discard_property_words "mana" "value" "to" recipients
/* @sem () */
discard_property_words ::= "the" "discarded" "card's" | "that" "card's"

/* A singular creature sacrifice supplies its immutable Before information.
   The callback owns its targets; conditional subtype tests read that same receipt. */
/* @sem Instruction::[...$sacrifice_creature_receipt, $sacrifice_value_callback] */
instructions_sacrifice_value ::= sacrifice_creature_receipt "." sacrifice_value_callback
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[...$sacrifice_creature_receipt, $sacrifice_value_callback]}}] */
instructions_may_sacrifice_value ::= "you" "may" sacrifice_creature_receipt "." sacrifice_value_callback
sacrifice_creature_receipt ::= sacrifice_value_one | sacrifice_value_another
/* @sem Instruction::[Effect{result:@mark, operation:Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:AsManyAsCan(Constant(1))}}] */
sacrifice_value_one ::= "sacrifice" "a" "creature"
/* @sem Instruction::[Effect{result:@mark, operation:Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), ObjectFilter::CardType(Creature))}, choose:AsManyAsCan(Constant(1))}}] */
sacrifice_value_another ::= "sacrifice" "another" "creature"
/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$sacrifice_value_body})} */
sacrifice_value_callback ::= "when" "you" "do" "," sacrifice_value_body
sacrifice_value_body ::= sacrifice_value_draw | sacrifice_value_instead
/* @sem Expr::ObjectProperty{object:Query{objects:Transition{result:@marked, phase:Before}, index:0}, property:$stat, information:CurrentOrLastKnown} */
sacrifice_before_stat ::= ("that" "creature's" | "the" "sacrificed" "creature's") stat
/* @sem Condition::Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$subtype}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
sacrifice_before_type ::= "the" "sacrificed" "creature" "was" ("a" | "an") subtype
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref, recipients:$recipients, amount:$sacrifice_before_stat, preventable:true}}, If{condition:$sacrifice_before_type, then:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$sacrifice_before_stat}}]}, otherwise:Program{}}]} */
sacrifice_value_draw ::= self_ref "deals" "X" "damage" "to" recipients "," "where" "X" "is" sacrifice_before_stat "." "if" sacrifice_before_type "," "draw" "X" "cards"
/* @sem Program::Program{instructions:[If{condition:$sacrifice_before_type, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref, recipients:$recipients, amount:Multiply([Constant(2), $sacrifice_before_stat]), preventable:true}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref_2, recipients:$recipients, amount:$sacrifice_before_stat, preventable:true}}]}}]} */
sacrifice_value_instead ::= self_ref "deals" "damage" "equal" "to" sacrifice_before_stat "to" recipients "." "if" sacrifice_before_type "," self_ref "deals" "twice" "that" "much" "damage" "instead"

/* A heterogeneous single target is selected while announcing this source cast
   trigger. Each implied alternative owns its target scope and removal receipt. */
/* @sem Ability::Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:$repeat_cast_header, limits:TriggerLimits{}, announcement:Announcement{modes:$mixed_remove_reduction_modes}, body:Program{}})} */
source_cast_mixed_counter_reduction ::= repeat_cast_header "," mixed_remove_reduction_modes

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:Any}), index:0})), amount:All}]}}, Effect{result:@next, operation:Operation::ChangeSpell{subject:Next{spells:Any, player:AbilityController, this_turn:true}, changes:[SpellCost(Reduce{reductions:[_{amount:@times($braced_amount, Expr::CountersRemoved(@marked))}], spill_into_generic:true})]}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Players(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:UpTo(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0})), amount:All}]}}, Effect{result:@next, operation:Operation::ChangeSpell{subject:Next{spells:Any, player:AbilityController, this_turn:true}, changes:[SpellCost(Reduce{reductions:[_{amount:@times($braced_amount, Expr::CountersRemoved(@marked))}], spill_into_generic:true})]}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied} */
mixed_remove_reduction_modes ::= "remove" "all" "counters" "from" "up" "to" "one" "target" "permanent" "or" "opponent" "." "the" "next" "spell" "you" "cast" "this" "turn" "costs" braced_amount "less" "to" "cast" "for" "each" "counter" "removed" "this" "way" "."

/* Damage.Source is the actual damage holder, including inside grants; it is
   not inferred from a new target or the card which created a granted ability. */
/* @sem Ability::Triggered{event:$mixed_counter_damage_header, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[$mixed_counter_put_completion, $mixed_counter_remove_reflexive]}} */
mixed_counter_damage_trigger ::= mixed_counter_damage_header "," mixed_counter_put_completion mixed_counter_remove_reflexive

/* @sem EventSpec::Damage{source_kind:Permanent, sources:SameObject($self_ref), recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source} */
mixed_counter_damage_header ::= ("when" | "whenever") self_ref "deals" "combat" "damage" "to" "a" "player"

/* @sem Instruction::Effect{result:@mark, operation:PutCounters{placements:[_{recipients:Objects(One(@remember_operand(ObjectRef::@it))), kind:$counter_kind, amount:$counter_amount}]}} */
mixed_counter_put_completion ::= "put" counter_amount counter_kind ("counter" | "counters") "on" "it" "."

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:Announcement{modes:$mixed_remove_optional_modes}, body:Program{}})} */
mixed_counter_remove_reflexive ::= "when" "you" "do" "," mixed_remove_optional_modes "."

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@reflexive(Mode::Mode{announcement:@announcement, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:Not(SameObject(@that_object))}), index:0})), amount:Count(Exactly(Constant(1)))}]}}]}}]}, weight:1}), @reflexive(Mode::Mode{announcement:@announcement, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Players(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0})), amount:Count(Exactly(Constant(1)))}]}}]}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied} */
mixed_remove_optional_modes ::= "you" "may" "remove" "a" "counter" "from" "another" "target" "permanent" "or" "opponent"

/* Both components are one resolving cost. A replaced draw counts as payment,
   while a prohibition makes the entire optional payment unavailable. */
/* @sem Cost::Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Discard{players:One(AbilityController), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), random:false}}]}}, Draw{count:$card_count}]} */
payment_hand_draw ::= "discard" "your" "hand" "and" "draw" card_count

/* A loop receipt belongs to one declared producer and its finite typed tails.
   Neither an unrelated preceding action nor a generic optional program can
   supply these references. The loop does not create a new result frame. */
clause_player_optional_receipts ::= player_counter_receipt_sequence | opponent_token_receipt_sequence | player_discard_receipt_sequence | opponent_investigate_receipt_sequence

/* @sem Instruction::[$player_counter_receipt_loop, $player_counter_receipt_goad] */
player_counter_receipt_sequence ::= player_counter_receipt_loop "." player_counter_receipt_goad

/* @sem Instruction::ForEachPlayer{players:$optional_player_population, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@mark, operation:$optional_player_counter_action}]}}]}} */
player_counter_receipt_loop ::= optional_player_population "may" optional_player_counter_action

optional_player_population ::= players_each | players_each_opponent

/* The action, chooser and controlled population all belong to the walked player.
   One creature is chosen at resolution, without introducing a target. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(Bound(0))))}), kind:$counter_kind, amount:$counter_amount, selection:_{player:Bound(0), count:AsManyAsCan(Constant(1))}}]} */
optional_player_counter_action ::= "put" counter_amount counter_kind ("counter" | "counters") "on" ("a" | "an") filter_phrase "they" "control"

/* Affected is the applied-counter receipt, not the offered or selected objects.
   The battlefield filter prevents a later incarnation from inheriting the goad. */
/* @sem Instruction::Effect{result:@next, operation:KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Goad{}, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::InSet(Affected(@marked)))}}} */
player_counter_receipt_goad ::= "goad" "each" filter_phrase "that" "had" "counters" "put" "on" "it" "this" "way"

/* A token offer uses its native optional payment. Its action allocates a
   distinct result in this ability; the marked outer PayCost names participation. */
/* @sem Instruction::[$opponent_token_receipt_loop, ...$opponent_token_receipt_tails] */
opponent_token_receipt_sequence ::= opponent_token_receipt_loop "." opponent_token_receipt_tails

/* @sem Instruction::ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:Bound(0), cost:Cost::Cost{parts:[PlayerAction{player:Bound(0), body:Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(Bound(0)), tokens:[$opponent_offer_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}]}, optional:true}}]}} */
opponent_token_receipt_loop ::= "each" "opponent" "may" "create" opponent_offer_token

/* A declared cardinal amount avoids a free-standing "that many" lookup in
   the middle of allocating this offer's outer and inner result addresses. */
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:Rules, recipe:$token_named_recipe} */
opponent_offer_token ::= counter_amount token_named_recipe ("token" | "tokens")

opponent_token_receipt_tails ::= opponent_token_receipt_bonus_only | opponent_receipt_negative_only | opponent_receipt_negative_bonus | opponent_token_receipt_bonus_negative
/* @sem Instruction::[$opponent_token_receipt_bonus] */
opponent_token_receipt_bonus_only ::= opponent_token_receipt_bonus
/* @sem Instruction::[$opponent_receipt_negative] */
opponent_receipt_negative_only ::= opponent_receipt_negative
/* @sem Instruction::[$opponent_receipt_negative, $opponent_token_receipt_bonus] */
opponent_receipt_negative_bonus ::= opponent_receipt_negative "." opponent_token_receipt_bonus
/* @sem Instruction::[$opponent_token_receipt_bonus, $opponent_receipt_negative] */
opponent_token_receipt_bonus_negative ::= opponent_token_receipt_bonus "." opponent_receipt_negative

/* Participation counts players, independently of the inner creation amount. */
/* @sem Instruction::Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:@times($counter_amount, Expr::CountPlayers(Matching{binding:0, condition:PlayerTook{player:Bound(0), result:@marked}})), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}} */
opponent_token_receipt_bonus ::= "for" "each" "opponent" "who" "does" "," "you" "create" counter_amount token_named_recipe ("token" | "tokens")

/* The complement is relative to the original opponents. It never includes the
   controller or a player who was not offered the action. */
/* @sem Instruction::Effect{result:@next, operation:LoseLife{players:Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Not(PlayerTook{player:Bound(0), result:@marked})}]), amount:$number}} */
opponent_receipt_negative ::= "each" "opponent" "who" "doesn't" "loses" number "life"

/* Actual discarded cards and participation are separate receipt views. A player
   who chose an empty discard did not discard a card; later type tests read the
   aggregate Before snapshots, even after intervening draws or token creation. */
/* @sem Instruction::[$player_discard_receipt_loop, ...$player_discard_receipt_tails] */
player_discard_receipt_sequence ::= player_discard_receipt_loop "." player_discard_receipt_tails

/* @sem Instruction::ForEachPlayer{players:All, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@mark, operation:Discard{players:One(Bound(0)), amount:$card_count, random:false}}]}}]}} */
player_discard_receipt_loop ::= "each" "player" "may" "discard" card_count

player_discard_receipt_tails ::= player_discard_receipt_draw_only | player_discard_receipt_draw_conditions
/* @sem Instruction::[$player_discard_receipt_draw] */
player_discard_receipt_draw_only ::= player_discard_receipt_draw
/* @sem Instruction::[$player_discard_receipt_draw, ...$player_discard_receipt_conditions] */
player_discard_receipt_draw_conditions ::= player_discard_receipt_draw "." player_discard_receipt_conditions

/* @sem Instruction::Effect{result:@next, operation:Draw{players:Matching{binding:0, condition:Compare{left:CountObjects(MovedBy{result:@marked, phase:After, player:Bound(0)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}, amount:$card_count}} */
player_discard_receipt_draw ::= "each" "player" "who" "discarded" "a" "card" "this" "way" "draws" card_count

player_discard_receipt_conditions ::= player_discard_receipt_create_only | player_discard_receipt_counters_only | player_discard_receipt_create_counters | player_discard_receipt_counters_create
/* @sem Instruction::[$player_discard_receipt_create] */
player_discard_receipt_create_only ::= player_discard_receipt_create
/* @sem Instruction::[$player_discard_receipt_counters] */
player_discard_receipt_counters_only ::= player_discard_receipt_counters
/* @sem Instruction::[$player_discard_receipt_create, $player_discard_receipt_counters] */
/* @prefer always */
player_discard_receipt_create_counters ::= player_discard_receipt_create "." "then"? player_discard_receipt_counters
/* @sem Instruction::[$player_discard_receipt_counters, $player_discard_receipt_create] */
/* @prefer always */
player_discard_receipt_counters_create ::= player_discard_receipt_counters "." "then"? player_discard_receipt_create

/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$discard_receipt_bonus_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{}} */
player_discard_receipt_create ::= "if" ("a" | "an") card_filter "card" "was" "discarded" "this" "way" "," "you" "create" discard_receipt_bonus_token

/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:$discard_receipt_bonus_counters}]}, otherwise:Program{}} */
player_discard_receipt_counters ::= "if" ("a" | "an") card_filter "card" "was" "discarded" "this" "way" "," discard_receipt_bonus_counters

/* These bonus leaves exclude generic "that many" / "for each ... this way"
   amount shortcuts, whose older @prior address would name the intervening draw.
   The declared discard receipt remains the only source for the outer guards. */
discard_receipt_bonus_token ::= discard_receipt_bonus_defined | discard_receipt_bonus_named
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:$token_recipe} */
discard_receipt_bonus_defined ::= counter_amount token_recipe
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:Rules, recipe:$token_named_recipe} */
discard_receipt_bonus_named ::= counter_amount token_named_recipe ("token" | "tokens")

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_head, ObjectFilter::ControlledBy(One(AbilityController)))}), kind:$counter_kind, amount:$counter_amount}]} */
discard_receipt_bonus_counters ::= "put" counter_amount counter_kind ("counter" | "counters") "on" "each" filter_head "you" "control"

/* Investigation is an optional action, not the token offer's PlayerAction
   payment. The shared negative consumer still complements only opponents. */
/* @sem Instruction::[$opponent_investigate_receipt_loop, $opponent_receipt_negative, $opponent_investigate_receipt_bonus] */
opponent_investigate_receipt_sequence ::= opponent_investigate_receipt_loop "." opponent_receipt_negative "." opponent_investigate_receipt_bonus

/* @sem Instruction::ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@mark, operation:Keyword{actor:One(Bound(0)), action:KeywordAction::Investigate{}}}]}}]}} */
opponent_investigate_receipt_loop ::= "each" "opponent" "may" "investigate"

/* The amount counts participating opponents, not Clues produced. Its offset
   remains a current operand; X is defined by this exact ordinary continuation. */
/* @sem Instruction::Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Investigate{times:Add([$opponent_investigate_receipt_offset, Expr::CountPlayers(Matching{binding:0, condition:PlayerTook{player:Bound(0), result:@marked}})])}}} */
opponent_investigate_receipt_bonus ::= "you" "investigate" "X" "times" "," "where" "X" "is" opponent_investigate_receipt_offset "plus" "the" "number" "of" "opponents" "who" "investigated" "this" "way"

opponent_investigate_receipt_offset ::= number_digits | number_words

/* A resolution choice is not the actual discard receipt. A zero selection
   performs no discard and does not fire the reflexive, like declining. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, count:AnyNumber}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}] */
variable_discard_reflexive ::= "discard" "any" "number" "of" "cards"
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AnyNumber}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}] */
variable_filtered_discard_reflexive ::= "discard" "one" "or" "more" card_filter "cards"
/* @sem Instruction::[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:AnyNumber}}] */
variable_sacrifice_reflexive ::= "sacrifice" "one" "or" "more" filter_plural

/* Exclusive alternatives share the targeted action, not a callback receipt.
   Each option binds its own result and reflexive target announcement. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[@reflexive(Program::Program{instructions:[Effect{result:@next, operation:$callback_either_operation}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$callback_either_effect}]}})}]}), @reflexive(Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$cost, optional:false}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$callback_either_effect}]}})}]}), Program{}]}] */
instructions_may_either_when_you_do ::= "you" "may" callback_either_operation "or" "pay" cost "." "when" "you" "do" "," callback_either_effect

callback_either_effect ::= callback_either_tap | callback_either_destroy
/* @sem Operation::SetTapped{objects:One($target_object), tapped:true} */
callback_either_tap ::= "tap" target_object
/* @sem Operation::Destroy{objects:One($target_object), regeneration:true} */
callback_either_destroy ::= "destroy" target_object

callback_either_operation ::= callback_sacrifice_operation | callback_discard_operation
/* @sem Operation::Discard{players:One(AbilityController), amount:$card_count, random:false} */
callback_discard_operation ::= "discard" card_count

/* @sem Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Constant(1))} */
callback_sacrifice_operation ::= "sacrifice" ("a" | "an") filter_phrase


reflexive_callback_program ::= callback_counter_keyword_program | program | callback_named_hand_program | callback_flashback_program

/* Each instruction retains its lexical position: the possessive discard
   follows the target-player announcement introduced by the reveal clause. */
/* @sem Program::Program{instructions:[$callback_choose_name, $callback_hand_reveal, $callback_named_discard]} */
callback_named_hand_program ::= callback_choose_name "," "then" callback_hand_reveal "and" callback_named_discard

/* @sem Instruction::Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:CardName, terms:_{count:Exactly(Constant(1)), options:[$card_name_option]}}} */
callback_choose_name ::= "choose" card_name_option

/* @sem Instruction::Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($callback_hand_player)}, kind:Card, filter:Any}}} */
callback_hand_reveal ::= callback_hand_player "reveals" "their" "hand"

/* @sem Instruction::Effect{result:@next, operation:DiscardObjects{objects:Zone{scope:Players{zone:Hand, players:One(@that_player)}, kind:Card, filter:Chosen(CardName)}}} */
callback_named_discard ::= "discards" "all" "cards" "with" "that" "name"

callback_hand_player ::= target_player | target_opponent
/* A card name to choose: any Oracle card's, or one of a card type, of two
   card types at once, or of a nonbasic land. */
card_name_option ::= card_name_other_than_kind | card_name_any | card_name_typed
/* @sem Operand::Term{family:CardsInOracle, form:AnyOracleCard} */
card_name_any ::= "a" "card" "name"
/* @sem $card_name_kind */
card_name_typed ::= ("a" | "an") card_name_kind "card" "name"
card_name_kind ::= card_name_basic_land | card_name_type | card_name_nonbasic_land | card_name_two_types
/* @sem Operand::Term{family:CardsInOracle, form:And, operands:[$card_name_type, $card_name_type_2]} */
card_name_two_types ::= card_name_type "," card_name_type
/* @sem Operand::Term{family:CardsInOracle, form:And, operands:[Term{family:CardsInOracle, form:IsNonSupertype, operands:[Vocabulary{family:SuperType, form:Basic}]}, Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Land}]}]} */
card_name_nonbasic_land ::= "nonbasic" "land"
card_name_type ::= card_name_artifact | card_name_creature | card_name_nonartifact | card_name_noncreature | card_name_nonland
/* @sem Operand::Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Artifact}]} */
card_name_artifact ::= "artifact"
/* @sem Operand::Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Creature}]} */
card_name_creature ::= "creature"
/* @sem Operand::Term{family:CardsInOracle, form:IsNonCardtype, operands:[Vocabulary{family:CardType, form:Artifact}]} */
card_name_nonartifact ::= "nonartifact"
/* @sem Operand::Term{family:CardsInOracle, form:IsNonCardtype, operands:[Vocabulary{family:CardType, form:Creature}]} */
card_name_noncreature ::= "noncreature"
/* @sem Operand::Term{family:CardsInOracle, form:IsNonCardtype, operands:[Vocabulary{family:CardType, form:Land}]} */
card_name_nonland ::= "nonland"

/* The written fighter and its counterpart retain distinct lexical roles. A
   reflexive callback can act on the actual scalar battlefield-move receipt; a
   newly announced fighter does not shadow an earlier named opposing creature. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:ObjectRef::@reflexive_moved_fight_object($object_ref), second:ObjectRef::@fight_prior_counterpart($object_ref_2)}} */
fight_action ::= ("then")? object_ref "fights" object_ref

/* An explicitly acted-on combat object remains the following pronoun's focus. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RemoveFromCombat{object:ObjectRef::@remember_object($object_ref)}} */
remove_from_combat_action ::= "remove" object_ref "from" "combat"

/* A singular graveyard target produces one exile transition. The passive
   creature/card condition examines that actual moved object's before image;
   it never treats an unrelated earlier action as an exile receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, $passive_exiled_card_trigger] */
instructions_exile_passive_card ::= "exile" target_card "." passive_exiled_card_trigger

/* Keep the callback's lexical origin at When, after the parent's target. */
/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, condition:Compare{left:CountObjects(Matching{objects:Transition{result:@prior, phase:After}, filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, announcement:@announcement, body:$reflexive_callback_program})} */
passive_exiled_card_trigger ::= "when" ("a" | "an") card_filter "card" "is" "exiled" "this" "way" "," reflexive_callback_program

/* One-or-more cards is a single callback for this mill action, not one
   callback per milled card. The header is not registered independently. */
/* @sem Instruction::[Effect{result:@next, operation:Mill{players:OpponentsOf(AbilityController), amount:$card_count}}, $passive_milled_batch_trigger] */
instructions_opponents_mill_passive ::= "each" "opponent" "mills" card_count "." passive_milled_batch_trigger

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, announcement:@announcement, body:$reflexive_callback_program})} */
passive_milled_batch_trigger ::= "when" "one" "or" "more" "cards" "are" "milled" "this" "way" "," reflexive_callback_program

/* The comparison belongs to the card being announced, while the reference
   value belongs to the explicitly named spell, not to that target card. */
/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:ObjectProperty{object:$object_ref, property:ManaValue, information:CurrentOrLastKnown}}}, InZone(Players{zone:Graveyard, players:OpponentsOf(AbilityController)})])}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_card_no_greater_than_spell ::= "exile" "target" card_filter "card" "with" "equal" "or" "lesser" "mana" "value" "than" object_ref "from" "an" "opponent's" "graveyard"

/* @sem Instruction::[Effect{result:@next, operation:$exile_card_no_greater_than_spell}] */
clause_exile_card_no_greater_than_spell ::= exile_card_no_greater_than_spell

/* The copy is made from this clause's actual exile result; the optional cast
   consumes the copy result. This is not a normal-cost cast or Source query. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_card_no_greater_than_spell}, ...$copy_exiled_free_continuation] */
instructions_exile_compare_copy_free ::= exile_card_no_greater_than_spell "." copy_exiled_free_continuation

/* @sem Instruction::[Effect{result:@next, operation:CopyCards{actor:One(AbilityController), objects:One(Result{result:@prior, phase:After, index:0}), times:Constant(1)}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Copies(@prior), count:Exactly(Constant(1)), cost:Free}}]}}] */
copy_exiled_free_continuation ::= "copy" "the" "exiled" "card" "." "you" "may" "cast" "the" "copy" "without" "paying" "its" "mana" "cost"

/* Each written producer draws one card. Scoped pairs preserve two actual
   receipts; the Optional owns both another player's draw and callback.
   Reuse only an operation payload, never result-bearing callback instructions. */
/* @sem Instruction::[Effect{result:@mark, operation:Draw{players:One(AbilityController), amount:Constant(1)}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$shared_single_draw_damage}]}})}, ForEachPlayer{players:OthersThan(AbilityController), binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:@reflexive(Program::Program{instructions:[Effect{result:@mark, operation:Draw{players:One(Bound(0)), amount:Constant(1)}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$shared_single_draw_damage}]}})}]})}]}}] */
instructions_shared_single_draw_callback ::= "draw" "a" "card" "," "then" "each" "other" "player" "may" "draw" "a" "card" "." shared_single_draw_damage

/* @sem $passive_random_damage_operation */
shared_single_draw_damage ::= "whenever" "a" "card" "is" "drawn" "this" "way" "," passive_random_damage_operation

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController), constraints:[AtRandom]}), index:0} */
passive_random_target_opponent ::= "target" "opponent" "chosen" "at" "random" "from" "among" "your" "opponents"

/* @sem Operation::DealDamage{source:$object_ref, recipients:Players(One($passive_random_target_opponent)), amount:$number, preventable:true} */
passive_random_damage_operation ::= object_ref "deals" number "damage" "to" passive_random_target_opponent

/* @sem Instruction::[Effect{result:@next, operation:$passive_random_damage_operation}] */
clause_passive_random_damage ::= passive_random_damage_operation

/* The written failure action belongs to unless. The following paid clause
   supplies only success; the fused form names this exact immutable payment receipt.
   Keep success atomic so an independent later sentence cannot be captured. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:$paid_success_operation}]}, otherwise:Program{instructions:[Effect{result:@next, operation:$operation}]}}] */
clause_unless_pay_followup ::= operation "unless" "you" payment "." "if" "you" "pay" "," paid_success_operation


paid_success_operation ::= paid_success_damage_all | paid_success_draw | paid_success_life

/* @sem Operation::DealDamage{source:$object_ref, recipients:Union([Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}), Players(All)]), amount:$value, preventable:true} */
paid_success_damage_all ::= object_ref "deals" "damage" "equal" "to" value "to" "each" filter_phrase "and" "each" "player"

/* @sem Operation::Draw{players:One(AbilityController), amount:Constant(1)} */
paid_success_draw ::= "draw" "a" "card"

/* @sem Operation::GainLife{players:One(AbilityController), amount:$number} */
paid_success_life ::= "gain" number "life"

/* A resolving choice between two battlefield query sweeps. Neither option
   introduces targets or admits an arbitrary multi-instruction program. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[Program{instructions:[Effect{result:@next, operation:SetTapped{objects:$query_tap_sweep, tapped:true}}]}, Program{instructions:[Effect{result:@next, operation:SetTapped{objects:$query_tap_sweep_2, tapped:false}}]}]}] */
clause_query_tap_or_untap ::= "tap" query_tap_sweep "or" "untap" query_tap_sweep
query_tap_sweep ::= objects_all_sharing | objects_all | objects_each

/* A literal zero-or-one card slot also has a complete chosen-set view.
   The indexed view remains available; wider or unknown bounds do not enter. */
/* @sem Operation::Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:Any})), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_optional_graveyard_card_set ::= "exile" "up" "to" ("one" | "1") "target" "card" "from" "a" "graveyard"

/* The producer is marked before an intervening play permission. The native
   callback is installed from that actual action, not the latest effect. */
/* @prefer always */
/* @sem Instruction::[...$card_exile_value_producer, $card_exile_value_reflexive, ...$card_exile_play_permission] */
instructions_exile_card_value_reflexive ::= card_exile_value_producer "." card_exile_play_permission "." card_exile_value_reflexive

/* @sem Instruction::[...$card_exile_value_producer, Effect{result:@next, operation:DealDamage{source:$self_ref, recipients:Players(One(AbilityController)), amount:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}, preventable:true}}, ...$card_exile_play_permission] */
instructions_exile_card_damage_permission ::= card_exile_value_producer "." self_ref "deals" "damage" "to" "you" "equal" "to" "that" "card's" "mana" "value" "." card_exile_play_permission

/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
card_exile_value_producer ::= "exile" "the" "top" "card" "of" "your" "library"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}] */
card_exile_play_permission ::= "you" "may" "play" ("it" | "that" "card") this_duration

/* The following permission is a dependent continuation of this actual exile,
   including when the whole unit is inside a conditional. */
/* @sem Instruction::[...$card_exile_value_producer, Effect{result:@next, operation:$play_that_card_permission}] */
conditional_top_card_permission ::= card_exile_value_producer "." play_that_card_permission

/* A random opponent is chosen before damage, independently of its source. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseAtRandom{kind:Player, options:[Players(OpponentsOf(AbilityController))]}}, Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(One(Chosen)), amount:$value, preventable:true}}] */
clause_random_opponent_damage ::= object_ref "deals" value "damage" "to" "an" "opponent" "chosen" "at" "random"

/* A Curse moves on: the random opponent is chosen among the others before it attaches. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseAtRandom{kind:Player, options:[Players(Intersection([OthersThan(EnchantedBy(Source)), OpponentsOf(AbilityController)]))]}}, Effect{result:@next, operation:AttachEach{actor:One(AbilityController), attachments:One($object_ref), hosts:Players(One(Chosen)), each_host:false}}] */
clause_attach_random_opponent ::= "attach" object_ref "to" "another" "one" "of" "your" "opponents" "chosen" "at" "random"

card_exile_value_reflexive ::= card_exile_plain_value_reflexive | card_exile_filtered_value_reflexive

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, announcement:@announcement, body:$card_exile_value_damage})} */
card_exile_filtered_value_reflexive ::= "when" "you" "exile" ("a" | "an") card_filter "card" "this" "way" "," card_exile_value_damage

/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref, recipients:$recipients, amount:Aggregate{objects:Transition{result:@marked, phase:After}, property:ManaValue, aggregation:Sum}, preventable:true}}]} */
card_exile_value_damage ::= self_ref "deals" "damage" "equal" "to" "the" "exiled" "card's" "mana" "value" "to" recipients

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$card_exile_value_pump})} */
card_exile_plain_value_reflexive ::= "when" "you" "exile" "a" "card" "this" "way" "," card_exile_value_pump

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_permanent)), changes:[Pump{power:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}, toughness:Constant(0)}], duration:EndOfTurn, evaluation:Snapshot}}]} */
card_exile_value_pump ::= target_permanent "gets" "+X/+0" "until" "end" "of" "turn" "," "where" "X" "is" "that" "card's" "mana" "value"

/* The two written filters must denote the same unique stopping card.
   Snapshot before reorder; callback reads only that captured value. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:@agree($card_filter, $card_filter_2), count:Constant(1)}}, Effect{result:@next, operation:BindValue{value:ObjectProperty{object:Query{objects:Matching{objects:Observed(@marked), filter:@agree($card_filter, $card_filter_2)}, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:Random}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:@agree($card_filter, $card_filter_2)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, announcement:@announcement, body:$card_reveal_value_damage})}] */
instructions_reveal_card_value_reflexive ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" ("a" | "an") card_filter "card" "." "put" "the" "revealed" "cards" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order" "." "when" "you" "reveal" ("a" | "an") card_filter "card" "this" "way" "," card_reveal_value_damage

/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref, recipients:$recipients, amount:BoundValue(@back(4)), preventable:true}}]} */
card_reveal_value_damage ::= self_ref "deals" "damage" "equal" "to" "that" "card's" "mana" "value" "to" recipients

/* Same unique stop/header card; snapshot precedes its move and rest reorder. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:@agree($card_filter, $card_filter_2), count:Constant(1)}}, Effect{result:@next, operation:BindValue{value:ObjectProperty{object:Query{objects:Matching{objects:Observed(@marked), filter:@agree($card_filter, $card_filter_2)}, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:@agree($card_filter, $card_filter_2)}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Random}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:@agree($card_filter, $card_filter_2)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, announcement:@announcement, body:$card_reveal_value_counters})}] */
instructions_reveal_move_card_value_reflexive ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" ("a" | "an") card_filter "card" "." "put" "that" "card" "into" "your" "hand" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order" "." "when" "you" "reveal" ("a" | "an") card_filter "card" "this" "way" "," card_reveal_value_counters

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($target_permanent)), kind:$counter_kind, amount:BoundValue(@back(5))}]}}]} */
card_reveal_value_counters ::= "put" "X" counter_kind "counters" "on" target_permanent "," "where" "X" "is" "the" "mana" "value" "of" "that" "card"

/* A resolving "if you do" payment selects one physical card before moving it.
   Choosing no card is declining the optional cost, not paying an empty effect. */
/* @sem Cost::Cost{parts:[Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$a_card}, choose:Exactly(Constant(1))}], destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
payment_put_hand_card ::= "put" a_card "from" "your" "hand" "onto" "the" "battlefield"

/* A fixed positive whole-card selection is available only with that many
   physical graveyard cards. The callback announces targets after the exile
   action, using that actual move's receipt rather than the selection result. */
/* @sem Instruction::[@resolution(Instruction::If{condition:Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$exile_positive_card_count}}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}, count:AsManyAsCan($exile_positive_card_count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, $reflexive_trigger]}}]}, otherwise:Program{}})] */
instructions_may_exile_exact_reflexive ::= "you" "may" "exile" exile_positive_card_count "from" "your" "graveyard" "." reflexive_trigger

exile_positive_card_count ::= card_count_one | exile_positive_cards
/* @sem $count_plural */
exile_positive_cards ::= count_plural "cards"

/* A strict optional PlayerAction payment encloses the actual discard callback.
   Failure to choose payment alone causes the independent sacrifice. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Discard{players:One(AbilityController), amount:Constant(1), random:false}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One($discard_mana_value_target), regeneration:true}}]}})}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:One($self_explicit_ref)}}]}, otherwise:Program{instructions:[]}}] */
instructions_sacrifice_unless_discard_callback ::= "sacrifice" self_explicit_ref "unless" "you" "discard" "a" "card" "." "when" "you" "discard" "a" "card" "this" "way" "," "destroy" discard_mana_value_target
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf(@unordered([ControlledBy(OpponentsOf(AbilityController)), Not(CardType(Land)), Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:ObjectProperty{object:Query{objects:Transition{result:@reflexive_performed, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}]))}), index:0} */
discard_mana_value_target ::= "target" "nonland" "permanent" "an" "opponent" "controls" "with" "mana" "value" "less" "than" "or" "equal" "to" "the" "mana" "value" "of" "the" "discarded" "card"

/* The optional arbitrary-size choice and its discard are one producer group;
   the callback counts actual Before discard objects, never the selection. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AnyNumber}}, Effect{result:@mark, operation:DiscardObjects{objects:Selected(@prior)}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:$recipients, amount:Multiply([$discard_damage_multiplier, CountObjects(Transition{result:@reflexive_performed, phase:Before})]), preventable:true}}]}})}]}}] */
instructions_optional_plural_discard_callback ::= "you" "may" "discard" "any" "number" "of" card_filter "cards" "." "when" "you" "discard" "one" "or" "more" "cards" "this" "way" "," self_explicit_ref "deals" discard_damage_multiplier "that" "much" "damage" "to" recipients
discard_damage_multiplier ::= discard_damage_twice | discard_damage_times
/* @sem Expr::Constant(2) */
discard_damage_twice ::= "twice"
/* @sem $number */
discard_damage_times ::= number "times"

/* The explicit paid-action paragraph owns selection and play permission. A
   declined discard supplies neither the exile receipt nor a usable card. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost::Cost{parts:[$impulse_discard_part]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[$paid_impulse_exile, $paid_impulse_choose, ...$card_exile_play_permission]}, otherwise:Program{}}] */
instructions_paid_impulse_choice ::= "you" "may" impulse_discard_part "." "if" "you" "do" "," paid_impulse_exile "," "then" paid_impulse_choose "." card_exile_play_permission

impulse_discard_part ::= cost_discard | cost_discard_many

/* @sem Instruction::Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:$card_count, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}} */
paid_impulse_exile ::= "exile" "the" "top" card_count "of" "your" "library"

/* Mark this zero-or-one choice independently of the exile. Permission names
   its selected card, never all exiled cards or the later permission effect. */
/* @sem Instruction::Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Transition{result:@prior, phase:After}, count:AsManyAsCan(Constant(1))}} */
paid_impulse_choose ::= "choose" "one" "of" "them"

/* Three independently chosen cards remain separate receipts until their one
   simultaneous return. Discard history follows replacements, not a fresh zone. */
/* @sem Instruction::[Effect{result:@mark, operation:Discard{players:One(AbilityController), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountObjects(Transition{result:@marked, phase:Before})}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Recorded(@marked), filter:@and($filter_phrase, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:$number}})}, count:Exactly(Constant(1))}}]}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Recorded(@marked), filter:@and($filter_phrase_2, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:$number_2}})}, count:Exactly(Constant(1))}}]}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Recorded(@marked), filter:@and($filter_phrase_2, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:$number_3}})}, count:Exactly(Constant(1))}}]}}, Effect{result:@next, operation:Move{objects:Union([Selected(@back(4)), Selected(@back(3)), Selected(@prior)]), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
instructions_discard_triple_return ::= "discard" triple_return_hand "," "then" "draw" "that" "many" "cards" "." "you" "may" "choose" ("a" | "an") filter_phrase "card" "with" "mana" "value" number "you" "discarded" "this" "way" "," "then" "do" "the" "same" "for" filter_phrase "cards" "with" "mana" "values" number "and" number "." "return" "those" "cards" "to" "the" "battlefield"
/* @sem () */
triple_return_hand ::= "your" "hand" | "all" "the" "cards" "in" "your" "hand"

/* Own the single physical top-card receipt across an intervening property action. */
/* @sem Instruction::[...$card_exile_value_producer, ...$receipt_span_permission] */
instructions_exile_receipt_plain ::= card_exile_value_producer "." receipt_span_permission

/* @sem Instruction::[...$card_exile_value_producer, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}, ...$receipt_span_permission] */
/* @prefer always */
instructions_exile_receipt_life ::= card_exile_value_producer "." "you" "lose" "life" "equal" "to" "its" "mana" "value" "." receipt_span_permission

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:$receipt_span_duration, evaluation:LiveObjects}}] */
receipt_span_permission ::= "you" "may" "play" ("it" | "that" "card") receipt_span_duration

receipt_span_duration ::= this_turn | until_end_of_your_next_turn

/* @prefer always */
instructions_exile_receipt_span ::= instructions_exile_one_permission | instructions_exile_many_permission | instructions_exile_each_permission | instructions_exile_receipt_life | instructions_exile_receipt_plain

/* Explicit alternative bundles are chosen independently for each counted object.
   Keep each bundle intact; `any one color` retains its existing nested choice. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:$count_each, production:$mana_each_alternatives, choice:EachUnit}} */
add_alternative_mana_each ::= "add" mana_each_alternatives "for" "each" count_each

mana_each_alternatives ::= mana_or | mana_or_list

/* Only the pre-existing fixed/any-color forms keep the legacy outer timing. */
mana_for_each_existing ::= mana_bundle | mana_any_color | mana_any_one_color

/* Preserve the complete counted object set of the legacy `for affected` route. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:CountObjects($affected), production:$mana_each_alternatives, choice:EachUnit}} */
add_alternative_mana_population ::= "add" mana_each_alternatives "for" affected

/* These two operands select physical cards outside the battlefield. In that
   domain permanent means the six permanent card types, not battlefield Any. */
private_card_transfer_filter ::= card_filter | private_card_three_and
/* @sem ObjectFilter::AnyOf([$card_word, $card_word_2, $card_word_3]) */
private_card_three_and ::= card_word "," card_word "," "and" card_word

/* @sem Operation::Move{objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:$private_card_transfer_filter}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
put_all_revealed_private_cards ::= "put" "all" private_card_transfer_filter "cards" "revealed" "this" "way" "into" "your" "hand"

/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$private_card_transfer_filter}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_all_private_cards ::= "return" "all" private_card_transfer_filter "cards" "from" "your" "graveyard" "to" "the" "battlefield"
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$private_card_transfer_filter}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]} */
return_all_private_cards_tapped ::= "return" "all" private_card_transfer_filter "cards" "from" "your" "graveyard" "to" "the" "battlefield" "tapped"
/* Your graveyard holds only cards you own, so "your hand" is each card's owner's hand. */
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$private_card_transfer_filter}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_all_private_cards_hand ::= "return" "all" private_card_transfer_filter "cards" "from" "your" "graveyard" "to" "your" "hand"
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_all_graveyard_cards_hand ::= "return" "all" "cards" "from" "your" "graveyard" "to" "your" "hand"

/* Explicit program wrappers retain the callback's own announcement/receipt
   boundary. The plural declaration already snapshots the ORIGINAL population
   with NoteObjects, independently of counter replacement/prevention. */
callback_counter_keyword_program ::= callback_counter_scalar_program | callback_counter_plural_program
/* @sem Program::Program{instructions:$clause_counter_target_keyword} */
callback_counter_scalar_program ::= clause_counter_target_keyword
/* @sem Program::Program{instructions:$clause_counters_same_group} */
callback_counter_plural_program ::= clause_counters_same_group

/* Resolution action, not the identically worded activation CostPart. The
   existing Optional/Reflexive composition owns the decision and completion. */
/* @sem Instruction::[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:AmongThem(Exactly($number))}]}}] */
reflexive_counter_removal ::= "remove" number counter_kind "counters" "from" "among" affected


/* Entry attachment is part of the Move, not an Attach instruction after entry.
   The explicit token noun keeps the earlier actual produced batch; the entry
   state chooses a legal host from that batch if a target card actually enters. */
/* @sem Operation::Move{objects:One($created_token_entry_target), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedToChosen(ObjectFilter::InSet($created_attachment_token))]}}, qualifiers:[]} */
return_card_attached_to_created_token ::= "return" created_token_entry_target "to" "the" "battlefield" "attached" "to" created_attachment_token

/* Up to one permits an empty announcement. The Card domain and graveyard
   restriction describe the returning object, independently of its token host. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:@and($card_filter, ObjectFilter::InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}))}), index:0} */
created_token_entry_target ::= "up" "to" "one" "target" card_filter "card" "from" "your" "graveyard"

/* A private-card return uses CardFilter: permanent excludes instant and
   sorcery cards, unlike the battlefield noun's deliberately unrestricted Any. */
/* @sem Operation::Move{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:@and($private_card_transfer_filter, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}})}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_all_private_cards_with_mana_value ::= "return" "all" private_card_transfer_filter "cards" "with" "mana" "value" number "or" "less" "from" "your" "graveyard" "to" "the" "battlefield"

/* Each player uses their own graveyard and enters under their own control. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:$card_filter}), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}] */
clause_players_return_all ::= players_singular "returns" "all" card_filter "cards" "from" "their" "graveyard" "to" "the" "battlefield"

/* This history consumer is private to its explicit preceding discard loop. */
/* @sem Operation::LoseLife{players:Intersection([$players_singular, Intersection([$players_singular, Matching{binding:0, condition:Compare{left:Earlier{what:Discarded, measure:Count, filter:$adjective_nontype, by:Bound(0)}, test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}}])]), amount:$value} */
player_discard_missing_filter_loss ::= players_singular "who" "didn't" "discard" "a" adjective_nontype "card" "this" "way" "loses" value "life"

/* @sem Operation::Keyword{actor:$player_one, action:KeywordAction::Skip{part:UntapStep}} */
single_player_skip_next_untap ::= player_one "skips" "their" "next" "untap" "step"

/* @sem Instruction::[ForEachPlayer{players:$loop_player_population, binding:0, body:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(Bound(0)), action:KeywordAction::Skip{part:UntapStep}}}]}}] */
clause_players_skip_next_untap ::= loop_player_population "skips" "their" "next" "untap" "step"

/* @sem Instruction::[$player_discard_action, Effect{result:@next, operation:$player_discard_missing_filter_loss}] */
clause_player_discard_loss ::= player_discard_action "," "then" player_discard_missing_filter_loss

/* The mandatory producer attempts one discard per player. No optional choice
   or unrelated action may supply the following discard-history condition. */
/* @sem Instruction::ForEachPlayer{players:$loop_player_population, binding:0, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:Bound(0), cost:Cost{parts:[Discard{count:Constant(1), filter:Any, random:false}]}, optional:false}}]}} */
player_discard_action ::= loop_player_population "discards" "a" "card"

loop_player_population ::= players_each | players_each_opponent

/* Both rewards observe the kept-on-top portion of this surveil, after any
   earlier effects and across the intervening draw. */
/* @sem @apply(PlayerSet::One(PlayerRef::AbilityController), $surveil_kept_rewards_sequence) */
clause_surveil_kept_rewards ::= surveil_kept_rewards_sequence

/* @sem Instruction::[Effect{result:@mark, operation:$surveil_base}, Effect{result:@next, operation:Draw{players:@subject, amount:SurveilKeptOnTop(@marked)}}, Effect{result:@next, operation:LoseLife{players:@subject, amount:$surveil_kept_life_amount}}] */
surveil_kept_rewards_sequence ::= surveil_base "." "then" "for" "each" "card" "you" "put" "on" "top" "of" "your" "library" "," "you" "draw" "a" "card" "and" "you" "lose" surveil_kept_life_amount "life"

/* @sem Expr::Multiply([$number, SurveilKeptOnTop(@marked)]) */
surveil_kept_life_amount ::= number

/* One written put verb coordinates these placement contributions as a single
   simultaneous event. Separate put verbs and sequencers remain instructions;
   no operation-level canonical merge or recipient deduplication is used. */
/* @sem Operation::PutCounters{placements:[$counter_direct_placement, $counter_direct_placement_2]} */
put_counters_two_direct ::= "put" counter_direct_placement "and" counter_direct_placement
counter_direct_placement ::= counter_direct_one | counter_direct_multiple
/* @sem CounterPlacement::CounterPlacement{recipients:Objects($affected), kind:$counter_kind, amount:Constant(1)} */
counter_direct_one ::= ("a" | "one" | "1") counter_kind "counter" "on" affected
/* @sem CounterPlacement::CounterPlacement{recipients:Objects($affected), kind:$counter_kind, amount:Expr::@plural_amount($counter_amount)} */
counter_direct_multiple ::= counter_amount counter_kind "counters" "on" affected

/* Fellowship choices happen after every secret vote is revealed. The selection
   receipt is collected from the voters, then control and the grant use it. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:Words([Fellowship, Aid]), secret:true}}]}}, Effect{result:@next, operation:RevealChoices{kind:Word}}, ForEachPlayer{players:Matching{binding:0, condition:VotedFor{player:Bound(0), option:Word(Fellowship)}}, binding:0, body:Program{instructions:[Effect{result:@mark, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(Bound(0)))])}, count:AsManyAsCan(Constant(1))}}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Selected(@marked)), changes:[SetController(AbilityController)], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Affected(@prior)), changes:[GrantAbility(@holder($static_cant_attack_owner))], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:@times($counter_amount, Expr::Votes(Word(Aid)))}]}}] */
clause_fellowship_transfer ::= "each" "player" "secretly" "votes" "for" "fellowship" "or" "aid" "," "then" "those" "votes" "are" "revealed" "." "for" "each" "fellowship" "vote" "," "the" "voter" "chooses" "a" "creature" "they" "control" "." "you" "gain" "control" "of" "each" "creature" "chosen" "this" "way" "," "and" "they" "gain" '"' static_cant_attack_owner '"' "then" "for" "each" "aid" "vote" "," "put" counter_amount counter_kind ("counter" | "counters") "on" affected

/* Future timing permission remains separate from the next-cast trigger. */
/* @sem Operation::EffectOn{subject:Players(One(AbilityController)), effects:[Term{family:FuturePlayerEffect, form:MayCastTheirNextSpellThisTurnAsThoughItHadFlash, operands:[Filter(Any)]}]} */
next_spell_cast_as_flash ::= "the" "next" "spell" "you" "cast" "this" "turn" "can" "be" "cast" "as" "though" "it" "had" "flash"

/* Object ballots preserve optionality and are all revealed before a later
   outcome is tested. A vote is a choice, not a target announcement. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:UpToOne(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}), secret:true}}]}}, Effect{result:@next, operation:RevealChoices{kind:Object}}] */
secret_optional_object_vote_reveal ::= players_singular "secretly" "votes" "for" "up" "to" "one" filter_phrase "," "then" "those" "votes" "are" "revealed"


/* The future trigger owns its optional target announcement and the mana value
   of its eventual spell. It is separate from any earlier timing permission. */
/* @sem Instruction::[Effect{result:@next, operation:@scope(Operation::CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:Any}, duration:EndOfTurn, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($target_up_to_one)), kind:$counter_kind, amount:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}]}}]}, once:true})}] */
clause_next_cast_mana_counters ::= "when" "you" "next" "cast" "a" "spell" "this" "turn" "," "put" "X" counter_kind "counters" "on" target_up_to_one "," "where" "X" "is" "the" "mana" "value" "of" "that" "spell"

/* "When you next cast an instant or sorcery spell this turn, copy that spell": a
   one-shot trigger whose copy is of the spell that triggered it. */
clause_next_cast_copy ::= clause_next_cast_copy_original | clause_cast_your_next_copy

next_cast_copy ::= next_cast_copy_once | next_cast_copy_x
/* @sem Expr::Constant(1) */
next_cast_copy_once ::= "copy" next_cast_copied "." "you" "may" "choose" "new" "targets" "for" "the" "copy"
/* @sem Expr::AnnouncedX */
next_cast_copy_x ::= "copy" next_cast_copied "X" "times" "." "you" "may" "choose" "new" "targets" "for" "the" "copies"
/* @sem () */
next_cast_copied ::= "that" "spell" | "it"

/* The creature ballot establishes both the no-votes condition and the
   most-voted population. Reveal all ballots before testing the outcome. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:UpToOne(Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}), secret:true}}]}}, Effect{result:@next, operation:RevealChoices{kind:Object}}, If{condition:Outcome(NoVotes), then:Program{instructions:[Effect{result:@next, operation:Draw{players:All, amount:$card_count}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:State(MostVotes)}, regeneration:true}}]}}] */
clause_creature_vote_outcome ::= players_singular "secretly" "votes" "for" "up" "to" "one" "creature" "," "then" "those" "votes" "are" "revealed" "." "if" "no" "creature" "got" "votes" "," "each" "player" "draws" card_count "." "otherwise" "," "destroy" "each" "creature" "with" "the" "most" "votes" "or" "tied" "for" "most" "votes"

/* A selected single card is an ordinary resolving action, not a cost. Keep
   selection separate from the discard/move so the following reflexive trigger
   binds to the action's performed receipt. */
optional_single_card_action ::= discard_one_card_action | return_one_permanent_action | reveal_one_card_action
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}] */
discard_one_card_action ::= "discard" ("a" | "an") card_filter "card"
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
return_one_permanent_action ::= "return" ("a" | "an") filter_phrase "you" "control" "to" "its" "owner's" "hand"
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}] */
reveal_one_card_action ::= "reveal" ("a" | "an") card_filter "card" "from" "your" "hand"
/* "Reveal any number of red cards in your hand." The cards chosen are the cards
   revealed, and a later "card revealed this way" counts that choice. */
/* @sem Instruction::[Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AnyNumber}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}] */
clause_reveal_any_number_hand ::= "reveal" "any" "number" "of" card_filter "cards" ("in" | "from") "your" "hand"
/* @sem Instruction::[Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:@and($card_filter, $modifiers)}, count:AnyNumber}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}] */
clause_reveal_any_number_hand_with ::= "reveal" "any" "number" "of" card_filter "cards" modifiers ("in" | "from") "your" "hand"
/* "Return an enchantment card from your graveyard to your hand for each card revealed
   this way": as many cards as that count, or as many as there are. This production's
   own results are issued before its count, so a count naming the instruction before
   it (`@prior`) would name this choice; such counts refuse here. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AsManyAsCan($count_each)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_return_graveyard_kind_for_each ::= "return" ("a" | "an") card_filter "card" "from" "your" "graveyard" "to" "your" "hand" "for" "each" count_each

/* Snapshot the announced targets before placing counters. A replacement that
   prevents placement must not remove a target from the following ability grant. */
/* @sem Instruction::[Effect{result:@mark, operation:NoteObjects{objects:$opponent_counter_grant_targets}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Selected(@marked)), kind:$counter_kind, amount:$counter_amount}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Selected(@marked)), changes:[GrantAbility(@scope(Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$program}))], duration:WhileMatches{object:Affected, filter:Counters{kind:$counter_kind_2, comparison:Greater, value:Constant(0)}}, evaluation:Snapshot}}] */
clause_target_counter_lasting_grant ::= "for" "each" "opponent" "," "put" counter_amount counter_kind "counter" "on" opponent_counter_grant_targets "." "each" "of" "those" "creatures" "has" '"' "at" turn_event "," program '"' "for" "as" "long" "as" "it" "has" "an" counter_kind "counter" "on" "it"
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:OpponentsOf(AbilityController), each:UpTo($number)}, filter:AllOf([CardType(Creature), Counters{kind:$counter_kind, comparison:Equal, value:Constant(0)}])})) */
opponent_counter_grant_targets ::= "up" "to" number "target" "creature" "that" "player" "controls" "without" "an" counter_kind "counter" "on" "it"

/* The offered mana is a payment; destruction is an ordinary fallback action.
   A failed destruction does not satisfy the following success condition. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@mark, operation:Destroy{objects:One(@self), regeneration:true}}, If{condition:Compare{left:CountObjects(Transition{result:@marked, phase:After}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$it_ref, recipients:$recipients, amount:$number, preventable:true}}]}, otherwise:Program{}}]}, otherwise:Program{}}] */
clause_destroy_unless_paid_success ::= "destroy" "this" "creature" "unless" "you" "pay" cost "." "if" "this" "creature" "is" "destroyed" "this" "way" "," it_ref "deals" number "damage" "to" recipients

/* First complete the ordinary return. Only its actual hand receipt offers the
   mana payment; only that chosen payment runs the following return program. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One($current_card_ref), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:InZone(Players{zone:Hand, players:All})}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$cost, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:$may_body}, otherwise:Program{}}]}, otherwise:Program{}}] */
clause_return_success_payment ::= "return" current_card_ref "to" "its" "owner's" "hand" "." "if" "that" "card" "is" "returned" "to" "its" "owner's" "hand" "this" "way" "," "you" "may" "pay" cost "." "if" "you" "do" "," may_body

/* An up-to-one target is an ordinary action. Both rewards read that card's
   current/last-known value, and their guard reads the performed exile result. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One($exile_reward_target), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:CardType(Creature)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:ObjectProperty{object:$exile_reward_target, property:ManaValue, information:CurrentOrLastKnown}}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:ObjectProperty{object:$exile_reward_target, property:ManaValue, information:CurrentOrLastKnown}, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{}}] */
clause_exile_card_value_rewards ::= "exile" exile_reward_target "." "if" "you" "do" "," "you" "lose" "X" "life" "and" "create" "X" token_named_recipe "tokens" "," "where" "X" "is" "that" "card's" "mana" "value"
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:AllOf([CardType(Creature), InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0} */
exile_reward_target ::= "up" "to" "one" "target" "creature" "card" "from" "your" "graveyard"

/* Here X is the quantity actually sacrificed, not an announcement made before
   resolution. The reflexive callback announces its targets using that receipt. */
/* @prefer always */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@choice_mark, operation:Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:AnyNumber}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(CountObjects(Transition{result:@reflexive_performed, phase:Before})), filter:$filter_plural_2}))), changes:$sacrifice_pump_changes, duration:$duration, evaluation:Snapshot}}]}})}]}}] */
instructions_sacrifice_x_targets ::= "you" "may" "sacrifice" "X" filter_plural "." "when" "you" "do" "," "up" "to" "X" "target" filter_plural "each" sacrifice_pump_changes duration

/* Only this callback's X reads its immediate sacrifice receipt. Keyword grants
   here have no independent X costs or nested ability scope. */
/* @sem Change::[Pump{power:$sacrifice_stat, toughness:$sacrifice_stat_2}, ...$sacrifice_grants] */
sacrifice_pump_changes ::= ("get" | "gets") sacrifice_stat "/" sacrifice_stat "and" "gain" sacrifice_grants
sacrifice_stat ::= sacrifice_stat_plus | sacrifice_stat_minus | sacrifice_stat_x | sacrifice_stat_negative_x
/* @sem $number_digits */
sacrifice_stat_plus ::= "+" number_digits
/* @sem Expr::@negate($number_digits) */
sacrifice_stat_minus ::= "-" number_digits
/* @sem Expr::CountObjects(Transition{result:@reflexive_performed, phase:Before}) */
sacrifice_stat_x ::= "+" "X"
/* @sem Expr::@negate(Expr::CountObjects(Transition{result:@reflexive_performed, phase:Before})) */
sacrifice_stat_negative_x ::= "-" "X"
sacrifice_grants ::= sacrifice_grant_one | sacrifice_grant_more
/* @sem Change::[GrantKeyword($keyword_name)] */
sacrifice_grant_one ::= keyword_name
/* @sem Change::[GrantKeyword($keyword_name), ...$sacrifice_grants] */
sacrifice_grant_more ::= keyword_name ("and" | "," "and"?) sacrifice_grants

/* The copy and future return share this chosen exile. The return keeps every
   card produced by the payment, still in exile, rather than a linked-card query. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$single_exile_payment, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[...$clause_copy_for_duration, ...$paid_exile_delayed_return]}, otherwise:Program{}}] */
instructions_paid_exile_copy_return ::= "you" "may" single_exile_payment "." "if" "you" "do" "," clause_copy_for_duration "." paid_exile_delayed_return
/* @sem Cost::Cost{parts:[Move{selections:[_{objects:One($target_object)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}}]} */
single_exile_payment ::= "exile" target_object
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, zone:Exile}, destination:$battlefield_control, qualifiers:[]}}]}}}] */
paid_exile_delayed_return ::= "return" "the" "exiled" "card" "to" "the" "battlefield" battlefield_control "at" "the" "beginning" "of" "the" "next" "end" "step"

/* PerPlayer partitions this one target announcement by each opponent's
   controlled objects; it does not select targets while a player loop resolves.
   "That player" is the opponent each part belongs to, so these targets follow
   "for each opponent" only. */
each_opponent_targets ::= each_opponent_up_to_one | each_opponent_distinct_target
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:$each_opponent_targets, regeneration:true}}] */
clause_destroy_each_opponent_target ::= "for" "each" "opponent" "," "destroy" each_opponent_targets
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$each_opponent_targets, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_exile_each_opponent_target ::= "for" "each" "opponent" "," "exile" each_opponent_targets
/* What the exile holds, it holds only while its source stays. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$each_opponent_targets, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReturnAfter{objects:Transition{result:@prior, phase:After}, duration:WhileOnBattlefield($self_ref)}}] */
clause_exile_each_opponent_target_until ::= "for" "each" "opponent" "," "exile" each_opponent_targets "until" self_ref "leaves" "the" "battlefield"
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($each_opponent_targets), changes:[SetController(AbilityController)], duration:$duration, evaluation:Snapshot}}] */
clause_gain_control_each_opponent_target ::= "for" "each" "opponent" "," "gain" "control" "of" each_opponent_targets duration
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($each_opponent_targets), changes:[SetController(AbilityController)], duration:Indefinite, evaluation:Snapshot}}] */
clause_gain_control_each_opponent_target_indefinite ::= "for" "each" "opponent" "," "gain" "control" "of" each_opponent_targets

/* A single named player owns the choice, hand and battlefield entry. A loop
   is unnecessary for this reading; plural-player forms keep their own scopes. */
/* @sem Instruction::[Optional{decider:$that_player, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:$that_player, objects:Zone{scope:Players{zone:Hand, players:One($that_player)}, kind:Card, filter:$a_card}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player($that_player), arrival:BattlefieldArrival{}}, qualifiers:[]}}]}}] */
clause_named_player_hand_entry ::= that_player "may" "put" a_card "from" "their" "hand" "onto" "the" "battlefield"

/* Detach the named attachment itself, retaining its controller as actor. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Unattach{object:$object_ref}} */
unattach_action ::= "unattach" object_ref

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$have_continuous_snapshot}] */
clause_have_continuous ::= "have" have_continuous_snapshot

/* The target player is the payer and the owner of the offered graveyard card. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$declining_payer, cost:Cost::Cost{parts:[Move{selections:[_{objects:Zone{scope:Players{zone:Graveyard, players:One($declining_payer)}, kind:Card, filter:Any}, choose:Exactly(Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}}]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_target_graveyard_decline ::= declining_payer "may" "exile" "a" "card" "from" "their" "graveyard" "." "if" ("they" "don't" | "that" "player" "doesn't" | "that" "opponent" "doesn't") "," conjoined

declining_payer ::= target_opponent | target_player

/* @sem Cost::Cost{parts:[Move{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))}, choose:Exactly(Constant(1))}], destination:OwnersHand(CardArrival{})}]} */
payment_return_controlled_permanent ::= "return" ("a" | "an") filter_phrase "you" "control" "to" "its" "owner's" "hand"

/* The explicitly tapped host is also the following kind test's subject.
   This does not enable a bare scalar pronoun in unrelated/static contexts. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:One($attached_ref), tapped:true}}, If{condition:ObjectMatches{object:$attached_ref, filter:$filter_phrase}, then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_tap_attached_kind ::= "tap" attached_ref "." "if" "it's" ("a" | "an") filter_phrase "," conjoined

/* Removing a number of counters of a kind. */
/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:Count(Exactly($counter_amount))}]} */
remove_counters_from_affected ::= "remove" counter_amount counter_kind "counter" "from" affected

/* A removal and a test of the same permanent name it once and then as "it",
   whichever object that name means (a granting Aura inside a granted ability). */
/* @sem Instruction::[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($self_ref)), kind:$counter_kind, amount:Count(Exactly($counter_amount))}]}}, If{condition:ObjectMatches{object:$self_ref, filter:Counters(_{kind:$counter_kind_2, comparison:Equal, value:Constant(0)})}, then:$program, otherwise:_{}}] */
instructions_remove_then_if_none ::= "remove" counter_amount counter_kind "counter" "from" self_ref "." "then" "if" "it" "has" "no" counter_kind "counters" "on" "it" "," program

/* Removing every counter of a kind. */
/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:All}]} */
remove_all_counters_from_affected ::= "remove" "all" counter_kind "counters" "from" affected

/* Putting the event's amount of counters. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:EventAmount}]} */
put_that_many_counters ::= "put" "that" "many" counter_kind "counters" "on" affected

/* Doubling the counters of a kind. */
/* @sem Operation::DoubleCounters(_{objects:$affected, kind:$counter_kind}) */
double_counters ::= "double" "the" "number" "of" counter_kind "counters" "on" affected

/* One counter for each counted object. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:$count_each}]} */
put_counter_for_each ::= "put" "a" counter_kind "counter" "on" affected "for" "each" count_each

/* A recipient getting counters. */
/* @sem Operation::PutCounters{placements:[_{recipients:$recipients, kind:$counter_kind, amount:$counter_amount}]} */
recipients_gets_counter ::= recipients "gets" counter_amount counter_kind "counter"

/* Recipients getting counters. */
/* @sem Operation::PutCounters{placements:[_{recipients:$recipients, kind:$counter_kind, amount:$counter_amount}]} */
recipients_get_counter ::= recipients "get" counter_amount counter_kind "counter"

/* A recipient getting an amount of counters. */
/* @sem Operation::PutCounters{placements:[_{recipients:$recipients, kind:$counter_kind, amount:$value}]} */
recipients_gets_counters ::= recipients "gets" value counter_kind "counters"

/* Support puts a +1/+1 counter on each of up to a number of other target creatures. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo($number), filter:CardType(Creature)}))), kind:PowerToughness([1, 1]), amount:Constant(1)}]} */
support_action ::= "support" number

/* Choosing one color. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[Term{family:ChoosableColor, form:AnyColor}]}} */
choose_a_color ::= "choose" "a" "color"

/* Choosing a player, a type, a number or colors. */
choose_value ::= choose_many_colors | choose_card_types_five | choose_land_types_pair | choose_color_pair | choose_planeswalker_type | choose_two_basic_land_types | choose_friend_or_foe | choose_opponent | choose_a_player | choose_land_type | choose_basic_land_type | choose_number_between | choose_a_number | choose_two_colors | choose_color_other | choose_creature_type_plain | choose_ability_options_three | choose_color_type_options_five | choose_card_types_pair | choose_land_or_nonland | choose_ability_options | choose_number_threshold | choose_land_class | choose_direction
/* @sem Operation::ChooseValue{choosers:$players_singular, kind:Word, terms:_{count:Exactly(Constant(1)), options:[Text(Friend), Text(Foe)]}} */
choose_friend_or_foe ::= "for" players_singular "," "choose" "friend" "or" "foe"
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Player, terms:_{count:Exactly(Constant(1)), options:[Players(All)]}} */
choose_a_player ::= "choose" "a" "player"
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:LandType, terms:_{count:Exactly(Constant(1)), options:[]}} */
choose_land_type ::= "choose" "a" "land" "type"
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:BasicLandType, terms:_{count:Exactly(Constant(1)), options:[]}} */
choose_basic_land_type ::= "choose" "a" "basic" "land" "type"
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Number, terms:_{options:[Comparison(Greater, Constant(0))], count:Exactly(Constant(1))}} */
choose_a_number ::= "choose" "a" "number"
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Number, terms:_{count:Exactly(Constant(1)), options:[Integer($number), Integer($number_2)]}} */
choose_number_between ::= "choose" "a" "number" "between" NUMBER "and" NUMBER
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(2)), options:[]}} */
choose_two_colors ::= "choose" "two" "colors"
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[$entering_color_other]}} */
choose_color_other ::= "choose" "a" "color" entering_color_other

/* Naming an Oracle card, perhaps of a kind. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:CardName, terms:_{count:Exactly(Constant(1)), options:[$card_name_option]}} */
choose_a_card_name ::= "choose" card_name_option

/* Choosing cards in your hand. */
/* @sem Operation::@selected_result(Operation::ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), count:AsManyAsCan($counter_amount)}) */
choose_cards_in_hand ::= "choose" counter_amount filter_phrase "card" "in" "your" "hand"

/* Flipping a coin. */
/* @sem Operation::FlipCoin{player:AbilityController, protocol:@coin_protocol}*/
flip_a_coin ::= "flip" "a" "coin"

/* Mana for each object in a group. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:CountObjects($affected), production:$mana_for_each_existing, choice:Once}} */
add_mana_for_affected ::= "add" mana_for_each_existing "for" affected

/* Mana for each counted thing. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:$count_each, production:$mana_for_each_existing, choice:Once}} */
add_mana_for_each ::= "add" ("an" "additional")? mana_for_each_existing "for" "each" count_each

/* This quantity is an actual payment receipt, never the number requested or
   the counters remaining on the object. Binding proves its current component. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:@activation_removed_counters($counter_kind), production:$mana_for_each_existing, choice:Once}} */
add_mana_for_removed_counters ::= "add" ("an" "additional")? mana_for_each_existing "for" "each" counter_kind "counter" "removed" "this" "way"

/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:@activation_removed_counters($counter_kind), production:$mana_each_alternatives, choice:EachUnit}} */
add_alternative_mana_for_removed_counters ::= "add" ("an" "additional")? mana_each_alternatives "for" "each" counter_kind "counter" "removed" "this" "way"

/* Mana of the chosen color. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Amount{color:Chosen, amount:$value}} */
add_mana_of_chosen_color ::= "add" value "mana" "of" "the" "chosen" "color"

/* Mana in any combination of colors. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:$number, production:ChooseOne([Amount{color:White, amount:Constant(1)}, Amount{color:Blue, amount:Constant(1)}, Amount{color:Black, amount:Constant(1)}, Amount{color:Red, amount:Constant(1)}, Amount{color:Green, amount:Constant(1)}]), choice:EachUnit}} */
add_mana_any_combination ::= "add" number "mana" "in" "any" "combination" "of" "colors"

/* An amount of mana equal to a value. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:$value, production:$mana_production, choice:Once}} */
add_mana_amount_equal ::= "add" "an" "amount" "of" mana_production "equal" "to" value

/* Tokens that enter tapped and attacking. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$token_group], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_tokens_tapped_attacking ::= "create" token_group "that's" "tapped" "and" "attacking"
/* @sem Operation::@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$token_group], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{player:$player_ref}]}}) */
create_tokens_attacking_player ::= "create" token_group "that's" "tapped" "and" "attacking" player_ref

/* Abandoning this scheme. */
/* @sem Operation::AbandonScheme{actor:One(AbilityController)} */
abandon_this_scheme ::= "abandon" "this" "scheme"

/* You gaining an amount of life. */
/* @sem Operation::GainLife{players:One(AbilityController), amount:$value} */
you_gain_life ::= "you" "gain" value "life"

/* Damage equal to the counters on an object. */
/* @sem Operation::DealDamage{source:$object_ref, recipients:$recipients, amount:CountCounters(_{recipients:Objects($affected), kind:$counter_kind, information:CurrentOrLastKnown}), preventable:true} */
deal_damage_equal_counters ::= affected "deals" "damage" "equal" "to" "the" "number" "of" counter_kind "counters" "on" object_ref "to" recipients

/* Two amounts of damage dealt in one event. */
/* @sem Operation::DealDamageParts{source:$object_ref, parts:[_{recipients:Objects($affected), amount:$value}, _{recipients:$recipients, amount:$value_2}], preventable:true} */
deal_damage_split_two ::= object_ref "deals" value "damage" "to" affected "and" value "damage" "to" recipients

/* Exiling a target player's graveyard. */
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0})}, kind:Card, filter:Any}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_target_players_graveyard ::= "exile" "target" "player's" "graveyard"
/* Exiling every card of a kind from one graveyard, or from all graveyards. */
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One($player_possessive)}, kind:Card, filter:$card_filter}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_all_graveyard_cards ::= "exile" "all" card_filter "cards" "from" player_possessive "graveyard"
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Hand, players:One($player_possessive)}, kind:Card, filter:Any}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_all_hand_cards ::= "exile" "all" "cards" "from" player_possessive "hand"
/* "Exile all cards from your hand face down": only the imperative's own hand; other
   players exile theirs with "exiles all cards from their hand face down". */
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_all_hand_face_down ::= "exile" "all" "cards" "from" "your" "hand" "face" "down"
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Library, players:One($player_possessive)}, kind:Card, filter:Any}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_all_library_cards ::= "exile" "all" "cards" "from" player_possessive "library"
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$card_filter}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_all_graveyards_cards ::= "exile" "all" card_filter "cards" "from" "all" "graveyards"

/* Exiling two groups together. */
/* @sem Operation::Move{objects:Union([$affected, $affected_2]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_two_groups ::= "exile" affected "and" affected

/* Exiling every graveyard. */
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:Any}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_all_graveyards ::= "exile" "all" "graveyards"

/* Exiled cards arrive with counters. */
/* @sem Operation::Move{objects:$affected, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[[$counter_kind, $value]], states:[]}}, qualifiers:[]} */
exile_with_counters ::= "exile" affected "with" value counter_kind "counters" "on" "it"

/* A dying object is exiled instead. */
/* @sem Operation::CreateReplacement{event:ZoneChange{objects:SameObject($object_ref), from:Battlefield, to:Graveyard}, limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}} */
exile_instead_of_dying ::= "if" object_ref "would" "die" this_duration "," "exile" "it" "instead"

/* @sem Operation::CreateReplacement{event:Enter{objects:$filter_phrase}, limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$entry_counter_amount})}}]}} */
entries_with_counters_this_turn ::= this_duration "," "each" filter_phrase "enters" "with" entry_counter_amount counter_kind ("counter" | "counters") "on" "it"

/* Objects damaged this way are exiled instead of dying. */
/* @sem Operation::CreateReplacement{event:ZoneChange{objects:AllOf([$filter_phrase, DamagedBy(@prior)]), from:Battlefield, to:Graveyard}, limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}} */
exile_damaged_instead_of_dying ::= "if" "a" filter_phrase "dealt" "damage" "this" "way" "would" "die" this_duration "," "exile" "it" "instead"

/* Preventing combat damage an object would deal. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Permanent, sources:SameObject($object_ref), recipients:Any, kind:Combat, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevent_combat_damage_would_deal ::= "prevent" "all" "combat" "damage" object_ref "would" "deal" this_duration

/* You gaining control indefinitely. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[SetController(AbilityController)], duration:Indefinite, evaluation:Snapshot} */
gain_control_of ::= "gain" "control" "of" affected

/* A player gaining control indefinitely. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[SetController($player_ref)], duration:Indefinite, evaluation:Snapshot} */
player_gains_control_of ::= player_ref "gains" "control" "of" affected

/* Control that lasts while you control the source. */
/* @sem Operation::CreateContinuousEffect{source:$object_ref, affected:Objects($affected), changes:[SetController(AbilityController)], duration:WhileControlled{player:AbilityController, object:$object_ref}, evaluation:Snapshot} */
gain_control_while_controlled ::= "gain" "control" "of" affected "for" "as" "long" "as" "you" "control" object_ref

/* Choosing permanents and returning them to their owners' hands. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan($counter_amount)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
return_chosen_to_owners_hand ::= "return" counter_amount filter_phrase "to" "its" "owner's" "hand"

/* Choosing up to a number of cards in your graveyard and returning them. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$search_filter_many}, count:UpTo($count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
return_up_to_graveyard_hand ::= "you"? "return" "up" "to" count search_filter_many "from" "your" "graveyard" "to" "your" "hand"

/* Protection from a color chosen as it resolves. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[Term{family:ChoosableColor, form:AnyColor}]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[GrantKeyword(Protection(Objects(_{kind:Any, filter:Chosen(Color)})))], duration:$duration, evaluation:Snapshot}}] */
protection_from_chosen_color ::= affected "gains" "protection" "from" "the" "color" "of" "your" "choice" duration

/* Clashing, with instructions if you win. */
/* @sem Instruction::[Effect{result:@next, operation:Clash{actor:One(AbilityController), opponents:OpponentsOf(AbilityController), won:[$program], lost:[_{}]}}] */
clash_if_you_win ::= "clash" "with" "an" "opponent" "." "if" "you" "win" "," program

/* A coin flip with won and lost instructions. */
/* @sem Instruction::[Effect{result:@next, operation:FlipCoin{player:AbilityController, protocol:@coin_protocol}}, If{condition:CoinFlip{result:0, outcome:Won}, then:$program, otherwise:$program_2}]*/
flip_coin_win_or_lose ::= "flip" "a" "coin" "." "if" "you" "win" "the" "flip" "," program "." "if" "you" "lose" "the" "flip" "," program

/* A coin flip with instructions for one outcome; the flip is what the condition reads. */
/* @sem Instruction::[Effect{result:@mark, operation:FlipCoin{player:AbilityController, protocol:@coin_protocol}}, If{condition:CoinFlip{result:@marked, outcome:$flip_outcome}, then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_flip_coin_if ::= "flip" "a" "coin" "." "if" "you" flip_outcome "the" "flip" "," conjoined

flip_outcome ::= flip_won | flip_lost
/* @sem CoinOutcome::Won */
flip_won ::= "win"
/* @sem CoinOutcome::Lost */
flip_lost ::= "lose"

/* The linked card is read in exile, then returns to its own owner. */
/* @sem Operation::Move{objects:@zone_members(ObjectSet::One($linked_exiled_card)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
move_linked_card_hand ::= "return" linked_exiled_card "to" owner_possessive "hand"

/* A bounded, untargeted population is chosen during resolution. The written
   count belongs to that choice, not to an announcement or an object reference. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, count:UpTo($value)}}, Effect{result:@next, operation:SetTapped{objects:Selected(@prior), tapped:false}}] */
instructions_untap_choice ::= "untap" "up" "to" value filter_plural

/* The controller can direct two creatures to fight. The written operands keep
   the same lexical identities as the third-person fight action. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:ObjectRef::@reflexive_moved_fight_object($object_ref), second:ObjectRef::@fight_prior_counterpart($object_ref_2)}} */
have_creatures_fight ::= "have" object_ref "fight" object_ref

/* Reveal an owned card from outside the game, with the filter supplied by the card phrase. */
/* @sem Operation::Wish{actor:One(AbilityController), filter:$wish_owned_card, reveal:true} */
wish_reveal_owned ::= "reveal" wish_owned_card "from" "outside" "the" "game" "and" "put" "it" "into" "your" "hand"

wish_owned_card ::= wish_owned_sorcery | wish_owned_instant | wish_owned_filtered_a | wish_owned_filtered_an | wish_owned_negative | wish_owned_multicolored | wish_owned_named_self
/* @sem $filter_phrase */
wish_owned_filtered_a ::= "a" filter_phrase "card" "you" "own"
/* @sem $filter_phrase */
wish_owned_filtered_an ::= "an" filter_phrase "card" "you" "own"
/* @sem $adjective_nontype */
wish_owned_negative ::= "a" adjective_nontype "card" "you" "own"
/* @sem $adjective_multicolored */
wish_owned_multicolored ::= "a" adjective_multicolored "card" "you" "own"
/* @sem ObjectFilter::Name(@card_name) */
wish_owned_named_self ::= "a" "card" "you" "own" "named" SELF_NAME
/* @sem $spell_sorcery */
wish_owned_sorcery ::= "a" spell_sorcery "card" "you" "own"
/* @sem $spell_instant */
wish_owned_instant ::= "an" spell_instant "card" "you" "own"

/* A perpetual operation combines the affected set with reusable changes. */
/* @sem Operation::CreatePerpetualEffect{objects:$perpetual_affected_subject, changes:$perpetual_changes} */
perpetual_affected_changes ::= perpetual_affected_subject "perpetually" perpetual_changes

perpetual_changes ::= static_changes | perpetual_gain_bare | perpetual_gains_bare | perpetual_gain_valued | perpetual_gains_valued | perpetual_type_stats_keyword

/* @sem Change::[GrantAbility($mechanic_bare)] */
perpetual_gain_bare ::= "gain" mechanic_bare

/* @sem Change::[GrantAbility($mechanic_bare)] */
perpetual_gains_bare ::= "gains" mechanic_bare

/* @sem Change::[GrantAbility($mechanic_valued_keyword)] */
perpetual_gain_valued ::= "gain" mechanic_valued_keyword

/* @sem Change::[GrantAbility($mechanic_valued_keyword)] */
perpetual_gains_valued ::= "gains" mechanic_valued_keyword

/* @sem Change::[CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetBasePowerToughness{power:$value, toughness:$value_2}, GrantKeyword($keyword_name)] */
perpetual_type_stats_keyword ::= "becomes" "a" becomes_types "with" "base" "power" "and" "toughness" value "/" value "and" "gains" keyword_name

/* The possessive refers to the object named by the preceding instruction. */
/* @sem Operation::CreatePerpetualEffect{objects:One(@it), changes:[SetPower($value)]} */
perpetual_prior_base_power ::= "its" "base" "power" "perpetually" "becomes" "equal" "to" value

/* A spell change keeps its subject separate from the characteristic or ability changed. */
/* @sem Operation::ChangeSpell{subject:One($object_ref), changes:$spell_changes} */
change_spell_shared ::= object_ref spell_changes

spell_changes ::= spell_gains_mechanic | spell_enters_extra_counters | spell_becomes_two_types | spell_becomes_retained_type

/* @sem Change::[GrantAbility($spell_granted_mechanic)] */
spell_gains_mechanic ::= "gains" spell_granted_mechanic

spell_granted_mechanic ::= mechanic_valued_keyword | bare_rebound

/* @sem Change::[EntersWithCounters(_{kind:$counter_kind, amount:$value})] */
spell_enters_extra_counters ::= "enters" "with" "X" "additional" counter_kind "counters" "on" "it" "," "where" "X" "is" value

/* @sem Change::[Colors{mode:Set, colors:[$token_color]}, CreatureTypes{mode:Add, types:Listed($becomes_type_one)}, CreatureTypes{mode:Add, types:Listed($becomes_type_one_2)}] */
spell_becomes_two_types ::= "becomes" "a" token_color becomes_type_one becomes_type_one

/* @sem Change::[Colors{mode:Add, colors:[$token_color]}, CreatureTypes{mode:Add, types:Listed($becomes_type_one)}, GrantKeyword($keyword_value), SetBasePowerToughness{power:$value, toughness:$value_2}] */
spell_becomes_retained_type ::= "becomes" "a" token_color becomes_type_one "in" "addition" "to" "its" "other" "colors" "and" "types" "," "has" keyword_value "," "and" "has" "base" "power" "and" "toughness" value "/" value

/* Casting from linked exile keeps the eligible set separate from the amount
   and payment, so those operands can be reused and printed independently. */
/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}) */
linked_exile_cards ::= "cards" "exiled" "with" object_ref

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}) */
linked_exile_spells ::= "spells" "from" "among" "cards" "exiled" "with" object_ref

linked_exile_any_selection ::= linked_exile_cards | linked_exile_spells

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:$linked_exile_any_selection, count:AnyNumber, cost:Free} */
cast_any_linked_exile ::= "cast" "any" "number" "of" linked_exile_any_selection "without" "paying" "their" "mana" "costs"

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}) */
linked_exile_singular ::= "exiled" "with" object_ref

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:$linked_exile_singular, count:Exactly($card_count), cost:Free} */
cast_linked_exile_card ::= "cast" card_count linked_exile_singular "without" "paying" "its" "mana" "cost"

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(One(AbilityController)), InSet(Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}))])}) */
owned_linked_exile_cards ::= "cards" "you" "own" "exiled" "with" object_ref

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(One(AbilityController)), Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})])}) */
owned_counter_exile_cards ::= "cards" "you" "own" "in" "exile" "with" counter_kind "counters" "on" "them"

/* @sem ObjectFilter::AnyOf([CardType(Instant), CardType(Sorcery)]) */
cast_instant_or_sorcery_filter ::= "instant" "or" "sorcery"

/* @sem ObjectSet::Matching{objects:$linked_exile_cards, filter:$cast_instant_or_sorcery_filter} */
linked_exile_instant_sorcery ::= cast_instant_or_sorcery_filter "spell" "from" "among" linked_exile_cards

/* @sem ObjectSet::Matching{objects:$owned_counter_exile_cards, filter:$filter_phrase} */
owned_counter_exile_spell ::= filter_phrase "spell" "from" "among" owned_counter_exile_cards

free_exile_spell_selection ::= linked_exile_instant_sorcery | owned_counter_exile_spell

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:$free_exile_spell_selection, count:Exactly($counter_amount), cost:Free} */
cast_free_exile_spell ::= "cast" counter_amount free_exile_spell_selection "without" "paying" "its" "mana" "cost"

/* @sem ObjectSet::Matching{objects:$owned_linked_exile_cards, filter:$filter_phrase} */
owned_linked_exile_spell ::= filter_phrase "spell" "from" "among" owned_linked_exile_cards

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:$owned_linked_exile_spell, count:Exactly($counter_amount), cost:Normal} */
cast_owned_linked_exile_spell ::= "cast" counter_amount owned_linked_exile_spell

/* Populations of cards available for a free cast retain their independent
   link, ownership, counter, and prior-result operands. */
/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}) */
free_cast_linked_population ::= "cards" "exiled" "with" object_ref

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})}) */
free_cast_counter_population ::= "cards" "in" "exile" "with" counter_kind "counters" "on" "them"

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(One(AbilityController)), Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})])}) */
free_cast_owned_counter_population ::= "cards" "you" "own" "in" "exile" "with" counter_kind "counters" "on" "them"

free_cast_population ::= free_cast_linked_population | free_cast_counter_population | free_cast_owned_counter_population

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:$free_cast_population, count:Exactly($counter_amount), cost:Free} */
cast_free_from_population ::= "cast" counter_amount "spell" "from" "among" free_cast_population "without" "paying" "its" "mana" "cost"

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:$free_cast_population, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:$number}}}, count:Exactly($counter_amount), cost:Free} */
cast_free_mana_value_from_population ::= "cast" counter_amount "spell" "with" "mana" "value" number "from" "among" free_cast_population "without" "paying" "its" "mana" "cost"

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([Not(SameObject(Result{result:@prior, phase:After, index:0})), InSet(Transition{result:1, phase:After})])}) */
free_cast_other_exiled_population ::= "the" "other" "cards" "exiled" "this" "way"

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:$free_cast_other_exiled_population, count:UpTo($value), cost:Free} */
cast_free_up_to_population ::= "cast" "up" "to" value "spells" "from" "among" free_cast_other_exiled_population "without" "paying" "their" "mana" "costs"

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([$adjective_nontype, InSet(Transition{result:@prior, phase:After})])}) */
free_cast_those_population ::= "those" adjective_nontype "cards"

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:$free_cast_those_population, count:AnyNumber, cost:Free} */
cast_free_any_population ::= "you" "may" "cast" "any" "number" "of" "spells" "from" "among" free_cast_those_population "without" "paying" "their" "mana" "costs"

/* Retargeting keeps the announced stack object and the new destination independent. */
retarget_operation ::= retarget_choose_new_unqualified | retarget_one_to | retarget_single_to | retarget_single | retarget_many | retarget_any | retarget_choose_new

/* @sem Operation::Retarget{actor:One(AbilityController), object:$retarget_stack_object, targets:To($affected)} */
retarget_one_to ::= "change" "a" "target" "of" retarget_stack_object "to" affected

/* @sem Operation::Retarget{actor:One(AbilityController), object:$retarget_single_stack_object, targets:To($affected)} */
retarget_single_to ::= "change" "the" "target" "of" retarget_single_stack_object "to" affected

/* @sem Operation::Retarget{actor:One(AbilityController), object:$retarget_single_stack_object, targets:Must} */
retarget_single ::= "change" "the" "target" "of" retarget_single_stack_object

/* @sem Operation::Retarget{actor:One(AbilityController), object:$retarget_many_stack_object, targets:Must} */
retarget_many ::= "change" "the" "targets" "of" retarget_many_stack_object

/* @sem Operation::Retarget{actor:One(AbilityController), object:$retarget_many_stack_object, targets:Must} */
retarget_any ::= "change" "any" "targets" "of" retarget_many_stack_object

/* Combat state is part of the token arrival and retains its blocking referent. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$token_group], entry:BattlefieldArrival{tapped:false, counters:[], states:[Attacking{}]}}) */
create_tokens_attacking_singular ::= "create" token_group "that's" "attacking"

/* @sem Operation::@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$token_group], entry:BattlefieldArrival{tapped:false, counters:[], states:[Attacking{}]}}) */
create_tokens_attacking_plural ::= "create" token_group "that" "are" "attacking"

/* @sem Operation::@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$token_group], entry:BattlefieldArrival{tapped:false, counters:[], states:[Blocking($object_ref)]}}) */
create_tokens_blocking_singular ::= "create" token_group "that's" "blocking" object_ref

/* Countering composes with stack-target phrases, preserving their object domains. */
/* @sem Operation::Counter{objects:$counter_stack_objects, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None} */
counter_stack_action ::= "counter" counter_stack_objects

/* The historical filter applies to the current graveyard population. */
/* @sem Operation::Move{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$card_history_qualifier}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_history_cards_hand ::= "return" "to" "your" "hand" "all" "cards" "in" "your" "graveyard" card_history_qualifier

/* @sem ObjectFilter::History{event:CycledOrDiscarded, window:ThisTurn} */
card_history_qualifier ::= "that" "you" "cycled" "or" "discarded" "this" "turn"

/* @sem Operation::Move{objects:$graveyard_cards_arrived_this_turn, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_arrived_graveyard_cards_hand ::= "return" "to" "your" "hand" graveyard_cards_arrived_this_turn

/* Distributive damage keeps the source population and the recipient independent. */
/* @sem Operation::DealDamageFromEach{sources:$damage_each_population, recipients:$damage_each_recipient, amount:ObjectProperty{object:Affected, property:$stat, information:CurrentOrLastKnown}} */
damage_each_property ::= damage_each_population "deals" "damage" "equal" "to" "its" stat "to" damage_each_recipient

/* @sem Operation::DealDamageFromEach{sources:$damage_each_population, recipients:Objects(One(Affected)), amount:ObjectProperty{object:Affected, property:$stat, information:CurrentOrLastKnown}} */
damage_each_self ::= damage_each_population "deals" "damage" "to" "itself" "equal" "to" "its" stat

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase} */
damage_each_population ::= "each" filter_phrase

/* @sem Recipients::Players(OpponentsOf(AbilityController)) */
damage_each_opponents ::= "each" "opponent"

/* @sem Recipients::Objects($affected) */
damage_each_objects ::= affected

damage_each_recipient ::= damage_each_opponents | damage_each_objects | recipients

/* A group of announced sources can deal to another target that excludes it. */
/* @sem Operation::DealDamageFromEach{sources:$damage_group_subject, recipients:$damage_group_recipient, amount:ObjectProperty{object:Affected, property:$stat, information:CurrentOrLastKnown}} */
damage_group_property ::= damage_group_subject "each" "deal" "damage" "equal" "to" "their" stat "to" damage_group_recipient

/* @sem Operation::DealDamageFromEach{sources:Targets(0), recipients:$damage_other_target, amount:ObjectProperty{object:Affected, property:$stat, information:CurrentOrLastKnown}} */
damage_they_property ::= "they" "each" "deal" "damage" "equal" "to" "their" stat "to" damage_other_target

/* @sem Recipients::Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(InSet(Targets(0))), $noun])}), index:0})) */
damage_other_target_single ::= "another" "target" noun

/* @sem Recipients::Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(InSet(Targets(0))), AnyOf([$noun, $noun_2, CardType(Battle)])])}), index:0})) */
damage_other_target_union ::= "another" "target" noun "," noun "," "or" "battle"

damage_other_target ::= damage_other_target_single | damage_other_target_union

/* Two independently announced groups retain their exclusion and target slots. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([InSet(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:AnyNumber, filter:$filter_plural}))), SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo($number), filter:AllOf([Not(InSet(Targets(0))), $filter_phrase])}), index:0})])} */
damage_group_two_targets ::= "any" "number" "of" "target" filter_plural "and" "up" "to" number "other" "target" filter_phrase

damage_group_subject ::= affected | damage_group_two_targets | damage_team_targets

/* @sem Operation::DealDamageFromEach{sources:$damage_group_two_targets, recipients:Objects($affected), amount:ObjectProperty{object:Affected, property:$stat, information:CurrentOrLastKnown}} */
damage_group_two_to_objects ::= damage_group_two_targets "each" "deal" "damage" "equal" "to" "their" stat "to" affected

/* Selection and movement share the current filter and selection result. */
/* @sem ObjectFilter::AnyOf([$filter_phrase, $filter_phrase_2]) */
graveyard_return_alternative ::= "a" filter_phrase "card" "or" "a" filter_phrase "card"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$graveyard_return_alternative}, count:Exactly(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
graveyard_return_single ::= "return" graveyard_return_alternative "from" "your" "graveyard" "to" "your" "hand"

/* One optional selection can be paired with another independent selection. */
/* @sem Instruction::Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, count:Exactly($value)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}} */
graveyard_optional_selection ::= "up" "to" value filter_phrase "card"

/* @sem Instruction::[$graveyard_optional_selection, $graveyard_optional_selection_2] */
graveyard_return_pair ::= "return" graveyard_optional_selection "and" graveyard_optional_selection "from" "your" "graveyard" "to" "your" "hand"

/* @sem PlayerRef::OneOf(OpponentsOf(AbilityController)) */
graveyard_return_opponent_choice ::= "of" "an" "opponent's" "choice"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$graveyard_return_opponent_choice, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$adjective_nontype}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
graveyard_return_opponent ::= "return" "a" adjective_nontype "card" graveyard_return_opponent_choice "from" "your" "graveyard" "to" "your" "hand"

/* @sem PlayerRef::Chosen */
graveyard_chosen_subject ::= "that" "player"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$graveyard_chosen_subject, objects:Zone{scope:Players{zone:Graveyard, players:One($graveyard_chosen_subject)}, kind:Card, filter:Any}, count:AsManyAsCan($card_count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
graveyard_return_chosen ::= graveyard_chosen_subject "returns" card_count "from" "their" "graveyard" "to" "their" "hand"

/* Shared graveyard selection keeps its property test independent of the move. */
/* @sem Operation::Move{objects:One($return_other_qualified_card), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_other_qualified_battlefield ::= "return" return_other_qualified_card "to" "the" "battlefield"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@current_named_object)), $return_other_card_head, $return_card_property, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0} */
return_other_qualified_card ::= "another" "target" return_other_card_head "card" return_card_property "from" "your" "graveyard"

return_other_card_head ::= noun | return_other_card_negated_head

/* @sem @and($subtype_negated, $noun) */
return_other_card_negated_head ::= subtype_negated noun

return_card_property ::= return_property_either_stat

/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:ObjectProperty{object:Source, property:Power, information:CurrentOrLastKnown}}} */
return_property_event_mana ::= "with" "mana" "value" "less" "than" "or" "equal" "to" "this" "creature's" "power"

/* @sem ObjectFilter::Property{property:Power, test:NumberTest::Compare{comparison:LessOrEqual, value:ObjectProperty{object:Source, property:Power, information:CurrentOrLastKnown}}} */
return_property_event_power ::= "with" "equal" "or" "lesser" "power"

/* @sem ObjectFilter::AnyOf([ObjectFilter::Property{property:Power, test:NumberTest::Compare{comparison:Equal, value:$number}}, ObjectFilter::Property{property:Toughness, test:NumberTest::Compare{comparison:Equal, value:$number}}]) */
return_property_either_stat ::= "with" "power" "or" "toughness" number

/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:@and($filter_phrase, $modifier_mana_value_numeric)}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_each_qualified_battlefield ::= "return" "each" filter_phrase "card" modifier_mana_value_numeric "from" "your" "graveyard" "to" "the" "battlefield"

/* Source power is valid here because this trigger is explicitly the source's death. */
/* @sem Ability::Triggered{event:$event_self_dies, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$return_event_qualified_battlefield}]}} */
triggered_source_death_qualified_return ::= "when" event_self_dies "," return_event_qualified_battlefield "."

/* @sem Operation::Move{objects:One($return_event_qualified_card), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_event_qualified_battlefield ::= "return" return_event_qualified_card "to" "the" "battlefield"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@current_named_object)), $return_other_card_head, $return_event_property, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0} */
return_event_qualified_card ::= "another" "target" return_other_card_head "card" return_event_property "from" "your" "graveyard"

return_event_property ::= return_property_event_mana | return_property_event_power

/* Conjure and its immediate singular result stay in the same instruction sequence. */
/* @sem Instruction::[Effect{result:@next, operation:$conjure_single_perpetual_source}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$conjured_perpetual_changes}}] */
instructions_conjure_perpetual ::= conjure_single_perpetual_source "." "it" "perpetually" conjured_perpetual_changes

/* @sem Operation::Conjure{actor:One(AbilityController), card:Named($referenced_card_name), count:Constant(1), destination:Library{position:AmongTop($card_count), arrival:CardArrival{counters:[], states:[]}}} */
conjure_named_random_top ::= "conjure" "a" "card" "named" referenced_card_name "into" "the" "top" card_count "of" "your" "library" "at" "random"

conjured_perpetual_changes ::= quoted_perpetual_grant | quoted_perpetual_cost | conjured_spend_any_type

/* Each object's controller performs the sacrifice. */
/* @sem Operation::Sacrifice{players:All, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}} */
sacrifice_each_by_controller ::= "each" filter_phrase "is" "sacrificed" "by" "its" "controller"

/* These controller actions share their imperative and explicit-subject forms. */
player_action_base ::= exchange_life_with_player | control_player_next_turn

/* @sem $player_action_base */
player_action_you ::= "you" player_action_base

/* @sem Operation::TowardPlayer{actor:One(AbilityController), action:ExchangeLife, player:$player_ref} */
exchange_life_with_player ::= "exchange" "life" "totals" "with" player_ref

/* @sem Operation::TowardPlayer{actor:One(AbilityController), action:ControlNextTurn, player:$player_ref} */
control_player_next_turn ::= "control" player_ref "during" "that" "player's" "next" "turn"

/* Choice lists retain each current vocabulary operand in its printed position. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:CardType, terms:_{count:Exactly(Constant(1)), options:[$choice_card_type, $choice_card_type_2, $choice_card_type_3, $choice_card_type_4, $choice_card_type_5]}} */
choose_card_types_five ::= "choose" choice_card_type "," choice_card_type "," choice_card_type "," choice_card_type "," "or" choice_card_type

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:LandType, terms:_{count:Exactly(Constant(1)), options:[$choice_land_type, $choice_land_type_2]}} */
choose_land_types_pair ::= "choose" choice_land_type "or" choice_land_type

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[Term{family:ChoosableColor, form:ColorList, operands:[$choice_color, $choice_color_2]}]}} */
choose_color_pair ::= "choose" choice_color "or" choice_color

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:PlaneswalkerType, terms:_{count:Exactly(Constant(1)), options:[]}} */
choose_planeswalker_type ::= "choose" "a" "planeswalker" "type"

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:BasicLandType, terms:_{count:Exactly(Constant(2)), options:[]}} */
choose_two_basic_land_types ::= "choose" "two" "basic" "land" "types"

choice_card_type ::= choice_card_type_artifact | choice_card_type_creature | choice_card_type_enchantment | choice_card_type_instant | choice_card_type_sorcery | choice_card_type_planeswalker | choice_card_type_land | choice_card_type_battle

/* @sem Operand::Vocabulary{family:CardType, form:Artifact} */
choice_card_type_artifact ::= "artifact"

/* @sem Operand::Vocabulary{family:CardType, form:Creature} */
choice_card_type_creature ::= "creature"

/* @sem Operand::Vocabulary{family:CardType, form:Enchantment} */
choice_card_type_enchantment ::= "enchantment"

/* @sem Operand::Vocabulary{family:CardType, form:Instant} */
choice_card_type_instant ::= "instant"

/* @sem Operand::Vocabulary{family:CardType, form:Sorcery} */
choice_card_type_sorcery ::= "sorcery"

/* @sem Operand::Vocabulary{family:CardType, form:Planeswalker} */
choice_card_type_planeswalker ::= "planeswalker"

/* @sem Operand::Vocabulary{family:CardType, form:Land} */
choice_card_type_land ::= "land"

/* @sem Operand::Vocabulary{family:CardType, form:Battle} */
choice_card_type_battle ::= "battle"

choice_land_type ::= choice_land_type_plains | choice_land_type_island | choice_land_type_swamp | choice_land_type_mountain | choice_land_type_forest

/* @sem Operand::Vocabulary{family:LandType, form:Plains} */
choice_land_type_plains ::= "Plains"

/* @sem Operand::Vocabulary{family:LandType, form:Island} */
choice_land_type_island ::= "Island"

/* @sem Operand::Vocabulary{family:LandType, form:Swamp} */
choice_land_type_swamp ::= "Swamp"

/* @sem Operand::Vocabulary{family:LandType, form:Mountain} */
choice_land_type_mountain ::= "Mountain"

/* @sem Operand::Vocabulary{family:LandType, form:Forest} */
choice_land_type_forest ::= "Forest"

choice_color ::= choice_color_white | choice_color_blue | choice_color_black | choice_color_red | choice_color_green

/* @sem Operand::Vocabulary{family:Color, form:White} */
choice_color_white ::= "white"

/* @sem Operand::Vocabulary{family:Color, form:Blue} */
choice_color_blue ::= "blue"

/* @sem Operand::Vocabulary{family:Color, form:Black} */
choice_color_black ::= "black"

/* @sem Operand::Vocabulary{family:Color, form:Red} */
choice_color_red ::= "red"

/* @sem Operand::Vocabulary{family:Color, form:Green} */
choice_color_green ::= "green"

/* The willing payer excludes the event's player; the quoted spell cost
   remains attached to the event subject, independently of the payer. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:FirstWilling($willing_payer_pool), cost:$willing_spell_cost, optional:true}}, If{condition:$willing_payment_condition, then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_willing_spell_payment ::= willing_payer_pool "may" willing_spell_cost "." willing_payment_condition "," conjoined

/* @sem PlayerSet::OthersThan(PlayerRef::EventSubject) */
willing_payer_pool ::= "any" "other" "player"

/* @sem Cost::Cost{parts:[ManaCostOf(EventSubject)]} */
willing_spell_cost ::= "pay" "that" "spell's" "mana" "cost"

/* The repeated counter kind and recipient refer to the same source placement. */
/* @sem Operation::PutCountersCapped{amount:$number, kind:PowerToughness([1, 0]), object:Source, at_most:$value} */
put_counters_capped_source_power ::= "put" "up" "to" number "+" "1" "/" "+" "0" "counters" "on" "this" "creature" "." "this" "ability" "can't" "cause" "the" "total" "number" "of" "+" "1" "/" "+" "0" "counters" "on" "this" "creature" "to" "be" "greater" "than" value

/* The same player supplies both the recipient and the live life quantity. */
/* @sem Operation::SetLifeTotal{players:One($life_total_possessive), amount:Multiply($life_total_factor, PlayerNumber{player:$life_total_possessive, number:Life})} */
double_player_life_total ::= life_total_factor life_total_possessive "life" "total"

life_total_factor ::= life_total_double | life_total_triple

/* @sem Expr::Constant(2) */
life_total_double ::= "double"

/* @sem Expr::Constant(3) */
life_total_triple ::= "triple"

life_total_possessive ::= target_possessive | life_total_event_controller | zone_your

/* @sem PlayerRef::ControllerOf(@damage_relative_object) */
life_total_event_controller ::= "its" "controller's"

/* Select from the damaged player's hand; the follow-up owns the selection and
   the cast permission, shared by the mandatory and optional observations. */
/* @sem Operation::PickFromHand{actor:One(AbilityController), player:EventSubject, filter:Any, count:UpTo($counter_a), then:CastFree} */
hand_cast_free_selection ::= "you" "may" "cast" counter_a "spell" "from" "among" "those" "cards" "without" "paying" "its" "mana" "cost"

/* @sem Instruction::[Effect{result:@next, operation:$hand_cast_free_selection}] */
instructions_hand_look_cast ::= "look" "at" "that" "player's" "hand" "." hand_cast_free_selection

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$hand_cast_free_selection}]}}] */
instructions_optional_hand_look_cast ::= "you" "may" "look" "at" "that" "player's" "hand" "." "if" "you" "do" "," hand_cast_free_selection

/* The same named player owns both the hand and the destination library. */
/* @sem Instruction::[Effect{result:@next, operation:PickFromHand{actor:One(AbilityController), player:$target_possessive, filter:Any, count:Exactly($hand_choice_library_count), then:TopOfLibrary}}] */
instructions_hand_choose_library ::= "look" "at" target_possessive "hand" "and" hand_choice_library_count

/* @sem $card_count_many */
hand_choice_library_count ::= "choose" card_count_many "from" "it" "." "put" "them" "on" "top" "of" "that" "player's" "library" "in" "any" "order"

/* The selection is drawn cards, not an unrestricted discard from hand.
   The subject is supplied by the enclosing imperative or player clause. */
/* @sem Operation::DrawThenDiscard{players:@subject, draw:$card_count, discard:$drawn_discard_selection} */
draw_selected_discard_base ::= "draw" card_count "," "then" "discard" drawn_discard_selection

/* @sem Operation::DrawThenDiscard{players:@subject, draw:$card_count, discard:$drawn_discard_selection} */
draw_selected_discard_third ::= "draws" card_count "," "then" "discards" drawn_discard_selection

/* @sem $value */
drawn_discard_selection ::= value "of" "them"

/* The singular source is the antecedent of the regeneration callback. */
/* @sem Operation::CreateRegenerationShields{objects:One($self_explicit_ref)} */
regenerate_self_action ::= "regenerate" self_explicit_ref

/* @sem Instruction::[Effect{result:@next, operation:WithReflexive{action:$regenerate_self_action, when:Regenerates, body:Program($program)}}] */
instructions_regenerate_self_callback ::= regenerate_self_action "." "when" "it" "regenerates" "this" "way" "," program

/* A stack spell retains its independently specified target filter. */
/* @sem Operation::@owner_return(Operation::Move{objects:One($target_stack_spell), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}) */
return_target_stack_spell_hand ::= "return" target_stack_spell "to" "its" "owner's" "hand"

/* A total mana-value constraint applies to the chosen group, not to each card. */
/* @sem Operand::Term{family:GroupFilter, form:TotalManaValueIs, operands:[Comparison([LessOrEqual, $value])]} */
cast_total_mana_cap ::= "with" "total" "mana" "value" value "or" "less"

/* @sem ObjectSet::Transition{result:@prior, phase:After} */
cast_prior_population ::= "them"

/* @sem Operation::PlayWith{actor:One(AbilityController), action:CastSpell, cards:$cast_prior_population, count:AnyNumber, terms:_{cost:Free}, group:$cast_total_mana_cap} */
cast_any_prior_capped ::= "you" "may" "cast" "any" "number" "of" "spells" cast_total_mana_cap "from" "among" cast_prior_population "without" "paying" "their" "mana" "costs"

/* A note is an ordinary instruction and composes with entry programs. */
/* @sem Operation::Note($note_information_kind) */
note_information ::= "note" note_information_kind

note_information_kind ::= note_life_total | note_prevalent_opponent_library

/* @sem NoteKind::LifeTotal */
note_life_total ::= "your" "life" "total"

/* @sem NoteKind::MostCommonCreatureType(OpponentsOf(AbilityController)) */
note_prevalent_opponent_library ::= "the" "most" "prevalent" "creature" "type" "in" "an" "opponent's" "library"

/* A temporary zone-change replacement composes its event, duration and redirect. */
/* @sem Operation::CreateReplacement{event:$temporary_graveyard_event, limit:UntilExpired, duration:$this_duration, body:$temporary_graveyard_redirect_body} */
temporary_graveyard_redirect ::= "if" temporary_graveyard_event this_duration "," temporary_graveyard_redirect_body "instead"

/* @sem EventSpec::ZoneChange{objects:AllOf([$temporary_graveyard_card, OwnedBy(One(AbilityController)), Not(Token)]), to:Graveyard} */
temporary_graveyard_event ::= temporary_graveyard_card "would" "be" "put" "into" "your" "graveyard" "from" "anywhere"

temporary_graveyard_card ::= temporary_graveyard_any_card | temporary_graveyard_creature_card

/* @sem ObjectFilter::Any */
temporary_graveyard_any_card ::= "a" "card"

/* @sem ObjectFilter::CardType(Creature) */
temporary_graveyard_creature_card ::= "a" "creature" "card"

temporary_graveyard_redirect_body ::= temporary_graveyard_exile_that_card | temporary_graveyard_exile_it

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]} */
temporary_graveyard_exile_that_card ::= "exile" "that" "card"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]} */
temporary_graveyard_exile_it ::= "exile" "it"

/* Choose from a card population and remove the triggering event amount. */
/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($owned_suspended_card_population), kind:$counter_kind, amount:Count(Exactly(EventAmount)), selection:_{player:AbilityController, count:Exactly(Constant(1))}}]} */
choose_suspended_remove_event_counters ::= "choose" "a" owned_suspended_card_population "and" "remove" "that" "many" counter_kind "counters" "from" "it"

/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($owned_suspended_card_population), kind:$counter_kind, amount:Count(Exactly($value))}]} */
remove_each_suspended_counters ::= "remove" value counter_kind "counters" "from" "each" owned_suspended_card_population

/* A free cast separates the spell filter from its eligible card population. */
/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([Not(State(FaceDown)), OwnedBy(OpponentsOf(AbilityController))])}) */
free_cast_face_up_opponents_exile ::= "face-up" "cards" "your" "opponents" "own" "from" "exile"

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:$free_cast_face_up_opponents_exile, count:UpTo($value), cost:Free} */
cast_up_to_free_exile_population ::= "you" "may" "cast" "up" "to" value "spells" "from" "among" free_cast_face_up_opponents_exile "without" "paying" "their" "mana" "costs"

/* The phrase is used only inside the adjacent top-library exile contract. */
/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:InSet(Transition{result:@marked, phase:After})}), filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value_2}}])}, count:UpTo($value), cost:Free} */
cast_up_to_exile_receipt_filtered ::= "you" "may" "cast" "up" "to" value card_filter "spells" "with" "mana" "value" value "or" "less" "from" "among" "them" "without" "paying" "their" "mana" "costs"

/* The producer, permission and remaining cards share one actual exile receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:$cast_up_to_exile_receipt_filtered}, Effect{result:@next, operation:Move{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:InSet(Transition{result:@marked, phase:After})}), destination:Library{position:BottomRandom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
instructions_exile_top_cast_remainder ::= exile_top_cards_of_your_library "." cast_up_to_exile_receipt_filtered "." "put" "the" "exiled" "cards" "not" "cast" "this" "way" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* A repeated payment consumes only the actual receipt of its typed producer. */
/* @sem Instruction::[Effect{result:@mark, operation:Draw{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:PayRepeatedly{player:AbilityController, cost:$cost, at_most:Performed(@marked)}}, Effect{result:@next, operation:Discard{players:One(AbilityController), amount:Subtract([Performed(@marked), Performed(@prior)]), random:false}}] */
clause_draw_repeated_payment ::= "draw" card_count "." "for" "each" "card" "drawn" "this" "way" "," "discard" "a" "card" "unless" "you" cost

/* The counter kind is fixed on both sides; the recipient and payment remain operands. */
/* @sem Instruction::[Effect{result:@mark, operation:$remove_all_delay_counters}, Effect{result:@next, operation:PayRepeatedly{player:AbilityController, cost:$cost, at_most:CountersRemoved(@marked)}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:Subtract([CountersRemoved(@marked), Performed(@prior)])}}] */
clause_delay_repeated_payment ::= remove_all_delay_counters "." "for" "each" "delay" "counter" "removed" "this" "way" "," "you" "lose" "1" "life" "unless" "you" "pay" cost

/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:Named(DelayCounter), amount:All}]} */
remove_all_delay_counters ::= "remove" "all" "delay" "counters" "from" affected

/* The immediate conjure result is the card receiving the perpetual change. */
/* @sem Instruction::[Effect{result:@next, operation:$conjure_duplicate_spell_hand}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$duplicate_card_perpetual_changes}}] */
instructions_duplicate_perpetual ::= conjure_duplicate_spell_hand "." "that" "card" "perpetually" duplicate_card_perpetual_changes

/* @sem Operation::Conjure{actor:One(AbilityController), card:Duplicate(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:Any}), index:0})), count:$counter_amount, destination:Hand(CardArrival{counters:[], states:[]})} */
conjure_duplicate_spell_hand ::= "conjure" counter_amount "duplicate" "of" "target" "spell" "into" "your" "hand"

/* @sem Change::[GrantAbility(Casting(SpendAsThoughAnyType))] */
duplicate_card_perpetual_changes ::= "gains" '"' "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "this" "spell" "." '"'

/* A selected hand-card set receives the quoted stack ability. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_hand_union}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Earlier{what:Selected}), changes:[$perpetual_cast_grant_once]}}] */
instructions_hand_union_perpetual ::= choose_hand_union "." "they" "perpetually" "gain" '"' perpetual_cast_grant_once '"'

/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AnyOf([$filter_phrase, $filter_phrase_2])}), count:UpTo($value)} */
choose_hand_union ::= "choose" "up" "to" value filter_phrase "and" "/" "or" filter_phrase "cards" "in" "your" "hand"

/* @sem Change::GrantAbility(Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:Spell{event:Cast, players:One(AbilityController), spells:SameObject($object_ref)}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:CreatePerpetualEffect{objects:$affected, changes:[LosesAbility(Term{family:CheckHasable, form:ThisAbility})]}}]}})}) */
perpetual_cast_grant_once ::= "when" "you" "cast" affected "," operation "and" object_ref "perpetually" "loses" "this" "ability" "."

/* Keep the optional payment and its successful selection in one scope. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:$optional_hand_card_choice}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:_{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$incorporated_black_grant}}]}, otherwise:_{}}] */
instructions_optional_hand_perpetual ::= "you" "may" optional_hand_card_choice "." "if" "you" "do" "," "that" "card" "perpetually" incorporated_black_grant

/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$adjective_nontype}), count:AsManyAsCan(Constant(1))} */
optional_hand_card_choice ::= "choose" "a" adjective_nontype "card" "in" "your" "hand"

/* @sem Change::[Incorporate([Generic(1), Color(Black)]), GrantAbility(Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:Spell{event:Cast, players:One(AbilityController), spells:SameObject($object_ref)}, limits:_{}, announcement:@announcement, body:$program})})] */
incorporated_black_grant ::= "incorporates" "{" "1" "}" "{" "B" "}" "and" "gains" '"' "when" "you" "cast" object_ref "," program "." '"'

/* Each opponent's failed sacrifice is determined from that opponent's own receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Sacrifice{players:OpponentsOf(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Discard{players:Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Not(Compare{left:CountObjects(Matching{objects:MovedBy{result:@prior, phase:Before, player:Bound(0)}, filter:Any}), test:Compare{comparison:Greater, value:Constant(0)}})}]), amount:Constant(1), random:false}}] */
instructions_opponents_sacrifice_cant_discard ::= "each" "opponent" "sacrifices" "a" filter_phrase "of" "their" "choice" "." "each" "opponent" "who" "can't" "discards" "a" "card"

/* A resolving payment can combine mana with a graveyard exile cost. */
/* @sem Cost::Cost{parts:[Mana($mana_symbols), $cost_exile_cards_graveyard]} */
payment_mana_and_graveyard_exile ::= "pay" mana_symbols "and" cost_exile_cards_graveyard

/* Keep the random selection, exile arrival and its permission in one scope. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}), count:AsManyAsCan($random_single_card), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}] */
random_graveyard_exile_play ::= "exile" random_single_card "from" "your" "graveyard" "at" "random" "." "you" "may" "play" "the" "exiled" "card" this_duration

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$random_an_card_filter}), count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:CastSpell, filter:Any}, terms:_{cost:Normal, into_exile:true}})], duration:$this_duration, evaluation:LiveObjects}}] */
random_graveyard_exile_cast ::= "exile" "an" random_an_card_filter "card" "at" "random" "from" "your" "graveyard" "." "you" "may" "cast" "it" this_duration "." "if" "a" "spell" "cast" "this" "way" "would" "be" "put" "into" "your" "graveyard" "," "exile" "it" "instead"

/* @sem Expr::Constant(1) */
random_single_card ::= ("a" | "one") "card"

random_an_card_filter ::= filter_instant_or_sorcery | spell_instant

/* The event subject's owner supplies both the graveyard and the controller. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Graveyard, players:One(OwnerOf(EventSubject))}, kind:Card, filter:$card_filter}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(OwnerOf(EventSubject)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]} */
death_owner_return_program ::= "return" "a" card_filter "card" "from" "its" "owner's" "graveyard" "to" "the" "battlefield" "under" "the" "control" "of" "that" "creature's" "owner"

/* The mode list supplies both the alternatives and the upper bound. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Conditional{condition:$graveyard_card_types_threshold, then:@length($modes), otherwise:Constant(1)}}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_graveyard_types_or_more ::= "choose" "one" "." "if" graveyard_card_types_threshold "," "choose" "one" "or" "more" "instead" "." NEWLINE modes

/* Delayed death triggers retain the prior target and their independent body. */
/* @sem Instruction::[Effect{result:@next, operation:@scope(Operation::CreateTrigger{event:$controlled_target_death_event, duration:EndOfTurn, body:Program{instructions:$instructions}, announcement:@announcement})}] */
temporary_controlled_target_death ::= "when" controlled_target_death_event "this" "turn" "," instructions

/* @sem Instruction::[Effect{result:@next, operation:@scope(Operation::CreateTrigger{event:$damaged_target_death_event, duration:EndOfTurn, body:Program{instructions:$instructions}, announcement:@announcement})}] */
temporary_damaged_target_death ::= "whenever" damaged_target_death_event "this" "turn" "," instructions

/* The named player performs the flip and the immediately following outcome
   refers to that same player and result. The branch remains compositional. */
/* @sem Instruction::[Effect{result:@mark, operation:FlipCoin{player:$that_player_word, protocol:@coin_protocol}}, If{condition:CoinFlip{result:@marked, outcome:$that_player_flip_outcome}, then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_that_player_flip_if ::= that_player_word "flips" "a" "coin" "." "if" that_player_flip_outcome "the" "flip" "," conjoined

that_player_flip_outcome ::= flip_player_wins | flip_player_loses | flip_they_win | flip_they_lose

/* @sem CoinOutcome::Won */
flip_player_wins ::= "the" "player" "wins"

/* @sem CoinOutcome::Lost */
flip_player_loses ::= "the" "player" "loses"

/* @sem CoinOutcome::Won */
flip_they_win ::= "they" "win"

/* @sem CoinOutcome::Lost */
flip_they_lose ::= "they" "lose"

/* Simultaneous operations keep both independent operands in one effect. The
   surface order is untap/tap while Together stores its members in reverse order. */
/* @sem Operation::Together([$action_2, $action]) */
simultaneous_imperative_pair ::= action "and" action

/* @sem Operation::$simultaneous_imperative_pair */
simultaneous_imperative ::= "simultaneously" simultaneous_imperative_pair

/* The third-person forms are separate from the imperative forms. */
simultaneous_third_action ::= simultaneous_third_tap | simultaneous_third_untap

/* @sem Operation::SetTapped{objects:$affected, tapped:true} */
simultaneous_third_tap ::= "taps" affected

/* @sem Operation::SetTapped{objects:$affected} */
simultaneous_third_untap ::= "untaps" affected

/* @sem Operation::Together([$simultaneous_third_action_2, $simultaneous_third_action]) */
simultaneous_third_pair ::= simultaneous_third_action "and" simultaneous_third_action

/* @sem Operation::$simultaneous_third_pair */
simultaneous_event_player ::= "that" "player" "simultaneously" simultaneous_third_pair

/* The named player chooses the survivors from the specified population. */
/* @sem Operation::SacrificeAllBut{players:@subject, objects:$affected, keep:$value} */
sacrifice_choose_keep_third ::= "chooses" "up" "to" value affected "they" "control" "," "then" "sacrifices" "the" "rest"

/* @sem Operation::SacrificeAllBut{players:@subject, objects:$affected, keep:ChosenNumber} */
sacrifice_keep_chosen_third ::= "sacrifices" "all" "but" "that" "many" affected "of" "their" "choice"

/* @sem Operation::ChooseValue{choosers:@subject, kind:Number, terms:_{count:Exactly(Constant(1)), options:[]}} */
choose_number_third ::= "chooses" "a" "number"

/* @sem Operation::Scry{players:@subject, amount:$value} */
scry_where_value ::= "scry" "X" "," "where" "X" "is" value

/* A temporary mana grant and the source card's independent casting permission. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$noun}), index:0})), changes:[GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[TapSymbol]}, limits:_{}, body:_{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:$mana_production}}]}, announcement:@announcement}))], duration:UntilCast(Source), evaluation:Snapshot} */
target_mana_grant_until_source_cast ::= "target" noun "gains" '"' "{" "T" "}" ":" "add" mana_production '"' "until" "this" "card" "is" "cast" "from" "exile"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Source), from:Exile, action:CastSpell, filter:Any})], duration:Indefinite, evaluation:LiveObjects} */
cast_source_while_exiled ::= "you" "may" "cast" "this" "card" "for" "as" "long" "as" "it" "remains" "exiled"

/* Turning the linked population and referring to its recorded names are one
   producer-consumer unit: the anaphor cannot bind an unrelated result. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::TurnFaceUp, objects:Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([State(FaceDown), ExiledWith($object_ref)])})} */
turn_linked_cards_face_up ::= "turn" "all" "cards" "exiled" "with" object_ref "face" "up"

/* @sem Instruction::[Effect{result:@next, operation:$turn_linked_cards_face_up}, Effect{result:@next, operation:Counter{objects:Zone(_{scope:Shared(Stack), kind:Spell, filter:SharesNameWithAny(Zone(_{scope:Shared(Exile), kind:Card, filter:InSet(Recorded(@prior))}))}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}] */
instructions_turn_linked_counter_names ::= turn_linked_cards_face_up "." "counter" "all" "spells" "with" "those" "names"

/* The anaphoric removal shares the tested object and counter kind. */
/* @sem Instruction::[If{condition:ObjectMatches{object:$object_ref, filter:Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$value})}, then:Program{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($object_ref)), kind:$counter_kind, amount:All}]}}, Effect{result:@next, operation:$operation}]}, otherwise:Program{}}] */
clause_counter_threshold_remove_them ::= "if" object_ref "has" value "or" "more" counter_kind "counters" "on" "it" "," "remove" "them" "all" "and" operation

/* @sem Instruction::[If{condition:ObjectMatches{object:$object_ref, filter:Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$value})}, then:Program{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($object_ref)), kind:$counter_kind, amount:All}]}}, Effect{result:@next, operation:$operation}]}, otherwise:Program{}}] */
clause_counter_threshold_remove_those ::= "if" "there" "are" value "or" "more" counter_kind "counters" "on" object_ref "," "remove" "those" "counters" "and" operation

/* Conjured-card selection is independent of the destination and quantity. */
/* @sem Operation::Conjure{actor:One(AbilityController), card:$conjured_exile_card, count:$conjure_singular_amount, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
conjure_card_into_exile ::= "conjure" conjure_singular_amount conjured_exile_card "into" "exile"

/* @sem Expr::Constant(1) */
conjure_singular_amount ::= "a"

conjured_exile_card ::= conjured_duplicate | conjured_random_expansion_card

/* @sem ConjuredCard::Duplicate($affected) */
conjured_duplicate ::= "duplicate" "of" affected

/* @sem ConjuredCard::Random($conjured_expansion_filter) */
conjured_random_expansion_card ::= "random" conjured_expansion_filter "card" "from" "the" "Lorwyn" "Eclipsed" "expansion"

/* @sem Operand::Term{family:CardsInOracle, form:And, operands:[Term{family:CardsInOracle, form:Or, operands:[$conjured_oracle_type, $conjured_oracle_type_2]}, Term{family:CardsInOracle, form:FromTheLorwynEclipsedExpansion}]} */
conjured_expansion_filter ::= conjured_oracle_type "or" conjured_oracle_type

conjured_oracle_type ::= conjured_oracle_instant | conjured_oracle_sorcery | conjured_oracle_artifact | conjured_oracle_creature

/* @sem Operand::Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Instant}]} */
conjured_oracle_instant ::= "instant"

/* @sem Operand::Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Sorcery}]} */
conjured_oracle_sorcery ::= "sorcery"

/* @sem Operand::Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Artifact}]} */
conjured_oracle_artifact ::= "artifact"

/* @sem Operand::Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Creature}]} */
conjured_oracle_creature ::= "creature"

/* The prohibition refers to the actual objects affected by this phase-out. */
/* @sem Instruction::[Effect{result:@next, operation:KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::PhaseOut{}, objects:$objects_each}}, Effect{result:@next, operation:GameEffect{until:$duration, effect:Term{family:GameEffect, form:PermanentsCantPhaseIn, operands:[Objects(Affected(@prior))]}}}] */
phase_out_each_cant_return ::= objects_each "phases" "out" "." duration "," "they" "can't" "phase" "in"

/* The mentioned player's control remains an operand of the move. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$affected, destination:Battlefield{controller:Player(@that_player), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
return_under_that_player ::= "return" affected "to" "the" "battlefield" "under" "that" "player's" "control"

/* Play actions retain the linked population, quantity and payment independently. */
/* @sem ObjectSet::Matching{objects:$linked_exile_cards, filter:AnyOf([$filter_phrase, Any])} */
free_linked_land_or_spell ::= filter_phrase "or" "cast" "a" "spell" "from" "among" "the" linked_exile_cards

/* @sem Operation::PlayWith{actor:One(AbilityController), action:Either, cards:$free_linked_land_or_spell, count:Exactly($counter_amount), terms:_{cost:Free}} */
play_free_linked_land_or_spell ::= "play" counter_amount free_linked_land_or_spell "without" "paying" "its" "mana" "cost"

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)}), ExiledBy{player:OneOf(One(AbilityController))}])}) */
controlled_exile_counter_card ::= "from" "exile" "with" "a" counter_kind "counter" "on" "it" "if" "it" "was" "exiled" "by" "an" "ability" "you" "controlled"

/* @sem Operation::PlayWith{actor:One(AbilityController), action:Either, cards:$controlled_exile_counter_card, count:Exactly($card_count_one), terms:_{cost:Normal, spend_as:AnyColor}} */
play_controlled_exile_counter_card ::= "play" card_count_one controlled_exile_counter_card "," "and" "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "it"

once_turn_play_operation ::= play_free_linked_land_or_spell | play_controlled_exile_counter_card

/* An opponent's unchosen graveyard selection can be repeated after a payment. */
/* @sem Instruction::Repeatable{instructions:[$graveyard_repeat_choice, $graveyard_repeat_payment, $graveyard_repeat_again]} */
graveyard_repeat_process ::= graveyard_repeat_choice "." graveyard_repeat_payment "." graveyard_repeat_again

/* @sem Instruction::Effect{result:@next, operation:ChooseValue{choosers:$players_singular, kind:Object, terms:_{options:[Objects(Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}))], unchosen:true, count:Exactly(Constant(1))}}} */
graveyard_repeat_choice ::= players_singular "chooses" "a" "card" "in" "your" "graveyard"

/* @sem Instruction::Effect{result:@next, operation:PayCost{player:AbilityController, cost:$cost, optional:true}} */
graveyard_repeat_payment ::= "you" "may" "pay" cost

/* @sem Instruction::If{condition:PaymentChosen(@last_result), then:_{instructions:[Effect{result:@next, operation:RepeatProcess}]}, otherwise:_{}} */
graveyard_repeat_again ::= "if" "you" "do" "," "repeat" "this" "process" "except" "that" "opponent" "can't" "choose" "a" "card" "already" "chosen" "for" SELF_NAME

/* @sem Instruction::Effect{result:@next, operation:Move{objects:One(Earlier{what:Selected}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}} */
graveyard_last_choice_to_hand ::= "then" "put" "the" "last" "chosen" "card" "into" "your" "hand"

/* @sem Instruction::[$graveyard_repeat_process, $graveyard_last_choice_to_hand] */
instructions_graveyard_repeat ::= graveyard_repeat_process "." graveyard_last_choice_to_hand

/* Each chooser uses the same filtered graveyard, with turn order explicit. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, starting_with:Seat{of:AbilityController, side:Next}, body:_{instructions:[$ordered_graveyard_choice]}}] */
ordered_opponent_graveyard_choice ::= "then" "starting" "with" "the" "next" "opponent" "in" "turn" "order" "," players_singular ordered_graveyard_choice

/* @sem Instruction::Effect{result:@next, operation:ChooseValue{choosers:One(Bound(0)), kind:Object, terms:_{options:[Filter(AllOf([$filter_phrase, InZone(Players{zone:Graveyard, players:One(AbilityController)})]))], unchosen:true, count:Exactly(Constant(1))}}} */
ordered_graveyard_choice ::= "chooses" "a" filter_phrase "card" "in" "your" "graveyard" "that" "hasn't" "been" "chosen"

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:InSet(Earlier{what:Selected})}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
return_each_chosen_graveyard ::= "return" "each" "card" "chosen" "this" "way" "to" "the" "battlefield" "under" "your" "control"

/* A singular owned object can be selected from these two public zones. */
/* @sem ObjectSet::Union([Zone{scope:Shared(Battlefield), kind:Card, filter:AllOf([$noun, OwnedBy(One(AbilityController))])}, Zone{scope:Shared(Command), kind:Card, filter:AllOf([$noun, OwnedBy(One(AbilityController))])}]) */
owned_battlefield_command_object ::= noun "you" "own" "on" "the" "battlefield" "or" "in" "the" "command" "zone"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$owned_battlefield_command_object, count:Exactly($owned_choice_article)}}, Effect{result:@mark, operation:BindValue{value:ObjectProperty{object:Result{result:@prior, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:BoundValue(@marked)}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:BoundValue(@marked)}}] */
instructions_draw_loss_defined ::= "you" "draw" "X" "cards" "and" "you" "lose" "X" "life" "," "where" "X" "is" "the" "mana" "value" "of" owned_choice_article owned_battlefield_command_object

owned_choice_article ::= owned_choice_a | owned_choice_an

/* @sem Expr::Constant(1) */
owned_choice_a ::= "a"

/* @sem Expr::Constant(1) */
owned_choice_an ::= "an"

/* The reveal and its immediate consumer share the same target hand; no intervening action can change the population. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:CardType, terms:_{count:Exactly(Constant(1)), options:[]}}}, Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($callback_hand_player)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:@times($token_amount, Expr::CountObjects(Matching{objects:Zone{scope:Players{zone:Hand, players:One($callback_hand_player)}, kind:Card, filter:Any}, filter:Chosen(CardType)})), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
clause_choose_type_reveal_hand_tokens ::= "choose" "a" "card" "type" "." callback_hand_player "reveals" "their" "hand" "." "create" token_amount token_recipe "for" "each" "card" "of" "the" "chosen" "type" "revealed" "this" "way"

/* Bind the counted receipt to the immediately preceding draw, including its player and amount. */
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:$players_singular, amount:$card_count}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Performed(@prior)}}] */
instructions_draw_receipt_draw ::= players_singular "draws" card_count "." "you" "draw" "a" "card" "for" "each" "card" "drawn" "this" "way"

/* Two recipient sets take independently specified amounts in one damage event. */
/* @sem Operation::DealDamageParts{source:$object_ref, parts:[_{recipients:$recipients, amount:$value}, _{recipients:$recipients_2, amount:$value_2}], preventable:true} */
deal_damage_split_recipients ::= object_ref "deals" value "damage" "to" recipients "and" value "damage" "to" recipients

/* The second recipient takes half the defined amount, rounded up. */
/* @sem Recipients::$recipients */
half_x_damage_recipient ::= "half" "X" "damage" "," "rounded" "up" "," "to" recipients

/* @sem Operation::DealDamageParts{source:$object_ref, parts:[_{recipients:$recipients, amount:$value}, _{recipients:$half_x_damage_recipient, amount:Divide{numerator:$value, denominator:Constant(2), rounding:Up}}], preventable:true} */
deal_damage_split_half ::= object_ref "deals" "X" "damage" "to" recipients "and" half_x_damage_recipient "," "where" "X" "is" value

/* A singular player population performs one action per bound player. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_player_action}]}}] */
clause_each_bound_action ::= players_singular bound_player_action

bound_player_action ::= bound_coin_flip | bound_discard_excess

/* The repeat keeps both named participants in its stopping condition. */
/* @sem Instruction::[Repeatable{instructions:[ForEachPlayer{players:Union([One(AbilityController), $players_singular]), binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_coin_base}]}}, $coin_outcome_damage, If{condition:Not(AllOf([CoinCameUp{player:Some(@single_player($players_singular)), outcome:$coin_result_heads}, CoinCameUp{player:AbilityController, outcome:$coin_result_heads}])), then:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}]}] */
repeat_two_player_coin_process ::= "you" "and" players_singular "each" bound_coin_base "." coin_outcome_damage "." "repeat" "this" "process" "until" "both" "players'" "coins" "come" "up" coin_result_heads "on" "the" "same" "flip"

/* @sem Operation::FlipCoin{player:Bound(0), protocol:@coin_protocol} */
bound_coin_base ::= "flip" "a" "coin"

/* @sem Instruction::Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(Matching{binding:0, condition:CoinCameUp{player:Bound(0), outcome:$coin_result_tails}}), amount:$value, preventable:true}} */
coin_outcome_damage ::= object_ref "deals" value "damage" "to" "each" "player" "whose" "coin" "comes" "up" coin_result_tails

/* @sem CoinOutcome::Heads */
coin_result_heads ::= "heads"

/* @sem CoinOutcome::Tails */
coin_result_tails ::= "tails"

conjure_single_perpetual_source ::= conjure_named_random_top | conjure_source_spellbook_personal

/* @sem Change::[GrantAbility(Casting(SpendAsThoughAnyType))] */
conjured_spend_any_type ::= "gains" '"' "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "this" "spell" "." '"'

/* The same player and card predicate apply to both private zones. */
/* @sem Operation::Move{objects:Union([Zone(_{scope:Players{zone:Hand, players:One($player_possessive)}, kind:Card, filter:$card_filter}), Zone(_{scope:Players{zone:Graveyard, players:One($player_possessive)}, kind:Card, filter:$card_filter})]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_hand_graveyard_cards ::= "exile" "all" card_filter "cards" "from" player_possessive "hand" "and" "graveyard"

/* @sem Operation::Move{objects:Union([Zone(_{scope:Players{zone:Hand, players:One($player_possessive)}, kind:Card, filter:Any}), Zone(_{scope:Players{zone:Graveyard, players:One($player_possessive)}, kind:Card, filter:Any})]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_hand_graveyard_any ::= "exile" "all" "cards" "from" player_possessive "hand" "and" "graveyard"

/* The property refers to the immediately preceding single-card discard, not
   an arbitrary transition. Keep producer and consumer together for printing. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:Discard{players:One(AbilityController), amount:Constant(1)}}, Effect{result:@next, operation:LoseLife{players:$players_singular, amount:ObjectProperty{object:Query{objects:Transition{result:@prior, phase:Before}, index:0}, property:$receipt_stat, information:CurrentOrLastKnown}}}]} */
draw_discard_property_program ::= "draw" card_count "," "then" "discard" "a" "card" "." players_singular "loses" "life" "equal" "to" "the" "discarded" "card's" receipt_stat

/* The choice is made before acting on the resulting battlefield population. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:CreatureType, terms:_{count:Exactly(Constant(1)), options:[]}}}, Effect{result:@next, operation:SetTapped{objects:$chosen_type_population, tapped:false}}] */
instructions_untap_chosen_type ::= "untap" chosen_type_population

/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:CreatureType, terms:_{count:Exactly(Constant(1)), options:[]}}}, Effect{result:@next, operation:SetTapped{objects:$chosen_type_population, tapped:true}}] */
instructions_tap_chosen_type ::= "tap" chosen_type_population

/* A bounded X payment carries its bound alongside the dependent program. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[ManaXBounded{mana:[X], comparison:LessOrEqual, value:$life_gained_bound}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
instructions_pay_bounded_x ::= "you" "may" "pay" "{" "X" "}" "." "if" "you" "do" "," conjoined "." "x" "can't" "be" "greater" "than" life_gained_bound

/* @sem Expr::EventHistory{event:Player{event:GainsLife, players:One(AbilityController)}, window:ThisTurn, measure:TotalAmount} */
life_gained_bound ::= "the" "amount" "of" "life" "you" "gained" "this" "turn"

/* Both mentions of the sacrificed population must agree; the count belongs to
   this exact cost component and its performed Before receipt. */
/* @sem Instruction::[Optional{decider:AbilityController, body:@reflexive(Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($filter_plural, $filter_plural_2)}, choose:UpTo($value)}]}, optional:false}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:$players_singular, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural_3}, choose:AsManyAsCan(CountObjects(CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:Before}))})}]}})}]})}] */
instructions_optional_sacrifice_receipt ::= "you" "may" "sacrifice" "up" "to" value filter_plural "." "when" "you" "sacrifice" "one" "or" "more" filter_plural "this" "way" "," players_singular "sacrifices" "that" "many" filter_plural "of" "their" "choice"

/* A required sacrifice followed by its payment-success branch. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$player_ref, cost:$choice_sacrifice_cost, optional:false}}, If{condition:PaymentChosen(@last_result), then:$program, otherwise:Program{}}] */
clause_player_sacrifice_if_done ::= player_ref choice_sacrifice_cost "." "if" "that" "player" "does" "," program

/* @sem Cost::Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly($counter_amount)}]} */
choice_sacrifice_cost ::= "sacrifices" counter_amount filter_phrase "of" "their" "choice"

/* The target creature supplies both the payer and the measured property. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf($unregenerable_target), cost:$target_stat_life_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One(Target{slot:@last_slot, index:0}), regeneration:false}}]}, otherwise:Program{}}] */
clause_destroy_unless_stat_life ::= "destroy" unregenerable_target "unless" "its" "controller" "pays" target_stat_life_cost "." "a" "creature" "destroyed" "this" "way" "can't" "be" "regenerated"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0} */
unregenerable_target ::= "target" "creature"

/* @sem Cost::Cost{parts:[Life(ObjectProperty{object:Target{slot:@last_slot, index:0}, property:$stat, information:CurrentOrLastKnown})]} */
target_stat_life_cost ::= "life" "equal" "to" "its" stat

/* The next damage to the source can be redirected to that source's owner. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject(Source)), kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:TotalDamage($number), duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage(Players(One(OwnerOf(Source))))}}]}} */
redirect_next_damage_to_owner ::= "the" "next" number "damage" "that" "would" "be" "dealt" "to" "this" "creature" this_duration "is" "dealt" "to" "its" "owner" "instead"

/* Redirect a spell's damage back to the controller of the damage source. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Spell, sources:AnyOf([CardType(Instant), CardType(Sorcery)]), recipients:Players(One(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:NextOccurrence, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage(Players(One(ControllerOf(Damage(Source)))))}}]}} */
redirect_next_spell_damage_to_controller ::= "the" "next" "time" "an" "instant" "or" "sorcery" "spell" "would" "deal" "damage" "to" "you" this_duration "," "that" "spell" "deals" "that" "damage" "to" "its" "controller" "instead"

/* The target in the first sentence is the source of the later damage. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Permanent, sources:SameObject($chosen_damage_creature), recipients:Players(OpponentsOf(AbilityController)), kind:Combat, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([$damage_factor, EventAmount]))}}]}} */
multiply_chosen_creature_combat_damage ::= "choose" chosen_damage_creature "." duration "," "if" "that" "creature" "would" "deal" "combat" "damage" "to" "one" "of" "your" "opponents" "," "it" "deals" damage_factor "that" "damage" "to" "that" "player" "instead"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0} */
chosen_damage_creature ::= "target" "creature"

/* These movements use the exiled holder, not an arbitrary prior object. */
exiled_holder_move ::= exiled_holder_put | exiled_holder_put_attacking | exiled_holder_return

/* @sem Operation::Move{objects:InZone{objects:One(Source), zone:Exile}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]} */
exiled_holder_put ::= "put" "it" "onto" "the" "battlefield"

/* @sem Operation::Move{objects:InZone{objects:One(Source), zone:Exile}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{states:[Attacking{}]}}, qualifiers:[]} */
exiled_holder_put_attacking ::= "put" "it" "onto" "the" "battlefield" "attacking"

/* @sem Operation::Move{objects:InZone{objects:One(Source), zone:Exile}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]} */
exiled_holder_return ::= "return" "it" "to" "the" "battlefield"

exiled_holder_program ::= exiled_holder_one_move | exiled_holder_operation_then_if

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$exiled_holder_move}]} */
exiled_holder_one_move ::= exiled_holder_move

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$operation}, If{condition:$exiled_holder_no_counters, then:$exiled_holder_one_move, otherwise:Program{}}]} */
exiled_holder_operation_then_if ::= operation "." "then" "if" exiled_holder_no_counters "," exiled_holder_one_move

/* @sem Operation::Move{objects:InZone{objects:One(Source), zone:Exile}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true}}, qualifiers:[]} */
exiled_holder_put_tapped ::= "put" "this" "card" "from" "exile" "onto" "the" "battlefield" "tapped"

/* A printed choice lists independent ability options. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Ability, terms:_{options:[Ability(Keyword($keyword_value)), Ability(Keyword($keyword_value_2)), Ability(Keyword($keyword_value_3))], count:Exactly($value)}} */
choose_ability_options_three ::= "choose" value "abilities" "from" "among" keyword_value "," keyword_value "," "and" keyword_value

/* Color and creature type stay paired within each option. */
/* @sem Operand::Term{family:ColorAndCreatureType, form:ColorAndCreatureType, operands:[Vocabulary{family:Color, form:$token_color}, Vocabulary{family:CreatureType, form:@subtype_name($creature_subtype)}]} */
choice_color_type ::= token_color creature_subtype

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:ColorAndCreatureType, terms:_{count:Exactly(Constant(1)), options:[$choice_color_type, $choice_color_type_2, $choice_color_type_3, $choice_color_type_4, $choice_color_type_5]}} */
choose_color_type_options_five ::= "choose" choice_color_type "," choice_color_type "," choice_color_type "," choice_color_type "," "or" choice_color_type

/* @sem Operand::Term{family:CardsInOracle, form:And, operands:[Term{family:CardsInOracle, form:IsSupertype, operands:[Vocabulary{family:SuperType, form:Basic}]}, Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Land}]}]} */
card_name_basic_land ::= "basic" "land"

/* @sem Operand::Term{family:CardsInOracle, form:Not, operands:[$card_name_other_kind]} */
card_name_other_than_kind ::= "a" "card" "name" "other" "than" "a" card_name_other_kind "card" "name"

card_name_other_kind ::= card_name_basic_land | card_name_creature | card_name_nonartifact | card_name_noncreature | card_name_nonland | card_name_nonbasic_land

/* The second choice omits the repeated imperative. */
/* @sem Instruction::[Effect{result:@next, operation:$choice_and_name_first}, Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:CardName, terms:_{count:Exactly(Constant(1)), options:[$card_name_option]}}}] */
clause_choice_and_name ::= choice_and_name_first "and" card_name_option

choice_and_name_first ::= choose_opponent | choose_a_player | choose_land_type | choose_basic_land_type | choose_number_between | choose_a_number | choose_two_colors | choose_color_other | choose_creature_type_plain | choose_a_color

/* Each player makes a separate choice. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseValue{choosers:One(Bound(0)), kind:Word, terms:_{count:Exactly(Constant(1)), options:[Text($choice_word), Text($choice_word_2)]}}}]}}] */
clause_each_chooses_words ::= players_singular "chooses" choice_word "or" choice_word

choice_word ::= choice_word_war | choice_word_peace

/* @sem String::'War' */
choice_word_war ::= "war"

/* @sem String::'Peace' */
choice_word_peace ::= "peace"

/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:$spell_filter}, duration:$this_duration, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:$next_cast_copy, targets:May}}]}, once:true}}] */
clause_next_cast_copy_original ::= "when" "you" "next" "cast" spell_filter this_duration "," next_cast_copy

/* A spell's selected creature and a damage event are shared across the
   delayed trigger's independently constructed consequence. */
/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CreateTrigger{event:$selected_damage_event, duration:$this_duration, announcement:_{}, body:_{instructions:$selected_damage_consequence}, once:false}}]}} */
spell_selected_damage_trigger ::= selected_damage_event this_duration "," selected_damage_consequence "."

selected_damage_consequence ::= selected_damage_life | selected_damage_spread

/* @sem Instruction::[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:EventAmount}}] */
selected_damage_life ::= "you" "gain" "that" "much" "life"

/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:Target{slot:0, index:0}, recipients:Union([Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::CardType(Creature), ObjectFilter::Not(SameObject(Target{slot:0, index:0})))}), Players(All)]), amount:EventAmount, preventable:true}}] */
selected_damage_spread ::= "it" "deals" "that" "much" "damage" "to" "each" "other" "creature" "and" "each" "player"

/* The next-spell wording retains the same one-shot copy contract. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:$next_spell_filter}, duration:$this_duration, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:$next_cast_copy, targets:May}}]}, once:true}}] */
clause_cast_your_next_copy ::= "when" "you" "cast" "your" "next" next_spell_filter this_duration "," next_cast_copy

/* The future trigger owns the target announced for its optional action. */
/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:@scope(Operation::CreateTrigger{event:$event_unblocked, duration:EndOfTurn, announcement:@announcement, body:_{instructions:$optional_event_damage_consequence}, once:false})}]}} */
spell_unblocked_delayed ::= "until" "end" "of" "turn" "," "whenever" event_unblocked "," optional_event_damage_consequence "."

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:$event_power_damage}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:_{instructions:[Effect{result:@next, operation:$event_no_combat_damage}]}, otherwise:_{}}] */
optional_event_damage_consequence ::= "you" "may" "choose" "to" "have" event_power_damage "." "if" "you" "do" "," event_no_combat_damage

/* @sem Operation::DealDamage{source:EventSubject, recipients:Objects(One($target_permanent)), amount:ObjectProperty{object:EventSubject, property:Power, information:CurrentOrLastKnown}, preventable:true} */
event_power_damage ::= "it" "deal" "damage" "equal" "to" "its" "power" "to" "a" target_permanent

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(EventSubject)), changes:[Rule(CombatDamage(NoAssignment))], duration:$this_duration, evaluation:LiveObjects} */
event_no_combat_damage ::= "it" "assigns" "no" "combat" "damage" this_duration

/* A defender choice is shared by the single-target and per-creature forms. */
/* @sem () */
combat_defender_choice ::= "reselect" "which" "player" "or" "permanent"

/* @sem ObjectSet::$affected */
combat_attacker_defender ::= affected "is" "attacking"

/* @sem Operation::ChangeCombat{change:Reselect{objects:$combat_attacker_defender}} */
combat_reselect_target ::= combat_defender_choice combat_attacker_defender

/* Limit the anaphor to the explicit attacking creature population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Attacking, CardType(Creature)])} */
combat_each_attacking_creature ::= "each" "attacking" "creature"

/* @sem Operation::ChangeCombat{change:Reselect{objects:$combat_each_attacking_creature, optional:true}} */
combat_reselect_each ::= "for" combat_each_attacking_creature "," "you" "may" combat_defender_choice "that" "creature" "is" "attacking"

/* The chosen color comes from one linked card or from a linked set. */
/* @sem ManaProduction::ColorsAmong{objects:One($linked_exiled_card_possessive)} */
mana_colors_linked_card ::= "one" "mana" "of" "any" "of" linked_exiled_card_possessive "colors"

/* @sem ManaProduction::ColorsAmong{objects:$linked_exiled_cards_possessive} */
mana_colors_linked_cards ::= "one" "mana" "of" "any" "of" linked_exiled_cards_possessive "colors"

/* @sem Operation::AddMana{players:One(AbilityController), mana:ColorsAmong{objects:$craft_exiled_cards, each:true}} */
add_mana_each_craft_color ::= "for" "each" "color" "among" craft_exiled_cards "," "add" "one" "mana" "of" "that" "color"

/* Keep the choice and its consumer together so the chosen object is the actual receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Damage(Source), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:$conjure_selected_creature_form}] */
instructions_choice_conjure ::= "choose" "one" "of" "those" "creatures" "." conjure_selected_creature_form

conjure_selected_creature_form ::= conjure_selected_creature | conjure_selected_creatures

/* @sem Operation::Conjure{actor:One(AbilityController), card:Duplicate(One(Result{result:@prior, phase:After, index:0})), count:$counter_a, destination:$conjure_spellbook_zone} */
conjure_selected_creature ::= "conjure" counter_a "duplicate" "of" "the" "chosen" "creature" conjure_spellbook_zone

/* @sem Operation::Conjure{actor:One(AbilityController), card:Duplicate(One(Result{result:@prior, phase:After, index:0})), count:$number, destination:$conjure_spellbook_zone} */
conjure_selected_creatures ::= "conjure" number "duplicates" "of" "the" "chosen" "creature" conjure_spellbook_zone

/* Extra steps retain the recipient and count as independent operands. */
/* @sem Instruction::[Effect{result:@next, operation:AddPhases{actor:One(AbilityController), phases:$additional_step_kind, count:Expr::Constant(1)}}] */
clause_extra_step_one ::= "you" "get" "an" "additional" additional_step_kind "step" "after" "this" "step"

/* @sem Instruction::[Effect{result:@next, operation:AddPhases{actor:One(AbilityController), phases:$additional_step_kind, count:$count_plural}}] */
clause_extra_steps ::= "you" "get" count_plural "additional" additional_step_kind "steps" "after" "this" "step"

/* @sem PhaseKind::Upkeep */
additional_step_kind ::= "upkeep"

/* A defined X retains the recipient, counter kind, and devotion operands. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:$value_devotion}]} */
put_counters_where_devotion ::= "put" "X" counter_kind "counters" "on" affected "," "where" "X" "is" value_devotion

/* Keep the exiled-creature receipt local to its actual exile producer. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($exile_counter_creature_target), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$commander_counter_filter}), kind:$counter_kind, amount:$exile_counter_creature_power, selection:_{player:AbilityController, count:AsManyAsCan($counter_amount)}}]}}] */
instructions_exile_creature_power_counters ::= "exile" exile_counter_creature_target "." "put" "X" counter_kind "counters" "on" counter_amount commander_counter_filter "," "where" "X" "is" exile_counter_creature_power

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:CardType(Creature)}), index:0} */
exile_counter_creature_target ::= "target" "creature"

/* @sem ObjectFilter::AllOf([State(Commander), $filter_phrase, ControlledBy(One(AbilityController))]) */
commander_counter_filter ::= "commander" filter_phrase "you" "control"

/* Only the enclosing exile-and-placement sequence may use this operand. */
/* @sem Expr::ObjectProperty{object:Result{result:@prior, phase:Before, index:0}, property:Power, information:CurrentOrLastKnown} */
exile_counter_creature_power ::= "the" "power" "of" "the" "creature" "exiled" "this" "way"

/* A single optional cast owns the free payment and its exile replacement.
   The selected zone and mana-value ceiling come from the current phrase. */
/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:$graveyard_cast_selection, count:Exactly($counter_amount), terms:_{cost:Free, into_exile:true}}}]}}] */
clause_free_graveyard_cast ::= "you" "may" "cast" counter_amount graveyard_cast_selection

graveyard_cast_selection ::= graveyard_cast_your_before | graveyard_cast_your_after | graveyard_cast_any_after

/* @sem ObjectSet::Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([AnyOf([CardType(Instant), CardType(Sorcery)]), Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])}) */
graveyard_cast_your_before ::= "instant" "or" "sorcery" "spell" "from" "your" "graveyard" "with" "mana" "value" value "or" "less" "without" "paying" "its" "mana" "cost" "." "if" "that" "spell" "would" "be" "put" "into" "your" "graveyard" "," "exile" "it" "instead"

/* @sem ObjectSet::Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([AnyOf([CardType(Instant), CardType(Sorcery)]), Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])}) */
graveyard_cast_your_after ::= "instant" "or" "sorcery" "spell" "with" "mana" "value" value "or" "less" "from" "your" "graveyard" "without" "paying" "its" "mana" "cost" "." "if" "that" "spell" "would" "be" "put" "into" "your" "graveyard" "," "exile" "it" "instead"

/* @sem ObjectSet::Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:AllOf([AnyOf([CardType(Instant), CardType(Sorcery)]), Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])}) */
graveyard_cast_any_after ::= "instant" "or" "sorcery" "spell" "with" "mana" "value" "less" "than" "or" "equal" "to" value "from" "a" "graveyard" "without" "paying" "its" "mana" "cost" "." "if" "that" "spell" "would" "be" "put" "into" "a" "graveyard" "," "exile" "it" "instead"

/* Random selections preserve the independent choice operands. */
/* @sem Operation::ChooseAtRandom(_{kind:Ability, options:$random_keyword_pair}) */
random_keyword_choice ::= "choose" random_keyword_pair "at" "random"

/* @sem Operand::[Ability(Keyword($keyword_value)), Ability(Keyword($keyword_value_2))] */
random_keyword_pair ::= keyword_value "or" keyword_value

/* @sem Operation::ChooseAtRandom(_{kind:Player, options:[$random_player_population]}) */
random_player_choice ::= "choose" random_player_population "at" "random"

/* @sem Operand::Players(All) */
random_player_population ::= "a" "player"

/* Choice operands remain available independently to later instructions. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:CardType, terms:_{count:Exactly(Constant(1)), options:[$choice_card_type, $choice_card_type_2]}} */
choose_card_types_pair ::= "choose" choice_card_type "or" choice_card_type

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Filter, terms:_{count:Exactly(Constant(1)), options:[Filter(CardType(Land)), Filter(Not(CardType(Land)))]}} */
choose_land_or_nonland ::= "choose" "land" "or" "nonland"

/* The choice and series form one producer of the latest coin outcomes. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue(_{choosers:One(AbilityController), kind:Number, terms:_{count:Exactly(Constant(1))}})}, Effect{result:@next, operation:FlipCoinSeries{players:One(AbilityController), protocol:Called, repetition:UpTo{extent:Count(ChosenNumber), stop:$coin_series_stop}}}] */
chosen_coin_series ::= "choose" "a" "number" "." "flip" "a" "coin" "that" "many" "times" "or" "until" coin_series_stop "," "whichever" "comes" "first"

/* @sem Instruction::[If{condition:Compare{left:CountCoinOutcomes{source:Latest, outcome:Lost}, test:Compare{comparison:Equal, value:Constant(0)}}, then:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Multiply([$number, CountCoinOutcomes{source:Latest, outcome:Won}])}}]}, otherwise:_{}}] */
coin_series_win_draw ::= "if" "you" "win" "all" "the" "flips" "," "draw" number "cards" "for" "each" "flip"

/* Keep Latest scoped to the immediately preceding series. */
/* @sem Instruction::[...$chosen_coin_series, ...$coin_series_win_draw] */
instructions_chosen_coin_series_draw ::= chosen_coin_series "." coin_series_win_draw

/* A protection instruction can precede a clash with its own win program. */
/* @sem Instruction::[...$protection_from_chosen_color, ...$clash_if_you_win] */
instructions_protection_clash ::= protection_from_chosen_color "." clash_if_you_win

/* Revealing the hidden items completes the secret choices before their use. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseValue(_{choosers:One(Bound(0)), kind:Number, terms:_{options:[Comparison([Greater, Constant(0)])], count:Exactly(Constant(1)), secret:true}})}]}}, Effect{result:@next, operation:RevealChoices{kind:Number}}] */
hidden_items_reveal ::= "each" "player" "hides" "at" "least" "one" "item" "," "then" "all" "players" "reveal" "them" "simultaneously"

/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:LoseLife{players:One(Bound(0)), amount:PlayerNumber{player:Bound(0), number:ChosenNumber}}}]}}] */
revealed_items_life_loss ::= "each" "player" "loses" "life" "equal" "to" "the" "number" "of" "items" "they" "revealed"

/* Both sentences describe the same lowest-choice population, including ties. */
/* @sem Instruction::[ForEachPlayer{players:Matching{binding:0, condition:ChoseExtreme{player:Bound(0)}}, binding:0, body:_{instructions:[Effect{result:@next, operation:LoseLife{players:One(Bound(0)), amount:Divide{numerator:PlayerNumber{player:Bound(0), number:Life}, denominator:Constant(2), rounding:Up}}}]}}] */
fewest_items_half_life ::= "the" "player" "who" "revealed" "the" "fewest" "items" "then" "loses" "half" "their" "life" "," "rounded" "up" "." "if" "two" "or" "more" "players" "are" "tied" "for" "fewest" "," "each" "loses" "half" "their" "life" "," "rounded" "up"

/* Scope the consumers to the choices that produced the revealed items. */
/* @sem Instruction::[...$hidden_items_reveal, ...$revealed_items_life_loss, ...$fewest_items_half_life] */
instructions_hidden_items ::= hidden_items_reveal "." revealed_items_life_loss "." fewest_items_half_life

/* Turn actions share the subject supplied by a player clause. */
turn_keyword_third ::= skip_turn_part_third | extra_turns_third

/* @sem Operation::Keyword{actor:@subject, action:KeywordAction::Skip{part:$skipped_turn_part}} */
skip_turn_part_third ::= "skips" "their" "next" skipped_turn_part

skipped_turn_part ::= skipped_draw_step | skipped_combat_this_turn

/* @sem SkippedPart::DrawStep */
skipped_draw_step ::= "draw" "step"

/* @sem SkippedPart::CombatPhaseThisTurn */
skipped_combat_this_turn ::= "combat" "phase" "this" "turn"

/* @sem Operation::Keyword{actor:@subject, action:KeywordAction::TakeExtraTurn{times:$value}} */
extra_turns_third ::= "takes" value "extra" "turns" "after" "this" "one"

/* Conjuring a named card preserves the printed count and arrival state. */
/* @sem Operation::Conjure{actor:One(AbilityController), card:Named($conjured_battlefield_name), count:$card_count, destination:Battlefield(BattlefieldArrival{tapped:false, counters:[], states:[]})} */
conjure_named_battlefield ::= "conjure" card_count "named" conjured_battlefield_name "onto" "the" "battlefield"

/* @sem Operation::Conjure{actor:One(AbilityController), card:Named($conjured_battlefield_name), count:$card_count, destination:Battlefield(BattlefieldArrival{tapped:true, counters:[], states:[]})} */
conjure_named_battlefield_tapped ::= "conjure" card_count "named" conjured_battlefield_name "onto" "the" "battlefield" "tapped"

/* Names are separate reusable operands, shared by both arrival forms. */
conjured_battlefield_name ::= card_name_mishra_s_foundry | referenced_self_name | card_name_monastery_mentor | card_name_regal_force | card_name_siege_rhino | card_name_slimy_dualleech | card_name_soldiers_of_the_watch | card_name_soul_of_new_phyrexia | card_name_stonybrook_schoolmaster | card_name_storm_crow | card_name_thieving_magpie | card_name_training_grounds | card_name_utility_knife | card_name_wastes | card_name_starfighter_pilot | card_name_bear_cub | card_name_blood_artist | card_name_demonic_pact | card_name_goblin_gaveleer | card_name_lumbering_lightshield | card_name_midnight_clock | card_name_mitotic_slime

/* The option phrase carries each ability separately, so edited choices print
   from their current operands and numbered mechanics can share the list. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Ability, terms:_{count:Exactly(Constant(1)), options:$choice_ability_options}} */
choose_ability_options ::= "choose" choice_ability_options

choice_ability_options ::= choice_ability_pair | choice_ability_list

/* @sem Operand::[$choice_ability_option, $choice_ability_option_2] */
choice_ability_pair ::= choice_ability_option "or" choice_ability_option

/* @sem Operand::[$choice_ability_option, ...$choice_ability_tail] */
choice_ability_list ::= choice_ability_option "," choice_ability_tail

choice_ability_tail ::= choice_ability_last | choice_ability_more

/* @sem Operand::[$choice_ability_option] */
choice_ability_last ::= "or" choice_ability_option

/* @sem Operand::[$choice_ability_option, ...$choice_ability_tail] */
choice_ability_more ::= choice_ability_option "," choice_ability_tail

choice_ability_option ::= choice_keyword_option | choice_numbered_mechanic_option

/* @sem Operand::Ability(Ability::Keyword($keyword_value)) */
choice_keyword_option ::= keyword_value

/* @sem Operand::Ability(Ability::Mechanic{mechanic:$choice_numbered_mechanic, amount:$value}) */
choice_numbered_mechanic_option ::= choice_numbered_mechanic value

choice_numbered_mechanic ::= mechanic_rampage_choice | numbered_keyword_name

/* @sem Mechanic::Rampage */
mechanic_rampage_choice ::= "rampage"

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Number, terms:_{count:Exactly(Constant(1)), options:[$choice_number_bound]}} */
choose_number_threshold ::= "choose" "a" "number" choice_number_bound

/* @sem Operand::Comparison(Greater, $value) */
choice_number_bound ::= "greater" "than" value

/* Land and nonland are complements of the same fixed card type. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Filter, terms:_{count:Exactly(Constant(1)), options:$choice_land_options}} */
choose_land_class ::= "choose" choice_land_options

/* @sem Operand::[Filter(CardType(Land)), Filter(Not(CardType(Land)))] */
choice_land_options ::= "land" "or" "nonland"

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Direction, terms:_{count:Exactly(Constant(1)), options:$direction_choice}} */
choose_direction ::= "choose" direction_choice

/* @sem Operand::[] */
direction_choice ::= "left" "or" "right"

/* Return destinations keep entry counters and attachment hosts as current operands. */
/* @sem Operation::Move{objects:$affected, destination:$return_modified_destination, qualifiers:[]} */
move_to_modified_battlefield ::= "return" affected "to" "the" "battlefield" return_modified_destination

return_modified_destination ::= return_transformed_player_destination | return_transformed_object_destination | return_additional_counters_destination | return_two_counters_destination

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[Transformed, AttachedToPlayer($player_ref)]}} */
return_transformed_player_destination ::= "transformed" "under" "your" "control" "attached" "to" player_ref

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[Transformed, AttachedTo($object_ref)]}} */
return_transformed_object_destination ::= "transformed" "under" "your" "control" "attached" "to" object_ref

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, $value]], states:[]}} */
return_additional_counters_destination ::= "with" value "additional" counter_kind "counters" "on" "it"

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, $counter_amount], [$counter_kind_2, $counter_amount_2]], states:[]}} */
return_two_counters_destination ::= "with" counter_amount counter_kind "counter" "and" counter_amount counter_kind "counter" "on" "it"

/* @sem Operation::Move{objects:$return_permanent_population, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_filtered_permanents_hand ::= "return" return_permanent_population

return_permanent_population ::= return_chosen_color_population | return_owned_population

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, Chosen(Color)])} */
return_chosen_color_population ::= "all" filter_plural "of" "that" "color" "to" "their" "owners'" "hands"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, OwnedBy($players_singular)])} */
return_owned_population ::= "all" filter_plural players_singular "owns" "to" "their" "hand"

/* Choose from an explicitly described exile population. */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:$exile_linked_population, count:AsManyAsCan($card_count)} */
choose_exile_card ::= "choose" card_count exile_linked_population

/* @sem Operation::ChooseObjects{player:AbilityController, objects:$exile_described_population, count:AsManyAsCan($counter_amount)} */
choose_exile_filtered_card ::= "choose" counter_amount exile_described_population

/* @sem Operation::ChooseObjects{player:AbilityController, objects:$exile_random_population, count:AsManyAsCan($card_count), constraints:[AtRandom]} */
choose_exile_card_random ::= "choose" card_count "at" "random" exile_random_population

/* Exile populations and singleton receipts share the owner-directed move. */
/* @sem Operation::Move{objects:$put_exiled_singular_objects, destination:$put_exiled_singular_destination, qualifiers:[]} */
put_exiled_singular ::= "put" put_exiled_singular_objects "into" put_exiled_singular_destination

/* @sem Operation::Move{objects:$put_exiled_plural_objects, destination:$put_exiled_plural_destination, qualifiers:[]} */
put_exiled_plural ::= "put" put_exiled_plural_objects "into" put_exiled_plural_destination

/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
put_exiled_singular_hand ::= "its" "owner's" "hand"

/* @sem MovementDestination::OwnersGraveyard(CardArrival{counters:[], states:[]}) */
put_exiled_singular_graveyard ::= "its" "owner's" "graveyard"

put_exiled_singular_destination ::= put_exiled_singular_hand | put_exiled_singular_graveyard

/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
put_exiled_plural_hand ::= "their" "owner's" "hand"

/* @sem MovementDestination::OwnersGraveyard(CardArrival{counters:[], states:[]}) */
put_exiled_plural_graveyard ::= "their" "owner's" "graveyard"

put_exiled_plural_destination ::= put_exiled_plural_hand | put_exiled_plural_graveyard

/* Shared graveyard populations retain card identity and ownership. */
/* @sem Operation::Move{objects:$return_personal_graveyard_population, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_graveyard_personal_hand ::= "return" return_personal_graveyard_population "to" "your" "hand"

/* @sem Operation::Move{objects:$return_all_graveyard_population, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_graveyard_all_owners_hand ::= "return" return_all_graveyard_population "to" "their" "owners'" "hands"

/* The per-color target group is an operand shared by actions. */
/* @sem Operation::Move{objects:$each_color_graveyard_targets, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_each_color_targets_hand ::= each_color_graveyard_targets "to" "your" "hand"

/* Two independently described populations keep separate move results. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$battlefield_return_population, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:$graveyards_return_population, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_return_cross_zone_populations ::= "return" battlefield_return_population "and" graveyards_return_population "to" "their" "owners'" "hands"

/* A private graveyard selection keeps its own target announcements; every
   selected card belongs to the player whose hand receives it. */
/* @sem Operation::Move{objects:$return_graveyard_selection, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_graveyard_selection_hand ::= "return" return_graveyard_selection "from" "your" "graveyard" "to" "your" "hand"

/* @sem Operation::Move{objects:$return_color_selection, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_each_color_hand ::= "for" "each" "color" "," "return" return_color_selection "from" "your" "graveyard" "to" "your" "hand"

/* Future spell changes share their subject and their ability or rule change. */
/* @sem Operation::ChangeSpell{subject:$future_spell_subject, changes:$future_spell_change} */
change_future_spell ::= future_spell_subject future_spell_change

future_spell_subject ::= next_cost_subject | next_spell_they_this_turn

/* @sem SpellSubject::Next{spells:Any, player:@that_player, this_turn:true, from_hand:false} */
next_spell_they_this_turn ::= "the" "next" "spell" "they" "cast" "this" "turn"

future_spell_change ::= future_spell_has_mechanic | future_spell_cant_be_countered

/* @sem Change::[GrantAbility($future_spell_mechanic)] */
future_spell_has_mechanic ::= "has" future_spell_mechanic

future_spell_mechanic ::= mechanic_bare | mechanic_affinity

/* @sem Change::[CantBeCountered] */
future_spell_cant_be_countered ::= "can't" "be" "countered"

/* Divide one damage amount equally across the named recipient population. */
/* @sem Operation::DealDamageWith{source:$object_ref, recipients:$even_damage_recipients, amount:$number, rider:DividedEvenly(Down)} */
deal_damage_evenly_rounded ::= object_ref "deals" number "damage" "divided" "evenly" "," "rounded" "down" "," "among" even_damage_recipients

/* Future player casting permissions and restrictions share the affected player. */
/* @sem Operation::EffectOn{subject:Players(One(AbilityController)), effects:[$future_cast_effect]} */
future_player_cast_effect ::= future_cast_effect

future_cast_effect ::= next_spell_free_cast_effect | only_one_more_cast_effect

/* @sem Operand::Term{family:FuturePlayerEffect, form:MayCastTheirNextSpellThisTurnWithoutPaying, operands:[Filter($next_spell_chosen_filter)]} */
next_spell_free_cast_effect ::= "the" "next" "spell" "you" "cast" "this" "turn" next_spell_chosen_filter "can" "be" "cast" "without" "paying" "its" "mana" "cost"

/* @sem Operand::Term{family:FuturePlayerEffect, form:CanCastOnlyOneMoreSpellThisTurn} */
only_one_more_cast_effect ::= "you" "can" "cast" "only" "one" "more" "spell" "this" "turn"

perpetual_affected_subject ::= affected | library_perpetual_subject

/* Spell subjects and effects compose without changing the caster or the card's owner. */
/* @sem Operation::EffectOn{subject:$each_cast_hand_subject, effects:[$gained_spell_effect], until:EndOfTurn} */
spell_effect_each_cast ::= each_cast_hand_subject "," "they" "gain" gained_spell_effect

/* @sem EffectSubject::EachSpell(Cast{by:One(AbilityController), from:Players{zone:Hand, players:One(AbilityController)}}) */
each_cast_hand_subject ::= "as" "you" "cast" "spells" "from" "your" "hand" "this" "turn"

/* @sem Operand::Term{family:SpellEffect, form:Cascade} */
gained_spell_effect ::= "cascade"

/* @sem Operation::EffectOn{subject:NextSpell{spells:$next_hand_spell_filter, caster:AbilityController, this_turn:true, from:Hand}, effects:[$resolving_spell_effect]} */
spell_effect_next_cast ::= "the" "next" "time" "you" "cast" next_hand_spell_filter "spell" "from" "your" "hand" "this" "turn" "," resolving_spell_effect

next_hand_spell_filter ::= next_hand_instant_or_sorcery | next_hand_instant | next_hand_sorcery

/* @sem $spell_instant_or_sorcery */
next_hand_instant_or_sorcery ::= "an" spell_instant_or_sorcery

/* @sem $spell_instant */
next_hand_instant ::= "an" spell_instant

/* @sem $spell_sorcery */
next_hand_sorcery ::= "a" spell_sorcery

/* @sem Operand::Term{family:SpellEffect, form:ResolvesIntoHandInsteadOfGraveyard} */
resolving_spell_effect ::= "put" "that" "card" "into" "your" "hand" "instead" "of" "into" "your" "graveyard" "as" "it" "resolves"

/* The arrival set is tied to this exact conjure, in its library destination. */
/* @sem Instruction::[Effect{result:@next, operation:$conjure_named_library_top}, Effect{result:@next, operation:CreatePerpetualEffect{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@prior, phase:After})}), changes:[GrantAbility(@scope(Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$program}))]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_conjure_named_top_grant ::= conjure_named_library_top "." "they" "perpetually" "gain" '"' event_clause "," program "." '"' "then" "shuffle"

/* @sem Operation::Conjure{actor:One(AbilityController), card:Named($referenced_card_name), count:$card_count, destination:Library{position:Top, arrival:CardArrival{counters:[], states:[]}}} */
conjure_named_library_top ::= "conjure" card_count "named" referenced_card_name "on" "top" "of" "your" "library"

/* @sem Instruction::[Effect{result:@next, operation:$conjure_whole_spellbook_library}, Effect{result:@next, operation:$conjure_whole_spellbook_library}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_conjure_spellbook_twice ::= conjure_whole_spellbook_library "twice" "," "then" "shuffle"

/* @sem Operation::Conjure{actor:One(AbilityController), card:Spellbook{book:@card_name, pick:Each}, count:Constant(1), destination:Library{position:Random, arrival:CardArrival{counters:[], states:[]}}} */
conjure_whole_spellbook_library ::= "conjure" self_named "'s" "spellbook" "into" "your" "library"

/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Duplicate(One(EventOther)), count:$counter_amount, owner:AbilityController, destination:Library{position:AmongTop($card_count), arrival:CardArrival{counters:[], states:[]}}}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$static_changes}}]}}] */
instructions_may_conjure_duplicate_change ::= "you" "may" "conjure" counter_amount "duplicate" "of" "that" "creature" "into" "the" "top" card_count "of" "your" "library" "at" "random" "." "the" "duplicate" "perpetually" static_changes

/* Entry modifications to a spell cast under a permission are shared operands. */
/* @sem Operand::Term{family:SpellEffect, form:EntersWithACounter, operands:[Vocabulary{family:CounterType, form:FinalityCounter}]} */
cast_entry_finality ::= "enters" "with" "a" "finality" "counter" "on" "it"

/* @sem Operand::Term{family:SpellEffect, form:EntersWithLayerEffect, operands:[Term{family:LayerEffect, form:AddCreatureType, operands:[Vocabulary{family:CreatureType, form:Vampire}]}]} */
cast_entry_vampire ::= "is" "a" "Vampire" "in" "addition" "to" "its" "other" "types"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:$noun_creature}, terms:_{cost:Additional(Cost{parts:[Keyword{action:Forage}]}), effects:[$cast_entry_effects]}})], duration:$duration, evaluation:LiveObjects}}] */
instructions_graveyard_forage_entry ::= duration "," "you" "may" "cast" noun_creature "spells" "from" "your" "graveyard" "by" "foraging" "in" "addition" "to" "paying" "their" "other" "costs" "." "if" "you" "cast" "a" "spell" "this" "way" "," "that" "creature" cast_entry_effects

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:$filter_phrase}, terms:_{limit:Total(1), cost:Normal, effects:[$cast_entry_effects]}})], duration:$this_duration, evaluation:LiveObjects}}] */
instructions_graveyard_single_entry ::= "you" "may" "cast" "a" filter_phrase "spell" "from" "your" "graveyard" this_duration "." "if" "you" "do" "," "it" cast_entry_effects

/* @sem Operand::List([$cast_entry_finality]) */
cast_entry_effects_single ::= cast_entry_finality

/* @sem Operand::List([$cast_entry_finality, $cast_entry_vampire]) */
cast_entry_effects_pair ::= cast_entry_finality "and" cast_entry_vampire

cast_entry_effects ::= cast_entry_effects_single | cast_entry_effects_pair

/* The cast event's antecedent and the grant recipient are bound together. */
/* @sem Operand::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($affected_2), changes:[GainAbilitiesOf{objects:$affected, kinds:$copied_ability_kinds}], duration:$until_end_of_turn, evaluation:Snapshot}}]} */
cast_grant_abilities_program ::= "when" "you" "cast" affected "this" "turn" "," affected "gains" "all" copied_ability_kinds "abilities" "of" "that" "card" until_end_of_turn

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:$noun}), index:0}), from:Graveyard, action:CastSpell, filter:Any}, terms:_{cost:Normal, effects:[$cast_grant_abilities_program]}})], duration:EndOfTurn, evaluation:LiveObjects}}] */
instructions_target_graveyard_cast_grant ::= "you" "may" "cast" "target" noun "card" "in" "a" "graveyard" "this" "turn" "." cast_grant_abilities_program

/* Optional counter payment followed by a counter-dependent change to the same target. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PutCounters([_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$noun_creature}), index:0})), kind:$counter_payment_named, amount:Constant(1)}])]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@last_slot, index:0})), changes:[SetBasePowerToughness{power:$number_digits, toughness:$number_digits_2}, GrantKeyword($keyword_name)], duration:WhileMatches{object:Affected, filter:Counters(_{kind:$counter_payment_named_2, comparison:Greater, value:Constant(0)})}, evaluation:Snapshot}}]}, otherwise:_{}}] */
instructions_counter_payment_base_keyword ::= "you" "may" "put" "a" counter_payment_named "counter" "on" "target" noun_creature "." "if" "you" "do" "," "that" "creature" "has" "base" "power" "and" "toughness" number_digits "/" number_digits "and" "has" keyword_name "for" "as" "long" "as" "it" "has" "a" counter_payment_named "counter" "on" "it"

counter_payment_named ::= cn_feather | cn_charge | cn_time | cn_flying

/* The X definition fixes the target count from current or last-known counters
   on the named object; the final sentence modifies this destruction itself. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:$counter_count_targets, regeneration:false}}] */
clause_destroy_counter_count_no_regeneration ::= "destroy" counter_count_targets "." "they" "can't" "be" "regenerated"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(CountCounters(_{recipients:Objects(One($self_explicit_ref)), kind:$counter_kind, information:CurrentOrLastKnown})), filter:$filter_plural})) */
counter_count_targets ::= "up" "to" "X" "target" filter_plural "," "where" "X" "is" "the" "number" "of" counter_kind "counters" "on" self_explicit_ref

/* One target per opponent, with distinct controllers, announced together. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:$required_each_opponent_targets, regeneration:true}}] */
clause_destroy_required_opponent_targets ::= "for" "each" "opponent" "," "destroy" required_each_opponent_targets

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(CountPlayers(OpponentsOf(AbilityController))), filter:@and($adjective_nontype, $filter_phrase, ObjectFilter::ControlledBy(OpponentsOf(AbilityController))), constraints:[DifferentControllers]})) */
required_each_opponent_targets ::= "target" adjective_nontype filter_phrase "that" "player" "controls"

/* The named payer may prevent the stated operation by paying life. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$target_opponent, cost:Cost{parts:[Life($number)]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:$operation}]}, otherwise:Program{}}] */
clause_unless_named_life ::= operation "unless" target_opponent "pays" number "life"

/* Inclusive random bounds remain independent operands of the choice. */
/* @sem Operation::ChooseAtRandom{kind:Number, options:[Comparison([GreaterOrEqual, $value]), Comparison([LessOrEqual, $value_2])]} */
random_number_range ::= "where" "X" "is" "a" "number" "chosen" "at" "random" "from" value "to" value

/* @sem Operation::DealDamage{source:$object_ref, recipients:Objects($affected), amount:ChosenNumber, preventable:true} */
random_number_damage ::= object_ref "deals" "X" "damage" "to" affected

/* @sem Instruction::[Effect{result:@next, operation:$random_number_range}, Effect{result:@next, operation:$random_number_damage}] */
instructions_random_number_damage ::= random_number_damage "," random_number_range

/* The chosen controller is scoped to the bound object in the enclosing loop. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseAtRandom{kind:Player, options:[$recipients]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Bound(0))), changes:[SetController(Chosen)], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:SetTapped{objects:One(Bound(0)), tapped:false}}] */
random_controller_untap ::= "then" recipients "gains" "control" "of" "each" "permanent" "for" "which" "they" "were" "chosen" "." "untap" "those" "permanents"

/* @sem Instruction::[ForEachObject{objects:$affected, binding:0, body:Program{instructions:$random_controller_untap}}] */
instructions_random_controller_untap ::= "for" affected "," "choose" "a" "player" "at" "random" "." random_controller_untap

/* A payment action can occur in any program, including an entry replacement. */
/* @sem Instruction::[Effect{result:@next, operation:PayAnyAmount{actor:One(AbilityController), resource:$payment_resource}}] */
clause_pay_any_resource ::= "pay" "any" "amount" "of" payment_resource

/* @sem Resource::Life */
payment_resource_life ::= "life"

/* @sem Resource::Mana */
payment_resource_mana ::= "mana"

payment_resource ::= payment_resource_life | payment_resource_mana

/* Keep the payment producer and its aggregate consumer in one program. */
/* @sem Program::Program{instructions:[ForEachPlayer{players:All, binding:0, starting_with:AbilityController, body:_{instructions:[Effect{result:@next, operation:PayAnyAmount{actor:One(Bound(0)), resource:Mana}}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($object_ref)), changes:[Pump{power:Performed(@prior), toughness:$number_digits}], duration:EndOfTurn, evaluation:Snapshot}}]} */
program_shared_mana_payment_pump ::= "each" "player" "starting" "with" "you" "may" "pay" "any" "amount" "of" "mana" "." object_ref "gets" "+" "X" "/" "+" number_digits "until" "end" "of" "turn" "," "where" "X" "is" "the" "total" "amount" "of" "mana" "paid" "this" "way"

/* Each player retains the minimum of the explicitly named population. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:SacrificeAllBut{players:One(Bound(0)), objects:$affected, keep:AmongPlayers{players:All, number:Permanents($filter_plural), aggregation:Minimum}}}]}}] */
balance_sacrifice_minimum ::= "each" "player" "chooses" "a" "number" "of" affected "they" "control" "equal" "to" "the" "number" "of" filter_plural "controlled" "by" "the" "player" "who" "controls" "the" "fewest" "," "then" "sacrifices" "the" "rest"

/* The continuation repeats the minimum procedure for each player's hand. */
/* @sem Instruction::[...$balance_sacrifice_minimum, ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:DiscardAllBut{players:One(Bound(0)), keep:AmongPlayers{players:All, number:CardsInHand, aggregation:Minimum}}}]}}] */
instructions_balance_discard ::= balance_sacrifice_minimum "." "each" "player" "discards" "cards" "the" "same" "way"

/* The named second population supplies both the sacrificed set and its minimum. */
/* @sem Instruction::[...$balance_sacrifice_minimum, ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:SacrificeAllBut{players:One(Bound(0)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, keep:AmongPlayers{players:All, number:Permanents($filter_plural), aggregation:Minimum}}}]}}, ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:DiscardAllBut{players:One(Bound(0)), keep:AmongPlayers{players:All, number:CardsInHand, aggregation:Minimum}}}]}}] */
instructions_balance_sacrifice_discard ::= balance_sacrifice_minimum "." "players" "sacrifice" filter_plural "and" "discard" "cards" "the" "same" "way"

/* One choice from either private zone; the pool wording determines its filter. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$private_entry_pool, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:$private_counter_arrival}, qualifiers:[]}}] */
put_private_card_counter_entry ::= "put" "a" private_entry_pool "with" private_counter_arrival "on" "it"

/* @sem ObjectSet::Union([Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase})]) */
private_entry_pool_from_first ::= filter_phrase "card" "from" "your" "hand" "or" "graveyard" "onto" "the" "battlefield"

/* @sem ObjectSet::Union([Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:@and($filter_phrase, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}})}), Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:@and($filter_phrase, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}})})]) */
private_entry_pool_from_last ::= filter_phrase "card" "with" "mana" "value" "less" "than" "or" "equal" "to" value "onto" "the" "battlefield" "from" "your" "hand" "or" "graveyard"

private_entry_pool ::= private_entry_pool_from_first | private_entry_pool_from_last

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[]} */
private_counter_arrival_one ::= "a" counter_kind "counter"

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[[$counter_kind, @plural_amount($value)]], states:[]} */
private_counter_arrival_many ::= value counter_kind "counters"

private_counter_arrival ::= private_counter_arrival_one | private_counter_arrival_many

/* Repeating upkeep trigger carrying a separately parsed operation. */
/* @sem Operation::CreateTrigger{event:Turn{point:UpkeepBegins, players:One(AbilityController)}, duration:Indefinite, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$operation}]}} */
operation_each_your_upkeep_rest ::= "at" "the" "beginning" "of" "each" "of" "your" "upkeeps" "for" "the" "rest" "of" "the" "game" "," operation

/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, History{event:CountersPutWith(_{kind:$counter_kind_2, with:$object_ref}), window:ThisGame}, Not(History{event:CountersRemovedWith(_{kind:$counter_kind_3, with:$object_ref_2}), window:ThisGame})])}), kind:$counter_kind, amount:All, selection:_{player:AbilityController, count:Exactly($counter_amount)}}]} */
remove_counters_with_history ::= "remove" "all" counter_kind "counters" "from" counter_amount filter_phrase "that" "a" counter_kind "counter" "was" "put" "onto" "with" object_ref "but" "that" "a" counter_kind "counter" "has" "not" "been" "removed" "from" "with" object_ref

/* The next-cast event scopes the separately expressed instruction sequence. */
/* @sem Operation::CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:$filter_phrase}, duration:$this_duration, announcement:@announcement, body:_{instructions:$next_cast_search_instructions}, once:true} */
operation_next_cast_search ::= "when" "you" "next" "cast" "a" filter_phrase "spell" this_duration "," next_cast_search_instructions

/* A mill and its optional return share the receipt; the inverse must match
   both the producer and the selected card's actual destination. */
/* @sem Vec<Instruction>::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$milled_return_filter}, count:Exactly(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
mill_optional_return ::= "mill" card_count "." "you" "may" "put" "a" milled_return_filter "card" "from" "among" "the" "cards" "milled" "this" "way" "into" "your" "hand"

/* @sem ObjectFilter::AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]) */
milled_return_permanent ::= "permanent"

/* @sem ObjectFilter::CardType(Creature) */
milled_return_creature ::= "creature"

/* @sem ObjectFilter::CardType(Land) */
milled_return_land ::= "land"

milled_return_filter ::= milled_return_permanent | milled_return_creature | milled_return_land

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$mill_optional_return}} */
spell_mill_optional_return ::= mill_optional_return "."

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$mill_optional_return, If{condition:AnyOf([$condition, ObjectMatches{object:Result{result:@last_result, phase:After, index:0}, filter:$filter_phrase}]), then:$program, otherwise:Program{}}]}} */
spell_mill_optional_return_if ::= mill_optional_return "." "if" condition "or" "returned" "a" filter_phrase "card" "to" "your" "hand" "this" "way" "," program "."

/* A resolving counter transfer is a payment; its endpoints remain independent. */
/* @sem Cost::Cost{parts:[MoveCounters(_{from:One($self_explicit_ref), to:One($target_another), amount:AtLeast(Constant(1))})]} */
payment_move_counters_source ::= "move" "one" "or" "more" "counters" "from" self_explicit_ref "onto" target_another

/* A payment event supplies the life amount to this placement. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:Game(LifePaid)}]} */
paid_life_counter_placement ::= "put" "that" "many" counter_kind "counters" "on" affected

/* @sem Ability::Triggered{event:Player{event:PaysLife, players:One(AbilityController)}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$paid_life_counter_placement}]}} */
triggered_paid_life_placement ::= "whenever" "you" "pay" "life" "," paid_life_counter_placement "."

/* Each player chooses from their own hand, then discards that selection. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:$discard_hand_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}]}}] */
each_player_filtered_discard ::= "each" "player" "discards" "a" discard_hand_filter "card"

/* @sem ObjectFilter::Not(CardType(Land)) */
discard_hand_nonland ::= "nonland"

/* @sem ObjectFilter::Not(CardType(Creature)) */
discard_hand_noncreature ::= "noncreature"

discard_hand_filter ::= discard_hand_nonland | discard_hand_noncreature

/* The chosen player conjures the discarded event card and grants its result an ability. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue(_{choosers:One(EventSubject), kind:Player, terms:_{options:[Players(OthersThan(EventSubject))], count:Exactly(Constant(1))}})}, Effect{result:@next, operation:$chosen_conjure_discarded}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:[$discarded_perpetual_grant]}}] */
discarded_duplicate_perpetual ::= "they" "choose" "another" "player" "." chosen_conjure_discarded "." "it" "perpetually" "gains" '"' discarded_perpetual_grant "." '"'

/* @sem Operation::Conjure{actor:One(Chosen), card:Duplicate(One(Query{objects:InZone{objects:One(Discarded), zone:Graveyard}, index:0})), count:Constant(1), destination:Hand{}} */
chosen_conjure_discarded ::= "that" "player" "conjures" "a" "duplicate" "of" "that" "card" "into" "their" "hand"

/* @sem Change::GrantAbility(Casting(SpendAsThoughAnyType)) */
discarded_perpetual_grant ::= "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "this" "spell"

/* The return and delayed sacrifice both refer to this exact move's arrivals. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:$object_ref, affected:Objects(Transition{result:@prior, phase:After}), changes:$static_changes, duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Transition{result:0, phase:After}})}]}}}]} */
program_linked_return_changes_sacrifice ::= "put" "all" "cards" "exiled" "with" object_ref "onto" "the" "battlefield" "." "they" static_changes "." "sacrifice" "them" "at" "the" "beginning" "of" "the" "next" "end" "step" "."

/* Scope the delayed return to the source exile that produced its receipt. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One($self_explicit_ref), destination:Exile{visibility:FaceUp, arrival:_{}}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@back(3), phase:After}, zone:Exile}, destination:Battlefield{controller:Owner, arrival:_{}}}}]}}}]} */
program_exile_self_return_owner ::= "exile" self_explicit_ref "." "return" "it" "to" "the" "battlefield" "under" "its" "owner's" "control" "at" "the" "beginning" "of" "the" "next" "end" "step" "."

/* The plural discard and random-library conjure are separate player phases. */
/* @sem Instruction::[ForEachPlayer{players:$players_each, binding:0, body:Program{instructions:[Effect{result:@next, operation:Discard{players:One(Bound(0)), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any})}}]}}, ForEachPlayer{players:$players_each, binding:0, body:Program{instructions:[Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), objects:Zone{scope:Players{zone:Library, players:One(Seat{of:Bound(0), side:Right})}, kind:Card, filter:Any}, chooser:Chance, count:AsManyAsCan($value)}], action:Conjure{actor:One(Bound(0)), card:Duplicate(Prepared(@selection_id(0))), count:$counter_amount, destination:Hand(CardArrival{counters:[], states:[]})}}}]}}] */
player_discard_conjure_right ::= players_each "discards" "their" "hand" "," "then" "conjures" counter_amount "duplicate" "of" "each" "of" value "random" "cards" "from" "the" "library" "of" "the" "player" "to" "their" "right" "into" "their" "hand"

/* The history set is limited to the players' hands and the preceding conjure. */
/* @sem Instruction::Effect{result:@next, operation:CreatePerpetualEffect{objects:Zone{scope:Players{zone:Hand, players:All}, kind:Card, filter:InSet(Earlier{what:Conjured})}, changes:[GrantAbility(Casting(SpendAsThoughAnyType))]}} */
conjured_duplicates_spending ::= "the" "duplicates" "perpetually" "gain" '"' "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "this" "spell" "." '"'

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$player_discard_conjure_right, $conjured_duplicates_spending]}} */
spell_player_discard_conjure_spending ::= player_discard_conjure_right "." conjured_duplicates_spending

/* The selection and its immediate result remain together for the anaphor. */
/* @sem Instruction::[Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), objects:Zone{scope:Players{zone:Library, players:One(Target{slot:0, index:0})}, kind:Card, filter:Any}, chooser:Chance, count:AsManyAsCan(Constant(1))}], action:Conjure{actor:One(AbilityController), card:Duplicate(Prepared(@selection_id(0))), count:Constant(1), destination:Hand(CardArrival{counters:[], states:[]})}}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:[GrantAbility(Casting(SpendAsThoughAnyType))]}}] */
conjure_target_library_spending ::= "conjure" "a" "duplicate" "of" "a" "random" "card" "from" "their" "library" "into" "your" "hand" "." "it" "perpetually" "gains" '"' "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "this" "spell" "." '"'

/* @sem Instruction::[Effect{result:@next, operation:Discard{players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0}), amount:$card_count}}, Effect{result:@next, operation:PayCost{player:Target{slot:0, index:0}, cost:Cost{parts:[Discard{count:Constant(1), filter:Any}]}, optional:true}}] */
target_opponent_discard_optional_extra ::= "target" "opponent" "discards" card_count "." "then" "they" "may" "discard" "an" "additional" "card"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$target_opponent_discard_optional_extra, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:$conjure_target_library_spending}, otherwise:Program{}}]}} */
spell_discard_or_conjure_spending ::= target_opponent_discard_optional_extra "." "if" "they" "don't" "," conjure_target_library_spending

/* The named card is selected from exile and returns under its own owner. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Exile), kind:Card, filter:$modifier_source_name}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
clause_return_named_exile_owner ::= "return" "an" "exiled" "card" modifier_source_name "to" "the" "battlefield" "under" "its" "owner's" "control"

/* One opponent announces the target; the subsequent token references share its creation receipt. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(OneOf(OpponentsOf(AbilityController))))]), chooser:OneOf(OpponentsOf(AbilityController))}), index:0}, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Created(@prior)), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Move{objects:Created(@back(4)), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}] */
clause_opponent_copy_token_delayed ::= "an" "opponent" "chooses" "target" "creature" "they" "control" "." "create" "a" "token" "that's" "a" "copy" "of" "that" "creature" "." "that" "token" "gains" keyword_name duration "." "exile" "the" "token" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* The return refers to cards put into a graveyard by the immediately preceding
   destroy instruction; keep the two instructions in one printable shape. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:$plural_target_count, filter:AnyOf([$plural, AllOf([Not(SameObject(Source)), $plural_2])])})), regeneration:true}}, Effect{result:@next, operation:Move{objects:Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:InSet(Earlier{what:PutInGraveyard})}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
instructions_destroy_target_return_graveyard ::= "destroy" plural_target_count "target" plural "and" "/" "or" "other" plural "." "return" "each" "card" "put" "into" "a" "graveyard" "this" "way" "to" "the" "battlefield" "under" "your" "control"

/* The earlier player target also constrains the later permanent target. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($filter_phrase, ObjectFilter::ControlledBy(One($opponent_fewer_graveyard_cards)))}), index:0}), regeneration:true}}]}} */
activated_opponent_graveyard_destroy ::= cost ":" "choose" opponent_fewer_graveyard_cards "as" "you" "activate" "this" "ability" "." "destroy" "target" filter_phrase "that" "player" "controls" "."

/* Each player independently draws up to the stated count. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:DrawUpTo{players:One(Bound(0)), amount:$card_count}}]}}] */
clause_each_player_draw_up_to ::= players_singular "may" "draw" "up" "to" card_count

/* The anaphor names the players selected by this complete revealed-number
   sequence. Its conditional body remains an independently composable program. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseValue{choosers:One(Bound(0)), kind:Number, terms:_{options:$secret_number_bounds, count:Exactly(Constant(1)), secret:true}}}]}}, Effect{result:@next, operation:RevealChoices{kind:Number}}, ForEachPlayer{players:Matching{binding:0, condition:ChoseExtreme{player:Bound(0), highest:true}}, binding:0, body:_{instructions:[Effect{result:@next, operation:LoseLife{players:One(Bound(0)), amount:PlayerNumber{player:Bound(0), number:ChosenNumber}}}]}}, If{condition:ChoseExtreme{player:AbilityController, highest:true}, then:$then_condition_program, otherwise:Program{}}] */
instructions_revealed_highest_conditional ::= "each" "player" "secretly" "chooses" secret_number_bounds "." "then" "those" "numbers" "are" "revealed" "." "each" "player" "with" "the" "highest" "number" "loses" "that" "much" "life" "." "if" "you" "are" "one" "of" "those" "players" "," then_condition_program

/* The imperative and third-person forms share the pile choice while preserving
   the player who chooses and exiles it. */
/* @sem Operation::ChoosePile{actor:$pile_exile_actor, then:Exile} */
choose_pile_destination ::= pile_exile_actor pile_choice_reference

pile_exile_actor ::= pile_exile_controller | pile_exile_player

/* @sem PlayerSet::One(AbilityController) */
pile_exile_controller ::= "exile"

/* @sem $players_singular */
pile_exile_player ::= players_singular "exiles"

/* @sem () */
pile_choice_reference ::= "one" "of" "those" "piles"

/* @sem Operation::Surveil{players:@subject, amount:$value} */
surveil_defined_base ::= "surveil" "X" "," "where" "X" "is" value

/* @sem Operation::Surveil{players:@subject, amount:$value} */
surveil_defined_third ::= "surveils" "X" "," "where" "X" "is" value

/* @sem ManaProduction::LastNoted{amount:false} */
mana_last_noted_type ::= "one" "mana" "of" "this" "artifact's" "last" "noted" "type"

/* The condition and discard refer to the one card drawn, even after revealing it.
   Keep the producer and both consumers together so no unrelated receipt can bind. */
/* @sem Instruction::[Effect{result:@mark, operation:Draw{players:One(AbilityController), amount:Constant(1)}}, Effect{result:@next, operation:Reveal{objects:Transition{result:@marked, phase:After}}}, If{condition:Not(Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$card_word}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}), then:Program{instructions:[Effect{result:@next, operation:DiscardObjects{objects:Transition{result:@marked, phase:After}}}]}, otherwise:Program{}}] */
instructions_draw_reveal_discard_unless ::= "draw" "a" "card" "and" "reveal" "it" "." "if" "it" "isn't" "a" card_word "card" "," "discard" "it"

/* The player chooses how much energy to pay; the operation records the payment. */
/* @sem Operation::PayAnyAmount{actor:$pay_any_energy_subject, resource:Energy} */
pay_any_energy ::= pay_any_energy_subject "may" "pay" "any" "amount" "of" "{" "E" "}"

pay_any_energy_subject ::= player_rule_you | players_singular

/* The cast and remainder both consume the preceding top-library exile receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Transition{result:@marked, phase:After}, filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])}, count:AnyNumber, cost:Free}}, Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_exile_top_cast_graveyard ::= exile_top_cards_of_your_library "." "you" "may" "cast" card_filter "spells" "with" "mana" "value" value "or" "less" "from" "among" "them" "without" "paying" "their" "mana" "costs" "." "then" "put" "all" "cards" "exiled" "this" "way" "that" "weren't" "cast" "into" "your" "graveyard"

/* A quantity of cards retained from the controller's hand. */
/* @sem $card_count */
hand_retained_count ::= card_count "in" "your" "hand"

/* @sem Operation::DiscardAllBut{players:One(AbilityController), keep:$hand_retained_count} */
discard_except_hand_choice ::= "choose" hand_retained_count "and" "discard" "the" "rest"

/* A creature choice and per-creature payment retain independent current operands. */
/* @sem Operation::ChooseAndPay{actor:$players_singular, objects:$chosen_creature_population, cost:$payment_per_chosen_creature} */
choose_creatures_pay_each ::= players_singular "may" "choose" "any" "number" "of" chosen_creature_population "and" payment_per_chosen_creature

/* The continuation refers to this choice's selected creatures. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_creatures_pay_each}, Effect{result:@next, operation:SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:InSet(Earlier{what:Selected})}}}] */
instructions_choose_paid_creatures_untap ::= choose_creatures_pay_each "." "if" "the" "player" "does" "," "untap" "those" "creatures"

/* A postposed condition gates the complete imperative at resolution. */
/* @sem Instruction::[@resolution(Instruction::If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::AbilityController), $verb_operation_imperative)}]}, otherwise:Program{}})] */
clause_imperative_postcondition ::= verb_operation_imperative "if" condition

/* The count is scoped to the same player as the drawing instruction. */
/* @sem Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:$filter_phrase}) */
bound_graveyard_card_count ::= "for" "each" filter_phrase "card" "in" "their" "graveyard"

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(Bound(0)), amount:$bound_graveyard_card_count}}]}}] */
/* @prefer always */
clause_players_draw_per_graveyard_card ::= players_singular "draws" "a" "card" bound_graveyard_card_count

/* Untapping does not change which creatures are attacking, so both actions
   refer to the same live attacking population. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Attacking, CardType(Creature)])}, tapped:false}}, Effect{result:@next, operation:KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Goad{}, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Attacking, CardType(Creature)])}}}] */
clause_untap_attacking_and_goad ::= "untap" "all" "attacking" "creatures" "and" "goad" "them"

/* Select from the preceding recorded population and discard from that player’s hand. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Recorded(@prior), count:Exactly($count_plural)}}, Effect{result:@next, operation:DiscardObjects{objects:Zone{scope:Players{zone:Hand, players:One($that_player)}, kind:Card, filter:InSet(Recorded(@prior))}}}] */
clause_choose_revealed_hand_discard ::= "you" "choose" count_plural "of" "them" "." that_player "discards" "those" "cards"

/* Optional selection from the previous hand observation and two independently
   parameterized perpetual characteristics. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(3)), zone:Hand}, filter:OwnedBy(One(@that_player))}, count:AsManyAsCan(Constant(1))}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:_{instructions:[Effect{result:@next, operation:EffectOn{subject:Objects(One(Result{result:@prior, phase:After, index:0})), effects:[$perpetual_hand_color, $perpetual_hand_cost]}}]}, otherwise:_{}}] */
clause_observed_hand_perpetual ::= "you" "may" "choose" "one" "of" "those" "cards" "." "if" "you" "do" "," "it" "perpetually" perpetual_hand_color "and" "its" "mana" "cost" "perpetually" perpetual_hand_cost

/* @sem Operand::Term{family:PerpetualEffect, form:SetColor, operands:[Term{family:SettableColor, form:SimpleColorList, operands:[$perpetual_simple_color]}]} */
perpetual_hand_color ::= "becomes" perpetual_simple_color

perpetual_simple_color ::= perpetual_color_white | perpetual_color_blue | perpetual_color_black | perpetual_color_red | perpetual_color_green

/* @sem Operand::Vocabulary{family:SimpleColor, form:White} */
perpetual_color_white ::= "white"

/* @sem Operand::Vocabulary{family:SimpleColor, form:Blue} */
perpetual_color_blue ::= "blue"

/* @sem Operand::Vocabulary{family:SimpleColor, form:Black} */
perpetual_color_black ::= "black"

/* @sem Operand::Vocabulary{family:SimpleColor, form:Red} */
perpetual_color_red ::= "red"

/* @sem Operand::Vocabulary{family:SimpleColor, form:Green} */
perpetual_color_green ::= "green"

/* @sem Operand::Term{family:PerpetualEffect, form:SetManaCost, operands:[Term{family:ManaSymbolX, form:ManaCostGeneric, operands:[Integer($number)]}]} */
perpetual_hand_cost ::= "becomes" "{" NUMBER "}"

/* The revealed whole hand and the discard owner are the same player. The
   fallback tests the choice receipt and places counters on a chosen permanent. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($hand_player)}, kind:Card, filter:Any}}}, Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One($hand_player)}, kind:Card, filter:$card_filter}, count:UpTo(Constant(1))}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@marked)}}, If{condition:Not(Compare{left:CountObjects(Recorded(@marked)), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}), then:Program{instructions:[Effect{result:@next, operation:$put_counters_choice}]}, otherwise:Program{}}] */
instructions_revealed_hand_optional_discard_fallback ::= hand_player "reveals" "their" "hand" "." "you" "may" "choose" "a" card_filter "card" "from" "it" "." "if" "you" "do" "," "that" "player" "discards" "that" "card" "." "if" "you" "don't" "," put_counters_choice

/* The permission is linked to the arrival of this precise exile instruction. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo($number), filter:$adjective_nontype}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(OwnerOf(Result{result:@prior, phase:After, index:0}))), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:CastSpell, filter:Any})], duration:WhileExiled(Result{result:@prior, phase:After, index:0}), evaluation:LiveObjects}}] */
clause_exile_optional_owner_cast ::= "exile" "up" "to" number "target" adjective_nontype "permanent" "." "for" "as" "long" "as" "that" "card" "remains" "exiled" "," "its" "owner" "may" "cast" "it"

/* Preserve the singular target as an object reference in this return action. */
/* @sem Operation::Move{objects:One($target_card_up_to_union_your_graveyard), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_optional_union_graveyard_hand ::= "return" target_card_up_to_union_your_graveyard "to" "your" "hand"

/* The target's owner chooses whether to ante; a declined payment exchanges
   ownership and moves the same target and source to their owners' graveyards. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:OwnerOf(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@agree($noun, @agree($noun_2, $noun_3))}), index:0}), cost:Cost{parts:[PlayerAction{player:OwnerOf(Target{slot:0, index:0}), body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(OwnerOf(Target{slot:0, index:0}))}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:Ante(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:Exchange(_{kind:Ownership, first:Object(Target{slot:0, index:0}), second:Object(Source)})}, Effect{result:@next, operation:Move{objects:One(Target{slot:0, index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:One(Source), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{}}] */
instructions_owner_ante_exchange ::= "the" "owner" "of" "target" noun "may" "ante" "the" "top" "card" "of" "their" "library" "." "if" "that" "player" "doesn't" "," "exchange" "ownership" "of" "that" noun "and" SELF_NAME "." "put" "the" noun "card" "into" "your" "graveyard" "and" SELF_NAME "from" "anywhere" "into" "that" "player's" "graveyard" "." "this" "change" "in" "ownership" "is" "permanent"

/* The complete placement and follow-up establish the applied-counter receipt.
   Fixed counter kinds keep each printed mention tied to the producer. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PutCounters{placements:[_{recipients:Objects(One($target_permanent)), kind:PowerToughness(1, 1), amount:Constant(1)}]}}, Effect{result:@next, operation:DoubleCounters(_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::InSet(Affected(@marked)))}, kind:PowerToughness(1, 1)})}]} */
counter_receipt_double_sentence ::= "put" "a" "+" "1" "/" "+" "1" "counter" "on" target_permanent "," "then" "double" "the" "number" "of" "+" "1" "/" "+" "1" "counters" "on" "each" filter_phrase "that" "had" "a" "+" "1" "/" "+" "1" "counter" "put" "on" "it" "this" "way" "."

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PutCounters{placements:[_{recipients:Objects(One($target_permanent)), kind:Named(DoubleStrikeCounter), amount:Constant(1)}]}}, Effect{result:@next, operation:KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Goad{}, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::InSet(Affected(@marked)))}}}]} */
counter_receipt_goad_sentence ::= "put" "a" "double" "strike" "counter" "on" target_permanent "," "then" "goad" "each" filter_phrase "that" "had" "a" "double" "strike" "counter" "put" "on" "it" "this" "way" "."

/* The returned creature and both later references share this move's arrival.
   The leading condition and the copy's two characteristics remain independent. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, If{condition:AllOf([$condition_one, ObjectMatches{object:Result{result:@last_result, phase:After, index:0}, filter:Not(Supertype(Legendary))}]), then:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Result{result:@prior, phase:After, index:0}, exceptions:[CopyException::SetPowerToughness{power:$value, toughness:$value_2}]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:_{}}] */
instructions_returned_creature_conditional_copy ::= "return" "target" "creature" "card" "from" "your" "graveyard" "to" "the" "battlefield" "." "then" "if" condition_one "and" "that" "creature" "isn't" "legendary" "," "create" "a" "token" "that's" "a" "copy" "of" "that" "creature" "," "except" "it's" value "/" value

/* The graveyard selection is scoped to the immediately preceding destroy,
   including its actual arrival receipt and the named graveyard. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, regeneration:true}}, If{condition:$condition_one, then:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, InSet(Transition{result:@prior, phase:After})])}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:_{}}] */
instructions_destroy_then_conditional_return ::= "destroy" "all" filter_plural "." "if" condition_one "," "return" "a" filter_phrase "card" "put" "into" "your" "graveyard" "this" "way" "to" "the" "battlefield" "under" "your" "control"

exile_object_set ::= object_set | exile_target_stack_spell | stack_target_spells | exile_target_described_aimed_spell

/* @sem ObjectSet::One($target_stack_spell) */
exile_target_stack_spell ::= target_stack_spell

exile_aimed_at ::= target_tax_you_only | target_tax_active_player

/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Spell, zones:[Stack]}), count:Exactly(Expr::Constant(1)), filter:$stack_spell_described_targeting}), index:0}) */
exile_target_described_aimed_spell ::= "target" stack_spell_described_targeting

/* @prefer always */
/* @sem Change::[CreatureTypes{mode:Add, types:Listed($becomes_type_more)}] */
entry_that_creature_subtype_changes ::= "that" "creature" "is" "an" becomes_type_more "in" "addition" "to" "its" "other" "types"

/* Each player selects from their own graveyard and controls their arrivals. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:$filter_phrase}, count:AsManyAsCan($value)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}] */
clause_each_graveyard_battlefield ::= players_singular "returns" value filter_phrase "cards" "from" "their" "graveyard" "to" "the" "battlefield"

/* The chosen creature is the actual redirect destination. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(@and($filter_plural, ObjectFilter::ControlledBy(One(AbilityController)))), kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:UntilNextTurn(AbilityController), body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage(Objects(One(Result{result:@back(3), phase:After, index:0})))}}]}}}] */
instructions_chosen_creature_redirect ::= "choose" "a" "creature" "you" "control" "." "until" "your" "next" "turn" "," "all" "damage" "that" "would" "be" "dealt" "to" filter_plural "you" "control" "is" "dealt" "to" "that" "creature" "instead"

/* Target announcement supplies the antecedent; these moves carry no separate
   actor operand, while the target's controller decides whether to perform them. */
/* @sem Instruction::[Optional{decider:ControllerOf($target_object), body:Program{instructions:[Effect{result:@next, operation:$controller_optional_move}]}}] */
instructions_target_controller_optional_move ::= "choose" target_object "." "its" "controller" "may" controller_optional_move

controller_optional_move ::= exile_with_counter | exile_objects

/* The named controller decides whether the separately named source deals the damage. */
/* @sem Instruction::[Optional{decider:$its_controller_named, body:Program{instructions:[Effect{result:@next, operation:$optional_controller_damage}]}}] */
instructions_named_controller_optional_damage ::= its_controller_named "may" "have" optional_controller_damage

/* @sem Operation::DealDamage{source:$damage_source_ref, recipients:$recipients, amount:$number, preventable:true} */
optional_controller_damage ::= damage_source_ref "deal" number "damage" "to" recipients

/* A counted group of coins is shared by plural coin actions. */
/* @sem $value */
coin_quantity ::= value "coins"

/* @sem Operation::FlipCoins{players:One(AbilityController), count:$coin_quantity, protocol:@coin_protocol} */
flip_counted_coins ::= "flip" coin_quantity

/* Seek keeps the chosen quantity, qualifying filter and library depth independent. */
/* @sem Operation::Seek{actor:One(AbilityController), cards:[$seek_card_filter], count:@plural_amount($number), top:$seek_library_depth} */
seek_filtered_top_cards ::= "seek" number seek_card_filter "cards" "from" "among" seek_library_depth

/* @sem Operation::Seek{actor:One(AbilityController), cards:[$seek_card_filter], count:Constant(1), top:$seek_library_depth} */
seek_filtered_top_one ::= "seek" "an" seek_card_filter "card" "from" "among" seek_library_depth

/* @sem $filter_phrase */
seek_card_filter ::= filter_phrase

/* @sem $card_count */
seek_library_depth ::= "the" "top" card_count "of" "your" "library"

/* Explicit battlefield population for a distributive counter placement. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}), kind:$counter_kind, amount:Constant(1)}]} */
put_counter_each_battlefield ::= "put" "a" counter_kind "counter" "on" "each" filter_phrase "on" "the" "battlefield"

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}), kind:$counter_kind, amount:$counter_battlefield_plural_amount}]} */
put_counters_each_battlefield ::= "put" counter_battlefield_plural_amount counter_kind "counters" "on" "each" filter_phrase "on" "the" "battlefield"

counter_battlefield_plural_amount ::= n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10 | n11 | n12 | n13 | n14 | n15 | n20 | n30

/* Repeated drafts name the source spellbook and retain the repetition count. */
/* @sem Operation::DraftFromSpellbook{actor:One(AbilityController), spellbook:@card_name, times:$spellbook_repetitions} */
draft_source_repeated ::= "draft" "a" "card" "from" self_named "'s" "spellbook" spellbook_repetitions

spellbook_repetitions ::= spellbook_twice | spellbook_number_times

/* @sem Expr::Constant(2) */
spellbook_twice ::= "twice"

/* @sem $number */
spellbook_number_times ::= number "times"

/* The cards are the immediately preceding draft's arrivals in that player's hand. */
/* @sem Instruction::[Effect{result:@next, operation:$draft_source_repeated}, Effect{result:@next, operation:Move{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@prior, phase:After})}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
clause_draft_repeated_battlefield ::= draft_source_repeated "," "then" "put" "those" "cards" "onto" "the" "battlefield"

/* A called series and its stopping condition compose independently. */
/* @sem Operation::FlipCoinSeries{players:One(AbilityController), protocol:Called, repetition:CoinRepetition::Until($coin_series_stop)} */
flip_coin_series_until ::= "flip" "a" "coin" "until" coin_series_stop

/* @sem CoinStop::Lose */
coin_series_stop ::= "you" "lose" "a" "flip"

/* Each bound defender chooses among the piles of their own permanents. */
/* @sem Instruction::[ForEachPlayer{players:Matching{binding:0, condition:PlayerState{player:Bound(0), state:PossibleDefender}}, binding:0, body:Program{instructions:$bound_defender_pile_instructions}}] */
clause_each_defender_piles ::= "for" "each" "defending" "player" "," bound_defender_pile_instructions

/* @sem Instruction::[Effect{result:@next, operation:Piles{actor:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}, count:$count_plural}}, Effect{result:@next, operation:ChoosePile{actor:One(Bound(0))}}] */
bound_defender_pile_instructions ::= "separate" "all" filter_plural "that" "player" "controls" "into" count_plural "piles" "and" "that" "player" "chooses" "one"

/* A choice is made independently for each object from the preceding creation. */
/* @sem Operation::PutChosenCounters{objects:Created(@prior), choice:$three_counter_choice} */
put_choice_on_each_created ::= "for" "each" "of" "them" "," "put" "your" "choice" "of" three_counter_choice "on" "it"

/* @sem CounterChoice::OneOf([$counter_kind, $counter_kind_2, $counter_kind_3]) */
three_counter_choice ::= "a" counter_kind "counter" "," "a" counter_kind "counter" "," "or" "a" counter_kind "counter"

/* A postposed counter test and its explicit negative branch share one condition. */
/* @sem Instruction::[If{condition:$condition_counters_at_least, then:Program{instructions:$clause_imperative}, otherwise:Program{instructions:$clause_imperative_2}}] */
clause_counter_threshold_postposed_else ::= clause_imperative "if" condition_counters_at_least "." "if" "it" "doesn't" "," clause_imperative

/* Each choice retains its own destination; the counted population is independent. */
/* @sem CounterStep::PutThatKind($object_ref) */
counter_kind_put_step ::= "put" "another" "counter" "of" "that" "kind" "on" object_ref

/* @sem CounterStep::RemoveThatKind($object_ref) */
counter_kind_remove_step ::= "remove" "one" "from" object_ref

counter_kind_step ::= counter_kind_put_step | counter_kind_remove_step

/* @sem Operation::EachCounterKind{actor:One(AbilityController), among:$affected, options:[$counter_kind_step, $counter_kind_step_2]} */
each_counter_kind_choice ::= "for" "each" "kind" "of" "counter" "on" affected "," counter_kind_step "or" counter_kind_step

/* A flip followed by both outcome branches, in loss-first order. */
/* @sem Instruction::[Effect{result:@mark, operation:FlipCoin{player:AbilityController, protocol:@coin_protocol}}, If{condition:CoinFlip{result:@marked, outcome:Won}, then:$program_2, otherwise:$program}] */
flip_coin_lose_or_win ::= "flip" "a" "coin" "." "if" "you" "lose" "the" "flip" "," program "." "if" "you" "win" "the" "flip" "," program

/* A choice of one counter retains the source objects independently of the placement. */
/* @sem CounterSource::On(Objects(One($target_object))) */
chosen_counter_source ::= "choose" "a" "counter" "on" target_object

/* @sem Operation::DuplicateCounters{from:$chosen_counter_source, to:Objects($affected), copies:One} */
duplicate_chosen_counter ::= chosen_counter_source "." "put" "an" "additional" "counter" "of" "that" "kind" "on" affected

/* Bind the singular exile and its perpetual change together so the receipt
   cannot refer to an unrelated prior action. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_object), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:@exile_followup(One(Result{result:@prior, phase:After, index:0})), changes:$perpetual_card_type_change}}] */
instructions_exile_perpetual_type ::= "exile" target_object "." "the" "exiled" "card" "perpetually" perpetual_card_type_change

/* @sem Instruction::[...$instructions_exile_perpetual_type, ...$instructions] */
instructions_exile_perpetual_type_more ::= instructions_exile_perpetual_type "." instructions

perpetual_card_type_change ::= perpetual_becomes_enchantment | perpetual_becomes_artifact | perpetual_becomes_creature | perpetual_becomes_land

/* @sem Change::[SetCardTypes([Enchantment])] */
perpetual_becomes_enchantment ::= "becomes" "an" "enchantment"

/* @sem Change::[SetCardTypes([Artifact])] */
perpetual_becomes_artifact ::= "becomes" "an" "artifact"

/* @sem Change::[SetCardTypes([Creature])] */
perpetual_becomes_creature ::= "becomes" "a" "creature"

/* @sem Change::[SetCardTypes([Land])] */
perpetual_becomes_land ::= "becomes" "a" "land"

/* A sentence describing the populated token modifies that populate's arrival. */
/* @sem Instruction::[Effect{result:@next, operation:Populate{actor:One(AbilityController), entry:$populate_token_arrival}}] */
instructions_populate_entry ::= "populate" "." populate_token_arrival

populate_token_arrival ::= populate_token_arrival_tapped_attacking | populate_token_arrival_tapped | populate_token_arrival_attacking

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]} */
populate_token_arrival_tapped_attacking ::= "the" "token" "enters" "tapped" "and" "attacking"

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:true, counters:[], states:[]} */
populate_token_arrival_tapped ::= "the" "token" "enters" "tapped"

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[], states:[Attacking{}]} */
populate_token_arrival_attacking ::= "the" "token" "enters" "attacking"

/* Each member supplies its own characteristic; this is not a single
   property shared by the entire recipient set. */
/* @sem Operation::PutCountersEach(_{amount:$each_creature_property, kind:$counter_kind, objects:$each_counter_creature}) */
put_counters_each_creature_property ::= "put" "a" "number" "of" counter_kind "counters" "on" each_counter_creature "equal" "to" each_creature_property

/* @sem Expr::ObjectProperty{object:Affected, property:$creature_stat, information:CurrentOrLastKnown} */
each_creature_property ::= "that" "creature's" creature_stat

exchange_owned_zones ::= exchange_owned_graveyard_first | exchange_owned_hand_library

/* @sem Operation::Exchange{kind:Zones([Graveyard, $exchange_graveyard_destination]), first:Players(One($zone_your)), second:Players(One($zone_your))} */
exchange_owned_graveyard_first ::= "exchange" zone_your "graveyard" "and" exchange_graveyard_destination

exchange_graveyard_destination ::= exchange_destination_library | exchange_destination_hand

/* @sem Zone::Library */
exchange_destination_library ::= "library"

/* @sem Zone::Hand */
exchange_destination_hand ::= "hand"

/* @sem Operation::Exchange{kind:Zones([Hand, Library]), first:Players(One($zone_your)), second:Players(One($zone_your))} */
exchange_owned_hand_library ::= "exchange" zone_your "hand" "and" "library"

/* Return a linked exile population to each card's owner. */
/* @sem Operation::Move{objects:@zone_members(ObjectSet::$linked_return_cards), destination:$linked_return_destination, qualifiers:[]} */
return_linked_exile_to_owner ::= "return" linked_return_cards "to" linked_return_destination

linked_return_cards ::= linked_exiled_cards | explicit_linked_return_cards

/* @sem ObjectSet::$permission_linked_exile_cards */
explicit_linked_return_cards ::= "all" permission_linked_exile_cards

linked_return_destination ::= linked_return_graveyard | linked_return_hand

/* @sem MovementDestination::OwnersGraveyard(CardArrival{counters:[], states:[]}) */
linked_return_graveyard ::= "their" "owner's" "graveyard"

/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
linked_return_hand ::= "their" "owner's" "hand"

/* @sem Operation::FlipCoin{player:Bound(0), protocol:@coin_protocol} */
bound_coin_flip ::= "flips" "a" "coin"

/* The threshold and the number kept are the same operand. */
/* @sem Operation::DiscardAllBut{players:One(Bound(0)), keep:$card_count} */
bound_discard_excess ::= "who" "has" "more" "than" card_count "in" "hand" "discards" "cards" "equal" "to" "the" "difference"

/* The count is tied to the discard loop, not an arbitrary preceding result. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_discard_excess}]}}, If{condition:Compare{left:CountObjects(Transition{result:@prior, phase:Before}), test:NumberTest::Compare{comparison:Less, value:$card_count}}, then:$program, otherwise:Program{}}] */
instructions_excess_discard_count ::= players_singular bound_discard_excess "." "then" "if" "fewer" "than" card_count "were" "discarded" "this" "way" "," program

/* The iteration binds each attachment as "it"; the destination is chosen
   independently for that attachment by the stated actor. */
/* @sem Operation::AttachEach{actor:$attach_loop_actor, attachments:$attach_loop_attachments, count:AnyNumber, hosts:Objects($attach_destination)} */
attach_each_attachment ::= attach_loop_attachments "," attach_loop_actor "may" "attach" "it" "to" attach_destination

/* @sem ObjectSet::$affected */
attach_loop_attachments ::= "for" affected

attach_destination ::= attach_destination_a | attach_destination_an

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase} */
attach_destination_a ::= "a" filter_phrase

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase} */
attach_destination_an ::= "an" filter_phrase

/* Keep the discard producer and the aggregate receipt consumer in one scope. */
/* @sem Instruction::[$opponent_discard_excess, $discard_fewer_followup] */
instructions_opponent_discard_threshold ::= opponent_discard_excess "." discard_fewer_followup

/* @sem Instruction::ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@mark, operation:DiscardAllBut{players:One(Bound(0)), keep:$card_count}}]}} */
opponent_discard_excess ::= "each" "opponent" "who" "has" "more" "than" card_count "in" "hand" "discards" "cards" "equal" "to" "the" "difference"

/* @sem Instruction::If{condition:Compare{left:CountObjects(Transition{result:@marked, phase:Before}), test:NumberTest::Compare{comparison:Less, value:$card_count}}, then:$program, otherwise:Program{}} */
discard_fewer_followup ::= "then" "if" "fewer" "than" card_count "were" "discarded" "this" "way" "," program

/* The condition supplies the population named by "them". Keep both uses of
   that population in one scoped template, including during inverse printing. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, filter:Not($subtype_plural)}), test:Compare{comparison:Equal, value:Constant(0)}}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}), kind:$counter_kind, amount:All}]}}]}} */
triggered_all_population_remove_counters ::= "at" turn_event "," "if" "all" filter_plural "on" "the" "battlefield" "are" subtype_plural "," "remove" "all" counter_kind "counters" "from" "them" "."

/* The selected population and the removal receipt remain independent of the
   later recipient and counter placed.  The receipt names lore counters. */
/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:Named(LoreCounter), amount:Count(Exactly(Constant(1))), selection:_{player:AbilityController, count:AnyNumber}}]} */
remove_lore_from_selected_population ::= "you" "may" "remove" "a" "lore" "counter" "from" "each" "of" "any" "number" "of" affected

/* @sem Instruction::[Effect{result:@mark, operation:$remove_lore_from_selected_population}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:CountersRemoved(@marked)}]}}] */
instructions_remove_lore_place_per_removed ::= remove_lore_from_selected_population "." "put" "a" counter_kind "counter" "on" affected "for" "each" "lore" "counter" "removed" "this" "way"

/* X belongs to the referenced object; the other recipients share a battlefield population. */
/* @sem Operation::DistributeCounters(_{amount:CastX($object_ref), kind:$counter_kind, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($object_ref), $filter_plural])}, any_number:true}) */
distribute_cast_x_among_ref_and_population ::= "distribute" "X" counter_kind "counters" "among" object_ref "and" "any" "number" "of" filter_plural

/* The opponent's choice is established by the subsequent pile instruction. */
/* @sem Instruction::[Effect{result:@next, operation:SeparatePiles{separator:AbilityController, chooser:OneOf(OpponentsOf(AbilityController)), objects:$personal_graveyard_filtered_cards}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Unselected(@back(3)), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
instructions_separate_opponent_piles ::= "separate" personal_graveyard_filtered_cards "into" "two" "piles" "." "exile" "the" "pile" "of" "an" "opponent's" "choice" "and" "return" "the" "other" "to" "the" "battlefield"

/* A required control change and its success branch share the acting player. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:$player_ref, cost:Cost{parts:[PlayerAction{player:$player_ref, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($object_set), changes:[SetController($player_ref)], duration:Indefinite, evaluation:Snapshot}}]}}]}, optional:false}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_control_if_they_do ::= player_ref "gains" "control" "of" object_set "." "if" "they" "do" "," conjoined

/* The returned-land condition is only exposed within this complete activation:
   the single returned land is the sole return producer before the condition. */
/* @sem Ability::Activated{origin:Ordinary, cost:$returned_land_activation_cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[...$clause_loot, If{condition:Not($returned_land_nonbasic_condition), then:$program, otherwise:Program{}}]}} */
activated_returned_land_draw_unless ::= returned_land_activation_cost ":" clause_loot "." "then" program "unless" returned_land_nonbasic_condition "."

/* @sem Cost::Cost{parts:[TapSymbol, Move{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Land), ControlledBy(One(AbilityController))])}, choose:Exactly(Constant(1))}], destination:OwnersHand(CardArrival{})}]} */
returned_land_activation_cost ::= "{T}" "," "↑" "return" "a" "land" "you" "control" "to" "its" "owner's" "hand"

/* @sem Condition::Compare{left:Earlier{what:Returned, measure:Count, filter:State(NonBasicLandType)}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
returned_land_nonbasic_condition ::= "that" "land" "had" "a" "nonbasic" "land" "type"

/* The additional payment belongs to this counter instruction and retains both prices. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf($target_stack_spell), cost:$counter_extra_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@next_slot, index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}] */
clause_counter_unless_extra ::= "counter" target_stack_spell "unless" "its" "controller" "pays" counter_extra_cost

counter_extra_cost ::= counter_extra_count | counter_extra_population

/* @sem Cost::Cost{parts:[Mana($mana_symbols), Repeated{part:Mana($mana_symbols_2), times:$count_each}]} */
counter_extra_count ::= mana_symbols "plus" "an" "additional" mana_symbols "for" "each" count_each

/* @sem Cost::Cost{parts:[Mana($mana_symbols), Repeated{part:Mana($mana_symbols_2), times:CountObjects($affected)}]} */
counter_extra_population ::= mana_symbols "plus" "an" "additional" mana_symbols "for" affected

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:State(HasX)}), index:0} */
counter_x_spell ::= "target" "spell" "with" "{" "X" "}" "in" "its" "mana" "cost"

/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf($counter_x_spell), cost:$resolving_cost_announced, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@next_slot, index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}] */
clause_counter_unless_x_spell ::= "counter" counter_x_spell "unless" "its" "controller" "pays" resolving_cost_announced

/* The explicit anaphor and payment choice are scoped to a spell counter. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf($target_stack_spell), cost:$counter_choice_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@next_slot, index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}] */
clause_counter_unless_that_spell ::= "counter" target_stack_spell "unless" "that" "spell's" "controller" "pays" counter_choice_cost

/* @sem Cost::Cost{parts:[Choice([$cost, $cost_2])]} */
counter_choice_cost ::= cost "or" cost

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Ability, zones:[Stack]}), count:Exactly(Constant(1)), filter:AllOf([$counter_ability_kind, AbilityOf($counter_source_filter)])}), index:0} */
counter_sourced_ability_target ::= "target" counter_ability_kind "ability" "from" counter_source_filter "source"

/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf($counter_sourced_ability_target), cost:$resolving_cost_announced, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@next_slot, index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}] */
clause_counter_unless_that_ability ::= "counter" counter_sourced_ability_target "unless" "that" "ability's" "controller" "pays" resolving_cost_announced

/* A delayed consequence retains the affected player in all three roles. */
/* @sem Operation::DelayedUnlessPaid{event:Term{family:FutureTrigger, form:AtTheBeginningOfPlayersNextDrawStep, operands:[Player($player_ref)]}, body:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One($player_ref), amount:$value}}]}, payer:$player_ref, mana:$delayed_draw_payment} */
delayed_draw_life ::= player_ref "loses" value "life" "at" "the" "beginning" "of" "their" "next" "draw" "step" "unless" "they" "pay" delayed_draw_payment

delayed_draw_payment ::= delayed_draw_payment_one | delayed_draw_payment_step_two | delayed_payment_draw

/* @sem Operand::List([Term{family:ManaSymbol, form:ManaCostGeneric, operands:[Integer(1)]}]) */
delayed_draw_payment_one ::= "{" "1" "}" "before" "that" "draw" "step"

/* A scoped two-mana spelling keeps the two draw-step forms distinct on print. */
/* @sem Operand::List([Term{family:ManaSymbol, form:ManaCostGeneric, operands:[Integer(2)]}]) */
delayed_draw_payment_step_two ::= "{" "2" "}" "before" "that" "step"

/* @sem Operand::List([Term{family:ManaSymbol, form:ManaCostGeneric, operands:[Integer($number)]}]) */
delayed_payment_step ::= "{" NUMBER "}" "before" "that" "step"

/* @sem Operand::List([Term{family:ManaSymbol, form:ManaCostGeneric, operands:[Integer($number)]}]) */
delayed_payment_draw ::= "{" NUMBER "}" "before" "that" "draw" "step"

/* The second sentence refers to the player previously dealt damage. */
/* @sem Operation::DelayedUnlessPaid{event:Term{family:FutureTrigger, form:AtTheBeginningOfPlayersNextUpkeep, operands:[Player(EventSubject)]}, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Players(One(EventSubject)), kind:$counter_kind, amount:Constant(1)}]}}]}, payer:EventSubject, mana:$delayed_payment_step} */
delayed_upkeep_counter ::= "the" "player" "gets" "another" counter_kind "counter" "at" "the" "beginning" "of" "their" "next" "upkeep" "unless" "they" "pay" delayed_payment_step

/* One selection across both private zones, followed by an owner-controlled entry.
   The count and zone order are kept together for deterministic inverse spelling. */
/* @sem Operation::WithSelections{steps:[$private_entry_selection], action:Move{objects:Prepared(@selection_id(0)), destination:Battlefield{controller:Owner, arrival:$private_entry_arrival}, qualifiers:[]}} */
put_selected_private_cards ::= "put" private_entry_selection "onto" "the" "battlefield" private_entry_arrival

private_entry_selection ::= private_entry_any | private_entry_upto

/* @sem SelectionStep::_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Union([Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase})]), count:AnyNumber, constraints:[]} */
private_entry_any ::= "any" "number" "of" filter_phrase "cards" "from" "your" "graveyard" "and" "/" "or" "hand"

/* @sem SelectionStep::_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Union([Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase})]), count:UpTo($number), constraints:[]} */
private_entry_upto ::= "up" "to" number filter_phrase "cards" "from" "your" "hand" "and" "/" "or" "graveyard"

private_entry_arrival ::= private_entry_tapped | private_entry_attached

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:true, counters:[], states:[]} */
private_entry_tapped ::= "tapped"

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo($object_ref)]} */
private_entry_attached ::= "attached" "to" object_ref

/* A linked free play with a postposed history requirement. The predicate is
   scoped here so its spelling does not compete with unrelated conditions. */
/* @sem Instruction::[If{condition:$linked_play_history, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$play_free}]}}]}, otherwise:Program{}}] */
instructions_linked_play_history ::= "you" "may" play_free "if" linked_play_history

linked_play_history ::= linked_play_opponent_damage | linked_play_attacked_with

/* @sem Condition::ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:Compare{left:EventHistory{event:Damage(_{source_kind:Any, sources:Any, recipients:Players(One(Bound(0))), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}} */
linked_play_opponent_damage ::= "an" "opponent" "was" "dealt" value "or" "more" "damage" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:Object{event:Attacks, objects:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
linked_play_attacked_with ::= "you" "attacked" "with" value "or" "more" filter_plural "this" "turn"

/* A target selection is distributed between a conditional return and an
   opponent's choice of cards to leave behind. */
/* @sem Instruction::[If{condition:$condition, then:_{instructions:[Effect{result:@next, operation:Move{objects:$partition_graveyard_targets, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:OneOf(OpponentsOf(AbilityController)), objects:$partition_graveyard_targets, count:AsManyAsCan($partition_opponent_count)}}, Effect{result:@next, operation:Move{objects:Unselected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
instructions_graveyard_target_partition ::= "choose" partition_graveyard_targets "." "if" condition "," "return" "those" "cards" "to" "your" "hand" "." "otherwise" "," partition_opponent_count

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo($number), filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})})) */
partition_graveyard_targets ::= "up" "to" number "target" "cards" "in" "your" "graveyard"

/* @sem $value */
partition_opponent_count ::= "an" "opponent" "chooses" value "of" "them" "." "leave" "the" "chosen" "cards" "in" "your" "graveyard" "and" "put" "the" "rest" "into" "your" "hand"

/* The explicit owner pronoun keeps the return's print shape local to this
   sequence while the prevention phrase remains independently reusable. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, ...$instructions_prevent_chosen_source] */
instructions_return_card_prevent_source ::= "return" target_card "to" "their" "hand" "." instructions_prevent_chosen_source

/* @sem PlayerRef::OwnerOf(Query{objects:Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}, index:0}) */
linked_exiled_card_owner ::= "the" "exiled" "card's" "owner"

/* @sem Operation::Keyword{actor:One($linked_exiled_card_owner), action:KeywordAction::ManifestDread{}} */
linked_card_owner_manifests_dread ::= linked_exiled_card_owner "manifests" "dread"

/* @sem Operation::Keyword{actor:One($player_ref), action:KeywordAction::ManifestDread{}} */
player_manifests_dread ::= player_ref "manifests" "dread"

/* A plural count retains its amount while selecting plural wording. */
/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:Count(Exactly(@plural_amount($number_words)))}]} */
remove_plural_counters_from_affected ::= "remove" number_words counter_kind "counters" "from" affected

/* The first sentence fixes the stack target; the second restricts its new target. */
/* @sem Instruction::[Effect{result:@next, operation:Retarget{actor:One(AbilityController), object:$retarget_player_only_spell, targets:ToPlayers(All)}}] */
clause_retarget_player_destination ::= "change" "the" "target" "of" retarget_player_only_spell "." "the" "new" "target" "must" "be" "a" "player"

/* Optional retargeting preserves the target spell and allows its choices to remain. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Retarget{actor:One(AbilityController), object:$retarget_many_stack_object, targets:May}}]}}] */
clause_retarget_optional_stack ::= "you" "may" "choose" "new" "targets" "for" retarget_many_stack_object

/* The follow-up is inside the same declined-payment branch and refers to
   the controller of the spell announced by this clause. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf($target_stack_spell), cost:$counter_unless_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@next_slot, index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}, ...$declining_controller_actions]}, otherwise:Program{}}] */
counter_unless_controller_declines ::= "counter" target_stack_spell "unless" "its" "controller" "pays" counter_unless_cost "." "if" "that" "player" "doesn't" "," "they" declining_controller_actions

/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$plural, HasActivatedAbility(Mana), ControlledBy(One(ControllerOf(Target{slot:@last_slot, index:0})))])}, tapped:true}}, Effect{result:@next, operation:Keyword{actor:One(ControllerOf(Target{slot:@last_slot, index:0})), action:KeywordAction::LoseUnspentMana}}] */
declining_controller_actions ::= "tap" "all" plural "with" "mana" "abilities" "they" "control" "and" "lose" "all" "unspent" "mana"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:Any}), index:0} */
choose_new_targets_plain_spell ::= "target" "spell"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Ability, zones:[Stack]}), count:Exactly(Constant(1)), filter:Any}), index:0} */
choose_new_targets_plain_ability ::= "target" "ability"

choose_new_targets_plain_stack_object ::= retarget_spell_or_ability | choose_new_targets_plain_spell | choose_new_targets_plain_ability

/* @sem Operation::Retarget{actor:One(AbilityController), object:$choose_new_targets_plain_stack_object, targets:Must} */
retarget_choose_new_unqualified ::= "choose" "new" "targets" "for" choose_new_targets_plain_stack_object

/* A random subset of announced targets is selected before the action. */
/* @sem Instruction::[Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), objects:$objects_targets_plain, chooser:Chance, count:AsManyAsCan($value)}], action:$random_selected_action}}] */
instructions_random_target_subset ::= "choose" objects_targets_plain "." random_selected_action value "of" "them" "at" "random"

random_selected_action ::= random_selected_destroy | random_selected_tap

/* @sem Operation::Destroy{objects:Prepared(@selection_id(0)), regeneration:true} */
random_selected_destroy ::= "destroy"

/* @sem Operation::SetTapped{objects:Prepared(@selection_id(0)), tapped:true} */
random_selected_tap ::= "tap"

/* @sem Operation::DuplicateCounters{from:CounterSource::On(Objects($counter_kind_source_population)), to:Objects($counter_kind_other_population), copies:One} */
duplicate_chosen_counter_kind ::= "choose" "a" "kind" "of" "counter" "on" counter_kind_source_population "." "put" "a" "counter" "of" "that" "kind" "on" counter_kind_other_population

/* Keep the damage producer and its delayed death trigger in one contract. */
/* @sem Instruction::[Effect{result:@next, operation:$deal_damage}, Effect{result:@next, operation:CreateTrigger{event:$event_controlled_damaged_this_way_dies, duration:$this_duration, announcement:@announcement, body:$program}}] */
instructions_damage_controlled_death ::= deal_damage "." "whenever" event_controlled_damaged_this_way_dies this_duration "," program

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$instructions_damage_controlled_death]}} */
spell_damage_controlled_death ::= instructions_damage_controlled_death "."

/* Keep the target announcement and its anaphoric life comparison in one
   printable sequence, while retaining the source, amount and branch operands. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:Source, recipients:$recipients_player_or_walker, amount:$number, preventable:true}}, If{condition:$condition_target_player_or_walker_life, then:$program, otherwise:Program{}}] */
instructions_damage_target_life_followup ::= self_named "deals" number "damage" "to" recipients_player_or_walker "." "then" "if" condition_target_player_or_walker_life "," program

/* A named spell announces its damage target before the comparison reads it. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_damage_target_life_followup}} */
spell_damage_target_life_followup ::= instructions_damage_target_life_followup "."

/* The stored mana type and amount are one production operand. */
/* @sem ManaProduction::LastNoted{amount:true} */
mana_last_noted_amount ::= "this" "artifact's" "last" "noted" "type" "and" "amount" "of" "mana"

/* This linked-card selection keeps the source and spell filter independent. */
/* @sem Instruction::Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}), filter:AnyOf([$filter_phrase, CardType(Instant), CardType(Sorcery)])}, count:Exactly($counter_amount), cost:Free}}]}} */
optional_cast_linked_three_types ::= "you" "may" "cast" counter_amount filter_phrase "," "instant" "," "or" "sorcery" "spell" "from" "among" "cards" "exiled" "with" object_ref "without" "paying" "its" "mana" "cost"

/* A life auction has a shared bidding procedure and a shared winner payment.
   Its initial offer and its prize remain independently represented. */
/* @sem $value */
bid_fixed_start ::= "you" "start" "the" "bidding" "with" "a" "bid" "of" value "."

/* @sem Instruction::Effect{result:@next, operation:LoseLife{players:One(Prior(WinningBidder)), amount:Game(WinningBid)}} */
bid_winner_payment ::= "in" "turn" "order" "," "each" "player" "may" "top" "the" "high" "bid" "." "the" "bidding" "ends" "if" "the" "high" "bid" "stands" "." "the" "high" "bidder" "loses" "life" "equal" "to" "the" "high" "bid"

/* @sem Instruction::[Effect{result:@next, operation:Bid{players:$players_singular, start:$bid_fixed_start}}, $bid_winner_payment, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($bid_creature_target)), changes:[SetController(Prior(WinningBidder))], duration:Indefinite, evaluation:Snapshot}}] */
instructions_bid_control ::= players_singular "may" "bid" "life" "for" "control" "of" bid_creature_target "." bid_fixed_start bid_winner_payment "and" "gains" "control" "of" "the" "creature"

/* @sem Instruction::[Effect{result:@next, operation:Bid{players:$players_singular}}, $bid_winner_payment, Effect{result:@next, operation:Draw{players:One(Prior(WinningBidder)), amount:$card_count}}] */
instructions_bid_draw ::= players_singular "may" "bid" "life" "." "you" "start" "the" "bidding" "with" "a" "bid" "of" "any" "number" "." bid_winner_payment "and" "draws" card_count

/* The repeated noun proves a creature target, rather than an arbitrary affected set. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0} */
bid_creature_target ::= "target" "creature"

/* The willing player makes one sacrifice payment before its dependent program. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:FirstWilling(All), cost:$willing_sacrifice_cost, optional:true}}, If{condition:$willing_payment_condition, then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_first_willing_sacrifice ::= "any" "player" "may" willing_sacrifice_cost "." willing_payment_condition "," conjoined

willing_sacrifice_cost ::= willing_sacrifice_one | willing_sacrifice_one_an | willing_sacrifice_many

/* @sem Cost::Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly(Constant(1))}]} */
willing_sacrifice_one ::= "sacrifice" "a" filter_phrase "of" "their" "choice"

/* @sem Cost::Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly(Constant(1))}]} */
willing_sacrifice_one_an ::= "sacrifice" "an" filter_phrase "of" "their" "choice"

/* @sem Cost::Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:Exactly($number)}]} */
willing_sacrifice_many ::= "sacrifice" number filter_plural "of" "their" "choice"

/* @sem Operation::ChooseAtRandom(_{kind:Number, options:[Integer($number), Integer($number_2), Integer($number_3)]}) */
random_number_choice_three ::= "choose" NUMBER "," NUMBER "," "or" NUMBER "at" "random"

/* The two counter choices share the printed destination. */
/* @sem Vec<CounterStep>::[Put([$counter_kind, $object_ref]), PutThatKind($object_ref)] */
counter_kind_or_same_choice ::= "your" "choice" "of" "a" counter_kind "counter" "or" "a" "counter" "of" "that" "kind" "on" object_ref

/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:EachCounterKind{actor:One(AbilityController), among:$affected, options:$counter_kind_or_same_choice, optional:true}}]}}] */
clause_each_counter_kind_choice ::= "for" "each" "kind" "of" "counter" "on" affected "," "you" "may" "put" counter_kind_or_same_choice

/* A singular object's own library follows that object, independent of its controller. */
/* @sem Operation::Move{objects:One($object_ref), destination:Library{position:$owner_library_position, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
move_object_owners_library ::= "put" object_ref owner_library_position "of" "its" "owner's" "library"

owner_library_position ::= owner_library_top | owner_library_bottom

/* @sem LibraryPosition::Top */
owner_library_top ::= "on" "top"

/* @sem LibraryPosition::Bottom */
owner_library_bottom ::= "on" "the" "bottom"

/* Capture the group before tapping it and giving that same group to an opponent. */
/* @sem Instruction::[Effect{result:@mark, operation:NoteObjects{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($object_ref), AllOf([$filter_plural, Name($referenced_card_name)])])}}}, Effect{result:@next, operation:SetTapped{objects:Selected(@marked), tapped:true}}, Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Player, terms:_{count:Exactly(Constant(1)), options:[Players(OpponentsOf(AbilityController))]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:$object_ref, affected:Objects(Selected(@marked)), changes:[SetController(Chosen)], duration:Indefinite, evaluation:Snapshot}}] */
tap_named_group_opponent_control ::= "tap" object_ref "and" "all" filter_plural "named" referenced_card_name "," "then" "an" "opponent" "gains" "control" "of" "them"

/* Only used under the spell-targeting event that supplies EventAmount. */
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:EventAmount}}] */
target_count_instructions ::= "draw" "that" "many" "cards"

/* Called coin series can be used by player-action payments. */
cost_coin_series ::= cost_coin_series_one | cost_coin_series_many

/* @sem Operation::FlipCoinSeries{players:One(AbilityController), protocol:Called, repetition:CoinRepetition::Count(Constant(1))} */
cost_coin_series_one ::= "flip" "a" "coin"

/* @sem Operation::FlipCoinSeries{players:One(AbilityController), protocol:Called, repetition:CoinRepetition::Count(@plural_amount($number))} */
cost_coin_series_many ::= "flip" number "coins"

/* @sem Operand::Term{family:AttachAction, form:ChooseAnExiledCardToCopy, operands:[Objects($craft_exiled_filtered_card)]} */
attachment_choose_craft_card ::= "choose" craft_exiled_filtered_card

/* The count and recipient use the same bound player in the enclosing loop. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}) */
bound_player_controlled_count ::= "the" "number" "of" filter_plural "they" "control"

/* @sem PlayerSet::All */
possessive_each_player ::= "each" "player's"

/* @sem PlayerSet::OpponentsOf(PlayerRef::AbilityController) */
possessive_each_opponent ::= "each" "opponent's"

possessive_loop_players ::= possessive_each_player | possessive_each_opponent

/* @sem Instruction::[ForEachPlayer{players:$possessive_loop_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:SetLifeTotal{players:One(Bound(0)), amount:$bound_player_controlled_count}}]}}] */
clause_each_life_total_controlled_count ::= possessive_loop_players "life" "total" "becomes" bound_player_controlled_count

/* The choice and placement share the same source creature. */
/* @sem Instruction::[Effect{result:@next, operation:PutChosenCounters{objects:One(@self), choice:RandomMissing($random_missing_counter_list)}}] */
instructions_random_missing_counter ::= "choose" "a" "kind" "of" "counter" "at" "random" "that" self_creature "doesn't" "have" "on" "it" "from" "among" random_missing_counter_list "." "put" "a" "counter" "of" "that" "kind" "on" self_creature

/* @sem CounterKind::[$counter_kind, ...$random_missing_counter_tail] */
random_missing_counter_list ::= counter_kind "," random_missing_counter_tail

random_missing_counter_tail ::= random_missing_counter_last | random_missing_counter_more

/* @sem CounterKind::[$counter_kind] */
random_missing_counter_last ::= "and" counter_kind

/* @sem CounterKind::[$counter_kind, ...$random_missing_counter_tail] */
random_missing_counter_more ::= counter_kind "," random_missing_counter_tail

/* The condition and both branches share the exact single-card exile receipt. */
/* @sem Instruction::[...$card_exile_value_producer, If{condition:$condition_exiled_top_card_type, then:Program{instructions:$clause}, otherwise:Program{instructions:$clause_2}}] */
instructions_exile_top_card_type_branches ::= card_exile_value_producer "." "if" condition_exiled_top_card_type "," clause "." "otherwise" "," clause

/* A single selected card can have different follow-ups; the hand owner and
   selected-card count remain operands shared by each follow-up. */
/* @sem Operation::PickFromHand{actor:One(AbilityController), player:$target_possessive, filter:Any, count:Exactly($hand_pick_single_choice), then:$hand_pick_single_followup} */
hand_pick_single ::= "look" "at" target_possessive "hand" "and" hand_pick_single_choice "." hand_pick_single_followup

/* @sem $card_count_one */
hand_pick_single_choice ::= "choose" card_count_one "from" "it"

hand_pick_single_followup ::= hand_pick_library_single | hand_pick_controlled_play

/* @sem HandPick::TopOfLibrary */
hand_pick_library_single ::= "put" "it" "on" "top" "of" "that" "player's" "library"

/* This outcome includes the complete controlled-play restrictions. */
/* @sem HandPick::TheyPlayIt */
hand_pick_controlled_play ::= "you" "control" "that" "player" "until" SELF_NAME "finishes" "resolving" "." "the" "player" "plays" "that" "card" "if" "able" "." "while" "doing" "so" "," "the" "player" "can" "activate" "mana" "abilities" "only" "if" "they're" "from" "lands" "that" "player" "controls" "and" "only" "if" "mana" "they" "produce" "is" "spent" "to" "activate" "other" "mana" "abilities" "of" "lands" "the" "player" "controls" "and" "/" "or" "to" "play" "that" "card" "." "if" "the" "chosen" "card" "is" "cast" "as" "a" "spell" "," "you" "control" "the" "player" "while" "that" "spell" "is" "resolving"

/* The other-player reference is valid only for this two-player reveal producer.
   Keeping the producer in the same instruction span also proves the receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:LibraryTops(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(2)), filter:Any, players:All})))}}, ForEachPlayer{players:Targets(0), binding:0, body:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(Bound(0)), amount:Aggregate{objects:Matching{objects:Recorded(@marked), filter:OwnedBy(OthersThan(Bound(0)))}, property:$stat, aggregation:Sum}}}]}}] */
instructions_two_reveals_other_loss ::= "two" "target" "players" "each" "reveal" "the" "top" "card" "of" "their" "library" "." "they" "each" "lose" "life" "equal" "to" "the" stat "of" "the" "card" "revealed" "by" "the" "other" "player"

/* The intervening life loss cannot move a revealed library card. */
/* @sem Instruction::[...$instructions_two_reveals_other_loss, ForEachPlayer{players:Targets(0), binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
instructions_two_reveals_other_loss_hand ::= instructions_two_reveals_other_loss "." "then" "they" "each" "put" "the" "card" "they" "revealed" "into" "their" "hand"

/* The card group and the shuffled destination are shared operands of conjuring. */
/* @sem Operation::Conjure{actor:One(AbilityController), card:$conjure_card_group, count:Constant(1), destination:$conjure_shuffled_library} */
conjure_each_shuffled_library ::= "conjure" conjure_card_group conjure_shuffled_library

/* An unpaid action retains its own actor and result within the payment branch. */
/* @sem Operation::AnyPlayerMayPay{players:All, mana:$kicker_operands, unpaid:[Program{instructions:[Effect{result:@next, operation:$sacrifice_objects}]}], paid:[Program{}]} */
sacrifice_unless_any_player_pays ::= sacrifice_objects "unless" "any" "player" "pays" kicker_operands

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:One($linked_exiled_card), count:Exactly(Constant(1)), cost:Free} */
cast_source_linked_exiled_card ::= "cast" linked_exiled_card "without" "paying" "its" "mana" "cost"

/* Turn the selected permanents face down with the stated creature characteristics. */
/* @sem Operation::TurnFaceDownAs{objects:$objects_targets_plain, as_creature:_{power:$number_digits, toughness:$number_digits_2, creature_type:@subtype_name($subtype)}} */
turn_targets_face_down_creatures ::= "turn" objects_targets_plain "face" "down" "." "they're" number_digits "/" number_digits subtype "creatures"

/* A required return can be paid with a card matching either alternative. */
/* @sem Cost::Cost{parts:[Move{selections:[_{objects:$payment_graveyard_card_union, choose:Exactly(Constant(1))}], destination:OwnersHand(CardArrival{counters:[], states:[]})}]} */
payment_return_graveyard_union ::= "return" "a" payment_graveyard_card_union "from" "your" "graveyard" "to" "your" "hand"

/* Both actions share the receipt of a duplicate conjured into your hand. */
/* @sem Instruction::[Effect{result:@next, operation:$conjure_duplicate_hand}, Effect{result:@next, operation:@manifest_result(Operation::Manifest{actor:One(AbilityController), source:Cards(Matching{objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), filter:InSet(Transition{result:@prior, phase:After})}), entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
instructions_conjure_manifest_duplicates ::= conjure_duplicate_hand "," "then" "manifest" "those" "duplicates"

/* Both populations refer to the first announced object, including its controller. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamageParts{source:$damage_source_ref, parts:[_{recipients:Objects(One($target_permanent)), amount:$number}, _{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Target{slot:@last_slot, index:0})), $filter_head, ControlledBy(One(ControllerOf(Target{slot:@last_slot, index:0})))])}), amount:$number_2}], preventable:true}}] */
clause_damage_same_controller ::= damage_source_ref "deals" number "damage" "to" target_permanent "and" number "damage" "to" "each" "other" filter_head "with" "the" "same" "controller"

/* Graveyard casting composes the card filter independently of the cast action. */
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$card_filter} */
cast_graveyard_filtered_cards ::= card_filter "cards" "from" "your" "graveyard"

/* @sem Operation::PlayWith{actor:One(AbilityController), action:CastSpell, cards:$cast_graveyard_filtered_cards, count:AnyNumber, terms:_{cost:Free}} */
cast_free_graveyard_many ::= "cast" "any" "number" "of" cast_graveyard_filtered_cards "without" "paying" "their" "mana" "costs"

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:@and($card_filter, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$cast_bound_value}})} */
cast_graveyard_bounded_spell ::= card_filter "spell" "from" "your" "graveyard" "with" "mana" "value" "less" "than" "or" "equal" "to" cast_bound_value

cast_bound_value ::= value | cast_bound_spell_value

/* @sem Expr::ObjectProperty{object:$spell_possessive, property:ManaValue, information:CurrentOrLastKnown} */
cast_bound_spell_value ::= spell_possessive "mana" "value"

/* @sem Operation::PlayWith{actor:One(AbilityController), action:CastSpell, cards:$cast_graveyard_bounded_spell, count:Exactly($counter_amount), terms:_{cost:Free}} */
cast_free_graveyard_bounded_spell ::= "cast" counter_amount cast_graveyard_bounded_spell "without" "paying" "its" "mana" "cost"

/* The selected card and its graveyard owner are supplied by the target phrase. */
/* @sem Operation::PlayWith{actor:One(AbilityController), action:CastSpell, cards:One($target_card), count:UpTo(Constant(1)), terms:_{cost:Normal, spend_as:AnyType}} */
cast_target_with_any_mana ::= "you" "may" "cast" target_card "," "and" "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "that" "spell"

/* Conjured cards retain their named identity, quantity and destination. */
/* @sem Operation::Conjure{actor:One(AbilityController), card:Named($referenced_other_card_name), count:$card_count, destination:Graveyard(CardArrival{counters:[], states:[]})} */
conjure_named_graveyard ::= "conjure" card_count "named" referenced_other_card_name "into" "your" "graveyard"

/* An explicitly selected duplicate retains its owner independently. */
/* @sem Operation::Conjure{actor:One(AbilityController), card:Duplicate($affected), count:$counter_amount, owner:AbilityController, destination:Graveyard(CardArrival{counters:[], states:[]})} */
conjure_duplicate_graveyard ::= "conjure" counter_amount "duplicate" "of" affected "into" "your" "graveyard"

/* The prior sacrifice supplies the before-transition object. */
/* @sem Operation::Conjure{actor:One(AbilityController), card:Duplicate(Transition{result:@prior, phase:Before}), count:$counter_amount, destination:Graveyard(CardArrival{counters:[], states:[]})} */
conjure_sacrificed_duplicate_graveyard ::= "for" "each" "creature" "sacrificed" "this" "way" "," "conjure" counter_amount "duplicate" "of" "it" "into" "your" "graveyard"

/* Return linked exile populations with their current filters and anchor. */
return_scoped_exiled_population ::= linked_exiled_each | linked_exiled_all | linked_exiled_filtered_each | exiled_with_counters | linked_exiled_other_permanents

return_scoped_exiled_each_population ::= linked_exiled_each | linked_exiled_filtered_each

return_scoped_exiled_plural_population ::= linked_exiled_all | exiled_with_counters | linked_exiled_other_permanents

/* @sem Operation::Move{objects:@zone_members($return_scoped_exiled_population), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_scoped_exiled_yours ::= "return" return_scoped_exiled_population "to" "the" "battlefield" "under" "your" "control"

/* @sem Operation::Move{objects:@zone_members($return_scoped_exiled_each_population), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_scoped_exiled_owner_each ::= "return" return_scoped_exiled_each_population "to" "the" "battlefield" "under" "its" "owner's" "control"

/* @sem Operation::Move{objects:@zone_members($return_scoped_exiled_plural_population), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_scoped_exiled_owner_plural ::= "return" return_scoped_exiled_plural_population "to" "the" "battlefield" "under" "their" "owners'" "control"

/* These bodies share the controller and attachment established by the header. */
aura_upkeep_creature_body ::= aura_upkeep_sacrifice_mana | aura_upkeep_pay_untap | aura_upkeep_prevent_damage

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:EventSubject, cost:_{parts:[Mana($mana_symbols)]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(EventSubject), objects:One(EventSubject)})}]}, otherwise:_{}}]} */
aura_upkeep_sacrifice_mana ::= "that" "player" "sacrifices" "that" "creature" "unless" "they" "pay" mana_symbols

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:EventSubject, cost:_{parts:[Mana($mana_symbols)]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:_{instructions:[Effect{result:@next, operation:SetTapped{objects:One(EventSubject)}}]}, otherwise:_{}}]} */
aura_upkeep_pay_untap ::= "that" "player" "may" "pay" mana_symbols "." "if" "the" "player" "does" "," "untap" "that" "creature"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayAnyAmount{actor:One(EventSubject), resource:Mana}}, Effect{result:@next, operation:DealDamageWith{source:Source, recipients:Players(One(EventSubject)), amount:$number, rider:Prevented(Performed(@prior))}}]} */
aura_upkeep_prevent_damage ::= "that" "player" "may" "pay" "any" "amount" "of" "mana" "." "this" "Aura" "deals" number "damage" "to" "that" "player" "." "prevent" "X" "of" "that" "damage" "," "where" "X" "is" "the" "amount" "of" "mana" "that" "player" "paid" "this" "way"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:EventSubject, cost:_{parts:[Sacrifice{objects:One(EventSubject)}]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(One(EventSubject)), amount:$number, preventable:true}}]}, otherwise:_{}}]} */
aura_upkeep_artifact_body ::= "this" "Aura" "deals" number "damage" "to" "that" "player" "unless" "they" "sacrifice" "that" "artifact"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:EventSubject, cost:_{parts:[Choice([_{parts:[Mana($mana_symbols)]}, _{parts:[Life($number)]}])]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:_{instructions:[Effect{result:@next, operation:Destroy{objects:One(EventSubject), regeneration:true}}]}, otherwise:_{}}]} */
aura_upkeep_land_body ::= "destroy" "that" "land" "unless" "that" "player" "pays" mana_symbols "or" number "life"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:EventSubject, cost:_{parts:[ManaWithX{mana:[X], x:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(EventSubject), objects:One(EventSubject)})}]}, otherwise:_{}}]} */
aura_upkeep_permanent_body ::= "that" "player" "sacrifices" "it" "unless" "they" "pay" "{" "X" "}" "," "where" "X" "is" "its" "mana" "value"

/* Scoped combat-phase sequence: each clause retains its own effect identity. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(OpponentsOf(AbilityController)), changes:[PlayerRule(Prohibit(CastSpell{filter:Any}))], duration:$this_duration, evaluation:LiveObjects}}] */
combat_opponents_cannot_cast ::= "your" "opponents" "can't" "cast" "spells" this_duration

/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::EndCombat}}] */
combat_end_phase ::= "end" "the" "combat" "phase"

/* @sem Instruction::[...$combat_opponents_cannot_cast, ...$combat_end_phase] */
combat_cast_prohibition_then_end ::= combat_opponents_cannot_cast "." NEWLINE combat_end_phase

/* A choice of two base-stat settings and the option to leave them unchanged. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[SetBasePowerToughness{power:$value, toughness:$value_2}], duration:EndOfTurn, evaluation:Snapshot}}]} */
self_base_stat_option ::= value "/" value

/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[$self_base_stat_option, $self_base_stat_option_2, _{}]}] */
choose_self_base_stats ::= "you" "may" "have" "this" "creature's" "base" "power" "and" "toughness" "become" self_base_stat_option "or" self_base_stat_option "until" "end" "of" "turn"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Decides(WhichCreaturesBlock))], duration:EndOfCombat, evaluation:LiveObjects}}] */
choose_combat_blockers ::= "you" "choose" "which" "creatures" "block" "this" "combat" "and" "how" "those" "creatures" "block"

/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:Object{event:AttacksAndIsNotBlocked, objects:$noun}, duration:EndOfCombat, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:SetTapped{objects:One(EventSubject)}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::RemoveFromCombat{object:EventSubject}}}]}}}] */
combat_unblocked_untap_remove ::= "whenever" "a" noun "attacks" "and" "isn't" "blocked" "this" "combat" "," "untap" "it" "and" "remove" "it" "from" "combat"

/* @sem Instruction::[...$choose_combat_blockers, ...$combat_unblocked_untap_remove] */
choose_blockers_unblocked_trigger ::= choose_combat_blockers "." NEWLINE combat_unblocked_untap_remove

/* A combined resolution payment retains each cost part. */
/* @sem Cost::Cost{parts:[Mana($mana_symbols), $cost_discard]} */
payment_mana_and_discard ::= "pay" mana_symbols "and" cost_discard

/* The passive voice names the same damage source as the active voice. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Permanent, sources:SameObject($object_ref), recipients:Any, kind:Combat, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevent_combat_damage_passive ::= "prevent" "all" "combat" "damage" "that" "would" "be" "dealt" "by" object_ref this_duration

/* This explicit anaphor refers to the player offered the payment. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$player_ref, cost:$other_payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_if_that_player_does ::= player_ref "may" other_payment "." "if" "that" "player" "does" "," conjoined

/* Distinct target announcements retain the ordered damage amounts. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamageParts{source:$damage_source_ref, parts:[_{recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any})), amount:$number}, _{recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any, constraints:[DifferentFromTarget(0)]})), amount:$number_2}], preventable:true}}] */
clause_damage_distinct_pair ::= damage_source_ref "deals" number "damage" "to" "any" "target" "and" number "damage" "to" "any" "other" "target"

/* @sem Instruction::[Effect{result:@next, operation:DealDamageParts{source:$damage_source_ref, parts:[_{recipients:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(3)), filter:Any}), index:0}, amount:$number}, _{recipients:Target{slot:0, index:1}, amount:$number_2}, _{recipients:Target{slot:0, index:2}, amount:$number_3}], preventable:true}}] */
clause_damage_distinct_three ::= damage_source_ref "deals" number "damage" "to" "any" "target" "," number "damage" "to" "another" "target" "," "and" number "damage" "to" "a" "third" "target"

/* @prefer always */
/* The two-sentence sequence retains both current operands. */
/* @sem Instruction::[...$clause_damage_distinct_pair, Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:$mana_bundle}}] */
instructions_distinct_damage_mana ::= clause_damage_distinct_pair "." "add" mana_bundle

/* This scoped hand destination retains the named card and current count. */
/* @sem Operation::Conjure{actor:One(AbilityController), card:Named($referenced_card_name), count:$card_count, destination:Hand(CardArrival{counters:[], states:[]})} */
collector_conjure_hand ::= "conjure" card_count "named" referenced_card_name "into" "your" "hand"

/* The free cast and the alternative token are one payment-choice contract. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AllOf([Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}}, Shares{property:CardTypes, with:EventSubject}])}), count:Exactly(Constant(1)), cost:Free}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@prior)), then:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$cast_alternative_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Created(@prior)), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}]}, otherwise:_{}}] */
cast_or_create_program ::= "you" "may" "cast" "a" "spell" "with" "lesser" "mana" "value" "that" "shares" "a" "card" "type" "with" "it" "from" "your" "hand" "without" "paying" "its" "mana" "cost" "." "if" "you" "don't" "," "create" cast_alternative_token "." "it" "gains" keyword_name duration

attachment_subject ::= affected | objects_all_battlefield

attachment_host ::= object_ref | her_ref

/* A player-by-player selection remains available to the following global
   sacrifice. The selected exclusion and the sacrifice's filter are separate. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:ControlledBy(One(Bound(0)))}, count:AsManyAsCan(Constant(4)), constraints:[OneForEach([$noun, $noun_2, $noun_3, $noun_4])]}}]}}, Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:All, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(InSet(Selected(@prior))), $filter_plural])}})}] */
instructions_choose_each_then_sacrifice_other ::= "for" "each" "player" "," "you" "choose" "from" "among" "the" "permanents" "that" "player" "controls" ("a" | "an") noun "," ("a" | "an") noun "," ("a" | "an") noun "," "and" ("a" | "an") noun "." "then" "each" "player" "sacrifices" "all" "other" filter_plural "they" "control"

/* The pile reference is scoped to this separation and random choice. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, starting_with:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Piles{actor:One(Bound(0)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:ControlledBy(One(Bound(0)))}, count:$count_plural}}]}}, Effect{result:@next, operation:ChoosePile{actor:One(AbilityController), from:All, random:true}}, Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:All, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:InPile(None)}})}] */
instructions_separate_piles_then_sacrifice ::= "starting" "with" "you" "," "each" "player" "separates" "all" "permanents" "they" "control" "into" count_plural "piles" "." "then" "each" "player" "chooses" "one" "of" "their" "piles" "at" "random" "and" "sacrifices" "those" "permanents"

/* A resolving combined payment keeps both cost components. */
/* @sem Cost::Cost{parts:[Mana($mana_symbols), $cost_sacrifice]} */
payment_mana_sacrifice ::= "pay" mana_symbols "and" cost_sacrifice

/* The offered alternatives belong to the named payer; the action runs on refusal. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$player_ref, cost:Cost{parts:[Choice([Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly($counter_amount)}]}, Cost{parts:[Life($value)]}])]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:$operation}]}, otherwise:Program{}}] */
clause_action_unless_sacrifice_or ::= operation "unless" player_ref "sacrifices" counter_amount filter_phrase "of" "their" "choice" "or" "pays" value "life"

/* A payment may gate a complete multi-sentence program. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment_mana_sacrifice, optional:true}}, If{condition:PaymentChosen(@last_result), then:$program, otherwise:Program{}}] */
clause_if_you_do_program ::= "you" "may" payment_mana_sacrifice "." "if" "you" "do" "," program

/* Graveyard targets and their perpetual changes retain their own operands. */
/* @sem Operation::CreatePerpetualEffect{objects:One($graveyard_without_unearth_target), changes:$perpetual_unearth_own_cost} */
perpetual_graveyard_unearth ::= graveyard_without_unearth_target "perpetually" perpetual_unearth_own_cost

/* @sem Change::[GrantAbility(Mechanic{mechanic:Unearth, cost:_{parts:[ManaCostOf(Source)]}})] */
perpetual_unearth_own_cost ::= "gains" "unearth" "." "the" "unearth" "cost" "is" "equal" "to" "its" "mana" "cost"

/* @sem Operation::CreatePerpetualEffect{objects:One($graveyard_perpetual_target), changes:$perpetual_card_type_change} */
perpetual_graveyard_card_type ::= graveyard_perpetual_target "perpetually" perpetual_card_type_change

/* The permission refers to the same announced target. */
/* @sem Instruction::[Effect{result:@next, operation:CreatePerpetualEffect{objects:One($graveyard_perpetual_target), changes:$perpetual_card_type_change}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One($graveyard_perpetual_target), from:Graveyard, action:CastSpell, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}] */
instructions_perpetual_graveyard_cast ::= graveyard_perpetual_target "perpetually" perpetual_card_type_change "." "you" "may" "cast" "that" "card" this_duration

/* The delayed instruction is tied to the extra turn just created. */
/* @sem Instruction::[Effect{result:@next, operation:$take_extra_turn}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:ExtraTurn(0), body:Program{instructions:[...$clause_you]}}}] */
extra_turn_end_instruction ::= take_extra_turn "." "at" "the" "beginning" "of" "that" "turn's" "end" "step" "," clause_you

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$extra_turn_end_instruction}} */
spell_extra_turn_end ::= extra_turn_end_instruction "."

/* A postposed next-turn upkeep applies to the immediately stated instruction. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:UpkeepBegins, players:All}, start:NextTurn, body:Program{instructions:[...$clause_you]}}}]} */
next_turn_upkeep_you_program ::= clause_you "at" "the" "beginning" "of" "the" "next" "turn's" "upkeep" "."

/* @sem @scope(Mode::Mode{announcement:@announcement, body:$next_turn_upkeep_you_program, weight:1}) */
mode_next_turn_upkeep_you ::= "•" next_turn_upkeep_you_program

/* The receipt is tied to the library-exile producer, including its destination. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Transition{result:@prior, phase:After}), kind:$counter_kind, amount:Constant(1)}]}}] */
clause_exile_top_counter_each ::= exile_top_cards_of_your_library "and" "put" "a" counter_kind "counter" "on" "each" "of" "them"

/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(One(AbilityController)), Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})])}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
clause_optional_owned_counter_card ::= "you" "may" "put" "a" "card" "you" "own" "in" "exile" "with" "a" counter_kind "counter" "on" "it" "into" "your" "hand"

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Exile]}), count:Exactly(Constant(1)), filter:AllOf([$adjective_nontype, History{event:ExiledFromGraveyard(One(AbilityController)), window:ThisTurn}])}), index:0})), kind:$counter_kind, amount:$number}]} */
put_counters_exiled_graveyard_history ::= "put" number counter_kind "counters" "on" "target" adjective_nontype "card" "in" "exile" "that" "was" "put" "there" "from" "your" "graveyard" "this" "turn"

/* The anaphor must resolve to the previously mentioned card. */
/* @sem Instruction::[If{condition:ObjectMatches{object:@it, filter:Not(HasKeywordFamily(Suspend))}, then:_{instructions:[Effect{result:@next, operation:EffectOn{subject:Objects(One(@it)), effects:[Term{family:ExiledCardEffect, form:AddAbility, operands:[Ability(Mechanic{mechanic:BasicSuspend})]}]}}]}, otherwise:_{}}] */
clause_exiled_card_suspend_if_missing ::= "if" "it" "doesn't" "have" "suspend" "," "it" "gains" "suspend"

/* @sem Instruction::[Effect{result:@next, operation:$put_counters_exiled_graveyard_history}, ...$clause_exiled_card_suspend_if_missing] */
instructions_suspend_after_exile_counters ::= put_counters_exiled_graveyard_history "." clause_exiled_card_suspend_if_missing

/* A threshold replacement shares the original X draw with its replacement. */
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:AnnouncedX}}] */
x_draw_cards ::= "draw" "X" "cards"

/* @sem Instruction::[If{condition:Compare{left:AnnouncedX, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, then:Program{instructions:[...$shuffle_own_graveyard, ...$x_draw_cards_2, ...$instructions_untap_choice, ...$clause_no_maximum_hand_size_rest]}, otherwise:Program{instructions:$x_draw_cards}}] */
clause_x_draw_replacement ::= x_draw_cards "." "if" "X" "is" number "or" "more" "," "instead" shuffle_own_graveyard "," x_draw_cards "," instructions_untap_choice "," "and" clause_no_maximum_hand_size_rest

/* The history count and the optional use are scoped to this exact library-to-exile producer. */
/* @sem Instruction::[Effect{result:@next, operation:$operation}, ...$history_exile_entry] */
instructions_history_exile_followup ::= operation "," "then" history_exile_entry

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:EventHistory{event:ZoneChange{objects:AllOf([$filter_plural, OwnedBy(All)]), from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Occurrences}, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_phrase, InSet(Transition{result:@prior, phase:After})])}), count:AsManyAsCan($counter_amount)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:$static_changes, duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@back(4), phase:After, index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}}]}}] */
history_exile_entry ::= "exile" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" "the" "number" "of" filter_plural "that" "were" "put" "into" "graveyards" "from" "the" "battlefield" "this" "turn" "." "you" "may" "put" counter_amount filter_phrase "card" "exiled" "this" "way" "onto" "the" "battlefield" "." put_card_subject static_changes "." "return" "it" "to" "your" "hand" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* @prefer always */
/* A spell's threshold replacement and self-exile occupy separate paragraphs. */
/* @sem Ability::[Spell{announcement:@announcement, body:Program{instructions:[...$clause_x_draw_replacement, Effect{result:@next, operation:Move{objects:One(Source), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
spell_x_draw_replacement_exile ::= clause_x_draw_replacement "." NEWLINE "exile" SELF_NAME "."

/* The continuation refers only to this paid arrival, including its delayed return. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[$hand_graveyard_entry_choice]}, optional:true}}, If{condition:PaymentChosen(@back(3)), then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Query{objects:CostObjects{payment:Resolution(@back(4)), component:[0, 0, 0], view:Performed, phase:After}, index:0})), changes:$static_changes, duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Query{objects:CostObjects{payment:Resolution(@back(6)), component:[0, 0, 0], view:Performed, phase:After}, index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}}]}, otherwise:_{}}] */
instructions_optional_entry_changes_return ::= "you" "may" hand_graveyard_entry_choice "." put_card_subject static_changes "." "return" "it" "to" "your" "hand" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* The arrival and its delayed return share the same payment and result. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:$grants, duration:Indefinite, evaluation:Snapshot}}, If{condition:PaymentChosen(@back(3)), then:_{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@back(4), phase:After, index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}}]}, otherwise:_{}}] */
instructions_graveyard_creature_temporary ::= "return" "target" "creature" "card" "from" "your" "graveyard" "to" "the" "battlefield" "." "that" "creature" "gains" grants "." "return" "it" "to" "your" "hand" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* The optional hand arrival owns both the grant and sacrifice receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:_{parts:[Move{selections:[_{objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:CardType(Creature)}), choose:Exactly(Constant(1))}], destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0})), changes:$grants, duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:All, objects:One(Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0})})}]}}}]}, otherwise:_{}}] */
instructions_hand_creature_temporary ::= "you" "may" "put" "a" "creature" "card" "from" "your" "hand" "onto" "the" "battlefield" "." "that" "creature" "gains" grants "." "its" "controller" "sacrifices" "it" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* @sem Instruction::[...$instructions_graveyard_creature_temporary, ...$instructions_hand_creature_temporary] */
instructions_temporary_creature_pair ::= instructions_graveyard_creature_temporary "." NEWLINE instructions_hand_creature_temporary

/* @sem Operation::FlipCoinSeries{players:One(AbilityController), protocol:@coin_protocol, repetition:CoinRepetition::EachObject($coin_each_population)} */
flip_coin_for_each ::= "flip" "a" "coin" coin_each_population

/* @sem Operation::Draw{players:One(AbilityController), amount:$count_each_died_under_your_control} */
draw_for_each_controlled_death ::= "draw" "a" "card" "for" "each" count_each_died_under_your_control

/* Selection and battlefield arrival remain independent conjure operands. */
/* @sem Operation::Conjure{actor:One(AbilityController), card:$conjured_random_mana_card, count:$counter_amount, destination:$conjure_battlefield_arrival} */
conjure_random_oracle_battlefield ::= "conjure" counter_amount conjured_random_mana_card conjure_battlefield_arrival

/* @sem ConjuredCard::Random(Term{family:CardsInOracle, form:And, operands:[$conjured_oracle_type, Term{family:CardsInOracle, form:ManaValueIs, operands:[Comparison([Equal, $number])]}]}) */
conjured_random_mana_card ::= "random" conjured_oracle_type "card" "with" "mana" "value" number

/* @sem ConjureDestination::Battlefield(BattlefieldArrival{tapped:false, counters:[], states:[]}) */
conjure_battlefield_arrival ::= "onto" "the" "battlefield"

/* @sem Operation::Conjure{actor:One(AbilityController), card:$conjured_chosen_book, count:$card_count, destination:$conjure_charge_arrival} */
conjure_planets_battlefield ::= "conjure" card_count conjured_chosen_book conjure_charge_arrival

/* @sem ConjuredCard::Spellbook{book:Planets, pick:Choice} */
conjured_chosen_book ::= "of" "your" "choice" "from" "the" "Planets" "Spellbook"

/* @sem ConjureDestination::Battlefield(BattlefieldArrival{tapped:true, counters:[[Named(ChargeCounter), $value]], states:[]}) */
conjure_charge_arrival ::= "onto" "the" "battlefield" "tapped" "with" value "charge" "counters" "on" "it"

/* @sem Operation::Conjure{actor:One(ControllerOf(EventSubject)), card:Named($conjured_battlefield_name), count:$card_count, destination:$conjure_tapped_arrival} */
conjure_event_controller_named ::= "its" "controller" "conjures" card_count "named" conjured_battlefield_name conjure_tapped_arrival

/* @sem ConjureDestination::Battlefield(BattlefieldArrival{tapped:true, counters:[], states:[]}) */
conjure_tapped_arrival ::= "onto" "the" "battlefield" "tapped"

/* The measured creature is the performed arrival of this exact exile payment. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$conjure_exile_creature_cost, optional:false}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Random(Filter(AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:Add([$value, Aggregate{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, property:ManaValue, aggregation:Sum}])}}]))), count:$counter_amount, destination:Battlefield(BattlefieldArrival{tapped:false, counters:[], states:[]})}}]}, otherwise:Program{}}] */
instructions_exile_creature_conjure ::= conjure_exile_creature_cost "." "if" "you" "do" "," "conjure" counter_amount "random" filter_phrase "card" "with" "mana" "value" "X" "onto" "the" "battlefield" "," "where" "X" "is" value "plus" "the" "exiled" "creature's" "mana" "value"

/* @sem Cost::Cost{parts:[Move{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), AllOf([CardType(Creature), ControlledBy(One(AbilityController))])])}, choose:Exactly(Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]} */
conjure_exile_creature_cost ::= "exile" "another" "creature" "you" "control"

/* The condition observes the immediately preceding mill receipt. Keeping the
   producer and consumer together proves the action named by the wording. */
/* @sem Program::Program{instructions:[Repeatable{instructions:[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:Mill{players:One(AbilityController), amount:$card_count_one}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@last_result, phase:After}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:$operation_2}, Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}]}]} */
program_mill_repeat_match ::= operation "," "then" "mill" card_count_one "." "if" "an" filter_phrase "card" "was" "milled" "this" "way" "," operation "and" "repeat" "this" "process"

/* @prefer always */
/* The life amount refers to the actual arrival of this particular return. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:ObjectProperty{object:Result{result:@prior, phase:After, index:0}, property:$returned_creature_stat, information:CurrentOrLastKnown}}}] */
instructions_return_creature_life_property ::= "return" "target" "creature" "card" "from" "your" "graveyard" "to" "the" "battlefield" "." "you" "gain" "life" "equal" "to" "that" "creature's" returned_creature_stat

returned_creature_stat ::= stat_power | stat_toughness

/* @sem Operation::GainLife{players:One(AbilityController), amount:@times($number, $count_each_target_private_cards)} */
you_gain_life_for_each_private_card ::= "you" "gain" number "life" "for" "each" count_each_target_private_cards

/* Count cards in the explicitly targeted player's private zone. */
/* @sem Expr::CountObjects(Zone{scope:Players{zone:$greatest_card_zone, players:One($target_possessive)}, kind:Card, filter:Any}) */
count_each_target_private_cards ::= "card" "in" target_possessive greatest_card_zone

/* Retarget the previously mentioned spell to a different matching permanent. */
/* @sem Operation::Retarget{actor:One(AbilityController), object:@it, targets:To(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(SoleTargetOf(@it))), $filter_phrase])})} */
retarget_that_spell_another ::= "change" "that" "spell's" "target" "to" "another" filter_phrase

/* A private-zone exchange followed by an independently specified exile. */
/* @sem Instruction::[Effect{result:@next, operation:Exchange{kind:Zones([$exchange_private_first, $exchange_private_second]), first:Players(One($zone_your)), second:Players(One($zone_your))}}, Effect{result:@next, operation:$exile_objects}] */
instructions_exchange_private_then_exile ::= "exchange" zone_your exchange_private_first "and" exchange_private_second "." NEWLINE exile_objects

exchange_private_first ::= exchange_private_hand | exchange_private_library

exchange_private_second ::= exchange_private_graveyard | exchange_private_library | exchange_private_hand

/* @sem Zone::Hand */
exchange_private_hand ::= "hand"

/* @sem Zone::Library */
exchange_private_library ::= "library"

/* @sem Zone::Graveyard */
exchange_private_graveyard ::= "graveyard"

/* Each selected object's own current or last-known colors determine its placement. */
/* @sem Instruction::[Effect{result:@next, operation:PutCountersEach(_{amount:$each_object_color_count, kind:$counter_kind, objects:$affected})}] */
clause_choose_each_color_counters ::= "choose" affected "." "for" "each" "of" "them" "," "put" "a" "number" "of" counter_kind "counters" "on" "it" "equal" "to" each_object_color_count

/* @sem Expr::ObjectProperty{object:Affected, property:ColorCount, information:CurrentOrLastKnown} */
each_object_color_count ::= "the" "number" "of" "colors" "it" "is"

/* The excess recipient is the controller of the very same creature target.
   Keeping this as an operation allows it to compose within ordinary programs. */
/* @sem Operation::DealDamageWith{source:$self_explicit_ref, recipients:Objects(One($excess_damage_creature_target)), amount:$number, rider:ExcessTo(ControllerOf($excess_damage_creature_target))} */
damage_excess_to_creature_controller ::= self_explicit_ref "deals" number "damage" "to" excess_damage_creature_target "." "excess" "damage" "is" "dealt" "to" "that" "creature's" "controller" "instead"

/* A source put onto the battlefield from the command zone enters under its owner. */
/* @sem Operation::Move{objects:One($self_explicit_ref), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
command_self_entry ::= "put" self_explicit_ref "onto" "the" "battlefield" "from" "the" "command" "zone"

/* @sem Operation::TowardPlayer{actor:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(2)), filter:Any, players:All}), index:0}), action:ExchangeLife, player:Target{slot:@next_slot, index:1}} */
exchange_two_target_players_life ::= "two" "target" "players" "exchange" "life" "totals"

/* The later permission and test refer to this exact mill's arrival receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:All, amount:$card_count}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$clause}, otherwise:Program{}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@marked, phase:After}, from:Graveyard, action:CastSpell, filter:Any}, terms:_{limit:Total(1), cost:Normal}})], duration:$duration, evaluation:LiveObjects}}] */
instructions_each_mill_conditional_cast ::= "each" "player" "mills" card_count "." "if" "a" filter_phrase "card" "was" "milled" "this" "way" "," clause "." duration "," "you" "may" "cast" "a" "spell" "from" "among" "those" "cards"

/* Event-batch selections name the triggering objects, not a prior action receipt. */
/* @sem ObjectSet::EventGroup */
event_batch_them ::= "them"

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
selected_onto_battlefield ::= "onto" "the" "battlefield"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$event_batch_them, count:AsManyAsCan($value)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$selected_onto_battlefield, qualifiers:[]}}] */
put_event_batch_selection ::= "put" value "of" event_batch_them selected_onto_battlefield

/* The mill and its optional choice share this exact producer and arrival. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$milled_return_filter}, count:AsManyAsCan($counter_amount)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$selected_onto_battlefield, qualifiers:[]}}]}}] */
mill_optional_batch_battlefield ::= "mill" card_count "." "you" "may" "put" counter_amount milled_return_filter "card" "from" "among" "them" selected_onto_battlefield

/* Test the actual returned objects before the move, retaining the event subject. */
/* @sem Instruction::[...$return_chosen_to_owners_hand, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@last_result, phase:Before}, filter:AllOf([Not(SameObject(EventSubject)), $filter_phrase])}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:$program, otherwise:Program{}}] */
return_chosen_other_callback ::= return_chosen_to_owners_hand "." "if" "another" filter_phrase "was" "returned" "this" "way" "," program

/* Counter transfers retain both announced targets; "second" excludes the first. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(Target{slot:@last_slot, index:0})), $filter_phrase)}), index:0} */
transfer_second_target ::= "a" "second" "target" filter_phrase

/* @sem Operation::MoveCounters{actor:One(AbilityController), from:One($target_permanent), to:One($transfer_second_unmodified_target), amount:One} */
transfer_counter_one_second ::= "move" "a" "counter" "from" target_permanent "onto" transfer_second_unmodified_target

/* @sem Operation::MoveCounters{actor:One(AbilityController), from:One($target_permanent), to:One($transfer_second_target), kind:$counter_kind, amount:One} */
transfer_counter_kind_second ::= "move" "a" counter_kind "counter" "from" target_permanent "onto" transfer_second_target

/* @sem Operation::MoveCounters{actor:One(AbilityController), from:One($target_permanent), to:One($transfer_second_target), amount:AnyNumber} */
transfer_counters_any_second ::= "move" "any" "number" "of" "counters" "from" target_permanent "onto" transfer_second_target

/* @sem Operation::MoveCounters{actor:One(AbilityController), from:One($target_permanent), to:One($target_permanent_2), amount:One} */
transfer_counter_between_targets ::= "move" "a" "counter" "from" target_permanent "onto" target_permanent

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(Target{slot:@last_slot, index:0})), $transfer_unmodified_target_type)}), index:0} */
transfer_second_unmodified_target ::= "a" "second" "target" transfer_unmodified_target_type

transfer_unmodified_target_type ::= noun_creature | noun_permanent

/* The event player chooses an attacker; the following pump uses that choice. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:EventSubject, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Attacking, $noun])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot}}] */
instructions_event_player_attacker_pump ::= "that" "player" "chooses" "an" "attacking" noun "." "it" "gets" signed "/" signed duration

/* The two sequential selections keep the unselected remainder of the second choice. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$adjective_nontype, ControlledBy(OthersThan(AbilityController))])}, count:UpTo($number)}}, Effect{result:@next, operation:ChooseObjects{player:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0}, objects:Selected(@prior), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Unselected(@prior)), changes:[SetController(AbilityController)], duration:Indefinite, evaluation:Snapshot}}] */
instructions_opponent_choice_control_remainder ::= "choose" "up" "to" number adjective_nontype "permanents" "you" "don't" "control" "." "target" "opponent" "chooses" "one" "of" "those" "permanents" "." "you" "gain" "control" "of" "the" "rest"

/* The commander's value is summed across owned commanders, in any zone. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(State(Commander)), $noun, ControlledBy(OpponentsOf(AbilityController))])}), amount:Aggregate{objects:AnyZone(AllOf([State(Commander), OwnedBy(One(AbilityController))])), property:ManaValue, aggregation:Sum}, preventable:true}}] */
instructions_commander_value_noncommanders ::= "it" "deals" "damage" "equal" "to" "your" "commander's" "mana" "value" "to" "each" "noncommander" noun "your" "opponents" "control"

/* Each selected creature deals its own property to the other simultaneously. */
/* @sem Instruction::[Effect{result:@next, operation:Together([DealDamage{source:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), index:0}, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(OpponentsOf(AbilityController))])}), index:0})), amount:ObjectProperty{object:Target{slot:0, index:0}, property:$stat, information:CurrentOrLastKnown}, preventable:true}, DealDamage{source:Target{slot:1, index:0}, recipients:Objects(One(Target{slot:0, index:0})), amount:ObjectProperty{object:Target{slot:1, index:0}, property:$stat, information:CurrentOrLastKnown}, preventable:true}])}] */
instructions_two_optional_creatures_exchange_damage ::= "choose" "up" "to" "one" "target" "creature" "you" "control" "and" "up" "to" "one" "target" "creature" "an" "opponent" "controls" "." "each" "of" "those" "creatures" "deals" "damage" "equal" "to" "its" stat "to" "the" "other"

/* An unpunctuated quoted activated ability belongs to each affected holder. */
/* @sem Ability::@holder(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, body:$program, announcement:@announcement}) */
granted_activated_unpunctuated ::= '"' cost ":" program '"'

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), changes:[GrantAbility($granted_activated_unpunctuated)], duration:$duration, evaluation:Snapshot}}] */
instructions_controlled_creatures_grant_quoted ::= "each" "creature" "you" "control" "gains" granted_activated_unpunctuated duration

/* The replacement branch creates the specified token when no creature is controlled. */
/* @sem Instruction::[If{condition:Not(Controls{player:AbilityController, filter:CardType(Creature), minimum:1}), then:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$token_group], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Result{result:@prior, phase:After, index:0})), kind:PowerToughness(1, 1), amount:$number}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@back(3), phase:After, index:0})), changes:[GrantKeyword($keyword_name), GrantKeyword($keyword_name_2)], duration:$duration, evaluation:Snapshot}}]}}] */
instructions_creature_counters_or_token ::= "put" number "+" "1" "/" "+" "1" "counters" "on" "a" "creature" "you" "control" "and" "it" "gains" keyword_name "and" keyword_name duration "." "if" "you" "control" "no" "creatures" "," "instead" "create" token_group

/* A damage restriction applies before the accompanying action resolves. */
/* @sem Operation::EffectOn{subject:Objects($affected), effects:[Term{family:SpellEffect, form:DamageToPermanentsCantBePreventedOrRedirected, operands:[Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase})]}]} */
damage_permanent_no_prevention_or_redirection ::= "if" affected "would" "deal" "damage" "to" "a" filter_phrase "," "that" "damage" "can't" "be" "prevented" "or" "dealt" "instead" "to" "another" "permanent" "or" "player"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$damage_permanent_no_prevention_or_redirection}, Effect{result:@next, operation:$operation}]}} */
spell_action_with_damage_restriction ::= operation "." damage_permanent_no_prevention_or_redirection "."

/* The holder's explicit graveyard departure supplies the scope for a parent
   trigger; the existing callback binds its own announcement to the move. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Source), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, $reflexive_trigger]}}]} */
graveyard_self_exile_reflexive_program ::= "you" "may" "exile" "this" "card" "from" "your" "graveyard" "." reflexive_trigger

/* An optional stack copy retains the referenced object and permits a new target. */
/* @sem Instruction::[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$object_ref, times:Constant(1), targets:May}}] */
copy_ref_may_choose_target ::= "copy" object_ref "and" "may" "choose" "a" "new" "target" "for" "the" "copy"

/* Each next spell is tracked independently, but receives the same ability. */
/* @sem Instruction::[Effect{result:@next, operation:ChangeSpell{subject:Next{spells:$next_spell_filter, player:AbilityController, this_turn:true}, changes:[GrantAbility($spell_mechanic)]}}, Effect{result:@next, operation:ChangeSpell{subject:Next{spells:$next_spell_filter_2, player:AbilityController, this_turn:true}, changes:[GrantAbility($spell_mechanic)]}}] */
clause_next_pair_spell_mechanic ::= "the" "next" next_spell_filter "and" "the" "next" next_spell_filter "you" "cast" "this" "turn" "each" "have" spell_mechanic

/* @sem Operation::Move{objects:One($chosen_optional_spell_target), destination:$owner_chosen_library_end, qualifiers:[]} */
move_chosen_spell_owner_library ::= chosen_optional_spell_target "." owner_chosen_library_end

/* The optional instruction supplies the choice; the stack object stays explicit. */
/* @sem Operation::Retarget{actor:One(AbilityController), object:$object_ref, targets:May} */
retarget_choose_new ::= "choose" "a" "new" "target" "for" object_ref

/* The difference is measured for each affected creature, in the same scope
   as the comparison that establishes it. */
/* @sem Operation::PutCountersEach(_{amount:Subtract(ObjectProperty{object:Affected, property:Power, information:CurrentOrLastKnown}, ObjectProperty{object:Affected, property:BasePower, information:CurrentOrLastKnown}), kind:$counter_kind, objects:$controlled_creatures_above_base}) */
put_counters_above_base_each ::= controlled_creatures_above_base "," "put" "a" "number" "of" counter_kind "counters" "on" "that" "creature" "equal" "to" "the" "difference"

/* The second sentence refers to the same announced ante target. */
/* @sem Instruction::[Effect{result:@next, operation:Exchange(_{kind:Ante, first:Object($target_ante_object), second:Objects($single_your_library_end)})}] */
instructions_own_ante_exchange ::= "you" "own" target_ante_object "." "exchange" "that" "card" "with" single_your_library_end

/* One counter per card in a live named zone. */
/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:Count(Exactly($remove_counter_live_count))}]} */
remove_counter_for_each_live_card ::= "remove" "a" counter_kind "counter" "from" affected "for" "each" remove_counter_live_count

remove_counter_live_count ::= count_each_card_hand | count_each_card_graveyard | count_each_hand | count_each_graveyard | count_each_target_hand | count_each_target_graveyard

/* The target pair shares a controller; the exchange is one combat change. */
/* @sem Operation::ChangeCombat{change:SwapBlocks{first:$blocking_pair_first, second:Target{slot:@last_slot, index:1}}} */
swap_blocking_pair ::= "choose" blocking_pair_first "." "if" "each" "of" "those" "creatures" "could" "block" "all" "creatures" "that" "the" "other" "is" "blocking" "," "remove" "both" "of" "them" "from" "combat" "." "each" "one" "then" "blocks" "all" "creatures" "the" "other" "was" "blocking"

/* A face-down pile is one payment with both the referenced objects and the
   current number of top library cards. The enclosing clause consumes that
   very payment receipt when it returns the shuffled pile. */
/* @sem Vec<CostObjectSelection>::[_{objects:$affected}, _{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$pile_top_count, from:Top}, choose:Exactly($pile_top_count)}] */
affected_and_library_top_selections ::= affected "and" pile_top_count

/* @sem Cost::Cost{parts:[Move{selections:$affected_and_library_top_selections, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[ExilePile{shuffled:true}]}}}]} */
pile_exile_payment ::= "exile" affected_and_library_top_selections "in" "a" "face-down" "pile"

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$pile_exile_payment, optional:false}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:Move{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, destination:Library{position:Top, order:Random, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{}}] */
clause_exile_pile_return ::= pile_exile_payment "." "if" "you" "do" "," "shuffle" "that" "pile" "and" "put" "it" "back" "on" "top" "of" "your" "library"

/* Cast the actual ability holder, with its normal cost and casting player. */
/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:One($self_explicit_ref), count:Exactly(Constant(1)), cost:Normal} */
graveyard_self_cast ::= "cast" self_explicit_ref "from" "your" "graveyard"

/* A mixed-zone target keeps its announced identity while its color is set. */
/* @sem Operation::EffectOn{subject:Objects(One($target_spell_or_noun)), effects:[Term{family:SpellOrPermanentEffect, form:SetColor, operands:[Term{family:SettableColor, form:SimpleColorList, operands:[$mixed_target_color]}]}], until:$until_end_of_turn} */
mixed_target_set_color ::= target_spell_or_noun "becomes" mixed_target_color until_end_of_turn

mixed_target_color ::= mixed_color_white | mixed_color_blue | mixed_color_black | mixed_color_red | mixed_color_green

/* @sem Operand::Vocabulary{family:SimpleColor, form:White} */
mixed_color_white ::= "white"

/* @sem Operand::Vocabulary{family:SimpleColor, form:Blue} */
mixed_color_blue ::= "blue"

/* @sem Operand::Vocabulary{family:SimpleColor, form:Black} */
mixed_color_black ::= "black"

/* @sem Operand::Vocabulary{family:SimpleColor, form:Red} */
mixed_color_red ::= "red"

/* @sem Operand::Vocabulary{family:SimpleColor, form:Green} */
mixed_color_green ::= "green"

/* A fixed amount is dealt independently by every member of the source population. */
/* @sem Operation::DealDamageFromEach{sources:$damage_each_population, recipients:Objects(One($object_ref)), amount:$number} */
damage_each_fixed ::= damage_each_population "deals" number "damage" "to" object_ref

/* The tested target and the excluded destination share the same source. */
/* @sem Instruction::[If{condition:ObjectMatches{object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:Any}), index:0}, filter:AllOf([OnStack(SingleTarget), TargetsAny(Objects(One($self_explicit_ref)))])}, then:Program{instructions:[Effect{result:@next, operation:Retarget{actor:One(AbilityController), object:Target{slot:@last_slot, index:0}, targets:To(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Not(SameObject($self_explicit_ref))])})}}]}, otherwise:Program{}}] */
conditional_retarget_source ::= "if" "target" "spell" "has" "only" "one" "target" "and" "that" "target" "is" self_explicit_ref "," "change" "that" "spell's" "target" "to" "another" filter_phrase

/* A singular creation provides the host for the immediately following choice. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:AttachChosen{actor:One(AbilityController), attachments:$affected, count:Exactly($counter_a), hosts:Created(@prior)}}]}}] */
instructions_create_single_optional_attachment ::= "create" "a" token_recipe "." "you" "may" "attach" counter_a affected "to" "it"

/* The repeated population is part of the selection contract: the remainder
   must be the same controlled population that each player chose from. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($filter_plural, $filter_plural_2), ControlledBy(One(Bound(0)))])}, count:AnyNumber, constraints:[TotalProperty{property:Power, comparison:LessOrEqual, amount:$value}]}}]}}, Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:All, objects:Unselected(@prior)})}] */
clause_choose_controlled_total_sacrifice ::= "each" "player" "chooses" "any" "number" "of" filter_plural "they" "control" "with" "total" "power" value "or" "less" "," "then" "sacrifices" "all" "other" filter_plural "they" "control"

/* A chosen card from your graveyard returns under your control. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
return_chosen_graveyard_battlefield ::= "return" "a" filter_phrase "card" "from" "your" "graveyard" "to" "the" "battlefield"

/* The owner set and token recipe preserve their shared linked exile population. */
/* @sem PlayerSet::Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}), filter:OwnedBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}} */
linked_exile_owners ::= "the" "exiled" "card's" "owner"

/* @sem Operation::@created_result(Operation::CreateTokens{players:$linked_exile_owners, tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:$linked_exile_value_token}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
linked_owner_creates_defined ::= linked_exile_owners "creates" "an" linked_exile_value_token

/* Keep each counted pump with its producer so its receipt cannot name an unrelated action. */
/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), amount:Count(UpTo($number))}]} */
remove_up_to_any_counters ::= "remove" "up" "to" number "counters" "from" affected

/* @sem Instruction::[Effect{result:@mark, operation:$remove_up_to_any_counters}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:CountersRemoved(@marked), toughness:Multiply([$value, CountersRemoved(@marked)])}], duration:$duration, evaluation:Snapshot}}] */
removed_counter_pump_sequence ::= remove_up_to_any_counters "." "for" "each" "counter" "removed" "this" "way" "," affected "gets" "+" "1" "/" "+" value duration

/* @sem Instruction::[Effect{result:@mark, operation:Discard{players:One(AbilityController), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:CountObjects(Transition{result:@marked, phase:Before}), toughness:Multiply([$value, CountObjects(Transition{result:@marked, phase:Before})])}], duration:$duration, evaluation:Snapshot}}] */
discarded_hand_pump_sequence ::= "discard" "your" "hand" "," "then" "draw" card_count "." "for" "each" "card" "discarded" "this" "way" "," affected "get" "+" "1" "/" "+" value duration

/* @sem Instruction::[Effect{result:@mark, operation:$players_reveal_tops}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:CountObjects(Matching{objects:Observed(@marked), filter:Not(CardType(Land))}), toughness:CountObjects(Matching{objects:Observed(@marked), filter:Not(CardType(Land))})}], duration:$duration, evaluation:Snapshot}}] */
revealed_nonland_pump_sequence ::= players_reveal_tops "." "for" "each" "nonland" "card" "revealed" "this" "way" "," affected "get" "+" "1" "/" "+" "1" duration

/* @sem Instruction::[...$revealed_nonland_pump_sequence, ...$instructions] */
revealed_nonland_pump_then ::= revealed_nonland_pump_sequence "." "then" instructions

/* Each follow-up is scoped to its producer, so the anaphor names its actual receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:@apply(PlayerSet::One(AbilityController), $create_base)}, Effect{result:@next, operation:CreateDelayedTrigger{event:$event_clause, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Created(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]}}}] */
delayed_created_plural_pair ::= create_base "." "exile" "those" "tokens" event_clause

/* @sem Instruction::[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_your_end, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Created(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]}}}] */
delayed_created_singular_pair ::= "create" "a" token_recipe "." "exile" "it" "at" delayed_your_end

/* @sem EventSpec::Turn{point:EndStepBegins, players:One(AbilityController)} */
delayed_your_end ::= "the" "beginning" "of" "your" "next" "end" "step"

/* @sem EventSpec::Turn{point:UpkeepBegins, players:One(AbilityController)} */
delayed_your_upkeep ::= "the" "beginning" "of" "your" "next" "upkeep"

/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:@and(ObjectFilter::CardType(Creature), $modifier_mana_value_numeric)}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_your_upkeep, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Transition{result:@marked, phase:After}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]}}}, ...$instructions] */
delayed_graveyard_creatures_pair_tail ::= "return" "each" "creature" "card" modifier_mana_value_numeric "from" "your" "graveyard" "to" "the" "battlefield" "." "exile" "those" "creatures" "at" delayed_your_upkeep "." instructions

/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_your_end, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}, destination:OwnersHand(CardArrival{}), qualifiers:[]}}]}}}] */
delayed_exiled_top_card_pair ::= "exile" "the" "top" "card" "of" "your" "library" "face" "down" "." "put" "that" "card" "into" "your" "hand" "at" delayed_your_end

/* These permissions share the actual top-library exile receipt. */
/* @sem Instruction::[...$card_exile_value_producer, ...$exiled_single_free_permission] */
instructions_top_single_free_permission ::= card_exile_value_producer "." exiled_single_free_permission

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:Either, filter:Any}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:CastSpell, filter:$filter_phrase}, terms:_{cost:Free}})], duration:$this_duration, evaluation:LiveObjects}}] */
exiled_single_free_permission ::= "you" "may" "play" "that" "card" this_duration "." "you" "may" "cast" filter_phrase "spells" "this" "way" "without" "paying" "their" "mana" "costs"

/* @sem Instruction::[Effect{result:@mark, operation:$exile_top_cards_of_your_library}, ...$exiled_many_land_permission] */
instructions_top_many_land_permission ::= exile_top_cards_of_your_library "." exiled_many_land_permission

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:Either, filter:Any}), PlayerRule(AdditionalLandPlays(Exactly($counter_amount)))], duration:$this_duration, evaluation:LiveObjects}}] */
exiled_many_land_permission ::= "you" "may" "play" "those" "cards" this_duration "." "you" "may" "play" counter_amount "additional" "land" "this" "turn"

/* The linked source and reduction are independent operands. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:$object_ref, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}), from:Exile, action:Either, filter:Any}, terms:_{cost:Normal, effects:[$linked_play_reduction]}})], duration:$duration, evaluation:LiveObjects}}] */
instructions_linked_play_reduced ::= duration "," "you" "may" "play" "cards" "exiled" "with" object_ref "." linked_play_reduction

/* @sem Operand::List([Term{family:SpellEffect, form:DecreaseManaCost, operands:[$linked_reduction_symbol]}]) */
linked_play_reduction ::= "spells" "you" "cast" "this" "way" "cost" linked_reduction_symbol "less" "to" "cast"

/* The demonstrative refers to the triggering event's card group. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:$event_play_cards, from:Exile, action:Either, filter:Any}, terms:$event_play_spending_terms})], duration:$duration, evaluation:LiveObjects}}] */
instructions_event_cards_play_spending ::= "you" "may" "play" event_play_cards duration "." event_play_spending_terms

/* @sem ObjectSet::EventGroup */
event_play_cards ::= "those" "cards"

/* @sem PlayTerms::PlayTerms{cost:Normal, spend_as:AnyType} */
event_play_spending_terms ::= "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "spells" "this" "way"

/* @sem Operand::Term{family:CostReductionSymbol, form:CostReduceGeneric, operands:[Integer($number)]} */
linked_reduction_symbol ::= "{" NUMBER "}"

/* The counted receipt is produced by this adjacent sacrifice of creatures. */
/* @sem Instruction::[Effect{result:@mark, operation:Sacrifice{players:OpponentsOf(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Transition{result:@marked, phase:Before}), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
instructions_opponent_sacrifice_named_tokens ::= "each" "opponent" "sacrifices" "a" "creature" "of" "their" "choice" "." "create" "a" token_named_recipe "token" "for" "each" "creature" "sacrificed" "this" "way"

/* A hand exile and its draw share the producer's receipt; the permission
   remains restricted to the recorded exile arrivals. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:$exile_all_hand_cards}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountObjects(Transition{result:@marked, phase:Before})}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Zone{scope:Shared(Exile), kind:Card, filter:InSet(Transition{result:@marked, phase:After})}, from:Exile, action:Either, filter:Any})], duration:$duration, evaluation:LiveObjects}}]} */
hand_exile_draw_play_program ::= exile_all_hand_cards "," "then" "draw" "that" "many" "cards" "." duration "," "you" "may" "play" "cards" "exiled" "this" "way" "."

/* The visible cards and duration refer to this face-down exile's arrival. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:$exile_ordered_face_down}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:Transition{result:@marked, phase:After}, audience:AffectedPlayer}), PlayerRule(PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:Either, filter:Any})], duration:WhileAnyExiled(Transition{result:@marked, phase:After}), evaluation:LiveObjects}}]} */
face_down_exile_look_play_program ::= exile_ordered_face_down "." "you" "may" "look" "at" "and" "play" "those" "cards" "for" "as" "long" "as" "they" "remain" "exiled" "."

/* A later trigger follows the previously identified creature; the body and
   duration retain their own operands. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:Attack{attackers:SameObject($named_creature), defenders:Players(OpponentsOf(AbilityController))}, duration:$this_duration, announcement:_{}, body:$prior_creature_attack_program}}] */
clause_prior_creature_attacks_opponents ::= "whenever" named_creature "attacks" "one" "of" "your" "opponents" this_duration "," prior_creature_attack_program

/* The player named after an opponent-controlled target is that target's
   controller. Keep the target operand shared by both instructions. */
/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Goad{object:$goad_opponent_target}}}, Effect{result:@next, operation:Draw{players:One(ControllerOf($goad_opponent_target)), amount:$card_count}}] */
instructions_goad_opponent_draw ::= "goad" goad_opponent_target "." "that" "player" "draws" card_count

/* @sem Instruction::[...$instructions_goad_opponent_draw, ...$mana_clause_plain_you] */
instructions_goad_opponent_draw_more ::= instructions_goad_opponent_draw "." mana_clause_plain_you

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ControlledBy(OpponentsOf(AbilityController))])}), index:0} */
goad_opponent_target ::= "target" noun "an" "opponent" "controls"

prior_creature_attack_program ::= prior_creature_attack_you_draw | program

/* Keep the written actor in the delayed trigger's draw instruction. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}]} */
prior_creature_attack_you_draw ::= "you" "draw" card_count

/* @sem Operation::LoseLife{players:One(Bound(0)), amount:$bound_player_card_count} */
bound_player_loses_counted_life ::= "loses" "life" "equal" "to" "the" "number" "of" bound_player_card_count

bound_player_card_count ::= bound_player_graveyard_card_count | bound_player_hand_card_count

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any}) */
bound_player_graveyard_card_count ::= "cards" "in" "their" "graveyard"

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}) */
bound_player_hand_card_count ::= "cards" "in" "their" "hand"

/* The loss reads one hand or graveyard for each member of the population. */
counted_life_each_player ::= players_each_opponent | players_each | players_each_other | players_each_other_opponent

/* @sem Instruction::[ForEachPlayer{players:$counted_life_each_player, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_player_loses_counted_life}]}}] */
clause_each_player_loses_counted_life ::= counted_life_each_player bound_player_loses_counted_life

/* The population and both printed modifiers are independent current operands. */
/* @sem Operation::EffectOn{subject:Objects(AnyZone(AllOf([$filter_phrase, InZone(Players{zone:Graveyard, players:One(AbilityController)})]))), effects:[Term{family:PerpetualEffect, form:AdjustPT, operands:[Integer($number), Integer($number_2)]}]} */
graveyard_cards_perpetual_pump ::= filter_phrase "cards" "in" "your" "graveyard" "perpetually" "get" "+" NUMBER "/" "+" NUMBER

/* The damage amount is tied to this exact counter-removal result. */
/* @sem Instruction::[Effect{result:@mark, operation:$remove_all_kind_counters}, Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Union([Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}), Players(All)]), amount:CountersRemoved(@marked), preventable:true}}] */
clause_removed_counters_damage ::= remove_all_kind_counters "," "and" object_ref "deals" "that" "much" "damage" "to" "each" filter_phrase "and" "each" "player"

/* Casting a selected spell with explicit alternative payment terms. */
/* @sem Operation::PlayWith{actor:One(AbilityController), action:CastSpell, cards:$private_spell_population, count:Exactly($cast_single_amount), terms:_{cost:$cast_alternative_terms}} */
cast_private_spell_alternate ::= "cast" cast_single_amount private_spell_population cast_alternative_terms

cast_single_amount ::= counter_a | n1

/* Announced team-controlled sources retain the team player binding and count. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly($number), filter:AllOf([$plural, ControlledBy(Matching{binding:0, condition:SameTeam{player:Bound(0), other:AbilityController}})])})) */
damage_team_targets ::= number "target" plural "your" "team" "controls"

damage_group_recipient ::= damage_other_target | damage_each_recipient

/* The life-loss event and its repeated-payment consumer share one scope. */
/* @sem Ability::Triggered{event:$event_you_lose_life, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$life_loss_sacrifice_unless}} */
triggered_life_loss_sacrifice_unless ::= "whenever" event_you_lose_life "," life_loss_sacrifice_unless "."

/* @sem Instruction::[Effect{result:@next, operation:PayRepeatedly{player:AbilityController, cost:$cost, at_most:EventAmount}}, Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Subtract(EventAmount, Performed(@prior)))})}] */
life_loss_sacrifice_unless ::= "for" "each" "1" "life" "you" "lost" "," "sacrifice" "a" filter_phrase "unless" "you" cost

/* @sem Operation::PutCounters{placements:[_{recipients:$recipients, kind:$counter_kind, amount:Multiply([Constant(2), EventAmount])}]} */
recipients_gets_twice_event_counters ::= recipients "gets" "twice" "that" "many" counter_kind "counters"

/* A repeated life payment capped by a separately expressed quantity. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayRepeatedly{player:AbilityController, cost:_{parts:[Life(Constant(1))]}, at_most:$opponent_population_total}}]} */
program_capped_life_payment ::= "pay" "any" "amount" "of" "life" "." "the" "amount" "you" "pay" "can't" "be" "more" "than" opponent_population_total

/* Each participant independently decides and performs the selected action. */
/* @sem Instruction::[ForEachPlayer{players:$optional_action_players, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::Bound(0)), $optional_bound_action)}]}}]}}] */
clause_each_optional_action ::= optional_action_players "may" optional_bound_action

optional_bound_action ::= scry_base

optional_action_players ::= players_each | players_each_opponent | optional_voting_players

/* @sem PlayerSet::Union([One(AbilityController), Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:VotedAs{player:Bound(0), other:AbilityController, same:true}}])]) */
optional_voting_players ::= "you" "and" "each" "opponent" "who" "voted" "for" "a" "choice" "you" "voted" "for"

/* The action shares one meaning across independent library-source phrases. */
/* @sem Operation::@manifest_result(Operation::Manifest{actor:One(AbilityController), source:$manifest_library_source, cloak:false, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
manifest_from_library ::= "manifest" manifest_library_source

manifest_library_source ::= manifest_library_fixed | manifest_library_counter_count

/* @sem ManifestSource::TopOfLibrary{player:$top_library_owner, count:$card_count_many} */
manifest_library_fixed ::= "the" "top" card_count_many "of" top_library_owner "library"

/* @sem ManifestSource::TopOfLibrary{player:$top_library_owner, count:$value_all_counters_on_object} */
manifest_library_counter_count ::= "a" "number" "of" "cards" "from" "the" "top" "of" top_library_owner "library" "equal" "to" value_all_counters_on_object

/* The second phrase is scoped to the target announced by the first phrase.
   Each choice reads the adjacent whole-hand reveal and retains its owner. */
/* @sem Instruction::[...$reveal_own_hand_opponent_choice, ...$reveal_target_hand_controller_choice] */
instructions_revealed_hand_exchange ::= reveal_own_hand_opponent_choice "." "then" reveal_target_hand_controller_choice

/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})}}, Effect{result:@next, operation:ChooseObjects{player:$hand_choice_target, objects:Matching{objects:InZone{objects:Observed(@back(2)), zone:Hand}, filter:@and(ObjectFilter::Any, ObjectFilter::OwnedBy(One(AbilityController)))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:DiscardObjects{objects:One(Result{result:@prior, phase:After, index:0})}}] */
reveal_own_hand_opponent_choice ::= "reveal" "your" "hand" "and" "discard" "a" "card" "of" hand_choice_target "choice"

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0} */
hand_choice_target_opponent ::= "target" "opponent's"

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0} */
hand_choice_target_player ::= "target" "player's"

hand_choice_target ::= hand_choice_target_opponent | hand_choice_target_player

/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone(_{scope:Players{zone:Hand, players:One(Target{slot:0, index:0})}, kind:Card, filter:Any})}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(2)), zone:Hand}, filter:@and(ObjectFilter::Any, ObjectFilter::OwnedBy(One(Target{slot:0, index:0})))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:DiscardObjects{objects:One(Result{result:@prior, phase:After, index:0})}}] */
reveal_target_hand_controller_choice ::= "that" "player" "reveals" "their" "hand" "and" "discards" "a" "card" "of" "your" "choice"

/* Keep the observation and optional consumer together: the choice is from the
   same target's whole hand, and later actions refer to the moved incarnation. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone(_{scope:Players{zone:Hand, players:One($target_opponent)}, kind:Card, filter:Any})}}, Optional{decider:AbilityController, body:Program{instructions:[...$observed_hand_creature_entry, ...$entered_creature_grant_sacrifice]}}] */
instructions_observed_hand_entry ::= target_opponent "reveals" "their" "hand" "." "you" "may" observed_hand_creature_entry "." entered_creature_grant_sacrifice

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(2)), zone:Hand}, filter:@and(ObjectFilter::CardType(Creature), ObjectFilter::OwnedBy(One(Target{slot:0, index:0})))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
observed_hand_creature_entry ::= "put" "a" "creature" "card" "from" "it" "onto" "the" "battlefield" "under" "your" "control"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[GrantKeyword($keyword_name)], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:One(Result{result:@back(4), phase:After, index:0})})}]}}}] */
entered_creature_grant_sacrifice ::= "that" "creature" "gains" keyword_name "." "sacrifice" "it" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* The revealed hand, payment choice and its discard share one observation and
   target owner. The independent fallback is a program, not part of the choice. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone(_{scope:Players{zone:Hand, players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0})}, kind:Card, filter:Any})}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(3)), zone:Hand}, filter:@and($adjective_nontype, ObjectFilter::OwnedBy(One(Target{slot:0, index:0})))}, count:AsManyAsCan(Constant(1))}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:_{instructions:[Effect{result:@next, operation:DiscardObjects{objects:One(Result{result:@prior, phase:After, index:0})}}]}, otherwise:$observed_hand_fallback}] */
observed_hand_optional_discard ::= "target" "opponent" "reveals" "their" "hand" "." "you" "may" "choose" "a" adjective_nontype "card" "from" "it" "." "if" "you" "do" "," "they" "discard" "it" "." "otherwise" "," observed_hand_fallback

/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([Not(State(FaceDown)), OwnedBy(One(Target{slot:0, index:0}))])}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$opponent_owned_card_destination, qualifiers:[]}}]}}]} */
observed_hand_fallback ::= "you" "may" "put" "a" "face-up" "exiled" "card" "they" "own" "into" opponent_owned_card_destination

/* @sem MovementDestination::OwnersGraveyard(CardArrival{counters:[], states:[]}) */
opponent_owned_graveyard ::= "their" "graveyard"

/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
opponent_owned_hand ::= "their" "hand"

opponent_owned_card_destination ::= opponent_owned_graveyard | opponent_owned_hand

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$observed_hand_optional_discard}} */
spell_observed_hand_optional_discard ::= observed_hand_optional_discard "."

/* The choice and its follow-up share the observed hand and player. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One($target_possessive)}, kind:Card, filter:Any})}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(3)), zone:Hand}, filter:@and($adjective_nontype, ObjectFilter::OwnedBy(One($target_possessive)))}, count:AsManyAsCan(Constant(1))}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:_{instructions:[Effect{result:@next, operation:Reveal{objects:One(Result{result:@prior, phase:After, index:0})}}, Effect{result:@next, operation:Move{objects:One(Result{result:@back(3), phase:After, index:0}), destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Draw{players:One($target_possessive), amount:$card_count}}]}, otherwise:_{}}] */
instructions_observed_hand_optional_bottom_draw ::= "look" "at" target_possessive "hand" "." "you" "may" "choose" "a" adjective_nontype "card" "from" "it" "." "if" "you" "do" "," "that" "player" "reveals" "the" "chosen" "card" "," "puts" "it" "on" "the" "bottom" "of" "their" "library" "," "then" "draws" card_count

/* Both quantities refer to the surrounding ability's captured count. */
/* @sem Instruction::[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:BoundValue(@marked)}}, Effect{result:@next, operation:DistributeCounters(_{amount:BoundValue(@marked), kind:$counter_kind, objects:$affected, any_number:true})}] */
gain_and_distribute_captured ::= "you" "gain" "that" "much" "life" "and" "distribute" "that" "many" counter_kind "counters" "among" "any" "number" "of" affected

/* The spell and permanent follow-ups belong to the same future cast permission. */
/* @sem Operation::EffectOn{subject:Players(One(AbilityController)), effects:[Term{family:FuturePlayerEffect, form:MayCastTheirNextSpellThisTurnAsThoughItHadFlashWithEffects, operands:[Filter($next_flash_creature_filter), List([$next_flash_counterproof, $next_flash_entry_counter])]}]} */
next_flash_creature_permission ::= "the" "next" next_flash_creature_filter "spell" "you" "cast" "this" "turn" "can" "be" "cast" "as" "though" "it" "had" "flash" "." next_flash_counterproof "." next_flash_entry_counter

next_flash_creature_filter ::= noun_creature | next_flash_colored_creature

/* @sem @and($adjective_color, $noun_creature) */
next_flash_colored_creature ::= adjective_color noun_creature

/* @sem Operand::Term{family:SpellEffect, form:CantBeCountered} */
next_flash_counterproof ::= "that" "spell" "can't" "be" "countered"

/* @sem Operand::Term{family:SpellEffect, form:EntersWithACounter, operands:[$entry_face_pt_counter]} */
next_flash_entry_counter ::= "that" "creature" "enters" "with" "an" "additional" entry_face_pt_counter "counter" "on" "it"

/* Both subjects receive the keyword named by the shared predicate. */
/* @sem Instruction::[Effect{result:@next, operation:CreatePerpetualEffect{objects:One($object_ref), changes:[GrantKeyword($keyword_name)]}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:$topmost_card_without_keyword, changes:[GrantAbility(Keyword($keyword_name))]}}] */
clause_paired_perpetual_keyword ::= object_ref "and" topmost_card_without_keyword "perpetually" "gain" keyword_name

/* The opponent who guesses is the announced opponent; the optional reveal
   and its wrong-guess branch stay together with that guess. */
/* @sem Instruction::[Effect{result:@next, operation:Guess{actor:One($target_opponent), filter:Chosen(CardName), player:AbilityController}}, Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:Reveal{objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})}}, If{condition:Outcome(GuessedWrong), then:$program, otherwise:_{}}]}}] */
clause_guess_named_card ::= target_opponent "guesses" "whether" "a" "card" "with" "that" "name" "is" "in" "your" "hand" "." "you" "may" "reveal" "your" "hand" "." "if" "you" "do" "and" "your" "opponent" "guessed" "wrong" "," program

/* Keep the chosen-name antecedent in the same program as its use. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_a_card_name}, ...$clause_guess_named_card] */
instructions_named_guess ::= choose_a_card_name "." clause_guess_named_card

/* A singular spell selected from the controller's own hand. */
hand_cast_population ::= hand_cast_any_spell | hand_cast_filtered_spell

/* @sem ObjectSet::Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}) */
hand_cast_any_spell ::= "a" "spell" "from" "your" "hand"

/* @sem ObjectSet::Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}) */
hand_cast_filtered_spell ::= "a" card_filter "spell" "from" "your" "hand"

/* @sem Operation::PlayWith{actor:One(AbilityController), action:CastSpell, cards:$hand_cast_population, count:Exactly(Constant(1)), terms:_{cost:Alternate(Cost{parts:[$cast_life_mana_value_cost]})}} */
cast_hand_alternative_life ::= "cast" hand_cast_population "by" cast_life_mana_value_cost

/* @sem Operation::PlayWith{actor:One(AbilityController), action:CastSpell, cards:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), count:Exactly($number_words), terms:_{cost:Alternate(Cost{parts:[$cast_life_mana_values_cost]})}} */
cast_hand_alternative_life_plural ::= "cast" number_words "spells" "from" "your" "hand" "by" cast_life_mana_values_cost

/* A linked-exile selection bounded by the latest actual die roll. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$linked_exile_cards, count:UpTo(DieResult(@die_roll))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
return_linked_cards_die_result ::= "return" "up" "to" "X" "cards" "from" "among" linked_exile_cards "to" "their" "owners'" "hands" "," "where" "X" "is" "the" "result"

/* Each owner receives their linked cards; no global actor replaces ownership. */
/* @sem Operation::Move{objects:$linked_exile_population_each, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
each_player_returns_linked_exile ::= "each" "player" "returns" "to" "their" "hand" linked_exile_population_each

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)} */
linked_exile_population_each ::= "all" "cards" "they" "own" "exiled" "with" object_ref

/* @sem Operation::Move{objects:$countered_owned_exile_population, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
put_countered_owned_exile_into_hand ::= "put" countered_owned_exile_population "into" "your" "hand"

/* @sem Operation::PutCounters{placements:[_{recipients:Objects($counter_group_set), kind:$counter_kind, amount:$counter_amount}]} */
put_counter_on_counter_group ::= "put" counter_amount counter_kind "counter" "on" counter_group_set

/* The conditional consumes the immediately preceding sacrifice receipt. */
/* @sem Instruction::[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:All, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Constant(1))})}, If{condition:Compare{left:CountObjects(Matching{objects:MovedBy{result:@prior, phase:Before, player:AbilityController}, filter:$sacrifice_receipt_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:$program, otherwise:Program{}}] */
instructions_each_sacrifice_conditional ::= "each" "player" "sacrifices" "a" filter_phrase "of" "their" "choice" "." "if" "you" "sacrificed" sacrifice_receipt_filter "this" "way" "," program

/* The producer selects at most one object, so the condition reads that result. */
/* @sem Instruction::[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Land)}, choose:AsManyAsCan(Constant(1))})}, If{condition:ObjectMatches{object:Result{result:@prior, phase:Before, index:0}, filter:$sacrifice_receipt_filter}, then:$program, otherwise:Program{}}] */
instructions_own_sacrifice_conditional ::= "sacrifice" "a" "land" "." "if" "you" "sacrifice" sacrifice_receipt_filter "this" "way" "," program

sacrifice_receipt_filter ::= sacrifice_receipt_filter_a | sacrifice_receipt_filter_an

/* @sem ObjectFilter::$filter_phrase */
sacrifice_receipt_filter_a ::= "a" filter_phrase

/* @sem ObjectFilter::$filter_phrase */
sacrifice_receipt_filter_an ::= "an" filter_phrase

/* A separately chosen population supplies each counter removal. */
/* @sem Cost::Cost{parts:[RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(AbilityController)))}), kind:$counter_kind, amount:Count(Exactly(Constant(1))), selection:_{player:AbilityController, count:Exactly($number_words)}}]}]} */
payment_remove_each_selected ::= "remove" "a" counter_kind "counter" "from" "each" "of" number_words filter_plural "you" "control"

/* Damage measured for each drawing player retains that player's source control. */
/* @sem Expr::EventHistory{event:Damage(_{source_kind:Any, sources:ControlledBy(One(Bound(0))), recipients:Objects(SameObject(Source)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:TotalAmount} */
bound_player_damage_to_source ::= "the" "amount" "of" "damage" "dealt" "to" SELF_NAME "this" "turn" "by" "sources" "they" "controlled"

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:Draw{players:One(Bound(0)), amount:$bound_player_damage_to_source}}]}}] */
clause_bound_player_draw_history ::= players_singular "draws" "cards" "equal" "to" bound_player_damage_to_source

/* The producer and failure test share the same player population and receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Sacrifice{players:All, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Discard{players:Intersection([All, Matching{binding:0, condition:Not(Compare{left:CountObjects(Matching{objects:MovedBy{result:@prior, phase:Before, player:Bound(0)}, filter:Any}), test:Compare{comparison:Greater, value:Constant(0)}})}]), amount:$card_count}}] */
instructions_players_sacrifice_cant_discard ::= "each" "player" "sacrifices" "a" filter_phrase "of" "their" "choice" "." "each" "player" "who" "can't" "discards" card_count

/* The explicit filter tests the same player's actual sacrifice receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Sacrifice{players:OpponentsOf(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Discard{players:Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Not(Compare{left:CountObjects(Matching{objects:MovedBy{result:@prior, phase:Before, player:Bound(0)}, filter:$filter_phrase_2}), test:Compare{comparison:Greater, value:Constant(0)}})}]), amount:$card_count}}] */
instructions_opponents_sacrifice_filtered_discard ::= "each" "opponent" "sacrifices" "a" filter_phrase "of" "their" "choice" "." "then" "each" "opponent" "who" "didn't" "sacrifice" "a" filter_phrase "discards" card_count

/* The player named as discarder also owns the counters measured here. */
/* @sem Operation::Discard{players:$players_singular, amount:CountCounters{recipients:Players($players_singular), kind:$counter_kind, information:CurrentOrLastKnown}} */
discard_same_player_counters ::= players_singular "discards" "a" "card" "for" "each" counter_kind "counter" "they" "have"

/* The payer and copying actor are the same player; the payment is a current operand. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$recipient_controller_player, cost:$other_payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Optional{decider:$recipient_controller_player, body:Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One($recipient_controller_player), object:ObjectRef::@self, times:Constant(1), targets:May}}]}}]}, otherwise:Program{}}] */
recipient_paid_copy ::= recipient_controller_player "may" other_payment "." "if" "the" "player" "does" "," "they" "may" "copy" self_spell "and" "may" "choose" "a" "new" "target" "for" "that" "copy"

/* Name is the enclosing card's name, and ownership stays with the controller. */
/* @sem Operation::Intensify{cards:Name(@card_name), owner:AbilityController} */
intensify_owned_named ::= "cards" "you" "own" "named" SELF_NAME "intensify"

/* Opponents make independent choices from their own permanents. */
/* @sem Instruction::[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun_creature, ControlledBy(One(Bound(0)))])}, count:AsManyAsCan(Constant(1))}}]}}] */
clause_opponents_choose_controlled ::= "each" "opponent" "chooses" "a" noun_creature "they" "control"

/* The choice count remains the actual number of kicks. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}, count:UpTo(TimesKicked(Source))}}] */
clause_choose_kicked_controlled ::= "choose" "up" "to" "X" filter_plural "you" "control" "," "where" "X" "is" "the" "number" "of" "times" "this" "spell" "was" "kicked"

/* Scope the selected batch to the choice that produced it. */
/* @sem Instruction::[...$clause_opponents_choose_controlled, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Selected(@prior)), changes:[SetController(AbilityController)], duration:Indefinite, evaluation:Snapshot}}] */
clause_opponents_choice_gain ::= clause_opponents_choose_controlled "." "you" "gain" "control" "of" "those" "creatures"

/* The phasing operation consumes precisely this choice's result. */
/* @sem Instruction::[...$clause_choose_kicked_controlled, Effect{result:@next, operation:KeywordEach{actor:One(AbilityController), action:PhaseOut{}, objects:Selected(@prior)}}] */
clause_kicked_choice_phase ::= clause_choose_kicked_controlled "." "those" "permanents" "phase" "out"

/* A following retention sentence belongs to the optional animation. */
/* @sem Instruction::[Effect{result:@next, operation:$have_animation_retained}] */
clause_have_retained_animation ::= "have" have_animation_retained "." retention_note

have_continuous_snapshot ::= continuous_snapshot | have_base_stats_population | have_base_stats_self | have_base_stats_defined | have_animation_retained | have_sticker_stats

/* The permission names the exact top-card exile in this same instruction group. */
/* @sem Instruction::[...$top_exile_permission_producer, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:$duration, evaluation:LiveObjects}}] */
instructions_top_exile_prefixed_play ::= top_exile_permission_producer "." duration "," "you" "may" "play" "it"

top_exile_permission_producer ::= card_exile_value_producer | top_exile_permission_face_down

/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
top_exile_permission_face_down ::= "exile" "the" "top" "card" "of" "your" "library" "face" "down"

/* A single randomly revealed hand card receives a casting restriction. */
/* @sem Operation::RevealFromHand{actor:$players_singular, cards:$adjective_nontype, count:Constant(1), at_random:true} */
random_filtered_hand_reveal ::= players_singular "reveals" "a" adjective_nontype "card" "at" "random" "from" "their" "hand"

/* @sem Change::GrantAbility(Casting(AdditionalCost{cost:$cost, repetition:Once})) */
perpetual_extra_cast_cost ::= "this" "spell" "costs" cost "more" "to" "cast" "."

/* @sem Instruction::[Effect{result:@next, operation:$random_filtered_hand_reveal}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Earlier{what:Selected}), changes:[$perpetual_extra_cast_cost]}}] */
instructions_random_hand_perpetual ::= random_filtered_hand_reveal "." "it" "perpetually" "gains" '"' perpetual_extra_cast_cost '"'

/* The per-player selection and its unselected result share one scope. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([AllOf([CardType(Creature), Property{property:Power, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}]), ControlledBy(One(Bound(0)))])}, count:AsManyAsCan(Constant(1))}}]}}, Effect{result:@next, operation:Destroy{objects:$unselected_chosen_creatures_population, regeneration:true}}] */
instructions_choose_each_power_then_destroy_unselected ::= "for" "each" "player" "," "choose" "a" "creature" "with" "power" number "or" "less" "that" "player" "controls" "." "then" "destroy" unselected_chosen_creatures_population

/* The dice-total reference is scoped to the roll that supplies its results. */
/* @sem Instruction::[Effect{result:@next, operation:$roll_six_sided_dice}, Effect{result:@next, operation:$return_dice_total_cards}] */
instructions_roll_total_return ::= roll_six_sided_dice "." return_dice_total_cards

/* @sem Instruction::[Effect{result:@next, operation:$roll_six_sided_dice}, Effect{result:@next, operation:$return_dice_total_cards}, ...$instructions] */
instructions_roll_total_return_tail ::= roll_six_sided_dice "." return_dice_total_cards "." instructions

/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$dice_return_card_filter}, count:AnyNumber, constraints:[TotalProperty{property:ManaValue, comparison:LessOrEqual, amount:Dice(Total)}]}], action:Move{objects:Prepared(@selection_id(0)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}} */
return_dice_total_cards ::= "return" "any" "number" "of" dice_return_card_filter "with" "total" "mana" "value" "X" "or" "less" "from" "your" "graveyard" "to" "your" "hand" "," "where" "X" "is" "the" "total" "of" "those" "results"

dice_return_card_filter ::= dice_return_any_cards | dice_return_filtered_cards

/* @sem ObjectFilter::Any */
dice_return_any_cards ::= "cards"

/* @sem $card_filter */
dice_return_filtered_cards ::= card_filter "cards"

/* The entering card is the offered payment; its arrival retains both states. */
/* @sem Cost::Cost{parts:[Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$a_card}, choose:Exactly(Constant(1))}], destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}]} */
payment_put_hand_card_attacking ::= "put" a_card "from" "your" "hand" "onto" "the" "battlefield" "tapped" "and" "attacking"

/* Return clauses share the moved object and an independently described arrival.
   The follow-up sentence describes that arriving permanent. */
/* @sem Operation::Move{objects:$affected, destination:Battlefield{controller:Player(AbilityController), arrival:$return_your_arrival}, qualifiers:[]} */
return_with_your_arrival ::= "return" affected "to" "the" "battlefield" "under" "your" "control" return_your_arrival

return_your_arrival ::= return_face_down_artifact_arrival | return_he_type_arrival

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:true, counters:[], states:[FaceDownAs{power:$number_digits, toughness:$number_digits_2, creature_type:@subtype_name($subtype), artifact:true}]} */
return_face_down_artifact_arrival ::= "face" "down" "and" "tapped" "." "it's" "a" number_digits "/" number_digits subtype "artifact" "creature"

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[], states:[Changes([CreatureTypes{mode:Add, types:Listed($becomes_types)}])]} */
return_he_type_arrival ::= "." "he's" "a" becomes_types "in" "addition" "to" "his" "other" "types"

/* @sem Operation::Move{objects:$affected, destination:Battlefield{controller:Owner, arrival:$return_face_down_land_arrival}, qualifiers:[]} */
return_with_owner_arrival ::= "return" affected "to" "the" "battlefield" "face" "down" "under" "its" "owner's" "control" return_face_down_land_arrival

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[], states:[FaceDownLand(@subtype_name($basic_land_type_consonant))]} */
return_face_down_land_arrival ::= "." "it's" "a" basic_land_type_consonant "land"

/* @sem Operation::Move{objects:$affected, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, $counter_amount]], states:[Changes($changes)]}}, qualifiers:[]} */
return_owner_counter_changes ::= "return" affected "to" "the" "battlefield" "under" "its" "owner's" "control" "with" counter_amount counter_kind "counter" "on" "it" "." "it" changes

/* A resolving payment exiles the spell and a counted set of cards with its
   printed name. Both moves are cost parts, with independent selections. */
/* @sem Cost::Cost{parts:[Move{selections:[_{objects:One(Source)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}, Move{selections:[_{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Name(@card_name)}), choose:Exactly($count_plural)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]} */
payment_exile_spell_and_named_cards ::= "exile" "this" "spell" "and" count_plural "cards" "named" SELF_NAME "from" "your" "graveyard"

/* The hand reference belongs to the immediately preceding reveal. */
/* @sem Instruction::[$callback_hand_reveal, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$revealed_hand_filtered_count}}] */
instructions_revealed_hand_draw ::= callback_hand_reveal "." "you" "draw" "a" "card" "for" "each" revealed_hand_filtered_count

/* @sem Expr::CountObjects(Matching{objects:Zone{scope:Players{zone:Hand, players:One(@that_player)}, kind:Card, filter:Any}, filter:AnyOf(@unordered([$subtype, $adjective_color]))}) */
revealed_hand_filtered_count ::= subtype "and" adjective_color "card" "in" "it"

/* The count belongs to the event subject, while the target's controller and
   the duration's object remain independent operands. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(CountCounters(_{recipients:Objects(One($it_ordinary_pronoun)), kind:$counter_kind, information:CurrentOrLastKnown})), filter:AllOf([$adjective_nontype, ControlledBy(OpponentsOf(AbilityController))])})) */
event_counter_opponent_targets ::= "for" "each" counter_kind "counter" "on" it_ordinary_pronoun "," "exile" "up" "to" "one" "target" adjective_nontype "permanent" "an" "opponent" "controls"

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$event_counter_opponent_targets, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReturnAfter{objects:Transition{result:@prior, phase:After}, duration:WhileOnBattlefield($object_ref)}}] */
clause_exile_event_counter_targets_until ::= event_counter_opponent_targets "until" object_ref "leaves" "the" "battlefield"

/* The failure count is scoped to this mandatory discard producer. */
/* @sem Instruction::[$mandatory_discard_receipt, Effect{result:@next, operation:$discard_failure_reward}] */
mandatory_discard_failure_sequence ::= mandatory_discard_receipt "." discard_failure_reward

/* @sem Instruction::ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:Bound(0), cost:Cost{parts:[Discard{count:$card_count, filter:Any}]}}}]}} */
mandatory_discard_receipt ::= players_singular "discards" card_count

/* @sem Expr::CountPlayers(Intersection([$players_singular, Intersection([$players_singular, Matching{binding:0, condition:Not(PlayerTook{player:Bound(0), result:@marked})}])])) */
discard_failure_count ::= "for" players_singular "who" "can't" ","

 discard_failure_reward ::= discard_failure_draw | discard_failure_life | discard_failure_counters

/* @sem Operation::Draw{players:One(AbilityController), amount:$discard_failure_count} */
discard_failure_draw ::= discard_failure_count "you" "draw" "a" "card"

/* @sem Operation::GainLife{players:One(AbilityController), amount:Multiply([$value, $discard_failure_count])} */
discard_failure_life ::= discard_failure_count "you" "gain" value "life"

/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:Multiply([$value, $discard_failure_count])}]} */
discard_failure_counters ::= discard_failure_count "put" value counter_kind "counters" "on" affected

/* The payer and the payment receipt are retained in the fallback. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$player_ref, cost:$cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:$program, otherwise:Program{}}] */
clause_player_payment_declined ::= player_ref "may" "pay" cost "." "if" "the" "player" "doesn't" "," program

/* The threshold qualifies the target in each opponent's partition. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:OpponentsOf(AbilityController), each:UpTo(Constant(1))}, filter:AllOf([$noun, Property{property:ManaValue, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}])})) */
each_opponent_targets_value ::= "up" "to" "one" "target" noun "that" "player" "controls" "with" "mana" "value" number "or" "greater"

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$each_opponent_targets_value, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_exile_each_opponent_value ::= "for" "each" "opponent" "," "exile" each_opponent_targets_value

/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::AdditionalPhase{phases:Beginning}}}] */
clause_additional_beginning_phase ::= "there" "is" "an" "additional" "beginning" "phase" "after" "this" "phase"

/* A revealed matching card and its destination retain independent operands. */
/* @sem ObjectSet::Matching{objects:Observed(0), filter:$filter_phrase} */
observed_matching_card ::= "the" filter_phrase "card"

/* @sem Operation::Move{objects:$observed_matching_card, destination:$battlefield_control_yours, qualifiers:[]} */
move_observed_filtered_to_control ::= "you" "put" observed_matching_card "onto" "the" "battlefield" battlefield_control_yours

/* The event quantity bounds targets controlled by the event player. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(EventAmount), filter:@and($filter_plural, ObjectFilter::ControlledBy(One(EventSubject)))})) */
event_amount_controlled_targets ::= "up" "to" "that" "many" "target" filter_plural "that" "player" "controls"

/* @sem Operation::Move{objects:$event_amount_controlled_targets, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_event_amount_controlled ::= "return" event_amount_controlled_targets "to" "their" "owner's" "hand"

/* Added color and creature types are independent entry changes. */
/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[], states:[Changes([Colors{mode:Add, colors:[$mana_color_word]}, CreatureTypes{mode:Add, types:Listed($becomes_types)}])]} */
added_color_type_entry ::= "it's" "a" mana_color_word becomes_types "in" "addition" "to" "its" "other" "colors" "and" "types"

/* @sem Operation::Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:$added_color_type_entry}, qualifiers:[]} */
move_selected_with_added_identity ::= added_color_type_entry

/* Choose a permanent from the battlefield without making it a target. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan(Constant(1))}}] */
instructions_choose_battlefield ::= "choose" "a" filter_phrase "on" "the" "battlefield"

/* An explicit subject leaves the untap instruction unchanged. */
/* @sem $instructions_untap_choice */
instructions_you_untap_choice ::= "you" instructions_untap_choice

/* @sem Operation::Move{objects:$observed_library_cards, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_observed_face_down ::= "exile" observed_library_cards "face" "down"

/* @sem ObjectSet::InZone{objects:Observed(@prior), zone:Library} */
observed_library_cards ::= "them"

/* A single milled card supplies its actual arrival receipt to the property sum. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:Constant(1)}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$milled_card_stat}}] */
instructions_milled_card_stat_draw ::= "mill" "a" "card" "," "then" "draw" "cards" "equal" "to" milled_card_stat

/* @sem Expr::Aggregate{objects:Transition{result:@marked, phase:After}, property:$receipt_stat, aggregation:Sum} */
milled_card_stat ::= "the" "milled" "card's" receipt_stat

/* Keep the drawing player and the discarded-card receipt in the same group. */
/* @sem Instruction::[Effect{result:@mark, operation:Discard{players:One($target_player), amount:$card_count, random:false}}, Effect{result:@next, operation:Draw{players:One($target_player), amount:CountObjects(Transition{result:@marked, phase:Before})}}] */
instructions_player_discard_receipt_pair ::= target_player "discards" card_count "," "then" "draws" "as" "many" "cards" "as" "they" "discarded" "this" "way"

/* Each target is announced separately; only the latter is chosen by an opponent. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamageParts{source:$damage_source_ref, parts:[_{recipients:$recipients_any_target, amount:$number}, _{recipients:$recipients_opponent_choice, amount:$number_2}], preventable:true}}] */
clause_damage_opponent_choice ::= damage_source_ref "deals" number "damage" "to" recipients_any_target "and" number "damage" "to" recipients_opponent_choice

/* The named population and the explicit object form one snapshot reused by
   the tap and by the subsequent control change. */
/* @sem ObjectFilter::@and($filter_plural, $modifier_referenced_name) */
tap_named_population ::= filter_plural modifier_referenced_name

/* @sem Instruction::[Effect{result:@mark, operation:NoteObjects{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($object_ref), $tap_named_population])}}}, Effect{result:@next, operation:SetTapped{objects:Selected(@marked), tapped:true}}, Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Player, terms:_{count:Exactly(Constant(1)), options:[Players(OpponentsOf(AbilityController))]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:$object_ref, affected:Objects(Selected(@marked)), changes:[SetController(Chosen)], duration:Indefinite, evaluation:Snapshot}}] */
clause_tap_named_group_opponent_control ::= "tap" object_ref "and" "all" tap_named_population "," "then" "an" "opponent" "gains" "control" "of" "them"

/* The spell filter remains an operand of the historical count. */
/* @sem Operation::Draw{players:One(AbilityController), amount:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $draw_history_spell_types)}, window:ThisTurn, measure:Occurrences}} */
draw_per_other_cast_history ::= "draw" "a" "card" "for" "each" "other" draw_history_spell_types "spell" "you've" "cast" "this" "turn"

/* @sem ObjectFilter::AnyOf([$draw_history_kind, $draw_history_kind_2]) */
draw_history_spell_types ::= draw_history_kind "and" draw_history_kind

draw_history_kind ::= spell_instant | spell_sorcery

/* The counter operation and its recorded result are matched together. */
/* @sem Instruction::[Effect{result:@mark, operation:Counter{objects:$receipt_counter_spell_set, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountObjects(Recorded(@marked))}}] */
instructions_counter_receipt_draw ::= "counter" receipt_counter_spell_set "." "draw" "a" "card" "for" "each" "spell" "countered" "this" "way"

receipt_counter_spell_set ::= receipt_counter_spells | counter_many_spells

/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:Not(SameObject(Source))} */
receipt_counter_spells ::= "all" "other" "spells"

/* The selected battlefield population and its before receipt stay together. */
/* @sem Instruction::[Effect{result:@mark, operation:Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:AnyNumber}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountObjects(Transition{result:@marked, phase:Before})}}] */
instructions_sacrifice_receipt_draw ::= "sacrifice" "any" "number" "of" filter_plural "." "draw" "a" "card" "for" "each" "permanent" "sacrificed" "this" "way"

/* Selection and the property of its selected object share one receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController)))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:$chosen_draw_property, information:CurrentOrLastKnown}}}] */
instructions_choose_controlled_property_draw ::= "choose" "a" filter_phrase "you" "control" "," "then" "draw" "cards" "equal" "to" "its" chosen_draw_property

/* @sem Property::ToxicValue */
chosen_draw_property ::= "total" "toxic" "value"

/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$noun}), count:AnyNumber, constraints:[TotalProperty{property:ManaValue, comparison:LessOrEqual, amount:ObjectProperty{object:Source, property:Intensity, information:CurrentOrLastKnown}}]}], action:Move{objects:Prepared(@selection_id(0)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}} */
return_intensity_graveyard_cards ::= "return" "any" "number" "of" noun "cards" "with" "total" "mana" "value" "X" "or" "less" "from" "your" "graveyard" "to" "the" "battlefield" "," "where" "X" "is" "this" "spell's" "intensity"

/* @sem Operation::Intensify{cards:$subtype, owner:AbilityController} */
intensify_owned_subtype_cards ::= "all" subtype "cards" "you" "own" "intensify"

/* Intensifying the owned subtype follows the intensity-limited return. */
/* @sem Instruction::[Effect{result:@next, operation:$return_intensity_graveyard_cards}, Effect{result:@next, operation:$intensify_owned_subtype_cards}] */
instructions_intensity_return_and_intensify ::= return_intensity_graveyard_cards "." NEWLINE intensify_owned_subtype_cards

/* A random selection retains its own population independently of later limits. */
/* @sem Operation::Move{objects:@selection(SelectionStep::_{binding:0, objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), chooser:Chance, count:AsManyAsCan(Constant(1))}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
random_graveyard_return ::= "return" "a" filter_phrase "card" "at" "random" "from" "your" "graveyard" "to" "the" "battlefield"

/* The target remains in the controller’s graveyard and reads announced X. */
/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($filter_phrase, $modifier_power_x_or_less, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_power_limited_graveyard_card ::= "return" "target" filter_phrase "card" modifier_power_x_or_less "from" "your" "graveyard" "to" "the" "battlefield"

/* Distributive destroy uses the singular counter qualifier. */
/* @sem Operation::Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, $modifier_without_named_counter)}, regeneration:true} */
destroy_each_without_named_counter ::= "destroy" "each" filter_phrase modifier_without_named_counter

/* The written ordinal and moved object remain independent operands. */
/* @sem Operation::Move{objects:One($object_ref), destination:Library{position:FromTop($your_library_depth), order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
move_your_library_depth ::= "put" object_ref "into" "your" "library" your_library_depth "from" "the" "top"

/* The moved object's owner chooses the end of their library. */
/* @sem Operation::Move{objects:One($object_ref), destination:$owner_library_choice_destination, qualifiers:[]} */
move_owner_choice_library ::= "the" "owner" "of" object_ref "puts" "it" owner_library_choice_destination

/* The witnessed personal-library positions share their typed ordinals. */
your_library_depth ::= library_ordinal_third | library_depth_fourth

/* The event and redirect compose with the same temporary replacement contract. */
/* @sem Operation::CreateReplacement{event:$temporary_dying_event, limit:UntilExpired, duration:$this_duration, body:$temporary_graveyard_exile_it} */
exile_matching_instead_of_dying ::= "if" temporary_dying_event this_duration "," temporary_graveyard_exile_it "instead"

/* @sem EventSpec::ZoneChange{objects:$die_exile_any, from:Battlefield, to:Graveyard} */
temporary_dying_event ::= die_exile_any "would" "die"

/* A color choice embedded in a protection grant. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[Term{family:ChoosableColor, form:AnyColor}]}} */
protection_color_choice ::= "the" "color" "of" "your" "choice"

/* A basic land type choice embedded in a type change. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:BasicLandType, terms:_{count:Exactly(Constant(1)), options:[]}} */
embedded_basic_land_choice ::= "the" "basic" "land" "type" "of" "your" "choice"

/* A chosen land type can be added for any supported duration and subject. */
/* @sem Instruction::[Effect{result:@next, operation:$embedded_basic_land_choice}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[ChosenType(_{kind:LandType, mode:Add})], duration:$duration, evaluation:Snapshot}}] */
clause_add_chosen_basic_land_type ::= duration "," affected "becomes" embedded_basic_land_choice "in" "addition" "to" "its" "other" "types"

/* The controller may gain protection from a chosen color for a duration. */
/* @sem Instruction::[Effect{result:@next, operation:$protection_color_choice}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(GrantKeyword(Protection(Objects(_{kind:Any, filter:Chosen(Color)}))))], duration:$duration, evaluation:LiveObjects}}] */
clause_you_gain_chosen_color_protection ::= "you" "gain" "protection" "from" protection_color_choice duration

/* The payer chooses whether the ability controller creates these tokens. */
/* @sem Cost::Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:$token_groups, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}]} */
payment_have_you_create ::= "have" "you" "create" token_groups

/* Counter anaphors are bound by their threshold, preserving its object and kind. */
/* @sem Instruction::[If{condition:ObjectMatches{object:$object_ref, filter:Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$value})}, then:Program{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($object_ref)), kind:$counter_kind, amount:All}]}}, Effect{result:@next, operation:$operation}]}, otherwise:Program{}}] */
clause_counter_threshold_remove_all_of_them ::= "if" "there" "are" value "or" "more" counter_kind "counters" "on" object_ref "," "remove" "all" "of" "them" "and" operation

/* @sem Instruction::[If{condition:ObjectMatches{object:$object_ref, filter:Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$value})}, then:Program{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($object_ref)), kind:$counter_kind, amount:All}]}}, Effect{result:@next, operation:$operation}, Effect{result:@next, operation:$operation_2}]}, otherwise:Program{}}] */
clause_counter_threshold_remove_serial_then ::= "if" "there" "are" value "or" "more" counter_kind "counters" "on" object_ref "," "remove" "those" "counters" "," operation "," "then" operation

/* @sem Instruction::[If{condition:ObjectMatches{object:$object_ref, filter:Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$value})}, then:Program{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($object_ref)), kind:$counter_kind, amount:All}]}}, Effect{result:@next, operation:$operation}, Effect{result:@next, operation:$operation_2}]}, otherwise:Program{}}] */
clause_counter_threshold_remove_serial_and ::= "if" "there" "are" value "or" "more" counter_kind "counters" "on" object_ref "," "remove" "those" "counters" "," operation "," "and" operation

/* @sem Instruction::[If{condition:ObjectMatches{object:$her_ref, filter:Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$value})}, then:Program{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($her_ref)), kind:$counter_kind, amount:All}]}}, Effect{result:@next, operation:$operation}]}, otherwise:Program{}}] */
clause_counter_threshold_remove_her ::= "if" "there" "are" value "or" "more" counter_kind "counters" "on" her_ref "," "remove" "those" "counters" "and" operation

/* A reusable perpetual grant over a filtered hand population. */
/* @sem Operation::CreatePerpetualEffect{objects:$hand_cards_population, changes:[GrantAbility($quoted_cost_reduction)]} */
hand_cards_perpetual_reduction ::= hand_cards_population "perpetually" "gain" quoted_cost_reduction

/* @sem Ability::Casting(ReduceCost([_{amount:$braced_amount}])) */
quoted_cost_reduction ::= '"' "this" "spell" "costs" braced_amount "less" "to" "cast" "." '"'

/* The random choice and its consumer are scoped together. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$random_hand_card_population, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:[GrantAbility($quoted_cost_reduction)]}}] */
instructions_random_hand_grant_cast_discount ::= "a" "random" random_hand_card_population "perpetually" "gains" quoted_cost_reduction

/* @sem Operation::Move{objects:$ordered_card_per_player, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_card_per_player_down ::= "exile" ordered_card_per_player

/* @sem Operation::Move{objects:$ordered_with_affected, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[ExilePile{shuffled:true}]}}, qualifiers:[]} */
exile_shuffled_pile ::= "exile" ordered_with_affected "in" "a" "face-down" "pile" "," "shuffle" "that" "pile"

/* These permissions are composed only with an immediately preceding, marked
   exile producer. The inverse therefore checks the producer and destination. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:$card_count_many, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
permission_exile_library_many ::= "exile" "the" "top" card_count_many "of" "your" "library"

/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:LibraryTops(All), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
permission_exile_each_library ::= "exile" "the" "top" "card" "of" "each" "player's" "library"

/* @sem Instruction::[...$permission_exile_library_many, ...$permission_exiled_many] */
instructions_exile_many_permission ::= permission_exile_library_many "." permission_exiled_many

/* @sem Instruction::[...$permission_exile_each_library, ...$permission_exiled_many] */
instructions_exile_each_permission ::= permission_exile_each_library "." permission_exiled_many

/* @sem Instruction::[...$card_exile_value_producer, ...$permission_exiled_one] */
instructions_exile_one_permission ::= card_exile_value_producer "." permission_exiled_one

permission_exiled_one ::= permission_exiled_it_until | permission_exiled_that_until | permission_exiled_next_turn

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:UntilAnotherExiled{by:One(AbilityController), with:$object_ref}, evaluation:LiveObjects}}] */
permission_exiled_it_until ::= "you" "may" "play" "it" "until" "you" "exile" "another" "card" "with" object_ref

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:UntilAnotherExiled{by:One(AbilityController), with:$object_ref}, evaluation:LiveObjects}}] */
permission_exiled_that_until ::= "you" "may" "play" "that" "card" "until" "you" "exile" "another" "card" "with" object_ref

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:DuringNextTurn(AbilityController), evaluation:LiveObjects}}] */
permission_exiled_next_turn ::= "during" "your" "next" "turn" "," "you" "may" "play" "that" "card"

permission_exiled_many ::= permission_exiled_free | permission_exiled_limited | permission_exiled_any_color

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:Either, filter:Any}, terms:_{cost:Free}})], duration:$this_duration, evaluation:LiveObjects}}] */
permission_exiled_free ::= "you" "may" "play" "them" this_duration "without" "paying" "their" "mana" "costs"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:Either, filter:Any}, terms:_{limit:Total(2), cost:Normal}})], duration:$duration, evaluation:LiveObjects}}] */
permission_exiled_limited ::= "you" "may" "play" "up" "to" "two" "of" "those" "cards" duration

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:$object_ref, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:Either, filter:Any}, terms:_{cost:Normal, spend_as:AnyColor}})], duration:$this_duration, evaluation:LiveObjects}}] */
permission_exiled_any_color ::= "you" "may" "play" "those" "cards" this_duration "," "and" "you" "may" "spend" "mana" "as" "though" object_ref "were" "mana" "of" "any" "color" "to" "cast" "those" "spells"

/* The second return repeats the first return's source and destination.  Both
   filters remain independent operands of the two sequential moves. */
/* @sem Instruction::[Effect{result:@next, operation:$return_all_private_cards}, Effect{result:@next, operation:Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$private_card_transfer_filter}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
instructions_graveyard_return_same ::= return_all_private_cards "," "then" "do" "the" "same" "for" private_card_transfer_filter "cards"

/* A linked target retains its value test and the source that exiled it. */
/* @sem Operation::Move{objects:InZone{objects:One($linked_value_target), zone:Exile}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]} */
move_linked_target_graveyard ::= "put" linked_value_target "into" "its" "owner's" "graveyard"

/* A constrained target group remains a separate operand of the move. */
/* @sem Operation::Move{objects:$graveyard_targets_total_value, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_graveyard_targets_total_value ::= "return" graveyard_targets_total_value "to" "the" "battlefield"

/* The follow-up refers to the arrivals of this specific graveyard move. */
/* @sem Instruction::[Effect{result:@next, operation:$return_all_private_cards}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Transition{result:@prior, phase:After}), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}] */
instructions_return_all_grant ::= return_all_private_cards "." "they" "gain" keyword_name duration

/* Repeat a composed action while a condition holds. */
/* @sem Instruction::[Repeatable{instructions:[Effect{result:@next, operation:$repeatable_action}, If{condition:$repeat_condition, then:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}]}] */
instructions_repeat_condition ::= repeatable_action "." repeat_condition "," "repeat" "this" "process"

repeatable_action ::= conjure_named_hand | conjure_source_spellbook_personal | conjure_source_spellbook_many

repeat_condition ::= repeat_condition_if | repeat_condition_then_if

/* @sem Condition::$condition_hand_fewer_than */
repeat_condition_if ::= "if" condition_hand_fewer_than

/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Less, value:$value}} */
repeat_condition_then_if ::= "then" "if" "you" "have" "fewer" "cards" "in" "hand" "than" value

/* Populations and destination compose independently for graveyard transfers. */
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$filter_phrase} */
all_graveyard_transfer_cards ::= "all" filter_phrase "cards" "from" "all" "graveyards"

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:@and($filter_phrase, $all_graveyard_history)} */
all_graveyard_transfer_history ::= "all" filter_phrase "cards" "in" "all" "graveyards" all_graveyard_history

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:AnyNumber, filter:AllOf([$noun, OwnedBy(OpponentsOf(AbilityController))]), constraints:[DifferentOwners]})) */
opponent_graveyard_transfer_targets ::= "for" "each" "opponent" "," "put" "up" "to" "one" "target" noun "card" "from" "that" "player's" "graveyard"

/* @sem Operation::Move{objects:$all_graveyard_transfer_cards, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
put_graveyard_population_battlefield ::= "put" all_graveyard_transfer_cards "onto" "the" "battlefield" "under" "your" "control"

/* @sem Operation::Move{objects:$all_graveyard_transfer_history, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
put_battlefield_graveyard_population ::= "put" "onto" "the" "battlefield" "under" "your" "control" all_graveyard_transfer_history

/* @sem Operation::Move{objects:$opponent_graveyard_transfer_targets, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
put_opponent_graveyard_targets_battlefield ::= opponent_graveyard_transfer_targets "onto" "the" "battlefield" "under" "your" "control"

all_graveyard_history ::= all_graveyard_history_anywhere | all_graveyard_history_battlefield

/* @sem ObjectFilter::History{event:PutIntoGraveyard, window:ThisTurn} */
all_graveyard_history_anywhere ::= "that" "were" "put" "there" "from" "anywhere" "this" "turn"

/* @sem ObjectFilter::History{event:DiedOrPutFromBattlefield, window:ThisTurn} */
all_graveyard_history_battlefield ::= "that" "were" "put" "there" "from" "the" "battlefield" "this" "turn"

/* A destination-first return uses the same independently qualified card target. */
/* @sem Operation::Move{objects:One($target_card_qualified_after_your_graveyard), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_battlefield_before_target ::= "return" "to" "the" "battlefield" target_card_qualified_after_your_graveyard

/* The permission names the exact singular card paid into exile. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:_{parts:[Move{selections:[_{objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$adjective_nontype}), choose:Exactly(Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0}), from:Exile, action:CastSpell, filter:Any})], duration:WhileExiled(Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0}), evaluation:LiveObjects}}]}, otherwise:_{}}] */
clause_optional_hand_exile_permission ::= "you" "may" "exile" "a" adjective_nontype "card" "from" "your" "hand" "." "you" "may" "cast" "that" "card" "for" "as" "long" "as" "it" "remains" "exiled"

/* The target spell's controller moves that same spell, preserving the arrival. */
/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:Any}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[[$counter_kind, $counter_amount]], states:[]}}, qualifiers:[]} */
spell_controller_exile_with_counters ::= "target" "spell's" "controller" "exiles" "it" "with" counter_amount counter_kind "counters" "on" "it"

/* The upkeep and copy retain the target and the immediately preceding exile arrival. */
/* @sem Operation::CreateTrigger{event:Turn{point:UpkeepBegins, players:One(ControllerOf(Target{slot:0, index:0}))}, duration:WhileExiled(Result{result:@prior, phase:After, index:0}), body:_{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One(Result{result:@back(3), phase:After, index:0})), kind:$counter_kind, amount:Count(Exactly(Constant(1)))}]}}, If{condition:ObjectMatches{object:Result{result:@back(3), phase:After, index:0}, filter:Counters(_{kind:$counter_kind_2, comparison:Equal, value:Constant(0)})}, then:_{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(ControllerOf(Target{slot:0, index:0})), object:Target{slot:0, index:0}, times:Constant(1), targets:Same, card:Result{result:@back(4), phase:After, index:0}}}]}, otherwise:_{}}]}, intervening_if:ObjectMatches{object:Result{result:@back(4), phase:After, index:0}, filter:InZone(Shared(Exile))}, announcement:_{}} */
exiled_spell_counter_upkeep_copy ::= "at" "the" "beginning" "of" "each" "of" "that" "player's" "upkeeps" "," "if" "that" "card" "is" "exiled" "," "remove" "a" counter_kind "counter" "from" "it" "." "if" "the" "card" "has" "no" counter_kind "counters" "on" "it" "," "the" "player" "puts" "it" "onto" "the" "stack" "as" "a" "copy" "of" "the" "original" "spell"

/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$spell_controller_exile_with_counters}, Effect{result:@next, operation:$exiled_spell_counter_upkeep_copy}]}} */
spell_exile_counter_upkeep_copy ::= spell_controller_exile_with_counters "." NEWLINE exiled_spell_counter_upkeep_copy "."

/* A resolution payment returns an owned permanent to its owner's hand. */
/* @sem Cost::Cost{parts:[Move{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, OwnedBy(One(AbilityController))])}, choose:Exactly($counter_amount)}], destination:OwnersHand(CardArrival{counters:[], states:[]})}]} */
payment_return_owned_permanent ::= "return" counter_amount filter_phrase "you" "own" "to" "your" "hand"

/* The two selections are tied to the immediately preceding mill receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Mill{players:One(AbilityController), amount:$number}}, Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@prior, phase:After}, filter:$noun}, count:Exactly(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}, Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@back(4), phase:After}, filter:$noun_2}, count:Exactly(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
instructions_mill_choose_two_types ::= "mill" number "cards" "." "you" "may" "put" "a" noun "card" "and" "/" "or" "a" noun "card" "from" "among" "them" "into" "your" "hand"

/* Populations and target announcements are independent operands of library moves.
   Possessive destination wording is kept with the matching population owner. */
/* @sem Operation::Move{objects:$your_graveyard_card_population, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
shuffle_your_graveyard_cards ::= "shuffle" your_graveyard_card_population "into" "your" "library"

/* @sem Operation::Move{objects:$target_graveyard_card_population, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
shuffle_target_graveyard_cards ::= "shuffle" target_graveyard_card_population "into" "that" "player's" "library"

/* @sem Operation::Move{objects:$self_and_your_graveyard, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
shuffle_self_graveyard_union ::= "shuffle" self_and_your_graveyard "into" "their" "owner's" "library"

/* @sem Operation::Move{objects:$self_and_common_graveyard_targets, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
shuffle_self_common_graveyard_targets ::= "shuffle" self_and_common_graveyard_targets "into" "their" "owners'" "libraries"

/* @sem Operation::Move{objects:$other_graveyard_card_target, destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
put_other_graveyard_card_bottom ::= "put" other_graveyard_card_target "on" "the" "bottom" "of" "its" "owner's" "library"

/* An explicit singular player chooses one unrestricted value. The chosen
   domain is a reusable operand shared by parsing and inverse printing. */
/* @sem Operation::ChooseValue{choosers:$players_singular, kind:$unrestricted_choice_kind, terms:_{count:Exactly(Constant(1)), options:[]}} */
player_chooses_unrestricted_value ::= players_singular "chooses" unrestricted_choice_kind

unrestricted_choice_kind ::= unrestricted_choice_number | unrestricted_choice_land_type | unrestricted_choice_basic_land_type

/* @sem ValueKind::Number */
unrestricted_choice_number ::= "a" "number"

/* @sem ValueKind::LandType */
unrestricted_choice_land_type ::= "a" "land" "type"

/* @sem ValueKind::BasicLandType */
unrestricted_choice_basic_land_type ::= "a" "basic" "land" "type"

/* Graveyard selections and battlefield arrivals retain independent operands. */
/* @sem Operation::Move{objects:$graveyard_event_optional_targets, destination:$graveyard_entry_attacking, qualifiers:[]} */
graveyard_entry_move_optional ::= "put" graveyard_event_optional_targets graveyard_entry_attacking

/* @sem Operation::Move{objects:$graveyard_range_targets, destination:$graveyard_entry_extra_counter, qualifiers:[]} */
graveyard_entry_move_range ::= "put" graveyard_range_targets graveyard_entry_extra_counter

/* @sem Operation::Move{objects:One($target_card), destination:$graveyard_counter_destination, qualifiers:[]} */
graveyard_entry_return ::= "return" target_card graveyard_counter_destination

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{player:$player_ref}]}} */
graveyard_entry_attacking ::= "onto" "the" "battlefield" "under" "your" "control" "." "it" "enters" "tapped" "and" "attacking" player_ref

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[]}} */
graveyard_entry_extra_counter ::= "onto" "the" "battlefield" "under" "your" "control" "." "each" "of" "them" "enters" "with" "an" "additional" counter_kind "counter" "on" "it"

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, $counter_amount]], states:[]}} */
graveyard_counter_destination ::= "to" "the" "battlefield" "with" counter_amount "additional" counter_kind "counters" "on" "it"

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Creature), GrantKeyword($keyword_value)] */
entry_stats_type_keyword ::= "it's" "a" value "/" value becomes_types "creature" "with" keyword_value "in" "addition" "to" "its" "other" "types"

/* A later action replaces the first action only when its condition holds. */
/* @sem Instruction::[If{condition:$condition, then:_{instructions:[Effect{result:@next, operation:$gain_control_of}]}, otherwise:_{instructions:[Effect{result:@next, operation:$tap_objects}]}}] */
instructions_action_instead_if ::= tap_objects "." gain_control_of "instead" "if" condition

/* Select any player tied for the greatest life total. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Player, terms:_{count:Exactly(Constant(1)), options:[Players(Matching{binding:0, condition:Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:Equal, value:AmongPlayers{players:All, number:Life, aggregation:Maximum}}}})]}} */
choose_player_most_life ::= "choose" "a" "player" "with" "the" "most" "life" "or" "tied" "for" "most" "life"

/* A willing opponent pays; the conditional program uses that payment's result. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:FirstWilling(OpponentsOf(AbilityController)), cost:$willing_sacrifice_cost, optional:true}}, If{condition:PaymentChosen(@marked), then:$program, otherwise:Program{}}] */
instructions_any_opponent_may_pay ::= "any" "opponent" "may" willing_sacrifice_cost "." "if" "they" "do" "," program

/* The loop binds the selected creature for both independently authored choices. */
/* @sem Instruction::[ForEachObject{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo($number), filter:AllOf([CardType(Creature), ControlledBy(OthersThan(AbilityController))])})), binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseAction{actor:One(ControllerOf(Bound(0))), options:[List([Program($bound_creature_villainous_option)]), List([Program($bound_creature_villainous_option_2)])], villainous:true}}]}}] */
clause_target_creatures_villainous ::= "choose" "up" "to" number "target" "creatures" "you" "don't" "control" "." "for" "each" "of" "them" "," "that" "creature's" "controller" "faces" "a" "villainous" "choice" "—" bound_creature_villainous_option "," "or" bound_creature_villainous_option

bound_creature_villainous_option ::= bound_creature_rewrite | bound_creature_copy_token

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Bound(0))), changes:[SetBasePowerToughness{power:$number_digits, toughness:$number_digits_2}, Colors{mode:Set, colors:[$mana_color_word]}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetCardTypes([Creature]), RemoveAllAbilities], duration:Indefinite, evaluation:Snapshot}}]} */
bound_creature_rewrite ::= "that" "creature" "becomes" "a" number_digits "/" number_digits mana_color_word becomes_types "creature" "and" "loses" "all" "abilities"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Bound(0), exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
bound_creature_copy_token ::= "you" "create" "a" "token" "that's" "a" "copy" "of" "it"

/* A postposed condition is evaluated in the delayed body, not at creation. */
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[If{condition:$condition_one, then:Program{instructions:$may_body}, otherwise:Program{}}]}}}] */
clause_delayed_end_conditional ::= may_body "at" "the" "beginning" "of" "the" "next" "end" "step" "if" condition_one

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:OpponentsOf(AbilityController), each:UpTo(Constant(1))}, filter:$filter_phrase})) */
each_opponent_up_to_one ::= "up" "to" "one" "target" filter_phrase "that" "player" "controls"

/* The singular target for each opponent has one distinct controller per target. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(CountPlayers(OpponentsOf(AbilityController))), filter:AllOf([$filter_phrase, ControlledBy(OpponentsOf(AbilityController))]), constraints:[DifferentControllers]})) */
each_opponent_distinct_target ::= "target" filter_phrase "that" "player" "controls"

/* A targeted opponent chooses a permanent; the choice and movement have
   separate result identities. The graveyard continuation below is scoped to
   the same announced opponent. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$target_opponent, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan($counter_amount)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
target_opponent_exiles_choice ::= target_opponent "exiles" counter_amount filter_phrase

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:Target{slot:@last_slot, index:0}, objects:Zone{scope:Players{zone:Graveyard, players:One(Target{slot:@last_slot, index:0})}, kind:Card, filter:$adjective_nontype}, count:AsManyAsCan($counter_a)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
target_opponent_exiles_graveyard_choice ::= "they" "exile" counter_a adjective_nontype "card" "from" "their" "graveyard"

/* @sem Instruction::[...$target_opponent_exiles_choice, ...$target_opponent_exiles_graveyard_choice] */
instructions_target_opponent_exiles_two_zones ::= target_opponent_exiles_choice "," "then" target_opponent_exiles_graveyard_choice

/* A player chooses a battlefield population in proportion to a live count.
   Restrict the count to current zones, so no action receipt is inferred. */
/* @sem Operation::ChooseObjects{player:$player_ref, objects:$choice_battlefield_population, count:AsManyAsCan($choice_live_count)} */
choose_battlefield_for_each ::= player_ref "chooses" choice_battlefield_population "for" "each" choice_live_count

choice_live_count ::= count_each_card_graveyard | count_each_card_hand | count_each_permanent

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase} */
choice_battlefield_population ::= "a" filter_phrase

/* The untap consumes the preceding choice, including already untapped objects. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_battlefield_for_each}, Effect{result:@next, operation:SetTapped{objects:Selected(@prior), tapped:false}}] */
clause_choose_each_untap ::= choose_battlefield_for_each "," "then" "untaps" "those" "permanents"

/* A payment can guard any independently described instruction sequence. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$player_ref, cost:$cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_unless_player_payment ::= "unless" player_ref "pays" cost "," conjoined

/* The offered action remains optional for its own decider after payment is declined. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$player_ref, cost:$cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:$clause_may}, otherwise:Program{}}] */
clause_optional_unless_player_payment ::= clause_may "unless" player_ref "pays" cost

/* The owner is the player bound by the enclosing control-transfer loop. */
/* @sem ObjectFilter::AllOf([$filter_plural, OwnedBy(One(Bound(0)))]) */
control_owned_plural ::= "all" filter_plural "they" "own"

/* @sem ObjectFilter::AllOf([$filter_phrase, OwnedBy(One(Bound(0))), ControlledBy(One(AbilityController))]) */
control_owned_singular_you ::= "each" filter_phrase "they" "own" "that" "you" "control"

control_owned_population ::= control_owned_plural | control_owned_singular_you

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$control_owned_population}), changes:[SetController(Bound(0))], duration:Indefinite, evaluation:Snapshot}}]}}] */
clause_players_regain_owned ::= players_singular "gains" "control" "of" control_owned_population

/* The selection count and eligible plural population are independent operands. */
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$plural_three_union}, choose:$count_any_number}) */
sacrifice_counted_union ::= "sacrifice" count_any_number plural_three_union

/* The comparison population is independently specified by the extreme modifier. */
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_nonlist_head, $modifier_extreme_among)}, choose:AsManyAsCan($counter_amount)}) */
sacrifice_extreme_selection ::= "sacrifice" counter_amount filter_nonlist_head modifier_extreme_among

/* A simultaneous list keeps each separate choice in the same player loop. */
/* @sem Operation::Sacrifice{players:One(Bound(0)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly($counter_amount)} */
sacrifice_list_member ::= counter_amount filter_phrase

/* @sem Operation::[$sacrifice_list_member] */
sacrifice_list_last ::= "and" sacrifice_list_member

/* @sem Operation::[$sacrifice_list_member, ...$sacrifice_list_long_tail] */
sacrifice_list_more ::= "," sacrifice_list_member sacrifice_list_long_tail

sacrifice_list_long_tail ::= sacrifice_list_more | sacrifice_list_oxford

sacrifice_list_tail ::= sacrifice_list_last | sacrifice_list_more | sacrifice_list_oxford

/* @sem Operation::[$sacrifice_list_member] */
sacrifice_list_oxford ::= "," "and" sacrifice_list_member

/* @sem Instruction::[ForEachPlayer{players:$sacrifice_list_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:Together([$sacrifice_list_member, ...$sacrifice_list_tail])}]}}] */
instructions_each_sacrifice_list ::= sacrifice_list_players "sacrifices" sacrifice_list_member sacrifice_list_tail "of" "their" "choice"

sacrifice_list_players ::= players_each | players_each_opponent

/* Counted attacking tokens use live populations or the controller’s attraction history. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$attacking_token_count, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_each_tapped_attacking ::= "create" "a" token_recipe "that's" "tapped" "and" "attacking" "for" "each" attacking_token_count

attacking_token_count ::= count_each_graveyard | count_each_card_graveyard | count_each_attractions_visited

/* @sem Expr::PlayerNumber{player:AbilityController, number:AttractionsVisitedThisTurn} */
count_each_attractions_visited ::= "Attraction" "you've" "visited" "this" "turn"

/* Test the announced spell against a condition before countering the same target. */
/* @sem Instruction::[If{condition:ObjectMatches{object:$target_stack_spell, filter:Condition($counter_spent_predicate)}, then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@next_slot, index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}] */
clause_counter_spent_condition ::= "counter" target_stack_spell "if" counter_spent_predicate

counter_spent_predicate ::= counter_spent_none | counter_spent_at_least

/* @sem Condition::Compare{left:ManaSpent{object:Candidate, filter:_{}, aggregation:Count}, test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
counter_spent_none ::= "no" "mana" "was" "spent" "to" "cast" "it"

/* @sem Condition::Compare{left:ManaSpent{object:Candidate, filter:_{}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
counter_spent_at_least ::= "at" "least" number "mana" "was" "spent" "to" "cast" "it"

/* A chosen quantity of owned cards outside the game can feed either library move. */
/* @sem SelectionStep::_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:OutsideTheGame(Any), count:$outside_owned_count, constraints:[]} */
outside_owned_selection ::= outside_owned_count "you" "own" "from" "outside" "the" "game"

outside_owned_count ::= outside_owned_exact | outside_owned_up_to

/* @sem Count::Exactly($card_count) */
outside_owned_exact ::= card_count

/* @sem Count::UpTo($card_count) */
outside_owned_up_to ::= "up" "to" card_count

/* @sem Operation::WithSelections{steps:[$outside_owned_selection], action:Move{objects:Prepared(@selection_id(0)), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}} */
outside_owned_put_top ::= "put" outside_owned_selection "on" "top" "of" "your" "library"

/* @sem Operation::WithSelections{steps:[$outside_owned_selection], action:Move{objects:Prepared(@selection_id(0)), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}} */
outside_owned_shuffle ::= "shuffle" outside_owned_selection "into" "your" "library"

/* The selection and reveal share a result; the continuation counts symbols on
   precisely that selection. The enclosing sequence keeps the anaphor local. */
/* @sem Instruction::[...$reveal_hand_selection, $revealed_selection_life] */
instructions_reveal_selection_life ::= reveal_hand_selection "." revealed_selection_life

reveal_hand_selection ::= reveal_hand_selection_any | reveal_hand_selection_filtered

/* @sem Instruction::[Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, count:AnyNumber}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}] */
reveal_hand_selection_any ::= "reveal" "any" "number" "of" "cards" "in" "your" "hand"

/* @sem Instruction::[Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AnyNumber}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}] */
reveal_hand_selection_filtered ::= "reveal" "any" "number" "of" card_filter "cards" "in" "your" "hand"

/* @sem Instruction::Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:Multiply([$value, CountManaSymbols{objects:Selected(@marked), colors:[$devotion_color]}])}} */
revealed_selection_life ::= "you" "gain" value "life" "for" "each" devotion_color "mana" "symbol" "in" "those" "cards'" "mana" "costs"

/* Counted continuations are enclosed with the discard that produced their
   receipt, so neither parsing nor inverse printing can borrow another action. */
/* @sem Instruction::[...$discard_hand_selection, $discard_count_counters] */
instructions_discard_count_counters ::= discard_hand_selection "." discard_count_counters

/* @sem Instruction::[...$discard_hand_selection, ...$discard_count_search_hand] */
instructions_discard_count_search ::= discard_hand_selection "." discard_count_search_hand

discard_hand_selection ::= discard_hand_selection_any | discard_hand_selection_filtered

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, count:AnyNumber}}, Effect{result:@mark, operation:DiscardObjects{objects:Selected(@prior)}}] */
discard_hand_selection_any ::= "discard" "any" "number" "of" "cards"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AnyNumber}}, Effect{result:@mark, operation:DiscardObjects{objects:Selected(@prior)}}] */
discard_hand_selection_filtered ::= "discard" "any" "number" "of" card_filter "cards"

/* @sem Instruction::Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:Multiply([$value, CountObjects(Transition{result:@marked, phase:Before})])}]}} */
discard_count_counters ::= "for" "each" "card" "discarded" "this" "way" "," "put" value counter_kind "counters" "on" affected

/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:$filter_phrase, count:UpTo(CountObjects(Transition{result:@marked, phase:Before}))}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
discard_count_search_hand ::= "search" "your" "library" "for" "up" "to" "that" "many" filter_phrase "cards" "," "reveal" "them" "," "put" "them" "into" "your" "hand" "," "then" "shuffle"

/* A resolution-time group keeps its filter and distinct-property constraint. */
/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$return_selection_filter}), count:AnyNumber, constraints:[$return_different_property]}], action:Move{objects:Prepared(@selection_id(0)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}} */
return_different_graveyard_cards ::= "return" "any" "number" "of" return_selection_filter "with" "different" return_different_property "from" "your" "graveyard" "to" "your" "hand"

return_selection_filter ::= return_selection_any | return_selection_typed

/* @sem ObjectFilter::Any */
return_selection_any ::= "cards"

/* @sem $card_filter */
return_selection_typed ::= card_filter "cards"

return_different_property ::= return_different_mana_values | return_different_powers | return_different_toughnesses

/* @sem SelectionConstraint::DifferentProperty(ManaValue) */
return_different_mana_values ::= "mana" "values"

/* @sem SelectionConstraint::DifferentProperty(Power) */
return_different_powers ::= "powers"

/* @sem SelectionConstraint::DifferentProperty(Toughness) */
return_different_toughnesses ::= "toughnesses"

/* The recorded reveal and the hand belong to the same player. */
/* @sem Instruction::[Effect{result:@next, operation:RevealFromHand{actor:One($player_ref), cards:Any, count:$card_count, at_random:true}}, Effect{result:@next, operation:DiscardObjects{objects:Zone{scope:Players{zone:Hand, players:One($player_ref)}, kind:Card, filter:$revealed_discard_filter}}}] */
clause_random_reveal_discard ::= player_ref "reveals" card_count "at" "random" "from" "their" "hand" "," "then" "discards" "each" revealed_discard_filter

/* @sem ObjectFilter::AllOf([$adjective_nontype, InSet(Recorded(@prior))]) */
revealed_discard_filter ::= adjective_nontype "card" "revealed" "this" "way"

/* The choice's result identifies the one card excluded from the discard. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$player_ref, objects:Zone{scope:Players{zone:Hand, players:One($player_ref)}, kind:Card, filter:$hand_choice_card}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:DiscardObjects{objects:Zone{scope:Players{zone:Hand, players:One($player_ref)}, kind:Card, filter:Not(SameObject(Result{result:@prior, phase:After, index:0}))}}}] */
clause_choose_hand_discard_rest ::= player_ref "chooses" "a" hand_choice_card "in" "their" "hand" "and" "discards" "the" "rest"

hand_choice_card ::= hand_choice_any | hand_choice_filtered

/* @sem ObjectFilter::Any */
hand_choice_any ::= "card"

/* @sem $adjective_nontype */
hand_choice_filtered ::= adjective_nontype "card"

/* The duplicate-name predicate reads precisely the just-observed hand. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($hand_player)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:DiscardObjects{objects:Zone{scope:Players{zone:Hand, players:One($hand_player)}, kind:Card, filter:$hand_duplicate_filter}}}] */
clause_reveal_duplicate_discard ::= hand_player "reveals" "their" "hand" "." "that" "player" "discards" "all" hand_duplicate_filter

/* @sem ObjectFilter::AllOf([$adjective_nontype, SharesNameWithAnother(Observed(@prior))]) */
hand_duplicate_filter ::= adjective_nontype "cards" "with" "the" "same" "name" "as" "another" "card" "in" "their" "hand"

/* Chosen type and controller are independent parts of the destroyed population. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, Chosen(CreatureType), ControlledBy($players_singular)])}, regeneration:false}}] */
clause_destroy_chosen_controlled_final ::= "destroy" "all" filter_plural "of" "that" "type" players_singular "controls" "." "they" "can't" "be" "regenerated"

/* Copy creation keeps the copied population and number of copies independent. */
/* @sem Operation::CopyCards{actor:One(AbilityController), objects:$copy_card_population, times:Constant(1)} */
create_card_copy_one ::= "create" ("a" | "one") "copy" "of" copy_card_population

/* @sem Operation::CopyCards{actor:One(AbilityController), objects:$copy_card_population, times:Expr::@plural_amount($number)} */
create_card_copies ::= "create" number "copies" "of" copy_card_population

/* @sem ObjectSet::OutsideTheGame(Chosen(CardName)) */
copy_card_population ::= "the" "card" "with" "the" "chosen" "name"

/* A controller chooses the described battlefield permanents for the action. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::TurnFaceUp, objects:$chosen_battlefield_permanents} */
turn_selected_face_up ::= "turn" chosen_battlefield_permanents "face" "up"

/* The original host supplies the reference used by the destination phrase. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, AttachedTo(SameObject(@remember_object($object_ref)))])} */
enchanting_attachments ::= "all" filter_plural "enchanting" object_ref

/* @sem ObjectFilter::AllOf([Not(SameObject(@named_object)), ControlledBy(One(ControllerOf(@named_object)))]) */
another_permanent_same_controller ::= "another" "permanent" "with" "the" "same" "controller"

/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$another_permanent_same_controller}, chooser:Players(One(AbilityController)), count:Exactly(Constant(1))}], action:AttachEach{actor:One(AbilityController), attachments:$enchanting_attachments, hosts:Objects(Prepared(@selection_id(0)))}} */
attach_enchanting_to_same_controller ::= "attach" enchanting_attachments "to" another_permanent_same_controller

/* Alternative resolution payments retain each independent native cost. */
/* @sem Cost::Cost{parts:[Choice([$cost, $cost_2])]} */
payment_choice_cost ::= cost "or" cost

/* A one-use boon carries its own event and perpetual action. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:$event_clause, duration:Indefinite, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:$affected, changes:$static_changes}}]}, once:true}}] */
clause_one_time_perpetual_boon ::= "you" "get" "a" "one-time" "boon" "with" '"' event_clause "," affected "perpetually" static_changes "." '"'

/* Native tap payment feeds the reflexive trigger's performed result. */
/* @sem Vec<Instruction>::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[$cost_tap_another_untapped]}}}] */
reflexive_tap_payment ::= cost_tap_another_untapped

/* The first action is the optional player action whose choice the continuation tests. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:@optional_program($program)}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:$program_2, otherwise:_{}}] */
instructions_have_if_done ::= "you" "may" "have" program "." "if" "you" "do" "," program

/* @sem @apply($players_singular, $sacrifice_choice_base) */
have_player_sacrifice_choice ::= "have" players_singular sacrifice_choice_base

/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:@subject, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan($counter_amount)}) */
sacrifice_choice_base ::= "sacrifice" counter_amount filter_phrase "of" "their" "choice"

/* @sem @apply($players_singular, $choose_sacrifice_shared) */
player_choose_sacrifice_shared ::= players_singular choose_sacrifice_shared

/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:@subject, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, $modifier_shares_sacrificed_card_type)}, choose:AsManyAsCan(Constant(1))}) */
choose_sacrifice_shared ::= "chooses" "a" filter_phrase "they" "control" modifier_shares_sacrificed_card_type "and" "sacrifices" "it"

/* The entry lens keeps the move and its arrival changes together. */
/* @sem Instruction::[...$entry_characteristics_move, ...$instructions] */
entry_characteristics_more ::= entry_characteristics_move "." instructions

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Add, types:Listed($becomes_types)}, GrantKeyword($keyword_value)] */
entry_plural_stats_types_keyword ::= "each" "of" "them" "is" "a" value "/" value becomes_types "with" keyword_value "in" "addition" "to" "its" "other" "types"

/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word]}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetBasePowerToughness{power:$value, toughness:$value_2}] */
entry_singular_color_type_stats ::= "it's" "a" mana_color_word becomes_types "with" "base" "power" "and" "toughness" value "/" value

/* @sem Operation::Move{objects:One($target_card_milled_this_turn), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
put_milled_card_battlefield ::= "put" target_card_milled_this_turn "onto" "the" "battlefield" "under" "your" "control"

/* Scope the permission to the immediately preceding exile action. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$ordered_cards, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:$exile_receipt_permission}] */
instructions_exile_receipt_permission ::= "exile" ordered_cards "." exile_receipt_permission

exile_receipt_permission ::= exile_receipt_filtered_cast | exile_receipt_play_spending

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:CastSpell, filter:$filter_phrase})], duration:$duration, evaluation:LiveObjects} */
exile_receipt_filtered_cast ::= duration "," "you" "may" "cast" filter_phrase "spells" "from" "among" "the" "exiled" "cards"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:Either, filter:Any}, terms:_{cost:Normal, spend_as:AnyType}})], duration:$duration, evaluation:LiveObjects} */
exile_receipt_play_spending ::= duration "," "you" "may" "play" "those" "cards" "," "and" "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "those" "spells"

/* A singular result is only available from a one-card exile. */
/* @sem Instruction::[...$card_exile_value_producer, Effect{result:@next, operation:$exile_single_instant_sorcery_permission}] */
instructions_exile_single_cast_permission ::= card_exile_value_producer "." exile_single_instant_sorcery_permission

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:CastSpell, filter:AnyOf([CardType(Instant), CardType(Sorcery)])}, terms:_{cost:Normal}})], duration:$duration, evaluation:LiveObjects} */
exile_single_instant_sorcery_permission ::= duration "," "you" "may" "cast" "it" "if" "it's" "an" "instant" "or" "sorcery" "spell"

/* Choose one announced target and place five separately specified counter kinds. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($chosen_counter_creature_target)), kind:$counter_kind, amount:$count_plural}, _{recipients:Objects(One($chosen_counter_creature_target)), kind:$counter_kind_2, amount:Constant(1)}, _{recipients:Objects(One($chosen_counter_creature_target)), kind:$counter_kind_3, amount:Constant(1)}, _{recipients:Objects(One($chosen_counter_creature_target)), kind:$counter_kind_4, amount:Constant(1)}, _{recipients:Objects(One($chosen_counter_creature_target)), kind:$counter_kind_5, amount:Constant(1)}]}}]} */
chosen_target_five_counters ::= "choose" chosen_counter_creature_target "." "put" count_plural counter_kind "counters" "," "a" counter_kind "counter" "," "a" counter_kind "counter" "," "a" counter_kind "counter" "," "and" "a" counter_kind "counter" "on" "that" "creature"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:CardType(Creature)}), index:0} */
chosen_counter_creature_target ::= "target" "creature"

/* Apply the grant to the object designated by the preceding placement. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$put_counters_direct}, Effect{result:@next, operation:$prior_counter_ability_grant}]} */
program_counters_then_ability_grant ::= put_counters_direct "." prior_counter_ability_grant

prior_counter_ability_grant ::= gain_this_ability_perpetually | gain_source_other_abilities

/* The chosen card and its immediate receipt stay within the same program. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_hand_spell_card}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$incorporate_cast_grant}}] */
instructions_choose_hand_perpetual ::= choose_hand_spell_card "." "it" "perpetually" incorporate_cast_grant

/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$hand_spell_card_filter}), count:AsManyAsCan(Constant(1))} */
choose_hand_spell_card ::= "choose" hand_spell_card_filter "card" "in" "your" "hand"

hand_spell_card_filter ::= hand_vowel_type_or_sorcery_card | hand_instant_card | hand_sorcery_card

/* @sem ObjectFilter::AnyOf([$hand_first_spell_card_type, $spell_sorcery]) */
hand_vowel_type_or_sorcery_card ::= "an" hand_first_spell_card_type "or" spell_sorcery

hand_first_spell_card_type ::= spell_instant | noun_artifact

/* @sem ObjectFilter::$spell_instant */
hand_instant_card ::= "an" spell_instant

/* @sem ObjectFilter::$spell_sorcery */
hand_sorcery_card ::= "a" spell_sorcery

/* @sem Change::[Incorporate($mana_symbols), GrantAbility(Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:Spell{event:Cast, players:One(AbilityController), spells:SameObject(Source)}, limits:_{}, announcement:@announcement, body:$program})})] */
incorporate_cast_grant ::= "incorporates" mana_symbols "and" "gains" '"' "when" "you" "cast" "this" "spell" "," program "." '"'

/* A coordinated list places different counters simultaneously on one recipient. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:Constant(1)}, _{recipients:Objects($affected), kind:$counter_kind_2, amount:Constant(1)}, _{recipients:Objects($affected), kind:$counter_kind_3, amount:Constant(1)}]} */
put_three_counters_shared_recipient ::= "put" "a" counter_kind "counter" "," "a" counter_kind "counter" "," "and" "a" counter_kind "counter" "on" affected

/* Bind the exclusion to the immediately preceding choice in the same sequence. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(OpponentsOf(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreateContinuousEffect{source:$self_ref, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), Not(SameObject($self_ref)), Not(SameObject(Result{result:@prior, phase:After, index:0}))])}), changes:$static_changes, duration:$duration, evaluation:Snapshot}}] */
choose_opponent_creature_exclude ::= "choose" "a" "creature" "an" "opponent" "controls" "." duration "," "creatures" "other" "than" self_ref "and" "the" "chosen" "creature" static_changes

/* The untap and the following grant name the same attacking population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Attacking, $attacking_type_plural])} */
attacking_type_group ::= "all" "attacking" attacking_type_plural

attacking_type_plural ::= plural_creature | plural_artifact | plural_enchantment | plural_land | plural_planeswalker

/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:$attacking_type_group, tapped:false}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($attacking_type_group), changes:$grants, duration:$duration, evaluation:Snapshot}}] */
instructions_untap_attacking_grants ::= "untap" attacking_type_group "." "they" "gain" grants duration

/* A bounded cast action keeps the eligible population and payment separate
   from the duration of the permission. */
/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([State(Foretold), OwnedBy(One(AbilityController))])}) */
owned_foretold_exile_card ::= "foretold" "card" "you" "own" "from" "exile"

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:$owned_foretold_exile_card, count:Exactly(Constant(1)), cost:Free} */
cast_owned_foretold_free ::= "cast" "a" owned_foretold_exile_card "without" "paying" "its" "mana" "cost"

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:$owned_foretold_exile_card, count:Exactly(Constant(1)), cost:Normal} */
cast_owned_foretold_normal ::= "cast" "a" owned_foretold_exile_card

temporary_single_cast_body ::= cast_owned_foretold_free | cast_owned_foretold_normal | cast_free_exile_spell | cast_free_from_population

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(SpecialAction{body:Program{instructions:[Effect{result:@next, operation:$temporary_single_cast_body}]}, limit:Total(1)})], duration:$this_duration, evaluation:LiveObjects} */
temporary_single_cast_action ::= "you" "may" temporary_single_cast_body this_duration

/* Keep the choice and its per-player copy together: the chosen creature is
   the receipt of this very choice, made by the same bound player. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:$neighbor_creature_choice}]}}, ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_chosen_creature_copy}]}}] */
clause_neighbor_choice_copy ::= "each" "player" neighbor_creature_choice "." "each" "player" bound_chosen_creature_copy

/* @sem Operation::ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One($bound_neighbor))])}, count:AsManyAsCan(Constant(1))} */
neighbor_creature_choice ::= "chooses" "a" "creature" "controlled" "by" "the" "player" "to" "their" bound_neighbor

bound_neighbor ::= bound_neighbor_left | bound_neighbor_right

/* @sem PlayerRef::Seat{of:Bound(0), side:Left} */
bound_neighbor_left ::= "left"

/* @sem PlayerRef::Seat{of:Bound(0), side:Right} */
bound_neighbor_right ::= "right"

/* @sem Operation::CreateTokens{players:One(Bound(0)), tokens:[TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:Copy{object:ChosenBy{result:@prior, chooser:Bound(0)}, exceptions:$copy_exceptions_plain}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
bound_chosen_creature_copy ::= "creates" token_copy_single "the" "creature" "they" "chose" "," "except" copy_exceptions_plain

/* The loop supplies its bound damage recipient to a scoped instruction body. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[ForEachObject{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:AnyNumber, filter:Any})), binding:0, body:Program{instructions:$chosen_damage_recipient_body}}]}} */
spell_each_chosen_damage_recipient ::= "choose" "any" "number" "of" "target" "creatures" "," "planeswalkers" "," "and" "/" "or" "players" "." "for" "each" "of" "them" "," chosen_damage_recipient_body "."

/* The loop can also apply a direct fixed damage instruction. */
chosen_damage_recipient_body ::= exile_single_top_damage_play | chosen_recipient_fixed_damage

/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Bound(0))), amount:$number, preventable:true}}] */
chosen_recipient_fixed_damage ::= SELF_NAME "deals" number "damage" "to" "that" "permanent" "or" "player"

/* A single target retains its identity across the face-down description. */
/* @sem Operation::TurnFaceDownAs{objects:One($target_object), as_creature:_{power:$face_down_power, toughness:$number_digits, creature_type:@subtype_name($subtype), artifact:true}} */
turn_target_face_down_as_artifact ::= "turn" target_object "face" "down" "." face_down_power "/" number_digits subtype "artifact" "creature"

face_down_power ::= face_down_it_becomes | face_down_its

/* @sem Expr::$number_digits */
face_down_it_becomes ::= "it" "becomes" "a" number_digits

/* @sem Expr::$number_digits */
face_down_its ::= "it's" "a" number_digits

/* A counted counter placement consumes this exact optional token-exile payment.
   The receipt counts the performed selections before movement. */
/* @sem Cost::Cost{parts:[Move{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Token, CreatedWith($self_explicit_ref)])}, choose:AnyNumber}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]} */
payment_created_tokens_exile ::= "exile" "any" "number" "of" "tokens" "created" "with" self_explicit_ref

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$payment_created_tokens_exile, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($self_explicit_ref)), kind:$counter_kind, amount:CountObjects(CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:Before})}]}}]}, otherwise:Program{}}] */
instructions_created_tokens_exile_counters ::= "you" "may" payment_created_tokens_exile "." "if" "you" "do" "," "put" "that" "many" counter_kind "counters" "on" self_explicit_ref

/* Each alternative retains its own source, amount and recipients. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[Program{instructions:[Effect{result:@next, operation:$deal_damage}]}, Program{instructions:[Effect{result:@next, operation:$deal_damage_2}]}]}] */
clause_damage_choice ::= deal_damage "or" deal_damage

/* A player-relative quantity is evaluated separately for each recipient. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(One(Bound(0))), amount:$damage_each_player_amount, preventable:true}}]}}] */
damage_each_player_scaled ::= object_ref "deals" "damage" "to" players_singular "equal" "to" damage_each_player_amount

/* @sem Expr::Divide{numerator:PlayerNumber{player:Bound(0), number:Life}, denominator:Constant(2), rounding:$rounding_words} */
damage_each_player_amount ::= "half" "that" "player's" "life" "total" "," rounding_words

/* Exile the holder and return the actual exile arrival in the same sequence. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One(Source), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:@exile_followup(InZone{objects:One(Result{result:@prior, phase:After, index:0}), zone:Exile}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
instructions_self_exile_return ::= "exile" self_explicit_ref "," "then" "return" "it" "to" "the" "battlefield"

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly($multiple_color_count), options:[]}} */
choose_many_colors ::= "choose" multiple_color_count "colors"

multiple_color_count ::= n3 | n4 | n5

/* The two source zones retain their own selection and entry contracts. */
/* @sem Program::_{instructions:[ChooseOne{decider:AbilityController, options:[_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AllOf([$kin_creature_card_type, Property{property:ManaValue, test:NumberTest::Compare{comparison:$kin_comparison, value:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}}])}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(@self), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo(Result{result:@back(3), phase:After, index:0})]}}, qualifiers:[]}}]}}}]}, _{instructions:[Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Matching{objects:Zone(_{scope:Shared(Command), kind:Card, filter:AllOf([State(Commander), $kin_creature_card_type, Property{property:ManaValue, test:NumberTest::Compare{comparison:$kin_comparison, value:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}}])}), filter:OwnedBy(One(AbilityController))}, count:Exactly(Constant(1)), constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(@self), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo(Result{result:@back(3), phase:After, index:0})]}}, qualifiers:[]}}]}}}]}, _{}]}]} */
kin_hand_or_command_entry ::= "you" "may" "put" "a" kin_creature_card_type "card" "you" "own" "with" kin_comparison "mana" "value" "from" "your" "hand" "or" "from" "the" "command" "zone" "onto" "the" "battlefield" "." "if" "you" "do" "," "return" "this" "card" "to" "the" "battlefield" "attached" "to" "that" "creature" "at" "the" "beginning" "of" "the" "next" "end" "step" "."

kin_comparison ::= kin_lesser | kin_greater | kin_equal

/* @sem ObjectFilter::CardType(Creature) */
kin_creature_card_type ::= "creature"

/* @sem Comparison::Less */
kin_lesser ::= "lesser"

/* @sem Comparison::Greater */
kin_greater ::= "greater"

/* @sem Comparison::Equal */
kin_equal ::= "equal"

/* Random opponent choice followed by a choice between that player and a
   permanent they control. The amount and permanent type remain operands. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseAtRandom{kind:Player, options:[Players(OpponentsOf(AbilityController))]}}, Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Recipient, terms:_{count:Exactly(Constant(1)), options:[Recipients(Union([Players(One(Chosen)), Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun, ControlledBy(One(Chosen))])})]))]}}}, Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Chosen, amount:$value_event_spell_mana, preventable:true}}] */
instructions_random_opponent_recipient_damage ::= "choose" "an" "opponent" "at" "random" "." self_explicit_ref "deals" "damage" "equal" "to" value_event_spell_mana "to" "that" "player" "or" "a" noun "that" "player" "controls"

/* The offered ante and its declined branch share the announced player. */
ante_payment_target ::= target_opponent | target_player

/* @sem Expr::Constant(1) */
ante_top_card_count ::= "card"

/* @sem $ante_plural_count */
ante_top_cards_count ::= ante_plural_count "cards"

ante_plural_count ::= n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10 | n11 | n12 | n13 | n14 | n15 | n20 | n30

ante_top_count ::= ante_top_card_count | ante_top_cards_count

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:$ante_payment_target, cost:Cost{parts:[PlayerAction{player:$ante_payment_target, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One($ante_payment_target)}, kind:Card, filter:Any}), count:$ante_top_count, from:Top}, destination:Ante(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:$ante_declined_program, otherwise:Program{}}] */
instructions_ante_declined ::= ante_payment_target "may" "ante" "the" "top" ante_top_count "of" "their" "library" "." "if" "they" "don't" "," ante_declined_program

/* Bind both branches to this flip even when it is nested in a payment branch. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:FlipCoin{player:AbilityController, protocol:@coin_protocol}}, If{condition:CoinFlip{result:@marked, outcome:Won}, then:$program, otherwise:$program_2}] */
instructions_you_flip_win_or_lose ::= "you" "flip" "a" "coin" "." "if" "you" "win" "the" "flip" "," program "." "if" "you" "lose" "the" "flip" "," program

ante_declined_program ::= ante_declined_coin_program | program

/* @sem Program::Program{instructions:$instructions_you_flip_win_or_lose} */
ante_declined_coin_program ::= instructions_you_flip_win_or_lose

/* The payer and the player ignoring the restrictions are the enchanted creature's controller. */
/* @sem Ability::PayToIgnore{subjects:Objects(One(AttachedTo(Source))), rules:$ignore_creature_restrictions, payer:ControllerOf(AttachedTo(Source)), cost:$ignore_sacrifice_choice, until:EndOfTurn} */
ignore_enchanted_creature_restrictions ::= "enchanted" "creature" ignore_creature_restrictions "." "that" "creature's" "controller" "may" ignore_sacrifice_choice "for" "that" "player" "to" "ignore" "this" "effect" "until" "end" "of" "turn" "."

/* The owner makes the destination choice for the targeted permanent. */
/* @sem Operation::Move{objects:One($target_possessive_union), destination:Library{position:TopOrBottom{chooser:Owners}, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
owner_moves_target_library_choice ::= target_possessive_union "owner" "puts" "it" "on" "their" "choice" "of" "the" "top" "or" "bottom" "of" "their" "library"

/* Both the explicit object and the described population go to their own
   owners' libraries, which are then shuffled. */
/* @sem Operation::Move{objects:$object_and_each_population, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
put_population_owners_shuffle ::= "put" object_and_each_population "on" "top" "of" "their" "owners'" "libraries" "," "then" "those" "players" "shuffle"

/* This form binds a target allowance to each opponent. */
/* @sem Operation::Move{objects:$opponent_permanent_targets, destination:Library{position:FromTop($library_depth), order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
put_each_opponents_targets_library_depth ::= "for" "each" "opponent" "," "put" opponent_permanent_targets "into" "its" "owner's" "library" library_depth "from" "the" "top"

object_and_each_population ::= object_and_each_filtered | object_and_each_combat_counterpart

/* The token quantity refers to this counter action's actual recorded receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Counter{objects:$counter_opponents_stack, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Recorded(@marked)), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
instructions_counter_stack_tokens ::= "counter" counter_opponents_stack "." "create" "a" token_recipe "for" "each" "spell" "and" "ability" "countered" "this" "way"

/* A required resolution payment branches on whether it was paid. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:false}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:$conjoined}, otherwise:Program{instructions:$conjoined_2}}] */
clause_required_payment_otherwise ::= payment "." "if" "you" "do" "," conjoined "." "otherwise" "," conjoined

/* A branch independently specifies the source, damage amount and life gain. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref, recipients:Objects(One(Target{slot:@last_slot, index:0})), amount:$number, preventable:true}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:$number_2}}]} */
chosen_target_damage_life_branch ::= self_ref "deals" number "damage" "to" "it" "and" "you" "gain" number "life"

/* @prefer always */
/* @sem Instruction::[If{condition:$chosen_target_damage_history, then:$chosen_target_damage_life_branch, otherwise:$chosen_target_damage_life_branch_2}] */
instructions_chosen_target_history_otherwise ::= chosen_target_damage_history "," chosen_target_damage_life_branch "." "otherwise" "," chosen_target_damage_life_branch

/* Restrict the receipt to a control change from you to an opponent; the
   draw counts the very objects affected by that effect. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:$plural_target_count_any, filter:@and($plural_head, ObjectFilter::ControlledBy(One(AbilityController)))})) */
opponent_control_draw_targets ::= plural_target_count_any "target" plural_head "you" "control"

/* @sem Instruction::[Effect{result:@mark, operation:CreateContinuousEffect{source:Source, affected:Objects($opponent_control_draw_targets), changes:[SetController($target_opponent)], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountObjects(Affected(@marked))}}] */
instructions_opponent_control_draw ::= target_opponent "gains" "control" "of" opponent_control_draw_targets "." "draw" "a" "card" "for" "each" "one" "they" "gained" "control" "of" "this" "way"

/* The scoped producer and callback refer to the same temporary exile. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), CardType(Creature), ControlledBy(One(AbilityController))])}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReturnAfter{objects:Transition{result:@marked, phase:After}, duration:WhileOnBattlefield($self_ref)}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(ObjectProperty{object:Result{result:@marked, phase:Before, index:0}, property:$stat, information:CurrentOrLastKnown}), filter:$filter_plural, distribute:ObjectProperty{object:Result{result:@marked, phase:Before, index:0}, property:$stat, information:CurrentOrLastKnown}}))), kind:$counter_kind, amount:DistributedShare(@share)}]}}]}})}] */
instructions_temporary_exile_distribute ::= "exile" "another" "creature" "you" "control" "until" self_ref "leaves" "the" "battlefield" "." "when" "you" "do" "," "distribute" "X" counter_kind "counters" "among" "any" "number" "of" "target" filter_plural "," "where" "X" "is" "the" "exiled" "creature's" stat

/* Each paired production fixes the producer resource and its consumer wording. */
program_shared_payment_draw ::= program_shared_mana_draw | program_shared_life_draw

/* @sem Program::Program{instructions:[$shared_mana_payment_start, $shared_mana_payment_draw]} */
program_shared_mana_draw ::= shared_mana_payment_start "." shared_mana_payment_draw

/* @sem Program::Program{instructions:[$shared_life_payment_start, $shared_life_payment_draw]} */
program_shared_life_draw ::= shared_life_payment_start "." shared_life_payment_draw

/* @sem Instruction::ForEachPlayer{players:All, binding:0, starting_with:$shared_payment_first_player, body:_{instructions:[Effect{result:@mark, operation:PayAnyAmount{actor:One(Bound(0)), resource:Mana}}]}} */
shared_mana_payment_start ::= "starting" "with" shared_payment_first_player "," "each" "player" "may" "pay" "any" "amount" "of" "mana"

/* @sem Instruction::ForEachPlayer{players:All, binding:0, starting_with:$shared_payment_first_player, body:_{instructions:[Effect{result:@mark, operation:PayAnyAmount{actor:One(Bound(0)), resource:Life}}]}} */
shared_life_payment_start ::= "starting" "with" shared_payment_first_player "," "each" "player" "may" "pay" "any" "amount" "of" "life"

/* @sem Instruction::Effect{result:@next, operation:Draw{players:$players_singular, amount:PerformedTotal(@marked)}} */
shared_mana_payment_draw ::= players_singular "draws" "X" "cards" "," "where" "X" "is" "the" "total" "amount" "of" "mana" "paid" "this" "way"

/* @sem Instruction::Effect{result:@next, operation:Draw{players:$players_singular, amount:PerformedTotal(@marked)}} */
shared_life_payment_draw ::= players_singular "draws" "X" "cards" "," "where" "X" "is" "the" "total" "amount" "of" "life" "paid" "this" "way"

shared_payment_first_player ::= shared_payment_you | shared_payment_active

/* @sem PlayerRef::AbilityController */
shared_payment_you ::= "you"

/* @sem PlayerRef::Active */
shared_payment_active ::= "the" "active" "player"

/* Alternative costs preserve each player's own payment receipt. */
/* @sem Cost::Cost{parts:[Choice([$cost, $cost_2])]} */
choice_cost_first_qualified ::= cost "of" "their" "choice" "or" cost

/* @sem Cost::Cost{parts:[Choice([$cost, $cost_2])]} */
choice_cost_second_qualified ::= cost "or" cost "of" "their" "choice"

choice_cost_qualified ::= choice_cost_first_qualified | choice_cost_second_qualified

/* @sem Instruction::ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:Bound(0), cost:$choice_cost_qualified, optional:true}}]}} */
players_optional_choice_cost ::= players_singular "may" choice_cost_qualified

/* The explicit sacrifice/discard receipt is scoped to those two offered costs. */
/* @sem Cost::Cost{parts:[Choice([Cost{parts:[$cost_sacrifice]}, Cost{parts:[$cost_discard]}])]} */
sacrifice_or_discard_offer ::= cost_sacrifice "of" "their" "choice" "or" cost_discard

/* @sem Instruction::[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:Bound(0), cost:$sacrifice_or_discard_offer, optional:true}}]}}, Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Not(PlayerTook{player:Bound(0), result:@marked})}])), amount:ObjectProperty{object:$object_ref, property:Power, information:CurrentOrLastKnown}, preventable:true}}] */
opponents_sacrifice_discard_damage ::= "each" "opponent" "may" sacrifice_or_discard_offer "." "then" object_ref "deals" "damage" "equal" "to" "its" "power" "to" "each" "opponent" "who" "didn't" "sacrifice" "a" "permanent" "or" "discard" "a" "card" "this" "way"

/* An optional selection from the entire graveyard, independent of any preceding action. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$card_noun}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
clause_optional_graveyard_card_hand ::= "you" "may" "return" "a" card_noun "card" "from" "your" "graveyard" "to" "your" "hand"

/* Team control qualifies the creatures announced for this untap action. */
/* @sem Operation::SetTapped{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:$untap_team_target_cap, filter:$untap_team_creature_filter}))} */
untap_team_creatures ::= "untap" untap_team_target_cap "target" untap_team_creature_filter

/* @sem Count::@plural_count($target_up_to) */
untap_team_target_cap ::= target_up_to

/* @sem ObjectFilter::AllOf([$plural_creature, ControlledBy($life_history_team)]) */
untap_team_creature_filter ::= plural_creature life_history_team "controls"

/* Keep the payment and its consumer in the same scope: the performed result
   denotes this energy payment, never an arbitrary prior operation. */
/* @sem Instruction::[Effect{result:@next, operation:PayAnyAmount{actor:One(AbilityController), resource:Energy}}, Effect{result:@next, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_three_and_heads, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:Performed(@prior)}})}, regeneration:true}}] */
instructions_energy_payment_destroy ::= "you" "may" "pay" "any" "amount" "of" "{" "E" "}" "." "destroy" "each" filter_three_and_heads "with" "mana" "value" "less" "than" "or" "equal" "to" "the" "amount" "of" "{" "E" "}" "paid" "this" "way"

/* Resolution payments compose their independently typed components in order. */
/* @sem Cost::Cost{parts:[$resolution_payment_part, $resolution_payment_part_2]} */
payment_pair ::= resolution_payment_part "and" resolution_payment_part_2

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:$affected}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
resolution_exile_part ::= "exile" affected

resolution_payment_part ::= cost_life | resolution_exile_part

resolution_payment_part_2 ::= resolution_exile_part
