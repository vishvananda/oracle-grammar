/* The tested and copied object is the arrival of this player's own hand selection. */
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One($target_player_ref), amount:$card_count}}, Effect{result:@next, operation:ChooseObjects{player:Target{slot:@last_slot, index:0}, objects:Zone{scope:Players{zone:Hand, players:One(Target{slot:@last_slot, index:0})}, kind:Card, filter:Any}, count:AsManyAsCan(Constant(1))}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$single_exile_arrival_filter}, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(Target{slot:@last_slot, index:0}), tokens:[TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:Copy{object:Result{result:@marked, phase:After, index:0}, exceptions:[]}}], entry:BattlefieldArrival{}}}]}, otherwise:Program{}}] */
player_draw_exile_conditional_copy ::= target_player_ref "draws" card_count "," "then" "exiles" "a" "card" "from" "their" "hand" "." "if" single_exile_arrival_filter "," "that" "player" "creates" token_copy_single "that" "card"

