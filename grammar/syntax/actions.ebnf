exile_suspend_spelled_counters ::= "exile" affected "with" number_words counter_kind "counters" "on" "it"

/* Bind the anaphor to both distinct targets of this exchange. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Exchange{kind:LifeTotals, first:Player(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0}), second:Player(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OthersThan(Target{slot:0, index:0})}), index:0})}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$counter_a, words:CreatingEffect, recipe:$exchange_life_difference_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]}} */
exchange_life_then_difference_token ::= "two" "target" "players" "exchange" "life" "totals" "." "you" "create" counter_a exchange_life_difference_token_recipe "."

