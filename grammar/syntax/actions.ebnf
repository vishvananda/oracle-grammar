/* A counter choice shares its recipient across every alternative. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[_{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:Constant(1)}]}}]}, _{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind_2, amount:Constant(1)}]}}]}, _{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind_3, amount:Constant(1)}]}}]}, _{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind_4, amount:Constant(1)}]}}]}]}] */
clause_choose_one_of_four_counters ::= "put" "your" "choice" "of" "a" "counter" "from" "among" counter_kind "," counter_kind "," counter_kind "," ("and" | "or") counter_kind "on" affected | "put" "your" "choice" "of" "a" counter_kind "," counter_kind "," counter_kind "," "or" counter_kind "counter" "on" affected

