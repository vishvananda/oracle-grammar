return_optional_own_card_battlefield ::= "return" target_optional_card_own_graveyard "to" "the" "battlefield"

/* @sem Operation::Move{objects:$opponents_poison_graveyard_targets, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
put_poison_opponents_cards_battlefield ::= opponents_poison_graveyard_targets "onto" "the" "battlefield" "under" "your" "control"

/* The deferred sacrifice consumes precisely the arrivals of this return. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$return_subtype_union_population, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Transition{result:@back(3), phase:After}})}]}}}] */
return_population_sacrifice_end ::= "return" return_subtype_union_population "to" "the" "battlefield" "." "sacrifice" "them" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* @sem Instruction::[...$return_population_sacrifice_end, ...$instructions] */
return_population_sacrifice_more ::= return_population_sacrifice_end "." NEWLINE instructions

/* The target and threshold are independent operands of the replacement instruction. */
/* @sem Instruction::[If{condition:$own_graveyard_card_threshold, then:_{instructions:[Effect{result:@next, operation:Move{objects:One($target_card_your_graveyard), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:_{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:0, index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
return_card_threshold_destination ::= "return" target_card_your_graveyard "to" "your" "hand" "." NEWLINE "return" "that" "card" "from" "your" "graveyard" "to" "the" "battlefield" "instead" "if" own_graveyard_card_threshold

/* Keep the two independent return operations in their printed paragraphs. */
/* @prefer always */
/* @sem Ability::[Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$return_optional_own_card_battlefield}, Effect{result:@next, operation:$put_poison_opponents_cards_battlefield}]}}] */
spell_optional_and_opponent_returns ::= return_optional_own_card_battlefield "." NEWLINE put_poison_opponents_cards_battlefield "."

/* The restriction supplies the same eligible host filter for both the
   enchantability test and the chosen attachment on arrival. */
/* @sem ObjectFilter::$filter_plural */
return_attachment_restriction ::= "only" filter_plural "can" "be" "enchanted" "this" "way"

/* @sem Operation::Move{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, CouldEnchant(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$return_attachment_restriction})])}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedToChosen($return_attachment_restriction)]}}, qualifiers:[]} */
