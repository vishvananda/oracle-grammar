/* Each named category admits at most one chosen card. */
/* @sem ObjectFilter::$filter_phrase */
hand_category_a ::= "a" filter_phrase "card"

/* @sem ObjectFilter::$filter_phrase */
hand_category_an ::= "an" filter_phrase "card"

hand_category ::= hand_category_a | hand_category_an

/* @sem SelectionConstraint::OneForEach([$hand_category, $hand_category_2]) */
hand_category_pair ::= hand_category "and" "/" "or" hand_category

/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, count:UpTo(Constant(2)), constraints:[$hand_category_pair]}], action:Move{objects:Prepared(@selection_id(0)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}} */
put_hand_category_pair ::= "put" hand_category_pair "from" "your" "hand" "onto" "the" "battlefield"

/* Both conditional copy branches refer to the same announced optional target,
   avoiding anaphoric capture by the first branch's created token. */
/* @sem Instruction::[@resolution(Instruction::If{condition:$condition, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:AllOf([Not(SameObject(Source)), AnyOf([$noun, $noun_2])])}), index:0}, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}]}, otherwise:Program{}}), If{condition:$condition_2, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($self_explicit_ref)), changes:[CopyOf{object:Target{slot:@last_slot, index:0}, exceptions:$copy_exceptions_plain}], duration:Indefinite, evaluation:Snapshot}}]}}]}, otherwise:Program{}}] */
clause_choose_target_two_if_copy ::= "choose" "up" "to" "one" "other" "target" noun "or" noun "." "if" condition "," "you" "may" "create" "a" "token" "that's" "a" "copy" "of" "it" "." "if" condition "," "you" "may" "have" self_explicit_ref "become" "a" "copy" "of" "it" "," "except" copy_exceptions_plain

