paid_x_other_graveyard_return ::= "you" "may" "pay" "{" "X" "}" "." "if" "you" "do" "," "return" "another" "target" card_filter "card" "with" "mana" "value" "X" "from" "your" "graveyard" "to" "the" "battlefield"

