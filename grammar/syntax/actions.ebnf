/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Ability, terms:_{count:Exactly(Constant(1)), options:$checkable_choice_list}} */
choose_checkable_ability ::= "choose" checkable_choice_list

/* Named alternatives retain independent programs, and the second branch acts
   on the controller's opponents other than the referenced player. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseAction{actor:$players_singular, options:[Term{family:NamedAction, form:NamedAction, operands:[Text(Self), List([Program($program)])]}, Term{family:NamedAction, form:NamedAction, operands:[Text(Others), List([Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::Intersection([OthersThan($player_ref), OpponentsOf(AbilityController)]), $other_opponents_action)}]}])]}]}}] */
instructions_named_self_others ::= players_singular "chooses" "self" "or" "others" "." "if" player_ref "chooses" "self" "," program "." "if" "the" "player" "chooses" "others" "," other_opponents_action

/* @sem Operation::$verb_operation_third */
other_opponents_action ::= "each" "of" "your" "other" "opponents" verb_operation_third

/* A hand shortfall is tested and filled against the same current threshold. */
/* @sem Instruction::[If{condition:Compare{left:CountObjects(Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})), test:NumberTest::Compare{comparison:Less, value:$hand_card_threshold}}, then:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Subtract([$hand_card_threshold, CountObjects(Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}))])}}]}, otherwise:Program{}}] */
