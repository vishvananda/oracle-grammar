/* Both consumers name the same reveal receipt, even with token creation between them. */
/* @sem Instruction::[Effect{result:@mark, operation:$players_reveal_tops}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Matching{objects:Observed(@marked), filter:$card_noun}), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:CountObjects(Matching{objects:Observed(@marked), filter:$adjective_nontype}), toughness:CountObjects(Matching{objects:Observed(@marked), filter:$adjective_nontype})}], duration:$duration, evaluation:Snapshot}}, ...$instructions] */
revealed_partition_tokens_pump_then ::= players_reveal_tops "." "for" "each" card_noun "card" "revealed" "this" "way" "," "you" "create" "a" token_recipe "." "then" affected "get" "+" "1" "/" "+" "1" duration "for" "each" adjective_nontype "card" "revealed" "this" "way" "." "then" instructions

/* An owned any-zone population and its perpetual change compose independently. */
/* @sem Operation::EffectOn{subject:Objects($owned_filtered_cards), effects:$owned_perpetual_terms} */
owned_cards_perpetual_terms ::= owned_filtered_cards "perpetually" owned_perpetual_terms

/* @prefer always */
/* @sem Operand::[Term{family:PerpetualEffect, form:AddCreatureType, operands:[Vocabulary{family:CreatureType, form:@subtype_name($creature_subtype)}]}, Term{family:PerpetualEffect, form:AddCardtype, operands:[Vocabulary{family:CardType, form:Kindred}]}] */
perpetual_type_terms ::= "become" creature_subtype "kindreds" "in" "addition" "to" "their" "other" "types"

/* Keep the reveal and both consumers in the same receipt scope. */
/* @sem Instruction::[Effect{result:@mark, operation:$players_reveal_tops}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Matching{objects:Observed(@marked), filter:$filter_phrase}), words:CreatingEffect, recipe:$singular_counted_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:CountObjects(Matching{objects:Observed(@marked), filter:$adjective_nontype}), toughness:CountObjects(Matching{objects:Observed(@marked), filter:$adjective_nontype})}], duration:$duration, evaluation:Snapshot}}] */
reveal_count_tokens_and_pump ::= players_reveal_tops "." "for" "each" filter_phrase "card" "revealed" "this" "way" "," "you" "create" "a" singular_counted_token_recipe "." "then" affected "get" "+" "1" "/" "+" "1" duration "for" "each" adjective_nontype "card" "revealed" "this" "way"

/* @sem Instruction::[...$reveal_count_tokens_and_pump, ...$instructions] */
reveal_count_tokens_and_pump_then ::= reveal_count_tokens_and_pump "." "then" instructions

/* A source-event pronoun remains the source across the target announcement. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:Source, recipients:$recipients, amount:$number, preventable:true}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:$number_2}}] */
source_event_damage_and_life ::= "it" "deals" number "damage" "to" recipients "and" "you" "gain" number "life"

/* @sem Program::@where(Program::Program{instructions:[...$source_event_damage_and_life, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Intensify{object:Source}}}]}, $value) */
source_event_damage_life_intensify ::= source_event_damage_and_life "," "where" "X" "is" value "." "then" "it" "intensifies"

/* @sem Ability::Triggered{event:$event_once, limits:TriggerLimits{}, announcement:@announcement, body:$source_event_damage_life_intensify} */
source_event_damage_life_trigger ::= "when" event_once "," source_event_damage_life_intensify "."

/* The recipient of the permanent is an opponent of the ability controller. */
/* @sem Operation::GiveControl{players:OpponentsOf(AbilityController), objects:$affected} */
opponent_gains_control ::= "an" "opponent" "gains" "control" "of" affected

/* Each player makes an optional choice from the stated battlefield population. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, starting_with:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:UpTo($counter_amount)}}]}}] */
ordered_players_may_choose_permanents ::= "starting" "with" "you" "," players_singular "may" "choose" counter_amount filter_phrase

/* Each player chooses one permanent for each of three kinds from the neighboring player. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, starting_with:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:ControlledBy(One(Seat{of:Bound(0), side:Left}))}, count:AsManyAsCan(Constant(3)), constraints:[OneForEach([$filter_phrase, $filter_phrase_2, $filter_phrase_3])]}}]}}] */
ordered_players_choose_neighbor_kinds ::= "starting" "with" "you" "," players_singular "chooses" "an" filter_phrase "," "a" filter_phrase "," "and" "a" filter_phrase "from" "among" "the" "permanents" "controlled" "by" "the" "player" "to" "their" "left"

/* The shared follow-up is scoped to choices of battlefield permanents. */
ordered_permanent_choice ::= ordered_players_may_choose_permanents | ordered_players_choose_neighbor_kinds

/* @sem Operation::Destroy{objects:$chosen_permanents_selection, regeneration:true} */
destroy_chosen_permanents_followup ::= "destroy" chosen_permanents_selection

/* @sem Instruction::[...$ordered_permanent_choice, Effect{result:@next, operation:$destroy_chosen_permanents_followup}] */
ordered_choice_destroy_permanents ::= ordered_permanent_choice "." NEWLINE? destroy_chosen_permanents_followup

/* The return, duplicate and perpetual grant retain their distinct adjacent receipts. */
/* @sem Instruction::[Effect{result:@next, operation:$return_opponent_below_source_stat}, If{condition:$condition_that_creature_wasnt_token, then:Program{instructions:[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Duplicate(One(Result{result:@prior, phase:After, index:0})), count:Constant(1), destination:Hand(CardArrival{counters:[], states:[]})}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$conjured_perpetual_changes}}]}, otherwise:Program{}}] */
instructions_return_duplicate_perpetual ::= return_opponent_below_source_stat "." "if" condition_that_creature_wasnt_token "," "conjure" "a" "duplicate" "of" "it" "into" "your" "hand" "." "it" "perpetually" conjured_perpetual_changes

/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$filter_phrase, ControlledBy(OpponentsOf(AbilityController)), Property{property:$return_comparison_stat, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:Source, property:$return_comparison_stat_2, information:CurrentOrLastKnown}}}])}), index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_opponent_below_source_stat ::= "return" "target" filter_phrase "an" "opponent" "controls" "with" return_comparison_stat "less" "than" "this" "creature's" return_comparison_stat "to" "its" "owner's" "hand"

return_comparison_stat ::= stat_power | stat_toughness

/* The quoted ability supplies the sentence-final period. */
/* @sem Program::Program{instructions:$instructions_return_duplicate_perpetual} */
program_return_duplicate_perpetual ::= instructions_return_duplicate_perpetual

/* Any opponent may choose to have the controller perform an action. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:FirstWilling(OpponentsOf(AbilityController)), cost:Cost{parts:[PlayerAction{player:AbilityController, body:$program_2}]}, optional:true}}, If{condition:Not(PaymentChosen(@prior)), then:$program, otherwise:Program{}}] */
clause_unless_opponent_has_you ::= program "unless" "any" "opponent" "has" "you" program

/* Repeat a complete instruction sequence twice after its first execution. */
/* @sem Instruction::[RepeatableWithLimit{amount:Constant(3), body:Program{instructions:[...$repeat_twice_body, Effect{result:@next, operation:RepeatProcess}]}}] */
instructions_repeat_twice_shared ::= repeat_twice_body "." "repeat" "this" "process" "two" "more" "times"

repeat_twice_body ::= clause_unless_opponent_has_you

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_repeat_twice_shared}} */
spell_repeat_twice_shared ::= instructions_repeat_twice_shared "."

/* The four independently chosen categories share one typed list in either word order. */
/* @sem Vec<ObjectFilter>::[$noun, $noun_2, $noun_3, $noun_4] */
choice_four_categories ::= "an" noun "," "a" noun "," "an" noun "," "and" "a" noun

/* Scope the remainder to the same per-player controlled population as the choice. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Any, ControlledBy(One(Bound(0)))])}, count:AsManyAsCan(Constant(4)), constraints:[OneForEach($choice_four_categories)]}}]}}, Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:All, objects:Unselected(@prior)})}] */
instructions_choose_controlled_four_remainder ::= "each" "player" "chooses" "from" "among" "the" "permanents" "they" "control" choice_four_categories "," "then" "sacrifices" "the" "rest"

/* Keep the sacrifice producer and the counted receipt in one scope so the
   inverse cannot describe a different preceding action as a sacrifice. */
/* @sem Instruction::[Effect{result:@mark, operation:$sacrifice_named_choice}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$filter_phrase}), words:CreatingEffect, recipe:$singular_counted_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
instructions_sacrifice_choice_create_counted ::= sacrifice_named_choice "." "you" "create" "a" singular_counted_token_recipe "for" "each" filter_phrase "sacrificed" "this" "way"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_sacrifice_choice_create_counted}} */
spell_sacrifice_choice_create_counted ::= instructions_sacrifice_choice_create_counted "."

/* The random choice and attachment consume the same singleton result. The
   departed host is supplied by the enclosing enchanted-creature death event. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$aura_return_creature_filter, CouldBeEnchantedBy(AuraAfterEnchantedLeft{aura:Source, host:EventSubject})])}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:One(AuraAfterEnchantedLeft{aura:Source, host:EventSubject}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo(Result{result:@prior, phase:After, index:0})]}}, qualifiers:[]}}] */
aura_random_choice_return ::= "choose" "a" aura_return_creature_filter "at" "random" "this" "Aura" "can" "enchant" "." "return" "this" "card" "to" "the" "battlefield" "attached" "to" "that" "creature"

aura_return_creature_filter ::= noun_creature | aura_return_qualified_creature

/* @sem @and($filter_outer_adjectives, $aura_return_creature_filter) */
aura_return_qualified_creature ::= filter_outer_adjectives aura_return_creature_filter

/* A singular optional sacrifice is the producer for its two receipt tests. */
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Constant(1))}) */
optional_single_sacrifice_producer ::= "you" "may" "sacrifice" "a" filter_phrase

/* Both tests inspect the same before-state of the singular sacrifice. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:$optional_single_sacrifice_producer}]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:Before, index:0}, filter:$filter_phrase}, then:$program, otherwise:Program{}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$filter_phrase_2}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}, then:$program_2, otherwise:Program{}}] */
instructions_optional_sacrifice_two_tests ::= optional_single_sacrifice_producer "." "if" "you" "sacrifice" "a" filter_phrase "this" "way" "," program "." "if" "you" "don't" "sacrifice" "a" filter_phrase "," program

/* The chosen battlefield population and event-group measure remain independent. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, count:UpTo($event_creatures_maximum)}}, Effect{result:@next, operation:SetTapped{objects:Selected(@prior), tapped:false}}] */
instructions_untap_event_maximum ::= "untap" "up" "to" "X" filter_plural "," "where" "X" "is" event_creatures_maximum

/* @sem Expr::Aggregate{objects:EventGroup, property:$creature_stat, aggregation:Maximum} */
event_creatures_maximum ::= "the" "greatest" creature_stat "among" "those" "creatures"

have_damage_source ::= have_damage_source_object | her_ref

/* @prefer always */
/* @sem $object_ref */
have_damage_source_object ::= object_ref

/* Select one extreme card, then move the selected result to its owner's hand. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$greatest_owned_graveyard_card_tied_power, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
return_greatest_owned_card_tied_power ::= "return" "to" "your" "hand" greatest_owned_graveyard_card_tied_power

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$greatest_owned_graveyard_card_tied_toughness, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
return_greatest_owned_card_tied_toughness ::= "return" "to" "your" "hand" greatest_owned_graveyard_card_tied_toughness

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$greatest_owned_graveyard_card, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
return_greatest_owned_card ::= "return" "to" "your" "hand" greatest_owned_graveyard_card

/* Color selections marked during deck creation retain their current count. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{options:[Term{family:ChoosableColor, form:AnyColor}], count:Exactly($value)}} */
deck_circle_color_choice ::= "circle" value "of" "the" "colors" "below"

/* @sem Ability::BeforeGame{when:GameBegins, body:List([Program{instructions:[Effect{result:@next, operation:$deck_circle_color_choice}]}])} */
before_game_deck_action ::= "as" "you" "create" "your" "deck" "," deck_circle_color_choice "."

/* The selected object and the complement use the same battlefield filter. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:UpTo(Constant(1))}}, Effect{result:@next, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Result{result:@prior, phase:After, index:0})), $filter_phrase])}, regeneration:true}}] */
instructions_choose_up_to_one_destroy_rest ::= "choose" "up" "to" "one" filter_phrase "." "destroy" "the" "rest"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Result{result:@prior, phase:After, index:0})), $filter_phrase])}, regeneration:true}}] */
instructions_choose_random_destroy_rest ::= "choose" "a" filter_phrase "at" "random" "," "then" "destroy" "the" "rest"

/* Damage and both references to its receipt form one bounded program. The
   quoted static abilities belong to each creature receiving the grant. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:DealDamage{source:$object_ref, recipients:$recipients, amount:$number, preventable:true}}, If{condition:AllOf([ObjectMatches{object:$self_explicit_ref, filter:State(Saddled)}, Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([DamagedBy(@marked), CardType(Creature)])}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}]), then:Program{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), DamagedBy(@marked)])}, changes:[GrantAbility(Static(_{kind:Ordinary, affected:Objects(One(Source)), changes:$static_changes})), GrantAbility(Static(_{kind:Ordinary, affected:Objects(One(Source)), changes:[Rule(DamageStaysMarked)]}))]}}]}, otherwise:Program{}}]} */
saddled_damage_perpetual_program ::= object_ref "deals" number "damage" "to" recipients "." "if" self_explicit_ref "is" "saddled" "and" "a" "creature" "was" "dealt" "damage" "this" "way" "," "that" "creature" "perpetually" "gains" '"' "this" "creature" static_changes '"' "and" '"' "damage" "isn't" "removed" "from" "this" "creature" "during" "cleanup" "steps" "." '"'

/* The move and its arrival consumer are a single reversible program. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One($target_permanent), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:Transition{result:@prior, phase:After}, changes:[GrantAbility($returned_cast_grant)]}}]} */
returned_target_cast_grant_sentence ::= "return" target_permanent "to" "its" "owner's" "hand" "." "that" "card" "perpetually" "gains" returned_cast_grant

returned_cast_grant ::= quoted_cost_reduction | returned_cast_additional_cost

/* @sem Ability::Casting(AdditionalCost{cost:_{parts:[Mana($mana_symbols)]}, optional:false, repetition:Once}) */
returned_cast_additional_cost ::= '"' "this" "spell" "costs" mana_symbols "more" "to" "cast" "." '"'

/* @sem Instruction::[...$instructions_each_hand_discard_draw_receipt, ...$instructions] */
instructions_each_hand_discard_draw_receipt_more ::= instructions_each_hand_discard_draw_receipt "." instructions

/* @prefer always */
/* @sem () */
hand_discard_all_in ::= "all" "the" "cards" "in" "their" "hand"

/* @sem () */
hand_discard_all_from ::= "all" "cards" "from" "their" "hand"

hand_discard_all_words ::= hand_discard_all_in | hand_discard_all_from

/* @sem Expr::Add([CountObjects(MovedBy{result:@prior, phase:After, player:Bound(0)}), $value]) */
hand_discard_draw_plus ::= "that" "many" "cards" "plus" value

/* A counted choice from the controller’s hand, in either supported location wording. */
/* @sem Operation::RevealFromHand{actor:One(AbilityController), cards:Any, count:$card_count} */
reveal_own_counted_hand ::= "reveal" card_count reveal_own_hand_location

/* @sem () */
reveal_own_hand_location ::= reveal_own_hand_in | reveal_own_hand_from

/* @sem () */
reveal_own_hand_in ::= "in" "your" "hand"

/* @sem () */
reveal_own_hand_from ::= "from" "your" "hand"

/* The optional copy belongs to each player in the event-relative population. */
/* @sem Operation::CopyOnStack{actor:One(Bound(0)), object:$object_ref, times:Constant(1), targets:May} */
bound_player_copy_retarget ::= "copy" object_ref "and" "may" "choose" "new" "targets" "for" "the" "copy" "they" "control"

/* @sem Instruction::[ForEachPlayer{players:OthersThan(EventSubject), binding:0, body:_{instructions:[Optional{decider:Bound(0), body:_{instructions:[Effect{result:@next, operation:$bound_player_copy_retarget}]}}]}}] */
clause_other_players_copy_event ::= "each" "other" "player" "may" bound_player_copy_retarget

/* The target's graveyard is selected before the exile receipt is counted. */
/* @sem Operation::Move{objects:Zone{scope:Players{zone:Graveyard, players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0})}, kind:Card, filter:Any}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_count_opponent_graveyard ::= "exile" "target" "opponent's" "graveyard"

/* The life payment and its per-player token receipt stay in one scope. */
/* @sem Program::Program{instructions:[Repeatable{instructions:[$shared_life_payment_start, If{condition:Not(Outcome(NoLifePaid)), then:_{instructions:[Effect{result:@next, operation:RepeatProcess}]}, otherwise:_{}}]}, Effect{result:@next, operation:CreateTokens{players:$players_singular, tokens:[_{amount:Performed(@marked), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
program_repeated_life_payment_tokens ::= shared_life_payment_start "." "repeat" "this" "process" "until" "no" "one" "pays" "life" "." players_singular "creates" "a" token_recipe "for" "each" "1" "life" "they" "paid" "this" "way"

/* The choice is shared by the return and the valuation, including on inverse printing. */
/* @sem Instruction::[Effect{result:@mark, operation:ChooseObjects{player:DefendingPlayerOf(Source), objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$adjective_nontype}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:One(Result{result:@marked, phase:After, index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[Pump{power:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}, toughness:Constant(0)}], duration:$duration, evaluation:Snapshot}}] */
defending_choice_return_value ::= "defending" "player" "chooses" "a" adjective_nontype "card" "in" "your" "graveyard" "." "return" "that" "card" "to" "your" "hand" "." "this" "creature" "gets" "+" "X" "/" "+" "0" duration "," "where" "X" "is" "the" "mana" "value" "of" "that" "card"

/* All three actions share the first discard's Before receipt. Keeping the
   producer here proves both the action and the receipt used by the consumers. */
/* @sem Instruction::[Effect{result:@next, operation:Discard{players:One(AbilityController), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})}}, Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:Repeat{amount:CountObjects(Transition{result:@prior, phase:Before}), production:Amount{color:$mana_letter, amount:Constant(1)}, choice:Once}}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Add([CountObjects(Transition{result:@back(3), phase:Before}), $number_words])}}] */
instructions_discard_hand_mana_draw ::= "discard" "all" "the" "cards" "in" "your" "hand" "." "add" "{" mana_letter "}" "for" "each" "card" "discarded" "this" "way" "," "then" "draw" "that" "many" "cards" "plus" number_words

/* The chooser is independent of each player whose controlled object is selected. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))])}, count:AsManyAsCan($counter_amount)}}]}}] */
choose_controlled_for_each ::= "for" players_singular "," "you" "choose" counter_amount filter_phrase "that" "player" "controls"

/* Each bound player sacrifices the independently specified population. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(Bound(0)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$other_unshared_chosen_population}})}]}}] */
each_sacrifices_other_unshared ::= players_singular "sacrifices" "all" other_unshared_chosen_population

/* Preserve the ordinary two-sentence ordering for a selection and its follow-up. */
/* @prefer always */
/* @sem Instruction::[...$choose_controlled_for_each, ...$each_sacrifices_other_unshared] */
chosen_each_then_unshared_sacrifice ::= choose_controlled_for_each "." "then" each_sacrifices_other_unshared

/* The cast producer fixes the target, cost and exile replacement for the callback. */
/* @sem Operation::PlayWith{actor:One(AbilityController), action:CastSpell, cards:One($choose_cast_graveyard_from), count:AsManyAsCan(Constant(1)), terms:_{cost:Additional(Cost{parts:[Mana($mana_symbols)]}), into_exile:true}} */
cast_graveyard_additional_exile ::= "cast" choose_cast_graveyard_from "by" "paying" mana_symbols "in" "addition" "to" "its" "other" "costs" "." "if" "that" "spell" "would" "be" "put" "into" "a" "graveyard" "," "exile" "it" "instead"

/* This callback is scoped to the immediately preceding cast producer. */
/* @sem Instruction::Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[Pump{power:ObjectProperty{object:Query{objects:Affected(@back(3)), index:0}, property:ManaValue, information:CurrentOrLastKnown}, toughness:Constant(0)}], duration:$duration, evaluation:Snapshot}} */
cast_spell_value_pump ::= "this" "creature" "gets" "+" "X" "/" "+" "0" duration "," "where" "X" "is" "that" "spell's" "mana" "value"

/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:$cast_graveyard_additional_exile}, Effect{result:@next, operation:ReflexiveTrigger{performed:@prior, body:_{instructions:[$cast_spell_value_pump]}, announcement:_{}}}]}}] */
instructions_optional_cast_value ::= "you" "may" cast_graveyard_additional_exile "." "when" "you" "cast" "that" "spell" "," cast_spell_value_pump

/* The choosing player owns the graveyard being searched. */
/* @sem Operation::ChooseObjects{player:$player_ref, objects:Zone{scope:Players{zone:Graveyard, players:One($player_ref)}, kind:Card, filter:$a_card}, count:AsManyAsCan(Constant(1))} */
shared_chooses_own_graveyard_card ::= player_ref "chooses" a_card "in" "their" "graveyard"

/* @sem Operation::@selected_result($shared_chooses_own_graveyard_card) */
shared_chooses_own_graveyard_card_result ::= shared_chooses_own_graveyard_card

/* Prefer the explicit destination for a selected card moved under your control. */
/* @sem Operation::Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]} */
put_chosen_card_under_your_control ::= "put" "that" "card" "onto" "the" "battlefield" "under" "your" "control"

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$shared_chooses_own_graveyard_card_result}, Effect{result:@next, operation:$put_chosen_card_under_your_control}] */
choose_graveyard_card_then_put ::= shared_chooses_own_graveyard_card_result "." put_chosen_card_under_your_control

/* The payment producer and token quantity share the marked mana receipt. */
/* @sem Program::Program{instructions:[$shared_mana_payment_start, $shared_mana_payment_tokens]} */
program_shared_mana_tokens ::= shared_mana_payment_start "." shared_mana_payment_tokens

/* @sem Instruction::Effect{result:@next, operation:CreateTokens{players:$players_singular, tokens:[TokenSpec{amount:PerformedTotal(@marked), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}} */
shared_mana_payment_tokens ::= players_singular "creates" "X" token_recipe "," "where" "X" "is" "the" "total" "amount" "of" "mana" "paid" "this" "way"

/* Scoped to a damage event grouped by the controller of creature sources. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Draw{players:Union([One(AbilityController), One(Prior(That))]), amount:$card_count}}]} */
creature_controller_shared_draw ::= "you" "and" "the" "controller" "of" "those" "creatures" "each" "draw" card_count

/* The exile and delayed return form one receipt scope; the entry test uses the
   actual arrival of that return, not the original target or the exile receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One($other_target_up_to), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_move_end_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@last_result, phase:After, index:0}, filter:ControlledBy(One(AbilityController))}, then:Program{instructions:[Effect{result:@next, operation:$returned_control_counter}]}, otherwise:Program{}}]}}}] */
exile_other_delayed_owner_counter ::= "exile" other_target_up_to "." "at" delayed_move_end_event "," "return" "that" "card" "to" "the" "battlefield" "under" "its" "owner's" "control" "." "if" "it" "entered" "under" "your" "control" "," returned_control_counter

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(One($self_explicit_ref)), kind:$counter_kind, amount:Constant(1)}]} */
returned_control_counter ::= "put" "a" counter_kind "counter" "on" self_explicit_ref

/* @sem Ability::Triggered{event:Object{event:Attacks, objects:$event_self}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$exile_other_delayed_owner_counter}} */
source_attacks_exile_return_counter ::= "whenever" event_self "attacks" "," exile_other_delayed_owner_counter "."

/* The two branches refer to the target before exile and to the actual exile
   arrival respectively. Keeping the producer and follow-up together proves
   the receipt used by the return. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(SameObject(Source)), $adjective_nontype])}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, If{condition:Compare{left:CountPlayers(Intersection([One(AbilityController), One(ControllerOf(Target{slot:0, index:0}))])), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:_{instructions:[Effect{result:@next, operation:Move{objects:@exile_followup(InZone{objects:One(Result{result:@prior, phase:After, index:0}), zone:Exile}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(ControllerOf(Target{slot:0, index:0})), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:$singular_counted_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}]} */
program_exile_other_controlled_or_controller_token ::= "exile" "another" "target" adjective_nontype "permanent" "." "if" "you" "controlled" "it" "," "return" "it" "to" "the" "battlefield" "tapped" "." "otherwise" "," "its" "controller" "creates" "a" singular_counted_token_recipe "."

/* A controller choice is scoped to the player currently bound by the loop. */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))])}, count:AsManyAsCan(Constant(1))} */
controller_choice_bound_singular ::= "you" "choose" "a" filter_phrase "that" "player" "controls"

/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))])}, count:AsManyAsCan(Constant(1))} */
controller_choice_bound_vowel ::= "you" "choose" "an" filter_phrase "that" "player" "controls"

/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}, count:AsManyAsCan($number_words)} */
controller_choice_bound_plural ::= "you" "choose" number_words filter_plural "that" "player" "controls"

controller_choice_bound ::= controller_choice_bound_singular | controller_choice_bound_vowel | controller_choice_bound_plural

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:$controller_choice_bound}]}}] */
clause_controller_chooses_for_player ::= "for" players_singular "," controller_choice_bound

/* This population excludes the selected object for the bound player. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Earlier{what:Selected, by:Bound(0)})), $filter_plural, Not(Shares{property:CreatureTypes, with:Earlier{what:Selected, by:Bound(0)}})])} */
bound_unshared_creature_type_population ::= "all" "other" filter_plural "they" "control" "that" "don't" "share" "a" "creature" "type" "with" "the" "chosen" "creature" "they" "control"

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(Bound(0)), objects:$bound_unshared_creature_type_population})}]}}] */
clause_bound_sacrifice_unshared ::= "then" players_singular "sacrifices" bound_unshared_creature_type_population

/* The manifest consumes the arrival of this particular shuffled exile pile. */
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0})}, kind:Card, filter:$filter_phrase}), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[ExilePile{shuffled:true}]}}, qualifiers:[]} */
manifest_graveyard_pile ::= "exile" "all" filter_phrase "cards" "from" "target" "player's" "graveyard" "in" "a" "face-down" "pile" "," "shuffle" "that" "pile"

/* The damage event supplies the antecedent of "it". */
/* @sem Operation::Move{objects:Union([One(EventSubject), $ordered_cards]), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[ExilePile{shuffled:true}]}}, qualifiers:[]} */
manifest_damage_source_pile ::= "exile" "it" "and" ordered_cards "in" "a" "face-down" "pile" "," "shuffle" "that" "pile"

manifest_pile_producer ::= manifest_graveyard_pile

/* @sem Operation::@manifest_result(Operation::Manifest{actor:One(AbilityController), source:Cards(Transition{result:@prior, phase:After}), entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
manifest_shuffled_pile_arrivals ::= "manifest" "those" "cards"

/* @sem Instruction::[Effect{result:@next, operation:$manifest_pile_producer}, Effect{result:@next, operation:$manifest_shuffled_pile_arrivals}] */
manifest_shuffled_exile_pile ::= manifest_pile_producer "," "then" manifest_shuffled_pile_arrivals

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$manifest_shuffled_exile_pile}} */
spell_manifest_shuffled_exile_pile ::= manifest_shuffled_exile_pile "."

/* @sem Instruction::[Effect{result:@next, operation:$manifest_damage_source_pile}, Effect{result:@next, operation:$manifest_shuffled_pile_arrivals}] */
manifest_damage_pile_followup ::= manifest_damage_source_pile "," "then" manifest_shuffled_pile_arrivals

/* @sem Ability::Triggered{event:$event_combat_damage_player, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$manifest_damage_pile_followup}} */
triggered_manifest_shuffled_exile_pile ::= "when" event_combat_damage_player "," manifest_damage_pile_followup "."

/* Bind the matching receipt to the immediately preceding mill. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$instructions}, otherwise:Program{}}] */
instructions_mill_matching_condition ::= "mill" card_count "." "if" "at" "least" "one" filter_phrase "card" "is" "milled" "this" "way" "," instructions

/* Keep the controller's discard receipt bound to this discard producer. */
/* @sem Instruction::[Effect{result:@mark, operation:Discard{players:All, amount:$card_count, random:false}}, If{condition:Compare{left:CountObjects(MovedBy{result:@marked, phase:After, player:AbilityController}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$clause}, otherwise:Program{}}] */
instructions_each_discard_controller_receipt ::= "each" "player" "discards" card_count "." "if" "you" "discarded" "a" "card" "this" "way" "," clause

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$instructions_each_discard_controller_receipt}} */
triggered_each_discard_controller_receipt ::= event_clause "," instructions_each_discard_controller_receipt "."

/* The producer and both consumers share the same face-up library exile receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_top_cards_of_your_library}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase}, count:Exactly($counter_amount), cost:Normal}}]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:Library{position:BottomRandom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
instructions_exile_top_optional_cast_rest ::= exile_top_cards_of_your_library "." "you" "may" "cast" counter_amount filter_phrase "spell" "from" "among" "them" "." "then" "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* Keep the exile producer and its owner's permission together: the permission
   names the one arrival of this particular move. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:AllOf([Not(SameObject(Source)), $exile_other_quality, AnyOf([$noun, $subtype])])}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(OwnerOf(Result{result:@prior, phase:After, index:0}))), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:WhileExiled(Result{result:@prior, phase:After, index:0}), evaluation:LiveObjects}}]} */
exile_other_target_owner_permission ::= "exile" "up" "to" "one" "other" "target" exile_other_quality noun "or" subtype "." "for" "as" "long" "as" "that" "card" "remains" "exiled" "," "its" "owner" "may" "play" "it"

exile_other_quality ::= adjective_tapped | adjective_untapped

/* The source is the attacking event subject for this composed trigger. */
/* @sem Ability::Triggered{event:EventSpec::Object{event:Attacks, objects:$event_self}, limits:TriggerLimits{}, announcement:@announcement, body:$exile_other_target_owner_permission} */
exile_owner_permission_attack_trigger ::= "whenever" event_self "attacks" "," exile_other_target_owner_permission "."

/* Keep the optional sacrifice and both tests of its own receipt in one scope. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Constant(1))})}]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:Before, index:0}, filter:$filter_phrase_2}, then:$program, otherwise:Program{}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$filter_phrase_3}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}, then:$program_2, otherwise:Program{}}]} */
program_optional_sacrifice_two_tests ::= "you" "may" "sacrifice" "a" filter_phrase "." "if" "you" "sacrifice" "a" filter_phrase "this" "way" "," program "." "if" "you" "don't" "sacrifice" "a" filter_phrase "," program

/* A singular article cannot print a larger quantity before a singular card. */
/* @sem Operation::ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:$card_filter}, count:AsManyAsCan($counter_a)} */
hand_entry_bound_singular_choice ::= counter_a card_filter "card"

/* A bound player's own hand choice and battlefield arrival share their identity. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$hand_entry_bound_singular_choice}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{}}, qualifiers:[]}}]} */
bound_hand_entry_program ::= "put" hand_entry_bound_singular_choice "from" "their" "hand" "onto" "the" "battlefield"

/* Plural quantities use their own print shape. */
/* @sem Operation::ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:$card_filter}, count:AsManyAsCan($number_words)} */
hand_entry_bound_plural_choice ::= number_words card_filter "cards"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$hand_entry_bound_plural_choice}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{}}, qualifiers:[]}}]} */
bound_hand_entry_plural_program ::= "put" hand_entry_bound_plural_choice "from" "their" "hand" "onto" "the" "battlefield"

/* The controller starts the ordered loop; each bound player chooses independently. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, starting_with:AbilityController, body:Program{instructions:[Optional{decider:Bound(0), body:$bound_hand_entry_program}]}}] */
clause_starting_optional_hand_entry ::= "starting" "with" "you" "," players_singular "may" bound_hand_entry_program

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, starting_with:AbilityController, body:Program{instructions:[Optional{decider:Bound(0), body:$bound_hand_entry_plural_program}]}}] */
clause_starting_optional_hand_entry_plural ::= "starting" "with" "you" "," players_singular "may" bound_hand_entry_plural_program

/* Each player selects from their own graveyard and controls their arrivals. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:$filter_phrase}, count:AsManyAsCan($value)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}] */
clause_each_graveyard_battlefield_return ::= players_singular "returns" value filter_phrase "cards" "from" "their" "graveyard" "to" "the" "battlefield"

/* The bound player chooses from their own zone and controls the arrival. */
/* @sem Vec<Instruction>::[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:$personal_mill_zone, players:One(Bound(0))}, kind:Card, filter:$filter_phrase}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(Bound(0)), arrival:$search_option_entry}, qualifiers:[]}}] */
bound_personal_card_entry ::= "puts" "a" filter_phrase "card" "from" "their" personal_mill_zone search_option_entry

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:$bound_personal_card_entry}}] */
clause_each_personal_card_entry ::= players_singular bound_personal_card_entry

/* The count is scoped to the controller's own mill, whose arrivals are in
   that player's graveyard. Both instructions must match for inverse printing. */
/* @sem Vec<Instruction>::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:LoseLife{players:$players_singular, amount:$milled_graveyard_life_amount}}] */
mill_graveyard_life_sequence ::= "mill" card_count "." players_singular "loses" milled_graveyard_life_amount

/* This amount is used only with the scoped mill producer above. */
/* @sem Expr::Multiply([$value, CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase})]) */
milled_graveyard_life_amount ::= value "life" "for" "each" filter_phrase "card" "put" "into" "your" "graveyard" "this" "way"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$mill_graveyard_life_sequence}} */
spell_mill_graveyard_life ::= mill_graveyard_life_sequence "."

/* The bound participant chooses from their own graveyard and controls the arrival. */
/* @sem Vec<Instruction>::[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:$bound_return_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
bound_optional_graveyard_battlefield ::= "return" bound_return_filter "card" "from" "their" "graveyard" "to" "the" "battlefield"

bound_optional_graveyard_action ::= bound_optional_color_return | bound_optional_graveyard_battlefield

/* @sem Instruction::[ForEachPlayer{players:$optional_action_players, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:$bound_optional_graveyard_action}}]}}] */
clause_each_optional_graveyard_action ::= optional_action_players "may" bound_optional_graveyard_action

bound_return_filter ::= bound_return_filter_a | bound_return_filter_an

/* @sem ObjectFilter::$filter_phrase */
bound_return_filter_a ::= "a" filter_phrase

/* @sem ObjectFilter::$filter_phrase */
bound_return_filter_an ::= "an" filter_phrase

/* A resolution-time choice from your graveyard, followed by its move. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:$graveyard_return_arrival}, qualifiers:[]}}] */
graveyard_single_return_battlefield ::= "return" "a" filter_phrase "card" "from" "your" "graveyard" graveyard_return_arrival

/* The anaphoric second choice is used only after a graveyard return. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
graveyard_another_return_hand ::= "return" "another" filter_phrase "card" "from" "your" "graveyard" "to" "your" "hand"

/* @sem Vec<Instruction>::@then_sequence($graveyard_single_return_battlefield, $graveyard_another_return_hand) */
graveyard_return_then_another ::= graveyard_single_return_battlefield "," "then" graveyard_another_return_hand

/* The second instruction refers to the same announced target as the placement. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($target_permanent)), kind:$counter_kind, amount:Constant(1)}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_permanent)), changes:[GrantKeyword($keyword_name)], duration:Indefinite, evaluation:Snapshot}}]} */
program_counter_target_keyword_indefinite ::= "put" "a" counter_kind "counter" "on" target_permanent "." "it" "gains" keyword_name

/* A targeted land retains its identity even if counter placement is prevented. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Land), Counters(_{kind:$counter_kind_2, comparison:Equal, value:Constant(0)})])}), index:0})), kind:$counter_kind, amount:Constant(1)}]} */
put_counter_on_land_without ::= "put" "a" counter_kind "counter" "on" "target" "land" "without" "a" counter_kind "counter" "on" "it"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$put_counter_on_land_without}, Effect{result:@next, operation:$counter_land_grant}]} */
counter_land_grant_program ::= put_counter_on_land_without "." counter_land_grant

/* A choice of damage source and its replacement share one result identity. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:DamageSources($chosen_damage_source_filter), count:Exactly(Constant(1))}}, Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Any, sources:SameObject(Result{result:@prior, phase:Before, index:0}), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}}}] */
prevent_chosen_source_damage ::= "prevent" "all" "damage" chosen_damage_source_filter "of" "your" "choice" "would" "deal" this_duration

/* @sem ObjectFilter::$adjective_color */
chosen_damage_source_color ::= "a" adjective_color "source"

/* @sem ObjectFilter::Any */
chosen_damage_source_any ::= "a" "source"

chosen_damage_source_filter ::= chosen_damage_source_color | chosen_damage_source_any

/* Select one damage source at resolution; the consuming instruction scopes its use. */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:DamageSources(Any), count:Exactly(Constant(1))} */
choose_one_damage_source ::= "a" "source" "of" "your" "choice"

/* @sem Instruction::[Effect{result:@next, operation:$choose_one_damage_source}, Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Any, sources:SameObject(Result{result:@prior, phase:Before, index:0}), recipients:Objects(SameObject($object_ref)), kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage(Objects($affected))}}]}}}] */
instructions_chosen_source_redirect ::= "all" "damage" "that" "would" "be" "dealt" this_duration "to" object_ref "by" choose_one_damage_source "is" "dealt" "to" affected "instead"

/* Choose one of two printed battlefield populations for a subsequent action. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Filter, terms:_{count:Exactly(Constant(1)), options:[Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$plural_atomic}), Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$plural_atomic_2})]}} */
choice_two_battlefield_populations ::= "all" plural_atomic "or" "all" plural_atomic

/* Partition the chosen population by the named kind for the same destroy action. */
/* @sem Operation::Together([Destroy{objects:Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:ChosenFilter}, filter:$plural_atomic}, regeneration:false}, Destroy{objects:Difference{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:ChosenFilter}, excluding:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$plural_atomic}}, regeneration:true}]) */
chosen_destroy_regeneration_partition ::= plural_atomic "destroyed" "this" "way" "can't" "be" "regenerated"

/* @sem Instruction::[Effect{result:@next, operation:$choice_two_battlefield_populations}, Effect{result:@next, operation:$chosen_destroy_regeneration_partition}] */
clause_destroy_choice_partition ::= "destroy" choice_two_battlefield_populations "." chosen_destroy_regeneration_partition

/* Keep the counted sacrifice and its dependent damage in one instruction sequence. */
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:$affected, choose:AnyNumber}) */
sacrifice_any_population ::= "sacrifice" "any" "number" "of" affected

/* @sem Instruction::[Effect{result:@next, operation:$sacrifice_any_population}, Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:$recipients, amount:CountObjects(Transition{result:@prior, phase:Before}), preventable:true}}] */
instructions_sacrifice_count_damage ::= sacrifice_any_population "." object_ref "deals" "that" "much" "damage" "to" recipients

/* The singular sacrifice and the tested before-receipt share one scope. */
/* @sem Instruction::[Effect{result:@mark, operation:@sacrificed_result(Operation::Sacrifice{players:$players_singular, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Constant(1))})}, If{condition:ObjectMatches{object:Result{result:@marked, phase:Before, index:0}, filter:$filter_phrase_2}, then:Program{instructions:$sacrifice_match_followup}, otherwise:Program{}}] */
instructions_singular_sacrifice_matches ::= players_singular "sacrifices" "a" filter_phrase "of" "their" "choice" "." "if" "a" filter_phrase "is" "sacrificed" "this" "way" "," sacrifice_match_followup

/* @sem Instruction::[...$clause_third, $conditional_token_change] */
sacrifice_match_followup ::= clause_third "," "and" conditional_token_change

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_singular_sacrifice_matches}} */
spell_singular_sacrifice_matches ::= instructions_singular_sacrifice_matches "."

/* This choice names the artifact alternative and delegates its resolution to the keyword action. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::ChooseProtection} */
protection_artifact_or_color_choice ::= "artifacts" "or" "from" "the" "color" "of" "your" "choice"

/* The subject and duration remain independent operands of the granted protection. */
/* @sem Instruction::[Effect{result:@next, operation:$protection_artifact_or_color_choice}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[GrantKeyword(Protection(Objects(_{kind:Any, filter:Chosen(Color)})))], duration:$duration, evaluation:Snapshot}}] */
clause_gains_artifact_or_color_protection ::= affected "gains" "protection" "from" protection_artifact_or_color_choice duration

/* The announced permanent is the antecedent of the following conditional actions. */
/* @sem Instruction::[$conditional_target_saddle, $conditional_target_animation] */
instructions_choose_conditional_saddle_animation ::= conditional_target_saddle "and" conditional_target_animation

/* @sem Instruction::@resolution(Instruction::If{condition:ObjectMatches{object:$target_object, filter:$conditional_permanent_kind}, then:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Saddle{object:Target{slot:@last_slot, index:0}}}}]}, otherwise:Program{}}) */
conditional_target_saddle ::= "choose" target_object "." "until" "end" "of" "turn" "," "that" "permanent" "becomes" "saddled" conditional_permanent_kind

/* The omitted subject and duration refer to the preceding target and turn. */
/* @sem Instruction::If{condition:ObjectMatches{object:Target{slot:@last_slot, index:0}, filter:$conditional_permanent_kind}, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Targets(@last_slot)), changes:$conditional_becoming_types, duration:EndOfTurn, evaluation:Snapshot}}]}, otherwise:Program{}} */
conditional_target_animation ::= conditional_becoming_types conditional_permanent_kind

/* @sem ObjectFilter::$filter_phrase */
conditional_permanent_kind ::= "if" "it's" "a" filter_phrase

/* @sem Change::$bk_artifact_native */
conditional_becoming_types ::= "becomes" "an" bk_artifact_native

/* @sem Operation::Keyword{actor:@subject, action:KeywordAction::LoseUnspentMana} */
lose_unspent_mana_base ::= "lose" "all" "unspent" "mana"

/* @sem Operation::Keyword{actor:@subject, action:KeywordAction::LoseUnspentMana} */
lose_unspent_mana_third ::= "loses" "all" "unspent" "mana"

/* A postposed condition selects a complete replacement instruction, leaving
   the original instruction as the fallback. Both retain their own operands. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:$clause_2}, otherwise:Program{instructions:$clause}}] */
instructions_postposed_instead ::= clause "." NEWLINE clause "instead" "if" condition

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_postposed_instead}} */
spell_postposed_instead ::= instructions_postposed_instead "."

/* Each object is the damage source; its controller is determined independently. */
/* @sem Instruction::[ForEachObject{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, binding:0, body:_{instructions:[Effect{result:@next, operation:DealDamage{source:Bound(0), recipients:Players(One(ControllerOf(Bound(0)))), amount:$value, preventable:true}}]}}] */
each_object_damage_controller ::= "each" filter_phrase "deals" value "damage" "to" "its" "controller"

/* The attachment remains the source and its attached object is the recipient. */
/* @sem Instruction::[ForEachObject{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, AttachedTo(InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}))])}, binding:0, body:_{instructions:[Effect{result:@next, operation:DealDamage{source:Bound(0), recipients:Objects(One(AttachedTo(Bound(0)))), amount:$value, preventable:true}}]}}] */
each_object_damage_attached_creature ::= "each" filter_phrase "attached" "to" "a" "creature" "deals" value "damage" "to" "the" "creature" "it's" "attached" "to"

each_object_damage_clause ::= each_object_damage_controller | each_object_damage_attached_creature

/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:[...$each_object_damage_clause, ...$each_object_damage_clause_2]}} */
each_object_damage_then_spell ::= each_object_damage_clause "," "then" each_object_damage_clause "."

/* The mill and the return consume the same arrival receipt; the move returns the selected card to its owner's hand. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$milled_return_filter}, count:Exactly(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
instructions_mill_then_return_among ::= "mill" card_count "," "then" "you" "may" "return" "a" milled_return_filter "card" "from" "among" "them" "to" "your" "hand"

/* @sem SkippedPart::CombatPhase */
skipped_combat_phase ::= "combat" "phase"

/* An ordered choice and its later sacrifices remain independent instructions. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:CardType, terms:_{options:[$ordered_card_type, $ordered_card_type_2, $ordered_card_type_3], ordered:true, count:Exactly(Constant(3))}} */
choose_ordered_card_types ::= "choose" "an" "order" "for" ordered_card_type "," ordered_card_type "," "and" ordered_card_type

ordered_card_type ::= ordered_card_type_artifact | ordered_card_type_creature | ordered_card_type_land | ordered_card_type_enchantment | ordered_card_type_planeswalker

/* @sem Operand::Vocabulary{family:CardType, form:Artifact} */
ordered_card_type_artifact ::= "artifacts"

/* @sem Operand::Vocabulary{family:CardType, form:Creature} */
ordered_card_type_creature ::= "creatures"

/* @sem Operand::Vocabulary{family:CardType, form:Land} */
ordered_card_type_land ::= "lands"

/* @sem Operand::Vocabulary{family:CardType, form:Enchantment} */
ordered_card_type_enchantment ::= "enchantments"

/* @sem Operand::Vocabulary{family:CardType, form:Planeswalker} */
ordered_card_type_planeswalker ::= "planeswalkers"

/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:@subject, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:NthChosen(0)}, choose:AsManyAsCan(Constant(1))}) */
sacrifice_ordered_first ::= "sacrifices" "one" "permanent" "of" "their" "choice" "of" "the" "first" "type"

/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:@subject, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$ordered_type_index}, choose:AsManyAsCan($value)}) */
sacrifice_ordered_later ::= "sacrifices" value "of" "their" "choice" "of" "the" ordered_type_index "type"

/* @sem ObjectFilter::NthChosen(1) */
ordered_type_second ::= "second"

/* @sem ObjectFilter::NthChosen(2) */
ordered_type_third ::= "third"

ordered_type_index ::= ordered_type_second | ordered_type_third

/* Keep the choice and the first explicit sacrifice in one scope: a legacy
   seeded choice also supplies that sacrifice as an implicit instruction. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_ordered_card_types}, Effect{result:@next, operation:@apply($players_singular, $sacrifice_ordered_first)}, Effect{result:@next, operation:@apply($players_singular, $sacrifice_ordered_later)}, Effect{result:@next, operation:@apply($players_singular, $sacrifice_ordered_later_2)}] */
ordered_choice_sacrifice_sequence ::= choose_ordered_card_types "." players_singular sacrifice_ordered_first "," sacrifice_ordered_later "," "then" sacrifice_ordered_later

/* The target and tapped arrival are operands of the same return action. */
/* @sem Operation::Move{objects:$target_lesser_event_graveyard_card, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]} */
return_lesser_event_card_tapped ::= "return" target_lesser_event_graveyard_card "to" "the" "battlefield" "tapped"

/* @sem Operation::PlayersDo{players:One(AbilityController), optional:true, once_each_turn:true, body:[Program{instructions:[Effect{result:@next, operation:$return_lesser_event_card_tapped}]}]} */
once_lesser_event_return ::= return_lesser_event_card_tapped

/* A distributed target range keeps its counter quantity and recipient filter independent. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:$target_adjacent_range, filter:$controlled_other_union, distribute:$count_plural}))), kind:$counter_kind, amount:DistributedShare(@share)}]} */
distribute_counters_to_other_range ::= "distribute" count_plural counter_kind "counters" "among" target_adjacent_range "other" "target" controlled_other_union

/* The second outcome repeats the same token recipe; both rows use the same
   announced target and the same intrinsic end-of-combat ability. */
/* @sem Program::Program{instructions:[Repeatable{instructions:[Effect{result:@next, operation:$roll_die_action}, If{condition:$repeat_die_range, then:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$copy_chosen_creature, exceptions:[CopyException::RemoveSupertypes([Legendary]), $copy_end_combat_ability]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}]}, otherwise:_{}}, If{condition:$repeat_die_range_2, then:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$value, words:CreatingEffect, recipe:Copy{object:$copy_chosen_creature, exceptions:[CopyException::RemoveSupertypes([Legendary]), $copy_end_combat_ability]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}, Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:RepeatProcess}]}}]}, otherwise:_{}}]}]} */
program_repeat_die_copy_table ::= "choose" copy_chosen_creature "," "then" roll_die_action "." NEWLINE repeat_die_range "|" "create" "a" "tapped" "and" "attacking" "token" "that's" "a" "copy" "of" "that" "creature" "," "except" "it's" "not" "legendary" "and" copy_end_combat_ability NEWLINE repeat_die_range "|" "create" value "of" "those" "tokens" "." "you" "may" "roll" "again"

/* A complete choose/copy/follow-up sequence keeps the chosen creatures and the
   one created token inside the same ability frame. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(Bound(0)))])}, count:Between{minimum:Constant(1), maximum:Constant(2)}}}]}}] */
each_player_choose_one_or_two_creatures ::= "each" "player" "chooses" "one" "or" "two" "creatures" "they" "control"

/* @sem Instruction::[ForEachPlayer{players:Matching{binding:0, condition:ChoseNth{player:Bound(0), nth:1}}, binding:0, body:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(Bound(0)), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:NthChosen{index:0, by:Bound(0)}, exceptions:[CopyException::RemoveSupertypes([Legendary])]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}] */
each_player_copy_first_chosen_creature ::= "each" "player" "creates" "a" "token" "that's" "a" "copy" "of" "the" "first" "creature" "they" "chose" "," "except" "it" "isn't" "legendary"

/* @sem Expr::ObjectProperty{object:NthChosen{index:1, by:Bound(0)}, property:$creature_stat, information:CurrentOrLastKnown} */
second_chosen_creature_stat ::= "the" creature_stat "of" "the" "second" "creature" "they" "chose"

/* @sem PlayerSet::Matching{binding:0, condition:ChoseNth{player:Bound(0), nth:2}} */
each_player_who_chose_second_creature ::= "each" "player" "who" "chose" "a" "second" "creature"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:InSet(Earlier{what:Created, by:One(Bound(0))})} */
token_created_by_bound_player ::= "the" "token" "they" "created"

/* @sem Operation::PutCounters{placements:[_{recipients:Objects($token_created_by_bound_player), kind:$counter_kind, amount:$second_chosen_creature_stat}]} */
put_counters_on_bound_created_token ::= "puts" "a" "number" "of" counter_kind "counters" "on" token_created_by_bound_player "equal" "to" second_chosen_creature_stat

/* @sem Instruction::[ForEachPlayer{players:$each_player_who_chose_second_creature, binding:0, body:_{instructions:[Effect{result:@next, operation:$put_counters_on_bound_created_token}]}}] */
each_second_chooser_puts_token_counters ::= each_player_who_chose_second_creature put_counters_on_bound_created_token

/* The producer and consumer are scoped together so "the token" cannot refer
   to an unrelated earlier creation. */
/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:Program{instructions:[...$each_player_choose_one_or_two_creatures, ...$each_player_copy_first_chosen_creature, ...$each_second_chooser_puts_token_counters]}} */
triggered_chosen_creatures_copy_counters ::= event_clause "," each_player_choose_one_or_two_creatures "." each_player_copy_first_chosen_creature "." "then" each_second_chooser_puts_token_counters "."

/* Only the enclosing producer may bind the counted object's Before receipt. */
/* @sem Expr::CountCounters(_{recipients:Objects(One(Result{result:@marked, phase:Before, index:0})), information:CurrentOrLastKnown}) */
destroyed_object_counter_total ::= "that" "many"

/* The two alternatives share the current count, recipient and selection. */
/* @sem Instruction::ChooseOne{decider:AbilityController, options:[_{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}), kind:$counter_kind, amount:$destroyed_object_counter_total, selection:_{player:AbilityController, count:AsManyAsCan($counter_amount)}}]}}]}, _{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}), kind:$counter_kind_2, amount:$destroyed_object_counter_total, selection:_{player:AbilityController, count:AsManyAsCan($counter_amount)}}]}}]}]} */
put_counted_counter_choice ::= "put" destroyed_object_counter_total counter_kind "counters" "or" counter_kind "counters" "on" counter_amount filter_phrase

/* The antecedent, counter condition and quantity all refer to this destroy's receipt. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Destroy{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Artifact)}), index:0}), regeneration:true}}, If{condition:$destroy_counter_condition, then:Program{instructions:[$put_counted_counter_choice]}, otherwise:Program{}}]} */
program_destroy_artifact_counter_choice ::= "destroy" "target" "artifact" "." "if" destroy_counter_condition "," put_counted_counter_choice

/* The life-loss event and its repeated-payment consumer share one scope. */
/* The event amount is meaningful as life lost only inside this trigger. */
/* @sem Ability::Triggered{event:$event_you_lose_life, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$sacrifice_per_life_lost}]}} */
triggered_sacrifice_per_life_lost ::= "whenever" event_you_lose_life "," sacrifice_per_life_lost "."

/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan($life_lost_event_amount)}) */
sacrifice_per_life_lost ::= "sacrifice" "a" filter_phrase life_lost_event_amount

/* The two phases share each player's discard receipt; keeping the producer
   here proves the antecedent of the count in both directions. */
/* @sem Program::Program{instructions:[ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Effect{result:@mark, operation:Discard{players:One(Bound(0)), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), random:false}}]}}, ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(Bound(0)), tokens:[TokenSpec{amount:CountObjects(MovedBy{result:@marked, phase:After, player:Bound(0)}), words:CreatingEffect, recipe:$paid_mana_plural_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}]} */
program_each_hand_discard_create_tokens ::= hand_plural_players "discards" hand_discard_all_words "," "then" "creates" "that" "many" paid_mana_plural_token_recipe

/* @sem Ability::Spell{announcement:@announcement, body:$program_each_hand_discard_create_tokens} */
spell_each_hand_discard_create_tokens ::= program_each_hand_discard_create_tokens "."

/* Distribute a stated number of counters across a bounded group of other targets. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Expr::@plural_amount($number_words_2)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@another_target_reference(ObjectFilter::$plural))), $plural), distribute:Expr::@plural_amount($number_words)}))), kind:$counter_kind, amount:DistributedShare(1)}]} */
distribute_counters_other_targets ::= "distribute" number_words counter_kind "counters" "among" "up" "to" number_words "other" "target" plural

/* Each player's target is announced as part of one constrained target set. */
/* @sem Operation::PutCounters{placements:[$each_player_target_counter_placement]} */
put_each_player_target_counters ::= "for" "each" "player" "," "put" each_player_target_counter_placement

each_player_target_counter_placement ::= each_player_target_counter_one | each_player_target_counter_many

/* @sem CounterPlacement::CounterPlacement{recipients:Objects($each_player_distinct_controlled_target), kind:$counter_kind, amount:$counter_a} */
each_player_target_counter_one ::= counter_a counter_kind "counter" "on" each_player_distinct_controlled_target

/* @sem CounterPlacement::CounterPlacement{recipients:Objects($each_player_distinct_controlled_target), kind:$counter_kind, amount:$count_plural} */
each_player_target_counter_many ::= count_plural counter_kind "counters" "on" each_player_distinct_controlled_target

/* The following counter count is the actual life lost by this specific
   immediately preceding life-loss instruction. */
/* @sem Instruction::[Effect{result:@next, operation:@apply($players_singular, $lose_life_amount)}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:Performed(@prior)}]}}] */
instructions_life_loss_counter_receipt ::= players_singular lose_life_amount "." "put" "a" counter_kind "counter" "on" affected "for" "each" "1" "life" "lost" "this" "way"

/* The second choice guards this player's action and supplies its measured
   object. The earlier-created set is scoped to that same player. */
/* @sem Expr::ObjectProperty{object:NthChosen{index:1, by:Bound(0)}, property:$receipt_stat, information:CurrentOrLastKnown} */
second_choice_stat ::= "the" receipt_stat "of" "the" "second" "creature" "they" "chose"

/* @sem Instruction::[ForEachPlayer{players:Matching{binding:0, condition:ChoseNth{player:Bound(0), nth:2}}, binding:0, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:InSet(Earlier{what:Created, by:One(Bound(0))})}), kind:$counter_kind, amount:$second_choice_stat}]}}]}}] */
each_second_choice_counter ::= "then" "each" "player" "who" "chose" "a" "second" "creature" "puts" "a" "number" "of" counter_kind "counters" "on" "the" "token" "they" "created" "equal" "to" second_choice_stat

/* The amount and announced recipients retain the same event-subject X. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($event_x_distribution_targets), kind:$counter_kind, amount:DistributedShare(0)}]} */
distribute_event_x_target_counters ::= "distribute" "X" counter_kind "counters" "among" event_x_distribution_targets

/* The life-gain amount is supplied only by the enclosing gain-life trigger. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:EventAmount}]} */
life_gained_counter_placement ::= "put" "a" counter_kind "counter" "on" affected "for" "each" "1" "life" "you" "gained"

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$alternative_mana, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:$life_gained_counter_placement}]}, otherwise:Program{}}]} */
life_gained_optional_payment_counters ::= "you" "may" alternative_mana "." "if" "you" "do" "," life_gained_counter_placement

/* @sem Ability::Triggered{event:$event_gain_life, limits:TriggerLimits{}, announcement:@announcement, body:$life_gained_optional_payment_counters} */
triggered_life_gained_optional_counters ::= "whenever" event_gain_life "," life_gained_optional_payment_counters "."

/* @sem Ability::Triggered{event:$event_gain_life, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$life_gained_counter_placement}]}} */
triggered_life_gained_counters ::= "whenever" event_gain_life "," life_gained_counter_placement "."

/* The first target receives the counters and remains the first fighter. */
/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($chosen_controlled_fighter)), kind:$counter_kind, amount:Constant(1)}]}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:Target{slot:0, index:0}, second:$chosen_other_fighter}}}] */
shared_counter_then_fight ::= "put" "a" counter_kind "counter" "on" chosen_controlled_fighter "," "then" "it" "fights" chosen_other_fighter

/* The conditional refers to the already announced controlled fighter. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$shared_counter_then_fight, ...$chosen_fighter_if_first]}} */
shared_counter_fight_conditional_spell ::= shared_counter_then_fight "." NEWLINE chosen_fighter_if_first "."

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$shared_counter_then_fight}} */
shared_counter_fight_spell ::= shared_counter_then_fight "."

/* A symbolic counter amount can be bound by an enclosing definition of X. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:AnnouncedX}]} */
receipt_x_counter_placement ::= "put" "X" counter_kind "counters" "on" affected

/* The arrival receipt belongs to this mill and its player, not an arbitrary prior action. */
/* @sem Instruction::[Effect{result:@next, operation:Mill{players:$players_singular, amount:$card_count}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountObjects(Matching{objects:Transition{result:@prior, phase:After}, filter:$filter_phrase})}}] */
instructions_mill_filtered_draw ::= players_singular "mills" card_count mill_filtered_draw_join "you" "draw" "a" "card" "for" "each" filter_phrase "card" "put" "into" "their" "graveyard" "this" "way"

/* @sem () */
mill_filtered_draw_join ::= "." | "," "then"

/* The conditional continuation consumes the receipt of this particular return. */
/* @sem Operation::CreateDelayedTrigger{event:$delayed_move_any_end, start:Immediately, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Move{selections:[_{objects:$affected}], destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, changes:$static_changes}}]}, otherwise:Program{}}]}} */
delayed_return_perpetual ::= "at" delayed_move_any_end "," "return" affected "to" "its" "owner's" "hand" "." "if" "you" "do" "," "it" "perpetually" static_changes

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:$delayed_return_perpetual}]} */
operation_delayed_return_program ::= operation "." delayed_return_perpetual "."

/* The named population in the follow-up must agree with the chosen kind. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, starting_with:$ordered_choice_start, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($noun, $plural), $modifiers])}, count:AsManyAsCan($ordered_choice_one)}}]}}, Effect{result:@next, operation:$ordered_choice_action}] */
ordered_player_choice_followup ::= "starting" "with" ordered_choice_start "," players_singular "chooses" ordered_choice_one noun modifiers "." NEWLINE? ordered_choice_action "the" "chosen" plural

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, starting_with:$ordered_choice_start, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($plural, $plural_2), $modifiers])}, count:AsManyAsCan($ordered_choice_many)}}]}}, Effect{result:@next, operation:$ordered_choice_action}] */
ordered_player_choices_followup ::= "starting" "with" ordered_choice_start "," players_singular "chooses" ordered_choice_many plural modifiers "." NEWLINE? ordered_choice_action "the" "chosen" plural

ordered_choice_one ::= counter_a | n1

ordered_choice_many ::= n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10 | n11 | n12 | n13 | n14 | n15 | n20 | n30 | number_hundred | number_x

/* @sem PlayerRef::Seat{of:AbilityController, side:Next} */
ordered_choice_start ::= "the" "next" "opponent" "in" "turn" "order"

ordered_choice_action ::= ordered_choice_destroy | ordered_choice_tap

/* @sem Operation::Destroy{objects:Selected(@prior), regeneration:true} */
ordered_choice_destroy ::= "destroy"

/* @sem Operation::SetTapped{objects:Selected(@prior), tapped:true} */
ordered_choice_tap ::= "tap"

/* The selected target gains protection from the chosen color or colorless. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:ColorOrColorless, terms:_{count:Exactly(Constant(1)), options:[Term{family:ChoosableColor, form:AnyColor}]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_object)), changes:[GrantKeyword(Protection(Objects(_{kind:Any, filter:Chosen(Color)})))], duration:$duration, evaluation:Snapshot}}] */
protection_target_color_or_colorless ::= target_object "gains" "protection" "from" "colorless" "or" "from" "the" "color" "of" "your" "choice" duration

/* The subsequent type test refers to the target introduced by the grant. */
/* @sem Instruction::[...$protection_target_color_or_colorless, $target_type_conditional_branch] */
protection_target_type_followup ::= protection_target_color_or_colorless "." target_type_conditional_branch

/* The plural population returns to each permanent's own owner. */
/* @prefer always */
/* @sem Operation::Move{objects:$enchanted_creature_and_attached_population, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_attached_population_hand ::= "return" enchanted_creature_and_attached_population "to" "their" "owners'" "hands"

/* Each target remains both the damage source and the owner of its measured property. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$mutual_damage_controlled, recipients:Objects(One($mutual_damage_opposing)), amount:ObjectProperty{object:$mutual_damage_controlled, property:$mutual_damage_stat, information:CurrentOrLastKnown}, preventable:true}}, Effect{result:@next, operation:DealDamage{source:$mutual_damage_opposing, recipients:Objects(One($mutual_damage_controlled)), amount:ObjectProperty{object:$mutual_damage_opposing, property:$mutual_damage_stat, information:CurrentOrLastKnown}, preventable:true}}] */
instructions_mutual_target_stat_damage ::= "choose" mutual_damage_controlled "and" mutual_damage_opposing "." "each" "of" "those" "creatures" "deals" "damage" "equal" "to" "its" mutual_damage_stat "to" "the" "other"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$arena_fighter_kind, ControlledBy(One(AbilityController))])}), index:0} */
mutual_damage_controlled ::= "target" arena_fighter_kind "you" "control"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$arena_fighter_kind, ControlledBy(OpponentsOf(AbilityController))])}), index:0} */
mutual_damage_opposing ::= "target" arena_fighter_kind "an" "opponent" "controls"

mutual_damage_stat ::= stat_power | stat_toughness | stat_mana_value

/* Scope the named card to the immediately preceding target moved to exile. */
/* @sem Instruction::[...$exiled_stat_producer, Effect{result:@next, operation:$exiled_stat_counter_placement}] */
instructions_exiled_card_stat_counters ::= exiled_stat_producer "." exiled_stat_counter_placement

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
exiled_stat_producer ::= "exile" target_card

/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:Expr::ObjectProperty{object:ObjectRef::@card_receipt, property:$receipt_stat, information:CurrentOrLastKnown}}]} */
exiled_stat_counter_placement ::= "put" "X" counter_kind "counters" "on" affected "," "where" "X" "is" "the" receipt_stat "of" "the" "card" "you" "exiled"

/* A trailing exclusion qualifies the entire returned battlefield population. */
/* @sem Operation::Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, $except_plural_filter])}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_population_with_exception ::= "return" "all" filter_plural "to" "their" "owners'" "hands" except_plural_filter

protection_grant_choice ::= protection_color_choice | protection_colorless_or_color_choice

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:ColorOrColorless, terms:_{count:Exactly(Constant(1)), options:[Term{family:ChoosableColor, form:AnyColor}]}} */
protection_colorless_or_color_choice ::= "colorless" "or" "from" "the" "color" "of" "your" "choice"

/* The two implied options each announce their own target and grant the same
   quoted ability to the selected holder. */
/* @sem Ability::@holder(Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$granted_controlled_greater_stat_death, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$delayed_graveyard_self_move}]}})}) */
graveyard_greater_death_return_quote ::= '"' granted_controlled_greater_stat_death "," delayed_graveyard_self_move "." '"'

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ControlledBy(One(AbilityController))])}), index:0}), changes:[GrantAbility($graveyard_greater_death_return_quote)]}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$noun_2, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}), changes:[GrantAbility($graveyard_greater_death_return_quote)]}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied} */
perpetual_controlled_or_graveyard_grant_modes ::= "target" noun "you" "control" "or" noun "card" "in" "your" "graveyard" "perpetually" "gains" graveyard_greater_death_return_quote

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:Announcement{modes:$perpetual_controlled_or_graveyard_grant_modes}, body:Program{}} */
triggered_perpetual_controlled_or_graveyard_grant ::= event_clause "," perpetual_controlled_or_graveyard_grant_modes

/* @prefer always */
/* @sem ConjuredCard::Spellbook{book:Planets, pick:Choice} */
conjured_planets_book ::= "of" "your" "choice" "from" "the" "Planets" "Spellbook"

/* @sem ConjuredCard::Spellbook{book:'Three Pigs', pick:Choice} */
conjured_three_pigs_book ::= "of" "your" "choice" "from" "the" "Three" "Pigs" "spellbook"

/* A characteristic of the creature in the enclosing creature-death event. */
/* @sem Expr::ObjectProperty{object:EventSubject, property:$death_creature_stat, information:CurrentOrLastKnown} */
death_creature_characteristic ::= "the" death_creature_stat "of" "the" "creature" "that" "died"

death_creature_stat ::= stat_power | stat_toughness

/* Used within the scoped creature-death trigger, so its subject is proved. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:$death_creature_characteristic}]} */
put_counters_death_characteristic ::= "put" "X" counter_kind "counters" "on" affected "," "where" "X" "is" death_creature_characteristic

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$put_counters_death_characteristic}]} */
death_characteristic_counter_program ::= put_counters_death_characteristic

/* The returned object is the subject of the enclosing trigger. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Move{selections:[_{objects:One(EventSubject)}], destination:OwnersHand(CardArrival{counters:[], states:[]})}]}, optional:false}}, If{condition:PaymentChosen(@marked), then:$program, otherwise:Program{}}]} */
program_return_him_owner_hand_if_you_do ::= "return" "him" "to" "his" "owner's" "hand" "." "if" "you" "do" "," program

/* Bind the stated mana value to the same permanent moved by this exile instruction. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_object), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:ObjectProperty{object:$target_object, property:ManaValue, information:CurrentOrLastKnown}}]}}] */
instructions_exile_target_mana_counters ::= "exile" target_object "." "put" "X" counter_kind "counters" "on" affected "," "where" "X" "is" "the" "mana" "value" "of" "the" "permanent" "exiled" "this" "way"

/* A singular returned object and its entry destination are composed separately. */
/* @sem Operation::Move{objects:One($object_ref), destination:$controlled_counter_entry, qualifiers:[]} */
return_singular_controlled_entry ::= "return" object_ref controlled_counter_entry

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[]}} */
controlled_counter_entry ::= "under" "your" "control" "with" "a" counter_kind "counter" "on" "it"

/* This pronoun is scoped to the controller of the event's dying object. */
/* @sem Ability::Triggered{event:$event_opponent_controlled_dies, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:ControllerOf(EventSubject), cost:$other_payment, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:$conjoined}, otherwise:Program{}}]}} */
triggered_opponent_death_declined_payment ::= event_opponent_controlled_dies "," "they" "may" other_payment "." "if" "they" "don't" "," conjoined "."

/* A one-time boon retains its own turn event, condition and program. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateBoon{actor:One(AbilityController), event:$turn_event, condition:$condition, times:Constant(1), body:Program($program)}}]} */
program_conditional_turn_boon ::= "you" "get" "a" "one-time" "boon" "with" '"' "at" turn_event "," "if" condition "," program "." '"'

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$program_conditional_turn_boon} */
triggered_conditional_turn_boon ::= event_clause "," program_conditional_turn_boon

/* @sem Operation::Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, $population_exception])}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_population_with_exceptions ::= "return" "all" filter_plural "to" "their" "owners'" "hands" population_exception

/* Keep the comparison scoped to the immediately preceding shared discard. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Draw{players:Union([One(AbilityController), One(DefendingPlayerOf(Source))]), amount:Constant(1)}}, Effect{result:@next, operation:Discard{players:Union([One(AbilityController), One(DefendingPlayerOf(Source))]), amount:Constant(1)}}, If{condition:HadExtreme{player:AbilityController, what:Discarded, highest:true}, then:Program{instructions:[Effect{result:@next, operation:$shared_extreme_counter_placement}]}, otherwise:Program{}}]} */
shared_defender_discard_extreme_program ::= "you" "and" "defending" "player" "each" "draw" "a" "card" "," "then" "discard" "a" "card" "." shared_extreme_counter_placement "if" "you" "discarded" "the" "card" "with" "the" "greatest" "mana" "value" "among" "those" "cards" "or" "tied" "for" "greatest"

/* @prefer always */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:$shared_extreme_plural_count}]} */
shared_extreme_counter_placement ::= "put" shared_extreme_plural_count counter_kind "counters" "on" affected

shared_extreme_plural_count ::= n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10 | n11 | n12 | n13 | n14 | n15 | n20 | n30 | number_hundred

/* A resolving card-type choice, shared by instructions that express the choice inline. */
/* @sem $unrestricted_card_type_choice */
card_type_of_your_choice ::= "the" unrestricted_card_type_choice "of" "your" "choice"

/* The choice and the protection grant retain independent result identities. */
/* @sem Instruction::[Effect{result:@next, operation:$card_type_of_your_choice}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[GrantKeyword(Protection(Objects(_{kind:Any, filter:Chosen(CardType)})))], duration:$duration, evaluation:Snapshot}}] */
protection_from_inline_card_type_choice ::= affected "gains" "protection" "from" card_type_of_your_choice duration

/* The destination is the owner's battlefield, not the ability controller's. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]} */
event_graveyard_return_owner_program ::= "return" "that" "card" "to" "the" "battlefield" "under" "its" "owner's" "control"

/* The payment choice is the receipt tested by the follow-up. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$cost_remove_event_mana_value_counters]}, optional:true}}, If{condition:PaymentChosen(@marked), then:$event_graveyard_return_owner_program, otherwise:Program{}}]} */
event_mana_value_counter_payment_return ::= "you" "may" cost_remove_event_mana_value_counters "." "if" "you" "do" "," event_graveyard_return_owner_program

/* A search episode followed by a joined instruction in a reflexive callback. */
/* @prefer always */
/* @sem Program::Program{instructions:@and_sequence($clause_search_general, $instructions)} */
callback_search_and_program ::= clause_search_general "and" instructions

/* Reusable bounded hand selection; its amount and filter are independently printable. */
/* @sem Count::UpTo($value) */
hand_entry_limit ::= "up" "to" value

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}), count:$hand_entry_limit}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$selected_onto_battlefield, qualifiers:[]}}] */
put_hand_selection_battlefield ::= "put" hand_entry_limit card_filter "cards" "from" "your" "hand" selected_onto_battlefield

/* A choice from a spelled-out card pool moves exactly that selection. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$chosen_entry_card_pool, count:$chosen_entry_count}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$chosen_entry_destination, qualifiers:[]}}] */
clause_choose_cards_to_battlefield ::= "put" chosen_entry_count chosen_entry_card_pool chosen_entry_destination

/* @sem Count::UpTo($value) */
chosen_entry_count ::= "up" "to" value

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$filter_phrase} */
chosen_entry_card_pool_all ::= filter_phrase "cards" "from" "graveyards"

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase} */
chosen_entry_card_pool_yours ::= filter_phrase "cards" "from" "your" "graveyard"

chosen_entry_card_pool ::= chosen_entry_card_pool_all | chosen_entry_card_pool_yours

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
chosen_entry_destination ::= "onto" "the" "battlefield" "under" "your" "control"

/* Each player chooses from their own hand and controls their arrivals. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Optional{decider:Bound(0), body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone(_{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:$card_kind_union}), count:AnyNumber}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}]}}] */
instructions_each_player_optional_hand_entry ::= players_singular "may" "put" "any" "number" "of" card_kind_union "cards" "from" "their" "hand" "onto" "the" "battlefield"

/* A bounded graveyard target composes with a face-up exile action. */
/* @sem ObjectSet::One($target_one_your_graveyard_mana_ceiling) */
exile_capped_your_graveyard_target ::= target_one_your_graveyard_mana_ceiling

/* The copy consumes the arrival from this singular target's exile. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_one_your_graveyard_mana_ceiling), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, ...$copy_random_exile_it] */
instructions_capped_graveyard_exile_copy ::= "exile" target_one_your_graveyard_mana_ceiling "." copy_random_exile_it

/* A filtered graveyard population and a shuffled face-down exile arrival compose independently. */
/* @sem ObjectSet::Zone(_{scope:Players{zone:Graveyard, players:One($player_possessive)}, kind:Card, filter:$card_filter}) */
shuffled_pile_graveyard_cards ::= "all" card_filter "cards" "from" player_possessive "graveyard"

/* @sem Operation::Move{objects:$shuffled_pile_graveyard_cards, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[ExilePile{shuffled:true}]}}, qualifiers:[]} */
exile_shuffled_graveyard_pile ::= "exile" shuffled_pile_graveyard_cards "in" "a" "face-down" "pile" "," "shuffle" "that" "pile"

/* The manifest consumes the immediately preceding shuffled exile arrival. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_shuffled_graveyard_pile}, Effect{result:@next, operation:@manifest_result(Operation::Manifest{actor:One(AbilityController), source:Cards(Transition{result:@prior, phase:After}), entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
instructions_shuffled_pile_manifest ::= exile_shuffled_graveyard_pile "," "then" "manifest" "those" "cards"

/* The copied stack ability is the subject of the enclosing trigger. */
/* @sem Instruction::[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventStackObject, times:Constant(1), targets:May}}] */
copy_event_ability_optional_targets ::= "copy" "that" "ability" "." "you" "may" "choose" "new" "targets" "for" "the" "copies"

/* Each target and damage amount is independently announced and retained. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamageParts{source:$damage_source_ref, parts:[_{recipients:Objects(One($target_object)), amount:$number}, _{recipients:Objects(One($target_opponent_choice_not_controlled)), amount:$number_2}], preventable:true}}] */
clause_damage_chosen_controlled_pair ::= damage_source_ref "deals" number "damage" "to" target_object "and" number "damage" "to" target_opponent_choice_not_controlled

/* Keep the exchange and its loss-based draw together: the receipt is from this exchange. */
/* @sem Instruction::[Effect{result:@next, operation:TowardPlayer{actor:One(AbilityController), action:ExchangeLife, player:$target_player_ref}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Performed(@prior)}}] */
instructions_exchange_life_loss_draw ::= "exchange" "life" "totals" "with" target_player_ref "." "if" "you" "lost" "life" "this" "way" "," "draw" "that" "many" "cards"

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:$instructions_exchange_life_loss_draw}}] */
instructions_may_exchange_life_loss_draw ::= "you" "may" instructions_exchange_life_loss_draw

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$instructions_may_exchange_life_loss_draw}} */
triggered_may_exchange_life_loss_draw ::= event_clause "," instructions_may_exchange_life_loss_draw "."

/* Both target domains retain independent scoped targets. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:DuplicateCounters{from:CounterSource::On(Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:Any}), index:0}))), to:Objects(One(Target{slot:0, index:0})), copies:OneOfEachKind}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:DuplicateCounters{from:CounterSource::On(Players(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0}))), to:Players(One(Target{slot:0, index:0})), copies:OneOfEachKind}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied} */
for_each_counter_kind_mixed_modes ::= "for" "each" "kind" "of" "counter" "on" "target" "permanent" "or" "player" "," "give" "that" "permanent" "or" "player" "another" "counter" "of" "that" "kind" "."

/* The affected object's controller chooses the color; both references share the same object. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(ControllerOf($object_ref)), kind:Color, terms:_{count:Exactly(Constant(1)), options:[Term{family:ChoosableColor, form:AnyColor}]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($object_ref)), changes:[GrantKeyword(Protection(Objects(_{kind:Any, filter:Chosen(Color)})))], duration:$duration, evaluation:Snapshot}}] */
controller_choice_protection ::= object_ref "gains" "protection" "from" "the" "color" "of" "its" "controller's" "choice" duration

/* This target and its damage amount are scoped by a per-player damage event. */
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:EventAmount}}, InZone(Players{zone:Graveyard, players:One(EventSubject)})])}), index:0}) */
damage_recipient_graveyard_target ::= "target" card_filter "card" "with" "mana" "value" "equal" "to" "the" "damage" "dealt" "from" "their" "graveyard"

/* @sem Operation::Move{objects:$damage_recipient_graveyard_target, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
damage_recipient_graveyard_exile ::= "exile" damage_recipient_graveyard_target

/* The per-recipient grouping supplies both the player and the damage amount. */
/* @sem Ability::Triggered{event:$event_group_combat_damage_to_player, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$damage_recipient_graveyard_exile}]}} */
damage_recipient_graveyard_exile_trigger ::= "whenever" event_group_combat_damage_to_player "," damage_recipient_graveyard_exile "."

/* @sem Ability::Triggered{event:$event_group_combat_damage_to_player, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$damage_recipient_graveyard_exile}, ...$instructions]}} */
damage_recipient_graveyard_exile_followup ::= "whenever" event_group_combat_damage_to_player "," damage_recipient_graveyard_exile "." instructions "."

/* The copy takes the preceding move's arrival; the choice gates its continuation. */
/* @sem Instruction::[Effect{result:@mark, operation:CopyCards{actor:One(AbilityController), objects:One(Result{result:@prior, phase:After, index:0}), times:Constant(1)}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Copies(@marked), count:Exactly(Constant(1)), cost:Free}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:$program, otherwise:Program{}}] */
copy_arrival_cast_free_followup ::= "copy" "it" "." "you" "may" "cast" "the" "copy" "without" "paying" "its" "mana" "cost" "." "if" "you" "do" "," program

/* @sem Ability::Triggered{event:$event_group_combat_damage_to_player, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$damage_recipient_graveyard_exile}, ...$copy_arrival_cast_free_followup]}} */
damage_recipient_graveyard_exile_copy_followup ::= "whenever" event_group_combat_damage_to_player "," damage_recipient_graveyard_exile "." copy_arrival_cast_free_followup "."

/* @prefer always */
/* The payer, decider and copying actor share the introduced creature's controller. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf(Target{slot:@last_slot, index:0}), cost:$other_payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Optional{decider:ControllerOf(Target{slot:@last_slot, index:0}), body:Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(ControllerOf(Target{slot:@last_slot, index:0})), object:ObjectRef::@self, times:Constant(1), targets:May}}]}}]}, otherwise:Program{}}] */
creature_paid_copy ::= "that" "creature's" "controller" "may" other_payment "." "if" "the" "player" "does" "," "they" "may" "copy" self_spell "and" "may" "choose" "a" "new" "target" "for" "that" "copy"

/* The controller pays the sacrifice of the announced object; its successful
   payment gates an independently composed continuation. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:ControllerOf($sacrificed_possessive_target), cost:Cost{parts:[Sacrifice{objects:One($sacrificed_possessive_target)}]}, optional:false}}, If{condition:PaymentChosen(@marked), then:$sacrifice_controller_followup, otherwise:Program{}}] */
instructions_controller_sacrifices_if ::= sacrificed_possessive_target "controller" "sacrifices" "it" "." "if" "the" "player" "does" "," sacrifice_controller_followup

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_controller_sacrifices_if}} */
spell_controller_sacrifices_if ::= instructions_controller_sacrifices_if "."

/* This continuation is used only under the preceding target sacrifice. */
sacrifice_controller_followup ::= program | sacrificed_target_reveal_program

/* The selected card filter composes with the preceding sacrificed target. */
/* @sem ObjectFilter::AllOf([$sacrifice_reveal_card_kind, Shares{property:CardTypes, with:Target{slot:0, index:0}}]) */
sacrificed_target_shared_type ::= "a" sacrifice_reveal_card_kind "card" "that" "shares" "a" "card" "type" "with" "the" "sacrificed" "permanent"

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:RevealUntil{library:ControllerOf(Target{slot:0, index:0}), filter:$sacrificed_target_shared_type, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$sacrificed_target_shared_type}, destination:Battlefield{controller:Player(ControllerOf(Target{slot:0, index:0})), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf(Target{slot:0, index:0}))}}]} */
sacrificed_target_reveal_program ::= "they" "reveal" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" sacrificed_target_shared_type "," "put" "that" "card" "onto" "the" "battlefield" "," "then" "shuffle"

/* Possessive forms are single lexical tokens and each announces the target. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:Any}), index:0} */
sacrificed_possessive_permanent ::= "target" "permanent's"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0} */
sacrificed_possessive_creature ::= "target" "creature's"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:Token}), index:0} */
sacrificed_possessive_token ::= "target" "token's"

sacrificed_possessive_target ::= sacrificed_possessive_permanent | sacrificed_possessive_creature | sacrificed_possessive_token

/* The target chooses a controlled permanent; the selection and their graveyard
   share a single exile instruction. */
exile_choice_player ::= target_opponent | target_player

/* @sem Vec<Instruction>::[Effect{result:@next, operation:ChooseObjects{player:$exile_choice_player, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(Target{slot:0, index:0})))}, count:AsManyAsCan($counter_a)}}, Effect{result:@next, operation:Move{objects:$selected_and_targeted_graveyard, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
exile_controlled_choice_and_graveyard ::= exile_choice_player "exiles" counter_a filter_phrase "they" "control" selected_and_targeted_graveyard

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$exile_controlled_choice_and_graveyard}} */
spell_exile_controlled_choice_and_graveyard ::= exile_controlled_choice_and_graveyard "."

optional_receipt_mill_amount ::= mill_cast_event_amount | mill_cast_fixed_amount

/* The chosen card is drawn from this optional mill payment's own performed receipt. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Mill{count:$optional_receipt_mill_amount}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, filter:$milled_return_filter}, count:Exactly(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]}, otherwise:Program{}}]} */
optional_mill_receipt_return_program ::= "you" "may" "mill" optional_receipt_mill_amount "." "if" "you" "do" "," "you" "may" "put" "a" milled_return_filter "card" "from" "among" "them" "into" "your" "hand" "."

/* The copy population is the receipt of this exact exile producer. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:$graveyard_typed_many, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:CopyEach{objects:Transition{result:@prior, phase:After}, exceptions:$copy_token_characteristics}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]} */
exile_graveyard_each_copy_program ::= "exile" graveyard_typed_many "." "for" "each" "card" "exiled" "this" "way" "," "create" token_copy_single "that" "card" "," "except" copy_token_characteristics

/* @sem Ability::Spell{announcement:@announcement, body:$exile_graveyard_each_copy_program} */
spell_exile_graveyard_each_copy ::= exile_graveyard_each_copy_program "."

/* The optional selection consumes this mill receipt, and the condition tests
   the arrival of that same selected card in its owner's hand. */
/* @sem Instruction::[Effect{result:@next, operation:Mill{players:One(AbilityController), amount:$card_count}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@prior, phase:After}, filter:$filter_phrase}, count:Exactly(Constant(1)), constraints:[]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$filter_phrase_2}, then:$program, otherwise:Program{}}] */
instructions_mill_choose_hand_if_type ::= "mill" card_count "." "you" "may" "put" "a" filter_phrase "card" "from" "among" "them" "into" "your" "hand" "." "if" "you" "put" "a" filter_phrase "card" "into" "your" "hand" "this" "way" "," program

/* A single reveal, its test and the exile consumers share the same receipt.
   The delayed return and permission both refer to that exile's arrival. */
/* @sem Operation::RevealFromHand{actor:One($target_opponent), cards:Any, count:Constant(1), at_random:true} */
reveal_opponent_random_single ::= target_opponent "reveals" "a" "card" "at" "random" "from" "their" "hand"

/* @sem Operation::RevealFromHand{actor:One($target_player), cards:Any, count:Constant(1), at_random:true} */
reveal_player_random_single ::= target_player "reveals" "a" "card" "at" "random" "from" "their" "hand"

revealed_target_single ::= reveal_opponent_random_single | reveal_player_random_single | revealed_single_producer

/* @sem Instruction::[Effect{result:@next, operation:$revealed_target_single}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@last_result), filter:$spell_instant_or_sorcery}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@mark, operation:Move{objects:One(Query{objects:Observed(@prior), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:$revealed_it_free_cast, filter:Any}, terms:_{cost:Free}})], duration:WhileExiled(Earlier{what:Exiled}), evaluation:LiveObjects}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, intervening_if:Compare{left:CountObjects(InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, body:Program{instructions:[Effect{result:@next, operation:Move{objects:@exile_followup(InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}}]}, otherwise:Program{}}] */
instructions_reveal_spell_exile_permission ::= revealed_target_single "." "if" "it's" "an" spell_instant_or_sorcery "card" "," "exile" "it" "." "you" "may" revealed_it_free_cast "for" "as" "long" "as" "it" "remains" "exiled" "." "at" "the" "beginning" "of" "the" "next" "end" "step" "," "if" "you" "haven't" "cast" "it" "," "return" "it" "to" "its" "owner's" "hand"

copy_linked_card_operand ::= copy_linked_card_action | copy_singular_linked_card_action

/* This singular linked card is anchored to the ability source. */
/* @sem Operation::CopyCards{actor:One(AbilityController), objects:One($linked_exiled_card), times:Constant(1)} */
copy_singular_linked_card_action ::= "copy" linked_exiled_card

/* The producer and both counts share one explicitly exiled result. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:$exile_counted_graveyard_targets, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($object_ref)), kind:$counter_kind, amount:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$noun})}]}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$adjective_nontype})}}] */
instructions_exile_filtered_counts ::= "exile" exile_counted_graveyard_targets "." "put" "a" counter_kind "counter" "on" object_ref "for" "each" noun "card" "exiled" "this" "way" "." "you" "gain" "1" "life" "for" "each" adjective_nontype "card" "exiled" "this" "way"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo($exile_count_limit), filter:InZone(Players{zone:Graveyard, players:One(EventSubject)})})) */
exile_counted_graveyard_targets ::= "up" "to" exile_count_limit "target" "cards" "from" "their" "graveyard"

exile_count_limit ::= exile_count_event_amount | number

/* @sem Expr::EventAmount */
exile_count_event_amount ::= "that" "many"

/* Keep the chosen card, its guess, and the conditional cast in one receipt scope. */
/* @sem Instruction::[...$clause_chosen_hand_card_guess, If{condition:$condition_the_player_guess_outcome, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Result{result:@marked, phase:After, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}]}, otherwise:Program{instructions:[]}}] */
clause_chosen_hand_guess_optional_cast ::= clause_chosen_hand_card_guess "." "if" condition_the_player_guess_outcome "," "you" "may" "cast" "the" "card" "without" "paying" "its" "mana" "cost"

controller_sacrifice_token_followup ::= controller_sacrifice_token_explicit | controller_sacrifice_token_implicit

/* @prefer always */
/* @sem TokenSpec::$token_groups */
controller_sacrifice_token_explicit ::= "that" "player" "creates" token_groups

/* @sem TokenSpec::[$target_creature_stat_token_group] */
controller_sacrifice_token_implicit ::= "creates" target_creature_stat_token_group

/* The target itself supplies the last-known property, even if sacrifice fails. */
/* @sem TokenSpec::TokenSpec{amount:ObjectProperty{object:Target{slot:0, index:0}, property:$creature_stat, information:CurrentOrLastKnown}, words:CreatingEffect, recipe:$token_recipe} */
target_creature_stat_token_group ::= "X" token_recipe "," "where" "X" "is" "that" "creature's" creature_stat

/* The destruction consumes the immediately preceding distinct-property choice. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($filter_plural, $filter_plural_2)}, count:AnyNumber, constraints:[$return_different_property]}}, Effect{result:@next, operation:Destroy{objects:Selected(@prior), regeneration:true}}] */
/* @prefer always */
instructions_choose_distinct_destroy ::= "choose" "any" "number" "of" filter_plural "with" "different" return_different_property "." "destroy" "those" filter_plural

/* The two phases share the exact selected-card discard receipt; each player
   draws only for their own discarded cards. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}, count:$each_discard_choice}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}]}}, ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(Bound(0)), amount:$hand_discard_draw_amount}}]}}] */
instructions_each_selected_discard_draw ::= players_singular "discards" each_discard_choice "," "then" "draws" hand_discard_draw_amount

/* @sem Count::AnyNumber */
each_discard_any ::= "any" "number" "of" "cards"

/* @sem Count::UpTo($card_count) */
each_discard_up_to ::= "up" "to" card_count

each_discard_choice ::= each_discard_any | each_discard_up_to

/* @sem Instruction::[...$instructions_each_selected_discard_draw, ...$instructions] */
instructions_each_selected_discard_draw_more ::= instructions_each_selected_discard_draw "." NEWLINE instructions

/* The delayed action retains the returned object, counter kind, and timing. */
/* @sem Operation::Move{objects:$return_own_card, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[]}}, qualifiers:[]} */
return_own_graveyard_with_counter ::= "return" return_own_card "from" "your" "graveyard" "to" "the" "battlefield" "with" "a" counter_kind "counter" "on" "it"

/* @sem Operation::CreateDelayedTrigger{event:$delayed_move_end_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:$return_own_graveyard_with_counter}]}} */
delayed_return_own_graveyard_counter ::= return_own_graveyard_with_counter "at" delayed_move_end_event

/* @sem ObjectSet::One(Source) */
return_own_card ::= "this" "card"

/* @sem Instruction::[Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@marked, phase:After, index:0}), changes:$duplicate_card_perpetual_changes}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@marked, phase:After, index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}]}, otherwise:Program{}}] */
/* @prefer always */
conjured_duplicate_singular_followup ::= "the" "duplicate" "perpetually" duplicate_card_perpetual_changes "if" "it" "has" "mana" "value" value "or" "less" "," "you" "may" "put" "it" "onto" "the" "battlefield"

/* Both consumers refer to the marked hand arrival of the conjure operation. */
/* @sem Instruction::[Effect{result:@next, operation:CreatePerpetualEffect{objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@marked, phase:After})}), changes:[GrantAbility(Casting(SpendAsThoughAnyType))]}}, If{condition:Compare{left:ObjectProperty{object:$object_ref, property:SpellX, information:CurrentOrLastKnown}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}, then:_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@marked, phase:After})}), count:AsManyAsCan($value_2)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}]}, otherwise:_{}}] */
conjured_duplicate_plural_followup ::= "those" "cards" "perpetually" "gain" '"' "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" object_ref "." '"' "if" "X" "is" value "or" "more" "," "you" "may" "put" value "of" "them" "from" "your" "hand" "onto" "the" "battlefield"

/* These singular changes compose independently of the source of the card. */
/* @sem Change::[Pump{power:$signed, toughness:$signed_2}, GrantKeyword($keyword_name), CreatureTypes{mode:Add, types:Listed([@subtype_name($creature_subtype)])}] */
perpetual_pump_keyword_add_creature_type_an ::= "gets" signed "/" signed "," "gains" keyword_name "," "and" "becomes" "an" creature_subtype "in" "addition" "to" "its" "other" "types"

/* Keep the choice, owner-hand move and the conditional on that move together. */
/* @sem Instruction::[...$return_chosen_to_owners_hand, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@last_result, phase:After}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:Transition{result:@prior, phase:After}, changes:$perpetual_pump_keyword_add_creature_type_an}}]}, otherwise:Program{}}] */
return_choice_conditional_perpetual ::= return_chosen_to_owners_hand "." "if" "it's" "a" filter_phrase "card" "," "it" "perpetually" perpetual_pump_keyword_add_creature_type_an

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$return_choice_conditional_perpetual}} */
triggered_return_choice_conditional_perpetual ::= event_clause "," return_choice_conditional_perpetual "."

/* The distributive spelling of a single counter on a group of targets. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($objects_targets_plain), kind:$counter_kind, amount:Constant(1)}]}}] */
counter_each_target_clause ::= "put" "a" counter_kind "counter" "on" "each" "of" objects_targets_plain

/* @sem Operation::Keyword{actor:@subject, action:KeywordAction::Skip{part:AllCombatPhasesNextTurn}} */
skip_all_combat_phases_third ::= "skips" "all" "combat" "phases" "of" "their" "next" "turn"

/* The singular return and its following sentence describe one arrival. */
/* @sem Operation::Move{objects:One($target_card_your_graveyard), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[Changes([CreatureTypes{mode:Add, types:Listed($becomes_type_one)}, RemoveAllAbilities])]}}, qualifiers:[]} */
return_graveyard_card_added_type_abilityless ::= "return" target_card_your_graveyard "to" "the" "battlefield" "." "it's" "a" becomes_type_one "in" "addition" "to" "its" "other" "types" "and" "has" "no" "abilities"

/* @prefer always */
/* @sem Operation::AddMana{players:One(ControllerOf(EventSubject)), mana:$event_controller_mana} */
add_event_controller_mana_additional ::= "its" "controller" "adds" "an" "additional" event_controller_mana

/* @prefer always */
/* @sem Operation::AddMana{players:One(ControllerOf(EventSubject)), mana:$mana_production} */
add_event_controller_mana_plain ::= "its" "controller" "adds" mana_production

/* A spelled plural counter placement and a later retained animation each
   retain their independent operands; the pronoun binds to the prior target. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:$count_plural}]} */
counter_placement_words ::= "put" count_plural counter_kind "counters" "on" affected

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$counter_placement_words}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($it_ordinary_pronoun)), changes:@retain_animation_types($animation_legendary_named), duration:Indefinite, evaluation:Snapshot}}] */
instructions_counter_retained_animation ::= counter_placement_words "." it_ordinary_pronoun "becomes" animation_legendary_named "." retention_singular

/* Move the currently targeted exiled card to its own owner’s zone. */
/* @sem Operation::Move{objects:$target_exiled_card_for_owner_zone, destination:$linked_pile_destination, qualifiers:[]} */
put_target_exiled_card_owner_zone ::= "put" target_exiled_card_for_owner_zone linked_pile_destination

/* The target exile payment and its copied payment receipt remain in one scope. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Move{selections:[_{objects:One($optional_owned_graveyard_copy_target)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:CopyCards{actor:One(AbilityController), objects:One(Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0}), times:Constant(1)}}, Optional{decider:AbilityController, body:$paid_copy_cast_body}]}, otherwise:Program{}}] */
paid_graveyard_target_copy ::= "exile" optional_owned_graveyard_copy_target "." "if" "you" "do" "," "copy" "it" "." "you" "may" paid_copy_cast_body

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Copies(@prior), count:Exactly(Constant(1)), cost:Normal}}]} */
paid_copy_cast_body ::= "cast" "the" "copy"

/* Return to the owner's hand preserves the destination independently of timing. */
/* @sem Operation::Move{objects:One(Source), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
delayed_graveyard_self_hand ::= "return" "this" "card" "from" "your" "graveyard" "to" "your" "hand"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:One(AbilityController)}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:$delayed_graveyard_self_move}]}}}]} */
delayed_graveyard_self_your_end_program ::= delayed_graveyard_self_move "at" "the" "beginning" "of" "your" "next" "end" "step" "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:UpkeepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:$delayed_graveyard_self_move}]}}}]} */
delayed_graveyard_self_next_upkeep_program ::= delayed_graveyard_self_move "at" "the" "beginning" "of" "the" "next" "upkeep" "."

/* The opposing fighter and the later death replacement share the second target.
   Keep the producer and anaphoric follow-up together so the inverse proves it. */
/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:$target_permanent, second:$fight_opposing_target}}}, Effect{result:@next, operation:$opposing_fighter_death_replacement}] */
instructions_fight_opponent_death_replacement ::= target_permanent "fights" fight_opposing_target "." opposing_fighter_death_replacement

/* @sem Operation::CreateReplacement{event:ZoneChange{objects:SameObject(Target{slot:1, index:0}), from:Battlefield, to:Graveyard}, limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}} */
opposing_fighter_death_replacement ::= "if" "the" "creature" "an" "opponent" "controls" "would" "die" this_duration "," "exile" "it" "instead"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_fight_opponent_death_replacement}} */
spell_fight_opponent_death_replacement ::= instructions_fight_opponent_death_replacement "."

/* A resolution exile payment and its immediate success branch share the receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$exile_optional_graveyard_payment]}, optional:false}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$exile_payment_duplicate_followup}, otherwise:Program{}}] */
instructions_exile_payment_followup ::= exile_optional_graveyard_payment "." "if" "you" "do" "," exile_payment_duplicate_followup

/* @sem CostPart::Move{selections:[_{objects:One($target_card_a_graveyard_up_to_one)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
exile_optional_graveyard_payment ::= "exile" target_card_a_graveyard_up_to_one

/* The duplicate uses the performed arrival of the enclosing payment; its own arrival receives the change. */
/* @sem Instruction::[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Duplicate(One(Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0})), count:Constant(1), owner:AbilityController, destination:Graveyard(CardArrival{counters:[], states:[]})}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$duplicate_color_type_stats}}] */
exile_payment_duplicate_followup ::= "conjure" "a" "duplicate" "of" "it" "into" "your" "graveyard" "." "the" "duplicate" "perpetually" duplicate_color_type_stats

/* @sem Change::[Colors{mode:Add, colors:[$mana_color_word]}, CreatureTypes{mode:Add, types:Listed($becomes_type_one)}, SetBasePowerToughness{power:$value, toughness:$value_2}] */
duplicate_color_type_stats ::= "becomes" "a" mana_color_word becomes_type_one "with" "base" "power" "and" "toughness" value "/" value "in" "addition" "to" "its" "other" "colors" "and" "types"

/* A shared perpetual change applies separately to both current populations. */
/* @sem Instruction::[Effect{result:@next, operation:CreatePerpetualEffect{objects:$paired_perpetual_battlefield, changes:$paired_perpetual_changes}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:$paired_perpetual_hand, changes:$paired_perpetual_changes}}] */
instructions_paired_perpetual_populations ::= paired_perpetual_battlefield "and" paired_perpetual_hand "perpetually" paired_perpetual_changes

/* @sem $grants */
paired_perpetual_changes ::= "gain" grants

/* The announced graveyard card is selected using the amount of this damage
   event and the damaged player's graveyard. The adjacent copy consumes this
   exact single-card exile arrival. */
/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:EventAmount}}, InZone(Players{zone:Graveyard, players:One(EventSubject)})])}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_damaged_player_card_at_event_amount ::= "exile" "target" card_filter "card" "with" "mana" "value" "equal" "to" "the" "damage" "dealt" "from" "their" "graveyard"

/* The optional cast is a payment because the following branch tests whether
   that cast was chosen. Its copy refers to the immediately preceding result. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_damaged_player_card_at_event_amount}, Effect{result:@mark, operation:CopyCards{actor:One(AbilityController), objects:One(Result{result:@prior, phase:After, index:0}), times:Constant(1)}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Copies(@marked), count:Exactly(Constant(1)), cost:Free}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:$program, otherwise:Program{}}] */
damage_event_exile_copy_cast_followup ::= exile_damaged_player_card_at_event_amount "." "copy" "it" "." "you" "may" "cast" "the" "copy" "without" "paying" "its" "mana" "cost" "." "if" "you" "do" "," program

/* @sem Ability::Triggered{event:EventSpec::Damage(_{source_kind:Permanent, sources:$combat_group_source, recipients:Players(All), kind:Combat, grouping:Recipient, subject:Source}), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$damage_event_exile_copy_cast_followup}} */
triggered_combat_player_exile_copy_cast ::= "whenever" combat_group_source "deal" "combat" "damage" "to" "a" "player" "," damage_event_exile_copy_cast_followup "."

/* A damage event supplies both quantities; the player's sacrifice is an optional payment. */
/* @sem Cost::Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:Exactly(EventAmount)}]} */
event_amount_sacrifice_choice_cost ::= "sacrifice" "that" "many" filter_plural "of" "their" "choice"

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:$player_ref, cost:$event_amount_sacrifice_choice_cost, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One($player_ref), amount:$damage_receipt_event_amount}}]}, otherwise:Program{}}] */
event_amount_life_unless_sacrifice ::= player_ref "loses" damage_receipt_event_amount "life" "unless" "they" event_amount_sacrifice_choice_cost

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$event_amount_life_unless_sacrifice}} */
trigger_event_amount_life_unless_sacrifice ::= event_clause "," event_amount_life_unless_sacrifice "."

/* The failure test is tied to the mandatory per-player discard receipt. */
/* @sem Instruction::[ForEachPlayer{players:$players_each, binding:0, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:Bound(0), cost:$third_discard_cost}}]}}, Effect{result:@next, operation:LoseLife{players:Intersection([$players_singular, Intersection([$players_each, Matching{binding:0, condition:Not(PlayerTook{player:Bound(0), result:@marked})}])]), amount:$value}}] */
instructions_discard_failure_loss ::= players_each third_discard_cost "." players_singular "who" "can't" "loses" value "life"

/* The permission refers to the immediately preceding exile arrival. */
/* @sem Instruction::[Effect{result:@next, operation:$timed_batch_exile_producer}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:CastSpell, filter:$cast_spells_filter}, terms:_{cost:Normal, spend_as:AnyType}})], duration:$duration, evaluation:LiveObjects}}] */
instructions_exile_batch_timed_cast ::= timed_batch_exile_producer "." duration "," "you" "may" "cast" cast_spells_filter "from" "among" "those" "cards" "," "and" "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "those" "spells"

timed_batch_exile_producer ::= exile_top_library_population | batch_cast_exile_producer

/* Bind the copied card to this singular random choice, including its population. */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:$exile_random_population, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]} */
choose_one_random_exile_card ::= "choose" "a" "card" "at" "random" exile_random_population

/* @sem Instruction::[Effect{result:@next, operation:$choose_one_random_exile_card}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@copy_subject(ObjectSet::$affected, ObjectRef::Result{result:@prior, phase:After, index:0})), changes:[CopyOf{object:Result{result:@prior, phase:After, index:0}, exceptions:$copy_exceptions_plain}], duration:Indefinite, evaluation:Snapshot}}] */
instructions_random_exile_card_copy ::= choose_one_random_exile_card "." affected "becomes" "a" "copy" "of" "that" "card" "," "except" copy_exceptions_plain

/* @sem ManaProduction::ColorsAmong{objects:$affected} */
mana_colors_among ::= "one" "mana" "of" "any" "color" "among" affected

/* @sem ObjectSet::Matching{objects:$linked_exile_cards, filter:$filter_phrase} */
linked_exile_filtered_spell ::= filter_phrase "spell" "from" "among" linked_exile_cards

/* A temporary permission retains the cast operation, its population and its
   independent per-turn limit. The effect is sourced by this ability's source. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(SpecialAction{body:Program{instructions:[Effect{result:@next, operation:$cast_free_exile_spell}]}, limit:EachTurn(1)})], duration:$duration, evaluation:LiveObjects} */
temporary_once_turn_cast ::= duration "," "you" "may" cast_free_exile_spell

/* A fixed-size ordered choice preserves each independently editable option. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:CardType, terms:_{options:[$ordered_card_type_plural, $ordered_card_type_plural_2, $ordered_card_type_plural_3], ordered:true, count:Exactly(Constant(3))}} */
choose_ordered_card_types_three ::= "choose" "an" "order" "for" ordered_card_type_plural "," ordered_card_type_plural "," "and" ordered_card_type_plural

ordered_card_type_plural ::= ordered_type_artifacts | ordered_type_creatures | ordered_type_enchantments | ordered_type_lands | ordered_type_planeswalkers | ordered_type_battles

/* @sem Operand::Vocabulary{family:CardType, form:Artifact} */
ordered_type_artifacts ::= "artifacts"

/* @sem Operand::Vocabulary{family:CardType, form:Creature} */
ordered_type_creatures ::= "creatures"

/* @sem Operand::Vocabulary{family:CardType, form:Enchantment} */
ordered_type_enchantments ::= "enchantments"

/* @sem Operand::Vocabulary{family:CardType, form:Land} */
ordered_type_lands ::= "lands"

/* @sem Operand::Vocabulary{family:CardType, form:Planeswalker} */
ordered_type_planeswalkers ::= "planeswalkers"

/* @sem Operand::Vocabulary{family:CardType, form:Battle} */
ordered_type_battles ::= "battles"

/* Each sacrifice uses its ordinal choice, independently of the preceding amounts. */
/* @sem Instruction::[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:All, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:NthChosen(0)}, choose:AsManyAsCan(Constant(1))})}, Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:All, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:NthChosen(1)}, choose:AsManyAsCan($number_words)})}, Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:All, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:NthChosen(2)}, choose:AsManyAsCan($number_words_2)})}] */
clause_sacrifice_ordered_types ::= "each" "player" "sacrifices" "one" "permanent" "of" "their" "choice" "of" "the" "first" "type" "," "sacrifices" number_words "of" "their" "choice" "of" "the" "second" "type" "," "then" "sacrifices" number_words "of" "their" "choice" "of" "the" "third" "type"

/* Keep the producer with its ordinal consumers: a seeded partial tail omits the first sacrifice. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_ordered_card_types_three}, ...$clause_sacrifice_ordered_types] */
instructions_ordered_choice_sacrifices ::= choose_ordered_card_types_three "." clause_sacrifice_ordered_types

hand_entry_card_filter ::= hand_entry_card_bounded | hand_entry_card_bare | hand_entry_card_relative | hand_entry_card_lesser_event_stat

/* @prefer always */
/* @sem $card_filter */
hand_entry_card_bare ::= card_filter "card"

/* @prefer always */
/* @sem ObjectFilter::@and($card_filter, $modifier_power_less_than_that) */
hand_entry_card_relative ::= card_filter "card" modifier_power_less_than_that

/* @sem ObjectFilter::@and($card_filter, ObjectFilter::Property{property:$receipt_stat, test:NumberTest::Compare{comparison:Less, value:Expr::ObjectProperty{object:EventSubject, property:$receipt_stat, information:CurrentOrLastKnown}}}) */
hand_entry_card_lesser_event_stat ::= card_filter "card" "with" "lesser" receipt_stat

/* The fallback move and optional alternative retain separate operands. */
/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
conditional_return_destination ::= "to" "its" "owner's" "hand"

/* @sem MovementDestination::OwnersGraveyard(CardArrival{counters:[], states:[]}) */
conditional_return_graveyard ::= "to" "its" "owner's" "graveyard"

conditional_return_zone ::= conditional_return_destination | conditional_return_graveyard

/* @sem Instruction::[If{condition:ObjectMatches{object:$object_ref, filter:$conditional_combat_state}, then:Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:$program}]}, optional:true}}, If{condition:Not(PaymentChosen(@prior)), then:Program{instructions:[Effect{result:@next, operation:Move{objects:$conditional_referred_object, destination:$conditional_return_zone, qualifiers:[]}}]}, otherwise:Program{}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Move{objects:$conditional_referred_object, destination:$conditional_return_zone, qualifiers:[]}}]}}] */
conditional_optional_replacement ::= "return" object_ref conditional_return_zone "." "if" conditional_referred_object "is" conditional_combat_state "," "you" "may" program "instead"

/* Each unit independently chooses one of the listed mana types. */
/* @sem ManaProduction::Repeat{amount:$value, production:ChooseOne([$mana_unit, ...$mana_combination_tail]), choice:EachUnit} */
mana_combination_list ::= value "mana" "in" "any" "combination" "of" mana_unit "," mana_combination_tail

mana_combination_tail ::= mana_combination_last | mana_combination_more

/* @sem ManaProduction::[$mana_unit, $mana_unit_2] */
mana_combination_last ::= mana_unit "," "and" "/" "or" mana_unit

/* @sem ManaProduction::[$mana_unit, ...$mana_combination_tail] */
mana_combination_more ::= mana_unit "," mana_combination_tail

/* The triggering subject remains both source and measured object. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:EventSubject, recipients:$recipients, amount:ObjectProperty{object:EventSubject, property:$creature_stat, information:CurrentOrLastKnown}, preventable:true}}]}}]} */
optional_event_stat_damage ::= "you" "may" "have" "it" "deal" "damage" "equal" "to" "its" creature_stat "to" recipients

/* @prefer always */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(OthersThan(AbilityController))])}), index:0} */
chosen_other_fighter_uncontrolled ::= "target" "creature" "you" "don't" "control"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(OpponentsOf(AbilityController))])}), index:0} */
chosen_other_fighter_opponent ::= "target" "creature" "an" "opponent" "controls"

/* The condition and placement refer to the first announced creature. */
/* @sem Instruction::[If{condition:ObjectMatches{object:Target{slot:0, index:0}, filter:Property{property:Power, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}}, then:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:0, index:0})), kind:$counter_kind, amount:Constant(1)}]}}]}, otherwise:Program{}}] */
chosen_fighter_counter_power ::= "put" "a" counter_kind "counter" "on" "the" "creature" "you" "control" "if" "it" "has" "power" number "or" "greater"

/* The selected singleton stays in exile until this owner-directed move. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_linked_single_random}, Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@prior, phase:After, index:0}), zone:Exile}, destination:$put_exiled_singular_destination, qualifiers:[]}}] */
instructions_choose_linked_random_owner_put ::= choose_linked_single_random "and" "put" "that" "card" "into" put_exiled_singular_destination

/* Each player selects a controlled creature for a counter; the rest are
   sacrificed after all selections. The placement receipt identifies survivors. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(Bound(0)))])}), kind:$counter_kind, amount:Constant(1), selection:_{player:Bound(0), count:AsManyAsCan(Constant(1))}}]}}]}}, Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:$players_singular, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), Not(InSet(Affected(@prior)))])}})}] */
counter_one_creature_sacrifice_rest ::= players_singular "puts" "a" counter_kind "counter" "on" "a" "creature" "they" "control" "and" "sacrifices" "the" "rest"

/* This continuation refers to the placement receipt, not the sacrifice result. */
/* @sem Instruction::Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Affected(0)), changes:$static_changes, duration:WhileMatches{object:Affected, filter:Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})}, evaluation:LiveObjects}} */
placed_creatures_counter_duration ::= "each" "of" "those" "creatures" static_changes "for" "as" "long" "as" "it" "has" "a" counter_kind "counter" "on" "it"

/* @sem Instruction::[...$counter_one_creature_sacrifice_rest, $placed_creatures_counter_duration] */
counter_survivors_lasting_change ::= counter_one_creature_sacrifice_rest "." placed_creatures_counter_duration

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$counter_survivors_lasting_change}} */
spell_counter_survivors_lasting_change ::= counter_survivors_lasting_change "."

/* The payment result governs the following independently composed operation. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:EventSubject, cost:$event_player_mana_or_life_payment, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:$event_player_paid_operation}]}, otherwise:Program{}}]} */
event_player_paid_program ::= "that" "player" "may" event_player_mana_or_life_payment "." "if" "the" "player" "does" "," event_player_paid_operation

event_player_paid_operation ::= event_player_gains_control | operation

/* A player's observed top card is tested before that player moves it; the
   following operation remains inside the same conditional branch. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:OwnersGraveyard(CardArrival{}), qualifiers:[]}}, Effect{result:@next, operation:$revealed_card_followup}]}, otherwise:Program{}}] */
instructions_player_reveal_graveyard_followup ::= player_ref "reveals" "the" "top" "card" "of" "their" "library" "." "if" "it's" top_reveal_quality "," "the" "player" "puts" "the" "card" "into" "their" "graveyard" "and" revealed_card_followup

revealed_card_followup ::= revealed_card_copy_effect | operation

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$revealed_card_copy_change, duration:Indefinite, evaluation:Snapshot} */
revealed_card_copy_effect ::= affected revealed_card_copy_change

/* @sem Change::[CopyOf{object:Earlier{what:Revealed}, exceptions:[]}] */
revealed_card_copy_change ::= "becomes" "a" "copy" "of" "that" "card"

/* The named target is chosen before either instruction; its controller remains
   the controller of the affected object when the restriction applies. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::CardType(Creature), $modifier)}), index:0} */
chosen_tap_creature_target ::= "target" "creature" modifier

/* @sem Program::Program{instructions:[Effect{result:@next, operation:SetTapped{objects:One($chosen_tap_creature_target), tapped:true}}, If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($chosen_tap_creature_target)), changes:$chosen_creature_skip_next_untap, duration:DuringControllersNextUntapStep, evaluation:LiveObjects}}]}, otherwise:Program{}}]} */
program_chosen_creature_tap_conditional_skip ::= "choose" chosen_tap_creature_target "and" "tap" "it" "." "if" condition "," chosen_creature_skip_next_untap

exile_population_return_time ::= exile_population_return_existing | exile_population_return_exiled

/* @prefer always */
/* @sem EventSpec::$delayed_move_end_event */
exile_population_return_existing ::= "at" delayed_move_end_event "," "return" "those" "cards" "to" "the" "battlefield" "under" "their" "owners'" "control"

/* @sem EventSpec::$delayed_move_end_event */
exile_population_return_exiled ::= "return" "the" "exiled" "cards" "to" "the" "battlefield" "under" "their" "owner's" "control" "at" delayed_move_end_event

/* A chosen player and the implicit selected spell share one cast-history filter. */
/* @sem ObjectFilter::$spell_adjective */
chosen_caster_history_filter ::= "choose" "a" "player" "who" "cast" "one" "or" "more" spell_adjective "spells" "this" "turn"

/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Player, terms:_{count:Exactly(Constant(1)), options:[Players(Matching{binding:0, condition:Compare{left:EventHistory{event:Spell{event:Cast, players:One(Bound(0)), spells:@agree($chosen_caster_history_filter, $spell_adjective)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}})]}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:FromHistory{event:Spell{event:Cast, players:One(Chosen), spells:@agree($chosen_caster_history_filter, $spell_adjective)}, window:ThisTurn}, count:Exactly(Constant(1))}}, Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Players(One(Chosen)), amount:Divide{numerator:DamageBy(Result{result:@prior, phase:After, index:0}), denominator:$history_damage_fraction, rounding:Down}, preventable:true}}] */
clause_chosen_caster_spell_damage ::= chosen_caster_history_filter "." self_explicit_ref "deals" "damage" "to" "that" "player" "equal" "to" history_damage_fraction "the" "damage" "dealt" "by" "one" "of" "those" spell_adjective "spells" "this" "turn" "," "rounded" "down"

history_damage_fraction ::= history_damage_half | history_damage_third

/* @sem Expr::Constant(2) */
history_damage_half ::= "half"

/* @sem Expr::Constant(3) */
history_damage_third ::= "a" "third"

/* The remainder excludes the prior choice; the enclosing phrase supplies its population. */
/* @sem ObjectFilter::Not(InSet(Selected(@prior))) */
choice_destroy_remainder ::= "destroy" "the" "rest"

/* The choice and remainder share the same battlefield population. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))])}, count:AsManyAsCan($counter_amount)}}]}}, Effect{result:@next, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, $choice_destroy_remainder])}, regeneration:true}}] */
instructions_each_choice_destroy_remainder ::= players_singular "chooses" counter_amount filter_phrase "they" "control" "." choice_destroy_remainder

/* Each iteration retains the payer, payment receipt and bound player. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:Bound(0), cost:$cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(Bound(0)), amount:$value}}]}, otherwise:Program{}}]}}] */
player_optional_cost_or_lose_life ::= players_singular "may" cost "." "if" "they" "don't" "," "they" "lose" value "life"

/* The stated count is additional iterations of the complete body. */
/* @sem Program::Program{instructions:[RepeatableWithLimit{amount:@plus_one($number_words), body:Program{instructions:[...$repeat_player_payment_body, Effect{result:@next, operation:RepeatProcess}]}}]} */
program_repeat_player_payment ::= repeat_player_payment_body "." "repeat" "this" "process" number_words "more" "times" "."

repeat_player_payment_body ::= player_optional_cost_or_lose_life

/* The controller may copy the event spell, with the stated retarget choice. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:$event_spell_followup}]} */
optional_event_spell_copy_sentence ::= "you" "may" event_spell_followup

/* A non-targeted recipient choice is made by the ability controller. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Recipient, terms:_{count:Exactly(Constant(1)), options:[Recipients($damage_recipient_choice)]}}}, Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Chosen, amount:$value, preventable:true}}] */
instructions_chosen_recipient_damage ::= object_ref "deals" value "damage" "to" damage_recipient_choice

/* A hand spell and its mana-value bound remain separate operands of the cast. */
/* @sem ObjectSet::Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$cast_bound_value}}])} */
cast_hand_bounded_spell ::= filter_phrase "spell" "from" "your" "hand" "with" "mana" "value" "less" "than" "or" "equal" "to" cast_bound_value

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:$cast_hand_bounded_spell, count:Exactly($counter_a), cost:Free} */
cast_free_hand_bounded_spell ::= "cast" counter_a cast_hand_bounded_spell "without" "paying" "its" "mana" "cost"

/* Choice words are ordinary values, independent of the later consequences. */
/* @sem String::'Fame' */
choice_word_fame ::= "fame"

/* @sem String::'Fortune' */
choice_word_fortune ::= "fortune"

/* A choice outcome selects one permanent controlled by each matching player.
   The affected receipt is shared by both subsequent effects. */
/* @sem Instruction::[Effect{result:@mark, operation:$chosen_word_control}, Effect{result:@next, operation:SetTapped{objects:Affected(@marked)}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Affected(@marked)), changes:$static_changes, duration:$duration, evaluation:Snapshot}}] */
chosen_word_control_untap ::= chosen_word_control "." "untap" "those" "creatures" "and" "they" static_changes duration

/* @sem Operation::EachPlayer{players:Matching{binding:0, condition:VotedFor{player:Bound(0), option:Word($choice_word)}}, action:WithSelections{steps:[_{binding:@selection_id(0), objects:Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$noun_creature}, filter:ControlledBy(One(Acting))}, chooser:Players(One(AbilityController)), count:Exactly(Constant(1))}], action:GiveControl{players:One(AbilityController), objects:Prepared(@selection_id(0)), until:EndOfTurn}}} */
chosen_word_control ::= "for" "each" "player" "who" "chose" choice_word "," "gain" "control" "of" "a" noun_creature "that" "player" "controls" "until" "end" "of" "turn"

/* The count applies independently to the draw and the named-token creation. */
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountPlayers(Matching{binding:0, condition:VotedFor{player:Bound(0), option:Word($choice_word)}})}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:CountPlayers(Matching{binding:0, condition:VotedFor{player:Bound(0), option:Word($choice_word)}}), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
chosen_word_draw_named_token ::= "for" "each" "player" "who" "chose" choice_word "," "you" "draw" "a" "card" "and" "create" "a" token_named_recipe "token"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$clause_each_chooses_words, ...$chosen_word_control_untap, ...$chosen_word_draw_named_token]}} */
spell_choice_control_and_reward ::= clause_each_chooses_words "." chosen_word_control_untap "." chosen_word_draw_named_token "."

/* The card name is an operand of the draft note, independent of the holder. */
/* @sem ManaProduction::DraftNotedColor(_{kind:Color, player:AbilityController, card:$referenced_card_name}) */
mana_drafted_color ::= "one" "mana" "of" "any" "color" "chosen" "as" "you" "drafted" "cards" "named" referenced_card_name

/* The dependent count is tied to this sacrifice and its named population. */
/* @sem Instruction::[Effect{result:@mark, operation:Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($sacrifice_receipt_plural, $sacrifice_receipt_singular)}, choose:AsManyAsCan($sacrifice_receipt_count)}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountObjects(Transition{result:@marked, phase:Before})}}] */
sacrifice_counted_receipt_draw ::= "sacrifice" sacrifice_receipt_count sacrifice_receipt_plural "." "for" "each" sacrifice_receipt_singular "sacrificed" "this" "way" "," "draw" "a" "card"

sacrifice_receipt_count ::= number_x | count_plural

sacrifice_receipt_plural ::= plural_land | plural_creature | plural_artifact | plural_enchantment

sacrifice_receipt_singular ::= noun_land | noun_creature | noun_artifact | noun_enchantment

/* An immediately exiled single target supplies the property of the created tokens. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($card_filter, ObjectFilter::InZone(Players{zone:Graveyard, players:OpponentsOf(AbilityController)}), ObjectFilter::ArrivedThisTurn{from:Battlefield})}), index:0} */
opponent_arrival_card_target ::= "target" card_filter "card" "from" "an" "opponent's" "graveyard" "that" "was" "put" "there" "from" "the" "battlefield" "this" "turn"

exile_property_card_target ::= opponent_arrival_card_target | target_card

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Move{objects:One($exile_property_card_target), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:$receipt_stat, information:CurrentOrLastKnown}, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
exile_card_property_tokens ::= "exile" exile_property_card_target "," "then" "create" "X" token_named_recipe "tokens" "," "where" "X" "is" "the" "exiled" "card's" receipt_stat

/* @sem Ability::Triggered{event:$event_self_enters, limits:_{}, announcement:@announcement, body:$exile_card_property_tokens} */
triggered_entry_exile_card_property_tokens ::= "when" event_self_enters "," exile_card_property_tokens "."

/* The referenced source belongs to the countered ability; the two type
   phrases must agree for recognition and inverse printing. */
/* @sem Instruction::[Effect{result:@next, operation:Counter{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Ability, zones:[Stack]}), count:Exactly(Constant(1)), filter:AllOf([$counter_ability_kind, AbilityOf(@agree($counter_source_filter, $noun))])}), index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}, Effect{result:@next, operation:Destroy{objects:One(SourceOf(Target{slot:@last_slot, index:0})), regeneration:true}}] */
counter_sourced_ability_destroy_source ::= "counter" "target" counter_ability_kind "ability" "from" counter_source_filter "source" "and" "destroy" "that" noun "if" "it's" "on" "the" "battlefield"

/* The controller may authorize the following action as one optional program. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:$clause_have_deal}}]} */
optional_have_program ::= "you" "may" clause_have_deal

/* The singular conjured battlefield arrival receives both grants. The quoted
   trigger is scoped to that arrival, not to the conjuring ability's holder. */
/* @sem Instruction::[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Named($referenced_card_name), count:$card_count_one, destination:Battlefield(BattlefieldArrival{tapped:false, counters:[], states:[]})}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[GrantKeyword($keyword_value), GrantAbility(@scope(Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$program}))], duration:Indefinite, evaluation:Snapshot}}] */
instructions_conjure_named_granted_trigger ::= "conjure" card_count_one "named" referenced_card_name "onto" "the" "battlefield" "," "and" "it" "gains" keyword_value "and" '"' "at" turn_event "," program "." '"'

/* The anaphoric removal takes the same object and kind as the threshold. */
/* @sem Instruction::[If{condition:ObjectMatches{object:$object_ref, filter:Counters{kind:$counter_kind, comparison:GreaterOrEqual, value:$value}}, then:Program{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($object_ref)), kind:$counter_kind, amount:All}]}}, ...$instructions_conjure_named_granted_trigger]}, otherwise:Program{}}] */
clause_threshold_remove_then_conjure ::= "if" object_ref "has" value "or" "more" counter_kind "counters" "on" "it" "," "remove" "them" "," instructions_conjure_named_granted_trigger

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$operation}, ...$clause_threshold_remove_then_conjure]} */
program_operation_then_threshold ::= operation "." "then" clause_threshold_remove_then_conjure

/* The named target controls the affected population and owns the turn window. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One($next_turn_target_player)), changes:[PlayerRule(MustAttack{attackers:$noun, defenders:Any})], duration:DuringNextTurn($next_turn_target_player), evaluation:LiveObjects} */
next_turn_target_player_must_attack ::= "during" next_turn_target_player "next" "turn" "," "each" noun "that" "player" "controls" "attacks" "if" "able"

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0} */
next_turn_target_player ::= "target" "player's"

/* A returned object's entry carries both its counters and its new creature types. */
/* @sem Operation::Move{objects:$affected, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, $counter_amount]], states:[Changes($returned_set_types)]}}, qualifiers:[]} */
return_owner_counters_set_types ::= "return" affected "to" "the" "battlefield" "under" "its" "owner's" "control" "with" counter_amount counter_kind "counters" "on" "it" "." returned_set_types

/* @sem Change::[CreatureTypes{mode:Set, types:Listed($becomes_types)}] */
returned_set_types ::= "it's" "a" becomes_types

/* Keep the roll and the count of its results in one producer-consumer scope. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RollDie{sides:6, times:$controlled_population_definition}} */
roll_six_dice_controlled_population ::= "roll" "X" "six-sided" "dice" "," "where" "X" "is" controlled_population_definition

dice_parity_named_roll ::= roll_six_sided_dice | roll_six_dice_controlled_population

/* @sem Instruction::[Effect{result:@next, operation:$dice_parity_named_roll}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$dice_parity_count, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}})}] */
clause_roll_parity_tapped_named ::= dice_parity_named_roll "." "create" "a" "tapped" token_named_recipe "token" "for" "each" dice_parity_count

/* A single discard supplies both the tested arrival and the card whose
   pre-discard characteristic is measured. Keep the producer in this scope. */
/* @prefer always */
/* @sem Instruction::[...$single_discard_damage_producer, $discard_matching_card_damage] */
instructions_discard_matching_card_damage ::= single_discard_damage_producer "." discard_matching_card_damage

single_discard_damage_producer ::= single_discard_damage_random | single_discard_damage_chosen

/* @sem Instruction::[Effect{result:@mark, operation:Discard{players:One(AbilityController), amount:Constant(1), random:true}}] */
single_discard_damage_random ::= "discard" "a" "card" "at" "random"

/* @sem Instruction::[Effect{result:@mark, operation:Discard{players:One(AbilityController), amount:Constant(1), random:false}}] */
single_discard_damage_chosen ::= "discard" "a" "card"

/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:$recipients, amount:ObjectProperty{object:Query{objects:Transition{result:@marked, phase:Before}, index:0}, property:$receipt_stat, information:CurrentOrLastKnown}, preventable:true}}]}, otherwise:Program{}} */
discard_matching_card_damage ::= "if" "you" "discard" ("a" | "an") filter_phrase "card" "this" "way" "," object_ref "deals" "damage" "equal" "to" "that" "card's" receipt_stat "to" recipients

/* The delayed exile consumes the actual arrival of this singular creature move. */
/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:$noun_creature}), index:0}), destination:$singular_arrival_control, qualifiers:[]} */
put_graveyard_creature_controlled ::= "put" "target" noun_creature "card" "from" "a" "graveyard" "onto" "the" "battlefield" singular_arrival_control

/* @sem Instruction::[Effect{result:@mark, operation:$put_graveyard_creature_controlled}, Effect{result:@next, operation:CreateDelayedTrigger{event:$event_clause_or_control_loss, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@marked, phase:After, index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}] */
instructions_graveyard_creature_delayed_exile ::= put_graveyard_creature_controlled "." event_clause_or_control_loss "," "exile" "that" "creature"

/* The Aura's controller performs both actions; the draw count is independent. */
/* @sem Instruction::[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(ControllerOf(Source)), objects:One(Source)})}, Effect{result:@next, operation:Draw{players:One(ControllerOf(Source)), amount:$count_plural}}] */
aura_controller_sacrifice_then_draw ::= "this" "Aura's" "controller" "sacrifices" "it" "," "then" "draws" count_plural "cards"

/* @sem Instruction::[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(ControllerOf(Source)), objects:One(Source)})}, Effect{result:@next, operation:Draw{players:One(ControllerOf(Source)), amount:Constant(1)}}] */
aura_controller_sacrifice_then_draw_one ::= "this" "Aura's" "controller" "sacrifices" "it" "," "then" "draws" "a" "card"

/* A duration-first effect grants a quoted mechanic to a population of cards. */
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase} */
your_graveyard_each_filtered_card ::= "each" filter_phrase "card" "in" "your" "graveyard"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($your_graveyard_each_filtered_card), changes:[GrantAbility($graveyard_granted_mechanic)], duration:$duration, evaluation:Snapshot} */
graveyard_population_temporary_mechanic ::= duration "," your_graveyard_each_filtered_card "gains" '"' graveyard_granted_mechanic '"'

graveyard_granted_mechanic ::= mechanic_escape_exile_others

/* Two announced players are distinct; the second target refers to the first. */
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0}), amount:$card_count}}, Effect{result:@next, operation:CreateTokens{players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OthersThan(Target{slot:0, index:0})}), index:0}), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$target_other_quoted_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
instructions_target_draw_other_token ::= "target" "player" "draws" card_count "." "another" "target" "player" "creates" "a" target_other_quoted_token_recipe

/* @sem TokenRecipe::@token_abilities($token_recipe_base, $target_other_quote_list) */
target_other_quoted_token_recipe ::= token_recipe_base "with" target_other_quote_list

/* @sem Ability::[$token_quoted] */
target_other_quote_list ::= token_quoted

/* A singular returned permanent is the antecedent of "it". */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One($target_permanent), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:Transition{result:@prior, phase:After}, changes:[GrantAbility($returned_cast_grant)]}}]} */
returned_target_cast_grant_it ::= "return" target_permanent "to" "its" "owner's" "hand" "." "it" "perpetually" "gains" returned_cast_grant

/* A bounded selection retains its total mana value constraint independently of its destination. */
/* @sem Operation::WithSelections{steps:[$total_mana_graveyard_selection], action:Move{objects:Prepared(@selection_id(0)), destination:$return_different_destination, qualifiers:[]}} */
return_total_graveyard_selection ::= "return" total_mana_graveyard_selection return_different_destination

total_mana_graveyard_selection ::= total_mana_graveyard_up_to | total_mana_graveyard_any_number

/* A bounded selection from an owned exile population goes to its owners' hands. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$owned_exile_selection_population, count:AsManyAsCan($card_count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
put_selected_owned_exile_into_hand ::= "put" card_count owned_exile_selection_population "into" "your" "hand"

/* The named opposing fighter is the same announced target in both instructions.
   Repeating its filter proves the descriptive reference on the inverse path. */
/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:AllOf([$noun_atomic, ControlledBy(One(AbilityController))])}), index:0}, second:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([@agree($noun_atomic_2, $noun_atomic_3), ControlledBy(OthersThan(AbilityController))])}), index:0}}}}, Effect{result:@next, operation:CreateReplacement{event:ZoneChange{objects:SameObject(Target{slot:1, index:0}), from:Battlefield, to:Graveyard}, limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}}}] */
fight_opponent_death_replacement ::= "up" "to" "one" "target" noun_atomic "you" "control" "fights" "target" noun_atomic "you" "don't" "control" "." "if" "the" noun_atomic "you" "don't" "control" "would" "die" this_duration "," "exile" "it" "instead"

/* Compose the milled-card target with the shared tapped or untapped battlefield destination. */
/* @prefer always */
/* @sem Operation::Move{objects:One($target_card_milled_this_turn), destination:$unspecialize_return_destination, qualifiers:[]} */
put_milled_target_on_battlefield ::= "put" target_card_milled_this_turn "onto" unspecialize_return_destination "under" "your" "control"

/* Keep the returned object's arrival available to the following face-up action. */
/* @sem Operation::Move{objects:$affected, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[FaceDown]}}, qualifiers:[]} */
return_face_down_to_owner ::= "return" affected "to" "the" "battlefield" "face" "down" "under" "its" "owner's" "control"

/* The condition gates both actions; the turn refers to the return's arrival. */
/* @sem Instruction::[@resolution(Instruction::If{condition:$condition_it_card, then:Program{instructions:[Effect{result:@next, operation:$return_face_down_to_owner}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::TurnFaceUp{object:Result{result:@prior, phase:After, index:0}}}}]}, otherwise:Program{}})] */
instructions_conditional_return_turn_up ::= return_face_down_to_owner "if" condition_it_card "," "then" "turn" "it" "face" "up"

/* @prefer always */
/* @sem ObjectSet::Zone(_{scope:Players{zone:Graveyard, players:One(@that_player)}, kind:Card, filter:$graveyard_cast_that_player_pair}) */
graveyard_cast_that_player ::= graveyard_cast_that_player_pair "spell" "from" "that" "player's" "graveyard" "without" "paying" "its" "mana" "cost" "." "if" "that" "spell" "would" "be" "put" "into" "a" "graveyard" "," "exile" "it" "instead"

graveyard_cast_that_player_pair ::= graveyard_cast_vowel_pair | graveyard_cast_consonant_pair

/* @prefer always */
/* @sem ObjectFilter::AnyOf([$graveyard_vowel_spell_kind, $graveyard_pair_spell_kind]) */
graveyard_cast_vowel_pair ::= graveyard_vowel_spell_kind "or" graveyard_pair_spell_kind

/* @prefer always */
/* @sem ObjectFilter::AnyOf([$graveyard_consonant_spell_kind, $graveyard_pair_spell_kind]) */
graveyard_cast_consonant_pair ::= graveyard_consonant_spell_kind "or" graveyard_pair_spell_kind

/* The return is scoped to the arrival of the explicit exile immediately before it. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One($target_object), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}}] */
instructions_exile_target_delayed_return_it ::= "exile" target_object "." "return" "it" "to" "the" "battlefield" "under" "its" "owner's" "control" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* The comparison uses the attempted target's current or last-known power. */
/* @sem Instruction::[If{condition:Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject($target_object)), $filter_phrase])}, filter:Property{property:Power, test:NumberTest::Compare{comparison:Greater, value:ObjectProperty{object:$target_object, property:Power, information:CurrentOrLastKnown}}}}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One($target_object), regeneration:true}}]}, otherwise:Program{}}] */
instructions_destroy_target_no_other_greater_power ::= "destroy" target_object "if" "no" "other" filter_phrase "has" "greater" "power"

/* The one-shot trigger changes the spell that caused it. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:$spell_filter}, duration:$this_duration, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:ChangeSpell{subject:One(EventSubject), changes:$spell_gains_mechanic}}]}, once:true}}] */
clause_next_cast_that_spell_change ::= "when" "you" "next" "cast" spell_filter this_duration "," "that" "spell" spell_gains_mechanic

/* A controller can spare the targeted permanent by having a named source
   deal damage to that same controller. Both references use the announced target. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf(Target{slot:@last_slot, index:0}), cost:$spared_controller_damage_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:$spared_action}]}, otherwise:Program{}}] */
clause_spared_unless_controller_damage ::= spared_action "unless" "its" "controller" spared_controller_damage_cost

/* @sem Cost::Cost{parts:[PlayerAction{player:ControllerOf(Target{slot:@last_slot, index:0}), body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Players(One(ControllerOf(Target{slot:@last_slot, index:0}))), amount:$number, preventable:true}}]}}]} */
spared_controller_damage_cost ::= "has" self_explicit_ref "deal" number "damage" "to" "them"

/* A target opponent receives the boon; its cast event and instruction stay inside it. */
/* @sem Instruction::[Effect{result:@next, operation:CreateBoon{actor:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0}), event:$boon_creature_cast, times:Constant(1), body:Program{instructions:[Effect{result:@next, operation:$boon_entry_tapped_stun}]}}}] */
clause_opponent_entry_boon ::= "target" "opponent" "gets" "a" "one-time" "boon" "with" '"' boon_creature_cast "," boon_entry_tapped_stun "." '"'

/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:CardType(Creature)} */
boon_creature_cast ::= "when" "you" "cast" "a" "creature" "spell"

/* @sem Operation::EffectOn{subject:Objects(One(EventSubject)), effects:[Term{family:SpellEffect, form:EntersTapped}, Term{family:SpellEffect, form:EntersWithACounter, operands:[Vocabulary{family:CounterType, form:StunCounter}]}]} */
boon_entry_tapped_stun ::= "that" "creature" "enters" "tapped" "and" "with" "a" "stun" "counter" "on" "it"

/* A quoted boon can conclude any preceding ordinary clause in a limited activation. */
/* @sem Program::Program{instructions:[...$clause, ...$clause_opponent_entry_boon]} */
program_followed_opponent_boon ::= clause "." clause_opponent_entry_boon

/* @prefer always */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:$limit_your_turn_once_ever, announcement:@announcement, body:$program_followed_opponent_boon} */
activated_followed_opponent_boon ::= cost ":" program_followed_opponent_boon limit_your_turn_once_ever "."

/* The transfer and callback preserve the player and object targets independently. */
/* @sem Operation::GiveControl{players:$players_singular, objects:$affected} */
have_player_gain_control ::= "have" players_singular "gain" "control" "of" affected

/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:WithReflexive{action:$have_player_gain_control, when:YouDo, body:Program($reflexive_callback_program)}}]}}] */
instructions_may_have_control_reflexive ::= "you" "may" have_player_gain_control "." "when" "you" "do" "," reflexive_callback_program

/* The token anaphor refers to the immediately preceding singular creation. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:$created_singular_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@prior)), kind:$counter_kind, amount:$count_owned_opponents_control}]}}]} */
/* @prefer always */
callback_created_token_count ::= "create" "a" created_singular_recipe "." "put" "a" counter_kind "counter" "on" "that" "token" "for" "each" count_owned_opponents_control

/* The next creature spell supplies the subject of its own entry change. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:CardType(Creature)}, duration:$this_duration, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:ChangeSpell{subject:One(EventSubject), changes:$spell_enters_extra_numbered_counters}}]}, once:true}}] */
clause_next_creature_entry_counters ::= "when" "you" "next" "cast" "a" "creature" "spell" this_duration "," "that" "creature" spell_enters_extra_numbered_counters

/* Keep the face-up exile producer adjacent to the return of its arrival. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One($target_permanent), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReturnAfter{objects:Transition{result:@prior, phase:After}, duration:WhileOnBattlefield($self_ref)}}]}}]} */
quoted_optional_exile_program ::= "you" "may" "exile" target_permanent "until" self_ref "leaves" "the" "battlefield"

/* The singular move produces the card used by the immediately following test. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card_your_graveyard), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@prior, phase:After, index:0}, filter:$past_object_quality}, then:$program, otherwise:Program{}}] */
instructions_returned_card_past_quality ::= "return" target_card_your_graveyard "to" "your" "hand" "." "if" "that" "card" "was" past_object_quality "," program

/* The chosen opponent's draw counts the receipt of this exact discard. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Player, terms:_{count:Exactly(Constant(1)), options:[Players(OpponentsOf(AbilityController))]}}}, Effect{result:@next, operation:ChooseObjects{player:Chosen, objects:Zone(_{scope:Players{zone:Hand, players:One(Chosen)}, kind:Card, filter:Any}), count:AnyNumber}}, Effect{result:@mark, operation:DiscardObjects{objects:Selected(@prior)}}, Effect{result:@next, operation:Draw{players:One(Chosen), amount:CountObjects(Transition{result:@marked, phase:Before})}}] */
opponent_discard_draw_receipt ::= "an" "opponent" "discards" "any" "number" "of" "cards" "," "then" "draws" "that" "many" "cards"

/* @sem Operation::Discard{players:One(AbilityController), amount:$card_count_many, random:true} */
discard_random_hand ::= "discard" card_count_many "at" "random"

/* The same permanent population determines each player's retained selection
   and the minimum across players; the remainder is sacrificed together. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$balance_permanent_population, ControlledBy(One(Bound(0)))])}, count:AsManyAsCan(AmongPlayers{players:All, number:Permanents($balance_permanent_population), aggregation:Minimum})}}]}}, Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:All, objects:Unselected(@prior)})}] */
clause_balance_permanents ::= "each" "player" "chooses" "a" "number" "of" balance_permanent_population "," "then" "sacrifices" "the" "rest"

balance_permanent_population ::= balance_lands | balance_creatures

/* @sem ObjectFilter::CardType(Land) */
balance_lands ::= "lands" "they" "control" "equal" "to" "the" "number" "of" "lands" "controlled" "by" "the" "player" "who" "controls" "the" "fewest"

/* @sem ObjectFilter::CardType(Creature) */
balance_creatures ::= "creatures" "they" "control" "equal" "to" "the" "number" "of" "creatures" "controlled" "by" "the" "player" "who" "controls" "the" "fewest"

/* This continuation repeats the least-player selection for hands and creatures,
   in that order, after the preceding permanent balancing instruction. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}, count:AsManyAsCan(AmongPlayers{players:All, number:CardsInHand, aggregation:Minimum})}}]}}, ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:DiscardObjects{objects:Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:InSet(Unselected(@prior))}}}]}}, ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(Bound(0)))])}, count:AsManyAsCan(AmongPlayers{players:All, number:Permanents(CardType(Creature)), aggregation:Minimum})}}]}}, Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:All, objects:Unselected(@prior)})}] */
balance_hands_creatures_followup ::= "players" "discard" "cards" "and" "sacrifice" "creatures" "the" "same" "way"

/* @sem Instruction::[...$clause_balance_permanents, ...$balance_hands_creatures_followup] */
instructions_balance_followup ::= clause_balance_permanents "." balance_hands_creatures_followup

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:_{instructions:$instructions_balance_followup}} */
activated_balance_followup ::= cost ":" instructions_balance_followup "."

/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:$clause_balance_permanents}} */
spell_balance_permanents ::= clause_balance_permanents "."

/* The replacement and spending clause describe the same cast permission. */
/* @sem PlayTerms::PlayTerms{cost:Normal, spend_as:AnyType, into_exile:true} */
cast_any_mana_exile_terms ::= "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "that" "spell" "." "if" "that" "spell" "would" "be" "put" "into" "a" "graveyard" "," "exile" "it" "instead"

/* @sem Operation::PlayWith{actor:One(AbilityController), action:CastSpell, cards:One($target_card), count:UpTo(Constant(1)), terms:$cast_any_mana_exile_terms} */
cast_target_any_mana_exile ::= "you" "may" "cast" target_card "," "and" cast_any_mana_exile_terms

/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:Sacrifice{players:One(AbilityController), objects:One(Source)}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$reflexive_callback_program})}] */
nth_source_reflexive_callback ::= "sacrifice" "it" "." "when" "you" "do" "," reflexive_callback_program

/* The exile producer and both consumers form one receipt-scoped phrase. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Sacrifice{objects:One(Source)}]}, optional:false}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:$exile_top_free_cast_remainder_hand}, otherwise:Program{}}] */
nth_source_paid_exile_callback ::= "sacrifice" "it" "." "if" "you" "do" "," exile_top_free_cast_remainder_hand

/* @sem Instruction::[Effect{result:@mark, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Transition{result:@marked, phase:After}, count:AnyNumber, cost:Free}}, Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
exile_top_free_cast_remainder_hand ::= exile_top_cards_of_your_library "." "you" "may" "cast" "any" "number" "of" "spells" "from" "among" "them" "without" "paying" "their" "mana" "costs" "." "put" "the" "rest" "into" "your" "hand"

/* A one-use cast boon contains its own event and draw instruction. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:$event_cast, duration:Indefinite, announcement:_{}, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$boon_draw_count}}]}, once:true}}] */
one_time_cast_draw_boon ::= "you" "get" "a" "one-time" "boon" "with" '"' "when" event_cast "," "draw" boon_draw_count "." '"'

boon_draw_count ::= card_count_one | card_count_many

/* A paragraph may end in a quoted one-use boon after an ordinary instruction. */
/* @prefer always */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$operation}, ...$one_time_cast_draw_boon]}} */
spell_operation_cast_draw_boon ::= operation "." NEWLINE one_time_cast_draw_boon

/* A hand selection and the ensuing arrival form one action, retaining its receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$milled_return_filter}, count:UpTo($count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
hand_entry_up_to ::= "put" "up" "to" count milled_return_filter "cards" "from" "your" "hand" "onto" "the" "battlefield"

/* The final selection is scoped to this serial form, not to arbitrary lists. */
/* @sem Instruction::[...$clause_you, ...$clause_imperative, ...$hand_entry_up_to] */
instructions_serial_hand_entry ::= clause_you "," clause_imperative "," "then" hand_entry_up_to

/* This effect is scoped to its trigger, avoiding a second interpretation of
   the same words in spell programs. The filter and both modifiers remain operands. */
/* @sem Operation::CreatePerpetualEffect{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), changes:[Pump{power:$signed, toughness:$signed_2}]} */
trigger_graveyard_perpetual_pump ::= filter_phrase "cards" "in" "your" "graveyard" "perpetually" "get" signed "/" signed

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$trigger_graveyard_perpetual_pump}]}} */
triggered_graveyard_perpetual_pump ::= event_clause "," trigger_graveyard_perpetual_pump "."

/* Each player selects one permanent they control. */
/* @sem Instruction::[ForEachPlayer{players:$choice_each_player, binding:0, body:_{instructions:[Effect{result:@next, operation:$bound_choose_controlled_one}]}}] */
clause_players_choose_controlled_one ::= choice_each_player bound_choose_controlled_one

choice_each_player ::= players_each | players_each_opponent | players_each_other | players_each_other_opponent

/* Return the population outside the immediately preceding selection. */
/* @sem Operation::Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$return_unselected_filter, Not(InSet(Selected(@prior)))])}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_unselected_population_owners_hand ::= "return" "all" return_unselected_filter "not" "chosen" "this" "way" "to" "their" "owners'" "hands"

return_unselected_filter ::= return_unselected_adjective_filter | filter_plural

/* @prefer always */
/* @sem $filter_plural_adjectives */
return_unselected_adjective_filter ::= filter_plural_adjectives

/* Keep the selection and return together when a later instruction follows. */
/* @prefer always */
/* @sem Instruction::[...$clause_players_choose_controlled_one, Effect{result:@next, operation:$return_unselected_population_owners_hand}, ...$clause_you] */
instructions_choice_return_then_you ::= clause_players_choose_controlled_one "." return_unselected_population_owners_hand "." "then" clause_you

/* The second sentence refers to the first announced target, not a fresh choice. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$target_signed_pump}, $target_type_keyword_branch]} */
program_target_change_type_followup ::= target_signed_pump "." target_type_keyword_branch

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($target_permanent)), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot} */
target_signed_pump ::= target_permanent "gets" signed "/" signed duration

/* @sem Instruction::If{condition:ObjectMatches{object:Target{slot:0, index:0}, filter:$filter_phrase}, then:Program{instructions:[Effect{result:@next, operation:$target_anaphoric_keyword_grant}]}, otherwise:Program{}} */
target_type_keyword_branch ::= "if" "it's" "a" filter_phrase "," target_anaphoric_keyword_grant

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:0, index:0})), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot} */
target_anaphoric_keyword_grant ::= "it" "gains" keyword_name duration

/* The count is over the controlled population named by the phrase. */
/* @sem Change::[EntersWithCounters(_{kind:$counter_kind, amount:CountObjects($entry_counter_population)})] */
spell_enters_additional_per_population ::= "enters" "with" "an" "additional" counter_kind "counter" "on" "it" "for" entry_counter_population

/* The condition describes the same card selected from the controller's hand. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$hand_entry_controller_choice}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[When{filter:$filter_phrase, entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}]}}, qualifiers:[]}}]}}] */
instructions_hand_conditional_attack_entry ::= "you" "may" "put" hand_entry_controller_choice "from" "your" "hand" "onto" "the" "battlefield" "." "if" "that" "card" "is" "an" filter_phrase "card" "," "it" "enters" "tapped" "and" "attacking"

/* The previously announced creature is the object whose controller is hit. */
/* @sem Operation::DealDamage{source:Source, recipients:Players(One(ControllerOf(Target{slot:@last_slot, index:0}))), amount:$number, preventable:true} */
named_also_damage_target_creature_controller ::= SELF_NAME "also" "deals" number "damage" "to" "that" "creature's" "controller"

/* @sem Instruction::If{condition:$condition_personal_graveyard_filtered_at_least, then:Program{instructions:[Effect{result:@next, operation:$named_also_damage_target_creature_controller}]}, otherwise:Program{}} */
conditional_graveyard_damage_creature_controller ::= "if" condition_personal_graveyard_filtered_at_least "," named_also_damage_target_creature_controller

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$named_source_damage_target_creature}, $conditional_graveyard_damage_creature_controller]}} */
spell_creature_damage_graveyard_conditional ::= named_source_damage_target_creature "." NEWLINE conditional_graveyard_damage_creature_controller "."

/* The choice and its shared draw retain the chosen player's identity. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_opponent}, Effect{result:@next, operation:Draw{players:Union([One(AbilityController), One(Chosen)]), amount:$card_count}}] */
chosen_opponent_shared_draw ::= choose_opponent "." "you" "and" "that" "player" "each" "draw" card_count

/* Both descriptions must name the same filtered population. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_opponent}, Effect{result:@next, operation:SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($adjective_nontype, $adjective_nontype_2), AnyOf([ControlledBy(One(AbilityController)), ControlledBy(One(Chosen))])])}}}] */
chosen_opponent_shared_untap ::= choose_opponent "." "untap" "all" adjective_nontype "permanents" "you" "control" "and" "all" adjective_nontype "permanents" "that" "player" "controls"

/* These phrases can stand alone or compose as consecutive instructions. */
/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:[...$chosen_opponent_shared_draw, ...$chosen_opponent_shared_untap]}} */
spell_chosen_shared_draw_untap ::= chosen_opponent_shared_draw "." NEWLINE chosen_opponent_shared_untap "."

/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:$chosen_opponent_shared_draw}} */
spell_chosen_shared_draw ::= chosen_opponent_shared_draw "."

/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:$chosen_opponent_shared_untap}} */
spell_chosen_shared_untap ::= chosen_opponent_shared_untap "."

/* Choose a battlefield population and return the exact exile arrival. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$affected, count:AnyNumber}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
exile_any_number_affected ::= "exile" "any" "number" "of" affected

/* @sem Instruction::[...$exile_any_number_affected, ...$return_exile_choice_until_leaves] */
clause_exile_any_affected_until ::= exile_any_number_affected return_exile_choice_until_leaves

/* The same named target's controller pays and chooses whether to copy. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf(Target{slot:@last_slot, index:0}), cost:$other_payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Optional{decider:ControllerOf(Target{slot:@last_slot, index:0}), body:Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(ControllerOf(Target{slot:@last_slot, index:0})), object:ObjectRef::@self, times:Constant(1), targets:May}}]}}]}, otherwise:Program{}}] */
permanent_paid_copy ::= "that" "permanent's" "controller" "may" other_payment "." "if" "the" "player" "does" "," "they" "may" "copy" self_spell "and" "may" "choose" "a" "new" "target" "for" "that" "copy"

/* A named exclusion qualifies the announced graveyard card independently of its type. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($card_filter, $modifier_not_named_self)}), index:0} */
named_exclusion_graveyard_card ::= "target" card_filter "card" modifier_not_named_self "from" "a" "graveyard"

/* @prefer always */
/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
named_exclusion_battlefield ::= "onto" "the" "battlefield" "under" "your" "control"

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}} */
named_exclusion_battlefield_tapped ::= "onto" "the" "battlefield" "tapped" "under" "your" "control"

named_exclusion_destination ::= named_exclusion_battlefield | named_exclusion_battlefield_tapped

/* @sem Operation::Move{objects:One($named_exclusion_graveyard_card), destination:$named_exclusion_destination, qualifiers:[]} */
put_named_exclusion_graveyard_card ::= "put" named_exclusion_graveyard_card named_exclusion_destination

/* The counter-qualified population is shared by the intervening condition and
   the random action; the anaphor cannot refer to a different population. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, filter:$present_named_counter}), test:$condition_at_least}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, $present_named_counter)}, chooser:Chance, count:AsManyAsCan($value)}], action:$random_selected_action}}]}} */
triggered_counter_population_random_action ::= "at" turn_event "," "if" condition_at_least filter_plural "have" "an" present_named_counter "on" "them" "," random_selected_action value "of" "those" "permanents" "at" "random" "."

/* @sem Instruction::[...$returned_type_cards_life, ...$instructions] */
returned_type_cards_life_more ::= returned_type_cards_life "." instructions

/* The three controlled names identify the same population attached to the created token. */
/* @sem Instruction::If{condition:AllOf([Controls{player:AbilityController, filter:AllOf([@agree($plural_head, $plural_head_2), Name($referenced_card_name)]), minimum:1}, Controls{player:AbilityController, filter:AllOf([@agree($plural_head, $plural_head_2), Name($referenced_card_name_2)]), minimum:1}, Controls{player:AbilityController, filter:AllOf([@agree($plural_head, $plural_head_2), Name($referenced_card_name_3)]), minimum:1}]), then:Program{instructions:[Effect{result:@mark, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$named_single_legendary_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}, Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Created(@marked), count:Exactly(Constant(1)), constraints:[]}], action:AttachEach{actor:One(AbilityController), attachments:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($plural_head, $plural_head_2), ControlledBy(One(AbilityController)), AnyOf([Name($referenced_card_name), Name($referenced_card_name_2), Name($referenced_card_name_3)])])}, hosts:Objects(Prepared(@selection_id(0))), each_host:false}}}]}, otherwise:Program{}} */
controlled_named_three_create_attach ::= "if" "you" "control" plural_head "named" referenced_card_name "," referenced_card_name "," "and" referenced_card_name "," "create" named_single_legendary_token "." "attach" "those" plural_head "to" "it"

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[$controlled_named_three_create_attach]}} */
activated_named_three_create_attach ::= cost ":" controlled_named_three_create_attach "."

/* A singular named token supplies the antecedent of a following attachment. */
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:$explicit_legendary_name, supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2]}} */
named_single_legendary_token ::= explicit_legendary_name "," "a" "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token"

/* The condition's three named populations and the repeated noun establish the
   exact attachments; the host is the immediately created singleton token. */
/* @sem Instruction::If{condition:AllOf([Controls{player:AbilityController, filter:AllOf([$named_attachment_noun, Name($referenced_card_name)]), minimum:1}, Controls{player:AbilityController, filter:AllOf([$named_attachment_noun, Name($referenced_card_name_2)]), minimum:1}, Controls{player:AbilityController, filter:AllOf([$named_attachment_noun, Name($referenced_card_name_3)]), minimum:1}]), then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$named_singleton_created_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), objects:Created(@prior), chooser:Players(One(AbilityController)), count:Exactly(Constant(1))}], action:AttachEach{actor:One(AbilityController), attachments:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($named_attachment_noun, $named_attachment_noun_2), ControlledBy(One(AbilityController)), AnyOf([Name($referenced_card_name), Name($referenced_card_name_2), Name($referenced_card_name_3)])])}, hosts:Objects(Prepared(@selection_id(0)))}}}]}, otherwise:Program{}} */
conditional_named_equipment_attach_created ::= "if" "you" "control" named_attachment_noun "named" referenced_card_name "," referenced_card_name "," "and" referenced_card_name "," "create" named_singleton_created_token "." "attach" "those" named_attachment_noun "to" "it"

/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:$explicit_legendary_name, supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2]}} */
named_singleton_created_token ::= explicit_legendary_name "," "a" "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token"

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[$conditional_named_equipment_attach_created]}} */
activated_conditional_named_attach ::= cost ":" conditional_named_equipment_attach_created "."

/* Mass-noun Equipment and ordinary plural populations retain their own filters. */
named_attachment_noun ::= st_equipment | filter_plural

/* A single random hand reveal and its measured card stay in the same sequence. */
/* @sem Instruction::[Effect{result:@next, operation:RevealFromHand{actor:One($target_player_ref), cards:Any, count:Constant(1), at_random:true}}, Effect{result:@next, operation:LoseLife{players:One($target_player_ref), amount:ObjectProperty{object:Query{objects:Observed(@prior), index:0}, property:$receipt_stat, information:CurrentOrLastKnown}}}] */
random_hand_reveal_property_loss ::= target_player_ref "reveals" "a" "card" "at" "random" "from" "their" "hand" "," "then" "loses" "life" "equal" "to" "that" "card's" receipt_stat

/* A conditional optional untap replaces the preceding action, including its fallback when the condition is false. */
/* @sem Program::Program{instructions:[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[ChangeTapState{selections:[_{objects:$affected}], symbol:true}]}, optional:true}}, If{condition:Not(PaymentChosen(@prior)), then:$program, otherwise:Program{}}]}, otherwise:$program}]} */
program_conditional_optional_untap_instead ::= program "." "if" condition "," "you" "may" "untap" affected "instead" "."

/* The payment determines which of two amounts the same source deals to the
   already announced damage recipient. Both amounts remain independent. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:PlayerOrControllerOf($recipients_any_target), cost:$cost, optional:true}}, @repeated_damage_actor(Instruction::If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref_named, recipients:Targets(@last_slot), amount:$number_2, preventable:true}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:Targets(@last_slot), amount:$number, preventable:true}}]}})] */
damage_recipient_payment_amounts ::= damage_source_ref "deals" number "damage" "to" recipients_any_target "unless" "that" "permanent's" "controller" "or" "that" "player" "pays" cost "." NEWLINE? "if" "they" "do" "," self_ref_named "deals" number "damage" "to" "the" "permanent" "or" "player"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$damage_recipient_payment_amounts}} */
spell_damage_recipient_payment_amounts ::= damage_recipient_payment_amounts "."

/* The second sentence refers to each chooser's own selection.  Both printed
   nouns describe the same selected population. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, starting_with:AbilityController, in_chosen_direction:true, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($filter_phrase, $filter_phrase_2), ControlledBy(One(InChosenDirection{from:Bound(0)}))])}, count:AsManyAsCan(Constant(1))}}]}}, ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(ChosenBy{result:@prior, chooser:Bound(0)})), changes:[SetController(Bound(0))], duration:Indefinite, evaluation:Snapshot}}]}}] */
ordered_neighbor_choice_control ::= "starting" "with" "you" "and" "proceeding" "in" "the" "chosen" "direction" "," "each" "player" "chooses" "a" filter_phrase "controlled" "by" "the" "next" "player" "in" "that" "direction" "." "each" "player" "gains" "control" "of" "the" filter_phrase "they" "chose"

/* The optional choice consumes the arrival receipt of this exact mill. */
/* @sem Vec<Instruction>::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$milled_card_description_union}, count:Exactly(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
mill_optional_return_union ::= "mill" card_count "." "you" "may" "put" milled_card_description_union "from" "among" "the" "cards" "milled" "this" "way" "into" "your" "hand"

/* @sem ObjectFilter::AnyOf([$filter_phrase, $filter_phrase_2]) */
milled_card_description_union ::= "an" filter_phrase "card" "or" filter_phrase "card"

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$mill_optional_return_union}} */
triggered_mill_optional_return_union ::= event_clause "," mill_optional_return_union "."

/* The action's object also supplies the antecedent of the subsequent grant. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$suspect_referenced_object}, Effect{result:@next, operation:$gain_this_ability_perpetually}]} */
program_suspect_then_perpetual_ability ::= suspect_referenced_object "." gain_this_ability_perpetually "."

/* Compose a damage event, its intervening condition and its resulting program. */
/* @sem Ability::Triggered{event:$event_clause, intervening_if:$condition_referenced_still_battlefield, limits:TriggerLimits{}, announcement:@announcement, body:$program_suspect_then_perpetual_ability} */
triggered_referenced_still_suspect_grant ::= event_clause "," "if" condition_referenced_still_battlefield "," program_suspect_then_perpetual_ability

/* The qualified recipient supplies the following pronoun. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Suspect, objects:$qualified_set} */
suspect_referenced_object ::= "suspect" qualified_set

/* The continuation is scoped to the host of this optional unattachment. */
/* @sem Instruction::[Effect{result:@mark, operation:$optional_unattach_from_controlled_creature}, If{condition:PaymentChosen(@marked), then:$unattached_host_tap_grant, otherwise:Program{}}] */
instructions_optional_unattach_host ::= optional_unattach_from_controlled_creature "." "if" "you" "do" "," unattached_host_tap_grant

/* @sem Operation::PayCost{player:AbilityController, cost:Cost{parts:[UnattachFrom{attachments:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$subtype}, hosts:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun_creature, ControlledBy(One(AbilityController))])}}]}, optional:true} */
optional_unattach_from_controlled_creature ::= "you" "may" "unattach" "an" subtype "from" "a" noun_creature "you" "control"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:SetTapped{objects:One(Earlier{what:Unattached}), tapped:true}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Earlier{what:Unattached})), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}]} */
unattached_host_tap_grant ::= "tap" "that" "creature" "and" "it" "gains" keyword_name duration

/* Target a card by its graveyard owner and its recorded arrival this turn. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$noun, InZone(Players{zone:Graveyard, players:OpponentsOf(AbilityController)}), ArrivedThisTurn{from:Battlefield}])}), index:0} */
opponent_graveyard_arrival_target ::= "target" noun "card" "from" "an" "opponent's" "graveyard" "that" "was" "put" "there" "from" "the" "battlefield" "this" "turn"

/* @sem ObjectSet::One($opponent_graveyard_arrival_target) */
opponent_graveyard_arrival_set ::= opponent_graveyard_arrival_target

/* The singular exile producer fixes the card whose property sizes the tokens. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One($opponent_graveyard_arrival_target), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:$receipt_stat, information:CurrentOrLastKnown}, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
instructions_exile_singular_card_stat_tokens ::= "exile" opponent_graveyard_arrival_target "," "then" "create" "X" token_named_recipe "tokens" "," "where" "X" "is" "the" "exiled" "card's" receipt_stat

/* The chooser and the neighboring controller are distinct bound players. */
/* @sem Operation::ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(InChosenDirection{from:Bound(0)}))])}, count:AsManyAsCan($counter_amount)} */
choose_next_players_permanent ::= "chooses" counter_amount filter_phrase "controlled" "by" "the" "next" "player" "in" "that" "direction"

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, starting_with:AbilityController, in_chosen_direction:true, body:Program{instructions:[Effect{result:@next, operation:$choose_next_players_permanent}]}}] */
clause_ordered_neighbor_choice ::= "starting" "with" "you" "and" "proceeding" "in" "the" "chosen" "direction" "," players_singular choose_next_players_permanent

/* The repeated noun denotes the selected kind, so keep both sides in one scope. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, starting_with:AbilityController, in_chosen_direction:true, body:Program{instructions:[Effect{result:@mark, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($filter_phrase, $noun), ControlledBy(One(InChosenDirection{from:Bound(0)}))])}, count:AsManyAsCan($counter_amount)}}]}}, ForEachPlayer{players:$players_singular_2, binding:0, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(ChosenBy{result:@marked, chooser:Bound(0)})), changes:[SetController(Bound(0))], duration:Indefinite, evaluation:Snapshot}}]}}] */
instructions_neighbor_choice_control ::= "starting" "with" "you" "and" "proceeding" "in" "the" "chosen" "direction" "," players_singular "chooses" counter_amount filter_phrase "controlled" "by" "the" "next" "player" "in" "that" "direction" "." players_singular "gains" "control" "of" "the" noun "they" "chose"

/* The optional choice and its complement share the same player population and receipt. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:Bound(0), cost:Cost{parts:[Choice([Cost{parts:[$optional_choice_discard]}, Cost{parts:[$cost_sacrifice]}])]}, optional:true}}]}}, Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(Intersection([$players_singular_2, Matching{binding:0, condition:Not(PlayerTook{player:Bound(0), result:@marked})}])), amount:$value, preventable:true}}] */
instructions_optional_discard_sacrifice_damage ::= players_singular "may" optional_choice_discard "or" cost_sacrifice "of" "their" "choice" "." object_ref "deals" value "damage" "to" players_singular "who" "didn't"

optional_choice_discard ::= cost_discard | cost_discard_many

/* Used only under a life-gain trigger, whose amount binds the anaphors. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$life_gain_payment, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$life_gain_draw_count}}]}, otherwise:Program{}}]} */
life_gain_paid_draw_program ::= "you" "may" life_gain_payment "." "if" "you" "do" "," "draw" life_gain_draw_count

life_gain_payment ::= life_gain_amount_payment

/* @sem Cost::Cost{parts:[Life(EventAmount)]} */
life_gain_amount_payment ::= "pay" "that" "much" "life"

life_gain_draw_count ::= life_gain_event_cards | card_count_one | card_count_many

/* @sem Expr::EventAmount */
life_gain_event_cards ::= "that" "many" "cards"

/* The stack object named by the event is also the object whose controller pays. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf($shared_event_stack_object), cost:$counter_unless_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One($shared_event_stack_object), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}] */
shared_event_counter_unless ::= "counter" shared_event_stack_object "unless" "its" "controller" "pays" counter_unless_cost

shared_event_stack_object ::= shared_event_ability | shared_event_spell_or_ability

/* @prefer always */
/* @sem ObjectRef::EventStackObject */
shared_event_ability ::= "that" "ability"

/* @sem ObjectRef::EventStackObject */
shared_event_spell_or_ability ::= "that" "spell" "or" "ability"

/* A declined payment refers to the per-player receipt of the preceding offer. */
/* @sem Instruction::Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(Intersection([$players_singular, Matching{binding:0, condition:Not(PlayerTook{player:Bound(0), result:@marked})}])), amount:$value, preventable:true}} */
player_declined_payment_damage ::= object_ref "deals" value "damage" "to" players_singular "who" "didn't"

/* @sem Instruction::[$players_optional_choice_cost, $player_declined_payment_damage] */
instructions_optional_choice_declined_damage ::= players_optional_choice_cost "." player_declined_payment_damage

/* Keep selection and destruction in one scope so the noun describes the choice. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree(@agree($plural, $noun), $noun_2)}, count:AsManyAsCan(CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree(@agree($plural, $noun), $noun_2)})), constraints:[DifferentProperty(Power)]}}, Effect{result:@next, operation:Destroy{objects:Unselected(@prior), regeneration:true}}] */
distinct_population_choice_power ::= "for" "each" "different" "power" "among" plural "on" "the" "battlefield" "," "choose" "a" noun "with" "that" "power" "." "destroy" "each" noun "not" "chosen" "this" "way"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree(@agree($plural, $noun), $noun_2)}, count:AsManyAsCan(CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree(@agree($plural, $noun), $noun_2)})), constraints:[DifferentProperty(Toughness)]}}, Effect{result:@next, operation:Destroy{objects:Unselected(@prior), regeneration:true}}] */
distinct_population_choice_toughness ::= "for" "each" "different" "toughness" "among" plural "on" "the" "battlefield" "," "choose" "a" noun "with" "that" "toughness" "." "destroy" "each" noun "not" "chosen" "this" "way"

/* Used only within a singular death trigger; the card is its graveyard arrival. */
/* @sem Operation::Move{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), destination:$battlefield_control, qualifiers:[]} */
shared_first_card_return ::= "return" "the" "first" "card" "to" "the" "battlefield" battlefield_control

/* @sem Operation::CreateDelayedTrigger{event:$delayed_move_end_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:$shared_first_card_return}]}} */
shared_first_card_delayed_return ::= shared_first_card_return "at" delayed_move_end_event

/* The amount and its two anaphors are licensed only by this damage event. */
/* @sem Expr::EventAmount */
combat_player_damage_amount ::= "the" "amount" "of" "damage" "it" "dealt" "to" "that" "player"

/* @sem Operation::Surveil{players:One(AbilityController), amount:$combat_player_damage_amount} */
combat_player_damage_surveil ::= "surveil" "X" "," "where" "X" "is" combat_player_damage_amount

/* @sem Operation::Keyword{actor:One(ControllerOf(EventSubject)), action:KeywordAction::Connive{object:EventSubject, amount:$combat_player_damage_amount}} */
combat_player_damage_connive ::= "it" "connives" "X" "," "where" "X" "is" combat_player_damage_amount

combat_player_damage_action ::= combat_player_damage_surveil | combat_player_damage_connive

/* @sem DamageKind::Combat */
scoped_player_combat_damage ::= "combat" "damage"

/* @sem DamageKind::Any */
scoped_player_any_damage ::= "damage"

scoped_player_damage_kind ::= scoped_player_combat_damage | scoped_player_any_damage

/* @sem Ability::Triggered{event:Damage(_{source_kind:Permanent, sources:$event_singular_subject, recipients:Players(All), kind:$scoped_player_damage_kind, grouping:SourceRecipient, subject:Source}), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$combat_player_damage_action}]}} */
triggered_combat_player_damage_amount ::= "whenever" event_singular_subject "deals" scoped_player_damage_kind "to" "a" "player" "," combat_player_damage_action "."

/* Both instructions name the same distributive battlefield population. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($counter_untap_population), kind:$counter_kind, amount:Constant(1)}]}}, Effect{result:@next, operation:SetTapped{objects:$counter_untap_population, tapped:false}}]} */
program_counters_then_untap_each ::= "put" "a" counter_kind "counter" "on" counter_untap_population "," "then" "untap" "them"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($counter_untap_population), kind:$counter_kind, amount:$counter_battlefield_plural_amount}]}}, Effect{result:@next, operation:SetTapped{objects:$counter_untap_population, tapped:false}}]} */
program_counters_then_untap_each_many ::= "put" counter_battlefield_plural_amount counter_kind "counters" "on" counter_untap_population "," "then" "untap" "them"

/* The printed population is limited to tapped controlled permanent types: a
   counter-dependent or stat-dependent filter would change after placement. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Tapped, $counter_untap_noun, ControlledBy(One(AbilityController))])} */
counter_untap_population ::= "each" "tapped" counter_untap_noun "you" "control"

counter_untap_noun ::= noun_creature | noun_artifact | noun_land | noun_enchantment

/* A single discarded card paid alongside mana supplies the damage property.
   The payment and consumer are scoped together for inverse printing. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$cost_mana, $cost_discard]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:$recipients, amount:ObjectProperty{object:Query{objects:CostObjects{payment:Resolution(@marked), component:[1], view:Inputs, phase:Before}, index:0}, property:$receipt_stat, information:CurrentOrLastKnown}, preventable:true}}]}, otherwise:Program{}}]} */
program_mana_discard_property_damage ::= "you" "may" "pay" cost_mana "and" cost_discard "." "if" "you" "do" "," self_explicit_ref "deals" "damage" "to" recipients "equal" "to" "the" "discarded" "card's" receipt_stat

/* The event subject’s controller makes a payment whose receipt controls the fallback. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:ControllerOf(EventSubject), cost:$other_payment, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_event_controller_declines_payment ::= "they" "may" other_payment "." "if" "they" "don't" "," conjoined

/* Either private zone supplies its own choice and subsequent perpetual grant. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$hand_spell_card_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$incorporate_cast_grant}}]}, Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$hand_spell_card_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$incorporate_cast_grant}}]}]}] */
private_choice_incorporate_cast ::= "choose" hand_spell_card_filter "card" "in" "your" "hand" "or" "graveyard" "." "that" "card" "perpetually" incorporate_cast_grant

/* This selection's result is the object moved, independently of earlier choices. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$private_return_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
private_return_card_hand ::= "return" "a" private_return_filter "card" "from" "your" "graveyard" "to" "your" "hand"

/* @sem ObjectFilter::AllOf([$adjective_multicolored, AnyOf([$hand_first_spell_card_type, $spell_sorcery])]) */
private_return_filter ::= adjective_multicolored hand_first_spell_card_type "or" spell_sorcery

/* Compose the separate choices and preserve the return's sequential group. */
/* @sem Program::Program{instructions:@then_sequence($private_choice_incorporate_cast, $private_return_card_hand)} */
program_private_choice_then_return ::= private_choice_incorporate_cast "then" private_return_card_hand

/* @sem Program::Program{instructions:$private_choice_incorporate_cast} */
program_private_choice_incorporate ::= private_choice_incorporate_cast

/* @sem Program::Program{instructions:$private_return_card_hand} */
program_private_return ::= private_return_card_hand

/* A possessive target introduces the object whose controller performs the payment. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$possessive_target_kind}), index:0} */
possessive_controller_target ::= "target" possessive_target_kind "controller"

possessive_target_kind ::= possessive_permanent_kind | possessive_creature_kind | possessive_artifact_kind

/* @sem ObjectFilter::Any */
possessive_permanent_kind ::= "permanent's"

/* @sem ObjectFilter::CardType(Creature) */
possessive_creature_kind ::= "creature's"

/* @sem ObjectFilter::CardType(Artifact) */
possessive_artifact_kind ::= "artifact's"

/* This call site proves the target is the object sacrificed by its controller. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:ControllerOf($possessive_controller_target), cost:Cost{parts:[Sacrifice{objects:One($possessive_controller_target)}]}, optional:false}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$sacrificed_target_reveal_group}, otherwise:Program{}}] */
clause_controller_sacrifice_reveal ::= possessive_controller_target "sacrifices" "it" "." "if" "the" "player" "does" "," sacrificed_target_reveal_group

/* A required sacrifice may have any independently expressed success branch. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:ControllerOf($possessive_controller_target), cost:Cost{parts:[Sacrifice{objects:One($possessive_controller_target)}]}, optional:false}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_controller_sacrifice_success ::= possessive_controller_target "sacrifices" "it" "." "if" "the" "player" "does" "," conjoined

/* A resolution payment returns one other controlled permanent to its owner's hand. */
/* @sem Cost::Cost{parts:[Move{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), $filter_phrase, ControlledBy(One(AbilityController))])}, choose:Exactly(Constant(1))}], destination:OwnersHand(CardArrival{counters:[], states:[]})}]} */
payment_return_another_controlled ::= "return" "another" filter_phrase "you" "control" "to" "its" "owner's" "hand"

/* The arrival state is independent of the moved card and its controller. */
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Player(AbilityController), arrival:$battlefield_orientation}, qualifiers:[]} */
move_battlefield_state ::= "return" affected "to" "the" "battlefield" battlefield_orientation

battlefield_orientation ::= entry_flipped | transformed_entry

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[], states:[Flipped]} */
entry_flipped ::= "flipped"

/* The arrival's granted activation is scoped to the returned Aura. */
/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[], states:[Changes([SetCardTypes([Enchantment]), AddEnchantmentType(Vocabulary{family:EnchantmentType, form:Aura}), RemoveAllAbilities, GrantAbility(Enchant{hosts:Permanents($filter_phrase)}), GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program}))])]} */
returned_aura_arrival ::= "it's" "an" "Aura" "enchantment" "with" "enchant" filter_phrase "and" '"' cost ":" program "," '"' "and" "it" "loses" "all" "other" "abilities"

/* @sem Operation::Move{objects:$affected, destination:Battlefield{controller:Player(AbilityController), arrival:$returned_aura_arrival}, qualifiers:[]} */
return_with_aura_arrival ::= "return" affected "to" "the" "battlefield" "." returned_aura_arrival

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}} */
return_tapped_attacking_destination ::= "tapped" "and" "attacking"

/* The destination phrase keeps the arrival state and counter operands together,
   independently of the returned object. Singular and plural forms are separate. */
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:$transformed_counter_destination, qualifiers:[]} */
move_to_transformed_counter_destination ::= "return" affected "to" "the" "battlefield" transformed_counter_destination

transformed_counter_destination ::= transformed_counter_destination_one | transformed_counter_destination_many

/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[[$counter_kind, Constant(1)]], states:[Transformed]}} */
transformed_counter_destination_one ::= "tapped" "and" "transformed" "under" "its" "owner's" "control" "with" "a" counter_kind "counter" "on" "it"

/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[[$counter_kind, @plural_amount($value)]], states:[Transformed]}} */
transformed_counter_destination_many ::= "tapped" "and" "transformed" "under" "its" "owner's" "control" "with" value counter_kind "counters" "on" "it"

/* The conditional cast refers to the copy made by this optional action. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:CopyCards{actor:One(AbilityController), objects:One($linked_exiled_card), times:Constant(1)}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Earlier{what:CopiedSpell}, count:Exactly(Constant(1)), terms:_{cost:Free}}}]}}]}, otherwise:Program{}}] */
instructions_optional_copy_linked_cast ::= "you" "may" "copy" linked_exiled_card "." "if" "you" "do" "," "you" "may" "cast" "the" "copy" "without" "paying" "its" "mana" "cost"

/* A pair of announced targets can be followed by a temporary control change
   and an attachment. The attachment and its host remain distinct targets. */
/* @sem Ability::Spell{announcement:_{targets:[_{slot:0, kind:Object{kind:Permanent, zones:[Battlefield]}, count:Exactly(Constant(1)), filter:@and($controlled_attachment_host, ObjectFilter::ControlledBy(One(AbilityController))), constraints:[]}, _{slot:1, kind:Object{kind:Permanent, zones:[Battlefield]}, count:Exactly(Constant(1)), filter:Subtype(Equipment), constraints:[]}]}, body:_{instructions:[...$controlled_equipment_attachment, $equipment_control_loss_trigger]}} */
spell_control_equipment_attach ::= "choose" "target" controlled_attachment_host "you" "control" "and" "target" "Equipment" "." controlled_equipment_attachment "." equipment_control_loss_trigger "."

controlled_attachment_host ::= controlled_attachment_host_plain | controlled_attachment_host_qualified

/* @sem ObjectFilter::CardType(Creature) */
controlled_attachment_host_plain ::= "creature"

/* @sem @and($filter_outer_adjectives, ObjectFilter::CardType(Creature)) */
controlled_attachment_host_qualified ::= filter_outer_adjectives "creature"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:1, index:0})), changes:[SetController(AbilityController)], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:Attach{attachments:One(Target{slot:1, index:0}), host:Target{slot:0, index:0}}}] */
controlled_equipment_attachment ::= "gain" "control" "of" "that" "Equipment" duration "." "attach" "it" "to" "the" "chosen" "creature"

/* The intervening condition tests the host's current filter, independently of
   the eligibility used to announce the original creature target. */
/* @sem Instruction::Effect{result:@next, operation:CreateTrigger{event:Player{event:LosesControl, players:One(AbilityController), objects:SameObject(Target{slot:1, index:0})}, duration:EndOfTurn, announcement:_{targets:[]}, body:_{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:Unattach{object:Target{slot:1, index:0}}}}]}, once:false, intervening_if:ObjectMatches{object:Target{slot:1, index:0}, filter:AttachedTo(InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))}))}}} */
equipment_control_loss_trigger ::= "when" "you" "lose" "control" "of" "that" "Equipment" "this" "turn" "," "if" "it's" "attached" "to" "a" filter_phrase "you" "control" "," "unattach" "it"

/* The owner and shuffled object are bound together in each subject phrase. */
/* @sem Operation::Move{objects:$owner_shuffle_subject, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
owner_shuffle_move ::= owner_shuffle_subject "into" "their" "library"

owner_shuffle_subject ::= owner_shuffle_source | owner_shuffle_attached | owner_shuffle_chosen | owner_shuffle_prior

/* @sem ObjectSet::One(Source) */
owner_shuffle_source ::= SELF_NAME "'s" "owner" "shuffles" SELF_NAME

/* @sem ObjectSet::One(AttachedTo(Source)) */
owner_shuffle_attached ::= "enchanted" "creature's" "owner" "shuffles" "it"

/* @sem ObjectSet::One($target_object) */
owner_shuffle_chosen ::= "choose" target_object "." "its" "owner" "shuffles" "it"

/* @sem ObjectSet::One(@it) */
owner_shuffle_prior ::= "its" "owner" "shuffles" "it"

/* A delayed blink of the event subject and a selected saddler. Keep the
   selection, exile and return together so the return names that exile receipt. */
/* @sem ObjectFilter::@and($filter_phrase, ObjectFilter::Condition(Condition::Compare{left:EventHistory{event:Pair{event:Saddles, objects:SameObject(Candidate), others:SameObject(EventSubject)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})) */
event_saddler_filter ::= filter_phrase "that" "saddled" "it" "this" "turn"

/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$event_saddler_filter}, count:UpTo(Constant(1)), constraints:[]} */
choose_one_event_saddler ::= "up" "to" "one" event_saddler_filter

/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
return_their_owner_control ::= "under" "their" "owner's" "control"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, expires:EndOfCombat, body:Program{instructions:[Effect{result:@next, operation:$choose_event_saddler}, Effect{result:@next, operation:Move{objects:Union([One(EventSubject), Selected(@prior)]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@prior, phase:After}, zone:Exile}, destination:$saddler_return_control, qualifiers:[]}}]}}}]} */
combat_end_event_saddler_blink ::= "at" "end" "of" "combat" "," "exile" "it" "and" choose_event_saddler "," "then" "return" "those" "cards" "to" "the" "battlefield" saddler_return_control

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$combat_end_event_saddler_blink} */
triggered_combat_end_event_saddler_blink ::= event_clause "," combat_end_event_saddler_blink "."

saddler_return_control ::= return_their_owner_control | battlefield_control_yours

/* @sem ObjectFilter::@and($filter_plural, ObjectFilter::Condition(Condition::Compare{left:EventHistory{event:Pair{event:Saddles, objects:SameObject(Candidate), others:SameObject(EventSubject)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})) */
event_saddler_filter_plural ::= filter_plural "that" "saddled" "it" "this" "turn"

/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$event_saddler_filter_plural}, count:UpTo($count_plural), constraints:[]} */
choose_many_event_saddlers ::= "up" "to" count_plural event_saddler_filter_plural

choose_event_saddler ::= choose_one_event_saddler | choose_many_event_saddlers

/* The counter recipient is the first fighter; the repeated description proves the opposing fighter's identity. */
/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:Target{slot:0, index:0}, second:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([@agree($noun_atomic, $noun_atomic_2), ControlledBy(OpponentsOf(AbilityController))])}), index:0}}}}, Effect{result:@next, operation:CreateTrigger{event:ZoneChange{objects:SameObject(Target{slot:1, index:0}), from:Battlefield, to:Graveyard}, duration:$this_duration, body:Program{instructions:[Effect{result:@next, operation:$operation_plain}]}, intervening_if:$condition_one, announcement:_{}}}] */
fight_opposing_described_death ::= "then" "it" "fights" "target" noun_atomic "an" "opponent" "controls" "." "when" "the" noun_atomic "an" "opponent" "controls" "dies" this_duration "," "if" condition_one "," operation_plain

/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($chosen_controlled_fighter)), kind:$counter_kind, amount:Constant(1)}]}}] */
controlled_fighter_single_counter ::= "put" "a" counter_kind "counter" "on" chosen_controlled_fighter

/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($chosen_controlled_fighter)), kind:$counter_kind, amount:$counter_amount}]}}] */
controlled_fighter_multiple_counters ::= "put" counter_amount counter_kind "counters" "on" chosen_controlled_fighter

controlled_fighter_counters ::= controlled_fighter_single_counter | controlled_fighter_multiple_counters

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$controlled_fighter_counters, ...$fight_opposing_described_death]}} */
counter_fighter_described_death_spell ::= controlled_fighter_counters "." fight_opposing_described_death "."

/* Used only under the casting-sacrifice wrapper which proves the receipt. */
/* @sem Instruction::Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_your_upkeep, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:AnyOf([SameObject($return_target_card_in_your_graveyard), SameObject(Query{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Inputs, phase:Before}, index:0})])}, destination:$battlefield_control_yours, qualifiers:[]}}]}}} */
casting_sacrifice_delayed_return ::= "choose" return_target_card_in_your_graveyard "." "return" "that" "card" "and" "the" "sacrificed" "card" "to" "the" "battlefield" battlefield_control_yours "at" delayed_your_upkeep

/* The controller of a targeted permanent reveals from their own hand. */
/* @sem Operation::RevealFromHand{actor:One(ControllerOf($possessive_controller_target)), cards:Any, count:$card_count, at_random:true} */
controller_random_reveal ::= possessive_controller_target "reveals" card_count "at" "random" "from" "their" "hand"

/* Singular typed producers keep the later anaphor tied to the announced kind. */
/* @sem Operation::RevealFromHand{actor:One(ControllerOf(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0})), cards:Any, count:Constant(1), at_random:true} */
controller_creature_reveal_one ::= "target" "creature's" "controller" "reveals" "a" "card" "at" "random" "from" "their" "hand"

/* @sem Operation::RevealFromHand{actor:One(ControllerOf(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Artifact)}), index:0})), cards:Any, count:Constant(1), at_random:true} */
controller_artifact_reveal_one ::= "target" "artifact's" "controller" "reveals" "a" "card" "at" "random" "from" "their" "hand"

/* @sem Operation::DealDamage{source:$self_explicit_ref, recipients:Union([Objects(One(Target{slot:@last_slot, index:0})), Players(One(ControllerOf(Target{slot:@last_slot, index:0})))]), amount:ObjectProperty{object:Query{objects:Observed(@prior), index:0}, property:$receipt_stat, information:CurrentOrLastKnown}, preventable:true} */
observed_property_damage_creature_controller ::= self_explicit_ref "deals" "damage" "to" "that" "creature" "and" "that" "player" "equal" "to" "the" "revealed" "card's" receipt_stat

/* @sem Operation::DealDamage{source:$self_explicit_ref, recipients:Union([Objects(One(Target{slot:@last_slot, index:0})), Players(One(ControllerOf(Target{slot:@last_slot, index:0})))]), amount:ObjectProperty{object:Query{objects:Observed(@prior), index:0}, property:$receipt_stat, information:CurrentOrLastKnown}, preventable:true} */
observed_property_damage_artifact_controller ::= self_explicit_ref "deals" "damage" "to" "that" "artifact" "and" "that" "player" "equal" "to" "the" "revealed" "card's" receipt_stat

/* @sem Instruction::[Effect{result:@next, operation:$controller_creature_reveal_one}, Effect{result:@next, operation:$observed_property_damage_creature_controller}] */
/* @prefer always */
controller_creature_reveal_property_damage ::= controller_creature_reveal_one "." observed_property_damage_creature_controller

/* @sem Instruction::[Effect{result:@next, operation:$controller_artifact_reveal_one}, Effect{result:@next, operation:$observed_property_damage_artifact_controller}] */
/* @prefer always */
controller_artifact_reveal_property_damage ::= controller_artifact_reveal_one "." observed_property_damage_artifact_controller

controller_reveal_property_damage ::= controller_creature_reveal_property_damage | controller_artifact_reveal_property_damage

/* A payment scaled by the announced X of this spell. */
/* @sem Cost::Cost{parts:[ManaWithX{mana:[X], x:Multiply(Constant(2), AnnouncedX)}]} */
counter_unless_twice_x ::= "twice" "{" "X" "}"

/* Three separately announced permanent targets, each distinct from earlier targets. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamageParts{source:$damage_source_ref, parts:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_phrase}), index:0})), amount:$number}, _{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(SameObject(Target{slot:0, index:0})), $filter_phrase_2])}), index:0})), amount:$number_2}, _{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(SameObject(Target{slot:0, index:0})), Not(SameObject(Target{slot:1, index:0})), $filter_phrase_3])}), index:0})), amount:$number_3}], preventable:true}}] */
clause_damage_distinct_three_objects ::= damage_source_ref "deals" number "damage" "to" "target" filter_phrase "," number "damage" "to" "another" "target" filter_phrase "," "and" number "damage" "to" "a" "third" "target" filter_phrase

/* The replacement consumes precisely the immediately preceding damage result. */
/* @sem Instruction::[...$clause_damage_distinct_three_objects, Effect{result:@next, operation:$exile_damaged_instead_of_dying}] */
instructions_three_damage_exile ::= clause_damage_distinct_three_objects "." exile_damaged_instead_of_dying

/* @sem Instruction::[ForEachPlayer{players:$optional_action_players, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::Bound(0)), $optional_bound_action)}]}}]}}] */
clause_common_optional_action ::= optional_action_players "may" optional_bound_action

/* The optional choice and action belong to the same bound player. */
/* @sem Instruction::[ForEachPlayer{players:$players_each_other, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::Bound(0)), $other_optional_bound_action)}]}}]}}] */
clause_other_optional_action ::= players_each_other "may" other_optional_bound_action

other_optional_bound_action ::= draw_up_to_base

/* @sem Operation::DrawUpTo{players:@subject, amount:$card_count} */
draw_up_to_base ::= "draw" "up" "to" card_count

/* A declined life payment permits the independently described operation. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:$player_ref, cost:Cost{parts:[Life($value)]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:$operation}]}, otherwise:Program{}}]} */
program_operation_unless_life ::= operation "unless" player_ref "pays" value "life"

/* A flip binds its result to both independently described outcome programs. */
/* @sem Instruction::[Effect{result:@mark, operation:$flip_a_coin}, If{condition:CoinFlip{result:@marked, outcome:Won}, then:$program, otherwise:$program_2}] */
coin_flip_branching ::= flip_a_coin "." "if" "you" "win" "the" "flip" "," program "." "if" "you" "lose" "the" "flip" "," program

/* The removal receipt, rather than the original query, identifies the untapped objects. */
/* @sem Instruction::[Effect{result:@next, operation:KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::RemoveFromCombat, objects:$objects_all}}, Effect{result:@next, operation:SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:InSet(Recorded(@prior))}}}] */
clause_remove_combat_untap ::= "remove" objects_all "from" "combat" "and" "untap" "them"

/* The subsequent creature anaphor requires a creature population in this producer. */
/* @sem Instruction::[Effect{result:@next, operation:KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::RemoveFromCombat, objects:$combat_creature_population}}, Effect{result:@next, operation:SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:InSet(Recorded(@prior))}}}] */
removed_creatures_untap ::= "remove" combat_creature_population "from" "combat" "and" "untap" "them"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_outer_adjectives, $plural_creature)} */
combat_creature_population_qualified ::= "all" filter_outer_adjectives plural_creature

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$plural_creature} */
combat_creature_population_plain ::= "all" plural_creature

combat_creature_population ::= combat_creature_population_qualified | combat_creature_population_plain

/* A plural assignment shares the combat rule across targeted and controlled groups. */
plural_assignment_group ::= blocked_target_group | controlled_assignment_group

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(AbilityController)))} */
controlled_assignment_group ::= filter_plural "you" "control"

/* @prefer always */
/* @sem Operation::$plural_assign_unblocked_effect */
have_plural_assignment ::= "have" plural_assign_unblocked_effect

/* Each flip has its own player binding and branches consuming that flip. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@mark, operation:$flip_a_coin}, If{condition:CoinFlip{result:@marked, outcome:Won}, then:$program, otherwise:$per_player_coin_branch}]}}] */
clause_per_player_coin_outcomes ::= flip_a_coin "for" players_singular "you" "have" "." "for" "each" "flip" "you" "win" "," program "." "for" "each" "flip" "you" "lose" "," per_player_coin_branch

per_player_coin_branch ::= per_player_coin_bound_damage | per_player_coin_bound_life_loss

/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(One(Bound(0))), amount:$value, preventable:true}}]} */
per_player_coin_bound_damage ::= object_ref "deals" value "damage" "to" "that" "player"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(Bound(0)), amount:$value}}]} */
per_player_coin_bound_life_loss ::= "that" "player" "loses" value "life"

/* The token-death event refers to the token produced by this same instruction. */
/* @sem Instruction::[Effect{result:@mark, operation:$create_one_defined}, Effect{result:@next, operation:CreateDelayedTrigger{event:$created_token_death_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:$exiled_self_return_owner}]}}}] */
created_token_death_return_pair ::= create_one_defined "." exiled_self_return_owner "when" created_token_death_event

/* @sem EventSpec::ZoneChange{objects:InSet(Created(@marked)), from:Battlefield, to:Graveyard} */
created_token_death_event ::= "that" "token" "dies"

/* @sem Operation::Move{objects:InZone{objects:One($self_explicit_ref), zone:Exile}, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
exiled_self_return_owner ::= "return" self_explicit_ref "to" "the" "battlefield" "under" "its" "owner's" "control"

/* Exiling the source as a cost establishes the zone of the later return. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[...$cost_parts, $cost_exile_self]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:$created_token_death_return_pair}} */
activated_exile_source_create_return ::= cost_parts "," "↑" cost_exile_self ":" created_token_death_return_pair "."

/* The returned card and its immediate perpetual changes share the movement receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card_your_graveyard), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:Transition{result:@prior, phase:After}, changes:$returned_perpetual_type_stats_cost}}] */
instructions_returned_perpetual ::= "return" target_card_your_graveyard "to" "your" "hand" "." "it" "perpetually" returned_perpetual_type_stats_cost

/* @sem Change::[CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetBasePowerToughness{power:$number_digits, toughness:$number_digits_2}, GrantAbility($casting_alternative_plain)] */
returned_perpetual_type_stats_cost ::= "becomes" "a" becomes_types "," "has" "base" "power" "and" "toughness" number_digits "/" number_digits "," "and" "gains" '"' casting_alternative_plain '"'

/* A clash carries independent programs for both outcomes. */
/* @sem Operation::Clash{actor:One(AbilityController), opponents:OpponentsOf(AbilityController), won:[$program], lost:[$program_2]} */
clash_outcomes ::= "clash" "with" "an" "opponent" "." "if" "you" "win" "," program "." "otherwise" "," program

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$clash_outcomes}]}} */
spell_clash_outcomes ::= clash_outcomes "."

/* Used within a scoped two-component sacrifice activation; the aggregate
   measures the performed payments before their movement. */
/* @sem Operation::DealDamage{source:$self_explicit_ref, recipients:$recipients, amount:Aggregate{objects:Union([CostObjects{payment:Activation, component:[1], view:Performed, phase:Before}, CostObjects{payment:Activation, component:[2], view:Performed, phase:Before}]), property:$sacrifice_total_property, aggregation:Sum}, preventable:true} */
sacrifice_pair_damage_preventable ::= self_explicit_ref "deals" "X" "damage" "to" recipients "," "where" "X" "is" "the" "total" sacrifice_total_property

/* @sem Operation::DealDamage{source:$self_explicit_ref, recipients:$recipients, amount:Aggregate{objects:Union([CostObjects{payment:Activation, component:[1], view:Performed, phase:Before}, CostObjects{payment:Activation, component:[2], view:Performed, phase:Before}]), property:$sacrifice_total_property, aggregation:Sum}, preventable:false} */
sacrifice_pair_damage_unpreventable ::= self_explicit_ref "deals" "X" "damage" "that" "can't" "be" "prevented" "to" recipients "," "where" "X" "is" "the" "total" sacrifice_total_property

sacrifice_pair_damage ::= sacrifice_pair_damage_preventable | sacrifice_pair_damage_unpreventable

/* The conditional choice selects attachments and an independently referenced host. */
/* @sem Instruction::[Effect{result:@next, operation:AttachChosen{actor:One(AbilityController), attachments:$affected, count:AnyNumber, hosts:$affected_2}}] */
clause_conditional_attach_chosen ::= "you" "may" "attach" "any" "number" "of" affected "to" affected

/* Only consumed under a source-attacks trigger: its controller is the active
   player, so the next main phase this turn is necessarily that player's. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:MainPhaseBegins, players:All}, start:Immediately, expires:EndOfTurn, body:Program{instructions:[Effect{result:@next, operation:$add_mana}]}}}]} */
source_attack_next_main_program ::= add_mana "at" "the" "beginning" "of" "your" "next" "main" "phase" "this" "turn" "."

/* The revelation and comparison refer to the same pair of secret choices. */
/* @sem Vec<Instruction>::[ForEachPlayer{players:Union([One(AbilityController), One($secret_choice_target)]), binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseValue{choosers:One(Bound(0)), kind:Number, terms:_{options:[Comparison(GreaterOrEqual, Constant(1)), Comparison(LessOrEqual, Constant(3))], count:Exactly(Constant(1)), secret:true}}}]}}, Effect{result:@next, operation:RevealChoices{kind:Number}}] */
secret_pair_number_reveal ::= "you" "and" secret_choice_target "each" "secretly" "choose" "1" "," "2" "," "or" "3" "." "then" "those" "choices" "are" "revealed"

secret_choice_target ::= target_opponent

/* @sem Program::Program{instructions:[...$secret_pair_number_reveal, If{condition:Compare{left:AmongPlayers{players:All, number:ChosenNumber, aggregation:Maximum}, test:Compare{comparison:Equal, value:AmongPlayers{players:All, number:ChosenNumber, aggregation:Minimum}}}, then:Program{instructions:$secret_match_then}, otherwise:$secret_match_otherwise}]} */
secret_number_match_program ::= secret_pair_number_reveal "." "if" "they" "match" "," secret_match_then "." "otherwise" "," secret_match_otherwise

/* @sem Program::Program{instructions:$conjoined} */
secret_match_otherwise_conjoined ::= conjoined

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$hidden_top_card}]} */
secret_match_otherwise_top_one ::= hidden_top_card

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$hidden_own_top_many}]} */
secret_match_otherwise_top_many ::= hidden_own_top_many

secret_match_otherwise ::= secret_match_otherwise_conjoined | secret_match_otherwise_top_one | secret_match_otherwise_top_many

/* The linked pronoun denotes the exact sacrificed object. */
/* @prefer always */
/* @sem Vec<Instruction>::[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:One($self_explicit_ref)}}, Effect{result:@next, operation:Move{objects:@zone_members(ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($self_explicit_ref)}), destination:OwnersHand{}, qualifiers:[]}}] */
secret_match_then_linked ::= "sacrifice" self_explicit_ref "and" "put" "all" "cards" "exiled" "with" "it" "into" "their" "owners'" "hands"

secret_match_then ::= secret_match_then_linked

/* A control transfer and its reflexive callback share the affected player. */
/* @sem Operation::GiveControl{players:$players_singular, objects:$affected} */
player_control_transfer ::= players_singular "gains" "control" "of" affected

/* @sem Instruction::[Effect{result:@next, operation:WithReflexive{action:$player_control_transfer, when:YouDo, body:Program{instructions:$conjoined}}}] */
instructions_control_reflexive ::= player_control_transfer "." "when" "they" "do" "," conjoined

/* Sequence an imperative action and the separately expressed control transfer. */
/* @sem Instruction::[Effect{result:@next, operation:$operation_imperative}, Effect{result:@next, operation:$opponent_gains_control}] */
imperative_then_opponent_control ::= operation_imperative "." opponent_gains_control

shared_life_total_amount ::= bound_player_controlled_count | shared_player_extreme_quantity

/* The aggregation population and the measured player quantity are independent. */
/* @sem Expr::AmongPlayers{players:$choice_life_population, number:$shared_extreme_player_number, aggregation:$extreme_return_order} */
shared_player_extreme_quantity ::= "the" extreme_return_order shared_extreme_player_number "among" choice_life_population

shared_extreme_player_number ::= shared_extreme_life | shared_extreme_hand

/* @sem PlayerNumber::Life */
shared_extreme_life ::= "life" "total"

/* @sem PlayerNumber::CardsInHand */
shared_extreme_hand ::= "number" "of" "cards" "in" "hand"

/* The combat subject remains the same object through both instructions and
   the explanatory unblocking clause. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:One(EventSubject), tapped:true}}] */
tap_event_creature ::= "tap" "the" "creature"

/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::RemoveFromCombatUnblocking{object:EventSubject}}}] */
remove_event_creature_unblocking ::= "remove" "it" "from" "combat" "," "and" "creatures" "it" "was" "blocking" "that" "had" "become" "blocked" "by" "only" "that" "creature" "this" "combat" "become" "unblocked"

/* @sem Instruction::[...$tap_event_creature, ...$remove_event_creature_unblocking] */
tap_event_creature_combat_removal ::= tap_event_creature "," remove_event_creature_unblocking

/* Both mentions name stun counters; the draw reads this removal receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}), kind:Named(StunCounter), amount:AmongThem(UpTo($number_words))}]}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountersRemoved(@marked)}}] */
clause_optional_remove_counted_draw ::= "you" "may" "remove" "up" "to" number_words "stun" "counters" "from" "among" "all" filter_plural "." "draw" "cards" "equal" "to" "the" "number" "of" "stun" "counters" "removed" "this" "way"

/* A willing player may pay to prevent the stated mana production. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:FirstWilling(All), cost:Cost{parts:[$cost_mana]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:$willing_mana_operation}]}, otherwise:Program{}}] */
clause_willing_mana_unless ::= willing_mana_operation "unless" "any" "player" "pays" cost_mana

willing_mana_operation ::= willing_mana_referred | add_mana_of_chosen_color | add_mana | willing_additional_pump | return_counted_graveyard_targets_hand

/* @prefer always */
/* @sem $add_mana_of_that_color */
willing_mana_referred ::= add_mana_of_that_color

/* The single revealed plane is the destination; the other revealed cards
   return to the same planar deck after the planeswalk. */
/* @sem KeywordAction::PlanarDeckPlaneswalkWithoutLeaving */
planar_reveal_one_walk_without_leaving ::= "a" "plane" "card" "." "planeswalk" "to" "it" "," "except" "don't" "planeswalk" "away" "from" "any" "plane" "." "put" "the" "rest" "of" "the" "revealed" "cards" "on" "the" "bottom" "of" "your" "planar" "deck" "in" "any" "order"

/* The planeswalk trigger owns this standalone chaos instruction. Keeping it
   scoped avoids introducing another parse inside multi-action choices. */
/* @sem Ability::Triggered{event:$event_planeswalk_to, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$temporary_chaos_action}]}} */
triggered_planeswalk_chaos ::= "when" event_planeswalk_to "," temporary_chaos_action "."

/* The counter quantity repeats the measured optional life payment. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Life($life_equal)]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:$life_equal}]}}]}, otherwise:Program{}}] */
clause_measured_life_payment_counters ::= "you" "may" "pay" life_equal "." "if" "you" "do" "," "put" "that" "many" counter_kind "counters" "on" affected

/* The event identifies the entering source, which another excludes below. */
/* @prefer always */
/* @sem Ability::Triggered{event:$event_self_enters, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$clause_optional_reveal_or_condition}} */
triggered_entry_optional_reveal_alternative ::= "when" event_self_enters "," clause_optional_reveal_or_condition "."

/* The payment and the independent alternative both feed the following branch. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$reveal_hand_payment, optional:true}}, If{condition:AnyOf([PaymentChosen(@marked), $condition_paid_alternative]), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_optional_reveal_or_condition ::= "you" "may" reveal_hand_payment "." "if" "you" "do" "or" "if" condition_paid_alternative "," conjoined

/* @sem Cost::Cost{parts:[$cost_reveal_filtered_hand_a]} */
reveal_hand_payment ::= cost_reveal_filtered_hand_a

/* The return captures the immediately preceding selection's exile arrival. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(Source)), $adjective_nontype, ObjectFilter::OwnedBy(One(AbilityController)), ObjectFilter::ControlledBy(One(AbilityController)))}, count:AnyNumber}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$selected_exile_return_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}}]} */
program_selected_exile_delayed_return ::= "exile" "any" "number" "of" "other" adjective_nontype "permanents" "you" "own" "and" "control" "." "return" "those" "cards" "to" "the" "battlefield" "at" selected_exile_return_event

selected_exile_return_event ::= delayed_move_any_end | delayed_move_any_upkeep

/* @prefer always */
/* @sem Ability::Triggered{event:$event_self_enters, limits:TriggerLimits{}, announcement:@announcement, body:$program_selected_exile_delayed_return} */
triggered_selected_exile_return ::= "when" event_self_enters "," program_selected_exile_delayed_return "."

/* The target is distinct from the player associated with the enclosing event. */
/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OthersThan(EventSubject)}), index:0} */
chosen_other_event_target ::= "choose" "another" "target" "player"

/* @sem Operation::DealDamage{source:$object_ref, recipients:Players(One($chosen_other_event_target)), amount:$value, preventable:true} */
damage_chosen_other_player ::= chosen_other_event_target "." object_ref "deals" "damage" "equal" "to" value "to" "the" "chosen" "player"

/* @sem Instruction::[Effect{result:@next, operation:$damage_chosen_other_player}] */
instructions_damage_chosen_other_player ::= damage_chosen_other_player

/* Each player independently chooses one of the two named word options. */
/* @sem Operation::ChooseValue{choosers:One(Bound(0)), kind:Word, terms:_{count:Exactly(Constant(1)), options:[Text($last_choice_word), Text($last_choice_word_2)]}} */
bound_choose_word_pair ::= "chooses" last_choice_word "or" last_choice_word

/* The threshold qualifies the activated ability, independently of the delayed body. */
/* @sem EventSpec::Activated{players:One(AbilityController), abilities:AllOf([Not(OnStack(Mana)), ManaSpent{comparison:GreaterOrEqual, value:$activation_spending_threshold}])} */
next_nonmana_activation_spending ::= "you" "next" "activate" "an" "ability" "that" "isn't" "a" "mana" "ability" "this" "turn" "by" "spending" activation_spending_threshold "or" "more" "mana" "to" "activate" "it"

activation_spending_threshold ::= activation_spending_words | activation_spending_value

/* @prefer always */
/* @sem $number_words */
activation_spending_words ::= number_words

/* @sem $value */
activation_spending_value ::= value

/* This event-relative copy spelling is confined to the delayed activation frame. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventStackObject, times:Constant(1), targets:May}}]} */
delayed_activation_copy_body ::= "copy" "that" "ability" "." "you" "may" "choose" "new" "targets" "for" "the" "copy"

delayed_activation_body ::= delayed_activation_copy_body | program

/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:$next_nonmana_activation_spending, start:Immediately, expires:EndOfTurn, body:$delayed_activation_body}}] */
instructions_delayed_activation ::= "when" next_nonmana_activation_spending "," delayed_activation_body

/* Successive third-person verbs after an explicit first action retain their
   independent operands and results. The subject was stated in that action. */
third_following_action ::= simultaneous_third_untap | third_put_single_counter

/* @sem Instruction::[Effect{result:@next, operation:$third_following_action}, Effect{result:@next, operation:$third_following_action_2}] */
third_following_pair ::= third_following_action "," "and" third_following_action

/* @sem Instruction::[Effect{result:@next, operation:$player_gains_control_of}, ...$third_following_pair] */
clause_control_followed_by_third_pair ::= player_gains_control_of "," third_following_pair

/* The loop's choices feed the following random selection. */
/* @sem Program::Program{instructions:[ForEachPlayer{players:$random_choice_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plain, ObjectFilter::ControlledBy(One(Bound(0))))}, count:AsManyAsCan(Constant(1))}}]}}, Effect{result:@next, operation:WithSelections{steps:[_{binding:0, chooser:Chance, objects:Selected(@prior), count:AsManyAsCan(Constant(1))}], action:Destroy{objects:Prepared(0), regeneration:true}}}]} */
program_sentence_each_random_destroy ::= "for" random_choice_players "," "choose" "a" filter_plain "that" "player" "controls" "." "destroy" "one" "of" "them" "chosen" "at" "random" "."

random_choice_players ::= players_each_opponent | players_each

/* A live requirement establishes the active player for the delayed clause. */
/* @sem Instruction::[Effect{result:@next, operation:$active_attack_requirement}, Effect{result:@next, operation:$active_nonattacker_delayed_destroy}] */
active_attack_delayed_instructions ::= active_attack_requirement "." NEWLINE active_nonattacker_delayed_destroy

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($plural, ObjectFilter::ControlledBy(One(Active)))}), changes:[Rule(RequireCombat{action:Attack(Any), amount:AtLeast(Constant(1))})], duration:$this_duration, evaluation:LiveObjects} */
active_attack_requirement ::= plural "the" "active" "player" "controls" "attack" this_duration "if" "able"

/* The exception belongs to the delayed destruction population, not the attack requirement. */
/* @sem Operation::CreateDelayedTrigger{event:$delayed_move_end_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($subtype_negated, ObjectFilter::@agree($plural, $noun), ObjectFilter::ControlledBy(One(Active)), $object_did_not_attack_turn, ObjectFilter::Not(Not(State(ControlledSinceTurnBegan))))}, regeneration:true}}]}} */
active_nonattacker_delayed_destroy ::= "at" delayed_move_end_event "," "destroy" "all" subtype_negated plural "that" "player" "controls" "that" object_did_not_attack_turn "." "ignore" "this" "effect" "for" "each" noun "the" "player" "didn't" "control" "continuously" "since" "the" "beginning" "of" "the" "turn"

/* This continuation is scoped to the adjacent singular battlefield arrival. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[GrantKeyword($keyword_name), GrantKeyword($keyword_name_2), GrantKeyword($keyword_name_3)], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:One(AbilityController)}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@back(4), phase:After, index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}, Effect{result:@next, operation:CreateReplacement{event:Object{event:LeavesBattlefield, objects:SameObject(Result{result:@back(5), phase:After, index:0})}, limit:UntilExpired, duration:WhileOnBattlefield(Result{result:@back(5), phase:After, index:0}), body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}}}] */
returned_three_keywords_delayed_exile_replacement ::= "it" "gains" keyword_name "," keyword_name "," "and" keyword_name "." "exile" "that" "card" "at" "the" "beginning" "of" "your" "next" "end" "step" "." "if" "it" "would" "leave" "the" "battlefield" "," "exile" "it" "instead" "of" "putting" "it" "anywhere" "else"

/* The producer establishes the arrival used by every continuation reference. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$random_graveyard_return}, ...$returned_three_keywords_delayed_exile_replacement]} */
random_return_three_keywords_exile_program ::= random_graveyard_return "." returned_three_keywords_delayed_exile_replacement

/* A resolution payment gates the independently composed return program. */
/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Mana($mana_symbols)]}, optional:true}}, If{condition:PaymentChosen(@marked), then:$random_return_three_keywords_exile_program, otherwise:Program{}}]}} */
triggered_paid_random_return ::= "at" turn_event "," "you" "may" "pay" mana_symbols "." "if" "you" "do" "," random_return_three_keywords_exile_program "."

/* A card chosen from any graveyard enters with an added card type. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$graveyard_entry_noun}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:$graveyard_added_card_type_entry}, qualifiers:[]}}] */
choose_graveyard_card_added_type ::= "you" "put" "a" graveyard_entry_noun "card" "from" "a" "graveyard" "onto" "the" "battlefield" "under" "your" "control" "." graveyard_added_card_type_entry

graveyard_entry_noun ::= noun_creature | noun_land | noun_planeswalker | noun_battle

graveyard_added_card_type_entry ::= graveyard_entry_artifact | graveyard_entry_enchantment

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[], states:[Changes([AddCardType(Artifact)])]} */
graveyard_entry_artifact ::= "it's" "an" "artifact" "in" "addition" "to" "its" "other" "types"

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[], states:[Changes([AddCardType(Enchantment)])]} */
graveyard_entry_enchantment ::= "it's" "an" "enchantment" "in" "addition" "to" "its" "other" "types"

/* @sem Instruction::[Effect{result:@next, operation:Mill{players:All, amount:$card_count}}] */
each_player_mill_cards ::= "each" "player" "mills" card_count

/* The normal action is performed on a loss and remains an option on a win. */
/* @sem Instruction::[Effect{result:@next, operation:Clash{actor:One(AbilityController), opponents:OpponentsOf(AbilityController), won:[Program{instructions:[ChooseOne{decider:AbilityController, options:[Program{instructions:[Effect{result:@next, operation:Move{objects:One($target_object), destination:$put_exiled_singular_destination, qualifiers:[]}}]}, Program{instructions:[Effect{result:@next, operation:$operation}]}]}]}], lost:[Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@next_slot, index:0}), destination:$put_exiled_singular_destination, qualifiers:[]}}]}]}}] */
shared_clash_replacement ::= "clash" "with" "an" "opponent" "," "then" "return" target_object "to" put_exiled_singular_destination "." "if" "you" "win" "," "you" "may" operation "instead"

/* One announced target in each opponent partition is the damage recipient. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Objects($opponent_chosen_creature_targets), amount:$greatest_controlled_stat, preventable:true}}] */
opponent_chosen_damage ::= "for" "each" "opponent" "," "choose" opponent_chosen_creature_targets "." self_explicit_ref "deals" "damage" "equal" "to" greatest_controlled_stat "to" "each" "of" "the" "chosen" "creatures"

/* The later creature anaphor is restricted to creature targets. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:OpponentsOf(AbilityController), each:UpTo(Constant(1))}, filter:CardType(Creature)})) */
opponent_chosen_creature_targets ::= "up" "to" "one" "target" "creature" "that" "player" "controls"

/* These consumers are used only within the library-exile receipt scope below. */
exile_receipt_filter ::= filter_phrase | adjective_nontype | adjective_color

/* @sem Instruction::Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$exile_receipt_filter}), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}} */
exile_receipt_named_token ::= "for" "each" exile_receipt_filter "card" "exiled" "this" "way" "," "create" "a" token_named_recipe "token"

/* @sem Instruction::Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$exile_receipt_filter})}} */
exile_receipt_draw ::= "for" "each" exile_receipt_filter "card" "exiled" "this" "way" "," "draw" "a" "card"

/* @sem Instruction::Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(OpponentsOf(AbilityController)), amount:Multiply([$number, CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$exile_receipt_filter})]), preventable:true}} */
exile_receipt_opponent_damage ::= "for" "each" exile_receipt_filter "card" "exiled" "this" "way" "," SELF_NAME "deals" number "damage" "to" "each" "opponent"

exile_receipt_consumer ::= exile_receipt_named_token | exile_receipt_draw | exile_receipt_opponent_damage

/* The producer and all three consumers share one face-up exile arrival. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:$exile_top_cards_of_your_library}, $exile_receipt_consumer, $exile_receipt_consumer_2, $exile_receipt_consumer_3]}} */
spell_exile_top_three_receipt_actions ::= exile_top_cards_of_your_library "." exile_receipt_consumer "." exile_receipt_consumer "." exile_receipt_consumer "."

/* The counter and suspend grant apply to the card exiled as the cast spell resolves. */
/* @sem Operand::Term{family:SpellEffect, form:AsResolves, operands:[List([Term{family:ResolveAction, form:ExileResolvingSpellWithNumberCountersOfTypeAndEffects, operands:[Number($resolving_time_amount), Vocabulary{family:CounterType, form:TimeCounter}, List([Term{family:ExiledCardEffect, form:AddAbility, operands:[Ability(Mechanic{mechanic:BasicSuspend})]}])]}])]} */
resolving_spell_exile_time_suspend ::= "with" resolving_time_amount "time" "counters" "on" "it" "instead" "of" "putting" "it" "into" "your" "graveyard" "as" "it" "resolves" "." "then" "if" "the" "exiled" "card" "doesn't" "have" "suspend" "," "it" "gains" "suspend"

/* The event is restricted to a spell cast from the controller's own hand. */
/* @sem Operation::EffectOn{subject:Objects(One(EventSubject)), effects:[$resolving_spell_exile_time_suspend]} */
cast_hand_spell_exile_time_suspend ::= "exile" "that" "card" resolving_spell_exile_time_suspend

/* @sem EventSpec::Filtered{event:$event_cast_from_hand, condition:ExistsPlayer{players:OpponentsOf(AbilityController), binding:0, condition:PlayerIsActive(Bound(0))}} */
cast_hand_during_opponent_turn ::= event_cast_from_hand "during" "an" "opponent's" "turn"

/* @sem Ability::Triggered{event:$cast_hand_during_opponent_turn, limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$cast_hand_spell_exile_time_suspend}]}} */
triggered_cast_hand_exile_time_suspend ::= "whenever" cast_hand_during_opponent_turn "," cast_hand_spell_exile_time_suspend "."

resolving_time_amount ::= resolving_time_amount_words | number_x

/* @prefer always */
/* @sem $count_plural */
resolving_time_amount_words ::= count_plural

/* The cast refers to the arrival of this single face-up exile action. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One($object_ref), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Result{result:@marked, phase:After, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}] */
exile_single_free_cast_receipt ::= "exile" object_ref "," "then" "you" "may" "cast" "the" "exiled" "card" "without" "paying" "its" "mana" "cost"

/* A required action may fail; its fallback owns the separate exile receipt. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:false}}, If{condition:Not(PaymentChosen(@prior)), then:Program{instructions:$exile_single_free_cast_receipt}, otherwise:Program{}}] */
required_action_exile_cast_fallback ::= payment "." "if" "you" "can't" "," exile_single_free_cast_receipt

/* The fight and its win trigger are scoped together: the latter's two
   references are exactly the first and second announced fighters. */
/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:$chosen_controlled_fighter, second:$chosen_other_fighter_uncontrolled}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Filtered{event:Object{event:LeavesBattlefield, objects:SameObject(Target{slot:1, index:0})}, condition:ObjectMatches{object:Target{slot:0, index:0}, filter:InZone(Shared(Battlefield))}}, start:Immediately, expires:UntilStateBasedActionsChecked, body:$program}}] */
controlled_fight_win_instructions ::= chosen_controlled_fighter "fights" chosen_other_fighter_uncontrolled "." "when" "the" "creature" "you" "control" "wins" "the" "fight" "," program

/* A fresh spell frame places these two targets in slots zero and one. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$controlled_fight_win_instructions}} */
controlled_fight_win_spell ::= controlled_fight_win_instructions "."

graveyard_return_arrival ::= graveyard_return_plain | graveyard_return_counter

/* @prefer always */
/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[], states:[]} */
graveyard_return_plain ::= "to" "the" "battlefield"

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[]} */
graveyard_return_counter ::= "to" "the" "battlefield" "with" "a" counter_kind "counter" "on" "it"

/* The possessive supplies the players whose graveyards form the population. */
/* @sem ObjectSet::Zone(_{scope:Players{zone:Graveyard, players:$shared_each_graveyard_owners}, kind:Card, filter:Any}) */
shared_each_graveyard_population ::= shared_each_graveyard_owners "graveyard"

shared_each_graveyard_owners ::= shared_each_opponent_graveyard_owner | shared_each_player_graveyard_owner

/* @sem PlayerSet::OpponentsOf(AbilityController) */
shared_each_opponent_graveyard_owner ::= "each" "opponent's"

/* @sem PlayerSet::All */
shared_each_player_graveyard_owner ::= "each" "player's"

/* The mill and subsequent independent graveyard movement retain their separate operands. */
/* @sem Vec<Instruction>::[Effect{result:@next, operation:Mill{players:$players_singular, amount:$mill_third_amount}}, Effect{result:@next, operation:Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
instructions_mill_then_own_graveyard_exile ::= players_singular "mills" mill_third_amount "." "then" "exile" "your" "graveyard"

/* A preceding action and a separate optional controlled-permanent return. */
/* @sem Vec<Instruction>::@then_sequence($clause_before_then, $optional_controlled_return) */
instructions_then_optional_controlled_return ::= clause_before_then "," "then" optional_controlled_return

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:$return_one_permanent_action}}] */
optional_controlled_return ::= "you" "may" return_one_permanent_action

/* Counter placements on a target qualified by the source’s crew history. */
source_crew_counter_action ::= source_crew_counter_singular | source_crew_counter_plural

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(One($source_crewed_target)), kind:$counter_kind, amount:$counter_amount}]} */
source_crew_counter_singular ::= "put" counter_amount counter_kind "counter" "on" source_crewed_target

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(One($source_crewed_target)), kind:$counter_kind, amount:$counter_amount}]} */
source_crew_counter_plural ::= "put" counter_amount counter_kind "counters" "on" source_crewed_target

/* The pair and the single sacrifice make the remaining target singular. */
/* @sem @target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(2)), filter:$plural, constraints:[CommonProperty(Controllers)]}) */
same_controller_target_pair ::= "two" "target" plural "controlled" "by" "the" "same" "player"

/* @sem Instruction::[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(ControllerOf(Target{slot:$same_controller_target_pair, index:0})), objects:Targets($same_controller_target_pair), choose:AsManyAsCan(Constant(1))})}] */
common_controller_pair_sacrifice ::= "choose" same_controller_target_pair "." "their" "controller" "chooses" "and" "sacrifices" "one" "of" "them"

/* This continuation is only used after that two-target, one-sacrifice phrase. */
/* @sem Operation::Move{objects:Targets(@last_slot), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_remaining_target_owner_hand ::= "return" "the" "other" "to" "its" "owner's" "hand"

/* @sem Instruction::[...$common_controller_pair_sacrifice, Effect{result:@next, operation:$return_remaining_target_owner_hand}] */
instructions_pair_sacrifice_return ::= common_controller_pair_sacrifice "." return_remaining_target_owner_hand

/* The event identifies the holder before the linked population is named; the
   condition and the anaphoric play both refer to that same source link. */
/* @sem Ability::Triggered{event:$linked_holder_event, intervening_if:Compare{left:CountObjects(Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, limits:TriggerLimits{}, announcement:@announcement, body:$linked_exile_play_program} */
triggered_holder_linked_exile_play ::= "whenever" linked_holder_event "," "if" "there" "are" "cards" "exiled" "with" "it" "," linked_exile_play_program

/* @sem EventSpec::Damage(DamageEvent{source_kind:Permanent, sources:$event_self, recipients:Players($combat_damage_player_set), kind:Combat, grouping:SourceRecipient, subject:Source}) */
linked_holder_combat_event ::= event_self "deals" "combat" "damage" "to" combat_damage_player_set

/* @sem EventSpec::Object{event:Attacks, objects:$event_self} */
linked_holder_attack_event ::= event_self "attacks"

linked_holder_event ::= linked_holder_combat_event | linked_holder_attack_event

/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:Either, cards:Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}, count:Exactly(Constant(1)), cost:Free}}]}}]} */
linked_exile_play_free_one ::= "you" "may" "play" "one" "of" "them" "without" "paying" "its" "mana" "cost" "."

/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:Either, cards:Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}, count:Exactly($count_plural), cost:Free}}]}}]} */
linked_exile_play_free_many ::= "you" "may" "play" count_plural "of" "them" "without" "paying" "their" "mana" "costs" "."

/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:Either, cards:Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}, count:Exactly(Constant(1)), cost:Normal}}]}}]} */
linked_exile_play_normal_one ::= "you" "may" "play" "one" "of" "them" "."

linked_exile_play_program ::= linked_exile_play_free_one | linked_exile_play_free_many | linked_exile_play_normal_one

/* A bound player chooses a card from that player's own graveyard. */
/* @sem Operation::ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:$filter_phrase}, count:AsManyAsCan($counter_a)} */
bound_selects_graveyard_card ::= "chooses" counter_a filter_phrase "card" "in" "their" "graveyard"

/* @sem Operation::ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:$filter_phrase}, count:AsManyAsCan($count_plural)} */
bound_selects_graveyard_cards ::= "chooses" count_plural filter_phrase "cards" "in" "their" "graveyard"

bound_selects_graveyard ::= bound_selects_graveyard_card | bound_selects_graveyard_cards

/* The destination is an independently printable movement operand. */
/* @sem $battlefield_control_yours */
selected_cards_battlefield_destination ::= "put" "those" "cards" "onto" "the" "battlefield" battlefield_control_yours

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_selects_graveyard}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$selected_cards_battlefield_destination, qualifiers:[]}}]}} */
spell_each_graveyard_selection_move ::= players_singular bound_selects_graveyard "." selected_cards_battlefield_destination "."

/* @sem Operation::CreateReplacement{event:$filtered_combat_damage_would_deal, limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevent_all_filtered_damage ::= "prevent" "all" filtered_combat_damage_would_deal this_duration

/* The event subject is duplicated once, and its hand arrival is the following receipt. */
/* @sem Operation::Conjure{actor:One(AbilityController), card:Duplicate(One(EventSubject)), count:Constant(1), destination:Hand(CardArrival{counters:[], states:[]})} */
conjure_event_subject_duplicate_hand ::= "conjure" "a" "duplicate" "of" "it" "into" "your" "hand"

/* The immediately preceding singular hand conjure supplies the modified object. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$conjure_event_subject_duplicate_hand}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$static_changes}}]} */
program_conjure_duplicate_perpetual_sentence ::= conjure_event_subject_duplicate_hand "." "the" "duplicate" "perpetually" static_changes "."

/* Random selection and exile are one action; the move records its own arrival. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:@and($adjective_nontype, $filter_phrase, $lesser_event_mana_value)}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
random_lesser_library_exile ::= "exile" "a" "random" adjective_nontype filter_phrase "card" lesser_event_mana_value "from" "your" "library"

/* @prefer always */
/* @sem Instruction::[...$random_lesser_library_exile, Effect{result:@next, operation:$cast_that_card_permission}] */
instructions_random_lesser_exile_followup ::= random_lesser_library_exile "." cast_that_card_permission

/* Each player selects a distinct eligible permanent, beginning with the controller.
   Both descriptions must denote the same population for the loop to represent them. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, starting_with:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseValue{choosers:One(Bound(0)), kind:Object, terms:_{options:[Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($filter_phrase, $filter_phrase_2), ControlledBy(OthersThan(Bound(0)))])})], unchosen:true, count:Exactly(Constant(1))}}}]}}] */
instructions_other_control_choice ::= "choose" "a" filter_phrase "you" "don't" "control" "," "then" "each" "other" "player" "chooses" "a" filter_phrase "they" "don't" "control" "that" "hasn't" "been" "chosen" "this" "way"

/* @sem Instruction::[...$instructions_other_control_choice, Effect{result:@next, operation:$earlier_unselected_action}] */
instructions_other_control_choice_more ::= instructions_other_control_choice "." earlier_unselected_action

earlier_unselected_action ::= destroy_earlier_unselected | tap_earlier_unselected

/* @sem Operation::Destroy{objects:$destroy_other_earlier_selected, regeneration:true} */
destroy_earlier_unselected ::= "destroy" destroy_other_earlier_selected

/* @sem Operation::SetTapped{objects:$destroy_other_earlier_selected, tapped:true} */
tap_earlier_unselected ::= "tap" destroy_other_earlier_selected

/* The chooser controls the chosen population, and each selected permanent returns to its own owner. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:OneOf(OpponentsOf(AbilityController)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(OneOf(OpponentsOf(AbilityController))))])}, count:UpTo($count_plural)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_opponent_choose_controlled_return ::= "an" "opponent" "chooses" "up" "to" count_plural filter_plural "they" "control" "and" "returns" "them" "to" "their" "owner's" "hand"

/* A plural destruction retains its population as an operand. */
/* @sem Operation::Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, regeneration:true} */
operation_destroy_all_filtered ::= "destroy" "all" filter_plural

/* A paid-cost conditional ends before the next paragraph's destruction. */
/* @sem Vec<Instruction>::@returned_conditional([@leading_if(Instruction::If{condition:$condition_alternative_mana_paid, then:Program{instructions:$conjoined}, otherwise:Program{}})]) */
paid_condition_conjoined ::= "if" condition_alternative_mana_paid "," conjoined

/* @sem Vec<Instruction>::[...$paid_condition_conjoined, Effect{result:@next, operation:$operation_destroy_all_filtered}] */
instructions_paid_condition_destroy_paragraph ::= paid_condition_conjoined "." NEWLINE operation_destroy_all_filtered /* @prefer always */

/* A spell may use this same paid-condition and independent destruction composition. */
/* @prefer always */
/* @sem Ability::[Spell{announcement:@announcement, body:Program{instructions:$instructions_paid_condition_destroy_paragraph}}] */
line_paid_condition_destroy_paragraph ::= instructions_paid_condition_destroy_paragraph "."

/* The cast population is the immediately preceding mill's cards. */
/* @sem Instruction::[Effect{result:@next, operation:Mill{players:One(AbilityController), amount:$card_count}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Earlier{what:Milled}, filter:AllOf([$milled_cast_kind, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}])}, count:Exactly(Constant(1)), terms:_{cost:Free}}}]}}] */
instructions_mill_cast_capped ::= "mill" card_count "." "you" "may" "cast" "an" milled_cast_kind "spell" "with" "mana" "value" number "or" "less" "from" "among" "them" "without" "paying" "its" "mana" "cost"

milled_cast_kind ::= milled_cast_pair | milled_instant_enchantment | spell_instant

/* @sem ObjectFilter::AnyOf([$milled_cast_first, $milled_cast_second]) */
milled_cast_pair ::= milled_cast_first "or" milled_cast_second

milled_cast_first ::= spell_instant | noun_artifact

milled_cast_second ::= spell_sorcery | noun_enchantment

/* @prefer always */
/* @sem ObjectFilter::AnyOf([CardType(Instant), CardType(Enchantment)]) */
milled_instant_enchantment ::= "instant" "or" "enchantment"

/* The choice, its payment test and both attachment outcomes share one receipt. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:ControllerOf(EventSubject), cost:_{parts:[PlayerAction{player:ControllerOf(EventSubject), body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:ControllerOf(EventSubject), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$aura_return_creature_filter, CouldBeEnchantedBy(AuraAfterEnchantedLeft{aura:Source, host:EventSubject})])}, count:AsManyAsCan(Constant(1))}}]}}]}}}, If{condition:PaymentChosen(@prior), then:_{instructions:[Effect{result:@next, operation:Move{objects:One(@return_ref(@self)), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo(Result{result:@prior, phase:After, index:0})]}}, qualifiers:[]}}]}, otherwise:_{instructions:[Effect{result:@next, operation:Move{objects:One(@return_ref(@self)), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[NotAnAura]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[LosesAbility(Term{family:CheckHasable, form:Enchant, operands:[Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$aura_enchant_loss_filter})]}), GrantAbility(@scope($aura_return_upkeep_trigger))], duration:Indefinite, evaluation:Snapshot}}]}}]} */
aura_controller_choice_return ::= "that" "creature's" "controller" "chooses" "a" aura_return_creature_filter "that" "this" "card" "could" "enchant" "." "if" "the" "player" "does" "," "return" "this" "card" "to" "the" "battlefield" "under" "your" "control" "attached" "to" "that" "creature" "." "if" "they" "don't" "," "return" "this" "card" "to" "the" "battlefield" "under" "your" "control" "as" "a" "non-Aura" "enchantment" "." "it" "loses" '"' "↓" "enchant" aura_enchant_loss_filter '"' "and" "gains" '"' aura_return_upkeep_trigger '"'

/* @sem Ability::Triggered{event:Turn{point:UpkeepBegins, players:One(ControllerOf(Scoped))}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(One(EventSubject)), amount:$number, preventable:true}}]}} */
aura_return_upkeep_trigger ::= "at" "the" "beginning" "of" "that" "player's" "upkeep" "," "this" "enchantment" "deals" number "damage" "to" "that" "player" "."

/* @sem Ability::Triggered{event:$kin_enchanted_creature_death, limits:_{}, announcement:@announcement, body:$aura_controller_choice_return} */
trigger_aura_controller_choice_return ::= "when" kin_enchanted_creature_death "," aura_controller_choice_return

aura_enchant_loss_filter ::= noun

/* The controller change applies to the same announced opponent-controlled permanent. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(OpponentsOf(AbilityController))])}), index:0})}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:0, index:0})), changes:[SetController(AbilityController)], duration:$duration, evaluation:Snapshot}}] */
shared_untap_opponent_control ::= "untap" "target" "creature" "an" "opponent" "controls" "and" "gain" "control" "of" "it" duration

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:0, index:0})), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}] */
shared_target_creature_keyword ::= "that" "creature" "gains" keyword_name duration

/* The delayed action observes loss of control of the previously announced target. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:Player{event:LosesControl, players:One(AbilityController), objects:SameObject(Target{slot:0, index:0})}, duration:Indefinite, body:_{instructions:[Effect{result:@next, operation:SetTapped{objects:One(EventSubject), tapped:true}}]}, once:true, announcement:_{}}}] */
shared_target_control_loss_tap ::= "when" "you" "lose" "control" "of" "the" "creature" "," "tap" "it"

/* @sem Ability::Spell{body:_{instructions:[...$shared_untap_opponent_control, ...$shared_target_creature_keyword, ...$shared_target_control_loss_tap]}, announcement:@announcement} */
shared_untap_control_loss_spell ::= shared_untap_opponent_control "." shared_target_creature_keyword "." shared_target_control_loss_tap "."

/* A chosen opponent and the controller perform the same token creation. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_opponent}, Effect{result:@next, operation:@apply(PlayerSet::Union([One(AbilityController), One(Chosen)]), $create_base)}] */
chosen_opponent_shared_create ::= choose_opponent "." "you" "and" "that" "player" "each" create_base

/* Each life gain counts its own player's matching permanents. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_opponent}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:Multiply($number_digits, CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController))])}))}}, Effect{result:@next, operation:GainLife{players:One(Chosen), amount:Multiply($number_digits_2, CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase_2, ControlledBy(One(Chosen))])}))}}] */
chosen_opponent_counted_life ::= choose_opponent "." "you" "gain" number_digits "life" "for" "each" filter_phrase "you" "control" "and" "that" "player" "gains" number_digits "life" "for" "each" filter_phrase "they" "control"

/* Consecutive choices each govern only their own instruction group. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$chosen_opponent_shared_create, ...$chosen_opponent_counted_life]}} */
spell_chosen_shared_create_counted_life ::= chosen_opponent_shared_create "." NEWLINE chosen_opponent_counted_life "."

/* Each player independently chooses a card from their own hand. */
/* @sem Instruction::[ForEachPlayer{players:$hand_entry_loop_players, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:$bound_hand_entry_program}]}}] */
clause_each_optional_hand_entry_singular ::= hand_entry_loop_players "may" bound_hand_entry_program

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:$bound_hand_entry_plural_program}]}}] */
clause_each_optional_hand_entry_plural ::= players_singular "may" bound_hand_entry_plural_program

/* Three separately targeted placements retain their distinct eligibility and counter operands. */
/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_phrase}), index:0})), kind:$counter_kind, amount:Constant(1)}, _{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(SameObject(Target{slot:0, index:0})), $filter_phrase_2])}), index:0})), kind:$counter_kind_2, amount:$count_plural}, _{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(SameObject(Target{slot:0, index:0})), Not(SameObject(Target{slot:1, index:0})), $filter_phrase_3])}), index:0})), kind:$counter_kind_3, amount:$count_plural_2}]}}] */
clause_counters_three_distinct_targets ::= "put" "a" counter_kind "counter" "on" "target" filter_phrase "," count_plural counter_kind "counters" "on" "another" "target" filter_phrase "," "and" count_plural counter_kind "counters" "on" "a" "third" "target" filter_phrase

/* A named singular population and its payment terms compose independently. */
/* @sem Operation::PlayWith{actor:One(AbilityController), action:CastSpell, cards:$cast_named_population, count:Exactly(Constant(1)), terms:_{cost:$cast_named_payment}} */
cast_single_named_population ::= "cast" cast_named_population cast_named_payment

/* @sem ObjectSet::Zone{scope:Shared(Command), kind:Card, filter:$noun_commander} */
cast_named_population ::= "your" noun_commander "from" "the" "command" "zone"

cast_named_payment ::= cast_named_payment_free | cast_named_payment_normal | cast_alternative_terms

/* @sem PlayCost::Free */
cast_named_payment_free ::= "without" "paying" "its" "mana" "cost"

/* @sem PlayCost::Normal */
cast_named_payment_normal ::= "by" "paying" "its" "mana" "cost"

/* A targeted player can copy the event spell and choose the copy's targets. */
/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:UpTo(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0} */
up_to_one_copy_opponent ::= "up" "to" "one" "target" "opponent"

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:UpTo(Constant(1)), filter:Any, players:All}), index:0} */
up_to_one_copy_player ::= "up" "to" "one" "target" "player"

copy_event_optional_target ::= up_to_one_copy_opponent | up_to_one_copy_player

/* @sem Expr::Constant(1) */
event_spell_copy_once_targets ::= "copy" "that" "spell" "." "they" "may" "choose" "new" "targets" "for" "that" "copy" "."

/* @sem Expr::Constant(2) */
event_spell_copy_twice_targets ::= "copy" "that" "spell" "twice" "." "they" "may" "choose" "new" "targets" "for" "those" "copies" "."

event_spell_copy_count_targets ::= event_spell_copy_once_targets | event_spell_copy_twice_targets

/* @sem Program::Program{instructions:[Optional{decider:$copy_event_optional_target, body:Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One($copy_event_optional_target), object:EventSubject, times:$event_spell_copy_count_targets, targets:May}}]}}]} */
copy_event_target_optional_program ::= copy_event_optional_target "may" "also" event_spell_copy_count_targets

/* @sem Ability::Triggered{event:$spell_retarget_event, limits:TriggerLimits{}, announcement:@announcement, body:$copy_event_target_optional_program} */
triggered_event_target_optional_copy ::= "whenever" spell_retarget_event "," copy_event_target_optional_program

/* The return exclusion and the condition refer to the immediately preceding sacrifice. */
/* @sem Instruction::[Effect{result:@next, operation:@sacrificed_result($sacrifice_each_choice_scoped)}, If{condition:Compare{left:CountObjects(Matching{objects:MovedBy{result:@prior, phase:Before, player:AbilityController}, filter:$sacrifice_receipt_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$return_other_sacrificed_card}]}}]}, otherwise:Program{}}] */
instructions_each_sacrifice_return_other ::= sacrifice_each_choice_scoped "." "if" "you" "sacrificed" sacrifice_receipt_filter "this" "way" "," "you" "may" return_other_sacrificed_card

sacrifice_each_choice_scoped ::= sacrifice_each_choice_scoped_a | sacrifice_each_choice_scoped_an

/* @sem Operation::Sacrifice{players:All, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Constant(1))} */
sacrifice_each_choice_scoped_a ::= "each" "player" "sacrifices" "a" filter_phrase "of" "their" "choice"

/* @sem Operation::Sacrifice{players:All, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Constant(1))} */
sacrifice_each_choice_scoped_an ::= "each" "player" "sacrifices" "an" filter_phrase "of" "their" "choice"

/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Difference{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$return_other_card_filter}, excluding:One(Recorded{result:@prior})}, count:Exactly(Constant(1)), constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}} */
return_other_sacrificed_card ::= "return" "another" return_other_card_filter "card" "from" "your" "graveyard" "to" "your" "hand"

return_other_card_filter ::= chosen_permanent_card_filter | card_filter

owned_exile_selection_population ::= owned_counter_card_from_exile | owned_linked_exile_selection_population

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(One(AbilityController)), ExiledWith($object_ref)])} */
owned_linked_exile_selection_population ::= "you" "own" "exiled" "with" object_ref

/* The optional choice scopes exactly this selection and movement. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Group{instructions:$put_selected_owned_exile_into_hand}]}}]} */
program_optional_owned_exile_selection ::= "you" "may" put_selected_owned_exile_into_hand

/* An independently described population loses goad status. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Ungoad, objects:$affected_controlled_each} */
ungoad_each_action ::= affected_controlled_each "is" "no" "longer" "goaded"

/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$have_damage_dealer, recipients:$damage_recipient_pair, amount:$value, preventable:true}}] */
clause_have_equal_damage ::= have_damage_dealer "damage" "equal" "to" value "to" damage_recipient_pair

/* @sem Recipients::Union([$recipients, $recipients_2]) */
damage_recipient_pair ::= recipients "and" recipients

/* This source-linked population is distinct from a creation receipt in the
   current ability. Its use is restricted to the holder-departure trigger. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$event_source_token_subject} */
source_linked_token_population ::= event_source_token_subject

source_linked_token_action ::= source_linked_token_exile | source_linked_token_tap | source_linked_token_untap

/* @sem Operation::Move{objects:$source_linked_token_population, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]} */
source_linked_token_exile ::= "exile" source_linked_token_population

/* @sem Operation::SetTapped{objects:$source_linked_token_population, tapped:true} */
source_linked_token_tap ::= "tap" source_linked_token_population

/* @sem Operation::SetTapped{objects:$source_linked_token_population, tapped:false} */
source_linked_token_untap ::= "untap" source_linked_token_population

/* The trigger scopes the source-linked anaphor away from local creation receipts. */
/* @sem Ability::Triggered{event:$event_self_leaves, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$source_linked_token_action}]}} */
source_leaves_token_action_trigger ::= "when" event_self_leaves "," source_linked_token_action "."

/* The counted population is shared by cast-trigger copy effects. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, property:$copy_distinct_property}, targets:May}}]} */
cast_subject_copy_counter_kinds ::= "copy" "it" "for" "each" copy_distinct_property "among" filter_plural "." "you" "may" "choose" "new" "targets" "for" "the" "copies" "."

/* @sem DistinctProperty::CounterTypes */
copy_distinct_counter_kind ::= "kind" "of" "counter"

/* @sem DistinctProperty::Powers */
copy_distinct_power ::= "different" "power"

copy_distinct_property ::= copy_distinct_counter_kind | copy_distinct_power

/* The mill and return share the actual transition receipt and destination. */
/* @prefer always */
/* @sem Vec<Instruction>::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$milled_among_indefinite}, count:Exactly(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
mill_optional_return_among_them ::= "mill" card_count "." "you" "may" "put" milled_among_indefinite "card" "from" "among" "them" "into" "your" "hand"

/* A resolution-time test of the spell's cast ordinal, followed by any program. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$mill_optional_return_among_them, If{condition:$resolution_first_spell_game, then:$program, otherwise:Program{}}]}} */
spell_mill_return_first_spell_game ::= mill_optional_return_among_them "." "if" resolution_first_spell_game "," program "."

/* The hand observation and the following condition consume the same receipt. */
/* @sem Instruction::[Effect{result:@next, operation:$reveal_own_counted_hand}, If{condition:$observed_card_shared_name_condition, then:_{instructions:[Effect{result:@next, operation:$observed_card_battlefield_move}]}, otherwise:_{}}] */
instructions_hand_reveal_shared_name_entry ::= reveal_own_counted_hand "," "then" observed_card_battlefield_move "if" observed_card_shared_name_condition

/* @sem Operation::Move{objects:One(Query{objects:Observed(@prior), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
observed_card_battlefield_move ::= "put" "that" "card" "onto" "the" "battlefield"

/* A cast event's creature spell receives an entry modification. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChangeSpell{subject:One(EventSubject), changes:$spell_entry_counter_change}}]} */
cast_creature_entry_counter_program ::= "that" "creature" spell_entry_counter_change "."

/* The source of control and the object whose tapped state sustains it coincide. */
/* @sem Operation::CreateContinuousEffect{source:$object_ref, affected:Objects(One($relative_control_target)), changes:[SetController(AbilityController)], duration:WhileMatches{object:$object_ref, filter:Tapped}, evaluation:Snapshot} */
gain_control_while_tapped ::= "gain" "control" "of" relative_control_target "for" "as" "long" "as" object_ref "remains" "tapped"

/* A singular relative clause qualifies the announced battlefield target. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_singular_relative_modified}), index:0} */
relative_control_target ::= "target" filter_singular_relative_modified

mana_count_each ::= count_each | count_each_drawn_card

/* A condition selects a complete alternative third-person instruction. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:$clause_third_2}, otherwise:Program{instructions:$clause_third}}] */
instructions_third_conditional_instead ::= clause_third "." "if" condition "," clause_third "instead"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_third_conditional_instead}} */
spell_third_conditional_instead ::= instructions_third_conditional_instead "."

/* A target action and its postposed test share the announced object. */
/* @sem Operation::Destroy{objects:One($target_object), regeneration:true} */
conditional_target_action ::= "destroy" target_object

/* @sem Instruction::[If{condition:AnyOf([ObjectMatches{object:Target{slot:@last_slot, index:0}, filter:$conditional_permanent_kind}, $conditional_alternative_test]), then:Program{instructions:[Effect{result:@next, operation:$conditional_target_action}]}, otherwise:Program{}}] */
conditional_target_action_or_test ::= conditional_target_action conditional_permanent_kind "or" "if" conditional_alternative_test

conditional_alternative_test ::= conditional_green_pair_spent | condition_one

/* Distinct colors each contribute one mana; same-color pairs need a different threshold. */
/* @sem Condition::AllOf([Compare{left:ManaSpent{object:$spent_spell, filter:_{colors:[Green]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, Compare{left:ManaSpent{object:$spent_spell, filter:_{colors:[$conditional_green_pair_second]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}]) */
conditional_green_pair_spent ::= "{" "G" "}" "{" conditional_green_pair_second "}" "was" "spent" "to" "cast" spent_spell

conditional_green_pair_second ::= red_pair_white | red_pair_blue | red_pair_black | conditional_green_pair_red

/* @sem ManaColor::Red */
conditional_green_pair_red ::= "R"

return_battlefield_choice ::= return_counted_battlefield_choice | return_other_battlefield_choice

/* @prefer always */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan($counter_amount)} */
return_counted_battlefield_choice ::= counter_amount filter_phrase

/* @prefer always */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(EventSubject)), $filter_phrase])}, count:AsManyAsCan(Constant(1))} */
return_other_battlefield_choice ::= "another" filter_phrase

/* Banding is an ability option with its own mechanic identity. */
/* @sem Operand::Ability(Ability::Mechanic{mechanic:Banding}) */
choice_banding_option ::= "banding"

/* A single optional other target returns to its owner's hand. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@another_target_reference(ObjectFilter::$filter_phrase))), $filter_phrase)})) */
optional_other_battlefield_target ::= "up" "to" "one" "other" "target" filter_phrase

/* @sem Operation::Move{objects:$optional_other_battlefield_target, destination:OwnersHand(CardArrival{}), qualifiers:[]} */
return_other_optional_hand ::= "return" optional_other_battlefield_target "to" "its" "owner's" "hand"

/* @sem ObjectFilter::Token */
returned_token_kind ::= "token"

/* The conditional tests the before incarnation of the immediately returned object. */
/* @sem Instruction::[Effect{result:@next, operation:$return_other_optional_hand}, If{condition:ObjectMatches{object:Result{result:@prior, phase:Before, index:0}, filter:$returned_token_kind}, then:$program, otherwise:Program{}}] */
instructions_return_other_nonkind_receipt ::= return_other_optional_hand "." "if" "it" "was" "a" returned_token_kind "," program

/* The delayed return is bound to the hand exile immediately before it. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:$returnable_hand_exile}, Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_move_end_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:$operation}]}}}] */
instructions_face_down_hand_delayed_return ::= returnable_hand_exile "." "at" delayed_move_end_event "," "return" "those" "cards" "to" "your" "hand" "," "then" operation

returnable_hand_exile ::= exile_all_hand_face_down | returnable_hand_exile_face_up

/* @sem Operation::Move{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
returnable_hand_exile_face_up ::= "exile" "all" "cards" "from" "your" "hand"

/* Keep the goad producer adjacent to its affected-creature power receipt. */
/* @sem Instruction::[Effect{result:@next, operation:$opponent_goad_receipt_producer}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:Aggregate{objects:Affected(@prior), property:Power, aggregation:Sum}}]}}] */
instructions_goad_power_counter_receipt ::= opponent_goad_receipt_producer "." "put" "X" counter_kind "counters" "on" affected "," "where" "X" "is" "the" "total" "power" "of" "creatures" "goaded" "this" "way"

/* The producer fixes the action independently of the receipt's consumer. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Goad{}, objects:$opponent_keyword_targets} */
opponent_goad_receipt_producer ::= "for" "each" "opponent" "," "goad" opponent_keyword_targets

/* The second group is distinct from the first announced target. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamageParts{source:$damage_range_source, parts:[_{recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any})), amount:$number}, _{recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:UpTo($damage_range_count), filter:Any, constraints:[DifferentFromTarget(0)]})), amount:$number_2}], preventable:true}}] */
clause_damage_distinct_range ::= damage_range_source "deals" number "damage" "to" "any" "target" "and" number "damage" "to" "each" "of" "up" "to" damage_range_count "other" "targets"

damage_range_source ::= damage_range_named | damage_source_ref

/* @prefer always */
/* @sem ObjectRef::$self_ref_named */
damage_range_named ::= self_ref_named

damage_range_count ::= n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10 | n11 | n12 | n13 | n14 | n15 | n20 | n30 | number_hundred

/* The same plural change applies independently to each zone population. */
/* @sem Instruction::[Effect{result:@next, operation:CreatePerpetualEffect{objects:$perpetual_filtered_battlefield, changes:$plural_private_pump}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:$perpetual_hand_cards, changes:$plural_private_pump}}] */
paired_perpetual_populations ::= perpetual_filtered_battlefield "and" perpetual_hand_cards "perpetually" plural_private_pump

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural} */
perpetual_filtered_battlefield ::= filter_plural

sacrifice_reveal_card_kind ::= card_permanent | noun_creature | noun_land | noun_planeswalker | noun_battle

/* A postposed next-turn upkeep delays the complete stated action. The
   controller reference in the optional body is the preceding target. */
/* @sem Instruction::[Optional{decider:ControllerOf(Target{slot:@last_slot, index:0}), body:Program{instructions:[Effect{result:@next, operation:DrawUpTo{players:One(ControllerOf(Target{slot:@last_slot, index:0})), amount:$number}}]}}] */
next_turn_target_controller_may_draw ::= "its" "controller" "may" "draw" "up" "to" number "cards"

/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:UpkeepBegins, players:All}, start:NextTurn, body:Program{instructions:$next_turn_target_controller_may_draw}}}] */
next_turn_controller_delay ::= next_turn_target_controller_may_draw "at" "the" "beginning" "of" "the" "next" "turn's" "upkeep"

/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:UpkeepBegins, players:All}, start:NextTurn, body:Program{instructions:$clause_you}}}] */
next_turn_you_delay ::= clause_you "at" "the" "beginning" "of" "the" "next" "turn's" "upkeep"

/* Compose an announced counter with independently delayed instructions. */
/* @sem Ability::[Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$counter_shared}, ...$next_turn_controller_delay, ...$next_turn_you_delay]}}] */
line_counter_delayed_instructions ::= counter_shared "." next_turn_controller_delay "." NEWLINE next_turn_you_delay "."

/* A prior operation establishes the referent of a following characteristic change and restriction. */
/* @sem Instruction::[Effect{result:@next, operation:$operation}, ...$pronoun_characteristic_activation_ban] */
instructions_operation_characteristic_activation_ban ::= operation "." pronoun_characteristic_activation_ban

/* A created host is bound for the optional attachment action in each iteration. */
/* @sem Instruction::[ForEachObject{objects:$attach_loop_created, binding:0, body:$optional_chosen_attachment_body}] */
clause_created_each_optional_attachment ::= attach_loop_created "," optional_chosen_attachment_body

/* @sem Program::_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:AttachChosen{actor:One(AbilityController), attachments:$affected, count:Exactly($counter_amount), hosts:One(Bound(0))}}]}}]} */
optional_chosen_attachment_body ::= "you" "may" "attach" counter_amount affected "to" "it"

/* The payment measures the card in the enclosing graveyard event. */
/* @sem Cost::Cost{parts:[Life(Earlier{what:PutInGraveyard, measure:Of(ManaValue)})]} */
graveyard_event_mana_value_life_cost ::= "pay" "life" "equal" "to" "its" "mana" "value"

/* The event's arrival remains in the graveyard until this move resolves. */
/* @sem Operation::Move{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), destination:$battlefield_control, qualifiers:[]} */
put_event_graveyard_it ::= "put" "it" "onto" "the" "battlefield" battlefield_control

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$graveyard_event_mana_value_life_cost, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:@arrival_changes($put_event_graveyard_it, $entry_subtype_changes)}]}, otherwise:Program{}}]} */
graveyard_event_paid_entry ::= "you" "may" graveyard_event_mana_value_life_cost "." "if" "you" "do" "," put_event_graveyard_it "." entry_subtype_changes

/* Entry characteristics and granted activation describe the object arriving from
   the immediately preceding move; the lens keeps the destination together. */
/* @sem Change::[SetCardTypes([Land]), SetName($entry_land_name), GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program}))] */
entry_named_land_she_activated ::= "she's" "a" "land" "named" entry_land_name "." "she" "gains" '"' cost ":" program "." '"'

/* @sem String::'Moon' */
entry_land_moon_name ::= "Moon"

entry_land_name ::= entry_land_moon_name | referenced_card_name

/* @sem Program::Program{instructions:[Effect{result:@next, operation:@arrival_changes($move_battlefield_tapped, $entry_named_land_she_activated)}]} */
program_return_tapped_named_land ::= move_battlefield_tapped "." entry_named_land_she_activated

/* The prior color choice supplies the color; the amount remains an operand. */
/* @sem ManaProduction::Amount{color:Chosen, amount:$value} */
mana_previously_chosen_color ::= value "mana" "of" "that" "color"

/* Ownership and keyword independently restrict the announced exile target. */
/* @prefer always */
/* @sem Operation::Move{objects:$owned_exiled_keyword_target, destination:$owned_exiled_return_destination, qualifiers:[]} */
return_owned_exiled_keyword ::= "return" owned_exiled_keyword_target owned_exiled_return_destination

/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
owned_exiled_return_hand ::= "to" "your" "hand"

/* @sem MovementDestination::OwnersGraveyard(CardArrival{counters:[], states:[]}) */
owned_exiled_return_graveyard ::= "to" "your" "graveyard"

owned_exiled_return_destination ::= owned_exiled_return_hand | owned_exiled_return_graveyard

/* The actor is the referred permanent’s controller; the object choice remains independent. */
/* @sem Instruction::[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One($its_controller_pronoun), objects:$another_referred_permanent, choose:AsManyAsCan(Constant(1))})}] */
clause_its_controller_sacrifice_another ::= its_controller_pronoun "sacrifices" another_referred_permanent "of" "their" "choice"

/* The attacking event identifies the defending player's graveyard; the target and arrival are independent. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($noun, ObjectFilter::InZone(Players{zone:Graveyard, players:One(DefendingPlayerOf(EventSubject))}))}), index:0} */
defending_graveyard_card_target ::= "target" noun "card" "from" "defending" "player's" "graveyard"

/* @sem Operation::Move{objects:One($defending_graveyard_card_target), destination:$battlefield_control, qualifiers:[]} */
put_defending_graveyard_target ::= "put" defending_graveyard_card_target "onto" "the" "battlefield" battlefield_control

/* The pronoun refers to the objects affected by this untap action. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:$attacking_type_group, tapped:false}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Affected(@prior)), changes:$grants, duration:$duration, evaluation:Snapshot}}] */
untap_attacking_receipt_grants ::= "untap" attacking_type_group "." "they" "gain" grants duration

/* @sem Program::Program{instructions:[...$untap_attacking_receipt_grants, Effect{result:@next, operation:$operation}]} */
untap_receipt_followup_program ::= untap_attacking_receipt_grants "." operation "."

/* The same plural change applies to a battlefield population and independently
   filtered cards in three zones owned by the ability controller. */
/* @sem Instruction::[Effect{result:@next, operation:CreatePerpetualEffect{objects:$perpetual_battlefield_population, changes:$plural_private_pump}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$owned_cards_hand_library_graveyard}, changes:$plural_private_pump}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$owned_cards_hand_library_graveyard}, changes:$plural_private_pump}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$owned_cards_hand_library_graveyard}, changes:$plural_private_pump}}] */
instructions_perpetual_battlefield_and_owned_zones ::= perpetual_battlefield_population "and" owned_cards_hand_library_graveyard "perpetually" plural_private_pump

/* Selection is confined to the same exposed opponent's hand population. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0})}, kind:Card, filter:$card_filter}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(Target{slot:@last_slot, index:0})}, kind:Card, filter:$card_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
revealed_opponent_hand_choice_exile ::= "target" "opponent" "reveals" "each" card_filter "card" "in" "their" "hand" "." "you" "choose" "one" "of" "those" "cards" "." "exile" "that" "card"

/* @sem Instruction::[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter})}}] */
gain_life_per_hand_kind ::= "you" "gain" "1" "life" "for" "each" card_filter "card" "in" "your" "hand"

/* A single resolving color choice can feed each implied mixed-zone mode. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[Term{family:ChoosableColor, form:AnyColor}]}} */
mixed_zone_color_choice ::= "the" "color" "of" "your" "choice"

/* The two target domains have separate announcements and effect operations. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$mixed_zone_color_choice}, Effect{result:@next, operation:EffectOn{subject:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:Any}), index:0})), effects:[Term{family:SpellEffect, form:SetColor, operands:[Term{family:SettableColor, form:TheChosenColor}]}], until:$duration}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$mixed_zone_color_choice}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$mixed_color_permanent_noun}), index:0})), changes:[ChosenColor{mode:Set}], duration:$duration, evaluation:Snapshot}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied} */
mixed_zone_chosen_color_modes ::= "target" "spell" "or" mixed_color_permanent_noun "becomes" mixed_zone_color_choice duration

/* A separately announced permanent remains the object offered to the chosen player. */
/* @sem Instruction::[Effect{result:@next, operation:@apply(PlayerSet::One(AbilityController), $draw_base)}, Effect{result:@next, operation:PlayersDo{players:OthersThan(AbilityController), any_one:true, optional:true, body:[Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_permanent)), changes:[SetController(Acting)], duration:Indefinite, evaluation:Snapshot}}]}]}}] */
instructions_choose_target_draw_give_control ::= "choose" target_permanent "." draw_base "," "then" "another" "player" "of" "your" "choice" "may" "gain" "control" "of" "that" "permanent"

/* The caster and duration belong to the spell population; its effect composes separately. */
spell_effect_filtered_cast ::= spell_effect_filtered_uncounterable | spell_effect_triple_reduction

/* @sem EffectSubject::EachSpell(AllOf([$filter_phrase, Cast{by:One(AbilityController)}])) */
filtered_cast_spell_subject ::= filter_phrase "spells" "you" "cast" "this" "turn"

/* @sem Operand::Term{family:SpellEffect, form:CantBeCountered} */
filtered_cast_spell_effect ::= "can't" "be" "countered"

/* The target and duration independently retain the triggering player. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(EventSubject)))}), index:0} */
target_event_player_controlled ::= "target" filter_phrase "that" "player" "controls"

/* @sem Duration::While(PlayerState{player:EventSubject, state:Monarch}) */
while_event_player_monarch ::= "for" "as" "long" "as" "they're" "the" "monarch"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($target_event_player_controlled)), changes:[SetController(AbilityController)], duration:$while_event_player_monarch, evaluation:Snapshot} */
gain_control_event_monarch ::= "gain" "control" "of" target_event_player_controlled while_event_player_monarch

/* A willing player pays; the dependent instructions retain their own actors. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:FirstWilling(All), cost:Cost{parts:[Mana($mana_symbols)]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
instructions_any_player_pays ::= "if" "any" "player" "pays" mana_symbols "," conjoined

/* The target filter and the independently defined X remain current operands. */
/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$return_defined_value}}, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_defined_mana_value_graveyard ::= "return" "target" card_filter "card" "with" "mana" "value" "X" "or" "less" "from" "your" "graveyard" "to" "the" "battlefield" "," "where" "X" "is" return_defined_value

return_defined_value ::= return_players_attacked_history | return_bound_value

/* @sem Expr::CountPlayers(Matching{binding:0, condition:Compare{left:EventHistory{event:Batch{event:Attack{attackers:Any, by:One(AbilityController), defenders:Players(One(Bound(0)))}, per:Defender}, window:$return_attack_window, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}) */
return_players_attacked_history ::= "the" "number" "of" "players" "you" "attacked" return_attack_window

return_attack_window ::= return_attack_this_combat | return_attack_this_turn

/* @sem HistoryWindow::ThisCombat */
return_attack_this_combat ::= "this" "combat"

/* @sem HistoryWindow::ThisTurn */
return_attack_this_turn ::= "this" "turn"

/* A spell's resolving replacement retains the affected object and counter type. */
/* @sem Operation::EffectOn{subject:Objects($affected), effects:[Term{family:SpellEffect, form:ResolvesIntoExileInsteadOfGraveyardWithACounter, operands:[$resolving_counter_vocabulary]}]} */
resolving_exile_counter ::= "exile" "that" "card" "with" "a" resolving_counter_vocabulary "counter" "on" affected "instead" "of" "putting" "it" "into" "your" "graveyard" "as" "it" "resolves"

resolving_counter_vocabulary ::= resolving_dream_counter | opening_counter_vocabulary

/* @sem Operand::Vocabulary{family:CounterType, form:DreamCounter} */
resolving_dream_counter ::= "dream"

/* The destination and the constrained target group are independent operands. */
/* @sem Operation::Move{objects:$graveyard_targets_distinct_value, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_graveyard_distinct_battlefield ::= "return" "from" "your" "graveyard" "to" "the" "battlefield" graveyard_targets_distinct_value

/* The target and its graveyard ownership stay in the announcement; the
   replacement belongs to the permission granted for the selected spell. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$card_filter, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}), from:Graveyard, action:CastSpell, filter:Any}, terms:_{cost:Normal, into_exile:true}})], duration:$this_duration, evaluation:LiveObjects}}] */
instructions_target_graveyard_cast_exile ::= "you" "may" "cast" "target" card_filter "card" "from" "your" "graveyard" this_duration "." "if" "that" "spell" "would" "be" "put" "into" "your" "graveyard" "," "exile" "it" "instead"

/* The retargeting choice applies to the same announced spell. */
/* @sem Operation::TakeSpell{actor:One(AbilityController), object:$target_stack_spell, targets:May} */
take_target_spell_with_retarget ::= "gain" "control" "of" target_stack_spell "." "you" "may" "choose" "new" "targets" "for" "it"

/* An offered return payment excludes the subject of the enclosing event. */
/* @sem Cost::Cost{parts:[Move{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(EventSubject)), $filter_phrase, ControlledBy(One(AbilityController))])}, choose:Exactly(Constant(1))}], destination:OwnersHand(CardArrival{counters:[], states:[]})}]} */
event_other_return_payment ::= "return" "another" filter_phrase "you" "control" "to" "its" "owner's" "hand"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$event_other_return_payment, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:$program, otherwise:Program{}}]} */
event_unless_other_return_program ::= program "unless" "you" event_other_return_payment "."

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$event_unless_other_return_program} */
triggered_unless_other_return ::= event_clause "," event_unless_other_return_program

/* A stat change cannot alter the type or controller of this population.
   Both instructions therefore use the same current population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($plural_atomic, $suspect_group_controller)} */
suspect_pump_group ::= plural_atomic suspect_group_controller

suspect_group_controller ::= modifier_opponents_control | modifier_you_control | modifier_opponent_controls | modifier_player_controls

/* Unsuspecting an object without suspected status has no effect. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($suspect_pump_group), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:KeywordEach{actor:One(AbilityController), action:Unsuspect, objects:$suspect_pump_group}}] */
clause_pump_unsuspect_group ::= suspect_pump_group "get" signed "/" signed duration "." "if" "any" "of" "them" "are" "suspected" "," "they're" "no" "longer" "suspected"

/* The trailing condition names the player previously mentioned by the action. */
/* @sem Instruction::[@resolution(Instruction::If{condition:Not($condition_they_hand_alternatives), then:Program{instructions:[Effect{result:@next, operation:$operation}]}, otherwise:Program{}})] */
clause_operation_unless_hand_alternatives ::= operation "unless" condition_they_hand_alternatives

/* @sem Operation::Clash{actor:One(AbilityController), opponents:One($defending_player), won:[Program{}], lost:[Program{}]} */
clash_defending ::= "clash" "with" defending_player

/* A stack spell can be taken with optional retargeting. */
/* @sem Operation::TakeSpell{actor:One(AbilityController), object:$target_stack_spell, targets:May} */
take_target_spell ::= "gain" "control" "of" target_stack_spell "and" "you" "may" "choose" "new" "targets" "for" "it"

/* Both actions are scoped to the spell announced before this coin process. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:Any}), index:0} */
coin_announced_spell ::= "that" "spell"

/* @sem ObjectRef::Target{slot:@last_slot, index:0} */
coin_referenced_spell ::= "that" "spell"

/* @sem Operation::TakeSpell{actor:One(AbilityController), object:$coin_announced_spell, targets:May} */
coin_first_take_spell ::= "gain" "control" "of" coin_announced_spell "and" "you" "may" "choose" "new" "targets" "for" "it"

/* @sem Operation::TakeSpell{actor:One(AbilityController), object:$coin_announced_spell, targets:Same} */
coin_first_take_spell_same ::= "gain" "control" "of" coin_announced_spell

/* @sem Operation::Counter{objects:One($coin_announced_spell), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None} */
coin_first_counter_spell ::= "counter" coin_announced_spell

coin_first_spell_action ::= coin_first_take_spell | coin_first_take_spell_same | coin_first_counter_spell

/* @sem Operation::Counter{objects:One($coin_referenced_spell), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None} */
coin_later_counter_spell ::= "counter" coin_referenced_spell

/* @sem Operation::TakeSpell{actor:One(AbilityController), object:$coin_referenced_spell, targets:May} */
coin_later_take_spell ::= "gain" "control" "of" coin_referenced_spell "and" "you" "may" "choose" "new" "targets" "for" "it"

coin_later_spell_action ::= coin_later_counter_spell | coin_later_take_spell

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$coin_later_spell_action}]} */
coin_later_spell_program ::= coin_later_spell_action

coin_spell_followup ::= coin_later_spell_program | program

/* @sem Instruction::[Effect{result:@mark, operation:FlipCoin{player:AbilityController, protocol:@coin_protocol}}, If{condition:CoinFlip{result:@marked, outcome:Won}, then:Program{instructions:[Effect{result:@next, operation:$coin_first_spell_action}]}, otherwise:$coin_spell_followup}] */
chosen_spell_coin_win_first ::= "flip" "a" "coin" "." "if" "you" "win" "the" "flip" "," coin_first_spell_action "." "if" "you" "lose" "the" "flip" "," coin_spell_followup

/* @sem Instruction::[Effect{result:@mark, operation:FlipCoin{player:AbilityController, protocol:@coin_protocol}}, If{condition:CoinFlip{result:@marked, outcome:Lost}, then:Program{instructions:[Effect{result:@next, operation:$coin_first_spell_action}]}, otherwise:$coin_spell_followup}] */
chosen_spell_coin_lose_first ::= "flip" "a" "coin" "." "if" "you" "lose" "the" "flip" "," coin_first_spell_action "." "if" "you" "win" "the" "flip" "," coin_spell_followup

chosen_spell_coin_branches ::= chosen_spell_coin_win_first | chosen_spell_coin_lose_first

/* @sem Instruction::$chosen_spell_coin_branches */
chosen_spell_coin_process ::= "choose" "target" "spell" "," "then" chosen_spell_coin_branches

/* The selected cards retain their printed filter independently of the cast terms. */
/* @sem ObjectSet::OutsideTheGame($filter_phrase) */
owned_outside_filtered_spells ::= filter_phrase "spells" "from" "among" "cards" "you" "own" "outside" "the" "game"

/* @sem Operation::PlayWith{actor:One(AbilityController), action:CastSpell, cards:$owned_outside_filtered_spells, count:AnyNumber, terms:_{cost:Free}} */
cast_any_owned_outside_spells ::= "cast" "any" "number" "of" owned_outside_filtered_spells "without" "paying" "their" "mana" "costs"

/* Shared graveyard populations retain card identity and ownership. */
/* @sem Operation::Move{objects:$return_personal_graveyard_population, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]} */
return_personal_graveyard_population_tapped ::= "return" return_personal_graveyard_population "to" "the" "battlefield" "tapped"

/* Both populations are exiled as distinct effects; the second retains its filter. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_objects}, Effect{result:@next, operation:Move{objects:$all_graveyards_exile_population, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_exile_and_graveyard_population ::= exile_objects "and" all_graveyards_exile_population

/* Both fighters remain operands; the target qualifier compares with the prior fighter. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:EventSubject, second:$fight_same_value_target}} */
/* @prefer always */
fight_same_value ::= "it" "fights" fight_same_value_target

/* One prevention decision for each member of an attacking population. */
/* @sem Program::Program{instructions:[ForEachObject{objects:$attacking_colored_creature_population, binding:0, body:$bound_combat_prevention_unless_paid}]} */
program_attacking_creatures_prevention ::= "for" "each" attacking_colored_creature_population "," bound_combat_prevention_unless_paid

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Attacking, $adjective_color, CardType(Creature)])} */
attacking_colored_creature_population ::= "attacking" adjective_color "creature"

/* The payer and damage source both refer to the same loop-bound creature. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:ControllerOf(Bound(0)), cost:_{parts:[Mana($mana_symbols)]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:_{instructions:[Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Permanent, sources:SameObject(Bound(0)), recipients:Any, kind:Combat, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}}}]}, otherwise:_{}}]} */
bound_combat_prevention_unless_paid ::= "prevent" "all" "combat" "damage" "that" "would" "be" "dealt" "by" "that" "creature" this_duration "unless" "its" "controller" "pays" mana_symbols

/* The choice and its owner's destination retain separate identities. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$another_antecedent_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
return_another_antecedent ::= "return" another_antecedent_filter "to" "its" "owner's" "hand"

/* The target phrase can also compose with other actions. */
/* @sem Operation::Move{objects:One($target_graveyard_recent_optional), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
/* @prefer always */
choose_graveyard_recent_to_hand ::= "choose" target_graveyard_recent_optional "." "put" "that" "card" "into" "its" "owner's" "hand"

/* @sem Operation::Move{objects:$target_graveyard_recent_optional_plural, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
choose_graveyard_recent_plural_to_hand ::= "choose" target_graveyard_recent_optional_plural "." "put" "those" "cards" "into" "their" "owners'" "hands"

/* @prefer always */
/* @sem Operation::LoseLife{players:One(Bound(0)), amount:$bound_player_card_count} */
bound_player_loses_cards_life ::= "loses" "life" "equal" "to" "the" "number" "of" bound_player_card_count

/* Count only attacking permanents controlled by the player bound by the loop. */
/* @sem Operation::LoseLife{players:One(Bound(0)), amount:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Attacking, $filter_phrase, ControlledBy(One(Bound(0)))])})} */
bound_player_loses_attacking_life ::= "loses" "1" "life" "for" "each" "attacking" filter_phrase "they" "control"

/* Counter placement by a player who chooses among their own permanents. */
counter_choosing_player ::= target_player | target_opponent

/* @sem CounterKind::$counter_kind */
singular_named_counter ::= "a" counter_kind "counter"

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One($counter_choosing_player))])}), kind:$singular_named_counter, amount:Constant(1), selection:_{player:$counter_choosing_player, count:$counter_single_choice}}]} */
player_puts_controlled_counter ::= counter_choosing_player "puts" singular_named_counter "on" counter_single_choice filter_phrase "they" "control"

/* The object's owner moves the same referenced object to its owner's library. */
/* @sem Operation::Move{objects:One($it_ordinary_pronoun), destination:$owner_shuffled_library, qualifiers:[]} */
owner_shuffles_referenced_object ::= "its" "owner" "shuffles" it_ordinary_pronoun owner_shuffled_library

/* One choice contains the action and the defined observation. */
/* @sem Vec<Instruction>::@optional_then($clause_operation, $look_defined_selection) */
/* @prefer always */
may_action_then_defined_selection ::= clause_operation "," "then" look_defined_selection

/* Scope the characteristic to the same targeted card moved by this optional action. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One($target_card_your_graveyard), destination:Library{position:$owner_library_position, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:$recipients, amount:ObjectProperty{object:$target_card_your_graveyard, property:$receipt_stat, information:CurrentOrLastKnown}, preventable:true}}]}, otherwise:Program{}}] */
clause_optional_graveyard_library_stat_damage ::= "you" "may" "put" target_card_your_graveyard owner_library_position "of" "your" "library" "." "if" "you" "do" "," damage_source_ref "deals" "damage" "equal" "to" "that" "card's" receipt_stat "to" recipients

/* The exile and the reflexive target share the same face-up movement receipt. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:$reflexive_graveyard_exile}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:_{targets:[_{slot:0, kind:Object(_{kind:Card, zones:[Exile]}), count:UpTo(Constant(1)), filter:AllOf([$card_filter, InSet(Transition{result:@marked, phase:After})])}]}, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:Copy{object:Target{slot:0, index:0}, exceptions:[$receipt_copy_card_type]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}})}]} */
exile_graveyard_reflexive_copy_program ::= reflexive_graveyard_exile "." "when" "you" "do" "," "choose" "up" "to" "one" "target" card_filter "card" "exiled" "this" "way" "." "create" token_copy_single "that" "card" "," "except" receipt_copy_card_type

/* @sem CopyException::SetCardTypes([$vowel_card_type]) */
receipt_copy_card_type ::= "it's" "an" vowel_card_type "and" "it" "loses" "all" "other" "card" "types"

/* @sem Ability::Spell{announcement:_{targets:[]}, body:$exile_graveyard_reflexive_copy_program} */
spell_exile_graveyard_reflexive_copy ::= exile_graveyard_reflexive_copy_program "."

/* @sem Operation::Move{objects:Zone{scope:Players{zone:Graveyard, players:OpponentsOf(AbilityController)}, kind:Card, filter:Any}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
reflexive_graveyard_exile ::= "exile" "each" "opponent's" "graveyard"

/* The same damage history can select the subject of a temporary death replacement. */
/* @sem Operation::CreateReplacement{event:ZoneChange{objects:$history_recipient_by_targeted_creature, from:Battlefield, to:Graveyard}, limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}} */
exile_history_recipient_instead_of_dying ::= "if" history_recipient_by_targeted_creature "would" "die" this_duration "," "exile" "that" "creature" "instead"

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:SameObject($targeted_creature_reference), recipients:Objects(SameObject(Candidate)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$singular_creature_article}}) */
history_recipient_by_targeted_creature ::= singular_creature_article "creature" "dealt" "damage" "by" targeted_creature_reference

/* @sem ObjectRef::@qualified_object(ObjectKind::Permanent, ObjectFilter::CardType(Creature)) */
targeted_creature_reference ::= "the" "targeted" "creature"

/* The card's type and threshold are independent operands of its selection. */
/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:$stat_comparison, value:CountCounters(_{recipients:Objects(One(EventSubject)), information:CurrentOrLastKnown})}} */
event_creature_counter_mana_bound ::= "with" "mana" "value" stat_comparison "the" "number" "of" "counters" "on" "that" "creature"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@current_named_object)), $card_filter, $event_creature_counter_mana_bound, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0} */
other_counter_bound_graveyard_card ::= "another" "target" card_filter "card" event_creature_counter_mana_bound "from" "your" "graveyard"

/* @sem Operation::Move{objects:One($other_counter_bound_graveyard_card), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_counter_bound_card_hand ::= "return" other_counter_bound_graveyard_card "to" "your" "hand"

/* A resolving player chooses an exact number from a population and attaches
   them to the separately described host. */
/* @sem Operation::AttachChosen{actor:One(AbilityController), attachments:$affected, count:Exactly($attachment_choice_count), hosts:$affected_2} */
attach_exact_choice ::= "attach" attachment_choice_count affected "to" affected

attachment_choice_count ::= counter_a | attachment_choice_words | n1 | number_digits | number_x

/* @prefer always */
attachment_choice_words ::= n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10 | n11 | n12 | n13 | n14 | n15 | n20 | n30 | number_hundred

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$attach_exact_choice}]}}] */
optional_attach_exact_choice ::= "you" "may" attach_exact_choice

/* The payment is an exile move, so its own selected inputs are the measured receipt. */
/* @prefer always */
/* @sem CostPart::Move{selections:[_{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo($number), filter:AllOf([$noun, InZone(Players{zone:Graveyard, players:One(@defending)})])}))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
receipt_exile_defending_targets ::= "exile" "up" "to" number "target" noun "cards" "from" "defending" "player's" "graveyard"

/* Scope the count to this exact exile payment, including the payment result. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$receipt_exile_defending_targets]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:CountObjects(CostObjects{payment:Resolution(@marked), component:[0], view:Inputs, phase:Before})}}, ...$conjoined]}, otherwise:Program{}}] */
instructions_paid_exile_life_and ::= "you" "may" receipt_exile_defending_targets "." "if" "you" "do" "," "you" "gain" "1" "life" "for" "each" "card" "exiled" "this" "way" "and" conjoined

/* The announced player remains the subject of the later life instruction. */
/* @sem Vec<Instruction>::@then_sequence([Instruction::Effect{result:@next, operation:$operation}], @apply($players_singular, $shared_player_loss_you_gain_defined)) */
chosen_player_action_then_shared_life ::= "choose" players_singular "." operation "." "then" "the" "chosen" "player" shared_player_loss_you_gain_defined

/* Capture the value once so both life changes use the same result. */
/* @sem Instruction::[Effect{result:@mark, operation:BindValue{value:$value}}, Effect{result:@next, operation:LoseLife{players:@subject, amount:BoundValue(@marked)}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:BoundValue(@marked)}}] */
shared_player_loss_you_gain_defined ::= "loses" "X" "life" "and" "you" "gain" "X" "life" "," "where" "X" "is" value

/* The chosen defender is the actual result of the preceding defender choice. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[SetController(EventSubject)], duration:$join_attack_duration, evaluation:Snapshot}}, Effect{result:@next, operation:ChooseDefender{actor:One(AbilityController), attacker:EventSubject}}, Effect{result:@next, operation:ChangeCombat{change:AssignAttack{objects:One(Source), to:Object(Result{result:@prior, phase:After, index:0})}}}]}}]} */
opponent_control_join_attack_program ::= "you" "may" "have" "that" "opponent" "gain" "control" "of" SELF_NAME join_attack_duration "." "if" "you" "do" "," "choose" "a" "player" "or" "planeswalker" "that" "opponent" "is" "attacking" "." SELF_NAME "is" "attacking" "that" "player" "or" "planeswalker" "."

join_attack_duration ::= join_attack_combat_duration | duration

/* @prefer always */
/* @sem $until_end_of_combat */
join_attack_combat_duration ::= until_end_of_combat

/* The target's own current characteristic supplies the comparison. */
/* @sem Operation::CreatePerpetualEffect{objects:One($perpetual_optional_possessive), changes:[SetPower(ObjectProperty{object:Affected, property:$perpetual_comparison_stat, information:CurrentOrLastKnown})]} */
perpetual_optional_target_base_power ::= perpetual_optional_possessive "base" "power" "perpetually" "becomes" "equal" "to" "its" perpetual_comparison_stat

perpetual_comparison_stat ::= stat_power | stat_toughness

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:$perpetual_possessive_filter}), index:0} */
perpetual_optional_possessive ::= "up" "to" "one" "target" perpetual_possessive_filter

/* @sem ObjectFilter::CardType(Creature) */
perpetual_possessive_creature ::= "creature's"

/* @sem @and($quality, $perpetual_possessive_filter) */
perpetual_possessive_qualified ::= quality perpetual_possessive_filter

perpetual_possessive_filter ::= perpetual_possessive_creature | perpetual_possessive_qualified

/* The later additional draw follows the controller’s explicit preceding draw. */
/* @sem Instruction::[Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::AbilityController), $draw_base)}, ...$conditional_draw_postcondition] */
instructions_draw_then_additional_if ::= draw_base "." conditional_draw_postcondition

/* @sem Instruction::[@resolution(Instruction::If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::AbilityController), $conditional_draw_action)}]}, otherwise:Program{}})] */
conditional_draw_postcondition ::= conditional_draw_action "if" condition

conditional_draw_action ::= draw_base | additional_draw_base

/* @sem Operation::Draw{players:@subject, amount:Constant(1)} */
additional_draw_base ::= "draw" "another" "card"

/* One card is selected from the union in the controller's hand as a payment. */
/* @sem Cost::Cost{parts:[CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$a_card_or}, choose:Exactly(Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]} */
payment_exile_hand_union ::= "exile" a_card_or "from" "your" "hand"

/* Both consumers retain the identity of the enclosing ordered roll. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RollTwoInOrder{sides:8}} */
roll_two_chosen_d8 ::= "roll" "two" "d8" "and" "choose" "one" "result"

/* @sem Operation::Draw{players:One(AbilityController), amount:DieResultAt{result:@marked, index:0}} */
draw_chosen_ordered_result ::= "draw" "cards" "equal" "to" "that" "result"

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AllOf([$ordered_cast_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:DieResultAt{result:@marked, index:1}}}])}, count:Exactly(Constant(1)), cost:Free} */
cast_hand_other_ordered_result ::= "cast" "an" ordered_cast_filter "spell" "with" "mana" "value" "less" "than" "or" "equal" "to" "the" "other" "result" "from" "your" "hand" "without" "paying" "its" "mana" "cost"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:$roll_two_chosen}, Effect{result:@next, operation:$draw_chosen_ordered_result}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$cast_hand_other_ordered_result}]}}]}} */
spell_ordered_roll_draw_cast ::= roll_two_chosen "." draw_chosen_ordered_result "." "then" "you" "may" cast_hand_other_ordered_result "."

ordered_cast_filter ::= filter_instant_or_sorcery | ordered_cast_instant | ordered_cast_instant_creature

/* @sem ObjectFilter::CardType(Instant) */
ordered_cast_instant ::= "instant"

/* @sem ObjectFilter::AnyOf([CardType(Instant), CardType(Creature)]) */
ordered_cast_instant_creature ::= "instant" "or" "creature"

/* The phrase supplies the population filter; each enclosing receipt contract
   checks the repeated noun and fixes both the choice and destination. */
/* @sem ObjectFilter::$subtype_plural */
returned_controlled_subtypes ::= "return" "any" "number" "of" subtype_plural "you" "control" "to" "their" "owner's" "hand"

/* @sem ObjectFilter::$subtype_plural */
returned_plural_receipt ::= subtype_plural "returned" "this" "way"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($returned_controlled_subtypes, $returned_plural_receipt), ControlledBy(One(AbilityController))])}, count:AnyNumber}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:$recipients, amount:Multiply(Constant(2), CountObjects(Transition{result:@prior, phase:Before})), preventable:true}}] */
instructions_returned_subtype_damage ::= returned_controlled_subtypes "." object_ref "deals" "damage" "to" recipients "equal" "to" "twice" "the" "number" "of" returned_plural_receipt

/* The scope joins each owner's decision to the corresponding unpaid object.
   The population, destination and payment remain independent phrase operands. */
/* @sem Instruction::[ForEachObject{objects:$each_battlefield_subtype, binding:0, body:_{instructions:[ForEachPlayer{players:One(OwnerOf(Bound(0))), binding:0, body:_{instructions:[Effect{result:@mark, operation:PayCost{player:Bound(0), cost:$bound_owner_mana_decision, optional:true}}]}}]}}, Effect{result:@next, operation:Move{objects:Unpaid(@marked), destination:$unpaid_owner_destination, qualifiers:[]}}] */
instructions_each_owner_unless_mana ::= "for" "each" each_battlefield_subtype "," unpaid_owner_destination "unless" bound_owner_mana_decision

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$subtype} */
each_battlefield_subtype ::= subtype

/* @sem Cost::_{parts:[Mana($mana_symbols)]} */
bound_owner_mana_decision ::= "that" "player" "pays" mana_symbols

/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
return_it_destination ::= "return" "it" "to" "its" "owner's" "hand"

unpaid_owner_destination ::= return_it_destination | put_it_owners_graveyard

/* @sem MovementDestination::OwnersGraveyard(CardArrival{counters:[], states:[]}) */
put_it_owners_graveyard ::= "put" "it" "into" "its" "owner's" "graveyard"

/* The hand owner, chooser and entry controller are the ability controller. */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$attack_entry_creature_filter}, count:AsManyAsCan(Constant(1))} */
attack_entry_hand_choice ::= "an" attack_entry_creature_filter "card"

/* This phrase is used only with an event that supplies the attacked opponent. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$attack_entry_hand_choice}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{player:EventSubject, or_planeswalker:false}]}}, qualifiers:[]}}]}}] */
optional_hand_entry_attacked_opponent ::= "you" "may" "put" attack_entry_hand_choice "from" "your" "hand" "onto" "the" "battlefield" "tapped" "and" "attacking" "that" "opponent"

/* Scoped by the enclosing damage-source event. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:ObjectProperty{object:Damage(Source), property:BasePower, information:CurrentOrLastKnown}}}]} */
/* @prefer always */
draw_damage_source_base_power ::= "draw" "cards" "equal" "to" "its" "base" "power"

/* Each opponent decides and pays independently; the decline refers to that payment. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:Bound(0), cost:$cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(Bound(0)), amount:$value}}]}, otherwise:Program{}}]}}] */
player_loses_life_unless_cost ::= players_singular "loses" value "life" "unless" "they" cost

/* The controller is read from the departure receipt of this adjacent exile. */
/* @sem Instruction::ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(Bound(0)), amount:CountObjects(Matching{objects:Transition{result:@prior, phase:Before}, filter:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))])})}}]}} */
exiled_each_controller_draws ::= "for" "each" filter_phrase "exiled" "this" "way" "," "its" "controller" "draws" "a" "card"

/* Scope the receipt consumer to its actual face-up exile producer. */
/* @sem Vec<Instruction>::[Effect{result:@next, operation:$exile_objects}, $exiled_each_controller_draws] */
exile_then_each_controller_draws ::= exile_objects "." exiled_each_controller_draws

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$exile_then_each_controller_draws}} */
spell_exile_then_each_controller_draws ::= exile_then_each_controller_draws "."

/* The adjacent singular return supplies the pre-move object for the type test. */
/* @sem Instruction::[Effect{result:@next, operation:@owner_return(Operation::Move{objects:ObjectSet::$return_single_target, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]})}, If{condition:ObjectMatches{object:Result{result:@prior, phase:Before, index:0}, filter:$filter_phrase}, then:$program, otherwise:Program{}}] */
instructions_return_single_past_type ::= "return" return_single_target "to" "its" "owner's" "hand" "." "if" "it" "was" "an" filter_phrase "," program

return_single_target ::= return_single_optional_other | return_single_optional

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@another_target_reference(ObjectFilter::$filter_phrase))), $filter_phrase)})) */
return_single_optional_other ::= "up" "to" "one" "other" "target" filter_phrase

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:$filter_phrase})) */
return_single_optional ::= "up" "to" "one" "target" filter_phrase

/* A draw and a later intensification retain their independent operands. */
/* @sem Instruction::[Effect{result:@next, operation:$draw_for_owned_intensify}, Effect{result:@next, operation:$intensify_owned_subtype_cards}] */
instructions_draw_owned_subtype_intensify ::= draw_for_owned_intensify "." NEWLINE intensify_owned_subtype_cards

draw_for_owned_intensify ::= draw_spell_intensity_number | draw_owned_intensify_count

/* @prefer always */
/* @sem Operation::Draw{players:One(AbilityController), amount:$mana_spell_intensity} */
draw_spell_intensity_number ::= "draw" "a" "number" "of" "cards" "equal" "to" mana_spell_intensity

/* @sem @apply(PlayerSet::One(PlayerRef::AbilityController), $draw_base) */
draw_owned_intensify_count ::= draw_base

/* Adjacent exile and copy share the actual arrival receipt. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_up_to_one_your_graveyard_kind}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:Copy{object:Result{result:@prior, phase:After, index:0}, exceptions:$copy_added_colored_creature_stats}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
instructions_exile_graveyard_copy_added ::= exile_up_to_one_your_graveyard_kind "." "create" token_copy_single "that" "card" "," "except" copy_added_colored_creature_stats

/* Keep the participation choice and its three consumers in the same scope.
   The repeat body is independent of the offered draw and token operands. */
/* @sem Instruction::[ForEachPlayer{players:Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:PlayerState{player:Bound(0), state:CanDraw}}]), binding:0, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:Bound(0), cost:Cost{parts:[]}, optional:true}}]}}, Effect{result:@next, operation:Draw{players:Matching{binding:0, condition:PlayerTook{player:Bound(0), result:@marked}}, amount:$card_count}}, Effect{result:@next, operation:CreateTokens{players:Matching{binding:0, condition:PlayerTook{player:Bound(0), result:@marked}}, tokens:[$token_group], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, RepeatableWithLimit{amount:CountPlayers(Matching{binding:0, condition:PlayerTook{player:Bound(0), result:@marked}}), body:Program{instructions:$conjoined}}] */
opponent_optional_draw_tokens_repeat ::= "each" "opponent" "may" "draw" card_count "and" "create" token_group "." "for" "each" "opponent" "who" "does" "," conjoined "."

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$conjoined, ...$opponent_optional_draw_tokens_repeat]}} */
spell_then_opponent_draw_tokens_repeat ::= conjoined "." "then" opponent_optional_draw_tokens_repeat

/* A required move followed by its successful-performance continuation.
   The target owner is the event player and the library is that card's own. */
/* @sem ObjectSet::InZone{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Exile]}), count:Exactly(Constant(1)), filter:AllOf([Not(State(FaceDown)), OwnedBy(One(EventSubject))])}), index:0}), zone:Exile} */
event_player_owned_face_up_exile_target ::= "target" "face-up" "card" "they" "own" "in" "exile"

/* @sem Operation::Move{objects:$event_player_owned_face_up_exile_target, destination:Library{position:$owner_library_position, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
event_owned_exile_library_move ::= "put" event_player_owned_face_up_exile_target owner_library_position "of" "their" "library"

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$event_owned_exile_library_move}]}}]}, optional:false}}, If{condition:PaymentChosen(@marked), then:$program, otherwise:Program{}}]} */
event_owned_exile_move_followup ::= event_owned_exile_library_move "." "if" "you" "do" "," program "."

/* An optional choice and the damage instruction share the choice receipt. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$noun}, count:AsManyAsCan(Constant(1))}}]}}, Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun_2, InSet(Unselected(@prior))])}), amount:$number, preventable:true}}]} */
program_optional_choice_damage_remainder ::= "you" "may" "choose" "a" noun "." damage_source_ref "deals" number "damage" "to" "each" noun "not" "chosen" "this" "way" "."

/* A scheduled program retains its own body and the chosen turn event. */
/* @sem Operation::CreateDelayedTrigger{event:$scheduled_turn_event, start:Immediately, body:$program} */
scheduled_turn_program ::= "at" scheduled_turn_event "," program

/* Independent preceding actions can introduce targets used by the scheduled body. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:$scheduled_turn_program}]}} */
spell_action_scheduled_program ::= operation "." scheduled_turn_program "."

/* The delayed return consumes the immediately preceding singular exile arrival. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One($object_ref), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:$exile_return_next_point, players:One(AbilityController)}, start:PlayersNextTurn(AbilityController), body:Program{instructions:[Effect{result:@next, operation:Move{objects:@exile_followup(InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}), destination:$battlefield_control, qualifiers:[]}}]}}}] */
instructions_exile_return_next_turn ::= "exile" object_ref "." "return" "it" "to" "the" "battlefield" battlefield_control "at" "the" "beginning" "of" exile_return_next_point "on" "your" "next" "turn"

exile_return_next_point ::= exile_return_next_attackers | returned_cards_next_end | returned_cards_next_upkeep | returned_cards_next_draw

/* @sem TurnPoint::DeclareAttackersStepBegins */
exile_return_next_attackers ::= "the" "declare" "attackers" "step"

paid_x_callback ::= paid_x_return_counter_callback | paid_x_cast_graveyard_callback

/* The target and exile replacement belong to this particular free cast. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One($paid_x_graveyard_target), count:Exactly(Constant(1)), cost:Free, into_exile:true}}]}}]} */
paid_x_cast_graveyard_callback ::= "you" "may" "cast" paid_x_graveyard_target "without" "paying" "its" "mana" "cost" "." "if" "that" "spell" "would" "be" "put" "into" "a" "graveyard" "," "exile" "it" "instead"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$card_filter, Property{property:ManaValue, test:Compare{comparison:Equal, value:AnnouncedX}}])}), index:0} */
paid_x_graveyard_target ::= "target" card_filter "card" "with" "mana" "value" "X" "from" "a" "graveyard"

/* A fronted destination applies independently to every permanent in the population. */
/* @sem Operation::Move{objects:$compared_battlefield_population, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_fronted_compared_population ::= "return" "to" "their" "owners'" "hands" compared_battlefield_population

/* The controller offers a named player action; declining controls the following branch. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:$player_ref, body:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One($player_ref), amount:ChosenNumber}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@prior)), then:$program, otherwise:Program{}}] */
controller_may_have_player_lose_declined ::= "you" "may" "have" player_ref "lose" "that" "much" "life" "." "if" "you" "don't" "," program

/* A chosen number supplies the subsequent amount, independently of who loses life. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:$player_one, kind:Number, terms:_{count:Exactly(Constant(1)), options:[]}}}] */
player_chooses_shared_number ::= player_one "chooses" "a" "number"

/* @sem Instruction::[...$player_chooses_shared_number, ...$controller_may_have_player_lose_declined] */
instructions_before_declined_player_life ::= player_chooses_shared_number "." controller_may_have_player_lose_declined

/* A cast trigger on an emblem measures mana spent on its triggering spell. */
/* @sem Ability::Triggered{event:$event_cast, limits:_{}, body:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:$recipients, amount:ManaSpent{object:EventSubject, filter:_{}, aggregation:Count}, preventable:true}}]}, announcement:@announcement} */
emblem_cast_mana_damage_trigger ::= "whenever" event_cast "," "this" "emblem" "deals" "X" "damage" "to" recipients "," "where" "X" "is" "the" "amount" "of" "mana" "spent" "to" "cast" "that" "spell" "."

/* @sem Operation::CreateEmblem{actor:One(AbilityController), abilities:[@scope($emblem_cast_mana_damage_trigger)]} */
emblem_cast_mana_damage ::= "you" "get" "an" "emblem" "with" '"' emblem_cast_mana_damage_trigger '"'

/* Keep the exile producer and its permission together in both directions. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:CastSpell, filter:$adjective_color})], duration:$this_duration, evaluation:LiveObjects}}] */
instructions_top_exile_color_cast ::= exile_top_cards_of_your_library "." "you" "may" "cast" adjective_color "spells" "from" "among" "them" this_duration

/* The selected population is reused by the destruction. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($filter_phrase, $filter_plural)}, count:AsManyAsCan(Constant(5)), constraints:[OneForEach([Subtype(Plains), Subtype(Island), Subtype(Swamp), Subtype(Mountain), Subtype(Forest)])]}}, Effect{result:@next, operation:Destroy{objects:Selected(@prior), regeneration:true}}] */
choose_each_basic_type_destroy ::= "choose" "a" filter_phrase "of" "each" "basic" "land" "type" "," "then" "destroy" "those" filter_plural

/* A fronted vote count applies to a single card drawn for each vote. */
/* @sem Operation::Draw{players:One(AbilityController), amount:$count_fronted_vote} */
draw_for_each_vote_fronted ::= "for" "each" count_fronted_vote "," "draw" "a" "card"

/* The defending player is scoped to the attacking source. */
/* @sem Operation::Clash{actor:One(AbilityController), opponents:One(DefendingPlayerOf(Source)), won:[Program{}], lost:[Program{}]} */
clash_defending_attacker ::= "clash" "with" "defending" "player"

/* @prefer always */
/* @sem Ability::Triggered{event:Object{event:Attacks, objects:SameObject(Source)}, limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$clash_defending_attacker}]}} */
triggered_self_clash_defending ::= "whenever" SELF_NAME "attacks" "," clash_defending_attacker "."

/* The selection composes only inside the optional casting action. */
/* @sem Instruction::[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:$hand_cast_bounded_value, count:Exactly($counter_amount), cost:Free}}] */
may_cast_bounded_hand ::= "cast" counter_amount hand_cast_bounded_value "without" "paying" "its" "mana" "cost"

