/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:Move{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:InSet(MovedBy{result:0, phase:After, player:Bound(0)})}), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}] */
each_player_puts_own_exile_arrivals ::= "puts" "all" "cards" "they" "exiled" "this" "way" "onto" "the" "battlefield"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$each_player_exiles_graveyard_cards, ...$each_player_sacrifices_controlled, ...$each_player_puts_own_exile_arrivals]}} */
spell_each_graveyard_exchange ::= each_player_exiles_graveyard_cards "," "then" each_player_sacrifices_controlled "," "then" each_player_puts_own_exile_arrivals "."

/* Parity is independently supplied at both target and return sites. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:OpponentsOf(AbilityController), each:UpTo(Constant(1))}, filter:AllOf([Any, Property{property:ManaValue, test:$number_parity}])})), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
exile_each_opponent_parity_permanent ::= "for" "each" "opponent" "," "exile" "up" "to" "one" "target" "permanent" "that" "player" "controls" "with" "an" number_parity "mana" "value"

/* @sem Condition::ObjectMatches{object:Source, filter:ManaSpent{color:Colorless, comparison:GreaterOrEqual, value:$number}} */
condition_colorless_spent_spell ::= "at" "least" number "colorless" "mana" "was" "spent" "to" "cast" "this" "spell"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]), Property{property:ManaValue, test:$number_parity}])}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
return_parity_permanent_graveyard ::= "return" "a" "permanent" "card" "with" "an" number_parity "mana" "value" "from" "your" "graveyard" "to" "the" "battlefield"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$exile_each_opponent_parity_permanent, If{condition:$condition_colorless_spent_spell, then:Program{instructions:$return_parity_permanent_graveyard}, otherwise:Program{}}]}} */
spell_exile_parity_conditional ::= exile_each_opponent_parity_permanent "." NEWLINE "if" condition_colorless_spent_spell "," return_parity_permanent_graveyard "."

/* This wrapper guarantees target slot zero is this spell's sole target. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_opponent_entry_exile_owner}} */
spell_opponent_entry_exile_owner ::= instructions_opponent_entry_exile_owner "."

/* The delayed discard refers to the one card produced by this conjure. */
/* @sem Instruction::[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Named($referenced_card_name), count:Constant(1), destination:Hand(CardArrival{counters:[], states:[]})}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:DiscardObjects{objects:One(Result{result:@back(3), phase:After, index:0})}}]}}}] */
instructions_conjure_delayed_discard ::= "conjure" "a" "card" "named" referenced_card_name "into" "your" "hand" "." "discard" "that" "card" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* The selected card is the holder of the granted blitz ability. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AllOf([$noun, Not(HasKeywordFamily(Blitz))])}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:[GrantAbility(Mechanic{mechanic:Blitz, cost:_{parts:[ManaCostOf(Source)]}})]}}] */
instructions_hand_blitz_perpetual ::= "choose" "a" noun "card" "in" "your" "hand" "without" "blitz" "." "it" "perpetually" "gains" "blitz" "." "the" "blitz" "cost" "is" "equal" "to" "its" "mana" "cost"

/* Preserve the selected hand card as the holder of the granted ability. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Subtype(Equipment)}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:[GrantAbility(@scope($keyword_equip))]}}] */
instructions_hand_equip_perpetual ::= "choose" "an" "Equipment" "card" "in" "your" "hand" "." "it" "perpetually" "gains" keyword_equip

/* The equip ability belongs to the targeted Equipment, in its own frame. */
/* @sem Operation::CreatePerpetualEffect{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Subtype(Equipment), ControlledBy(One(AbilityController))])}), index:0}), changes:[GrantAbility(@scope($keyword_equip))]} */
perpetual_target_equipment_equip ::= "target" "Equipment" "you" "control" "perpetually" "gains" keyword_equip

/* The condition, whole-hand observation, choice and discard share one target. */
/* @sem Instruction::[If{condition:Compare{left:EventHistory{event:Player{event:LosesLife, players:One($target_opponent)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:_{instructions:[Effect{result:@next, operation:Reveal{objects:Zone(_{scope:Players{zone:Hand, players:One(Target{slot:0, index:0})}, kind:Card, filter:Any})}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(Target{slot:0, index:0})}, kind:Card, filter:$adjective_nontype}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}]}, otherwise:_{instructions:[Effect{result:@next, operation:Discard{players:One(Target{slot:0, index:0}), amount:Constant(1)}}]}}] */
instructions_life_loss_hand_discard ::= "choose" target_opponent "." "if" "they" "lost" "life" "this" "turn" "," "they" "reveal" "their" "hand" "," "you" "choose" "a" adjective_nontype "card" "from" "it" "," "and" "they" "discard" "that" "card" "." "otherwise" "," "they" "discard" "a" "card"

/* The targeted permanent's controller makes and receives the damage payment. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:ControllerOf($target_permanent), cost:_{parts:[PlayerAction{player:ControllerOf(Target{slot:@next_slot, index:0}), body:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(One(ControllerOf(Target{slot:@next_slot, index:0}))), amount:ObjectProperty{object:Source, property:Power, information:CurrentOrLastKnown}, preventable:true}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@prior)), then:_{instructions:[Effect{result:@next, operation:Destroy{objects:One(Target{slot:@next_slot, index:0}), regeneration:true}}]}, otherwise:_{}}]} */
shared_destroy_unless_source_power_damage ::= "destroy" target_permanent "unless" "its" "controller" "has" SELF_NAME "deal" "damage" "to" "them" "equal" "to" "his" "power"

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$shared_destroy_unless_source_power_damage} */
shared_event_destroy_unless_damage ::= event_clause "," shared_destroy_unless_source_power_damage "."

/* The play permission consumes exactly the preceding exile move. */
/* @sem Operation::Move{objects:$library_tops, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]} */
exile_library_tops ::= "exile" library_tops

/* @sem Instruction::[Effect{result:@mark, operation:$exile_library_tops}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:Either, filter:Any}, terms:_{limit:Total(1), cost:Free}})], duration:$duration, evaluation:LiveObjects}}] */
instructions_exile_tops_play_one_free ::= exile_library_tops "." duration "," "you" "may" "play" "one" "of" "those" "cards" "without" "paying" "its" "mana" "cost"

/* The definition belongs to the top-card move, including in its print inverse. */
/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:$value, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]} */
exile_top_defined_count ::= "exile" "the" "top" "X" "cards" "," "where" "X" "is" value

/* @sem Instruction::[Effect{result:@mark, operation:$exile_top_defined_count}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:PlayLand, filter:Any}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:CastSpell, filter:Any}, terms:_{cost:Free}})], duration:$duration, evaluation:LiveObjects}}] */
instructions_exile_defined_play_free ::= exile_top_defined_count "." duration "," "you" "may" "play" "lands" "and" "cast" "spells" "from" "among" "cards" "exiled" "this" "way" "without" "paying" "their" "mana" "costs"

/* A chosen single card supplies the receipt for the visibility permission.
   The same producer can be used without the following permission. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$a_card}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
exile_single_hand_hidden ::= "exile" a_card "from" "your" "hand" "face" "down"

/* The referent of both occurrences is the actual preceding exile arrival. */
/* @sem Instruction::[...$exile_single_hand_hidden, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:One(Result{result:@prior, phase:After, index:0}), audience:AffectedPlayer})], duration:WhileExiled(Result{result:@prior, phase:After, index:0}), evaluation:LiveObjects}}] */
clause_hidden_hand_look ::= exile_single_hand_hidden "." "you" "may" "look" "at" "that" "card" "for" "as" "long" "as" "it" "remains" "exiled"

/* The payment and its conditional share the payment result. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$cost, optional:true}}, If{condition:PaymentChosen(@last_result), then:$program, otherwise:Program{}}] */
clause_optional_cost_then ::= "you" "may" "pay" cost "." "if" "you" "do" "," program

/* This single-card producer marks the actual exile arrival for later effects. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$a_card}, count:AsManyAsCan(Constant(1))}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
exile_single_hand_up ::= "exile" a_card "from" "your" "hand"

/* The granted triggered ability belongs to the exiled card, not its grantor. */
/* @sem Ability::Triggered{event:$exiled_holder_last_counter_event, intervening_if:ObjectMatches{object:Source, filter:InZone(Shared(Exile))}, limits:_{}, announcement:@announcement, body:_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:One(Source), count:UpTo(Constant(1)), terms:_{cost:Free, effects:[Filter($filter_phrase), Term{family:SpellEffect, form:AddAbility, operands:[Ability(Keyword($keyword_value))]}]}}}]}}]}} */
exiled_counter_cast_keyword ::= exiled_holder_last_counter_event "," "if" "it's" "exiled" "," "you" "may" "cast" "it" "without" "paying" "its" "mana" "cost" "." "if" "you" "cast" "a" filter_phrase "spell" "this" "way" "," "it" "gains" keyword_value "until" "end" "of" "turn" "."

/* Every consumer refers to the marked single-card exile, including cleanup. */
/* @sem Instruction::[...$exile_single_hand_up, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Result{result:@marked, phase:After, index:0})), kind:$counter_kind, amount:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}}]}}, Effect{result:@next, operation:EffectOn{subject:Objects(One(Result{result:@marked, phase:After, index:0})), effects:[Term{family:ExiledCardEffect, form:AddAbility, operands:[Ability(Scoped{zones:[Exile], ability:@scope($exiled_counter_cast_keyword)})]}]}}, Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([Not(SameObject(Result{result:@marked, phase:After, index:0})), OwnedBy(One(AbilityController))])})), kind:$counter_kind_2, amount:Count(Exactly(Constant(1)))}]}}] */
clause_exile_hand_counter_cast ::= exile_single_hand_up "and" "put" "a" "number" "of" counter_kind "counters" "on" "it" "equal" "to" "its" "mana" "value" "." "it" "gains" '"' exiled_counter_cast_keyword '"' "then" "remove" "a" counter_kind "counter" "from" "each" "other" "card" "you" "own" "in" "exile"

hand_exile_continuation ::= clause_exile_hand_counter_cast | hidden_hand_payment_continuation

/* @sem Instruction::[...$clause_hidden_hand_look, ...$clause_optional_cost_then] */
hidden_hand_payment_continuation ::= clause_hidden_hand_look "." clause_optional_cost_then

/* An ordinary activation composes its first clause with either hand-exile continuation. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:@then_sequence($clause_before_then, $hand_exile_continuation)}} */
activated_then_hand_exile ::= cost ":" clause_before_then "," "then" hand_exile_continuation "."

/* The source controller's selection, exile arrival, test, and both uses are
   scoped together so the pronoun names exactly the card moved to exile. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:ControllerOf(EventSubject), objects:Zone{scope:Players{zone:Hand, players:One(ControllerOf(EventSubject))}, kind:Card, filter:Any}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$filter_phrase}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}]}, otherwise:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Result{result:@marked, phase:After, index:0}), count:Exactly(Constant(1)), cost:Free, into_exile:false}}]}}]}}] */
instructions_random_source_hand_exile_branch ::= "that" "source's" "controller" "exiles" "a" "card" "from" "their" "hand" "at" "random" "." "if" "it's" "a" filter_phrase "card" "," "you" "may" "put" "it" "onto" "the" "battlefield" "under" "your" "control" "." "otherwise" "," "you" "may" "cast" "it" "without" "paying" "its" "mana" "cost"

/* The event's subject is the damage source, so the dependent hand owner and
   actor remain the source controller within this trigger. */
/* @sem Ability::Triggered{event:$event_source_damage, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$instructions_random_source_hand_exile_branch}} */
triggered_source_hand_exile_branch ::= "whenever" event_source_damage "," instructions_random_source_hand_exile_branch "."

/* Copying an enchanted instant card and the optional cast are linked to the
   payment tested by the following action. The later attachment chooses its
   own graveyard host and keeps that host's filter as a current operand. */
/* @sem Instruction::[Effect{result:@mark, operation:CopyCards{actor:One(AbilityController), objects:One(AttachedTo(Source)), times:Constant(1)}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Copies(@marked), count:Exactly(Constant(1)), cost:Free, into_exile:false}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:Program{instructions:[Effect{result:@next, operation:$exile_objects}, Effect{result:@next, operation:$attach_aura_graveyard_card}]}, otherwise:Program{}}] */
instructions_copy_enchanted_card_paid_followup ::= "copy" "the" "enchanted" "instant" "card" "." "you" "may" "cast" "the" "copy" "without" "paying" "its" "mana" "cost" "." "if" "you" "do" "," exile_objects "and" attach_aura_graveyard_card

/* The host is selected on resolution in any graveyard. */
/* @sem Operation::WithSelections{steps:[_{binding:0, chooser:Players(One(AbilityController)), objects:Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$aura_graveyard_filter}, count:Exactly(Constant(1)), constraints:[]}], action:AttachEach{actor:One(AbilityController), attachments:One(Source), hosts:Objects(Prepared(0)), each_host:false}} */
attach_aura_graveyard_card ::= "attach" "this" "Aura" "to" "another" aura_graveyard_filter "card" "in" "a" "graveyard"

aura_graveyard_filter ::= spell_instant | spell_sorcery | filter_phrase

/* The discard payment and its success branch share the enclosing attachment context. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:EventSubject, cost:_{parts:[$cost_discard_random]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:_{instructions:[Effect{result:@next, operation:SetTapped{objects:One(EventSubject)}}]}, otherwise:_{}}]} */
aura_upkeep_discard_untap ::= "that" "player" "may" cost_discard_random "." "if" "the" "player" "does" "," "untap" "that" "creature"

/* Used only by a spell paired with its singleton creature sacrifice casting cost. */
/* @sem Expr::ObjectProperty{object:Query{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Inputs, phase:Before}, index:0}, property:$receipt_stat, information:CurrentOrLastKnown} */
casting_sacrificed_creature_stat ::= "the" "sacrificed" "creature's" receipt_stat

discard_casting_sacrificed_stat ::= discard_casting_sacrificed_stat_ordered | discard_casting_sacrificed_stat_random

/* @sem Operation::Discard{players:$players_singular, amount:$casting_sacrificed_creature_stat, random:false} */
discard_casting_sacrificed_stat_ordered ::= players_singular "discards" "a" "number" "of" "cards" "equal" "to" casting_sacrificed_creature_stat

/* @sem Operation::Discard{players:$players_singular, amount:$casting_sacrificed_creature_stat, random:true} */
discard_casting_sacrificed_stat_random ::= players_singular "discards" "a" "number" "of" "cards" "equal" "to" casting_sacrificed_creature_stat "at" "random"

/* Two independently filtered target groups share one announced maximum.  This
   phrase is used only in the target-free self-entry trigger below. */
/* @prefer always */
/* @sem Operation::Move{objects:Union([Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo($number_words), filter:AllOf([Not(SameObject(Source)), $plural_atomic])})), Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo($number_words), filter:$card_noun, constraints:[SharesLimitWith(0)]}))]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_shared_battlefield_graveyard_targets ::= "exile" "up" "to" number_words "other" "target" plural_atomic "from" "the" "battlefield" "and" "/" "or" card_noun "cards" "from" "graveyards"

/* A named choice resolves one of two independent programs. The second action
   applies to the controller's opponents other than the referenced player. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseAction{actor:$players_singular, options:[Term{family:NamedAction, form:NamedAction, operands:[Text(Self), List([Program($program)])]}, Term{family:NamedAction, form:NamedAction, operands:[Text(Others), List([Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::Intersection([OthersThan($player_ref), OpponentsOf(AbilityController)]), $verb_operation_third)}]}])]}]}}] */
choice_self_or_others ::= players_singular "chooses" "self" "or" "others" "." "if" player_ref "chooses" "self" "," program "." "if" "the" "player" "chooses" "others" "," "each" "of" "your" "other" "opponents" verb_operation_third

/* A unit drain is repeated for each member of a named live quantity. */
/* @sem Instruction::[Effect{result:@next, operation:LoseLife{players:$players_singular, amount:@times($number, $drain_each_quantity)}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:@times($number_2, $drain_each_quantity)}}] */
counted_unit_drain ::= "for" "each" drain_each_quantity "," players_singular "loses" number "life" "and" "you" "gain" number "life"

drain_each_quantity ::= drain_event_spell_colors | count_each_controlled

/* @sem Expr::ObjectProperty{object:EventSubject, property:ColorCount, information:CurrentOrLastKnown} */
drain_event_spell_colors ::= "of" "that" "spell's" "colors"

/* The producer and consumer remain adjacent: the phrase names this return,
   including the target and its owner-hand destination. */
/* @sem Instruction::[Effect{result:@next, operation:$personal_graveyard_return_hand}, Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:$recipients, amount:$returned_card_property, preventable:true}}] */
returned_card_property_damage ::= personal_graveyard_return_hand "." damage_source_ref "deals" "damage" "to" recipients "equal" "to" returned_card_property

/* Keep the producer and the counted Before receipt in the same reversible phrase. */
/* @sem Instruction::[Effect{result:@next, operation:$sacrifice_variable_population}, Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:Repeat{amount:CountObjects(Transition{result:@prior, phase:Before}), production:$mana_production, choice:Once}}}] */
instructions_sacrifice_receipt_mana ::= sacrifice_variable_population "," "then" "add" "that" "much" mana_production

/* The cloak consumes the single conjured arrival; its grant applies to the
   resulting permanent while that same permanent remains face down. */
/* @sem Instruction::[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Random(Filter(AllOf([$noun, Property{property:ManaValue, test:Compare{comparison:Equal, value:BoundValue(0)}}]))), count:Constant(1), destination:Hand{counters:[], states:[]}}}, Effect{result:@next, operation:Manifest{actor:One(AbilityController), source:Cards(One(Result{result:@prior, phase:After, index:0})), cloak:true, entry:_{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[Mana([$mana_hybrid])]}, limits:_{once:false, once_each_turn:false, sorcery:false, modifiers:[]}, announcement:_{targets:[]}, body:_{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:TurnFaceUp{object:Source}}}]}}))], duration:WhileMatches{object:Result{result:@prior, phase:After, index:0}, filter:State(FaceDown)}, evaluation:Snapshot}}] */
conjure_x_cloak_grant ::= "conjure" "a" "random" noun "card" "with" "mana" "value" "X" "into" "your" "hand" "." "cloak" "it" "." "it" "gains" '"' mana_hybrid ":" "turn" "this" "creature" "face" "up" '"' "for" "as" "long" "as" "it" "remains" "face" "down"

/* The payment's chosen X binds both the threshold and the conjured card. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:_{parts:[ManaWithX{mana:[X]}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:_{instructions:[If{condition:Compare{left:BoundValue(0), test:Compare{comparison:GreaterOrEqual, value:$number_digits}}, then:_{instructions:$conjure_x_cloak_grant}, otherwise:_{instructions:[]}}]}, otherwise:_{instructions:[]}}]} */
program_paid_random_cloak_grant ::= "you" "may" "pay" "{" "X" "}" "." "if" "you" "do" "," "if" "X" "is" number_digits "or" "more" "," conjure_x_cloak_grant "."

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$program_paid_random_cloak_grant} */
triggered_paid_random_cloak_grant ::= event_clause "," program_paid_random_cloak_grant

/* Each player supplies a target partition; the return uses this move's receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:All, each:UpTo($n1)}, filter:AllOf([Not(SameObject(Source)), AnyOf([$noun, $noun_2])])})), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReturnAfter{objects:Transition{result:@prior, phase:After}, duration:WhileOnBattlefield($self_ref)}}] */
