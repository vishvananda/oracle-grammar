/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:$bound_choose_controlled_many}]}}, Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:$players_singular, objects:$choice_unselected_remainder})}] */
