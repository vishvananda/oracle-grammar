instructions_mill_greatest_value_damage ::= "choose" "any" "target" "," "then" "mill" card_count "." object_ref "deals" "damage" "to" "that" "permanent" "or" "player" "equal" "to" "the" "greatest" "mana" "value" "among" "the" "milled" "cards"

/* A bound player chooses from their own hand and moves the selection to exile. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone(_{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), count:AsManyAsCan(Constant(1))}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]} */
bound_exile_hand_selection ::= "exiles" "a" "card" "from" "their" "hand"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(Bound(0))), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([InSet(Transition{result:@marked, phase:After}), OwnedBy(One(Bound(0)))])}), from:Exile, action:CastSpell, filter:Any}, terms:_{cost:Additional(Cost($cost))}}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([InSet(Transition{result:@marked, phase:After}), OwnedBy(One(Bound(0)))])}), from:Exile, action:PlayLand, filter:Any}, terms:_{cost:Normal, effects:[List([Term{family:EnterFlag, form:EntersTapped}])]}})], duration:WhileAnyExiled(Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([InSet(Transition{result:@marked, phase:After}), OwnedBy(One(Bound(0)))])})), evaluation:LiveObjects} */
bound_exiled_card_play_tax ::= "may" "play" "that" "card" "for" "as" "long" "as" "it" "remains" "exiled" "." "each" "spell" "cast" "this" "way" "costs" cost "more" "to" "cast" "." "each" "land" "played" "this" "way" "enters" "tapped"

/* The two loops share the player set, and the permission consumes the hand-exile receipt. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:$bound_exile_hand_selection}, ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_exiled_card_play_tax}]}}] */
clause_each_hand_exile_play_tax ::= players_singular bound_exile_hand_selection "and" bound_exiled_card_play_tax

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([ControlledBy(One(AbilityController)), AnyOf([CardType(Creature), $subtype])])}), kind:$counter_kind, amount:$number}]} */
/* @prefer always */
put_counters_controlled_permanent_types ::= "put" number counter_kind "counters" "on" "each" "permanent" "you" "control" "that's" "a" "creature" "or" subtype

/* A mixed-domain target has one independently scoped mode for each domain.
   The continuation is shared and remains inside each mode's program. */
/* @sem Ability::Spell{announcement:_{modes:_{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:Any}), index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, ...$instructions]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:Any}), index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, ...$instructions]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied}}, body:_{}} */
spell_or_permanent_return_continuation ::= "return" "target" "spell" "or" "permanent" "to" "its" "owner's" "hand" "." instructions "."

/* The announced card is both the shared-type comparison and the returned target. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($chosen_shared_sacrifice_offer, ObjectFilter::Shares{property:CardTypes, with:$chosen_shared_graveyard_target})}, choose:Exactly(Constant(1))}]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:$chosen_card_return_grant_program, otherwise:Program{}}]} */
chosen_card_shared_sacrifice_program ::= "choose" chosen_shared_graveyard_target "." "you" "may" "sacrifice" chosen_shared_sacrifice_offer "." "if" "you" "do" "," chosen_card_return_grant_program

/* The granted ability applies to the actual arrival of this move. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@last_slot, index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[GrantAbility(@scope($chosen_return_departure_ability))], duration:Indefinite, evaluation:Snapshot}}]} */
chosen_card_return_grant_program ::= "return" "the" "chosen" "card" "from" "your" "graveyard" "to" "the" "battlefield" "and" "it" "gains" '"' chosen_return_departure_ability '"'

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$chosen_card_shared_sacrifice_program} */
triggered_turn_chosen_shared_sacrifice ::= "at" turn_event "," chosen_card_shared_sacrifice_program

/* @sem $noun */
chosen_shared_sacrifice_offer ::= "a" noun "that" "shares" "a" "card" "type" "with" "the" "chosen" "card"

/* The announced target is explicitly in its controller's graveyard. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and($card_filter, ObjectFilter::InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}))}), index:0} */
chosen_shared_graveyard_target ::= "target" card_filter "card" "in" "your" "graveyard"

/* A granted permanent ability names its new holder, not the source enchantment. */
/* @sem Ability::Replacement{active:Battlefield, event:Object{event:LeavesBattlefield, objects:SameObject(Source)}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}} */
chosen_return_departure_ability ::= "if" self_permanent "would" "leave" "the" "battlefield" "," "exile" "it" "instead" "of" "putting" "it" "anywhere" "else" "."

/* The announced graveyard target and its battlefield arrival are independent operands. */
/* @sem Operation::Move{objects:One($chosen_arrival_one), destination:Battlefield{controller:Player(AbilityController), arrival:$private_entry_tapped}, qualifiers:[]} */
return_chosen_arrival_battlefield_entry ::= "choose" chosen_arrival_one "." "return" "it" "to" "the" "battlefield" private_entry_tapped

/* Both target domains own the same mana-value restriction and independent
   copies of the simple keyword continuation. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number_digits}}}), index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:$mixed_return_keyword}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number_digits}}}), index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:$mixed_return_keyword}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied} */
mixed_return_mana_keyword_modes ::= "return" "target" "spell" "or" "permanent" "with" "mana" "value" number_digits "or" "greater" "to" "its" "owner's" "hand" "." NEWLINE mixed_return_keyword "."

mixed_return_keyword ::= learn_action | investigate_once

/* @sem Ability::Spell{announcement:_{modes:$mixed_return_mana_keyword_modes}, body:_{}} */
spell_mixed_return_mana_keyword ::= mixed_return_mana_keyword_modes

/* A target in your graveyard whose characteristic compares to its source. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$subtype, $noun, $graveyard_source_stat_filter, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0} */
target_owned_graveyard_source_stat ::= "target" subtype noun "card" "in" "your" "graveyard" graveyard_source_stat_filter

/* The choice announces the target; the return produces the arrival for the delayed sacrifice. */
/* @sem Operation::Move{objects:One($target_owned_graveyard_source_stat), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}, qualifiers:[]} */
choose_graveyard_combat_return ::= "choose" target_owned_graveyard_source_stat "." "return" "that" "card" "to" "the" "battlefield" "tapped" "and" "attacking"

/* @sem Instruction::[Effect{result:@mark, operation:$choose_graveyard_combat_return}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:One(Result{result:@marked, phase:After, index:0})})}]}}}] */
instructions_target_graveyard_combat_return ::= choose_graveyard_combat_return "." "sacrifice" "it" "at" "the" "beginning" "of" "the" "next" "end" "step"

 graveyard_source_stat_filter ::= graveyard_source_power_filter | graveyard_source_toughness_filter

/* @sem ObjectFilter::Property{property:Power, test:NumberTest::Compare{comparison:$stat_comparison, value:ObjectProperty{object:Source, property:Power, information:CurrentOrLastKnown}}} */
graveyard_source_power_filter ::= "with" "power" stat_comparison "this" "creature's" "power"

/* @sem ObjectFilter::Property{property:Toughness, test:NumberTest::Compare{comparison:$stat_comparison, value:ObjectProperty{object:Source, property:Toughness, information:CurrentOrLastKnown}}} */
graveyard_source_toughness_filter ::= "with" "toughness" stat_comparison "this" "creature's" "toughness"

/* The blocked creature and the blocker are distinct announced targets. */
/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), Condition(Compare{left:EventHistory{event:Pair{event:BecomesBlockedBy, objects:SameObject(Candidate), others:SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$subtype}), index:0})}, window:ThisTurn, measure:Occurrences}, test:Compare{comparison:GreaterOrEqual, value:Constant(1)}})])}), index:0})), kind:$counter_kind, amount:ObjectProperty{object:Target{slot:1, index:0}, property:$blocked_creature_stat, information:CurrentOrLastKnown}}]}}] */
blocked_target_property_counters ::= "put" "X" counter_kind "counters" "on" "target" "creature" "that" "target" subtype "blocked" "this" "turn" "," "where" "X" "is" "the" blocked_creature_stat "of" "that" "blocked" "creature"

blocked_creature_stat ::= stat_power | stat_toughness

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@last_slot, index:0})), changes:[GrantAbility(@holder($counter_untap_granted)), GrantAbility(@holder($counter_upkeep_granted))], duration:Indefinite, evaluation:Snapshot}}] */
blocked_creature_granted_counter_pair ::= "the" "creature" "gains" '"' counter_untap_granted '"' "and" '"' counter_upkeep_granted '"'

/* @sem Ability::Spell{body:_{instructions:[...$blocked_target_property_counters, ...$blocked_creature_granted_counter_pair]}, announcement:@announcement} */
spell_blocked_counter_grant_pair ::= blocked_target_property_counters "." blocked_creature_granted_counter_pair

/* The pair is a battlefield population; each object returns to its own owner. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($object_ref), SameObject($object_ref_2)])} */
return_referenced_pair ::= object_ref "and" object_ref

/* @sem Operation::Move{objects:$return_referenced_pair, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_pair_owners_hand ::= "return" return_referenced_pair "to" "their" "owners'" "hands"

/* @sem Operation::CreateDelayedTrigger{event:$return_pair_time, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:$return_pair_owners_hand}]}} */
delayed_return_pair_owners_hand ::= return_pair_owners_hand "at" return_pair_time

return_pair_time ::= turn_end_combat | delayed_move_end_event

/* The singular graveyard return produces the arrival used by both followups. */
/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:AllOf([AnyOf([$noun, $noun_2]), InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_optional_union_to_battlefield ::= "return" "up" "to" "one" "target" noun "or" noun "card" "from" "your" "graveyard" "to" "the" "battlefield"

/* This continuation is used only with the singular return producer below. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[GrantKeyword($keyword_name)], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@back(4), phase:After, index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}] */
returned_grant_delayed_exile ::= "it" "gains" keyword_name "." "exile" "it" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* @sem Instruction::[Effect{result:@next, operation:$return_optional_union_to_battlefield}, ...$returned_grant_delayed_exile] */
instructions_return_union_grant_delayed_exile ::= return_optional_union_to_battlefield "." returned_grant_delayed_exile

/* A player chooses which population performs an independently specified action.
   Each branch retains its own action and the same announced player identity. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseAction{actor:One($target_opponent), options:[Term{family:NamedAction, form:NamedAction, operands:[Text(Self), List([Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One($target_opponent), $verb_operation_third)}]}])]}, Term{family:NamedAction, form:NamedAction, operands:[Text(Others), List([Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::Intersection([OthersThan($target_opponent), OpponentsOf(AbilityController)]), $verb_operation_third_2)}]}])]}]}}] */
instructions_opponent_self_or_others ::= target_opponent "chooses" "self" "or" "others" "." "if" "that" "player" "chooses" "self" "," "the" "player" verb_operation_third "." "if" "the" "player" "chooses" "others" "," "each" "of" "your" "other" "opponents" verb_operation_third

/* Announce a graveyard card, then branch on one of its current properties. */
/* @sem Instruction::[If{condition:ObjectMatches{object:$choose_cast_graveyard_in, filter:Property{property:$stat, test:NumberTest::Compare{comparison:$stat_comparison, value:$value}}}, then:Program{instructions:$chosen_card_entry}, otherwise:$program}] */
instructions_chosen_card_property_branch ::= "choose" choose_cast_graveyard_in "." chosen_card_entry "if" "its" stat "is" stat_comparison value "." "otherwise" "," program

/* The entry refers to the previously announced card, not a new target. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One(Target{slot:@last_slot, index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
chosen_card_entry ::= "return" "that" "card" "to" "the" "battlefield"

/* The target player also fixes the opposing controllers and destination. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChangeCombat{change:AssignAttack{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:AnyNumber, filter:AllOf([Attacking, @agree($filter_plural, $filter_plural_2), ControlledBy(OpponentsOf($reassign_target_player))])})), to:Term{family:AttackAssignment, form:Player, operands:[Player(Target{slot:0, index:0})]}}}}]} */
program_sentence_reassign_attackers ::= "choose" reassign_target_player "and" "any" "number" "of" "target" "attacking" filter_plural "their" "opponents" "control" "." "those" filter_plural "are" "now" "attacking" "that" "player" "."

reassign_target_player ::= target_player | target_opponent

/* Both actions refer to the object named before the pronoun. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($object_ref)), changes:[SetController($attacking_player)], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:SetTapped{objects:One($object_ref), tapped:false}}] */
clause_player_gains_control_untaps ::= "the" attacking_player "gains" "control" "of" object_ref "and" "untaps" "it" /* @prefer always */

/* The optional single-card move and the condition share the actual exile
   result. The revealed hand and the choice have the same owner. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($hand_player)}, kind:Card, filter:Any}}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One($hand_player)}, kind:Card, filter:$adjective_nontype}, count:AsManyAsCan(Constant(1))}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$exiled_kind}, then:Program{instructions:$instructions}, otherwise:Program{}}] */
instructions_observed_hand_exile_condition ::= hand_player "reveals" "their" "hand" "." "you" "may" "choose" "a" adjective_nontype "card" "from" "it" "." "if" "you" "do" "," "that" "player" "exiles" "that" "card" "." "if" exiled_kind "card" "is" "exiled" "this" "way" "," instructions

/* These nouns take the article a in both choice positions. */
secret_choice_noun ::= noun_creature | noun_land | noun_planeswalker

/* The two secret selections describe the same kind of object, with different controllers. */
/* @sem ObjectFilter::@agree($secret_choice_noun, $secret_choice_noun_2) */
secret_opposite_control_pair ::= secret_choice_noun "they" "control" "and" "a" secret_choice_noun "they" "don't" "control"

/* Keep the chosen-object consumer in the same scope as both secret producers. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseValue(_{choosers:One(Bound(0)), kind:Object, terms:_{options:[Objects(Zone(_{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($secret_opposite_control_pair, $secret_choice_noun), ControlledBy(One(Bound(0)))])}))], count:Exactly(Constant(1)), secret:true}})}]}}, ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseValue(_{choosers:One(Bound(0)), kind:Object, terms:_{options:[Objects(Zone(_{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($secret_opposite_control_pair, $secret_choice_noun), ControlledBy(OthersThan(Bound(0)))])}))], count:Exactly(Constant(1)), secret:true}})}]}}, Effect{result:@next, operation:RevealChoices{kind:Object}}, Effect{result:@next, operation:Destroy{objects:Zone(_{scope:Shared(Battlefield), kind:Permanent, filter:InSet(Earlier{what:Selected})}), regeneration:true}}] */
instructions_secret_opposite_choices_destroy ::= players_singular "secretly" "chooses" "a" secret_opposite_control_pair "." "then" "those" "choices" "are" "revealed" "." "destroy" "each" secret_choice_noun "chosen" "this" "way"

/* The creature is the arrival of this specific graveyard move; both later
   effects refer to that same arrival, including the replacement duration. */
/* @sem Instruction::[ $return_colored_creature_graveyard, ...$returned_creature_upkeep_exile ] */
instructions_return_creature_grant_exile ::= return_colored_creature_graveyard "." returned_creature_upkeep_exile

/* @sem Instruction::Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([AnyOf([$adjective_color, $adjective_color_2]), CardType(Creature), InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}} */
return_colored_creature_graveyard ::= "return" "target" adjective_color "or" adjective_color "creature" "card" "from" "your" "graveyard" "to" "the" "battlefield"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[GrantAbility(Mechanic{mechanic:CumulativeUpkeep, cost:_{parts:[Mana($mana_symbols)]}})], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateReplacement{event:Object{event:LeavesBattlefield, objects:SameObject(Result{result:@back(3), phase:After, index:0})}, limit:UntilExpired, duration:WhileOnBattlefield(Result{result:@back(3), phase:After, index:0}), body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}}}] */
returned_creature_upkeep_exile ::= "that" "creature" "gains" '"' "cumulative" "upkeep" mana_symbols "." '"' "if" "the" "creature" "would" "leave" "the" "battlefield" "," "exile" "it" "instead" "of" "putting" "it" "anywhere" "else"

/* Both the conditional check and return refer to this single conjured arrival. */
/* @sem Instruction::[Effect{result:@mark, operation:Conjure{actor:One(AbilityController), card:Named($referenced_card_name), count:Constant(1), destination:Battlefield{tapped:true, states:[Attacking{}]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, intervening_if:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:InZone(Shared(Battlefield))}, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@marked, phase:After, index:0}), destination:OwnersHand{}}}]}}}] */
instructions_conjure_attacking_delayed_return ::= "conjure" "a" "card" "named" referenced_card_name "onto" "the" "battlefield" "tapped" "and" "attacking" "." "at" "the" "beginning" "of" "the" "next" "end" "step" "," "if" "that" "card" "is" "on" "the" "battlefield" "," "return" "it" "to" "its" "owner's" "hand"

/* The choice and attachment share the immediately preceding result. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Transform{object:Source}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun, ControlledBy(One(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Attach{attachments:One(Source), host:Result{result:@prior, phase:After, index:0}}}]} */
program_transform_enchantment_attach_controlled ::= "transform" "this" "enchantment" "," "then" "attach" "it" "to" "a" noun "you" "control" "."

/* The player putting the card onto the battlefield also controls its arrival. */
/* @sem Operation::Move{objects:One($target_card_your_graveyard), destination:Battlefield{controller:Player($target_active_opponent), arrival:BattlefieldArrival{}}, qualifiers:[]} */
active_opponent_puts_graveyard_card ::= target_active_opponent "puts" target_card_your_graveyard "onto" "the" "battlefield" "under" "their" "control"

/* All three later instructions refer to the arrival of this same move. */
/* @sem Instruction::[Effect{result:@mark, operation:$active_opponent_puts_graveyard_card}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@marked, phase:After, index:0})), changes:[GrantKeyword($keyword_value)], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Goad{object:Result{result:@marked, phase:After, index:0}}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_move_end_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@marked, phase:After, index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]}}}] */
instructions_opponent_entry_grant_goad ::= active_opponent_puts_graveyard_card "." "it" "gains" keyword_value "." "goad" "it" "." "at" delayed_move_end_event "," "exile" "it"

/* The two domains retain separate announcements while sharing the movement,
   controller restriction, permanent filter and owner-directed destination. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:ControlledBy($mixed_target_controller)}), index:0}), destination:$put_exiled_singular_destination, qualifiers:[]}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$mixed_controlled_permanent, ControlledBy($mixed_target_controller)])}), index:0}), destination:$put_exiled_singular_destination, qualifiers:[]}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied} */
mixed_controlled_move_modes ::= "return" "target" "spell" "or" mixed_controlled_permanent mixed_target_controller "to" put_exiled_singular_destination

/* @sem Ability::Spell{announcement:Announcement{modes:$mixed_controlled_move_modes}, body:Program{}} */
spell_mixed_controlled_move ::= mixed_controlled_move_modes "."

/* The repeated noun names the same target in both conditional copy branches. */
/* @sem Instruction::[If{condition:$condition, then:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@agree($filter_phrase, $filter_phrase_2)}), index:0}, exceptions:$conditional_copy_exceptions}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@agree($filter_phrase, $filter_phrase_2)}), index:0}, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}] */
instructions_conditional_copy_exception ::= "create" "a" "token" "that's" "a" "copy" "of" "target" filter_phrase "." "if" condition "," "instead" "create" "a" "token" "that's" "a" "copy" "of" "that" filter_phrase "," "except" conditional_copy_exceptions

conditional_copy_exceptions ::= conditional_copy_token_grant

/* @sem Vec<CopyException>::[CopyException::AddAbilities([@scope($token_entry_conditional_fight)])] */
/* @prefer always */
conditional_copy_token_grant ::= "the" "token" "has" '"' token_entry_conditional_fight '"'

/* A targeted creature's characteristics can be read before and after a delayed
   return. Keep the exile producer and its delayed consumer in the same frame. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One($memory_target_creature), destination:Exile{visibility:FaceUp, arrival:_{}}}}, Effect{result:@next, operation:$draw_target_creature_stat}, Effect{result:@next, operation:$return_exiled_creature_stat_discard}]}} */
spell_exile_draw_return_stat ::= "exile" memory_target_creature "." draw_target_creature_stat "." return_exiled_creature_stat_discard "."

memory_target_creature ::= memory_plain_target_creature | memory_qualified_target_creature

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$noun_creature}), index:0} */
memory_plain_target_creature ::= "target" noun_creature

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($quality_unscoped, $noun_creature)}), index:0} */
memory_qualified_target_creature ::= "target" quality_unscoped noun_creature

/* @sem Operation::Draw{players:One(AbilityController), amount:ObjectProperty{object:Target{slot:0, index:0}, property:$creature_stat, information:CurrentOrLastKnown}} */
draw_target_creature_stat ::= "you" "draw" "cards" "equal" "to" "that" "creature's" creature_stat

/* @sem Operation::CreateDelayedTrigger{event:Turn{point:UpkeepBegins, players:One(AbilityController)}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@back(4), phase:After}, zone:Exile}, destination:Battlefield{controller:Owner, arrival:_{}}}}, If{condition:Compare{left:CountObjects(Transition{result:@last_result, phase:After}), test:Compare{comparison:Greater, value:Constant(0)}}, then:_{instructions:[Effect{result:@next, operation:Discard{players:One(AbilityController), amount:ObjectProperty{object:Result{result:@prior, phase:After, index:0}, property:$creature_stat, information:CurrentOrLastKnown}}}]}, otherwise:_{}}]}} */
return_exiled_creature_stat_discard ::= "at" "the" "beginning" "of" "your" "next" "upkeep" "," "return" "that" "card" "to" "the" "battlefield" "under" "its" "owner's" "control" "." "if" "you" "do" "," "discard" "cards" "equal" "to" "that" "creature's" creature_stat

/* A random battlefield selection is retained for the subsequent instructions. */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]} */
random_battlefield_creature_choice ::= "choose" "a" "creature" "at" "random"

/* The three effects refer to the same marked choice, with independent durations. */
/* @sem Vec<Instruction>::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@marked, phase:After, index:0})), changes:[SetController(AbilityController)], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:SetTapped{objects:One(Result{result:@marked, phase:After, index:0}), tapped:false}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@marked, phase:After, index:0})), changes:[GrantKeyword($keyword_name)], duration:$duration_2, evaluation:Snapshot}}] */
random_creature_control_untap_keyword ::= "you" "gain" "control" "of" "that" "creature" duration "." "untap" "it" "." "it" "gains" keyword_name duration

/* The unselected remainder belongs to the same random choice. */
/* @sem Ability::Spell{body:Program{instructions:[Effect{result:@mark, operation:$random_battlefield_creature_choice}, ...$random_creature_control_untap_keyword, Effect{result:@next, operation:Destroy{objects:Unselected(@marked), regeneration:true}}]}, announcement:@announcement} */
spell_random_creature_control_remainder ::= random_battlefield_creature_choice "." random_creature_control_untap_keyword "." "then" "destroy" "all" "other" "creatures" "."

/* A bounded battlefield exile supplies the actual arrivals to its follow-up. */
/* @sem Operation::Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$plural_either, Property{property:ManaValue, test:Compare{comparison:LessOrEqual, value:$value}}])}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_battlefield_pair_mana_ceiling ::= "exile" "all" plural_either "with" "mana" "value" value "or" "less"

/* @sem Ability::Casting(AdditionalCost{cost:_{parts:[Mana($mana_symbols)]}, optional:false, repetition:Once}) */
quoted_spell_additional_mana ::= '"' "this" "spell" "costs" mana_symbols "more" "to" "cast" '"'

/* @sem Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject(Source)}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}]}} */
quoted_permanent_enters_tapped ::= '"' "this" "permanent" "enters" "tapped" "." '"'

/* This scoped phrase ties both subsequent effects to the same exile arrival. */
/* @sem Ability::Spell{announcement:_{targets:[]}, body:_{instructions:[Effect{result:@mark, operation:$exile_battlefield_pair_mana_ceiling}, Effect{result:@next, operation:CreatePerpetualEffect{objects:Transition{result:@marked, phase:After}, changes:[GrantAbility($quoted_spell_additional_mana), GrantAbility($quoted_permanent_enters_tapped)]}}, ForEachObject{objects:Transition{result:@marked, phase:After}, binding:0, body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(OwnerOf(Bound(0)))), changes:[PlayerRule(PlayPermission{cards:One(Bound(0)), from:Exile, action:Either, filter:Any})], duration:WhileExiled(Bound(0)), evaluation:LiveObjects}}]}}]}} */
spell_exile_pair_perpetual_owner_permission ::= exile_battlefield_pair_mana_ceiling "." "they" "perpetually" "gain" quoted_spell_additional_mana "and" quoted_permanent_enters_tapped "for" "as" "long" "as" "each" "of" "them" "remain" "exiled" "," "its" "owner" "may" "play" "it" "."

/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$player_ref, cost:$counter_unless_defined_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One($named_spell), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}] */
clause_counter_unless_player ::= "counter" named_spell "unless" player_ref "pays" counter_unless_defined_cost

/* @sem Cost::@payment_cost(Cost::Cost{parts:[Mana($mana_symbols)]}, $counter_defined_value) */
counter_unless_defined_cost ::= mana_symbols "," "where" "X" "is" counter_defined_value

counter_defined_value ::= value | counter_defined_card_count

/* @sem Expr::CountObjects($card_population_same_name_the_spell) */
counter_defined_card_count ::= "the" "number" "of" card_population_same_name_the_spell

/* A single filtered card can be returned as a resolving payment. */
/* @sem Cost::Cost{parts:[Move{selections:[_{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, choose:Exactly(Constant(1))}], destination:OwnersHand(CardArrival{counters:[], states:[]})}]} */
/* @prefer always */
payment_return_graveyard_filtered_an ::= "return" "an" filter_phrase "card" "from" "your" "graveyard" "to" "your" "hand"

/* The color choice and temporary trigger compose independently of activation cost. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$choose_a_color}, Effect{result:@next, operation:$chosen_color_combat_trigger}]} */
program_chosen_color_combat_trigger ::= choose_a_color "." chosen_color_combat_trigger "."

/* @sem Operation::CreateTrigger{event:$event_blocked_by_chosen_color, duration:$this_duration, announcement:@announcement, body:Program{instructions:$block_pair_other_action}} */
chosen_color_combat_trigger ::= "whenever" event_blocked_by_chosen_color this_duration "," block_pair_other_action

/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:One(BlockPair(Other)), regeneration:true}}] */
block_pair_other_action ::= "destroy" "that" "creature"

/* Temporary entry replacements bind an entry event to its owner-directed response. */
/* @sem Operation::CreateReplacement{event:$temporary_entry_event, limit:UntilExpired, duration:$temporary_entry_duration, body:$temporary_entry_response} */
temporary_entry_redirect ::= temporary_entry_duration "," "if" temporary_entry_event "," temporary_entry_response

/* @sem ReplacementEvent::Enter{objects:AllOf([$filter_plural, AnyOf([EnteredFrom(Shared(Exile)), Cast{from:Shared(Exile)}])])} */
temporary_entry_event ::= "one" "or" "more" filter_plural "would" "enter" "from" "exile" "or" "after" "being" "cast" "from" "exile"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(OwnersLibraryShuffled)}}]} */
temporary_entry_response ::= "their" "owners" "shuffle" "them" "into" "their" "libraries" "instead"

/* Prefer the leading-duration wording within this entry replacement. */
temporary_entry_duration ::= temporary_entry_combat_duration | duration

/* @prefer always */
/* @sem Duration::EndOfCombat */
temporary_entry_combat_duration ::= "until" "end" "of" "combat"

/* The offered transfer and its dependent untap share the same attached object.
   The active turn player performs the transfer and becomes its controller. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:EventSubject, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($attached_ref)), changes:[SetController(EventSubject)], duration:$duration, evaluation:Snapshot}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:SetTapped{objects:One($attached_ref), tapped:false}}]}, otherwise:Program{}}]} */
program_turn_player_control_attached_untap ::= "you" "may" "have" "that" "player" "gain" "control" "of" attached_ref duration "." "if" "you" "do" "," "untap" "it" "."

/* The qualification and both options retain the same bound choosing player. */
/* @sem Instruction::[ForEachPlayer{players:$players_lost_life_threshold, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseAction{actor:One(Bound(0)), options:[Program($villainous_option), Program($villainous_option_2)], villainous:true}}]}}] */
clause_villainous_qualified_program ::= players_lost_life_threshold "faces" "a" "villainous" "choice" "—" villainous_option "," "or" villainous_option

/* A singular card's owner remains the destination owner. */
/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
linked_pile_owners_hand ::= "into" "its" "owner's" "hand"

/* @sem MovementDestination::OwnersGraveyard(CardArrival{counters:[], states:[]}) */
linked_pile_owners_graveyard ::= "into" "its" "owner's" "graveyard"

linked_pile_destination ::= linked_pile_owners_hand | linked_pile_owners_graveyard

/* @sem Operation::Move{objects:$linked_exiled_pile_card, destination:$linked_pile_destination, qualifiers:[]} */
put_linked_pile_card ::= "put" linked_exiled_pile_card linked_pile_destination

/* The two alternatives have independent target scopes and filters. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:AllOf([Not(SameObject(@current_named_object)), $noun])}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:$noun_2}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied} */
exile_other_permanent_or_graveyard_card_modes ::= "exile" "up" "to" "one" "other" "target" noun "from" "the" "battlefield" "or" noun "card" "from" "a" "graveyard"

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:Announcement{modes:$exile_other_permanent_or_graveyard_card_modes}, body:Program{}} */
triggered_exile_other_or_graveyard_modes ::= event_clause "," exile_other_permanent_or_graveyard_card_modes "."

/* The attempted object remains the event subject even if destruction fails. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:One(EventSubject), regeneration:true}}] */
destroy_event_subject ::= "destroy" "it"

/* The controller chooses a host and the attach action consumes that choice. */
/* @sem Instruction::Optional{decider:ControllerOf(EventSubject), body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:ControllerOf(EventSubject), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$attachment_choice_noun}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Attach{attachments:One(Source), host:Result{result:@prior, phase:After, index:0}}}]}} */
event_land_controller_attach_choice ::= "that" "land's" "controller" "may" "attach" "this" "Aura" "to" "a" attachment_choice_noun "of" "their" "choice"

attachment_choice_noun ::= noun_land | noun_creature | noun_planeswalker

/* Each target's current controller independently decides whether to pay. */
/* @sem Instruction::ForEachObject{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:OpponentsOf(AbilityController), each:UpTo(Constant(1))}, filter:@or($noun, $noun_2)})), binding:0, body:_{instructions:[ForEachPlayer{players:One(ControllerOf(Bound(0))), binding:0, body:_{instructions:[Effect{result:@next, operation:PayCost{player:Bound(0), cost:_{parts:[Move{selections:[_{objects:One(Bound(0))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}, optional:true}}]}}]}} */
per_opponent_target_controller_exile ::= "for" "each" "opponent" "," "choose" "up" "to" "one" "target" noun "or" noun "that" "player" "controls" "." "for" "each" "permanent" "chosen" "this" "way" "," "its" "controller" "may" "exile" "it"

/* The counted Before receipt belongs to this immediately preceding discard. */
/* @sem Instruction::[Effect{result:@next, operation:Discard{players:One(AbilityController), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})}}, Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:$players_singular, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(CountObjects(Transition{result:@prior, phase:Before}))})}] */
instructions_discard_hand_sacrifice_receipt ::= "discard" "your" "hand" "." players_singular "sacrifices" "a" filter_phrase "of" "their" "choice" "for" "each" "card" "discarded" "this" "way"

/* The sacrifice and its reflexive copy share one receipt; the copied object is
   the sacrificed Aura before movement, attached to each bound creature. */
/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[Mana($mana_symbols)]}}}, Effect{result:@mark, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Subtype(Aura), AttachedTo(SameObject(Source))])}, choose:AsManyAsCan(Constant(1))})}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:_{instructions:[ForEachObject{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), Attacking, $noun_creature, ControlledBy(One(AbilityController))])}, binding:0, body:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Query{objects:Transition{result:@marked, phase:Before}, index:0}, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo(Bound(0))]}}}]}}]}})}]}}] */
instructions_pay_sacrifice_aura_copies ::= "you" "may" "pay" mana_symbols "and" "sacrifice" "an" "Aura" "attached" "to" SELF_NAME "." "when" "you" "sacrifice" "an" "Aura" "this" "way" "," "for" "each" "other" "attacking" noun_creature "you" "control" "," "create" "a" "token" "that's" "a" "copy" "of" "that" "Aura" "attached" "to" "that" "creature"

/* Each mode announces its own opponent target and retains its operation operands. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One($target_opponent), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$noun}, choose:AsManyAsCan(Constant(1))})}]} */
target_opponent_sacrifice_mode ::= target_opponent "sacrifices" "a" noun "of" "their" "choice"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Discard{players:One($target_opponent), amount:$number}}]} */
target_opponent_discard_mode ::= target_opponent "discards" number "cards"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:LoseLife{players:One($target_opponent), amount:$number}}]} */
target_opponent_lose_life_mode ::= target_opponent "loses" number "life"

/* The selection, perpetual change, and permission share one random singleton. */
/* @sem Instruction::[Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([$subtype_negated, AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)])])}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@marked, phase:After, index:0}), changes:[...$random_perpetual_artifact_changes, GrantAbility($random_perpetual_quoted_activation)]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Graveyard, action:Either, filter:Any}, terms:_{cost:Normal, into_exile:false, effects:[], flash:false, may_look:false}})], duration:WhileMatches{object:Result{result:@marked, phase:After, index:0}, filter:InZone(Players{zone:Graveyard, players:All})}, evaluation:LiveObjects}}] */
instructions_random_graveyard_perpetual_permission ::= "a" "random" subtype_negated "permanent" "card" "in" "your" "graveyard" "perpetually" random_perpetual_artifact_changes "and" "gains" random_perpetual_quoted_activation "you" "may" "play" "that" "card" "for" "as" "long" "as" "it's" "in" "your" "graveyard"

/* @sem Change::[AddArtifactType(Food), AddCardType(Artifact)] */
random_perpetual_artifact_food ::= "becomes" "a" "Food" "artifact" "in" "addition" "to" "its" "other" "types"

/* @sem Change::[AddArtifactType(Clue), AddCardType(Artifact)] */
random_perpetual_artifact_clue ::= "becomes" "a" "Clue" "artifact" "in" "addition" "to" "its" "other" "types"

random_perpetual_artifact_changes ::= random_perpetual_artifact_food | random_perpetual_artifact_clue

/* @sem Ability::@holder(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program_sentence}) */
random_perpetual_quoted_activation ::= '"' cost ":" program_sentence '"'

/* The optional transform consumes the singular conjured battlefield arrival. */
/* @sem Instruction::[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Named($referenced_card_name), count:Constant(1), destination:Battlefield(BattlefieldArrival{tapped:false, counters:[], states:[]})}}, Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Transform{object:Result{result:@prior, phase:After, index:0}}}}]}}] */
instructions_conjure_named_optional_transform ::= "conjure" "a" "card" "named" referenced_card_name "onto" "the" "battlefield" "and" "you" "may" "transform" "it"

/* A later condition replaces the complete preceding instruction sequence. */
/* @sem Instruction::[If{condition:$condition_two_named_types, then:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:$token_groups, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:_{instructions:$instructions_conjure_named_optional_transform}}] */
instructions_conjure_transform_instead_tokens ::= instructions_conjure_named_optional_transform "." "if" condition_two_named_types "," "instead" "create" token_groups

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:_{instructions:$instructions_conjure_transform_instead_tokens}} */
triggered_conjure_transform_instead_tokens ::= event_clause "," instructions_conjure_transform_instead_tokens "."

/* The follow-up refers to the actual creatures tapped by the immediately preceding action. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$adjective_noncolor, CardType(Creature)])}, tapped:true}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Transition{result:@prior, phase:Before}), changes:[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})], duration:DuringControllersNextUntapStep, evaluation:LiveObjects}}]} */
program_tap_creatures_skip_receipt ::= "tap" "all" adjective_noncolor "creatures" "." "those" "creatures" "don't" "untap" "during" "their" "controllers'" "next" "untap" "steps"

/* The target of the placement is also the recipient of the conditional grant. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($target_permanent)), kind:$counter_kind, amount:Constant(1)}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@last_slot, index:0})), changes:[GrantAbilityIfAbsent(@scope($quoted_counter_upkeep_ability))], duration:Indefinite, evaluation:Snapshot}}]} */
program_target_counter_conditional_grant ::= "put" "a" counter_kind "counter" "on" target_permanent "." "if" "it" "doesn't" "have" '"' quoted_counter_upkeep_ability "," '"' "it" "gains" "that" "ability"

/* The quoted ability belongs to the affected permanent and uses its own controller. */
/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$quoted_counter_upkeep_body} */
quoted_counter_upkeep_ability ::= "at" turn_event "," quoted_counter_upkeep_body

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[Repeated{part:Mana($mana_symbols), times:CountCounters(_{recipients:Objects(One(Source)), kind:$counter_kind, information:CurrentOrLastKnown})}]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:_{instructions:[Effect{result:@next, operation:Destroy{objects:One(Source), regeneration:true}}]}, otherwise:_{}}]} */
quoted_counter_upkeep_body ::= "destroy" "this" "creature" "unless" "you" "pay" mana_symbols "for" "each" counter_kind "counter" "on" "it"

/* The sacrificing players and the permanent qualification are independent operands. */
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:$players_singular, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$controlled_permanent_predicate}}) */
sacrifice_controlled_qualified_permanents ::= players_singular "sacrifices" "all" "permanents" "they" "control" "that" "are" controlled_permanent_predicate

/* The explicit origin and ownership both apply to the targeted permanent. */
/* @sem Operation::Move{objects:One($owned_battlefield_target), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_owned_target_from_battlefield ::= "return" owned_battlefield_target "from" "the" "battlefield" "to" "your" "hand"

/* A counter quantity and the source population are independent operands. */
/* @sem MovedCounters::All */
transfer_counter_all ::= "all"

/* @sem MovedCounters::AnyNumber */
transfer_counter_any ::= "any" "number" "of"

transfer_counter_quantity ::= transfer_counter_all | transfer_counter_any

/* @sem ObjectSet::$affected */
transfer_counter_from ::= "from" affected

/* @sem ObjectSet::$affected */
transfer_counter_from_among ::= "from" "among" affected

transfer_counter_source ::= transfer_counter_from | transfer_counter_from_among

/* @sem ObjectSet::One($transfer_second_target) */
transfer_counter_second_destination ::= transfer_second_target

transfer_counter_destination ::= affected | transfer_counter_second_destination

/* @sem Operation::MoveCounters{actor:One(AbilityController), from:$transfer_counter_source, to:$transfer_counter_destination, amount:$transfer_counter_quantity} */
transfer_counters ::= "move" transfer_counter_quantity "counters" transfer_counter_source "onto" transfer_counter_destination

/* @sem Operation::$transfer_counters */
then_transfer_counters ::= "then" transfer_counters

/* A resolution payment and its counter receipt are scoped together. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:AmongThem(AnyNumber)}]}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($self_explicit_ref)), kind:$counter_kind_2, amount:Multiply([Constant(2), PaidCountersRemoved{payment:Resolution(@marked), component:[0]}])}]}}]}, otherwise:Program{}}] */
instructions_remove_among_payment_twice ::= "you" "may" "remove" "any" "number" "of" counter_kind "counters" "from" "among" affected "." "if" "you" "do" "," "put" "twice" "that" "many" counter_kind "counters" "on" self_explicit_ref

/* These followups share the marked exile producer with both permissions. */
/* @sem Instruction::[...$permission_exile_library_many, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:Either, filter:Any})], duration:$until_end_of_your_next_turn, evaluation:LiveObjects}}, If{condition:$condition_cast_from_graveyard, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:Either, filter:Any}, terms:_{cost:Free}})], duration:$until_end_of_your_next_turn, evaluation:LiveObjects}}]}, otherwise:Program{}}] */
instructions_exile_play_conditional_free ::= permission_exile_library_many "." until_end_of_your_next_turn "," "you" "may" "play" "those" "cards" "." "if" condition_cast_from_graveyard "," "you" "may" "play" "cards" "this" "way" "without" "paying" "their" "mana" "costs"

/* The player whose library is exiled is independent of the permission holder. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:EventAmount, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:PlayLand, filter:Any})], duration:Indefinite, evaluation:LiveObjects}}] */
instructions_player_exile_event_lands ::= player_ref "exiles" "that" "many" "cards" "from" "the" "top" "of" "their" "library" "." "you" "may" "play" "lands" "from" "among" "those" "cards" "for" "as" "long" "as" "they" "remain" "exiled"

/* This continuation is used after an explicit choice of a target spell. Its
   counted price is restricted to live private-zone populations, not receipts. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:Any}), index:0}), cost:Cost{parts:[Repeated{part:Mana($mana_symbols), times:$count_each_zone_card}]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@last_slot, index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}] */
chosen_spell_counter_for_each ::= "counter" "the" "chosen" "spell" "unless" "its" "controller" "pays" mana_symbols "for" "each" count_each_zone_card

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$operation_imperative}, ...$chosen_spell_counter_for_each]}} */
spell_choose_target_before_operation_counter ::= "choose" "target" "spell" "." operation_imperative "," "then" chosen_spell_counter_for_each "."

/* The chosen object and the copy effect share this selection receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@marked, phase:After, index:0})), changes:[CopyOf{object:$copy_model_ref, exceptions:[$retained_copy_exception]}], duration:Indefinite, evaluation:Snapshot}}] */
instructions_chosen_copy_retaining ::= "choose" "a" filter_phrase "you" "control" "." "it" "becomes" "a" "copy" "of" copy_model_ref "except" retained_copy_exception

/* @sem CopyException::KeepName */
retained_copy_exception ::= "for" "its" "name"

/* Three independently optional recipients take the same damage. */
/* @sem Operation::DealDamage{source:$it_ordinary_pronoun, recipients:Union([Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:$noun}), index:0})), Players(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:UpTo(Constant(1)), filter:Any, players:All}), index:0})), Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:$noun_2}), index:0}))]), amount:$number, preventable:true} */
shared_optional_three_target_damage ::= it_ordinary_pronoun "deals" number "damage" "to" "each" "of" "up" "to" "one" "target" noun "," "up" "to" "one" "target" "player" "," "and" "/" "or" "up" "to" "one" "target" noun

/* The marked one-card exile and its permission form a single receipt scope. */
/* @sem Program::Program{instructions:[...$card_exile_value_producer, ...$fronted_exile_card_permission]} */
fronted_exile_card_program ::= card_exile_value_producer "." fronted_exile_card_permission

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:$fronted_permission_duration, evaluation:LiveObjects}}] */
fronted_exile_card_permission ::= fronted_permission_duration "," "you" "may" "play" "that" "card"

/* Keep the library owner, exile destination, and permission receipt in one
   producer-consumer scope. The two permission forms share the producer. */
/* @sem ObjectSet::LibraryTops($pilot_library_players) */
pilot_library_tops ::= "the" "top" "card" "of" pilot_library_players "library"

/* @sem PlayerSet::OpponentsOf(AbilityController) */
pilot_library_opponents ::= "each" "opponent's"

/* @sem PlayerSet::All */
pilot_library_all ::= "each" "player's"

pilot_library_players ::= pilot_library_opponents | pilot_library_all

/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:$pilot_library_tops, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:Either, filter:Any}, terms:_{cost:Normal, spend_as:AnyColor}})], duration:WhileAnyExiled(Transition{result:@marked, phase:After}), evaluation:LiveObjects}}] */
pilot_exile_library_play ::= "exile" pilot_library_tops "." "you" "may" "play" "those" "cards" "for" "as" "long" "as" "they" "remain" "exiled" "." "if" "you" "cast" "a" "spell" "this" "way" "," "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "it"

/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:$pilot_library_tops, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:CastSpell, filter:Any}, terms:_{cost:Normal, spend_as:AnyColor}})], duration:$duration, evaluation:LiveObjects}}] */
pilot_exile_library_cast ::= "exile" pilot_library_tops "." duration "," "you" "may" "cast" "spells" "from" "among" "those" "exiled" "cards" "," "and" "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "those" "spells"

pilot_exile_library_permission ::= pilot_exile_library_play | pilot_exile_library_cast

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$pilot_exile_library_permission}} */
pilot_triggered_library_permission ::= "at" turn_event "," pilot_exile_library_permission "."

/* The loss branch selects from the source-linked exile pool before moving the
   selected object, preserving the random choice and its owner's hand. */
/* @sem Condition::Compare{left:CountObjects(Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([$noun, InSet(Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}))])})), test:Compare{comparison:GreaterOrEqual, value:$number_words}} */
pilot_linked_exile_threshold ::= "there" "are" number_words "or" "more" noun "cards" "exiled" "with" "this" "artifact"

/* @sem Instruction::[Effect{result:@next, operation:FlipCoinSeries{players:One(AbilityController), protocol:Called, repetition:Count(Constant(1))}}, If{condition:Compare{left:CountCoinOutcomes{source:Latest, outcome:Lost}, test:Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:One(Source)}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}), count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@prior, phase:After, index:0}), zone:Exile}, destination:OwnersHand{}}}]}, otherwise:Program{}}] */
pilot_coin_loss_linked_return ::= "flip" "a" "coin" "." "if" "you" "lose" "the" "flip" "," "sacrifice" "this" "artifact" "and" "return" "a" "card" "exiled" "with" "it" "at" "random" "to" "its" "owner's" "hand"

/* @sem Ability::Triggered{event:$turn_event, intervening_if:$pilot_linked_exile_threshold, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$pilot_coin_loss_linked_return}} */
pilot_triggered_linked_threshold ::= "at" turn_event "," "if" pilot_linked_exile_threshold "," pilot_coin_loss_linked_return "."

/* The perpetual change applies to the actual battlefield arrival of this move. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($self_explicit_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$returned_perpetual_pump}}] */
returned_self_perpetual ::= "return" self_explicit_ref "from" "your" "graveyard" "to" "the" "battlefield" "tapped" "and" "it" "perpetually" returned_perpetual_pump

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}] */
returned_perpetual_pump ::= "gets" signed "/" signed

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$cost, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:$returned_self_perpetual}, otherwise:Program{}}]} */
optional_payment_return_program ::= "you" "may" "pay" cost "." "if" "you" "do" "," returned_self_perpetual "."

/* Scope the selection to the adjacent mill producer. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$mill_top_filter}, count:AsManyAsCan($counter_amount)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
instructions_mill_optional_top ::= "mill" card_count "," "then" "you" "may" "put" counter_amount mill_top_filter "card" "from" "among" "the" "milled" "cards" "on" "top" "of" "your" "library"

/* @sem ObjectFilter::AnyOf([$filter_phrase, $filter_phrase_2]) */
mill_top_filter ::= filter_phrase "or" filter_phrase

conjured_untapped_battlefield_name ::= conjured_battlefield_name | card_name_forest | card_name_food_fight | card_name_blowfly_infestation

/* Used only inside the complete casting-cost contract: component zero is
   the single card moved to exile by that cost. */
/* @sem Operation::DealDamage{source:$object_ref, recipients:$recipients, amount:$casting_exiled_card_power, preventable:true} */
casting_exile_property_damage ::= object_ref "deals" "damage" "equal" "to" casting_exiled_card_power "to" recipients

/* @sem Expr::ObjectProperty{object:Query{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Performed, phase:After}, index:0}, property:Power, information:CurrentOrLastKnown} */
casting_exiled_card_power ::= "the" "exiled" "card's" "power"

/* The damage result remains the discard recipient across the intervening life gain. */
/* @sem Instruction::[Effect{result:@mark, operation:$deal_damage}, Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::AbilityController), $gain_life_base)}, Effect{result:@next, operation:Discard{players:DamagedBy(@marked), amount:$card_count, random:false}}] */
instructions_damage_life_damaged_discard ::= deal_damage "and" "you" gain_life_base "." "if" "a" "player" "is" "dealt" "damage" "this" "way" "," "they" "discard" card_count

/* Compare the controller's battlefield population with the announced spell's controller. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(ControllerOf(Target{slot:@last_slot, index:0})))])})}} */
counter_controller_population_comparison ::= "you" "control" "more" filter_plural "than" "that" "spell's" "controller"

/* @sem Instruction::[If{condition:$counter_controller_population_comparison, then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One($target_stack_spell), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}] */
clause_counter_population_comparison ::= "counter" target_stack_spell "if" counter_controller_population_comparison

/* Conditional destination belongs to the counter operation itself. */
/* @sem ObjectFilter::$filter_phrase */
countered_kind_condition ::= "if" "an" filter_phrase "spell" "is" "countered" "this" "way" ","

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{controller:Player(AbilityController), tapped:false, counters:[], states:[]}} */
countered_battlefield_destination ::= "put" "that" "card" "onto" "the" "battlefield" "under" "your" "control" "instead" "of" "into" "its" "owner's" "graveyard"

/* @sem Instruction::[Effect{result:@next, operation:Counter{objects:One($target_stack_spell), destination:$countered_battlefield_destination, destination_when:$countered_kind_condition}}] */
clause_counter_kind_destination ::= "counter" target_stack_spell "." countered_kind_condition countered_battlefield_destination

/* Test the announced spell's targets, retaining its controller's battlefield population. */
/* @sem Condition::ObjectMatches{object:Target{slot:@last_slot, index:0}, filter:TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$counter_targeted_permanent, ControlledBy(One(AbilityController))])}))} */
counter_targeting_controlled_condition ::= "that" "spell" "targets" "a" counter_targeted_permanent "you" "control"

/* @sem ObjectFilter::State(Commander) */
counter_targeted_permanent ::= "commander"

/* @sem Instruction::[If{condition:$counter_targeting_controlled_condition, then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@last_slot, index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}, Effect{result:@next, operation:$operation}, Effect{result:@next, operation:$operation_2}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Counter{objects:One($target_stack_spell), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}}] */
clause_counter_targeting_bonus ::= "counter" target_stack_spell "." "if" counter_targeting_controlled_condition "," "instead" "counter" "that" "spell" "," operation "," "then" operation

/* A graveyard target and its battlefield arrival are reusable independently of the follow-up. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card_your_graveyard), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
rehab_return_single ::= "return" target_card_your_graveyard "to" "the" "battlefield"

/* @sem Instruction::If{condition:ObjectMatches{object:Result{result:@last_result, phase:After, index:0}, filter:$subtype}, then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[AddCardType(Artifact), AddCardType(Creature)], duration:Indefinite, evaluation:Snapshot}}]}, otherwise:_{}} */
rehab_return_type_change ::= "if" "it's" "a" subtype "," "it" "becomes" "an" "artifact" "creature"

/* @sem Instruction::[...$rehab_return_single, $rehab_return_type_change] */
rehab_return_conditional ::= rehab_return_single "." rehab_return_type_change

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($rehab_creature_graveyard_target), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[Named(MannequinCounter), Constant(1)]], states:[]}}, qualifiers:[]}}] */
rehab_return_counter ::= "return" rehab_creature_graveyard_target "to" "the" "battlefield" "with" "a" "mannequin" "counter" "on" "it"

/* @sem Instruction::Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[GrantAbility(@scope(Ability::Triggered{event:BecomesTarget(_{objects:SameObject(Source), kind:SpellOrAbility, by:Term{family:SpellsAndAbilities, form:AnySpellOrAbility}}), limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:One(EventSubject)})}]}}))], duration:WhileMatches{object:Affected, filter:Counters(_{kind:Named(MannequinCounter), comparison:Greater, value:Constant(0)})}, evaluation:Snapshot}} */
rehab_counter_grant ::= "for" "as" "long" "as" "that" "creature" "has" "a" "mannequin" "counter" "on" "it" "," "it" "has" '"' "when" "this" "creature" "becomes" "the" "target" "of" "a" "spell" "or" "ability" "," "sacrifice" "it" "." '"'

/* @sem Instruction::[...$rehab_return_counter, $rehab_counter_grant] */
rehab_return_counter_grant ::= rehab_return_counter "." rehab_counter_grant

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(AnnouncedX), filter:@and(ObjectFilter::CardType(Creature), ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))})), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
rehab_return_x ::= "return" "X" "target" "creature" "cards" "from" "your" "graveyard" "to" "the" "battlefield"

/* @sem Instruction::Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Transition{result:@back(3), phase:After}})}]}}} */
rehab_delayed_sacrifice ::= "sacrifice" "those" "creatures" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* @sem Instruction::[...$rehab_return_x, $rehab_delayed_sacrifice] */
rehab_return_x_delayed ::= rehab_return_x "." rehab_delayed_sacrifice

/* @sem Operation::Move{objects:One($target_card_your_graveyard), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
rehab_return_hand ::= "return" target_card_your_graveyard "to" "your" "hand"

/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Goad{}, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0}))])}} */
rehab_goad_controlled ::= "goad" "each" "creature" "target" "player" "controls"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::CardType(Creature), ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0} */
rehab_creature_graveyard_target ::= "target" "creature" "card" "from" "your" "graveyard"

/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:$rehab_return_counter_grant}} */
rehab_counter_grant_spell ::= rehab_return_counter_grant

/* Keep the producer and owner-specific permission together so the receipt
   always names this face-up exile move, including in the inverse direction. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(AnnouncedX), filter:$plural})), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(Bound(0))), changes:[PlayerRule(PlayPermission{cards:Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(One(Bound(0))), InSet(Transition{result:@prior, phase:After})])}), from:Exile, action:Either, filter:Any})], duration:WhileAnyExiled(Transition{result:@prior, phase:After}), evaluation:LiveObjects}}]}}]} */
program_exile_x_owner_permission ::= "exile" "up" "to" "X" "target" plural "." "for" "each" "of" "those" "cards" "," "its" "owner" "may" "play" "it" "for" "as" "long" "as" "it" "remains" "exiled"

/* An Aura's host supplies the antecedent for the controller in this trigger.
   The return action separately retains the returned object and destination. */
/* @sem Ability::Triggered{event:$aura_host_departure, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$host_controller_return}]}} */
aura_host_return_trigger ::= "when" aura_host_departure "," host_controller_return "."

/* @sem EventSpec::Object{event:LeavesBattlefield, objects:SameObject($enchanted_creature_ref)} */
aura_host_departure ::= enchanted_creature_ref "leaves" "the" "battlefield"

/* @sem Operation::Move{objects:One($self_explicit_ref), destination:Battlefield{controller:Player($host_return_controller), arrival:$host_return_arrival_choice}, qualifiers:[]} */
host_controller_return ::= host_return_controller "returns" self_explicit_ref "from" "its" "owner's" "graveyard" host_return_arrival_choice

/* @sem PlayerRef::ControllerOf(AttachedTo(Source)) */
host_return_controller ::= "that" "creature's" "controller"

host_return_arrival_choice ::= host_return_arrival | host_return_arrival_tapped

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[], states:[]} */
host_return_arrival ::= "to" "the" "battlefield"

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:true, counters:[], states:[]} */
host_return_arrival_tapped ::= "to" "the" "battlefield" "tapped"

/* A draft-noted population is copied; the optional cast consumes that copy. */
/* @sem Instruction::[Effect{result:@next, operation:CopyCards{actor:One(AbilityController), objects:$exile_random_draft, times:Constant(1)}}, $optional_cast_created_copy] */
instructions_draft_copy_cast ::= "copy" "a" "card" exile_random_draft "." optional_cast_created_copy

/* @sem Instruction::Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Copies(@prior), count:Exactly(Constant(1)), cost:Free}}]}} */
optional_cast_created_copy ::= "you" "may" "cast" "the" "copy" "without" "paying" "its" "mana" "cost"

/* The callback belongs to the linked return destination, not a free-standing
   receipt reference. The target filter and counter placement remain operands. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:AnyNumber, filter:AllOf([Not(SameObject(Source)), $plural]), constraints:[DifferentControllers]})) */
other_different_controller_targets ::= "any" "number" "of" "other" "target" plural "controlled" "by" "different" "players"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(EventSubject)), kind:$counter_kind, amount:$number}]}}]} */
linked_return_counter_body ::= "put" number counter_kind "counters" "on" "it"

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$other_different_controller_targets, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[ExiledForWith{until:WhileOnBattlefield($self_ref), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:ControlledBy(One(AbilityController))}, body:$linked_return_counter_body}]}}, qualifiers:[]}}] */
instructions_linked_exile_return_counter ::= "exile" other_different_controller_targets "until" self_ref "leaves" "the" "battlefield" "." "when" "an" "exiled" "card" "enters" "under" "your" "control" "this" "way" "," linked_return_counter_body

/* Both uses of X refer to the immediately enclosing bound value. */
/* @sem Instruction::[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:$players_singular, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$plural}, choose:AsManyAsCan(BoundValue(@prior))})}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:BoundValue(@back(3))}}] */
players_sacrifice_x_gain_life ::= players_singular "sacrifices" "X" plural "and" "you" "gain" "X" "life"

/* Bind the spell intensity once for the preceding X actions. */
/* @sem Instruction::[Effect{result:@next, operation:BindValue{value:ObjectProperty{object:Source, property:Intensity, information:CurrentOrLastKnown}}}, ...$players_sacrifice_x_gain_life, Effect{result:@next, operation:$intensify_owned_subtype_cards}] */
instructions_intensity_sacrifice_gain ::= players_sacrifice_x_gain_life "," "where" "X" "is" "this" "spell's" "intensity" "." NEWLINE intensify_owned_subtype_cards

/* The announced group is shared by the tap and any following attachment action. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly($number), filter:CardType(Creature)})), tapped:true}}] */
choose_target_creatures_tap ::= "choose" number "target" "creatures" "." "tap" "those" "creatures"

/* This phrase is scoped to the target group introduced immediately before it. */
/* @sem Instruction::[Effect{result:@next, operation:KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Unattach, objects:Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$subtype}, filter:AttachedTo(InSet(Targets(@last_slot)))}}}] */
unattach_from_chosen_targets ::= "unattach" "all" subtype "from" "them"

/* @sem Instruction::[...$choose_target_creatures_tap, ...$unattach_from_chosen_targets] */
instructions_tap_targets_unattach ::= choose_target_creatures_tap "," "then" unattach_from_chosen_targets

/* The destination of the death event remains the card returned later. */
/* @sem Operation::Move{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]} */
return_death_destination ::= "return" "that" "card" "to" "the" "battlefield"

/* @sem Condition::ObjectMatches{object:Source, filter:InZone(Shared(Battlefield))} */
condition_named_source_still_battlefield ::= SELF_NAME "is" "still" "on" "the" "battlefield"

/* @sem Operation::CreateDelayedTrigger{event:$delayed_move_end_event, start:Immediately, body:Program{instructions:[If{condition:$condition_named_source_still_battlefield, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$return_death_destination}]}}]}, otherwise:Program{}}]}} */
delayed_optional_death_return_if_source ::= "you" "may" return_death_destination "at" delayed_move_end_event "if" condition_named_source_still_battlefield

/* @sem Ability::Triggered{event:$event_owned_power_graveyard, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$delayed_optional_death_return_if_source}]}} */
triggered_owned_death_delayed_optional ::= "whenever" event_owned_power_graveyard "," delayed_optional_death_return_if_source "."

/* Owner-directed return of a shared-type target group. */
/* @prefer always */
/* @sem Operation::Move{objects:$objects_targets_common_creature_type, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_common_type_targets_hand ::= "return" objects_targets_common_creature_type "to" "their" "owner's" "hand"

/* @sem Operation::Conjure{actor:One(AbilityController), card:Named(@card_name), count:$card_count, owner:AbilityController, destination:Graveyard(CardArrival{counters:[], states:[]})} */
conjure_named_self_graveyard ::= "conjure" card_count "named" SELF_NAME "into" "your" "graveyard"

/* @prefer always */
/* @sem ObjectFilter::$return_graveyard_card_filter */
return_graveyard_population_all ::= "all" return_graveyard_card_filter

/* @sem ObjectFilter::$filter_phrase */
return_graveyard_population_each ::= "each" filter_phrase "card"

return_graveyard_population ::= return_graveyard_population_all | return_graveyard_population_each

/* The sacrifice follows the actual arrival produced by this delayed return. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:$return_next_step, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), destination:$battlefield_control}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$event_control_loss_base, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:One(Result{result:@back(3), phase:After, index:0})}}]}}}]}}}]} */
delayed_event_card_return_program ::= "put" "that" "card" "onto" "the" "battlefield" battlefield_control "at" return_next_step "." "sacrifice" "the" "creature" "when" event_control_loss_base

/* Each participant makes an independent unrestricted choice. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseValue{choosers:One(Bound(0)), kind:$loop_unrestricted_choice_kind, terms:_{count:Exactly(Constant(1)), options:[]}}}]}}] */
clause_player_chooses_value ::= players_singular "chooses" loop_unrestricted_choice_kind

loop_unrestricted_choice_kind ::= loop_choice_creature_type

/* @sem ValueKind::CreatureType */
loop_choice_creature_type ::= "a" "creature" "type"

/* The enclosing player loop owns both the graveyard and the arriving cards. */
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:$filter_phrase} */
bound_each_graveyard_card ::= "each" filter_phrase "card" "from" "their" "graveyard"

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[]} */
additional_counter_arrival ::= "with" "an" "additional" counter_kind "counter" "on" "it"

/* @sem Operation::Move{objects:$bound_each_graveyard_card, destination:Battlefield{controller:Player(Bound(0)), arrival:$additional_counter_arrival}, qualifiers:[]} */
bound_return_each_graveyard_card ::= "returns" bound_each_graveyard_card "to" "the" "battlefield" additional_counter_arrival

/* A granted activated ability belongs to the object receiving the perpetual change. */
/* @sem Change::[GrantAbility(@scope($activated_ability))] */
perpetual_gains_quoted_activation ::= "gains" '"' activated_ability '"'

/* @sem Operation::CreatePerpetualEffect{objects:$perpetual_affected_subject, changes:$perpetual_gains_quoted_activation} */
perpetual_quoted_activation_grant ::= perpetual_affected_subject "perpetually" perpetual_gains_quoted_activation

/* Keep the graveyard exclusion in the same phrase as its sacrifice producer. */
/* @sem Instruction::[...$sacrifice_controlled_population, ...$return_other_personal_graveyard] */
sacrifice_then_return_other_graveyard ::= sacrifice_controlled_population "." "then" return_other_personal_graveyard

/* @sem Instruction::[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:$players_singular, objects:$affected})}] */
sacrifice_controlled_population ::= players_singular "sacrifices" affected "they" "control"

/* Used only after the immediately preceding graveyard-producing sacrifice. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:AllOf([$filter_phrase, Not(InSet(Earlier{what:PutInGraveyard}))])}), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}] */
return_other_personal_graveyard ::= players_singular "returns" "all" filter_phrase "cards" "from" "their" "graveyard" "that" "weren't" "put" "there" "this" "way" "to" "the" "battlefield"

/* Draw and life changes sharing a single value computed at resolution. */
/* @sem Instruction::[Effect{result:@mark, operation:BindValue{value:$value_colors_among_controlled_and_cast}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:BoundValue(@marked)}}, Effect{result:@next, operation:$bound_draw_life_change}] */
instructions_draw_and_bound_life ::= "you" "draw" "X" "cards" "and" bound_draw_life_change "," "where" "X" "is" value_colors_among_controlled_and_cast

/* @sem Operation::GainLife{players:One(AbilityController), amount:BoundValue(@marked)} */
bound_draw_life_gain ::= "gain" "X" "life"

/* @sem Operation::LoseLife{players:One(AbilityController), amount:BoundValue(@marked)} */
bound_draw_life_loss ::= "lose" "X" "life"

bound_draw_life_change ::= bound_draw_life_gain | bound_draw_life_loss

/* The attachment and delayed sacrifice refer to this move's actual arrival. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:$noun_creature}), index:0}), destination:$singular_arrival_control, qualifiers:[]}}, Effect{result:@next, operation:Attach{attachments:One(Source), host:Result{result:@marked, phase:After, index:0}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Object{event:LeavesBattlefield, objects:SameObject(Source)}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(ControllerOf(Result{result:@marked, phase:After, index:0})), objects:One(Result{result:@marked, phase:After, index:0})})}]}}}] */
aura_return_attach_delayed_sacrifice ::= "put" "target" noun_creature "card" "from" "a" "graveyard" "onto" "the" "battlefield" singular_arrival_control "and" "attach" "this" "enchantment" "to" "it" "." "when" "this" "enchantment" "leaves" "the" "battlefield" "," "that" "creature's" "controller" "sacrifices" "it"

/* A singular arrival uses its own owner's control. */
/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
singular_arrival_owner_control ::= "under" "its" "owner's" "control"

singular_arrival_control ::= battlefield_control_yours | singular_arrival_owner_control

/* Each named player is the actor of their own roll. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(Bound(0)), action:$shared_singular_die_action}}]}}] */
instructions_players_roll_die ::= players_singular shared_singular_die_action

/* A history-selected player performs an action in that player's own scope. */
/* @sem Instruction::[ForEachPlayer{players:$players_attacked_by_ref_this_turn, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_player_game_outcome}]}}] */
clause_attacked_players_bound_action ::= players_attacked_by_ref_this_turn bound_player_game_outcome

/* @sem Operation::@apply(PlayerSet::One(PlayerRef::Bound(0)), $player_game_outcome_third) */
bound_player_game_outcome ::= player_game_outcome_third

player_game_outcome_third ::= lose_game_third | win_game_third

/* The bound player owns the graveyard and controls the arriving cards. */
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:$filter_phrase} */
bound_filtered_graveyard_cards ::= "all" filter_phrase "cards" "from" "their" "graveyard"

/* @sem Operation::Move{objects:$bound_filtered_graveyard_cards, destination:Battlefield{controller:Player(Bound(0)), arrival:$private_entry_tapped}, qualifiers:[]} */
bound_return_graveyard_to_battlefield ::= "returns" bound_filtered_graveyard_cards "to" "the" "battlefield" private_entry_tapped

/* Fronted destination is valid for the explicitly owned populations below. */
/* @sem Operation::Move{objects:$owned_battlefield_union, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_fronted_owned_population ::= "return" "to" "your" "hand" owned_battlefield_union

/* A third-person action whose controlled population belongs to the loop player. */
bound_controlled_tap_action ::= bound_controlled_untaps | bound_controlled_taps

/* @sem Operation::SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([ControlledBy(One(Bound(0))), $filter_plural])}, tapped:false} */
bound_controlled_untaps ::= "untaps" "all" filter_plural "they" "control"

/* @sem Operation::SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([ControlledBy(One(Bound(0))), $filter_plural])}, tapped:true} */
bound_controlled_taps ::= "taps" "all" filter_plural "they" "control"

/* A filtered opponent population acts individually, preserving the bound actor. */
/* @sem PlayerSet::Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Not(Controls{player:Bound(0), filter:$filter_phrase, minimum:1})}]) */
players_opponents_not_controlling ::= "each" "opponent" "who" "doesn't" "control" "a" filter_phrase

/* @sem Instruction::[ForEachPlayer{players:$players_opponents_not_controlling, binding:0, body:Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::Bound(0)), $qualified_opponent_action)}]}}] */
clause_qualified_opponent_action ::= players_opponents_not_controlling qualified_opponent_action

qualified_opponent_action ::= lose_game_third | win_game_third

/* The result count belongs to the roll immediately preceding token creation. */
/* @sem Instruction::[Effect{result:@next, operation:$roll_six_sided_dice}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$dice_parity_count, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
clause_roll_parity_tokens ::= roll_six_sided_dice "." "for" "each" dice_parity_count "," "create" "a" token_recipe

dice_parity_count ::= dice_odd_count | dice_even_count

/* @sem Expr::Dice(Matching([SameParity, Constant(1)])) */
dice_odd_count ::= "odd" "result"

/* @sem Expr::Dice(Matching([SameParity, Constant(0)])) */
dice_even_count ::= "even" "result"

/* Bind the loop's token receipt to its immediately following changes. */
/* @sem Instruction::[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@mark, operation:$loop_opponent_token_creation}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Created(@marked)), changes:$static_changes, duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:Created(@marked)}}]}}}] */
clause_opponent_tokens_indefinite_changes ::= "for" "each" "opponent" "," "you" loop_opponent_token_creation "." "those" "tokens" static_changes "." "sacrifice" "them" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* The follow-up selects the players who performed this immediately preceding draw.
   The repeated count is constrained to the producer's current draw amount. */
/* @sem Instruction::[ForEachPlayer{players:$players_each, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(Bound(0)), amount:@agree($draw_receipt_count, $draw_receipt_count_2)}}]}}]}}, Effect{result:@next, operation:@apply(PlayerSet::Matching{binding:0, condition:Condition::PlayerTook{player:Bound(0), result:@prior}}, $draw_receipt_reward)}] */
clause_optional_draw_receipt_followup ::= players_each "may" "draw" draw_receipt_count "," "then" "each" "player" "who" "drew" draw_receipt_count "this" "way" draw_receipt_reward

draw_receipt_count ::= card_count_one | card_count_many

draw_receipt_reward ::= gain_life_third | lose_life_amount

/* The destruction and its singular Before receipt form one producer-consumer scope. */
/* @sem Instruction::[Effect{result:@mark, operation:Destroy{objects:One($target_permanent), regeneration:true}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:Before, index:0}, filter:$filter_phrase}, then:_{instructions:[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:ObjectProperty{object:Result{result:@marked, phase:Before, index:0}, property:$creature_stat, information:CurrentOrLastKnown}}}]}, otherwise:_{}}] */
instructions_destroyed_target_property_life ::= "destroy" target_permanent "." "if" "a" filter_phrase "is" "destroyed" "this" "way" "," "you" "gain" "life" "equal" "to" "its" creature_stat

/* The counter placement introduces the first target used by the later tests. */
/* @sem Instruction::If{condition:ObjectMatches{object:Target{slot:0, index:0}, filter:$filter_phrase}, then:$program, otherwise:Program{}} */
target_type_conditional_branch ::= "if" "it's" "a" filter_phrase "," program

/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($target_object)), kind:$counter_kind, amount:$counter_a}]}}, $target_type_conditional_branch, $target_type_conditional_branch_2] */
counter_target_two_type_branches ::= "put" counter_a counter_kind "counter" "on" target_object "." target_type_conditional_branch "." target_type_conditional_branch

/* Return independent optional targets in one move, preserving their individual slots. */
/* @sem Operation::Move{objects:$return_graveyard_selection, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_graveyard_selection_battlefield ::= "return" return_graveyard_selection "from" "your" "graveyard" "to" "the" "battlefield"

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Creature)] */
entry_plural_stats_added_types ::= "they" "are" value "/" value becomes_types "creatures" "in" "addition" "to" "their" "other" "types"

/* The exploit event and the referenced sacrificed creature stay in one scope. */
/* @sem Ability::Triggered{event:$event_exploits, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$return_exploit_comparison}]}} */
trigger_exploit_comparison_return ::= "when" event_exploits "," return_exploit_comparison "."

/* @sem Operation::Move{objects:$exploit_compared_population, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_exploit_comparison ::= "return" "to" "their" "owners'" "hands" exploit_compared_population

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, $modifier_opponents_control, $exploit_stat_comparison])} */
exploit_compared_population ::= "all" filter_plural modifier_opponents_control exploit_stat_comparison

/* @sem ObjectFilter::Property{property:$creature_stat, test:NumberTest::Compare{comparison:$stat_comparison, value:ObjectProperty{object:EventOther, property:$creature_stat_2, information:CurrentOrLastKnown}}} */
exploit_stat_comparison ::= "with" creature_stat stat_comparison "the" "exploited" "creature's" creature_stat

/* Opponents are relative to the player identified by the triggering event. */
/* @sem PlayerSet::OpponentsOf(PlayerRef::EventSubject) */
optional_event_opponents ::= "each" "of" "that" "player's" "opponents"

/* The mana-value bound and count share the announced X, and the graveyard
   restriction belongs to the target group. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(AnnouncedX), filter:AllOf([$card_type_or_non_aura_type, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:AnnouncedX}}, InZone(Players{zone:Graveyard, players:One(AbilityController)})])})) */
return_x_value_graveyard_targets ::= "up" "to" "X" "target" card_type_or_non_aura_type "cards" "each" "with" "mana" "value" "X" "or" "less" "from" "your" "graveyard"

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, AddCardType(Creature)] */
returned_permanents_creature_stats ::= "those" "permanents" "are" value "/" value "creatures" "in" "addition" "to" "their" "other" "types"

/* The condition selects the entry characteristics, while both branches move
   the same announced target group to the same destination. */
/* @sem Instruction::[If{condition:$condition_announced_x_at_least, then:Program{instructions:[Effect{result:@next, operation:Move{objects:$return_x_value_graveyard_targets, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[Changes($returned_permanents_creature_stats)]}}, qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Move{objects:Targets(@last_slot), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}] */
return_targets_conditional_animation ::= "return" return_x_value_graveyard_targets "to" "the" "battlefield" "." "if" condition_announced_x_at_least "," returned_permanents_creature_stats

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$return_targets_conditional_animation}} */
spell_return_targets_conditional_animation ::= return_targets_conditional_animation "."

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[]}} */
graveyard_single_counter_destination ::= "to" "the" "battlefield" "with" "a" counter_kind "counter" "on" "it"

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, $counter_amount]], states:[]}} */
graveyard_additional_counters_destination ::= "to" "the" "battlefield" "with" counter_amount "additional" counter_kind "counters" "on" "it"

/* Return each member of a described population to its own owner. */
/* @sem Operation::Move{objects:$return_owner_population, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_to_owner_hand_population ::= "return" "to" "its" "owner's" "hand" return_owner_population

/* This sequence scopes the sacrificed Vehicle and its callback receipt together. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(EventOther)), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@mark, operation:Sacrifice{players:One(AbilityController), objects:One(EventOther)}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, condition:ObjectMatches{object:Result{result:@marked, phase:Before, index:0}, filter:$noun}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:EventOther, recipients:$recipients, amount:ObjectProperty{object:EventOther, property:$stat, information:CurrentOrLastKnown}, preventable:true}}]}})}]}}}]} */
crewed_vehicle_keyword_sacrifice_program ::= "that" "Vehicle" "gains" keyword_name duration "." "at" "the" "beginning" "of" "the" "next" "end" "step" "," "sacrifice" "that" "Vehicle" "." "when" "you" "sacrifice" "a" noun "this" "way" "," "it" "deals" "damage" "equal" "to" "its" stat "to" recipients

/* The immediately preceding mill supplies the cards measured by this damage. */
/* @sem Instruction::[Effect{result:@next, operation:Mill{players:One(AbilityController), amount:$count_each_vote}}, Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:$recipients, amount:Earlier{what:Milled, measure:Total(ManaValue)}, preventable:true}}] */
instructions_vote_mill_total_damage ::= "you" "mill" "a" "card" "for" "each" count_each_vote "," "then" object_ref "deals" "damage" "to" recipients "equal" "to" "the" "total" "mana" "value" "of" "cards" "milled" "this" "way"

/* @sem Instruction::[...$instructions_vote_mill_total_damage, ...$instructions] */
instructions_vote_mill_total_damage_more ::= instructions_vote_mill_total_damage "." instructions

/* The sacrifice payment and its conditional follow-up share the blocker controller. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:ControllerOf(BlockPair(Blocker)), cost:Cost{parts:[Sacrifice{objects:One(BlockPair(Blocker))}]}}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(ControllerOf(BlockPair(Blocker))), tokens:[$token_defined], entry:BattlefieldArrival{}}}]}, otherwise:Program{}}]}}}]} */
blocker_delayed_sacrifice_token ::= "that" "creature's" "controller" "sacrifices" "it" "at" "end" "of" "combat" "." "if" "the" "player" "does" "," "they" "create" token_defined

/* A selection governed by the targeted player or planeswalker's controller. */
/* @sem ObjectFilter::AllOf([$noun, ControlledBy(One(PlayerOrControllerOf(Targets(0))))]) */
redirect_controlled_filter ::= "choose" "a" noun "they" "control"

/* The two branches share the damage amount and the choice result belongs to
   this exact optional payment. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:PlayerOrControllerOf(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:CardType(Planeswalker), players:All}))), cost:_{parts:[PlayerAction{player:PlayerOrControllerOf(Targets(0)), body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:PlayerOrControllerOf(Targets(0)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$redirect_controlled_filter}, count:AsManyAsCan(Constant(1))}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Result{result:@prior, phase:After, index:0})), amount:$number, preventable:true}}]}, otherwise:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Targets(0), amount:$number, preventable:true}}]}}] */
instructions_optional_controlled_redirect ::= SELF_NAME "deals" number "damage" "to" "target" "player" "or" "planeswalker" "." "that" "player" "or" "that" "planeswalker's" "controller" "may" redirect_controlled_filter "and" "have" SELF_NAME "deal" "that" "damage" "to" "it" "instead"

/* The characteristic sentence applies to the creatures moved by this producer. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo($number), filter:AllOf([CardType(Creature), InZone(Players{zone:Graveyard, players:One(AbilityController)})])})) */
return_your_creature_targets ::= "up" "to" number "target" "creature" "cards" "from" "your" "graveyard"

/* @sem Operation::Move{objects:$return_your_creature_targets, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_your_creature_group ::= "return" return_your_creature_targets "to" "the" "battlefield"

/* @sem Change::[Colors{mode:Add, colors:[$mana_color_word]}, CreatureTypes{mode:Add, types:Listed($becomes_types)}] */
returned_creatures_color_type ::= "each" "of" "those" "creatures" "is" "a" mana_color_word becomes_types "in" "addition" "to" "its" "other" "colors" "and" "types"

/* @sem Instruction::[Effect{result:@next, operation:@arrival_changes($return_your_creature_group, $returned_creatures_color_type)}] */
returned_creatures_entry ::= return_your_creature_group "." returned_creatures_color_type

/* @sem Instruction::[...$returned_creatures_entry, ...$instructions] */
returned_creatures_entry_more ::= returned_creatures_entry "." instructions

/* The enclosing casting line proves the single sacrificed creature payment. */
casting_creature_sacrifice_consequence ::= discard_casting_sacrificed_stat | damage_casting_sacrificed_stat

/* @sem Operation::DealDamage{source:$damage_source_ref, recipients:$recipients, amount:$casting_sacrificed_creature_stat, preventable:true} */
damage_casting_sacrificed_stat ::= damage_source_ref "deals" "damage" "to" recipients "equal" "to" casting_sacrificed_creature_stat

hand_discard_draw_amount ::= hand_discard_draw_all | hand_discard_draw_minus | hand_discard_draw_plus

/* @prefer always */
/* @sem Expr::CountObjects(MovedBy{result:@prior, phase:After, player:Bound(0)}) */
hand_discard_draw_all ::= "that" "many" "cards"

/* @sem Expr::Subtract([CountObjects(MovedBy{result:@prior, phase:After, player:Bound(0)}), $value]) */
hand_discard_draw_minus ::= "that" "many" "cards" "minus" value

/* A one-use boon retains the cast event and its independently scoped body. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTrigger{event:$boon_creature_cast_event, duration:Indefinite, announcement:@announcement, body:$boon_entry_program, once:true}}]} */
program_one_time_entry_boon ::= "you" "get" "a" "one-time" "boon" "with" '"' boon_creature_cast_event "," boon_entry_program '"'

/* The subject is the spell in the nested cast event, not the outer event. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChangeSpell{subject:One(EventSubject), changes:$boon_entry_counter_change}}]} */
boon_entry_program ::= "that" "creature" boon_entry_counter_change "."

boon_entry_counter_change ::= boon_entry_one_counter | boon_entry_multiple_counters

/* @sem Change::[EntersWithCounters(_{kind:$counter_kind, amount:Constant(1)})] */
boon_entry_one_counter ::= "enters" "with" "a" counter_kind "counter" "on" "it"

/* @sem Change::[EntersWithCounters(_{kind:$counter_kind, amount:Expr::@plural_amount($number_words)})] */
boon_entry_multiple_counters ::= "enters" "with" number_words counter_kind "counters" "on" "it"

/* A canceled event and its replacement action retain independent operands. */
/* @sem Operation::CreateReplacement{event:$temporary_cancel_event, limit:UntilExpired, duration:$duration, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:$temporary_replacement_action}]}} */
temporary_cancel_then_action ::= duration "," "if" temporary_cancel_event "," temporary_replacement_action "instead"

temporary_cancel_event ::= temporary_planar_die_event | temporary_indefinite_draw_event | temporary_draw_event

/* @sem ReplacementEvent::Player{event:PlaneswalkByDie, players:$choice_life_candidates} */
temporary_planar_die_event ::= choice_life_candidates "would" "planeswalk" "as" "a" "result" "of" "rolling" "the" "planar" "die"

/* @sem ReplacementEvent::Player{event:Draw, players:$choice_life_candidates} */
temporary_indefinite_draw_event ::= choice_life_candidates "would" "draw" "a" "card"

temporary_replacement_action ::= temporary_chaos_action | operation

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::ChaosEnsues} */
temporary_chaos_action ::= "chaos" "ensues"

/* The named controller makes the choice and performs the copy. */
/* @sem Instruction::[Optional{decider:$copying_prior_player, body:Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One($copying_prior_player), object:ObjectRef::@self, times:Constant(1), targets:May}}]}}] */
clause_controller_may_copy_spell ::= copying_prior_player "may" "copy" self_spell "and" "may" "choose" "a" "new" "target" "for" "that" "copy"

/* @sem PlayerRef::ControllerOf(@named_object) */
prior_permanent_controller ::= "that" "permanent's" "controller"

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$destroy}, ...$clause_controller_may_copy_spell] */
instructions_then_controller_copy ::= destroy "." "then" clause_controller_may_copy_spell

/* Each skipped part has its own result; both use the same stated turn part. */
/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Skip{part:$two_skipped_parts}}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Skip{part:$two_skipped_parts}}}] */
clause_you_skip_next_two_parts ::= "you" "skip" "your" "next" "two" two_skipped_parts

two_skipped_parts ::= two_skipped_turns | two_skipped_draw_steps | two_skipped_untap_steps

/* @sem SkippedPart::Turn */
two_skipped_turns ::= "turns"

/* @sem SkippedPart::DrawStep */
two_skipped_draw_steps ::= "draw" "steps"

/* @sem SkippedPart::UntapStep */
two_skipped_untap_steps ::= "untap" "steps"

/* Both branches are independent copy operations; the trailing target permission
   applies to whichever branch resolves. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:$copy_branch_2}]}, otherwise:Program{instructions:[Effect{result:@next, operation:$copy_branch}]}}] */
conditional_copy_with_targets ::= copy_branch "." "if" condition "," copy_branch "instead" "." "you" "may" "choose" "new" "targets" "for" "the" "copies"

copy_branch ::= copy_branch_once | copy_branch_twice | copy_branch_times

/* @sem Operation::CopyOnStack{actor:One(AbilityController), object:$object_ref, times:Constant(1), targets:May} */
copy_branch_once ::= "copy" object_ref

/* @sem Operation::CopyOnStack{actor:One(AbilityController), object:$object_ref, times:Constant(2), targets:May} */
copy_branch_twice ::= "copy" object_ref "twice"

/* @sem Operation::CopyOnStack{actor:One(AbilityController), object:$object_ref, times:$number, targets:May} */
copy_branch_times ::= "copy" object_ref number "times"

/* The common reveal prefix scopes each planar-deck action and its own
   follow-up. The two-plane form binds the word “both” to exactly two. */
/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:$planar_reveal_followup}}] */
instructions_planar_reveal_until ::= "reveal" "cards" "from" "the" "top" "of" "your" "planar" "deck" "until" "you" "reveal" planar_reveal_followup

planar_reveal_followup ::= planar_reveal_pair_walk | planar_reveal_many_walk | planar_reveal_one_chaos | planar_reveal_one_walk_without_leaving

/* @prefer always */
/* @sem KeywordAction::PlanarDeckPlaneswalkToEach{amount:Constant(2)} */
planar_reveal_pair_walk ::= "two" "plane" "cards" "." "simultaneously" "planeswalk" "to" "both" "of" "them" "." "put" "all" "other" "cards" "revealed" "this" "way" "on" "the" "bottom" "of" "your" "planar" "deck" "in" "any" "order"

/* @sem KeywordAction::PlanarDeckPlaneswalkToEach{amount:$count_plural} */
planar_reveal_many_walk ::= count_plural "plane" "cards" "." "simultaneously" "planeswalk" "to" "all" "of" "them" "." "put" "all" "other" "cards" "revealed" "this" "way" "on" "the" "bottom" "of" "your" "planar" "deck" "in" "any" "order"

/* @sem KeywordAction::PlanarDeckChaos */
planar_reveal_one_chaos ::= "a" "plane" "card" "." "chaos" "ensues" "on" "that" "plane" "." "then" "put" "all" "cards" "revealed" "this" "way" "on" "the" "bottom" "of" "your" "planar" "deck" "in" "any" "order"

/* This amount is used only with the enclosing casting discard above. */
/* @sem Operation::DealDamage{source:$object_ref, recipients:Objects($affected), amount:Aggregate{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Performed, phase:After}, property:$casting_discard_total_property, aggregation:Sum}, preventable:true} */
casting_discard_total_damage ::= object_ref "deals" "damage" "equal" "to" "the" "total" casting_discard_total_property "of" "the" "discarded" "cards" "to" affected

casting_discard_total_property ::= stat_mana_value | stat_power | stat_toughness

/* The chosen opponent remains the actor of the following instruction. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_opponent}, Effect{result:@next, operation:@apply(PlayerSet::One(Chosen), $sacrifice_choice_third_plain)}] */
instructions_chosen_opponent_action ::= choose_opponent "." "that" "player" sacrifice_choice_third_plain

/* The controller sacrifices a permanent selected by an opponent. The chooser,
   the controller of the eligible permanent, and the sacrificing player remain distinct. */
/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), objects:Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, filter:ControlledBy(One(AbilityController))}, chooser:Players(OpponentsOf(AbilityController)), count:Exactly(Constant(1))}], action:Sacrifice{players:One(AbilityController), objects:Prepared(@selection_id(0))}} */
sacrifice_opponent_choice_one ::= "sacrifice" "a" filter_phrase "of" "an" "opponent's" "choice"

/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), objects:Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, filter:ControlledBy(One(AbilityController))}, chooser:Players(OpponentsOf(AbilityController)), count:Exactly($opponent_choice_plural_count)}], action:Sacrifice{players:One(AbilityController), objects:Prepared(@selection_id(0))}} */
sacrifice_opponent_choice_many ::= "sacrifice" opponent_choice_plural_count filter_plural "of" "an" "opponent's" "choice"

opponent_choice_plural_count ::= n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10 | n11 | n12 | n13 | n14 | n15 | n20 | n30 | number_hundred

opponent_choice_sacrifice ::= sacrifice_opponent_choice_one | sacrifice_opponent_choice_many

/* The failed payment governs both actions and keeps their execution order. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$cost, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:$tap_objects}, Effect{result:@next, operation:$opponent_choice_sacrifice}]}, otherwise:Program{}}]} */
unless_payment_tap_opponent_sacrifice ::= "unless" "you" "pay" cost "," tap_objects "and" opponent_choice_sacrifice "."

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$unless_payment_tap_opponent_sacrifice} */
triggered_turn_unless_payment_tap_sacrifice ::= "at" turn_event "," unless_payment_tap_opponent_sacrifice

conditional_repeat_process ::= conditional_repeat_exile_process | conditional_repeat_hand_process

/* @sem Program::Program{instructions:[...$instructions_exile_until_free_cast, If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}]} */
conditional_repeat_exile_process ::= instructions_exile_until_free_cast "." "then" "if" condition "," "repeat" "this" "process" "once"

/* @sem Program::Program{instructions:[...$repeat_operation_optional_hand_entry, If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}]} */
conditional_repeat_hand_process ::= repeat_operation_optional_hand_entry "." "if" condition "," "repeat" "this" "process" "once"

/* The operation and optional hand selection form the repeated process together. */
/* @sem Instruction::[Effect{result:@next, operation:$operation}, ...$optional_hand_entry_tapped] */
repeat_operation_optional_hand_entry ::= operation "." optional_hand_entry_tapped

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, count:AsManyAsCan($counter_amount)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}]}}] */
optional_hand_entry_tapped ::= "you" "may" "put" counter_amount filter_phrase "card" "from" "your" "hand" "onto" "the" "battlefield" "tapped"

/* The condition examines the receipt of this precise library-to-exile move. */
/* @sem Instruction::[Repeatable{instructions:[Effect{result:@mark, operation:$player_exiles_top_cards}, If{condition:$exiled_cards_shared_name_threshold, then:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}]}] */
instructions_repeat_exile_shared_name ::= player_exiles_top_cards "." exiled_cards_shared_name_threshold "," "repeat" "this" "process"

/* The condition consumes the receipt of this mill, including when printed. */
/* @sem Instruction::[Repeatable{instructions:[Effect{result:@mark, operation:Mill{players:One($player_ref), amount:$card_count}}, If{condition:$milled_shared_color_condition, then:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}]}] */
instructions_repeat_milled_shared_color ::= player_ref "mills" card_count "." milled_shared_color_condition "," "repeat" "this" "process"

/* The same scoped mill condition can guard an independent consequence. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One($player_ref), amount:$card_count}}, If{condition:$milled_shared_color_condition, then:Program{instructions:$clause}, otherwise:Program{}}] */
instructions_mill_shared_color ::= player_ref "mills" card_count "." milled_shared_color_condition "," clause

/* One put action can assign a pair of independently named counters to each
   of two independently named recipients. */
/* @sem Operation::PutCounters{placements:[...$counter_pair_on_recipient, ...$counter_pair_on_recipient_2]} */
put_counter_pairs_on_two ::= "put" counter_pair_on_recipient "and" counter_pair_on_recipient

/* @sem CounterPlacement::[_{recipients:Objects($affected), kind:$counter_kind, amount:Constant(1)}, _{recipients:Objects($affected), kind:$counter_kind_2, amount:Constant(1)}] */
counter_pair_on_recipient ::= "a" counter_kind "counter" "and" "a" counter_kind "counter" "on" affected

/* Each population retains its own filter and controller. */
/* @sem Operation::SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([AllOf([$filter_plural, ControlledBy(One(AbilityController))]), AllOf([$filter_plural_2, ControlledBy(One($target_opponent))])])}, tapped:false} */
/* @prefer always */
untap_two_controlled_populations ::= "untap" "all" filter_plural "you" "control" "and" "all" filter_plural target_opponent "controls"

/* A chosen private-zone population enters under its chooser's control. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:$chosen_private_zone, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), count:$chosen_private_count}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:$private_entry_arrival}, qualifiers:[]}}] */
clause_put_chosen_private_cards ::= "put" chosen_private_count filter_phrase "cards" "from" "your" chosen_private_zone "onto" "the" "battlefield" private_entry_arrival

chosen_private_count ::= shuffle_hand_count

/* @sem Zone::Hand */
chosen_private_hand ::= "hand"

/* @sem Zone::Graveyard */
chosen_private_graveyard ::= "graveyard"

chosen_private_zone ::= chosen_private_hand | chosen_private_graveyard

/* Each population retains its written filter and controller. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, $chosen_card_type_reference, ControlledBy($players_singular)])} */
query_chosen_card_type_controlled ::= "all" filter_plural "of" chosen_card_type_reference "type" players_singular "controls"

chosen_card_type_reference ::= chosen_card_type_explicit | chosen_card_type_anaphor

/* @sem ObjectFilter::Chosen(CardType) */
chosen_card_type_explicit ::= "the" "chosen"

/* @sem ObjectFilter::Chosen(CardType) */
chosen_card_type_anaphor ::= "that"

/* Keep the mill producer and its receipt-dependent test in the same scope. */
/* @sem Instruction::[Repeatable{instructions:[Effect{result:@mark, operation:Mill{players:$players_singular, amount:$card_count}}, If{condition:$milled_common_color_condition, then:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}]}] */
instructions_repeat_mill_common_color ::= players_singular "mills" card_count "." milled_common_color_condition "," "repeat" "this" "process"

/* Two independently targeted objects retain their own move results and owners. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card_a_graveyard), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:One($target_permanent), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_return_graveyard_and_battlefield_owners ::= "return" target_card_a_graveyard "and" target_permanent "on" "the" "battlefield" "to" "their" "owners'" "hands"

/* A target's bounded toughness and controller are independent operands. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController)), Property{property:Toughness, test:Compare{comparison:LessOrEqual, value:$number_digits}}])}), index:0} */
target_controlled_toughness_bounded ::= "target" "creature" "you" "control" "with" "toughness" number_digits "or" "less"

/* A delayed flip retains the conditional program and its flip receipt. */
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@mark, operation:FlipCoin{player:AbilityController, protocol:Called}}, If{condition:CoinFlip{result:@marked, outcome:$flip_outcome}, then:Program{instructions:$conjoined}, otherwise:Program{}}]}}}] */
delayed_end_flip_if ::= "flip" "a" "coin" "at" "the" "beginning" "of" "the" "next" "end" "step" "." "if" "you" flip_outcome "the" "flip" "," conjoined

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_controlled_toughness_bounded)), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}, ...$delayed_end_flip_if] */
instructions_grant_delayed_coin ::= target_controlled_toughness_bounded "gains" keyword_name duration "." delayed_end_flip_if

/* The loop binds the acting player independently of the owned permanent filter. */
/* @sem Operation::Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, OwnedBy(One(Bound(0)))])}, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
bound_shuffle_owned_permanents ::= "shuffles" "all" filter_plural "they" "own" "into" "their" "library"

/* The opponent named by this target restriction is its controller. Keep the
   target and the subsequent player's choice in one scoped sequence. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$filter_phrase, ControlledBy(OpponentsOf(AbilityController))])}), index:0} */
opponent_controlled_entry_target ::= "target" filter_phrase "an" "opponent" "controls"

/* @sem Instruction::[Optional{decider:ControllerOf(Target{slot:@last_slot, index:0}), body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:ControllerOf(Target{slot:@last_slot, index:0}), objects:Zone{scope:Players{zone:Hand, players:One(ControllerOf(Target{slot:@last_slot, index:0}))}, kind:Card, filter:$a_card}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(ControllerOf(Target{slot:@last_slot, index:0})), arrival:BattlefieldArrival{}}, qualifiers:[]}}]}}] */
opponent_controller_optional_hand_entry ::= "that" "player" "may" "put" a_card "from" "their" "hand" "onto" "the" "battlefield"

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($opponent_controlled_entry_target), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, ...$opponent_controller_hand_entry] */
exile_opponent_target_controller_entry ::= "exile" opponent_controlled_entry_target "." opponent_controller_hand_entry

/* The plural count is a separate print shape; it keeps the same hand owner
   and battlefield controller as the singular choice. */
opponent_controller_hand_entry ::= opponent_controller_optional_hand_entry | opponent_controller_optional_many_hand_entry

/* @sem Instruction::[Optional{decider:ControllerOf(Target{slot:@last_slot, index:0}), body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:ControllerOf(Target{slot:@last_slot, index:0}), objects:Zone{scope:Players{zone:Hand, players:One(ControllerOf(Target{slot:@last_slot, index:0}))}, kind:Card, filter:$card_filter}, count:AsManyAsCan($count_plural)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(ControllerOf(Target{slot:@last_slot, index:0})), arrival:BattlefieldArrival{}}, qualifiers:[]}}]}}] */
opponent_controller_optional_many_hand_entry ::= "that" "player" "may" "put" count_plural card_filter "cards" "from" "their" "hand" "onto" "the" "battlefield"

/* A counter placement and a separate retained land type, both on the announced target. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$counter_land_placement}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@last_slot, index:0})), changes:$counter_land_change, duration:WhileMatches{object:Affected, filter:Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})}, evaluation:Snapshot}}]} */
program_counter_land_type ::= counter_land_placement "." counter_land_change "for" "as" "long" "as" "it" "has" "a" counter_kind "counter" "on" "it"

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$noun}), index:0})), kind:$counter_kind, amount:Constant(1)}]} */
counter_land_placement ::= "put" "a" counter_kind "counter" "on" "target" noun

/* @sem Change::[AddLandType(Island)] */
counter_land_change_island ::= "it's" "an" "Island" "in" "addition" "to" "its" "other" "types"

/* @sem Change::[AddLandType($retained_land_singular)] */
counter_land_change_other ::= "it's" "a" retained_land_singular "in" "addition" "to" "its" "other" "types"

counter_land_change ::= counter_land_change_island | counter_land_change_other

/* The continuation keeps its own receipt inside the repeated process. */
/* @sem Instruction::[Repeatable{instructions:[Effect{result:@next, operation:$operation}, ...$repeat_operation_followup]}] */
instructions_repeat_operation_coin_loss ::= operation "," "then" repeat_operation_followup

/* @sem Instruction::[Effect{result:@mark, operation:$flip_a_coin}, If{condition:CoinFlip{result:@marked, outcome:Lost}, then:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}] */
repeat_coin_loss ::= "you" flip_a_coin "." "if" "you" "lose" "the" "flip" "," "repeat" "this" "process"

/* The condition introduces the population selected by the copy instruction.
   Keep the spell event, population filter and copied target set in one scope. */
/* @sem Ability::Triggered{event:$event_cast, intervening_if:ObjectMatches{object:EventSubject, filter:TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($plural_atomic, ObjectFilter::AllOf([Not(SameObject(Source)), ControlledBy(One(AbilityController))]))}))}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:CopyOne{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($plural_atomic, ObjectFilter::AllOf([InSet(TargetsOf(EventSubject)), Not(SameObject(Source)), ControlledBy(One(AbilityController))]))}, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]}} */
triggered_cast_targeted_population_copy ::= "whenever" event_cast "," "if" "it" "targets" "one" "or" "more" "other" plural_atomic "you" "control" "," "create" token_copy_single "one" "of" "those" "permanents" "."

/* This phrase is used only by the activation below, which proves the third
   cost component is a singleton creature tap. */
/* @sem Operation::DealDamage{source:$object_ref, recipients:$recipients, amount:ObjectProperty{object:Query{objects:CostObjects{payment:Activation, component:[2], view:Inputs, phase:Before}, index:0}, property:$stat, information:CurrentOrLastKnown}, preventable:true} */
activation_tapped_creature_stat_damage ::= object_ref "deals" "damage" "equal" "to" "the" "tapped" "creature's" stat "to" recipients

/* The cost and consumer are deliberately scoped together: the printed
   creature is exactly the third cost component, before it was tapped. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, TapSymbol, ChangeTapState{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(Tapped), CardType(Creature), ControlledBy(One(AbilityController))])}, choose:Exactly(Constant(1))}], tapped:true}]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$activation_tapped_creature_stat_damage}]}} */
activation_tap_creature_stat_damage ::= cost_mana "," "{T}" "," "↑" "tap" "an" "untapped" "creature" "you" "control" ":" activation_tapped_creature_stat_damage "."

/* The enclosing trigger proves the event supplying this target cap. */
/* @sem Operation::SetTapped{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(EventAmount), filter:$filter_plural})), tapped:true} */
event_sized_target_tap ::= "tap" "up" "to" "X" "target" filter_plural

/* Explicit color choice belongs to the player receiving this mana. */
chosen_player_mana ::= mana_bundle | player_mana_choice_color | player_mana_choice_one_color

/* @sem ManaProduction::$mana_any_color */
player_mana_choice_color ::= mana_any_color "they" "choose"

/* @sem ManaProduction::$mana_any_one_color */
player_mana_choice_one_color ::= mana_any_one_color "they" "choose"

/* A bounded resolution choice and the destruction of exactly that choice. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:UpTo(Constant(1))}}, Effect{result:@next, operation:Destroy{objects:Selected(@prior), regeneration:true}}] */
clause_destroy_up_to_one ::= "destroy" "up" "to" "one" filter_phrase

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, count:$destroy_plural_limit}}, Effect{result:@next, operation:Destroy{objects:Selected(@prior), regeneration:true}}] */
clause_destroy_up_to_plural ::= "destroy" destroy_plural_limit filter_plural

/* @sem Count::@plural_count(Count::UpTo($count)) */
destroy_plural_limit ::= "up" "to" count

/* The counted pump consumes the receipt from this specific random discard. */
/* @sem Instruction::[Effect{result:@mark, operation:Keyword{actor:One(AbilityController), action:KeywordAction::DiscardAnyNumberAtRandom}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:@times($signed, Expr::CountObjects(Transition{result:@marked, phase:Before})), toughness:@times($signed_2, Expr::CountObjects(Transition{result:@marked, phase:Before}))}], duration:$duration, evaluation:Snapshot}}] */
instructions_random_discard_counted_pump ::= "discard" "any" "number" "of" "cards" "at" "random" "." affected "get" signed "/" signed duration "for" "each" "card" "discarded" "this" "way"

/* The amount and the previously chosen color are independent operands. */
/* @sem ManaProduction::Amount{color:Chosen, amount:$value} */
mana_chosen_color_amount ::= value "mana" "of" "a" "chosen" "color"

/* A quantity of independently chosen colored mana units. */
/* @sem ManaProduction::Repeat{amount:$value, production:ChooseOne([Amount{color:White, amount:Constant(1)}, Amount{color:Blue, amount:Constant(1)}, Amount{color:Black, amount:Constant(1)}, Amount{color:Red, amount:Constant(1)}, Amount{color:Green, amount:Constant(1)}]), choice:EachUnit} */
shared_combination_mana ::= value "mana" "in" "any" "combination" "of" "colors"

/* @sem Operation::AddMana{players:One(AbilityController), mana:$shared_combination_mana} */
add_shared_combination_mana ::= "add" shared_combination_mana

/* The condition identifies both the counter kind and the object for the
   anaphoric removal; the token quantity and delayed exile use their producers. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:ObjectMatches{object:$self_explicit_ref, filter:Counters{kind:$counter_kind, comparison:GreaterOrEqual, value:$value}}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($self_explicit_ref)), kind:$counter_kind, amount:All}]}}, Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountersRemoved(@prior), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_move_end_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Created(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}}}]}}}]}} */
triggered_counter_threshold_create_delayed_exile ::= "at" turn_event "," "if" self_explicit_ref "has" value "or" "more" counter_kind "counters" "on" "it" "," "remove" "all" "of" "them" "from" "it" "and" "create" "that" "many" token_recipe "." "exile" "them" "at" delayed_move_end_event "."

/* The quantity is evaluated in the delayed body, at the stated event. */
/* @sem Operation::CreateDelayedTrigger{event:$delayed_your_upkeep, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$value, words:CreatingEffect, recipe:$plural_post_color_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}} */
delayed_counted_tokens ::= "create" "X" plural_post_color_token_recipe "at" delayed_your_upkeep "," "where" "X" "is" value "at" "that" "time"

/* The exile, copy and delayed sacrifice share the two actual producer receipts. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly($graveyard_copy_target_count), filter:$filter_phrase})), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:CopyEach{objects:Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_phrase_2, InSet(Transition{result:@prior, phase:After})])}, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_move_your_end, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(@marked)})}]}}}] */
exile_graveyard_copy_sacrifice_sequence ::= "exile" graveyard_copy_target_count "target" filter_phrase "cards" "from" "graveyards" "." "for" "each" filter_phrase "card" "exiled" "this" "way" "," "create" "a" "token" "that's" "a" "copy" "of" "it" "." "at" delayed_move_your_end "," "sacrifice" "those" "tokens"

graveyard_copy_target_count ::= number_x | count_plural

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$exile_graveyard_copy_sacrifice_sequence}} */
spell_exile_graveyard_copy_sacrifice ::= exile_graveyard_copy_sacrifice_sequence "."

/* The delayed sacrifice names the immediately preceding singular token creation. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:One(AbilityController)}, start:PlayersNextTurn(AbilityController), body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(@marked)})}]}}}] */
delayed_named_token_next_turn_sacrifice ::= "create" "a" token_named_recipe "token" "." "at" "the" "beginning" "of" "the" "end" "step" "on" "your" "next" "turn" "," "sacrifice" "that" "token"

/* The plural follow-up refers to the complete immediately created batch. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$count_plural, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:One(AbilityController)}, start:PlayersNextTurn(AbilityController), body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(@marked)})}]}}}] */
delayed_named_tokens_next_turn_sacrifice ::= "create" count_plural token_named_recipe "tokens" "." "at" "the" "beginning" "of" "the" "end" "step" "on" "your" "next" "turn" "," "sacrifice" "those" "tokens"

/* The singular returned target is the antecedent of the color test.  Keep
   the producer in scope so the anaphor cannot bind an unrelated result. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($personal_graveyard_return_target), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@last_result, phase:After, index:0}, filter:$adjective_color}, then:Program{instructions:$conjoined}, otherwise:Program{}}] */
returned_graveyard_card_color_branch ::= "return" personal_graveyard_return_target "to" "your" "hand" "." "if" "it's" "a" adjective_color "card" "," conjoined

/* The chosen battlefield object is the destination of this replacement. */
/* @sem Instruction::[...$choose_redirect_permanent, Effect{result:@next, operation:$redirect_damage_to_chosen_permanent}] */
instructions_choose_redirect_damage ::= choose_redirect_permanent "." redirect_damage_to_chosen_permanent

/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:ObjectsAndPlayers{objects:$filter_plural, players:One(AbilityController)}, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage(Objects(One(Result{result:@marked, phase:After, index:0})))}}]}} */
redirect_damage_to_chosen_permanent ::= "all" "damage" "that" "would" "be" "dealt" this_duration "to" "you" "and" filter_plural "is" "dealt" "to" "the" "chosen" "permanent" "instead"

/* @sem Instruction::[Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan(Constant(1))}}] */
choose_redirect_permanent ::= "choose" "a" filter_phrase

/* The draw counts the immediately preceding discard by the same target player. */
/* @sem Program::Program{instructions:[Optional{decider:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0}, body:Program{instructions:[Effect{result:@next, operation:Discard{players:One(Target{slot:@last_slot, index:0}), amount:$card_count_many}}, Effect{result:@next, operation:Draw{players:One(Target{slot:@last_slot, index:0}), amount:CountObjects(Transition{result:@prior, phase:Before})}}]}}]} */
program_sentence_target_discard_draw ::= "choose" "target" "player" "." "they" "may" "discard" "up" "to" card_count_many "." "then" "they" "draw" "a" "card" "for" "each" "card" "discarded" "this" "way" "."

/* This phrase is only used in a scope that proves the singleton casting sacrifice. */
/* @sem Operation::GainLife{players:One(AbilityController), amount:$casting_sacrificed_creature_stat} */
gain_life_casting_sacrificed_stat ::= "you" "gain" "life" "equal" "to" casting_sacrificed_creature_stat

/* @sem Instruction::[Effect{result:@next, operation:$gain_life_casting_sacrificed_stat}, Effect{result:@next, operation:$operation}] */
casting_sacrifice_life_then_operation ::= gain_life_casting_sacrificed_stat "." operation

/* These clauses are used only by the paired casting-exile line below.  The
   pair proves both the casting receipt and the returned creature antecedent. */
/* @sem CostPart::Move{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}, choose:Exactly(Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
casting_exile_controlled_creature ::= "exile" "a" "creature" "you" "control"

/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
casting_exile_return_creature ::= "return" "target" "creature" "card" "from" "your" "graveyard" "to" "the" "battlefield"

/* @sem Condition::Compare{left:CountObjects(Matching{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Performed, phase:Before}, filter:AllOf([CardType(Creature), $subtype])}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
casting_exiled_creature_was_subtype ::= "the" "exiled" "creature" "was" "a" subtype

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(One(Result{result:@prior, phase:After, index:0})), kind:$counter_kind, amount:Constant(1)}]} */
casting_returned_creature_counter ::= "put" "a" counter_kind "counter" "on" "that" "creature"

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(One(Result{result:@prior, phase:After, index:0})), kind:$counter_kind, amount:$count_plural}]} */
casting_returned_creature_counters ::= "put" count_plural counter_kind "counters" "on" "that" "creature"

casting_returned_creature_placement ::= casting_returned_creature_counter | casting_returned_creature_counters

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$casting_exile_return_creature}, If{condition:$casting_exiled_creature_was_subtype, then:_{instructions:[Effect{result:@next, operation:$casting_returned_creature_placement}]}, otherwise:_{}}]} */
casting_exile_return_conditional_counter ::= casting_exile_return_creature "." casting_returned_creature_placement "if" casting_exiled_creature_was_subtype "."

/* @sem Ability::[Casting(AdditionalCost{cost:Cost::Cost{parts:[$casting_exile_controlled_creature]}, repetition:Once}), Spell{announcement:@announcement, body:$casting_exile_return_conditional_counter}] */
line_casting_exile_return_counter ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," casting_exile_controlled_creature "." NEWLINE casting_exile_return_conditional_counter

/* The target and the life-loss history refer to the same announced player. */
/* @sem Instruction::[Effect{result:@next, operation:LoseLife{players:One($life_history_target), amount:EventHistory{event:Player{event:LosesLife, players:One(Target{slot:@last_slot, index:0})}, window:ThisTurn, measure:TotalAmount}}}] */
clause_target_loses_own_history ::= life_history_target "loses" "life" "equal" "to" "the" "amount" "of" "life" "they" "lost" "this" "turn"

life_history_target ::= target_opponent | target_player

/* @sem Instruction::[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:$life_gained_bound}}] */
clause_you_gain_own_history ::= "you" "gain" "life" "equal" "to" life_gained_bound

/* A single free cast can select from either a linked population or the
   copies produced by the preceding effect. */
/* @sem $free_cast_population */
single_free_cast_population_linked ::= "spell" "from" "among" free_cast_population

/* @sem $cast_prior_copies */
single_free_cast_population_copies ::= "of" cast_prior_copies

single_free_cast_population ::= single_free_cast_population_linked | single_free_cast_population_copies

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:$single_free_cast_population, count:Exactly($n1), cost:Free} */
cast_single_free_from_population ::= "cast" n1 single_free_cast_population "without" "paying" "its" "mana" "cost"

/* A named player chooses a battlefield permanent for a following return.
   The destination clause consumes the exact selection receipt. */
/* @sem Operation::ChooseObjects{player:$player_ref, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan($counter_amount)} */
player_return_choice ::= player_ref "returns" counter_amount filter_phrase

/* @sem Operation::ChooseObjects{player:$player_ref, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, count:AsManyAsCan($count_plural)} */
player_return_choices ::= player_ref "returns" count_plural filter_plural

/* @sem Instruction::[Effect{result:@next, operation:$player_return_choices}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_player_choices_owner_return ::= player_return_choices "to" "their" "owners'" "hands"

/* @sem Instruction::[Effect{result:@next, operation:$player_return_choice}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_player_choice_owner_return ::= player_return_choice "to" "its" "owner's" "hand"

/* The placement consumes the receipt of this explicit token creation. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$token_group_tapped], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@prior)), kind:$counter_kind, amount:Constant(1)}]}}] */
created_tapped_tokens_single_counter ::= "create" token_group_tapped "." "put" "a" counter_kind "counter" "on" "each" "of" "them"

/* A placement and the later permanent grant share the announced target. */
/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$training_counter_kind, amount:Constant(1)}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($affected_2), changes:[GrantAbility(Mechanic{mechanic:Bushido, amount:$number_digits}), CreatureTypes{mode:Add, types:Listed($becomes_types)}], duration:Indefinite, evaluation:Snapshot}}] */
counter_then_bushido_type ::= "put" "a" training_counter_kind "counter" "on" affected "." affected "gains" "bushido" number_digits "and" "becomes" "a" becomes_types "in" "addition" "to" "its" "other" "creature" "types"

/* Two independently counted placements precede an indefinite type setting. */
/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:$number_words}, _{recipients:Objects($affected), kind:$counter_kind_2, amount:Constant(1)}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected_2)), changes:[CreatureTypes{mode:Set, types:Listed($becomes_types)}], duration:Indefinite, evaluation:Snapshot}}] */
counter_pair_then_type_he ::= "put" number_words counter_kind "counters" "and" "a" counter_kind "counter" "on" affected "." affected "becomes" "a" becomes_types

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:_{instructions:$created_tapped_tokens_single_counter}} */
activated_created_tapped_counter ::= cost ":" created_tapped_tokens_single_counter "."

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:_{sorcery:true}, announcement:@announcement, body:_{instructions:$counter_then_bushido_type}} */
activated_counter_bushido_type ::= cost ":" counter_then_bushido_type "." "activate" "only" "as" "a" "sorcery" "."

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:_{once:true, keyword:PowerUp}, announcement:@announcement, body:_{instructions:$counter_pair_then_type_he}} */
activated_power_up_counter_type ::= "power-up" "—" cost ":" counter_pair_then_type_he "."

/* Four alternatives retain the common counter and the announced recipient. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[_{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:Constant(1)}, _{recipients:Objects($affected_2), kind:$counter_kind_2, amount:Constant(1)}]}}]}, _{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected_2), kind:$counter_kind, amount:Constant(1)}, _{recipients:Objects($affected_2), kind:$counter_kind_3, amount:Constant(1)}]}}]}, _{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected_2), kind:$counter_kind, amount:Constant(1)}, _{recipients:Objects($affected_2), kind:$counter_kind_4, amount:Constant(1)}]}}]}, _{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected_2), kind:$counter_kind, amount:Constant(1)}, _{recipients:Objects($affected_2), kind:$counter_kind_5, amount:Constant(1)}]}}]}]}] */
choose_target_counter_four_kinds ::= "choose" affected "." "put" "a" counter_kind "counter" "and" "a" "counter" "from" "among" counter_kind "," counter_kind "," counter_kind "," "or" counter_kind "on" affected

/* @sem Ability::Activated{origin:Ordinary, cost:_{parts:[Loyalty($loyalty)]}, limits:_{sorcery:true}, announcement:@announcement, body:_{instructions:$choose_target_counter_four_kinds}} */
activated_loyalty_counter_choices ::= "[" loyalty "]" ":" choose_target_counter_four_kinds "."

/* @sem CounterKind::Named(SamuraiCounter) */
training_counter_kind ::= "training"

/* A declined event-subject payment imposes a separately described combat rule. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:EventSubject, cost:$cost, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:$combat_attack_prohibition}]}, otherwise:Program{}}]} */
combat_payment_program ::= "they" "may" "pay" cost "." "if" "they" "don't" "," combat_attack_prohibition "."

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Rule(Prohibit(Attack(Objects($filter_plural))))], duration:$this_duration, evaluation:LiveObjects} */
combat_attack_prohibition ::= affected "can't" "attack" filter_plural this_duration

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:EventSubject, cost:_{parts:[ManaWithX{mana:[X], x:$value}]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:$combat_player_attack_prohibition}]}, otherwise:Program{}}]} */
combat_x_payment_program ::= "that" "opponent" "may" "pay" "{" "X" "}" "," "where" "X" "is" value "." "if" "they" "don't" "," combat_player_attack_prohibition "."

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(EventSubject)), changes:[PlayerRule(Prohibit(AttackInto($recipients)))], duration:EndOfCombat, evaluation:LiveObjects} */
combat_player_attack_prohibition ::= "they" "can't" "attack" recipients "this" "combat"

/* An optional grant is a player action payment, and the follow-up depends on it. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:$combat_self_attack_grant}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:_{instructions:[Effect{result:@next, operation:$combat_no_tap_rule}]}, otherwise:_{}}]} */
combat_optional_grant_program ::= "you" "may" "have" combat_self_attack_grant "." "if" "you" "do" "," combat_no_tap_rule "."

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[GrantAbility(Static(_{kind:Ordinary, affected:Objects(One(Source)), changes:[Rule(Prohibit(Attack(Any)))]}))], duration:EndOfCombat, evaluation:Snapshot} */
combat_self_attack_grant ::= SELF_NAME "gain" '"' SELF_NAME "can't" "attack" '"' "until" "end" "of" "combat"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(AttackWithoutTapping{attackers:$plural, condition:ObjectMatches{object:Source, filter:Not(Tapped)}})], duration:EndOfCombat, evaluation:LiveObjects} */
combat_no_tap_rule ::= "attacking" "doesn't" "cause" plural "you" "control" "to" "tap" "this" "combat" "if" SELF_NAME "is" "untapped"

/* Each table row translates one die result into a separate conditional grant. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::RollDie{sides:6, times:Constant(2)}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[Pump{power:Dice(Matching([Equal, Constant(1)])), toughness:Dice(Matching([Equal, Constant(1)]))}], duration:EndOfTurn, evaluation:Snapshot}}, ...$dice_keyword_row, ...$dice_keyword_row_2, ...$dice_keyword_row_3, ...$dice_keyword_row_4, ...$dice_keyword_row_5, If{condition:Compare{left:Dice(MostEqual), test:NumberTest::Compare{comparison:Equal, value:Constant(2)}}, then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[GrantKeyword($keyword_name)], duration:EndOfTurn, evaluation:Snapshot}}]}, otherwise:_{}}]} */
dice_table_program ::= "roll" "two" "six-sided" "dice" "." "for" "each" "result" "of" "1" "," "this" "creature" "gets" "+" "1" "/" "+" "1" "until" "end" "of" "turn" "." "for" "each" "other" "result" "," "it" "gains" "the" "indicated" "ability" "until" "end" "of" "turn" "." "if" "you" "rolled" "doubles" "," "it" "also" "gains" keyword_name "until" "end" "of" "turn" "." NEWLINE dice_keyword_row NEWLINE dice_keyword_row NEWLINE dice_keyword_row NEWLINE dice_keyword_row NEWLINE dice_keyword_row

/* @sem Instruction::[If{condition:Compare{left:Dice(Matching([Equal, $number])), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[GrantKeyword($keyword_name)], duration:EndOfTurn, evaluation:Snapshot}}]}, otherwise:_{}}] */
dice_keyword_row ::= "•" number "—" "↓" keyword_name

/* A choice of one of two cards and its complementary movement share the
   original selection, even after the chosen card changes zones. */
/* @sem Instruction::[Effect{result:@mark, operation:ChooseObjects{player:$pair_chooser, objects:Matching{objects:Take{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(2), from:Top}, filter:Any}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:One($pair_chosen_object), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Unselected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
choice_graveyard_pair_exile ::= pair_chooser "chooses" "one" "of" "the" "top" "two" "cards" "of" "your" "graveyard" "." "exile" pair_chosen_object "and" "put" "the" "other" "one" "into" "your" "hand"

pair_chosen_object ::= current_card_ref | pair_selected_card

/* @sem ObjectRef::Result{result:@marked, phase:After, index:0} */
pair_selected_card ::= "that" "card"

pair_chooser ::= target_opponent | target_player

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:$choice_graveyard_pair_exile}} */
activated_graveyard_pair_exile ::= cost ":" choice_graveyard_pair_exile "."

/* Selection remains aggregated across the player loop before the move. */
/* @sem Instruction::[ForEachPlayer{players:$basic_land_choosers, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Land), ControlledBy(One(Bound(0)))])}, count:AsManyAsCan(Constant(5)), constraints:[OneForEach([Subtype(Plains), Subtype(Island), Subtype(Swamp), Subtype(Mountain), Subtype(Forest)])]}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
choose_basic_lands_return ::= basic_land_choosers "chooses" "a" "land" "they" "control" "of" "each" "basic" "land" "type" "." "return" "those" "lands" "to" "their" "owners'" "hands"

basic_land_choosers ::= players_each | players_each_opponent

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$choose_basic_lands_return}} */
spell_choose_basic_lands_return ::= choose_basic_lands_return "."

/* The winning damage announces the opponent-or-planeswalker target used by
   the losing branch; both live populations retain their own filters. */
/* @sem Operation::DealDamage{source:$damage_source_ref, recipients:$recipients_opponent_or_walker, amount:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}), preventable:true} */
opponent_walker_controlled_count_damage ::= damage_source_ref "deals" "damage" "to" recipients_opponent_or_walker "equal" "to" "the" "number" "of" filter_plural "you" "control"

/* @sem Instruction::[Effect{result:@mark, operation:FlipCoin{player:AbilityController, protocol:@coin_protocol}}, If{condition:CoinFlip{result:@marked, outcome:Won}, then:Program{instructions:[Effect{result:@next, operation:$opponent_walker_controlled_count_damage}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(One(AbilityController)), amount:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(PlayerOrControllerOf(Targets(@last_slot))))])}), preventable:true}}]}}] */
flip_win_program_lose_controlled_count ::= "flip" "a" "coin" "." "if" "you" "win" "the" "flip" "," opponent_walker_controlled_count_damage "." "if" "you" "lose" "the" "flip" "," object_ref "deals" "damage" "to" "you" "equal" "to" "the" "number" "of" filter_plural "that" "opponent" "or" "that" "planeswalker's" "controller" "controls"

/* Keep the producer inside the receipt expression's scope: the wording
   describes arrivals from an exile, not an arbitrary preceding transition. */
exile_count_token_producer ::= exile_target_players_graveyard | player_exiles_top_cards | exile_count_opponent_graveyard

/* @sem ObjectFilter::Chosen(Color) */
exile_count_token_chosen ::= "card" "of" "the" "chosen" "color"

/* @sem ObjectFilter::AnyOf([$noun, $noun_2]) */
exile_count_token_filtered ::= noun "or" noun "card"

/* @sem $noun */
exile_count_token_single ::= noun "card"

exile_count_token_filter ::= exile_count_token_chosen | exile_count_token_filtered | exile_count_token_single

/* @sem Instruction::[Effect{result:@mark, operation:$exile_count_token_producer}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$exile_count_token_filter}), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
clause_exile_count_tokens ::= exile_count_token_producer "." "for" "each" exile_count_token_filter "exiled" "this" "way" "," "create" "a" token_recipe

/* The target declaration itself proves that every departure is a creature card. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_plural_count, filter:@and(ObjectFilter::CardType(Creature), $graveyard_scope)})) */
exile_creature_graveyard_targets ::= graveyard_plural_count "target" "creature" "cards" graveyard_scope

/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:$exile_creature_graveyard_targets, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Transition{result:@marked, phase:Before}), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
clause_exile_creature_count_tokens ::= "exile" exile_creature_graveyard_targets "." "for" "each" "creature" "card" "exiled" "this" "way" "," "create" "a" token_recipe

/* Payment and its failure branch share the same result. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:EventSubject, cost:_{parts:[Discard{count:Constant(1), filter:Any}]}}}, If{condition:Not(PaymentChosen(@last_result)), then:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(EventSubject), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Attacking, $noun])}, choose:AsManyAsCan(Constant(1))})}]}, otherwise:_{}}] */
opponent_discard_or_sacrifice_attacker ::= "they" "discard" "a" "card" "." "if" "they" "can't" "," "they" "sacrifice" "an" "attacking" noun

/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:$event_opponent_attacks_you_planeswalkers, duration:UntilNextTurn(AbilityController), announcement:@announcement, body:_{instructions:$opponent_discard_or_sacrifice_attacker}}}] */
clause_opponent_attack_timed_penalty ::= "until" "your" "next" "turn" "," "whenever" event_opponent_attacks_you_planeswalkers "," opponent_discard_or_sacrifice_attacker

/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:$selected_group_combat_event, duration:UntilNextTurn(AbilityController), body:_{instructions:$clause_you}, announcement:_{}}}] */
clause_selected_group_combat_trigger ::= selected_group_combat_event "," clause_you

/* A sole player and a sole permanent have different excluded opponents. */
/* @sem Instruction::[If{condition:ObjectMatches{object:EventSubject, filter:AllOf([OnStack(SingleTarget), TargetsAny(Players(OpponentsOf(AbilityController)))])}, then:_{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:EachPlayer(Intersection([OpponentsOf(AbilityController), OthersThan(SoleTargetOf(EventSubject))]))}}]}, otherwise:_{}}, If{condition:ObjectMatches{object:EventSubject, filter:AllOf([OnStack(SingleTarget), TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:ControlledBy(OpponentsOf(AbilityController))}))])}, then:_{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:EachPlayer(Intersection([OpponentsOf(AbilityController), OthersThan(ControllerOf(SoleTargetOf(EventSubject)))]))}}]}, otherwise:_{}}] */
copy_spell_other_opponents ::= "for" "each" "other" "opponent" "," "choose" "that" "player" "or" "a" "permanent" "they" "control" "," "copy" "that" "spell" "," "and" "the" "copy" "targets" "the" "chosen" "player" "or" "permanent"

/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:$event_next_cast_opponent_single, duration:$this_duration, announcement:@announcement, body:_{instructions:$copy_spell_other_opponents}, once:true}}] */
clause_next_cast_copy_other_opponents ::= event_next_cast_opponent_single this_duration "," copy_spell_other_opponents

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[Loyalty($loyalty)]}, limits:ActivationLimits{sorcery:true}, announcement:@announcement, body:Program{instructions:$loyalty_timed_trigger_clause}} */
ability_loyalty_timed_trigger ::= "[" loyalty "]" ":" loyalty_timed_trigger_clause "."

loyalty_timed_trigger_clause ::= clause_opponent_attack_timed_penalty | clause_selected_group_combat_trigger

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[Mana($mana_symbols), TapSymbol]}, limits:_{}, announcement:@announcement, body:Program{instructions:$clause_next_cast_copy_other_opponents}} */
ability_mana_tap_next_copy ::= mana_symbols "," "{" "T" "}" ":" clause_next_cast_copy_other_opponents "."

/* The event supplies the scoped population; the copy consumes this selection. */
/* @sem ObjectFilter::AllOf([$filter_phrase, InSet(Scoped)]) */
scoped_graveyard_copy_kind ::= filter_phrase "card" "from" "among" "those" "cards"

/* A mill and the following choice share the precise arrival receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase}, count:Exactly(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
mill_choice_milled_sentence ::= "mill" card_count "." "you" "may" "put" "an" filter_phrase "card" "from" "among" "the" "milled" "cards" "into" "your" "hand"

/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase}, count:Exactly(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
mill_choice_milled_then ::= "mill" card_count "," "then" "you" "may" "put" "an" filter_phrase "card" "from" "among" "the" "milled" "cards" "into" "your" "hand"

/* The exile producer and its controller draw use the same movement receipt. */
/* @sem Program::Program{instructions:[...$clause_exile_each_opponent_value, ForEachObject{objects:Transition{result:@prior, phase:Before}, binding:0, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(ControllerOf(Bound(0))), amount:$card_count}}]}}]} */
exile_each_opponent_controller_draw ::= clause_exile_each_opponent_value "." "for" "each" "permanent" "exiled" "this" "way" "," "its" "controller" "draws" card_count "."

/* The linked population retains its expressed filter and source link. */
/* @sem Operation::Move{objects:@zone_members($return_scoped_exiled_each_population), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
put_linked_each_owner ::= "put" return_scoped_exiled_each_population "onto" "the" "battlefield" "under" "the" "control" "of" "that" "card's" "owner"

/* A per-player announcement partitions eligible targets, independently of the move. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:All, each:UpTo($number)}, filter:$adjective_nontype})) */
each_player_permanent_targets ::= "up" "to" number "target" adjective_nontype "permanent" "that" "player" "controls"

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$each_player_permanent_targets, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_exile_each_player_target ::= "for" "each" "player" "," "exile" each_player_permanent_targets

/* The consumer is scoped to this exact exile producer and its before receipt. */
/* @sem Instruction::[...$clause_exile_each_player_target, ForEachObject{objects:Transition{result:@prior, phase:Before}, binding:0, body:Program{instructions:[Effect{result:@next, operation:Manifest{actor:One(ControllerOf(Bound(0))), source:TopOfLibrary{player:ControllerOf(Bound(0)), count:Constant(1)}, cloak:true, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}] */
instructions_exile_each_player_cloak ::= clause_exile_each_player_target "." "for" "each" "permanent" "exiled" "this" "way" "," "its" "controller" "cloaks" "the" "top" "card" "of" "their" "library"

/* The discard and its consumer are one scoped receipt contract. */
/* @sem Operation::Discard{players:$players_singular, amount:Constant(1), random:false} */
discard_one_by_players ::= players_singular "discards" "a" "card"

/* @sem Operation::LoseLife{players:Intersection([$players_singular, Matching{binding:0, condition:Not(Compare{left:CountObjects(Matching{objects:MovedBy{result:@marked, phase:After, player:Bound(0)}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}})}]), amount:$value} */
discard_receipt_missing_life ::= players_singular "who" "didn't" "discard" "a" filter_phrase "card" "this" "way" "loses" value "life"

/* @sem Instruction::[Effect{result:@mark, operation:$discard_one_by_players}, Effect{result:@next, operation:$discard_receipt_missing_life}] */
instructions_discard_missing_life ::= discard_one_by_players "." "then" discard_receipt_missing_life

/* The returned population and the count share one movement receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:UpTo($value), filter:AllOf([$noun, InZone(Players{zone:Graveyard, players:One(AbilityController)})])})), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$noun}), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
instructions_return_targets_create_receipt ::= "return" "up" "to" value "target" noun "cards" "from" "your" "graveyard" "to" "the" "battlefield" "tapped" "." "create" "that" "many" token_recipe

/* The continuation consumes the immediately preceding destroy receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$destroy}, ...$destroyed_land_controller_damage] */
instructions_destroy_receipt_controller_damage ::= destroy "." NEWLINE? destroyed_land_controller_damage

/* @sem Instruction::[ForEachObject{objects:Transition{result:@marked, phase:Before}, binding:0, body:Program{instructions:[If{condition:ObjectMatches{object:Bound(0), filter:CardType(Land)}, then:Program{instructions:[Effect{result:@mark, operation:PayCost{player:ControllerOf(Bound(0)), cost:Cost{parts:[Mana($mana_symbols)]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref, recipients:Players(One(ControllerOf(Bound(0)))), amount:$number, preventable:true}}]}, otherwise:Program{}}]}, otherwise:Program{}}]}}] */
destroyed_land_controller_damage ::= "for" "each" "land" "destroyed" "this" "way" "," self_ref "deals" number "damage" "to" "that" "land's" "controller" "unless" "they" "pay" mana_symbols

/* The action's one announced target is also the subject of the name test. */
/* @sem Instruction::[If{condition:$other_permanent_same_target_name, then:Program{instructions:[Effect{result:@next, operation:$target_name_action}]}, otherwise:Program{}}] */
clause_target_action_same_name ::= target_name_action "if" other_permanent_same_target_name

/* @sem Operation::Destroy{objects:One($target_object), regeneration:true} */
target_name_action ::= "destroy" target_object

/* A controller's token count is tied to this exact exile producer, including
   its destination. The before receipt retains each object's former controller. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:Move{objects:$objects_targets_plain, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, ForEachPlayer{players:Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:ControlledBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}, binding:0, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(Bound(0)), tokens:[TokenSpec{amount:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))])}), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}]}} */
spell_exile_targets_controller_tokens ::= "exile" objects_targets_plain "." "for" "each" filter_phrase "exiled" "this" "way" "," "its" "controller" "creates" "a" token_recipe "."

/* A bounded hand selection and its battlefield arrival share the chosen receipt. */
/* @sem ObjectSet::Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])}) */
hand_attack_entry_pool ::= filter_phrase "card" "with" "mana" "value" "X" "or" "less" "from" "your" "hand" "onto" "the" "battlefield" "tapped" "and" "attacking" "," "where" "X" "is" value

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$hand_attack_entry_pool, count:AsManyAsCan($counter_amount)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}, qualifiers:[]}}] */
hand_attack_entry ::= "put" counter_amount hand_attack_entry_pool

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:$hand_attack_entry}}] */
clause_optional_hand_attack_entry ::= "you" "may" hand_attack_entry

/* The same bound damaged permanent determines the chooser and hand. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:ControllerOf(Bound(0)), objects:Zone(_{scope:Players{zone:Hand, players:One(ControllerOf(Bound(0)))}, kind:Card, filter:Property{property:$stat, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone(_{scope:Players{zone:Hand, players:One(ControllerOf(Bound(0)))}, kind:Card, filter:Any}), property:$stat, aggregation:Maximum}}}}), count:AsManyAsCan($card_count)}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}] */
excess_controller_discard_maximum ::= "its" "controller" "discards" card_count "with" "the" "greatest" stat "among" "cards" "in" "their" "hand"

/* Both producer and consumer occur together so the result identity is proved. */
/* @sem Instruction::[Effect{result:@mark, operation:$excess_damage_producer}, ForEachObject{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, DealtExcessBy(@marked)])}, binding:0, body:Program{instructions:$excess_controller_discard_maximum}}] */
instructions_damage_excess_controller_discard ::= excess_damage_producer "." "if" "excess" "damage" "was" "dealt" "to" "a" filter_phrase "this" "way" "," excess_controller_discard_maximum

/* Keep the copied card tied to this singular exile movement, and casts to
   the resulting copies. The target and copy count remain independent operands. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card_a_graveyard), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CopyCards{actor:One(AbilityController), objects:One(Result{result:@prior, phase:After, index:0}), times:$number}}, Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Copies(@prior), count:AnyNumber, cost:Free}}] */
instructions_exile_copy_free ::= "exile" target_card_a_graveyard "." "copy" "that" "card" number "times" "." "you" "may" "cast" "the" "copies" "without" "paying" "their" "mana" "costs"

/* @sem Instruction::[...$instructions_exile_copy_free, ...$instructions] */
instructions_exile_copy_free_more ::= instructions_exile_copy_free "." instructions

/* Keep the singular sacrifice and its inspected payment in the same scope. */
singular_sacrifice_payment ::= cost_sacrifice | cost_sacrifice_another

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$singular_sacrifice_payment]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}, If{condition:Compare{left:CountObjects(Matching{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:Before}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Constant(1)}}]}, otherwise:Program{}}]}, otherwise:Program{}}] */
clause_sacrifice_draw_if_kind ::= "you" "may" singular_sacrifice_payment "." "if" "you" "do" "," "draw" card_count "," "then" "draw" "another" "card" "if" "the" "sacrificed" "permanent" "was" "a" filter_phrase

/* A single explicitly owned card can be selected from a shared zone and moved. */
/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Zone{scope:$owned_card_shared_origin, kind:Card, filter:$owned_card_singular}, count:Exactly(Constant(1)), constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:$owned_card_destination, qualifiers:[]}} */
put_owned_selected_card ::= "put" owned_card_singular owned_card_destination "from" owned_card_shared_origin

owned_card_singular ::= owned_commander_singular | owned_creature_card_singular | owned_land_card_singular

/* @sem ObjectFilter::@and($noun_commander, ObjectFilter::OwnedBy(One(AbilityController))) */
owned_commander_singular ::= "your" noun_commander

/* @sem ObjectFilter::@and($noun_creature, ObjectFilter::OwnedBy(One(AbilityController))) */
owned_creature_card_singular ::= "a" noun_creature "card" "you" "own"

/* @sem ObjectFilter::@and($noun_land, ObjectFilter::OwnedBy(One(AbilityController))) */
owned_land_card_singular ::= "a" noun_land "card" "you" "own"

owned_card_shared_origin ::= owned_card_command_origin | owned_card_exile_origin

/* @sem ZoneScope::Shared(Command) */
owned_card_command_origin ::= "the" "command" "zone"

/* @sem ZoneScope::Shared(Exile) */
owned_card_exile_origin ::= "exile"

owned_card_destination ::= owned_card_hand_destination | owned_card_graveyard_destination

/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
owned_card_hand_destination ::= "into" "your" "hand"

/* @sem MovementDestination::OwnersGraveyard(CardArrival{counters:[], states:[]}) */
owned_card_graveyard_destination ::= "into" "your" "graveyard"

/* The permission consumes the marked face-up exile, including its current objects. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_objects}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:Either, filter:Any}, terms:_{cost:Normal, condition:$exile_attack_singular_condition}})], duration:Indefinite, evaluation:LiveObjects}}] */
instructions_exile_attack_batch_permission ::= exile_objects "." "during" "any" "turn" exile_attack_singular_condition "," "you" "may" "play" "those" "cards"

exile_attack_singular_condition ::= exile_attack_singular_a | exile_attack_singular_an

/* @sem Condition::Compare{left:EventHistory{event:Object{event:Attacks, objects:AllOf([$filter_phrase, ControlledBy(One(AbilityController))])}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
exile_attack_singular_a ::= "you" "attacked" "with" "a" filter_phrase

/* @sem Condition::Compare{left:EventHistory{event:Object{event:Attacks, objects:AllOf([$filter_phrase, ControlledBy(One(AbilityController))])}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
exile_attack_singular_an ::= "you" "attacked" "with" "an" filter_phrase

/* The same outside selection can also move to its owner's hand. */
/* @sem Operation::WithSelections{steps:[$outside_owned_selection], action:Move{objects:Prepared(@selection_id(0)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}} */
outside_owned_put_hand ::= "put" outside_owned_selection "into" "your" "hand"

/* Keep the exile destination and its permission receipt in the same span. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:$count_each_vote, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
permission_exile_library_per_vote ::= "exile" "the" "top" "card" "of" "your" "library" "for" "each" count_each_vote

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:Either, filter:Any})], duration:$fronted_permission_duration, evaluation:LiveObjects}}] */
permission_exiled_cards_fronted ::= fronted_permission_duration "," "you" "may" "play" "the" "exiled" "cards"

/* @sem Instruction::[...$permission_exile_library_per_vote, ...$permission_exiled_cards_fronted] */
instructions_exile_vote_permission ::= permission_exile_library_per_vote "." permission_exiled_cards_fronted

/* A singular attacked-with population counts its controlled attack events. */
/* @sem Condition::Compare{left:EventHistory{event:Object{event:Attacks, objects:AllOf([$filter_phrase, ControlledBy(One(AbilityController))])}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
exile_play_attack_single ::= "you" "attacked" "with" "a" filter_phrase

/* The named card and owned subtype remain independent current operands. */
/* @sem Operation::Conjure{actor:One(AbilityController), card:Named($referenced_card_name), count:ObjectProperty{object:Source, property:Intensity, information:CurrentOrLastKnown}, destination:Battlefield(BattlefieldArrival{tapped:false, counters:[], states:[]})} */
conjure_named_intensity_battlefield ::= "conjure" "X" "cards" "named" referenced_card_name "onto" "the" "battlefield" "," "where" "X" "is" "this" "spell's" "intensity"

/* @sem Instruction::[Effect{result:@next, operation:$conjure_named_intensity_battlefield}, Effect{result:@next, operation:$intensify_owned_subtype_cards}] */
instructions_conjure_intensity_followup ::= conjure_named_intensity_battlefield "." NEWLINE intensify_owned_subtype_cards

/* The event's player binding is the chooser and the performer of their option;
   the controller remains the performer of the separate draw option. */
/* @sem Ability::Triggered{event:$event_combat_damage_player, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[$event_player_villainous_choice]}} */
triggered_event_player_villainous ::= "whenever" event_combat_damage_player "," event_player_villainous_choice "."

/* @sem Instruction::Effect{result:@next, operation:ChooseAction{actor:One(EventSubject), options:[List([Program($event_player_villainous_sacrifice)]), List([Program($event_player_villainous_loss), Program($controller_villainous_draw)])], villainous:true}} */
event_player_villainous_choice ::= "that" "player" "faces" "a" "villainous" "choice" "—" event_player_villainous_sacrifice "," "or" event_player_villainous_loss "and" controller_villainous_draw

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Sacrifice{players:One(EventSubject), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Constant(1))}}]} */
event_player_villainous_sacrifice ::= "they" "sacrifice" "a" filter_phrase "of" "their" "choice"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(EventSubject), amount:$number_digits}}]} */
event_player_villainous_loss ::= "they" "lose" number_digits "life"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}]} */
controller_villainous_draw ::= "you" "draw" card_count

/* @sem Program::Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(EventSubject), objects:One(EventSubject)})}]} */
aura_controller_sacrifice_creature ::= "that" "player" "sacrifices" "that" "creature"

/* The random choice supplies the payer and damage recipient. The sacrifice is
   an optional payment; the damage happens only when that payment is declined. */
/* @sem Instruction::[Effect{result:@next, operation:$random_player_choice}, Effect{result:@next, operation:PayCost{player:Chosen, cost:$willing_sacrifice_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:_{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref_named, recipients:Players(One(Chosen)), amount:$random_choice_source_stat, preventable:true}}]}, otherwise:_{}}] */
random_choice_damage_unless_sacrifice ::= random_player_choice "." self_ref_named "deals" "damage" "equal" "to" random_choice_source_stat "to" "that" "player" "unless" "they" willing_sacrifice_cost

/* @sem Expr::ObjectProperty{object:Source, property:Power, information:CurrentOrLastKnown} */
random_choice_source_power ::= "its" "power"

/* @sem Expr::ObjectProperty{object:Source, property:Toughness, information:CurrentOrLastKnown} */
random_choice_source_toughness ::= "its" "toughness"

random_choice_source_stat ::= random_choice_source_power | random_choice_source_toughness

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:_{instructions:$random_choice_damage_unless_sacrifice}} */
triggered_random_choice_damage_unless_sacrifice ::= event_clause "," random_choice_damage_unless_sacrifice "."

/* The measured card is the one discarded immediately before the damage.
   Keep that producer and its Before receipt in the same printable phrase. */
/* @sem Instruction::[Effect{result:@next, operation:Discard{players:One(AbilityController), amount:Constant(1)}}, Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any})), amount:ObjectProperty{object:Query{objects:Transition{result:@prior, phase:Before}, index:0}, property:$receipt_stat, information:CurrentOrLastKnown}, preventable:true}}] */
discard_card_property_damage ::= "discard" "a" "card" "." self_explicit_ref "deals" "damage" "equal" "to" "the" "discarded" "card's" receipt_stat "to" "that" "permanent" "or" "player"

/* The target is announced before the draw and used by the discard follow-up. */
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}, ...$discard_card_property_damage] */
instructions_choose_draw_discard_damage ::= "choose" "any" "target" "." "draw" card_count "," "then" discard_card_property_damage

/* @sem $discard_card_property_damage */
instructions_choose_discard_damage ::= "choose" "any" "target" "." discard_card_property_damage

/* Keep the bolster producer and both references to its chosen creature in one
   printable contract. The later trigger's body remains an independent program. */
/* @sem Instruction::[Effect{result:@next, operation:$bolster_action}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[GrantKeyword($keyword_name)], duration:EndOfTurn, evaluation:Snapshot}}, Effect{result:@next, operation:CreateTrigger{event:Damage{source_kind:Permanent, sources:SameObject(Result{result:@back(3), phase:After, index:0}), recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source}, duration:EndOfTurn, announcement:@announcement, body:$program}}] */
bolster_chosen_combat_followup ::= bolster_action "." "the" "chosen" "creature" "gains" keyword_name "until" "end" "of" "turn" "." "when" "that" "creature" "deals" "combat" "damage" "to" "a" "player" "this" "turn" "," program

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$bolster_chosen_combat_followup}} */
triggered_bolster_chosen_combat ::= event_clause "," bolster_chosen_combat_followup "."

/* The payment and its singleton input receipt are scoped together. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::EventSubject)), $adjective_nontype)}, choose:Exactly(Constant(1))}]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:LoseLife{players:OpponentsOf(AbilityController), amount:ObjectProperty{object:Query{objects:CostObjects{payment:Resolution(0), component:[0], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}]}, otherwise:Program{}}]} */
program_optional_other_sacrifice_draw_life ::= "you" "may" "sacrifice" "another" adjective_nontype "permanent" "." "if" "you" "do" "," "draw" card_count "and" "each" "opponent" "loses" "life" "equal" "to" "the" "mana" "value" "of" "the" "sacrificed" "permanent"

/* Participation belongs to this optional draw loop; the continuation consumes
   its marked result and keeps the affected player and next turn bound together. */
/* @sem Instruction::[$player_draw_receipt_loop, $player_draw_receipt_prohibition] */
player_draw_receipt_sequence ::= player_draw_receipt_loop "." player_draw_receipt_prohibition

/* @sem Instruction::ForEachPlayer{players:$optional_action_players, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@mark, operation:Draw{players:One(Bound(0)), amount:$card_count}}]}}]}} */
player_draw_receipt_loop ::= optional_action_players "may" "draw" card_count

/* @sem Instruction::ForEachPlayer{players:Intersection([$players_singular, Matching{binding:0, condition:PlayerTook{player:Bound(0), result:@marked}}]), binding:0, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(Bound(0))), changes:$player_prohibitions, duration:DuringNextTurn(Bound(0)), evaluation:LiveObjects}}]}} */
player_draw_receipt_prohibition ::= players_singular "who" "does" "can't" player_prohibitions "during" "their" "next" "turn"

/* An optional action is a payment whose success gates the following program. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$indefinite_have_change}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:$program, otherwise:Program{}}]} */
optional_have_action_followup ::= "you" "may" "have" indefinite_have_change "." "if" "you" "do" "," program

/* The singular conjure result is the object whose base characteristics change. */
/* @sem Instruction::[Effect{result:@next, operation:$conjure_source_spellbook_battlefield}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$conjured_base_perpetual_change}}] */
/* @prefer always */
instructions_conjure_base_perpetual ::= conjure_source_spellbook_battlefield "." conjured_base_perpetual_change

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}] */
conjured_base_perpetual_change ::= "its" "base" "power" "and" "toughness" "perpetually" "become" value "/" value

/* A single conjured battlefield arrival is the recipient of the subsequent counter. */
/* @sem Instruction::[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Named($referenced_card_name), count:Constant(1), destination:Battlefield(BattlefieldArrival{tapped:false, counters:[], states:[]})}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Result{result:@prior, phase:After, index:0})), kind:$counter_kind, amount:Constant(1)}]}}] */
instructions_conjure_named_battlefield_counter ::= "conjure" "a" "card" "named" referenced_card_name "onto" "the" "battlefield" "," "then" "put" "a" counter_kind "counter" "on" "it"

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:_{instructions:$instructions_conjure_named_battlefield_counter}} */
triggered_conjure_named_battlefield_counter ::= event_clause "," instructions_conjure_named_battlefield_counter "."

/* The test consumes the immediately preceding single-card reveal receipt.
   Restrict both producers to one card so the singular anaphor remains valid. */
revealed_single_producer ::= reveal_single_random_hand | reveal_single_library_top

/* @sem Operation::RevealFromHand{actor:One(AbilityController), cards:Any, count:Constant(1), at_random:true} */
reveal_single_random_hand ::= "reveal" "a" "card" "at" "random" "from" "your" "hand"

/* @sem Operation::Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}} */
reveal_single_library_top ::= "reveal" "the" "top" "card" "of" "your" "library"

/* @sem ObjectFilter::Chosen(CardName) */
revealed_card_name_test ::= "the" "chosen" "name"

/* @sem Instruction::[Effect{result:@next, operation:$revealed_single_producer}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@last_result), filter:$revealed_card_name_test}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:$instructions}, otherwise:Program{}}] */
instructions_revealed_card_test ::= revealed_single_producer "." "if" "that" "card" "has" revealed_card_name_test "," instructions

/* Each target player is the drawer, or chooses from their own graveyard. */
target_player_mode_program ::= target_player_draw_mode | target_player_graveyard_return_mode

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Draw{players:One($target_player), amount:$card_count}}]} */
target_player_draw_mode ::= target_player "draws" card_count

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:$target_player, objects:Zone{scope:Players{zone:Graveyard, players:One(Target{slot:@last_slot, index:0})}, kind:Card, filter:$target_player_graveyard_types}, count:Exactly(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]} */
target_player_graveyard_return_mode ::= target_player "returns" "an" target_player_graveyard_types "card" "from" "their" "graveyard" "to" "their" "hand"

/* An article scopes the first type; all three card types remain operands. */
/* @sem ObjectFilter::AnyOf([$graveyard_an_type, $card_word, $card_word_2]) */
target_player_graveyard_types ::= graveyard_an_type "," card_word "," "or" card_word

graveyard_an_type ::= noun_artifact | noun_enchantment | spell_instant

/* The optional choice and its arrival state stay together across sentence joins. */
/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])}), count:AsManyAsCan($counter_amount)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}, ChangesUntil{changes:$static_changes, duration:$duration}]}}, qualifiers:[]}}]}}] */
instructions_optional_hand_entry_combat ::= "you" "may" "put" counter_amount filter_phrase "card" "with" "mana" "value" value "or" "less" "from" "your" "hand" "onto" "the" "battlefield" "." "it" "enters" "tapped" "and" "attacking" "and" static_changes duration

/* @prefer always */
/* @sem Instruction::[...$clause, ...$instructions_optional_hand_entry_combat] */
instructions_then_optional_hand_entry_combat ::= clause "." "then" instructions_optional_hand_entry_combat

/* A named source damages a single target from either permanent kind. */
/* @sem Operation::DealDamage{source:Source, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AnyOf([$noun, $noun_2])}), index:0})), amount:$number, preventable:true} */
named_damage_either_permanent ::= SELF_NAME "deals" number "damage" "to" "target" noun "or" noun

/* The subtype test and controller refer to the already announced target. */
/* @sem Condition::ObjectMatches{object:Target{slot:@last_slot, index:0}, filter:$subtype} */
condition_that_permanent_subtype ::= "that" "permanent" "is" "a" subtype

/* @sem Operation::DealDamage{source:Source, recipients:Players(One(ControllerOf(Target{slot:@last_slot, index:0}))), amount:$number, preventable:true} */
named_also_damage_that_permanent_controller ::= SELF_NAME "also" "deals" number "damage" "to" "that" "permanent's" "controller"

/* @sem Instruction::If{condition:$condition_that_permanent_subtype, then:Program{instructions:[Effect{result:@next, operation:$named_also_damage_that_permanent_controller}]}, otherwise:Program{}} */
conditional_that_permanent_controller_damage ::= "if" condition_that_permanent_subtype "," named_also_damage_that_permanent_controller

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$named_damage_either_permanent}, $conditional_that_permanent_controller_damage]}} */
spell_named_damage_conditional_controller ::= named_damage_either_permanent "." conditional_that_permanent_controller_damage "."

/* The followup is scoped to the explicitly announced opposing permanent. */
/* @sem Operation::DealDamage{source:Source, recipients:$recipients_target_opponent_controls, amount:$number, preventable:true} */
opponent_target_named_damage ::= SELF_NAME "deals" number "damage" "to" recipients_target_opponent_controls

/* @sem Operation::DealDamage{source:Source, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Target{slot:@last_slot, index:0})), $filter_head, ControlledBy(One(ControllerOf(Target{slot:@last_slot, index:0})))])}), amount:$number, preventable:true} */
other_target_controller_named_damage ::= SELF_NAME "deals" number "damage" "to" "each" "other" filter_head "that" "player" "controls"

/* @sem Instruction::[Effect{result:@next, operation:$opponent_target_named_damage}, If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:$other_target_controller_named_damage}]}, otherwise:Program{}}] */
instructions_target_damage_conditional_followup ::= opponent_target_named_damage "." "then" other_target_controller_named_damage "if" condition

/* The fight and its excess-damage consumer share the produced result and the
   opposing fighter. Keeping them together proves both references on printing. */
/* @sem Instruction::[Effect{result:@mark, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:$target_permanent, second:$fight_opposing_target}}}, If{condition:ObjectMatches{object:Target{slot:1, index:0}, filter:DealtExcessBy(@marked)}, then:Program{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:Repeat{amount:ExcessDamage{result:@marked, to:SameObject(Target{slot:1, index:0})}, production:Amount{color:$mana_color, amount:Constant(1)}, choice:Once}}}]}, otherwise:Program{}}] */
instructions_fight_opponent_excess_mana ::= target_permanent "fights" fight_opposing_target "." "if" "the" "creature" "the" "opponent" "controls" "is" "dealt" "excess" "damage" "this" "way" "," "add" "that" "much" mana_color

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$excess_damage_creature, ControlledBy(OpponentsOf(AbilityController))])}), index:0} */
fight_opposing_target ::= "target" excess_damage_creature "an" "opponent" "controls"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$instructions_fight_opponent_excess_mana, ...$instructions]}} */
spell_fight_excess_followed ::= instructions_fight_opponent_excess_mana "." NEWLINE instructions "."

/* A random color absent from the referenced permanent is added to that permanent. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseAtRandom(_{kind:Color, options:[Term{family:ChoosableColor, form:NotColorAmoungPermanents, operands:[Objects(One($it_ordinary_pronoun_2))]}]})}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($it_ordinary_pronoun)), changes:[ChosenColor{mode:Add}], duration:Indefinite, evaluation:Snapshot}}] */
instructions_random_missing_color ::= it_ordinary_pronoun "becomes" "a" "random" "color" "that" it_ordinary_pronoun "isn't" "in" "addition" "to" "its" "other" "colors"

/* The selected card and the arrival changes remain independent operands. */
random_singular_card_selection ::= objects_random_library_mana_ceiling | objects_random_library_one | objects_random_library_chosen | objects_random_graveyard_one | objects_random_graveyard_any

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[Perpetual([SetBasePowerToughness{power:$number, toughness:$number_2}, GrantAbility(Keyword($keyword_value))])]}} */
battlefield_perpetual_stats_keyword ::= "onto" "the" "battlefield" "under" "your" "control" "." "it" "perpetually" "has" "base" "power" "and" "toughness" number "/" number "and" "gains" keyword_value

/* @sem Operation::Move{objects:$random_singular_card_selection, destination:$battlefield_perpetual_stats_keyword, qualifiers:[]} */
put_random_singular_perpetual_battlefield ::= "put" random_singular_card_selection battlefield_perpetual_stats_keyword

/* Keep both ordered results attached to the same roll through its consumers. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RollTwoInOrder{sides:4}} */
roll_two_chosen_d4 ::= "roll" "two" "d4" "and" "choose" "one" "result"

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RollTwoInOrder{sides:6}} */
roll_two_chosen_d6 ::= "roll" "two" "d6" "and" "choose" "one" "result"

roll_two_chosen ::= roll_two_chosen_d4 | roll_two_chosen_d6 | roll_two_chosen_d8 | roll_two_chosen_d10 | roll_two_chosen_d12

/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[_{amount:DieResultAt{result:@prior, index:0}, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
create_chosen_die_tokens ::= "create" "a" "number" "of" token_recipe "equal" "to" "that" "result"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$roll_two_chosen}, Effect{result:@next, operation:$create_chosen_die_tokens}, ...$search_other_die_result]}} */
spell_roll_chosen_tokens_search ::= roll_two_chosen "." create_chosen_die_tokens "." "then" search_other_die_result "."

/* The repeated plural names the same controlled population in both effects. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($plural, $plural_2), $modifier_opponents_control])}, tapped:true}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($plural, $plural_2), $modifier_opponents_control])}), changes:[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})], duration:DuringControllersNextUntapStep, evaluation:LiveObjects}}] */
clause_tap_controlled_plural_skip ::= "tap" "all" plural modifier_opponents_control "." "those" plural "don't" "untap" "during" "their" "controllers'" "next" "untap" "steps"

/* A timed replacement applies to each future entry in the named population. */
/* @sem Operation::CreateReplacement{event:Enter{objects:$filter_plural}, limit:UntilExpired, duration:$duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}]}} */
temporary_plural_entry_tapped ::= duration "," filter_plural "enter" "tapped"

/* @sem Cost::Cost{parts:[Move{selections:[_{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, choose:Exactly(Constant(1))}], destination:OwnersHand(CardArrival{counters:[], states:[]})}]} */
payment_return_graveyard_filtered_a ::= "return" "a" filter_phrase "card" "from" "your" "graveyard" "to" "your" "hand"

/* Group the targets by owner, which can differ from their controllers. */
/* @sem Instruction::[ForEachPlayer{players:Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:$opponent_counter_creature_targets, filter:OwnedBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}, binding:0, body:_{instructions:[Effect{result:@next, operation:Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([InSet(Targets(0)), OwnedBy(One(Bound(0)))])}, destination:$owner_library_end_choice, qualifiers:[]}}]}}] */
opponent_counter_targets_owner_library ::= "for" "each" "opponent" "," opponent_counter_creature_targets "." "that" "creature's" "owner" "puts" "it" owner_library_end_choice

/* The announcement belongs to each opponent; subsequent references use that target group. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:$opponent_named_permanent_targets, tapped:true}}] */
clause_tap_each_opponent_permanent ::= "for" "each" "opponent" "," "tap" opponent_named_permanent_targets

/* A single defined value supplies both the counters and the life gain. */
/* @sem Instruction::[Effect{result:@mark, operation:BindValue{value:$value}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Targets(@last_slot)), kind:$counter_kind, amount:BoundValue(@marked)}]}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:BoundValue(@marked)}}] */
followup_target_counters_and_life_defined ::= "put" "X" counter_kind "counters" "on" "each" "of" "those" "permanents" "and" "you" "gain" "X" "life" "," "where" "X" "is" value

/* @sem Instruction::[...$clause_tap_each_opponent_permanent, ...$followup_target_counters_and_life_defined] */
instructions_each_opponent_tap_counters_life ::= clause_tap_each_opponent_permanent "." followup_target_counters_and_life_defined

/* A chosen counter on an affected object, with grammatical count agreement. */
/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), amount:Count(Exactly(Constant(1)))}]} */
remove_one_unspecified_counter ::= "remove" "a" "counter" "from" affected

/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), amount:Count(Exactly(@plural_amount($number_words)))}]} */
remove_many_unspecified_counters ::= "remove" number_words "counters" "from" affected

/* The payment belongs to the announced spell's controller. The countering
   action and its conditional result still belong to this ability. */
/* Countering supplies the antecedent and binds the complete exile arrival. */
/* @sem Instruction::[Effect{result:@next, operation:Counter{objects:One($target_stack_spell), destination:$countered_suspend_exile, destination_when:None}}] */
clause_counter_suspend ::= "counter" target_stack_spell "." countered_the_spell_this_way countered_suspend_exile

/* @sem () */
countered_the_spell_this_way ::= "if" "the" "spell" "is" "countered" "this" "way" ","

/* The arrival, counter amount, and suspend grant are one destination contract. */
/* @sem MovementDestination::Exile{visibility:FaceUp, arrival:ExileArrival{counters:[[Named(TimeCounter), $value]], states:[Changes([GrantAbility(Mechanic{mechanic:BasicSuspend})])]}} */
countered_suspend_exile ::= "exile" "it" "with" value "time" "counters" "on" "it" "instead" "of" "putting" "it" "into" "its" "owner's" "graveyard" "." "if" "it" "doesn't" "have" "suspend" "," "it" "gains" "suspend"

/* The qualifier describes the object filter; the enclosing action supplies the bound chooser. */
/* @sem ObjectFilter::$filter_phrase */
controlled_choice_each_basic_type ::= "a" filter_phrase "they" "control" "of" "each" "basic" "land" "type"

/* @sem Operation::ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$controlled_choice_each_basic_type, ControlledBy(One(Bound(0)))])}, count:AsManyAsCan(Constant(5)), constraints:[OneForEach([Subtype(Plains), Subtype(Island), Subtype(Swamp), Subtype(Mountain), Subtype(Forest)])]} */
bound_choose_each_basic_land_type ::= "chooses" controlled_choice_each_basic_type

/* The repeated noun must describe the selected population, not a new battlefield query. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($controlled_choice_each_basic_type, $filter_plural), ControlledBy(One(Bound(0)))])}, count:AsManyAsCan(Constant(5)), constraints:[OneForEach([Subtype(Plains), Subtype(Island), Subtype(Swamp), Subtype(Mountain), Subtype(Forest)])]}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_each_basic_choice_return ::= players_singular "chooses" controlled_choice_each_basic_type "." "return" "those" filter_plural "to" "their" "owners'" "hands"

/* The modal value is tied to the arrival of this single graveyard exile.
   The producer and all consumers share one reflexive scope. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:Not(SameObject(Source))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:Announcement{modes:$graveyard_exile_value_selection}, body:Program{}})}]} */
graveyard_exile_value_modal_program ::= "exile" "another" "card" "from" "a" "graveyard" "." "when" "you" "do" "," graveyard_exile_value_selection

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$graveyard_exile_value_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
graveyard_exile_value_selection ::= "choose" number_words "—" NEWLINE graveyard_exile_value_modes

/* @sem Mode::[$graveyard_exile_value_mode] */
graveyard_exile_value_modes_one ::= graveyard_exile_value_mode

/* @sem Mode::[$graveyard_exile_value_mode, ...$graveyard_exile_value_modes] */
graveyard_exile_value_modes_more ::= graveyard_exile_value_mode NEWLINE graveyard_exile_value_modes

graveyard_exile_value_modes ::= graveyard_exile_value_modes_one | graveyard_exile_value_modes_more

graveyard_exile_value_mode ::= graveyard_exile_value_remove_mode | graveyard_exile_value_pump_mode

/* @sem @reflexive(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($target_permanent)), amount:Count(Exactly(ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}))}]}}]}, weight:1}) */
graveyard_exile_value_remove_mode ::= "•" "remove" "X" "counters" "from" target_permanent "," "where" "X" "is" "the" "mana" "value" "of" "the" "exiled" "card" "."

/* @sem @reflexive(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ControlledBy(OpponentsOf(AbilityController))])}), index:0})), changes:[Pump{power:Multiply([Constant(-1), ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}]), toughness:Multiply([Constant(-1), ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}])}], duration:EndOfTurn, evaluation:Snapshot}}]}, weight:1}) */
graveyard_exile_value_pump_mode ::= "•" "target" noun "an" "opponent" "controls" "gets" "-" "X" "/" "-" "X" "until" "end" "of" "turn" "," "where" "X" "is" "the" "mana" "value" "of" "the" "exiled" "card" "."

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$graveyard_exile_value_modal_program} */
graveyard_exile_value_modal_trigger ::= event_clause "," graveyard_exile_value_modal_program

/* The anaphor is scoped by the enclosing block-pair trigger. */
/* @sem Operation::Move{objects:One(BlockPair(Attacker)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
combat_pair_return_to_owner ::= "return" "that" "creature" "to" "its" "owner's" "hand"

/* @sem Operation::CreateDelayedTrigger{event:$turn_end_combat, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:$combat_pair_return_to_owner}]}} */
combat_pair_delayed_return ::= combat_pair_return_to_owner "at" turn_end_combat

/* The bound chooser's selection stays available to later instructions. */
/* @sem Operation::ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}, count:AsManyAsCan($value)} */
bound_choose_controlled_count ::= "chooses" value filter_plural "they" "control"

/* A subsequent destruction excludes the selected permanents. */
/* @sem Operation::Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:Not(InSet(Selected(@prior)))}, regeneration:true} */
destroy_other_selected_permanents ::= "destroy" "all" "other" "permanents"

/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_choose_controlled_count}]}}, Effect{result:@next, operation:$destroy_other_selected_permanents}] */
instructions_each_choose_then_destroy_others ::= "each" "player" bound_choose_controlled_count "." destroy_other_selected_permanents

/* The named player both decides and performs the optional keyword action. */
/* @sem Instruction::[Optional{decider:$optional_keyword_player, body:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One($optional_keyword_player), action:$optional_keyword_action}}]}}] */
clause_player_optional_keyword ::= optional_keyword_player "may" optional_keyword_action

optional_keyword_player ::= active_player_ref | turn_owner_player | optional_keyword_you

/* @prefer always */
/* @sem PlayerRef::Active */
turn_owner_player ::= "the" "player" "whose" "turn" "it" "is"

/* @sem PlayerRef::AbilityController */
optional_keyword_you ::= "you"

optional_keyword_action ::= optional_keyword_end_turn | optional_keyword_learn | optional_keyword_investigate | optional_keyword_discover

/* @sem KeywordAction::EndTheTurn */
optional_keyword_end_turn ::= "end" "the" "turn"

/* @sem KeywordAction::Learn */
optional_keyword_learn ::= "learn"

/* @sem KeywordAction::Investigate{} */
optional_keyword_investigate ::= "investigate"

/* @sem KeywordAction::Discover{amount:$value} */
optional_keyword_discover ::= "discover" value

/* Per-opponent creature targets are partitioned at announcement. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:OpponentsOf(AbilityController), each:UpTo(Constant(1))}, filter:$noun_creature})) */
opponent_optional_creature_targets ::= "up" "to" "one" "target" noun_creature "that" "player" "controls"

/* The unpaid set belongs to this per-object payment, not to another action. */
/* @sem Instruction::[ForEachObject{objects:$opponent_optional_creature_targets, binding:0, body:_{instructions:[ForEachPlayer{players:One(ControllerOf(Bound(0))), binding:0, body:_{instructions:[Effect{result:@mark, operation:PayCost{player:Bound(0), cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}]}}]}, optional:true}}]}}]}}, Effect{result:@next, operation:Move{objects:Unpaid(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_opponent_creatures_return_unless ::= "for" "each" "opponent" "," "choose" opponent_optional_creature_targets "," "then" "return" "that" "creature" "to" "its" "owner's" "hand" "unless" "its" "controller" "has" "you" "draw" card_count

/* The event group supplies the creatures named by the trigger. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(EventGroup), changes:$event_creatures_changes, duration:$duration, evaluation:Snapshot} */
event_creatures_temporary_changes ::= "those" "creatures" event_creatures_changes duration

event_creatures_changes ::= event_creatures_pump | event_creatures_gain

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}] */
event_creatures_pump ::= "get" signed "/" signed

/* @sem $grants */
event_creatures_gain ::= "gain" grants

/* A return attached to a player is a movement phrase usable independently of timing. */
/* @sem Operation::Move{objects:$affected, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedToPlayer($return_attachment_player)]}}, qualifiers:[]} */
return_attached_player_move ::= "return" affected "to" "the" "battlefield" "attached" "to" return_attachment_player

/* @sem PlayerRef::AbilityController */
return_attachment_you ::= "you"

return_attachment_player ::= return_attachment_you | that_player

/* A delayed end-step instruction retains the move and timing as independent operands. */
/* @sem Operation::CreateDelayedTrigger{event:$delayed_move_end_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:$return_attached_player_move}]}} */
delayed_attached_player_return ::= return_attached_player_move "at" delayed_move_end_event

/* Bind the returned event card and the later attachment to the same move receipt. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Move{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), destination:$attached_return_producer_destination, qualifiers:[]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$attached_return_time, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:$affected, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo(Result{result:@marked, phase:After, index:0})]}}, qualifiers:[]}}]}}}]} */
program_event_return_delayed_attachment ::= "return" "that" "card" "to" "the" "battlefield" attached_return_producer_destination "." "return" affected "to" "the" "battlefield" "attached" "to" "that" "creature" "at" attached_return_time

attached_return_producer_destination ::= battlefield_control | attached_return_owner_tapped

/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}} */
attached_return_owner_tapped ::= "tapped" "under" "its" "owner's" "control"

attached_return_time ::= delayed_move_end_event | attached_return_next_upkeep

/* @sem EventSpec::Turn{point:UpkeepBegins, players:All} */
attached_return_next_upkeep ::= "the" "beginning" "of" "the" "next" "upkeep"

/* The tested stack object is also the object whose target changes. */
/* @sem Instruction::[If{condition:ObjectMatches{object:$retarget_single_stack_object, filter:TargetsAny($recipients)}, then:Program{instructions:[Effect{result:@next, operation:Retarget{actor:One(AbilityController), object:$retarget_single_stack_object, targets:ToPlayers(All)}}]}, otherwise:Program{}}] */
clause_retarget_player_condition ::= "change" "the" "target" "of" retarget_single_stack_object "if" "that" "target" "is" recipients "." "the" "new" "target" "must" "be" "a" "player"

/* The discard producer and both receipt counts form one inverse contract. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), count:AnyNumber}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}]}}]}, optional:true}}, If{condition:PaymentChosen(@back(3)), then:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountObjects(Transition{result:@prior, phase:Before})}}, Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:Repeat{amount:CountObjects(Transition{result:@back(3), phase:Before}), production:Amount{color:$mana_letter, amount:Constant(1)}, choice:Once}, restriction:Persists(EndOfTurn)}}]}, otherwise:_{}}] */
instructions_optional_discard_draw_mana ::= "you" "may" "discard" "any" "number" "of" "cards" "." "if" "you" "do" "," "draw" "that" "many" "cards" "and" "add" "that" "much" "{" mana_letter "}" "." "until" "end" "of" "turn" "," "you" "don't" "lose" "this" "mana" "as" "steps" "and" "phases" "end"

/* The group, duration, and combat rule are independently reusable operands. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($plural_assignment_group), changes:[$assign_unblocked_change], duration:$this_duration, evaluation:LiveObjects} */
plural_assign_unblocked_effect ::= plural_assignment_group "assign" "their" "combat" "damage" this_duration "as" "though" "they" assign_unblocked_change

/* The subsequent target choice belongs to each player making their own copy. */
/* @sem Operation::CopyOnStack{actor:One(Bound(0)), object:$object_ref, times:Constant(1), targets:May} */
bound_copy_with_target_choice ::= "copies" object_ref "." "each" "of" "those" "players" "may" "choose" "new" "targets" "for" "their" "copy"

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_copy_with_target_choice}]}}] */
instructions_each_player_copy ::= players_singular bound_copy_with_target_choice

/* The success continuation consumes the input of this specific one-creature payment. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:$player_ref, cost:$sacrifice_one_creature_choice_cost, optional:false}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$sacrifice_creature_stat_instead}, otherwise:Program{}}] */
instructions_sacrifice_creature_stat_instead ::= player_ref sacrifice_one_creature_choice_cost "." "if" "they" "do" "," sacrifice_creature_stat_instead

/* @sem Cost::Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:Exactly(Constant(1))}]} */
sacrifice_one_creature_choice_cost ::= "sacrifices" "a" "creature" "of" "their" "choice"

/* @sem Instruction::[If{condition:ObjectMatches{object:Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Inputs, phase:Before}, index:0}, filter:Property{property:$stat, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}}, then:$program_2, otherwise:$program}] */
sacrifice_creature_stat_instead ::= program "." program "instead" "if" "the" "sacrificed" "creature's" stat "was" value "or" "greater"

/* Removal and its following prohibition refer to the same announced object. */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($target_permanent)), amount:All}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:0, index:0})), changes:[Rule(Prohibit(ReceiveCounters(None)))], duration:$duration, evaluation:LiveObjects}}]}, weight:1}) */
mode_remove_object_counters_prevent ::= "•" "remove" "all" "counters" "from" target_permanent "." "it" "can't" "have" "counters" "put" "on" "it" duration "."

/* The opponent remains the recipient of both instructions in this mode. */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Players(One($target_opponent)), amount:All}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(Target{slot:0, index:0})), changes:[PlayerRule(Prohibit(ReceiveCounters(None)))], duration:$duration, evaluation:LiveObjects}}]}, weight:1}) */
mode_remove_opponent_counters_prevent ::= "•" target_opponent "loses" "all" "counters" "." "that" "player" "can't" "get" "counters" duration "."

/* The continuous effect applies to the arrival from this same graveyard return. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), destination:$returned_loss_control, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[RemoveAllAbilities], duration:Indefinite, evaluation:Snapshot}}]} */
program_return_dead_lose_abilities ::= "return" "it" "to" "the" "battlefield" returned_loss_control "and" "it" "loses" "all" "abilities"

returned_loss_control ::= battlefield_control | returned_loss_owner_tapped

/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}} */
returned_loss_owner_tapped ::= "tapped" "under" "its" "owner's" "control"

/* The choice and perpetual modification share their actual selection receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Shared(Battlefield), kind:Permanent, filter:@and($retirement_choice_creature_filter, ObjectFilter::ControlledBy(OpponentsOf(AbilityController)))}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:[Pump{power:$signed, toughness:$signed_2}]}}] */
retirement_choice_perpetual_pump ::= "a" retirement_choice_creature_filter "of" "your" "choice" "an" "opponent" "controls" "perpetually" "gets" signed "/" signed

/* The return names the previously announced singular target, and the conditional
   consumes that payment's result inside the delayed trigger's own body. */
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_move_end_event, start:Immediately, body:_{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[Move{selections:[_{objects:One(Target{slot:0, index:0})}], destination:OwnersHand{}}]}}}, If{condition:PaymentChosen(@last_result), then:_{instructions:$retirement_choice_perpetual_pump}, otherwise:_{}}]}}}] */
retirement_delayed_return_choice ::= "at" delayed_move_end_event "," "return" "that" "creature" "to" "its" "owner's" "hand" "." "if" "you" "do" "," retirement_choice_perpetual_pump

/* The same optional target is referenced by the delayed return. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($retirement_optional_attacker)), changes:$rule_cant_be_blocked, duration:$this_duration, evaluation:LiveObjects}}, ...$retirement_delayed_return_choice] */
retirement_attacker_unblockable_return ::= retirement_optional_attacker rule_cant_be_blocked this_duration "." retirement_delayed_return_choice

/* The strict comparison excludes the previously named object; the choice receipt
   supplies the single recipient of the following temporary keyword grant. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([AllOf([Attacking, CardType(Creature)]), Property{property:$stat, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:@named_object, property:$stat, information:CurrentOrLastKnown}}}])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}] */
instructions_choose_lesser_stat_grant ::= "choose" "another" "attacking" "creature" "with" "lesser" stat "." "that" "creature" "gains" keyword_name duration

/* The payment and the copied card share one receipt, including its destination. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:_{parts:[Move{selections:[_{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$exile_payment_card_filter}, choose:Exactly(Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0}, exceptions:$copy_token_characteristics}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Created(@prior)), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}]}, otherwise:_{}}]} */
exile_graveyard_card_copy_token_program ::= "you" "may" "exile" exile_payment_card_filter "card" "from" "your" "graveyard" "." "if" "you" "do" "," "create" "a" "token" "that's" "a" "copy" "of" "that" "card" "," "except" copy_token_characteristics "." "it" "gains" keyword_name duration "."

/* Article forms are separate so printing can choose the grammatical form. */
/* @sem $noun */
exile_payment_card_filter_a ::= "a" noun

/* @sem $noun_artifact */
exile_payment_card_filter_an_artifact ::= "an" noun_artifact

/* @sem $noun_enchantment */
exile_payment_card_filter_an_enchantment ::= "an" noun_enchantment

exile_payment_card_filter ::= exile_payment_card_filter_a | exile_payment_card_filter_an_artifact | exile_payment_card_filter_an_enchantment

/* The mill and cast share the same producer and player population. */
/* @sem Instruction::[Effect{result:@next, operation:Mill{players:All, amount:$mill_cast_amount}}, Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Recorded(@prior), count:PerPlayer{players:All, each:UpTo($card_count_one)}, terms:_{cost:Free}}}] */
instructions_each_mill_cast_per_player ::= "each" "player" "mills" mill_cast_amount "." "for" "each" "player" "," "you" "may" "cast" card_count_one "that" "player" "milled" "this" "way" "without" "paying" "its" "mana" "cost"

/* This amount refers to the enclosing event, not the preceding result. */
/* @sem Expr::EventAmount */
mill_cast_event_amount ::= "that" "many" "cards"

/* @sem $count_plural */
mill_cast_fixed_amount ::= count_plural "cards"

/* The event group reading remains distinct from EventAmount. */
/* @sem Expr::CountObjects(EventGroup) */
mill_cast_event_group_amount ::= "that" "many" "cards"

mill_cast_amount ::= mill_cast_event_amount | mill_cast_event_group_amount | mill_cast_fixed_amount

/* These placements are scoped to the source-attacks trigger. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects(One($target_source_defender_choice)), kind:$counter_kind, amount:$counter_amount}]} */
source_defender_counter_single ::= "put" counter_amount counter_kind "counter" "on" target_source_defender_choice

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(One($target_source_defender_choice)), kind:$counter_kind, amount:$counter_amount}]} */
source_defender_counter_plural ::= "put" counter_amount counter_kind "counters" "on" target_source_defender_choice

source_defender_counter_placement ::= source_defender_counter_single | source_defender_counter_plural

/* The event subject is the source, so its defending player chooses. */
/* @sem Ability::Triggered{event:Object{event:Attacks, objects:$event_self}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$source_defender_counter_placement}]}} */
source_attack_defender_counter_trigger ::= "whenever" event_self "attacks" "," source_defender_counter_placement "."

/* The observation and choice address the same player's hand; the discard uses the selection. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One($target_possessive)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One($target_possessive)}, kind:Card, filter:Any}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}] */
instructions_look_hand_choose_discard ::= "look" "at" target_possessive "hand" "and" "choose" "a" "card" "from" "it" "." "that" "player" "discards" "that" "card"

/* The random hand selection, exile receipt, permission and delayed cleanup are
   one scope: both later references name the arrival of this exact move. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:EventSubject, objects:Zone(_{scope:Players{zone:Hand, players:One(EventSubject)}, kind:Card, filter:$random_exile_hand_filter}), count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:_{}}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(EventSubject)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:$random_exile_permission_duration, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@back(4), phase:After, index:0}), zone:Exile}, destination:$random_exile_cleanup_destination}}]}}}] */
instructions_random_hand_exile_play_cleanup ::= "that" "player" "exiles" random_exile_hand_filter "at" "random" "from" "their" "hand" "." "the" "player" "may" "play" "that" "card" random_exile_permission_duration "." "at" "the" "beginning" "of" "the" "next" "end" "step" "," "if" "the" "player" "hasn't" "played" "the" "card" "," "they" "put" "it" "into" "their" random_exile_cleanup_destination

random_exile_hand_filter ::= random_exile_any_card | random_exile_typed_card

/* @sem ObjectFilter::Any */
random_exile_any_card ::= "a" "card"

/* @sem $card_noun */
random_exile_typed_card ::= "a" card_noun "card"

random_exile_cleanup_destination ::= random_exile_cleanup_graveyard | random_exile_cleanup_hand

/* @sem MovementDestination::OwnersGraveyard(CardArrival{counters:[], states:[]}) */
random_exile_cleanup_graveyard ::= "graveyard"

/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
random_exile_cleanup_hand ::= "hand"

random_exile_permission_duration ::= this_turn | this_combat

/* The exclusion names the one card paid into exile by this same optional action. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Move{selections:[_{objects:One($current_card_ref)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:Move{objects:@zone_members(ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([Not(SameObject(Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0})), ExiledWith($object_ref)])}), destination:$linked_other_destination, qualifiers:[]}}]}, otherwise:Program{}}] */
instructions_optional_exile_linked_other ::= "you" "may" "exile" current_card_ref "." "if" "you" "do" "," "return" "each" "other" "card" "exiled" "with" object_ref linked_other_destination

linked_other_destination ::= linked_other_graveyard | linked_other_hand

/* @sem MovementDestination::OwnersGraveyard(CardArrival{counters:[], states:[]}) */
linked_other_graveyard ::= "to" "its" "owner's" "graveyard"

/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
linked_other_hand ::= "to" "its" "owner's" "hand"

/* Keep the exile producer and both uses of its receipt in one scope. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:LibraryTops(All), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Transition{result:@marked, phase:After}), kind:$counter_kind, amount:Constant(1)}]}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind_2, amount:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$adjective_nontype})}]}}] */
instructions_exile_each_library_counter_count ::= "exile" "the" "top" "card" "of" "each" "player's" "library" "and" "put" "a" counter_kind "counter" "on" "each" "of" "them" "." "put" "a" counter_kind "counter" "on" affected "for" "each" adjective_nontype "card" "exiled" "this" "way"

/* The second chooser is the controller of the first announced target; the
   repeated nouns identify those same targets in the coin-flip branches. */
/* @sem Instruction::[Effect{result:@next, operation:FlipCoin{player:AbilityController, protocol:@coin_protocol}}, If{condition:CoinFlip{result:@last_result, outcome:Won}, then:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([@agree($noun, $noun_3), ControlledBy(OpponentsOf(AbilityController))])}), index:0}), regeneration:true}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@agree($noun_2, $noun_4), chooser:ControllerOf(Target{slot:0, index:0})}), index:0}), regeneration:true}}]}}] */
chosen_targets_coin_destroy ::= "you" "choose" "target" noun "an" "opponent" "controls" "," "and" "that" "opponent" "chooses" "target" noun "." "flip" "a" "coin" "." "if" "you" "win" "the" "flip" "," "destroy" "the" noun "you" "chose" "." "if" "you" "lose" "the" "flip" "," "destroy" "the" noun "your" "opponent" "chose"

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:$chosen_targets_coin_destroy}} */
activated_chosen_targets_coin ::= cost ":" chosen_targets_coin_destroy "."

/* Scope the destruction receipt together with the copy; the two noun forms must agree. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(AnnouncedX), filter:@agree($plural, $noun)})), regeneration:true}}, If{condition:$copy_receipt_condition, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:CopyEach{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:InSet(Recorded(@prior))}, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, ...$created_tokens_keyword_exile]}, otherwise:Program{}}] */
destroy_target_copies_conditional ::= "destroy" "up" "to" "X" "target" plural "." "if" copy_receipt_condition "," "for" "each" noun "destroyed" "this" "way" "," "create" "a" "token" "that's" "a" "copy" "of" "it" "." created_tokens_keyword_exile

/* The cleanup acts on the token creation immediately preceding this continuation. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Created(@prior)), changes:[GrantKeyword($keyword_name)], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Created(@back(4)), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]}}}] */
created_tokens_keyword_exile ::= "those" "tokens" "gain" keyword_name "." "exile" "them" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* @sem Condition::Compare{left:AnnouncedX, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
copy_receipt_condition ::= "X" "is" number "or" "more"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$destroy_target_copies_conditional}} */
spell_destroy_target_copies_conditional ::= destroy_target_copies_conditional "."

/* The tested card and copied card are the arrival of this exact exile. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:$card_filter})), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:Any}, then:Program{instructions:[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:Copy{object:Result{result:@marked, phase:After, index:0}, exceptions:$copy_token_characteristics}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]}, otherwise:Program{}}] */
exile_single_arrival_copy_branch ::= "exile" "up" "to" "one" "target" card_filter "card" "from" "a" "graveyard" "." "if" "you" "exiled" "a" "card" "this" "way" "," "create" token_copy_single "that" "card" "," "except" copy_token_characteristics

/* Each opponent chooses from the permanents they control; later clauses may consume that receipt. */
/* @sem Instruction::[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$casting_target_filter, ControlledBy(One(Bound(0)))])}, count:AsManyAsCan(Constant(1))}}]}}] */
clause_opponents_choose_filtered_controlled ::= "each" "opponent" "chooses" casting_target_filter "they" "control"

/* Each opponent moves the object from their own choice receipt. */
/* @sem Instruction::[...$clause_opponents_choose_filtered_controlled, ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(ChosenBy{result:@prior, chooser:Bound(0)}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
clause_opponents_choice_exile ::= clause_opponents_choose_filtered_controlled "and" "exiles" "it"

/* The optional choice covers untapping and control; the later grant is independent. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:SetTapped{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$noun_creature}), index:0}), tapped:false}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:0, index:0})), changes:[SetController(AbilityController)], duration:$duration, evaluation:Snapshot}}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:0, index:0})), changes:[GrantKeyword($keyword_name)], duration:$duration_2, evaluation:Snapshot}}]} */
program_optional_untap_control_then_grant ::= "you" "may" "untap" "target" noun_creature "and" "gain" "control" "of" "it" duration "." "that" "creature" "gains" keyword_name duration "."

optional_hand_choice_filter ::= optional_hand_card_choice | optional_hand_noun_choice

/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$noun}), count:AsManyAsCan(Constant(1))} */
optional_hand_noun_choice ::= "choose" "a" noun "card" "in" "your" "hand"

optional_hand_incorporation ::= incorporated_black_grant | incorporate_cast_grant | incorporate_pump

/* A damage receipt and its follow-up must remain inside the unpaid branch. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun, Not(SameObject(Source))])}, choose:Exactly(Constant(1))}]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(One(AbilityController)), amount:$number, preventable:true}}, If{condition:Compare{left:CountPlayers(Intersection([DamagedBy(@last_result), One(AbilityController)])), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:_{instructions:[Effect{result:@next, operation:SetTapped{objects:One(Source), tapped:true}}]}, otherwise:_{}}]}, otherwise:_{}}]} */
self_damage_unless_other_sacrifice_tap_program ::= "this" "creature" "deals" number "damage" "to" "you" "unless" "you" "sacrifice" "a" noun "other" "than" "this" "creature" "." "if" "this" "creature" "deals" "damage" "to" "you" "this" "way" "," "tap" "it" "."

/* A singular player chooses from a battlefield population with an explicit
   excluded object. The choice can be reused by selected-object actions. */
choice_battlefield_other ::= choice_battlefield_other_tapped | choice_battlefield_other_plain

/* @prefer always */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Tapped, $filter_phrase, Not(SameObject($object_ref))])} */
choice_battlefield_other_tapped ::= "a" "tapped" filter_phrase "other" "than" object_ref

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Not(SameObject($object_ref))])} */
choice_battlefield_other_plain ::= "a" filter_phrase "other" "than" object_ref

choice_singular_actor ::= alternative_life_actor | target_opponent

/* @sem Operation::ChooseObjects{player:$choice_singular_actor, objects:$choice_battlefield_other, count:AsManyAsCan(Constant(1))} */
choose_battlefield_other ::= choice_singular_actor "chooses" choice_battlefield_other

/* The move consumes the immediately preceding selection. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_battlefield_other}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_choice_exiles_it ::= choose_battlefield_other "and" "exiles" "it"

/* Each optional target is a battlefield permanent; the union keeps its slots independent. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:$filter_phrase})) */
optional_battlefield_target ::= "up" "to" "one" "target" filter_phrase

/* @sem ObjectSet::Union([$optional_battlefield_target, $optional_battlefield_target_2, $optional_battlefield_target_3, $optional_battlefield_target_4, $optional_battlefield_target_5]) */
five_optional_battlefield_targets ::= optional_battlefield_target "," optional_battlefield_target "," optional_battlefield_target "," optional_battlefield_target "," "and" "/" "or" optional_battlefield_target

exile_permanent_population ::= five_optional_battlefield_targets | optional_battlefield_target

/* @sem Operation::Move{objects:$exile_permanent_population, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_permanent_population_action ::= "exile" exile_permanent_population

/* The conditional tests the arrival of the very card chosen from this hand. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Group{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$a_card}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}]}]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$subtype}, then:$program, otherwise:Program{}}] */
instructions_optional_hand_entry_test ::= "you" "may" "put" a_card "from" "your" "hand" "onto" "the" "battlefield" "." "if" "you" "put" "a" subtype "onto" "the" "battlefield" "this" "way" "," program

/* An optional action may also enclose its subsequent conditional. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$a_card}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$subtype}, then:$program, otherwise:Program{}}]}}] */
instructions_optional_hand_entry_enclosed_test ::= "you" "may" "put" a_card "from" "your" "hand" "onto" "the" "battlefield" "." "if" "you" "put" "a" subtype "onto" "the" "battlefield" "this" "way" "," program

/* @sem Instruction::[Effect{result:@next, operation:$operation}, ...$instructions_optional_hand_entry_enclosed_test] */
instructions_operation_then_hand_entry_enclosed_test ::= operation "," "then" instructions_optional_hand_entry_enclosed_test

/* A preceding operation does not change the hand-entry receipt. */
/* @sem Instruction::[Effect{result:@next, operation:$operation}, ...$instructions_optional_hand_entry_test] */
instructions_operation_then_hand_entry_test ::= operation "," "then" instructions_optional_hand_entry_test

/* Each exchanged object retains its own reference and target announcement. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::ExchangeControl{first:$object_ref, second:$target_object}} */
exchange_control_objects ::= "exchange" "control" "of" object_ref "and" target_object

/* Token replacement composes the event population, duration, and new controller. */
/* @sem Operation::CreateReplacement{event:$token_control_replacement_event, limit:UntilExpired, duration:$this_duration, body:$token_control_replacement_response} */
temporary_token_control_replacement ::= token_control_replacement_event this_duration token_control_replacement_response

/* @sem ReplacementEvent::Tokens{tokens:$token_replacement_filter, controllers:$token_replacement_controllers} */
token_control_replacement_event ::= "each" token_replacement_filter "that" "would" "be" "created" "under" token_replacement_controllers "control"

token_replacement_filter ::= token_replacement_any | token_replacement_filtered

/* @sem ObjectFilter::Any */
token_replacement_any ::= "token"

/* @sem ObjectFilter::$filter_phrase */
token_replacement_filtered ::= filter_phrase "token"

token_replacement_controllers ::= token_replacement_opponents | token_replacement_you

/* @sem PlayerSet::OpponentsOf(AbilityController) */
token_replacement_opponents ::= "an" "opponent's"

/* @sem PlayerSet::One(AbilityController) */
token_replacement_you ::= "your"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetController(AbilityController)}}]} */
token_control_replacement_response ::= "is" "created" "under" "your" "control" "instead"

/* Both attachments are the battlefield arrivals of this conjure action. */
/* @sem Instruction::[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Each([$referenced_card_name, $referenced_card_name_2]), count:Constant(1), destination:Battlefield(BattlefieldArrival{tapped:false, counters:[], states:[]})}}, Effect{result:@next, operation:Attach{attachments:Transition{result:@prior, phase:After}, host:Source}}] */
instructions_conjure_named_pair_attach_source ::= "conjure" "a" "card" "named" referenced_card_name "and" "a" "card" "named" referenced_card_name "onto" "the" "battlefield" "and" "attach" "them" "to" "this" "creature"

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:_{instructions:$instructions_conjure_named_pair_attach_source}} */
triggered_conjure_named_pair_attach ::= event_clause "," instructions_conjure_named_pair_attach_source "."

/* The event, duration and response retain independent operands. */
/* @sem Operation::CreateReplacement{event:$controlled_noncombat_damage_event, limit:UntilExpired, duration:$this_duration, body:$temporary_damage_change} */
temporary_controlled_damage_replacement ::= "if" controlled_noncombat_damage_event this_duration "," temporary_damage_change

/* @sem ReplacementEvent::Damage(_{source_kind:Any, sources:ControlledBy(One(AbilityController)), recipients:ObjectsAndPlayers{objects:$filter_phrase, players:All}, kind:$controlled_damage_kind, grouping:SourceRecipient, subject:Recipient}) */
controlled_noncombat_damage_event ::= "a" "source" "you" "control" "would" "deal" controlled_damage_kind "damage" "to" "a" filter_phrase "or" "player"

controlled_damage_kind ::= controlled_noncombat_kind | controlled_combat_kind

/* @sem DamageKind::Noncombat */
controlled_noncombat_kind ::= "noncombat"

/* @sem DamageKind::Combat */
controlled_combat_kind ::= "combat"

/* The result belongs to the enclosing die-roll trigger, not an arbitrary event. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:EventAmount}]} */
dice_result_counter_placement ::= "put" "a" "number" "of" counter_kind "counters" "on" affected "equal" "to" "the" "result"

dice_result_event ::= event_dice | event_you_roll_die

/* @sem Ability::Triggered{event:$dice_result_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$dice_result_counter_placement}]}} */
dice_result_counters_trigger ::= "whenever" dice_result_event "," dice_result_counter_placement "."

/* EventGroup is supplied by the enclosing creature-batch event. */
event_group_counter_program ::= event_group_counter_one | event_group_counter_many

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(EventGroup), kind:$counter_kind, amount:Constant(1)}]}}]} */
event_group_counter_one ::= "put" "a" counter_kind "counter" "on" "each" "of" "those" "creatures"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(EventGroup), kind:$counter_kind, amount:$number_words}]}}]} */
event_group_counter_many ::= "put" number_words counter_kind "counters" "on" "each" "of" "those" "creatures"

/* Scope the receipt wording to the goad action that produced it. */
/* @sem Instruction::[Effect{result:@next, operation:$goad_creature_receipt_producer}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:CountObjects(Recorded(@prior))}]}}] */
instructions_goad_each_counter_receipt ::= goad_creature_receipt_producer "." "put" "a" counter_kind "counter" "on" affected "for" "each" "creature" "goaded" "this" "way"

/* The counted producer is constrained to creatures in both directions. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Goad{}, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($noun_creature, $modifiers)}} */
goad_creature_receipt_producer ::= "goad" "each" noun_creature modifiers

/* The pronoun refers to the subject of the enclosing event, not the holder. */
/* @sem CounterPlacement::CounterPlacement{recipients:Objects(One(EventSubject)), kind:$counter_kind, amount:Constant(1)} */
event_subject_him_counter_one ::= counter_a counter_kind "counter" "on" "him"

/* @sem CounterPlacement::CounterPlacement{recipients:Objects(One(EventSubject)), kind:$counter_kind, amount:@plural_amount($counter_amount)} */
event_subject_him_counter_many ::= counter_amount counter_kind "counters" "on" "him"

event_subject_him_counter_placement ::= event_subject_him_counter_one | event_subject_him_counter_many

/* @sem Operation::PutCounters{placements:[$event_subject_him_counter_placement]} */
put_event_subject_him_counters ::= "put" event_subject_him_counter_placement

/* Keep the draw producer and its counted placement in one reversible sequence. */
/* @sem Instruction::[Effect{result:@mark, operation:Draw{players:$announced_many_players, amount:$card_count}}, Effect{result:@next, operation:$put_counters_direct}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:Performed(@marked)}]}}] */
instructions_draw_counter_receipt ::= announced_many_players "each" "draw" card_count "." put_counters_direct "," "then" "put" "an" counter_kind "counter" "on" affected "for" "each" "card" "drawn" "this" "way"

/* The opponent is announced once; the final sacrifice consumes the original choice. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$secret_controlled_choice_filter, ControlledBy(One($target_opponent))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Sacrifice{players:One($target_opponent), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$secret_sacrifice_filter}, choose:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Sacrifice{players:One($target_opponent), objects:One(Result{result:@back(3), phase:After, index:0})}}] */
instructions_secret_choice_and_sacrifices ::= "choose" target_opponent "." "secretly" "choose" "a" secret_controlled_choice_filter "that" "player" "controls" "." "that" "player" "sacrifices" "a" secret_sacrifice_filter "of" "their" "choice" "," "then" "sacrifices" "the" "chosen" "permanent"

secret_controlled_choice_filter ::= filter_phrase

secret_sacrifice_filter ::= filter_phrase

/* A vote total is independent of each recipient in the affected set. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:$counter_vote_total}]} */
put_counters_equal_votes ::= "put" "a" "number" "of" counter_kind "counters" "on" affected counter_vote_total

/* @sem Expr::Votes(Word($vote_word)) */
counter_vote_total ::= "equal" "to" "the" "number" "of" vote_word "votes"

/* The announced union target is shared by all three continuous effects; the
   duration names the object that must remain on the battlefield. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([AnyOf([$subtype, $noun]), ControlledBy(OpponentsOf(AbilityController))])}), index:0})), changes:[SetController(AbilityController)], duration:$while_on_battlefield, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@last_slot, index:0})), changes:[RemoveAllAbilities], duration:$while_on_battlefield, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@last_slot, index:0})), changes:[Rule(Prohibit(Attack(Any))), Rule(Prohibit(Block(Any)))], duration:$while_on_battlefield, evaluation:LiveObjects}}]} */
program_choose_opponent_union_control_disable ::= "choose" "target" subtype "or" noun "an" "opponent" "controls" "." while_on_battlefield "," "gain" "control" "of" "that" "permanent" "," "it" "loses" "all" "abilities" "," "and" "it" "can't" "attack" "or" "block" "."

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$program_choose_opponent_union_control_disable} */
triggered_choose_opponent_union_control_disable ::= event_clause "," program_choose_opponent_union_control_disable

/* The counter is part of the exile arrival of the chosen card. */
/* @sem Operation::Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:AllOf([$card_filter, InZone(Players{zone:Graveyard, players:One(AbilityController)})])})), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[[$counter_kind, Constant(1)]], states:[]}}, qualifiers:[]} */
exile_optional_owned_graveyard_counter ::= "exile" "up" "to" "one" "target" card_filter "card" "from" "your" "graveyard" "with" "a" counter_kind "counter" "on" "it"

/* The chosen player performs the life loss; the controller makes the offer. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:$player_ref, body:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One($player_ref), amount:$value}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:$program, otherwise:Program{}}]} */
program_optional_player_life_followup ::= "you" "may" "have" player_ref "lose" value "life" "." "if" "you" "do" "," program

/* The paid object is the same source that returns from the exile receipt. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Move{selections:[_{objects:One($self_explicit_ref)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:Move{objects:@exile_followup(InZone{objects:One(Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0}), zone:Exile}), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[Transformed]}}, qualifiers:[]}}]}, otherwise:Program{}}] */
instructions_optional_paid_self_exile_return_him ::= "you" "may" "exile" self_explicit_ref "." "if" "you" "do" "," "return" "him" "to" "the" "battlefield" "transformed" "under" "his" "owner's" "control"

/* The grant and delayed sacrifice refer to the same immediately entered creature. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:One(Result{result:@back(4), phase:After, index:0})})}]}}}] */
entered_creature_timed_grant_sacrifice ::= "that" "creature" "gains" keyword_name duration "." "sacrifice" "it" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* A trailing conditional change applies to the controlled fighter before the fight.
   Both announced targets and the condition remain independent operands. */
/* @sem Instruction::[If{condition:$fight_before_condition, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), index:0})), changes:$static_singular_pump, duration:$duration, evaluation:Snapshot}}]}, otherwise:Program{}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:Target{slot:0, index:0}, second:$target_permanent}}}] */
controlled_fight_before_conditional_change ::= "target" "creature" "you" "control" "fights" target_permanent "." NEWLINE "the" "creature" "you" "control" static_singular_pump duration "before" "it" "fights" "if" fight_before_condition

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$controlled_fight_before_conditional_change}} */
controlled_fight_before_spell ::= controlled_fight_before_conditional_change "."

/* The two phrases retain their own population operands and the player's choice. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:PayCost{player:Bound(0), cost:_{parts:[ObjectAction{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:Extreme{among:$bound_controlled_population_singular, property:$stat, highest:true}}, action:PayManaCost}]}, optional:true}}, If{condition:Not(PaymentChosen(0)), then:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(Bound(0)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:Extreme{among:$bound_controlled_population_tied, property:$stat, highest:true}}, choose:AsManyAsCan($bound_extreme_choice)})}]}, otherwise:_{}}]}}] */
shared_sacrifice_unless_extreme_cost ::= players_singular "sacrifices" bound_controlled_population_singular "with" "the" "greatest" stat "unless" "they" "pay" "that" "creature's" "mana" "cost" "." bound_controlled_population_tied "," "that" "player" "chooses" bound_extreme_choice

bound_extreme_choice ::= bound_extreme_choice_words | value

/* @prefer always */
/* @sem $number_words */
bound_extreme_choice_words ::= number_words

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$shared_sacrifice_unless_extreme_cost]}} */
spell_shared_sacrifice_unless_extreme_cost ::= shared_sacrifice_unless_extreme_cost "."

/* The triggering player is both the payer and the damage recipient. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:EventSubject, cost:Cost{parts:[Mana($mana_symbols)]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:Players(One(EventSubject)), amount:$number, preventable:true}}]}, otherwise:Program{}}] */
clause_event_player_damage_unless_mana ::= damage_source_ref "deals" number "damage" "to" "that" "player" "unless" "they" "pay" mana_symbols

/* The copied object is the single card moved by this adjacent exile instruction. */
/* @sem Operation::Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:AllOf([AllOf([$card_filter, $modifier_mana_value_bound]), InZone(Players{zone:Graveyard, players:One(AbilityController)})])})), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_up_to_one_your_graveyard_bounded ::= "exile" "up" "to" "one" "target" card_filter "card" modifier_mana_value_bound "from" "your" "graveyard"

/* @sem Instruction::[Effect{result:@next, operation:CopyCards{actor:One(AbilityController), objects:One(Result{result:@prior, phase:After, index:0}), times:Constant(1)}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Copies(@prior), count:Exactly(Constant(1)), cost:Free}}]}}] */
copy_it_may_cast_copy_free ::= "copy" "it" "." "you" "may" "cast" "the" "copy" "without" "paying" "its" "mana" "cost"

/* @sem Instruction::[Effect{result:@next, operation:$exile_up_to_one_your_graveyard_bounded}, ...$copy_it_may_cast_copy_free] */
instructions_exile_bounded_copy_free ::= exile_up_to_one_your_graveyard_bounded "." copy_it_may_cast_copy_free

/* A placed counter and a land-type effect independently name their counter kinds. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$upkeep_nonbasic_filter, CardType(Land)])}), index:0})), kind:$counter_kind, amount:Constant(1)}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@last_slot, index:0})), changes:[SetLandType(Vocabulary{family:LandType, form:@subtype_name($basic_land_type_named)})], duration:WhileMatches{object:Affected, filter:Counters(_{kind:$counter_kind_2, comparison:Greater, value:Constant(0)})}, evaluation:Snapshot}}]} */
program_counter_land_type_duration ::= "put" "a" counter_kind "counter" "on" "target" upkeep_nonbasic_filter "land" "." "that" "land" "is" basic_land_type_named "for" "as" "long" "as" "it" "has" "a" counter_kind "counter" "on" "it" "."

/* An optional action can gate a follow-up using the payment choice itself. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:@apply(PlayerSet::One(AbilityController), $verbs_base)}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:$event_graveyard_followup, otherwise:Program{}}]} */
optional_action_event_graveyard ::= "you" "may" verbs_base "." "if" "you" "do" "," event_graveyard_followup

event_graveyard_followup ::= event_graveyard_exile_program | event_graveyard_return_program

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]} */
event_graveyard_exile_program ::= "exile" "this" "card" "from" "your" "graveyard"

/* Chosen-type spell subjects keep their timing and effect as independent operands. */
/* @sem Operation::EffectOn{subject:$next_chosen_spell_subject, effects:[$next_spell_cast_permission]} */
next_chosen_spell_effect ::= next_chosen_spell_subject next_spell_cast_permission

next_chosen_spell_subject ::= next_chosen_spell_this_turn | next_chosen_spell_pending

/* @sem EffectSubject::NextSpell{spells:$chosen_spell_type, caster:AbilityController, this_turn:true} */
next_chosen_spell_this_turn ::= "the" "next" "spell" chosen_spell_type "you" "cast" "this" "turn"

/* @sem EffectSubject::NextSpell{spells:$chosen_spell_type, caster:AbilityController, this_turn:false} */
next_chosen_spell_pending ::= "the" "next" "spell" chosen_spell_type "you" "cast"

chosen_spell_type ::= modifier_chosen_type | chosen_spell_card_type

/* @sem ObjectFilter::Chosen(CardType) */
chosen_spell_card_type ::= "of" "the" "chosen" "card" "type"

/* @sem Operand::Term{family:SpellEffect, form:MayCastAsThoughItHadFlash} */
next_spell_cast_permission ::= "can" "be" "cast" "as" "though" "it" "had" "flash"

/* The event subject is the spell being redirected; destination remains an operand. */
/* @sem Operation::Retarget{actor:One(AbilityController), object:EventSubject, targets:To($affected)} */
retarget_event_subject_if_able ::= "change" "the" "target" "to" affected "if" "able"

/* @sem Operation::Retarget{actor:One(Active), object:EventSubject, targets:To($affected)} */
retarget_event_subject_active_if_able ::= "the" "active" "player" "changes" "the" "target" "to" affected "if" "able"

spell_event_retarget_action ::= retarget_event_subject_if_able | retarget_event_subject_active_if_able

/* A payment decision is collected for each player before the unpaid players
   receive the independently described damage. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:Bound(0), cost:$unpaid_mana_payment, optional:true}}]}}, Effect{result:@next, operation:$damage_to_unpaid_player}] */
clause_each_player_unless_mana_payment ::= "for" "each" "player" "," damage_to_unpaid_player "unless" "they" "pay" unpaid_mana_payment

/* @sem Operation::DealDamage{source:$object_ref, recipients:Players(Intersection([All, Matching{binding:0, condition:Not(PlayerTook{player:Bound(0), result:@prior})}])), amount:$value, preventable:true} */
damage_to_unpaid_player ::= object_ref "deals" value "damage" "to" "that" "player"

/* Destruction and damage refer independently to the event subject and its controller. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:One(EventSubject), regeneration:true}}, Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(One(ControllerOf(EventSubject))), amount:$number, preventable:true}}] */
shared_event_subject_damage_pair ::= "destroy" "it" "and" "this" "Aura" "deals" number "damage" "to" "that" "land's" "controller"

/* The chosen permanent is the host of the subsequent attachment. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:ControllerOf(EventSubject), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$noun}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Attach{attachments:One(Source), host:Result{result:@prior, phase:After, index:0}}}] */
shared_event_controller_attach_choice ::= "that" "player" "attaches" "this" "Aura" "to" "a" noun "of" "their" "choice"

/* Target each opponent's matching permanents, then retain the phased-out receipt
   for both the prohibition and its delayed return. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:SetTapped{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:OpponentsOf(AbilityController), each:UpTo($number)}, filter:$adjective_nontype}))}}, Effect{result:@next, operation:KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::PhaseOut{}, objects:Targets(0)}}, Effect{result:@next, operation:GameEffect{until:WhileMatches{object:Source, filter:Not(State(FaceDown))}, effect:Term{family:GameEffect, form:PermanentsCantPhaseIn, operands:[Objects(Affected(@prior))]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Player{event:Planeswalks, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::PhaseIn, objects:Affected(@back(4))}}]}}}]} */
opponent_targets_phasing_program ::= "for" "each" "opponent" "," "choose" "up" "to" number "target" adjective_nontype "permanent" "that" "opponent" "controls" "." "untap" "those" "permanents" "." "they" "phase" "out" "." "they" "can't" "phase" "in" "for" "as" "long" "as" SELF_NAME "remains" "face" "up" "." "when" "a" "player" "planeswalks" "," "those" "permanents" "phase" "in" "."

mill_third_amount ::= card_count | mill_cast_event_amount | mill_referenced_spell_mana_amount

/* The chosen permanent is the source of the created combat trigger. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreateTrigger{event:Damage{source_kind:Permanent, sources:SameObject(Result{result:@prior, phase:After, index:0}), recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source}, duration:$this_duration, announcement:@announcement, body:$program}}]} */
chosen_creature_combat_program ::= "choose" "a" "creature" "." "whenever" "that" "creature" "deals" "combat" "damage" "to" "a" "player" this_duration "," program

/* A resolution payment gates its independently composed continuation. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$cost, optional:true}}, If{condition:PaymentChosen(@marked), then:$chosen_creature_combat_program, otherwise:Program{}}]} */
optional_payment_chosen_combat ::= "you" "may" cost "." "if" "you" "do" "," chosen_creature_combat_program

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$optional_payment_chosen_combat} */
triggered_optional_payment_chosen_combat ::= "at" turn_event "," optional_payment_chosen_combat "."

/* A single attempted sacrifice establishes the success test for the whole
   conditional continuation. The optional repetition remains in that branch. */
/* @sem Instruction::[Repeatable{instructions:[Effect{result:@mark, operation:$sacrifice_one}, If{condition:ObjectMatches{object:Result{result:@marked, phase:Before, index:0}, filter:Any}, then:Program{instructions:[...$repeat_sacrifice_success_body, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}}]}, otherwise:Program{}}]}] */
instructions_repeat_single_sacrifice_success ::= sacrifice_one "." "if" "you" "do" "," repeat_sacrifice_success_body "." "you" "may" "repeat" "this" "process" "any" "number" "of" "times"

repeat_sacrifice_success_body ::= clause_player_unless_that_player_sacrifice_or_discard

/* The two player loops share the optional sacrifice's receipt; this phrase is
   used only in a scope that establishes the earlier sacrificed permanent. */
/* @sem Program::Program{instructions:[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@mark, operation:@sacrificed_result(Operation::Sacrifice{players:One(Bound(0)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:Shares{property:CardTypes, with:Earlier{what:Sacrificed}}}, choose:AsManyAsCan($card_count)})}]}}]}}, ForEachPlayer{players:Intersection([$players_singular_2, Matching{binding:0, condition:Not(PlayerTook{player:Bound(0), result:@marked})}]), binding:0, body:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(Bound(0)), amount:$value}}, Effect{result:@next, operation:$operation}]}}]} */
shared_sacrifice_declined_program ::= players_singular "may" "sacrifice" "a" "permanent" "of" "their" "choice" "that" "shares" card_count "type" "with" "it" "." "for" players_singular "who" "doesn't" "," "that" "player" "loses" value "life" "and" operation

/* A singular choice binds the following pronoun to its selected exile arrival. */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:$exile_linked_population, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]} */
choose_linked_single_random ::= "choose" "a" "card" "at" "random" exile_linked_population

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}} */
chosen_random_battlefield_tapped ::= "onto" "the" "battlefield" "tapped"

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
chosen_random_battlefield ::= "onto" "the" "battlefield"

chosen_random_destination ::= chosen_random_battlefield_tapped | chosen_random_battlefield

/* @sem Instruction::[Effect{result:@next, operation:$choose_linked_single_random}, Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@prior, phase:After, index:0}), zone:Exile}, destination:$chosen_random_destination, qualifiers:[]}}] */
instructions_choose_linked_random_put ::= choose_linked_single_random "and" "put" "it" chosen_random_destination

/* The previously named player chooses the permanent; its owner receives it. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:@that_player, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan($counter_amount)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
event_player_return_choice ::= "they" "return" counter_amount filter_phrase "to" "its" "owner's" "hand"

/* The selection and its move are grouped; the die result refers to the marked roll. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, DieResultAt{result:@marked, index:0}]], states:[]}}, qualifiers:[]}}] */
return_graveyard_card_chosen_die_counters ::= "return" "a" filter_phrase "card" "from" "your" "graveyard" "to" "the" "battlefield" "with" "a" "number" "of" counter_kind "counters" "on" "it" "equal" "to" "that" "result"

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RollTwoInOrder{sides:10}} */
roll_two_chosen_d10 ::= "roll" "two" "d10" "and" "choose" "one" "result"

/* Both life changes use the other result from the same ordered roll. */
/* @sem Instruction::[Effect{result:@next, operation:LoseLife{players:OpponentsOf(AbilityController), amount:DieResultAt{result:@marked, index:1}}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:DieResultAt{result:@marked, index:1}}}] */
other_die_opponents_lose_you_gain ::= "each" "opponent" "loses" "X" "life" "and" "you" "gain" "X" "life" "," "where" "X" "is" "the" "other" "result"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:$roll_two_chosen}, ...$return_graveyard_card_chosen_die_counters, ...$other_die_opponents_lose_you_gain]}} */
spell_roll_return_counter_life ::= roll_two_chosen "." return_graveyard_card_chosen_die_counters "." "then" other_die_opponents_lose_you_gain "."

/* In a mana-value cast trigger, "that much" measures the triggering spell. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref_holder, recipients:$recipients, amount:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}, preventable:true}}, Effect{result:@next, operation:$put_counters_direct}]} */
cast_mana_value_damage_then_program ::= self_ref_holder "deals" "that" "much" "damage" "to" recipients "." "then" put_counters_direct "."

/* Used only within the matching singleton reveal casting cost. */
/* @sem Operation::Move{objects:$casting_revealed_compared_population, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
casting_revealed_exile ::= "exile" casting_revealed_compared_population

/* The complete span proves both the exiled card and the created token links. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Move{objects:$hidden_library_top_card, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:One(Result{result:@marked, phase:After, index:0}), audience:AffectedPlayer})], duration:WhileExiled(Result{result:@marked, phase:After, index:0}), evaluation:LiveObjects}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Object{event:LeavesBattlefield, objects:InSet(Created(@prior))}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}}]} */
hidden_exile_token_return_sentence ::= "exile" hidden_library_top_card "face" "down" "and" "look" "at" "it" "." "create" "a" token_recipe "." "when" "that" "token" "leaves" "the" "battlefield" "," "put" "the" "exiled" "card" "into" "your" "hand" "."

/* The event subject's controller chooses a mana payment before the consequence. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:ControllerOf(EventSubject), cost:Cost{parts:[Mana($mana_symbols)]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:$operation}]}, otherwise:Program{}}]} */
shared_event_controller_unless_mana ::= operation "unless" "that" "creature's" "controller" "pays" mana_symbols

/* The count refers to the immediately preceding discard, in the same instruction sequence. */
/* @sem Instruction::[Effect{result:@mark, operation:Discard{players:$players_singular, amount:$card_count, random:false}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountDistinct{objects:Transition{result:@marked, phase:After}, property:$discarded_distinct_property}}}] */
instructions_discard_distinct_draw ::= players_singular "discards" card_count "." "then" "you" "draw" "a" "card" "for" "each" discarded_distinct_property "among" "cards" "discarded" "this" "way"

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$instructions_discard_distinct_draw}} */
triggered_discard_distinct_draw ::= event_clause "," instructions_discard_distinct_draw "."

/* A one-card draw per opponent makes successful draws equal successful opponents.
   Keep the producer in this sequence so the receipt cannot name another action. */
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:OpponentsOf(AbilityController), amount:Constant(1)}}, Effect{result:@next, operation:Draw{players:$draw_receipt_recipient, amount:Performed(@prior)}}] */
instructions_opponent_single_draw_receipt ::= "each" "opponent" "draws" "a" "card" "," "then" draw_receipt_recipient "a" "card" "for" "each" "opponent" "who" "drew" "a" "card" "this" "way"

/* The card-count wording also supports arbitrary requested draw amounts. */
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:$players_singular, amount:$card_count}}, Effect{result:@next, operation:Draw{players:$draw_receipt_recipient, amount:Performed(@prior)}}] */
instructions_draw_receipt_card_count ::= players_singular "draws" card_count "," "then" draw_receipt_recipient "a" "card" "for" "each" "card" "drawn" "this" "way"

draw_receipt_recipient ::= draw_receipt_you | draw_receipt_third

/* @sem PlayerSet::One(AbilityController) */
draw_receipt_you ::= "you" "draw"

/* @sem PlayerSet::One($player_ref) */
draw_receipt_third ::= player_ref "draws"

/* A linked exile pool retains both the card filter and the linking object. */
/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_phrase, ExiledWith($object_ref)])} */
private_entry_pool_linked_exile ::= filter_phrase "card" "exiled" "with" object_ref "onto" "the" "battlefield" "under" "your" "control"

/* The conditional animation refers to the same target that receives counters. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ControlledBy(One(AbilityController))])}), index:0})), kind:$counter_kind, amount:$count_plural}]}}, If{condition:ObjectMatches{object:Target{slot:@last_slot, index:0}, filter:Not($noun_2)}, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@last_slot, index:0})), changes:$conditional_artifact_animation_changes, duration:Indefinite, evaluation:Snapshot}}]}, otherwise:Program{}}]} */
program_counters_controlled_target_conditional_animation ::= "put" count_plural counter_kind "counters" "on" "target" noun "you" "control" "." "if" "it's" "not" "a" noun "," "it" "becomes" "a" conditional_artifact_animation_changes "."

/* The condition's legal population is also the choice population.  The other
   opponent is excluded by the controller of the original sole target. */
/* @sem Ability::Triggered{event:$event_cast_single_opponent_permanent, intervening_if:ExistsPlayer{players:Intersection([OthersThan(ControllerOf(SoleTargetOf(EventSubject))), OpponentsOf(AbilityController)]), binding:0, condition:Controls{player:Bound(0), filter:@and($filter_plural, ObjectFilter::TargetableBy(EventSubject)), minimum:1}}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::TargetableBy(EventSubject), ObjectFilter::ControlledBy(Intersection([OthersThan(ControllerOf(SoleTargetOf(EventSubject))), OpponentsOf(AbilityController)])))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:To(One(Result{result:@prior, phase:After, index:0}))}}]}} */
triggered_copy_to_other_opponents_permanent ::= "whenever" event_cast_single_opponent_permanent "," "if" "another" "opponent" "controls" "one" "or" "more" filter_plural "that" "spell" "could" "target" "," "choose" "one" "of" "those" "permanents" "." "copy" "that" "spell" "." "the" "copy" "targets" "the" "chosen" "permanent" "."

/* The target draws as the action offered by the controller; the subsequent
   program runs only if that offer was chosen. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0}, body:_{instructions:[Effect{result:@next, operation:Draw{players:One(Target{slot:0, index:0}), amount:$card_count}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:$event_spell_followup, otherwise:_{}}]} */
optional_opponent_draw_followup ::= "you" "may" "have" "target" "opponent" "draw" card_count "." "if" "you" "do" "," event_spell_followup

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:May}}]} */
event_spell_followup ::= "copy" "that" "spell" "." "you" "may" "choose" "new" "targets" "for" "the" "copy" "."

/* The two population mentions must agree; the cast event supplies the spell. */
/* @sem Instruction::[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:Each(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), @agree($filter_phrase, $filter_plural), ControlledBy(One(AbilityController))])})}}] */
clause_copy_spell_each_other_controlled ::= "copy" "that" "spell" "for" "each" "other" filter_phrase "you" "control" "that" "the" "spell" "could" "target" "." "each" "copy" "targets" "a" "different" "one" "of" "those" filter_plural

/* The chosen opponent and the following control change share the same choice. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_opponent_of_yours}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[SetController(Chosen)], duration:Indefinite, evaluation:Snapshot}}] */
chosen_opponent_control_sentence ::= choose_opponent_of_yours "." "that" "player" "gains" "control" "of" affected

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Player, terms:_{count:Exactly(Constant(1)), options:[Players(OpponentsOf(AbilityController))]}} */
choose_opponent_of_yours ::= "choose" "one" "of" "your" "opponents"

/* The repeated description must name the same sole target population. */
/* @sem Ability::Triggered{event:Spell{event:Cast, players:One(AbilityController), spells:AllOf([$single_controlled_target_cast_intro, TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($controlled_target_kind_pair, $controlled_target_kind_pair_2), ControlledBy(One(AbilityController))])}))])}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:Copy{object:SoleTargetOf(EventSubject), exceptions:[$copy_not_legendary]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}} */
triggered_single_controlled_target_copy ::= "whenever" single_controlled_target_cast_intro controlled_target_kind_pair "you" "control" "," "create" token_copy_single "that" controlled_target_kind_pair "," "except" copy_not_legendary "."

/* A fresh activation frame makes the two fighter slots local to this ability.
   The opponent both chooses and controls the second target. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:$instructions_tap_opponent_choice_fighters}} */
activated_tap_opponent_choice_fighters ::= cost ":" instructions_tap_opponent_choice_fighters "."

/* The two independently announced fighters are tapped together before fighting. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$arena_fighter_kind, ControlledBy(One(AbilityController))])}), index:0}), SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$arena_fighter_kind_2, ControlledBy(One(OneOf(OpponentsOf(AbilityController))))]), chooser:OneOf(OpponentsOf(AbilityController))}), index:0})])}, tapped:true}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:Target{slot:0, index:0}, second:Target{slot:1, index:0}}}}] */
instructions_tap_opponent_choice_fighters ::= "tap" "target" arena_fighter_kind "you" "control" "and" "target" arena_fighter_kind "of" "an" "opponent's" "choice" "they" "control" "." "those" "creatures" "fight" "each" "other"

arena_fighter_kind ::= arena_fighter_plain | arena_fighter_colored

/* @sem ObjectFilter::CardType(Creature) */
arena_fighter_plain ::= "creature"

/* @sem ObjectFilter::AllOf([$adjective_color, CardType(Creature)]) */
arena_fighter_colored ::= adjective_color "creature"

/* A named source deals damage to a single player-or-planeswalker target. */
/* @sem Operation::DealDamage{source:Source, recipients:$recipients_player_or_walker_required, amount:$number, preventable:false} */
named_unpreventable_player_walker_damage ::= SELF_NAME "deals" number "damage" "to" recipients_player_or_walker_required "." "the" "damage" "can't" "be" "prevented"

/* The replacement follows the player or controller of the announced target. */
/* @sem Operation::CreateReplacement{event:Player{event:GainLife, players:One(PlayerOrControllerOf(Targets(@last_slot)))}, limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}]}} */
replace_target_player_or_walker_life ::= "if" "that" "player" "or" "that" "planeswalker's" "controller" "would" "gain" "life" this_duration "," "that" "player" "gains" "no" "life" "instead"

/* Keep the anaphor in the scope of its matching target announcement. */
/* @sem Instruction::[Effect{result:@next, operation:$named_unpreventable_player_walker_damage}, Effect{result:@next, operation:$replace_target_player_or_walker_life}] */
instructions_unpreventable_damage_life_replacement ::= named_unpreventable_player_walker_damage "." replace_target_player_or_walker_life

/* The bound player returns their own cards and controls their arrivals. */
/* @sem Operation::Move{objects:$bound_graveyard_arrivals, destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
bound_return_fronted_graveyard_arrivals ::= "returns" "to" "the" "battlefield" bound_graveyard_arrivals

/* The two damage instructions use the very same tap receipt. Agreement ties
   all three population names to the producer and both target references. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(Tapped), @agree(@agree($creature_subtype, $creature_subtype_2), $subtype_plural), ControlledBy(One(AbilityController))])}, tapped:true}}, Effect{result:@next, operation:DealDamageFromEach{sources:Transition{result:@prior, phase:Before}, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@agree($noun, $noun_2)}), index:0})), amount:ObjectProperty{object:Affected, property:$stat, information:CurrentOrLastKnown}}}, Effect{result:@next, operation:DealDamageWith{source:Target{slot:@last_slot, index:0}, recipients:Objects(Transition{result:@back(3), phase:Before}), amount:ObjectProperty{object:Target{slot:@last_slot, index:0}, property:$stat_2, information:CurrentOrLastKnown}, rider:DividedBy(ControllerOf(Target{slot:@last_slot, index:0}))}}]} */
program_tap_population_divided_damage ::= "tap" "all" "untapped" creature_subtype "creatures" "you" "control" "." "each" creature_subtype "tapped" "this" "way" "deals" "damage" "equal" "to" "its" stat "to" "target" noun "." "that" noun "deals" "damage" "equal" "to" "its" stat "divided" "as" "its" "controller" "chooses" "among" "any" "number" "of" "those" subtype_plural "."

/* The target set and destination remain operands of the movement. */
/* @sem Operation::Move{objects:$single_graveyard_target_cards, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
put_single_graveyard_targets ::= "put" single_graveyard_target_cards "onto" "the" "battlefield" "under" "your" "control"

/* The counted receipt is the immediately preceding selection's return to its
   owners' hands. Both mentions of the returned kind must agree. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($returned_basic_plural, $returned_basic_kind), ControlledBy(One(AbilityController))])}, count:AnyNumber, constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural_tail, ControlledBy(One(AbilityController))])}), changes:[Pump{power:CountObjects(Transition{result:@prior, phase:Before}), toughness:CountObjects(Transition{result:@prior, phase:Before})}], duration:$duration, evaluation:Snapshot}}] */
return_controlled_kind_counted_pump ::= "return" "any" "number" "of" returned_basic_plural "you" "control" "to" "their" "owner's" "hand" "." filter_plural_tail "you" "control" "get" "+" "1" "/" "+" "1" duration "for" "each" returned_basic_kind "returned" "this" "way"

returned_basic_kind ::= st_plains | st_island | st_swamp | st_mountain | st_forest

returned_basic_plural ::= st_plains | returned_islands | returned_swamps | returned_mountains | returned_forests

/* @sem ObjectFilter::Subtype(Island) */
returned_islands ::= "Islands"

/* @sem ObjectFilter::Subtype(Swamp) */
returned_swamps ::= "Swamps"

/* @sem ObjectFilter::Subtype(Mountain) */
returned_mountains ::= "Mountains"

/* @sem ObjectFilter::Subtype(Forest) */
returned_forests ::= "Forests"

/* @prefer always */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$return_controlled_kind_counted_pump}} */
spell_return_controlled_kind_counted_pump ::= return_controlled_kind_counted_pump "."

/* A choice from the controller's graveyard is independent of earlier movements. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, count:AsManyAsCan($counter_a)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
chosen_graveyard_card_library_top ::= "put" counter_a filter_phrase "card" "from" "your" "graveyard" "on" "top" "of" "your" "library"

/* An activated ability can sequence any operation before the optional choice. */
/* @prefer always */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$operation}, Optional{decider:AbilityController, body:Program{instructions:$chosen_graveyard_card_library_top}}]}} */
activated_operation_then_graveyard_top ::= cost ":" operation "." "then" "you" "may" chosen_graveyard_card_library_top "."

/* A linked-token population retains the creating object's identity. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Token, CreatedWith(Source)])} */
linked_tokens_created_with_it ::= "all" "tokens" "created" "with" "it"

/* @sem Operation::Move{objects:$linked_tokens_created_with_it, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_linked_tokens ::= "exile" linked_tokens_created_with_it

/* @sem Operation::CreateDelayedTrigger{event:$delayed_move_end_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:$exile_linked_tokens}]}} */
delayed_linked_token_move ::= exile_linked_tokens "at" delayed_move_end_event

/* A delayed upkeep body may sequence an instruction with a characteristic
   change lasting through the turn in which that upkeep occurs. */
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_your_upkeep, start:Immediately, body:Program{instructions:$delayed_scoped_turn_body}}}] */
clause_delayed_scoped_turn ::= "at" delayed_your_upkeep "," delayed_scoped_turn_body

/* @sem Instruction::[...$clause, Effect{result:@next, operation:$delayed_turn_snapshot}] */
delayed_scoped_turn_body ::= clause "." delayed_turn_snapshot

/* The replacement counters the same announced spell regardless of payment;
   its follow-up and the conditional test retain their own operands. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@next_slot, index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}, Effect{result:@next, operation:$operation_imperative}]}, otherwise:Program{instructions:[Effect{result:@next, operation:PayCost{player:ControllerOf($target_stack_spell), cost:$counter_unless_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@next_slot, index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}]}}] */
conditional_counter_payment_followup ::= "counter" target_stack_spell "unless" "its" "controller" "pays" counter_unless_cost "." "if" condition "," "instead" "counter" "that" "spell" "," "then" operation_imperative

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$conditional_counter_payment_followup}} */
spell_conditional_counter_payment_followup ::= conditional_counter_payment_followup "."

/* A quantified attacker population can feed a bound-object action. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, AttackingDefender(PlayersAndPlaneswalkers(One(AbilityController)))])} */
each_attacking_defender_population ::= filter_phrase "attacking" "you" "or" "a" "planeswalker" "you" "control"

bound_blocking_copy ::= bound_blocking_copy_one | bound_blocking_copy_many

/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Bound(0), exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[Blocking(Bound(0))]}} */
bound_blocking_copy_one ::= "create" "a" "token" "that's" "a" "copy" "of" "that" "creature" "and" "that's" "blocking" "that" "creature"

/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$copy_token_plural_amount, words:CreatingEffect, recipe:Copy{object:Bound(0), exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[Blocking(Bound(0))]}} */
bound_blocking_copy_many ::= "create" copy_token_plural_amount "tokens" "that" "are" "copies" "of" "that" "creature" "and" "that" "are" "blocking" "that" "creature"

/* This complete spell establishes the loop's producer and its later cleanup. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[ForEachObject{objects:$each_attacking_defender_population, binding:0, body:Program{instructions:[Effect{result:@mark, operation:$bound_blocking_copy}]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Created(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]}}}]}} */
spell_each_bound_created_cleanup ::= "for" "each" each_attacking_defender_population "," bound_blocking_copy "." "exile" "those" "tokens" "at" "end" "of" "combat" "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(@it)), changes:[SetCardTypes([$vowel_card_type])], duration:Indefinite, evaluation:Snapshot}}]} */
shared_it_becomes_vowel_type ::= "it" "becomes" "an" vowel_card_type "."

/* An independent choice from the controller's graveyard, followed by a move. */
/* @prefer always */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$graveyard_three_card_types}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
optional_graveyard_top ::= "you" "may" "put" "an" graveyard_three_card_types "card" "from" "your" "graveyard" "on" "top" "of" "your" "library"

/* @prefer always */
/* @sem Instruction::$optional_graveyard_top */
then_optional_graveyard_top ::= "then" optional_graveyard_top

/* @prefer always */
/* @sem ObjectFilter::@or($spell_instant, @or($spell_sorcery, $card_word)) */
graveyard_three_card_types ::= spell_instant "," spell_sorcery "," "or" card_word

/* The preceding action and the graveyard choice are independent. */
/* @prefer always */
/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:Program{instructions:[...$clause, ...$optional_graveyard_top]}} */
triggered_action_optional_graveyard_top ::= event_clause "," clause "." "then" optional_graveyard_top "."

/* Each recipient copies a permanent that same player controls. */
/* @sem Operation::CreateTokens{players:One(Bound(0)), tokens:[_{amount:$token_copy_quantity, words:CreatingEffect, recipe:CopyOne{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))])}, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
bound_player_copy_controlled ::= "creates" token_copy_quantity "a" filter_phrase "they" "control"

/* @sem Instruction::[ForEachPlayer{players:$return_walking_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_player_copy_controlled}]}}] */
clause_walked_player_copy ::= return_walking_players bound_player_copy_controlled

/* Keep the exile receipt and its delayed consumer in one scope; the intervening
   investigate is independent of the exile result. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:$objects_targets_plain, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:$exile_return_investigate}, Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_move_end_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:$exile_return_arrival, qualifiers:[]}}]}}}] */
instructions_exile_investigate_delayed_return ::= "exile" objects_targets_plain "," "then" exile_return_investigate "." "return" "the" "exiled" "cards" "to" "the" "battlefield" exile_return_arrival "at" delayed_move_end_event

exile_return_investigate ::= investigate_once | investigate_twice | investigate_number_times

/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}} */
exile_return_owner_arrival ::= "tapped" "under" "their" "owners'" "control"

exile_return_arrival ::= exile_return_owner_arrival | exile_return_owner_untapped_arrival

/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
exile_return_owner_untapped_arrival ::= "under" "their" "owners'" "control"

repeat_operation_followup ::= repeat_coin_loss | repeat_optional_payment | repeat_controller_draw_choice

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$cost, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}] */
repeat_optional_payment ::= "you" "may" cost "." "if" "you" "do" "," "repeat" "this" "process"

/* The unattachment can establish its object as the following pronoun. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Unattach{object:ObjectRef::@remember_object($object_ref)}} */
unattach_antecedent_action ::= "unattach" object_ref

/* Keep the exile producer and its delayed return in the same contract. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$exile_population_return_time, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{}}, qualifiers:[]}}]}}}] */
instructions_exile_population_delayed_return ::= "exile" "all" filter_plural "." exile_population_return_time

/* Both clauses are complete alternative programs; the condition is evaluated at resolution. */
/* @sem Program::Program{instructions:[If{condition:$entry_subject_alternative_cost_paid, then:$program_2, otherwise:$program}]} */
entry_subject_cost_replacement ::= program "." "if" entry_subject_alternative_cost_paid "," "instead" program "."

/* Compose an independent action with the following scheduled instruction. */
/* @sem Instruction::[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:$chosen_player_delayed_branch}] */
instructions_operation_delayed ::= operation "." chosen_player_delayed_branch

/* @sem Operation::CreateDelayedTrigger{event:$chosen_player_next_end_event, start:Immediately, body:$postfix_history_branch} */
chosen_player_delayed_branch ::= "at" chosen_player_next_end_event "," postfix_history_branch

/* @sem Program::Program{instructions:[If{condition:$chosen_player_didnt_attack_you, then:$program, otherwise:$program_2}]} */
postfix_history_branch ::= program "if" chosen_player_didnt_attack_you "." "otherwise" "," program

/* The fallback refers specifically to the immediately preceding exchange action. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:$exchange_failure_body}]}, optional:false}}, If{condition:Not(PaymentChosen(@prior)), then:$exchange_failure_fallback, otherwise:Program{}}]} */
/* @prefer always */
exchange_failure_sentence ::= exchange_failure_body "." "if" "you" "don't" "or" "can't" "make" "an" "exchange" "," exchange_failure_fallback "." "this" "ability" "still" "resolves" "if" "its" "target" "becomes" "illegal" "."

/* An optional target keeps the announcement independently of the source object. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::ExchangeControl{first:$self_explicit_ref, second:$target_up_to_one}} */
/* @prefer always */
exchange_failure_action ::= "exchange" "control" "of" self_explicit_ref "and" target_up_to_one

/* Keep the exchange action in its own payment scope. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$exchange_failure_action}]} */
exchange_failure_body ::= exchange_failure_action

/* A sacrifice can supply the failure branch of a larger instruction. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:One($self_explicit_ref)}}]} */
/* @prefer always */
exchange_failure_fallback ::= "sacrifice" self_explicit_ref

/* Return a written population with independently specified counter kinds. */
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)], [$counter_kind_2, Constant(1)]], states:[]}}, qualifiers:[]} */
owner_pair_counters_return ::= "return" affected "to" "the" "battlefield" "under" "its" "owner's" "control" "with" "a" counter_kind "counter" "and" "a" counter_kind "counter" "on" "it"

/* The delayed event wraps a return without changing its operands. */
/* @sem Operation::CreateDelayedTrigger{event:$delayed_move_end_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:$owner_pair_counters_return}]}} */
delayed_owner_pair_counters ::= "at" delayed_move_end_event "," owner_pair_counters_return

/* The optional creation payment and its participation receipt share a result. */
/* @sem Instruction::[$player_land_token_receipt_loop, $player_draw_receipt_prohibition] */
player_land_token_receipt_sequence ::= player_land_token_receipt_loop player_draw_receipt_prohibition

/* @sem Instruction::ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:Bound(0), cost:Cost{parts:[PlayerAction{player:Bound(0), body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(Bound(0)), tokens:[$tapped_named_land_phrase], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}}]}}]}, optional:true}}]}} */
player_land_token_receipt_loop ::= players_singular "may" "create" tapped_named_land_phrase

tapped_named_land_phrase ::= tapped_named_land_spec | tapped_named_lands_spec

/* The repeated noun names the same returned population. The receipt belongs to
   this choice and return to owners' hands, not an arbitrary prior movement. */
/* @sem ObjectFilter::$subtype */
returned_subtype_receipt ::= subtype "returned" "this" "way"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($returned_controlled_subtypes, $returned_subtype_receipt), ControlledBy(One(AbilityController))])}, count:AnyNumber}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Discard{players:$players_singular, amount:CountObjects(Transition{result:@prior, phase:Before})}}] */
instructions_returned_subtype_discard ::= returned_controlled_subtypes "." players_singular "discards" "a" "card" "for" "each" returned_subtype_receipt

/* The selected controlled permanents and the counted return receipt stay in
   the same phrase; the repeated noun must describe that same population. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($plural, $returned_count_noun), ControlledBy(One(AbilityController))])}, count:AnyNumber}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:@times($signed, Expr::CountObjects(Transition{result:@prior, phase:Before})), toughness:@times($signed_2, Expr::CountObjects(Transition{result:@prior, phase:Before}))}], duration:$duration, evaluation:Snapshot}}] */
instructions_return_selected_counted_pump ::= "return" "any" "number" "of" plural "you" "control" "to" "their" "owner's" "hand" "." affected "gets" signed "/" signed duration "for" "each" returned_count_noun "returned" "this" "way"

returned_count_noun ::= noun | subtype

/* @sem Change::[GrantAbility($mechanic_cost_keyword)] */
perpetual_gains_costed ::= "gains" mechanic_cost_keyword

/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), count:AsManyAsCan(Constant(1))} */
hand_choice_filter_phrase ::= "choose" "a" filter_phrase "card" "in" "your" "hand"

/* The choice supplies the exact card modified by the following costed mechanic. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$hand_choice_filter_phrase}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$perpetual_gains_costed}}] */
instructions_hand_choice_costed_perpetual ::= hand_choice_filter_phrase "." "that" "card" "perpetually" perpetual_gains_costed

/* A single optional battlefield target returned to its owner supplies this immediate receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:$optional_battlefield_target, destination:OwnersHand(CardArrival{}), qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:Before, index:0}, filter:$filter_phrase}, then:$program, otherwise:Program{}}] */
instructions_return_optional_filtered_receipt ::= "return" optional_battlefield_target "to" "its" "owner's" "hand" "." "if" "a" filter_phrase "was" "returned" "this" "way" "," program

singular_conjure_duplicate ::= conjure_other_graveyard_duplicate | conjure_one_duplicate_graveyard

/* The singular duplicate and its owner are explicit operands of this conjure. */
/* @sem Operation::Conjure{actor:One(AbilityController), card:Duplicate($affected), count:Constant(1), owner:AbilityController, destination:Graveyard(CardArrival{counters:[], states:[]})} */
conjure_one_duplicate_graveyard ::= "conjure" "a" "duplicate" "of" affected "into" "your" "graveyard"

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}, GrantKeyword($keyword_name)] */
/* @prefer always */
duplicate_perpetual_pump_keyword ::= "gets" signed "/" signed "and" "gains" keyword_name

/* @sem Change::[GrantAbility($keyword_unearth)] */
duplicate_perpetual_mechanic ::= "gains" keyword_unearth

/* Scope the destroyed receipt to the immediately preceding destruction. */
/* @sem ObjectFilter::AllOf([$filter_phrase, ControlledBy(One(AbilityController))]) */
destroyed_controlled_filter ::= "a" filter_phrase "you" "controlled"

/* @sem Instruction::[Effect{result:@mark, operation:Destroy{objects:$each_player_optional_targets, regeneration:true}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$destroyed_controlled_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$clause}, otherwise:Program{}}] */
instructions_each_player_destroy_controlled ::= "for" "each" "player" "," "destroy" each_player_optional_targets "." NEWLINE? "if" destroyed_controlled_filter "was" "destroyed" "this" "way" "," clause

/* The damage result and chosen hand card are distinct, locally bound receipts. */
/* @sem Instruction::[Effect{result:@mark, operation:$excess_damage_producer}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:[Pump{power:ExcessDamage{result:@marked, to:Any}, toughness:ExcessDamage{result:@marked, to:Any}}]}}] */
instructions_damage_hand_perpetual_excess ::= excess_damage_producer "." "choose" "a" filter_phrase "card" "in" "your" "hand" "." "it" "perpetually" "gets" "+" "X" "/" "+" "X" "," "where" "X" "is" "the" "amount" "of" "excess" "damage" "dealt" "this" "way"

/* Keep the mill and all its receipt tests together so every test names the same producer. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$mill_matching_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$clause}, otherwise:Program{}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$mill_matching_filter_2}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$clause_2}, otherwise:Program{}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$mill_matching_filter_3}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$clause_3}, otherwise:Program{}}] */
instructions_mill_three_matching ::= "mill" card_count "." "if" mill_matching_filter "," clause "." "if" mill_matching_filter "," clause "." "if" mill_matching_filter "," clause

mill_matching_filter ::= mill_matching_single | mill_matching_two_negative

/* @sem ObjectFilter::$filter_phrase */
mill_matching_single ::= "a" filter_phrase "card" "is" "milled" "this" "way"

/* @sem ObjectFilter::AllOf([$adjective_nontype, $adjective_nontype_2]) */
mill_matching_two_negative ::= "a" adjective_nontype "," adjective_nontype "card" "is" "milled" "this" "way"

/* Both changes apply to the card selected by the enclosing optional choice. */
/* @sem Change::[Incorporate($mana_symbols), Pump{power:$signed, toughness:$signed_2}] */
incorporate_pump ::= "incorporates" mana_symbols "and" "gets" signed "/" signed

/* The other participant of a crew event is the Vehicle, not the crew member. */
/* @sem ObjectSet::One(EventOther) */
crewed_vehicle_perpetual_subject ::= "that" "Vehicle"

/* Perpetual type additions compose with an independently resolved subject. */
/* @sem Change::[AddCardType(Artifact), AddCardType(Creature)] */
perpetual_becomes_artifact_creature ::= "becomes" "an" "artifact" "creature"

/* The choice records the eligible battlefield population for later references. */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan(Constant(1)), constraints:[]} */
choose_controlled_permanent ::= "choose" "a" filter_phrase

perpetual_selected_changes ::= perpetual_becomes_artifact_creature | perpetual_changes

/* The singleton choice and its modification share the same receipt. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_controlled_permanent}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$perpetual_selected_changes}}] */
instructions_selected_perpetual ::= choose_controlled_permanent "." "it" "perpetually" perpetual_selected_changes

/* A repeat decision belongs to its named deciding player, independently of
   the life recipients in the surrounding process. */
/* @sem Instruction::Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}} */
coin_repeat_decision_you ::= "you" "decide" "whether" "to" "flip" "again"

/* @sem Instruction::Optional{decider:$player_ref, body:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}} */
coin_repeat_decision_player ::= player_ref "decides" "whether" "to" "flip" "again"

/* @sem Condition::CoinFlip{result:@marked, outcome:Won} */
coin_repeat_won_condition ::= "if" "you" "win" "the" "flip"

/* All four printed life amounts initialize the same stake. The subsequent
   branch effects consume that stake, which is doubled before either decision. */
/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::SetStake{amount:@agree(@agree($value, $value_2), @agree($value_3, $value_4))}}}, Repeatable{instructions:[Effect{result:@mark, operation:$flip_a_coin}, If{condition:$coin_repeat_won_condition, then:Program{instructions:[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:Game(Stake)}}, Effect{result:@next, operation:LoseLife{players:$players_singular, amount:Game(Stake)}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::DoubleStake}}, $coin_repeat_decision_you]}, otherwise:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:Game(Stake)}}, Effect{result:@next, operation:GainLife{players:$players_singular_2, amount:Game(Stake)}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::DoubleStake}}, $coin_repeat_decision_player]}}]}] */
coin_life_stakes_process ::= flip_a_coin "." coin_repeat_won_condition "," "you" "gain" value "life" "and" players_singular "loses" value "life" "," "and" coin_repeat_decision_you "." "if" "you" "lose" "the" "flip" "," "you" "lose" value "life" "and" players_singular "gains" value "life" "," "and" coin_repeat_decision_player "." "double" "the" "life" "stakes" "with" "each" "flip"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$coin_life_stakes_process}} */
spell_coin_life_stakes ::= coin_life_stakes_process "."

/* The unblocking consequence describes removal of this same creature; the intervening clause remains independently compositional. */
/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::RemoveFromCombatUnblocking{object:@remember_object(ObjectRef::@self)}}}, ...$clause] */
combat_self_removal_with_followup ::= "remove" "this" "creature" "from" "combat" "and" clause "." "creatures" "it" "was" "blocking" "that" "had" "become" "blocked" "by" "only" "this" "creature" "this" "combat" "become" "unblocked"

/* A population phrase whose pronoun refers to the preceding player. */
/* @sem $filter_plural */
controlled_plural_they_control ::= "all" filter_plural "they" "control"

/* @sem Operation::SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$controlled_plural_they_control, ControlledBy($player_one)])}} */
player_untaps_controlled_plural ::= player_one "untaps" controlled_plural_they_control

/* @sem Operation::SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$controlled_plural_they_control, ControlledBy($player_one)])}, tapped:true} */
player_taps_controlled_plural ::= player_one "taps" controlled_plural_they_control

/* Per-opponent target selection is shared by distinct operations. */
/* @sem Operation::SetTapped{objects:$each_opponents_named_targets, tapped:true} */
tap_each_opponents_targets ::= "for" "each" "opponent" "," "tap" each_opponents_named_targets

/* @sem Operation::Move{objects:$each_opponents_named_targets, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_each_opponents_targets_shared ::= "for" "each" "opponent" "," "exile" each_opponents_named_targets

/* Two independent executions retain their own result identities. The captured
   action must be the same in both positions when printing. */
/* @sem Instruction::[Effect{result:@next, operation:$repeatable_keyword_action}, Effect{result:@next, operation:$repeatable_keyword_action}] */
instructions_repeat_keyword_twice ::= repeatable_keyword_action "twice"

repeatable_keyword_action ::= manifest_dread | learn_action | heist_target_opponent_library

/* The copy refers to the selected object in this optional choice, not an
   unrelated earlier result. The choice and the continuation share its receipt. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Token, ControlledBy(One(AbilityController))])}, count:AsManyAsCan(Constant(1))}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($other_controlled_chosen_population), changes:[CopyOf{object:Result{result:@prior, phase:After, index:0}, exceptions:[]}], duration:Indefinite, evaluation:Snapshot}}]}, otherwise:Program{}}] */
instructions_optional_choice_copy_others ::= "you" "may" "choose" "a" "token" "you" "control" "." "if" "you" "do" "," other_controlled_chosen_population "becomes" "a" "copy" "of" "that" "token"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Result{result:@prior, phase:After, index:0})), $filter_phrase, ControlledBy(One(AbilityController))])} */
other_controlled_chosen_population ::= "each" "other" filter_phrase "you" "control"

/* A choice over a battlefield population retains its selection receipt. */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, count:AnyNumber, constraints:[$return_different_property]} */
choose_distinct_property_population ::= "choose" "any" "number" "of" filter_plural "with" "different" return_different_property

owners_shuffle_population ::= object_and_each_population | objects_self_and_target | objects_target_and_all | objects_target_and_each_other

owners_shuffle_followup ::= owners_shuffle_short | owners_shuffle_explicit

/* @prefer always */
/* @sem () */
owners_shuffle_short ::= "on" "top" "of" "their" "owners'" "libraries" "," "then" "those" "players" "shuffle"

/* @sem () */
owners_shuffle_explicit ::= "on" "top" "of" "their" "owners'" "libraries" "," "then" "those" "players" "shuffle" "their" "libraries"

/* The event subject remains the recipient of the separate temporary grant. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(EventSubject)), changes:[GrantKeyword($keyword_value)], duration:$duration, evaluation:Snapshot} */
event_subject_he_gains_keyword ::= "he" "gains" keyword_value duration

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$put_event_subject_him_counters}, Effect{result:@next, operation:$event_subject_he_gains_keyword}]} */
event_subject_him_counters_then_grant ::= put_event_subject_him_counters "." event_subject_he_gains_keyword

/* The target declaration is shared by the untap and its animation. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:SetTapped{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:$target_up_to, filter:CardType(Land)})), tapped:false}}, Effect{result:@next, operation:$target_lands_retained_animation}]} */
program_untap_lands_retained_animation ::= "untap" target_up_to "target" "lands" "." target_lands_retained_animation

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[Loyalty($loyalty)]}, limits:ActivationLimits{sorcery:true}, announcement:@announcement, body:$program_untap_lands_retained_animation} */
activated_untap_lands_retained_animation ::= "[" loyalty "]" ":" program_untap_lands_retained_animation "."

/* The selected population, total-property cap, and X definition compose independently. */
/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$other_graveyard_card_filter}), count:AnyNumber, constraints:[TotalProperty{property:$stat, comparison:LessOrEqual, amount:$value}]}], action:Move{objects:Prepared(@selection_id(0)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}} */
return_other_total_graveyard_cards ::= "return" "any" "number" "of" other_graveyard_card_filter "with" "total" stat "X" "or" "less" "from" "your" "graveyard" "to" "the" "battlefield" "," "where" "X" "is" value

/* Keep the single sacrificed creature and its measured payment in one scope. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::EventSubject)), ObjectFilter::AllOf([$noun_creature, ObjectFilter::ControlledBy(One(AbilityController))]))}, choose:Exactly(Constant(1))}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:ObjectProperty{object:Query{objects:CostObjects{payment:Resolution(0), component:[0], view:Inputs, phase:Before}, index:0}, property:$creature_stat, information:CurrentOrLastKnown}, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]}, otherwise:Program{}}]} */
program_optional_other_creature_sacrifice_named_tokens ::= "you" "may" "sacrifice" "another" noun_creature "you" "control" "." "if" "you" "do" "," "create" "a" "number" "of" token_named_recipe "tokens" "equal" "to" "that" "creature's" creature_stat

/* A type quota and a graveyard population compose independently. */
permanent_type_quota ::= permanent_type_domain | all_card_type_domain

/* @sem SelectionConstraint::OneForEachCardType(Permanent) */
permanent_type_domain ::= "for" "each" "permanent" "type" /* @prefer always */

/* @sem SelectionConstraint::OneForEachCardType(All) */
all_card_type_domain ::= "for" "each" "card" "type"

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:ObjectFilter::Any} */
graveyard_card_of_that_type ::= "up" "to" "one" "card" "of" "that" "type" "from" "your" "graveyard" /* @prefer always */

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$graveyard_type_card_kind} */
graveyard_filtered_card_of_that_type ::= "up" "to" "one" graveyard_type_card_kind "card" "of" "that" "type" "from" "your" "graveyard"

graveyard_type_card_kind ::= noun_creature | noun_artifact | noun_enchantment | noun_land | noun_planeswalker | noun_battle

graveyard_type_choice ::= graveyard_card_of_that_type | graveyard_filtered_card_of_that_type

/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:$graveyard_type_choice, count:AnyNumber, constraints:[$permanent_type_quota]}], action:Move{objects:Prepared(@selection_id(0)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}} */
return_each_permanent_type ::= permanent_type_quota "," "return" graveyard_type_choice "to" "the" "battlefield"

/* The receipt belongs to this immediately preceding return to the battlefield. */
/* @sem Instruction::[Effect{result:@mark, operation:$return_each_permanent_type}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:Multiply([$value, CountObjects(Transition{result:@marked, phase:After})])}}] */
returned_type_cards_life ::= return_each_permanent_type "." "you" "lose" value "life" "for" "each" "card" "returned" "this" "way"

/* A combat recipient's condition governs the offered action and its callback. */
/* @sem Ability::Triggered{event:$event_combat_damage_player, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[@resolution($combat_recipient_conditional_callback)]}} */
triggered_combat_recipient_conditional_callback ::= "whenever" event_combat_damage_player "," combat_recipient_conditional_callback "."

/* @sem Instruction::If{condition:$combat_recipient_life_condition, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$resolving_cost}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$combat_recipient_callback})}]}}]}, otherwise:Program{}} */
combat_recipient_conditional_callback ::= "you" "may" "pay" resolving_cost "if" combat_recipient_life_condition "." "when" "you" "do" "," combat_recipient_callback

combat_recipient_callback ::= combat_recipient_loses_game | reflexive_callback_program

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(EventSubject), action:KeywordAction::LoseGame}}]} */
combat_recipient_loses_game ::= "that" "player" "loses" "the" "game"

/* @prefer always */
/* @sem Operation::Move{objects:One($target_card_opponent_graveyard_with), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
put_qualified_opponent_graveyard_card ::= "put" target_card_opponent_graveyard_with "onto" "the" "battlefield" "under" "your" "control"

/* The defending player is determined by the attack event subject. */
/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:InZone(Players{zone:Graveyard, players:One(@defending)})}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_defending_graveyard_card ::= "exile" "target" "card" "from" "defending" "player's" "graveyard"

/* The announced other permanent remains the referent of the linked phasing effects. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(SameObject(Source)), $adjective_nontype])}), index:0})}}] */
untap_another_target_qualified_permanent ::= "untap" "another" "target" adjective_nontype "permanent"

/* This continuation refers to the target introduced by the immediately preceding phrase. */
/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::PhaseOut{object:Target{slot:@last_slot, index:0}}}}, Effect{result:@next, operation:GameEffect{until:WhileMatches{object:Source, filter:Tapped}, effect:Term{family:GameEffect, form:PermanentCantPhaseIn, operands:[Object(Target{slot:@last_slot, index:0})]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:AnyOf([Object{event:BecomesUntapped, objects:SameObject(Source)}, Object{event:LeavesBattlefield, objects:SameObject(Source)}]), start:Immediately, body:_{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::PhaseIn{object:Target{slot:@last_slot, index:0}}}}]}}}] */
target_phases_until_source_untaps ::= "then" "it" "phases" "out" "." "it" "can't" "phase" "in" "for" "as" "long" "as" SELF_NAME "remains" "tapped" "." "when" SELF_NAME "becomes" "untapped" "or" "leaves" "the" "battlefield" "," "that" "permanent" "phases" "in" "."

/* @sem Program::Program{instructions:[...$untap_another_target_qualified_permanent, ...$target_phases_until_source_untaps]} */
program_untap_target_linked_phasing ::= untap_another_target_qualified_permanent "," target_phases_until_source_untaps

/* Both actions refer to the announced land, including if it failed to untap. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:SetTapped{objects:One($controlled_land_target)}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@last_slot, index:0})), changes:$retained_creature_animation_grants, duration:$duration, evaluation:Snapshot}}]}}]} */
program_untap_optional_retained_land ::= "untap" controlled_land_target "." "you" "may" "have" "it" "become" retained_creature_animation_grants duration "." "it's" "still" "a" "land" "."

/* One expression supplies both sequential effects. */
/* @sem Instruction::[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:$card_count_equal}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count_equal}}] */
clause_shared_life_draw_equal ::= "you" "gain" "life" "and" "draw" card_count_equal

/* The postposed comparison gates the entire clause and refers to its object. */
/* @sem Program::Program{instructions:[@resolution(Instruction::If{condition:$condition_target_revealed_property, then:Program{instructions:$clause}, otherwise:Program{}})]} */
program_target_property_revealed ::= clause "if" condition_target_revealed_property

/* The selection and both controller-qualified actions share the same three targets. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([AnyOf([SameObject($target_up_to_one), SameObject($target_up_to_one_2), SameObject($target_up_to_one_3)]), $filter_plural])}}}, Effect{result:@next, operation:SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([AnyOf([SameObject(Target{slot:0, index:0}), SameObject(Target{slot:1, index:0}), SameObject(Target{slot:2, index:0})]), $filter_plural_2])}, tapped:true}}] */
chosen_three_tap_sequence ::= "choose" target_up_to_one "," target_up_to_one "," "and" target_up_to_one "." "untap" "the" "chosen" filter_plural "." "tap" "the" "chosen" filter_plural

/* This entry starts a loyalty ability, so the three announced slots are 0–2. */
/* @sem Program::Program{instructions:$chosen_three_tap_sequence} */
chosen_three_tap_loyalty_sentence ::= chosen_three_tap_sequence "."

/* @sem Program::Program{instructions:[...$chosen_three_tap_sequence, ...$instructions]} */
chosen_three_tap_loyalty_followed ::= chosen_three_tap_sequence "." instructions "."

/* An opponent's named choice contains two independent resolution programs.
   The second program explicitly names the other opponents as its recipients. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseAction{actor:One($target_opponent), options:[Term{family:NamedAction, form:NamedAction, operands:[Text(Self), List([Program($program_choice_damage)])]}, Term{family:NamedAction, form:NamedAction, operands:[Text(Others), List([Program{instructions:[Effect{result:@next, operation:$damage_other_opponents}]}])]}]}}] */
instructions_named_opponent_choice ::= target_opponent "chooses" "self" "or" "others" "." "if" "that" "player" "chooses" "self" "," program_choice_damage "." "if" "the" "player" "chooses" "others" "," damage_other_opponents

/* These branches add no targets, so the last announced slot remains the chooser. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$damage_choice_player}]} */
program_choice_damage ::= damage_choice_player

/* @sem Operation::DealDamage{source:$self_explicit_ref, recipients:Players(One(Target{slot:@last_slot, index:0})), amount:$number, preventable:true} */
damage_choice_player ::= self_explicit_ref "deals" number "damage" "to" "that" "player"

/* @sem Operation::DealDamage{source:$self_explicit_ref, recipients:Players(Intersection([OpponentsOf(AbilityController), OthersThan(Target{slot:@last_slot, index:0})])), amount:$number, preventable:true} */
damage_other_opponents ::= self_explicit_ref "deals" number "damage" "to" "each" "of" "your" "other" "opponents"

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$instructions_named_opponent_choice}} */
triggered_named_opponent_choice ::= event_clause "," instructions_named_opponent_choice "."

/* The discard and its consumer form one receipt contract. */
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:Discard{players:One(AbilityController), amount:Constant(1)}}, If{condition:$condition_one, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Recorded(@prior), count:Exactly(Constant(1)), terms:_{cost:Free}}}]}}]}, otherwise:Program{}}] */
draw_discard_conditional_free_cast ::= "draw" card_count "," "then" "discard" "a" "card" "." "if" condition_one "," "you" "may" "cast" "the" "discarded" "card" "without" "paying" "its" "mana" "cost"

/* @sem Ability::Triggered{event:Damage(_{source_kind:Permanent, sources:$event_self, recipients:Players($combat_damage_player_set), kind:Combat, grouping:SourceRecipient, subject:Source}), limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Source)), kind:$counter_kind, amount:Constant(1)}]}}, ...$draw_discard_conditional_free_cast]}} */
triggered_self_combat_counter_draw_discard ::= "whenever" event_self "deals" "combat" "damage" "to" combat_damage_player_set "," "put" "a" counter_kind "counter" "on" "it" "." draw_discard_conditional_free_cast "."

/* @sem SelectionConstraint::DifferentNames */
return_different_names ::= "names"

/* @prefer always */
/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
return_different_hand ::= "to" "your" "hand"

/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
return_different_battlefield ::= "to" "the" "battlefield"

return_different_destination ::= return_different_hand | return_different_battlefield

/* The card target and battlefield destination retain independent operands. */
/* @sem Operation::Move{objects:$bounded_graveyard_card_target, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
put_bounded_graveyard_card_battlefield ::= "put" bounded_graveyard_card_target "onto" "the" "battlefield" "under" "your" "control"

/* A duration-first grant applies to every matching card, whose own ability supplies the permission. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$card_filter}), changes:[GrantAbility(@holder($graveyard_quoted_play_permission))], duration:$duration, evaluation:Snapshot} */
graveyard_each_card_temporary_grant ::= duration "," "each" card_filter "card" "in" "your" "graveyard" "gains" '"' graveyard_quoted_play_permission "." '"'

/* A chosen creature remains the recipient of a subsequent scoped action. */
/* @sem ObjectRef::$chosen_counter_creature_target */
chosen_counter_target_prefix ::= "choose" chosen_counter_creature_target "."

/* Scope the mill producer and its counted arrival receipt together. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($chosen_counter_target_prefix)), kind:$counter_kind, amount:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase})}]}}] */
instructions_chosen_target_mill_counters ::= chosen_counter_target_prefix "mill" card_count "," "then" "put" "a" counter_kind "counter" "on" "that" "creature" "for" "each" filter_phrase "card" "milled" "this" "way"

/* Both consumers retain the identity of the same ordered roll. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RollTwoInOrder{sides:12}} */
roll_two_chosen_d12 ::= "roll" "two" "d12" "and" "choose" "one" "result"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:$roll_two_chosen}, Effect{result:@next, operation:DealDamage{source:$self_ref_named, recipients:$recipients_each, amount:DieResultAt{result:@marked, index:0}, preventable:true}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:DieResultAt{result:@marked, index:1}, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]}} */
spell_ordered_roll_damage_named_tokens ::= roll_two_chosen "." self_ref_named "deals" "damage" "equal" "to" "that" "result" "to" recipients_each "." "then" "create" "a" "number" "of" token_named_recipe "tokens" "equal" "to" "the" "other" "result" "."

/* Fronted destination with a separately described personal graveyard target. */
/* @sem Operation::Move{objects:One($target_card_combat_history_your_graveyard), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_fronted_graveyard_target ::= "return" "to" "your" "hand" target_card_combat_history_your_graveyard

/* Removing suspected status is a no-op for members without that status. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Unsuspect, objects:$suspected_population} */
unsuspect_suspected_population ::= suspected_population "are" "no" "longer" "suspected"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural} */
suspected_population ::= "all" "suspected" filter_plural

/* Both actions consume the same per-player choice, with the printed plural agreeing with its filter. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($filter_phrase, $filter_plural), ControlledBy(One(Bound(0)))])}, count:AsManyAsCan($counter_amount)}}]}}, Effect{result:@next, operation:SetTapped{objects:Selected(@prior), tapped:true}}, Effect{result:@next, operation:KeywordEach{actor:One(AbilityController), action:$population_keyword_verb, objects:Selected(@back(3))}}] */
clause_each_choice_tap_keyword ::= players_singular "chooses" counter_amount filter_phrase "they" "control" "." "tap" "and" population_keyword_verb "the" "chosen" filter_plural

/* Apply an object keyword action to an attachment population. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:$attachment_keyword_verb, objects:$population_from_object} */
unattach_population ::= attachment_keyword_verb population_from_object

/* @sem ObjectKeywordAction::Unattach */
attachment_keyword_verb ::= "unattach"

/* The random singleton and perpetual effect share the selection receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$random_perpetual_hand_population, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$life_event_perpetual_pump}}] */
random_hand_life_event_perpetual ::= "a" "random" random_perpetual_hand_population "perpetually" life_event_perpetual_pump

/* Only used within the life-gain event and its explicit X definition. */
/* @sem Change::[Pump{power:EventAmount, toughness:EventAmount}] */
life_event_perpetual_pump ::= "gets" "+" "X" "/" "+" "X"

/* The choice population and its move remain separate results. The anaphor
   binds to the player established by the enclosing ability. */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(@that_player)}, kind:Card, filter:$filter_phrase}, count:AsManyAsCan($counter_amount)} */
choice_from_that_player_graveyard ::= counter_amount filter_phrase "card" "from" "that" "player's" "graveyard"

/* @sem Instruction::[Effect{result:@next, operation:$choice_from_that_player_graveyard}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
put_chosen_graveyard_card_battlefield ::= "put" choice_from_that_player_graveyard "onto" "the" "battlefield" "under" "your" "control"

/* A player chooses cards from their own hand and discards that selection. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}, count:UpTo($card_count)}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}]} */
bound_optional_discard_up_to ::= "may" "discard" "up" "to" card_count

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:$bound_optional_discard_up_to}] */
each_optional_discard_up_to ::= players_singular bound_optional_discard_up_to

/* The only use of this receipt consumer is beside its discard producer. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(One(Bound(0))), amount:Subtract([$value, CountObjects(MovedBy{result:@prior, phase:After, player:Bound(0)})]), preventable:true}}]}}] */
discard_receipt_each_player_damage ::= object_ref "deals" "damage" "to" players_singular "equal" "to" value "minus" "the" "number" "of" "cards" "they" "discarded" "this" "way"

/* @sem Instruction::[...$each_optional_discard_up_to, ...$discard_receipt_each_player_damage] */
instructions_each_optional_discard_damage ::= each_optional_discard_up_to "." discard_receipt_each_player_damage

/* Keep the singular exile producer with both references to its arrival. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_top_card_receipt}, Effect{result:@next, operation:LoseLife{players:$players_singular, amount:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$exiled_value_cast_filter}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Result{result:@marked, phase:After, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}]}, otherwise:Program{}}] */
instructions_exiled_card_value_conditional_cast ::= exile_top_card_receipt "." players_singular "loses" "life" "equal" "to" "its" "mana" "value" "." "if" "it's" exiled_value_cast_filter "card" "," "you" "may" "cast" "it" "without" "paying" "its" "mana" "cost"

/* @sem ObjectFilter::$filter_instant_or_sorcery */
exiled_value_cast_instant_sorcery ::= "an" filter_instant_or_sorcery

/* @sem ObjectFilter::CardType(Creature) */
exiled_value_cast_creature ::= "a" "creature"

/* @sem ObjectFilter::AnyOf([CardType(Creature), CardType(Sorcery)]) */
exiled_value_cast_creature_sorcery ::= "a" "creature" "or" "sorcery"

/* @sem ObjectFilter::AnyOf([CardType(Instant), CardType(Artifact)]) */
exiled_value_cast_instant_artifact ::= "an" "instant" "or" "artifact"

exiled_value_cast_filter ::= exiled_value_cast_instant_sorcery | exiled_value_cast_creature | exiled_value_cast_creature_sorcery | exiled_value_cast_instant_artifact

/* The permission refers to the actual arrival of this same exile action. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_explicit_self}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:CastSpell, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}] */
clause_exile_source_cast_receipt ::= exile_explicit_self "and" "you" "may" "cast" "it" this_duration

/* @sem Operation::Move{objects:One($self_explicit_ref), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_explicit_self ::= "exile" self_explicit_ref

/* The return anaphor is confined to a discard event's card group. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:EventGroup, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]} */
discard_group_return_hand ::= "return" "those" "cards" "from" "your" "graveyard" "to" "your" "hand"

discard_trigger_response ::= discard_group_return_hand | program

/* @sem Operation::CreateTrigger{event:$caused_discard_group_event, duration:$this_duration, announcement:@announcement, body:$discard_trigger_response} */
caused_discard_timed_trigger ::= "whenever" caused_discard_group_event this_duration "," discard_trigger_response

/* Bind the free-play permission to the immediately selected exiled card. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$exile_owned_counter_population, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:Either, filter:Any}, terms:_{cost:Free}})], duration:$this_duration, evaluation:LiveObjects}}] */
clause_choose_exiled_play_free ::= "choose" "an" exile_owned_counter_population "." "you" "may" "play" "it" this_duration "without" "paying" "its" "mana" "cost"

/* The token receipt is shared by both departure triggers in this program. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:$explicit_legendary_name, supertypes:[Legendary], colors:$token_colors, subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Object{event:LeavesBattlefield, objects:SameObject($object_ref)}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Created(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Object{event:LeavesBattlefield, objects:InSet(Created(@marked))}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:One($object_ref_2)})}]}}}]} */
program_named_token_mutual_departure ::= "create" explicit_legendary_name "," "a" "legendary" token_stat "/" token_stat token_colors token_subtypes token_types "token" "." "exile" "that" "token" "when" object_ref "leaves" "the" "battlefield" "." "sacrifice" object_ref "when" "that" "token" "leaves" "the" "battlefield"

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$program_named_token_mutual_departure} */
triggered_named_token_mutual_departure ::= event_clause "," program_named_token_mutual_departure "."

/* Keep the library movement and its counter recipient in one producer-consumer scope. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$event_amount_library_end, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Transition{result:@prior, phase:After}), kind:$counter_kind, amount:$counter_amount}]}}] */
instructions_exile_event_library_counter ::= "exile" event_amount_library_end "face" "down" "." "put" counter_amount counter_kind "counter" "on" "each" "of" "them"

/* @sem Program::Program{instructions:[...$instructions_exile_event_library_counter, Effect{result:@next, operation:$operation}]} */
program_exile_event_library_counter_followup ::= instructions_exile_event_library_counter "." operation "."

/* The linked population and each card's owner-zone destination are independent. */
/* @sem Operation::Move{objects:@zone_members($linked_exiled_all), destination:$linked_return_destination, qualifiers:[]} */
put_linked_cards_owner_zone ::= "put" linked_exiled_all "into" linked_return_destination

/* The excluded earlier card and the selected current graveyard card remain distinct. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([$milled_return_filter, Not(InSet(Earlier{what:PutInGraveyard, by:One(AbilityController)}))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
return_another_graveyard_card ::= "return" "another" milled_return_filter "card" "from" "your" "graveyard" "to" "the" "battlefield"

/* The announced land group is shared by placement and the continuing effect.
   The placed counter and the duration counter are independent operands. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:AnyNumber, filter:AllOf([CardType(Land), ControlledBy(One(AbilityController))])}))), kind:$animation_an_counter, amount:Constant(1)}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Targets(@last_slot)), changes:[SetBasePowerToughness{power:$number_digits, toughness:$number_digits_2}, Colors{mode:Set, colors:[$mana_color_word]}, CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Creature)], duration:WhileMatches{object:Affected, filter:Counters(_{kind:$animation_an_counter_2, comparison:Greater, value:Constant(0)})}, evaluation:Snapshot}}]} */
program_target_lands_counter_animation ::= "you" "may" "choose" "any" "number" "of" "target" "lands" "you" "control" "and" "put" "an" animation_an_counter "counter" "on" "each" "of" "them" "." "each" "of" "those" "lands" "is" "an" number_digits "/" number_digits mana_color_word becomes_types "creature" "for" "as" "long" "as" "it" "has" "an" animation_an_counter "counter" "on" "it" "." "they're" "still" "lands"

animation_an_counter ::= cn_awakening | cn_oil | cn_age | cn_acorn

/* The plot effect names the actual arrival of the immediately preceding exile. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_stack_spell), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:EffectOn{subject:Objects(One(Result{result:@prior, phase:After, index:0})), effects:[Term{family:ExiledCardEffect, form:IsPlotted}]}}] */
instructions_exile_target_spell_plot ::= "exile" target_stack_spell "." "it" "becomes" "plotted"

/* A singular linked-card selection can instead move to its owner's graveyard. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$linked_choice_card_pool, count:AsManyAsCan($card_count_one)}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_put_linked_choice_owner_graveyard ::= "put" card_count_one linked_choice_card_pool "into" "its" "owner's" "graveyard"

/* Keep card tests attached to the one linked-card movement that established their result. */
/* @sem Instruction::[...$clause_put_linked_choice_owner_graveyard, ...$linked_moved_card_tests] */
instructions_linked_moved_card_tests ::= clause_put_linked_choice_owner_graveyard "." linked_moved_card_tests

linked_moved_card_tests ::= linked_moved_card_test | linked_moved_card_test_more

/* @sem Instruction::[...$linked_moved_card_test, ...$linked_moved_card_tests] */
linked_moved_card_test_more ::= linked_moved_card_test "." linked_moved_card_tests

linked_moved_card_test ::= linked_moved_card_test_a | linked_moved_card_test_an

/* @sem Instruction::[If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$linked_moved_card_filter}, then:$then_condition_program, otherwise:Program{}}] */
linked_moved_card_test_a ::= "if" "it's" "a" linked_moved_card_filter "card" "," then_condition_program

/* @sem Instruction::[If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$linked_moved_card_filter}, then:$then_condition_program, otherwise:Program{}}] */
linked_moved_card_test_an ::= "if" "it's" "an" linked_moved_card_filter "card" "," then_condition_program

linked_moved_card_filter ::= filter_phrase | adjective_nontype

/* Scope the chosen card and its permission to the same face-up exile producer. */
/* @sem Instruction::[Effect{result:@mark, operation:$graveyard_exile_receipt}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$adjective_nontype, InSet(Transition{result:@marked, phase:After})])}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:CastSpell, filter:Any}, terms:_{cost:Normal, spend_as:$chosen_exile_spending}})], duration:WhileExiled(Result{result:@prior, phase:After, index:0}), evaluation:LiveObjects}}] */
instructions_exile_choose_cast_permission ::= graveyard_exile_receipt "." "choose" counter_a adjective_nontype "card" "exiled" "this" "way" "." "you" "may" "cast" "that" "card" "for" "as" "long" "as" "it" "remains" "exiled" "," "and" chosen_exile_spending

/* @sem Operation::Move{objects:Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:InZone(Players{zone:Graveyard, players:OpponentsOf(AbilityController)})}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
graveyard_exile_receipt ::= "exile" "all" "opponents'" "graveyards"

chosen_exile_spending ::= chosen_exile_spending_color | chosen_exile_spending_type

/* @sem SpendAs::AnyColor */
chosen_exile_spending_color ::= "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "that" "spell"

/* @sem SpendAs::AnyType */
chosen_exile_spending_type ::= "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "that" "spell"

/* The color count reads the Before receipt of this single creature sacrifice. */
/* @sem Instruction::[Effect{result:@mark, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$retirement_choice_creature_filter}, choose:AsManyAsCan(Constant(1))})}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$sacrifice_return_cards}, count:UpTo($sacrifice_return_measure)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
sacrifice_colors_return ::= "sacrifice" "a" retirement_choice_creature_filter "." "return" "up" "to" "X" sacrifice_return_cards "from" "your" "graveyard" "to" "your" "hand" "," "where" "X" "is" sacrifice_return_measure

sacrifice_return_measure ::= sacrifice_return_colors | sacrifice_return_stat

/* @sem Expr::ObjectProperty{object:Query{objects:Transition{result:@marked, phase:Before}, index:0}, property:ColorCount, information:CurrentOrLastKnown} */
sacrifice_return_colors ::= "the" "number" "of" "colors" "that" "creature" "was"

/* @sem Expr::ObjectProperty{object:Query{objects:Transition{result:@marked, phase:Before}, index:0}, property:$creature_stat, information:CurrentOrLastKnown} */
sacrifice_return_stat ::= "that" "creature's" creature_stat

sacrifice_return_cards ::= sacrifice_return_any_cards | search_filter_many

/* @sem ObjectFilter::Any */
sacrifice_return_any_cards ::= "cards"

/* Used only by a program that supplies the immediately preceding amass action. */
/* @sem Operation::DealDamage{source:Result{result:@prior, phase:After, index:0}, recipients:Objects($affected), amount:ObjectProperty{object:Result{result:@prior, phase:After, index:0}, property:$creature_stat, information:CurrentOrLastKnown}, preventable:true} */
amassed_army_damage ::= "the" "Army" "you" "amassed" "deals" "damage" "equal" "to" "its" creature_stat "to" affected

/* The singular return and its after-transition form one producer/consumer unit. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:@owner_return(Operation::Move{objects:@implicit_card_set(ObjectSet::One($target_up_to_one)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]})}, Effect{result:@next, operation:CreatePerpetualEffect{objects:Transition{result:@prior, phase:After}, changes:$static_changes}}]} */
returned_target_perpetual_program ::= "return" target_up_to_one "to" "its" "owner's" "hand" "." "it" "perpetually" static_changes "."

/* The permission consumes the adjacent move to exile, including its destination. */
/* @sem Instruction::[Effect{result:@next, operation:$batch_cast_exile_producer}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:CastSpell, filter:$cast_spells_filter}, terms:$batch_cast_spending})], duration:WhileAnyExiled(Transition{result:@prior, phase:After}), evaluation:LiveObjects}}] */
instructions_exile_batch_cast_permission ::= batch_cast_exile_producer "." "you" "may" "cast" cast_spells_filter "from" "among" "those" "cards" "for" "as" "long" "as" "they" "remain" "exiled" "," "and" batch_cast_spending

batch_cast_exile_producer ::= exile_objects | exile_all_graveyard_cards | batch_cast_graveyard_exile | batch_cast_event_library_exile

/* @sem Operation::Move{objects:$target_graveyard_card_population, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
batch_cast_graveyard_exile ::= "exile" target_graveyard_card_population

/* The event subject owns the library and supplies the last-known property. */
/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(OwnerOf(EventSubject))}, kind:Card, filter:Any}, count:ObjectProperty{object:EventSubject, property:$stat, information:CurrentOrLastKnown}, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
batch_cast_event_library_exile ::= "exile" "cards" "equal" "to" "its" stat "from" "the" "top" "of" "its" "owner's" "library"

/* @sem PlayTerms::PlayTerms{cost:Normal, spend_as:AnyType} */
batch_cast_spending ::= "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "them"

perpetual_hand_choice ::= choose_one_filtered_hand_card | choose_one_hand_card

/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, count:AsManyAsCan(Constant(1))} */
choose_one_hand_card ::= "choose" "a" "card" "in" "your" "hand"

/* The delayed return and its grant consume the arrivals of this exact exile. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$exile_controlled_creatures_filter}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$exile_creatures_return_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}]}}}] */
instructions_exile_creatures_combat_return ::= "exile" "all" exile_controlled_creatures_filter "." "at" exile_creatures_return_event "," "return" "those" "cards" "to" "the" "battlefield" "under" "their" "owner's" "control" "and" "those" "creatures" "gain" keyword_name duration

/* @sem ObjectFilter::AllOf([CardType(Creature), ControlledBy(One(AbilityController))]) */
exile_controlled_creatures_plain ::= "creatures" "you" "control"

/* @sem ObjectFilter::AllOf([$adjective_color, CardType(Creature), ControlledBy(One(AbilityController))]) */
exile_controlled_creatures_colored ::= adjective_color "creatures" "you" "control"

exile_controlled_creatures_filter ::= exile_controlled_creatures_plain | exile_controlled_creatures_colored

/* @sem EventSpec::Turn{point:CombatBegins, players:All} */
exile_creatures_return_combat ::= "the" "beginning" "of" "the" "next" "combat"

exile_creatures_return_event ::= exile_creatures_return_combat | delayed_move_any_end | delayed_move_your_end | delayed_move_any_upkeep

/* The batch event and its EventAmount consumer share one trigger scope. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:$event_creatures_attack, duration:$this_duration, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:EventAmount, words:CreatingEffect, recipe:$attack_batch_token_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}]}}}] */
clause_attack_batch_create_tokens ::= "whenever" event_creatures_attack this_duration "," "create" "that" "many" attack_batch_token_recipe "that" "are" "tapped" "and" "attacking"

/* @sem TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2]}) */
attack_batch_token_recipe ::= token_stat "/" token_stat token_colors token_subtypes token_types "tokens"

/* The linked population and its arrival characteristics stay in the same move. */
/* @sem Operation::Move{objects:$exile_described_population, destination:$retained_counter_entry, qualifiers:[]} */
linked_exile_retained_entry ::= "put" "each" exile_described_population retained_counter_entry

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[Changes([SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Add, types:Listed($becomes_types)}])]}} */
retained_counter_entry ::= "onto" "the" "battlefield" "under" "your" "control" "with" "a" counter_kind "counter" "on" "it" "." "each" "of" "them" "is" "a" value "/" value becomes_types "in" "addition" "to" "its" "other" "types"

/* The enclosing casting line proves the singleton creature payment. */
/* @sem Operation::DealDamage{source:$damage_source_ref, recipients:$recipients, amount:$casting_sacrificed_creature_stat, preventable:true} */
damage_casting_sacrificed_stat_amount_first ::= damage_source_ref "deals" "damage" "equal" "to" casting_sacrificed_creature_stat "to" recipients

/* This follow-up is available only with the complete optional hand-draw producer. */
/* @sem Operation::DealDamage{source:$object_ref, recipients:Players(Intersection([$players_singular, Matching{binding:0, condition:PlayerTook{player:Bound(0), result:@marked}}])), amount:$value, preventable:true} */
hand_draw_participant_damage ::= object_ref "deals" value "damage" "to" players_singular "who" "discarded" "their" "hand" "this" "way"

/* @sem Instruction::[ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@next, operation:Discard{players:One(Bound(0)), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any})}}, Effect{result:@mark, operation:Draw{players:One(Bound(0)), amount:$card_count}}]}}]}}, Effect{result:@next, operation:$hand_draw_participant_damage}] */
instructions_optional_hand_draw_damage ::= hand_plural_players "may" "discard" "their" "hand" "and" "draw" card_count "." "then" hand_draw_participant_damage

/* A choice from the immediately observed hand retains its owner and selection.
   This phrase is composed only with the hand observation that supplies it. */
/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(2)), zone:Hand}, filter:@and($filter_phrase, ObjectFilter::OwnedBy(One($player_ref)))}, count:AsManyAsCan($observed_choice_article)}}, Effect{result:@next, operation:DiscardObjects{objects:One(Result{result:@prior, phase:After, index:0})}}]}}] */
optional_observed_filtered_discard ::= "you" "may" "choose" observed_choice_article filter_phrase "card" "from" "it" "." player_ref "discards" "that" "card"

/* @sem Instruction::[Effect{result:@next, operation:$hand_observation}, ...$optional_observed_filtered_discard] */
observed_hand_choose_optional_discard ::= hand_observation "." optional_observed_filtered_discard

observed_choice_article ::= observed_choice_a | observed_choice_an

/* @prefer always */
