copy_exiled_that_card_free ::= "copy" "that" "card" "." copy_cast_free

chosen_graveyard_an_filter ::= chosen_graveyard_instant_or_creature | filter_instant_or_sorcery | spell_instant | chosen_graveyard_an_union

