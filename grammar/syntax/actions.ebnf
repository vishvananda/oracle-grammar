chosen_source_combat_prevention ::= "prevent" "all" "combat" "damage" permanent_of_your_choice_a "would" "deal" this_duration

/* The postfix condition governs the sacrifice and its reflexive callback together. */
/* @sem Instruction::If{condition:ObjectMatches{object:Source, filter:Counters{kind:$counter_kind, comparison:GreaterOrEqual, value:$sacrifice_threshold}}, then:Program{instructions:[Effect{result:@mark, operation:Sacrifice{players:One(AbilityController), objects:One(Source)}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$reflexive_callback_program})}]}, otherwise:Program{}} */
conditional_source_sacrifice_callback ::= "then" "sacrifice" "it" "if" "it" "has" sacrifice_threshold "or" "more" counter_kind "counters" "on" "it" "." "when" "you" "do" "," reflexive_callback_program

/* @sem Program::Program{instructions:[...$conjoined, $conditional_source_sacrifice_callback]} */
program_postfix_sacrifice_callback ::= conjoined "." conditional_source_sacrifice_callback

