/* One-step actions, mana and counters. */

/* @sem Operation::AddMana{players:One(PlayerRef::AbilityController), mana:$mana_production} */
add_mana ::= "add" ("an" "additional")? mana_production

/* The named player receives the mana; the ability controller need not do so. */
/* @sem Operation::AddMana{players:$players_singular, mana:$mana_production} */
add_mana_player ::= players_singular "adds" ("an" "additional")? mana_production

mana_production ::= mana_bundle | mana_or | mana_or_list | mana_any_color | mana_any_one_color | mana_or_chosen
    | mana_could_produce_color | mana_could_produce_type | mana_same_type_produced | mana_commander_identity
    | mana_colors_linked_card | mana_colors_linked_cards

/* Mana another permanent could make is chosen among its colors, or among its
   types when colorless counts too. */
/* @sem ManaProduction::CouldProduce{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, colors_only:true} */
mana_could_produce_color ::= "one" "mana" "of" "any" "color" "that" ("a" | "an") filter_phrase "could" "produce"
/* @sem ManaProduction::CouldProduce{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, colors_only:false} */
mana_could_produce_type ::= "one" "mana" "of" "any" "type" "that" ("a" | "an") filter_phrase "could" "produce"
/* The tapped permanent of a mana trigger names the mana it just produced. */
/* @sem ManaProduction::SameTypeAsProduced */
mana_same_type_produced ::= "one" "mana" "of" "any" "type" "that" ("land" | "permanent") "produced"

mana_bundle ::= mana_unit | mana_units

/* @sem ManaProduction::Amount{color:$mana_color, amount:Expr::Constant(1)} */
mana_unit ::= mana_color

/* @sem ManaProduction::@literal_mana_sequence($mana_unit, $mana_bundle) */
mana_units ::= mana_unit mana_bundle

/* @sem ManaProduction::ChooseOne([$mana_bundle, $mana_bundle_2]) */
mana_or ::= mana_bundle "or" mana_bundle

/* @sem ManaProduction::ChooseOne([$mana_bundle, ManaProduction::Amount{color:Chosen, amount:Expr::Constant(1)}]) */
mana_or_chosen ::= mana_bundle "or" "one" "mana" "of" "the" "chosen" "color"

/* @sem ManaProduction::ChooseOne([$mana_bundle, ...$mana_or_tail]) */
mana_or_list ::= mana_bundle "," mana_or_tail

mana_or_tail ::= mana_or_last | mana_or_more

/* @sem ManaProduction::[$mana_bundle] */
mana_or_last ::= "or" mana_bundle

/* @sem ManaProduction::[$mana_bundle, ...$mana_or_tail] */
mana_or_more ::= mana_bundle "," mana_or_tail

/* @sem ManaProduction::ChooseOne([ManaProduction::Amount{color:White, amount:$number}, ManaProduction::Amount{color:Blue, amount:$number}, ManaProduction::Amount{color:Black, amount:$number}, ManaProduction::Amount{color:Red, amount:$number}, ManaProduction::Amount{color:Green, amount:$number}]) */
mana_any_color ::= number "mana" "of" "any" "color"
/* One mana of a color in your commander's color identity (CR 903.4). */
/* @sem ManaProduction::CommanderIdentity */
mana_commander_identity ::= "one" "mana" "of" "any" "color" "in" "your" "commander's" "color" "identity"

/* @sem ManaProduction::Repeat{amount:$number, production:ChooseOne([ManaProduction::Amount{color:White, amount:Expr::Constant(1)}, ManaProduction::Amount{color:Blue, amount:Expr::Constant(1)}, ManaProduction::Amount{color:Black, amount:Expr::Constant(1)}, ManaProduction::Amount{color:Red, amount:Expr::Constant(1)}, ManaProduction::Amount{color:Green, amount:Expr::Constant(1)}]), choice:Once} */
mana_any_one_color ::= number "mana" "of" "any" "one" "color"

mana_color ::= mc_white | mc_blue | mc_black | mc_red | mc_green | mc_colorless

/* @sem ManaColor::White */
mc_white ::= "{W}"
/* @sem ManaColor::Blue */
mc_blue ::= "{U}"
/* @sem ManaColor::Black */
mc_black ::= "{B}"
/* @sem ManaColor::Red */
mc_red ::= "{R}"
/* @sem ManaColor::Green */
mc_green ::= "{G}"
/* @sem ManaColor::Colorless */
mc_colorless ::= "{C}"

put_counters ::= put_counters_capped_source_power | put_created_counters_for_counters | put_counters_two_direct | put_counters_direct | put_counters_equal | put_counters_equal_first | put_counters_choice | put_counters_many_choices | put_counters_where_devotion
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:$counter_amount}]} */
put_counters_direct ::= "put" counter_amount counter_kind ("counter" | "counters") "on" affected
/* A counted placement names its amount after its recipients or before them. */
/* One recipient: a value naming "that creature" after a group would read as
   the source, not as each member. */
/* @sem Operation::PutCounters{placements:[_{recipients:$counted_recipient, kind:$counter_kind, amount:$value}]} */
put_counters_equal ::= "put" "a" "number" "of" counter_kind "counters" "on" counted_recipient "equal" "to" value
counted_recipient ::= counted_object | counted_reference | counted_created
/* @sem Recipients::Objects(One($object_ref)) */
counted_object ::= object_ref
/* @sem Recipients::Objects($counter_choice_singular_reference) */
counted_reference ::= counter_choice_singular_reference
/* @sem Recipients::Objects($created_singular_reference) */
counted_created ::= created_singular_reference
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:$value}]} */
put_counters_equal_first ::= "put" "a" "number" "of" counter_kind "counters" "equal" "to" value "on" affected

/* This recipient is chosen at resolution, without announcing a target. */
/* @sem Operation::@counter_choice(Operation::PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}), kind:$counter_kind, amount:$counter_amount, selection:_{player:AbilityController, count:$counter_single_choice}}]}) */
put_counters_choice ::= "put" counter_amount counter_kind ("counter" | "counters") "on" counter_single_choice filter_phrase
/* @sem Operation::@counter_choice(Operation::PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}), kind:$counter_kind, amount:$counter_amount, selection:_{player:AbilityController, count:$counter_many_choice}}]}) */
put_counters_many_choices ::= "put" counter_amount counter_kind ("counter" | "counters") "on" counter_many_choice filter_plural
counter_single_choice ::= counter_single_required | counter_single_optional
/* @sem Count::AsManyAsCan(Constant(1)) */
counter_single_required ::= counter_choice_one
/* @sem Count::UpTo(Constant(1)) */
counter_single_optional ::= "up" "to" counter_choice_one
/* @sem () */
counter_choice_one ::= "a" | "an" | "one" | "1"
counter_many_choice ::= counter_many_required | counter_many_optional | count_any_number
/* @sem Count::AsManyAsCan($counter_choice_amount) */
counter_many_required ::= counter_choice_amount
/* @sem Count::UpTo($counter_choice_amount) */
counter_many_optional ::= "up" "to" counter_choice_amount
counter_choice_amount ::= number_digits | number_words | number_x

/* @sem Instruction::[Effect{result:@next, operation:$put_counters}] */
clause_you_counters ::= "you" put_counters

/* Coordinated conditions are independent: neither arm can erase the other.
   Both predicates refer to the object named by this counter instruction. */
/* @sem Instruction::[If{condition:ObjectMatches{object:$object_ref, filter:$filter_phrase}, then:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($object_ref)), kind:$counter_kind, amount:$counter_amount}]}}]}, otherwise:Program{}}, If{condition:ObjectMatches{object:$object_ref, filter:$filter_phrase_2}, then:$program, otherwise:Program{}}] */
clause_conditional_counter_pair ::= "put" counter_amount counter_kind ("counter" | "counters") "on" object_ref "if" "it's" ("a" | "an") filter_phrase "and" program "if" "it's" ("a" | "an") filter_phrase

counter_amount ::= counter_a | number_digits | number_words | number_x

/* @sem Expr::Constant(1) */
counter_a ::= "a" | "an"

counter_kind ::= counter_plus | counter_minus | counter_pt | counter_name

/* @sem CounterKind::PowerToughness(1, 1) */
counter_plus ::= "+" "1" "/" "+" "1"

/* @sem CounterKind::PowerToughness(-1, -1) */
counter_minus ::= "-" "1" "/" "-" "1"

/* Other power/toughness counters, as printed: a zero keeps its written sign. */
counter_pt ::= counter_pt_plus1_plus0 | counter_pt_plus2_plus2 | counter_pt_plus0_plus1 | counter_pt_minus0_minus1 | counter_pt_minus0_minus2 | counter_pt_plus1_plus2 | counter_pt_minus2_minus1 | counter_pt_minus2_minus2 | counter_pt_plus0_plus2 | counter_pt_minus1_minus0
/* @sem CounterKind::PowerToughness(1, 0) */
counter_pt_plus1_plus0 ::= "+" "1" "/" "+" "0"
/* @sem CounterKind::PowerToughness(2, 2) */
counter_pt_plus2_plus2 ::= "+" "2" "/" "+" "2"
/* @sem CounterKind::PowerToughness(0, 1) */
counter_pt_plus0_plus1 ::= "+" "0" "/" "+" "1"
/* @sem CounterKind::PowerToughness(0, -1) */
counter_pt_minus0_minus1 ::= "-" "0" "/" "-" "1"
/* @sem CounterKind::PowerToughness(0, -2) */
counter_pt_minus0_minus2 ::= "-" "0" "/" "-" "2"
/* @sem CounterKind::PowerToughness(1, 2) */
counter_pt_plus1_plus2 ::= "+" "1" "/" "+" "2"
/* @sem CounterKind::PowerToughness(-2, -1) */
counter_pt_minus2_minus1 ::= "-" "2" "/" "-" "1"
/* @sem CounterKind::PowerToughness(-2, -2) */
counter_pt_minus2_minus2 ::= "-" "2" "/" "-" "2"
/* @sem CounterKind::PowerToughness(0, 2) */
counter_pt_plus0_plus2 ::= "+" "0" "/" "+" "2"
/* @sem CounterKind::PowerToughness(-1, 0) */
counter_pt_minus1_minus0 ::= "-" "1" "/" "-" "0"

action ::= wish_reveal_owned | copy_effect_indefinite_except | copy_effect_duration_except | copy_effect_indefinite | copy_effect_duration | keyword_action | return_card_attached_to_created_token | remove_from_combat_action | fight_action | connive_object_controller | move_same_controller_counters | move_mixed_target_hand | required_defender_attack | move_linked_cards_hand | manifest_dread | unattach_action | suspect_action | unsuspect_action | goad_while_present | clash_opponent | attach_each_host | attach_counted_to_host | attach_one_to_host | manifest_hand | cloak_hand | manifest_one | cloak_one | attach_objects | tap_objects | untap_objects | regenerate_objects | exile_objects | exile_ordered_face_down | exile_optional_graveyard_card_set | sacrifice_objects | sacrifice_choice | move_hand | move_graveyard | move_top | move_bottom | move_graveyard_top_ordered | move_graveyard_bottom_ordered | move_shuffled | put_optional_graveyard_target_battlefield | move_battlefield | move_battlefield_attached | put_battlefield_attached | move_battlefield_counter | move_battlefield_tapped | move_battlefield_owner | move_battlefield_transformed | move_battlefield_owner_transformed | move_owner_counter_untapped | move_owner_counter_one | move_owner_counter_many | move_battlefield_owner_tapped | reveal_top | look_top | look_objects | prevent_clause | tap_or_untap | create_emblem | reveal_hand | remove_counters_from_affected | remove_all_counters_from_affected | put_that_many_counters | double_counters | put_counter_for_each | recipients_gets_counter | recipients_get_counter | recipients_gets_counters | support_action | choose_a_color | choose_a_card_name | choose_value | choose_cards_in_hand | flip_a_coin | add_mana_player | add_mana_for_affected | add_mana_for_each | add_mana_for_removed_counters | add_alternative_mana_for_removed_counters | add_mana_of_chosen_color | add_mana_any_combination | add_mana_amount_equal | create_tokens_tapped_attacking | create_tokens_attacking_player | abandon_this_scheme | you_gain_life | deal_damage_equal_counters | deal_damage_split_two | exile_target_players_graveyard | exile_all_graveyard_cards | exile_all_graveyards_cards | exile_all_hand_cards | exile_all_hand_face_down | exile_all_library_cards | exile_two_groups | exile_all_graveyards | exile_with_counters | exile_instead_of_dying | entries_with_counters_this_turn | exile_damaged_instead_of_dying | prevent_combat_damage_would_deal | gain_control_of | player_gains_control_of | gain_control_while_controlled | exile_top_cards_of_your_library | then_players_shuffle | look_at_top_x_cards | shuffle_your_library | search_library_for_cards | play_that_card_permission | cast_that_card_permission | cast_that_card_permission_spending | play_those_cards_permission | skip_controllers_next_untap | skip_controllers_next_untap_plural | skip_controller_next_untap_shared | skip_your_next_untap | duration_affected_static_changes | duration_affected_changes | base_power_toughness_for_duration | affected_also_changes | becomes_artifact_creature | attack_despite_defender | changes_while_tapped | loses_flying | attacks_if_able | perpetual_affected_changes | perpetual_prior_base_power | create_tokens_attacking_singular | create_tokens_attacking_plural | create_tokens_blocking_singular | counter_stack_action | return_history_cards_hand | return_arrived_graveyard_cards_hand | return_other_qualified_battlefield | return_each_qualified_battlefield | duration_added_color_type | sacrifice_each_by_controller | double_player_life_total | return_target_stack_spell_hand | note_information | temporary_graveyard_redirect | choose_suspended_remove_event_counters | remove_each_suspended_counters | deal_damage_split_recipients | deal_damage_split_half | exile_hand_graveyard_any | exile_hand_graveyard_cards | redirect_next_damage_to_owner | redirect_next_spell_damage_to_controller | multiply_chosen_creature_combat_damage | combat_reselect_target | combat_reselect_each | add_mana_each_craft_color | redirect_spell_damage_controller | conjure_named_battlefield | conjure_named_battlefield_tapped | move_to_modified_battlefield | return_filtered_permanents_hand | put_exiled_singular | put_exiled_plural | return_each_color_targets_hand | return_graveyard_personal_hand | return_graveyard_all_owners_hand | return_graveyard_selection_hand | return_each_color_hand | deal_damage_evenly_rounded | future_player_cast_effect

/* Manifest dread yields one face-down creature for a later singular reference. */
/* @sem Operation::@manifest_result(Operation::Keyword{actor:One(AbilityController), action:KeywordAction::ManifestDread{}}) */
manifest_dread ::= "manifest" "dread"

/* Connive is performed by the named permanent's controller (CR 701.50a-b), the
   current or last-known one. The same lexical object supplies actor and object;
   duplicated target markers retain one slot. */
/* @sem Operation::Keyword{actor:One(ControllerOf($object_ref)), action:KeywordAction::Connive{object:$object_ref}} */
connive_object_controller ::= object_ref "connives"

/* A single object and a plural population use the same native action shape. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Suspect, objects:$object_set} */
suspect_action ::= "suspect" object_set

/* The goad's duration names its own permanent, independently of its recipients. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Goad{until:WhileOnBattlefield($object_ref)}, objects:$affected} */
goad_while_present ::= "as" "long" "as" object_ref "remains" "on" "the" "battlefield" "," affected ("is" | "are") "also" "goaded"

unsuspect_action ::= unsuspect_objects | unsuspect_contracted | unsuspect_conditional

/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Unsuspect, objects:$affected} */
unsuspect_objects ::= affected ("is" | "are") "no" "longer" "suspected"

/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Unsuspect, objects:One(@it)} */
unsuspect_contracted ::= "it's" "no" "longer" "suspected"

/* Removing suspected status already does nothing when that status is absent. */
/* @sem $unsuspect_contracted */
unsuspect_conditional ::= "if" "it's" "suspected" "," unsuspect_contracted

/* Clashing is a game action, not part of a mana payment. */
/* @sem Operation::Clash{actor:One(AbilityController), opponents:OpponentsOf(AbilityController), won:[Program{}], lost:[Program{}]} */
clash_opponent ::= "clash" "with" ("a" | "an") "opponent"

/* Binding the host completes this action's reference focus, after its subject. */
/* Attachment selections and host phrases compose independently. */
/* @sem Operation::AttachEach{actor:One(AbilityController), attachments:$affected, count:$count_any_number, hosts:$attachment_recipient} */
attach_counted_to_host ::= "attach" count_any_number affected "to" attachment_recipient

/* @sem Operation::AttachEach{actor:One(AbilityController), attachments:$object_one, hosts:$attachment_recipient} */
attach_one_to_host ::= "attach" object_one "to" attachment_recipient

attachment_recipient ::= attachment_player_recipient | attachment_target_recipient
/* @sem Recipients::Players(One($player_ref)) */
attachment_player_recipient ::= player_ref
/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any, players:All})) */
attachment_target_recipient ::= "target" "permanent" "or" "player"

/* @sem Operation::Attach{attachments:$affected, host:@remember_object($object_ref)} */
attach_objects ::= "attach" affected "to" object_ref

/* Each iteration supplies the local host of "it". The count applies to every
   host independently; neither operand is the result of the preceding effect. */
attach_each_host ::= attach_each_optional | attach_each_up_to | attach_each_required | attach_each_required_named

/* @sem Operation::AttachEach{actor:$attach_loop_actor, attachments:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:UpTo(Constant(1)), hosts:Objects($attach_loop_hosts), each_host:true} */
attach_each_optional ::= attach_loop_hosts "," attach_loop_actor "may" "attach" ("a" | "an" | "one") filter_phrase "to" "it"

/* @sem Operation::AttachEach{actor:$attach_loop_actor, attachments:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, count:UpTo($counter_choice_amount), hosts:Objects($attach_loop_hosts), each_host:true} */
attach_each_up_to ::= attach_loop_hosts "," attach_loop_actor "may" "attach" "up" "to" counter_choice_amount filter_plural "to" "it"

/* @sem Operation::AttachEach{actor:One(AbilityController), attachments:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan(Constant(1)), hosts:Objects($attach_loop_hosts), each_host:true} */
attach_each_required ::= attach_loop_hosts "," "you"? "attach" ("a" | "an" | "one") filter_phrase "to" "it"

/* @sem Operation::AttachEach{actor:One($attach_loop_third_actor), attachments:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan(Constant(1)), hosts:Objects($attach_loop_hosts), each_host:true} */
attach_each_required_named ::= attach_loop_hosts "," attach_loop_third_actor "attaches" ("a" | "an" | "one") filter_phrase "to" "it"

attach_loop_third_actor ::= target_player | target_opponent | that_player | defending_player | its_controller | its_owner | stack_controller

attach_loop_hosts ::= attach_loop_created | attach_loop_matching
/* @sem ObjectSet::$created_batch_reference */
attach_loop_created ::= "for" "each" "of" created_batch_reference
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase} */
attach_loop_matching ::= "for" "each" filter_phrase

attach_loop_actor ::= attach_loop_you | attach_loop_named_actor
/* @sem PlayerSet::One(AbilityController) */
attach_loop_you ::= "you"
/* @sem PlayerSet::One($player_ref) */
attach_loop_named_actor ::= player_ref

/* Old instruction-level declarations share the same operation and result. */
/* @sem Instruction::[Effect{result:@next, operation:$attach_each_host}] */
clause_attach_each ::= attach_each_host

/* @sem Operation::SetTapped{objects:$object_set, tapped:true} */
tap_objects ::= "tap" object_set
/* @sem Operation::SetTapped{objects:$object_set} */
untap_objects ::= "untap" object_set
/* @sem Operation::CreateRegenerationShields{objects:$object_set} */
regenerate_objects ::= "regenerate" object_set
/* @sem Operation::@exile_result(Operation::Move{objects:$object_set, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}) */
exile_objects ::= "exile" object_set
/* "Exile the top card of your library face down": the slice, hidden from view. A
   pronoun after a look ("exile it face down") names the looked-at card, which the
   binder does not yet follow; those stay with their own rules. */
/* @sem Operation::Move{objects:$ordered_cards, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_ordered_face_down ::= "exile" ordered_cards "face" "down"
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(PlayerRef::AbilityController), objects:$object_set}) */
sacrifice_objects ::= "sacrifice" object_set

/* A resolving instruction does as much as possible. These selections are not
   activation costs: their result supplies a following reflexive trigger. */
sacrifice_choice ::= sacrifice_one | sacrifice_another | sacrifice_another_or | sacrifice_many
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Constant(1))}) */
sacrifice_one ::= "sacrifice" ("a" | "an") filter_phrase
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@target_contrast(ObjectRef::Source, ObjectFilter::$filter_phrase))), $filter_phrase)}, choose:AsManyAsCan(Constant(1))}) */
sacrifice_another ::= "sacrifice" "another" filter_phrase
/* "Another" qualifies the first alternative only. */
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $filter_phrase), $filter_phrase_2])}, choose:AsManyAsCan(Constant(1))}) */
sacrifice_another_or ::= "sacrifice" "another" filter_phrase "or" ("a" | "an") filter_phrase
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:AsManyAsCan($counter_choice_amount)}) */
sacrifice_many ::= "sacrifice" counter_choice_amount filter_plural

/* Where an object goes. Whose hand or library it is follows from whose card it is. */
/* @sem () */
owners ::= "your" | "its" "owner's" | "their" "owner's" | "their" "owners'" | "their" | "its" | "that" "player's"

/* Explicit ownership is distinct from the ability controller. */
/* @sem () */
owner_possessive ::= "its" "owner's" | "their" "owner's" | "their" "owners'"

battlefield_control ::= battlefield_control_yours | battlefield_control_owner

/* @sem MovementDestination::Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
battlefield_control_yours ::= "under" "your" "control"

/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
battlefield_control_owner ::= "under" owner_possessive "control"

move_hand ::= move_hand_explicit_owner | move_hand_other_possessive | move_linked_card_hand
/* The explicit owner phrase introduces that player for later clauses. */
/* @sem Operation::@owner_return(Operation::Move{objects:@implicit_card_set($affected), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}) */
move_hand_explicit_owner ::= ("return" | "put") affected ("to" | "into") owner_possessive ("hand" | "hands")
/* @sem Operation::Move{objects:@implicit_card_set($affected), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
move_hand_other_possessive ::= ("return" | "put") affected ("to" | "into") hand_other_possessive ("hand" | "hands")
/* @sem () */
hand_other_possessive ::= "your" | "their" | "its" | "that" "player's"
/* A linked population is currently in exile. Its anchor is the named object,
   including the activation's sacrificed holder, not its controller or owner.
   Each card returns to its own owner; singular possessive spelling is allowed. */
/* @sem Operation::Move{objects:Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
move_linked_cards_hand ::= ("return" | "put") "all" "cards" "exiled" "with" object_ref ("to" | "into") "their" ("owner's" | "owners'") ("hand" | "hands")
/* @sem Operation::Move{objects:@implicit_card_set($affected), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]} */
move_graveyard ::= "put" affected "into" owners ("graveyard" | "graveyards")
/* @sem Operation::Move{objects:@implicit_card_set($affected), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
move_top ::= "put" affected "on" "top" "of" owners ("library" | "libraries")
/* @sem Operation::Move{objects:@implicit_card_set($affected), destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
move_bottom ::= "put" affected "on" "the" "bottom" "of" owners ("library" | "libraries")
/* These card targets begin outside the library. DestinationDefault retains
   each receiving library's ordinary ordering and chooser rules. */
/* @sem Operation::Move{objects:$graveyard_target_cards, destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
move_graveyard_top_ordered ::= "put" graveyard_target_cards "on" "top" "of" owners ("library" | "libraries") "in" "any" "order"
/* @sem Operation::Move{objects:$graveyard_target_cards, destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
move_graveyard_bottom_ordered ::= "put" graveyard_target_cards "on" "the" "bottom" "of" owners ("library" | "libraries") "in" "any" "order"
/* @sem Operation::Move{objects:@implicit_card_set($affected), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
move_shuffled ::= "shuffle" affected "into" owners ("library" | "libraries")
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
move_battlefield ::= ("return" | "put") affected ("to" | "onto") "the" "battlefield" ("under" "your" "control")?
/* Prefer the source's `put` wording for this compositional optional graveyard
   target while retaining the shared target phrase and generic move semantics. */
/* @prefer always */
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set(ObjectSet::One($target_card_a_graveyard_up_to_one))), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
put_optional_graveyard_target_battlefield ::= "put" target_card_a_graveyard_up_to_one "onto" "the" "battlefield" "under" "your" "control"
/* An Aura or Equipment that arrives attached names its host: this object, a target or
   what this object is attached to. */
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo($attach_host)]}}, qualifiers:[]} */
move_battlefield_attached ::= "return" affected "to" "the" "battlefield" "attached" "to" attach_host
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo($attach_host)]}}, qualifiers:[]} */
put_battlefield_attached ::= "put" affected "onto" "the" "battlefield" "attached" "to" attach_host
attach_host ::= self_ref | target_object | attached_ref
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, $entry_counter_amount]], states:[]}}, qualifiers:[]} */
move_battlefield_counter ::= ("return" | "put") affected ("to" | "onto") "the" "battlefield" ("under" "your" "control")? "with" entry_counter_amount counter_kind "counter" "on" "it"
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]} */
move_battlefield_tapped ::= ("return" | "put") affected ("to" | "onto") "the" "battlefield" "tapped" ("under" "your" "control")?
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
move_battlefield_owner ::= ("return" | "put") affected ("to" | "onto") "the" "battlefield" "under" owner_possessive "control"
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]} */
move_battlefield_owner_tapped ::= ("return" | "put") affected ("to" | "onto") "the" "battlefield" "tapped" "under" owner_possessive "control"

/* Transformation is an entry state, rather than an instruction after moving.
   Keep the destination's controller and the actual moved objects independent. */
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Player(AbilityController), arrival:$transformed_entry}, qualifiers:[]} */
move_battlefield_transformed ::= ("return" | "put") affected ("to" | "onto") "the" "battlefield" transformed_entry "under" "your" "control"
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Owner, arrival:$transformed_entry}, qualifiers:[]} */
move_battlefield_owner_transformed ::= ("return" | "put") affected ("to" | "onto") "the" "battlefield" transformed_entry "under" owner_possessive "control"

transformed_entry ::= entry_transformed | entry_transformed_tapped
/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[], states:[Transformed]} */
entry_transformed ::= "transformed"
/* @sem BattlefieldArrival::BattlefieldArrival{tapped:true, counters:[], states:[Transformed]} */
entry_transformed_tapped ::= "tapped" "and" "transformed" | "transformed" "and" "tapped"

/* @sem Operation::Mill{players:@subject, amount:$card_count} */
mill_base ::= "mill" card_count
/* @sem Operation::Mill{players:@subject, amount:$card_count} */
mill_third ::= "mills" card_count
/* @sem Operation::Scry{players:@subject, amount:$number} */
scry_base ::= "scry" number
/* @sem Operation::Scry{players:@subject, amount:$value} */
scry_equal ::= "scry" "a" "number" "of" "cards" "equal" "to" value
/* @sem Operation::Scry{players:@subject, amount:$number} */
scry_third ::= "scries" number
/* @sem Operation::Surveil{players:@subject, amount:$number} */
surveil_base ::= "surveil" number
/* @sem Operation::Surveil{players:@subject, amount:$number} */
surveil_third ::= "surveils" number

/* @sem Instruction::[Instruction::Optional{decider:AbilityController, body:Program{instructions:$may_body}}] */
clause_may ::= "you" "may" may_body

/* A then-continuation is part of the same optional resolving action. */
/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:@optional_then($may_body, $conjoined)}}] */
clause_may_then ::= "you" "may" may_body "," "then" conjoined

may_body ::= graveyard_return_single | look_put_then_body | clause_have_continuous | clause_have_deal | clause_player_put_card | clause_imperative | clause_operation | clause_search | clause_search_where_split | clause_search_either | clause_exile_from | clause_put_from | clause_put_from_tapped

/* A cost paid during resolution, and what depends on paying it. */
payment ::= payment_mana_and_graveyard_exile | payment_put_counters | payment_return_controlled_permanent | payment_put_hand_card | payment_hand_draw | resolution_life_sacrifice_cost | payment_remove_counters | cost | pay_mana | payment_sacrifice | payment_action | payment_exile | payment_return | payment_tap | payment_draw | payment_have_draw

/* An imperative action has an implicit "you". Other payers use native costs
   or an explicit "have [player]" action, never that implicit performer. */
other_payment ::= payment_put_counters | payment_sacrifice_choice | cost | pay_mana | payment_sacrifice | payment_exile | payment_return | payment_tap | payment_draw | payment_have_draw

/* Resolved object references, including damage-event sources, pay the native
   sacrifice cost directly instead of wrapping a sacrifice action as a cost. */
/* @sem Cost::Cost{parts:[CostPart::Sacrifice{objects:$affected}]} */
payment_sacrifice ::= "sacrifice" affected

/* @sem Cost::Cost{parts:[CostPart::Draw{count:$card_count}]} */
payment_draw ::= "draw" card_count

/* A resolving self-payment uses the native counter-removal cost. Its recipient
   is the resolved noun/pronoun, not an assumed source or a retained action body. */
/* @sem Cost::Cost{parts:[RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:Count(Exactly($payment_counter_amount))}]}]} */
payment_remove_counters ::= "remove" payment_counter_amount counter_kind ("counter" | "counters") "from" affected

payment_counter_amount ::= counter_a | number_digits | number_words

/* Putting counters can itself be the resolution cost. Its recipient and the
   payer are independent; the surrounding payment clause binds the receipt. */
/* @sem Cost::Cost{parts:[PutCounters([$counter_direct_placement])]} */
payment_put_counters ::= "put" counter_direct_placement

/* The deciding payer and the player performing this action are independent. */
/* @sem Cost::Cost{parts:[CostPart::PlayerAction{player:$payment_actor, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One($payment_actor), amount:$card_count}}]}}]} */
payment_have_draw ::= "have" payment_actor "draw" card_count

payment_actor ::= payment_you | player_ref

/* @sem PlayerRef::AbilityController */
payment_you ::= "you"

/* @sem Cost::Cost{parts:[CostPart::PlayerAction{player:AbilityController, body:Program{instructions:@offered_action($may_body)}}]} */
payment_action ::= may_body

/* @sem Cost::Cost{parts:[CostPart::Move{selections:[CostObjectSelection{objects:$affected}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]} */
payment_exile ::= "exile" affected

/* @sem Cost::Cost{parts:[CostPart::Move{selections:[CostObjectSelection{objects:$affected}], destination:OwnersHand(CardArrival{counters:[], states:[]})}]} */
payment_return ::= "return" affected "to" owners ("hand" | "hands")

/* @sem Cost::Cost{parts:[CostPart::ChangeTapState{selections:[CostObjectSelection{objects:$affected}], tapped:true}]} */
payment_tap ::= "tap" affected

/* Resolution-time mana X is chosen here unless a surrounding definition supplies it. */
/* @sem Cost::@payment_cost(Cost::Cost{parts:[Mana($mana_symbols)]}, Expr::AnnouncedX) */
resolving_cost_chosen ::= mana_symbols

/* An announced value remains possible when the source spell cost is external. */
/* @sem Cost::@announced_cost(Cost::Cost{parts:[Mana($mana_symbols)]}, Expr::AnnouncedX) */
resolving_cost_announced ::= mana_symbols

resolving_cost ::= resolving_cost_chosen | resolving_cost_announced

/* @sem $resolving_cost */
pay_mana ::= "pay" resolving_cost

/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::PayCost{player:AbilityController, cost:$payment, optional:true}}, Instruction::If{condition:PaymentChosen(@last_result), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_if_you_do ::= "you" "may" payment "." "if" "you" "do" "," conjoined

/* "Discard a card. If you do, draw a card": a required payment that can still fail,
   so the dependent effects test its success. */
/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::PayCost{player:AbilityController, cost:$payment, optional:false}}, Instruction::If{condition:PaymentChosen(@last_result), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_required_if_you_do ::= payment "." "if" "you" "do" "," conjoined

/* "Sacrifice a creature. If you can't, sacrifice this artifact": an action that a
   following "if you can't" tests is a cost paid as the ability resolves (CR 118.12),
   in full or not at all; the dependent effects follow when it was not paid. */
/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::PayCost{player:AbilityController, cost:$payment, optional:false}}, Instruction::If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_required_if_you_cant ::= payment "." "if" "you" "can't" "," conjoined

/* "Sacrifice a creature. Rupture deals damage equal to that creature's power …" and
   "Target player sacrifices an artifact or creature of their choice. Hit deals damage
   to that player equal to that permanent's mana value": damage measured by the
   sacrificed permanent follows a required sacrifice and reads its payment. The damage
   must measure that permanent: an implicit actor its noun proves, or a possessive that
   names it. A written actor's bare "its" reads that actor, so that sacrifice stays a
   plain action. Life or cards measured that way read the sacrifice itself. */
clause_sacrifice_then_damage ::= sacrifice_then_damage_own | sacrifice_then_damage_player
/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::@measured_sacrifice(Operation::PayCost{player:AbilityController, cost:Cost{parts:[$cost_sacrifice]}, optional:false})}, Instruction::If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:$sacrificed_damage}]}, otherwise:Program{}}] */
sacrifice_then_damage_own ::= cost_sacrifice "." sacrificed_damage
/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::@measured_sacrifice(Operation::PayCost{player:$player_ref, cost:Cost{parts:[CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly(Expr::Constant(1))}]}, optional:false})}, Instruction::If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:$sacrificed_damage}]}, otherwise:Program{}}] */
sacrifice_then_damage_player ::= player_ref "sacrifices" ("a" | "an") filter_phrase "of" "their" "choice" "." sacrificed_damage
sacrificed_damage ::= deal_damage_equal | deal_damage_equal_first

/* "You may sacrifice a creature. If you don't, tap this creature": what follows
   happens only when the offered payment is declined. */
/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::PayCost{player:AbilityController, cost:$payment, optional:true}}, Instruction::If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_if_you_dont ::= "you" "may" payment "." "if" "you" "don't" "," conjoined

/* Not taking a conditional offer includes the condition being false. Both
   fallback branches instantiate the same declaration with their own results. */
/* @sem Instruction::[@leading_if(Instruction::If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:$conjoined}, otherwise:Program{}}]}, otherwise:Program{instructions:$conjoined}})] */
clause_if_optional_fallback ::= "if" condition "," "you" "may" payment "." "if" "you" "don't" "," conjoined

/* Both outcomes of one offered payment form one condition and its otherwise branch. */
/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::PayCost{player:AbilityController, cost:$payment, optional:true}}, Instruction::If{condition:PaymentChosen(@last_result), then:Program{instructions:$conjoined}, otherwise:Program{instructions:$conjoined_2}}] */
clause_if_you_do_otherwise ::= "you" "may" payment "." "if" "you" "do" "," conjoined "." "if" "you" "don't" "," conjoined

/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$player_ref, cost:$other_payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_if_they_do ::= player_ref "may" other_payment "." "if" "they" "do" "," conjoined

/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$player_ref, cost:$other_payment, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_if_they_dont ::= player_ref "may" other_payment "." "if" ("they" "don't" | "that" "player" "doesn't" | "that" "opponent" "doesn't") "," conjoined

/* One willing payer completes one optional payment. The chosen payer's own
   graveyard narrows the candidate pool; it is not the ability controller's. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:FirstWilling(All), cost:$willing_exile_payment, optional:true}}, If{condition:$willing_payment_condition, then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_first_willing_exile ::= "any" "player" "may" willing_exile_payment "." willing_payment_condition "," conjoined

/* @sem Cost::Cost{parts:[Move{selections:[_{objects:Zone{scope:Players{zone:Graveyard, players:One(FirstWilling(All))}, kind:Card, filter:Any}, choose:Exactly($card_count)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]} */
willing_exile_payment ::= "exile" card_count "from" "their" "graveyard"

willing_payment_condition ::= willing_payment_done | willing_payment_not_done
/* @sem Condition::PaymentChosen(@marked) */
willing_payment_done ::= "if" "a" "player" "does"
/* @sem Condition::Not(PaymentChosen(@marked)) */
willing_payment_not_done ::= "if" "no" "one" "does"

/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::PayCost{player:AbilityController, cost:$payment, optional:true}}, Instruction::If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Instruction::Effect{result:@next, operation:$operation}]}, otherwise:Program{}}] */
clause_unless_pay ::= operation "unless" "you" payment

/* An optional action keeps its reflexive trigger inside the option. Only the
   trigger announces its targets. Canonical IR flattens instruction groups. */
/* @sem Instruction::[...$reflexive_required, $reflexive_trigger] */
instructions_when_you_do ::= reflexive_required "." reflexive_trigger

reflexive_required ::= clause_operation | clause_imperative | clause_you | clause_third | clause_if_after

instructions_may_when_you_do ::= instructions_may_when_you_do_plain | instructions_may_either_when_you_do

/* @sem Instruction::[Instruction::Optional{decider:AbilityController, body:Program{instructions:[...$reflexive_action, $reflexive_trigger]}}] */
instructions_may_when_you_do_plain ::= "you" "may" reflexive_action "." reflexive_trigger

reflexive_action ::= optional_single_card_action | reflexive_counter_removal | variable_discard_reflexive | variable_filtered_discard_reflexive | variable_sacrifice_reflexive | reflexive_action_plain | reflexive_payment

/* @sem Vec<Instruction>::@single_reflexive_base($may_body) */
reflexive_action_plain ::= may_body

/* @sem Instruction::[Instruction::Effect{result:@next, operation:$reflexive_pay_operation}] */
reflexive_payment ::= reflexive_pay_operation

reflexive_pay_operation ::= reflexive_pay_life | reflexive_pay_mana | reflexive_pay_energy

/* @sem Operation::PayCost{player:AbilityController, cost:Cost::Cost{parts:[CostPart::Life($number)]}} */
reflexive_pay_life ::= "pay" number "life"

/* @sem Operation::PayCost{player:AbilityController, cost:$resolving_cost} */
reflexive_pay_mana ::= "pay" resolving_cost

/* Reuse the declared energy resource cost. The enclosing Optional and reflexive
   trigger still own the decision, actual performed result and announcement. */
/* @sem Operation::PayCost{player:AbilityController, cost:Cost::Cost{parts:[$cost_energy]}} */
reflexive_pay_energy ::= cost_energy

/* The payment belongs to the announced spell's controller. The countering
   action and its conditional result still belong to this ability. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf($target_stack_spell), cost:$counter_unless_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@next_slot, index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}] */
clause_counter_unless_plain ::= "counter" target_stack_spell "unless" "its" "controller" "pays" counter_unless_cost
/* "If a Dragon was beheld, counter that spell unless its controller pays {4} instead":
   the spell named earlier, and its controller, pay or lose it. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf($named_spell), cost:$counter_unless_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One($named_spell), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}] */
clause_counter_unless_named ::= "counter" named_spell "unless" "its" "controller" "pays" counter_unless_cost

/* "If they do" names the payment: paying spares the spell and earns the reward. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf($target_stack_spell), cost:$counter_unless_cost, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:$conjoined}, otherwise:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@next_slot, index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}}] */
clause_counter_unless_they_do ::= "counter" target_stack_spell "unless" "its" "controller" "pays" counter_unless_cost "." "if" "they" "do" "," conjoined

/* A targeted permanent's controller may pay to spare it from the action. The
   payment names the target the action announces next; a bare {X} is the
   announced value, as for a counter. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf(Target{slot:@next_slot, index:0}), cost:$counter_unless_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:$spared_action}]}, otherwise:Program{}}] */
clause_spared_unless_paid ::= spared_action "unless" "its" "controller" "pays" counter_unless_cost
spared_action ::= spared_tap | spared_destroy | spared_exile | spared_return
/* @sem Operation::SetTapped{objects:One($target_object), tapped:true} */
spared_tap ::= "tap" target_object
/* @sem Operation::Destroy{objects:One($target_object), regeneration:true} */
spared_destroy ::= "destroy" target_object
/* @sem Operation::Move{objects:One($target_object), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
spared_exile ::= "exile" target_object
/* @sem Operation::Move{objects:One($target_object), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
spared_return ::= "return" target_object "to" "its" "owner's" "hand"

/* "If that spell is countered this way, exile it instead of putting it into its owner's
   graveyard": where the counter puts the spell is part of the counter itself. */
/* @sem Instruction::[Effect{result:@next, operation:Counter{objects:One($target_stack_spell), destination:$countered_destination, destination_when:None}}] */
clause_counter_elsewhere ::= "counter" target_stack_spell "." countered_this_way countered_destination

/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf($target_stack_spell), cost:$counter_unless_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@next_slot, index:0}), destination:$countered_destination, destination_when:None}}]}, otherwise:Program{}}] */
clause_counter_unless_elsewhere ::= "counter" target_stack_spell "unless" "its" "controller" "pays" counter_unless_cost "." countered_this_way countered_destination

/* @sem () */
countered_this_way ::= "if" "that" "spell" "is" "countered" "this" "way" ","

countered_destination ::= countered_exile | countered_library_top | countered_library_bottom | countered_hand
/* @sem MovementDestination::Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}} */
countered_exile ::= "exile" "it" "instead" "of" "putting" "it" "into" "its" "owner's" "graveyard"
/* @sem MovementDestination::Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
countered_library_top ::= "put" "it" "on" "top" "of" "its" "owner's" "library" "instead" "of" "into" "that" "player's" "graveyard"
/* @sem MovementDestination::Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
countered_library_bottom ::= "put" "it" "on" "the" "bottom" "of" "its" "owner's" "library" "instead" "of" "into" "that" "player's" "graveyard"
/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
countered_hand ::= "put" "it" "into" "its" "owner's" "hand" "instead" "of" "into" "that" "player's" "graveyard"

reflexive_trigger ::= reflexive_trigger_plain | reflexive_trigger_if

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, announcement:@announcement, body:$reflexive_callback_program})} */
reflexive_trigger_plain ::= "when" "you" "do" "," reflexive_callback_program

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, condition:$condition, announcement:@announcement, body:$reflexive_callback_program})} */
reflexive_trigger_if ::= "when" "you" "do" "," "if" condition "," reflexive_callback_program


/* @sem Operation::@manifest_result(Operation::Manifest{actor:One(AbilityController), source:TopOfLibrary{player:$top_library_owner, count:Constant(1)}, cloak:false, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
manifest_one ::= "manifest" "the" "top" "card" "of" top_library_owner "library"
/* @sem Operation::@manifest_result(Operation::Manifest{actor:One(AbilityController), source:TopOfLibrary{player:$top_library_owner, count:Constant(1)}, cloak:true, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
cloak_one ::= "cloak" "the" "top" "card" "of" top_library_owner "library"

/* @sem Operation::@manifest_result(Operation::WithSelections{steps:[_{binding:@selection_id(0), objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), chooser:Players(One(AbilityController)), count:Exactly($card_count)}], action:Manifest{actor:One(AbilityController), source:Cards(Prepared(@selection_id(0))), cloak:false, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}) */
manifest_hand ::= "manifest" card_count "from" "your" "hand"
/* @sem Operation::@manifest_result(Operation::WithSelections{steps:[_{binding:@selection_id(0), objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), chooser:Players(One(AbilityController)), count:Exactly($card_count)}], action:Manifest{actor:One(AbilityController), source:Cards(Prepared(@selection_id(0))), cloak:true, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}) */
cloak_hand ::= "cloak" card_count "from" "your" "hand"

/* Optional damage keeps the decider outside the performing source. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:$recipients, amount:$value, preventable:true}}] */
clause_have_deal ::= "have" object_ref "deal" value "damage" "to" recipients

/* A written return operand retains its lexical binding position in seed compositions. */
event_return_object ::= object_ref

/* Returning a card after a departure reads the written operand in its event
   frame. Counter entries are attached to the incoming permanent. */
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[[$counter_kind, Constant(1)]], states:[]}}, qualifiers:[]} */
move_owner_counter_one ::= "return" affected "to" "the" "battlefield" "tapped" "under" owner_possessive "control" "with" "a" counter_kind "counter" "on" "it"
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[]}}, qualifiers:[]} */
move_owner_counter_untapped ::= "return" affected "to" "the" "battlefield" "under" owner_possessive "control" "with" "a" counter_kind "counter" "on" "it"
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set($affected)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[[$counter_kind, $number]], states:[]}}, qualifiers:[]} */
move_owner_counter_many ::= "return" affected "to" "the" "battlefield" "tapped" "under" owner_possessive "control" "with" number counter_kind "counters" "on" "it"

/* "Return it to the battlefield under its owner's control. It's an enchantment.": the
   returning card arrives with enchantment as its only card type. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$affected, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[Changes([SetCardTypes([Enchantment])])]}}, qualifiers:[]}}] */
clause_return_owner_as_enchantment ::= "return" affected "to" "the" "battlefield" "under" owner_possessive "control" "." "it's" "an" "enchantment"

/* A graveyard return tests the same new incarnation it will move. The binder
   supplies CR400.7f only in an enchanted-permanent departure scope. */
/* @sem ObjectRef::@return_ref($self_ref) */
returning_card_ref ::= self_ref

/* Explicit from-your-graveyard restrictions are resolution-time guards, before
   any optional return. They name the current card independently of its owner. */
/* @sem Instruction::[@resolution(Instruction::If{condition:ObjectMatches{object:$returning_card_ref, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One($returning_card_ref), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]}, otherwise:Program{}})] */
clause_graveyard_return_hand ::= "you" "may" "return" returning_card_ref "from" "your" "graveyard" "to" "your" "hand"

/* @sem Instruction::[@resolution(Instruction::If{condition:ObjectMatches{object:$returning_card_ref, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:One($returning_card_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{}})] */
clause_graveyard_return_battlefield ::= "return" returning_card_ref "from" "your" "graveyard" "to" "the" "battlefield"

/* @sem Instruction::[@resolution(Instruction::If{condition:ObjectMatches{object:$returning_card_ref, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One($returning_card_ref), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedToChosen(AllOf([CardType(Creature), Shares{property:CreatureTypes, with:EventSubject}]))]}}, qualifiers:[]}}]}}]}, otherwise:Program{}})] */
clause_graveyard_return_attached ::= "you" "may" "return" returning_card_ref "from" "your" "graveyard" "to" "the" "battlefield" "attached" "to" "a" "creature" "that" "shares" "a" "creature" "type" "with" "that" "creature"

/* The selected permanent's pre-sacrifice information is distinct from the card
   a later action can find. The binder proves scalar cardinality from this action. */
/* @sem @apply($players_singular, $sacrifice_choice_third) */
sacrifice_named_choice ::= players_singular sacrifice_choice_third

/* Secret ballot revelation follows all voters, with the ballot's typed kind. */
clause_secret_vote_reveal ::= secret_optional_object_vote_reveal | secret_player_vote_reveal | secret_other_player_vote_reveal | secret_word_vote_reveal

/* Complete the secret number choices before revealing that kind of choice.
   Keeping the sentences together establishes the revelation's antecedent. */
/* @sem Instruction::[...$secret_number_choices, Effect{result:@next, operation:RevealChoices{kind:Number}}] */
clause_secret_number_reveal ::= secret_number_choices "." "then" "those" "numbers" "are" "revealed"

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseValue{choosers:One(Bound(0)), kind:Number, terms:_{options:$secret_number_bounds, count:Exactly(Constant(1)), secret:true}}}]}}] */
secret_number_choices ::= players_singular "secretly" "chooses" secret_number_bounds

secret_number_bounds ::= secret_number_unrestricted | secret_number_minimum
/* @sem Vec<Operand>::[] */
secret_number_unrestricted ::= "a" "number"
/* @sem Vec<Operand>::[Comparison(GreaterOrEqual, $value)] */
secret_number_minimum ::= "a" "number" value "or" "greater"

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:Players(All), secret:true}}]}}, Effect{result:@next, operation:RevealChoices{kind:Player}}] */
secret_player_vote_reveal ::= players_singular "secretly" "votes" "for" "a" "player" "," "then" "those" "votes" "are" "revealed"

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:Players(OthersThan(Bound(0))), secret:true}}]}}, Effect{result:@next, operation:RevealChoices{kind:Player}}] */
secret_other_player_vote_reveal ::= players_singular "secretly" "votes" "for" "another" "player" "," "then" "those" "votes" "are" "revealed"

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:Words([Truth, Consequences]), secret:true}}]}}, Effect{result:@next, operation:RevealChoices{kind:Word}}] */
secret_word_vote_reveal ::= players_singular "secretly" "votes" "for" "truth" "or" "consequences" "," "then" "those" "votes" "are" "revealed"

/* The damage dealer is an object; the recipient is bound by this vote loop. */
/* @sem Instruction::[ForEachPlayer{players:Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:PlayerState{player:Bound(0), state:ReceivedAVote}}]), binding:0, body:_{instructions:[Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Union([Players(One(Bound(0))), Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))])})]), amount:Multiply($value, Votes(Player(Bound(0)))), preventable:true}}]}}] */
clause_vote_opponent_damage ::= "for" "each" "vote" "an" "opponent" "received" "," object_ref "deals" value "damage" "to" "that" "player" "and" "each" filter_phrase "that" "player" "controls"

/* @sem Instruction::[Effect{result:@next, operation:ChooseAtRandom(_{kind:Player, options:[Players(OpponentsOf(AbilityController))]})}, Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(One(Chosen)), amount:Multiply($value, Votes(Word(Consequences))), preventable:true}}] */
clause_chosen_vote_damage ::= "choose" "an" "opponent" "at" "random" "." object_ref "deals" value "damage" "to" "that" "player" "for" "each" "consequences" "vote"

/* The second-recipient rules start after the first target. Their slot reads
   precede their own target introduction and cannot capture that new target. */
clause_damage_parts ::= clause_damage_controlled_each | clause_damage_controlled_target
controller_damage_recipient ::= recipients_player_or_walker | recipients_opponent_or_walker

/* @sem Instruction::[Effect{result:@next, operation:DealDamageParts{source:$damage_source_ref, parts:[_{recipients:$controller_damage_recipient, amount:$number}, _{recipients:$controller_damage_each, amount:$number_2}], preventable:true}}] */
clause_damage_controlled_each ::= damage_source_ref "deals" number "damage" "to" controller_damage_recipient "and" number "damage" "to" controller_damage_each

/* @sem Instruction::[Effect{result:@next, operation:DealDamageParts{source:$damage_source_ref, parts:[_{recipients:$controller_damage_recipient, amount:$number}, _{recipients:$controller_damage_second_target, amount:$number_2}], preventable:true}}] */
clause_damage_controlled_target ::= damage_source_ref "deals" number "damage" "to" controller_damage_recipient "and" number "damage" "to" controller_damage_second_target

controller_damage_second_target ::= controller_damage_exact | controller_damage_up_to
/* @sem Recipients::Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:AllOf([$filter_head, ControlledBy(One(PlayerOrControllerOf(Targets(@last_slot))))])}), index:0})) */
controller_damage_exact ::= "target" filter_head "that" "player" "or" "that" "planeswalker's" "controller" "controls"
/* @sem Recipients::Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(Expr::Constant(1)), filter:AllOf([$filter_head, ControlledBy(One(PlayerOrControllerOf(Targets(@last_slot))))])}), index:0})) */
controller_damage_up_to ::= "up" "to" "one" "target" filter_head "that" "player" "or" "that" "planeswalker's" "controller" "controls"

/* @sem Recipients::Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_head, ControlledBy(One(PlayerOrControllerOf(Targets(@last_slot))))])}) */
controller_damage_each ::= "each" filter_head "that" "player" "or" "that" "planeswalker's" "controller" "controls"

/* Each mode owns its announced targets; the reflexive trigger shares only the parent result cursor. */
/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, announcement:Announcement{modes:$reflexive_mode_selection}, body:Program{}})} */
reflexive_trigger_modal ::= "when" "you" "do" "," reflexive_mode_selection

/* The final mode sentence also closes its enclosing reflexive-trigger program. */
program_sentence_reflexive_modal ::= program_sentence_may_reflexive_modal | program_sentence_required_reflexive_modal
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[...$reflexive_action, $reflexive_trigger_modal]}}]} */
program_sentence_may_reflexive_modal ::= "you" "may" reflexive_action "." reflexive_trigger_modal
/* @sem Program::Program{instructions:[...$reflexive_required, $reflexive_trigger_modal]} */
program_sentence_required_reflexive_modal ::= reflexive_required "." reflexive_trigger_modal

/* Reflexive modes own targets but allocate results after the performed action. */
reflexive_mode_selection ::= reflexive_choose_number | reflexive_choose_one_or_both | reflexive_choose_one_or_more
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$reflexive_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
reflexive_choose_number ::= "choose" number_words "—" NEWLINE reflexive_modes
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(2)}, options:$reflexive_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
reflexive_choose_one_or_both ::= "choose" "one" "or" "both" "—" NEWLINE reflexive_modes
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:@length($reflexive_modes)}, options:$reflexive_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
reflexive_choose_one_or_more ::= "choose" "one" "or" "more" "—" NEWLINE reflexive_modes
reflexive_modes ::= reflexive_modes_one | reflexive_modes_more
/* @sem Mode::[$reflexive_mode] */
reflexive_modes_one ::= reflexive_mode
/* @sem Mode::[$reflexive_mode, ...$reflexive_modes] */
reflexive_modes_more ::= reflexive_mode NEWLINE reflexive_modes
/* @sem @reflexive(Mode::Mode{announcement:@announcement, body:$program_sentence, weight:1}) */
reflexive_mode ::= "•" program_sentence

/* The discard wording names an actual preceding single-card discard, not an
   optional-payment decision or an unrelated earlier discard in game history. */
/* @sem Instruction::[...$discard_reflexive_action, $discard_reflexive_trigger] */
instructions_discard_reflexive ::= "you"? discard_reflexive_action "." discard_reflexive_trigger

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[...$discard_reflexive_action, $discard_reflexive_trigger]}}] */
instructions_may_discard_reflexive ::= "you" "may" discard_reflexive_action "." discard_reflexive_trigger

discard_reflexive_action ::= discard_reflexive_unfiltered | discard_reflexive_filtered

/* @sem Instruction::[Effect{result:@next, operation:Discard{players:One(AbilityController), amount:Constant(1)}}] */
discard_reflexive_unfiltered ::= "discard" "a" "card"

/* The filtered choice is not the performed discard receipt. The final Effect
   is DiscardObjects, so the existing reflexive owner reads that actual action.
   AsManyAsCan keeps an empty hand from inventing a successful discard. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}] */
discard_reflexive_filtered ::= "discard" ("a" | "an") card_filter "card"

discard_reflexive_trigger ::= discard_reflexive_plain | discard_reflexive_typed

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, announcement:@announcement, body:$discard_reflexive_body})} */
discard_reflexive_plain ::= "when" "you" "discard" "a" "card" ("this" "way")? "," discard_reflexive_body

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, condition:Compare{left:CountObjects(Matching{objects:Transition{result:@prior, phase:Before}, filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, announcement:@announcement, body:$discard_reflexive_body})} */
discard_reflexive_typed ::= "when" "you" "discard" ("a" | "an") card_filter "card" ("this" "way")? "," discard_reflexive_body

/* An explicit target supplies the continuation's object. General discarded-card
   anaphora remain outside this family until their producer focus is owned. */
discard_reflexive_body ::= discard_reflexive_counters | discard_reflexive_unblockable | discard_reflexive_damage

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[CounterPlacement::_{recipients:Objects(One($target_object)), kind:$counter_kind, amount:$counter_amount}]}}]} */
discard_reflexive_counters ::= "put" counter_amount counter_kind ("counter" | "counters") "on" target_object

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_object)), changes:[Rule(Prohibit(BeBlocked(Any)))], duration:EndOfTurn, evaluation:LiveObjects}}]} */
discard_reflexive_unblockable ::= target_object "can't" "be" "blocked" "this" "turn"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref, recipients:Objects(One($target_object)), amount:$number, preventable:true}}]} */
discard_reflexive_damage ::= self_ref "deals" number "damage" "to" target_object

/* A single discarded card supplies the property, even after the reflexive
   announces a new player target. The receipt is before the discard transition. */
/* @sem $discard_receipt_value_sequence */
instructions_discard_receipt_value ::= "you"? discard_receipt_value_sequence

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:$discard_receipt_value_sequence}}] */
instructions_may_discard_receipt_value ::= "you" "may" discard_receipt_value_sequence

/* @sem Instruction::[Effect{result:@mark, operation:Discard{players:One(AbilityController), amount:Constant(1)}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Mill{players:One($target_player), amount:ObjectProperty{object:Query{objects:Transition{result:@marked, phase:Before}, index:0}, property:$stat, information:CurrentOrLastKnown}}}]}})}] */
discard_receipt_value_sequence ::= "discard" "a" "card" "." "when" "you" "discard" "a" "card" ("this" "way")? "," target_player "mills" "cards" "equal" "to" "its" stat

clause_villainous_each ::= clause_villainous_each_grouped | clause_villainous_each_program

/* Each opponent chooses, while each option retains its own written performer.
   Local bound-player words cannot escape this loop or replace explicit you. */
/* @sem Instruction::[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseAction{actor:One(Bound(0)), options:[List([Program($villainous_option)]), List([Program($villainous_option_2)])], villainous:true}}]}}] */
clause_villainous_each_grouped ::= "each" "opponent" "faces" "a" "villainous" "choice" "—" villainous_option "," "or" villainous_option


/* Both native operand containers carry the same single program. Keep each
   typed form available; neither erases the villainous marker or its chooser. */
/* @sem Instruction::[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseAction{actor:One(Bound(0)), options:[Program($villainous_option), Program($villainous_option_2)], villainous:true}}]}}] */
clause_villainous_each_program ::= "each" "opponent" "faces" "a" "villainous" "choice" "—" villainous_option "," "or" villainous_option

villainous_option ::= villainous_discard_hand | villainous_hand_damage | villainous_sacrifice | villainous_each_damage | villainous_draw_chaos | villainous_you_option | villainous_opponent_option
/* @sem () */
villainous_opponent_words ::= "that" ("player" | "opponent")
/* @sem Program::Program{instructions:@apply(PlayerSet::One(PlayerRef::AbilityController), $verbs_base)} */
villainous_you_option ::= "you" verbs_base
/* @sem Program::Program{instructions:@apply(PlayerSet::One(PlayerRef::Bound(0)), $verbs_third)} */
villainous_opponent_option ::= villainous_opponent_words verbs_third
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Sacrifice{players:One(Bound(0)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$villainous_sacrifice_filter}, choose:AsManyAsCan($counter_amount)}}]} */
villainous_sacrifice ::= villainous_opponent_words "sacrifices" counter_amount villainous_sacrifice_filter "of" "their" "choice"
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Discard{players:One(Bound(0)), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any})}}, Effect{result:@next, operation:Draw{players:One(Bound(0)), amount:Subtract([CountObjects(MovedBy{result:@prior, phase:After, player:Bound(0)}), $value])}}]} */
villainous_discard_hand ::= villainous_opponent_words "discards" "all" "the" "cards" "in" "their" "hand" "," "then" "draws" "that" "many" "cards" "minus" value
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(One(Bound(0))), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), preventable:true}}]} */
villainous_hand_damage ::= "this" "creature" "deals" "damage" "to" villainous_opponent_words "equal" "to" "the" "number" "of" "cards" "in" "their" "hand"
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamageFromEach{sources:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, recipients:Players(One(Bound(0))), amount:$value}}]} */
villainous_each_damage ::= "each" filter_phrase "deals" value "damage" "to" villainous_opponent_words
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::ChaosEnsues}}]} */
villainous_draw_chaos ::= "you" "draw" card_count "and" "chaos" "ensues"


villainous_sacrifice_filter ::= filter_phrase | filter_plural

/* An "is" characteristic following a nontoken battlefield move applies as the
   object enters (CR 611.2e). It belongs to entry, before enters triggers see it;
   a later "becomes" stays a continuous effect. */
entry_subtype_instructions ::= entry_subtype_return | entry_subtype_put | entry_characteristics_move

/* @sem Instruction::[Effect{result:@next, operation:@arrival_changes($operation, $entry_characteristics)}] */
entry_characteristics_move ::= operation "." entry_characteristics

entry_characteristics ::= entry_subtype_changes | entry_color_subtype_changes | entry_colored_subtype_changes

/* @sem () */
entry_subject ::= "it's" | ("it" | "that" "creature") "is"

/* "Is black" sets its color; "a black Zombie in addition to its other colors" adds it. */
/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word]}, CreatureTypes{mode:Add, types:Listed($becomes_types)}] */
entry_color_subtype_changes ::= entry_subject mana_color_word "and" "is" ("a" | "an") becomes_types "in" "addition" "to" "its" "other" "creature" "types"

/* @sem Change::[Colors{mode:Add, colors:[$mana_color_word]}, CreatureTypes{mode:Add, types:Listed($becomes_types)}] */
entry_colored_subtype_changes ::= entry_subject ("a" | "an") mana_color_word becomes_types "in" "addition" "to" "its" "other" "colors" "and" "types"

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[Changes($entry_subtype_changes)]}}, qualifiers:[]}}] */
entry_subtype_return ::= "return" target_card "to" "the" "battlefield" "." entry_subtype_changes

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[Changes($entry_subtype_changes)]}}, qualifiers:[]}}] */
entry_subtype_put ::= "put" target_card "onto" "the" "battlefield" "under" "your" "control" "." entry_subtype_changes

/* @sem Change::[CreatureTypes{mode:Add, types:Listed($becomes_types)}] */
entry_subtype_changes ::= entry_subject ("a" | "an")? becomes_types "in" "addition" "to" "its" "other" ("creature")? "types"

/* Move an Aura to a different host sharing one of the printed host types.
   The destination is chosen on resolution, not a second announced target.
   Reusing the typed subject also keeps its slot local after earlier targets. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([AnyOf([CardType(Creature), CardType(Land)]), Not(SameObject($aura_retarget_previous_host)), SharesTypeFrom{types:[Creature, Land], with:$aura_retarget_previous_host}])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Attach{attachments:One($aura_retarget_subject), host:Result{result:@prior, phase:After, index:0}}}] */
clause_aura_retarget ::= "attach" aura_retarget_subject aura_retarget_previous_host
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Subtype(Aura), ObjectFilter::AttachedTo(InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([CardType(Creature), CardType(Land)])})))}), index:0} */
aura_retarget_subject ::= "target" "Aura" "attached" "to" "a" "creature" "or" "land"
/* The later host phrase reads the already introduced Aura, not a candidate
   destination. Its separate hole leaves only the subject as a target introduction. */
/* @sem ObjectRef::AttachedTo(@named_object) */
aura_retarget_previous_host ::= "to" "another" "permanent" "of" "that" "type"

/* One announced graveyard card supplies both alternative destinations. The
   condition names a separate object, even when it changes pronoun focus. */
/* @sem Instruction::[If{condition:ObjectMatches{object:$conditional_return_condition_ref, filter:$filter_head}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[ChooseOne{decider:AbilityController, options:[Program{instructions:[Effect{result:@next, operation:Move{objects:One($conditional_return_target), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, Program{instructions:[Effect{result:@next, operation:Move{objects:One($conditional_return_reference), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}]}]}}]}, otherwise:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One($conditional_return_reference), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]}}] */
conditional_card_return_clause ::= "you" "may" "return" conditional_return_target "to" "your" "hand" "." "if" conditional_return_condition_ref "is" "a" filter_head "," "you" "may" "return" conditional_return_reference "to" "the" "battlefield" "instead"

/* Both explicit filters are operands, not an inferred card name or slot. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($non_land, $card_permanent, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0} */
conditional_return_target ::= "target" non_land card_permanent "card" "from" "your" "graveyard"

/* Reference-only condition syntax introduces no slot between the initial card
   and this suffix. The allocated last slot therefore still names that card. */
conditional_return_condition_ref ::= it_ref | attached_ref | self_ref
/* @sem ObjectRef::Target{slot:@last_slot, index:0} */
conditional_return_reference ::= "that" "nonland" "permanent" "card"

/* Returning either domain is one ordinary Move. Other action families keep
   their own spell/permanent distinction rather than inheriting this target. */
/* @sem Operation::@owner_return(Operation::Move{objects:One($target_spell_or_noun), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}) */
move_mixed_target_hand ::= ("return" | "put") target_spell_or_noun ("to" | "into") owner_possessive ("hand" | "hands")

/* Resolution prose keeps the second cost verb lowercase. Both parts belong
   to the same optional payment; the sacrifice receipt is component one. */
/* @sem Cost::Cost{parts:[$cost_life, $cost_sacrifice]} */
resolution_life_sacrifice_cost ::= cost_life "," cost_sacrifice

/* The draw reads the actual removal receipt, never the initial counter count.
   Keep this two-action clause explicit rather than rebinding bare that-many
   after unrelated actions, token creation, or counter placements. */
/* @sem Instruction::[Effect{result:@mark, operation:$remove_counted_counters}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountersRemoved(@marked)}}] */
clause_remove_draw ::= remove_counted_counters "." "draw" "that" "many" "cards"

remove_counted_counters ::= remove_all_kind_counters | remove_exact_kind_counters | remove_any_kind_counters
/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:All}]} */
remove_all_kind_counters ::= "remove" "all" counter_kind "counters" "from" affected
/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:Count(Exactly($counter_amount))}]} */
remove_exact_kind_counters ::= "remove" counter_amount counter_kind ("counter" | "counters") "from" affected

/* Shared trailing quantity governs both actions and names this actual removal.
   The incomplete draw prefix is not an independent Oracle instruction. */
/* @sem Instruction::[Effect{result:@mark, operation:$remove_counted_counters}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountersRemoved(@marked)}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:CountersRemoved(@marked)}}] */
clause_remove_draw_lose ::= remove_counted_counters "." "you" "draw" "cards" "and" "lose" "life" "equal" "to" "the" "number" "of" "counters" "removed" "this" "way"

/* The permanent domain includes typeless permanents; the printed filter adds
   only actual restrictions, never an enumeration of current card types. */
/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}), amount:AmongThem(AnyNumber)}]} */
remove_any_kind_counters ::= "remove" "any" "number" "of" "counters" "from" "among" filter_plural "on" "the" "battlefield"

/* The where clause belongs to the eager positive branch, after the exact
   optional receipt. Both existing where mappings preserve their own timing. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:$paid_where_program, otherwise:Program{}}] */
/* @prefer always */
clause_if_you_do_where ::= "you" "may" payment "." "if" "you" "do" "," paid_where_program

paid_where_program ::= program_where | program_where_snapshot

/* A complete transfer introduces its singular source target before reading its
   slot in the recipient constraint. No standalone modifier guesses a referent. */
/* @sem Operation::MoveCounters{actor:One(AbilityController), from:One($target_permanent), to:One($same_controller_counter_target), kind:$counter_kind, amount:$same_controller_counter_amount} */
move_same_controller_counters ::= "move" same_controller_counter_amount counter_kind ("counter" | "counters") "from" target_permanent "onto" same_controller_counter_target

/* @sem MovedCounters::One */
same_controller_counter_one ::= "a"
/* @sem MovedCounters::AnyNumber */
same_controller_counter_any ::= "any" "number" "of"
/* @sem MovedCounters::All */
same_controller_counter_all ::= "all"
same_controller_counter_amount ::= same_controller_counter_one | same_controller_counter_any | same_controller_counter_all

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Not(SameObject(Target{slot:@last_slot, index:0})), $filter_phrase, ObjectFilter::ControlledBy(One(ControllerOf(Target{slot:@last_slot, index:0}))))}), index:0} */
same_controller_counter_target ::= "another" "target" filter_phrase "with" "the" "same" "controller"

/* Only the Aura is targeted. The new host is chosen on resolution relative to
   the current host, whose controller can differ from the Aura's controller. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$same_controller_attachment_host}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Attach{attachments:One($same_controller_aura_target), host:Result{result:@prior, phase:After, index:0}}}] */
clause_attach_same_controller ::= "attach" same_controller_aura_target same_controller_attachment_host

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Subtype(Aura), ObjectFilter::AttachedTo(InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:Any})))}), index:0} */
same_controller_aura_target ::= "target" "Aura" "attached" "to" "a" "permanent"

/* The later host phrase reads the already introduced Aura. */
/* @sem @and(ObjectFilter::Not(SameObject(AttachedTo(@named_object))), $filter_phrase, ObjectFilter::ControlledBy(One(ControllerOf(AttachedTo(@named_object))))) */
same_controller_attachment_host ::= "to" "another" filter_phrase "with" "the" "same" "controller"

/* A counter-unless bare {X} uses the announced value. A local scalar must
   supply its explicit definition, never ask the opponent to choose a new X. */
clause_counter_unless_pay ::= clause_counter_unless_plain | clause_counter_unless_named | clause_counter_unless_computed
counter_unless_cost ::= resolving_cost_announced | counter_unless_source_price | counter_unless_per_each

/* A price repeated for each counted object. */
/* @sem Cost::Cost{parts:[Repeated{part:Mana($mana_symbols), times:$count_each}]} */
counter_unless_per_each ::= mana_symbols "for" "each" count_each

/* Direct source quantities retain their supplied-cost representation. */
/* @sem Cost::@payment_cost(Cost::Cost{parts:[Mana($mana_symbols)]}, @inline_counter_price($counter_price_value)) */
counter_unless_source_price ::= mana_symbols "," "where" "X" "is" counter_price_value

/* Capture the explicitly computed payment price before asking its payer.
   Token-order binding introduces the spell target before the value's pronoun,
   although BindValue precedes PayCost in execution order. */
/* @sem Instruction::[Effect{result:@mark, operation:BindValue{value:@captured_counter_price($counter_price_value)}}, Effect{result:@next, operation:PayCost{player:ControllerOf($target_stack_spell), cost:@payment_cost(Cost::Cost{parts:[Mana($mana_symbols)]}, Expr::BoundValue(@marked)), optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@next_slot, index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}] */
clause_counter_unless_computed ::= "counter" target_stack_spell "unless" "its" "controller" "pays" mana_symbols "," "where" "X" "is" counter_price_value

/* Source-counter prices compose without relying on a learned scalar row.
   Explicit holder words preserve the holder/card-name distinction. */
counter_price_value ::= value | counter_price_source_counters
/* @sem Expr::CountCounters{recipients:Objects(One($self_ref_holder)), kind:$counter_kind, information:CurrentOrLastKnown} */
counter_price_source_counters ::= "the" "number" "of" counter_kind "counters" "on" self_ref_holder

/* The repeated connive wording names this exact scalar producer, not whichever
   unrelated operation most recently yielded a result. The continuation has its
   own source position, so producer target introductions bind before its scope. */
/* @sem Instruction::[$connive_receipt_producer, $connive_receipt_continuation] */
instructions_connive_reflexive ::= connive_receipt_producer "." connive_receipt_continuation

/* @sem Instruction::Effect{result:@mark, operation:Keyword{actor:One(ControllerOf($object_ref)), action:KeywordAction::Connive{object:$object_ref}}} */
connive_receipt_producer ::= object_ref "connives"

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$program})} */
connive_receipt_continuation ::= "when" "it" "connives" "this" "way" "," program

/* The compound cost has one chosen-payment receipt, including if drawing
   is replaced. Its conditional trigger closes over that exact payment. */
/* @sem Instruction::[...$hand_draw_reflexive_action, $hand_draw_reflexive_trigger] */
instructions_may_hand_draw_reflexive ::= "you" "may" hand_draw_reflexive_action "." hand_draw_reflexive_trigger

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$payment_hand_draw, optional:true}}] */
hand_draw_reflexive_action ::= payment_hand_draw

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$program})} */
hand_draw_reflexive_trigger ::= "when" "you" "do" "," program

/* A singular actual discard, not a payment choice, supplies the card property.
   Register its reflexive immediately; subsequent draw/seek remains in the parent.
   The target announcement belongs only to the reflexive ability. */
/* @sem Instruction::[...$discard_property_action, $discard_property_callback, ...$discard_property_tail] */
instructions_discard_property_tail ::= "you"? discard_property_action discard_property_tail "." discard_property_callback
/* @sem Instruction::[...$discard_property_action, $discard_property_callback] */
instructions_discard_property ::= "you"? discard_property_action "." discard_property_callback
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[...$discard_property_action, $discard_property_callback]}}] */
instructions_may_discard_property ::= "you" "may" discard_property_action "." discard_property_callback
/* @sem Instruction::[Effect{result:@mark, operation:Discard{players:One(AbilityController), amount:Constant(1)}}] */
discard_property_action ::= "discard" "a" "card"
discard_property_tail ::= discard_property_draw | discard_property_seek
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}] */
discard_property_draw ::= "," "then" "draw" card_count
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
discard_property_seek ::= "," "then" "seek" ("a" | "an") card_filter "card"
discard_property_callback ::= discard_property_plain | discard_property_typed
/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$discard_property_body})} */
discard_property_plain ::= "when" "you" "discard" "a" "card" "this" "way" "," discard_property_body
/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, announcement:@announcement, body:$discard_property_body})} */
discard_property_typed ::= "when" "you" "discard" ("a" | "an") card_filter "card" "this" "way" "," discard_property_body
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref, recipients:$recipients, amount:ObjectProperty{object:Query{objects:Transition{result:@marked, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown}, preventable:true}}]} */
discard_property_body ::= self_ref "deals" "damage" "equal" "to" discard_property_words "mana" "value" "to" recipients
/* @sem () */
discard_property_words ::= "the" "discarded" "card's" | "that" "card's"

/* A singular creature sacrifice supplies its immutable Before information.
   The callback owns its targets; conditional subtype tests read that same receipt. */
/* @sem Instruction::[...$sacrifice_creature_receipt, $sacrifice_value_callback] */
instructions_sacrifice_value ::= sacrifice_creature_receipt "." sacrifice_value_callback
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[...$sacrifice_creature_receipt, $sacrifice_value_callback]}}] */
instructions_may_sacrifice_value ::= "you" "may" sacrifice_creature_receipt "." sacrifice_value_callback
sacrifice_creature_receipt ::= sacrifice_value_one | sacrifice_value_another
/* @sem Instruction::[Effect{result:@mark, operation:Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:AsManyAsCan(Constant(1))}}] */
sacrifice_value_one ::= "sacrifice" "a" "creature"
/* @sem Instruction::[Effect{result:@mark, operation:Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), ObjectFilter::CardType(Creature))}, choose:AsManyAsCan(Constant(1))}}] */
sacrifice_value_another ::= "sacrifice" "another" "creature"
/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$sacrifice_value_body})} */
sacrifice_value_callback ::= "when" "you" "do" "," sacrifice_value_body
sacrifice_value_body ::= sacrifice_value_draw | sacrifice_value_instead
/* @sem Expr::ObjectProperty{object:Query{objects:Transition{result:@marked, phase:Before}, index:0}, property:$stat, information:CurrentOrLastKnown} */
sacrifice_before_stat ::= ("that" "creature's" | "the" "sacrificed" "creature's") stat
/* @sem Condition::Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$subtype}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
sacrifice_before_type ::= "the" "sacrificed" "creature" "was" ("a" | "an") subtype
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref, recipients:$recipients, amount:$sacrifice_before_stat, preventable:true}}, If{condition:$sacrifice_before_type, then:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$sacrifice_before_stat}}]}, otherwise:Program{}}]} */
sacrifice_value_draw ::= self_ref "deals" "X" "damage" "to" recipients "," "where" "X" "is" sacrifice_before_stat "." "if" sacrifice_before_type "," "draw" "X" "cards"
/* @sem Program::Program{instructions:[If{condition:$sacrifice_before_type, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref, recipients:$recipients, amount:Multiply([Constant(2), $sacrifice_before_stat]), preventable:true}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref_2, recipients:$recipients, amount:$sacrifice_before_stat, preventable:true}}]}}]} */
sacrifice_value_instead ::= self_ref "deals" "damage" "equal" "to" sacrifice_before_stat "to" recipients "." "if" sacrifice_before_type "," self_ref "deals" "twice" "that" "much" "damage" "instead"

/* A heterogeneous single target is selected while announcing this source cast
   trigger. Each implied alternative owns its target scope and removal receipt. */
/* @sem Ability::Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:$repeat_cast_header, limits:TriggerLimits{}, announcement:Announcement{modes:$mixed_remove_reduction_modes}, body:Program{}})} */
source_cast_mixed_counter_reduction ::= repeat_cast_header "," mixed_remove_reduction_modes

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:Any}), index:0})), amount:All}]}}, Effect{result:@next, operation:Operation::ChangeSpell{subject:Next{spells:Any, player:AbilityController, this_turn:true}, changes:[SpellCost(Reduce{reductions:[_{amount:@times($braced_amount, Expr::CountersRemoved(@marked))}], spill_into_generic:true})]}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Players(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:UpTo(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0})), amount:All}]}}, Effect{result:@next, operation:Operation::ChangeSpell{subject:Next{spells:Any, player:AbilityController, this_turn:true}, changes:[SpellCost(Reduce{reductions:[_{amount:@times($braced_amount, Expr::CountersRemoved(@marked))}], spill_into_generic:true})]}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied} */
mixed_remove_reduction_modes ::= "remove" "all" "counters" "from" "up" "to" "one" "target" "permanent" "or" "opponent" "." "the" "next" "spell" "you" "cast" "this" "turn" "costs" braced_amount "less" "to" "cast" "for" "each" "counter" "removed" "this" "way" "."

/* Damage.Source is the actual damage holder, including inside grants; it is
   not inferred from a new target or the card which created a granted ability. */
/* @sem Ability::Triggered{event:$mixed_counter_damage_header, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[$mixed_counter_put_completion, $mixed_counter_remove_reflexive]}} */
mixed_counter_damage_trigger ::= mixed_counter_damage_header "," mixed_counter_put_completion mixed_counter_remove_reflexive

/* @sem EventSpec::Damage{source_kind:Permanent, sources:SameObject($self_ref), recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source} */
mixed_counter_damage_header ::= ("when" | "whenever") self_ref "deals" "combat" "damage" "to" "a" "player"

/* @sem Instruction::Effect{result:@mark, operation:PutCounters{placements:[_{recipients:Objects(One(@remember_operand(ObjectRef::@it))), kind:$counter_kind, amount:$counter_amount}]}} */
mixed_counter_put_completion ::= "put" counter_amount counter_kind ("counter" | "counters") "on" "it" "."

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:Announcement{modes:$mixed_remove_optional_modes}, body:Program{}})} */
mixed_counter_remove_reflexive ::= "when" "you" "do" "," mixed_remove_optional_modes "."

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@reflexive(Mode::Mode{announcement:@announcement, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:Not(SameObject(@that_object))}), index:0})), amount:Count(Exactly(Constant(1)))}]}}]}}]}, weight:1}), @reflexive(Mode::Mode{announcement:@announcement, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Players(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0})), amount:Count(Exactly(Constant(1)))}]}}]}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied} */
mixed_remove_optional_modes ::= "you" "may" "remove" "a" "counter" "from" "another" "target" "permanent" "or" "opponent"

/* Both components are one resolving cost. A replaced draw counts as payment,
   while a prohibition makes the entire optional payment unavailable. */
/* @sem Cost::Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Discard{players:One(AbilityController), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), random:false}}]}}, Draw{count:$card_count}]} */
payment_hand_draw ::= "discard" "your" "hand" "and" "draw" card_count

/* A loop receipt belongs to one declared producer and its finite typed tails.
   Neither an unrelated preceding action nor a generic optional program can
   supply these references. The loop does not create a new result frame. */
clause_player_optional_receipts ::= player_counter_receipt_sequence | opponent_token_receipt_sequence | player_discard_receipt_sequence | opponent_investigate_receipt_sequence

/* @sem Instruction::[$player_counter_receipt_loop, $player_counter_receipt_goad] */
player_counter_receipt_sequence ::= player_counter_receipt_loop "." player_counter_receipt_goad

/* @sem Instruction::ForEachPlayer{players:$optional_player_population, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@mark, operation:$optional_player_counter_action}]}}]}} */
player_counter_receipt_loop ::= optional_player_population "may" optional_player_counter_action

optional_player_population ::= players_each | players_each_opponent

/* The action, chooser and controlled population all belong to the walked player.
   One creature is chosen at resolution, without introducing a target. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(Bound(0))))}), kind:$counter_kind, amount:$counter_amount, selection:_{player:Bound(0), count:AsManyAsCan(Constant(1))}}]} */
optional_player_counter_action ::= "put" counter_amount counter_kind ("counter" | "counters") "on" ("a" | "an") filter_phrase "they" "control"

/* Affected is the applied-counter receipt, not the offered or selected objects.
   The battlefield filter prevents a later incarnation from inheriting the goad. */
/* @sem Instruction::Effect{result:@next, operation:KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Goad{}, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::InSet(Affected(@marked)))}}} */
player_counter_receipt_goad ::= "goad" "each" filter_phrase "that" "had" "counters" "put" "on" "it" "this" "way"

/* A token offer uses its native optional payment. Its action allocates a
   distinct result in this ability; the marked outer PayCost names participation. */
/* @sem Instruction::[$opponent_token_receipt_loop, ...$opponent_token_receipt_tails] */
opponent_token_receipt_sequence ::= opponent_token_receipt_loop "." opponent_token_receipt_tails

/* @sem Instruction::ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:Bound(0), cost:Cost::Cost{parts:[PlayerAction{player:Bound(0), body:Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(Bound(0)), tokens:[$opponent_offer_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}]}, optional:true}}]}} */
opponent_token_receipt_loop ::= "each" "opponent" "may" "create" opponent_offer_token

/* A declared cardinal amount avoids a free-standing "that many" lookup in
   the middle of allocating this offer's outer and inner result addresses. */
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:Rules, recipe:$token_named_recipe} */
opponent_offer_token ::= counter_amount token_named_recipe ("token" | "tokens")

opponent_token_receipt_tails ::= opponent_token_receipt_bonus_only | opponent_receipt_negative_only | opponent_receipt_negative_bonus | opponent_token_receipt_bonus_negative
/* @sem Instruction::[$opponent_token_receipt_bonus] */
opponent_token_receipt_bonus_only ::= opponent_token_receipt_bonus
/* @sem Instruction::[$opponent_receipt_negative] */
opponent_receipt_negative_only ::= opponent_receipt_negative
/* @sem Instruction::[$opponent_receipt_negative, $opponent_token_receipt_bonus] */
opponent_receipt_negative_bonus ::= opponent_receipt_negative "." opponent_token_receipt_bonus
/* @sem Instruction::[$opponent_token_receipt_bonus, $opponent_receipt_negative] */
opponent_token_receipt_bonus_negative ::= opponent_token_receipt_bonus "." opponent_receipt_negative

/* Participation counts players, independently of the inner creation amount. */
/* @sem Instruction::Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:@times($counter_amount, Expr::CountPlayers(Matching{binding:0, condition:PlayerTook{player:Bound(0), result:@marked}})), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}} */
opponent_token_receipt_bonus ::= "for" "each" "opponent" "who" "does" "," "you" "create" counter_amount token_named_recipe ("token" | "tokens")

/* The complement is relative to the original opponents. It never includes the
   controller or a player who was not offered the action. */
/* @sem Instruction::Effect{result:@next, operation:LoseLife{players:Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Not(PlayerTook{player:Bound(0), result:@marked})}]), amount:$number}} */
opponent_receipt_negative ::= "each" "opponent" "who" "doesn't" "loses" number "life"

/* Actual discarded cards and participation are separate receipt views. A player
   who chose an empty discard did not discard a card; later type tests read the
   aggregate Before snapshots, even after intervening draws or token creation. */
/* @sem Instruction::[$player_discard_receipt_loop, ...$player_discard_receipt_tails] */
player_discard_receipt_sequence ::= player_discard_receipt_loop "." player_discard_receipt_tails

/* @sem Instruction::ForEachPlayer{players:All, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@mark, operation:Discard{players:One(Bound(0)), amount:$card_count, random:false}}]}}]}} */
player_discard_receipt_loop ::= "each" "player" "may" "discard" card_count

player_discard_receipt_tails ::= player_discard_receipt_draw_only | player_discard_receipt_draw_conditions
/* @sem Instruction::[$player_discard_receipt_draw] */
player_discard_receipt_draw_only ::= player_discard_receipt_draw
/* @sem Instruction::[$player_discard_receipt_draw, ...$player_discard_receipt_conditions] */
player_discard_receipt_draw_conditions ::= player_discard_receipt_draw "." player_discard_receipt_conditions

/* @sem Instruction::Effect{result:@next, operation:Draw{players:Matching{binding:0, condition:Compare{left:CountObjects(MovedBy{result:@marked, phase:After, player:Bound(0)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}, amount:$card_count}} */
player_discard_receipt_draw ::= "each" "player" "who" "discarded" "a" "card" "this" "way" "draws" card_count

player_discard_receipt_conditions ::= player_discard_receipt_create_only | player_discard_receipt_counters_only | player_discard_receipt_create_counters | player_discard_receipt_counters_create
/* @sem Instruction::[$player_discard_receipt_create] */
player_discard_receipt_create_only ::= player_discard_receipt_create
/* @sem Instruction::[$player_discard_receipt_counters] */
player_discard_receipt_counters_only ::= player_discard_receipt_counters
/* @sem Instruction::[$player_discard_receipt_create, $player_discard_receipt_counters] */
/* @prefer always */
player_discard_receipt_create_counters ::= player_discard_receipt_create "." "then"? player_discard_receipt_counters
/* @sem Instruction::[$player_discard_receipt_counters, $player_discard_receipt_create] */
/* @prefer always */
player_discard_receipt_counters_create ::= player_discard_receipt_counters "." "then"? player_discard_receipt_create

/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$discard_receipt_bonus_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{}} */
player_discard_receipt_create ::= "if" ("a" | "an") card_filter "card" "was" "discarded" "this" "way" "," "you" "create" discard_receipt_bonus_token

/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:$discard_receipt_bonus_counters}]}, otherwise:Program{}} */
player_discard_receipt_counters ::= "if" ("a" | "an") card_filter "card" "was" "discarded" "this" "way" "," discard_receipt_bonus_counters

/* These bonus leaves exclude generic "that many" / "for each ... this way"
   amount shortcuts, whose older @prior address would name the intervening draw.
   The declared discard receipt remains the only source for the outer guards. */
discard_receipt_bonus_token ::= discard_receipt_bonus_defined | discard_receipt_bonus_named
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:$token_recipe} */
discard_receipt_bonus_defined ::= counter_amount token_recipe
/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:Rules, recipe:$token_named_recipe} */
discard_receipt_bonus_named ::= counter_amount token_named_recipe ("token" | "tokens")

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_head, ObjectFilter::ControlledBy(One(AbilityController)))}), kind:$counter_kind, amount:$counter_amount}]} */
discard_receipt_bonus_counters ::= "put" counter_amount counter_kind ("counter" | "counters") "on" "each" filter_head "you" "control"

/* Investigation is an optional action, not the token offer's PlayerAction
   payment. The shared negative consumer still complements only opponents. */
/* @sem Instruction::[$opponent_investigate_receipt_loop, $opponent_receipt_negative, $opponent_investigate_receipt_bonus] */
opponent_investigate_receipt_sequence ::= opponent_investigate_receipt_loop "." opponent_receipt_negative "." opponent_investigate_receipt_bonus

/* @sem Instruction::ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@mark, operation:Keyword{actor:One(Bound(0)), action:KeywordAction::Investigate{}}}]}}]}} */
opponent_investigate_receipt_loop ::= "each" "opponent" "may" "investigate"

/* The amount counts participating opponents, not Clues produced. Its offset
   remains a current operand; X is defined by this exact ordinary continuation. */
/* @sem Instruction::Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Investigate{times:Add([$opponent_investigate_receipt_offset, Expr::CountPlayers(Matching{binding:0, condition:PlayerTook{player:Bound(0), result:@marked}})])}}} */
opponent_investigate_receipt_bonus ::= "you" "investigate" "X" "times" "," "where" "X" "is" opponent_investigate_receipt_offset "plus" "the" "number" "of" "opponents" "who" "investigated" "this" "way"

opponent_investigate_receipt_offset ::= number_digits | number_words

/* A resolution choice is not the actual discard receipt. A zero selection
   performs no discard and does not fire the reflexive, like declining. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, count:AnyNumber}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}] */
variable_discard_reflexive ::= "discard" "any" "number" "of" "cards"
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AnyNumber}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}] */
variable_filtered_discard_reflexive ::= "discard" "one" "or" "more" card_filter "cards"
/* @sem Instruction::[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:AnyNumber}}] */
variable_sacrifice_reflexive ::= "sacrifice" "one" "or" "more" filter_plural

/* Exclusive alternatives share the targeted action, not a callback receipt.
   Each option binds its own result and reflexive target announcement. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[@reflexive(Program::Program{instructions:[Effect{result:@next, operation:$callback_either_operation}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$callback_either_effect}]}})}]}), @reflexive(Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$cost, optional:false}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$callback_either_effect}]}})}]}), Program{}]}] */
instructions_may_either_when_you_do ::= "you" "may" callback_either_operation "or" "pay" cost "." "when" "you" "do" "," callback_either_effect

callback_either_effect ::= callback_either_tap | callback_either_destroy
/* @sem Operation::SetTapped{objects:One($target_object), tapped:true} */
callback_either_tap ::= "tap" target_object
/* @sem Operation::Destroy{objects:One($target_object), regeneration:true} */
callback_either_destroy ::= "destroy" target_object

callback_either_operation ::= callback_sacrifice_operation | callback_discard_operation
/* @sem Operation::Discard{players:One(AbilityController), amount:$card_count, random:false} */
callback_discard_operation ::= "discard" card_count

/* @sem Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Constant(1))} */
callback_sacrifice_operation ::= "sacrifice" ("a" | "an") filter_phrase


reflexive_callback_program ::= callback_counter_keyword_program | program | callback_named_hand_program | callback_flashback_program

/* Each instruction retains its lexical position: the possessive discard
   follows the target-player announcement introduced by the reveal clause. */
/* @sem Program::Program{instructions:[$callback_choose_name, $callback_hand_reveal, $callback_named_discard]} */
callback_named_hand_program ::= callback_choose_name "," "then" callback_hand_reveal "and" callback_named_discard

/* @sem Instruction::Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:CardName, terms:_{count:Exactly(Constant(1)), options:[$card_name_option]}}} */
callback_choose_name ::= "choose" card_name_option

/* @sem Instruction::Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($callback_hand_player)}, kind:Card, filter:Any}}} */
callback_hand_reveal ::= callback_hand_player "reveals" "their" "hand"

/* @sem Instruction::Effect{result:@next, operation:DiscardObjects{objects:Zone{scope:Players{zone:Hand, players:One(@that_player)}, kind:Card, filter:Chosen(CardName)}}} */
callback_named_discard ::= "discards" "all" "cards" "with" "that" "name"

callback_hand_player ::= target_player | target_opponent
/* A card name to choose: any Oracle card's, or one of a card type, of two
   card types at once, or of a nonbasic land. */
card_name_option ::= card_name_other_than_kind | card_name_any | card_name_typed
/* @sem Operand::Term{family:CardsInOracle, form:AnyOracleCard} */
card_name_any ::= "a" "card" "name"
/* @sem $card_name_kind */
card_name_typed ::= ("a" | "an") card_name_kind "card" "name"
card_name_kind ::= card_name_basic_land | card_name_type | card_name_nonbasic_land | card_name_two_types
/* @sem Operand::Term{family:CardsInOracle, form:And, operands:[$card_name_type, $card_name_type_2]} */
card_name_two_types ::= card_name_type "," card_name_type
/* @sem Operand::Term{family:CardsInOracle, form:And, operands:[Term{family:CardsInOracle, form:IsNonSupertype, operands:[Vocabulary{family:SuperType, form:Basic}]}, Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Land}]}]} */
card_name_nonbasic_land ::= "nonbasic" "land"
card_name_type ::= card_name_artifact | card_name_creature | card_name_nonartifact | card_name_noncreature | card_name_nonland
/* @sem Operand::Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Artifact}]} */
card_name_artifact ::= "artifact"
/* @sem Operand::Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Creature}]} */
card_name_creature ::= "creature"
/* @sem Operand::Term{family:CardsInOracle, form:IsNonCardtype, operands:[Vocabulary{family:CardType, form:Artifact}]} */
card_name_nonartifact ::= "nonartifact"
/* @sem Operand::Term{family:CardsInOracle, form:IsNonCardtype, operands:[Vocabulary{family:CardType, form:Creature}]} */
card_name_noncreature ::= "noncreature"
/* @sem Operand::Term{family:CardsInOracle, form:IsNonCardtype, operands:[Vocabulary{family:CardType, form:Land}]} */
card_name_nonland ::= "nonland"

/* The written fighter and its counterpart retain distinct lexical roles. A
   reflexive callback can act on the actual scalar battlefield-move receipt; a
   newly announced fighter does not shadow an earlier named opposing creature. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:ObjectRef::@reflexive_moved_fight_object($object_ref), second:ObjectRef::@fight_prior_counterpart($object_ref_2)}} */
fight_action ::= ("then")? object_ref "fights" object_ref

/* An explicitly acted-on combat object remains the following pronoun's focus. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RemoveFromCombat{object:ObjectRef::@remember_object($object_ref)}} */
remove_from_combat_action ::= "remove" object_ref "from" "combat"

/* A singular graveyard target produces one exile transition. The passive
   creature/card condition examines that actual moved object's before image;
   it never treats an unrelated earlier action as an exile receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, $passive_exiled_card_trigger] */
instructions_exile_passive_card ::= "exile" target_card "." passive_exiled_card_trigger

/* Keep the callback's lexical origin at When, after the parent's target. */
/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, condition:Compare{left:CountObjects(Matching{objects:Transition{result:@prior, phase:After}, filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, announcement:@announcement, body:$reflexive_callback_program})} */
passive_exiled_card_trigger ::= "when" ("a" | "an") card_filter "card" "is" "exiled" "this" "way" "," reflexive_callback_program

/* One-or-more cards is a single callback for this mill action, not one
   callback per milled card. The header is not registered independently. */
/* @sem Instruction::[Effect{result:@next, operation:Mill{players:OpponentsOf(AbilityController), amount:$card_count}}, $passive_milled_batch_trigger] */
instructions_opponents_mill_passive ::= "each" "opponent" "mills" card_count "." passive_milled_batch_trigger

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, announcement:@announcement, body:$reflexive_callback_program})} */
passive_milled_batch_trigger ::= "when" "one" "or" "more" "cards" "are" "milled" "this" "way" "," reflexive_callback_program

/* The comparison belongs to the card being announced, while the reference
   value belongs to the explicitly named spell, not to that target card. */
/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:ObjectProperty{object:$object_ref, property:ManaValue, information:CurrentOrLastKnown}}}, InZone(Players{zone:Graveyard, players:OpponentsOf(AbilityController)})])}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_card_no_greater_than_spell ::= "exile" "target" card_filter "card" "with" "equal" "or" "lesser" "mana" "value" "than" object_ref "from" "an" "opponent's" "graveyard"

/* @sem Instruction::[Effect{result:@next, operation:$exile_card_no_greater_than_spell}] */
clause_exile_card_no_greater_than_spell ::= exile_card_no_greater_than_spell

/* The copy is made from this clause's actual exile result; the optional cast
   consumes the copy result. This is not a normal-cost cast or Source query. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_card_no_greater_than_spell}, ...$copy_exiled_free_continuation] */
instructions_exile_compare_copy_free ::= exile_card_no_greater_than_spell "." copy_exiled_free_continuation

/* @sem Instruction::[Effect{result:@next, operation:CopyCards{actor:One(AbilityController), objects:One(Result{result:@prior, phase:After, index:0}), times:Constant(1)}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Copies(@prior), count:Exactly(Constant(1)), cost:Free}}]}}] */
copy_exiled_free_continuation ::= "copy" "the" "exiled" "card" "." "you" "may" "cast" "the" "copy" "without" "paying" "its" "mana" "cost"

/* Each written producer draws one card. Scoped pairs preserve two actual
   receipts; the Optional owns both another player's draw and callback.
   Reuse only an operation payload, never result-bearing callback instructions. */
/* @sem Instruction::[Effect{result:@mark, operation:Draw{players:One(AbilityController), amount:Constant(1)}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$shared_single_draw_damage}]}})}, ForEachPlayer{players:OthersThan(AbilityController), binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:@reflexive(Program::Program{instructions:[Effect{result:@mark, operation:Draw{players:One(Bound(0)), amount:Constant(1)}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$shared_single_draw_damage}]}})}]})}]}}] */
instructions_shared_single_draw_callback ::= "draw" "a" "card" "," "then" "each" "other" "player" "may" "draw" "a" "card" "." shared_single_draw_damage

/* @sem $passive_random_damage_operation */
shared_single_draw_damage ::= "whenever" "a" "card" "is" "drawn" "this" "way" "," passive_random_damage_operation

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController), constraints:[AtRandom]}), index:0} */
passive_random_target_opponent ::= "target" "opponent" "chosen" "at" "random" "from" "among" "your" "opponents"

/* @sem Operation::DealDamage{source:$object_ref, recipients:Players(One($passive_random_target_opponent)), amount:$number, preventable:true} */
passive_random_damage_operation ::= object_ref "deals" number "damage" "to" passive_random_target_opponent

/* @sem Instruction::[Effect{result:@next, operation:$passive_random_damage_operation}] */
clause_passive_random_damage ::= passive_random_damage_operation

/* The written failure action belongs to unless. The following paid clause
   supplies only success; the fused form names this exact immutable payment receipt.
   Keep success atomic so an independent later sentence cannot be captured. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:$paid_success_operation}]}, otherwise:Program{instructions:[Effect{result:@next, operation:$operation}]}}] */
clause_unless_pay_followup ::= operation "unless" "you" payment "." "if" "you" "pay" "," paid_success_operation


paid_success_operation ::= paid_success_damage_all | paid_success_draw | paid_success_life

/* @sem Operation::DealDamage{source:$object_ref, recipients:Union([Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}), Players(All)]), amount:$value, preventable:true} */
paid_success_damage_all ::= object_ref "deals" "damage" "equal" "to" value "to" "each" filter_phrase "and" "each" "player"

/* @sem Operation::Draw{players:One(AbilityController), amount:Constant(1)} */
paid_success_draw ::= "draw" "a" "card"

/* @sem Operation::GainLife{players:One(AbilityController), amount:$number} */
paid_success_life ::= "gain" number "life"

/* A resolving choice between two battlefield query sweeps. Neither option
   introduces targets or admits an arbitrary multi-instruction program. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[Program{instructions:[Effect{result:@next, operation:SetTapped{objects:$query_tap_sweep, tapped:true}}]}, Program{instructions:[Effect{result:@next, operation:SetTapped{objects:$query_tap_sweep_2, tapped:false}}]}]}] */
clause_query_tap_or_untap ::= "tap" query_tap_sweep "or" "untap" query_tap_sweep
query_tap_sweep ::= objects_all_sharing | objects_all | objects_each

/* A literal zero-or-one card slot also has a complete chosen-set view.
   The indexed view remains available; wider or unknown bounds do not enter. */
/* @sem Operation::Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:Any})), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_optional_graveyard_card_set ::= "exile" "up" "to" ("one" | "1") "target" "card" "from" "a" "graveyard"

/* The producer is marked before an intervening play permission. The native
   callback is installed from that actual action, not the latest effect. */
/* @prefer always */
/* @sem Instruction::[...$card_exile_value_producer, $card_exile_value_reflexive, ...$card_exile_play_permission] */
instructions_exile_card_value_reflexive ::= card_exile_value_producer "." card_exile_play_permission "." card_exile_value_reflexive

/* @sem Instruction::[...$card_exile_value_producer, Effect{result:@next, operation:DealDamage{source:$self_ref, recipients:Players(One(AbilityController)), amount:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}, preventable:true}}, ...$card_exile_play_permission] */
instructions_exile_card_damage_permission ::= card_exile_value_producer "." self_ref "deals" "damage" "to" "you" "equal" "to" "that" "card's" "mana" "value" "." card_exile_play_permission

/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
card_exile_value_producer ::= "exile" "the" "top" "card" "of" "your" "library"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}] */
card_exile_play_permission ::= "you" "may" "play" ("it" | "that" "card") this_duration

/* The following permission is a dependent continuation of this actual exile,
   including when the whole unit is inside a conditional. */
/* @sem Instruction::[...$card_exile_value_producer, Effect{result:@next, operation:$play_that_card_permission}] */
conditional_top_card_permission ::= card_exile_value_producer "." play_that_card_permission

/* A random opponent is chosen before damage, independently of its source. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseAtRandom{kind:Player, options:[Players(OpponentsOf(AbilityController))]}}, Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(One(Chosen)), amount:$value, preventable:true}}] */
clause_random_opponent_damage ::= object_ref "deals" value "damage" "to" "an" "opponent" "chosen" "at" "random"

/* A Curse moves on: the random opponent is chosen among the others before it attaches. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseAtRandom{kind:Player, options:[Players(Intersection([OthersThan(EnchantedBy(Source)), OpponentsOf(AbilityController)]))]}}, Effect{result:@next, operation:AttachEach{actor:One(AbilityController), attachments:One($object_ref), hosts:Players(One(Chosen)), each_host:false}}] */
clause_attach_random_opponent ::= "attach" object_ref "to" "another" "one" "of" "your" "opponents" "chosen" "at" "random"

card_exile_value_reflexive ::= card_exile_plain_value_reflexive | card_exile_filtered_value_reflexive

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, announcement:@announcement, body:$card_exile_value_damage})} */
card_exile_filtered_value_reflexive ::= "when" "you" "exile" ("a" | "an") card_filter "card" "this" "way" "," card_exile_value_damage

/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref, recipients:$recipients, amount:Aggregate{objects:Transition{result:@marked, phase:After}, property:ManaValue, aggregation:Sum}, preventable:true}}]} */
card_exile_value_damage ::= self_ref "deals" "damage" "equal" "to" "the" "exiled" "card's" "mana" "value" "to" recipients

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$card_exile_value_pump})} */
card_exile_plain_value_reflexive ::= "when" "you" "exile" "a" "card" "this" "way" "," card_exile_value_pump

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_permanent)), changes:[Pump{power:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}, toughness:Constant(0)}], duration:EndOfTurn, evaluation:Snapshot}}]} */
card_exile_value_pump ::= target_permanent "gets" "+X/+0" "until" "end" "of" "turn" "," "where" "X" "is" "that" "card's" "mana" "value"

/* The two written filters must denote the same unique stopping card.
   Snapshot before reorder; callback reads only that captured value. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:@agree($card_filter, $card_filter_2), count:Constant(1)}}, Effect{result:@next, operation:BindValue{value:ObjectProperty{object:Query{objects:Matching{objects:Observed(@marked), filter:@agree($card_filter, $card_filter_2)}, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:Random}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:@agree($card_filter, $card_filter_2)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, announcement:@announcement, body:$card_reveal_value_damage})}] */
instructions_reveal_card_value_reflexive ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" ("a" | "an") card_filter "card" "." "put" "the" "revealed" "cards" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order" "." "when" "you" "reveal" ("a" | "an") card_filter "card" "this" "way" "," card_reveal_value_damage

/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref, recipients:$recipients, amount:BoundValue(@back(4)), preventable:true}}]} */
card_reveal_value_damage ::= self_ref "deals" "damage" "equal" "to" "that" "card's" "mana" "value" "to" recipients

/* Same unique stop/header card; snapshot precedes its move and rest reorder. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:@agree($card_filter, $card_filter_2), count:Constant(1)}}, Effect{result:@next, operation:BindValue{value:ObjectProperty{object:Query{objects:Matching{objects:Observed(@marked), filter:@agree($card_filter, $card_filter_2)}, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:@agree($card_filter, $card_filter_2)}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Random}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:@agree($card_filter, $card_filter_2)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, announcement:@announcement, body:$card_reveal_value_counters})}] */
instructions_reveal_move_card_value_reflexive ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" ("a" | "an") card_filter "card" "." "put" "that" "card" "into" "your" "hand" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order" "." "when" "you" "reveal" ("a" | "an") card_filter "card" "this" "way" "," card_reveal_value_counters

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($target_permanent)), kind:$counter_kind, amount:BoundValue(@back(5))}]}}]} */
card_reveal_value_counters ::= "put" "X" counter_kind "counters" "on" target_permanent "," "where" "X" "is" "the" "mana" "value" "of" "that" "card"

/* A resolving "if you do" payment selects one physical card before moving it.
   Choosing no card is declining the optional cost, not paying an empty effect. */
/* @sem Cost::Cost{parts:[Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$a_card}, choose:Exactly(Constant(1))}], destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
payment_put_hand_card ::= "put" a_card "from" "your" "hand" "onto" "the" "battlefield"

/* A fixed positive whole-card selection is available only with that many
   physical graveyard cards. The callback announces targets after the exile
   action, using that actual move's receipt rather than the selection result. */
/* @sem Instruction::[@resolution(Instruction::If{condition:Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$exile_positive_card_count}}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}, count:AsManyAsCan($exile_positive_card_count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, $reflexive_trigger]}}]}, otherwise:Program{}})] */
instructions_may_exile_exact_reflexive ::= "you" "may" "exile" exile_positive_card_count "from" "your" "graveyard" "." reflexive_trigger

exile_positive_card_count ::= card_count_one | exile_positive_cards
/* @sem $count_plural */
exile_positive_cards ::= count_plural "cards"

/* A strict optional PlayerAction payment encloses the actual discard callback.
   Failure to choose payment alone causes the independent sacrifice. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Discard{players:One(AbilityController), amount:Constant(1), random:false}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One($discard_mana_value_target), regeneration:true}}]}})}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:One($self_explicit_ref)}}]}, otherwise:Program{instructions:[]}}] */
instructions_sacrifice_unless_discard_callback ::= "sacrifice" self_explicit_ref "unless" "you" "discard" "a" "card" "." "when" "you" "discard" "a" "card" "this" "way" "," "destroy" discard_mana_value_target
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf(@unordered([ControlledBy(OpponentsOf(AbilityController)), Not(CardType(Land)), Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:ObjectProperty{object:Query{objects:Transition{result:@reflexive_performed, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}]))}), index:0} */
discard_mana_value_target ::= "target" "nonland" "permanent" "an" "opponent" "controls" "with" "mana" "value" "less" "than" "or" "equal" "to" "the" "mana" "value" "of" "the" "discarded" "card"

/* The optional arbitrary-size choice and its discard are one producer group;
   the callback counts actual Before discard objects, never the selection. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AnyNumber}}, Effect{result:@mark, operation:DiscardObjects{objects:Selected(@prior)}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:$recipients, amount:Multiply([$discard_damage_multiplier, CountObjects(Transition{result:@reflexive_performed, phase:Before})]), preventable:true}}]}})}]}}] */
instructions_optional_plural_discard_callback ::= "you" "may" "discard" "any" "number" "of" card_filter "cards" "." "when" "you" "discard" "one" "or" "more" "cards" "this" "way" "," self_explicit_ref "deals" discard_damage_multiplier "that" "much" "damage" "to" recipients
discard_damage_multiplier ::= discard_damage_twice | discard_damage_times
/* @sem Expr::Constant(2) */
discard_damage_twice ::= "twice"
/* @sem $number */
discard_damage_times ::= number "times"

/* The explicit paid-action paragraph owns selection and play permission. A
   declined discard supplies neither the exile receipt nor a usable card. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost::Cost{parts:[$impulse_discard_part]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[$paid_impulse_exile, $paid_impulse_choose, ...$card_exile_play_permission]}, otherwise:Program{}}] */
instructions_paid_impulse_choice ::= "you" "may" impulse_discard_part "." "if" "you" "do" "," paid_impulse_exile "," "then" paid_impulse_choose "." card_exile_play_permission

impulse_discard_part ::= cost_discard | cost_discard_many

/* @sem Instruction::Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:$card_count, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}} */
paid_impulse_exile ::= "exile" "the" "top" card_count "of" "your" "library"

/* Mark this zero-or-one choice independently of the exile. Permission names
   its selected card, never all exiled cards or the later permission effect. */
/* @sem Instruction::Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Transition{result:@prior, phase:After}, count:AsManyAsCan(Constant(1))}} */
paid_impulse_choose ::= "choose" "one" "of" "them"

/* Three independently chosen cards remain separate receipts until their one
   simultaneous return. Discard history follows replacements, not a fresh zone. */
/* @sem Instruction::[Effect{result:@mark, operation:Discard{players:One(AbilityController), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountObjects(Transition{result:@marked, phase:Before})}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Recorded(@marked), filter:@and($filter_phrase, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:$number}})}, count:Exactly(Constant(1))}}]}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Recorded(@marked), filter:@and($filter_phrase_2, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:$number_2}})}, count:Exactly(Constant(1))}}]}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Recorded(@marked), filter:@and($filter_phrase_2, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:$number_3}})}, count:Exactly(Constant(1))}}]}}, Effect{result:@next, operation:Move{objects:Union([Selected(@back(4)), Selected(@back(3)), Selected(@prior)]), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
instructions_discard_triple_return ::= "discard" triple_return_hand "," "then" "draw" "that" "many" "cards" "." "you" "may" "choose" ("a" | "an") filter_phrase "card" "with" "mana" "value" number "you" "discarded" "this" "way" "," "then" "do" "the" "same" "for" filter_phrase "cards" "with" "mana" "values" number "and" number "." "return" "those" "cards" "to" "the" "battlefield"
/* @sem () */
triple_return_hand ::= "your" "hand" | "all" "the" "cards" "in" "your" "hand"

/* Own the single physical top-card receipt across an intervening property action. */
/* @sem Instruction::[...$card_exile_value_producer, ...$receipt_span_permission] */
instructions_exile_receipt_plain ::= card_exile_value_producer "." receipt_span_permission

/* @sem Instruction::[...$card_exile_value_producer, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}, ...$receipt_span_permission] */
/* @prefer always */
instructions_exile_receipt_life ::= card_exile_value_producer "." "you" "lose" "life" "equal" "to" "its" "mana" "value" "." receipt_span_permission

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:$receipt_span_duration, evaluation:LiveObjects}}] */
receipt_span_permission ::= "you" "may" "play" ("it" | "that" "card") receipt_span_duration

receipt_span_duration ::= this_turn | until_end_of_your_next_turn

/* @prefer always */
instructions_exile_receipt_span ::= instructions_exile_receipt_life | instructions_exile_receipt_plain

/* Explicit alternative bundles are chosen independently for each counted object.
   Keep each bundle intact; `any one color` retains its existing nested choice. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:$count_each, production:$mana_each_alternatives, choice:EachUnit}} */
add_alternative_mana_each ::= "add" mana_each_alternatives "for" "each" count_each

mana_each_alternatives ::= mana_or | mana_or_list

/* Only the pre-existing fixed/any-color forms keep the legacy outer timing. */
mana_for_each_existing ::= mana_bundle | mana_any_color | mana_any_one_color

/* Preserve the complete counted object set of the legacy `for affected` route. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:CountObjects($affected), production:$mana_each_alternatives, choice:EachUnit}} */
add_alternative_mana_population ::= "add" mana_each_alternatives "for" affected

/* These two operands select physical cards outside the battlefield. In that
   domain permanent means the six permanent card types, not battlefield Any. */
private_card_transfer_filter ::= card_filter | private_card_three_and
/* @sem ObjectFilter::AnyOf([$card_word, $card_word_2, $card_word_3]) */
private_card_three_and ::= card_word "," card_word "," "and" card_word

/* @sem Operation::Move{objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:$private_card_transfer_filter}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
put_all_revealed_private_cards ::= "put" "all" private_card_transfer_filter "cards" "revealed" "this" "way" "into" "your" "hand"

/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$private_card_transfer_filter}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_all_private_cards ::= "return" "all" private_card_transfer_filter "cards" "from" "your" "graveyard" "to" "the" "battlefield"
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$private_card_transfer_filter}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]} */
return_all_private_cards_tapped ::= "return" "all" private_card_transfer_filter "cards" "from" "your" "graveyard" "to" "the" "battlefield" "tapped"
/* Your graveyard holds only cards you own, so "your hand" is each card's owner's hand. */
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$private_card_transfer_filter}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_all_private_cards_hand ::= "return" "all" private_card_transfer_filter "cards" "from" "your" "graveyard" "to" "your" "hand"
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_all_graveyard_cards_hand ::= "return" "all" "cards" "from" "your" "graveyard" "to" "your" "hand"

/* Explicit program wrappers retain the callback's own announcement/receipt
   boundary. The plural declaration already snapshots the ORIGINAL population
   with NoteObjects, independently of counter replacement/prevention. */
callback_counter_keyword_program ::= callback_counter_scalar_program | callback_counter_plural_program
/* @sem Program::Program{instructions:$clause_counter_target_keyword} */
callback_counter_scalar_program ::= clause_counter_target_keyword
/* @sem Program::Program{instructions:$clause_counters_same_group} */
callback_counter_plural_program ::= clause_counters_same_group

/* Resolution action, not the identically worded activation CostPart. The
   existing Optional/Reflexive composition owns the decision and completion. */
/* @sem Instruction::[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:AmongThem(Exactly($number))}]}}] */
reflexive_counter_removal ::= "remove" number counter_kind "counters" "from" "among" affected


/* Entry attachment is part of the Move, not an Attach instruction after entry.
   The explicit token noun keeps the earlier actual produced batch; the entry
   state chooses a legal host from that batch if a target card actually enters. */
/* @sem Operation::Move{objects:One($created_token_entry_target), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedToChosen(ObjectFilter::InSet($created_attachment_token))]}}, qualifiers:[]} */
return_card_attached_to_created_token ::= "return" created_token_entry_target "to" "the" "battlefield" "attached" "to" created_attachment_token

/* Up to one permits an empty announcement. The Card domain and graveyard
   restriction describe the returning object, independently of its token host. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:@and($card_filter, ObjectFilter::InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}))}), index:0} */
created_token_entry_target ::= "up" "to" "one" "target" card_filter "card" "from" "your" "graveyard"

/* A private-card return uses CardFilter: permanent excludes instant and
   sorcery cards, unlike the battlefield noun's deliberately unrestricted Any. */
/* @sem Operation::Move{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:@and($private_card_transfer_filter, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}})}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_all_private_cards_with_mana_value ::= "return" "all" private_card_transfer_filter "cards" "with" "mana" "value" number "or" "less" "from" "your" "graveyard" "to" "the" "battlefield"

/* Each player uses their own graveyard and enters under their own control. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:$card_filter}), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}] */
clause_players_return_all ::= players_singular "returns" "all" card_filter "cards" "from" "their" "graveyard" "to" "the" "battlefield"

/* This history consumer is private to its explicit preceding discard loop. */
/* @sem Operation::LoseLife{players:Intersection([$players_singular, Intersection([$players_singular, Matching{binding:0, condition:Compare{left:Earlier{what:Discarded, measure:Count, filter:$adjective_nontype, by:Bound(0)}, test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}}])]), amount:$value} */
player_discard_missing_filter_loss ::= players_singular "who" "didn't" "discard" "a" adjective_nontype "card" "this" "way" "loses" value "life"

/* @sem Operation::Keyword{actor:$player_one, action:KeywordAction::Skip{part:UntapStep}} */
single_player_skip_next_untap ::= player_one "skips" "their" "next" "untap" "step"

/* @sem Instruction::[ForEachPlayer{players:$loop_player_population, binding:0, body:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(Bound(0)), action:KeywordAction::Skip{part:UntapStep}}}]}}] */
clause_players_skip_next_untap ::= loop_player_population "skips" "their" "next" "untap" "step"

/* @sem Instruction::[$player_discard_action, Effect{result:@next, operation:$player_discard_missing_filter_loss}] */
clause_player_discard_loss ::= player_discard_action "," "then" player_discard_missing_filter_loss

/* The mandatory producer attempts one discard per player. No optional choice
   or unrelated action may supply the following discard-history condition. */
/* @sem Instruction::ForEachPlayer{players:$loop_player_population, binding:0, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:Bound(0), cost:Cost{parts:[Discard{count:Constant(1), filter:Any, random:false}]}, optional:false}}]}} */
player_discard_action ::= loop_player_population "discards" "a" "card"

loop_player_population ::= players_each | players_each_opponent

/* Both rewards observe the kept-on-top portion of this surveil, after any
   earlier effects and across the intervening draw. */
/* @sem @apply(PlayerSet::One(PlayerRef::AbilityController), $surveil_kept_rewards_sequence) */
clause_surveil_kept_rewards ::= surveil_kept_rewards_sequence

/* @sem Instruction::[Effect{result:@mark, operation:$surveil_base}, Effect{result:@next, operation:Draw{players:@subject, amount:SurveilKeptOnTop(@marked)}}, Effect{result:@next, operation:LoseLife{players:@subject, amount:$surveil_kept_life_amount}}] */
surveil_kept_rewards_sequence ::= surveil_base "." "then" "for" "each" "card" "you" "put" "on" "top" "of" "your" "library" "," "you" "draw" "a" "card" "and" "you" "lose" surveil_kept_life_amount "life"

/* @sem Expr::Multiply([$number, SurveilKeptOnTop(@marked)]) */
surveil_kept_life_amount ::= number

/* One written put verb coordinates these placement contributions as a single
   simultaneous event. Separate put verbs and sequencers remain instructions;
   no operation-level canonical merge or recipient deduplication is used. */
/* @sem Operation::PutCounters{placements:[$counter_direct_placement, $counter_direct_placement_2]} */
put_counters_two_direct ::= "put" counter_direct_placement "and" counter_direct_placement
counter_direct_placement ::= counter_direct_one | counter_direct_multiple
/* @sem CounterPlacement::CounterPlacement{recipients:Objects($affected), kind:$counter_kind, amount:Constant(1)} */
counter_direct_one ::= ("a" | "one" | "1") counter_kind "counter" "on" affected
/* @sem CounterPlacement::CounterPlacement{recipients:Objects($affected), kind:$counter_kind, amount:Expr::@plural_amount($counter_amount)} */
counter_direct_multiple ::= counter_amount counter_kind "counters" "on" affected

/* Fellowship choices happen after every secret vote is revealed. The selection
   receipt is collected from the voters, then control and the grant use it. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:Words([Fellowship, Aid]), secret:true}}]}}, Effect{result:@next, operation:RevealChoices{kind:Word}}, ForEachPlayer{players:Matching{binding:0, condition:VotedFor{player:Bound(0), option:Word(Fellowship)}}, binding:0, body:Program{instructions:[Effect{result:@mark, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(Bound(0)))])}, count:AsManyAsCan(Constant(1))}}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Selected(@marked)), changes:[SetController(AbilityController)], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Affected(@prior)), changes:[GrantAbility(@holder($static_cant_attack_owner))], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:@times($counter_amount, Expr::Votes(Word(Aid)))}]}}] */
clause_fellowship_transfer ::= "each" "player" "secretly" "votes" "for" "fellowship" "or" "aid" "," "then" "those" "votes" "are" "revealed" "." "for" "each" "fellowship" "vote" "," "the" "voter" "chooses" "a" "creature" "they" "control" "." "you" "gain" "control" "of" "each" "creature" "chosen" "this" "way" "," "and" "they" "gain" '"' static_cant_attack_owner '"' "then" "for" "each" "aid" "vote" "," "put" counter_amount counter_kind ("counter" | "counters") "on" affected

/* Future timing permission remains separate from the next-cast trigger. */
/* @sem Operation::EffectOn{subject:Players(One(AbilityController)), effects:[Term{family:FuturePlayerEffect, form:MayCastTheirNextSpellThisTurnAsThoughItHadFlash, operands:[Filter(Any)]}]} */
next_spell_cast_as_flash ::= "the" "next" "spell" "you" "cast" "this" "turn" "can" "be" "cast" "as" "though" "it" "had" "flash"

/* Object ballots preserve optionality and are all revealed before a later
   outcome is tested. A vote is a choice, not a target announcement. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:UpToOne(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}), secret:true}}]}}, Effect{result:@next, operation:RevealChoices{kind:Object}}] */
secret_optional_object_vote_reveal ::= players_singular "secretly" "votes" "for" "up" "to" "one" filter_phrase "," "then" "those" "votes" "are" "revealed"


/* The future trigger owns its optional target announcement and the mana value
   of its eventual spell. It is separate from any earlier timing permission. */
/* @sem Instruction::[Effect{result:@next, operation:@scope(Operation::CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:Any}, duration:EndOfTurn, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($target_up_to_one)), kind:$counter_kind, amount:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}]}}]}, once:true})}] */
clause_next_cast_mana_counters ::= "when" "you" "next" "cast" "a" "spell" "this" "turn" "," "put" "X" counter_kind "counters" "on" target_up_to_one "," "where" "X" "is" "the" "mana" "value" "of" "that" "spell"

/* "When you next cast an instant or sorcery spell this turn, copy that spell": a
   one-shot trigger whose copy is of the spell that triggered it. */
clause_next_cast_copy ::= clause_next_cast_copy_original | clause_cast_your_next_copy

next_cast_copy ::= next_cast_copy_once | next_cast_copy_x
/* @sem Expr::Constant(1) */
next_cast_copy_once ::= "copy" next_cast_copied "." "you" "may" "choose" "new" "targets" "for" "the" "copy"
/* @sem Expr::AnnouncedX */
next_cast_copy_x ::= "copy" next_cast_copied "X" "times" "." "you" "may" "choose" "new" "targets" "for" "the" "copies"
/* @sem () */
next_cast_copied ::= "that" "spell" | "it"

/* The creature ballot establishes both the no-votes condition and the
   most-voted population. Reveal all ballots before testing the outcome. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:UpToOne(Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}), secret:true}}]}}, Effect{result:@next, operation:RevealChoices{kind:Object}}, If{condition:Outcome(NoVotes), then:Program{instructions:[Effect{result:@next, operation:Draw{players:All, amount:$card_count}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:State(MostVotes)}, regeneration:true}}]}}] */
clause_creature_vote_outcome ::= players_singular "secretly" "votes" "for" "up" "to" "one" "creature" "," "then" "those" "votes" "are" "revealed" "." "if" "no" "creature" "got" "votes" "," "each" "player" "draws" card_count "." "otherwise" "," "destroy" "each" "creature" "with" "the" "most" "votes" "or" "tied" "for" "most" "votes"

/* A selected single card is an ordinary resolving action, not a cost. Keep
   selection separate from the discard/move so the following reflexive trigger
   binds to the action's performed receipt. */
optional_single_card_action ::= discard_one_card_action | return_one_permanent_action | reveal_one_card_action
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}] */
discard_one_card_action ::= "discard" ("a" | "an") card_filter "card"
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
return_one_permanent_action ::= "return" ("a" | "an") filter_phrase "you" "control" "to" "its" "owner's" "hand"
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}] */
reveal_one_card_action ::= "reveal" ("a" | "an") card_filter "card" "from" "your" "hand"
/* "Reveal any number of red cards in your hand." The cards chosen are the cards
   revealed, and a later "card revealed this way" counts that choice. */
/* @sem Instruction::[Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AnyNumber}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}] */
clause_reveal_any_number_hand ::= "reveal" "any" "number" "of" card_filter "cards" ("in" | "from") "your" "hand"
/* @sem Instruction::[Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:@and($card_filter, $modifiers)}, count:AnyNumber}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}] */
clause_reveal_any_number_hand_with ::= "reveal" "any" "number" "of" card_filter "cards" modifiers ("in" | "from") "your" "hand"
/* "Return an enchantment card from your graveyard to your hand for each card revealed
   this way": as many cards as that count, or as many as there are. This production's
   own results are issued before its count, so a count naming the instruction before
   it (`@prior`) would name this choice; such counts refuse here. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AsManyAsCan($count_each)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_return_graveyard_kind_for_each ::= "return" ("a" | "an") card_filter "card" "from" "your" "graveyard" "to" "your" "hand" "for" "each" count_each

/* Snapshot the announced targets before placing counters. A replacement that
   prevents placement must not remove a target from the following ability grant. */
/* @sem Instruction::[Effect{result:@mark, operation:NoteObjects{objects:$opponent_counter_grant_targets}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Selected(@marked)), kind:$counter_kind, amount:$counter_amount}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Selected(@marked)), changes:[GrantAbility(@scope(Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$program}))], duration:WhileMatches{object:Affected, filter:Counters{kind:$counter_kind_2, comparison:Greater, value:Constant(0)}}, evaluation:Snapshot}}] */
clause_target_counter_lasting_grant ::= "for" "each" "opponent" "," "put" counter_amount counter_kind "counter" "on" opponent_counter_grant_targets "." "each" "of" "those" "creatures" "has" '"' "at" turn_event "," program '"' "for" "as" "long" "as" "it" "has" "an" counter_kind "counter" "on" "it"
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:OpponentsOf(AbilityController), each:UpTo($number)}, filter:AllOf([CardType(Creature), Counters{kind:$counter_kind, comparison:Equal, value:Constant(0)}])})) */
opponent_counter_grant_targets ::= "up" "to" number "target" "creature" "that" "player" "controls" "without" "an" counter_kind "counter" "on" "it"

/* The offered mana is a payment; destruction is an ordinary fallback action.
   A failed destruction does not satisfy the following success condition. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@mark, operation:Destroy{objects:One(@self), regeneration:true}}, If{condition:Compare{left:CountObjects(Transition{result:@marked, phase:After}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$it_ref, recipients:$recipients, amount:$number, preventable:true}}]}, otherwise:Program{}}]}, otherwise:Program{}}] */
clause_destroy_unless_paid_success ::= "destroy" "this" "creature" "unless" "you" "pay" cost "." "if" "this" "creature" "is" "destroyed" "this" "way" "," it_ref "deals" number "damage" "to" recipients

/* First complete the ordinary return. Only its actual hand receipt offers the
   mana payment; only that chosen payment runs the following return program. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One($current_card_ref), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:InZone(Players{zone:Hand, players:All})}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$cost, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:$may_body}, otherwise:Program{}}]}, otherwise:Program{}}] */
clause_return_success_payment ::= "return" current_card_ref "to" "its" "owner's" "hand" "." "if" "that" "card" "is" "returned" "to" "its" "owner's" "hand" "this" "way" "," "you" "may" "pay" cost "." "if" "you" "do" "," may_body

/* An up-to-one target is an ordinary action. Both rewards read that card's
   current/last-known value, and their guard reads the performed exile result. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One($exile_reward_target), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:CardType(Creature)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:ObjectProperty{object:$exile_reward_target, property:ManaValue, information:CurrentOrLastKnown}}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:ObjectProperty{object:$exile_reward_target, property:ManaValue, information:CurrentOrLastKnown}, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{}}] */
clause_exile_card_value_rewards ::= "exile" exile_reward_target "." "if" "you" "do" "," "you" "lose" "X" "life" "and" "create" "X" token_named_recipe "tokens" "," "where" "X" "is" "that" "card's" "mana" "value"
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:AllOf([CardType(Creature), InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0} */
exile_reward_target ::= "up" "to" "one" "target" "creature" "card" "from" "your" "graveyard"

/* Here X is the quantity actually sacrificed, not an announcement made before
   resolution. The reflexive callback announces its targets using that receipt. */
/* @prefer always */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@choice_mark, operation:Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, choose:AnyNumber}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(CountObjects(Transition{result:@reflexive_performed, phase:Before})), filter:$filter_plural_2}))), changes:$sacrifice_pump_changes, duration:$duration, evaluation:Snapshot}}]}})}]}}] */
instructions_sacrifice_x_targets ::= "you" "may" "sacrifice" "X" filter_plural "." "when" "you" "do" "," "up" "to" "X" "target" filter_plural "each" sacrifice_pump_changes duration

/* Only this callback's X reads its immediate sacrifice receipt. Keyword grants
   here have no independent X costs or nested ability scope. */
/* @sem Change::[Pump{power:$sacrifice_stat, toughness:$sacrifice_stat_2}, ...$sacrifice_grants] */
sacrifice_pump_changes ::= ("get" | "gets") sacrifice_stat "/" sacrifice_stat "and" "gain" sacrifice_grants
sacrifice_stat ::= sacrifice_stat_plus | sacrifice_stat_minus | sacrifice_stat_x | sacrifice_stat_negative_x
/* @sem $number_digits */
sacrifice_stat_plus ::= "+" number_digits
/* @sem Expr::@negate($number_digits) */
sacrifice_stat_minus ::= "-" number_digits
/* @sem Expr::CountObjects(Transition{result:@reflexive_performed, phase:Before}) */
sacrifice_stat_x ::= "+" "X"
/* @sem Expr::@negate(Expr::CountObjects(Transition{result:@reflexive_performed, phase:Before})) */
sacrifice_stat_negative_x ::= "-" "X"
sacrifice_grants ::= sacrifice_grant_one | sacrifice_grant_more
/* @sem Change::[GrantKeyword($keyword_name)] */
sacrifice_grant_one ::= keyword_name
/* @sem Change::[GrantKeyword($keyword_name), ...$sacrifice_grants] */
sacrifice_grant_more ::= keyword_name ("and" | "," "and"?) sacrifice_grants

/* The copy and future return share this chosen exile. The return keeps every
   card produced by the payment, still in exile, rather than a linked-card query. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$single_exile_payment, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[...$clause_copy_for_duration, ...$paid_exile_delayed_return]}, otherwise:Program{}}] */
instructions_paid_exile_copy_return ::= "you" "may" single_exile_payment "." "if" "you" "do" "," clause_copy_for_duration "." paid_exile_delayed_return
/* @sem Cost::Cost{parts:[Move{selections:[_{objects:One($target_object)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}}]} */
single_exile_payment ::= "exile" target_object
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, zone:Exile}, destination:$battlefield_control, qualifiers:[]}}]}}}] */
paid_exile_delayed_return ::= "return" "the" "exiled" "card" "to" "the" "battlefield" battlefield_control "at" "the" "beginning" "of" "the" "next" "end" "step"

/* PerPlayer partitions this one target announcement by each opponent's
   controlled objects; it does not select targets while a player loop resolves.
   "That player" is the opponent each part belongs to, so these targets follow
   "for each opponent" only. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:OpponentsOf(AbilityController), each:UpTo(Constant(1))}, filter:$filter_phrase})) */
each_opponent_targets ::= "up" "to" "one" "target" filter_phrase "that" "player" "controls"
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:$each_opponent_targets, regeneration:true}}] */
clause_destroy_each_opponent_target ::= "for" "each" "opponent" "," "destroy" each_opponent_targets
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$each_opponent_targets, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_exile_each_opponent_target ::= "for" "each" "opponent" "," "exile" each_opponent_targets
/* What the exile holds, it holds only while its source stays. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$each_opponent_targets, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReturnAfter{objects:Transition{result:@prior, phase:After}, duration:WhileOnBattlefield($self_ref)}}] */
clause_exile_each_opponent_target_until ::= "for" "each" "opponent" "," "exile" each_opponent_targets "until" self_ref "leaves" "the" "battlefield"
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($each_opponent_targets), changes:[SetController(AbilityController)], duration:$duration, evaluation:Snapshot}}] */
clause_gain_control_each_opponent_target ::= "for" "each" "opponent" "," "gain" "control" "of" each_opponent_targets duration
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($each_opponent_targets), changes:[SetController(AbilityController)], duration:Indefinite, evaluation:Snapshot}}] */
clause_gain_control_each_opponent_target_indefinite ::= "for" "each" "opponent" "," "gain" "control" "of" each_opponent_targets

/* A single named player owns the choice, hand and battlefield entry. A loop
   is unnecessary for this reading; plural-player forms keep their own scopes. */
/* @sem Instruction::[Optional{decider:$that_player, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:$that_player, objects:Zone{scope:Players{zone:Hand, players:One($that_player)}, kind:Card, filter:$a_card}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player($that_player), arrival:BattlefieldArrival{}}, qualifiers:[]}}]}}] */
clause_named_player_hand_entry ::= that_player "may" "put" a_card "from" "their" "hand" "onto" "the" "battlefield"

/* Detach the named attachment itself, retaining its controller as actor. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Unattach{object:$object_ref}} */
unattach_action ::= "unattach" object_ref

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$continuous_snapshot}] */
clause_have_continuous ::= "have" continuous_snapshot

/* The target player is the payer and the owner of the offered graveyard card. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$declining_payer, cost:Cost::Cost{parts:[Move{selections:[_{objects:Zone{scope:Players{zone:Graveyard, players:One($declining_payer)}, kind:Card, filter:Any}, choose:Exactly(Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}}]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_target_graveyard_decline ::= declining_payer "may" "exile" "a" "card" "from" "their" "graveyard" "." "if" ("they" "don't" | "that" "player" "doesn't" | "that" "opponent" "doesn't") "," conjoined

declining_payer ::= target_opponent | target_player

/* @sem Cost::Cost{parts:[Move{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))}, choose:Exactly(Constant(1))}], destination:OwnersHand(CardArrival{})}]} */
payment_return_controlled_permanent ::= "return" ("a" | "an") filter_phrase "you" "control" "to" "its" "owner's" "hand"

/* The explicitly tapped host is also the following kind test's subject.
   This does not enable a bare scalar pronoun in unrelated/static contexts. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:One($attached_ref), tapped:true}}, If{condition:ObjectMatches{object:$attached_ref, filter:$filter_phrase}, then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_tap_attached_kind ::= "tap" attached_ref "." "if" "it's" ("a" | "an") filter_phrase "," conjoined

/* Removing a number of counters of a kind. */
/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:Count(Exactly($counter_amount))}]} */
remove_counters_from_affected ::= "remove" counter_amount counter_kind "counter" "from" affected

/* A removal and a test of the same permanent name it once and then as "it",
   whichever object that name means (a granting Aura inside a granted ability). */
/* @sem Instruction::[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($self_ref)), kind:$counter_kind, amount:Count(Exactly($counter_amount))}]}}, If{condition:ObjectMatches{object:$self_ref, filter:Counters(_{kind:$counter_kind_2, comparison:Equal, value:Constant(0)})}, then:$program, otherwise:_{}}] */
instructions_remove_then_if_none ::= "remove" counter_amount counter_kind "counter" "from" self_ref "." "then" "if" "it" "has" "no" counter_kind "counters" "on" "it" "," program

/* Removing every counter of a kind. */
/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:All}]} */
remove_all_counters_from_affected ::= "remove" "all" counter_kind "counters" "from" affected

/* Putting the event's amount of counters. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:EventAmount}]} */
put_that_many_counters ::= "put" "that" "many" counter_kind "counters" "on" affected

/* Doubling the counters of a kind. */
/* @sem Operation::DoubleCounters(_{objects:$affected, kind:$counter_kind}) */
double_counters ::= "double" "the" "number" "of" counter_kind "counters" "on" affected

/* One counter for each counted object. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:$count_each}]} */
put_counter_for_each ::= "put" "a" counter_kind "counter" "on" affected "for" "each" count_each

/* A recipient getting counters. */
/* @sem Operation::PutCounters{placements:[_{recipients:$recipients, kind:$counter_kind, amount:$counter_amount}]} */
recipients_gets_counter ::= recipients "gets" counter_amount counter_kind "counter"

/* Recipients getting counters. */
/* @sem Operation::PutCounters{placements:[_{recipients:$recipients, kind:$counter_kind, amount:$counter_amount}]} */
recipients_get_counter ::= recipients "get" counter_amount counter_kind "counter"

/* A recipient getting an amount of counters. */
/* @sem Operation::PutCounters{placements:[_{recipients:$recipients, kind:$counter_kind, amount:$value}]} */
recipients_gets_counters ::= recipients "gets" value counter_kind "counters"

/* Support puts a +1/+1 counter on each of up to a number of other target creatures. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo($number), filter:CardType(Creature)}))), kind:PowerToughness([1, 1]), amount:Constant(1)}]} */
support_action ::= "support" number

/* Choosing one color. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[Term{family:ChoosableColor, form:AnyColor}]}} */
choose_a_color ::= "choose" "a" "color"

/* Choosing a player, a type, a number or colors. */
choose_value ::= choose_card_types_five | choose_land_types_pair | choose_color_pair | choose_planeswalker_type | choose_two_basic_land_types | choose_friend_or_foe | choose_opponent | choose_a_player | choose_land_type | choose_basic_land_type | choose_number_between | choose_a_number | choose_two_colors | choose_color_other | choose_creature_type_plain | choose_ability_options_three | choose_color_type_options_five | choose_card_types_pair | choose_land_or_nonland | choose_ability_options | choose_number_threshold | choose_land_class | choose_direction
/* @sem Operation::ChooseValue{choosers:$players_singular, kind:Word, terms:_{count:Exactly(Constant(1)), options:[Text(Friend), Text(Foe)]}} */
choose_friend_or_foe ::= "for" players_singular "," "choose" "friend" "or" "foe"
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Player, terms:_{count:Exactly(Constant(1)), options:[Players(All)]}} */
choose_a_player ::= "choose" "a" "player"
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:LandType, terms:_{count:Exactly(Constant(1)), options:[]}} */
choose_land_type ::= "choose" "a" "land" "type"
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:BasicLandType, terms:_{count:Exactly(Constant(1)), options:[]}} */
choose_basic_land_type ::= "choose" "a" "basic" "land" "type"
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Number, terms:_{options:[Comparison(Greater, Constant(0))], count:Exactly(Constant(1))}} */
choose_a_number ::= "choose" "a" "number"
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Number, terms:_{count:Exactly(Constant(1)), options:[Integer($number), Integer($number_2)]}} */
choose_number_between ::= "choose" "a" "number" "between" NUMBER "and" NUMBER
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(2)), options:[]}} */
choose_two_colors ::= "choose" "two" "colors"
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[$entering_color_other]}} */
choose_color_other ::= "choose" "a" "color" entering_color_other

/* Naming an Oracle card, perhaps of a kind. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:CardName, terms:_{count:Exactly(Constant(1)), options:[$card_name_option]}} */
choose_a_card_name ::= "choose" card_name_option

/* Choosing cards in your hand. */
/* @sem Operation::@selected_result(Operation::ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), count:AsManyAsCan($counter_amount)}) */
choose_cards_in_hand ::= "choose" counter_amount filter_phrase "card" "in" "your" "hand"

/* Flipping a coin. */
/* @sem Operation::FlipCoin{player:AbilityController, protocol:@coin_protocol}*/
flip_a_coin ::= "flip" "a" "coin"

/* Mana for each object in a group. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:CountObjects($affected), production:$mana_for_each_existing, choice:Once}} */
add_mana_for_affected ::= "add" mana_for_each_existing "for" affected

/* Mana for each counted thing. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:$count_each, production:$mana_for_each_existing, choice:Once}} */
add_mana_for_each ::= "add" ("an" "additional")? mana_for_each_existing "for" "each" count_each

/* This quantity is an actual payment receipt, never the number requested or
   the counters remaining on the object. Binding proves its current component. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:@activation_removed_counters($counter_kind), production:$mana_for_each_existing, choice:Once}} */
add_mana_for_removed_counters ::= "add" ("an" "additional")? mana_for_each_existing "for" "each" counter_kind "counter" "removed" "this" "way"

/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:@activation_removed_counters($counter_kind), production:$mana_each_alternatives, choice:EachUnit}} */
add_alternative_mana_for_removed_counters ::= "add" ("an" "additional")? mana_each_alternatives "for" "each" counter_kind "counter" "removed" "this" "way"

/* Mana of the chosen color. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Amount{color:Chosen, amount:$value}} */
add_mana_of_chosen_color ::= "add" value "mana" "of" "the" "chosen" "color"

/* Mana in any combination of colors. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:$number, production:ChooseOne([Amount{color:White, amount:Constant(1)}, Amount{color:Blue, amount:Constant(1)}, Amount{color:Black, amount:Constant(1)}, Amount{color:Red, amount:Constant(1)}, Amount{color:Green, amount:Constant(1)}]), choice:EachUnit}} */
add_mana_any_combination ::= "add" number "mana" "in" "any" "combination" "of" "colors"

/* An amount of mana equal to a value. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:$value, production:$mana_production, choice:Once}} */
add_mana_amount_equal ::= "add" "an" "amount" "of" mana_production "equal" "to" value

/* Tokens that enter tapped and attacking. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$token_group], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}) */
create_tokens_tapped_attacking ::= "create" token_group "that's" "tapped" "and" "attacking"
/* @sem Operation::@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$token_group], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{player:$player_ref}]}}) */
create_tokens_attacking_player ::= "create" token_group "that's" "tapped" "and" "attacking" player_ref

/* Abandoning this scheme. */
/* @sem Operation::AbandonScheme{actor:One(AbilityController)} */
abandon_this_scheme ::= "abandon" "this" "scheme"

/* You gaining an amount of life. */
/* @sem Operation::GainLife{players:One(AbilityController), amount:$value} */
you_gain_life ::= "you" "gain" value "life"

/* Damage equal to the counters on an object. */
/* @sem Operation::DealDamage{source:$object_ref, recipients:$recipients, amount:CountCounters(_{recipients:Objects($affected), kind:$counter_kind, information:CurrentOrLastKnown}), preventable:true} */
deal_damage_equal_counters ::= affected "deals" "damage" "equal" "to" "the" "number" "of" counter_kind "counters" "on" object_ref "to" recipients

/* Two amounts of damage dealt in one event. */
/* @sem Operation::DealDamageParts{source:$object_ref, parts:[_{recipients:Objects($affected), amount:$value}, _{recipients:$recipients, amount:$value_2}], preventable:true} */
deal_damage_split_two ::= object_ref "deals" value "damage" "to" affected "and" value "damage" "to" recipients

/* Exiling a target player's graveyard. */
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0})}, kind:Card, filter:Any}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_target_players_graveyard ::= "exile" "target" "player's" "graveyard"
/* Exiling every card of a kind from one graveyard, or from all graveyards. */
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One($player_possessive)}, kind:Card, filter:$card_filter}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_all_graveyard_cards ::= "exile" "all" card_filter "cards" "from" player_possessive "graveyard"
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Hand, players:One($player_possessive)}, kind:Card, filter:Any}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_all_hand_cards ::= "exile" "all" "cards" "from" player_possessive "hand"
/* "Exile all cards from your hand face down": only the imperative's own hand; other
   players exile theirs with "exiles all cards from their hand face down". */
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_all_hand_face_down ::= "exile" "all" "cards" "from" "your" "hand" "face" "down"
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Library, players:One($player_possessive)}, kind:Card, filter:Any}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_all_library_cards ::= "exile" "all" "cards" "from" player_possessive "library"
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$card_filter}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_all_graveyards_cards ::= "exile" "all" card_filter "cards" "from" "all" "graveyards"

/* Exiling two groups together. */
/* @sem Operation::Move{objects:Union([$affected, $affected_2]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_two_groups ::= "exile" affected "and" affected

/* Exiling every graveyard. */
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:Any}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_all_graveyards ::= "exile" "all" "graveyards"

/* Exiled cards arrive with counters. */
/* @sem Operation::Move{objects:$affected, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[[$counter_kind, $value]], states:[]}}, qualifiers:[]} */
exile_with_counters ::= "exile" affected "with" value counter_kind "counters" "on" "it"

/* A dying object is exiled instead. */
/* @sem Operation::CreateReplacement{event:ZoneChange{objects:SameObject($object_ref), from:Battlefield, to:Graveyard}, limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}} */
exile_instead_of_dying ::= "if" object_ref "would" "die" this_duration "," "exile" "it" "instead"

/* For a while, each incoming object of a kind enters with more counters. */
/* @sem Operation::CreateReplacement{event:Enter{objects:$filter_phrase}, limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$entry_counter_amount})}}]}} */
entries_with_counters_this_turn ::= this_duration "," "each" filter_phrase "enters" "with" entry_counter_amount counter_kind ("counter" | "counters") "on" "it"

/* Objects damaged this way are exiled instead of dying. */
/* @sem Operation::CreateReplacement{event:ZoneChange{objects:AllOf([$filter_phrase, DamagedBy(@prior)]), from:Battlefield, to:Graveyard}, limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}} */
exile_damaged_instead_of_dying ::= "if" "a" filter_phrase "dealt" "damage" "this" "way" "would" "die" this_duration "," "exile" "it" "instead"

/* Preventing combat damage an object would deal. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Permanent, sources:SameObject($object_ref), recipients:Any, kind:Combat, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevent_combat_damage_would_deal ::= "prevent" "all" "combat" "damage" object_ref "would" "deal" this_duration

/* You gaining control indefinitely. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[SetController(AbilityController)], duration:Indefinite, evaluation:Snapshot} */
gain_control_of ::= "gain" "control" "of" affected

/* A player gaining control indefinitely. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[SetController($player_ref)], duration:Indefinite, evaluation:Snapshot} */
player_gains_control_of ::= player_ref "gains" "control" "of" affected

/* Control that lasts while you control the source. */
/* @sem Operation::CreateContinuousEffect{source:$object_ref, affected:Objects($affected), changes:[SetController(AbilityController)], duration:WhileControlled{player:AbilityController, object:$object_ref}, evaluation:Snapshot} */
gain_control_while_controlled ::= "gain" "control" "of" affected "for" "as" "long" "as" "you" "control" object_ref

/* Choosing permanents and returning them to their owners' hands. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan($counter_amount)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
return_chosen_to_owners_hand ::= "return" counter_amount filter_phrase "to" "its" "owner's" "hand"

/* Choosing up to a number of cards in your graveyard and returning them. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$search_filter_many}, count:UpTo($count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
return_up_to_graveyard_hand ::= "you"? "return" "up" "to" count search_filter_many "from" "your" "graveyard" "to" "your" "hand"

/* Protection from a color chosen as it resolves. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[Term{family:ChoosableColor, form:AnyColor}]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[GrantKeyword(Protection(Objects(_{kind:Any, filter:Chosen(Color)})))], duration:$duration, evaluation:Snapshot}}] */
protection_from_chosen_color ::= affected "gains" "protection" "from" "the" "color" "of" "your" "choice" duration

/* Clashing, with instructions if you win. */
/* @sem Instruction::[Effect{result:@next, operation:Clash{actor:One(AbilityController), opponents:OpponentsOf(AbilityController), won:[$program], lost:[_{}]}}] */
clash_if_you_win ::= "clash" "with" "an" "opponent" "." "if" "you" "win" "," program

/* A coin flip with won and lost instructions. */
/* @sem Instruction::[Effect{result:@next, operation:FlipCoin{player:AbilityController, protocol:@coin_protocol}}, If{condition:CoinFlip{result:0, outcome:Won}, then:$program, otherwise:$program_2}]*/
flip_coin_win_or_lose ::= "flip" "a" "coin" "." "if" "you" "win" "the" "flip" "," program "." "if" "you" "lose" "the" "flip" "," program

/* A coin flip with instructions for one outcome; the flip is what the condition reads. */
/* @sem Instruction::[Effect{result:@mark, operation:FlipCoin{player:AbilityController, protocol:@coin_protocol}}, If{condition:CoinFlip{result:@marked, outcome:$flip_outcome}, then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_flip_coin_if ::= "flip" "a" "coin" "." "if" "you" flip_outcome "the" "flip" "," conjoined

flip_outcome ::= flip_won | flip_lost
/* @sem CoinOutcome::Won */
flip_won ::= "win"
/* @sem CoinOutcome::Lost */
flip_lost ::= "lose"

/* The linked card is read in exile, then returns to its own owner. */
/* @sem Operation::Move{objects:@zone_members(ObjectSet::One($linked_exiled_card)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
move_linked_card_hand ::= "return" linked_exiled_card "to" owner_possessive "hand"

/* A bounded, untargeted population is chosen during resolution. The written
   count belongs to that choice, not to an announcement or an object reference. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, count:UpTo($value)}}, Effect{result:@next, operation:SetTapped{objects:Selected(@prior), tapped:false}}] */
instructions_untap_choice ::= "untap" "up" "to" value filter_plural

/* The controller can direct two creatures to fight. The written operands keep
   the same lexical identities as the third-person fight action. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:ObjectRef::@reflexive_moved_fight_object($object_ref), second:ObjectRef::@fight_prior_counterpart($object_ref_2)}} */
have_creatures_fight ::= "have" object_ref "fight" object_ref

/* Reveal an owned card from outside the game, with the filter supplied by the card phrase. */
/* @sem Operation::Wish{actor:One(AbilityController), filter:$wish_owned_card, reveal:true} */
wish_reveal_owned ::= "reveal" wish_owned_card "from" "outside" "the" "game" "and" "put" "it" "into" "your" "hand"

wish_owned_card ::= wish_owned_sorcery | wish_owned_instant | wish_owned_filtered_a | wish_owned_filtered_an | wish_owned_negative | wish_owned_multicolored | wish_owned_named_self
/* @sem $filter_phrase */
wish_owned_filtered_a ::= "a" filter_phrase "card" "you" "own"
/* @sem $filter_phrase */
wish_owned_filtered_an ::= "an" filter_phrase "card" "you" "own"
/* @sem $adjective_nontype */
wish_owned_negative ::= "a" adjective_nontype "card" "you" "own"
/* @sem $adjective_multicolored */
wish_owned_multicolored ::= "a" adjective_multicolored "card" "you" "own"
/* @sem ObjectFilter::Name(@card_name) */
wish_owned_named_self ::= "a" "card" "you" "own" "named" SELF_NAME
/* @sem $spell_sorcery */
wish_owned_sorcery ::= "a" spell_sorcery "card" "you" "own"
/* @sem $spell_instant */
wish_owned_instant ::= "an" spell_instant "card" "you" "own"

/* A perpetual operation combines the affected set with reusable changes. */
/* @sem Operation::CreatePerpetualEffect{objects:$perpetual_affected_subject, changes:$perpetual_changes} */
perpetual_affected_changes ::= perpetual_affected_subject "perpetually" perpetual_changes

perpetual_changes ::= static_changes | perpetual_gain_bare | perpetual_gains_bare | perpetual_gain_valued | perpetual_gains_valued | perpetual_type_stats_keyword

/* @sem Change::[GrantAbility($mechanic_bare)] */
perpetual_gain_bare ::= "gain" mechanic_bare

/* @sem Change::[GrantAbility($mechanic_bare)] */
perpetual_gains_bare ::= "gains" mechanic_bare

/* @sem Change::[GrantAbility($mechanic_valued_keyword)] */
perpetual_gain_valued ::= "gain" mechanic_valued_keyword

/* @sem Change::[GrantAbility($mechanic_valued_keyword)] */
perpetual_gains_valued ::= "gains" mechanic_valued_keyword

/* @sem Change::[CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetBasePowerToughness{power:$value, toughness:$value_2}, GrantKeyword($keyword_name)] */
perpetual_type_stats_keyword ::= "becomes" "a" becomes_types "with" "base" "power" "and" "toughness" value "/" value "and" "gains" keyword_name

/* The possessive refers to the object named by the preceding instruction. */
/* @sem Operation::CreatePerpetualEffect{objects:One(@it), changes:[SetPower($value)]} */
perpetual_prior_base_power ::= "its" "base" "power" "perpetually" "becomes" "equal" "to" value

/* A spell change keeps its subject separate from the characteristic or ability changed. */
/* @sem Operation::ChangeSpell{subject:One($object_ref), changes:$spell_changes} */
change_spell_shared ::= object_ref spell_changes

spell_changes ::= spell_gains_mechanic | spell_enters_extra_counters | spell_becomes_two_types | spell_becomes_retained_type

/* @sem Change::[GrantAbility($spell_granted_mechanic)] */
spell_gains_mechanic ::= "gains" spell_granted_mechanic

spell_granted_mechanic ::= mechanic_valued_keyword | bare_rebound

/* @sem Change::[EntersWithCounters(_{kind:$counter_kind, amount:$value})] */
spell_enters_extra_counters ::= "enters" "with" "X" "additional" counter_kind "counters" "on" "it" "," "where" "X" "is" value

/* @sem Change::[Colors{mode:Set, colors:[$token_color]}, CreatureTypes{mode:Add, types:Listed($becomes_type_one)}, CreatureTypes{mode:Add, types:Listed($becomes_type_one_2)}] */
spell_becomes_two_types ::= "becomes" "a" token_color becomes_type_one becomes_type_one

/* @sem Change::[Colors{mode:Add, colors:[$token_color]}, CreatureTypes{mode:Add, types:Listed($becomes_type_one)}, GrantKeyword($keyword_value), SetBasePowerToughness{power:$value, toughness:$value_2}] */
spell_becomes_retained_type ::= "becomes" "a" token_color becomes_type_one "in" "addition" "to" "its" "other" "colors" "and" "types" "," "has" keyword_value "," "and" "has" "base" "power" "and" "toughness" value "/" value

/* Casting from linked exile keeps the eligible set separate from the amount
   and payment, so those operands can be reused and printed independently. */
/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}) */
linked_exile_cards ::= "cards" "exiled" "with" object_ref

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}) */
linked_exile_spells ::= "spells" "from" "among" "cards" "exiled" "with" object_ref

linked_exile_any_selection ::= linked_exile_cards | linked_exile_spells

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:$linked_exile_any_selection, count:AnyNumber, cost:Free} */
cast_any_linked_exile ::= "cast" "any" "number" "of" linked_exile_any_selection "without" "paying" "their" "mana" "costs"

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}) */
linked_exile_singular ::= "exiled" "with" object_ref

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:$linked_exile_singular, count:Exactly($card_count), cost:Free} */
cast_linked_exile_card ::= "cast" card_count linked_exile_singular "without" "paying" "its" "mana" "cost"

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(One(AbilityController)), InSet(Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}))])}) */
owned_linked_exile_cards ::= "cards" "you" "own" "exiled" "with" object_ref

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(One(AbilityController)), Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})])}) */
owned_counter_exile_cards ::= "cards" "you" "own" "in" "exile" "with" counter_kind "counters" "on" "them"

/* @sem ObjectFilter::AnyOf([CardType(Instant), CardType(Sorcery)]) */
cast_instant_or_sorcery_filter ::= "instant" "or" "sorcery"

/* @sem ObjectSet::Matching{objects:$linked_exile_cards, filter:$cast_instant_or_sorcery_filter} */
linked_exile_instant_sorcery ::= cast_instant_or_sorcery_filter "spell" "from" "among" linked_exile_cards

/* @sem ObjectSet::Matching{objects:$owned_counter_exile_cards, filter:$filter_phrase} */
owned_counter_exile_spell ::= filter_phrase "spell" "from" "among" owned_counter_exile_cards

free_exile_spell_selection ::= linked_exile_instant_sorcery | owned_counter_exile_spell

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:$free_exile_spell_selection, count:Exactly($counter_amount), cost:Free} */
cast_free_exile_spell ::= "cast" counter_amount free_exile_spell_selection "without" "paying" "its" "mana" "cost"

/* @sem ObjectSet::Matching{objects:$owned_linked_exile_cards, filter:$filter_phrase} */
owned_linked_exile_spell ::= filter_phrase "spell" "from" "among" owned_linked_exile_cards

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:$owned_linked_exile_spell, count:Exactly($counter_amount), cost:Normal} */
cast_owned_linked_exile_spell ::= "cast" counter_amount owned_linked_exile_spell

/* Populations of cards available for a free cast retain their independent
   link, ownership, counter, and prior-result operands. */
/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}) */
free_cast_linked_population ::= "cards" "exiled" "with" object_ref

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})}) */
free_cast_counter_population ::= "cards" "in" "exile" "with" counter_kind "counters" "on" "them"

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(One(AbilityController)), Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})])}) */
free_cast_owned_counter_population ::= "cards" "you" "own" "in" "exile" "with" counter_kind "counters" "on" "them"

free_cast_population ::= free_cast_linked_population | free_cast_counter_population | free_cast_owned_counter_population

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:$free_cast_population, count:Exactly($counter_amount), cost:Free} */
cast_free_from_population ::= "cast" counter_amount "spell" "from" "among" free_cast_population "without" "paying" "its" "mana" "cost"

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:$free_cast_population, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:$number}}}, count:Exactly($counter_amount), cost:Free} */
cast_free_mana_value_from_population ::= "cast" counter_amount "spell" "with" "mana" "value" number "from" "among" free_cast_population "without" "paying" "its" "mana" "cost"

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([Not(SameObject(Result{result:@prior, phase:After, index:0})), InSet(Transition{result:1, phase:After})])}) */
free_cast_other_exiled_population ::= "the" "other" "cards" "exiled" "this" "way"

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:$free_cast_other_exiled_population, count:UpTo($value), cost:Free} */
cast_free_up_to_population ::= "cast" "up" "to" value "spells" "from" "among" free_cast_other_exiled_population "without" "paying" "their" "mana" "costs"

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([$adjective_nontype, InSet(Transition{result:@prior, phase:After})])}) */
free_cast_those_population ::= "those" adjective_nontype "cards"

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:$free_cast_those_population, count:AnyNumber, cost:Free} */
cast_free_any_population ::= "you" "may" "cast" "any" "number" "of" "spells" "from" "among" free_cast_those_population "without" "paying" "their" "mana" "costs"

/* Retargeting keeps the announced stack object and the new destination independent. */
retarget_operation ::= retarget_one_to | retarget_single_to | retarget_single | retarget_many | retarget_any

/* @sem Operation::Retarget{actor:One(AbilityController), object:$retarget_stack_object, targets:To($affected)} */
retarget_one_to ::= "change" "a" "target" "of" retarget_stack_object "to" affected

/* @sem Operation::Retarget{actor:One(AbilityController), object:$retarget_single_stack_object, targets:To($affected)} */
retarget_single_to ::= "change" "the" "target" "of" retarget_single_stack_object "to" affected

/* @sem Operation::Retarget{actor:One(AbilityController), object:$retarget_single_stack_object, targets:Must} */
retarget_single ::= "change" "the" "target" "of" retarget_single_stack_object

/* @sem Operation::Retarget{actor:One(AbilityController), object:$retarget_many_stack_object, targets:Must} */
retarget_many ::= "change" "the" "targets" "of" retarget_many_stack_object

/* @sem Operation::Retarget{actor:One(AbilityController), object:$retarget_many_stack_object, targets:Must} */
retarget_any ::= "change" "any" "targets" "of" retarget_many_stack_object

/* Combat state is part of the token arrival and retains its blocking referent. */
/* @sem Operation::@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$token_group], entry:BattlefieldArrival{tapped:false, counters:[], states:[Attacking{}]}}) */
create_tokens_attacking_singular ::= "create" token_group "that's" "attacking"

/* @sem Operation::@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$token_group], entry:BattlefieldArrival{tapped:false, counters:[], states:[Attacking{}]}}) */
create_tokens_attacking_plural ::= "create" token_group "that" "are" "attacking"

/* @sem Operation::@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$token_group], entry:BattlefieldArrival{tapped:false, counters:[], states:[Blocking($object_ref)]}}) */
create_tokens_blocking_singular ::= "create" token_group "that's" "blocking" object_ref

/* Countering composes with stack-target phrases, preserving their object domains. */
/* @sem Operation::Counter{objects:$counter_stack_objects, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None} */
counter_stack_action ::= "counter" counter_stack_objects

/* The historical filter applies to the current graveyard population. */
/* @sem Operation::Move{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$card_history_qualifier}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_history_cards_hand ::= "return" "to" "your" "hand" "all" "cards" "in" "your" "graveyard" card_history_qualifier

/* @sem ObjectFilter::History{event:CycledOrDiscarded, window:ThisTurn} */
card_history_qualifier ::= "that" "you" "cycled" "or" "discarded" "this" "turn"

/* @sem Operation::Move{objects:$graveyard_cards_arrived_this_turn, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_arrived_graveyard_cards_hand ::= "return" "to" "your" "hand" graveyard_cards_arrived_this_turn

/* Distributive damage keeps the source population and the recipient independent. */
/* @sem Operation::DealDamageFromEach{sources:$damage_each_population, recipients:$damage_each_recipient, amount:ObjectProperty{object:Affected, property:$stat, information:CurrentOrLastKnown}} */
damage_each_property ::= damage_each_population "deals" "damage" "equal" "to" "its" stat "to" damage_each_recipient

/* @sem Operation::DealDamageFromEach{sources:$damage_each_population, recipients:Objects(One(Affected)), amount:ObjectProperty{object:Affected, property:$stat, information:CurrentOrLastKnown}} */
damage_each_self ::= damage_each_population "deals" "damage" "to" "itself" "equal" "to" "its" stat

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase} */
damage_each_population ::= "each" filter_phrase

/* @sem Recipients::Players(OpponentsOf(AbilityController)) */
damage_each_opponents ::= "each" "opponent"

/* @sem Recipients::Objects($affected) */
damage_each_objects ::= affected

damage_each_recipient ::= damage_each_opponents | damage_each_objects

/* A group of announced sources can deal to another target that excludes it. */
/* @sem Operation::DealDamageFromEach{sources:$damage_group_subject, recipients:$damage_other_target, amount:ObjectProperty{object:Affected, property:$stat, information:CurrentOrLastKnown}} */
damage_group_property ::= damage_group_subject "each" "deal" "damage" "equal" "to" "their" stat "to" damage_other_target

/* @sem Operation::DealDamageFromEach{sources:Targets(0), recipients:$damage_other_target, amount:ObjectProperty{object:Affected, property:$stat, information:CurrentOrLastKnown}} */
damage_they_property ::= "they" "each" "deal" "damage" "equal" "to" "their" stat "to" damage_other_target

/* @sem Recipients::Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(InSet(Targets(0))), $noun])}), index:0})) */
damage_other_target_single ::= "another" "target" noun

/* @sem Recipients::Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(InSet(Targets(0))), AnyOf([$noun, $noun_2, CardType(Battle)])])}), index:0})) */
damage_other_target_union ::= "another" "target" noun "," noun "," "or" "battle"

damage_other_target ::= damage_other_target_single | damage_other_target_union

/* Two independently announced groups retain their exclusion and target slots. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([InSet(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:AnyNumber, filter:$filter_plural}))), SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo($number), filter:AllOf([Not(InSet(Targets(0))), $filter_phrase])}), index:0})])} */
damage_group_two_targets ::= "any" "number" "of" "target" filter_plural "and" "up" "to" number "other" "target" filter_phrase

damage_group_subject ::= affected | damage_group_two_targets

/* @sem Operation::DealDamageFromEach{sources:$damage_group_two_targets, recipients:Objects($affected), amount:ObjectProperty{object:Affected, property:$stat, information:CurrentOrLastKnown}} */
damage_group_two_to_objects ::= damage_group_two_targets "each" "deal" "damage" "equal" "to" "their" stat "to" affected

/* Selection and movement share the current filter and selection result. */
/* @sem ObjectFilter::AnyOf([$filter_phrase, $filter_phrase_2]) */
graveyard_return_alternative ::= "a" filter_phrase "card" "or" "a" filter_phrase "card"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$graveyard_return_alternative}, count:Exactly(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
graveyard_return_single ::= "return" graveyard_return_alternative "from" "your" "graveyard" "to" "your" "hand"

/* One optional selection can be paired with another independent selection. */
/* @sem Instruction::Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, count:Exactly($value)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}} */
graveyard_optional_selection ::= "up" "to" value filter_phrase "card"

/* @sem Instruction::[$graveyard_optional_selection, $graveyard_optional_selection_2] */
graveyard_return_pair ::= "return" graveyard_optional_selection "and" graveyard_optional_selection "from" "your" "graveyard" "to" "your" "hand"

/* @sem PlayerRef::OneOf(OpponentsOf(AbilityController)) */
graveyard_return_opponent_choice ::= "of" "an" "opponent's" "choice"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$graveyard_return_opponent_choice, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$adjective_nontype}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
graveyard_return_opponent ::= "return" "a" adjective_nontype "card" graveyard_return_opponent_choice "from" "your" "graveyard" "to" "your" "hand"

/* @sem PlayerRef::Chosen */
graveyard_chosen_subject ::= "that" "player"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$graveyard_chosen_subject, objects:Zone{scope:Players{zone:Graveyard, players:One($graveyard_chosen_subject)}, kind:Card, filter:Any}, count:AsManyAsCan($card_count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
graveyard_return_chosen ::= graveyard_chosen_subject "returns" card_count "from" "their" "graveyard" "to" "their" "hand"

/* Shared graveyard selection keeps its property test independent of the move. */
/* @sem Operation::Move{objects:One($return_other_qualified_card), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_other_qualified_battlefield ::= "return" return_other_qualified_card "to" "the" "battlefield"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@current_named_object)), $return_other_card_head, $return_card_property, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0} */
return_other_qualified_card ::= "another" "target" return_other_card_head "card" return_card_property "from" "your" "graveyard"

return_other_card_head ::= noun | return_other_card_negated_head

/* @sem @and($subtype_negated, $noun) */
return_other_card_negated_head ::= subtype_negated noun

return_card_property ::= return_property_either_stat

/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:ObjectProperty{object:Source, property:Power, information:CurrentOrLastKnown}}} */
return_property_event_mana ::= "with" "mana" "value" "less" "than" "or" "equal" "to" "this" "creature's" "power"

/* @sem ObjectFilter::Property{property:Power, test:NumberTest::Compare{comparison:LessOrEqual, value:ObjectProperty{object:Source, property:Power, information:CurrentOrLastKnown}}} */
return_property_event_power ::= "with" "equal" "or" "lesser" "power"

/* @sem ObjectFilter::AnyOf([ObjectFilter::Property{property:Power, test:NumberTest::Compare{comparison:Equal, value:$number}}, ObjectFilter::Property{property:Toughness, test:NumberTest::Compare{comparison:Equal, value:$number}}]) */
return_property_either_stat ::= "with" "power" "or" "toughness" number

/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:@and($filter_phrase, $modifier_mana_value_numeric)}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_each_qualified_battlefield ::= "return" "each" filter_phrase "card" modifier_mana_value_numeric "from" "your" "graveyard" "to" "the" "battlefield"

/* Source power is valid here because this trigger is explicitly the source's death. */
/* @sem Ability::Triggered{event:$event_self_dies, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$return_event_qualified_battlefield}]}} */
triggered_source_death_qualified_return ::= "when" event_self_dies "," return_event_qualified_battlefield "."

/* @sem Operation::Move{objects:One($return_event_qualified_card), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_event_qualified_battlefield ::= "return" return_event_qualified_card "to" "the" "battlefield"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@current_named_object)), $return_other_card_head, $return_event_property, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0} */
return_event_qualified_card ::= "another" "target" return_other_card_head "card" return_event_property "from" "your" "graveyard"

return_event_property ::= return_property_event_mana | return_property_event_power

/* Conjure and its immediate singular result stay in the same instruction sequence. */
/* @sem Instruction::[Effect{result:@next, operation:$conjure_single_perpetual_source}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$conjured_perpetual_changes}}] */
instructions_conjure_perpetual ::= conjure_single_perpetual_source "." "it" "perpetually" conjured_perpetual_changes

/* @sem Operation::Conjure{actor:One(AbilityController), card:Named($referenced_card_name), count:Constant(1), destination:Library{position:AmongTop($card_count), arrival:CardArrival{counters:[], states:[]}}} */
conjure_named_random_top ::= "conjure" "a" "card" "named" referenced_card_name "into" "the" "top" card_count "of" "your" "library" "at" "random"

conjured_perpetual_changes ::= quoted_perpetual_grant | quoted_perpetual_cost | conjured_spend_any_type

/* Each object's controller performs the sacrifice. */
/* @sem Operation::Sacrifice{players:All, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}} */
sacrifice_each_by_controller ::= "each" filter_phrase "is" "sacrificed" "by" "its" "controller"

/* These controller actions share their imperative and explicit-subject forms. */
player_action_base ::= exchange_life_with_player | control_player_next_turn

/* @sem $player_action_base */
player_action_you ::= "you" player_action_base

/* @sem Operation::TowardPlayer{actor:One(AbilityController), action:ExchangeLife, player:$player_ref} */
exchange_life_with_player ::= "exchange" "life" "totals" "with" player_ref

/* @sem Operation::TowardPlayer{actor:One(AbilityController), action:ControlNextTurn, player:$player_ref} */
control_player_next_turn ::= "control" player_ref "during" "that" "player's" "next" "turn"

/* Choice lists retain each current vocabulary operand in its printed position. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:CardType, terms:_{count:Exactly(Constant(1)), options:[$choice_card_type, $choice_card_type_2, $choice_card_type_3, $choice_card_type_4, $choice_card_type_5]}} */
choose_card_types_five ::= "choose" choice_card_type "," choice_card_type "," choice_card_type "," choice_card_type "," "or" choice_card_type

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:LandType, terms:_{count:Exactly(Constant(1)), options:[$choice_land_type, $choice_land_type_2]}} */
choose_land_types_pair ::= "choose" choice_land_type "or" choice_land_type

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[Term{family:ChoosableColor, form:ColorList, operands:[$choice_color, $choice_color_2]}]}} */
choose_color_pair ::= "choose" choice_color "or" choice_color

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:PlaneswalkerType, terms:_{count:Exactly(Constant(1)), options:[]}} */
choose_planeswalker_type ::= "choose" "a" "planeswalker" "type"

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:BasicLandType, terms:_{count:Exactly(Constant(2)), options:[]}} */
choose_two_basic_land_types ::= "choose" "two" "basic" "land" "types"

choice_card_type ::= choice_card_type_artifact | choice_card_type_creature | choice_card_type_enchantment | choice_card_type_instant | choice_card_type_sorcery | choice_card_type_planeswalker | choice_card_type_land | choice_card_type_battle

/* @sem Operand::Vocabulary{family:CardType, form:Artifact} */
choice_card_type_artifact ::= "artifact"

/* @sem Operand::Vocabulary{family:CardType, form:Creature} */
choice_card_type_creature ::= "creature"

/* @sem Operand::Vocabulary{family:CardType, form:Enchantment} */
choice_card_type_enchantment ::= "enchantment"

/* @sem Operand::Vocabulary{family:CardType, form:Instant} */
choice_card_type_instant ::= "instant"

/* @sem Operand::Vocabulary{family:CardType, form:Sorcery} */
choice_card_type_sorcery ::= "sorcery"

/* @sem Operand::Vocabulary{family:CardType, form:Planeswalker} */
choice_card_type_planeswalker ::= "planeswalker"

/* @sem Operand::Vocabulary{family:CardType, form:Land} */
choice_card_type_land ::= "land"

/* @sem Operand::Vocabulary{family:CardType, form:Battle} */
choice_card_type_battle ::= "battle"

choice_land_type ::= choice_land_type_plains | choice_land_type_island | choice_land_type_swamp | choice_land_type_mountain | choice_land_type_forest

/* @sem Operand::Vocabulary{family:LandType, form:Plains} */
choice_land_type_plains ::= "Plains"

/* @sem Operand::Vocabulary{family:LandType, form:Island} */
choice_land_type_island ::= "Island"

/* @sem Operand::Vocabulary{family:LandType, form:Swamp} */
choice_land_type_swamp ::= "Swamp"

/* @sem Operand::Vocabulary{family:LandType, form:Mountain} */
choice_land_type_mountain ::= "Mountain"

/* @sem Operand::Vocabulary{family:LandType, form:Forest} */
choice_land_type_forest ::= "Forest"

choice_color ::= choice_color_white | choice_color_blue | choice_color_black | choice_color_red | choice_color_green

/* @sem Operand::Vocabulary{family:Color, form:White} */
choice_color_white ::= "white"

/* @sem Operand::Vocabulary{family:Color, form:Blue} */
choice_color_blue ::= "blue"

/* @sem Operand::Vocabulary{family:Color, form:Black} */
choice_color_black ::= "black"

/* @sem Operand::Vocabulary{family:Color, form:Red} */
choice_color_red ::= "red"

/* @sem Operand::Vocabulary{family:Color, form:Green} */
choice_color_green ::= "green"

/* The willing payer excludes the event's player; the quoted spell cost
   remains attached to the event subject, independently of the payer. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:FirstWilling($willing_payer_pool), cost:$willing_spell_cost, optional:true}}, If{condition:$willing_payment_condition, then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_willing_spell_payment ::= willing_payer_pool "may" willing_spell_cost "." willing_payment_condition "," conjoined

/* @sem PlayerSet::OthersThan(PlayerRef::EventSubject) */
willing_payer_pool ::= "any" "other" "player"

/* @sem Cost::Cost{parts:[ManaCostOf(EventSubject)]} */
willing_spell_cost ::= "pay" "that" "spell's" "mana" "cost"

/* The repeated counter kind and recipient refer to the same source placement. */
/* @sem Operation::PutCountersCapped{amount:$number, kind:PowerToughness([1, 0]), object:Source, at_most:$value} */
put_counters_capped_source_power ::= "put" "up" "to" number "+" "1" "/" "+" "0" "counters" "on" "this" "creature" "." "this" "ability" "can't" "cause" "the" "total" "number" "of" "+" "1" "/" "+" "0" "counters" "on" "this" "creature" "to" "be" "greater" "than" value

/* The same player supplies both the recipient and the live life quantity. */
/* @sem Operation::SetLifeTotal{players:One($life_total_possessive), amount:Multiply($life_total_factor, PlayerNumber{player:$life_total_possessive, number:Life})} */
double_player_life_total ::= life_total_factor life_total_possessive "life" "total"

life_total_factor ::= life_total_double | life_total_triple

/* @sem Expr::Constant(2) */
life_total_double ::= "double"

/* @sem Expr::Constant(3) */
life_total_triple ::= "triple"

life_total_possessive ::= target_possessive | life_total_event_controller | zone_your

/* @sem PlayerRef::ControllerOf(@damage_relative_object) */
life_total_event_controller ::= "its" "controller's"

/* Select from the damaged player's hand; the follow-up owns the selection and
   the cast permission, shared by the mandatory and optional observations. */
/* @sem Operation::PickFromHand{actor:One(AbilityController), player:EventSubject, filter:Any, count:UpTo($counter_a), then:CastFree} */
hand_cast_free_selection ::= "you" "may" "cast" counter_a "spell" "from" "among" "those" "cards" "without" "paying" "its" "mana" "cost"

/* @sem Instruction::[Effect{result:@next, operation:$hand_cast_free_selection}] */
instructions_hand_look_cast ::= "look" "at" "that" "player's" "hand" "." hand_cast_free_selection

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$hand_cast_free_selection}]}}] */
instructions_optional_hand_look_cast ::= "you" "may" "look" "at" "that" "player's" "hand" "." "if" "you" "do" "," hand_cast_free_selection

/* The same named player owns both the hand and the destination library. */
/* @sem Instruction::[Effect{result:@next, operation:PickFromHand{actor:One(AbilityController), player:$target_possessive, filter:Any, count:Exactly($hand_choice_library_count), then:TopOfLibrary}}] */
instructions_hand_choose_library ::= "look" "at" target_possessive "hand" "and" hand_choice_library_count

/* @sem $card_count_many */
hand_choice_library_count ::= "choose" card_count_many "from" "it" "." "put" "them" "on" "top" "of" "that" "player's" "library" "in" "any" "order"

/* The selection is drawn cards, not an unrestricted discard from hand.
   The subject is supplied by the enclosing imperative or player clause. */
/* @sem Operation::DrawThenDiscard{players:@subject, draw:$card_count, discard:$drawn_discard_selection} */
draw_selected_discard_base ::= "draw" card_count "," "then" "discard" drawn_discard_selection

/* @sem Operation::DrawThenDiscard{players:@subject, draw:$card_count, discard:$drawn_discard_selection} */
draw_selected_discard_third ::= "draws" card_count "," "then" "discards" drawn_discard_selection

/* @sem $value */
drawn_discard_selection ::= value "of" "them"

/* The singular source is the antecedent of the regeneration callback. */
/* @sem Operation::CreateRegenerationShields{objects:One($self_explicit_ref)} */
regenerate_self_action ::= "regenerate" self_explicit_ref

/* @sem Instruction::[Effect{result:@next, operation:WithReflexive{action:$regenerate_self_action, when:Regenerates, body:Program($program)}}] */
instructions_regenerate_self_callback ::= regenerate_self_action "." "when" "it" "regenerates" "this" "way" "," program

/* A stack spell retains its independently specified target filter. */
/* @sem Operation::@owner_return(Operation::Move{objects:One($target_stack_spell), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}) */
return_target_stack_spell_hand ::= "return" target_stack_spell "to" "its" "owner's" "hand"

/* A total mana-value constraint applies to the chosen group, not to each card. */
/* @sem Operand::Term{family:GroupFilter, form:TotalManaValueIs, operands:[Comparison([LessOrEqual, $value])]} */
cast_total_mana_cap ::= "with" "total" "mana" "value" value "or" "less"

/* @sem ObjectSet::Transition{result:@prior, phase:After} */
cast_prior_population ::= "them"

/* @sem Operation::PlayWith{actor:One(AbilityController), action:CastSpell, cards:$cast_prior_population, count:AnyNumber, terms:_{cost:Free}, group:$cast_total_mana_cap} */
cast_any_prior_capped ::= "you" "may" "cast" "any" "number" "of" "spells" cast_total_mana_cap "from" "among" cast_prior_population "without" "paying" "their" "mana" "costs"

/* A note is an ordinary instruction and composes with entry programs. */
/* @sem Operation::Note($note_information_kind) */
note_information ::= "note" note_information_kind

note_information_kind ::= note_life_total | note_prevalent_opponent_library

/* @sem NoteKind::LifeTotal */
note_life_total ::= "your" "life" "total"

/* @sem NoteKind::MostCommonCreatureType(OpponentsOf(AbilityController)) */
note_prevalent_opponent_library ::= "the" "most" "prevalent" "creature" "type" "in" "an" "opponent's" "library"

/* A temporary zone-change replacement composes its event, duration and redirect. */
/* @sem Operation::CreateReplacement{event:$temporary_graveyard_event, limit:UntilExpired, duration:$this_duration, body:$temporary_graveyard_redirect_body} */
temporary_graveyard_redirect ::= "if" temporary_graveyard_event this_duration "," temporary_graveyard_redirect_body "instead"

/* @sem EventSpec::ZoneChange{objects:AllOf([$temporary_graveyard_card, OwnedBy(One(AbilityController)), Not(Token)]), to:Graveyard} */
temporary_graveyard_event ::= temporary_graveyard_card "would" "be" "put" "into" "your" "graveyard" "from" "anywhere"

temporary_graveyard_card ::= temporary_graveyard_any_card | temporary_graveyard_creature_card

/* @sem ObjectFilter::Any */
temporary_graveyard_any_card ::= "a" "card"

/* @sem ObjectFilter::CardType(Creature) */
temporary_graveyard_creature_card ::= "a" "creature" "card"

temporary_graveyard_redirect_body ::= temporary_graveyard_exile_that_card | temporary_graveyard_exile_it

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]} */
temporary_graveyard_exile_that_card ::= "exile" "that" "card"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]} */
temporary_graveyard_exile_it ::= "exile" "it"

/* Choose from a card population and remove the triggering event amount. */
/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($owned_suspended_card_population), kind:$counter_kind, amount:Count(Exactly(EventAmount)), selection:_{player:AbilityController, count:Exactly(Constant(1))}}]} */
choose_suspended_remove_event_counters ::= "choose" "a" owned_suspended_card_population "and" "remove" "that" "many" counter_kind "counters" "from" "it"

/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($owned_suspended_card_population), kind:$counter_kind, amount:Count(Exactly($value))}]} */
remove_each_suspended_counters ::= "remove" value counter_kind "counters" "from" "each" owned_suspended_card_population

/* A free cast separates the spell filter from its eligible card population. */
/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([Not(State(FaceDown)), OwnedBy(OpponentsOf(AbilityController))])}) */
free_cast_face_up_opponents_exile ::= "face-up" "cards" "your" "opponents" "own" "from" "exile"

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:$free_cast_face_up_opponents_exile, count:UpTo($value), cost:Free} */
cast_up_to_free_exile_population ::= "you" "may" "cast" "up" "to" value "spells" "from" "among" free_cast_face_up_opponents_exile "without" "paying" "their" "mana" "costs"

/* The phrase is used only inside the adjacent top-library exile contract. */
/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:InSet(Transition{result:@marked, phase:After})}), filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value_2}}])}, count:UpTo($value), cost:Free} */
cast_up_to_exile_receipt_filtered ::= "you" "may" "cast" "up" "to" value card_filter "spells" "with" "mana" "value" value "or" "less" "from" "among" "them" "without" "paying" "their" "mana" "costs"

/* The producer, permission and remaining cards share one actual exile receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:$cast_up_to_exile_receipt_filtered}, Effect{result:@next, operation:Move{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:InSet(Transition{result:@marked, phase:After})}), destination:Library{position:BottomRandom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
instructions_exile_top_cast_remainder ::= exile_top_cards_of_your_library "." cast_up_to_exile_receipt_filtered "." "put" "the" "exiled" "cards" "not" "cast" "this" "way" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* A repeated payment consumes only the actual receipt of its typed producer. */
/* @sem Instruction::[Effect{result:@mark, operation:Draw{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:PayRepeatedly{player:AbilityController, cost:$cost, at_most:Performed(@marked)}}, Effect{result:@next, operation:Discard{players:One(AbilityController), amount:Subtract([Performed(@marked), Performed(@prior)]), random:false}}] */
clause_draw_repeated_payment ::= "draw" card_count "." "for" "each" "card" "drawn" "this" "way" "," "discard" "a" "card" "unless" "you" cost

/* The counter kind is fixed on both sides; the recipient and payment remain operands. */
/* @sem Instruction::[Effect{result:@mark, operation:$remove_all_delay_counters}, Effect{result:@next, operation:PayRepeatedly{player:AbilityController, cost:$cost, at_most:CountersRemoved(@marked)}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:Subtract([CountersRemoved(@marked), Performed(@prior)])}}] */
clause_delay_repeated_payment ::= remove_all_delay_counters "." "for" "each" "delay" "counter" "removed" "this" "way" "," "you" "lose" "1" "life" "unless" "you" "pay" cost

/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:Named(DelayCounter), amount:All}]} */
remove_all_delay_counters ::= "remove" "all" "delay" "counters" "from" affected

/* The immediate conjure result is the card receiving the perpetual change. */
/* @sem Instruction::[Effect{result:@next, operation:$conjure_duplicate_spell_hand}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$duplicate_card_perpetual_changes}}] */
instructions_duplicate_perpetual ::= conjure_duplicate_spell_hand "." "that" "card" "perpetually" duplicate_card_perpetual_changes

/* @sem Operation::Conjure{actor:One(AbilityController), card:Duplicate(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:Any}), index:0})), count:$counter_amount, destination:Hand(CardArrival{counters:[], states:[]})} */
conjure_duplicate_spell_hand ::= "conjure" counter_amount "duplicate" "of" "target" "spell" "into" "your" "hand"

/* @sem Change::[GrantAbility(Casting(SpendAsThoughAnyType))] */
duplicate_card_perpetual_changes ::= "gains" '"' "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "this" "spell" "." '"'

/* A selected hand-card set receives the quoted stack ability. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_hand_union}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Earlier{what:Selected}), changes:[$perpetual_cast_grant_once]}}] */
instructions_hand_union_perpetual ::= choose_hand_union "." "they" "perpetually" "gain" '"' perpetual_cast_grant_once '"'

/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AnyOf([$filter_phrase, $filter_phrase_2])}), count:UpTo($value)} */
choose_hand_union ::= "choose" "up" "to" value filter_phrase "and" "/" "or" filter_phrase "cards" "in" "your" "hand"

/* @sem Change::GrantAbility(Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:Spell{event:Cast, players:One(AbilityController), spells:SameObject($object_ref)}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:CreatePerpetualEffect{objects:$affected, changes:[LosesAbility(Term{family:CheckHasable, form:ThisAbility})]}}]}})}) */
perpetual_cast_grant_once ::= "when" "you" "cast" affected "," operation "and" object_ref "perpetually" "loses" "this" "ability" "."

/* Keep the optional payment and its successful selection in one scope. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:$optional_hand_card_choice}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:_{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$incorporated_black_grant}}]}, otherwise:_{}}] */
instructions_optional_hand_perpetual ::= "you" "may" optional_hand_card_choice "." "if" "you" "do" "," "that" "card" "perpetually" incorporated_black_grant

/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$adjective_nontype}), count:AsManyAsCan(Constant(1))} */
optional_hand_card_choice ::= "choose" "a" adjective_nontype "card" "in" "your" "hand"

/* @sem Change::[Incorporate([Generic(1), Color(Black)]), GrantAbility(Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:Spell{event:Cast, players:One(AbilityController), spells:SameObject($object_ref)}, limits:_{}, announcement:@announcement, body:$program})})] */
incorporated_black_grant ::= "incorporates" "{" "1" "}" "{" "B" "}" "and" "gains" '"' "when" "you" "cast" object_ref "," program "." '"'

/* Each opponent's failed sacrifice is determined from that opponent's own receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Sacrifice{players:OpponentsOf(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Discard{players:Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Not(Compare{left:CountObjects(Matching{objects:MovedBy{result:@prior, phase:Before, player:Bound(0)}, filter:Any}), test:Compare{comparison:Greater, value:Constant(0)}})}]), amount:Constant(1), random:false}}] */
instructions_opponents_sacrifice_cant_discard ::= "each" "opponent" "sacrifices" "a" filter_phrase "of" "their" "choice" "." "each" "opponent" "who" "can't" "discards" "a" "card"

/* A resolving payment can combine mana with a graveyard exile cost. */
/* @sem Cost::Cost{parts:[Mana($mana_symbols), $cost_exile_cards_graveyard]} */
payment_mana_and_graveyard_exile ::= "pay" mana_symbols "and" cost_exile_cards_graveyard

/* Keep the random selection, exile arrival and its permission in one scope. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}), count:AsManyAsCan($random_single_card), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}] */
random_graveyard_exile_play ::= "exile" random_single_card "from" "your" "graveyard" "at" "random" "." "you" "may" "play" "the" "exiled" "card" this_duration

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$random_an_card_filter}), count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:CastSpell, filter:Any}, terms:_{cost:Normal, into_exile:true}})], duration:$this_duration, evaluation:LiveObjects}}] */
random_graveyard_exile_cast ::= "exile" "an" random_an_card_filter "card" "at" "random" "from" "your" "graveyard" "." "you" "may" "cast" "it" this_duration "." "if" "a" "spell" "cast" "this" "way" "would" "be" "put" "into" "your" "graveyard" "," "exile" "it" "instead"

/* @sem Expr::Constant(1) */
random_single_card ::= ("a" | "one") "card"

random_an_card_filter ::= filter_instant_or_sorcery | spell_instant

/* The event subject's owner supplies both the graveyard and the controller. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Graveyard, players:One(OwnerOf(EventSubject))}, kind:Card, filter:$card_filter}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(OwnerOf(EventSubject)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]} */
death_owner_return_program ::= "return" "a" card_filter "card" "from" "its" "owner's" "graveyard" "to" "the" "battlefield" "under" "the" "control" "of" "that" "creature's" "owner"

/* The mode list supplies both the alternatives and the upper bound. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Conditional{condition:$graveyard_card_types_threshold, then:@length($modes), otherwise:Constant(1)}}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_graveyard_types_or_more ::= "choose" "one" "." "if" graveyard_card_types_threshold "," "choose" "one" "or" "more" "instead" "." NEWLINE modes

/* Delayed death triggers retain the prior target and their independent body. */
/* @sem Instruction::[Effect{result:@next, operation:@scope(Operation::CreateTrigger{event:$controlled_target_death_event, duration:EndOfTurn, body:Program{instructions:$instructions}, announcement:@announcement})}] */
temporary_controlled_target_death ::= "when" controlled_target_death_event "this" "turn" "," instructions

/* @sem Instruction::[Effect{result:@next, operation:@scope(Operation::CreateTrigger{event:$damaged_target_death_event, duration:EndOfTurn, body:Program{instructions:$instructions}, announcement:@announcement})}] */
temporary_damaged_target_death ::= "whenever" damaged_target_death_event "this" "turn" "," instructions

/* The named player performs the flip and the immediately following outcome
   refers to that same player and result. The branch remains compositional. */
/* @sem Instruction::[Effect{result:@mark, operation:FlipCoin{player:$that_player_word, protocol:@coin_protocol}}, If{condition:CoinFlip{result:@marked, outcome:$that_player_flip_outcome}, then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_that_player_flip_if ::= that_player_word "flips" "a" "coin" "." "if" that_player_flip_outcome "the" "flip" "," conjoined

that_player_flip_outcome ::= flip_player_wins | flip_player_loses | flip_they_win | flip_they_lose

/* @sem CoinOutcome::Won */
flip_player_wins ::= "the" "player" "wins"

/* @sem CoinOutcome::Lost */
flip_player_loses ::= "the" "player" "loses"

/* @sem CoinOutcome::Won */
flip_they_win ::= "they" "win"

/* @sem CoinOutcome::Lost */
flip_they_lose ::= "they" "lose"

/* Simultaneous operations keep both independent operands in one effect. The
   surface order is untap/tap while Together stores its members in reverse order. */
/* @sem Operation::Together([$action_2, $action]) */
simultaneous_imperative_pair ::= action "and" action

/* @sem Operation::$simultaneous_imperative_pair */
simultaneous_imperative ::= "simultaneously" simultaneous_imperative_pair

/* The third-person forms are separate from the imperative forms. */
simultaneous_third_action ::= simultaneous_third_tap | simultaneous_third_untap

/* @sem Operation::SetTapped{objects:$affected, tapped:true} */
simultaneous_third_tap ::= "taps" affected

/* @sem Operation::SetTapped{objects:$affected} */
simultaneous_third_untap ::= "untaps" affected

/* @sem Operation::Together([$simultaneous_third_action_2, $simultaneous_third_action]) */
simultaneous_third_pair ::= simultaneous_third_action "and" simultaneous_third_action

/* @sem Operation::$simultaneous_third_pair */
simultaneous_event_player ::= "that" "player" "simultaneously" simultaneous_third_pair

/* The named player chooses the survivors from the specified population. */
/* @sem Operation::SacrificeAllBut{players:@subject, objects:$affected, keep:$value} */
sacrifice_choose_keep_third ::= "chooses" "up" "to" value affected "they" "control" "," "then" "sacrifices" "the" "rest"

/* @sem Operation::SacrificeAllBut{players:@subject, objects:$affected, keep:ChosenNumber} */
sacrifice_keep_chosen_third ::= "sacrifices" "all" "but" "that" "many" affected "of" "their" "choice"

/* @sem Operation::ChooseValue{choosers:@subject, kind:Number, terms:_{count:Exactly(Constant(1)), options:[]}} */
choose_number_third ::= "chooses" "a" "number"

/* @sem Operation::Scry{players:@subject, amount:$value} */
scry_where_value ::= "scry" "X" "," "where" "X" "is" value

/* A temporary mana grant and the source card's independent casting permission. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$noun}), index:0})), changes:[GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:_{parts:[TapSymbol]}, limits:_{}, body:_{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:$mana_production}}]}, announcement:@announcement}))], duration:UntilCast(Source), evaluation:Snapshot} */
target_mana_grant_until_source_cast ::= "target" noun "gains" '"' "{" "T" "}" ":" "add" mana_production '"' "until" "this" "card" "is" "cast" "from" "exile"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Source), from:Exile, action:CastSpell, filter:Any})], duration:Indefinite, evaluation:LiveObjects} */
cast_source_while_exiled ::= "you" "may" "cast" "this" "card" "for" "as" "long" "as" "it" "remains" "exiled"

/* Turning the linked population and referring to its recorded names are one
   producer-consumer unit: the anaphor cannot bind an unrelated result. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::TurnFaceUp, objects:Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([State(FaceDown), ExiledWith($object_ref)])})} */
turn_linked_cards_face_up ::= "turn" "all" "cards" "exiled" "with" object_ref "face" "up"

/* @sem Instruction::[Effect{result:@next, operation:$turn_linked_cards_face_up}, Effect{result:@next, operation:Counter{objects:Zone(_{scope:Shared(Stack), kind:Spell, filter:SharesNameWithAny(Zone(_{scope:Shared(Exile), kind:Card, filter:InSet(Recorded(@prior))}))}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}] */
instructions_turn_linked_counter_names ::= turn_linked_cards_face_up "." "counter" "all" "spells" "with" "those" "names"

/* The anaphoric removal shares the tested object and counter kind. */
/* @sem Instruction::[If{condition:ObjectMatches{object:$object_ref, filter:Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$value})}, then:Program{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($object_ref)), kind:$counter_kind, amount:All}]}}, Effect{result:@next, operation:$operation}]}, otherwise:Program{}}] */
clause_counter_threshold_remove_them ::= "if" object_ref "has" value "or" "more" counter_kind "counters" "on" "it" "," "remove" "them" "all" "and" operation

/* @sem Instruction::[If{condition:ObjectMatches{object:$object_ref, filter:Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$value})}, then:Program{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($object_ref)), kind:$counter_kind, amount:All}]}}, Effect{result:@next, operation:$operation}]}, otherwise:Program{}}] */
clause_counter_threshold_remove_those ::= "if" "there" "are" value "or" "more" counter_kind "counters" "on" object_ref "," "remove" "those" "counters" "and" operation

/* Conjured-card selection is independent of the destination and quantity. */
/* @sem Operation::Conjure{actor:One(AbilityController), card:$conjured_exile_card, count:$conjure_singular_amount, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
conjure_card_into_exile ::= "conjure" conjure_singular_amount conjured_exile_card "into" "exile"

/* @sem Expr::Constant(1) */
conjure_singular_amount ::= "a"

conjured_exile_card ::= conjured_duplicate | conjured_random_expansion_card

/* @sem ConjuredCard::Duplicate($affected) */
conjured_duplicate ::= "duplicate" "of" affected

/* @sem ConjuredCard::Random($conjured_expansion_filter) */
conjured_random_expansion_card ::= "random" conjured_expansion_filter "card" "from" "the" "Lorwyn" "Eclipsed" "expansion"

/* @sem Operand::Term{family:CardsInOracle, form:And, operands:[Term{family:CardsInOracle, form:Or, operands:[$conjured_oracle_type, $conjured_oracle_type_2]}, Term{family:CardsInOracle, form:FromTheLorwynEclipsedExpansion}]} */
conjured_expansion_filter ::= conjured_oracle_type "or" conjured_oracle_type

conjured_oracle_type ::= conjured_oracle_instant | conjured_oracle_sorcery | conjured_oracle_artifact | conjured_oracle_creature

/* @sem Operand::Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Instant}]} */
conjured_oracle_instant ::= "instant"

/* @sem Operand::Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Sorcery}]} */
conjured_oracle_sorcery ::= "sorcery"

/* @sem Operand::Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Artifact}]} */
conjured_oracle_artifact ::= "artifact"

/* @sem Operand::Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Creature}]} */
conjured_oracle_creature ::= "creature"

/* The prohibition refers to the actual objects affected by this phase-out. */
/* @sem Instruction::[Effect{result:@next, operation:KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::PhaseOut{}, objects:$objects_each}}, Effect{result:@next, operation:GameEffect{until:$duration, effect:Term{family:GameEffect, form:PermanentsCantPhaseIn, operands:[Objects(Affected(@prior))]}}}] */
phase_out_each_cant_return ::= objects_each "phases" "out" "." duration "," "they" "can't" "phase" "in"

/* The mentioned player's control remains an operand of the move. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$affected, destination:Battlefield{controller:Player(@that_player), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
return_under_that_player ::= "return" affected "to" "the" "battlefield" "under" "that" "player's" "control"

/* Play actions retain the linked population, quantity and payment independently. */
/* @sem ObjectSet::Matching{objects:$linked_exile_cards, filter:AnyOf([$filter_phrase, Any])} */
free_linked_land_or_spell ::= filter_phrase "or" "cast" "a" "spell" "from" "among" "the" linked_exile_cards

/* @sem Operation::PlayWith{actor:One(AbilityController), action:Either, cards:$free_linked_land_or_spell, count:Exactly($counter_amount), terms:_{cost:Free}} */
play_free_linked_land_or_spell ::= "play" counter_amount free_linked_land_or_spell "without" "paying" "its" "mana" "cost"

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)}), ExiledBy{player:OneOf(One(AbilityController))}])}) */
controlled_exile_counter_card ::= "from" "exile" "with" "a" counter_kind "counter" "on" "it" "if" "it" "was" "exiled" "by" "an" "ability" "you" "controlled"

/* @sem Operation::PlayWith{actor:One(AbilityController), action:Either, cards:$controlled_exile_counter_card, count:Exactly($card_count_one), terms:_{cost:Normal, spend_as:AnyColor}} */
play_controlled_exile_counter_card ::= "play" card_count_one controlled_exile_counter_card "," "and" "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "it"

once_turn_play_operation ::= play_free_linked_land_or_spell | play_controlled_exile_counter_card

/* An opponent's unchosen graveyard selection can be repeated after a payment. */
/* @sem Instruction::Repeatable{instructions:[$graveyard_repeat_choice, $graveyard_repeat_payment, $graveyard_repeat_again]} */
graveyard_repeat_process ::= graveyard_repeat_choice "." graveyard_repeat_payment "." graveyard_repeat_again

/* @sem Instruction::Effect{result:@next, operation:ChooseValue{choosers:$players_singular, kind:Object, terms:_{options:[Objects(Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}))], unchosen:true, count:Exactly(Constant(1))}}} */
graveyard_repeat_choice ::= players_singular "chooses" "a" "card" "in" "your" "graveyard"

/* @sem Instruction::Effect{result:@next, operation:PayCost{player:AbilityController, cost:$cost, optional:true}} */
graveyard_repeat_payment ::= "you" "may" "pay" cost

/* @sem Instruction::If{condition:PaymentChosen(@last_result), then:_{instructions:[Effect{result:@next, operation:RepeatProcess}]}, otherwise:_{}} */
graveyard_repeat_again ::= "if" "you" "do" "," "repeat" "this" "process" "except" "that" "opponent" "can't" "choose" "a" "card" "already" "chosen" "for" SELF_NAME

/* @sem Instruction::Effect{result:@next, operation:Move{objects:One(Earlier{what:Selected}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}} */
graveyard_last_choice_to_hand ::= "then" "put" "the" "last" "chosen" "card" "into" "your" "hand"

/* @sem Instruction::[$graveyard_repeat_process, $graveyard_last_choice_to_hand] */
instructions_graveyard_repeat ::= graveyard_repeat_process "." graveyard_last_choice_to_hand

/* Each chooser uses the same filtered graveyard, with turn order explicit. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, starting_with:Seat{of:AbilityController, side:Next}, body:_{instructions:[$ordered_graveyard_choice]}}] */
ordered_opponent_graveyard_choice ::= "then" "starting" "with" "the" "next" "opponent" "in" "turn" "order" "," players_singular ordered_graveyard_choice

/* @sem Instruction::Effect{result:@next, operation:ChooseValue{choosers:One(Bound(0)), kind:Object, terms:_{options:[Filter(AllOf([$filter_phrase, InZone(Players{zone:Graveyard, players:One(AbilityController)})]))], unchosen:true, count:Exactly(Constant(1))}}} */
ordered_graveyard_choice ::= "chooses" "a" filter_phrase "card" "in" "your" "graveyard" "that" "hasn't" "been" "chosen"

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:InSet(Earlier{what:Selected})}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
return_each_chosen_graveyard ::= "return" "each" "card" "chosen" "this" "way" "to" "the" "battlefield" "under" "your" "control"

/* A singular owned object can be selected from these two public zones. */
/* @sem ObjectSet::Union([Zone{scope:Shared(Battlefield), kind:Card, filter:AllOf([$noun, OwnedBy(One(AbilityController))])}, Zone{scope:Shared(Command), kind:Card, filter:AllOf([$noun, OwnedBy(One(AbilityController))])}]) */
owned_battlefield_command_object ::= noun "you" "own" "on" "the" "battlefield" "or" "in" "the" "command" "zone"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$owned_battlefield_command_object, count:Exactly($owned_choice_article)}}, Effect{result:@mark, operation:BindValue{value:ObjectProperty{object:Result{result:@prior, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:BoundValue(@marked)}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:BoundValue(@marked)}}] */
instructions_draw_loss_defined ::= "you" "draw" "X" "cards" "and" "you" "lose" "X" "life" "," "where" "X" "is" "the" "mana" "value" "of" owned_choice_article owned_battlefield_command_object

owned_choice_article ::= owned_choice_a | owned_choice_an

/* @sem Expr::Constant(1) */
owned_choice_a ::= "a"

/* @sem Expr::Constant(1) */
owned_choice_an ::= "an"

/* The reveal and its immediate consumer share the same target hand; no intervening action can change the population. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:CardType, terms:_{count:Exactly(Constant(1)), options:[]}}}, Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($callback_hand_player)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:@times($token_amount, Expr::CountObjects(Matching{objects:Zone{scope:Players{zone:Hand, players:One($callback_hand_player)}, kind:Card, filter:Any}, filter:Chosen(CardType)})), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
clause_choose_type_reveal_hand_tokens ::= "choose" "a" "card" "type" "." callback_hand_player "reveals" "their" "hand" "." "create" token_amount token_recipe "for" "each" "card" "of" "the" "chosen" "type" "revealed" "this" "way"

/* Bind the counted receipt to the immediately preceding draw, including its player and amount. */
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:$players_singular, amount:$card_count}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Performed(@prior)}}] */
instructions_draw_receipt_draw ::= players_singular "draws" card_count "." "you" "draw" "a" "card" "for" "each" "card" "drawn" "this" "way"

/* Two recipient sets take independently specified amounts in one damage event. */
/* @sem Operation::DealDamageParts{source:$object_ref, parts:[_{recipients:$recipients, amount:$value}, _{recipients:$recipients_2, amount:$value_2}], preventable:true} */
deal_damage_split_recipients ::= object_ref "deals" value "damage" "to" recipients "and" value "damage" "to" recipients

/* The second recipient takes half the defined amount, rounded up. */
/* @sem Recipients::$recipients */
half_x_damage_recipient ::= "half" "X" "damage" "," "rounded" "up" "," "to" recipients

/* @sem Operation::DealDamageParts{source:$object_ref, parts:[_{recipients:$recipients, amount:$value}, _{recipients:$half_x_damage_recipient, amount:Divide{numerator:$value, denominator:Constant(2), rounding:Up}}], preventable:true} */
deal_damage_split_half ::= object_ref "deals" "X" "damage" "to" recipients "and" half_x_damage_recipient "," "where" "X" "is" value

/* A singular player population performs one action per bound player. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_player_action}]}}] */
clause_each_bound_action ::= players_singular bound_player_action

/* @sem Operation::FlipCoin{player:Bound(0), protocol:@coin_protocol} */
bound_player_action ::= "flips" "a" "coin"

/* The repeat keeps both named participants in its stopping condition. */
/* @sem Instruction::[Repeatable{instructions:[ForEachPlayer{players:Union([One(AbilityController), $players_singular]), binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_coin_base}]}}, $coin_outcome_damage, If{condition:Not(AllOf([CoinCameUp{player:Some(@single_player($players_singular)), outcome:$coin_result_heads}, CoinCameUp{player:AbilityController, outcome:$coin_result_heads}])), then:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}]}] */
repeat_two_player_coin_process ::= "you" "and" players_singular "each" bound_coin_base "." coin_outcome_damage "." "repeat" "this" "process" "until" "both" "players'" "coins" "come" "up" coin_result_heads "on" "the" "same" "flip"

/* @sem Operation::FlipCoin{player:Bound(0), protocol:@coin_protocol} */
bound_coin_base ::= "flip" "a" "coin"

/* @sem Instruction::Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(Matching{binding:0, condition:CoinCameUp{player:Bound(0), outcome:$coin_result_tails}}), amount:$value, preventable:true}} */
coin_outcome_damage ::= object_ref "deals" value "damage" "to" "each" "player" "whose" "coin" "comes" "up" coin_result_tails

/* @sem CoinOutcome::Heads */
coin_result_heads ::= "heads"

/* @sem CoinOutcome::Tails */
coin_result_tails ::= "tails"

conjure_single_perpetual_source ::= conjure_named_random_top | conjure_source_spellbook_personal

/* @sem Change::[GrantAbility(Casting(SpendAsThoughAnyType))] */
conjured_spend_any_type ::= "gains" '"' "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "this" "spell" "." '"'

/* The same player and card predicate apply to both private zones. */
/* @sem Operation::Move{objects:Union([Zone(_{scope:Players{zone:Hand, players:One($player_possessive)}, kind:Card, filter:$card_filter}), Zone(_{scope:Players{zone:Graveyard, players:One($player_possessive)}, kind:Card, filter:$card_filter})]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_hand_graveyard_cards ::= "exile" "all" card_filter "cards" "from" player_possessive "hand" "and" "graveyard"

/* @sem Operation::Move{objects:Union([Zone(_{scope:Players{zone:Hand, players:One($player_possessive)}, kind:Card, filter:Any}), Zone(_{scope:Players{zone:Graveyard, players:One($player_possessive)}, kind:Card, filter:Any})]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_hand_graveyard_any ::= "exile" "all" "cards" "from" player_possessive "hand" "and" "graveyard"

/* The property refers to the immediately preceding single-card discard, not
   an arbitrary transition. Keep producer and consumer together for printing. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:Discard{players:One(AbilityController), amount:Constant(1)}}, Effect{result:@next, operation:LoseLife{players:$players_singular, amount:ObjectProperty{object:Query{objects:Transition{result:@prior, phase:Before}, index:0}, property:$receipt_stat, information:CurrentOrLastKnown}}}]} */
draw_discard_property_program ::= "draw" card_count "," "then" "discard" "a" "card" "." players_singular "loses" "life" "equal" "to" "the" "discarded" "card's" receipt_stat

/* The choice is made before acting on the resulting battlefield population. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:CreatureType, terms:_{count:Exactly(Constant(1)), options:[]}}}, Effect{result:@next, operation:SetTapped{objects:$chosen_type_population, tapped:false}}] */
instructions_untap_chosen_type ::= "untap" chosen_type_population

/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:CreatureType, terms:_{count:Exactly(Constant(1)), options:[]}}}, Effect{result:@next, operation:SetTapped{objects:$chosen_type_population, tapped:true}}] */
instructions_tap_chosen_type ::= "tap" chosen_type_population

/* A bounded X payment carries its bound alongside the dependent program. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[ManaXBounded{mana:[X], comparison:LessOrEqual, value:$life_gained_bound}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
instructions_pay_bounded_x ::= "you" "may" "pay" "{" "X" "}" "." "if" "you" "do" "," conjoined "." "x" "can't" "be" "greater" "than" life_gained_bound

/* @sem Expr::EventHistory{event:Player{event:GainsLife, players:One(AbilityController)}, window:ThisTurn, measure:TotalAmount} */
life_gained_bound ::= "the" "amount" "of" "life" "you" "gained" "this" "turn"

/* Both mentions of the sacrificed population must agree; the count belongs to
   this exact cost component and its performed Before receipt. */
/* @sem Instruction::[Optional{decider:AbilityController, body:@reflexive(Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($filter_plural, $filter_plural_2)}, choose:UpTo($value)}]}, optional:false}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:$players_singular, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural_3}, choose:AsManyAsCan(CountObjects(CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:Before}))})}]}})}]})}] */
instructions_optional_sacrifice_receipt ::= "you" "may" "sacrifice" "up" "to" value filter_plural "." "when" "you" "sacrifice" "one" "or" "more" filter_plural "this" "way" "," players_singular "sacrifices" "that" "many" filter_plural "of" "their" "choice"

/* A required sacrifice followed by its payment-success branch. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$player_ref, cost:$choice_sacrifice_cost, optional:false}}, If{condition:PaymentChosen(@last_result), then:$program, otherwise:Program{}}] */
clause_player_sacrifice_if_done ::= player_ref choice_sacrifice_cost "." "if" "that" "player" "does" "," program

/* @sem Cost::Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly($counter_amount)}]} */
choice_sacrifice_cost ::= "sacrifices" counter_amount filter_phrase "of" "their" "choice"

/* The target creature supplies both the payer and the measured property. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf($unregenerable_target), cost:$target_stat_life_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One(Target{slot:@last_slot, index:0}), regeneration:false}}]}, otherwise:Program{}}] */
clause_destroy_unless_stat_life ::= "destroy" unregenerable_target "unless" "its" "controller" "pays" target_stat_life_cost "." "a" "creature" "destroyed" "this" "way" "can't" "be" "regenerated"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0} */
unregenerable_target ::= "target" "creature"

/* @sem Cost::Cost{parts:[Life(ObjectProperty{object:Target{slot:@last_slot, index:0}, property:$stat, information:CurrentOrLastKnown})]} */
target_stat_life_cost ::= "life" "equal" "to" "its" stat

/* The next damage to the source can be redirected to that source's owner. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject(Source)), kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:TotalDamage($number), duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage(Players(One(OwnerOf(Source))))}}]}} */
redirect_next_damage_to_owner ::= "the" "next" number "damage" "that" "would" "be" "dealt" "to" "this" "creature" this_duration "is" "dealt" "to" "its" "owner" "instead"

/* Redirect a spell's damage back to the controller of the damage source. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Spell, sources:AnyOf([CardType(Instant), CardType(Sorcery)]), recipients:Players(One(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:NextOccurrence, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage(Players(One(ControllerOf(Damage(Source)))))}}]}} */
redirect_next_spell_damage_to_controller ::= "the" "next" "time" "an" "instant" "or" "sorcery" "spell" "would" "deal" "damage" "to" "you" this_duration "," "that" "spell" "deals" "that" "damage" "to" "its" "controller" "instead"

/* The target in the first sentence is the source of the later damage. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Permanent, sources:SameObject($chosen_damage_creature), recipients:Players(OpponentsOf(AbilityController)), kind:Combat, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([$damage_factor, EventAmount]))}}]}} */
multiply_chosen_creature_combat_damage ::= "choose" chosen_damage_creature "." duration "," "if" "that" "creature" "would" "deal" "combat" "damage" "to" "one" "of" "your" "opponents" "," "it" "deals" damage_factor "that" "damage" "to" "that" "player" "instead"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0} */
chosen_damage_creature ::= "target" "creature"

/* These movements use the exiled holder, not an arbitrary prior object. */
exiled_holder_move ::= exiled_holder_put | exiled_holder_put_attacking | exiled_holder_return

/* @sem Operation::Move{objects:InZone{objects:One(Source), zone:Exile}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]} */
exiled_holder_put ::= "put" "it" "onto" "the" "battlefield"

/* @sem Operation::Move{objects:InZone{objects:One(Source), zone:Exile}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{states:[Attacking{}]}}, qualifiers:[]} */
exiled_holder_put_attacking ::= "put" "it" "onto" "the" "battlefield" "attacking"

/* @sem Operation::Move{objects:InZone{objects:One(Source), zone:Exile}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]} */
exiled_holder_return ::= "return" "it" "to" "the" "battlefield"

exiled_holder_program ::= exiled_holder_one_move | exiled_holder_operation_then_if

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$exiled_holder_move}]} */
exiled_holder_one_move ::= exiled_holder_move

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$operation}, If{condition:$exiled_holder_no_counters, then:$exiled_holder_one_move, otherwise:Program{}}]} */
exiled_holder_operation_then_if ::= operation "." "then" "if" exiled_holder_no_counters "," exiled_holder_one_move

/* @sem Operation::Move{objects:InZone{objects:One(Source), zone:Exile}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true}}, qualifiers:[]} */
exiled_holder_put_tapped ::= "put" "this" "card" "from" "exile" "onto" "the" "battlefield" "tapped"

/* A printed choice lists independent ability options. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Ability, terms:_{options:[Ability(Keyword($keyword_value)), Ability(Keyword($keyword_value_2)), Ability(Keyword($keyword_value_3))], count:Exactly($value)}} */
choose_ability_options_three ::= "choose" value "abilities" "from" "among" keyword_value "," keyword_value "," "and" keyword_value

/* Color and creature type stay paired within each option. */
/* @sem Operand::Term{family:ColorAndCreatureType, form:ColorAndCreatureType, operands:[Vocabulary{family:Color, form:$token_color}, Vocabulary{family:CreatureType, form:@subtype_name($creature_subtype)}]} */
choice_color_type ::= token_color creature_subtype

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:ColorAndCreatureType, terms:_{count:Exactly(Constant(1)), options:[$choice_color_type, $choice_color_type_2, $choice_color_type_3, $choice_color_type_4, $choice_color_type_5]}} */
choose_color_type_options_five ::= "choose" choice_color_type "," choice_color_type "," choice_color_type "," choice_color_type "," "or" choice_color_type

/* @sem Operand::Term{family:CardsInOracle, form:And, operands:[Term{family:CardsInOracle, form:IsSupertype, operands:[Vocabulary{family:SuperType, form:Basic}]}, Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Land}]}]} */
card_name_basic_land ::= "basic" "land"

/* @sem Operand::Term{family:CardsInOracle, form:Not, operands:[$card_name_other_kind]} */
card_name_other_than_kind ::= "a" "card" "name" "other" "than" "a" card_name_other_kind "card" "name"

card_name_other_kind ::= card_name_basic_land | card_name_creature | card_name_nonartifact | card_name_noncreature | card_name_nonland | card_name_nonbasic_land

/* The second choice omits the repeated imperative. */
/* @sem Instruction::[Effect{result:@next, operation:$choice_and_name_first}, Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:CardName, terms:_{count:Exactly(Constant(1)), options:[$card_name_option]}}}] */
clause_choice_and_name ::= choice_and_name_first "and" card_name_option

choice_and_name_first ::= choose_opponent | choose_a_player | choose_land_type | choose_basic_land_type | choose_number_between | choose_a_number | choose_two_colors | choose_color_other | choose_creature_type_plain | choose_a_color

/* Each player makes a separate choice. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseValue{choosers:One(Bound(0)), kind:Word, terms:_{count:Exactly(Constant(1)), options:[Text($choice_word), Text($choice_word_2)]}}}]}}] */
clause_each_chooses_words ::= players_singular "chooses" choice_word "or" choice_word

choice_word ::= choice_word_war | choice_word_peace

/* @sem String::'War' */
choice_word_war ::= "war"

/* @sem String::'Peace' */
choice_word_peace ::= "peace"

/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:$spell_filter}, duration:$this_duration, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:$next_cast_copy, targets:May}}]}, once:true}}] */
clause_next_cast_copy_original ::= "when" "you" "next" "cast" spell_filter this_duration "," next_cast_copy

/* A spell's selected creature and a damage event are shared across the
   delayed trigger's independently constructed consequence. */
/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CreateTrigger{event:$selected_damage_event, duration:$this_duration, announcement:_{}, body:_{instructions:$selected_damage_consequence}, once:false}}]}} */
spell_selected_damage_trigger ::= selected_damage_event this_duration "," selected_damage_consequence "."

selected_damage_consequence ::= selected_damage_life | selected_damage_spread

/* @sem Instruction::[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:EventAmount}}] */
selected_damage_life ::= "you" "gain" "that" "much" "life"

/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:Target{slot:0, index:0}, recipients:Union([Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::CardType(Creature), ObjectFilter::Not(SameObject(Target{slot:0, index:0})))}), Players(All)]), amount:EventAmount, preventable:true}}] */
selected_damage_spread ::= "it" "deals" "that" "much" "damage" "to" "each" "other" "creature" "and" "each" "player"

/* The next-spell wording retains the same one-shot copy contract. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:$next_spell_filter}, duration:$this_duration, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:$next_cast_copy, targets:May}}]}, once:true}}] */
clause_cast_your_next_copy ::= "when" "you" "cast" "your" "next" next_spell_filter this_duration "," next_cast_copy

/* The future trigger owns the target announced for its optional action. */
/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:@scope(Operation::CreateTrigger{event:$event_unblocked, duration:EndOfTurn, announcement:@announcement, body:_{instructions:$optional_event_damage_consequence}, once:false})}]}} */
spell_unblocked_delayed ::= "until" "end" "of" "turn" "," "whenever" event_unblocked "," optional_event_damage_consequence "."

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:$event_power_damage}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:_{instructions:[Effect{result:@next, operation:$event_no_combat_damage}]}, otherwise:_{}}] */
optional_event_damage_consequence ::= "you" "may" "choose" "to" "have" event_power_damage "." "if" "you" "do" "," event_no_combat_damage

/* @sem Operation::DealDamage{source:EventSubject, recipients:Objects(One($target_permanent)), amount:ObjectProperty{object:EventSubject, property:Power, information:CurrentOrLastKnown}, preventable:true} */
event_power_damage ::= "it" "deal" "damage" "equal" "to" "its" "power" "to" "a" target_permanent

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(EventSubject)), changes:[Rule(CombatDamage(NoAssignment))], duration:$this_duration, evaluation:LiveObjects} */
event_no_combat_damage ::= "it" "assigns" "no" "combat" "damage" this_duration

/* A defender choice is shared by the single-target and per-creature forms. */
/* @sem () */
combat_defender_choice ::= "reselect" "which" "player" "or" "permanent"

/* @sem ObjectSet::$affected */
combat_attacker_defender ::= affected "is" "attacking"

/* @sem Operation::ChangeCombat{change:Reselect{objects:$combat_attacker_defender}} */
combat_reselect_target ::= combat_defender_choice combat_attacker_defender

/* Limit the anaphor to the explicit attacking creature population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Attacking, CardType(Creature)])} */
combat_each_attacking_creature ::= "each" "attacking" "creature"

/* @sem Operation::ChangeCombat{change:Reselect{objects:$combat_each_attacking_creature, optional:true}} */
combat_reselect_each ::= "for" combat_each_attacking_creature "," "you" "may" combat_defender_choice "that" "creature" "is" "attacking"

/* The chosen color comes from one linked card or from a linked set. */
/* @sem ManaProduction::ColorsAmong{objects:One($linked_exiled_card_possessive)} */
mana_colors_linked_card ::= "one" "mana" "of" "any" "of" linked_exiled_card_possessive "colors"

/* @sem ManaProduction::ColorsAmong{objects:$linked_exiled_cards_possessive} */
mana_colors_linked_cards ::= "one" "mana" "of" "any" "of" linked_exiled_cards_possessive "colors"

/* @sem Operation::AddMana{players:One(AbilityController), mana:ColorsAmong{objects:$craft_exiled_cards, each:true}} */
add_mana_each_craft_color ::= "for" "each" "color" "among" craft_exiled_cards "," "add" "one" "mana" "of" "that" "color"

/* Keep the choice and its consumer together so the chosen object is the actual receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Damage(Source), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:$conjure_selected_creature_form}] */
instructions_choice_conjure ::= "choose" "one" "of" "those" "creatures" "." conjure_selected_creature_form

conjure_selected_creature_form ::= conjure_selected_creature | conjure_selected_creatures

/* @sem Operation::Conjure{actor:One(AbilityController), card:Duplicate(One(Result{result:@prior, phase:After, index:0})), count:$counter_a, destination:$conjure_spellbook_zone} */
conjure_selected_creature ::= "conjure" counter_a "duplicate" "of" "the" "chosen" "creature" conjure_spellbook_zone

/* @sem Operation::Conjure{actor:One(AbilityController), card:Duplicate(One(Result{result:@prior, phase:After, index:0})), count:$number, destination:$conjure_spellbook_zone} */
conjure_selected_creatures ::= "conjure" number "duplicates" "of" "the" "chosen" "creature" conjure_spellbook_zone

/* Extra steps retain the recipient and count as independent operands. */
/* @sem Instruction::[Effect{result:@next, operation:AddPhases{actor:One(AbilityController), phases:$additional_step_kind, count:Expr::Constant(1)}}] */
clause_extra_step_one ::= "you" "get" "an" "additional" additional_step_kind "step" "after" "this" "step"

/* @sem Instruction::[Effect{result:@next, operation:AddPhases{actor:One(AbilityController), phases:$additional_step_kind, count:$count_plural}}] */
clause_extra_steps ::= "you" "get" count_plural "additional" additional_step_kind "steps" "after" "this" "step"

/* @sem PhaseKind::Upkeep */
additional_step_kind ::= "upkeep"

/* A defined X retains the recipient, counter kind, and devotion operands. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:$value_devotion}]} */
put_counters_where_devotion ::= "put" "X" counter_kind "counters" "on" affected "," "where" "X" "is" value_devotion

/* Keep the exiled-creature receipt local to its actual exile producer. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($exile_counter_creature_target), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$commander_counter_filter}), kind:$counter_kind, amount:$exile_counter_creature_power, selection:_{player:AbilityController, count:AsManyAsCan($counter_amount)}}]}}] */
instructions_exile_creature_power_counters ::= "exile" exile_counter_creature_target "." "put" "X" counter_kind "counters" "on" counter_amount commander_counter_filter "," "where" "X" "is" exile_counter_creature_power

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:CardType(Creature)}), index:0} */
exile_counter_creature_target ::= "target" "creature"

/* @sem ObjectFilter::AllOf([State(Commander), $filter_phrase, ControlledBy(One(AbilityController))]) */
commander_counter_filter ::= "commander" filter_phrase "you" "control"

/* Only the enclosing exile-and-placement sequence may use this operand. */
/* @sem Expr::ObjectProperty{object:Result{result:@prior, phase:Before, index:0}, property:Power, information:CurrentOrLastKnown} */
exile_counter_creature_power ::= "the" "power" "of" "the" "creature" "exiled" "this" "way"

/* A single optional cast owns the free payment and its exile replacement.
   The selected zone and mana-value ceiling come from the current phrase. */
/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:$graveyard_cast_selection, count:Exactly($counter_amount), terms:_{cost:Free, into_exile:true}}}]}}] */
clause_free_graveyard_cast ::= "you" "may" "cast" counter_amount graveyard_cast_selection

graveyard_cast_selection ::= graveyard_cast_your_before | graveyard_cast_your_after | graveyard_cast_any_after

/* @sem ObjectSet::Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([AnyOf([CardType(Instant), CardType(Sorcery)]), Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])}) */
graveyard_cast_your_before ::= "instant" "or" "sorcery" "spell" "from" "your" "graveyard" "with" "mana" "value" value "or" "less" "without" "paying" "its" "mana" "cost" "." "if" "that" "spell" "would" "be" "put" "into" "your" "graveyard" "," "exile" "it" "instead"

/* @sem ObjectSet::Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([AnyOf([CardType(Instant), CardType(Sorcery)]), Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])}) */
graveyard_cast_your_after ::= "instant" "or" "sorcery" "spell" "with" "mana" "value" value "or" "less" "from" "your" "graveyard" "without" "paying" "its" "mana" "cost" "." "if" "that" "spell" "would" "be" "put" "into" "your" "graveyard" "," "exile" "it" "instead"

/* @sem ObjectSet::Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:AllOf([AnyOf([CardType(Instant), CardType(Sorcery)]), Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])}) */
graveyard_cast_any_after ::= "instant" "or" "sorcery" "spell" "with" "mana" "value" "less" "than" "or" "equal" "to" value "from" "a" "graveyard" "without" "paying" "its" "mana" "cost" "." "if" "that" "spell" "would" "be" "put" "into" "a" "graveyard" "," "exile" "it" "instead"

/* Random selections preserve the independent choice operands. */
/* @sem Operation::ChooseAtRandom(_{kind:Ability, options:$random_keyword_pair}) */
random_keyword_choice ::= "choose" random_keyword_pair "at" "random"

/* @sem Operand::[Ability(Keyword($keyword_value)), Ability(Keyword($keyword_value_2))] */
random_keyword_pair ::= keyword_value "or" keyword_value

/* @sem Operation::ChooseAtRandom(_{kind:Player, options:[$random_player_population]}) */
random_player_choice ::= "choose" random_player_population "at" "random"

/* @sem Operand::Players(All) */
random_player_population ::= "a" "player"

/* Choice operands remain available independently to later instructions. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:CardType, terms:_{count:Exactly(Constant(1)), options:[$choice_card_type, $choice_card_type_2]}} */
choose_card_types_pair ::= "choose" choice_card_type "or" choice_card_type

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Filter, terms:_{count:Exactly(Constant(1)), options:[Filter(CardType(Land)), Filter(Not(CardType(Land)))]}} */
choose_land_or_nonland ::= "choose" "land" "or" "nonland"

/* The choice and series form one producer of the latest coin outcomes. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue(_{choosers:One(AbilityController), kind:Number, terms:_{count:Exactly(Constant(1))}})}, Effect{result:@next, operation:FlipCoinSeries{players:One(AbilityController), protocol:Called, repetition:UpTo{extent:Count(ChosenNumber), stop:Lose}}}] */
chosen_coin_series ::= "choose" "a" "number" "." "flip" "a" "coin" "that" "many" "times" "or" "until" "you" "lose" "a" "flip" "," "whichever" "comes" "first"

/* @sem Instruction::[If{condition:Compare{left:CountCoinOutcomes{source:Latest, outcome:Lost}, test:Compare{comparison:Equal, value:Constant(0)}}, then:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Multiply([$number, CountCoinOutcomes{source:Latest, outcome:Won}])}}]}, otherwise:_{}}] */
coin_series_win_draw ::= "if" "you" "win" "all" "the" "flips" "," "draw" number "cards" "for" "each" "flip"

/* Keep Latest scoped to the immediately preceding series. */
/* @sem Instruction::[...$chosen_coin_series, ...$coin_series_win_draw] */
instructions_chosen_coin_series_draw ::= chosen_coin_series "." coin_series_win_draw

/* A protection instruction can precede a clash with its own win program. */
/* @sem Instruction::[...$protection_from_chosen_color, ...$clash_if_you_win] */
instructions_protection_clash ::= protection_from_chosen_color "." clash_if_you_win

/* Revealing the hidden items completes the secret choices before their use. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseValue(_{choosers:One(Bound(0)), kind:Number, terms:_{options:[Comparison([Greater, Constant(0)])], count:Exactly(Constant(1)), secret:true}})}]}}, Effect{result:@next, operation:RevealChoices{kind:Number}}] */
hidden_items_reveal ::= "each" "player" "hides" "at" "least" "one" "item" "," "then" "all" "players" "reveal" "them" "simultaneously"

/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:LoseLife{players:One(Bound(0)), amount:PlayerNumber{player:Bound(0), number:ChosenNumber}}}]}}] */
revealed_items_life_loss ::= "each" "player" "loses" "life" "equal" "to" "the" "number" "of" "items" "they" "revealed"

/* Both sentences describe the same lowest-choice population, including ties. */
/* @sem Instruction::[ForEachPlayer{players:Matching{binding:0, condition:ChoseExtreme{player:Bound(0)}}, binding:0, body:_{instructions:[Effect{result:@next, operation:LoseLife{players:One(Bound(0)), amount:Divide{numerator:PlayerNumber{player:Bound(0), number:Life}, denominator:Constant(2), rounding:Up}}}]}}] */
fewest_items_half_life ::= "the" "player" "who" "revealed" "the" "fewest" "items" "then" "loses" "half" "their" "life" "," "rounded" "up" "." "if" "two" "or" "more" "players" "are" "tied" "for" "fewest" "," "each" "loses" "half" "their" "life" "," "rounded" "up"

/* Scope the consumers to the choices that produced the revealed items. */
/* @sem Instruction::[...$hidden_items_reveal, ...$revealed_items_life_loss, ...$fewest_items_half_life] */
instructions_hidden_items ::= hidden_items_reveal "." revealed_items_life_loss "." fewest_items_half_life

/* Turn actions share the subject supplied by a player clause. */
turn_keyword_third ::= skip_turn_part_third | extra_turns_third

/* @sem Operation::Keyword{actor:@subject, action:KeywordAction::Skip{part:$skipped_turn_part}} */
skip_turn_part_third ::= "skips" "their" "next" skipped_turn_part

skipped_turn_part ::= skipped_draw_step | skipped_combat_this_turn

/* @sem SkippedPart::DrawStep */
skipped_draw_step ::= "draw" "step"

/* @sem SkippedPart::CombatPhaseThisTurn */
skipped_combat_this_turn ::= "combat" "phase" "this" "turn"

/* @sem Operation::Keyword{actor:@subject, action:KeywordAction::TakeExtraTurn{times:$value}} */
extra_turns_third ::= "takes" value "extra" "turns" "after" "this" "one"

/* Conjuring a named card preserves the printed count and arrival state. */
/* @sem Operation::Conjure{actor:One(AbilityController), card:Named($conjured_battlefield_name), count:$card_count, destination:Battlefield(BattlefieldArrival{tapped:false, counters:[], states:[]})} */
conjure_named_battlefield ::= "conjure" card_count "named" conjured_battlefield_name "onto" "the" "battlefield"

/* @sem Operation::Conjure{actor:One(AbilityController), card:Named($conjured_battlefield_name), count:$card_count, destination:Battlefield(BattlefieldArrival{tapped:true, counters:[], states:[]})} */
conjure_named_battlefield_tapped ::= "conjure" card_count "named" conjured_battlefield_name "onto" "the" "battlefield" "tapped"

/* Names are separate reusable operands, shared by both arrival forms. */
conjured_battlefield_name ::= card_name_soul_of_new_phyrexia | card_name_stonybrook_schoolmaster | card_name_storm_crow | card_name_thieving_magpie | card_name_training_grounds | card_name_utility_knife

/* The option phrase carries each ability separately, so edited choices print
   from their current operands and numbered mechanics can share the list. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Ability, terms:_{count:Exactly(Constant(1)), options:$choice_ability_options}} */
choose_ability_options ::= "choose" choice_ability_options

choice_ability_options ::= choice_ability_pair | choice_ability_list

/* @sem Operand::[$choice_ability_option, $choice_ability_option_2] */
choice_ability_pair ::= choice_ability_option "or" choice_ability_option

/* @sem Operand::[$choice_ability_option, ...$choice_ability_tail] */
choice_ability_list ::= choice_ability_option "," choice_ability_tail

choice_ability_tail ::= choice_ability_last | choice_ability_more

/* @sem Operand::[$choice_ability_option] */
choice_ability_last ::= "or" choice_ability_option

/* @sem Operand::[$choice_ability_option, ...$choice_ability_tail] */
choice_ability_more ::= choice_ability_option "," choice_ability_tail

choice_ability_option ::= choice_keyword_option | choice_numbered_mechanic_option

/* @sem Operand::Ability(Ability::Keyword($keyword_value)) */
choice_keyword_option ::= keyword_value

/* @sem Operand::Ability(Ability::Mechanic{mechanic:$choice_numbered_mechanic, amount:$value}) */
choice_numbered_mechanic_option ::= choice_numbered_mechanic value

choice_numbered_mechanic ::= mechanic_rampage_choice | numbered_keyword_name

/* @sem Mechanic::Rampage */
mechanic_rampage_choice ::= "rampage"

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Number, terms:_{count:Exactly(Constant(1)), options:[$choice_number_bound]}} */
choose_number_threshold ::= "choose" "a" "number" choice_number_bound

/* @sem Operand::Comparison(Greater, $value) */
choice_number_bound ::= "greater" "than" value

/* Land and nonland are complements of the same fixed card type. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Filter, terms:_{count:Exactly(Constant(1)), options:$choice_land_options}} */
choose_land_class ::= "choose" choice_land_options

/* @sem Operand::[Filter(CardType(Land)), Filter(Not(CardType(Land)))] */
choice_land_options ::= "land" "or" "nonland"

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Direction, terms:_{count:Exactly(Constant(1)), options:$direction_choice}} */
choose_direction ::= "choose" direction_choice

/* @sem Operand::[] */
direction_choice ::= "left" "or" "right"

/* Return destinations keep entry counters and attachment hosts as current operands. */
/* @sem Operation::Move{objects:$affected, destination:$return_modified_destination, qualifiers:[]} */
move_to_modified_battlefield ::= "return" affected "to" "the" "battlefield" return_modified_destination

return_modified_destination ::= return_transformed_player_destination | return_transformed_object_destination | return_additional_counters_destination | return_two_counters_destination

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[Transformed, AttachedToPlayer($player_ref)]}} */
return_transformed_player_destination ::= "transformed" "under" "your" "control" "attached" "to" player_ref

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[Transformed, AttachedTo($object_ref)]}} */
return_transformed_object_destination ::= "transformed" "under" "your" "control" "attached" "to" object_ref

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, $value]], states:[]}} */
return_additional_counters_destination ::= "with" value "additional" counter_kind "counters" "on" "it"

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, $counter_amount], [$counter_kind_2, $counter_amount_2]], states:[]}} */
return_two_counters_destination ::= "with" counter_amount counter_kind "counter" "and" counter_amount counter_kind "counter" "on" "it"

/* @sem Operation::Move{objects:$return_permanent_population, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_filtered_permanents_hand ::= "return" return_permanent_population

return_permanent_population ::= return_chosen_color_population | return_owned_population

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, Chosen(Color)])} */
return_chosen_color_population ::= "all" filter_plural "of" "that" "color" "to" "their" "owners'" "hands"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, OwnedBy($players_singular)])} */
return_owned_population ::= "all" filter_plural players_singular "owns" "to" "their" "hand"

/* Choose from an explicitly described exile population. */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:$exile_linked_population, count:AsManyAsCan($card_count)} */
choose_exile_card ::= "choose" card_count exile_linked_population

/* @sem Operation::ChooseObjects{player:AbilityController, objects:$exile_described_population, count:AsManyAsCan($counter_amount)} */
choose_exile_filtered_card ::= "choose" counter_amount exile_described_population

/* @sem Operation::ChooseObjects{player:AbilityController, objects:$exile_random_population, count:AsManyAsCan($card_count), constraints:[AtRandom]} */
choose_exile_card_random ::= "choose" card_count "at" "random" exile_random_population

/* Exile populations and singleton receipts share the owner-directed move. */
/* @sem Operation::Move{objects:$put_exiled_singular_objects, destination:$put_exiled_singular_destination, qualifiers:[]} */
put_exiled_singular ::= "put" put_exiled_singular_objects "into" put_exiled_singular_destination

/* @sem Operation::Move{objects:$put_exiled_plural_objects, destination:$put_exiled_plural_destination, qualifiers:[]} */
put_exiled_plural ::= "put" put_exiled_plural_objects "into" put_exiled_plural_destination

/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
put_exiled_singular_hand ::= "its" "owner's" "hand"

/* @sem MovementDestination::OwnersGraveyard(CardArrival{counters:[], states:[]}) */
put_exiled_singular_graveyard ::= "its" "owner's" "graveyard"

put_exiled_singular_destination ::= put_exiled_singular_hand | put_exiled_singular_graveyard

/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
put_exiled_plural_hand ::= "their" "owner's" "hand"

/* @sem MovementDestination::OwnersGraveyard(CardArrival{counters:[], states:[]}) */
put_exiled_plural_graveyard ::= "their" "owner's" "graveyard"

put_exiled_plural_destination ::= put_exiled_plural_hand | put_exiled_plural_graveyard

/* Shared graveyard populations retain card identity and ownership. */
/* @sem Operation::Move{objects:$return_personal_graveyard_population, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_graveyard_personal_hand ::= "return" return_personal_graveyard_population "to" "your" "hand"

/* @sem Operation::Move{objects:$return_all_graveyard_population, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_graveyard_all_owners_hand ::= "return" return_all_graveyard_population "to" "their" "owners'" "hands"

/* The per-color target group is an operand shared by actions. */
/* @sem Operation::Move{objects:$each_color_graveyard_targets, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_each_color_targets_hand ::= each_color_graveyard_targets "to" "your" "hand"

/* Two independently described populations keep separate move results. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$battlefield_return_population, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:$graveyards_return_population, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_return_cross_zone_populations ::= "return" battlefield_return_population "and" graveyards_return_population "to" "their" "owners'" "hands"

/* A private graveyard selection keeps its own target announcements; every
   selected card belongs to the player whose hand receives it. */
/* @sem Operation::Move{objects:$return_graveyard_selection, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_graveyard_selection_hand ::= "return" return_graveyard_selection "from" "your" "graveyard" "to" "your" "hand"

/* @sem Operation::Move{objects:$return_color_selection, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_each_color_hand ::= "for" "each" "color" "," "return" return_color_selection "from" "your" "graveyard" "to" "your" "hand"

/* Future spell changes share their subject and their ability or rule change. */
/* @sem Operation::ChangeSpell{subject:$future_spell_subject, changes:$future_spell_change} */
change_future_spell ::= future_spell_subject future_spell_change

future_spell_subject ::= next_cost_subject | next_spell_they_this_turn

/* @sem SpellSubject::Next{spells:Any, player:@that_player, this_turn:true, from_hand:false} */
next_spell_they_this_turn ::= "the" "next" "spell" "they" "cast" "this" "turn"

future_spell_change ::= future_spell_has_mechanic | future_spell_cant_be_countered

/* @sem Change::[GrantAbility($future_spell_mechanic)] */
future_spell_has_mechanic ::= "has" future_spell_mechanic

future_spell_mechanic ::= mechanic_bare | mechanic_affinity

/* @sem Change::[CantBeCountered] */
future_spell_cant_be_countered ::= "can't" "be" "countered"

/* Divide one damage amount equally across the named recipient population. */
/* @sem Operation::DealDamageWith{source:$object_ref, recipients:$even_damage_recipients, amount:$number, rider:DividedEvenly(Down)} */
deal_damage_evenly_rounded ::= object_ref "deals" number "damage" "divided" "evenly" "," "rounded" "down" "," "among" even_damage_recipients

/* Future player casting permissions and restrictions share the affected player. */
/* @sem Operation::EffectOn{subject:Players(One(AbilityController)), effects:[$future_cast_effect]} */
future_player_cast_effect ::= future_cast_effect

future_cast_effect ::= next_spell_free_cast_effect | only_one_more_cast_effect

/* @sem Operand::Term{family:FuturePlayerEffect, form:MayCastTheirNextSpellThisTurnWithoutPaying, operands:[Filter($next_spell_chosen_filter)]} */
next_spell_free_cast_effect ::= "the" "next" "spell" "you" "cast" "this" "turn" next_spell_chosen_filter "can" "be" "cast" "without" "paying" "its" "mana" "cost"

/* @sem Operand::Term{family:FuturePlayerEffect, form:CanCastOnlyOneMoreSpellThisTurn} */
only_one_more_cast_effect ::= "you" "can" "cast" "only" "one" "more" "spell" "this" "turn"

perpetual_affected_subject ::= affected | library_perpetual_subject

/* Spell subjects and effects compose without changing the caster or the card's owner. */
/* @sem Operation::EffectOn{subject:$each_cast_hand_subject, effects:[$gained_spell_effect], until:EndOfTurn} */
spell_effect_each_cast ::= each_cast_hand_subject "," "they" "gain" gained_spell_effect

/* @sem EffectSubject::EachSpell(Cast{by:One(AbilityController), from:Players{zone:Hand, players:One(AbilityController)}}) */
each_cast_hand_subject ::= "as" "you" "cast" "spells" "from" "your" "hand" "this" "turn"

/* @sem Operand::Term{family:SpellEffect, form:Cascade} */
gained_spell_effect ::= "cascade"

/* @sem Operation::EffectOn{subject:NextSpell{spells:$next_hand_spell_filter, caster:AbilityController, this_turn:true, from:Hand}, effects:[$resolving_spell_effect]} */
spell_effect_next_cast ::= "the" "next" "time" "you" "cast" next_hand_spell_filter "spell" "from" "your" "hand" "this" "turn" "," resolving_spell_effect

next_hand_spell_filter ::= next_hand_instant_or_sorcery | next_hand_instant | next_hand_sorcery

/* @sem $spell_instant_or_sorcery */
next_hand_instant_or_sorcery ::= "an" spell_instant_or_sorcery

/* @sem $spell_instant */
next_hand_instant ::= "an" spell_instant

/* @sem $spell_sorcery */
next_hand_sorcery ::= "a" spell_sorcery

/* @sem Operand::Term{family:SpellEffect, form:ResolvesIntoHandInsteadOfGraveyard} */
resolving_spell_effect ::= "put" "that" "card" "into" "your" "hand" "instead" "of" "into" "your" "graveyard" "as" "it" "resolves"

/* The arrival set is tied to this exact conjure, in its library destination. */
/* @sem Instruction::[Effect{result:@next, operation:$conjure_named_library_top}, Effect{result:@next, operation:CreatePerpetualEffect{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@prior, phase:After})}), changes:[GrantAbility(@scope(Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$program}))]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_conjure_named_top_grant ::= conjure_named_library_top "." "they" "perpetually" "gain" '"' event_clause "," program "." '"' "then" "shuffle"

/* @sem Operation::Conjure{actor:One(AbilityController), card:Named($referenced_card_name), count:$card_count, destination:Library{position:Top, arrival:CardArrival{counters:[], states:[]}}} */
conjure_named_library_top ::= "conjure" card_count "named" referenced_card_name "on" "top" "of" "your" "library"

/* @sem Instruction::[Effect{result:@next, operation:$conjure_whole_spellbook_library}, Effect{result:@next, operation:$conjure_whole_spellbook_library}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_conjure_spellbook_twice ::= conjure_whole_spellbook_library "twice" "," "then" "shuffle"

/* @sem Operation::Conjure{actor:One(AbilityController), card:Spellbook{book:@card_name, pick:Each}, count:Constant(1), destination:Library{position:Random, arrival:CardArrival{counters:[], states:[]}}} */
conjure_whole_spellbook_library ::= "conjure" self_named "'s" "spellbook" "into" "your" "library"

/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Duplicate(One(EventOther)), count:$counter_amount, owner:AbilityController, destination:Library{position:AmongTop($card_count), arrival:CardArrival{counters:[], states:[]}}}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$static_changes}}]}}] */
instructions_may_conjure_duplicate_change ::= "you" "may" "conjure" counter_amount "duplicate" "of" "that" "creature" "into" "the" "top" card_count "of" "your" "library" "at" "random" "." "the" "duplicate" "perpetually" static_changes

/* Entry modifications to a spell cast under a permission are shared operands. */
/* @sem Operand::Term{family:SpellEffect, form:EntersWithACounter, operands:[Vocabulary{family:CounterType, form:FinalityCounter}]} */
cast_entry_finality ::= "enters" "with" "a" "finality" "counter" "on" "it"

/* @sem Operand::Term{family:SpellEffect, form:EntersWithLayerEffect, operands:[Term{family:LayerEffect, form:AddCreatureType, operands:[Vocabulary{family:CreatureType, form:Vampire}]}]} */
cast_entry_vampire ::= "is" "a" "Vampire" "in" "addition" "to" "its" "other" "types"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:$noun_creature}, terms:_{cost:Additional(Cost{parts:[Keyword{action:Forage}]}), effects:[$cast_entry_effects]}})], duration:$duration, evaluation:LiveObjects}}] */
instructions_graveyard_forage_entry ::= duration "," "you" "may" "cast" noun_creature "spells" "from" "your" "graveyard" "by" "foraging" "in" "addition" "to" "paying" "their" "other" "costs" "." "if" "you" "cast" "a" "spell" "this" "way" "," "that" "creature" cast_entry_effects

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:$filter_phrase}, terms:_{limit:Total(1), cost:Normal, effects:[$cast_entry_effects]}})], duration:$this_duration, evaluation:LiveObjects}}] */
instructions_graveyard_single_entry ::= "you" "may" "cast" "a" filter_phrase "spell" "from" "your" "graveyard" this_duration "." "if" "you" "do" "," "it" cast_entry_effects

/* @sem Operand::List([$cast_entry_finality]) */
cast_entry_effects_single ::= cast_entry_finality

/* @sem Operand::List([$cast_entry_finality, $cast_entry_vampire]) */
cast_entry_effects_pair ::= cast_entry_finality "and" cast_entry_vampire

cast_entry_effects ::= cast_entry_effects_single | cast_entry_effects_pair

/* The cast event's antecedent and the grant recipient are bound together. */
/* @sem Operand::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($affected_2), changes:[GainAbilitiesOf{objects:$affected, kinds:$copied_ability_kinds}], duration:$until_end_of_turn, evaluation:Snapshot}}]} */
cast_grant_abilities_program ::= "when" "you" "cast" affected "this" "turn" "," affected "gains" "all" copied_ability_kinds "abilities" "of" "that" "card" until_end_of_turn

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:$noun}), index:0}), from:Graveyard, action:CastSpell, filter:Any}, terms:_{cost:Normal, effects:[$cast_grant_abilities_program]}})], duration:EndOfTurn, evaluation:LiveObjects}}] */
instructions_target_graveyard_cast_grant ::= "you" "may" "cast" "target" noun "card" "in" "a" "graveyard" "this" "turn" "." cast_grant_abilities_program

/* Optional counter payment followed by a counter-dependent change to the same target. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PutCounters([_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$noun_creature}), index:0})), kind:$counter_payment_named, amount:Constant(1)}])]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@last_slot, index:0})), changes:[SetBasePowerToughness{power:$number_digits, toughness:$number_digits_2}, GrantKeyword($keyword_name)], duration:WhileMatches{object:Affected, filter:Counters(_{kind:$counter_payment_named_2, comparison:Greater, value:Constant(0)})}, evaluation:Snapshot}}]}, otherwise:_{}}] */
instructions_counter_payment_base_keyword ::= "you" "may" "put" "a" counter_payment_named "counter" "on" "target" noun_creature "." "if" "you" "do" "," "that" "creature" "has" "base" "power" "and" "toughness" number_digits "/" number_digits "and" "has" keyword_name "for" "as" "long" "as" "it" "has" "a" counter_payment_named "counter" "on" "it"

counter_payment_named ::= cn_feather | cn_charge | cn_time | cn_flying

/* The X definition fixes the target count from current or last-known counters
   on the named object; the final sentence modifies this destruction itself. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:$counter_count_targets, regeneration:false}}] */
clause_destroy_counter_count_no_regeneration ::= "destroy" counter_count_targets "." "they" "can't" "be" "regenerated"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(CountCounters(_{recipients:Objects(One($self_explicit_ref)), kind:$counter_kind, information:CurrentOrLastKnown})), filter:$filter_plural})) */
counter_count_targets ::= "up" "to" "X" "target" filter_plural "," "where" "X" "is" "the" "number" "of" counter_kind "counters" "on" self_explicit_ref

/* One target per opponent, with distinct controllers, announced together. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:$required_each_opponent_targets, regeneration:true}}] */
clause_destroy_required_opponent_targets ::= "for" "each" "opponent" "," "destroy" required_each_opponent_targets

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(CountPlayers(OpponentsOf(AbilityController))), filter:@and($adjective_nontype, $filter_phrase, ObjectFilter::ControlledBy(OpponentsOf(AbilityController))), constraints:[DifferentControllers]})) */
required_each_opponent_targets ::= "target" adjective_nontype filter_phrase "that" "player" "controls"

/* The named payer may prevent the stated operation by paying life. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:$target_opponent, cost:Cost{parts:[Life($number)]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:$operation}]}, otherwise:Program{}}] */
clause_unless_named_life ::= operation "unless" target_opponent "pays" number "life"

/* Inclusive random bounds remain independent operands of the choice. */
/* @sem Operation::ChooseAtRandom{kind:Number, options:[Comparison([GreaterOrEqual, $value]), Comparison([LessOrEqual, $value_2])]} */
random_number_range ::= "where" "X" "is" "a" "number" "chosen" "at" "random" "from" value "to" value

/* @sem Operation::DealDamage{source:$object_ref, recipients:Objects($affected), amount:ChosenNumber, preventable:true} */
random_number_damage ::= object_ref "deals" "X" "damage" "to" affected

/* @sem Instruction::[Effect{result:@next, operation:$random_number_range}, Effect{result:@next, operation:$random_number_damage}] */
instructions_random_number_damage ::= random_number_damage "," random_number_range

/* The chosen controller is scoped to the bound object in the enclosing loop. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseAtRandom{kind:Player, options:[$recipients]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Bound(0))), changes:[SetController(Chosen)], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:SetTapped{objects:One(Bound(0)), tapped:false}}] */
random_controller_untap ::= "then" recipients "gains" "control" "of" "each" "permanent" "for" "which" "they" "were" "chosen" "." "untap" "those" "permanents"

/* @sem Instruction::[ForEachObject{objects:$affected, binding:0, body:Program{instructions:$random_controller_untap}}] */
instructions_random_controller_untap ::= "for" affected "," "choose" "a" "player" "at" "random" "." random_controller_untap

/* A payment action can occur in any program, including an entry replacement. */
/* @sem Instruction::[Effect{result:@next, operation:PayAnyAmount{actor:One(AbilityController), resource:$payment_resource}}] */
clause_pay_any_resource ::= "pay" "any" "amount" "of" payment_resource

/* @sem Resource::Life */
payment_resource_life ::= "life"

/* @sem Resource::Mana */
payment_resource_mana ::= "mana"

payment_resource ::= payment_resource_life | payment_resource_mana

/* Keep the payment producer and its aggregate consumer in one program. */
/* @sem Program::Program{instructions:[ForEachPlayer{players:All, binding:0, starting_with:AbilityController, body:_{instructions:[Effect{result:@next, operation:PayAnyAmount{actor:One(Bound(0)), resource:Mana}}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($object_ref)), changes:[Pump{power:Performed(@prior), toughness:$number_digits}], duration:EndOfTurn, evaluation:Snapshot}}]} */
program_shared_mana_payment_pump ::= "each" "player" "starting" "with" "you" "may" "pay" "any" "amount" "of" "mana" "." object_ref "gets" "+" "X" "/" "+" number_digits "until" "end" "of" "turn" "," "where" "X" "is" "the" "total" "amount" "of" "mana" "paid" "this" "way"
