/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::CardType(Creature), ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)))}, choose:Exactly(Constant(1))}]}, optional:false}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:LoseLife{players:$players_singular, amount:ObjectProperty{object:Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Inputs, phase:Before}, index:0}, property:$creature_stat, information:CurrentOrLastKnown}}}]}, otherwise:$program}]} */
program_other_creature_sacrifice_stat_fallback ::= "sacrifice" "a" "creature" "other" "than" "this" "creature" "," "then" players_singular "loses" "life" "equal" "to" "the" "sacrificed" "creature's" creature_stat "." "if" "you" "can't" "sacrifice" "a" "creature" "," program

/* The chosen player selects from their own graveyard; the copy consumes this move's arrival. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:Chosen, objects:Zone{scope:Players{zone:Graveyard, players:One(Chosen)}, kind:Card, filter:$chosen_graveyard_an_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
