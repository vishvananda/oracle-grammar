/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject(EventSubject), SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:$filter_phrase}), index:0})])}, tapped:true}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject(EventSubject), SameObject(Target{slot:0, index:0})])}), changes:[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})], duration:DuringControllersNextUntapStep, evaluation:LiveObjects}}] */
instructions_tap_event_target_skip ::= "tap" "it" "and" "up" "to" "one" "target" filter_phrase "." "they" "don't" "untap" "during" "their" "controllers'" "next" "untap" "steps"

/* The follow-up measures the same sacrifice producer, before the objects move. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(Bound(0)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($filter_phrase, $filter_plural_2), Property{property:Power, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}, property:Power, aggregation:Maximum}}}])}, choose:AsManyAsCan($counter_amount)})}]}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:Aggregate{objects:Transition{result:@prior, phase:Before}, property:Power, aggregation:Maximum}}}] */
instructions_sacrifice_extreme_gain ::= players_singular "sacrifices" counter_amount filter_phrase "with" "the" "greatest" "power" "among" filter_plural "they" "control" "." "you" "gain" "life" "equal" "to" "the" "greatest" "power" "among" filter_plural "sacrificed" "this" "way"

/* The definition captures one quantity for both subsequent operations. */
/* @sem Instruction::[Effect{result:@mark, operation:BindValue{value:$distinct_colors_cast_and_battlefield}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:BoundValue(@marked)}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:BoundValue(@marked)}}] */
