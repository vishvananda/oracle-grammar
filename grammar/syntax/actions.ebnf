observed_choice_a ::= "a"

/* @sem Expr::Constant(1) */
observed_choice_an ::= "an"

/* All three tests consume the same marked mill arrival receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$mill_card_is_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$clause}, otherwise:Program{}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$mill_card_is_filter_2}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$clause_2}, otherwise:Program{}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$mill_card_is_filter_3}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$clause_3}, otherwise:Program{}}] */
instructions_mill_three_card_tests ::= "mill" card_count "." "if" mill_card_is_filter "," clause "." "if" mill_card_is_filter "," clause "." "if" mill_card_is_filter "," clause

