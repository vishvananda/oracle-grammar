/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Union([One($target_object), Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Target{slot:@last_slot, index:0})), @agree($plural, $noun), ControlledBy(One(ControllerOf(Target{slot:@last_slot, index:0}))), SharesNameWith(Target{slot:@last_slot, index:0})])}]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Reveal{objects:Zone(_{scope:Players{zone:Hand, players:One(ControllerOf(Target{slot:@last_slot, index:0}))}, kind:Card, filter:Any})}}, Effect{result:@next, operation:Move{objects:Union([Zone(_{scope:Players{zone:Hand, players:One(ControllerOf(Target{slot:@last_slot, index:0}))}, kind:Card, filter:SharesNameWith(Target{slot:@last_slot, index:0})}), Zone(_{scope:Players{zone:Graveyard, players:One(ControllerOf(Target{slot:@last_slot, index:0}))}, kind:Card, filter:SharesNameWith(Target{slot:@last_slot, index:0})})]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
