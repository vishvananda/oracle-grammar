damage_to_equal_counters ::= object_ref "deals" "damage" "to" recipients "equal" "to" "the" "number" "of" counter_kind "counters" "on" object_ref

/* A third-person counter placement keeps the stated object and kind. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects(One($object_ref)), kind:$counter_kind, amount:Constant(1)}]} */
third_put_single_counter ::= "puts" "a" counter_kind "counter" "on" object_ref

