/* Both explicit holder references denote this ability's holder. OneOf selects
   among the minimum-life players by the resolving ability's controller. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:$self_ref_holder_2, affected:Objects(One($self_ref_holder)), changes:[SetController($lowest_life_controller)], duration:Indefinite, evaluation:Snapshot}}] */
