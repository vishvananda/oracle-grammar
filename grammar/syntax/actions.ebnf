put_chosen_group_battlefield ::= "put" "them" "onto" "the" "battlefield" battlefield_control

/* The granted suspend ability belongs to the arrival of this exile action. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_suspend_counter_producer}, Effect{result:@next, operation:EffectOn{subject:Objects(Transition{result:@prior, phase:After}), effects:[Term{family:ExiledCardEffect, form:AddAbility, operands:[Ability(Mechanic{mechanic:BasicSuspend})]}]}}] */
