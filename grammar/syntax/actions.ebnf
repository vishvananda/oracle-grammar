event_sized_target_counter ::= "put" "a" counter_kind "counter" "on" "each" "of" "up" "to" "X" "target" filter_plural

/* A selectable list of checkable ability terms, retaining each option. */
/* @sem Operand::[$lost_keyword, ...$checkable_choice_tail] */
