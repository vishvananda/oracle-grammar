/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$target_opponent, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$uncontrolled_kind, ControlledBy(OthersThan(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ChooseObjects{player:Target{slot:@last_slot, index:0}, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$uncontrolled_kind_2, ControlledBy(OthersThan(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ChooseObjects{player:Target{slot:@last_slot, index:0}, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$uncontrolled_kind_3, ControlledBy(OthersThan(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ChooseObjects{player:Target{slot:@last_slot, index:0}, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$uncontrolled_kind_4, ControlledBy(OthersThan(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:Union([Recorded(@back(9)), Recorded(@back(7)), Recorded(@back(5)), Recorded(@back(3))]), filter:OwnedBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}}}] */
