/* @sem Operand::Term{family:CardsInOracle, form:IsNamed, operands:[Term{family:NameFilter, form:NamedCard, operands:[Text($referenced_card_name)]}]} */
choice_named_card ::= referenced_card_name

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:CardName, terms:_{count:Exactly(Constant(1)), unchosen:true, options:[Term{family:CardsInOracle, form:Or, operands:[$choice_named_card, $choice_named_card_2, $choice_named_card_3, $choice_named_card_4, $choice_named_card_5, $choice_named_card_6]}]}} */
choose_unchosen_names_shared ::= "choose" "a" "card" "name" "that" "hasn't" "been" "chosen" "from" "among" choice_named_card "," choice_named_card "," choice_named_card "," choice_named_card "," choice_named_card "," "and" choice_named_card

/* @sem Instruction::[Effect{result:@next, operation:$choose_number_threshold}, Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[$choice_any_color_term]}}}] */
clause_threshold_and_color ::= choose_number_threshold "and" choice_any_color_term

/* Choice kinds share the same controller and count contract. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:$choice_named_type, terms:_{count:Exactly(Constant(1))}} */
choose_named_type ::= "choose" "a" choice_named_type

choice_named_type ::= choice_named_nonbasic_land | choice_named_permanent

