choose_copy_token_or_cast ::= "choose" "one" "of" "those" "copies" "." "if" "a" "copy" "of" "a" "permanent" "card" "is" "chosen" "," "you" "may" "create" "a" "token" "that's" "a" "copy" "of" "that" "card" "." "if" "a" "copy" "of" "an" "instant" "or" "sorcery" "card" "is" "chosen" "," "you" "may" "cast" "the" "copy" "without" "paying" "its" "mana" "cost"

