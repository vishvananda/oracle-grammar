/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@another_target_reference(ObjectFilter::$filter_phrase))), ObjectFilter::@agree(ObjectFilter::$filter_phrase, ObjectFilter::$destroyed_matching_filter))}), index:0}), regeneration:true}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:ObjectProperty{object:Target{slot:@last_slot, index:0}, property:$creature_stat, information:CurrentOrLastKnown}}}]}, otherwise:Program{}}] */
