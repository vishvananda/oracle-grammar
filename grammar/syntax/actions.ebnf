activated_player_draw_exile_copy ::= cost ":" player_draw_exile_conditional_copy "."

/* The intervening branch creates tokens; it does not directly move the revealed
   library card. The entry query is scoped to this producer and test pair. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_single_library_top}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_kind}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:$token_groups, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_kind_2}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:$battlefield_control, qualifiers:[]}}]}, otherwise:Program{}}] */
reveal_top_token_entry ::= reveal_single_library_top "." "if" "it's" top_reveal_kind "," "create" token_groups "." "if" "it's" top_reveal_kind "," "put" "that" "card" "onto" "the" "battlefield" battlefield_control

/* @sem Instruction::[...$reveal_top_token_entry, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:AllOf([$adjective_nontype, $adjective_nontype_2])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:$clause}, otherwise:Program{}}] */
reveal_top_token_entry_and_excluded ::= reveal_top_token_entry "." "if" "it's" "a" adjective_nontype "," adjective_nontype "card" "," clause

/* @prefer always */
/* Both occurrences of the property and the difference refer to the same target and holder. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:SetTapped{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(DefendingPlayerOf(Source)))])}), index:0}), tapped:true}}, If{condition:ObjectMatches{object:Target{slot:0, index:0}, filter:Property{property:$stat, test:NumberTest::Compare{comparison:Greater, value:ObjectProperty{object:Source, property:$stat, information:CurrentOrLastKnown}}}}, then:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Source)), kind:$difference_counter_kind, amount:Subtract([ObjectProperty{object:Target{slot:0, index:0}, property:$stat, information:CurrentOrLastKnown}, ObjectProperty{object:Source, property:$stat, information:CurrentOrLastKnown}])}]}}]}, otherwise:Program{}}]} */
defender_tap_property_difference_program ::= "tap" "target" "creature" "defending" "player" "controls" "." "if" "that" "creature" "has" "greater" stat "than" "this" "creature" "," "put" "a" "number" "of" difference_counter_kind "counters" "on" "this" "creature" "equal" "to" "the" "difference"

difference_counter_kind ::= counter_minus | counter_plus | counter_pt | counter_name

/* A destroy action and its graveyard-arrival test share the same receipt. The
   condition stays inside this producer scope, including during inverse printing. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:One($target_object), regeneration:true}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@prior, phase:After}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:$destroy_arrival_conditional_body, otherwise:Program{}}] */
destroy_filtered_graveyard_conditional ::= "destroy" target_object "." "if" "a" filter_phrase "card" "is" "put" "into" "a" "graveyard" "this" "way" "," destroy_arrival_conditional_body

destroy_arrival_conditional_body ::= destroy_arrival_return_delayed | then_condition_program

/* The return consumes the destroy receipt; the delayed action consumes that
   return's own arrival, preserving the two distinct object identities. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Move{objects:One(Query{objects:Transition{result:@prior, phase:After}, index:0}), destination:$battlefield_control_yours, qualifiers:[]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_move_end_event, start:Immediately, body:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:One(Result{result:@marked, phase:After, index:0})})}]}}}]} */
destroy_arrival_return_delayed ::= "return" "it" "to" "the" "battlefield" battlefield_control_yours "." "sacrifice" "it" "at" delayed_move_end_event

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$destroy_filtered_graveyard_conditional}} */
spell_destroy_filtered_graveyard ::= destroy_filtered_graveyard_conditional "."

/* The paired quantities leave exactly one member of the announced group. */
/* @sem Instruction::[Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), objects:$random_partition_three, chooser:Chance, count:AsManyAsCan(Constant(2))}], action:Move{objects:Prepared(@selection_id(0)), destination:$random_partition_destination, qualifiers:[]}}}, Effect{result:@next, operation:$random_partition_other}] */
instructions_random_partition_three ::= "choose" random_partition_three "." "return" "two" "of" "them" "at" "random" random_partition_destination "and" random_partition_other

/* @sem Instruction::[Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), objects:$random_partition_two, chooser:Chance, count:AsManyAsCan(Constant(1))}], action:Move{objects:Prepared(@selection_id(0)), destination:$random_partition_destination, qualifiers:[]}}}, Effect{result:@next, operation:$random_partition_other}] */
instructions_random_partition_two ::= "choose" random_partition_two "." "return" "one" "of" "them" "at" "random" random_partition_destination "and" random_partition_other

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(3)), filter:@and($card_filter, $random_partition_scope)})) */
random_partition_three ::= "three" "target" card_filter "cards" random_partition_scope

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(2)), filter:@and($card_filter, $random_partition_scope)})) */
random_partition_two ::= "two" "target" card_filter "cards" random_partition_scope

/* @sem ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}) */
random_partition_scope ::= "in" "your" "graveyard"

/* The destination is attached to the selected move, not to the target pool. */
random_partition_destination ::= random_partition_entry | random_partition_entry_tapped

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
random_partition_entry ::= "to" "the" "battlefield"

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}} */
random_partition_entry_tapped ::= "to" "the" "battlefield" "tapped"

/* @sem Operation::Move{objects:Targets(@last_slot), destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
random_partition_other ::= "put" "the" "other" "on" "the" "bottom" "of" "your" "library"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$instructions_random_partition_three]}} */
spell_random_partition_three ::= instructions_random_partition_three "."

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$instructions_random_partition_two]}} */
spell_random_partition_two ::= instructions_random_partition_two "."

/* A player may be reselected as the defending player. */
/* @sem Operation::ChangeCombat{change:Reselect{objects:$combat_attacker_defender, players_only:true}} */
combat_player_reselection ::= "you" "may" "reselect" "which" "player" combat_attacker_defender

/* The damage source and its measured characteristic are the same announced card. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card_a_graveyard), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:DealDamage{source:$target_card_a_graveyard, recipients:Objects($affected), amount:ObjectProperty{object:$target_card_a_graveyard, property:$receipt_stat, information:CurrentOrLastKnown}, preventable:true}}] */
instructions_exile_target_card_its_stat_damage ::= "exile" target_card_a_graveyard "." "that" "card" "deals" "damage" "equal" "to" "its" receipt_stat "to" affected

/* Each player performs the mana action independently. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:Keyword{actor:One(Bound(0)), action:KeywordAction::LoseUnspentMana}}]}}] */
clause_each_lose_unspent_mana ::= players_singular "loses" "all" "unspent" "mana"

/* A source can be instructed to deal damage; the recipient and amount remain independent operands. */
/* @sem $have_damage_source */
have_damage_dealer ::= "have" have_damage_source "deal"

/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$have_damage_dealer, recipients:$recipients, amount:$value, preventable:true}}] */
clause_have_damage_recipient_equal ::= have_damage_dealer "damage" "to" recipients "equal" "to" value

/* A player reveals the cards in their hand that satisfy two exclusions. */
/* @sem Operation::Reveal{objects:Zone{scope:Players{zone:Hand, players:$players_singular}, kind:Card, filter:$filter_negative_type_pair}} */
reveal_each_excluded_hand_card ::= players_singular "reveals" "each" filter_negative_type_pair "card" "in" "their" "hand"

/* The chosen filter and the ranked population are independent.  The bound
   player controls the ranked population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:ControlledBy(One(Bound(0)))} */
bound_ranked_permanents ::= "permanents" "they" "control"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])} */
bound_ranked_filtered_permanents ::= filter_plural "they" "control"

bound_ranked_population ::= bound_ranked_permanents | bound_ranked_filtered_permanents

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Extreme{among:$bound_ranked_population, property:$stat, highest:true}])} */
bound_controlled_greatest_population_independent ::= filter_phrase "they" "control" "with" "the" "greatest" stat "among" bound_ranked_population

/* The alternative reading ranks the eligible controlled population itself. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:Extreme{among:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))])}, property:$stat, highest:true}} */
bound_controlled_greatest_population_eligible ::= filter_phrase "they" "control" "with" "the" "greatest" stat "among" "permanents" "they" "control"

/* Move a named population from the shared command zone under your control.
   Both filter positions preserve the command-zone population convention. */
/* @sem Operation::Move{objects:Zone{scope:Shared(Command), kind:Card, filter:AllOf([$filter_plural, $filter_plural])}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
put_all_command_zone_battlefield ::= "put" "all" filter_plural "from" "the" "command" "zone" "onto" "the" "battlefield" "under" "your" "control"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(EventSubject)), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot} */
event_subject_it_gains_keyword ::= "it" "gains" keyword_name duration

/* A hand choice enters blocking the attacker from the enclosing block pair. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, count:AsManyAsCan(Constant(1))}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[Blocking(BlockPair(Attacker))]}}, qualifiers:[]}}]}}]} */
optional_hand_entry_block_pair ::= "you" "may" "put" "a" filter_phrase "card" "from" "your" "hand" "onto" "the" "battlefield" "blocking" "that" "creature"

/* The chosen payment gates the independently optional entry. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$cost_return_to_owners_hand]}, optional:true}}, If{condition:PaymentChosen(@marked), then:$optional_hand_entry_block_pair, otherwise:Program{}}]} */
optional_return_paid_block_entry ::= "you" "may" cost_return_to_owners_hand "." "if" "you" "do" "," optional_hand_entry_block_pair

/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:$counter_singular_amount}]} */
put_counters_direct_singular ::= "put" counter_singular_amount counter_kind "counter" "on" affected

counter_singular_amount ::= counter_a | counter_another

/* @sem Expr::Constant(1) */
counter_another ::= "another"

/* Two independently identified objects share an exile move. */
/* @sem ObjectSet::Union([One($object_ref), $tap_qualified_attacker_target]) */
exile_pair_qualified_attacker ::= object_ref "and" tap_qualified_attacker_target

/* The X definition measures the referenced spell, including last-known information. */
/* @sem Expr::ObjectProperty{object:@qualified_object(ObjectKind::Spell, ObjectFilter::Any), property:ManaValue, information:CurrentOrLastKnown} */
mill_referenced_spell_mana_amount ::= "X" "cards" "," "where" "X" "is" "the" "spell's" "mana" "value"

/* Choose one card from either zone of the previously identified player. The
   joined results retain both possible exile arrivals for later references. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One($hand_look_that)}, kind:Card, filter:$adjective_nontype}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]}, Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One($hand_look_that)}, kind:Card, filter:$adjective_nontype}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]}]}, Effect{result:@next, operation:JoinResults{results:[@back(4), @back(2)]}}, Effect{result:@next, operation:JoinResults{results:[@back(5), @back(3)]}}] */
choice_target_hand_graveyard_exile ::= "you" "choose" "a" adjective_nontype "card" "from" hand_look_that "graveyard" "or" "hand" "and" "exile" "it"

/* The permission follows this exact two-branch exile producer, and names the
   first joined arrival, not an arbitrary earlier exile. */
/* @sem Instruction::[...$choice_target_hand_graveyard_exile, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@back(3), phase:After, index:0}), from:Exile, action:$exiled_play_action, filter:Any}, terms:_{cost:Normal, spend_as:$choice_two_zones_spending}})], duration:WhileExiled(Result{result:@back(3), phase:After, index:0}), evaluation:LiveObjects}}] */
choice_two_zones_cast_permission ::= choice_target_hand_graveyard_exile "." "you" "may" exiled_play_action "that" "card" "for" "as" "long" "as" "it" "remains" "exiled" "," "and" choice_two_zones_spending

choice_two_zones_spending ::= choice_two_zones_spending_color | choice_two_zones_spending_type

/* @prefer always */
/* @sem SpendAs::AnyColor */
choice_two_zones_spending_color ::= "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "that" "spell"

/* @prefer always */
/* @sem SpendAs::AnyType */
choice_two_zones_spending_type ::= "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "that" "spell"

/* A delayed main phase retains the complete scoped program. */
/* @sem Operation::CreateDelayedTrigger{event:$scheduled_your_next_main, start:Immediately, body:$program} */
scheduled_next_main_program ::= "at" scheduled_your_next_main "," program

/* @sem Operation::SetLifeTotal{players:One($life_total_possessive), amount:$value} */
have_possessive_life_total_become ::= "have" life_total_possessive "life" "total" "become" value

/* Chosen-type populations use the same move for any filtered cards. */
/* @prefer always */
/* @sem Operation::Move{objects:$chosen_type_filtered_graveyard_cards, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_chosen_type_graveyard_population ::= "return" chosen_type_filtered_graveyard_cards "to" "the" "battlefield"

/* The conditional tests the payment just offered to the event player. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:EventSubject, cost:$event_player_repeated_mana_cost, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:$combat_plural_attack_prohibition}]}, otherwise:Program{}}]} */
event_player_repeated_payment_program ::= "that" "player" "may" "pay" event_player_repeated_mana_cost "." "if" "they" "don't" "," combat_plural_attack_prohibition "."

/* The player's whole hand is observed before a bound-hand continuation. */
/* @sem Instruction::Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}}} */
bound_reveal_whole_hand ::= "reveals" "their" "hand"

/* The choice names the same bound player's hand. */
/* @sem Instruction::Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:$adjective_nontype}, count:AsManyAsCan($counter_amount)}} */
bound_hand_choice ::= "choose" counter_amount adjective_nontype "card" "from" "each" "of" "those" "hands"

/* @sem Instruction::Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}} */
bound_hand_choice_discard ::= "those" "players" "discard" "those" "cards"

/* @sem Instruction::[$bound_reveal_whole_hand, $bound_hand_choice, $bound_hand_choice_discard] */
bound_player_instruction_sequence ::= bound_reveal_whole_hand "." bound_hand_choice "." bound_hand_choice_discard

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:$bound_player_instruction_sequence}}] */
instructions_each_player_sequence ::= players_singular bound_player_instruction_sequence

/* Reveal each player's complete hand, then let each choose one card of each color. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:Reveal{objects:Zone(_{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any})}}]}}, ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone(_{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), count:AsManyAsCan(Constant(5)), constraints:[OneForEach([Color(White), Color(Blue), Color(Black), Color(Red), Color(Green)])]}}]}}] */
each_hand_choose_each_color ::= "each" "player" "reveals" "their" "hand" "," "chooses" "one" "card" "of" "each" "color" "from" "it"

/* The unselected cards belong to the same players' hands as the choice. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:DiscardObjects{objects:Zone(_{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:AllOf([InSet(Unselected(@prior)), $adjective_nontype])})}}]}}] */
each_hand_discard_other_nontype ::= "then" "discards" "all" "other" adjective_nontype "cards"

/* @sem Instruction::[...$each_hand_choose_each_color, ...$each_hand_discard_other_nontype] */
instructions_each_hand_choice_discard ::= each_hand_choose_each_color "," each_hand_discard_other_nontype

/* The choice and flip form one process, so its outcome counts refer to that flip. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_number_between}, Effect{result:@next, operation:FlipCoins{players:One(AbilityController), count:ChosenNumber, protocol:Called}}, Effect{result:@next, operation:$coin_process_win_draw}, Effect{result:@next, operation:$coin_process_loss_damage}, $coin_process_win_permission] */
chosen_number_coin_process ::= choose_number_between "." "flip" "that" "many" "coins" "." coin_process_win_draw "." coin_process_loss_damage "." coin_process_win_permission

/* @sem Operation::Draw{players:One(AbilityController), amount:CountCoinOutcomes{source:Latest, outcome:Won}} */
coin_process_win_draw ::= "for" "each" "flip" "you" "win" "," "draw" "a" "card"

/* @sem Operation::DealDamage{source:Source, recipients:Players(One(AbilityController)), amount:Multiply([$number, CountCoinOutcomes{source:Latest, outcome:Lost}]), preventable:true} */
coin_process_loss_damage ::= "for" "each" "flip" "you" "lose" "," SELF_NAME "deals" number "damage" "to" "you"

/* @sem Instruction::If{condition:Compare{left:CountCoinOutcomes{source:Latest, outcome:Won}, test:Compare{comparison:Equal, value:$number_words}}, then:Program{instructions:[Effect{result:@next, operation:$coin_process_hand_permission}]}, otherwise:Program{}} */
coin_process_win_permission ::= "if" "you" "won" number_words "flips" "this" "way" "," coin_process_hand_permission

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Hand, players:One(Affected)}, kind:Card, filter:Any}), from:Hand, action:CastSpell, filter:Any}, terms:_{cost:Free}})], duration:$this_duration, evaluation:LiveObjects} */
coin_process_hand_permission ::= "you" "may" "cast" "spells" "from" "your" "hand" this_duration "without" "paying" "their" "mana" "costs"

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, body:_{instructions:$chosen_number_coin_process}, announcement:@announcement} */
triggered_chosen_number_coin_process ::= event_clause "," chosen_number_coin_process "."

/* The condition is scoped to this complete-hand reveal payment. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$payment_reveal_own_hand, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[If{condition:$revealed_hand_distinct_values, then:$program, otherwise:Program{}}]}, otherwise:Program{}}] */
optional_reveal_hand_distinct_values ::= "you" "may" payment_reveal_own_hand "." "if" revealed_hand_distinct_values "," program

/* A whole-hand reveal supplies the choice, and the selected card is discarded
   by the same player. The filter remains an operand of the choice. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($callback_hand_player)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(2)), zone:Hand}, filter:@and($observed_hand_single_card, ObjectFilter::OwnedBy(One(Target{slot:@last_slot, index:0})))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}] */
shared_revealed_hand_choice_discard ::= callback_hand_player "reveals" "their" "hand" "." "you" "choose" observed_hand_single_card "from" "it" "." "that" "player" "discards" "that" "card"

/* A later action is performed by the player whose hand was revealed. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$shared_revealed_hand_choice_discard, Effect{result:@next, operation:@apply(PlayerSet::One(Target{slot:@last_slot, index:0}), $discard_random_third)}]}} */
spell_revealed_hand_discard_then_random ::= shared_revealed_hand_choice_discard "," "then" discard_random_third "."

/* A private-zone population and its additive perpetual type change compose in any program. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$hand_perpetual_card_filter}, changes:$hand_perpetual_add_type}}]} */
program_sentence_hand_card_add_type ::= "each" hand_perpetual_card_filter "card" "in" "your" "hand" "perpetually" hand_perpetual_add_type "."

hand_perpetual_card_filter ::= milled_return_permanent | milled_return_creature

/* @sem Change::[AddCardType(Artifact)] */
hand_perpetual_add_artifact ::= "becomes" "an" "artifact" "in" "addition" "to" "its" "other" "types"

/* @sem Change::[AddCardType(Enchantment)] */
hand_perpetual_add_enchantment ::= "becomes" "an" "enchantment" "in" "addition" "to" "its" "other" "types"

/* @sem Change::[AddCardType(Creature)] */
hand_perpetual_add_creature ::= "becomes" "a" "creature" "in" "addition" "to" "its" "other" "types"

/* @sem Change::[AddCardType(Land)] */
hand_perpetual_add_land ::= "becomes" "a" "land" "in" "addition" "to" "its" "other" "types"

hand_perpetual_add_type ::= hand_perpetual_add_artifact | hand_perpetual_add_enchantment | hand_perpetual_add_creature | hand_perpetual_add_land

/* A bounded choice from an immediately observed hand keeps the observed
   population, its owner and the resulting selection together. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(2)), zone:Hand}, filter:@and($adjective_nontype, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}, ObjectFilter::OwnedBy($players_singular))}, count:AsManyAsCan($counter_amount)}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}] */
bounded_observed_hand_choice_discard ::= "you" "choose" counter_amount adjective_nontype "card" "with" "mana" "value" number "or" "less" "from" "it" "." players_singular "discards" "that" "card"

/* @sem Instruction::[Effect{result:@next, operation:$full_hand_observation}, ...$bounded_observed_hand_choice_discard] */
observed_hand_bounded_choice_discard ::= full_hand_observation "." bounded_observed_hand_choice_discard

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$observed_hand_bounded_choice_discard}} */
spell_observed_hand_bounded_choice_discard ::= observed_hand_bounded_choice_discard "."

/* A choice from the hand just inspected, followed by its owner's discard. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(Target{slot:@last_slot, index:0})}, kind:Card, filter:Any}, count:AsManyAsCan($card_count_many)}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}] */
hand_count_choice_discard ::= "choose" card_count_many "from" "it" "." "that" "player" "discards" "those" "cards"

/* The target binds both the inspected hand and the continuation's hand. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One($target_possessive)}, kind:Card, filter:Any}}}, ...$hand_count_choice_discard] */
instructions_target_hand_count_discard ::= "look" "at" target_possessive "hand" "and" hand_count_choice_discard

/* The damage receipt and its follow-up remain in the unpaid branch, and the
   pronoun refers to the same explicit source as the damage action. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$damage_receipt_discard_payment, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Players(One(AbilityController)), amount:$number, preventable:true}}, If{condition:Compare{left:CountPlayers(Intersection([DamagedBy(@last_result), One(AbilityController)])), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:SetTapped{objects:One($self_explicit_ref), tapped:true}}]}, otherwise:Program{}}]}, otherwise:Program{}}]} */
program_sentence_damage_unless_payment_receipt ::= self_explicit_ref "deals" number "damage" "to" "you" "unless" "you" damage_receipt_discard_payment "." "if" "it" "deals" "damage" "to" "you" "this" "way" "," "tap" "it" "."

/* @sem Cost::Cost{parts:[$damage_receipt_discard_part]} */
damage_receipt_discard_payment ::= damage_receipt_discard_part

damage_receipt_discard_part ::= cost_discard | cost_discard_filtered | cost_discard_many | cost_discard_filtered_many

/* A resolving tap selection supplies the reflexive action receipt. */
/* @sem Vec<Instruction>::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, count:AsManyAsCan($number_words), constraints:[]}}, Effect{result:@next, operation:SetTapped{objects:Selected(@prior), tapped:true}}] */
reflexive_tap_counted ::= "tap" number_words filter_plural

/* A reflexive callback can pump a target controlled by the event player, then
   goad the same referenced object. The changes and duration remain operands. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($callback_active_target)), changes:$changes, duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:Goad{object:$that_noun}}}]} */
callback_active_controlled_goad ::= callback_active_target changes duration "." "goad" that_noun

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(EventSubject)))}), index:0} */
callback_active_target ::= "target" filter_phrase "that" "player" "controls"

/* A finite boon retains the future event and an independently scoped program. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateBoon{actor:One(AbilityController), event:$boon_entry_event, times:Constant(3), body:Ability(@scope(Ability::Spell{announcement:@announcement, body:$program_sentence}))}}]}} */
triggered_three_time_boon ::= event_clause "," "you" "get" "a" "three-time" "boon" "with" '"' boon_entry_event "," program_sentence '"'

/* A controlled group entering together produces a single batch event. */
/* @sem EventSpec::Batch{event:ZoneChange{objects:AllOf([$filter_plural, ControlledBy(One(AbilityController)), ControlledBy(One(AbilityController))]), to:Battlefield}, per:Whole} */
boon_entry_event ::= "whenever" "one" "or" "more" filter_plural "you" "control" "enter"

/* Scope the permission to the immediately preceding exile, including its destination. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One($retirement_exile_graveyard_target), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:$exiled_play_action, filter:Any})], duration:$while_you_control, evaluation:LiveObjects}}]} */
retirement_exile_graveyard_permission ::= "exile" retirement_exile_graveyard_target "." "you" "may" exiled_play_action "it" while_you_control "."

retirement_exile_graveyard_target ::= target_any_card_your_graveyard | target_card_your_graveyard | target_any_card_opponent_graveyard | target_card_opponent_graveyard | target_any_card_a_graveyard | target_card_a_graveyard

/* The grant applies to the actual object returned by the immediately preceding move. */
/* @sem Program::_{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:$target_nonlegendary_recent_graveyard}), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$closed_grants}}]} */
choose_recent_return_perpetual_program ::= "choose" target_nonlegendary_recent_graveyard "." "return" "it" "to" "the" "battlefield" "." "it" "perpetually" "gains" closed_grants

/* The repeat condition is tied to the sacrifice in this choice sequence. */
/* @sem Instruction::[Repeatable{instructions:[Effect{result:@next, operation:ChooseObjects{player:$target_opponent, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(Target{slot:0, index:0})))}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@mark, operation:@sacrificed_result(Operation::Sacrifice{players:One(Target{slot:0, index:0}), objects:One(Result{result:@prior, phase:After, index:0})})}, If{condition:ObjectMatches{object:Result{result:@marked, phase:Before, index:0}, filter:$adjective_nontype}, then:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}]}] */
instructions_random_choice_sacrifice_repeat ::= target_opponent "chooses" "a" filter_phrase "they" "control" "at" "random" "and" "sacrifices" "it" "." "if" "a" adjective_nontype "permanent" "is" "sacrificed" "this" "way" "," "repeat" "this" "process"

/* Choice receipts and the sacrifice share the same opponent population. */
/* @sem Instruction::[ForEachPlayer{players:$choice_opponent_population, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$adjective_nontype}, filter:ControlledBy(One(Bound(0)))}, count:AsManyAsCan(Constant(4)), constraints:[OneForEach([$noun, $noun_2, $noun_3, $noun_4])]}}]}}, Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:$choice_opponent_population, objects:Unselected(@prior)})}] */
instructions_opponents_choose_four_sacrifice_rest ::= choice_opponent_population "chooses" "an" noun "," "a" noun "," "an" noun "," "and" "a" noun "from" "among" "the" adjective_nontype "permanents" "they" "control" "," "then" "sacrifices" "the" "rest"

choice_opponent_population ::= players_each_opponent | players_each_other_opponent

/* The departure's graveyard incarnation is the object actually exiled. */
/* @sem Instruction::Effect{result:@mark, operation:Move{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}} */
death_event_exile_it ::= "exile" "it"

/* This target count measures opponents with the stated number of counters. */
/* @sem Expr::CountPlayers(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:CountCounters{recipients:Players(One(Bound(0))), kind:$counter_kind, information:CurrentOrLastKnown}, test:Compare{comparison:GreaterOrEqual, value:$number_words}}}])) */
opponents_with_counter_count ::= "the" "number" "of" "opponents" "who" "have" number_words "or" "more" counter_kind "counters"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:UpTo($opponents_with_counter_count), filter:InZone(Players{zone:Graveyard, players:One(AbilityController)}), constraints:[]})), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]} */
callback_return_counted_graveyard_cards ::= "return" "up" "to" "X" "target" "cards" "from" "your" "graveyard" "to" "your" "hand" "," "where" "X" "is" opponents_with_counter_count

/* Scope the reflexive to the death-event exile, and let its callback own targets. */
/* @sem Program::Program{instructions:[$death_event_exile_it, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$reflexive_callback_program})}]} */
death_exile_reflexive_program ::= death_event_exile_it "." "when" "you" "do" "," reflexive_callback_program

/* A singular random choice from creatures that attacked at least once this turn. */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($random_attacker_head, ObjectFilter::Condition(Condition::Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}))}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]} */
random_attacker_choice ::= "choose" "a" random_attacker_head "at" "random" "that" "attacked" "this" "turn"

random_attacker_head ::= noun_creature | random_attacker_qualified_head

/* @sem @and($adjective, $noun_creature) */
random_attacker_qualified_head ::= adjective noun_creature

/* @sem Operation::Destroy{objects:One(Result{result:@prior, phase:After, index:0}), regeneration:true} */
random_attacker_destroy ::= "destroy" "that" "creature"

/* The marked selection is shared by the attack rule and the delayed trigger. */
/* @sem Instruction::Effect{result:@mark, operation:ChooseObjects{player:$chosen_attack_player, objects:$chosen_attack_population, count:AnyNumber}} */
chosen_attack_choice ::= chosen_attack_player "chooses" "any" "number" "of" chosen_attack_population

chosen_attack_player ::= target_opponent | target_player

/* @sem Instruction::Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(@that_player)), changes:[PlayerRule(MustAttack{attackers:InSet(Selected(@marked)), defenders:Any}), PlayerRule(Prohibit(AttackWith(Not(InSet(Selected(@marked))))))], duration:DuringNextTurn(@that_player), evaluation:LiveObjects}} */
chosen_attack_rule ::= "during" "that" "player's" "next" "turn" "," "the" "chosen" "creatures" "attack" "if" "able" "," "and" "other" "creatures" "can't" "attack"

/* @sem Instruction::Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:One(@that_player)}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([InSet(Selected(@marked)), Condition(Not(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:$chosen_attack_history_window, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$chosen_attack_threshold}}))])}, regeneration:true}}]}}} */
chosen_attack_delayed ::= "at" "the" "beginning" "of" "that" "turn's" "end" "step" "," "destroy" "each" "of" "the" "chosen" "creatures" "that" "didn't" chosen_attack_threshold chosen_attack_history_window

chosen_attack_history_window ::= chosen_attack_this_turn | chosen_attack_last_turn

/* @sem HistoryWindow::ThisTurn */
chosen_attack_this_turn ::= "this" "turn"

/* @sem HistoryWindow::LastTurn */
chosen_attack_last_turn ::= "last" "turn"

/* The permission names the exact arrival produced by this exile instruction.
   Keeping the pair together proves the antecedent in both directions. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One($target_card), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:CastSpell, filter:Any}, terms:_{cost:Normal, spend_as:AnyType, into_exile:true}})], duration:$this_duration, evaluation:LiveObjects}}]} */
program_exile_target_cast_permission ::= "exile" target_card "." "you" "may" "cast" "it" this_duration "," "and" "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "that" "spell" "." "if" "that" "spell" "would" "be" "put" "into" "a" "graveyard" "," "exile" "it" "instead"

/* The remainder is the same population from which the controller chose. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, count:UpTo($value)}}, Effect{result:@next, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, Not(InSet(Selected(@prior)))])}, regeneration:true}}] */
instructions_choose_up_to_destroy_rest ::= "choose" "up" "to" value filter_plural "," "then" "destroy" "the" "rest"

/* A pair of announced creatures can fight after a conditional counter placement.
   The first target is the controlled creature referenced by the condition and
   counter; the second is independently announced for the fight. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), index:0} */
fight_controlled_target ::= "target" "creature" "you" "control"

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:ZoneChange{objects:SameObject(Candidate), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
fight_controlled_entry_test ::= "entered" "this" "turn"

/* @sem Instruction::Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:0, index:0})), kind:$counter_kind, amount:Constant(1)}]}} */
fight_controlled_counter_one ::= "put" "a" counter_kind "counter" "on" "it"

/* @sem Instruction::Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:0, index:0})), kind:$counter_kind, amount:$number_words}]}} */
fight_controlled_counter_many ::= "put" number_words counter_kind "counters" "on" "it"

fight_controlled_counter ::= fight_controlled_counter_one | fight_controlled_counter_many

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[If{condition:ObjectMatches{object:$fight_controlled_target, filter:$fight_controlled_entry_test}, then:Program{instructions:[$fight_controlled_counter]}, otherwise:Program{}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:Target{slot:0, index:0}, second:$target_qualified_creature}}}]}} */
spell_controlled_entry_counter_fight ::= "choose" fight_controlled_target "and" target_qualified_creature "." "if" "the" "creature" "you" "control" fight_controlled_entry_test "," fight_controlled_counter "." "then" "those" "creatures" "fight" "each" "other" "."

/* Keep selection and movement together; the follow-up refers to that arrival. */
/* @sem Instruction::[...$linked_exile_counter_entry, ...$entered_it_grant_sacrifice] */
linked_exile_entry_grant_sacrifice ::= linked_exile_counter_entry "." entered_it_grant_sacrifice

linked_exile_counter_entry ::= linked_exile_counter_entry_a | linked_exile_counter_entry_an

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([$noun, ExiledWith(Source)])}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[]}}, qualifiers:[]}}] */
linked_exile_counter_entry_a ::= "put" "a" noun "card" "exiled" "with" "this" "creature" "onto" "the" "battlefield" "under" "your" "control" "with" "a" counter_kind "counter" "on" "it"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([$noun, ExiledWith(Source)])}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[]}}, qualifiers:[]}}] */
linked_exile_counter_entry_an ::= "put" "an" noun "card" "exiled" "with" "this" "creature" "onto" "the" "battlefield" "under" "your" "control" "with" "a" counter_kind "counter" "on" "it"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[GrantKeyword($keyword_name)], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:One(Result{result:@back(4), phase:After, index:0})})}]}}}] */
entered_it_grant_sacrifice ::= "it" "gains" keyword_name "." "sacrifice" "it" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* The producer and its reflexive threshold share the exact tap receipt. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(Tapped), @agree($filter_plural, $filter_plural_2), ControlledBy(One(AbilityController))])}, count:AnyNumber, constraints:[]}}, Effect{result:@mark, operation:SetTapped{objects:Selected(@prior), tapped:true}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object{kind:Permanent, zones:[Battlefield]}, count:Exactly(Constant(1)), filter:AllOf([$adjective_nontype, Any, ControlledBy(OpponentsOf(AbilityController)), Property{property:ManaValue, test:Compare{comparison:LessOrEqual, value:CountObjects(Transition{result:@reflexive_performed, phase:Before})}}])}), index:0}), destination:Library{position:Shuffled, order:DestinationDefault, arrival:_{counters:[], states:[]}}, qualifiers:[]}}]}})}]}}] */
instructions_tap_choice_shuffle_receipt ::= "tap" "any" "number" "of" "untapped" filter_plural "you" "control" "." "when" "you" "do" "," "shuffle" "target" adjective_nontype "permanent" "an" "opponent" "controls" "with" "mana" "value" "X" "or" "less" "into" "its" "owner's" "library" "," "where" "X" "is" "the" "number" "of" filter_plural "tapped" "this" "way"

/* The counter and its completion condition stay together, preserving the
   announced spell and the action whose completion controls the continuation. */
/* @sem Cost::Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Counter{objects:One($target_stack_spell), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}}]} */
counter_spell_completion_cost ::= "counter" target_stack_spell

/* The first target's controller chooses from their own hand and controls the
   resulting permanent. */
/* @sem Vec<Instruction>::[Optional{decider:ControllerOf(Target{slot:0, index:0}), body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:ControllerOf(Target{slot:0, index:0}), objects:Zone{scope:Players{zone:Hand, players:One(ControllerOf(Target{slot:0, index:0}))}, kind:Card, filter:$a_card}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(ControllerOf(Target{slot:0, index:0})), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}] */
countered_controller_put_hand_card ::= "its" "controller" "may" "put" a_card "from" "their" "hand" "onto" "the" "battlefield"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$counter_spell_completion_cost, optional:false}}, If{condition:PaymentChosen(@prior), then:Program{instructions:$countered_controller_put_hand_card}, otherwise:Program{}}]}} */
spell_counter_completion_continuation ::= counter_spell_completion_cost "." countered_this_way countered_controller_put_hand_card "."

/* Each card is evaluated in its controller’s hand, retaining its existing types. */
/* @sem Operation::CreatePerpetualEffect{objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}), changes:$retained_vowel_type_change} */
perpetual_each_hand_card_type ::= "each" card_filter "card" "in" "your" "hand" "perpetually" retained_vowel_type_change

/* Both phases use the same linked exile population. */
/* @sem Operation::RestartGame{keep:$restart_linked_population, then:Move{objects:$restart_linked_population, destination:$battlefield_control, qualifiers:[]}} */
restart_linked_exile ::= "restart" "the" "game" "," "leaving" "in" "exile" restart_linked_population "." "then" "put" "those" "cards" "onto" "the" "battlefield" battlefield_control

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_phrase, AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]), ExiledWith($object_ref)])} */
restart_linked_population ::= "all" filter_phrase "cards" "exiled" "with" object_ref

/* @sem Operation::DealDamage{source:$self_explicit_ref, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any})), amount:$number, preventable:true} */
damage_any_target_shared ::= self_explicit_ref "deals" number "damage" "to" "any" "target"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(RecipientObject{slot:0, index:0})), changes:[Rule(Prohibit(Regenerate))], duration:$this_duration, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateReplacement{event:ZoneChange{objects:SameObject(RecipientObject{slot:0, index:0}), from:Battlefield, to:Graveyard}, limit:UntilExpired, duration:$this_duration_2, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}}}] */
damage_recipient_creature_rider ::= "that" "creature" "can't" "be" "regenerated" this_duration "and" "if" "it" "would" "die" this_duration "," "exile" "it" "instead"

/* Each vote permits one permanent card to enter from its controller's hand. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)])}, count:UpTo(Votes(Word($vote_word)))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}] */
clause_vote_hand_permanent_battlefield ::= "you" "may" "put" "a" "permanent" "card" "from" "your" "hand" "onto" "the" "battlefield" "for" "each" vote_word "vote"

/* X is read from the cast spell that prompted this trigger. */
/* @sem Program::_{instructions:[Effect{result:@next, operation:SetX{object:EventSubject, value:Multiply([CastX(EventSubject), Constant(2)])}}]} */
program_double_cast_x ::= "double" "the" "value" "of" "X" "."

/* @sem Ability::Triggered{event:$event_cast_spell_cost_contains_x, limits:_{}, body:$program_multiply_cast_x, announcement:@announcement} */
triggered_double_cast_x ::= event_cast_spell_cost_contains_x "," program_multiply_cast_x

program_multiply_cast_x ::= program_double_cast_x | program_triple_cast_x

/* @sem Program::_{instructions:[Effect{result:@next, operation:SetX{object:EventSubject, value:Multiply([CastX(EventSubject), Constant(3)])}}]} */
program_triple_cast_x ::= "triple" "the" "value" "of" "X" "."

/* A bounded boon owns its event and its independently resolving program. */
/* @sem Instruction::[Effect{result:@next, operation:CreateBoon{actor:One(AbilityController), event:$boon_sacrifice_event, times:$boon_times, body:Program{instructions:[...$instructions]}}}] */
clause_bounded_boon ::= "you" "get" "a" boon_times "boon" "with" '"' boon_sacrifice_event "," instructions "." '"'

/* @sem Expr::Constant(2) */
boon_two_times ::= "two-time"

/* @sem Expr::Constant(3) */
boon_three_times ::= "three-time"

boon_times ::= boon_two_times | boon_three_times

/* @sem EventSpec::Batch{event:Player{event:Sacrifices, players:One(AbilityController)}, per:Whole} */
boon_sacrifice_event ::= "whenever" "you" "sacrifice" "one" "or" "more" "permanents"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$clause_bounded_boon, ...$instructions]}} */
spell_boon_then_instructions ::= clause_bounded_boon NEWLINE instructions "."

/* Random exile supplies the arrival receipt used by the scoped casting continuation. */
/* @sem Instruction::[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any}), count:AsManyAsCan($card_count), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
random_opponent_graveyard_exile ::= "exile" card_count "at" "random" "from" "each" "opponent's" "graveyard"

exile_for_free_cast_producer ::= random_opponent_graveyard_exile | clause_random_graveyard_cards

/* The producer is constrained to an exile move; the owner test consumes the cast result. */
/* @sem Instruction::[...$exile_for_free_cast_producer, Effect{result:@mark, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Transition{result:@prior, phase:After}, count:AnyNumber, cost:Free}}, ForEachPlayer{players:Matching{binding:0, condition:Compare{left:CountObjects(Zone(_{scope:Shared(Stack), kind:Spell, filter:AllOf([InSet(Affected(@marked)), OwnedBy(One(Bound(0)))])})), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}, binding:0, body:_{instructions:[Effect{result:@next, operation:LoseLife{players:One(Bound(0)), amount:Aggregate{objects:Zone(_{scope:Shared(Stack), kind:Spell, filter:AllOf([InSet(Affected(@marked)), OwnedBy(One(Bound(0)))])}), property:ManaValue, aggregation:Sum}}}]}}] */
instructions_random_exile_cast_owner_life ::= exile_for_free_cast_producer "." "you" "may" "cast" "any" "number" "of" "spells" "from" "among" "cards" "exiled" "this" "way" "without" "paying" "their" "mana" "costs" "." "then" "each" "player" "who" "owns" "a" "spell" "you" "cast" "this" "way" "loses" "life" "equal" "to" "its" "mana" "value"

/* Both event arms share an actor and a destination, but their moved cards are
   the sacrifice arrival and discard receipt respectively. */
/* @sem Ability::Triggers([@scope(Ability::Triggered{event:Player{event:Sacrifices, players:$event_player, objects:$filter_phrase}, limits:_{}, announcement:@announcement, body:_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), destination:$paired_event_graveyard_destination, qualifiers:[]}}]}}]}}), @scope(Ability::Triggered{event:Discard(_{players:$event_player, cards:$card_filter, kind:Any, grouping:Card}), limits:_{}, announcement:@announcement, body:_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Query{objects:InZone{objects:One(Discarded), zone:Graveyard}, index:0}), destination:$paired_event_graveyard_destination, qualifiers:[]}}]}}]}})]) */
trigger_sacrifice_discard_graveyard_entry ::= "whenever" event_player "sacrifices" ("a" | "an") filter_phrase "or" "discards" ("a" | "an") card_filter "card" "," "you" "may" paired_event_graveyard_destination "."

/* @sem $battlefield_control */
paired_event_graveyard_destination ::= "put" "that" "card" "from" "a" "graveyard" "onto" "the" "battlefield" battlefield_control

/* An excess-damage reflexive trigger has its own target announcement. */
/* @sem Ability::Spell{body:Program{instructions:[Effect{result:@next, operation:WithReflexive{action:$excess_reflexive_damage, when:ExcessDamage(None), body:Ability(@scope(Ability::Spell{body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$excess_reflexive_destroy_filter}), index:0}), regeneration:true}}]}, announcement:@announcement}))}}]}, announcement:@announcement} */
spell_excess_reflexive_destroy ::= excess_reflexive_damage "." "when" "it" "deals" "excess" "damage" "this" "way" "," "destroy" "target" excess_reflexive_destroy_filter "."

/* @sem Operation::DealDamage{source:$self_explicit_ref, recipients:Objects(One($target_object)), amount:$number, preventable:true} */
excess_reflexive_damage ::= self_explicit_ref "deals" number "damage" "to" target_object

/* @sem ObjectFilter::AllOf([$filter_head, ControlledBy(OpponentsOf(AbilityController)), Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:Game(ExcessDamageThisWay)}}]) */
excess_reflexive_destroy_filter ::= filter_head "an" "opponent" "controls" "with" "mana" "value" "less" "than" "or" "equal" "to" "that" "amount" "of" "excess" "damage"

/* Choose from either zone of the previously revealed player's cards. */
/* @sem Instruction::ChooseOne{decider:AbilityController, options:[_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(Target{slot:0, index:0})}, kind:Card, filter:$adjective_nontype}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}, _{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Graveyard, players:One(Target{slot:0, index:0})}, kind:Card, filter:$adjective_nontype}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}]} */
choose_revealed_player_either_zone_exile ::= "you" "choose" "a" adjective_nontype "card" "from" "that" "player's" "graveyard" "or" "hand" "and" "exile" "it"

/* @sem Instruction::[$callback_hand_reveal, $choose_revealed_player_either_zone_exile] */
instructions_reveal_hand_either_zone_exile ::= callback_hand_reveal "." choose_revealed_player_either_zone_exile

/* Keep the linked exile and both returns in one scope: the attachment set and
   the host return must refer to the same movement receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Union([One($enchanted_creature_ref), Zone(_{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, AttachedTo(SameObject($enchanted_creature_ref))])})]), destination:Exile{visibility:FaceUp, arrival:_{}}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@back(4), phase:After, index:0}), zone:Exile}, destination:Battlefield{controller:Owner, arrival:_{}}}}]}}]}}}, If{condition:PaymentChosen(@prior), then:_{instructions:[Effect{result:@next, operation:Move{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:InSet(Recorded(0))}), destination:Battlefield{controller:Owner, arrival:_{states:[AttachedTo(Result{result:@prior, phase:After, index:0})]}}}}]}, otherwise:_{}}]}}}] */
instructions_exile_host_and_attachments_return ::= "exile" enchanted_creature_ref "and" "all" filter_plural "attached" "to" "it" "." "at" "the" "beginning" "of" "the" "next" "end" "step" "," "return" "that" "card" "to" "the" "battlefield" "under" "its" "owner's" "control" "." "if" "you" "do" "," "return" "the" "other" "cards" "exiled" "this" "way" "to" "the" "battlefield" "under" "their" "owners'" "control" "attached" "to" "that" "creature"

/* The reveal and the immediate alternative choice share the same target hand
   and filter. Keeping the producer and both consumers in one scope also makes
   inverse printing check those shared operands. */
/* @sem Instruction::[Effect{result:@next, operation:RevealFromHand{actor:One($filtered_hand_reveal_player), cards:$revealed_hand_capped_filter}}, ChooseOne{decider:AbilityController, options:[_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One($filtered_hand_reveal_player)}, kind:Card, filter:$revealed_hand_capped_filter}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$chosen_card_destination, qualifiers:[]}}]}, _{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Graveyard, players:One($filtered_hand_reveal_player)}, kind:Card, filter:Any}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$chosen_card_destination, qualifiers:[]}}]}]}] */
filtered_hand_reveal_alternative ::= filtered_hand_reveal_player "reveals" "each" revealed_hand_capped_filter "." "choose" "a" "card" "revealed" "this" "way" "or" "a" "card" "in" "their" "graveyard" "." chosen_card_destination

/* @sem ObjectFilter::AllOf([$adjective_nontype, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}]) */
revealed_hand_capped_filter ::= adjective_nontype "card" "in" "their" "hand" "with" "mana" "value" value "or" "less"

filtered_hand_reveal_player ::= target_opponent | target_player

chosen_card_destination ::= chosen_card_exile | chosen_card_return_hand

/* @sem MovementDestination::Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}} */
chosen_card_exile ::= "exile" "that" "card"

/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
chosen_card_return_hand ::= "put" "that" "card" "into" "its" "owner's" "hand"

/* The repeated descriptions identify the two targets throughout this sequence. */
/* @sem ObjectFilter::AllOf([$noun, ControlledBy(One(AbilityController))]) */
chosen_pair_controlled_description ::= noun "you" "control"

/* @sem ObjectFilter::AllOf([$noun, ControlledBy(OpponentsOf(AbilityController))]) */
chosen_pair_opposing_description ::= noun "an" "opponent" "controls"

/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@agree($chosen_pair_controlled_description, @agree($chosen_pair_controlled_description_2, $chosen_pair_controlled_description_3))}), index:0})), kind:$counter_kind, amount:$count_plural}]}}]}, otherwise:Program{}}, Effect{result:@next, operation:DealDamage{source:Target{slot:0, index:0}, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@agree($chosen_pair_opposing_description, $chosen_pair_opposing_description_2)}), index:0})), amount:ObjectProperty{object:Target{slot:0, index:0}, property:$stat, information:CurrentOrLastKnown}, preventable:true}}] */
instructions_chosen_pair_conditional_counters_damage ::= "choose" "target" chosen_pair_controlled_description "and" "target" chosen_pair_opposing_description "." NEWLINE "if" condition "," "put" count_plural counter_kind "counters" "on" "the" chosen_pair_controlled_description "." NEWLINE "the" chosen_pair_controlled_description "deals" "damage" "equal" "to" "its" stat "to" "the" chosen_pair_opposing_description

/* The sacrifice and its reflexive callback share the producer receipt. */
/* @sem Instruction::[$sacrificed_creature_producer_choice, Effect{result:@next, operation:ReflexiveTrigger{performed:@prior, body:Program{instructions:$sacrificed_duplicate_paid_callback}, announcement:_{}}}] */
instructions_sacrificed_duplicate_callback ::= sacrificed_creature_producer_choice "." "when" "they" "do" "," sacrificed_duplicate_paid_callback

sacrificed_creature_producer_choice ::= sacrificed_creature_producer | sacrificed_untapped_creature_producer

/* @sem Instruction::Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One($target_player), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$adjective, CardType(Creature)])}, choose:AsManyAsCan(Constant(1))})} */
sacrificed_creature_producer ::= target_player "sacrifices" "a" adjective "creature" "of" "their" "choice"

/* @sem Instruction::Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One($target_player), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$adjective_untapped, CardType(Creature)])}, choose:AsManyAsCan(Constant(1))})} */
sacrificed_untapped_creature_producer ::= target_player "sacrifices" "an" adjective_untapped "creature" "of" "their" "choice"

/* The enclosing phrase identifies the sacrifice whose Before receipt is queried. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[$duplicate_discard_payment]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Duplicate(One(Query{objects:Transition{result:@back(4), phase:Before}, index:0})), count:Constant(1), destination:Hand(CardArrival{counters:[], states:[]})}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$duplicate_card_perpetual_changes}}]}, otherwise:Program{}}] */
sacrificed_duplicate_paid_callback ::= "you" "may" duplicate_discard_payment "." "if" "you" "do" "," "conjure" "a" "duplicate" "of" "the" "sacrificed" "creature" "into" "your" "hand" "." "it" "perpetually" duplicate_card_perpetual_changes

duplicate_discard_payment ::= cost_discard | cost_discard_filtered | cost_discard_many | cost_discard_filtered_many

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_sacrificed_duplicate_callback}} */
spell_sacrificed_duplicate_callback ::= instructions_sacrificed_duplicate_callback

/* @prefer always */
/* @sem Instruction::[...$random_graveyard_nontype, ...$copy_random_exile_it] */
random_graveyard_copy_original ::= random_graveyard_nontype "." copy_random_exile_it

/* The copy uses the arrival of the adjacent random exile, not the damage event. */
/* @sem Instruction::[...$clause_random_event_library_exile, Effect{result:@next, operation:$copy_random_exile_card_token}] */
random_event_library_copy ::= clause_random_event_library_exile "." copy_random_exile_card_token

/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[_{amount:$token_copy_single, words:CreatingEffect, recipe:Copy{object:Result{result:@prior, phase:After, index:0}, exceptions:$copy_enchantment_creature_stats}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
copy_random_exile_card_token ::= "create" token_copy_single "that" "card" "," "except" copy_enchantment_creature_stats

shared_exile_card_filter ::= shared_exile_card_ability_filter | shared_exile_card_type_filter

/* @prefer always */
/* @sem $card_ability_qualifier */
shared_exile_card_ability_filter ::= "cards" card_ability_qualifier

/* @sem $filter_phrase */
shared_exile_card_type_filter ::= filter_phrase "cards"

/* A pair chosen under a shared-property restriction can be consumed by a
   reciprocal fight. Both indexed fighters belong to that same target slot. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:$constrained_creature_pair, second:Target{slot:@last_slot, index:1}}} */
constrained_pair_fight ::= constrained_creature_pair "." "those" "creatures" "fight" "each" "other"

/* A subsequent conditional hit refers to the controller of the announced permanent. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:Players(One(ControllerOf(Target{slot:@last_slot, index:0}))), amount:$number, preventable:true}}]}, otherwise:Program{}}] */
clause_also_damage_target_controller_if ::= damage_source_ref "also" "deals" number "damage" "to" "that" "permanent's" "controller" "if" condition

/* Record the population once, then reuse that receipt for both effects. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:NoteObjects{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, Condition(Compare{left:EventHistory{event:Pair{event:Blocks, objects:SameObject(Candidate), others:SameObject($object_ref)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})])}}}, Effect{result:@next, operation:SetTapped{objects:Selected(@marked), tapped:true}}, Effect{result:@next, operation:CreateContinuousEffect{source:$object_ref, affected:Objects(Selected(@marked)), changes:[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})], duration:DuringControllersNextUntapStep, evaluation:LiveObjects}}]} */
program_tap_blockers_skip ::= "tap" "all" filter_plural "that" "blocked" object_ref "this" "turn" "." "they" "don't" "untap" "during" "their" "controller's" "next" "untap" "step"

/* Both implied modes return their own target; the conditional change follows
   that mode's movement receipt and is shared by the two alternatives. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:UpTo(Constant(1)), filter:Any}), index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, If{condition:$condition_bargained, then:Program{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:Transition{result:@prior, phase:After}, changes:[$perpetual_extra_cast_cost]}}]}, otherwise:Program{}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:AllOf([$adjective_nontype, Any])}), index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, If{condition:$condition_bargained, then:Program{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:Transition{result:@prior, phase:After}, changes:[$perpetual_extra_cast_cost]}}]}, otherwise:Program{}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied} */
return_mixed_target_conditional_perpetual ::= "return" "up" "to" "one" "target" "spell" "or" adjective_nontype "permanent" "to" "its" "owner's" "hand" "." "if" condition_bargained "," "that" "card" "perpetually" "gains" '"' perpetual_extra_cast_cost '"'

/* A one-use boon creates a trigger whose quoted instruction changes the cast spell. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:$boon_when_event, duration:Indefinite, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:$boon_cast_entry_change}]}, once:true}}] */
clause_one_time_cast_entry_boon ::= "you" "get" "a" "one-time" "boon" "with" '"' boon_when_event "," boon_cast_entry_change "." '"'

/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:$noun_creature} */
boon_when_event ::= "when" "you" "cast" "a" noun_creature "spell"

/* @sem Operation::ChangeSpell{subject:One(EventSubject), changes:$boon_entry_counters} */
boon_cast_entry_change ::= "that" "creature" boon_entry_counters

/* Three separately named counter kinds each add one counter on entry. */
/* @sem Change::[EntersWithCounters(_{kind:$counter_kind, amount:Constant(1)}), EntersWithCounters(_{kind:$counter_kind_2, amount:Constant(1)}), EntersWithCounters(_{kind:$counter_kind_3, amount:Constant(1)})] */
boon_entry_counters ::= "enters" "with" "an" "additional" counter_kind "counter" "," counter_kind "counter" "," "and" counter_kind "counter" "on" "it"

/* @sem Ability::Spell{body:_{instructions:[Effect{result:@next, operation:$continuous_snapshot_plain}, ...$clause_one_time_cast_entry_boon]}, announcement:@announcement} */
spell_continuous_then_cast_boon ::= continuous_snapshot_plain "." NEWLINE clause_one_time_cast_entry_boon

/* The announced target is the object copied by the subsequent token creation. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$count, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:$copy_plural_creature_stats_two_keywords}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
chosen_target_plural_copies ::= "choose" object_ref "." "create" count "tokens" "that" "are" "copies" "of" "it" "," "except" copy_plural_creature_stats_two_keywords

/* @prefer always */
/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:[...$chosen_target_plural_copies]}} */
spell_chosen_target_plural_copies ::= chosen_target_plural_copies "."

/* The loop binds the player for both the damage recipients and the count. */
/* @sem Instruction::[ForEachPlayer{players:$loop_player_population, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_player_damage}]}}] */
clause_each_player_bound_damage ::= "for" loop_player_population "," bound_player_damage

/* @sem Operation::DealDamage{source:$self_explicit_ref, recipients:Union([Players(One(Bound(0))), Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_nonlist_head, ControlledBy(One(Bound(0)))])})]), amount:$bound_player_controlled_count, preventable:true} */
bound_player_damage ::= self_explicit_ref "deals" "damage" "to" "that" "player" "and" "each" filter_nonlist_head "that" "player" "controls" "equal" "to" bound_player_controlled_count

/* A named target group is moved by the subsequent plural reference. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$target_up_to_graveyard_arrivals, destination:$graveyard_arrival_return_destination, qualifiers:[]}}] */
instructions_choose_graveyard_arrival_return ::= "choose" target_up_to_graveyard_arrivals "." "return" "them" graveyard_arrival_return_destination

graveyard_arrival_return_destination ::= graveyard_arrival_return_tapped | graveyard_arrival_return_untapped

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}} */
graveyard_arrival_return_tapped ::= "to" "the" "battlefield" "tapped"

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
graveyard_arrival_return_untapped ::= "to" "the" "battlefield"

/* X counts the named counters on the actual affected objects; one color is
   chosen for the entire production. */
/* @sem ManaProduction::Repeat{amount:$distribution_counter_count, production:ChooseOne([Amount{color:White, amount:Constant(1)}, Amount{color:Blue, amount:Constant(1)}, Amount{color:Black, amount:Constant(1)}, Amount{color:Red, amount:Constant(1)}, Amount{color:Green, amount:Constant(1)}]), choice:Once} */
mana_counter_one_color ::= "X" "mana" "of" "any" "one" "color" "," "where" "X" "is" distribution_counter_count

/* The delayed spell uses the arrival of this specific exile, not an arbitrary prior result. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$random_graveyard_filter, InZone(Players{zone:Graveyard, players:One(AbilityController)})]), constraints:[AtRandom]}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$random_exile_cast_time, start:Immediately, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Result{result:@marked, phase:After, index:0}), count:Exactly(Constant(1)), cost:Free, into_exile:true}}]}}]}}}] */
instructions_random_graveyard_delayed_cast ::= "exile" "target" random_graveyard_filter "card" "from" "your" "graveyard" "chosen" "at" "random" "." "at" random_exile_cast_time "," "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" "." "if" "that" "spell" "would" "be" "put" "into" "your" "graveyard" "," "exile" "it" "instead"

random_exile_cast_time ::= delayed_your_upkeep | delayed_your_end

random_graveyard_filter ::= filter_phrase | random_graveyard_noun_or_sorcery

/* @sem ObjectFilter::AnyOf([$noun_atomic, $spell_sorcery]) */
random_graveyard_noun_or_sorcery ::= noun_atomic "or" spell_sorcery

/* Copy characteristics are operands of the copy, independent of its count. */
/* @sem Operation::CopyOnStack{actor:One(AbilityController), object:$object_ref, times:Constant(1), targets:Same, exceptions:$copy_stack_retained_characteristics} */
copy_stack_retained_stats_types ::= "copy" object_ref "," "except" copy_stack_retained_characteristics

/* @sem Vec<CopyException>::[SetPowerToughness{power:$value, toughness:$value_2}, AddCreatureTypes($becomes_types)] */
copy_stack_retained_characteristics ::= "the" "copy" "is" "a" value "/" value becomes_types "in" "addition" "to" "its" "other" "types"

/* A singular targeted permanent remains the referent of the following sentence. */
/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($target_object)), kind:$counter_kind, amount:Constant(1)}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_object)), changes:[AddSupertype(Legendary), CreatureTypes{mode:Add, types:Listed($becomes_types)}], duration:Indefinite, evaluation:Snapshot}}] */
counter_then_legendary_types ::= "put" "a" counter_kind "counter" "on" target_object "." "it" "becomes" "a" "legendary" becomes_types "in" "addition" "to" "its" "other" "types"

/* @sem ManaProduction::ColorsAmong{objects:$mana_graveyard_cards} */
mana_colors_among_cards ::= "one" "mana" "of" "any" "color" "among" mana_graveyard_cards

/* A shared graveyard population preserves its own filter and numeric bound. */
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:AllOf([$filter_phrase, $modifier_mana_value_numeric])} */
all_graveyard_cards_with_mana_value ::= "all" filter_phrase "cards" modifier_mana_value_numeric "from" "all" "graveyards"

battlefield_exile_operation ::= exile_objects | exile_two_groups

/* The first and second populations are independently specified. */
/* @sem Instruction::[Effect{result:@next, operation:$battlefield_exile_operation}, Effect{result:@next, operation:Move{objects:$all_graveyard_cards_with_mana_value, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
instructions_exile_battlefield_graveyard ::= battlefield_exile_operation "from" "the" "battlefield" "and" all_graveyard_cards_with_mana_value

/* A mixed target action retains independently scoped permanent and spell modes. */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Airbend{object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:@and(ObjectFilter::Not(SameObject(Source)), $noun)}), index:0}}}}]}, weight:1}) */
other_airbend_permanent_mode ::= "other" "target" noun

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:$value, maximum:$value}, options:[$other_airbend_permanent_mode, @scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Airbend{object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:UpTo(Constant(1)), filter:Any}), index:0}}}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied} */
/* @prefer always */
other_permanent_or_spell_airbend_modes ::= "airbend" "up" "to" value other_airbend_permanent_mode "or" "spell" "."

/* A chosen controlled permanent returns to its own owner's hand. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Name(@card_name), ControlledBy(One(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]} */
program_return_named_controlled ::= "return" "a" filter_phrase "named" SELF_NAME "you" "control" "to" "its" "owner's" "hand"

/* The perpetual recipient is the single card produced by the draft. */
/* @sem Instruction::[Effect{result:@next, operation:$draft_self_spellbook_card}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:[$discarded_perpetual_grant, GrantAbility($quoted_perpetual_cast_trigger)]}}] */
instructions_draft_cast_grants ::= draft_self_spellbook_card "." "that" "card" "perpetually" "gains" '"' discarded_perpetual_grant '"' "and" quoted_perpetual_cast_trigger

/* Each recipient is also the player whose draws are counted. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Players(One(Bound(0))), amount:EventHistory{event:Player{event:Draws, players:One(Bound(0))}, window:ThisTurn, measure:Occurrences}, preventable:true}}]}}] */
clause_player_draw_history_damage ::= self_explicit_ref "deals" "damage" "to" players_singular "equal" "to" "the" "number" "of" "cards" "that" "player" "has" "drawn" "this" "turn"

/* A single battlefield selection is shared by movement instructions. */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan(Constant(1))} */
single_battlefield_choice ::= "a" filter_phrase

/* @sem Instruction::[Effect{result:@next, operation:$single_battlefield_choice}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
put_single_choice_owners_library ::= "put" single_battlefield_choice "on" "top" "of" "its" "owner's" "library"

/* The one-shot cast trigger copies its event subject, preserving the exception. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:$spell_filter}, duration:$this_duration, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:Same, exceptions:[CopyException::RemoveSupertypes([Legendary])]}}]}, once:true}}] */
clause_next_cast_nonlegendary_copy ::= "when" "you" "next" "cast" spell_filter this_duration "," "copy" "it" "," "except" "the" "copy" "isn't" "legendary"

/* The selected source and recipient remain distinct in the future event. */
/* @prefer always */
/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:@and($noun, $modifier_chosen_name), recipients:Players($combat_damage_player_set), kind:Combat, grouping:SourceRecipient, subject:Source}) */
event_chosen_named_combat ::= "whenever" "a" noun modifier_chosen_name "deals" "combat" "damage" "to" combat_damage_player_set

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:Operation::@scope(Operation::CreateTrigger{event:$event_chosen_named_combat, duration:EndOfTurn, announcement:@announcement, body:Program{instructions:$conjoined}})}] */
clause_delayed_chosen_combat_event ::= event_chosen_named_combat "this" "turn" "," conjoined

/* Name a card before establishing a chosen-name combat trigger. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$choose_a_card_name}, ...$clause_delayed_chosen_combat_event] */
instructions_named_card_delayed_combat ::= choose_a_card_name "." clause_delayed_chosen_combat_event

/* Each stack domain owns its announcement; the holder reference is shared. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Retarget{actor:One(AbilityController), object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:AllOf([OnStack(SingleTarget), TargetsAny(Objects(One($self_ref_holder)))])}), index:0}, targets:Must}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Retarget{actor:One(AbilityController), object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Ability, zones:[Stack]}), count:Exactly(Constant(1)), filter:AllOf([OnStack(SingleTarget), TargetsAny(Objects(One($self_ref_holder)))])}), index:0}, targets:Must}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied} */
mixed_retarget_holder_modes ::= "change" "the" "target" "of" "target" "spell" "or" "ability" "that" "targets" "only" self_ref_holder "." "the" "new" "target" "must" "be" "a" "creature" "."

/* A death-event card can be shuffled only while its arrival remains in the graveyard. */
/* @sem Operation::Move{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{}}, qualifiers:[]} */
event_graveyard_shuffle_owner ::= "shuffle" "it" "into" "its" "owner's" "library" "if" "it's" "in" "your" "graveyard"

/* The selected action is a resolution payment; the continuation observes that choice. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$event_graveyard_shuffle_owner}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:$program, otherwise:Program{}}]} */
perpetual_quoted_event_program ::= "you" "may" event_graveyard_shuffle_owner "." "if" "you" "do" "," program

/* The pronoun refers to the spell of the enclosing cast event. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:Same}}]} */
cast_event_copy_it ::= "copy" "it" "."

/* @prefer always */
/* @sem DamagePart::DamagePart{recipients:$recipients, amount:$value} */
damage_part_additional_value ::= value "additional" "damage" "to" recipients

/* @sem DamagePart::DamagePart{recipients:Objects($affected), amount:$value} */
damage_part_additional_an ::= "an" "additional" value "damage" "to" affected

/* The selected population and the counted tap receipt form one scoped program. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(Tapped), @agree($plural, $returned_count_noun)])}, count:AnyNumber}}, Effect{result:@mark, operation:SetTapped{objects:Selected(@prior), tapped:true}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($affected), changes:[Pump{power:CountObjects(Transition{result:@marked, phase:Before}), toughness:CountObjects(Transition{result:@marked, phase:Before})}], duration:$duration, evaluation:Snapshot}}]} */
tap_selected_receipt_pump_program ::= "tap" "any" "number" "of" "untapped" plural "you" "control" "." affected "gets" "+" "1" "/" "+" "1" duration "for" "each" returned_count_noun "tapped" "this" "way" "."

/* Both mentions refer to the same established object; the chosen attachment remains controlled by the actor. */
/* @sem Instruction::[If{condition:ObjectMatches{object:@it, filter:$subtype}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:AttachChosen{actor:One(AbilityController), attachments:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$subtype_2, ControlledBy(One(AbilityController))])}, count:Exactly(Constant(1)), hosts:One(@it)}}]}}]}, otherwise:Program{}}] */
conditional_antecedent_attach_choice ::= "if" "it's" "a" subtype "," "you" "may" "attach" "an" subtype "you" "control" "to" "it"

/* The pump establishes the object used by the following conditional. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(@remember_object($target_object))), changes:$static_singular_pump, duration:$duration, evaluation:Snapshot}}, ...$conditional_antecedent_attach_choice] */
target_pump_conditional_attachment ::= target_object static_singular_pump duration "." conditional_antecedent_attach_choice

/* Each player receives the snapshot of the next player's selected population. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($neighbor_control_population_except), changes:[SetController(Bound(0))], duration:Indefinite, evaluation:Snapshot}}]}}] */
clause_each_player_gains_neighbor_control ::= "each" "player" "gains" "control" "of" neighbor_control_population_except

/* An optional hand choice and its singular result remain in the same scope. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), count:AsManyAsCan(Constant(1))}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:_{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$hand_choice_perpetual_grant}}]}, otherwise:_{instructions:$conjoined}}] */
instructions_optional_hand_choice_perpetual ::= "you" "may" "choose" "a" filter_phrase "card" "in" "your" "hand" "." "if" "you" "do" "," "it" "perpetually" hand_choice_perpetual_grant "otherwise" "," conjoined

/* @sem Change::[GrantAbility(Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject(Source)}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:Constant(1)})}}]}}))] */
hand_choice_perpetual_grant ::= "gains" '"' "this" "creature" "enters" "with" "an" "additional" counter_kind "counter" "on" "it" "." '"'

/* The mill and its returned cards share one receipt; the destination remains each card owner’s hand. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Mill{players:One($target_player), amount:$mill_return_count}}, Effect{result:@next, operation:Move{objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$subtype}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]} */
program_target_mill_return_subtype ::= target_player "mills" mill_return_count "," "then" "puts" "each" subtype "card" "milled" "this" "way" "into" "their" "hand"

mill_return_count ::= card_count_one | mill_return_count_plural

/* @sem $count_plural */
mill_return_count_plural ::= count_plural "cards"

/* Lesser refers to the subject of this death event, not an arbitrary prior object. */
/* @sem Ability::Triggered{event:$event_self_or_dies, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$death_lesser_return}]}} */
triggered_death_lesser_return ::= "whenever" event_self_or_dies "," death_lesser_return "."

death_lesser_return ::= death_lesser_return_tapped | death_lesser_return_untapped

/* @sem Operation::Move{objects:One($death_lesser_graveyard_target), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]} */
death_lesser_return_tapped ::= "return" death_lesser_graveyard_target "to" "the" "battlefield" "tapped"

/* @sem Operation::Move{objects:One($death_lesser_graveyard_target), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
death_lesser_return_untapped ::= "return" death_lesser_graveyard_target "to" "the" "battlefield"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($card_filter, $graveyard_card_lesser_event_mana, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0} */
death_lesser_graveyard_target ::= "target" card_filter "card" graveyard_card_lesser_event_mana "from" "your" "graveyard"

/* The pronoun refers to the controller's life total in the preceding test. */
/* @sem Condition::Compare{left:PlayerNumber{player:AbilityController, number:Life}, test:NumberTest::Compare{comparison:$stat_comparison, value:$life_total_quantity}} */
life_total_less_than_value ::= "your" "life" "total" "is" stat_comparison life_total_quantity

/* @sem Operation::SetLifeTotal{players:One(AbilityController), amount:$life_total_quantity} */
referenced_life_becomes_equal ::= "it" "becomes" "equal" "to" life_total_quantity

/* @sem Ability::Triggered{event:$event_clause, intervening_if:$life_total_less_than_value, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$referenced_life_becomes_equal}]}} */
triggered_life_total_comparison_set ::= event_clause "," "if" life_total_less_than_value "," referenced_life_becomes_equal "."

life_total_quantity ::= value | active_starting_life_quantity

/* @sem Expr::StartingLife(Active) */
active_starting_life_quantity ::= "the" "active" "player's" "starting" "life" "total"

/* Count players who received combat damage, independent of its source. */
/* @sem Expr::CountPlayers(Matching{binding:0, condition:Compare{left:EventHistory{event:Damage(_{source_kind:Any, sources:Any, recipients:Players(One(Bound(0))), kind:Combat, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}) */
players_dealt_combat_damage_this_turn ::= "for" "each" "player" "who" "was" "dealt" "combat" "damage" "this" "turn"

/* @sem Operation::Draw{players:One(AbilityController), amount:$players_dealt_combat_damage_this_turn} */
draw_per_player_dealt_combat_damage ::= "draw" "a" "card" players_dealt_combat_damage_this_turn

/* The delayed instruction has its own body and expires with this turn. */
/* @sem Operation::CreateDelayedTrigger{event:Turn{point:MainPhaseBegins, players:All}, start:Immediately, expires:EndOfTurn, body:Program{instructions:[Effect{result:@next, operation:$delayed_main_action}]}} */
delayed_next_main_damage_draw ::= "at" "the" "beginning" "of" "the" "next" "main" "phase" "this" "turn" "," delayed_main_action

delayed_main_action ::= draw_per_player_dealt_combat_damage | delayed_main_draw

/* @sem Operation::Draw{players:One(AbilityController), amount:$card_count} */
delayed_main_draw ::= "draw" card_count

/* Compose a temporary grant with the independently specified delayed action. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$controlled_each_temporary_grants}, Effect{result:@next, operation:$delayed_next_main_damage_draw}]}} */
spell_temporary_grant_delayed_main ::= controlled_each_temporary_grants "." NEWLINE delayed_next_main_damage_draw "."

/* This phrase is only used with the adjacent singleton discard activation below. */
/* @sem Operation::DealDamage{source:$self_explicit_ref, recipients:Objects(One($target_permanent)), amount:ObjectProperty{object:Query{objects:CostObjects{payment:Activation, component:[2], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown}, preventable:true} */
discard_payment_mana_value_damage ::= self_explicit_ref "deals" "damage" "to" target_permanent "equal" "to" "the" "discarded" "card's" "mana" "value"

/* Component 2 is a single discarded card, so the input receipt is unambiguous. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[Mana($mana_symbols), TapSymbol, $discard_payment_single]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$discard_payment_mana_value_damage}]}} */
activated_discard_payment_damage ::= mana_symbols "," "{" "T" "}" "," "↑" discard_payment_single ":" discard_payment_mana_value_damage "."

discard_payment_single ::= cost_discard | cost_discard_filtered

/* The possessive identifies both the affected player and the starting-life value. */
/* @sem Operation::SetLifeTotal{players:One($starting_life_possessive), amount:Divide{numerator:StartingLife($starting_life_possessive), denominator:$starting_life_divisor, rounding:Down}} */
set_player_starting_life_fraction ::= starting_life_possessive "life" "total" "becomes" starting_life_divisor "their" "starting" "life" "total" "," "rounded" "down"

starting_life_possessive ::= up_to_target_player_possessive | target_possessive

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:UpTo(Expr::Constant(1)), filter:Any, players:All}), index:0} */
up_to_target_player_possessive ::= "up" "to" "one" "target" "player's"

starting_life_divisor ::= starting_life_half | starting_life_third

/* @sem Expr::Constant(2) */
starting_life_half ::= "half"

/* @sem Expr::Constant(3) */
starting_life_third ::= "a" "third" "of"

/* This operation is used only in the self-entry wrapper below: the event subject
   is the entering source whose casting expenditure the trailing definition names. */
/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($card_filter, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$entry_cast_mana_amount}}, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_entry_cast_mana_bounded_card ::= "return" "target" card_filter "card" "with" "mana" "value" "X" "or" "less" "from" "your" "graveyard" "to" "the" "battlefield" "," "where" "X" "is" entry_cast_mana_amount

/* @sem Expr::ManaSpent{object:EventSubject, filter:SpentManaFilter{}, aggregation:Count} */
entry_cast_mana_amount ::= "the" "amount" "of" "mana" "spent" "to" "cast" "this" "creature"

/* @sem Ability::Triggered{event:$event_self_enters, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$return_entry_cast_mana_bounded_card}]}} */
triggered_entry_cast_mana_return ::= "when" event_self_enters "," return_entry_cast_mana_bounded_card "."

/* Tap the announced target group, then choose one of those targets for a counter. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo($number_words), filter:$filter_plural})), tapped:true}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Targets(@last_slot)), kind:$counter_kind, amount:Constant(1), selection:_{player:AbilityController, count:AsManyAsCan(Constant(1))}}]}}] */
instructions_tap_targets_one_counter ::= "tap" "up" "to" number_words "target" filter_plural "." "put" "a" counter_kind "counter" "on" "one" "of" "them"

/* This follow-up is used only with a preceding creature-population effect. */
/* @sem Operation::CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Affected(@back(3))})}]}} */
delayed_sacrifice_affected_creatures ::= "sacrifice" "those" "creatures" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* The introductory keyword action and the alternative each retain their own operands. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Ascend} */
shared_ascend_action ::= "ascend"

/* @sem Instruction::If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:$shared_only_opponents_population_pump}]}, otherwise:Program{instructions:[Effect{result:@next, operation:$shared_all_population_pump}]}} */
shared_conditional_population_pump ::= shared_all_population_pump "." "if" condition "," "instead" shared_only_opponents_population_pump

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$shared_ascend_action}, $shared_conditional_population_pump]}} */
shared_ascend_conditional_population_spell ::= shared_ascend_action NEWLINE shared_conditional_population_pump "."

/* Another permanent excludes the event subject; the printed filter supplies its controller. */
/* @sem Cost::Cost{parts:[Move{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(EventSubject)), $filter_phrase])}, choose:Exactly(Constant(1))}], destination:OwnersHand(CardArrival{})}]} */
payment_return_another_event_permanent ::= "return" "another" filter_phrase "to" "its" "owner's" "hand"

/* The serial prefix and the attached-creature pair retain independent effects. */
/* @sem Instruction::[...$serial_action_clause, ...$attached_counter_grant] */
serial_before_attached_counter_grant ::= serial_action_clause "," attached_counter_grant

/* The second clause names the same enchanted creature as the counter recipient. */
/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($enchanted_creature_ref)), kind:$counter_kind, amount:Constant(1)}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($enchanted_creature_ref)), changes:[GrantKeyword($keyword_name)], duration:Indefinite, evaluation:Snapshot}}] */
attached_counter_grant ::= "put" "a" counter_kind "counter" "on" enchanted_creature_ref "," "and" "that" "creature" "gains" keyword_name

/* The delayed destruction repeats the same population that was required to attack. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$subtype_negated, CardType(Creature), ControlledBy(One(Active))])}), changes:[Rule(RequireCombat{action:Attack(Any), amount:AtLeast(Constant(1))})], duration:EndOfTurn, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([State(ControlledSinceBeforeCombat), AllOf([$subtype_negated, CardType(Creature), ControlledBy(One(Active))]), Condition(Not(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}))])}, regeneration:true}}]}}}] */
attack_active_non_subtype_followup ::= subtype_negated "creatures" "the" "active" "player" "controls" "attack" "this" "turn" "if" "able" "." "at" "the" "beginning" "of" "the" "next" "end" "step" "," "destroy" "each" "of" "those" "creatures" "that" "didn't" "attack" "this" "turn"

/* A hand exile and its draw share the same player and movement receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Zone{scope:Players{zone:$hand_exile_zone, players:One($hand_exile_draw_player)}, kind:Card, filter:$hand_exile_card_filter}, destination:Exile{visibility:$hand_exile_visibility, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Draw{players:One($hand_exile_draw_player), amount:CountObjects(Recorded(@marked))}}] */
instructions_hand_exile_draw_receipt ::= hand_exile_draw_player "exiles" "all" hand_exile_card_filter "from" "their" hand_exile_zone hand_exile_visibility "," "then" "draws" "that" "many" "cards"

hand_exile_draw_player ::= target_player | target_opponent

/* The delayed action refers to the preceding continuous effect's affected set. */
/* @sem Operation::CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Affected(0)})}]}} */
delayed_sacrifice_affected_plural ::= "sacrifice" "them" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* @sem Instruction::[Effect{result:@next, operation:$controlled_targets_artifact_animation}, Effect{result:@next, operation:$delayed_sacrifice_affected_plural}] */
instructions_controlled_animation_delayed_sacrifice ::= controlled_targets_artifact_animation "." delayed_sacrifice_affected_plural

/* The total constraint applies to the target group as a whole. */
/* @sem Operation::Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:AnyNumber, filter:$adjective_nontype, constraints:[TotalProperty{property:ManaValue, comparison:LessOrEqual, amount:$value}]})), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_total_value_target_permanents ::= "return" "any" "number" "of" "target" adjective_nontype "permanents" "with" "total" "mana" "value" value "or" "less" "to" "their" "owners'" "hands"

/* The selected cards come from the current graveyard, not the mill receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_instant_and_or_sorcery}, count:UpTo($count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
return_up_to_spell_cards_hand ::= "return" "up" "to" count filter_instant_and_or_sorcery "cards" "from" "your" "graveyard" "to" "your" "hand"

/* The named types determine both the first target and what the second shares. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::ExchangeControl{first:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AnyOf([CardType($exchange_named_type), CardType($exchange_named_type_2)])}), index:0}, second:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(SameObject(Target{slot:@last_slot, index:0})), AnyOf([SharesTypeFrom{types:[$exchange_named_type], with:Target{slot:@last_slot, index:0}}, SharesTypeFrom{types:[$exchange_named_type_2], with:Target{slot:@last_slot, index:0}}])])}), index:0}}} */
exchange_control_shared_types ::= "exchange" "control" "of" "target" exchange_named_type "or" exchange_named_type "and" "another" "target" "permanent" "that" "shares" "one" "of" "those" "types" "with" "it"

exchange_named_type ::= added_artifact | added_creature | added_enchantment | added_land

/* The chooser, controlling player, and target are the same bound player. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0}, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$player_a_noun, ControlledBy(One(Target{slot:0, index:0}))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Result{result:@prior, phase:After, index:0})), kind:$counter_kind, amount:$player_plural_counter_number}]}}] */
player_choose_controlled_counters ::= "target" "player" "chooses" "a" player_a_noun "they" "control" "and" "puts" player_plural_counter_number counter_kind "counters" "on" "it"

/* The player's own graveyard supplies the selected card and its owner receives it. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0}, objects:Zone{scope:Players{zone:Graveyard, players:One(Target{slot:0, index:0})}, kind:Card, filter:ObjectFilter::@or($player_a_noun, $noun)}, count:Exactly(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
player_return_graveyard_union ::= "target" "player" "returns" "a" player_a_noun "or" noun "card" "from" "their" "graveyard" "to" "their" "hand"

player_a_noun ::= noun_creature | noun_land | noun_planeswalker | noun_battle

player_plural_counter_number ::= n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10 | n11 | n12 | n13 | n14 | n15 | n20 | n30 | number_hundred

/* The singular duplicate is the arrival of this conjure action. */
/* @sem Instruction::[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Duplicate(One($object_ref)), count:Constant(1), destination:Hand(CardArrival{counters:[], states:[]})}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:[GrantAbility(Casting(SpendAsThoughAnyType))]}}] */
duplicate_hand_perpetual_spending ::= "conjure" "a" "duplicate" "of" object_ref "into" "your" "hand" "," "and" "the" "duplicate" "perpetually" "gains" '"' "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "this" "spell" "." '"'

/* The payment gates the complete duplicate-and-grant instruction sequence. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:$cost, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:$duplicate_hand_perpetual_spending}, otherwise:Program{}}]} */
operation_optional_duplicate_program ::= operation "." "then" "you" "may" cost "." "if" "you" "do" "," duplicate_hand_perpetual_spending

/* Both actions refer to the same previously named object. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:One($that_noun), tapped:false}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:Goad{object:$that_noun}}}] */
clause_untap_and_goad_reference ::= "untap" "and" "goad" that_noun

/* A controlled source's damage supplies the amount for a subsequent action. */
/* @sem EventSpec::Damage(_{source_kind:Any, sources:ControlledBy(One(AbilityController)), recipients:Players(OpponentsOf(AbilityController)), kind:$event_damage_kind, grouping:SourceRecipient, subject:Source}) */
controlled_source_opponent_damage_event ::= "a" "source" "you" "control" "deals" event_damage_kind "to" "an" "opponent"

/* @sem Operation::DealDamage{source:$self_explicit_ref, recipients:Objects(One($target_event_player_controlled)), amount:EventAmount, preventable:true} */
event_amount_damage_controlled_target ::= self_explicit_ref "deals" "that" "amount" "of" "damage" "to" target_event_player_controlled

/* @sem Ability::Triggered{event:$controlled_source_opponent_damage_event, intervening_if:$condition_one, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$event_amount_damage_controlled_target}]}} */
trigger_controlled_source_event_amount_damage ::= "whenever" controlled_source_opponent_damage_event "," "if" condition_one "," event_amount_damage_controlled_target "."

/* The event player's inspected hand is also the selection's population; the
   discarded objects are the actual selection, including an empty selection. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(EventSubject)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(EventSubject)}, kind:Card, filter:Any}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}] */
event_hand_look_choose_discard ::= "look" "at" "that" "player's" "hand" "and" "choose" "a" "card" "from" "it" "." "the" "player" "discards" "that" "card"

/* Compose an optional resolution payment with the event-hand continuation. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$cost, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:$event_hand_look_choose_discard}, otherwise:Program{}}] */
instructions_optional_event_hand_payment ::= "you" "may" "pay" cost "." "if" "you" "do" "," event_hand_look_choose_discard

/* A player-scoped battlefield population, controlled by the loop's player. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])} */
player_controlled_exile_population ::= "all" filter_plural "they" "control"

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:$player_controlled_exile_population, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
player_exiles_controlled_population ::= players_singular "exiles" player_controlled_exile_population

/* Bind the repeated filter to the preceding exile producer for inverse printing. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@mark, operation:Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($filter_plural, $filter_plural_2), ControlledBy(One(Bound(0)))])}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:$players_singular, tokens:[TokenSpec{amount:CountObjects(Transition{result:@marked, phase:Before}), words:CreatingEffect, recipe:$paid_mana_plural_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
player_exiles_population_creates_receipt ::= players_singular "exiles" "all" filter_plural "they" "control" "and" "creates" "X" paid_mana_plural_token_recipe "," "where" "X" "is" "the" "total" "power" "of" "the" filter_plural "they" "exiled" "this" "way"

/* @sem Instruction::[...$player_exiles_population_creates_receipt, ...$instructions] */
instructions_exile_receipt_then ::= player_exiles_population_creates_receipt "." "then" instructions

/* One copy is made of every member of the described card population. */
/* @sem Operation::CopyCards{actor:One(AbilityController), objects:$each_owned_exiled_card_counter, times:Constant(1)} */
copy_each_card_action ::= "copy" each_owned_exiled_card_counter

/* @sem Instruction::Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Copies(@prior), count:AnyNumber, cost:Normal, into_exile:false}}]}} */
may_cast_prior_card_copies ::= "you" "may" "cast" "the" "copies"

/* @sem Instruction::[Effect{result:@next, operation:$copy_each_card_action}, $may_cast_prior_card_copies] */
instructions_copy_cards_optional_cast ::= copy_each_card_action "." may_cast_prior_card_copies

/* A source-relative other card retains its own target and owner-hand destination. */
/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([Not(SameObject(Source)), $card_filter, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_other_source_card_hand ::= "return" "another" "target" card_filter "card" "from" "your" "graveyard" "to" "your" "hand"

/* A stack copy with an optional new target, retaining the referenced object. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$object_ref, times:Constant(1), targets:May}}]} */
program_copy_ref_new_target ::= "copy" object_ref "." "you" "may" "choose" "a" "new" "target" "for" "the" "copy" "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$object_ref, times:$copy_ref_multiple_count, targets:May}}]} */
program_copy_ref_multiple_targets ::= "copy" object_ref copy_ref_multiple_count "times" "." "you" "may" "choose" "a" "new" "target" "for" "each" "copy" "."

copy_ref_multiple_count ::= n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10 | n11 | n12 | n13 | n14 | n15 | n20 | n30 | number_hundred

copy_ref_while_body ::= program_copy_ref_new_target | program_copy_ref_multiple_targets

/* @sem Ability::Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:$event_you_cast_ref_while, limits:_{}, announcement:@announcement, body:$copy_ref_while_body})} */
scoped_cast_while_copy ::= "when" event_you_cast_ref_while "," copy_ref_while_body

/* The singleton receipt is supplied by the immediately preceding exile producer. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:$until_end_of_your_next_turn, evaluation:LiveObjects}}] */
permission_exiled_it_next_end ::= "you" "may" "play" "it" until_end_of_your_next_turn

/* Each group of additional targets excludes the preceding groups. */
/* @sem Instruction::Effect{result:@next, operation:Destroy{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_phrase}), index:0}), regeneration:true}} */
repeated_payment_initial_destroy ::= "destroy" "target" filter_phrase

/* @sem Instruction::Effect{result:@next, operation:Destroy{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(AdditionalCostPaid($kicker_operands)), filter:AllOf([Not(SameObject(Target{slot:0, index:0})), $filter_phrase])})), regeneration:true}} */
repeated_payment_second_destroy ::= "for" "each" "additional" kicker_operands "you" "paid" "," "destroy" "another" "target" filter_phrase

/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(AdditionalCostPaid($kicker_operands)), filter:AllOf([Not(SameObject(Target{slot:0, index:0})), Not(InSet(Targets(1))), $filter_phrase])})), regeneration:true}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:AdditionalCostPaid($kicker_operands)}}] */
repeated_payment_third_destroy_life ::= "for" "each" "additional" kicker_operands "you" "paid" "," "destroy" "another" "target" filter_phrase "," "and" "you" "gain" "1" "life"

/* @sem Instruction::[$repeated_payment_initial_destroy, $repeated_payment_second_destroy, ...$repeated_payment_third_destroy_life] */
instructions_repeated_payment_distinct_destroy ::= repeated_payment_initial_destroy "." repeated_payment_second_destroy "." repeated_payment_third_destroy_life

/* Rank one population by a stat while selecting from the separately stated kind. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Property{property:$creature_stat, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One($target_opponent))])}, property:$creature_stat, aggregation:Maximum}}}])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_exile_ranked_controlled ::= "exile" "a" filter_phrase "with" "the" "greatest" creature_stat "among" filter_plural target_opponent "controls"

/* The attacking event's player draws only when the combat condition holds. */
/* @sem Instruction::[@resolution(Instruction::If{condition:$condition_none_those_creatures_attacked_you, then:Program{instructions:[Effect{result:@next, operation:Draw{players:One(EventSubject), amount:$event_subject_draw_count}}]}, otherwise:Program{}})] */
event_subject_draw_if_combat ::= "they" "draw" event_subject_draw_count "if" condition_none_those_creatures_attacked_you

event_subject_draw_count ::= card_count_one | card_count_many

/* The once-per-turn choice wraps the copied spell's current operation. */
/* @sem Program::_{instructions:[Effect{result:@next, operation:PlayersDo{players:One(AbilityController), any_one:false, optional:true, once_each_turn:true, body:[Program(_{instructions:[Effect{result:@next, operation:PlayersDo{players:One(AbilityController), optional:true, once_each_turn:true, body:[Program($cast_event_copy_body)]}}]})], otherwise:[]}}]} */
program_optional_event_copy_once_each_turn ::= "you" "may" cast_event_copy_body "do" "this" "only" "once" "each" "turn" "."

/* @sem Ability::Triggered{event:$event_cast_branch_copy, limits:TriggerLimits{}, announcement:@announcement, body:$program_optional_event_copy_once_each_turn} */
triggered_cast_branch_optional_copy ::= "whenever" event_cast_branch_copy "," program_optional_event_copy_once_each_turn

copying_prior_player ::= prior_permanent_controller | that_player_word

/* The source, amount and recipient are independently composed within the optional instruction. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$have_damage_dealer, recipients:$recipients, amount:$value, preventable:true}}] */
clause_have_single_equal_damage ::= have_damage_dealer "damage" "equal" "to" value "to" recipients

/* Two separately announced targets keep the second distinct from the first. */
/* @sem Operation::Exchange(_{kind:Power, first:Object(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$possessive_permanent_filter}), index:0}), second:Object(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(SameObject(Target{slot:@last_slot, index:0})), $possessive_permanent_filter_2])}), index:0})}) */
perpetual_exchange_base_power ::= "perpetually" "exchange" "target" possessive_permanent_filter "base" "power" "with" "another" "target" possessive_permanent_filter "base" "power"

/* A population-wide stat adjustment and a bounded free cast compose as two effects. */
/* @prefer always */
/* @sem Ability::[Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$population_signed_pump}, Effect{result:@next, operation:$bounded_free_hand_cast}]}}] */
spell_population_pump_bounded_cast ::= population_signed_pump "." NEWLINE bounded_free_hand_cast "."

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}}, count:Exactly(Constant(1)), cost:Free} */
bounded_free_hand_cast ::= "you" "may" "cast" "a" "spell" "with" "mana" "value" number "or" "less" "from" "your" "hand" "without" "paying" "its" "mana" "cost"

/* A repeated draw and optional hand exile shares both operands with the target;
   the later suspend sentence applies only to the two resulting exile arrivals. */
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$a_card}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[[$counter_kind, Earlier{what:It, measure:Of(ManaValue)}]], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:EffectOn{subject:Objects(One(Result{result:@prior, phase:After, index:0})), effects:[Term{family:ExiledCardEffect, form:AddAbility, operands:[Ability(Mechanic{mechanic:BasicSuspend})]}]}}]}}, Effect{result:@next, operation:Draw{players:One($target_opponent), amount:$card_count}}, Optional{decider:$target_opponent, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:$target_opponent, objects:Zone{scope:Players{zone:Hand, players:One($target_opponent)}, kind:Card, filter:$a_card}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[[$counter_kind, Earlier{what:It, measure:Of(ManaValue)}]], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:EffectOn{subject:Objects(One(Result{result:@prior, phase:After, index:0})), effects:[Term{family:ExiledCardEffect, form:AddAbility, operands:[Ability(Mechanic{mechanic:BasicSuspend})]}]}}]}}] */
instructions_repeat_draw_hand_exile_suspend ::= "draw" card_count "," "then" "you" "may" "exile" a_card "from" "your" "hand" "with" "a" "number" "of" counter_kind "counters" "on" "it" "equal" "to" "its" "mana" "value" "." "then" target_opponent "does" "the" "same" "." "cards" "exiled" "this" "way" "that" "don't" "have" "suspend" "gain" "suspend"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$instructions_repeat_draw_hand_exile_suspend, ...$instructions]}} */
spell_repeat_draw_hand_exile_followed ::= instructions_repeat_draw_hand_exile_suspend "." NEWLINE instructions "."

/* A one-use cast trigger owns its quoted producer-scoped program. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:$event_cast, duration:Indefinite, announcement:_{}, body:$program_top_exile_play_one, once:true}}] */
one_time_cast_exile_play_boon ::= "you" "get" "a" "one-time" "boon" "with" '"' "when" event_cast "," program_top_exile_play_one '"'

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$damage_any_target_shared}, ...$one_time_cast_exile_play_boon]}} */
spell_damage_cast_exile_boon ::= damage_any_target_shared "." one_time_cast_exile_play_boon

/* Two players choose from their own populations. The later payment, return,
   and fight retain the selected-pair and payment receipts as one contract. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:Chosen, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$phase_visit_creature, ControlledBy(One(Chosen))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$phase_visit_creature_2, ControlledBy(One(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Move{selections:[_{objects:One(Result{result:@prior, phase:After, index:0})}, _{objects:One(Result{result:@prior, phase:After, index:1})}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:$paired_return_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, zone:Exile}, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{}}, qualifiers:[]}}]}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:Fight{first:Result{result:@back(5), phase:After, index:0}, second:Result{result:@back(5), phase:After, index:1}}}}]}}] */
paired_choices_optional_exile_fight ::= "they" "choose" "a" phase_visit_creature "they" "control" "," "then" "you" "choose" "a" phase_visit_creature "you" "control" "." "you" "may" "exile" "the" "chosen" "creatures" "." "if" "you" "do" "," "return" "them" "to" "the" "battlefield" "under" "their" "owners'" "control" "at" paired_return_event "." "otherwise" "," "the" "chosen" "creatures" "fight" "each" "other"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$choose_opponent}, ...$paired_choices_optional_exile_fight]}} */
spell_opponent_paired_choices ::= choose_opponent "." paired_choices_optional_exile_fight "."

paired_return_event ::= delayed_move_end_event | paired_return_next_combat

/* @sem EventSpec::Turn{point:CombatBegins, players:All} */
paired_return_next_combat ::= "the" "beginning" "of" "the" "next" "combat"

/* The conditional battlefield offer and the hand fallback refer to the same
   graveyard target; both destinations are part of this phrase's contract. */
/* @sem Instruction::[If{condition:ObjectMatches{object:$target_card_your_graveyard, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One($target_card_your_graveyard), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}]}, otherwise:Program{}}, Effect{result:@next, operation:Move{objects:One($target_card_your_graveyard), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_graveyard_conditional_battlefield_or_hand ::= "choose" target_card_your_graveyard "." "if" "it" "has" "mana" "value" value "or" "less" "," "you" "may" "put" "it" "onto" "the" "battlefield" "." "if" "you" "don't" "put" "it" "onto" "the" "battlefield" "," "put" "it" "into" "your" "hand"

/* The successful payment gates the entire same-target combat continuation. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$cost, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$shared_doubled_creature_block}, otherwise:Program{}}]} */
shared_payment_doubled_creature_block ::= "you" "may" "pay" cost "." "if" "you" "do" "," shared_doubled_creature_block

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$shared_payment_doubled_creature_block} */
triggered_payment_doubled_creature_block ::= "at" turn_event "," shared_payment_doubled_creature_block "."

/* A perpetual adjustment retains two independently editable numeric operands. */
/* @sem Operand::[Term{family:PerpetualEffect, form:AdjustPT, operands:[Integer($number), Integer($number_2)]}] */
graveyard_active_perpetual_adjustment ::= "gets" "+" NUMBER "/" "+" NUMBER

/* The card named by the adjustment is the same card whose extra zone is stated. */
/* @sem Operation::EffectOn{subject:Objects(Union([One($self_explicit_ref), One($self_explicit_ref)])), effects:$graveyard_active_perpetual_adjustment} */
graveyard_active_perpetual_effect ::= self_explicit_ref "perpetually" graveyard_active_perpetual_adjustment

/* A conditional alternative retains the target and both owner destinations. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One($target_permanent), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:Move{objects:One($that_noun), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Move{objects:One($that_noun), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
conditional_optional_owned_move ::= "return" target_permanent "to" "its" "owner's" "hand" "." NEWLINE? "if" condition "," "you" "may" "put" that_noun "on" "top" "of" "its" "owner's" "library" "instead"

/* Keep the optional destruction and the graveyard receipt together, so the
   continuation cannot consume an unrelated action's result. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo($number_words), filter:$adjective_nontype})), regeneration:true}}]}}, ForEachObject{objects:Transition{result:@last_result, phase:Before}, binding:0, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(ControllerOf(Bound(0))), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$singular_counted_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}] */
optional_destroy_graveyard_controller_tokens ::= "you" "may" "destroy" "up" "to" number_words "target" adjective_nontype "permanents" "." "for" "each" "permanent" "put" "into" "a" "graveyard" "this" "way" "," "its" "controller" "creates" "a" singular_counted_token_recipe

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$optional_destroy_graveyard_controller_tokens}} */
triggered_optional_destroy_graveyard_controller_tokens ::= event_clause "," optional_destroy_graveyard_controller_tokens "."

/* An unblocked attacker can be made blocked without naming a blocker. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::BecomeBlocked{object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([State(Unblocked), Attacking, $noun])}), index:0}}} */
unblocked_attacker_becomes_blocked ::= "target" "unblocked" "attacking" noun "becomes" "blocked"

/* The immediately installed delayed trigger schedules the stated action. */
/* @sem Instruction::Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:UpkeepBegins, players:All}, start:Immediately, body:Program{instructions:$clause_imperative}}} */
immediate_next_turn_upkeep_action ::= clause_imperative "at" "the" "beginning" "of" "the" "next" "turn's" "upkeep"

/* @sem Ability::[Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$unblocked_attacker_becomes_blocked}, $immediate_next_turn_upkeep_action]}}] */
line_blocked_then_next_turn_action ::= unblocked_attacker_becomes_blocked "." NEWLINE immediate_next_turn_upkeep_action "."

/* Sequential choices keep their reference identities in each phrase. */
/* @sem Instruction::[...$chosen_player_counter_placement, ...$second_player_draw, ...$third_player_tokens] */
instructions_distinct_player_sequence ::= chosen_player_counter_placement "." second_player_draw "." "then" third_player_tokens

/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Player, terms:_{count:Exactly(Constant(1)), options:[Players(All)]}}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(Named{result:@prior, index:0}))])}), kind:$counter_kind, amount:$value, selection:_{player:Named{result:@prior, index:0}, count:AsManyAsCan($counter_amount)}}]}}] */
chosen_player_counter_placement ::= "choose" "a" "player" "." "they" "put" value counter_kind "counters" "on" counter_amount filter_phrase "they" "control"

/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Player, terms:_{count:Exactly(Constant(1)), options:[Players(OthersThan(Named{result:@prior, index:0}))]}}}, Effect{result:@next, operation:Draw{players:One(Named{result:@prior, index:1}), amount:$card_count}}] */
second_player_draw ::= "choose" "a" "second" "player" "to" "draw" card_count

/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Player, terms:_{count:Exactly(Constant(1)), options:[Players(Intersection([OthersThan(Named{result:2, index:0}), OthersThan(Named{result:2, index:1})]))]}}}, Effect{result:@next, operation:CreateTokens{players:One(Named{result:@prior, index:2}), tokens:[$token_group], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
third_player_tokens ::= "choose" "a" "third" "player" "to" "create" token_group

/* One written put verb coordinates these placement contributions as a single
   simultaneous event. Separate put verbs and sequencers remain instructions;
   no operation-level canonical merge or recipient deduplication is used. */
/* Three simultaneous placements retain their independent operands. */
/* @sem Operation::PutCounters{placements:[$counter_direct_placement, $counter_direct_placement_2, $counter_direct_placement_3]} */
put_counters_three_direct ::= "put" counter_direct_placement "," counter_direct_placement "," "and" counter_direct_placement

/* The sacrifice and die table share one scope for the before and graveyard receipts. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:@sacrificed_result($sacrifice_die_creature_choice)}, ...$sacrifice_stat_roll_table]}} */
spell_each_sacrifice_stat_roll_table ::= sacrifice_die_creature_choice "." sacrifice_stat_roll_table

/* @sem Instruction::[Effect{result:@next, operation:$roll_die_action}, If{condition:AllOf([Compare{left:Add(DieResult(@die_roll), ObjectProperty{object:Query{objects:Transition{result:@marked, phase:Before}, index:0}, property:$creature_stat, information:CurrentOrLastKnown}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, Compare{left:Add(DieResult(@die_roll), ObjectProperty{object:Query{objects:Transition{result:@marked, phase:Before}, index:0}, property:$creature_stat, information:CurrentOrLastKnown}), test:NumberTest::Compare{comparison:LessOrEqual, value:$number_2}}]), then:Program{instructions:$sacrifice_graveyard_return_one}, otherwise:Program{}}, If{condition:Compare{left:Add(DieResult(@die_roll), ObjectProperty{object:Query{objects:Transition{result:@marked, phase:Before}, index:0}, property:$creature_stat, information:CurrentOrLastKnown}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number_3}}, then:Program{instructions:$sacrifice_graveyard_return_up_to}, otherwise:Program{}}] */
sacrifice_stat_roll_table ::= roll_die_action "and" "add" "the" creature_stat "of" "the" "creature" "you" "sacrificed" "this" "way" "." NEWLINE number "―" number "|" sacrifice_graveyard_return_one "." NEWLINE number "⁺" "|" sacrifice_graveyard_return_up_to "."

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:AllOf([$filter_phrase, InSet(Transition{result:@marked, phase:After})])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}] */
sacrifice_graveyard_return_one ::= "return" "a" filter_phrase "card" "put" "into" "a" "graveyard" "this" "way" "to" "the" "battlefield" "under" "your" "control"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:AllOf([$filter_phrase, InSet(Transition{result:@marked, phase:After})])}, count:UpTo($number_words)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}] */
sacrifice_graveyard_return_up_to ::= "return" "up" "to" number_words filter_phrase "cards" "put" "into" "graveyards" "this" "way" "to" "the" "battlefield" "under" "your" "control"

/* @sem Operation::Sacrifice{players:All, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$sacrifice_die_creature_filter}, choose:AsManyAsCan(Constant(1))} */
sacrifice_die_creature_choice ::= "each" "player" "sacrifices" "a" sacrifice_die_creature_filter "of" "their" "choice"

sacrifice_die_creature_filter ::= retirement_choice_creature_filter | sacrifice_die_nontoken_creature

/* @sem ObjectFilter::AllOf([Not(Token), CardType(Creature)]) */
sacrifice_die_nontoken_creature ::= "nontoken" "creature"

causing_opponent_operation ::= causing_opponent_destroy | causing_opponent_tap

/* @sem Operation::Destroy{objects:One($target_causing_opponent_controls), regeneration:true} */
causing_opponent_destroy ::= "destroy" target_causing_opponent_controls

/* @sem Operation::SetTapped{objects:One($target_causing_opponent_controls), tapped:true} */
causing_opponent_tap ::= "tap" target_causing_opponent_controls

/* Both uses of the hand count share the same target and live comparison. */
/* @sem Instruction::[If{condition:Compare{left:$hand_excess_count, test:NumberTest::Compare{comparison:$hand_excess_relation, value:CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})}}, then:Program{instructions:[Effect{result:@next, operation:Draw{players:$hand_excess_drawer, amount:Subtract([$hand_excess_count, CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})])}}]}, otherwise:Program{}}] */
clause_hand_excess_difference_draw ::= "if" hand_excess_count hand_excess_relation "," hand_excess_drawer "cards" "equal" "to" "the" "difference"

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Hand, players:One($hand_excess_target)}, kind:Card, filter:Any}) */
hand_excess_count ::= hand_excess_target

hand_excess_target ::= target_opponent | target_player

hand_excess_relation ::= hand_excess_more | hand_excess_at_least

/* @sem Comparison::Greater */
hand_excess_more ::= "has" "more" "cards" "in" "hand" "than" "you"

/* @sem Comparison::GreaterOrEqual */
hand_excess_at_least ::= "has" "at" "least" "as" "many" "cards" "in" "hand" "as" "you"

hand_excess_drawer ::= hand_excess_draw_you | hand_excess_draw_active | hand_excess_draw_each

/* @sem PlayerSet::One(AbilityController) */
hand_excess_draw_you ::= "draw"

/* @sem PlayerSet::One(Active) */
hand_excess_draw_active ::= "the" "active" "player" "draws"

/* @sem PlayerSet::All */
hand_excess_draw_each ::= "each" "player" "draws"

/* The single chosen graveyard card and the conditional both refer to the
   arrival of this face-up exile, including when the optional action is declined. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:Any}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]}}, If{condition:ObjectMatches{object:Result{result:@last_result, phase:After, index:0}, filter:$noun}, then:Program{instructions:$optional_copy_single_arrival}, otherwise:Program{}}] */
optional_graveyard_exile_filtered_followup ::= "you" "may" "exile" "a" "card" "from" "a" "graveyard" "." "if" "a" noun "card" "was" "exiled" "this" "way" "," optional_copy_single_arrival

/* This copy uses the immediately preceding single-card arrival. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($self_ref_named)), changes:[CopyOf{object:Result{result:@prior, phase:After, index:0}, exceptions:[]}], duration:$duration, evaluation:Snapshot}}]}}] */
optional_copy_single_arrival ::= "you" "may" "have" self_ref_named "become" "a" "copy" "of" "that" "card" duration

/* A planar-deck reveal and its prescribed follow-up are one keyword action. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:$planar_top_chaos_action} */
planar_reveal_top_operation ::= "reveal" planar_top_chaos_action

/* @sem KeywordAction::PlanarDeckChaosEach{amount:$planar_top_count} */
planar_top_chaos_action ::= planar_top_count "." "each" "of" "the" "revealed" "cards'" "chaos" "abilities" "triggers" "." "then" "put" "the" "revealed" "cards" "on" "the" "bottom" "of" "your" "planar" "deck" "in" "any" "order"

/* @sem $card_count */
planar_top_count ::= "the" "top" card_count "of" "your" "planar" "deck"

/* The counter condition and the exile arrival belong to this same source. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$add_mana}, If{condition:ObjectMatches{object:Source, filter:Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$value})}, then:_{instructions:[Effect{result:@next, operation:Move{objects:One(Source), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:@exile_followup(InZone{objects:One(Result{result:@prior, phase:After, index:0}), zone:Exile}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}]}, otherwise:_{}}]} */
program_mana_source_counter_blink ::= add_mana "." "if" SELF_NAME "has" value "or" "more" counter_kind "counters" "on" "it" "," "exile" "it" "," "then" "return" "it" "to" "the" "battlefield"

/* The attachment refers to the arrival of the chosen graveyard card. */
/* @sem Instruction::[...$return_chosen_graveyard_battlefield, Effect{result:@next, operation:Attach{attachments:$affected, host:Result{result:@prior, phase:After, index:0}}}] */
return_chosen_and_attach ::= return_chosen_graveyard_battlefield "and" "attach" affected "to" "it"

/* The source is the antecedent introduced by the source's own event. */
/* @sem Instruction::Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PutSticker{actor:One(AbilityController), objects:One(Source), name_only:true}}]}} */
optional_name_sticker_on_event_source ::= "you" "may" "put" "a" "name" "sticker" "on" "it"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[AddEnchantmentType(Vocabulary{family:EnchantmentType, form:Aura}), GrantAbility(Enchant{hosts:Permanents($filter_phrase)})], duration:Indefinite, evaluation:Snapshot}}] */
event_source_becomes_enchant_aura ::= "it" "becomes" "an" "Aura" "with" "enchant" filter_phrase

/* @sem Instruction::[$optional_name_sticker_on_event_source, ...$event_source_becomes_enchant_aura, ...$return_chosen_and_attach] */
optional_source_aura_return ::= optional_name_sticker_on_event_source "," "then" event_source_becomes_enchant_aura "." return_chosen_and_attach

/* @sem Ability::Triggered{event:ZoneChange{objects:$event_self, to:Battlefield}, limits:_{}, announcement:@announcement, body:_{instructions:$optional_source_aura_return}} */
triggered_optional_aura_return_attach ::= "when" event_self "enters" "," optional_source_aura_return "."

/* The event subject is moved to its owner's selected library position. */
/* @sem Cost::Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(@it), destination:Library{position:$owner_library_position, order:DestinationDefault, arrival:CardArrival{}}, qualifiers:[]}}]}}]} */
payment_event_him_library ::= "put" "him" owner_library_position "of" "his" "owner's" "library"

/* This plural wording is scoped to the payment continuation, preserving other linked-return readings. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:@zone_members(ObjectSet::$linked_exiled_cards), destination:OwnersHand(CardArrival{}), qualifiers:[]}}] */
/* @prefer always */
linked_cards_to_owners_hands_instruction ::= "return" linked_exiled_cards "to" "their" "owners'" "hands"

event_him_paid_continuation ::= linked_cards_to_owners_hands_instruction | conjoined

/* The payment result binds the conditional continuation. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$payment_event_him_library, optional:false}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$event_him_paid_continuation}, otherwise:Program{}}] */
clause_event_him_payment_if_done ::= payment_event_him_library "." "if" "you" "do" "," event_him_paid_continuation

/* Preserve all player loop forms except the directly targeted opponent, which has a direct choice. */
hand_entry_loop_players ::= players_each_last_chose | players_coin_tails | players_empty_hand | hand_entry_unqualified | players_voted_same | players_voted_different | players_chosen_extreme_life | players_tapped_for_mana_this_turn | players_controlling_filter | players_event_controller_opponents | players_event_player_opponents | players_controlling_an | players_your_teammates | players_most_controlled | players_enchanted_opponent | players_qualified | hand_entry_unqualified | players_with_counter_threshold | players_dealt_combat_game

hand_entry_unqualified ::= players_fewest_permanents | mined_players | hand_entry_one | players_each_opponent | players_each | players_or_controller | players_each_other | players_each_other_opponent

/* @sem PlayerSet::One($hand_entry_player_ref) */
hand_entry_one ::= hand_entry_player_ref

hand_entry_player_ref ::= optional_target_player | active_player_ref | mined_player | target_player | that_player | defending_player | its_controller | its_owner | target_player_dealt | stack_controller | history_damage_controller | explicit_object_controller | explicit_object_owner | attacking_player | damage_source_controller | extreme_life_player | extreme_hand_player | that_attacking_player | that_attacking_event_player | target_player_lost_life | event_card_owner | source_named_controller | event_subject_card_owner | target_player_other_than_source_owner

/* The targeted opponent owns the choice, hand, and entering permanent. */
/* @sem Instruction::[Optional{decider:$target_opponent, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Target{slot:@last_slot, index:0}, objects:Zone{scope:Players{zone:Hand, players:One(Target{slot:@last_slot, index:0})}, kind:Card, filter:$a_card}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(Target{slot:@last_slot, index:0}), arrival:BattlefieldArrival{}}, qualifiers:[]}}]}}] */
clause_target_opponent_hand_entry ::= target_opponent "may" "put" a_card "from" "their" "hand" "onto" "the" "battlefield"

reduction_hand_population ::= hand_cards_population | filtered_reduction_hand_population

/* @sem ObjectSet::Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}) */
filtered_reduction_hand_population ::= filter_phrase "cards" "in" "your" "hand"

/* Conversion's completion controls the subsequent program. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$convert_referred_it}]}}]}, optional:false}}, If{condition:PaymentChosen(@marked), then:$program, otherwise:Program{}}]} */
mandatory_convert_followup ::= convert_referred_it "." "if" "you" "do" "," program

/* A random highest-mana-value card choice retains both independently stated filters. */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase_2}, property:ManaValue, aggregation:Maximum}}}])}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]} */
random_greatest_hand_card ::= "a" "random" filter_phrase "card" "with" "the" "greatest" "mana" "value" "among" filter_phrase "cards" "in" "your" "hand"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$random_greatest_hand_card}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$chosen_card_reduction}}]} */
random_greatest_hand_perpetual ::= random_greatest_hand_card "perpetually" chosen_card_reduction

/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$random_greatest_hand_perpetual} */
triggered_random_greatest_hand_perpetual ::= "at" turn_event "," random_greatest_hand_perpetual

/* The subject of the enclosing cast event is the copied spell. */
/* @sem Operation::CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(2), targets:May} */
copy_cast_subject_with_targets ::= "copy" "it" "twice" "." "you" "may" "choose" "new" "targets" "for" "the" "copies"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$copy_cast_subject_with_targets}]} */
program_copy_cast_subject_with_targets ::= copy_cast_subject_with_targets "."

/* @sem Ability::Triggered{event:$event_cast_colored_instant_or_sorcery, limits:TriggerLimits{}, announcement:@announcement, body:$program_copy_cast_subject_with_targets} */
triggered_colored_cast_copy ::= "whenever" event_cast_colored_instant_or_sorcery "," program_copy_cast_subject_with_targets
