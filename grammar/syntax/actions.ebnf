choice_named_nonbasic_land ::= "nonbasic" "land" "type"

/* @sem ValueKind::PermanentType */
choice_named_permanent ::= "permanent" "type"

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:CardType, terms:_{count:Exactly(Constant(1)), options:[$choice_triple_card_type, $choice_triple_card_type_2, $choice_triple_card_type_3]}} */
choose_card_types_three ::= "choose" choice_triple_card_type "," choice_triple_card_type "," "or" choice_triple_card_type

choice_triple_card_type ::= choice_card_type_artifact | choice_card_type_creature | choice_card_type_land | choice_card_type_enchantment | choice_card_type_instant | choice_card_type_sorcery | choice_card_type_planeswalker | choice_card_type_battle

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Player, terms:_{options:[Players($choice_life_candidates)], secret:true, count:Exactly(Constant(1))}} */
choose_secret_player ::= "secretly" "choose" choice_life_candidates

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:CreatureType, terms:_{options:[$choice_creature_type, $choice_creature_type_2, $choice_creature_type_3], secret:true, count:Exactly(Constant(1))}} */
choose_secret_creature_types_three ::= "secretly" "choose" choice_creature_type "," choice_creature_type "," "or" choice_creature_type

choice_creature_type ::= choice_creature_type_plain | choice_creature_type_marked_merfolk

/* @sem Operand::Vocabulary{family:CreatureType, form:@subtype_name($creature_subtype)} */
choice_creature_type_plain ::= creature_subtype

/* @sem Operand::Vocabulary{family:CreatureType, form:Merfolk} */
choice_creature_type_marked_merfolk ::= "↑" "merfolk"

/* Mana operands preserve the population, each produced color, and current amount. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:ColorsAmong{objects:$mana_color_population, each:true}} */
add_each_color_population ::= mana_color_population "," "add" "one" "mana" "of" "that" "color"

/* @sem $affected */
mana_color_population ::= "for" "each" "color" "among" affected

/* The event subject supplies the controller; the production is independently reusable. */
add_event_controller_mana ::= add_event_controller_mana_additional | add_event_controller_mana_plain

event_controller_mana ::= event_controller_mana_chosen | event_controller_mana_equal | shared_combination_mana

/* @sem ManaProduction::Amount{color:Chosen, amount:$value} */
event_controller_mana_chosen ::= value "mana" "of" "the" "chosen" "color"

/* @sem ManaProduction::Repeat{amount:$mana_equal_value, production:$mana_production, choice:Once} */
event_controller_mana_equal ::= "amount" "of" mana_production "equal" "to" mana_equal_value

/* The where-clause defines the common amount for two productions. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:$mana_spell_intensity, production:All([$mana_production, $mana_production_2]), choice:Once}} */
add_mana_pair_defined ::= "add" "X" mana_production "and" "X" mana_production "," "where" "X" "is" mana_spell_intensity

/* Spell and Aura spellings denote the intensity of the current source. */
/* @sem Expr::ObjectProperty{object:Source, property:Intensity, information:CurrentOrLastKnown} */
mana_spell_intensity ::= "this" "spell's" "intensity"

/* @sem Expr::ObjectProperty{object:Source, property:Intensity, information:CurrentOrLastKnown} */
mana_aura_intensity ::= "this" "Aura's" "intensity"

mana_equal_value ::= value | mana_aura_intensity

/* The draw, reveal and both uses of the revealed card's mana value share
   the draw receipt; the enclosing trigger fixes the creature event subject. */
/* @sem Instruction::[Effect{result:@mark, operation:Draw{players:One(AbilityController), amount:Constant(1)}}, Effect{result:@next, operation:Reveal{objects:Transition{result:@marked, phase:After}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(EventSubject)), changes:[Pump{power:ObjectProperty{object:Query{objects:Transition{result:@marked, phase:After}, index:0}, property:$receipt_stat, information:CurrentOrLastKnown}, toughness:ObjectProperty{object:Query{objects:Transition{result:@marked, phase:After}, index:0}, property:$receipt_stat, information:CurrentOrLastKnown}}], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:ObjectProperty{object:Query{objects:Transition{result:@marked, phase:After}, index:0}, property:$receipt_stat, information:CurrentOrLastKnown}}}] */
drawn_card_value_pump_life ::= "draw" "a" "card" "and" "reveal" "it" "." "the" "creature" "gets" "+X/+X" duration "and" "you" "lose" "X" "life" "," "where" "X" "is" "that" "card's" receipt_stat

/* @sem Ability::Triggered{event:Object{event:Attacks, objects:SameObject(AttachedTo(Source))}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$drawn_card_value_pump_life}} */
attached_attack_draw_value_rewards ::= "whenever" "equipped" "creature" "attacks" "," drawn_card_value_pump_life "."

/* The reveal and both rewards share the observed top-card receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:LibraryTops(All)}}, Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:Repeat{amount:CountObjects(Matching{objects:Observed(@marked), filter:Not(CardType(Land))}), production:$mana_unit, choice:Once}}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:CountObjects(Matching{objects:Observed(@marked), filter:Not(CardType(Land))})}}, Effect{result:@next, operation:Draw{players:All, amount:Constant(1)}}] */
instructions_parley_mana_life ::= parley_reveal "add" mana_unit "and" "you" "gain" "1" "life" parley_draw

/* A single drawn card is the producer for the reveal and property query. */
/* @sem Instruction::[Effect{result:@mark, operation:Draw{players:One(AbilityController), amount:Constant(1)}}, Effect{result:@next, operation:Reveal{objects:Transition{result:@marked, phase:After}}}, Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:Count(Exactly(ObjectProperty{object:Query{objects:Transition{result:@marked, phase:After}, index:0}, property:ManaValue, information:CurrentOrLastKnown}))}]}}] */
instructions_draw_reveal_remove_value ::= "draw" "a" "card" "and" "reveal" "it" "." "remove" "a" "number" "of" counter_kind "counters" "equal" "to" "that" "card's" "mana" "value" "from" affected

/* The death-event card and the exact conjured arrival remain paired through
   both the perpetual change and the subsequent graveyard move. */
/* @sem Instruction::[Effect{result:@next, operation:$conjure_named_death_graveyard}, Effect{result:@next, operation:EffectOn{subject:Objects(AnyZone(AnyOf([SameObject(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), SameObject(Result{result:@prior, phase:After, index:0})]))), effects:[Term{family:PerpetualEffect, form:DoubleCreaturesPowerAndToughness}]}}, Effect{result:@next, operation:Move{objects:Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:AnyOf([SameObject(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), SameObject(Result{result:@back(3), phase:After, index:0})])}), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
instructions_conjure_death_pair ::= conjure_named_death_graveyard "." "perpetually" "double" "the" "power" "and" "toughness" "of" "this" "card" "and" "that" "card" "," "then" "shuffle" "them" "into" "their" "owner's" "library"

/* @sem Operation::Conjure{actor:One(AbilityController), card:Named($referenced_card_name), count:Constant(1), destination:Graveyard(CardArrival{counters:[], states:[]})} */
conjure_named_death_graveyard ::= "conjure" "a" "card" "named" referenced_card_name "into" "your" "graveyard"

/* The count is tied to this exact battlefield-to-exile producer, and both
   mentions describe the same population. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($filter_plural, $filter_plural_2)}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Incubate{amount:CountObjects(Transition{result:@marked, phase:Before})}}}] */
instructions_exile_incubate_count ::= "exile" "all" filter_plural "." "incubate" "X" "," "where" "X" "is" "the" "number" "of" filter_plural "exiled" "this" "way"

/* The maximum recipients equals the three counters being distributed. */
/* @sem Operation::DistributeCounters{amount:$distribution_one_two_three, kind:$counter_kind, objects:$affected, any_number:false} */
distribute_three_counters_among_population ::= "distribute" "three" counter_kind "counters" "among" distribution_one_two_three affected

/* The permanent and its controller remain the same in the counted action. */
/* @sem Operation::Keyword{actor:One(ControllerOf($object_ref)), action:KeywordAction::Connive{object:$object_ref, amount:$keyword_defined_x}} */
connive_object_defined ::= object_ref "connives" keyword_defined_x

/* The options are object populations; the event player makes the choice. */
/* @sem Operation::ChooseValue{choosers:One(EventSubject), kind:Filter, terms:_{count:Exactly(Constant(1)), options:[Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}), Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase_2}), Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase_3}), Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase_4})]}} */
event_player_filter_choice ::= "that" "player" "chooses" filter_phrase "," filter_phrase "," filter_phrase "," "or" filter_phrase

/* Each choice belongs to its bound player and produces the selection receipt. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, starting_with:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:ControlledBy(One(Bound(0)))}, count:UpTo($number)}}]}}] */
clause_each_player_choose_controlled ::= "starting" "with" "you" "," "each" "player" "chooses" "up" "to" number "permanents" "they" "control"

/* A chooser selects a pile belonging to each player in the named set. */
/* @sem Operation::ChoosePile{actor:$pile_selecting_player, from:$pile_owner_set} */
choose_each_players_pile ::= pile_owner_set pile_selecting_player "choose" "one" "of" "their" "piles"

/* @sem $players_singular */
pile_owner_set ::= "for" players_singular ","

/* @sem PlayerSet::One(AbilityController) */
pile_selecting_player ::= "you"

/* Choosing a permanent and exiling the selected objects is one instruction group. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan($counter_amount)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}] */
instructions_choose_permanent_exile ::= "exile" counter_amount filter_phrase

/* The delayed return consumes the actual exile arrival of the event subject. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Move{objects:One(EventSubject), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$event_clause, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{}}, qualifiers:[]}}]}}}]} */
program_exile_subject_delayed_return ::= "exile" "that" "creature" "." "return" "that" "card" "to" "the" "battlefield" "under" "its" "owner's" "control" event_clause "."

/* The selected target determines the delayed event; the returned card is the exile arrival. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Move{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Object{event:LeavesBattlefield, objects:SameObject($delayed_chosen_creature)}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{}}, qualifiers:[]}}]}}}]} */
program_exile_dead_choose_delayed_return ::= "exile" "it" "and" "choose" delayed_chosen_creature "." "when" "that" "creature" "leaves" "the" "battlefield" "," "return" "this" "card" "from" "exile" "to" "the" "battlefield" "under" "its" "owner's" "control" "."

/* Both payment components belong to one optional payment; only its exiled card returns. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Move{selections:[_{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0})}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}}, PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:CollectEvidence{amount:$value}}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One(Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0}), zone:Exile}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true}}, qualifiers:[]}}]}, otherwise:Program{}}]} */
program_exile_dead_evidence_return ::= "you" "may" "exile" "it" "and" "collect" "evidence" value "." "if" "you" "do" "," "return" "this" "card" "to" "the" "battlefield" "tapped" "."

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(OpponentsOf(AbilityController))])}), index:0} */
delayed_chosen_creature ::= "target" "creature" "an" "opponent" "controls"

/* The payment and ownership exchange refer to the two arrivals of this
   exact exile instruction; keep the producer and its consumers in one scope. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Union([One(Source), One($owned_opponent_target)]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:PayCost{player:OwnerOf($owned_opponent_target), cost:_{parts:[Life($number)]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:_{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One(Source), zone:Exile}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:_{instructions:[Effect{result:@next, operation:Exchange(_{kind:Ownership, first:Object(Result{result:@back(4), phase:After, index:0}), second:Object(Result{result:@back(4), phase:After, index:1})})}]}}] */
instructions_exile_pair_ownership_payment ::= "exile" "this" "artifact" "and" owned_opponent_target "." "that" "player" "may" "pay" number "life" "." "if" "they" "do" "," "put" "this" "card" "into" "its" "owner's" "graveyard" "." "otherwise" "," "that" "player" "owns" "this" "card" "and" "you" "own" "the" "other" "exiled" "card"

/* The test and its consequence consume this particular discard receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Discard{players:One($discard_receipt_target), amount:$discard_receipt_count, random:false}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@last_result, phase:Before}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:$then_condition_program, otherwise:Program{}}] */
instructions_discard_filtered_receipt ::= discard_receipt_target "discards" discard_receipt_count "." "if" "a" filter_phrase "card" "is" "discarded" "this" "way" "," then_condition_program

discard_receipt_target ::= target_player | target_opponent

discard_receipt_count ::= card_count_one | card_count_many

/* A conditional replacement keeps the original target and the exile arrival together. */
/* @sem Instruction::[If{condition:ObjectMatches{object:$target_object, filter:$return_exile_keyword}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:One($target_object), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:@exile_followup(InZone{objects:One(Result{result:@prior, phase:After, index:0}), zone:Exile}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Move{objects:One($target_object), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
instructions_return_keyword_exile ::= "return" target_object "to" "its" "owner's" "hand" "." "if" "it" "has" return_exile_keyword "," "instead" "exile" "it" "," "then" "return" "that" "card" "to" "its" "owner's" "hand"

return_exile_keyword ::= return_exile_unearth | condition_keyword_family

/* @sem ObjectFilter::HasKeywordFamily(Unearth) */
return_exile_unearth ::= "unearth"

/* Return the card produced by a graveyard event, while it remains there. */
/* @sem Operation::Move{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_event_card_your_hand ::= "return" "that" "card" "to" "your" "hand"

/* The targeted opponent may choose to have this source deal damage to them. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:$target_opponent, cost:Cost{parts:[PlayerAction{player:Target{slot:@last_slot, index:0}, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(One(Target{slot:@last_slot, index:0})), amount:$number, preventable:true}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:$return_event_card_your_hand}]}, otherwise:Program{}}]} */
program_unless_opponent_source_damage ::= return_event_card_your_hand "unless" target_opponent "has" "this" "enchantment" "deal" number "damage" "to" "them"

/* The graveyard event proves that the card is owned by the ability controller. */
/* @sem Ability::Triggered{event:$event_put_your_graveyard, limits:TriggerLimits{}, announcement:@announcement, body:$program_unless_opponent_source_damage} */
trigger_owned_graveyard_unless_damage ::= "whenever" event_put_your_graveyard "," program_unless_opponent_source_damage "."

/* The delayed unattachment consumes the very attachment selected by this payment. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:AttachChosen{actor:One(AbilityController), attachments:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$subtype, ControlledBy(One(AbilityController))])}, count:Exactly(Constant(1)), hosts:One($that_noun)}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:_{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Unattach{object:Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Inputs, phase:Before}, index:0}}}}]}}}]}, otherwise:_{}}] */
instructions_optional_attach_delayed_unattach ::= "you" "may" "attach" "an" subtype "you" "control" "to" that_noun "." "if" "you" "do" "," "unattach" "it" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* The resolution-count callback announces its own targets, independently of
   the enclosing ability and the preceding instructions. */
/* @sem Instruction::[If{condition:Compare{left:TimesResolvedThisTurn, test:Compare{comparison:Equal, value:$resolution_ordinal}}, then:@reflexive(Program::Program{instructions:[Effect{result:@next, operation:ReflexiveTrigger{announcement:@announcement, body:Program{instructions:$conjoined}}}]}), otherwise:Program{}}] */
resolution_count_callback ::= "when" "this" "ability" "resolves" "for" "the" resolution_ordinal "time" "this" "turn" "," conjoined

/* Scope the exile producer and its delayed return together, across an intervening copy effect. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One($target_permanent), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:$controlled_subtypes_copy_target_until_end}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:@exile_followup(InZone{objects:One(Result{result:@back(4), phase:After, index:0}), zone:Exile}), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}}]} */
program_exile_copy_return ::= "exile" target_permanent "." controlled_subtypes_copy_target_until_end "." "return" "it" "to" "the" "battlefield" "under" "its" "owner's" "control" "at" "the" "beginning" "of" "the" "next" "end" "step" "."

/* A death's destination remains the object returned by the delayed action. */
/* @sem Operation::CreateDelayedTrigger{event:$delayed_move_end_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[$death_return_counters], states:[Changes($death_return_characteristics)]}}, qualifiers:[]}}]}} */
delayed_death_return_modified ::= "return" "it" "to" "the" "battlefield" "under" "your" "control" death_return_counters "at" delayed_move_end_event "." death_return_characteristics

death_return_counters ::= death_return_counter_one | death_return_counter_many

/* @sem (CounterKind, Expr)::[$counter_kind, Constant(1)] */
death_return_counter_one ::= "with" "an" "additional" counter_kind "counter" "on" "it"

/* @sem (CounterKind, Expr)::[$counter_kind, @plural_amount($number_words)] */
death_return_counter_many ::= "with" number_words "additional" counter_kind "counters" "on" "it"

/* @sem Change::[Colors{mode:Add, colors:[$mana_color_word]}, CreatureTypes{mode:Add, types:Listed($becomes_types)}] */
death_return_characteristics ::= "that" "creature" "is" "a" mana_color_word becomes_types "in" "addition" "to" "its" "other" "colors" "and" "types"

/* @sem Ability::Triggered{event:$death_return_creature_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$delayed_death_return_modified}]}} */
triggered_delayed_death_return ::= "whenever" death_return_creature_event "," delayed_death_return_modified "."

/* The anaphor in the entry characteristic requires a creature antecedent. */
death_return_creature_event ::= death_return_qualified_creature_event | death_return_plain_creature_event

/* @sem EventSpec::ZoneChange{objects:@and($noun_creature, $modifier_nonnumeric), from:Battlefield, to:Graveyard} */
death_return_qualified_creature_event ::= "a" noun_creature modifier_nonnumeric "dies"

/* @sem EventSpec::ZoneChange{objects:$noun_creature, from:Battlefield, to:Graveyard} */
death_return_plain_creature_event ::= "a" noun_creature "dies"

/* The tie explanation must name the same population and characteristic as
   the selected extreme. Indestructibility is excluded after the minimum. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($least_stat_battlefield, ObjectFilter::AllOf([$plural_head, Property{property:$stat, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$plural_head}, property:$stat, aggregation:Minimum}}}]))}, filter:Not(HasKeyword(Indestructible))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Destroy{objects:Selected(@prior), regeneration:false}}] */
destroy_least_stat_tied ::= "destroy" least_stat_battlefield "." "it" "can't" "be" "regenerated" "." "if" "two" "or" "more" plural_head "are" "tied" "for" "least" stat "," "you" "choose" "one" "of" "them"

/* The perpetual grant refers only to the immediately conjured library arrivals. */
/* @sem Instruction::[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Named($referenced_card_name), count:$number, destination:Library{position:Random, arrival:CardArrival{counters:[], states:[]}}}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@prior, phase:After})}), changes:[GrantAbility($mechanic_bare)]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_conjure_library_perpetual_mechanic ::= "conjure" number "cards" "named" referenced_card_name "into" "your" "library" "." "they" "perpetually" "gain" mechanic_bare "." "then" "shuffle"

/* The turn's player chooses whether to add or remove the same counter kind. */
/* @sem Instruction::Optional{decider:EventSubject, body:Program{instructions:[ChooseOne{decider:EventSubject, options:[Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($self_explicit_ref)), kind:Named(DoomCounter), amount:Constant(1)}]}}]}, Program{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:EventSubject, recipients:Objects(One($self_explicit_ref)), kind:Named(DoomCounter), amount:Count(Exactly(Constant(1)))}]}}]}]}]}} */
event_player_optional_counter_choice ::= "that" "player" "may" "put" "a" "doom" "counter" "on" self_explicit_ref "or" "remove" "a" "doom" "counter" "from" "it"

/* The threshold and sacrifice refer to the same source; the callback is scoped
   to the performed sacrifice and has its own announcement. */
/* @sem Instruction::If{condition:ObjectMatches{object:Source, filter:Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$number})}, then:Program{instructions:[...$source_sacrifice_reflexive]}, otherwise:Program{}} */
source_counter_threshold_sacrifice ::= "then" "if" "it" "has" number "or" "more" counter_kind "counters" "on" "it" "," source_sacrifice_reflexive

/* @sem Instruction::[Effect{result:@mark, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:One($self_explicit_ref)})}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$source_reflexive_damage_program})}] */
source_sacrifice_reflexive ::= "sacrifice" self_explicit_ref "." "when" "you" "do" "," source_reflexive_damage_program

/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$noun}), amount:$number, preventable:true}}]} */
source_reflexive_damage_program ::= "it" "deals" number "damage" "to" "each" noun

/* @sem Program::Program{instructions:[$event_player_optional_counter_choice, $source_counter_threshold_sacrifice]} */
program_event_counter_choice_threshold ::= event_player_optional_counter_choice "." source_counter_threshold_sacrifice

/* Each player chooses from their own battlefield population. */
/* @prefer always */
/* @sem Operation::ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))])}, count:AsManyAsCan(Constant(1))} */
bound_choose_controlled_one ::= "chooses" "a" filter_phrase "they" "control"

/* The remainder is the unselected portion of the preceding choice. */
/* @sem ObjectSet::Unselected(@prior) */
choice_unselected_remainder ::= "the" "rest"

/* Choices precede a single sacrifice by the same player population. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:$bound_choose_controlled}]}}, Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:$players_singular, objects:$choice_unselected_remainder})}] */
instructions_players_choose_sacrifice_remainder ::= players_singular bound_choose_controlled "," "then" "sacrifices" choice_unselected_remainder

/* The casting-time subtype condition changes the maximum announced mode count. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Conditional{condition:Controls{player:AbilityController, filter:$subtype, minimum:1}, then:$number_words, otherwise:Constant(1)}}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_cast_controlled_subtype ::= "choose" "one" "." "if" "you" "control" "a" subtype "as" "you" "cast" "this" "spell" "," "you" "may" "choose" number_words "instead" "." NEWLINE modes

/* A controlled counter-bearing population and its matching anaphor. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($noun, $plural), ControlledBy(One(AbilityController)), Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})])} */
controlled_counter_population_anaphor ::= noun "you" "control" "with" "a" counter_kind "counter" "on" "it" "." "those" plural

/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountObjects($controlled_counter_population_anaphor)}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($controlled_counter_population_anaphor), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}] */
instructions_count_controlled_counter_grant ::= "draw" "a" "card" "for" "each" controlled_counter_population_anaphor "gain" keyword_name duration

/* The grant and delayed sacrifice refer to the same paid arrival. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:_{parts:[$hand_total_stats_entry]}, optional:true}}, If{condition:PaymentChosen(@marked), then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0})), changes:$static_changes, duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:One(Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0})})}]}}}]}, otherwise:_{}}] */
instructions_paid_hand_entry_changes_sacrifice ::= "you" "may" hand_total_stats_entry "." "that" "creature" static_changes "." "at" "the" "beginning" "of" "the" "next" "end" "step" "," "sacrifice" "that" "creature"

/* A random hand observation and both branches share the same card and player. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:RevealFromHand{actor:One(EventSubject), cards:Any, count:Constant(1), at_random:true}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@last_result), filter:$noun}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Query{objects:Observed(@prior), index:0}), destination:Battlefield{controller:Player(EventSubject), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(EventSubject), action:CastSpell, cards:Recorded(@back(3)), count:Exactly(Constant(1)), terms:_{cost:Free}}}]}}]} */
program_sentence_random_hand_type_branch ::= "that" "player" "reveals" "a" "card" "at" "random" "from" "their" "hand" "." "if" "it's" "a" noun "card" "," "the" "player" "puts" "it" "onto" "the" "battlefield" "." "otherwise" "," "the" "player" "casts" "it" "without" "paying" "its" "mana" "cost" "if" "able" "."

/* A counter placement and a separately qualified land-type effect share the target. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$upkeep_nonbasic_filter, CardType(Land), ControlledBy(One(EventSubject))]), chooser:EventSubject}), index:0})), kind:$counter_kind, amount:Constant(1)}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@last_slot, index:0})), changes:[SetLandType(Vocabulary{family:LandType, form:@subtype_name($basic_land_type_named)})], duration:WhileMatches{object:Target{slot:@last_slot, index:0}, filter:Counters(_{kind:$counter_kind_2, comparison:Greater, value:Constant(0)})}, evaluation:Snapshot}}]} */
upkeep_counter_land_body ::= "that" "player" "puts" "a" counter_kind "counter" "on" "target" upkeep_nonbasic_filter "land" "they" "control" "of" "their" "choice" "." "that" "land" "is" basic_land_type_named "for" "as" "long" "as" "it" "has" "a" counter_kind "counter" "on" "it" "."

upkeep_nonbasic_filter ::= st_island_non | st_plains_non | st_swamp_non | st_mountain_non | st_forest_non

/* Counting all permanents is shared by both parity tests; these branches only
   install continuous effects and triggers, so neither changes that count. */
/* @sem Instruction::If{condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:Any}), test:NumberTest::Compare{comparison:SameParity, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:$parity_population_pump}, Effect{result:@next, operation:$parity_mana_trigger}]}, otherwise:Program{}} */
parity_odd_pump_mana ::= "if" "the" "number" "is" "odd" "," "until" "end" "of" "turn" "," parity_population_pump "and" parity_mana_trigger "."

/* @sem Instruction::If{condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:Any}), test:NumberTest::Compare{comparison:SameParity, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:$parity_population_pump}, Effect{result:@next, operation:$parity_mountain_replacement}]}, otherwise:Program{}} */
parity_even_pump_mana ::= "if" "the" "number" "is" "even" "," "until" "end" "of" "turn" "," parity_population_pump "and" parity_mountain_replacement "."

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}), changes:[Pump{power:$signed, toughness:$signed_2}], duration:EndOfTurn, evaluation:Snapshot} */
parity_population_pump ::= filter_plural "get" signed "/" signed

/* @sem Operation::CreateTrigger{event:Player{event:TapsForMana, players:All, objects:$subtype}, duration:EndOfTurn, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:AddMana{players:One(EventSubject), mana:Amount{color:$mana_color, amount:Constant(1)}}}]}} */
parity_mana_trigger ::= "whenever" "a" "player" "taps" "a" subtype "for" "mana" "," "that" "player" "adds" "an" "additional" mana_color

/* The repeated noun in this wording is deliberately fixed until a shared
   typed co-reference guard can validate both mentions for parsing and print. */
/* @sem Operation::GameEffect{until:EndOfTurn, effect:Term{family:GameEffect, form:PermanentsTappedByPlayerForManaProduceColorlessInstead, operands:[Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:Subtype(Mountain)}), Players(All)]}} */
parity_mountain_replacement ::= "if" "a" "player" "taps" "a" "Mountain" "for" "mana" "," "that" "Mountain" "produces" "colorless" "mana" "instead" "of" "any" "other" "type"

/* The random choice and the exile establish the card used by both the
   permission and its cast callback. The marked result cannot come from a
   different producer or destination. */
/* @sem Instruction::[Effect{result:@next, operation:$random_library_player_choice}, ...$random_chosen_top_exile, ...$exile_owner_cast_permission] */
instructions_random_library_exile_owner_permission ::= random_library_player_choice "." random_chosen_top_exile "." exile_owner_cast_permission

/* @sem Operation::ChooseAtRandom{kind:Player, options:[$random_library_population]} */
random_library_player_choice ::= "choose" random_library_population "at" "random"

/* @sem Operand::Players(OpponentsOf(AbilityController)) */
random_library_opponent ::= "an" "opponent"

random_library_population ::= random_library_opponent | random_player_population

/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Chosen)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
random_chosen_top_exile ::= "exile" "the" "top" "card" "of" "that" "player's" "library"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:Either, filter:Any}, terms:_{cost:Normal, spend_as:AnyColor, effects:[Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(OwnerOf(Result{result:@marked, phase:After, index:0})), amount:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}]}]}})], duration:$duration, evaluation:LiveObjects}}] */
exile_owner_cast_permission ::= duration "," "you" "may" "play" "that" "card" "and" "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "it" "." "when" "you" "cast" "a" "spell" "this" "way" "," "its" "owner" "loses" "life" "equal" "to" "its" "mana" "value"

/* The stack-object controller and affected population remain independent. */
/* @sem Operation::GameEffect{until:$this_turn, effect:Term{family:GameEffect, form:SpellsAndAbilitiesCantTargetPermanents, operands:[$controlled_spells_and_abilities, Objects($affected_plural)]}} */
temporary_permanents_target_ban ::= affected_plural "can't" "be" "the" "targets" "of" controlled_spells_and_abilities this_turn

/* @sem Operand::Term{family:SpellsAndAbilities, form:ControlledByAPlayer, operands:[Players($targeting_stack_controller)]} */
controlled_spells_and_abilities ::= "spells" "or" "abilities" targeting_stack_controller

targeting_stack_controller ::= targeting_opponents_control | targeting_you_control

/* @sem PlayerSet::OpponentsOf(AbilityController) */
targeting_opponents_control ::= "your" "opponents" "control"

/* @sem PlayerSet::One(AbilityController) */
targeting_you_control ::= "you" "control"

/* The restriction is scoped to the extra turn created by the preceding action. */
/* @sem Operand::Term{family:GameEffect, form:SchemesCantBeSetInMotion} */
extra_turn_scheme_restriction ::= "schemes" "can't" "be" "set" "in" "motion"

extra_turn_producer ::= take_extra_turn | take_extra_turn_after_this

/* @sem Instruction::[Effect{result:@next, operation:$extra_turn_producer}, Effect{result:@next, operation:GameEffect{until:ExtraTurn(0), effect:$extra_turn_scheme_restriction}}] */
extra_turn_restricted_instructions ::= extra_turn_producer "." extra_turn_scheme_restriction "that" "turn"

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$extra_turn_restricted_instructions}} */
triggered_extra_turn_restriction ::= event_clause "," extra_turn_restricted_instructions "."

/* The perpetual change follows the actual returned object. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$delayed_graveyard_self_untapped}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$static_changes}}]} */
graveyard_return_perpetual_program ::= delayed_graveyard_self_untapped "." "it" "perpetually" static_changes

/* Exile a creature with an attached subtype, then retain its counters. The
   note refers to the announced creature, not the attached population. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Union([One($noted_exile_creature), Zone(_{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$subtype_plural, AttachedTo(SameObject($noted_exile_creature))])})]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Note(CountersOn($noted_exile_creature))}] */
exile_creature_attached_note ::= "exile" noted_exile_creature "and" "all" subtype_plural "attached" "to" "it" "." "note" "the" "number" "and" "kind" "of" "counters" "that" "were" "on" "that" "creature"

noted_exile_creature ::= noted_exile_creature_bare | target_qualified_creature

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0} */
noted_exile_creature_bare ::= "target" "creature"

/* This producer and delayed consumer share the original exile receipt; the
   reattachment refers to the returned permanent, not the pre-exile target. */
/* @sem Instruction::[...$exile_creature_attached_note, Effect{result:@next, operation:CreateDelayedTrigger{event:$event, start:Immediately, body:_{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}, destination:Battlefield{controller:Owner, arrival:_{tapped:true, states:[NotedCounters]}}}}]}}]}}}, If{condition:PaymentChosen(@prior), then:_{instructions:[Effect{result:@next, operation:Move{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:InSet(Recorded(@marked))}), destination:Battlefield{controller:Owner, arrival:_{states:[AttachedTo(Result{result:@prior, phase:After, index:0})]}}}}]}, otherwise:_{}}]}}}] */
exile_noted_creature_delayed_return ::= exile_creature_attached_note "." "when" event "," "return" "that" "exiled" "card" "to" "the" "battlefield" "under" "its" "owner's" "control" "tapped" "with" "the" "noted" "number" "and" "kind" "of" "counters" "on" "it" "." "if" "you" "do" "," "return" "the" "other" "exiled" "cards" "to" "the" "battlefield" "under" "their" "owner's" "control" "attached" "to" "that" "permanent"

/* The antecedent is the source creature from the preceding bonus. */
/* @sem Operation::CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(ControllerOf(Source)), objects:One(Source)})}]}} */
self_controller_sacrifice_next_end ::= "its" "controller" "sacrifices" "it" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$self_indefinite_bonus}, Effect{result:@next, operation:$self_controller_sacrifice_next_end}]} */
program_self_bonus_controller_sacrifice ::= self_indefinite_bonus "." self_controller_sacrifice_next_end "."

/* The pronoun names the arrivals of this graveyard-to-battlefield move. */
/* @sem Instruction::[Effect{result:@next, operation:$put_graveyard_population_battlefield}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Transition{result:@prior, phase:After}), changes:[Colors{mode:Add, colors:[$mana_color_word]}, CreatureTypes{mode:Add, types:Listed([@subtype_name($subtype_plural)])}], duration:Indefinite, evaluation:Snapshot}}] */
instructions_graveyard_arrivals_colored_type ::= put_graveyard_population_battlefield "." "they're" mana_color_word subtype_plural "in" "addition" "to" "their" "other" "colors" "and" "types"

/* A paid hand arrival and its named subject must agree. */
/* @sem Cost::Cost{parts:[Move{selections:[_{objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:@agree($filter_phrase, $filter_head)}), choose:Exactly($counter_a)}], destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
paid_hand_entry_selection ::= "put" counter_a filter_phrase "card" "from" "your" "hand" "onto" "the" "battlefield" "." "that" filter_head

/* Each anaphor proves the kind of the paid arrival. */
/* @sem Cost::Cost{parts:[Move{selections:[_{objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:CardType(Artifact)}), choose:Exactly(Constant(1))}], destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
paid_hand_entry_it_artifact ::= "it"

/* @sem Cost::Cost{parts:[Move{selections:[_{objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:CardType(Creature)}), choose:Exactly(Constant(1))}], destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
paid_hand_entry_it_creature ::= "it"

/* @sem Cost::Cost{parts:[Move{selections:[_{objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:CardType(Creature)}), choose:Exactly(Constant(1))}], destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
paid_hand_entry_that_creature ::= "that" "creature"

paid_hand_entry_sacrifice_ref ::= paid_hand_entry_it_artifact | paid_hand_entry_it_creature | paid_hand_entry_that_creature

/* The continuous effect and delayed action refer to this payment's arrival. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:@agree($paid_hand_entry_selection, $paid_hand_entry_sacrifice_ref), optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0})), changes:$static_changes, duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:One(Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0})})}]}}}]}, otherwise:Program{}}] */
paid_hand_entry_temporary ::= "you" "may" paid_hand_entry_selection static_changes "." "sacrifice" paid_hand_entry_sacrifice_ref "at" "the" "beginning" "of" "the" "next" "end" "step"

/* The counted receipt is produced by this tap action, and the repeated noun
   describes the same population. Keep both instructions under one contract. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(Tapped), @agree($subtype_plural, $subtype_plural_2), ControlledBy(One(EventSubject))])}, tapped:true}}, Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Players(One(EventSubject)), amount:CountObjects(Transition{result:@prior, phase:Before}), preventable:true}}] */
tap_event_player_subtypes_count_damage ::= "tap" "all" "untapped" subtype_plural "that" "player" "controls" "and" self_explicit_ref "deals" "X" "damage" "to" "the" "player" "," "where" "X" "is" "the" "number" "of" subtype_plural "tapped" "this" "way"

/* @sem EventSpec::Turn{point:EndStepBegins, players:All} */
tap_count_each_player_end ::= "the" "beginning" "of" "each" "player's" "end" "step"

/* @sem EventSpec::Turn{point:UpkeepBegins, players:All} */
tap_count_each_player_upkeep ::= "the" "beginning" "of" "each" "player's" "upkeep"

tap_count_player_turn ::= tap_count_each_player_end | tap_count_each_player_upkeep

/* @sem Ability::Triggered{event:$tap_count_player_turn, limits:_{}, announcement:@announcement, body:_{instructions:$tap_event_player_subtypes_count_damage}} */
triggered_tap_event_player_count_damage ::= "at" tap_count_player_turn "," tap_event_player_subtypes_count_damage "."

/* The controlling player and recipient refer to the mode chooser. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo($number), filter:AllOf([$plural, ControlledBy(One(ModeChooser))])})), regeneration:false}}, Effect{result:@next, operation:DrawUpTo{players:One(ModeChooser), amount:$card_count}}] */
chooser_destroy_draw ::= "you" "destroy" "up" "to" number "target" plural "that" "player" "controls" "." "they" "can't" "be" "regenerated" "." "that" "player" "draws" "up" "to" card_count

/* The next cast binds its own event subject and changes that spell's entry. */
/* @sem Operation::CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:$next_entry_spell_filter}, duration:$this_duration, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:ChangeSpell{subject:One(EventSubject), changes:$spell_entry_counter_change}}]}, once:true} */
next_cast_entry_counter ::= "when" "you" "next" "cast" "a" next_entry_spell_filter "spell" this_duration "," "it" spell_entry_counter_change

/* A mana instruction and its subsequent next-cast trigger retain both results. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$add_mana}, Effect{result:@next, operation:$next_cast_entry_counter}]} */
program_sentence_mana_next_entry ::= add_mana "." next_cast_entry_counter "."

/* @sem ObjectFilter::AllOf([$subtype, $noun]) */
next_entry_spell_filter ::= subtype noun

/* The permission groups the paid exile receipt with the next exiled top card.
   This phrase is only used under the required exile-payment construction. */
/* @sem Instruction::[Effect{result:@next, operation:$group_permission_top}, Effect{result:@next, operation:EffectOn{subject:Objects(Union([One(Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0}), One(Result{result:@prior, phase:After, index:0})])), effects:[Term{family:GroupExiledEffect, form:OneMayBePlayedBy, operands:[Player($group_permission_player)]}], until:$duration}}] */
exiled_payment_and_top_permission ::= group_permission_top "." duration "," group_permission_player "may" "play" "one" "of" "those" "cards"

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$group_single_exile_payment, optional:false}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$exiled_payment_and_top_permission}, otherwise:Program{}}] */
clause_exile_payment_group_permission ::= group_single_exile_payment "." "if" "you" "do" "," exiled_payment_and_top_permission

/* @sem Cost::Cost{parts:[Move{selections:[_{objects:One($object_ref)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]} */
group_single_exile_payment ::= "exile" object_ref

/* @prefer always */
/* @sem $exile_top_card_you */
group_permission_top_your ::= exile_top_card_you

/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Active)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
group_permission_top_active ::= "exile" "the" "top" "card" "of" "the" "active" "player's" "library"

group_permission_top ::= group_permission_top_your | group_permission_top_active

/* @prefer always */
/* @sem PlayerRef::AbilityController */
group_permission_you ::= "you"

/* @sem PlayerRef::Active */
group_permission_active ::= "the" "active" "player"

group_permission_player ::= group_permission_you | group_permission_active

/* Keep the damage result and the delayed trigger that consumes it together. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$spell_named_damage}, Effect{result:@next, operation:CreateTrigger{event:$event_damaged_this_way_dies, duration:$this_duration, announcement:_{}, body:$program_sentence}}]}} */
spell_damage_then_damaged_death ::= spell_named_damage "." "when" event_damaged_this_way_dies this_duration "," program_sentence

/* The named spell supplies the source independently of its recipients. */
/* @sem Operation::DealDamage{source:Source, recipients:$recipients, amount:$number, preventable:true} */
spell_named_damage ::= SELF_NAME "deals" number "damage" "to" recipients

/* A one-card library exile and its immediately linked play permission share
   the same arrival receipt, including when the library's owner is a target. */
/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0} */
linked_top_target_opponent ::= "target" "opponent's"

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0} */
linked_top_target_player ::= "target" "player's"

linked_top_target ::= linked_top_target_opponent | linked_top_target_player

/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($linked_top_target)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, ...$linked_single_play_spending] */
linked_top_exile_play ::= "exile" "the" "top" "card" "of" linked_top_target "library" "." linked_single_play_spending

/* Only paired with the singular exile producer above. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:Either, filter:Any}, terms:_{cost:Normal, spend_as:AnyType}})], duration:WhileExiled(Result{result:@marked, phase:After, index:0}), evaluation:LiveObjects}}] */
linked_single_play_spending ::= "you" "may" "play" "that" "card" "for" "as" "long" "as" "it" "remains" "exiled" "," "and" "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "it"

/* A conditional independent permission refers to the holder's linked cards. */
/* @sem Instruction::If{condition:$condition_monarch, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($self_explicit_ref)}, from:Exile, action:CastSpell, filter:Any}, terms:_{limit:Total(1), cost:Free}})], duration:$duration, evaluation:LiveObjects}}]}, otherwise:Program{}} */
conditional_linked_free_cast ::= "if" condition_monarch "," duration "," "you" "may" "cast" "a" "spell" "from" "among" "cards" "exiled" "with" self_explicit_ref "without" "paying" "its" "mana" "cost"

/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:Program{instructions:[...$linked_top_exile_play, $conditional_linked_free_cast]}} */
linked_top_play_conditional_trigger ::= "at" turn_event "," linked_top_exile_play "." conditional_linked_free_cast "."

/* Both actions consume the same captured value, independently of its definition. */
/* @sem Instruction::[Effect{result:@mark, operation:BindValue{value:$damage_opponent_source_count}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:BoundValue(@marked)}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:BoundValue(@marked)}}] */
instructions_draw_loss_count ::= "you" "draw" "X" "cards" "and" "lose" "X" "life" "," "where" "X" "is" damage_opponent_source_count

/* @sem Operation::CreatePerpetualEffect{objects:$random_hand_card_population, changes:[GrantAbility($quoted_cost_reduction)]} */
each_hand_card_perpetual_reduction ::= "each" random_hand_card_population "perpetually" "gains" quoted_cost_reduction

/* The trigger keeps the prior target and lasts while its source is tapped. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:$source_tapped_turn_event, duration:WhileMatches{object:Source, filter:Tapped}, announcement:_{}, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:@last_slot, index:0})), kind:$counter_kind, amount:Constant(1)}]}}]}}}] */
source_tapped_target_counter_trigger ::= "at" source_tapped_turn_event "," "put" "a" counter_kind "counter" "on" "that" "creature"

/* Cleanup uses the same announced target, independent of the trigger event. */
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:$source_leaves_or_untaps, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One(Target{slot:@last_slot, index:0})), kind:$counter_kind, amount:All}]}}]}}}] */
target_counter_cleanup ::= "when" source_leaves_or_untaps "," "remove" "all" counter_kind "counters" "from" "the" "creature"

/* @sem Program::Program{instructions:[...$source_tapped_target_untap_rule, ...$source_tapped_target_counter_trigger, ...$target_counter_cleanup]} */
source_tapped_target_counter_program ::= source_tapped_target_untap_rule "," "and" source_tapped_target_counter_trigger "." target_counter_cleanup

/* Epic appends its keyword action to the spell's preceding instructions. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$instructions, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Epic}}]}} */
shared_spell_epic ::= instructions "." NEWLINE "Epic"

/* The copied card is the arrival of this exact exile payment. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Move{selections:[_{objects:One($object_ref)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_copy_single, words:CreatingEffect, recipe:Copy{object:Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0}, exceptions:[$copy_set_enchantment]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{}}] */
clause_exile_receipt_copy ::= "you" "may" "exile" object_ref "." "if" "you" "do" "," "create" token_copy_single "that" "card" "," "except" copy_set_enchantment

/* Used only inside the unattach-payment grant, which proves the Earlier test's producer. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:GrantingObject, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0})), amount:$number, preventable:true}}, If{condition:Not(Compare{left:Earlier{what:Unattached, measure:Count, filter:$subtype}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}), then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(GrantingObject)), changes:[SetController(ControllerOf(Target{slot:0, index:0}))], duration:Indefinite, evaluation:Snapshot}}]}, otherwise:_{}}]} */
unattach_payment_damage_program ::= self_named "deals" number "damage" "to" "target" "creature" "." "that" "creature's" "controller" "gains" "control" "of" self_named "unless" "it" "was" "unattached" "from" "a" subtype "."

/* A mana-spending condition is settled before the return. Both branches move
   the same announced creature; the conditional counters belong to its entry. */
/* @sem Instruction::[If{condition:$condition_symbol_spent, then:Program{instructions:[Effect{result:@next, operation:Move{objects:One($conditional_entry_creature), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[]}}, qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Move{objects:One($conditional_entry_creature), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}] */
conditional_creature_return_entry ::= "return" conditional_entry_creature "to" "the" "battlefield" "." "if" condition_symbol_spent "," "that" "creature" "enters" "with" "an" "additional" counter_kind "counter" "on" "it"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and(ObjectFilter::CardType(Creature), ObjectFilter::InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}))}), index:0} */
conditional_entry_creature ::= "target" "creature" "card" "from" "your" "graveyard"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$conditional_creature_return_entry}} */
spell_conditional_creature_return_entry ::= conditional_creature_return_entry "."

/* Keep both choice receipts in the scope that names their actual producers. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController))])}, count:AsManyAsCan(Constant(1)), constraints:[]}}, ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase_2, ControlledBy(One(Bound(0))), Property{property:$stat, test:NumberTest::Compare{comparison:LessOrEqual, value:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:$stat, information:CurrentOrLastKnown}}}])}, count:AsManyAsCan(Constant(1)), constraints:[]}}]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$filter_phrase_3}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase_4, Not(InSet(Union([Selected(@marked), Selected(@prior)])))])}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{instructions:[]}}]}} */
spell_compare_opponent_choices_exile ::= "choose" "a" filter_phrase "you" "control" "," "then" "each" "opponent" "chooses" "a" filter_phrase "they" "control" "with" "equal" "or" "lesser" stat "." "if" "you" "chose" "a" filter_phrase "this" "way" "," "exile" "each" filter_phrase "not" "chosen" "by" "any" "player" "this" "way" "."

/* Two independently chosen permanent groups share one singular sacrificing player. */
/* @sem Operation::Together([Sacrifice{players:One($player_ref), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:Exactly(Constant(1))}, Sacrifice{players:One($player_ref), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase_2}, choose:Exactly(Constant(1))}]) */
sacrifice_player_pair_an_a ::= player_ref "sacrifices" "an" filter_phrase "and" "a" filter_phrase "of" "their" "choice"

/* The count is the performed objects of this particular sacrifice payment.
   Keeping the payment and its dependent instruction together proves the receipt. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:_{parts:[Sacrifice{objects:$affected, choose:AnyNumber}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:_{instructions:[Effect{result:@next, operation:$sacrifice_receipt_consequence}]}, otherwise:_{}}]} */
receipt_sacrifice_sentence ::= "you" "may" "sacrifice" "any" "number" "of" affected "." "if" "you" "do" "," sacrifice_receipt_consequence "."

sacrifice_receipt_consequence ::= sacrifice_receipt_damage | sacrifice_receipt_draw

/* @sem Operation::DealDamage{source:$object_ref, recipients:Objects($affected), amount:CountObjects(CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:Before}), preventable:true} */
sacrifice_receipt_damage ::= object_ref "deals" "that" "much" "damage" "to" affected

/* @sem Operation::Draw{players:One(AbilityController), amount:CountObjects(CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:Before})} */
sacrifice_receipt_draw ::= "draw" "that" "many" "cards"

/* A fresh spell scope makes the first announced creature slot zero. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_chosen_fighters}} */
spell_chosen_fighters ::= instructions_chosen_fighters "."

/* The two announced creatures are distinct through their controller filters.
   The conditional change belongs only to the first; fighting remains unconditional. */
/* @sem Instruction::[...$chosen_fighter_conditional, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:$chosen_controlled_fighter, second:$chosen_other_fighter}}}] */
instructions_chosen_fighters ::= "choose" chosen_controlled_fighter "and" chosen_other_fighter "." chosen_fighter_conditional "." "then" "those" "creatures" "fight" "each" "other"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), index:0} */
chosen_controlled_fighter ::= "target" "creature" "you" "control"

chosen_other_fighter ::= chosen_other_fighter_uncontrolled | chosen_other_fighter_opponent

chosen_fighter_conditional ::= chosen_fighter_if_first | chosen_fighter_if_type | chosen_fighter_counter_power

/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:0, index:0})), changes:$static_changes, duration:$duration, evaluation:Snapshot}}]}, otherwise:Program{}}] */
chosen_fighter_if_first ::= "if" condition "," "the" "creature" "you" "control" static_changes duration

/* @sem Instruction::[If{condition:ObjectMatches{object:Target{slot:0, index:0}, filter:$filter_phrase}, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:0, index:0})), changes:$static_changes, duration:$duration, evaluation:Snapshot}}]}, otherwise:Program{}}] */
chosen_fighter_if_type ::= "the" "creature" "you" "control" static_changes duration "if" "it's" "a" filter_phrase

/* A controller chooses a payment for the currently bound creature. The repeated
   amount names the same option, including when the operands are edited. */
/* @sem Instruction::[ChooseOne{decider:ControllerOf(Bound(0)), options:[_{instructions:[Effect{result:@next, operation:PayCost{player:ControllerOf(Bound(0)), cost:@agree($bound_controller_mana_payment, $bound_controller_mana_payment_3)}}, ...$bound_controller_combat_prevention]}, _{instructions:[Effect{result:@next, operation:PayCost{player:ControllerOf(Bound(0)), cost:$bound_controller_mana_payment_2}}]}, _{instructions:$bound_controller_combat_destroy}]}] */
bound_controller_two_mana_choices ::= "its" "controller" "may" "pay" bound_controller_mana_payment "or" bound_controller_mana_payment "." "if" "that" "player" "doesn't" "," bound_controller_combat_destroy "." "if" "that" "player" "pays" "only" bound_controller_mana_payment "," bound_controller_combat_prevention

/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Destroy{objects:One(Bound(0)), regeneration:true}}]}}}] */
bound_controller_combat_destroy ::= "destroy" "that" "creature" "at" "end" "of" "combat"

/* @sem Instruction::[Effect{result:@next, operation:CreateReplacement{event:Either([Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject(Bound(0))), kind:Combat, grouping:SourceRecipient, subject:Recipient}), Damage(_{source_kind:Permanent, sources:SameObject(Bound(0)), recipients:Any, kind:Combat, grouping:SourceRecipient, subject:Recipient})]), limit:UntilExpired, duration:EndOfCombat, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}}}] */
bound_controller_combat_prevention ::= "prevent" "all" "combat" "damage" "that" "would" "be" "dealt" "to" "and" "dealt" "by" "that" "creature" "this" "combat"

/* @sem Instruction::[ForEachObject{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(AnnouncedX), filter:AllOf([Attacking, $plural])})), binding:0, body:_{instructions:$bound_controller_two_mana_choices}}] */
instructions_target_attackers_controller_choice ::= "choose" "X" "target" "attacking" plural "." "for" "each" "of" "those" "creatures" "," bound_controller_two_mana_choices

/* @sem Cost::_{parts:[Mana($mana_symbols)]} */
bound_controller_mana_payment ::= mana_symbols

/* A bounded repeat retains the complete process and its condition in one scope. */
/* @sem Instruction::[RepeatableWithLimit{amount:Constant(2), body:$conditional_repeat_process}] */
instructions_conditional_repeat_once ::= conditional_repeat_process


/* A personal graveyard target returns to its owner's hand. */
/* @sem Operation::Move{objects:One($personal_graveyard_return_target), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
personal_graveyard_return_hand ::= "return" personal_graveyard_return_target "to" "your" "hand"

personal_graveyard_return_target ::= target_any_card_your_graveyard | target_card_your_graveyard

/* Keep the arrival producer and its anaphoric consumers in one program. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card_your_graveyard), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, ...$returned_card_keyword_and_owner_hand] */
returned_card_grant_and_delayed_return ::= "return" target_card_your_graveyard "to" "the" "battlefield" "." returned_card_keyword_and_owner_hand

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[GrantKeyword($keyword_name)], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:One(AbilityController)}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@back(4), phase:After, index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}}] */
returned_card_keyword_and_owner_hand ::= "it" "gains" keyword_name "." "return" "it" "to" "its" "owner's" "hand" "at" "the" "beginning" "of" "your" "next" "end" "step"

/* The compared characteristic belongs to the event subject; the selected card
   remains owned by the controller and enters under that controller. */
/* @sem ObjectFilter::AllOf([$milled_return_filter, Property{property:$receipt_stat, test:NumberTest::Compare{comparison:LessOrEqual, value:ObjectProperty{object:EventSubject, property:$receipt_stat, information:CurrentOrLastKnown}}}]) */
event_equal_or_lesser_card_filter ::= milled_return_filter "card" "with" "equal" "or" "lesser" receipt_stat

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$event_equal_or_lesser_card_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}] */
optional_event_stat_hand_entry ::= "you" "may" "put" "a" event_equal_or_lesser_card_filter "from" "your" "hand" "onto" "the" "battlefield"

/* Players and planeswalkers are one target group, iterated one recipient at a time. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[ForEachObject{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:AnyNumber, filter:CardType(Planeswalker), players:All})), binding:0, body:Program{instructions:$chosen_player_or_planeswalker_body}}]}} */
spell_each_chosen_player_or_planeswalker ::= "choose" "any" "number" "of" "target" "players" "or" "planeswalkers" "." "for" "each" "of" "them" "," chosen_player_or_planeswalker_body "."

/* The placement and the following grant share the announced target, while
   the quoted ability has its own ability scope. */
/* @sem Instruction::Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun_creature, ControlledBy(OpponentsOf(AbilityController))])}), index:0})), kind:$counter_kind, amount:Constant(1)}]}} */
opponent_target_counter_placement ::= "put" "a" counter_kind "counter" "on" "target" noun_creature "an" "opponent" "controls"

/* @sem Instruction::Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:0, index:0})), changes:[GrantAbility(@scope($counter_granted_ability))], duration:$target_counter_duration, evaluation:Snapshot}} */
target_counter_grant ::= target_counter_duration "," "it" "has" '"' counter_granted_ability '"'

/* @sem Duration::WhileMatches{object:Affected, filter:Counters{kind:$counter_kind, comparison:Greater, value:Constant(0)}} */
target_counter_duration ::= "for" "as" "long" "as" "that" "creature" "has" "a" counter_kind "counter" "on" "it"

/* The choice and the duplicate have distinct receipts; the test and grant both use the conjured arrival. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue(_{choosers:One(AbilityController), kind:Object, terms:_{options:[Filter(InZone(Players{zone:Graveyard, players:One(AbilityController)}))], count:Exactly(Constant(1)), secret:true}})}, Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Duplicate(One(Result{result:@prior, phase:After, index:0})), count:Constant(1), destination:Hand{}}}, If{condition:ObjectMatches{object:Result{result:@last_result, phase:After, index:0}, filter:Not($duplicate_negative_card_type)}, then:_{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:[GrantKeyword($keyword_name)]}}]}, otherwise:_{}}] */
instructions_secret_graveyard_duplicate ::= "secretly" "choose" "a" "card" "in" "your" "graveyard" "and" "conjure" "a" "duplicate" "of" "it" "into" "your" "hand" "." "if" "the" "duplicate" "isn't" "a" duplicate_negative_card_type "card" "," "it" "perpetually" "gains" keyword_name

duplicate_negative_card_type ::= noun_land | noun_creature | noun_planeswalker | noun_battle

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, body:_{instructions:$instructions_secret_graveyard_duplicate}, announcement:@announcement} */
triggered_secret_graveyard_duplicate ::= event_clause "," instructions_secret_graveyard_duplicate "."

/* A returned creature payment and its property-dependent placement stay in the
   same program: the recorded object belongs to this particular payment. */
/* @sem Cost::Cost{parts:[Move{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), $returned_creature_filter, ControlledBy(One(AbilityController))])}, choose:Exactly(Constant(1))}], destination:OwnersHand(CardArrival{})}]} */
return_other_creature_payment ::= "return" "another" returned_creature_filter "you" "control" "to" "its" "owner's" "hand"

returned_creature_filter ::= noun_creature | returned_artifact_creature

/* @sem ObjectFilter::AllOf([CardType(Artifact), CardType(Creature)]) */
returned_artifact_creature ::= "artifact" "creature"

/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:ObjectProperty{object:Recorded{result:@prior}, property:$creature_stat, information:CurrentOrLastKnown}}]} */
returned_creature_property_counters ::= "put" "a" "number" "of" counter_kind "counters" "equal" "to" "that" "creature's" creature_stat "on" affected

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$return_other_creature_payment, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:$returned_creature_property_counters}]}, otherwise:Program{}}]} */
optional_return_creature_property_program ::= "you" "may" return_other_creature_payment "," "then" returned_creature_property_counters

/* The arrival and its subsequent keyword grant share the actual move result. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($subtype, $noun, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[Changes([SetBasePowerToughness{power:$number, toughness:$number_2}])]}}, qualifiers:[]}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}]}, otherwise:Program{}}]} */
optional_return_counter_base_grant_program ::= "you" "may" "return" "target" subtype noun "card" "from" "your" "graveyard" "to" "the" "battlefield" "with" "a" counter_kind "counter" "on" "it" "." "it" "has" "base" "power" "and" "toughness" number "/" number "." "it" "gains" keyword_name duration "."

/* The return modifier belongs to the same phased object as the subject. */
/* @sem Operation::EffectOn{subject:Objects(One($phase_creature_subject)), effects:[$phase_in_creature_modifier], until:$phase_out_battlefield_duration} */
phased_creature_with_return_effect ::= phase_creature_subject "phases" "out" phase_out_battlefield_duration "." phase_in_creature_modifier

/* @sem Duration::WhileOnBattlefield($object_ref) */
phase_out_battlefield_duration ::= "until" object_ref "leaves" "the" "battlefield"

/* @sem Operand::Vocabulary{family:PhasedOutEffect, form:TapAsPhasesIn} */
phase_in_creature_modifier ::= "tap" "that" "creature" "as" "it" "phases" "in" "this" "way"

phase_creature_subject ::= exile_counter_creature_target | target_qualified_creature

/* Named source damage to a single creature, reusable as an operation. */
/* @sem Operation::DealDamage{source:Source, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0})), amount:$number, preventable:true} */
named_source_damage_target_creature ::= SELF_NAME "deals" number "damage" "to" "target" "creature"

/* The target controller may choose the source damage payment instead. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:ControllerOf(Target{slot:@last_slot, index:0}), cost:Cost{parts:[PlayerAction{player:ControllerOf(Target{slot:@last_slot, index:0}), body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(One(ControllerOf(Target{slot:@last_slot, index:0}))), amount:$number, preventable:true}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:$named_source_damage_target_creature}]}, otherwise:Program{}}] */
instructions_target_creature_unless_controller_damage ::= named_source_damage_target_creature "unless" "that" "creature's" "controller" "has" SELF_NAME "deal" number "damage" "to" "them"

/* Each population is separately stated; the name test is evaluated for each affected permanent. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun, ControlledBy(One(AbilityController)), AnyOf([SharesNameWithAnother(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun_2, ControlledBy(One(AbilityController))])}), SharesNameWithAny(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$noun_3})])])}), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot} */
controlled_shared_name_temporary_pump ::= "each" noun "you" "control" "gets" signed "/" signed duration "if" "it" "has" "the" "same" "name" "as" "another" noun "you" "control" "or" "a" noun "card" "in" "your" "graveyard"

/* The resolving spell remains the cast event's subject; the enclosing trigger
   proves that its caster cast it from their own hand. */
/* @sem Operand::Term{family:SpellEffect, form:AsResolves, operands:[List([Term{family:ResolveAction, form:ExileResolvingSpellAndPlotIt}])]} */
resolving_spell_exile_plot ::= "instead" "of" "putting" "it" "into" "your" "graveyard" "as" "it" "resolves" "." "if" "you" "do" "," "it" "becomes" "plotted"

/* @sem Operation::EffectOn{subject:Objects(One(EventSubject)), effects:[$resolving_spell_exile_plot]} */
cast_hand_spell_exile_plot ::= "exile" "that" "spell" resolving_spell_exile_plot

/* @sem Ability::Triggered{event:$event_cast_from_hand, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$cast_hand_spell_exile_plot}]}} */
triggered_cast_hand_resolving_effect ::= "whenever" event_cast_from_hand "," cast_hand_spell_exile_plot "."

/* Targets have distinct controllers; the sacrifice receipt is consumed only by
   the enclosing producer-and-followup phrase. */
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(CountPlayers(All)), filter:@and($filter_phrase, ObjectFilter::ControlledBy(All)), constraints:[DifferentControllers]}))}) */
each_player_target_sacrifice ::= "for" "each" "player" "," "choose" "target" filter_phrase "that" "player" "controls" "." "those" "players" "sacrifice" "those" "permanents"

/* The qualifying population is measured from this exact sacrifice, before
   revealing and moving any cards. */
/* @sem Instruction::[Effect{result:@mark, operation:$each_player_target_sacrifice}, ForEachPlayer{players:Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:MovedBy{result:@marked, phase:Before, player:Bound(0)}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}, binding:0, body:$bound_top_reveal_conditional_entry}] */
instructions_target_sacrifice_reveal ::= each_player_target_sacrifice "." "each" "player" "who" "sacrificed" "a" filter_phrase "this" "way" bound_top_reveal_conditional_entry

/* The cloak consumes the arrival of this specific shuffled exile pile. */
/* @sem Operation::Move{objects:$owned_target_and_library_top, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[ExilePile{shuffled:true}]}}, qualifiers:[]} */
exile_owned_target_library_pile ::= "exile" owned_target_and_library_top "in" "a" "face-down" "pile" "," "shuffle" "that" "pile"

/* @sem Instruction::[Effect{result:@next, operation:$exile_owned_target_library_pile}, Effect{result:@next, operation:Manifest{actor:One(AbilityController), source:Cards(Transition{result:@prior, phase:After}), cloak:true, entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}}] */
cloak_shuffled_exile_pile_tapped ::= exile_owned_target_library_pile "," "then" "cloak" "those" "cards" "." "they" "enter" "tapped"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$cloak_shuffled_exile_pile_tapped}} */
spell_cloak_shuffled_exile_pile_tapped ::= cloak_shuffled_exile_pile_tapped "."

/* A duration and a spell effect apply to the explicitly described stack population. */
/* @sem Operation::EffectOn{subject:EachSpell($timed_spell_population), effects:[$timed_spell_effect], until:$this_duration} */
timed_spell_population_effect ::= timed_spell_population timed_spell_effect this_duration

timed_spell_population ::= other_controlled_spell_population | controlled_spell_population | other_typed_controlled_spell_population

/* @sem ObjectFilter::@and(ObjectFilter::Not(SameObject(Source)), $modifier_you_control) */
other_controlled_spell_population ::= "other" "spells" modifier_you_control

/* @sem $modifier_you_control */
controlled_spell_population ::= "spells" modifier_you_control

/* @sem ObjectFilter::@and(ObjectFilter::Not(SameObject(Source)), $spell_type_head, $modifier_you_control) */
other_typed_controlled_spell_population ::= "other" spell_type_head "spells" modifier_you_control

/* @sem Operand::Term{family:SpellEffect, form:CantBeCountered} */
timed_spell_effect ::= "can't" "be" "countered"

/* A cast boon affects the spell that triggered it, in its own event frame. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:$event_cast, duration:Indefinite, announcement:_{}, body:_{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:One(EventSubject), changes:$cast_boon_changes}}]}, once:true}}] */
/* @prefer always */
clause_one_time_cast_perpetual_boon ::= "you" "get" "a" "one-time" "boon" "with" '"' "when" event_cast "," "it" "perpetually" cast_boon_changes "." '"'

/* A triggered action can be followed by a separately scoped cast boon. */
/* @sem Ability::Triggered{event:$cast_boon_outer_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$operation}, ...$clause_one_time_cast_perpetual_boon]}} */
/* @prefer always */
triggered_action_cast_boon ::= cast_boon_outer_event "," operation "." clause_one_time_cast_perpetual_boon

cast_boon_outer_event ::= cast_boon_specializes | event_clause

/* @sem EventSpec::Object{event:Specializes, objects:SameObject(Source)} */
/* @prefer always */
cast_boon_specializes ::= "when" "this" "creature" "specializes"

cast_boon_changes ::= cast_boon_pump_and_keyword | cast_boon_pump_only

/* The reflexive quantity and its target belong to this exact exile producer.
   The shared program permits different events, card counts, filters and counters. */
/* @sem Program::Program{instructions:[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any}, count:AsManyAsCan($card_count), constraints:[]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$adjective_nontype}), test:Compare{comparison:Greater, value:Constant(0)}}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($target_object)), kind:$counter_kind, amount:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$adjective_nontype})}]}}]}})}]} */
each_graveyard_exile_reflexive_program ::= "each" "player" "exiles" card_count "from" "their" "graveyard" "." "when" "one" "or" "more" adjective_nontype "cards" "are" "exiled" "this" "way" "," "put" "that" "many" counter_kind "counters" "on" target_object "."

/* Damage is assigned to the per-opponent target announcement, not a resolving player loop. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$self_ref_named, recipients:Objects($each_opponent_up_to_one), amount:$number, preventable:true}}] */
clause_damage_each_opponent_target ::= "for" "each" "opponent" "," self_ref_named "deals" number "damage" "to" each_opponent_up_to_one

/* The callback's X and departure replacement are scoped to the paid X and
   the particular object moved to the battlefield by this callback. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[ManaWithX{mana:[X]}]}, optional:false}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$paid_x_callback})}]}}]} */
paid_x_return_counter_program ::= "you" "may" "pay" "{" "X" "}" "." "when" "you" "do" "," paid_x_callback

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([@agree($noun, $noun_2), Property{property:ManaValue, test:Compare{comparison:Equal, value:AnnouncedX}}, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:_{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateReplacement{event:Object{event:LeavesBattlefield, objects:SameObject(Result{result:@prior, phase:After, index:0})}, limit:UntilExpired, duration:WhileOnBattlefield(Result{result:@prior, phase:After, index:0}), body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}}}]} */
paid_x_return_counter_callback ::= "return" "target" noun "card" "with" "mana" "value" "X" "from" "your" "graveyard" "to" "the" "battlefield" "with" "a" counter_kind "counter" "on" "it" "." "if" "that" noun "would" "leave" "the" "battlefield" "," "exile" "it" "instead" "of" "putting" "it" "anywhere" "else"

/* Choose a target, then impose the named rules for the stated duration. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_opponents_qualified_permanent)), changes:$chosen_permanent_combat_activation_restrictions, duration:$duration, evaluation:LiveObjects}}]} */
program_chosen_opponent_permanent_restrictions ::= "choose" target_opponents_qualified_permanent "." duration "," chosen_permanent_combat_activation_restrictions "."

/* A counted draw is an optional resolution payment; its follow-up is conditional on that payment. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$payment_draw_shared_type_count, optional:true}}, If{condition:PaymentChosen(@marked), then:$program, otherwise:Program{}}] */
instructions_optional_counted_draw_followup ::= "you" "may" payment_draw_shared_type_count "." "if" "you" "do" "," program

/* @sem Cost::Cost{parts:[Draw{count:$count_other_controlled_sharing_source_type}]} */
payment_draw_shared_type_count ::= "draw" "a" "card" "for" "each" count_other_controlled_sharing_source_type

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), $noun, ControlledBy(One(AbilityController)), Shares{property:CreatureTypes, with:Source}])}) */
count_other_controlled_sharing_source_type ::= "other" noun "you" "control" "that" "shares" "a" "creature" "type" "with" "it"

/* The previously announced targets are the distributive sources. */
/* @sem ObjectSet::Targets(0) */
damage_those_creatures ::= "each" "of" "those" "creatures"

damage_property_population ::= damage_each_population | damage_those_creatures

/* Destruction and its mana-value consequence refer to the announced target,
   including its last known characteristics if destruction succeeds. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Destroy{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ControlledBy(OpponentsOf(AbilityController))])}), index:0}), regeneration:true}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:ObjectProperty{object:Target{slot:@last_slot, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}]} */
program_destroy_target_mana_life ::= "destroy" "target" noun "an" "opponent" "controls" "." "you" "lose" "life" "equal" "to" "its" "mana" "value"

/* The counter and duration deliberately share the named counter; the target
   remains the same object for the subsequent continuous effect. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@another_target_reference(ObjectFilter::$noun))), $noun)}), index:0})), kind:Named(SaurianCounter), amount:Constant(1)}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@last_slot, index:0})), changes:[Colors{mode:Set, colors:[$mana_color_word]}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetBasePowerToughness{power:$number_digits, toughness:$number_digits_2}], duration:WhileMatches{object:Affected, filter:Counters(_{kind:Named(SaurianCounter), comparison:Greater, value:Constant(0)})}, evaluation:Snapshot}}]} */
program_saurian_counter_animation ::= "put" "a" "saurian" "counter" "on" "another" "target" noun "." "it's" "a" mana_color_word becomes_types "with" "base" "power" "and" "toughness" number_digits "/" number_digits "for" "as" "long" "as" "it" "has" "a" "saurian" "counter" "on" "it"

/* The same targeted permanent supplies the damage source, its power, and the sacrifice. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$target_permanent, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Not(SameObject($target_permanent))})), amount:ObjectProperty{object:$target_permanent, property:Power, information:CurrentOrLastKnown}, preventable:true}}, Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:One($target_permanent)})}] */
controlled_target_power_damage_sacrifice ::= target_permanent "deals" "damage" "equal" "to" "its" "power" "to" "any" "other" "target" "." "then" "sacrifice" "it"

/* The earlier mentioned player controls the chosen-type population. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, Chosen(CreatureType), ControlledBy(One(@that_player))])}, regeneration:false}}] */
destroy_chosen_type_player_no_regeneration ::= "destroy" "all" filter_plural "of" "that" "type" "that" "player" "controls" "." "they" "can't" "be" "regenerated"

/* Target selection, payment and replacement stay together: the replacement
   applies only to the spell cast from this graveyard by this action. */
/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:One($cast_other_type_target), count:Exactly(Constant(1)), cost:Normal, into_exile:true} */
cast_other_type_graveyard ::= "cast" "up" "to" "one" cast_other_type_target "." "if" "a" "spell" "cast" "from" "your" "graveyard" "this" "way" "would" "be" "put" "into" "your" "graveyard" "," "exile" "it" "instead"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:AllOf([AnyOf([CardType(Instant), CardType(Sorcery)]), Not(Shares{property:CardTypes, with:EventSubject}), InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0} */
cast_other_type_target ::= "target" "card" "of" "the" "other" "type" "from" "your" "graveyard"

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:One($cast_power_bound_target), count:Exactly(Constant(1)), cost:Normal, into_exile:true} */
cast_power_bound_graveyard ::= "cast" cast_power_bound_target "." "if" "that" "spell" "would" "be" "put" "into" "your" "graveyard" "," "exile" "it" "instead"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:ObjectProperty{object:Source, property:Power, information:CurrentOrLastKnown}}}, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0} */
cast_power_bound_target ::= "target" card_filter "card" "with" "mana" "value" "less" "than" "or" "equal" "to" "his" "power" "from" "your" "graveyard"

/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:$cast_other_type_graveyard}]}}] */
instructions_may_cast_other_type ::= "you" "may" cast_other_type_graveyard

/* The condition counts the immediately preceding cast action's receipt. */
/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:$cast_power_bound_graveyard}, If{condition:Compare{left:CountObjects(Recorded(@prior)), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}}, then:$program, otherwise:_{}}]}}] */
instructions_may_cast_power_callback ::= "you" "may" cast_power_bound_graveyard "." "if" "you" "cast" counter_amount "spell" "this" "way" "," program

/* Keep the sacrifice producer and its per-player receipt in the same reversible phrase. */
/* @sem Instruction::[Effect{result:@mark, operation:$sacrifice_named_choice}, Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:MovedBy{result:@marked, phase:Before, player:Bound(0)}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}), amount:$value, preventable:true}}] */
instructions_sacrifice_then_damage_participants ::= sacrifice_named_choice "." object_ref "deals" value "damage" "to" "each" "player" "who" "sacrificed" "a" filter_phrase "this" "way"

/* Both die-result consumers are scoped to the same ordered roll and choice. */
/* @sem Instruction::[Effect{result:@mark, operation:Keyword{actor:One(AbilityController), action:KeywordAction::RollTwoInOrder{sides:6}}}, Effect{result:@next, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:$stat_comparison, value:DieResultAt{result:@marked, index:0}}})}, regeneration:true}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:DieResultAt{result:@marked, index:1}, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
instructions_roll_chosen_destroy_create ::= "roll" "two" "d6" "and" "choose" "one" "result" "." "destroy" "each" filter_phrase "with" stat stat_comparison "that" "result" "." "then" "create" "a" "number" "of" token_recipe "equal" "to" "the" "other" "result"

/* The printed replacement chooses between complete instruction sequences. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:$clause_imperative}, otherwise:Program{instructions:$instructions_loot}}] */
instructions_loot_conditional_instead ::= instructions_loot "." "if" condition "," "instead" clause_imperative

/* The damaged creature and its controller remain distinct event roles. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf(Damage(Recipient)), cost:$counter_unless_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One(Damage(Recipient)), regeneration:true}}]}, otherwise:Program{}}] */
clause_damage_recipient_unless_paid ::= "destroy" "that" "creature" "unless" "its" "controller" "pays" counter_unless_cost

/* The counter is placed on the announced target even if tapping did nothing. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:One($target_object), tapped:true}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($target_object)), kind:$counter_kind, amount:Constant(1)}]}}] */
instructions_tap_target_put_counter ::= "tap" target_object "and" "put" "a" counter_kind "counter" "on" "it"

/* The selection and subsequent movement refer to the same announced target. */
/* @sem Operation::Move{objects:One($target_card_arrived_from_battlefield), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
