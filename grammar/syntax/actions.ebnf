instructions_each_library_exile_life_value ::= permission_exile_each_library "." permission_exiled_life_value

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:Either, filter:Any}, terms:_{limit:Total(1), cost:Alternate(Cost{parts:[LifeEqualToOwnManaValue]})}})], duration:$duration, evaluation:LiveObjects}}] */
permission_exiled_life_value ::= duration "," "you" "may" "play" "one" "of" "those" "cards" "." "if" "you" "cast" "a" "spell" "this" "way" "," "pay" "life" "equal" "to" "its" "mana" "value" "rather" "than" "paying" "its" "mana" "cost"

