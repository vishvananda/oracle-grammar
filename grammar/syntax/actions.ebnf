/* The removed counter and both recipient references are the same as the offered placement. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($object_ref)), kind:$counter_kind, amount:Constant(1)}]}}]}, Program{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($object_ref)), kind:$counter_kind, amount:Count(Exactly(Constant(1)))}]}}]}]}] */
counter_single_put_or_remove ::= "put" "a" counter_kind "counter" "on" object_ref "or" "remove" "one" "from" "it"

/* The damage source, recipient and counted object are independent operands. */
