choice_defender_sacrifice_or_control_attack ::= "defending" "player" "faces" "a" "villainous" "choice" "—" "that" "player" "sacrifices" "a" filter_phrase "of" "their" "choice" "," "or" "you" "gain" "control" "of" "a" "creature" "of" "your" "choice" "that" "player" "controls" duration "." "if" "you" "gain" "control" "of" "a" "creature" "this" "way" "," "tap" "it" "," "and" "it's" "attacking" "that" "player"

