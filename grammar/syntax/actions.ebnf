hand_cast_bounded_value ::= "spell" "from" "your" "hand" "with" "mana" "value" value "or" "less"

/* Keep the event amount producer and its exile receipt together. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$event_amount_library_end, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:$exile_event_cast_permission}] */
instructions_exile_event_amount_cast ::= "exile" event_amount_library_end "." exile_event_cast_permission

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:CastSpell, filter:Any})], duration:$duration, evaluation:LiveObjects} */
exile_event_cast_permission ::= duration "," "you" "may" "cast" "spells" "from" "among" "those" "exiled" "cards"

/* Exile the referenced player’s graveyard population. */
/* @sem Operation::Move{objects:$referenced_player_graveyard_population, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_referenced_graveyard ::= "exile" referenced_player_graveyard_population

/* An announced object can be tested before applying a temporary combat rule. */
/* @sem Instruction::[If{condition:ObjectMatches{object:$combat_chosen_target, filter:$combat_chosen_state}, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@last_slot, index:0})), changes:$rule_cant_be_blocked, duration:$this_duration, evaluation:LiveObjects}}]}, otherwise:Program{}}] */
combat_chosen_conditional_rule ::= "choose" combat_chosen_target "." "if" "it's" combat_chosen_state "," "it" rule_cant_be_blocked this_duration

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_phrase}), index:0} */
combat_chosen_target ::= "target" filter_phrase

combat_chosen_state ::= combat_chosen_attacking | combat_chosen_blocking

/* @sem ObjectFilter::Attacking */
combat_chosen_attacking ::= "attacking"

/* @sem ObjectFilter::Blocking */
combat_chosen_blocking ::= "blocking"

/* The damage sources include the antecedent and its blocked combatants. */
/* @sem Instruction::[If{condition:ObjectMatches{object:Target{slot:@last_slot, index:0}, filter:$combat_chosen_state}, then:Program{instructions:[Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Permanent, sources:AnyOf([SameObject(Target{slot:@last_slot, index:0}), AllOf([$noun, BlockedByObject(Target{slot:@last_slot, index:0})])]), recipients:Any, kind:Combat, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:EndOfCombat, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}}}]}, otherwise:Program{}}] */
combat_chosen_conditional_prevention ::= "if" "it's" combat_chosen_state "," "prevent" "all" "combat" "damage" "that" "would" "be" "dealt" "this" "combat" "by" "it" "and" "each" noun "it's" "blocking"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$combat_chosen_conditional_rule, ...$combat_chosen_conditional_prevention]}} */
spell_chosen_combat_conditions ::= combat_chosen_conditional_rule "." combat_chosen_conditional_prevention "."

/* Preserve the unspecified owner carried by this conjure contract. */
/* @sem Operation::Conjure{actor:One(AbilityController), card:Named(@card_name), count:$card_count, destination:Graveyard(CardArrival{counters:[], states:[]})} */
conjure_self_unspecified_owner_graveyard ::= "conjure" card_count "named" SELF_NAME "into" "your" "graveyard"

/* A revealed selection retains its two independent type exclusions. */
/* @sem ObjectSet::Matching{objects:Earlier{what:Revealed}, filter:$filter_negative_type_pair} */
revealed_excluded_type_card ::= filter_negative_type_pair "card" "revealed" "this" "way"

/* @sem Operation::PlayWith{actor:One(AbilityController), action:CastSpell, cards:$revealed_excluded_type_card, count:UpTo($counter_a), terms:_{cost:Free}} */
choose_revealed_card_cast_free ::= "choose" counter_a revealed_excluded_type_card "and" "cast" "it" "without" "paying" "its" "mana" "cost"

/* Reveal each participant's own complete hand. */
/* @sem Instruction::ForEachPlayer{players:$revealing_hand_players, binding:0, body:_{instructions:[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}}}]}} */
each_player_reveals_own_hand ::= revealing_hand_players "reveals" "their" "hand"

revealing_hand_players ::= players_each_opponent | players_each

/* @sem Instruction::[$each_player_reveals_own_hand, Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:$choose_revealed_card_cast_free}]}}] */
revealed_hands_optional_action ::= each_player_reveals_own_hand "." "you" "may" choose_revealed_card_cast_free

/* A counter action retains its current affected set. */
/* @sem Operation::Counter{objects:$affected, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None} */
counter_affected_post_action ::= "counter" affected

/* A postposed condition gates the counter action at resolution. */
/* @prefer always */
/* @sem Instruction::[@resolution(Instruction::If{condition:$condition_same_name_zones, then:Program{instructions:[Effect{result:@next, operation:$counter_affected_post_action}]}, otherwise:Program{}})] */
clause_counter_postcondition ::= counter_affected_post_action "if" condition_same_name_zones

/* An arrival orientation and its controller are independent of the returned object. */
/* @sem Operation::Move{objects:$affected, destination:Battlefield{controller:Player(AbilityController), arrival:$explicit_return_orientation}, qualifiers:[]} */
return_with_explicit_orientation ::= "return" affected "to" "the" "battlefield" explicit_return_orientation "under" "your" "control"

explicit_return_orientation ::= entry_face_down_shared | entry_flipped

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[], states:[FaceDown]} */
entry_face_down_shared ::= "face" "down"

/* A keyword and two independently scoped quoted abilities remain distinct changes. */
/* @sem Change::[GrantKeyword($keyword_name), GrantAbility($comma_quoted_creature_static), GrantAbility($quoted_holder_turn_damage)] */
perpetual_keyword_two_quoted_abilities ::= "gains" keyword_name "," comma_quoted_creature_static "and" quoted_holder_turn_damage

/* The comma punctuates the enclosing list, inside the first quote. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(One(Source)), changes:$static_change} */
comma_quoted_creature_static ::= '"' "this" "creature" static_change "," '"'

/* The trigger belongs to the creature receiving the quoted ability. */
/* @sem Ability::@scope(Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:$recipients, amount:$value, preventable:true}}]}}) */
quoted_holder_turn_damage ::= '"' "at" turn_event "," "this" "creature" "deals" value "damage" "to" recipients "." '"'

control_while_affected ::= affected | control_lesser_power_target

/* The comparison uses the ability source, independently of the control duration. */
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo($n1), filter:AllOf([$noun, Property{property:Power, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:Source, property:Power, information:CurrentOrLastKnown}}}])}), index:0}) */
control_lesser_power_target ::= "up" "to" n1 "target" noun "with" "lesser" "power"

/* The counter goes on the announced target, even if it was already tapped. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:$filter_phrase}), index:0}), tapped:true}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:@last_slot, index:0})), kind:$counter_kind, amount:Constant(1)}]}}] */
clause_tap_optional_target_counter ::= "tap" "up" "to" "one" "target" filter_phrase "and" "put" "a" counter_kind "counter" "on" "it"

/* The preceding creation supplies the token referred to by this placement. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Created(@prior)), kind:$counter_kind, amount:$count_each_owned_exile_mana_values}]} */
put_counter_on_created_distinct_values ::= "put" "a" counter_kind "counter" "on" "it" "for" "each" count_each_owned_exile_mana_values

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$create_one_defined}, Effect{result:@next, operation:$put_counter_on_created_distinct_values}]} */
created_counter_distinct_values_program ::= create_one_defined "." put_counter_on_created_distinct_values

/* @sem Expr::CountDistinct{objects:$card_population_owned_exile_counters, property:ManaValues} */
count_each_owned_exile_mana_values ::= "different" "mana" "value" "among" card_population_owned_exile_counters

/* @sem Operation::Move{objects:One($chosen_arrival_single), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_battlefield_before_arrival ::= "return" "to" "the" "battlefield" chosen_arrival_single

/* The target and untapped arrival remain independent operands of the return action. */
/* @sem Operation::Move{objects:$target_lesser_event_graveyard_card, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_lesser_event_card ::= "return" target_lesser_event_graveyard_card "to" "the" "battlefield"

/* A targeted chooser selects between lists of independently performed actions. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseAction{actor:One($target_opponent), options:[List([Program{instructions:[Effect{result:@next, operation:$villainous_destroy_all}]}, Program{instructions:[Effect{result:@next, operation:$villainous_opponents_loss}]}]), List([Program{instructions:[Effect{result:@next, operation:$villainous_destroy_all_2}]}])], villainous:true}}] */
clause_villainous_target_grouped ::= target_opponent "faces" "a" "villainous" "choice" "—" villainous_destroy_all "and" villainous_opponents_loss "," "or" villainous_destroy_all

/* @sem Operation::LoseLife{players:OpponentsOf(AbilityController), amount:$value} */
villainous_opponents_loss ::= "each" "of" "your" "opponents" "loses" "life" "equal" "to" value

/* @sem Operation::Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$villainous_plural}, regeneration:true} */
villainous_destroy_all ::= "destroy" "all" villainous_plural

villainous_plural ::= villainous_subtype_creatures | filter_plural

/* @prefer always */
/* @sem @and($subtype, ObjectFilter::CardType(Creature)) */
villainous_subtype_creatures ::= subtype "creatures"

/* The defender is bound by the opponent loop; the creator is independent. */
/* @sem Program::Program{instructions:[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@next, operation:$loop_opponent_token_creation}]}}]} */
program_each_opponent_token_creation ::= "for" "each" "opponent" "," loop_opponent_token_creation

/* The loop's created objects are the subjects of the following grant. */
/* @sem Instruction::[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@next, operation:$loop_opponent_plural_token_creation}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Created(@prior)), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}] */
instructions_loop_opponent_tokens_grant ::= "for" "each" "opponent" "," loop_opponent_plural_token_creation "." "they" "gain" keyword_name duration

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[], states:[ChangesUntil{changes:[Rule(RequireCombat{action:Attack(Players(One(Bound(0)))), amount:AtLeast(Constant(1))})], duration:EndOfTurn}]} */
loop_opponent_required_attack_plural_entry ::= "that" "attack" "that" "opponent" "this" "turn" "if" "able"

/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[$token_group], entry:$loop_opponent_required_attack_plural_entry} */
loop_opponent_plural_token_creation ::= "create" token_group loop_opponent_required_attack_plural_entry

/* The target controller may choose the source's damage to them to avert the target damage. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$noun_creature}), index:0}), cost:_{parts:[PlayerAction{player:ControllerOf(Target{slot:0, index:0}), body:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(One(ControllerOf(Target{slot:0, index:0}))), amount:$controller_damage_amount, preventable:true}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@prior)), then:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Target{slot:0, index:0})), amount:$target_damage_amount, preventable:true}}]}, otherwise:_{}}] */
instructions_source_damage_unless_controller_damage ::= "this" "creature" "deals" target_damage_amount "damage" "to" "target" noun_creature "unless" "that" "creature's" "controller" "has" "this" "creature" "deal" controller_damage_amount "damage" "to" "them"

/* @sem $number */
target_damage_amount ::= number

/* @sem $number */
controller_damage_amount ::= number

/* A willing player may take the described damage in place of an effect. */
/* @sem Cost::Cost{parts:[PlayerAction{player:FirstWilling(All), body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(One(FirstWilling(All))), amount:$value, preventable:true}}]}}]} */
willing_player_has_damage ::= "has" object_ref "deal" value "damage" "to" "them"

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:FirstWilling(All), cost:$willing_player_has_damage, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:$willing_declined_effect}]}, otherwise:Program{}}] */
clause_willing_damage_declined ::= willing_declined_effect "unless" "a" "player" willing_player_has_damage

/* The count phrase is shared independently of the counter placement. */
/* @sem Operation::PutCounters{placements:[_{recipients:$recipients, kind:$counter_kind, amount:$count_each_discarding_players}]} */
get_an_counter_for_discarding_players ::= recipients "get" "an" counter_kind "counter" "for" "each" count_each_discarding_players

/* @sem Operation::$get_an_counter_for_discarding_players */
then_get_an_counter_for_discarding_players ::= "then" get_an_counter_for_discarding_players

/* Partition target selection by player, preserving the full filter. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:All, each:UpTo(Constant(1))}, filter:$partitioned_permanent_filter})) */
each_player_exile_targets ::= "up" "to" "one" "target" partitioned_permanent_filter "that" "player" "controls"

/* @sem ObjectFilter::AllOf([$subtype_negated, $adjective_nontype, $noun]) */
partitioned_permanent_filter ::= subtype_negated "," adjective_nontype noun

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$each_player_exile_targets, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReturnAfter{objects:Transition{result:@prior, phase:After}, duration:WhileOnBattlefield($self_ref)}}] */
clause_exile_each_player_until ::= "for" "each" "player" "," "exile" each_player_exile_targets "until" self_ref "leaves" "the" "battlefield"

/* @sem Program::Program{instructions:$clause_exile_each_player_until} */
chapter_each_player_exile_until ::= clause_exile_each_player_until

/* An explicit source can be exiled face down, independently of other moves. */
/* @sem Operation::Move{objects:One($self_explicit_ref), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_explicit_self_face_down ::= "exile" self_explicit_ref "face" "down"

/* The decision is shared by combat and turn duration effects. */
/* @sem Change::PlayerRule(Decides(WhichCreaturesBlock)) */
blocking_choice ::= "which" "creatures" "block"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[$blocking_choice], duration:$this_duration, evaluation:LiveObjects} */
choose_blockers_for_duration ::= "you" "choose" blocking_choice this_duration "and" "how" "those" "creatures" "block"

/* Counter placement is shared across recipients and grammatical number. */
shared_owned_counter_placement ::= shared_single_counter_placement | shared_multiple_counter_placement

/* @sem CounterPlacement::CounterPlacement{recipients:Objects(One($shared_counter_recipient)), kind:$counter_kind, amount:Constant(1)} */
shared_single_counter_placement ::= "a" counter_kind "counter" "on" shared_counter_recipient

/* @sem CounterPlacement::CounterPlacement{recipients:Objects(One($shared_counter_recipient)), kind:$counter_kind, amount:$count_plural} */
shared_multiple_counter_placement ::= count_plural counter_kind "counters" "on" shared_counter_recipient

shared_counter_recipient ::= shared_your_ring_bearer | object_ref

/* @sem ObjectRef::RingBearer(AbilityController) */
shared_your_ring_bearer ::= "your" "Ring-bearer"

/* @sem Operation::PutCounters{placements:[$shared_owned_counter_placement]} */
shared_you_put_counters ::= "you" "put" shared_owned_counter_placement

/* The damage and its conditional consumer share the actual result. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$self_ref_holder, recipients:Objects(One($it_ordinary_pronoun)), amount:$number, preventable:true}}, If{condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([DamagedBy(@prior), $filter_phrase])}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$conjoined}, otherwise:Program{}}] */
instructions_holder_damage_filtered_condition ::= self_ref_holder "deals" number "damage" "to" it_ordinary_pronoun "." "if" "a" filter_phrase "is" "dealt" "damage" "this" "way" "," conjoined

tap_object_set ::= tap_existing_objects | tap_qualified_attacker_target

/* @sem ObjectSet::$object_set */
tap_existing_objects ::= object_set

/* A tap target may combine any singular head with this combat qualifier. */
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($filter_nonlist_head, $modifier_without_keyword_attacking_you)}), index:0}) */
tap_qualified_attacker_target ::= "target" filter_nonlist_head modifier_without_keyword_attacking_you

/* The destination and the counter-bearing former object are separate operands. */
/* @sem Operation::Move{objects:$affected, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Subtract(CountCounters(_{recipients:Objects($affected_2), kind:$counter_kind, information:CurrentOrLastKnown}), $n1)]], states:[]}}, qualifiers:[]} */
return_with_fewer_counters ::= "return" affected "to" "the" "battlefield" "with" n1 "fewer" counter_kind "counter" "on" affected

/* @sem Operation::Move{objects:$affected, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Subtract(CountCounters(_{recipients:Objects($affected_2), kind:$counter_kind, information:CurrentOrLastKnown}), $count_plural)]], states:[]}}, qualifiers:[]} */
return_with_fewer_counters_plural ::= "return" affected "to" "the" "battlefield" "with" count_plural "fewer" counter_kind "counters" "on" affected

/* The permission consumes the same single face-up library exile receipt. */
/* @sem Program::Program{instructions:[...$card_exile_value_producer, ...$fronted_single_free_play]} */
fronted_single_free_play_program ::= card_exile_value_producer "." fronted_single_free_play

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(SpecialAction{body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:Either, cards:One(Result{result:@marked, phase:After, index:0}), count:Exactly(Constant(1)), cost:Free}}]}, limit:EachTurn(1)})], duration:$duration, evaluation:LiveObjects}}] */
fronted_single_free_play ::= duration "," "you" "may" "play" "that" "card" "without" "paying" "its" "mana" "cost"

/* Repeated mana and the distinct-power population are independently typed. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:$count_each_different_power, production:$mana_referenced_color_amount, choice:Once}} */
add_mana_per_distinct_power ::= "add" mana_referenced_color_amount "for" "each" count_each_different_power

/* @sem ManaProduction::Amount{color:Chosen, amount:$value} */
mana_referenced_color_amount ::= value "mana" "of" "that" "color"

/* Compose the source-intensity damage action with the owned-card action. */
/* @sem Instruction::[Effect{result:@next, operation:$deal_damage_own_intensity}, Effect{result:@next, operation:$intensify_owned_subtype_cards}] */
instructions_intensity_damage_and_intensify ::= deal_damage_own_intensity "." NEWLINE intensify_owned_subtype_cards

/* The missing kinds are measured on the recipient; the source is separately selected. */
/* @sem Operation::MoveCounters{actor:One(AbilityController), from:One($target_another), to:One(Source), amount:OneOfEachKindMissing} */
transfer_missing_kinds_to_named_source ::= "move" "a" "counter" "of" "each" "kind" "not" "on" SELF_NAME "from" target_another "onto" SELF_NAME

/* Conditional replacement of a complete action or search episode. Search
   selections remain grouped so their result references stay in their branch. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$conditional_instead_instruction}} */
shared_conditional_instead_spell ::= conditional_instead_instruction "."

conditional_instead_instruction ::= conditional_instead_standard | conditional_instead_receipt_replacement

conditional_instead_branch ::= conditional_instead_search | conditional_instead_action | conditional_instead_pair | conditional_instead_no_regeneration

/* @sem Program::Program{instructions:$clause_search} */
conditional_instead_search ::= clause_search

/* @sem Program::Program{instructions:$clause_operation} */
conditional_instead_action ::= clause_operation

/* @sem Program::Program{instructions:[...$clause_operation, ...$clause_operation_2]} */
conditional_instead_pair ::= clause_operation "and" clause_operation

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Destroy{objects:One($destroy_singular_creature), regeneration:false}}]} */
conditional_instead_no_regeneration ::= "destroy" destroy_singular_creature "." "it" "can't" "be" "regenerated"

/* The entry subject deals damage before its controller gains life. The two
   amounts and recipient remain independent operands. */
/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Not(SameObject(Source))})) */
entry_damage_other_target ::= "any" "other" "target"

entry_damage_recipient ::= entry_damage_other_target | recipients

/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:$entry_damage_recipient, amount:$number, preventable:true}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:$number_2}}]} */
entry_subject_damage_gain_life ::= "it" "deals" number "damage" "to" entry_damage_recipient "and" "you" "gain" number "life"

/* @sem Ability::Triggered{event:$event_self_enters, limits:TriggerLimits{}, announcement:@announcement, body:$entry_subject_damage_gain_life} */
triggered_entry_subject_damage_gain_life ::= "when" event_self_enters "," entry_subject_damage_gain_life "."

/* The possessive subject supplies both the sacrificing controller and object. */
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(ControllerOf($sacrifice_possessive_object)), objects:One($sacrifice_possessive_object)}) */
attached_controller_sacrifice ::= sacrifice_possessive_object "controller" "sacrifices" "it"

sacrifice_possessive_object ::= enchanted_possessive_permanent | sacrificed_possessive_target

/* @sem ObjectRef::AttachedTo(Source) */
enchanted_possessive_permanent ::= "enchanted" "permanent's"

/* Any event may lead to the controller sacrificing that same object. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$attached_controller_sacrifice}]}} */
triggered_controller_sacrifice ::= event_clause "," attached_controller_sacrifice "."

/* The condition tests the same announced target as the move.  The relative
   attacking phrase is confined to this clause, rather than broadening every
   modified noun or changing the default wording of existing effects. */
/* @sem Instruction::[If{condition:ObjectMatches{object:$conditional_attacker_target, filter:ControlledBy(One($conditional_controller))}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:One($conditional_attacker_target), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]}, otherwise:Program{}}] */
clause_conditional_target_controller_exile ::= "exile" conditional_attacker_target "if" "it's" "controlled" "by" conditional_controller

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, AttackingDefender(Players(One(AbilityController)))])}), index:0} */
conditional_attacker_target ::= "target" noun "that's" "attacking" "you"

conditional_controller ::= conditional_controller_chosen | conditional_controller_you

/* @sem PlayerRef::Chosen */
conditional_controller_chosen ::= "the" "chosen" "player"

/* @sem PlayerRef::AbilityController */
conditional_controller_you ::= "you"

/* The delayed return consumes only this exile movement's recorded arrivals. */
/* @sem Instruction::[Effect{result:@mark, operation:$target_owned_cards_exile}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:One(Target{slot:0, index:0})}, start:PlayersNextTurn(Target{slot:0, index:0}), body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}}] */
instructions_target_exile_next_turn_return ::= target_owned_cards_exile "." "at" "the" "beginning" "of" "the" "end" "step" "of" "that" "player's" "next" "turn" "," "that" "player" "returns" "those" "cards" "to" "their" "hand"

/* @sem Operation::Move{objects:Zone{scope:Players{zone:$hand_exile_zone, players:One($target_player_ref)}, kind:Card, filter:$hand_exile_card_filter}, destination:Exile{visibility:$hand_exile_visibility, arrival:ExileArrival{}}, qualifiers:[]} */
target_owned_cards_exile ::= target_player_ref "exiles" "all" hand_exile_card_filter "from" "their" hand_exile_zone hand_exile_visibility

/* A single owned library card supplies the marked exile arrival for both
   the permission and the delayed cleanup. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, count:Constant(1), from:$ordered_end}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
owned_ordered_card_exile ::= "exile" "the" ordered_end filter_phrase "card" "of" "your" "library"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:CastSpell, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}] */
marked_exiled_card_cast ::= "you" "may" "cast" "that" "card" this_duration

/* These two phrases refer to the same marked owned-card arrival. */
/* @sem Condition::Compare{left:CountObjects(InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
marked_card_still_exiled ::= "that" "card" "is" "still" "exiled"

/* @sem Operation::Move{objects:InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]} */
marked_owned_card_to_graveyard ::= "put" "it" "into" "your" "graveyard"

/* @sem Operation::CreateDelayedTrigger{event:$conjured_next_end, start:Immediately, intervening_if:$marked_card_still_exiled, body:_{instructions:[Effect{result:@next, operation:$marked_owned_card_to_graveyard}, Effect{result:@next, operation:$operation}]}} */
marked_exiled_card_cleanup ::= "at" conjured_next_end "," "if" marked_card_still_exiled "," marked_owned_card_to_graveyard "and" operation

/* @sem Instruction::[...$owned_ordered_card_exile, ...$marked_exiled_card_cast, Effect{result:@next, operation:$marked_exiled_card_cleanup}] */
instructions_owned_exile_cast_cleanup ::= owned_ordered_card_exile "." marked_exiled_card_cast "." marked_exiled_card_cleanup

/* A top matching card keeps its filter and controller as current operands. */
/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, count:Constant(1), from:Top}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_top_filtered_graveyard_battlefield ::= "return" "the" "top" filter_phrase "card" "of" "your" "graveyard" "to" "the" "battlefield"

/* Sequence an immediate clause with a filtered top-card return. */
/* @sem Instruction::[Effect{result:@next, operation:$return_top_filtered_graveyard_battlefield}] */
clause_top_filtered_graveyard_return ::= return_top_filtered_graveyard_battlefield

/* @sem Vec<Instruction>::@then_sequence($clause_before_then, $clause_top_filtered_graveyard_return) */
instructions_then_top_graveyard_return ::= clause_before_then "," "then" clause_top_filtered_graveyard_return

/* A die table over one explicit exile receipt. Keeping the producer in this
   program proves that the selected and counted arrivals were exiled. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:$roll_die_action}, ...$exile_receipt_die_rows]} */
program_exile_receipt_die_table ::= exile_top_cards_of_your_library "," "then" roll_die_action "." NEWLINE exile_receipt_die_rows

exile_receipt_die_rows ::= exile_receipt_die_rows_one | exile_receipt_die_rows_more

/* @sem Instruction::[$exile_receipt_die_row] */
exile_receipt_die_rows_one ::= exile_receipt_die_row

/* @sem Instruction::[$exile_receipt_die_row, ...$exile_receipt_die_rows] */
exile_receipt_die_rows_more ::= exile_receipt_die_row NEWLINE exile_receipt_die_rows

exile_receipt_die_row ::= exile_receipt_die_range | exile_receipt_die_exact

/* @sem Instruction::If{condition:AllOf([Compare{left:DieResult(@die_roll), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, Compare{left:DieResult(@die_roll), test:NumberTest::Compare{comparison:LessOrEqual, value:$number_2}}]), then:$exile_receipt_die_body, otherwise:Program{}} */
exile_receipt_die_range ::= number "―" number "|" exile_receipt_die_body

/* @sem Instruction::If{condition:Compare{left:DieResult(@die_roll), test:NumberTest::Compare{comparison:Equal, value:$number}}, then:$exile_receipt_die_body, otherwise:Program{}} */
exile_receipt_die_exact ::= number "|" exile_receipt_die_body

exile_receipt_die_body ::= exile_receipt_optional_put | exile_receipt_token_counters | program_linked_exile_put_sacrifice

/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$noun, InSet(Transition{result:@marked, phase:After})])}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}]}}]} */
exile_receipt_optional_put ::= "you" "may" "put" "a" noun "card" "from" "among" "those" "cards" "onto" "the" "battlefield" "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:$singular_counted_token_recipe}], entry:BattlefieldArrival{}}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@prior)), kind:$counter_kind, amount:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$noun})}]}}]} */
exile_receipt_token_counters ::= "create" "a" singular_counted_token_recipe "," "then" "put" "a" counter_kind "counter" "on" "it" "for" "each" noun "card" "among" "those" "cards" "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:@zone_members($linked_exiled_permanent_cards), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:One(Source), choose:None}}]} */
program_linked_exile_put_sacrifice ::= "put" linked_exiled_permanent_cards "onto" "the" "battlefield" "," "then" "sacrifice" "it" "."

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]), ExiledWith($self_explicit_ref)])} */
linked_exiled_permanent_cards ::= "all" "permanent" "cards" "exiled" "with" self_explicit_ref

/* Keep the extra turn and its skipped section in the same scoped instruction. */
/* @sem Instruction::[Effect{result:@next, operation:$take_extra_turn}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Skip($choice_turn_section))], duration:ExtraTurn(0), evaluation:LiveObjects}}] */
extra_turn_skipped_section_instructions ::= take_extra_turn "." "skip" "the" choice_turn_section "of" "that" "turn"

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$extra_turn_skipped_section_instructions}} */
triggered_extra_turn_skipped_section ::= event_clause "," extra_turn_skipped_section_instructions "."

/* Mana repetitions compose the production with the controlled name count. */
/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:$count_each_other_controlled_same_name, production:$mana_production, choice:Once}} */
add_mana_for_same_name ::= "add" ("an" "additional")? mana_production "for" "each" count_each_other_controlled_same_name

/* The stat expressions refer to the qualifying card from this one-card reveal.
   Keep the producer, consumer and observed-card reorder in one scope. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$reveal_until_single_card, count:Constant(1)}}, Effect{result:@next, operation:$revealed_card_leading_stats}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:$library_order}}] */
revealed_card_stat_reorder ::= reveal_until_your_library reveal_until_single_card "." revealed_card_leading_stats "." "put" "the" "revealed" "cards" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_possessive)), changes:$revealed_card_stat_changes, duration:$duration, evaluation:Snapshot} */
revealed_card_leading_stats ::= duration "," self_possessive revealed_card_stat_changes

/* @sem Change::[SetPower($revealed_card_stat_value), SetToughness($revealed_card_stat_value_2)] */
revealed_card_stat_changes ::= "base" "power" "becomes" revealed_card_stat_value "and" "its" "base" "toughness" "becomes" revealed_card_stat_value

revealed_card_stat_value ::= revealed_card_stat_twice | revealed_card_stat_measure | value_constant

/* @sem @times(Expr::Constant(2), $revealed_card_stat_measure) */
revealed_card_stat_twice ::= "twice" revealed_card_stat_measure

/* @sem Expr::Earlier{what:Revealed, measure:Of($receipt_stat)} */
revealed_card_stat_measure ::= "that" "card's" receipt_stat

/* A voluntary resource payment and its dependent draw share the payment receipt. */
/* @sem Cost::Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PayAnyAmount{actor:One(AbilityController), resource:$payment_resource}}]}}]} */
any_resource_payment ::= "pay" "any" "amount" "of" payment_resource

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$any_resource_payment, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:Draw{players:$paid_amount_draw_recipient, amount:Performed(@marked)}}]}, otherwise:Program{}}] */
clause_optional_resource_payment_draw ::= "you" "may" any_resource_payment "." "if" "you" "do" "," paid_amount_draw_recipient "that" "many" "cards"

/* @prefer always */
/* @sem PlayerSet::One(AbilityController) */
paid_amount_draw_implicit ::= "draw"

paid_amount_draw_recipient ::= paid_amount_draw_implicit | draw_receipt_you

/* A player selects from their own hand; the marked selection survives the look. */
/* @sem Operation::ChooseObjects{player:$target_player_ref, objects:Zone{scope:Players{zone:Hand, players:One($target_player_ref)}, kind:Card, filter:Any}, count:AsManyAsCan($hand_choice_plural_amount)} */
selected_hand_cards_choice ::= target_player_ref "chooses" hand_choice_plural_amount "cards" "from" "their" "hand"

hand_choice_plural_amount ::= number_x | count_plural

/* @sem Operation::LookAt{player:AbilityController, objects:Selected(@marked)} */
look_at_marked_choice ::= "look" "at" "those" "cards"

free_cast_marked_choice ::= free_cast_marked_choice_one | free_cast_marked_choice_many

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Selected(@marked), filter:Any}, count:UpTo(Constant(1)), cost:Free} */
free_cast_marked_choice_one ::= "you" "may" "cast" "a" "spell" "from" "among" "them" "without" "paying" "its" "mana" "cost"

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Selected(@marked), filter:Any}, count:UpTo($count_plural), cost:Free} */
free_cast_marked_choice_many ::= "you" "may" "cast" "up" "to" count_plural "spells" "from" "among" "them" "without" "paying" "their" "mana" "costs"

/* @sem Instruction::[Effect{result:@mark, operation:$selected_hand_cards_choice}, Effect{result:@next, operation:$look_at_marked_choice}, Effect{result:@next, operation:$free_cast_marked_choice}] */
instructions_hand_choice_look_free_cast ::= selected_hand_cards_choice "." look_at_marked_choice "." free_cast_marked_choice

/* The chosen hand card is the object both guessed about and cast; keep the
   producer and consumer in one scope across the intervening guess. */
/* @sem Instruction::[Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Guess{actor:$players_singular, object:Result{result:@marked, phase:After, index:0}, filter:$guess_card_property}}, If{condition:Outcome(GuessedWrong), then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Result{result:@marked, phase:After, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}]}, otherwise:Program{}}] */
instructions_chosen_hand_guess_wrong_cast ::= "choose" "a" "card" "in" "your" "hand" "." players_singular "guesses" "whether" "the" "card's" guess_card_property "." "if" "the" "player" "guessed" "wrong" "," "you" "may" "cast" "the" "card" "without" "paying" "its" "mana" "cost"

/* The exile and both uses of its single-card receipt form one scoped contract. */
/* @sem Instruction::[...$card_exile_value_producer, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($self_ref_holder)), changes:[Pump{power:Aggregate{objects:Transition{result:@marked, phase:After}, property:ManaValue, aggregation:Sum}, toughness:$signed_literal}], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}] */
instructions_exile_top_value_pump_permission ::= card_exile_value_producer "." self_ref_holder "gets" "+" "X" "/" signed_literal duration "," "where" "X" "is" "that" "card's" "mana" "value" "." "you" "may" "play" "that" "card" this_duration

/* Both alternatives share the same announced optional target. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[_{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:AllOf([Not(SameObject(Source)), $noun])}), index:0})), kind:$counter_plus, amount:Constant(1)}]}}]}, _{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:0, index:0})), kind:$counter_name, amount:@plural_amount($number)}]}}]}]}] */
instructions_choice_counters_other_target ::= "put" "your" "choice" "of" "a" counter_plus "counter" "or" number counter_name "counters" "on" "up" "to" "one" "other" "target" noun

/* Both mentions describe the announced pair; the chosen member is the exile input. */
/* @sem Vec<Instruction>::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(2)), filter:@agree($plural, $plural_2), constraints:[CommonProperty(Controllers)]})), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
common_controller_pair_exile_choice ::= "choose" "two" "target" plural "controlled" "by" "the" "same" "player" "." "exile" "one" "of" "those" plural

/* This continuation is scoped to the preceding pair choice and exile. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Targets(@last_slot)), kind:$counter_kind, amount:$value}]} */
remaining_pair_counters_plural ::= "put" value counter_kind "counters" "on" "the" "other"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$common_controller_pair_exile_choice, Effect{result:@next, operation:$remaining_pair_counters_plural}]}} */
spell_common_controller_pair_exile_counters ::= common_controller_pair_exile_choice "and" remaining_pair_counters_plural "."

/* Announce a permanent target before an independent action, then test that same target. */
/* @sem Vec<Instruction>::[Effect{result:@next, operation:$operation_imperative}, If{condition:ObjectMatches{object:$target_permanent, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$chosen_target_graveyard_count}}}, then:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One(Target{slot:@last_slot, index:0}), regeneration:true}}]}, otherwise:Program{}}] */
chosen_target_action_destroy_mana_ceiling ::= "choose" target_permanent "." operation_imperative "," "then" "destroy" "the" "chosen" "permanent" "if" "its" "mana" "value" "is" "less" "than" "or" "equal" "to" chosen_target_graveyard_count

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$chosen_target_action_destroy_mana_ceiling}} */
spell_chosen_target_action_destroy_mana_ceiling ::= chosen_target_action_destroy_mana_ceiling "."

/* @sem Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$graveyard_counted_cards}) */
chosen_target_graveyard_count ::= "the" "number" "of" graveyard_counted_cards "in" "your" "graveyard"

/* The player losing life also owns the counted exiled cards. */
/* @sem Instruction::[Effect{result:@next, operation:LoseLife{players:One($defending_player), amount:CountObjects(Zone{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(One($defending_player)), Counters{kind:$counter_name, comparison:Greater, value:Constant(0)}])})}}] */
clause_defender_loss_owned_counter_exile ::= defending_player "loses" "1" "life" "for" "each" "card" "they" "own" "in" "exile" "with" "a" counter_name "counter" "on" "it"

/* The counted arrivals are produced by this exact exile action. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$exile_target_players_graveyard}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:CountObjects(Matching{objects:Transition{result:@prior, phase:After}, filter:$filter_phrase})}]}}] */
instructions_graveyard_exile_filtered_counters ::= exile_target_players_graveyard "." "put" "a" counter_kind "counter" "on" affected "for" "each" filter_phrase "card" "exiled" "this" "way"

/* The event player and the amount compose independently for counter placement. */
/* @sem Recipients::Players(One(EventSubject)) */
event_counter_recipient ::= "they"

/* @sem Expr::EventAmount */
event_counter_amount ::= "that" "many"

counter_receipt_amount ::= value | event_counter_amount

/* @sem Operation::PutCounters{placements:[_{recipients:$event_counter_recipient, kind:$counter_kind, amount:$counter_receipt_amount}]} */
event_player_get_counters ::= event_counter_recipient "get" counter_receipt_amount counter_kind "counters"

/* The announced objects are shuffled into their owners' libraries. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$each_player_distinct_negative_targets, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_each_player_choose_shuffle ::= each_player_distinct_negative_targets "." "those" "permanents'" "owners" "shuffle" "them" "into" "their" "libraries"

/* The acting player separates that same player’s controlled permanent population. */
/* @sem Operation::Piles{actor:One(Bound(0)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}, count:$controlled_pile_count} */
bound_separates_controlled_piles ::= "separates" "the" filter_plural "they" "control" "into" controlled_pile_count "piles"

controlled_pile_count ::= controlled_pile_count_words | value

/* @prefer always */
/* @sem $count_plural */
controlled_pile_count_words ::= count_plural

/* The conditional receipt is scoped to the preceding face-up exile move. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
exile_single_graveyard_receipt_condition ::= "at" "least" "one" filter_phrase "card" "was" "exiled" "this" "way"

/* @sem Vec<Instruction>::[Effect{result:@mark, operation:$exile_single_graveyard_targets}, If{condition:$exile_single_graveyard_receipt_condition, then:Program{instructions:$instructions}, otherwise:Program{}}] */
instructions_exile_single_graveyard_if_first ::= exile_single_graveyard_targets "." "if" exile_single_graveyard_receipt_condition "," instructions

/* @sem Vec<Instruction>::[Effect{result:@mark, operation:$exile_single_graveyard_targets}, If{condition:$exile_single_graveyard_receipt_condition, then:Program{instructions:$instructions}, otherwise:Program{}}] */
instructions_exile_single_graveyard_if_last ::= exile_single_graveyard_targets "." instructions "if" exile_single_graveyard_receipt_condition

/* The measured spell is the cast event's subject. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:ManaSpent{object:EventSubject, filter:_{}, aggregation:Count}}]} */
put_cast_spending_counters ::= "put" "a" "number" "of" counter_kind "counters" "on" affected "equal" "to" "the" "amount" "of" "mana" "spent" "to" "cast" "that" "spell"

/* The tested counter kind and object identify the counters removed. */
/* @sem Instruction::[If{condition:ObjectMatches{object:$object_ref, filter:Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:$value})}, then:Program{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($object_ref)), kind:$counter_kind, amount:All}]}}, Effect{result:@next, operation:$operation}]}, otherwise:Program{}}] */
counter_threshold_remove_them_and ::= "if" object_ref "has" value "or" "more" counter_kind "counters" "on" "it" "," "remove" "them" "and" operation

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$put_cast_spending_counters}, ...$counter_threshold_remove_them_and]} */
cast_spending_counters_then_threshold ::= put_cast_spending_counters "." "then" counter_threshold_remove_them_and "."

/* A single card matching either printed alternative is exiled from the controller’s hand. */
/* @sem Cost::Cost{parts:[Move{selections:[_{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AnyOf([$filter_phrase, $filter_phrase_2])}, choose:Exactly($counter_amount)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]} */
payment_exile_hand_alternatives ::= "exile" counter_amount filter_phrase "card" "or" "a" filter_phrase "card" "from" "your" "hand"

/* The bounded graveyard exile and both life effects share one arrival receipt. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:UpTo($count_plural), filter:Any})) */
exile_graveyard_up_to_plural_targets ::= "up" "to" count_plural "target" "cards" "from" "graveyards"

/* @sem Vec<Instruction>::[Effect{result:@next, operation:LoseLife{players:$players_singular, amount:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase})}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase})}}] */
exile_receipt_filtered_drain ::= "for" "each" filter_phrase "card" "exiled" "this" "way" "," players_singular "loses" "1" "life" "and" "you" "gain" "1" "life"

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Move{objects:$exile_graveyard_up_to_plural_targets, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, ...$exile_receipt_filtered_drain]} */
exile_graveyard_filtered_drain_program ::= "exile" exile_graveyard_up_to_plural_targets "." exile_receipt_filtered_drain "."

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$exile_graveyard_filtered_drain_program} */
triggered_exile_graveyard_filtered_drain ::= event_clause "," exile_graveyard_filtered_drain_program

/* A battlefield population combining two independently described kinds. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([$filter_plural, $filter_phrase])} */
exile_battlefield_union ::= "all" filter_plural "and" filter_phrase

/* An immediate action and a separately timed return retain their own results. */
/* @sem Program::Program{instructions:[...$clause_you, Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_move_end_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:$delayed_graveyard_self_move}]}}}]} */
immediate_then_delayed_self_return ::= clause_you "," "and" "you" delayed_graveyard_self_move "at" delayed_move_end_event "."

/* The delayed return consumes this source exile's arrival; the combat rule
   applies to the returned arrival, within the same delayed program. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$exile_explicit_self}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:DeclareAttackersStepBegins, players:One(OwnerOf(Source))}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@back(3), phase:After}, zone:Exile}, destination:Battlefield{controller:Owner, arrival:$owner_combat_return_arrival}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Transition{result:@prior, phase:After}), changes:$returned_combat_restriction, duration:EndOfCombat, evaluation:LiveObjects}}]}}}]} */
program_exile_self_owner_combat_return ::= exile_explicit_self "." "return" "it" "to" "the" "battlefield" "under" "its" "owner's" "control" owner_combat_return_arrival "at" "the" "beginning" "of" "that" "player's" "next" "declare" "attackers" "step" "." returned_combat_restriction "."

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:true, states:[Attacking{}]} */
owner_combat_return_arrival ::= "tapped" "and" "attacking"

/* @sem Vec<Change>::[Rule(Prohibit(BeBlocked(Any)))] */
returned_combat_restriction ::= "it" "can't" "be" "blocked" "that" "combat"

/* Capture a defined quantity before placing counters. */
/* @sem Instruction::[Effect{result:@mark, operation:BindValue{value:$value}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:BoundValue(@marked)}]}}] */
captured_counter_placement ::= "put" "X" counter_kind "counters" "on" affected "," "where" "X" "is" value

/* The follow-up is a separate effect on the previously referenced object. */
/* @sem Program::Program{instructions:[...$captured_counter_placement, Effect{result:@next, operation:$retained_type_followup}]} */
program_captured_counter_retained_type ::= captured_counter_placement "." retained_type_followup

owner_transformed_entry ::= entry_transformed | entry_converted | entry_transformed_tapped

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[], states:[Transformed]} */
entry_converted ::= "converted"

/* A subsequent one-shot copy is described as additional only in a paired sequence. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:$spell_filter}, duration:$this_duration, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:May}}]}, once:true}}] */
next_cast_additional_copy ::= "when" "you" "next" "cast" spell_filter this_duration "," "copy" "that" "spell" "an" "additional" "time" "." "you" "may" "choose" "new" "targets" "for" "the" "copy"

/* The creature and its controller share the announced target; both amounts retain their operands. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamageParts{source:$damage_source_ref, parts:[_{recipients:Objects(One($chosen_split_creature)), amount:ChosenNumber}, _{recipients:Players(One(ControllerOf(Target{slot:@last_slot, index:0}))), amount:Subtract([$number, ChosenNumber])}], preventable:true}}] */
clause_damage_chosen_remainder ::= damage_source_ref "deals" "X" "damage" "to" chosen_split_creature "and" number "minus" "X" "damage" "to" "that" "creature's" "controller" "," "where" "X" "is" "the" "chosen" "number"

/* A creature antecedent is required by the controller anaphor. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:$excess_damage_creature}), index:0} */
chosen_split_creature ::= "target" excess_damage_creature

/* Exile each opponent's separately owned target, then mark the actual arrivals. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:AnyNumber, filter:AllOf([$filter_phrase, OwnedBy(OpponentsOf(AbilityController))]), constraints:[DifferentOwners]})), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Transition{result:@prior, phase:After}), kind:$counter_kind, amount:Constant(1)}]}}] */
clause_opponent_graveyard_exile_counter ::= "for" "each" "opponent" "," "exile" "up" "to" "one" "target" filter_phrase "card" "from" "that" "player's" "graveyard" "and" "put" "a" counter_kind "counter" "on" "it"

/* The discarded card remains tied to its discard-event frame. */
discarded_event_graveyard_ref ::= discarded_third_graveyard_card | discarded_third_named_graveyard_card

/* @sem ObjectRef::Query{objects:InZone{objects:One(Discarded), zone:Graveyard}, index:0} */
discarded_third_graveyard_card ::= "it" "from" "their" "graveyard"

/* @sem ObjectRef::Query{objects:InZone{objects:One(Discarded), zone:Graveyard}, index:0} */
discarded_third_named_graveyard_card ::= "that" "card" "from" "their" "graveyard"

/* A singular counter travels with the discarded card into exile. */
/* @sem Operation::Move{objects:One($discarded_event_graveyard_ref), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[[$counter_kind, Constant(1)]], states:[]}}, qualifiers:[]} */
exile_discard_event_card_with_counter ::= "exile" discarded_event_graveyard_ref "with" "a" counter_kind "counter" "on" "it"

/* @sem Ability::Triggered{event:$event_discard_third, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$exile_discard_event_card_with_counter}]}} */
triggered_third_discard_exile_counter ::= "whenever" event_discard_third "," exile_discard_event_card_with_counter "."

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Letter, terms:_{count:Exactly(Constant(1)), options:[]}} */
choose_a_letter ::= "choose" "a" "letter"

/* The chosen target remains the object moved with its arrival counter. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[[$counter_kind, $counter_a]], states:[]}}, qualifiers:[]}}] */
instructions_choose_exile_arrival_counter ::= "choose" target_card "." "exile" "it" "with" counter_a counter_kind "counter" "on" "it"

/* @prefer always */
/* @sem () */
counter_removal_them_all ::= "remove" "them" "all"

/* @sem () */
counter_removal_them_bare ::= "remove" "them"

counter_removal_them_words ::= counter_removal_them_all | counter_removal_them_bare

/* The event player makes the required sacrifice and suffers its failure. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:EventSubject, cost:$choice_sacrifice_cost, optional:false}}, If{condition:Not(PaymentChosen(@marked)), then:$event_player_villainous_loss, otherwise:Program{}}]} */
event_player_required_sacrifice_loss ::= "that" "player" choice_sacrifice_cost "." "if" "the" "player" "can't" "," event_player_villainous_loss

/* The turn event supplies the player referred to by the sacrifice program. */
/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$event_player_required_sacrifice_loss} */
triggered_turn_player_required_sacrifice_loss ::= "at" turn_event "," event_player_required_sacrifice_loss "."

/* A mixed-zone owner move creates an independent target in each mode. The
   graveyard qualifier and the owner's destination are shared operands. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:Any}), index:0}), destination:$owner_library_choice_destination, qualifiers:[]}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$adjective_nontype}), index:0}), destination:$owner_library_choice_destination, qualifiers:[]}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:$mixed_owner_graveyard_filter}), index:0}), destination:$owner_library_choice_destination, qualifiers:[]}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied} */
mixed_owner_move_modes ::= "the" "owner" "of" "target" "spell" "," adjective_nontype "permanent" "," "or" "card" "in" mixed_owner_graveyard_filter "puts" "it" owner_library_choice_destination

/* @sem ObjectFilter::Any */
mixed_owner_any_graveyard ::= "a" "graveyard"

/* @sem ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}) */
/* @prefer always */
mixed_owner_your_graveyard ::= "your" "graveyard"

mixed_owner_graveyard_filter ::= mixed_owner_any_graveyard | mixed_owner_your_graveyard | mixed_owner_a_controller_graveyard

/* @sem Ability::Spell{announcement:Announcement{modes:$mixed_owner_move_modes}, body:Program{}} */
spell_mixed_owner_move ::= mixed_owner_move_modes "."

/* A spell may use the same bounded face-down exile receipt program as a trigger. */
/* @sem Ability::Spell{announcement:@announcement, body:$face_down_exile_look_play_program} */
spell_face_down_exile_look_play ::= face_down_exile_look_play_program

/* @prefer always */
/* @sem MovementDestination::Library{position:TopOrBottom{chooser:Players(One(AbilityController))}, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
countered_library_your_choice ::= "put" "that" "card" "on" "your" "choice" "of" "the" "top" "or" "bottom" "of" "its" "owner's" "library" "instead" "of" "into" "that" "player's" "graveyard"

/* Both reveal receipts are scoped to this two-player comparison. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, Effect{result:@next, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($target_opponent)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:Aggregate{objects:Matching{objects:Recorded(@prior), filter:OwnedBy(One(Target{slot:0, index:0}))}, property:$stat, aggregation:Sum}}}, Effect{result:@next, operation:LoseLife{players:One(Target{slot:0, index:0}), amount:Aggregate{objects:Matching{objects:Recorded(@marked), filter:OwnedBy(One(AbilityController))}, property:$stat, aggregation:Sum}}}] */
instructions_controller_opponent_reveal_loss ::= "you" "and" target_opponent "each" "reveal" "the" "top" "card" "of" "your" "library" "." "you" "each" "lose" "life" "equal" "to" "the" stat "of" "the" "card" "revealed" "by" "the" "other" "player"

/* The life-loss comparison does not move either top card. */
/* @sem Instruction::[...$instructions_controller_opponent_reveal_loss, Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Target{slot:0, index:0})}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_controller_opponent_reveal_loss_hand ::= instructions_controller_opponent_reveal_loss "." "you" "each" "put" "the" "card" "you" "revealed" "into" "your" "hand"

/* The controller chooses the end; the library still belongs to the moved object. */
/* @sem Operation::Move{objects:$affected, destination:Library{position:TopOrBottom{chooser:Players(One(AbilityController))}, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
put_affected_controller_choice_library ::= "put" affected "on" "your" "choice" "of" "the" "top" "or" "bottom" "of" "its" "owner's" "library"

/* The second sentence refers to the named copy subject, not the copy model. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$copy_named_source_leading_duration}, Effect{result:@next, operation:$prevent_damage_to_him_this_duration}]} */
program_named_source_copy_prevention ::= copy_named_source_leading_duration "." prevent_damage_to_him_this_duration "."

/* The recipient is the triggering player, independent of the ability controller. */
/* @sem Instruction::[Effect{result:@next, operation:AddPhases{actor:One(EventSubject), phases:$additional_step_kind, count:Expr::Constant(1)}}] */
clause_event_subject_extra_step_one ::= "that" "player" "gets" "an" "additional" additional_step_kind "step" "after" "this" "step"

/* @sem Instruction::[Effect{result:@next, operation:AddPhases{actor:One(EventSubject), phases:$additional_step_kind, count:$count_plural}}] */
clause_event_subject_extra_steps ::= "that" "player" "gets" count_plural "additional" additional_step_kind "steps" "after" "this" "step"

/* Repeat the complete bound-player process, preserving its payment choice. */
/* @sem Program::Program{instructions:[RepeatableWithLimit{amount:$number, body:Program{instructions:[...$counter_loop_player_body, Effect{result:@next, operation:RepeatProcess}]}}]} */
repeat_following_player_process ::= "repeat" "the" "following" "process" number "times" "." counter_loop_player_body

/* @sem Ability::Spell{announcement:@announcement, body:$repeat_following_player_process} */
spell_repeat_following_player_process ::= repeat_following_player_process "."

/* Each player returns cards from their own graveyard to their owners' hands. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:$filter_phrase}, destination:OwnersHand(CardArrival{}), qualifiers:[]}}]}}] */
clause_players_return_own_graveyard_hand ::= players_singular "returns" "all" filter_phrase "cards" "from" "their" "graveyard" "to" "their" "hand"

/* The choice and revelation establish the revealed-number context. The
   explicit lower bound remains part of each player's choice. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseValue{choosers:One(Bound(0)), kind:Number, terms:_{options:$secret_number_bounds, count:Exactly(Constant(1)), secret:true}}}]}}, Effect{result:@next, operation:RevealChoices{kind:Number}}] */
secret_numbers_reveal_extremes ::= "each" "player" "secretly" "chooses" secret_number_bounds "," "then" "all" "players" "reveal" "those" "numbers" "simultaneously" "and" "determine" "the" "highest" "and" "lowest" "numbers" "revealed" "this" "way"

/* These consumers are used in the revealed-number scope below. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Players(Matching{binding:0, condition:ChoseExtreme{player:Bound(0), highest:true}}), amount:AmongPlayers{players:All, number:ChosenNumber, aggregation:Maximum}, preventable:true}}] */
revealed_highest_damage ::= self_explicit_ref "deals" "damage" "equal" "to" "the" "highest" "number" "to" "each" "player" "who" "chose" "that" "number"

/* @sem PlayerSet::Matching{binding:0, condition:Not(PlayerIn{player:Bound(0), players:Matching{binding:1, condition:ChoseExtreme{player:Bound(1)}}})} */
players_not_lowest_revealed ::= "each" "player" "who" "didn't" "choose" "the" "lowest" "number"

/* @sem Instruction::[ForEachPlayer{players:$players_not_lowest_revealed, binding:0, body:_{instructions:[Effect{result:@next, operation:Discard{players:One(Bound(0)), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any})}}]}}, Effect{result:@next, operation:Draw{players:$players_not_lowest_revealed, amount:$revealed_draw_count}}] */
revealed_nonlowest_hand_wheel ::= players_not_lowest_revealed "discards" "their" "hand" "," "then" "draws" revealed_draw_count

revealed_draw_count ::= card_count_one | card_count_many

/* Scope both consumers to the immediately preceding revealed choices. */
/* @sem Ability::Spell{body:_{instructions:[...$secret_numbers_reveal_extremes, ...$revealed_highest_damage, ...$revealed_nonlowest_hand_wheel]}, announcement:@announcement} */
spell_revealed_number_extremes ::= secret_numbers_reveal_extremes "." revealed_highest_damage "." revealed_nonlowest_hand_wheel "."

/* The damaged player supplies the graveyard; the controller gets the permission. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(EventSubject)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:$event_graveyard_cast_kind}, terms:_{limit:Total(1), cost:Normal, spend_as:AnyColor}})], duration:$this_duration, evaluation:LiveObjects}}] */
event_graveyard_cast_with_spending ::= "you" "may" "cast" "a" event_graveyard_cast_kind "spell" "from" "that" "player's" "graveyard" this_duration "," "and" "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "that" "spell"

event_graveyard_cast_kind ::= noun_creature | noun_battle

/* The choice is hidden from the other players. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Filter, terms:_{count:Exactly(Constant(1)), options:[Filter(CardType(Land)), Filter(Not(CardType(Land)))], secret:true}} */
choose_secret_land_or_nonland ::= "secretly" "choose" "land" "or" "nonland"

/* Each hand movement retains its filter and actual exile visibility. */
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Hand, players:One(EventSubject)}, kind:Card, filter:$hand_exile_card_filter}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
event_hand_exile_face_up ::= "exile" "all" hand_exile_card_filter "from" "that" "player's" "hand"

/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Hand, players:One(EventSubject)}, kind:Card, filter:$hand_exile_card_filter}), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
event_hand_exile_face_down ::= "exile" "all" hand_exile_card_filter "from" "that" "player's" "hand" "face" "down"

event_hand_exile_producer ::= event_hand_exile_face_up | event_hand_exile_face_down

/* The receipt count is scoped to a hand-to-exile producer in the enclosing unit. */
/* @sem Operation::Draw{players:One(EventSubject), amount:CountObjects(InZone{objects:Transition{result:@marked, phase:Before}, zone:Hand})} */
event_hand_receipt_draw_they ::= "they" "draw" "that" "many" "cards"

/* @sem Operation::Draw{players:One(AbilityController), amount:CountObjects(InZone{objects:Transition{result:@marked, phase:Before}, zone:Hand})} */
event_hand_receipt_draw_you ::= "you" "draw" "that" "many" "cards"

event_hand_receipt_draw ::= event_hand_receipt_draw_they | event_hand_receipt_draw_you

/* @sem Instruction::[Effect{result:@mark, operation:$event_hand_exile_producer}, Effect{result:@next, operation:$event_hand_receipt_draw}] */
event_hand_exile_draw ::= event_hand_exile_producer "," "then" event_hand_receipt_draw

/* This continuation can only consume the marked exile supplied by its enclosing producer. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:PlayLand, filter:Any}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:CastSpell, filter:$cast_spells_filter}, terms:_{cost:Normal, spend_as:AnyColor}})], duration:WhileAnyExiled(Transition{result:@marked, phase:After}), evaluation:LiveObjects}}] */
exile_batch_land_cast_color_permission ::= "you" "may" "play" "lands" "and" "cast" cast_spells_filter "from" "among" "the" "exiled" "cards" "for" "as" "long" "as" "they" "remain" "exiled" "." "if" "you" "cast" "a" "spell" "this" "way" "," "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "it"

/* @sem Instruction::[...$event_hand_exile_draw, ...$exile_batch_land_cast_color_permission] */
instructions_event_hand_exile_draw_permission ::= event_hand_exile_draw "." exile_batch_land_cast_color_permission

/* The destroy producer and duplicate consumer share the performed before receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$destroy}, Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Duplicate(Matching{objects:Transition{result:@marked, phase:Before}, filter:$filter_phrase}), count:Constant(1), destination:Hand(CardArrival{counters:[], states:[]})}}] */
instructions_destroy_duplicate ::= destroy "." "conjure" "a" "duplicate" "of" "each" filter_phrase "destroyed" "this" "way" "into" "your" "hand"

/* The immediate conjure receipt identifies the cards receiving the grants. */
/* @sem Instruction::[...$instructions_destroy_duplicate, Effect{result:@next, operation:CreatePerpetualEffect{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@prior, phase:After})}, changes:$duplicate_two_quoted_grants}}] */
instructions_destroy_duplicate_grants ::= instructions_destroy_duplicate "." "the" "duplicates" "perpetually" duplicate_two_quoted_grants

/* @sem Change::[GrantAbility(Casting(AlternativeCost($cost))), GrantAbility(@scope(Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$program}))] */
duplicate_two_quoted_grants ::= "gain" '"' "you" "may" "pay" cost "rather" "than" "pay" "this" "spell's" "mana" "cost" '"' "and" '"' "at" turn_event "," program "." '"'

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_destroy_duplicate_grants}} */
spell_destroy_duplicate_grants ::= instructions_destroy_duplicate_grants

/* An object event supplies the subject whose last-known characteristic bounds
   both the distributed total and the number of announced targets. */
/* @sem Expr::ObjectProperty{object:EventSubject, property:$creature_stat, information:CurrentOrLastKnown} */
event_subject_distribution_stat ::= "its" creature_stat

/* The event subject's controller determines the eligible population; the
   ability's normal target announcement remains independent of that player. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo($event_subject_distribution_stat), filter:AllOf([$plural, ControlledBy(One(ControllerOf(EventSubject)))]), distribute:$event_subject_distribution_stat}))), kind:$counter_kind, amount:DistributedShare(@share)}]} */
event_controller_distribute_stat_counters ::= "its" "controller" "distributes" "a" "number" "of" counter_kind "counters" "equal" "to" event_subject_distribution_stat "among" "any" "number" "of" "target" plural "they" "control"

/* A death event supplies the antecedent for both its controller and its stat. */
/* @sem Ability::Triggered{event:$event_dies, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$event_controller_distribute_stat_counters}]}} */
triggered_death_controller_distributes ::= "whenever" event_dies "," event_controller_distribute_stat_counters "."

/* Each randomly selected population supplies its own exchange operand. */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]} */
exchange_random_first ::= "a" filter_phrase "chosen" "at" "random"

/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:Exactly(Constant(1)), constraints:[AtRandom]} */
exchange_random_second ::= "a" filter_phrase "chosen" "at" "random"

/* @sem Instruction::[Effect{result:@next, operation:$exchange_random_first}, Effect{result:@next, operation:$exchange_random_second}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::ExchangeControl{first:Result{result:@back(3), phase:After, index:0}, second:Result{result:@back(2), phase:After, index:0}}}}] */
clause_exchange_random_choices ::= "exchange" "control" "of" exchange_random_first "and" exchange_random_second

/* The chosen permanent belongs to the same population whose minimum is measured. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($least_stat_battlefield, ObjectFilter::AllOf([$plural_head, Property{property:$stat, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$plural_head}, property:$stat, aggregation:Minimum}}}]))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:Objects(One(Result{result:@prior, phase:After, index:0})), amount:$number, preventable:true}}] */
damage_least_stat_tied ::= damage_source_ref "deals" number "damage" "to" least_stat_battlefield "." "if" "two" "or" "more" plural_head "are" "tied" "for" "least" stat "," "you" "choose" "one" "of" "them"

/* A defined X keeps its recipient and current value operands. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:$owned_zones_plus_value}]} */
put_counters_where_owned_zones ::= "put" "X" counter_kind "counters" "on" affected "," "where" "X" "is" owned_zones_plus_value

/* The source and its measured property are retained independently of the defender. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref_named, recipients:Players(One($batch_attacked_defender)), amount:ObjectProperty{object:$self_ref_named, property:$creature_stat, information:CurrentOrLastKnown}, preventable:true}}]} */
program_named_source_stat_defender_damage ::= self_ref_named "deals" "damage" "equal" "to" "its" creature_stat "to" batch_attacked_defender

/* In a defender-partitioned attack batch the event subject is that player. */
/* @sem PlayerRef::EventSubject */
batch_attacked_defender ::= "defending" "player"

/* @prefer always */
/* @sem SelectionStep::_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), count:UpTo($value), constraints:[TotalProperty{property:ManaValue, comparison:LessOrEqual, amount:$value_2}]} */
total_mana_graveyard_up_to ::= "up" "to" value filter_phrase "cards" "with" "total" "mana" "value" value "or" "less" "from" "your" "graveyard"

/* @sem SelectionStep::_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), count:AnyNumber, constraints:[TotalProperty{property:ManaValue, comparison:LessOrEqual, amount:$value}]} */
total_mana_graveyard_any_number ::= "any" "number" "of" filter_phrase "cards" "with" "total" "mana" "value" value "or" "less" "from" "your" "graveyard"

/* The two announced objects share an opposing controller, who chooses one. */
/* @sem @target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(2)), filter:AllOf([CardType(Creature), ControlledBy(OpponentsOf(AbilityController))]), constraints:[CommonProperty(Controllers)]}) */
opponent_pair_controller_choice_group ::= "choose" "two" "target" "creatures" "controlled" "by" "the" "same" "opponent" "." "that" "player" "chooses" "one" "of" "those" "creatures"

/* @sem Operation::ChooseObjects{player:ControllerOf(Target{slot:$opponent_pair_controller_choice_group, index:0}), objects:Targets($opponent_pair_controller_choice_group), count:AsManyAsCan(Constant(1)), constraints:[]} */
opponent_pair_controller_choice ::= opponent_pair_controller_choice_group

/* The follow-up exposes its numeric and duration operands to the shared choice frame. */
/* @sem $number_digits */
chosen_creature_damage_amount ::= SELF_NAME "deals" number_digits "damage" "to" "that" "creature"

/* @sem $this_duration */
unchosen_other_block_duration ::= "the" "other" "can't" "block" this_duration

/* @sem Ability::Spell{body:Program{instructions:[Effect{result:@mark, operation:$opponent_pair_controller_choice}, Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Result{result:@marked, phase:After, index:0})), amount:$chosen_creature_damage_amount, preventable:true}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Unselected(@marked)), changes:[Rule(Prohibit(Block(Any)))], duration:$unchosen_other_block_duration, evaluation:LiveObjects}}]}, announcement:@announcement} */
spell_opponent_pair_choice_followup ::= opponent_pair_controller_choice "." chosen_creature_damage_amount "," "and" unchosen_other_block_duration "."

/* Retarget each selected stack object, preserving the printed population filter. */
/* @sem Operation::RetargetEach{actor:One(AbilityController), objects:$retarget_each_population, targets:May} */
retarget_each_new_targets ::= "choose" "new" "targets" "for" "any" "number" "of" retarget_each_population

/* The discard receipt and its difference consumer share one producer scope. */
/* @sem Instruction::[ $discard_shortfall_producer, $discard_shortfall_draw ] */
discard_shortfall_sequence ::= discard_shortfall_producer "." discard_shortfall_draw

/* @sem Instruction::Effect{result:@mark, operation:Discard{players:$players_singular, amount:$card_count, random:false}} */
discard_shortfall_producer ::= players_singular "discards" card_count

/* @sem Instruction::If{condition:Compare{left:CountObjects(Transition{result:@marked, phase:Before}), test:NumberTest::Compare{comparison:Less, value:$card_count}}, then:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Subtract([$card_count, CountObjects(Transition{result:@marked, phase:Before})])}}]}, otherwise:Program{}} */
discard_shortfall_draw ::= "if" "fewer" "than" card_count "were" "discarded" "this" "way" "," "you" "draw" "cards" "equal" "to" "the" "difference"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$discard_shortfall_sequence}} */
discard_shortfall_spell ::= discard_shortfall_sequence "."

/* The second sentence names the player targeted by the immediately preceding tap. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($plural, $plural_2), ControlledBy(One($target_player))])}, tapped:true}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Transition{result:@prior, phase:Before}), changes:[Rule(UntapStep{players:One(Target{slot:@last_slot, index:0}), behavior:Skip})], duration:DuringNextUntapStep(Target{slot:@last_slot, index:0}), evaluation:LiveObjects}}]} */
program_tap_target_player_population_skip ::= "tap" "all" plural target_player "controls" "." "those" plural "don't" "untap" "during" "that" "player's" "next" "untap" "step"

/* @sem Ability::Spell{announcement:@announcement, body:$program_tap_target_player_population_skip} */
spell_tap_target_player_population_skip ::= program_tap_target_player_population_skip "."

/* Both uses name the arrival of this specific exile action. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_optional_graveyard_card_set}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:Any}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Duplicate(One(Result{result:@marked, phase:After, index:0})), count:$counter_a, destination:$conjure_top_library}}]}}]}, otherwise:Program{}}] */
instructions_exile_optional_conjure ::= exile_optional_graveyard_card_set "." "if" "a" "card" "is" "exiled" "this" "way" "," "you" "may" "conjure" counter_a "duplicate" "of" "that" "card" conjure_top_library

/* The second sentence tests the same singular target after the first effect. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$target_keyword_animation}, $target_type_negative_branch]} */
program_target_animation_negative_branch ::= target_keyword_animation "." target_type_negative_branch

/* @sem Instruction::If{condition:ObjectMatches{object:Target{slot:0, index:0}, filter:Not($filter_phrase)}, then:$program, otherwise:Program{}} */
target_type_negative_branch ::= "if" "it's" "not" "a" filter_phrase "," program

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($target_permanent)), changes:$artifact_keyword_animation, duration:$duration, evaluation:Snapshot} */
target_keyword_animation ::= duration "," target_permanent artifact_keyword_animation

owned_perpetual_terms ::= perpetual_type_terms | owned_perpetual_pump

/* Both adjustments are independent current operands. */
/* @sem Operand::[Term{family:PerpetualEffect, form:AdjustPT, operands:[Integer($number), Integer($number_2)]}] */
owned_perpetual_pump ::= "get" "+" NUMBER "/" "+" NUMBER

/* The condition is checked when the triggered copy instruction resolves. */
/* @sem Program::Program{instructions:[If{condition:$condition_control_six_kinds, then:Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:Same}}]}, otherwise:Program{}}]} */
cast_subject_conditional_copy ::= "copy" "it" "if" condition_control_six_kinds "."

/* These alternatives retain the owner of the announced target. "Another"
   excludes that target even when its earlier move did not happen. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(OwnerOf(Target{slot:0, index:0})), amount:$number}}]} */
owner_choice_lose_life ::= "they" "lose" number "life"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:OwnerOf(Target{slot:0, index:0}), objects:Zone(_{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun, OwnedBy(One(OwnerOf(Target{slot:0, index:0}))), Not(SameObject(Target{slot:0, index:0}))])}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]} */
owner_choice_shuffle_another ::= "they" "shuffle" "another" noun "they" "own" "into" "their" "library"

/* @sem Instruction::Effect{result:@next, operation:ChooseAction{actor:One(OwnerOf(Target{slot:0, index:0})), options:[List([Program($owner_choice_lose_life)]), List([Program($owner_choice_shuffle_another)])], villainous:true}} */
owner_villainous_shuffle_choice ::= "then" "faces" "a" "villainous" "choice" "—" owner_choice_lose_life "," "or" owner_choice_shuffle_another

/* @sem Ability::Spell{body:Program{instructions:[Effect{result:@next, operation:$owner_shuffles_target_into_library}, $owner_villainous_shuffle_choice]}, announcement:@announcement} */
spell_owner_shuffle_villainous ::= owner_shuffles_target_into_library "," owner_villainous_shuffle_choice "."

/* A copy for every other legal target, one target per copy. */
/* @prefer always */
/* @sem NewTargets::EachLegal */
other_legal_stack_targets ::= "for" "each" "other" "spell" "," "permanent" "," "card" "not" "on" "the" "battlefield" "," "and" "/" "or" "player" "the" "spell" "could" "target" "." "each" "copy" "targets" "a" "different" "one" "of" "them"

/* @sem Instruction::[Effect{result:@next, operation:CopyOnStack{actor:One($player_ref), object:ObjectRef::@it, times:Constant(1), targets:$other_legal_stack_targets}}] */
player_copies_for_all_legal_targets ::= player_ref "copies" "that" "spell" other_legal_stack_targets

/* A singular creature card enters with a named counter under your control. */
/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:$noun_creature}), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[]}}, qualifiers:[]} */
put_graveyard_creature_counter_entry ::= "put" "target" noun_creature "card" "from" "a" "graveyard" "onto" "the" "battlefield" "under" "your" "control" "with" "a" counter_kind "counter" "on" "it"

/* The replacement refers to the marked creature's actual arrival. */
/* @sem Instruction::Effect{result:@next, operation:CreateReplacement{event:Object{event:LeavesBattlefield, objects:SameObject(Result{result:@marked, phase:After, index:0})}, limit:NextOccurrence, duration:EndOfTurn, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}}} */
marked_creature_departure_exile ::= "if" "that" "creature" "would" "leave" "the" "battlefield" "," "exile" "it" "instead" "of" "putting" "it" "anywhere" "else"

/* @sem Instruction::[Effect{result:@mark, operation:$graveyard_creature_counter_entry}, Effect{result:@next, operation:$operation}, $marked_creature_departure_exile] */
instructions_counter_entry_intervening_departure ::= graveyard_creature_counter_entry "." operation "." marked_creature_departure_exile

/* The owner-restricted version retains its own graveyard predicate. */
/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$noun_creature, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[]}}, qualifiers:[]} */
put_your_graveyard_creature_counter_entry ::= "put" "target" noun_creature "card" "from" "your" "graveyard" "onto" "the" "battlefield" "under" "your" "control" "with" "a" counter_kind "counter" "on" "it"

graveyard_creature_counter_entry ::= put_graveyard_creature_counter_entry | put_your_graveyard_creature_counter_entry

/* The condition and grant refer to the arrival of the explicitly cast spell. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_cast_spell_counter_arrival}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:Not(HasKeywordFamily(Suspend))}, then:Program{instructions:[Effect{result:@next, operation:EffectOn{subject:Objects(One(Result{result:@marked, phase:After, index:0})), effects:[Term{family:ExiledCardEffect, form:AddAbility, operands:[Ability(Mechanic{mechanic:BasicSuspend})]}]}}]}, otherwise:Program{}}] */
exile_cast_spell_conditional_suspend ::= exile_cast_spell_counter_arrival "." "if" "it" "doesn't" "have" "suspend" "," "it" "gains" "suspend"

/* @sem Operation::Move{objects:One(EventSubject), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[[$counter_kind, $value]], states:[]}}, qualifiers:[]} */
exile_cast_spell_counter_arrival ::= "exile" "the" "spell" "you" "cast" "with" value counter_kind "counters" "on" "it"

/* @sem Operation::CopyOnStack{actor:One(AbilityController), object:$object_ref, times:Constant(1), targets:Same} */
copy_referenced_stack_unchanged ::= "copy" object_ref

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$copy_referenced_stack_unchanged}, ...$exile_cast_spell_conditional_suspend]}} */
triggered_copy_then_cast_spell_exile ::= event_clause "," copy_referenced_stack_unchanged "," "then" exile_cast_spell_conditional_suspend "."

/* Fronted hand destination composes with a qualified graveyard target. */
/* @sem Operation::Move{objects:$target_card_in_your_graveyard_lesser_event, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_fronted_lesser_event_card ::= "return" "to" "your" "hand" target_card_in_your_graveyard_lesser_event

/* The pump applies to the object selected by the immediately preceding choice. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$least_stat_opponents_choice}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[Pump{power:$signed, toughness:$signed_2}], duration:Indefinite, evaluation:Snapshot}}] */
instructions_choose_least_opponent_pump ::= "choose" least_stat_opponents_choice "." "it" "perpetually" "gets" signed "/" signed

/* An optional payment selects one of two independently composed programs. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:EventSubject, cost:$cost, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:$event_player_counter_placement}]}, otherwise:Program{instructions:$conjoined}}] */
player_payment_two_branches ::= "that" "player" "may" "pay" cost "." "if" "they" "do" "," "they" event_player_counter_placement "." "otherwise" "," conjoined

/* The acting player chooses a controlled permanent for this placement. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(EventSubject))])}), kind:$counter_kind, amount:Constant(1), selection:_{player:EventSubject, count:AsManyAsCan(Constant(1))}}]} */
event_player_counter_placement ::= "put" "a" counter_kind "counter" "on" "a" filter_phrase "they" "control"

/* Exile a specified set together with each permanent lacking a counter. */
/* @sem Operation::Move{objects:Union([$affected, Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, $modifier_without_named_counter])}]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_union_without_counter ::= "exile" affected "and" "each" filter_phrase modifier_without_named_counter

/* Keep the draw choice and the repeat decision within the same process. */
/* @sem Instruction::[Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::AbilityController), $draw_up_to_base)}, $repeat_player_decision] */
repeat_controller_draw_choice ::= "you" draw_up_to_base "." repeat_player_decision

/* @sem Instruction::Optional{decider:$player_ref, body:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}} */
repeat_player_decision ::= player_ref "may" "repeat" "this" "process" "as" "many" "times" "as" "they" "choose"

/* A random retargeting restriction excludes both named populations. */
/* @sem Operand::Term{family:PlayersAndPermanents, form:APlayerOrAPermanent, operands:[$recipients, Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase})]} */
random_target_exclusions ::= "the" "new" "targets" "can't" "be" recipients "or" "a" filter_phrase

/* The same random exclusion applies to the captured spell and its copy. */
/* @sem Instruction::[Effect{result:@next, operation:TakeSpell{actor:One(AbilityController), object:$single_targeted_spell, targets:Random($random_target_exclusions)}}, Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:Target{slot:@last_slot, index:0}, times:Constant(1), targets:Random($random_target_exclusions)}}] */
control_copy_random_targets ::= "gain" "control" "of" single_targeted_spell "." "copy" "it" "," "then" "reselect" "the" "targets" "at" "random" "for" "the" "spell" "and" "the" "copy" "." random_target_exclusions

/* A condition on the announced stack object guards a retarget action. */
/* @sem Instruction::[If{condition:ObjectMatches{object:$choose_new_targets_plain_stack_object, filter:AllOf([$retarget_condition_target_filter, $retarget_controller_filter])}, then:Program{instructions:[Effect{result:@next, operation:Retarget{actor:One(AbilityController), object:$it_ordinary_pronoun, targets:May}}]}, otherwise:Program{}}] */
clause_conditional_stack_retarget ::= "choose" "new" "targets" "for" choose_new_targets_plain_stack_object "if" "it's" retarget_controller_filter "and" "if" it_ordinary_pronoun retarget_condition_target_filter

/* @sem Change::[...$change_pump, GrantKeyword($keyword_name)] */
/* @prefer always */
cast_boon_pump_and_keyword ::= change_pump "and" "gains" keyword_name

/* The same announced creature is the subject of a turn-bounded departure. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($copy_chosen_creature)), changes:$static_singular_pump, duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Object{event:LeavesBattlefield, objects:SameObject(Target{slot:@last_slot, index:0})}, start:Immediately, expires:EndOfTurn, body:Program{instructions:$clause_one_time_cast_perpetual_boon}}}] */
controlled_creature_pump_departure_boon ::= copy_chosen_creature static_singular_pump duration "." "when" "that" "creature" "leaves" "the" "battlefield" "this" "turn" "," clause_one_time_cast_perpetual_boon

/* A quoted delayed consequence can precede an independent next-line clause. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$controlled_creature_pump_departure_boon, ...$clause]}} */
spell_departure_boon_continuation ::= controlled_creature_pump_departure_boon NEWLINE clause "."

/* The opponent's choice and both destinations share the exact two-card
   activation payment. The other card is the unselected object, even if the
   chosen card's first move is redirected. */
/* @sem Instruction::[Effect{result:@mark, operation:ChooseObjects{player:OneOf(OpponentsOf(AbilityController)), objects:CostObjects{payment:Activation, component:[2], view:Performed, phase:After}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}, destination:Library{position:$owner_library_position, order:DestinationDefault, arrival:CardArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Unselected(@marked), zone:Exile}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}] */
paid_exiled_pair_partition ::= "an" "opponent" "chooses" "one" "of" "the" "exiled" "cards" "." "you" "put" "that" "card" owner_library_position "of" "your" "library" "and" "return" "the" "other" "to" "the" "battlefield" "tapped"

/* @sem CostPart::Move{selections:[CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$card_filter}, choose:Exactly(Constant(2))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}} */
paid_exiled_pair_cost ::= "exile" "two" card_filter "cards" "from" "your" "graveyard"

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, $cost_tap, $paid_exiled_pair_cost, $cost_sacrifice_self]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[...$paid_exiled_pair_partition, ...$clause]}} */
activated_paid_exiled_pair_partition ::= cost_mana "," cost_tap "," "↑" paid_exiled_pair_cost "," "↑" cost_sacrifice_self ":" paid_exiled_pair_partition "." clause "."

/* Select a controlled face-up population before moving it to the shuffled pile. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController)), HasKeywordFamily(Disguise), Not(State(FaceDown))])} */
controlled_face_up_disguise_population ::= "face-up" filter_plural "you" "control" "with" "disguise"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:$controlled_face_up_disguise_population, count:AnyNumber}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[ExilePile{shuffled:true}]}}, qualifiers:[]}}] */
selected_shuffled_exile ::= "exile" "any" "number" "of" controlled_face_up_disguise_population "in" "a" "face-down" "pile" "," "shuffle" "that" "pile"

/* This continuation consumes the immediately preceding selected exile arrival. */
/* @sem Instruction::[...$selected_shuffled_exile, Effect{result:@next, operation:Manifest{actor:One(AbilityController), source:Cards(Transition{result:@prior, phase:After}), cloak:true, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
selected_shuffled_exile_cloak ::= selected_shuffled_exile "," "then" "cloak" "them"

/* The negative participation test is scoped to the immediately preceding
   optional hand-to-battlefield move, and excludes the ability controller. */
/* @sem Instruction::[ForEachPlayer{players:$players_each, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@next, operation:$hand_entry_bound_choice}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(Bound(0)), arrival:$source_zone_return_entry}, qualifiers:[]}}]}}]}}, Effect{result:@next, operation:Draw{players:Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Not(PlayerTook{player:Bound(0), result:@marked})}]), amount:$card_count}}] */
instructions_hand_entry_nonparticipant_opponent_draw ::= players_each "may" "put" hand_entry_bound_choice "from" "their" "hand" "onto" "the" "battlefield" source_zone_return_entry "," "then" "each" "opponent" "who" "didn't" "draws" card_count

/* One copy with an optional new target choice, over any supported ability target. */
/* @sem Operation::CopyOnStack{actor:One(AbilityController), object:$copy_target_ability, times:Constant(1), targets:May} */
copy_stack_ability_once ::= "copy" copy_target_ability "." "you" "may" "choose" "new" "targets" "for" "the" "copy"

/* The condition and grant refer to the one card actually exiled by this payment. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$exile_hand_card_mana_value_counters]}, optional:true}}, If{condition:ObjectMatches{object:Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0}, filter:Not(HasKeywordFamily(Suspend))}, then:Program{instructions:[Effect{result:@next, operation:EffectOn{subject:Objects(One(Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0})), effects:[Term{family:ExiledCardEffect, form:AddAbility, operands:[Ability(Mechanic{mechanic:BasicSuspend})]}]}}]}, otherwise:Program{}}] */
instructions_optional_hand_exile_suspend ::= "you" "may" exile_hand_card_mana_value_counters "." "if" "it" "doesn't" "have" "suspend" "," "it" "gains" "suspend"

/* The second target is distinct from the first and has its own controller filter. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(Target{slot:@last_slot, index:0})), $noun, ObjectFilter::ControlledBy(One(AbilityController)))}), index:0} */
transfer_second_controlled_target ::= "a" "second" "target" noun "you" "control"

/* @sem Operation::MoveCounters{actor:One(AbilityController), from:One($target_permanent), to:One($transfer_second_controlled_target), amount:One} */
transfer_counter_one_second_controlled ::= "move" "a" "counter" "from" target_permanent "onto" transfer_second_controlled_target

bound_controlled_greatest_population ::= bound_controlled_greatest_population_independent | bound_controlled_greatest_population_eligible

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:$bound_controlled_greatest_population, count:$counter_single_required}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]}} */
spell_each_return_controlled_greatest ::= players_singular "returns" counter_single_required bound_controlled_greatest_population "to" "its" "owner's" "hand" "."

/* The following action applies to the same player set in a later phase. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:$bound_controlled_greatest_population, count:$counter_single_required}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}, Effect{result:@next, operation:@apply($players_singular, $verb_operation_third)}]}} */
spell_each_return_controlled_greatest_then ::= players_singular "returns" counter_single_required bound_controlled_greatest_population "to" "its" "owner's" "hand" "," "then" verb_operation_third "."

/* Each opponent makes an independent payment choice before their own life loss. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:Bound(0), cost:$discard_or_sacrifice_payment, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(Bound(0)), amount:$value}}]}, otherwise:Program{}}]}}] */
players_life_unless_alternative_payment ::= players_singular "loses" value "life" "unless" "they" discard_or_sacrifice_payment

/* A cast trigger can copy its event spell without changing its targets. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:Same}}]} */
/* @prefer always */
cast_event_copy_once ::= "copy" "that" "spell" "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(2), targets:Same}}]} */
cast_event_copy_twice ::= "copy" "that" "spell" "twice" "."

cast_event_copy_body ::= cast_event_copy_once | cast_event_copy_twice | cast_event_copy_it

/* @sem Ability::Triggered{event:$event_cast, limits:TriggerLimits{}, announcement:@announcement, body:$cast_event_copy_body} */
triggered_cast_copy_event_spell ::= ("when" | "whenever") event_cast "," cast_event_copy_body

/* The player in the preceding seat-qualified target makes the copy choice. */
/* @sem Instruction::[Optional{decider:Seat{of:AbilityController, side:Left}, body:Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(Seat{of:AbilityController, side:Left}), object:ObjectRef::@self, times:Constant(1), targets:May}}]}}] */
left_player_may_copy_self_spell ::= "then" "that" "player" "may" "copy" self_spell "and" "may" "choose" "new" "targets" "for" "the" "copy"

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:$object_ref, second:$target_left_opponent_permanent}}}, ...$left_player_may_copy_self_spell] */
fight_left_player_copy ::= object_ref "fights" target_left_opponent_permanent "." left_player_may_copy_self_spell

/* The named player performs the action on that same player's library. */
/* @sem Operation::@manifest_result(Operation::Manifest{actor:One($player_ref), source:TopOfLibrary{player:$player_ref, count:Constant(1)}, cloak:false, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
player_manifests_own_top_card ::= player_ref "manifests" "the" "top" "card" "of" "their" "library"

/* Explicit numeric alternatives retain every listed choice. */
/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Number, terms:_{count:Exactly(Constant(1)), options:[$random_integer, $random_integer_2, $random_integer_3]}} */
choose_three_explicit_numbers ::= "choose" random_integer "," random_integer "," "or" random_integer

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Number, terms:_{count:Exactly(Constant(1)), options:[$random_integer, $random_integer_2]}} */
choose_two_explicit_numbers ::= "choose" random_integer "or" random_integer

opening_hand_explicit_number_choice ::= choose_three_explicit_numbers | choose_two_explicit_numbers

/* @sem Ability::BeforeGame{when:OpeningHand, body:List([Program{instructions:[Effect{result:@next, operation:$opening_hand_explicit_number_choice}]}])} */
before_opening_hand_number_choice ::= "before" "drawing" "your" "opening" "hand" "," opening_hand_explicit_number_choice "."

/* The controller chooses one amount, then the stated source deals it to each recipient. */
/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::ChooseDamageNumber}}, Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:$recipients, amount:ChosenNumber, preventable:true}}] */
instructions_chosen_damage ::= damage_source_ref "deals" "an" "amount" "of" "damage" "of" "your" "choice" "to" recipients

/* The following sentence qualifies precisely this damage action. */
/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::ChooseDamageNumber}}, Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:$recipients, amount:ChosenNumber, preventable:false}}] */
