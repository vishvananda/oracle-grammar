/* @sem Operation::ChooseObjects{player:Bound(0), objects:Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($filter_plural, $filter_phrase)}, filter:ControlledBy(One(Bound(0)))}, count:AsManyAsCan(Constant(5)), constraints:[OneForEach([Subtype(Plains), Subtype(Island), Subtype(Swamp), Subtype(Mountain), Subtype(Forest)])]} */
