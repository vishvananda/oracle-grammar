/* Each player creates their own token and puts counters on it equal to the total
   stat of permanents they controlled that were exiled by the preceding wipe. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($filter_plural, $filter_plural_2)}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(Bound(0)), tokens:$token_groups, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@prior)), kind:$counter_kind, amount:Aggregate{objects:Matching{objects:Transition{result:@marked, phase:Before}, filter:AllOf([$filter_plural_2, ControlledBy(One(Bound(0)))])}, property:$creature_stat, aggregation:Sum}}]}}]}}] */
instructions_exile_all_each_token_exiled_stat ::= "exile" "all" filter_plural "." "each" "player" "creates" token_groups "and" "puts" "a" "number" "of" counter_kind "counters" "on" "it" "equal" "to" "the" "total" creature_stat "of" filter_plural "they" "controlled" "that" "were" "exiled" "this" "way"

/* A coin flip whose win and loss outcomes each register a reflexive trigger. */
/* @sem Instruction::[Effect{result:@mark, operation:FlipCoin{player:AbilityController, protocol:@coin_protocol}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, condition:CoinFlip{result:@marked, outcome:Won}, announcement:@announcement, body:$coin_reflexive_win_body})}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, condition:CoinFlip{result:@marked, outcome:Lost}, announcement:@announcement, body:$coin_reflexive_lose_body})}] */
clause_flip_coin_reflexive_win_lose ::= "flip" "a" "coin" "." "when" "you" "win" "the" "flip" "," coin_reflexive_win_body "." "when" "you" "lose" "the" "flip" "," coin_reflexive_lose_body

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$copy_cast_event_with_new_targets}]} */
coin_reflexive_win_body ::= copy_cast_event_with_new_targets

/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:$recipients, amount:$value_event_spell_mana, preventable:true}}]} */
coin_reflexive_lose_body ::= self_explicit_ref "deals" "damage" "equal" "to" value_event_spell_mana "to" recipients

/* Base-stat-qualified sacrifice selections retain their exact base-characteristic bounds. */
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($plural_head, $modifier_base_stat)}, choose:$count_any_number}) */
sacrifice_any_base_stat ::= "sacrifice" count_any_number plural_head modifier_base_stat

/* The named object becomes the antecedent of the delayed action. */
/* @sem EventSpec::Player{event:LosesControl, players:$event_control_loss_base_subject, objects:SameObject(@remember_object($object_ref))} */
delayed_control_loss_event ::= event_control_loss_base_subject "lose" "control" "of" object_ref

/* Keep the controlled attachment, self-attach, and delayed unattach pronouns tied to the same target. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(@remember_object($target_object))), changes:[SetController(AbilityController)], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:Attach{attachments:One(Target{slot:@last_slot, index:0}), host:$self_explicit_ref}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_control_loss_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Unattach{object:Target{slot:@last_slot, index:0}}}}]}}}] */
instructions_gain_control_attach_self_unattach ::= "gain" "control" "of" target_object duration "." "attach" "it" "to" self_explicit_ref "." "when" delayed_control_loss_event "," "unattach" "it"

/* The payer is the controller introduced by the opponent-controlled target phrase. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:ControllerOf($opponents_stack_spell_target), cost:$counter_unless_cost, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@next_slot, index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:Program{}}] */
clause_counter_opponents_spell_unless_they_pay ::= "counter" opponents_stack_spell_target "unless" "they" "pay" counter_unless_cost

opponents_stack_spell_target ::= target_opponents_stack_spell

/* @prefer always */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Spell, zones:[Stack]}), count:Exactly(Expr::Constant(1)), filter:@and($stack_spell_filter, ObjectFilter::ControlledBy(OpponentsOf(AbilityController)))}), index:0} */
target_opponents_stack_spell ::= "target" stack_spell_filter "an" "opponent" "controls"

/* Copy target and copy exceptions compose independently of the entry state. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$target_controlled_other_self, exceptions:$copy_exceptions_plain}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}] */
create_attacking_modified_copy ::= "create" "a" "tapped" "and" "attacking" "token" "that's" "a" "copy" "of" target_controlled_other_self "," "except" copy_exceptions_plain

/* The stack population and exile visibility remain independent operands. */
/* @sem Operation::@exile_result(Operation::Move{objects:$exile_stack_population, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}) */
exile_stack_population_face_down ::= "exile" exile_stack_population "face" "down"

exile_stack_population ::= receipt_counter_spells | stack_all_spells

/* Bind the measured subset to this specific face-up graveyard exile. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$exile_cast_return_population, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Aggregate{objects:Matching{objects:Transition{result:@prior, phase:After}, filter:$filter_phrase}, property:$stat, aggregation:Maximum}, words:CreatingEffect, recipe:$token_recipe_plain}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
shared_exile_graveyards_token_maximum ::= "exile" exile_cast_return_population "," "then" "create" "X" token_recipe_plain "," "where" "X" "is" "the" "greatest" stat "among" filter_phrase "cards" "exiled" "this" "way"

/* Each choice retains the independently expressed actor in its program. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseAction{actor:One($target_opponent), options:[List([Program{instructions:@apply(PlayerSet::One(Target{slot:@last_slot, index:0}), $verbs_base)}]), List([Program($program)])], villainous:true}}] */
clause_villainous_target_they ::= target_opponent "faces" "a" "villainous" "choice" "—" "they" verbs_base "," "or" program

/* The selected controlled subtype is tapped, and the draw counts that exact tap receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(Tapped), @agree($subtype_plural, $subtype), ControlledBy(One(AbilityController))])}, count:AnyNumber}}, Effect{result:@next, operation:SetTapped{objects:Selected(@prior), tapped:true}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountObjects(Transition{result:@prior, phase:Before})}}] */
tap_chosen_subtype_counted_draw ::= "you" "may" "tap" "any" "number" "of" "untapped" subtype_plural "you" "control" "." "draw" "a" "card" "for" "each" subtype "tapped" "this" "way"

/* @sem Ability::Triggered{event:$event_attacks, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$tap_chosen_subtype_counted_draw}} */
triggered_attacks_tap_subtype_draw ::= "whenever" event_attacks "," tap_chosen_subtype_counted_draw "."

/* @prefer always */
/* @sem Operation::EffectOn{subject:$filtered_cast_spell_subject, effects:[$filtered_cast_spell_effect], until:EndOfTurn} */
spell_effect_filtered_uncounterable ::= filtered_cast_spell_subject filtered_cast_spell_effect

/* A three-type spell population and generic reduction each retain their operands. */
/* @sem Operation::EffectOn{subject:$triple_cast_spell_subject, effects:[$filtered_cast_spell_reduction], until:EndOfTurn} */
spell_effect_triple_reduction ::= triple_cast_spell_subject filtered_cast_spell_reduction

/* @sem EffectSubject::EachSpell(AllOf([$triple_cast_spell_kind, Cast{by:One(AbilityController)}])) */
triple_cast_spell_subject ::= triple_cast_spell_kind "spells" "you" "cast" "this" "turn"

/* @sem ObjectFilter::AnyOf([$filter_phrase, $spell_instant, $spell_sorcery]) */
triple_cast_spell_kind ::= filter_phrase "," spell_instant "," "and" spell_sorcery

/* @sem Operand::Term{family:SpellEffect, form:DecreaseManaCost, operands:[$linked_reduction_symbol]} */
filtered_cast_spell_reduction ::= "cost" linked_reduction_symbol "less" "to" "cast"

/* The second move consumes the immediately preceding exile receipt. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($self_explicit_ref), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:@exile_followup(InZone{objects:One(Result{result:@prior, phase:After, index:0}), zone:Exile}), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[Transformed]}}, qualifiers:[]}}] */
instructions_self_exile_return_her_transformed ::= "exile" self_explicit_ref "," "then" "return" "her" "to" "the" "battlefield" "transformed" "under" "her" "owner's" "control"

/* The source, damage recipient, and measured kicked object remain independent. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$have_damage_source, recipients:$recipients, amount:$optional_kicked_count, preventable:true}}] */
clause_have_kicked_count_damage ::= "have" have_damage_source "deal" "damage" "to" recipients "equal" "to" optional_kicked_count

optional_kicked_count ::= optional_kicked_named | optional_kicked_object

/* @prefer always */
/* @sem Expr::TimesKicked(ObjectRef::@remember_operand($named_spell)) */
optional_kicked_named ::= "the" "number" "of" "times" named_spell "was" "kicked"

/* @sem Expr::TimesKicked($object_ref) */
optional_kicked_object ::= "the" "number" "of" "times" object_ref "was" "kicked"

/* The delayed return consumes the after receipt of this exact exile. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:AnyNumber, filter:$plural})), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@back(3), phase:After}, zone:Exile}, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}]}}}] */
instructions_target_exile_delayed_tapped ::= "exile" "any" "number" "of" "target" plural "." "at" "the" "beginning" "of" "the" "next" "end" "step" "," "return" "those" "cards" "to" "the" "battlefield" "tapped" "under" "their" "owners'" "control" /* @prefer always */

/* Scoped leading prevention keeps this spelling from changing unrelated defaults. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:$prevent_to, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
linked_leading_prevention ::= duration "," "prevent" "all" prevent_damage "that" "would" "be" "dealt" "to" prevent_to

/* @sem Ability::[Spell{announcement:@announcement, body:Program{instructions:[...$instructions_target_exile_delayed_tapped, Effect{result:@next, operation:$linked_leading_prevention}, ...$root_spell_paragraph_tail]}}] */
line_target_exile_delayed_prevention_paragraphs ::= instructions_target_exile_delayed_tapped "." NEWLINE linked_leading_prevention "." NEWLINE root_spell_paragraph_tail /* @prefer always */

/* This anaphor is dispatched only inside a combat-damage trigger below. */
/* @prefer always */
/* @sem Expr::EventAmount */
combat_trigger_that_damage ::= "that" "damage"

/* @sem ObjectFilter::AllOf([$milled_return_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$combat_trigger_that_damage}}]) */
combat_damage_hand_card_a ::= "a" milled_return_filter "card" "with" "mana" "value" "less" "than" "or" "equal" "to" combat_trigger_that_damage

/* @sem ObjectFilter::AllOf([$noun_artifact, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$combat_trigger_that_damage}}]) */
combat_damage_hand_card_an ::= "an" noun_artifact "card" "with" "mana" "value" "less" "than" "or" "equal" "to" combat_trigger_that_damage

combat_damage_hand_card ::= combat_damage_hand_card_a | combat_damage_hand_card_an

/* @prefer always */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$combat_damage_hand_card}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}]}}]} */
combat_damage_hand_entry ::= "you" "may" "put" combat_damage_hand_card "from" "your" "hand" "onto" "the" "battlefield"

/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:Discover{amount:$combat_trigger_that_damage}}}]} */
combat_damage_discover ::= "discover" "X" "," "where" "X" "is" combat_trigger_that_damage

/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:$combat_trigger_that_damage}}}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{}), qualifiers:[]}}]} */
combat_damage_seek ::= "seek" "a" "card" "with" "mana" "value" "equal" "to" combat_trigger_that_damage

combat_damage_amount_program ::= combat_damage_hand_entry | combat_damage_discover | combat_damage_seek

combat_damage_amount_subject ::= event_self | event_attached

/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:$combat_damage_amount_subject, recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source}) */
combat_damage_amount_event ::= combat_damage_amount_subject "deals" "combat" "damage" "to" "a" "player"

/* @prefer always */
/* @sem Ability::Triggered{event:$combat_damage_amount_event, limits:TriggerLimits{}, announcement:@announcement, body:$combat_damage_amount_program} */
triggered_combat_damage_amount_singular ::= "whenever" combat_damage_amount_event "," combat_damage_amount_program "."

/* @prefer always */
/* @sem Ability::Triggered{event:$event_controlled_subtypes_combat_player, limits:TriggerLimits{}, announcement:@announcement, body:$combat_damage_amount_program} */
triggered_combat_damage_amount_plural ::= "whenever" event_controlled_subtypes_combat_player "," combat_damage_amount_program "."

combat_damage_amount_triggers ::= triggered_combat_damage_amount_singular | triggered_combat_damage_amount_plural

/* @sem Ability::$combat_damage_amount_triggers */
triggered_combat_damage_amount ::= combat_damage_amount_triggers

/* A postposed spending condition changes the chooser while retaining each
   player's controlled population and that player's unchosen remainder. */
/* @sem Instruction::[If{condition:$choice_spent_colors, then:Program{instructions:[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$adjective_nontype, ControlledBy(One(Bound(0)))])}, count:AsManyAsCan(Constant(4)), constraints:[OneForEach($choice_four_categories)]}}]}}, ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(Bound(0)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(InSet(Selected(@prior))), $adjective_nontype, ControlledBy(One(Bound(0)))])}})}]}}]}, otherwise:Program{instructions:[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$adjective_nontype, ControlledBy(One(Bound(0)))])}, count:AsManyAsCan(Constant(4)), constraints:[OneForEach($choice_four_categories)]}}, Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(Bound(0)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(InSet(Selected(@prior))), $adjective_nontype, ControlledBy(One(Bound(0)))])}})}]}}]}}] */
choice_four_spending_chooser ::= "each" "player" "chooses" choice_four_categories "from" "among" "the" adjective_nontype "permanents" "they" "control" "," "then" "sacrifices" "the" "rest" "." "if" choice_spent_colors "," "you" "choose" "the" "permanents" "for" "each" "player" "instead"

/* Distinct colors each contribute one mana to casting this spell. */
/* @sem Condition::AllOf([Compare{left:ManaSpent{object:Source, filter:_{colors:[Black]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, Compare{left:ManaSpent{object:Source, filter:_{colors:[$choice_second_color]}, aggregation:Count}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}]) */
choice_spent_colors ::= "{" "B" "}" "{" choice_second_color "}" "was" "spent" "to" "cast" "this" "spell"

choice_second_color ::= red_pair_white | red_pair_blue | conditional_green_pair_red | red_pair_green

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$choice_four_spending_chooser}} */
spell_choice_four_spending_chooser ::= choice_four_spending_chooser "."

/* Keep the producer adjacent to its returned exile arrival. */
/* @sem Operation::Move{objects:One($object_ref), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_one_for_return ::= "exile" object_ref

/* @sem MovementDestination::Battlefield{controller:Owner, arrival:$transformed_entry} */
return_him_transformed_owner_destination ::= "return" "him" "to" "the" "battlefield" transformed_entry "under" "his" "owner's" "control"

/* @sem Instruction::[Effect{result:@next, operation:$exile_one_for_return}, Effect{result:@next, operation:Move{objects:@exile_followup(InZone{objects:One(Result{result:@prior, phase:After, index:0}), zone:Exile}), destination:$return_him_transformed_owner_destination, qualifiers:[]}}] */
instructions_exile_return_him_shared ::= exile_one_for_return "," "then" return_him_transformed_owner_destination

/* The affected set, pump and duration remain independent operands. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($named_creature)), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot} */
willing_additional_pump ::= named_creature "gets" "an" "additional" signed "/" signed duration

/* The return consumes the actual exile arrival and assigns its new controller. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($self_explicit_ref), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:@exile_followup(InZone{objects:One(Result{result:@prior, phase:After, index:0}), zone:Exile}), destination:Battlefield{controller:Player(OneOf(OpponentsOf(AbilityController))), arrival:BattlefieldArrival{}}, qualifiers:[]}}] */
instructions_self_exile_return_opponent ::= "exile" self_explicit_ref "," "then" "return" "it" "to" "the" "battlefield" "under" "an" "opponent's" "control"

/* The announced graveyard card is exiled before an independent continuation. */
/* @sem Operation::Move{objects:$bounded_graveyard_card_target, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_bounded_graveyard_card ::= "exile" bounded_graveyard_card_target

/* The singular token is the recipient of the following counter placement. */
/* @sem Instruction::[Effect{result:@next, operation:$create_one_defined}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@prior)), kind:$counter_kind, amount:$number}]}}] */
created_token_counters ::= create_one_defined "." "put" number counter_kind "counters" "on" "it"

/* @sem Instruction::[Effect{result:@next, operation:$exile_bounded_graveyard_card}, ...$created_token_counters] */
instructions_bounded_exile_then ::= exile_bounded_graveyard_card "." created_token_counters

/* These actions are scoped to a condition establishing the creature attached
   to the Aura's host; the two attachment links remain distinct. */
/* @sem Operation::Destroy{objects:One(AttachedTo(AttachedTo(Source))), regeneration:true} */
attached_host_creature_destroy ::= "destroy" "that" "creature"

/* @sem Operation::SetTapped{objects:One(AttachedTo(AttachedTo(Source))), tapped:true} */
attached_host_creature_tap ::= "tap" "that" "creature"

/* @sem Operation::SetTapped{objects:One(AttachedTo(AttachedTo(Source))), tapped:false} */
attached_host_creature_untap ::= "untap" "that" "creature"

attached_host_creature_action ::= attached_host_creature_destroy | attached_host_creature_tap | attached_host_creature_untap

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$attached_host_creature_action}]} */
attached_host_creature_program ::= attached_host_creature_action "."

/* The bound counter count is sampled before the optional selection. */
/* @sem Instruction::[Effect{result:@next, operation:BindValue{value:$activation_counter_count}}, Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:BoundValue(@prior)}}])}), count:AsManyAsCan($counter_amount)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}] */
/* @prefer always */
clause_optional_counter_value_hand_entry ::= "you" "may" "put" counter_amount filter_phrase "card" "with" "mana" "value" "X" "or" "less" "from" "your" "hand" "onto" "the" "battlefield" "," "where" "X" "is" activation_counter_count

/* Preserve the written then-sequence when this optional phrase follows a clause. */
/* @sem Vec<Instruction>::@then_sequence($clause_before_then, $clause_optional_counter_value_hand_entry) */
/* @prefer always */
instructions_then_optional_counter_value_entry ::= clause_before_then "," "then" clause_optional_counter_value_hand_entry

/* Each component retains its own amount and recipient set. */
/* @sem DamagePart::DamagePart{recipients:Objects($affected), amount:$value} */
damage_part_objects ::= value "damage" "to" affected

damage_part_additional ::= damage_part_additional_value | damage_part_additional_an

/* @sem Operation::DealDamageParts{source:$object_ref, parts:[$damage_part_objects, $damage_part_additional], preventable:true} */
deal_damage_with_additional ::= object_ref "deals" damage_part_objects "and" damage_part_additional

/* The damage source remains the sacrificed creature, using its last-known identity. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:One(Source)}}, Effect{result:@next, operation:DealDamage{source:Source, recipients:$recipients, amount:$number, preventable:true}}] */
instructions_sacrifice_self_and_damage ::= "sacrifice" self_creature "and" "it" "deals" number "damage" "to" recipients

/* A bounded hand choice retains its card type and mana-value predicate. */
/* @sem ObjectFilter::AllOf([$card_filter, $modifier_mana_value_bound]) */
hand_entry_card_bounded ::= card_filter "card" modifier_mana_value_bound

/* The singular host is the arrival produced by this manifest action. */
/* @sem Instruction::[Effect{result:@next, operation:$manifest_one}, Effect{result:@next, operation:Attach{attachments:$affected, host:Result{result:@prior, phase:After, index:0}}}] */
manifest_one_and_attach ::= manifest_one "and" "attach" affected "to" "it"

/* @sem Instruction::[...$become_aura_with_enchant, ...$manifest_one_and_attach] */
aura_conversion_manifest_program ::= become_aura_with_enchant "." manifest_one_and_attach

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:_{instructions:$aura_conversion_manifest_program}} */
triggered_aura_conversion_manifest ::= event_clause "," aura_conversion_manifest_program "."

/* Count the defending player's own cards bearing the named counter in exile. */
/* @sem Expr::CountObjects(Zone{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(One(DefendingPlayerOf(Source))), Counters{kind:$counter_kind, comparison:Greater, value:Constant(0)}])}) */
defending_exile_counter_count ::= "each" "card" "they" "own" "in" "exile" "with" "a" counter_kind "counter" "on" "it"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(DefendingPlayerOf(Source)), amount:$defending_exile_counter_count}}]} */
defending_exile_counter_life ::= "defending" "player" "loses" "1" "life" "for" defending_exile_counter_count

/* The chosen copy is restricted to the immediately preceding exile arrival.
   Its producer is kept in the enclosing composition for the inverse. */
/* @sem Instruction::[Effect{result:@next, operation:CopyCards{actor:One(AbilityController), objects:Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$adjective_nontype, $adjective_nontype_2, InSet(Transition{result:@prior, phase:After})])}, times:Constant(1)}}, $copy_cast_free] */
copy_selected_exile_arrival ::= "choose" "a" adjective_nontype "," adjective_nontype "card" "from" "among" "them" "and" "copy" "it" "." copy_cast_free

/* @sem Instruction::[...$clause_random_graveyard_cards, ...$copy_selected_exile_arrival] */
instructions_random_graveyard_selected_copy ::= clause_random_graveyard_cards "." copy_selected_exile_arrival

/* A single targeted battlefield exile supplies the exact arrival used by the
   subsequent owner's permission; both instructions are scoped together. */
/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$adjective_nontype}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
owner_permission_target_exile ::= "exile" "target" adjective_nontype "permanent"

/* @sem Operand::Term{family:SpellEffect, form:If, operands:[Condition(ObjectMatches{object:Scoped, filter:Cast{by:OpponentsOf(AbilityController)}}), Term{family:SpellEffect, form:IncreaseManaCost, operands:[Term{family:ManaSymbol, form:ManaCostGeneric, operands:[Integer($number)]}]}]} */
opponent_cast_permission_tax ::= "a" "spell" "cast" "by" "an" "opponent" "this" "way" "costs" "{" NUMBER "}" "more" "to" "cast"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$owner_permission_target_exile}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(OwnerOf(Result{result:@prior, phase:After, index:0}))), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:Either, filter:Any}, terms:_{cost:Normal, effects:[List([$opponent_cast_permission_tax])]}})], duration:WhileExiled(Result{result:@prior, phase:After, index:0}), evaluation:LiveObjects}}]} */
program_target_exile_owner_opponent_tax ::= owner_permission_target_exile "." "for" "as" "long" "as" "that" "card" "remains" "exiled" "," "its" "owner" "may" "play" "it" "." opponent_cast_permission_tax

/* @sem Ability::Spell{announcement:@announcement, body:$program_target_exile_owner_opponent_tax} */
spell_target_exile_owner_opponent_tax ::= program_target_exile_owner_opponent_tax "."

/* A roll table keeps the target and the die result in the enclosing spell. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One($target_permanent), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@mark, operation:$roll_die_action}, Group{instructions:[$target_controller_die_range_row, $target_controller_die_range_row_2, $target_controller_die_exact_row]}]}} */
spell_exile_target_controller_die_table ::= "exile" target_permanent "," "then" roll_die_action "." NEWLINE target_controller_die_range_row "." NEWLINE target_controller_die_range_row "." NEWLINE target_controller_die_exact_row "."

/* @sem Instruction::If{condition:AllOf([Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:LessOrEqual, value:$number_2}}]), then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(ControllerOf(Target{slot:@last_slot, index:0})), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$singular_counted_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{}} */
target_controller_die_range_row ::= number "―" number "|" "its" "controller" "creates" "a" singular_counted_token_recipe

/* @sem Instruction::If{condition:Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:Equal, value:$number}}, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(ControllerOf(Target{slot:@last_slot, index:0})), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$singular_counted_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{}} */
target_controller_die_exact_row ::= number "|" "its" "controller" "creates" "a" singular_counted_token_recipe

/* The receipt is bound to this specific mill, including its player and amount. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:AnyOf([$filter_phrase, $filter_phrase_2])}, count:UpTo($value)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]} */
program_mill_union_hand ::= "mill" card_count "." "you" "may" "put" "up" "to" value filter_phrase "and" "/" "or" filter_phrase "cards" "from" "among" "the" "milled" "cards" "into" "your" "hand"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, count:UpTo($value)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]} */
program_up_to_hand_battlefield ::= "you" "may" "put" "up" "to" value filter_phrase "cards" "from" "your" "hand" "onto" "the" "battlefield"

/* The return refers to the destination incarnation of the graveyard event. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]} */
chosen_graveyard_followup ::= "return" "that" "card" "to" "the" "battlefield" "under" "its" "owner's" "control"

/* The observed hand and the face-down movement name the same targeted player. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One($target_possessive)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:Move{objects:Zone{scope:Players{zone:Hand, players:One(Target{slot:0, index:0})}, kind:Card, filter:Any}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{}}, qualifiers:[]}}] */
look_hand_exile_face_down ::= "look" "at" target_possessive "hand" "and" "exile" "those" "cards" "face" "down"

/* Both later references consume this exact exile arrival. The owner of each
   card in the named hand is the targeted player. Keep the full receipt scope
   together for inverse printing. */
/* @sem Program::Program{instructions:[...$look_hand_exile_face_down, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:Either, filter:Any}, terms:_{cost:Normal, spend_as:AnyType, effects:[Program{instructions:[Effect{result:@next, operation:Draw{players:One(Target{slot:0, index:0}), amount:$hand_exile_draw_amount}}]}]}})], duration:EndOfTurn, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@back(5), phase:After}, zone:Exile}, destination:OwnersHand(CardArrival{}), qualifiers:[]}}]}}}]} */
hand_exile_play_return_program ::= look_hand_exile_face_down "." "you" "may" "play" "those" "cards" "this" "turn" "," "and" "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "them" "." "until" "end" "of" "turn" "," "whenever" "you" "play" "a" "land" "or" "cast" "a" "spell" "this" "way" "," "its" "owner" "draws" hand_exile_draw_amount "." "at" "the" "beginning" "of" "the" "next" "end" "step" "," "return" "the" "exiled" "cards" "to" "their" "owner's" "hand"

hand_exile_draw_amount ::= hand_exile_draw_one | hand_exile_draw_many

/* @sem Expr::Constant(1) */
hand_exile_draw_one ::= "a" "card"

/* @sem $count_plural */
hand_exile_draw_many ::= count_plural "cards"

/* One life per snow mana spent on the specified spell. */
/* @sem Operation::GainLife{players:One(AbilityController), amount:ManaSpent{object:$object_ref, filter:_{snow:true}, aggregation:Count}} */
gain_life_each_snow_spent ::= "you" "gain" "1" "life" "for" "each" "{" "S" "}" "spent" "to" "cast" object_ref

/* Preserve the put/onto wording for a qualified optional graveyard target. */
/* @prefer always */
/* @sem Operation::Move{objects:@zone_members(ObjectSet::@implicit_card_set(ObjectSet::One($target_card_up_to_qualified_a_graveyard))), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
put_qualified_graveyard_target_owner ::= "put" target_card_up_to_qualified_a_graveyard "onto" "the" "battlefield" "under" "its" "owner's" "control"

/* Used only within the activation that proves the singular discard receipt. */
/* @sem Operation::DealDamage{source:$object_ref, recipients:$recipients, amount:ObjectProperty{object:Query{objects:CostObjects{payment:Activation, component:[1], view:Inputs, phase:Before}, index:0}, property:$stat, information:CurrentOrLastKnown}, preventable:true} */
discard_paid_property_damage ::= object_ref "deals" "damage" "to" recipients "equal" "to" "the" stat "of" "the" "discarded" "card"

/* The named player chooses from the printed battlefield filter, then taps the selected permanents. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$player_ref, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan($count_each)}}, Effect{result:@next, operation:SetTapped{objects:Selected(@prior), tapped:true}}] */
clause_player_taps_counted_permanent ::= player_ref "taps" "an" filter_phrase "for" "each" count_each

/* The land is the target introduced by earthbending immediately before this instruction. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects(One(Target{slot:@last_slot, index:0})), kind:$counter_kind, amount:Constant(1)}]} */
put_additional_counter_bent_land ::= "put" "an" "additional" counter_kind "counter" "on" "that" "land"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$earthbend_action}, If{condition:$condition_cast_spell_subtype, then:Program{instructions:[Effect{result:@next, operation:$put_additional_counter_bent_land}]}, otherwise:Program{}}]} */
earthbend_cast_spell_followup ::= earthbend_action "." "if" condition_cast_spell_subtype "," put_additional_counter_bent_land

/* Scope the creature antecedent together with the attached arrival. */
/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_target_creature_from_your_graveyard ::= "return" "target" "creature" "card" "from" "your" "graveyard" "to" "the" "battlefield"

/* @sem Instruction::[Effect{result:@next, operation:$return_target_creature_from_your_graveyard}, Effect{result:@next, operation:Move{objects:$target_up_to_subtype_pair_your_graveyard, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo(Result{result:@prior, phase:After, index:0})]}}, qualifiers:[]}}] */
instructions_return_creature_attached_pair ::= return_target_creature_from_your_graveyard "," "then" "return" target_up_to_subtype_pair_your_graveyard "to" "the" "battlefield" "attached" "to" "that" "creature"

/* The condition applies before the destroy; the follow-up qualifies that action. */
/* @prefer always */
/* @sem Instruction::[@resolution(Instruction::If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One($unregenerable_target), regeneration:false}}]}, otherwise:Program{}})] */
instructions_destroy_creature_condition_unregenerable ::= "destroy" unregenerable_target "if" condition "." "a" "creature" "destroyed" "this" "way" "can't" "be" "regenerated"

/* Every destroyed target of this phrase is a permanent. */
/* @prefer always */
/* @sem Instruction::[@resolution(Instruction::If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One($target_permanent), regeneration:false}}]}, otherwise:Program{}})] */
instructions_destroy_permanent_condition_unregenerable ::= "destroy" target_permanent "if" condition "." "a" "permanent" "destroyed" "this" "way" "can't" "be" "regenerated"

/* Keep the choice, payment and copy together: the copy consumes this payment's
   recorded selected objects, not an unrelated prior result. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseAndPay{actor:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), @agree(@agree($plural, $plural_2), @agree($plural_3, $noun)), TargetableBy(EventSubject)])}, cost:_{parts:[Mana($mana_symbols)]}}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:_{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:Each(Zone{scope:Shared(Battlefield), kind:Permanent, filter:InSet(Recorded(@back(3)))})}}]}, otherwise:_{}}] */
instructions_choose_paid_spell_copies ::= "you" "may" "choose" "any" "number" "of" "other" plural "that" "spell" "could" "target" "and" "pay" mana_symbols "for" "each" "of" "those" plural "." "if" "you" "do" "," "for" "each" "of" "those" plural "," "copy" "that" "spell" "." "the" "copy" "targets" "that" noun

/* The selected arrivals are tied to this mill in both directions. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:$players_singular, amount:$card_count}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$milled_return_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
instructions_player_mill_choose_battlefield ::= players_singular "mills" card_count "." "then" "you" "put" "a" milled_return_filter "card" "from" "among" "the" "milled" "cards" "onto" "the" "battlefield" "under" "your" "control"

/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:$players_singular, amount:$card_count}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$milled_return_filter}, count:AsManyAsCan($count_plural)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
instructions_player_mill_choose_battlefield_many ::= players_singular "mills" card_count "." "then" "you" "put" count_plural milled_return_filter "cards" "from" "among" "the" "milled" "cards" "onto" "the" "battlefield" "under" "your" "control"

/* The populate and both follow-ups share the same created-token receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Populate{}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Created(@prior)), changes:[GrantKeyword($keyword_name)], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(@back(4))})}]}}}] */
instructions_populate_grant_sacrifice ::= "populate" "." "the" "token" "created" "this" "way" "gains" keyword_name "." "sacrifice" "it" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* A population of graveyard cards enters under each card owner's control. */
/* @sem Operation::Move{objects:$return_all_graveyard_population, destination:$plural_owner_battlefield_destination, qualifiers:[]} */
return_graveyard_population_battlefield ::= "return" return_all_graveyard_population "to" "the" "battlefield" plural_owner_battlefield_destination

/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
plural_owner_battlefield_destination ::= "under" "their" "owners'" "control"

/* The destroyed population is restricted to artifacts, so the later noun and
   both Before receipts refer to this exact producer, including on printing. */
/* @sem Instruction::[Effect{result:@mark, operation:Destroy{objects:$destroyed_artifact_population, regeneration:false}}, ForEachPlayer{players:Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:ControlledBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}, binding:0, body:_{instructions:[Effect{result:@next, operation:GainLife{players:One(Bound(0)), amount:Aggregate{objects:Matching{objects:Transition{result:@marked, phase:Before}, filter:ControlledBy(One(Bound(0)))}, property:$destroy_total_property, aggregation:Sum}}}]}}] */
instructions_destroy_artifacts_controller_property ::= "destroy" destroyed_artifact_population "." "they" "can't" "be" "regenerated" "." "the" "controller" "of" "each" "of" "those" "artifacts" "gains" "life" "equal" "to" "its" destroy_total_property

destroyed_artifact_population ::= destroyed_all_artifacts | destroyed_controlled_artifacts

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Artifact)} */
destroyed_all_artifacts ::= "all" "artifacts"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Artifact), $modifier_you_control])} */
destroyed_controlled_artifacts ::= "all" "artifacts" modifier_you_control

/* The subject and amount refer to the preceding event, not the ability controller. */
/* @sem Operation::DealDamage{source:EventSubject, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:$noun, players:OpponentsOf(AbilityController)})), amount:EventAmount, preventable:true} */
shared_she_event_amount_damage ::= "she" "deals" "that" "much" "damage" "to" "target" "opponent" "or" noun

/* The participation count is scoped to this exact optional copy action. */
/* @sem Instruction::[$opponent_spell_copy_receipt_loop, $opponent_spell_copy_receipt_bonus] */
opponent_spell_copy_receipt_sequence ::= opponent_spell_copy_receipt_loop "." opponent_spell_copy_receipt_bonus

/* @sem Instruction::ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@mark, operation:CopyOnStack{actor:One(Bound(0)), object:$target_stack_spell, times:Constant(1), targets:May}}]}}]}} */
opponent_spell_copy_receipt_loop ::= "choose" target_stack_spell "." "each" "opponent" "may" "copy" "that" "spell" "and" "may" "choose" "new" "targets" "for" "the" "copy" "they" "control"

/* @sem Instruction::Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$opponent_copy_spell_ref, times:Add([Constant(1), CountPlayers(Matching{binding:0, condition:PlayerTook{player:Bound(0), result:@marked}})]), targets:May}} */
opponent_spell_copy_receipt_bonus ::= "you" "copy" opponent_copy_spell_ref "once" "plus" "an" "additional" "time" "for" "each" "opponent" "who" "copied" "the" "spell" "this" "way" "." "you" "may" "choose" "new" "targets" "for" "the" "copies" "you" "control"

opponent_copy_spell_ref ::= opponent_copy_named_spell | object_ref

/* @prefer always */
/* @sem ObjectRef::@remember_operand(ObjectRef::@qualified_object(ObjectKind::Spell, ObjectFilter::Any)) */
opponent_copy_named_spell ::= "that" "spell"

/* The target announcement is shared independently of its movement; the
   trailing definition identifies this enchantment's kick count. */
/* @sem Operation::Move{objects:$kicked_graveyard_targets, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_kicked_graveyard_targets ::= "return" kicked_graveyard_targets "to" "the" "battlefield" "," "where" "X" "is" "the" "number" "of" "times" "this" "enchantment" "was" "kicked"

/* A population and its destination remain independent move operands. */
/* @sem Operation::Move{objects:$return_all_graveyard_population, destination:$owners_battlefield_destination, qualifiers:[]} */
return_all_graveyard_to_owner_battlefield ::= "return" return_all_graveyard_population owners_battlefield_destination

owners_battlefield_destination ::= owners_battlefield_tapped | owners_battlefield_untapped

/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}} */
owners_battlefield_tapped ::= "to" "the" "battlefield" "tapped" "under" "their" "owners'" "control"

/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
owners_battlefield_untapped ::= "to" "the" "battlefield" "under" "their" "owners'" "control"

/* The chosen creature and the immediately preceding roll supply the even-result placement. */
/* @sem Instruction::[Effect{result:@next, operation:$roll_six_sided_dice}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($parity_chosen_creature)), kind:$counter_kind, amount:Multiply([$value, Dice(Matching([SameParity, Constant(0)]))])}]}}] */
chosen_creature_roll_even_counters ::= "choose" parity_chosen_creature "." roll_six_sided_dice "." "for" "each" "even" "result" "," "put" value counter_kind "counters" "on" "that" "creature"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0} */
parity_chosen_creature ::= "target" "creature"

/* The token count refers to the same immediately preceding dice roll. */
/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[_{amount:Dice(Matching([SameParity, Constant(1)])), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
create_for_odd_dice ::= "for" "each" "odd" "result" "," "create" "a" token_recipe

/* @sem Instruction::[...$chosen_creature_roll_even_counters, Effect{result:@next, operation:$create_for_odd_dice}] */
instructions_chosen_roll_parity ::= chosen_creature_roll_even_counters "." create_for_odd_dice

/* The phrase is usable only with a producer scoped by its enclosing instruction. */
/* @sem ObjectFilter::$filter_phrase */
milled_return_card_filter ::= filter_phrase "card" "milled" "this" "way"

/* Both directions require this mill and its own arrival receipt. */
/* @sem Vec<Instruction>::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$milled_return_card_filter}, count:Exactly($counter_a), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
mill_then_return_matching ::= "mill" card_count "," "then" "return" counter_a milled_return_card_filter "to" "your" "hand"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$mill_then_return_matching}} */
spell_mill_then_return_matching ::= mill_then_return_matching "."

/* The destination is chosen on resolution and differs from the current host. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(SameObject(AttachedTo(@named_object))), $filter_phrase)}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Attach{attachments:One($it_ordinary_pronoun), host:Result{result:@prior, phase:After, index:0}}}] */
clause_attach_it_to_another_enchantable ::= "attach" it_ordinary_pronoun "to" "another" filter_phrase "it" "can" "enchant"

/* Keep the recorded return and the player count in one producer-consumer scope. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$recent_graveyard_targets, destination:$recent_return_destination, qualifiers:[]}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountPlayers(Intersection([$players_singular, Matching{binding:0, condition:Controls{player:Bound(0), filter:InSet(Recorded(@prior)), minimum:1}}]))}}] */
return_recent_targets_draw_controllers ::= recent_graveyard_targets "." "return" "them" recent_return_destination "." "you" "draw" "a" "card" "for" players_singular "who" "controls" "one" "or" "more" "of" "those" "permanents"

recent_return_destination ::= recent_return_tapped_owner | recent_return_owner

/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}} */
recent_return_tapped_owner ::= "to" "the" "battlefield" "tapped" "under" "their" "owners'" "control"

/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
recent_return_owner ::= "to" "the" "battlefield" "under" "their" "owners'" "control"

/* @prefer always */
/* @sem Operation::Move{objects:$graveyard_typed_ability_many, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_graveyard_ability_targets ::= "return" graveyard_typed_ability_many "to" "the" "battlefield"

/* Scope the producer and consumer together: the arrival receipt must come from milling. */
/* @sem Instruction::[Effect{result:@next, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@prior, phase:After}, filter:$filter_phrase}, count:AnyNumber}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_mill_any_number_to_hand ::= "mill" card_count "," "then" "put" "any" "number" "of" filter_phrase "cards" "milled" "this" "way" "into" "your" "hand"

/* The spell and its sole target are those of the enclosing cast event. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:Each($event_other_legal_copy_targets)}}]} */
program_copy_event_for_other_legal_targets ::= "copy" "the" "spell" event_other_legal_copy_targets "."

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(SoleTargetOf(EventSubject))), @agree($filter_phrase, $filter_plural)])} */
event_other_legal_copy_targets ::= "for" "each" "other" filter_phrase "that" "spell" "could" "target" "." "each" "copy" "targets" "a" "different" "one" "of" "those" filter_plural

/* Random opponent selection and its success/failure continuation share a payment receipt. */
/* @sem PlayerSet::Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Not(PlayerDid{player:Bound(0), event:AttackedBy(SameObject(Source)), window:LastCombatOf(AbilityController)})}]) */
random_opponent_not_attacked_last_combat ::= "an" "opponent" "at" "random" "that" "this" "creature" "didn't" "attack" "during" "your" "last" "combat"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[Rule(RequireCombat{action:Attack(Players(One(Chosen))), amount:AtLeast(Constant(1))})], duration:$this_duration, evaluation:LiveObjects} */
chosen_opponent_required_attack ::= "this" "creature" "attacks" "that" "player" this_duration "if" "able"

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseAtRandom{kind:Player, options:[Players($random_opponent_not_attacked_last_combat)]}}]}}]}, optional:false}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:$chosen_opponent_required_attack}]}, otherwise:Program{instructions:[Effect{result:@next, operation:SetTapped{objects:One(Source), tapped:true}}]}}]} */
random_opponent_combat_or_tap ::= "choose" random_opponent_not_attacked_last_combat "." chosen_opponent_required_attack "." "if" "you" "can't" "choose" "an" "opponent" "this" "way" "," "tap" "this" "creature"

/* The next named step carries its own event; the following clause retains its actor and operands. */
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_next_your_step, start:Immediately, body:Program{instructions:[...$clause_you]}}}] */
clause_delayed_next_you ::= "at" delayed_next_your_step "," clause_you

delayed_next_your_step ::= delayed_your_end | delayed_your_upkeep

/* A declined payment can establish a recurring trigger for the current combat. */
/* @sem Ability::Triggered{event:$turn_combat_each, limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Mana($mana_symbols)]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:$combat_pair_temporary_trigger}]}, otherwise:Program{}}]}} */
combat_unless_payment_trigger ::= "at" turn_combat_each "," "unless" "you" "pay" mana_symbols "," combat_pair_temporary_trigger "."

/* @sem Operation::CreateTrigger{event:$event_blocks_or_blocked, duration:EndOfCombat, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$combat_pair_keyword_grant}]}} */
combat_pair_temporary_trigger ::= "whenever" event_blocks_or_blocked "this" "combat" "," combat_pair_keyword_grant

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(BlockPair(Other))), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot} */
combat_pair_keyword_grant ::= "that" "creature" "gains" keyword_name duration

/* A measured reveal-cost card is available only inside the paired casting scope. */
/* @sem Expr::Earlier{what:Revealed, measure:Of($receipt_stat)} */
casting_revealed_card_stat ::= "the" "revealed" "card's" receipt_stat

/* @sem Operation::DealDamage{source:$object_ref, recipients:$recipients, amount:$casting_revealed_card_stat, preventable:true} */
casting_reveal_measured_damage ::= object_ref "deals" "damage" "to" recipients "equal" "to" casting_revealed_card_stat

/* @sem Ability::[Casting(AdditionalCost{cost:Cost{parts:[$cost_reveal_filtered_from_hand]}, repetition:Once}), Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$casting_reveal_measured_damage}]}}] */
line_casting_reveal_measured_damage ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," cost_reveal_filtered_from_hand "." NEWLINE casting_reveal_measured_damage "."

/* The mana-value qualifier applies to each target in the opponent partition. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:OpponentsOf(AbilityController), each:UpTo(Constant(1))}, filter:AllOf([$filter_phrase, $modifier_mana_value_bound])})) */
each_opponent_mana_qualified_target ::= "up" "to" "one" "target" filter_phrase "that" "player" "controls" modifier_mana_value_bound

/* The excess count refers to the immediately preceding damage to this same target. */
excess_damageable_noun ::= noun_creature | noun_planeswalker | noun_battle

/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@agree($excess_damageable_noun, $excess_damageable_noun_2)}), index:0})), amount:$number, preventable:true}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:ExcessDamage{result:@prior, to:SameObject(Target{slot:@last_slot, index:0})}, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}}] */
instructions_damage_excess_tapped_named ::= damage_source_ref "deals" number "damage" "to" "target" excess_damageable_noun "." "create" "a" "number" "of" "tapped" token_named_recipe "tokens" "equal" "to" "the" "amount" "of" "excess" "damage" "dealt" "to" "that" excess_damageable_noun "this" "way"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_damage_excess_tapped_named}} */
spell_damage_excess_tapped_named ::= instructions_damage_excess_tapped_named "."

/* A postposed condition selects a replacement operation over the initial operation. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:$conditional_replacement_operation}]}, otherwise:Program{instructions:[Effect{result:@next, operation:$conditional_initial_operation}]}}] */
instructions_conditional_operation_replacement ::= conditional_initial_operation "." NEWLINE? "if" condition "," conditional_replacement_operation "instead"

conditional_initial_operation ::= deal_damage | tap_objects

conditional_replacement_operation ::= destroy | gain_control_of

aura_upkeep_creature_ref ::= aura_upkeep_that_creature | aura_upkeep_the_creature

/* @prefer always */
/* @sem ObjectRef::EventSubject */
aura_upkeep_that_creature ::= "that" "creature"

/* @sem ObjectRef::EventSubject */
aura_upkeep_the_creature ::= "the" "creature"

/* Keep the mill and its selected arrivals in one inverse-print contract. */
/* @sem Instruction::[Effect{result:@next, operation:Mill{players:$players_singular, amount:$card_count}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@prior, phase:After}, filter:AllOf([$filter_phrase, Property{property:ManaValue, test:$number_parity}])}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
instructions_mill_parity_battlefield ::= players_singular "mills" card_count "." "put" "a" filter_phrase "card" "with" "an" number_parity "mana" "value" "from" "among" "the" "milled" "cards" "onto" "the" "battlefield" "under" "your" "control"

/* The fight's second participant is also the excess-damage recipient.  The
   callback has its own announcement and composes with any supported program. */
/* @sem Operation::WithReflexive{action:Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:ObjectRef::@reflexive_moved_fight_object($object_ref), second:$fight_excess_opponent_target}}, when:ExcessDamage($fight_excess_opponent_target), body:Ability(@scope(Ability::Spell{body:$program, announcement:@announcement}))} */
fight_excess_callback ::= object_ref "fights" fight_excess_opponent_target "." "when" "excess" "damage" "is" "dealt" "to" "the" "creature" "an" "opponent" "controls" "this" "way" "," program

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(OpponentsOf(AbilityController))])}), index:0} */
fight_excess_opponent_target ::= "target" "creature" "an" "opponent" "controls"

/* The temporary change and the fight share the exact target; the callback is
   independently scoped and may contain any supported instruction program. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_object)), changes:$fight_singular_pump, duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:WithReflexive{action:Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:$target_object, second:$fight_excess_opponent_target}}, when:ExcessDamage($fight_excess_opponent_target), body:Ability(@scope(Ability::Spell{body:$program, announcement:@announcement}))}}] */
instructions_target_changes_fight_excess ::= target_object fight_singular_pump duration "." "it" "fights" fight_excess_opponent_target "." "when" "excess" "damage" "is" "dealt" "to" "the" "creature" "an" "opponent" "controls" "this" "way" "," program

/* @sem Change::[Pump{power:$signed, toughness:$signed_2}] */
fight_singular_pump ::= "gets" signed "/" signed

/* These phrases refer to the sole target of the enclosing cast event. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(SoleTargetOf(EventSubject))), changes:[SetController(AbilityController)], duration:$sole_target_duration, evaluation:Snapshot} */
sole_target_gain_control ::= "gain" "control" "of" "that" "creature" sole_target_duration

/* @sem Operation::SetTapped{objects:One(SoleTargetOf(EventSubject)), tapped:false} */
sole_target_untap ::= "untap" "that" "creature"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(SoleTargetOf(EventSubject))), changes:[GrantKeyword($keyword_name)], duration:$sole_target_duration, evaluation:Snapshot} */
sole_target_gains_keyword ::= "it" "gains" keyword_name sole_target_duration

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$sole_target_gain_control}, If{condition:$condition_your_turn, then:Program{instructions:[Effect{result:@next, operation:$sole_target_untap}, Effect{result:@next, operation:$sole_target_gains_keyword}]}, otherwise:Program{}}]} */
sole_target_conditional_program ::= sole_target_gain_control "." "if" condition_your_turn "," sole_target_untap "and" sole_target_gains_keyword "."

sole_target_duration ::= sole_target_until_end_turn | sole_target_until_end_combat | duration

/* @prefer always */
/* @sem Duration::EndOfTurn */
sole_target_until_end_turn ::= "until" "end" "of" "turn"

/* @prefer always */
/* @sem Duration::EndOfCombat */
sole_target_until_end_combat ::= "until" "end" "of" "combat"

/* The amount phrase is supplied only by a surrounding producer contract. */
/* @sem Operation::DealDamage{source:$object_ref, recipients:Objects($affected), amount:$damage_x_definition, preventable:true} */
damage_x_where_defined ::= object_ref "deals" "X" "damage" "to" affected "," "where" "X" "is" damage_x_definition

/* @sem Expr::PaidCountersRemoved{payment:Activation, component:[1]} */
damage_x_definition ::= "the" "number" "of" "counters" "removed" "this" "way"

/* A shared plural sacrifice operation keeps the player and population independent. */
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:$players_singular, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$sacrifice_plural_population}}) */
sacrifice_all_controlled_plural ::= players_singular "sacrifices" "all" sacrifice_plural_population "they" "control"

sacrifice_plural_population ::= sacrifice_plural_three | sacrifice_plural_one

/* @sem ObjectFilter::AnyOf([$filter_plural, $filter_plural_2, $filter_plural_3]) */
sacrifice_plural_three ::= filter_plural "," filter_plural "," "and" filter_plural

/* @sem $filter_plural */
sacrifice_plural_one ::= filter_plural

/* Both choices refer to the same bounded pair returned to the battlefield. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Move{objects:$return_pair_total_targets, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Transition{result:@marked, phase:After}), kind:$counter_kind, amount:Constant(1), selection:_{player:AbilityController, count:AsManyAsCan(Constant(1))}}]}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Transition{result:@marked, phase:After}), kind:$counter_kind_2, amount:Constant(1), selection:_{player:AbilityController, count:AsManyAsCan(Constant(1))}}]}}]} */
program_return_pair_counter_choices ::= "return" return_pair_total_targets "to" "the" "battlefield" "." "put" "a" counter_kind "counter" "on" "either" "of" "them" "." "then" "put" "a" counter_kind "counter" "on" "either" "of" "them"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(2)), filter:AllOf([$card_filter, InZone(Players{zone:Graveyard, players:One(AbilityController)})]), constraints:[TotalProperty{property:ManaValue, comparison:LessOrEqual, amount:$number}]})) */
return_pair_total_targets ::= "up" "to" "two" "target" card_filter "cards" "with" "total" "mana" "value" number "or" "less" "from" "your" "graveyard"

/* @sem Instruction::[Effect{result:@next, operation:KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Goad{until:Indefinite}, objects:Transition{result:@marked, phase:After}}}, ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Transition{result:@marked, phase:After}, count:AsManyAsCan($counter_amount)}}]}}, ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Earlier{what:Selected, by:Bound(0)})), changes:[SetController(Bound(0))], duration:Indefinite, evaluation:Snapshot}}]}}] */
goad_arrivals_assign_control ::= "they're" "goaded" "for" "the" "rest" "of" "the" "game" "." "for" "each" "of" "those" "permanents" "," "choose" counter_amount "different" "opponent" "." players_singular "gains" "control" "of" "the" "permanent" "for" "which" "they" "were" "chosen"

/* @sem Instruction::[...$reveal_opponents_count_battlefield_shuffle, ...$goad_arrivals_assign_control] */
reveal_battlefield_goad_assign ::= reveal_opponents_count_battlefield_shuffle "." goad_arrivals_assign_control

/* Each secret hand choice is revealed only after all players have chosen. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseValue(_{choosers:One(Bound(0)), kind:Object, terms:_{options:[Filter(Any), Players(One(Bound(0)))], count:Exactly(Constant(1)), secret:true}})}]}}, ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:RevealChoices{kind:Object}}]}}] */
clause_each_hand_choice_reveal ::= "each" "player" "chooses" "a" "card" "in" "their" "hand" "." "then" "each" "player" "reveals" "their" "chosen" "card"

/* The owner's action retains the selected revealed object's identity. */
/* @sem Instruction::[ForEachPlayer{players:Matching{binding:0, condition:HadExtreme{player:Bound(0), what:Revealed, filter:$revealed_extreme_type, highest:false}}, binding:0, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Earlier{what:Revealed}), destination:Battlefield{controller:Owner, arrival:_{}}}}]}}] */
clause_owner_lowest_revealed_entry ::= "the" "owner" "of" "each" revealed_extreme_type "card" "revealed" "this" "way" "with" "the" "lowest" "mana" "value" "puts" "it" "onto" "the" "battlefield"

/* @sem Instruction::[ForEachPlayer{players:Matching{binding:0, condition:HadExtreme{player:Bound(0), what:Revealed, filter:$revealed_extreme_type, highest:true}}, binding:0, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Earlier{what:Revealed}), destination:Battlefield{controller:Owner, arrival:_{}}}}]}}] */
clause_owner_highest_revealed_entry ::= "the" "owner" "of" "each" revealed_extreme_type "card" "revealed" "this" "way" "with" "the" "highest" "mana" "value" "puts" "it" "onto" "the" "battlefield"

revealed_extreme_type ::= noun_creature | noun_artifact | noun_enchantment | noun_land | noun_planeswalker

/* Keep the reveal and its owner action in the same paragraph. */
/* @sem Instruction::[...$clause_each_hand_choice_reveal, ...$owner_revealed_extreme_entry] */
instructions_hand_choices_extreme_entry ::= clause_each_hand_choice_reveal "." owner_revealed_extreme_entry /* @prefer always */

owner_revealed_extreme_entry ::= clause_owner_lowest_revealed_entry | clause_owner_highest_revealed_entry

/* @prefer always */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_hand_choices_extreme_entry}} */
spell_hand_choices_extreme_entry ::= instructions_hand_choices_extreme_entry "."

/* A single choice may draw from a private hand or controlled battlefield. */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:Union([Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase_2}]), count:Exactly(Constant(1))} */
choose_hand_or_battlefield ::= "choose" "a" filter_phrase "card" "in" "your" "hand" "or" "a" filter_phrase

/* Both conditional effects refer to the same successful choice receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$choose_hand_or_battlefield}, If{condition:Compare{left:CountObjects(Recorded(@marked)), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Earlier{what:Selected}), changes:$static_changes}}]}, otherwise:Program{}}, If{condition:Compare{left:CountObjects(Recorded(@marked)), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Chosen), changes:$static_changes}}]}, otherwise:Program{}}] */
instructions_choice_perpetual ::= choose_hand_or_battlefield "." "it" "perpetually" static_changes

/* @sem Operation::CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:$action}]}} */
delayed_combat_action ::= action "at" "end" "of" "combat"

/* The target's type and event-amount limit remain operands of the return.
   This phrase is scoped by a damage trigger before the X definition is attached. */
/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:EventAmount}}, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
return_damage_bounded_card ::= "return" "target" card_filter "card" "with" "mana" "value" "X" "or" "less" "from" "your" "graveyard" "to" "the" "battlefield"

/* Scope the X definition to the exact source and recipient of the damage event. */
/* @sem Ability::Triggered{event:Damage{source_kind:Permanent, sources:SameObject(Source), recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$return_damage_bounded_card}]}}]}} */
damage_bounded_return_trigger ::= "whenever" "this" "creature" "deals" "combat" "damage" "to" "a" "player" "," "you" "may" return_damage_bounded_card "," "where" "X" "is" "the" "amount" "of" "damage" "this" "creature" "dealt" "to" "that" "player" "."

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Players{zone:Graveyard, players:One(EventSubject)}, kind:Card, filter:Any}), from:Graveyard, action:CastSpell, filter:$event_graveyard_cast_kind}, terms:_{limit:Total(1), cost:Normal, spend_as:AnyColor, into_exile:true}})], duration:$this_duration, evaluation:LiveObjects}}] */
event_graveyard_cast_exiling ::= "you" "may" "cast" "a" event_graveyard_cast_kind "spell" "from" "that" "player's" "graveyard" this_duration "," "and" "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "that" "spell"

/* Both branches are ordinary independent programs; the condition is checked on resolution. */
/* @sem Program::Program{instructions:[If{condition:$condition, then:$program, otherwise:$program_2}]} */
postfix_conditional_program ::= program "if" condition "." "otherwise" "," program

/* The named target supplies the player for both the history and the loss. */
/* @sem EventSpec::Player{event:LosesLife, players:One($life_history_target)} */
history_target_life_loss ::= life_history_target "loses" "life" "equal" "to" "the" "life" "that" "player" "lost" "this" "turn"

/* A zero history amount leaves the fallback; otherwise the same player loses that amount. */
/* @sem Instruction::[If{condition:Compare{left:EventHistory{event:$history_target_life_loss, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(Target{slot:@last_slot, index:0}), amount:EventHistory{event:$history_target_life_loss, window:ThisTurn, measure:TotalAmount}}}]}, otherwise:$program}] */
instructions_history_life_loss_fallback ::= history_target_life_loss "." "if" "no" "life" "is" "lost" "this" "way" "," program

/* A target receiving counters remains the land animated by the following sentence. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$counter_controlled_land_target}, Effect{result:@next, operation:$counter_land_animation}]} */
program_counter_target_land_animation ::= counter_controlled_land_target "." counter_land_animation "." "it's" "still" "a" "land" "."

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Land), ControlledBy(One(AbilityController))])}), index:0})), kind:$counter_kind, amount:$counter_amount}]} */
counter_controlled_land_target ::= "put" counter_amount counter_kind "counters" "on" "target" "land" "you" "control"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@last_slot, index:0})), changes:$counter_land_animation_changes, duration:Indefinite, evaluation:Snapshot} */
counter_land_animation ::= "that" "land" "becomes" "a" counter_land_animation_changes

/* The retained land wording carries no additional change to its land type. */
/* @sem Change::[SetBasePowerToughness{power:$number, toughness:$number_2}, CreatureTypes{mode:Add, types:Listed($becomes_types)}, GrantKeyword($keyword_name)] */
counter_land_animation_changes ::= number "/" number becomes_types "creature" "with" keyword_name

/* The permission is tied to the actual single face-up top-library exile. */
/* @sem Instruction::[...$single_library_card_exile_producer, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:Either, filter:Any}, terms:_{cost:Free}})], duration:$duration, evaluation:LiveObjects}}] */
instructions_top_card_fronted_free_permission ::= single_library_card_exile_producer "." duration "," "you" "may" "play" "that" "card" "without" "paying" "its" "mana" "cost"

/* A preceding operation does not change the exile receipt used by the continuation. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$operation}, ...$instructions_top_card_fronted_free_permission]}} */
spell_operation_then_top_card_free_permission ::= operation "." "then" instructions_top_card_fronted_free_permission "."

/* Both library positions produce one face-up exile receipt for the permission. */
single_library_card_exile_producer ::= card_exile_value_producer | bottom_library_card_exile_producer

/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Bottom}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
bottom_library_card_exile_producer ::= "exile" "the" "bottom" "card" "of" "your" "library"

/* The article belongs to the noun phrase; the receipt remains bound to its mill. */
/* @prefer always */
/* @sem ObjectFilter::$milled_return_filter */
milled_among_a ::= "a" milled_return_filter

/* @prefer always */
/* @sem ObjectFilter::CardType(Artifact) */
milled_among_artifact ::= "an" "artifact"

milled_among_indefinite ::= milled_among_a | milled_among_artifact

/* @prefer always */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$mill_optional_return_among_them}} */
triggered_mill_return_among ::= event_clause "," mill_optional_return_among_them "."

/* A population selected for destruction with regeneration prohibited. */
/* @sem Operation::Destroy{objects:$affected, regeneration:false} */
destroy_unregenerable_population ::= affected

/* The two choice branches and their aliases form one reusable producer. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[Program{instructions:[Effect{result:@next, operation:$destroy_unregenerable_population}]}, Program{instructions:[Effect{result:@next, operation:$destroy_unregenerable_population_2}]}]}, Effect{result:@next, operation:JoinResults{results:[@back(3), @back(2)]}}, Effect{result:@next, operation:JoinResults{results:[@back(4), @back(3)]}}] */
destroy_unregenerable_choice ::= "destroy" destroy_unregenerable_population "or" destroy_unregenerable_population "." "they" "can't" "be" "regenerated"

/* @sem Instruction::[...$destroy_unregenerable_choice, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:Multiply([$value, CountObjects(Matching{objects:Transition{result:@back(3), phase:Before}, filter:$filter_phrase})])}}] */
instructions_destroy_choice_death_loss ::= destroy_unregenerable_choice "." "you" "lose" value "life" "for" "each" filter_phrase "that" "died" "this" "way" "."

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_destroy_choice_death_loss}} */
spell_destroy_choice_death_loss ::= instructions_destroy_choice_death_loss

/* A selected card of each type moves to exile; its departure receipt is
   consumed only by the adjacent counter placement. */
/* @sem Vec<Instruction>::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One($each_type_graveyard_owner)}, kind:Card, filter:Any}, count:UpTo(Constant(9)), constraints:[OneForEach([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Instant), CardType(Kindred), CardType(Land), CardType(Planeswalker), CardType(Sorcery)])]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
each_type_graveyard_exile ::= "exile" "up" "to" "one" "card" "of" "each" "card" "type" "from" each_type_graveyard_owner "graveyard"

each_type_graveyard_owner ::= each_type_defender_graveyard | each_type_your_graveyard

/* @sem @defending */
each_type_defender_graveyard ::= "defending" "player's"

/* @sem PlayerRef::AbilityController */
each_type_your_graveyard ::= "your"

/* @prefer always */
/* @sem Instruction::[...$each_type_graveyard_exile, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:CountObjects(Transition{result:@prior, phase:Before})}]}}] */
instructions_each_type_exile_counters ::= each_type_graveyard_exile "." "put" "a" counter_kind "counter" "on" affected "for" "each" "card" "exiled" "this" "way"

/* The simultaneous creation reading retains the whole created batch as the
   recipient; the exile producer fixes the meaning of the Before receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($filter_plural, $filter_plural_2)}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateTokens{players:All, tokens:$token_groups, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:InSet(Recorded(@prior))}), kind:$counter_kind, amount:Aggregate{objects:Matching{objects:Transition{result:@marked, phase:Before}, filter:AllOf([$filter_plural_2, ControlledBy(One(Bound(0)))])}, property:$creature_stat, aggregation:Sum}}]}}]}}] */
instructions_exile_all_shared_tokens_exiled_stat ::= "exile" "all" filter_plural "." "each" "player" "creates" token_groups "and" "puts" "a" "number" "of" counter_kind "counters" "on" "it" "equal" "to" "the" "total" creature_stat "of" filter_plural "they" "controlled" "that" "were" "exiled" "this" "way"

/* Preserve the distinct source-attachment interpretation of this sequence. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(@remember_object($target_object))), changes:[SetController(AbilityController)], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:Attach{attachments:One($self_explicit_ref), host:Target{slot:@last_slot, index:0}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_control_loss_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Unattach{object:Target{slot:@last_slot, index:0}}}}]}}}] */
instructions_gain_control_source_attach_unattach ::= "gain" "control" "of" target_object duration "." "attach" "it" "to" self_explicit_ref "." "when" delayed_control_loss_event "," "unattach" "it"

/* Each opponent chooses a controlled permanent and a random library card,
   exiles both, and takes damage equal to their total mana value. */
/* @prefer always */
/* @sem Instruction::[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plain, ControlledBy(One(Bound(0)))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone(_{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:$card_filter}), count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Union([Selected(@back(3)), Selected(@prior)]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:DealDamage{source:$self_ref_named, recipients:Players(One(Bound(0))), amount:Aggregate{objects:Transition{result:@prior, phase:After}, property:ManaValue, aggregation:Sum}, preventable:true}}]}}] */
clause_each_opponent_exile_perm_random_library_damage_each ::= "each" "opponent" "exiles" ("a" | "an") filter_plain "they" "control" "and" "a" "random" card_filter "card" "from" "their" "library" "," "then" self_ref_named "deals" "damage" "to" "them" "equal" "to" "the" "total" "mana" "value" "of" "the" "cards" "exiled" "this" "way"

/* The shared exile producer and total-value consumer remain paired. */
/* @sem Instruction::[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plain, ControlledBy(One(Bound(0)))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone(_{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:$card_filter}), count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Union([Selected(@back(3)), Selected(@prior)]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}, Effect{result:@next, operation:DealDamage{source:$self_ref_named, recipients:Players(One(AbilityController)), amount:Aggregate{objects:Transition{result:@prior, phase:After}, property:ManaValue, aggregation:Sum}, preventable:true}}] */
clause_each_opponent_exile_perm_random_library_damage_scoped ::= "each" "opponent" "exiles" ("a" | "an") filter_plain "they" "control" "and" "a" "random" card_filter "card" "from" "their" "library" "," "then" self_ref_named "deals" "damage" "to" "them" "equal" "to" "the" "total" "mana" "value" "of" "the" "cards" "exiled" "this" "way"

/* Preserve the distinct last-choice receipt reading of the repeated process. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$target_opponent, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$uncontrolled_kind, ControlledBy(OthersThan(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ChooseObjects{player:Target{slot:@last_slot, index:0}, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$uncontrolled_kind_2, ControlledBy(OthersThan(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ChooseObjects{player:Target{slot:@last_slot, index:0}, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$uncontrolled_kind_3, ControlledBy(OthersThan(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ChooseObjects{player:Target{slot:@last_slot, index:0}, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$uncontrolled_kind_4, ControlledBy(OthersThan(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:Recorded(@back(3)), filter:OwnedBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}}}] */
instructions_repeat_top_library_last_choice_shuffle ::= target_opponent "chooses" uncontrolled_kind "you" "don't" "control" "and" "puts" "it" "on" "top" "of" "its" "owner's" "library" "," "then" "repeats" "this" "process" "for" uncontrolled_kind "," uncontrolled_kind "," "and" uncontrolled_kind "." "then" "the" "owner" "of" "each" "permanent" "chosen" "this" "way" "shuffles"

/* The return and the measurement share the same target and hand destination. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card_your_graveyard), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:Multiply([Constant(-1), ObjectProperty{object:$target_card_your_graveyard, property:$receipt_stat, information:CurrentOrLastKnown}]), toughness:Multiply([Constant(-1), ObjectProperty{object:$target_card_your_graveyard, property:$receipt_stat, information:CurrentOrLastKnown}])}], duration:$duration, evaluation:Snapshot}}] */
returned_card_stat_negative_pump ::= "return" target_card_your_graveyard "to" "your" "hand" "." affected "gets" "-" "X" "/" "-" "X" duration "," "where" "X" "is" "the" receipt_stat "of" "the" "card" "returned" "this" "way"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$returned_card_stat_negative_pump}} */
spell_returned_card_stat_negative_pump ::= returned_card_stat_negative_pump "."

/* A pair of named card categories can also describe a union selection. */
/* @sem ObjectFilter::AnyOf(@unordered([$hand_category, $hand_category_2])) */
card_category_union_pair ::= hand_category "and" "/" "or" hand_category

/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Matching{objects:Recorded(@prior), filter:$card_category_union_pair}, count:UpTo(Constant(2)), constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}} */
put_prior_union_pair_battlefield ::= "put" card_category_union_pair "from" "among" "them" "onto" "the" "battlefield"

/* The conditional grant refers to the single card arriving from this hand exile. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[[$counter_kind, Earlier{what:It, measure:Of(ManaValue)}]], states:[]}}, qualifiers:[]}}]}}, Effect{result:@next, operation:EffectOn{subject:Objects(One(Result{result:@prior, phase:After, index:0})), effects:[Term{family:ExiledCardEffect, form:AddAbilityIfItDoesntHaveIt, operands:[Ability(Mechanic{mechanic:BasicSuspend})]}]}}] */
instructions_may_exile_hand_mana_value_suspend ::= "you" "may" "exile" "a" "card" "from" "your" "hand" "with" "a" "number" "of" counter_kind "counters" "on" "it" "equal" "to" "its" "mana" "value" "." "if" "it" "doesn't" "have" "suspend" "," "it" "gains" "suspend"

/* The count is scoped to the immediately preceding destruction receipt. */
/* @sem Instruction::[Effect{result:@next, operation:$destroy}, Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:$recipients, amount:CountObjects(Matching{objects:Transition{result:@prior, phase:Before}, filter:AllOf([$filter_plural, OwnedBy(All)])}), preventable:true}}] */
instructions_destroy_graveyard_count_damage ::= destroy "." object_ref "deals" "damage" "to" recipients "equal" "to" "the" "number" "of" filter_plural "put" "into" "a" "graveyard" "this" "way"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_destroy_graveyard_count_damage}} */
spell_destroy_graveyard_count_damage ::= instructions_destroy_graveyard_count_damage "."

/* The receipt is scoped to this exile producer, including its destination and
   target selection, so both the count and permission refer to the same move. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:AnyNumber, filter:Any})) */
exile_any_target_graveyard_cards ::= "any" "number" "of" "target" "cards" "from" "your" "graveyard"

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Move{objects:$exile_any_target_graveyard_cards, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:Repeat{amount:CountObjects(Transition{result:@marked, phase:Before}), production:$mana_production, choice:Once}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}]} */
program_exile_graveyard_mana_play ::= "exile" exile_any_target_graveyard_cards "." "add" mana_production "for" "each" "card" "exiled" "this" "way" "." "you" "may" "play" "those" "cards" this_duration

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[Loyalty($loyalty)]}, limits:ActivationLimits{sorcery:true}, announcement:@announcement, body:$program_exile_graveyard_mana_play} */
activated_exile_graveyard_mana_play ::= "[" loyalty "]" ":" program_exile_graveyard_mana_play "."

/* Milling targets uses the amount of the enclosing damage event. */
/* @sem Operation::Mill{players:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:AnyNumber, filter:Any, players:All, constraints:[]})), amount:$mill_cast_event_amount} */
target_players_each_mill_event ::= "any" "number" "of" "target" "players" "each" "mill" mill_cast_event_amount

/* An optional keyword action and its callback share the action's result. */
/* @sem Instruction::Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:$collect_evidence_action}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$defender_graveyard_cast_callback})}]}} */
optional_evidence_reflexive ::= "you" "may" collect_evidence_action "." "when" "you" "do" "," defender_graveyard_cast_callback

/* The target is announced inside the reflexive trigger. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$adjective_nontype, InZone(Players{zone:Graveyard, players:One(EventSubject)})]), constraints:[]}), index:0}), count:Exactly(Constant(1)), cost:Free, into_exile:false}}]}}]} */
defender_graveyard_cast_callback ::= "you" "may" "cast" "target" adjective_nontype "card" "from" "defending" "player's" "graveyard" "without" "paying" "its" "mana" "cost"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$target_players_each_mill_event}, $optional_evidence_reflexive]} */
mill_then_evidence_callback ::= target_players_each_mill_event "." "then" optional_evidence_reflexive

/* The singular destroy producer and its death receipt stay in one scope. The
   damage follow-up reads the attempted target, including last-known properties. */
/* @sem Operation::Destroy{objects:One($death_receipt_target), regeneration:true} */
destroy_death_receipt_target ::= "destroy" death_receipt_target

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($noun_creature, $modifiers)}), index:0} */
death_receipt_target ::= "target" noun_creature modifiers

/* @sem Operation::DealDamage{source:$self_explicit_ref, recipients:Players(One(ControllerOf(Target{slot:@last_slot, index:0}))), amount:ObjectProperty{object:Target{slot:@last_slot, index:0}, property:$creature_stat, information:CurrentOrLastKnown}, preventable:true} */
death_receipt_target_controller_damage ::= self_explicit_ref "deals" "damage" "equal" "to" "the" "creature's" creature_stat "to" "the" "creature's" "controller"

/* @sem Instruction::[Effect{result:@mark, operation:$destroy_death_receipt_target}, If{condition:ObjectMatches{object:Result{result:@marked, phase:Before, index:0}, filter:Any}, then:Program{instructions:[Effect{result:@next, operation:$death_receipt_target_controller_damage}]}, otherwise:Program{}}] */
instructions_destroy_death_receipt_damage ::= destroy_death_receipt_target "." "if" "that" "creature" "dies" "this" "way" "," death_receipt_target_controller_damage

/* An optional sacrifice payment gates the complete coin process. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$cost_sacrifice]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$clause_flip_coin_reflexive_win_lose}, otherwise:Program{}}]} */
optional_sacrifice_coin_process ::= "you" "may" cost_sacrifice "." "if" "you" "do" "," clause_flip_coin_reflexive_win_lose "."

/* @sem Ability::Triggered{event:$event_cast_nth, limits:TriggerLimits{}, announcement:@announcement, body:$optional_sacrifice_coin_process} */
triggered_nth_cast_sacrifice_coin ::= "whenever" event_cast_nth "," optional_sacrifice_coin_process

/* Preserve the grouped continuation representation as a distinct reading. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[$cost_sacrifice]}, optional:true}}, ...$clause_flip_coin_reflexive_win_lose]} */
optional_sacrifice_grouped_coin_process ::= "you" "may" cost_sacrifice "." "if" "you" "do" "," clause_flip_coin_reflexive_win_lose "."

/* @sem Ability::Triggered{event:$event_cast_nth, limits:TriggerLimits{}, announcement:@announcement, body:$optional_sacrifice_grouped_coin_process} */
triggered_nth_cast_grouped_sacrifice_coin ::= "whenever" event_cast_nth "," optional_sacrifice_grouped_coin_process

/* The producer and counted controller receipt share the same exile instruction. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:$plural_target_count_any, filter:Any})), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(Bound(0)), tokens:[TokenSpec{amount:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:ControlledBy(One(Bound(0)))}), words:CreatingEffect, recipe:$singular_counted_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}] */
clause_exile_permanent_controllers_tokens ::= "exile" plural_target_count_any "target" "permanents" "." "for" "each" "permanent" "exiled" "this" "way" "," "its" "controller" "creates" "a" singular_counted_token_recipe

/* The whole-hand reveal, payment limit, and discard choice share one player
   and one card filter. The complete producer-consumer sequence is scoped here. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($callback_hand_player)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:PayRepeatedly{player:$callback_hand_player, cost:$cost, at_most:CountObjects(Matching{objects:Zone{scope:Players{zone:Hand, players:One($callback_hand_player)}, kind:Card, filter:Any}, filter:$card_filter})}}, Effect{result:@next, operation:ChooseObjects{player:$callback_hand_player, objects:Zone{scope:Players{zone:Hand, players:One($callback_hand_player)}, kind:Card, filter:$card_filter}, count:AsManyAsCan(Subtract([CountObjects(Matching{objects:Zone{scope:Players{zone:Hand, players:One($callback_hand_player)}, kind:Card, filter:Any}, filter:$card_filter}), Performed(@prior)]))}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}] */
reveal_hand_repeated_discard ::= callback_hand_player "reveals" "their" "hand" "." "for" "each" card_filter "card" "revealed" "this" "way" "," "that" "player" "discards" "that" "card" "unless" "they" cost

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$reveal_hand_repeated_discard]}} */
spell_reveal_hand_repeated_discard ::= reveal_hand_repeated_discard "."

/* The granted ability retains the separate draw controller. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Sacrifice{players:One(ControllerOf(GrantingObject)), objects:One(GrantingObject)}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}]} */
grantor_sacrifice_draw_program ::= SELF_NAME "'s" "controller" "sacrifices" "it" "and" "draws" card_count

/* The event supplies the quantity; the enclosing entry trigger supplies its scope. */
/* @sem Operation::DealDamage{source:$damage_source_ref, recipients:$recipients, amount:EventAmount, preventable:true} */
entry_event_amount_damage ::= damage_source_ref "deals" "that" "much" "damage" "to" recipients

/* Compose a batch entry with an event-quantity consumer. */
/* @sem Ability::Triggered{event:$event_many_enter, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$entry_event_amount_damage}]}} */
triggered_entry_event_amount_damage ::= "whenever" event_many_enter "," entry_event_amount_damage "."

/* The subtype test consumes the arrival of the adjacent return to its owner's hand. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:ObjectSet::$return_single_target, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@last_result, phase:After}, filter:$subtype}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:$program, otherwise:Program{}}] */
instructions_return_single_past_subtype ::= "return" return_single_target "to" "its" "owner's" "hand" "." "if" "it" "was" "a" subtype "," program

/* The entry subject supplies both the damage source and the kicked object. */
/* @sem Expr::Multiply([$discard_damage_multiplier, TimesKicked(Source)]) */
entry_kicked_damage_amount ::= discard_damage_multiplier "the" "number" "of" "times" "it" "was" "kicked"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:$noun, players:All})), amount:$entry_kicked_damage_amount, preventable:true}}]} */
entry_subject_kicked_damage ::= "it" "deals" "damage" "to" "target" "player" "or" noun "equal" "to" entry_kicked_damage_amount

/* @sem Ability::Triggered{event:$event_self_enters, limits:_{}, announcement:@announcement, body:$entry_subject_kicked_damage} */
entry_subject_kicked_damage_trigger ::= "when" event_self_enters "," entry_subject_kicked_damage "."

/* @sem Instruction::[If{condition:$condition, then:$conditional_instead_branch_2, otherwise:$conditional_instead_branch}] */
conditional_instead_standard ::= conditional_instead_branch "." NEWLINE "if" condition "," "instead" conditional_instead_branch /* @prefer always */

/* The replacement branch owns both the destruction and its return receipt. */
/* @sem Instruction::[If{condition:$condition, then:$conditional_destroy_return, otherwise:$conditional_instead_branch}] */
conditional_instead_receipt_replacement ::= conditional_instead_branch "." NEWLINE "if" condition "," "instead" conditional_destroy_return

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$operation_destroy_all_filtered}, Effect{result:@next, operation:Move{objects:Matching{objects:Recorded(@prior), filter:Any}, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]} */
conditional_destroy_return ::= operation_destroy_all_filtered "," "then" "return" "all" "cards" "in" "your" "graveyard" "destroyed" "this" "way" "to" "the" "battlefield"

/* The enclosing controller discard event supplies this group. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:EventGroup, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]} */
discarded_group_exile_graveyard ::= "exile" "them" "from" "your" "graveyard"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:EventGroup, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]} */
discarded_group_exile_graveyard_down ::= "exile" "them" "from" "your" "graveyard" "face" "down"

discarded_group_graveyard_action ::= discarded_group_exile_graveyard | discarded_group_exile_graveyard_down

/* Choose one controlled permanent for each opponent, then use the tap as the reflexive action. The two named properties must agree. */
/* @sem Program::Program{instructions:[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, in_chosen_direction:false, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(Tapped), CardType(Creature), ControlledBy(One(AbilityController))])}, count:UpTo(Constant(1)), constraints:[]}}]}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:SetTapped{objects:Selected(@prior), tapped:true}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:Announcement{targets:[TargetSpec{slot:0, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ControlledBy(One(NotedFor(Candidate))), Property{property:$tap_bound_stat, test:Compare{comparison:LessOrEqual, value:ObjectProperty{object:Candidate, property:$tap_bound_stat, information:CurrentOrLastKnown}}}])}]}, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:0, index:0})), changes:[SetController(AbilityController)], duration:$while_you_control, evaluation:Snapshot}}]}})}]}}]} */
/* @prefer always */
program_opponent_tap_reflexive_control ::= "for" "each" "opponent" "," "tap" "up" "to" "one" "untapped" "creature" "you" "control" "." "when" "you" "do" "," "gain" "control" "of" "target" noun "that" "player" "controls" tap_bound_stat while_you_control

/* @sem Property::Power */
tap_bound_power ::= "with" "power" "less" "than" "or" "equal" "to" "the" "tapped" "creature's" "power"

/* @sem Property::Toughness */
tap_bound_toughness ::= "with" "toughness" "less" "than" "or" "equal" "to" "the" "tapped" "creature's" "toughness"

tap_bound_stat ::= tap_bound_power | tap_bound_toughness

/* Keep the return and its counted receipt in the same instruction sequence.
   The local target phrase does not widen ordinary target-set parsing. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:AnyNumber, filter:AllOf([$adjective_nontype, Not(Token), ControlledBy(One(AbilityController))])})) */
returned_controlled_nontoken_targets ::= "any" "number" "of" "target" adjective_nontype "," "nontoken" "permanents" "you" "control"

/* @sem Operation::Move{objects:$returned_controlled_nontoken_targets, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_controlled_targets_to_owners_hands ::= "return" returned_controlled_nontoken_targets "to" "their" "owners'" "hands"

/* @sem Instruction::[Effect{result:@next, operation:$return_controlled_targets_to_owners_hands}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Earlier{what:Returned, measure:Count, result:@prior, by:AbilityController}}}] */
instructions_return_controlled_targets_draw ::= return_controlled_targets_to_owners_hands "." "draw" "a" "card" "for" "each" "card" "returned" "to" "your" "hand" "this" "way"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_return_controlled_targets_draw}} */
spell_return_controlled_targets_draw ::= instructions_return_controlled_targets_draw "."

/* Announce a spell and copy it for each legal recipient. */
/* @sem Instruction::[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$retarget_single_oracle_spell, times:$value, targets:$copy_each_legal_prefix}}] */
instructions_choose_copy_each_legal ::= "choose" retarget_single_oracle_spell "." "copy" "that" "spell" copy_each_legal_prefix value "of" "those" "permanents" "and" "players"

/* @sem NewTargets::EachLegal */
copy_each_legal_prefix ::= "for" "each" "other" "permanent" "or" "player" "the" "spell" "could" "target" "." "each" "copy" "targets" "a" "different"

/* Postposed maximum-stat checks compare against the complete battlefield population. */
post_action_condition ::= condition | control_greatest_toughness_post | control_greatest_power_post | condition_counted_controlled_entries_this_turn

/* @sem Condition::Controls{player:$condition_control_subject, filter:Property{property:Toughness, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$noun}, property:Toughness, aggregation:Maximum}}}, minimum:1} */
control_greatest_toughness_post ::= condition_control_subject "the" noun "with" "the" "greatest" "toughness" "or" "tied" "for" "the" "greatest" "toughness"

/* @sem Condition::Controls{player:$condition_control_subject, filter:Property{property:Power, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$noun}, property:Power, aggregation:Maximum}}}, minimum:1} */
control_greatest_power_post ::= condition_control_subject "the" noun "with" "the" "greatest" "power" "or" "tied" "for" "the" "greatest" "power"

/* Each stack domain has its own announcement; the ability mode alone consumes
   the counter receipt. The remaining instructions are shared by both modes. */
/* @sem Ability::Spell{announcement:_{modes:_{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:$counter_reactive_target_filter}), index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}, ...$instructions]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Counter{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Ability, zones:[Stack]}), count:Exactly(Constant(1)), filter:$counter_reactive_target_filter}), index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}, Effect{result:@next, operation:$countered_permanent_destroy}, ...$instructions]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied}}, body:_{}} */
counter_reactive_modes_continuation ::= "counter" "target" "spell" "or" "ability" counter_reactive_target_filter "." countered_permanent_destroy "." NEWLINE instructions "."

/* @sem Operation::Destroy{objects:One(Recorded{result:@prior}), regeneration:true} */
countered_permanent_destroy ::= "if" "a" "permanent's" "ability" "is" "countered" "this" "way" "," "destroy" "that" "permanent"

/* Each target is owned by a different player whose graveyard meets the stated test.
   The eligible and targeted card filters are independent printed operands. */
/* @sem Operation::Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(CountPlayers(Matching{binding:0, condition:Compare{left:CountObjects(Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:$card_filter})), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_a}}})), filter:AllOf([$card_filter_2, OwnedBy(Matching{binding:0, condition:Compare{left:CountObjects(Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:$card_filter})), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_a}}})]), constraints:[DifferentOwners]})), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
graveyard_each_matching_exile ::= "for" "each" "graveyard" "with" counter_a card_filter "card" "in" "it" "," "exile" "target" card_filter "card" "from" "that" "graveyard"

/* The condition and random choice consume this exact exile producer. */
/* @sem Instruction::[Effect{result:@mark, operation:$random_copy_exile_producer}, If{condition:Compare{left:CountObjects(Transition{result:@marked, phase:After}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, then:Program{instructions:$random_exile_copy_cast}, otherwise:Program{}}] */
instructions_graveyard_exile_threshold ::= random_copy_exile_producer "." "if" number "or" "more" "cards" "are" "exiled" "this" "way" "," random_exile_copy_cast

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:CopyCards{actor:One(AbilityController), objects:One(Result{result:@prior, phase:After, index:0}), times:Constant(1)}}, $optional_cast_created_copy] */
random_exile_copy_cast ::= "choose" "one" "of" "them" "at" "random" "and" "copy" "it" "." optional_cast_created_copy

random_copy_exile_producer ::= graveyard_each_matching_exile | exile_target_players_graveyard

/* A die table whose rows consume the same face-up battlefield exile receipt. */
/* @sem Operation::Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(Token), $plural, ControlledBy(One(AbilityController))])}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]} */
exile_controlled_nontoken_population ::= "exile" "all" "nontoken" plural "you" "control"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:$exile_controlled_nontoken_population}, Effect{result:@next, operation:$roll_die_action}, ...$battlefield_exile_die_rows]}} */
spell_battlefield_exile_die_table ::= exile_controlled_nontoken_population "," "then" roll_die_action "." NEWLINE battlefield_exile_die_rows

battlefield_exile_die_rows ::= battlefield_exile_die_rows_one | battlefield_exile_die_rows_more

/* @sem Instruction::[$battlefield_exile_die_row] */
battlefield_exile_die_rows_one ::= battlefield_exile_die_row

/* @sem Instruction::[$battlefield_exile_die_row, ...$battlefield_exile_die_rows] */
battlefield_exile_die_rows_more ::= battlefield_exile_die_row NEWLINE battlefield_exile_die_rows

/* @sem Instruction::If{condition:AllOf([Compare{left:DieResult(@die_roll), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, Compare{left:DieResult(@die_roll), test:NumberTest::Compare{comparison:LessOrEqual, value:$number_2}}]), then:$battlefield_exile_die_body, otherwise:Program{}} */
battlefield_exile_die_row ::= number "―" number "|" battlefield_exile_die_body

battlefield_exile_die_body ::= battlefield_exile_delayed_return | battlefield_exile_return_again

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{}}, qualifiers:[]}}]}}}]} */
battlefield_exile_delayed_return ::= "return" "those" "cards" "to" "the" "battlefield" "under" "their" "owner's" "control" "at" "the" "beginning" "of" "the" "next" "end" "step" "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Transition{result:@prior, phase:After}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:One(AbilityController)}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@back(3), phase:After}, zone:Exile}, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{}}, qualifiers:[]}}]}}}]} */
battlefield_exile_return_again ::= "return" "those" "cards" "to" "the" "battlefield" "under" "their" "owner's" "control" "," "then" "exile" "them" "again" "." "return" "those" "cards" "to" "the" "battlefield" "under" "their" "owner's" "control" "at" "the" "beginning" "of" "the" "next" "end" "step" "."

/* The two announced targets share the first target's controller, but retain
   distinct filters and the returned card enters under its owner's control. */
/* @sem Instruction::[Effect{result:@next, operation:Together([Sacrifice{players:One(ControllerOf(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@agree($filter_phrase, $filter_phrase_3)}), index:0})), objects:One(Target{slot:0, index:0})}, Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([@agree($filter_phrase_2, $filter_phrase_4), InZone(Players{zone:Graveyard, players:One(ControllerOf(Target{slot:0, index:0}))})])}), index:0}), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}])}] */
controlled_target_graveyard_swap ::= "choose" "target" filter_phrase "a" "player" "controls" "and" "target" filter_phrase "card" "in" "that" "player's" "graveyard" "." "if" "both" "targets" "are" "still" "legal" "as" "this" "ability" "resolves" "," "that" "player" "simultaneously" "sacrifices" "the" filter_phrase "and" "returns" "the" filter_phrase "card" "to" "the" "battlefield"

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:$controlled_target_graveyard_swap}} */
activated_controlled_target_graveyard_swap ::= cost ":" controlled_target_graveyard_swap "."

/* The counted callback is scoped to this choice and its actual exile move. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[...$graveyard_exile_choice_producer, $graveyard_exile_counted_callback]}}] */
instructions_optional_exile_counted_reflexive ::= "you" "may" graveyard_exile_choice_producer "." graveyard_exile_counted_callback

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, count:AnyNumber}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
graveyard_exile_choice_producer ::= "exile" "one" "or" "more" filter_phrase "cards" "from" "your" "graveyard"

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$graveyard_exile_counted_pump})} */
graveyard_exile_counted_callback ::= "when" "you" "do" "," graveyard_exile_counted_pump

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:Multiply(Constant(-1), CountObjects(Transition{result:@reflexive_performed, phase:Before})), toughness:Multiply(Constant(-1), CountObjects(Transition{result:@reflexive_performed, phase:Before}))}], duration:$duration, evaluation:Snapshot}}]} */
graveyard_exile_counted_pump ::= affected "gets" "-" "X" "/" "-" "X" duration "," "where" "X" "is" "the" "number" "of" "cards" "exiled" "this" "way"

/* Counted targets in your graveyard retain their owner-hand destination. */
/* @sem Operation::Move{objects:$counted_own_graveyard_targets, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_counted_graveyard_targets_hand ::= "return" counted_own_graveyard_targets "to" "your" "hand"

/* The copied creature is the controlled object attached to the source. The
   fallback token is shared by the unpaid and ineligible branches. */
/* @sem Program::Program{instructions:[If{condition:ObjectMatches{object:Source, filter:AttachedTo(InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun_creature, ControlledBy(One(AbilityController))])}))}, then:Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Mana($mana_symbols)]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:AttachedTo(Source), exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:$token_groups, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:$token_groups, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}]} */
attached_copy_payment_fallback ::= "you" "may" "pay" mana_symbols "if" "this" "permanent" "is" "attached" "to" "a" noun_creature "you" "control" "." "if" "you" "do" "," "create" "a" "token" "that's" "a" "copy" "of" "that" "creature" "." "if" "you" "didn't" "create" "a" "token" "this" "way" "," "create" token_groups "."

/* An offered control transfer names the permanent explicitly, preserving its antecedent. */
/* @sem Cost::Cost{parts:[PlayerAction{player:$player_ref, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($self_explicit_ref)), changes:[SetController($player_ref)], duration:$duration, evaluation:Snapshot}}]}}]} */
payment_have_player_control_self ::= "have" player_ref "gain" "control" "of" self_explicit_ref duration

/* The named object is the antecedent of both following references. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:One($self_explicit_ref), tapped:false}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Goad{object:$self_explicit_ref}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($self_explicit_ref)), changes:$rule_changes, duration:$rule_duration, evaluation:LiveObjects}}] */
untap_goad_referred_rule ::= "untap" self_explicit_ref "," "goad" "it" "," "and" "it" rule_changes rule_duration

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Convert{object:$it_pronoun}} */
convert_referred_it ::= "convert" it_pronoun

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:$conjoined}, otherwise:Program{instructions:[Effect{result:@next, operation:$convert_referred_it}]}}] */
clause_offer_otherwise_convert_it ::= "you" "may" payment "." "if" "you" "do" "," conjoined "." "if" "you" "don't" "," convert_referred_it

/* @prefer always */
/* @sem Cost::Cost{parts:[PlayerAction{player:$player_ref, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($self_explicit_ref)), changes:[SetController($player_ref)], duration:$until_end_of_turn, evaluation:Snapshot}}]}}]} */
payment_have_player_control_self_end_turn ::= "have" player_ref "gain" "control" "of" self_explicit_ref until_end_of_turn

/* @prefer always */
/* @sem Program::Program{instructions:$clause_offer_otherwise_convert_it} */
program_offer_otherwise_convert_it ::= clause_offer_otherwise_convert_it

/* Count the departure receipt of this exact exile choice, across its return instruction. */
/* @sem Instruction::[...$exile_any_number_affected, ...$return_marked_exile_until_leaves, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Transition{result:@marked, phase:Before}), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
clause_exile_choice_until_count_tokens ::= exile_any_number_affected return_marked_exile_until_leaves "." "create" "a" token_recipe "for" "each" "permanent" "exiled" "this" "way"

/* @sem Instruction::[Effect{result:@next, operation:ReturnAfter{objects:Transition{result:@marked, phase:After}, duration:WhileOnBattlefield($object_ref)}}] */
return_marked_exile_until_leaves ::= "until" object_ref "leaves" "the" "battlefield"

/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Exile), kind:Card, filter:AllOf([SharesNameWith(EventSubject), ExiledWith(Source)])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
