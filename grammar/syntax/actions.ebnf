/* The copied card and the condition share the producer's exile arrival. */
/* @sem Program::Program{instructions:[Repeatable{instructions:[...$clause_random_owned_graveyard_exile, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$random_exile_copy_amount, words:CreatingEffect, recipe:Copy{object:Result{result:@marked, phase:After, index:0}, exceptions:[]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$filter_phrase}, then:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}]}]} */
