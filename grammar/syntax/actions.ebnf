choice_any_color_term ::= "a" "color"

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[$choice_any_color_term]}} */
choose_color_word_shared ::= "choose" choice_any_color_term "word"

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Letter, terms:_{count:Exactly(Constant(1))}} */
choose_letter_shared ::= "choose" "a" "letter"

/* @sem Operand::Term{family:ChoosableColor, form:ColorsOfCardsInPlayersGraveyard, operands:[Filter($choice_graveyard_card), Player($choice_graveyard_possessive)]} */
choice_graveyard_colors ::= "a" "color" "of" "a" choice_graveyard_card "in" choice_graveyard_possessive "graveyard"

/* @sem ObjectFilter::Any */
choice_graveyard_card ::= "card"

/* @sem PlayerRef::AbilityController */
choice_graveyard_possessive ::= "your"

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[$choice_graveyard_colors]}} */
