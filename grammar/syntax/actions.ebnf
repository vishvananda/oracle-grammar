/* @sem Instruction::[Effect{result:@mark, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, regeneration:true}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:AllOf([$filter_phrase, InSet(Transition{result:@marked, phase:After})])}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:$added_color_type_entry}, qualifiers:[]}}] */
destroy_graveyard_return_added_identity ::= "destroy" "all" filter_plural "," "then" "return" "a" filter_phrase "card" "put" "into" "a" "graveyard" "this" "way" "to" "the" "battlefield" "under" "your" "control" "." added_color_type_entry

