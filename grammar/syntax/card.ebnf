/* @sem Ability::Triggered{event:$turn_event, intervening_if:$condition_object_and_other_attacked_combat, limits:TriggerLimits{}, announcement:@announcement, body:$combat_exile_return_program} */
triggered_combat_history_exile_return ::= "at" turn_event "," "if" condition_object_and_other_attacked_combat "," combat_exile_return_program

