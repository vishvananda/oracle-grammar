/* @sem EventSpec::ZoneChange{objects:$event_named, to:Battlefield} */
named_entry_event ::= "when" event_named "enters"

/* Each mode repeats the same white-X activation spending restriction. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{modifiers:[ActivationRule(RestrictMana{portion:X, color:White})]}, announcement:Announcement{modes:ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:[$white_x_mode, $white_x_mode_2], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}}}, body:Program{}} */
activated_white_x_two_modes ::= cost ":" "choose" number_words "—" NEWLINE white_x_mode NEWLINE white_x_mode

/* @sem @scope(Mode::Mode{announcement:@announcement, body:$program_sentence, weight:1}) */
white_x_mode ::= "•" program_sentence "spend" "only" "white" "mana" "on" "X" "."

/* Keep the casting payment and its consumer in the same syntax scope. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:Exactly(Constant(1))}]}, repetition:Once}), Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$casting_creature_sacrifice_consequence}]}}] */
line_casting_creature_sacrifice_discard ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "sacrifice" "a" "creature" "." NEWLINE casting_creature_sacrifice_consequence "."

/* @prefer always */
/* @sem Expr::CountDistinct{objects:$card_population, property:PermanentTypes} */
captured_x_permanent_types ::= "the" "number" "of" "permanent" "types" "among" card_population

/* Capture the definition once for both the first action and its conditional follow-up. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:BindValue{value:$captured_x_definition}}, Effect{result:@next, operation:$captured_x_action}, If{condition:$condition_was_cast_from_exile, then:Program{instructions:[Effect{result:@next, operation:$captured_x_conditional_action}]}, otherwise:Program{}}]} */
program_captured_where_conditional ::= captured_x_action "," "where" "X" "is" captured_x_definition "." "if" condition_was_cast_from_exile "," captured_x_conditional_action

/* @sem Expr::AsOf{moment:ThisSpellCast, value:Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController)))}, property:$stat, aggregation:Maximum}} */
captured_x_greatest_at_cast ::= "the" "greatest" stat "among" filter_plural "you" "controlled" "as" "you" "cast" "this" "spell"

captured_x_conditional_action ::= captured_x_action | captured_x_gain_twice

/* @sem Operation::GainLife{players:One(AbilityController), amount:Multiply(Constant(2), BoundValue(@marked))} */
captured_x_gain_twice ::= "you" "gain" "twice" "X" "life"

/* In opponent-selected modes, the choosing player is distinct from you. */
/* @prefer always */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$opponent_mode_counter_placement}, Effect{result:@next, operation:$opponent_mode_counter_followup}]}, weight:1}) */
opponent_mode_counter_pair ::= "•" "you" opponent_mode_counter_placement "and" opponent_mode_counter_followup "."

opponent_mode_counter_placement ::= opponent_mode_counter_yours | opponent_mode_counter_choosers

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController))])}), kind:$counter_kind, amount:Constant(1)}]} */
opponent_mode_counter_yours ::= "put" "a" counter_kind "counter" "on" "each" filter_phrase "you" "control"

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(ModeChooser))])}), kind:$counter_kind, amount:Constant(1)}]} */
opponent_mode_counter_choosers ::= "put" "a" counter_kind "counter" "on" "each" filter_phrase "that" "player" "controls"

opponent_mode_counter_followup ::= paid_success_life | opponent_mode_damage_chooser

/* @sem Operation::DealDamage{source:Source, recipients:Players(One(ModeChooser)), amount:$number, preventable:true} */
opponent_mode_damage_chooser ::= SELF_NAME "deals" number "damage" "to" "that" "player"

/* A name choice and its following restriction share the same mode scope. */
/* @prefer always */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:CardName, terms:_{count:Exactly(Constant(1)), options:[$card_name_option]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(OpponentsOf(AbilityController)), changes:[PlayerRule(Prohibit(CastSpell{filter:Chosen(CardName)}))], duration:UntilNextTurn(AbilityController), evaluation:LiveObjects}}]}, weight:1}) */
mode_named_spell_prohibition ::= "•" "choose" card_name_option "." "opponents" "can't" "cast" "spells" "with" "the" "chosen" "name" "until" "your" "next" "turn" "."

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($target_permanent)), changes:[Rule(Prohibit(Attack(Any))), Rule(Prohibit(Block(Any))), Rule(Prohibit(Activate(Any)))], duration:UntilNextTurn(AbilityController), evaluation:LiveObjects}}]}, weight:1}) */
/* @prefer always */
mode_target_combat_activation_prohibition ::= "•" "choose" target_permanent "." "until" "your" "next" "turn" "," "it" "can't" "attack" "or" "block" "," "and" "its" "activated" "abilities" "can't" "be" "activated" "."

/* Compare the target's life with the upkeep player's life. */
/* @sem PlayerSet::Matching{binding:0, condition:Compare{left:PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:Greater, value:PlayerNumber{player:EventSubject, number:Life}}}} */
oath_rival_life ::= "who" "has" "more" "life" "than" "they" "do"

/* The second player is the target announced by the shared Oath header. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(One(Target{slot:0, index:0})), amount:$number_digits, preventable:true}}] */
oath_source_damage ::= "have" "this" "enchantment" "deal" number_digits "damage" "to" "the" "second" "player"

/* The producer establishes the damage receipt for the entire continuation. */
/* @sem Instruction::[Effect{result:@mark, operation:$excess_damage_producer}, If{condition:Compare{left:ExcessDamage{result:@marked, to:Any}, test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:$excess_damage_followup_program, otherwise:Program{}}] */
instructions_damage_excess_any_followup ::= excess_damage_producer "." "if" "excess" "damage" damage_excess_receipt_verb "this" "way" "," excess_damage_followup_program

damage_excess_receipt_verb ::= damage_excess_was_dealt | damage_excess_is_dealt
/* @sem () */
damage_excess_was_dealt ::= "was" "dealt"
/* @sem () */
damage_excess_is_dealt ::= "is" "dealt"

excess_damage_followup_program ::= program | excess_damage_spellbook_replacement

/* The threshold and both conjured outcomes consume the same damage receipt. */
/* @sem Program::Program{instructions:[If{condition:Compare{left:ExcessDamage{result:@marked, to:Any}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, then:Program{instructions:[Effect{result:@next, operation:$excess_named_conjure}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:SpellbookMatching{book:@card_name, cards:Term{family:CardsInOracle, form:ManaValueIs, operands:[Comparison([Equal, ExcessDamage{result:@marked, to:Any}])]}}, count:Constant(1), destination:Battlefield(BattlefieldArrival{tapped:false, counters:[], states:[]})}}]}}]} */
excess_damage_spellbook_replacement ::= "conjure" "a" "card" "with" "mana" "value" "equal" "to" "that" "excess" "damage" "from" self_named "'s" "spellbook" "onto" "the" "battlefield" "." "if" "that" "excess" "damage" "is" number "or" "greater" "," "instead" excess_named_conjure

/* @sem Operation::Conjure{actor:One(AbilityController), card:Named($referenced_card_name), count:$card_count, destination:Battlefield(BattlefieldArrival{tapped:false, counters:[], states:[]})} */
excess_named_conjure ::= "conjure" card_count "named" referenced_card_name "onto" "the" "battlefield"

/* The transfer and its threshold share the same counter kind and result. */
/* @sem Instruction::[Effect{result:@mark, operation:MoveCounters{actor:One(AbilityController), from:$affected, to:$affected_2, kind:PowerToughness([1, 1]), amount:All}}, If{condition:Compare{left:Performed(@marked), test:$condition_at_least}, then:Program{instructions:$conjoined}, otherwise:Program{}}] */
instructions_move_counters_threshold ::= "move" "all" "+" "1" "/" "+" "1" "counters" "from" affected "onto" affected "." "if" condition_at_least "+" "1" "/" "+" "1" "counters" "are" "moved" "this" "way" "," conjoined

/* The complete card fixes the casting receipt at ability zero and proves the
   single exile payment used by the damage phrase. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost::Cost{parts:[$cost_exile_graveyard]}, repetition:Once}), Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$casting_exile_property_damage}]}}] */
card_casting_exile_property_damage ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," cost_exile_graveyard "." NEWLINE casting_exile_property_damage "."

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$population_keyword_operation}]}} */
spell_population_keyword ::= population_keyword_operation "."

/* The destruction and its dependent delayed counter remain one scoped
   producer-consumer contract; the event supplies the combat pair. */
/* @sem Ability::Triggered{event:$event_blocks_or_blocked, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One(BlockPair(Other)), regeneration:true}}, If{condition:Compare{left:CountObjects(Transition{result:@last_result, phase:After}), test:Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(EventSubject)), kind:$counter_kind, amount:Constant(1)}]}}]}}}]}, otherwise:Program{}}]}}}]}} */
triggered_combat_destroy_counter ::= "whenever" event_blocks_or_blocked "," "destroy" "the" "other" "creature" "at" "end" "of" "combat" "." "at" "the" "beginning" "of" "the" "next" "end" "step" "," "if" "that" "creature" "was" "destroyed" "this" "way" "," "put" "a" counter_kind "counter" "on" "the" "first" "creature" "."

/* A counter placement and a tapped-token creation are independent effects. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$put_counters_direct}, Effect{result:@next, operation:@apply(PlayerSet::One(AbilityController), $create_tapped_base)}]}} */
triggered_counters_and_tapped_tokens ::= event_clause "," put_counters_direct "and" create_tapped_base "."

/* The complete card proves the casting sacrifice receipt and agrees the named
   sacrificed population with its producer, including inverse printing. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($filter_plural, $filter_plural_2), ControlledBy(One(AbilityController))])}}]}, repetition:Once}), Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:$recipients, amount:Aggregate{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Performed, phase:Before}, property:$stat, aggregation:Sum}, preventable:true}}]}}] */
card_casting_sacrifice_total_damage ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "sacrifice" "all" filter_plural "you" "control" "." NEWLINE self_explicit_ref "deals" "damage" "to" recipients "equal" "to" "the" "total" stat "of" "the" "sacrificed" filter_plural "."

/* Keep the casting discard and its measured receipt in the same scope. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost::Cost{parts:[$casting_discard_plural_payment]}, repetition:Once}), Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$casting_discard_total_damage}]}}] */
card_casting_discard_total_damage ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," casting_discard_plural_payment "." NEWLINE casting_discard_total_damage "."

casting_discard_plural_payment ::= cost_discard_many | cost_discard_filtered_many

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$temporary_population_trigger_grant}]}} */
activated_temporary_population_grant ::= cost ":" temporary_population_trigger_grant

/* Keep the sacrifice and its per-player failure receipt in one scope. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Sacrifice{players:OpponentsOf(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$sacrifice_choice_filter}, choose:AsManyAsCan($counter_a)}}, ForEachPlayer{players:Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Not(Compare{left:CountObjects(MovedBy{result:@marked, phase:Before, player:Bound(0)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}})}]), binding:0, body:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(Bound(0)), amount:Divide{numerator:PlayerNumber{player:Bound(0), number:Life}, denominator:Constant(2), rounding:$rounding_words}}}]}}]} */
program_sacrifice_failure_life ::= "each" "opponent" "sacrifices" counter_a sacrifice_choice_filter "of" "their" "choice" "." "each" "opponent" "who" "can't" "loses" "half" "their" "life" "," rounding_words

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:$clause_target_loses_own_history}, weight:1}) */
