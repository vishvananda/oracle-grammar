eyword_trigger | activated_opponent_mill_graveyard_land_grant | spell_five_sweeping_modes | spell_coin_series_three_thresholds | spell_entwine_opponent_graveyards | conditional_controlled_type_attack_pump | triggered_damage_player_conditional_three | activated_loyalty_die_table | activated_hand_exchange_search | spell_plural_counters_then_optional_counter | static_graveyard_land_permanent_grant | spell_cast_conditional_counter_modes | attached_aura_each_spell | static_filtered_colored_spell_cost | triggered_nonland_mill_batch_counters | triggered_opponents_optional_payment | casting_opponent_margin_reduction | spell_next_loss_exile_self | triggered_attachment_linked_copy | activated_mill_optional_return | activated_prevention_receipt | activated_action_exile_choose_play | activated_chosen_source_half | activated_counter_payment_mana | casting_self_forbidden_ordinal_turns | triggered_gain_per_life_lost | as_attached_two_choices | activated_top_card_private_choice | graveyard_symbol_counter_trigger

spell_ability ::= spell_graveyard_pump_then | spell_unpreventable_damage_distribution | spell_with_conditional_block_limit | ordinary_spell_ability
/* "Cipher" closing a spell: its last instruction lets you encode the spell card on a
   creature you control. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$instructions, Effect{result:@next, operation:KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Cipher, objects:One(Source)}}]}} */
spell_cipher ::= instructions "." NEWLINE "Cipher"

/* "As you cast this spell" fixes an X that the spell's targets count, which the
   announcement does as the spell is cast. */
/* @sem Ability::Spell{announcement:@announcement, body:@where($program_plain, $value)} */
spell_where_x_as_cast ::= program_plain "," "where" "X" "is" value "as" "you" "cast" "this" "spell" "."

/* @sem Ability::Spell{announcement:Announcement{modes:$mode_selection}, body:Program{}} */
spell_modal ::= mode_selection
/* "Target spell or permanent" is one target of either kind; each kind is an
   implied mode with its own effect: a spell's color changes on the stack, a
   permanent's indefinitely. */
/* @sem Ability::Spell{announcement:Announcement{modes:ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:ChangeSpell{subject:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:Any}), index:0}), changes:[Colors{mode:Set, colors:$token_colors}]}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:Any}), index:0})), changes:[Colors{mode:Set, colors:$token_colors}], duration:Indefinite, evaluation:Snapshot}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied}}, body:Program{}} */
spell_spell_or_permanent_color ::= "target" "spell" "or" "permanent" "becomes" token_colors "."

/* CR 702.120: escalate charges its cost for each mode chosen beyond the first. */
spell_escalate ::= spell_escalate_more | spell_escalate_both
/* @sem Ability::Spell{announcement:Announcement{modes:ModeSelection{count:ModeCount{minimum:Expr::Constant(1), maximum:@length($modes)}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required, surcharge:$keyword_payment}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}}}, body:Program{}} */
spell_escalate_more ::= "escalate" keyword_payment NEWLINE "choose" "one" "or" "more" "—" NEWLINE modes
/* @sem Ability::Spell{announcement:Announcement{modes:ModeSelection{count:ModeCount{minimum:Expr::Constant(1), maximum:Expr::Constant(2)}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required, surcharge:$keyword_payment}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}}}, body:Program{}} */
spell_escalate_both ::= "escalate" keyword_payment NEWLINE "choose" "one" "or" "both" "—" NEWLINE modes

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:$program_sentence} */
activated_ability ::= cost ":" program_sentence

activated_forecast ::= forecast_program | forecast_modal

/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{once_each_turn:true, keyword:Forecast}, announcement:@announcement, body:$program_sentence})} */
forecast_program ::= "forecast" "—" cost ":" program_sentence

/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{once_each_turn:true, keyword:Forecast}, announcement:Announcement{modes:$mode_selection}, body:Program{}})} */
forecast_modal ::= "forecast" "—" cost ":" mode_selection

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{once_each_turn:true, keyword:Boast}, announcement:@announcement, body:$program_sentence} */
activated_boast ::= "boast" "—" cost ":" program_sentence

/* Power-up's native tag owns its cost reduction and per-ability use limit. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{once:true, keyword:PowerUp}, announcement:@announcement, body:$program_sentence} */
activated_power_up ::= "power-up" "—" cost ":" program_sentence

activated_limited ::= activated_limited_general | activated_nonzero_power_reanimation
/* An activation limit written after the roll still precedes the roll's table. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:Program{instructions:[...$die_table_head, ...$die_rows]}} */
activated_limited_die_table ::= cost ":" die_table_head "." activation_limits "." NEWLINE die_rows

activation_limits ::= limit_condition_sorcery | limit_upkeep_condition | limit_outside_combat | limit_cost_less_each | limit_cost_less_each_sorcery | limit_spend_red | limit_spend_black | limit_once | limit_once_ever | limit_sorcery | limit_sorcery_once | limit_sorcery_condition | limit_condition | limit_condition_once | limit_any_player | limit_any_player_sorcery | limit_max_per_turn | limit_your_turn_and_condition | limit_source_owner | limit_sorcery_once_ever | limit_condition_once_ever | limit_max_per_turn_value | limit_x_nonzero_sorcery | limit_spend_chosen_color | limit_once_ever_window | limit_any_player_own_turn | limit_condition_and_your_turn | limit_opponents_only | limit_any_player_upkeep | limit_mana_instead_sorcery | limit_any_player_draw_step | limit_any_player_own_turn_before_end | limit_opponents_sorcery | limit_once_if_object_kind | limit_controlled_either_a_an | limit_controlled_either_an_a | limit_cost_more_each | limit_live_reduction_once | limit_conditional_cost_reduction | limit_cost_less_window | limit_conditional_blue_reduction | limit_once_condition | limit_x_counter_count | limit_conditional_reduction_once | limit_conditional_reduction | limit_x_card_count | limit_window_blocking_once | limit_controlled_color_damage_sorcery

/* Oracle writes two activations as "twice" and more as "N times". */
/* @sem ActivationLimits::ActivationLimits{modifiers:[Change::ActivationRule(MaxPerTurn($activation_times))]} */
limit_max_per_turn ::= "activate" "no" "more" "than" activation_times "each" "turn"
activation_times ::= activation_twice | activation_n_times
/* @sem Expr::Constant(2) */
activation_twice ::= "twice"
/* @sem $activation_times_count */
activation_n_times ::= activation_times_count "times"
activation_times_count ::= n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10

/* @sem ActivationLimits::ActivationLimits{once_each_turn:true, sorcery:true} */
limit_sorcery_once ::= "activate" "only" "as" "a" "sorcery" "and" "only" "once" "each" "turn"

/* Both restrictions belong to this activation, independently of its body. */
/* @sem ActivationLimits::ActivationLimits{sorcery:true, condition:$condition} */
limit_sorcery_condition ::= "activate" "only" "as" "a" "sorcery" "and" "only" "if" condition

/* @sem ActivationLimits::ActivationLimits{activators:All} */
limit_any_player ::= "any" "player" "may" "activate" "this" "ability"

/* @sem ActivationLimits::ActivationLimits{activators:All, sorcery:true} */
limit_any_player_sorcery ::= "any" "player" "may" "activate" "this" "ability" "but" "only" "as" "a" "sorcery"

/* @sem ActivationLimits::ActivationLimits{modifiers:$activation_counter_reduction} */
limit_cost_less_each ::= activation_counter_reduction
/* @sem ActivationLimits::ActivationLimits{sorcery:true, modifiers:$activation_counter_reduction} */
limit_cost_less_each_sorcery ::= activation_counter_reduction "." "activate" "only" "as" "a" "sorcery"

/* The written amount multiplies the population, independently of timing. */
/* @sem Change::[ActivationRule(Cost{modifier:Reduce{reductions:[ManaReduction{amount:@times($braced_amount, $count_each)}], spill_into_generic:true}})] */
activation_counter_reduction ::= "this" "ability" "costs" braced_amount "less" "to" "activate" "for" "each" count_each

/* @sem ActivationLimits::ActivationLimits{modifiers:[Change::ActivationRule(RestrictMana{portion:X, color:Red})]} */
limit_spend_red ::= "spend" "only" "red" "mana" "on" "X"

/* @sem ActivationLimits::ActivationLimits{modifiers:[Change::ActivationRule(RestrictMana{portion:X, color:Black})]} */
limit_spend_black ::= "spend" "only" "black" "mana" "on" "X"

/* @sem ActivationLimits::ActivationLimits{once_each_turn:true} */
limit_once ::= "activate" "only" "once" "each" "turn"

/* "Activate only once.": one activation for as long as this object is this object. */
/* @sem ActivationLimits::ActivationLimits{once:true} */
limit_once_ever ::= "activate" "only" "once"

/* @sem ActivationLimits::ActivationLimits{sorcery:true} */
limit_sorcery ::= "activate" "only" "as" "a" "sorcery"

/* @sem ActivationLimits::ActivationLimits{condition:$activation_window} */
limit_condition ::= "activate" "only" activation_window

/* @sem ActivationLimits::ActivationLimits{once_each_turn:true, condition:$activation_window} */
limit_condition_once ::= "activate" "only" activation_window "and" "only" "once" "each" "turn"

/* @sem ActivationLimits::ActivationLimits{condition:Not(Window(Combat))} */
limit_outside_combat ::= "you" "can't" "activate" "this" "ability" "during" "combat"

/* @sem Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[CostPart::Loyalty($loyalty)]}, limits:ActivationLimits{sorcery:true}, announcement:@announcement, body:$loyalty_program_sentence} */
activated_loyalty ::= "[" loyalty "]" ":" loyalty_program_sentence

loyalty ::= loyalty_plus | loyalty_minus | loyalty_zero

/* @sem $loyalty_number */
loyalty_plus ::= "+" loyalty_number

/* @sem @negate($loyalty_number) */
loyalty_minus ::= "−" loyalty_number

/* @sem Expr::Constant(0) */
loyalty_zero ::= "0"

loyalty_number ::= number_digits | number_x

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}} */
activated_modal ::= cost ":" mode_selection

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence} */
triggered_ability ::= event_clause "," program_sentence

/* A source's own from-anywhere trigger functions in the destination graveyard.
   Token copies also trigger; the source reference is not a nontoken-card test. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:ZoneChange{objects:@and($event_self, ObjectFilter::OwnedBy(All)), to:Graveyard}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})} */
triggered_in_graveyard ::= ("when" | "whenever") event_self "is" "put" "into" "a" "graveyard" "from" "anywhere" "," program_sentence

/* A trigger that checks its card is in your graveyard functions there. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$event_clause, intervening_if:ObjectMatches{object:Source, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})} */
triggered_if_in_graveyard ::= event_clause "," "if" "this" "card" "is" "in" "your" "graveyard" "," program_sentence
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$turn_event, intervening_if:ObjectMatches{object:Source, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})} */
triggered_turn_if_in_graveyard ::= "at" turn_event "," "if" "this" "card" "is" "in" "your" "graveyard" "," program_sentence

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{per_turn:1}, announcement:@announcement, body:$program_sentence} */
triggered_once ::= event_clause "," program_sentence "this" "ability" "triggers" "only" "once" "each" "turn" "."

/* With no event payload read, the cap makes an individual matcher equivalent
   to one group trigger. The guard runs after all references are bound. */
/* @sem Ability::@event_free_once(Ability::Triggered{event:$limited_death_clause, limits:TriggerLimits{per_turn:1}, announcement:@announcement, body:$program_sentence}) */
triggered_once_death ::= limited_death_clause "," program_sentence "this" "ability" "triggers" "only" "once" "each" "turn" "."

event_clause ::= event_when | event_whenever | event_clause_opponent_three | event_clause_enchanted_mutual_attack | first_counters_on_permanent_clause | event_clause_batch_alternatives | event_clause_batch_alternatives_reversed | event_when_and_whenever_solve_case | exile_from_two_zones_event | event_clause_counter_put_on | entry_and_card_play_clause | cast_spell_target_threshold | whenever_cast_or_activate_card_ability | state_keyword_when | state_source_power_when | state_source_counters_when | event_when_this_class_level | event_clause_batch_passive_player | whenever_filtered_card_leaves_your_graveyard

/* @sem $event */
/* @prefer once */
event_when ::= "when" event

/* @sem $event */
/* @prefer recurs */
event_whenever ::= "whenever" event

/* @sem Ability::Triggered{event:$event_clause, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence} */
triggered_if ::= event_clause "," "if" condition "," program_sentence

/* A source spell's cast trigger functions on the stack. The condition precedes
   target resolution and belongs to the trigger, including a kicked-state test. */
/* @sem Ability::Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:Spell{event:Cast, players:One(AbilityController), spells:$event_self}, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})} */
triggered_cast_if ::= "when" "you" "cast" event_self "," "if" condition "," program_sentence

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence} */
triggered_turn ::= "at" turn_event "," program_sentence

/* @sem Ability::Triggered{event:$turn_event, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence} */
triggered_turn_if ::= "at" turn_event "," "if" condition "," program_sentence

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}} */
triggered_modal ::= event_clause "," mode_selection

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}} */
triggered_turn_modal ::= "at" turn_event "," mode_selection

mode_selection ::= choose_graveyard_types_or_more | choose_number_random | choose_random_unless | choose_number | choose_number_repeatable | choose_one_commander_both | choose_one_unchosen | choose_one_unchosen_turn | choose_one_or_both | choose_one_or_more | shared_pump_two_modes

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_number ::= "choose" number_words ("—" | ".") NEWLINE modes

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$modes, rules:ModeRules{repetition:MayRepeat, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_number_repeatable ::= "choose" number_words "." "you" "may" "choose" "the" "same" "mode" "more" "than" "once" "." NEWLINE modes

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Expr::Constant(1), maximum:Expr::Conditional{condition:Controls{player:AbilityController, filter:State(Commander), minimum:1}, then:Constant(2), otherwise:Constant(1)}}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_one_commander_both ::= "choose" "one" "." "if" "you" "control" "a" "commander" "as" "you" "cast" "this" "spell" "," "you" "may" "choose" "both" "instead" "." NEWLINE modes

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Expr::Constant(1), maximum:Expr::Constant(1)}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Unchosen(ThisGame), targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_one_unchosen ::= "choose" "one" "that" "hasn't" "been" "chosen" "—" NEWLINE modes
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Expr::Constant(1), maximum:Expr::Constant(1)}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Unchosen(ThisTurn), targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_one_unchosen_turn ::= "choose" "one" "that" "hasn't" "been" "chosen" "this" "turn" "—" NEWLINE modes

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Expr::Constant(1), maximum:@length($modes)}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_one_or_more ::= "choose" "one" "or" "more" "—" NEWLINE modes

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Expr::Constant(1), maximum:Expr::Constant(2)}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
