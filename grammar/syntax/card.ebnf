/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One($target_card), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@prior, phase:After, index:0}, filter:$exiled_card_test}, then:$program, otherwise:$program_2}]}} */
triggered_turn_exile_card_type_test_otherwise ::= "at" turn_event "," "exile" target_card "." "if" "it" "was" "a" exiled_card_test "," program "." "otherwise" "," program "."

