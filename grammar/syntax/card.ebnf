_choose_uncontrolled_counter | instructions_foreign_look_split | instructions_random_opponent_card_types

/* Oracle joins a life drain with `and` and cards drawn then discarded with `, then`. */
/* @sem Instruction::[...$clause_lose_life, ...$clause_you_life] */
instructions_drain ::= clause_lose_life "and" clause_you_life

/* Both life changes use the performed exile count, including after an earlier
   instruction. The quantified tail is one clause, so its gain cannot escape. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_objects}, Effect{result:@next, operation:LoseLife{players:One($that_player), amount:@times($number, Expr::CountObjects(Transition{result:@marked, phase:Before}))}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:@times($number_2, Expr::CountObjects(Transition{result:@marked, phase:Before}))}}] */
instructions_exile_counted_drain ::= exile_objects "." "for" "each" "card" "exiled" "this" "way" "," that_player "loses" number "life" "and" "you" "gain" number "life"

/* At most one card is exiled, so a card of a kind was exiled exactly when the
   exiled card is one of that kind. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:Any})), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$exiled_kind}, then:Program{instructions:$instructions}, otherwise:Program{}}] */
instructions_exile_one_graveyard_card_kind ::= "exile" "up" "to" "one" "target" "card" "from" "a" "graveyard" "." "if" exiled_kind "card" ("is" | "was") "exiled" "this" "way" "," instructions
exiled_kind ::= exiled_kind_any | exiled_kind_filtered
/* @sem ObjectFilter::Any */
exiled_kind_any ::= "a"
/* @sem $card_filter */
exiled_kind_filtered ::= ("a" | "an") card_filter

/* @sem Instruction::[...$clause_loot, ...$clause_imperative] */
instructions_loot ::= clause_loot "," "then" clause_imperative

/* @sem @apply($players_singular, $verbs_lose) */
clause_lose_life ::= players_singular verbs_lose

/* @sem Instruction::[$verb_lose] */
verbs_lose ::= verb_lose

/* @sem Instruction::Effect{result:@next, operation:$lose_life_third} */
verb_lose ::= lose_life_third

/* @sem @apply(PlayerSet::One(PlayerRef::AbilityController), $verbs_draw) */
clause_loot ::= verbs_draw

/* @sem Instruction::[$verb_draw] */
verbs_draw ::= verb_draw

/* @sem Instruction::Effect{result:@next, operation:$draw_base} */
verb_draw ::= draw_base

instructions_one ::= clause

/* @sem Instruction::[...$clause, ...$instructions] */
instructions_more ::= clause sequencer instructions

/* A postposed time owns an explicit then-tail until the sentence ends.
   Its joined form is a clause, so it cannot be split into an immediate tail. */
/* @sem Vec<Instruction>::@then_sequence($clause_before_then, $instructions) */
instructions_more_then ::= clause_before_then "," "then" instructions

clause_before_then ::= clause_immediate | clause_may | clause_may_then | clause_seek_cards

/* @sem () */
sequencer ::= "." | "." "then"

/* @sem Vec<Instruction>::@and_sequence($clause, $instructions) */
instructions_more_and ::= clause "and" instructions

/* "That player" in a following "and" clause would be each opponent in turn, a
   loop these partitioned targets don't make, so a per-opponent clause ends its
   sentence. */
each_opponent_instructions ::= each_opponent_alone | each_opponent_more
each_opponent_alone ::= each_opponent_clause
/* @sem Instruction::[...$each_opponent_clause, ...$instructions] */
each_opponent_more ::= each_opponent_clause sequencer instructions
each_opponent_clause ::= clause_exile_each_opponent_value | clause_exile_each_opponent_target | clause_exile_each_opponent_target_until | clause_gain_control_each_opponent_target | clause_gain_control_each_opponent_target_indefinite

/* One subject both changes and deals damage: the changed object is the source. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($object_ref)), changes:$changes, duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:$recipients, amount:$value, preventable:true}}] */
instructions_changed_object_deals ::= object_ref changes duration "and" "deals" value "damage" "to" recipients

clause ::= clause_retarget_player_destination | clause_retarget_optional_stack | clause_that_player_flip_if | clause_flip_coin_if | clause_you_and_objects_gain_hexproof | clause_cast_as_though_flash | clause_becomes_color_choice | clause_become_color_choice | clause_becomes_color_choice_indefinite | clause_becomes_colors_choice | clause_becomes_colors_choice_indefinite | clause_changes_and_color_choice | clause_opponent_piles_graveyard | clause_opponent_piles_bottom | clause_created_gains | clause_created_gain | clause_return_owner_as_enchantment | clause_exile_hand_face_down | clause_return_owned_exiled_with | clause_no_maximum_hand_size_rest | clause_return_pool_owner_hand | clause_may_have_copy | clause_player_exiles_hand | clause_each_exiles_hand | clause_player_exiles_graveyard | clause_each_exiles_graveyard | clause_exile_copy_cast | clause_exile_while_exiled | clause_exile_while_exiled_spending | clause_copy_ref_new_targets | clause_copy_ref_targets_created | clause_copy_ref_targets_self | clause_next_cast_copy | mana_clause_optional | mana_clause_restricted | clause_search_name_exile | clause_search_same_name_exile | clause_mill_take | clause_player_may_search | clause_reveal_discard_all | clause_shared_duration_changes | clause_discard_per_drawn | clause_each_exiles_top | clause_look_put_then | clause_word_vote | clause_color_vote | clause_requested_optional_draw | clause_independent_may_choices | clause_destroy_unless_paid_success | clause_return_success_payment | clause_exile_card_value_rewards | clause_target_counter_lasting_grant | clause_optional_top_card_life | clause_seek_delayed_discard | clause_delayed_cleanup_after | clause_perpetual_card_changes | clause_seek_cards | clause_seek_card | clause_linked_mana_instead | clause_equal_object_you_damage | clause_each_player_fixed_mana | clause_relative_upkeep_after | clause_immediate | clause_may | clause_may_then | clause_delayed_end_step_after | clause_delayed_upkeep_after | clause_delayed_combat_after | clause_delayed_end_step_then | clause_delayed_upkeep_then | clause_delayed_combat_then | clause_counter_threshold_remove_them | clause_counter_threshold_remove_those | clause_delayed_this_combat | clause_target_upkeep_return | clause_extra_step_one | clause_extra_steps | clause_free_graveyard_cast | clause_return_cross_zone_populations | clause_created_counter_choice | clause_created_mill_counter | clause_copy_chosen_creatures | clause_hidden_top_access | clause_untap_attacking_and_goad | clause_next_entries_copy_target | clause_exile_optional_owner_cast | clause_choose_grant_departure | clause_draft_repeated_battlefield | clause_counter_threshold_postposed_else | clause_chosen_player_game_outcome | clause_copy_ref_and_new_targets | clause_player_look_split_face_down | clause_optional_reveal_top_card_loss | clause_tapped_remove_combat | clause_exile_library_mana_threshold | clause_choose_card | clause_search_owner_same_name_exile | clause_investigate_per_vote | clause_next_pair_spell_mechanic | clause_prior_creature_attacks_opponents | clause_paired_perpetual_keyword | clause_exile_event_counter_targets_until | clause_player_exiles_graveyard_many | clause_additional_beginning_phase | clause_optional_reveal_matching | clause_counter_threshold_remove_all_of_them | clause_counter_threshold_remove_serial_then | clause_counter_threshold_remove_serial_and | clause_counter_threshold_remove_her | clause_each_player_seeks | clause_seek_manifest | clause_exile_ordered_play_free | conditional_top_card_permission | clause_exile_top_play_one | clause_optional_hand_exile_permission | clause_you_and_objects_protection | clause_duration_chosen_color_grant | clause_delayed_end_conditional | clause_player_hand_selection_exile | clause_reveal_duplicate_discard | clause_destroy_chosen_controlled_final | clause_random_reveal_discard | clause_choose_hand_discard_rest | clause_one_time_perpetual_boon | clause_each_exiles_except_bottom | clause_created_tokens_goaded | clause_return_grave