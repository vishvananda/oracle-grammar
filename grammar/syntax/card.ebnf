n_ban | linked_exile_visibility_permission | linked_exile_turn_permission | shared_card_type_cast_reduction | entry_copy_embalmed | entry_copy_reflexive | entry_copy_explicit | owner_mixed_library_choice | put_mixed_library_depth | choose_mixed_color_library | named_event_counter_trigger | aura_upkeep_shared | entry_copy_additional_counters | entry_copy_battlefield_exception_ability | triggered_creature_attack_poisoned_defender | attachment_conditional_player | attachment_conditional_turn_prohibition | first_targeted_activation_reduction | collector_once_conjure_trigger | first_spell_cast_or_create_trigger | static_spell_object_cost | static_other_controlled_subtype_list_pump | static_controlled_zombie_population_pump | spell_extra_turn_end | spell_opponent_selects_modes | casting_self_unless_condition | static_you_activate_equip_reduction | triggered_attacker_block_requirement | casting_x_counted_cards | casting_reduction_if_opponent_controls | scalar_counter_static_otherwise | singular_entry_replacement | turn_conditional_player_permission | conditional_player_permission | player_exhaust_permission | triggered_haunted_source_dies | as_escape_counter_reflexive | activated_command_self_entry | activated_transfer_source_grant_convert | triggered_player_not_attacking_you | as_object_turned_face_up_action | static_conditional_first_it | spell_action_with_damage_restriction | scoped_turn_source_zone_condition | graveyard_self_exile_reflexive_trigger | graveyard_optional_library_replacement | discard_reveal_replacement | static_graveyard_cast_condition_exile | activated_discard_receipt | activated_any_player_stack | static_top_graveyard_text_if | replacement_pay_life_with_operation | entry_instead_sacrifice_other | draw_skip_replacement | draw_skip_while_library | static_top_card_shared_color | charge_threshold_ability | static_additional_lands | static_defining_named_values | static_defining_holder_values | activated_paid_removal_pump | casting_alternative_opponent_hist