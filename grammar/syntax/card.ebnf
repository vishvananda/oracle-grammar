triggered_turn_if_attacked_bare ::= "at" turn_end_combat_bare "," "if" condition_attacked "," turn_intervening_program_sentence

/* @sem Ability::Triggered{event:$turn_event, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$turn_intervening_program_sentence} */
triggered_turn_if_standard ::= "at" turn_event "," "if" condition "," turn_intervening_program_sentence

/* @prefer always */
clause_created_counter_dispatch ::= clause_created_counter_choice

/* Compose a preceding operation with the separately defined blocker requirement. */
