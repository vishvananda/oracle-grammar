fice_colors_return | clause_attack_batch_create_tokens | clause_starting_optional_hand_entry | clause_starting_optional_hand_entry_plural | clause_each_optional_graveyard_action | graveyard_single_return_battlefield | clause_gains_artifact_or_color_protection | each_player_choice_range | each_second_choice_counter | each_player_copies_first_chosen | clause_land_type_pair_timed | clause_control_creatures_untap_grant | put_hand_selection_battlefield | clause_choose_cards_to_battlefield | clause_chosen_hand_guess_optional_cast | clause_ref_add_creature_type_choice | clause_chosen_caster_spell_damage | clause_may_have_equal_base_stats | grouped_observe_reorder_bottom | clause_search_either_graveyard_attached | clause_spared_unless_controller_damage | clause_shuffle_owned_zones_draw | clause_each_life_total_literal | clause_player_exile_until_observed | prior_creatures_untap_additional | clause_creatures_snapshot_untap | clause_each_library_exile_opponent_choice | instructions_three_damage_exile | clause_remove_combat_untap | clause_shuffle_hand_owned_permanents_draw | clause_each_any_hand_entry | clause_optional_remove_counted_draw | clause_willing_mana_unless | clause_each_same_object_unless_any_life | clause_player_verb_and_hand_top | clause_each_optional_hand_entry_singular | clause_each_optional_hand_entry_plural | clause_pump_ability_list | clause_its_controller_sacrifice_another | clause_exile_and_graveyard_population | copy_next_activated_retarget | clause_pump_cant_be_blocked | choose_each_basic_type_destroy | clause_counter_postcondition | clause_villainous_target_grouped | instructions_intensity_damage_and_intensify | clause_each_controlled_subtype_role | clause_optional_resource_payment_draw | clause_announced_players_each | clause_shuffle_own_zone | clause_opponent_graveyard_exile_counter | player_copies_for_all_legal_targets | clause_each_unless_that_player_choice | counter_loop_player_body | instructions_exile_return_him_shared | clause_exile_payment_token_followups | clause_shuffle_own_zones_and_permanents | clause_attach_it_to_another_enchantable | clause_next_activation_action | clause_exile_choice_until_count_tokens | clause_players_choose_type_return | clause_each_hand_library_selection | distinct_search_opponent_return | clause_foreign_library_exile | random_opponent_graveyard_exile | clause_also_damage_target_controller_if | clause_each_player_bound_damage | clause_player_draw_history_damage | clause_revealed_hand_or_graveyard_exile | instructions_selected_player_action | clause_hand_library_end_choice | clause_destroy_singular_unregenerable_and | clause_exile_ranked_controlled | clause_counters_three_distinct_targets | clause_target_opponent_hand_entry | clause_exile_optional_other_until | clause_destroy_unless_different_colors | clause_controlled_keyword_main_phase_counters_keyword | clause_create_for_opponents_counters | clause_conjure_then_sacrifice | clause_observed_optional_discard_draw | clause_davriel_offer | clause_davriel_condition | clause_target_controller_investigates_exiled | clause_tempt_copy_target | clause_optional_exile_hand_or_graveyard_counter | clause_conditional_look_hand_bottom_random | clause_may_return_if_that_creature_stat | clause_players_create_per_graveyard_card | clause_then_destroy_other_attached_populations | remove_unblocking_combat | block_chosen_attacker | clause_destroy_choice | clause_event_damage_unless_opponent_damaged | clause_trigger_spell_two_keywords | copy_for_each_controlled_legal_target | clause_damage_each_player_card_count | clause_then_graveyard_return_optional | clause_tap_group_live_while_tapped | clause_attach_chosen_host | clause_destroy_land_controller_damage | linked_owner_optional_cast | clause_look_hand_choose_discard | clause_you_skip_next_turn | clause_player_action_and_control | conditional_target_graveyard_entry_counters | clause_relocate_attachment | clause_loop_sacrifice_unless_pay | clause_shared_three_counter_kinds | clause_player_hand_cards_top | clause_three_counter_kinds | clause_may_destroy_if_tapped_h3 | clause_choose_target_if_tapped_counter_or_tap_h3 | clause_destroy_all_other_event_name_unregen_h3 | clause_return_controlled_followup_h3 | clause_seek_mana_value_equal_h3 | instructions_self_return_front

/* Life changes keep their subject; drawing and discarding usually drop it. */
/* @sem @apply(PlayerSet::One(PlayerRef::AbilityController), $verbs_life) */
clause_you_life ::= "you" verbs_life

/* @sem Instruction::[$instruction] */
clause_operation ::= instruction

/* @sem Instruction::Effect{result:@next, operation:$operation} */
instruction ::= operation

/* @sem @apply(PlayerSet::One(PlayerRef::AbilityController), $verbs_base) */
clause_you ::= "you" verbs_base

/* @sem @apply(PlayerSet::One(PlayerRef::AbilityController), $verbs_base) */
clause_imperative ::= verbs_base

/* @sem @apply($players_singular, $verbs_third) */
clause_third ::= players_singular verbs_third

/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::Destroy{objects:$object_set, regeneration:false}}] */
clause_destroy_final ::= "destroy" object_set "." ("it" | "they" | "that" "creature") "can't" "be" "regenerated"

/* "A creature destroyed this way" (or "Creatures destroyed this way") names each object
   the sentence before it destroys; none of them can be regenerated. The noun and its
   number agree with what is destroyed. */
instructions_unregenerable ::= instructions_unregenerable_one | instructions_unregenerable_each
/* @sem Vec<Instruction>::@unregenerable_one($destroying_sentence, $noun_atomic) */
instructions_unregenerable_one ::= destroying_sentence "." "a" noun_atomic "destroyed" "this" "way" "can't" "be" "regenerated"
/* @sem Vec<Instruction>::@unregenerable_each($destroying_sentence, $plural_atomic) */
instructions_unregenerable_each ::= destroying_sentence "." plural_atomic "destroyed" "this" "way" "can't" "be" "regenerated"
destroying_sentence ::= clause | clause_closed
/* @sem Instruction::[...$instructions_unregenerable, ...$instructions] */
instructions_unregenerable_more ::= instructions_unregenerable sequencer instructions

/* A Licid becomes an Aura until its controller pays to end the effect: the trailing
   payment sets the duration of the change the first sentence makes. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[LosesAbility(Term{family:CheckHasable, form:ThisAbility}), AddEnchantmentType(Vocabulary{family:EnchantmentType, form:Aura}), AddCardType(Enchantment), GrantAbility(Enchant{hosts:Permanents($filter_phrase)})], duration:UntilPaid{player:AbilityController, cost:$cost}, evaluation:Snapshot}}, Effect{result:@next, operation:$operation}] */
instructions_aura_until_paid ::= affected "loses" "this" "ability" "and" "becomes" "an" "Aura" "enchantment" "with" "enchant" filter_phrase "." operation "." "you" "may" "pay" cost "to" "end" "this" "effect"

/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::Draw{players:Union([One(PlayerRef::AbilityController), One($player_ref)]), amount:$card_count}}] */
clause_you_and_target ::= "you" "and" player_ref "each" "draw" card_count

/* @sem @apply(PlayerSet::One(@that_player), $verbs_base) */
clause_they ::= "they" verbs_base

/* Another player's "may" is that player's own choice. */
/* @sem Instruction::[Optional{decider:$player_ref, body:Program{instructions:@apply(PlayerSet::One($player_ref), $verbs_base)}}] */
clause_player_may ::= player_ref "may" verbs_base

/* A sentence that only names a target for the sentences after it. */
/* @sem Instruction::[@choose($target_object)] */
clause_choose ::= "choose" target_object
/* A set of targets named first is what later plural references mean. */
/* @sem Instruction::[@choose($objects_targets_plain)] */
clause_choose_targets ::= "choose" objects_targets_plain

/* @sem Instruction::[@choose($chosen_player)] */
clause_choose_player ::= "choose" chosen_player
chosen_player ::= target_player | target_opponent

/* The spoken player and the card's owner have separate roles. */
/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::Move{objects:@zone_members(ObjectSet::InZone{objects:One($object_ref), zone:Graveyard}), destination:Battlefield{controller:Player($that_player), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
clause_player_put_card ::= that_player "puts" object_ref "from" "its" "owner's" "graveyard" "onto" "the" "battlefield" "under" "their" "control"

/* @sem Instruction::[@choose(PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Expr::Constant(1)), filter:Any, players:Intersection([OpponentsOf(PlayerRef::AbilityController), Matching{binding:0, condition:Compare{left:Expr::PlayerNumber{player:Bound(0), number:Life}, test:NumberTest::Compare{comparison:Greater, value:Expr::PlayerNumber{player:AbilityController, number:Life}}}}])}), index:0})] */
clause_choose_richer ::= "choose" "target" "opponent" "who" "has" "more" "life" "than" "you" "do" "as" "you" "activate" "this" "ability"
/* @sem Instruction::[@choose(PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Expr::Constant(1)), filter:Any, players:Intersection([OpponentsOf(PlayerRef::AbilityController), Matching{binding:0, condition:Compare{left:Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(Bound(0))))}), test:NumberTest::Compare{comparison:Greater, value:Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController)))})}}}])}), index:0})] */
clause_choose_controls_more ::= "choose" "target" "opponent" "who" "controls" "more" filter_plural "than" "you" "do" "as" "you" "activate" "this" "ability"
/* @sem Instruction::[@choose(PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Expr::Constant(1)), filter:Any, players:Intersection([OpponentsOf(PlayerRef::AbilityController), Matching{binding:0, condition:Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Add([Expr::CountObjects(Zone{scope:Players{zone:Hand, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}), $number])}}}])}), index:0})] */
clause_choose_more_cards ::= "choose" "target" "opponent" "who" "has" "at" "least" number "more" "cards" "in" "hand" "than" "you" "do" "as" "you" "activate" "this" "ability"

/* Gapped conjuncts under one subject and verb, each with its own condition:
   `you gain X life if {G} was spent to cast this spell and X life if {W} was
   spent to cast this spell`. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:$number}}]}, otherwise:Program{}}, If{condition:$condition_2, then:Program{instructions:[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:$number_2}}]}, otherwise:Program{}}] */
clause_gapped_gain_life ::= "you" "gain" number "life" "if" condition "and" number "life" "if" condition
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:$recipients, amount:$number, preventable:true}}]}, otherwise:Program{}}, If{condition:$condition_2, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:$recipients_2, amount:$number_2, preventable:true}}]}, otherwise:Program{}}] */
clause_gapped_damage ::= damage_source_ref "deals" number "damage" "to" recipients "if" condition "and" number "damage" "to" recipients "if" condition
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players($player_rule_subject), changes:$player_prohibitions, duration:$duration, evaluation:LiveObjects}}]}, otherwise:Program{}}, If{condition:$condition_2, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players($player_rule_subject), changes:$player_prohibitions_2, duration:$duration_2, evaluation:LiveObjects}}]}, otherwise:Program{}}] */
clause_gapped_prohibition ::= player_rule_subject "can't" player_prohibitions duration "if" condition "and" "can't" player_prohibitions duration "if" condition

/* An Oath: each upkeep, that player chooses an opponent who has more of
   something than they do, and then may act. */
/* @sem Ability::[Triggered{event:Turn{point:UpkeepBegins, players:All}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[@choose(PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Expr::Constant(1)), filter:Any, players:Intersection([$oath_rival, OpponentsOf(EventSubject)]), chooser:EventSubject}), index:0}), Optional{decider:EventSubject, body:Program{instructions:$oath_action}}]}}] */
line_oath ::= "at" "the" "beginning" "of" "each" "player's" "upkeep" "," "that" "player" "chooses" "target" "player" oath_rival "and" "is" "their" "opponent" "." "the" "first" "player" "may" oath_action "."

oath_rival ::= oath_rival_hand | oath_rival_controls | oath_rival_graveyard | oath_rival_life
/* @sem PlayerSet::Matching{binding:0, condition:Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Greater, value:Expr::CountObjects(Zone{scope:Players{zone:Hand, players:One(EventSubject)}, kind:Card, filter:Any})}}} */
oath_rival_hand ::= "who" "has" "more" "cards" "in" "hand" "than" "they" "do"
/* @sem PlayerSet::Matching{binding:0, condition:Compare{left:Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(Bound(0))))}), test:NumberTest::Compare{comparison:Greater, value:Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(EventSubject)))})}}} */
oath_rival_controls ::= "who" "controls" "more" filter_plural "than" "they" "do"
/* @sem PlayerSet::Matching{binding:0, condition:Compare{left:Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:$card_filter}), test:NumberTest::Compare{comparison:Less, value:Expr::CountObjects(Zone{scope:Players{zone:Graveyard, players:One(EventSubject)}, kind:Card, filter:$card_filter})}}} */
oath_rival_graveyard ::= "whose" "graveyard" "has" "fewer" card_filter "cards" "in" "it" "than" "their" "graveyard" "does"

/* What the first player, the upkeep's own player, may then do. */
oath_action ::= oath_discard_draw | oath_return | oath_search | oath_reveal | oath_source_damage
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:EventSubject, filter:$card_filter, count:Expr::Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$card_filter}, destination:Battlefield{controller:Player(EventSubject), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
oath_reveal ::= "reveal" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" ("a" | "an") card_filter "card" "." "if" "the" "first" "player" "does" "," "that" "player" "puts" "that" "card" "onto" "the" "battlefield" "and" "all" "other" "cards" "revealed" "this" "way" "into" "their" "graveyard"
/* @sem Instruction::[Effect{result:@next, operation:Discard{players:One(EventSubject), amount:CountObjects(Zone{scope:Players{zone:Hand, players:One(EventSubject)}, kind:Card, filter:Any})}}, Effect{result:@next, operation:Draw{players:One(EventSubject), amount:$card_count}}] */
oath_discard_draw ::= "discard" "their" "hand" "and" "draw" card_count
/* @sem Instruction::[Effect{result:@mark, operation:ChooseObjects{player:EventSubject, objects:Zone{scope:Players{zone:Graveyard, players:One(EventSubject)}, kind:Card, filter:$card_filter}, count:AsManyAsCan(Expr::Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
oath_return ::= "return" ("a" | "an") card_filter "card" "from" "their" "graveyard" "to" "their" "hand"
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:EventSubject, library_owner:EventSubject, choices:[$player_search_one_choice]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(EventSubject), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(EventSubject)}}] */
oath_search ::= "search" "their" "library" "for" player_search_one_choice "," "put" found_one "onto" "the" "battlefield" "," "then" "shuffle"

/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::DealDamageParts{source:$object_ref, parts:[_{recipients:$recipients, amount:$number}, _{recipients:$recipients_you, amount:$number_2}], preventable:true}}] */
clause_deal_two ::= object_ref "deals" number "damage" "to" recipients "and" number "damage" "to" recipients_you

/* Both simultaneous contributions survive when the chosen recipient is also the source. */
/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::DealDamageParts{source:$object_ref, parts:[_{recipients:$recipients, amount:$number}, _{recipients:Objects(One($object_ref)), amount:$number_2}], preventable:true}}] */
clause_deal_and_itself ::= object_ref "deals" number "damage" "to" recipients "and" number "damage" "to" "itself"

/* A condition governs up to the end of its sentence, so only a full stop ends it. */
clause_closed ::= clause_graveyard_conditional_battlefield_or_hand | clause_offer_otherwise_convert_it | instructions_attacked_otherwise | clause_event_controller_declines_payment | clause_required_payment_otherwise | clause_conditional_closed | clause_if_you_dont | clause_if_you_do_otherwise | clause_if_they_dont

/* A negative payment followup can also apply when an enclosing condition
   prevented the offer. Its outer fallback is declared by its complete unit. */
clause_conditional_closed ::= clause_constrained_exile_entry | clause_linked_source_transform | clause_willing_sacrifice_or_damage | clause_control_if_they_do | clause_unless_any_player_mana | instructions_hand_pick_until | clause_then_if | instructions_hand_subset_permission | clause_paid_hand_subset | instructions_subset_hand_compare | instructions_chosen_hand_compare | instructions_hand_pick | instructions_hand_pick_subset | instructions_look_hand_pick | instructions_look_hand_pick_optional | instructions_reciprocal_graveyard_choices | temporary_trigger_exile_receipt | temporary_trigger_prefix | temporary_trigger_prefix_if | temporary_trigger_this_turn | temporary_trigger_this_turn_if | temporary_trigger_this_turn_it_changes | clause_if | clause_fewer_difference_tokens | clause_if_optional_fallback | clause_if_you_do | clause_if_you_do_reveal_test | clause_required_if_you_do | clause_required_if_you_cant | clause_sacrifice_then_damage | clause_top_card_revealed | clause_top_card_revealed_declined | clause_top_card_revealed_taken | clause_top_card_put | clause_top_card_put_declined | clause_top_card_put_declined_it | clause_top_card_put_this_way | clause_top_card_put_otherwise | clause_attackers_do_the_same | clause_attach_random_opponent | clause_exile_choose_one_play | clause_reveal_any_number_hand | clause_reveal_any_number_hand_with | clause_return_graveyard_kind_for_each | clause_copy_new_targets | clause_retarget_stack_spell | clause_copy_ref_for_each_new_targets | clause_counter_elsewhere | clause_counter_unless_elsewhere | clause_if_you_do_where | clause_if_they_do | clause_willing_spell_payment | clause_first_willing_exile | clause_paid_token_followups | clause_player_sacrifice_if_done | clause_destroy_unless_stat_life | clause_first_willing_sacrifice | clause_if_that_player_does | clause_copy_twice_new_targets | clause_copy_conditional_twice | clause_if_you_do_program | clause_exile_pile_return | conditional_retarget_source | instructions_hand_creature_life_discard | instructions_hand_pick_shuffle | recipient_conditional_block | clause_hand_condition_instead | optional_hand_reveal_choice | clause_opponent_willing_fallback | clause_top_card_put_qualified | clause_top_card_put_declined_short | instructions_reveal_two_mana_choices | clause_exile_choose_one_play_spending | instructions_hand_exile_conditional_permission | clause_paid_program_hand_attack | clause_paid_library_selection | clause_exile_payment_group_permission | clause_exile_receipt_copy | clause_then_hand_shortfall_draw | clause_counter_kind_destination | clause_counter_targeting_bonus | clause_put_chosen_private_cards | clause_sacrifice_draw_if_kind | clause_counter_suspend | clause_optional_reveal_top_same_value | clause_reveal_top_optional_entry_fallback | clause_measured_life_payment_counters | required_action_exile_cast_fallback | exchange_opponent_target_if_do_unless_energy | clause_paired_creature_also_changes | clause_chosen_mana_unless_payment | clause_operation_unless_hand_alternatives | clause_optional_graveyard_library_stat_damage | clause_willing_damage_declined | clause_if_anaphoric_type_grant | clause_conditional_target_controller_exile | clause_paid_look_hand_split | clause_target_counter_difference | clause_copy_color_new_targets | clause_paid_search_noun_or_basic | clause_delayed_chosen_combat_event | clause_hand_excess_difference_draw | clause_event_him_payment_if_done | clause_pay_history_for_token | clause_exile_card_copy_cleanup | clause_if_defined_life_paid | clause_optional_top_reveal_entry_fallback | clause_top_graveyard_kind_to_library | blue_pair_conditional_search

/* @sem Vec<Instruction>::@returned_conditional([@leading_if(Instruction::If{condition:$condition, then:$then_condition_program, otherwise:Program{}})]) */
clause_if ::= "if" condition "," then_condition_program

/* "Equal to the difference" counts what the condition compared: how many more
   of a kind you control than that player does. */
/* @sem Instruction::[If{condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(PlayerSet::One($condition_control_they)))}), test:Compare{comparison:Less, value:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(PlayerSet::One(PlayerRef::AbilityController)))})}}, then:Program{instructions:[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Subtract([CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(PlayerSet::One(PlayerRef::AbilityController)))}), CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(PlayerSet::One($condition_control_they)))})]), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}]}, otherwise:Program{}}] */
clause_fewer_difference_tokens ::= "if" condition_control_they "fewer" filter_plural "than" "you" "," "create" "a" "number" "of" token_recipe "equal" "to" "the" "difference"

conjoined ::= untap_goad_referred_rule | tap_event_creature_combat_removal | event_player_return_choice | optional_event_stat_hand_entry | tap_named_group_opponent_control | instructions_announced_players | nested_closed_callback | clause | conjoined_more | conjoined_more_then | serial_controller_survey_keyword | conjoined_serial | instructions_draft_single_entry | instructions_announced_hand_draw | instructions_announced_hand | return_card_conditional_type | entry_subtype_instructions | instructions_next_chosen_prevent | conjure_duplicate_perpetual_type | clause_seek_perpetual_retained | chosen_opponent_control_sentence | combat_self_removal_with_followup | instructions_explore_twice | reveal_single_move_shuffle | conjoined_copy_retarget_followup | repeated_controller_rules_and | serial_before_attached_counter_grant | attached_counter_grant | player_exiles_population_creates_receipt | clause_tap_target_permanents_skip | search_event_player_library_group | damage_sources_destroy_unless_life | clause_holder_no_combat_assignment | choose_color_reveal_hand_damage | conjoined_comma_opponent_choice | counter_event_ability_instruction

/* @sem Instruction::[...$clause, ...$conjoined] */
conjoined_more ::= clause "and" conjoined
/* @sem Vec<Instruction>::@then_sequence($clause_before_then, $conjoined) */
conjoined_more_then ::= clause_before_then "," "then" conjoined

instructions_closed_one ::= clause_closed

/* @sem Instruction::[...$clause_closed, ...$instructions] */
instructions_closed_more ::= clause_closed "." instructions

/* @sem Vec<Instruction>::@returned_conditional([Instruction::If{condition:$condition, then:Program{instructions:$clause}, otherwise:Program{instructions:$conjoined}}]) */
instructions_if_otherwise ::= "if" condition "," clause "." "otherwise" "," conjoined

/* Repeated headers describe independently scoped triggers sharing words, not
   a conjunction of events that must happen together. Bind each program copy in
   its own event/target frame; native normalization may merge compatible bodies.
   Cycling/discard function across zones; a self-cast trigger functions on Stack.
   Their scope must never leak to the other trigger. */
/* @sem Ability::[Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}, Triggered{event:$event_clause_2, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}] */
line_repeat_regular ::= event_clause "and" event_clause "," program_sentence

/* @sem Ability::[Triggered{event:$event_clause, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}, Triggered{event:$event_clause_2, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}] */
line_repeat_regular_if ::= event_clause "and" event_clause "," "if" condition "," program_sentence

/* @sem Ability::[Scoped{zones:[Battlefield, Graveyard, Hand, Library, Stack, Exile, Command, Ante], ability:@scope(Ability::Triggered{event:$repeat_card_header, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})}, Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}] */
line_repeat_card_first ::= repeat_card_header "and" event_clause "," program_sentence

/* The self-cycle arm works across zones. The other arm is an ordinary
   battlefield trigger, so cycling this card cannot trigger both arms. */
/* @sem Ability::[Scoped{zones:[Battlefield, Graveyard, Hand, Library, Stack, Exile, Command, Ante], ability:@scope(Ability::Triggered{event:$repeat_card_header, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})}, Triggered{event:$repeat_other_cycle_battlefield, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}] */
line_repeat_cycle_or_battlefield ::= repeat_card_header "or" repeat_other_cycle_battlefield "," program_sentence
/* @sem EventSpec::Discard{players:One(AbilityController), cards:Any, source_only:false, kind:Cycling, grouping:Card} */
repeat_other_cycle_battlefield ::= "cycle" "another" "card" "while" self_text "is" "on" "the" "battlefield"

/* @sem Ability::[Scoped{zones:[Battlefield, Graveyard, Hand, Library, Stack, Exile, Command, Ante], ability:@scope(Ability::Triggered{event:$repeat_card_header, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})}, Triggered{event:$event_clause, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}] */
line_repeat_card_first_if ::= repeat_card_header "and" event_clause "," "if" condition "," program_sentence

/* @sem Ability::[Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}, Scoped{zones:[Battlefield, Graveyard, Hand, Library, Stack, Exile, Command, Ante], ability:@scope(Ability::Triggered{event:$repeat_card_header, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})}] */
line_repeat_card_last ::= event_clause "and" repeat_card_header "," program_sentence

/* @sem Ability::[Triggered{event:$event_clause, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}, Scoped{zones:[Battlefield, Graveyard, Hand, Library, Stack, Exile, Command, Ante], ability:@scope(Ability::Triggered{event:$repeat_card_header, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})}] */
line_repeat_card_last_if ::= event_clause "and" repeat_card_header "," "if" condition "," program_sentence

/* @sem Ability::[Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:$repeat_cast_header, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})}, Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}] */
line_repeat_cast_first ::= repeat_cast_header "and" event_clause "," program_sentence

/* @sem Ability::[Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:$repeat_cast_header, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})}, Triggered{event:$event_clause, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}] */
line_repeat_cast_first_if ::= repeat_cast_header "and" event_clause "," "if" condition "," program_sentence

/* @sem Ability::[Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}, Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:$repeat_cast_header, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})}] */
line_repeat_cast_last ::= event_clause "and" repeat_cast_header "," program_sentence

/* @sem Ability::[Triggered{event:$event_clause, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}, Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:$repeat_cast_header, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})}] */
line_repeat_cast_last_if ::= event_clause "and" repeat_cast_header "," "if" condition "," program_sentence

line_pair_repeated ::= line_repeat_cycle_or_battlefield | line_repeat_enters_sacrificed | line_repeat_enters_sacrificed_if | line_repeat_regular | line_repeat_regular_if | line_repeat_card_first | line_repeat_card_first_if | line_repeat_card_last | line_repeat_card_last_if | line_repeat_cast_first | line_repeat_cast_first_if | line_repeat_cast_last | line_repeat_cast_last_if

/* @sem EventSpec::Discard{players:One(PlayerRef::AbilityController), cards:Any, source_only:true, kind:Cycling, grouping:Card} */
repeat_card_cycle ::= "you" "cycle" "this" "card"

/* @sem EventSpec::Discard{players:One(PlayerRef::AbilityController), cards:Any, source_only:true, kind:Cycling, grouping:Card} */
repeat_card_cycle_named ::= "you" "cycle" SELF_NAME
/* @sem EventSpec::Discard{players:One(PlayerRef::AbilityController), cards:Any, source_only:true, kind:Any, grouping:Card} */
repeat_card_discard ::= "you" "discard" "this" "card"
/* "A spell or ability an opponent controls causes you to discard this card":
   the discard functions from every zone, like a self-cycle trigger. */
/* @sem EventSpec::Discard{players:One(PlayerRef::AbilityController), cards:SameObject(Source), kind:CausedBy(ControlledBy(OpponentsOf(AbilityController))), grouping:Card} */
repeat_card_opponent_discard ::= opponent_spell_or_ability "causes" "you" "to" "discard" "this" "card"
repeat_card_event ::= repeat_card_cycle | repeat_card_cycle_named | repeat_card_discard | repeat_card_opponent_discard
repeat_card_header ::= repeat_card_header_existing | repeat_card_plotted_header

/* Casting this spell happens to it once, so Oracle text says "when". */
repeat_cast_header ::= repeat_cast_plain | repeat_cast_outside_exile | repeat_cast_from_graveyard

/* @sem Ability::Scoped{zones:[Battlefield, Graveyard, Hand, Library, Stack, Exile, Command, Ante], ability:@scope(Ability::Triggered{event:$repeat_card_header, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})} */
source_card_trigger ::= repeat_card_header "," program_sentence

/* @sem Ability::Scoped{zones:[Battlefield, Graveyard, Hand, Library, Stack, Exile, Command, Ante], ability:@scope(Ability::Triggered{event:$repeat_card_header, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})} */
source_card_trigger_if ::= repeat_card_header "," "if" condition "," program_sentence

/* @sem Ability::Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:$repeat_cast_header, limits:TriggerLimits{}, announcement:@announcement, body:$source_cast_body})} */
source_cast_trigger ::= repeat_cast_header "," source_cast_body

/* @sem Ability::Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:$repeat_cast_header, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})} */
source_cast_trigger_if ::= repeat_cast_header "," "if" condition "," program_sentence

/* @sem Ability::[Triggered{event:ZoneChange{objects:$event_self, to:Battlefield}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}, Triggered{event:Player{event:Sacrifices, players:One(PlayerRef::AbilityController), objects:$event_self}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}] */
line_repeat_enters_sacrificed ::= ("when" | "whenever") event_self "enters" "and" ("when" | "whenever") "you" "sacrifice" "it" "," program_sentence

/* @sem Ability::[Triggered{event:ZoneChange{objects:$event_self, to:Battlefield}, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}, Triggered{event:Player{event:Sacrifices, players:One(PlayerRef::AbilityController), objects:$event_self}, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}] */
line_repeat_enters_sacrificed_if ::= ("when" | "whenever") event_self "enters" "and" ("when" | "whenever") "you" "sacrifice" "it" "," "if" condition "," program_sentence

/* Visit and prize are independent frames on the same Attraction. */
/* @sem Ability::Visit{body:@scope($visit_body)} */
visit_ability ::= "visit" "—" visit_body
/* @sem Ability::Visit{body:@scope($visit_body), prize:@scope($visit_prize)} */
visit_with_prize ::= "visit" "—" visit_body NEWLINE "prize" "—" visit_prize
visit_body ::= spell_opponent_paired_choices | visit_die_counters_body | spell_ability | spell_modal | visit_extreme_return_spell
visit_prize ::= visit_token_sacrifice_prize | spell_ability | spell_modal

/* Cases pair a rules-bearing solve condition with a separately scoped ability.
   Neither prefix is an ignorable label. */
case_ability ::= case_plain | case_reminded
/* @sem Ability::Mystery{condition:$case_condition, abilities:[@scope($case_solved)]} */
case_plain ::= "to" "solve" "—" case_condition "." NEWLINE "solved" "—" case_solved
/* @sem Ability::WithPresentation{reminder:true, ability:Mystery{condition:$case_condition, abilities:[@scope($case_solved)]}} */
case_reminded ::= "to" "solve" "—" case_condition "." "(" "if" "unsolved" "," "solve" "at" "the" "beginning" "of" "your" "end" "step" "." ")" NEWLINE "solved" "—" case_solved

case_solved ::= activated_ability | activated_limited | activated_modal | triggered_ability
    | triggered_if | triggered_once | triggered_turn | triggered_turn_exile_card_type_test_otherwise | triggered_turn_if | triggered_modal
    | triggered_turn_modal | static_ability | case_top_look_and_play | replacement_ability | replacement_clause | triggered_attack_batch_divided_damage

case_condition ::= case_life_gained_threshold | condition | case_sources_damaged | case_objects_attacked | case_cards_to_graveyard | condition_damaged_population_threshold

/* @sem Condition::Compare{left:EventHistory{event:Damage(_{source_kind:Any, sources:ControlledBy(One(AbilityController)), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Source}), window:ThisTurn, measure:DistinctSources}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
case_sources_damaged ::= number "or" "more" "sources" "you" "controlled" "dealt" "damage" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:Object{event:Attacks, objects:$filter_plural}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
case_objects_attacked ::= number "or" "more" filter_plural "attacked" "this" "turn"

/* @sem Condition::Compare{left:EventHistory{event:ZoneChange{objects:AllOf([$filter_phrase, OwnedBy(All)]), to:Graveyard}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
case_cards_to_graveyard ::= number "or" "more" filter_phrase "cards" "were" "put" "into" "graveyards" "from" "anywhere" "this" "turn"

/* @sem Program::@where_snapshot($program_plain, $value) */
program_where_snapshot ::= program_plain "," "where" "X" "is" value

/* @sem Program::@where_snapshot($program_plain, $value) */
program_where_sentence_snapshot ::= program_plain "." "X" "is" value

/* A source specializing outside the battlefield retains its functioning zone;
   this header never scopes a different card observed by the source. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:Object{event:Specializes, objects:SameObject(Source)}, limits:TriggerLimits{}, announcement:@announcement, body:$specializes_graveyard_body})} */
source_specializes_graveyard ::= ("when" | "whenever") "this" "card" "specializes" "from" "your" "graveyard" "," specializes_graveyard_body
/* @sem Ability::Scoped{zones:[Battlefield, Graveyard, Hand, Library, Stack, Exile, Command, Ante], ability:@scope(Ability::Triggered{event:Object{event:Specializes, objects:SameObject(Source)}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})} */
source_specializes_anywhere ::= ("when" | "whenever") "this" "card" "specializes" "from" "any" "zone" "," program_sentence

specializes_graveyard_body ::= program_sentence | specializes_graveyard_return_grant
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One(Source), destination:$specializes_return_destination, qualifiers:[]}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:[GrantAbility($token_quoted_sentence)]}}]} */
specializes_graveyard_return_grant ::= "return" "it" "from" "your" "graveyard" specializes_return_destination "." "it" "perpetually" "gains" token_quoted_sentence

/* The explicit source zone remains the scoped graveyard. A changed destination
   and the granted ability are read from the current native operands. */
specializes_return_destination ::= random_partition_entry | specializes_return_hand

/* @sem MovementDestination::Hand{player:AbilityController, arrival:CardArrival{counters:[], states:[]}} */
specializes_return_hand ::= "to" "your" "hand"

/* Singular draft-entry composition: no unordered multi-card result is indexed. */
/* @sem Program::Program{instructions:[...$draft_one_enter, $draft_entered_followup]} */
drafted_entry_program ::= draft_one_enter "." draft_entered_followup
/* @sem Instruction::[Effect{result:@next, operation:@drafted_result(Operation::DraftFromSpellbook{actor:One(AbilityController), spellbook:@card_name, times:Constant(1)})}, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
draft_one_enter ::= "draft" ("a" | "one") "card" "from" self_named "'s" "spellbook" "and" "put" "it" "onto" "the" "battlefield"
/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, condition:ObjectMatches{object:@remember_object(ObjectRef::Result{result:@prior, phase:After, index:0}), filter:$filter_phrase}, announcement:@announcement, body:$program})} */
draft_entered_followup ::= "when" ("a" | "an") filter_phrase "enters" "this" "way" "," program

/* Casting the source functions on Stack; cycling is a distinct discard event.
   Duplicate the shared body in separate trigger/announcement scopes. */
/* @sem Ability::[Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:Spell{event:Cast, players:One(PlayerRef::AbilityController), spells:$event_self}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})}, Triggered{event:Discard{players:One(PlayerRef::AbilityController), cards:Any, source_only:true, kind:Cycling, grouping:Card}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}] */
line_cast_or_cycle ::= ("when" | "whenever") "you" "cast" "or" "cycle" event_self "," program_sentence

/* @sem Ability::[Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:Spell{event:Cast, players:One(PlayerRef::AbilityController), spells:$event_self}, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})}, Triggered{event:Discard{players:One(PlayerRef::AbilityController), cards:Any, source_only:true, kind:Cycling, grouping:Card}, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}] */
line_cast_or_cycle_if ::= ("when" | "whenever") "you" "cast" "or" "cycle" event_self "," "if" condition "," program_sentence

/* That many names the requested draw amount, including when drawing is
   prohibited or replaced. Capture it before either action changes the hand. */
/* @sem @apply(PlayerSet::One($target_player), $verbs_draw_discard_amount) */
instructions_draw_discard_amount ::= target_player verbs_draw_discard_amount

/* @sem Instruction::[Effect{result:@mark, operation:BindValue{value:$card_count}}, Effect{result:@next, operation:Draw{players:@subject, amount:BoundValue(@marked)}}, Effect{result:@next, operation:Discard{players:@subject, amount:BoundValue(@marked), random:false}}] */
verbs_draw_discard_amount ::= "draws" card_count "," "then" "discards" "that" "many" "cards"

/* A final constant delayed draw is a closed paragraph. Keeping its independent
   native Spell frame cannot change an earlier target or receipt binding. The
   prefix retains its ordinary spell merging; no later paragraph can refer back
   into this independently bound tail. */
/* closed_cantrip_abilities is shared as closed_cantrip_more. */

closed_cantrip_tail ::= closed_cantrip_finish | closed_cantrip_more
/* @sem Ability::[...$line, ...$closed_cantrip_tail] */
closed_cantrip_more ::= line NEWLINE closed_cantrip_tail
/* @sem Ability::[@scope(Ability::Spell{announcement:Announcement{}, body:Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:UpkeepBegins, players:All}, start:NextTurn, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$fixed_slow_draw_count}}]}}}]}})] */
closed_cantrip_finish ::= "draw" fixed_slow_draw_count "at" "the" "beginning" "of" "the" "next" "turn's" "upkeep" "."
fixed_slow_draw_count ::= card_count_one | fixed_slow_draw_many
/* @sem $fixed_slow_draw_number */
fixed_slow_draw_many ::= fixed_slow_draw_number "cards"
fixed_slow_draw_number ::= number_words | number_digits

/* The shared body binds independently to each entering event subject. */
/* @sem Ability::[Triggered{event:ZoneChange{objects:@and($event_self, ObjectFilter::OwnedBy(One(AbilityController))), from:$greatest_card_zone, to:Battlefield}, limits:TriggerLimits{}, announcement:@announcement, body:$program}, Triggered{event:ZoneChange{objects:@and($event_another, ObjectFilter::OwnedBy(One(AbilityController))), from:$greatest_card_zone, to:Battlefield}, limits:TriggerLimits{}, announcement:@announcement, body:$program}] */
line_pair_enters_owned_origin ::= ("whenever" | "when") event_self "or" event_another "enters" "from" "your" greatest_card_zone "," program "."

/* @sem Ability::Triggered{event:$event_clause, intervening_if:$condition, limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}} */
triggered_if_modal ::= event_clause "," "if" condition "," mode_selection

/* A closed card with one ordinary activation owns this contextual player.
   Prefix instructions, other abilities, grants and variable prices stay outside. */
/* @sem Ability::[$activated_target_mill_where] */
contextual_single_mill_card ::= activated_target_mill_where

/* One immediate mill owns its contextual recipient. The published consumer
   expands Prior(That) into the same single-player row before reading the amount.
   A separately captured definition cannot use this contextual representation. */
/* @sem Ability::Activated{origin:Ordinary, cost:$single_mill_cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Mill{players:One($target_player), amount:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(PlayerRef::Prior(That))}, kind:Card, filter:Any})}}]}} */
activated_target_mill_where ::= single_mill_cost ":" target_player "mills" "X" "cards" "," "where" "X" "is" "the" "number" "of" "cards" "in" "that" "player's" "graveyard" "."

/* This bounded alternative has no variable or nonmana payment. */
single_mill_cost ::= single_mill_mana | single_mill_tap | single_mill_mana_tap
/* @sem Cost::@fixed_mana(Cost{parts:[Mana($mana_symbols)]}) */
single_mill_mana ::= mana_symbols
/* @sem Cost::Cost{parts:[TapSymbol]} */
single_mill_tap ::= "{T}"
/* @sem Cost::@fixed_mana(Cost{parts:[Mana($mana_symbols), TapSymbol]}) */
single_mill_mana_tap ::= mana_symbols "," "{T}"

/* Root-line composition only; quoted/granted programs keep existing scope. */
/* @sem Ability::[Triggered{event:Turn{point:EndStepBegins, players:One(AbilityController)}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$instructions_optional_self_return_keyword}}] */
line_optional_self_return_keyword ::= "at" "the" "beginning" "of" "your" "end" "step" "," instructions_optional_self_return_keyword "."

/* Eligibility is checked when the event triggers. Separate scoped abilities
   preserve the printed source's active zones; no intervening-if recheck. */
/* @sem Ability::[Triggered{event:Turn{point:UpkeepBegins, players:One(AbilityController)}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}, Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:Filtered{event:Turn{point:UpkeepBegins, players:One(AbilityController)}, condition:Controls{player:AbilityController, filter:$noun_atomic, minimum:1}}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})}] */
line_upkeep_graveyard_eligibility ::= "at" "the" "beginning" "of" "your" "upkeep" "," program_sentence "this" "ability" "triggers" "only" "if" self_text "is" "on" "the" "battlefield" "or" "if" self_text "is" "in" "your" "graveyard" "and" "you" "control" ("a" | "an") noun_atomic "."
/* @sem Ability::[@optional_ability_label(Scoped{zones:[Command], ability:@scope(Ability::Triggered{event:Turn{point:UpkeepBegins, players:One(AbilityController)}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})}, $paragraph_label), Triggered{event:Turn{point:UpkeepBegins, players:One(AbilityController)}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}] */
line_upkeep_command_eligibility ::= paragraph_label? "at" "the" "beginning" "of" "your" "upkeep" "," program_sentence "this" "ability" "triggers" "only" "if" self_text "is" "in" "the" "command" "zone" "or" "on" "the" "battlefield" "."

/* The written immediate entry callback belongs only to this preceding return. */
/* @sem Instruction::[Effect{result:@next, operation:$move_opponent_graveyard_their_control}, Effect{result:@next, operation:$opponent_graveyard_entry_callback}] */
instructions_opponent_graveyard_entry ::= move_opponent_graveyard_their_control "." opponent_graveyard_entry_callback
/* @sem Operation::@reflexive(Operation::ReflexiveTrigger{performed:@prior, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:@and($card_filter, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:ObjectProperty{object:Result{result:@reflexive_performed, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}) */
opponent_graveyard_entry_callback ::= "when" "that" "permanent" "enters" "," "return" "up" "to" "one" "target" card_filter "card" "with" "equal" "or" "lesser" "mana" "value" "from" "your" "graveyard" "to" "the" "battlefield"

/* Additive source views: the written header names the actor. The original
   event-subject routes remain. Reusing the lexical reference preserves a named
   creator as Granter inside granted abilities and this creature as its holder. */
/* @sem Ability::Triggered{event:AnyOf([Object{event:Attacks, objects:SameObject($self_explicit_ref)}, Object{event:Blocks, objects:SameObject($self_explicit_ref)}]), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($self_explicit_ref)), kind:$counter_kind, amount:Count(Exactly($payment_counter_amount))}]}]}, optional:false}}, If{condition:PaymentChosen(@marked), then:_{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:$recipients, amount:$number, preventable:true}}]}, otherwise:_{}}]}} */
own_source_hydra ::= ("when" | "whenever") self_explicit_ref "attacks" "or" "blocks" "," "remove" payment_counter_amount counter_kind ("counter" | "counters") "from" "it" "." "if" "you" "do" "," "it" "deals" number "damage" "to" recipients "."

/* The excluded creature is the header's entrant in both event alternatives. */
/* @sem Ability::Triggered{event:@either_event(EventSpec::ZoneChange{objects:SameObject($self_explicit_ref), to:Battlefield}, EventSpec::Object{event:TurnsFaceUp, objects:SameObject($self_explicit_ref)}), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($filter_phrase, ObjectFilter::Not(ObjectFilter::SameObject($self_explicit_ref)))}), index:0})), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot}}]}} */
own_source_efreet ::= ("when" | "whenever") self_explicit_ref "enters" "or" "is" "turned" "face" "up" "," "another" "target" filter_phrase "gets" signed "/" signed duration "."

/* `while` filters the event occurrence; it is not an intervening-if. */
/* @sem Ability::Triggered{event:Filtered{event:Object{event:BecomesTapped, objects:SameObject($self_explicit_ref)}, condition:ObjectMatches{object:$self_explicit_ref, filter:Counters{kind:$counter_kind, comparison:Greater, value:Constant(0)}}}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($self_explicit_ref)), kind:$counter_kind_2, amount:Count(Exactly($payment_counter_amount))}]}}]}} */
own_source_reejerey ::= ("when" | "whenever") self_explicit_ref "becomes" "tapped" "while" "it" "has" "a" counter_kind "counter" "on" "it" "," "remove" payment_counter_amount counter_kind ("counter" | "counters") "from" "it" "."

/* The explicitly named cast spell is the copied stack object. */
/* @sem Ability::Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:Spell{event:Cast, players:One(AbilityController), spells:SameObject($self_explicit_ref)}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$counter_amount, words:CreatingEffect, recipe:Copy{object:$self_explicit_ref, exceptions:[CopyException::RemoveSupertypes([Legendary])]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}})} */
own_source_osgood ::= "when" "you" "cast" self_explicit_ref "," "create" counter_amount ("token" "that's" "a" "copy" | "tokens" "that" "are" "copies") "of" "it" "," "except" ("it" "isn't" | "they" "aren't") "legendary" "."

/* The permission is created by this ability's holder. Its card operand follows
   the actual exile receipt, independently of the damage actor's reference. */
/* @sem Ability::Triggered{event:Damage{source_kind:Permanent, sources:SameObject($self_explicit_ref), recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}]}} */
own_source_flamespeaker ::= ("when" | "whenever") self_explicit_ref "deals" "combat" "damage" "to" "a" "player" "," "exile" "the" "top" "card" "of" "your" "library" "." "you" "may" "play" "it" this_duration "."

/* The named power test keeps its independent literal noun. The actor is the
   header referent; the event-relative exclusion and amount retain their roles. */
/* @sem Ability::Triggered{event:Damage{source_kind:Permanent, sources:SameObject($self_explicit_ref), recipients:Players(OpponentsOf(AbilityController)), kind:Combat, grouping:SourceRecipient, subject:Source}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[@resolution(Instruction::If{condition:ObjectMatches{object:$self_explicit_ref_2, filter:Property{property:Power, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}}, then:_{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Players(Intersection([OthersThan(EventSubject), OpponentsOf(AbilityController)])), amount:EventAmount, preventable:true}}]}, otherwise:_{}})]}} */
own_source_vincent ::= ("when" | "whenever") self_explicit_ref "deals" "combat" "damage" "to" "an" "opponent" "," "it" "deals" "that" "much" "damage" "to" "each" "other" "opponent" "if" self_explicit_ref "'s" "power" "is" value "or" "greater" "."

/* A stack-active self-cast route is owned by the card, not a named creator grant. */
/* @sem Ability::[$own_source_osgood] */
line_own_source_osgood ::= own_source_osgood

/* Native source views stay outside unresolved quoted source-role ambiguities. */
/* @sem Ability::[$own_source_flamespeaker] */
line_own_source_flamespeaker ::= own_source_flamespeaker
/* @sem Ability::[$own_source_vincent] */
line_own_source_vincent ::= own_source_vincent

/* The old named-creator quote exclusion needs its separate reviewed repair. */
/* @sem Ability::[$own_source_efreet] */
line_own_source_efreet ::= own_source_efreet

/* This root-owned card's optional exile has exactly one Move component. The
   cost acts on the graveyard incarnation, then damage uses its performed After.
   No arbitrary cost-index inference, lexical callback or quoted holder crossing. */
/* @sem Ability::[Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:ZoneChange{objects:AllOf([OwnedBy(One(AbilityController)), SameObject($self_explicit_ref)]), from:Library, to:Graveyard}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Move{selections:[_{objects:One(@current_it)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0}, recipients:Players(OpponentsOf(AbilityController)), amount:$number, preventable:true}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:$number_2}}]}, otherwise:Program{}}]}})}] */
line_live_library_exile ::= ("when" | "whenever") self_explicit_ref "is" "put" "into" "your" "graveyard" "from" "your" "library" "," "you" "may" "exile" "it" "." "if" "you" "do" "," self_named "deals" number "damage" "to" "each" "opponent" "and" "you" "gain" number "life" "."

/* Additive event-subject representations are restricted to root lines. Every
   arm of this header identifies exactly the written self object. */
/* @sem EventSpec::@either_event(EventSpec::ZoneChange{objects:SameObject($self_explicit_ref), to:Battlefield}, EventSpec::Object{event:Attacks, objects:SameObject($self_explicit_ref)}) */
own_exclusion_enters_attacks ::= self_explicit_ref "enters" "or" "attacks"

/* @sem Ability::[Triggered{event:$own_exclusion_enters_attacks, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Sacrifice{objects:Zone(_{scope:Shared(Battlefield), kind:Permanent, filter:@and($noun, ObjectFilter::Not(ObjectFilter::SameObject(EventSubject)))}), choose:Exactly(Constant(1))}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$counter_amount}}]}, otherwise:Program{}}]}}] */
line_own_exclusion_payment ::= ("when" | "whenever") own_exclusion_enters_attacks "," "you" "may" "sacrifice" "another" noun "." "if" "you" "do" "," "draw" counter_amount ("card" | "cards") "."

/* @sem Ability::[Triggered{event:$own_exclusion_enters_attacks, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone(_{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(AbilityController)), ObjectFilter::Not(ObjectFilter::SameObject(EventSubject)))})), changes:[Pump{power:$signed, toughness:$signed_2}, GrantKeyword($keyword_value)], duration:$duration, evaluation:Snapshot}}]}}] */
line_own_exclusion_pump ::= ("when" | "whenever") own_exclusion_enters_attacks "," "other" filter_plural "you" "control" "get" signed "/" signed "and" "gain" keyword_value duration "."

/* @sem Ability::[Triggered{event:Damage{source_kind:Any, sources:Any, recipients:Objects(SameObject($self_explicit_ref)), kind:Any, grouping:Recipient, subject:Recipient}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:Zone(_{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::ControlledBy(One(AbilityController)), ObjectFilter::Not(ObjectFilter::SameObject(EventSubject)), $filter_plural)}), changes:[Pump{power:$signed, toughness:$signed_2}]}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), changes:[Pump{power:$signed, toughness:$signed_2}]}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), changes:[Pump{power:$signed, toughness:$signed_2}]}}]}}] */
line_own_exclusion_perpetual ::= ("when" | "whenever") self_explicit_ref "is" "dealt" "damage" "," "other" filter_plural "you" "control" "and" filter_phrase "cards" "in" "your" "hand" "and" "library" "perpetually" "get" signed "/" signed "."

/* The specializing header supplies the literal holder. The one counter-removal
   action owns the receipt; callback targets and results have their own scope. */
/* @sem Ability::Triggered{event:Object{event:Specializes, objects:SameObject($self_explicit_ref)}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($self_explicit_ref)), kind:$counter_kind, amount:All}]}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref_2, recipients:$recipients, amount:CountersRemoved(@reflexive_performed), preventable:true}}]}})}]}} */
counter_removed_reflexive_trigger ::= ("when" | "whenever") self_explicit_ref "specializes" "," "remove" "all" counter_kind "counters" "from" "it" "." "when" "you" "do" "," self_explicit_ref "deals" "that" "much" "damage" "to" recipients "."

/* The callback observes the actual ModifyEvent result, not replacement creation
   or proposed damage. Its per-source power is the native affected-role read. */
/* @sem Instruction::[Effect{result:@next, operation:CreateReplacement{event:Damage{source_kind:Any, sources:ControlledBy(OpponentsOf(AbilityController)), recipients:Players(One(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Recipient}, limit:UntilExpired, duration:$this_duration, body:Program{instructions:[Effect{result:@mark, operation:ModifyEvent{change:PreventDamage}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, condition:AllOf(@unordered([Compare{left:CountObjects(Matching{objects:Damage(Source), filter:CardType(Creature)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, Compare{left:Performed(@reflexive_performed), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}])), announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamageFromEach{sources:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf(@unordered([CardType(Creature), ControlledBy(One(AbilityController)), State(Commander)]))}, recipients:Objects(One(Damage(Source))), amount:ObjectProperty{object:Affected, property:$stat, information:CurrentOrLastKnown}}}]}})}]}}}] */
instructions_commander_prevention_reflexive ::= "prevent" "all" "damage" "that" "would" "be" "dealt" "to" "you" this_duration "by" "sources" "your" "opponents" "control" "." "whenever" "damage" "from" "a" "creature" "is" "prevented" "this" "way" "," "each" "commander" "creature" "you" "control" "deals" "damage" "equal" "to" "its" stat "to" "that" "creature"

/* This whole attack batch is fixed by the triggering occurrence. Its original
   cardinality owns all three requested quantities, never completed draw work.
   Existing snapshot and EventAmount spellings remain independent alternatives. */
/* @sem Ability::Triggered{event:Batch{event:Attack{attackers:$filter_plural, by:One(AbilityController), defenders:Any}, per:Whole}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountObjects(EventGroup)}}, Effect{result:@next, operation:Discard{players:One(AbilityController), amount:CountObjects(EventGroup), random:false}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:CountObjects(EventGroup)}}]}} */
attack_group_requested_quantities ::= ("when" | "whenever") "you" "attack" "with" "one" "or" "more" filter_plural "," "draw" "that" "many" "cards" "," "then" "discard" "that" "many" "cards" "." "you" "gain" "that" "much" "life" "."

/* The random player belongs to this choice and its immediately written
   reflexive callback, whose targets are announced only when it triggers. */
/* @sem Instruction::[Effect{result:@mark, operation:ChooseAtRandom{kind:Player, options:[Players(All)]}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:$self_explicit_ref, second:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject($self_explicit_ref)), $noun, ObjectFilter::ControlledBy(One(PlayerRef::Chosen)))}), index:0}}}}]}})}] */
clause_random_player_fight ::= "choose" "a" "player" "at" "random" "." "when" "you" "do" "," self_explicit_ref "fights" "another" "target" noun "that" "player" "controls"

/* The whole activation keeps the chosen-player callback together when printing. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:$clause_random_player_fight}} */
activated_random_player_fight ::= cost ":" clause_random_player_fight "."

/* Damage may be unpreventable. Capture the proposed amount before changing
   the event; granted holder/controller and damaged player are separate roles. */
/* @sem Ability::Replacement{active:Battlefield, event:Damage{source_kind:Permanent, sources:SameObject(Source), recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Recipient}, body:Program{instructions:[Effect{result:@mark, operation:BindValue{value:EventAmount}}, Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, Effect{result:@next, operation:Draw{players:Union([One(AbilityController), One(PlayerRef::EventSubject)]), amount:Divide{numerator:BoundValue(@marked), denominator:Constant(2), rounding:Down}}}]}} */
replacement_holder_combat_half_draw ::= "if" "this" "creature" "would" "deal" "combat" "damage" "to" "a" "player" "," "prevent" "that" "damage" "." "this" "creature's" "controller" "and" "that" "player" "each" "draw" "half" "that" "many" "cards" "," "rounded" "down" "."

/* A hand-adjusted d20 table owns its first random-return row through the same
   typed clause used outside tables. Its row counts and other callbacks stay
   in the original producer order; the clause always owns exactly two effects. */
/* @sem Ability::Activated{origin:Ordinary, cost:_{parts:[Mana($mana_symbols), TapSymbol]}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::RollDie{sides:20}}}, If{condition:Compare{left:Subtract(DieResult(@last_result), CountObjects(Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}))), test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}, then:_{instructions:[Effect{result:@next, operation:Discard{players:One(AbilityController), amount:CountObjects(Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}))}}]}, otherwise:_{}}, If{condition:AllOf([Compare{left:Subtract(DieResult(@prior), CountObjects(Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}))), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, Compare{left:Subtract(DieResult(@prior), CountObjects(Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}))), test:NumberTest::Compare{comparison:LessOrEqual, value:$number_2}}]), then:Program{instructions:$clause_operation}, otherwise:_{}}, If{condition:AllOf([Compare{left:Subtract(DieResult(@back(4)), CountObjects(Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}))), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number_3}}, Compare{left:Subtract(DieResult(@back(4)), CountObjects(Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}))), test:NumberTest::Compare{comparison:LessOrEqual, value:$number_4}}]), then:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$number_5}}]}, otherwise:_{}}, If{condition:Compare{left:Subtract(DieResult(@back(5)), CountObjects(Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}))), test:NumberTest::Compare{comparison:Equal, value:$number_6}}, then:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:ObjectFilter::CardType(Creature)}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateTrigger{event:ZoneChange{objects:SameObject(Result{result:@prior, phase:After, index:0}), from:Battlefield, to:Graveyard}, duration:Indefinite, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Keyword{actor:One(OwnerOf(EventSubject)), action:KeywordAction::LoseGame}}]}, once:true}}]}, otherwise:_{}}]}} */
activated_hand_adjusted_die_table ::= mana_symbols "," "{" "T" "}" ":" "roll" "a" "d20" "and" "subtract" "the" "number" "of" "cards" "in" "your" "hand" "." "if" "the" "result" "is" number "or" "less" "," "discard" "your" "hand" "." NEWLINE "1" "―" number "|" clause_operation "." NEWLINE number "―" number "|" "draw" number "cards" "." NEWLINE number "|" "put" "a" "creature" "card" "from" "any" "graveyard" "onto" "the" "battlefield" "under" "your" "control" "." "when" "that" "creature" "dies" "," "its" "owner" "loses" "the" "game" "."

/* The infinity heading gives its holder this ability only while the holder is
   harnessed on the battlefield. */
/* @sem Ability::Conditional{condition:AllOf([ObjectMatches{object:Source, filter:State(Harnessed)}, ObjectMatches{object:Source, filter:InZone(Shared(Battlefield))}]), then:[Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}]} */
harnessed_turn_trigger ::= "∞" "—" "at" turn_event "," program_sentence

/* The same post-binding event-independence guard used for capped deaths owns
   the scalar entry alternative. Uncapped and event-reading entries stay batched. */
/* @sem Ability::@event_free_once(Ability::Triggered{event:$limited_entry_clause, limits:TriggerLimits{per_turn:1}, announcement:@announcement, body:$program_sentence}) */
triggered_once_entry ::= limited_entry_clause "," program_sentence "this" "ability" "triggers" "only" "once" "each" "turn" "."

/* Both body histories belong to this explicitly named attacking object. */
/* @sem EventSpec::Filtered{event:Object{event:Attacks, objects:SameObject($self_explicit_ref)}, condition:ObjectMatches{object:$self_explicit_ref, filter:State(Saddled)}} */
own_saddled_attack ::= self_explicit_ref "attacks" "while" "saddled"

/* This helper is private to the owned attack compositions, never an unqualified
   modifier for unrelated events or independent granted abilities. */
/* @sem ObjectFilter::@and($filter_phrase, ObjectFilter::Condition(Condition::Compare{left:EventHistory{event:Pair{event:Saddles, objects:SameObject(Candidate), others:SameObject(EventSubject)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})) */
own_attack_saddler ::= filter_phrase "that" "saddled" "it" "this" "turn"

/* @sem ObjectFilter::@and($filter_plural, ObjectFilter::Condition(Condition::Compare{left:EventHistory{event:Pair{event:Saddles, objects:SameObject(Candidate), others:SameObject(EventSubject)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})) */
own_attack_saddlers ::= filter_plural "that" "saddled" "it" "this" "turn"

/* @sem Ability::Triggered{event:$own_saddled_attack, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[RepeatableWithLimit{amount:Constant(2), body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::Supertype(Legendary)), $own_attack_saddler)}, count:AsManyAsCan(Constant(1))}}, Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Result{result:@prior, phase:After, index:0}, exceptions:[]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:Created(@marked)}}]}}}, Effect{result:@next, operation:RepeatProcess}]}}]}} */
own_saddled_copy ::= ("when" | "whenever") own_saddled_attack "," "choose" "a" "nonlegendary" own_attack_saddler "and" "create" "a" "tapped" "and" "attacking" "token" "that's" "a" "copy" "of" "it" "." "sacrifice" "that" "token" "at" "the" "beginning" "of" "the" "next" "end" "step" "." "repeat" "this" "process" "once" "."

/* @sem Ability::Triggered{event:Filtered{event:Object{event:Attacks, objects:SameObject($self_explicit_ref)}, condition:ObjectMatches{object:$self_explicit_ref, filter:State(Saddled)}}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($self_explicit_ref)), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot}}, Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$own_attack_saddlers}, count:AnyNumber}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}} */
own_saddled_return ::= ("when" | "whenever") self_explicit_ref "attacks" "while" "saddled" "," "it" "gets" signed "/" signed duration "." "then" "you" "may" "return" "any" "number" "of" own_attack_saddlers "to" "their" "owner's" "hand" "."

/* The source-addressed spelling is confined to an original root line; in a
   granted ability a printed name may denote Granter instead. */
/* @sem ObjectFilter::@and($filter_phrase, ObjectFilter::Condition(Condition::Compare{left:EventHistory{event:Pair{event:Saddles, objects:SameObject(Candidate), others:SameObject(Source)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})) */
own_source_attack_saddler ::= filter_phrase "that" "saddled" "it" "this" "turn"

/* @sem Ability::Triggered{event:$own_saddled_attack, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[RepeatableWithLimit{amount:Constant(2), body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::Supertype(Legendary)), $own_source_attack_saddler)}, count:AsManyAsCan(Constant(1))}}, Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Result{result:@prior, phase:After, index:0}, exceptions:[]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:Created(@marked)}}]}}}, Effect{result:@next, operation:RepeatProcess}]}}]}} */
source_saddled_copy ::= ("when" | "whenever") own_saddled_attack "," "choose" "a" "nonlegendary" own_source_attack_saddler "and" "create" "a" "tapped" "and" "attacking" "token" "that's" "a" "copy" "of" "it" "." "sacrifice" "that" "token" "at" "the" "beginning" "of" "the" "next" "end" "step" "." "repeat" "this" "process" "once" "."

/* @sem Ability::[$source_saddled_copy] */
line_saddled_source_copy ::= source_saddled_copy

/* This root permits one linked player-memory pair; ordinary prefix/suffix
   abilities do not recursively contain another pair. Both subject phrases are
   explicit source words in the outer card, never a granted-holder shortcut. */
player_memory_card ::= player_memory_pair | player_memory_before | player_memory_after | player_memory_surrounded
/* @sem Ability::[...$abilities, ...$player_memory_pair] */
player_memory_before ::= abilities NEWLINE player_memory_pair
/* @sem Ability::[...$player_memory_pair, ...$abilities] */
player_memory_after ::= player_memory_pair NEWLINE abilities
/* @sem Ability::[...$abilities, ...$player_memory_pair, ...$abilities_2] */
player_memory_surrounded ::= abilities NEWLINE player_memory_pair NEWLINE abilities

/* Capture the chosen player when the entry trigger resolves, before loss.
   The later gain is independent of both the loss amount and source control. */
/* @sem Ability::[@scope(Ability::Triggered{event:ZoneChange{objects:SameObject($self_explicit_ref), to:Battlefield}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Note(Player($player_memory_target))}, Effect{result:@next, operation:LoseLife{players:One($player_memory_target), amount:$number}}]}}), @scope(Ability::Triggered{event:Object{event:LeavesBattlefield, objects:SameObject($self_explicit_ref_2)}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:GainLife{players:One(Prior(Remembered)), amount:$number_2}}]}})] */
player_memory_pair ::= "when" self_explicit_ref "enters" "," player_memory_target "loses" number "life" "." NEWLINE "when" self_explicit_ref "leaves" "the" "battlefield" "," "that" "player" "gains" number "life" "."
player_memory_target ::= target_player | target_opponent

/* This event positively identifies the dying object's controller as this
   trigger's controller. The body uses the equivalent native event address. */
/* @sem Ability::Triggered{event:ZoneChange{objects:@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController))), from:Battlefield, to:Graveyard}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Sacrifice{players:OthersThan(ControllerOf(EventSubject)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$sacrifice_choice_filter}, choose:AsManyAsCan($counter_amount)}}]}} */
controlled_death_other_sacrifice ::= ("when" | "whenever") ("a" | "an") filter_phrase "you" "control" "dies" "," "each" "other" "player" "sacrifices" counter_amount sacrifice_choice_filter "of" "their" "choice" "."

/* Here the event's sacrificing player is explicitly you; the optional payment
   and each-other exclusion keep that same ability controller. */
/* @sem Ability::Triggered{event:Player{event:Sacrifices, players:One(AbilityController), objects:$filter_phrase}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Life($number)]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:Sacrifice{players:OthersThan(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$sacrifice_choice_filter}, choose:AsManyAsCan($counter_amount)}}]}, otherwise:Program{}}]}} */
own_sacrifice_paid_other_sacrifice ::= ("when" | "whenever") "you" "sacrifice" ("a" | "an") filter_phrase "," "you" "may" "pay" number "life" "." "if" "you" "do" "," "each" "other" "player" "sacrifices" counter_amount sacrifice_choice_filter "of" "their" "choice" "."

/* An imperative sacrifice is directed to the activation's controller. The
   previously targeted library player never becomes that imperative's actor. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[Mana($reveal_x_mana), TapSymbol]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:RevealUntil{library:$reveal_library_player, filter:CardType(Artifact), count:Constant(1), at_most:AnnouncedX}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:CardType(Artifact)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:CardType(Artifact)}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:One($self_explicit_ref)}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(3), phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]}} */
reveal_source_sacrifice ::= reveal_x_mana "," "{" "T" "}" ":" reveal_library_player "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "an" "artifact" "card" "or" "X" "cards" "are" "revealed" "," "whichever" "comes" "first" "." "if" "an" "artifact" "card" "is" "revealed" "this" "way" "," "put" "it" "onto" "the" "battlefield" "under" "your" "control" "and" "sacrifice" self_explicit_ref "." "put" "the" "rest" "of" "the" "revealed" "cards" "into" "that" "player's" "graveyard" "."
reveal_library_player ::= target_opponent | target_player
reveal_x_mana ::= reveal_x_only | reveal_x_prefix
/* @sem ManaSymbol::[$mana_x] */
reveal_x_only ::= mana_x
/* @sem ManaSymbol::[...$mana_symbols, $mana_x] */
reveal_x_prefix ::= mana_symbols mana_x

/* The discard reads only the immediately preceding random reveal; Then is ordered. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{condition:PlayerIsActive(AbilityController)}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:CardName, terms:_{count:Exactly(Constant(1)), options:[Term{family:CardsInOracle, form:AnyOracleCard}]}}}, Effect{result:@next, operation:InOrder([RevealFromHand{actor:One($chosen_player), cards:Any, count:$card_count, at_random:true}, DiscardObjects{objects:Matching{objects:Earlier{what:Revealed}, filter:Chosen(CardName)}}])}]}} */
ordered_named_reveal_discard ::= cost ":" "choose" "a" "card" "name" "." chosen_player "reveals" card_count "at" "random" "from" "their" "hand" "." "then" "that" "player" "discards" "all" "cards" "with" "that" "name" "revealed" "this" "way" "." "activate" "only" "during" "your" "turn" "."

/* These two sentences install independent delayed triggers at activation resolution.
   The lexical target is shared; the sacrifice names the holder or named creator. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{condition:Window(BeforeBlockersDeclared)}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Operation::@scope(Operation::CreateTrigger{event:Damage{source_kind:Permanent, sources:SameObject($reveal_target_creature), recipients:Objects(AllOf([CardType(Creature), Not(Subtype(Wall))])), kind:Combat, grouping:SourceRecipient, subject:Source}, duration:EndOfTurn, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One(Damage(Recipient)), regeneration:true}}]}})}, Effect{result:@next, operation:Operation::@scope(Operation::CreateTrigger{event:Object{event:LeavesBattlefield, objects:SameObject(ObjectRef::@it)}, duration:EndOfTurn, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:One($self_explicit_ref)}}]}})}]}} */
paired_combat_leave_delayed ::= cost ":" "whenever" reveal_target_creature "deals" "combat" "damage" "to" "a" "non-Wall" "creature" "this" "turn" "," "destroy" "that" "non-Wall" "creature" "." "when" "the" "targeted" "creature" "leaves" "the" "battlefield" "this" "turn" "," "sacrifice" self_explicit_ref "." "activate" "only" "before" "blockers" "are" "declared" "."

/* Target membership reuses the established Pair(Crews,Candidate,Vehicle)
   predicate. This owning attack/block header proves that EventSubject is the
   Vehicle before any target introduction; no current_it fallback is needed. */
/* @sem Ability::Triggered{event:$own_vehicle_combat_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One($own_vehicle_crewed_target), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}} */
own_vehicle_crewed_return ::= ("when" | "whenever") own_vehicle_combat_event "," "return" own_vehicle_crewed_target "to" "its" "owner's" "hand" "."

own_vehicle_combat_event ::= own_vehicle_attacks | own_vehicle_blocks | own_vehicle_attacks_blocks
/* @sem EventSpec::Object{event:Attacks, objects:SameObject($self_explicit_ref)} */
own_vehicle_attacks ::= self_explicit_ref "attacks"
/* @sem EventSpec::Object{event:Blocks, objects:SameObject($self_explicit_ref)} */
own_vehicle_blocks ::= self_explicit_ref "blocks"
/* @sem EventSpec::AnyOf([Object{event:Attacks, objects:SameObject($self_explicit_ref)}, Object{event:Blocks, objects:SameObject($self_explicit_ref)}]) */
own_vehicle_attacks_blocks ::= self_explicit_ref "attacks" "or" "blocks"

/* BF/current type is intentional for a legal return target. It must NOT be
   reused for a historical head count such as Luxurious Locomotive's amount. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:@and($filter_phrase, ObjectFilter::Condition(Condition::Compare{left:EventHistory{event:Pair{event:Crews, objects:SameObject(Candidate), others:SameObject(EventSubject)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}))}), index:0} */
own_vehicle_crewed_target ::= "up" "to" "one" "target" filter_phrase "that" "crewed" "it" "this" "turn"

/* The first-main header is owned only for this paid impulse paragraph; this
   does not introduce a broad event path for unrelated first-main abilities. */
/* @sem Ability::Triggered{event:Turn{point:FirstMainPhaseBegins, players:One(AbilityController)}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$instructions_paid_impulse_choice}} */
first_main_paid_impulse ::= "at" "the" "beginning" "of" "your" "first" "main" "phase" "," instructions_paid_impulse_choice "."

/* Equal amounts and type-disjoint object/player recipients admit this native
   simultaneous union form. The existing separate-parts reading remains. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Union([$recipients_objects, $recipients_you]), amount:Expr::@agree($number, $number_2), preventable:true}}] */
clause_equal_object_you_damage ::= object_ref "deals" number "damage" "to" recipients_objects "and" number "damage" "to" recipients_you

/* Keep the loop receipt when a later instruction observes it. The native
   canonicalizer merges an unobserved literal action with AddMana(All). */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:AddMana{players:One(Bound(0)), mana:$mana_bundle}}]}}] */
clause_each_player_fixed_mana ::= "each" "player" "adds" mana_bundle

/* A table head without an announced object cannot consume a written target. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RollDie{sides:20}} */
plain_roll_d20 ::= "roll" "a" "d20"

/* Ordinary spell paragraphs resolve in written order. Each paragraph closes its own conditional before the root program concatenation. Modes are not instructions. */
/* @sem Ability::[Spell{announcement:@announcement, body:Program{instructions:[...$instructions, ...$root_spell_paragraph_tail]}}] */
line_spell_paragraphs ::= instructions "." NEWLINE root_spell_paragraph_tail
/* A final quoted grant's own period closes its paragraph. */
/* @sem Ability::[Spell{announcement:@announcement, body:Program{instructions:[...$instructions_quoted, ...$root_spell_paragraph_tail]}}] */
line_spell_paragraphs_quoted ::= instructions_quoted NEWLINE root_spell_paragraph_tail
/* A where clause defines the X its paragraph used; later paragraphs follow. */
/* @sem Ability::[Spell{announcement:@announcement, body:@where(Program::Program{instructions:[...$instructions, ...$root_spell_paragraph_tail]}, $value)}] */
line_spell_paragraphs_where ::= instructions "," "where" "X" "is" value "." NEWLINE root_spell_paragraph_tail
root_spell_paragraph_tail ::= root_spell_paragraph_last | root_spell_paragraph_more
/* @sem Instruction::[...$instructions] */
root_spell_paragraph_last ::= instructions "."
/* @sem Instruction::[...$instructions, ...$root_spell_paragraph_tail] */
root_spell_paragraph_more ::= instructions "." NEWLINE root_spell_paragraph_tail

/* Both fixed mana operands are independent; the explicit linked-card condition
   replaces only the resolution action, without a new payment or player scope. */
/* @sem Instruction::[If{condition:Compare{left:CountObjects(Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:$mana_bundle_2}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:$mana_bundle}}]}}] */
clause_linked_mana_instead ::= "add" mana_bundle "." "if" "a" "card" "is" "exiled" "with" object_ref "," "add" mana_bundle "instead"

/* The complete permission span belongs to the temporary trigger body. */
/* @sem Instruction::[Effect{result:@next, operation:Operation::@scope(Operation::CreateTrigger{event:$event, duration:$duration, announcement:@announcement, body:Program{instructions:$instructions_exile_receipt_span}})}] */
temporary_trigger_exile_receipt ::= duration "," ("when" | "whenever") event "," instructions_exile_receipt_span

/* Counter placement, not current counters on the event's object, owns this receipt.
   These operations are private to counter-placement trigger headers. */
/* @sem EventSpec::Batch{event:Counters{change:Put, objects:$filter_phrase, by:OpponentsOf(AbilityController)}, per:Subject} */
counter_receipt_opponent_event ::= "an" "opponent" "puts" "one" "or" "more" "counters" "on" ("a" | "an") filter_phrase

/* "Another" contrasts with the holder; a named recipient can still be its creator. */
/* @sem EventSpec::Batch{event:Counters{change:Put, objects:@and(ObjectFilter::Not(ObjectFilter::SameObject(Source)), $filter_phrase), by:One(AbilityController)}, per:Subject} */
counter_receipt_self_event ::= "you" "put" "one" "or" "more" "counters" "on" "another" filter_phrase

/* @sem Operation::DuplicateCounters{from:CounterSource::EventPut, to:Objects(One($self_explicit_ref)), copies:All} */
counter_receipt_copy_to_self ::= "put" "the" "same" "number" "and" "kind" "of" "counters" "on" self_explicit_ref

/* @sem Ability::Triggered{event:$counter_receipt_opponent_event, limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$counter_receipt_copy_to_self}]}} */
triggered_counter_receipt_opponent ::= ("when" | "whenever") counter_receipt_opponent_event "," "they" counter_receipt_copy_to_self "."

/* This written if is an intervening condition; optional choice remains the holder's. */
/* @sem Ability::Triggered{event:$counter_receipt_self_event, intervening_if:$counter_receipt_not_subtype, limits:_{}, announcement:@announcement, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$counter_receipt_copy_to_self}]}}]}} */
triggered_counter_receipt_optional ::= ("when" | "whenever") counter_receipt_self_event "," "if" counter_receipt_not_subtype "," "you" "may" counter_receipt_copy_to_self "."

/* Only the positively counter-owned header supplies this event-subject condition. */
/* @sem Condition::ObjectMatches{object:EventSubject, filter:Not($subtype)} */
counter_receipt_not_subtype ::= "it's" "not" ("a" | "an") subtype

/* The copied stack object is introduced only by this complete delayed event.
   It is not an alias for bare Scoped objects or ordinary copy operations. */
/* @sem Instruction::[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:CreateDelayedTrigger{event:SpellOrActivation{players:One(AbilityController), spells:OnStack(XInCost), abilities:OnStack(XInCost)}, start:Immediately, expires:EndOfTurn, body:Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventStackObject, times:Constant(1), targets:May}}]}}}] */
instructions_next_x_stack_copy ::= operation "." "when" "you" "next" "cast" "a" "spell" "with" "{" "X" "}" "in" "its" "mana" "cost" "or" "activate" "an" "ability" "with" "{" "X" "}" "in" "its" "activation" "cost" "this" "turn" "," "copy" "that" "spell" "or" "ability" "." "you" "may" "choose" "new" "targets" "for" "the" "copy"

/* Written alternatives have separate spell and activation domains. This adds a
   native-shaped view without deleting the old combined-predicate view. */
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:SpellOrActivation{players:One(AbilityController), spells:AnyOf([@and(ObjectFilter::OnStack(Spell), ObjectFilter::CardType(Instant)), @and(ObjectFilter::OnStack(Spell), ObjectFilter::CardType(Sorcery))]), abilities:OnStack(Loyalty)}, start:Immediately, expires:EndOfTurn, body:Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventStackObject, times:$delayed_stack_copy_times, targets:May}}]}}}] */
instructions_next_typed_stack_copy ::= "when" "you" "next" "cast" "an" "instant" "spell" "," "cast" "a" "sorcery" "spell" "," "or" "activate" "a" "loyalty" "ability" "this" "turn" "," "copy" "that" "spell" "or" "ability" delayed_stack_copy_times "." "you" "may" "choose" "new" "targets" "for" "the" "copies"

delayed_stack_copy_times ::= revealed_stat_factor | discard_damage_times

/* Only an actual written damage producer owns the capped-damage receipt. */
clamped_damage_producer ::= deal_damage | deal_damage_equal | deal_damage_equal_first | deal_damage_that_much
/* @sem () */
clamped_damage_limit_words ::= "the" "player's" "life" "total" "before" "the" "damage" "was" "dealt" "," "the" "planeswalker's" "loyalty" "before" "the" "damage" "was" "dealt" "," "or" "the" "creature's" "toughness"

/* @sem Instruction::[Effect{result:@mark, operation:$clamped_damage_producer}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:ClampedDamage(@marked)}}] */
instructions_clamped_damage_life ::= clamped_damage_producer "." "you" "gain" "life" "equal" "to" "the" "damage" "dealt" "," "but" "not" "more" "life" "than" clamped_damage_limit_words

/* The written mana-color cap is additional to the recipient's pre-damage cap. */
/* @sem Instruction::[Effect{result:@mark, operation:$clamped_damage_producer}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:Minimum([ClampedDamage(@marked), ManaOf{mana:SpentOnX, filter:_{colors:[$mana_letter]}}])}}] */
instructions_clamped_damage_mana_life ::= clamped_damage_producer "." "you" "gain" "life" "equal" "to" "the" "damage" "dealt" "," "but" "not" "more" "than" "the" "amount" "of" "{" mana_letter "}" "spent" "on" "X" "," clamped_damage_limit_words

/* Each matching object is one occurrence; neither branch is a Whole batch.
   Bind each copied body/announcement independently, preserving library owner
   wildcard and the independently written dying-object filter. */
line_death_or_library_graveyard ::= line_death_or_library_graveyard_separate | line_death_or_library_graveyard_joined

/* Bind a context-dependent body independently for each matching origin. */
/* @sem Ability::[Triggered{event:ZoneChange{objects:$event_object, from:Battlefield, to:Graveyard}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}, Triggered{event:ZoneChange{objects:@and($card_filter, ObjectFilter::OwnedBy(All)), from:Library, to:Graveyard}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}] */
line_death_or_library_graveyard_separate ::= ("when" | "whenever") event_object "dies" "or" ("a" | "an") card_filter "card" "is" "put" "into" "a" "graveyard" "from" "a" "library" "," program_sentence

/* The native canonicalizer joins equal bodies. Only event-independent effects
   use this spelling companion; object/controller/owner receipts keep the
   separately bound route. The unordered event inverse retains written order. */
/* @sem Ability::[Triggered{event:@either_event(EventSpec::ZoneChange{objects:$event_object, from:Battlefield, to:Graveyard}, EventSpec::ZoneChange{objects:@and($card_filter, ObjectFilter::OwnedBy(All)), from:Library, to:Graveyard}), limits:TriggerLimits{}, announcement:@announcement, body:$death_library_independent_sentence}] */
line_death_or_library_graveyard_joined ::= ("when" | "whenever") event_object "dies" "or" ("a" | "an") card_filter "card" "is" "put" "into" "a" "graveyard" "from" "a" "library" "," death_library_independent_sentence

death_library_independent_sentence ::= death_library_opponent_drain | death_library_fresh_tap
/* @sem Program::Program{instructions:[Effect{result:@next, operation:LoseLife{players:OpponentsOf(AbilityController), amount:$number}}]} */
death_library_opponent_drain ::= "each" "opponent" "loses" number "life" "."
/* @sem Program::Program{instructions:[Effect{result:@next, operation:SetTapped{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:$noun_atomic}), index:0}), tapped:true}}]} */
death_library_fresh_tap ::= "tap" "target" noun_atomic "."

/* The complete written span owns one conjure receipt and one shared scalar
   counter quantity. It never borrows an arbitrary previous result or counter
   kind. The original object's counter information stays separate from the
   current card copied and the actual conjured population moved afterward. */
/* @sem @where(Program::Program{instructions:[Effect{result:@mark, operation:Conjure{actor:One(AbilityController), card:Duplicate(One($object_ref)), count:AnnouncedX, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:Transition{result:@marked, phase:After}, changes:[Pump{power:AnnouncedX, toughness:AnnouncedX}]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}, $conjured_counter_definition) */
program_conjured_counter_duplicates ::= "conjure" "X" "duplicates" "of" object_ref "into" "exile" "," "where" "X" "is" conjured_counter_definition "." "those" "duplicates" "perpetually" "get" "+" "X" "/" "+" "X" "." "then" "shuffle" "those" "duplicates" "into" "your" "library"

/* This production intentionally does not admit mutable collection counts. */
/* @sem Expr::CountCounters{recipients:Objects(One($conjured_counter_object)), kind:$counter_kind, information:CurrentOrLastKnown} */
conjured_counter_definition ::= "the" "number" "of" counter_kind ("counter" | "counters") "on" conjured_counter_object

/* @where freezes this literal pronoun at the definition site before placing
   it in the three Expr slots. Its inverse must retain that same marker. */
conjured_counter_object ::= conjured_counter_it | object_ref
/* @sem ObjectRef::@member_count_it(ObjectRef::@defined_it) */
conjured_counter_it ::= "it"

/* This ability owns the complete shared-X span, so the printer keeps it as a
   distinct choice instead of filling its beam with generic scalar spellings. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$program_conjured_counter_duplicates} */
triggered_conjured_counter_duplicates ::= event_clause "," program_conjured_counter_duplicates "."

/* A whole root line owns exactly-one-total triggering; this is neither a
   per-turn cap nor a new quoted/granted body composition. */
/* @sem Ability::[$named_conjure_total_once] */
line_named_conjure_total_once ::= named_conjure_total_once
named_conjure_total_once ::= named_conjure_once_event | named_conjure_once_event_if | named_conjure_once_turn | named_conjure_once_turn_if
named_conjure_once_action ::= conjure_named_hand | conjure_named_hand_third
/* @sem () */
named_conjure_once_suffix ::= "this" "ability" "triggers" "only" "once" "."
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{total:1}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$named_conjure_once_action}]}} */
named_conjure_once_event ::= event_clause "," named_conjure_once_action "." named_conjure_once_suffix
/* @sem Ability::Triggered{event:$event_clause, intervening_if:$condition, limits:TriggerLimits{total:1}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$named_conjure_once_action}]}} */
named_conjure_once_event_if ::= event_clause "," "if" condition "," named_conjure_once_action "." named_conjure_once_suffix
/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{total:1}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$named_conjure_once_action}]}} */
named_conjure_once_turn ::= "at" turn_event "," named_conjure_once_action "." named_conjure_once_suffix
/* @sem Ability::Triggered{event:$turn_event, intervening_if:$condition, limits:TriggerLimits{total:1}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$named_conjure_once_action}]}} */
named_conjure_once_turn_if ::= "at" turn_event "," "if" condition "," named_conjure_once_action "." named_conjure_once_suffix

/* A card from a hand/library is one physical object. The grant acts on its
   first still-present graveyard incarnation, not the departed event subject.
   The private quote owns a separate graveyard-card holder and creation actor. */
/* @sem Ability::Triggered{event:AnyOf(@unordered([ZoneChange{objects:@and($card_filter, ObjectFilter::OwnedBy(One(AbilityController))), from:Library, to:Graveyard}, ZoneChange{objects:@and($card_filter, ObjectFilter::OwnedBy(One(AbilityController))), from:Hand, to:Graveyard}])), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:One(@current_it), changes:[GrantAbility($perpetual_graveyard_token_quote)]}}]}} */
triggered_hidden_card_perpetual_graveyard_token ::= "whenever" ("a" | "an") card_filter "card" "is" "put" "into" "your" "graveyard" "from" "your" hidden_card_two_origins "," "it" "perpetually" "gains" perpetual_graveyard_token_quote
/* @sem () */
hidden_card_two_origins ::= "library" "or" "hand" | "hand" "or" "library"

/* Only the printed holder spelling is admitted here. This is not a generic
   grant/callback program bridge or a named-creator event rewrite. */
/* @sem Ability::@holder($perpetual_graveyard_token_ability) */
perpetual_graveyard_token_quote ::= '"' perpetual_graveyard_token_ability '"'
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:Object{event:LeavesGraveyard, objects:SameObject(Source)}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$token_defined_tapped], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}}]}})} */
perpetual_graveyard_token_ability ::= "when" "this" "card" "leaves" "your" "graveyard" "," "create" token_defined_tapped "."

/* A returned card's requested mana-value quantity belongs to the announced
   graveyard card. Copy its parsed target operand into both exclusive branches;
   do not infer a source-card antecedent or read an unchosen gain-life receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:ObjectProperty{object:$target_card, property:ManaValue, information:CurrentOrLastKnown}}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:ObjectProperty{object:$target_card, property:ManaValue, information:CurrentOrLastKnown}}}]}}] */
instructions_return_card_shared_life ::= "return" target_card "to" "the" "battlefield" "." "if" condition "," "you" "gain" "life" "equal" "to" "that" "card's" "mana" "value" "." "otherwise" "," "you" "lose" "that" "much" "life"

/* The complete written producer owns the actual manifest-dread arrivals.
   This receipt is not the selected/input population of an unrelated action. */
/* @sem Instruction::[Effect{result:@mark, operation:Keyword{actor:One(AbilityController), action:KeywordAction::ManifestDread{times:$number}}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Transition{result:@marked, phase:After}), kind:$counter_kind, amount:$number_2}]}}] */
instructions_manifest_dread_counters ::= "manifest" "dread" number "times" "," "then" "put" number counter_kind "counters" "on" "each" "of" "those" "creatures"

/* An immediate action body excludes leading intervening-if, modes and shared
   trigger limits. Bind its two disjoint event arms independently; keep the
   original Either reading through event_own_or_other_faceup. */
/* @sem Ability::[@scope(Ability::Triggered{event:Object{event:TurnsFaceUp, objects:$event_self}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$faceup_split_body}}), @scope(Ability::Triggered{event:Object{event:TurnsFaceUp, objects:@and(ObjectFilter::Not($event_self), $filter_phrase)}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$faceup_split_body}})] */
line_own_or_other_faceup ::= ("when" | "whenever") event_self "or" "another" filter_phrase "is" "turned" "face" "up" "," faceup_split_body "."

faceup_split_body ::= clause_operation | clause_imperative | clause_you | clause_third

/* This whole written span owns the revealed card's value receipt. The Move
   keeps the native top-card selector; only the later information read uses
   the observed card, never the next top card after that Move. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:ObjectProperty{object:Query{objects:Observed(@marked), index:0}, property:ManaValue, information:CurrentOrLastKnown}}}] */
/* @prefer always */
instructions_reveal_top_hand_life_loss ::= "reveal" "the" "top" "card" "of" "your" "library" "and" "put" "that" "card" "into" "your" "hand" "." "you" "lose" "life" "equal" "to" ("its" | "that" "card's") "mana" "value"

/* A card-in-hand event operand is explicitly owned by this hidden-card
   header, matching published Trigger_ThatCardInHand lowering. This does not
   widen the generic public EventDestination or pronoun transition policy. */
/* @sem Ability::[$library_hand_perpetual_colors_ability] */
line_library_hand_perpetual_colors ::= library_hand_perpetual_colors_ability
/* @sem Ability::[WithPresentation{label:$ability_label, reminder:false, ability:$library_hand_perpetual_colors_ability}] */
line_library_hand_perpetual_colors_labelled ::= ability_label "—" library_hand_perpetual_colors_ability

/* @sem Ability::Triggered{event:ZoneChange{objects:@and($card_filter, ObjectFilter::OwnedBy(PlayerSet::One(PlayerRef::AbilityController))), from:Library, to:Hand}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:One(EventSubject), changes:[Pump{power:$value_colors_among, toughness:Constant(0)}]}}]}} */
library_hand_perpetual_colors_ability ::= ("when" | "whenever") ("a" | "an") card_filter "card" "is" "put" "into" "your" "hand" "from" "your" "library" "," "it" "perpetually" "gets" "+" "X" "/" "+" "0" "," "where" "X" "is" value_colors_among "."

/* Shared omitted-self headers describe two separately owned triggers. The
   bodies here contain no event-relative object/player/amount, target or choice;
   their identical words therefore retain independent announcement scopes. */
/* @sem Ability::[Triggered{event:EventSpec::Object{event:Attacks, objects:$event_self}, limits:TriggerLimits{}, announcement:@announcement, body:$self_target_independent_sentence}, Triggered{event:EventSpec::BecomesTarget{objects:$event_self, kind:Spell, by:Filter($spell_filter)}, limits:TriggerLimits{}, announcement:@announcement, body:$self_target_independent_sentence}] */
line_self_attack_or_target ::= ("when" | "whenever") event_self "attacks" "or" "becomes" "the" "target" "of" spell_filter "," self_target_independent_sentence

/* @sem Ability::[Triggered{event:EventSpec::ZoneChange{objects:$event_self, to:Battlefield}, limits:TriggerLimits{}, announcement:@announcement, body:$self_target_independent_sentence}, Triggered{event:EventSpec::BecomesTarget{objects:$event_self, kind:SpellOrAbility, by:Term{family:SpellsAndAbilities, form:ControlledByAPlayer, operands:[Players(OpponentsOf(AbilityController))]}}, limits:TriggerLimits{}, announcement:@announcement, body:$self_target_independent_sentence}] */
line_self_entry_or_target_opponent ::= ("when" | "whenever") event_self "enters" "or" "becomes" "the" "target" "of" "a" "spell" "or" "ability" "an" "opponent" "controls" "," self_target_independent_sentence

self_target_independent_sentence ::= self_target_named_tokens | self_target_gain_life
/* @sem Program::Program{instructions:[Instruction::Effect{result:@next, operation:Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec::TokenSpec{amount:$self_target_count, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
self_target_named_tokens ::= "create" self_target_count token_named_recipe ("token" | "tokens") "."
/* @sem Program::Program{instructions:[Instruction::Effect{result:@next, operation:Operation::GainLife{players:One(AbilityController), amount:$number}}]} */
self_target_gain_life ::= "you" "gain" number "life" "."

/* This body count cannot depend on either event's amount or object. */
self_target_count ::= counter_a | number

/* Native canonicalization coalesces these two independent identical-body
   triggers. These companions print precisely that canonical representation;
   their unchanged bounded bodies cannot depend on which event arm fired. */
/* @sem Ability::[Triggered{event:EventSpec::@either_event(EventSpec::Object{event:Attacks, objects:$event_self}, EventSpec::BecomesTarget{objects:$event_self, kind:Spell, by:Filter($spell_filter)}), limits:TriggerLimits{}, announcement:@announcement, body:$self_target_independent_sentence}] */
line_self_attack_or_target_joined ::= ("when" | "whenever") event_self "attacks" "or" "becomes" "the" "target" "of" spell_filter "," self_target_independent_sentence

/* @sem Ability::[Triggered{event:EventSpec::@either_event(EventSpec::ZoneChange{objects:$event_self, to:Battlefield}, EventSpec::BecomesTarget{objects:$event_self, kind:SpellOrAbility, by:Term{family:SpellsAndAbilities, form:ControlledByAPlayer, operands:[Players(OpponentsOf(AbilityController))]}}), limits:TriggerLimits{}, announcement:@announcement, body:$self_target_independent_sentence}] */
line_self_entry_or_target_opponent_joined ::= ("when" | "whenever") event_self "enters" "or" "becomes" "the" "target" "of" "a" "spell" "or" "ability" "an" "opponent" "controls" "," self_target_independent_sentence

/* The event supplies only the kinds actually placed, including a counter kind
   no longer present when the trigger resolves. This body is private to the
   complete counter-placement header. */
/* @sem EventSpec::Batch{event:Counters{change:Put, objects:SameObject($self_explicit_ref), by:One(AbilityController)}, per:Subject} */
counter_receipt_named_event ::= "you" "put" "one" "or" "more" "counters" "on" self_explicit_ref
/* @sem Operation::DuplicateCounters{from:CounterSource::EventPut, to:Objects(One($counter_receipt_other_target)), copies:OneOfEachKind} */
counter_receipt_one_each ::= "put" "one" "of" "each" "of" "those" "kinds" "of" "counters" "on" counter_receipt_other_target
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:@and(ObjectFilter::Not(SameObject(EventSubject)), $filter_phrase)}), index:0} */
counter_receipt_other_target ::= "up" "to" "one" "other" "target" filter_phrase
/* @sem Ability::Triggered{event:$counter_receipt_named_event, limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$counter_receipt_one_each}]}} */
triggered_counter_receipt_kinds ::= ("when" | "whenever") counter_receipt_named_event "," counter_receipt_one_each "."

/* Attack-player events name the attacked player as their player subject when
   no attacking-player field is present. "Other" excludes that defender. */
/* @sem Ability::Triggered{event:$attack_copies_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$attack_other_optional_copies}} */
triggered_attack_other_optional_copies ::= attack_copies_event "," attack_other_optional_copies "."
/* @sem EventSpec::Attack{attackers:$event_object, defenders:Players(All)} */
attack_copies_event ::= ("when" | "whenever") event_object "attacks" "a" "player"
/* @sem Instruction::[ForEachPlayer{players:Intersection([OthersThan(EventSubject), OpponentsOf(AbilityController)]), binding:0, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$attack_copy_count, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:[]}}], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{player:Bound(0)}]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Created(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}]}}]}}] */
attack_other_optional_copies ::= "for" "each" "other" "opponent" "," "you" "may" "create" attack_copy_count object_ref "," "tapped" "and" "attacking" "that" "opponent" "." "exile" "those" "tokens" "at" "the" "beginning" "of" "the" "next" "end" "step"

attack_copy_count ::= attack_copy_single | attack_copy_plural
/* @sem $counter_a */
attack_copy_single ::= counter_a "token" "that's" "a" "copy" "of"
/* @sem $number */
attack_copy_plural ::= number "tokens" "that" "are" "copies" "of"

/* A condition can replace the random choice with your own: the selection holds
   two nested choices over the same modes, each requiring its side of the condition. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Expr::Constant(1), maximum:Expr::Constant(1)}, options:[Mode::Mode{announcement:Announcement{modes:ModeSelection{count:ModeCount{minimum:$number_words_2, maximum:$number_words_2}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}}}, body:Program{}, weight:1, requires:$condition}, Mode::Mode{announcement:Announcement{modes:ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:Random}}}, body:Program{}, weight:1, requires:Condition::Not($condition)}], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied} */
choose_random_unless ::= "choose" number_words "at" "random" "." "if" condition "," "you" "choose" number_words "instead" "." NEWLINE modes

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:Random}} */
choose_number_random ::= "choose" number_words "at" "random" "—" NEWLINE modes

/* A serial action list has at least three immediate action clauses. Its
   components cannot consume a multi-sentence conditional or payment program;
   the final conjunction remains inside the current program or condition. */
serial_action_clause ::= clause_operation | clause_imperative | clause_you | clause_you_life | clause_third | clause_you_and_target | clause_they
/* @sem Instruction::[...$serial_action_clause, ...$serial_action_tail] */
conjoined_serial ::= serial_action_clause "," serial_action_tail
/* @sem Instruction::[...$serial_controller_clause, ...$serial_survey_keyword_then] */
serial_controller_survey_keyword ::= serial_controller_clause "," serial_survey_keyword_then
serial_controller_clause ::= clause_you | clause_you_life | clause_imperative
serial_action_tail ::= serial_action_last | serial_action_last_then | serial_token_then | conjoined_serial | serial_choice_then
/* @sem Instruction::[...$serial_action_clause, ...$conjoined] */
serial_action_last ::= serial_action_clause "," "and" conjoined

/* The declared attacker remains the singular actor after a proved multiple
   token creation. No unrelated event or single-token reference is rebound. */
own_attack_factory_damage ::= own_attack_factory_damage_defined | own_attack_factory_damage_fixed
/* @sem Ability::Triggered{event:Object{event:Attacks, objects:SameObject($self_explicit_ref)}, limits:TriggerLimits{}, announcement:@announcement, body:@where(Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$attack_factory_tokens], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:$recipients, amount:AnnouncedX, preventable:true}}]}, $value)} */
own_attack_factory_damage_defined ::= ("when" | "whenever") self_explicit_ref "attacks" "," "create" attack_factory_tokens "," "then" "it" "deals" "X" "damage" "to" recipients "," "where" "X" "is" value "."
/* @sem Ability::Triggered{event:Object{event:Attacks, objects:SameObject($self_explicit_ref)}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$attack_factory_tokens], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:$recipients, amount:$number, preventable:true}}]}} */
own_attack_factory_damage_fixed ::= ("when" | "whenever") self_explicit_ref "attacks" "," "create" attack_factory_tokens "," "then" "it" "deals" number "damage" "to" recipients "."

/* @sem TokenSpec::TokenSpec{amount:$attack_factory_amount, words:CreatingEffect, recipe:$token_recipe} */
attack_factory_tokens ::= attack_factory_amount token_recipe
/* @sem Expr::@plural_amount($number) */
attack_factory_amount ::= number

/* The event-free capped form can combine the disjoint source/other-object
   matchers. Event-reading bodies retain the ordinary Either-event reading. */
/* @sem Ability::@event_free_once(Ability::Triggered{event:ZoneChange{objects:AnyOf(@unordered([$event_self, @and(ObjectFilter::Not($event_self), $filter_phrase)])), from:Battlefield, to:Graveyard}, limits:TriggerLimits{per_turn:1}, announcement:@announcement, body:$program_sentence}) */
triggered_self_or_death_union_once ::= ("when" | "whenever") event_self "or" "another" filter_phrase "dies" "," program_sentence "this" "ability" "triggers" "only" "once" "each" "turn" "."

/* This header proves that the explicitly named object is the attacker of the
   block pair. A blocker trigger cannot use this pronoun reading. */
/* @sem Ability::Triggered{event:Pair{event:BecomesBlockedBy, objects:SameObject($self_explicit_ref), others:$filter_phrase}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:BlockPair(Attacker), recipients:Objects(One(BlockPair(Blocker))), amount:$number, preventable:true}}]}} */
blocked_pair_attacker_damage ::= ("when" | "whenever") self_explicit_ref "becomes" "blocked" "by" ("a" | "an") filter_phrase "," "it" "deals" number "damage" "to" "that" "creature" "."

/* This is a casting restriction on this spell, not a player-wide inability
   to produce mana or pay costs for other spells and abilities. */
/* @sem Ability::Casting(RestrictMana{portion:All, filter:None}) */
casting_no_mana ::= "you" "can't" "spend" "mana" "to" "cast" "this" "spell" "."

/* The one printed cost supplies both activation locations of this mechanic. */
/* @sem Ability::[Mechanic{mechanic:Specialize, cost:$cost}, Mechanic{mechanic:SpecializeFromGraveyard, cost:$cost}] */
line_graveyard_specialize ::= "specialize" cost "." "you" "may" "also" "activate" "this" "ability" "if" scoped_source_card "is" "in" "your" "graveyard" "."

/* The self event proves the pronoun's source independently of its opponent
   target and the expression in the where-clause. */
/* @sem Ability::Triggered{event:@either_event(EventSpec::Object{event:TurnsFaceUp, objects:SameObject($self_explicit_ref)}, EventSpec::ZoneChange{objects:SameObject($self_explicit_ref), to:Battlefield}), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Players(One($target_opponent)), amount:$value, preventable:true}}]}} */
triggered_self_entry_faceup_damage ::= ("when" | "whenever") self_explicit_ref "enters" "or" "is" "turned" "face" "up" "," "it" "deals" "X" "damage" "to" target_opponent "," "where" "X" "is" value "."

/* The four named bend actions establish what all four means. The check is
   after the draw at resolution, and the transform operand retains its scope. */
/* @sem Ability::Triggered{event:$event_bends_all_kinds, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}, If{condition:PlayerDid{player:AbilityController, event:BentAllFour, window:ThisTurn}, then:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:Transform{object:$self_explicit_ref}}}]}, otherwise:Program{}}]}} */
triggered_bends_four_transform ::= "whenever" event_bends_all_kinds "," "draw" card_count "." "then" "if" "you've" "done" "all" "four" "this" "turn" "," "transform" self_explicit_ref "."

/* These statements have explicit native subjects; no implicit imperative
   player needs to be supplied or recovered during inverse printing. */
/* @sem Instruction::[Effect{result:@next, operation:$creatures_skip_target_next_untap}] */
clause_skip_target_next_untap ::= creatures_skip_target_next_untap
clause_next_spell_flash ::= clause_next_spell_flash_plain | next_flash_creature_clause

/* The sacrifice condition introduces a historical count, not an amount from
   the turn-boundary event. The same count is read again when damage resolves. */
/* @sem Ability::Triggered{event:$history_damage_event, intervening_if:Compare{left:$sacrifice_history_one_or_more, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:$recipients, amount:$sacrifice_history_one_or_more, preventable:true}}]}} */
triggered_sacrifice_history_damage ::= history_damage_event "," "if" sacrifice_history_one_or_more "," self_explicit_ref "deals" "that" "much" "damage" "to" recipients "."

history_damage_event ::= event_clause | graveyard_local_turn

/* Chaos does not introduce a player subject. Here the other players are other
   than the ability's controller, and each chooses their own sacrifice. */
/* @sem Ability::Triggered{event:Player{event:ChaosEnsues, players:All}, limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Sacrifice{players:OthersThan(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan($counter_amount)}}]}} */
triggered_chaos_other_sacrifice ::= "whenever" "chaos" "ensues" "," "each" "other" "player" "sacrifices" counter_amount filter_phrase "of" "their" "choice" "."

/* A future trigger or paid callback still owns the remainder of its sentence
   when it is nested inside another callback. The enclosing period is shared. */
nested_closed_callback ::= clause_delayed_chosen_combat_event | temporary_trigger_prefix | temporary_trigger_prefix_if | temporary_trigger_this_turn | temporary_trigger_this_turn_if | clause_if_you_do

/* An explicit second offer is independent of the first, even after `have`. */
/* @sem Vec<Instruction>::@and_sequence($clause_may, $independent_may_tail) */
clause_independent_may_choices ::= clause_may "," "and" independent_may_tail
independent_may_tail ::= clause_may | clause_independent_may_choices

/* A trigger whose instructions are optional together. */
/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:_{instructions:[Optional{decider:AbilityController, body:@optional_action_program($program)}]}} */
triggered_optional_program ::= event_clause "," "you" "may" program "."

/* At the beginning of your first main phase. */
/* @sem Ability::Triggered{event:Turn{point:FirstMainPhaseBegins, players:One(AbilityController)}, limits:_{}, announcement:@announcement, body:$program} */
triggered_first_main_phase ::= "at" "the" "beginning" "of" "your" "first" "main" "phase" "," program "."

/* At the beginning of each end step. */
/* @sem Ability::Triggered{event:Turn{point:EndStepBegins, players:All}, limits:_{}, announcement:@announcement, body:$program} */
triggered_each_end_step ::= "at" "the" "beginning" "of" "the" "end" "step" "," program "."

/* An exhaust ability, activated once. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:_{once:true, keyword:Exhaust}, announcement:@announcement, body:$program} */
activated_exhaust ::= "exhaust" "—" cost ":" program "."
/* @sem Ability::WithPresentation{reminder:true, ability:$activated_exhaust} */
activated_exhaust_reminded ::= activated_exhaust "(" "activate" "each" "exhaust" "ability" "only" "once" "." ")"

/* An activated ability with the untap symbol. */
/* @sem Ability::Activated{origin:Ordinary, cost:_{parts:[Mana($mana_symbols), ChangeTapState{selections:[_{objects:One(Source)}], symbol:true}]}, limits:_{}, announcement:@announcement, body:$program} */
activated_untap_symbol ::= mana_symbols "," "{" "Q" "}" ":" program "."

/* Returning this card from your graveyard to your hand. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Move{objects:$affected, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}})} */
activated_graveyard_to_hand ::= cost ":" "return" affected "from" "your" "graveyard" "to" "your" "hand" "."

/* Returning this card from your graveyard to the battlefield tapped. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Move{objects:$affected, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}]}})} */
activated_graveyard_to_battlefield_tapped ::= cost ":" "return" affected "from" "your" "graveyard" "to" "the" "battlefield" "tapped" "."

/* A trigger whose effect returns this card from your graveyard works there:
   plainly, as your choice, or after an optional payment. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$graveyard_self_program})} */
triggered_graveyard_self ::= event_clause "," graveyard_self_program
graveyard_self_program ::= graveyard_self_return_attach | graveyard_self_paid_changed | graveyard_self_plain | graveyard_self_may | graveyard_self_paid
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$self_graveyard_return}]} */
graveyard_self_plain ::= self_graveyard_return "."
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$self_graveyard_return}]}}]} */
graveyard_self_may ::= "you" "may" self_graveyard_return "."
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:$self_graveyard_return}]}, otherwise:Program{}}]} */
graveyard_self_paid ::= "you" "may" payment "." "if" "you" "do" "," self_graveyard_return "."

/* A graveyard trigger returning this card to your hand. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:Move{objects:$affected, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]}})} */
triggered_graveyard_to_hand ::= event_clause "," "you" "may" "return" affected "from" "your" "graveyard" "to" "your" "hand" "."

/* Beginning the game with this card on the battlefield. */
/* @sem Ability::OpeningHand{announcement:@announcement, body:_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:BeginOnBattlefield{actor:One(AbilityController), flags:List([Term{family:EnterFlag, form:EntersNormally}])}}]}}]}} */
opening_hand_begin_on_battlefield ::= "if" "this" "card" "is" "in" "your" "opening" "hand" "," "you" "may" "begin" "the" "game" "with" "it" "on" "the" "battlefield" "."

/* A Chancellor: revealing it from the opening hand sets up one trigger at the
   first upkeep or main phase, written before or after its instructions. */
/* @sem Ability::OpeningHand{announcement:@announcement, body:_{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:Reveal{objects:One(Source)}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:_{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:$first_turn_point, start:Immediately, body:_{instructions:$instructions}}}]}, otherwise:_{}}]}} */
opening_hand_reveal_first_turn ::= "you" "may" "reveal" "this" "card" "from" "your" "opening" "hand" "." "if" "you" "do" "," "at" first_turn_point "," instructions "."
/* @sem Ability::OpeningHand{announcement:@announcement, body:_{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:Reveal{objects:One(Source)}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:_{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:$first_turn_point, start:Immediately, body:_{instructions:$instructions}}}]}, otherwise:_{}}]}} */
opening_hand_reveal_first_turn_after ::= "you" "may" "reveal" "this" "card" "from" "your" "opening" "hand" "." "if" "you" "do" "," instructions "at" first_turn_point "."
first_turn_point ::= first_upkeep | your_first_upkeep | your_first_main_phase
/* @sem EventSpec::Turn{point:UpkeepBegins, players:All} */
first_upkeep ::= "the" "beginning" "of" "the" "first" "upkeep"
/* @sem EventSpec::Turn{point:UpkeepBegins, players:One(PlayerRef::AbilityController)} */
your_first_upkeep ::= "the" "beginning" "of" "your" "first" "upkeep"
/* @sem EventSpec::Turn{point:FirstMainPhaseBegins, players:One(PlayerRef::AbilityController)} */
your_first_main_phase ::= "the" "beginning" "of" "your" "first" "main" "phase" "of" "the" "game"

/* Casting restrictions taken over from seeded rules, in their original Oracle words. */
/* @sem Ability::Casting(Require($condition)) */
casting_only_if ::= "cast" "this" "spell" "only" "if" condition "."

/* The announcement and its following grant share one target group. Matching
   the repeated noun refuses an unrelated group rather than changing its kind. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:$plural_target_count_any, filter:@agree($plural, $plural_2)}))), changes:$grants, duration:$duration, evaluation:Snapshot}}] */
instructions_choose_group_grants ::= "choose" plural_target_count_any "target" plural "." "each" "of" "those" plural "gains" grants duration

/* A put or double sentence applies to the same explicitly announced group. */
/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($objects_targets_plain), kind:$counter_kind, amount:$counter_a}]}}] */
instructions_choose_group_counter ::= "choose" objects_targets_plain "." "put" counter_a counter_kind "counter" "on" "each" "of" "them"
/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($objects_targets_plain), kind:$counter_kind, amount:Expr::@plural_amount($counter_amount)}]}}] */
instructions_choose_group_counters ::= "choose" objects_targets_plain "." "put" counter_amount counter_kind "counters" "on" "each" "of" "them"
/* @sem Instruction::[Effect{result:@next, operation:DoubleCounters{objects:$objects_targets_plain, kind:$counter_kind}}] */
instructions_choose_group_double ::= "choose" objects_targets_plain "." "double" "the" "number" "of" counter_kind "counters" "on" "each" "of" "them"

/* This optional action owns its complete fight body. Its inverse can place
   the announced target inside the same words without inventing a prompt. */
/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:$have_creatures_fight}]}}] */
clause_may_have_fight ::= "you" "may" have_creatures_fight

/* Two separately created named cards share the printed destination. */
/* @sem Instruction::[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Named($referenced_card_name), count:$card_count, destination:$conjure_pair_destination}}, Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Named($referenced_card_name_2), count:$card_count_2, destination:$conjure_pair_destination}}] */
instructions_conjure_named_pair ::= "conjure" card_count "named" referenced_card_name "and" card_count "named" referenced_card_name conjure_pair_destination

/* Ordered restrictions apply to the same activation. */
/* @sem ActivationLimits::ActivationLimits{sorcery:true, condition:$activation_sorcery_condition} */
limit_condition_sorcery ::= "activate" "only" "if" activation_sorcery_condition "and" "only" "as" "a" "sorcery"

/* @sem ActivationLimits::ActivationLimits{condition:AllOf([PlayerState{player:AbilityController, state:InTheirUpkeep}, $condition])} */
limit_upkeep_condition ::= "activate" "only" "during" "your" "upkeep" "and" "only" "if" condition

/* The returned self card establishes the active zone of the turn trigger. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$turn_event, intervening_if:$condition, limits:_{}, announcement:@announcement, body:$graveyard_turn_self_program})} */
triggered_turn_if_self_graveyard ::= "at" turn_event "," "if" condition "," graveyard_turn_self_program

/* Quoted terminal punctuation closes the ability without an additional period. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$perpetual_quote_program} */
triggered_perpetual_quote_program ::= event_clause "," perpetual_quote_program

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$random_library_perpetual}]} */
perpetual_quote_random_program ::= random_library_perpetual

/* @sem Program::Program{instructions:$instructions_conjure_perpetual} */
perpetual_quote_conjure_program ::= instructions_conjure_perpetual

perpetual_quote_program ::= perpetual_event_graveyard_activation_program | perpetual_quote_hand_reveal_program | perpetual_quote_random_program | perpetual_quote_conjure_program | perpetual_quote_duplicate_program | perpetual_quote_hand_union_program | perpetual_quote_optional_hand_program | perpetual_quote_random_duplicate_program | perpetual_quote_hand_value_program | perpetual_quote_filtered_hand_program | perpetual_quote_owned_x_program

/* @sem ActivationLimits::ActivationLimits{condition:AllOf([PlayerIsActive(AbilityController), $condition])} */
limit_your_turn_and_condition ::= "activate" "only" "during" "your" "turn" "and" "only" "if" condition

/* @sem Program::Program{instructions:$instructions_duplicate_perpetual} */
perpetual_quote_duplicate_program ::= instructions_duplicate_perpetual

/* @sem Program::Program{instructions:$instructions_hand_union_perpetual} */
perpetual_quote_hand_union_program ::= instructions_hand_union_perpetual

/* @sem Program::Program{instructions:$instructions_optional_hand_perpetual} */
perpetual_quote_optional_hand_program ::= instructions_optional_hand_perpetual

/* @sem Instruction::[Effect{result:@next, operation:$target_mana_grant_until_source_cast}, Effect{result:@next, operation:$cast_source_while_exiled}] */
instructions_source_mana_grant ::= target_mana_grant_until_source_cast "." cast_source_while_exiled

/* Ownership of the source, independently of control, restricts activation. */
/* @sem ActivationLimits::ActivationLimits{modifiers:[ActivationRule(OnlyBy(One(OwnerOf(Source))))]} */
limit_source_owner ::= "only" "this" "creature's" "owner" "may" "activate" "this" "ability"

/* One duration governs both the casting permission and entry replacement. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellTiming{spells:$flash_spells, timing:Flash})], duration:$duration, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateReplacement{event:Enter{objects:$filter_phrase}, limit:UntilExpired, duration:$duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$counter_amount})}}]}}}] */
instructions_flash_and_entry_counters ::= duration "," "you" "may" "cast" flash_spells "as" "though" "they" "had" "flash" "," "and" "each" filter_phrase "enters" "with" counter_amount "additional" counter_kind "counter" "on" "it"

/* The restriction refers to the result of this very additional combat action. */
/* @sem Instruction::[Effect{result:@next, operation:$additional_combat_phase}, Effect{result:@next, operation:ChangeCombat{change:OnlyAttackers{objects:$affected_plural, during:@prior}}}] */
instructions_combat_phase_restriction ::= additional_combat_phase "." "only" affected_plural "can" "attack" "during" "that" "combat" "phase"

/* Both mentions of Elf name the same announced target; the random card is
   selected independently and the second effect consumes that selection. */
/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:Subtype(Elf)})), tapped:false}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:Targets(0), changes:$static_changes}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), count:AsManyAsCan($counter_amount), constraints:[AtRandom]}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$static_changes}}] */
instructions_untap_elf_random_hand ::= "untap" "up" "to" "one" "target" "Elf" "." "that" "Elf" "and" counter_amount "random" filter_phrase "card" "in" "your" "hand" "perpetually" static_changes

/* @sem @apply(PlayerSet::One(PlayerRef::OtherChosen(EventSubject)), $verbs_third) */
clause_other_chosen_also ::= "the" "other" "chosen" "player" "also" verbs_third

/* The follow-up change applies to the actual returned incarnation. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:$self_return_battlefield}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:$static_changes, duration:$duration, evaluation:Snapshot}}]}, otherwise:Program{}}]} */
graveyard_self_paid_changed ::= "you" "may" payment "." "if" "you" "do" "," self_return_battlefield "." "it" static_changes duration "."

/* A common source pump is part of each of the two selected alternatives. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[Pump{power:$signed, toughness:$signed_2}], duration:EndOfTurn, evaluation:Snapshot}}, Effect{result:@next, operation:$operation_plain}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[Pump{power:$signed, toughness:$signed_2}], duration:EndOfTurn, evaluation:Snapshot}}, Effect{result:@next, operation:$operation_plain_2}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
shared_pump_two_modes ::= "choose" "one" "and" SELF_NAME "gets" signed "/" signed "until" "end" "of" "turn" "." NEWLINE "•" operation_plain "." NEWLINE "•" operation_plain "."

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:$instructions_target_controller_optional_move}} */
activated_target_controller_optional_move ::= cost ":" instructions_target_controller_optional_move "."

/* @sem ActivationLimits::ActivationLimits{once:true, sorcery:true} */
limit_sorcery_once_ever ::= "activate" "only" "as" "a" "sorcery" "and" "only" "once"

/* The mill recipient also owns the recorded graveyard arrivals. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Mill{players:One($mill_history_player), amount:EventHistory{event:ZoneChange{objects:@and($history_graveyard_cards, ObjectFilter::OwnedBy(One($mill_history_player))), to:Graveyard}, window:$history_graveyard_window, measure:Occurrences}}}]} */
program_mill_owned_arrivals ::= mill_history_player "mills" "X" "cards" "," "where" "X" "is" "the" "number" "of" history_graveyard_cards "put" "into" "their" "graveyard" "from" "anywhere" history_graveyard_window

/* A captured value preserves the existing snapshot reading. */
/* @sem Program::@where_snapshot(Program::Program{instructions:[Effect{result:@next, operation:Mill{players:One($mill_history_player), amount:AnnouncedX}}]}, Expr::EventHistory{event:ZoneChange{objects:@and($history_graveyard_cards, ObjectFilter::OwnedBy(One($mill_history_player))), to:Graveyard}, window:$history_graveyard_window, measure:Occurrences}) */
program_mill_owned_arrivals_snapshot ::= mill_history_player "mills" "X" "cards" "," "where" "X" "is" "the" "number" "of" history_graveyard_cards "put" "into" "their" "graveyard" "from" "anywhere" history_graveyard_window

mill_history_player ::= mill_history_enchanted | player_ref

/* @sem PlayerRef::EnchantedBy(ObjectRef::Source) */
mill_history_enchanted ::= "enchanted" "player"

history_graveyard_cards ::= random_any_cards | search_many_plain

history_graveyard_window ::= bound_attack_this_turn | history_graveyard_game

/* @sem HistoryWindow::ThisGame */
history_graveyard_game ::= "this" "game"

/* Both restrictions apply independently to the activation. */
/* @sem ActivationLimits::ActivationLimits{once:true, condition:$condition} */
limit_condition_once_ever ::= "activate" "only" "if" condition "and" "only" "once"

/* @sem @apply(PlayerSet::One($chosen_player_ref), $chosen_player_game_verbs) */
clause_chosen_player_game_outcome ::= chosen_player_ref chosen_player_game_verbs

/* @sem Instruction::[Effect{result:@next, operation:$chosen_player_game_action}] */
chosen_player_game_verbs ::= chosen_player_game_action

chosen_player_game_action ::= win_game_third | lose_game_third

/* @sem ActivationLimits::ActivationLimits{modifiers:[Change::ActivationRule(MaxPerTurn($value))]} */
limit_max_per_turn_value ::= "activate" "no" "more" "times" "each" "turn" "than" value

/* Both sentences restrict the activation independently of its cost and body. */
/* @sem ActivationLimits::ActivationLimits{sorcery:true, modifiers:[Change::ActivationRule(XNotZero)]} */
limit_x_nonzero_sorcery ::= "x" "can't" "be" "0" "." "activate" "only" "as" "a" "sorcery"

/* @sem ActivationLimits::ActivationLimits{modifiers:[Change::ActivationRule(RestrictMana{portion:All})]} */
limit_spend_chosen_color ::= "spend" "only" "mana" "of" "the" "chosen" "color" "to" "activate" "this" "ability"

/* Both restrictions apply to this ability, regardless of its cost or body. */
/* @prefer always */
/* @sem ActivationLimits::ActivationLimits{once:true, condition:$activation_window} */
limit_once_ever_window ::= "activate" "only" "once" "and" "only" activation_window

/* The active player must be the player activating the ability. */
/* @sem ActivationLimits::ActivationLimits{activators:All, condition:PlayerIsActive(AbilityController)} */
limit_any_player_own_turn ::= "any" "player" "may" "activate" "this" "ability" "but" "only" "during" "their" "turn"

/* Both activation restrictions apply independently to the same ability. */
/* @sem ActivationLimits::ActivationLimits{condition:AllOf([$condition, PlayerIsActive(AbilityController)])} */
limit_condition_and_your_turn ::= "activate" "only" "if" condition "and" "only" "during" "your" "turn"

/* @sem ActivationLimits::ActivationLimits{activators:All, condition:Window(Upkeep)} */
limit_any_player_upkeep ::= "any" "player" "may" "activate" "this" "ability" "but" "only" "during" "any" "upkeep" "step"

/* @sem ActivationLimits::ActivationLimits{sorcery:true, modifiers:$activation_mana_instead} */
limit_mana_instead_sorcery ::= activation_mana_instead "." "activate" "only" "as" "a" "sorcery"

/* The activator is the ability controller for its draw-step restriction. */
/* @sem ActivationLimits::ActivationLimits{activators:All, condition:AllOf([PlayerIsActive(AbilityController), Window(DrawStep)])} */
limit_any_player_draw_step ::= "any" "player" "may" "activate" "this" "ability" "but" "only" "during" "their" "draw" "step"

/* The activating player must be active and the turn must precede its end step. */
/* @sem ActivationLimits::ActivationLimits{activators:All, condition:AllOf([PlayerIsActive(AbilityController), Window(BeforeEndStep)])} */
limit_any_player_own_turn_before_end ::= "any" "player" "may" "activate" "this" "ability" "but" "only" "during" "their" "turn" "before" "the" "end" "step"

/* @sem ActivationLimits::ActivationLimits{once_each_turn:true, condition:$condition_object_is_kind} */
limit_once_if_object_kind ::= "activate" "only" "once" "each" "turn" "and" "only" "if" condition_object_is_kind

/* Keep the preceding instruction and conditional consequent independently editable. */
/* @prefer always */
/* @sem Instruction::[...$clause, If{condition:$condition_control_counter_an, then:$then_condition_program, otherwise:Program{}}] */
instructions_counter_condition_followup ::= clause "." "then" "if" condition_control_counter_an "," then_condition_program

/* The activator is the controller of the independently named object. */
/* @sem ActivationLimits::ActivationLimits{modifiers:[Change::ActivationRule(OnlyBy(One(ControllerOf($object_ref))))]} */
limit_only_controller_of_object ::= "only" "the" "controller" "of" "the" object_ref "may" "activate" "this" "ability"

/* The enchanted host supplies the payable cost and the named controller limits activation. */
/* @prefer always */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_enchanted_creature_mana]}, limits:$limit_only_controller_of_object, announcement:@announcement, body:$program_sentence} */
activated_mana_cost_host_controller ::= cost_enchanted_creature_mana ":" program_sentence limit_only_controller_of_object "."

/* @sem ObjectWindow::SinceLastUpkeepOf(AbilityController) */
block_history_since_own_upkeep ::= "since" "your" "last" "upkeep"

/* @sem ObjectFilter::AnyOf([History{event:Blocked, window:$block_history_since_own_upkeep}, History{event:WasBlocked, window:$block_history_since_own_upkeep}]) */
blocked_or_was_blocked_history ::= "has" "blocked" "or" "been" "blocked" block_history_since_own_upkeep

/* @sem Condition::ObjectMatches{object:$object_ref, filter:$blocked_or_was_blocked_history} */
condition_combat_since_own_upkeep ::= object_ref blocked_or_was_blocked_history

/* @sem Vec<Instruction>::@returned_conditional([Instruction::If{condition:$condition_combat_since_own_upkeep, then:Program{instructions:$clause}, otherwise:Program{instructions:$clause_2}}]) */
instructions_postfix_block_history ::= clause "if" condition_combat_since_own_upkeep "." "otherwise" "," clause

/* A live population reduction and per-turn limit qualify the same activation. */
/* @sem ActivationLimits::ActivationLimits{once_each_turn:true, modifiers:$activation_live_reduction} */
limit_live_reduction_once ::= activation_live_reduction "." "activate" "only" "once" "each" "turn"

/* A conditional reduction modifies this activation, independently of its body. */
/* @sem ActivationLimits::ActivationLimits{modifiers:[Change::ActivationRule(Cost{modifier:Reduce{reductions:[ManaReduction{amount:$braced_amount}], spill_into_generic:true}, condition:$condition})]} */
limit_conditional_cost_reduction ::= "this" "ability" "costs" braced_amount "less" "to" "activate" "if" condition

/* @sem Program::Program{instructions:[$optional_cast_linked_three_types]} */
optional_cast_linked_program ::= optional_cast_linked_three_types

/* A reduction applies to this activation only during its stated window. */
/* @sem ActivationLimits::ActivationLimits{modifiers:[ActivationRule(Cost{modifier:Reduce{reductions:[ManaReduction{amount:$braced_amount}], spill_into_generic:true}, condition:$activation_window})]} */
limit_cost_less_window ::= "this" "ability" "costs" braced_amount "less" "to" "activate" activation_window

/* The condition and once-per-turn restriction apply to the same activation. */
/* @sem ActivationLimits::ActivationLimits{once_each_turn:true, condition:$condition_opponent_controls_a} */
limit_once_condition ::= "activate" "only" "once" "each" "turn" "and" "only" "if" condition_opponent_controls_a

/* @sem Ability::Spell{announcement:@announcement, body:$ordinary_program_sentence} */
ordinary_spell_ability ::= ordinary_program_sentence

/* Keep the two sequential effects on one written line. */
/* @prefer always */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$damage_cant_be_prevented_this_turn}, ...$clause_damage_same_controller]}} */
spell_unpreventable_damage_distribution ::= damage_cant_be_prevented_this_turn "." clause_damage_same_controller "."

/* @sem Ability::Triggered{event:Object{event:Attacks, objects:SameObject(Source)}, intervening_if:$condition_player_poisoned, limits:_{}, announcement:@announcement, body:$program_sentence} */
triggered_creature_attack_poisoned_defender ::= "whenever" "this" "creature" "attacks" "," "if" condition_player_poisoned "," program_sentence

/* A target announced for a later instruction. */
/* @sem Instruction::[@choose($target_card_graveyard_except_basic)] */
clause_choose_card ::= "choose" target_card_graveyard_except_basic

/* @prefer always */
/* An opponent announces the choice; each mode keeps its own scope. */
/* @sem Ability::Spell{announcement:Announcement{modes:ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[$mode_next_turn_upkeep_you, $mode_search_that_card_hand], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:OneOf(OpponentsOf(AbilityController)), method:PlayerChoice}}}, body:Program{}} */
spell_opponent_selects_modes ::= "an" "opponent" "chooses" "one" "—" NEWLINE mode_next_turn_upkeep_you NEWLINE mode_search_that_card_hand

/* @prefer always */
/* @sem EventSpec::ClassLevel{objects:SameObject(ObjectRef::Source), level:$value} */
event_when_this_class_level ::= "when" self_class "becomes" "level" value

/* The definition applies to this activation and uses the shared card population. */
/* @sem ActivationLimits::ActivationLimits{modifiers:[Change::ActivationRule(XIs(NumberTest::Compare{comparison:Equal, value:$value_number_cards_in_opponent_zone}))]} */
limit_x_card_count ::= "x" "is" value_number_cards_in_opponent_zone

/* Count the cards in the opponent's named zone for an activation's X. */
/* @sem Expr::CountObjects(Zone{scope:Players{zone:$greatest_card_zone, players:One($possessive_an_opponent)}, kind:Card, filter:Any}) */
value_number_cards_in_opponent_zone ::= "the" "number" "of" "cards" "in" possessive_an_opponent greatest_card_zone

/* @sem PlayerRef::OneOf(OpponentsOf(AbilityController)) */
possessive_an_opponent ::= "an" "opponent's"

/* @sem Instruction::[If{condition:$condition_single_target_matches, then:Program{instructions:[Effect{result:@next, operation:$retarget_that_spell_another}]}, otherwise:Program{}}] */
clause_retarget_matching_spell ::= "if" condition_single_target_matches "," retarget_that_spell_another

/* This intervening condition is tied to the player who caused the attack event. */
/* @sem Ability::Triggered{event:$event_player_attacks, intervening_if:Not(ExistsPlayer{players:One(AbilityController), binding:0, condition:PlayerAttacks{attacker:EventSubject, defender:Bound(0)}}), limits:_{}, announcement:@announcement, body:$program_sentence} */
triggered_player_not_attacking_you ::= "whenever" event_player_attacks "," "if" "they" "aren't" "attacking" "you" "," program_sentence

/* A single drafted card can be moved directly to a stated destination. The
   producer remains in the same instruction sequence as its result consumer. */
/* @sem Instruction::[Effect{result:@next, operation:$draft_single_book}, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:$draft_single_destination, qualifiers:[]}}] */
instructions_draft_single_entry ::= draft_single_book "and" "put" "it" draft_single_destination

/* @sem Operation::DraftFromSpellbook{actor:One(AbilityController), spellbook:Planets, times:Constant(1)} */
draft_single_book ::= "draft" "a" "card" "from" "the" "Planets" "Spellbook"

draft_single_destination ::= look_battlefield_tapped | selected_onto_battlefield

/* The timing, blocking predicate, and frequency all constrain this activation. */
/* @sem ActivationLimits::ActivationLimits{once_each_turn:true, condition:AllOf([$activation_window, $blocking_count_condition])} */
limit_window_blocking_once ::= "activate" "only" activation_window "," "only" "if" blocking_count_condition "," "and" "only" "once" "each" "turn"

/* Casting the ability holder from its graveyard establishes the trigger's zone. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$graveyard_self_cast}]}}]} */
graveyard_self_cast_may ::= "you" "may" graveyard_self_cast "."

graveyard_turn_self_program ::= graveyard_self_program | graveyard_self_cast_may

/* The reanimation follows the mill and chooses from the whole graveyard. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$amass_action}, Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::AbilityController), $mill_base)}, ...$return_chosen_graveyard_battlefield]} */
program_amass_mill_return ::= amass_action "," mill_base "," "then" return_chosen_graveyard_battlefield

/* The spell applies the perpetual adjustment before its next action. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$graveyard_cards_perpetual_pump}, ...$clause_immediate]}} */
spell_graveyard_pump_then ::= graveyard_cards_perpetual_pump "." "then" clause_immediate "."

/* @sem Instruction::[Effect{result:@next, operation:$next_spell_cast_as_flash}] */
clause_next_spell_flash_plain ::= next_spell_cast_as_flash

/* @sem Instruction::[Effect{result:@next, operation:$next_flash_creature_permission}] */
next_flash_creature_clause ::= next_flash_creature_permission

/* A preceding instruction introduces the recipient whose player may pay. */
/* @sem Instruction::[...$clause, ...$recipient_paid_copy] */
instructions_then_paid_copy ::= clause "." "then" recipient_paid_copy

/* The replacement keeps the original target and requires the same damage source. */
/* @sem Vec<Instruction>::@unlabelled_instructions($instructions_damage_raid_unpreventable_paragraph) */
instructions_damage_raid_unpreventable ::= instructions_damage_raid_unpreventable_paragraph

/* @sem Ability::@optional_ability_label(Spell{announcement:@announcement, body:Program{instructions:[@repeated_damage_actor(Instruction::If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref_2, recipients:$recipients_any_target, amount:$number_2, preventable:false}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:Targets(@last_slot), amount:$number, preventable:true}}]}})]}}, $spell_paragraph_break) */
instructions_damage_raid_unpreventable_paragraph ::= damage_source_ref "deals" number "damage" "to" recipients_any_target "." spell_paragraph_break "if" condition "," "instead" damage_source_ref "deals" number "damage" "to" "that" "permanent" "or" "player" "and" "the" "damage" "can't" "be" "prevented"

/* The conditional object is the previously announced damage recipient. */
/* @sem Instruction::[If{condition:ObjectMatches{object:RecipientObject{slot:@last_slot, index:0}, filter:$noun}, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(RecipientObject{slot:@last_slot, index:0})), changes:[Rule(Prohibit(Block(Any)))], duration:$this_duration, evaluation:LiveObjects}}]}, otherwise:Program{}}] */
recipient_conditional_block ::= "if" "it's" "a" noun "," "it" "can't" "block" this_duration

/* The stated intensity and named cards are scoped to this damage sequence. */
/* @sem Instruction::[Effect{result:@next, operation:$intensity_damage_sentence}, Effect{result:@next, operation:$intensity_damage_followup}] */
instructions_intensity_damage_and_named ::= intensity_damage_sentence "." intensity_damage_followup
intensity_damage_sentence ::= deal_damage_own_intensity | sorcery_own_intensity_damage
/* @sem Operation::DealDamage{source:Source, recipients:$recipients, amount:ObjectProperty{object:Source, property:Intensity, information:CurrentOrLastKnown}, preventable:true} */
sorcery_own_intensity_damage ::= "this" "sorcery" "deals" "damage" "equal" "to" "its" "intensity" "to" recipients
intensity_damage_followup ::= intensity_damage_next_line | intensity_damage_then
/* @sem $intensify_owned_named */
intensity_damage_next_line ::= NEWLINE intensify_owned_named
/* @sem $intensify_owned_named */
intensity_damage_then ::= "then" intensify_owned_named

/* @sem Program::Program{instructions:$instructions_random_hand_perpetual} */
perpetual_quote_hand_reveal_program ::= instructions_random_hand_perpetual

/* A completed instruction followed by a conditional sentence. */
/* @sem Instruction::[...$clause, ...$clause_if] */
instructions_before_conditional_sentence ::= clause "." clause_if

activated_limited_general ::= activated_limited_standard | activated_limited_choice

/* @sem ActivationLimits::ActivationLimits{modifiers:[ActivationRule(XNotZero)]} */
limit_x_nonzero ::= "x" "can't" "be" "0"

/* The nonzero choice belongs to the activated power-limited return. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:$limit_x_nonzero, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$return_power_limited_graveyard_card}]}} */
activated_nonzero_power_reanimation ::= cost ":" return_power_limited_graveyard_card "." limit_x_nonzero "."

/* The leading condition begins the spell's next line. */
/* @prefer always */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$operation}, $conditional_block_limit]}} */
spell_with_conditional_block_limit ::= operation "." NEWLINE conditional_block_limit "."

/* @sem Ability::@contextual_reminder(Ability::WithPresentation{label:$ability_label, ability:Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$operation}, $conditional_block_limit]}}}, $ability_explanation) */
spell_with_reminded_block_limit ::= operation "." "(" ability_explanation ")" NEWLINE ability_label "—" conditional_block_limit "."

/* @sem Instruction::If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:$creatures_cant_block_this_turn}]}, otherwise:Program{}} */
conditional_block_limit ::= "if" condition "," creatures_cant_block_this_turn

/* The draw and the foretell designation form one printed sequence. */
/* @sem Instruction::[Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::AbilityController), $draw_base)}, ...$clause_foretell_exiled_hand] */
instructions_draw_foretell ::= draw_base "," "then" clause_foretell_exiled_hand

conjure_pair_destination ::= conjure_spellbook_hand | conjure_battlefield_arrival | conjure_tapped_arrival

/* The producer is a damage action, so the followup refers to its receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$deal_damage}, If{condition:Compare{left:CountPlayers(Intersection([DamagedBy(@marked), All])), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:$program, otherwise:Program{}}] */
instructions_damage_player_followup ::= deal_damage "." "if" "a" "player" "is" "dealt" "damage" "this" "way" "," program

/* Tap the chosen creature before applying its pending untap restriction. */
/* @sem Vec<Instruction>::@and_sequence([Instruction::Effect{result:@next, operation:$tap_objects}], [Instruction::Effect{result:@next, operation:$skip_controllers_next_untap}]) */
instructions_comma_and ::= tap_objects "," "and" skip_controllers_next_untap

/* @sem Operation::ChooseObjects{player:AbilityController, objects:Affected(@marked), count:AnyNumber} */
choose_counter_affected_permanents ::= "choose" "any" "number" "of" "permanents" "you" "control" "that" "had" "a" "counter" "put" "on" "them" "this" "way"

/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::PhaseOut{}, objects:Selected(@prior)} */
phase_counter_selected_permanents ::= "those" "permanents" "phase" "out"

/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::PhaseOut{until:$counter_phase_duration}, objects:Selected(@prior)} */
phase_counter_selected_for ::= "those" "permanents" "phase" "out" counter_phase_duration

counter_phase_duration ::= until_end_of_turn | until_end_of_combat

phase_counter_selection ::= phase_counter_selected_permanents | phase_counter_selected_for

/* Keep the counters, chosen subset and phasing bound to consecutive effects. */
/* @sem Instruction::[Effect{result:@mark, operation:$proliferate_once_action}, Effect{result:@next, operation:$choose_counter_affected_permanents}, Effect{result:@next, operation:$phase_counter_selection}] */
instructions_proliferate_choose_phase ::= proliferate_once_action "," "then" choose_counter_affected_permanents "." phase_counter_selection

/* The first-combat trigger names the same attacking population for its untap and its grant. */
/* @sem Ability::Triggered{event:$event_clause, intervening_if:$condition_first_combat_phase, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[...$instructions_untap_attacking_grants, Effect{result:@next, operation:$additional_combat_phase}]}} */
triggered_first_combat_attacker_grants ::= event_clause "," "if" condition_first_combat_phase "," instructions_untap_attacking_grants "." additional_combat_phase "."

/* Count the returned cards from the explicit movement instruction. */
/* @sem Instruction::[Effect{result:@mark, operation:$return_graveyard_distinct_yours}, If{condition:Compare{left:CountObjects(Transition{result:@marked, phase:Before}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}, then:Program{instructions:[Effect{result:@next, operation:$set_life_total_equal_to}]}, otherwise:Program{}}] */
/* @prefer always */
clause_return_graveyard_distinct_threshold ::= return_graveyard_distinct_yours "." "if" value "or" "more" "cards" "were" "returned" "to" "your" "hand" "this" "way" "," set_life_total_equal_to

/* @sem Operation::SetLifeTotal{players:One(AbilityController), amount:$value} */
set_life_total_equal_to ::= "your" "life" "total" "becomes" "equal" "to" value

/* @sem Operation::Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_plural_count, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)}), constraints:[DifferentProperty(ManaValue)]})), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_graveyard_distinct_yours ::= "return" graveyard_plural_count "target" "cards" "with" "different" "mana" "values" "from" "your" "graveyard" "to" "your" "hand"

/* @sem Ability::Triggered{event:$event_cast_nth_random_damage, limits:_{}, announcement:@announcement, body:Program{instructions:$instructions_random_opponent_recipient_damage}} */
ability_nth_spell_random_damage ::= "whenever" event_cast_nth_random_damage "," instructions_random_opponent_recipient_damage "."

/* Keep both effects bound to the active player and the tapped target. */
damage_creature_stat ::= stat_power | stat_toughness

/* @sem Operation::DealDamage{source:$object_ref, recipients:Players(One(Active)), amount:ObjectProperty{object:$object_ref, property:$damage_creature_stat, information:CurrentOrLastKnown}, preventable:true} */
active_player_damage_from_creature_stat ::= object_ref "deals" "damage" "equal" "to" "its" damage_creature_stat "to" "the" "player"

/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(Active))])}), index:0}), tapped:true}}, Effect{result:@next, operation:$active_player_damage_from_creature_stat}, Effect{result:@next, operation:$prevent_combat_to_by}] */
instructions_tap_active_player_creature_damage_prevent ::= "tap" "target" "creature" "that" "player" "controls" "." active_player_damage_from_creature_stat "." prevent_combat_to_by

/* Scope a creature copy to the immediately preceding battlefield selection. */
/* @sem ObjectFilter::AllOf([Not(Supertype(Legendary)), CardType(Creature)]) */
copy_choice_nonlegendary_creature ::= "nonlegendary" "creature"

copy_choice_filter ::= copy_choice_nonlegendary_creature | noun_creature

/* @sem Instruction::[Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$copy_choice_filter}, count:AsManyAsCan(Constant(1))}}] */
choose_battlefield_copy_creature ::= "choose" "a" copy_choice_filter

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0})), changes:[CopyOf{object:Result{result:@marked, phase:After, index:0}, exceptions:[]}], duration:$duration, evaluation:Snapshot}}] */
copy_chosen_battlefield_creature_one ::= "target" "creature" "becomes" "a" "copy" "of" "that" "creature" duration

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:AnyNumber, filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}))), changes:[CopyOf{object:Result{result:@marked, phase:After, index:0}, exceptions:[]}], duration:$duration, evaluation:Snapshot}}] */
copy_chosen_battlefield_creature_many ::= "any" "number" "of" "target" "creatures" "you" "control" "each" "become" "a" "copy" "of" "that" "creature" duration

copy_chosen_battlefield_creature ::= copy_chosen_battlefield_creature_one | copy_chosen_battlefield_creature_many

/* Prefer explicit "on the battlefield." before the following copy sentence. */
/* @prefer always */
/* @sem Instruction::[...$choose_battlefield_copy_creature, ...$copy_chosen_battlefield_creature] */
instructions_choose_battlefield_creature_copy_on_battlefield ::= choose_battlefield_copy_creature "on" "the" "battlefield" "." copy_chosen_battlefield_creature

/* @sem Instruction::[...$choose_battlefield_copy_creature, ...$copy_chosen_battlefield_creature] */
instructions_choose_battlefield_creature_copy ::= choose_battlefield_copy_creature copy_choice_sequence copy_chosen_battlefield_creature

/* @sem () */
copy_choice_sequence ::= "." NEWLINE | "."

/* Keep the discarded card and the completed exile as separate receipts. */
discarded_copy_type ::= discarded_copy_type_an | discarded_copy_type_a

/* @sem $discard_copy_an_filter */
discarded_copy_type_an ::= "an" discard_copy_an_filter "card"

discard_copy_an_filter ::= noun_artifact | noun_enchantment

/* @sem $discard_copy_a_filter */
discarded_copy_type_a ::= "a" discard_copy_a_filter "card"

discard_copy_a_filter ::= noun_creature | noun_land

/* @sem Vec<CopyException>::[SetPowerToughness{power:$number_digits, toughness:$number_digits_2}, AddCreatureTypes($becomes_types), AddCardTypes([Artifact, Creature]), AddAbilities([Keyword($keyword_value)])] */
discarded_copy_token_exceptions ::= "," "except" "it's" "a" number_digits "/" number_digits becomes_types "artifact" "creature" "with" keyword_value "in" "addition" "to" "its" "other" "types"

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:_{parts:[Move{selections:[_{objects:One(Result{result:@prior, phase:After, index:0})}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}}, If{condition:PaymentChosen(@marked), then:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$counter_amount, words:CreatingEffect, recipe:Copy{object:Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0}, exceptions:$discarded_copy_token_exceptions}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:_{}}] */
discarded_copy_after_exile ::= "exile" "it" "from" "your" "graveyard" "." "if" "you" "do" "," "create" counter_amount "token" "that's" "a" "copy" "of" "it" discarded_copy_token_exceptions

/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:Discard{players:One(AbilityController), amount:Constant(1)}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@last_result, phase:Before}, filter:$discarded_copy_type}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:_{instructions:$discarded_copy_after_exile}, otherwise:_{}}] */
instructions_draw_discard_exile_copy ::= "draw" card_count "," "then" "discard" "a" "card" "." "if" "the" "discarded" "card" "was" discarded_copy_type "," discarded_copy_after_exile

/* Limit the follow-up to the creatures just goaded, including any goad replacements. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy($goaded_creature_controller)])} */
goaded_opponents_creatures ::= "all" "creatures" goaded_creature_controller

goaded_creature_controller ::= goaded_creature_opponents | mixed_target_you | goaded_creature_active

/* @sem PlayerSet::OpponentsOf(AbilityController) */
goaded_creature_opponents ::= "your" "opponents" "control"

/* @sem PlayerSet::One(Active) */
goaded_creature_active ::= "the" "active" "player" "controls"

goaded_creatures_rules ::= rule_cant_block | rule_cant_attack_you_only

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Affected(@marked)), changes:$goaded_creatures_rules, duration:$duration, evaluation:LiveObjects} */
goaded_creature_restriction ::= duration "," "those" "creatures" goaded_creatures_rules

/* @sem Instruction::[Effect{result:@mark, operation:KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Goad{}, objects:$goaded_opponents_creatures}}, Effect{result:@next, operation:$goaded_creature_restriction}] */
instructions_goad_creatures_then_restrict ::= "goad" goaded_opponents_creatures "." goaded_creature_restriction

/* Capture the created batch before linking the delayed leave trigger. */
/* @sem TokenName::Explicit(Mechtitan) */
explicit_all_color_mechtitan ::= "Mechtitan"

explicit_all_color_name ::= explicit_all_color_mechtitan | explicit_legendary_name

/* @sem TokenSpec::TokenSpec{amount:$counter_amount, words:CreatingEffect, recipe:Defined{name:$explicit_all_color_name, supertypes:[Legendary], colors:[White, Blue, Black, Red, Green], subtypes:$token_subtypes, card_types:$token_types, power_toughness:[$token_stat, $token_stat_2], abilities:$token_abilities}} */
token_explicit_legendary_all_colors ::= explicit_all_color_name "," counter_amount "legendary" token_stat "/" token_stat token_subtypes token_types "token" "with" token_abilities "that's" "all" "colors"

/* @sem Operation::@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$token_explicit_legendary_all_colors], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}) */
create_named_legendary_all_colors ::= "create" token_explicit_legendary_all_colors

/* @sem Operation::CreateDelayedTrigger{event:Object{event:LeavesBattlefield, objects:InSet(Created(@marked))}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Move{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([ExiledWith($object_ref), Not(SameObject($object_ref_2))])}), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}]}} */
delayed_created_token_linked_return ::= "when" "that" "token" "leaves" "the" "battlefield" "," "return" "all" "cards" "exiled" "with" object_ref "except" object_ref "to" "the" "battlefield" "tapped" "under" "their" "owners'" "control"

/* @sem Instruction::[Effect{result:@mark, operation:$create_named_legendary_all_colors}, Effect{result:@next, operation:$delayed_created_token_linked_return}] */
instructions_named_legendary_token_linked_return ::= create_named_legendary_all_colors "." delayed_created_token_linked_return

/* Keep the named partner and the meld result tied to the same conditional program. */
/* @sem () */
meld_owned_prefix ::= "you" "both" "own" "and" "control"

/* @sem () */
meld_exile_then ::= "exile" "them" "," "then" "meld" "them" "into"

/* @sem Ability::Triggered{event:$turn_event, intervening_if:AllOf([ObjectMatches{object:$object_ref, filter:AllOf([OwnedBy(One(AbilityController)), ControlledBy(One(AbilityController))])}, Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Name('Bruna, the Fading Light'), OwnedBy(One(AbilityController)), ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}}]), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), Name('Bruna, the Fading Light')])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Union([One(Source), Selected(@prior)]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Meld{objects:Transition{result:@prior, phase:After}, into:'Brisela, Voice of Nightmares', entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}} */
ability_meld_owned_brisela ::= "at" turn_event "," "if" meld_owned_prefix object_ref "and" counter_amount filter_phrase "named" "Bruna" "," "the" "Fading" "Light" "," meld_exile_then "Brisela" "," "Voice" "of" "Nightmares" "."

/* @sem Ability::Triggered{event:$turn_event, intervening_if:AllOf([ObjectMatches{object:$object_ref, filter:AllOf([OwnedBy(One(AbilityController)), ControlledBy(One(AbilityController))])}, Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Name('Midnight Scavengers'), OwnedBy(One(AbilityController)), ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}}]), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), Name('Midnight Scavengers')])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Union([One(Source), Selected(@prior)]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Meld{objects:Transition{result:@prior, phase:After}, into:'Chittering Host', entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}} */
ability_meld_owned_chittering_host ::= "at" turn_event "," "if" meld_owned_prefix object_ref "and" counter_amount filter_phrase "named" "Midnight" "Scavengers" "," meld_exile_then "Chittering" "Host" "."

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:Program{instructions:[If{condition:AllOf([ObjectMatches{object:$object_ref, filter:AllOf([OwnedBy(One(AbilityController)), ControlledBy(One(AbilityController))])}, Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Name('Hanweir Garrison'), OwnedBy(One(AbilityController)), ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}}]), then:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), Name('Hanweir Garrison')])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Union([One(Source), Selected(@prior)]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Meld{objects:Transition{result:@prior, phase:After}, into:'Hanweir, the Writhing Township', entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{}}]}} */
ability_meld_owned_hanweir ::= cost ":" "if" meld_owned_prefix object_ref "and" counter_amount filter_phrase "named" "Hanweir" "Garrison" "," meld_exile_then "Hanweir" "," "the" "Writhing" "Township" "."

/* @sem Condition::ObjectMatches{object:Source, filter:Counters(_{kind:$counter_kind, comparison:Equal, value:Constant(0)})} */
condition_enchantment_empty_counter_kind ::= self_enchantment "has" "no" counter_kind "counters" "on" "it"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One(Source), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]} */
program_return_trigger_source_to_owner_hand ::= "return" "it" "to" "its" "owner's" "hand" "."

/* @prefer always */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:$condition_enchantment_empty_counter_kind, limits:TriggerLimits{}, announcement:@announcement, body:$program_return_trigger_source_to_owner_hand} */
triggered_enchantment_empty_counter_return ::= "at" turn_event "," "if" condition_enchantment_empty_counter_kind "," program_return_trigger_source_to_owner_hand

/* A chosen graveyard card remains available after the mill resolves. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::AbilityController), $mill_base)}, ...$clause_optional_graveyard_card_hand]} */
program_mill_optional_graveyard_card_hand ::= mill_base "," "then" clause_optional_graveyard_card_hand

/* @sem Ability::Triggered{event:$event_referenced_put_graveyard, limits:_{}, announcement:@announcement, body:Program{instructions:$clause_graveyard_return_hand}} */
ability_referenced_graveyard_return_hand ::= "when" event_referenced_put_graveyard "," clause_graveyard_return_hand "."

/* @sem Ability::Triggered{event:ZoneChange{objects:SameObject(Source), to:Battlefield}, limits:_{}, announcement:@announcement, body:$program_mill_optional_graveyard_card_hand} */
ability_entrance_mill_optional_graveyard_hand ::= "when" "this" "creature" "enters" "," program_mill_optional_graveyard_card_hand "."

/* @sem Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[CostPart::Loyalty($loyalty_positive_heading)]}, limits:ActivationLimits{sorcery:true}, announcement:@announcement, body:Program{instructions:$instructions_look_optional_reveal_value}} */
loyalty_top_reveal_value ::= loyalty_positive_heading ":" instructions_look_optional_reveal_value "."

loyalty_program_sentence ::= program_named_source_copy_prevention | program_named_target_copy_prevention | program_repeat_player_payment | activation_defined_divided_sentence | hidden_exile_token_return_sentence | program_sentence | controller_damage_unless_sentence | loyalty_reveal_partition | chosen_three_tap_loyalty_sentence | chosen_three_tap_loyalty_followed | program_search_entry_grant_return | program_search_lands_animate | loyalty_source_other_damage_sentence | program_named_walker_animation_prevention | program_draw_then_unlimited_hand_emblem | emblem_targeted_group_program | target_draw_then_spell_discount

/* The discount belongs to the player targeted by the preceding draw. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Draw{players:One($target_player), amount:$card_count}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(Target{slot:0,index:0})), changes:[PlayerRule(SpellCost{spells:AnyOf([CardType(Instant), CardType(Planeswalker), CardType(Sorcery)]), modifier:$spell_cost_less})], duration:UntilNextTurn(AbilityController), evaluation:LiveObjects}}]} */
target_draw_then_spell_discount ::= target_player "draws" card_count "." "until" "your" "next" "turn" "," "instant" "," "sorcery" "," "and" "planeswalker" "spells" "that" "player" "casts" "cost" spell_cost_less "to" "cast" "."


/* @sem Program::Program{instructions:$instructions_reveal_all_battlefield_hand} */
loyalty_reveal_partition ::= instructions_reveal_all_battlefield_hand "."

/* The solve clause uses the present-perfect life history wording. */
/* @prefer always */
/* @sem $condition_you_have_gained_life */
case_life_gained_threshold ::= condition_you_have_gained_life

/* @sem ObjectFilter::AllOf([$filter_phrase, AnyOf($spell_colors_three)]) */
spell_color_three ::= "a" filter_phrase "spell" "that's" spell_colors_three

/* The cast event supplies the spell receiving the temporary ability. */
/* @prefer always */
/* @sem Ability::Triggered{event:Spell{event:Cast, players:All, spells:$spell_color_three}, limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:ChangeSpell{subject:One(EventSubject), changes:[GrantAbility($mechanic_devour_creatures)]}}]}} */
triggered_cast_colored_spell_devour ::= "whenever" "a" "player" "casts" spell_color_three "," "it" "gains" mechanic_devour_creatures "."

/* The first casting ability owns the single discarded card. Its spell
   checks that payment's before-state before taking the conditional action. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost::Cost{parts:[$discard_one_receipt_cost]}, repetition:Once}), Spell{announcement:@announcement, body:$casting_discard_followup}] */
card_single_casting_discard ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," discard_one_receipt_cost "." NEWLINE casting_discard_followup

/* @sem Program::Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(AbilityController), $draw_base)}, If{condition:$casting_discard_excluded_card, then:Program{instructions:[Effect{result:@next, operation:$operation}]}, otherwise:Program{}}]} */
casting_discard_followup ::= draw_base "." "if" casting_discard_excluded_card "," operation "."

/* @sem Condition::Compare{left:CountObjects(Matching{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Performed, phase:Before}, filter:Not($filter_phrase)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
casting_discard_excluded_card ::= "the" "discarded" "card" "wasn't" "a" filter_phrase "card"

/* The condition supplies the antecedent for the regeneration count in the body. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:$condition_this_creature_regenerated, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$create_for_source_regenerations}]}} */
triggered_source_regeneration_tokens ::= "at" turn_event "," "if" condition_this_creature_regenerated "," create_for_source_regenerations "."

/* A controller's library inspection can precede an ordered keyword action. */
serial_survey_action ::= scry_base | surveil_base
/* @sem Instruction::[Effect{result:@next, operation:@apply(PlayerSet::One(AbilityController), $serial_survey_action)}, Effect{result:@next, operation:$keyword_action}] */
serial_survey_keyword_then ::= serial_survey_action "," "then" keyword_action

/* A serial list can end with an explicitly ordered final action. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$ante_single_library_top}, ...$conjoined] */
serial_action_last_then ::= ante_single_library_top "," "then" conjoined

/* A postposed condition applies to one continuous action. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:$continuous_snapshot}]}, otherwise:Program{}}] */
conditional_continuous_phrase ::= continuous_snapshot "if" condition

/* Each coordinated phrase retains its own condition and action. */
/* @sem Instruction::[...$conditional_continuous_phrase, ...$conditional_continuous_phrase_2] */
instructions_conditional_conjunction ::= conditional_continuous_phrase "," "and" conditional_continuous_phrase

/* The die and its consumer share a frame; both counter kinds remain independent. */
/* @sem Ability::Spell{body:Program{instructions:[Effect{result:@next, operation:$roll_die_action}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Source)), kind:$counter_kind, amount:DieResult(@prior)}]}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:Rules, recipe:$token_named_recipe}], entry:_{}}}, If{condition:ObjectMatches{object:Source, filter:Counters(_{kind:$counter_kind_2, comparison:GreaterOrEqual, value:$number})}, then:_{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:ClaimPrize}}]}, otherwise:_{}}]}, announcement:@announcement} */
visit_die_counters_body ::= roll_die_action "." "put" "a" "number" "of" counter_kind "counters" "on" SELF_NAME "equal" "to" "the" "result" "and" "create" "a" token_named_recipe "token" "." "then" "if" "there" "are" number "or" "more" counter_kind "counters" "on" SELF_NAME "," "claim" "the" "prize" "!"

/* A prize can combine a named token creation with sacrificing the Attraction. */
/* @sem Ability::Spell{body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$number, words:Rules, recipe:$token_named_recipe}], entry:_{}}}, Effect{result:@next, operation:Sacrifice{players:One(AbilityController), objects:One(Source)}}, Effect{result:@next, operation:$open_attraction_action}]}, announcement:@announcement} */
visit_token_sacrifice_prize ::= "create" number token_named_recipe "tokens" "," "then" "sacrifice" SELF_NAME "and" open_attraction_action "."

/* The visit body retains the scope of its choice and its move. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$return_extreme_choice}} */
visit_extreme_return_spell ::= return_extreme_choice "."

/* Complete modes keep counter receipts and target scopes local to each option. */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:MoveCounters{actor:One(AbilityController), from:One($target_permanent), to:One($target_another), amount:All}}]}, weight:1}) */
counter_transfer_mode ::= "•" "move" "all" "counters" "from" target_permanent "onto" target_another "."

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($target_permanent)), amount:All}]}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountersRemoved(@marked)}}]}, weight:1}) */
counter_removal_draw_mode ::= "•" "remove" "all" "counters" "from" target_permanent "." "draw" "a" "card" "for" "each" "counter" "removed" "this" "way" "."

/* The casting-time condition belongs to this two-option announcement. Its
   modes remain independent typed phrases, including their target filters. */
/* @sem Ability::Spell{announcement:Announcement{modes:ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Conditional{condition:$condition, then:Constant(2), otherwise:Constant(1)}}, options:[$counter_transfer_mode, $counter_removal_draw_mode], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}}}, body:Program{}} */
/* @prefer always */
spell_cast_conditional_counter_modes ::= "choose" "one" "." "if" condition "as" "you" "cast" "this" "spell" "," "you" "may" "choose" "both" "instead" "." NEWLINE counter_transfer_mode NEWLINE counter_removal_draw_mode

/* The tested damage result is the immediately preceding damage operation. */
/* @sem Instruction::[Effect{result:@mark, operation:$excess_damage_producer}, If{condition:Compare{left:ExcessDamage{result:@marked, to:$excess_damage_recipient}, test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:$program, otherwise:Program{}}] */
instructions_damage_excess_followup ::= excess_damage_producer "." "if" "excess" "damage" "was" "dealt" "to" excess_damage_recipient "this" "way" "," program

/* @sem ObjectFilter::Any */
excess_damage_any_creature ::= "a" "creature"

excess_damage_recipient ::= excess_damage_any_creature | event_referenced_subject

excess_damage_producer ::= clamped_damage_producer | deal_damage_scaled_value

/* Keep a conditional replacement within the leading hand condition. */
/* @prefer always */
/* @sem Instruction::[If{condition:$condition_existential_hand, then:Program{instructions:$instead_postposed_inline}, otherwise:Program{}}] */
clause_hand_condition_instead ::= "if" condition_existential_hand "," instead_postposed_inline

/* @sem Instruction::[If{condition:$condition, then:Program{instructions:$clause_you}, otherwise:Program{}}] */
clause_you_postcondition ::= clause_you "if" condition

/* A postfix resolution condition chooses between two complete programs. */
/* @prefer always */
/* @sem Program::Program{instructions:[If{condition:$resolution_pair_condition, then:Program{instructions:$clause}, otherwise:Program{instructions:$instructions_may_when_you_do}}]} */
program_postfix_condition_otherwise ::= clause "if" resolution_pair_condition "." "otherwise" "," instructions_may_when_you_do

/* Selection and its counter placement share the actual selection receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(OthersThan(AbilityController)))}, count:AsManyAsCan($number)}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Selected(@prior)), kind:$counter_kind, amount:$counter_a}]}}] */
instructions_choose_uncontrolled_counter ::= "choose" number filter_plural "you" "don't" "control" "and" "put" counter_a counter_kind "counter" "on" "each" "of" "them"

/* One target group supplies both positions of a text-box exchange. */
/* @sem Instruction::[Effect{result:@next, operation:Exchange(_{kind:TextBoxes, first:Object(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(2)), filter:@agree($plural, $plural_2)}), index:0}), second:Object(Target{slot:0, index:1}), until:WhileOnBattlefield($self_ref)})}] */
instructions_exchange_target_text ::= "choose" "two" "target" plural "." "for" "as" "long" "as" self_ref "remains" "on" "the" "battlefield" "," "exchange" "the" "text" "boxes" "of" "those" plural

/* One shared body resolves independently for the two source events. */
/* @sem Ability::[Triggered{event:Object{event:PhasesOut, objects:$event_self}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}, Triggered{event:Object{event:LeavesBattlefield, objects:$event_self}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence}] */
line_pair_phases_out_or_leaves ::= ("when" | "whenever") event_self "phases" "out" "or" "leaves" "the" "battlefield" "," program_sentence

/* A spell followed by a separate restriction on its announced X. */
/* @sem Ability::[Casting(Require($x_cannot_equal_number)), Spell{body:_{instructions:[Effect{result:@next, operation:$number_loop_to_x}]}, announcement:@announcement}] */
line_number_loop_x_restriction ::= number_loop_to_x "." x_cannot_equal_number "."

/* The singular anaphor names the immediately preceding draft result. */
/* @sem Instruction::[Effect{result:@next, operation:$draft_one_source}, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
instructions_draft_one_exile_down ::= draft_one_source "and" "exile" "it" "face" "down"

/* Another ability excludes the current granted ability. */
/* @sem ActivationLimits::ActivationLimits{condition:ObjectMatches{object:Source, filter:HasActivatedAbility(Not(Of(SameObject(Source))))}} */
limit_another_activated_ability ::= "activate" "only" "if" "this" "creature" "has" "another" "activated" "ability"

/* Plotting this card can occur from the hand; the enclosing source-card
   trigger retains the all-zone scope and composes with any supported body. */
/* @sem EventSpec::Object{event:Plotted, objects:SameObject(Source)} */
repeat_card_plotted ::= "this" "card" "becomes" "plotted"

/* @sem $repeat_card_event */
repeat_card_header_existing ::= ("when" | "whenever") repeat_card_event

/* @sem $repeat_card_plotted */
repeat_card_plotted_header ::= "when" repeat_card_plotted

/* Two separately controlled types permit both announced modes. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Conditional{condition:AllOf([Controls{player:AbilityController, filter:$noun, minimum:1}, Controls{player:AbilityController, filter:$noun_2, minimum:1}]), then:Constant(2), otherwise:Constant(1)}}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_one_control_two_both ::= "choose" "one" "." "if" "you" "control" "an" noun "and" "an" noun "as" "you" "cast" "this" "spell" "," "you" "may" "choose" "both" "instead" "." NEWLINE modes

/* The explicit sequencing word joins any preceding clause to the scoped
   optional discard and its reflexive damage. */
/* @sem Instruction::[...$clause, ...$instructions_may_discard_max_damage] */
instructions_then_discard_max_damage ::= clause "." "then" instructions_may_discard_max_damage

/* @sem ActivationLimits::ActivationLimits{modifiers:[ActivationRule(XNotZero), ActivationRule(CantBeCopied)]} */
limit_uncopyable_nonzero_x ::= "this" "ability" "can't" "be" "copied" "and" "X" "can't" "be" "0"

/* This graveyard program refers back to the explicitly cast planeswalker. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$exile_self_from_own_graveyard}, Effect{result:@next, operation:$cast_planeswalker_entry_change}]} */
graveyard_exile_cast_planeswalker_program ::= exile_self_from_own_graveyard "." cast_planeswalker_entry_change "."

/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$when_cast_subtype_planeswalker, limits:_{}, announcement:@announcement, body:$graveyard_exile_cast_planeswalker_program})} */
graveyard_cast_planeswalker_trigger ::= when_cast_subtype_planeswalker "," graveyard_exile_cast_planeswalker_program

/* Both actions use the same captured definition, even if the first changes state. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:BindValue{value:$captured_x_definition}}, Effect{result:@next, operation:$captured_x_action}, Effect{result:@next, operation:$captured_x_action_2}]} */
program_captured_x_pair ::= captured_x_action "and" captured_x_action "," "where" "X" "is" captured_x_definition

captured_x_definition ::= captured_x_color_pairs | captured_x_permanent_types | captured_x_greatest_at_cast

captured_x_action ::= captured_x_it_damage | captured_x_target_draw | captured_x_put_counters | captured_x_draw | captured_x_player_loses | captured_x_you_gain | captured_x_topmost_perpetual

/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:BoundValue(@marked)}]} */
captured_x_put_counters ::= "put" "X" counter_kind "counters" "on" affected

/* @sem Operation::Draw{players:One(AbilityController), amount:BoundValue(@marked)} */
captured_x_draw ::= "draw" "X" "cards"

/* @sem Ability::Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:$repeat_cast_header, intervening_if:Compare{left:CountObjects(Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})), test:NumberTest::Compare{comparison:Less, value:$hand_shortfall_draw_threshold}}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Subtract([$hand_shortfall_draw_threshold, CountObjects(Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}))])}}]}})} */
source_cast_hand_shortfall ::= repeat_cast_header "," hand_shortfall_draw_threshold "."

/* @sem Ability::Triggered{event:$event_clause, intervening_if:Compare{left:CountObjects(Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})), test:NumberTest::Compare{comparison:Less, value:$hand_shortfall_draw_threshold}}, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Subtract([$hand_shortfall_draw_threshold, CountObjects(Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}))])}}]}} */
triggered_hand_shortfall ::= event_clause "," hand_shortfall_draw_threshold "."

/* One explicit exile supplies the exact arrival tested by the following branch. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@prior, phase:After, index:0}, filter:$exiled_card_test}, then:$program, otherwise:Program{}}] */
instructions_exile_card_type_test ::= "exile" target_card "." "if" "it" "was" "a" exiled_card_test "," program

/* @sem $card_filter */
exiled_card_test ::= card_filter "card"

/* @sem Program::Program{instructions:$instructions_random_duplicate_grant} */
perpetual_quote_random_duplicate_program ::= instructions_random_duplicate_grant

/* A cast-subject history predicate composes with a trigger body. */
/* @sem Ability::Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:$repeat_cast_header, intervening_if:$cast_subject_history_condition, limits:TriggerLimits{}, announcement:@announcement, body:$cast_subject_trigger_body})} */
cast_subject_history_trigger ::= repeat_cast_header "," "if" cast_subject_history_condition "," cast_subject_trigger_body

/* The extra combat carries its own start program, inside the first-combat window. */
/* @sem Instruction::[If{condition:Window(BeforeFirstCombat), then:_{instructions:[Effect{result:@next, operation:AddPhases{actor:One(AbilityController), phases:Combat, count:Constant(1), at_start:Program($added_combat_start_program)}}]}, otherwise:_{}}] */
instructions_first_combat_extra ::= "after" "the" "first" "combat" "phase" "this" "turn" "," "there's" "an" "additional" "combat" "phase" "." added_combat_start_program

source_cast_body ::= program_sentence | source_cast_counter_unless_sentence | cast_subject_copy_counter_kinds | cast_subject_copy_history_program | cast_event_copy_it | cast_subject_copy_times

/* A single player's draft supplies the card and the player who may cast it.
   Keeping both instructions together proves the producer for the reference. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:@drafted_result(Operation::DraftFromSpellbook{actor:One($draft_cast_target), spellbook:@card_name, times:Constant(1)})}, Optional{decider:Target{slot:@last_slot, index:0}, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(Target{slot:@last_slot, index:0}), action:$draft_cast_action, cards:One(Result{result:@prior, phase:After, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}]} */
draft_target_cast_program ::= draft_cast_target "drafts" "a" "card" "from" self_named "'s" "spellbook" "." "they" "may" draft_cast_action "that" "card" "without" "paying" "its" "mana" "cost"

draft_cast_target ::= target_opponent | target_player | draft_cast_other_player

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OthersThan(AbilityController)}), index:0} */
draft_cast_other_player ::= "target" "player" "other" "than" "you"

draft_cast_action ::= draft_cast_verb | draft_play_verb

/* @sem CardPlayAction::CastSpell */
draft_cast_verb ::= "cast"

/* @sem CardPlayAction::Either */
draft_play_verb ::= "play"

/* The event subject supplies X to the paired sacrifice receipt program. */
/* @sem Ability::Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:$repeat_cast_header, limits:TriggerLimits{}, announcement:@announcement, body:$sacrifice_entry_counters_program})} */
source_cast_sacrifice_entry ::= repeat_cast_header "," sacrifice_entry_counters_program "."

/* @sem Ability::OpeningHand{announcement:@announcement, body:Program{instructions:[If{condition:PlayerState{player:AbilityController, state:CouldMulligan}, then:$opening_optional_exile_draw, otherwise:Program{}}]}} */
opening_mulligan_optional_exile ::= "any" "time" "you" "could" "mulligan" "and" "this" "card" "is" "in" "your" "hand" "," opening_optional_exile_draw "."

/* @sem Ability::Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:$cast_source_from_hand_header, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})} */
source_cast_from_hand_trigger ::= cast_source_from_hand_header "," program_sentence

/* @sem EventSpec::Spell{event:Cast, players:One(PlayerRef::AbilityController), spells:SameObject(ObjectRef::Source)} */
repeat_cast_plain ::= "when" "you" "cast" "this" "spell"

/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:AllOf([SameObject(Source), Not(Cast{from:Shared(Exile)})])} */
repeat_cast_outside_exile ::= "when" "you" "cast" "this" "spell" "from" "anywhere" "other" "than" "exile"

/* A continuation follows the bounded exile-and-grant sequence. */
/* @sem Instruction::[...$exile_event_subject_suspend, ...$instructions] */
instructions_exile_suspend_then ::= exile_event_subject_suspend "." "then" instructions

/* Prefer the source's separate follow-up paragraphs after the optional target clause. */
/* @prefer always */
/* @sem Instruction::[...$clause_except_optional_target_keyword, ...$instructions, ...$instructions_2] */
instructions_except_target_paragraphs ::= clause_except_optional_target_keyword "." NEWLINE instructions "." NEWLINE instructions

/* @sem Instruction::[...$chosen_player_hand_restriction, ...$instructions] */
chosen_player_hand_restriction_more ::= chosen_player_hand_restriction "." instructions

/* The reveal payment and its conditional continuation retain the same receipt. */
/* @sem Ability::OpeningHand{announcement:@announcement, body:_{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:Reveal{objects:One(Source)}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:_{instructions:$opening_reveal_continuation}, otherwise:_{}}]}} */
opening_reveal_conditional ::= "you" "may" "reveal" "this" "card" "from" "your" "opening" "hand" "." "if" "you" "do" "," opening_reveal_continuation "."

opening_reveal_continuation ::= first_opponent_spell_trigger

/* Each opponent gets a separate one-shot trigger, so its first spell is independent. */
/* @sem Instruction::[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:_{instructions:[Effect{result:@next, operation:CreateTrigger{event:Spell{event:Cast, players:One(Bound(0)), spells:Any}, duration:Indefinite, announcement:@announcement, body:_{instructions:$first_spell_consequence}, once:true}}]}}] */
first_opponent_spell_trigger ::= "when" "each" "opponent" "casts" "their" "first" "spell" "of" "the" "game" "," first_spell_consequence

/* The X definition and its dependent continuation share one instruction scope. */
/* @sem Instruction::[...$clause_captured_exile_cast_reduction, ...$clause_top_exile_cast_permission] */
instructions_captured_cost_exile ::= clause_captured_exile_cast_reduction "." clause_top_exile_cast_permission

/* The activation holder supplies the power used in its own cost reduction. */
/* @sem ActivationLimits::ActivationLimits{sorcery:true, modifiers:[ActivationRule(Cost{modifier:Reduce{reductions:[_{amount:ObjectProperty{object:Source, property:Power, information:CurrentOrLastKnown}}], spill_into_generic:true}})]} */
limit_holder_power_reduction_sorcery ::= "this" "ability" "costs" "{" "X" "}" "less" "to" "activate" "," "where" "X" "is" "this" "creature's" "power" "." "activate" "only" "as" "a" "sorcery"

/* The creation and delayed sacrifice share one result across the loop. The
   attacked player is excluded, and each copy attacks the bound opponent. */
/* @sem Ability::Triggered{event:$attack_combat_copies_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$attack_other_combat_copies}} */
triggered_attack_other_combat_copies ::= attack_combat_copies_event "," attack_other_combat_copies "."

/* @sem EventSpec::Attack{attackers:$event_named, defenders:Players(All)} */
attack_combat_copies_event ::= "whenever" event_named "attacks" "a" "player"

/* @sem Instruction::[ForEachPlayer{players:Intersection([OthersThan(EventSubject), OpponentsOf(AbilityController)]), binding:0, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$attack_combat_copy_token], entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{player:Bound(0)}]}}}]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, expires:EndOfCombat, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Created(@back(3))})}]}}}] */
attack_other_combat_copies ::= "for" "each" "other" "opponent" "," "create" attack_combat_copy_token "." "sacrifice" "those" "tokens" "at" "end" "of" "combat"

attack_combat_copy_token ::= attack_combat_copy_one | attack_combat_copy_many

/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$self_ref_named, exceptions:[CopyException::RemoveSupertypes([Legendary])]}} */
attack_combat_copy_one ::= "a" "token" "that's" "a" "copy" "of" self_ref_named "tapped" "and" "attacking" "that" "player" "," "except" "it" "isn't" "legendary"

/* @sem TokenSpec::TokenSpec{amount:$number, words:CreatingEffect, recipe:Copy{object:$self_ref_named, exceptions:[CopyException::RemoveSupertypes([Legendary])]}} */
attack_combat_copy_many ::= number "tokens" "that" "are" "copies" "of" self_ref_named "tapped" "and" "attacking" "that" "player" "," "except" "they" "aren't" "legendary"

/* Opening-hand actions can be conditioned on a player state and followed by
   an instruction that applies only when the player chose the action. */
/* @sem Ability::OpeningHand{announcement:@announcement, body:_{instructions:[If{condition:$opening_player_condition, then:_{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:$opening_counter_begin}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:_{instructions:$opening_exile_followup}, otherwise:_{}}]}, otherwise:_{}}]}} */
opening_hand_conditional_begin ::= "if" "this" "card" "is" "in" "your" "opening" "hand" "and" opening_player_condition "," "you" "may" opening_counter_begin "." "if" "you" "do" "," opening_exile_followup "."

/* Each option contains one immediate use of the cast count; no action can
   intervene between evaluating that count and its only use in the option. */
/* @sem ModeSelection::@where(ModeSelection::ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$cast_count_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}}, $value_spells_you_cast) */
choose_single_action_cast_count ::= "choose" number_words "." "x" "is" value_spells_you_cast "." NEWLINE cast_count_modes

/* @sem Mode::[$cast_count_mode] */
cast_count_modes_one ::= cast_count_mode

/* @sem Mode::[$cast_count_mode, ...$cast_count_modes] */
cast_count_modes_more ::= cast_count_mode NEWLINE cast_count_modes

cast_count_modes ::= cast_count_modes_one | cast_count_modes_more

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$cast_count_action}]}, weight:1}) */
cast_count_mode ::= "•" cast_count_action "."

cast_count_action ::= cast_count_scry | cast_count_damage | cast_count_life

/* @sem Operation::Scry{players:One(AbilityController), amount:$number_x} */
cast_count_scry ::= "scry" number_x

/* @sem Operation::DealDamage{source:Source, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$noun_atomic}), index:0})), amount:$number_x, preventable:true} */
cast_count_damage ::= SELF_NAME "deals" number_x "damage" "to" "target" noun_atomic

/* @sem Operation::GainLife{players:One(AbilityController), amount:$number_x} */
cast_count_life ::= "you" "gain" number_x "life"

/* The available modes exclude those chosen in the controller’s last combat. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Expr::Constant(1), maximum:Expr::Constant(1)}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Unchosen(LastCombat(AbilityController)), targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_one_unchosen_last_combat ::= "choose" "one" "that" "wasn't" "chosen" "during" "your" "last" "combat" "—" NEWLINE modes

/* @sem Vec<Instruction>::@then_sequence($clause_before_then, $instructions_optional_top_reveal_move) */
instructions_then_optional_top_reveal ::= clause_before_then "," "then" instructions_optional_top_reveal_move

/* Each selected mode independently announces targets; the selection requires distinct players. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:@length($distinct_player_modes)}, options:$distinct_player_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:Distinct, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_distinct_player_modes ::= "choose" "one" "or" "more" "." "each" "mode" "must" "target" "a" "different" "player" "." NEWLINE distinct_player_modes

/* @sem Mode::[$mode_target_opponent_program] */
distinct_player_modes_one ::= mode_target_opponent_program

/* @sem Mode::[$mode_target_opponent_program, ...$distinct_player_modes] */
distinct_player_modes_more ::= mode_target_opponent_program NEWLINE distinct_player_modes

distinct_player_modes ::= distinct_player_modes_one | distinct_player_modes_more

/* @sem @scope(Mode::Mode{announcement:@announcement, body:$target_opponent_mode_program, weight:1}) */
mode_target_opponent_program ::= "•" target_opponent_mode_program "."

/* The count refers to the explicitly named spell, and each option remains scoped. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(0), maximum:ModesChosen($object_ref)}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_up_to_modes_chosen ::= "choose" "up" "to" "X" "," "where" "X" "is" "the" "number" "of" "times" "you" "chose" "a" "mode" "for" object_ref "—" NEWLINE modes

/* A casting restriction with a disjunction of independently described windows. */
/* @sem Ability::Casting(Require($casting_timing_choice)) */
casting_only_timing_choice ::= "cast" "this" "spell" "only" casting_timing_choice "."

/* The paired clause proves that the single casting sacrifice is the object
   whose before-state supplies the mana quantity. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost::Cost{parts:[$casting_creature_sacrifice]}, repetition:Once}), Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$casting_sacrifice_mana}]}}] */
card_casting_sacrifice_mana ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," casting_creature_sacrifice "." NEWLINE casting_sacrifice_mana "."

/* @sem CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:Exactly(Expr::Constant(1))} */
casting_creature_sacrifice ::= "sacrifice" "a" "creature"

/* @sem Operation::AddMana{players:One(AbilityController), mana:Repeat{amount:$casting_sacrifice_mana_value, production:$mana_unit_combination, choice:EachUnit}} */
casting_sacrifice_mana ::= "add" "X" mana_unit_combination "," "where" "X" "is" casting_sacrifice_mana_value

/* @sem ManaProduction::ChooseOne([$mana_production, $mana_production_2]) */
mana_unit_combination ::= "mana" "in" "any" "combination" "of" mana_production "and" "/" "or" mana_production

/* Only the enclosing paired casting production can use this cost receipt. */
/* @sem Expr::ObjectProperty{object:Query{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown} */
casting_sacrifice_mana_value ::= "the" "sacrificed" "creature's" "mana" "value"

/* The producer and consumer share one receipt, including on inverse printing. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase})}}] */
shared_mill_life ::= "mill" card_count "." "you" "gain" "1" "life" "for" "each" filter_phrase "card" "milled" "this" "way"

/* @sem Instruction::[Effect{result:@mark, operation:$exile_objects}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase})}}] */
shared_exile_life ::= exile_objects "." "you" "gain" "1" "life" "for" "each" filter_phrase "card" "exiled" "this" "way"

/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@mark, operation:DrawUpTo{players:One(Bound(0)), amount:$value}}]}}, Effect{result:@next, operation:GainLife{players:All, amount:Multiply([$value_3, Subtract([$value_2, CountObjects(MovedBy{result:@marked, phase:After, player:Acting})])])}}] */
shared_draw_shortfall_life ::= "each" "player" "may" "draw" "up" "to" value "cards" "." "for" "each" "card" "less" "than" value "a" "player" "draws" "this" "way" "," "that" "player" "gains" value "life"

/* This card-level composition proves the one creature sacrifice at casting
   component zero before a modal option refers to its pre-payment object. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:Exactly(Constant(1))}]}, repetition:Once}), Spell{announcement:Announcement{modes:$casting_sacrifice_modes}, body:Program{}}] */
card_cast_sacrifice_modal ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "sacrifice" "a" "creature" "." NEWLINE casting_sacrifice_modes

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(2)}, options:[$casting_sacrifice_return_mode, $mode], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
casting_sacrifice_modes ::= "choose" "one" "or" "both" "—" NEWLINE casting_sacrifice_return_mode NEWLINE mode

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[If{condition:$casting_sacrifice_comparison, then:Program{instructions:[Effect{result:@next, operation:Move{objects:One($target_card_your_graveyard), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}]}, otherwise:Program{}}]}, weight:1}) */
casting_sacrifice_return_mode ::= "•" "return" target_card_your_graveyard "to" "the" "battlefield" "if" casting_sacrifice_comparison "."

/* The second sentence refers to the source just named as the counter recipient. */
/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Source)), kind:$counter_kind, amount:Constant(1)}]}}, If{condition:$condition_source_exploited_event, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}]}, otherwise:Program{}}] */
instructions_source_counter_conditional_keyword ::= "put" "a" counter_kind "counter" "on" "this" "creature" "." "it" "gains" keyword_name duration "if" condition_source_exploited_event

/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Source)), kind:$counter_kind, amount:$number}]}}, If{condition:$condition_source_exploited_event, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}]}, otherwise:Program{}}] */
instructions_source_counters_conditional_keyword ::= "put" number counter_kind "counters" "on" "this" "creature" "." "it" "gains" keyword_name duration "if" condition_source_exploited_event

/* Preserve the player's upkeep wording for a random hand observation. */
/* @prefer always */
/* @sem Ability::Triggered{event:Turn{point:UpkeepBegins, players:All}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence_random_hand_type_branch} */
triggered_each_player_upkeep_random_hand_branch ::= "at" "the" "beginning" "of" "each" "player's" "upkeep" "," program_sentence_random_hand_type_branch

/* The producer is typed as a counter removal; the captured value belongs to that receipt. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$remove_all_counters_any_kind}, Effect{result:@mark, operation:BindValue{value:CountersRemoved(@prior)}}, Effect{result:@next, operation:$captured_x_action}, Effect{result:@next, operation:$captured_x_action_2}, Effect{result:@next, operation:$captured_x_action_3}]} */
program_removed_counters_captured_three ::= remove_all_counters_any_kind "." captured_x_action "," captured_x_action "," "and" captured_x_action "," "where" "X" "is" "the" "number" "of" "counters" "removed" "this" "way"

/* @sem Operation::LoseLife{players:$players_singular, amount:BoundValue(@marked)} */
captured_x_player_loses ::= players_singular "loses" "X" "life"

/* @sem Operation::GainLife{players:One(AbilityController), amount:BoundValue(@marked)} */
captured_x_you_gain ::= "you" "gain" "X" "life"

/* @sem Operation::CreatePerpetualEffect{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), count:Constant(1), from:Top}, changes:[Pump{power:BoundValue(@marked), toughness:BoundValue(@marked)}]} */
captured_x_topmost_perpetual ::= "the" "topmost" filter_phrase "card" "in" "your" "library" "perpetually" "gets" "+" "X" "/" "+" "X"

/* Both the lifetime limit and the condition constrain the activation. */
/* @sem ActivationLimits::ActivationLimits{once:true, condition:$condition} */
limit_once_ever_condition ::= "activate" "only" "once" "and" "only" "if" condition

/* The selecting opponent remains the referent within each scoped mode. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$opponent_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:OneOf(OpponentsOf(AbilityController)), method:PlayerChoice}} */
choose_opponent_number ::= "an" "opponent" "chooses" number_words "—" NEWLINE opponent_modes

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:$chooser_destroy_draw}, weight:1}) */
mode_chooser_destroy_draw ::= "•" chooser_destroy_draw "."

/* @sem Mode::[$opponent_mode] */
opponent_modes_one ::= opponent_mode

/* @sem Mode::[$opponent_mode, ...$opponent_modes] */
opponent_modes_more ::= opponent_mode NEWLINE opponent_modes

opponent_modes ::= opponent_modes_one | opponent_modes_more

opponent_mode ::= mode_chooser_destroy_draw | opponent_mode_you_draw | opponent_mode_counter_pair | mode

/* @prefer always */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}]}, weight:1}) */
opponent_mode_you_draw ::= "•" "you" "draw" card_count "."

/* A turn trigger may announce modes while retaining its intervening condition. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:$condition, limits:TriggerLimits{}, announcement:Announcement{modes:$conditional_turn_mode_selection}, body:Program{}} */
triggered_turn_if_modal ::= "at" turn_event "," "if" condition "," conditional_turn_mode_selection

/* Two independently stated controller actions in a mode. */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::AbilityController), $verb_operation_base)}, Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::AbilityController), $verb_operation_base_2)}]}, weight:1}) */
/* @prefer always */
mode_you_and_you ::= "•" "you" verb_operation_base "and" "you" verb_operation_base "."

/* Explicit controller subjects are available within conditional turn modes. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$conditional_turn_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
conditional_turn_explicit_selection ::= "choose" number_words ("—" | ".") NEWLINE conditional_turn_modes

conditional_turn_mode_selection ::= conditional_turn_explicit_selection | mode_selection

conditional_turn_modes ::= conditional_turn_modes_one | conditional_turn_modes_more

/* @sem Mode::[$conditional_turn_mode] */
conditional_turn_modes_one ::= conditional_turn_mode

/* @sem Mode::[$conditional_turn_mode, ...$conditional_turn_modes] */
conditional_turn_modes_more ::= conditional_turn_mode NEWLINE conditional_turn_modes

conditional_turn_mode ::= mode_you_and_you | mode

/* Named entry pairs with the per-opponent damage clause without losing its announcement. */
/* @prefer always */
/* @sem Ability::Triggered{event:$named_entry_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$clause_damage_each_opponent_target}} */
