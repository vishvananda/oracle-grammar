/* @prefer always */
mode_friends_history ::= "•" "friends" "—" clause_you_gain_own_history "."

/* Conditional damage alternatives share the same target and cast-time control test. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_phrase}), index:0})), amount:$number_2, preventable:true}}]}, weight:1, requires:Controls{player:AbilityController, filter:$filter_phrase_2, minimum:1}}), @scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_phrase}), index:0})), amount:$number, preventable:true}}]}, weight:1, requires:Not(Controls{player:AbilityController, filter:$filter_phrase_2, minimum:1})})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied} */
cast_control_damage_raised ::= SELF_NAME "deals" number "damage" "to" "target" filter_phrase "." "if" "you" "controlled" "a" filter_phrase "as" "you" "cast" "this" "spell" "," "it" "deals" number "damage" "instead" "."

/* @prefer always */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$quality_unscoped, $noun_creature])}), index:0})), amount:$number_2, preventable:true}}]}, weight:1, requires:Controls{player:AbilityController, filter:$filter_phrase, minimum:1}}), @scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$quality_unscoped, $noun_creature])}), index:0})), amount:$number, preventable:true}}]}, weight:1, requires:Not(Controls{player:AbilityController, filter:$filter_phrase, minimum:1})})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied} */
cast_control_damage_postposed ::= SELF_NAME "deals" number "damage" "to" "target" quality_unscoped noun_creature "." SELF_NAME "deals" number "damage" "to" "that" "creature" "instead" "if" "you" "controlled" "a" filter_phrase "as" "you" "cast" "this" "spell" "."

/* These spell frames establish the first target before the shared damage phrase. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$opponent_target_power_damage}]}} */
spell_opponent_target_damage ::= opponent_target_power_damage "."

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$opponent_target_power_damage}, ...$instructions]}} */
spell_opponent_target_damage_more ::= opponent_target_power_damage "." instructions "."

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$opponent_population_mutual_damage}} */
spell_opponent_population_damage ::= opponent_population_mutual_damage "."

/* Bind the tested before-state to this single casting sacrifice. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost::Cost{parts:[$cost_sacrifice]}, repetition:Once}), Spell{announcement:@announcement, body:$casting_sacrifice_followup}] */
line_casting_sacrifice_followup ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," cost_sacrifice "." NEWLINE casting_sacrifice_followup

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$destroy}, If{condition:$casting_sacrificed_filter, then:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}]}, otherwise:Program{}}]} */
casting_sacrifice_followup ::= destroy "." "if" casting_sacrificed_filter "," "draw" card_count "."

/* @sem Condition::Compare{left:CountObjects(Matching{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Performed, phase:Before}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}} */
casting_sacrificed_filter ::= "the" "sacrificed" "permanent" "was" "a" filter_phrase

/* These card-level pairs prove that the measured singleton is the corresponding
   casting payment, including in the print inverse. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost::Cost{parts:[$cost_reveal_filtered_from_hand]}, repetition:Once}), Spell{announcement:@announcement, body:$casting_revealed_life_program}] */
card_casting_reveal_life ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," cost_reveal_filtered_from_hand "." NEWLINE casting_revealed_life_program "."

/* @sem Ability::[Casting(AdditionalCost{cost:Cost::Cost{parts:[$cost_sacrifice]}, repetition:Once}), Spell{announcement:@announcement, body:$casting_sacrificed_life_program}] */
card_casting_sacrifice_life ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," cost_sacrifice "." NEWLINE casting_sacrificed_life_program "."

/* @sem Expr::ObjectProperty{object:Query{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Inputs, phase:Before}, index:0}, property:$receipt_stat, information:CurrentOrLastKnown} */
casting_single_payment_property ::= receipt_stat

/* @sem Program::Program{instructions:[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:$casting_single_payment_property}}]} */
casting_revealed_life_program ::= "you" "gain" "life" "equal" "to" "the" "revealed" "card's" casting_single_payment_property

/* @sem Program::Program{instructions:[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:$casting_single_payment_property}}, ...$instructions]} */
casting_sacrificed_life_program ::= "you" "gain" "life" "equal" "to" "the" "sacrificed" "permanent's" casting_single_payment_property "." instructions

/* The condition supplies the counter kind removed by the anaphoric instruction. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:ObjectMatches{object:$self_explicit_ref, filter:Counters{kind:$counter_kind, comparison:GreaterOrEqual, value:$value}}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($self_explicit_ref)), kind:$counter_kind, amount:All}]}}, Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountersRemoved(@prior), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Created(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]}}}]}} */
triggered_counter_removal_tokens ::= "at" turn_event "," "if" self_explicit_ref "has" value "or" "more" counter_kind "counters" "on" "it" "," "remove" "all" "of" "them" "from" "it" "and" "create" "that" "many" token_recipe "." "exile" "them" "at" "the" "beginning" "of" "the" "next" "end" "step" "."

/* @sem ActivationLimits::ActivationLimits{condition:Window(BeforeAttackersDeclared)} */
limit_before_attackers ::= "activate" "only" "before" "attackers" "are" "declared"

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Expr::Constant(1), maximum:Expr::Constant(1)}, options:$unchosen_modes, rules:ModeRules{repetition:OnceEach, availability:Unchosen(ThisTurn), targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_one_unchosen_turn_period ::= "choose" "one" "that" "hasn't" "been" "chosen" "this" "turn" "." NEWLINE unchosen_modes

/* A final scry option composes with any preceding pair of modes. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Expr::Constant(1), maximum:Expr::Constant(1)}, options:[$mode, $mode_2, $modal_scry], rules:ModeRules{repetition:OnceEach, availability:Unchosen(ThisTurn), targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
/* @prefer always */
choose_one_unchosen_turn_final_scry ::= "choose" "one" "that" "hasn't" "been" "chosen" "this" "turn" "." NEWLINE mode NEWLINE mode NEWLINE modal_scry

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:0, operation:Operation::Scry{players:One(AbilityController), amount:$number}}]}, weight:1}) */
/* @prefer always */
modal_scry ::= "•" "scry" number "."

/* Capture one definition before three sequential actions sharing its value. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:BindValue{value:$captured_x_definition}}, Effect{result:@next, operation:$captured_x_action}, Effect{result:@next, operation:$captured_x_action_2}, Effect{result:@next, operation:$captured_x_action_3}]} */
program_captured_x_three ::= captured_x_action "," captured_x_action "," "and" captured_x_action "," "where" "X" "is" captured_x_definition

/* @sem Expr::CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::Property{property:ColorCount, test:$color_pair_color_test})}, property:ColorPairs} */
captured_x_color_pairs ::= "the" "number" "of" "different" "color" "pairs" "among" filter_plural "that" "are" color_pair_color_test "colors"

/* @sem Operation::DealDamage{source:EventSubject, recipients:$recipients, amount:BoundValue(@marked), preventable:true} */
captured_x_it_damage ::= "it" "deals" "X" "damage" "to" recipients

/* @sem Operation::Draw{players:One($target_player), amount:BoundValue(@marked)} */
captured_x_target_draw ::= target_player "draws" "X" "cards"

color_pair_color_test ::= color_pair_exactly | color_pair_more_than

/* @sem NumberTest::Compare{comparison:Equal, value:$number} */
color_pair_exactly ::= "exactly" number

/* @sem NumberTest::Compare{comparison:Greater, value:$number} */
color_pair_more_than ::= "more" "than" number

/* @sem ActivationLimits::ActivationLimits{condition:PlayerIsActive(AbilityController)} */
limit_only_your_turn ::= "activate" "only" "during" "your" "turn"

/* The event's affected object receives an independently scoped graveyard ability. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:$affected, changes:[GrantAbility($graveyard_exile_copy_activation)]}}]} */
perpetual_event_graveyard_activation_program ::= affected "perpetually" "gains" '"' graveyard_exile_copy_activation '"'

/* Both options retain separate target announcements and require different players. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(2)}, options:[$distinct_player_mode, $distinct_player_mode_2], rules:ModeRules{repetition:OnceEach, availability:Any, targets:Distinct, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_one_or_both_distinct_players ::= "choose" "one" "or" "both" "." "each" "mode" "must" "target" "a" "different" "player" "." NEWLINE distinct_player_mode NEWLINE distinct_player_mode

distinct_player_mode ::= mode_target_opponent_program | mode_target_player_program

/* @sem @scope(Mode::Mode{announcement:@announcement, body:$target_player_mode_program, weight:1}) */
mode_target_player_program ::= "•" target_player_mode_program "."

/* The anaphoric quantity is the same controlled subtype population tested by
   the intervening condition, evaluated again when the ability resolves. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$subtype_plural, ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$subtype_plural, ControlledBy(One(AbilityController))])}), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}, ...$clause_created_gain]}} */
triggered_controlled_count_token_grant ::= "at" turn_event "," "if" "you" "control" number "or" "more" subtype_plural "," "create" "that" "many" token_recipe "." clause_created_gain "."

/* The result reference is confined to the amass producer and its immediate consumer. */
/* @sem @where(Program::Program{instructions:[Effect{result:@mark, operation:$amass_action}, ...$instructions]}, $amassed_army_property) */
program_amass_result_where ::= amass_action "," "then" instructions "," "where" "X" "is" amassed_army_property

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:$amass_action}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:@where($program_plain, $amassed_army_property)})}]} */
program_amass_reflexive_where ::= amass_action "." "when" "you" "do" "," program_plain "," "where" "X" "is" amassed_army_property

/* The comparison and the reflexive body share this exact amass receipt. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:$amass_action}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$amass_control_callback})}]} */
program_amass_reflexive_control ::= amass_action "." "when" "you" "do" "," amass_control_callback

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($amass_compared_target)), changes:[SetController(AbilityController)], duration:$duration, evaluation:Snapshot}}, ...$instructions]} */
amass_control_callback ::= duration "," "gain" "control" "of" amass_compared_target "." instructions

/* Keep the separately supported captured-value reading within the callback. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:$amass_action}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:@where_snapshot($program_plain, $amassed_army_property)})}]} */
program_amass_reflexive_snapshot ::= amass_action "." "when" "you" "do" "," program_plain "," "where" "X" "is" amassed_army_property

/* Keep this spelling preferred only inside a mode, preserving other pump defaults. */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$continuous_negative_population_pump}]}, weight:1}) */
/* @prefer always */
mode_negative_population_pump ::= "•" continuous_negative_population_pump "."

/* Two independently scoped player-targeting modes, with different players when both are chosen. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(2)}, options:[$mode_target_player, $mode_target_player_2], rules:ModeRules{repetition:OnceEach, availability:Any, targets:Distinct, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_both_distinct_player_modes ::= "choose" "one" "or" "both" "." "each" "mode" "must" "target" "a" "different" "player" "." NEWLINE mode_target_player NEWLINE mode_target_player

mode_target_player ::= mode_target_player_create | mode_target_player_other_counter

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0}), tokens:[$token_group], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, weight:1}) */
mode_target_player_create ::= "•" "target" "player" "creates" token_group "."

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), $noun, ControlledBy(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0}))])}), kind:$counter_kind, amount:Constant(1)}]}}]}, weight:1}) */
mode_target_player_other_counter ::= "•" "put" "a" counter_kind "counter" "on" "each" "other" noun "target" "player" "controls" "."

/* A shared transformation header distributes its target and effect to each mode. */
/* @sem Ability::Spell{announcement:Announcement{modes:ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:$shared_form_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}}}, body:Program{}} */
shared_form_modal_spell ::= "choose" "one" "." "until" "end" "of" "turn" "," "target" "creature" "you" "control" "has" "that" "base" "power" "and" "toughness" "," "becomes" "that" "creature" "type" "," "and" "gains" "that" "ability" "." NEWLINE shared_form_modes

shared_form_modes ::= shared_form_modes_one | shared_form_modes_more

/* @sem Mode::[$shared_form_mode] */
shared_form_modes_one ::= shared_form_mode

/* @sem Mode::[$shared_form_mode, ...$shared_form_modes] */
shared_form_modes_more ::= shared_form_mode NEWLINE shared_form_modes

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), index:0})), changes:[SetBasePowerToughness{power:$number_digits, toughness:$number_digits_2}, CreatureTypes{mode:Add, types:Listed($becomes_type_one)}, GrantKeyword($keyword_name)], duration:EndOfTurn, evaluation:Snapshot}}]}, weight:1}) */
shared_form_mode ::= "•" number_digits "/" number_digits becomes_type_one "with" keyword_name "."

/* Keep the source anaphor inside the clause that establishes the targeted ability. */
/* @sem Instruction::[Effect{result:@next, operation:Counter{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Ability, zones:[Stack]}), count:Exactly(Constant(1)), filter:AllOf([$counter_ability_kind, AbilityOf($counter_source_four_nouns)])}), index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(SourceOf(Target{slot:@last_slot, index:0}))), changes:[Rule(Prohibit(Activate(Any)))], duration:$this_duration, evaluation:LiveObjects}}] */
clause_counter_ability_source_activation_ban ::= "counter" "target" counter_ability_kind "ability" "from" counter_source_four_nouns "." "that" "permanent's" "activated" "abilities" "can't" "be" "activated" this_duration

/* The singleton reveal cost and its consumer must be printed together. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost::Cost{parts:[$cost_reveal_filtered_from_hand]}, repetition:Once}), Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$casting_revealed_exile}]}}] */
card_casting_reveal_compared_exile ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," cost_reveal_filtered_from_hand "." NEWLINE casting_revealed_exile "."

/* The first action and the additional phase remain separate ordered effects. */
/* @sem Instruction::[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::AdditionalPhase{phases:Combat}}}] */
instructions_before_additional_combat ::= operation "." "after" "this" "phase" "," "there" "is" "an" "additional" "combat" "phase"

/* Any subset of the printed modes may be selected. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(0), maximum:@length($any_number_modes)}, options:$any_number_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_any_number ::= "choose" "any" "number" "—" NEWLINE any_number_modes

any_number_modes ::= any_number_modes_one | any_number_modes_more

/* @sem Mode::[$any_number_mode] */
any_number_modes_one ::= any_number_mode

/* @sem Mode::[$any_number_mode, ...$any_number_modes] */
any_number_modes_more ::= any_number_mode NEWLINE any_number_modes

any_number_mode ::= any_number_sacrifice_choice | mode

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@apply($players_singular, $sacrifice_choice_third_plain)}]}, weight:1}) */
/* @prefer always */
any_number_sacrifice_choice ::= "•" players_singular sacrifice_choice_third_plain "."

/* A following population grant is a second instruction in the same paragraph. */
/* @prefer always */
/* @sem Instruction::[...$clause, Effect{result:@next, operation:$controlled_subtype_temporary_keyword}] */
instructions_controlled_subtype_grant ::= clause "." controlled_subtype_temporary_keyword

/* A chosen plural repeats the announced group's filter, not a new choice. */
/* @sem ObjectFilter::$plural */
chosen_plural_reference ::= "the" "chosen" plural

/* @sem SelectionConstraint::CommonProperty(Toughness) */
equal_target_toughness ::= "equal" "toughness"

/* @sem SelectionConstraint::CommonProperty(Powers) */
equal_target_power ::= "equal" "power"

/* @sem SelectionConstraint::CommonProperty(ManaValues) */
equal_target_mana_value ::= "equal" "mana" "value"

equal_target_property ::= equal_target_toughness | equal_target_power | equal_target_mana_value

/* The reference and the announced plural must name the same population. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:$plural_target_count_any, filter:@agree($plural, $chosen_plural_reference), constraints:[$equal_target_property]})), regeneration:true}}] */
instructions_destroy_common_target_group ::= "choose" plural_target_count_any "target" plural "with" equal_target_property "." "destroy" chosen_plural_reference

/* The producer and consumer share the immediately preceding amass receipt. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$amass_action}, Effect{result:@next, operation:$amassed_army_damage}]} */
/* @prefer always */
program_amass_army_damage ::= amass_action "," "then" amassed_army_damage

/* The choice announces one graveyard group; both following effects refer to it. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:$recipients, amount:Aggregate{objects:$chosen_graveyard_group, property:ManaValue, aggregation:Sum}, preventable:true}}, Effect{result:@next, operation:$put_chosen_group_battlefield}] */
instructions_chosen_graveyard_total_damage ::= chosen_graveyard_group "." object_ref "deals" "damage" "to" recipients "equal" "to" "the" "total" "mana" "value" "of" "those" "cards" "." put_chosen_group_battlefield

/* The casting payment is a single creature sacrifice; its performed before-state
   is the only receipt that the conditional branch describes. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:Exactly(Constant(1))}]}, repetition:Once}), Spell{announcement:@announcement, body:$casting_creature_legendary_alternative}] */
line_casting_creature_legendary_alternative ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "sacrifice" "a" "creature" "." NEWLINE casting_creature_legendary_alternative "."

/* @sem Program::Program{instructions:[If{condition:Compare{left:CountObjects(Matching{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Performed, phase:Before}, filter:Supertype(Legendary)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:$program_2, otherwise:$program}]} */
casting_creature_legendary_alternative ::= program "." "if" "the" "sacrificed" "creature" "was" "legendary" "," program "instead"

/* Each option repeats the same restriction on the activation's announced X. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{modifiers:[ActivationRule(XNotZero)]}, announcement:Announcement{modes:$nonzero_modal_selection}, body:Program{}} */
activated_repeated_nonzero_modal ::= cost ":" nonzero_modal_selection

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$nonzero_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
nonzero_modal_selection ::= "choose" number_words "—" NEWLINE nonzero_modes

nonzero_modes ::= nonzero_modes_one | nonzero_modes_more

/* @sem Mode::[$nonzero_mode] */
nonzero_modes_one ::= nonzero_mode

/* @sem Mode::[$nonzero_mode, ...$nonzero_modes] */
nonzero_modes_more ::= nonzero_mode NEWLINE nonzero_modes

/* @sem @scope(Mode::Mode{announcement:@announcement, body:$program_sentence, weight:1}) */
nonzero_mode ::= "•" program_sentence "x" "can't" "be" "0" "."

/* Each characteristic line is an independently scoped token-creation mode. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:$characteristic_token_modes, rules:ModeRules{repetition:OnceEach, availability:Unchosen(ThisTurn), targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_characteristic_tokens_unchosen_turn ::= "choose" "one" "that" "hasn't" "been" "chosen" "this" "turn" "." "create" "a" "creature" "token" "with" "those" "characteristics" "." NEWLINE characteristic_token_modes

/* @sem Mode::[$characteristic_token_mode] */
characteristic_token_modes_one ::= characteristic_token_mode

/* @sem Mode::[$characteristic_token_mode, ...$characteristic_token_modes] */
characteristic_token_modes_more ::= characteristic_token_mode NEWLINE characteristic_token_modes

characteristic_token_modes ::= characteristic_token_modes_one | characteristic_token_modes_more

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:$token_colors, card_types:[Creature], subtypes:$token_subtypes, power_toughness:[$token_stat, $token_stat_2], abilities:$token_abilities}}], entry:BattlefieldArrival{}}}]}, weight:1}) */
characteristic_token_mode ::= "•" token_stat "/" token_stat token_colors token_subtypes "with" token_abilities "."

/* Compose a captured control batch with subsequent player restrictions. */
/* @sem Instruction::[...$clause_control_creatures_untap_grant, $clause_restrict_attack_sacrifice_prior] */
instructions_control_restrictions ::= clause_control_creatures_untap_grant "." clause_restrict_attack_sacrifice_prior

/* An optional mana payment retains its payer and the current mana operands. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Mana($mana_symbols)]}, optional:true}}]} */
program_optional_mana_payment ::= "you" "may" "pay" mana_symbols

/* The explicit source condition supplies the pronoun in the animation. */
/* @sem Ability::Triggered{event:$event_opponent_life_at_most, intervening_if:$condition_this_permanent_is_an, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$source_becomes_typed_creature}]}} */
triggered_source_condition_animation ::= event_opponent_life_at_most "," "if" condition_this_permanent_is_an "," source_becomes_typed_creature "."

/* The enclosing pair proves the artifact is the singleton casting payment. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost{parts:[$casting_artifact_sacrifice]}, repetition:Once}), Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$casting_artifact_counter_placement}]}}] */
card_casting_artifact_counter_placement ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," casting_artifact_sacrifice "." NEWLINE casting_artifact_counter_placement "."

/* @sem CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Artifact)}, choose:Exactly(Constant(1))} */
casting_artifact_sacrifice ::= "sacrifice" "an" "artifact"

/* This operation is available only under the paired casting payment above. */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:$casting_single_payment_property}]} */
casting_artifact_counter_placement ::= "put" "X" counter_kind "counters" "on" affected "," "where" "X" "is" "the" "sacrificed" "artifact's" casting_single_payment_property

/* @prefer always */
/* The anaphor is scoped to an explicitly targeted creature. */
/* @sem Instruction::[...$creature_paid_copy_introduction, ...$creature_paid_copy] */
instructions_creature_then_paid_copy ::= creature_paid_copy_introduction "." "then" creature_paid_copy

creature_paid_copy_introduction ::= creature_optional_tap_or_untap | creature_return_to_hand

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:CardType(Creature)}), index:0} */
paid_copy_creature_target ::= "target" "creature"

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::TapOrUntap{object:$paid_copy_creature_target}}}]}}] */
creature_optional_tap_or_untap ::= "you" "may" "tap" "or" "untap" paid_copy_creature_target

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($paid_copy_creature_target), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
creature_return_to_hand ::= "return" paid_copy_creature_target "to" "its" "owner's" "hand"

/* A source-card discard trigger composes with an independently timed return. */
/* @sem Ability::Scoped{zones:[Battlefield, Graveyard, Hand, Library, Stack, Exile, Command, Ante], ability:@scope(Ability::Triggered{event:$repeat_card_opponent_discard, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$delayed_return_own_graveyard_counter}]}})} */
source_discard_delayed_return ::= "when" repeat_card_opponent_discard "," delayed_return_own_graveyard_counter "."

/* Separate instructions with the printed paragraph break. */
/* @sem Instruction::[...$three_grant_first, Effect{result:@next, operation:$controlled_three_subject_temporary_keyword}] */
instructions_controlled_three_grant ::= three_grant_first "." NEWLINE controlled_three_subject_temporary_keyword

three_grant_first ::= counter_each_target_clause | clause

trigger_condition ::= condition_referenced_player_monarch | condition | condition_event_subject_not_a_filter_pref | trigger_event_it_not_cast

/* @prefer always */
/* @sem $condition_event_subject_not_a_filter */
condition_event_subject_not_a_filter_pref ::= condition_event_subject_not_a_filter

/* @prefer always */
/* @sem Condition::ObjectMatches{object:EventSubject, filter:Not($filter_phrase)} */
condition_event_subject_not_a_filter ::= "it's" "not" "a" filter_phrase

/* The intervening linked-card condition supplies the antecedent and the move
   supplies the counted before-receipt; the damage source and recipients are independent. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:ObjectMatches{object:$linked_exile_card_source, filter:Property{property:ExiledCount, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:@zone_members(ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($linked_exile_card_source)}), destination:OwnersGraveyard(CardArrival{}), qualifiers:[]}}, Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:$recipients, amount:CountObjects(Transition{result:@prior, phase:Before}), preventable:true}}]}} */
triggered_linked_exile_move_damage ::= "at" turn_event "," "if" "there" "are" linked_exile_card_source "," "put" "them" "into" "their" "owner's" "graveyard" "," "then" object_ref "deals" "that" "much" "damage" "to" recipients "."

/* An optional equal-base-stat effect retains the controller as decider. */
/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:$have_equal_base_stats}]}}] */
clause_may_have_equal_base_stats ::= "you" "may" have_equal_base_stats

/* The two restrictions qualify the complete activated ability. */
/* @sem ActivationLimits::ActivationLimits{once:true, condition:PlayerIsActive(AbilityController)} */
limit_your_turn_once_ever ::= "activate" "only" "during" "your" "turn" "and" "only" "once"

/* The second sentence refers to the same explicitly named alternative cost. */
/* @sem Instruction::[If{condition:$condition_alternative_mana_paid, then:$program, otherwise:$program_2}] */
instructions_alternative_cost_branches ::= "if" condition_alternative_mana_paid "," program "." "if" "that" "cost" "wasn't" "paid" "," program

/* Both actions belong to the same opponent chosen for this instruction. */
/* @sem Instruction::[Effect{result:@next, operation:PlayersDo{players:OpponentsOf(AbilityController), any_one:true, body:[Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::Acting), $verb_operation_third)}]}, Program{instructions:@apply(PlayerSet::One(PlayerRef::Acting), $verbs_base)}]}}] */
clause_opponent_two_actions ::= "an" "opponent" verb_operation_third "and" "they" verbs_base

/* Both branches retain their own program and the tested object. */
/* @sem Program::Program{instructions:[If{condition:$past_combat_condition, then:$program_plain, otherwise:$program_plain_2}]} */
program_postfix_past_combat_otherwise ::= program_plain "if" past_combat_condition "." "otherwise" "," program_plain

/* A random range determines the number of cards drawn. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseAtRandom{kind:Number, options:[Comparison(GreaterOrEqual, $number), Comparison(LessOrEqual, $number_2)]}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:ChosenNumber}}] */
instructions_random_number_draw ::= "draw" "a" "number" "of" "cards" "chosen" "at" "random" "between" number "and" number

/* A preceding clause introduces the creature controlled by the payer. */
/* @sem Instruction::[Effect{result:@next, operation:$paid_copy_creature_prevention}, ...$creature_paid_copy] */
instructions_creature_paid_copy_after_clause ::= paid_copy_creature_prevention "." creature_paid_copy

/* @sem Operation::CreateReplacement{event:Damage(DamageEvent{source_kind:Permanent, sources:SameObject($paid_copy_creature_target), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
paid_copy_creature_prevention ::= "prevent" "all" "damage" paid_copy_creature_target "would" "deal" this_duration

/* @sem Instruction::[Effect{result:@next, operation:$paid_copy_permanent_return}, ...$permanent_paid_copy] */
instructions_permanent_then_paid_copy ::= paid_copy_permanent_return "." "then" permanent_paid_copy

/* @sem Operation::Move{objects:One($target_permanent), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
paid_copy_permanent_return ::= "return" target_permanent "to" "its" "owner's" "hand"

/* Keep the revealed top card, its move, and the subsequent property read in one scope. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:LoseLife{players:$players_singular, amount:ObjectProperty{object:Query{objects:Observed(@marked), index:0}, property:$stat, information:CurrentOrLastKnown}}}] */
reveal_top_hand_players_value_loss ::= "reveal" "the" "top" "card" "of" "your" "library" "and" "put" "that" "card" "into" "your" "hand" "." players_singular "loses" "life" "equal" "to" "its" stat

/* A named target remains the recipient of the later paid prevention action. */
/* @sem Instruction::[Effect{result:@next, operation:$prevent_any_target_amount}, Effect{result:@next, operation:$paid_target_prevention}] */
instructions_paid_target_prevention ::= prevent_any_target_amount "." paid_target_prevention

/* The trigger identifies the discarded card and the owner of its graveyard. */
/* @sem Ability::Triggered{event:$event_discard, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$discard_event_return_body}} */
triggered_own_discard_paid_return ::= "whenever" event_discard "," discard_event_return_body "."

/* @sem Ability::Triggered{event:$event_discard, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$discard_event_return_body}} */
triggered_when_own_discard_paid_return ::= "when" event_discard "," discard_event_return_body "."

discard_event_return_body ::= discard_event_paid_return | discard_event_required_return

/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[$discard_event_payment]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:$discard_event_move}]}, otherwise:Program{}}] */
discard_event_paid_return ::= "you" "may" discard_event_payment "." "if" "you" "do" "," discard_event_move

/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[$discard_event_payment]}, optional:false}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:$discard_event_move}]}, otherwise:Program{}}] */
discard_event_required_return ::= discard_event_payment "." "if" "you" "do" "," discard_event_move

discard_event_payment ::= cost_sacrifice_self | cost_sacrifice | cost_sacrifice_another | cost_life

/* @sem Operation::Move{objects:$discard_event_card_in_your_graveyard, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
discard_event_move ::= "return" discard_event_card_in_your_graveyard "to" "your" "hand"

/* Scope both anaphors to the removal receipt and the generated combat phase. */
/* @sem Instruction::[...$removed_creatures_untap, Effect{result:@next, operation:$additional_combat_phase}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:InSet(Recorded(@back(4)))}), changes:$removed_creatures_combat_rules, duration:ExtraCombat(@prior), evaluation:LiveObjects}}] */
instructions_removed_creatures_extra_combat ::= removed_creatures_untap "." additional_combat_phase "." removed_creatures_combat_rules

/* Sequence complete sentences without extending either conditional branch. */
/* @sem Instruction::[...$clause, ...$clause_closed, ...$instructions] */
instructions_sentence_sequence ::= clause "." clause_closed "." instructions

/* The history predicate is shared with linked play; each branch ends at a sentence boundary. */
/* @sem Vec<Instruction>::@returned_conditional([Instruction::If{condition:$linked_play_attacked_with, then:Program{instructions:$clause}, otherwise:Program{instructions:$conjoined}}]) */
instructions_attacked_otherwise ::= "if" linked_play_attacked_with "," clause "." "otherwise" "," conjoined

/* @sem ActivationLimits::ActivationLimits{modifiers:[Change::ActivationRule(AnyTimeOfInstant)]} */
limit_instant ::= "activate" "only" "as" "an" "instant"

/* Both instructions have independently editable quantities. */
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:$life_phrase}}] */
instructions_you_draw_and_lose ::= "you" "draw" card_count "and" "you" "lose" life_phrase

/* A closed condition and a following draw-and-life paragraph resolve in order. */
/* @prefer always */
/* @sem Ability::[Spell{announcement:@announcement, body:Program{instructions:[...$clause_if_source_bargained, ...$instructions_you_draw_and_lose]}}] */
line_conditional_draw_loss_paragraph ::= clause_if_source_bargained "." NEWLINE instructions_you_draw_and_lose "."

/* @sem Vec<Instruction>::@returned_conditional([@leading_if(Instruction::If{condition:$condition_this_spell_bargained, then:$then_condition_program, otherwise:Program{}})]) */
clause_if_source_bargained ::= "if" condition_this_spell_bargained "," then_condition_program

/* Return the holder, then attach its new incarnation to the previously mentioned object. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$delayed_graveyard_self_untapped}, Effect{result:@next, operation:Attach{attachments:One(Result{result:@prior, phase:After, index:0}), host:$that_noun}}]}}]} */
graveyard_self_return_attach ::= "you" "may" delayed_graveyard_self_untapped "," "then" "attach" "it" "to" that_noun "."

/* The created tokens and following action remain ordered within the list. */
/* @sem Vec<Instruction>::@then_sequence($serial_token_clause, $conjoined) */
serial_token_then ::= serial_token_clause "," "then" conjoined

/* @sem @apply(PlayerSet::One(PlayerRef::AbilityController), $serial_token_verb) */
serial_token_clause ::= "you" serial_token_verb

/* @sem Instruction::[Effect{result:@next, operation:$create_base}] */
serial_token_verb ::= create_base

/* The trigger proves that the crewed referent is this ability’s source. */
/* @sem Ability::Triggered{event:EventSpec::Object{event:Attacks, objects:$event_holder}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$source_crew_counter_action}, ...$instructions]}} */
source_attack_crew_counter_trigger ::= "whenever" event_holder "attacks" "," source_crew_counter_action "." instructions "."

/* The condition and the meld program share the named partner, so the chosen
   object and the exile receipt remain tied to the printed condition. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:AllOf([ObjectMatches{object:$object_ref, filter:AllOf([OwnedBy(One(AbilityController)), ControlledBy(One(AbilityController))])}, Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Name($referenced_card_name), OwnedBy(One(AbilityController)), ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}]), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Mana($mana_symbols)]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Name($referenced_card_name)])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Union([One($object_ref), Selected(@prior)]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Meld{objects:Transition{result:@prior, phase:After}, into:$referenced_card_name_2, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{}}]}} */
ability_optional_owned_named_meld ::= "at" turn_event "," "if" meld_owned_prefix object_ref "and" "a" filter_phrase "named" referenced_card_name "," "you" "may" "pay" mana_symbols "." "if" "you" "do" "," meld_exile_then referenced_card_name "."

/* A repeated controller-rule effect may precede an independent serial clause. */
/* @sem Instruction::[Effect{result:@next, operation:$continuous_repeated_controller_prohibitions}, ...$conjoined] */
repeated_controller_rules_and ::= continuous_repeated_controller_prohibitions "," "and" conjoined

/* The delayed action belongs to the extra turn just created by this instruction. */
/* @sem Instruction::[Effect{result:@mark, operation:$take_extra_turn}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:ExtraTurn(@marked), body:Program{instructions:$clause_you}}}] */
extra_turn_delayed_end_instructions ::= take_extra_turn "." "at" "the" "beginning" "of" "that" "turn's" "end" "step" "," clause_you

/* Pair the singleton reveal payment with the consumer of its casting receipt. */
/* @prefer always */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost::Cost{parts:[$cost_reveal_filtered_from_hand]}, repetition:Once}), Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$casting_revealed_property_damage}]}}] */
card_casting_reveal_property_damage ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," cost_reveal_filtered_from_hand "." NEWLINE casting_revealed_property_damage "."

/* The property is the current operand of the proved singleton payment. */
/* @sem Operation::DealDamage{source:$object_ref, recipients:Objects($affected), amount:$casting_single_payment_property, preventable:true} */
casting_revealed_property_damage ::= object_ref "deals" "X" "damage" "to" affected "," "where" "X" "is" "the" "revealed" "card's" casting_single_payment_property

/* This phrase starts a fresh spell announcement, so its relative target slots are local. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$clause_counters_three_distinct_targets}} */
spell_counters_three_distinct_targets ::= clause_counters_three_distinct_targets "."

/* The intervening predicate tests the same object as the event. */
/* @sem Condition::ObjectMatches{object:@it, filter:$object_condition_not_cast} */
trigger_event_it_not_cast ::= "it" object_condition_not_cast

/* These follow-ups are scoped to the explicitly announced group. */
/* @sem Instruction::[...$chosen_target_untap, ...$chosen_target_followups] */
chosen_target_untap_more ::= chosen_target_untap "." chosen_target_followups

/* @sem Instruction::[Effect{result:@next, operation:SetTapped{objects:$chosen_creature_targets}}] */
chosen_target_untap ::= "choose" chosen_creature_targets "." "untap" "them"

chosen_target_followups ::= chosen_target_followup | chosen_target_followups_more

/* @sem Instruction::[...$chosen_target_followup, ...$chosen_target_followups] */
chosen_target_followups_more ::= chosen_target_followup "." chosen_target_followups

chosen_target_followup ::= chosen_target_counters | chosen_target_grant | chosen_target_combat

/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Targets(@last_slot)), kind:$counter_kind, amount:$value}]}}] */
chosen_target_counters ::= "put" value counter_kind "counters" "on" "each" "of" "them"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Targets(@last_slot)), changes:$static_changes, duration:$duration, evaluation:Snapshot}}] */
chosen_target_grant ::= "they" static_changes duration

/* @sem Instruction::[Effect{result:@next, operation:$chosen_target_extra_combat}, Effect{result:@next, operation:ChangeCombat{change:OnlyAttackers{objects:Targets(@last_slot), during:@prior}}}] */
chosen_target_combat ::= chosen_target_extra_combat "." "only" "the" "chosen" "creatures" "can" "attack" "during" "that" "combat" "phase"

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::AdditionalPhase{phases:Combat}} */
chosen_target_extra_combat ::= "after" "this" "main" "phase" "," "there" "is" "an" "additional" "combat" "phase"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:$plural_target_count_any, filter:CardType(Creature)})) */
chosen_creature_targets ::= plural_target_count_any "target" "creatures"

/* A sole damage instruction introduces its first target relative to its source. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$deal_damage_source_other}]}} */
activated_source_other_damage ::= cost ":" deal_damage_source_other "."

/* The restriction applies to the activation; the animation is a reusable program. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:$limit_x_nonzero, announcement:@announcement, body:$retained_land_animation_sentence} */
activated_nonzero_retained_land ::= cost ":" retained_land_animation_sentence limit_x_nonzero "."

/* Weighted mode symbols price each independently scoped mode. */
/* @sem Ability::Spell{announcement:Announcement{modes:ModeSelection{count:ModeCount{minimum:Constant(0), maximum:$number_words}, options:[$weighted_mode_one, $weighted_mode_two, $weighted_mode_three], rules:ModeRules{repetition:MayRepeat, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}, budget:$number_words}}, body:Program{}} */
weighted_modal_spell ::= "choose" "up" "to" number_words "{" "P" "}" "worth" "of" "modes" "." "you" "may" "choose" "the" "same" "mode" "more" "than" "once" "." NEWLINE weighted_mode_one NEWLINE weighted_mode_two NEWLINE weighted_mode_three

/* @sem @scope(Mode::Mode{announcement:@announcement, body:$weighted_mode_program, weight:1}) */
weighted_mode_one ::= "{" "P" "}" "—" weighted_mode_program

/* @sem @scope(Mode::Mode{announcement:@announcement, body:$weighted_mode_program, weight:2}) */
weighted_mode_two ::= "{" "P" "}" "{" "P" "}" "—" weighted_mode_program

/* @sem @scope(Mode::Mode{announcement:@announcement, body:$weighted_mode_program, weight:3}) */
weighted_mode_three ::= "{" "P" "}" "{" "P" "}" "{" "P" "}" "—" weighted_mode_program

weighted_mode_program ::= weighted_tapped_creation_program | weighted_top_exile_play_program | weighted_timed_event_program | weighted_counter_grant_program | weighted_choose_type_destroy_program | weighted_draw_greatest_program | weighted_choose_copy_program | weighted_return_nontoken_program | weighted_single_action_program | weighted_sacrifice_choice_program | weighted_history_draw_program | weighted_defined_loss_program | weighted_create_one_program | weighted_exile_controller_draw_program | weighted_return_permanent_counter_program

/* @sem Program::Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::AbilityController), $verb_operation_base)}]} */
weighted_single_action_program ::= verb_operation_base "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([AnyOf([$noun, $noun_2]), ControlledBy(One(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:Result{result:@prior, phase:After, index:0}, exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
weighted_choose_copy_program ::= "choose" "an" noun "or" noun "you" "control" "." "create" "a" "token" "that's" "a" "copy" "of" "it" "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$adjective_nontype, Not(Token)])}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]} */
weighted_return_nontoken_program ::= "return" "each" adjective_nontype "," "nontoken" "permanent" "to" "its" "owner's" "hand" "."

activation_sorcery_condition ::= condition | linked_play_attacked_with

/* The conditional upper bound is the number of independently scoped modes. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Conditional{condition:$condition_hand_none, then:@length($modes), otherwise:Constant(1)}}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_conditional_one_or_more ::= "choose" "one" "." "if" condition_hand_none "," "choose" "one" "or" "more" "instead" "." NEWLINE modes

/* A quoted conditional paragraph closes before the following spell paragraph. */
/* @sem Ability::[@optional_ability_label(Spell{announcement:@announcement, body:Program{instructions:[...$revealed_opponent_hand_choice_exile, If{condition:$condition_graveyard_count_are, then:Program{instructions:$seek_card_perpetual_cost}, otherwise:Program{}}, ...$root_spell_paragraph_tail]}}, $spell_paragraph_break)] */
line_spell_conditional_seek_quote ::= revealed_opponent_hand_choice_exile "." spell_paragraph_break "if" condition_graveyard_count_are "," seek_card_perpetual_cost NEWLINE root_spell_paragraph_tail

/* @sem Ability::Spell{announcement:Announcement{modes:$mixed_zone_chosen_color_modes}, body:Program{}} */
spell_mixed_zone_chosen_color ::= mixed_zone_chosen_color_modes "."

/* Counter protection can precede an independent instruction. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$temporary_controlled_spells_counter_protection}, ...$instructions] */
instructions_protected_spells_and ::= temporary_controlled_spells_counter_protection "," "and" instructions

/* An entering object is the subject of both the fight and the comparison. */
/* @sem Ability::Triggered{event:$event_controlled_enters, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$fight_same_value}]}} */
triggered_entry_same_value_fight ::= "whenever" event_controlled_enters "," fight_same_value "."

/* Keep the earlier clause independent of the optional attachment. */
/* @sem Instruction::[...$clause, ...$optional_attach_exact_choice] */
instructions_then_optional_attachment ::= clause "." "then" optional_attach_exact_choice

/* Buyback precedes this singleton casting payment, fixing its ability address. */
/* @sem Ability::[$buyback_casting_header, Casting(AdditionalCost{cost:Cost{parts:[$receipt_cast_sacrifice_creature]}, optional:false, repetition:Once}), Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$buyback_casting_sacrifice_life}]}}] */
card_buyback_casting_sacrifice_gain ::= buyback_casting_header NEWLINE "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," receipt_cast_sacrifice_creature "." NEWLINE buyback_casting_sacrifice_life "."
buyback_casting_header ::= keyword_buyback | buyback_explained

/* The enclosing card proves the producer at casting ability 1. */
/* @sem Operation::GainLife{players:One(AbilityController), amount:ObjectProperty{object:Query{objects:CostObjects{payment:Casting{ability:1}, component:[0], view:Inputs, phase:Before}, index:0}, property:$receipt_stat, information:CurrentOrLastKnown}} */
buyback_casting_sacrifice_life ::= "you" "gain" "life" "equal" "to" "the" "sacrificed" "creature's" receipt_stat

/* A labeled mode may remove player counters before another instruction. */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$player_loses_all_kind_counters}, ...$instructions]}, weight:1}) */
mode_flavor_counter_followup ::= "•" "RadAway" "—" player_loses_all_kind_counters "." instructions "."

/* Sequence a preceding clause with a reference to its named player. */
/* @sem Instruction::[...$clause, Effect{result:@next, operation:$exile_referenced_graveyard}] */
instructions_then_referenced_graveyard ::= clause "." "then" exile_referenced_graveyard

/* @sem Ability::Activated{origin:Ordinary, cost:$activation_cost, limits:ActivationLimits{}, announcement:@announcement, body:$created_counter_distinct_values_program} */
/* @prefer always */
activated_created_counter_distinct_values ::= activation_cost ":" created_counter_distinct_values_program "."

/* Prefer the direct target wording only in this dependent pair of modes. */
/* @sem Mode::[$mode_chosen_land_type_change, $mode_direct_target_phase] */
/* @prefer always */
modes_land_then_phase ::= mode_chosen_land_type_change NEWLINE mode_direct_target_phase

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:$instructions_chosen_land_type_change}, weight:1}) */
mode_chosen_land_type_change ::= "•" instructions_chosen_land_type_change "."

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::PhaseOut{object:$target_permanent}}}]}, weight:1}) */
mode_direct_target_phase ::= "•" target_permanent "phases" "out" "."

/* A scoped anaphoric test and grant use the established object in this ability. */
/* @sem Vec<Instruction>::@returned_conditional([@leading_if(Instruction::If{condition:$anaphoric_subtype_pair, then:Program{instructions:[Effect{result:@next, operation:$anaphoric_additional_grant}]}, otherwise:Program{}})]) */
clause_if_anaphoric_type_grant ::= "if" anaphoric_subtype_pair "," anaphoric_additional_grant

/* The announced player set is the subject of each conjoined action. */
/* @sem @apply($announced_all_players, $announced_choice_verbs) */
clause_announced_players_each ::= announced_all_players "each" announced_choice_verbs

/* @sem Instruction::[$verb_base, Effect{result:@next, operation:$announced_sacrifice_choice}] */
announced_choice_verbs ::= verb_base "and" announced_sacrifice_choice

announced_sacrifice_choice ::= sacrifice_choice_base | sacrifice_choice_plural_base

/* A replacement choice can precede a separate owned-name intensification. */
/* @sem Instruction::[...$instead_front_action, Effect{result:@next, operation:$intensify_owned_named}] */
instructions_instead_and_owned_intensify ::= instead_front_action "." NEWLINE intensify_owned_named

/* A spell resolves ascend before its independently composed draw contrast. */
/* @sem Instruction::[Effect{result:@next, operation:$ascend_action}] */
ascend_instruction ::= ascend_action

/* @sem Instruction::[...$ascend_instruction, ...$instead_draw] */
instructions_ascend_draw_contrast ::= ascend_instruction NEWLINE instead_draw

/* A sequential action followed by removal of the current ability. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:$continuous_loses_current_ability}] */
instructions_then_current_ability_loss ::= operation "," "then" continuous_loses_current_ability

/* The tested card is the arrival of this exact single-card exile. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One($target_card), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$single_exile_was_filter}, then:Program{instructions:$instructions}, otherwise:Program{}}] */
instructions_exile_target_card_was_kind ::= "exile" target_card "." "if" single_exile_was_filter "," instructions

/* A conditional additional copy follows an independently created copy trigger. */
/* @sem Ability::@optional_ability_label(Spell{announcement:@announcement, body:Program{instructions:[...$clause_next_cast_copy, If{condition:$condition, then:Program{instructions:$next_cast_additional_copy}, otherwise:Program{}}]}}, $spell_paragraph_break) */
spell_next_copy_conditional_additional ::= clause_next_cast_copy "." spell_paragraph_break "if" condition "," next_cast_additional_copy "."

/* A serial action sentence followed by a counter threshold conditional. */
/* @sem Instruction::[...$serial_actions_ordered, ...$clause_counter_threshold_remove_them] */
instructions_serial_then_conditional ::= serial_actions_ordered "." "then" clause_counter_threshold_remove_them

/* Three or more immediate actions with an ordered final clause. */
/* @sem Vec<Instruction>::@then_sequence($serial_action_clause, $serial_ordered_tail) */
serial_actions_ordered ::= serial_action_clause "," serial_ordered_tail

/* @sem Vec<Instruction>::@then_sequence($serial_action_clause, $conjoined) */
serial_ordered_tail ::= serial_action_clause "," "then" conjoined

/* A batch's group is available to its intervening condition and program. */
/* @sem Ability::Triggered{event:$event_batch_attack_opponents, intervening_if:$condition_event_group_stat_either, limits:TriggerLimits{}, announcement:@announcement, body:$program_named_source_stat_defender_damage} */
triggered_group_stat_condition ::= "whenever" event_batch_attack_opponents "," "if" condition_event_group_stat_either "," program_named_source_stat_defender_damage "."

/* The compared threshold, player and counter kind also define the difference. */
/* @sem Instruction::[If{condition:Compare{left:CountCounters{recipients:Players(One($target_player)), kind:$counter_kind, information:CurrentOrLastKnown}, test:Compare{comparison:Less, value:$number_words}}, then:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Players(One($target_player)), kind:$counter_kind_2, amount:Subtract([$number_words, CountCounters{recipients:Players(One($target_player)), kind:$counter_kind, information:CurrentOrLastKnown}])}]}}]}, otherwise:Program{}}] */
clause_target_counter_difference ::= "if" target_player "has" "fewer" "than" number_words counter_kind "counters" "," "they" "get" "a" "number" "of" counter_kind "counters" "equal" "to" "the" "difference"

/* The optional removal payment removes the counters named in the intervening-if
   and feeds the exile mana-value threshold. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:ObjectMatches{object:$self_explicit_ref, filter:Counters(_{kind:$counter_kind, comparison:GreaterOrEqual, value:Constant(1)})}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One($self_explicit_ref)), kind:$counter_kind, amount:All}]}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(SameObject($self_explicit_ref)), $filter_phrase, ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:$stat_comparison, value:PaidCountersRemoved{payment:Resolution(@marked), component:[0]}}})}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{}}]}} */
triggered_remove_all_counters_exile_other ::= "at" turn_event "," "if" self_explicit_ref "has" "one" "or" "more" counter_kind "counters" "on" "it" "," "you" "may" "remove" "all" "of" "them" "." "if" "you" "do" "," "exile" "each" "other" filter_phrase "with" stat stat_comparison "the" "number" "of" "counters" "removed" "this" "way" "."

/* Turn-step trigger testing whether the equipped creature failed to deal combat
   damage to a matching permanent this turn, then sacrificing that same creature. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:ObjectMatches{object:AttachedTo(Source), filter:Condition(Not(Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:SameObject(Candidate), recipients:Objects($noun), kind:Combat, grouping:SourceRecipient, subject:Source}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}))}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:One(AttachedTo(Source))})}]}} */
triggered_equipped_no_combat_damage_sacrifice ::= "at" turn_event "," "if" "equipped" "creature" "didn't" "deal" "combat" "damage" "to" ("a" | "an") noun "this" "turn" "," "sacrifice" "it" "."

/* Activated sorcery-speed meld sharing the named partner's type filter across
   condition and exile choice. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{sorcery:true}, announcement:@announcement, body:Program{instructions:[If{condition:AllOf([ObjectMatches{object:$self_explicit_ref, filter:AllOf([OwnedBy(One(AbilityController)), ControlledBy(One(AbilityController))])}, Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Name($referenced_card_name), OwnedBy(One(AbilityController)), ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}]), then:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Name($referenced_card_name)])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Union([One($self_explicit_ref), Selected(@prior)]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Meld{objects:Transition{result:@prior, phase:After}, into:$referenced_card_name_2, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{}}]}} */
ability_activated_sorcery_owned_named_meld ::= cost ":" "if" meld_owned_prefix self_explicit_ref "and" ("a" | "an") filter_phrase "named" referenced_card_name "," meld_exile_then referenced_card_name "." "activate" "only" "as" "a" "sorcery" "."

/* Up to a number of modes permits choosing none. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(0), maximum:$number_words}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_up_to_number ::= "choose" "up" "to" number_words "—" NEWLINE modes

/* The countered stack object's controller is the announced target's controller. */
/* @sem Instruction::[Effect{result:@next, operation:$counter_target_spell_or_ability}, Effect{result:@next, operation:Draw{players:One(ControllerOf(Target{slot:@last_slot, index:0})), amount:$card_count}}] */
counter_target_controller_draw ::= counter_target_spell_or_ability "." "its" "controller" "draws" card_count

/* Keep stack exile and stack counter on one conjoined spell line. */
/* @prefer always */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@exile_result(Operation::Move{objects:$exile_stack_population, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]})}, Effect{result:@next, operation:Counter{objects:$counter_stack_objects, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}} */
spell_exile_and_counter_stack ::= "exile" exile_stack_population "and" "counter" counter_stack_objects "."

/* Spell commander-conditional modal headers retain 'as you cast this spell'. */
/* @prefer always */
/* @sem Ability::Spell{announcement:Announcement{modes:ModeSelection{count:ModeCount{minimum:Expr::Constant(1), maximum:Expr::Conditional{condition:Controls{player:AbilityController, filter:State(Commander), minimum:1}, then:Constant(2), otherwise:Constant(1)}}, options:[$mode_each_sacrifice_controlled_extreme, $mode_exile_graveyards_token_maximum], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}}}, body:Program{}} */
spell_commander_sacrifice_exile_modes ::= "choose" "one" "." "if" "you" "control" "a" "commander" "as" "you" "cast" "this" "spell" "," "you" "may" "choose" "both" "instead" "." NEWLINE mode_each_sacrifice_controlled_extreme NEWLINE mode_exile_graveyards_token_maximum

/* @sem Mode::@scope(Mode::Mode{announcement:@announcement, body:Program{instructions:$shared_each_sacrifice_controlled_extreme}, weight:1}) */
mode_each_sacrifice_controlled_extreme ::= "•" shared_each_sacrifice_controlled_extreme "."

/* @sem Mode::@scope(Mode::Mode{announcement:@announcement, body:Program{instructions:$shared_exile_graveyards_token_maximum}, weight:1}) */
mode_exile_graveyards_token_maximum ::= "•" shared_exile_graveyards_token_maximum "."

/* Both independent activation restrictions remain in the ability. */
/* @sem ActivationLimits::ActivationLimits{condition:PlayerIsActive(AbilityController), modifiers:[ActivationRule(XNotZero)]} */
limit_x_nonzero_your_turn ::= "x" "can't" "be" "0" "." "activate" "only" "during" "your" "turn"

/* A negative casting condition consumes a separately typed history phrase. */
/* @sem Ability::Casting(Require(Not($past_controller_land_history))) */
casting_forbidden_if_history ::= "you" "can't" "cast" SELF_NAME "if" past_controller_land_history "."

/* The two actions share the value explicitly defined by the sentence. */
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$defined_self_property}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:$defined_self_property}}] */
draw_life_defined ::= "you" "draw" "X" "cards" "and" "lose" "X" "life" "," "where" "X" "is" defined_self_property

defined_self_property ::= value_self_intensity | value_self_stat

/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$intensify_owned_named}, ...$draw_life_defined]} */
program_intensify_then_defined ::= intensify_owned_named "." "then" draw_life_defined

/* Keep the explicit transition into the opponent choice when it follows another clause. */
/* @prefer always */
/* @sem Vec<Instruction>::[...$clause, ...$instructions_opponent_draw_or_mill_loss] */
instructions_then_opponent_draw_or_mill_loss ::= clause "." "then" instructions_opponent_draw_or_mill_loss

/* A sequential action followed by an independently chosen tap population. */
/* @prefer always */
/* @sem Vec<Instruction>::@then_sequence($clause_before_then, $clause_tap_any_number) */
instructions_then_tap_any_number ::= clause_before_then "," "then" clause_tap_any_number

/* The definition supplies the upper bound; each option keeps its own mode scope. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(0), maximum:$value}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_up_to_defined_x ::= "choose" "up" "to" "X" "," "where" "X" "is" value "—" NEWLINE modes

/* A conditional can introduce the subject of a stat-defined fallback. */
/* @prefer always */
/* @sem Instruction::[If{condition:$condition_announced_property, then:Program{instructions:$clause}, otherwise:Program{instructions:[Effect{result:@next, operation:$continuous_own_stat_difference_pump}]}}] */
instructions_if_stat_difference_otherwise ::= "if" condition_announced_property "," clause "." "otherwise" "," continuous_own_stat_difference_pump

/* Keep the producer, tested recipient, and quantity in one scoped receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$deal_damage}, If{condition:Compare{left:ExcessDamage{result:@marked, to:$excess_token_recipient}, test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:ExcessDamage{result:@marked, to:$excess_token_recipient}, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}}}]}, otherwise:Program{}}] */
instructions_excess_damage_named_tokens ::= deal_damage "." "if" "excess" "damage" "was" "dealt" "to" excess_token_recipient "this" "way" "," "create" "that" "many" "tapped" token_named_recipe "tokens"

/* @sem ObjectFilter::Any */
excess_token_recipient ::= "a" "permanent"

/* Compose the equipped damage event with the retained exiling permission reading. */
/* @sem Ability::Triggered{event:$hidden_equipped_event, limits:_{}, announcement:@announcement, body:_{instructions:[...$event_graveyard_cast_exiling]}} */
triggered_equipped_graveyard_permission_exiling ::= "whenever" hidden_equipped_event "," event_graveyard_cast_exiling "."

/* Return modes bind each target within its own mode. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$return_owner_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_up_to_return_modes ::= "choose" "up" "to" number_words "—" NEWLINE return_owner_modes

/* @sem Mode::[$return_owner_mode, ...$return_owner_modes_tail] */
return_owner_modes ::= return_owner_mode NEWLINE return_owner_modes_tail

/* @sem Mode::[$return_owner_mode] */
return_owner_modes_tail ::= return_owner_mode

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$return_owner_mode_operation}]}, weight:1}) */
return_owner_mode ::= "•" return_owner_mode_operation "."

return_owner_mode_operation ::= return_target_stack_spell_hand | return_mode_target_permanent_hand

/* @sem Operation::@owner_return(Operation::Move{objects:One($target_permanent), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}) */
return_mode_target_permanent_hand ::= "return" target_permanent "to" "its" "owner's" "hand"

/* A choice, its counter placement, and the following grant share one result. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun, ControlledBy(One(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Result{result:@prior, phase:After, index:0})), kind:$counter_kind, amount:Constant(1)}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@back(3), phase:After, index:0})), changes:[GrantKeyword($keyword_name), GrantKeyword($keyword_name_2)], duration:$duration, evaluation:Snapshot}}]} */
weighted_counter_grant_program ::= "put" "a" counter_kind "counter" "on" "a" noun "you" "control" "." "it" "gains" keyword_name "and" keyword_name duration "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:CardType, terms:_{count:Exactly(Constant(1)), options:[$choice_card_type, $choice_card_type_2]}}}, Effect{result:@next, operation:Destroy{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:ChosenFilter}, regeneration:true}}]} */
weighted_choose_type_destroy_program ::= "choose" choice_card_type "or" choice_card_type "." "destroy" "all" "permanents" "of" "the" "chosen" "type" "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$greatest_controlled_stat}}]} */
weighted_draw_greatest_program ::= "draw" "cards" "equal" "to" greatest_controlled_stat "."

/* The attacked player may activate during declaration of attackers. */
/* @sem ActivationLimits::ActivationLimits{condition:Window(DeclareAttackers), modifiers:[ActivationRule(OnlyBy(One(DefendingPlayerOf($object_ref))))]} */
limit_attacked_player_declare_attackers ::= "only" "the" "player" object_ref "is" "attacking" "may" "activate" "this" "ability" "and" "only" "during" "the" "declare" "attackers" "step"

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:$combat_player_reselection}] */
instructions_then_player_reselection ::= operation "," "then" combat_player_reselection

/* A separate paragraph may condition a rule on the damage recipient's population. */
/* @prefer always */
/* @sem Ability::[Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$deal_damage}, If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:$target_controller_rule}]}, otherwise:Program{}}]}}] */
line_damage_target_controller_condition ::= deal_damage "." NEWLINE "if" condition "," target_controller_rule "."

/* Ordinary scoped operations compose independently with weighted modes. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:@sacrificed_result($sacrifice_each_choice_scoped)}]} */
weighted_sacrifice_choice_program ::= sacrifice_each_choice_scoped "."

/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$draw_for_each_controlled_death}]} */
weighted_history_draw_program ::= draw_for_each_controlled_death "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:LoseLife{players:$players_singular, amount:$value_number_cards}}]} */
weighted_defined_loss_program ::= players_singular "loses" "X" "life" "," "where" "X" "is" value_number_cards "."

/* A token recipe is shared across independently scoped weighted modes. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$create_one_defined}]} */
weighted_create_one_program ::= create_one_defined "."

/* The controller refers to the target, including its last-known controller. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$adjective_nontype}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:Draw{players:One(ControllerOf(Target{slot:0, index:0})), amount:$card_count}}]} */
weighted_exile_controller_draw_program ::= "exile" "target" adjective_nontype "permanent" "." "its" "controller" "draws" card_count "."

/* The target's zone, value and arrival counter remain independent operands. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]), Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[]}}, qualifiers:[]}}]} */
weighted_return_permanent_counter_program ::= "return" "target" "permanent" "card" "with" "mana" "value" number "or" "less" "from" "your" "graveyard" "to" "the" "battlefield" "with" "an" counter_kind "counter" "on" "it" "."

/* The combat header supplies the event player and the current combat to the population. */
/* @sem Ability::Triggered{event:$event_player_attacks_with_group, limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:$destroy_event_player_nonattackers_except_new, regeneration:true}}]}} */
triggered_attack_destroy_nonattackers ::= "whenever" event_player_attacks_with_group "," "destroy" destroy_event_player_nonattackers_except_new "."

/* Keep the choice and its two dependent instructions in one program scope. */
/* @sem Program::Program{instructions:[$chosen_attack_choice, $chosen_attack_rule, $chosen_attack_delayed]} */
program_chosen_attack_restriction ::= chosen_attack_choice "." chosen_attack_rule "." chosen_attack_delayed

chosen_attack_threshold ::= chosen_attack_once | chosen_attack_counted

/* @sem Expr::Constant(1) */
chosen_attack_once ::= "attack"

/* @sem $count_plural */
chosen_attack_counted ::= "attack" count_plural "or" "more" "times"

/* The conditional affects how many independently scoped modes may be chosen. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Conditional{condition:$condition_you_life_comparison, then:Constant(2), otherwise:Constant(1)}}, options:$life_choice_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_one_if_life_both ::= "choose" "one" "." "if" condition_you_life_comparison "," "you" "may" "choose" "both" "instead" "." NEWLINE life_choice_modes

/* The second sentence refers to the same targeted graveyard owner. */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0})}, kind:Card, filter:Any}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:LoseLife{players:One(Target{slot:0, index:0}), amount:$number}}]}, weight:1}) */
mode_exile_opponent_graveyard_loss ::= "•" "exile" "target" "opponent's" "graveyard" "." "that" "player" "loses" number "life" "."

life_choice_modes ::= life_choice_draw_modes | modes

/* @prefer always */
/* @sem Mode::[$life_choice_draw_loss_mode, ...$modes] */
life_choice_draw_modes ::= life_choice_draw_loss_mode NEWLINE modes

/* @prefer always */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:$number}}]}, weight:1}) */
life_choice_draw_loss_mode ::= "•" "you" "draw" card_count "and" "you" "lose" number "life" "."

/* A first target and the additional distinct targets receive the same counters. */
/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$noun}), index:0})), kind:$counter_kind, amount:$kicked_counter_amount}, _{recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(TimesKicked(Source)), filter:AllOf([Not(SameObject(Target{slot:@last_slot, index:0})), $noun_2])}))), kind:$counter_kind, amount:$kicked_counter_amount}]}}] */
instructions_kicked_distinct_targets_counters ::= "choose" "target" noun "," "then" "choose" "another" "target" noun "for" "each" "time" "this" "spell" "was" "kicked" "." "put" kicked_counter_amount counter_kind "counters" "on" "each" "of" "them"

kicked_counter_amount ::= number_x | count_plural

/* A separate conditional paragraph may follow any spell instructions. */
/* @sem Ability::[Spell{announcement:@announcement, body:Program{instructions:[...$instructions, If{condition:$condition, then:Program{instructions:$clause_player_draw_history_damage}, otherwise:Program{}}]}}] */
/* @prefer always */
line_conditional_draw_history_paragraph ::= instructions "." NEWLINE "if" condition "," clause_player_draw_history_damage "."

/* Preserve the paragraph boundary when the combat action precedes an independent imperative. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$unblocked_attacker_becomes_blocked}, ...$clause_imperative] */
blocked_target_followed_by_imperative ::= unblocked_attacker_becomes_blocked "." NEWLINE clause_imperative

/* @sem Instruction::[...$become_blocked_reminded, ...$clause_imperative] */
blocked_reminded_followed_by_imperative ::= become_blocked_reminded NEWLINE clause_imperative

/* The delayed action refers to the exact population fixed by the pump. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$controlled_creature_counted_pump}, Effect{result:@next, operation:$delayed_sacrifice_affected_creatures}]} */
program_counted_pump_delayed_sacrifice ::= controlled_creature_counted_pump "." delayed_sacrifice_affected_creatures

/* A singular destroyed object cannot regenerate from this destruction. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:One($object_ref), regeneration:false}}] */
clause_destroy_singular_unregenerable_and ::= "destroy" object_ref "and" "it" "can't" "be" "regenerated"

/* The follow-ups use the population captured by the control effect, not a new query. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), Property{property:$stat, test:NumberTest::Compare{comparison:$bound, value:$number}}])}), changes:[SetController(AbilityController)], duration:$control_population_duration, evaluation:Snapshot}}, Effect{result:@next, operation:SetTapped{objects:Affected(@marked), tapped:false}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Affected(@marked)), changes:[GrantKeyword($keyword_value)], duration:$duration, evaluation:Snapshot}}] */
instructions_control_population_untap_grant ::= "gain" "control" "of" "all" "creatures" "with" stat number "or" bound control_population_duration "." "untap" "those" "creatures" "." "they" "gain" keyword_value duration

control_population_duration ::= control_population_until_end | duration

/* @prefer always */
/* @sem Duration::$until_end_of_turn */
control_population_until_end ::= until_end_of_turn

/* The two actions retain their own result identities and graveyard choice. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::AbilityController), $mill_base)}, ...$return_up_to_spell_cards_hand]} */
program_mill_then_return_spell_cards ::= mill_base "," "then" return_up_to_spell_cards_hand

/* Each option announces its own player target; both options have distinct targets. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(2)}, options:[$distinct_player_option, $distinct_player_option_2], rules:ModeRules{repetition:OnceEach, availability:Any, targets:Distinct, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_both_distinct_players ::= "choose" "one" "or" "both" "." "each" "mode" "must" "target" "a" "different" "player" "." NEWLINE distinct_player_option NEWLINE distinct_player_option

distinct_player_option ::= mode_target_player_controlled_counters | mode_target_player_graveyard_return | mode_target_opponent_program

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:$player_choose_controlled_counters}, weight:1}) */
mode_target_player_controlled_counters ::= "•" player_choose_controlled_counters "."

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:$player_return_graveyard_union}, weight:1}) */
mode_target_player_graveyard_return ::= "•" player_return_graveyard_union "."

/* The anaphoric return names the holder tested by the intervening condition. */
/* @sem Ability::Triggered{event:$turn_event, intervening_if:$condition_holder_not_entered_this_turn, limits:TriggerLimits{}, announcement:@announcement, body:$program_return_trigger_source_to_owner_hand} */
triggered_holder_not_entered_return ::= "at" turn_event "," "if" condition_holder_not_entered_this_turn "," program_return_trigger_source_to_owner_hand

/* A single source-relative damage operation composes with the loyalty wrapper. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$deal_damage_source_other}]} */
loyalty_source_other_damage_sentence ::= deal_damage_source_other "."

/* A bounded announced X and the printed activation timing. */
/* @sem ActivationLimits::ActivationLimits{modifiers:[ActivationRule(XAtMost($greatest_controlled_stat))]} */
limit_x_controlled_greatest_sorcery ::= "x" "can't" "be" "greater" "than" greatest_controlled_stat "." "activate" "only" "as" "a" "sorcery"

/* @sem Instruction::[...$ascend_instruction, ...$conditional_optional_owned_move] */
instructions_ascend_optional_owned_move ::= ascend_instruction NEWLINE conditional_optional_owned_move

/* @sem Instruction::[...$ascend_instruction, ...$controlled_creatures_pump_contrast] */
instructions_ascend_creature_contrast ::= ascend_instruction NEWLINE controlled_creatures_pump_contrast

/* This snapshot definition excludes the source spell from cast history. */
/* @sem Program::@where_snapshot($program_plain, $other_spells_sum) */
program_where_other_spells_snapshot ::= program_plain "," "where" "X" "is" other_spells_sum

turn_intervening_program_sentence ::= program_sentence | turn_intervening_mill_graveyard_sentence

/* @sem $program_mill_optional_graveyard_card_hand */
turn_intervening_mill_graveyard_sentence ::= program_mill_optional_graveyard_card_hand "."

/* Ascend precedes a choice replaced by a player-relative fractional sacrifice. */
/* @sem Instruction::[...$ascend_instruction, ...$instead_fractional_sacrifice] */
instructions_ascend_sacrifice_contrast ::= ascend_instruction NEWLINE instead_fractional_sacrifice

cast_trigger_condition ::= condition | condition_cast_event_symbol_unspent

/* An immediate clause can precede the explicit graveyard-card shuffle. */
/* @sem Vec<Instruction>::@then_sequence($clause_before_then, $shuffle_graveyard_receipt) */
instructions_then_shuffle_graveyard_cards ::= clause_before_then "," "then" shuffle_graveyard_receipt

/* Prefer the explicit shuffle after hidden-zone exile while preserving other sequences. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_all_library_face_down}] */
clause_hidden_zone_exile ::= exile_all_library_face_down

/* @prefer always */
/* @sem Vec<Instruction>::@then_sequence($clause_hidden_zone_exile, $shuffle_graveyard_receipt) */
hidden_exile_then_shuffle_graveyard_cards ::= clause_hidden_zone_exile "," "then" shuffle_graveyard_receipt

/* A player's life gain followed by an ordered sequence of immediate actions. */
/* @sem Instruction::[Effect{result:@next, operation:@apply($players_singular, $gain_life_third)}] */
serial_player_life ::= players_singular gain_life_third

/* @sem Vec<Instruction>::@then_sequence($serial_player_life, $serial_ordered_tail) */
instructions_player_life_ordered ::= serial_player_life "," serial_ordered_tail

/* Labeled modes retain their scoped programs. */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:$program_sentence, weight:1}) */
mode_scout_flavor ::= "•" "look" "Around" "—" program_sentence

/* @sem @scope(Mode::Mode{announcement:@announcement, body:$program_sentence, weight:1}) */
mode_bring_down_flavor ::= "•" "Bring" "Down" "—" program_sentence

/* The mill and return share one scoped receipt. */
/* @sem Instruction::[...$mill_optional_return_among_them, ...$clause] */
instructions_mill_return_followup ::= mill_optional_return_among_them "." clause

/* Keep the active-player upkeep window scoped to the unenchanted predicate so limit_upkeep_condition (InTheirUpkeep) cannot duplicate it. */
/* @sem ActivationLimits::ActivationLimits{condition:AllOf([$window_during_your_upkeep_step, ObjectMatches{object:$object_ref, filter:Not(State(Enchanted))}])} */
limit_upkeep_not_enchanted ::= "activate" "only" window_during_your_upkeep_step "and" "only" "if" object_ref "isn't" "enchanted"

/* The attacking named partner and source are selected and exiled before melding. */
/* @sem Instruction::[If{condition:AllOf([Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Name($referenced_card_name)])}, filter:Attacking}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}}, Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Name($referenced_card_name), Attacking, OwnedBy(One(AbilityController)), ControlledBy(One(AbilityController))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}}, ObjectMatches{object:$object_ref, filter:Attacking}, ObjectMatches{object:$object_ref, filter:AllOf([OwnedBy(One(AbilityController)), ControlledBy(One(AbilityController))])}]), then:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Name($referenced_card_name), Attacking])}, count:AsManyAsCan($counter_amount)}}, Effect{result:@next, operation:Move{objects:Union([One($object_ref), Selected(@prior)]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Meld{objects:Transition{result:@prior, phase:After}, into:$referenced_card_name_2, entry:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}]}, otherwise:_{}}] */
meld_attacking_owned_pair ::= "if" object_ref "and" counter_amount filter_phrase "named" referenced_card_name "are" "attacking" "," "and" "you" "both" "own" "and" "control" "them" "," meld_exile_then referenced_card_name "." "it" "enters" "tapped" "and" "attacking"

/* Defined-X life drain paired with attacking owned meld pair. */
/* @sem Instruction::[...$players_defined_life_drain, ...$meld_attacking_owned_pair] */
instructions_drain_and_meld_attacking_pair ::= players_defined_life_drain "." meld_attacking_owned_pair

/* Each matching card in the controller's hand gains a scoped quoted ability. */
/* @sem Program::Program{instructions:$perpetual_filtered_hand_grant} */
perpetual_quote_filtered_hand_program ::= perpetual_filtered_hand_grant

/* @prefer always */
/* @sem Vec<Instruction>::@then_sequence($clause_search_bare_shuffle, $instructions_discard_filtered_conditional_an) */
instructions_search_then_discard_conditional_an ::= clause_search_bare_shuffle "," "then" instructions_discard_filtered_conditional_an

/* @prefer always */
/* @sem Vec<Instruction>::@then_sequence($clause_search_bare_shuffle, $instructions_discard_filtered_conditional_a) */
instructions_search_then_discard_conditional_a ::= clause_search_bare_shuffle "," "then" instructions_discard_filtered_conditional_a

/* A shared definition is captured before both snapshot changes. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:BindValue{value:$value}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$shared_duration_x_change, duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($affected_2), changes:$shared_duration_pump, duration:$duration, evaluation:Snapshot}}]} */
program_shared_duration_capture ::= duration "," affected shared_duration_x_change "and" affected shared_duration_pump "," "where" "X" "is" value

shared_duration_x_change ::= shared_duration_x_power | shared_duration_x_toughness

/* A bounded choice remains a single action within an ordered serial list. */
/* @sem Instruction::[...$instructions_untap_choice, ...$conjoined] */
serial_choice_then ::= instructions_untap_choice "," "then" conjoined

/* Each selected mode announces its own target, and distinctness is a selection rule. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$player_target_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:Distinct, acceptance:MayDecline}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_optional_distinct_player_modes ::= "you" "may" "choose" number_words "." "each" "mode" "must" "target" "a" "different" "player" "." NEWLINE player_target_modes

/* @sem Mode::[$player_target_mode] */
player_target_modes_one ::= player_target_mode

/* @sem Mode::[$player_target_mode, ...$player_target_modes] */
player_target_modes_more ::= player_target_mode NEWLINE player_target_modes

player_target_modes ::= player_target_modes_one | player_target_modes_more

player_target_mode ::= mode_target_player_program | player_target_mode_create | player_target_mode_draw_loss | player_target_mode_counters

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One($target_player), tokens:$token_groups, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, weight:1}) */
player_target_mode_create ::= "•" target_player "creates" token_groups "."

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One($target_player), amount:$card_count}}, Effect{result:@next, operation:LoseLife{players:One($target_player), amount:$number_digits}}]}, weight:1}) */
player_target_mode_draw_loss ::= "•" target_player "draws" card_count "and" "loses" number_digits "life" "."

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun, ControlledBy(One($target_player))])}), kind:$counter_kind, amount:Constant(1)}]}}]}, weight:1}) */
player_target_mode_counters ::= "•" target_player "puts" "a" counter_kind "counter" "on" "each" noun "they" "control" "."

/* The follow-ups refer to the sole target introduced by this producer. */
/* @sem Program::Program{instructions:[...$controlled_creature_timed_changes, ...$linked_creature_departures]} */
program_controlled_creature_departures ::= controlled_creature_timed_changes "." linked_creature_departures

/* A new line can introduce an independent condition after combat prevention. */
/* @prefer always */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$prevent_all_combat_damage_interval}, ...$clause_if]}} */
spell_instruction_newline_condition ::= prevent_all_combat_damage_interval "." NEWLINE clause_if "."

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:$number_x, maximum:$number_x}, options:$repeatable_x_modes, rules:ModeRules{repetition:MayRepeat, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_x_repeatable ::= "choose" number_x "." "you" "may" "choose" "the" "same" "mode" "more" "than" "once" "." NEWLINE repeatable_x_modes

repeatable_x_modes ::= repeatable_x_modes_one | repeatable_x_modes_more

/* @sem Mode::[$repeatable_x_mode] */
repeatable_x_modes_one ::= repeatable_x_mode

/* @sem Mode::[$repeatable_x_mode, ...$repeatable_x_modes] */
repeatable_x_modes_more ::= repeatable_x_mode NEWLINE repeatable_x_modes

repeatable_x_mode ::= repeatable_x_sacrifice_mode | mode

/* @prefer always */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@apply($players_singular, $sacrifice_choice_third_plain)}]}, weight:1}) */
repeatable_x_sacrifice_mode ::= "•" players_singular sacrifice_choice_third_plain "."

/* The quoted grant applies to every qualifying card owned by the controller. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:EffectOn{subject:Objects($owned_x_card_population), effects:[Term{family:PerpetualEffect, form:AddAbility, operands:[Ability($quoted_cost_reduction)]}]}}]} */
perpetual_quote_owned_x_program ::= owned_x_card_population "perpetually" "gains" quoted_cost_reduction

/* Preserve the explicit then joining an earlier action to this linked sequence. */
/* @prefer always */
/* @sem Vec<Instruction>::@then_sequence($clause_before_then, $instructions_event_top_hidden_permission) */
instructions_before_event_top_hidden ::= clause_before_then "," "then" instructions_event_top_hidden_permission

/* Keep a paired entry trigger grouped when followed by additional abilities. */
/* @prefer always */
/* @sem Ability::[...$line_self_or_other_controlled_entry, ...$abilities] */
abilities_controlled_entry_pair_more ::= line_self_or_other_controlled_entry NEWLINE abilities

/* Bind the shared program independently to each entrant. */
/* @prefer always */
/* @sem Ability::[Triggered{event:ZoneChange{objects:$event_self, to:Battlefield}, limits:TriggerLimits{}, announcement:@announcement, body:$paired_entry_program}, Triggered{event:ZoneChange{objects:$paired_entry_other, to:Battlefield}, limits:TriggerLimits{}, announcement:@announcement, body:$paired_entry_program}] */
line_self_or_other_controlled_entry ::= "whenever" event_self "or" paired_entry_other "enters" "," paired_entry_program "."

paired_entry_other ::= paired_entry_other_canonical

/* @prefer always */
/* @sem ObjectFilter::$event_another_controlled */
paired_entry_other_canonical ::= event_another_controlled

paired_entry_program ::= paired_entry_program_canonical

/* @prefer always */
/* @sem Program::$program */
paired_entry_program_canonical ::= program

/* Commander-dependent mode selection on a turn trigger. The modes retain their own scopes. */
/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:Announcement{modes:ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Conditional{condition:Controls{player:AbilityController, filter:State(Commander), minimum:1}, then:Constant(2), otherwise:Constant(1)}}, options:$commander_turn_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}}}, body:Program{}} */
triggered_commander_turn_modes ::= "at" turn_event "," "choose" "one" "." "if" "you" "control" "a" "commander" "," "you" "may" "choose" "both" "instead" "." NEWLINE commander_turn_modes

commander_turn_modes ::= commander_turn_modes_one | commander_turn_modes_more

/* @sem Mode::[$commander_turn_mode] */
commander_turn_modes_one ::= commander_turn_mode

/* @sem Mode::[$commander_turn_mode, ...$commander_turn_modes] */
commander_turn_modes_more ::= commander_turn_mode NEWLINE commander_turn_modes

commander_turn_mode ::= mode | mode_counter_controlled_up_to

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$subtype_plural, ControlledBy(One(AbilityController))])}), kind:$counter_kind, amount:Constant(1), selection:_{player:AbilityController, count:UpTo($number_words)}}]}}]}, weight:1}) */
/* @prefer always */
mode_counter_controlled_up_to ::= "•" "put" "a" counter_kind "counter" "on" "each" "of" "up" "to" number_words subtype_plural "you" "control" "."

/* @prefer always */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:$program_source_becomes_stats_keyword, weight:1}) */
mode_source_becomes_stats_keyword ::= "•" program_source_becomes_stats_keyword "."

/* @prefer always */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:$program_source_becomes_stats, weight:1}) */
mode_source_becomes_stats ::= "•" program_source_becomes_stats "."

/* The pending next-spell modifier can follow any preceding clause on a new line. */
/* @sem Instruction::[...$clause, Effect{result:@next, operation:$next_typed_spell_announced_reduction}] */
instructions_newline_next_reduction ::= clause "." NEWLINE next_typed_spell_announced_reduction

/* A single player performs an action and takes control of the affected objects. */
/* @sem Instruction::[ Effect{result:@next, operation:@apply(PlayerSet::One($player_ref), $verb_operation_third)}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[SetController($player_ref)], duration:Indefinite, evaluation:Snapshot}} ] */
clause_player_action_and_control ::= player_ref verb_operation_third "and" "gains" "control" "of" affected

/* The singular mill and its consumer share the same recorded result. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One($mill_pump_player), amount:Constant(1)}}, Effect{result:@next, operation:$milled_value_pump}] */
instructions_mill_card_value_pump ::= mill_pump_player "mills" "a" "card" "." milled_value_pump

mill_pump_player ::= player_ref

/* A postfix conditional has an independently optional replacement branch. */
/* @sem Program::Program{instructions:[If{condition:$condition, then:$program_plain, otherwise:Program{instructions:[Optional{decider:$player_ref, body:Program{instructions:[Effect{result:@next, operation:$per_point_damage_replacement}]}}]}}]} */
program_conditional_otherwise_optional_replacement ::= program_plain "if" condition "." "otherwise" "," player_ref "may" "choose" "that" per_point_damage_replacement

/* A target announcement precedes a sentence whose count refers to that player. */
/* @prefer always */
/* @sem Instruction::[...$clause_choose_player, ...$clause_you_named_tapped_arrivals] */
instructions_announced_counted_tokens ::= clause_choose_player "." clause_you_named_tapped_arrivals

/* The singular damage recipient is the antecedent for the following conditional. */
/* @sem Instruction::[Effect{result:@next, operation:$single_target_damage}, $recipient_conditional_regeneration_exile] */
instructions_damage_recipient_conditional ::= single_target_damage "." recipient_conditional_regeneration_exile

/* The condition and both effects apply to the same announced recipient. */
/* @sem Instruction::If{condition:ObjectMatches{object:RecipientObject{slot:@last_slot, index:0}, filter:$noun}, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(RecipientObject{slot:@last_slot, index:0})), changes:[Rule(Prohibit(Regenerate))], duration:EndOfTurn, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateReplacement{event:ZoneChange{objects:SameObject(RecipientObject{slot:@last_slot, index:0}), from:Battlefield, to:Graveyard}, limit:UntilExpired, duration:EndOfTurn, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}}}]}, otherwise:Program{}} */
recipient_conditional_regeneration_exile ::= "if" "it's" "a" noun "," "it" "can't" "be" "regenerated" "this" "turn" "," "and" "if" "it" "would" "die" "this" "turn" "," "exile" "it" "instead"

/* @sem Instruction::[Effect{result:@mark, operation:Destroy{objects:$destroy_object_set, regeneration:true}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$filter_plural}), CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:$filter_plural})]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
instructions_destroy_counted_token ::= "destroy" destroy_object_set "," "then" "create" "an" "X" "/" "X" token_colors token_subtypes token_types "token" "," "where" "X" "is" "the" "number" "of" filter_plural "destroyed" "this" "way"

/* A life-loss sentence followed by two actions of the ability controller. */
/* @sem Instruction::[...$clause_lose_life, ...$clause_you_draw_gain] */
/* @prefer always */
instructions_loss_then_you_draw_gain ::= clause_lose_life "." clause_you_draw_gain

/* @sem Instruction::[Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::AbilityController), $draw_base)}, Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::AbilityController), $gain_life_base)}] */
clause_you_draw_gain ::= "you" draw_base "and" gain_life_base

/* A spent-color condition may govern a search sentence. */
/* @prefer always */
/* @sem Instruction::[If{condition:$condition_blue_pair_spent, then:Program{instructions:$search_single_that_card_graveyard}, otherwise:Program{}}] */
blue_pair_conditional_search ::= "if" condition_blue_pair_spent "," search_single_that_card_graveyard

/* A comma joins an immediate action to an opponent’s independent choice. */
/* @sem Instruction::[...$clause, Effect{result:@next, operation:$opponent_may_perform_choice}] */
conjoined_comma_opponent_choice ::= clause "," "and" opponent_may_perform_choice

/* A postcondition ends before the following unconditional note. */
/* @sem Instruction::[...$clause_imperative_postcondition, Effect{result:@next, operation:$note_information}] */
/* @prefer always */
instructions_postcondition_then_note ::= clause_imperative_postcondition "." "then" note_information

/* Preserve the fronted permission in this pair while leaving other modes independent. */
/* @sem Mode::[$mode_extreme_sacrifice, $mode_fronted_top_exile, ...$modes] */
/* @prefer always */
modes_extreme_sacrifice_then_exile ::= mode_extreme_sacrifice NEWLINE mode_fronted_top_exile NEWLINE modes

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:$clause_opponent_sacrifice_extreme_union}, weight:1}) */
mode_extreme_sacrifice ::= "•" clause_opponent_sacrifice_extreme_union "."

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:$clause_top_exile_play_those}, weight:1}) */
mode_fronted_top_exile ::= "•" clause_top_exile_play_those "."

/* A modal token copy retains independent target and copied characteristics. */
/* @sem Mode::@scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$copy_typed_token}]}, weight:1}) */
mode_copy_typed_token ::= "•" copy_typed_token "."

/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$target_permanent, exceptions:[CopyException::SetPowerToughness{power:$value, toughness:$value_2}, CopyException::AddCreatureTypes($becomes_types), CopyException::AddCardTypes([Creature]), CopyException::AddAbilities([Keyword($keyword_name)])]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
copy_typed_token ::= "create" "a" "token" "that's" "a" "copy" "of" target_permanent "," "except" "it's" "a" value "/" value becomes_types "creature" "with" keyword_name "in" "addition" "to" "its" "other" "types"

/* The cast-time header applies to any following modal copy and modes. */
/* @prefer always */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Conditional{condition:Controls{player:AbilityController, filter:State(Commander), minimum:1}, then:Constant(2), otherwise:Constant(1)}}, options:[$mode_copy_typed_token, ...$modes], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_commander_copy_modes ::= "choose" "one" "." "if" "you" "control" "a" "commander" "as" "you" "cast" "this" "spell" "," "you" "may" "choose" "both" "instead" "." NEWLINE mode_copy_typed_token NEWLINE modes

/* @prefer always */
/* @sem Ability::[$static_each_other_kind_pump_keyword] */
abilities_last_other_kind ::= static_each_other_kind_pump_keyword

/* @prefer always */
