triggered_labelled_tail ::= triggered_labelled_tail_one | triggered_labelled_tail_more

triggered_labelled_tail_mode ::= mode_repair_return | mode_impound_exile | mode

/* @prefer always */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One($target_card_mana_value_minimum_yours), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, weight:1}) */
mode_repair_return ::= "•" "Repair" "—" "return" target_card_mana_value_minimum_yours "to" "your" "hand" "."

/* @prefer always */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AnyOf([$noun, $noun_2])}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}, weight:1}) */
mode_impound_exile ::= "•" "Impound" "—" "exile" "target" noun "or" noun "."

/* These modes are scoped to an opponent-damage event, which establishes the opponent. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[$opponent_damage_mode, $opponent_damage_mode_2, $opponent_damage_mode_3], rules:ModeRules{repetition:OnceEach, availability:Unchosen(ThisTurn), targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
opponent_damage_modes ::= "choose" "one" "that" "hasn't" "been" "chosen" "this" "turn" "—" NEWLINE opponent_damage_mode NEWLINE opponent_damage_mode NEWLINE opponent_damage_mode

opponent_damage_mode ::= opponent_damage_destroy_mode | opponent_damage_other_mode | opponent_damage_exile_mode

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ControlledBy(One(EventSubject))])}), index:0}), regeneration:true}}]}, weight:1}) */
opponent_damage_destroy_mode ::= "•" "destroy" "target" noun "that" "opponent" "controls" "."

/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(Intersection([OthersThan(EventSubject), OpponentsOf(AbilityController)])), amount:$number, preventable:true}}]}, weight:1}) */
opponent_damage_other_mode ::= "•" "this" "creature" "deals" number "damage" "to" "each" "other" "opponent" "."

/* The permission consumes the precise top-card exile produced here. */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:$opponent_damage_exile_instructions}, weight:1}) */
opponent_damage_exile_mode ::= "•" opponent_damage_exile_instructions "."

/* This condition composes with its own scoped exile-and-return program. */
