combat_exile_return_program ::= instructions_exile_return_him_shared "."

/* The explicit controller is the antecedent of the other-player population. */
/* @sem Instruction::[Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::AbilityController), $verb_operation_base)}, Effect{result:@next, operation:@apply(PlayerSet::OthersThan(PlayerRef::AbilityController), $verb_operation_third)}] */
clause_you_then_other_player ::= "you" verb_operation_base "," "then" "each" "other" "player" verb_operation_third

/* A tapped creation uses the same subject binding as other imperative actions. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::AbilityController), $create_tapped_base)}]} */
weighted_tapped_creation_program ::= create_tapped_base "."

/* Keep the exile and its permission together so the receipt has a proved producer. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:Either, filter:Any})], duration:$until_end_of_your_next_turn, evaluation:LiveObjects}}]} */
weighted_top_exile_play_program ::= exile_top_cards_of_your_library "." until_end_of_your_next_turn "," "you" "may" "play" "them" "."

/* The temporary trigger owns its own announcement and result scope. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:@scope(Operation::CreateTrigger{event:$event_cast, duration:$until_end_of_your_next_turn, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$deal_damage}]}, once:false})}]} */
weighted_timed_event_program ::= until_end_of_your_next_turn "," "whenever" event_cast "," deal_damage "."

/* Fixed count; each option has its own target announcement. */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$player_target_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:Distinct, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_fixed_distinct_player_modes ::= "choose" number_words "." "each" "mode" "must" "target" "a" "different" "player" "." NEWLINE player_target_modes

commander_modes ::= commander_modes_one | commander_modes_more

