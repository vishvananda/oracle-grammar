/* Whole cards. A line holds one ability, or keywords separated by commas.
   An absent ability list is a vanilla card. */
card ::= card_casting_reveal_property_damage | card_casting_artifact_counter_placement | card_casting_reveal_compared_exile | card_casting_sacrifice_mana | card_regular | contextual_single_mill_card | player_memory_card | card_single_casting_discard | card_cast_sacrifice_modal | card_casting_exile_property_damage | card_casting_sacrifice_total_damage | card_casting_discard_total_damage | card_casting_reveal_life | card_casting_sacrifice_life | card_buyback_casting_sacrifice_gain

/* @sem Ability::[...$abilities] */
card_regular ::= abilities?

abilities ::= closed_cantrip_more | stage_owning_abilities | backup_abilities | abilities_common | abilities_one | abilities_more | abilities_comma | entry_copy_other_abilities | abilities_controlled_entry_pair_more | abilities_last_other_kind | abilities_during_turn_look_and_play_h3 | abilities_enchant_controlled_is_subtype_h3 | abilities_haste_search_three_zones_comma_h3 | abilities_delve_shared_keywords_h3

/* Keywords Oracle prints without reminder text share a line. */
/* @sem Ability::[$keyword_common, ...$common_tail] */
abilities_common ::= keyword_common "," common_tail

common_tail ::= abilities_common | common_then | common_last

/* @sem Ability::[$keyword_common] */
common_last ::= keyword_common

/* @sem Ability::[$keyword_common, ...$abilities] */
common_then ::= keyword_common NEWLINE abilities

/* @sem Ability::Keyword($keyword_common_name) */
keyword_common ::= keyword_common_name

keyword_common_name ::= kn_flying | kn_first_strike | kn_double_strike | kn_trample | kn_vigilance | kn_haste
    | kn_reach | kn_lifelink | kn_menace | kn_deathtouch | kn_indestructible | kn_defender

abilities_one ::= line

/* @sem Ability::[...$line, ...$abilities] */
abilities_more ::= line NEWLINE abilities

line ::= line_two_hexproof_qualities | line_typecycling_pair_reminder | repeat_cascade_reminded_line | line_contextual_reminder | line_root_trigger_creature_spellbook | line_spell_prowl_grant_reminded | line_gift_additional_cost | tail_line | line_player_objects_protection | line_conditional_keyword_arms | line_inline_conditional_statics | line_host_two_conditions | line_host_base_restrictions | line_host_lose_all_quoted_grant | line_max_speed_static_pair | line_additional_enter_leave_triggers | line_triggers_additional | line_player_creature_chosen_protection | line_mixed_damage_zone | line_battlefield_and_stack_traits | line_graveyard_specialize | line_labelled_graveyard_specialize | line_kicker_uncounterable_damage | line_self_attack_or_target_joined | line_self_entry_or_target_opponent_joined | line_self_attack_or_target | line_self_entry_or_target_opponent | line_additional_graveyard_trigger | line_library_hand_perpetual_colors | line_library_hand_perpetual_colors_labelled | line_own_or_other_faceup | line_named_conjure_total_once | line_death_or_library_graveyard | line_spell_paragraphs | line_spell_paragraphs_quoted | line_spell_paragraphs_where | line_oath | line_kicker_branch_paragraphs | line_saddled_source_copy | line_kicker_search_override | line_own_exclusion_payment | line_own_exclusion_pump | line_own_exclusion_perpetual | line_live_library_exile | line_own_source_efreet | line_own_source_osgood | line_own_source_flamespeaker | line_own_source_vincent | line_upkeep_graveyard_eligibility | line_upkeep_command_eligibility | line_optional_self_return_keyword | line_independent_static_list | line_mana_type_replacements | line_global_cross_zone_colors | line_commander_pregame | line_pair_enters_owned_origin | line_private_zone_static | line_static_conditional_followup | line_zone_entry_prohibitions | line_first_draw_reveal | line_first_draw_copy | line_tapped_or_activation | line_target_player_or_object | line_hexproof_recipients | line_attached_restrictions | line_attached_rule_other_auras | line_plural_target_ban | line_cast_or_cycle | line_cast_or_cycle_if | line_trigger_suppression | line_pump_owner_attack_exception | conditional_casting_reductions | line_self_or_attached_attacks | line_station_explicit | line_source_zone_permission | source_zone_return_ability | line_additional_exile_trigger | line_conditional_damage_protection | line_self_skip_untap | line_entry_tapped_and_changes | line_dies_or_exiled_battlefield | line_ability_suppression | line_cross_zone_characteristics | line_pair_controlled_self_or_enters_original | line_pair_controlled_self_or_enters | line_named_flash_if | mechanic_rulebreaker | line_player_prohibitions | line_pair_repeated | line_dual_kicker | line_dual_kicker_reminded | line_one | line_saga | line_mechanic | keyword_protection_pair | line_pair_attacks_blocks | line_pair_attacks_blocks_if | line_pair_enters_put | line_pair_blocks_blocked | line_pair_blocks_or_blocked | line_pair_blocks_or_blocked_if | line_pair_self_or_enters | line_pair_cast_or_enters | reminder_group_abilities | line_cast_or_attack_exile_return | line_cause_additional_trigger | spell_x_draw_replacement_exile | casting_additional_cost_with_x_cap | line_targetable_creatures_ward | line_target_opponent_protect_phase | line_counter_exile_graveyard_paragraph | casting_paired_sacrifice_reductions | line_combat_coin_redirect | line_vote_search_return_exile | line_vote_search_filtered_return_exile | line_modal_snow_spent_return | line_equipped_keyword_chosen_identity | saga_graveyard_recovery_chapters | line_pair_phases_out_or_leaves | line_number_loop_x_restriction | line_activation_battlefield_or_graveyard | line_targeting_permission | line_more_opponents_prohibition | line_comparison_cast_ellipsis | line_casting_sacrifice_value_search | line_cast_sacrifice_test | line_sacrifice_cost_mana_value | line_sacrifice_and_owned_card_delayed | line_colored_creature_or_spell_damage | static_form_grants_goad | line_casting_sacrifice