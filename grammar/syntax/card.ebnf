spell_ability ::= spell_commander_sacrifice_exile_modes | spell_exile_and_counter_stack | spell_counters_three_distinct_targets | spell_population_keyword | spell_graveyard_pump_then | spell_unpreventable_damage_distribution | spell_with_conditional_block_limit | spell_with_reminded_block_limit | ordinary_spell_ability | spell_opponent_target_damage | spell_opponent_target_damage_more | spell_opponent_population_damage | spell_next_copy_conditional_additional | spell_cast_named_pair_paragraph
/* "Cipher" closing a spell: its last instruction lets you encode the spell card on a
   creature you control. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$instructions, Effect{result:@next, operation:KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Cipher, objects:One(Source)}}]}} */
spell_cipher ::= instructions "." NEWLINE "Cipher"

/* "As you cast this spell" fixes an X that the spell's targets count, which the
   announcement does as the spell is cast. */
/* @sem Ability::Spell{announcement:@announcement, body:@where($program_plain, $value)} */
spell_where_x_as_cast ::= program_plain "," "where" "X" "is" value "as" "you" "cast" "this" "spell" "."

/* @sem Ability::Spell{announcement:Announcement{modes:$mode_selection}, body:Program{}} */
spell_modal ::= mode_selection
/* "Target spell or permanent" is one target of either kind; each kind is an
   implied mode with its own effect: a spell's color changes on the stack, a
   permanent's indefinitely. */
/* @sem Ability::Spell{announcement:Announcement{modes:ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:ChangeSpell{subject:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:Any}), index:0}), changes:[Colors{mode:Set, colors:$token_colors}]}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:Any}), index:0})), changes:[Colors{mode:Set, colors:$token_colors}], duration:Indefinite, evaluation:Snapshot}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied}}, body:Program{}} */
spell_spell_or_permanent_color ::= "target" "spell" "or" "permanent" "becomes" token_colors "."

/* CR 702.120: escalate charges its cost for each mode chosen beyond the first. */
spell_escalate ::= spell_escalate_more | spell_escalate_both
/* @sem Ability::Spell{announcement:Announcement{modes:ModeSelection{count:ModeCount{minimum:Expr::Constant(1), maximum:@length($modes)}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required, surcharge:$escalate_payment}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}}}, body:Program{}} */
spell_escalate_more ::= "escalate" escalate_payment NEWLINE "choose" "one" "or" "more" "—" NEWLINE modes
/* @sem Ability::Spell{announcement:Announcement{modes:ModeSelection{count:ModeCount{minimum:Expr::Constant(1), maximum:Expr::Constant(2)}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required, surcharge:$escalate_payment}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}}}, body:Program{}} */
spell_escalate_both ::= "escalate" escalate_payment NEWLINE "choose" "one" "or" "both" "—" NEWLINE modes

escalate_payment ::= keyword_payment | escalate_explained_payment
/* @sem $keyword_payment */
escalate_explained_payment ::= keyword_payment "(" "pay" "this" "cost" "for" "each" "mode" "chosen" "beyond" "the" "first" "." ")"

/* @sem Ability::Activated{origin:Ordinary, cost:$activation_cost, limits:ActivationLimits{}, announcement:@announcement, body:$program_sentence} */
activated_ability ::= activation_cost ":" program_sentence

activated_forecast ::= forecast_program | forecast_modal

/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{once_each_turn:true, keyword:Forecast}, announcement:@announcement, body:$program_sentence})} */
forecast_program ::= "forecast" "—" cost ":" program_sentence

/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{once_each_turn:true, keyword:Forecast}, announcement:Announcement{modes:$mode_selection}, body:Program{}})} */
forecast_modal ::= "forecast" "—" cost ":" mode_selection

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{once_each_turn:true, keyword:Boast}, announcement:@announcement, body:$program_sentence} */
activated_boast ::= "boast" "—" cost ":" program_sentence

/* Power-up's native tag owns its cost reduction and per-ability use limit. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{once:true, keyword:PowerUp}, announcement:@announcement, body:$program_sentence} */
activated_power_up ::= "power-up" "—" cost ":" program_sentence

activated_limited ::= activated_measured_sacrifice_draw | activated_limited_general | activated_nonzero_power_reanimation | activated_random_draw_nonzero | activated_nonzero_retained_land
/* An activation limit written after the roll still precedes the roll's table. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:Program{instructions:[...$die_table_head, ...$die_rows]}} */
activated_limited_die_table ::= cost ":" die_table_head "." activation_limits "." NEWLINE die_rows

activation_limits ::= limit_x_nonzero_your_turn | limit_instant | limit_once_ever_condition | limit_condition_sorcery | limit_upkeep_condition | limit_outside_combat | limit_cost_less_each | limit_cost_less_each_sorcery | limit_spend_red | limit_spend_black | limit_once | limit_once_ever | limit_sorcery | limit_sorcery_once | limit_sorcery_condition | limit_condition | limit_condition_once | limit_any_player | limit_any_player_sorcery | limit_max_per_turn | limit_your_turn_and_condition | limit_source_owner | limit_sorcery_once_ever | limit_condition_once_ever | limit_max_per_turn_value | limit_x_nonzero_sorcery | limit_spend_chosen_color | limit_once_ever_window | limit_any_player_own_turn | limit_condition_and_your_turn | limit_opponents_only | limit_any_player_upkeep | limit_mana_instead_sorcery | limit_any_player_draw_step | limit_any_player_own_turn_before_end | limit_opponents_sorcery | limit_once_if_object_kind | limit_controlled_either_a_an | limit_controlled_either_an_a | limit_cost_more_each | limit_live_reduction_once | limit_conditional_cost_reduction | limit_cost_less_window | limit_conditional_blue_reduction | limit_once_condition | limit_x_counter_count | limit_conditional_reduction_once | limit_conditional_reduction | limit_x_card_count | limit_window_blocking_once | limit_controlled_color_damage_sorcery | limit_another_activated_ability | limit_uncopyable_nonzero_x | limit_before_attackers | limit_only_your_turn | limit_controlled_either_a_a | limit_attacked_player_declare_attackers | limit_variable_activation_reduction | limit_opponents_turn_before_combat | limit_x_controlled_greatest_sorcery | limit_upkeep_not_enchanted | limit_target_count_reduction

/* Oracle writes two activations as "twice" and more as "N times". */
/* @sem ActivationLimits::ActivationLimits{modifiers:[Change::ActivationRule(MaxPerTurn($activation_times))]} */
limit_max_per_turn ::= "activate" "no" "more" "than" activation_times "each" "turn"
activation_times ::= revealed_stat_factor | activation_n_times

/* @sem $activation_times_count */
activation_n_times ::= activation_times_count "times"
activation_times_count ::= n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10

/* @sem ActivationLimits::ActivationLimits{once_each_turn:true, sorcery:true} */
limit_sorcery_once ::= "activate" "only" "as" "a" "sorcery" "and" "only" "once" "each" "turn"

/* Both restrictions belong to this activation, independently of its body. */
/* @sem ActivationLimits::ActivationLimits{sorcery:true, condition:$condition} */
limit_sorcery_condition ::= "activate" "only" "as" "a" "sorcery" "and" "only" "if" condition

/* @sem ActivationLimits::ActivationLimits{activators:All} */
limit_any_player ::= "any" "player" "may" "activate" "this" "ability"

/* @sem ActivationLimits::ActivationLimits{activators:All, sorcery:true} */
limit_any_player_sorcery ::= "any" "player" "may" "activate" "this" "ability" "but" "only" "as" "a" "sorcery"

/* @sem ActivationLimits::ActivationLimits{modifiers:$activation_counter_reduction} */
limit_cost_less_each ::= activation_counter_reduction
/* @sem ActivationLimits::ActivationLimits{sorcery:true, modifiers:$activation_counter_reduction} */
limit_cost_less_each_sorcery ::= activation_counter_reduction "." "activate" "only" "as" "a" "sorcery"

/* The written amount multiplies the population, independently of timing. */
/* @sem Change::[ActivationRule(Cost{modifier:Reduce{reductions:[ManaReduction{amount:@times($braced_amount, $count_each)}], spill_into_generic:true}})] */
activation_counter_reduction ::= "this" "ability" "costs" braced_amount "less" "to" "activate" "for" "each" count_each

/* @sem ActivationLimits::ActivationLimits{modifiers:[Change::ActivationRule(RestrictMana{portion:X, color:Red})]} */
limit_spend_red ::= "spend" "only" "red" "mana" "on" "X"

/* @sem ActivationLimits::ActivationLimits{modifiers:[Change::ActivationRule(RestrictMana{portion:X, color:Black})]} */
limit_spend_black ::= "spend" "only" "black" "mana" "on" "X"

/* @sem ActivationLimits::ActivationLimits{once_each_turn:true} */
limit_once ::= "activate" "only" "once" "each" "turn"

/* "Activate only once.": one activation for as long as this object is this object. */
/* @sem ActivationLimits::ActivationLimits{once:true} */
limit_once_ever ::= "activate" "only" "once"

/* @sem ActivationLimits::ActivationLimits{sorcery:true} */
limit_sorcery ::= "activate" "only" "as" "a" "sorcery"

/* @sem ActivationLimits::ActivationLimits{condition:$activation_window} */
limit_condition ::= "activate" "only" activation_window

/* @sem ActivationLimits::ActivationLimits{once_each_turn:true, condition:$activation_window} */
limit_condition_once ::= "activate" "only" activation_window "and" "only" "once" "each" "turn"

/* @sem ActivationLimits::ActivationLimits{condition:Not(Window(Combat))} */
limit_outside_combat ::= "you" "can't" "activate" "this" "ability" "during" "combat"

/* @sem Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[CostPart::Loyalty($loyalty_heading)]}, limits:ActivationLimits{sorcery:true}, announcement:@announcement, body:$loyalty_program_sentence} */
activated_loyalty ::= loyalty_heading ":" loyalty_program_sentence

/* Oracle faces spell the loyalty change directly. Bracketed headings are
   also accepted by the same activation rules, with the same signed amount. */
loyalty_heading ::= loyalty_bracketed | loyalty
/* @sem $loyalty */
/* @prefer always */
loyalty_bracketed ::= "[" loyalty "]"

loyalty_positive_heading ::= loyalty_positive_bracketed | loyalty_plus
/* @sem $loyalty_plus */
/* @prefer always */
loyalty_positive_bracketed ::= "[" loyalty_plus "]"

loyalty_zero_heading ::= loyalty_zero_bracketed | loyalty_zero_unbracketed
/* @sem () */
/* @prefer always */
loyalty_zero_bracketed ::= "[" "0" "]"
/* @sem () */
loyalty_zero_unbracketed ::= "0"

loyalty_x_decrease_heading ::= loyalty_x_decrease_bracketed | loyalty_x_decrease_unbracketed
/* @sem () */
/* @prefer always */
loyalty_x_decrease_bracketed ::= "[" "−" "X" "]"
/* @sem () */
loyalty_x_decrease_unbracketed ::= "−" "X"

loyalty ::= loyalty_plus | loyalty_minus | loyalty_zero

/* @sem $loyalty_number */
loyalty_plus ::= "+" loyalty_number

/* @sem @negate($loyalty_number) */
loyalty_minus ::= "−" loyalty_number

/* @sem Expr::Constant(0) */
loyalty_zero ::= "0"

loyalty_number ::= number_digits | number_x

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}} */
activated_modal ::= cost ":" mode_selection

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence} */
triggered_ability ::= event_clause "," program_sentence

/* A source's own from-anywhere trigger functions in the destination graveyard.
   Token copies also trigger; the source reference is not a nontoken-card test. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:ZoneChange{objects:@and($event_self, ObjectFilter::OwnedBy(All)), to:Graveyard}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})} */
triggered_in_graveyard ::= ("when" | "whenever") event_self "is" "put" "into" "a" "graveyard" "from" "anywhere" "," program_sentence

/* A trigger that checks its card is in your graveyard functions there. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$event_clause, intervening_if:ObjectMatches{object:Source, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})} */
triggered_if_in_graveyard ::= event_clause "," "if" "this" "card" "is" "in" "your" "graveyard" "," program_sentence
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$turn_event, intervening_if:ObjectMatches{object:Source, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})} */
triggered_turn_if_in_graveyard ::= "at" turn_event "," "if" "this" "card" "is" "in" "your" "graveyard" "," program_sentence

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{per_turn:1}, announcement:@announcement, body:$program_sentence} */
triggered_once ::= event_clause "," program_sentence "this" "ability" "triggers" "only" "once" "each" "turn" "."

/* With no event payload read, the cap makes an individual matcher equivalent
   to one group trigger. The guard runs after all references are bound. */
/* @sem Ability::@event_free_once(Ability::Triggered{event:$limited_death_clause, limits:TriggerLimits{per_turn:1}, announcement:@announcement, body:$program_sentence}) */
triggered_once_death ::= limited_death_clause "," program_sentence "this" "ability" "triggers" "only" "once" "each" "turn" "."

event_clause ::= event_when | event_whenever | event_clause_opponent_three | event_clause_enchanted_mutual_attack | first_counters_on_permanent_clause | event_clause_batch_alternatives | event_clause_batch_alternatives_reversed | event_when_and_whenever_solve_case | exile_from_two_zones_event | event_clause_counter_put_on | entry_and_card_play_clause | cast_spell_target_threshold | whenever_cast_or_activate_card_ability | state_keyword_when | state_source_power_when | state_source_counters_when | event_when_this_class_level | event_clause_batch_passive_player | whenever_filtered_card_leaves_your_graveyard | private_or_controlled_exile_batch_clause | private_or_controlled_exile_batch_clause_reverse | event_clause_you_put_single_counter_controlled | event_permanent_x_or_nonmana_activation | event_when_ability_causes_chosen_mana | event_whenever_ability_causes_chosen_mana | event_clause_you_activate_targeting_ability | whenever_team_other_entry | event_when_and_graveyard_departure | event_nonowner_controls_holder | controlled_exile_or_own_hand_event | event_clause_class_level_when | referenced_actions_or_target_clause | when_you_remove_named_counter | event_object_trains_shared | first_any_counters_on_creature_clause | event_random_choices_union | source_damage_death_clause | shared_source_or_filtered_combat_event | controller_cast_except_ordinal_clause | clause_source_and_subtype_attack | event_whenever_you_become_monarch | whenever_controlled_colored_source_damage_batch | shared_damage_or_death_clause | entry_and_activation_clause | controlled_entry_and_activation_clause | event_cast_mana_value_equal_counters | shared_controlled_entry_zone_clause | event_clause_player_first_qualified_spell | whenever_you_roll_ordinal_die | event_this_enchantment_entry | event_this_creature_crews_vehicle | controlled_attacks_or_enters_attacking | event_clause_controlled_damage_and_caused_loss | event_pair_combat_deaths | event_controlled_equal_stats_entry | event_controlled_equal_stats_entry_normalized | whenever_cast_except_instant | whenever_cast_except_sorcery | event_clause_you_win_clash | event_suspected_controlled_attack | active_player_ordinal_draw_clause | shared_saddles_or_crews_main_clause | battlefield_ability_activation_clause | coin_flip_winner_clause | event_clause_station_source | nth_counter_placed_clause | event_opponents_controlled_attack_count | shared_event_and_cast_characteristic | shared_recurring_controller_turn_clause | whenever_other_four_subtypes_enter | last_named_counter_removed_clause | entry_and_reference_faceup_clause | whenever_three_graveyard_alternatives | whenever_you_play_exiled_card | nth_named_counter_event_clause | event_cast_typed_card_pair | event_clause_you_attack_batch_defender | target_you_and_controlled_batch | whenever_controlled_nontoken_entry

/* @sem $event */
/* @prefer once */
event_when ::= "when" event

/* @sem $event */
/* @prefer recurs */
event_whenever ::= "whenever" event

/* @sem Ability::Triggered{event:$event_clause, intervening_if:$trigger_condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence} */
triggered_if ::= event_clause "," "if" trigger_condition "," program_sentence

/* A source spell's cast trigger functions on the stack. The condition precedes
   target resolution and belongs to the trigger, including a kicked-state test. */
/* @sem Ability::Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:Spell{event:Cast, players:One(AbilityController), spells:$event_self}, intervening_if:$cast_trigger_condition, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence})} */
triggered_cast_if ::= "when" "you" "cast" event_self "," "if" cast_trigger_condition "," program_sentence

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$program_sentence} */
triggered_turn ::= "at" turn_event "," program_sentence

triggered_turn_if ::= triggered_turn_if_attacked_bare | triggered_turn_if_standard

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}} */
triggered_modal ::= event_clause "," mode_selection

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}} */
triggered_turn_modal ::= "at" turn_event "," mode_selection

mode_selection ::= choose_fixed_distinct_player_modes | choose_commander_copy_modes | choose_up_to_number | choose_conditional_one_or_more | for_each_counter_kind_mixed_modes | choose_characteristic_tokens_unchosen_turn | choose_any_number | choose_cast_controlled_subtype | choose_graveyard_types_or_more | choose_number_random | choose_random_unless | choose_number | choose_number_repeatable | choose_one_commander_both | choose_one_unchosen | choose_one_unchosen_turn | choose_one_or_both | choose_one_or_more | shared_pump_two_modes | choose_one_control_two_both | choose_counter_mixed_modes | choose_single_action_cast_count | choose_cast_controlled_foreign | choose_one_unchosen_last_combat | choose_distinct_player_modes | choose_up_to_modes_chosen | choose_graveyard_permanents_or_more | choose_opponent_number | cast_control_damage_raised | cast_control_damage_postposed | choose_one_unchosen_turn_period | choose_one_unchosen_turn_final_scry | choose_one_or_both_distinct_players | choose_both_distinct_player_modes | choose_up_to_defined_x | choose_up_to_return_modes | choose_one_if_life_both | return_mixed_target_conditional_perpetual | other_permanent_or_spell_airbend_modes | mixed_retarget_holder_modes | choose_both_distinct_players | choose_one_commander_both_control_copy | choose_two_gix_modes | choose_optional_distinct_player_modes | random_shared_token_characteristics | choose_x_repeatable | choose_commander_extreme_modes

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_number ::= "choose" number_words ("—" | ".") NEWLINE modes

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$modes, rules:ModeRules{repetition:MayRepeat, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_number_repeatable ::= "choose" number_words "." "you" "may" "choose" "the" "same" "mode" "more" "than" "once" "." NEWLINE modes

/* @prefer always */
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Expr::Constant(1), maximum:Expr::Conditional{condition:Controls{player:AbilityController, filter:State(Commander), minimum:1}, then:Constant(2), otherwise:Constant(1)}}, options:$commander_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_one_commander_both ::= "choose" "one" "." "if" "you" "control" "a" "commander" "as" "you" "cast" "this" "spell" "," "you" "may" "choose" "both" "instead" "." NEWLINE commander_modes

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Expr::Constant(1), maximum:Expr::Constant(1)}, options:$unchosen_modes, rules:ModeRules{repetition:OnceEach, availability:Unchosen(ThisGame), targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_one_unchosen ::= "choose" "one" "that" "hasn't" "been" "chosen" "—" NEWLINE unchosen_modes
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Expr::Constant(1), maximum:Expr::Constant(1)}, options:$unchosen_modes, rules:ModeRules{repetition:OnceEach, availability:Unchosen(ThisTurn), targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
/* @prefer always */
choose_one_unchosen_turn ::= "choose" "one" "that" "hasn't" "been" "chosen" "this" "turn" "—" NEWLINE unchosen_modes

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Expr::Constant(1), maximum:@length($modes)}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_one_or_more ::= "choose" "one" "or" "more" "—" NEWLINE modes

/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Expr::Constant(1), maximum:Expr::Constant(2)}, options:$modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
choose_one_or_both ::= "choose" "one" "or" "both" "—" NEWLINE modes

modes ::= modes_extreme_sacrifice_then_exile | modes_land_then_phase | modes_one | modes_more | modes_reminded_indestructible_then_more

/* @sem Mode::[$mode] */
modes_one ::= mode

/* @sem Mode::[$mode, ...$modes] */
modes_more ::= mode NEWLINE modes

/* A reminder on the last mode belongs to the surrounding ability. */
/* @sem Mode::[$mode_reminded_indestructible, ...$modes] */
modes_reminded_indestructible_then_more ::= mode_reminded_indestructible NEWLINE modes

/* Unchosen menus with an inline token description keep the option's scope. */
unchosen_modes ::= modes | modes_with_token_reminder
modes_with_token_reminder ::= modes_reminded_token_then_more | modes_before_reminded_token
/* @sem Mode::[$mode, ...$modes_with_token_reminder] */
modes_before_reminded_token ::= mode NEWLINE modes_with_token_reminder

/* @sem Mode::[$mode_reminded_token, ...$modes] */
modes_reminded_token_then_more ::= mode_reminded_token NEWLINE modes
mode_reminded_token ::= mode_reminded_token_plain | mode_reminded_token_labelled
/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:$named_token_reminded}, weight:1}) */
mode_reminded_token_plain ::= "•" named_token_reminded
/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:$named_token_reminded}, weight:1}) */
mode_reminded_token_labelled ::= "•" modal_flavor_words "—" named_token_reminded

mode ::= mode_flavor_pilgrimage | mode_flavor_counter_followup | mode_look_announced_x_hand | mode_named_spell_prohibition | mode_target_combat_activation_prohibition | counter_transfer_mode | counter_removal_draw_mode | suspended_counter_remove_mode | suspended_counter_put_mode | mode_plain | mode_flavor_labelled | mode_counter_target_power_damage | word_replacement_mode | mode_feed_history | mode_friends_history | mode_remove_object_counters_prevent | mode_remove_opponent_counters_prevent | mode_negative_population_pump | mode_exile_opponent_graveyard_loss | mode_copy_opponent_spell_twice | mode_copy_opponent_tokens_cleanup | mode_scout_flavor | mode_bring_down_flavor | mode_source_becomes_stats_keyword | mode_source_becomes_stats | mode_copy_typed_token | mode_target_opponents_extreme_sacrifice_life | mode_reminded_spell_copy
/* @sem @scope(Mode::Mode{announcement:@announcement, body:$program_sentence, weight:1}) */
mode_plain ::= "•" program_sentence

/* A spell-copy mode can carry the general rule about copies of permanents. */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$target_stack_spell, times:Constant(1), targets:May}}]}, weight:1}) */
mode_reminded_spell_copy ::= "•" "copy" target_stack_spell "." copy_single_retarget_permission "." "(" permanent_spell_copy_rule_words ")"

