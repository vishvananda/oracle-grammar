spell_cast_named_pair_paragraph ::= instructions "." NEWLINE "if" condition_cast_named_spell_pair "," program "."

/* Paired X-counter entry and doubled mill keep the entering pronoun on legendary sources. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(ObjectRef::@it)), kind:$counter_kind, amount:AnnouncedX}]}}, Effect{result:@next, operation:Mill{players:One(PlayerRef::AbilityController), amount:@times(Expr::Constant(2), Expr::AnnouncedX)}}] */
instructions_put_x_counters_it_and_mill_twice ::= "put" "X" counter_kind "counters" "on" "it" "and" "mill" "twice" "X" "cards"

/* Four separately scoped modes share an explicit life-loss instruction. */
/* @prefer always */
/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:Announcement{modes:ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:$number}}, ...$shared_prefix_mode_body]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:$number}}, ...$shared_prefix_mode_body_2]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:$number}}, ...$shared_prefix_mode_body_3]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:$number}}, ...$shared_prefix_mode_body_4]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Unchosen(ThisGame), targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}}}, body:Program{}} */
triggered_four_unchosen_life_modes ::= "at" turn_event "," "choose" "one" "that" "hasn't" "been" "chosen" "and" "you" "lose" number "life" "—" NEWLINE "•" shared_prefix_mode_body "." NEWLINE "•" shared_prefix_mode_body "." NEWLINE "•" shared_prefix_mode_body "." NEWLINE "•" shared_prefix_mode_body "."

shared_prefix_mode_body ::= shared_source_exile_return_opponent_him | instructions

