/* Card-characteristic explanations are separate from the card's abilities. */
card_text ::= card_text_land_creature_play_cost | card_text_legendary_instant | card_station_raw_planet | card_text_deck_identity_color | card_text_counted_power_example | card_text_transmute_value | card_text_retains_artifact_type | card_text_food_adventure_reminded | card_text_no_mana_cost | card_text_meld_with | card_text_embalm_reminder | card_text_eternalize_reminder | card_text_compleated | card_text_amplify | card_text_amplify_after_abilities | card_station_before_three_titled | card_station_raw | card_station_raw_before | card_station_plain | card_station_before | card_station_explicit | card_text_land | card_text_land_only | card_text_land_cost | card_text_cost_land | card_text_land_cost_only | card_text_cost_land_only | card_text_noted | card_text_notes_only | card_text_monocolored_hybrid | card_text_prowl | card_text_prowl_after_abilities | card_text_plain | card_text_adventure_reminder | card_text_land_adventure_reminder | card_text_room_reminder | card_text_siege_reminder | card_text_ongoing_scheme_reminder | card_text_omen_reminder | card_text_omen_also_shuffle | card_text_face_up_conspiracy | card_text_legendary_sorcery | card_text_assist | card_text_transforms_from

/* @sem CardSurface::CardSurface{notes:$cost_notes, abilities:$card} */
card_text_noted ::= cost_notes NEWLINE card
/* @sem CardSurface::CardSurface{notes:$cost_notes} */
card_text_notes_only ::= cost_notes
/* @sem CardSurface::CardSurface{abilities:$card} */
card_text_plain ::= card

/* The glyph and total are checked against the current face's printed cost. */
/* @sem CardSurface::CardSurface{monocolored_hybrid:$monocolored_hybrid_note, abilities:$card} */
card_text_monocolored_hybrid ::= monocolored_hybrid_note NEWLINE card
/* @sem MonocoloredHybridNote::MonocoloredHybridNote{symbol:@agree($mana_monocolored_hybrid, $monocolored_hybrid_payment), mana_value:$number} */
monocolored_hybrid_note ::= "(" mana_monocolored_hybrid "can" "be" "paid" "with" "any" "two" "mana" "or" "with" monocolored_hybrid_payment "." "this" "card's" "mana" "value" "is" NUMBER "." ")"
/* @sem ManaSymbol::MonocoloredHybrid($note_color) */
monocolored_hybrid_payment ::= note_color

/* These descriptions belong to the two-face layout. The exporter checks the
   original record, including the castable Adventure partner's card type. */
/* @sem CardSurface::CardSurface{abilities:$card, layout_reminder:LayoutReminder::Adventure($adventure_return_type)} */
card_text_adventure_reminder ::= card "(" "then" "exile" "this" "card" "." "you" "may" "cast" "the" adventure_return_type "later" "from" "exile" "." ")"
/* @sem CardSurface::CardSurface{abilities:$card, layout_reminder:LayoutReminder::Adventure(AdventureReturnType::Land)} */
card_text_land_adventure_reminder ::= card "(" "then" "exile" "this" "card" "." "you" "may" "play" "the" "land" "later" "from" "exile" "." ")"
adventure_return_type ::= adventure_return_creature | adventure_return_artifact | adventure_return_enchantment
/* @sem AdventureReturnType::Creature */
adventure_return_creature ::= "creature"
/* @sem AdventureReturnType::Artifact */
adventure_return_artifact ::= "artifact"
/* @sem AdventureReturnType::Enchantment */
adventure_return_enchantment ::= "enchantment"

/* @sem CardSurface::CardSurface{abilities:$card, layout_reminder:LayoutReminder::Room} */
card_text_room_reminder ::= card NEWLINE "(" "you" "may" "cast" "either" "half" "." "that" "door" "unlocks" "on" "the" "battlefield" "." "as" "a" "sorcery" "," "you" "may" "pay" "the" "mana" "cost" "of" "a" "locked" "door" "to" "unlock" "it" "." ")"

/* @sem CardSurface::CardSurface{abilities:$card, layout_reminder:LayoutReminder::Siege} */
card_text_siege_reminder ::= "(" "as" "a" "Siege" "enters" "," "choose" "an" "opponent" "to" "protect" "it" "." "you" "and" "others" "can" "attack" "it" "." "when" "it's" "defeated" "," "exile" "it" "," "then" "cast" "it" "transformed" "." ")" NEWLINE card

/* @sem CardSurface::CardSurface{abilities:$card, layout_reminder:$ongoing_scheme_header} */
card_text_ongoing_scheme_reminder ::= ongoing_scheme_header NEWLINE card

/* @sem LayoutReminder::OngoingScheme */
ongoing_scheme_header ::= "(" ongoing_scheme_description ")"
ongoing_scheme_description ::= ongoing_scheme_until_abandoned | ongoing_scheme_remains_faceup
/* @sem () */
ongoing_scheme_until_abandoned ::= "an" "ongoing" "scheme" "remains" "face" "up" "until" "it's" "abandoned" "."
/* @sem () */
ongoing_scheme_remains_faceup ::= "an" "ongoing" "scheme" "remains" "face" "up" "."

/* @sem CardSurface::CardSurface{abilities:$card, transforms_from:$transform_front_name} */
card_text_transforms_from ::= "(" "transforms" "from" transform_front_name "." ")" NEWLINE card

/* @sem CardSurface::CardSurface{abilities:$card, layout_reminder:LayoutReminder::Omen} */
card_text_omen_reminder ::= card "(" "then" "shuffle" "this" "card" "into" "its" "owner's" "library" "." ")"

/* @sem CardSurface::CardSurface{abilities:$card, layout_reminder:LayoutReminder::FaceUpConspiracy} */
card_text_face_up_conspiracy ::= "(" face_up_conspiracy_start ")" NEWLINE card
    | "(" face_up_conspiracy_start "it" "doesn't" "count" "toward" "your" "minimum" "deck" "size" "." ")" NEWLINE card

/* @sem () */
face_up_conspiracy_start ::= "start" "the" "game" "with" "this" ("conspiracy" | "Conspiracy") "face" "up" "in" "the" "command" "zone" "."


/* @sem CardSurface::CardSurface{abilities:$card, layout_reminder:LayoutReminder::LegendarySorcery} */
card_text_legendary_sorcery ::= "(" "you" "may" "cast" "a" "legendary" "sorcery" "only" "if" "you" "control" "a" "legendary" "creature" "or" "planeswalker" "." ")" NEWLINE card

/* @sem CardSurface::CardSurface{abilities:$card, layout_reminder:LayoutReminder::LegendaryInstant} */
card_text_legendary_instant ::= "(" "you" "may" "cast" "a" "legendary" "instant" "only" "if" "you" "control" "a" "legendary" "creature" "or" "planeswalker" "." ")" NEWLINE card

/* The printed Assist limit names a symbol in the face's own mana cost. */
card_text_assist ::= card_text_assist_fixed | card_text_assist_variable
/* @sem CardSurface::CardSurface{assist_limit:$mana_generic, abilities:[$bare_assist, ...$card]} */
card_text_assist_fixed ::= bare_assist "(" assist_explanation_start mana_generic assist_explanation_end ")" NEWLINE card
/* @sem CardSurface::CardSurface{assist_limit:$mana_x, abilities:[$bare_assist, ...$card]} */
card_text_assist_variable ::= bare_assist "(" assist_explanation_start mana_x assist_explanation_end "you" "choose" "the" "value" "of" "X" "." ")" NEWLINE card
/* @sem () */
assist_explanation_start ::= "another" "player" "can" "pay" "up" "to"
/* @sem () */
assist_explanation_end ::= "of" "this" "spell's" "cost" "."

cost_notes ::= cost_notes_one | cost_notes_more
/* @sem ManaSymbol::[$cost_note] */
cost_notes_one ::= cost_note
/* @sem ManaSymbol::[$cost_note, ...$cost_notes] */
cost_notes_more ::= cost_note NEWLINE cost_notes

cost_note ::= hybrid_cost_note | phyrexian_cost_note | colorless_cost_note | snow_cost_note | rainbow_cost_note
/* @sem ManaSymbol::Color(Colorless) */
colorless_cost_note ::= "(" colorless_explanation_words ")"
/* @sem ManaSymbol::Snow */
snow_cost_note ::= "(" (snow_explanation_words | snow_mana_explanation_words) ")"

/* @sem ManaSymbol::@agree($note_hybrid, $hybrid_explanation) */
hybrid_cost_note ::= "(" note_hybrid "can" "be" hybrid_explanation "." ")"
note_hybrid ::= mana_hybrid | note_hybrid_reversed
/* @sem ManaSymbol::Hybrid($mana_letter_2, $mana_letter) */
note_hybrid_reversed ::= "{" mana_letter "/" mana_letter "}"

hybrid_explanation ::= hybrid_either | hybrid_either_reversed
/* @sem ManaSymbol::Hybrid($note_color, $note_color_2) */
hybrid_either ::= "paid" "with" "either" note_color "or" note_color

/* @sem ManaSymbol::@agree($mana_phyrexian, $phyrexian_explanation) */
phyrexian_cost_note ::= "(" mana_phyrexian "can" "be" phyrexian_explanation "." ")"

/* @sem ManaSymbol::Phyrexian([$note_color]) */
phyrexian_explanation ::= "paid" "with" "either" note_color "or" "2" "life"

/* @sem $mana_letter */
note_color ::= "{" mana_letter "}"

/* Either payment order describes the same declared symbol; preserve its spelling
   with the production key rather than rewriting a native cost's operand order. */
/* @sem ManaSymbol::Hybrid($note_color_2, $note_color) */
hybrid_either_reversed ::= "paid" "with" "either" note_color "or" note_color

/* Station reminders are parsed as complete source declarations, not rewritten. */
/* @sem StationSource::StationSource{minimum:$number} */
station_source_animation ::= "station" "(" "tap" "another" "creature" "you" "control" ":" "put" "charge" "counters" "equal" "to" "its" "power" "on" "this" "Spacecraft" "." "station" "only" "as" "a" "sorcery" "." "it's" "an" "artifact" "creature" "at" NUMBER "⁺" "." ")"

/* The selected striation is supplied by explicit source layout context. */
/* @sem CardSurface::CardSurface{station:true, abilities:$station_block} */
card_station_plain ::= station_block
/* @sem CardSurface::CardSurface{station:true, abilities:[...$abilities, ...$station_block]} */
card_station_before ::= abilities NEWLINE station_block
/* @sem Ability::[Mechanic{mechanic:Station}, ...$station_rows] */
station_block ::= station_heading NEWLINE station_rows
station_heading ::= station_heading_bare
/* @sem () */
station_heading_bare ::= "station"
/* @sem () */
station_heading_reminded ::= station_source
station_rows ::= station_row_one | station_row_more
/* @sem Ability::[CounterStages{counter:Named(ChargeCounter), stages:[_{minimum:$number, abilities:$station_row_abilities}]}] */
station_row_one ::= NUMBER "⁺" "|" station_row_abilities
/* @sem Ability::[...$station_row_one, ...$station_rows] */
station_row_more ::= station_row_one NEWLINE station_rows
station_row_abilities ::= station_row_keyword_have | stage_line | station_row_keywords | station_row_animation | station_row_keyword_lines
/* A row's keywords can head further lines of the same stage; the next row's
   threshold cannot start an ability line. */
/* @sem Ability::[...$station_row_keywords, ...$stage_abilities] */
station_row_keyword_lines ::= station_row_keywords NEWLINE stage_abilities
station_row_keywords ::= station_row_keyword_one | station_row_keyword_more | station_row_keyword_more_titled

/* A bounded row composes a turn event, one optional other target, current
   base statistics, grants and duration. It has no cross-clause pronoun or
   replacement-stat continuation whose scope could leak into another action. */
/* @sem Ability::[Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$station_row_animation_effect}]}}] */
station_row_animation ::= "at" turn_event "," station_row_animation_effect "."
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($station_animation_target)), changes:[AddCardType(Artifact), AddCardType(Creature), SetBasePowerToughness{power:$number, toughness:$number_2}, ...$grants], duration:$duration, evaluation:Snapshot} */
station_row_animation_effect ::= station_animation_target ("becomes" | "become") ("a" | "an") "artifact" "creature" "with" "base" "power" "and" "toughness" number "/" number "and" ("gains" | "gain") grants duration
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(Expr::Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@other_reference(ObjectFilter::$filter_phrase))), $filter_phrase)}), index:0} */
station_animation_target ::= "up" "to" "one" "other" "target" filter_phrase

/* @sem Ability::[Keyword($keyword_value)] */
station_row_keyword_one ::= keyword_value
/* @prefer always */
/* @sem Ability::[Keyword($keyword_value), ...$station_row_keywords] */
station_row_keyword_more ::= keyword_value "," station_row_keywords
/* @sem Ability::[Keyword($keyword_value), ...$station_row_keywords] */
station_row_keyword_more_titled ::= keyword_value "," "↑" station_row_keywords
/* @sem Ability::[Keyword($keyword_value), Keyword($keyword_value_2), Keyword($keyword_value_3)] */
station_row_three_titled_keywords ::= keyword_value "," "↑" keyword_value "," "↑" keyword_value
/* A single-stage bare Station block preceded by abilities with three keywords uses title case. */
/* @sem CardSurface::CardSurface{station:true, abilities:[...$abilities, Mechanic{mechanic:Station}, CounterStages{counter:Named(ChargeCounter), stages:[_{minimum:$number, abilities:$station_row_three_titled_keywords}]}]} */
card_station_before_three_titled_body ::= abilities NEWLINE station_heading NEWLINE NUMBER "⁺" "|" station_row_three_titled_keywords
/* @prefer always */
/* @sem $card_station_before_three_titled_body */
card_station_before_three_titled_p1 ::= card_station_before_three_titled_body
/* @prefer always */
/* @sem $card_station_before_three_titled_p1 */
card_station_before_three_titled_p2 ::= card_station_before_three_titled_p1
/* @prefer always */
/* @sem $card_station_before_three_titled_p2 */
card_station_before_three_titled ::= card_station_before_three_titled_p2

/* An ability-only input may supply its box explicitly in the same striation. */
/* @sem CardSurface::CardSurface{station_explicit:true, abilities:$station_explicit_text} */
card_station_explicit ::= station_explicit_text
/* @sem Ability::[Mechanic{mechanic:Station}, CounterStages{counter:Named(ChargeCounter), stages:[_{minimum:$number, power_toughness:[$number_2, $number_3], animates:true, abilities:$station_row_abilities}]}] */
station_explicit_abilities ::= "station" NEWLINE NUMBER "⁺" "|" station_row_abilities NEWLINE NUMBER "/" NUMBER

station_source ::= station_source_animation | station_source_bare | station_source_nonanimating
/* @sem StationSource::StationSource{} */
station_source_bare ::= "station"
station_source_nonanimating ::= station_source_spacecraft | station_source_planet
/* @sem StationSource::StationSource{} */
station_source_spacecraft ::= "station" "(" "tap" "another" "creature" "you" "control" ":" "put" "charge" "counters" "equal" "to" "its" "power" "on" "this" "Spacecraft" "." "station" "only" "as" "a" "sorcery" "." ")"
/* @sem StationSource::StationSource{} */
station_source_planet ::= "station" "(" "tap" "another" "creature" "you" "control" ":" "put" "charge" "counters" "equal" "to" "its" "power" "on" "this" "Planet" "." "station" "only" "as" "a" "sorcery" "." ")"

/* The visible reminder's operand stays available to the inverse grammar. */
/* @sem CardSurface::CardSurface{station:true, station_declaration:$station_visible_source, abilities:[WithPresentation{reminder:true, ability:Mechanic{mechanic:Station}}, ...$station_rows]} */
card_station_raw ::= station_visible_source NEWLINE station_rows
/* @sem CardSurface::CardSurface{station:true, station_declaration:$station_visible_source, abilities:[...$abilities, WithPresentation{reminder:true, ability:Mechanic{mechanic:Station}}, ...$station_rows]} */
card_station_raw_before ::= abilities NEWLINE station_visible_source NEWLINE station_rows

station_visible_source ::= station_source_animation | station_source_nonanimating

/* The ability root's wrapper is excluded at the card root; typed card surfaces
   refer directly to this shared declaration, preserving explicit provenance. */
line_station_explicit ::= station_explicit_abilities
station_explicit_text ::= station_explicit_abilities | station_explicit_before | station_explicit_after | station_explicit_both
/* @sem Ability::[...$abilities, ...$station_explicit_abilities] */
station_explicit_before ::= abilities NEWLINE station_explicit_abilities
/* @sem Ability::[...$station_explicit_abilities, ...$abilities] */
station_explicit_after ::= station_explicit_abilities NEWLINE abilities
/* @sem Ability::[...$abilities, ...$station_explicit_abilities, ...$abilities_2] */
station_explicit_both ::= abilities NEWLINE station_explicit_abilities NEWLINE abilities

/* A Station row can combine keywords with a plural static grant. */
/* @prefer always */
/* @sem Ability::[...$station_row_keywords, @scope(Ability::Static{kind:Ordinary, affected:Objects($affected_plural), changes:$grants})] */
station_row_keyword_have ::= station_row_keywords NEWLINE affected_plural "have" grants "."

/* Prowl's explanatory type list belongs to the printed characteristics. */
/* @sem CardSurface::CardSurface{prowl_types:$prowl_explanation, abilities:[$keyword_prowl, ...$card]} */
card_text_prowl ::= keyword_prowl "(" prowl_explanation ")" NEWLINE card
/* @sem CardSurface::CardSurface{prowl_types:$prowl_explanation, abilities:[...$abilities, $keyword_prowl, ...$card]} */
card_text_prowl_after_abilities ::= abilities NEWLINE keyword_prowl "(" prowl_explanation ")" NEWLINE card
prowl_explanation ::= prowl_this_explanation | prowl_spell_explanation
/* @sem $prowl_type_options */
prowl_this_explanation ::= "you" "may" "cast" "this" prowl_explanation_condition prowl_type_options "."
/* @sem $prowl_type_options */
prowl_spell_explanation ::= "you" "may" "cast" "this" "spell" prowl_explanation_condition prowl_type_options "."
/* @sem () */
prowl_explanation_condition ::= "for" "its" "prowl" "cost" "if" "you" "dealt" "combat" "damage" "to" "a" "player" "this" "turn" "with"
prowl_type_options ::= prowl_one_type | prowl_two_types
/* @sem CreatureType::[@subtype_name($creature_subtype)] */
prowl_one_type ::= ("a" | "an") creature_subtype
/* @sem CreatureType::[@subtype_name($creature_subtype), @subtype_name($creature_subtype_2)] */
prowl_two_types ::= ("a" | "an") creature_subtype "or" creature_subtype

/* The explanation repeats the printed Phyrexian mana symbol. */
/* @sem CardSurface::CardSurface{compleated_symbol:$compleated_explanation, abilities:[$bare_compleated, ...$card]} */
card_text_compleated ::= bare_compleated "(" compleated_explanation ")" NEWLINE card

compleated_explanation ::= compleated_one_color | compleated_two_colors | compleated_each_life
/* @sem ManaSymbol::@agree($mana_phyrexian, Phyrexian([$note_color])) */
compleated_one_color ::= mana_phyrexian "can" "be" "paid" "with" note_color "or" "2" "life" "." compleated_life_result
/* @sem ManaSymbol::@agree($compleated_phyrexian_pair, Phyrexian([$note_color, $note_color_2])) */
compleated_two_colors ::= compleated_phyrexian_pair "can" "be" "paid" "with" note_color "," note_color "," "or" "2" "life" "." compleated_life_result
/* @sem ManaSymbol::Phyrexian([$mana_letter, $mana_letter_2]) */
compleated_phyrexian_pair ::= "{" mana_letter "/" mana_letter "/" "P" "}"
/* @sem ManaSymbol::@agree($mana_phyrexian, @agree($mana_phyrexian_2, Phyrexian([$note_color]))) */
compleated_each_life ::= mana_phyrexian "can" "be" "paid" "with" note_color "or" "2" "life" "." "for" "each" mana_phyrexian "paid" "with" "life" "," compleated_enters_with_reduction
/* @sem () */
compleated_life_result ::= "if" "life" "was" "paid" "," compleated_enters_with_reduction
/* @sem () */
compleated_enters_with_reduction ::= "this" "planeswalker" "enters" "with" "two" "fewer" "loyalty" "counters" "."

/* Amplify repeats its count and the complete subtype set of the creature entering. */
/* @sem CardSurface::CardSurface{amplify_types:$amplify_type_options, abilities:[Mechanic{mechanic:$mechanic_amplify_name, amount:Expr::@agree($value, $printed_plus_one_counters)}, ...$amplify_following_abilities]} */
card_text_amplify ::= mechanic_amplify_name value "(" amplify_rule_head printed_plus_one_counters "on" "it" "for" "each" amplify_type_options amplify_rule_belongs ")" amplify_following_abilities?
/* @sem CardSurface::CardSurface{amplify_types:$amplify_type_options, abilities:[...$abilities, Mechanic{mechanic:$mechanic_amplify_name, amount:Expr::@agree($value, $printed_plus_one_counters)}, ...$amplify_following_abilities]} */
card_text_amplify_after_abilities ::= abilities NEWLINE mechanic_amplify_name value "(" amplify_rule_head printed_plus_one_counters "on" "it" "for" "each" amplify_type_options amplify_rule_belongs ")" amplify_following_abilities?
/* @sem $card */
amplify_following_abilities ::= NEWLINE card
/* @sem () */
amplify_rule_head ::= "as" "this" "creature" "enters" "," "put"
/* @sem () */
amplify_rule_belongs ::= "card" "you" "reveal" "in" "your" "hand" "."
amplify_type_options ::= amplify_one_type | amplify_two_types
/* @sem CreatureType::[@subtype_name($creature_subtype)] */
amplify_one_type ::= creature_subtype
/* @sem CreatureType::[@subtype_name($creature_subtype), @subtype_name($creature_subtype_2)] */
amplify_two_types ::= creature_subtype "and/or" creature_subtype

/* @sem CardSurface::CardSurface{abilities:$card, layout_reminder:LayoutReminder::Omen} */
card_text_omen_also_shuffle ::= card "(" "also" "shuffle" "this" "card" "." ")"

/* The printed cost and the copy's source-derived subtypes must both agree. */
/* @sem CardSurface::CardSurface{copy_token_types:$copy_reminder_creature_types, abilities:[...$copy_reminder_prefix, Mechanic{mechanic:$mechanic_embalm_name, cost:Cost::@agree($keyword_payment, $graveyard_copy_reminder_cost)}, ...$copy_reminder_suffix]} */
card_text_embalm_reminder ::= copy_reminder_prefix? mechanic_embalm_name keyword_payment "(" graveyard_copy_reminder_cost graveyard_copy_reminder_token "white" copy_reminder_creature_types "with" "no" "mana" "cost" "." "embalm" "only" "as" "a" "sorcery" "." ")" copy_reminder_suffix?

/* @sem CardSurface::CardSurface{copy_token_types:$copy_reminder_creature_types, abilities:[...$copy_reminder_prefix, Mechanic{mechanic:$mechanic_eternalize_name, cost:Cost::@agree($keyword_payment, $graveyard_copy_reminder_cost)}, ...$copy_reminder_suffix]} */
card_text_eternalize_reminder ::= copy_reminder_prefix? mechanic_eternalize_name keyword_payment "(" graveyard_copy_reminder_cost graveyard_copy_reminder_token "4" "/" "4" "black" copy_reminder_creature_types "with" "no" "mana" "cost" "." "eternalize" "only" "as" "a" "sorcery" "." ")" copy_reminder_suffix?

/* @sem $abilities */
copy_reminder_prefix ::= abilities NEWLINE
/* @sem $card */
copy_reminder_suffix ::= NEWLINE card
/* @sem $cost */
graveyard_copy_reminder_cost ::= cost "," "↑" "exile" "this" "card" "from" "your" "graveyard" ":"
/* @sem () */
graveyard_copy_reminder_token ::= "create" "a" "token" "that's" "a" "copy" "of" "it" "," "except" "it's" "a"

copy_reminder_creature_types ::= copy_reminder_one_type | copy_reminder_more_types
/* @sem CreatureType::[@subtype_name($creature_subtype)] */
copy_reminder_one_type ::= creature_subtype
/* @sem CreatureType::[@subtype_name($creature_subtype), ...$copy_reminder_creature_types] */
copy_reminder_more_types ::= creature_subtype copy_reminder_creature_types

/* The reminder describes the source face's missing cost. */
/* @sem CardSurface::CardSurface{no_mana_cost:true, abilities:$card} */
card_text_no_mana_cost ::= "(" "nonexistent" "mana" "costs" "can't" "be" "paid" "." ")" NEWLINE card

/* The record identifies the other component of the meld pair. */
/* @sem CardSurface::CardSurface{abilities:$card, meld_with:$meld_reminder_name} */
card_text_meld_with ::= card NEWLINE "(" "melds" "with" meld_reminder_name "." ")"

meld_reminder_name ::= meld_gisela | meld_graf_rats | meld_hanweir_battlements | meld_mishra | meld_titania | meld_urza | meld_vanille
/* @sem String::'Gisela, the Broken Blade' */
meld_gisela ::= "Gisela" "," "the" "Broken" "Blade"
/* @sem String::'Graf Rats' */
meld_graf_rats ::= "Graf" "Rats"
/* @sem String::'Hanweir Battlements' */
meld_hanweir_battlements ::= "Hanweir" "Battlements"
/* @sem String::'Mishra, Claimed by Gix' */
meld_mishra ::= "Mishra" "," "Claimed" "by" "Gix"
/* @sem String::'Titania, Voice of Gaea' */
meld_titania ::= "Titania" "," "Voice" "of" "Gaea"
/* @sem String::'Urza, Lord Protector' */
meld_urza ::= "Urza" "," "Lord" "Protector"
/* @sem String::'Vanille, Cheerful l''Cie' */
meld_vanille ::= "Vanille" "," "Cheerful" "l'Cie"


/* The spell creates the same Food described after the Adventure instruction. */
/* @sem CardSurface::CardSurface{abilities:[Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:Rules, recipe:$tn_food}], entry:BattlefieldArrival{}}}]}}], layout_reminder:LayoutReminder::Adventure(AdventureReturnType::Creature)} */
card_text_food_adventure_reminded ::= "create" "a" tn_food "token" "." "(" "then" "exile" "this" "card" "." "you" "may" "cast" "the" "creature" "later" "from" "exile" "." "a" "Food" "token" "is" "an" "artifact" "with" food_token_reminder_cost ")"

/* Changing the chosen color does not replace the current source's artifact type. */
/* @sem CardSurface::CardSurface{retains_artifact_type:true, abilities:[...$abilities, Static{kind:Ordinary, affected:Objects(One(Source)), changes:$static_is_chosen_color}]} */
card_text_retains_artifact_type ::= abilities NEWLINE self_creature static_is_chosen_color "." "(" "it's" "still" "an" "artifact" "." ")"

/* Both the cost and the source face's mana value are checked. */
/* @sem CardSurface::CardSurface{transmute_mana_value:$number, abilities:[...$abilities, WithPresentation{reminder:true, ability:Mechanic{mechanic:$mechanic_transmute_name, cost:Cost::@agree($keyword_payment, $keyword_payment_2)}}]} */
card_text_transmute_value ::= abilities NEWLINE mechanic_transmute_name keyword_payment "(" keyword_payment "," "↑" "discard" "this" "card" ":" "search" "your" "library" "for" "a" "card" "with" "mana" "value" NUMBER "," "reveal" "it" "," "put" "it" "into" "your" "hand" "," "then" "shuffle" "." "transmute" "only" "as" "a" "sorcery" "." ")"


/* The color-defining ability contributes no color identity. The only other
   ability in this surface contains no colored mana symbols or characteristic definition. */
/* @sem CardSurface::CardSurface{deck_identity_color:$mana_color_word, abilities:[$static_color_definition_excluded, $multicolored_convoke_reminded]} */
card_text_deck_identity_color ::= static_color_definition_excluded "(" "it" "can" "be" "in" "any" "deck" "whose" "commander's" "color" "identity" "includes" mana_color_word "." ")" NEWLINE multicolored_convoke_reminded
/* @sem Ability::WithPresentation{reminder:true, ability:Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Stack), kind:Spell, filter:AllOf([Cast{by:One(AbilityController)}, Property{property:ColorCount, test:Compare{comparison:Greater, value:Constant(1)}}])}), changes:[GrantAbility(@holder($mechanic_convoke))]}} */
multicolored_convoke_reminded ::= "multicolored" "spells" "you" "cast" "have" mechanic_convoke "." "(" "your" "creatures" "can" "help" "cast" "those" "spells" "." "each" "creature" "you" "tap" "while" "casting" "a" "multicolored" "spell" "pays" "for" "{" "1" "}" "or" "one" "mana" "of" "a" "color" "that" "creature" "is" "." ")"

/* The sample counts the same other creatures and repeats current fixed toughness. */
/* @sem CardSurface::CardSurface{counted_power_example:CountedPowerExample{count:Expr::@agree($number_words, $number_digits), toughness:$number}, abilities:[@defining_static(Ability::Static{kind:Ordinary, affected:Objects(One($named_possessive_ref)), changes:[SetPower(CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf(@unordered([@agree($subtype_plural, $subtype_plural_2), Not(SameObject(Source))]))}))]})]} */
card_text_counted_power_example ::= named_possessive_ref "power" "is" "equal" "to" "the" "number" "of" "other" subtype_plural "on" "the" "battlefield" "." "(" "for" "example" "," "as" "long" "as" "there" "are" number_words "other" subtype_plural "on" "the" "battlefield" "," SELF_NAME "'s" "power" "and" "toughness" "are" number_digits "/" NUMBER "." ")"

/* The source cost supplies the symbol and its intrinsic color definition. */
/* @sem $mana_rainbow */
rainbow_cost_note ::= "(" mana_rainbow "is" "rainbow" "mana" "," "one" "mana" "from" "any" "source" "that" "could" "add" "two" "or" "more" "colors" "of" "mana" "." "this" "card" "is" "all" "colors" "." ")"

/* A colon stage belongs to the Planet, while subsequent abilities remain outside the stage. */
/* @sem CardSurface::CardSurface{station:true, station_declaration:$station_source_planet, abilities:[WithPresentation{reminder:true, ability:Mechanic{mechanic:Station}}, $station_planet_colon_row, ...$abilities]} */
card_station_raw_planet ::= station_source_planet NEWLINE station_planet_colon_row NEWLINE abilities

/* @sem Ability::CounterStages{counter:Named(ChargeCounter), stages:[_{minimum:$number, abilities:$line}]} */
station_planet_colon_row ::= NUMBER "⁺" ":" line
