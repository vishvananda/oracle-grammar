/* The condition and both destinations refer to the same linked exiled card. */
/* @sem Program::Program{instructions:[If{condition:ObjectMatches{object:$linked_exiled_card, filter:$linked_moved_card_filter}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One($linked_exiled_card), zone:Exile}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}, Effect{result:@next, operation:Move{objects:InZone{objects:One($linked_exiled_card), zone:Exile}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{}}]} */
chapter_linked_card_conditional_put_a ::= "you" "may" "put" linked_exiled_card "onto" "the" "battlefield" "if" "it's" "a" linked_moved_card_filter "card" "." "if" "you" "don't" "put" "it" "onto" "the" "battlefield" "," "put" "it" "into" "its" "owner's" "hand"
/* @sem Program::Program{instructions:[If{condition:ObjectMatches{object:$linked_exiled_card, filter:$linked_moved_card_filter}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One($linked_exiled_card), zone:Exile}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}, Effect{result:@next, operation:Move{objects:InZone{objects:One($linked_exiled_card), zone:Exile}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{}}]} */
chapter_linked_card_conditional_put_an ::= "you" "may" "put" linked_exiled_card "onto" "the" "battlefield" "if" "it's" "an" linked_moved_card_filter "card" "." "if" "you" "don't" "put" "it" "onto" "the" "battlefield" "," "put" "it" "into" "its" "owner's" "hand"
chapter_linked_card_conditional_put ::= chapter_linked_card_conditional_put_a | chapter_linked_card_conditional_put_an

/* @sem Program::Program{instructions:[Effect{result:@next, operation:KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::TurnFaceUp, objects:One($linked_exiled_card)}}, If{condition:ObjectMatches{object:$linked_exiled_card, filter:$linked_moved_card_filter}, then:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:ObjectProperty{object:$linked_exiled_card, property:ManaValue, information:CurrentOrLastKnown}}}]}, otherwise:Program{}}]} */
chapter_turn_linked_each_life_a ::= "turn" linked_exiled_card "face" "up" "." "if" "it's" "a" linked_moved_card_filter "card" "," "you" "lose" "life" "equal" "to" "its" "mana" "value"
/* @sem Program::Program{instructions:[Effect{result:@next, operation:KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::TurnFaceUp, objects:One($linked_exiled_card)}}, If{condition:ObjectMatches{object:$linked_exiled_card, filter:$linked_moved_card_filter}, then:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:ObjectProperty{object:$linked_exiled_card, property:ManaValue, information:CurrentOrLastKnown}}}]}, otherwise:Program{}}]} */
chapter_turn_linked_each_life_an ::= "turn" linked_exiled_card "face" "up" "." "if" "it's" "an" linked_moved_card_filter "card" "," "you" "lose" "life" "equal" "to" "its" "mana" "value"
chapter_turn_linked_each_life ::= chapter_turn_linked_each_life_a | chapter_turn_linked_each_life_an

