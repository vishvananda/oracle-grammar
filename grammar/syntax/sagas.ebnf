/* Both operations address the same optional target. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:SetTapped{objects:One($target_up_to_one), tapped:true}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($target_up_to_one)), kind:$counter_kind, amount:Constant(1)}]}}]} */
saga_tap_and_counter ::= "tap" target_up_to_one "and" "put" "a" counter_kind "counter" "on" "it"

/* An observed decorative heading wraps the ordinary chapter program. */
/* @sem $program */
chapter_judgment_flavor_program ::= "judgment" "Bolt" "—" program

/* The final quoted ability supplies the chapter's punctuation. */
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_quoted_token_program})] */
chapter_3_quoted_token ::= "III" "—" chapter_quoted_token_program

/* Quoted intrinsic abilities supply the chapter's final punctuation. */
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_quoted_token_program})] */
chapter_2_quoted_token ::= "II" "—" chapter_quoted_token_program

/* A temporary trigger retains its event and independently composed action. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTrigger{event:$saga_controlled_combat_damage, duration:$this_duration, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:$keyword_action}}]}}}]} */
chapter_temporary_controlled_damage ::= "whenever" saga_controlled_combat_damage this_duration "," keyword_action

/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:AllOf([$noun, ControlledBy(One(AbilityController))]), recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source}) */
saga_controlled_combat_damage ::= "a" noun "you" "control" "deals" "combat" "damage" "to" "a" "player"

/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_quoted_token_program})] */
chapter_1_flavored_quoted_token ::= "i" "—" saga_flavor_heading "—" chapter_quoted_token_program

/* @sem $chapter_controlled_keyword_plain */
chapter_flavored_controlled_keyword ::= saga_flavor_heading "—" chapter_controlled_keyword_plain

/* Both instructions refer to the same explicitly described population. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}), kind:$counter_kind, amount:Constant(1)}]}}]} */
chapter_controlled_keyword_each_counter ::= filter_plural "you" "control" "gain" keyword_name duration "." "put" "a" counter_kind "counter" "on" "each" "of" "them"

/* Prefer "For each opponent, you create..." inside Saga chapters without changing non-Saga activated abilities. */
/* @prefer always */
/* @sem Program::Program{instructions:$clause_opponent_count_tokens} */
chapter_opponent_count_tokens_h3 ::= clause_opponent_count_tokens

/* Stacked @prefer chain (matching chapters_ring_tempts_three_pref) so grouped I, II, III mill-take beats 3x single chapters. */
/* @prefer always */
/* @sem $chapters_1_2_3_mill_take_pref2_h3 */
chapters_1_2_3_mill_take_pref3_h3 ::= chapters_1_2_3_mill_take_pref2_h3

/* @prefer always */
/* @sem $chapters_1_2_3_mill_take_pref1_h3 */
chapters_1_2_3_mill_take_pref2_h3 ::= chapters_1_2_3_mill_take_pref1_h3

/* @prefer always */
/* @sem $chapters_1_2_3_mill_take_h3 */
chapters_1_2_3_mill_take_pref1_h3 ::= chapters_1_2_3_mill_take_h3

/* @prefer always */
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$clause_mill_take}}), @scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$clause_mill_take}}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$clause_mill_take}}), ...$chapter_tail] */
chapters_1_2_3_mill_take_h3 ::= "i" "," "II" "," "III" "—" clause_mill_take "." NEWLINE chapter_tail

/* Target opponent may sacrifice a nontoken permanent or lose life while you draw. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:$target_opponent, cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$adjective_nontype, Not(Token)])}, choose:Exactly(Constant(1))}]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(Acting), amount:$number}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Constant(1)}}]}, otherwise:Program{}}]} */
chapter_opponent_may_sacrifice_nontoken_else_h3 ::= target_opponent "may" "sacrifice" "a" adjective_nontype "," "nontoken" "permanent" "of" "their" "choice" "." "if" "they" "don't" "," "they" "lose" number "life" "and" "you" "draw" "a" "card"

/* The numeral in a chapter explanation follows its written action. */
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$chapter_quantified_action}})] */
chapter_1_quantified_reminder ::= "i" "—" chapter_quantified_action
chapter_quantified_action ::= surveil_reminded | amass_orcs_reminded | recruit_reminded

/* The chosen permanent becomes linked to this Saga's consuming chapter. */
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$assimilate_object}]}})] */
chapter_1_assimilate_permanent_reminded ::= "i" "—" assimilate_object "." "(" "gain" "control" "of" "it" "and" "put" "a" "+" "1" "/" "+" "1" "counter" "on" "it" "." "it's" "a" "Borg" "artifact" "creature" "and" "loses" "all" "other" "creature" "types" "." ")"

/* The link follows the assimilated battlefield incarnation even if its type
   or controller changes. The return uses the actual exile receipt. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:Zone{scope:Shared(Battlefield),kind:Permanent,filter:AssimilatedWith(Source)}, destination:Exile{visibility:FaceUp,arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@prior, phase:After},zone:Exile}, destination:Battlefield{controller:Owner,arrival:BattlefieldArrival{}},qualifiers:[]}}]} */
chapter_exile_linked_assimilated ::= "exile" "the" "Borg" "assimilated" "with" "this" "Saga" "," "then" "return" "it" "to" "the" "battlefield" "under" "its" "owner's" "control"

/* Per-owner shuffled destinations retain the owners of the announced cards. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:$bounded_graveyard_targets, destination:Library{position:Shuffled,order:DestinationDefault,arrival:CardArrival{}}, qualifiers:[]}}]} */
chapter_choose_bounded_graveyard_shuffle ::= "choose" bounded_graveyard_targets "." "the" "owners" "of" "those" "cards" "shuffle" "them" "into" "their" "libraries"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo($count_plural), filter:Any})) */
bounded_graveyard_targets ::= "up" "to" count_plural "target" "cards" "in" "graveyards"

/* Every linked card must have some one card type in common. The test is
   satisfied by a population of zero, as well as by one card. */
/* @sem Program::Program{instructions:[If{condition:Compare{left:LargestSharedGroup{objects:$linked_exiled_all,property:CardTypes}, test:NumberTest::Compare{comparison:Equal,value:CountObjects($linked_exiled_all)}}, then:_{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(AbilityController), $gain_life_base)}]}, otherwise:_{}}]} */
chapter_linked_common_card_type ::= "if" linked_exiled_all "share" "a" "card" "type" "," "you" gain_life_base

/* An empty optional target slot yields no owner and no draw. The
   same target is shuffled into its owner's library. */
/* @sem Program::Program{instructions:[Effect{result:@next,operation:Draw{players:One(OwnerOf($chapter_optional_creature_target)),amount:$card_count}},Effect{result:@next,operation:Move{objects:One($chapter_optional_creature_target),destination:Library{position:Shuffled,order:DestinationDefault,arrival:CardArrival{}},qualifiers:[]}}]} */
/* @prefer always */
chapter_optional_target_owner_draw_shuffle ::= "the" "owner" "of" chapter_optional_creature_target "draws" card_count "," "then" "shuffles" "that" "creature" "into" "their" "library"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot,kind:Object(_{kind:Permanent,zones:[Battlefield]}),count:UpTo(Constant(1)),filter:CardType(Creature)}),index:0} */
chapter_optional_creature_target ::= "up" "to" "one" "target" "creature"

/* Delay control, untapping, and haste until the next combat begins this
   turn. A later turn's combat never consumes this delayed effect. */
/* @sem Program::Program{instructions:[Effect{result:@next,operation:DealDamage{source:Source,recipients:Objects(One($target_permanent)),amount:$number,preventable:true}},Effect{result:@next,operation:CreateDelayedTrigger{event:Turn{point:CombatBegins,players:All},start:Immediately,expires:EndOfTurn,body:_{instructions:[Effect{result:@next,operation:CreateContinuousEffect{source:Source,affected:Objects(One($target_permanent)),changes:[SetController(AbilityController)],duration:$duration,evaluation:Snapshot}},Effect{result:@next,operation:SetTapped{objects:One($target_permanent),tapped:false}},Effect{result:@next,operation:CreateContinuousEffect{source:Source,affected:Objects(One($target_permanent)),changes:$grants,duration:$duration_2,evaluation:Snapshot}}]}}}]} */
chapter_damage_then_combat_control ::= "this" "Saga" "deals" number "damage" "to" target_permanent "." "at" "the" "beginning" "of" "the" "next" "combat" "this" "turn" "," "gain" "control" "of" "that" "creature" duration "." "untap" "it" "." "it" "gains" grants duration

/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$amass_goblins_reminded}})] */
chapter_2_amass_reminded ::= "II" "—" amass_goblins_reminded

/* An empty target announcement leaves the replacement with no matching source. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateReplacement{event:Damage{source_kind:Permanent, sources:InSet(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:$filter_phrase}))), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Recipient}, limit:UntilExpired, duration:$while_on_battlefield, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}}}]} */
chapter_prevent_from_targets ::= "prevent" "all" "damage" "that" "would" "be" "dealt" "by" "up" "to" "one" "target" filter_phrase while_on_battlefield

/* The printed upper bound restricts the target group at announcement. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($saga_targets_with_budget), changes:[SetController(AbilityController)], duration:$while_on_battlefield, evaluation:Snapshot}}]} */
chapter_gain_control_bounded ::= "gain" "control" "of" saga_targets_with_budget while_on_battlefield

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:$plural_target_count, filter:$filter_plural, constraints:[$target_total_budget]})) */
saga_targets_with_budget ::= plural_target_count "target" filter_plural target_total_budget

/* The second target excludes the first and need not be chosen. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:Fight{first:$chosen_controlled_fighter, second:$other_target_up_to}}}]} */
chapter_fight_optional_target ::= chosen_controlled_fighter "fights" other_target_up_to

/* The alternate payment applies only to the next qualifying casting proposal. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChangeSpell{subject:$next_cost_subject, changes:[SpellCost(Alternate{cost:Free})]}}]} */
chapter_next_spell_free ::= next_cost_subject "can" "be" "cast" "without" "paying" "its" "mana" "cost"

/* Both changes affect the same announced creature; the stats are sampled once. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($chosen_controlled_fighter)), changes:[...$double_stat_change, GrantKeyword($keyword_name)], duration:$until_end_of_turn, evaluation:Snapshot}}]} */
chapter_double_stats_with_keyword ::= "choose" chosen_controlled_fighter "." until_end_of_turn "," "double" "its" double_stat_change "and" "it" "gains" keyword_name

/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$token_galactus_attack], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}})] */
chapter_4_named_token_quote ::= "IV" "—" "create" token_galactus_attack

/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:Announcement{}, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Defined{name:Explicit('Jimothy'), colors:[Green], supertypes:[Legendary], card_types:[Creature], subtypes:[Raccoon], power_toughness:[Constant(2), Constant(1)], abilities:[@scope(Ability::Triggered{event:ZoneChange{objects:OwnedBy(One(AbilityController)), from:Library, to:Graveyard}, limits:TriggerLimits{}, announcement:Announcement{}, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[CounterPlacement{recipients:Objects(One(Source)), kind:PowerToughness(1, 1), amount:Constant(1)}]}}]}})]}}], entry:BattlefieldArrival{}}}]}})] */
chapter_1_jimothy_token ::= "i" "—" "create" "Jimothy" "," "a" "legendary" "2" "/" "1" "green" "Raccoon" "with" '"' "whenever" "a" "card" "is" "put" "into" "your" "graveyard" "from" "your" "library" "," "put" "a" "+" "1" "/" "+" "1" "counter" "on" "Jimothy" "." '"'

/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects($objects_targets), amount:$number, preventable:true}}]} */
chapter_self_damage_target_group ::= "this" "creature" "deals" number "damage" "to" objects_targets

/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($objects_targets_plain), changes:[Rule(Prohibit(Block(Any)))], duration:EndOfTurn, evaluation:LiveObjects}}]} */
chapter_targets_cant_block_turn ::= objects_targets_plain "can't" "block" "this" "turn"

/* @prefer always */
/* @sem Program::Program{instructions:$instructions_discard_property_tail} */
chapter_discard_property_tail ::= instructions_discard_property_tail
