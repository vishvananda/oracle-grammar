/* @prefer always */
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:Any, count:AsManyAsCan(Constant(1))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}}), @scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_turn_linked_each_life}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_linked_card_conditional_put})] */
chapters_search_exile_face_down_reveal_put ::= "i" "—" "search" "your" "library" "for" "a" "card" "," "exile" "it" "face" "down" "," "then" "shuffle" "." NEWLINE "II" "—" chapter_turn_linked_each_life "." NEWLINE "III" "—" chapter_linked_card_conditional_put "."

