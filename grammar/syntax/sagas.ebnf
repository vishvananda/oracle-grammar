chapter_2_paired_quoted_tokens ::= "II" "—" paired_quoted_tokens_program

/* Three independently parsed chapter programs with named presentation headings. */
/* @prefer always */
/* @sem Ability::[...$chapter_flavored_first, ...$chapter_flavored_next, ...$chapter_flavored_last] */
