/* Sagas. A chapter line names its chapters; each is a trigger on its lore count. */
/* @sem Ability::[Ability::Saga{chapters:$chapters}] */
line_saga ::= chapters

chapters ::= chapters_one | chapters_more

chapters_one ::= chapter_first

/* @sem Ability::[...$chapter_first, ...$chapter_tail] */
chapters_more ::= chapter_first NEWLINE chapter_tail

chapter_first ::= chapter_1_modal | chapter_1_2_modal | chapter_1_2_3_modal | chapter_1_2_3_4_modal | chapter_1 | chapter_1_2 | chapter_1_2_3 | chapter_1_2_3_4

chapter_tail ::= chapter | chapter_tail_more

/* @sem Ability::[...$chapter, ...$chapter_tail] */
chapter_tail_more ::= chapter NEWLINE chapter_tail
chapter ::= chapter_2_modal | chapter_3_modal | chapter_4_modal | chapter_5_modal | chapter_6_modal | chapter_2_3_modal | chapter_3_4_modal | chapter_4_5_modal | chapter_2_3_4_modal | chapter_3_4_5_modal | chapter_4_5_6_modal | chapter_2 | chapter_3 | chapter_4 | chapter_5 | chapter_6 | chapter_2_3 | chapter_3_4 | chapter_4_5 | chapter_2_3_4 | chapter_3_4_5 | chapter_4_5_6

/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_1 ::= "i" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_2 ::= "II" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_3 ::= "III" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_4 ::= "IV" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(5), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_5 ::= "V" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(6), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_6 ::= "VI" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_1_2 ::= "i" "," "II" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_2_3 ::= "II" "," "III" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_3_4 ::= "III" "," "IV" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(5), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_4_5 ::= "IV" "," "V" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_1_2_3 ::= "i" "," "II" "," "III" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_2_3_4 ::= "II" "," "III" "," "IV" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(5), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_3_4_5 ::= "III" "," "IV" "," "V" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(5), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(6), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_4_5_6 ::= "IV" "," "V" "," "VI" "—" chapter_program "."

/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_1_2_3_4 ::= "i" "," "II" "," "III" "," "IV" "—" chapter_program "."

/* These observed chapter flavor headings have no rules meaning. The Roman
   chapter list remains outside this wrapper and retains every trigger number.
   Unknown/mechanical headings are never discarded by dash syntax. */
chapter_program ::= program | chapter_flavor_program

/* @sem $program */
chapter_flavor_program ::= saga_flavor_heading "—" program

/* @sem () */
saga_flavor_heading ::= "aerial Blast" | "aerospark" | "fire" | "flames of Rebirth" | "gigaflare" | "ice" | "jecht Beam" | "lightning" | "mega Flare" | "oblivion" | "pain" | "rising Flames" | "slipstream" | "sonic Wings" | "ultimate End" | "ultimate Jecht Shot" | "wings of Light"

/* Modal chapters announce their menus before resolution; each repeated chapter
   and each mode owns its target and result namespace. */
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_1_modal ::= "i" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_2_modal ::= "II" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_3_modal ::= "III" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_4_modal ::= "IV" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(5), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_5_modal ::= "V" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(6), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_6_modal ::= "VI" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_1_2_modal ::= "i" "," "II" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_2_3_modal ::= "II" "," "III" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_3_4_modal ::= "III" "," "IV" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(5), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_4_5_modal ::= "IV" "," "V" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_1_2_3_modal ::= "i" "," "II" "," "III" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_2_3_4_modal ::= "II" "," "III" "," "IV" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(5), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_3_4_5_modal ::= "III" "," "IV" "," "V" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(5), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(6), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_4_5_6_modal ::= "IV" "," "V" "," "VI" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_1_2_3_4_modal ::= "i" "," "II" "," "III" "," "IV" "—" mode_selection
