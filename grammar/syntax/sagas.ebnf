/* Each chapter keeps its own announcement, including the return's graveyard targets. */
/* @prefer always */
/* @sem Ability::[...$chapter_1, @scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_return_graveyard_targets}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_choose_graveyards_shuffle})] */
saga_graveyard_recovery_chapters ::= chapter_1 NEWLINE "II" "—" chapter_return_graveyard_targets "." NEWLINE "III" "—" chapter_choose_graveyards_shuffle "."

/* A chapter can modify all owned cards of a printed kind in every zone.
