/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::RingTempts}}, Effect{result:@next, operation:Mill{players:All, amount:$ring_bearer_mill_amount}}]}}), ...$chapter_2, @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$clause_each_player_graveyard_life}})] */
