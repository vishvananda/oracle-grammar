/* Each opponent supplies one independently chosen target; its transformation
   retains its own stats, type, keyword and source duration. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:OpponentsOf(AbilityController), each:UpTo(Constant(1))}, filter:AllOf([Not(CardType(Creature)), $noun])}))), changes:[SetBasePowerToughness{power:$number_digits, toughness:$number_digits_2}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, AddCardType(Artifact), AddCardType(Creature), GrantKeyword($keyword_name)], duration:WhileOnBattlefield(Source), evaluation:Snapshot}}]} */
chapter_opponent_animation ::= "for" "each" "opponent" "," "up" "to" "one" "target" "noncreature" noun "they" "control" "becomes" "a" number_digits "/" number_digits becomes_types "artifact" "creature" "with" keyword_name "for" "as" "long" "as" "you" "control" "this" "Saga"

/* The follow-up applies to the tokens created by this very instruction. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Created(@marked)), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}]} */
chapter_created_token_keyword ::= "create" "a" token_recipe "." "it" "gains" keyword_name duration

/* Destruction precedes the scoped exile and return of this Saga. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$destroy}, ...$saga_transform_instructions]} */
chapter_destroy_transform ::= destroy "." saga_transform_instructions

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One(Source), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:@exile_followup(InZone{objects:One(Result{result:@prior, phase:After, index:0}), zone:Exile}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[Transformed]}}, qualifiers:[]}}] */
saga_transform_instructions ::= "exile" "this" "Saga" "," "then" "return" "it" "to" "the" "battlefield" "transformed" "under" "your" "control"

/* The attack cost is per declared attacker and retains its live population. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Rule(CombatCost{action:Attack(Players(One(AbilityController))), payer:DeclaringPlayer, cost:$chapter_attack_payment})], duration:$duration, evaluation:LiveObjects}}]} */
chapter_attack_you_cost ::= duration "," affected "can't" "attack" "you" "unless" "their" "controller" "pays" chapter_attack_payment

/* @sem $cost */
chapter_attack_payment ::= cost "for" "each" "of" "those" "creatures"

/* @prefer always */
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_attack_you_cost}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_attack_you_cost})] */
chapter_2_3_attack_cost ::= "II" "," "III" "—" chapter_attack_you_cost "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:$opponents_control_threshold_count, words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
chapter_named_tokens_opponent_control_count ::= "create" "X" token_named_recipe "tokens" "," "where" "X" "is" opponents_control_threshold_count

/* The matching binding counts each opponent once, independent of creature count. */
/* @sem Expr::CountPlayers(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Controls{player:Bound(0), filter:AllOf([$noun, Property{property:Power, test:Compare{comparison:GreaterOrEqual, value:$number_digits}}]), minimum:1}}])) */
opponents_control_threshold_count ::= "the" "number" "of" "opponents" "who" "control" "a" noun "with" "power" number_digits "or" "greater"

/* The heading and copy count agree; the unqualified spell union and duration
   remain current operands of the delayed trigger. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:$saga_copy_spell_filter}, duration:$this_duration, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:@agree($saga_copy_heading, $saga_copy_consequence), targets:May}}]}, once:true}}]} */
chapter_copy_flavor ::= saga_copy_heading "—" "when" "you" "next" "cast" saga_copy_spell_filter this_duration "," saga_copy_consequence

/* @sem $spell_adjective_either */
saga_copy_spell_filter ::= "an" spell_adjective_either "spell"

saga_copy_heading ::= saga_copy_double | saga_copy_triple

/* @sem Expr::Constant(1) */
saga_copy_double ::= "double"

/* @sem Expr::Constant(2) */
saga_copy_triple ::= "triple"

saga_copy_consequence ::= saga_copy_it_once | saga_copy_it_twice

/* @sem Expr::Constant(1) */
saga_copy_it_once ::= "copy" "it" "." "you" "may" "choose" "new" "targets" "for" "the" "copy"

/* @sem Expr::Constant(2) */
saga_copy_it_twice ::= "copy" "it" "twice" "." "you" "may" "choose" "new" "targets" "for" "the" "copies"

/* The quoted token supplies its own closing punctuation. */
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_operation_quoted_token})] */
chapter_1_operation_quoted_token ::= "i" "—" chapter_operation_quoted_token

/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:LoseLife{players:All, amount:$number}}]} */
chapter_draw_each_lose ::= "you" "draw" card_count "and" "each" "player" "loses" number "life"

/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_tap_counter_program}), @scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_tap_counter_program})] */
/* @prefer always */
chapter_1_2_tap_counter ::= "i" "," "II" "—" chapter_tap_counter_program "."

/* @sem Program::Program{instructions:$chapter_tap_counter_instructions} */
chapter_tap_counter_program ::= chapter_tap_counter_instructions

/* @sem Instruction::[...$clause_tap_optional_target_counter, ...$instructions] */
chapter_tap_counter_instructions ::= clause_tap_optional_target_counter sequencer instructions

/* A chapter creates tokens for each named counter on its source. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:CountCounters{recipients:Objects(One(Source)), kind:$counter_kind, information:CurrentOrLastKnown}, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
chapter_create_per_source_counter ::= "create" "a" token_recipe "for" "each" counter_kind "counter" "on" SELF_NAME

/* Chapter grants keep the activation in the receiving Saga's ability frame. */
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:@announcement, body:$saga_granted_activation_program})] */
chapter_1_granted_activation ::= "i" "—" saga_granted_activation_program

/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$saga_granted_activation_program})] */
chapter_2_granted_activation ::= "II" "—" saga_granted_activation_program

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$saga_activation_body}))], duration:Indefinite, evaluation:Snapshot}}]} */
saga_granted_activation_program ::= "this" "Saga" "gains" '"' cost ":" saga_activation_body '"'

saga_activation_body ::= program_sentence | saga_token_activation_body

/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_amount, words:CreatingEffect, recipe:@token_abilities($token_recipe_plain, $saga_single_quoted_abilities)}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
saga_token_activation_body ::= "create" token_amount token_recipe_plain "with" saga_single_quoted_abilities

/* @sem Ability::[@holder($saga_token_count_pump)] */
saga_single_quoted_abilities ::= "'" saga_token_count_pump "'"

/* @sem Ability::Static{kind:Ordinary, affected:Objects(One(Source)), changes:[Pump{power:@times($signed, $count_controlled_population), toughness:@times($signed_2, $count_controlled_population)}]} */
saga_token_count_pump ::= "this" "token" "gets" signed "/" signed "for" "each" count_controlled_population "."

/* A mana-cost union constrains a single search choice; the ordinary follow-up retains its receipt. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$saga_mana_cost_choice]}}, ...$search_follow]} */
chapter_mana_cost_search ::= "search" "your" "library" "for" saga_mana_cost_choice search_follow

/* @sem SearchChoice::SearchChoice{filter:AllOf([$saga_cost_card, AnyOf([ManaCostIs($saga_generic_cost), ManaCostIs($saga_generic_cost_2)])]), count:UpTo(Constant(1))} */
saga_mana_cost_choice ::= saga_cost_card "card" "with" "mana" "cost" saga_generic_cost "or" saga_generic_cost

/* @sem Operand::[Term{family:ManaSymbol, form:ManaCostGeneric, operands:[Integer($number)]}] */
saga_generic_cost ::= "{" NUMBER "}"

/* Separate article shapes preserve grammatical printing for the current filter. */
saga_cost_card ::= saga_cost_an_card | saga_cost_a_card

/* @sem $saga_an_noun */
saga_cost_an_card ::= "an" saga_an_noun

saga_an_noun ::= noun_artifact | noun_enchantment

/* @sem $saga_a_noun */
saga_cost_a_card ::= "a" saga_a_noun

saga_a_noun ::= noun_creature | noun_land | noun_planeswalker | noun_battle

/* @prefer always */
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_target_mill_exile_graveyard}), @scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_target_mill_exile_graveyard})] */
chapter_1_2_target_mill_exile_graveyard ::= "i" "," "II" "—" chapter_target_mill_exile_graveyard "."

/* The same announced player mills and owns the graveyard to be exiled. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Mill{players:One($target_player), amount:$card_count}}, Effect{result:@next, operation:Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One($target_player)}, kind:Card, filter:Any}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]} */
chapter_target_mill_exile_graveyard ::= target_player "mills" card_count "," "then" "exiles" "their" "graveyard"

/* The linked population enters under the ability controller, with the printed face-down characteristics. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([$noun, ExiledWith(Source)])}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[FaceDownAs(_{power:$number_digits, toughness:$number_digits_2, creature_type:@subtype_name($subtype), artifact:true})]}}, qualifiers:[]}}]} */
chapter_linked_face_down_arrival ::= "put" "all" noun "cards" "exiled" "with" "this" "enchantment" "onto" "the" "battlefield" "face" "down" "under" "your" "control" "." "they're" number_digits "/" number_digits subtype "artifact" "creatures"

/* A single created object is the antecedent of all three follow-ups. */
/* @sem Program::Program{instructions:[...$clause_imperative, ...$clause_created_gains, ...$clause_created_if_subtype_counters, ...$clause_created_sacrifice_your_next_end]} */
/* @prefer always */
chapter_created_grant_counter_cleanup ::= clause_imperative "." clause_created_gains "." clause_created_if_subtype_counters "." clause_created_sacrifice_your_next_end

/* Scope comma-separated mana spelling to the chapter's ordered program. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:$saga_mana_comma_list}}, ...$instructions_exile_source_return]} */
/* @prefer always */
chapter_mana_exile_return ::= "add" saga_mana_comma_list "." instructions_exile_source_return

/* @sem Program::Program{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:$saga_mana_comma_list}}, ...$instructions_self_return_front]} */
chapter_mana_exile_return_front ::= "add" saga_mana_comma_list "." instructions_self_return_front

/* @sem ManaProduction::All([$mana_bundle, ...$saga_mana_comma_tail]) */
saga_mana_comma_list ::= mana_bundle "," saga_mana_comma_tail

/* @sem ManaProduction::[$mana_bundle] */
saga_mana_comma_last ::= "and" mana_bundle

/* @sem ManaProduction::[$mana_bundle, ...$saga_mana_comma_tail] */
saga_mana_comma_more ::= mana_bundle "," saga_mana_comma_tail

saga_mana_comma_tail ::= saga_mana_comma_last | saga_mana_comma_more

/* These chapter sequences combine reusable instructions without widening the ordinary clause dispatch. */
/* @sem Program::Program{instructions:[...$clause, ...$hand_rule_controlled]} */
chapter_hand_rule_sequence ::= clause sequencer hand_rule_controlled

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(HandSize(Unlimited))], duration:WhileControlled{player:AbilityController, object:Source}, evaluation:LiveObjects}}] */
hand_rule_controlled ::= "you" "have" "no" "maximum" "hand" "size" "for" "as" "long" "as" "you" "control" self_explicit_ref

/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$cast_free_hand_plural}]}}, ...$instructions]} */
chapter_optional_hand_cast_sequence ::= "you" "may" cast_free_hand_plural sequencer instructions

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$return_negated_permanents}]} */
chapter_return_negated_program ::= return_negated_permanents

/* @prefer always */
/* @sem Operation::Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$subtype_negated, $plural])}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
return_negated_permanents ::= "return" "all" subtype_negated plural "to" "their" "owners'" "hands"

/* The chapter raises the allowance of abilities on the named population. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(ActivationGrant{abilities:AllOf([OnStack(Loyalty), AbilityOf($filter_plural)]), grant:AtLeastEachTurn($loyalty_turn_allowance)})], duration:$this_duration, evaluation:LiveObjects}}]} */
chapter_loyalty_activation_turn ::= "you" "may" "activate" "the" "loyalty" "abilities" "of" filter_plural loyalty_turn_allowance this_duration "rather" "than" "only" "once"

/* Shared chapter programs keep each operation and its operands in its own scope. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$choose_a_card_name}]} */
chapter_choose_card_name ::= choose_a_card_name

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:Chosen(CardName)}, duration:$this_duration, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}]}, once:true}}]} */
chapter_chosen_name_cast_trigger ::= "when" "you" "cast" "a" "spell" "with" "the" "chosen" "name" "for" "the" "first" "time" this_duration "," "draw" card_count

/* @sem Program::Program{instructions:[Effect{result:@next, operation:LookAt{player:AbilityController, objects:$library_tops}}]} */
chapter_look_library_tops ::= "look" "at" library_tops

/* A quoted activation carries the chapter sentence punctuation inside the quotation. */
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_controlled_quoted_grant})] */
chapter_2_quoted_program ::= "II" "—" chapter_controlled_quoted_grant

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}), changes:[$grant_quoted_activation], duration:$duration, evaluation:Snapshot}}]} */
chapter_controlled_quoted_grant ::= duration "," filter_plural "you" "control" "gain" grant_quoted_activation

/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])}), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}]} */
chapter_controlled_keyword_plain ::= filter_plural "you" "control" "gain" keyword_name duration

/* Five consecutive chapters each retain a separate ability scope. */
/* @prefer always */
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(5), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(6), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_2_3_4_5_6 ::= "II" "," "III" "," "IV" "," "V" "," "VI" "—" chapter_program "."

/* A temporary replacement retains the source filter and the event's recipient. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Any, sources:AllOf([$adjective_color, ControlledBy(One(AbilityController))]), recipients:ObjectsAndPlayers{objects:Any, players:All}, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Add([EventAmount, $number]))}}]}}}]} */
chapter_colored_source_damage_bonus ::= "if" "a" adjective_color "source" "you" "control" "would" "deal" "damage" "to" "a" "permanent" "or" "player" this_duration "," "it" "deals" "that" "much" "damage" "plus" number "to" "that" "permanent" "or" "player" "instead"

/* Announce an optional permanent before the distributive damage instruction. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamageFromEach{sources:$damage_each_population, recipients:Objects(One($target_up_to_one)), amount:ObjectProperty{object:Affected, property:$stat, information:CurrentOrLastKnown}}}]} */
chapter_choose_each_property_damage ::= "choose" target_up_to_one "." damage_each_population "deals" "damage" "equal" "to" "its" stat "to" "that" "permanent"

/* The announced target is copied directly; the same-name exclusion checks the
   controller's current token population, independently of the copied subtype. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:Copy{object:$copy_distinct_name_target, exceptions:$copy_distinct_name_exceptions}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
chapter_choose_distinct_name_copy ::= "choose" copy_distinct_name_target "." "create" "a" "token" "that's" "a" "copy" "of" "it" "," "except" copy_distinct_name_exceptions

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(Token), $noun, ControlledBy(One(AbilityController)), Not(SharesNameWithAny(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Token, ControlledBy(One(AbilityController))])}))])}), index:0} */
copy_distinct_name_target ::= "target" "nontoken" noun "you" "control" "that" "doesn't" "have" "the" "same" "name" "as" "a" "token" "you" "control"

/* @sem Vec<CopyException>::[CopyException::RemoveSupertypes([Legendary]), CopyException::AddCreatureTypes($becomes_types), $copy_added_keyword] */
copy_distinct_name_exceptions ::= "it" "isn't" "legendary" "," "is" "a" becomes_types "in" "addition" "to" "its" "other" "types" "," "and" "has" copy_added_keyword

/* A temporary trigger retains its event, duration and complete resolving program. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTrigger{event:$event_attacks, duration:$this_duration, announcement:@announcement, body:$chapter_draw_and_life}}]} */
chapter_temporary_event ::= "whenever" event_attacks this_duration "," chapter_draw_and_life

/* @prefer always */
/* @sem Program::Program{instructions:$instructions_named_card_delayed_combat} */
chapter_named_card_delayed_combat ::= instructions_named_card_delayed_combat

/* The copy operation uses the exact objects selected by the preceding choice. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([AnyOf([AllOf([$noun, Token]), AllOf([$noun_2, Token])]), ControlledBy(One(AbilityController))])}, count:AnyNumber, constraints:[DifferentNames]}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:CopyEach{objects:Selected(@prior), exceptions:[]}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
chapter_choose_different_tokens_copy ::= "choose" "any" "number" "of" noun "tokens" "and" "/" "or" noun "tokens" "you" "control" "with" "different" "names" "." "for" "each" "of" "them" "," "create" "a" "token" "that's" "a" "copy" "of" "it"

/* The selected population is frozen by NoteObjects before either follow-up. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:NoteObjects{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$adjective_nontype, ControlledBy(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0}))])}}}, Effect{result:@next, operation:SetTapped{objects:Selected(@prior), tapped:true}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Selected(@back(3))), changes:[Rule(UntapStep{players:One(ControllerOf(Affected)), behavior:Skip})], duration:DuringControllersNextUntapStep, evaluation:LiveObjects}}]} */
chapter_tap_opponent_permanents_skip ::= "tap" "all" adjective_nontype "permanents" "target" "opponent" "controls" "." "they" "don't" "untap" "during" "their" "controller's" "next" "untap" "step"

/* The untap refers to the same announced target as the control effect. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:ControlledBy(OpponentsOf(AbilityController))}), index:0})), changes:[SetController(AbilityController)], duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:SetTapped{objects:One(Target{slot:0, index:0}), tapped:false}}]} */
chapter_gain_opponent_permanent_untap ::= "gain" "control" "of" "target" "permanent" "an" "opponent" "controls" "." "untap" "it"

/* Eight takes the article an; the remaining token operands stay compositional. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:@token_abilities(TokenRecipe::Defined(_{name:FromSubtypes, colors:$token_colors, card_types:$token_types, subtypes:$token_subtypes, power_toughness:[Expr::Constant(8), $token_stat]}), $token_ability_description)}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
chapter_create_eight_token ::= "create" "an" "8" "/" token_stat token_colors token_subtypes token_types "token" token_ability_description

/* Flavor headings are scoped to the associated action shape. */
