/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo($number), filter:@and($chapter_snow_permanent_filter, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))})), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]} */
