/* Sagas. A chapter line names its chapters; each is a trigger on its lore count. */
line_saga ::= line_saga_plain | line_saga_reminded | line_saga_sacrifice_reminded | line_read_ahead_reminded
/* @sem Ability::[Ability::Saga{chapters:$chapters}] */
line_saga_plain ::= chapters

/* The header explains intrinsic Saga rules. Where it names a final chapter,
   the number has to agree with the trigger list in both directions. */
/* @sem Ability::[WithPresentation{reminder:true, ability:Saga{chapters:$chapters}}] */
line_saga_reminded ::= "(" saga_lore_reminder ")" NEWLINE chapters
/* @sem Ability::[WithPresentation{reminder:true, ability:Saga{chapters:@saga_final_chapter($chapters, $saga_sacrifice_reminder)}}] */
/* @prefer always */
line_saga_sacrifice_reminded ::= "(" saga_lore_reminder saga_sacrifice_reminder ")" NEWLINE chapters
/* @sem Ability::[WithPresentation{reminder:true, ability:$bare_read_ahead}, Saga{chapters:@saga_final_chapter($chapters, $saga_sacrifice_reminder)}] */
line_read_ahead_reminded ::= bare_read_ahead "(" "choose" "a" "chapter" "and" "start" "with" "that" "many" "lore" "counters" "." "add" "one" "after" "your" "draw" "step" "." "skipped" "chapters" "don't" "trigger" "." saga_sacrifice_reminder ")" NEWLINE chapters
/* @sem () */
saga_lore_reminder ::= "as" "this" "Saga" "enters" "and" "after" "your" "draw" (NEWLINE "↓")? "step" ","? "add" "a" "lore" "counter" "."
/* @sem $saga_final_numeral */
saga_sacrifice_reminder ::= "sacrifice" "after" saga_final_numeral "."
saga_final_numeral ::= saga_final_i | saga_final_ii | saga_final_iii | saga_final_iv | saga_final_v | saga_final_vi
/* @sem u32::1 */
saga_final_i ::= "I"
/* @sem u32::2 */
saga_final_ii ::= "II"
/* @sem u32::3 */
saga_final_iii ::= "III"
/* @sem u32::4 */
saga_final_iv ::= "IV"
/* @sem u32::5 */
saga_final_v ::= "V"
/* @sem u32::6 */
saga_final_vi ::= "VI"

chapters ::= saga_graveyard_recovery_chapters | chapters_flavored_next_cast | chapters_one | chapters_more | chapters_ring_tempts_three_pref | chapters_search_exile_face_down_reveal_put | chapters_mill_graveyard_payment_and_life_scry | chapters_phase_out_while_controlled_destroy_tokens | chapters_1_2_3_mill_take_pref3_h3

chapters_one ::= chapter_first

/* @sem Ability::[...$chapter_first, ...$chapter_tail] */
chapters_more ::= chapter_first NEWLINE chapter_tail

chapter_first ::= chapter_1_jimothy_token | chapter_1_assimilate_permanent_reminded | chapter_1_quantified_reminder | chapter_1_flavored_quoted_token | chapter_1_2_target_mill_exile_graveyard | chapter_1_operation_quoted_token | chapter_1_2_closed_activation | chapter_1_final_quoted_grant | chapter_1_2_3_4_5_6 | chapter_1_quoted_token | chapter_1_modal | chapter_1_2_modal | chapter_1_2_3_modal | chapter_1_2_3_4_modal | chapter_1 | chapter_1_2 | chapter_1_2_3 | chapter_1_2_3_4 | chapter_1_2_tap_counter | chapter_1_granted_activation | chapter_1_3 | chapter_first_reminded

chapter_tail ::= chapter_next_entry_then_transform | chapter | chapter_tail_more | chapter_tail_grouped_2_3_4 | chapter_2_paired_combat_and_3_equal_x

/* @sem Ability::[...$chapter, ...$chapter_tail] */
chapter_tail_more ::= chapter NEWLINE chapter_tail
chapter ::= chapter_2_amass_reminded | chapter_3_quoted_token | chapter_2_paired_quoted_tokens | chapter_2_3_attack_cost | chapter_3_named_token_quote | chapter_4_named_token_quote | chapter_2_3_4_5 | chapter_2_modal | chapter_3_modal | chapter_4_modal | chapter_5_modal | chapter_6_modal | chapter_2_3_modal | chapter_3_4_modal | chapter_4_5_modal | chapter_2_3_4_modal | chapter_3_4_5_modal | chapter_4_5_6_modal | chapter_2 | chapter_3 | chapter_4 | chapter_5 | chapter_6 | chapter_2_3 | chapter_3_4 | chapter_4_5 | chapter_2_3_4 | chapter_3_4_5 | chapter_4_5_6 | chapter_2_granted_activation | chapter_2_quoted_program | chapter_2_3_4_5_6 | chapter_5_flavored_counter_pump | chapter_2_4 | chapter_2_4_quoted | chapter_2_saga_granted_static | chapter_2_saga_granted_trigger | chapter_2_flavor_grant | chapter_2_quoted_token | chapter_other_reminded

/* The explanation follows the printed chapter's program, including grouped
   chapters that share one surface. Preserve the shared chapter triggers. */
/* @sem Vec<Ability>::@chapter_reminder($remindable_first_chapter, $ability_explanation) */
chapter_first_reminded ::= remindable_first_chapter "(" ability_explanation ")"
remindable_first_chapter ::= chapter_1_3 | chapter_1_operation_quoted_token | chapter_1_quoted_token | chapter_1 | chapter_1_2 | chapter_1_2_3 | chapter_1_2_3_4

/* @sem Vec<Ability>::@chapter_reminder($remindable_other_chapter, $ability_explanation) */
chapter_other_reminded ::= remindable_other_chapter "(" ability_explanation ")"
remindable_other_chapter ::= chapter_2_quoted_token | chapter_2 | chapter_3 | chapter_4 | chapter_5 | chapter_6
    | chapter_2_3 | chapter_3_4 | chapter_4_5 | chapter_2_3_4 | chapter_3_4_5 | chapter_4_5_6

/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_1 ::= "i" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_2 ::= "II" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_3 ::= "III" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_4 ::= "IV" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(5), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_5 ::= "V" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(6), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_6 ::= "VI" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_1_2 ::= "i" "," "II" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_2_3 ::= "II" "," "III" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_3_4 ::= "III" "," "IV" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(5), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_4_5 ::= "IV" "," "V" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
/* @prefer always */
chapter_1_2_3 ::= "i" "," "II" "," "III" "—" chapter_program "."
/* @prefer always */
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_2_3_4 ::= "II" "," "III" "," "IV" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(5), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_3_4_5 ::= "III" "," "IV" "," "V" "—" chapter_program "."
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(5), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(6), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_4_5_6 ::= "IV" "," "V" "," "VI" "—" chapter_program "."

/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
/* @prefer always */
chapter_1_2_3_4 ::= "i" "," "II" "," "III" "," "IV" "—" chapter_program "."

/* These observed chapter flavor headings have no rules meaning. The Roman
   chapter list remains outside this wrapper and retains every trigger number.
   Unknown/mechanical headings are never discarded by dash syntax. */
chapter_program ::= chapter_self_damage_target_group | chapter_targets_cant_block_turn | chapter_discard_property_tail | program_vote_linked_exile_bottom | chapter_prevent_from_targets | chapter_gain_control_bounded | chapter_fight_optional_target | chapter_next_spell_free | chapter_double_stats_with_keyword | chapter_damage_then_combat_control | chapter_optional_target_owner_draw_shuffle | chapter_choose_bounded_graveyard_shuffle | chapter_linked_common_card_type | chapter_exile_linked_assimilated | chapter_judgment_flavor_program | chapter_linked_face_down_arrival | chapter_target_mill_exile_graveyard | chapter_defined_token_damage | chapter_counter_creatures_one | chapter_counter_creatures_many | chapter_repeat_mill_common_type | chapter_exile_copy_cards | chapter_draw_and_life | chapter_capped_return_type | chapter_each_target_counter | chapter_opponent_choice | program | chapter_flavor_program | chapter_counted_mana | chapter_opponent_graveyard_loss | chapter_target_block_ring | chapter_distribute_counters | ordered_opponent_permanent_exile | optional_opponent_draw_then_draw | saga_exile_return_transformed | chapter_controlled_plural_keyword | chapter_owned_cards_perpetual | chapter_seek_battlefield | chapter_mill_then_return | chapter_return_then_shuffle | chapter_exile_each_graveyard | chapter_lore_mana_linked_cast | chapter_optional_discard_draw_receipt | chapter_temporary_attack_pump | chapter_discard_investigate | chapter_draw_controlled_unowned | chapter_each_choose_destroy | chapter_exile_targets_gain_per_type | chapter_return_union_card_hand | chapter_domain_pump_keyword | chapter_players_get_counters | chapter_counter_total_tokens | chapter_controlled_either_counters | chapter_mill_then_exile_each_graveyard | chapter_linked_exile_cast_any_color | chapter_opponent_animation | chapter_created_token_keyword | chapter_destroy_transform | chapter_attack_you_cost | chapter_named_tokens_opponent_control_count | chapter_copy_flavor | chapter_draw_each_lose | chapter_create_per_source_counter | chapter_mana_cost_search | chapter_each_player_exile_until | chapter_mana_exile_return | chapter_created_grant_counter_cleanup | chapter_hand_rule_sequence | chapter_optional_hand_cast_sequence | chapter_return_negated_program | chapter_loyalty_activation_turn | chapter_choose_card_name | chapter_chosen_name_cast_trigger | chapter_look_library_tops | chapter_controlled_keyword_plain | chapter_colored_source_damage_bonus | chapter_choose_each_property_damage | chapter_choose_distinct_name_copy | chapter_temporary_event | chapter_named_card_delayed_combat | chapter_choose_different_tokens_copy | chapter_create_eight_token | chapter_tap_opponent_permanents_skip | chapter_gain_opponent_permanent_untap | chapter_lunge_fight | chapter_brimstone_blink | chapter_extreme_return_heading | chapter_tap_target_counter | chapter_each_player_graveyard_life | chapter_tapped_powerstones | chapter_tap_reflexive_damage | chapter_optional_artifact_animation | chapter_resolution_if | chapter_multiple_each_target_counters | chapter_each_non_saga_duplicate | chapter_search_reveal_hand | saga_counter_two_keywords | saga_named_equipment_token | saga_tap_and_counter | chapter_temporary_controlled_damage | chapter_flavored_controlled_keyword | chapter_controlled_keyword_each_counter | chapter_opponent_count_tokens_h3 | chapter_opponent_may_sacrifice_nontoken_else_h3 | chapter_program_energy | chapter_mana_exile_return_front

/* @sem Program::Program{instructions:[...$instructions, ...$reminder_open]} */
chapter_program_energy ::= instructions "." reminder_open

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$mana_add_counted}]} */
chapter_counted_mana ::= mana_add_counted

/* @sem $program */
chapter_flavor_program ::= saga_flavor_heading "—" program

/* @sem () */
saga_flavor_heading ::= "wark" | "kerplunk" | "gungnir" | "zantetsuken" | "hall of Sorrow" | "chain" | "gestalt Mode" | "stampede" "!" | "mesmerize" | "cold Snap" | "aerial Blast" | "aerospark" | "fire" | "flames of Rebirth" | "gigaflare" | "ice" | "jecht Beam" | "lightning" | "mega Flare" | "oblivion" | "pain" | "rising Flames" | "slipstream" | "sonic Wings" | "ultimate End" | "ultimate Jecht Shot" | "wings of Light" | "heavenly Strike" | "diamond Dust"

/* Modal chapters announce their menus before resolution; each repeated chapter
   and each mode owns its target and result namespace. */
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_1_modal ::= "i" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_2_modal ::= "II" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_3_modal ::= "III" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_4_modal ::= "IV" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(5), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_5_modal ::= "V" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(6), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_6_modal ::= "VI" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_1_2_modal ::= "i" "," "II" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_2_3_modal ::= "II" "," "III" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_3_4_modal ::= "III" "," "IV" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(5), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_4_5_modal ::= "IV" "," "V" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_1_2_3_modal ::= "i" "," "II" "," "III" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_2_3_4_modal ::= "II" "," "III" "," "IV" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(5), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_3_4_5_modal ::= "III" "," "IV" "," "V" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(5), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(6), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_4_5_6_modal ::= "IV" "," "V" "," "VI" "—" mode_selection
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}}), @scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:Announcement{modes:$mode_selection}, body:Program{}})] */
chapter_1_2_3_4_modal ::= "i" "," "II" "," "III" "," "IV" "—" mode_selection

/* @prefer always */
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(2), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(4), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program}), @scope(Ability::Triggered{event:SagaChapter(5), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_program})] */
chapter_2_3_4_5 ::= "II" "," "III" "," "IV" "," "V" "—" chapter_program "."

/* @prefer always */
/* Chapter phrases bind each opponent explicitly and retain their separate graveyards. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:OpponentsOf(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan($counter_amount)})}]} */
chapter_opponent_choice ::= "each" "opponent" "sacrifices" counter_amount filter_phrase "of" "their" "choice"
/* @sem Program::Program{instructions:[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(Bound(0)), amount:$bound_graveyard_card_count}}]}}]} */
chapter_opponent_graveyard_loss ::= "each" "opponent" "loses" "1" "life" bound_graveyard_card_count
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($target_up_to_one), changes:[Rule(Prohibit(Block(Any)))], duration:WhileControlled{player:AbilityController, object:Source}, evaluation:LiveObjects}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::RingTempts}}]} */
chapter_target_block_ring ::= target_up_to_one "can't" "block" "for" "as" "long" "as" "you" "control" "this" "Saga" "." "the" "Ring" "tempts" "you"

/* A chapter ending in a quoted token ability has its final period inside the quote. */
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(3), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$chapter_quoted_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}})] */
chapter_3_named_token_quote ::= "III" "—" "create" chapter_quoted_token

/* A standalone distribution chapter prints its total as a cardinal word. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$distribute_counters_chapter_targets}]} */
chapter_distribute_counters ::= distribute_counters_chapter_targets

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo($count_plural), filter:$filter_plural, distribute:$count_plural}))), kind:$counter_kind, amount:DistributedShare(@share)}]} */
distribute_counters_chapter_targets ::= "distribute" count_plural counter_kind "counters" "among" "any" "number" "of" "target" filter_plural

/* A quoted intrinsic ability supplies the final sentence punctuation. */
/* @sem Ability::[@scope(Ability::Triggered{event:SagaChapter(1), limits:TriggerLimits{}, announcement:@announcement, body:$chapter_quoted_token_program})] */
chapter_1_quoted_token ::= "i" "—" chapter_quoted_token_program

/* A chapter distributes one counter to each selected target. */
/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:$plural_target_count_any, filter:$filter_plural}))), kind:$counter_kind, amount:Constant(1)}]}}]} */
chapter_each_target_counter ::= "put" "a" counter_kind "counter" "on" "each" "of" plural_target_count_any "target" filter_plural

/* The player order and the chosen population are separate from the exile. */
/* @sem Program::Program{instructions:[ForEachPlayer{players:All, binding:0, starting_with:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Property{property:ManaValue, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number_digits}}, ControlledBy(OpponentsOf(AbilityController))])}, count:UpTo(Constant(1))}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]} */
ordered_opponent_permanent_exile ::= "starting" "with" "you" "," "each" "player" "chooses" "up" "to" "one" "permanent" "with" "mana" "value" number_digits "or" "greater" "from" "among" "permanents" "your" "opponents" "control" "." "exile" "those" "permanents"

/* The player performing the optional action remains the announced opponent. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0}, body:_{instructions:[Effect{result:@next, operation:Draw{players:One(Target{slot:0, index:0}), amount:$card_count}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:_{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count_2}}]}, otherwise:_{}}]} */
optional_opponent_draw_then_draw ::= "you" "may" "have" "target" "opponent" "draw" card_count "." "if" "you" "do" "," "draw" card_count

/* The second move follows the actual exile arrival. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One(Source), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:@exile_followup(InZone{objects:One(Result{result:@prior, phase:After, index:0}), zone:Exile}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[Transformed]}}, qualifiers:[]}}]} */
saga_exile_return_transformed ::= "exile" "this" "Saga" "," "then" "return" "it" "to" "the" "battlefield" "transformed" "under" "your" "control"

/* Scoped chapter phrases retain target, chooser, owner and selection identities. */
