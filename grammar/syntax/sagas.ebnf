/* @sem Program::Program{instructions:[ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any}), count:AsManyAsCan($number)}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]} */
chapter_choose_graveyards_shuffle ::= "choose" number "cards" "in" "each" "graveyard" "." "their" "owners" "shuffle" "those" "cards" "into" "their" "libraries"

/* Outside the battlefield, the noun keeps its card-type restriction. */
