/* @sem Program::Program{instructions:[@resolution(Instruction::If{condition:$control_greatest_power_post, then:Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(PlayerRef::AbilityController), $verb_operation_imperative)}]}, otherwise:Program{}})]} */
