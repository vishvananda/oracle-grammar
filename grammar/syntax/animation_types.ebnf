/* Explicit retention modifies the animation, rather than a later no-op.
   Named artifact-creature animations without retention still replace creature
   types (CR 205.1b). Colors and granted abilities are independent. */

/* @sem @retain_animation_types($change_becomes) */
retained_change ::= change_becomes ("↓")? retention_suffix

retention_suffix ::= retention_addition | retention_inline
/* @sem () */
retention_addition ::= "in" "addition" "to" ("its" | "their") "other" "types"
/* @sem () */
retention_inline ::= "that's" "still" ("a" | "an")? retention_type

retention_note ::= retention_singular | retention_plural
/* @sem () */
retention_singular ::= ("it's" | "he's" | "she's") "still" ("a" | "an")? retention_type
/* @sem () */
retention_plural ::= "they're" "still" retention_plural_type
/* @sem () */
retention_type ::= "land" | "artifact" | "creature" | "enchantment" | "planeswalker" | "Cave" "land"
/* @sem () */
retention_plural_type ::= "lands" | "artifacts" | "creatures" | "enchantments" | "planeswalkers"

retained_animation ::= retained_land_keyword_quote | retained_animation_while_tapped | retained_animation_each | retained_animation_after | retained_animation_before | retained_animation_indefinite | retained_animation_existing | retained_animation_quoted
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:@retain_animation_types($changes), duration:$duration, evaluation:Snapshot} */
retained_animation_after ::= affected changes ("↓")? duration "." retention_note
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:@retain_animation_types($changes), duration:$duration, evaluation:Snapshot} */
retained_animation_before ::= duration "," affected changes "." retention_note

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:@retain_animation_types($dynamic_animation), duration:Indefinite, evaluation:Snapshot} */
retained_animation_indefinite ::= affected dynamic_animation "." retention_note

/* The ability source supplies the duration independently of the affected object. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects($affected), changes:@retain_animation_types($changes), duration:WhileMatches{object:$self_ref, filter:Tapped}, evaluation:Snapshot} */
retained_animation_while_tapped ::= affected changes "for" "as" "long" "as" self_ref "remains" "tapped" "." retention_note

/* Existing operations supply their own target/group and duration operands. */
/* @sem Operation::@retain_animation($mined_operation) */
retained_animation_existing ::= mined_operation "." retention_note

/* A complete final quotation also supplies the enclosing sentence's stop. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:@retain_animation_types($animation_quoted), duration:$duration, evaluation:Snapshot} */
retained_animation_quoted ::= duration "," affected animation_quoted retention_note

/* @sem Program::@where(Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:@retain_animation_types($changes), duration:$duration, evaluation:Snapshot}}]}, $value) */
program_retained_defined ::= affected changes ("↓")? duration "," "where" "X" "is" value "." retention_note

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($affected), changes:@retain_animation_types($static_animation)}) */
static_retained_animation ::= affected static_animation "." retention_note "."

/* A supertype-only change preserves all other type-line components. */
change_supertype_snow ::= change_add_snow | change_remove_snow
change_add_snow ::= change_becomes_snow | change_become_snow | change_is_snow | change_are_snow
/* @sem Change::[RemoveSupertype(Snow)] */
change_remove_snow ::= ("isn't" | "aren't") "snow"

change_becomes_legendary ::= legendary_animation | legendary_animation_with
/* @sem Change::[AddSupertype(Legendary), SetBasePowerToughness{power:$number, toughness:$number_2}, ...$legendary_creature_kind] */
legendary_animation ::= ("becomes" | "become") ("a" | "an") "legendary" number "/" number legendary_creature_kind
/* @sem Change::[...$legendary_animation, ...$grants] */
legendary_animation_with ::= legendary_animation "with" grants

/* Explicit retained types are indefinite when no duration is stated. This is
   a resolution effect; it does not make a static property of a live query. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:@retain_animation_types($dynamic_animation), duration:Indefinite, evaluation:Snapshot} */
continuous_retained_inline_indefinite ::= affected dynamic_animation retention_suffix
/* "Is" immediately after a battlefield return supplies an entry characteristic
   (CR611.2e); "becomes" creates a later continuous effect. */
/* @prefer always */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$dynamic_type_addition, duration:Indefinite, evaluation:Snapshot} */
continuous_type_addition_indefinite ::= affected dynamic_type_addition
/* @sem Change::[CreatureTypes{mode:Add, types:Listed($becomes_types)}] */
dynamic_type_addition ::= ("becomes" | "become") ("a" | "an")? becomes_types "in" "addition" "to" ("its" | "their") "other" ("creature")? "types"

/* A new perpetual type change has an explicit source or an actual one-card
   draft receipt. Bare pronouns after other choices keep their prior contract. */
/* @sem $bk_artifact */
perpetual_artifact_creature ::= ("becomes" | "become") ("a" | "an") bk_artifact
/* @sem Instruction::[Effect{result:@next, operation:CreatePerpetualEffect{objects:One($self_explicit_ref), changes:$perpetual_artifact_creature}}] */
clause_perpetual_source_types ::= self_explicit_ref "perpetually" perpetual_artifact_creature
/* @sem Instruction::[Effect{result:@next, operation:$draft_one_source_spellbook}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$perpetual_artifact_creature}}] */
instructions_draft_perpetual_types ::= draft_one_source_spellbook "." "that" "card" "perpetually" perpetual_artifact_creature
/* @sem Operation::DraftFromSpellbook{actor:One(AbilityController), spellbook:@card_name, times:Constant(1)} */
draft_one_source_spellbook ::= "draft" ("a" | "one") "card" "from" self_named "'s" "spellbook"

/* A named creature animation replaces card types unless retention is explicit. */
legendary_creature_kind ::= legendary_named_creature | legendary_colored_creature
/* @sem Change::[CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetCardTypes([Creature])] */
legendary_named_creature ::= becomes_types "creature"
/* @sem Change::[Colors{mode:Set, colors:[$mana_color_word]}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, SetCardTypes([Creature])] */
legendary_colored_creature ::= mana_color_word becomes_types "creature"

/* The plural subject is selected once; the note retains its prior card types. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:@retain_animation_types($plural_named_animation), duration:$duration, evaluation:Snapshot} */
retained_animation_each ::= affected "each" plural_named_animation duration "." retention_plural
/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Set, types:Listed($becomes_types)}, AddCardType(Creature)] */
plural_named_animation ::= "become" value "/" value becomes_types "creatures"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:AtLeast($number), filter:$plural}))), changes:[Colors{mode:Set, colors:[$mana_color_word]}], duration:$duration, evaluation:Snapshot} */
at_least_target_creatures_become_color ::= number "or" "more" "target" plural "become" mana_color_word duration

/* Retaining both color and creature type makes both changes additive. */
/* @sem Change::[Colors{mode:Add, colors:[$mana_color_word]}, CreatureTypes{mode:Add, types:Listed($becomes_types)}] */
dynamic_colored_type_addition ::= "becomes" "a" mana_color_word becomes_types "in" "addition" "to" "its" "other" "colors" "and" "types"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:$dynamic_colored_type_addition, duration:Indefinite, evaluation:Snapshot} */
continuous_colored_type_addition_indefinite ::= affected dynamic_colored_type_addition

/* The quoted ability is scoped to each animated object's holder. */
/* @prefer always */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($group_subject)), changes:@retain_animation_types($plural_animation_with_trigger), duration:Indefinite, evaluation:Snapshot} */
retained_animation_each_quoted ::= group_subject "each" plural_animation_with_trigger retention_plural

/* @sem Change::[...$plural_named_animation, GrantKeyword($keyword_name), GrantKeyword($keyword_name_2), GrantAbility(@scope(Ability::Triggered{event:$animated_creature_leaves, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$quoted_conjure_battlefield_tapped}]}}))] */
plural_animation_with_trigger ::= plural_named_animation "with" keyword_name "," keyword_name "," "and" '"' "when" animated_creature_leaves "," quoted_conjure_battlefield_tapped "." '"'

/* @sem EventSpec::Object{event:LeavesBattlefield, objects:SameObject(Source)} */
animated_creature_leaves ::= "this" "creature" "leaves" "the" "battlefield"

/* @sem Operation::Conjure{actor:One(AbilityController), card:Named($referenced_card_name), count:$card_count, destination:Battlefield(BattlefieldArrival{tapped:true, counters:[], states:[]})} */
quoted_conjure_battlefield_tapped ::= "conjure" card_count "named" referenced_card_name "onto" "the" "battlefield" "tapped"

/* A creature acquires the named creature type indefinitely. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(@self)), changes:[CreatureTypes{mode:Add, types:Listed([@subtype_name($becomes_creature_subtype)])}], duration:Indefinite, evaluation:Snapshot} */
self_creature_becomes_type ::= self_creature "becomes" "a" becomes_creature_subtype

/* An explicitly named source retains its planeswalker type when animated. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:@retain_animation_types($animation_plain), duration:EndOfTurn, evaluation:Snapshot} */
source_retained_turn_animation ::= "until" "end" "of" "turn" "," self_named "becomes" animation_plain "that's" "still" "a" "planeswalker"

/* The pronoun is scoped to the named source in the preceding animation. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject(Source)), kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:EndOfTurn, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
source_him_turn_prevention ::= "prevent" "all" "damage" "that" "would" "be" "dealt" "to" "him" "this" "turn"

/* @sem Instruction::[Effect{result:@next, operation:$source_retained_turn_animation}, Effect{result:@next, operation:$source_him_turn_prevention}] */
instructions_source_animation_prevention ::= source_retained_turn_animation "." source_him_turn_prevention

/* @sem Change::[AddSupertype(Snow)] */
change_becomes_snow ::= "becomes" "snow"

/* @sem Change::[AddSupertype(Snow)] */
change_become_snow ::= "become" "snow"

/* @sem Change::[AddSupertype(Snow)] */
change_is_snow ::= "is" "snow"

/* @sem Change::[AddSupertype(Snow)] */
change_are_snow ::= "are" "snow"

/* A retained subtype and a granted keyword share one indefinite snapshot. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[CreatureTypes{mode:Add, types:Listed($becomes_type_one)}, GrantKeyword($keyword_value)], duration:Indefinite, evaluation:Snapshot} */
continuous_retained_type_keyword ::= affected "becomes" "an" becomes_type_one "in" "addition" "to" "its" "other" "types" "and" "gains" keyword_value

/* A retained source land receives the stated characteristics and scoped ability. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:$retained_land_keyword_quote_changes, duration:$duration, evaluation:Snapshot} */
retained_land_keyword_quote ::= duration "," self_land retained_land_keyword_quote_changes "it's" "still" "a" "land"

/* @sem Change::[SetBasePowerToughness{power:$number, toughness:$number_2}, Colors{mode:Set, colors:[$mana_color_word]}, CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Creature), GrantKeyword($keyword_name), GrantAbility(@scope($token_ability_sentence))] */
retained_land_keyword_quote_changes ::= "becomes" "a" number "/" number mana_color_word becomes_types "creature" "with" keyword_name "and" '"' token_ability_sentence '"'
