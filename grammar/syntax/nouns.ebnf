/* @sem ObjectFilter::[$controlled_kind_spelled, $controlled_kind_spelled_2] */
controlled_kind_members_last_pair ::= controlled_kind_spelled "," "or" controlled_kind_spelled

controlled_kind_spelled ::= subtype | companion_folded_elemental | companion_folded_cat

/* Your commanders retain ownership across their public zones. */
/* @sem ObjectSet::Union([Zone{scope:Shared(Command), kind:Card, filter:AllOf([State(Commander), OwnedBy(One(AbilityController))])}, Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([State(Commander), OwnedBy(One(AbilityController))])}]) */
