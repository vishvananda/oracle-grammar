objects_each_convoked ::= "each" filter_phrase "that" "convoked" object_ref

/* The announced target retains its card filter, exact mana value, and owner zone. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($card_filter, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:Expr::@in_filter($number)}}, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0} */
visit_copy_target ::= "target" card_filter "card" "with" "mana" "value" number "from" "your" "graveyard"

