controlled_union_compound ::= noun_atomic filter_simple

/* Both zones belong to the ability controller and share the selected filter. */
/* @sem ObjectSet::Union([Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase})]) */
private_spell_population ::= filter_phrase "spell" "from" "your" "hand" "or" "graveyard"

/* A disjunction of five plural populations joined by the Oracle and/or form. */
/* @sem ObjectFilter::AnyOf([$filter_plural, $filter_plural_2, $filter_plural_3, $filter_phrase, $filter_plural_4]) */
plural_five_and_or ::= filter_plural "," filter_plural "," filter_plural "," filter_phrase "," "and" "/" "or" filter_plural

/* One target must match either kind and be controlled by the ability controller. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([AnyOf([$noun, $noun_2]), ControlledBy(One(AbilityController))])}), index:0} */
target_controlled_kind_union ::= "target" noun "or" noun "you" "control"

/* Players are selected by their own mana-tap history, independently of the action they perform. */
/* @sem PlayerSet::Matching{binding:0, condition:Compare{left:EventHistory{event:Player{event:TapsForMana, players:One(Bound(0)), objects:$filter_phrase}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}}} */
players_tapped_for_mana_this_turn ::= "each" "player" "who" "tapped" counter_amount filter_phrase "for" "mana" "this" "turn"

/* A counted battlefield population retains its noun and controller together. */
/* @sem ObjectFilter::@and($noun, $modifier_you_control) */
