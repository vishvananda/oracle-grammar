/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($target_object), AllOf([Not(SameObject($target_object)), $filter_phrase, Shares{property:Colors, with:$target_object}])])} */
objects_target_and_color_sharing ::= target_object "and" "each" "other" filter_phrase "that" "shares" "a" "color" "with" "it"

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([Not(State(FaceDown)), OwnedBy(One(AbilityController))])} */
face_up_owned_exile_cards ::= "face-up" "exiled" "cards" "you" "own"

/* A selected X-card population from the payer’s hand. */
/* @sem $card_filter */
announced_hand_card_selection ::= "X" card_filter "cards" "from" "your" "hand"

/* @sem Operand::Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}) */
choice_permanent ::= filter_phrase

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ChosenFilter)} */
all_of_that_type ::= "all" filter_plural "of" "that" "type"

/* The card target retains its opponent graveyard and its library arrival origin. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and($card_filter, ObjectFilter::InZone(Players{zone:Graveyard, players:OpponentsOf(PlayerRef::AbilityController)}), ObjectFilter::ArrivedThisTurn{from:Library})}), index:0} */
target_card_opponent_library_arrival ::= "target" card_filter "card" "in" "an" "opponent's" "graveyard" "that" "was" "put" "there" "from" "their" "library" "this" "turn"

/* The hand population and its chosen-type refinement are independent of the change. */
/* @sem ObjectSet::Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter} */
perpetual_hand_cards ::= card_filter "cards" "in" "your" "hand"

/* @sem ObjectSet::Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:@and($card_filter, ObjectFilter::Chosen(CreatureType))} */
chosen_type_hand_cards ::= card_filter "cards" "of" "that" "type" "in" "your" "hand"

/* This producer always taps creatures, so its later creature count is exact. */
/* @sem ObjectFilter::AllOf([Not(Tapped), $adjective_color, CardType(Creature)]) */
tapped_creature_population ::= "untapped" adjective_color "creatures"

