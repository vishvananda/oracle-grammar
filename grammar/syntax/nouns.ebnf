/* @sem ObjectFilter::AnyOf([$filter_phrase, ...$card_kind_union_three_members]) */
card_kind_union_four ::= filter_phrase "," card_kind_union_three_members

/* The card filter and mana ceiling independently constrain this target. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:AllOf([AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:@in_filter($value)}}]), InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0} */
target_one_your_graveyard_mana_ceiling ::= "up" "to" "one" "target" card_filter "card" "with" "mana" "value" value "or" "less" "from" "your" "graveyard"

