counted_graveyard_arrivals ::= filter_phrase "cards" "in" "your" "graveyard" graveyard_arrival_origin

/* @sem ObjectFilter::Condition(Not(Compare{left:EventHistory{event:ZoneChange{objects:SameObject(Candidate), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})) */
modifier_did_not_enter_this_turn ::= "that" "didn't" "enter" "this" "turn"

/* A battlefield population whose members helped cast the referenced spell. */
