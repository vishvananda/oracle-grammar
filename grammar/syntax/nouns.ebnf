/* @sem ConjuredCard::Each(['Ancestral Recall', 'Black Lotus', 'Mox Emerald', 'Mox Jet', 'Mox Pearl', 'Mox Ruby', 'Mox Sapphire', 'Time Walk', 'Timetwister']) */
conjure_power_nine ::= "the" "Power" "Nine"

/* @sem ConjuredCard::Each([$conjure_group_name, $conjure_group_name_2, $conjure_group_name_3, $conjure_group_name_4, $conjure_group_name_5, $conjure_group_name_6, $conjure_group_name_7, $conjure_group_name_8, $conjure_group_name_9]) */
conjure_nine_named_cards ::= "a" "card" "named" conjure_group_name "," "a" "card" "named" conjure_group_name "," "a" "card" "named" conjure_group_name "," "a" "card" "named" conjure_group_name "," "a" "card" "named" conjure_group_name "," "a" "card" "named" conjure_group_name "," "a" "card" "named" conjure_group_name "," "a" "card" "named" conjure_group_name "," "and" "a" "card" "named" conjure_group_name

conjure_group_name ::= conjure_name_0 | conjure_name_1 | conjure_name_2 | conjure_name_3 | conjure_name_4 | conjure_name_5 | conjure_name_6 | conjure_name_7 | conjure_name_8 | conjure_name_9

