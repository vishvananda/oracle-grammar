/* @sem ObjectSet::Zone{scope:Players{zone:$referenced_private_zone, players:One($referenced_private_owner)}, kind:Card, filter:Any} */
referenced_private_cards ::= referenced_private_owner referenced_private_zone

referenced_private_owner ::= zone_its_controller | referenced_its_owner

/* @sem PlayerRef::OwnerOf(@it) */
referenced_its_owner ::= "its" "owner's"

referenced_private_zone ::= exchange_private_hand | hand_exile_graveyard | exchange_private_library

/* Compare the candidate's name with another member of the described battlefield population. */
