hand_size_maximum ::= hand_size_maximum_all | hand_size_maximum_opponents

/* An explicitly distributive target group retains its printed wording. */
/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:$target_count_any, filter:Any})) */
recipients_each_of_targets ::= "each" "of" target_count_any "targets"

/* The recipient is bound by the enclosing damage event. */
/* @sem Recipients::DamagedByEvent */
recipients_damage_event_permanent_or_player ::= "that" "permanent" "or" "player"

/* @sem ObjectFilter::@and($filter_phrase, ObjectFilter::OwnedBy(OpponentsOf(AbilityController))) */
owned_entrant_filter ::= filter_phrase "an" "opponent" "owns"

/* A chosen land type narrows the battlefield population independently of its use. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Chosen(LandType)])} */
objects_each_chosen_land_type ::= "each" filter_phrase "of" "the" "chosen" "type"

/* @sem ObjectFilter::AttackingDefender(Players(OpponentsOf(AbilityController))) */
modifier_attacking_one_of_your_opponents ::= "attacking" "one" "of" "your" "opponents"

/* A stack ability target retains both its kind and its controller. */
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Ability, zones:[Stack]}), count:Exactly(Constant(1)), filter:AllOf([$counter_ability_kind, $counter_ability_controller])}), index:0}) */
counter_one_controlled_ability ::= "target" counter_ability_kind "ability" counter_ability_controller

counter_ability_controller ::= modifier_you_control | modifier_not_controlled

/* The controller is bound to the candidate creature, not the ability controller. */
/* @sem ObjectFilter::AllOf([$combat_creature_state, CardType(Creature), ControlledBy(Matching{binding:0, condition:Controls{player:Bound(0), filter:$controlled_basic_land, minimum:1}})]) */
combat_creature_controller_land ::= combat_creature_state "creature" "whose" "controller" "controls" controlled_basic_land

combat_creature_state ::= adjective_attacking_or_blocking | adjective_attacking | adjective_blocking

controlled_basic_land ::= controlled_island | controlled_other_basic_land

/* @sem $st_island */
controlled_island ::= "an" st_island

/* @sem $other_basic_land */
controlled_other_basic_land ::= "a" other_basic_land

other_basic_land ::= st_plains | st_swamp | st_mountain | st_forest

/* A singular graveyard target retains its filter and arrival history. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and($card_filter, ObjectFilter::ArrivedThisTurn{})}), index:0} */
target_card_arrived_this_turn ::= "target" card_filter "card" "in" "a" "graveyard" "that" "was" "put" "there" "from" "anywhere" "this" "turn"

/* The permanent filter applies only to the battlefield half; the hand contains cards of any kind. */
/* @sem ObjectSet::Union([Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(Bound(0))))}, Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}]) */
controlled_permanents_and_hand_cards ::= filter_plural "they" "control" "and" "/" "or" "cards" "from" "their" "hand"

/* @sem ObjectSet::One($named_spell) */
counter_named_spell ::= named_spell

/* @sem ObjectSet::Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$random_perpetual_hand_filter} */
random_perpetual_hand_population ::= random_perpetual_hand_filter "card" "in" "your" "hand"

random_perpetual_hand_filter ::= filter_phrase | non_creature | non_land

/* Each target retains its own announcement; the graveyard belongs to the
   separately announced player, rather than to either permanent. */
/* @sem ObjectSet::Union([One($target_object), One($target_object_2), $optional_opponent_graveyard_cards]) */
mixed_target_graveyard_union ::= target_object "," target_object "," "and" optional_opponent_graveyard_cards

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:UpTo(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0})}, kind:Card, filter:Any} */
optional_opponent_graveyard_cards ::= "all" "cards" "from" "up" "to" "one" "target" "opponent's" "graveyard"

/* Each arm describes a legendary card, with one optional target overall. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:AnyOf([AllOf([Supertype(Legendary), $noun]), AllOf([Supertype(Legendary), $noun_2])])}), index:0} */
target_graveyard_card_union_optional ::= "up" "to" "one" "target" "legendary" noun "card" "or" "legendary" noun "card" "from" "a" "graveyard"

/* The receipt wording in the consumer requires a creature-only population. */
chosen_counter_creature ::= noun_creature | chosen_counter_creature_modified

/* @sem @and(ObjectFilter::CardType(Creature), $modifiers) */
chosen_counter_creature_modified ::= "creature" modifiers

/* A counter action targets a spell on the stack, retaining its filter. */
/* @sem ObjectSet::One($target_stack_spell) */
counter_one_spell ::= target_stack_spell

/* Compare against the previously chosen spell, including last-known information. */
/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:Expr::ObjectProperty{object:@qualified_object(ObjectKind::Spell, ObjectFilter::Any), property:ManaValue, information:CurrentOrLastKnown}}} */
modifier_chosen_spell_mana_value ::= "with" "the" "same" "mana" "value" "as" "the" "chosen" "spell"

/* Both graveyard prepositions identify the same owned-zone target. */
choose_cast_graveyard_target ::= choose_cast_graveyard_in | choose_cast_graveyard_from

/* @prefer always */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and($card_filter, ObjectFilter::InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}))}), index:0} */
choose_cast_graveyard_in ::= "target" card_filter "card" "in" "your" "graveyard"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and($card_filter, ObjectFilter::InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}))}), index:0} */
choose_cast_graveyard_from ::= "target" card_filter "card" "from" "your" "graveyard"

/* A population of cards in the announced players’ graveyards. */
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:$graveyard_target_players}, kind:Card, filter:Any} */
target_players_graveyard_population ::= graveyard_target_players "graveyards"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Exile]}), count:Exactly(Constant(1)), filter:AllOf([OwnedBy(One(AbilityController)), $exiled_card_qualifier])}), index:0} */
owned_exiled_qualified_card ::= "target" "card" "you" "own" "in" "exile" exiled_card_qualifier

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Exile]}), count:Exactly(Constant(1)), filter:AllOf([OwnedBy(OthersThan(AbilityController)), $exiled_card_qualifier])}), index:0} */
other_exiled_qualified_card ::= "target" "card" "you" "don't" "own" "in" "exile" exiled_card_qualifier

exiled_card_qualifier ::= card_ability_qualifier | modifier_no_abilities

/* A shared-head union preserves each subtype in the graveyard target. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and(ObjectFilter::AnyOf([$subtype, $subtype_2]), ObjectFilter::InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}))}), index:0} */
target_card_subtype_union_your_graveyard ::= "target" subtype "or" subtype "card" "from" "your" "graveyard"

/* Optional singular targets retain the opponent's graveyard and card filter. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:InZone(Players{zone:Graveyard, players:OpponentsOf(AbilityController)})}), index:0} */
optional_opponent_graveyard_card ::= "up" "to" "one" "target" "card" "from" "an" "opponent's" "graveyard"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:@and($card_filter, ObjectFilter::InZone(Players{zone:Graveyard, players:OpponentsOf(PlayerRef::AbilityController)}))}), index:0} */
optional_opponent_graveyard_filtered_card ::= "up" "to" "one" "target" card_filter "card" "from" "an" "opponent's" "graveyard"

/* Two separately announced card targets share their stated graveyard. */
/* @prefer always */
/* @sem ObjectSet::Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:AnyOf([SameObject($graveyard_required_target), SameObject($graveyard_optional_target)])}) */
graveyard_required_optional_targets ::= graveyard_required_target "and" graveyard_optional_target "from" "your" "graveyard"

/* @prefer always */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$card_filter, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0} */
graveyard_required_target ::= "target" card_filter "card"

/* @prefer always */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:@and($graveyard_subtype_union, $noun_creature, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0} */
graveyard_optional_target ::= "up" "to" "one" "target" graveyard_subtype_union noun_creature "card"

/* A four-way creature subtype choice remains one card filter. */
/* @prefer always */
/* @sem ObjectFilter::AnyOf(@unordered([$subtype, ...$graveyard_subtype_tail])) */
graveyard_subtype_union ::= subtype "," graveyard_subtype_tail

graveyard_subtype_tail ::= graveyard_subtype_last_pair | graveyard_subtype_more
/* @sem ObjectFilter::[$subtype, $subtype_2] */
graveyard_subtype_last_pair ::= subtype "," "or" subtype
/* @sem ObjectFilter::[$subtype, ...$graveyard_subtype_tail] */
graveyard_subtype_more ::= subtype "," graveyard_subtype_tail

/* Target card groups in the event player's graveyard retain that player's identity. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo($number), filter:InZone(Players{zone:Graveyard, players:One(EventSubject)})})) */
graveyard_event_up_to_cards ::= "up" "to" number "target" "cards" "from" "that" "player's" "graveyard"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo($number), filter:@and($noun, ObjectFilter::InZone(Players{zone:Graveyard, players:One(EventSubject)}))})) */
graveyard_event_up_to_typed_cards ::= "up" "to" number "target" noun "cards" "from" "that" "player's" "graveyard"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo($number), filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})})) */
graveyard_your_up_to_cards ::= "up" "to" number "target" "cards" "from" "your" "graveyard"

/* The targeted opponent also controls the named battlefield population. */
/* @sem Recipients::Union([Players(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0})), Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun, ControlledBy(One(Target{slot:@last_slot, index:0}))])})]) */
recipients_target_opponent_and_controlled ::= "target" "opponent" "and" "each" noun "they" "control"

/* The source restriction is shared by both combat and unrestricted damage. */
/* @sem ObjectSet::$affected */
unpreventable_damage_source ::= "that" "would" "be" "dealt" "by" affected

/* @sem Ability::DamageCantBePrevented{sources:$unpreventable_damage_source, combat_only:false} */
unpreventable_damage ::= "damage" unpreventable_damage_source? "can't" "be" "prevented" "."

/* @sem Ability::DamageCantBePrevented{sources:$unpreventable_damage_source, combat_only:true} */
unpreventable_combat_damage ::= "combat" "damage" unpreventable_damage_source? "can't" "be" "prevented" "."

/* A quantified plural population, shared by conditions and events. */
/* @sem $filter_plural */
all_plural_population ::= "all" filter_plural

/* The named source and its controller remain distinct from the ability controller. */
/* @sem PlayerRef::ControllerOf(Source) */
source_named_controller ::= SELF_NAME "'s" "controller"

/* These populations retain the chosen filter and event subject separately. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ChosenFilter])} */
objects_all_of_that_type ::= "all" filter_plural "of" "that" "type"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:AnyNumber, filter:AllOf([Not(SameObject(EventSubject)), $plural, ControlledBy(One(AbilityController))])})) */
objects_any_other_event_targets_controlled ::= "any" "number" "of" "other" "target" plural "you" "control"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(InSet(Selected(@prior))), Not(SameObject($object_ref))])} */
objects_unchosen_except_reference ::= "all" "permanents" "other" "than" object_ref "that" "weren't" "chosen" "this" "way"

/* @sem ObjectRef::@qualified_object(ObjectKind::Permanent, ObjectFilter::AllOf([CardType(Creature), Attacking])) */
named_attacking_creature ::= "that" "attacking" "creature"

/* A plural population compares its characteristics with the Equipment's host. */
/* @sem ObjectFilter::Shares{property:$equipped_shared_characteristic, with:AttachedTo(Source)} */
modifier_shares_equipped_characteristic ::= "that" "share" "a" equipped_shared_characteristic "with" "equipped" "creature"

equipped_shared_characteristic ::= equipped_shared_color | equipped_shared_creature_type

/* @sem DistinctProperty::Colors */
equipped_shared_color ::= "color"

/* @sem DistinctProperty::CreatureTypes */
equipped_shared_creature_type ::= "creature" "type"

/* A card can have one filter or a conjunction of two exclusions. */
discard_card_filter ::= filter_phrase | discard_card_exclusions

/* @sem ObjectFilter::AllOf([$adjective_nontype, $adjective_nontype_2]) */
discard_card_exclusions ::= adjective_nontype "," adjective_nontype

/* A controlled population is restricted to the chosen land type. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController)), Chosen(LandType)])} */
objects_each_controlled_chosen_land_type ::= "each" filter_phrase "you" "control" "of" "that" "type"

/* The target's owner supplies the later payment actor. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$owned_entrant_filter}), index:0} */
owned_opponent_target ::= "target" owned_entrant_filter

/* The minimum is taken over the entire named battlefield population. */
/* @sem ObjectFilter::AllOf([$filter_phrase, Property{property:$stat, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, property:$stat, aggregation:Minimum}}}]) */
least_stat_battlefield ::= "the" filter_phrase "with" "the" "least" stat

/* A colored permanent spell includes every permanent card type. */
/* @sem ObjectFilter::AllOf([$adjective_color, AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)])]) */
colored_permanent_spell_filter ::= adjective_color "permanent"

/* A controlled optional target from a union, excluding a type and tokens. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo($number), filter:AllOf([AnyOf([$noun, $noun_2]), ControlledBy(One(AbilityController)), Not($noun_3), Not(Token)])}), index:0} */
optional_controlled_union_nontoken_target ::= "choose" "up" "to" number "target" noun "or" noun "you" "control" "that" "isn't" "a" noun "or" "token"

/* @sem ObjectFilter::Subtype(Blood) */
token_subtype_blood_folded ::= "blood"

/* The spell filter and owned origin remain independent. */
/* @sem ObjectFilter::AllOf([$own_zone_spell_filter, Cast{from:Players{zone:$own_cast_zone, players:One(AbilityController)}}]) */
own_zone_cast_spell_kind ::= "a" own_zone_spell_filter "spell" "you" "cast" "from" own_cast_zone

own_zone_spell_filter ::= filter_phrase | adjective_colorless

/* The optional other target excludes the current event card, retaining its
   graveyard identity independently of the destination of a later move. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@current_named_object)), $noun, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0} */
target_card_up_to_one_other_your_graveyard ::= "up" "to" "one" "other" "target" noun "card" "from" "your" "graveyard"

/* @sem Condition::VotedAs{player:Bound(0), other:AbilityController, same:true} */
voting_choice_same ::= "who" "voted" "for" "a" "choice" "you" "voted" "for"

/* @sem Condition::VotedAs{player:Bound(0), other:AbilityController, same:false} */
voting_choice_different ::= "who" "voted" "for" "a" "choice" "you" "didn't" "vote" "for"

/* Plural populations compose with the same voting predicates. */
voting_plural_population ::= voting_plural_opponents | hands_revealed_all

/* @sem PlayerSet::OpponentsOf(AbilityController) */
voting_plural_opponents ::= "opponents"

/* @sem PlayerSet::Intersection([$voting_plural_population, Matching{binding:0, condition:$voting_choice_same}]) */
voting_plural_same ::= voting_plural_population voting_choice_same

/* @sem PlayerSet::Intersection([$voting_plural_population, Matching{binding:0, condition:$voting_choice_different}]) */
voting_plural_different ::= voting_plural_population voting_choice_different

voting_plural_filtered ::= voting_plural_same | voting_plural_different

/* The choice is made during target announcement; the ordinary chooser is implicit. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:$filter_phrase}), index:0} */
target_choice_yours ::= "target" filter_phrase "of" "your" "choice"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:$filter_phrase, chooser:OneOf(OpponentsOf(AbilityController))}), index:0} */
target_choice_opponent ::= "target" filter_phrase "of" "an" "opponent's" "choice"

/* An owned nontoken target keeps ownership independent of control. */
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(Token), $noun, OwnedBy(One(AbilityController))])}), index:0}) */
owned_nontoken_target_set ::= "target" "nontoken" noun "you" "own"

/* Each side retains its own population; only the latter excludes this source. */
/* @sem ObjectFilter::AnyOf([$plural_simple, @and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $plural_simple_2)]) */
plural_and_other_population ::= plural_simple "and" "other" plural_simple

/* An announced permanent target controlled by an opponent. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$adjective_nontype, ControlledBy(OpponentsOf(AbilityController))])}), index:0} */
target_opponents_qualified_permanent ::= "target" adjective_nontype "permanent" "an" "opponent" "controls"

/* The color note belongs to the named drafted card, not the target count. */
/* @sem ObjectFilter::DraftNoted(_{kind:Color, player:AbilityController, card:@card_name}) */
modifier_draft_chosen_colors ::= "that's" "one" "or" "more" "of" "the" "colors" "chosen" "as" "you" "drafted" "cards" "named" SELF_NAME

/* A single card selected by its graveyard arrival this turn. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ArrivedThisTurn{from:Battlefield}])}), index:0} */
target_card_arrived_from_battlefield ::= "target" noun "card" "in" "a" "graveyard" "that" "was" "put" "there" "from" "the" "battlefield" "this" "turn"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:AllOf([$card_filter, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0} */
target_optional_card_own_graveyard ::= "up" "to" "one" "target" card_filter "card" "from" "your" "graveyard"

/* Each qualifying opponent contributes at most one card target. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:AnyNumber, filter:AllOf([$card_filter, OwnedBy(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:CountCounters(_{recipients:Players(One(Bound(0))), kind:Named(PoisonCounter), information:CurrentOrLastKnown}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}}]))]), constraints:[DifferentOwners]})) */
opponents_poison_graveyard_targets ::= "for" "each" "opponent" "who" "has" number "or" "more" "poison" "counters" "as" "you" "cast" "this" "spell" "," "put" "up" "to" "one" "target" card_filter "card" "from" "that" "player's" "graveyard"

/* @sem ObjectSet::Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AnyOf([$subtype, Subtype(Vehicle)])}) */
return_subtype_union_population ::= "all" subtype "and" "Vehicle" "cards" "from" "your" "graveyard"

/* A reusable hand-size threshold retains the count as its semantic operand. */
/* @sem $card_count */
hand_card_threshold ::= card_count "in" "hand"

/* A target linked to the named source remains in exile for this action. */
/* @sem ObjectSet::InZone{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Exile]}), count:Exactly(Constant(1)), filter:InSet(Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($self_explicit_ref)}))}), index:0}), zone:Exile} */
target_linked_exiled_card_set ::= "target" "card" "exiled" "with" self_explicit_ref

/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Expr::Constant(1)), filter:Any, chooser:ControllerOf(EventSubject)})) */
entry_controller_damage_target ::= "any" "target" "of" "their" "choice"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($noun_creature, ObjectFilter::InZone(Players{zone:Graveyard, players:OpponentsOf(AbilityController)}))}), index:0} */
opponent_creature_card ::= "target" noun_creature "card" "from" "an" "opponent's" "graveyard"

/* Sentence-initial Elemental is folded by the lexical vocabulary. */
/* @sem ObjectFilter::Subtype(Elemental) */
noun_elemental_folded ::= "elemental"

/* A self-linked exile population preserves the link and ownership separately. */
/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($self_ref_named)} */
permission_self_linked_single ::= "a" "card" "exiled" "with" self_ref_named

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(One(AbilityController)), ExiledWith($self_ref_named)])} */
permission_self_owned_linked ::= "cards" "you" "own" "exiled" "with" self_ref_named

/* The property cap constrains the announced group, not each target. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:AnyNumber, filter:$plural_and_or, constraints:[$target_total_budget]})) */
objects_target_total_budget ::= "any" "number" "of" "target" plural_and_or target_total_budget

/* @sem SelectionConstraint::TotalProperty{property:$stat, comparison:LessOrEqual, amount:$target_budget_amount} */
target_total_budget ::= "with" "total" stat target_budget_amount "or" "less"

target_budget_amount ::= number

/* A card in a graveyard may be the object enchanted by an Aura. */
/* @sem ObjectRef::@enchanted_operand(ObjectRef::AttachedTo(Source)) */
enchanted_card_ref ::= "the" "enchanted" "card"

/* The article is presentation; the selected population carries the filter. */
selected_keyword_filter ::= tap_event_singular_a | selected_keyword_filter_an

/* @sem ObjectFilter::$filter_phrase */
selected_keyword_filter_an ::= "an" filter_phrase

/* The explicitly referenced object and named controlled population form one choice pool. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($object_ref), AllOf([$filter_phrase, ControlledBy(One(AbilityController)), Name($referenced_card_name)])])} */
choice_ref_or_controlled_named ::= object_ref "or" "a" filter_phrase "you" "control" "named" referenced_card_name

/* @sem ObjectSet::Earlier{what:It} */
sticker_mentioned ::= "that" "sticker"

/* The top of the source-linked exile pile retains its exile-zone constraint. */
/* @sem ObjectSet::InZone{objects:One(AtEnd{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}), end:Top}), zone:Exile} */
linked_exiled_pile_top ::= "the" "top" "card" "of" "the" "exiled" "pile"

/* @sem ObjectSet::InZone{objects:One(AtEnd{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}), end:Bottom}), zone:Exile} */
linked_exiled_pile_bottom ::= "the" "bottom" "card" "of" "the" "exiled" "pile"

linked_exiled_pile_card ::= linked_exiled_pile_top | linked_exiled_pile_bottom

/* Predicates following the plural copula retain their own filter semantics. */
controlled_permanent_predicate ::= permanent_one_or_more_colors | quality_unscoped | filter_plural

/* @sem ObjectFilter::Not(ObjectFilter::Colorless) */
permanent_one_or_more_colors ::= "one" "or" "more" "colors"

/* Ownership is part of the target selection, independent of control. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:@and($filter_nonlist_head, $modifier_you_own)}), index:0} */
owned_battlefield_target ::= "target" filter_nonlist_head modifier_you_own

/* This filter is used only inside an activation whose second cost is a
   single sacrificed creature; the receipt is the input to that cost. */
/* @sem ObjectFilter::AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:ObjectProperty{object:Query{objects:CostObjects{payment:Activation, component:[1], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}]) */
filter_same_mana_as_activation_sacrifice ::= filter_phrase "with" "the" "same" "mana" "value" "as" "the" "sacrificed" "creature"

/* These receipt filters are reachable only through their producer-bound roots. */
/* @sem ObjectFilter::AllOf([$filter_phrase, Not(SameObject(Query{objects:CostObjects{payment:Activation, component:[0], view:Inputs, phase:Before}, index:0}))]) */
filter_other_than_tapped_activation_creature ::= filter_phrase "other" "than" "the" "creature" "tapped" "this" "way"

/* @sem ObjectFilter::AllOf([$filter_plural, Shares{property:CreatureTypes, with:Query{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Inputs, phase:Before}, index:0}}]) */
filter_shared_type_cast_sacrifice ::= filter_plural "that" "share" "a" "creature" "type" "with" "the" "sacrificed" "creature"

/* A random selection constraint belongs to the target declaration. */
/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Expr::Constant(1)), filter:Any, constraints:[AtRandom]})) */
recipients_random_damage_target ::= "any" "target" "chosen" "at" "random"

/* Object and player candidates each retain their own damage-history subject. */
/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Expr::Constant(1)), filter:Condition(Compare{left:EventHistory{event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject(Candidate)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}), players:Matching{binding:0, condition:Compare{left:EventHistory{event:Damage(_{source_kind:Any, sources:Any, recipients:Players(One(Bound(0))), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}})) */
recipients_previously_damaged_target ::= "any" "target" "that" "was" "dealt" "damage" "this" "turn"

/* The selected targets must share a creature type chosen by the controller. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:$plural_target_count, filter:$filter_plural, constraints:[CommonProperty(CreatureTypes)]})) */
objects_targets_common_creature_type ::= plural_target_count "target" filter_plural "of" "the" "creature" "type" "of" "your" "choice"

/* A plural card population can carry the previously chosen creature type. */
return_population_cards ::= return_population_plain | return_population_chosen_type | return_population_same_name

/* @prefer always */
/* @sem ObjectFilter::$card_filter */
return_population_plain ::= card_filter "cards"

/* @sem ObjectFilter::AllOf([$filter_phrase, Chosen(CreatureType)]) */
return_population_chosen_type ::= filter_phrase "cards" "of" "a" "type" "chosen" "this" "way"

/* Each member of this union explicitly belongs to the ability controller. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([$owned_controlled_population_filter, $owned_attached_population_filter, $owned_attached_population_filter_2])} */
owned_battlefield_union ::= owned_controlled_population_filter "," owned_attached_population_filter "," "and" owned_attached_population_filter

/* @sem ObjectFilter::AllOf([$filter_plural, OwnedBy(One(AbilityController)), ControlledBy(One(AbilityController))]) */
owned_controlled_population_filter ::= "all" filter_plural "you" "both" "own" "and" "control"

/* @sem ObjectFilter::AllOf([$filter_plural, OwnedBy(One(AbilityController)), AttachedTo(InSet($affected))]) */
owned_attached_population_filter ::= "all" filter_plural "you" "own" "attached" "to" affected

/* A union whose second card type excludes a subtype. */
/* @sem ObjectFilter::AnyOf([$noun, AllOf([Not(Subtype(Aura)), $noun_2])]) */
card_type_or_non_aura_type ::= noun "and" "/" "or" "non-Aura" noun

/* One optional graveyard target with three alternatives and a bounded property. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:@and(ObjectFilter::AnyOf([$noun, $noun_2, AllOf([Not(Subtype(Aura)), $noun_3])]), $return_mana_bound, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0} */
target_up_to_one_three_kind_qualified_graveyard ::= "up" "to" "one" "target" noun "," noun "," "or" "non-Aura" noun "card" return_mana_bound "from" "your" "graveyard"

/* A controller-qualified population with a comparison of its members. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy($players_singular), $modifier_stat_compared])} */
return_owner_population ::= "each" filter_phrase players_singular "controls" modifier_stat_compared

/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Expr::Constant(1)), filter:CardType(Battle), players:OpponentsOf(PlayerRef::AbilityController)})) */
recipients_opponent_or_battle ::= "target" "opponent" "or" "battle"

/* The lexical form also occurs as a lower-case word. */
/* @sem ObjectFilter::Subtype(Goblin) */
plural_goblins_lower ::= "goblins"

/* Both combat relations share the same referenced object and turn window. */
/* @sem ObjectFilter::AnyOf([Condition(Compare{left:EventHistory{event:Pair{event:Blocks, objects:SameObject(Candidate), others:SameObject($object_ref)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}), Condition(Compare{left:EventHistory{event:Pair{event:BecomesBlockedBy, objects:SameObject(Candidate), others:SameObject($object_ref)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})]) */
modifier_blocked_or_were_blocked_by_turn ::= "that" "blocked" "or" "were" "blocked" "by" object_ref "this" "turn"

/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Expr::Constant(1)), filter:Not($subtype)})) */
recipients_any_target_not_subtype ::= "any" "target" "that" "isn't" "a" subtype

/* A persistent chosen player can receive any shared damage or other effect. */
/* @sem Recipients::Players($players_chosen_shared) */
recipients_chosen_player ::= players_chosen_shared

/* A printed stat pair supplies independent power and toughness tests. */
/* @sem ObjectFilter::AllOf([Property{property:Power, test:NumberTest::Compare{comparison:Equal, value:$number_digits}}, Property{property:Toughness, test:NumberTest::Compare{comparison:Equal, value:$number_digits_2}}]) */
filter_stated_stat_pair ::= number_digits "/" number_digits

/* @sem @and($filter_stated_stat_pair, $filter_plain) */
filter_stated_stats ::= filter_stated_stat_pair filter_plain

/* A permanent qualified by an activated ability whose cost contains the tap symbol. */
/* @sem ObjectFilter::AllOf([$filter_plain, $qualifier_tap_cost_ability]) */
filter_with_tap_cost_ability ::= filter_plain qualifier_tap_cost_ability

/* @sem ObjectFilter::AllOf([HasActivatedAbility(Any), HasActivatedAbility(Is(TapSymbolInCost))]) */
qualifier_tap_cost_ability ::= "that" "has" "an" "activated" "ability" "with" "{" "T" "}" "in" "its" "cost"

/* @prefer always */
/* @sem ObjectFilter::HasKeywordFamily(Disturb) */
modifier_with_disturb ::= "with" "disturb"

/* @sem ObjectFilter::HasKeywordFamily(Decayed) */
modifier_with_decayed ::= "with" "decayed"

/* The owner is that of the card named by the current event. */
/* @sem PlayerRef::OwnerOf(EventSubject) */
event_subject_card_owner ::= "that" "card's" "owner"

/* @prefer always */
/* @sem PlayerSet::One(PlayerRef::PlayerOrControllerOf(Targets(@last_slot))) */
players_or_controller_planeswalker ::= "that" "player" "or" "that" "planeswalker's" "controller"

/* @sem PlayerSet::One(PlayerRef::PlayerOrControllerOf(Targets(@last_slot))) */
players_or_controller_permanent ::= "that" "permanent's" "controller" "or" "that" "player"

/* A targeted player distinct from the source artifact owner. */
/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Expr::Constant(1)), filter:Any, players:OthersThan(OwnerOf(Source))}), index:0} */
target_player_other_than_source_owner ::= "target" "player" "other" "than" "this" "artifact's" "owner"

/* A random singular library card, bounded by its current mana value. */
/* @sem ObjectSet::@selection(SelectionStep::_{binding:0, objects:Zone{scope:Players{zone:Library, players:One($target_possessive)}, kind:Card, filter:AllOf([$random_card_kind, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}])}, chooser:Chance, count:AsManyAsCan(Expr::Constant(1))}) */
objects_random_library_mana_ceiling ::= "a" "random" random_card_kind "card" "with" "mana" "value" number "or" "less" "from" target_possessive "library"

/* A singular target for each opponent, qualified independently by its counter. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:OpponentsOf(AbilityController), each:UpTo(Constant(1))}, filter:AllOf([CardType(Creature), Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})])})) */
opponent_counter_creature_targets ::= "choose" "up" "to" "one" "target" "creature" "they" "control" "with" "a" counter_kind "counter" "on" "it"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:OpponentsOf(AbilityController), each:UpTo($number)}, filter:$adjective_nontype})) */
opponent_named_permanent_targets ::= "up" "to" number "target" adjective_nontype "permanent" "that" "opponent" "controls"

/* A limited alternative payment selects the singular spell independently of its cost. */
limited_cast_spell ::= exile_cast_spell | foreign_owned_bounded_cast_spell

/* @sem ObjectFilter::AllOf([OwnedBy(OthersThan(AbilityController)), $modifier_mana_value_bound]) */
foreign_owned_bounded_cast_spell ::= "a" "spell" "you" "cast" "that" "you" "don't" "own" modifier_mana_value_bound

/* A target ceiling defined by letters on name stickers of the named object. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo($sticker_letter_count), filter:$filter_plural})) */
objects_up_to_sticker_letters ::= "up" "to" "X" "target" filter_plural "," "where" "X" "is" sticker_letter_count

/* @sem Expr::Stickers{objects:One($object_ref), measure:Letter(Term{family:Letter, form:SingleLetter, operands:[$sticker_count_letter]})} */
sticker_letter_count ::= "the" "number" "of" sticker_count_letter "in" "name" "stickers" "on" object_ref

sticker_count_letter ::= sticker_letter_u | sticker_letter_a | sticker_letter_o

/* @sem Operand::Text(U) */
sticker_letter_u ::= "u's"

/* @sem Operand::Text(A) */
sticker_letter_a ::= "a's"

/* A protection quality takes the colors of the current affected population. */
/* @sem ObjectFilter::SharesColorWithAny($affected) */
protection_colors_among ::= "each" "color" "among" affected

/* Only enclosing amass producer/consumer productions may use this receipt. */
/* @sem Expr::ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:$creature_stat, information:CurrentOrLastKnown} */
amassed_army_property ::= "the" "amassed" "Army's" creature_stat

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($filter_phrase, ObjectFilter::Property{property:$creature_stat, test:NumberTest::Compare{comparison:$stat_comparison, value:$amassed_army_property}})}), index:0} */
amass_compared_target ::= "target" filter_phrase "with" creature_stat stat_comparison amassed_army_property

/* A counted group of blocked targets, reusable by plural effects. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly($blocked_target_count), filter:AllOf([State(Blocked), $plural])})) */
blocked_target_group ::= blocked_target_count "target" "blocked" plural

blocked_target_count ::= blocked_target_x | count_plural

/* @sem Expr::AnnouncedX */
blocked_target_x ::= "x"

/* An attacking creature, with an optional explicit color, remains a creature
   for the later singular anaphor. */
retirement_attacking_creature_filter ::= retirement_attacking_creature_plain | retirement_attacking_creature_color

/* @sem ObjectFilter::@and($adjective_attacking, $noun_creature) */
retirement_attacking_creature_plain ::= adjective_attacking noun_creature

/* @sem ObjectFilter::@and($adjective_attacking, @and($adjective_color, $noun_creature)) */
retirement_attacking_creature_color ::= adjective_attacking adjective_color noun_creature

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(Expr::Constant(1)), filter:$retirement_attacking_creature_filter}), index:0} */
retirement_optional_attacker ::= "up" "to" "one" "target" retirement_attacking_creature_filter

retirement_choice_creature_filter ::= noun_creature | retirement_colored_creature

/* @sem ObjectFilter::@and($adjective_color, $noun_creature) */
retirement_colored_creature ::= adjective_color noun_creature

/* The defending player of the attacking event subject chooses the target. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:$filter_phrase, chooser:DefendingPlayerOf(EventSubject)}), index:0} */
target_defending_player_choice ::= "target" filter_phrase "of" "defending" "player's" "choice"

/* This target is used only within a source-attacks trigger. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:$filter_phrase, chooser:DefendingPlayerOf(Source)}), index:0} */
target_source_defender_choice ::= "target" filter_phrase "of" "defending" "player's" "choice"

/* The ordinary lowercase token also denotes the Rat subtype in plural nouns. */
/* @sem ObjectFilter::Subtype(Rat) */
plural_folded_rat ::= "rats"

/* @sem ObjectFilter::Subtype(Goblin) */
plural_folded_goblin ::= "goblins"

/* Each member independently records damage from this ability's source. */
/* @sem Recipients::Union([Players(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:SameObject(@self), recipients:Players(One(Bound(0))), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisGame, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}])), Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun, Condition(Compare{left:EventHistory{event:Damage(_{source_kind:Permanent, sources:SameObject(@self), recipients:Objects(SameObject(Candidate)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisGame, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})])})]) */
previously_damaged_opponent_and_permanent ::= "each" "opponent" "and" noun "it" "has" "dealt" "damage" "to" "this" "game"

filter_singular_outer_adjectives ::= filter_outer_adjectives | adjective_unblocked

/* An unblocked state composes with the same noun heads as other qualities. */
/* @sem ObjectFilter::State(Unblocked) */
adjective_unblocked ::= "unblocked"

/* Both independent restrictions apply to the same object. */
/* @sem ObjectFilter::AllOf([OwnedBy(OthersThan(AbilityController)), ControlledBy(OthersThan(AbilityController))]) */
modifier_neither_own_nor_control ::= "you" "neither" "own" "nor" "control"

/* This is the live owned exile population, not an exile-action receipt. */
/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_phrase, OwnedBy(One(AbilityController)), Counters{kind:$counter_kind, comparison:Greater, value:Constant(0)}])} */
owned_exile_card_with_counter ::= filter_phrase "card" "you" "own" "in" "exile" "with" "a" counter_kind "counter" "on" "it"

/* The defender belongs to the event subject, not the ability controller. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(Expr::Constant(1)), filter:AllOf([$filter_phrase, ControlledBy(One(DefendingPlayerOf(EventSubject)))] )}), index:0} */
target_up_to_one_defending_controlled ::= "up" "to" "one" "target" filter_phrase "defending" "player" "controls"

/* A bound player's controlled battlefield population, in singular and plural contexts. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))])} */
bound_controlled_population_singular ::= "the" filter_phrase "they" "control"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])} */
bound_controlled_population_tied ::= "if" "two" "or" "more" filter_plural "a" "player" "controls" "are" "tied" "for" "greatest"

/* Ownership and control are independent alternatives over the modified noun. */
/* @sem ObjectFilter::AnyOf([OwnedBy(One(AbilityController)), ControlledBy(One(AbilityController))]) */
modifier_you_own_or_control ::= "you" "own" "or" "control"

/* The initial and final pronouns denote the same previously mentioned object. */
/* @sem ObjectFilter::AnyOf([SameObject(@it), $other_plural_sharing_type]) */
referenced_and_other_sharing_type ::= "it" "and" "other" other_plural_sharing_type

/* @sem @and($filter_plural_tail, $plural_shares_type_with_it) */
other_plural_sharing_type ::= filter_plural_tail plural_shares_type_with_it

/* @sem ObjectFilter::Shares{property:CreatureTypes, with:@it} */
plural_shares_type_with_it ::= "that" "share" "a" "creature" "type" "with" "it"

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Damage(DamageEvent{source_kind:Permanent, sources:SameObject(Candidate), recipients:Objects(SameObject($object_ref)), kind:Any, grouping:SourceRecipient, subject:Source}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
modifier_dealt_damage_to_object_this_turn ::= "that" "dealt" "damage" "to" object_ref "this" "turn"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($object_ref), SameObject($object_ref_2)])} */
object_ref_pair ::= object_ref "and" object_ref

/* Four source types share the ordinary ability-source filter. */
/* @sem $noun_or_four */
counter_source_four_nouns ::= "an" noun_or_four

/* @sem ObjectFilter::AnyOf([$noun, $noun_2, $noun_3, $noun_4]) */
noun_or_four ::= noun "," noun "," noun "," "or" noun

/* A list of permanent types qualifies the source of the targeted ability. */
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Ability, zones:[Stack]}), count:Exactly(Constant(1)), filter:AllOf([$counter_ability_kind, AbilityOf($counter_source_four_nouns)])}), index:0}) */
counter_one_ability_four_sources ::= "target" counter_ability_kind "ability" "from" counter_source_four_nouns

/* A battlefield population compared with the singleton revealed casting payment. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Property{property:$stat, test:NumberTest::Compare{comparison:$stat_comparison, value:$casting_single_payment_property}}])} */
casting_revealed_compared_population ::= "each" filter_phrase "with" stat stat_comparison "the" "revealed" "card's" casting_single_payment_property

/* @sem DistinctProperty::CardTypes */
discarded_distinct_card_type ::= "card" "type"

discarded_distinct_property ::= discarded_distinct_card_type | equipped_shared_color

/* Shared color qualification applies to both alternative permanent kinds. */
/* @sem ObjectFilter::AllOf([AnyOf([$noun, $noun_2]), AnyOf([$adjective_color, $adjective_color_2])]) */
filter_two_heads_two_colors ::= noun "or" noun "that's" adjective_color "or" adjective_color

/* A battlefield population filtered by its own crew event and the crewed object. */
/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Pair{event:Crews, objects:SameObject(Candidate), others:SameObject($object_ref)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
filter_that_crewed_this_turn ::= "that" "crewed" object_ref "this" "turn"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, $filter_that_crewed_this_turn])} */
objects_each_that_crewed_this_turn ::= "each" filter_phrase filter_that_crewed_this_turn

/* Singular relative wording preserves the disjunction on the described object. */
/* @sem ObjectFilter::AnyOf([State(Enchanted), State(Equipped)]) */
modifier_singular_enchanted_or_equipped ::= "that's" "enchanted" "or" "equipped"

/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:CardType(Planeswalker), players:All})) */
recipients_player_or_walker_required ::= "target" "player" "or" "planeswalker"

/* A four-way card filter composes with graveyard arrival origins. */
/* @sem ObjectFilter::AnyOf([$filter_phrase, ...$filter_three_and_members]) */
filter_four_and_heads ::= filter_phrase "," filter_three_and_members

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:@and($filter_four_and_heads, $graveyard_arrival_origin)} */
bound_graveyard_arrivals ::= "all" filter_four_and_heads "cards" "in" "their" "graveyard" graveyard_arrival_origin

/* Targets in a single graveyard share an owner, independently of the controller. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo($number), filter:$filter_phrase, constraints:[CommonProperty(Owners)]})) */
single_graveyard_target_cards ::= "up" "to" number "target" filter_phrase "cards" "from" "a" "single" "graveyard"

/* This relative clause records an occurrence during the whole turn. */
/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Object{event:BecomesBlocked, objects:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
modifier_became_blocked_this_turn ::= "that" "blocked" "this" "turn"

/* Exile populations preserve the linked source and the owner independently. */
/* @sem ObjectRef::$object_ref */
linked_exile_card_source ::= "cards" "exiled" "with" object_ref

/* The previously announced target group, restricted by its stated type and keyword. */
/* @sem Recipients::Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([InSet(Targets(0)), $filter_plural, HasKeyword($keyword_value)])}) */
recipients_target_group_with_keyword ::= "each" "of" "those" filter_plural "with" keyword_value

/* A battlefield population excluding each of four independently specified keywords. */
/* @sem Recipients::Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ...$excluded_keywords])}) */
recipients_each_without_keywords ::= "each" filter_phrase "that" "doesn't" "have" excluded_keywords

/* @sem ObjectFilter::[Not(HasKeyword($keyword_value)), ...$excluded_keywords_tail] */
excluded_keywords ::= keyword_value "," excluded_keywords_tail

excluded_keywords_tail ::= excluded_keywords_last_pair | excluded_keywords
/* @sem ObjectFilter::[Not(HasKeyword($keyword_value)), Not(HasKeyword($keyword_value_2))] */
excluded_keywords_last_pair ::= keyword_value "," "or" keyword_value

/* A color choice qualifies the complete union of permanent kinds. */
/* @sem ObjectFilter::AllOf([$noun_either, AnyOf([$adjective_color, $adjective_color_2])]) */
filter_either_kind_either_color ::= noun_either "that's" adjective_color "or" adjective_color

/* @sem ObjectFilter::BlockedByObject($self_explicit_ref) */
combat_blocked_by_self ::= "blocked" "by" self_explicit_ref

/* @sem ObjectFilter::AllOf([$filter_plural_tail, ControlledBy(One(AbilityController)), AnyOf([$adjective_color, $adjective_color_2, $adjective_color_3])]) */
plural_controlled_three_colors ::= filter_plural_tail "you" "control" "that" "are" adjective_color "," adjective_color "," "and" "/" "or" adjective_color

/* Selection is scoped to the enclosing for-each-opponent clause. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:OpponentsOf(AbilityController), each:UpTo($number)}, filter:$noun})) */
each_opponents_named_targets ::= "up" "to" number "target" noun "that" "player" "controls"

/* A previously mentioned permanent and a separately targeted permanent. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($it_ref), SameObject($target_object)])} */
objects_it_and_target ::= it_ref "and" target_object

/* A bracketed pair denotes either of the two stated subtypes. */
/* @sem ObjectFilter::AnyOf([$subtype, $subtype_2]) */
cleave_subtype_pair ::= subtype "or" subtype

/* Other cards exclude the current named object, including its event incarnation. */
/* @sem ObjectFilter::AllOf([Not(SameObject(@current_named_object)), $filter_phrase]) */
other_graveyard_card_filter ::= "other" filter_phrase "cards"

/* A qualified card target retains the opponent-owned graveyard and the
   independently expressed card and property filters. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and($card_filter, $graveyard_card_modifiers, ObjectFilter::InZone(Players{zone:Graveyard, players:OpponentsOf(PlayerRef::AbilityController)}))}), index:0} */
target_card_opponent_graveyard_with ::= "target" card_filter "card" graveyard_card_modifiers "from" "an" "opponent's" "graveyard"

/* The targeted land must be controlled by the ability controller. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Land), ControlledBy(One(AbilityController))])}), index:0} */
controlled_land_target ::= "target" "land" "you" "control"

/* The comparison follows the triggering object's last-known toughness. */
/* @sem ObjectFilter::Property{property:Toughness, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:EventSubject, property:Toughness, information:CurrentOrLastKnown}}} */
lesser_event_toughness ::= "with" "lesser" "toughness"

/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo($n1), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@current_named_object)), $noun, $lesser_event_toughness, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0}) */
lesser_event_toughness_graveyard_population ::= "up" "to" n1 "other" "target" noun "card" lesser_event_toughness "from" "your" "graveyard"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo($count_plural), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@current_named_object)), $noun, $lesser_event_toughness, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))})) */
lesser_event_toughness_graveyard_population_plural ::= "up" "to" count_plural "other" "target" noun "cards" lesser_event_toughness "from" "your" "graveyard"

/* A card type and a mana-value constraint both apply to the announced target. */
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$library_graveyard_card_a_type, $modifier_mana_value_numeric])}), index:0}) */
bounded_graveyard_card_target ::= "target" library_graveyard_card_a_type "card" modifier_mana_value_numeric "from" "a" "graveyard"

/* Three independent printed names qualify the same plural population. */
/* @sem ObjectFilter::AllOf([$plural_head, AnyOf(@unordered([Name($referenced_card_name), Name($referenced_card_name_2), Name($referenced_card_name_3)]))]) */
plural_named_three ::= plural_head "named" referenced_card_name "," referenced_card_name "," "and" referenced_card_name

/* A union of card types and its arrival history are independent filters. */
/* @sem ObjectFilter::AnyOf([$noun, $noun_2]) */
graveyard_card_type_union ::= noun "or" noun

/* @sem ObjectFilter::Not(History{event:PutIntoGraveyard, window:ThisCombat}) */
graveyard_not_put_this_combat ::= "that" "wasn't" "put" "there" "this" "combat"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:AllOf([$graveyard_card_type_union, InZone(Players{zone:Graveyard, players:One(AbilityController)}), $graveyard_not_put_this_combat])}), index:0} */
target_card_combat_history_your_graveyard ::= "target" graveyard_card_type_union "card" "in" "your" "graveyard" graveyard_not_put_this_combat

/* A population restricted to objects attached to the referenced host. */
/* @sem ObjectSet::Matching{objects:$affected, filter:AttachedTo(SameObject($object_ref))} */
population_from_object ::= affected "from" object_ref

/* Cards selected by their arrival in any graveyard during this turn. */
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:AllOf([$filter_phrase, ArrivedThisTurn{from:Battlefield}])} */
graveyard_cards_arrived_battlefield_this_turn ::= "all" filter_phrase "cards" "in" "all" "graveyards" "that" "were" "put" "there" "from" "the" "battlefield" "this" "turn"

/* One announced graveyard target anchors both name-matching populations. */
/* @sem ObjectSet::Union([One($same_name_graveyard_target), Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:SharesNameWith($same_name_graveyard_target)}, Zone{scope:Shared(Battlefield), kind:Permanent, filter:SharesNameWith($same_name_graveyard_target)}]) */
same_name_graveyard_battlefield_population ::= same_name_graveyard_target "," "all" "other" "cards" "from" "graveyards" "with" "the" "same" "name" "as" "that" "card" "," "and" "all" "permanents" "with" "that" "name"

same_name_graveyard_target ::= target_card_a_graveyard | target_any_card_a_graveyard

/* Each population and its bound retains its own current operands. */
/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$distribution_counter_count}} */
counter_bounded_mana_value ::= "with" "mana" "value" "less" "than" "or" "equal" "to" distribution_counter_count

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, $counter_bounded_mana_value])} */
bounded_battlefield_population ::= "all" filter_plural counter_bounded_mana_value

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:AllOf([$filter_phrase, $counter_bounded_mana_value])} */
bounded_graveyard_population ::= "all" filter_phrase "cards" "in" "graveyards" counter_bounded_mana_value

/* @sem ObjectSet::Union([$affected, $bounded_battlefield_population, $bounded_graveyard_population]) */
bounded_source_and_populations ::= affected "," bounded_battlefield_population "," "and" bounded_graveyard_population

/* @sem ObjectFilter::Chosen(CardType) */
revealed_count_chosen_type ::= "card" "of" "the" "chosen" "type"

/* @sem ObjectFilter::Chosen(CardName) */
revealed_count_chosen_name ::= "card" "with" "the" "chosen" "name"

/* An announced, arbitrary-size group of graveyard cards of either named type. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:AnyNumber, filter:AnyOf([$noun, $noun_2])})) */
chosen_graveyard_group ::= "choose" "any" "number" "of" "target" noun "and" "/" "or" noun "cards" "in" "graveyards"

owned_filtered_cards ::= owned_negated_spell_cards | owned_two_filtered_cards | owned_named_self_cards

/* The most recent selection supplies the objects. */
/* @sem ObjectSet::Selected(@prior) */
chosen_permanents_selection ::= "each" "permanent" "chosen" "this" "way"

/* The comparison ranges over precisely the same filtered graveyard as the selection. */
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, Property{property:Power, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, property:Power, aggregation:Maximum}}}])} */
greatest_owned_graveyard_card_tied_power ::= "the" filter_phrase "card" "in" "your" "graveyard" "with" "the" "greatest" "power" "." "if" "two" "or" "more" "cards" "are" "tied" "for" "greatest" "power" "," "you" "choose" "one" "of" "them"

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, Property{property:Toughness, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, property:Toughness, aggregation:Maximum}}}])} */
greatest_owned_graveyard_card_tied_toughness ::= "the" filter_phrase "card" "in" "your" "graveyard" "with" "the" "greatest" "toughness" "." "if" "two" "or" "more" "cards" "are" "tied" "for" "greatest" "toughness" "," "you" "choose" "one" "of" "them"

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, Property{property:$creature_stat, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, property:$creature_stat, aggregation:Maximum}}}])} */
greatest_owned_graveyard_card ::= "the" filter_phrase "card" "in" "your" "graveyard" "with" "the" "greatest" creature_stat

/* The chosen object belongs to the current player loop, not the ability holder. */
/* @sem ObjectFilter::AllOf([Not(SameObject(Earlier{what:Selected, by:Bound(0)})), $filter_plural, Not(Shares{property:CreatureTypes, with:Earlier{what:Selected, by:Bound(0)}})]) */
other_unshared_chosen_population ::= "other" filter_plural "they" "control" "that" "don't" "share" "a" "creature" "type" "with" "the" "chosen" "creature" "they" "control"

/* Survivor is also a lowercase keyword token in this vocabulary. */
/* @sem ObjectFilter::Subtype(Survivor) */
plural_survivors_word ::= "survivors"

/* The X definition belongs to the announced target count. */
/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:UpTo($value_times_kicked), filter:Any})) */
recipients_defined_up_to_targets ::= "each" "of" "up" "to" "X" "targets" "," "where" "X" "is" value_times_kicked

/* @sem ObjectFilter::ControlledBy(One(Holder(Monarch))) */
modifier_monarch_controls ::= "the" "monarch" "controls"

/* @sem ObjectFilter::AllOf([$nameless_plural_base, State(Nameless)]) */
filter_plural_nameless ::= nameless_plural_base "that" "don't" "have" "a" "name"

nameless_plural_base ::= filter_plural_tail | filter_plural_type_prefix

/* The target's mana value is compared with the triggering object's last known value. */
/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}} */
lesser_event_mana_value ::= "with" "lesser" "mana" "value"

/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($filter_phrase, $lesser_event_mana_value, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0}) */
target_lesser_event_graveyard_card ::= "target" filter_phrase "card" lesser_event_mana_value "from" "your" "graveyard"

/* The exclusion and controller qualify both arms of the target union. */
/* @sem ObjectFilter::AllOf([Not(SameObject(Source)), $plural_and_or, ControlledBy(One(AbilityController))]) */
controlled_other_union ::= plural_and_or "you" "control"

/* The named creature remains the announced target for later references. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), index:0} */
copy_chosen_creature ::= "target" "creature" "you" "control"

/* One target per player, with no two controlled by the same player. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(CountPlayers(All)), filter:AllOf([$noun, ControlledBy(All)]), constraints:[DifferentControllers]})) */
each_player_distinct_controlled_target ::= "target" noun "that" "player" "controls"

/* The ownership test refers to the surrounding per-player binding. */
/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([InSet($exile_linked_population), OwnedBy(One(Bound(0)))])}) */
bound_owned_linked_cards ::= "all" "cards" "they" "own" exile_linked_population

/* X bounds both the number of targets and the distributed counter total. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(CastX(EventSubject)), filter:AllOf([Not(SameObject(Source)), $plural, ControlledBy(One(AbilityController))]), distribute:CastX(EventSubject)})) */
event_x_distribution_targets ::= "any" "number" "of" "other" "target" plural "you" "control"

/* The bound controller is the target permanent's controller, independent of the ability controller. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ControlledBy(Matching{binding:0, condition:Controls{player:Bound(0), filter:$controlled_basic_land, minimum:1}})])}), index:0} */
target_controller_controls_land ::= "target" noun "whose" "controller" "controls" controlled_basic_land

