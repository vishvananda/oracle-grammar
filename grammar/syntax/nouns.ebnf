modifier_mana_value_pair ::= "with" "mana" "value" number "or" number

/* Exclude the object currently enchanted by this Aura. */
/* @sem ObjectFilter::Not(SameObject($enchanted_creature_ref)) */
modifier_other_than_enchanted ::= "other" "than" enchanted_creature_ref

/* The lexical word Zombie also folds to the ordinary word token. */
/* @sem ObjectFilter::Subtype(Zombie) */
noun_zombie_folded ::= "zombie"

/* A comma-separated population remains a union regardless of its length. */
/* @sem ObjectFilter::AnyOf([...$plural_subtype_commas, $plural_subtype_word]) */
plural_subtype_list ::= plural_subtype_commas "and" plural_subtype_word

