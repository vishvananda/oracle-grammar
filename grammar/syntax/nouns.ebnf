counter_ability_triggered ::= "triggered"

counter_spell_quality ::= adjective_colorless | adjective_nontype

/* A plural selection from one graveyard ranges over all owners; its enclosing
   payment must enforce that the selected cards share an owner. */
/* @sem CostObjectSelection::CostObjectSelection{objects:Matching{objects:Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$filter_phrase}), filter:OwnedBy(All)}, choose:Exactly($count_plural)} */
single_graveyard_card_selection ::= count_plural filter_phrase "cards" "from" "a" "single" "graveyard"

/* The later creature anaphor must refer to this exact target. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:CardType(Creature)}), index:0} */
excess_damage_creature_target ::= "target" "creature"

/* @sem PlayerRef::Active */
active_player_ref ::= "the" "active" "player"

/* A single-target spell constrained by the kind of permanent it targets. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:AllOf([OnStack(SingleTarget), TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$noun}))])}), index:0} */
retarget_spell_single_permanent ::= "target" "spell" "that" "targets" "only" "a" "single" noun

/* The controller is bound independently of the object and owns the counted graveyard. */
/* @sem @and($filter_plain, $controller_graveyard_qualifier) */
filter_controller_graveyard ::= filter_plain controller_graveyard_qualifier

/* @sem ObjectFilter::ControlledBy(Matching{binding:0, condition:Compare{left:CountObjects(Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any})), test:$condition_at_least}}) */
controller_graveyard_qualifier ::= "whose" "controller" "has" condition_at_least "cards" "in" "their" "graveyard"

/* Graveyard host phrases share the card filter across permanent and spell types. */
enchant_graveyard_filter ::= filter_phrase | spell_instant | spell_sorcery

/* @sem EnchantHosts::GraveyardCards{filter:$enchant_graveyard_filter, owners:All} */
enchant_graveyard_cards ::= enchant_graveyard_filter "card" "in" "a" "graveyard"

/* Another attachment excludes the Aura carrying this enchant ability; it refers to the host. */
/* @sem EnchantHosts::Permanents(@and($filter_plain, ObjectFilter::HasAttached(@and($filter_phrase, ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)))))) */
enchant_host_with_another_attachment ::= filter_plain "with" "another" filter_phrase "attached" "to" "it"

/* The two printed land subtypes are distinct filters on the same permanent. */
