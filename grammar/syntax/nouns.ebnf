/* @sem ObjectFilter::AnyOf([ObjectFilter::Subtype(Assassin), ObjectFilter::Subtype(Mercenary), ObjectFilter::Subtype(Pirate), ObjectFilter::Subtype(Rogue), ObjectFilter::Subtype(Warlock)]) */
noun_outlaw ::= "outlaw"
/* @sem ObjectFilter::CardType(Battle) */
noun_battle ::= "battle"

filter_plural ::= event_owned | plural_and_other_population | enchanted_ref_and_object | plural_everything | filter_plural_type_prefix | contextual_other_filter | filter_plural_tail | filter_plural_adjectives | filter_plural_comma | mined_plural | filter_plural_modified | plural_outlaws | color_outside_commander_identity | filter_each_property_among | filter_plural_except_shared | filter_plural_quantified_three | plural_nonattacker_except_unable | plural_controlled_chosen_name | shared_literal_fold_526071ba63ca | filter_plural_folded_vampire | referenced_and_other_sharing_type | plural_controlled_three_colors | plural_named_three | filter_plural_nameless

