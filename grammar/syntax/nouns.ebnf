/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:@and($subtype_negated, ObjectFilter::CardType(Land))}), index:0} */
scoped_target_land_negated ::= "target" subtype_negated "land"

/* A commander designation and the stated kind both apply to the same object. */
/* @sem @and(ObjectFilter::State(Commander), $filter_phrase) */
filter_commander_that_is_a ::= "commander" "that's" "a" filter_phrase

