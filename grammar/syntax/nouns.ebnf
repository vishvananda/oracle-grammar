adjectives ::= adjective | adjective_either | adjective_and_or

/* @sem ObjectFilter::AnyOf([$quality, $quality_2]) */
adjective_and_or ::= quality "and" "/" "or" quality

/* @sem ObjectFilter::AnyOf(@unordered([$quality, $quality_2])) */
adjective_either ::= quality "or" quality

adjective ::= quality_unscoped | noun_atomic

/* An adjective that is not also a noun, so `or` between two of them is one slot. */
quality ::= quality_unscoped | adjective_equipped
quality_unscoped ::= quality_state_three | adjective_transformed | adjective_modified | adjective_party | adjective_face_down | adjective_historic | noun_outlaw | adjective_non_outlaw | adjective_monocolored | adjective_multicolored | adjective_tapped | adjective_untapped | adjective_attacking | adjective_nonattacking | adjective_blocking | adjective_nonblocking | adjective_blocked | adjective_noncommander | adjective_nontoken | adjective_legendary | adjective_nonlegendary | adjective_basic | adjective_nonbasic | adjective_color | adjective_noncolor | adjective_nontype | subtype_negated | adjective_colorless | adjective_snow | adjective_nonsnow | adjective_enchanted | adjective_attacking_or_blocking | adjective_stickered

