/* @sem ObjectFilter::AllOf([OnStack(Spell), CardType(Sorcery)]) */
counter_stack_sorcery ::= "sorcery" "spell"

/* @sem ObjectFilter::AllOf([OnStack(Spell), $counter_stack_quality]) */
counter_stack_qualified_spell ::= counter_stack_quality "spell"

counter_stack_quality ::= adjective_legendary | adjective_snow | adjective_nontype

/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:NthCast{ordinal:$ordinal, spells:Any, scope:Turn}}), index:0}) */
counter_nth_cast ::= "target" "spell" "that's" "the" ordinal "spell" "cast" "this" "turn"

/* @sem ObjectSet::Zone(_{scope:Shared(Stack), kind:Any, filter:ControlledBy($counter_stack_controlled_pair)}) */
counter_opponents_stack ::= counter_stack_controlled_pair

counter_stack_controlled_pair ::= counter_stack_opponent_pair | counter_stack_all_player_pair

/* @sem PlayerSet::OpponentsOf(AbilityController) */
counter_stack_opponent_pair ::= "all" "spells" "your" "opponents" "control" "and" "all" "abilities" "your" "opponents" "control"

/* @sem PlayerSet::All */
counter_stack_all_player_pair ::= "all" "spells" "all" "players" "control" "and" "all" "abilities" "all" "players" "control"

/* Exile targets carry their counter predicate independently of their card type. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Exile]}), count:Exactly(Expr::Constant(1)), filter:@and($card_filter, $modifier_named_counter_on_it)}), index:0} */
target_card_exile_counter ::= "target" card_filter "card" "in" "exile" modifier_named_counter_on_it

/* A three-head union can be reused by scoped population instructions. */
/* @sem ObjectFilter::AnyOf($filter_three_and_members) */
filter_three_and_heads ::= filter_three_and_members

/* @sem ObjectFilter::[$filter_phrase, $filter_phrase_2, $filter_phrase_3] */
filter_three_and_members ::= filter_phrase "," filter_phrase "," "and" filter_phrase

/* A shared qualifier applies to the entire union of the two populations. */
/* @sem @and(ObjectFilter::AnyOf([@and($noun_atomic, $plural_simple), $plural]), $modifiers) */
plural_compound_and_modified ::= noun_atomic plural_simple "and" plural modifiers

/* The activation binder proves the singular exile payment before selecting it. */
/* @sem ObjectRef::@remember_object(ObjectRef::@activation_exiled_card(ObjectRef::Query{objects:Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}, index:0})) */
activation_exiled_this_way ::= "the" "card" "exiled" "this" "way"

/* These populations retain their own identity and selection scope. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:AnyNumber, filter:AllOf([Not(SameObject(Source)), $adjective_nontype, ControlledBy(One(AbilityController))])})) */
source_other_targets ::= "any" "number" "of" "other" "target" adjective_nontype "permanents" "you" "control"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:History{event:Convoked($object_ref), window:ThisGame}} */
convoked_creature_set ::= "each" "creature" "that" "convoked" object_ref

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(CountPlayers(OpponentsOf(AbilityController))), filter:AllOf([$noun, ControlledBy(OpponentsOf(AbilityController))]), constraints:[DifferentControllers]})) */
opponent_distinct_targets ::= "target" noun "that" "player" "controls"

/* Sacrifice descriptions retain the scope of each qualifying phrase. */
sacrifice_description ::= sacrifice_alternative_other | sacrifice_color_or_type_head | sacrifice_named

/* @sem ObjectFilter::AnyOf([$filter_simple, @and(ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), $filter_simple_2)]) */
sacrifice_alternative_other ::= filter_simple "or" "another" filter_simple

/* @sem ObjectFilter::AllOf([ObjectFilter::AnyOf([$adjective_color, $noun_atomic]), $filter_simple]) */
sacrifice_color_or_type_head ::= adjective_color "or" noun_atomic filter_simple

/* @sem ObjectFilter::AllOf([$filter_simple, Name($created_token_name)]) */
sacrifice_named ::= filter_simple "named" created_token_name

/* Qualifiers compose with their noun and retain their distinct object roles. */
/* @sem ObjectFilter::State(Goaded) */
adjective_goaded ::= "goaded"

/* @sem ObjectFilter::OwnedBy(OthersThan(PlayerRef::AbilityController)) */
modifier_not_owned ::= "but" "don't" "own"

/* @sem ObjectFilter::Noted(CreatureType) */
modifier_noted_creature_type ::= "of" "the" "noted" "type"

/* Keep the written controller before the noted type in this qualifier. */
/* @sem @and($modifier_opponent_controls, $modifier_noted_creature_type) */
modifier_opponent_noted_type ::= modifier_opponent_controls modifier_noted_creature_type

/* @sem ObjectFilter::MadeBy(ObjectRef::Source) */
modifier_created_with_scheme ::= "put" "onto" "the" "battlefield" "with" "this" "scheme"

/* @sem ObjectFilter::Counters{kind:$counter_kind, comparison:Greater, value:Expr::Constant(0)} */
modifier_named_counter_an_on_it ::= "with" "an" counter_kind "counter" "on" "it"

/* @sem @and($modifier_you_control, $modifier_not_owned) */
modifier_controlled_not_owned ::= modifier_you_control modifier_not_owned

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::CardType(Creature), ObjectFilter::ControlledBy(Matching{binding:0, condition:PlayerState{player:Bound(0), state:PossibleDefender}}))}), index:0} */
block_capacity_defender_creature ::= "target" "creature" "defending" "player" "controls"

/* The anaphoric block-capacity continuation requires a creature antecedent. */
block_capacity_target ::= block_capacity_defender_creature

/* The blocker and attacker remain distinct in combat history. */
/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Pair{event:BecomesBlockedBy, objects:SameObject(Candidate), others:SameObject($object_ref)}, window:ThisCombat, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
modifier_blocked_by_referent_combat ::= object_ref "blocked" "this" "combat"

/* The damaged player remains the controller of both named populations. */
/* @sem Recipients::Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([AnyOf([$noun, $noun_2]), ControlledBy(One(EventSubject))])}) */
recipients_each_two_types_that_player ::= "each" noun "and" noun "that" "player" "controls"

/* Select all players tied for the maximum in the stated comparison population. */
/* @sem PlayerSet::Matching{binding:0, condition:Compare{left:PlayerNumber{player:Bound(0), number:Permanents($filter_plural)}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:AmongPlayers{players:$players_unqualified_singular, number:Permanents($filter_plural), aggregation:Maximum}}}} */
players_most_controlled ::= players_unqualified_singular "who" "controls" "the" "most" filter_plural

/* A subtype can name a permanent on its own or qualify a stated kind. */
/* @sem $subtype */
filter_subtype_head ::= subtype

/* @sem @and($subtype, $noun) */
filter_subtype_typed ::= subtype noun

/* Each exclusion remains a separate predicate on the same object. */
/* @sem ObjectFilter::AllOf([Not(HasKeyword($keyword_name)), Not(HasKeyword($keyword_name_2)), Not(HasKeyword($keyword_name_3))]) */
modifier_without_three_keywords ::= "without" keyword_name "," keyword_name "," "or" keyword_name

/* The candidate is the object of the controller's spell-cast history. */
/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Spell{event:Cast, players:One(AbilityController), spells:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
modifier_cast_by_you_this_turn ::= "you" "cast" "this" "turn"

/* The attached permanent is selected by its own complete filter. */
/* @sem ObjectFilter::HasAttached($filter_phrase) */
modifier_has_attachment ::= "with" "a" filter_phrase "attached" "to" "it"

/* The target remains in exile at the time of the move. */
/* @sem ObjectSet::InZone{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Exile]}), count:Exactly(Constant(1)), filter:$exiled_keyword_family}), index:0}), zone:Exile} */
target_exiled_keyword_card ::= "target" "exiled" "card" "with" exiled_keyword_family

exiled_keyword_family ::= exiled_keyword_warp | exiled_keyword_flashback

/* @sem ObjectFilter::HasKeywordFamily(Warp) */
exiled_keyword_warp ::= "warp"

/* @sem ObjectFilter::HasKeywordFamily(Flashback) */
exiled_keyword_flashback ::= "flashback"

/* @sem PlayerSet::One(PlayerRef::EnchantedBy(ObjectRef::Source)) */
players_enchanted_opponent ::= "enchanted" "opponent"

/* @sem ObjectFilter::Subtype(Pegasus) */
plural_pegasi ::= "Pegasi"

players_unqualified ::= players_fewest_permanents | mined_players | player_one | players_each_opponent | players_each | players_or_controller | players_each_other | players_each_other_opponent
    | players_each_friend | players_each_foe | event_enchanted_player

/* Player qualifiers retain their bound player's identity independently of the action. */
/* @sem PlayerSet::Intersection([$players_unqualified, Matching{binding:0, condition:Not(Controls{player:Bound(0), filter:$filter_phrase, minimum:1})}]) */
players_qualified_control_an ::= players_unqualified "who" "doesn't" "control" "an" filter_phrase

/* @sem PlayerSet::Intersection([$players_unqualified, Matching{binding:0, condition:Compare{left:EventHistory{event:Spell{event:Cast, players:One(Bound(0)), spells:SharesNameWithAny(Selected(0))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}}}]) */
players_qualified_cast_same_name ::= players_unqualified "who" "cast" counter_amount "spell" "this" "turn" "with" "the" "same" "name" "as" "that" "card"

/* @sem PlayerSet::Intersection([$players_unqualified, Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:MovedBy{result:@prior, phase:After, player:Bound(0)}, filter:SharesWithAny{property:CardTypes, with:MovedBy{result:@prior, phase:After, player:AbilityController}}}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}]) */
players_qualified_discard_shared_type ::= players_unqualified "who" "discarded" "a" "card" "that" "shares" "a" "card" "type" "with" "the" "card" "you" "discarded"

players_qualified ::= players_qualified_control_an | players_qualified_cast_same_name | players_qualified_discard_shared_type

/* @sem PlayerSet::One(Chosen) */
players_chosen_shared ::= "the" "chosen" "player"

/* The owner is the player bound by the enclosing instruction. */
/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(One(Bound(0))), ExiledWith($object_ref)])}) */
bound_owned_linked_exile_cards ::= "all" "cards" "they" "own" "exiled" "with" object_ref

/* Shared characteristics refer to the entire linked exile population. */
top_cast_shared_filter ::= shares_linked_card_type | shares_linked_color

/* @sem ObjectFilter::SharesWithAny{property:CardTypes, with:$exile_linked_population} */
shares_linked_card_type ::= "shares" "a" "card" "type" "with" "a" "card" exile_linked_population

/* @sem ObjectFilter::SharesWithAny{property:Colors, with:$exile_linked_population} */
shares_linked_color ::= "shares" "a" "color" "with" "a" "card" exile_linked_population

/* An optional target can be any of three separately qualified kinds. */
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo($number), filter:AnyOf([$noun, $noun_2, @and(ObjectFilter::Tapped, $noun_3)])}), index:0}) */
objects_optional_three_kinds ::= "up" "to" number "target" noun "," noun "," "or" "tapped" noun

/* The target count is evaluated from a controlled subtype population. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$subtype_plural, ControlledBy(One(AbilityController))])})), filter:AllOf([$plural, Not(HasActivatedAbility(Mana))])})) */
objects_up_to_count_without_mana ::= "up" "to" "X" "target" plural "without" "mana" "abilities" "," "where" "X" "is" "the" "number" "of" subtype_plural "you" "control"

/* The extreme is measured over the same controlled population as the candidate. */
/* @sem @and($filter_nonlist_head, $modifier_you_control, ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:Equal, value:Expr::Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_nonlist_head, $modifier_you_control)}, property:$stat, aggregation:$extreme_aggregation}}}) */
filter_controlled_extreme ::= filter_nonlist_head modifier_you_control "with" "the" extreme_aggregation stat

/* @sem @and($token_subtype, ObjectFilter::Token) */
subtype_tokens ::= token_subtype "tokens"

token_subtype ::= token_subtype_blood_folded | noun_zombie_folded | subtype

/* Sentence-initial Zombie folds when lowercase zombie is in the vocabulary. */
/* token_subtype_zombie_folded is shared as noun_zombie_folded. */

/* A target and its comparison population retain independent filters. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($filter_plain, $modifier_extreme_among)}), index:0} */
target_extreme_battlefield ::= "target" filter_plain modifier_extreme_among

/* A filtered linked population retains the independently printed filter. */
/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_phrase, ExiledWith($object_ref)])} */
linked_exiled_filtered_all ::= "all" filter_phrase "cards" "exiled" "with" object_ref

/* @sem ObjectSet::@exile_followup(InZone{objects:One(Result{result:@prior, phase:After, index:0}), zone:Exile}) */
prior_exiled_it ::= "it"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:All, each:UpTo($number)}, filter:$adjective_nontype})) */
per_player_permanent_targets ::= "up" "to" number "target" adjective_nontype "permanent" "that" "player" "controls"

/* A linked population is owned independently of the source anchor. */
/* @sem ObjectSet::$permission_owned_linked_exile_cards */
owned_linked_exile_population ::= "all" permission_owned_linked_exile_cards

/* The source-created creature remains the object of the later action. */
/* @sem ObjectSet::One(MadeHere) */
linked_battlefield_creature_set ::= "the" "creature" "put" "onto" "the" "battlefield" "with" "this" "enchantment"

/* The target is a card contained in the linked exile population. */
/* @sem ObjectSet::InZone{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Exile]}), count:Exactly(Constant(1)), filter:AllOf([$filter_phrase, InSet(Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}))])}), index:0}), zone:Exile} */
target_linked_exile_set_card ::= "target" filter_phrase "card" "exiled" "with" object_ref

/* The threshold restricts the population independently of the subsequent verb. */
/* @sem PlayerSet::Intersection([$players_unqualified_singular, Matching{binding:0, condition:Compare{left:CountCounters(_{recipients:Players(One(Bound(0))), kind:$counter_kind, information:CurrentOrLastKnown}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}}]) */
players_with_counter_threshold ::= players_unqualified_singular "who" "has" value "or" "more" counter_kind "counters"

/* The announcement targets only players with a qualifying life-loss event. */
/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:Matching{binding:0, condition:Compare{left:EventHistory{event:Player{event:LosesLife, players:One(Bound(0))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}}), index:0} */
target_player_lost_life ::= "target" "player" "who" "lost" "life" "this" "turn"

/* The card mentioned by the event remains distinct from its owner. */
/* @sem PlayerRef::OwnerOf(EventSubject) */
event_card_owner ::= "that" "card's" "owner"

/* The threshold is evaluated in the filter's object scope. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo($value), filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:@in_filter($value_2)}}, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0} */
target_up_to_your_graveyard_mana_value ::= "up" "to" value "target" card_filter "card" "with" "mana" "value" "less" "than" "or" "equal" "to" value "from" "your" "graveyard"

/* Preserve the linked exile set independently of the time of exile. */
/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([InSet($permission_linked_exile_cards), History{event:Exiled, window:ThisTurn}])}) */
linked_exile_this_turn ::= permission_linked_exile_cards "this" "turn"

/* The anaphor in the entry consequence requires a creature spell. */
additional_creature_spell_filter ::= noun_creature | additional_modified_creature_spell_filter

/* @sem @and($adjective, $additional_creature_spell_filter) */
additional_modified_creature_spell_filter ::= adjective additional_creature_spell_filter

/* The candidate is the damage source; the historical test is independent of
   any quantity selected by the enclosing action. */
/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Damage(DamageEvent{source_kind:Permanent, sources:SameObject(ObjectRef::Candidate), recipients:Players(One(PlayerRef::AbilityController)), kind:Combat, grouping:SourceRecipient, subject:Source}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}) */
