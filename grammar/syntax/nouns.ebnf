exiled_by_you_with_counters ::= "cards" "you" "exiled" "that" "have" counter_kind "counters" "on" "them"

/* A trailing exception excludes the members described by its plural filter. */
/* @sem ObjectFilter::Not($filter_plural) */
except_plural_filter ::= "except" "for" filter_plural

/* @sem ObjectFilter::HasKeywordFamily(Soulbond) */
modifier_with_soulbond ::= "with" "soulbond"

/* A list describes the excluded population independently of its enclosing action. */
/* @sem ObjectFilter::Not(AnyOf([$filter_phrase, $filter_plural, $filter_plural_2, $filter_plural_3, $filter_plural_4])) */
population_exception ::= "except" "for" filter_phrase "," filter_plural "," filter_plural "," filter_plural "," "and" filter_plural

/* A referenced permanent and a separately filtered population compared to it. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($object_ref), AllOf([$filter_phrase, Not(SameObject($object_ref_2)), Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:ObjectProperty{object:$object_ref_2, property:ManaValue, information:CurrentOrLastKnown}}}])])} */
same_mana_value_referenced_population ::= object_ref "and" "each" "other" filter_phrase "with" "the" "same" "mana" "value" "as" object_ref

/* Alternative card descriptions share the same eligible population. */
card_kind_union ::= card_kind_union_two | card_kind_union_three | card_kind_union_four

/* @sem ObjectFilter::AnyOf([$filter_phrase, $filter_phrase_2]) */
card_kind_union_two ::= filter_phrase "and" "/" "or" filter_phrase

/* @sem ObjectFilter::AnyOf($card_kind_union_three_members) */
card_kind_union_three ::= card_kind_union_three_members

/* @sem ObjectFilter::[$filter_phrase, $filter_phrase_2, $filter_phrase_3] */
