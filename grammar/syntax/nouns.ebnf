/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), CardType(Creature), ControlledBy(One(AbilityController))])} */
each_counter_other_controlled ::= "each" "other" "creature" "you" "control"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])} */
each_counter_controlled ::= "each" "creature" "you" "control"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)} */
each_counter_any ::= "each" "creature"

/* A filtered card population in the named player's graveyard. */
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One($zone_owner)}, kind:Card, filter:$filter_phrase} */
sticker_card_population ::= ("a" | "an") filter_phrase "card" "in" zone_owner "graveyard"

/* A single damage target may be an opponent or either of two opposing populations. */
/* @sem ObjectFilter::@and($filter_phrase, ObjectFilter::ControlledBy(OpponentsOf(AbilityController))) */
opponent_controlled_recipient ::= filter_phrase "an" "opponent" "controls"

/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Expr::Constant(1)), filter:AnyOf([$opponent_controlled_recipient, $opponent_controlled_recipient_2]), players:OpponentsOf(AbilityController)})) */
recipients_opponent_or_two_controlled ::= "target" "opponent" "," opponent_controlled_recipient "," "or" opponent_controlled_recipient

/* The extreme compares the named population across the whole battlefield. */
/* @sem ObjectFilter::Extreme{among:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plain}, property:ManaValue, highest:true} */
battlefield_greatest_mana_tied ::= filter_plain "with" "the" "greatest" "mana" "value" "or" "tied" "for" "the" "greatest" "mana" "value"

