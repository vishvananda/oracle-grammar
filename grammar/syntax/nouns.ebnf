/* Noun phrases. Filters compose: adjectives before a head, modifiers after. */
object_set ::= objects_any_other_targets | objects_each_controlled_union | group_reference | drafted_cards_reference | graveyard_target_cards | qualified_set | created_reference | mined_set | object_one | objects_all_sharing | objects_all | objects_each | objects_each_other | objects_all_other | objects_targets | objects_other_targets | objects_all_two | objects_random | objects_random_cards | objects_two_targets | objects_three_targets | objects_four_targets | objects_target_and_up_to | objects_target_and_all | objects_target_and_named | objects_pair_both | objects_that_and_self | objects_target_and_each_other | objects_self_and_target | ordered_cards | linked_exiled_cards | event_amount_library_end | objects_each_controlled_mana_ability | objects_each_controlled_exhaust | objects_team_targets | filtered_cards_in_target_hand | objects_each_controlled_and_or_union

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($target_object), SameObject($other_target_up_to)])} */
objects_target_and_up_to ::= target_object "and" other_target_up_to

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(Expr::Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@another_target_reference(ObjectFilter::$filter_phrase))), $filter_phrase)}), index:0} */
other_target_up_to ::= "up" "to" "one" "other" "target" filter_phrase

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($target_object), $filter_plural])} */
objects_target_and_all ::= target_object "and" "all" filter_plural

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($target_object), $others_of_target])} */
objects_target_and_named ::= target_object "and" others_of_target

/* @sem @and(ObjectFilter::Not(ObjectFilter::SameObject(@it)), $filter_plural) */
others_of_target ::= "all" "other" filter_plural

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($target_object), $others_each])} */
objects_target_and_each_other ::= target_object "and" others_each

/* @sem @and(ObjectFilter::Not(ObjectFilter::SameObject(@it)), $filter_phrase) */
others_each ::= "each" "other" filter_phrase

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf(@unordered([SameObject($self_ref), SameObject($target_object)]))} */
objects_self_and_target ::= self_ref "and" target_object

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject(ObjectRef::BlockPair(Attacker)), SameObject(ObjectRef::BlockPair(Blocker))])} */
objects_pair_both ::= "both" "creatures"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($that_noun), SameObject($self_ref)])} */
objects_that_and_self ::= that_noun "and" self_ref

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([$filter_plural, $filter_plural_2])} */
objects_all_two ::= "all" filter_plural "and" "all" filter_plural

/* @sem ObjectSet::@selection(SelectionStep::_{binding:0, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, chooser:Chance, count:AsManyAsCan(Expr::Constant(1))}) */
objects_random ::= ("a" | "an") filter_phrase "chosen" "at" "random"

/* Cards chosen by chance from one player's graveyard or library: as many as the pool
   holds, up to the count, so an empty pool selects nothing (Haunted Fengraf). */
objects_random_cards ::= objects_random_graveyard_any | objects_random_graveyard_one | objects_random_graveyard_many | objects_random_library_one | objects_random_library_chosen

/* @sem ObjectSet::@selection(SelectionStep::_{binding:0, objects:Zone{scope:Players{zone:Graveyard, players:One($zone_owner)}, kind:Card, filter:Any}, chooser:Chance, count:AsManyAsCan(Expr::Constant(1))}) */
objects_random_graveyard_any ::= "a" "card" "at" "random" "from" zone_owner "graveyard"

/* @sem ObjectSet::@selection(SelectionStep::_{binding:0, objects:Zone{scope:Players{zone:Graveyard, players:One($zone_owner)}, kind:Card, filter:$random_card_kind}, chooser:Chance, count:AsManyAsCan(Expr::Constant(1))}) */
objects_random_graveyard_one ::= ("a" | "an") random_card_kind "card" "at" "random" "from" zone_owner "graveyard"

/* @sem ObjectSet::@selection(SelectionStep::_{binding:0, objects:Zone{scope:Players{zone:Graveyard, players:One($zone_owner)}, kind:Card, filter:$random_cards}, chooser:Chance, count:AsManyAsCan($count)}) */
objects_random_graveyard_many ::= count random_cards "at" "random" "from" zone_owner "graveyard"

/* @sem ObjectSet::@selection(SelectionStep::_{binding:0, objects:Zone{scope:Players{zone:Library, players:One($zone_owner)}, kind:Card, filter:$random_card_one}, chooser:Chance, count:AsManyAsCan(Expr::Constant(1))}) */
objects_random_library_one ::= "a" "random" random_card_one "from" zone_owner "library"

/* @sem ObjectSet::@selection(SelectionStep::_{binding:0, objects:Zone{scope:Players{zone:Library, players:One($zone_owner)}, kind:Card, filter:$random_card_one}, chooser:Chance, count:AsManyAsCan(Expr::Constant(1))}) */
objects_random_library_chosen ::= ("a" | "an") random_card_one "from" zone_owner "library" "chosen" "at" "random"

random_card_one ::= random_any_card | random_filtered_card
/* @sem ObjectFilter::Any */
random_any_card ::= "card"
/* @sem $random_card_kind */
random_filtered_card ::= random_card_kind "card"

random_cards ::= random_any_cards | random_filtered_cards
/* @sem ObjectFilter::Any */
random_any_cards ::= "cards"
/* @sem $random_card_kind */
random_filtered_cards ::= random_card_kind "cards"

/* A permanent's qualities, or a spell type that only a card in a library can have. */
random_card_kind ::= filter_phrase | spell_instant | spell_sorcery

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($target_object), SameObject($target_object_2)])} */
objects_two_targets ::= target_object "and" target_object

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($target_object), SameObject($target_object_2), SameObject($target_object_3)])} */
objects_three_targets ::= target_object "," target_object "," "and" target_object

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($target_object), SameObject($target_object_2), SameObject($target_object_3), SameObject($target_object_4)])} */
objects_four_targets ::= target_object "," target_object "," target_object "," "and" target_object

/* @sem ObjectSet::One($object_ref) */
object_one ::= object_ref

object_ref ::= combat_blocker_ref | combat_attacker_ref | target_optional_stack_spell | ordered_top_card | last_linked_card | last_linked_creature | current_card_ref | linked_exiled_card | mined_ref | self_ref | it_ref | target_object | attached_ref | target_card

/* Earlier's link belongs to the current ability holder. The binder checks its
   explicit anchor rather than accepting a target or a named outer creator. */
/* @sem ObjectRef::@last_exiled($object_ref) */
last_linked_card ::= "the" "last" "card" "exiled" "with" object_ref

/* @sem ObjectRef::@last_exiled_creature($object_ref) */
last_linked_creature ::= "the" "last" "creature" "card" "exiled" "with" object_ref

/* @sem ObjectRef::@current_named_object */
current_card_ref ::= "that" "card"

/* The linked ability's source is its anchor, including after a death event. */
/* @sem ObjectRef::@remember_object(ObjectRef::@activation_exiled_card(ObjectRef::Query{objects:Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}, index:0})) */
linked_exiled_card ::= "the" "exiled" "card"

target_card ::= target_card_up_to_union_your_graveyard | target_card_other_your_graveyard | target_card_your_graveyard | target_any_card_your_graveyard | target_card_a_graveyard | target_any_card_a_graveyard | target_card_your_graveyard_with | target_card_opponent_graveyard | target_any_card_opponent_graveyard | target_card_that_player_graveyard | target_card_a_graveyard_up_to_one | target_card_ability_graveyard | target_typed_ability_graveyard | target_card_your_graveyard_opponent_choice | target_card_union_your_graveyard | target_card_exiled_with_source

/* A card target is announced after a departure, so `another` excludes the new
   card, rather than the departed permanent or the candidate being filtered. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and($card_filter, ObjectFilter::Not(ObjectFilter::SameObject(@current_named_object)), ObjectFilter::InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}))}), index:0} */
target_card_other_your_graveyard ::= "another" "target" card_filter "card" ("from" | "in") "your" "graveyard"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and($card_filter, $graveyard_card_modifiers, ObjectFilter::InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}))}), index:0} */
target_card_your_graveyard_with ::= "target" card_filter "card" graveyard_card_modifiers ("from" | "in") "your" "graveyard"
    | "target" card_filter "card" ("from" | "in") "your" "graveyard" graveyard_card_modifiers

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and($card_filter, ObjectFilter::InZone(Players{zone:Graveyard, players:OpponentsOf(PlayerRef::AbilityController)}))}), index:0} */
target_card_opponent_graveyard ::= "target" card_filter "card" ("from" | "in") "an" "opponent's" "graveyard"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:ObjectFilter::InZone(Players{zone:Graveyard, players:OpponentsOf(PlayerRef::AbilityController)})}), index:0} */
target_any_card_opponent_graveyard ::= "target" "card" ("from" | "in") "an" "opponent's" "graveyard"
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and($card_filter, ObjectFilter::InZone(Players{zone:Graveyard, players:One(@that_player)}))}), index:0} */
target_card_that_player_graveyard ::= "target" card_filter "card" ("from" | "in") "that" "player's" "graveyard"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and($card_filter, ObjectFilter::InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}))}), index:0} */
target_card_your_graveyard ::= "target" card_filter "card" ("from" | "in") "your" "graveyard"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:ObjectFilter::InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)})}), index:0} */
target_any_card_your_graveyard ::= "target" "card" ("from" | "in") "your" "graveyard"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:$card_filter}), index:0} */
target_card_a_graveyard ::= "target" card_filter "card" ("from" | "in") "a" "graveyard"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:Any}), index:0} */
target_any_card_a_graveyard ::= "target" "card" ("from" | "in") "a" "graveyard"

/* Up to one card is a target announcement whose filter and graveyard domain
   compose independently with the action that moves the selected card. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:UpTo(Expr::Constant(1)), filter:$card_filter}), index:0} */
target_card_a_graveyard_up_to_one ::= "up" "to" "one" "target" card_filter "card" ("from" | "in") "a" "graveyard"

/* An Aura or Equipment names its host by its enchant noun; the enchant ability holds the filter. */
/* Explicit hosts become the next pronoun when acted on or tested. Event filters
   and damage sources retain their enclosing event's referent. */
attached_ref ::= enchanted_ref | equipped_ref

/* The word enchanted supplies the Aura departure exception; Equipment and
   Fortifications do not move to the graveyard when their host leaves. */
/* @prefer value(AttachedTo) */
enchanted_ref ::= enchanted_creature_ref | enchanted_qualified_creature_ref | enchanted_other_ref

/* Same reference as enchanted_operand; retain only the literal creature noun. */
/* @sem ObjectRef::@enchanted_creature_operand(ObjectRef::AttachedTo(Source)) */
enchanted_creature_ref ::= "enchanted" "creature"

/* @sem ObjectRef::@enchanted_operand(ObjectRef::AttachedTo(Source)) */
enchanted_other_ref ::= "enchanted" attached_other_noun

/* @prefer value(AttachedTo) */
/* @sem ObjectRef::@remember_operand(ObjectRef::AttachedTo(Source)) */
equipped_ref ::= ("equipped" | "fortified") attached_noun

/* @sem () */
attached_noun ::= "creature" | "permanent" | "land" | "artifact" | "enchantment" | "planeswalker" | "Forest" | "Island"
    | "Mountain" | "Plains" | "Swamp" | "Vehicle" | "battle" | "Equipment" | "Aura" | subtype_word

/* All prior attached nouns remain available to Equipment/Fortifications. */
/* @sem () */
attached_other_noun ::= "permanent" | "land" | "artifact" | "enchantment" | "planeswalker" | "Forest" | "Island"
    | "Mountain" | "Plains" | "Swamp" | "Vehicle" | "battle" | "Equipment" | "Aura" | subtype_word

self_ref ::= self_explicit_ref | self_ref_pronoun

self_explicit_ref ::= self_ref_holder | self_ref_named

/* @sem ObjectRef::@self */
self_ref_holder ::= self_holder_text

/* The printed card name still names the creator inside a token's ability. */
/* @sem ObjectRef::@named_source */
self_ref_named ::= self_named

/* @sem ObjectRef::@self */
self_ref_pronoun ::= self_pronoun

/* @sem () */
self_pronoun ::= "he" | "she"

/* The word a card uses for itself. */
self_text ::= self_holder_text | self_named

self_holder_text ::= self_creature | self_land | self_artifact | self_enchantment | self_permanent | self_spell
    | self_aura | self_equipment | self_vehicle | self_saga | self_class | self_token | self_planeswalker | self_battle
    | self_card | self_room | self_case | self_spacecraft | self_background | self_siege | self_planet | self_emblem
    | self_scheme

/* @prefer type(Creature) */
/* @sem () */
self_creature ::= "this" "creature"
/* @prefer type(Land) */
/* @sem () */
self_land ::= "this" "land"
/* @prefer type(Artifact) */
/* @sem () */
self_artifact ::= "this" "artifact"
/* @prefer type(Enchantment) */
/* @sem () */
self_enchantment ::= "this" "enchantment"
/* @prefer type(Legendary) */
/* @prefer type(Instant) */
/* @prefer type(Sorcery) */
/* @prefer type(Planeswalker) */
/* @prefer type(Plane) */
/* @prefer type(Phenomenon) */
/* @prefer type(Vanguard) */
/* @sem () */
self_named ::= SELF_NAME
/* @sem () */
self_permanent ::= "this" "permanent"
/* @prefer type(Spell) */
/* @sem () */
self_spell ::= "this" "spell"
/* @prefer type(Aura) */
/* @sem () */
self_aura ::= "this" "Aura"
/* @prefer type(Equipment) */
/* @sem () */
self_equipment ::= "this" "Equipment"
/* @prefer type(Vehicle) */
/* @sem () */
self_vehicle ::= "this" "Vehicle"
/* @prefer type(Saga) */
/* @sem () */
self_saga ::= "this" "Saga"
/* @prefer type(Class) */
/* @sem () */
self_class ::= "this" "Class"
/* @prefer type(Token) */
/* @sem () */
self_token ::= "this" "token"
/* @sem () */
self_planeswalker ::= "this" "planeswalker"
/* @prefer type(Battle) */
/* @sem () */
self_battle ::= "this" "battle"
/* @prefer type(Card) */
/* @sem () */
self_card ::= "this" "card"
/* @prefer type(Room) */
/* @sem () */
self_room ::= "this" "Room"
/* @prefer type(Case) */
/* @sem () */
self_case ::= "this" "Case"
/* @prefer type(Spacecraft) */
/* @sem () */
self_spacecraft ::= "this" "Spacecraft"
/* @prefer type(Background) */
/* @sem () */
self_background ::= "this" "Background"
/* @prefer type(Siege) */
/* @sem () */
self_siege ::= "this" "Siege"
/* @prefer type(Planet) */
/* @sem () */
self_planet ::= "this" "Planet"
/* @prefer type(Scheme) */
/* @sem () */
self_scheme ::= "this" "scheme"
/* An emblem's abilities name it. */
/* @prefer type(Emblem) */
/* @sem () */
self_emblem ::= "this" "emblem"

/* @prefer value(EventSubject) */
it_ref ::= it_pronoun | that_noun

/* @prefer value(EventSubject) */
it_pronoun ::= it_ordinary_pronoun | it_reflexive_pronoun
/* @sem ObjectRef::@member_count_it(ObjectRef::@it) */
it_ordinary_pronoun ::= "it"
/* @sem ObjectRef::@literal_damage_itself(ObjectRef::@member_count_it(ObjectRef::@it)) */
it_reflexive_pronoun ::= "itself"

/* An explicitly named action recipient becomes the following pronoun's focus;
   a damage source or event filter does not replace that action recipient. */
/* @sem ObjectRef::@remember_operand($qualified_noun) */
that_noun ::= qualified_noun

/* Attachment subjects can name an object without replacing their host pronoun. */
qualified_noun ::= named_subtype | named_creature | named_permanent | named_artifact | named_enchantment | named_land | named_spell | named_planeswalker | named_creature_or_planeswalker | named_equipment | named_aura | named_vehicle

target_object ::= target_attacking_alone | target_event_subject_choice | target_up_to_one_other_attacking | target_combat_counterpart | target_excluding_named | target_permanent | target_either_kind | target_another | target_up_to_one | target_up_to_one_other

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(Expr::Constant(1)), filter:$filter_phrase}), index:0} */
target_up_to_one ::= "up" "to" "one" "target" filter_phrase

/* This attacking population keeps its optional slot and other-object anchor.
   Wider optional-target spellings retain their existing receipt/role paths. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(Expr::Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@another_target_reference(ObjectFilter::$filter_phrase))), @and(ObjectFilter::Attacking, $filter_phrase))}), index:0} */
target_up_to_one_other_attacking ::= "up" "to" "one" "other" "target" "attacking" filter_phrase

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@another_target_reference(ObjectFilter::$filter_phrase))), $filter_phrase)}), index:0} */
target_another ::= "another" "target" filter_phrase

/* "Up to one other target nontoken creature you control": another, optionally. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(Expr::Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@another_target_reference(ObjectFilter::$filter_phrase))), $filter_phrase)}), index:0} */
target_up_to_one_other ::= "up" "to" "one" "other" "target" filter_phrase

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:$filter_phrase}), index:0} */
target_permanent ::= "target" filter_phrase

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:AnyOf([$filter_modified, $filter_tail])}), index:0} */
target_either_kind ::= "target" filter_modified "or" filter_tail

/* @sem ObjectSet::@distributive_pump_subject(ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}) */
objects_all ::= "all" filter_plural

/* @sem ObjectSet::@distributive_pump_subject(ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}) */
objects_each ::= "each" filter_phrase

/* @sem ObjectSet::@distributive_pump_subject(ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@pump_other_ref(ObjectRef::@it))), $filter_phrase)}) */
objects_each_other ::= "each" "other" filter_phrase

/* @sem ObjectSet::@distributive_pump_subject(ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@other_filter(@and(ObjectFilter::Not(ObjectFilter::SameObject(@pump_other_ref(ObjectRef::@it))), $filter_plural))}) */
objects_all_other ::= "all" "other" filter_plural

/* @sem $objects_targets_plain */
objects_targets ::= ("each" "of")? objects_targets_plain
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:$plural_target_count_any, filter:$filter_plural})) */
objects_targets_plain ::= plural_target_count_any "target" filter_plural


/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:$plural_target_count, filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@another_target_reference(ObjectFilter::$filter_plural))), $filter_plural)})) */
objects_other_targets ::= ("each" "of")? plural_target_count "other" "target" filter_plural

/* A plural noun agrees with its count: never "up to one target creatures". */
/* @sem Count::@plural_count($target_count_any) */
plural_target_count_any ::= target_count_any
/* @sem Count::@plural_count($target_count) */
plural_target_count ::= target_count

target_count ::= target_receipt_up_to | target_exactly | target_up_to | target_adjacent_range

/* A count of targets, or as many as the chooser likes, none included. `Other` targets
   take only `target_count`: whether `any number of other target creatures` contrasts
   with an earlier target or with this object depends on how directly that target
   precedes it (Jaheira, Heroic Harper and Kinetic Ooze in the reference), which the
   binder cannot yet tell. */
target_count_any ::= target_count | count_any_number
/* @sem Count::AnyNumber */
count_any_number ::= "any" "number" "of"

/* @sem Count::Exactly($count) */
target_exactly ::= count

/* @sem Count::UpTo($count) */
target_up_to ::= "up" "to" count

filter_phrase ::= filter_permanent_of_that_color | filter_qualified_three_heads | filter_legendary_three_kinds | filter_unequal_stats | filter_lowest_mana_value | filter_activated_or_tapped | creature_not_five_subtypes | five_subtype_union | filter_plain | filter_lists | filter_quality_list | filter_phrase_modified | mined_filter | filter_instant_or_sorcery | filter_instant_and_or_sorcery | filter_mixed_nonbasic_list | filter_mixed_tapped_list | filter_that_is_three_kinds | filter_coin_tails | filter_urzas_land_subtypes

/* @sem @and($quality, ObjectFilter::AnyOf([$noun, $noun_2, $noun_3]), $modifier) */
filter_quality_list ::= quality noun "," noun "," "and" noun modifier

filter_plain ::= filter_tail | filter_adjectives | filter_adjectives_comma | filter_type_prefix

/* Non-noun qualities retain their shared scope. A noun prefix describes one
   compound head before a following bare `or` head (artifact creature or Vehicle). */
/* @sem @and($filter_outer_adjectives, $filter_plain) */
filter_adjectives ::= filter_outer_adjectives filter_plain
filter_outer_adjectives ::= quality_unscoped | adjective_either | adjective_and_or

/* @sem @and($noun_atomic, $typed_filter_tail) */
filter_type_prefix ::= noun_atomic typed_filter_tail
/* @sem @and($typed_filter_head, $modifiers) */
typed_filter_modified ::= typed_filter_head modifiers
typed_filter_tail ::= typed_filter_head | typed_filter_modified
typed_filter_head ::= filter_simple | noun_and | noun_list

filter_compound_or ::= filter_compound_or_forward | filter_compound_or_reverse
/* @sem ObjectFilter::AnyOf([@and($noun_atomic, $filter_simple), $noun]) */
filter_compound_or_forward ::= noun_atomic filter_simple "or" noun
/* @sem ObjectFilter::AnyOf([$noun, @and($noun_atomic, $filter_simple)]) */
filter_compound_or_reverse ::= noun_atomic filter_simple "or" noun
/* @sem @and($filter_compound_or, $modifiers) */
filter_compound_or_modified ::= filter_compound_or modifiers

/* @sem @and($quality, $filter_plain) */
filter_adjectives_comma ::= quality "," filter_plain

/* Lists of whole noun phrases. An adjective on the first noun alone distributes;
   one on a later noun stays with that noun. */
filter_lists ::= filter_list_two | filter_list_two_modified | filter_list_last_keyword | filter_list_last_stat

/* Partition written heads lexically; never redistribute a finished IR Either. */
filter_list_two ::= head_list_unshared_right | head_list_independent_left
    | head_shared_creature | head_shared_tapped_creature

filter_list_two_modified ::= head_list_unshared_right_modified | head_list_independent_left_modified
    | head_shared_creature_modified | head_shared_tapped_creature_modified

/* @sem ObjectFilter::AnyOf([...$noun_commas, @and($noun, $modifier_with_keyword)]) */
filter_list_last_keyword ::= noun_commas "or" noun modifier_with_keyword

filter_simple ::= noun | filter_described

/* @sem @and($adjective, $filter_simple) */
filter_described ::= adjective filter_simple

noun_commas ::= noun_commas_more | noun_commas_last

/* @sem ObjectFilter::[$noun, ...$noun_commas] */
noun_commas_more ::= noun "," noun_commas

/* @sem ObjectFilter::[$noun] */
noun_commas_last ::= noun ","

filter_tail ::= filter_head | filter_modified | filter_compound_or | filter_compound_or_modified

filter_modified ::= filter_singular_relative_modified | filter_nonlist_modified | filter_list_modified | filter_creature_list_modified

/* @sem @and($filter_nonlist_head, $modifiers) */
filter_nonlist_modified ::= filter_nonlist_head modifiers

filter_nonlist_head ::= noun | noun_either | noun_and

/* @sem @and(ObjectFilter::AnyOf([...$noun_commas, $noun_noncreature]), $modifiers) */
filter_list_modified ::= noun_commas "or" noun_noncreature modifiers

/* A first numeric power/toughness qualifier belongs only to final Creature.
   Other first modifiers retain the established shared-list interpretation. */
/* @sem @and(ObjectFilter::AnyOf([...$noun_commas, $noun_creature]), $list_shared_modifiers) */
filter_creature_list_modified ::= noun_commas "or" noun_creature list_shared_modifiers

list_shared_modifiers ::= list_shared_modifier | list_shared_modifiers_more

/* @sem @and($list_shared_nonattachment, $modifiers) */
list_shared_modifiers_more ::= list_shared_nonattachment modifiers

list_shared_modifier ::= list_shared_nonattachment | modifier_attached_to | modifier_attached_to_a
list_shared_nonattachment ::= modifier_nonnumeric | modifier_mana_value_numeric | modifier_variable_stat

/* Variable amounts retain their prior shared scope; the new contract is numeric. */
modifier_variable_number ::= number_x | number_x_plus
modifier_variable_stat ::= modifier_variable_stat_bound | modifier_variable_stat_exact
/* @sem ObjectFilter::Property{property:$creature_stat, test:NumberTest::Compare{comparison:$bound, value:Expr::@in_filter($modifier_variable_number)}} */
modifier_variable_stat_bound ::= "with" creature_stat modifier_variable_number "or" bound
/* @sem ObjectFilter::Property{property:$creature_stat, test:NumberTest::Compare{comparison:Equal, value:Expr::@in_filter($modifier_variable_number)}} */
modifier_variable_stat_exact ::= "with" creature_stat modifier_variable_number

/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:$bound, value:Expr::@in_filter($number)}} */
modifier_mana_value_bound ::= "with" "mana" "value" number "or" bound
/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:Expr::@in_filter($number)}} */
modifier_mana_value_exact ::= "with" "mana" "value" number
modifier_mana_value_numeric ::= modifier_mana_value_bound | modifier_mana_value_exact

/* @sem ObjectFilter::AnyOf(@unordered([@and($noun_creature, $modifier_creature_stat), ...$noun_commas])) */
filter_list_last_stat ::= noun_commas "or" noun_creature modifier_creature_stat

modifier_creature_stat ::= modifier_creature_stat_bound | modifier_creature_stat_exact
creature_stat ::= stat_power | stat_toughness
creature_stat_number ::= number_digits | number_words
/* @sem ObjectFilter::Property{property:$creature_stat, test:NumberTest::Compare{comparison:$bound, value:Expr::@in_filter($creature_stat_number)}} */
modifier_creature_stat_bound ::= "with" creature_stat creature_stat_number "or" bound
/* @sem ObjectFilter::Property{property:$creature_stat, test:NumberTest::Compare{comparison:Equal, value:Expr::@in_filter($creature_stat_number)}} */
modifier_creature_stat_exact ::= "with" creature_stat creature_stat_number

filter_head ::= noun | noun_either | noun_and | noun_list

/* @sem ObjectFilter::AnyOf(@unordered([$noun, $noun_2])) */
noun_and ::= noun "and" noun

/* @sem ObjectFilter::AnyOf([$noun, $noun_2]) */
noun_either ::= noun union_or noun

/* @sem ObjectFilter::AnyOf([...$noun_commas, $noun]) */
noun_list ::= noun_commas union_or noun

/* `And/or` joins kinds as `or` does: `instant and/or sorcery`. */
/* @sem () */
union_or ::= "or" | "and" "/" "or"

/* In a plural list it joins them as `and` does: `artifacts, creatures, and/or lands`. */
/* @sem () */
union_and ::= "and" | "and" "/" "or"

noun ::= noun_atomic | noun_equipped
noun_atomic ::= noun_creature | noun_noncreature

/* @sem @and($adjective_equipped, $noun_equipped_head) */
noun_equipped ::= adjective_equipped noun_equipped_head
noun_equipped_head ::= noun_atomic | noun_equipped_qualified
/* @sem @and($adjective, $noun_equipped_head) */
noun_equipped_qualified ::= adjective noun_equipped_head

noun_noncreature ::= noun_room | noun_outlaw | noun_artifact | noun_enchantment | noun_land | noun_planeswalker | noun_permanent
    | noun_token | noun_battle | noun_commander | subtype | noun_wall_folded

/* @sem ObjectFilter::State(Commander) */
noun_commander ::= "commander"

/* Capitalized Wall folds to an existing word token; inner capitals keep their mark. */
/* @sem ObjectFilter::Subtype(Wall) */
noun_wall_folded ::= "wall" | "↑" "wall"

/* @sem ObjectFilter::CardType(Creature) */
noun_creature ::= "creature"
/* @sem ObjectFilter::CardType(Artifact) */
noun_artifact ::= "artifact"
/* @sem ObjectFilter::CardType(Enchantment) */
noun_enchantment ::= "enchantment"
/* @sem ObjectFilter::CardType(Land) */
noun_land ::= "land"
/* @sem ObjectFilter::CardType(Planeswalker) */
noun_planeswalker ::= "planeswalker"
/* @sem ObjectFilter::Any */
noun_permanent ::= "permanent"
/* @sem ObjectFilter::Token */
noun_token ::= "token"
/* @sem ObjectFilter::AnyOf([ObjectFilter::Subtype(Assassin), ObjectFilter::Subtype(Mercenary), ObjectFilter::Subtype(Pirate), ObjectFilter::Subtype(Rogue), ObjectFilter::Subtype(Warlock)]) */
noun_outlaw ::= "outlaw"
/* @sem ObjectFilter::CardType(Battle) */
noun_battle ::= "battle"

filter_plural ::= plural_everything | filter_plural_type_prefix | contextual_other_filter | filter_plural_tail | filter_plural_adjectives | filter_plural_comma | mined_plural | filter_plural_modified | plural_outlaws | color_outside_commander_identity | filter_each_property_among | filter_plural_except_shared | filter_plural_quantified_three | plural_nonattacker_except_unable | plural_controlled_chosen_name

/* @sem @and($filter_outer_adjectives, $filter_plural) */
filter_plural_adjectives ::= filter_outer_adjectives filter_plural
/* @sem @and($noun_atomic, $typed_plural_tail) */
filter_plural_type_prefix ::= noun_atomic typed_plural_tail
typed_plural_tail ::= typed_plural_head | typed_plural_modified
/* @sem @and($typed_plural_head, $modifiers) */
typed_plural_modified ::= typed_plural_head modifiers
typed_plural_head ::= plural_simple | plural_either | plural_and_or | plural_three | plural_four
plural_simple ::= plural | plural_described
/* @sem @and($adjective, $plural_simple) */
plural_described ::= adjective plural_simple
plural_compound_or ::= plural_compound_or_forward | plural_compound_or_reverse
/* @sem ObjectFilter::AnyOf([@and($noun_atomic, $plural_simple), $plural]) */
plural_compound_or_forward ::= noun_atomic plural_simple "or" plural
/* @sem ObjectFilter::AnyOf([$plural, @and($noun_atomic, $plural_simple)]) */
plural_compound_or_reverse ::= noun_atomic plural_simple "or" plural
/* @sem @and($plural_compound_or, $modifiers) */
plural_compound_or_modified ::= plural_compound_or modifiers

/* @sem @and($quality, $filter_plural) */
filter_plural_comma ::= quality "," filter_plural

filter_plural_tail ::= plural_head | plural_modified | plural_compound_or | plural_compound_or_modified

/* @sem @and($plural_head, $modifiers) */
plural_modified ::= plural_head modifiers

plural_head ::= plural | plural_either | plural_or | plural_and_or | plural_three | plural_four | plural_five

/* @sem ObjectFilter::AnyOf([$plural, $plural_2]) */
plural_or ::= plural "or" plural

/* @sem ObjectFilter::AnyOf([$plural, $plural_2]) */
plural_and_or ::= plural "and" "/" "or" plural

/* @sem ObjectFilter::AnyOf([$plural, $plural_2, $plural_3]) */
plural_three ::= plural "," plural "," union_and plural

/* @sem ObjectFilter::AnyOf([$plural, $plural_2, $plural_3, $plural_4]) */
plural_four ::= plural "," plural "," plural "," union_and plural

/* @sem ObjectFilter::AnyOf(@unordered([$plural, $plural_2])) */
plural_either ::= plural "and" plural

plural ::= plural_atomic | plural_equipped
/* @sem @and($adjective_equipped, $plural_equipped_head) */
plural_equipped ::= adjective_equipped plural_equipped_head
plural_equipped_head ::= plural_atomic | plural_equipped_qualified
/* @sem @and($adjective, $plural_equipped_head) */
plural_equipped_qualified ::= adjective plural_equipped_head

plural_atomic ::= plural_outlaw | plural_creature | plural_artifact | plural_enchantment | plural_land | plural_permanent | plural_planeswalker | subtype_plural | plural_token | plural_commander | subtype_plural

/* @sem ObjectFilter::State(Commander) */
plural_commander ::= "commanders"

/* @sem ObjectFilter::CardType(Creature) */
plural_creature ::= "creatures"
/* @sem ObjectFilter::CardType(Artifact) */
plural_artifact ::= "artifacts"
/* @sem ObjectFilter::CardType(Enchantment) */
plural_enchantment ::= "enchantments"
/* @sem ObjectFilter::CardType(Land) */
plural_land ::= "lands"
/* @sem ObjectFilter::CardType(Planeswalker) */
plural_planeswalker ::= "planeswalkers"
/* @sem ObjectFilter::Any */
plural_permanent ::= "permanents"
/* @sem ObjectFilter::Token */
plural_token ::= "tokens"

adjectives ::= adjective | adjective_either | adjective_and_or

/* @sem ObjectFilter::AnyOf([$quality, $quality_2]) */
adjective_and_or ::= quality "and" "/" "or" quality

/* @sem ObjectFilter::AnyOf(@unordered([$quality, $quality_2])) */
adjective_either ::= quality "or" quality

adjective ::= quality_unscoped | noun_atomic

/* An adjective that is not also a noun, so `or` between two of them is one slot. */
quality ::= quality_unscoped | adjective_equipped
quality_unscoped ::= adjective_transformed | adjective_modified | adjective_party | adjective_face_down | adjective_historic | adjective_outlaw | adjective_non_outlaw | adjective_monocolored | adjective_multicolored | adjective_tapped | adjective_untapped | adjective_attacking | adjective_nonattacking | adjective_blocking | adjective_blocked
    | adjective_noncommander | adjective_nontoken | adjective_legendary | adjective_nonlegendary | adjective_basic | adjective_nonbasic
    | adjective_color | adjective_noncolor | adjective_nontype | subtype_negated
    | adjective_colorless | adjective_snow | adjective_nonsnow | adjective_enchanted | adjective_attacking_or_blocking | adjective_stickered

/* @sem ObjectFilter::State(HasSticker) */
adjective_stickered ::= "stickered"
/* @sem ObjectFilter::Tapped */
adjective_tapped ::= "tapped"
/* @sem ObjectFilter::Not(ObjectFilter::Tapped) */
adjective_untapped ::= "untapped"
/* @sem ObjectFilter::Attacking */
adjective_attacking ::= "attacking"
/* @sem ObjectFilter::Not(Attacking) */
adjective_nonattacking ::= "nonattacking"
/* @sem ObjectFilter::Blocking */
adjective_blocking ::= "blocking"
/* A commander designation is independent of card type and legendary status. */
/* @sem ObjectFilter::Not(ObjectFilter::State(Commander)) */
adjective_noncommander ::= "noncommander"

/* @sem ObjectFilter::Not(ObjectFilter::Token) */
adjective_nontoken ::= "nontoken"
/* @sem ObjectFilter::Supertype(Legendary) */
adjective_legendary ::= "legendary"
/* @sem ObjectFilter::Not(Supertype(Legendary)) */
adjective_nonlegendary ::= "nonlegendary"
/* @sem ObjectFilter::Supertype(Basic) */
adjective_basic ::= "basic"
/* @sem ObjectFilter::Not(ObjectFilter::Supertype(Basic)) */
adjective_nonbasic ::= "nonbasic"

/* @sem ObjectFilter::Property{property:ColorCount, test:NumberTest::Compare{comparison:Equal, value:Expr::Constant(1)}} */
adjective_monocolored ::= "monocolored"
/* @sem ObjectFilter::Property{property:ColorCount, test:NumberTest::Compare{comparison:Greater, value:Expr::Constant(1)}} */
adjective_multicolored ::= "multicolored"
/* @sem ObjectFilter::State(FaceDown) */
adjective_face_down ::= "face-down"
/* @sem ObjectFilter::AnyOf([ObjectFilter::CardType(Artifact), ObjectFilter::Supertype(Legendary), ObjectFilter::Subtype(Saga)]) */
adjective_historic ::= "historic"
/* @sem ObjectFilter::AnyOf([ObjectFilter::Subtype(Assassin), ObjectFilter::Subtype(Mercenary), ObjectFilter::Subtype(Pirate), ObjectFilter::Subtype(Rogue), ObjectFilter::Subtype(Warlock)]) */
adjective_outlaw ::= "outlaw"
/* @sem ObjectFilter::Not(ObjectFilter::AnyOf([ObjectFilter::Subtype(Assassin), ObjectFilter::Subtype(Mercenary), ObjectFilter::Subtype(Pirate), ObjectFilter::Subtype(Rogue), ObjectFilter::Subtype(Warlock)])) */
adjective_non_outlaw ::= "non-outlaw"
/* @sem ObjectFilter::State(Blocked) */
adjective_blocked ::= "blocked"
/* @sem ObjectFilter::Colorless */
adjective_colorless ::= "colorless"
/* @sem ObjectFilter::Supertype(Snow) */
adjective_snow ::= "snow"
/* @sem ObjectFilter::Not(ObjectFilter::Supertype(Snow)) */
adjective_nonsnow ::= "nonsnow"
/* @sem ObjectFilter::State(Enchanted) */
adjective_enchanted ::= "enchanted"
/* @sem ObjectFilter::State(Equipped) */
adjective_equipped ::= "equipped"
/* @sem ObjectFilter::AnyOf([ObjectFilter::Attacking, ObjectFilter::Blocking]) */
adjective_attacking_or_blocking ::= "attacking" "or" "blocking"

adjective_color ::= color_white | color_blue | color_black | color_red | color_green
adjective_noncolor ::= non_white | non_blue | non_black | non_red | non_green
adjective_nontype ::= non_land | non_creature | non_artifact | non_enchantment | non_planeswalker

/* @sem ObjectFilter::Color(White) */
color_white ::= "white"
/* @sem ObjectFilter::Color(Blue) */
color_blue ::= "blue"
/* @sem ObjectFilter::Color(Black) */
color_black ::= "black"
/* @sem ObjectFilter::Color(Red) */
color_red ::= "red"
/* @sem ObjectFilter::Color(Green) */
color_green ::= "green"
/* @sem ObjectFilter::Not(ObjectFilter::Color(White)) */
non_white ::= "nonwhite"
/* @sem ObjectFilter::Not(ObjectFilter::Color(Blue)) */
non_blue ::= "nonblue"
/* @sem ObjectFilter::Not(ObjectFilter::Color(Black)) */
non_black ::= "nonblack"
/* @sem ObjectFilter::Not(ObjectFilter::Color(Red)) */
non_red ::= "nonred"
/* @sem ObjectFilter::Not(ObjectFilter::Color(Green)) */
non_green ::= "nongreen"
/* @sem ObjectFilter::Not(ObjectFilter::CardType(Land)) */
non_land ::= "nonland"
/* @sem ObjectFilter::Not(ObjectFilter::CardType(Creature)) */
non_creature ::= "noncreature"
/* @sem ObjectFilter::Not(ObjectFilter::CardType(Artifact)) */
non_artifact ::= "nonartifact"
/* @sem ObjectFilter::Not(ObjectFilter::CardType(Enchantment)) */
non_enchantment ::= "nonenchantment"
/* @sem ObjectFilter::Not(ObjectFilter::CardType(Planeswalker)) */
non_planeswalker ::= "nonplaneswalker"

modifiers ::= modifier | modifiers_more

/* An attachment consumes its complete object noun phrase. Following ownership
   or control belongs to that object, rather than becoming an outer sibling. */
/* @sem @and($modifier_nonattachment, $modifiers) */
modifiers_more ::= modifier_nonattachment modifiers

modifier ::= modifier_nonattachment | modifier_attached_to | modifier_attached_to_a | modifier_enchanted_by_aura | modifier_except

modifier_nonattachment ::= modifier_mana_value_pair | modifier_nonnumeric | modifier_stat | modifier_stat_x | modifier_base_stat

modifier_nonnumeric ::= modifier_blocked_or_blocked_by_subtype_turn | modifier_has_named_counter | modifier_attacking_you_walkers | modifier_not_exactly_colors | modifier_relative_kind_union | modifier_with_keyword_pair | modifier_chosen_controller | modifier_neither_attacked_nor_entered | modifier_blocking_operand | modifier_blocked_this_combat | modifier_resolving_counterpart | modifier_you_own | modifier_relative_state | modifier_you_control | modifier_not_controlled | modifier_opponent_controls | modifier_with_keyword | modifier_without_keyword | modifier_opponents_control | modifier_player_controls | modifier_they_control | modifier_dealt_damage | modifier_was_dealt_damage | modifier_dealt_damage_this_turn | modifier_counter_on_it | modifier_pt_counter_on_it | modifier_pt_counters_on_them | modifier_chosen_name | modifier_chosen_type | modifier_chosen_color | modifier_kind_sticker | modifier_any_sticker | modifier_same_name | modifier_other_than_self | modifier_counters_on_them | modifier_positive_named_counters | modifier_minus_counter_on_it | modifier_named_counter_on_it | modifier_power_less_than_that | modifier_power_or_toughness | modifier_blocking_self | modifier_blocked_by_self | modifier_blocked_by_it | modifier_dealt_damage_to_you | modifier_not_enchanted | modifier_colored | modifier_entered_since | modifier_entered_this_turn | modifier_shares_color | modifier_shares_type_named | modifier_same_mana_value_as_spell | modifier_stat_compared | modifier_stat_compared_holder | modifier_source_name | modifier_not_named_self | modifier_referenced_name | modifier_banded_with | modifier_with_toxic_family | modifier_named_counters_on_them | modifier_blocked_this_turn | modifier_with_level_up | modifier_shares_card_type | modifier_name_first_printed_in_homelands | modifier_bare_sticker_vowel | modifier_bare_sticker_consonant | modifier_attacking_last_chosen_player | modifier_attacking_enchanted_player | modifier_attacking_your_opponents | modifier_enchanted_or_equipped | modifier_controlled_by_last_choice | modifier_minimum_named_counters_on_them | modifier_draft_noted_self_type | modifier_draft_noted_creature_type | modifier_other_than_enchanted

/* Band membership refers to the explicitly described object; it is neither
   a target nor a new group of creatures chosen by this effect. */
/* @sem ObjectFilter::BandedWith($object_ref) */
modifier_banded_with ::= "banded" "with" object_ref

/* A written card name selects every matching object. It is not an object
   self-reference, and granting this ability does not change the written name. */
/* @sem ObjectFilter::Name(@card_name) */
modifier_source_name ::= "named" SELF_NAME
/* @sem ObjectFilter::Not(ObjectFilter::Name(@card_name)) */
modifier_not_named_self ::= "not" "named" SELF_NAME
/* Another card's written name. */
/* @sem ObjectFilter::Name($referenced_card_name) */
modifier_referenced_name ::= "named" referenced_card_name

/* @sem ObjectFilter::ControlledBy(One(PlayerRef::AbilityController)) */
modifier_you_control ::= "you" "control"
/* @sem ObjectFilter::ControlledBy(OthersThan(PlayerRef::AbilityController)) */
modifier_not_controlled ::= "you" "don't" "control"
/* @sem ObjectFilter::@indefinite_opponent_controller(ObjectFilter::ControlledBy(OpponentsOf(PlayerRef::AbilityController))) */
modifier_opponent_controls ::= ("an" "opponent" "controls")
/* @sem ObjectFilter::HasKeyword($keyword_name) */
modifier_with_keyword ::= "with" keyword_name
/* @sem ObjectFilter::Not(ObjectFilter::HasKeyword($keyword_name)) */
modifier_without_keyword ::= "without" keyword_name

/* Bare and suffix bounds take numerals; an expression uses an explicit
   comparison, as in `with power equal to its toughness`. */
/* @sem ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:$bound, value:Expr::@in_filter($number)}} */
modifier_stat ::= "each"? "with" stat number "or" bound

/* @sem ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:Equal, value:Expr::@in_filter($number)}} */
modifier_stat_x ::= "each"? "with" stat number

/* Base power and toughness as printed or set, before other changes apply. */
modifier_base_stat ::= modifier_base_power | modifier_base_toughness | modifier_base_both | modifier_base_either
/* @sem ObjectFilter::Property{property:BasePower, test:NumberTest::Compare{comparison:Equal, value:Expr::@in_filter($number)}} */
modifier_base_power ::= "with" "base" "power" number
/* @sem ObjectFilter::Property{property:BaseToughness, test:NumberTest::Compare{comparison:Equal, value:Expr::@in_filter($number)}} */
modifier_base_toughness ::= "with" "base" "toughness" number
/* @sem ObjectFilter::AllOf([Property{property:BasePower, test:NumberTest::Compare{comparison:Equal, value:Expr::@in_filter($number)}}, Property{property:BaseToughness, test:NumberTest::Compare{comparison:Equal, value:Expr::@in_filter($number_2)}}]) */
modifier_base_both ::= "with" "base" "power" "and" "toughness" number "/" number
/* @sem ObjectFilter::AnyOf([Property{property:BasePower, test:NumberTest::Compare{comparison:Equal, value:Expr::@in_filter($number)}}, Property{property:BaseToughness, test:NumberTest::Compare{comparison:Equal, value:Expr::@in_filter($number)}}]) */
modifier_base_either ::= "with" "base" "power" "or" "toughness" number

/* @sem ObjectFilter::ControlledBy(OpponentsOf(PlayerRef::AbilityController)) */
modifier_opponents_control ::= "your" "opponents" "control"

/* @sem ObjectFilter::ControlledBy(One($player_ref)) */
modifier_player_controls ::= player_ref "controls"

/* @sem ObjectFilter::ControlledBy(One(@that_player)) */
modifier_they_control ::= "they" "control"
/* @sem ObjectFilter::Chosen(CardName) */
modifier_chosen_name ::= "with" "the" "chosen" "name"

/* "With an art sticker on it" names the kind; "with a sticker on it" any kind. */
/* @sem ObjectFilter::State(Sticker($sticker_kind)) */
modifier_kind_sticker ::= "with" ("a" | "an") sticker_kind "sticker" "on" "it"
/* @sem ObjectFilter::State(HasSticker) */
modifier_any_sticker ::= "with" "a" "sticker" "on" "it"

/* @sem ObjectFilter::Chosen(CreatureType) */
modifier_chosen_type ::= "of" "the" "chosen" "type"
/* @sem ObjectFilter::Chosen(Color) */
modifier_chosen_color ::= "of" "the" "chosen" "color"

/* A stat extreme compares each candidate with that stat over a population.
   The population names its own controller or zone, so a later controller
   phrase cannot attach to the candidate instead. */
/* @sem ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:Equal, value:Expr::Aggregate{objects:$extreme_population, property:$stat, aggregation:$extreme_aggregation}}} */
modifier_extreme_among ::= "with" "the" extreme_aggregation stat "among" extreme_population
extreme_aggregation ::= extreme_maximum | extreme_minimum
/* @sem Aggregation::Maximum */
extreme_maximum ::= "greatest" | "highest"
/* @sem Aggregation::Minimum */
extreme_minimum ::= "least" | "lowest"
extreme_population ::= extreme_controlled | extreme_battlefield | card_population
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($plural_head, $extreme_controller)} */
extreme_controlled ::= plural_head extreme_controller
extreme_controller ::= modifier_you_control | modifier_not_controlled | modifier_opponents_control | modifier_player_controls | modifier_they_control
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$plural_head} */
extreme_battlefield ::= plural_head "on" "the" "battlefield"

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Damage(DamageEvent{source_kind:Any, sources:Any, recipients:Objects(SameObject(ObjectRef::Candidate)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}) */
modifier_was_dealt_damage ::= "that" ("was" | "has" "been") "dealt" "damage" "this" "turn"

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Damage(DamageEvent{source_kind:Any, sources:Any, recipients:Objects(SameObject(ObjectRef::Candidate)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}) */
modifier_dealt_damage ::= "dealt" "damage" "this" "turn"

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Damage(DamageEvent{source_kind:Permanent, sources:SameObject($object_ref), recipients:Objects(SameObject(ObjectRef::Candidate)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}) */
modifier_dealt_damage_by ::= "dealt" "damage" "by" object_ref "this" "turn"

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Damage(DamageEvent{source_kind:Any, sources:ControlledBy(One(PlayerRef::AbilityController)), recipients:Objects(SameObject(ObjectRef::Candidate)), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}) */
modifier_dealt_damage_by_yours ::= "dealt" "damage" "this" "turn" "by" "a" "source" "you" "controlled"

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Damage(DamageEvent{source_kind:Permanent, sources:SameObject(ObjectRef::Candidate), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Source}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}) */
modifier_dealt_damage_this_turn ::= "that" "dealt" "damage" "this" "turn"

/* @sem ObjectFilter::AttachedTo(SameObject($object_ref)) */
modifier_attached_to ::= "attached" "to" object_ref

/* @sem ObjectFilter::AttachedTo(InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase})) */
modifier_attached_to_a ::= "attached" "to" ("a" | "an") filter_phrase

modifier_same_name ::= modifier_same_name_that | modifier_same_name_explicit

/* @sem ObjectFilter::SharesNameWith(@pump_name_ref(ObjectRef::@named_object)) */
modifier_same_name_that ::= "with" "the" "same" "name" "as" that_noun_word

/* An explicit self/name is independent of the per-member contrast. */
/* @sem ObjectFilter::SharesNameWith($self_ref) */
modifier_same_name_explicit ::= "with" "the" "same" "name" "as" self_ref

/* @sem () */
that_noun_word ::= "that" ("creature" | "permanent" | "artifact" | "enchantment" | "land")

/* @sem ObjectFilter::Counters{kind:PowerToughness(-1, -1), comparison:Greater, value:Expr::Constant(0)} */
modifier_minus_counter_on_it ::= "with" "a" "-" "1" "/" "-" "1" "counter" "on" "it"

/* @sem ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:Less, value:Expr::ObjectProperty{object:$it_possessive, property:$stat_2, information:CurrentOrLastKnown}}} */
modifier_power_less_than_that ::= "with" stat "less" "than" it_possessive stat

/* @sem ObjectFilter::AnyOf([ObjectFilter::Property{property:Power, test:NumberTest::Compare{comparison:$bound, value:$number}}, ObjectFilter::Property{property:Toughness, test:NumberTest::Compare{comparison:$bound, value:$number}}]) */
modifier_power_or_toughness ::= "with" "power" "or" "toughness" number "or" bound

/* Combat relation information is captured in an announced target filter.
   Keep this phrase out of resolving battlefield sweeps: after a death event,
   their current-card view would name the new graveyard object. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($filter_phrase, $combat_counterpart_filter)}), index:0} */
target_combat_counterpart ::= "target" filter_phrase combat_counterpart_filter

/* Both directed relations name the same written object. Canonical order is
   BlockedByObject before BlockingObject, independently of word order. */
combat_counterpart_filter ::= combat_counterpart_self | combat_counterpart_it

/* @sem ObjectFilter::AnyOf([BlockedByObject($self_explicit_ref), BlockingObject($self_explicit_ref)]) */
combat_counterpart_self ::= "blocking" "or" "blocked" "by" self_explicit_ref

/* Announcement information preserves the antecedent's pre-effect identity. */
/* @sem ObjectFilter::AnyOf([BlockedByObject(@it), BlockingObject(@it)]) */
combat_counterpart_it ::= "blocking" "or" "blocked" "by" "it"

/* Relative pronouns name the preceding object; explicit names keep holder binding. */
/* @sem ObjectFilter::BlockingObject(@current_it) */
modifier_blocking_self ::= "blocking" "it"

/* @sem ObjectFilter::BlockedByObject($self_explicit_ref) */
modifier_blocked_by_self ::= self_explicit_ref "is" "blocking"

/* @sem ObjectFilter::BlockedByObject(@current_it) */
modifier_blocked_by_it ::= "it's" "blocking"

/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Damage(DamageEvent{source_kind:Permanent, sources:SameObject(ObjectRef::Candidate), recipients:Players(One(PlayerRef::AbilityController)), kind:Any, grouping:SourceRecipient, subject:Source}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}) */
modifier_dealt_damage_to_you ::= "that" "dealt" "damage" "to" "you" "this" "turn"

/* @sem ObjectFilter::Not(ObjectFilter::State(Enchanted)) */
modifier_not_enchanted ::= "that" ("aren't" | "isn't") "enchanted"

/* @sem ObjectFilter::Not(ObjectFilter::Colorless) */
modifier_colored ::= "that's" "one" "or" "more" "colors"

/* @sem ObjectFilter::History{event:Entered, window:SinceLastTurnOf(AbilityController)} */
modifier_entered_since ::= "that" "entered" "since" "your" "last" "turn" "ended"

/* An object that entered the battlefield this turn, under anyone's control. */
/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:ZoneChange{objects:SameObject(ObjectRef::Candidate), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}) */
modifier_entered_this_turn ::= "that" "entered" ("the" "battlefield")? "this" "turn"

/* @sem ObjectFilter::Shares{property:Colors, with:@it} */
modifier_shares_color ::= "that" "shares" "a" "color" "with" "it"

/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:Expr::ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}} */
modifier_same_mana_value_as_spell ::= "with" "that" "spell's" "mana" "value"

/* The exception owns its complete qualified population and is terminal in
   the outer modifier chain. Following qualifiers remain inside the negation. */
/* @sem ObjectFilter::Not($filter_plural) */
modifier_except ::= "except" "for" filter_plural

/* @sem ObjectFilter::Counters{comparison:Greater, value:Expr::Constant(0)} */
modifier_counters_on_them ::= "with" "counters" "on" "them"

/* @sem ObjectFilter::Counters{comparison:Greater, value:Expr::Constant(0)} */
modifier_counter_on_it ::= "with" "a" "counter" "on" "it"

/* Counter quantities are integers; one or more is the canonical positive test. */
/* @sem ObjectFilter::Counters{kind:$counter_kind, comparison:Greater, value:Expr::Constant(0)} */
modifier_positive_named_counters ::= "with" "one" "or" "more" counter_kind "counters" "on" ("it" | "them")

/* @sem ObjectFilter::Counters{kind:$counter_kind, comparison:Greater, value:Expr::Constant(0)} */
modifier_named_counter_on_it ::= "with" "a" counter_kind "counter" "on" "it"

/* @sem ObjectFilter::Counters{kind:PowerToughness(1, 1), comparison:Greater, value:Expr::Constant(0)} */
modifier_pt_counter_on_it ::= "with" "a" "+" "1" "/" "+" "1" "counter" "on" "it"
/* @sem ObjectFilter::Counters{kind:PowerToughness(1, 1), comparison:Greater, value:Expr::Constant(0)} */
modifier_pt_counters_on_them ::= "with" "+" "1" "/" "+" "1" "counters" "on" "them"

stat ::= stat_power | stat_toughness | stat_mana_value | stat_total_power_toughness

/* @sem Property::Power */
stat_power ::= "power"
/* @sem Property::Toughness */
stat_toughness ::= "toughness"
/* @sem Property::ManaValue */
stat_mana_value ::= "mana" "value"
/* @sem Property::TotalPowerAndToughness */
stat_total_power_toughness ::= "total" "power" "and" "toughness"

bound ::= bound_less | bound_greater

/* @sem Comparison::LessOrEqual */
bound_less ::= "less"
/* @sem Comparison::GreaterOrEqual */
bound_greater ::= "greater"

/* Players. */
players_singular ::= players_coin_tails | players_empty_hand | players_unqualified_singular | players_voted_same | players_voted_different | players_chosen_extreme_life

/* A Curse's player: the player this Aura enchants. */
/* @sem PlayerSet::One(PlayerRef::EnchantedBy(ObjectRef::Source)) */
players_enchanted ::= "enchanted" "player"

/* Friend or foe: the players chosen as friends, or as foes, by the ability's controller. */
/* @sem PlayerSet::Matching{binding:0, condition:VotedFor{player:Bound(0), option:Word(Friend)}} */
players_each_friend ::= "each" "friend"
/* @sem PlayerSet::Matching{binding:0, condition:VotedFor{player:Bound(0), option:Word(Foe)}} */
players_each_foe ::= "each" "foe"

/* @sem PlayerSet::Intersection([OthersThan(@other_party), OpponentsOf(PlayerRef::AbilityController)]) */
players_each_other_opponent ::= "each" "other" "opponent"

/* @sem PlayerSet::OthersThan(@other_party) */
players_each_other ::= "each" "other" "player"

/* @sem PlayerSet::One(PlayerRef::PlayerOrControllerOf(Targets(@last_slot))) */
players_or_controller ::= "that" "player" "or" "that" "planeswalker's" "controller"

/* @sem PlayerSet::One($player_ref) */
player_one ::= player_ref

player_ref ::= active_player_ref | mined_player | target_player | target_opponent | that_player | defending_player | its_controller | its_owner | target_player_dealt | stack_controller | history_damage_controller | explicit_object_controller | explicit_object_owner
    | attacking_player | damage_source_controller

/* "That source's controller": the controller of the event's damage source. */
/* @sem PlayerRef::ControllerOf(EventSubject) */
damage_source_controller ::= "that" "source's" "controller"

its_owner ::= its_owner_pronoun | its_owner_named
/* @sem PlayerRef::OwnerOf(@damage_relative_object) */
its_owner_pronoun ::= "its" "owner"
/* @sem PlayerRef::OwnerOf(@it) */
its_owner_named ::= "that" ("creature's" | "permanent's" | "artifact's" | "enchantment's" | "land's") "owner"

/* @sem PlayerRef::ControllerOf($object_ref) */
explicit_object_controller ::= "the" "controller" "of" object_ref

/* An edited owner can name an object different from the damage source. */
/* @sem PlayerRef::OwnerOf($object_ref) */
explicit_object_owner ::= "the" "owner" "of" object_ref

/* @sem PlayerRef::AttackingPlayer */
attacking_player ::= "attacking" "player"

that_player ::= that_player_word | that_opponent

/* @sem PlayerRef::@that_player_literal */
that_player_word ::= "that" "player"

/* @sem PlayerRef::@that_opponent */
that_opponent ::= "that" "opponent"

/* @sem @defending */
defending_player ::= "defending" "player"

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Expr::Constant(1)), filter:Any, players:Matching{binding:0, condition:Compare{left:EventHistory{event:Damage(DamageEvent{source_kind:Permanent, sources:SameObject(ObjectRef::Source), recipients:Players(One(Bound(0))), kind:Any, grouping:SourceRecipient, subject:Recipient}), window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}}}), index:0} */
target_player_dealt ::= "target" "player" "dealt" "damage" "by" self_text "this" "turn"

/* @sem @that_player */
stack_controller ::= "that" "spell" "or" "ability's" "controller"

its_controller ::= its_controller_pronoun | its_controller_named | its_controller_spell

/* @sem PlayerRef::ControllerOf(@damage_relative_object) */
its_controller_pronoun ::= "its" "controller"

/* @sem PlayerRef::ControllerOf(@named_object) */
its_controller_named ::= "that" ("creature's" | "permanent's" | "artifact's" | "enchantment's" | "land's") "controller"

/* @sem PlayerRef::ControllerOf($spell_possessive) */
its_controller_spell ::= spell_possessive "controller"

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Expr::Constant(1)), filter:Any, players:All}), index:0} */
target_player ::= "target" "player"

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Expr::Constant(1)), filter:Any, players:OpponentsOf(PlayerRef::AbilityController)}), index:0} */
target_opponent ::= "target" "opponent"

/* @sem PlayerSet::OpponentsOf(PlayerRef::AbilityController) */
players_each_opponent ::= "each" "opponent" | "each" "of" "your" "opponents"

/* @sem PlayerSet::All */
players_each ::= "each" "player"

/* Damage recipients. */
recipients ::= recipients_attacked_player_target | mined_recipients | recipients_each_and_each | recipients_any_target | recipients_player_or_walker | recipients_opponent_or_walker | recipients_each | recipients_objects | recipients_players | recipients_you | recipients_both | recipients_many | recipients_them | recipients_attacked | recipients_opponents_and_theirs | recipients_player_and_theirs | recipients_opponent_and_theirs | recipients_objects_and_players | recipients_token_player_walker | recipients_player_or_battle | recipients_target_and_each_other | recipients_any_target_opponent_choice | recipients_each_opponents_pair | recipients_target_opponent_controls | recipients_opponent_or_two_controlled | recipients_target_spell_controller | recipients_target_described_spell_controller

/* @sem Recipients::Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([$filter_phrase, $filter_phrase_2])}) */
recipients_each_and_each ::= "each" filter_phrase "and" "each" filter_phrase

/* @sem Recipients::Union([Objects(One($target_object)), Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$others_each})]) */
recipients_target_and_each_other ::= target_object "and" others_each

/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Expr::Constant(1)), filter:AnyOf([@and($noun, ObjectFilter::Token), CardType(Planeswalker)]), players:All})) */
recipients_token_player_walker ::= "target" noun "token" "," "player" "," "or" "planeswalker"

/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Expr::Constant(1)), filter:CardType(Battle), players:All})) */
recipients_player_or_battle ::= "target" "player" "or" "battle"

/* @sem Recipients::Union([Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Expr::Constant(1)), filter:CardType(Planeswalker), players:All})), Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_head, ObjectFilter::ControlledBy(One(PlayerRef::PlayerOrControllerOf(Targets(@last_slot)))))})]) */
recipients_player_and_theirs ::= "target" "player" "or" "planeswalker" "and" "each" filter_head "that" "player" "or" "that" "planeswalker's" "controller" "controls"
/* @sem Recipients::Union([Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Expr::Constant(1)), filter:CardType(Planeswalker), players:OpponentsOf(AbilityController)})), Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_head, ObjectFilter::ControlledBy(One(PlayerRef::PlayerOrControllerOf(Targets(@last_slot)))))})]) */
recipients_opponent_and_theirs ::= "target" "opponent" "or" "planeswalker" "and" "each" filter_head "that" "player" "or" "that" "planeswalker's" "controller" "controls"

/* @sem Recipients::Union([Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}), Players(All)]) */
recipients_objects_and_players ::= "each" filter_phrase "and" "each" "player"

/* @sem Recipients::Players(One(@that_player)) */
recipients_them ::= "them"

/* @sem Recipients::AttackedBy(@it) */
recipients_attacked ::= "the" "player" "or" "planeswalker" ("it's" | "that" "creature" "is") "attacking"

/* @sem Recipients::Union([Players(OpponentsOf(PlayerRef::AbilityController)), Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_head, ObjectFilter::ControlledBy(OpponentsOf(PlayerRef::AbilityController)))})]) */
recipients_opponents_and_theirs ::= "each" "opponent" "and" "each" filter_head "they" "control"

/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Expr::Constant(1)), filter:CardType(Planeswalker), players:OpponentsOf(PlayerRef::AbilityController)})) */
recipients_opponent_or_walker ::= "target" "opponent" "or" "planeswalker"

/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:$target_count_any, filter:Any})) */
recipients_many ::= ("each" "of")? target_count_any "targets"

/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Expr::Constant(1)), filter:Any})) */
recipients_any_target ::= "any" "target"

/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:$player_walker_target_count, filter:CardType(Planeswalker), players:All})) */
recipients_player_or_walker ::= player_walker_target_count "player" "or" "planeswalker"
player_walker_target_count ::= player_walker_required | player_walker_optional
/* @sem Count::Exactly(Expr::Constant(1)) */
player_walker_required ::= "target"
/* @sem Count::UpTo(Expr::Constant(1)) */
player_walker_optional ::= "up" "to" ("one" | "1") "target"

/* @sem Recipients::Objects($object_set) */
recipients_objects ::= object_set

/* Damage goes to `each`; destruction takes `all`. */
/* @sem Recipients::Objects(ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}) */
recipients_each ::= "each" filter_phrase

/* @sem Recipients::Players($players_singular) */
recipients_players ::= players_singular

/* @sem Recipients::Players(One(PlayerRef::AbilityController)) */
recipients_you ::= "you"

/* @sem Recipients::Union([$recipients_part, $recipients_part_2]) */
recipients_both ::= recipients_part "and" recipients_part

recipients_part ::= recipients_objects | recipients_players


/* Created tokens are one result set, even when Oracle uses a singular pronoun. */
/* An ordinary plural reference keeps the focused target slot or the matched
   event's object batch. It never falls back to a stale target across creation. */
group_reference ::= group_pronoun | group_each_of_them | group_creatures | group_permanents | group_artifacts | group_lands | group_enchantments
/* @sem ObjectSet::@group_reference(ObjectKind::Any, ObjectFilter::Any) */
group_pronoun ::= "them"
/* @sem ObjectSet::@group_reference(ObjectKind::Any, ObjectFilter::Any) */
group_each_of_them ::= "each" "of" "them"
/* @sem ObjectSet::@group_reference(ObjectKind::Any, ObjectFilter::Any) */
group_subject ::= "they"
/* @sem $those_creatures */
group_creatures ::= ("each" "of")? those_creatures
/* @sem ObjectSet::@group_reference(ObjectKind::Permanent, ObjectFilter::CardType(Creature)) */
those_creatures ::= "those" "creatures"
/* @sem ObjectSet::@group_reference(ObjectKind::Permanent, ObjectFilter::Any) */
group_permanents ::= "those" "permanents"
/* @sem ObjectSet::@group_reference(ObjectKind::Permanent, ObjectFilter::CardType(Artifact)) */
group_artifacts ::= "those" "artifacts"
/* @sem ObjectSet::@group_reference(ObjectKind::Permanent, ObjectFilter::CardType(Land)) */
group_lands ::= "those" "lands"
/* @sem ObjectSet::@group_reference(ObjectKind::Permanent, ObjectFilter::CardType(Enchantment)) */
group_enchantments ::= "those" "enchantments"

created_reference ::= created_singular_reference | created_group_reference | created_batch_reference | created_named_reference
created_singular_reference ::= created_ordinary_singular | created_reflexive_singular
/* @sem ObjectSet::@created_reference_single */
created_ordinary_singular ::= "it"
/* @sem ObjectSet::@literal_damage_itself_objects(ObjectSet::@created_reference_single) */
created_reflexive_singular ::= "itself"
/* @sem ObjectSet::@created_reference */
created_group_reference ::= "them" | "they" | "those" "creatures" | "those" "permanents"

/* Explicit token nouns keep the named batch when another operand takes focus. */
/* @sem ObjectSet::@created_batch_reference */
created_batch_reference ::= "those" "tokens"
/* @sem ObjectSet::@created_named_reference */
created_named_reference ::= ("that" | "the") "token"

/* @sem ObjectRef::@qualified_object(ObjectKind::Permanent, ObjectFilter::CardType(Creature)) */
named_creature ::= ("that" | "the" "other") "creature"

/* @sem ObjectRef::@qualified_object(ObjectKind::Permanent, ObjectFilter::Any) */
named_permanent ::= ("that" | "the" "other") "permanent"

/* @sem ObjectRef::@qualified_object(ObjectKind::Permanent, ObjectFilter::CardType(Artifact)) */
named_artifact ::= ("that" | "the" "other") "artifact"

/* @sem ObjectRef::@qualified_object(ObjectKind::Permanent, ObjectFilter::CardType(Enchantment)) */
named_enchantment ::= ("that" | "the" "other") "enchantment"

/* @sem ObjectRef::@qualified_object(ObjectKind::Permanent, ObjectFilter::CardType(Land)) */
named_land ::= ("that" | "the" "other") "land"

/* @sem ObjectRef::@qualified_object(ObjectKind::Spell, ObjectFilter::Any) */
named_spell ::= ("that" | "the" "other") "spell"

/* @sem ObjectRef::@qualified_object(ObjectKind::Permanent, ObjectFilter::CardType(Planeswalker)) */
named_planeswalker ::= ("that" | "the" "other") "planeswalker"

/* "That creature or planeswalker" names the earlier "target creature or planeswalker". */
/* @sem ObjectRef::@qualified_object(ObjectKind::Permanent, ObjectFilter::AnyOf([CardType(Creature), CardType(Planeswalker)])) */
named_creature_or_planeswalker ::= "that" "creature" "or" "planeswalker"

/* @sem ObjectRef::@qualified_object(ObjectKind::Permanent, ObjectFilter::Subtype(Equipment)) */
named_equipment ::= ("that" | "the" "other") "Equipment"

/* @sem ObjectRef::@qualified_object(ObjectKind::Permanent, ObjectFilter::Subtype(Aura)) */
named_aura ::= ("that" | "the" "other") "Aura"

/* @sem ObjectRef::@qualified_object(ObjectKind::Permanent, ObjectFilter::Subtype(Vehicle)) */
named_vehicle ::= ("that" | "the" "other") "Vehicle"

/* A qualified action recipient names a full creation result, not index zero. */
/* @sem ObjectSet::@qualified_members($that_noun) */
qualified_set ::= that_noun

/* @sem ObjectRef::@qualified_object(ObjectKind::Permanent, ObjectFilter::Subtype(@subtype_name($subtype))) */
named_subtype ::= ("that" | "the" "other") subtype

/* Target constraints name announced objects, even when written after an effect. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:@and($filter_phrase, ObjectFilter::Not(ObjectFilter::SameObject($that_noun)))}), index:0} */
target_excluding_named ::= "target" filter_phrase "other" "than" that_noun

/* A later card-group phrase names the draft output, not token creation. */
drafted_cards_reference ::= drafted_cards_pronoun | drafted_cards_explicit
/* @sem ObjectSet::@drafted_reference */
drafted_cards_pronoun ::= "them"
/* @sem ObjectSet::@drafted_reference_explicit */
drafted_cards_explicit ::= "those" "cards"


/* The native mixed-zone constructor names physical spell/permanent objects.
   This descriptor is exposed only by actions valid in both zones. Color/text
   actions retain their implied modes and different spell/permanent operations. */
target_spell_or_noun ::= target_spell_or_controlled_permanent | target_spell_or_permanent | target_spell_or_typed_permanent
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Any, zones:[Stack, Battlefield]}), count:Exactly(Constant(1)), filter:Any}), index:0} */
target_spell_or_permanent ::= "target" "spell" "or" "permanent"
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Any, zones:[Stack, Battlefield]}), count:Exactly(Constant(1)), filter:AnyOf([@and(ObjectFilter::InZone(Shared(Battlefield)), $mixed_permanent_noun), InZone(Shared(Stack))])}), index:0} */
target_spell_or_typed_permanent ::= "target" "spell" "or" mixed_permanent_noun
/* No shared trailing modifier is inferred from this bare noun spelling. */
mixed_permanent_noun ::= noun_creature | noun_artifact | noun_enchantment | noun_land | noun_planeswalker | noun_battle | noun_token | noun_commander | noun_outlaw | subtype | noun_wall_folded

/* Relative state clauses reuse complete state predicates. Color lists have
   their own coordination contracts and cannot end after one color here. */
/* @sem ObjectFilter::$relative_state_quality */
modifier_relative_state ::= ("that's" | "that" "is" | "that" "are") relative_state_quality

relative_state_quality ::= adjective_attacking_or_blocking | adjective_tapped | adjective_untapped | adjective_attacking
    | adjective_nonattacking | adjective_blocking | adjective_blocked
    | adjective_enchanted | adjective_equipped | attacking_defender
/* @sem ObjectFilter::AttackingDefender(Players(One($player_ref))) */
attacking_defender ::= "attacking" player_ref

/* Ownership is independent of battlefield control, including granted abilities. */
/* @sem ObjectFilter::OwnedBy(One(AbilityController)) */
modifier_you_own ::= "you" "own"

/* An explicit exclusion preserves its own object, independently of a Pump's
   lexical other/current-member annotation. */
/* @sem ObjectFilter::Not(SameObject($self_ref)) */
modifier_other_than_self ::= "other" "than" self_ref

/* The trailing controller restricts both physical alternatives; the permanent
   adjective stays confined to the battlefield branch. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Any, zones:[Stack, Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::ControlledBy($mixed_target_controller), ObjectFilter::AnyOf([@and(ObjectFilter::InZone(Shared(Battlefield)), $mixed_controlled_permanent), InZone(Shared(Stack))]))}), index:0} */
target_spell_or_controlled_permanent ::= "target" "spell" "or" mixed_controlled_permanent mixed_target_controller

mixed_controlled_permanent ::= mixed_controlled_adjective | mixed_permanent_noun
/* @sem $adjective_nontype */
mixed_controlled_adjective ::= adjective_nontype "permanent"

/* @sem PlayerSet::OpponentsOf(AbilityController) */
mixed_target_opponent ::= ("an" | "one") "opponent" "controls"
/* @sem PlayerSet::One(AbilityController) */
mixed_target_you ::= "you" "control"

mixed_target_controller ::= mixed_target_opponent | mixed_target_you

/* A callback target counts its actual performed action's pre-action objects,
   independently of callback/body result allocation and target cardinality. */
/* @sem Count::UpTo(CountObjects(Transition{result:@reflexive_performed, phase:Before})) */
target_receipt_up_to ::= "up" "to" "that" "many"

/* The candidate is a blocker of the explicitly named or targeted attacker. */
/* @sem ObjectFilter::BlockingObject($combat_blocking_operand) */
modifier_blocking_operand ::= ("that's" | "that" "is")? "blocking" combat_blocking_operand
combat_blocking_operand ::= target_object | self_explicit_ref | combat_context_it

/* Current relation union; the explicit holder/name remains its own reference. */
/* @sem ObjectFilter::AnyOf([BlockingObject($self_explicit_ref), BlockedByObject($self_explicit_ref)]) */
modifier_resolving_counterpart ::= "blocking" "or" "blocked" "by" self_explicit_ref

/* The candidate was an attacker blocked by the named blocker this combat. */
/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Pair{event:BecomesBlockedBy, objects:SameObject(ObjectRef::Candidate), others:SameObject($object_ref)}, window:ThisCombat, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
modifier_blocked_this_combat ::= "that" "were" "blocked" "by" object_ref "this" "combat"

/* A characteristic relation reads its antecedent, including death-event LKI. */
/* @sem ObjectFilter::Shares{property:CreatureTypes, with:$object_ref} */
modifier_shares_creature_type ::= "that" ("share" | "shares") "a" "creature" "type" "with" object_ref

/* "Each creature you control that shares a creature type with the exiled card": a
   relation to an explicit antecedent. A pronoun's antecedent stays with the frames
   that name it, such as "target creature and each other creature that shares a
   creature type with it". */
/* @sem ObjectFilter::Shares{property:CreatureTypes, with:$shared_type_antecedent} */
modifier_shares_type_named ::= "that" ("share" | "shares") "a" "creature" "type" "with" shared_type_antecedent

shared_type_antecedent ::= linked_exiled_card | self_explicit_ref

/* A shared-type query composes ordinary positive noun descriptions. Literal
   other has its own contrast contract and is not introduced by this query. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($sharing_query_filter, $modifier_shares_creature_type)} */
objects_all_sharing ::= "all" sharing_query_filter modifier_shares_creature_type

sharing_query_filter ::= filter_plural_tail | sharing_query_adjectives
/* @sem @and($adjectives, $sharing_query_filter) */
sharing_query_adjectives ::= adjectives sharing_query_filter

/* A pure five-subtype disjunction is shared by the negative creature filter
   and the existing singular attack event. Capitals remain spelling metadata. */
/* @sem ObjectFilter::@and(ObjectFilter::CardType(Creature), ObjectFilter::Not($five_subtype_union)) */
creature_not_five_subtypes ::= "creature" "that" "isn't" ("a" | "an") five_subtype_union
/* @sem ObjectFilter::AnyOf([$subtype_spelled, $subtype_spelled_2, $subtype_spelled_3, $subtype_spelled_4, $subtype_spelled_5]) */
five_subtype_union ::= subtype_spelled "," subtype_spelled "," subtype_spelled "," subtype_spelled "," "or" subtype_spelled
subtype_spelled ::= subtype | subtype_marked_kraken | subtype_marked_leviathan | subtype_marked_merfolk
/* @sem ObjectFilter::Subtype(Kraken) */
subtype_marked_kraken ::= "↑" "kraken"
/* @sem ObjectFilter::Subtype(Leviathan) */
subtype_marked_leviathan ::= "↑" "leviathan"
/* @sem ObjectFilter::Subtype(Merfolk) */
subtype_marked_merfolk ::= "↑" "merfolk"

/* Shared-head prototype: exactly bare or one leading tapped qualifier. */
head_subtype ::= subtype | noun_wall_folded
head_non_subtype_atomic ::= noun_creature | head_non_subtype_noncreature
head_non_subtype_noncreature ::= noun_outlaw | noun_artifact | noun_enchantment | noun_land
    | noun_planeswalker | noun_permanent | noun_token | noun_battle | noun_commander
head_non_subtype_noun ::= head_non_subtype_atomic | noun_equipped
head_adjective_not_subtype ::= quality_unscoped | head_non_subtype_atomic
head_adjective_not_tapped ::= head_quality_not_tapped | noun_atomic
head_quality_not_tapped ::= adjective_face_down | adjective_historic | adjective_outlaw | adjective_non_outlaw | adjective_monocolored | adjective_multicolored | adjective_untapped | adjective_attacking | adjective_nonattacking | adjective_blocking | adjective_blocked | adjective_noncommander | adjective_nontoken | adjective_legendary | adjective_nonlegendary | adjective_basic | adjective_nonbasic | adjective_color | adjective_noncolor | adjective_nontype | subtype_negated | adjective_colorless | adjective_snow | adjective_nonsnow | adjective_enchanted | adjective_attacking_or_blocking

/* Exact complement of filter_described = adjective filter_simple,
   excluding only subtype + bare Creature. */
head_right_not_shared ::= head_right_other_adjective | head_right_other_noun
/* @sem @and($head_adjective_not_subtype, $filter_simple) */
head_right_other_adjective ::= head_adjective_not_subtype filter_simple
/* @sem @and($head_subtype, $head_simple_not_creature) */
head_right_other_noun ::= head_subtype head_simple_not_creature
head_simple_not_creature ::= noun_noncreature | noun_equipped | filter_described
/* @sem @and($head_subtype, $noun_creature) */
head_right_shared ::= head_subtype noun_creature

/* Exact complement of filter_simple excluding bare subtype or tapped subtype.
   Multiple adjectives and independently written type heads retain old meanings. */
head_left_independent ::= head_non_subtype_noun | head_left_long
    | head_left_other_noun | head_left_other_adjective
/* @sem @and($adjective, $filter_described) */
head_left_long ::= adjective filter_described
/* @sem @and($adjective, $head_non_subtype_noun) */
head_left_other_noun ::= adjective head_non_subtype_noun
/* @sem @and($head_adjective_not_tapped, $head_subtype) */
head_left_other_adjective ::= head_adjective_not_tapped head_subtype

head_list_unshared_right ::= head_list_unshared_right_forward | head_list_unshared_right_reverse
/* @sem ObjectFilter::AnyOf([$filter_simple, $head_right_not_shared]) */
head_list_unshared_right_forward ::= filter_simple "or" head_right_not_shared
/* @sem ObjectFilter::AnyOf([$head_right_not_shared, $filter_simple]) */
head_list_unshared_right_reverse ::= filter_simple "or" head_right_not_shared
head_list_independent_left ::= head_list_independent_left_forward | head_list_independent_left_reverse
/* @sem ObjectFilter::AnyOf([$head_left_independent, $head_right_shared]) */
head_list_independent_left_forward ::= head_left_independent "or" head_right_shared
/* @sem ObjectFilter::AnyOf([$head_right_shared, $head_left_independent]) */
head_list_independent_left_reverse ::= head_left_independent "or" head_right_shared
head_list_unshared_right_modified ::= head_list_unshared_right_modified_forward | head_list_unshared_right_modified_reverse
/* @sem @and(ObjectFilter::AnyOf([$filter_simple, $head_right_not_shared]), $modifiers) */
head_list_unshared_right_modified_forward ::= filter_simple "or" head_right_not_shared modifiers
/* @sem @and(ObjectFilter::AnyOf([$head_right_not_shared, $filter_simple]), $modifiers) */
head_list_unshared_right_modified_reverse ::= filter_simple "or" head_right_not_shared modifiers
head_list_independent_left_modified ::= head_list_independent_left_modified_forward | head_list_independent_left_modified_reverse
/* @sem @and(ObjectFilter::AnyOf([$head_left_independent, $head_right_shared]), $modifiers) */
head_list_independent_left_modified_forward ::= head_left_independent "or" head_right_shared modifiers
/* @sem @and(ObjectFilter::AnyOf([$head_right_shared, $head_left_independent]), $modifiers) */
head_list_independent_left_modified_reverse ::= head_left_independent "or" head_right_shared modifiers

head_shared_creature ::= head_shared_creature_forward | head_shared_creature_reverse
/* @sem @and(ObjectFilter::CardType(Creature), ObjectFilter::AnyOf([$head_subtype, $head_subtype_2])) */
head_shared_creature_forward ::= head_subtype "or" head_subtype "creature"
/* @sem @and(ObjectFilter::CardType(Creature), ObjectFilter::AnyOf([$head_subtype_2, $head_subtype])) */
head_shared_creature_reverse ::= head_subtype "or" head_subtype "creature"
/* @sem @and(ObjectFilter::Tapped, $head_shared_creature) */
head_shared_tapped_creature ::= "tapped" head_shared_creature
/* @sem @and($head_shared_creature, $modifiers) */
head_shared_creature_modified ::= head_shared_creature modifiers
/* @sem @and($head_shared_tapped_creature, $modifiers) */
head_shared_tapped_creature_modified ::= head_shared_tapped_creature modifiers

/* A negative occurrence condition is independent of the counter amount. */
/* @sem ObjectFilter::AllOf([Condition(Not(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})), Condition(Not(Compare{left:EventHistory{event:ZoneChange{objects:SameObject(Candidate), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}))]) */
modifier_neither_attacked_nor_entered ::= "that" "didn't" "attack" "or" "enter" "this" "turn"

/* @sem ObjectFilter::Property{property:ColorCount, test:NumberTest::Compare{comparison:Equal, value:$number}} */
filter_exact_color_count ::= "that's" "exactly" number "colors"

/* Party is a union of the four stated creature subtypes, for cards and spells
   as well as battlefield objects. It is not a party-size query. */
/* @sem ObjectFilter::AnyOf([Subtype(Cleric), Subtype(Rogue), Subtype(Warrior), Subtype(Wizard)]) */
adjective_party ::= "party"

/* The chosen player is persistent choice information, independently of the
   controller of the permanent whose ability contains this selector. */
/* @sem ObjectFilter::ControlledBy(One(Chosen)) */
modifier_chosen_controller ::= "the" "chosen" "player" "controls"

/* @sem ObjectFilter::Subtype(Room) */
noun_room ::= "Room"

/* A creature with both abilities is counted once by this disjunction. */
/* @sem ObjectFilter::AnyOf(@unordered([HasKeyword($keyword_name), HasKeyword($keyword_name_2)])) */
modifier_with_keyword_pair ::= "with" keyword_name "or" keyword_name

/* @sem ObjectRef::@current_it */
combat_context_it ::= "it"

/* Explicit inclusive-or kind restrictions describe one candidate population. */
/* @sem ObjectFilter::AnyOf([$plural_atomic, $plural_atomic_2]) */
modifier_relative_kind_union ::= "that" "are" plural_atomic "and" "/" "or" plural_atomic

/* Ties for the minimum qualify independently; each player's own permanents
   are counted using the same written filter on both sides of the comparison. */
/* @sem PlayerSet::Matching{binding:0, condition:Compare{left:PlayerNumber{player:Bound(0), number:Permanents($filter_plural)}, test:NumberTest::Compare{comparison:LessOrEqual, value:AmongPlayers{players:All, number:Permanents($filter_plural), aggregation:Minimum}}}} */
players_fewest_permanents ::= "each" "player" "who" "controls" "the" "fewest" filter_plural

/* A library's top card: your own, or that of the player an event or target named. */
top_library_owner ::= zone_your | zone_that_player

/* Modified creatures of a kind. */
/* @sem ObjectFilter::AllOf([$filter_plural, Modified]) */
filter_plural_modified ::= "modified" filter_plural
/* @sem ObjectFilter::AllOf([$filter_phrase, Modified]) */
filter_phrase_modified ::= "modified" filter_phrase

/* Every card exiled with the source, as one group. */
/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}) */
linked_exiled_cards ::= "the" "exiled" "cards"

/* Filters taken over from seeded rules, in their original Oracle words. */
/* @sem ObjectFilter::AnyOf([CardType(Instant), CardType(Sorcery)]) */
filter_instant_or_sorcery ::= "instant" "or" "sorcery"

/* @sem ObjectFilter::$filter_phrase */
attachment_eligible ::= "a" filter_phrase

/* Announced stack targets for retargeting, preserving the object domain and filter. */
retarget_stack_object ::= retarget_spell_or_ability
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Any, zones:[Stack]}), count:Exactly(Constant(1)), filter:Any}), index:0} */
retarget_spell_or_ability ::= "target" "spell" "or" "ability"
retarget_many_stack_object ::= retarget_instant_sorcery | retarget_subtype_spell
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:AnyOf([CardType(Instant), CardType(Sorcery)])}), index:0} */
retarget_instant_sorcery ::= "target" "instant" "or" "sorcery" "spell"
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:$subtype}), index:0} */
retarget_subtype_spell ::= "target" subtype "spell"
retarget_single_stack_object ::= retarget_spell_single_permanent | retarget_single_spell | retarget_single_any_stack | retarget_single_instant_sorcery | retarget_single_activated | retarget_spell_only_source
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:OnStack(SingleTarget)}), index:0} */
retarget_single_spell ::= "target" "spell" "with" "a" "single" "target"
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Any, zones:[Stack]}), count:Exactly(Constant(1)), filter:OnStack(SingleTarget)}), index:0} */
retarget_single_any_stack ::= "target" "spell" "or" "ability" "with" "a" "single" "target"
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:AllOf([AnyOf([CardType(Instant), CardType(Sorcery)]), OnStack(SingleTarget)])}), index:0} */
retarget_single_instant_sorcery ::= "target" "instant" "or" "sorcery" "spell" "with" "a" "single" "target"
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Ability, zones:[Stack]}), count:Exactly(Constant(1)), filter:AllOf([OnStack(Activated), OnStack(SingleTarget)])}), index:0} */
retarget_single_activated ::= "target" "activated" "ability" "with" "a" "single" "target"
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:AllOf([OnStack(SingleTarget), TargetsAny(Objects(One(Source)))])}), index:0} */
retarget_spell_only_source ::= "target" "spell" "that" "targets" "only" "this" "creature"

/* The singular linked card and the group of cards linked to an object differ. */
linked_name_filter ::= linked_name_single | linked_name_any

/* @sem ObjectFilter::SharesNameWith(Query{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}), index:0}) */
linked_name_single ::= "with" "the" "same" "name" "as" "the" "exiled" "card"

/* @sem ObjectFilter::SharesNameWithAny(Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)})) */
linked_name_any ::= "with" "the" "same" "name" "as" "a" "card" "exiled" "with" object_ref

/* A singular spell's type and casting origin are independent operands. */
exile_cast_spell ::= exile_cast_spell_any | exile_cast_spell_kind

/* @sem ObjectFilter::Cast{from:Shared(Exile)} */
exile_cast_spell_any ::= "a" "spell" "you" "cast" "from" "exile"

/* @sem ObjectFilter::AllOf([$filter_phrase, Cast{from:Shared(Exile)}]) */
exile_cast_spell_kind ::= "a" filter_phrase "spell" "you" "cast" "from" "exile"

/* Compound battlefield filters shared by all object-targeting actions. */
/* @sem ObjectFilter::AnyOf([$subtype, @and($adjective_color, $noun), @and($adjective_color_2, $noun_2)]) */
filter_qualified_three_heads ::= subtype "," adjective_color noun "," "or" adjective_color noun

/* @sem @and($adjective_legendary, ObjectFilter::AnyOf([$noun, $noun_2, $noun_3])) */
filter_legendary_three_kinds ::= adjective_legendary "permanent" "that's" "an" noun "," noun "," "or" noun

/* @sem @and($subtype_negated, $noun, ObjectFilter::Not(ObjectFilter::State(PowerEqualsToughness))) */
filter_unequal_stats ::= subtype_negated noun "whose" "power" "and" "toughness" "aren't" "equal"

/* @sem ObjectFilter::Extreme{among:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$adjective_nontype}, property:ManaValue} */
filter_lowest_mana_value ::= adjective_nontype "permanent" "with" "the" "lowest" "mana" "value"

/* @sem ObjectFilter::AnyOf([@and($noun, ObjectFilter::History{event:AbilityActivated, window:ThisTurn}), @and(ObjectFilter::Tapped, $noun_2)]) */
filter_activated_or_tapped ::= noun "that" "was" "activated" "this" "turn" "or" "tapped" noun

/* The chooser is the trigger event subject, separate from the controller. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:@and($adjective_nontype, ObjectFilter::ControlledBy(OpponentsOf(AbilityController))), chooser:EventSubject}), index:0} */
target_event_subject_choice ::= "target" adjective_nontype "permanent" "of" "that" "player's" "choice" "that" "one" "of" "your" "opponents" "controls"

/* Stack selections are shared operands for counter effects. */
counter_stack_objects ::= counter_targeting_spell_or_ability | counter_targeting_instant_or_subtype | counter_one_linked_name | counter_one_sourced_ability | counter_one_mixed_stack | counter_many_stack | counter_many_spells | counter_one_cast_from_zone | counter_one_ability_or_filtered_spell

/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Ability, zones:[Stack]}), count:Exactly(Constant(1)), filter:AllOf([$counter_ability_kind, AbilityOf($counter_source_filter)])}), index:0}) */
counter_one_sourced_ability ::= "target" counter_ability_kind "ability" "from" counter_source_filter "source"

/* @sem ObjectFilter::OnStack(Activated) */
counter_ability_activated ::= "activated"

/* @sem ObjectFilter::AnyOf([OnStack(Activated), OnStack(Triggered)]) */
counter_ability_either ::= "activated" "or" "triggered"

counter_ability_kind ::= counter_ability_activated | counter_ability_either

counter_source_filter ::= counter_source_noun_an | counter_source_noun_a | counter_source_noun_pair | counter_source_adjective

/* @sem ObjectFilter::$noun */
counter_source_noun_an ::= "an" noun

/* @sem ObjectFilter::$noun */
counter_source_noun_a ::= "a" noun

/* @sem ObjectFilter::AnyOf([$noun, $noun_2]) */
counter_source_noun_pair ::= "an" noun "or" noun

/* @sem ObjectFilter::$adjective_nontype */
counter_source_adjective ::= "a" adjective_nontype

/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Any, zones:[Stack]}), count:Exactly(Constant(1)), filter:AnyOf([OnStack(Activated), OnStack(Triggered), AllOf([OnStack(Spell), $adjective_nontype])])}), index:0}) */
counter_one_mixed_stack ::= "target" "activated" "ability" "," "triggered" "ability" "," "or" adjective_nontype "spell"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Any, zones:[Stack]}), count:UpTo($number), filter:Any})) */
counter_many_stack ::= "up" "to" number "target" "spells" "and" "/" "or" "abilities"

/* @sem ObjectSet::Zone(_{scope:Shared(Stack), kind:Spell, filter:InSet(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:UpTo($number), filter:Any})))}) */
counter_many_spells ::= "up" "to" number "target" "spells"

/* Card characteristics remain independent of the graveyard's owner. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($card_ability_qualifier, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0} */
target_card_ability_graveyard ::= "target" "card" card_ability_qualifier "from" "your" "graveyard"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($card_filter, $card_ability_qualifier, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0} */
target_typed_ability_graveyard ::= "target" card_filter "card" card_ability_qualifier "from" "your" "graveyard"

card_ability_qualifier ::= card_has_adventure | card_has_awaken | card_has_kicker | card_has_cycling

/* @sem ObjectFilter::State(HasAdventure) */
card_has_adventure ::= "that" "has" "an" "Adventure"

/* @sem ObjectFilter::HasKeywordFamily(Awaken) */
card_has_awaken ::= "with" "awaken"

/* @sem ObjectFilter::HasKeywordFamily(Kicker) */
card_has_kicker ::= "with" "a" "kicker" "ability"

/* @sem ObjectFilter::HasActivatedAbility(Cycling) */
card_has_cycling ::= "with" "a" "cycling" "ability"

graveyard_card_modifiers ::= modifiers | modifier_card_mutate | modifier_no_abilities | modifier_isnt_subtype

/* Card qualifiers describe the card independently of the action using it. */
/* @sem ObjectFilter::HasKeywordFamily(Mutate) */
modifier_card_mutate ::= "with" "mutate"

/* @sem ObjectFilter::State(NoAbilities) */
modifier_no_abilities ::= "with" "no" "abilities"

/* @sem ObjectFilter::Not($subtype) */
modifier_isnt_subtype ::= "that" "isn't" "a" subtype

/* The opponent chooses the announced target; its zone remains yours. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and($card_filter, ObjectFilter::InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)})), chooser:OneOf(OpponentsOf(AbilityController))}), index:0} */
target_card_your_graveyard_opponent_choice ::= "target" card_filter "card" "of" "an" "opponent's" "choice" "from" "your" "graveyard"

/* Each side of the union is a complete card description. */
/* @sem @and($subtype, $noun) */
subtyped_card_description ::= subtype noun "card"

/* @sem ObjectFilter::AnyOf([$subtyped_card_description, $subtyped_card_description_2]) */
card_description_union ::= subtyped_card_description "or" subtyped_card_description

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and($card_description_union, ObjectFilter::InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}))}), index:0} */
target_card_union_your_graveyard ::= "target" card_description_union "from" "your" "graveyard"

/* A current graveyard population constrained by its arrival this turn. */
graveyard_cards_arrived_this_turn ::= graveyard_arrival_all_cards | graveyard_arrival_filtered_cards

/* Exile populations preserve the linked source and the owner independently. */
/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)} */
permission_linked_exile_cards ::= "cards" "exiled" "with" object_ref

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(One(AbilityController)), ExiledWith($object_ref)])} */
permission_owned_linked_exile_cards ::= "cards" "you" "own" "exiled" "with" object_ref

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(OthersThan(AbilityController)), Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})])} */
permission_others_counter_exile_cards ::= "cards" "you" "don't" "own" "with" counter_kind "counters" "on" "them" "from" "exile"

/* Mixed alternatives retain the qualifier on its own list member. */
/* @sem ObjectFilter::AnyOf([$noun, $subtype, @and(ObjectFilter::Not(ObjectFilter::Supertype(Basic)), $noun_2)]) */
filter_mixed_nonbasic_list ::= noun "," subtype "," "or" "nonbasic" noun

/* @sem ObjectFilter::AnyOf([$noun, @and(ObjectFilter::Tapped, $noun_2), @and(ObjectFilter::Tapped, $noun_3)]) */
filter_mixed_tapped_list ::= noun "," "tapped" noun "," "or" "tapped" noun

/* @sem ObjectFilter::Counters{kind:$counter_kind, comparison:Greater, value:Expr::Constant(0)} */
modifier_has_named_counter ::= "that" "has" "a" counter_kind "counter" "on" "it"

/* @sem ObjectFilter::AttackingDefender(PlayersAndPlaneswalkers(One(AbilityController))) */
modifier_attacking_you_walkers ::= "that's" "attacking" "you" "or" "a" "planeswalker" "you" "control"

/* @sem ObjectFilter::Property{property:ColorCount, test:NumberTest::Compare{comparison:NotEqual, value:$number}} */
modifier_not_exactly_colors ::= "that" "isn't" "exactly" number "colors"

/* The same combat history predicate can qualify a noun or a named object. */
/* @sem $historical_combat_peer */
modifier_blocked_or_blocked_by_subtype_turn ::= "that" historical_combat_peer

/* Battlefield population whose counters are counted. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural} */
counter_battlefield_population ::= filter_plural

/* Toxic without a number denotes the keyword family. */
/* @sem ObjectFilter::HasKeywordFamily(Toxic) */
modifier_with_toxic_family ::= "with" "toxic"

/* Hand selections compose with movement costs independently of the destination. */
hand_cost_selection ::= hand_cost_selection_one | hand_cost_selection_many | hand_cost_selection_colored

/* @sem CostObjectSelection::CostObjectSelection{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, choose:Exactly(Constant(1))} */
hand_cost_selection_one ::= "a" "card" "from" "your" "hand"

/* @sem CostObjectSelection::CostObjectSelection{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, choose:Exactly($count_plural)} */
hand_cost_selection_many ::= count_plural "cards" "from" "your" "hand"

/* @sem CostObjectSelection::CostObjectSelection{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$adjective_color}, choose:Exactly($count_plural)} */
hand_cost_selection_colored ::= count_plural adjective_color "cards" "from" "your" "hand"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase} */
cost_selected_permanent ::= ("a" | "an") filter_phrase

/* @sem ObjectFilter::Counters{kind:$counter_kind, comparison:Greater, value:Expr::Constant(0)} */
modifier_named_counters_on_them ::= "with" counter_kind "counters" "on" "them"

/* An unrestricted source quality, including spells and permanents. */
/* @sem ObjectFilter::Any */
plural_everything ::= "everything"

/* The owner qualifier stays independent of the player performing an action. */
/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([State(Suspended), $modifier_you_own])} */
owned_suspended_card_population ::= "suspended" "card" modifier_you_own

/* Filters for a card revealed by an explore event. */
explored_card_filter ::= filter_phrase | adjective_nontype

/* The Aura's enchant ability carries the host's additional type restriction. */
/* @sem ObjectRef::@enchanted_creature_operand(ObjectRef::AttachedTo(Source)) */
enchanted_qualified_creature_ref ::= "enchanted" attached_other_noun "creature"

/* @sem ObjectFilter::SameObject(Earlier{what:LastDrawn}) */
last_drawn_card_filter ::= "the" "last" "card" "you" "drew" "this" "turn"

/* Announce a spell using the independently linked card population. */
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:$linked_name_any}), index:0}) */
counter_one_linked_name ::= "target" "spell" linked_name_any

/* A historical blocking relation retains the named blocker and the turn window. */
/* @sem ObjectFilter::Condition(Compare{left:EventHistory{event:Pair{event:BecomesBlockedBy, objects:SameObject(ObjectRef::Candidate), others:SameObject($that_noun)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}) */
modifier_blocked_this_turn ::= "that" "were" "blocked" "by" that_noun "this" "turn"

/* A target player selected by their attack history this turn. */
/* @sem Recipients::Players(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:Matching{binding:0, condition:Compare{left:EventHistory{event:Player{event:Attacks, players:One(Bound(0))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}}), index:0})) */
recipients_attacked_player_target ::= "target" "player" "who" "attacked" "this" "turn"

/* @sem ObjectFilter::AnyOf([Condition(Compare{left:EventHistory{event:Pair{event:BecomesBlockedBy, objects:SameObject(Candidate), others:$filter_phrase}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}), Condition(Compare{left:EventHistory{event:Pair{event:Blocks, objects:SameObject(Candidate), others:$filter_phrase}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})]) */
historical_combat_peer ::= "blocked" "or" "was" "blocked" "by" "a" filter_phrase "this" "turn"

/* @sem PlayerSet::Matching{binding:0, condition:CoinCameUp{player:Bound(0), outcome:Tails}} */
players_coin_tails ::= "each" "player" "whose" "coin" "comes" "up" "tails"

/* An announced target with a current-combat constraint. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$filter_phrase, State(AttackingAlone)])}), index:0} */
target_attacking_alone ::= "target" filter_phrase "that's" "attacking" "alone"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, Chosen(CreatureType)])} */
chosen_type_population ::= "all" filter_plural "of" "the" "creature" "type" "of" "your" "choice"

/* A craft-linked population retains the object whose craft used the cards. */
/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}) */
craft_exiled_cards ::= "the" "exiled" "cards" "used" "to" "craft" object_ref

/* Possessive forms keep singular and plural linked populations distinct. */
/* @sem ObjectRef::Query{objects:Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}, index:0} */
linked_exiled_card_possessive ::= "the" "exiled" "card's"

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}) */
linked_exiled_cards_possessive ::= "the" "exiled" "cards'"

/* Singular and plural counter populations print their own agreement. */
/* @sem @and($filter_phrase, ObjectFilter::Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})) */
counter_attack_filter ::= filter_phrase "with" "a" counter_kind "counter" "on" "it"

/* @sem @and($filter_plural, ObjectFilter::Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})) */
counter_drag_filter ::= filter_plural "with" counter_kind "counters" "on" "them"

/* Level up is a keyword family, independent of its activated cost. */
/* @sem ObjectFilter::HasKeywordFamily(LevelUp) */
modifier_with_level_up ::= "with" "level" "up"

/* A singular relative clause compares with the bound antecedent. */
/* @sem ObjectFilter::Shares{property:CardTypes, with:@it} */
modifier_shares_card_type ::= "that" "shares" "a" "card" "type" "with" "it"

/* An explicitly named battlefield population retains its written name. */
/* @sem ObjectFilter::@and($filter_plural, ObjectFilter::Name(@card_name)) */
named_plural_population ::= filter_plural "named" SELF_NAME

/* @sem ObjectFilter::AnyOf([CardType(Instant), CardType(Sorcery)]) */
filter_instant_and_or_sorcery ::= "instant" "and" "/" "or" "sorcery"

/* Exile populations retain their link, filter, owner, and receipt identities. */
/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}) */
exile_linked_population ::= "exiled" "with" object_ref

exile_random_population ::= exile_random_linked | exile_random_draft

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}) */
exile_random_linked ::= "that" "was" "exiled" "with" object_ref

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:DraftNoted(_{kind:Exiled, player:AbilityController, card:@card_name})}) */
exile_random_draft ::= "you" "exiled" "with" "cards" "named" SELF_NAME

exile_described_population ::= exile_filtered_linked_population | exile_filtered_receipt_population | exile_owned_counter_population

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_phrase, InSet(Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}))])}) */
exile_filtered_linked_population ::= filter_phrase "card" "exiled" "with" object_ref

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([$adjective_nontype, InSet(Transition{result:@prior, phase:After})])}) */
exile_filtered_receipt_population ::= adjective_nontype "card" "exiled" "this" "way"

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(OpponentsOf(AbilityController)), Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})])}) */
exile_owned_counter_population ::= "exiled" "card" "an" "opponent" "owns" "with" "a" counter_kind "counter" "on" "it"

/* Linked exile populations preserve their anchor; receipt references remain distinct. */
put_exiled_singular_objects ::= put_each_linked_card | put_prior_exiled_card | put_one_linked_card | put_target_linked_mana_card

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)} */
put_each_linked_card ::= "each" "card" "exiled" "with" object_ref

/* @sem ObjectSet::@exile_followup(InZone{objects:One(Result{result:@prior, phase:After, index:0}), zone:Exile}) */
put_prior_exiled_card ::= "that" "card"

/* @sem ObjectSet::InZone{objects:One(Query{objects:Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}, index:0}), zone:Exile} */
put_one_linked_card ::= "the" "exiled" "card"

/* @sem ObjectSet::InZone{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Exile]}), count:Exactly(Constant(1)), filter:AllOf([$noun, Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:AnnouncedX}}, ExiledWith($object_ref)])}), index:0}), zone:Exile} */
put_target_linked_mana_card ::= "target" noun "card" "with" "mana" "value" "X" "exiled" "with" object_ref

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)} */
put_exiled_plural_objects ::= "the" "cards" "exiled" "with" object_ref

/* Card populations are independent of the action that moves them. */
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$filter_phrase} */
return_all_graveyard_population ::= "all" filter_phrase "cards" "from" "all" "graveyards"

return_personal_graveyard_population ::= personal_graveyard_power_population | personal_graveyard_same_name_population | personal_graveyard_named_target_population

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:@and($filter_phrase, ObjectFilter::Property{property:Power, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}})} */
personal_graveyard_power_population ::= "all" filter_phrase "cards" "with" "power" value "or" "less" "from" "your" "graveyard"

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:SharesNameWith($personal_graveyard_kind_target)} */
personal_graveyard_same_name_population ::= personal_graveyard_kind_target "and" "all" "other" "cards" "with" "the" "same" "name" "as" "that" "card" "from" "your" "graveyard"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$noun, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0} */
personal_graveyard_kind_target ::= "target" noun "card"

/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$modifier_source_name, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}) */
personal_graveyard_named_target_population ::= "target" "card" modifier_source_name "from" "your" "graveyard"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(5)), filter:AllOf([$noun, InZone(Players{zone:Graveyard, players:One(AbilityController)})]), constraints:[OneForEach([Color(White), Color(Blue), Color(Black), Color(Red), Color(Green)])]})) */
each_color_graveyard_targets ::= "for" "each" "color" "," "return" "up" "to" "one" "target" noun "card" "of" "that" "color" "from" "your" "graveyard"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural} */
battlefield_return_population ::= "all" filter_plural "on" "the" "battlefield"

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$filter_phrase} */
graveyards_return_population ::= "all" filter_phrase "cards" "in" "graveyards"

/* @sem ObjectFilter::AnyOf([Subtype(Assassin), Subtype(Mercenary), Subtype(Pirate), Subtype(Rogue), Subtype(Warlock)]) */
plural_outlaws ::= "outlaws"

/* Independent optional announcements are combined as a graveyard population,
   retaining their individual target slots. */
return_graveyard_selection ::= return_optional_pair | return_optional_four | return_common_type_cards | return_cycling_cards | return_chosen_type_card

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:AnyOf([$return_optional_member, $return_optional_member_2])} */
return_optional_pair ::= return_optional_member "and" return_optional_member

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:AnyOf([$return_optional_member, $return_optional_member_2, $return_optional_member_3, $return_optional_member_4])} */
return_optional_four ::= return_optional_member "," return_optional_member "," return_optional_member "," "and" return_optional_member

return_optional_member ::= return_optional_plain | return_optional_no_abilities

/* @sem ObjectFilter::SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:AllOf([$return_member_filter, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}) */
return_optional_plain ::= "up" "to" "one" "target" return_member_filter "card"

/* @sem ObjectFilter::SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:AllOf([AllOf([$card_filter, State(NoAbilities)]), InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}) */
return_optional_no_abilities ::= "up" "to" "one" "target" card_filter "card" "with" "no" "abilities"

return_member_filter ::= card_filter | subtype

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo($number), filter:AllOf([$noun, InZone(Players{zone:Graveyard, players:One(AbilityController)})]), constraints:[CommonProperty(CreatureTypes)]})) */
return_common_type_cards ::= "up" "to" number "target" noun "cards" "of" "the" "creature" "type" "of" "your" "choice"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo($number), filter:AllOf([HasActivatedAbility(Cycling), InZone(Players{zone:Graveyard, players:One(AbilityController)})])})) */
return_cycling_cards ::= "up" "to" number "target" "cards" "with" "cycling"

/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([Chosen(CreatureType), InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0}) */
return_chosen_type_card ::= "target" "card" "of" "the" "chosen" "type"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(5)), filter:InZone(Players{zone:Graveyard, players:One(AbilityController)}), constraints:[OneForEach([Color(White), Color(Blue), Color(Black), Color(Red), Color(Green)])]})) */
return_color_selection ::= "up" "to" "one" "target" "card" "of" "that" "color"

/* Populations selected by object-action payments. The event-group form keeps
   the triggering group and source exclusion distinct. */
cost_action_objects ::= cost_selected_permanent | cost_other_event_creatures

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::InSet(EventGroup), ObjectFilter::Not(SameObject(Source)))} */
cost_other_event_creatures ::= "one" "of" "the" "other" "creatures"

/* Even division can name an object population or announced damage targets. */
even_damage_recipients ::= even_damage_objects | even_damage_targets

/* @sem Recipients::Objects($affected) */
even_damage_objects ::= affected

/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:AnyNumber, filter:Any})) */
even_damage_targets ::= "any" "number" "of" "targets"

/* The chosen card type is distinct from a chosen creature type. */
next_spell_chosen_filter ::= next_spell_chosen_card_type | next_spell_chosen_color

/* @sem ObjectFilter::Chosen(CardType) */
next_spell_chosen_card_type ::= "of" "the" "chosen" "type"

/* @sem ObjectFilter::Chosen(Color) */
next_spell_chosen_color ::= "of" "the" "chosen" "color"

/* Target a population distinct from the source. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:AnyNumber, filter:AllOf([Not(SameObject(Source)), $plural])})) */
objects_any_other_targets ::= "any" "number" "of" "other" "target" plural

/* Each member of either controlled population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([AnyOf([$filter_phrase, $filter_phrase_2]), ControlledBy(One(AbilityController))])} */
objects_each_controlled_union ::= "each" filter_phrase "and" filter_phrase "you" "control"

/* @sem PlayerSet::Intersection([$players_unqualified_singular, Matching{binding:0, condition:Compare{left:CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}}]) */
players_empty_hand ::= players_unqualified_singular "with" "no" "cards" "in" "hand"

players_unqualified_singular ::= players_fewest_permanents | mined_players | player_one | players_each_opponent | players_each | players_or_controller | players_each_other | players_each_other_opponent
    | players_each_friend | players_each_foe | players_enchanted

/* @sem ObjectFilter::NameFirstPrintedIn(Homelands) */
modifier_name_first_printed_in_homelands ::= "with" "a" "name" "originally" "printed" "in" "the" "Homelands" "expansion"

/* A voting comparison filters the named player set, preserving its binding. */
voting_player_base ::= players_each_opponent | players_each | players_each_other | players_each_other_opponent

/* @sem PlayerSet::Intersection([$voting_player_base, Matching{binding:0, condition:VotedAs{player:Bound(0), other:AbilityController, same:true}}]) */
players_voted_same ::= voting_player_base "who" "voted" "for" "a" "choice" "you" "voted" "for"

/* @sem PlayerSet::Intersection([$voting_player_base, Matching{binding:0, condition:VotedAs{player:Bound(0), other:AbilityController, same:false}}]) */
players_voted_different ::= voting_player_base "who" "voted" "for" "a" "choice" "you" "didn't" "vote" "for"

/* @prefer type(Creature) */
/* @sem ObjectRef::Source */
echo_holder_possessive ::= "this" "creature's"

/* Colors outside a named player's commander identity describe source objects. */
/* @sem ObjectFilter::ColorOutsideCommanderIdentity($player_possessive) */
color_outside_commander_identity ::= "each" "color" "that's" "not" "in" player_possessive "commander's" "color" "identity"

/* A casting restriction uses the named color for the X portion. */
/* @sem Ability::Casting(RestrictMana{portion:X, filter:Colors([$token_color])}) */
casting_x_mana_color ::= "spend" "only" token_color "mana" "on" "X" "."

/* The opponent chooses the announced damage target. */
/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Expr::Constant(1)), filter:Any, chooser:OneOf(OpponentsOf(AbilityController))})) */
recipients_any_target_opponent_choice ::= "any" "target" "of" "an" "opponent's" "choice"

/* Possessive holder forms retain the source identity. */
/* @sem ObjectRef::Source */
upkeep_holder ::= "this" upkeep_holder_kind

upkeep_holder_kind ::= upkeep_holder_creature | upkeep_holder_enchantment | upkeep_holder_artifact | upkeep_holder_land | upkeep_holder_permanent

/* @prefer type(Creature) */
/* @sem () */
upkeep_holder_creature ::= "creature's"

/* @prefer type(Enchantment) */
/* @sem () */
upkeep_holder_enchantment ::= "enchantment's"

/* @prefer type(Artifact) */
/* @sem () */
upkeep_holder_artifact ::= "artifact's"

/* @prefer type(Land) */
/* @sem () */
upkeep_holder_land ::= "land's"

/* @sem () */
upkeep_holder_permanent ::= "permanent's"

/* The event supplies the amount; the written library and end remain explicit. */
/* @sem ObjectSet::Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:EventAmount, from:$ordered_end} */
event_amount_library_end ::= "that" "many" "cards" "from" "the" ordered_end "of" "your" "library"

/* @sem ManaPaymentFilter::ProducedBy($filter_plural) */
mana_payment_produced_by ::= "mana" "produced" "by" filter_plural

/* A plural creature population guarantees the noun in a per-creature payment. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$chosen_creature_filter} */
chosen_creature_population ::= chosen_creature_filter

chosen_creature_filter ::= chosen_creature_base | chosen_creature_adjectives | chosen_creature_modified

/* @sem ObjectFilter::CardType(Creature) */
chosen_creature_base ::= "creatures"

/* @sem @and($filter_outer_adjectives, $chosen_creature_filter) */
chosen_creature_adjectives ::= filter_outer_adjectives chosen_creature_filter

/* @sem @and($chosen_creature_unmodified, $modifiers) */
chosen_creature_modified ::= chosen_creature_unmodified modifiers

chosen_creature_unmodified ::= chosen_creature_base | chosen_creature_unmodified_adjectives

/* @sem @and($filter_outer_adjectives, $chosen_creature_unmodified) */
chosen_creature_unmodified_adjectives ::= filter_outer_adjectives chosen_creature_unmodified

/* @sem ObjectFilter::Modified */
adjective_modified ::= "modified"

/* @sem ObjectFilter::Counters{comparison:Greater, value:Expr::Constant(0)} */
modifier_counters_on_it ::= "with" "counters" "on" "it"

/* Exile populations retain their filter and, for linked cards, their source. */
/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:Any}) */
exile_cards_population ::= "cards" "in" "exile"

owned_exile_population ::= owned_exile_any | owned_exile_adventure

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:Any}) */
owned_exile_any ::= "in" "exile"

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:State(HasAdventure)}) */
owned_exile_adventure ::= "in" "exile" "that" "has" "an" "Adventure"

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})}) */
exile_counter_population ::= "exiled" "cards" "with" counter_kind "counters" "on" "them"

/* A singular optional target shares a creature type union and graveyard owner. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:UpTo(Expr::Constant(1)), filter:@and(ObjectFilter::AnyOf(@unordered([$subtype, $subtype_2])), $noun_creature, ObjectFilter::InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}))}), index:0} */
target_card_up_to_union_your_graveyard ::= "up" "to" "one" "target" subtype "or" subtype noun_creature "card" "from" "your" "graveyard"

/* A singular card description retains its independently stated filter. */
/* @sem ObjectFilter::$card_filter */
singular_filtered_card ::= "a" card_filter "card"

/* An arbitrary announced group of spells remains a stack population. */
/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:InSet(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Spell, zones:[Stack]}), count:AnyNumber, filter:Any})))} */
stack_target_spells ::= "any" "number" "of" "target" "spells"

/* Two permanent kinds controlled by opponents are one damage population. */
/* @sem Recipients::Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([AnyOf([$noun, $noun_2]), ControlledBy(OpponentsOf(AbilityController))])}) */
recipients_each_opponents_pair ::= "each" noun "and" noun "your" "opponents" "control"

/* @sem Recipients::Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ControlledBy(OpponentsOf(AbilityController))])}), index:0})) */
recipients_target_opponent_controls ::= "target" noun "an" "opponent" "controls"

/* @sem $modifier_that_color */
filter_permanent_of_that_color ::= "permanent" modifier_that_color

/* @sem ObjectFilter::Chosen(Color) */
modifier_that_color ::= "of" "that" "color"

/* A casting target restriction composes an article-qualified permanent filter
   with the casting-time frame, preserving the filter for inverse printing. */
/* @sem $filter_phrase */
casting_target_filter_a ::= "a" filter_phrase

/* @sem $filter_phrase */
casting_target_filter_an ::= "an" filter_phrase

casting_target_filter ::= casting_target_filter_a | casting_target_filter_an

/* @sem CastingRule::ProhibitTargets{domain:_{kind:Permanent, zones:[Battlefield]}, filter:$casting_target_filter} */
casting_target_prohibition ::= "you" "can't" "choose" casting_target_filter

/* @sem Ability::Casting($casting_target_prohibition) */
casting_target_prohibition_ability ::= casting_target_prohibition "as" "this" "spell's" "target" "as" "you" "cast" "it" "."

/* A graveyard-only ability and the naming effect it contains remain independently composable. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:$graveyard_named_effect} */
graveyard_named_ability ::= "if" "this" "card" "is" "in" "a" "graveyard" "," graveyard_named_effect "."

/* @sem Ability::CountsAsNamed{name:$referenced_card_name_2, for_spells:$referenced_card_name} */
graveyard_named_effect ::= "effects" "from" "spells" "named" referenced_card_name "count" "it" "as" "a" "card" "named" referenced_card_name

/* A name-counting rule may use independent spell and counted-card names. */
/* @sem Ability::CountsAsNamed{name:$referenced_card_name_2, for_spells:$referenced_card_name} */
counts_as_named_for_spells ::= "effects" "from" "spells" "named" referenced_card_name "count" "it" "as" "a" "card" "named" referenced_card_name

/* @sem Ability::Scoped{zones:[Graveyard], ability:$counts_as_named_for_spells} */
graveyard_counts_as_named ::= "if" "this" "card" "is" "in" "a" "graveyard" "," counts_as_named_for_spells "."

/* Blockers are creatures; the selected-pile filter identifies the eligible set. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:InPile(None)} */
chosen_pile_blockers ::= "creatures" "in" "the" "chosen" "piles"

/* The chooser selects a subset of the referenced group at resolution. */
/* @sem ObjectSet::@selection(SelectionStep::_{binding:0, objects:$group_pronoun, chooser:Players(One(AbilityController)), count:AnyNumber}) */
any_number_of_group ::= "any" "number" "of" group_pronoun

/* Sticker qualifiers share their typed kind across card and permanent populations. */
/* @sem ObjectFilter::State(Sticker($sticker_vowel_kind)) */
modifier_bare_sticker_vowel ::= "with" "an" sticker_vowel_kind "sticker"

sticker_vowel_kind ::= sticker_art | sticker_ability

/* @sem ObjectFilter::State(Sticker($sticker_consonant_kind)) */
modifier_bare_sticker_consonant ::= "with" "a" sticker_consonant_kind "sticker"

sticker_consonant_kind ::= sticker_name | sticker_power_toughness

/* A protection quality can name each card type of a referenced card. */
/* @sem ObjectFilter::Shares{property:CardTypes, with:$card_type_possessive} */
protection_shared_card_types ::= "each" "of" card_type_possessive "card" "types"

/* @sem ObjectFilter::Shares{property:CreatureTypes, with:$card_type_possessive} */
protection_shared_creature_types ::= "each" "of" card_type_possessive "creature" "types"

card_type_possessive ::= linked_card_type_possessive | self_possessive

/* @sem ObjectRef::@remember_object(ObjectRef::@activation_exiled_card(ObjectRef::Query{objects:Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}, index:0})) */
linked_card_type_possessive ::= "the" "exiled" "card's"

/* A persistent player choice remains independent of the event subject. */
/* @sem PlayerRef::Chosen */
chosen_player_ref ::= "the" "chosen" "player"

/* A card matching the chosen card type. The enclosing clause supplies the population. */
/* @sem ObjectFilter::Chosen(CardType) */
revealed_count_chosen_card ::= "card" "of" "the" "chosen" "type"

/* Creature populations for a per-recipient characteristic. */
each_counter_creature ::= each_counter_other_controlled | each_counter_controlled | each_counter_any

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), CardType(Creature), ControlledBy(One(AbilityController))])} */
each_counter_other_controlled ::= "each" "other" "creature" "you" "control"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])} */
each_counter_controlled ::= "each" "creature" "you" "control"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)} */
each_counter_any ::= "each" "creature"

/* A filtered card population in the named player's graveyard. */
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One($zone_owner)}, kind:Card, filter:$filter_phrase} */
sticker_card_population ::= ("a" | "an") filter_phrase "card" "in" zone_owner "graveyard"

/* A single damage target may be an opponent or either of two opposing populations. */
/* @sem ObjectFilter::@and($filter_phrase, ObjectFilter::ControlledBy(OpponentsOf(AbilityController))) */
opponent_controlled_recipient ::= filter_phrase "an" "opponent" "controls"

/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Expr::Constant(1)), filter:AnyOf([$opponent_controlled_recipient, $opponent_controlled_recipient_2]), players:OpponentsOf(AbilityController)})) */
recipients_opponent_or_two_controlled ::= "target" "opponent" "," opponent_controlled_recipient "," "or" opponent_controlled_recipient

/* The extreme compares the named population across the whole battlefield. */
/* @sem ObjectFilter::Extreme{among:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plain}, property:ManaValue, highest:true} */
battlefield_greatest_mana_tied ::= filter_plain "with" "the" "greatest" "mana" "value" "or" "tied" "for" "the" "greatest" "mana" "value"

/* An Aura's controller qualifies the attachment, not the enchanted object. */
/* @sem ObjectFilter::HasAttached($aura_attachment_filter) */
modifier_enchanted_by_aura ::= "that's" "enchanted" "by" "an" aura_attachment_filter

aura_attachment_filter ::= aura_attachment_controlled | aura_attachment_unqualified

/* @sem ObjectFilter::@and(ObjectFilter::Subtype(Aura), $modifier_you_control) */
aura_attachment_controlled ::= "Aura" modifier_you_control

/* @sem ObjectFilter::Subtype(Aura) */
aura_attachment_unqualified ::= "Aura"

/* Match any value of a property among a battlefield population. */
/* @sem ObjectFilter::Property{property:$stat, test:NumberTest::AnyProperty{comparison:Equal, objects:$counter_battlefield_population, property:$stat}} */
filter_each_property_among ::= "each" stat "among" counter_battlefield_population

/* The last player choice is the defending player, independent of controller. */
/* @sem ObjectFilter::AttackingDefender(Players(One(Chosen))) */
modifier_attacking_last_chosen_player ::= "attacking" "the" "last" "chosen" "player"

/* Bare and qualified hand-card populations share the enclosing movement. */
hand_exile_card_filter ::= hand_exile_any_card | hand_exile_filtered_cards

/* @sem ObjectFilter::Any */
hand_exile_any_card ::= "cards"

/* @sem $card_filter */
hand_exile_filtered_cards ::= card_filter "cards"

hand_exile_zone ::= hand_exile_hand | hand_exile_graveyard

/* @sem Zone::Hand */
hand_exile_hand ::= "hand"

/* @sem Zone::Graveyard */
hand_exile_graveyard ::= "graveyard"

hand_exile_visibility ::= hand_exile_face_down | hand_exile_face_up

/* @sem ExileVisibility::FaceDown */
hand_exile_face_down ::= "face" "down"

/* @sem ExileVisibility::FaceUp */
hand_exile_face_up ::= "face" "up"

/* An attacking population is restricted by the player enchanted by this source. */
/* @sem ObjectFilter::AttackingDefender(Players($players_enchanted)) */
modifier_attacking_enchanted_player ::= "attacking" players_enchanted

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase} */
personal_graveyard_filtered_cards ::= "all" filter_phrase "cards" "in" "your" "graveyard"

/* The defender is the ability controller's opponents, independent of the attacker's controller. */
/* @sem ObjectFilter::AttackingDefender(Players(OpponentsOf(AbilityController))) */
modifier_attacking_your_opponents ::= "attacking" "your" "opponents"

/* A controlled population with an activated mana ability. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController)), HasActivatedAbility(Mana)])} */
objects_each_controlled_mana_ability ::= "each" filter_phrase "you" "control" "with" "a" "mana" "ability"

/* A controlled population qualified by an exhaust ability. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController)), HasKeywordFamily(Exhaust)])} */
objects_each_controlled_exhaust ::= "each" filter_phrase "you" "control" "with" "an" "exhaust" "ability"

/* @sem ObjectFilter::AnyOf([Subtype(Assassin), Subtype(Mercenary), Subtype(Pirate), Subtype(Rogue), Subtype(Warlock)]) */
plural_outlaw ::= "outlaws"

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}) */
craft_exiled_card ::= "the" "exiled" "card" "used" "to" "craft" object_ref

/* @sem ObjectFilter::AllOf([HasActivatedAbility(Any), HasActivatedAbility(Not(Mana))]) */
modifier_with_nonmana_activated_ability ::= "with" "an" "activated" "ability" "that" "isn't" "a" "mana" "ability"

/* @sem ObjectFilter::State(Transformed) */
adjective_transformed ::= "transformed"

/* A spell with one target, that target being a player. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:AllOf([OnStack(SingleTarget), TargetsAny(Players(All))])}), index:0} */
retarget_player_only_spell ::= "target" "spell" "that" "targets" "only" "a" "player"

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:@and(ObjectFilter::Any, $graveyard_arrival_origin)} */
graveyard_arrival_all_cards ::= "all" "cards" "in" "your" "graveyard" graveyard_arrival_origin

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:@and($filter_phrase, $graveyard_arrival_origin)} */
graveyard_arrival_filtered_cards ::= "all" filter_phrase "cards" "in" "your" "graveyard" graveyard_arrival_origin

graveyard_arrival_origin ::= graveyard_arrival_anywhere | graveyard_arrival_battlefield | graveyard_arrival_exile

/* @sem ObjectFilter::ArrivedThisTurn{} */
graveyard_arrival_anywhere ::= "that" "were" "put" "there" "from" "anywhere" "this" "turn"

/* @sem ObjectFilter::ArrivedThisTurn{from:Battlefield} */
graveyard_arrival_battlefield ::= "that" "were" "put" "there" "from" "the" "battlefield" "this" "turn"

/* @sem ObjectFilter::ArrivedThisTurn{from:Exile} */
graveyard_arrival_exile ::= "that" "were" "put" "there" "from" "exile" "this" "turn"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase} */
counter_kind_source_population ::= "a" filter_phrase

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase} */
counter_kind_other_population ::= "each" "other" filter_phrase

/* The disjunction qualifies each member of the described population. */
/* @sem ObjectFilter::AnyOf([State(Enchanted), State(Equipped)]) */
modifier_enchanted_or_equipped ::= "that" "are" "enchanted" "or" "equipped"

/* A relative singular kind clause restricts each member of the preceding population. */
/* @sem ObjectFilter::AnyOf([$noun_atomic, $noun_atomic_2]) */
modifier_relative_singular_union ::= "that's" "a" noun_atomic "or" "a" noun_atomic

/* Singular relative clauses cannot modify a plural head. */
/* @sem @and($filter_nonlist_head, $singular_relative_modifiers) */
filter_singular_relative_modified ::= filter_nonlist_head singular_relative_modifiers

singular_relative_modifiers ::= modifier_relative_singular_union | singular_relative_modifiers_more

/* @sem @and($modifier_nonattachment, $singular_relative_modifiers) */
singular_relative_modifiers_more ::= modifier_nonattachment singular_relative_modifiers

/* A singular counter-qualified filter keeps the noun and counter as operands. */
/* @sem @and($filter_phrase, ObjectFilter::Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})) */
counter_filter_an ::= filter_phrase "with" "an" counter_kind "counter" "on" "it"

/* A named object and a plural battlefield population share the predicate. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($object_ref), $filter_plural])} */
objects_ref_and_plural ::= object_ref "and" filter_plural

/* A singular counter-qualified population retains both the noun and counter. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$singular_counter_qualified_filter} */
objects_each_counter_qualified ::= "each" singular_counter_qualified_filter

/* @sem @and($counter_qualified_head, ObjectFilter::Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})) */
singular_counter_qualified_filter ::= counter_qualified_head "with" "an" counter_kind "counter" "on" "it"

counter_qualified_head ::= counter_qualified_nontype | filter_phrase

/* @sem @and($adjective_nontype, $filter_phrase) */
counter_qualified_nontype ::= adjective_nontype filter_phrase

/* @sem ObjectFilter::AttackingDefender(Players(One(AbilityController))) */
attacking_defender_you ::= "attacking" "you"

/* A plural population excludes members sharing a creature type with a historical population. */
/* @sem ObjectFilter::AllOf([$filter_plural_tail, Not(SharesWithAny{property:CreatureTypes, with:$convoke_history_population})]) */
filter_plural_except_shared ::= filter_plural_tail "except" "those" "that" "share" "a" "creature" "type" "with" convoke_history_population

/* Each explicitly quantified arm retains its own filter. */
/* @sem ObjectFilter::AnyOf(@unordered([$quantified_union_first, $filter_plural, $filter_plural_2])) */
filter_plural_quantified_three ::= quantified_union_first "," "all" filter_plural "," "and" "all" filter_plural

quantified_union_first ::= filter_plural_tail | filter_plural_except_shared

/* Keep the choice and the controlling player as independent operands. */
/* @sem ObjectFilter::ControlledBy($players_who_last_chose) */
modifier_controlled_by_last_choice ::= "controlled" "by" players_who_last_chose

/* @sem PlayerSet::Matching{binding:0, condition:VotedFor{player:Bound(0), option:Word($last_choice_word)}} */
players_who_last_chose ::= "players" "who" "last" "chose" last_choice_word

last_choice_word ::= last_choice_green_anchor | last_choice_red_waterfall

/* @sem String::'Green Anchor' */
last_choice_green_anchor ::= "green" "anchor"

/* @sem String::'Red Waterfall' */
last_choice_red_waterfall ::= "red" "waterfall"

/* A spell's controller is the recipient; the spell itself is the target. */
/* @sem Recipients::Players(One(ControllerOf(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Spell, zones:[Stack]}), count:Exactly(Expr::Constant(1)), filter:Any}), index:0}))) */
recipients_target_spell_controller ::= "target" "spell's" "controller"

/* @sem Recipients::Players(One(ControllerOf(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Spell, zones:[Stack]}), count:Exactly(Expr::Constant(1)), filter:$spell_adjectives}), index:0}))) */
recipients_target_described_spell_controller ::= "target" spell_adjectives "spell's" "controller"

/* Each reference names its own member of the current block pair. */
/* @sem ObjectRef::BlockPair(Blocker) */
combat_blocker_ref ::= "the" "blocking" "creature"

/* @sem ObjectRef::BlockPair(Attacker) */
combat_attacker_ref ::= "the" "attacking" "creature"

/* A minimum applies to each member of the modified plural population. */
/* @sem ObjectFilter::Counters{kind:$counter_kind, comparison:GreaterOrEqual, value:$value} */
modifier_minimum_named_counters_on_them ::= "with" value "or" "more" counter_kind "counters" "on" "them"

/* The craft link and the selected card's filter are independent. */
/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_phrase, ExiledWith($object_ref)])}) */
craft_exiled_filtered_card ::= "an" "exiled" filter_phrase "card" "used" "to" "craft" object_ref

/* A target group controlled by any player on the ability controller's team. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:$plural_target_count, filter:AllOf([$filter_plural, ControlledBy($life_history_team)])})) */
objects_team_targets ::= plural_target_count "target" filter_plural life_history_team "controls"

conjure_card_group ::= conjure_power_nine | conjure_nine_named_cards

/* @sem ConjuredCard::Each(['Ancestral Recall', 'Black Lotus', 'Mox Emerald', 'Mox Jet', 'Mox Pearl', 'Mox Ruby', 'Mox Sapphire', 'Time Walk', 'Timetwister']) */
conjure_power_nine ::= "the" "Power" "Nine"

/* @sem ConjuredCard::Each([$conjure_group_name, $conjure_group_name_2, $conjure_group_name_3, $conjure_group_name_4, $conjure_group_name_5, $conjure_group_name_6, $conjure_group_name_7, $conjure_group_name_8, $conjure_group_name_9]) */
conjure_nine_named_cards ::= "a" "card" "named" conjure_group_name "," "a" "card" "named" conjure_group_name "," "a" "card" "named" conjure_group_name "," "a" "card" "named" conjure_group_name "," "a" "card" "named" conjure_group_name "," "a" "card" "named" conjure_group_name "," "a" "card" "named" conjure_group_name "," "a" "card" "named" conjure_group_name "," "and" "a" "card" "named" conjure_group_name

conjure_group_name ::= conjure_name_0 | conjure_name_1 | conjure_name_2 | conjure_name_3 | conjure_name_4 | conjure_name_5 | conjure_name_6 | conjure_name_7 | conjure_name_8 | conjure_name_9

/* @sem String::'Ancestral Recall' */
conjure_name_0 ::= "Ancestral" "Recall"

/* @sem String::'Black Lotus' */
conjure_name_1 ::= "Black" "Lotus"

/* @sem String::'Mox Emerald' */
conjure_name_2 ::= "Mox" "Emerald"

/* @sem String::'Mox Jet' */
conjure_name_3 ::= "Mox" "Jet"

/* @sem String::'Mox Pearl' */
conjure_name_4 ::= "Mox" "Pearl"

/* @sem String::'Mox Ruby' */
conjure_name_5 ::= "Mox" "Ruby"

/* @sem String::'Mox Sapphire' */
conjure_name_6 ::= "Mox" "Sapphire"

/* @sem String::'Time Walk' */
conjure_name_7 ::= "Time" "Walk"

/* @sem String::'Timetwister' */
conjure_name_8 ::= "Timetwister"

/* @sem String::'Lightning Bolt' */
conjure_name_9 ::= "Lightning" "Bolt"

/* A filtered card population in a targeted player's hand. */
/* @sem ObjectSet::Zone{scope:Players{zone:Hand, players:One($target_hand_owner)}, kind:Card, filter:$filter_phrase} */
filtered_cards_in_target_hand ::= "the" filter_phrase "cards" "in" target_hand_owner "hand"

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Expr::Constant(1)), filter:Any, players:OpponentsOf(PlayerRef::AbilityController)}), index:0} */
target_opponent_hand_owner ::= "target" "opponent's"

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Expr::Constant(1)), filter:Any, players:All}), index:0} */
target_player_hand_owner ::= "target" "player's"

target_hand_owner ::= target_opponent_hand_owner | target_player_hand_owner

/* The noted type is associated with the named draft card, independently of
   the affected permanent and of the ability holder. */
/* @sem ObjectFilter::DraftNoted(_{kind:CreatureType, player:AbilityController, card:@card_name}) */
modifier_draft_noted_self_type ::= "of" "a" "type" "you" "noted" "for" "cards" "named" SELF_NAME

/* @sem ObjectFilter::DraftNoted(_{kind:CreatureType, player:AbilityController, card:$referenced_card_name}) */
modifier_draft_noted_creature_type ::= "of" "a" "type" "you" "noted" "for" "cards" "named" referenced_card_name

/* A linked exile target carries its own card filter and source identity. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Exile]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ExiledWith(Source)])}), index:0} */
target_card_exiled_with_source ::= "target" noun "card" "exiled" "with" "this" "creature"

/* Cast-origin qualifiers remain operands of a stack target, shared by counter actions. */
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:$counter_cast_origin}), index:0}) */
counter_one_cast_from_zone ::= "target" "spell" counter_cast_origin

counter_cast_origin ::= counter_cast_from_graveyard | counter_cast_from_hand

/* @sem ObjectFilter::Cast{from:Players{zone:Graveyard, players:All}} */
counter_cast_from_graveyard ::= "cast" "from" "a" "graveyard"

/* @sem ObjectFilter::Cast{from:Players{zone:Hand, players:All}} */
counter_cast_from_hand ::= "cast" "from" "a" "hand"

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$card_filter_union} */
payment_graveyard_card_union ::= card_filter_union

/* @sem ObjectFilter::AnyOf(@unordered([$filter_phrase, $filter_phrase_2])) */
card_filter_union ::= filter_phrase "card" "or" filter_phrase "card"

/* Linked exile populations retain the anchor and any independent filter. */
/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)} */
linked_exiled_each ::= "each" "card" "exiled" "with" object_ref

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)} */
linked_exiled_all ::= "all" "cards" "exiled" "with" object_ref

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_phrase, ExiledWith($object_ref)])} */
linked_exiled_filtered_each ::= "each" filter_phrase "card" "exiled" "with" object_ref

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:Counters{kind:$counter_kind, comparison:Greater, value:Constant(0)}} */
exiled_with_counters ::= "all" "exiled" "cards" "with" counter_kind "counters" "on" "them"

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([Not(SameObject(Result{result:@prior, phase:After, index:0})), AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]), ExiledWith($object_ref)])} */
linked_exiled_other_permanents ::= "all" "other" "permanent" "cards" "exiled" "with" object_ref

/* @sem ObjectRef::@member_count_it(ObjectRef::@it) */
her_ref ::= "her"

/* The explicit location qualifies the same battlefield population as all permanents. */
/* @sem ObjectSet::@distributive_pump_subject(ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}) */
objects_all_battlefield ::= "all" filter_plural "on" "the" "battlefield"

/* Both values describe the same property of the selected object. */
/* @sem ObjectFilter::AnyOf(@unordered([Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:$number}}, Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:$number_2}}])) */
modifier_mana_value_pair ::= "with" "mana" "value" number "or" number

/* Exclude the object currently enchanted by this Aura. */
/* @sem ObjectFilter::Not(SameObject($enchanted_creature_ref)) */
modifier_other_than_enchanted ::= "other" "than" enchanted_creature_ref

/* The lexical word Zombie also folds to the ordinary word token. */
/* @sem ObjectFilter::Subtype(Zombie) */
noun_zombie_folded ::= "zombie"

/* A comma-separated population remains a union regardless of its length. */
/* @sem ObjectFilter::AnyOf([...$plural_subtype_commas, $plural_subtype_word]) */
plural_subtype_list ::= plural_subtype_commas "and" plural_subtype_word

plural_subtype_commas ::= plural_subtype_commas_more | plural_subtype_commas_last

/* @sem ObjectFilter::[$plural_subtype_word, ...$plural_subtype_commas] */
plural_subtype_commas_more ::= plural_subtype_word "," plural_subtype_commas

/* @sem ObjectFilter::[$plural_subtype_word] */
plural_subtype_commas_last ::= plural_subtype_word ","

plural_subtype_word ::= subtype_plural | plural_marked_bats | plural_marked_rats

/* @sem ObjectFilter::Subtype(Bat) */
plural_marked_bats ::= "↑" "bats"

/* @sem ObjectFilter::Subtype(Rat) */
plural_marked_rats ::= "↑" "rats"

/* Linked exiled cards retain the filter and the object establishing the link. */
/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_phrase, ExiledWith($object_ref)])}) */
linked_filtered_ability_origin ::= "all" filter_phrase "cards" "exiled" "with" object_ref

/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}) */
craft_trait_origin ::= "an" "exiled" "card" "used" "to" "craft" object_ref

/* The unearth qualifier belongs to this graveyard subject. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$card_filter, InZone(Players{zone:Graveyard, players:One(AbilityController)}), Not(HasKeywordFamily(Unearth))])}), index:0} */
graveyard_without_unearth_target ::= "target" card_filter "card" "in" "your" "graveyard" "without" "unearth"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$card_filter, InZone(Players{zone:Graveyard, players:One(AbilityController)})])}), index:0} */
graveyard_perpetual_target ::= "target" card_filter "card" "in" "your" "graveyard"

/* A target card with an excluded basic card type. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:Not(AllOf([Supertype(Basic), $noun]))}), index:0} */
target_card_graveyard_except_basic ::= "target" "card" "in" "a" "graveyard" "other" "than" "a" "basic" noun "card"

/* A singular head qualified by three independently named alternatives. */
/* @sem ObjectFilter::AllOf([$filter_plain, $that_is_three_kinds]) */
filter_that_is_three_kinds ::= filter_plain that_is_three_kinds

/* @sem ObjectFilter::AnyOf([$filter_phrase, $filter_phrase_2, $filter_phrase_3]) */
that_is_three_kinds ::= "that's" "a" filter_phrase "," "a" filter_phrase "," "or" "a" filter_phrase

/* A singular battlefield population and its explicit excluded class. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Not($filter_phrase_2)])} */
coin_each_population ::= "for" "each" filter_phrase "that" "isn't" "a" filter_phrase

/* @sem ObjectFilter::AllOf([$filter_plain, Condition(CoinCameUp{outcome:Tails})]) */
filter_coin_tails ::= filter_plain "whose" "coin" "comes" "up" "tails"

/* @sem ObjectFilter::History{event:Attacked, window:LastTurnOf(ControllerOf(Candidate))} */
modifier_attacked_controllers_last_turn ::= "that" "attacked" "during" "their" "controller's" "last" "turn"

/* Targeting restrictions describe the stack object, independently of the counter action. */
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Any, zones:[Stack]}), count:Exactly(Constant(1)), filter:$counter_targeting_filter}), index:0}) */
counter_targeting_spell_or_ability ::= "target" "spell" "or" "ability" "that" counter_targeting_filter

/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:AllOf([AnyOf([CardType(Instant), $subtype]), $counter_targeting_filter])}), index:0}) */
counter_targeting_instant_or_subtype ::= "target" "instant" "or" subtype "spell" "that" counter_targeting_filter

counter_targeting_filter ::= counter_targets_permanent | counter_targets_you_or_controlled

/* @sem ObjectFilter::TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase})) */
counter_targets_permanent ::= "targets" "a" filter_phrase

/* @sem ObjectFilter::AnyOf([TargetsAny(Players(One(AbilityController))), TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun, ControlledBy(One(AbilityController))])}))]) */
counter_targets_you_or_controlled ::= "targets" "you" "or" "a" noun "you" "control"

/* @sem ObjectFilter::AnyOf([$plural_five_item, $plural_five_item_2, $plural_five_item_3, $plural_five_item_4, $plural_five_item_5]) */
plural_five ::= plural_five_item "," plural_five_item "," plural_five_item "," plural_five_item "," union_and plural_five_item

plural_five_item ::= plural | plural_marked_bats

/* A full-turn attack-history filter with its explicit unable-to-attack exception. */
/* @sem ObjectFilter::AllOf([@and($plural, $object_did_not_attack_turn), Not(AllOf([$filter_plural, State(CouldntAttack)]))]) */
plural_nonattacker_except_unable ::= plural "that" object_did_not_attack_turn "," "except" "for" filter_plural "that" "couldn't" "attack"

/* An announced spell is distinct from the permanent it targets. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:Any}), index:0} */
condition_stack_target ::= "target" "spell"

/* A threshold qualifies the same permanent named by the noun phrase. */
/* @sem ObjectFilter::Counters{kind:$counter_kind, comparison:GreaterOrEqual, value:$value} */
modifier_counter_threshold_on_it ::= "with" value "or" "more" counter_kind "counters" "on" "it"

/* A named permanent controlled by the ability controller, used as an ability source. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController)), Name($referenced_card_name)])} */
controlled_named_ability_source ::= filter_phrase "you" "control" "named" referenced_card_name

/* A single target may be either an ability of the stated kind or a spell
   satisfying the stated characteristic. The two filters retain their own scope. */
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Any, zones:[Stack]}), count:Exactly(Constant(1)), filter:AnyOf([AllOf([OnStack(Spell), $counter_spell_quality]), $counter_single_ability_kind])}), index:0}) */
counter_one_ability_or_filtered_spell ::= "target" counter_single_ability_kind "ability" "or" counter_spell_quality "spell"

counter_single_ability_kind ::= counter_ability_activated | counter_ability_triggered

/* @sem ObjectFilter::OnStack(Triggered) */
counter_ability_triggered ::= "triggered"

counter_spell_quality ::= adjective_colorless | adjective_nontype

/* A plural selection from one graveyard ranges over all owners; its enclosing
   payment must enforce that the selected cards share an owner. */
/* @sem CostObjectSelection::CostObjectSelection{objects:Matching{objects:Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$filter_phrase}), filter:OwnedBy(All)}, choose:Exactly($count_plural)} */
single_graveyard_card_selection ::= count_plural filter_phrase "cards" "from" "a" "single" "graveyard"

/* The later creature anaphor must refer to this exact target. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:CardType(Creature)}), index:0} */
excess_damage_creature_target ::= "target" "creature"

/* @sem PlayerRef::Active */
active_player_ref ::= "the" "active" "player"

/* A single-target spell constrained by the kind of permanent it targets. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:AllOf([OnStack(SingleTarget), TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$noun}))])}), index:0} */
retarget_spell_single_permanent ::= "target" "spell" "that" "targets" "only" "a" "single" noun

/* The controller is bound independently of the object and owns the counted graveyard. */
/* @sem @and($filter_plain, $controller_graveyard_qualifier) */
filter_controller_graveyard ::= filter_plain controller_graveyard_qualifier

/* @sem ObjectFilter::ControlledBy(Matching{binding:0, condition:Compare{left:CountObjects(Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any})), test:$condition_at_least}}) */
controller_graveyard_qualifier ::= "whose" "controller" "has" condition_at_least "cards" "in" "their" "graveyard"

/* Graveyard host phrases share the card filter across permanent and spell types. */
enchant_graveyard_filter ::= filter_phrase | spell_instant | spell_sorcery

/* @sem EnchantHosts::GraveyardCards{filter:$enchant_graveyard_filter, owners:All} */
enchant_graveyard_cards ::= enchant_graveyard_filter "card" "in" "a" "graveyard"

/* Another attachment excludes the Aura carrying this enchant ability; it refers to the host. */
/* @sem EnchantHosts::Permanents(@and($filter_plain, ObjectFilter::HasAttached(@and($filter_phrase, ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)))))) */
enchant_host_with_another_attachment ::= filter_plain "with" "another" filter_phrase "attached" "to" "it"

/* The two printed land subtypes are distinct filters on the same permanent. */
/* @sem ObjectFilter::AllOf([Subtype(Urzas), $urzas_land_subtype]) */
filter_urzas_land_subtypes ::= "Urza's" urzas_land_subtype

/* @sem ObjectFilter::Subtype(PowerPlant) */
urzas_land_power_plant ::= "Power-Plant"

/* @sem ObjectFilter::Subtype(Mine) */
urzas_land_mine ::= "Mine"

/* @sem ObjectFilter::Subtype(Tower) */
urzas_land_tower ::= "Tower"

urzas_land_subtype ::= urzas_land_power_plant | urzas_land_mine | urzas_land_tower

/* Preserve the natural control-before-name order for a plural population. */
/* @prefer always */
/* @sem @and($plural_head, @and($plural_control_modifier, $modifier_chosen_name)) */
plural_controlled_chosen_name ::= plural_head plural_control_modifier modifier_chosen_name

plural_control_modifier ::= modifier_opponents_control | modifier_you_control

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$above_base_creature_kind, ControlledBy(One(AbilityController)), State(PowerAboveBase)])} */
controlled_creatures_above_base ::= "for" "each" above_base_creature_kind "you" "control" "with" "power" "greater" "than" "that" "creature's" "base" "power"

above_base_creature_kind ::= noun_creature | qualified_above_base_creature

/* @sem @and($quality_unscoped, $noun_creature) */
qualified_above_base_creature ::= quality_unscoped noun_creature

/* A targeted card in the ante, including its explicit type restriction. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Ante]}), count:Exactly(Expr::Constant(1)), filter:Any}), index:0} */
target_ante_card ::= "target" "card" "in" "the" "ante"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Ante]}), count:Exactly(Expr::Constant(1)), filter:$card_filter}), index:0} */
target_ante_filtered_card ::= "target" card_filter "card" "in" "the" "ante"

target_ante_object ::= target_ante_card | target_ante_filtered_card

/* A pair of blocking targets belonging to one opponent, addressed by index. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(2)), filter:AllOf([Blocking, $plural, ControlledBy(OpponentsOf(AbilityController))]), constraints:[CommonProperty(Controllers)]}), index:0} */
blocking_pair_first ::= "two" "target" "blocking" plural "controlled" "by" "the" "same" "opponent"

/* Exiled cards selected for movement to the appropriate owner's graveyard. */
exiled_card_to_owner_graveyard ::= linked_exiled_card_to_owner_graveyard | filtered_linked_exiled_card_to_owner_graveyard | opponent_exiled_card_to_owner_graveyard

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)} */
linked_exiled_card_to_owner_graveyard ::= "a" "card" "exiled" "with" object_ref "into" "its" "owner's" "graveyard"

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_phrase, ExiledWith($object_ref)])} */
filtered_linked_exiled_card_to_owner_graveyard ::= "a" filter_phrase "card" "exiled" "with" object_ref "into" "its" "owner's" "graveyard"

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:OwnedBy(OpponentsOf(AbilityController))} */
opponent_exiled_card_to_owner_graveyard ::= "a" "card" "an" "opponent" "owns" "from" "exile" "into" "that" "player's" "graveyard"

/* A counter payment chooses one permanent matching the current filter. */
counter_payment_source ::= counter_payment_source_a | counter_payment_source_an | counter_payment_source_another

/* @sem $filter_phrase */
counter_payment_source_a ::= "a" filter_phrase

/* @sem $filter_phrase */
counter_payment_source_an ::= "an" filter_phrase

/* @sem ObjectFilter::AllOf([Not(SameObject(Source)), $filter_phrase]) */
counter_payment_source_another ::= "another" filter_phrase

/* Each member of either controlled population, with inclusive and/or wording. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::@or($controlled_union_compound, $noun), ObjectFilter::ControlledBy(One(AbilityController)))} */
objects_each_controlled_and_or_union ::= "each" controlled_union_compound "and" "/" "or" noun "you" "control"

/* A typed head is one branch of this union, independently of the other noun. */
/* @sem @and($noun_atomic, $filter_simple) */
controlled_union_compound ::= noun_atomic filter_simple

/* Both zones belong to the ability controller and share the selected filter. */
/* @sem ObjectSet::Union([Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase})]) */
private_spell_population ::= filter_phrase "spell" "from" "your" "hand" "or" "graveyard"

/* A disjunction of five plural populations joined by the Oracle and/or form. */
/* @sem ObjectFilter::AnyOf([$filter_plural, $filter_plural_2, $filter_plural_3, $filter_phrase, $filter_plural_4]) */
plural_five_and_or ::= filter_plural "," filter_plural "," filter_plural "," filter_phrase "," "and" "/" "or" filter_plural
