compared_battlefield_population ::= "all" filter_plural modifier_stat_compared

/* A historical entry qualifies each current battlefield object independently of the action's other operands. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::Condition(Compare{left:EventHistory{event:ZoneChange{objects:AllOf([SameObject(Candidate), ControlledBy(One(AbilityController))]), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}))} */
objects_each_entered_under_you_this_turn ::= "each" filter_phrase "that" "entered" "the" "battlefield" "under" "your" "control" "this" "turn"

/* The named player owns this graveyard population. */
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One($zone_that_player)}, kind:Card, filter:Any} */
referenced_player_graveyard_population ::= zone_that_player "graveyard"

/* The crewed object is resolved before introducing the target.  This phrase is
   opt-in for contexts where the prior event supplies its antecedent. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, $filter_that_crewed_this_turn])}), index:0} */
target_that_crewed_event_subject ::= "target" noun filter_that_crewed_this_turn

/* A plural battlefield population with a separately stated excluded quality. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, Not($quality_unscoped)])} */
exile_excluded_quality_population ::= "all" filter_plural "that" "aren't" quality_unscoped

/* The history test applies to the candidate selected by this target. Keeping
   it on the target phrase avoids changing attack-occurrence count operands. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:@and($filter_phrase, $object_attacked_turn)}), index:0} */
target_attacked_this_turn ::= "target" filter_phrase "that" object_attacked_turn

/* The amount, alternative spell qualities, and controller are separate operands. */
controlled_spell_cost_selection ::= controlled_spell_cost_one | controlled_spell_cost_many | controlled_spell_cost_unqualified_one | controlled_spell_cost_unqualified_many | controlled_spell_cost_qualified_one | controlled_spell_cost_any_one | controlled_spell_cost_unqualified

/* @sem CostObjectSelection::CostObjectSelection{objects:Zone{scope:Shared(Stack), kind:Spell, filter:AllOf([$controlled_spell_cost_filter, ControlledBy(One(AbilityController))])}, choose:Exactly($counter_a)} */
controlled_spell_cost_one ::= counter_a controlled_spell_cost_filter "spell" "you" "control"

/* @sem CostObjectSelection::CostObjectSelection{objects:Zone{scope:Shared(Stack), kind:Spell, filter:AllOf([$controlled_spell_cost_filter, ControlledBy(One(AbilityController))])}, choose:Exactly(@plural_amount($number_words))} */
controlled_spell_cost_many ::= number_words controlled_spell_cost_filter "spells" "you" "control"

/* @sem ObjectFilter::AnyOf([$spell_adjective, $spell_adjective_2]) */
controlled_spell_cost_filter ::= spell_adjective "or" spell_adjective

/* The attached population refers to the very same target group. */
/* @sem ObjectSet::Union([Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:AnyNumber, filter:$plural})), Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, AttachedTo(InSet(Targets(@last_slot)))])}]) */
objects_targets_and_attached ::= "any" "number" "of" "target" plural "and" "all" filter_plural "attached" "to" "them"

/* State and control qualify the same plural population. */
/* @sem @and($adjective_unblocked, $controlled_plural_population) */
unblocked_controlled_plural ::= adjective_unblocked controlled_plural_population

/* @sem @and($filter_plural, $modifier_you_control) */
controlled_plural_population ::= filter_plural modifier_you_control

/* @sem Recipients::Union([Players(One(PlayerRef::AbilityController)), Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase})]) */
recipients_you_and_each ::= "you" "and" "each" filter_phrase

/* A target's comparative characteristic is measured against the event subject.
   Keep this abbreviated wording inside target syntax; it is not a general modifier. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:@and($filter_phrase, $target_event_stat_comparison)}), index:0} */
target_relative_event_stat ::= "target" filter_phrase target_event_stat_comparison

/* @sem ObjectFilter::Property{property:$creature_stat, test:NumberTest::Compare{comparison:$relative_stat_order, value:Expr::ObjectProperty{object:EventSubject, property:$creature_stat, information:CurrentOrLastKnown}}} */
target_event_stat_comparison ::= "with" relative_stat_order creature_stat

relative_stat_order ::= kin_greater | kin_lesser

/* Each current permanent is qualified by its own attack history. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::Condition(Compare{left:EventHistory{event:Object{event:Attacks, objects:SameObject(Candidate)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}))} */
objects_each_attacked_this_turn ::= "each" filter_phrase "that" "attacked" "this" "turn"

/* The keyword exclusion and the singular combat qualifier both restrict the head. */
/* @sem @and($modifier_without_keyword, $attacking_defender_you) */
modifier_without_keyword_attacking_you ::= modifier_without_keyword "that's" attacking_defender_you

/* The opponent selecting this target must control the selected permanent. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ControlledBy(One(OneOf(OpponentsOf(AbilityController))))]), chooser:OneOf(OpponentsOf(AbilityController))}), index:0} */
opponent_choice_controlled_target ::= "target" noun "of" "an" "opponent's" "choice" "they" "control"

/* @sem @and($adjective_goaded, $filter_plural) */
filter_plural_goaded ::= adjective_goaded filter_plural

/* Folded subtype heads compose only with an explicit controller here. */
/* @sem @and($folded_controlled_plural_head, $plural_control_modifier) */
folded_controlled_plural ::= folded_controlled_plural_head plural_control_modifier

folded_controlled_plural_head ::= subtype_plural | attachment_auras

/* Folded sentence-initial Aura plural. */
/* plural_aura_lower is shared as attachment_auras. */

/* Cycling refers to a card in hand, independently of the ability holder. */
cycling_card_noun ::= cycling_another_card_noun | a_card_any

/* @prefer always */
/* @sem ObjectFilter::Any */
cycling_another_card_noun ::= "another" "card"

/* A singular graveyard target with an unspecified arrival origin. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and($card_filter, ObjectFilter::ArrivedThisTurn{})}), index:0} */
target_card_from_graveyard_arrived ::= "target" card_filter "card" "from" "a" "graveyard" "that" "was" "put" "there" "this" "turn"

/* Each player supplies at most one target, and the two filters remain independent. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(CountPlayers(All)), filter:AllOf([$adjective_nontype, $adjective_nontype_2, Any, ControlledBy(All)]), constraints:[DifferentControllers]})) */
each_player_distinct_negative_targets ::= "for" "each" "player" "," "choose" "target" adjective_nontype "," adjective_nontype "permanent" "that" "player" "controls"

/* @sem ObjectFilter::CreatedWith($object_ref) */
modifier_created_with_object ::= "created" "with" object_ref

/* Postpositive card qualities and their zone population compose independently. */
/* postpositive_color_union is shared as spell_cast_color_pair. */

postpositive_card_color ::= spell_cast_color_pair | adjective_color

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$postpositive_card_color} */
all_graveyards_postqualified_cards ::= "all" "cards" "that" "are" postpositive_card_color "from" "all" "graveyards"

/* A singular card selected from the cards linked to a named object. */
linked_exile_copy_card ::= linked_exile_copy_card_a | linked_exile_copy_card_an_artifact

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_phrase, InSet(Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)})])} */
linked_exile_copy_card_a ::= "a" filter_phrase "card" "exiled" "with" object_ref

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$noun_artifact, InSet(Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)})])} */
linked_exile_copy_card_an_artifact ::= "an" noun_artifact "card" "exiled" "with" object_ref

/* A population of attachments and the independently filtered hosts. */
/* @sem @and($attachment_plural_head, ObjectFilter::AttachedTo(InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}))) */
plural_attached_to_population ::= attachment_plural_head "attached" "to" filter_plural

attachment_plural_head ::= plural | attached_aura_plural

/* @prefer always */
/* @sem ObjectFilter::Subtype(Aura) */
attached_aura_plural ::= "auras"

/* A controlled singular noun and its positive named-counter qualifier compose independently. */
/* @sem @and($controlled_singular_population, $singular_named_counters_on_it) */
controlled_singular_named_counters ::= controlled_singular_population singular_named_counters_on_it

/* @sem ObjectFilter::Counters{kind:$counter_kind, comparison:Greater, value:Expr::Constant(0)} */
singular_named_counters_on_it ::= "with" counter_kind "counters" "on" "it"

/* Owner and counter qualifiers describe the exiled population independently. */
/* @sem ObjectFilter::OwnedBy(OpponentsOf(AbilityController)) */
permission_opponents_own ::= "your" "opponents" "own"

permission_exile_owner ::= permission_opponents_own | modifier_you_own

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$permission_exile_owner, $modifier_named_counters_on_them])} */
permission_exile_owned_counter_cards ::= "cards" "in" "exile" permission_exile_owner modifier_named_counters_on_them

/* A permanent described by its type and a morph ability. */
/* @sem ObjectFilter::AllOf([$noun, HasKeywordFamily(Morph)]) */
filter_with_morph_ability ::= noun "with" "a" "morph" "ability"

/* The counter kind and announced threshold are independent of the modified noun. */
/* @sem ObjectFilter::Counters{kind:$counter_kind, comparison:Less, value:Expr::AnnouncedX} */
modifier_fewer_than_x_named_counters_on_it ::= "with" "fewer" "than" "X" counter_kind "counters" "on" "it"

/* A random target retains its opponent controller and target constraint. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ControlledBy(OpponentsOf(AbilityController))]), constraints:[AtRandom]}), index:0} */
random_opponent_controlled_target ::= "target" noun "an" "opponent" "controls" "chosen" "at" "random"

/* Other excludes the resolving ability; controller restrictions remain independent. */
retarget_each_population ::= retarget_other_stack_population | retarget_other_controlled_stack_population

/* @sem ObjectFilter::Not(OnStack(ThisAbility)) */
retarget_other_stack_population ::= "other" "spells" "and" "/" "or" "abilities"

/* @sem ObjectFilter::AllOf([Not(OnStack(ThisAbility)), ControlledBy(One(AbilityController))]) */
retarget_other_controlled_stack_population ::= "other" "spells" "and" "/" "or" "abilities" "you" "control"

/* Compare the same controlled population against every other player. */
/* @sem PlayerSet::Matching{binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}), test:NumberTest::Compare{comparison:Greater, value:AmongPlayers{players:OthersThan(Bound(0)), number:Permanents($filter_plural), aggregation:Maximum}}}} */
player_more_permanents_than_others ::= "a" "player" "who" "controls" "more" filter_plural "than" "each" "other" "player"

/* A shared action may select three independently described zone populations. */
/* @sem ObjectSet::Union([$cross_zone_battlefield, $cross_zone_private, $cross_zone_private_2]) */
cross_zone_three_populations ::= cross_zone_battlefield "," cross_zone_private "," "and" cross_zone_private

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf(@unordered([$filter_plural, $filter_plural_2, $filter_plural_3]))} */
cross_zone_battlefield ::= "all" filter_plural "," filter_plural "," "and" filter_plural "from" "the" "battlefield"

cross_zone_private ::= cross_zone_graveyards | cross_zone_hands

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:Any} */
cross_zone_graveyards ::= "all" "cards" "from" "all" "graveyards"

/* @sem ObjectSet::Zone{scope:Players{zone:Hand, players:All}, kind:Card, filter:Any} */
cross_zone_hands ::= "all" "cards" "from" "all" "hands"

/* The controller predicate applies to the stack abilities, not their sources. */
/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Ability, filter:$counter_abilities_controller} */
counter_controlled_abilities ::= "all" "abilities" counter_abilities_controller

counter_abilities_controller ::= modifier_opponents_control | modifier_you_control

/* Ownership applies to the entire union in every zone. */
/* @prefer always */
/* @sem ObjectSet::AnyZone(AllOf([AllOf([$subtype_negated, AnyOf([$spell_instant, $spell_sorcery])]), OwnedBy(One(AbilityController))])) */
owned_negated_spell_cards ::= "all" subtype_negated spell_instant "and" spell_sorcery "cards" "you" "own"

/* Both printed filters are independent members of the owned population. */
/* @sem ObjectSet::AnyZone(AllOf([AnyOf([$filter_phrase, $filter_phrase_2]), OwnedBy(One(AbilityController))])) */
owned_two_filtered_cards ::= "all" filter_phrase "cards" "and" filter_phrase "cards" "you" "own"

/* Self-comparison qualifies the same candidate in either population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(PlayerRef::AbilityController)), $self_toughness_greater_power)} */
objects_each_self_comparison_controlled ::= "each" filter_phrase "you" "control" self_toughness_greater_power

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, $self_toughness_greater_power)} */
objects_each_self_comparison ::= "each" filter_phrase self_toughness_greater_power

/* @sem ObjectFilter::Property{property:Toughness, test:NumberTest::Compare{comparison:Greater, value:ObjectProperty{object:Candidate, property:Power, information:CurrentOrLastKnown}}} */
self_toughness_greater_power ::= "with" "toughness" "greater" "than" "its" "power"

/* Ownership and control are independent restrictions on the same object. */
/* @sem @and($modifier_you_own, ObjectFilter::ControlledBy(OthersThan(AbilityController))) */
modifier_owned_but_not_controlled ::= modifier_you_own "but" "don't" "control"

/* The graveyard and comparison qualify the same announced card. */
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($filter_phrase, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}), $lesser_event_mana_value)}), index:0}) */
target_card_in_your_graveyard_lesser_event ::= "target" filter_phrase "card" "in" "your" "graveyard" lesser_event_mana_value

/* The chosen object belongs to the population whose minimum is measured. */
/* @sem ObjectFilter::AllOf([@agree($noun, $plural_head), ControlledBy(OpponentsOf(AbilityController)), Property{property:$stat, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$plural_head, ControlledBy(OpponentsOf(AbilityController))])}, property:$stat, aggregation:Minimum}}}]) */
least_stat_opponents_population ::= "a" noun "with" "the" "least" stat "among" plural_head "your" "opponents" "control"

/* Restrict the spell's sole target to a player or a battlefield permanent. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:AllOf([OnStack(SingleTarget), AnyOf([TargetsAny(Players(All)), TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:Any}))])])}), index:0} */
retarget_spell_single_permanent_or_player ::= "target" "spell" "that" "targets" "only" "a" "single" "permanent" "or" "player"

/* Only spell domains can be operands of taking control of a spell. */
single_targeted_spell ::= retarget_single_spell | retarget_single_instant_sorcery | retarget_spell_single_permanent | retarget_spell_single_permanent_or_player | retarget_spell_only_source

/* @sem ObjectFilter::AnyOf([TargetsAny(Players(One(AbilityController))), TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun, ControlledBy(One(Chosen))])}))]) */
counter_targets_you_or_chosen_controlled ::= "targets" "you" "or" "a" noun "the" "chosen" "player" "controls"

/* Spacecraft has the same spelling in the plural. */
/* @sem ObjectFilter::AnyOf([$plural, $st_spacecraft]) */
plural_and_or_spacecraft ::= plural "and" "/" "or" st_spacecraft

/* A name recorded during the draft belongs to this card's draft record. */
/* @sem ObjectFilter::AllOf([CardType(Creature), DraftNoted(_{kind:Name, player:AbilityController, card:@card_name})]) */
draft_noted_name_creatures ::= "creatures" "with" "a" "name" "you" "noted" "for" "cards" "named" SELF_NAME

/* The named object and the other controlled members are disjoint. */
/* @sem ObjectSet::Union([One($sharing_named_creature), Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject($sharing_named_creature)), $filter_phrase, ControlledBy(One(AbilityController)), Shares{property:CreatureTypes, with:$sharing_named_creature}])}]) */
object_and_other_controlled_sharing_type ::= sharing_named_creature "and" "each" "other" filter_phrase "you" "control" "that" "shares" "a" "creature" "type" "with" "it"

/* @sem ObjectRef::@remember_operand(ObjectRef::@qualified_object(ObjectKind::Permanent, ObjectFilter::CardType(Creature))) */
sharing_named_creature ::= "that" "creature"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Ability, zones:[Stack]}), count:Exactly(Constant(1)), filter:AllOf([$counter_ability_kind, $modifier_you_control])}), index:0} */
copy_target_controlled_ability ::= "target" counter_ability_kind "ability" modifier_you_control

/* The ability source is distinct from this ability's source. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Ability, zones:[Stack]}), count:Exactly(Constant(1)), filter:AllOf([$counter_ability_kind, $modifier_you_control, AbilityOf($copy_other_source_filter)])}), index:0} */
copy_target_other_sourced_ability ::= "target" counter_ability_kind "ability" modifier_you_control "from" copy_other_source_filter

/* @sem @and($adjective_legendary, ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source)), ObjectFilter::Not(ObjectFilter::State(Commander))) */
copy_other_source_filter ::= "another" adjective_legendary "source" "that's" "not" "a" "commander"

/* Independent populations in a creature-type sharing comparison. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))} */
shared_type_controlled_population ::= "a" filter_phrase "you" "control"

/* A target controlled by the opponent in the indicated seat. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(PlayerRef::Seat{of:AbilityController, side:Left})))}), index:0} */
target_left_opponent_permanent ::= "target" filter_phrase "the" "opponent" "to" "your" "left" "controls"

/* The extreme is computed over the named population, including all ties. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::Property{property:$creature_stat, test:NumberTest::Compare{comparison:Equal, value:Expr::Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, property:$creature_stat, aggregation:$extreme_aggregation}}})} */
each_battlefield_extreme ::= "each" filter_phrase "on" "the" "battlefield" "with" "the" extreme_aggregation creature_stat

/* A singular relative clause negates the stated quality of each member. */
/* @sem ObjectFilter::Not($relative_negated_quality) */
modifier_thats_not_quality ::= "that's" "not" relative_negated_quality

relative_negated_quality ::= adjective_historic

/* The controller and the separately announced object receive the same damage. */
/* @sem Recipients::Union([Players(One(AbilityController)), Objects(One($target_object))]) */
recipients_you_and_target_object ::= "you" "and" target_object

/* @sem ObjectFilter::AnyOf([Property{property:BasePower, test:NumberTest::Compare{comparison:$bound, value:Expr::@in_filter($number)}}, Property{property:BaseToughness, test:NumberTest::Compare{comparison:$bound, value:Expr::@in_filter($number)}}]) */
modifier_base_either_bound ::= "each" "with" "base" "power" "or" "toughness" number "or" bound

/* A controlled permanent matching a subtype or another qualified kind. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([AnyOf([$subtype, $filter_simple]), ControlledBy(One(AbilityController))])}), index:0} */
target_controlled_subtype_or_filter ::= "target" subtype "or" filter_simple "you" "control"

/* @prefer always */
/* @sem ObjectFilter::Property{property:ColorCount, test:NumberTest::Compare{comparison:NotEqual, value:Expr::Constant(5)}} */
modifier_not_all_colors ::= "that" "isn't" "all" "colors"

/* The exclusion and controller constrain the same chosen target. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($filter_phrase, ObjectFilter::AllOf([ControlledBy(One(AbilityController)), $modifier_other_than_self]))}), index:0} */
target_controlled_other_self ::= "target" filter_phrase "you" "control" modifier_other_than_self

/* Stack populations preserve the distinction between spells and abilities. */
/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Ability, filter:Any} */
stack_all_abilities ::= "all" "abilities"

/* @sem ObjectSet::Zone{scope:Shared(Stack), kind:Spell, filter:Any} */
stack_all_spells ::= "all" "spells"

/* A creature population excluding the identified object. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$plural_creature, Not(SameObject($object_ref))])} */
creatures_except_object ::= "all" plural_creature "except" "for" object_ref

/* The modifier describes the prior controller of the counted object. */
/* @sem ObjectFilter::AllOf([Not(Token), $filter_phrase, ControlledBy(One(AbilityController))]) */
prior_controlled_nontoken_filter ::= "nontoken" filter_phrase "you" "controlled"

/* The attachment filter includes its own controller or other qualifiers. */
/* @sem ObjectFilter::HasAttached($filter_plural) */
modifier_enchanted_by_plural ::= "that" "are" "enchanted" "by" filter_plural

/* Each exclusion refers to its own independently bound object. */
/* @sem @and($filter_plain, ObjectFilter::Not(ObjectFilter::SameObject($object_ref)), ObjectFilter::Not(ObjectFilter::SameObject($object_ref_2))) */
filter_two_object_exclusions ::= filter_plain "other" "than" object_ref "or" object_ref

/* @prefer always */
/* @sem @and($adjective_nonattacking, $quality, $filter_plain) */
filter_nonattacking_comma_quality ::= adjective_nonattacking "," quality filter_plain

/* @sem ObjectFilter::Not(Blocking) */
adjective_nonblocking ::= "nonblocking"

/* The optional graveyard target composes a card characteristic with its numeric qualifier. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:UpTo(Expr::Constant(1)), filter:@and($card_filter, $modifier_mana_value_numeric)}), index:0} */
target_card_up_to_qualified_a_graveyard ::= "up" "to" "one" "target" card_filter "card" modifier_mana_value_numeric "from" "a" "graveyard"

/* A bounded group of subtype alternatives in its controller's graveyard. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo($number), filter:AllOf([AnyOf([$subtype, $subtype_2]), InZone(Players{zone:Graveyard, players:One(AbilityController)})])})) */
target_up_to_subtype_pair_your_graveyard ::= "up" "to" number "target" subtype "and" "/" "or" subtype "cards" "from" "your" "graveyard"

/* The subtype union and permanent-card domain remain independent target filters. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo($number), filter:AllOf([AnyOf([$subtype, $subtype_2]), AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]), InZone(Players{zone:Graveyard, players:One(AbilityController)})])})) */
graveyard_subtype_union_permanent_targets ::= "up" "to" number "target" subtype "and" "/" "or" subtype "permanent" "cards" "from" "your" "graveyard"

/* This target set is used with the matching source-enchantment X definition. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(TimesKicked(Source)), filter:AllOf([$noun, InZone(Players{zone:Graveyard, players:One(AbilityController)})])})) */
kicked_graveyard_targets ::= "up" "to" "X" "target" noun "cards" "from" "your" "graveyard"

/* A target constrained by the current host. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:@and($filter_phrase, ObjectFilter::AttachedTo(InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$seek_card_filter})))}), index:0} */
target_attached_to_permanent ::= "target" filter_phrase "that's" "attached" "to" "a" seek_card_filter

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo($number), filter:AllOf([$milled_return_filter, ArrivedThisTurn{from:Battlefield}])})) */
