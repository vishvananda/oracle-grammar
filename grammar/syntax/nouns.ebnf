/* @sem ObjectFilter::AnyOf([$filter_phrase, $filter_phrase_2, $filter_phrase_3]) */
that_is_three_kinds ::= "that's" "a" filter_phrase "," "a" filter_phrase "," "or" "a" filter_phrase

/* A singular battlefield population and its explicit excluded class. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, Not($filter_phrase_2)])} */
