filter_same_name_exception ::= filter_nonlist_head modifier_same_name_another "," except_plural_filter

/* The two references retain their separate identities in the history predicate. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($object_ref), AllOf([$filter_plural, Condition(Compare{left:EventHistory{event:Pair{event:Blocks, objects:SameObject(Candidate), others:SameObject($object_ref_2)}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})])])} */
combat_history_union ::= object_ref "and" "all" filter_plural object_ref "blocked" "this" "turn"

