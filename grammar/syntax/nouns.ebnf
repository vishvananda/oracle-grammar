/* @sem ObjectFilter::AnyOf(@unordered([$quantified_union_first, $filter_plural, $filter_plural_2])) */
filter_plural_quantified_three ::= quantified_union_first "," "all" filter_plural "," "and" "all" filter_plural

quantified_union_first ::= filter_plural_tail | filter_plural_except_shared

