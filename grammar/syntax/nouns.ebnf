modifier_doesnt_have_counter ::= "that" "doesn't" "have" "a" counter_kind "counter" "on" "it"

/* A population characteristic compared with a separately evaluated value. */
/* @sem ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:Greater, value:$value}} */
modifier_stat_greater_value ::= "with" stat "greater" "than" value

/* @prefer always */
/* @sem ObjectSet::Union([Zone{scope:Players{zone:$paired_card_zone_second, players:$paired_zone_owners}, kind:Card, filter:Any}, Zone{scope:Players{zone:$paired_card_zone, players:$paired_zone_owners}, kind:Card, filter:Any}]) */
