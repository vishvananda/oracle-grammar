self_and_other_same_name ::= self_ref_holder "and" "each" "other" filter_phrase "with" "the" "same" "name" "as" "it"

/* A controlled target and its counter-absence predicate are independent operands. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:@and($controlled_singular_population, $modifier_doesnt_have_counter)}), index:0} */
