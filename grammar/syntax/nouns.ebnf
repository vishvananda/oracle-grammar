/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly($number), filter:AllOf([$noun, InZone(Players{zone:Graveyard, players:One(AbilityController)})])})) */
counted_own_graveyard_targets ::= number "target" noun "cards" "from" "your" "graveyard"

