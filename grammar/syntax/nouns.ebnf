/* @sem ObjectFilter::AllOf([$filter_phrase, $modifier_mana_value_numeric]) */
bounded_card_filter ::= filter_phrase "card" modifier_mana_value_numeric

/* The choice belongs to an opponent; control remains independently restricted. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:@and($filter_phrase, ObjectFilter::ControlledBy(OthersThan(AbilityController))), chooser:OneOf(OpponentsOf(AbilityController))}), index:0} */
target_opponent_choice_not_controlled ::= "target" filter_phrase "of" "an" "opponent's" "choice" "you" "don't" "control"

/* The chosen permanent and the targeted player's entire graveyard move together. */
/* @sem ObjectSet::Union([Selected(@prior), Zone(_{scope:Players{zone:Graveyard, players:One(Target{slot:0, index:0})}, kind:Card, filter:Any})]) */
selected_and_targeted_graveyard ::= "and" "their" "graveyard"

/* The filter applies before taking cards in graveyard order. */
/* @sem ObjectSet::Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:InSet(Take{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$adjective_color}), count:$value, from:$ordered_end})}) */
ordered_filtered_graveyard_cards ::= "the" ordered_end value adjective_color "cards" "of" "your" "graveyard"

