/* @sem ObjectFilter::Not(ObjectFilter::CardType(Battle)) */
non_battle ::= "nonbattle"

/* A six-way subtype list denotes one target in the shared battlefield. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AnyOf($target_subtype_members)}), index:0} */
target_serial_subtype_union ::= "target" target_subtype_members

/* @sem ObjectFilter::[$union_subtype, ...$target_subtype_members_tail] */
target_subtype_members ::= union_subtype "," target_subtype_members_tail

target_subtype_members_tail ::= target_subtype_members_last_pair | target_subtype_members
/* @sem ObjectFilter::[$union_subtype, $union_subtype_2] */
