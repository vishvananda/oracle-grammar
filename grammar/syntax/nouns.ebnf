conjure_name_0 ::= "Ancestral" "Recall"

/* @sem String::'Black Lotus' */
conjure_name_1 ::= "Black" "Lotus"

/* @sem String::'Mox Emerald' */
conjure_name_2 ::= "Mox" "Emerald"

/* @sem String::'Mox Jet' */
conjure_name_3 ::= "Mox" "Jet"

/* @sem String::'Mox Pearl' */
conjure_name_4 ::= "Mox" "Pearl"

/* @sem String::'Mox Ruby' */
conjure_name_5 ::= "Mox" "Ruby"

/* @sem String::'Mox Sapphire' */
conjure_name_6 ::= "Mox" "Sapphire"

/* @sem String::'Time Walk' */
conjure_name_7 ::= "Time" "Walk"

/* @sem String::'Timetwister' */
conjure_name_8 ::= "Timetwister"

/* @sem String::'Lightning Bolt' */
conjure_name_9 ::= "Lightning" "Bolt"

/* A filtered card population in a targeted player's hand. */
/* @sem ObjectSet::Zone{scope:Players{zone:Hand, players:One($target_hand_owner)}, kind:Card, filter:$filter_phrase} */
filtered_cards_in_target_hand ::= "the" filter_phrase "cards" "in" target_hand_owner "hand"

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Expr::Constant(1)), filter:Any, players:OpponentsOf(PlayerRef::AbilityController)}), index:0} */
target_opponent_hand_owner ::= "target" "opponent's"

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Expr::Constant(1)), filter:Any, players:All}), index:0} */
target_player_hand_owner ::= "target" "player's"

target_hand_owner ::= target_opponent_hand_owner | target_player_hand_owner

/* The noted type is associated with the named draft card, independently of
   the affected permanent and of the ability holder. */
/* @sem ObjectFilter::DraftNoted(_{kind:CreatureType, player:AbilityController, card:@card_name}) */
modifier_draft_noted_self_type ::= "of" "a" "type" "you" "noted" "for" "cards" "named" SELF_NAME

/* @sem ObjectFilter::DraftNoted(_{kind:CreatureType, player:AbilityController, card:$referenced_card_name}) */
modifier_draft_noted_creature_type ::= "of" "a" "type" "you" "noted" "for" "cards" "named" referenced_card_name

/* A linked exile target carries its own card filter and source identity. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Exile]}), count:Exactly(Constant(1)), filter:AllOf([$noun, ExiledWith(Source)])}), index:0} */
target_card_exiled_with_source ::= "target" noun "card" "exiled" "with" "this" "creature"

/* Cast-origin qualifiers remain operands of a stack target, shared by counter actions. */
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:$counter_cast_origin}), index:0}) */
counter_one_cast_from_zone ::= "target" "spell" counter_cast_origin

counter_cast_origin ::= counter_cast_from_graveyard | counter_cast_from_hand

/* @sem ObjectFilter::Cast{from:Players{zone:Graveyard, players:All}} */
counter_cast_from_graveyard ::= "cast" "from" "a" "graveyard"

/* @sem ObjectFilter::Cast{from:Players{zone:Hand, players:All}} */
counter_cast_from_hand ::= "cast" "from" "a" "hand"

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$card_filter_union} */
payment_graveyard_card_union ::= card_filter_union

/* @sem ObjectFilter::AnyOf(@unordered([$filter_phrase, $filter_phrase_2])) */
card_filter_union ::= filter_phrase "card" "or" filter_phrase "card"

/* Linked exile populations retain the anchor and any independent filter. */
/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)} */
linked_exiled_each ::= "each" "card" "exiled" "with" object_ref

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)} */
linked_exiled_all ::= "all" "cards" "exiled" "with" object_ref

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_phrase, ExiledWith($object_ref)])} */
linked_exiled_filtered_each ::= "each" filter_phrase "card" "exiled" "with" object_ref

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:Counters{kind:$counter_kind, comparison:Greater, value:Constant(0)}} */
exiled_with_counters ::= "all" "exiled" "cards" "with" counter_kind "counters" "on" "them"

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([Not(SameObject(Result{result:@prior, phase:After, index:0})), AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]), ExiledWith($object_ref)])} */
linked_exiled_other_permanents ::= "all" "other" "permanent" "cards" "exiled" "with" object_ref

/* @sem ObjectRef::@member_count_it(ObjectRef::@it) */
her_ref ::= "her"

/* The explicit location qualifies the same battlefield population as all permanents. */
/* @sem ObjectSet::@distributive_pump_subject(ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}) */
objects_all_battlefield ::= "all" filter_plural "on" "the" "battlefield"

/* Both values describe the same property of the selected object. */
