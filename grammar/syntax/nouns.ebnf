plural_subtype_word ::= subtype_plural | plural_marked_bats | plural_marked_rats | plural_pegasi

/* @sem ObjectFilter::Subtype(Bat) */
plural_marked_bats ::= "↑" "bats"

/* @sem ObjectFilter::Subtype(Rat) */
