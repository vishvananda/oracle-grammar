personal_graveyard_named_cards ::= "all" "cards" modifier_referenced_name "from" "your" "graveyard"

target_exiled_card_for_owner_zone ::= target_face_qualified_exiled_card | target_exiled_keyword_card | target_face_up_zone_card

/* The exile-zone membership and announced filter belong to the same target. */
/* @sem ObjectSet::InZone{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Exile]}), count:Exactly(Constant(1)), filter:$exiled_card_qualification}), index:0}), zone:Exile} */
target_face_qualified_exiled_card ::= "target" exiled_card_qualification "exiled" "card"

