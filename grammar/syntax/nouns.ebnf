/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, InSet(Unselected(@prior))])} */
unselected_by_any_player_population ::= "all" filter_plural "that" "weren't" "chosen" "this" "way" "by" "any" "player"

/* Distinct characteristics measured across the same proved card receipt. */
