optional_target_player ::= "up" "to" "one" "target" "player"

/* Each target partition belongs to its corresponding opponent. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:OpponentsOf(AbilityController), each:UpTo(Constant(1))}, filter:$filter_phrase})) */
/* @prefer always */
opponent_optional_singular_targets ::= "up" "to" "one" "target" filter_phrase "that" "opponent" "controls"

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:OpponentsOf(AbilityController), each:UpTo($count_plural)}, filter:$filter_plural})) */
/* @prefer always */
opponent_optional_plural_targets ::= "up" "to" count_plural "target" filter_plural "that" "opponent" "controls"

/* The blocking relation is part of the announced target, with a separate controlled population. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($filter_phrase, ObjectFilter::BlockingAny(@and($filter_phrase_2, ObjectFilter::ControlledBy(One(AbilityController)))))}), index:0} */
target_blocking_controlled ::= "target" filter_phrase "that's" "blocking" "a" filter_phrase "you" "control"

/* A named card population retains its literal name and graveyard owner. */
