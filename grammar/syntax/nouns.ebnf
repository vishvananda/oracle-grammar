/* The target and its host have independent filters. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$subtype, AttachedTo(InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$noun}))])}), index:0} */
target_attached_to_indefinite ::= "target" subtype "attached" "to" "a" noun

