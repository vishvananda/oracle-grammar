copy_target_ability ::= copy_target_controlled_ability | copy_target_other_sourced_ability

/* Named source of an emblem is its granting object, not the emblem. */
/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:ExiledWith(GrantingObject)} */
emblem_granting_exile_cards ::= "cards" "exiled" "with" SELF_NAME

/* A choice across a battlefield population and two of your card zones. */
/* @sem ObjectSet::Union([Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, $choice_private_cards, AnyZone(InZone(Players{zone:Graveyard, players:One(AbilityController)}))]) */
choice_permanent_or_private_cards ::= "a" filter_phrase "or" choice_private_cards "or" "graveyard"

choice_private_cards ::= choice_cards_hand | choice_cards_library

/* @sem ObjectSet::Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any} */
choice_cards_hand ::= "a" "card" "from" "your" "hand"

/* @sem ObjectSet::Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any} */
choice_cards_library ::= "a" "card" "from" "your" "library"

/* Owned commanders in the two public commander zones, preserving both domains. */
/* @sem ObjectSet::Union([Zone(_{scope:Shared(Command), kind:Card, filter:AllOf([State(Commander), State(Commander), OwnedBy(One(AbilityController))])}), Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([State(Commander), State(Commander), OwnedBy(One(AbilityController))])}]) */
owned_commander_battlefield_or_command ::= "a" "commander" "you" "own" "on" "the" "battlefield" "or" "in" "the" "command" "zone"

/* Sentence-initial capitalization folds this subtype token. */
/* @sem @and(ObjectFilter::Subtype(Vampire), $typed_plural_tail) */
filter_plural_folded_vampire ::= "vampire" typed_plural_tail

