players_each_last_chose ::= "each" "player" "who" "last" "chose" last_choice_word

/* The anaphor names the same enchanted creature that heads this population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf([SameObject($enchanted_creature_ref), AllOf([AttachedTo(SameObject($enchanted_creature_ref)), $filter_plural])])} */
enchanted_creature_and_attached_population ::= enchanted_creature_ref "and" "all" filter_plural "attached" "to" "that" "creature"

/* Exile permission populations preserve ownership and counter identity. */
