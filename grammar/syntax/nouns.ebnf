/* Contextual "other <filter>" excluding the source or contrasting reference. */
/* @sem ObjectFilter::AllOf([$filter_phrase, Not(SameObject(@target_contrast(ObjectRef::@pump_other_ref(ObjectRef::@move_after_other(ObjectRef::Source)), ObjectFilter::$filter_phrase)))]) */
