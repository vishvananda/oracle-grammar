/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(One(AbilityController)), Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})])} */
countered_owned_exile_population ::= "all" "exiled" "cards" "you" "own" "with" counter_kind "counters" "on" "them"

/* Battlefield populations compose the printed noun and its restrictions. */
counter_group_set ::= counter_group_controlled | counter_group_you_qualified | counter_group_fading

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy($players_singular))} */
counter_group_controlled ::= "each" filter_phrase players_singular "controls"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)), $counter_group_qualifier)} */
counter_group_you_qualified ::= "each" filter_phrase "you" "control" counter_group_qualifier

counter_group_qualifier ::= counter_group_type_choice | counter_group_either_type

