/* A chosen creature type is tested against each member of the population. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, Not(Chosen(CreatureType))])} */
unchosen_creature_type_population ::= "all" filter_plural "that" "aren't" "of" "a" "type" "chosen" "this" "way"

/* A repeated plural names the same announced group and must agree with its filter. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly($number), filter:@agree($plural, $plural_2), constraints:[DifferentControllers]})) */
different_controller_return_selection ::= "choose" number "target" plural "controlled" "by" "different" "players" "." "return" "those" plural

/* @sem ObjectFilter::AnyOf(@unordered([$owned_card_an, $owned_card_a, $card_ability_qualifier])) */
owned_zone_card_qualifier ::= "that's" "an" owned_card_an "card" "," "a" owned_card_a "card" "," "or" "a" "card" card_ability_qualifier

owned_card_an ::= spell_instant | noun_artifact | noun_enchantment

owned_card_a ::= spell_sorcery | noun_creature | noun_land | noun_planeswalker | noun_battle

/* The explicit creature head proves the loop member used by the anaphor. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($quality_unscoped, $noun_creature)} */
coin_creature_population ::= "each" quality_unscoped noun_creature

/* Spell-cost subjects with a counter-based mana-value bound. */
/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$distribution_counter_count}} */
cast_spell_counter_limit_less ::= "a" "spell" "you" "cast" "with" "mana" "value" "X" "or" "less" "," "where" "X" "is" distribution_counter_count

/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$distribution_counter_count}} */
cast_spell_counter_limit_greater ::= "a" "spell" "you" "cast" "with" "mana" "value" "X" "or" "greater" "," "where" "X" "is" distribution_counter_count

/* The unqualified card uses the same event-bound exclusion as a typed card. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Expr::Constant(1)), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@current_named_object)), ObjectFilter::InZone(Players{zone:Graveyard, players:One(PlayerRef::AbilityController)}))}), index:0} */
target_any_other_your_graveyard ::= "another" "target" "card" ("from" | "in") "your" "graveyard"

/* A four-way card filter remains a single population, qualified by its arrival. */
/* @sem ObjectFilter::AnyOf([$card_word, $card_word_2, $card_word_3, $card_word_4]) */
card_filter_four_and ::= card_word "," card_word "," card_word "," "and" card_word

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:@and($card_filter_four_and, $graveyard_arrival_origin)} */
graveyard_arrival_four_types ::= "all" card_filter_four_and "cards" "in" "your" "graveyard" graveyard_arrival_origin

/* @sem ObjectFilter::Any */
graveyard_move_any_filter ::= "the"

/* @sem $adjective_nontype */
graveyard_move_qualified_filter ::= "the" adjective_nontype

/* @sem $adjective_colorless */
graveyard_move_colorless_filter ::= "the" adjective_colorless

graveyard_move_filter ::= graveyard_move_any_filter | graveyard_move_qualified_filter | graveyard_move_colorless_filter

/* A permanent type qualified by either a supertype or producible mana. */
/* @sem @and($noun, ObjectFilter::AnyOf([$condition_supertype, ObjectFilter::CouldProduce($life_mana_result)])) */
filter_supertype_or_producible ::= noun "that" "is" condition_supertype "or" "could" "produce" life_mana_result

/* A population together with the cards in every graveyard. */
/* @sem ObjectSet::Union([$affected, Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:Any})]) */
exile_affected_and_graveyards ::= affected "and" "graveyards"

/* @sem ObjectSet::AnyZone(AllOf([OwnedBy(One(AbilityController)), State(HasX)])) */
owned_x_card_population ::= "each" "card" "you" "own" "with" "{" "X" "}" "in" "its" "mana" "cost"

/* A possessive target keeps the permanent filter in the announcement. */
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$possessive_permanent_filter}), index:0}) */
possessive_target_permanent ::= "target" possessive_permanent_filter

/* A named holder and another object form a reusable pair of references. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AnyOf(@unordered([SameObject($self_explicit_ref), SameObject($object_ref)]))} */
objects_self_and_reference ::= self_explicit_ref "and" object_ref

/* An optional other target retains the noun-specific exclusion anchor and controller. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo($number), filter:@and(ObjectFilter::Not(ObjectFilter::SameObject(@other_reference(ObjectFilter::$noun))), ObjectFilter::AllOf([State(DoubleFaced), $noun, ControlledBy(One(AbilityController))]))}), index:0} */
target_optional_other_double_faced_controlled ::= "up" "to" number "other" "target" "double-faced" noun "you" "control"

/* One controlled noncreature permanent is announced as the copied object. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(CardType(Creature)), $noun, ControlledBy(One(AbilityController))])}), index:0} */
copy_controlled_noncreature_target ::= "target" "noncreature" noun "you" "control"

/* The other attacker shares the event subject’s defending player or planeswalker. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(SameObject(@event_subject)), $noun, AttackingSame(@event_subject)])}), index:0} */
target_attacking_same_event ::= "another" "target" noun "attacking" "the" "same" "player" "or" "planeswalker"

/* The two target alternatives refer to the same event player. */
/* @sem Recipients::Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AnyOf([AllOf([$noun, ControlledBy(One(EventSubject))]), AllOf([CardType(Battle), ProtectedBy(One(EventSubject))])])}), index:0})) */
recipients_target_controlled_or_protected ::= "target" noun "that" "player" "controls" "or" "battle" "that" "player" "protects"

/* A tied maximum uses the same stated property for the candidate and population. */
/* @sem ObjectFilter::AllOf([$filter_phrase, Property{property:$stat, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, property:$stat, aggregation:Maximum}}}]) */
battlefield_extreme_filter ::= filter_phrase "with" "the" "greatest" stat "among" filter_plural "on" "the" "battlefield"

/* A name match against permanent sources that damaged the ability controller last turn. */
/* @sem ObjectFilter::SharesNameWithAny($damage_source_history) */
modifier_same_name_as_damage_history ::= "that" "has" "the" "same" "name" "as" "a" damage_source_history

damage_source_history ::= last_turn_damage_source | this_turn_damage_source

/* @sem ObjectSet::FromHistory{event:Damage(_{source_kind:Permanent, sources:$filter_phrase, recipients:Players(One(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Source}), window:LastTurn} */
last_turn_damage_source ::= filter_phrase "that" "dealt" "damage" "to" "you" "last" "turn"

/* @sem ObjectSet::FromHistory{event:Damage(_{source_kind:Permanent, sources:$filter_phrase, recipients:Players(One(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Source}), window:ThisTurn} */
this_turn_damage_source ::= filter_phrase "that" "dealt" "damage" "to" "you" "this" "turn"

/* A land target retains its declared filter for later scoped references. */
scoped_target_land ::= scoped_target_land_plain | scoped_target_land_negated

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Expr::Constant(1)), filter:CardType(Land)}), index:0} */
