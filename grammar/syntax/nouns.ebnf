permission_linked_exile_cards ::= linked_exile_card_source

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(One(AbilityController)), ExiledWith($object_ref)])} */
permission_owned_linked_exile_cards ::= "cards" "you" "own" "exiled" "with" object_ref

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([OwnedBy(OthersThan(AbilityController)), Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})])} */
permission_others_counter_exile_cards ::= "cards" "you" "don't" "own" "with" counter_kind "counters" "on" "them" "from" "exile"

/* Mixed alternatives retain the qualifier on its own list member. */
/* @sem ObjectFilter::AnyOf([$noun, $subtype, @and(ObjectFilter::Not(ObjectFilter::Supertype(Basic)), $noun_2)]) */
filter_mixed_nonbasic_list ::= noun "," subtype "," "or" "nonbasic" noun

/* @sem ObjectFilter::AnyOf([$noun, @and(ObjectFilter::Tapped, $noun_2), @and(ObjectFilter::Tapped, $noun_3)]) */
filter_mixed_tapped_list ::= noun "," "tapped" noun "," "or" "tapped" noun

/* @sem ObjectFilter::Counters{kind:$counter_kind, comparison:Greater, value:Expr::Constant(0)} */
modifier_has_named_counter ::= "that" "has" "a" counter_kind "counter" "on" "it"

/* @sem ObjectFilter::AttackingDefender(PlayersAndPlaneswalkers(One(AbilityController))) */
modifier_attacking_you_walkers ::= "that's" "attacking" "you" "or" "a" "planeswalker" "you" "control"

/* @sem ObjectFilter::Property{property:ColorCount, test:NumberTest::Compare{comparison:NotEqual, value:$number}} */
modifier_not_exactly_colors ::= "that" "isn't" "exactly" number "colors"

