objects_each_controlled_three_union ::= "each" filter_phrase "," filter_phrase "," "and" filter_phrase "you" "control"

/* An explicitly chosen group is announced before its later use in the spell. */
/* @sem TargetSpec::TargetSpec{slot:0, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly($number), filter:AllOf([$noun, InZone(Players{zone:Graveyard, players:One(AbilityController)})])} */
chosen_your_graveyard_target_group ::= "choose" number "target" noun "cards" "in" "your" "graveyard"

