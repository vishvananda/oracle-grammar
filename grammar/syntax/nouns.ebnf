/* @sem ObjectSet::Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith($object_ref)}) */
craft_trait_origin ::= "an" "exiled" "card" "used" "to" "craft" object_ref

/* The unearth qualifier belongs to this graveyard subject. */
