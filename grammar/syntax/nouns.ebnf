cards_from_all_paired_zones ::= "all" "cards" "from" "all" paired_card_zone "and" paired_card_zone_second

/* Five subtype alternatives qualify the same population. */
/* @sem ObjectFilter::AnyOf($controlled_kind_members) */
controlled_kind_union ::= controlled_kind_members

/* @sem ObjectFilter::[$controlled_kind_spelled, ...$controlled_kind_members_tail] */
controlled_kind_members ::= controlled_kind_spelled "," controlled_kind_members_tail

