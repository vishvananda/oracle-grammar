/* @sem ObjectFilter::Subtype(PowerPlant) */
urzas_land_power_plant ::= "Power-Plant"

/* @sem ObjectFilter::Subtype(Mine) */
urzas_land_mine ::= "Mine"

/* @sem ObjectFilter::Subtype(Tower) */
urzas_land_tower ::= "Tower"

urzas_land_subtype ::= urzas_land_power_plant | urzas_land_mine | urzas_land_tower

/* Preserve the natural control-before-name order for a plural population. */
/* @prefer always */
/* @sem @and($plural_head, @and($plural_control_modifier, $modifier_chosen_name)) */
