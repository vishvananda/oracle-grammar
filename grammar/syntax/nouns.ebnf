/* @sem ObjectFilter::HasAttached($aura_attachment_filter) */
modifier_enchanted_by_aura ::= "that's" "enchanted" "by" "an" aura_attachment_filter

aura_attachment_filter ::= aura_attachment_controlled | aura_attachment_unqualified

/* @sem ObjectFilter::@and(ObjectFilter::Subtype(Aura), $modifier_you_control) */
aura_attachment_controlled ::= "Aura" modifier_you_control

/* @sem ObjectFilter::Subtype(Aura) */
aura_attachment_unqualified ::= "Aura"

