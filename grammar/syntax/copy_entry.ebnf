/* Copiable exceptions compose; the last quoted sentence closes the outer one. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_explicit_ref)}, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:$entry_copy_actions}}]}}) */
entry_copy_ability ::= "you" "may" "have" self_explicit_ref "enter" "as" entry_copy_actions
entry_copy_objects ::= entry_copy_battlefield | entry_copy_graveyard_arrived | entry_copy_exile_counter | entry_copy_your_graveyard_from_library
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$entry_copy_choice} */
entry_copy_battlefield ::= entry_copy_choice
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:AllOf([$filter_phrase, ArrivedThisTurn{from:Battlefield}])} */
entry_copy_graveyard_arrived ::= "any" filter_phrase "card" "in" "a" "graveyard" "that" "was" "put" "there" "from" "the" "battlefield" "this" "turn"
entry_copy_choice ::= entry_copy_mana_spent | entry_copy_any | entry_copy_one
/* @sem $filter_phrase */
entry_copy_any ::= "any" filter_phrase "on" "the" "battlefield"
/* @sem $filter_phrase */
entry_copy_one ::= ("a" | "an") filter_phrase
entry_copy_tail ::= entry_copy_exact | entry_copy_except
/* @sem Vec<CopyException>::[] */
entry_copy_exact ::= "."
/* @sem $copy_exceptions_sentence */
entry_copy_except ::= "," "except" copy_exceptions_sentence

copy_exceptions_sentence ::= copy_exceptions_period | copy_exceptions_closed

/* @sem $copy_exceptions_plain */
copy_exceptions_period ::= copy_exceptions_plain "."

copy_exceptions_plain ::= copy_stats_artifact_creature_keyword | copy_colored_stats_types | copy_nonlegendary_with_loyalty | copy_artifact_creature_stats_list | copy_keyword_current | copy_exception_plain_one | copy_exception_plain_more | copy_exception_quote_then_plain | copy_token_stats_ability | copy_food_ability | copy_exception_oxford_more | copy_exception_comma_more | copy_keyword_without_soulbond | copy_not_legendary_and_type | copy_nonlegendary_stats_types

/* @sem Vec<CopyException>::[$copy_exception_plain] */
copy_exception_plain_one ::= copy_exception_plain

/* @sem Vec<CopyException>::[$copy_exception_plain, ...$copy_exceptions_plain] */
copy_exception_plain_more ::= copy_exception_plain "and" copy_exceptions_plain

/* @sem Vec<CopyException>::[$copy_granted_sentence, ...$copy_exceptions_plain] */
copy_exception_quote_then_plain ::= copy_granted_sentence ("↓")? "and" copy_exceptions_plain

copy_exceptions_closed ::= copy_current_then_quote | copy_same_name_goad_list | copy_exception_closed_one | copy_exception_plain_then_quote | copy_exception_quote_more | copy_keyword_then_quote

/* @sem Vec<CopyException>::[$copy_granted_sentence] */
copy_exception_closed_one ::= copy_granted_sentence

/* @sem Vec<CopyException>::[$copy_exception_plain, ...$copy_exceptions_closed] */
copy_exception_plain_then_quote ::= copy_exception_plain "and" copy_exceptions_closed

/* @sem Vec<CopyException>::[$copy_granted_sentence, ...$copy_exceptions_closed] */
copy_exception_quote_more ::= copy_granted_sentence ("↓")? "and" copy_exceptions_closed

copy_exception_plain ::= copy_remove_current | copy_add_legendary_retained | copy_add_legendary | copy_self_name | copy_named_name | copy_add_creature_type | copy_keyword_ability | copy_remove_legendary | token_copy_add_artifact | copy_has_current | copy_token_keyword | copy_add_creature_type_explicit | copy_add_legendary_snow_retained

/* @sem CopyException::AddCreatureTypes($becomes_types) */
copy_add_creature_type ::= "it's" ("a" | "an") becomes_types "in" "addition" "to" "its" "other" "types"

/* This ability belongs to the entering source; its event establishes its own
   references. No anaphor from outside the quotation is substituted into it. */
/* @sem $copy_quoted_ability */
copy_granted_sentence ::= "it" "has" copy_quoted_ability

/* @sem CopyException::AddAbilities([@scope($token_ability_sentence)]) */
copy_quoted_ability ::= '"' token_ability_sentence '"'

/* Keywords and mechanics retain their native Ability variants. Each addition
   has its own ability scope, independently of the copied object and creator. */
/* @sem $copy_added_keyword */
copy_keyword_ability ::= "it" "has" copy_added_keyword
/* @sem CopyException::AddAbilities([@scope($keyword_ability)]) */
copy_added_keyword ::= keyword_ability
/* @sem Vec<CopyException>::[$copy_keyword_ability, $copy_quoted_ability] */
copy_keyword_then_quote ::= copy_keyword_ability "and" copy_quoted_ability

/* The second branch refers to the explicitly named holder, not the event's
   future subject. List order follows the canonical IR for these two branches. */
/* @sem EventSpec::AnyOf([Damage(DamageEvent{source_kind:Permanent, sources:@and(ObjectFilter::Not(SameObject($self_explicit_ref)), $filter_phrase, ObjectFilter::SharesNameWith($self_explicit_ref)), recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source}), Damage(DamageEvent{source_kind:Permanent, sources:SameObject($self_explicit_ref), recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source})]) */
event_holder_or_same_name_damage ::= self_explicit_ref "or" "another" filter_phrase "with" "the" "same" "name" "deals" "combat" "damage" "to" "a" "player"


/* In "have this permanent become a copy of it", the copy operand refers to
   the previously named object; naming the recipient does not replace it. */
/* @sem ObjectRef::@named_object */
copy_previous_object ::= "it"

/* "Other" excludes the chosen copy object, rather than this ability's source.
   The shared object hole keeps that exclusion tied to the actual copy operand. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::Not(SameObject($object_ref)), $filter_phrase)}), changes:[CopyOf{object:$object_ref, exceptions:[$copy_remove_legendary]}], duration:$duration, evaluation:Snapshot}}] */
clause_other_copy_exception ::= "each" "other" filter_phrase "becomes" "a" "copy" "of" object_ref duration "," "except" copy_remove_legendary

/* This is a copiable exception, not a later continuous type removal. */
/* @sem CopyException::RemoveSupertypes([Legendary]) */
copy_remove_legendary ::= "it" "isn't" "legendary"

/* @sem CopyException::SetName(@card_name) */
copy_self_name ::= ("its" | "his" | "her") "name" "is" SELF_NAME
/* @sem CopyException::SetName($referenced_card_name) */
copy_named_name ::= ("its" | "his" | "her") "name" "is" referenced_card_name
/* @sem CopyException::AddCurrentAbility */
copy_current_payload ::= "this" "ability"
/* @sem $copy_current_payload */
copy_has_current ::= "it" "has" copy_current_payload
/* @sem Vec<CopyException>::[$copy_added_keyword, $copy_current_payload] */
copy_keyword_current ::= "it" "has" copy_added_keyword "and" copy_current_payload

/* The target is announced once and the replacement copies that same object. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(Supertype(Legendary)), CardType(Creature)])}), index:0} */
chosen_nonlegendary_creature ::= "choose" "target" "nonlegendary" "creature"

/* @sem ObjectFilter::AnyOf(@unordered([$plural_creature, $plural])) */
copy_entry_creature_disjunction ::= plural_creature "or" plural

copy_entry_population ::= copy_entry_creature_disjunction | filter_plural

/* @sem Instruction::[Effect{result:@next, operation:CreateReplacement{event:Enter{objects:$copy_entry_population}, limit:NextOccurrence, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Entry(CopyOf{objects:One($chosen_nonlegendary_creature), exceptions:[]})}}]}}}] */
clause_next_entries_copy_target ::= chosen_nonlegendary_creature "." "the" "next" "time" "one" "or" "more" copy_entry_population "enter" this_duration "," "they" "enter" "as" "copies" "of" "the" "chosen" "creature"

/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$entry_copy_exile_card_type, Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})])} */
entry_copy_exile_counter ::= entry_copy_exile_card_type "card" "in" "exile" "with" "a" counter_kind "counter" "on" "it"

entry_copy_exile_card_type ::= entry_copy_exile_creature | entry_copy_exile_artifact
/* @sem $noun_creature */
entry_copy_exile_creature ::= "a" noun_creature
/* @sem $noun_artifact */
entry_copy_exile_artifact ::= "an" noun_artifact

/* Entry-copy exceptions are scoped to the copy's own replacement. */
/* @sem Vec<CopyException>::[CopyException::SetPowerToughness{power:$number_digits, toughness:$number_digits_2}] */
entry_copy_stats_tail ::= "," "except" "it's" number_digits "/" number_digits "."
/* @sem Vec<CopyException>::[CopyException::AddCreatureTypes($becomes_types)] */
entry_copy_creature_types_tail ::= "," "except" "it's" "a" becomes_types "in" "addition" "to" "its" "other" "creature" "types" "."
/* @sem Vec<CopyException>::[CopyException::AddCreatureTypes($becomes_types), CopyException::AddCardTypes([Artifact, Creature])] */
entry_copy_artifact_creature_tail ::= "," "except" "it's" "a" becomes_types "artifact" "creature" "in" "addition" "to" "its" "other" "types" "."
/* @sem Vec<CopyException>::[CopyException::RemoveSupertypes([Legendary]), CopyException::AddCardTypes([Artifact]), CopyException::AddAbilities([@scope($mechanic_bare)])] */
entry_copy_nonlegendary_artifact_tail ::= "," "except" "it" "isn't" "legendary" "," "is" "an" "artifact" "in" "addition" "to" "its" "other" "types" "," "and" "has" mechanic_bare "."

/* The condition controls both copies of the same selected population. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:_{instructions:[If{condition:ObjectMatches{object:$object_ref_2, filter:State(Embalmed)}, then:_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Entry(CopyOf{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$entry_copy_any}, exceptions:$entry_copy_embalmed_exceptions})}}]}}]}, otherwise:_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Entry(CopyOf{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$entry_copy_any}, exceptions:[]})}}]}}]}}]}}) */
entry_copy_embalmed ::= "you" "may" "have" object_ref "enter" "as" "a" "copy" "of" entry_copy_any "," "except" "if" object_ref "was" "embalmed" "," entry_copy_embalmed_exceptions "."
/* @sem Vec<CopyException>::[CopyException::RemoveManaCost, CopyException::Colors{mode:Set, colors:Listed([$mana_color_word])}, CopyException::AddCreatureTypes($becomes_types)] */
entry_copy_embalmed_exceptions ::= "the" "token" "has" "no" "mana" "cost" "," "it's" mana_color_word "," "and" "it's" "a" becomes_types "in" "addition" "to" "its" "other" "types"

/* The reflexive continuation refers to the object selected by this copy. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Entry(CopyOf{objects:$entry_copy_battlefield, exceptions:$entry_copy_reflexive_exceptions})}}, Effect{result:@next, operation:ReflexiveTrigger{performed:0, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:SetTapped{objects:One(Earlier{what:Selected}), tapped:true}}, Effect{result:@next, operation:CreateContinuousEffect{source:$object_ref_3, affected:Objects(One(Earlier{what:Selected})), changes:$static_changes, duration:WhileControlled{player:AbilityController, object:$object_ref_2}, evaluation:LiveObjects}}]}}}]}}]}}) */
entry_copy_reflexive ::= "you" "may" "have" object_ref "enter" "as" "a" "copy" "of" entry_copy_battlefield "," "except" entry_copy_reflexive_exceptions "." "when" "you" "do" "," "tap" "the" "copied" "creature" "and" object_ref static_changes "for" "as" "long" "as" "you" "control" object_ref "."
/* @sem Vec<CopyException>::[CopyException::AddCreatureTypes($becomes_types), CopyException::AddAbilities([Keyword($keyword_value)])] */
entry_copy_reflexive_exceptions ::= "it's" "a" becomes_types "in" "addition" "to" "its" "other" "types" "and" "has" keyword_value

/* An explicit battlefield population is part of these exception sentences. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_explicit_ref)}, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Entry(CopyOf{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$entry_copy_any}, exceptions:$entry_copy_explicit_tail})}}]}}]}}) */
entry_copy_explicit ::= "you" "may" "have" self_explicit_ref "enter" "as" "a" "copy" "of" entry_copy_any entry_copy_explicit_tail
entry_copy_explicit_tail ::= entry_copy_stats_tail | entry_copy_creature_types_tail | entry_copy_artifact_creature_tail | entry_copy_nonlegendary_artifact_tail

/* Entry-copy-specific qualifications preserve the chosen population and additions. */
/* @sem ObjectFilter::AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:ManaSpent{object:$self_explicit_ref, filter:_{}, aggregation:Count}}}]) */
entry_copy_mana_spent ::= "any" filter_phrase "on" "the" "battlefield" "with" "mana" "value" "less" "than" "or" "equal" "to" "the" "amount" "of" "mana" "spent" "to" "cast" self_explicit_ref

/* @sem Vec<CopyException>::[CopyException::AddAbilityIfAbsent{ability:Mechanic{mechanic:VanishingEnters, amount:$value}, matching:KeywordFamily(Vanishing)}] */
copy_vanishing_absent_list ::= "it" "has" "vanishing" value "if" "that" "creature" "doesn't" "have" "vanishing"

/* @sem Vec<CopyException>::[CopyException::AddCardTypes([Artifact, Creature]), CopyException::KeepPowerToughness] */
copy_artifact_creature_stats_list ::= "it's" "an" "artifact" "creature" "in" "addition" "to" "its" "other" "types" "," "and" "its" "power" "and" "toughness" "are" "equal" "to" "this" "creature's" "power" "and" "toughness"

/* @sem Vec<CopyException>::[CopyException::SetCardTypes([Artifact]), CopyException::AddAbilities([@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program})])] */
copy_artifact_activated_list ::= "it's" "an" "artifact" "and" "it" "has" '"' cost ":" program "." '"'

/* @sem Vec<CopyException>::[CopyException::AddAbilities([Static(_{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject($object_ref)), $filter_plural, SharesNameWith($object_ref_2)])}), changes:[Rule(GoadedBy(AbilityController))]})])] */
copy_same_name_goad_list ::= object_ref "has" '"' "other" filter_plural "with" "the" "same" "name" "as" object_ref "are" "goaded" "." '"'

/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_explicit_ref)}, body:_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Entry(CopyOf{objects:$entry_copy_objects, exceptions:[]})}}, Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$number})}}]}}]}}) */
entry_copy_additional_counters ::= "you" "may" "have" self_explicit_ref "enter" "as" "a" "copy" "of" entry_copy_objects "," "except" "it" "enters" "with" number "additional" counter_kind "counters" "on" "it" "."

/* These exceptions require the explicitly stated battlefield choice. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_explicit_ref)}, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Entry(CopyOf{objects:$entry_copy_battlefield_explicit, exceptions:$copy_battlefield_exception})}}]}}]}}) */
entry_copy_battlefield_exception_ability ::= "you" "may" "have" self_explicit_ref "enter" "as" "a" "copy" "of" entry_copy_battlefield_explicit "," "except" copy_battlefield_exception

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$entry_copy_any} */
entry_copy_battlefield_explicit ::= entry_copy_any

copy_battlefield_exception ::= copy_battlefield_vanishing | copy_artifact_activated_list

/* @sem $copy_vanishing_absent_list */
copy_battlefield_vanishing ::= copy_vanishing_absent_list "."

/* @sem CopyException::SetPowerToughness{power:$number_digits, toughness:$number_digits_2} */
copy_fixed_stats ::= "it's" number_digits "/" number_digits

/* The quoted ability belongs to the copy, and retains its independent scope. */
/* @sem Vec<CopyException>::[CopyException::SetPowerToughness{power:$number_digits, toughness:$number_digits_2}, CopyException::AddArtifactTypes([Food]), CopyException::AddCreatureTypes([Golem]), CopyException::AddCardTypes([Artifact, Creature]), $copy_granted_sentence] */
copy_food_golem_quoted_exceptions ::= "it's" "a" number_digits "/" number_digits "Food" "Golem" "artifact" "creature" "in" "addition" "to" "its" "other" "types" "and" copy_granted_sentence

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment_exile, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$token_copy_quantity, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:$copy_food_golem_quoted_exceptions}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{}}]} */
optional_exile_copy_quoted_program ::= "you" "may" payment_exile "." "if" "you" "do" "," "create" token_copy_quantity object_ref "," "except" copy_food_golem_quoted_exceptions

/* @sem CopyException::AddCardTypes([Land]) */
copy_add_land ::= "it's" "a" "land" "in" "addition" "to" "its" "other" "types"

/* @sem CopyException::AddSupertypes([Legendary]) */
copy_add_legendary ::= "it's" "legendary"

/* Independent copiable characteristics of the copied object. */
/* @sem $copy_added_keyword */
copy_token_keyword ::= "the" "token" "has" copy_added_keyword

/* @sem CopyException::SetLoyalty($value) */
copy_starting_loyalty ::= "its" "starting" "loyalty" "is" value

/* @sem CopyException::AddCreatureTypes($becomes_types) */
copy_add_creature_type_explicit ::= "it's" "a" becomes_types "in" "addition" "to" "its" "other" "creature" "types"

/* @sem Vec<CopyException>::[$copy_not_legendary, CopyException::SetPowerToughness{power:$value, toughness:$value_2}, CopyException::Colors{mode:Add, colors:Listed([$mana_color_word])}, CopyException::AddCreatureTypes($becomes_types)] */
copy_colored_stats_types ::= copy_not_legendary "and" "it's" "a" value "/" value mana_color_word becomes_types "in" "addition" "to" "its" "other" "colors" "and" "types"

/* The loyalty override belongs to this complete copiable exception. */
/* @sem Vec<CopyException>::[$copy_not_legendary, $copy_starting_loyalty] */
copy_nonlegendary_with_loyalty ::= copy_not_legendary "and" copy_starting_loyalty

/* Copiable statistics and a native ability describe the copied token recipe. */
/* @sem Vec<CopyException>::[SetPowerToughness{power:$token_stat, toughness:$token_stat_2}, AddAbilities([$token_ability])] */
copy_token_stats_ability ::= "it's" token_stat "/" token_stat "and" "has" token_ability

/* @sem Vec<CopyException>::[CopyException::SetArtifactTypes([Food]), CopyException::SetCardTypes([Artifact]), CopyException::AddAbilities([@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program})])] */
copy_food_ability ::= "it's" "a" "Food" "artifact" "with" '"' cost ":" program "," '"' "and" "it" "loses" "all" "other" "card" "types"

/* @sem Vec<CopyException>::[$copy_exception_plain, ...$copy_exceptions_plain] */
copy_exception_comma_more ::= copy_exception_plain "," copy_exceptions_plain

/* @sem Vec<CopyException>::[$copy_exception_plain, ...$copy_exceptions_plain] */
copy_exception_oxford_more ::= copy_exception_plain "," "and" copy_exceptions_plain

/* @sem CopyException::AddSupertypes([Legendary]) */
copy_add_legendary_retained ::= "it's" "legendary" "in" "addition" "to" "its" "other" "types"

entry_copy_actions ::= entry_copy_conditional_actions | entry_copy_plain_actions | entry_copy_temporary_actions | entry_copy_controlled_counter_one | entry_copy_controlled_counter_many | entry_copy_creature_keep_color | entry_copy_artifact_keep_color

/* @sem Instruction::[Effect{result:@next, operation:ModifyEvent{change:Entry(CopyOf{objects:$entry_copy_objects, exceptions:$entry_copy_tail})}}] */
entry_copy_plain_actions ::= "a" "copy" "of" entry_copy_objects entry_copy_tail

/* Both modifications belong to the same optional entry choice. */
/* @sem Instruction::[Effect{result:@next, operation:ModifyEvent{change:Entry(CopyOf{objects:$entry_copy_objects, exceptions:[]})}}, Effect{result:@next, operation:ModifyEvent{change:Entry(ChangesUntil{changes:$static_changes, duration:$duration})}}] */
entry_copy_temporary_actions ::= "a" "copy" "of" entry_copy_objects "." "if" "you" "do" "," "it" static_changes duration "."

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, ArrivedThisTurn{from:Library}])} */
entry_copy_your_graveyard_from_library ::= "a" filter_phrase "card" "in" "your" "graveyard" "that" "was" "put" "there" "from" "your" "library" "this" "turn"

/* Compose a temporary entry copy from its population, duration and exceptions. */
/* @sem Operation::ModifyEvent{change:Entry(CopyOf{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$entry_copy_any}, until:$until_end_of_turn, exceptions:$copy_exceptions_plain})} */
entry_temporary_copy ::= "have" "it" "become" "a" "copy" "of" entry_copy_any until_end_of_turn "," "except" copy_exceptions_plain

/* A copied object gains a keyword and loses its soulbond mechanic. */
/* @sem Vec<CopyException>::[$copy_keyword_ability, CopyException::RemoveAbilities(Mechanic(Soulbond))] */
copy_keyword_without_soulbond ::= copy_keyword_ability "and" "loses" "soulbond"

/* The chosen graveyard card is the entry-copy result consumed by the
   reflexive exile. Keep the producer and its result consumer in one scope. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_explicit_ref)}, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Entry(CopyOf{objects:$entry_copy_graveyard_any, exceptions:$copy_he_exceptions})}}, Effect{result:@next, operation:ReflexiveTrigger{performed:0, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:0, phase:After, index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}]}}]}}) */
entry_copy_graveyard_exile ::= "you" "may" "have" self_explicit_ref "enter" "as" "a" "copy" "of" entry_copy_graveyard_any "," "except" copy_he_exceptions "." "when" "you" "do" "," "exile" "that" "card" "."

/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$filter_phrase} */
entry_copy_graveyard_any ::= "any" filter_phrase "card" "in" "a" "graveyard"

/* @sem Vec<CopyException>::[CopyException::SetName(@card_name), CopyException::SetPowerToughness{power:$value, toughness:$value_2}, CopyException::AddCreatureTypes($becomes_types)] */
copy_he_exceptions ::= "his" "name" "is" SELF_NAME "and" "he's" "a" value "/" value becomes_types "in" "addition" "to" "his" "other" "types"

/* The shared subject continues across both copy exceptions. */
/* @sem Vec<CopyException>::[CopyException::RemoveSupertypes([Legendary]), CopyException::AddCreatureTypes($becomes_types)] */
copy_not_legendary_and_type ::= "it" "isn't" "legendary" "and" "is" "a" becomes_types "in" "addition" "to" "its" "other" "types"

/* The condition consumes the object selected by this exact entry-copy action. */
/* @sem Instruction::[Effect{result:@next, operation:ModifyEvent{change:Entry(CopyOf{objects:$entry_copy_controlled_creature, exceptions:[]})}}, If{condition:Compare{left:CountObjects(Matching{objects:Recorded(@prior), filter:ControlledBy(One(AbilityController))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:Constant(1)})}}]}, otherwise:Program{}}] */
entry_copy_controlled_counter_one ::= "a" "copy" "of" entry_copy_controlled_creature "," "except" "it" "enters" "with" "a" counter_kind "counter" "on" "it" "if" "you" "control" "that" "creature" "."
/* @sem Instruction::[Effect{result:@next, operation:ModifyEvent{change:Entry(CopyOf{objects:$entry_copy_controlled_creature, exceptions:[]})}}, If{condition:Compare{left:CountObjects(Matching{objects:Recorded(@prior), filter:ControlledBy(One(AbilityController))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$count_plural})}}]}, otherwise:Program{}}] */
entry_copy_controlled_counter_many ::= "a" "copy" "of" entry_copy_controlled_creature "," "except" "it" "enters" "with" count_plural counter_kind "counters" "on" "it" "if" "you" "control" "that" "creature" "."

/* The anaphor “that creature” requires a creature copy choice. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:$entry_copy_creature_filter} */
entry_copy_controlled_creature ::= "any" entry_copy_creature_filter "on" "the" "battlefield"
entry_copy_creature_filter ::= noun_creature | entry_copy_creature_adjective | entry_copy_creature_modified
/* @sem @and($adjective, $entry_copy_creature_filter) */
entry_copy_creature_adjective ::= adjective entry_copy_creature_filter
/* @sem @and($noun_creature, $modifiers) */
entry_copy_creature_modified ::= noun_creature modifiers

/* The antecedent of the retained-color phrase is explicitly a creature. */
/* @sem CopyException::KeepColors */
copy_creature_keep_color ::= "it" "doesn't" "copy" "that" "creature's" "color"

/* @sem Instruction::[Effect{result:@next, operation:ModifyEvent{change:Entry(CopyOf{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$enchanted_creature_filter}, exceptions:[$copy_creature_keep_color, ...$copy_exceptions_closed]})}}] */
entry_copy_creature_keep_color ::= "a" "copy" "of" "any" enchanted_creature_filter "on" "the" "battlefield" "," "except" copy_creature_keep_color "and" copy_exceptions_closed

/* @sem CopyException::KeepColors */
copy_artifact_keep_color ::= "it" "doesn't" "copy" "that" "artifact's" "color"

/* @sem Instruction::[Effect{result:@next, operation:ModifyEvent{change:Entry(CopyOf{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$noun_artifact}, exceptions:[$copy_artifact_keep_color, ...$copy_exceptions_closed]})}}] */
entry_copy_artifact_keep_color ::= "a" "copy" "of" "any" noun_artifact "on" "the" "battlefield" "," "except" copy_artifact_keep_color "and" copy_exceptions_closed

/* A current ability and a quoted ability retain independent copy scopes. */
/* @sem Vec<CopyException>::[$copy_has_current, $copy_quoted_ability] */
copy_current_then_quote ::= copy_has_current "and" copy_quoted_ability

/* @sem CopyException::SetCardTypes([Enchantment]) */
copy_set_enchantment ::= "it's" "an" "enchantment" "and" "loses" "all" "other" "card" "types"

/* A token's printed statistics, additional card types and intrinsic keyword. */
/* @sem Vec<CopyException>::[SetPowerToughness{power:$token_stat, toughness:$token_stat_2}, AddCardTypes([Artifact, Creature]), AddAbilities([@scope($keyword_ability)])] */
copy_stats_artifact_creature_keyword ::= "it's" "a" token_stat "/" token_stat "artifact" "creature" "in" "addition" "to" "its" "other" "types" "and" "has" keyword_ability

/* A condition and an optional entry-copy action share the entering controller. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_explicit_ref)}, body:Program{instructions:[If{condition:$condition, then:Program{instructions:$entry_copy_optional_actions}, otherwise:Program{}}]}}) */
conditional_entry_copy_ability ::= "if" condition "," "you" "may" "have" self_explicit_ref "enter" "as" entry_copy_optional_actions

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:$conditional_entry_copy_action_choices}}] */
entry_copy_optional_actions ::= conditional_entry_copy_action_choices
conditional_entry_copy_action_choices ::= conditional_entry_copy_any_actions | entry_copy_actions

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:ModifyEvent{change:Entry(CopyOf{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$entry_copy_any}, exceptions:$entry_copy_tail})}}] */
conditional_entry_copy_any_actions ::= "a" "copy" "of" entry_copy_any entry_copy_tail

/* A singular copy retains its types while gaining the stated creature type. */
/* @sem Vec<CopyException>::[$copy_not_legendary, CopyException::SetPowerToughness{power:$value, toughness:$value_2}, CopyException::AddCreatureTypes($becomes_types)] */
copy_nonlegendary_stats_types ::= copy_not_legendary "and" "it's" "a" value "/" value becomes_types "in" "addition" "to" "its" "other" "types"

/* The announced target is both excluded from the affected population and copied.
   Its noun is repeated in the two anaphors; the population is independent. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(@and($noun_2, ObjectFilter::ControlledBy(One(AbilityController))), ObjectFilter::Not(SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and(ObjectFilter::@agree(ObjectFilter::$noun, ObjectFilter::@agree(ObjectFilter::$noun_3, ObjectFilter::$noun_4)), ObjectFilter::ControlledBy(One(AbilityController)))}), index:0})))}), changes:[CopyOf{object:Target{slot:@last_slot, index:0}, exceptions:[$copy_remove_legendary]}], duration:$duration, evaluation:Snapshot}}] */
clause_chosen_target_population_copy ::= "choose" "target" noun "you" "control" "." "each" noun "you" "control" "other" "than" "the" "chosen" noun "becomes" "a" "copy" "of" "that" noun duration "," "except" copy_remove_legendary

/* The exception removes the current ability from the copied object. */
/* @sem CopyException::RemoveCurrentAbility */
copy_remove_current ::= "it" "doesn't" "have" "this" "ability"

/* A copied object keeps both its printed base stats and a scoped quoted ability. */
/* @sem Vec<CopyException>::[$copy_fixed_stats, $copy_quoted_ability] */
copy_stats_and_quoted_ability ::= copy_fixed_stats "and" "has" copy_quoted_ability

/* The condition tests the object selected by this copy action, not a later
   battlefield query. Keep the producer and its recorded result in one phrase. */
/* @sem Instruction::[Effect{result:@next, operation:ModifyEvent{change:Entry(CopyOf{objects:$entry_copy_objects, exceptions:$copy_exceptions_plain})}}, $entry_copy_conditional_followup] */
entry_copy_conditional_actions ::= "a" "copy" "of" entry_copy_objects "," "except" copy_exceptions_plain "and" "," entry_copy_conditional_followup "."

/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Recorded(@prior), filter:$filter_phrase}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:$entry_copy_conditional_effects}, otherwise:Program{}} */
entry_copy_conditional_followup ::= "if" "it's" "a" filter_phrase "," entry_copy_conditional_effects

/* @sem Instruction::[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$value})}}, Effect{result:@next, operation:ModifyEvent{change:Entry(Changes([Copiable([GrantAbility(Static(_{kind:CharacteristicDefining{keyword:Changeling, contributes_to_color_identity:true}, affected:Objects(One(Source)), changes:[CreatureTypes{mode:Set, types:All}]}))])]))}}] */
entry_copy_conditional_effects ::= "it" "enters" "with" value "additional" counter_kind "counters" "on" "it" "and" "has" "changeling"

/* @sem CopyException::AddSupertypes([Legendary, Snow]) */
copy_add_legendary_snow_retained ::= "it's" "legendary" "and" "snow" "in" "addition" "to" "its" "other" "types"
