/* Keyword actions the ability's controller performs. A single application
   keeps the native absent amount; counted applications retain theirs. */
keyword_action ::= roll_composed_action | investigate_action | populate_action | open_attraction_action | time_travel_action | roll_die_action | additional_combat_phase | additional_combat_and_main_phase | become_monarch | take_initiative | ring_tempts_you | venture_into_dungeon | take_extra_turn | learn_action | end_the_turn | planeswalk_action | reverse_turn_order | amount_keyword_action | you_amount_keyword_action | object_keyword_action | group_keyword_action | skip_next_untap_step | roll_planar_die_action | additional_beginning_phase | additional_phase_after | skip_next_your_part | you_skip_next_your_part | game_outcome | become_day_action | become_night_action | controller_incubates_defined

investigate_action ::= investigate_for_population | investigate_for_life_loss | investigate_for_player_count | investigate_once | investigate_twice | investigate_number_times | investigate_that_many_times
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Investigate{}} */
investigate_once ::= "investigate"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Investigate{times:Constant(2)}} */
investigate_twice ::= "investigate" "twice"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Investigate{times:$number}} */
investigate_number_times ::= "investigate" number "times"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Investigate{times:EventAmount}} */
investigate_that_many_times ::= "investigate" "that" "many" "times"

populate_action ::= populate_once | populate_number_times
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Populate{}} */
populate_once ::= "populate"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Populate{times:$number}} */
populate_number_times ::= "populate" number "times"

open_attraction_action ::= open_an_attraction | open_attractions
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::OpenAttraction{}} */
open_an_attraction ::= "open" "an" "Attraction"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::OpenAttraction{times:$value}} */
open_attractions ::= "open" value "Attractions"

time_travel_action ::= time_travel_once | time_travel_times
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::TimeTravel{}} */
time_travel_once ::= "time" "travel"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::TimeTravel{times:$value}} */
time_travel_times ::= "time" "travel" value "times"

roll_die_action ::= plain_roll_d20 | roll_d4 | roll_d6 | roll_d6_notation | roll_d8 | roll_d10 | roll_d12 | roll_six_sided_dice
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RollDie{sides:6}} */
roll_d6 ::= "roll" "a" "six-sided" "die"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RollDie{sides:4}} */
roll_d4 ::= "roll" "a" "d4"
/* "Roll a d6" and "roll a six-sided die" are the same roll. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RollDie{sides:6}} */
roll_d6_notation ::= "roll" "a" "d6"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RollDie{sides:8}} */
roll_d8 ::= "roll" "a" "d8"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RollDie{sides:10}} */
roll_d10 ::= "roll" "a" "d10"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RollDie{sides:12}} */
roll_d12 ::= "roll" "a" "d12"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RollDie{sides:6, times:$value}} */
roll_six_sided_dice ::= "roll" value "six-sided" "dice"

/* A die table: each written row resolves when the roll's result is in its
   range. The roll marks its result, so every row names the same roll however
   many rows and row instructions precede it. */
/* @sem Program::Program{instructions:[...$die_table_head, ...$die_rows]} */
program_sentence_die_table ::= die_table_head "." NEWLINE die_rows
die_table_head ::= die_roll | die_highest_roll | die_head_then | die_head_after
/* @sem Instruction::[Effect{result:@mark, operation:$roll_die_action}] */
die_roll ::= roll_die_action
/* @sem Instruction::[...$instructions, ...$die_roll] */
die_head_then ::= instructions "," "then" die_roll
/* @sem Instruction::[...$instructions, ...$die_roll] */
die_head_after ::= instructions "." die_roll
die_rows ::= die_rows_one | die_rows_more
/* @sem Instruction::[$die_row] */
die_rows_one ::= die_row
/* @sem Instruction::[$die_row, ...$die_rows] */
die_rows_more ::= die_row NEWLINE die_rows
die_row ::= die_row_range_sacrifice_choice | die_row_exact_extreme_that_player | die_row_range | die_row_exact | die_row_at_least | die_row_at_most
/* @sem Instruction::If{condition:AllOf([Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:LessOrEqual, value:$number_2}}]), then:$program_sentence, otherwise:_{}} */
die_row_range ::= number ("―" | "‑") number "|" program_sentence
/* @sem Instruction::If{condition:Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:Equal, value:$number}}, then:$program_sentence, otherwise:_{}} */
die_row_exact ::= number "|" program_sentence
/* @sem Instruction::If{condition:Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, then:$program_sentence, otherwise:_{}} */
die_row_at_least ::= number "⁺" "|" program_sentence
/* @sem Instruction::If{condition:Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}, then:$program_sentence, otherwise:_{}} */
die_row_at_most ::= number "or" "less" "|" program_sentence
/* A roll with a value added reads its two rows from the total. */
/* @sem Program::Program{instructions:[...$die_table_head, If{condition:AllOf([Compare{left:Add([DieResult(@marked), $value]), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, Compare{left:Add([DieResult(@marked), $value]), test:NumberTest::Compare{comparison:LessOrEqual, value:$number_2}}]), then:$program_sentence, otherwise:_{}}, If{condition:Compare{left:Add([DieResult(@marked), $value]), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number_3}}, then:$program_sentence_2, otherwise:_{}}]} */
program_sentence_added_die_table ::= die_table_head "and" "add" value "." NEWLINE number "―" number "|" program_sentence NEWLINE number "⁺" "|" program_sentence

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::AdditionalPhase{phases:Combat}} */
additional_combat_phase ::= "after" "this" "phase" "," "there" "is" "an" "additional" "combat" "phase"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::AdditionalPhase{phases:CombatAndMain}} */
additional_combat_and_main_phase ::= "after" "this" "main" "phase" "," "there" "is" "an" "additional" "combat" "phase" "followed" "by" "an" "additional" "main" "phase"
    | "there" "is" "an" "additional" "combat" "phase" "after" "this" "phase" "," "followed" "by" "an" "additional" "main" "phase"
    | "there" "is" "an" "additional" "combat" "phase" "after" "this" "phase" "followed" "by" "an" "additional" "main" "phase"

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::BecomeMonarch} */
become_monarch ::= "you" "become" "the" "monarch"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::TakeInitiative} */
take_initiative ::= "you" "take" "the" "initiative"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RingTempts} */
ring_tempts_you ::= "the" "Ring" "tempts" "you"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Venture} */
venture_into_dungeon ::= "venture" "into" "the" "dungeon"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::TakeExtraTurn{}} */
take_extra_turn ::= "take" "an" "extra" "turn" "after" "this" "one"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Learn} */
learn_action ::= "learn"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::EndTheTurn} */
end_the_turn ::= "end" "the" "turn"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Planeswalk} */
planeswalk_action ::= "planeswalk"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::ReverseTurnOrder} */
reverse_turn_order ::= "reverse" "the" "game's" "turn" "order"

/* A counted keyword action can name you, its actor, explicitly. */
/* @sem $amount_keyword_action */
you_amount_keyword_action ::= "you" amount_keyword_action

amount_keyword_action ::= adapt_action | bolster_action | incubate_action | discover_action | monstrosity_action
    | fateseal_action | collect_evidence_action | blight_action | earthbend_action | amass_action
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Adapt{amount:$value}} */
adapt_action ::= "adapt" value
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Bolster{amount:$value}} */
bolster_action ::= "bolster" value
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Incubate{amount:$value}} */
incubate_action ::= "incubate" value
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Discover{amount:$discover_amount}} */
discover_action ::= "discover" discover_amount
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Monstrosity{amount:$monstrosity_amount}} */
monstrosity_action ::= "monstrosity" monstrosity_amount
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Fateseal{amount:$value}} */
fateseal_action ::= "fateseal" value
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::CollectEvidence{amount:$value}} */
collect_evidence_action ::= "collect" "evidence" value
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Blight{amount:$value}} */
blight_action ::= "blight" value
/* Earthbending chooses its land as the action's own target. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Earthbend{object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Land), ControlledBy(One(AbilityController))])}), index:0}, amount:$value}} */
earthbend_action ::= "earthbend" value
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Amass{amount:$value, creature_type:@subtype_name($subtype_plural)}} */
amass_action ::= "amass" subtype_plural value

object_keyword_action ::= transform_object | goad_object | detain_object | convert_object | flip_object | airbend_object
    | assimilate_object | turn_object_face_up | turn_object_face_down | exchange_control_shared_pair | exchange_control_pair | exchange_control_constrained_pair | exchange_control_pair_shared_type | exchange_control_of_objects | unlock_door_of_object | lock_or_unlock_door
    | object_explores | object_phases_out | object_intensifies | object_becomes_prepared | object_endures
    | object_becomes_saddled
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Transform{object:$object_ref}} */
transform_object ::= "transform" object_ref
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Goad{object:$object_ref}} */
goad_object ::= "goad" object_ref
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Detain{object:$object_ref}} */
detain_object ::= "detain" object_ref
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Convert{object:$object_ref}} */
convert_object ::= "convert" object_ref
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Flip{object:$object_ref}} */
flip_object ::= "flip" object_ref
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Airbend{object:$object_ref}} */
airbend_object ::= "airbend" object_ref
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Assimilate{object:$object_ref}} */
assimilate_object ::= "assimilate" object_ref
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::TurnFaceUp{object:$object_ref}} */
turn_object_face_up ::= "turn" object_ref "face" "up"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::TurnFaceDown{object:$object_ref}} */
turn_object_face_down ::= "turn" object_ref "face" "down"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::ExchangeControl{first:$object_ref, second:$object_ref_2}} */
exchange_control_of_objects ::= "exchange" "control" "of" object_ref "and" object_ref

/* The fresh-slot reference is resolved before the target introduction at
   this same lexical position. Both indexes belong to this one group. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::ExchangeControl{first:$exchange_pair_target, second:Target{slot:@next_slot, index:1}}} */
exchange_control_pair ::= "exchange" "control" "of" exchange_pair_target

exchange_pair_target ::= exchange_pair_target_plain | exchange_pair_target_distinct_controllers
/* @prefer always */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(2)), filter:$filter_plural}), index:0} */
exchange_pair_target_plain ::= "two" "target" filter_plural
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(2)), filter:$filter_plural, constraints:[DifferentControllers]}), index:0} */
exchange_pair_target_distinct_controllers ::= "two" "target" filter_plural "controlled" "by" "different" "players"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::UnlockDoor{object:$object_ref}} */
unlock_door_of_object ::= "unlock" "a" "locked" "door" "of" object_ref

/* Locking or unlocking concerns one door of this object, not a numeric amount. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::LockOrUnlockDoor{object:$object_ref}} */
lock_or_unlock_door ::= "lock" "or" "unlock" "a" "door" "of" object_ref
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Explore{object:$object_ref}} */
object_explores ::= object_ref "explores"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::PhaseOut{object:$object_ref}} */
object_phases_out ::= object_ref "phases" "out"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Intensify{object:$object_ref}} */
object_intensifies ::= object_ref "intensifies"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Prepare{object:$object_ref}} */
object_becomes_prepared ::= object_ref "becomes" "prepared"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Endure{object:$object_ref, amount:$value}} */
object_endures ::= object_ref "endures" value
/* Saddling always lasts until end of turn. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Saddle{object:$object_ref}} */
object_becomes_saddled ::= object_ref "becomes" "saddled" "until" "end" "of" "turn"

group_keyword_action ::= selected_any_keyword_action | selected_single_keyword_action | selected_group_keyword_action | goad_group_reference | goad_created_indefinitely | goad_affected | affected_phase_out | affected_connive | affected_become_blocked | transform_all | each_explores | turn_all_face_down | detain_each | phase_in_filtered | phase_out_with_phasing | simultaneous_phase_actions | shared_keyword_imperative | shared_opponent_keyword | shared_singular_keyword | detain_target_group | phase_out_chosen_population | each_phases_out | goad_named_for_object | phase_out_composed_population | goad_each_event_player | goad_each
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::PhaseOut{}, objects:$affected} */
affected_phase_out ::= affected "phase" "out"
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Connive, objects:$affected} */
affected_connive ::= affected "connive"
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::BecomeBlocked, objects:$affected} */
affected_become_blocked ::= affected "become" "blocked"
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Transform, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}} */
transform_all ::= "transform" "all" filter_plural
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Explore, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}} */
each_explores ::= "each" filter_phrase "explores"
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::TurnFaceDown, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}} */
turn_all_face_down ::= "turn" "all" filter_plural "face" "down"
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Detain, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}} */
detain_each ::= "detain" "each" filter_phrase

/* Goad applies independently to every member of the selected set. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Goad{}, objects:$objects_targets} */
goad_affected ::= "goad" objects_targets

/* The second target is distinct and must share the named property with the first. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::ExchangeControl{first:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_plural}), index:0}, second:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($filter_plural, @and(ObjectFilter::Not(ObjectFilter::SameObject(Target{slot:@next_slot, index:0})), ObjectFilter::Shares{property:$exchange_shared_property, with:Target{slot:@next_slot, index:0}}))}), index:0}}} */
exchange_control_shared_pair ::= "exchange" "control" "of" "two" "target" filter_plural "that" "share" "a" exchange_shared_property

/* @sem DistinctProperty::PermanentTypes */
exchange_shared_property_type ::= "permanent" "type"

/* @sem DistinctProperty::Colors */
exchange_shared_property_color ::= "color"

exchange_shared_property ::= exchange_shared_property_type | exchange_shared_property_color

/* The die action is an operand of the controller's keyword operation. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:$roll_composed_phrase} */
roll_composed_action ::= "roll" roll_composed_phrase

roll_composed_phrase ::= roll_highest_phrase | roll_store_phrase | roll_mana_d6_phrase

/* @sem KeywordAction::RollKeepHighest{sides:20, amount:$count_each} */
roll_highest_phrase ::= "a" "d20" "for" "each" count_each "and" "ignore" "all" "but" "the" "highest" "roll"

/* @sem KeywordAction::RollAndStoreD6{amount:$value} */
roll_store_phrase ::= value "six-sided" "dice" "and" "store" "those" "results" "on" "it"

/* @sem KeywordAction::RollDie{sides:6, times:$roll_mana_amount} */
roll_mana_d6_phrase ::= roll_mana_amount

/* @sem Expr::Add([$counter_amount, ManaSpentFrom{object:Source, sources:$filter_plural}]) */
roll_mana_amount ::= counter_amount "six-sided" "die" "plus" "an" "additional" "six-sided" "die" "for" "each" "mana" "from" filter_plural "spent" "to" "activate" "this" "ability"

/* The additional wording requires the same action in the trigger. */
/* @sem Ability::Triggered{event:FirstEachTurn($event_you_investigate), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$investigate_additional_time}]}} */
triggered_investigate_additional ::= "whenever" event_you_investigate "for" "the" "first" "time" "each" "turn" "," investigate_additional_time "."

/* @sem $selected_group_action */
selected_group_keyword_action ::= "you" "may" "have" selected_group_action

selected_group_action ::= selected_group_phase_out | selected_group_connive

/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::PhaseOut{}, objects:$any_number_of_group} */
selected_group_phase_out ::= any_number_of_group "phase" "out"

/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Connive, objects:$any_number_of_group} */
selected_group_connive ::= any_number_of_group "connive"

/* Phasing clauses retain the independently stated populations. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::PhaseIn, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}} */
phase_in_filtered ::= "all" "phased-out" filter_plural "phase" "in"

/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::PhaseOut{}, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, HasKeywordFamily(Phasing)])}} */
phase_out_with_phasing ::= "all" filter_plural "with" "phasing" "phase" "out"

phase_action ::= phase_in_filtered | phase_out_with_phasing

/* @sem Operation::Together([$phase_action, $phase_action_2]) */
simultaneous_phase_actions ::= "simultaneously" "," phase_action "and" phase_action

/* The counted population is shared with other per-player quantities. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Investigate{times:$count_players_hand_comparison}} */
investigate_for_player_count ::= "investigate" "once" "for" count_players_hand_comparison

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Skip{part:UntapStep}} */
skip_next_untap_step ::= "you" "skip" "your" "next" "untap" "step"

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RollPlanarDie} */
roll_planar_die_action ::= "roll" "the" "planar" "die"

/* Referents are bound by the preceding instruction, keeping its identity. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Goad{}, objects:$group_reference} */
goad_group_reference ::= "goad" group_reference

/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Goad{until:Indefinite}, objects:$created_named_reference} */
goad_created_indefinitely ::= created_named_reference "is" "goaded" "for" "the" "rest" "of" "the" "game"

/* @sem Operation::$investigate_once */
investigate_additional_time ::= investigate_once "an" "additional" "time"

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::AdditionalPhase{phases:Beginning}} */
additional_beginning_phase ::= "there" "is" "an" "additional" "beginning" "phase" "after" "this" "phase"

monstrosity_amount ::= number | named_die_result_amount

/* @sem Expr::Dice(Result) */
named_die_result_amount ::= "X" "," "where" "X" "is" "the" "result"

/* Object-set and verb phrases compose independently for keyword actions. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:$shared_keyword_verb, objects:$source_other_targets} */
shared_keyword_imperative ::= shared_keyword_verb source_other_targets

/* @sem ObjectKeywordAction::Airbend */
shared_keyword_verb ::= "airbend"

/* @sem Operation::KeywordEach{actor:One(AbilityController), action:$opponent_keyword_verb, objects:$opponent_distinct_targets} */
shared_opponent_keyword ::= "for" "each" "opponent" "," opponent_keyword_verb opponent_distinct_targets

/* @sem ObjectKeywordAction::Goad{} */
opponent_keyword_verb ::= "goad"

/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Connive, objects:$convoked_creature_set} */
shared_singular_keyword ::= convoked_creature_set "connives"

/* @sem Instruction::[Effect{result:@mark, operation:$roll_composed_action}] */
die_highest_roll ::= roll_composed_action

/* Loyalty die tables use their own row bodies, keeping their special payment
   and pronoun spellings local to this table. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[Loyalty(Constant(0))]}, limits:ActivationLimits{sorcery:true}, announcement:@announcement, body:Program{instructions:[...$die_roll, ...$loyalty_die_rows]}} */
activated_loyalty_die_table ::= "[" "0" "]" ":" die_roll "." NEWLINE loyalty_die_rows

/* @sem Instruction::[$loyalty_die_row] */
loyalty_die_rows_one ::= loyalty_die_row

/* @sem Instruction::[$loyalty_die_row, ...$loyalty_die_rows] */
loyalty_die_rows_more ::= loyalty_die_row NEWLINE loyalty_die_rows

loyalty_die_rows ::= loyalty_die_rows_one | loyalty_die_rows_more

loyalty_die_row ::= loyalty_die_row_pair | loyalty_die_row_single

/* @sem Instruction::If{condition:AllOf([Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number_digits}}, Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:LessOrEqual, value:$number_digits_2}}]), then:$loyalty_die_body, otherwise:Program{}} */
loyalty_die_row_pair ::= number_digits "or" number_digits "—" loyalty_die_body

/* @sem Instruction::If{condition:Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:Equal, value:$number_digits}}, then:$loyalty_die_body, otherwise:Program{}} */
loyalty_die_row_single ::= number_digits "—" loyalty_die_body

loyalty_die_body ::= loyalty_die_create | loyalty_die_return | loyalty_die_damage_him | loyalty_die_grant

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Loyalty($loyalty)]}}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:$count_plural, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Created(@prior)), changes:[GrantKeyword($keyword_name)], duration:EndOfTurn, evaluation:Snapshot}}]} */
loyalty_die_create ::= "[" loyalty "]" "," "then" "create" count_plural token_recipe "." "they" "gain" keyword_name "until" "end" "of" "turn" "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Loyalty($loyalty)]}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$number_digits}}}, count:Exactly(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand{}}}]} */
loyalty_die_return ::= "[" loyalty "]" "," "then" "return" "a" "card" "with" "mana" "value" number_digits "or" "less" "from" "your" "graveyard" "to" "your" "hand" "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Recipient, terms:_{options:[Recipients(Union([Players(All), Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)})]))], count:Exactly(Constant(1))}}}, Effect{result:@next, operation:DealDamage{source:Source, recipients:Chosen, amount:CountCounters{recipients:Objects(One(Source)), kind:Named(LoyaltyCounter), information:CurrentOrLastKnown}, preventable:true}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Loyalty($loyalty)]}}}]} */
loyalty_die_damage_him ::= SELF_NAME "deals" "damage" "equal" "to" "the" "number" "of" "loyalty" "counters" "on" "him" "to" "a" "creature" "or" "player" "," "then" "[" loyalty "]" "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Loyalty($loyalty)]}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(ActivationGrant{abilities:AllOf([OnStack(Loyalty), AbilityOf(SameObject(Source))]), grant:AdditionalTimes($count_plural)})], duration:EndOfTurn, evaluation:LiveObjects}}]} */
loyalty_die_grant ::= "[" loyalty "]" "," "and" "you" "may" "activate" SELF_NAME "'s" "loyalty" "ability" count_plural "more" "times" "this" "turn" "."

/* The target group supplies its own count and controller filter. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Detain, objects:$objects_targets_plain} */
detain_target_group ::= "detain" objects_targets_plain

/* The duration follows the named permanent; the phased object stays independent. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::PhaseOut{until:WhileOnBattlefield($object_ref_2)}, objects:One($object_ref)} */
phase_out_until_permanent_leaves ::= object_ref "phases" "out" "until" object_ref "leaves" "the" "battlefield"

/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::PhaseOut{}, objects:$all_of_that_type} */
phase_out_chosen_population ::= all_of_that_type "phase" "out"

/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::PhaseOut{}, objects:$objects_each} */
each_phases_out ::= objects_each "phases" "out"

/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Goad{}, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ChosenOn(_{kind:CardName, object:$object_ref})])}} */
goad_named_for_object ::= "goad" "all" filter_plural "with" "a" "name" "chosen" "for" object_ref

/* The following phase sequence is shared by the two postposed forms. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::AdditionalPhase{phases:$postposed_phases}} */
additional_phase_after ::= "there" "is" "an" "additional" postposed_phases

postposed_phases ::= postposed_combat | postposed_combat_main

/* @sem AddedPhases::Combat */
postposed_combat ::= "combat" "phase" "after" "this" "phase"

/* @sem AddedPhases::CombatAndMain */
postposed_combat_main ::= "combat" "phase" "after" "this" "phase" "followed" "by" "an" "additional" "main" "phase"

/* Imperative and explicit-subject forms share the same turn-part operand. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Skip{part:$your_skipped_part}} */
skip_next_your_part ::= "skip" "your" "next" your_skipped_part

/* @sem $skip_next_your_part */
you_skip_next_your_part ::= "you" skip_next_your_part

your_skipped_part ::= your_skipped_turn | skipped_draw_step

/* @sem SkippedPart::Turn */
your_skipped_turn ::= "turn"

/* Game results retain the controller identity in the enclosing operation. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:$game_result} */
game_outcome ::= game_result

game_result ::= game_draw_result | game_win_result

/* @sem KeywordAction::DrawGame */
game_draw_result ::= "the" "game" "is" "a" "draw"

/* @sem KeywordAction::WinGame */
game_win_result ::= "you" "win" "the" "game"

/* Announce one graveyard target before the die roll; both rows use that target. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:$roll_die_action}, If{condition:AllOf([Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:LessOrEqual, value:$number_2}}]), then:_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:Move{objects:One($target_card_your_graveyard), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}}]}, otherwise:_{}}, If{condition:AllOf([Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number_3}}, Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:LessOrEqual, value:$number_4}}]), then:_{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:0, index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:_{}}]} */
program_sentence_target_die_ranges ::= "choose" target_card_your_graveyard "," "then" roll_die_action "." NEWLINE number "―" number "|" "you" "may" "put" "that" "card" "on" "top" "of" "your" "library" "." NEWLINE number "―" number "|" "return" "that" "card" "to" "your" "hand" "."

/* The impersonal day transition belongs to the ability controller. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::BecomeDay} */
become_day_action ::= "it" "becomes" "day"

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::BecomeNight} */
become_night_action ::= "it" "becomes" "night"

/* Counted investigations share ordinary population and history operands. */
/* @sem Expr::CountObjects($affected) */
investigate_object_count ::= affected

/* @sem Expr::CountPlayers(Intersection([$players_singular, Matching{binding:0, condition:Compare{left:EventHistory{event:Player{event:LosesLife, players:One(Bound(0))}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}])) */
investigate_life_loss_count ::= players_singular "who" "lost" "life" "this" "turn"

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Investigate{times:$investigate_object_count}} */
investigate_for_population ::= "investigate" "once" "for" investigate_object_count

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Investigate{times:$investigate_life_loss_count}} */
investigate_for_life_loss ::= "investigate" "for" investigate_life_loss_count

/* The X definition is reusable by counted keyword actions. */
/* @sem $value */
keyword_defined_x ::= "X" "," "where" "X" "is" value

/* @sem Operation::Keyword{actor:One(ControllerOf(@it)), action:KeywordAction::Incubate{amount:$keyword_defined_x}} */
controller_incubates_defined ::= "its" "controller" "incubates" keyword_defined_x

phase_out_population ::= objects_all_of_that_type | objects_any_other_event_targets_controlled | objects_unchosen_except_reference

/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::PhaseOut{}, objects:$phase_out_population} */
phase_out_composed_population ::= phase_out_population "phase" "out"

/* A resolving player selects one permanent and applies the named action to
   that exact selection. The noun retains its complete filter. */
/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$selected_keyword_filter}, chooser:Players(One(AbilityController)), count:Exactly(Constant(1))}], action:KeywordEach{actor:One(AbilityController), action:$selected_keyword_verb, objects:Prepared(@selection_id(0))}} */
selected_single_keyword_action ::= selected_keyword_verb selected_keyword_filter

/* @sem ObjectKeywordAction::Transform */
selected_keyword_transform ::= "transform"
/* @sem ObjectKeywordAction::Convert */
selected_keyword_convert ::= "convert"
selected_keyword_verb ::= selected_keyword_transform | selected_keyword_convert

/* A keyword action applied by the controller to the selected population. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:$population_keyword_verb, objects:$affected} */
population_keyword_operation ::= population_keyword_verb affected

/* @sem ObjectKeywordAction::Goad{} */
population_keyword_goad ::= "goad"

/* @sem ObjectKeywordAction::Detain */
population_keyword_detain ::= "detain"

population_keyword_verb ::= population_keyword_goad | population_keyword_detain

/* A quantified player performs the selected die action individually. */
shared_singular_die_action ::= shared_singular_d20_action | shared_singular_d6_action | shared_singular_d4_action

/* @sem KeywordAction::RollDie{sides:20} */
shared_singular_d20_action ::= "rolls" "a" "d20"

/* @sem KeywordAction::RollDie{sides:6} */
shared_singular_d6_action ::= "rolls" "a" "d6"

/* @sem KeywordAction::RollDie{sides:4} */
shared_singular_d4_action ::= "rolls" "a" "d4"

/* These rows keep their explicit choice and bound-player wording in die tables. */
/* @prefer always */
/* @sem Instruction::If{condition:AllOf([Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:LessOrEqual, value:$number_2}}]), then:Program{instructions:[Effect{result:@next, operation:@apply($players_singular, $sacrifice_choice_third_plain)}]}, otherwise:_{}} */
die_row_range_sacrifice_choice ::= number "―" number "|" players_singular sacrifice_choice_third_plain "."

/* @prefer always */
/* @sem Instruction::If{condition:Compare{left:DieResult(@marked), test:NumberTest::Compare{comparison:Equal, value:$number}}, then:Program{instructions:$die_extreme_that_player}, otherwise:_{}} */
die_row_exact_extreme_that_player ::= number "|" die_extreme_that_player "."

/* @sem Instruction::[ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(Bound(0)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_nonlist_head, ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:Equal, value:Expr::Aggregate{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($plural_head, ObjectFilter::ControlledBy(One(Bound(0))))}, property:$stat, aggregation:$extreme_aggregation}}})}, choose:AsManyAsCan(Constant(1))})}]}}] */
die_extreme_that_player ::= hand_plural_players "sacrifices" "a" filter_nonlist_head "with" "the" extreme_aggregation stat "among" plural_head "that" "player" "controls"

discover_amount ::= value | excess_damage_x_amount

/* @sem Expr::ExcessDamage{result:@prior, to:Any} */
excess_damage_x_amount ::= "X" "," "where" "X" "is" "that" "excess" "damage"

/* This action is only dispatched under a trigger that supplies excess damage. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Amass{amount:EventAmount, creature_type:@subtype_name($subtype_plural)}} */
amass_excess_damage ::= "amass" subtype_plural "X" "," "where" "X" "is" "that" "excess" "damage"

/* One target group holds both objects and the shared type constraint. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::ExchangeControl{first:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(2)), filter:AllOf([Not(Supertype(Basic)), $adjective_nontype]), constraints:[CommonProperty(CardTypes)]}), index:0}, second:Target{slot:@next_slot, index:1}}} */
exchange_control_pair_shared_type ::= "exchange" "control" "of" "two" "target" "nonbasic" "," adjective_nontype "permanents" "that" "share" "a" "card" "type"

/* The controller chooses any number from the named population, then applies
   the same keyword action to those selected objects. */
/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), objects:$affected, chooser:Players(One(AbilityController)), count:AnyNumber}], action:KeywordEach{actor:One(AbilityController), action:$selected_keyword_verb, objects:Prepared(@selection_id(0))}} */
selected_any_keyword_action ::= selected_keyword_verb "any" "number" "of" affected

/* Apply a keyword action to each member of a written population. */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Goad{}, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}} */
goad_each ::= "goad" "each" filter_phrase

/* The player named by a preceding event controls the affected population. */
/* @prefer always */
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Goad{}, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(EventSubject)))}} */
goad_each_event_player ::= "goad" "each" filter_phrase "that" "player" "controls"

/* A constrained pair introduces a single target group; both exchange operands
   refer to members of that same group. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(2)), filter:AllOf([Not(SameObject(Source)), $filter_plural]), constraints:[DifferentControllers]}), index:0} */
two_other_targets_different_controllers ::= "two" "other" "target" filter_plural "controlled" "by" "different" "players"

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::ExchangeControl{first:$two_other_targets_different_controllers, second:Target{slot:@next_slot, index:1}}} */
exchange_control_constrained_pair ::= "exchange" "control" "of" two_other_targets_different_controllers
