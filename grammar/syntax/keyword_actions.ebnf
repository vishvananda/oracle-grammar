/* Keyword actions the ability's controller performs. A single application
   keeps the native absent amount; counted applications retain theirs. */
keyword_action ::= investigate_action | populate_action | open_attraction_action | time_travel_action | roll_die_action
    | additional_combat_phase | additional_combat_and_main_phase | become_monarch | take_initiative | ring_tempts_you
    | venture_into_dungeon | take_extra_turn | learn_action | end_the_turn | planeswalk_action | win_the_game
    | reverse_turn_order | skip_next_turn | skip_next_draw_step | amount_keyword_action | object_keyword_action
    | group_keyword_action

investigate_action ::= investigate_once | investigate_twice | investigate_number_times | investigate_that_many_times
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Investigate{}} */
investigate_once ::= "investigate"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Investigate{times:Constant(2)}} */
investigate_twice ::= "investigate" "twice"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Investigate{times:$number}} */
investigate_number_times ::= "investigate" number "times"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Investigate{times:EventAmount}} */
investigate_that_many_times ::= "investigate" "that" "many" "times"

populate_action ::= populate_once | populate_number_times
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Populate{}} */
populate_once ::= "populate"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Populate{times:$number}} */
populate_number_times ::= "populate" number "times"

open_attraction_action ::= open_an_attraction | open_attractions
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::OpenAttraction{}} */
open_an_attraction ::= "open" "an" "Attraction"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::OpenAttraction{times:$value}} */
open_attractions ::= "open" value "Attractions"

time_travel_action ::= time_travel_once | time_travel_times
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::TimeTravel{}} */
time_travel_once ::= "time" "travel"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::TimeTravel{times:$value}} */
time_travel_times ::= "time" "travel" value "times"

roll_die_action ::= plain_roll_d20 | roll_d4 | roll_six_sided_dice
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RollDie{sides:4}} */
roll_d4 ::= "roll" "a" "d4"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RollDie{sides:6, times:$value}} */
roll_six_sided_dice ::= "roll" value "six-sided" "dice"

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::AdditionalPhase{phases:Combat}} */
additional_combat_phase ::= "after" "this" "phase" "," "there" "is" "an" "additional" "combat" "phase"
    | "there" "is" "an" "additional" "combat" "phase" "after" "this" "phase"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::AdditionalPhase{phases:CombatAndMain}} */
additional_combat_and_main_phase ::= "after" "this" "main" "phase" "," "there" "is" "an" "additional" "combat" "phase" "followed" "by" "an" "additional" "main" "phase"
    | "there" "is" "an" "additional" "combat" "phase" "after" "this" "phase" "," "followed" "by" "an" "additional" "main" "phase"

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::BecomeMonarch} */
become_monarch ::= "you" "become" "the" "monarch"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::TakeInitiative} */
take_initiative ::= "you" "take" "the" "initiative"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::RingTempts} */
ring_tempts_you ::= "the" "Ring" "tempts" "you"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Venture} */
venture_into_dungeon ::= "venture" "into" "the" "dungeon"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::TakeExtraTurn{}} */
take_extra_turn ::= "take" "an" "extra" "turn" "after" "this" "one"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Learn} */
learn_action ::= "learn"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::EndTheTurn} */
end_the_turn ::= "end" "the" "turn"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Planeswalk} */
planeswalk_action ::= "planeswalk"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::WinGame} */
win_the_game ::= "you" "win" "the" "game"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::ReverseTurnOrder} */
reverse_turn_order ::= "reverse" "the" "game's" "turn" "order"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Skip{part:Turn}} */
skip_next_turn ::= "you" "skip" "your" "next" "turn"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Skip{part:DrawStep}} */
skip_next_draw_step ::= "you" "skip" "your" "next" "draw" "step"

amount_keyword_action ::= adapt_action | bolster_action | incubate_action | discover_action | monstrosity_action
    | fateseal_action | collect_evidence_action | blight_action | earthbend_action | amass_action
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Adapt{amount:$value}} */
adapt_action ::= "adapt" value
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Bolster{amount:$value}} */
bolster_action ::= "bolster" value
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Incubate{amount:$value}} */
incubate_action ::= "incubate" value
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Discover{amount:$value}} */
discover_action ::= "discover" value
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Monstrosity{amount:$number}} */
monstrosity_action ::= "monstrosity" number
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Fateseal{amount:$value}} */
fateseal_action ::= "fateseal" value
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::CollectEvidence{amount:$value}} */
collect_evidence_action ::= "collect" "evidence" value
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Blight{amount:$value}} */
blight_action ::= "blight" value
/* Earthbending chooses its land as the action's own target. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Earthbend{object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Land), ControlledBy(One(AbilityController))])}), index:0}, amount:$value}} */
earthbend_action ::= "earthbend" value
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Amass{amount:$value, creature_type:@subtype_name($subtype_plural)}} */
amass_action ::= "amass" subtype_plural value

object_keyword_action ::= transform_object | goad_object | detain_object | convert_object | flip_object | airbend_object
    | assimilate_object | turn_object_face_up | turn_object_face_down | exchange_control_of_objects | unlock_door_of_object
    | object_explores | object_phases_out | object_intensifies | object_becomes_prepared | object_endures
    | object_becomes_saddled
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Transform{object:$object_ref}} */
transform_object ::= "transform" object_ref
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Goad{object:$object_ref}} */
goad_object ::= "goad" object_ref
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Detain{object:$object_ref}} */
detain_object ::= "detain" object_ref
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Convert{object:$object_ref}} */
convert_object ::= "convert" object_ref
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Flip{object:$object_ref}} */
flip_object ::= "flip" object_ref
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Airbend{object:$object_ref}} */
airbend_object ::= "airbend" object_ref
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Assimilate{object:$object_ref}} */
assimilate_object ::= "assimilate" object_ref
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::TurnFaceUp{object:$object_ref}} */
turn_object_face_up ::= "turn" object_ref "face" "up"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::TurnFaceDown{object:$object_ref}} */
turn_object_face_down ::= "turn" object_ref "face" "down"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::ExchangeControl{first:$object_ref, second:$object_ref_2}} */
exchange_control_of_objects ::= "exchange" "control" "of" object_ref "and" object_ref
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::UnlockDoor{object:$object_ref}} */
unlock_door_of_object ::= "unlock" "a" "locked" "door" "of" object_ref
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Explore{object:$object_ref}} */
object_explores ::= object_ref "explores"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::PhaseOut{object:$object_ref}} */
object_phases_out ::= object_ref "phases" "out"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Intensify{object:$object_ref}} */
object_intensifies ::= object_ref "intensifies"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Prepare{object:$object_ref}} */
object_becomes_prepared ::= object_ref "becomes" "prepared"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Endure{object:$object_ref, amount:$value}} */
object_endures ::= object_ref "endures" value
/* Saddling always lasts until end of turn. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Saddle{object:$object_ref}} */
object_becomes_saddled ::= object_ref "becomes" "saddled" "until" "end" "of" "turn"

group_keyword_action ::= affected_phase_out | affected_connive | affected_become_blocked | transform_all | each_explores
    | turn_all_face_down | detain_each
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::PhaseOut{}, objects:$affected} */
affected_phase_out ::= affected "phase" "out"
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Connive, objects:$affected} */
affected_connive ::= affected "connive"
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::BecomeBlocked, objects:$affected} */
affected_become_blocked ::= affected "become" "blocked"
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Transform, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}} */
transform_all ::= "transform" "all" filter_plural
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Explore, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}} */
each_explores ::= "each" filter_phrase "explores"
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::TurnFaceDown, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}} */
turn_all_face_down ::= "turn" "all" filter_plural "face" "down"
/* @sem Operation::KeywordEach{actor:One(AbilityController), action:ObjectKeywordAction::Detain, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}} */
detain_each ::= "detain" "each" filter_phrase
