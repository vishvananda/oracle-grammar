/* Replacement effects, prevention and delayed triggers. */

replacement_clause ::= replacement_player_draw_exile | replacement_permanent_damage_multiplier | replacement_redirect_all_damage | replacement_skip_extra_turn | replacement_choose_two_players_entering | replacement_matching_color_counterpart | replacement_chosen_player_counterpart | replacement_counters_double_minus | replacement_counters_double | replacement_effect_counters_double | replacement_counters_add | replacement_counters_add_each_kind | replacement_counters_subtract | replacement_counter_exile_play | replacement_prevent_all | replacement_prevent_to_by_permanents | replacement_prevent_to_by_sources | replacement_prevent_by_permanents | replacement_prevent_self_deals | replacement_prevent_to_and_by | replacement_prevent | replacement_dealt_prevent | replacement_dealt_prevent_and | replacement_dealt_prevent_then | replacement_dealt_instead | replacement_prevent_some | replacement_prevent_all_but | replacement_double_damage | replacement_plus_damage | replacement_draw_instead | replacement_draw_may_instead | replacement_draw_empty | replacement_tokens_twice_yours | replacement_tokens_twice_any | replacement_tokens_plus_yours | replacement_enter_cost_or_graveyard | replacement_scale_outgoing | replacement_redirect_controller | replacement_entry_creature | replacement_effect_token_copies | replacement_player_skip_extra | replacement_player_lose_instead | replacement_mana_color_choice | replacement_attached_destroyed_sacrifice | replacement_damage_prevent_draw | replacement_damage_half_down | replacement_damage_double_opponent | replacement_damage_prevent_half | replacement_damage_double_you | replacement_mana_produced | replacement_explore_scry | replacement_untap_counters | replacement_prevent_counted_damage | replacement_opponent_mill | replacement_search_top | replacement_extra_draw_skip | replacement_draw_each_one | replacement_opponent_counters_half | replacement_counter_plus_phrase | replacement_counter_each_double_phrase | replacement_filtered_token_phrase | replacement_self_damage_phrase

/* A creature or permanent without the word card is a battlefield population.
   The counter kind is repeated in the replacement and must agree. */
/* @sem ObjectFilter::InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counter_replacement_filter}) */
counter_replacement_population ::= ("a" | "an") counter_replacement_filter

counter_replacement_filter ::= counter_replacement_head | counter_replacement_modified | counter_replacement_adjectives
/* @sem @and($counter_replacement_head, $modifiers) */
counter_replacement_modified ::= counter_replacement_head modifiers
/* @sem @and($adjectives, $counter_replacement_filter) */
counter_replacement_adjectives ::= adjectives counter_replacement_filter
counter_replacement_head ::= counter_replacement_noun | counter_replacement_union | counter_replacement_union_three
/* @sem ObjectFilter::AnyOf(@unordered([$counter_replacement_noun, $counter_replacement_noun_2])) */
counter_replacement_union ::= counter_replacement_noun "or" counter_replacement_noun
/* @sem ObjectFilter::AnyOf(@unordered([$counter_replacement_noun, $counter_replacement_noun_2, $counter_replacement_noun_3])) */
counter_replacement_union_three ::= counter_replacement_noun "," counter_replacement_noun ","? "or" counter_replacement_noun
counter_replacement_noun ::= noun_creature | noun_artifact | noun_enchantment | noun_land | noun_planeswalker | noun_permanent | noun_battle | noun_token | subtype

/* Created tokens: twice that many of them, or those tokens and another group, instead. */
/* @sem Ability::Replacement{active:Battlefield, event:Tokens{tokens:Any, controllers:One(AbilityController)}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:ReplaceTokens{copies:2}}}]}} */
replacement_tokens_twice_yours ::= "if" "one" "or" "more" "tokens" "would" "be" "created" "under" "your" "control" "," "twice" "that" "many" "of" "those" "tokens" "are" "created" "instead" "."
/* @sem Ability::Replacement{active:Battlefield, event:Tokens{tokens:Any}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:ReplaceTokens{copies:2}}}]}} */
replacement_tokens_twice_any ::= "if" "one" "or" "more" "tokens" "would" "be" "created" "," "twice" "that" "many" "of" "those" "tokens" "are" "created" "instead" "."
/* @sem Ability::Replacement{active:Battlefield, event:Tokens{tokens:Any, controllers:One(AbilityController)}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:ReplaceTokens{copies:1, tokens:[$token_group]}}}]}} */
replacement_tokens_plus_yours ::= "if" "one" "or" "more" "tokens" "would" "be" "created" "under" "your" "control" "," "those" "tokens" "plus" token_group "are" "created" "instead" "."

/* @sem Ability::Replacement{active:Battlefield, event:Counters(_{kind:PowerToughness(1, 1), objects:$counter_replacement_population}), body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([Constant(2), EventAmount]))}}]}} */
replacement_counters_double ::= "if" "one" "or" "more" "+" "1" "/" "+" "1" "counters" "would" "be" "put" "on" counter_replacement_population "," "twice" "that" "many" "+" "1" "/" "+" "1" "counters" "are" "put" "on" "it" "instead" "."

/* Only counters an effect puts are doubled, whatever their kind. */
/* @sem Ability::Replacement{active:Battlefield, event:Counters(_{objects:$counter_replacement_population, effect_only:true}), body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([Constant(2), EventAmount]))}}]}} */
replacement_effect_counters_double ::= "if" "an" "effect" "would" "put" "one" "or" "more" "counters" "on" counter_replacement_population "," "it" "puts" "twice" "that" "many" "of" "those" "counters" "on" "that" "permanent" "instead" "."

/* @sem Ability::Replacement{active:Battlefield, event:Counters(_{kind:PowerToughness(1, 1), objects:$counter_replacement_population}), body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Add([EventAmount, $number]))}}]}} */
replacement_counters_add ::= "if" "one" "or" "more" "+" "1" "/" "+" "1" "counters" "would" "be" "put" "on" counter_replacement_population "," "that" "many" "plus" number "+" "1" "/" "+" "1" "counters" "are" "put" "on" counters_put_back "instead" "."

/* Each kind of counter gets more of itself. */
/* @sem Ability::Replacement{active:Battlefield, event:Counters(_{objects:$counter_replacement_population}), body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Add([EventAmount, $number]))}}]}} */
replacement_counters_add_each_kind ::= "if" "one" "or" "more" "counters" "would" "be" "put" "on" counter_replacement_population "," "that" "many" "plus" number "of" "each" "of" "those" "kinds" "of" "counters" "are" "put" "on" counters_put_back "instead" "."
/* @sem () */
counters_put_back ::= "it" | "that" "permanent" | "that" "creature"

/* @sem Ability::Replacement{active:Battlefield, event:Counters(_{kind:PowerToughness(-1, -1), objects:$counter_replacement_population}), body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Subtract([EventAmount, $number]))}}]}} */
replacement_counters_subtract ::= "if" "one" "or" "more" "-" "1" "/" "-" "1" "counters" "would" "be" "put" "on" counter_replacement_population "," "that" "many" "-" "1" "/" "-" "1" "counters" "minus" number "are" "put" "on" "it" "instead" "."

/* The replaced counter event identifies its destination after the exile change. */
/* @sem Ability::Replacement{active:Battlefield, event:Countered{spells:$spell_filter, by:$countering_source}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:Either, cards:One(ObjectRef::Query{objects:InZone{objects:One(ObjectRef::EventDestination), zone:Exile}, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}]}} */
replacement_counter_exile_play ::= "if" countering_source "would" "counter" spell_filter "," "instead" "exile" "that" "spell" "and" "you" "may" "play" "that" "card" "without" "paying" "its" "mana" "cost" "."

/* @sem ObjectFilter::ControlledBy(One(PlayerRef::AbilityController)) */
countering_source ::= "a" "spell" "or" "ability" "you" "control"

/* @sem Ability::Replacement{active:Battlefield, event:$damage_event, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
replacement_prevent ::= "if" damage_event "," "prevent" "that" "damage" "."

/* Damage from any source, in the passive: "If damage would be dealt to you". */
/* @sem ReplacementEvent::Damage(DamageEvent{source_kind:Any, sources:ObjectFilter::Any, recipients:$replacement_damage_to, kind:DamageKind::Any, grouping:SourceRecipient, subject:Recipient}) */
damage_dealt_event ::= "damage" "would" "be" "dealt" "to" replacement_damage_to

/* @sem Ability::Replacement{active:Battlefield, event:$damage_dealt_event, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
replacement_dealt_prevent ::= "if" damage_dealt_event "," "prevent" "that" "damage" "."

/* What follows the prevention still answers the same damage event: "that many" is
   its amount and "it" its recipient. */
/* @sem Ability::Replacement{active:Battlefield, event:$damage_dealt_event, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}, ...$instructions]}} */
replacement_dealt_prevent_and ::= "if" damage_dealt_event "," "prevent" "that" "damage" "and" instructions "."

/* @sem Ability::Replacement{active:Battlefield, event:$damage_dealt_event, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}, ...$instructions]}} */
replacement_dealt_prevent_then ::= "if" damage_dealt_event "," "prevent" "that" "damage" "." instructions "."

/* @sem Ability::Replacement{active:Battlefield, event:$damage_dealt_event, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:Cancel}}, ...$instructions]}} */
replacement_dealt_instead ::= "if" damage_dealt_event "," instructions "instead" "."

/* @sem Ability::Replacement{active:Battlefield, event:$damage_event, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventSomeDamage($number)}}]}} */
replacement_prevent_some ::= "if" damage_event "," "prevent" number "of" "that" "damage" "."

/* Double or triple damage, to the same recipient. */
/* @sem Ability::Replacement{active:Battlefield, event:$damage_event, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:SetAmount(Expr::Multiply([$damage_factor, Expr::EventAmount]))}}]}} */
replacement_double_damage ::= "if" damage_event "," "it" "deals" damage_factor "that" "damage" damage_instead "."
/* @sem Ability::Replacement{active:Battlefield, event:$permanent_damage_event, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([$damage_factor, EventAmount]))}}]}} */
replacement_permanent_damage_multiplier ::= "if" permanent_damage_event "," "it" "deals" damage_factor "that" "damage" damage_instead "."
/* @sem ReplacementEvent::Damage(_{source_kind:Permanent, sources:$filter_phrase, recipients:$replacement_damage_to, kind:$event_damage_kind, grouping:SourceRecipient, subject:Recipient}) */
permanent_damage_event ::= "a" filter_phrase "would" "deal" event_damage_kind "to" replacement_damage_to
/* @sem Expr::Constant(2) */
damage_factor_double ::= "double"
/* @sem Expr::Constant(3) */
damage_factor_triple ::= "triple"
damage_factor ::= damage_factor_double | damage_factor_triple
/* @sem () */
damage_instead ::= "instead" | "to" "that" ("permanent" | "player" | "creature") "instead" | "to" "that" "permanent" "or" "player" "instead"

/* @sem Ability::Replacement{active:Battlefield, event:$damage_event, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:SetAmount(Expr::Add([Expr::EventAmount, $value]))}}]}} */
replacement_plus_damage ::= "if" damage_event "," "it" "deals" "that" "much" "damage" "plus" value damage_instead "."

/* @sem Ability::Replacement{active:Battlefield, event:$damage_event, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventAllButDamage($number)}}]}} */
replacement_prevent_all_but ::= "if" damage_event "," "prevent" "all" "but" number "of" "that" "damage" "."

/* @sem ReplacementEvent::Damage(DamageEvent{source_kind:Any, sources:$replacement_damage_source, recipients:$replacement_damage_to, kind:$event_damage_kind, grouping:SourceRecipient, subject:Recipient}) */
damage_event ::= replacement_damage_source "would" "deal" event_damage_kind "to" replacement_damage_to

/* A damage source of any kind: a spell, a permanent or a card. */
damage_source ::= source_any | source_yours | source_opponents | source_yours_except

/* @sem ObjectFilter::Any */
source_any ::= "a" "source"

/* @sem ObjectFilter::ControlledBy(One(PlayerRef::AbilityController)) */
source_yours ::= "a" "source" "you" "control"

/* @sem ObjectFilter::ControlledBy(OpponentsOf(PlayerRef::AbilityController)) */
source_opponents ::= "a" "source" "an" "opponent" "controls"

replacement_damage_source ::= damage_source | source_color | source_color_yours | source_other_color_yours
/* @sem ObjectFilter::$adjective_color */
source_color ::= "a" adjective_color "source"
/* @sem ObjectFilter::AllOf([$adjective_color, ControlledBy(One(PlayerRef::AbilityController))]) */
source_color_yours ::= "a" adjective_color "source" "you" "control"

event_damage_kind ::= prevent_damage | damage_kind_noncombat
/* @sem DamageKind::Noncombat */
damage_kind_noncombat ::= "noncombat" "damage"

damage_to ::= damage_to_you | damage_to_each | damage_to_filter

replacement_damage_to ::= damage_to_another_controlled | damage_to | damage_to_player | damage_to_object | damage_to_filter_or_player | damage_to_opponent_or | damage_to_you_or
/* @sem DamageRecipients::Players(All) */
damage_to_player ::= "a" "player"
/* @sem DamageRecipients::Objects(ObjectFilter::SameObject($object_ref)) */
damage_to_object ::= object_ref
/* @sem DamageRecipients::ObjectsAndPlayers{objects:$filter_phrase, players:All} */
damage_to_filter_or_player ::= ("a" | "an") filter_phrase "or" "player"
/* @sem DamageRecipients::ObjectsAndPlayers{objects:$filter_phrase, players:OpponentsOf(PlayerRef::AbilityController)} */
damage_to_opponent_or ::= "an" "opponent" "or" ("a" | "an") filter_phrase
/* @sem DamageRecipients::ObjectsAndPlayers{objects:$filter_phrase, players:One(PlayerRef::AbilityController)} */
damage_to_you_or ::= "you" "or" ("a" | "an") filter_phrase

/* @sem DamageRecipients::Players(One(PlayerRef::AbilityController)) */
damage_to_you ::= "you"

/* @sem DamageRecipients::Players(OpponentsOf(PlayerRef::AbilityController)) */
damage_to_each ::= "an" "opponent"

/* @sem DamageRecipients::Objects($filter_phrase) */
damage_to_filter ::= ("a" | "an") filter_phrase

/* @sem ReplacementEvent::Player{event:Draw, players:One(PlayerRef::AbilityController)} */
draw_event ::= "you" "would" "draw" "a" "card"

/* @sem Ability::Replacement{active:Battlefield, event:$draw_event, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:Cancel}}, ...$instructions]}} */
replacement_draw_instead ::= "if" draw_event "," instructions "instead" "."

/* "If you would draw a card while your library has no cards in it, you win the game
   instead": the replacement applies only while the library is empty. */
replacement_draw_empty ::= replacement_draw_empty_after | replacement_draw_empty_before
/* @sem Ability::Conditional{condition:Compare{left:CountObjects(Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), test:Compare{comparison:Equal, value:Constant(0)}}, then:[Ability::Replacement{active:Battlefield, event:$draw_event, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:Cancel}}, ...$instructions]}}]} */
replacement_draw_empty_after ::= "if" draw_event "while" "your" "library" "has" "no" "cards" "in" "it" "," instructions "instead" "."
/* @sem Ability::Conditional{condition:Compare{left:CountObjects(Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), test:Compare{comparison:Equal, value:Constant(0)}}, then:[Ability::Replacement{active:Battlefield, event:$draw_event, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:Cancel}}, ...$instructions]}}]} */
replacement_draw_empty_before ::= "if" draw_event "while" "your" "library" "has" "no" "cards" "in" "it" "," "instead" instructions "."

/* Declining the optional action keeps the draw (CR 614.1a): the choice is
   between the action and the draw itself, each in place of the event. */
/* @sem Ability::Replacement{active:Battlefield, event:$draw_event, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:Cancel}}, Instruction::Effect{result:@next, operation:Operation::ChooseAction{actor:One(PlayerRef::AbilityController), options:[Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:Cancel}}, ...$instructions]}, Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:Cancel}}, Instruction::Effect{result:@next, operation:Operation::Draw{players:One(PlayerRef::AbilityController), amount:Constant(1)}}]}]}}]}} */
replacement_draw_may_instead ::= "if" draw_event "," "you" "may" instructions "instead" "."

/* The shield an instant leaves behind. */
prevent_clause ::= shield_each_next | shield_by_next | shield_next_occurrence | redirect_next_occurrence | redirect_next_amount | redirect_next_pair | prevent_distributed_targets | prevent_combat_to_by | prevent_next | prevent_all | prevent_all_dealt | prevent_radiance | prevent_all_late_to | prevent_all_to_by_permanents | prevent_all_to_by_permanents_late | prevent_all_to_by_sources | prevent_all_by_permanents | prevent_all_by_permanents_late | prevent_all_by_sources | prevent_all_target_deals | prevent_from_event | prevent_except_event | prevent_named_plane_event | prevent_damage_target_range | prevent_spell_damage

/* The named recipient is included even when colorless. The other population
   must be creatures sharing its color, with the original object excluded. */
/* @sem Operation::CreateReplacement{event:Damage{source_kind:Any, sources:Any, recipients:Objects(AnyOf([AllOf([CardType(Creature), Not(SameObject($object_ref)), Shares{property:Colors, with:$object_ref_2}]), SameObject($object_ref)])), kind:Any, grouping:SourceRecipient, subject:Recipient}, limit:DamageToEach($value), duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevent_radiance ::= "prevent" "the" "next" value "damage" "that" "would" "be" "dealt" "to" object_ref "and" "each" "other" "creature" "that" "shares" "a" "color" "with" object_ref this_duration

/* @sem Operation::CreateReplacement{event:Damage(DamageEvent{source_kind:Any, sources:Any, recipients:$prevent_to, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:TotalDamage($number), duration:$prevent_duration, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
prevent_next ::= "prevent" "the" "next" number "damage" "that" "would" "be" "dealt" "to" prevent_to prevent_duration

/* @sem Operation::CreateReplacement{event:Damage(DamageEvent{source_kind:Any, sources:Any, recipients:$prevent_to, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$prevent_duration, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
prevent_all ::= "prevent" "all" prevent_damage "that" "would" "be" "dealt" "to" prevent_to prevent_duration

prevent_duration ::= this_duration

/* The prevented damage: all of it, or only combat damage. */
prevent_damage ::= prevent_damage_any | prevent_damage_combat | damage_kind_noncombat
/* @sem DamageKind::Any */
prevent_damage_any ::= "damage"
/* @sem DamageKind::Combat */
prevent_damage_combat ::= "combat" "damage"

/* @sem Operation::CreateReplacement{event:Damage(DamageEvent{source_kind:Any, sources:Any, recipients:Any, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$prevent_duration, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
prevent_all_dealt ::= "prevent" "all" prevent_damage "that" "would" "be" "dealt" prevent_duration

prevent_to ::= prevent_to_any_target | prevent_to_target | prevent_to_you | prevent_to_it | prevent_to_self | prevent_to_attached | prevent_to_group | prevent_to_you_and | prevent_to_players

/* @sem DamageRecipients::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Expr::Constant(1)), filter:Any}), index:0} */
prevent_to_any_target ::= "any" "target"

/* @sem DamageRecipients::Objects(ObjectFilter::SameObject($target_object)) */
prevent_to_target ::= target_object

/* @sem DamageRecipients::Players(One(PlayerRef::AbilityController)) */
prevent_to_you ::= "you"

/* @sem DamageRecipients::Objects(ObjectFilter::SameObject($it_ref)) */
prevent_to_it ::= it_ref

/* @sem DamageRecipients::Objects(ObjectFilter::SameObject($self_explicit_ref)) */
prevent_to_self ::= self_explicit_ref
/* @sem DamageRecipients::Objects(ObjectFilter::SameObject($attached_ref)) */
prevent_to_attached ::= attached_ref
/* @sem DamageRecipients::Objects($filter_plural) */
prevent_to_group ::= filter_plural
/* @sem DamageRecipients::ObjectsAndPlayers{objects:$filter_plural, players:One(AbilityController)} */
prevent_to_you_and ::= "you" "and" filter_plural
/* @sem DamageRecipients::Players(All) */
prevent_to_players ::= "players"

/* The duration can come before the recipients. */
/* @sem Operation::CreateReplacement{event:Damage(DamageEvent{source_kind:Any, sources:Any, recipients:$prevent_to, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
prevent_all_late_to ::= "prevent" "all" prevent_damage "that" "would" "be" "dealt" this_duration "to" prevent_to
/* Damage by permanents or by sources, to recipients or to anyone. A permanent
   group names permanent sources; "sources" names any source. */
/* @sem Operation::CreateReplacement{event:Damage(DamageEvent{source_kind:Permanent, sources:$prevent_by_permanents, recipients:$prevent_to, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
prevent_all_to_by_permanents ::= "prevent" "all" prevent_damage "that" "would" "be" "dealt" "to" prevent_to this_duration "by" prevent_by_permanents
/* @sem Operation::CreateReplacement{event:Damage(DamageEvent{source_kind:Permanent, sources:$prevent_by_permanents, recipients:$prevent_to, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
prevent_all_to_by_permanents_late ::= "prevent" "all" prevent_damage "that" "would" "be" "dealt" "to" prevent_to "by" prevent_by_permanents this_duration
/* @sem Operation::CreateReplacement{event:Damage(DamageEvent{source_kind:Any, sources:$prevent_by_sources, recipients:$prevent_to, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
prevent_all_to_by_sources ::= "prevent" "all" prevent_damage "that" "would" "be" "dealt" "to" prevent_to this_duration "by" prevent_by_sources
/* @sem Operation::CreateReplacement{event:Damage(DamageEvent{source_kind:Permanent, sources:$prevent_by_permanents, recipients:Any, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
prevent_all_by_permanents ::= "prevent" "all" prevent_damage "that" "would" "be" "dealt" this_duration "by" prevent_by_permanents
/* @sem Operation::CreateReplacement{event:Damage(DamageEvent{source_kind:Permanent, sources:$prevent_by_permanents, recipients:Any, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
prevent_all_by_permanents_late ::= "prevent" "all" prevent_damage "that" "would" "be" "dealt" "by" prevent_by_permanents this_duration
/* @sem Operation::CreateReplacement{event:Damage(DamageEvent{source_kind:Any, sources:$prevent_by_sources, recipients:Any, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
prevent_all_by_sources ::= "prevent" "all" prevent_damage "that" "would" "be" "dealt" this_duration "by" prevent_by_sources
/* A targeted permanent's own damage, to anyone. */
/* @sem Operation::CreateReplacement{event:Damage(DamageEvent{source_kind:Permanent, sources:SameObject($target_object), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
prevent_all_target_deals ::= "prevent" "all" "damage" target_object "would" "deal" this_duration

/* Something later in this resolution or turn. */
/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:@captured_targets($instructions)}}}] */
clause_delayed_end_step ::= "at" "the" "beginning" "of" "the" "next" "end" "step" "," instructions

/* A fresh target in a leading time clause is announced when the later trigger
   fires. References to earlier objects remain captures from the creator. */
/* @sem Instruction::[Effect{result:@next, operation:@scope(Operation::CreateTrigger{event:Turn{point:EndStepBegins, players:All}, duration:Indefinite, announcement:@announcement, body:Program{instructions:@announced_targets($instructions)}, once:true})}] */
clause_delayed_end_step_announced ::= "at" "the" "beginning" "of" "the" "next" "end" "step" "," instructions

/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:$may_body}}}] */
clause_delayed_end_step_after ::= may_body "at" "the" "beginning" "of" "the" "next" "end" "step"

/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::CreateDelayedTrigger{event:Turn{point:UpkeepBegins, players:All}, start:NextTurn, body:Program{instructions:$may_body}}}] */
clause_delayed_upkeep_after ::= may_body "at" "the" "beginning" "of" "the" "next" "turn's" "upkeep"

/* A postposed combat time creates a delayed trigger, not a duration on the
   action. The body retains the enclosing ability's object references. */
/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, body:Program{instructions:$may_body}}}] */
clause_delayed_combat_after ::= may_body "at" "end" "of" "combat"

/* The postposed time governs an explicit then-tail in the same sentence.
   A following full stop remains an outer instruction boundary. */
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[...$may_body, ...$conjoined]}}}] */
clause_delayed_end_step_then ::= may_body "at" "the" "beginning" "of" "the" "next" "end" "step" postfix_join conjoined
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:UpkeepBegins, players:All}, start:NextTurn, body:_{instructions:[...$may_body, ...$conjoined]}}}] */
clause_delayed_upkeep_then ::= may_body "at" "the" "beginning" "of" "the" "next" "turn's" "upkeep" postfix_join conjoined
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, body:_{instructions:[...$may_body, ...$conjoined]}}}] */
clause_delayed_combat_then ::= may_body "at" "end" "of" "combat" postfix_join conjoined
/* @sem () */
postfix_join ::= "," "then"

condition_consequent ::= may_body | clause_you | clause_you_life | clause_third | clause_they | clause_may

/* A then-condition owns its conjunction or a closed dependent instruction,
   never an arbitrary program extending across independent later sentences. */
/* @sem Instruction::[If{condition:$condition, then:$then_condition_program, otherwise:Program{}}] */
clause_then_if ::= "then" "if" condition "," then_condition_program
then_condition_program ::= then_condition_plain | then_condition_where | then_condition_where_snapshot
/* @sem Program::Program{instructions:$then_condition_body} */
then_condition_plain ::= then_condition_body
/* @sem Program::@where($then_condition_plain, $value) */
then_condition_where ::= then_condition_plain "," "where" "X" "is" value
/* @sem Program::@where_snapshot($then_condition_plain, $value) */
then_condition_where_snapshot ::= then_condition_plain "," "where" "X" "is" value
then_condition_body ::= conditional_top_card_permission | conjoined | clause_conditional_closed | instructions_reveal_until

/* A postposed condition tests at resolution, even as a trigger's first instruction. */
/* @sem Instruction::[@resolution(Instruction::If{condition:$condition, then:Program{instructions:$condition_consequent}, otherwise:Program{}})] */
clause_if_after ::= condition_consequent "if" condition

/* Each counter goes only on an object of its kind, the verb said once: `put a +1/+1
   counter on it if it's a creature and a loyalty counter on it if it's a planeswalker`.
   `It` is the object both counters name; each test holds at resolution, as a postposed
   condition does. */
/* @sem Instruction::[@resolution(Instruction::If{condition:ObjectMatches{object:@it, filter:$card_filter}, then:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::PutCounters{placements:[$counter_direct_placement]}}]}, otherwise:Program{}}), @resolution(Instruction::If{condition:ObjectMatches{object:@it, filter:$card_filter_2}, then:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::PutCounters{placements:[$counter_direct_placement_2]}}]}, otherwise:Program{}})] */
clause_put_counters_each_kind ::= "put" counter_direct_placement "if" "it's" ("a" | "an") card_filter "and" counter_direct_placement "if" "it's" ("a" | "an") card_filter

/* @sem Instruction::[@resolution(Instruction::If{condition:Not($condition), then:Program{instructions:$condition_consequent}, otherwise:Program{}})] */
clause_unless_condition ::= condition_consequent "unless" condition

/* The object an instruction just moved can be named after it has moved. */
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:$exile_objects}, Instruction::Effect{result:@next, operation:Operation::Move{objects:@exile_followup(InZone{objects:One(ObjectRef::Result{result:@marked, phase:After, index:0}), zone:Exile}), destination:$battlefield_control, qualifiers:[]}}] */
clause_exile_return ::= exile_objects return_join "return" moved "to" "the" "battlefield" battlefield_control

/* @sem Instruction::[Instruction::Effect{result:@mark, operation:$exile_objects}, Instruction::Effect{result:@next, operation:Operation::CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::Move{objects:@exile_followup(InZone{objects:One(ObjectRef::Result{result:@marked, phase:After, index:0}), zone:Exile}), destination:$battlefield_control, qualifiers:[]}}]}}}] */
clause_exile_return_delayed ::= exile_objects return_join "return" moved "to" "the" "battlefield" battlefield_control "at" "the" "beginning" "of" "the" "next" "end" "step"

/* @sem () */
return_join ::= "," "then" | "."

/* A permanent its own ability exiles names itself again on its return. */
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:$exile_self}, Instruction::Effect{result:@next, operation:Operation::CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::Move{objects:@exile_followup(InZone{objects:One(ObjectRef::Result{result:@marked, phase:After, index:0}), zone:Exile}), destination:$battlefield_control, qualifiers:[]}}]}}}] */
clause_exile_self_return_delayed ::= exile_self "." "return" self_holder_text "to" "the" "battlefield" battlefield_control "at" "the" "beginning" "of" "the" "next" "end" "step"
/* @sem Operation::@exile_result(Operation::Move{objects:One(Source), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}) */
exile_self ::= "exile" self_holder_text

/* @sem () */
moved ::= "it" | "that" "card" | "the" "exiled" "card"

/* @sem () */
moved_group ::= "them" | "those" "cards"

/* What an exile effect holds, it holds only while its source stays. */
/* @sem Instruction::[Instruction::Effect{result:@next, operation:$exile_objects}, Instruction::Effect{result:@next, operation:Operation::ReturnAfter{objects:Transition{result:@prior, phase:After}, duration:WhileOnBattlefield($self_ref)}}] */
clause_exile_until ::= exile_objects "until" self_ref "leaves" "the" "battlefield"

/* @sem Operation::Keyword{actor:One(PlayerRef::AbilityController), action:KeywordAction::TapOrUntap{object:$object_ref}} */
tap_or_untap ::= "tap" "or" "untap" object_ref

/* @sem Operation::CreateEmblem{actor:One(PlayerRef::AbilityController), abilities:[@scope($ability)]} */
create_emblem ::= "you" "get" "an" "emblem" "with" '"' ability '"'

/* The choice is from the hand just revealed, independently of any player
   supplied by the enclosing event. Both operations share the same operand. */
/* @sem Operation::Reveal{objects:Zone{scope:Players{zone:Hand, players:One($hand_player)}, kind:Card, filter:Any}} */
reveal_hand ::= hand_player "reveals" "their" "hand"

hand_player ::= player_ref

/* Every matching card of the revealed hand is discarded together. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($hand_player)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:DiscardObjects{objects:Zone{scope:Players{zone:Hand, players:One($hand_player)}, kind:Card, filter:$reveal_discard_filter}}}] */
clause_reveal_discard_all ::= hand_player "reveals" "their" "hand" "and" "discards" "all" reveal_discard_filter
reveal_discard_filter ::= search_filter_many | discard_chosen_color | discard_chosen_name | discard_chosen_type
/* @sem ObjectFilter::Chosen(Color) */
discard_chosen_color ::= "cards" "of" "that" "color"
/* @sem ObjectFilter::Chosen(CardName) */
discard_chosen_name ::= "cards" "with" "that" "name"
/* @sem @and($card_filter, ObjectFilter::Chosen(CreatureType)) */
discard_chosen_type ::= card_filter "cards" "of" "that" "type"

/* A producer whose receipt is later read as the shown hand. Keeping this
   phrase typed prevents an unrelated operation from introducing that receipt. */
hand_observation ::= reveal_hand | hand_observation_look | hand_observation_yours | hand_observation_subset

/* An immediately following choice can also query the unchanged whole hand.
   Keep this native representation separate from observation-receipt readings;
   a subset reveal cannot enter this production. */
full_hand_observation ::= reveal_hand | hand_observation_look | hand_observation_yours

/* @sem Operation::LookAt{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One($hand_look_owner)}, kind:Card, filter:Any}} */
hand_observation_look ::= "look" "at" hand_look_owner "hand"

/* @sem Operation::Reveal{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}} */
hand_observation_yours ::= "reveal" "your" "hand"

/* @sem Operation::RevealFromHand{actor:One($hand_player), cards:Any, count:$card_count} */
hand_observation_subset ::= hand_player "reveals" card_count "from" "their" "hand"

hand_look_owner ::= target_possessive | hand_look_that | zone_your | possessive_defending
/* @sem PlayerRef::@that_player_literal */
hand_look_that ::= "that" "player's"

/* An immediate choice from the revealed hand uses that observation. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($hand_player)}, kind:Card, filter:Any}}}, Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(2)), zone:Hand}, filter:@and($hand_pick_source, ObjectFilter::OwnedBy(One($hand_player)))}, count:AsManyAsCan(Constant(1))}}] */
instructions_hand_choice ::= hand_player "reveals" "their" "hand" ("." | "and") "you" "choose" hand_pick_source
/* @sem Instruction::[...$instructions_hand_choice, Effect{result:@next, operation:$hand_loss}] */
instructions_hand_pick ::= instructions_hand_choice ("." | "and") hand_loss
/* The actual exile supplies the arrival receipt for the later return. */
/* @sem Instruction::[...$instructions_hand_choice, Effect{result:@next, operation:$hand_exile}, Effect{result:@next, operation:ReturnAfter{objects:Transition{result:@prior, phase:After}, duration:WhileOnBattlefield($self_explicit_ref)}}] */
instructions_hand_pick_until ::= instructions_hand_choice "." hand_exile "until" self_explicit_ref "leaves" "the" "battlefield"

/* A subset observation and the controller's choice have independent counts.
   Every later choice stays inside the observed cards still owned in that hand. */
/* @sem Instruction::[Effect{result:@next, operation:RevealFromHand{actor:One($hand_player), cards:Any, count:$hand_subset_amount}}, Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(2)), zone:Hand}, filter:OwnedBy(One($hand_player))}, count:AsManyAsCan(Constant(1))}}] */
instructions_hand_subset_choice ::= hand_player "reveals" hand_subset_amount ("and" | ".") "you" "choose" "one" "of" ("them" | "those" "cards")

/* @sem Instruction::[...$instructions_hand_subset_choice, Effect{result:@next, operation:$hand_subset_loss}] */
instructions_hand_pick_subset ::= instructions_hand_subset_choice "." hand_subset_loss

hand_subset_amount ::= hand_subset_counted | hand_subset_equal
/* @sem $card_count */
hand_subset_counted ::= card_count "from" "their" "hand"
/* @sem $value */
hand_subset_equal ::= "a" "number" "of" "cards" "from" "their" "hand" "equal" "to" value

/* A choice of one can be read as its selected set or its sole result object.
   These remain distinct native readings, never comparison aliases. */
hand_subset_loss ::= hand_loss
/* @sem Operation::DiscardObjects{objects:One(Result{result:@marked, phase:After, index:0})} */
hand_subset_discard_single ::= "that" "player" "discards" "that" "card"

/* The complete hand-dependent continuation stays inside the chosen payment. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$instructions_hand_pick_subset}, otherwise:Program{}}] */
clause_paid_hand_subset ::= "you" "may" payment "." "if" "you" "do" "," instructions_hand_pick_subset

/* Only this actual exile supplies the conditional cast permission. */
hand_subset_exile ::= hand_exile | hand_exile_owner | hand_exile_owner_it

/* @sem Instruction::[...$instructions_hand_subset_choice, ...$hand_subset_permission_tail] */
instructions_hand_subset_permission ::= instructions_hand_subset_choice "." hand_subset_permission_tail

/* @sem Instruction::[Effect{result:@next, operation:$hand_subset_exile}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@last_result, phase:After}, filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:CastSpell, filter:Any}, terms:_{cost:Normal, spend_as:AnyType}})], duration:WhileControlled{player:AbilityController, object:$self_ref}, evaluation:LiveObjects}}]}, otherwise:Program{}}] */
hand_subset_permission_tail ::= hand_subset_exile "." "if" ("a" | "an") card_filter "card" "is" "exiled" "this" "way" "," "you" "may" "cast" "it" "for" "as" "long" "as" "you" "control" self_ref "," "and" "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "that" "spell"

/* A written X definition owns the entire remaining program, including later
   uses of X. The shared where binder retains its existing snapshot policy. */
/* @sem @where(Program::Program{instructions:[Effect{result:@next, operation:RevealFromHand{actor:One($hand_player), cards:Any, count:AnnouncedX}}, Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(2)), zone:Hand}, filter:OwnedBy(One($hand_player))}, count:AsManyAsCan(Constant(1))}}, ...$hand_subset_defined_tail]}, $value) */
program_hand_subset_defined ::= hand_player "reveals" "X" "cards" "from" "their" "hand" "," "where" "X" "is" value "." "you" "choose" "one" "of" ("them" | "those" "cards") "." hand_subset_defined_tail

hand_subset_defined_tail ::= hand_subset_permission_tail | hand_subset_lost_one | hand_subset_lost_more
/* @sem Instruction::[Effect{result:@next, operation:$hand_subset_loss}] */
hand_subset_lost_one ::= hand_subset_loss
/* @sem Instruction::[Effect{result:@next, operation:$hand_subset_loss}, ...$instructions] */
hand_subset_lost_more ::= hand_subset_loss "." instructions

/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One($hand_look_owner)}, kind:Card, filter:Any}}}, Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(2)), zone:Hand}, filter:@and($hand_pick_source, ObjectFilter::OwnedBy(One($hand_look_owner)))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:$hand_loss}] */
instructions_look_hand_pick ::= "look" "at" hand_look_owner "hand" ("." "you" | "and") "choose" hand_pick_source ("." | "and") hand_loss

/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One($hand_look_owner)}, kind:Card, filter:Any}}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(2)), zone:Hand}, filter:@and($hand_pick_source, ObjectFilter::OwnedBy(One($hand_look_owner)))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:$hand_loss}]}}] */
instructions_look_hand_pick_optional ::= "look" "at" hand_look_owner "hand" "." "you" "may" "choose" hand_pick_source "." hand_loss

hand_pick_source ::= hand_pick_source_plain | hand_pick_source_modified
/* @sem $hand_pick */
hand_pick_source_plain ::= hand_pick "from" "it"
/* @sem @and($hand_pick, $modifiers) */
hand_pick_source_modified ::= hand_pick "from" "it" modifiers

hand_pick ::= hand_pick_any | hand_pick_filter

/* @sem ObjectFilter::Any */
hand_pick_any ::= "a" "card"

/* @sem $card_filter */
hand_pick_filter ::= ("a" | "an") card_filter "card"

hand_loss ::= hand_exile | hand_exile_owner | hand_exile_owner_it | hand_discard | hand_subset_discard_single | hand_put_library_depth

/* @sem Operation::Move{objects:Selected(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
hand_exile ::= "exile" "that" "card"

/* @sem Operation::Move{objects:Selected(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
hand_exile_owner ::= "that" "player" "exiles" "that" "card"

/* @sem Operation::Move{objects:Selected(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
hand_exile_owner_it ::= "that" "player" "exiles" "it"

/* @sem Operation::DiscardObjects{objects:Selected(@marked)} */
hand_discard ::= "that" "player" "discards" "that" "card"

/* @sem $replacement_prevent_all_phrase */
replacement_prevent_all ::= replacement_prevent_all_phrase "."

shield_to ::= prevent_to_you | shield_to_self | prevent_to_attached | shield_to_group | shield_to_other_group | prevent_to_you_and

/* @sem DamageRecipients::Objects(ObjectFilter::SameObject($self_ref)) */
shield_to_self ::= self_ref

/* @sem DamageRecipients::Objects($filter_plural) */
shield_to_group ::= filter_plural

/* @sem Ability::Replacement{active:Battlefield, event:Damage(DamageEvent{source_kind:Permanent, sources:$prevent_by_permanents, recipients:$shield_to, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
replacement_prevent_to_by_permanents ::= "prevent" "all" prevent_damage "that" "would" "be" "dealt" "to" shield_to "by" prevent_by_permanents "."
/* @sem Ability::Replacement{active:Battlefield, event:Damage(DamageEvent{source_kind:Any, sources:$prevent_by_sources, recipients:$shield_to, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
replacement_prevent_to_by_sources ::= "prevent" "all" prevent_damage "that" "would" "be" "dealt" "to" shield_to "by" prevent_by_sources "."
/* @sem Ability::Replacement{active:Battlefield, event:Damage(DamageEvent{source_kind:Permanent, sources:$prevent_by_permanents, recipients:Any, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
replacement_prevent_by_permanents ::= "prevent" "all" prevent_damage "that" "would" "be" "dealt" "by" prevent_by_permanents "."
/* @sem Ability::Replacement{active:Battlefield, event:Damage(DamageEvent{source_kind:Permanent, sources:SameObject($self_ref), recipients:$shield_to, kind:Any, grouping:SourceRecipient, subject:Recipient}), body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
replacement_prevent_self_deals ::= "prevent" "all" "damage" "that" self_ref "would" "deal" "to" shield_to "."

/* @sem Ability::Replacement{active:Battlefield, event:Either([Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject($object_ref)), kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), Damage(_{source_kind:Permanent, sources:SameObject($object_ref), recipients:Any, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient})]), body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
replacement_prevent_to_and_by ::= "prevent" "all" prevent_damage "that" "would" "be" "dealt" "to" "and" "dealt" "by" object_ref "."

prevent_by_permanents ::= prevent_by_group | prevent_by_object
/* @sem ObjectFilter::$filter_plural */
prevent_by_group ::= filter_plural
/* @sem ObjectFilter::SameObject($object_ref) */
prevent_by_object ::= object_ref
prevent_by_sources ::= prevent_by_kind_sources | prevent_by_your_sources | prevent_by_chosen_color | prevent_by_chosen_name
/* @sem ObjectFilter::$adjective */
prevent_by_kind_sources ::= adjective "sources"
/* @sem ObjectFilter::ControlledBy(One(AbilityController)) */
prevent_by_your_sources ::= "sources" "you" "control"
/* @sem ObjectFilter::Chosen(Color) */
prevent_by_chosen_color ::= "sources" "of" "the" "last"? "chosen" "color"
/* @sem ObjectFilter::Chosen(CardName) */
prevent_by_chosen_name ::= "sources" "with" "the" "chosen" "name"

/* A hand discarded, then a new one: each player acts in turn before anyone draws. */
/* @sem Instruction::[Instruction::ForEachPlayer{players:All, binding:0, in_chosen_direction:false, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::Discard{players:One(Bound(0)), amount:Expr::CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), random:false}}]}}, Instruction::Effect{result:@next, operation:Operation::Draw{players:All, amount:$card_count}}] */
instructions_wheel ::= "each" "player" "discards" "their" "hand" "," "then" "draws" card_count

/* This broader wording shares a fixed or announced count. Per-player
   "that many" requires separate result bookkeeping, not a shared draw. */
/* @sem Instruction::[Instruction::ForEachPlayer{players:$hand_plural_players, binding:0, in_chosen_direction:false, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::Discard{players:One(Bound(0)), amount:Expr::CountObjects(Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), random:false}}]}}, Instruction::Effect{result:@next, operation:Operation::Draw{players:$hand_plural_players, amount:$hand_shared_count}}] */
instructions_hand_wheel ::= hand_plural_players "discards" hand_words ("," "then" | "and") "draws" hand_shared_count

hand_shared_count ::= card_count_one | card_count_many | card_count_additional

/* A created trigger governs the rest of its sentence. The creating effect owns
   targets in the event; the future trigger owns targets and references in its body. */
/* @sem Instruction::[Effect{result:@next, operation:Operation::@scope(Operation::CreateTrigger{event:$event_clause, duration:$duration, announcement:@announcement, body:Program{instructions:$conjoined}})}] */
temporary_trigger_prefix ::= duration "," event_clause "," conjoined

/* @sem Instruction::[Effect{result:@next, operation:Operation::@scope(Operation::CreateTrigger{event:$event_clause, duration:$duration, announcement:@announcement, body:Program{instructions:$conjoined}, intervening_if:$condition})}] */
temporary_trigger_prefix_if ::= duration "," event_clause "," "if" condition "," conjoined

/* @sem Instruction::[Effect{result:@next, operation:Operation::@scope(Operation::CreateTrigger{event:$event_clause, duration:EndOfTurn, announcement:@announcement, body:Program{instructions:$conjoined}})}] */
temporary_trigger_this_turn ::= event_clause "this" "turn" "," conjoined

/* @sem Instruction::[Effect{result:@next, operation:Operation::@scope(Operation::CreateTrigger{event:$event_clause, duration:EndOfTurn, announcement:@announcement, body:Program{instructions:$conjoined}, intervening_if:$condition})}] */
temporary_trigger_this_turn_if ::= event_clause "this" "turn" "," "if" condition "," conjoined

/* "It" in the next sentence is still the created trigger's event object. */
/* @sem Instruction::[Effect{result:@next, operation:Operation::@scope(Operation::CreateTrigger{event:$event_clause, duration:EndOfTurn, announcement:@announcement, body:Program{instructions:[...$conjoined, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($it_ref)), changes:$changes, duration:$duration, evaluation:Snapshot}}]}})}] */
temporary_trigger_this_turn_it_changes ::= event_clause "this" "turn" "," conjoined "." it_ref changes duration

/* A conditional source-spell property applies on the stack. Its damage clause
   chooses one prevention flag at resolution; it does not deal damage twice. */
line_conditional_damage_protection ::= conditional_damage_protection | conditional_damage_protection_exile

/* @sem Ability::[Scoped{zones:[Stack], condition:$conditional_spell_guard, ability:Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Stack), kind:Spell, filter:SameObject(Source)}), changes:[Rule(Prohibit(Counter))]}}, Spell{announcement:@announcement, body:Program{instructions:[If{condition:$conditional_spell_guard, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any})), amount:$value, preventable:false}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Targets(0), amount:$value, preventable:true}}]}}]}}] */
conditional_damage_protection ::= self_explicit_ref "deals" value "damage" "to" "any" "target" "." NEWLINE "if" conditional_spell_guard "," "this" "spell" "can't" "be" "countered" "and" "the" "damage" "can't" "be" "prevented" "."

/* Both branches report their damage through a joined result, so a following
   replacement observes exactly the branch that actually performed damage. */
/* @sem Ability::[Scoped{zones:[Stack], condition:$conditional_spell_guard, ability:Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Stack), kind:Spell, filter:SameObject(Source)}), changes:[Rule(Prohibit(Counter))]}}, Spell{announcement:@announcement, body:Program{instructions:[If{condition:$conditional_spell_guard, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any})), amount:$value, preventable:false}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Targets(0), amount:$value, preventable:true}}]}}, Effect{result:@mark, operation:JoinResults{results:[@back(3), @back(2)]}}, Effect{result:@next, operation:CreateReplacement{event:ZoneChange{objects:@and($filter_phrase, ObjectFilter::DamagedBy(@marked)), from:Battlefield, to:Graveyard}, limit:UntilExpired, duration:EndOfTurn, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}}}]}}] */
conditional_damage_protection_exile ::= self_explicit_ref "deals" value "damage" "to" "any" "target" "." "if" "a" filter_phrase "dealt" "damage" "this" "way" "would" "die" "this" "turn" "," "exile" "it" "instead" "." NEWLINE "if" conditional_spell_guard "," "this" "spell" "can't" "be" "countered" "and" "the" "damage" "can't" "be" "prevented" "."

/* These guards contain no announcement or event-dependent target reference.
   The same condition is read independently on the stack and at resolution. */
conditional_spell_guard ::= condition_hand_none | condition_hand_size | conditional_spell_x_bound

/* @sem Condition::Compare{left:ObjectProperty{object:Source, property:SpellX, information:CurrentOrLastKnown}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}} */
conditional_spell_x_bound ::= "X" "is" number "or" "more"

/* An exile choice records the actual result of each branch, not the slot or
   address a spliced child program happened to allocate. The pinned lowering
   retains both the choice join and its alias; each joins the same two moves. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[Program{instructions:[Effect{result:@next, operation:Move{objects:One($self_explicit_ref), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}, Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:$filter_phrase}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}]}, Effect{result:@mark, operation:JoinResults{results:[@back(3), @back(2)]}}, Effect{result:@next, operation:JoinResults{results:[@back(4), @back(3)]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:$exile_choice_return_event, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}}] */
clause_exile_holder_or_target_return ::= "exile" self_explicit_ref "or" "up" "to" ("one" | "1") "target" filter_phrase "." "return" "that" "card" "to" "the" "battlefield" "under" "its" "owner's" "control" exile_choice_return_event

/* The next matching occurrence, including an upcoming upkeep this turn. */
/* @sem EventSpec::Turn{point:UpkeepBegins, players:One(AbilityController)} */
exile_choice_return_event ::= "at" "the" "beginning" "of" "your" "next" "upkeep"

/* One sentence describes one replacement identity. The tapping player chooses
   among the outputs applicable to the proposed source's current types. */
/* @sem Ability::[Replacement{active:Battlefield, event:ProduceMana{sources:Any}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:ReplaceManaChoices($mana_type_items)}}]}}] */
line_mana_type_replacements ::= "if" "tapped" "for" "mana" "," mana_type_items "instead" "of" "any" "other" "type" "."

mana_type_items ::= mana_type_pair | mana_type_list
/* @sem ManaReplacementOption::[$mana_type_item, $mana_type_item_2] */
mana_type_pair ::= mana_type_item "and" mana_type_item
/* @sem ManaReplacementOption::[$mana_type_item, ...$mana_type_tail] */
mana_type_list ::= mana_type_item "," mana_type_tail
mana_type_tail ::= mana_type_last | mana_type_list
/* @sem ManaReplacementOption::[$mana_type_item] */
mana_type_last ::= "and" mana_type_item

/* @sem ManaReplacementOption::ManaReplacementOption{sources:$mana_plural_sources, color:$mana_color} */
mana_type_item ::= mana_plural_sources "produce" mana_color

/* A single fixed output retains its ordinary replacement form. */
/* @sem Ability::Replacement{active:Battlefield, event:ProduceMana{sources:$mana_plural_sources}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:ReplaceMana(Amount{color:$mana_color, amount:Constant(1)})}}]}} */
replacement_mana_type_single ::= "if" "tapped" "for" "mana" "," mana_plural_sources "produce" mana_color "instead" "of" "any" "other" "type" "."

/* Existing lower-case vocabulary makes these capitalized land names after
   a comma explicit spelling tokens. The marker changes no filter meaning.
   Plains is already plural and omitted by the generated plural catalogue. */
mana_plural_sources ::= filter_plural | st_plains | mana_marked_land | mana_marked_land_modified | mana_unmarked_plains_modified
/* @sem ObjectFilter::$mana_list_land */
mana_marked_land ::= "↑" mana_list_land
/* @sem ObjectFilter::@and($mana_list_land, $modifiers) */
mana_marked_land_modified ::= "↑" mana_list_land modifiers
/* @sem ObjectFilter::@and(ObjectFilter::Subtype(Plains), $modifiers) */
mana_unmarked_plains_modified ::= "Plains" modifiers

mana_list_land ::= mana_list_plains | mana_list_swamps | mana_list_forests
/* @sem ObjectFilter::Subtype(Plains) */
mana_list_plains ::= "plains"
/* @sem ObjectFilter::Subtype(Swamp) */
mana_list_swamps ::= "swamps"
/* @sem ObjectFilter::Subtype(Forest) */
mana_list_forests ::= "forests"

/* Additional counters add to other entry instructions, just like the existing
   unqualified entry count. This wording does not create a replacement amount. */
/* @sem Expr::$counter_amount */
entry_counter_amount ::= counter_amount "additional"?

/* A creature-cast trigger changes the actual cast spell's entry instructions.
   It is distinct from a SourceEntering replacement on an ability holder. */
/* @sem Ability::Triggered{event:$entry_counter_cast_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$cast_spell_entry_counters}]}} */
triggered_cast_entry_counters ::= entry_counter_cast_event "," cast_spell_entry_counters "."

/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:CardType(Creature)} */
entry_counter_cast_event ::= ("when" | "whenever") "you" "cast" ("a" | "an") "creature" "spell"

/* @sem Operation::ChangeSpell{subject:One(EventSubject), changes:[EntersWithCounters{kind:$counter_kind, amount:$entry_counter_amount}]} */
cast_spell_entry_counters ::= ("that" "creature" | "it") "enters" "with" entry_counter_amount counter_kind ("counter" | "counters") "on" "it"

/* A boon owns its creature-cast event and changes that event's spell. Its
   closing quoted period also closes the granting instruction. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:$entry_counter_cast_event, duration:Indefinite, announcement:Announcement{}, body:Program{instructions:[Effect{result:@next, operation:$cast_spell_entry_counters}]}, once:true}}] */
clause_entry_counter_boon ::= "you" "get" "a" "one-time" "boon" "with" '"' entry_counter_cast_event "," cast_spell_entry_counters "." '"'

/* The leading time owns one complete sentence, including every coordinated action. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, body:Program{instructions:$conjoined}}}]} */
program_sentence_delayed_combat ::= "at" "end" "of" "combat" "," conjoined "."

/* Next occurrence of this controller's upkeep, not the next turn globally. */
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:UpkeepBegins, players:One(AbilityController)}, start:Immediately, body:Program{instructions:$relative_upkeep_action}}}] */
clause_relative_upkeep_after ::= relative_upkeep_action "at" "the" "beginning" "of" "your" "next" "upkeep"
relative_upkeep_action ::= may_body | clause_may

/* The named flip condition remains with its delayed performing action. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@mark, operation:FlipCoin{player:AbilityController, protocol:@coin_protocol}}, If{condition:CoinFlip{result:@marked, outcome:$delayed_coin_outcome}, then:Program{instructions:$conjoined}, otherwise:Program{}}]}}}]}*/
program_sentence_delayed_coin ::= "flip" "a" "coin" "at" "end" "of" "combat" "." "if" "you" delayed_coin_outcome "the" "flip" "," conjoined "."
/* @sem CoinOutcome::Lost */
delayed_coin_lost ::= "lose"
/* @sem CoinOutcome::Won */
delayed_coin_won ::= "win"
delayed_coin_outcome ::= delayed_coin_lost | delayed_coin_won

/* Both arms belong to the same resolution-time payment decision. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$conjoined}, otherwise:Program{instructions:$conjoined_2}}] */
instructions_payment_otherwise ::= "you" "may" payment "." "if" "you" "do" "," conjoined "." "otherwise" "," conjoined

/* A single announced target can produce multiple cards after exile. The whole
   actual paid component is followed, only while those cards remain exiled. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost::Cost{parts:[Move{selections:[_{objects:One($target_object)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, zone:Exile}, destination:$battlefield_control, qualifiers:[]}}]}, otherwise:Program{}}] */
clause_optional_target_blink ::= "you" "may" "exile" target_object "," "then" "return" "that" "card" "to" "the" "battlefield" battlefield_control

/* A pure two-leaf combat shield names the recipient leaf before the source leaf. */
/* @sem Operation::CreateReplacement{event:Either([Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject($prevent_shield_ref)), kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), Damage(_{source_kind:Permanent, sources:SameObject($prevent_shield_ref), recipients:Any, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient})]), limit:UntilExpired, duration:$duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevent_combat_to_by ::= "prevent" "all" prevent_damage "that" "would" "be" "dealt" "to" "and" "dealt" "by" prevent_shield_ref duration

/* Plural card wording follows every actual card from this exact exile Move. */
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:$exile_objects}, Instruction::Effect{result:@next, operation:Operation::Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:$battlefield_control, qualifiers:[]}}] */
clause_exile_return_group ::= exile_objects return_join "return" moved_group "to" "the" "battlefield" battlefield_control

/* Plural card wording follows every actual card from this exact exile Move. */
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:$exile_objects}, Instruction::Effect{result:@next, operation:Operation::CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:$battlefield_control, qualifiers:[]}}]}}}] */
clause_exile_return_delayed_group ::= exile_objects return_join "return" moved_group "to" "the" "battlefield" battlefield_control "at" "the" "beginning" "of" "the" "next" "end" "step"

/* The chosen source is a resolving choice, never a target. Callback owns the
   actual ModifyEvent prevention result, not the original proposed damage. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:DamageSources(Any), count:Exactly(Constant(1))}}, Effect{result:@next, operation:CreateReplacement{event:Damage{source_kind:Any, sources:SameObject(Result{result:@prior, phase:Before, index:0}), recipients:Players(One(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Recipient}, limit:$prevention_choice_window, duration:EndOfTurn, body:Program{instructions:[Effect{result:@mark, operation:ModifyEvent{change:PreventDamage}}, $prevention_receipt_callback]}}}] */
instructions_prevention_receipt_callback ::= prevention_choice_window "." prevention_receipt_callback


/* The next damage from each chosen source is prevented. The source is a
   resolving choice of any kind or color of source, never a target. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:DamageSources($next_chosen_sources), count:Exactly($counter_amount)}}, Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Any, sources:SameObject(Result{result:@prior, phase:Before, index:0}), recipients:$next_chosen_to, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:NextOccurrence, duration:$this_duration, body:$prevented_body}}] */
instructions_next_chosen_prevent ::= "the" "next" "time" counter_amount next_chosen_sources "would" "deal" "damage" next_chosen_to this_duration "," prevented_body
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:DamageSources($next_chosen_sources), count:Exactly($counter_amount)}}, Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Any, sources:SameObject(Result{result:@prior, phase:Before, index:0}), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:NextOccurrence, duration:$this_duration, body:$prevented_body}}] */
instructions_next_chosen_prevent_any ::= "the" "next" "time" counter_amount next_chosen_sources "would" "deal" "damage" this_duration "," prevented_body
next_chosen_sources ::= next_chosen_any | next_chosen_kind | next_chosen_color
/* @sem ObjectFilter::Any */
next_chosen_any ::= "source" "of" "your" "choice"
/* @sem ObjectFilter::$adjective */
next_chosen_kind ::= adjective "source" "of" "your" "choice"
/* @sem ObjectFilter::Chosen(Color) */
next_chosen_color ::= "source" "of" "your" "choice" "of" "the" "chosen" "color"
next_chosen_to ::= next_chosen_to_you | next_chosen_to_object | next_chosen_to_any_target
/* @sem DamageRecipients::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Expr::Constant(1)), filter:Any}), index:0} */
next_chosen_to_any_target ::= "to" "any" "target"
/* The prevention, and life equal to what it prevented. */
prevented_body ::= prevented_body_plain | prevented_body_life
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]} */
prevented_body_plain ::= "prevent" "that" "damage"
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:Performed(@prior)}}]} */
prevented_body_life ::= "prevent" "that" "damage" "." "you" "gain" "life" "equal" "to" "the" "damage" "prevented" "this" "way"
/* @sem DamageRecipients::Players(One(AbilityController)) */
next_chosen_to_you ::= "to" "you"
/* @sem DamageRecipients::Objects(SameObject($object_ref)) */
next_chosen_to_object ::= "to" object_ref

prevention_choice_window ::= prevention_choice_next | prevention_choice_all
/* @sem ReplacementLimit::NextOccurrence */
prevention_choice_next ::= "the" "next" "time" "a" "source" "of" "your" "choice" "would" "deal" "damage" "to" "you" "this" "turn" "," "prevent" "that" "damage"
/* @sem ReplacementLimit::UntilExpired */
prevention_choice_all ::= "prevent" "all" "damage" "that" "would" "be" "dealt" "to" "you" "this" "turn" "by" "a" "source" "of" "your" "choice"

prevention_receipt_callback ::= prevention_damage_draw_callback | prevention_filtered_life_callback
/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$prevention_damage_draw_body})} */
prevention_damage_draw_callback ::= "when" "damage" "is" "prevented" "this" "way" "," prevention_damage_draw_body
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref, recipients:Players(One(ControllerOf(Damage(Source)))), amount:Performed(@marked), preventable:true}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Performed(@marked)}}]} */
prevention_damage_draw_body ::= self_ref "deals" "that" "much" "damage" "to" "that" "source's" "controller" "and" "you" "draw" "that" "many" "cards"
/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, condition:AllOf(@unordered([Compare{left:CountObjects(Matching{objects:Damage(Source), filter:$adjectives}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, Compare{left:Performed(@marked), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}])), announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:Performed(@marked)}}]}})} */
prevention_filtered_life_callback ::= "whenever" "damage" "from" ("a" | "an") adjectives "source" "is" "prevented" "this" "way" "this" "turn" "," "you" "gain" "that" "much" "life"

/* The preposed named return repeats the same printed source spelling;
   the postposed pronoun refers to the single explicit paid self input. */
instructions_optional_self_return_keyword ::= optional_self_return_post | optional_self_return_named

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Move{selections:[_{objects:One($self_explicit_ref)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:UpkeepBegins, players:One(AbilityController)}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, zone:Exile}, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Transition{result:@prior, phase:After}), changes:[GrantKeyword($keyword_value)], duration:Indefinite, evaluation:Snapshot}}]}}}]}, otherwise:Program{}}] */
optional_self_return_post ::= "you" "may" "exile" self_explicit_ref "." "if" "you" "do" "," optional_self_return_keyword_postposed keyword_value

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Move{selections:[_{objects:One($self_ref_named)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:UpkeepBegins, players:One(AbilityController)}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, zone:Exile}, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Transition{result:@prior, phase:After}), changes:[GrantKeyword($keyword_value)], duration:Indefinite, evaluation:Snapshot}}]}}}]}, otherwise:Program{}}] */
optional_self_return_named ::= "you" "may" "exile" self_ref_named "." "if" "you" "do" "," optional_self_return_keyword_preposed keyword_value

/* @sem () */
optional_self_return_keyword_postposed ::= "return" "it" "to" "the" "battlefield" "under" "its" "owner's" "control" "at" "the" "beginning" "of" "your" "next" "upkeep" "." "it" "gains"
/* @sem () */
optional_self_return_keyword_preposed ::= "at" "the" "beginning" "of" "your" "next" "upkeep" "," "return" self_named "to" "the" "battlefield" "under" "its" "owner's" "control" "and" "it" "gains"

/* A future mandatory mana payment and its written failure stay together.
   The condition names this exact local payment, not a preceding effect. */
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:UpkeepBegins, players:One(AbilityController)}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Mana($delayed_fixed_mana)]}, optional:false}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::LoseGame}}]}, otherwise:Program{}}]}}}] */
instructions_delayed_payment_failure ::= "at" "the" "beginning" "of" "your" "next" "upkeep" "," "pay" delayed_fixed_mana "." "if" "you" "don't" "," "you" "lose" "the" "game"

delayed_fixed_mana ::= delayed_fixed_mana_one | delayed_fixed_mana_more
/* @sem Vec<ManaSymbol>::[$delayed_fixed_mana_symbol] */
delayed_fixed_mana_one ::= delayed_fixed_mana_symbol
/* @sem Vec<ManaSymbol>::[$delayed_fixed_mana_symbol, ...$delayed_fixed_mana] */
delayed_fixed_mana_more ::= delayed_fixed_mana_symbol delayed_fixed_mana

delayed_fixed_mana_symbol ::= mana_colorless | mana_generic | mana_white | mana_blue | mana_black | mana_red | mana_green | mana_snow

/* The announcement divides the written total among its targets. Each target
   retains its own assigned shield; this is not one shared TotalDamage pool. */
/* @sem Operation::CreateReplacement{event:Damage(DamageEvent{source_kind:Any, sources:Any, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:UpTo($number), filter:Any, distribute:$number})), kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:DamageToEach(Expr::DistributedShare(@share)), duration:$prevent_duration, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevent_distributed_targets ::= "prevent" "the" "next" number "damage" "that" "would" "be" "dealt" prevent_duration "to" "any" "number" "of" "targets" "," "divided" "as" "you" "choose"

/* @sem Ability::Replacement{active:Battlefield, event:Counters(_{kind:PowerToughness(-1, -1), objects:$counter_replacement_population}), body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([Constant(2), EventAmount]))}}]}} */
replacement_counters_double_minus ::= "if" "one" "or" "more" "-" "1" "/" "-" "1" "counters" "would" "be" "put" "on" counter_replacement_population "," "twice" "that" "many" "-" "1" "/" "-" "1" "counters" "are" "put" "on" "it" "instead" "."

/* Close the pronoun over its producer. A chosen opponent and a targeted hand
   owner cannot share a free-standing hard-coded Chosen condition. The body
   ends with this sentence, preserving the ordinary conditional scope. */
/* @sem Instruction::[...$instructions_hand_pick_subset, If{condition:$condition_that_player_more_cards, then:Program{instructions:$conjoined}, otherwise:Program{}}] */
instructions_subset_hand_compare ::= instructions_hand_pick_subset "." "then"? "if" condition_that_player_more_cards "," conjoined

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Player, terms:_{count:Exactly(Constant(1)), options:[Players(OpponentsOf(AbilityController))]}} */
choose_opponent ::= "choose" "an" "opponent"

/* @sem Instruction::[Effect{result:@next, operation:$choose_opponent}, If{condition:$condition_chosen_player_more_cards, then:Program{instructions:[Effect{result:@next, operation:$chosen_hand_comparison_draw}]}, otherwise:Program{}}] */
instructions_chosen_hand_compare ::= choose_opponent "." "if" condition_chosen_player_more_cards "," chosen_hand_comparison_draw

/* These bodies name only the controller and the explicitly chosen opponent;
   other player pronouns require their own lexical introduction contract. */
chosen_hand_comparison_draw ::= chosen_hand_draw_controller | chosen_hand_difference_draw
/* @sem @apply(PlayerSet::One(AbilityController), $draw_base) */
chosen_hand_draw_controller ::= draw_base
/* @sem Operation::Draw{players:One(AbilityController), amount:Subtract([CountObjects(Zone{scope:Players{zone:Hand, players:One(Chosen)}, kind:Card, filter:Any}), CountObjects(Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any})])} */
chosen_hand_difference_draw ::= "draw" "cards" "equal" "to" "the" "difference"

/* Counterparts are local to this matched damage event, independently of the
   source holding the replacement ability. */
/* @sem Ability::Replacement{active:Battlefield, event:Damage(_{source_kind:Permanent, sources:$filter_phrase_2, recipients:Objects(@and($filter_phrase, ObjectFilter::Not(ObjectFilter::SameObject(Damage(Source))), ObjectFilter::Shares{property:Colors, with:Damage(Source)})), kind:Any, grouping:SourceRecipient, subject:Recipient}), body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
replacement_matching_color_counterpart ::= "prevent" "all" "damage" "that" "would" "be" "dealt" "to" ("a" | "an") filter_phrase "by" "another" filter_phrase "if" "they" "share" "a" "color" "."

/* @sem Ability::Replacement{active:Battlefield, event:Damage(_{source_kind:Any, sources:ControlledBy(Matching{binding:0, condition:ValueChosenIs(Bound(0))}), recipients:ObjectsAndPlayers{objects:ControlledBy(Intersection([Matching{binding:0, condition:ValueChosenIs(Bound(0))}, OthersThan(ControllerOf(Damage(Source)))])), players:Intersection([Matching{binding:0, condition:ValueChosenIs(Bound(0))}, OthersThan(ControllerOf(Damage(Source)))])}, kind:Any, grouping:SourceRecipient, subject:Recipient}), body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([$damage_counterpart_multiplier, EventAmount]))}}]}} */
replacement_chosen_player_counterpart ::= "if" "a" "source" "controlled" "by" "one" "of" "the" "chosen" "players" "would" "deal" "damage" "to" "the" "other" "chosen" "player" "or" "a" "permanent" "that" "player" "controls" "," "that" "source" "deals" damage_counterpart_multiplier "that" "damage" "to" "that" "player" "or" "permanent" "instead" "."

damage_counterpart_multiplier ::= damage_counterpart_double | damage_counterpart_triple
/* @sem Expr::Constant(2) */
damage_counterpart_double ::= "double"
/* @sem Expr::Constant(3) */
damage_counterpart_triple ::= "triple"

/* A persistent chosen pair belongs to the entering holder. */
/* @sem Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject(Source)}, body:_{instructions:[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Player, terms:_{options:[Players(All)], count:Exactly(Constant(2))}}}]}} */
replacement_choose_two_players_entering ::= "as" self_holder_text "enters" "," "choose" "two" "players" "."

/* This resolution-time choice belongs to its enclosing program, including a
   delayed trigger body. It does not select graveyard cards when created. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}, count:AsManyAsCan($number)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
exile_from_own_graveyard ::= "exile" number "cards" "from" "your" "graveyard"

/* The postposed cleanup deadline owns the action, retaining its original
   holder and controller references in the delayed body. */
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CleanupStepBegins, players:All}, start:Immediately, body:Program{instructions:$may_body}}}] */
clause_delayed_cleanup_after ::= may_body "at" "the" "beginning" "of" "the" "next" "cleanup" "step"

/* An escaped permanent enters with counters: a replacement on its own escaped entry. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:AllOf([SameObject($object_ref), State(Escaped)])}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$counter_amount})}}]}}) */
entering_escaped_counters ::= object_ref "escapes" "with" counter_amount counter_kind ("counter" | "counters") "on" "it" "."

/* A permanent's controller chooses one of two printed words as it enters (a
   Siege's Khans or Dragons, a clan, a faction). Each bulleted ability applies
   only while its word is the chosen one. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:_{instructions:[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Word, terms:_{count:Exactly(Constant(1)), options:[Text($entry_word), Text($entry_word_2)]}}}]}}) */
entering_choose_word ::= "as" object_ref "enters" "," "choose" entry_word "or" entry_word "."
/* @sem Ability::Conditional{condition:ChosenWord($entry_word), then:[@scope($ability)]} */
chosen_word_ability ::= "•" entry_word "—" ability
entry_word ::= entry_word_abzan | entry_word_believe | entry_word_brotherhood | entry_word_doubt | entry_word_dragons
    | entry_word_enclave | entry_word_jeskai | entry_word_khans | entry_word_legion | entry_word_mardu
    | entry_word_mirran | entry_word_ncr | entry_word_phyrexian | entry_word_sultai | entry_word_temur
/* @sem String::'Abzan' */
entry_word_abzan ::= "Abzan"
/* @sem String::'Believe' */
entry_word_believe ::= "Believe"
/* @sem String::'Brotherhood' */
entry_word_brotherhood ::= "Brotherhood"
/* @sem String::'Doubt' */
entry_word_doubt ::= "Doubt"
/* @sem String::'Dragons' */
entry_word_dragons ::= "Dragons"
/* @sem String::'Enclave' */
entry_word_enclave ::= "Enclave"
/* @sem String::'Jeskai' */
entry_word_jeskai ::= "Jeskai"
/* @sem String::'Khans' */
entry_word_khans ::= "Khans"
/* @sem String::'Legion' */
entry_word_legion ::= "Legion"
/* @sem String::'Mardu' */
entry_word_mardu ::= "Mardu"
/* @sem String::'Mirran' */
entry_word_mirran ::= "Mirran"
/* @sem String::'NCR' */
entry_word_ncr ::= "NCR"
/* @sem String::'Phyrexian' */
entry_word_phyrexian ::= "Phyrexian"
/* @sem String::'Sultai' */
entry_word_sultai ::= "Sultai"
/* @sem String::'Temur' */
entry_word_temur ::= "Temur"

/* Entering tapped and the color chosen as it enters are one entry replacement. */
entering_tapped_choose_color ::= entering_tapped_any_color | entering_tapped_other_color
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}, Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[Term{family:ChoosableColor, form:AnyColor}]}}}]}}) */
entering_tapped_any_color ::= object_ref "enters" "tapped" "." "as" "it" "enters" "," "choose" "a" "color" "."
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}, Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Color, terms:_{count:Exactly(Constant(1)), options:[$entering_color_other]}}}]}}) */
entering_tapped_other_color ::= object_ref "enters" "tapped" "." "as" "it" "enters" "," "choose" "a" "color" entering_color_other "."
entering_color_other ::= ecc_other_white | ecc_other_blue | ecc_other_black | ecc_other_red | ecc_other_green
/* @sem Operand::Term{family:ChoosableColor, form:Other, operands:[Vocabulary{family:Color, form:White}]} */
ecc_other_white ::= "other" "than" "white"
/* @sem Operand::Term{family:ChoosableColor, form:Other, operands:[Vocabulary{family:Color, form:Blue}]} */
ecc_other_blue ::= "other" "than" "blue"
/* @sem Operand::Term{family:ChoosableColor, form:Other, operands:[Vocabulary{family:Color, form:Black}]} */
ecc_other_black ::= "other" "than" "black"
/* @sem Operand::Term{family:ChoosableColor, form:Other, operands:[Vocabulary{family:Color, form:Red}]} */
ecc_other_red ::= "other" "than" "red"
/* @sem Operand::Term{family:ChoosableColor, form:Other, operands:[Vocabulary{family:Color, form:Green}]} */
ecc_other_green ::= "other" "than" "green"

/* Instructions performed as the permanent enters. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:$program}) */
entering_program ::= "as" object_ref "enters" "," program "."

/* Entering tapped unless a condition holds. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:_{instructions:[If{condition:Not($condition), then:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}]}, otherwise:_{}}]}}) */
entering_tapped_unless ::= object_ref "enters" "tapped" "unless" condition "."

/* Entering tapped unless a condition holds or you control a kind of permanent. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:_{instructions:[If{condition:Not(AnyOf([$condition, Controls{player:AbilityController, filter:$filter_phrase, minimum:1}])), then:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}]}, otherwise:_{}}]}}) */
entering_tapped_unless_or_control ::= object_ref "enters" "tapped" "unless" condition "or" "a" filter_phrase "."

/* Entering tapped with counters. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}, Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$value})}}]}}) */
entering_tapped_with_counters ::= object_ref "enters" "tapped" "with" value counter_kind "counters" "on" "it" "."

/* Revealing a card from hand, or entering tapped. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:_{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[Reveal{count:Exactly($counter_amount), filter:$filter_phrase}]}, optional:true}}, If{condition:Not(PaymentChosen(0)), then:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}]}, otherwise:_{}}]}}) */
entering_reveal_or_tapped ::= "as" object_ref "enters" "," "you" "may" "reveal" counter_amount filter_phrase "card" "from" "your" "hand" "." "if" "you" "don't" "," "this" "land" "enters" "tapped" "."

/* Exiled instead of going to a graveyard from anywhere. */
/* @sem Ability::Replacement{active:Everywhere, event:ZoneChange{objects:SameObject($object_ref), to:Graveyard}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}} */
graveyard_from_anywhere_exile ::= "if" object_ref "would" "be" "put" "into" "a" "graveyard" "from" "anywhere" "," "exile" "it" "instead" "."

/* "If a spell or ability an opponent controls causes you to discard this card, put it
   onto the battlefield instead of putting it into your graveyard." */
/* @sem Ability::Replacement{active:Everywhere, event:Discard{players:One(AbilityController), causes:ControlledBy(OpponentsOf(AbilityController)), card:SameObject(Source)}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(OwnersBattlefield)}}]}} */
discard_onto_battlefield ::= "if" opponent_spell_or_ability "causes" "you" "to" "discard" "this" "card" "," "put" "it" "onto" "the" "battlefield" "instead" "of" "putting" "it" "into" "your" "graveyard" "."
/* @sem Ability::Replacement{active:Everywhere, event:Discard{players:One(AbilityController), causes:ControlledBy(OpponentsOf(AbilityController)), card:SameObject(Source)}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(OwnersBattlefield)}}, Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$value})}}]}} */
discard_onto_battlefield_counters ::= "if" opponent_spell_or_ability "causes" "you" "to" "discard" "this" "card" "," "put" "it" "onto" "the" "battlefield" "with" value counter_kind "counters" "on" "it" "instead" "of" "putting" "it" "into" "your" "graveyard" "."
/* @sem () */
opponent_spell_or_ability ::= "a" "spell" "or" "ability" "an" "opponent" "controls"

/* Replacements taken over from seeded rules, in their original Oracle words. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:_{instructions:[If{condition:ItsNeitherDayNorNight, then:_{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::BecomeDay}}]}, otherwise:_{}}]}}) */
entering_neither_day_nor_night ::= "if" "it's" "neither" "day" "nor" "night" "," "it" "becomes" "day" "as" object_ref "enters" "."

/* @sem Ability::Replacement{active:Battlefield, event:Player{event:GainLife, players:One(AbilityController)}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:Add([EventAmount, $value])}}]}} */
replacement_gain_life_plus ::= "if" "you" "would" "gain" "life" "," "you" "gain" "that" "much" "life" "plus" value "instead" "."

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_you_gain_event, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:$replacement_you_gain_twice}]}} */
replacement_gain_life_twice ::= "if" replacement_you_gain_event "," replacement_you_gain_twice "instead" "."

/* A land that costs something to enter: unpaid, it goes to its owner's graveyard instead. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:_{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$cost}}, If{condition:PaymentChosen(0), then:_{}, otherwise:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(OwnersGraveyard)}}]}}]}}) */
replacement_enter_cost_or_graveyard ::= "if" object_ref "would" "enter" "," cost "instead" "." "if" "you" "do" "," "put" "this" "land" "onto" "the" "battlefield" "." "if" "you" "don't" "," "put" "it" "into" "its" "owner's" "graveyard" "."

/* The next draw this turn is replaced by the written action. */
/* @sem Operation::CreateReplacement{event:Player{event:Draw, players:One(AbilityController)}, limit:NextOccurrence, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:$operation}]}} */
next_draw_replaced ::= "the" "next" "time" "you" "would" "draw" "a" "card" this_duration "," operation "instead"

/* The chosen card belongs to the revealed hand's owner; its native single
   object result and the written library depth remain distinct operands. */
/* @sem Operation::Move{objects:One(Result{result:@marked, phase:After, index:0}), destination:Library{position:FromTop($library_depth), order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
hand_put_library_depth ::= "that" "player" "puts" "that" "card" "into" "their" "library" library_depth "from" "the" "top"

/* This prefix owns its complete sentence; declining every offered mana payment
   is the only branch in which the following instructions happen. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:FirstWilling(All), cost:Cost{parts:[$cost_mana]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:$instructions}, otherwise:Program{}}] */
clause_unless_any_player_mana ::= "unless" "any" "player" "pays" cost_mana "," instructions

/* Composable damage recipient and redirection retain their separate operands. */
/* @sem Ability::Replacement{active:Battlefield, event:$redirect_damage_event, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage(Objects($affected))}}]}} */
replacement_redirect_all_damage ::= "all" redirect_damage_event "is" "dealt" "to" affected "instead" "."
/* @sem ReplacementEvent::Damage(_{source_kind:Any, sources:Any, recipients:$redirect_damage_recipients, kind:Any, grouping:SourceRecipient, subject:Recipient}) */
redirect_damage_event ::= "damage" "that" "would" "be" "dealt" "to" redirect_damage_recipients
redirect_damage_recipients ::= damage_to_you | redirect_you_and_other
/* @sem DamageRecipients::ObjectsAndPlayers{objects:AllOf([Not(SameObject(Source)), $filter_plural]), players:One(AbilityController)} */
redirect_you_and_other ::= "you" "and" "other" filter_plural

/* The event and its cancellation are separate phrase meanings. */
/* @sem Ability::Replacement{active:Battlefield, event:$extra_turn_event, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:$cancel_extra_turn}}]}} */
replacement_skip_extra_turn ::= "if" extra_turn_event "," cancel_extra_turn "instead" "."
/* @sem ReplacementEvent::Player{event:BeginExtraTurn, players:All} */
extra_turn_event ::= "a" "player" "would" "begin" "an" "extra" "turn"
/* @sem EventChange::Cancel */
cancel_extra_turn ::= "that" "player" "skips" "that" "turn"

/* Entry event and modification compose independently for plural populations. */
/* @sem Ability::Replacement{active:Battlefield, event:$plural_entry_event, body:_{instructions:[Effect{result:@next, operation:$plural_entry_change}]}} */
plural_entry_replacement ::= plural_entry_event plural_entry_change "."

/* @sem ReplacementEvent::Enter{objects:$filter_plural} */
plural_entry_event_plain ::= filter_plural "enter"

/* @sem ReplacementEvent::Enter{objects:AllOf([$filter_plural, Cast{by:OpponentsOf(AbilityController)}])} */
plural_entry_event_played ::= filter_plural "played" "by" "your" "opponents" "enter"

plural_entry_event ::= plural_entry_event_plain | plural_entry_event_played

plural_entry_change ::= plural_entry_counter_one | plural_entry_counter_additional_one | plural_entry_counter_additional_many | plural_entry_tapped

/* @sem Operation::ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$counter_amount})} */
plural_entry_counter_one ::= "with" counter_amount counter_kind "counter" "on" "them"

/* @sem Operation::ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$counter_amount})} */
plural_entry_counter_additional_one ::= "with" counter_amount "additional" counter_kind "counter" "on" "them"

/* @sem Operation::ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$value})} */
plural_entry_counter_additional_many ::= "with" value "additional" counter_kind "counters" "on" "them"

/* @sem Operation::ModifyEvent{change:SetTapped(true)} */
plural_entry_tapped ::= "tapped"

/* A pointwise damage event and its conditional response preserve the recipient. */
/* @sem ReplacementEvent::EachPoint(Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject($object_ref)), kind:Any, grouping:SourceRecipient, subject:Recipient})) */
each_damage_point_event ::= "for" "each" "1" "damage" "that" "would" "be" "dealt" "to" object_ref

/* @sem Program::_{instructions:[If{condition:$condition, then:_{instructions:[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}, otherwise:_{}}]} */
each_damage_conditional_response ::= "if" condition "," operation "and" "prevent" "that" "1" "damage"

/* @sem Ability::Replacement{active:Battlefield, event:$each_damage_point_event, body:$each_damage_conditional_response} */
each_damage_replacement ::= each_damage_point_event "," each_damage_conditional_response "."

/* The two explore actions refer to the event subject and retain their actor. */
/* @sem ReplacementEvent::Object{event:Explores, objects:AllOf([$noun, ControlledBy(One(AbilityController))])} */
controlled_explore_event ::= "if" "a" noun "you" "control" "would" "explore"

/* @sem Program::_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Explore{object:EventSubject}}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Explore{object:EventSubject}}}]} */
explore_twice_response ::= "instead" "it" "explores" "," "then" "it" "explores" "again"

/* @sem Ability::Replacement{active:Battlefield, event:$controlled_explore_event, body:$explore_twice_response} */
controlled_explore_replacement ::= controlled_explore_event "," explore_twice_response "."

/* Compose entry replacements from a subject and a modification program. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:$entry_modification}) */
entry_modified ::= object_ref "enters" entry_modification "."

entry_modification ::= entry_counter_for_each | entry_tapped_and_counters | entry_tapped_single_counter | entry_single_counter_her | entry_opponent_controller | entry_tapped_unless_either | entry_tapped_unless_either_reverse

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}, Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$value})}}]} */
entry_tapped_and_counters ::= "tapped" "and" "with" value counter_kind "counters" "on" "it"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}, Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$counter_amount})}}]} */
entry_tapped_single_counter ::= "tapped" "with" counter_amount counter_kind "counter" "on" "it"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$counter_amount})}}]} */
entry_single_counter_her ::= "with" counter_amount counter_kind "counter" "on" "her"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetController(OneOf(OpponentsOf(AbilityController)))}}]} */
entry_opponent_controller ::= "under" "the" "control" "of" "an" "opponent" "of" "your" "choice"

/* @sem Program::Program{instructions:[If{condition:Not(AnyOf([$condition, Controls{player:AbilityController, filter:$filter_phrase, minimum:1}])), then:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}]}, otherwise:_{}}]} */
entry_tapped_unless_either ::= "tapped" "unless" condition "or" "an" filter_phrase

/* @sem Program::Program{instructions:[If{condition:Not(AnyOf([Controls{player:AbilityController, filter:$filter_phrase, minimum:1}, $condition])), then:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}]}, otherwise:_{}}]} */
entry_tapped_unless_either_reverse ::= "tapped" "unless" condition "or" "an" filter_phrase

/* The condition is evaluated for the entering object's controller. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:_{instructions:[If{condition:$entry_prior_condition, then:$entry_simple_modification, otherwise:_{}}]}}) */
entry_conditional_prefix ::= "if" entry_prior_condition "," object_ref "enters" entry_simple_modification "."

/* @sem Condition::PlayerState{player:AbilityController, state:StartingPlayer} */
entry_prior_condition ::= "you" "were" "the" "starting" "player"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}]} */
entry_simple_modification ::= "tapped"

/* Other recipients exclude the holder while preserving the complete population. */
/* @sem DamageRecipients::Objects(AllOf([Not(SameObject(Source)), $filter_plural])) */
shield_to_other_group ::= "other" filter_plural

/* Damage sources and the multiplier are independent operands of the replacement. */
/* @sem Ability::Replacement{active:Battlefield, event:$replacement_outgoing_damage, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([$damage_factor, EventAmount]))}}]}} */
replacement_scale_outgoing ::= damage_factor "all" "damage" replacement_outgoing_damage "."

/* @sem ReplacementEvent::Damage(_{source_kind:Permanent, sources:SameObject($object_ref), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Recipient}) */
replacement_outgoing_object ::= object_ref "would" "deal"

/* @sem ReplacementEvent::Damage(_{source_kind:Any, sources:AllOf([$filter_phrase, ControlledBy(One(AbilityController))]), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Recipient}) */
replacement_outgoing_controlled ::= "that" filter_phrase "sources" "you" "control" "would" "deal"

replacement_outgoing_damage ::= replacement_outgoing_object | replacement_outgoing_controlled

/* The same object identifies the redirected damage and its controller. */
/* @sem Ability::Replacement{active:Battlefield, event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject($object_ref)), kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage(Players(One(ControllerOf($object_ref))))}}]}} */
replacement_redirect_controller ::= "all" prevent_damage "that" "would" "be" "dealt" "to" object_ref "is" "dealt" "to" "its" "controller" "instead" "."

/* Entry applies the current characteristic changes to the entering population. */
/* @sem Ability::Replacement{active:Battlefield, event:Enter{objects:$filter_phrase}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Entry(Changes($entry_creature_changes))}}]}} */
replacement_entry_creature ::= "as" "a" filter_phrase "enters" "," "it" entry_creature_changes "."

/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Creature)] */
entry_creature_changes ::= "becomes" "a" value "/" value becomes_types "creature" "in" "addition" "to" "its" "other" "types"

/* Replacement events and their event-bound outcomes are shared independently. */
/* @sem ReplacementEvent::Tokens{tokens:Any, controllers:One(AbilityController), effect_only:true} */
replacement_effect_creates_tokens ::= "an" "effect" "would" "create" "one" "or" "more" "tokens" "under" "your" "control"

/* @sem EventChange::ReplaceTokens{copies:2} */
replacement_twice_created_tokens ::= "it" "creates" "twice" "that" "many" "of" "those" "tokens"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_effect_creates_tokens, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:$replacement_twice_created_tokens}}]}} */
replacement_effect_token_copies ::= "if" replacement_effect_creates_tokens "," replacement_twice_created_tokens "instead" "."

replacement_event_player ::= replacement_opponent_player | replacement_any_player

/* @sem PlayerSet::OpponentsOf(AbilityController) */
replacement_opponent_player ::= "an" "opponent"

/* @sem PlayerSet::All */
replacement_any_player ::= "a" "player"

/* @sem ReplacementEvent::Player{event:BeginExtraTurn, players:$replacement_event_player} */
replacement_extra_turn_event ::= replacement_event_player "would" "begin" "an" "extra" "turn"

/* @sem ReplacementEvent::Player{event:GainLife, players:$replacement_event_player} */
replacement_gain_life_event ::= replacement_event_player "would" "gain" "life"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_extra_turn_event, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}]}} */
replacement_player_skip_extra ::= "if" replacement_extra_turn_event "," "that" "player" "skips" "that" "turn" "instead" "."

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_gain_life_event, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:LoseLife{players:One(EventSubject), amount:EventAmount}}]}} */
replacement_player_lose_instead ::= "if" replacement_gain_life_event "," "that" "player" "loses" "that" "much" "life" "instead" "."

/* Another source excludes the holder, independently of the event recipient. */
/* @sem ObjectFilter::AllOf([Not(SameObject(Source)), $adjective_color, ControlledBy(One(AbilityController))]) */
source_other_color_yours ::= "another" adjective_color "source" "you" "control"

/* @sem ReplacementEvent::ProduceMana{sources:$filter_phrase} */
replacement_tapped_mana_event ::= "a" filter_phrase "is" "tapped" "for" "mana"

/* @sem EventChange::ReplaceMana(ChooseOne([Amount{color:White, amount:$counter_amount}, Amount{color:Blue, amount:$counter_amount}, Amount{color:Black, amount:$counter_amount}, Amount{color:Red, amount:$counter_amount}, Amount{color:Green, amount:$counter_amount}])) */
replacement_chosen_color_mana ::= "it" "produces" "mana" "of" counter_amount "color" "of" "your" "choice"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_tapped_mana_event, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:$replacement_chosen_color_mana}}]}} */
replacement_mana_color_choice ::= "if" replacement_tapped_mana_event "," replacement_chosen_color_mana "instead" "of" "any" "other" "type" "."

/* The attached land is the event subject, while the Aura is sacrificed. */
/* @sem ReplacementEvent::Object{event:Destroyed, objects:SameObject(AttachedTo(Source))} */
replacement_enchanted_land_destroyed ::= "enchanted" "land" "would" "be" "destroyed"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(EventSubject)), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot} */
replacement_event_land_gains ::= "that" "land" "gains" keyword_name duration

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_enchanted_land_destroyed, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:One(Source)})}, Effect{result:@next, operation:$replacement_event_land_gains}]}} */
replacement_attached_destroyed_sacrifice ::= "if" replacement_enchanted_land_destroyed "," "instead" "sacrifice" "this" "Aura" "and" replacement_event_land_gains "."

/* Damage event phrases keep source and recipient roles explicit. */
/* @sem ReplacementEvent::Damage(_{source_kind:Any, sources:Any, recipients:Objects($filter_phrase), kind:Any, grouping:SourceRecipient, subject:Recipient}) */
shield_event_each ::= "that" "would" "be" "dealt" "to" "each" filter_phrase

/* @sem ReplacementEvent::Damage(_{source_kind:Permanent, sources:$prevent_by_permanents, recipients:Any, kind:Any, grouping:SourceRecipient, subject:Recipient}) */
shield_event_by ::= "that" "would" "be" "dealt" "by" prevent_by_permanents

/* @sem Operation::CreateReplacement{event:$shield_event_each, limit:DamageToEach($value), duration:$this_duration, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
shield_each_next ::= "prevent" "the" "next" value "damage" shield_event_each this_duration

/* @sem Operation::CreateReplacement{event:$shield_event_by, limit:TotalDamage($value), duration:$this_duration, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
shield_by_next ::= "prevent" "the" "next" value "damage" shield_event_by this_duration

/* @sem ReplacementEvent::Damage(_{source_kind:Permanent, sources:AllOf([$filter_phrase, Chosen(CreatureType)]), recipients:Players(One(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Recipient}) */
shield_chosen_type_event ::= "a" filter_phrase "of" "the" "chosen" "type" "would" "deal" "damage" "to" "you"

/* @sem Operation::CreateReplacement{event:$shield_chosen_type_event, limit:NextOccurrence, duration:$this_duration, body:$prevented_body_plain} */
shield_next_occurrence ::= "the" "next" "time" shield_chosen_type_event this_duration "," prevented_body_plain

/* @sem ReplacementEvent::Damage(_{source_kind:Any, sources:Any, recipients:ObjectsAndPlayers{objects:SameObject($object_ref), players:One(AbilityController)}, kind:Any, grouping:SourceRecipient, subject:Recipient}) */
redirect_event_self_and_you ::= "damage" "would" "be" "dealt" "to" object_ref "and" "/" "or" "you"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage($recipients)}}]} */
redirect_damage_body ::= "that" "damage" "is" "dealt" "to" recipients "instead"

/* @sem Operation::CreateReplacement{event:$redirect_event_self_and_you, limit:NextOccurrence, duration:$this_duration, body:$redirect_damage_body} */
redirect_next_occurrence ::= "the" "next" "time" redirect_event_self_and_you this_duration "," redirect_damage_body

/* @sem DamageRecipients::Objects(SameObject($object_ref)) */
redirect_object_recipient ::= "to" object_ref

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage(Objects($affected))}}]} */
redirect_affected_body ::= "is" "dealt" "to" affected "instead"

/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:$redirect_object_recipient, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:TotalDamage($number), duration:$this_duration, body:$redirect_affected_body} */
redirect_next_amount ::= "the" "next" number "damage" "that" "would" "be" "dealt" this_duration redirect_object_recipient redirect_affected_body

/* @sem DamageRecipients::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(2)), filter:AnyOf([CardType(Creature), CardType(Planeswalker)]), players:All}), index:0} */
redirect_pair_recipient ::= "target" "creature" "," "planeswalker" "," "or" "player"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage(Target{slot:0, index:1})}}]} */
redirect_pair_body ::= "is" "dealt" "to" "another" "target" "creature" "," "planeswalker" "," "or" "player" "instead"

/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:$redirect_pair_recipient, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:TotalDamage($number), duration:$this_duration, body:$redirect_pair_body} */
redirect_next_pair ::= "the" "next" number "damage" "that" "would" "be" "dealt" "to" redirect_pair_recipient this_duration redirect_pair_body

/* Damage prevention and its draw use the immediately preceding prevention receipt. */
/* @sem Ability::Replacement{active:Battlefield, event:$damage_event, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, Effect{result:@next, operation:Draw{players:One(ControllerOf(Damage(Source))), amount:Performed(@prior)}}]}} */
replacement_damage_prevent_draw ::= "if" damage_event "," "prevent" "that" "damage" "." "the" "source's" "controller" "draws" "cards" "equal" "to" "the" "damage" "prevented" "this" "way" "."

/* The other controlled recipient excludes the ability holder itself. */
/* @sem DamageRecipients::Objects(@and(ObjectFilter::Not(ObjectFilter::SameObject(Source)), $filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))) */
damage_to_another_controlled ::= "another" filter_phrase "you" "control"

/* The two mentions of a recipient must name the same kind of permanent. */
/* @sem Ability::Replacement{active:Battlefield, event:Damage(_{source_kind:Any, sources:$replacement_damage_source, recipients:ObjectsAndPlayers{objects:@agree($filter_head, $filter_head_2), players:All}, kind:Any, grouping:SourceRecipient, subject:Recipient}), body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Divide{numerator:EventAmount, denominator:Constant(2), rounding:Down})}}]}} */
replacement_damage_half_down ::= "if" replacement_damage_source "would" "deal" "damage" "to" "a" filter_head "or" "player" "," "it" "deals" "half" "that" "damage" "," "rounded" "down" "," "to" "that" filter_head "or" "player" "instead" "."

/* @sem Ability::Replacement{active:Battlefield, event:Damage(_{source_kind:Any, sources:$replacement_damage_source, recipients:ObjectsAndPlayers{objects:$modifier_opponent_controls, players:OpponentsOf(AbilityController)}, kind:Any, grouping:SourceRecipient, subject:Recipient}), body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([$damage_factor, EventAmount]))}}]}} */
replacement_damage_double_opponent ::= "if" replacement_damage_source "would" "deal" "damage" "to" "an" "opponent" "or" "a" "permanent" modifier_opponent_controls "," "that" "source" "deals" damage_factor "that" "damage" "to" "that" "player" "or" "permanent" "instead" "."

/* @sem Ability::Replacement{active:Battlefield, event:$damage_event, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventSomeDamage(Divide{numerator:EventAmount, denominator:Constant(2), rounding:Up})}}]}} */
replacement_damage_prevent_half ::= "if" damage_event "," "prevent" "half" "that" "damage" "," "rounded" "up" "."

/* The explicit repeated "you" refers to the same recipient. */
/* @sem ReplacementEvent::Damage(_{source_kind:Any, sources:$replacement_damage_source, recipients:Players(One(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Recipient}) */
damage_event_you ::= replacement_damage_source "would" "deal" "damage" "to" "you"

/* @sem Ability::Replacement{active:Battlefield, event:$damage_event_you, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([$damage_factor, EventAmount]))}}]}} */
replacement_damage_double_you ::= "if" damage_event_you "," "it" "deals" damage_factor "that" "damage" "to" "you" "instead" "."

prevent_shield_ref ::= object_ref | prevent_named_creature_ref

/* @sem ObjectRef::@current_named_object */
prevent_named_creature_ref ::= "the" "creature"

/* Damage event descriptions retain the source domain and recipient independently. */
/* @sem ReplacementEvent::Damage(_{source_kind:Permanent, sources:$filter_plural, recipients:Players(All), kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}) */
prevent_event_permanents_to_players ::= prevent_damage "that" filter_plural "would" "deal" "to" "players"

/* @sem ObjectFilter::AnyOf([$adjective_color, $adjective_color_2]) */
prevent_source_color_pair ::= adjective_color "sources" "and" adjective_color "sources"

/* @sem ReplacementEvent::Damage(_{source_kind:Any, sources:$prevent_source_color_pair, recipients:Any, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}) */
prevent_event_color_sources ::= prevent_damage "that" prevent_source_color_pair "would" "deal"

prevent_event_from ::= prevent_event_permanents_to_players | prevent_event_color_sources

/* @sem Operation::CreateReplacement{event:$prevent_event_from, limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevent_from_event ::= "prevent" "all" prevent_event_from this_duration

/* @sem ObjectFilter::Not(AnyOf([$filter_plural, $filter_plural_2])) */
prevent_except_sources ::= filter_plural "and" filter_plural

/* @sem ReplacementEvent::Damage(_{source_kind:Permanent, sources:$prevent_except_sources, recipients:Any, kind:Combat, grouping:SourceRecipient, subject:Recipient}) */
prevent_event_combat_except ::= "except" "combat" "damage" "that" "would" "be" "dealt" "by" prevent_except_sources

/* @sem Operation::CreateReplacement{event:$prevent_event_combat_except, limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevent_except_event ::= "prevent" "all" "combat" "damage" "that" "would" "be" "dealt" this_duration prevent_event_combat_except

/* @sem ObjectFilter::Name(@card_name) */
prevent_named_plane_source ::= "planes" "named" SELF_NAME

/* @sem ReplacementEvent::Damage(_{source_kind:Card, sources:$prevent_named_plane_source, recipients:Objects($filter_plural), kind:Any, grouping:SourceRecipient, subject:Recipient}) */
prevent_event_named_plane ::= "damage" "that" prevent_named_plane_source "would" "deal" "this" "game" "to" filter_plural

/* @sem Operation::CreateReplacement{event:$prevent_event_named_plane, limit:UntilExpired, duration:Indefinite, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevent_named_plane_event ::= "prevent" "all" prevent_event_named_plane

/* Conditional gates compose with independently meaningful replacement abilities. */
/* @sem Ability::Conditional{condition:$condition, then:[$conditional_damage_replacement]} */
conditional_damage_as_long ::= "as" "long" "as" condition "," conditional_damage_replacement

/* @sem Ability::Conditional{condition:$static_turn_window, then:[$conditional_damage_replacement]} */
conditional_damage_during ::= static_turn_window "," conditional_damage_replacement

conditional_damage_replacement ::= replacement_prevent_all | replacement_prevent_targeting_spells | replacement_prevent_banded | replacement_leave_loyalty

/* @sem Ability::Replacement{active:Battlefield, event:Damage(_{source_kind:Spell, sources:TargetsAny(Objects(One($object_ref_2))), recipients:Objects(SameObject($object_ref)), kind:Any, grouping:SourceRecipient, subject:Recipient}), body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
replacement_prevent_targeting_spells ::= "prevent" "all" "damage" "that" "would" "be" "dealt" "to" object_ref "by" "spells" "that" "target" object_ref "."

/* @sem Ability::Replacement{active:Battlefield, event:Damage(_{source_kind:Permanent, sources:$filter_plural, recipients:Objects(AnyOf([SameObject($object_ref), AllOf([$filter_plural_2, BandedWith($object_ref_2)])])), kind:Any, grouping:SourceRecipient, subject:Recipient}), body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
replacement_prevent_banded ::= "prevent" "all" "damage" filter_plural "would" "deal" "to" object_ref "and" "to" filter_plural "banded" "with" object_ref "."

/* @sem Ability::Replacement{active:Battlefield, event:Measured{event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(AllOf([$noun, Chosen(PlaneswalkerType), ControlledBy(One(AbilityController))])), kind:Any, grouping:SourceRecipient, subject:Recipient}), comparison:GreaterOrEqual, amount:CountCounters(_{recipients:Objects(One(EventSubject)), kind:Named(LoyaltyCounter), information:CurrentOrLastKnown})}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:LeaveLoyalty($number)}}]}} */
replacement_leave_loyalty ::= "if" "damage" "dealt" "to" "a" noun "you" "control" "of" "the" "chosen" "type" "would" "result" "in" "all" "loyalty" "counters" "on" "it" "being" "removed" "," "instead" "all" "but" number "of" "those" "counters" "are" "removed" "."

/* Entry bodies that consume an immediately preceding, typed sacrifice receipt. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_ref)}, body:$entry_receipt_program}) */
entry_receipt_ability ::= "as" self_ref "enters" "," entry_receipt_program "."

entry_receipt_program ::= entry_removed_counter_program | entry_reveal_or_condition_program | entry_coin_program | entry_sacrifice_count_program | entry_sacrifice_stats_program | entry_optional_sacrifice_count_program

/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:$affected, choose:AnyNumber}) */
entry_sacrifice_any ::= "sacrifice" "any" "number" "of" affected

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$entry_sacrifice_any}, Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:CountObjects(Transition{result:@prior, phase:Before})})}}]} */
entry_sacrifice_count_program ::= entry_sacrifice_any "." SELF_NAME "enters" "with" "that" "many" counter_kind "counters" "on" "it"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$entry_sacrifice_creatures}, Effect{result:@next, operation:ModifyEvent{change:Entry(Changes([SetPower(Aggregate{objects:Transition{result:@prior, phase:Before}, property:Power, aggregation:Sum}), SetToughness(Aggregate{objects:Transition{result:@prior, phase:Before}, property:Toughness, aggregation:Sum})]))}}]} */
entry_sacrifice_stats_program ::= entry_sacrifice_creatures "." "this" "creature's" "power" "becomes" "the" "total" "power" "of" "those" "creatures" "and" "its" "toughness" "becomes" "their" "total" "toughness"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$entry_sacrifice_any}, Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:Multiply([Constant(2), CountObjects(Transition{result:@prior, phase:Before})])})}}]} */
entry_optional_sacrifice_count_program ::= "you" "may" entry_sacrifice_any "." "if" "you" "do" "," "it" "enters" "with" "twice" "that" "many" counter_kind "counters" "on" "it"

/* The aggregate names creatures, so the receipt must contain only creatures. */
/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:AnyNumber}) */
entry_sacrifice_creatures ::= "sacrifice" "any" "number" "of" "creatures"

/* The counter receipt is produced by this exact removal, not an arbitrary action. */
/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), amount:All}]} */
entry_remove_all_counters ::= "remove" "all" "counters" "from" affected

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$entry_remove_all_counters}, Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:CountersRemoved(@prior)})}}]} */
entry_removed_counter_program ::= entry_remove_all_counters "." "this" "creature" "enters" "with" "a" counter_kind "counter" "on" "it" "for" "each" "counter" "removed" "this" "way"

/* Optional reveal supplies the payment result tested by the next clause. */
/* @sem Operation::PayCost{player:AbilityController, cost:_{parts:[Reveal{count:Exactly(Constant(1)), filter:$filter_phrase}]}, optional:true} */
entry_optional_reveal ::= "you" "may" "reveal" "a" filter_phrase "card" "from" "your" "hand"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$entry_optional_reveal}, If{condition:AnyOf([PaymentChosen(0), $condition]), then:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$counter_amount})}}]}, otherwise:_{}}]} */
entry_reveal_or_condition_program ::= entry_optional_reveal "." "if" "you" "do" "or" "if" condition "," "this" "creature" "enters" "with" counter_amount counter_kind "counter" "on" "it"

/* Both branches describe the entering creature's copiable characteristics. */
/* @sem EventChange::Entry(Changes([Copiable([SetBasePowerToughness{power:$value, toughness:$value_2}]), Copiable([AddCardType(Creature)]), Copiable([GrantKeyword($keyword_value)])])) */
entry_creature_coin_change ::= "this" "creature" "enters" "as" "a" value "/" value "creature" "with" keyword_value

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$flip_a_coin}, If{condition:CoinFlip{result:0, outcome:Heads}, then:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:$entry_creature_coin_change}}]}, otherwise:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:$entry_creature_coin_change_2}}]}}]} */
entry_coin_program ::= flip_a_coin "." "if" "the" "coin" "comes" "up" "heads" "," entry_creature_coin_change "." "if" "it" "comes" "up" "tails" "," entry_creature_coin_change

/* A range of target permanents supplies the damage sources. */
/* @sem ObjectFilter::InSet(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Between{minimum:$number, maximum:$number_2}, filter:$plural}))) */
damage_target_range ::= number "or" number "target" plural

/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Permanent, sources:$damage_target_range, recipients:Any, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevent_damage_target_range ::= "prevent" "all" "damage" damage_target_range "would" "deal" this_duration

/* A temporary counter replacement keeps its affected population and amount. */
/* @sem ReplacementEvent::Counters(_{objects:$counter_replacement_population}) */
temporary_counter_event ::= "one" "or" "more" "counters" "would" "be" "put" "on" counter_replacement_population

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Add([EventAmount, $number]))}}]} */
counter_add_each_kind_body ::= "that" "many" "plus" number "of" "each" "of" "those" "kinds" "of" "counters" "are" "put" "on" "that" "permanent" "instead"

/* @sem Operation::CreateReplacement{event:$temporary_counter_event, limit:UntilExpired, duration:$duration, body:$counter_add_each_kind_body} */
temporary_counter_add_each_kind ::= duration "," "if" temporary_counter_event "," counter_add_each_kind_body

/* @sem ReplacementEvent::Counters(_{kind:PowerToughness(1, 1), objects:$counter_replacement_population, by:One(AbilityController)}) */
temporary_your_pt_counter_event ::= "you" "would" "put" "one" "or" "more" "+" "1" "/" "+" "1" "counters" "on" counter_replacement_population

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Add([EventAmount, $number]))}}]} */
counter_add_pt_body ::= "put" "that" "many" "plus" number "+" "1" "/" "+" "1" "counters" "on" "it" "instead"

/* @sem Operation::CreateReplacement{event:$temporary_your_pt_counter_event, limit:UntilExpired, duration:$duration, body:$counter_add_pt_body} */
temporary_your_pt_counter_add ::= duration "," "if" temporary_your_pt_counter_event "," counter_add_pt_body

/* The controller of the damaging source is the recipient of redirected damage. */
/* @sem ObjectFilter::SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([State(Unblocked), $noun])}), index:0}) */
unblocked_damage_target ::= "target" "unblocked" noun

/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Permanent, sources:$unblocked_damage_target, recipients:Players(One(AbilityController)), kind:Combat, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage(Players(One(ControllerOf(Damage(Source)))))}}]}} */
redirect_unblocked_combat ::= "all" "combat" "damage" "that" "would" "be" "dealt" "to" "you" this_duration "by" unblocked_damage_target "is" "dealt" "to" "its" "controller" "instead"

/* Each player selects their own permanent and it goes to its owner's hand. */
/* @sem Instruction::ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:ControlledBy(One(Bound(0)))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}} */
each_player_returns_controlled ::= players_singular "returns" "a" "permanent" "they" "control" "to" "its" "owner's" "hand"

/* @sem Operation::CreateReplacement{event:Player{event:Draw, players:One(AbilityController)}, limit:NextOccurrence, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, $each_player_returns_controlled]}} */
next_draw_each_player_return ::= "the" "next" "time" "you" "would" "draw" "a" "card" this_duration "," each_player_returns_controlled "instead"

/* Optional replacements share the event and the choice, while each offered
   token recipe remains an independent current operand. */
/* @sem Ability::Replacement{active:Battlefield, event:$optional_token_event, body:_{instructions:[Effect{result:@next, operation:ChooseAction{actor:One(AbilityController), options:$optional_token_choices}}]}} */
optional_token_replacement ::= optional_token_event "," "you" "may" optional_token_choices "."

optional_token_event ::= optional_token_event_any | optional_token_event_first

/* @sem ReplacementEvent::Tokens{tokens:Any, creators:One(AbilityController)} */
optional_token_event_any ::= "if" "you" "would" "create" "one" "or" "more" "tokens"

/* @sem ReplacementEvent::FirstEachTurn(Tokens{tokens:Any, creators:One(AbilityController)}) */
optional_token_event_first ::= "the" "first" "time" "you" "would" "create" "one" "or" "more" "tokens" "each" "turn"

optional_token_choices ::= optional_token_choice_after | optional_token_choice_before | optional_token_choice_pair

/* @sem Operand::[$replacement_token_option, Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:ReplaceTokens{copies:1}}}]}] */
optional_token_choice_after ::= "create" replacement_token_option "instead"

/* @sem Operand::[$replacement_token_option_creating, Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:ReplaceTokens{copies:1}}}]}] */
optional_token_choice_before ::= "instead" "create" replacement_token_option_creating

/* @sem Operand::[$replacement_token_option, $replacement_token_option_2, Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:ReplaceTokens{copies:1}}}]}] */
optional_token_choice_pair ::= "instead" "create" replacement_token_option "or" replacement_token_option

/* @sem Operand::Program(Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:ReplaceTokens{copies:0, tokens:[$replacement_token_spec]}}}]}) */
replacement_token_option ::= replacement_token_spec

/* @sem Operand::Program(Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:ReplaceTokens{copies:0, tokens:[$replacement_token_creating]}}}]}) */
replacement_token_option_creating ::= replacement_token_creating

replacement_token_creating ::= replacement_token_defined | replacement_token_copy

replacement_token_spec ::= replacement_token_creating | replacement_token_named

/* @sem TokenSpec::TokenSpec{amount:EventAmount, words:CreatingEffect, recipe:$token_recipe} */
replacement_token_defined ::= "that" "many" token_recipe

/* @sem TokenSpec::TokenSpec{amount:EventAmount, words:Rules, recipe:$token_named_recipe} */
replacement_token_named ::= "that" "many" token_named_recipe "tokens"

/* @sem TokenSpec::TokenSpec{amount:EventAmount, words:CreatingEffect, recipe:Copy{object:$object_ref, exceptions:[]}} */
replacement_token_copy ::= "that" "many" "tokens" "that" "are" "copies" "of" object_ref

/* Skipping the draw is a choice to cancel it or perform that same draw. */
/* @sem Ability::Replacement{active:Battlefield, event:$draw_event, body:_{instructions:[Effect{result:@next, operation:ChooseAction{actor:One(AbilityController), options:[Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}]}, Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Constant(1)}}]}]}}]}} */
replacement_skip_draw ::= "if" draw_event "," "you" "may" "skip" "that" "draw" "instead" "."

/* A death event binds the graveyard arrival used by its perpetual effect. */
/* @sem Instruction::[Effect{result:@next, operation:Operation::@scope(Operation::CreateTrigger{event:ZoneChange{objects:$event_a, from:Battlefield, to:Graveyard}, duration:$duration, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Query{objects:InZone{objects:One(EventDestination), zone:Graveyard}, index:0}), changes:[GrantAbility(Mechanic{mechanic:Unearth, cost:_{parts:[Mana($mana_symbols)]}})]}}]}})}] */
temporary_death_unearth ::= duration "," "whenever" event_a "dies" "," "it" "perpetually" "gains" "unearth" mana_symbols

/* The same prevention ability can be qualified by a turn window. */
/* @sem Ability::Replacement{active:Battlefield, event:Damage(DamageEvent{source_kind:Any, sources:Any, recipients:$shield_to, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
replacement_prevent_all_phrase ::= "prevent" "all" prevent_damage "that" "would" "be" "dealt" "to" shield_to

/* @sem Ability::Conditional{condition:$static_turn_window, then:[$replacement_prevent_all_phrase]} */
replacement_prevent_all_during ::= replacement_prevent_all_phrase static_turn_window "."

/* The event and replacement action retain their shared controller independently. */
/* @sem ReplacementEvent::Player{event:GainLife, players:One(AbilityController)} */
replacement_you_gain_event ::= "you" "would" "gain" "life"

/* @sem Operation::GainLife{players:One(AbilityController), amount:Multiply([Constant(2), EventAmount])} */
replacement_you_gain_twice ::= "you" "gain" "twice" "that" "much" "life"

/* @sem Ability::Conditional{condition:$condition, then:[Replacement{active:Battlefield, event:$replacement_you_gain_event, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:$replacement_you_gain_twice}]}}]} */
replacement_gain_while ::= "if" replacement_you_gain_event "while" condition "," replacement_you_gain_twice "instead" "."

/* The next combat end this turn bounds the delayed trigger's lifetime. */
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, expires:EndOfTurn, body:Program{instructions:$may_body}}}] */
clause_delayed_this_combat ::= "at" "this" "turn's" "next" "end" "of" "combat" "," may_body

/* The referenced player's upkeep and the return controller are the same player. */
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:UpkeepBegins, players:One(@that_player)}, start:Immediately, body:Program{instructions:$return_under_that_player}}}] */
clause_target_upkeep_return ::= return_under_that_player "at" "the" "beginning" "of" "their" "next" "upkeep"

/* The event subject performs the replacement; the chosen opponent remains the
   library owner. These bodies are scoped to a single draw replacement. */
/* @sem ReplacementEvent::Player{event:Draw, players:$replacement_event_player} */
replacement_player_draw_event ::= replacement_event_player "would" "draw" "a" "card"

/* @sem ExileVisibility::FaceUp */
replacement_exile_face_up ::= "face" "up"

/* @sem ExileVisibility::FaceDown */
replacement_exile_face_down ::= "face" "down"

replacement_exile_visibility ::= replacement_exile_face_up | replacement_exile_face_down

/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One(EventSubject)}, kind:Card, filter:Any}, count:Constant(1), from:Top} */
replacement_drawn_card ::= "that" "card"

/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One(Chosen)}, kind:Card, filter:Any}, count:Constant(1), from:Top} */
replacement_opponent_top_card ::= "the" "top" "card" "of" "one" "of" "their" "opponents'" "libraries"

/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One(Chosen)}, kind:Card, filter:Any}, count:$count_plural, from:Top} */
replacement_opponent_top_cards ::= "the" "top" count_plural "cards" "of" "one" "of" "their" "opponents'" "libraries"

replacement_opponent_top_slice ::= replacement_opponent_top_card | replacement_opponent_top_cards

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$replacement_drawn_card, destination:Exile{visibility:$replacement_exile_visibility, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
replacement_draw_exile_card ::= "that" "player" "exiles" replacement_drawn_card replacement_exile_visibility

/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(EventSubject), kind:Player, terms:_{count:Exactly(Constant(1)), options:[Players(OpponentsOf(EventSubject))]}}}, Effect{result:@next, operation:Move{objects:$replacement_opponent_top_slice, destination:Exile{visibility:$replacement_exile_visibility, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
replacement_draw_exile_opponent_top ::= "that" "player" "exiles" replacement_opponent_top_slice replacement_exile_visibility

replacement_draw_exile_body ::= replacement_draw_exile_card | replacement_draw_exile_opponent_top

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_player_draw_event, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, ...$replacement_draw_exile_body]}} */
replacement_player_draw_exile ::= "if" replacement_player_draw_event "," replacement_draw_exile_body "instead" "."

/* A single counter per historical occurrence retains the entry controller. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters{kind:$counter_kind, amount:$entry_death_count}}}]} */
entry_counter_for_each ::= "with" "a" counter_kind "counter" "on" "it" "for" "each" entry_death_count

/* @sem Expr::EventHistory{event:ZoneChange{objects:AllOf([$filter_phrase, ControlledBy(One(AbilityController))]), from:Battlefield, to:Graveyard}, window:ThisTurn, measure:Occurrences} */
entry_death_count ::= filter_phrase "that" "died" "under" "your" "control" "this" "turn"

/* Both word orders name the same announced spell and preserve its filter. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Spell, sources:SameObject($spell_damage_source), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevent_spell_damage ::= "prevent" "all" "damage" spell_damage_source this_duration

spell_damage_source ::= spell_damage_source_deals | spell_damage_source_dealt

/* @sem $target_stack_spell */
spell_damage_source_deals ::= target_stack_spell "would" "deal"

/* @sem $target_stack_spell */
spell_damage_source_dealt ::= "that" "would" "be" "dealt" "by" target_stack_spell

/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Spell, sources:SameObject($target_stack_spell), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage(Players(One(ControllerOf(Damage(Source)))))}}]}} */
redirect_spell_damage_controller ::= "all" "damage" "that" "would" "be" "dealt" this_duration "by" target_stack_spell "is" "dealt" "to" "that" "spell's" "controller" "instead"

/* @sem ObjectFilter::AllOf([ControlledBy(One(AbilityController)), Not(SameObject($object_ref))]) */
source_yours_except ::= "a" "source" "you" "control" "other" "than" object_ref

/* Replacement events and their consequences remain separate operands. */
/* @sem Ability::Replacement{active:Battlefield, event:$retire_mana_event, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:$retire_mana_change}}]}} */
replacement_mana_produced ::= "if" retire_mana_event "," "it" "produces" retire_mana_change "."

/* @sem ReplacementEvent::ProduceMana{sources:$filter_phrase} */
retire_mana_event_plain ::= "a" filter_phrase "is" "tapped" "for" "mana"

/* @sem ReplacementEvent::Measured{event:ProduceMana{sources:$filter_phrase}, comparison:GreaterOrEqual, amount:$value} */
retire_mana_event_measured ::= "a" filter_phrase "is" "tapped" "for" value "or" "more" "mana"

retire_mana_event ::= retire_mana_event_plain | retire_mana_event_measured

/* @sem EventModification::AddMana($mana_production) */
retire_mana_change_amount ::= mana_production "instead" "of" "any" "other" "type" "and" "amount"

/* @sem EventModification::ReplaceMana($mana_production) */
retire_mana_change_type ::= mana_production "instead" "of" "any" "other" "type"

retire_mana_change ::= retire_mana_change_amount | retire_mana_change_type

/* @sem ReplacementEvent::Object{event:Explores, objects:AllOf([$noun, ControlledBy(One(AbilityController))])} */
replacement_explore_event ::= "a" noun "you" "control" "would" "explore"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:Scry{players:One(AbilityController), amount:$number}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Explore{object:EventSubject}}}]} */
replacement_scry_then_explore ::= "instead" "you" "scry" number "," "then" "that" "creature" "explores"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_explore_event, body:$replacement_scry_then_explore} */
replacement_explore_scry ::= "if" replacement_explore_event "," replacement_scry_then_explore "."

/* @sem ReplacementEvent::Object{event:UntapsInUntapStep, objects:AllOf([$noun, ControlledBy(One(AbilityController))])} */
replacement_untap_event ::= "a" noun "you" "control" "would" "untap" "during" "your" "untap" "step"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(EventSubject)), kind:$counter_kind, amount:$number}]}}]} */
replacement_put_event_counters ::= "put" number counter_kind "counters" "on" "it" "instead"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_untap_event, body:$replacement_put_event_counters} */
replacement_untap_counters ::= "if" replacement_untap_event "," replacement_put_event_counters "."

/* @sem ReplacementEvent::Damage(_{source_kind:Permanent, sources:$filter_phrase, recipients:ObjectsAndPlayers{objects:$filter_plural, players:One(AbilityController)}, kind:Combat, grouping:SourceRecipient, subject:Recipient}) */
replacement_combat_you_and_objects ::= "a" filter_phrase "would" "deal" "combat" "damage" "to" "you" "and" "/" "or" "one" "or" "more" filter_plural

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_combat_you_and_objects, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventSomeDamage($value_counters_on_affected)}}]}} */
replacement_prevent_counted_damage ::= "if" replacement_combat_you_and_objects "," "prevent" "X" "of" "that" "damage" "," "where" "X" "is" value_counters_on_affected "."

/* @sem Expr::CountCounters{recipients:Objects($affected), kind:$counter_kind, information:CurrentOrLastKnown} */
value_counters_on_affected ::= "the" "number" "of" counter_kind "counters" "on" affected

/* Replacement events and their consequences retain the event subject and amount. */
/* @sem ReplacementEvent::Player{event:Mill, players:OpponentsOf(AbilityController)} */
replacement_opponent_mill_event ::= "an" "opponent" "would" "mill" "one" "or" "more" "cards"

/* @sem Expr::Multiply([Constant(2), EventAmount]) */
replacement_mill_twice_amount ::= "twice" "that" "many" "cards"

/* @sem Expr::Add([EventAmount, $value]) */
replacement_mill_plus_amount ::= "that" "many" "cards" "plus" value

replacement_mill_amount ::= replacement_mill_twice_amount | replacement_mill_plus_amount

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_opponent_mill_event, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:Mill{players:One(Prior(That)), amount:$replacement_mill_amount}}]}} */
replacement_opponent_mill ::= "if" replacement_opponent_mill_event "," "they" "mill" replacement_mill_amount "instead" "."

/* @sem ReplacementEvent::Player{event:SearchLibrary, players:OpponentsOf(AbilityController)} */
replacement_opponent_search_event ::= "an" "opponent" "would" "search" "a" "library"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_opponent_search_event, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:ModifyEvent{change:SearchTop($card_count)}}]}} */
replacement_search_top ::= "if" replacement_opponent_search_event "," "that" "player" "searches" "the" "top" card_count "of" "that" "library" "instead" "."

/* @sem ReplacementEvent::Player{event:DrawExceptFirstInDrawStep, players:OpponentsOf(AbilityController)} */
replacement_opponent_extra_draw_event ::= "an" "opponent" "would" "draw" "a" "card" "except" "the" "first" "one" "they" "draw" "in" "each" "of" "their" "draw" "steps"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_opponent_extra_draw_event, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:$operation}]}} */
replacement_extra_draw_skip ::= "if" replacement_opponent_extra_draw_event "," "instead" "that" "player" "skips" "that" "draw" "and" operation "."

/* @sem ReplacementEvent::Measured{event:Player{event:DrawCards, players:OpponentsOf(AbilityController)}, comparison:GreaterOrEqual, amount:$number} */
replacement_opponent_draw_many_event ::= "an" "opponent" "would" "draw" number "or" "more" "cards"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_opponent_draw_many_event, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Constant(1)}}, Effect{result:@next, operation:Draw{players:One(EventSubject), amount:Constant(1)}}]}} */
replacement_draw_each_one ::= "if" replacement_opponent_draw_many_event "," "instead" "you" "and" "that" "player" "each" "draw" "a" "card" "."

/* @sem ReplacementEvent::Counters(_{objects:InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counter_replacement_filter}), players:All, by:OpponentsOf(AbilityController)}) */
replacement_opponent_counters_event ::= "an" "opponent" "would" "put" "one" "or" "more" "counters" "on" "a" counter_replacement_filter "or" "player"

/* @sem Expr::Divide{numerator:EventAmount, denominator:Constant(2), rounding:Down} */
replacement_half_rounded_down ::= "half" "that" "many" "of" "each" "of" "those" "kinds" "of" "counters" "on" "that" "permanent" "or" "player" "instead" "," "rounded" "down"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_opponent_counters_event, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount($replacement_half_rounded_down)}}]}} */
replacement_opponent_counters_half ::= "if" replacement_opponent_counters_event "," "they" "put" replacement_half_rounded_down "."

/* Replacement events and outcomes retain their independent operands. */
/* @sem ReplacementEvent::Counters(_{kind:PowerToughness(1, 1), objects:SameObject($object_ref)}) */
replacement_plus_counter_self_event ::= "one" "or" "more" "+" "1" "/" "+" "1" "counters" "would" "be" "put" "on" object_ref

/* @sem ReplacementEvent::Counters(_{kind:PowerToughness(1, 1), objects:InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), $filter_phrase, ControlledBy(One(AbilityController))])})}) */
replacement_plus_counter_other_event ::= "one" "or" "more" "+" "1" "/" "+" "1" "counters" "would" "be" "put" "on" "another" filter_phrase "you" "control"

replacement_plus_counter_event ::= replacement_plus_counter_self_event | replacement_plus_counter_other_event

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Add([EventAmount, $number]))}}]} */
replacement_plus_counter_outcome ::= "that" "many" "plus" number "+" "1" "/" "+" "1" "counters" "are" "put" "on" "it" "instead"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_plus_counter_event, body:$replacement_plus_counter_outcome} */
replacement_counter_plus_phrase ::= "if" replacement_plus_counter_event "," replacement_plus_counter_outcome "."

/* @sem ReplacementEvent::Counters(_{objects:$counter_replacement_population}) */
replacement_any_counter_event ::= "one" "or" "more" "counters" "would" "be" "put" "on" counter_replacement_population

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([Constant(2), EventAmount]))}}]} */
replacement_each_counter_double_outcome ::= "twice" "that" "many" "of" "each" "of" "those" "kinds" "of" "counters" "are" "put" "on" "it" "instead"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_any_counter_event, body:$replacement_each_counter_double_outcome} */
replacement_counter_each_double_phrase ::= "if" replacement_any_counter_event "," replacement_each_counter_double_outcome "."

/* @sem ReplacementEvent::Tokens{tokens:$filter_phrase, controllers:One(AbilityController)} */
replacement_filtered_token_event ::= "one" "or" "more" filter_phrase "tokens" "would" "be" "created" "under" "your" "control"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:ReplaceTokens{copies:3}}}]} */
replacement_token_triple_outcome ::= "three" "times" "that" "many" "of" "those" "tokens" "are" "created" "instead"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:ReplaceTokens{copies:0, tokens:[_{amount:EventAmount, words:CreatingEffect, recipe:$token_recipe}]}}}]} */
replacement_token_recipe_outcome ::= "that" "many" token_recipe "are" "created" "instead"

replacement_filtered_token_outcome ::= replacement_token_triple_outcome | replacement_token_recipe_outcome

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_filtered_token_event, body:$replacement_filtered_token_outcome} */
replacement_filtered_token_phrase ::= "if" replacement_filtered_token_event "," replacement_filtered_token_outcome "."

/* @sem ReplacementEvent::Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject(Source)), kind:Any, grouping:SourceRecipient, subject:Recipient}) */
replacement_self_creature_damage_event ::= "this" "creature" "would" "be" "dealt" "damage"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One(EventSubject)), kind:$counter_kind, amount:Count(Exactly($counter_amount))}]}}]} */
replacement_prevent_remove_counter ::= "prevent" "that" "damage" "and" "remove" counter_amount counter_kind "counter" "from" "it"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_self_creature_damage_event, body:$replacement_prevent_remove_counter} */
replacement_self_damage_phrase ::= "if" replacement_self_creature_damage_event "," replacement_prevent_remove_counter "."

/* The delayed event refers to the object chosen immediately before it. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan($counter_amount)}}, Effect{result:@next, operation:CreateDelayedTrigger{event:ZoneChange{objects:AllOf([SameObject(Result{result:@prior, phase:After, index:0}), OwnedBy(All)]), from:Battlefield, to:Graveyard}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:$conjure_self_hand}]}}}] */
entry_chosen_death_instructions ::= "choose" counter_amount filter_phrase "." "when" "the" "chosen" "permanent" "is" "put" "into" "a" "graveyard" "from" "the" "battlefield" "," conjure_self_hand

/* @sem Operation::Conjure{actor:One(AbilityController), card:Named(@card_name), count:$card_count, destination:Hand(CardArrival{counters:[], states:[]})} */
conjure_self_hand ::= "conjure" card_count "named" SELF_NAME "into" "your" "hand"

/* The death event and the reflexive body remain independently composable. */
/* @sem Ability::Replacement{active:Battlefield, event:$opponent_death_event, body:Program{instructions:[Effect{result:@mark, operation:Move{objects:One(EventSubject), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:$death_exile_callback})}]}} */
replacement_opponent_death_exile_callback ::= "if" opponent_death_event "," "exile" "it" "instead" "." "when" "you" "do" "," death_exile_callback

opponent_death_event ::= opponent_death_event_plain | opponent_death_event_nontoken

/* @sem ReplacementEvent::ZoneChange{objects:AllOf([$noun, ControlledBy(OpponentsOf(AbilityController))]), from:Battlefield, to:Graveyard} */
opponent_death_event_plain ::= "a" noun "an" "opponent" "controls" "would" "die"

/* @sem ReplacementEvent::ZoneChange{objects:AllOf([Not(Token), $noun, ControlledBy(OpponentsOf(AbilityController))]), from:Battlefield, to:Graveyard} */
opponent_death_event_nontoken ::= "a" "nontoken" noun "an" "opponent" "controls" "would" "die"

death_exile_callback ::= death_exile_callback_plain | death_exile_callback_paid_quoted

/* @sem Program::Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(AbilityController), $create_base)}]} */
death_exile_callback_plain ::= create_base "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(AbilityController), $create_base_quoted)}]}, otherwise:Program{}}]} */
death_exile_callback_paid_quoted ::= "you" "may" payment "." "if" "you" "do" "," create_base_quoted
