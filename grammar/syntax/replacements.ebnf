entry_discard_keyword_first_haste ::= "it" "enters" "with" "a" "haste" "counter" "on" "it" "if" "a" "card" "discarded" "this" "way" "has" "haste"

/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:HasKeyword(Indestructible)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:Named(IndestructibleCounter), amount:Constant(1)})}}]}, otherwise:Program{}} */
entry_discard_keyword_first_indestructible ::= "it" "enters" "with" "a" "indestructible" "counter" "on" "it" "if" "a" "card" "discarded" "this" "way" "has" "indestructible"

/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:HasKeyword(Lifelink)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:Named(LifelinkCounter), amount:Constant(1)})}}]}, otherwise:Program{}} */
entry_discard_keyword_first_lifelink ::= "it" "enters" "with" "a" "lifelink" "counter" "on" "it" "if" "a" "card" "discarded" "this" "way" "has" "lifelink"

/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:HasKeyword(Menace)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:Named(MenaceCounter), amount:Constant(1)})}}]}, otherwise:Program{}} */
entry_discard_keyword_first_menace ::= "it" "enters" "with" "a" "menace" "counter" "on" "it" "if" "a" "card" "discarded" "this" "way" "has" "menace"

/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:HasKeyword(Reach)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:Named(ReachCounter), amount:Constant(1)})}}]}, otherwise:Program{}} */
entry_discard_keyword_first_reach ::= "it" "enters" "with" "a" "reach" "counter" "on" "it" "if" "a" "card" "discarded" "this" "way" "has" "reach"

/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:HasKeyword(Trample)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:Named(TrampleCounter), amount:Constant(1)})}}]}, otherwise:Program{}} */
entry_discard_keyword_first_trample ::= "it" "enters" "with" "a" "trample" "counter" "on" "it" "if" "a" "card" "discarded" "this" "way" "has" "trample"

/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:HasKeyword(Vigilance)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:Named(VigilanceCounter), amount:Constant(1)})}}]}, otherwise:Program{}} */
entry_discard_keyword_first_vigilance ::= "it" "enters" "with" "a" "vigilance" "counter" "on" "it" "if" "a" "card" "discarded" "this" "way" "has" "vigilance"

/* The repeated choice applies to the same event player set. */
/* @sem Ability::VillainousChoiceTwice($transform_player_choice) */
villainous_choice_repeat ::= "if" transform_player_choice "would" "face" "a" "villainous" "choice" "," "they" "face" "that" "choice" "an" "additional" "time" "."

/* An entry choice composes with its optional payment, preserving its receipt. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:$entry_choice_body}) */
entry_choice_ability ::= "as" object_ref "enters" "," entry_choice_body "."

entry_choice_body ::= entry_choice_single | entry_choice_with_payment | entry_choice_optional

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$entry_choice_operation}]} */
entry_choice_single ::= entry_choice_operation

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$entry_choice_operation}, Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$cost, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}]}, otherwise:Program{}}]} */
entry_choice_with_payment ::= entry_choice_operation "." "then" "you" "may" cost "." "if" "you" "don't" "," "it" "enters" "tapped"

entry_choice_operation ::= entry_opponent_creature_choice | choose_basic_land_type | entry_card_type_except_pair | entry_choose_permanent

/* @sem Operation::ChooseValue{choosers:One(OneOf(OpponentsOf(AbilityController))), kind:CreatureType, terms:_{count:Exactly(Constant(1)), options:[]}} */
entry_opponent_creature_choice ::= "an" "opponent" "chooses" "a" "creature" "type"

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:CardType, terms:_{except:[$choice_card_type, $choice_card_type_2], count:Exactly(Constant(1))}} */
entry_card_type_except_pair ::= "choose" "a" "card" "type" "other" "than" choice_card_type "or" choice_card_type

/* Damage replacements remain independent of the condition that activates them. */
/* @sem Ability::Replacement{active:Battlefield, event:Damage(_{source_kind:Any, sources:ControlledBy(One(AbilityController)), recipients:ObjectsAndPlayers{objects:$filter_phrase, players:All}, kind:Any, grouping:SourceRecipient, subject:Recipient}), body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([Constant(2), EventAmount]))}}]}} */
replacement_controlled_source_double ::= "if" "a" "source" "you" "control" "would" "deal" "damage" "to" "a" filter_phrase "or" "player" "," "it" "deals" "double" "that" "damage" "to" "that" "permanent" "or" "player" "instead" "."

/* @sem Ability::Replacement{active:Battlefield, event:Damage(_{source_kind:Permanent, sources:$filter_plural, recipients:Players(One(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Recipient}), body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage(Objects($affected))}}]}} */
replacement_redirect_filtered_damage ::= "all" "damage" "that" "would" "be" "dealt" "to" "you" "by" filter_plural "is" "dealt" "to" affected "instead" "."

/* @sem Ability::Replacement{active:Battlefield, event:$unblocked_combat_damage_to_you, body:$redirect_affected_body} */
replacement_redirect_unblocked_combat ::= "all" unblocked_combat_damage_to_you redirect_affected_body "."

/* @sem Ability::Replacement{active:Battlefield, event:Damage(_{source_kind:Any, sources:Any, recipients:Players(One(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Recipient}), body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:DamageAsInfect}}]}} */
replacement_controller_infect ::= "all" "damage" "is" "dealt" "to" "you" "as" "though" "its" "source" "had" "infect" "."

/* @sem Ability::Replacement{active:Battlefield, event:Damage(_{source_kind:Permanent, sources:SameObject($object_ref), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Recipient}), body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
replacement_prevent_from_object ::= "prevent" "all" "damage" "that" "would" "be" "dealt" "by" object_ref "."

/* The pronoun tests the subject of the static clause; the other arm retains its own source. */
/* @sem Ability::Conditional{condition:ObjectMatches{object:$object_ref, filter:$filter_phrase}, then:[Static(_{kind:Ordinary, affected:Objects(One($object_ref)), changes:$static_changes})], otherwise:[$replacement_prevent_from_object]} */
conditional_object_static_otherwise_prevent ::= object_ref static_changes "as" "long" "as" "it's" "an" filter_phrase "." "otherwise" "," replacement_prevent_from_object

/* The two wordings refer to the resolving source choice. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:SameObject(Result{result:@marked, phase:Before, index:0}), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:NextOccurrence, duration:$this_duration, body:$temporary_damage_change} */
chosen_flip_source_scaled ::= "the" "next" "time" "that" "source" "would" "deal" "damage" this_duration "," temporary_damage_change

/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:SameObject(Result{result:@marked, phase:Before, index:0}), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:NextOccurrence, duration:$this_duration, body:$prevented_body_plain} */
chosen_flip_source_prevent ::= "the" "next" "time" "it" "would" "deal" "damage" this_duration "," prevented_body_plain

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:ReplaceTokens{copies:2}}}]} */
replacement_token_double_outcome ::= "twice" "that" "many" "of" "those" "tokens" "are" "created" "instead"

temporary_token_event ::= owned_token_event | replacement_filtered_token_event

temporary_token_outcome ::= replacement_token_double_outcome | replacement_token_triple_outcome | replacement_extra_token_outcome

/* @sem Operation::CreateReplacement{event:$temporary_token_event, limit:UntilExpired, duration:$duration, body:$temporary_token_outcome} */
temporary_token_replacement ::= duration "," "if" temporary_token_event "," temporary_token_outcome

/* An attached source and the recipient scope remain independent operands. */
/* @sem ReplacementEvent::Damage(_{source_kind:Permanent, sources:SameObject($attached_ref), recipients:Any, kind:$event_damage_kind, grouping:SourceRecipient, subject:Recipient}) */
attached_damage_event ::= attached_ref "would" "deal" event_damage_kind

/* @sem ReplacementEvent::Damage(_{source_kind:Permanent, sources:SameObject($attached_ref), recipients:ObjectsAndPlayers{objects:$filter_phrase, players:All}, kind:$event_damage_kind, grouping:SourceRecipient, subject:Recipient}) */
attached_damage_event_to ::= attached_ref "would" "deal" event_damage_kind "to" "a" filter_phrase "or" "player"

/* The optional choice owns the selected object's receipt used by the copy.
   The event amount remains the amount of the original creation event. */
/* @sem Ability::Conditional{condition:PlayerIsActive(AbilityController), then:[Replacement{active:Battlefield, event:$first_created_tokens_your_turn, body:$optional_chosen_copy_replacement}]} */
conditional_first_created_token_copy ::= first_created_tokens_your_turn "," optional_chosen_copy_replacement "."

/* @sem ReplacementEvent::FirstEachTurn(Tokens{tokens:Any, creators:One(AbilityController)}) */
first_created_tokens_your_turn ::= "the" "first" "time" "you" "would" "create" "one" "or" "more" "tokens" "during" "each" "of" "your" "turns"

optional_chosen_copy_replacement ::= optional_chosen_creature_copy | optional_chosen_permanent_copy

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$chosen_copy_creature_filter}, count:AsManyAsCan(Constant(1))}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:ReplaceTokens{copies:0, tokens:[_{amount:EventAmount, words:CreatingEffect, recipe:Copy{object:Result{result:@prior, phase:After, index:0}, exceptions:[]}}]}}}]}, otherwise:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:ReplaceTokens{copies:1}}}]}}]} */
optional_chosen_creature_copy ::= "you" "may" "instead" "choose" "a" chosen_copy_creature_filter "and" "create" "that" "many" "tokens" "that" "are" "copies" "of" "that" "creature"

chosen_copy_creature_filter ::= noun_creature | enchanted_creature_modified

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan(Constant(1))}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:ReplaceTokens{copies:0, tokens:[_{amount:EventAmount, words:CreatingEffect, recipe:Copy{object:Result{result:@prior, phase:After, index:0}, exceptions:[]}}]}}}]}, otherwise:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:ReplaceTokens{copies:1}}}]}}]} */
optional_chosen_permanent_copy ::= "you" "may" "instead" "choose" "a" filter_phrase "and" "create" "that" "many" "tokens" "that" "are" "copies" "of" "that" "permanent"

/* The callback reads the immediately preceding prevention receipt. */
/* @sem Ability::Replacement{active:Battlefield, event:$prevention_followup_event, body:Program{instructions:[Effect{result:@mark, operation:ModifyEvent{change:PreventDamage}}, $prevention_reflexive_callback]}} */
replacement_prevention_reflexive ::= "if" prevention_followup_event "," "prevent" "that" "damage" "." prevention_reflexive_callback "."

/* @sem Instruction::Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:$prevention_damage_recipients, amount:Performed(@marked), preventable:true}}]}})} */
prevention_reflexive_callback ::= "when" "damage" "is" "prevented" "this" "way" "," self_explicit_ref "deals" "that" "much" "damage" "to" prevention_damage_recipients

prevention_damage_recipients ::= self_damage_other_target | prevention_count_other_targets | recipients

/* @sem Recipients::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly($number), filter:Not(SameObject(Source))})) */
prevention_count_other_targets ::= number "other" "targets"

/* The event amount remains in scope for both independent follow-up actions. */
/* @sem Ability::Replacement{active:Battlefield, event:$damage_dealt_event, body:$damage_prevent_followups} */
/* @prefer always */
replacement_dealt_prevent_followups ::= "if" damage_dealt_event "," damage_prevent_followups "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, Effect{result:@next, operation:$damage_event_remove_counters}, Effect{result:@next, operation:$damage_event_create_tokens}]} */
/* @prefer always */
damage_prevent_followups ::= "prevent" "that" "damage" "," damage_event_remove_counters "," "and" damage_event_create_tokens

/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:Count(Exactly(EventAmount))}]} */
/* @prefer always */
damage_event_remove_counters ::= "remove" "that" "many" counter_kind "counters" "from" affected

/* @sem Operation::CreateTokens{players:One(AbilityController), tokens:[_{amount:EventAmount, words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
/* @prefer always */
damage_event_create_tokens ::= "create" "that" "many" token_recipe

/* The anaphor repeats the recipient's filter; the receipt belongs to the
   prevention in this same replacement program. */
/* @sem Ability::Replacement{active:Battlefield, event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(@agree(@and(ObjectFilter::Not(ObjectFilter::SameObject(Source)), $filter_phrase, ObjectFilter::ControlledBy(One(AbilityController))), @and(ObjectFilter::Not(ObjectFilter::SameObject(Source)), $filter_phrase_2, ObjectFilter::ControlledBy(One(AbilityController))))), kind:Any, grouping:SourceRecipient, subject:Recipient}), body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(EventSubject)), kind:$counter_kind, amount:Performed(@prior)}]}}]}} */
replacement_prevent_recipient_counters ::= "if" "damage" "would" "be" "dealt" "to" "another" filter_phrase "you" "control" "," "prevent" "that" "damage" "." "put" "a" counter_kind "counter" "on" "that" filter_phrase "for" "each" "1" "damage" "prevented" "this" "way" "."

/* A parity-qualified source event can also feed other damage replacements. */
/* @sem ReplacementEvent::Damage(_{source_kind:Any, sources:$source_yours_mana_parity, recipients:ObjectsAndPlayers{objects:$filter_phrase, players:All}, kind:Any, grouping:SourceRecipient, subject:Recipient}) */
parity_source_damage_event ::= source_yours_mana_parity "would" "deal" "damage" "to" "a" filter_phrase "or" "player"

/* Keep the explicit recipient wording as the default for this event form. */
/* @prefer always */
/* @sem Ability::Replacement{active:Battlefield, event:$parity_source_damage_event, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([$damage_factor, EventAmount]))}}]}} */
replacement_parity_source_multiplier ::= "if" parity_source_damage_event "," "it" "deals" damage_factor "that" "damage" "to" "that" "permanent" "or" "player" "instead" "."

/* A parity restriction applies to the controlled damage source itself. */
/* @sem ObjectFilter::AllOf([ControlledBy(One(AbilityController)), Property{property:ManaValue, test:$number_parity}]) */
source_yours_mana_parity ::= "a" "source" "you" "control" "with" "an" number_parity "mana" "value"

/* The player tapping and the source of the produced mana are independent
   operands of the event; the outcome retains the event's mana type. */
/* tapped_mana_permanent is shared as chosen_permanent_card_filter. */

tapped_mana_source ::= chosen_permanent_card_filter | noun_artifact | noun_creature | noun_enchantment | noun_land | noun_planeswalker | noun_battle

/* @sem ReplacementEvent::ProduceMana{sources:$tapped_mana_source, by:AbilityController} */
you_tap_for_mana_event ::= "you" "tap" "a" tapped_mana_source "for" "mana"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([Constant(2), EventAmount]))}}]} */
mana_twice_outcome ::= "it" "produces" "twice" "as" "much" "of" "that" "mana" "instead"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([$value, EventAmount]))}}]} */
mana_value_multiple_outcome ::= "it" "produces" value "times" "as" "much" "of" "that" "mana" "instead"

mana_scaled_outcome ::= mana_twice_outcome | mana_value_multiple_outcome

/* @sem Ability::Replacement{active:Battlefield, event:$you_tap_for_mana_event, body:$mana_scaled_outcome} */
you_tap_mana_replacement ::= "if" you_tap_for_mana_event "," mana_scaled_outcome "."

/* The spell filter belongs to the copy event, while the additional copy's
   retargeting permission belongs to its replacement outcome. */
/* @sem ReplacementEvent::CopySpell{players:One(AbilityController), spells:$spell_filter} */
you_copy_spell_event ::= "you" "would" "copy" spell_filter "one" "or" "more" "times"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCopy{new_targets:true}}}]} */
additional_spell_copy_outcome ::= "instead" "copy" "it" "that" "many" "times" "plus" "an" "additional" "time" "." "you" "may" "choose" "new" "targets" "for" "the" "additional" "copy"

/* @sem Ability::Replacement{active:Battlefield, event:$you_copy_spell_event, body:$additional_spell_copy_outcome} */
you_copy_spell_replacement ::= "if" you_copy_spell_event "," additional_spell_copy_outcome "."

/* @sem ReplacementEvent::Damage(_{source_kind:Spell, sources:ControlledBy(One(AbilityController)), recipients:$replacement_damage_to, kind:Any, grouping:SourceRecipient, subject:Recipient}) */
controlled_spell_damage_event ::= "a" "spell" "you" "control" "would" "deal" "damage" "to" replacement_damage_to

/* The prevention and its token count share the same immediate receipt. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Performed(@prior), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
prevention_followup_token ::= "." "create" "a" token_recipe "for" "each" "1" "damage" "prevented" "this" "way"

/* Replacement events and their event-bound outcomes are shared independently. */
/* @prefer always */
/* @sem ReplacementEvent::Tokens{tokens:Any, controllers:One(AbilityController), effect_only:true} */
replacement_effect_creates_controlled_tokens ::= "an" "effect" "would" "create" "one" "or" "more" "tokens" "under" "your" "control"

/* @sem ReplacementEvent::Tokens{tokens:Any, effect_only:true} */
replacement_effect_creates_any_tokens ::= "an" "effect" "would" "create" "one" "or" "more" "tokens"

/* @sem EventChange::ReplaceTokens{copies:3} */
replacement_thrice_created_tokens ::= "it" "creates" "three" "times" "that" "many" "of" "those" "tokens"

/* @sem EventChange::ReplaceTokens{copies:4} */
replacement_fourfold_created_tokens ::= "it" "creates" "four" "times" "that" "many" "of" "those" "tokens"

replacement_effect_token_outcome ::= replacement_twice_created_tokens | replacement_thrice_created_tokens | replacement_fourfold_created_tokens

/* Discard event and optional destination remain independently editable; both
   phrases refer to the same pending discard event. */
/* @sem Ability::Replacement{active:Battlefield, event:$discard_optional_event, body:$discard_optional_destination_body} */
discard_optional_destination_replacement ::= "if" discard_optional_event "," discard_optional_destination_body "."

discard_optional_event ::= discard_replacement_event | discard_any_replacement_event

/* @sem ReplacementEvent::Discard{players:One(AbilityController)} */
discard_any_replacement_event ::= "you" "would" "discard" "a" "card"

/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:$discard_optional_destination}}]}}]} */
discard_optional_destination_body ::= "discard" "it" "," "but" "you" "may" discard_optional_destination "instead" "of" "into" "your" "graveyard"

discard_optional_destination ::= discard_destination_library | discard_destination_library_bottom

/* @sem EventChange::SetDestination(OwnersLibraryBottom) */
discard_destination_library_bottom ::= "put" "it" "on" "the" "bottom" "of" "your" "library"

/* The source filter and damage kind remain operands of the replaced event. */
/* @sem ReplacementEvent::Damage(_{source_kind:Permanent, sources:AllOf([$subtype, ControlledBy(One(AbilityController))]), recipients:Players(All), kind:$event_damage_kind, grouping:SourceRecipient, subject:Recipient}) */
controlled_subtype_damage_player_event ::= "a" subtype "you" "control" "would" "deal" event_damage_kind "to" "a" "player"

/* The event recipient mills exactly the amount of the replaced damage. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:Mill{players:One(EventSubject), amount:EventAmount}}]} */
damage_recipient_mills_instead ::= "instead" "that" "player" "mills" "that" "many" "cards"

/* @sem Ability::Replacement{active:Battlefield, event:$controlled_subtype_damage_player_event, body:$damage_recipient_mills_instead} */
replacement_controlled_subtype_damage_mill ::= "if" controlled_subtype_damage_player_event "," damage_recipient_mills_instead "."

/* An entering object's controller may choose tapped entry for a consequence. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:Program{instructions:[Effect{result:@next, operation:$entry_tapped_choice_consequence}]}, otherwise:Program{}}]}}) */
entry_tapped_choice_ability ::= "you" "may" "have" object_ref "enter" "tapped" "." "if" "you" "do" "," entry_tapped_choice_consequence "."

entry_tapped_choice_consequence ::= recipients_get_counters | you_gain_life

/* A bounded exile choice and its counter consequence share one program so the
   arrival count is tied to this particular move to exile. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:AnyZone(AllOf([$filter_phrase, InZone(Players{zone:Graveyard, players:One(AbilityController)})])), count:UpTo($number), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
entry_exile_up_to_own_cards ::= "exile" "up" "to" number filter_phrase "cards" "from" "your" "graveyard"

/* @sem Instruction::Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:Multiply($value, CountObjects(Matching{objects:Transition{result:@prior, phase:After}, filter:AllOf([$filter_phrase, InZone(Shared(Exile))])}))})}} */
entry_counters_per_exile_arrival ::= "it" "enters" "with" value counter_kind "counters" "on" "it" "for" "each" filter_phrase "card" "exiled" "this" "way"

/* @sem Program::_{instructions:[...$entry_exile_up_to_own_cards, $entry_counters_per_exile_arrival]} */
entry_exile_up_to_counter_program ::= entry_exile_up_to_own_cards "." entry_counters_per_exile_arrival

/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:$entry_exile_up_to_counter_program}) */
entry_exile_up_to_counter_ability ::= "as" object_ref "enters" "," entry_exile_up_to_counter_program "."

/* Completion tests and counter quantities both consume this exile move's
   recorded arrivals, not a later live query or an unrelated transition. */
/* @sem BattlefieldState::CountersOfChoice{kinds:[PowerToughness([2, 0]), $counter_kind, PowerToughness([0, 2])], amount:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:AllOf([CardType(Creature), InZone(Shared(Exile))])})} */
entry_exile_creature_counter_choices ::= "for" "each" "creature" "card" "exiled" "this" "way" "," "this" "creature" "enters" "with" "a" "+" "2" "/" "+" "0" "," counter_kind "," "or" "+" "0" "/" "+" "2" "counter" "on" "it"

/* @sem Program::_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, count:AsManyAsCan($number), constraints:[]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:InZone(Shared(Exile))}), test:NumberTest::Compare{comparison:Equal, value:$number}}, then:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Entry($entry_exile_creature_counter_choices)}}]}, otherwise:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(OwnersGraveyard)}}]}}]} */
entry_exile_required_counter_program ::= "exile" number filter_phrase "cards" "from" "your" "graveyard" "." "if" "you" "can't" "," "put" "this" "creature" "into" "its" "owner's" "graveyard" "instead" "of" "onto" "the" "battlefield" "." entry_exile_creature_counter_choices

/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:$entry_exile_required_counter_program}) */
entry_exile_required_counter_ability ::= "as" object_ref "enters" "," entry_exile_required_counter_program "."

/* @sem ReplacementEvent::Player{event:GainLife, players:$replacement_event_player} */
replacement_any_gain_life_event ::= replacement_event_player "would" "gain" "life"

/* GainLifeByEffect includes the causing spell or ability's controller. */
/* @sem ReplacementEvent::Player{event:GainLifeByEffect, players:All} */
replacement_controller_effect_gain_life_event ::= "a" "spell" "or" "ability" "would" "cause" "its" "controller" "to" "gain" "life"

replacement_life_loss ::= replacement_event_player_loses_life | replacement_you_lose_life

/* @sem Operation::LoseLife{players:One(EventSubject), amount:EventAmount} */
replacement_event_player_loses_life ::= "that" "player" "loses" "that" "much" "life"

/* @sem Operation::LoseLife{players:One(AbilityController), amount:EventAmount} */
replacement_you_lose_life ::= "you" "lose" "that" "much" "life"

/* The single discarded card is the kicker payment, and the following entry
   clause is conditional on that same kicker. Keep both sides in one scope. */
/* @sem Ability::[$kicker_discard_header, $kicked_discard_entry] */
line_kicker_discard_entry ::= kicker_discard_header NEWLINE kicked_discard_entry

kicker_discard_header ::= kicker_discard_plain | kicker_discard_reminded
/* @sem Ability::Mechanic{mechanic:Kicker, cost:$kicker_discard_payment} */
kicker_discard_plain ::= kicker_discard_payment
/* @sem Ability::WithPresentation{reminder:true, ability:Mechanic{mechanic:Kicker, cost:Cost::@agree($kicker_discard_payment, $kicker_mixed_cost_note)}} */
kicker_discard_reminded ::= kicker_discard_payment kicker_mixed_cost_note
/* @sem Cost::Cost{parts:[$cost_mana, $discard_one_receipt_cost]} */
kicker_discard_payment ::= "kicker" ("―" | "—") cost_mana "," "↑" discard_one_receipt_cost "."

/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject(Source)}, body:Program{instructions:[If{condition:$condition_kicked, then:Program{instructions:$kicked_discard_entry_changes}, otherwise:Program{}}]}}) */
kicked_discard_entry ::= "if" condition_kicked "," "it" "enters" "with" kicked_discard_entry_changes "."

/* The keyword and counter kind are independent entry modifications. */
/* @sem Instruction::[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:Earlier{what:Discarded, measure:Of(ManaValue)}})}}, Effect{result:@next, operation:ModifyEvent{change:Entry(Changes([GrantKeyword($keyword_value)]))}}] */
kicked_discard_entry_changes ::= keyword_value "and" "with" "X" counter_kind "counters" "on" "it" "," "where" "X" "is" "the" "discarded" "card's" "mana" "value"

/* The attacking target is both the source of the prospective damage and the
   recipient of the redirected event. This clause is scoped to an activation
   with a single announced target. */
/* @sem ReplacementEvent::Damage(_{source_kind:Permanent, sources:SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Attacking, $noun])}), index:0}), recipients:Objects(SameObject(Source)), kind:Combat, grouping:SourceRecipient, subject:Recipient}) */
next_attacker_damage_to_source_event ::= "target" "attacking" noun "would" "deal" "combat" "damage" "to" "this" "creature"

/* @sem Operation::CreateReplacement{event:$next_attacker_damage_to_source_event, limit:NextOccurrence, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage(Objects(One(Target{slot:0, index:0})))}}]}} */
next_attacker_damage_redirect ::= "the" "next" "time" next_attacker_damage_to_source_event this_duration "," "that" "creature" "deals" "that" "damage" "to" "itself" "instead"

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$next_attacker_damage_redirect}]}} */
activated_next_attacker_damage_redirect ::= cost ":" next_attacker_damage_redirect "."

/* The event, condition, and outcome retain independent counter operands. */
/* @sem ReplacementEvent::Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject(Source)), kind:Any, grouping:SourceRecipient, subject:Recipient}) */
replacement_damage_to_this_creature ::= "damage" "would" "be" "dealt" "to" "this" "creature"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One(EventSubject)), kind:$counter_kind, amount:Count(Exactly(EventAmount))}]}}]} */
replacement_prevent_remove_event_amount ::= "prevent" "that" "damage" "and" "remove" "that" "many" counter_kind "counters" "from" "this" "creature"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One(EventSubject)), kind:$counter_kind, amount:Count(Exactly($counter_a))}]}}]} */
replacement_prevent_remove_holder_counter ::= "prevent" "that" "damage" "and" "remove" counter_a counter_kind "counter" "from" "this" "creature"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One(EventSubject)), kind:$counter_kind, amount:Count(Exactly($number_words))}]}}]} */
replacement_prevent_remove_holder_counters ::= "prevent" "that" "damage" "and" "remove" number_words counter_kind "counters" "from" "this" "creature"

replacement_prevent_remove_holder ::= replacement_prevent_remove_event_amount | replacement_prevent_remove_holder_counter | replacement_prevent_remove_holder_counters

/* @sem Ability::Conditional{condition:$damage_holder_has_counter, then:[Replacement{active:Battlefield, event:$replacement_damage_to_this_creature, body:$replacement_prevent_remove_holder}]} */
replacement_damage_while_holder_counter ::= "if" replacement_damage_to_this_creature "while" damage_holder_has_counter "," replacement_prevent_remove_holder "."

/* A damage event to the named holder supplies the antecedent for both the
   while-condition and the prevention follow-up. */
/* @sem Condition::ObjectMatches{object:Source, filter:Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})} */
damage_holder_has_counter ::= "it" "has" "a" counter_kind "counter" "on" "it"

damage_holder_while_condition ::= condition_monarch | damage_holder_has_counter

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(One(Source)), kind:$counter_kind, amount:EventAmount}]} */
damage_holder_put_counters ::= "put" "that" "many" counter_kind "counters" "on" "it"

/* @sem Operation::RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One(EventSubject)), kind:$counter_kind, amount:Count(Exactly(EventAmount))}]} */
damage_holder_remove_counters ::= "remove" "that" "many" counter_kind "counters" "from" "it"

damage_holder_counter_followup ::= damage_holder_put_counters | damage_holder_remove_counters

/* @sem Ability::Conditional{condition:$damage_holder_while_condition, then:[Replacement{active:Battlefield, event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject($self_ref_named)), kind:Any, grouping:SourceRecipient, subject:Recipient}), body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, Effect{result:@next, operation:$damage_holder_counter_followup}]}}]} */
damage_holder_while_prevent ::= "if" "damage" "would" "be" "dealt" "to" self_ref_named "while" damage_holder_while_condition "," "prevent" "that" "damage" "and" damage_holder_counter_followup "."

prevention_chosen_sources ::= next_chosen_sources | prevention_activation_color_source

/* @sem ObjectFilter::SharesColorWithMana(SpentOnActivation) */
prevention_activation_color_source ::= "source" "of" "your" "choice" "that" "shares" "a" "color" "with" "the" "mana" "spent" "on" "this" "activation" "cost"

/* A single prevention instruction can be the body of an activated ability. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:$instructions_prevent_chosen_source}} */
activated_prevent_chosen_source ::= cost ":" instructions_prevent_chosen_source "."

/* The resolving choice and replacement share the chosen source receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:DamageSources($next_chosen_sources), count:Exactly($counter_amount)}}, Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Any, sources:SameObject(Result{result:@prior, phase:Before, index:0}), recipients:$next_chosen_to, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:TotalDamage($value), duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}}}] */
clause_prevent_chosen_amount ::= "prevent" "the" "next" value "damage" "that" "would" "be" "dealt" next_chosen_to this_duration "by" counter_amount next_chosen_sources

/* Articles are tied to the noun they describe for inverse printing. */
replacement_revealed_card_kind ::= replacement_revealed_a_kind | replacement_revealed_an_kind

/* @sem $replacement_a_kind */
replacement_revealed_a_kind ::= "a" replacement_a_kind

replacement_a_kind ::= noun_creature | noun_land | noun_planeswalker | noun_permanent | noun_room | noun_token | noun_battle | noun_commander | noun_wall_folded

/* @sem $replacement_an_kind */
replacement_revealed_an_kind ::= "an" replacement_an_kind

replacement_an_kind ::= noun_artifact | noun_enchantment | noun_outlaw | noun_equipped

/* Untapping and removing counters retain independent counter kinds. */
/* @sem ReplacementEvent::Object{event:UntapsInUntapStep, objects:Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)})} */
replacement_countered_untap_event ::= "a" "permanent" "with" "a" counter_kind "counter" "on" "it" "would" "untap" "during" "its" "controller's" "untap" "step"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One(EventSubject)), kind:$counter_kind, amount:All}]}}]} */
replacement_remove_event_counters ::= "remove" "all" counter_kind "counters" "from" "it" "instead"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_countered_untap_event, body:$replacement_remove_event_counters} */
replacement_countered_untap ::= "if" replacement_countered_untap_event "," replacement_remove_event_counters "."

/* Prevention composes a damage kind and the kinds of spells dealing it. */
/* @sem ObjectFilter::AnyOf(@unordered([$spell_adjective, $spell_adjective_2])) */
prevention_spell_kinds ::= spell_adjective "and" spell_adjective

/* @sem ReplacementEvent::Damage(_{source_kind:Spell, sources:$prevention_spell_kinds, recipients:Any, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}) */
prevention_by_spell_kinds_event ::= prevent_damage "that" "would" "be" "dealt" "by" prevention_spell_kinds "spells"

/* @sem Ability::Replacement{active:Battlefield, event:$prevention_by_spell_kinds_event, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevention_by_spell_kinds ::= "prevent" "all" prevention_by_spell_kinds_event "."

/* The first eligible draw event composes independently with its replacement action. */
/* @sem ReplacementEvent::FirstEachTurn(Player{event:DrawExceptFirstInDrawStep, players:One(AbilityController)}) */
first_extra_draw_each_turn ::= "the" "first" "time" "you" "would" "draw" "a" "card" "each" "turn" "except" "the" "first" "card" "you" "draw" "during" "each" "of" "your" "draw" "steps"

/* @sem Ability::Replacement{active:Battlefield, event:$first_extra_draw_each_turn, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:$operation}]}} */
first_extra_draw_replacement ::= first_extra_draw_each_turn "," operation "instead" "."

/* A per-token event and the replacement's independently specified token groups. */
/* @sem ReplacementEvent::Tokens{tokens:$filter_phrase, creators:One(AbilityController), each:true} */
replacement_each_created_event ::= "you" "would" "create" "a" filter_phrase "token"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:ReplaceTokens{copies:0, tokens:$token_groups}}}]} */
replacement_create_token_groups ::= "instead" "create" token_groups

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_each_created_event, body:$replacement_create_token_groups} */
replacement_each_created_tokens ::= "if" replacement_each_created_event "," replacement_create_token_groups "."

/* Conditional entry changes compose with the same entering subject and controller. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:Program{instructions:[If{condition:$condition, then:$entry_population_counter_modification, otherwise:Program{}}]}}) */
entry_conditional_population_change ::= "if" condition "," object_ref "enters" entry_population_counter_modification "."

/* One counter for each member of a current population. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:CountObjects($affected)})}}]} */
entry_population_counter_modification ::= "with" "a" counter_kind "counter" "on" "it" "for" affected

/* A single filtered population is both recipient and permanent source. */
/* @sem ReplacementEvent::Either([Damage(_{source_kind:Any, sources:Any, recipients:Objects($filter_plural), kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), Damage(_{source_kind:Permanent, sources:$filter_plural, recipients:Any, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient})]) */
prevented_population_damage ::= prevent_damage "that" "would" "be" "dealt" "to" "and" "dealt" "by" filter_plural

/* @sem Ability::Replacement{active:Battlefield, event:$prevented_population_damage, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:PreventDamage}}]}} */
replacement_prevent_population_to_and_by ::= "prevent" "all" prevented_population_damage "."

/* @sem ReplacementEvent::Damage(_{source_kind:Permanent, sources:AllOf([State(Unblocked), $filter_plural]), recipients:Players(One(AbilityController)), kind:Combat, grouping:SourceRecipient, subject:Recipient}) */
unblocked_combat_damage_to_you ::= "combat" "damage" "that" "would" "be" "dealt" "to" "you" "by" "unblocked" filter_plural

/* @sem Operation::CreateReplacement{event:$unblocked_combat_damage_to_you, limit:UntilExpired, duration:$this_duration, body:$redirect_affected_body} */
redirect_unblocked_combat_timed ::= "all" unblocked_combat_damage_to_you this_duration redirect_affected_body

/* Counter placement composes with the entering spell's convoke history. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:Multiply($value, $entry_convoke_count)})}}]} */
entry_convoked_counters ::= "with" value counter_kind "counters" "on" "it" "for" entry_convoke_count

/* @sem Expr::CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:History{event:Convoked(EventSubject), window:ThisGame}}) */
entry_convoke_count ::= "each" "creature" "that" "convoked" "it"

/* Both placements modify the same entry event. */
/* @sem Instruction::[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$value})}}, Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind_2, amount:$counter_amount})}}] */
entry_two_counter_effects ::= "with" value counter_kind "counters" "and" counter_amount counter_kind "counter" "on" "it"

/* The keyword and both counter placements modify the same entry event. */
/* @sem Instruction::[...$entry_two_counter_effects, Effect{result:@next, operation:ModifyEvent{change:Entry(Changes([GrantKeyword($keyword_value)]))}}] */
entry_two_counters_and_keyword ::= entry_two_counter_effects "and" "with" keyword_value

/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:Program{instructions:[If{condition:$condition, then:Program{instructions:$entry_two_counters_and_keyword}, otherwise:Program{}}]}}) */
conditional_entry_counters_keyword ::= "if" condition "," object_ref "enters" entry_two_counters_and_keyword "."

/* The where-clause defines the amount for this entry counter change. */
/* @sem Expr::TurnsSinceForetold */
entry_turns_since_foretold ::= "the" "number" "of" "turns" "you've" "begun" "since" "it" "was" "foretold"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$entry_turns_since_foretold})}}]} */
entry_foretold_counters ::= "with" "X" counter_kind "counters" "on" "it" "," "where" "X" "is" entry_turns_since_foretold

/* The action following this draw replacement is an ordinary operation. */
/* @sem Operation::CreateReplacement{event:Player{event:Draw, players:One(AbilityController)}, limit:NextOccurrence, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:$next_draw_leading_action}]}} */
/* @prefer always */
next_draw_replaced_leading_instead ::= "the" "next" "time" "you" "would" "draw" "a" "card" this_duration "," "instead" next_draw_leading_action

next_draw_leading_action ::= put_linked_pile_card | wish_owned_to_hand

/* A singular controlled entry population and its independent modifications. */
/* @sem ReplacementEvent::Enter{objects:AllOf([Not(SameObject(Source)), $filter_phrase, ControlledBy(One(AbilityController))])} */
singular_other_controlled_entry ::= "each" "other" filter_phrase "you" "control" "enters"

/* @sem Operation::ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$value})} */
singular_entry_additional_counted_counters ::= "with" "a" "number" "of" "additional" counter_kind "counters" "on" "it" "equal" "to" value

/* @sem Operation::ModifyEvent{change:Entry(Changes([CreatureTypes{mode:Add, types:Listed([@subtype_name($creature_subtype)])}]))} */
singular_entry_add_creature_type ::= "as" "a" creature_subtype "in" "addition" "to" "its" "other" "types"

/* @sem Ability::Replacement{active:Battlefield, event:$singular_other_controlled_entry, body:_{instructions:[Effect{result:@next, operation:$singular_entry_additional_counted_counters}, Effect{result:@next, operation:$singular_entry_add_creature_type}]}} */
controlled_entry_counters_and_type ::= singular_other_controlled_entry singular_entry_additional_counted_counters "and" singular_entry_add_creature_type "."

/* The subject of this replacement is the player enchanted by its holder. */
/* @sem Ability::Replacement{active:Battlefield, event:Player{event:LoseLife, players:One(EnchantedBy(Source))}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:LoseLife{players:One(EventSubject), amount:Multiply([$replacement_life_factor, EventAmount])}}]}} */
replacement_enchanted_life_factor ::= "if" "enchanted" "player" "would" "lose" "life" "," "they" "lose" replacement_life_factor "that" "much" "life" "instead" "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}, Effect{result:@next, operation:$operation}]} */
replacement_exile_card_and_operation ::= "instead" "exile" "that" "card" "and" operation

/* The card descriptor and the owner of its destination remain independent operands. */
/* @sem ReplacementEvent::ZoneChange{objects:AllOf([$replacement_card_descriptor, OwnedBy(One(AbilityController)), Not(Token)]), to:$enchanted_player_card_zone} */
replacement_your_card_graveyard ::= "a" replacement_card_descriptor "would" "be" "put" "into" "your" enchanted_player_card_zone "from" "anywhere"

replacement_card_descriptor ::= hand_one_any | replacement_creature_card | replacement_land_card

/* @sem ObjectFilter::$noun_creature */
replacement_creature_card ::= noun_creature "card"

/* @sem ObjectFilter::$noun_land */
replacement_land_card ::= noun_land "card"

/* The controller at the event and the graveyard's owner are independent. */
/* @prefer always */
/* @sem ReplacementEvent::ZoneChange{objects:AllOf(@unordered([$replacement_card_controller, $replacement_graveyard_owner, Not(Token)])), to:Graveyard} */
replacement_controlled_card_graveyard ::= "a" "card" replacement_card_controller "would" "be" "put" "into" replacement_graveyard_owner "graveyard" "from" "anywhere"

replacement_card_controller ::= replacement_card_not_yours | replacement_card_yours

/* @sem ObjectFilter::ControlledBy(OthersThan(AbilityController)) */
replacement_card_not_yours ::= "you" "didn't" "control"

/* @sem ObjectFilter::ControlledBy(One(AbilityController)) */
replacement_card_yours ::= "you" "controlled"

replacement_graveyard_owner ::= replacement_graveyard_opponent_owner | replacement_graveyard_your_owner

/* @sem ObjectFilter::OwnedBy(OpponentsOf(AbilityController)) */
replacement_graveyard_opponent_owner ::= "an" "opponent's"

/* @sem ObjectFilter::OwnedBy(One(AbilityController)) */
replacement_graveyard_your_owner ::= "your"

/* The creature antecedent belongs to the pending death event. */
/* @sem ReplacementEvent::ZoneChange{objects:@and($noun_creature, $death_creature_controller), from:Battlefield, to:Graveyard} */
death_creature_controlled_event ::= "a" noun_creature death_creature_controller "would" "die"

death_creature_controller ::= modifier_opponent_controls | modifier_you_control

/* The modified event records the creature used by the following property query. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}, Effect{result:@next, operation:$returned_creature_property_counters}]} */
death_exile_property_counter_outcome ::= "instead" "exile" "it" "and" returned_creature_property_counters

/* @sem Ability::Replacement{active:Battlefield, event:$death_creature_controlled_event, body:$death_exile_property_counter_outcome} */
death_creature_property_counter_replacement ::= "if" death_creature_controlled_event "," death_exile_property_counter_outcome "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$number})}}]} */
entry_many_counters_him ::= "with" number counter_kind "counters" "on" "him"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$number})}}]} */
entry_plural_counters_her ::= "with" number counter_kind "counters" "on" "her"

/* Paired colored mana counts preserve the spell and the color being counted. */
/* @sem Expr::Divide{numerator:ManaSpent{object:$spent_to_cast_object, filter:_{colors:[$paired_mana_color]}, aggregation:Count}, denominator:Constant(2), rounding:Down} */
entry_paired_mana_count ::= paired_mana_color spent_to_cast_object

paired_mana_color ::= spent_pair_white | spent_pair_blue | spent_pair_black | spent_pair_red | spent_pair_green

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters{kind:$counter_kind, amount:Multiply([$value, $entry_paired_mana_count])}}}]} */
entry_counters_per_paired_mana ::= "with" value counter_kind "counters" "on" "it" "for" "each" entry_paired_mana_count

/* Both counter clauses modify the same entering event; the alternative tests its subject. */
/* @sem Program::Program{instructions:[If{condition:ObjectMatches{object:$it_ordinary_pronoun, filter:State(Escaped)}, then:Program{instructions:[Effect{result:@next, operation:$entry_plural_counter_change_2}]}, otherwise:Program{instructions:[Effect{result:@next, operation:$entry_plural_counter_change}]}}]} */
entry_escape_counter_alternative ::= entry_plural_counter_change "." it_ordinary_pronoun "escapes" entry_plural_counter_change "instead"

/* @sem Operation::ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$value})} */
entry_plural_counter_change ::= "with" value counter_kind "counters" "on" "it"

/* A condition and a counter change compose within the entry event. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:Program{instructions:[If{condition:$condition_same_color_spent_object, then:_{instructions:[Effect{result:@next, operation:$entry_counter_change}]}, otherwise:_{}}]}}) */
entry_conditional_same_color ::= "if" condition_same_color_spent_object "," object_ref "enters" entry_counter_change "."

/* Count each qualifying opponent once, independently of how often they lost life. */
/* @sem Operation::ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:CountPlayers($players_each_opponent_lost_life)})} */
/* @prefer always */
plural_entry_counter_per_life_loss_opponent ::= "with" "an" "additional" counter_kind "counter" "on" "them" "for" players_each_opponent_lost_life

/* The replacement shares the draw event with other draw replacements. */
/* @sem Ability::Replacement{active:Battlefield, event:$draw_event, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, ...$replacement_observed_top_split]}} */
replacement_draw_observed_conditional ::= "if" draw_event "," replacement_observed_top_split "."

/* @sem ObjectFilter::$modifier_chosen_color */
source_chosen_quality ::= "a" "source" modifier_chosen_color

/* The counted population keeps its filter, controller and chosen creature type. */
/* @sem Operation::ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase, ControlledBy(One(AbilityController)), Chosen(CreatureType)])})})} */
entry_artifact_chosen_type_counter ::= "this" "artifact" "enters" "with" "a" counter_kind "counter" "on" "it" "for" "each" filter_phrase "you" "control" "of" "the" "chosen" "type"

/* An entry instruction may precede an independently specified counter modification. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:$entry_artifact_chosen_type_counter}]} */
entry_operation_chosen_type_counter_program ::= operation "." entry_artifact_chosen_type_counter

/* The counter test belongs to the recipient of this particular damage event. */
/* replacement_self_counter_condition is shared as damage_holder_has_counter. */

/* Removal and the subsequent counter count form one producer-consumer phrase. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, Effect{result:@mark, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One(EventSubject)), kind:PowerToughness([1, 1]), amount:Count(Exactly(Performed(@prior)))}]}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Players(All), kind:$counter_kind, amount:CountersRemoved(@marked)}]}}]} */
prevent_remove_give_counter ::= "prevent" "that" "damage" "," "remove" "that" "many" "+" "1" "/" "+" "1" "counters" "from" "it" "," "then" "give" "each" "player" "a" counter_kind "counter" "for" "each" "+" "1" "/" "+" "1" "counter" "removed" "this" "way"

/* The reflexive trigger observes the removal, not the prevention event. */
/* @sem Program::@reflexive(Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, Effect{result:@mark, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One(Source)), kind:$counter_kind, amount:Count(Exactly(Performed(@prior)))}]}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:$recipients, amount:EventAmount, preventable:true}}]}, announcement:@announcement})}]}) */
prevent_remove_reflexive_damage ::= "prevent" "that" "damage" "and" "remove" "that" "many" counter_kind "counters" "from" "it" "." "when" "one" "or" "more" "counters" "are" "removed" "from" "this" "creature" "this" "way" "," "it" "deals" "that" "much" "damage" "to" recipients

replacement_self_counter_body ::= prevent_remove_give_counter | prevent_remove_reflexive_damage

/* @sem Ability::Conditional{condition:$damage_holder_has_counter, then:[Replacement{active:Battlefield, event:$replacement_damage_to_this_creature, body:$replacement_self_counter_body}]} */
conditional_self_counter_prevention ::= "if" replacement_damage_to_this_creature "while" damage_holder_has_counter "," replacement_self_counter_body "."

/* Prevention and the reflexive sacrifice share the same marked result. */
/* @sem Program::@reflexive(Program::Program{instructions:[Effect{result:@mark, operation:ModifyEvent{change:PreventDamage}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:$affected, choose:AsManyAsCan($counter_amount)})}]}})}]}) */
prevent_damage_reflexive_sacrifice ::= "prevent" "that" "damage" "." "when" "damage" "is" "prevented" "this" "way" "," "sacrifice" counter_amount affected

/* @sem Ability::Conditional{condition:ObjectMatches{object:$object_ref, filter:State(Equipped)}, then:[Replacement{active:Battlefield, event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject($object_ref)), kind:Any, grouping:SourceRecipient, subject:Recipient}), body:$prevent_damage_reflexive_sacrifice}]} */
conditional_equipped_damage_prevention ::= "if" "damage" "would" "be" "dealt" "to" object_ref "while" "it's" "equipped" "," prevent_damage_reflexive_sacrifice "."

/* @sem BattlefieldState::CountersOf{object:Source, one_of_each:true} */
entry_one_of_each_self_counter ::= "with" "a" "counter" "of" "that" "kind" "on" "it"

/* @sem Ability::Conditional{condition:ObjectMatches{object:$self_ref_named, filter:Counters(_{comparison:Greater, value:Constant(0)})}, then:[Replacement{active:Battlefield, event:$singular_other_controlled_entry, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Entry($entry_one_of_each_self_counter)}}]}}]} */
replacement_other_entry_each_counter_kind ::= "for" "each" "kind" "of" "counter" "on" self_ref_named "," singular_other_controlled_entry entry_one_of_each_self_counter "."

/* The repeated revealed-card filter describes the optional payment above it;
   the alternative condition is independent of that filter. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject(Source)}, body:Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Reveal{count:Exactly(Constant(1)), filter:@agree($filter_phrase, $filter_phrase_2)}]}, optional:true}}, If{condition:Not(AnyOf([PaymentChosen(@marked), $condition])), then:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}]}, otherwise:Program{}}]}}) */
entry_reveal_or_condition_tapped ::= "as" "this" "land" "enters" "," "you" "may" "reveal" "a" filter_phrase "card" "from" "your" "hand" "." "this" "land" "enters" "tapped" "unless" "you" "revealed" "a" filter_phrase "card" "this" "way" "or" condition "."

/* The original damage proceeds; the replacement adds damage from this source. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref_named, recipients:Players(One(ControllerOf(Damage(Source)))), amount:EventAmount, preventable:true}}]} */
chosen_source_retaliation_body ::= "instead" "that" "source" "deals" "that" "much" "damage" "to" "you" "and" self_ref_named "deals" "that" "much" "damage" "to" "that" "source's" "controller"

/* The continuing damage recipient and the chosen event recipient agree. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:DamageSources($next_chosen_sources), count:Exactly(Constant(1))}}, Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Any, sources:SameObject(Result{result:@prior, phase:Before, index:0}), recipients:Players(One(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:NextOccurrence, duration:$this_duration, body:$chosen_source_retaliation_body}}] */
instructions_chosen_source_retaliation ::= "the" "next" "time" "a" next_chosen_sources "would" "deal" "damage" "to" "you" this_duration "," chosen_source_retaliation_body

/* The draw subject's top card is the card revealed before the payment choice. */
/* @sem Instruction::Effect{result:@next, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(EventSubject)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}} */
draw_subject_reveal_top ::= "they" "reveal" "it" "instead"

/* The payment and both branches share the draw subject and its top card. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:FirstWilling(OthersThan(EventSubject)), cost:_{parts:[Life($number)]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(EventSubject)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:Draw{players:One(EventSubject), amount:Constant(1)}}]}}] */
draw_subject_other_pay_life ::= "then" "any" "other" "player" "may" "pay" number "life" "." "if" "a" "player" "does" "," "put" "that" "card" "into" "its" "owner's" "graveyard" "." "otherwise" "," "that" "player" "draws" "a" "card"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_player_draw_event, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, $draw_subject_reveal_top, ...$draw_subject_other_pay_life]}} */
replacement_draw_subject_reveal_payment ::= "if" replacement_player_draw_event "," draw_subject_reveal_top "." draw_subject_other_pay_life "."

/* Optional draw replacement: declining the choice performs the original draw. */
/* @sem Ability::Replacement{active:Battlefield, event:$draw_event, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, $draw_choose_kind_reveal_partition]}} */
replacement_draw_choose_reveal_partition ::= "if" draw_event "," draw_choose_kind_reveal_partition "."

/* A singular dying referent and the redirect retain the event subject's owner. */
death_redirect_ref ::= self_explicit_ref | enchanted_creature_ref | equipped_ref

/* @sem ReplacementEvent::ZoneChange{objects:SameObject($death_redirect_ref), from:Battlefield, to:Graveyard} */
death_redirect_event ::= death_redirect_ref "would" "die"

death_redirect_destination ::= death_redirect_library_top | death_redirect_library_bottom | death_redirect_owner_hand

/* @sem EventChange::SetDestination(OwnersLibraryTop) */
death_redirect_library_top ::= "put" "it" "on" "top" "of" "its" "owner's" "library"

/* @sem EventChange::SetDestination(OwnersLibraryBottom) */
death_redirect_library_bottom ::= "put" "it" "on" "the" "bottom" "of" "its" "owner's" "library"

/* @sem EventChange::SetDestination(OwnersHand) */
death_redirect_owner_hand ::= "put" "it" "into" "its" "owner's" "hand"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:$death_redirect_destination}}]} */
death_redirect_outcome ::= death_redirect_destination "instead"

/* @sem Ability::Replacement{active:Battlefield, event:$death_redirect_event, body:$death_redirect_outcome} */
death_redirect_ability ::= "if" death_redirect_event "," death_redirect_outcome "."

/* @sem Operation::ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$entry_death_count})} */
plural_entry_counter_per_controlled_death ::= "with" "an" "additional" counter_kind "counter" "on" "them" "for" "each" entry_death_count

/* The state and controller describe the object whose death is replaced. */
/* @sem ReplacementEvent::ZoneChange{objects:AllOf([$filter_phrase, ControlledBy(One(AbilityController)), State(Enchanted)]), from:Battlefield, to:Graveyard} */
replacement_enchanted_controlled_death ::= "a" filter_phrase "you" "control" "that's" "enchanted" "would" "die"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(OwnersHand)}}]} */
replacement_return_owner_hand ::= "return" "it" "to" "its" "owner's" "hand" "instead"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(OwnersLibraryTop)}}]} */
replacement_put_owner_library_top ::= "put" "it" "on" "top" "of" "its" "owner's" "library" "instead"

/* The required replacement payment and its failure branch share the same
   payment receipt; cancellation in both branches belongs to the replacement. */
/* @sem Ability::Replacement{active:Battlefield, event:$draw_event, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:$replacement_required_payment, optional:false}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, ...$conjoined]}, otherwise:Program{}}]}} */
replacement_draw_required_payment ::= "if" draw_event "," replacement_required_payment "instead" "." "if" "you" "can't" "," conjoined "."

replacement_required_payment ::= payment | replacement_return_graveyard_payment

/* @sem Cost::Cost{parts:[Move{selections:[$replacement_graveyard_selection], destination:OwnersHand(CardArrival{counters:[], states:[]})}]} */
/* @prefer always */
replacement_return_graveyard_payment ::= "return" replacement_graveyard_selection "from" "your" "graveyard" "to" "your" "hand"

/* @sem CostObjectSelection::CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}, choose:Exactly($replacement_graveyard_card_count)} */
/* @prefer always */
replacement_graveyard_selection_count ::= replacement_graveyard_card_count

/* @sem CostObjectSelection::CostObjectSelection{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$replacement_graveyard_card_filter}, choose:Exactly(Constant(1))} */
replacement_graveyard_selection_filtered ::= "a" replacement_graveyard_card_filter "card"

replacement_graveyard_selection ::= replacement_graveyard_selection_count | replacement_graveyard_selection_filtered

replacement_graveyard_card_count ::= card_count_one | card_count_many

replacement_graveyard_card_filter ::= noun_creature | noun_land | noun_planeswalker | noun_battle

/* The actor, eligible permanent population, and counter increase are independent. */
/* @sem ReplacementEvent::Counters(_{objects:$counter_replacement_population, players:All, by:One(AbilityController)}) */
replacement_your_counter_event ::= "you" "would" "put" "one" "or" "more" "counters" "on" counter_replacement_population "or" "on" "yourself"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Add([EventAmount, $number_words]))}}]} */
replacement_your_counter_bonus ::= "put" "that" "many" "plus" number_words "of" "each" "of" "those" "kinds" "of" "counters" "on" "that" "permanent" "or" "player" "instead"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_your_counter_event, body:$replacement_your_counter_bonus} */
replacement_your_counter_bonus_phrase ::= "if" replacement_your_counter_event "," replacement_your_counter_bonus "."

/* The optional draw-step replacement retains both the skipped and performed
   draw branches; the follow-up is an independently composable operation. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(AttackedOnlyBy(AllOf([$filter_plural, AnyOf([HasKeyword($keyword_value), HasKeyword($keyword_value_2)])])))], duration:$duration, evaluation:LiveObjects} */
controller_attack_exception_pair ::= duration "," "you" "can't" "be" "attacked" "except" "by" filter_plural "with" keyword_value "and" "/" "or" keyword_value

draw_skip_followup_operation ::= controller_attack_exception_pair | operation

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:ChooseAction{actor:One(AbilityController), options:[Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:$draw_skip_followup_operation}]}, Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Constant(1)}}]}]}}]} */
optional_draw_skip_followup ::= "instead" "you" "may" "skip" "that" "draw" "." "if" "you" "do" "," draw_skip_followup_operation

/* @sem Ability::Replacement{active:Battlefield, event:Player{event:DrawInDrawStep, players:One(AbilityController)}, body:$optional_draw_skip_followup} */
replacement_draw_step_optional_skip ::= "if" "you" "would" "draw" "a" "card" "during" "your" "draw" "step" "," optional_draw_skip_followup "."

/* A replacement cancels a player action before performing its stated operation. */
/* @sem Ability::Replacement{active:Battlefield, event:$replacement_you_player_action_event, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:$operation}]}} */
replacement_you_player_action_instead ::= "if" replacement_you_player_action_event "," operation "instead" "."

replacement_you_player_action_event ::= replacement_you_would_proliferate | replacement_you_would_learn

/* @sem ReplacementEvent::Player{event:Proliferate, players:One(AbilityController)} */
replacement_you_would_proliferate ::= "you" "would" "proliferate"

/* @sem ReplacementEvent::Player{event:Learn, players:One(AbilityController)} */
replacement_you_would_learn ::= "you" "would" "learn"

/* The actor, affected permanent population, and replacement amount are independent. */
/* @sem ReplacementEvent::Counters(_{objects:InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$counter_replacement_filter}), players:All, by:One(AbilityController)}) */
replacement_controller_counters_event ::= "you" "would" "put" "one" "or" "more" "counters" "on" "a" counter_replacement_filter "or" "player"

/* @sem Expr::Constant(4) */
replacement_counter_four_times ::= "four" "times"

replacement_counter_factor ::= revealed_stat_factor | entry_roll_three_times | replacement_counter_four_times

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([$replacement_counter_factor, EventAmount]))}}]} */
replacement_controller_counters_outcome ::= "put" replacement_counter_factor "that" "many" "of" "each" "of" "those" "kinds" "of" "counters" "on" "that" "permanent" "or" "player" "instead"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_controller_counters_event, body:$replacement_controller_counters_outcome} */
replacement_controller_counters_scaled ::= "if" replacement_controller_counters_event "," replacement_controller_counters_outcome "."

chosen_redirect_body ::= redirect_damage_opponent_target | chosen_redirect_affected_body | chosen_source_deals_redirect_body

/* @prefer always */
/* @sem Program::$redirect_affected_body */
chosen_redirect_affected_body ::= "that" "damage" redirect_affected_body

/* Compose the recipient, permanent source, duration and redirect body independently. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Permanent, sources:$prevent_by_permanents, recipients:$prevent_to, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:$redirect_affected_body} */
redirect_all_to_by_permanents ::= "all" prevent_damage "that" "would" "be" "dealt" "to" prevent_to this_duration "by" prevent_by_permanents redirect_affected_body

/* The event, observed split and subsequent operation remain independent operands. */
/* @sem ReplacementEvent::Player{event:Planeswalk, players:One(AbilityController)} */
replacement_you_planeswalk_event ::= "you" "would" "planeswalk"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_you_planeswalk_event, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, ...$planar_look_split, Effect{result:@next, operation:$operation}]}} */
replacement_planeswalk_planar_split ::= "if" replacement_you_planeswalk_event "," "instead" planar_look_split "," "then" operation "."

/* The entry population and the two complementary counter outcomes are reusable
   independently; the threshold is shared by both branches. */
/* @sem ReplacementEvent::Enter{objects:AllOf([Not(SameObject(Source)), AnyOf([$subtype, $noun]), ControlledBy(One(AbilityController))])} */
entry_other_controlled_pair_event ::= "each" "other" subtype "and" noun "you" "control" "enters"

/* @sem Operation::ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:Constant(1)})} */
entry_one_additional_counter ::= "with" "an" "additional" counter_kind "counter" "on" "it"

/* @sem Operation::ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$number_words})} */
entry_many_additional_counters ::= "it" "enters" "with" number_words "additional" counter_kind "counters" "on" "it"

/* @sem Program::Program{instructions:[If{condition:ObjectMatches{object:EventSubject, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}}, then:_{instructions:[Effect{result:@next, operation:$entry_one_additional_counter}]}, otherwise:_{}}, If{condition:ObjectMatches{object:EventSubject, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:Greater, value:$number}}}, then:_{instructions:[Effect{result:@next, operation:$entry_many_additional_counters}]}, otherwise:_{}}]} */
entry_mana_value_counter_branches ::= entry_one_additional_counter "if" "its" "mana" "value" "is" number "or" "less" "." "otherwise" "," entry_many_additional_counters

/* @sem Ability::Replacement{active:Battlefield, event:$entry_other_controlled_pair_event, body:$entry_mana_value_counter_branches} */
entry_other_pair_mana_counter_replacement ::= entry_other_controlled_pair_event entry_mana_value_counter_branches "."

/* @prefer always */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([$damage_factor, EventAmount]))}}]} */
temporary_damage_multiply ::= "it" "deals" damage_factor "that" "damage" "instead"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Add([EventAmount, $number]))}}]} */
temporary_damage_add ::= "it" "deals" "that" "much" "damage" "plus" number "instead"

/* A temporary multiplier over a permanent's damage to a creature. */
/* @sem ReplacementEvent::Damage(_{source_kind:Permanent, sources:$filter_phrase, recipients:Objects($replacement_creature_filter), kind:$event_damage_kind, grouping:SourceRecipient, subject:Recipient}) */
temporary_permanent_damage_to_creature ::= "a" filter_phrase "would" "deal" event_damage_kind "to" "a" replacement_creature_filter

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([$damage_factor, EventAmount]))}}]} */
temporary_creature_damage_multiplier ::= "it" "deals" damage_factor "that" "damage" "to" "that" "creature" "instead"

/* @sem Operation::CreateReplacement{event:$temporary_permanent_damage_to_creature, limit:UntilExpired, duration:$this_duration, body:$temporary_creature_damage_multiplier} */
temporary_damage_to_creature_replacement ::= "if" temporary_permanent_damage_to_creature this_duration "," temporary_creature_damage_multiplier

/* The anaphoric player is the recipient of the preceding damage event. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([$damage_factor, EventAmount]))}}]} */
damage_player_multiplier ::= "it" "deals" damage_factor "that" "damage" "to" "that" "player" "instead"

/* @sem ReplacementEvent::Damage(_{source_kind:Any, sources:ControlledBy(One(AbilityController)), recipients:Players(OpponentsOf(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Recipient}) */
controlled_source_opponent_damage ::= "a" "source" "you" "control" "would" "deal" "damage" "to" "an" "opponent"

/* @sem Operation::CreateReplacement{event:$controlled_source_opponent_damage, limit:UntilExpired, duration:$this_duration, body:$damage_player_multiplier} */
temporary_opponent_damage_multiplier ::= "if" controlled_source_opponent_damage this_duration "," damage_player_multiplier

/* The entry event supplies the subject; its optional payment response preserves
   the original entry when paid and redirects the event otherwise. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($entry_payment_artifact)}, body:$entry_optional_payment_response}) */
entry_optional_payment_redirect ::= "if" entry_payment_artifact "would" "enter" "," entry_optional_payment_response "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$cost, optional:true}}, If{condition:PaymentChosen(0), then:Program{}, otherwise:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(OwnersGraveyard)}}]}}]} */
entry_optional_payment_response ::= "you" "may" cost "instead" "." "if" "you" "do" "," "put" "this" "artifact" "onto" "the" "battlefield" "." "if" "you" "don't" "," "put" "it" "into" "its" "owner's" "graveyard"

/* @sem ObjectRef::@self */
entry_payment_artifact ::= "this" "artifact"

/* The counter amount uses this optional reveal payment's own input receipt. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[Reveal{count:AnyNumber, filter:$filter_phrase}]}, optional:true}}, If{condition:PaymentChosen(0), then:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:CountObjects(CostObjects{payment:Resolution(0), component:[0], view:Inputs, phase:Before})})}}]}, otherwise:_{}}]} */
entry_reveal_hand_counter_receipt ::= "you" "may" "reveal" "any" "number" "of" "other" filter_phrase "cards" "from" "your" "hand" "." "this" "creature" "enters" "with" "a" counter_kind "counter" "on" "it" "for" "each" "card" "revealed" "this" "way"

/* Both mentions identify the entering source creature. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject(@self)}, body:$entry_reveal_hand_counter_receipt}) */
entry_creature_reveal_counter_ability ::= "as" self_creature "enters" "," entry_reveal_hand_counter_receipt "."

/* Entry populations and entry modifications retain their separate operands. */
/* @sem ReplacementEvent::Enter{objects:AllOf([$filter_phrase, ControlledBy(One(AbilityController)), $cast_spell_has_adventure])} */
qualified_controlled_each_entry ::= "each" filter_phrase "you" "control" cast_spell_has_adventure "enters"

/* @sem Ability::Replacement{active:Battlefield, event:$qualified_controlled_each_entry, body:_{instructions:[Effect{result:@next, operation:$graveyard_entry_additional_counter}]}} */
qualified_each_entry_replacement ::= qualified_controlled_each_entry graveyard_entry_additional_counter "."

/* The replacement affects any source dealing damage to a player or a kind of permanent. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:ObjectsAndPlayers{objects:$noun, players:All}, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Add(EventAmount, $number))}}]}} */
temporary_damage_increase_player_or ::= "if" "a" "source" "would" "deal" "damage" "to" "a" "player" "or" noun this_duration "," "it" "deals" "that" "much" "damage" "plus" number "instead"

/* The event amount counts the cards taken from the controller's library. */
/* @sem ReplacementEvent::Damage(DamageEvent{source_kind:Any, sources:Any, recipients:$replacement_damage_to, kind:Combat, grouping:SourceRecipient, subject:Recipient}) */
damage_dealt_combat_event ::= "combat" "damage" "would" "be" "dealt" "to" replacement_damage_to

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:EventAmount, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
prevention_followup_exile_library ::= "and" "exile" "that" "many" "cards" "from" "the" "top" "of" "your" "library"

/* The historical entry belongs to each candidate damage source. */
/* @sem ReplacementEvent::Damage(_{source_kind:Permanent, sources:AllOf([$filter_phrase, ControlledBy(One(AbilityController)), Condition(Compare{left:EventHistory{event:ZoneChange{objects:SameObject(Candidate), to:Battlefield}, window:ThisTurn, measure:Occurrences}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})]), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Recipient}) */
controlled_entered_damage_event ::= "a" filter_phrase "you" "control" "that" "entered" "this" "turn" "would" "deal" "damage"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([Constant(2), EventAmount]))}}]} */
twice_damage_outcome ::= "it" "deals" "twice" "that" "much" "damage" "instead"

/* @sem Ability::Replacement{active:Battlefield, event:$controlled_entered_damage_event, body:$twice_damage_outcome} */
replacement_entered_damage ::= "if" controlled_entered_damage_event "," twice_damage_outcome "."

/* The repeated equipped creature is both the recipient and the excluded source. */
/* @sem ReplacementEvent::Damage(_{source_kind:Permanent, sources:AllOf([$filter_phrase, Not(SameObject(AttachedTo(Source)))]), recipients:Objects(SameObject(AttachedTo(Source))), kind:Combat, grouping:SourceRecipient, subject:Recipient}) */
other_equipped_combat_event ::= "another" filter_phrase "would" "deal" "combat" "damage" "to" "equipped" "creature"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([$damage_factor, EventAmount]))}}]} */
equipped_damage_factor_outcome ::= "it" "deals" damage_factor "that" "damage" "to" "equipped" "creature" "instead"

/* @sem Ability::Replacement{active:Battlefield, event:$other_equipped_combat_event, body:$equipped_damage_factor_outcome} */
replacement_other_equipped_combat ::= "if" other_equipped_combat_event "," equipped_damage_factor_outcome "."

/* The card type union belongs to the moving card; ownership and token status
   remain independent of its destination. */
/* @sem ObjectFilter::AnyOf([$spell_type_after_an, $spell_type_after_or]) */
replacement_card_type_union ::= spell_type_after_an "or" spell_type_after_or

/* @sem ReplacementEvent::ZoneChange{objects:AllOf([$replacement_card_type_union, OwnedBy(All), Not(Token)]), to:Graveyard} */
replacement_typed_card_graveyard ::= "an" replacement_card_type_union "card" "would" "be" "put" "into" "a" "graveyard" "from" "anywhere"

/* The counter is part of the replacement destination, not a separate action. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}, Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:Constant(1)})}}]} */
replacement_exile_card_counter_an ::= "exile" "that" "card" "with" "an" counter_kind "counter" "on" "it" "instead"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}, Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:Constant(1)})}}]} */
replacement_exile_card_counter_a ::= "exile" "that" "card" "with" "a" counter_kind "counter" "on" "it" "instead"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}, Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:@plural_amount($counter_amount)})}}]} */
replacement_exile_card_counters ::= "exile" "that" "card" "with" counter_amount counter_kind "counters" "on" "it" "instead"

/* The counter is added to the same event whose destination is changed. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}, Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:Constant(1)})}}]} */
replacement_exile_with_counter ::= "instead" "exile" "it" "with" "a" counter_kind "counter" "on" "it"

/* The entering holder chooses a different controlled permanent of the stated kind. */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(@self)), $filter_phrase, ControlledBy(One(AbilityController))])}, count:AsManyAsCan(Constant(1))} */
choose_another_controlled_permanent ::= "choose" "another" filter_phrase "you" "control"

/* @prefer always */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject(@self)}, body:Program{instructions:[Effect{result:@next, operation:$choose_another_controlled_permanent}]}}) */
entry_choose_another_controlled ::= "as" self_holder_text "enters" "," choose_another_controlled_permanent "."

/* The choice and the replacement share the exact chosen source; the body
   consumes the result of this replacement's own prevention. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:DamageSources($next_chosen_sources), count:Exactly(Constant(1))}}, Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Any, sources:SameObject(Result{result:@prior, phase:Before, index:0}), recipients:$next_chosen_to, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:TotalDamage($number), duration:$this_duration, body:$chosen_prevention_damage_body}}] */
instructions_chosen_source_prevention_receipt ::= "prevent" "the" "next" number "damage" "that" "a" next_chosen_sources "would" "deal" next_chosen_to this_duration "." chosen_prevention_damage_body

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:ModifyEvent{change:PreventDamage}}, If{condition:Compare{left:Performed(@marked), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_ref_named, recipients:$recipients_any_target, amount:Performed(@marked), preventable:true}}]}, otherwise:Program{}}]} */
chosen_prevention_damage_body ::= "if" "damage" "is" "prevented" "this" "way" "," self_ref_named "deals" "that" "much" "damage" "to" recipients_any_target

/* A damage source is chosen at resolution and used by the adjacent shield. */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:DamageSources(Any), count:Exactly(Constant(1))} */
chosen_damage_source ::= "a" "source" "of" "your" "choice"

/* @sem Instruction::[Effect{result:@next, operation:$chosen_damage_source}, Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Any, sources:SameObject(Result{result:@prior, phase:Before, index:0}), recipients:Any, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}}}] */
instructions_chosen_source_prevention ::= "prevent" "all" prevent_damage chosen_damage_source "would" "deal" this_duration

/* The replacement event and its energy outcome share the same event amount. */
/* @sem Ability::Replacement{active:Battlefield, event:$replacement_energy_event, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:$replacement_energy_bonus_operation}]}} */
replacement_energy_bonus ::= "if" replacement_energy_event "," replacement_energy_bonus_operation "instead" "."

/* @sem ReplacementEvent::Player{event:GetEnergy, players:One(AbilityController)} */
replacement_energy_event ::= "you" "would" "get" "one" "or" "more" "{" "E" "}" energy_counter_unit?

replacement_energy_bonus_operation ::= replacement_energy_bonus_plus | replacement_energy_bonus_scaled

/* Each kind of counter gets more of itself. */
/* @sem Expr::Add([EventAmount, $number]) */
replacement_each_kind_bonus_amount ::= "that" "many" "plus" number "of" "each" "of" "those" "kinds" "of" "counters"

/* @sem ReplacementEvent::Counters(_{objects:Not(Any), players:One(AbilityController)}) */
replacement_controller_counter_event ::= "you" "would" "get" "one" "or" "more" "counters"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount($replacement_each_kind_bonus_amount)}}]} */
replacement_controller_counter_bonus ::= "you" "get" replacement_each_kind_bonus_amount "instead"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_controller_counter_event, body:$replacement_controller_counter_bonus} */
replacement_player_counter_bonus ::= "if" replacement_controller_counter_event "," replacement_controller_counter_bonus "."

/* A poison-counter event and its replacement amount share the printed kind.
   Keep it fixed until counter-kind agreement has a typed inverse. */
/* @sem ReplacementEvent::Counters(_{kind:Named(PoisonCounter), objects:Not(Any), players:One(AbilityController)}) */
replacement_you_receive_poison_event ::= "you" "would" "get" "one" "or" "more" "poison" "counters"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Constant(1))}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Prohibit(ReceiveCounters($counter_kind)))], duration:$this_duration, evaluation:LiveObjects}}]} */
replacement_receive_one_poison_and_prohibit ::= "instead" "you" "get" "one" "poison" "counter" "and" "you" "can't" "get" "additional" counter_kind "counters" this_duration

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_you_receive_poison_event, body:$replacement_receive_one_poison_and_prohibit} */
replacement_poison_receive_limit ::= "if" replacement_you_receive_poison_event "," replacement_receive_one_poison_and_prohibit "."

/* Cards and tokens headed for the named player's zone retain their owner;
   the replacement outcome is shared with other singular zone events. */
/* @sem ReplacementEvent::ZoneChange{objects:AllOf([Any, OwnedBy(One(AbilityController))]), to:$enchanted_player_card_zone} */
replacement_card_or_token_your_zone ::= "a" "card" "or" "token" "would" "be" "put" "into" "your" enchanted_player_card_zone "from" "anywhere"

/* A coin replacement keeps the affected player set on the event. */
/* @sem ReplacementEvent::Player{event:FlipCoin, players:One(AbilityController)} */
replacement_coin_you_event ::= "you" "would" "flip" "a" "coin"

replacement_coin_each_players ::= players_each | players_each_opponent | replacement_coin_named_player

/* @sem PlayerSet::One($replacement_coin_player_ref) */
replacement_coin_named_player ::= replacement_coin_player_ref

replacement_coin_player_ref ::= active_player_ref | replacement_coin_attacking_player

/* @sem PlayerRef::AttackingPlayer */
replacement_coin_attacking_player ::= "the" "attacking" "player"

/* @sem ReplacementEvent::Player{event:FlipCoin, players:$replacement_coin_each_players} */
replacement_coin_each_event ::= replacement_coin_each_players "would" "flip" "a" "coin"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:ModifyEvent{change:FlipExtraCoin}}]} */
replacement_coin_you_outcome ::= "instead" "flip" "two" "coins" "and" "ignore" "one"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:ModifyEvent{change:FlipExtraCoin}}]} */
replacement_coin_each_outcome ::= "instead" "that" "player" "flips" "two" "coins" "and" "ignores" "one"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_coin_you_event, body:$replacement_coin_you_outcome} */
replacement_coin_you ::= "if" replacement_coin_you_event "," replacement_coin_you_outcome "."

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_coin_each_event, body:$replacement_coin_each_outcome} */
replacement_coin_each ::= "if" replacement_coin_each_event "," replacement_coin_each_outcome "."

/* @sem ReplacementEvent::Tokens{tokens:$filter_phrase, creators:One(AbilityController)} */
replacement_you_create_filtered_event ::= "you" "would" "create" "one" "or" "more" filter_phrase "tokens"

/* @prefer always */
/* @sem ReplacementEvent::Tokens{tokens:Any, creators:One(AbilityController)} */
replacement_you_create_any_event ::= "you" "would" "create" "one" "or" "more" "tokens"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:ReplaceTokens{copies:1, tokens:[_{amount:$replacement_extra_count, words:Rules, recipe:$token_named_recipe}]}}}]} */
replacement_create_extra_many_outcome ::= "instead" "create" "those" "tokens" "plus" replacement_extra_count "additional" token_named_recipe "tokens"

replacement_extra_count ::= count_plural

replacement_extra_outcome ::= replacement_create_extra_outcome | replacement_create_extra_many_outcome

/* Cards and tokens share the owner and destination of the impending event. */
/* @sem ReplacementEvent::ZoneChange{objects:AllOf([Any, OwnedBy(All)]), to:$enchanted_player_card_zone} */
replacement_card_or_token_zone ::= "a" "card" "or" "token" "would" "be" "put" "into" "a" enchanted_player_card_zone "from" "anywhere"

/* The prevention and its consumed receipt stay within the same replacement. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:$prevent_to, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), limit:TotalDamage($value), duration:$this_duration, body:$prevent_receipt_body} */
prevent_next_with_receipt_shared ::= "prevent" "the" "next" value prevent_damage "that" "would" "be" "dealt" "to" prevent_to this_duration "." prevent_receipt_body

/* A shared color union qualifies each of the three named object categories. */
/* @sem ObjectFilter::AnyOf([$adjective_color, $adjective_color, $adjective_color, $adjective_color_2, $adjective_color_2, $adjective_color_2]) */
replacement_color_union ::= adjective_color "or" adjective_color

/* @sem ReplacementEvent::ZoneChange{objects:AllOf([ $replacement_color_union, OwnedBy(All)]), to:Graveyard} */
replacement_colored_permanent_spell_card_graveyard ::= "a" replacement_color_union "permanent" "," "spell" "," "or" "card" "not" "on" "the" "battlefield" "would" "be" "put" "into" "a" "graveyard"

/* A card's activated ability, owner, destination and history independently
   qualify the pending zone change. */
/* @sem ReplacementEvent::ZoneChange{objects:AllOf(@unordered([$replacement_card_ability, $replacement_graveyard_owner, $replacement_card_history])), to:$enchanted_player_card_zone} */
replacement_history_qualified_card_zone ::= "a" "card" replacement_card_ability "would" "be" "put" "into" replacement_graveyard_owner enchanted_player_card_zone "from" "anywhere" "and" replacement_card_history

/* @sem ObjectFilter::$cycling_ability_filter */
replacement_card_ability ::= "that" "has" "a" cycling_ability_filter

/* @sem ObjectFilter::Not(History{event:Cycled, window:ThisGame}) */
replacement_card_history ::= "it" "wasn't" "cycled"

/* A reusable amount-limited shield for one announced damage recipient. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:$prevent_to_any_target, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:TotalDamage($number), duration:EndOfTurn, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevent_any_target_amount ::= "prevent" "the" "next" number "damage" "that" "would" "be" "dealt" "to" prevent_to_any_target "this" "turn"

/* Paid instant-speed special action over the already announced recipient. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(SpecialAction{body:List([Program{instructions:[Effect{result:@next, operation:$paid_target_shield}]}]), cost:$generic_alternative, instant_speed:true})], duration:EndOfTurn, evaluation:LiveObjects} */
paid_target_prevention ::= "until" "end" "of" "turn" "," "you" "may" "pay" generic_alternative "any" "time" "you" "could" "cast" "an" "instant" "." "if" "you" "do" "," paid_target_shield

/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:Target{slot:@last_slot, index:0}, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:TotalDamage($number), duration:EndOfTurn, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
paid_target_shield ::= "prevent" "the" "next" number "damage" "that" "would" "be" "dealt" "to" "that" "permanent" "or" "player" "this" "turn"

/* A next-occurrence replacement keeps the source, damage kind, duration and outcome independent. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Permanent, sources:SameObject($object_ref), recipients:Any, kind:$shared_damage_kind, grouping:SourceRecipient, subject:Recipient}), limit:NextOccurrence, duration:$this_duration, body:$next_object_damage_body} */
next_object_damage_replacement ::= "the" "next" "time" object_ref "would" "deal" shared_damage_kind this_duration "," next_object_damage_body

next_object_damage_body ::= temporary_damage_change | prevented_body_plain

/* @sem Instruction::[Effect{result:@next, operation:$next_object_damage_replacement}] */
next_object_damage_instruction ::= next_object_damage_replacement

/* The conditional's referent is bound in the enclosing program. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:@zone_members(ObjectSet::@implicit_card_set(ObjectSet::One($current_card_ref))), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}] */
conditional_put_current_tapped ::= "put" current_card_ref "onto" "the" "battlefield" "tapped"

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:@zone_members(ObjectSet::@implicit_card_set(ObjectSet::One($current_card_ref))), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
conditional_put_current ::= "put" current_card_ref "onto" "the" "battlefield"

/* A filtered source and its permanent-or-player recipient share one damage event. */
/* @sem ReplacementEvent::Damage(_{source_kind:Any, sources:$source_filtered_controlled_an, recipients:$damage_to_filter_or_player, kind:$event_damage_kind, grouping:SourceRecipient, subject:Recipient}) */
filtered_source_recipient_event ::= source_filtered_controlled_an "would" "deal" event_damage_kind "to" damage_to_filter_or_player

/* @prefer always */
/* @sem Ability::Replacement{active:Battlefield, event:$filtered_source_recipient_event, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Add([EventAmount, $value]))}}]}} */
replacement_filtered_source_bonus ::= "if" filtered_source_recipient_event "," "it" "deals" "that" "much" "damage" "plus" value "to" "that" "permanent" "or" "player" "instead" "."

/* A controlled source with a type alternative. */
/* @sem ObjectFilter::AllOf([$source_an_filter, ControlledBy(One(AbilityController))]) */
source_filtered_controlled_an ::= "an" source_an_filter "source" "you" "control"

source_an_filter ::= filter_instant_or_sorcery | source_type_or_sorcery

source_vowel_type ::= noun_artifact | noun_enchantment

/* @sem ObjectFilter::AnyOf([$source_vowel_type, $spell_sorcery]) */
source_type_or_sorcery ::= source_vowel_type "or" spell_sorcery

/* A temporary redirect composes the protected population, window, and destination. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:ObjectsAndPlayers{objects:@and($filter_plural, ObjectFilter::ControlledBy(One(AbilityController))), players:One(AbilityController)}, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:$redirect_affected_body} */
temporary_controlled_damage_redirect ::= "all" "damage" "that" "would" "be" "dealt" this_duration "to" "you" "and" filter_plural "you" "control" redirect_affected_body

/* Entry triggers can install the same operand-driven redirect. */
/* @sem Ability::Triggered{event:$event_self_enters, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$temporary_controlled_damage_redirect}]}} */
triggered_entry_controlled_damage_redirect ::= "when" event_self_enters "," temporary_controlled_damage_redirect "."

/* A singular counter modifies the pending entry event. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$counter_amount})}}]} */
entry_single_counter_him ::= "with" counter_amount counter_kind "counter" "on" "him"

/* The payment condition guards the chosen-color mana action. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:FirstWilling(All), cost:Cost{parts:[$cost_mana]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:$add_mana_of_that_color}]}, otherwise:Program{}}] */
clause_chosen_mana_unless_payment ::= add_mana_of_that_color "unless" "any" "player" "pays" cost_mana

/* A plural permanent-source damage event can be used with an explicit multiplier. */
/* @sem ReplacementEvent::Damage(_{source_kind:Permanent, sources:$filter_plural, recipients:Any, kind:Any, grouping:SourceRecipient, subject:Recipient}) */
plural_outgoing_damage_event ::= "all" "damage" "that" filter_plural "would" "deal"

/* @sem Ability::Replacement{active:Battlefield, event:$plural_outgoing_damage_event, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([$damage_factor, EventAmount]))}}]}} */
replacement_scale_plural_damage ::= damage_factor plural_outgoing_damage_event "."

/* Each phrase contributes one independently counted placement to the entry. */
/* @sem Operation::ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:CountObjects($affected)})} */
entry_counted_counter_phrase ::= "a" counter_kind "counter" "on" "it" "for" affected

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$entry_counted_counter_phrase}, Effect{result:@next, operation:$entry_counted_counter_phrase_2}]} */
entry_counted_counter_pair ::= "with" entry_counted_counter_phrase "and" entry_counted_counter_phrase

/* A counter phrase contributes one entry-event modification; lists retain each placement. */
/* @sem Operation::ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$counter_amount})} */
entry_counter_item ::= counter_amount counter_kind "counter"

/* @sem Program::Program{instructions:$entry_counter_items} */
entry_counter_list ::= "with" entry_counter_items "on" "it"

entry_counter_items ::= entry_counter_items_pair | entry_counter_items_serial
/* @sem Instruction::[$entry_counter_instruction, $entry_counter_instruction_2] */
entry_counter_items_pair ::= entry_counter_instruction "and" entry_counter_instruction
/* @sem Instruction::[$entry_counter_instruction, ...$entry_counter_items_tail] */
entry_counter_items_serial ::= entry_counter_instruction "," entry_counter_items_tail

entry_counter_items_tail ::= entry_counter_items_last_pair | entry_counter_items_serial
/* @sem Instruction::[$entry_counter_instruction, $entry_counter_instruction_2] */
entry_counter_items_last_pair ::= entry_counter_instruction "," "and" entry_counter_instruction
/* @sem Instruction::Effect{result:@next, operation:$entry_counter_item} */
entry_counter_instruction ::= entry_counter_item

/* Compose an entry replacement from its subject and its counter modification. */
/* @sem Ability::Replacement{active:Battlefield, event:$each_filtered_entry_event, body:Program{instructions:[Effect{result:@next, operation:$each_filtered_entry_counter_change}]}} */
each_filtered_entry_replacement ::= each_filtered_entry_event each_filtered_entry_counter_change "."

/* @sem ReplacementEvent::Enter{objects:$filter_phrase} */
each_filtered_entry_event ::= "each" filter_phrase "enters"

/* @prefer always */
/* @sem Operation::ModifyEvent{change:AddCounters{kind:$counter_kind, amount:$controlled_entry_history_count}} */
entry_additional_counter_per_history ::= "with" "an" "additional" counter_kind "counter" "on" "it" "for" "each" controlled_entry_history_count

/* @sem Expr::EventHistory{event:ZoneChange{objects:AllOf([$filter_phrase, ControlledBy(One(AbilityController))]), to:Battlefield}, window:ThisTurn, measure:Occurrences} */
controlled_entry_history_count ::= filter_phrase "that" "entered" "the" "battlefield" "under" "your" "control" "this" "turn"

/* A chosen damage source is a resolving choice, shared across damage windows. */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:DamageSources($next_chosen_sources), count:Exactly($counter_amount)} */
resolving_damage_source_choice ::= counter_amount next_chosen_sources

/* @sem EventSpec::Damage(_{source_kind:Any, sources:SameObject(Result{result:@prior, phase:Before, index:0}), recipients:Objects(SameObject($object_ref)), kind:Any, grouping:SourceRecipient, subject:Recipient}) */
chosen_damage_to_object ::= "all" "damage" "that" "would" "be" "dealt" "to" object_ref

/* @sem Instruction::[Effect{result:@next, operation:$resolving_damage_source_choice}, Effect{result:@next, operation:CreateReplacement{event:$chosen_damage_to_object, limit:UntilExpired, duration:$this_duration, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage($redirect_destination)}}]}}}] */
instructions_all_chosen_damage_redirect ::= chosen_damage_to_object this_duration "by" resolving_damage_source_choice "is" "dealt" "to" redirect_destination "instead"

/* The source controller and chosen-type qualifier remain separate operands. */
/* @sem ReplacementEvent::Damage(_{source_kind:Any, sources:$outgoing_qualified_sources, recipients:Any, kind:Any, grouping:SourceRecipient, subject:Recipient}) */
replacement_outgoing_chosen_sources ::= "that" outgoing_qualified_sources "would" "deal"

/* @sem ObjectFilter::@and($outgoing_source_controller, $modifier_chosen_type) */
outgoing_qualified_sources ::= "sources" outgoing_source_controller modifier_chosen_type

outgoing_source_controller ::= modifier_you_control | modifier_not_controlled

/* A first-draw replacement composes with the observed-card split and draw. */
/* @sem Ability::Replacement{active:Battlefield, event:FirstEachTurn(Player{event:Draw, players:One(AbilityController)}), body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, ...$look_two_graveyard_other_top, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}]}} */
first_draw_look_split ::= "the" "first" "time" "you" "would" "draw" "a" "card" "each" "turn" "," "instead" look_two_graveyard_other_top "." "then" "draw" card_count "."

/* @prefer always */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::GainEnergy{amount:Add([EventAmount, $number])}} */
replacement_energy_bonus_plus ::= "you" "get" "that" "many" "plus" number "{" "E" "}"

/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::GainEnergy{amount:Multiply([$replacement_life_factor, EventAmount])}} */
replacement_energy_bonus_scaled ::= "you" "get" replacement_life_factor "that" "many" "{" "E" "}"

/* The antecedent is the named source in the preceding copy instruction. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject(Source)), kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevent_damage_to_him_this_duration ::= "prevent" "all" "damage" "that" "would" "be" "dealt" "to" "him" this_duration

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:DamageSources($next_chosen_sources), count:Exactly($counter_amount)}}, Effect{result:@next, operation:CreateReplacement{event:Damage(_{source_kind:Any, sources:SameObject(Result{result:@prior, phase:Before, index:0}), recipients:Any, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:NextOccurrence, duration:$this_duration, body:$redirect_damage_body}}] */
instructions_next_chosen_redirect_any ::= "the" "next" "time" counter_amount next_chosen_sources "would" "deal" "damage" this_duration "," redirect_damage_body

/* The prevention receipt is consumed inside its replacement body, so the
   condition and token amount refer to that exact prevention. */
/* @sem ReplacementEvent::Damage(_{source_kind:Permanent, sources:SameObject($target_object), recipients:Players(All), kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}) */
next_target_damage_players ::= target_object "would" "deal" prevent_damage "to" "one" "or" "more" "players"

/* @sem Operation::CreateReplacement{event:$next_prevent_event, limit:NextOccurrence, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, If{condition:Compare{left:Performed(@last_result), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:_{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:Performed(@prior), words:CreatingEffect, recipe:$prevention_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:_{}}]}} */
shield_next_prevent_tokens ::= "the" "next" "time" next_prevent_event this_duration "," "prevent" "that" "damage" "." "if" "damage" "is" "prevented" "this" "way" "," "create" "that" "many" prevention_token_recipe

prevention_token_recipe ::= token_recipe | token_recipe_quoted

/* @sem Instruction::[Effect{result:@next, operation:$shield_next_prevent_tokens}] */
instructions_prevent_tokens_quoted ::= shield_next_prevent_tokens

/* @sem ObjectFilter::AllOf([$adjective_nontype, ControlledBy(One(PlayerRef::AbilityController))]) */
source_nontype_yours ::= "a" adjective_nontype "source" "you" "control"

/* @prefer always */
/* @sem DamageRecipients::ObjectsAndPlayers{objects:AnyOf(@unordered([$noun, $noun_2])), players:OpponentsOf(PlayerRef::AbilityController)} */
damage_to_two_types_or_opponent ::= "a" noun "," noun "," "or" "opponent"

/* Compose the loss event with a sequential replacement program. */
/* @prefer always */
/* @sem Vec<Instruction>::@then_sequence($clause_before_then, $instructions_more_and) */
replacement_then_joined_instructions ::= clause_before_then "," "then" instructions_more_and

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_you_lose_event, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, ...$replacement_then_joined_instructions]}} */
replacement_you_lose_then_joined ::= "if" replacement_you_lose_event "," "instead" replacement_then_joined_instructions "."

/* The replacement changes the destination before the counter is placed on that arrival. */
/* @sem Ability::Replacement{active:Battlefield, event:$opponent_death_event, body:$replacement_exile_counter_program} */
replacement_opponent_death_exile_counter ::= "if" opponent_death_event "," replacement_exile_counter_program "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}, Effect{result:@next, operation:PutCounters{placements:[$replacement_exile_counter_placement]}}]} */
replacement_exile_counter_program ::= "instead" "exile" "it" "and" replacement_exile_counter_placement

replacement_exile_counter_placement ::= replacement_exile_counter_single | replacement_exile_counter_plural

/* @sem CounterPlacement::CounterPlacement{recipients:Objects(One(Query{objects:InZone{objects:One(EventDestination), zone:Exile}, index:0})), kind:$counter_kind, amount:Constant(1)} */
replacement_exile_counter_single ::= "put" "a" counter_kind "counter" "on" "it"

/* @sem CounterPlacement::CounterPlacement{recipients:Objects(One(Query{objects:InZone{objects:One(EventDestination), zone:Exile}, index:0})), kind:$counter_kind, amount:$count_plural} */
replacement_exile_counter_plural ::= "put" count_plural counter_kind "counters" "on" "it"

/* The event and the prevention body compose independently, retaining each
   instruction and its result in the same replacement frame. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, ...$instructions]} */
prevention_and_instructions ::= "prevent" "that" "damage" "and" instructions

/* @sem Ability::Replacement{active:Battlefield, event:$permanent_damage_event, body:$prevention_and_instructions} */
replacement_permanent_damage_prevention_followup ::= "if" permanent_damage_event "," prevention_and_instructions "."

/* The event and replacement instructions compose independently. */
/* @sem Ability::Replacement{active:Battlefield, event:$replacement_opponent_extra_draw_event, body:Program{instructions:[Instruction::Effect{result:@next, operation:Operation::ModifyEvent{change:Cancel}}, ...$instructions]}} */
replacement_opponent_extra_draw_instead ::= "if" replacement_opponent_extra_draw_event "," "instead" instructions "."

/* The repeated phrase identifies the ability holder in both positions. */
/* @sem ReplacementEvent::Damage(_{source_kind:Any, sources:$replacement_damage_source, recipients:Objects(SameObject(Source)), kind:Any, grouping:SourceRecipient, subject:Recipient}) */
damage_event_to_self_creature ::= replacement_damage_source "would" "deal" "damage" "to" "this" "creature"

/* @sem Ability::Replacement{active:Battlefield, event:$damage_event_to_self_creature, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([$damage_factor, EventAmount]))}}]}} */
replacement_repeated_object_damage_factor ::= "if" damage_event_to_self_creature "," "it" "deals" damage_factor "that" "damage" "to" "this" "creature" "instead" "."

/* The bound opponent and ability controller each count the same population. */
/* @sem PlayerSet::Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])})}}}]) */
replacement_opponent_at_least_your_count ::= "an" "opponent" "who" "controls" "at" "least" "as" "many" filter_plural "as" "you" "do"

/* The event subject chooses a permanent to sacrifice after the original event. */
/* @sem Program::_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Then{instructions:[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(EventSubject), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, choose:AsManyAsCan(Constant(1))})}]}}}]} */
replacement_then_subject_sacrifices ::= "then" "sacrifices" "a" filter_phrase "of" "their" "choice"

/* Both mentions describe the same entering object. */
/* @sem Ability::Replacement{active:Battlefield, event:PutOntoBattlefield{players:$replacement_opponent_at_least_your_count, objects:@agree($filter_phrase, $filter_phrase_2)}, body:$replacement_then_subject_sacrifices} */
replacement_counted_opponent_entry ::= "if" replacement_opponent_at_least_your_count "would" "put" "a" filter_phrase "onto" "the" "battlefield" "," "that" "player" "instead" "puts" "that" filter_phrase "onto" "the" "battlefield" replacement_then_subject_sacrifices "."

/* The measured event and amount change share the named source and the fixed
   permanent-or-player recipient across their two clauses. */
/* @sem ReplacementEvent::Measured{event:Damage(_{source_kind:Any, sources:$replacement_damage_source, recipients:ObjectsAndPlayers{objects:Any, players:All}, kind:Any, grouping:SourceRecipient, subject:Recipient}), comparison:GreaterOrEqual, amount:$value} */
measured_source_damage_permanent_or_player ::= replacement_damage_source "would" "deal" value "or" "more" "damage" "to" "a" "permanent" "or" "player"

/* @sem EventChange::SetAmount($value) */
source_damage_set_amount ::= "that" "source" "deals" value "damage" "to" "that" "permanent" "or" "player" "instead"

/* @sem Ability::Replacement{active:Battlefield, event:$measured_source_damage_permanent_or_player, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:$source_damage_set_amount}}]}} */
replacement_measured_source_change ::= "if" measured_source_damage_permanent_or_player "," source_damage_set_amount "."

/* Bound the amount for each source and recipient of the damage event. */
/* @sem ReplacementEvent::Measured{event:Damage(_{source_kind:Any, sources:$replacement_damage_source, recipients:$replacement_damage_to, kind:Any, grouping:SourceRecipient, subject:Recipient}), comparison:LessOrEqual, amount:$value} */
measured_source_damage_event ::= replacement_damage_source "would" "deal" value "or" "less" "damage" "to" replacement_damage_to

/* The spell's controller is derived from the damage source, not the recipient. */
/* @sem Ability::Replacement{active:Battlefield, event:$replacement_spell_damage_to_event, body:_{instructions:[Effect{result:@next, operation:$redirect_damage_source_controller}]}} */
replacement_spell_damage_redirect_source_controller ::= "if" replacement_spell_damage_to_event "," redirect_damage_source_controller "instead" "."

/* @sem ReplacementEvent::Damage(_{source_kind:Spell, sources:$spell_filter, recipients:$replacement_damage_to, kind:$event_damage_kind, grouping:SourceRecipient, subject:Recipient}) */
replacement_spell_damage_to_event ::= spell_filter "would" "deal" event_damage_kind "to" replacement_damage_to

/* @sem Operation::ModifyEvent{change:RedirectDamage(Players(One(ControllerOf(Damage(Source)))))} */
redirect_damage_source_controller ::= "it" "deals" "that" "damage" "to" "its" "controller"

/* The repeated creature refers to the recipient of this very damage event. */
/* @sem ReplacementEvent::Damage(_{source_kind:Any, sources:$replacement_damage_source, recipients:Objects($replacement_creature_filter), kind:$event_damage_kind, grouping:SourceRecipient, subject:Recipient}) */
replacement_creature_damage_event ::= replacement_damage_source "would" "deal" event_damage_kind "to" "a" replacement_creature_filter

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Subtract([EventAmount, $value]))}}]} */
replacement_creature_damage_less ::= "it" "deals" "that" "much" "damage" "minus" value "to" "that" "creature" "instead"

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_creature_damage_event, body:$replacement_creature_damage_less} */
replacement_creature_damage_adjusted ::= "if" replacement_creature_damage_event "," replacement_creature_damage_less "."

partial_prevention_event ::= damage_event | permanent_damage_event

/* The cause, counter population, and replacement amount remain independently scoped. */
/* @sem ReplacementEvent::Caused{cause:AllOf([OnStack(Triggered), OnStack(Keyword(Modular))]), event:Counters(_{kind:PowerToughness(1, 1), objects:$counter_replacement_population})} */
replacement_modular_counter_event ::= "a" "modular" "triggered" "ability" "would" "put" "one" "or" "more" "+" "1" "/" "+" "1" "counters" "on" counter_replacement_population

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_modular_counter_event, body:$replacement_plus_counter_outcome} */
replacement_modular_counter_increase ::= "if" replacement_modular_counter_event "," replacement_plus_counter_outcome "."

/* An indefinite permanent source keeps its filter and recipient independent. */
/* @sem ReplacementEvent::Damage(_{source_kind:Permanent, sources:$filter_phrase, recipients:$replacement_damage_to, kind:$event_damage_kind, grouping:SourceRecipient, subject:Recipient}) */
damage_event_an_permanent ::= "an" filter_phrase "would" "deal" event_damage_kind "to" replacement_damage_to

/* A threshold is measured per source and recipient. The response below keeps
   the recipient fixed to you, as does this event phrase. */
threshold_damage_source ::= threshold_instant_sorcery_source | damage_source | source_color

/* @sem ObjectFilter::$filter_instant_or_sorcery */
threshold_instant_sorcery_source ::= "an" filter_instant_or_sorcery "source"

/* @sem ReplacementEvent::Measured{event:Damage(_{source_kind:Any, sources:$threshold_damage_source, recipients:Players(One(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Recipient}), comparison:GreaterOrEqual, amount:$value} */
threshold_damage_to_you ::= threshold_damage_source "would" "deal" value "or" "more" "damage" "to" "you"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount($value)}}]} */
set_damage_to_you ::= "it" "deals" value "damage" "to" "you" "instead"

/* @sem Ability::Replacement{active:Battlefield, event:$threshold_damage_to_you, body:$set_damage_to_you} */
replacement_threshold_damage_to_you ::= "if" threshold_damage_to_you "," set_damage_to_you "."

/* @prefer always */
/* @sem ReplacementEvent::Damage(_{source_kind:Permanent, sources:$filter_phrase, recipients:$replacement_damage_to, kind:$event_damage_kind, grouping:SourceRecipient, subject:Recipient}) */
permanent_damage_event_to ::= "a" filter_phrase "would" "deal" event_damage_kind "to" replacement_damage_to

/* @sem ReplacementEvent::Damage(_{source_kind:Permanent, sources:$filter_phrase, recipients:Any, kind:Any, grouping:SourceRecipient, subject:Recipient}) */
permanent_damage_event_any_recipient ::= "a" filter_phrase "would" "deal" "damage"

/* The same additive replacement also applies to a filtered permanent source. */
/* @sem Ability::Replacement{active:Battlefield, event:$permanent_damage_event, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Add([EventAmount, $value]))}}]}} */
replacement_permanent_damage_plus ::= "if" permanent_damage_event "," "it" "deals" "that" "much" "damage" "plus" value "instead" "."

/* A turn window and a separate condition jointly constrain an entry change. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:Program{instructions:[If{condition:AllOf([$entry_turn_window, $entry_window_condition]), then:$entry_window_modification, otherwise:Program{}}]}}) */
entry_window_conditional ::= entry_turn_window "," object_ref "enters" entry_window_modification "if" entry_window_condition "."

entry_window_condition ::= entry_prior_condition

entry_window_modification ::= entry_simple_modification | entry_modification

/* @sem Condition::Compare{left:TurnNumber, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}} */
entry_turn_window ::= "during" "your" "first" value "turns" "of" "the" "game"

/* The control follow-up is scoped to an explicit self damage recipient. */
/* @sem ReplacementEvent::Damage(DamageEvent{source_kind:Any, sources:Any, recipients:Objects(SameObject($self_ref_named)), kind:Any, grouping:SourceRecipient, subject:Recipient}) */
self_damage_would_be_dealt ::= "damage" "would" "be" "dealt" "to" self_ref_named

/* @sem ReplacementEvent::Damage(DamageEvent{source_kind:Any, sources:Any, recipients:Objects(SameObject($self_ref_named)), kind:Combat, grouping:SourceRecipient, subject:Recipient}) */
self_combat_damage_would_be_dealt ::= "combat" "damage" "would" "be" "dealt" "to" self_ref_named

self_damage_replacement_event ::= self_damage_would_be_dealt | self_combat_damage_would_be_dealt

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Player, terms:_{count:Exactly(Constant(1)), options:[Players(OpponentsOf(AbilityController))]}} */
control_choice_opponent ::= "an" "opponent" "of" "your" "choice"

/* @sem Instruction::[Effect{result:@next, operation:$control_choice_opponent}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[SetController(Chosen)], duration:Indefinite, evaluation:Snapshot}}] */
self_chosen_opponent_control ::= control_choice_opponent "gains" "control" "of" "it"

/* @sem Ability::Replacement{active:Battlefield, event:$self_damage_replacement_event, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, ...$self_chosen_opponent_control]}} */
replacement_self_prevent_chosen_control ::= "if" self_damage_replacement_event "," "prevent" "that" "damage" "and" self_chosen_opponent_control "."

linked_exile_condition_noun ::= counter_source_noun_a | counter_source_noun_an

linked_exile_return_destination ::= linked_exile_return_battlefield | linked_other_graveyard | linked_other_hand

/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
linked_exile_return_battlefield ::= "to" "the" "battlefield" "under" "its" "owner's" "control"

/* The damage source, kind, recipient, and milling players remain independent. */
/* @sem ReplacementEvent::Damage(_{source_kind:Any, sources:$prevention_controlled_source, recipients:$replacement_damage_to, kind:$event_damage_kind, grouping:SourceRecipient, subject:Recipient}) */
prevention_controlled_source_event ::= prevention_controlled_source "would" "deal" event_damage_kind "to" replacement_damage_to

prevention_controlled_source ::= source_yours | source_opponents | source_color_yours

/* The amount is the result of the adjacent prevention, not the proposed event. */
/* @sem Instruction::[Effect{result:@next, operation:Mill{players:$players_singular, amount:Performed(@prior)}}] */
prevention_followup_players_mill ::= "and" players_singular "mills" "that" "many" "cards"

/* The guarded follow-up consumes this shield's prevention result. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:$prevent_to, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), limit:TotalDamage($value_devotion), duration:$this_duration, body:$prevent_guarded_damage_body} */
prevent_next_defined_receipt ::= "prevent" "the" "next" "X" prevent_damage "that" "would" "be" "dealt" "to" prevent_to this_duration "," "where" "X" "is" value_devotion "." prevent_guarded_damage_body

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, If{condition:Compare{left:Performed(@last_result), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:$recipients, amount:Performed(@prior), preventable:true}}]}, otherwise:Program{}}]} */
prevent_guarded_damage_body ::= "if" "damage" "is" "prevented" "this" "way" "," self_explicit_ref "deals" "that" "much" "damage" "to" recipients

/* @sem ObjectFilter::AllOf([$filter_plural, Not($filter_plural_2)]) */
prevent_by_group_except ::= filter_plural "other" "than" filter_plural

/* @sem ObjectFilter::@and(ObjectFilter::@or($adjective_color, $filter_phrase), ObjectFilter::ControlledBy(One(PlayerRef::AbilityController))) */
source_color_or_filter_yours ::= "a" adjective_color "or" filter_phrase "source" "you" "control"

/* @sem DamageRecipients::ObjectsAndPlayers{objects:AllOf([$filter_phrase, ControlledBy(One(Chosen))]), players:One(Chosen)} */
damage_to_chosen_player_controlled ::= "the" "chosen" "player" "or" "a" filter_phrase "they" "control"

/* A measured damage event and its replacement amount retain independent operands. */
/* @sem ReplacementEvent::Measured{event:Damage(_{source_kind:Any, sources:$replacement_damage_source, recipients:Players(OpponentsOf(AbilityController)), kind:Noncombat, grouping:SourceRecipient, subject:Recipient}), comparison:Less, amount:$value} */
measured_noncombat_damage_opponent ::= replacement_damage_source "would" "deal" "an" "amount" "of" "noncombat" "damage" "less" "than" value "to" "an" "opponent"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount($value)}}]} */
damage_source_set_amount ::= "that" "source" "deals" "damage" "equal" "to" value "instead"

/* @sem Ability::Replacement{active:Battlefield, event:$measured_noncombat_damage_opponent, body:$damage_source_set_amount} */
replacement_measured_damage_set ::= "if" measured_noncombat_damage_opponent "," damage_source_set_amount "."

/* A source matching either independently specified color. */
/* @sem ObjectFilter::AnyOf([$adjective_color, $adjective_color_2]) */
next_chosen_either_color ::= adjective_color "or" adjective_color "source" "of" "your" "choice"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventSomeDamage(Divide{numerator:EventAmount, denominator:Constant(2), rounding:Down})}}]} */
prevented_body_half_down ::= "prevent" "half" "that" "damage" "," "rounded" "down"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventSomeDamage(Divide{numerator:EventAmount, denominator:Constant(2), rounding:Up})}}]} */
prevented_body_half_up ::= "prevent" "half" "that" "damage" "," "rounded" "up"

/* A colored spell can damage any permanent or player; the event retains both recipients. */
/* @sem ReplacementEvent::Damage(_{source_kind:Spell, sources:$adjective_color, recipients:ObjectsAndPlayers{objects:Any, players:All}, kind:Any, grouping:SourceRecipient, subject:Recipient}) */
damage_event_colored_spell_to_permanent_or_player ::= "a" adjective_color "spell" "would" "deal" "damage" "to" "a" "permanent" "or" "player"

/* This response repeats the event's permanent-or-player recipient. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Add([EventAmount, $value]))}}]} */
damage_bonus_permanent_or_player ::= "it" "deals" "that" "much" "damage" "plus" value "to" "that" "permanent" "or" "player" "instead"

/* @prefer always */
/* @sem Ability::Replacement{active:Battlefield, event:$damage_event_colored_spell_to_permanent_or_player, body:$damage_bonus_permanent_or_player} */
replacement_colored_spell_recipient_bonus ::= "if" damage_event_colored_spell_to_permanent_or_player "," damage_bonus_permanent_or_player "."

/* Both event arms refer to the same focused plural group. */
/* @sem Operation::CreateReplacement{event:Either([Damage(_{source_kind:Any, sources:Any, recipients:Objects(InSet($prevent_group_ref)), kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), Damage(_{source_kind:Permanent, sources:InSet($prevent_group_ref), recipients:Any, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient})]), limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevent_group_to_and_by ::= "prevent" "all" prevent_damage "that" "would" "be" "dealt" "to" "and" "dealt" "by" prevent_group_ref this_duration

prevent_group_ref ::= prevent_group_creatures | group_permanents | group_artifacts | group_lands | group_enchantments | group_pronoun

/* @prefer always */
/* @sem $those_creatures */
prevent_group_creatures ::= those_creatures

/* A damage event and an optional live battlefield-count prevention response. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventSomeDamage($value_number_of)}}]}}]} */
optional_counted_damage_prevention ::= "you" "may" "prevent" "X" "of" "that" "damage" "," "where" "X" "is" value_number_of

/* @sem Ability::Replacement{active:Battlefield, event:$damage_event, body:$optional_counted_damage_prevention} */
replacement_optional_counted_prevention ::= "if" damage_event "," optional_counted_damage_prevention "."

/* Both sentences change the same entering event. The conditional clause is
   reusable with any preceding entry-counter change. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:Program{instructions:[Effect{result:@next, operation:$entry_plural_counter_change}, ...$entry_x_conditional_counter]}}) */
entry_counter_sequence ::= object_ref "enters" entry_plural_counter_change "." entry_x_conditional_counter "."

/* @sem Instruction::[If{condition:ObjectMatches{object:$it_ordinary_pronoun, filter:Property{property:SpellX, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}}, then:Program{instructions:[Effect{result:@next, operation:$entry_extra_counter_change}]}, otherwise:Program{}}] */
entry_x_conditional_counter ::= "if" "X" "is" value "or" "more" "," it_ordinary_pronoun "enters" entry_extra_counter_change

/* @sem Operation::ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:$value})} */
entry_extra_counter_change ::= "with" "an" "additional" value counter_kind "counters" "on" "it"

/* A next draw can be replaced by a look, a bounded remainder, and a draw. */
/* @sem Operation::CreateReplacement{event:Player{event:Draw, players:One(AbilityController)}, limit:NextOccurrence, duration:$this_duration, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, ...$look_leave_some_bottom, Effect{result:@next, operation:@apply(PlayerSet::One(AbilityController), $draw_base)}]}} */
next_draw_look_leave ::= "the" "next" "time" "you" "would" "draw" "a" "card" this_duration "," "instead" look_leave_some_bottom "," "then" draw_base

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:$limit_x_nonzero, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$next_draw_look_leave}]}} */
activated_next_draw_look ::= cost ":" next_draw_look_leave "." limit_x_nonzero "."

/* A permanent population without the specified kind of counter. */
/* @prefer always */
/* @sem ObjectFilter::AllOf([$filter_plural, Counters(_{kind:$counter_kind, comparison:Equal, value:Constant(0)})]) */
prevent_by_without_counters ::= filter_plural "with" "no" counter_kind "counters" "on" "them"

/* Prevention by either of two colored sources, applied to a filtered population. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:AnyOf([$adjective_color, $adjective_color_2]), recipients:Objects($filter_plural), kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevent_colored_sources_to_objects ::= "prevent" "all" "damage" "that" adjective_color "and" "/" "or" adjective_color "sources" "would" "deal" "to" filter_plural this_duration

each_filtered_entry_counter_change ::= entry_additional_counter_per_history | entry_additional_counter_per_mana_source

/* @sem Operation::ModifyEvent{change:AddCounters{kind:$counter_kind, amount:$entry_singular_mana_source_count}} */
entry_additional_counter_per_mana_source ::= "with" "an" "additional" counter_kind "counter" "on" "it" entry_singular_mana_source_count

/* @sem Expr::ManaSpentFrom{object:Source, sources:$filter_phrase} */
entry_singular_mana_source_count ::= "for" "each" "mana" "from" "an" filter_phrase "source" "spent" "to" "cast" "it"

/* Reveal and choose from the same filtered hand; the choice result supplies the grant. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($hand_player)}, kind:Card, filter:AnyOf([$revealed_hand_first_type, $revealed_hand_second_type])}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One($hand_player)}, kind:Card, filter:AnyOf([$revealed_hand_first_type, $revealed_hand_second_type])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:[GrantAbility(Ability::@entering_controller($quoted_permanent_enters_tapped))]}}] */
revealed_hand_choice_entry_grant ::= hand_player "reveals" "all" revealed_hand_first_type "and" revealed_hand_second_type "cards" "in" "their" "hand" "." "choose" "one" "of" "them" "." "that" "card" "perpetually" "gains" quoted_permanent_enters_tapped

revealed_hand_first_type ::= noun_creature | noun_artifact | noun_enchantment | noun_land

revealed_hand_second_type ::= noun_creature | noun_artifact | noun_enchantment | noun_land

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:Program{instructions:$revealed_hand_choice_entry_grant}} */
triggered_revealed_hand_choice_entry_grant ::= event_clause "," revealed_hand_choice_entry_grant

/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}, count:AsManyAsCan(Constant(1)), constraints:[]} */
entry_choose_permanent ::= "choose" ("a" | "an") filter_phrase

/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$entry_choose_permanent}]}}]} */
entry_choice_optional ::= "you" "may" entry_choose_permanent

/* A spell's damage retains its independently specified recipient population. */
/* @sem ReplacementEvent::Damage(_{source_kind:Spell, sources:Any, recipients:$replacement_damage_to, kind:$event_damage_kind, grouping:SourceRecipient, subject:Recipient}) */
spell_any_damage_event ::= "a" "spell" "would" "deal" event_damage_kind "to" replacement_damage_to

/* Exclude the source only from the object side of the mixed recipient set. */
/* @sem DamageRecipients::ObjectsAndPlayers{objects:AllOf([Not(SameObject(Source)), $filter_phrase]), players:One(AbilityController)} */
damage_to_you_or_another ::= "you" "or" "another" filter_phrase

/* A chosen-property selection from a revealed hand discards the sole result card. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($hand_player)}, kind:Card, filter:Any}}}, Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(2)), zone:Hand}, filter:@and($hand_pick_chosen_quality, ObjectFilter::OwnedBy(One($hand_player)))}, count:AsManyAsCan($card_count)}}, Effect{result:@next, operation:DiscardObjects{objects:One(Result{result:@marked, phase:After, index:0})}}] */
instructions_hand_reveal_chosen_property_discard ::= hand_player "reveals" "their" "hand" "and" "you" "choose" card_count hand_pick_chosen_quality "from" "it" "." "that" "player" "discards" "that" "card"

hand_pick_chosen_quality ::= modifier_that_color

/* Compose a damage event with an independent counter placement. */
/* @sem Ability::Replacement{active:Battlefield, event:$generic_damage_event, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, Effect{result:@next, operation:$put_counters_direct}]}} */
replacement_source_prevent_put_counters ::= "if" generic_damage_event "," "prevent" "that" "damage" "and" put_counters_direct "."

/* The selection consumes the immediately revealed whole hand. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($hand_player)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(3)), zone:Hand}, filter:@and($adjective_nontype, ObjectFilter::OwnedBy(One($hand_player)))}, count:AsManyAsCan(Constant(1))}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:Program{instructions:[Effect{result:@next, operation:DiscardObjects{objects:One(Result{result:@prior, phase:After, index:0})}}, Effect{result:@next, operation:Draw{players:One($hand_player), amount:$card_count}}]}, otherwise:Program{}}] */
clause_observed_optional_discard_draw ::= hand_player "reveals" "their" "hand" "." "you" "may" "choose" "a" adjective_nontype "card" "from" "it" "." "if" "you" "do" "," "that" "player" "discards" "that" "card" "," "then" "draws" card_count

/* Choosing the top card of the shuffled face-down pile exiled with this source
   replaces the draw with a chance selection into its owner's hand. */
/* @sem Ability::Replacement{active:Battlefield, event:Player{event:Draw, players:One(AbilityController)}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:ChooseAction{actor:One(AbilityController), options:[Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), chooser:Chance, objects:Zone(_{scope:Shared(Exile), kind:Card, filter:ExiledWith(Source)}), count:Exactly(Constant(1)), constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}}]}, Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Constant(1)}}]}]}}]}} */
replacement_draw_exiled_pile_top_hand ::= "if" "you" "would" "draw" "a" "card" "," "you" "may" "instead" "put" "the" "top" "card" "of" "the" "pile" "you" "exiled" "into" "your" "hand" "."

/* A comma-delimited hand observation and singleton choice. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($hand_player)}, kind:Card, filter:Any}}}, Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(2)), zone:Hand}, filter:@and($hand_pick_source, ObjectFilter::OwnedBy(One($hand_player)))}, count:AsManyAsCan(Constant(1))}}] */
comma_hand_choice ::= hand_player "reveals" "their" "hand" "," "you" "choose" hand_pick_source

/* Selected-card hand losses using Result(After) for single-card discard (matching Devour Intellect without hand_discard Selected duplication). */
hand_loss_selected ::= hand_exile | hand_exile_owner | hand_exile_owner_it | hand_subset_discard_single

/* The damage event supplies the amount removed from its recipient. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, Effect{result:@next, operation:$damage_holder_remove_counters}]} */
damage_recipient_prevent_remove ::= "prevent" "that" "damage" "and" damage_holder_remove_counters

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_damage_to_this_creature, body:$damage_recipient_prevent_remove} */
replacement_creature_damage_prevent_remove ::= "if" replacement_damage_to_this_creature "," damage_recipient_prevent_remove "."

/* In a replacement, the failure branch also cancels the event. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$payment_return_graveyard_card, optional:false}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, ...$conjoined]}, otherwise:Program{}}] */
replacement_required_return_if_cant ::= payment_return_graveyard_card "." "if" "you" "can't" "," conjoined

/* @sem Ability::Conditional{condition:$condition_your_library_empty, then:[Replacement{active:Battlefield, event:$draw_event, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, ...$replacement_required_return_if_cant]}}]} */
replacement_draw_empty_required ::= "if" draw_event "while" condition_your_library_empty "," "instead" replacement_required_return_if_cant "."

/* Replacing any one of Clue, Food, or Treasure creates the stated count of all three predefined tokens. */
/* @sem Ability::Replacement{active:Battlefield, event:Tokens{tokens:AnyOf([Subtype(Clue), Subtype(Food), Subtype(Treasure)]), creators:One(AbilityController), each:true}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:ReplaceTokens{copies:0, tokens:[TokenSpec{amount:$number, words:Rules, recipe:$tn_clue}, TokenSpec{amount:$number, words:Rules, recipe:$tn_food}, TokenSpec{amount:$number, words:Rules, recipe:$tn_treasure}]}}}]}} */
replacement_create_each_clue_food_treasure ::= "if" "you" "would" "create" "a" tn_clue "," tn_food "," "or" tn_treasure "token" "," "instead" "create" number "of" "each" "."

/* The replacement and its follow-up are scoped together: "it" is the card
   moved from the event subject's library, not an arbitrary prior result. */
/* @sem Operation::CreateReplacement{event:Player{event:Draw, players:One(EventSubject)}, limit:NextOccurrence, duration:$this_turn, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(EventSubject)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:_{}}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(EventSubject)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:$exiled_play_action, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}]}} */
next_subject_draw_top_exile_permission ::= "the" "next" "time" "they" "would" "draw" "a" "card" this_turn "," "instead" "they" "exile" "the" "top" "card" "of" "their" "library" "." "they" "may" exiled_play_action "it" this_duration

/* @sem Ability::Triggered{event:$subject_upkeep_event, limits:TriggerLimits{}, body:_{instructions:[Effect{result:@next, operation:$next_subject_draw_top_exile_permission}]}, announcement:@announcement} */
triggered_subject_draw_top_exile_permission ::= subject_upkeep_event "," next_subject_draw_top_exile_permission "."

/* @sem EventSpec::Turn{point:UpkeepBegins, players:$subject_upkeep_players} */
subject_upkeep_event ::= "at" "the" "beginning" "of" subject_upkeep_players "upkeep"

subject_upkeep_players ::= owner_opponent | owner_all | owner_others

/* A temporary replacement retains its event and replacement program independently. */
/* @sem Operation::CreateReplacement{event:$chosen_damage_recipient_event, limit:UntilExpired, duration:$this_duration, body:$prevent_damage_counter_body} */
conditional_damage_counter_replacement ::= chosen_damage_recipient_event this_duration "," prevent_damage_counter_body

/* Announce a target and identify it as the damage recipient. */
/* @sem ReplacementEvent::Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($noun_creature, ObjectFilter::ControlledBy(One(AbilityController)))}), index:0})), kind:Any, grouping:SourceRecipient, subject:Recipient}) */
chosen_damage_recipient_event ::= "choose" "target" noun_creature "you" "control" "." "if" "damage" "would" "be" "dealt" "to" "that" "creature"

/* The counter amount is the result of the prevention in this same program. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects($affected), kind:$counter_kind, amount:Performed(@prior)}]}}]} */
prevent_damage_counter_body ::= "prevent" "that" "damage" "and" "put" "that" "many" counter_kind "counters" "on" affected

/* @sem Operation::CreateReplacement{event:$targeted_spell_caused_damage, limit:UntilExpired, duration:$this_duration, body:$prevented_body_plain} */
prevent_targeted_spell_caused_damage ::= targeted_spell_caused_damage this_duration "," prevented_body_plain

/* @sem ObjectFilter::ControlledBy(OthersThan(AbilityController)) */
prevent_by_other_sources ::= "sources" "you" "don't" "control"

/* The body consumes the immediately preceding prevention result, grouped by source. */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:$prevent_by_sources, recipients:$prevent_to, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:$prevent_receipt_body} */
prevent_all_with_receipt_to_by_sources ::= "prevent" "all" prevent_damage "that" "would" "be" "dealt" "to" prevent_to this_duration "by" prevent_by_sources "." prevent_receipt_body

/* The two outcomes partition creature sources and noncreature sources. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, If{condition:AllOf([Compare{left:Performed(@last_result), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, Compare{left:CountObjects(Matching{objects:Damage(Source), filter:CardType(Creature)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}]), then:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Damage(Source))), amount:Performed(@prior), preventable:true}}]}, otherwise:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(One(ControllerOf(Damage(Source)))), amount:Performed(@back(3)), preventable:true}}]}}]} */
prevent_receipt_split_source ::= "if" "damage" "from" "a" "creature" "source" "is" "prevented" "this" "way" "," SELF_NAME "deals" "that" "much" "damage" "to" "that" "creature" "." "if" "damage" "from" "a" "noncreature" "source" "is" "prevented" "this" "way" "," SELF_NAME "deals" "that" "much" "damage" "to" "the" "source's" "controller"

/* Scars of the Veteran registers its conditional delayed placement during setup. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any}), index:0}, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:TotalDamage($number), duration:$this_duration, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}}}, $prevent_receipt_conditional_delayed_counters] */
prevent_next_with_receipt_any_target ::= "prevent" "the" "next" number "damage" "that" "would" "be" "dealt" "to" "any" "target" this_duration "." prevent_receipt_conditional_delayed_counters

/* @sem Instruction::If{condition:ObjectMatches{object:RecipientObject{slot:0, index:0}, filter:$noun}, then:_{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(RecipientObject{slot:0, index:0})), kind:$counter_kind, amount:DamagePreventedBy(@marked)}]}}]}}}]}, otherwise:_{}} */
prevent_receipt_conditional_delayed_counters ::= "if" "it's" "a" noun "," "put" "a" counter_kind "counter" "on" "it" "for" "each" "1" "damage" "prevented" "this" "way" "at" "the" "beginning" "of" "the" "next" "end" "step"

/* @sem ObjectFilter::AllOf([State(Unblocked), $filter_plural]) */
prevent_by_unblocked_group ::= "unblocked" filter_plural

/* @sem ObjectFilter::AnyOf([$adjective_color, $adjective_color_2]) */
next_chosen_color_pair ::= adjective_color "or" adjective_color "source" "of" "your" "choice"

next_chosen_any_body ::= prevented_body | redirect_damage_source_controller_body

/* The recipient is the controller of the damage event source. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage(Players(One(ControllerOf(Damage(Source)))))}}]} */
redirect_damage_source_controller_body ::= "that" "damage" "is" "dealt" "to" "that" "source's" "controller" "instead"

/* The target and the shield receipt remain distinct identities. */
/* @sem Instruction::[Effect{result:@mark, operation:CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:Objects(SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0})), kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:TotalDamage($number), duration:$this_duration, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}}}, $prevent_creature_delayed_body] */
prevent_next_creature_delayed_receipt ::= "prevent" "the" "next" number "damage" "that" "would" "be" "dealt" "to" "target" "creature" this_duration "." prevent_creature_delayed_body

/* Sacred Boon registers one delayed trigger during setup and captures this exact shield's lifetime prevention total. */
/* @sem Instruction::Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:@last_slot, index:0})), kind:$counter_kind, amount:DamagePreventedBy(@marked)}]}}]}}} */
prevent_creature_delayed_body ::= "at" "the" "beginning" "of" "the" "next" "end" "step" "," "put" "a" counter_kind "counter" "on" "that" "creature" "for" "each" "1" "damage" "prevented" "this" "way"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Entry(Prepared)}}]} */
entry_prepared ::= "prepared"

/* Both counter mentions describe the same +1/+1 kind. The counted population
   is evaluated for the entering object's controller by entry_modified. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:PowerToughness([1, 1]), amount:Add([Constant(1), CountObjects($affected)])})}}]} */
entry_fixed_plus_population ::= "with" "a" "+" "1" "/" "+" "1" "counter" "on" "it" "plus" "an" "additional" "+" "1" "/" "+" "1" "counter" "on" "it" "for" affected

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:PowerToughness([1, 1]), amount:Add([@plural_amount($value), CountObjects($affected)])})}}]} */
entry_many_plus_population ::= "with" value "+" "1" "/" "+" "1" "counters" "on" "it" "plus" "an" "additional" "+" "1" "/" "+" "1" "counter" "on" "it" "for" affected

/* The event amount determines the mandatory payment; its failure has its own consequence. */
/* @sem Ability::Replacement{active:Battlefield, event:$damage_dealt_event, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[$event_amount_exile_payment]}, optional:false}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:$conjoined}, otherwise:Program{}}]}} */
replacement_damage_exile_payment_failure ::= "if" damage_dealt_event "," event_amount_exile_payment "instead" "." "if" "you" "can't" "," conjoined "."

/* @sem CostPart::Move{selections:[_{objects:Zone{scope:Players{zone:$hand_exile_zone, players:One(AbilityController)}, kind:Card, filter:$hand_exile_card_filter}, choose:Exactly(EventAmount)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
event_amount_exile_payment ::= "exile" "that" "many" hand_exile_card_filter "from" "your" hand_exile_zone

/* The permission refers to the actual arrival of the explicitly exiled top cards. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@prior, phase:After}, origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}]} */
draw_replacement_exile_play_body ::= exile_top_cards_of_your_library "instead" "." "you" "may" "play" "those" "cards" this_duration "."

/* @sem Ability::Replacement{active:Battlefield, event:$draw_event, body:$draw_replacement_exile_play_body} */
draw_replacement_exile_play ::= "if" draw_event "," draw_replacement_exile_play_body

/* An implicit end-of-turn window redirects a bounded total to a separately
   expressed recipient. The event and destination remain independent operands. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage($recipients)}}]} */
redirect_direct_body ::= "is" "dealt" "to" recipients "instead"

/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Any, sources:Any, recipients:$redirect_object_recipient, kind:Any, grouping:SourceRecipient, subject:Recipient}), limit:TotalDamage($value), duration:EndOfTurn, body:$redirect_direct_body} */
redirect_next_amount_implicit ::= "the" "next" value "damage" "that" "would" "be" "dealt" redirect_object_recipient redirect_direct_body

/* A scheme repetition is paired with the same player's scheme event. */
/* @sem ReplacementEvent::Player{event:SetSchemeInMotion, players:One(AbilityController)} */
next_scheme_event ::= "you" "would" "set" "a" "scheme" "in" "motion"

/* @sem Program::_{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:ModifyEvent{change:Repeats($value)}}]} */
scheme_repetition_body ::= "set" value "schemes" "in" "motion"

/* @sem Operation::CreateReplacement{event:$next_scheme_event, limit:NextOccurrence, duration:EndOfTurn, body:$scheme_repetition_body} */
next_scheme_replacement ::= "the" "next" "time" next_scheme_event "," scheme_repetition_body "instead"

/* The entrant retains both its printed filter and its cast status. */
/* @sem ReplacementEvent::Enter{objects:AllOf([Not(Token), $filter_phrase, Not(Cast{})])} */
replacement_uncast_entry_event ::= "a" "nontoken" filter_phrase "would" "enter" "and" "it" "wasn't" "cast"

/* The entering permanent's controller makes the choice. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($object_ref)}, body:$entry_each_choose_name}) */
entry_opponent_names ::= "as" object_ref "enters" "," entry_each_choose_name "."

/* Keep prevention and the selection consuming its actual receipt together. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$prevention_graveyard_card}, count:AsManyAsCan(Performed(@prior))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]} */
prevention_graveyard_exile_body ::= "prevent" "that" "damage" "." "exile" prevention_graveyard_card "from" "your" "graveyard" "for" "each" "1" "damage" "prevented" "this" "way"

prevention_graveyard_card ::= a_card_any | hand_singular_filtered

/* @sem Ability::Replacement{active:Battlefield, event:$damage_dealt_event, body:$prevention_graveyard_exile_body} */
replacement_prevention_graveyard_exile ::= "if" damage_dealt_event "," prevention_graveyard_exile_body "."

/* A replacement for each point of damage to the ability controller. */
/* @sem Operation::CreateReplacement{event:EachPoint(Damage(_{source_kind:Any, sources:Any, recipients:Players(One(AbilityController)), kind:Any, grouping:SourceRecipient, subject:Recipient})), limit:UntilExpired, duration:UntilNext{point:UpkeepBegins, players:One(AbilityController)}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:$operation}]}} */
per_point_damage_replacement ::= "for" "each" "1" "damage" "that" "would" "be" "dealt" "to" "you" "until" "your" "next" "upkeep" "," "you" operation "instead"

entry_each_count ::= entry_death_count | cast_mana_count

/* The source exclusion in the condition is the entering source. */
/* @sem Ability::@entering_controller(Ability::Replacement{active:SourceEntering, event:Enter{objects:SameObject($self_explicit_ref)}, body:Program{instructions:[If{condition:$condition_control_or_more_other, then:$entry_simple_modification, otherwise:Program{}}]}}) */
entry_conditional_other_population ::= "if" condition_control_or_more_other "," self_explicit_ref "enters" entry_simple_modification "."

/* @prefer always */
/* @sem ObjectFilter::AllOf([$filter_plural, Not(SameObject($object_ref))]) */
prevent_by_group_except_object ::= filter_plural "other" "than" object_ref

/* A source population can exclude an independently targeted object. */
/* @prefer always */
/* @sem Operation::CreateReplacement{event:Damage(_{source_kind:Permanent, sources:$prevent_by_group_except_object, recipients:Any, kind:$prevent_damage, grouping:SourceRecipient, subject:Recipient}), limit:UntilExpired, duration:$this_duration, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventDamage}}]}} */
prevent_all_except_object ::= "prevent" "all" prevent_damage "that" "would" "be" "dealt" "by" prevent_by_group_except_object this_duration

/* The destination and its counters modify the same impending death event. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}, Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:$counter_kind, amount:@plural_amount($counter_amount)})}}]} */
death_exile_with_counters ::= "instead" "exile" "it" "with" counter_amount counter_kind "counters" "on" "it"

/* @sem Ability::Replacement{active:Battlefield, event:$death_redirect_event, body:$death_exile_with_counters} */
death_exile_counters_replacement ::= "if" death_redirect_event "," death_exile_with_counters "."

/* The chosen source remains the source of the redirected event. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:RedirectDamage($recipients)}}]} */
chosen_source_deals_redirect_body ::= "that" "source" "deals" "that" "damage" "to" recipients "instead"

/* A bounded group of permanent targets remains one announced target set. */
/* @sem DamageRecipients::Objects(InSet(Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo($number), filter:$plural})))) */
prevent_to_up_to_permanents ::= "up" "to" number "target" plural

/* The duration can come before the recipients. */
prevent_to_late ::= prevent_to_up_to_permanents | prevent_to

/* A battlefield-to-graveyard event and its replacement program retain their
   separate operands. The explicit source zone distinguishes this from dying. */
/* @sem ReplacementEvent::ZoneChange{objects:SameObject($object_ref), from:Battlefield, to:Graveyard} */
replacement_object_battlefield_graveyard ::= object_ref "would" "be" "put" "into" "a" "graveyard" "from" "the" "battlefield"

/* @sem EventChange::SetDestination(Exile) */
/* @prefer always */
replacement_followup_exile ::= "exile" "it"

replacement_followup_destination ::= replacement_followup_exile | death_redirect_owner_hand | death_redirect_library_top

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:$replacement_followup_destination}}, Effect{result:@next, operation:$operation}]} */
replacement_exile_it_and_operation ::= "instead" replacement_followup_destination "and" operation

/* @sem Ability::Replacement{active:Battlefield, event:$replacement_object_battlefield_graveyard, body:$replacement_exile_it_and_operation} */
replacement_battlefield_exile_and_operation ::= "if" replacement_object_battlefield_graveyard "," replacement_exile_it_and_operation "."

/* A dying object's filter belongs to the battlefield-to-graveyard event. */
/* @sem ReplacementEvent::ZoneChange{objects:$filter_phrase, from:Battlefield, to:Graveyard} */
replacement_filtered_death ::= "a" filter_phrase "would" "die"

/* Prefer the explicit card wording for this event and counter outcome. */
/* @prefer always */
/* @sem Ability::Replacement{active:Battlefield, event:$replacement_filtered_death, body:$replacement_exile_card_counter_a} */
replacement_filtered_death_counter ::= "if" replacement_filtered_death "," replacement_exile_card_counter_a "."

/* Prevent a computed amount of damage from any source to the attached permanent. */
/* @sem Ability::Replacement{active:Battlefield, event:Damage{source_kind:Any, sources:Any, recipients:Objects(SameObject($attached_ref)), kind:Any, grouping:SourceRecipient, subject:Recipient}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:PreventSomeDamage($value)}}]}} */
replacement_prevent_source_attached_computed_h3 ::= "if" "a" "source" "would" "deal" "damage" "to" attached_ref "," "prevent" "X" "of" "that" "damage" "," "where" "X" "is" value "."

/* Each counter kind is multiplied independently for the same recipient. */
/* @sem Ability::Replacement{active:Battlefield, event:Counters{objects:InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), by:One(AbilityController)}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([Constant(2), EventAmount]))}}]}} */
replacement_controller_counter_kinds ::= "if" "you" "would" "put" "one" "or" "more" "counters" "on" "a" "creature" "you" "control" "," "put" "twice" "that" "many" "of" "each" "of" "those" "kinds" "of" "counters" "on" "that" "creature" "instead" "."

/* @sem Ability::Replacement{active:Battlefield, event:Counters{kind:Named(ChargeCounter), objects:InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Artifact), ControlledBy(One(AbilityController))])}), by:One(AbilityController)}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Multiply([Constant(2), EventAmount]))}}]}} */
replacement_typed_counter_double ::= "if" "you" "would" "put" "one" "or" "more" "charge" "counters" "on" "an" "artifact" "you" "control" "," "put" "twice" "that" "many" "charge" "counters" "on" "that" "artifact" "instead" "."

/* @sem Ability::Replacement{active:Battlefield, event:Counters{kind:Named(ChargeCounter), objects:InSet(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Artifact), ControlledBy(One(AbilityController))])})}, body:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetAmount(Add([EventAmount, $number_words]))}}]}} */
replacement_typed_counter_bonus ::= "if" "one" "or" "more" "charge" "counters" "would" "be" "put" "on" "an" "artifact" "you" "control" "," "that" "many" "plus" number_words "charge" "counters" "are" "put" "on" "it" "instead" "."

/* Replace the recipe without changing the number or controller of tokens. */
/* @sem Ability::Replacement{active:Battlefield, event:Tokens{tokens:Any, controllers:One(AbilityController)}, body:$replacement_token_recipe_outcome} */
replacement_own_token_recipe ::= "if" "one" "or" "more" "tokens" "would" "be" "created" "under" "your" "control" "," replacement_token_recipe_outcome "."

/* The controller must already control a declared or otherwise attacking
   creature. The entry is not a new declaration of attackers. */
/* @sem Ability::Conditional{condition:Controls{player:AbilityController, filter:AllOf([Attacking, CardType(Creature)]), minimum:1}, then:[Replacement{active:Battlefield, event:Enter{objects:$replacement_creature_you_control}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetTapped(true)}}, Effect{result:@next, operation:ModifyEvent{change:Entry(Attacking{})}}]}}], otherwise:[]} */
replacement_creatures_you_control_enter_attacking ::= "if" replacement_creature_you_control "would" "enter" "while" "you" "control" "an" "attacking" "creature" "," "instead" "it" "enters" "tapped" "and" "attacking" "."

/* @sem ObjectFilter::AllOf([CardType(Creature), ControlledBy(One(AbilityController))]) */
replacement_creature_you_control ::= "a" "creature" "you" "control"

/* @sem Ability::Replacement{active:Battlefield, event:Enter{objects:@and($plural, ObjectFilter::ControlledBy(One(AbilityController)))}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters{kind:$counter_kind, amount:$counter_amount}}}]}} */
replacement_controlled_entry_additional_counters ::= plural "you" "control" "enter" "with" counter_amount "additional" counter_kind "counters" "on" "them" "."

/* The type count uses the battlefield before the entry event. */
/* @sem Ability::Replacement{active:Battlefield, event:Enter{objects:@and($plural, ObjectFilter::ControlledBy(One(AbilityController)))}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters{kind:$counter_kind, amount:$count_each_type_already_controlled}}}]}} */
replacement_controlled_entry_distinct_types ::= plural "you" "control" "enter" "with" "an" "additional" counter_kind "counter" "on" "them" "for" "each" count_each_type_already_controlled "."

/* @sem Expr::CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(AbilityController)))}, property:CreatureTypes} */
count_each_type_already_controlled ::= "creature" "type" "among" filter_plural "you" "already" "control"

/* Cancel only the pending destruction. Removing marked damage here has no
   regeneration tap or removal from combat. */
/* @sem Ability::Replacement{active:Battlefield,event:Object{event:Destroyed,objects:$countered_other_creature_you_control},body:_{instructions:[Effect{result:@next,operation:ModifyEvent{change:Cancel}},Effect{result:@next,operation:RemoveCounters{removals:[_{player:AbilityController,recipients:Objects(One(EventSubject)),kind:PowerToughness(1,1),amount:All}]}},Effect{result:@next,operation:RemoveMarkedDamage{objects:One(EventSubject)}}]}} */
replacement_destruction_remove_counter_and_heal ::= "if" countered_other_creature_you_control "would" "be" "destroyed" "," "instead" "remove" "all" "+" "1" "/" "+" "1" "counters" "from" "it" "and" "all" "damage" "already" "dealt" "to" "it" "is" "healed" "."

/* @sem ObjectFilter::AllOf([Not(SameObject(Source)),CardType(Creature),ControlledBy(One(AbilityController)),Counters{kind:PowerToughness(1,1),comparison:GreaterOrEqual,value:Constant(1)}]) */
countered_other_creature_you_control ::= "another" "creature" "you" "control" "with" "a" "+" "1" "/" "+" "1" "counter" "on" "it"

roll_extra_player_choice ::= roll_extra_chosen_body | roll_extra_then_choose

/* @sem Program::Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:RollExtraDie(ChosenBy(AbilityController))}}]} */
roll_extra_then_choose ::= "instead" "they" "roll" "that" "many" "dice" "plus" "one" "," "then" "you" "choose" "one" "of" "those" "rolls" "to" "ignore"
