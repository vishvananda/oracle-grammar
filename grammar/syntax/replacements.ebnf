entry_discard_keyword_vigilance ::= "vigilance"

entry_discard_keyword_first ::= entry_discard_keyword_first_flying | entry_discard_keyword_first_firststrike | entry_discard_keyword_first_doublestrike | entry_discard_keyword_first_deathtouch | entry_discard_keyword_first_hexproof | entry_discard_keyword_first_haste | entry_discard_keyword_first_indestructible | entry_discard_keyword_first_lifelink | entry_discard_keyword_first_menace | entry_discard_keyword_first_reach | entry_discard_keyword_first_trample | entry_discard_keyword_first_vigilance

