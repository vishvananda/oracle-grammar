entry_discard_keyword_first_flying ::= "it" "enters" "with" "a" "flying" "counter" "on" "it" "if" "a" "card" "discarded" "this" "way" "has" "flying"

/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:HasKeyword(FirstStrike)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:AddCounters(_{kind:Named(FirstStrikeCounter), amount:Constant(1)})}}]}, otherwise:Program{}} */
entry_discard_keyword_first_firststrike ::= "it" "enters" "with" "a" "first" "strike" "counter" "on" "it" "if" "a" "card" "discarded" "this" "way" "has" "first" "strike"

