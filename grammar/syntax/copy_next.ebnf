/* Immediate copies announce their own stack target; future copies instead
   refer to the spell observed by their future casting event. */

/* @sem Operation::CopyOnStack{actor:One(AbilityController), object:$target_stack_spell, times:Constant(1), targets:Same} */
copy_stack_spell ::= "copy" target_stack_spell

/* "Copy target instant or sorcery spell. You may choose new targets for the copy." */
/* @sem Instruction::[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$copy_stack_target, times:Constant(1), targets:May}}] */
clause_copy_new_targets ::= "copy" copy_stack_target "." "you" "may" "choose" "new" "targets" "for" ("the" | "that") "copy"
copy_stack_target ::= target_uncast_controlled_spell | target_stack_spell | target_your_stack_ability | target_your_stack_ability_from | target_your_triggered_ability | target_spell_or_stack_ability_kinds

/* "Target activated or triggered ability you control", perhaps "from an artifact source". */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Ability, zones:[Stack]}), count:Exactly(Expr::Constant(1)), filter:AllOf([AnyOf([OnStack(Activated), OnStack(Triggered)]), ControlledBy(One(AbilityController))])}), index:0} */
target_your_stack_ability ::= "target" "activated" "or" "triggered" "ability" "you" "control"
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Ability, zones:[Stack]}), count:Exactly(Expr::Constant(1)), filter:AllOf([AnyOf([OnStack(Activated), OnStack(Triggered)]), ControlledBy(One(AbilityController)), AbilityOf($adjectives)])}), index:0} */
target_your_stack_ability_from ::= "target" "activated" "or" "triggered" "ability" "you" "control" "from" ("a" | "an") adjectives "source"
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Ability, zones:[Stack]}), count:Exactly(Expr::Constant(1)), filter:AllOf([OnStack(Triggered), ControlledBy(One(AbilityController))])}), index:0} */
target_your_triggered_ability ::= "target" "triggered" "ability" "you" "control"

/* "You may choose new targets for target spell": the spell keeps its own number of
   targets, each one changed or kept. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Retarget{actor:One(AbilityController), object:$target_stack_spell, targets:Must}}]}}] */
clause_retarget_stack_spell ::= "you" "may" "choose" "new" "targets" "for" target_stack_spell

/* "Copy it" or "copy that spell": a spell named earlier, copied with new targets allowed. */
/* @sem Instruction::[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$object_ref, times:Constant(1), targets:May}}] */
clause_copy_ref_new_targets ::= "copy" object_ref "." "you" "may" "choose" "new" "targets" "for" "the" "copy"

/* "Copy that spell. The copy targets that token": the copy's new target is the
   token the instruction before created, or this card itself. The copied spell is
   named, never "it". */
/* @sem Instruction::[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$that_noun, times:Constant(1), targets:Each(Created(@prior))}}] */
clause_copy_ref_targets_created ::= "copy" that_noun "." "the" "copy" "targets" "that" "token"
/* @sem Instruction::[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$that_noun, times:Constant(1), targets:To(One($self_ref))}}] */
clause_copy_ref_targets_self ::= "copy" that_noun "." "the" "copy" "targets" self_ref

/* "Exile target instant or sorcery card from a graveyard and copy it. You may cast the
   copy": the copy is of the card the exile moved, and the cast consumes the copy. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_objects}, Effect{result:@next, operation:CopyCards{actor:One(AbilityController), objects:One(Result{result:@prior, phase:After, index:0}), times:Constant(1)}}, $copy_cast] */
clause_exile_copy_cast ::= exile_objects copy_exiled_join copy_cast
/* @sem () */
copy_exiled_join ::= "and" "copy" "it" "." | "." "copy" "that" "card" "." | "." "copy" "it" "," "then"
copy_cast ::= copy_cast_normal | copy_cast_free
/* @sem Instruction::Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Copies(@prior), count:Exactly(Constant(1)), cost:Normal, into_exile:false}}]}} */
copy_cast_normal ::= "you" "may" "cast" "the" "copy"
/* @sem Instruction::Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Copies(@prior), count:Exactly(Constant(1)), cost:Free, into_exile:false}}]}} */
copy_cast_free ::= "you" "may" "cast" "the" "copy" "without" "paying" "its" "mana" "cost"

/* "Copy it for each …": one copy for each counted thing. */
/* @sem Operation::CopyOnStack{actor:One(AbilityController), object:$object_ref, times:$count_each, targets:Same} */
copy_ref_for_each ::= "copy" object_ref "for" "each" count_each
/* @sem Instruction::[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$object_ref, times:$count_each, targets:May}}] */
clause_copy_ref_for_each_new_targets ::= "copy" object_ref "for" "each" count_each "." "you" "may" "choose" "new" "targets" "for" "the" "copies"

next_spell_filter ::= next_any_spell | next_adjective_spell | next_modified_spell | next_described_spell | next_mana_bounded_spell

/* @sem ObjectFilter::Any */
next_any_spell ::= "spell"

/* @sem $spell_adjectives */
next_adjective_spell ::= spell_adjectives "spell"

/* @sem $modifiers */
next_modified_spell ::= "spell" modifiers

/* @sem @and($spell_adjectives, $modifiers) */
next_described_spell ::= spell_adjectives "spell" modifiers

/* @sem Operation::CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:$next_spell_filter}, duration:$this_duration, announcement:Announcement{}, body:Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:Same}}]}, once:true} */
copy_next_spell ::= "copy" "the" "next" next_spell_filter "you" "cast" this_duration "when" "you" "cast" "it"

/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:$next_spell_filter}, duration:$this_duration, announcement:Announcement{}, body:Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:May}}]}, once:true}}] */
copy_next_spell_retarget ::= "copy" "the" "next" next_spell_filter "you" "cast" this_duration "when" "you" "cast" "it" "." "you" "may" "choose" "new" "targets" "for" "the" "copy"

/* The targeted declaration proves a spell-only stack population. Keep its
   existing membership reading and an explicit published stack-domain guard. */
/* @sem Instruction::[Effect{result:@next, operation:CopyEach{actor:One(AbilityController), objects:$copy_selected_spell_filter, targets:May}}] */
clause_copy_selected_spells ::= "copy" copy_selected_spell_filter "." copy_group_retarget

copy_selected_spell_filter ::= copy_selected_spell_guard | copy_selected_spell_members
/* @sem ObjectFilter::@and(ObjectFilter::InSet($copy_spell_targets), ObjectFilter::OnStack(Spell)) */
copy_selected_spell_guard ::= copy_spell_targets
/* @sem ObjectFilter::InSet($copy_spell_targets) */
copy_selected_spell_members ::= copy_spell_targets
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:$target_count_any, filter:AnyOf([CardType(Instant), CardType(Sorcery)])})) */
copy_spell_targets ::= target_count_any "target" "instant" "and" "/" "or" "sorcery" "spells"
/* @sem () */
copy_group_retarget ::= "you" "may" "choose" "new" "targets" "for" "the" "copies"

/* Fixed mana and the actual optional payment result own both copy actions.
   A spell-only filter must not be applied to the later ability-copy group. */
/* @sem Cost::@fixed_mana(Cost{parts:[Mana($mana_symbols)]}) */
copy_fixed_payment ::= mana_symbols
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$copy_fixed_payment, optional:true}}, If{condition:PaymentChosen(@marked), then:_{instructions:[Effect{result:@next, operation:CopyEach{actor:One(AbilityController), objects:@and(ObjectFilter::ControlledBy(One(AbilityController)), ObjectFilter::OnStack(Spell)), targets:May}}, Effect{result:@next, operation:CopyEach{actor:One(AbilityController), objects:@and(ObjectFilter::Not(OnStack(ThisAbility)), ObjectFilter::AnyOf([OnStack(Activated), OnStack(Triggered)]), ObjectFilter::ControlledBy(One(AbilityController))), targets:May}}]}, otherwise:_{}}] */
clause_copy_paid_stack_groups ::= "you" "may" "pay" copy_fixed_payment "." "if" "you" "do" "," "copy" "all" "spells" "you" "control" "," "then" "copy" "all" "other" "activated" "and" "triggered" "abilities" "you" "control" "." copy_group_retarget

/* Only this cast-spell producer supplies the marked result. Both copies use
   one shared filter choice, retaining two identical copy actions (one pool). */
copy_cast_spell_domain ::= copy_cast_spell_guard | copy_cast_spell_members
/* @sem ObjectFilter::OnStack(Spell) */
copy_cast_spell_guard ::= "spells"
/* @sem ObjectFilter::Any */
copy_cast_spell_members ::= "spells"

/* @sem Ability::Scoped{zones:[Stack], ability:Static(_{kind:Ordinary, affected:Objects(Zone(_{scope:Shared(Stack), kind:Spell, filter:SameObject(Source)})), changes:[Rule(Prohibit(Copy))]})} */
stack_self_copy_prohibition ::= "this" "spell" "can't" "be" "copied" "."

/* @sem Instruction::[Effect{result:@mark, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Zone(_{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:AnyOf([SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:@and(ObjectFilter::CardType(Instant), ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:AnnouncedX}}, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0}), SameObject(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:@and(ObjectFilter::CardType(Sorcery), ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:AnnouncedX}}, ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}))}), index:0})])}), count:AnyNumber, cost:Free, into_exile:true}}, If{condition:Compare{left:ObjectProperty{object:Source, property:SpellX, information:CurrentOrLastKnown}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}, then:_{instructions:[Effect{result:@next, operation:CopyEach{actor:One(AbilityController), objects:@and(ObjectFilter::InSet(Affected(@marked)), $copy_cast_spell_domain), targets:May}}, Effect{result:@next, operation:CopyEach{actor:One(AbilityController), objects:@and(ObjectFilter::InSet(Affected(@marked)), $copy_cast_spell_domain), targets:May}}]}, otherwise:_{}}] */
clause_cast_two_types_copy ::= "you" "may" "cast" "up" "to" "one" "target" "instant" "card" "and" "/" "or" "up" "to" "one" "target" "sorcery" "card" "from" "your" "graveyard" "each" "with" "mana" "value" "X" "or" "less" "without" "paying" "their" "mana" "costs" "." "if" "a" "spell" "cast" "this" "way" "would" "be" "put" "into" "your" "graveyard" "," "exile" "it" "instead" "." "if" "X" "is" number "or" "more" "," "copy" "each" "of" "those" copy_cast_spell_domain "twice" "." "you" "may" "choose" "new" "targets" "for" "the" "copies"

/* The copy and cast share the copy operation's result, independently of the
   earlier movement that supplied the cards. */
/* @sem Operation::CopyCards{actor:One(AbilityController), objects:Transition{result:@prior, phase:After}, times:Constant(1)} */
copy_prior_cards ::= "copy" "those" "cards"

/* @sem ObjectSet::Copies(@prior) */
cast_prior_copies ::= "the" "copies"

/* @sem Operation::PlayWith{actor:One(AbilityController), action:CastSpell, cards:$cast_prior_copies, count:Exactly(CountObjects($cast_prior_copies)), terms:_{cost:Free}} */
cast_all_copies_free ::= "cast" cast_prior_copies "if" "able" "without" "paying" "their" "mana" "costs"

/* Stack-copy operands compose with the ordinary target and exception phrases. */
/* @sem Operation::CopyOnStack{actor:One(AbilityController), object:$target_stack_spell, times:$value, targets:Same} */
copy_stack_spell_times ::= "copy" target_stack_spell value "times"

/* @sem Operation::CopyOnStack{actor:One(AbilityController), object:$target_stack_spell, times:Constant(1), targets:Same, exceptions:[$copy_stack_exception]} */
copy_stack_spell_except ::= "copy" target_stack_spell "," "except" copy_stack_exception

/* @sem $copy_remove_legendary */
copy_stack_exception ::= copy_remove_legendary "if" "the" "spell" "is" "legendary"

/* A referenced spell copy can announce the retargeting permission in the same sentence. */
/* @sem Instruction::[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$object_ref, times:Constant(1), targets:May}}] */
clause_copy_ref_and_new_targets ::= "copy" object_ref "," "and" "you" "may" "choose" "new" "targets" "for" "the" "copy"

/* The copied object is the ability on the stack which targeted the creature. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventStackObject, times:Constant(1), targets:May}}]} */
program_copy_targeting_ability ::= "copy" "that" "ability" "." "you" "may" "choose" "new" "targets" "for" "the" "copy" "."

/* @sem Ability::Triggered{event:$event_target_ability_singular, limits:TriggerLimits{per_turn:1}, announcement:@announcement, body:$program_copy_targeting_ability} */
triggered_targeted_ability_copy_once ::= "whenever" event_target_ability_singular "," program_copy_targeting_ability "this" "ability" "triggers" "only" "once" "each" "turn" "."

/* Copies of a previously named spell use the current requested count. */
/* @sem Instruction::[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$object_ref, times:@plural_amount($value), targets:May}}] */
clause_copy_ref_times_new_targets ::= "copy" object_ref value "times" "." "you" "may" "choose" "new" "targets" "for" "the" "copies"

/* Keep the optional retarget and its subsequent reference-copy as separate
   typed instructions while retaining their ordinary sentence order. */
/* @prefer always */
/* @sem Instruction::[...$clause_retarget_optional_stack, ...$retarget_copy_step] */
instructions_retarget_then_copy ::= clause_retarget_optional_stack "." "then" retarget_copy_step

retarget_copy_step ::= clause_copy_ref_new_targets | clause_copy_ref_times_new_targets

/* Targeting spells that entered the stack without being cast. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:AllOf([ControlledBy(One(AbilityController)), Not(Cast{})])}), index:0} */
target_uncast_controlled_spell ::= "target" "spell" "you" "control" "that" "wasn't" "cast"

/* The plural retargeting sentence accompanies a fixed pair of copies. */
/* @sem Instruction::[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$target_your_triggered_ability, times:Constant(2), targets:May}}] */
clause_copy_twice_new_targets ::= "copy" target_your_triggered_ability "twice" "." "you" "may" "choose" "new" "targets" "for" "the" "copies"

/* A conditional replacement changes the copy count for the named target. */
/* @sem Instruction::[If{condition:$condition, then:_{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$target_stack_spell, times:Constant(2), targets:May}}]}, otherwise:_{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$object_ref, times:Constant(1), targets:May}}]}}] */
clause_copy_conditional_twice ::= "copy" target_stack_spell "." "if" condition "," "copy" object_ref "twice" "instead" "." "you" "may" "choose" "new" "targets" "for" "the" "copies"

/* @sem EventSpec::ZoneChange{objects:CardType(Creature), from:Battlefield, to:Graveyard} */
event_a_creature_dies_for_copy ::= "a" "creature" "dies"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[CopyOf{object:EventSubject, exceptions:[CopyException::AddCurrentAbility]}], duration:Indefinite, evaluation:Snapshot} */
copy_dying_creature_keep_current_ability ::= "this" "creature" "becomes" "a" "copy" "of" "that" "creature" "," "except" "it" "has" "this" "ability"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$pay_mana, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:$copy_dying_creature_keep_current_ability}]}, otherwise:Program{}}]} */
paid_dying_creature_copy ::= "you" "may" pay_mana "." "if" "you" "do" "," copy_dying_creature_keep_current_ability "."

/* @prefer always */
/* @sem Ability::Triggered{event:$event_a_creature_dies_for_copy, limits:TriggerLimits{}, announcement:@announcement, body:$paid_dying_creature_copy} */
triggered_paid_dying_creature_copy ::= "whenever" event_a_creature_dies_for_copy "," paid_dying_creature_copy

/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:$spell_targets_only_self} */
event_cast_spell_targeting_only_source ::= "you" "cast" spell_targets_only_self

/* @sem Operation::CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:May} */
copy_cast_event_with_new_targets ::= "copy" "that" "spell" "." "you" "may" "choose" "new" "targets" "for" "the" "copy"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$pay_mana, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:$copy_cast_event_with_new_targets}]}, otherwise:Program{}}]} */
paid_source_targeting_spell_copy ::= "you" "may" pay_mana "." "if" "you" "do" "," copy_cast_event_with_new_targets "."

/* @prefer always */
/* @sem Ability::Triggered{event:$event_cast_spell_targeting_only_source, limits:TriggerLimits{}, announcement:@announcement, body:$paid_source_targeting_spell_copy} */
triggered_paid_source_targeting_spell_copy ::= "whenever" event_cast_spell_targeting_only_source "," paid_source_targeting_spell_copy

/* The returned object is the same announced spell that was copied. */
/* @sem Instruction::[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$target_stack_spell, times:Constant(1), targets:May}}, Effect{result:@next, operation:Move{objects:One($target_stack_spell), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_copy_spell_return_owner ::= "copy" target_stack_spell "," "then" "return" "it" "to" "its" "owner's" "hand" "." "you" "may" "choose" "new" "targets" "for" "the" "copy"

/* The linked copy phrase is used within an activation with its own linked-card limit. */
/* @sem Instruction::[Effect{result:@next, operation:CopyCards{actor:One(AbilityController), objects:One($linked_exiled_card), times:Constant(1)}}, $copy_cast_free] */
clause_copy_linked_free ::= "copy" linked_exiled_card "." copy_cast_free

/* This consumer is scoped to its explicit exile producer and its arrival receipt. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:CopyCards{actor:One(AbilityController), objects:Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([InSet(Transition{result:@prior, phase:After}), $cast_instant_or_sorcery_filter])}), times:$value}}, $copy_cast_copies_free] */
clause_exile_top_copy_selection ::= exile_top_cards_of_your_library "." "choose" "an" cast_instant_or_sorcery_filter "card" "exiled" "this" "way" "and" "copy" "it" value "times" "." copy_cast_copies_free

/* @sem Instruction::Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Copies(@prior), count:AnyNumber, cost:Free}}]}} */
copy_cast_copies_free ::= "you" "may" "cast" "the" "copies" "without" "paying" "their" "mana" "costs"

/* A loyalty activation composes the scoped producer and its consumer. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost::Cost{parts:[CostPart::Loyalty($loyalty)]}, limits:ActivationLimits{sorcery:true}, announcement:@announcement, body:Program{instructions:$clause_exile_top_copy_selection}} */
activated_exile_top_copy ::= "[" loyalty "]" ":" clause_exile_top_copy_selection "."

/* The target predicate and the copy payment are independent phrase operands;
   the unsuccessful branch is shared with the predicate's false branch. */
/* @sem Instruction::[If{condition:$stack_targets_permanent_or_player, then:Program{instructions:[$copy_stack_payment, If{condition:Not(PaymentChosen(@prior)), then:$program, otherwise:Program{}}]}, otherwise:$program}] */
instructions_conditional_stack_copy_fallback ::= copy_stack_payment "if" stack_targets_permanent_or_player "," "and" "you" "may" "choose" "new" "targets" "for" "the" "copy" "." "if" "you" "don't" "copy" "a" "spell" "this" "way" "," program

/* @sem Condition::ObjectMatches{object:$object_ref, filter:AnyOf([TargetsAny(Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase})), TargetsAny(Players(All))])} */
stack_targets_permanent_or_player ::= object_ref "targets" "a" filter_phrase "or" "player"

/* @sem Instruction::Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$object_ref, times:Constant(1), targets:May}}]}}]}}} */
copy_stack_payment ::= "copy" object_ref

/* The copied stack ability is supplied by the activation event. */
activation_event_for_that_ability_copy ::= event_clause_you_activate_targeting_ability | activation_copy_event

/* @sem Ability::Triggered{event:$activation_event_for_that_ability_copy, limits:TriggerLimits{}, announcement:@announcement, body:$program_copy_targeting_ability} */
triggered_activation_copy_that_ability ::= activation_event_for_that_ability_copy "," program_copy_targeting_ability

/* The singular exile produces the card copied by the next instruction. */
/* @sem Operation::Move{objects:One($target_card_arrived_this_turn), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_arrived_card ::= "exile" target_card_arrived_this_turn

/* @sem Instruction::Effect{result:@next, operation:CopyCards{actor:One(AbilityController), objects:One(Result{result:@prior, phase:After, index:0}), times:Constant(1)}} */
copy_singular_exile_result ::= "copy" "it"

/* @sem Instruction::[Effect{result:@next, operation:$exile_arrived_card}, $copy_singular_exile_result, $copy_cast] */
clause_exile_arrived_copy_cast ::= exile_arrived_card "." copy_singular_exile_result "." copy_cast

/* Two independently conditional copies of referenced stack objects share the retarget permission. */
/* @sem Instruction::[If{condition:$condition_one, then:Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$object_ref, times:Constant(1), targets:May}}]}, otherwise:Program{}}, If{condition:$condition_one_2, then:Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$object_ref_2, times:Constant(1), targets:May}}]}, otherwise:Program{}}] */
conditional_copy_pair ::= "copy" object_ref "if" condition_one "," "then" "copy" object_ref "if" condition_one "." "you" "may" "choose" "new" "targets" "for" "the" "copies"

/* A spell's type and mana-value bound are independent filter operands. */
/* @sem @and($spell_adjectives, $modifier_mana_value_bound) */
next_mana_bounded_spell ::= spell_adjectives "spell" modifier_mana_value_bound

/* The conditional continuation supplies both branches of the future copy. */
/* @sem Instruction::If{condition:$condition, then:_{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:May}}, Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:May}}]}, otherwise:_{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:EventSubject, times:Constant(1), targets:May}}]}} */
next_copy_conditional_twice ::= "if" condition "," "copy" "that" "spell" "twice" "instead" "." "you" "may" "choose" "new" "targets" "for" "the" "copies"

/* @sem Instruction::[Effect{result:@next, operation:@scope(Operation::CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:$next_spell_filter}, duration:$this_duration, announcement:@announcement, body:_{instructions:[$next_copy_conditional_twice]}, once:true})}] */
copy_next_spell_conditional ::= "copy" "the" "next" next_spell_filter "you" "cast" this_duration "when" "you" "cast" "it" "." next_copy_conditional_twice

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Any, zones:[Stack]}), count:Exactly(Constant(1)), filter:AnyOf([AllOf([OnStack(Spell), CardType(Instant)]), AllOf([OnStack(Spell), CardType(Sorcery)]), OnStack(Activated), OnStack(Triggered)])}), index:0} */
target_spell_or_stack_ability_kinds ::= "target" "instant" "spell" "," "sorcery" "spell" "," "activated" "ability" "," "or" "triggered" "ability"

/* A single activation announces one target; both copies refer to that target. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Spell, zones:[Stack]}), count:Exactly(Expr::Constant(1)), filter:$stack_spell_filter}), index:0}, times:Constant(1), targets:May}}, Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:Target{slot:0, index:0}, times:Constant(1), targets:May}}]}} */
activated_copy_stack_twice ::= cost ":" "copy" "target" stack_spell_filter "twice" "." "you" "may" "choose" "new" "targets" "for" "the" "copies" "."

/* A stack copy receives these abilities only when it is a permanent spell.
   The quotation is scoped to the copied object's ability holder. */
/* @sem Instruction::[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:$object_ref, times:Constant(1), targets:May, exceptions:[IfPermanentSpell([$copy_added_keyword, $copy_quoted_ability])]}}] */
clause_copy_permanent_grants ::= "copy" object_ref "and" "you" "may" "choose" "new" "targets" "for" "the" "copy" "." "if" "the" "copy" "is" "a" "permanent" "spell" "," "it" "gains" copy_added_keyword "and" copy_quoted_ability
