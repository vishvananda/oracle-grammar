/* @sem String::'Descend 8' */
label_descend_eight ::= "descend" "8"

/* Removable ability words: CR 207.2c, effective 2026-09-25.
   https://media.wizards.com/2026/downloads/MagicCompRules%2020260925.txt
   Unknown flavor labels stay visible; a dash alone proves no presentation role. */
/* @sem String::'Adamant' */
label_adamant ::= "adamant"
/* @sem String::'Addendum' */
label_addendum ::= "addendum"
/* @sem String::'Bloodrush' */
label_bloodrush ::= "bloodrush"
