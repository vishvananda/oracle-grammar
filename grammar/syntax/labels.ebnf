/* Modal flavor words have no rules meaning (CR 207.2d; AFR release notes).
   This explicit catalogue is consumed in the grammar, never stripped from input.
   Only bullet modes accept these labels; mechanical/unknown prefixes refuse. */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:$program_sentence, weight:1}) */
mode_flavor_labelled ::= "•" ("Antimagic" "Cone" | "fear" "Ray"
    | "intimidate" "Them" | "Fend" "Them" "Off" | "Sort" "Inventory"
    | "Pick" "a" "Perk" | "Check" "Map" | "Combine" "Powers" "!" | "defense" "!" | "fight" "!") "—" program_sentence

/* A meaningful heading governs both independently stated static grants. */
/* @sem Ability::[Conditional{condition:$max_speed_prefix, then:[Static{kind:Ordinary, affected:Objects($affected), changes:$static_changes}], otherwise:[]}, Conditional{condition:$max_speed_prefix, then:[Static{kind:Ordinary, affected:Objects($affected_2), changes:$static_changes_2}], otherwise:[]}] */
line_max_speed_static_pair ::= max_speed_prefix affected static_changes "and" affected static_changes "."
