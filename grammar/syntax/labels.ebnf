/* The cast or copy event supplies one spell for both independent thresholds. */
/* @prefer always */
/* @sem Ability::WithPresentation{label:$ability_label, reminder:false, ability:Triggered{event:$event_cast_or_copy, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Scry{players:One(AbilityController), amount:$number}}, If{condition:$event_spell_mana_threshold, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:$token_groups, entry:BattlefieldArrival{}}}]}, otherwise:Program{}}, If{condition:$event_spell_mana_threshold_2, then:Program{instructions:$clause_random_opponent_damage}, otherwise:Program{}}]}}} */
labelled_spell_scry_and_thresholds ::= ability_label "—" "whenever" event_cast_or_copy "," "scry" number "." "if" event_spell_mana_threshold "," "create" token_groups "." "if" event_spell_mana_threshold "," clause_random_opponent_damage "."

/* @sem Condition::ObjectMatches{object:EventSubject, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:$bound, value:$number}}} */
event_spell_mana_threshold ::= "that" "spell's" "mana" "value" "is" number "or" bound
