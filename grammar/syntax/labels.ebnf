/* A cosmetic ability word, per the March of the Machine release notes:
   https://magic.wizards.com/en/news/feature/march-of-the-machine-release-notes
   The following vote, planeswalk and chaos instructions retain their meaning. */
/* @sem String::'Will of the Planeswalkers' */
label_will_of_the_planeswalkers ::= "will" "of" "the" "planeswalkers"

/* CR 702.178: this prefix grants an ability only at max speed. It carries
   meaning, and the granted ability keeps any explicit operating zones. */
/* @sem Condition::PlayerState{player:AbilityController, state:MaxSpeed} */
max_speed_prefix ::= "max" "speed" "—"
/* @sem Ability::@conditional_ability($max_speed_prefix, $ability) */
max_speed_ability ::= max_speed_prefix ability
/* @sem Ability::@conditional_ability($max_speed_prefix, $token_ability_sentence) */
max_speed_sentence ::= max_speed_prefix token_ability_sentence

/* Flavor words with no rules meaning (CR 207.2d). Seeded only from headings
   observed on explicitly unsealed faces and listed in the pinned MTGish
   FlavorWord catalogue. Mechanical and unknown prefixes are never inferred
   from dash syntax. This catalogue classifies rules-text omission only;
   exact flavor-heading parsing/printing remains a separate presentation gate. */
rules_flavor_label ::= flavor_group_0 | flavor_group_1 | flavor_group_2 | flavor_group_3 | flavor_group_4 | flavor_group_5 | flavor_group_6 | flavor_group_7 | flavor_group_8 | flavor_group_9 | flavor_group_10 | flavor_group_11 | flavor_group_12 | flavor_group_13 | flavor_group_14 | flavor_group_15 | flavor_group_16 | flavor_group_17 | flavor_group_18 | flavor_group_19 | flavor_group_20 | flavor_group_21 | flavor_group_22 | flavor_group_23 | flavor_group_24 | flavor_group_25 | flavor_group_26 | flavor_group_27
