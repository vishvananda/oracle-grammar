/* Ability words carry presentation, without adding a binding or holder scope.
   Mechanical prefixes and chapter numbers retain their own productions. */

/* @sem Ability::WithPresentation{label:$ability_label, reminder:false, ability:$ability} */
labelled_ability ::= ability_label "—" ability

/* @sem Ability::WithPresentation{label:$ability_label, reminder:false, ability:$token_ability_sentence} */
token_labelled_sentence ::= ability_label "—" token_ability_sentence

/* @sem Ability::WithPresentation{label:$ability_label, reminder:false, ability:$keyword_ability} */
token_labelled_keyword ::= ability_label "—" keyword_ability

/* A second paragraph replaces one action at resolution, retaining any condition
   on the original action in the otherwise branch. Selection/zone-change steps
   within a longer search program need their own composition. */
/* @sem Ability::WithPresentation{label:$ability_label, reminder:false, ability:Spell{announcement:@announcement, body:Program{instructions:[If{condition:$condition, then:Program{instructions:$spell_override_action}, otherwise:Program{instructions:$spell_override_initial}}]}}} */
labelled_spell_override ::= spell_override_initial "." NEWLINE ability_label "—" spell_override_action "instead" "if" condition "."

/* The label heads a resolving spell paragraph. An explicit "instead"
   replaces the preceding action; a plain condition appends a new action. */
/* @sem Ability::WithPresentation{label:$ability_label, reminder:false, ability:Spell{announcement:@announcement, body:Program{instructions:[If{condition:$condition, then:Program{instructions:$labelled_spell_replacement}, otherwise:Program{instructions:$spell_override_initial}}]}}} */
labelled_spell_if_override ::= spell_override_initial "." NEWLINE ability_label "—" "if" condition "," labelled_spell_replacement "."

/* The conditional sentence refers back to the same controlled creature group. */
/* @sem Ability::WithPresentation{label:$ability_label, reminder:false, ability:Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), $creature_controller_modifier])}), changes:$plural_private_pump, duration:$duration, evaluation:Snapshot}}, If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), $creature_controller_modifier])}), changes:[GrantKeyword($keyword_name)], duration:$duration_2, evaluation:Snapshot}}]}, otherwise:Program{}}]}}} */
labelled_population_grant ::= "creatures" creature_controller_modifier plural_private_pump duration "." NEWLINE ability_label "—" "if" condition "," "those" "creatures" "also"? "gain" keyword_name duration "."
/* @sem Ability::@contextual_reminder($labelled_population_grant, $creature_population_grant_explanation) */
labelled_population_grant_reminded ::= labelled_population_grant "(" creature_population_grant_explanation ")"
creature_population_grant_explanation ::= indestructible_plural_explanation | vigilance_plural_explanation

/* @sem Ability::WithPresentation{label:$ability_label, reminder:false, ability:Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), $creature_controller_modifier])}), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}, If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Recipients::Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), $creature_controller_modifier])}), kind:$counter_kind, amount:Constant(1)}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), $creature_controller_modifier])}), changes:[GrantKeyword($keyword_name_2)], duration:$duration_2, evaluation:Snapshot}}]}, otherwise:Program{}}]}}} */
labelled_population_counter ::= "creatures" creature_controller_modifier "gain" keyword_name duration "." NEWLINE ability_label "—" "if" condition "," "put" "a" counter_kind "counter" "on" "each" "of" "those" "creatures" "and" "they" "gain" keyword_name duration "."

/* The explicit replacement covers the preceding paragraph as a unit. */
/* @sem Ability::WithPresentation{label:$ability_label, reminder:false, ability:Spell{announcement:@announcement, body:Program{instructions:[If{condition:$condition, then:$program_sentence, otherwise:Program{instructions:$instructions}}]}}} */
labelled_spell_program_override ::= instructions "." NEWLINE ability_label "—" "if" condition "," "instead" program_sentence

/* @sem Ability::WithPresentation{label:$label_will_of_the_planeswalkers, reminder:false, ability:Spell{announcement:@announcement, body:Program{instructions:[...$vote_spell_prefix, ...$clause_word_vote, ...$planeswalk_vote_outcomes]}}} */
labelled_spell_vote ::= vote_spell_prefix "." NEWLINE label_will_of_the_planeswalkers "—" clause_word_vote "." planeswalk_vote_outcomes "."
vote_spell_prefix ::= instructions_discard_hand_mana_draw | instructions_mill_graveyard_entry | instructions

labelled_spell_replacement ::= kicker_replacement_standard | labelled_spell_replacement_then
/* @sem Vec<Instruction>::@then_sequence($clause_before_then, $clause) */
labelled_spell_replacement_then ::= "instead" clause_before_then "," "then" clause

/* @sem Ability::WithPresentation{label:$ability_label, reminder:false, ability:Spell{announcement:@announcement, body:Program{instructions:[...$instructions, @leading_if(Instruction::If{condition:$condition, then:Program{instructions:$clause}, otherwise:Program{}})]}}} */
labelled_spell_followup ::= instructions "." NEWLINE ability_label "—" "if" condition "," clause "."

/* @sem Ability::WithPresentation{label:$ability_label, reminder:true, ability:Spell{announcement:@announcement, body:Program{instructions:[...$instructions, ...$reminder_if]}}} */
labelled_spell_reminder_followup ::= instructions "." NEWLINE ability_label "—" reminder_if

spell_override_initial ::= spell_override_action | spell_override_initial_if

/* @sem Instruction::[If{condition:$condition, then:Program{instructions:$spell_override_action}, otherwise:Program{}}] */
spell_override_initial_if ::= spell_override_action "if" condition

spell_override_action ::= spell_override_you | spell_override_imperative | clause_operation | spell_override_third | spell_override_they

/* @sem @apply(PlayerSet::One(PlayerRef::AbilityController), $verbs_base_one) */
spell_override_you ::= "you" verbs_base_one

/* @sem @apply(PlayerSet::One(PlayerRef::AbilityController), $verbs_base_one) */
spell_override_imperative ::= verbs_base_one

/* @sem @apply($players_singular, $verbs_third_one) */
spell_override_third ::= players_singular verbs_third_one

/* @sem @apply(PlayerSet::One(@that_player), $verbs_base_one) */
spell_override_they ::= "they" verbs_base_one

ability_label ::= label_actualize | label_landfall | label_threshold | label_delirium | label_domain
    | label_raid | label_heroic | label_constellation | label_metalcraft | label_magecraft
    | label_morbid | label_corrupted | label_hellbent | label_alliance | label_enrage
    | label_battalion | label_ferocious | label_strive | label_pack_tactics
    | label_descend_four | label_descend_eight
    | label_adamant | label_addendum | label_bloodrush | label_celebration
    | label_channel | label_chroma | label_cohort | label_converge
    | label_councils_dilemma | label_coven | label_disappear | label_eerie
    | label_eminence | label_fateful_hour | label_fathomless_descent | label_flurry
    | label_formidable | label_grandeur | label_imprint | label_infusion
    | label_inspired | label_join_forces | label_kinship | label_lieutenant
    | label_opus | label_paradox | label_parley | label_radiance
    | label_rally | label_renew | label_repartee | label_revolt
    | label_secret_council | label_spell_mastery | label_survival | label_sweep
    | label_tempting_offer | label_undergrowth | label_valiant | label_vivid
    | label_void | label_will_of_the_council | label_will_of_the_planeswalkers
    | label_battlefront | label_federation | label_seek_out | label_strange_new_worlds
    | rules_flavor_label

/* @sem String::'Landfall' */
label_landfall ::= "landfall"
/* @sem String::'Threshold' */
label_threshold ::= "threshold"
/* @sem String::'Delirium' */
label_delirium ::= "delirium"
/* @sem String::'Domain' */
label_domain ::= "domain"
/* @sem String::'Raid' */
label_raid ::= "raid"
/* @sem String::'Heroic' */
label_heroic ::= "heroic"
/* @sem String::'Constellation' */
label_constellation ::= "constellation"
/* @sem String::'Metalcraft' */
label_metalcraft ::= "metalcraft"
/* @sem String::'Magecraft' */
label_magecraft ::= "magecraft"
/* @sem String::'Morbid' */
label_morbid ::= "morbid"
/* @sem String::'Corrupted' */
label_corrupted ::= "corrupted"
/* @sem String::'Hellbent' */
label_hellbent ::= "hellbent"
/* @sem String::'Alliance' */
label_alliance ::= "alliance"
/* @sem String::'Enrage' */
label_enrage ::= "enrage"
