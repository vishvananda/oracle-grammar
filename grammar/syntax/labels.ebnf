/* Ability words carry presentation, without adding a binding or holder scope.
   Mechanical prefixes and chapter numbers retain their own productions. */

/* @sem Ability::WithPresentation{label:$ability_label, reminder:false, ability:$ability} */
labelled_ability ::= ability_label "—" ability

/* @sem Ability::WithPresentation{label:$ability_label, reminder:false, ability:$token_ability_sentence} */
token_labelled_sentence ::= ability_label "—" token_ability_sentence

/* @sem Ability::WithPresentation{label:$ability_label, reminder:false, ability:$keyword_ability} */
token_labelled_keyword ::= ability_label "—" keyword_ability

/* A second paragraph replaces one action at resolution, retaining any condition
   on the original action in the otherwise branch. Selection/zone-change steps
   within a longer search program need their own composition. */
/* @sem Ability::WithPresentation{label:$ability_label, reminder:false, ability:Spell{announcement:@announcement, body:Program{instructions:[If{condition:$condition, then:Program{instructions:$spell_override_action}, otherwise:Program{instructions:$spell_override_initial}}]}}} */
labelled_spell_override ::= spell_override_initial "." NEWLINE ability_label "—" spell_override_action "instead" "if" condition "."

spell_override_initial ::= spell_override_action | spell_override_initial_if

/* @sem Instruction::[If{condition:$condition, then:Program{instructions:$spell_override_action}, otherwise:Program{}}] */
spell_override_initial_if ::= spell_override_action "if" condition

spell_override_action ::= spell_override_you | spell_override_imperative | clause_operation | spell_override_third | spell_override_they

/* @sem @apply(PlayerSet::One(PlayerRef::AbilityController), $verbs_base_one) */
spell_override_you ::= "you" verbs_base_one

/* @sem @apply(PlayerSet::One(PlayerRef::AbilityController), $verbs_base_one) */
spell_override_imperative ::= verbs_base_one

/* @sem @apply($players_singular, $verbs_third_one) */
spell_override_third ::= players_singular verbs_third_one

/* @sem @apply(PlayerSet::One(@that_player), $verbs_base_one) */
spell_override_they ::= "they" verbs_base_one

ability_label ::= label_landfall | label_threshold | label_delirium | label_domain
    | label_raid | label_heroic | label_constellation | label_metalcraft | label_magecraft
    | label_morbid | label_corrupted | label_hellbent | label_alliance | label_enrage
    | label_battalion | label_ferocious | label_strive | label_pack_tactics
    | label_descend_four | label_descend_eight
    | label_adamant | label_addendum | label_bloodrush | label_celebration
    | label_channel | label_chroma | label_cohort | label_converge
    | label_councils_dilemma | label_coven | label_disappear | label_eerie
    | label_eminence | label_fateful_hour | label_fathomless_descent | label_flurry
    | label_formidable | label_grandeur | label_imprint | label_infusion
    | label_inspired | label_join_forces | label_kinship | label_lieutenant
    | label_opus | label_paradox | label_parley | label_radiance
    | label_rally | label_renew | label_repartee | label_revolt
    | label_secret_council | label_spell_mastery | label_survival | label_sweep
    | label_tempting_offer | label_undergrowth | label_valiant | label_vivid
    | label_void | label_will_of_the_council | label_will_of_the_planeswalkers

/* @sem String::'Landfall' */
label_landfall ::= "landfall"
/* @sem String::'Threshold' */
label_threshold ::= "threshold"
/* @sem String::'Delirium' */
label_delirium ::= "delirium"
