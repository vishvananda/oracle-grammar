/* @sem Ability::Mechanic{mechanic:Decayed} */
bare_decayed ::= "decayed"

/* A permanent or suspended card is an implied target-domain choice inside one
   printed mode. Each alternative owns its target scope and target kind. */

/* @sem @scope(Mode::Mode{announcement:_{targets:[], modes:_{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_head}), index:0})), kind:$counter_kind, amount:Count(Exactly($value))}]}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Exile]}), count:Exactly(Constant(1)), filter:State(Suspended)}), index:0})), kind:$counter_kind, amount:Count(Exactly($value))}]}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied}}, body:_{}, weight:1}) */
suspended_counter_remove_mode ::= "•" "remove" value counter_kind "counters" "from" "target" filter_head "or" "suspended" "card" "."

/* @sem @scope(Mode::Mode{announcement:_{targets:[], modes:_{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($suspended_counter_put_domain, ObjectFilter::@agree(ObjectFilter::Counters(_{kind:$counter_kind, comparison:Greater, value:Constant(0)}), ObjectFilter::Counters(_{kind:$counter_kind_2, comparison:Greater, value:Constant(0)})))}), index:0})), kind:$counter_kind, amount:$value}]}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Exile]}), count:Exactly(Constant(1)), filter:State(Suspended)}), index:0})), kind:$counter_kind, amount:$value}]}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied}}, body:_{}, weight:1}) */
suspended_counter_put_mode ::= "•" "put" value counter_kind "counters" "on" "target" suspended_counter_put_domain "with" "a" counter_kind "counter" "on" "it" "or" "suspended" "card" "."

suspended_counter_put_domain ::= noun_permanent | noun_artifact | noun_battle | noun_creature | noun_enchantment | noun_land | noun_planeswalker
/* Permanent/Battlefield is already the target domain. Typeless permanents
   remain eligible when they have the printed counter. */
/* suspended_counter_permanent is shared as noun_permanent. */

/* The attack declaration offers exert and links this spell-shaped trigger.
   Its targets belong to the linked ability, never to a resolution payment.
   Targetless Program operands keep their established independent production. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(One($exert_attack_source)), changes:[Rule(MayExert(Ability(@scope(Ability::Spell{announcement:@announcement, body:$exert_targeted_program}))))]} */
exert_targeted_ability ::= "you" "may" "exert" exert_attack_source "as" exert_attack_pronoun "attacks" "." "when" "you" "do" "," exert_targeted_program
/* @sem ObjectRef::Source */
exert_attack_source ::= "this" "creature" | self_named
/* @sem () */
exert_attack_pronoun ::= "it" | "he" | "she"
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$exert_targeted_operation}]} */
exert_targeted_program ::= exert_targeted_operation "."
exert_targeted_operation ::= continuous_defined_equal_pump | exert_targeted_rule | exert_targeted_change | exert_targeted_damage | exert_targeted_return
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($target_object)), changes:$rule_changes, duration:$duration, evaluation:LiveObjects} */
exert_targeted_rule ::= target_object rule_changes duration
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($target_object)), changes:$changes, duration:$duration, evaluation:Snapshot} */
exert_targeted_change ::= target_object changes duration
/* @sem Operation::DealDamage{source:Source, recipients:Objects(One($target_object)), amount:$value, preventable:true} */
exert_targeted_damage ::= exert_attack_pronoun "deals" value "damage" "to" target_object
/* @sem Operation::Move{objects:One($target_card), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
exert_targeted_return ::= "return" target_card "to" "the" "battlefield"

/* Backup's comma lists stay local to its closed all-following-abilities body.
   Level/Class stage boundaries retain their previous grammar. */
backup_stage_abilities ::= backup_stage_keywords | stage_line | stage_keyword
    | backup_stage_lines_more | backup_stage_keyword_more
/* @sem Ability::[...$stage_line, ...$backup_stage_abilities] */
backup_stage_lines_more ::= stage_line NEWLINE backup_stage_abilities
/* @sem Ability::[...$stage_keyword, ...$backup_stage_abilities] */
backup_stage_keyword_more ::= stage_keyword NEWLINE backup_stage_abilities
/* @sem Ability::[...$stage_keyword, ...$backup_stage_keyword_tail] */
backup_stage_keywords ::= stage_keyword "," backup_stage_keyword_tail
backup_stage_keyword_tail ::= stage_keyword | backup_stage_keywords | backup_stage_keyword_more

/* A commander deck-building action occurs before play, separately from the
   source's continuing color property. Neither is an in-game ChooseValue effect. */
/* @sem Ability::[$commander_pregame_rule, $commander_color_property] */
line_commander_pregame ::= commander_pregame_rule commander_color_property

/* @sem Ability::CommanderDeckRule($commander_pregame_action) */
commander_pregame_rule ::= "if" self_text "is" "your" "commander" "," commander_pregame_action "before" "the" "game" "begins" "."

/* @sem Operand::Term{family:DeckBuildingAction, form:ChooseAColor, operands:[Term{family:ChoosableColor, form:AnyColor}]} */
commander_pregame_action ::= "choose" "a" "color"

/* Chosen color remains the native ordinary all-zone property. A literal
   source color is a characteristic-defining ability, with its own native shape. */
commander_color_property ::= commander_chosen_property | commander_defined_property
/* @sem Ability::Static{kind:Ordinary, affected:Objects(AnyZone(SameObject(Source))), changes:[ChosenColor{mode:Set}]} */
commander_chosen_property ::= self_text "is" "the" "chosen" "color" "."
/* @sem Ability::Static{kind:CharacteristicDefining{contributes_to_color_identity:true}, affected:Objects(One(Source)), changes:$cross_colors} */
commander_defined_property ::= self_text "is" cross_colors "."

crew_ability ::= crew_unrestricted | crew_restricted | crew_reminded

/* Cost keywords hold their printed payment as the mechanic's cost. */
/* @sem Ability::Mechanic{mechanic:$cost_keyword_name, cost:$keyword_payment} */
mechanic_cost_keyword ::= cost_keyword_name keyword_payment
cost_keyword_name ::= mechanic_echo_name | mechanic_mutate_name | mechanic_encore_name | mechanic_sneak_name | mechanic_offspring_name | mechanic_reconfigure_name | hand_mechanic_miracle | mechanic_mayhem_name | mechanic_embalm_name | mechanic_specialize_name | mechanic_scavenge_name | mechanic_emerge_name | mechanic_squad_name | mechanic_outlast_name | mechanic_harmonize_name | mechanic_transmute_name | mechanic_eternalize_name | mechanic_prowl_name | mechanic_spectacle_name | mechanic_web_slinging_name | mechanic_recover_name | mechanic_fortify_name | mechanic_disturb_name | mechanic_more_than_meets_the_eye_name | mechanic_upkeep_name | mechanic_aura_swap_name | mechanic_beam_name | mechanic_commander_ninjutsu_name | mechanic_cumulative_upkeep_name | mechanic_disguise_name | mechanic_emerge_artifact_name | mechanic_transfigure_name
/* @sem Mechanic::Echo */
mechanic_echo_name ::= "echo"
/* @sem Mechanic::Mutate */
mechanic_mutate_name ::= "mutate"
/* @sem Mechanic::Encore */
mechanic_encore_name ::= "encore"
/* @sem Mechanic::Sneak */
mechanic_sneak_name ::= "sneak"
/* @sem Mechanic::Offspring */
mechanic_offspring_name ::= "offspring"
/* @sem Mechanic::Reconfigure */
mechanic_reconfigure_name ::= "reconfigure"

/* @sem Mechanic::Mayhem */
mechanic_mayhem_name ::= "mayhem"
/* @sem Mechanic::Embalm */
mechanic_embalm_name ::= "embalm"
/* @sem Mechanic::Specialize */
mechanic_specialize_name ::= "specialize"
/* @sem Mechanic::Scavenge */
mechanic_scavenge_name ::= "scavenge"
/* @sem Mechanic::Emerge */
mechanic_emerge_name ::= "emerge"
/* @sem Mechanic::Squad */
mechanic_squad_name ::= "squad"
/* @sem Mechanic::Outlast */
mechanic_outlast_name ::= "outlast"
/* @sem Mechanic::Harmonize */
mechanic_harmonize_name ::= "harmonize"
/* @sem Mechanic::Transmute */
mechanic_transmute_name ::= "transmute"
/* @sem Mechanic::Eternalize */
mechanic_eternalize_name ::= "eternalize"
/* @sem Mechanic::Prowl */
mechanic_prowl_name ::= "prowl"
/* @sem Mechanic::Spectacle */
mechanic_spectacle_name ::= "spectacle"
/* @sem Mechanic::WebSlinging */
mechanic_web_slinging_name ::= "web-slinging"
/* @sem Mechanic::Recover */
mechanic_recover_name ::= "recover"
/* @sem Mechanic::Fortify */
mechanic_fortify_name ::= "fortify"
/* @sem Mechanic::Disturb */
mechanic_disturb_name ::= "disturb"
/* @sem Mechanic::MoreThanMeetsTheEye */
mechanic_more_than_meets_the_eye_name ::= "more" "Than" "Meets" "the" "Eye"

/* Numbered keywords whose amount may be any value. */
/* @sem Ability::Mechanic{mechanic:$valued_keyword_name, amount:$value} */
mechanic_valued_keyword ::= valued_keyword_name value
valued_keyword_name ::= mechanic_saddle_name | mechanic_modular_name | mechanic_bloodthirst_name | mechanic_renown_name
    | mechanic_fading_name | mechanic_vanishing_name | mechanic_casualty_name | mechanic_fabricate_name
    | mechanic_mobilize_name | mechanic_dredge_name | mechanic_graft_name | mechanic_afterlife_name
    | mechanic_tribute_name | mechanic_afflict_name | mechanic_amplify_name | mechanic_ripple_name
    | mechanic_starting_intensity_name
/* @sem Mechanic::Saddle */
mechanic_saddle_name ::= "saddle"
/* @sem Mechanic::Modular */
mechanic_modular_name ::= "modular"
/* @sem Mechanic::Bloodthirst */
mechanic_bloodthirst_name ::= "bloodthirst"
/* @sem Mechanic::Renown */
mechanic_renown_name ::= "renown"
/* @sem Mechanic::Fading */
mechanic_fading_name ::= "fading"
/* Vanishing's amount is the time counters its permanent enters with. */
/* @sem Mechanic::VanishingEnters */
mechanic_vanishing_name ::= "vanishing"
/* @sem Mechanic::Casualty */
mechanic_casualty_name ::= "casualty"
/* @sem Mechanic::Fabricate */
mechanic_fabricate_name ::= "fabricate"
/* @sem Mechanic::Mobilize */
mechanic_mobilize_name ::= "mobilize"
/* @sem Mechanic::Dredge */
mechanic_dredge_name ::= "dredge"
/* @sem Mechanic::Graft */
mechanic_graft_name ::= "graft"
/* @sem Mechanic::Afterlife */
mechanic_afterlife_name ::= "afterlife"
/* @sem Mechanic::Tribute */
mechanic_tribute_name ::= "tribute"
/* @sem Mechanic::Afflict */
mechanic_afflict_name ::= "afflict"
/* @sem Mechanic::Amplify */
mechanic_amplify_name ::= "amplify"
/* @sem Mechanic::Ripple */
mechanic_ripple_name ::= "ripple"
/* @sem Mechanic::StartingIntensity */
mechanic_starting_intensity_name ::= "starting" "intensity"

/* @sem Ability::Mechanic{mechanic:Affinity, filter:$filter_plural} */
mechanic_affinity ::= "affinity" "for" filter_plural
/* Devour alone eats creatures; a named devour eats its own kind. */
mechanic_devour ::= mechanic_devour_creatures | mechanic_devour_named
/* @sem Ability::Mechanic{mechanic:Devour, amount:$devour_amount, filter:CardType(Creature)} */
mechanic_devour_creatures ::= "devour" devour_amount
/* @sem Ability::Mechanic{mechanic:Devour, amount:$devour_amount, filter:$filter_phrase} */
mechanic_devour_named ::= "devour" filter_phrase devour_amount

/* The mechanic supplies the producer for this count; its filter remains independent. */
devour_amount ::= devour_plain_amount | devour_defined_amount
/* @prefer always */
/* @sem $value */
devour_plain_amount ::= value
/* @sem $devour_count */
devour_defined_amount ::= "X" "," "where" "X" "is" devour_count
/* @sem Expr::Earlier{what:Devoured, measure:Count, filter:$filter_plural} */
devour_count ::= "the" "number" "of" filter_plural "devoured" "this" "way"
/* @sem Ability::Mechanic{mechanic:Champion, filter:$filter_phrase} */
mechanic_champion ::= "champion" ("a" | "an") filter_phrase

/* Craft (CR 702.167) names its materials and an optional count as printed. The
   cost is the pinned IR's mana-symbol operand list, as for kicker. */
mechanic_craft ::= craft_one | craft_at_least | craft_exactly | craft_at_least_any
/* @sem Ability::Craft{materials:$craft_material, cost:List($kicker_operands)} */
craft_one ::= "craft" "with" craft_material kicker_operands
/* @sem Ability::Craft{materials:$craft_materials, count:[GreaterOrEqual, $value], cost:List($kicker_operands)} */
craft_at_least ::= "craft" "with" value "or" "more" craft_materials kicker_operands
/* @sem Ability::Craft{materials:$craft_materials, count:[Equal, $value], cost:List($kicker_operands)} */
craft_exactly ::= "craft" "with" value craft_materials kicker_operands
/* @sem Ability::Craft{materials:Term{family:Craftable, form:AnyCard}, count:[GreaterOrEqual, $value], cost:List($kicker_operands)} */
craft_at_least_any ::= "craft" "with" value "or" "more" kicker_operands
craft_material ::= craft_artifact | craft_creature | craft_land_type | craft_type_list
craft_materials ::= craft_artifacts | craft_creatures | craft_creature_types | craft_nonlands_activated | craft_shared_card_type
/* @sem Operand::Term{family:Craftable, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Artifact}]} */
craft_artifact ::= "artifact"
/* @sem Operand::Term{family:Craftable, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Creature}]} */
craft_creature ::= "creature"
/* @sem Operand::Term{family:Craftable, form:IsLandType, operands:[Vocabulary{family:LandType, form:@subtype_name($craft_land_subtype)}]} */
craft_land_type ::= craft_land_subtype
craft_land_subtype ::= st_cave | st_island
/* @sem Operand::Term{family:Craftable, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Artifact}]} */
craft_artifacts ::= "artifacts"
/* @sem Operand::Term{family:Craftable, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Creature}]} */
craft_creatures ::= "creatures"
/* @sem Operand::Term{family:Craftable, form:IsCreatureType, operands:[Vocabulary{family:CreatureType, form:@subtype_name($subtype_plural)}]} */
craft_creature_types ::= subtype_plural

/* Deck rules printed as keywords. A named partner is another card's name. */
keyword_deck_rule ::= deck_rule_partner | deck_rule_partner_with | deck_rule_partner_kind
    | deck_rule_choose_background | deck_rule_doctors_companion
/* @sem Ability::DeckRule(Partner(Any)) */
deck_rule_partner ::= "partner"
/* @sem Ability::DeckRule(Partner(With($referenced_card_name))) */
deck_rule_partner_with ::= "partner" "with" referenced_card_name
/* @sem Ability::DeckRule(Partner($partner_kind)) */
deck_rule_partner_kind ::= "partner" "―" partner_kind
partner_kind ::= partner_friends_forever | partner_character_select | partner_father_and_son
    | partner_survivors
/* @sem PartnerKind::FriendsForever */
partner_friends_forever ::= "friends" "forever"
/* @sem PartnerKind::CharacterSelect */
partner_character_select ::= "Character" "select"
/* @sem PartnerKind::FatherAndSon */
partner_father_and_son ::= "Father" "&" "son"
/* @sem PartnerKind::Survivors */
partner_survivors ::= "survivors"
/* @sem Ability::DeckRule(ChooseBackground) */
deck_rule_choose_background ::= "choose" "a" "Background"
/* @sem Ability::DeckRule(DoctorsCompanion) */
deck_rule_doctors_companion ::= "doctor's" "companion"

/* Deck rules written as sentences. None changes a game in progress. */
deck_rule_sentence ::= deck_rule_commander | deck_rule_any_copies | deck_rule_up_to_copies
    | deck_rule_ante | deck_rule_banned | deck_rule_minimum_size
/* @sem Ability::DeckRule(CanBeCommander) */
deck_rule_commander ::= SELF_NAME "can" "be" "your" "commander" "."
/* @sem Ability::DeckRule(AnyNumberOfCopies) */
deck_rule_any_copies ::= "a" "deck" "can" "have" "any" "number" "of" "cards" "named" SELF_NAME "."
/* @sem Ability::DeckRule(UpToCopies($card_count)) */
deck_rule_up_to_copies ::= "a" "deck" "can" "have" "up" "to" card_count "named" SELF_NAME "."
/* @sem Ability::DeckRule(RemoveUnlessPlayingForAnte) */
deck_rule_ante ::= "remove" "this" "card" "from" "your" "deck" "before" "playing" "if" "you're" "not" "playing" "for" "ante" "."
/* @sem Ability::DeckRule(Banned) */
deck_rule_banned ::= "this" "card" "is" "banned" "."
/* @sem Ability::DraftRule([Term{family:ConspiracyDeck, form:ReduceStartingDeckSize, operands:[Number($value)]}]) */
deck_rule_minimum_size ::= "your" "minimum" "deck" "size" "is" "reduced" "by" value "."

/* Draft rules (CR 905). Each sentence names fixed draft vocabulary. A card
   revealed as it is drafted adds one follow-up action. */
draft_rule_sentence ::= draft_face_up | draft_reveal_as_drafted | draft_effect_sentence
/* @sem Ability::DraftRule([Vocabulary{family:DraftAction, form:DraftFaceUp}]) */
draft_face_up ::= "draft" "this" "card" "face" "up" "."
/* @sem Ability::DraftRule([Vocabulary{family:DraftAction, form:RevealThisDraftedCard}, $draft_reveal_action]) */
draft_reveal_as_drafted ::= "reveal" "this" "card" "as" "you" "draft" "it" draft_reveal_action "."
draft_reveal_action ::= draft_note_count | draft_note_passer | draft_choose_colors | draft_note_next_name
    | draft_look_next | draft_add_booster | draft_guess_next
/* @sem Operand::Vocabulary{family:DraftAction, form:NoteNumberOfCardsDraftedThisRound} */
draft_note_count ::= "and" "note" "how" "many" "cards" "you've" "drafted" "this" "draft" "round" "," "including" "this" "card"
/* @sem Operand::Vocabulary{family:DraftAction, form:NotePlayerWhoPassedPackToYou} */
draft_note_passer ::= "and" "note" "the" "player" "who" "passed" "it" "to" "you"
/* @sem Operand::Vocabulary{family:DraftAction, form:PlayerToRightChoosesAColor_YouChooseAColor_PlayerToLeftChoosesAColor} */
draft_choose_colors ::= "." "the" "player" "to" "your" "right" "chooses" "a" "color" "," "you" "choose" "another" "color" "," "then" "the" "player" "to" "your" "left" "chooses" "a" "third" "color"
/* @sem Operand::Vocabulary{family:DraftAction, form:RevealAndNoteNameOfNextDraftedCard} */
draft_note_next_name ::= "." "reveal" "the" "next" "card" "you" "draft" "and" "note" "its" "name"
/* @sem Operand::Vocabulary{family:DraftAction, form:MayLookAtNextCraftDraftedFromThisPack} */
draft_look_next ::= "." "you" "may" "look" "at" "the" "next" "card" "drafted" "from" "this" "booster" "pack"
/* @sem Operand::Vocabulary{family:DraftAction, form:MayAddBoosterBackToDraft} */
draft_add_booster ::= "." "after" "you" "draft" "this" "card" "," "you" "may" "add" "a" "booster" "pack" "to" "the" "draft"
/* @sem Operand::Vocabulary{family:DraftAction, form:GuessNameOfNextCardAPlayerDraftsFromThisPackAndTheyRevealThatCard} */
draft_guess_next ::= "." "the" "next" "time" "a" "player" "drafts" "a" "card" "from" "this" "booster" "pack" "," "guess" "that" "card's" "name" "." "then" "that" "player" "reveals" "the" "drafted" "card"

/* @sem Ability::DraftRule([$draft_effect]) */
draft_effect_sentence ::= draft_effect "."
draft_effect ::= draft_remove_face_up | draft_remove_face_down | draft_additional_into_pack
    | draft_additional_pass_next | draft_reveal_note_name | draft_reveal_type_note_name
    | draft_reveal_type_note_types | draft_whole_pack | draft_at_random | draft_offer_trade
    | draft_look_chosen_next | draft_look_unopened | draft_last_cards | draft_pregame_reveal_and_exile | draft_pregame_reveal_and_exile_one
/* @sem Operand::Term{family:FaceUpDraftEffect, form:MayRemoveCardsFromDraftFaceUp} */
draft_remove_face_up ::= "as" "you" "draft" "a" "card" "," "you" "may" "remove" "it" "from" "the" "draft" "face" "up"
/* @sem Operand::Term{family:FaceUpDraftEffect, form:MayRemoveCardsFromDraftFaceDown} */
draft_remove_face_down ::= "as" "you" "draft" "a" "card" "," "you" "may" "remove" "it" "from" "the" "draft" "face" "down"
/* @sem Operand::Term{family:FaceUpDraftEffect, form:AsDraftACardMayDraftAnAdditionalCardFromPack_PutThisDraftCardIntoThatBooster} */
draft_additional_into_pack ::= "as" "you" "draft" "a" "card" "," "you" "may" "draft" "an" "additional" "card" "from" "that" "booster" "pack" "." "if" "you" "do" "," "put" "this" "card" "into" "that" "booster" "pack"
/* @sem Operand::Term{family:FaceUpDraftEffect, form:AsDraftACardMayDraftAnAdditionalCardFromPack_TurnThisDraftCardCardFaceDown_PassNextBoosterWithoutDrafting} */
draft_additional_pass_next ::= "as" "you" "draft" "a" "card" "," "you" "may" "draft" "an" "additional" "card" "from" "that" "booster" "pack" "." "if" "you" "do" "," "turn" "this" "card" "face" "down" "," "then" "pass" "the" "next" "booster" "pack" "without" "drafting" "a" "card" "from" "it"
/* @sem Operand::Term{family:FaceUpDraftEffect, form:AsDraftACard_MayRevealIt_NoteItsName_TurnThisDraftCardFaceDown} */
draft_reveal_note_name ::= "as" "you" "draft" "a" "card" "," "you" "may" "reveal" "it" "," "note" "its" "name" "," "then" "turn" "this" "card" "face" "down"
/* @sem Operand::Term{family:FaceUpDraftEffect, form:AsDraftACardOfType_MayRevealIt_NoteItsName_TurnThisDraftCardFaceDown, operands:[Filter($filter_phrase)]} */
draft_reveal_type_note_name ::= "as" "you" "draft" "a" filter_phrase "card" "," "you" "may" "reveal" "it" "," "note" "its" "name" "," "then" "turn" "this" "card" "face" "down"
/* @sem Operand::Term{family:FaceUpDraftEffect, form:AsDraftACardOfType_MayRevealIt_NoteItsCreatureTypes_TurnThisDraftCardFaceDown, operands:[Filter($filter_phrase)]} */
draft_reveal_type_note_types ::= "as" "you" "draft" "a" filter_phrase "card" "," "you" "may" "reveal" "it" "," "note" "its" "creature" "types" "," "then" "turn" "this" "card" "face" "down"
/* @sem Operand::Term{family:FaceUpDraftEffect, form:MayTurnThisDraftCardFaceDown_DraftEachCardInCurrentBoosterPackInsteadOfDraftingCardsThisRound} */
draft_whole_pack ::= "instead" "of" "drafting" "a" "card" "from" "a" "booster" "pack" "," "you" "may" "draft" "each" "card" "in" "that" "booster" "pack" "," "one" "at" "a" "time" "." "if" "you" "do" "," "turn" "this" "card" "face" "down" "and" "you" "can't" "draft" "cards" "for" "the" "rest" "of" "this" "draft" "round"
/* @sem Operand::Term{family:FaceUpDraftEffect, form:DraftCardsAtRandomUntilNumberCardsHaveBeenDrafted_TurnThisDraftCardFaceDown, operands:[Number($card_count)]} */
draft_at_random ::= "as" "long" "as" "this" "card" "is" "face" "up" "during" "the" "draft" "," "you" "can't" "look" "at" "booster" "packs" "and" "must" "draft" "cards" "at" "random" "." "after" "you" "draft" card_count "this" "way" "," "turn" "this" "card" "face" "down"
/* @sem Operand::Term{family:FaceUpDraftEffect, form:AfterDraftMayOfferATradeWithOtherPlayers} */
draft_offer_trade ::= "immediately" "after" "the" "draft" "," "you" "may" "reveal" "a" "card" "in" "your" "card" "pool" "." "each" "other" "player" "may" "offer" "you" "one" "card" "in" "their" "card" "pool" "in" "exchange" "." "you" "may" "accept" "any" "one" "offer"
/* @sem Operand::Term{family:FaceUpDraftEffect, form:MayTurnThisDraftCardFaceDown_LookAtNextCardDraftedByPlayerOfChoice} */
draft_look_chosen_next ::= "during" "the" "draft" "," "you" "may" "turn" "this" "card" "face" "down" "." "if" "you" "do" "," "look" "at" "the" "next" "card" "drafted" "by" "a" "player" "of" "your" "choice"
/* @sem Operand::Term{family:FaceUpDraftEffect, form:MayTurnThisDraftCardFaceDown_LookAtAnUnopenedBoosterPackOrABoosterPackNotBeingLookedAt} */
draft_look_unopened ::= "during" "the" "draft" "," "you" "may" "turn" "this" "card" "face" "down" "." "if" "you" "do" "," "look" "at" "any" "unopened" "booster" "pack" "in" "the" "draft" "or" "any" "booster" "pack" "not" "being" "looked" "at" "by" "another" "player"
/* @sem Operand::Term{family:FaceUpDraftEffect, form:LastCardInEachBoosterGoesToThisPlayer} */
draft_last_cards ::= "each" "player" "passes" "the" "last" "card" "from" "each" "booster" "pack" "to" "a" "player" "who" "drafted" "a" "card" "named" SELF_NAME

/* Escape exiling a number of other graveyard cards. */
/* @sem Ability::Mechanic{mechanic:Escape, cost:_{parts:[Mana($mana_symbols), Move{selections:[_{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Not(SameObject(Source))}), choose:Exactly($value)}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}} */
mechanic_escape_exile_others ::= "escape" "―" mana_symbols "," "↑" "exile" value "other" "cards" "from" "your" "graveyard" "."

/* Splice onto a kind of spell. */
/* @sem Ability::Mechanic{mechanic:SpliceOnto, cost:$splice_payment, filter:$filter_phrase} */
mechanic_splice_onto ::= "splice" "onto" filter_phrase splice_payment

/* Gift programs use the promised opponent, never the caster. The two spell
   outcomes are specialized after binding, each with its own announced targets. */
/* @sem Ability::Gift{gift:[$gift_program]} */
gift_header ::= "gift" gift_program

gift_program ::= gift_card | gift_fish | gift_octopus | gift_named_token | gift_extra_turn | gift_rhystic_study
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Draw{players:One(GiftedPlayer), amount:Constant(1)}}]} */
gift_card ::= "a" "card"
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(GiftedPlayer), tokens:[_{amount:Constant(1), words:Rules, recipe:Defined{name:FromSubtypes, colors:[Blue], card_types:[Creature], subtypes:[Fish], power_toughness:[Constant(1), Constant(1)]}}], entry:BattlefieldArrival{tapped:true}}}]} */
gift_fish ::= "a" "tapped" "Fish"
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(GiftedPlayer), tokens:[_{amount:Constant(1), words:Rules, recipe:Defined{name:FromSubtypes, colors:[Blue], card_types:[Creature], subtypes:[Octopus], power_toughness:[Constant(8), Constant(8)]}}], entry:BattlefieldArrival{tapped:false}}}]} */
gift_octopus ::= "an" "Octopus"
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(GiftedPlayer), tokens:[_{amount:Constant(1), words:Rules, recipe:$gift_named_recipe}], entry:BattlefieldArrival{tapped:false}}}]} */
gift_named_token ::= "a" gift_named_recipe
gift_named_recipe ::= tn_food | tn_treasure
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(GiftedPlayer), action:KeywordAction::TakeExtraTurn{}}}]} */
gift_extra_turn ::= "an" "extra" "turn"
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Conjure{actor:One(GiftedPlayer), card:Named('Rhystic Study'), count:Constant(1), destination:Battlefield(BattlefieldArrival{tapped:false})}}]} */
gift_rhystic_study ::= "a" "Rhystic" "Study"

/* @sem Ability::@gift_branch($gift_header, Ability::Spell{announcement:@announcement, body:$kicker_branch_program}) */
spell_gift ::= gift_header NEWLINE kicker_branch_program

/* The gift program still acts for the promised opponent. These headers
   describe the gift that comes before an instant or sorcery's other effects. */
gift_spell_reminded_header ::= gift_card_spell_reminded_header | gift_fish_spell_reminded_header

/* @sem Ability::Gift{gift:[$gift_card]} */
gift_card_spell_reminded_header ::= "gift" gift_card "(" gift_explanation_start "they" "draw" "a" "card" gift_explanation_before_effects ")"

/* @sem Ability::Gift{gift:[$gift_fish]} */
gift_fish_spell_reminded_header ::= "gift" gift_fish "(" gift_explanation_start gift_explanation_fish gift_explanation_before_effects ")"

/* @sem () */
gift_explanation_start ::= "you" "may" "promise" "an" "opponent" "a" "gift" "as" "you" "cast" "this" "spell" "." "if" "you" "do" ","
/* @sem () */
gift_explanation_fish ::= "they" "create" "a" "tapped" "1" "/" "1" "blue" "Fish" "creature" "token"
/* @sem () */
gift_explanation_before_effects ::= "before" "its" "other" "effects" "."

/* @sem Ability::WithPresentation{reminder:true, ability:@gift_branch($gift_spell_reminded_header, Ability::Spell{announcement:@announcement, body:$kicker_branch_program})} */
spell_gift_reminded ::= gift_spell_reminded_header NEWLINE kicker_branch_program

/* A permanent's gift and its other abilities have separate trigger frames. */
gift_permanent_reminded ::= gift_card_permanent_reminded | gift_fish_permanent_reminded | gift_octopus_permanent_reminded
/* @sem Ability::WithPresentation{reminder:true, ability:Gift{gift:[$gift_card]}} */
gift_card_permanent_reminded ::= "gift" gift_card "(" gift_explanation_start "when" "it" "enters" "," "they" "draw" "a" "card" "." ")"
/* @sem Ability::WithPresentation{reminder:true, ability:Gift{gift:[$gift_fish]}} */
gift_fish_permanent_reminded ::= "gift" gift_fish "(" gift_explanation_start "when" "it" "enters" "," gift_explanation_fish "." ")"
/* @sem Ability::WithPresentation{reminder:true, ability:Gift{gift:[$gift_octopus]}} */
gift_octopus_permanent_reminded ::= "gift" gift_octopus "(" gift_explanation_start "when" "it" "enters" "," "they" "create" "an" "8" "/" "8" "blue" "Octopus" "creature" "token" "." ")"

/* A casting cost is paid before either gift outcome resolves. */
/* @sem Ability::[$casting_additional_cost, @gift_branch($gift_header, Ability::Spell{announcement:@announcement, body:$kicker_branch_program})] */
line_gift_additional_cost ::= gift_header NEWLINE casting_additional_cost NEWLINE kicker_branch_program

/* Keyword mechanics taken over from seeded rules, in their original Oracle words. */
/* @sem Ability::Mechanic{mechanic:Reinforce, cost:$cost, amount:$number} */
mechanic_reinforce ::= "reinforce" number "―" cost

/* @sem Ability::Mechanic{mechanic:Impending, cost:$cost, amount:$value} */
mechanic_impending ::= "impending" value "―" cost

/* @sem Ability::Offering($filter_phrase) */
mechanic_offering ::= filter_phrase "offering"

/* Craft material descriptions share their operand with all Craft cost forms. */
/* @sem Operand::List($craft_type_options) */
craft_type_list ::= craft_type_options

/* @sem Operand::[$craft_type_item, ...$craft_type_options_tail] */
craft_type_options ::= craft_type_item "," craft_type_options_tail

craft_type_options_tail ::= craft_type_options_last_pair | craft_type_options
/* @sem Operand::[$craft_type_item, $craft_type_item_2] */
craft_type_options_last_pair ::= craft_type_item "," "and" craft_type_item
/* @sem Operand::Term{family:Craftable, form:IsCreatureType, operands:[Vocabulary{family:CreatureType, form:@subtype_name($creature_subtype)}]} */
craft_type_item ::= "a" creature_subtype
/* @sem Operand::Term{family:Craftable, form:And, operands:[Term{family:Craftable, form:IsNonCardtype, operands:[Vocabulary{family:CardType, form:Land}]}, Term{family:Craftable, form:HasAbility, operands:[Term{family:CheckHasable, form:ActivatedAbility}]}]} */
craft_nonlands_activated ::= "nonlands" "with" "activated" "abilities"
/* @sem Operand::List([Term{family:Craftable, form:AnyCard}, Term{family:GroupFilter, form:ShareACardType}]) */
craft_shared_card_type ::= "that" "share" "a" "card" "type"

/* Named payment mechanics share the same cost and inverse. */
/* @sem Mechanic::CumulativeUpkeep */
mechanic_upkeep_name ::= "cumulative" "upkeep"

/* @sem Mechanic::AuraSwamp */
mechanic_aura_swap_name ::= "Aura" "swap"

/* @sem Mechanic::BeamMeUp */
mechanic_beam_name ::= "beam" "me" "up"

/* A defined X keeps the expression as the mechanic's current amount. */
/* @sem Ability::Mechanic{mechanic:$defined_amount_mechanic_name, amount:$defined_x_amount} */
mechanic_defined_amount ::= defined_amount_mechanic_name defined_x_amount

/* @sem Mechanic::Firebending */
defined_amount_mechanic_name ::= "firebending"

/* @sem $value */
defined_x_amount ::= "X" "," "where" "X" "is" value "."

splice_payment ::= cost | keyword_payment

/* Non-mana splice costs are introduced by an em dash. */
/* @sem Ability::Mechanic{mechanic:SpliceOnto, cost:$cost, filter:$filter_phrase} */
mechanic_splice_onto_dashed ::= "splice" "onto" filter_phrase "―" cost "."

/* A charge threshold wraps a single independently parsed stage ability. */
/* @sem Ability::CounterStages{counter:Named(ChargeCounter), stages:[_{minimum:$number, abilities:$stage_line}]} */
charge_threshold_ability ::= NUMBER "⁺" "|" stage_line

/* Comma-separated keywords on a level line share its stage. */
level_stage_abilities ::= stage_abilities | level_keyword_pair | level_keyword_pair_more

/* @sem Ability::[Keyword($keyword_value), Keyword($keyword_value_2)] */
level_keyword_pair ::= keyword_value "," keyword_value

/* @sem Ability::[...$level_keyword_pair, ...$stage_abilities] */
level_keyword_pair_more ::= level_keyword_pair NEWLINE stage_abilities

/* Cost-bearing mechanics share the same payment contract. */
/* @sem Mechanic::CommanderNinjutsu */
mechanic_commander_ninjutsu_name ::= "commander" "ninjutsu"

/* @sem Mechanic::CumulativeUpkeep */
mechanic_cumulative_upkeep_name ::= "cumulative" "upkeep"

/* @sem Mechanic::Disguise */
mechanic_disguise_name ::= "disguise"

/* A charge-counter threshold grants an independently scoped ability. */
/* @sem Ability::CounterStages{counter:Named(ChargeCounter), stages:[_{minimum:$number, abilities:[@scope($activated_limited)]}]} */
charge_stage_limited ::= NUMBER "⁺" "|" activated_limited

/* Escape composes the same current payment operands as other costs. */
/* @sem Ability::Mechanic{mechanic:Escape, cost:$cost} */
mechanic_escape_cost ::= "escape" "―" cost "."

/* @sem Operand::Term{family:PregameAction, form:MayActions, operands:[Term{family:PregameAction, form:RevealCardFromDeck}, $draft_exile_not_in_deck]} */
draft_pregame_reveal_and_exile ::= "before" "you" "shuffle" "your" "deck" "to" "start" "the" "game" "," "you" "may" "reveal" "this" "card" "from" "your" "deck" "and" draft_exile_not_in_deck

/* @sem Operand::Term{family:PregameAction, form:ExileNumberDraftedCardsNotInDeck, operands:[Number($value), Filter($filter_phrase)]} */
draft_exile_multiple ::= "exile" value "or" "more" filter_phrase "cards" "you" "drafted" "that" "aren't" "in" "your" "deck"

/* Keep the explicit all-population wording in a leading mode. */
/* @sem Ability::[Ability::Spree{modes:[$spree_mode_lose_abilities, ...$spree_modes]}] */
line_spree_leading_loss ::= "spree" NEWLINE spree_mode_lose_abilities NEWLINE spree_modes

/* @sem Ability::[Ability::Spree{modes:$spree_modes}] */
line_spree_plain ::= "spree" NEWLINE spree_modes
/* @sem Ability::[WithPresentation{reminder:true, ability:Spree{modes:$spree_modes}}] */
line_spree_reminded ::= "spree" "(" "choose" "one" "or" "more" "additional" "costs" "." ")" NEWLINE spree_modes

/* @prefer always */
/* Mode-specific shapes keep the chosen population and keyword in the current IR. */
/* @sem @scope(SpreeMode::SpreeMode{cost:$cost, ability:Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}), changes:[RemoveAllAbilities], duration:$duration, evaluation:Snapshot}}]}}}) */
spree_mode_lose_abilities ::= "+" cost "—" "all" filter_plural "lose" "all" "abilities" duration "."

/* @sem @scope(SpreeMode::SpreeMode{cost:$cost, ability:Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_phrase, ObjectFilter::ControlledBy(One(AbilityController)))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}]}}}) */
spree_mode_choose_grant ::= "+" cost "—" "choose" "a" filter_phrase "you" "control" "." "it" "gains" keyword_name duration "."

/* @sem @scope(SpreeMode::SpreeMode{cost:$cost, ability:Ability::Spell{announcement:@announcement, body:$program}}) */
spree_mode_plain ::= "+" cost "—" program "."

/* Bare mechanics share the same native ability construction. */
/* @sem Ability::Mechanic{mechanic:$unvalued_mechanic_name} */
mechanic_unvalued_named ::= unvalued_mechanic_name

unvalued_mechanic_name ::= unvalued_double_agenda | unvalued_increment | unvalued_mayhem

/* @sem Mechanic::DoubleAgenda */
unvalued_double_agenda ::= "double" "agenda"

/* @sem Mechanic::Increment */
unvalued_increment ::= "increment"

/* @sem Mechanic::BasicMayhem */
unvalued_mayhem ::= "mayhem"

/* @sem Mechanic::EmergeFromArtifact */
mechanic_emerge_artifact_name ::= "emerge" "from" "artifact"

/* Variable and sunburst amounts use the same valued-mechanic contract. */
/* @sem Ability::Mechanic{mechanic:$valued_keyword_name, amount:$value} */
mechanic_defined_value ::= valued_keyword_name "X" "," "where" "X" "is" value "."

/* @sem Ability::Mechanic{mechanic:$mechanic_modular_name, amount:$modular_sunburst_value} */
mechanic_modular_sunburst ::= mechanic_modular_name "―" modular_sunburst_value

/* @sem Expr::ManaSpent{object:Source, filter:SpentManaFilter{}, aggregation:DistinctColors} */
modular_sunburst_value ::= "sunburst"

/* Starting deck and hand restrictions retain independent filter and size operands. */
/* @sem Ability::[DraftRule([Term{family:ConspiracyDeck, form:NoCardPassesFilter, operands:[Filter($card_filter)]}]), StartingHandSize($number_words)] */
starting_deck_restriction_hand_size ::= "your" "starting" "deck" "can't" "have" card_filter "cards" "and" "your" "starting" "hand" "size" "is" number_words "."

/* Names share the native bare-mechanic construction in keyword lists. */
/* @sem Ability::Mechanic{mechanic:$bare_named_pilot_name} */
bare_named_pilot ::= bare_named_pilot_name

bare_named_pilot_name ::= mechanic_space_sculptor_name | mechanic_trample_planeswalkers_name

/* @sem Mechanic::SpaceSculptor */
mechanic_space_sculptor_name ::= "space" "sculptor"

/* @sem Mechanic::TrampleOverPlaneswalkers */
mechanic_trample_planeswalkers_name ::= "trample" "over" "planeswalkers"

/* @sem Mechanic::Transfigure */
mechanic_transfigure_name ::= "transfigure"

/* Crew uses one payment contract for ordinary and restricted activations. */
/* @sem Cost::Cost{parts:[Constrained{part:ChangeTapState{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::CardType(Creature), ObjectFilter::ControlledBy(One(AbilityController)), ObjectFilter::Not(SameObject(Source)), ObjectFilter::Not(Tapped))}, choose:AnyNumber}], tapped:true}, constraints:[TotalProperty{property:Power, comparison:GreaterOrEqual, amount:$number}]}]} */
crew_payment ::= "crew" number

/* @sem Ability::Activated{origin:Crew, cost:$crew_payment, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[AddCardType(Artifact), AddCardType(Creature)], duration:EndOfTurn, evaluation:Snapshot}}]}} */
crew_unrestricted ::= crew_payment

/* @sem Ability::Activated{origin:Crew, cost:$crew_payment, limits:$activation_limits, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[AddCardType(Artifact), AddCardType(Creature)], duration:EndOfTurn, evaluation:Snapshot}}]}} */
crew_restricted ::= crew_payment "." activation_limits "."

/* The total power is repeated by the explanation. */
/* @sem Ability::WithPresentation{reminder:true, ability:Activated{origin:Crew, cost:$crew_reminded_payment, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[AddCardType(Artifact), AddCardType(Creature)], duration:EndOfTurn, evaluation:Snapshot}}]}}} */
crew_reminded ::= crew_reminded_payment
/* @sem Cost::Cost{parts:[Constrained{part:ChangeTapState{selections:[_{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::CardType(Creature), ObjectFilter::ControlledBy(One(AbilityController)), ObjectFilter::Not(SameObject(Source)), ObjectFilter::Not(Tapped))}, choose:AnyNumber}], tapped:true}, constraints:[TotalProperty{property:Power, comparison:GreaterOrEqual, amount:@agree($number, $crew_reminder_number)}]}]} */
crew_reminded_payment ::= "crew" number "(" crew_reminder_number ":" "this" "Vehicle" "becomes" "an" "artifact" "creature" "until" "end" "of" "turn" "." ")"
/* @sem $number */
crew_reminder_number ::= "tap" "any" "number" "of" "creatures" "you" "control" "with" "total" "power" number "or" "more"

/* Keep this explicit return wording within a spree mode. */
/* @prefer always */
/* @sem @scope(SpreeMode::SpreeMode{cost:$cost, ability:Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_exile_target_delayed_return_it}}}) */
spree_mode_exile_delayed_return ::= "+" cost "—" instructions_exile_target_delayed_return_it "."

/* A quoted final ability closes the mode sentence at its own period. */
/* @sem @scope(SpreeMode::SpreeMode{cost:$cost, ability:Ability::Spell{announcement:@announcement, body:$program_sentence_quoted}}) */
spree_mode_quoted ::= "+" cost "—" program_sentence_quoted

/* @sem @scope(SpreeMode::SpreeMode{cost:$cost, ability:Ability::Spell{announcement:@announcement, body:$program}}) */
tier_mode_plain ::= "•" tier_name "—" cost "—" program "."

/* Canonical mode labels for these distinct destruction shapes. The operands
   remain shared with ordinary target and population phrases. */
/* @prefer always */
/* @sem @scope(SpreeMode::SpreeMode{cost:$cost, ability:Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One($target_permanent), regeneration:true}}]}}}) */
tier_mode_cross_slash ::= "•" "Cross-Slash" "—" cost "—" "destroy" target_permanent "."

/* @prefer always */
/* @sem @scope(SpreeMode::SpreeMode{cost:$cost, ability:Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:$objects_any_targets_different_controllers, regeneration:true}}]}}}) */
tier_mode_blade_beam ::= "•" "Blade" "Beam" "—" cost "—" "destroy" objects_any_targets_different_controllers "."

/* @prefer always */
/* @sem @scope(SpreeMode::SpreeMode{cost:$cost, ability:Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:$objects_all, regeneration:true}}]}}}) */
tier_mode_omnislash ::= "•" "Omnislash" "—" cost "—" "destroy" objects_all "."

/* A mode may end with a sentence whose final period is inside a quote. */
/* @sem @scope(SpreeMode::SpreeMode{cost:$cost, ability:Ability::Spell{announcement:@announcement, body:$program_sentence_quoted}}) */
spree_mode_closed_sentence ::= "+" cost "—" program_sentence_quoted

draft_exile_not_in_deck ::= draft_exile_multiple | draft_exile_one_creature

/* @sem Operand::Term{family:PregameAction, form:ExileADraftedCardNotInDeck} */
draft_exile_one_creature ::= "exile" "a" "creature" "card" "you" "drafted" "that" "isn't" "in" "your" "deck"

/* @prefer always */
/* @sem $stage_cast_history_inner */
stage_cast_history_line ::= stage_cast_history_inner
/* @prefer always */
/* @sem Ability::[@scope($triggered_cast_spell_history_damage)] */
stage_cast_history_inner ::= triggered_cast_spell_history_damage

/* Tiered spell with a shared death-return trigger and tier-specific base power and toughness. */
/* @prefer always */
/* @sem Ability::Tiered{modes:[_{cost:_{parts:[Mana($mana_symbols)]}, ability:@scope(Ability::Spell{body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_phrase}), index:0})), changes:[GrantAbility(@scope(Ability::Triggered{event:ZoneChange{objects:SameObject(Source), from:Battlefield, to:Graveyard}, limits:_{}, body:_{instructions:[Effect{result:@next, operation:Move{objects:One($event_return_object), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}]}, announcement:@announcement})), SetBasePowerToughness{power:$number_digits, toughness:$number_digits_2}], duration:$duration, evaluation:Snapshot}}]}, announcement:@announcement})}, _{cost:_{parts:[Mana($mana_symbols_2)]}, ability:@scope(Ability::Spell{body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_phrase}), index:0})), changes:[GrantAbility(@scope(Ability::Triggered{event:ZoneChange{objects:SameObject(Source), from:Battlefield, to:Graveyard}, limits:_{}, body:_{instructions:[Effect{result:@next, operation:Move{objects:One($event_return_object), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}]}, announcement:@announcement})), SetBasePowerToughness{power:$number_digits_3, toughness:$number_digits_4}], duration:$duration, evaluation:Snapshot}}]}, announcement:@announcement})}, _{cost:_{parts:[Mana($mana_symbols_3)]}, ability:@scope(Ability::Spell{body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$filter_phrase}), index:0})), changes:[GrantAbility(@scope(Ability::Triggered{event:ZoneChange{objects:SameObject(Source), from:Battlefield, to:Graveyard}, limits:_{}, body:_{instructions:[Effect{result:@next, operation:Move{objects:One($event_return_object), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}]}, announcement:@announcement})), SetBasePowerToughness{power:$number_digits_5, toughness:$number_digits_6}], duration:$duration, evaluation:Snapshot}}]}, announcement:@announcement})}]} */
tiered_shared_death_return_pt ::= "tiered" NEWLINE duration "," "target" filter_phrase "gains" '"' "when" "this" "creature" "dies" "," "return" event_return_object "to" "the" "battlefield" "tapped" "under" "its" "owner's" "control" '"' "and" "has" "the" "chosen" "base" "power" "and" "toughness" "." NEWLINE "•" tier_pt_name_1 "—" mana_symbols "—" number_digits "/" number_digits "." NEWLINE "•" tier_pt_name_2 "—" mana_symbols "—" number_digits "/" number_digits "." NEWLINE "•" tier_pt_name_3 "—" mana_symbols "—" number_digits "/" number_digits "."

/* @sem () */
tier_pt_name_1 ::= "Galian" "Beast"

/* @sem () */
tier_pt_name_2 ::= "death" "Gigas"

/* @sem () */
tier_pt_name_3 ::= "Hellmasker"

/* A singular pregame draft exile maps to the zero-operand PregameAction term. */
/* @sem Operand::Term{family:PregameAction, form:MayActions, operands:[Term{family:PregameAction, form:RevealCardFromDeck}, Term{family:PregameAction, form:ExileADraftedCardNotInDeck}]} */
draft_pregame_reveal_and_exile_one ::= "before" "you" "shuffle" "your" "deck" "to" "start" "the" "game" "," "you" "may" "reveal" "this" "card" "from" "your" "deck" "and" "exile" "an" "instant" "or" "sorcery" "card" "you" "drafted" "that" "isn't" "in" "your" "deck"

/* Casualty X creates a nonlegendary copy whose starting loyalty is X. */
/* @sem Ability::Mechanic{mechanic:CasualtyX} */
mechanic_casualty_x ::= "casualty" "X" "." "the" "copy" "isn't" "legendary" "and" "has" "starting" "loyalty" "X" "."

/* A threshold can grant a keyword followed by another scoped ability. */
/* @sem Ability::CounterStages{counter:Named(ChargeCounter), stages:[_{minimum:$number, abilities:$stage_keyword_more}]} */
charge_threshold_keyword_and_abilities ::= NUMBER "⁺" "|" stage_keyword_more

/* Canonical mode labels for Tifa's Limit Break tier shapes. */
/* @prefer always */
/* @sem @scope(SpreeMode::SpreeMode{cost:$cost, ability:Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0})), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot}}]}}}) */
