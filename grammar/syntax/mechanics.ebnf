sneak_cost_reminded_text ::= mechanic_sneak_name keyword_payment "(" "you" "may" "cast" "this" "spell" "for" keyword_payment "if" "you" "also" "return" "an" "unblocked" "attacker" "you" "control" "to" "hand" "during" "the" "declare" "blockers" "step" "." ")"

/* @sem Ability::Mechanic{mechanic:$mechanic_sneak_name, cost:Cost::@agree($keyword_payment, $keyword_payment_2)} */
sneak_enters_he_cost_reminded_text ::= mechanic_sneak_name keyword_payment "(" "you" "may" "cast" "this" "spell" "for" keyword_payment "if" "you" "also" "return" "an" "unblocked" "attacker" "you" "control" "to" "hand" "during" "the" "declare" "blockers" "step" "." "he" "enters" "tapped" "and" "attacking" "." ")"

