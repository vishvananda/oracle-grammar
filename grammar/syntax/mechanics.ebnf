/* These reminders repeat the mechanic’s printed amount. */
valued_mechanic_reminded_text ::= soulshift_reminded_text | saddle_reminded_text | dredge_reminded_text | graft_reminded_text | modular_reminded_text | rampage_reminded_text

/* @sem Ability::Mechanic{mechanic:Soulshift, amount:Expr::@agree($number_digits, $number_digits_2)} */
soulshift_reminded_text ::= "soulshift" number_digits "(" "when" "this" "creature" "dies" "," "you" "may" "return" "target" "Spirit" "card" "with" "mana" "value" number_digits "or" "less" "from" "your" "graveyard" "to" "your" "hand" "." ")"

/* @sem Ability::Mechanic{mechanic:Saddle, amount:Expr::@agree($number_digits, $number_digits_2)} */
saddle_reminded_text ::= "saddle" number_digits "(" "tap" "any" "number" "of" "other" "creatures" "you" "control" "with" "total" "power" number_digits "or" "more" ":" "this" "Mount" "becomes" "saddled" "until" "end" "of" "turn" "." "saddle" "only" "as" "a" "sorcery" "." ")"

/* @sem Ability::Mechanic{mechanic:Dredge, amount:Expr::@agree($number_digits, $number_words)} */
dredge_reminded_text ::= "dredge" number_digits "(" "if" "you" "would" "draw" "a" "card" "," "you" "may" "mill" number_words "cards" "instead" "." "if" "you" "do" "," "return" "this" "card" "from" "your" "graveyard" "to" "your" "hand" "." ")"

/* @sem Ability::Mechanic{mechanic:Graft, amount:Expr::@agree($number_digits, $number_words)} */
graft_reminded_text ::= "graft" number_digits "(" "this" "creature" "enters" "with" number_words "+" "1" "/" "+" "1" "counters" "on" "it" "." "whenever" "another" "creature" "enters" "," "you" "may" "move" "a" "+" "1" "/" "+" "1" "counter" "from" "this" "creature" "onto" "it" "." ")"

/* @sem Ability::Mechanic{mechanic:Modular, amount:Expr::@agree($number_digits, $number_words)} */
modular_reminded_text ::= "modular" number_digits "(" "this" "creature" "enters" "with" number_words "+" "1" "/" "+" "1" "counters" "on" "it" "." "when" "it" "dies" "," "you" "may" "put" "its" "+" "1" "/" "+" "1" "counters" "on" "target" "artifact" "creature" "." ")"

/* @sem Ability::Mechanic{mechanic:Rampage, amount:Expr::@agree($number_digits, $bushido_reminder_amount)} */
rampage_reminded_text ::= "rampage" number_digits "(" "whenever" "this" "creature" "becomes" "blocked" "," "it" "gets" bushido_reminder_amount "until" "end" "of" "turn" "for" "each" "creature" "blocking" "it" "beyond" "the" "first" "." ")"

/* @sem Ability::Mechanic{mechanic:Reconfigure, cost:Cost::@agree($keyword_payment, $keyword_payment_2)} */
reconfigure_reminded_text ::= "reconfigure" keyword_payment "(" keyword_payment ":" "attach" "to" "target" "creature" "you" "control" ";" "or" "unattach" "from" "a" "creature" "." "reconfigure" "only" "as" "a" "sorcery" "." "while" "attached" "," "this" "isn't" "a" "creature" "." ")"
