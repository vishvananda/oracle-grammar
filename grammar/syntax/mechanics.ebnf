/* An independent kicker retains its payment even if the ability following it
   uses a specialised kicker-triggered clause. */
/* @sem Ability::Mechanic{mechanic:Kicker, cost:$kicker_branch_reminded_header} */
kicker_mechanic_reminded_text ::= kicker_branch_reminded_header

/* The explanation checks the quantity in the header. */
numeric_mechanic_reminded_text ::= fading_creature_number_reminded_text | fading_enchantment_number_reminded_text | fading_artifact_number_reminded_text | vanishing_creature_number_reminded_text | vanishing_enchantment_number_reminded_text | casualty_with_target_number_reminded_text | casualty_no_target_number_reminded_text | afflict_number_reminded_text | tribute_number_reminded_text | annihilator_number_reminded_text | mobilize_number_reminded_text | afterlife_number_reminded_text | afterlife_permanent_number_reminded_text | fabricate_number_reminded_text | modular_singular_number_reminded_text | graft_singular_number_reminded_text

