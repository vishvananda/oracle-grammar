/* Mechanics the IR holds as one ability, set out over several lines. */
line_mechanic ::= line_prototype | line_spree | line_tiered

/* These are native mechanics. Reminder sentences explain them without creating
   more effects, events, targets or binding scopes. */
/* @sem Ability::Mechanic{mechanic:Ingest} */
mechanic_ingest ::= "ingest"
/* @sem Ability::Mechanic{mechanic:Convoke} */
mechanic_convoke ::= "convoke"
/* @sem Ability::Mechanic{mechanic:Delve} */
mechanic_delve ::= "delve"

/* Native mechanics participate in keyword lists while retaining Ability::Mechanic,
   rather than becoming a Keyword or a generated trigger. */
/* @sem Ability::Mechanic{mechanic:Banding} */
mechanic_banding ::= "banding"

/* @sem Ability::Mechanic{mechanic:$numbered_keyword_name, amount:$number_digits} */
mechanic_numbered_keyword ::= numbered_keyword_name number_digits

numbered_keyword_name ::= mechanic_bushido_name | mechanic_toxic_name | mechanic_annihilator_name | mechanic_hideaway_name
/* @sem Mechanic::Bushido */
mechanic_bushido_name ::= "bushido"
/* @sem Mechanic::Toxic */
mechanic_toxic_name ::= "toxic"
/* @sem Mechanic::Annihilator */
mechanic_annihilator_name ::= "annihilator"
/* @sem Mechanic::Hideaway */
mechanic_hideaway_name ::= "hideaway"

/* @sem Ability::WithPresentation{reminder:true, ability:$mechanic_reminded_text} */
reminded_mechanic ::= mechanic_reminded_text

/* @sem Ability::WithPresentation{label:$ability_label, reminder:true, ability:$mechanic_reminded_text} */
labelled_mechanic_reminder ::= ability_label "—" mechanic_reminded_text

mechanic_reminded_text ::= ingest_reminded_text | convoke_reminded_text | delve_reminded_text
    | deck_rule_reminded_text | triggered_mechanic_reminded_text | standalone_mechanic_reminded_text
    | banding_reminded_text | bushido_reminded_text | affinity_reminded_text
    | valued_mechanic_reminded_text | reconfigure_reminded_text
    | kicker_mechanic_reminded_text | typed_cost_mechanic_reminded_text | numeric_mechanic_reminded_text | firebending_number_reminded_text
    | hidden_agenda_reminded_text | double_agenda_reminded_text | undaunted_reminded_text | conspire_short_reminded_text

/* @sem $mechanic_ingest */
ingest_reminded_text ::= mechanic_ingest "(" "whenever" reminder_subject "deals" "combat" "damage" "to" "a" "player" "," "that" "player" "exiles" "the" "top" "card" "of" "their" "library" "." ")"

/* @sem $mechanic_convoke */
convoke_reminded_text ::= mechanic_convoke "(" "your" "creatures" "can" "help" "cast" "this" "spell" "." "each" "creature" "you" "tap" "while" "casting" "this" "spell" "pays" "for" "{" "1" "}" "or" "one" "mana" "of" "that" "creature's" "color" "." ")"

/* @sem $mechanic_delve */
delve_reminded_text ::= mechanic_delve "(" "each" "card" "you" "exile" "from" "your" "graveyard" "while" "casting" "this" "spell" "pays" "for" "{" "1" "}" "." ")"

/* Every explanation is paired with its own native mechanic or deck rule. */
deck_rule_reminded_text ::= partner_reminded_text | background_reminded_text | doctor_companion_reminded_text
/* @sem $deck_rule_partner */
partner_reminded_text ::= deck_rule_partner "(" "you" "can" "have" "two" "commanders" "if" "both" "have" "partner" "." ")"
/* @sem $deck_rule_choose_background */
background_reminded_text ::= deck_rule_choose_background "(" "you" "can" "have" "a" "Background" "as" "a" "second" "commander" "." ")"
/* @sem $deck_rule_doctors_companion */
doctor_companion_reminded_text ::= deck_rule_doctors_companion "(" "you" "can" "have" "two" "commanders" "if" "the" "other" "is" "the" "Doctor" "." ")"

triggered_mechanic_reminded_text ::= exalted_reminded_text | cascade_reminded_text | rebound_reminded_text
    | persist_reminded_text | undying_reminded_text | exploit_reminded_text | soulbond_reminded_text
/* @sem $bare_exalted */
exalted_reminded_text ::= bare_exalted "(" "whenever" "a" "creature" "you" "control" "attacks" "alone" "," "that" "creature" "gets" "+" "1" "/" "+" "1" "until" "end" "of" "turn" "." ")"
/* @sem $bare_cascade */
cascade_reminded_text ::= bare_cascade "(" "when" "you" "cast" "this" "spell" "," "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" "a" "nonland" "card" "that" "costs" "less" "." "you" "may" "cast" "it" "without" "paying" "its" "mana" "cost" "." "put" "the" "exiled" "cards" "on" "the" "bottom" "in" "a" "random" "order" "." ")"
/* @sem $bare_rebound */
rebound_reminded_text ::= bare_rebound "(" "if" "you" "cast" "this" "spell" "from" "your" "hand" "," "exile" "it" "as" "it" "resolves" "." "at" "the" "beginning" "of" "your" "next" "upkeep" "," "you" "may" "cast" "this" "card" "from" "exile" "without" "paying" "its" "mana" "cost" "." ")"
/* @sem $bare_persist */
persist_reminded_text ::= bare_persist "(" "when" "this" "creature" "dies" "," "if" "it" "had" "no" "-" "1" "/" "-" "1" "counters" "on" "it" "," "return" "it" "to" "the" "battlefield" "under" "its" "owner's" "control" "with" "a" "-" "1" "/" "-" "1" "counter" "on" "it" "." ")"
/* @sem $bare_undying */
undying_reminded_text ::= bare_undying "(" "when" "this" "creature" "dies" "," "if" "it" "had" "no" "+" "1" "/" "+" "1" "counters" "on" "it" "," "return" "it" "to" "the" "battlefield" "under" "its" "owner's" "control" "with" "a" "+" "1" "/" "+" "1" "counter" "on" "it" "." ")"
/* @sem $bare_exploit */
exploit_reminded_text ::= bare_exploit "(" "when" "this" "creature" "enters" "," "you" "may" "sacrifice" "a" "creature" "." ")"
/* @sem $bare_soulbond */
soulbond_reminded_text ::= bare_soulbond "(" "you" "may" "pair" "this" "creature" "with" "another" "unpaired" "creature" "when" "either" "enters" "." "they" "remain" "paired" "for" "as" "long" "as" "you" "control" "both" "of" "them" "." ")"

standalone_mechanic_reminded_text ::= ascend_reminded_text | daybound_reminded_text | nightbound_reminded_text
    | start_your_engines_reminded_text | fuse_reminded_text | aftermath_reminded_text
/* @sem $bare_ascend */
ascend_reminded_text ::= bare_ascend ascend_explanation
/* @sem () */
ascend_explanation ::= "(" "if" "you" "control" "ten" "or" "more" "permanents" "," "you" "get" "the" "city's" "blessing" "for" "the" "rest" "of" "the" "game" "." ")"
/* @sem $bare_daybound */
daybound_reminded_text ::= bare_daybound "(" "if" "a" "player" "casts" "no" "spells" "during" "their" "own" "turn" "," "it" "becomes" "night" "next" "turn" "." ")"
/* @sem $bare_nightbound */
nightbound_reminded_text ::= bare_nightbound "(" "if" "a" "player" "casts" "at" "least" "two" "spells" "during" "their" "own" "turn" "," "it" "becomes" "day" "next" "turn" "." ")"
/* @sem $bare_start_your_engines */
start_your_engines_reminded_text ::= bare_start_your_engines "(" "if" "you" "have" "no" "speed" "," "it" "starts" "at" "1" "." "it" "increases" "once" "on" "each" "of" "your" "turns" "when" "an" "opponent" "loses" "life" "." "max" "speed" "is" "4" "." ")"
/* @sem $bare_fuse */
fuse_reminded_text ::= bare_fuse "(" "you" "may" "cast" "one" "or" "both" "halves" "of" "this" "card" "from" "your" "hand" "." ")"
/* @sem $bare_aftermath */
aftermath_reminded_text ::= bare_aftermath "(" "cast" "this" "spell" "only" "from" "your" "graveyard" "." "then" "exile" "it" "." ")"

/* @sem $mechanic_banding */
banding_reminded_text ::= mechanic_banding "(" "any" "creatures" "with" "banding" "," "and" "up" "to" "one" "without" "," "can" "attack" "in" "a" "band" "." "bands" "are" "blocked" "as" "a" "group" "." "if" "any" "creatures" "with" "banding" "you" "control" "are" "blocking" "or" "being" "blocked" "by" "a" "creature" "," "you" "divide" "that" "creature's" "combat" "damage" "," "not" "its" "controller" "," "among" "any" "of" "the" "creatures" "it's" "being" "blocked" "by" "or" "is" "blocking" "." ")"

/* @sem Ability::Mechanic{mechanic:Bushido, amount:Expr::@agree($number_digits, $bushido_reminder_amount)} */
bushido_reminded_text ::= "bushido" number_digits "(" "whenever" "this" "creature" "blocks" "or" "becomes" "blocked" "," "it" "gets" bushido_reminder_amount "until" "end" "of" "turn" "." ")"
/* @sem Expr::@agree($number_digits, $number_digits_2) */
bushido_reminder_amount ::= "+" number_digits "/" "+" number_digits

/* @sem Ability::Mechanic{mechanic:Affinity, filter:ObjectFilter::@agree($filter_plural, $filter_phrase)} */
affinity_reminded_text ::= "affinity" "for" filter_plural "(" "this" "spell" "costs" "{" "1" "}" "less" "to" "cast" "for" "each" filter_phrase "you" "control" "." ")"

/* @sem $bare_hidden_agenda */
hidden_agenda_reminded_text ::= bare_hidden_agenda "(" "start" "the" "game" "with" "this" "conspiracy" "face" "down" "in" "the" "command" "zone" "and" "secretly" "choose" "a" "card" "name" "." "you" "may" "turn" "this" "conspiracy" "face" "up" "any" "time" "and" "reveal" "that" "name" "." ")"

/* @sem Ability::Mechanic{mechanic:$unvalued_double_agenda} */
double_agenda_reminded_text ::= unvalued_double_agenda "(" "start" "the" "game" "with" "this" "conspiracy" "face" "down" "in" "the" "command" "zone" "and" "secretly" "choose" "two" "different" "card" "names" "." "you" "may" "turn" "this" "conspiracy" "face" "up" "any" "time" "and" "reveal" "those" "names" "." ")"

/* @sem $bare_undaunted */
undaunted_reminded_text ::= bare_undaunted "(" "this" "spell" "costs" "{" "1" "}" "less" "to" "cast" "for" "each" "opponent" "." ")"

/* @sem $bare_conspire */
conspire_short_reminded_text ::= bare_conspire "(" "as" "you" "cast" "this" "spell" "," "you" "may" "tap" "two" "untapped" "creatures" "you" "control" "that" "share" "a" "color" "with" "it" "." "when" "you" "do" "," "copy" "it" "." ")"

/* Repeated payments denote the same native mechanic cost. */
typed_cost_mechanic_reminded_text ::= offspring_cost_reminded_text | squad_cost_reminded_text | encore_cost_reminded_text | transmute_cost_reminded_text | scavenge_cost_reminded_text | outlast_cost_reminded_text | more_than_meets_the_eye_cost_reminded_text | sneak_cost_reminded_text | sneak_enters_he_cost_reminded_text | sneak_enters_she_cost_reminded_text | squad_implicit_cost_reminded_text | disturb_cost_reminded_text

/* @sem Ability::Mechanic{mechanic:$mechanic_offspring_name, cost:Cost::@agree($keyword_payment, $keyword_payment_2)} */
offspring_cost_reminded_text ::= mechanic_offspring_name keyword_payment "(" "you" "may" "pay" "an" "additional" keyword_payment "as" "you" "cast" "this" "spell" "." "if" "you" "do" "," "when" "this" "creature" "enters" "," "create" "a" "1" "/" "1" "token" "copy" "of" "it" "." ")"

/* @sem Ability::Mechanic{mechanic:$mechanic_squad_name, cost:Cost::@agree($keyword_payment, $keyword_payment_2)} */
squad_cost_reminded_text ::= mechanic_squad_name keyword_payment "(" "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "you" "may" "pay" keyword_payment "any" "number" "of" "times" "." "when" "this" "creature" "enters" "," "create" "that" "many" "tokens" "that" "are" "copies" "of" "it" "." ")"

/* @sem Ability::Mechanic{mechanic:$mechanic_encore_name, cost:Cost::@agree($keyword_payment, $keyword_payment_2)} */
encore_cost_reminded_text ::= mechanic_encore_name keyword_payment "(" keyword_payment "," "↑" "exile" "this" "card" "from" "your" "graveyard" ":" "for" "each" "opponent" "," "create" "a" "token" "copy" "that" "attacks" "that" "opponent" "this" "turn" "if" "able" "." "they" "gain" "haste" "." "sacrifice" "them" "at" "the" "beginning" "of" "the" "next" "end" "step" "." "activate" "only" "as" "a" "sorcery" "." ")"

/* @sem Ability::Mechanic{mechanic:$mechanic_transmute_name, cost:Cost::@agree($keyword_payment, $keyword_payment_2)} */
transmute_cost_reminded_text ::= mechanic_transmute_name keyword_payment "(" keyword_payment "," "↑" "discard" "this" "card" ":" "search" "your" "library" "for" "a" "card" "with" "the" "same" "mana" "value" "as" "this" "card" "," "reveal" "it" "," "put" "it" "into" "your" "hand" "," "then" "shuffle" "." "transmute" "only" "as" "a" "sorcery" "." ")"

/* @sem Ability::Mechanic{mechanic:$mechanic_scavenge_name, cost:Cost::@agree($keyword_payment, $keyword_payment_2)} */
scavenge_cost_reminded_text ::= mechanic_scavenge_name keyword_payment "(" keyword_payment "," "↑" "exile" "this" "card" "from" "your" "graveyard" ":" "put" "a" "number" "of" "+" "1" "/" "+" "1" "counters" "equal" "to" "this" "card's" "power" "on" "target" "creature" "." "scavenge" "only" "as" "a" "sorcery" "." ")"

/* @sem Ability::Mechanic{mechanic:$mechanic_outlast_name, cost:Cost::@agree($keyword_payment, $keyword_payment_2)} */
outlast_cost_reminded_text ::= mechanic_outlast_name keyword_payment "(" keyword_payment "," "{" "T" "}" ":" "put" "a" "+" "1" "/" "+" "1" "counter" "on" "this" "creature" "." "outlast" "only" "as" "a" "sorcery" "." ")"

/* @sem Ability::Mechanic{mechanic:$mechanic_more_than_meets_the_eye_name, cost:Cost::@agree($keyword_payment, $keyword_payment_2)} */
more_than_meets_the_eye_cost_reminded_text ::= mechanic_more_than_meets_the_eye_name keyword_payment "(" "you" "may" "cast" "this" "card" "converted" "for" keyword_payment "." ")"

