/* Council's dilemma. Starting with you, each player votes in turn for one of two
   words; later sentences count the votes for a word or ask which word won. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, starting_with:AbilityController, body:_{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:Words([$vote_word, $vote_word_2])}}]}}] */
clause_word_vote ::= "starting" "with" "you" "," "each" "player" "votes" "for" vote_word "or" vote_word

/* A color ballot names its colors as words (Council Guardian). */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, starting_with:AbilityController, body:_{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:Words([$vote_color, $vote_color_2, $vote_color_3, $vote_color_4])}}]}}] */
clause_color_vote ::= "starting" "with" "you" "," "each" "player" "votes" "for" vote_color "," vote_color "," vote_color "," "or" vote_color
vote_color ::= vote_white | vote_blue | vote_black | vote_red | vote_green
/* @sem String::'White' */
vote_white ::= "white"
/* @sem String::'Blue' */
vote_blue ::= "blue"
/* @sem String::'Black' */
vote_black ::= "black"
/* @sem String::'Red' */
vote_red ::= "red"
/* @sem String::'Green' */
vote_green ::= "green"

/* @sem Expr::Votes(Word($vote_word)) */
count_each_vote ::= vote_word "vote"

/* @sem Condition::MostVotes{option:Word($vote_word), tied:false} */
condition_most_votes ::= vote_word "gets" "more" "votes"
/* @sem Condition::MostVotes{option:Word($vote_word), tied:true} */
condition_most_votes_or_tied ::= vote_word "gets" "more" "votes" "or" "the" "vote" "is" "tied"

/* The words a ballot offers, each a data terminal that prints as written. */
vote_word ::= vote_bribery | vote_carnage | vote_chaos | vote_condemnation | vote_death | vote_denial | vote_dominion | vote_duplication | vote_embark | vote_evidence | vote_feather | vote_free | vote_grace | vote_guidance | vote_harvest | vote_homage | vote_knowledge | vote_money | vote_numbers | vote_past | vote_planeswalk | vote_present | vote_profit | vote_psychosis | vote_quill | vote_return | vote_security | vote_sickness | vote_sprout | vote_strength | vote_taxes | vote_time | vote_torture | vote_wild
/* @sem String::'Bribery' */
vote_bribery ::= "bribery"
/* @sem String::'Carnage' */
vote_carnage ::= "carnage"
/* @sem String::'Chaos' */
vote_chaos ::= "chaos"
/* @sem String::'Condemnation' */
