/* Council's dilemma. Starting with you, each player votes in turn for one of two
   words; later sentences count the votes for a word or ask which word won. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, starting_with:AbilityController, body:_{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:Words([$vote_word, $vote_word_2])}}]}}] */
clause_word_vote ::= "starting" "with" "you" "," "each" "player" "votes" "for" vote_word "or" vote_word

/* A color ballot names its colors as words (Council Guardian). */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, starting_with:AbilityController, body:_{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:Words($vote_color_options)}}]}}] */
clause_color_vote ::= "starting" "with" "you" "," "each" "player" "votes" "for" vote_color_options

/* @sem String::[$vote_color, ...$vote_color_options_tail] */
vote_color_options ::= vote_color "," vote_color_options_tail

vote_color_options_tail ::= vote_color_options_last_pair | vote_color_options
/* @sem String::[$vote_color, $vote_color_2] */
vote_color_options_last_pair ::= vote_color "," "or" vote_color
vote_color ::= vote_white | vote_blue | vote_black | vote_red | vote_green
/* @sem String::'White' */
vote_white ::= "white"
/* @sem String::'Blue' */
vote_blue ::= "blue"
/* @sem String::'Black' */
vote_black ::= "black"
/* @sem String::'Red' */
vote_red ::= "red"
/* @sem String::'Green' */
vote_green ::= "green"

/* @prefer always */
/* @sem Expr::Votes(Word($vote_word)) */
count_each_vote ::= vote_word "vote"

/* @sem Condition::MostVotes{option:Word($vote_word), tied:false} */
condition_most_votes ::= vote_word "gets" "more" "votes"
/* @sem Condition::MostVotes{option:Word($vote_word), tied:true} */
condition_most_votes_or_tied ::= vote_word "gets" "more" "votes" "or" "the" "vote" "is" "tied"

/* The words a ballot offers, each a data terminal that prints as written. */
vote_word ::= choice_war_peace | vote_innocent | vote_guilty | vote_truth | vote_consequences | vote_redhorn_pass | vote_mines_of_moria | vote_bribery | vote_carnage | vote_chaos | vote_condemnation | vote_death | vote_denial | vote_dominion | vote_duplication | vote_embark | vote_evidence | vote_feather | vote_free | vote_grace | vote_guidance | vote_harvest | vote_homage | vote_knowledge | vote_money | vote_numbers | vote_past | vote_planeswalk | vote_present | vote_profit | vote_psychosis | vote_quill | vote_return | vote_security | vote_sickness | vote_sprout | vote_strength | vote_taxes | vote_time | vote_torture | vote_wild
/* @sem String::'Bribery' */
vote_bribery ::= "bribery"
/* @sem String::'Carnage' */
vote_carnage ::= "carnage"
/* @sem String::'Chaos' */
vote_chaos ::= "chaos"
/* @sem String::'Condemnation' */
vote_condemnation ::= "condemnation"
/* @sem String::'Death' */
vote_death ::= "death"
/* @sem String::'Denial' */
vote_denial ::= "denial"
/* @sem String::'Dominion' */
vote_dominion ::= "dominion"
/* @sem String::'Duplication' */
vote_duplication ::= "duplication"
/* @sem String::'Embark' */
vote_embark ::= "embark"
/* @sem String::'Evidence' */
vote_evidence ::= "evidence"
/* @sem String::'Feather' */
vote_feather ::= "feather"
/* @sem String::'Free' */
vote_free ::= "free"
/* @sem String::'Grace' */
vote_grace ::= "grace"
/* @sem String::'Guidance' */
vote_guidance ::= "guidance"
/* @sem String::'Harvest' */
vote_harvest ::= "harvest"
/* @sem String::'Homage' */
vote_homage ::= "homage"
/* @sem String::'Knowledge' */
vote_knowledge ::= "knowledge"
/* @sem String::'Money' */
vote_money ::= "money"
/* @sem String::'Numbers' */
vote_numbers ::= "numbers"
/* @sem String::'Past' */
vote_past ::= "past"
/* @sem String::'Planeswalk' */
vote_planeswalk ::= "planeswalk"
/* @sem String::'Present' */
vote_present ::= "present"
/* @sem String::'Profit' */
vote_profit ::= "profit"
/* @sem String::'Psychosis' */
vote_psychosis ::= "psychosis"
/* @sem String::'Quill' */
vote_quill ::= "quill"
/* @sem String::'Return' */
vote_return ::= "return"
/* @sem String::'Security' */
vote_security ::= "security"
/* @sem String::'Sickness' */
vote_sickness ::= "sickness"
/* @sem String::'Sprout' */
vote_sprout ::= "sprout"
/* @sem String::'Strength' */
vote_strength ::= "strength"
/* @sem String::'Taxes' */
vote_taxes ::= "taxes"
/* @sem String::'Time' */
vote_time ::= "time"
/* @sem String::'Torture' */
vote_torture ::= "torture"
/* @sem String::'Wild' */
vote_wild ::= "wild"

/* The ballot and its outcome are scoped together: the unqualified winning
   cards refer to this graveyard vote, not an arbitrary preceding vote. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, starting_with:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:GraveyardCards(AllOf([AnyOf([$vote_vowel_card_type, $vote_card_type, $vote_card_type_2]), InZone(Players{zone:Graveyard, players:One(AbilityController)})])), secret:false}}]}}, Effect{result:@next, operation:Move{objects:Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:State(MostVotes)}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_graveyard_vote_return ::= "starting" "with" "you" "," "each" "player" "votes" "for" "an" vote_vowel_card_type "," vote_card_type "," "or" vote_card_type "card" "in" "your" "graveyard" "." "return" "each" "card" "with" "the" "most" "votes" "or" "tied" "for" "most" "votes" "to" "your" "hand"

vote_vowel_card_type ::= noun_artifact | noun_enchantment
vote_card_type ::= noun_artifact | noun_creature | noun_enchantment | noun_land | noun_planeswalker | noun_battle

/* The controller investigates once for each vote for the named option. */
/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Investigate{times:$count_each_vote}}}] */
clause_investigate_per_vote ::= "for" "each" count_each_vote "," "investigate"

/* Multiword ballot options retain their individual word identities. */
/* @sem String::'Redhorn Pass' */
vote_redhorn_pass ::= "Redhorn" "Pass"

/* @sem String::'Mines of Moria' */
vote_mines_of_moria ::= "Mines" "of" "Moria"

/* A separate exile paragraph belongs to the same spell as the vote. */
/* @prefer always */
/* @sem Ability::[Spell{announcement:@announcement, body:Program{instructions:[...$clause_word_vote, ...$clause_vote_search_tapped, ...$clause_vote_graveyard_return_any, ...$vote_exile_source]}}] */
line_vote_search_return_exile ::= clause_word_vote "." clause_vote_search_tapped "." clause_vote_graveyard_return_any "." NEWLINE vote_exile_source "."

/* @prefer always */
/* @sem Ability::[Spell{announcement:@announcement, body:Program{instructions:[...$clause_word_vote, ...$clause_vote_search_tapped, ...$clause_vote_graveyard_return, ...$vote_exile_source]}}] */
line_vote_search_filtered_return_exile ::= clause_word_vote "." clause_vote_search_tapped "." clause_vote_graveyard_return "." NEWLINE vote_exile_source "."

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One(Source), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
vote_exile_source ::= "exile" SELF_NAME

/* A required secret object ballot reveals only after all voters have voted. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}), secret:true}}]}}, Effect{result:@next, operation:RevealChoices{kind:Object}}] */
secret_required_object_vote ::= players_singular "secretly" "votes" "for" "a" filter_phrase "," "then" "those" "votes" "are" "revealed"

/* This bounded ballot guarantees every object receiving a vote is a creature. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and(ObjectFilter::CardType(Creature), $vote_creature_control)}), secret:true}}]}}, Effect{result:@next, operation:RevealChoices{kind:Object}}] */
secret_controlled_creature_vote ::= players_singular "secretly" "votes" "for" "a" "creature" vote_creature_control "," "then" "those" "votes" "are" "revealed"
vote_creature_control ::= modifier_you_control | modifier_not_controlled

/* The consumer is used only after the creature ballot above, which proves the
   printed creature restriction for both operations on the voted population. */
/* @sem Instruction::[Effect{result:@next, operation:PutCountersEach{amount:Votes(Object(Affected)), kind:$counter_kind, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:State(ReceivedAVote)}}}, Effect{result:@next, operation:SetTapped{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:State(ReceivedAVote)}, tapped:true}}] */
voted_creature_counters_tap ::= "for" "each" "creature" "with" "one" "or" "more" "votes" "," "put" "that" "many" counter_kind "counters" "on" "it" "," "then" "tap" "it"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$secret_controlled_creature_vote, ...$voted_creature_counters_tap]}} */
spell_creature_vote_counters_tap ::= secret_controlled_creature_vote "." voted_creature_counters_tap "."

/* A vote for the named option grants the controller one extra turn. */
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::TakeExtraTurn{times:$count_each_vote}} */
extra_turn_per_vote ::= "for" "each" count_each_vote "," "take" "an" "extra" "turn" "after" "this" "one"

/* Each voter supplies a separate selection; control applies to all selections. */
/* @sem Instruction::[ForEachPlayer{players:Matching{binding:0, condition:VotedFor{player:Bound(0), option:Word($vote_word)}}, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($vote_owned_noun, ObjectFilter::OwnedBy(One(Bound(0))))}, count:AsManyAsCan(Constant(1))}}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Selected(@prior)), changes:[SetController(AbilityController)], duration:Indefinite, evaluation:Snapshot}}] */
clause_vote_owned_control ::= "for" "each" vote_word "vote" "," "choose" "a" vote_owned_noun "owned" "by" "the" "voter" "and" "gain" "control" "of" "it"
vote_owned_noun ::= noun_permanent | noun_creature | noun_land | noun_planeswalker

/* Both outcomes use their own printed vote conditions and actions. */
/* @sem Instruction::[If{condition:$condition_most_votes, then:Program{instructions:[Effect{result:@next, operation:$planeswalk_action}]}, otherwise:Program{instructions:[]}}, If{condition:$condition_most_votes_or_tied, then:Program{instructions:[Effect{result:@next, operation:$temporary_chaos_action}]}, otherwise:Program{instructions:[]}}] */
planeswalk_vote_outcomes ::= "if" condition_most_votes "," planeswalk_action "." "if" condition_most_votes_or_tied "," temporary_chaos_action

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$instructions_discard_hand_mana_draw, ...$clause_word_vote, ...$planeswalk_vote_outcomes]}} */
spell_discard_receipt_word_vote ::= instructions_discard_hand_mana_draw "." NEWLINE clause_word_vote "." planeswalk_vote_outcomes "."

/* A vote outcome can trigger an ordinary keyword action for the controller. */
/* @sem Instruction::[If{condition:$condition_most_votes, then:Program{instructions:[Effect{result:@next, operation:$vote_keyword_action}]}, otherwise:Program{}}] */
clause_vote_keyword_winner ::= "if" condition_most_votes "," vote_keyword_action

/* @sem Instruction::[If{condition:$condition_most_votes_or_tied, then:Program{instructions:[Effect{result:@next, operation:$vote_keyword_action}]}, otherwise:Program{}}] */
clause_vote_keyword_winner_or_tied ::= "if" condition_most_votes_or_tied "," vote_keyword_action

vote_keyword_action ::= planeswalk_action | temporary_chaos_action

/* Search and vote paragraphs compose their independently declared instructions. */
/* @sem Ability::[Spell{announcement:@announcement, body:Program{instructions:[...$clause_search_plural_follow, ...$clause_word_vote, ...$clause_vote_keyword_winner, ...$clause_vote_keyword_winner_or_tied]}}] */
line_search_vote_outcomes ::= clause_search_plural_follow "." NEWLINE clause_word_vote "." clause_vote_keyword_winner "." clause_vote_keyword_winner_or_tied "."

/* A player's extra vote retains both the affected player and whether it is optional. */
/* @sem Ability::Static{kind:Ordinary, affected:Players($player_rule_you), changes:[PlayerRule($additional_vote_rule)]} */
static_voting_player_rule ::= "while" "voting" "," player_rule_you additional_vote_rule "."

additional_vote_rule ::= optional_extra_vote | required_extra_vote | required_extra_vote_canonical

/* @sem PlayerRule::AdditionalVote{optional:true} */
optional_extra_vote ::= "may" "vote" "an" "additional" "time"

/* @sem PlayerRule::AdditionalVote{optional:false} */
required_extra_vote ::= "vote" "an" "additional" "time"

/* @prefer always */
/* @sem PlayerRule::AdditionalVote{optional:false} */
required_extra_vote_canonical ::= "get" "an" "additional" "vote"

/* An additional vote is a player rule; the affected player and permission
   remain independent operands. Agreement belongs to the subject phrase. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Players($voting_extra_required_subject), changes:[PlayerRule(AdditionalVote{optional:false})]}) */
voting_extra_required ::= "while" "voting" "," voting_extra_required_subject "an" "additional" "vote" "."

voting_extra_required_subject ::= voting_you_get | voting_many_get | voting_singular_gets

/* @sem PlayerSet::One(PlayerRef::AbilityController) */
voting_you_get ::= "you" "get"

/* @sem $player_keyword_many */
voting_many_get ::= player_keyword_many "get"

/* @sem $players_singular */
voting_singular_gets ::= players_singular "gets"

/* @sem Ability::Static(_{kind:Ordinary, affected:Players($player_rule_subject), changes:[PlayerRule(AdditionalVote{optional:true})]}) */
voting_extra_optional ::= "while" "voting" "," player_rule_subject "may" "get" "an" "additional" "vote" "."

/* Independent instructions before and after the vote remain separate operands. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$instructions_mill_graveyard_entry, ...$clause_word_vote, ...$clause_vote_keyword_winner, ...$clause_vote_keyword_winner_or_tied]}} */
spell_mill_graveyard_entry_vote ::= instructions_mill_graveyard_entry "." NEWLINE clause_word_vote "." clause_vote_keyword_winner "." clause_vote_keyword_winner_or_tied "."

/* A public object ballot keeps the voter binding and the chosen population. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, starting_with:AbilityController, body:_{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase})}}]}}] */
public_object_ballot ::= "starting" "with" "you" "," "each" "player" "votes" "for" "a" filter_phrase

/* This sequence is scoped to its explicit winning-object exile. */
/* @sem Operation::@exile_result(Operation::Move{objects:$objects_each_vote_winner, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}) */
vote_winner_exile ::= "exile" objects_each_vote_winner

/* @sem Instruction::[...$public_object_ballot, Effect{result:@next, operation:$vote_winner_exile}] */
instructions_public_vote_exile ::= public_object_ballot "." vote_winner_exile

/* Vote outcomes use the named vote condition and an independently specified
   keyword action. The tie condition is a separate printed shape. */
/* vote_chaos_ensues_action is shared as temporary_chaos_action. */

vote_outcome_action ::= keyword_action | temporary_chaos_action

/* @sem Instruction::[If{condition:$condition_most_votes, then:Program{instructions:[Effect{result:@next, operation:$vote_outcome_action}]}, otherwise:Program{}}] */
vote_outcome_winner ::= "if" condition_most_votes "," vote_outcome_action

/* @sem Instruction::[If{condition:$condition_most_votes_or_tied, then:Program{instructions:[Effect{result:@next, operation:$vote_outcome_action}]}, otherwise:Program{}}] */
vote_outcome_winner_or_tied ::= "if" condition_most_votes_or_tied "," vote_outcome_action

/* An initial instruction and a subsequent ballot are part of one spell. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$clause_third, ...$clause_word_vote, ...$vote_outcome_winner, ...$vote_outcome_winner_or_tied]}} */
spell_instruction_vote_outcomes ::= clause_third "." NEWLINE clause_word_vote "." vote_outcome_winner "." vote_outcome_winner_or_tied "."

/* @sem String::'Truth' */
vote_truth ::= "truth"

/* @sem String::'Consequences' */
vote_consequences ::= "consequences"

/* @sem Expr::Votes(Player(AbilityController)) */
count_each_your_vote ::= "vote" "you" "received"

count_fronted_vote ::= count_each_vote | count_each_your_vote

/* A winning ballot can cause a keyword action followed by a counter placement. */
/* @sem Instruction::[If{condition:$condition_most_votes, then:Program{instructions:[Effect{result:@next, operation:$keyword_action}, Effect{result:@next, operation:$shared_you_put_counters}]}, otherwise:Program{}}] */
vote_keyword_counter_winner ::= "if" condition_most_votes "," keyword_action "," "then" shared_you_put_counters

/* @sem Instruction::[If{condition:$condition_most_votes_or_tied, then:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}]}, otherwise:Program{}}] */
vote_draw_winner_or_tied ::= "if" condition_most_votes_or_tied "," "draw" card_count

/* @sem Ability::Triggered{event:$turn_event, intervening_if:$condition_another_entered_this_turn, limits:_{}, announcement:@announcement, body:Program{instructions:[...$clause_word_vote, ...$vote_keyword_counter_winner, ...$vote_draw_winner_or_tied]}} */
triggered_word_vote_counter ::= "at" turn_event "," "if" condition_another_entered_this_turn "," clause_word_vote "." vote_keyword_counter_winner "." vote_draw_winner_or_tied "."

/* A chosen stack spell can be acted on by two separately tested ballot outcomes.
   The target is announced once and both actions retain that target identity. */
/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:[...$clause_word_vote, If{condition:$vote_counter_outcome, then:_{instructions:[Effect{result:@next, operation:Counter{objects:One($target_stack_spell), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}]}, otherwise:_{}}, If{condition:$vote_copy_outcome, then:_{instructions:[Effect{result:@next, operation:CopyOnStack{actor:One(AbilityController), object:Target{slot:@last_slot, index:0}, times:Constant(1), targets:May}}]}, otherwise:_{}}]}} */
spell_choose_voted_stack_actions ::= "choose" target_stack_spell "." clause_word_vote "." vote_counter_outcome "." vote_copy_outcome "."

/* @sem Condition::$condition_most_votes */
vote_counter_outcome ::= "if" condition_most_votes "," "counter" "the" "spell"

/* @sem Condition::$condition_most_votes_or_tied */
vote_copy_outcome ::= "if" condition_most_votes_or_tied "," "copy" "the" "spell" "." "you" "may" "choose" "new" "targets" "for" "the" "copy"

/* The ballot fixes a creature population while retaining its control filter. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, starting_with:AbilityController, body:_{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$public_creature_vote_filter})}}]}}] */
public_creature_ballot ::= "starting" "with" "you" "," "each" "player" "votes" "for" "a" public_creature_vote_filter

/* @sem @and(ObjectFilter::CardType(Creature), $vote_creature_control) */
public_creature_vote_filter ::= "creature" vote_creature_control

/* Only the adjacent creature ballot proves the winner's creature type. */
/* @sem Instruction::[...$public_creature_ballot, Effect{result:@next, operation:Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$modifier_vote_winner}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
instructions_public_creature_vote_exile ::= public_creature_ballot "." "exile" "each" "creature" modifier_vote_winner

/* Secret word choices and their reveal form a reusable ballot. */
/* @sem Instruction::[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:_{instructions:[Effect{result:@next, operation:Vote{actor:One(Bound(0)), ballot:Words([$secret_vote_word, $secret_vote_word_2]), secret:true}}]}}, Effect{result:@next, operation:RevealChoices{kind:Word}}] */
secret_opponent_word_choices ::= "each" "opponent" "secretly" "chooses" secret_vote_word "or" secret_vote_word "," "then" "the" "choices" "are" "revealed"

secret_vote_word ::= vote_word | secret_vote_silence | secret_vote_snitch

/* @sem String::'Silence' */
secret_vote_silence ::= "silence"

/* @sem String::'Snitch' */
secret_vote_snitch ::= "snitch"

/* The otherwise condition is the complement of the two preceding tests.
   Each pronoun's recipients are the voters for that particular option. */
/* @sem Instruction::[If{condition:AllVotedFor(Word($secret_vote_word)), then:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(Matching{binding:0, condition:VotedFor{player:Bound(0), option:Word($secret_vote_word)}}), amount:$number, preventable:true}}]}, otherwise:_{}}, If{condition:AllVotedFor(Word($secret_vote_word_2)), then:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(Matching{binding:0, condition:VotedFor{player:Bound(0), option:Word($secret_vote_word_2)}}), amount:$number_2, preventable:true}}]}, otherwise:_{}}, If{condition:Not(AnyOf([AllVotedFor(Word($secret_vote_word)), AllVotedFor(Word($secret_vote_word_2))])), then:_{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(Matching{binding:0, condition:VotedFor{player:Bound(0), option:Word($secret_vote_word_3)}}), amount:$number_3, preventable:true}}]}, otherwise:_{}}] */
secret_vote_damage_outcomes ::= "if" "each" "opponent" "chose" secret_vote_word "," SELF_NAME "deals" number "damage" "to" "each" "of" "them" "." "if" "each" "opponent" "chose" secret_vote_word "," SELF_NAME "deals" number "damage" "to" "each" "of" "them" "." "otherwise" "," SELF_NAME "deals" number "damage" "to" "each" "opponent" "who" "chose" secret_vote_word

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$secret_opponent_word_choices, ...$secret_vote_damage_outcomes]}} */
spell_secret_vote_damage ::= secret_opponent_word_choices "." secret_vote_damage_outcomes "."

/* Independent word choices and their subsequent per-chooser outcomes. */
shared_choice_word ::= vote_word | choice_word | shared_choice_friends | shared_choice_secrets

/* @sem String::'Friends' */
shared_choice_friends ::= "friends"

/* @sem String::'Secrets' */
shared_choice_secrets ::= "secrets"

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseValue{choosers:One(Bound(0)), kind:Word, terms:_{count:Exactly(Constant(1)), options:[Text($shared_choice_word), Text($shared_choice_word_2), Text($shared_choice_word_3)]}}}]}}] */
shared_three_word_choices ::= players_singular "chooses" shared_choice_word "," shared_choice_word "," "or" shared_choice_word

/* Each matching player receives one token, and the controller receives one per matching player. */
/* @sem Instruction::[Effect{result:@next, operation:Together([CreateTokens{players:One(AbilityController), tokens:[_{amount:CountPlayers(Matching{binding:0, condition:VotedFor{player:Bound(0), option:Word($shared_choice_word)}}), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}, CreateTokens{players:Matching{binding:0, condition:VotedFor{player:Bound(0), option:Word($shared_choice_word)}}, tokens:[_{amount:Constant(1), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}])}] */
shared_choice_named_tokens ::= "for" "each" "player" "who" "chose" shared_choice_word "," "you" "and" "that" "player" "each" "create" "a" token_named_recipe "token"

/* @sem Instruction::[Effect{result:@next, operation:Together([CreateTokens{players:One(AbilityController), tokens:[_{amount:CountPlayers(Matching{binding:0, condition:VotedFor{player:Bound(0), option:Word($shared_choice_word)}}), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}, CreateTokens{players:Matching{binding:0, condition:VotedFor{player:Bound(0), option:Word($shared_choice_word)}}, tokens:[_{amount:Constant(1), words:CreatingEffect, recipe:$token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}])}] */
shared_choice_defined_tokens ::= "for" "each" "player" "who" "chose" shared_choice_word "," "you" "and" "that" "player" "each" "create" "a" token_recipe

/* @sem Instruction::[Effect{result:@next, operation:Together([Draw{players:One(AbilityController), amount:@times($card_count, Expr::CountPlayers(Matching{binding:0, condition:VotedFor{player:Bound(0), option:Word($shared_choice_word)}}))}, Draw{players:Matching{binding:0, condition:VotedFor{player:Bound(0), option:Word($shared_choice_word)}}, amount:$card_count}])}] */
shared_choice_draw ::= "for" "each" "player" "who" "chose" shared_choice_word "," "you" "and" "that" "player" "each" "draw" card_count

shared_choice_outcome ::= shared_choice_named_tokens | shared_choice_defined_tokens | shared_choice_draw

/* @sem Program::Program{instructions:[...$shared_three_word_choices, ...$shared_choice_outcome, ...$shared_choice_outcome_2, ...$shared_choice_outcome_3]} */
shared_choice_three_outcomes ::= shared_three_word_choices "." shared_choice_outcome "." shared_choice_outcome "." shared_choice_outcome

/* @sem Instruction::[...$each_player_mill_cards, ...$choose_graveyard_card_added_type] */
instructions_mill_graveyard_entry ::= each_player_mill_cards "." "then" choose_graveyard_card_added_type

/* @sem String::'innocent' */
vote_innocent ::= "innocent"

/* @sem String::'guilty' */
vote_guilty ::= "guilty"

/* The winning outcome reads the linked exiled cards, using each card's owner's library. */
/* @sem Program::Program{instructions:[...$clause_word_vote, If{condition:$condition_most_votes, then:Program{instructions:[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Zone{scope:Shared(Exile), kind:Card, filter:AllOf([ExiledWith($self_explicit_ref), OwnedBy(One(Bound(0)))])}, destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{}}, qualifiers:[]}}]}}]}, otherwise:Program{}}]} */
program_vote_linked_exile_bottom ::= clause_word_vote "." "if" condition_most_votes "," "the" "owner" "of" "each" "card" "exiled" "with" self_explicit_ref "puts" "that" "card" "on" "the" "bottom" "of" "their" "library"

/* The requirement is generated by this resolving ability. The turn window
   belongs to the live voter selection, and the source is the same incarnation. */
/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[...$clause_word_vote, Effect{result:@next, operation:$put_counter_once_per_vote}, Effect{result:@next, operation:$draw_and_lose_life_once_per_vote}, Effect{result:@next, operation:$source_must_attack_turn_voter}]}} */
triggered_vote_counter_draw_lose_attack ::= "at" turn_event "," clause_word_vote "." put_counter_once_per_vote "." draw_and_lose_life_once_per_vote "." source_must_attack_turn_voter "."

/* @sem Operation::Repeat{times:$count_each_vote, body:$put_counter_on_named_source} */
put_counter_once_per_vote ::= "for" "each" count_each_vote "," put_counter_on_named_source

/* @sem Operation::Repeat{times:$count_each_vote, body:InOrder([Draw{players:One(AbilityController), amount:$card_count}, LoseLife{players:One(AbilityController), amount:$value}])} */
draw_and_lose_life_once_per_vote ::= "for" "each" count_each_vote "," "you" "draw" card_count "and" "lose" value "life"

/* @sem Operation::CreateContinuousEffect{source:$self_ref_named, affected:Objects(One($self_ref_named)), changes:[Rule(RequireCombat{action:Attack(Players(Matching{binding:0, condition:PlayerDid{player:Bound(0), event:VotedFor(Word($vote_word)), window:ThisTurn}})), amount:AtLeast(Constant(1))})], duration:Indefinite, evaluation:LiveObjects} */
source_must_attack_turn_voter ::= self_ref_named "attacks" "a" "player" "who" "voted" "for" vote_word "this" "turn" "each" "combat" "if" "able"
