/* @sem String::'Feather' */
vote_feather ::= "feather"
/* @sem String::'Free' */
vote_free ::= "free"
/* @sem String::'Grace' */
vote_grace ::= "grace"
/* @sem String::'Guidance' */
vote_guidance ::= "guidance"
