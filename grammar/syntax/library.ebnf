/* Searching and inspecting a library. */

/* What was found stays the referent of `it` until the search is over. */
clause_search ::= clause_search_constrained_plural | clause_search_general | clause_search_any_number | clause_search_graveyard_pair | clause_search_sentence_follow | clause_search_counted | clause_search_single_depth | clause_search_three_colors_graveyard | clause_search_conditional_entry | clause_search_library_pair | clause_search_reveal_branch | clause_search_three_reveal_hand | clause_search_basic_types_tapped | clause_search_named_each
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:$search}, ...$search_follow] */
clause_search_general ::= search search_follow
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:$search_plural}, ...$search_plural_follow] */
clause_search_any_number ::= search_plural search_plural_follow
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_any_number]} */
search_any_number ::= "search" "your" "library" "for" search_choice_any_number
search_plural_follow ::= search_plural_more | search_shuffle | search_shuffle_top_any_order
/* @sem Instruction::[Instruction::Effect{result:@next, operation:$found_plural_action}, ...$search_plural_follow] */
search_plural_more ::= "," found_plural_action search_plural_follow
found_plural_action ::= found_plural_reveal | found_plural_exile | found_plural_hand | found_plural_battlefield | found_plural_battlefield_tapped
/* @sem Operation::Reveal{objects:Selected(@marked)} */
found_plural_reveal ::= "reveal" "them"
/* @sem Operation::Move{objects:Selected(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
found_plural_exile ::= "exile" "them"
/* @sem Operation::@search_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}) */
found_plural_battlefield ::= "put" "them" "onto" "the" "battlefield"
/* @sem Operation::@search_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}) */
found_plural_battlefield_tapped ::= "put" "them" "onto" "the" "battlefield" "tapped"

/* A where-X definition can close the search sentence; the next sentence moves
   what was found. */
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_many_where]}}, Instruction::Effect{result:@next, operation:$found_action}, ...$search_follow] */
clause_search_where_split ::= "search" "your" "library" "for" search_choice_many_where "." found_action search_follow

/* A named player searches their own library and keeps the selected identities
   through the following move or shuffle/reorder. These subjects use third person. */
search_player ::= target_player | target_opponent | that_player | defending_player | search_possessive_controller | search_possessive_owner | its_controller | its_owner | attacking_player | stack_controller

/* @sem PlayerRef::ControllerOf($self_possessive) */
search_possessive_controller ::= self_possessive "controller"
/* @sem PlayerRef::OwnerOf($self_possessive) */
search_possessive_owner ::= self_possessive "owner"

/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:$search_player, library_owner:$search_player, choices:[$player_search_hand]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($search_player)}}] */
clause_player_search_hand ::= search_player player_search_hand

/* @sem Instruction::[Effect{result:@next, operation:LoseLife{players:One($search_player), amount:$life_phrase}}, Effect{result:@mark, operation:Search{searcher:$search_player, library_owner:$search_player, choices:[$player_search_hand]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($search_player)}}] */
clause_player_loss_search ::= search_player "loses" life_phrase "," player_search_hand

/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:$search_player, library_owner:$search_player, choices:[$player_search_top]}}, Effect{result:@next, operation:Shuffle{players:One($search_player), excluding:Selected(@marked)}}, Effect{result:@next, operation:ReorderLibrary{chooser:$search_player, library_owner:$search_player, objects:Selected(@marked), end:Top, order:Chosen}}] */
clause_player_search_top ::= search_player player_search_top

/* A named player may search their own library. What they find enters under their
   control or goes to their hand, and they shuffle. Each player of a plural subject
   decides and searches separately; without "may" each of them searches. */
clause_player_may_search ::= each_threshold_search_difference | destroy_lands_search_replacement | each_may_search_then_each_shuffle | player_may_search_battlefield | player_may_search_reveal_hand | each_may_search_battlefield | each_may_search_reveal_hand | each_search_battlefield
/* @sem Instruction::[ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[$player_search_one_choice]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(Bound(0)), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}] */
each_search_battlefield ::= hand_plural_players "searches" "their" "library" "for" player_search_one_choice "," "puts" found_one search_option_entry "," "then" "shuffles"
/* @sem Instruction::[Optional{decider:$search_player, body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:$search_player, library_owner:$search_player, choices:[$may_search_choice]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player($search_player), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($search_player)}}]}}] */
player_may_search_battlefield ::= search_player "may" "search" "their" "library" "for" may_search_choice "," "put" found search_option_entry "," "then" "shuffle"
/* @sem Instruction::[Optional{decider:$search_player, body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:$search_player, library_owner:$search_player, choices:[$may_search_choice]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($search_player)}}]}}] */
player_may_search_reveal_hand ::= search_player "may" "search" "their" "library" "for" may_search_choice "," "reveal" found "," "put" found "into" "their" "hand" "," "then" "shuffle"
/* @sem Instruction::[ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[$may_search_choice]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(Bound(0)), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}]}}] */
each_may_search_battlefield ::= hand_plural_players "may" "search" "their" "library" "for" may_search_choice "," "put" found search_option_entry "," "then" "shuffle"
/* @sem Instruction::[ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[$may_search_choice]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}]}}] */
each_may_search_reveal_hand ::= hand_plural_players "may" "search" "their" "library" "for" may_search_choice "," "reveal" found "," "put" found "into" "their" "hand" "," "then" "shuffle"
may_search_choice ::= player_search_one_choice | player_search_many_choice

player_search_hand ::= player_search_hand_one | player_search_hand_many
/* @sem $player_search_one_choice */
player_search_hand_one ::= "searches" "their" "library" "for" player_search_one_choice "," "puts" found_one "into" "their" "hand" "," "then" "shuffles"
/* @sem $player_search_many_choice */
player_search_hand_many ::= "searches" "their" "library" "for" player_search_many_choice "," "puts" found_many "into" "their" "hand" "," "then" "shuffles"

player_search_top ::= player_search_top_one | player_search_top_many
/* @sem $player_search_one_choice */
player_search_top_one ::= "searches" "their" "library" "for" player_search_one_choice "," "then" "shuffles" "and" "puts" found_one "on" "top"
/* @sem $player_search_many_choice */
player_search_top_many ::= "searches" "their" "library" "for" player_search_many_choice "," "then" "shuffles" "and" "puts" found_many "on" "top"

/* @sem () */
found_one ::= "it" | "that" "card"
/* @sem () */
found_many ::= "them" | "those" "cards"

player_search_one_choice ::= search_choice_any | search_choice_filtered | search_choice_optional_one
player_search_many_choice ::= search_choice_many | search_choice_many_any

/* After milling, you may put one matching card of those milled into your hand. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$mill_take_choice}, count:Exactly(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
clause_mill_take ::= "mill" card_count "." "you" "may" "put" mill_take_choice mill_take_origin "into" "your" "hand"
mill_take_choice ::= mill_take_filtered | mill_take_modified
/* @sem $search_filter */
mill_take_filtered ::= ("a" | "an") search_filter
/* @sem $modifier */
mill_take_modified ::= "a" "card" modifier

/* What a search looks for: one find clause. */
search_choice ::= search_choice_shared_color | search_choice_filtered | search_choice_any | search_choice_modified | search_choice_many | search_choice_many_any | search_named_one | search_named_many | search_choice_many_where | search_choice_basic_land_type | search_choice_enchant_host
/* An unrestricted plural choice composes with the ordinary search follow-ups. */
search_choice_any_number ::= search_choice_any_number_filtered | search_choice_any_number_colorless

/* The count's definition follows the cards it counts. */
/* @sem SearchChoice::SearchChoice{filter:$search_filter_many, count:UpTo($value)} */
search_choice_many_where ::= "up" "to" "X" search_filter_many "," "where" "X" "is" value
/* @sem SearchChoice::SearchChoice{filter:Any, count:AsManyAsCan(Constant(1))} */
search_choice_any ::= "a" "card"
/* @sem SearchChoice::SearchChoice{filter:$search_filter, count:UpTo(Constant(1))} */
search_choice_filtered ::= ("a" | "an") search_filter
/* A card described only by what follows the noun, as `a card named Jiang Yanggu`. */
/* @sem SearchChoice::SearchChoice{filter:$modifier, count:UpTo(Constant(1))} */
search_choice_modified ::= "a" "card" modifier
/* @sem SearchChoice::SearchChoice{filter:Any, count:UpTo(Constant(1))} */
search_choice_optional_one ::= "up" "to" ("one" | "1") "card"
/* @sem SearchChoice::SearchChoice{filter:$search_filter_many, count:UpTo($count)} */
search_choice_many ::= "up" "to" count search_filter_many
/* @sem SearchChoice::SearchChoice{filter:Any, count:UpTo($count)} */
search_choice_many_any ::= "up" "to" count "cards"

/* A later paragraph offers an alternative destination for the same original
   selection. Selected retains those identities: the normal hand move follows
   the optional change, and the shuffle remains outside its condition. */
/* @sem Ability::WithPresentation{label:$ability_label, reminder:false, ability:Spell{announcement:@announcement, body:Program{instructions:[...$search_option_start, ...$search_option_if, Effect{result:@next, operation:$found_hand}, ...$search_shuffle]}}} */
labelled_search_option ::= search_option_start "," found_hand search_shuffle "." NEWLINE ability_label "—" search_option_if "."

search_option_start ::= search_option_plain | search_option_revealed

/* @sem Instruction::[Effect{result:@mark, operation:$search}] */
search_option_plain ::= search

/* @sem Instruction::[Effect{result:@mark, operation:$search}, Effect{result:@next, operation:$found_reveal}] */
search_option_revealed ::= search "," found_reveal

/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:$search_option_move}]}, otherwise:Program{}}] */
search_option_if ::= search_option_move "instead" "of" "putting" found "into" owners ("hand" | "hands") "if" condition

/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(PlayerRef::AbilityController)), objects:Selected(@marked), count:AnyNumber, constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:Battlefield{controller:Owner, arrival:$search_option_entry}, qualifiers:[]}} */
search_option_move ::= "you" "may" "put" found search_option_entry

search_option_entry ::= search_option_normal | search_option_tapped

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[], states:[]} */
search_option_normal ::= "onto" "the" "battlefield"

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:true, counters:[], states:[]} */
search_option_tapped ::= "onto" "the" "battlefield" "tapped"

search ::= search_library | search_library_graveyard

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice]} */
search_library ::= "search" "your" "library" "for" search_choice

/* The graveyard is searched along with the library, which is still shuffled. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice], also:[Graveyard]} */
search_library_graveyard ::= "search" "your" "library" "and" "graveyard" "for" search_choice

/* With `and/or` the searcher chooses where to look, and shuffles only if that
   included the library. The search stays the referent until the shuffle. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice], also:[Graveyard], either:true}}, ...$search_either_follow, If{condition:Searched(@marked), then:Program{instructions:[Effect{result:@next, operation:Shuffle{players:One(PlayerRef::AbilityController)}}]}, otherwise:Program{}}] */
clause_search_either ::= "search" "your" search_either_zones "for" search_choice search_either_follow "." "if" "you" "search" "your" "library" "this" "way" "," "shuffle"

/* @sem () */
search_either_zones ::= "library" "and" "/" "or" "graveyard" | "graveyard" "and" "/" "or" "library"

search_either_follow ::= search_either_one | search_either_two
/* @sem Instruction::[Effect{result:@next, operation:$found_action}] */
search_either_one ::= "and" found_action
/* @sem Instruction::[Effect{result:@next, operation:$found_action}, Effect{result:@next, operation:$found_action_2}] */
search_either_two ::= "," found_action "," ("and" | "then") found_action

search_filter ::= search_filter_subtype_list | search_filter_plain | search_filter_modified | search_filter_either | search_filter_either_bare | search_filter_distinct_controlled_name | search_filter_shared_object_name | search_filter_keyword_alternative

/* "A basic land card or a Desert card": either kind, each with its own noun. */
/* @sem ObjectFilter::AnyOf([$card_filter, $card_filter_2]) */
search_filter_either ::= card_filter "card" "or" ("a" | "an") card_filter "card"

/* @sem $card_filter */
search_filter_plain ::= card_filter "card"

/* @sem @and($card_filter, $modifiers) */
search_filter_modified ::= card_filter "card" modifiers

search_filter_many ::= search_many_plain | search_many_modified | search_many_ability

/* @sem $card_filter */
search_many_plain ::= card_filter "cards"

/* @sem @and($card_filter, $modifiers) */
search_many_modified ::= card_filter "cards" modifiers

/* You search a named player's library, act on what was found, and that player
   shuffles. What was found keeps its owner. A sentence between the two would
   need what was found as its referent, so it is not part of this form. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:$target_possessive, choices:[$foreign_search_choice]}}, Effect{result:@next, operation:$foreign_found_action}, Effect{result:@next, operation:Shuffle{players:One($target_possessive)}}] */
clause_search_target_library ::= "search" target_possessive "library" "for" foreign_search_choice "and" foreign_found_action "." "then" ("that" | "the") "player" "shuffles"
foreign_search_choice ::= search_choice | foreign_choice_count | foreign_choice_where | foreign_choice_up_to_where
/* @sem SearchChoice::SearchChoice{filter:Any, count:AsManyAsCan($count)} */
foreign_choice_count ::= count "cards"
/* @sem SearchChoice::SearchChoice{filter:Any, count:AsManyAsCan($value)} */
foreign_choice_where ::= "X" "cards" "," "where" "X" "is" value ","
/* @sem SearchChoice::SearchChoice{filter:Any, count:UpTo($value)} */
foreign_choice_up_to_where ::= "up" "to" "X" "cards" "," "where" "X" "is" value ","
foreign_found_action ::= found_exile | found_graveyard | found_battlefield_yours
/* @sem Operation::@search_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}) */
found_battlefield_yours ::= "put" found "onto" "the" "battlefield" "under" "your" "control"

search_follow ::= search_follow_more | search_follow_last

/* @sem Instruction::[Instruction::Effect{result:@next, operation:$found_action}, ...$search_follow] */
search_follow_more ::= "," found_action search_follow

search_follow_last ::= search_shuffle | search_shuffle_top | search_shuffle_top_the_card | search_shuffle_top_any_order

/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::Shuffle{players:One(PlayerRef::AbilityController)}}] */
search_shuffle ::= "," "then" "shuffle" ("your" "library")?

/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::Shuffle{players:One(PlayerRef::AbilityController), excluding:Selected(@marked)}}, Instruction::Effect{result:@next, operation:Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@marked), end:Top, order:Chosen}}] */
search_shuffle_top ::= "," "then" "shuffle" "and" "put" found "on" "top"

/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::Shuffle{players:One(PlayerRef::AbilityController), excluding:Selected(@marked)}}, Instruction::Effect{result:@next, operation:Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@marked), end:Top, order:Chosen}}] */
search_shuffle_top_any_order ::= "," "then" "shuffle" "and" "put" "those" "cards" "on" "top" "in" "any" "order"

/* @sem () */
found ::= "it" | "them" | "that" "card" | "those" "cards"

found_action ::= found_battlefield_tapped_target_controller | found_battlefield_attached_player | found_reveal | found_exile | found_hand | found_graveyard | found_top | found_battlefield | found_battlefield_tapped

/* @sem Operation::Reveal{objects:Selected(@marked)} */
found_reveal ::= "reveal" found
/* @sem Operation::Move{objects:Selected(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
found_exile ::= "exile" found
/* @sem Operation::Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
found_hand ::= "put" found "into" owners ("hand" | "hands")
/* @sem Operation::Move{objects:Selected(@marked), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]} */
found_graveyard ::= "put" found "into" owners ("graveyard" | "graveyards")
/* @sem Operation::Move{objects:Selected(@marked), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
found_top ::= "put" found "on" "top" "of" owners ("library" | "libraries")
/* @sem Operation::@search_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}) */
found_battlefield ::= "put" found "onto" "the" "battlefield"
/* @sem Operation::@search_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}) */
found_battlefield_tapped ::= "put" found "onto" "the" "battlefield" "tapped"

/* An end of one player's library or graveyard: "the top two cards of target player's
   library", "the bottom card of your graveyard". */
ordered_cards ::= ordered_slice | ordered_counted | ordered_filtered_card | ordered_event_owner_cards | ordered_named_count | library_tops

/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:$ordered_zone, players:One($player_possessive)}, kind:Card, filter:Any}, count:$top_count, from:$ordered_end} */
ordered_slice ::= "the" ordered_end top_count "of" player_possessive ordered_zone

/* "That many cards from the top of your library": the same slice, counted first. */
/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:$ordered_zone, players:One($player_possessive)}, kind:Card, filter:Any}, count:$card_count, from:$ordered_end} */
ordered_counted ::= card_count "from" "the" ordered_end "of" player_possessive ordered_zone

/* "The top card of each player's library" is one card from each library, not the top
   card of all of them together. */
/* @sem ObjectSet::LibraryTops($players_possessive) */
library_tops ::= "the" "top" "card" "of" players_possessive "library"

/* The top card itself, read where it is: "if the top card of your library is a land
   card". */
/* @sem ObjectRef::Query{objects:Zone{scope:Players{zone:$ordered_zone, players:One($player_possessive)}, kind:Card, filter:Any}, index:0} */
ordered_top_card ::= "the" "top" "card" "of" player_possessive ordered_zone

ordered_end ::= ordered_top | ordered_bottom
/* @sem SequenceEnd::Top */
ordered_top ::= "top"
/* @sem SequenceEnd::Bottom */
ordered_bottom ::= "bottom"

ordered_zone ::= ordered_library | ordered_graveyard
/* @sem EventZone::Library */
ordered_library ::= "library"
/* @sem EventZone::Graveyard */
ordered_graveyard ::= "graveyard"

/* The top of your library, looked at or shown. What follows the look names your own
   library and hand. */
your_top ::= your_top_slice | your_top_counted

/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:$top_count, from:Top} */
your_top_slice ::= "the" "top" top_count "of" "your" "library"

/* "That many cards from the top of your library": the same slice, counted first. */
/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:$card_count_that_many, from:Top} */
your_top_counted ::= card_count_that_many "from" "the" "top" "of" "your" "library"

top_count ::= top_one | top_many

/* @sem Expr::Constant(1) */
top_one ::= "card"

/* @sem $number */
top_many ::= number "cards"

/* @sem Operation::Reveal{objects:$your_top} */
reveal_top ::= "reveal" your_top

/* @sem Operation::LookAt{player:AbilityController, objects:$your_top} */
look_top ::= "look" "at" your_top

/* Inspect the specified objects without moving or choosing any of them. */
/* @sem Operation::LookAt{player:AbilityController, objects:$affected} */
look_objects ::= "look" "at" affected

/* Cards looked at stay observed; what is left of them is what was not moved. */
/* @sem CardOrder::Random */
order_random ::= "in" "a" "random" "order"
/* @sem CardOrder::Chosen */
order_any ::= "in" "any" "order"

library_order ::= order_random | order_any

/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(2), phase:Before}])}, zone:Library}, end:Bottom, order:$library_order} */
rest_bottom ::= "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Operation::Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(2), phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]} */
rest_graveyard ::= ("the" "rest" | "the" "other") "into" "your" "graveyard"

/* With one card left, Oracle names no order for it. */
/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(2), phase:Before}])}, zone:Library}, end:Bottom, order:Chosen} */
rest_other_bottom ::= "the" "other" "on" "the" "bottom" "of" "your" "library"

look_rest ::= rest_bottom | rest_other_bottom | rest_graveyard | rest_top

/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($look_hand_count), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Instruction::Effect{result:@next, operation:Operation::Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Instruction::Effect{result:@next, operation:$look_rest}] */
look_put_split ::= "put" look_hand_count "into" "your" "hand" "and" look_rest

/* @sem Instruction::[Instruction::Effect{result:@mark, operation:$look_top}, ...$look_put_split] */
instructions_look_put ::= ("you")? look_top "." look_put_split

/* "Look ..., then put ..." is one sentence, so a condition before it governs the
   whole look and split; the two-sentence form above is not a clause. */
/* @sem $look_put_then_body */
clause_look_put_then ::= ("you")? look_put_then_body

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$look_put_split] */
look_put_then_body ::= look_top ("," "then" | "and") look_put_split

look_count ::= number

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}} */
look_battlefield_tapped ::= "onto" "the" "battlefield" "tapped"

/* Looking at or revealing the top of your library, taking some of those cards and
   putting the rest away. The take chooses from the observed cards still in the
   library; the rest excludes what the move took. Later sentences follow the block. */
instructions_dig ::= look_target_library_optional_shuffle | look_split_cast_origin_instead | dig_block | dig_block_more | dig_block_untaken | dig_optional_reveal_joined | dig_look_keep_exile

/* @sem Instruction::[...$dig_block, ...$instructions] */
dig_block_more ::= dig_block "." instructions

/* Only a look-and-take states the miss this way; a revealed required take names
   its move's result instead. */
/* @sem Instruction::[...$dig_look_split, $dig_untaken_if] */
dig_block_untaken ::= dig_look_split "." dig_untaken_if

/* Nothing was taken when the take's move, just before the rest, moved no card. */
/* @sem Instruction::If{condition:Not(Compare{left:CountObjects(Union([Transition{result:@back(2), phase:Before}])), test:Compare{comparison:Greater, value:Constant(0)}}), then:Program{instructions:$conjoined}, otherwise:Program{}} */
dig_untaken_if ::= "if" "you" "didn't" "put" "a" "card" "into" "your" "hand" "this" "way" "," conjoined

dig_block ::= reveal_until_optional_entry_remainder | dig_reveal_keyword_distribution | dig_look_battlefield_value | dig_look_convoke_shuffle | dig_look_split | dig_look_joined | dig_reveal_split | dig_reveal_joined | dig_look_exile_other | dig_reveal_opponent_other | dig_look_conditional_rest | dig_look_random_exile | dig_reveal_opponent_choice | dig_reveal_two_entries | dig_reveal_entry_remainder | dig_look_manifest_other | dig_look_manifest_rest | dig_reveal_matching_graveyard | dig_look_named_hand | dig_look_exile_counter | dig_look_cloak

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$dig_follow_split] */
dig_look_split ::= look_top "." dig_follow_split

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$dig_follow_joined] */
dig_look_joined ::= look_top "." dig_follow_joined

/* What follows a look: a take, then the rest, in two sentences or one. */
dig_follow ::= dig_follow_split | dig_follow_joined

/* @sem Instruction::[...$dig_look_take, $dig_rest_put] */
dig_follow_split ::= dig_look_take "." dig_rest_put

/* @sem Instruction::[...$dig_put_take, $dig_rest_and] */
dig_follow_joined ::= dig_put_take dig_rest_and

/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$dig_put_take, $dig_rest_put] */
dig_reveal_split ::= reveal_top "." dig_put_take "." dig_rest_put

/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$dig_put_take, $dig_rest_and] */
dig_reveal_joined ::= reveal_top "." dig_put_take dig_rest_and

/* "Reveal the top card of your library. If it's a land card, put it onto the
   battlefield. Otherwise, put that card into your hand." The test reads the revealed
   card; "it" in each branch is still the top card of your library, which the branch
   takes. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:Expr::Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}, then:Program{instructions:$observed_top_reveal_branch}, otherwise:Program{}}] */
instructions_top_reveal_if ::= "reveal" "the" "top" "card" "of" "your" "library" "." "if" "it's" top_reveal_quality "," observed_top_reveal_branch
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:Expr::Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}, then:Program{instructions:$observed_top_reveal_branch}, otherwise:Program{instructions:$observed_top_reveal_branch_2}}] */
instructions_top_reveal_if_otherwise ::= "reveal" "the" "top" "card" "of" "your" "library" "." "if" "it's" top_reveal_quality "," observed_top_reveal_branch "." "otherwise" "," observed_top_reveal_branch

/* "Defending player reveals the top card of their library. If it's a land card, that
   player puts it into their hand": another player's single revealed card, tested and
   moved by that player. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:Expr::Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:Observed(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{}}] */
instructions_player_reveal_to_hand ::= player_ref "reveals" "the" "top" "card" "of" "their" "library" "." "if" "it's" top_reveal_quality "," "that" "player" "puts" "it" "into" "their" "hand"
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:Expr::Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}, then:Program{instructions:[Optional{decider:$player_ref, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Observed(@marked), destination:Battlefield{controller:Player($player_ref), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}]}, otherwise:Program{}}] */
instructions_player_reveal_may_battlefield ::= player_ref "reveals" "the" "top" "card" "of" "their" "library" "." "if" "it's" top_reveal_quality "," "the" "player" "may" "put" "it" "onto" "the" "battlefield"

/* "You may pay {2}{R}. If you do, reveal the top card of your library. If it's ...": the
   test of the revealed card stays inside the paid branch that revealed it. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:$top_reveal_test}, otherwise:Program{}}] */
clause_if_you_do_reveal_test ::= "you" "may" payment "." "if" "you" "do" "," top_reveal_test
top_reveal_test ::= instructions_top_reveal_if | instructions_top_reveal_if_otherwise
top_reveal_quality ::= top_reveal_union_double_faced | top_reveal_kind | top_reveal_kind_with
/* @sem $card_filter */
top_reveal_kind ::= ("a" | "an") card_filter "card"
/* @sem @and($card_filter, $modifiers) */
top_reveal_kind_with ::= ("a" | "an") card_filter "card" modifiers
top_reveal_branch ::= top_reveal_put | top_reveal_may_put | top_reveal_draw | top_reveal_continuous | clause_you | top_reveal_you_and
/* @sem Instruction::[...$clause_you, ...$clause_you_2] */
top_reveal_you_and ::= clause_you "and" clause_you
/* @sem Instruction::[Effect{result:@next, operation:$continuous_snapshot}] */
top_reveal_continuous ::= continuous_snapshot
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:Expr::Constant(1), from:Top}, destination:$top_reveal_destination, qualifiers:[]}}] */
top_reveal_put ::= "put" top_reveal_it top_reveal_destination
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:$top_reveal_put}}] */
top_reveal_may_put ::= "you" "may" top_reveal_put
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}] */
top_reveal_draw ::= "draw" card_count
/* @sem () */
top_reveal_it ::= "it" | "that" "card"
top_reveal_destination ::= until_hand | until_battlefield | look_battlefield_tapped | top_reveal_graveyard | top_reveal_bottom
/* @sem MovementDestination::OwnersGraveyard(CardArrival{counters:[], states:[]}) */
top_reveal_graveyard ::= "into" "your" "graveyard"
/* @sem MovementDestination::Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
top_reveal_bottom ::= "on" "the" "bottom" "of" "your" "library"

/* The rest is numbered where its words start, after the take it excludes. */
/* @sem Instruction::Effect{result:@next, operation:$look_rest} */
dig_rest_put ::= ("then")? "put" look_rest
/* @sem Instruction::Effect{result:@next, operation:$look_rest} */
dig_rest_and ::= "and" look_rest

/* Looked-at cards are revealed as they are taken; revealed ones are already shown. */
dig_look_take ::= dig_reveal_each_to_hand | dig_reveal_one | dig_reveal_upto | dig_reveal_any | dig_reveal_top | dig_top_one | dig_put_take

/* A revealed card put back on top stays in the library; the reorder is its receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$a_card}, count:UpTo(Constant(1))}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@back(3)), end:Top, order:Chosen}}] */
dig_reveal_top ::= "you" "may" "reveal" a_card "from" "among" "them" "and" "put" found_one "on" "top" "of" "your" "library"

/* Keeping one card on top reorders it in place; the rest exclude that reorder. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:UpTo(Constant(1))}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@prior), end:Top, order:Chosen}}] */
dig_top_one ::= "you" "may" "put" "one" "of" ("them" | "those" "cards") ("back")? "on" "top" "of" "your" "library"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$a_card}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
dig_reveal_one ::= "you" "may" "reveal" a_card "from" "among" "them" "and" "put" found_one "into" "your" "hand"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$search_filter_many}, count:UpTo($count), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
dig_reveal_upto ::= "you" "may" "reveal" "up" "to" count search_filter_many "from" "among" "them" "and" "put" dig_found_many "into" "your" "hand"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$search_filter_many}, count:AnyNumber, constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
dig_reveal_any ::= "you" "may" "reveal" "any" "number" "of" search_filter_many "from" "among" "them" "and" "put" dig_found_many "into" "your" "hand"

/* @sem () */
dig_found_many ::= "them" | "those" "cards" | "the" "revealed" "cards"

/* "You may put a card" takes at most one; "put a card" takes one if there is one. */
dig_put_take ::= dig_put_conditional_entry | dig_put_same_name | dig_put_may_one | dig_put_one | dig_put_upto | dig_put_any | dig_put_all | dig_put_one_each | dig_put_revealed_one

/* "A creature card and/or a land card": up to one card of each kind. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:UpTo(Constant(2)), constraints:[OneForEach([$card_filter, $card_filter_2])]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}] */
dig_put_one_each ::= "you" "may" "put" ("a" | "an") card_filter "card" "and" "/" "or" ("a" | "an") card_filter "card" "from" "among" "them" dig_destination

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$a_card}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:$dig_destination}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}] */
dig_put_may_one ::= "you" "may" "put" a_card "from" "among" "them" dig_destination

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$a_card}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:$dig_destination}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}] */
dig_put_one ::= "put" a_card "from" "among" "them" dig_destination

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$search_filter_many}, count:UpTo($count), constraints:[CanMoveTo{destination:$dig_destination}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}] */
dig_put_upto ::= ("you" "may")? "put" "up" "to" count search_filter_many "from" "among" "them" dig_destination

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$search_filter_many}, count:AnyNumber, constraints:[CanMoveTo{destination:$dig_destination}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}] */
dig_put_any ::= ("you" "may")? "put" "any" "number" "of" search_filter_many "from" "among" "them" dig_destination

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$search_filter_many}, destination:$dig_destination, qualifiers:[]}}] */
dig_put_all ::= "put" "all" search_filter_many dig_all_among dig_destination

/* @sem () */
dig_all_among ::= "from" "among" "them" | "revealed" "this" "way"

dig_destination ::= until_hand | until_battlefield | look_battlefield_tapped | look_battlefield_counter

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, $counter_amount]], states:[]}} */
look_battlefield_counter ::= "onto" "the" "battlefield" "with" counter_amount counter_kind "counter" "on" "it"

/* Casting removes cards from the observed library directly. The remainder is
   the observed population still in that zone, independent of cast receipts. */
/* @sem Instruction::[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$spell_filter}, count:UpTo(Constant(1)), terms:_{cost:Free}}}, Effect{result:@next, operation:$look_cast_rest}] */
look_cast_split ::= "you" "may" "cast" spell_filter "from" "among" "them" "without" "paying" "its" "mana" "cost" "." "put" look_cast_rest

/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:$library_order} */
look_cast_rest ::= "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$look_cast_split] */
instructions_look_cast ::= look_top "." look_cast_split

/* Reordering the chosen card does not change its zone. The other observed
   cards exclude that reorder receipt's original selected identities. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:$look_top_count}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@prior), end:Top, order:Chosen}}, Effect{result:@next, operation:$rest_bottom}] */
look_top_split ::= "put" look_top_count "of" ("them" | "those" "cards") "on" "top" "of" "your" "library" "and" rest_bottom

look_top_count ::= look_top_upto | look_top_required
/* @sem Count::UpTo($number) */
look_top_upto ::= "up" "to" number
/* @sem Count::AsManyAsCan($number) */
look_top_required ::= number

/* @sem Instruction::[...$look_top_split, ...$clause_if] */
look_top_condition_split ::= look_top_split "." clause_if

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$look_top_split] */
instructions_look_top ::= look_top "." look_top_split

/* Each phrase owns its result introductions at its own source position. This
   keeps reordering and a later cast from advancing the exile receipt early. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$a_card}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
look_exile_card ::= "you" "may" "exile" a_card "from" "among" "them"

/* @sem Instruction::[Effect{result:@next, operation:$rest_bottom}] */
look_put_remainder ::= "put" rest_bottom

/* The actual exile incarnation stays the cast operand after reordering. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Result{result:@back(3), phase:After, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}] */
look_cast_exiled ::= "you" "may" "cast" "the" "exiled" "card" "without" "paying" "its" "mana" "cost"

/* @sem Instruction::[...$look_exile_card, ...$look_put_remainder, ...$look_cast_exiled] */
look_exile_cast_split ::= look_exile_card "." look_put_remainder "." look_cast_exiled

/* @sem Instruction::[Instruction::Effect{result:@mark, operation:Operation::RevealUntil{library:AbilityController, filter:$reveal_until_card, count:Expr::Constant(1)}}, Instruction::Effect{result:@next, operation:Operation::Move{objects:Matching{objects:Observed(@marked), filter:$reveal_until_card}, destination:$until_destination, qualifiers:[]}}, Instruction::Effect{result:@next, operation:$rest_bottom}] */
instructions_reveal_until ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" reveal_until_card "." "put" "that" "card" until_destination "and" rest_bottom

until_destination ::= until_hand | until_battlefield | look_battlefield_tapped

/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
until_hand ::= "into" "your" "hand"
/* @sem MovementDestination::Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
until_battlefield ::= "onto" "the" "battlefield"


/* "If it's a land card, you may reveal it and put it into your hand": an optional move
   of the top card that only a matching card can make. A later sentence about putting
   the card into your hand tests that move as a payment. The payment and its action
   start on the same word, so the test names the payment by its mark. */
/* The head carries the eligibility filter; the common action retains the
   controller, reveal, destination, and result of the optional move. */
/* @sem Operation::MoveTopCard{actor:One(AbilityController), cards:$top_card_reveal_head, reveal:true, destination:OwnersHand(CardArrival{counters:[], states:[]})} */
top_card_revealed_to_hand ::= top_card_reveal_head "and" "put" "it" "into" "your" "hand"
/* @sem Instruction::[Effect{result:@next, operation:$top_card_revealed_to_hand}] */
top_card_reveal_action ::= top_card_revealed_to_hand
/* @sem Cost::Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:$top_card_reveal_action}}]} */
top_card_reveal_payment ::= top_card_reveal_action
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:$top_card_reveal_action}}] */
clause_top_card_revealed ::= top_card_reveal_action
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$top_card_reveal_payment, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:$top_reveal_branch}, otherwise:Program{}}] */
clause_top_card_revealed_declined ::= top_card_reveal_payment "." "if" "you" "don't" "put" ("it" | "the" "card") "into" "your" "hand" "," top_reveal_branch
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$top_card_reveal_payment, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_top_card_revealed_taken ::= top_card_reveal_payment "." "if" "you" "put" "a" "card" "into" "your" "hand" "this" "way" "," conjoined

/* "If it's a land card, you may put it onto the battlefield tapped": the same optional move
   without a reveal. The card enters under its owner's control. A later sentence about not
   putting it onto the battlefield, or "Otherwise", tests that move as a payment. */
/* @sem Operation::MoveTopCard{actor:One(AbilityController), cards:$card_filter, reveal:false, destination:$top_card_battlefield} */
top_card_put_onto_battlefield ::= "if" "it's" ("a" | "an") card_filter "card" "," "you" "may" "put" "it" top_card_battlefield
top_card_battlefield ::= top_card_battlefield_untapped | top_card_battlefield_tapped
/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
top_card_battlefield_untapped ::= "onto" "the" "battlefield"
/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}} */
top_card_battlefield_tapped ::= "onto" "the" "battlefield" "tapped"
/* @sem Instruction::[Effect{result:@next, operation:$top_card_put_onto_battlefield}] */
top_card_put_action ::= top_card_put_onto_battlefield
/* @sem Cost::Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:$top_card_put_action}}]} */
top_card_put_payment ::= top_card_put_action
/* The look comes first in these productions, so a reveal's card is never moved this way. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:Expr::Constant(1), from:Top}}}] */
top_card_look ::= "look" "at" "the" "top" "card" "of" "your" "library" "."
/* @sem Instruction::[...$top_card_look, Optional{decider:AbilityController, body:Program{instructions:$top_card_put_action}}] */
clause_top_card_put ::= top_card_look top_card_put_action
/* Most such cards name "the card" they didn't put, so that wording outranks "it" and
   "Otherwise". */
/* @prefer always */
/* @sem Instruction::[...$top_card_look, Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$top_card_put_payment, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:$top_reveal_branch}, otherwise:Program{}}] */
clause_top_card_put_declined ::= top_card_look top_card_put_payment "." "if" "you" "don't" "put" "the" "card" "onto" "the" "battlefield" "," top_reveal_branch
/* @sem Instruction::[...$top_card_look, Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$top_card_put_payment, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:$top_reveal_branch}, otherwise:Program{}}] */
clause_top_card_put_declined_it ::= top_card_look top_card_put_payment "." "if" "you" "don't" "put" "it" "onto" "the" "battlefield" "," top_reveal_branch
/* @sem Instruction::[...$top_card_look, Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$top_card_put_payment, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_top_card_put_this_way ::= top_card_look top_card_put_payment "." "if" "you" "didn't" "put" "a" "card" "onto" "the" "battlefield" "this" "way" "," conjoined
/* @sem Instruction::[...$top_card_look, Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$top_card_put_payment, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:$top_reveal_branch}, otherwise:Program{}}] */
clause_top_card_put_otherwise ::= top_card_look top_card_put_payment "." "otherwise" "," top_reveal_branch

/* Kinship: an optional look at the top card; if it shares a creature type with this
   creature, an optional reveal of it; and what follows only once it is revealed. Each
   optional action is a payment with its own guard, as in Wandering Graybeard. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[If{condition:ObjectMatches{object:Query{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), index:0}, filter:Shares{property:CreatureTypes, with:$self_ref}}, then:Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:$kinship_revealed, otherwise:Program{}}]}, otherwise:Program{}}]}, otherwise:Program{}}] */
instructions_kinship_reveal ::= "you" "may" "look" "at" "the" "top" "card" "of" "your" "library" "." "if" "it" "shares" "a" "creature" "type" "with" self_ref "," "you" "may" "reveal" "it" "." "if" "you" "do" "," kinship_revealed

kinship_revealed ::= kinship_free_play | program

/* "You may play that card without paying its mana cost": the revealed top card. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:Either, cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, count:Exactly(Constant(1)), terms:_{cost:Free}}}]}}]} */
kinship_free_play ::= "you" "may" "play" "that" "card" "without" "paying" "its" "mana" "cost"

/* Choosing a card from a zone, then acting on it. */
your_zone ::= your_hand | your_graveyard

/* A resolving cast offer selects one eligible hand card; timing and the
   optional decision belong to the enclosing instruction, not to a static rule. */
/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$hand_spell_choice}, count:Exactly(Constant(1)), cost:Free} */
cast_free_hand_spell ::= "cast" hand_spell_choice "from" "your" "hand" "without" "paying" "its" "mana" "cost"
hand_spell_choice ::= spell_any | spell_filtered | spell_modified | spell_described

/* Searching one player's graveyard, hand and library for cards with a name
   and exiling them. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:$player_possessive, choices:[_{filter:Chosen(CardName), count:$name_search_count}], also:[Graveyard, Hand]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_search_name_exile ::= "search" player_possessive "graveyard" "," "hand" "," "and" "library" "for" name_search_count "cards" "with" ("that" | "the" "chosen") "name" "and" "exile" "them"
name_search_count ::= named_search_count | name_search_all

/* Searching the zones of a named object's controller for cards sharing its
   name; that controller shuffles. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:ControllerOf($that_noun), choices:[_{filter:SharesNameWith($that_noun), count:$name_search_count}], also:[Graveyard, Hand]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf($that_noun))}}] */
clause_search_same_name_exile ::= "search" "its" "controller's" "graveyard" "," "hand" "," "and" "library" "for" name_search_count "cards" "with" "the" "same" "name" "as" that_noun "and" "exile" "them" "." "then" "that" "player" "shuffles"
/* @sem Count::AnyNumber */
name_search_all ::= "all"

/* A resolving cast of a target card for free. A card named by a pronoun
   needs the earlier action that names it, not this operation. */
/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:One($target_card), count:Exactly(Constant(1)), cost:Free, into_exile:false} */
cast_card_free ::= "cast" target_card "without" "paying" "its" "mana" "cost"

/* The card an exile-until stopped on, cast for free while resolving. */
/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:One($exiled_that_card), count:Exactly(Constant(1)), cost:Free, into_exile:false} */
cast_exiled_card_free ::= "cast" exiled_that_card "without" "paying" "its" "mana" "cost"
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One($exiled_that_card), from:Exile, action:CastSpell, filter:Any})], duration:$this_duration, evaluation:LiveObjects} */
cast_exiled_that_card_permission ::= "you" "may" "cast" exiled_that_card this_duration

/* A spell cast while resolving is exiled instead of going to a graveyard.
   The next sentence names that spell, so both sentences make one cast. */
/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:$affected, count:Exactly(Constant(1)), cost:Normal, into_exile:true}}]}}] */
clause_may_cast_exiled ::= "you" "may" "cast" affected "." "if" "that" "spell" "would" "be" "put" "into" ("a" | "your" | "their") "graveyard" "," "exile" "it" "instead"
/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:$affected, count:Exactly(Constant(1)), cost:Free, into_exile:true}}]}}] */
clause_may_cast_free_exiled ::= "you" "may" "cast" affected "without" "paying" "its" "mana" "cost" "." "if" "that" "spell" "would" "be" "put" "into" ("a" | "your" | "their") "graveyard" "," "exile" "it" "instead"

/* @sem EventZone::Hand */
your_hand ::= "your" "hand"
/* @sem EventZone::Graveyard */
your_graveyard ::= "your" "graveyard"

/* Cards put from your hand into your library are chosen first, so a short
   hand puts what it has. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, count:AsManyAsCan($card_count_one)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_hand_on_top ::= "put" card_count_one "from" "your" "hand" "on" "top" "of" "your" "library"
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, count:AsManyAsCan($card_count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_hand_on_bottom ::= "put" card_count "from" "your" "hand" "on" "the" "bottom" "of" "your" "library"
/* Two or more cards go "in any order": still the owner's default library order. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, count:AsManyAsCan($count_plural)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_hand_on_top_any_order ::= "put" count_plural "cards" "from" "your" "hand" "on" "top" "of" "your" "library" "in" "any" "order"
/* Oracle puts two or more cards on the bottom "in any order". */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, count:AsManyAsCan($count_plural)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_hand_on_bottom_any_order ::= "put" count_plural "cards" "from" "your" "hand" "on" "the" "bottom" "of" "your" "library" "in" "any" "order"
/* @sem CostPart::PlayerAction{player:AbilityController, body:Program{instructions:$clause_hand_on_top}} */
cost_hand_on_top ::= clause_hand_on_top
/* Any number of cards from your hand: you choose them, then they enter together. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AnyNumber, constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
clause_hand_any_number_battlefield ::= "put" "any" "number" "of" card_filter "cards" "from" "your" "hand" "onto" "the" "battlefield"

a_card ::= a_card_mana_equal_player_counters | a_card_maximum_mana | a_card_prevalent_type | a_card_any_with | a_card_any | a_card_kind | a_card_with | a_card_another | a_card_or | a_card_shared_or | a_card_basic_type | a_card_urzas | a_card_value_limit | a_card_mana_value_comparison

/* "A Mount creature card or a Plains card": either kind, each with its own noun. */
/* @sem ObjectFilter::AnyOf([$card_filter, $card_filter_2]) */
a_card_or ::= ("a" | "an") card_filter "card" "or" ("a" | "an")? card_filter "card"

/* "Another creature card from your graveyard": any but this card. */
/* @sem @and($card_filter, ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source))) */
a_card_another ::= "another" card_filter "card"

/* @sem ObjectFilter::Any */
a_card_any ::= "a" "card"
/* @sem $card_filter */
a_card_kind ::= ("a" | "an") card_filter "card"
/* @sem @and($card_filter, $modifiers) */
a_card_with ::= ("a" | "an") card_filter "card" modifiers

/* @sem Instruction::[Instruction::Effect{result:@mark, operation:Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:$your_zone, players:One(PlayerRef::AbilityController)}, kind:Card, filter:$a_card}, count:AsManyAsCan(Expr::Constant(1))}}, Instruction::Effect{result:@next, operation:Operation::@exiled_card_result(Operation::Move{objects:Selected(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]})}] */
/* "Exile a creature card from your graveyard. Create a token that's a copy of it.": the
   following pronoun names the one exiled card. */
clause_exile_from ::= "exile" a_card "from" your_zone

/* "Exile a card from your hand face down": you choose the cards, hidden once exiled. */
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:AsManyAsCan($card_count)}}, Instruction::Effect{result:@next, operation:Operation::Move{objects:Selected(@marked), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_exile_hand_face_down ::= "exile" card_count "from" "your" "hand" "face" "down"

/* @sem Instruction::[Instruction::Effect{result:@mark, operation:Operation::ChooseObjects{player:AbilityController, objects:$battlefield_card_choice, count:AsManyAsCan(Expr::Constant(1))}}, Instruction::Effect{result:@next, operation:Operation::@choice_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]})}] */
clause_put_from ::= battlefield_card_choice ("onto" | "to") "the" "battlefield" ("under" "your" "control")?

/* @sem Instruction::[Instruction::Effect{result:@mark, operation:Operation::ChooseObjects{player:AbilityController, objects:$battlefield_card_choice, count:AsManyAsCan(Expr::Constant(1))}}, Instruction::Effect{result:@next, operation:Operation::@choice_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]})}] */
clause_put_from_tapped ::= battlefield_card_choice ("onto" | "to") "the" "battlefield" "tapped" ("under" "your" "control")?

/* An Aura or Equipment card chosen this way enters attached to its host. */
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:Operation::ChooseObjects{player:AbilityController, objects:$battlefield_card_choice, count:AsManyAsCan(Expr::Constant(1))}}, Instruction::Effect{result:@next, operation:Operation::@choice_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo($object_ref)]}}, qualifiers:[]})}] */
clause_put_from_attached ::= battlefield_card_choice "onto" "the" "battlefield" "attached" "to" object_ref

/* "Return an instant or sorcery card exiled with this creature to its owner's hand". */
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:Operation::ChooseObjects{player:AbilityController, objects:$resolving_card_pool, count:AsManyAsCan(Expr::Constant(1))}}, Instruction::Effect{result:@next, operation:Operation::Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_return_pool_owner_hand ::= "return" resolving_card_pool "to" "its" "owner's" "hand"

battlefield_card_choice ::= explicit_battlefield_card_choice | putting_another_card
/* @sem $resolving_card_pool */
explicit_battlefield_card_choice ::= ("put" | "return") resolving_card_pool
/* Preserve the existing put-another idiom. Returning another after sacrificing
   has a different antecedent and uses its independent receipt-aware clause. */
/* @sem ObjectSet::Zone{scope:Players{zone:$your_zone, players:One(AbilityController)}, kind:Card, filter:$a_card_another} */
putting_another_card ::= "put" a_card_another "from" your_zone

resolving_card_pool ::= own_resolving_card_pool | own_hand_or_graveyard_pool | any_graveyard_card_pool | exiled_with_card_pool
explicit_card_choice ::= a_card_any_with | a_card_any | a_card_kind | a_card_with
/* @sem ObjectSet::Zone{scope:Players{zone:$your_zone, players:One(AbilityController)}, kind:Card, filter:$explicit_card_choice} */
own_resolving_card_pool ::= explicit_card_choice "from" your_zone
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$explicit_card_choice} */
any_graveyard_card_pool ::= explicit_card_choice "from" "a" "graveyard"
/* "From your hand or graveyard": one choice among the cards of both zones. */
/* @sem ObjectSet::Union([Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$explicit_card_choice}, Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$explicit_card_choice}]) */
own_hand_or_graveyard_pool ::= explicit_card_choice "from" "your" "hand" "or" "graveyard"
/* "A creature card exiled with this permanent": one of the exiled cards linked to it. */
/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:@and(ObjectFilter::ExiledWith($object_ref), $explicit_card_choice)} */
exiled_with_card_pool ::= explicit_card_choice "exiled" "with" object_ref

/* "Return a card you own exiled with this artifact to your hand": only your own
   cards can go to your hand. */
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Exile), kind:Card, filter:@and(ObjectFilter::OwnedBy(One(PlayerRef::AbilityController)), ObjectFilter::ExiledWith($object_ref), $explicit_card_choice)}, count:AsManyAsCan(Expr::Constant(1))}}, Instruction::Effect{result:@next, operation:Operation::Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_return_owned_exiled_with ::= "return" explicit_card_choice "you" "own" "exiled" "with" object_ref "to" "your" "hand"

/* The observed hand remains the population even if another object was named
   earlier. Selection and discard refer to the same single physical card. */
/* @sem Instruction::[Effect{result:@next, operation:$hand_observation}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(2)), zone:Hand}, filter:@and($card_filter, ObjectFilter::OwnedBy($players_singular))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:DiscardObjects{objects:One(Result{result:@prior, phase:After, index:0})}}] */
clause_observed_single_discard ::= hand_observation "," "you" "choose" ("a" | "one") card_filter "card" "from" "it" "," "then" players_singular "discards" "that" "card"

/* The previous action's before snapshot supplies the library, choice and
   caster. Relative addresses keep preceding effects independent of this unit. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:ControllerOf(Result{result:@prior, phase:Before, index:0}), filter:Not(CardType(Land)), count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Optional{decider:ControllerOf(Result{result:@back(3), phase:Before, index:0}), body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(ControllerOf(Result{result:@back(4), phase:Before, index:0})), action:CastSpell, cards:One(Query{objects:Matching{objects:Transition{result:@prior, phase:After}, filter:Not(CardType(Land))}, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}] */
controller_exile_until_cast ::= "its" "controller" "exiles" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "exile" ("a" | "one") "nonland" "card" "," "then" "they" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost"

/* Announce the player before the cards, even though Move stores that player's
   identity only in the target-card zone filter. choose is binding metadata. */
/* @sem Instruction::[@choose($shuffle_player), Effect{result:@next, operation:Move{objects:$shuffle_target_cards, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_shuffle_target_cards ::= shuffle_player "shuffles" shuffle_target_cards "into" "their" "library"
shuffle_player ::= target_player | target_opponent | that_player | defending_player | its_controller | its_owner

shuffle_target_cards ::= shuffle_target_card | shuffle_target_many_cards
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$shuffle_singular_count, filter:InZone(Players{zone:Graveyard, players:One(@that_player)})})) */
shuffle_target_card ::= shuffle_singular_count "target" "card" "from" "their" "graveyard"
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$shuffle_plural_count, filter:InZone(Players{zone:Graveyard, players:One(@that_player)})})) */
shuffle_target_many_cards ::= shuffle_plural_count "target" "cards" "from" "their" "graveyard"
/* @sem Count::@singular_count($target_count) */
shuffle_singular_count ::= target_count
/* @sem Count::@plural_count($target_count_any) */
shuffle_plural_count ::= target_count_any

/* Every iteration moves only its player's cards and then shuffles that library.
   The existing IR retains a singleton Union and explicit shuffle operation. */
/* @sem Instruction::[ForEachPlayer{players:$shuffle_plural_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Union([Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any})]), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}] */
clause_shuffle_graveyards ::= shuffle_plural_players "shuffles" "their" "graveyard" "into" "their" "library"
/* One player's graveyard goes into their library, then that library is shuffled. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Union([Zone(_{scope:Players{zone:Graveyard, players:One($player_ref)}, kind:Card, filter:Any})]), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($player_ref)}}] */
clause_player_shuffles_graveyard ::= player_ref "shuffles" "their" "graveyard" "into" "their" "library"
/* @sem Instruction::[ForEachPlayer{players:$shuffle_plural_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:$bound_hand_and_graveyard, destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}] */
clause_shuffle_hands_graveyards ::= shuffle_plural_players "shuffles" bound_hand_and_graveyard "into" "their" "library"
/* Then each of those players draws. */
/* @sem Instruction::[ForEachPlayer{players:$shuffle_plural_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Union([Zone(_{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any})]), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}, Effect{result:@next, operation:Draw{players:$shuffle_plural_players, amount:$card_count}}] */
clause_shuffle_hands_graveyards_draw ::= shuffle_plural_players "shuffles" "their" "hand" "and" "graveyard" "into" "their" "library" "," "then" "draws" card_count
shuffle_plural_players ::= players_each | players_each_opponent | players_each_other | players_each_other_opponent

/* Names written after named denote a card name, independently of holder roles. */
/* @sem SearchChoice::SearchChoice{filter:Name(@card_name), count:UpTo(Expr::Constant(1))} */
search_named_one ::= "a" "card" "named" SELF_NAME

/* @sem SearchChoice::SearchChoice{filter:Name(@card_name), count:$named_search_count} */
search_named_many ::= named_search_count "cards" "named" SELF_NAME

named_search_count ::= named_search_upto | named_search_any
/* @sem Count::UpTo($number) */
named_search_upto ::= "up" "to" number
/* @sem Count::AnyNumber */
named_search_any ::= "any" "number" "of"

/* Card targets keep their graveyard domain, quantity and owner restrictions. */
graveyard_target_cards ::= graveyard_modified_any_many | graveyard_distinct_values_many | graveyard_typed_modified_many | graveyard_budget_one | graveyard_budget_many | graveyard_any_one | graveyard_any_many | graveyard_typed_one | graveyard_typed_many
    | graveyard_common_any_one | graveyard_common_any_many | graveyard_common_typed_one | graveyard_common_typed_many
    | graveyard_target_owner_one | graveyard_target_owner_typed_one

/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:$graveyard_scope_target}), index:0}) */
graveyard_target_owner_one ::= "target" "card" graveyard_scope_target
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($card_filter, $graveyard_scope_target)}), index:0}) */
graveyard_target_owner_typed_one ::= "target" card_filter "card" graveyard_scope_target

graveyard_target_count ::= target_count_any | graveyard_one_or_two | graveyard_up_to_twice | graveyard_up_to_times
/* @sem Count::Between{minimum:Constant(1), maximum:Constant(2)} */
graveyard_one_or_two ::= ("one" | "1") "or" ("two" | "2")
/* @sem Count::@singular_count($graveyard_target_count) */
graveyard_singular_count ::= graveyard_target_count
/* @sem Count::@plural_count($graveyard_target_count) */
graveyard_plural_count ::= graveyard_target_count

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_singular_count, filter:$graveyard_scope})) */
graveyard_any_one ::= graveyard_singular_count "target" "card" graveyard_scope

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_plural_count, filter:$graveyard_scope})) */
graveyard_any_many ::= graveyard_plural_count "target" "cards" graveyard_scope

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_singular_count, filter:@and($card_filter, $graveyard_scope)})) */
graveyard_typed_one ::= graveyard_singular_count "target" card_filter "card" graveyard_scope

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_plural_count, filter:@and($card_filter, $graveyard_scope)})) */
graveyard_typed_many ::= graveyard_plural_count "target" card_filter "cards" graveyard_scope

/* Each announced card must satisfy the written characteristic restriction. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_plural_count, filter:@and($card_filter, @and($modifiers, $graveyard_scope))})) */
graveyard_typed_modified_many ::= graveyard_plural_count "target" card_filter "cards" modifiers graveyard_scope

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_singular_count, filter:$graveyard_common_scope, constraints:[CommonProperty(Owners)]})) */
graveyard_common_any_one ::= graveyard_singular_count "target" "card" graveyard_common_scope

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_plural_count, filter:$graveyard_common_scope, constraints:[CommonProperty(Owners)]})) */
graveyard_common_any_many ::= graveyard_plural_count "target" "cards" graveyard_common_scope

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_singular_count, filter:@and($card_filter, $graveyard_common_scope), constraints:[CommonProperty(Owners)]})) */
graveyard_common_typed_one ::= graveyard_singular_count "target" card_filter "card" graveyard_common_scope

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_plural_count, filter:@and($card_filter, $graveyard_common_scope), constraints:[CommonProperty(Owners)]})) */
graveyard_common_typed_many ::= graveyard_plural_count "target" card_filter "cards" graveyard_common_scope

graveyard_scope ::= graveyard_scope_yours | graveyard_scope_all | graveyard_scope_any | graveyard_scope_opponents | graveyard_scope_target
/* @sem ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}) */
graveyard_scope_yours ::= ("from" | "in") "your" "graveyard"
/* @sem ObjectFilter::Any */
graveyard_scope_all ::= ("from" | "in") "graveyards"
/* Any one graveyard is still every graveyard's cards. */
/* @sem ObjectFilter::Any */
graveyard_scope_any ::= ("from" | "in") "a" "graveyard"
/* @sem ObjectFilter::InZone(Players{zone:Graveyard, players:OpponentsOf(AbilityController)}) */
graveyard_scope_opponents ::= ("from" | "in") "your" "opponents'" "graveyards"

/* The zone owner is its own announced player, independently of the card
   targets whose eligibility uses that player's graveyard. */
/* @sem ObjectFilter::InZone(Players{zone:Graveyard, players:One($target_possessive)}) */
graveyard_scope_target ::= ("from" | "in") target_possessive "graveyard"


/* One opponent's graveyard is a common owner, not an independent opponent
   choice for each targeted card. A single graveyard has the same constraint. */
graveyard_common_scope ::= graveyard_one_opponent | graveyard_one_any
/* @sem ObjectFilter::InZone(Players{zone:Graveyard, players:OpponentsOf(AbilityController)}) */
graveyard_one_opponent ::= ("from" | "in") ("an" | "one") "opponent's" "graveyard"
/* @sem ObjectFilter::Any */
graveyard_one_any ::= ("from" | "in") ("a" | "one") "single" "graveyard"

/* Library positions retain their native Expr operand in both directions. */
/* @sem Operation::Move{objects:$library_depth_objects, destination:Library{position:FromTop($library_depth), order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
put_owners_library_depth ::= "put" library_depth_objects "into" library_depth_owner "library" library_depth "from" "the" "top"

library_depth_objects ::= affected | library_depth_her
/* @sem ObjectSet::One(@it) */
library_depth_her ::= "her" | "him"

/* @sem () */
library_depth_owner ::= ("its" | "her" | "his" | "their") "owner's" | "their" "owners'"

library_depth ::= ordinal | library_depth_fourth | library_depth_fifth | library_depth_seventh
/* @sem Expr::Constant(4) */
library_depth_fourth ::= "fourth"
/* @sem Expr::Constant(5) */
library_depth_fifth ::= "fifth"

/* Looking and putting back retain exactly the observed cards in that library.
   The chosen ordering belongs to the ability controller, not the library owner. */
/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One($reorder_library_owner)}, kind:Card, filter:Any}, count:$top_count, from:Top}}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:$reorder_library_owner, objects:InZone{objects:Observed(@marked), zone:Library}, end:Top, order:Chosen}}] */
clause_library_reorder ::= "look" "at" "the" "top" top_count "of" reorder_library_owner "library" "," "then" "put" "them" "back" "in" "any" "order"

reorder_library_owner ::= zone_your | target_possessive

/* A printed total constrains the announced target group. It is not a
   per-card property filter or a resolution-time selection. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_singular_count, filter:@and($card_filter, $budget_graveyard_scope), constraints:[$graveyard_total_constraint]})) */
graveyard_budget_one ::= graveyard_singular_count "target" card_filter "card" graveyard_total_constraint budget_graveyard_scope
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_plural_count, filter:@and($card_filter, $budget_graveyard_scope), constraints:[$graveyard_total_constraint]})) */
graveyard_budget_many ::= graveyard_plural_count "target" card_filter "cards" graveyard_total_constraint budget_graveyard_scope

/* @sem SelectionConstraint::TotalProperty{property:$stat, comparison:$bound, amount:$value} */
graveyard_total_constraint ::= "with" "total" stat value "or" bound

budget_graveyard_scope ::= graveyard_scope | budget_graveyard_that_player
/* @sem ObjectFilter::InZone(Players{zone:Graveyard, players:One(@that_player)}) */
budget_graveyard_that_player ::= ("from" | "in") "that" "player's" "graveyard"

/* "Exile cards from the top of your library until you exile a nonland card": the reveal
   stops on one card and the next instruction exiles every card it showed. The card it stopped on is the
   receipt the next instruction names. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:Operation::@exiled_card_result(Operation::Move{objects:Observed(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]})}] */
clause_exile_until_card ::= "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" ("a" | "an") card_filter "card"

/* The card it stopped on may be cast: from exile with a permission, or right away for free. */
/* @sem Instruction::[...$clause_exile_until_card, Effect{result:@next, operation:$cast_exiled_that_card_permission}] */
instructions_exile_until_permission ::= clause_exile_until_card "." cast_exiled_that_card_permission
/* @sem Instruction::[...$clause_exile_until_card, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$cast_exiled_card_free}]}}] */
instructions_exile_until_free_cast ::= clause_exile_until_card "." "you" "may" cast_exiled_card_free

/* A receipt names the actual moved incarnation, never the pre-exile input. */
/* @sem ObjectRef::@exiled_card_reference */
exiled_card_ref ::= "it" | "that" "card"
/* After an exile-until, Oracle names the card it stopped on "that card", 10 times in 11. */
/* @sem ObjectRef::@exiled_card_reference */
exiled_that_card ::= "that" "card"

/* One player's top card establishes one actual resulting incarnation. */
exile_top_card_receipt ::= exile_top_card_player | exile_top_card_named | exile_top_card_you
/* @sem Operation::@exiled_card_result(Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}) */
exile_top_card_player ::= player_ref "exiles" "the" "top" "card" "of" "their" "library"
/* "Exile the top card of that player's library": the card the event or target's player
   loses is what a later `it` or `that card` names. */
/* @sem Operation::@exiled_card_result(Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($zone_that_player)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}) */
exile_top_card_named ::= "exile" "the" "top" "card" "of" zone_that_player "library"

/* "Target opponent exiles the top three cards of their library": the acting player's own
   library. */
/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:$top_many, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
player_exiles_top_cards ::= player_ref "exiles" "the" "top" top_many "of" "their" "library"

/* A pronoun after one revealed card ("if it's a nonland card") names that card, which
   the binder does not yet follow from a revealing player; one card keeps its own rules. */
/* @sem Operation::Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:$top_many, from:Top}} */
player_reveals_top ::= player_ref "reveals" "the" "top" top_many "of" "their" "library"

/* "Each player reveals the top card of their library" shows one card from each library
   at once; "each opponent exiles the top card of their library" is one exile for each
   player, from that player's library. */
/* @sem Operation::Reveal{objects:LibraryTops($optional_player_population)} */
players_reveal_tops ::= optional_player_population "reveals" "the" "top" "card" "of" "their" "library"

/* @sem Instruction::[ForEachPlayer{players:$optional_player_population, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}, count:$top_count, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
clause_each_exiles_top ::= optional_player_population "exiles" "the" "top" top_count "of" "their" "library"

/* "Target opponent exiles a card from their hand": that player chooses the
   card, then exiles it. The exiled card is what "it" and "that card" name next. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$player_ref, objects:Zone{scope:Players{zone:Hand, players:One($player_ref)}, kind:Card, filter:Any}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Operation::@exiled_card_result(Operation::Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]})}] */
clause_player_exiles_hand ::= player_ref "exiles" "a" "card" "from" "their" "hand"

/* Each player chooses from their own hand. */
/* @sem Instruction::[ForEachPlayer{players:$optional_player_population, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}, count:AsManyAsCan($card_count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
clause_each_exiles_hand ::= optional_player_population "exiles" card_count "from" "their" "hand"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$player_ref, objects:Zone{scope:Players{zone:Graveyard, players:One($player_ref)}, kind:Card, filter:Any}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Operation::@exiled_card_result(Operation::Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]})}] */
clause_player_exiles_graveyard ::= player_ref "exiles" "a" "card" "from" "their" "graveyard"

/* @sem Instruction::[ForEachPlayer{players:$optional_player_population, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any}, count:AsManyAsCan($card_count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
clause_each_exiles_graveyard ::= optional_player_population "exiles" card_count "from" "their" "graveyard"

/* After a player exiles their top card, "it's a <type> card" counts the exiled
   card with that type, as in Audacious Swap, Dimensional Infiltrator and Mind's
   Dilation. */
instructions_exiled_top_type ::= instructions_exiled_top_type_only | instructions_exiled_top_type_otherwise | instructions_exiled_top_object_otherwise

/* @sem Vec<Instruction>::[Effect{result:@mark, operation:$exile_top_card_receipt}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$clause}, otherwise:Program{}}] */
instructions_exiled_top_type_only ::= exile_top_card_receipt "." "if" "it's" ("a" | "an") card_filter "card" "," clause

/* @sem Vec<Instruction>::[Effect{result:@mark, operation:$exile_top_card_receipt}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$clause}, otherwise:Program{instructions:$clause_2}}] */
instructions_exiled_top_type_otherwise ::= exile_top_card_receipt "." "if" "it's" ("a" | "an") card_filter "card" "," clause "." "otherwise" "," clause

/* Player and card references have independent typed scopes. */
/* @sem Operation::Move{objects:InZone{objects:One($exiled_card_ref), zone:Exile}, destination:Battlefield{controller:Player(@that_player), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
exiled_card_put ::= "the" "player" "puts" exiled_card_ref "onto" "the" "battlefield"

/* @sem Operation::PlayCards{actor:One(@that_player), action:CastSpell, cards:One($exiled_card_ref), count:Exactly(Constant(1)), cost:Free} */
exiled_card_cast ::= "the" "player" "casts" exiled_card_ref "without" "paying" "its" "mana" "cost" "if" "able"

/* One owning reveal/selection/remainder span. The Card filters independently
   govern stopping and selection. The written X has one use at the reveal; its
   definition supplies that count directly. Only the final remainder is
   re-queried in Library after the Move. */
/* @sem Instruction::[Group($reveal_until_selection_program)] */
instructions_reveal_until_select_cards ::= reveal_until_selection_program

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$card_filter, count:$value}}, Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Matching{objects:Observed(@marked), filter:$card_filter_2}, count:AnyNumber, constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:Random}}]} */
reveal_until_selection_program ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "X" card_filter "cards" "," "where" "X" "is" value "." "put" "any" "number" "of" "those" card_filter "cards" "onto" "the" "battlefield" "," "then" "put" "the" "rest" "of" "the" "revealed" "cards" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* The opponent is chosen before either card. Each player chooses from the
   other's graveyard; the optional single move reads both actual selections. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Player, terms:_{count:Exactly(Constant(1)), options:[Players(OpponentsOf(AbilityController))]}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(Chosen)}, kind:Card, filter:$card_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:ChooseObjects{player:Chosen, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$card_filter_2}, count:AsManyAsCan(Constant(1))}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Union([Selected(@back(3)), Selected(@prior)]), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}] */
instructions_reciprocal_graveyard_choices ::= "choose" ("a" | "an") card_filter "card" "in" ("an" | "one") "opponent's" "graveyard" "," "then" "that" "player" "chooses" ("a" | "an") card_filter "card" "in" "your" "graveyard" "." "you" "may" "return" "those" "cards" "to" "the" "battlefield" "under" "their" ("owner's" | "owners'") "control"

/* @sem $modifiers */
a_card_any_with ::= "a" "card" modifiers

/* A seek is a random qualifying library selection followed by its move.
   Both instructions use fresh result addresses, including after a prefix. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$a_card}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:@seek_move_result(Operation::Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]})}] */
clause_seek_card ::= "you"? "seek" a_card

/* Seeking several qualifying cards makes one random selection of that size. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:$seek_plural_count, constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_seek_cards ::= "you"? "seek" seek_plural_count card_filter "cards"
/* @sem Count::AsManyAsCan(@plural_amount($number)) */
seek_plural_count ::= number

/* The named ability's exclamation mark also closes this seek sentence. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:HasKeywordFamily(StartYourEngines)}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:@seek_move_result(Operation::Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]})}]} */
program_sentence_seek_engines ::= "you"? "seek" "a" "card" "with" "start" "your" "engines" "!"

/* The paired clause establishes the later card pronoun through the seek's
   moved-card marker. Child clauses retain their own lexical result positions. */
/* @sem Instruction::[...$clause_seek_card, ...$seek_delayed_discard] */
clause_seek_delayed_discard ::= clause_seek_card "." seek_delayed_discard
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:DiscardObjects{objects:One($current_card_ref)}}]}}}] */
seek_delayed_discard ::= "discard" current_card_ref "at" "the" "beginning" "of" "the" "next" "end" "step"

/* The reveal choice gates both moving the top card and its later life loss.
   The amount reads the card's pre-move information, not the new top card. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Reveal{objects:$your_top}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@mark, operation:Move{objects:$your_top, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:$top_card_life_loss_amount}}]}, otherwise:Program{}}] */
clause_optional_top_card_life ::= "you" "may" "reveal" your_top "and" "put" "it" "into" "your" "hand" "." "if" "you" "do" "," "you" "lose" top_card_life_loss_amount

/* "An opponent separates those cards into two piles. Put one pile into your hand and the
   other into your graveyard.": the piles split the cards the previous instruction
   revealed; you choose the pile for your hand, and the rest of those cards move on. */
/* @sem Instruction::[Effect{result:@next, operation:SeparatePiles{separator:OneOf(OpponentsOf(AbilityController)), chooser:AbilityController, objects:InZone{objects:Observed(@prior), zone:Library}}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_opponent_piles_graveyard ::= "an" "opponent" "separates" "those" "cards" "into" "two" "piles" "." "put" "one" "pile" "into" "your" "hand" "and" "the" "other" "into" "your" "graveyard"
/* @sem Instruction::[Effect{result:@next, operation:SeparatePiles{separator:OneOf(OpponentsOf(AbilityController)), chooser:AbilityController, objects:InZone{objects:Observed(@prior), zone:Library}}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Chosen}}] */
clause_opponent_piles_bottom ::= "an" "opponent" "separates" "those" "cards" "into" "two" "piles" "." "put" "one" "pile" "into" "your" "hand" "and" "the" "other" "on" "the" "bottom" "of" "your" "library"

/* Copying a revealed card does not move it. The final reorder retains the
   owning reveal receipt across that intervening continuous effect. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:$player_ref, filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[CopyOf{object:Query{objects:Matching{objects:Observed(@marked), filter:$card_filter}, index:0}, exceptions:[]}], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:ReorderLibrary{chooser:$player_ref_2, library_owner:$player_ref_2, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:$library_order}}] */
instructions_reveal_copy_reorder ::= player_ref "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" ("a" | "an") card_filter "card" "." affected "becomes" "a" "copy" "of" "that" "card" duration "." ("then")? player_ref "puts" "all" "cards" "revealed" "this" "way" "on" "the" "bottom" "of" "their" "library" library_order
/* "Target player reveals cards from the top of their library until they reveal a land
   card, then puts those cards into their graveyard": every revealed card still in that
   library is milled, the land card included. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:$player_ref, filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_player_reveal_until_mill ::= player_ref "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" ("a" | "an") card_filter "card" "," "then" "puts" "those" "cards" "into" "their" "graveyard"
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:$player_ref, filter:$card_filter, count:$number}}, Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_player_reveal_until_many_mill ::= player_ref "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" number card_filter "cards" "," "then" "puts" "those" "cards" "into" "their" "graveyard"

/* Choosing none is the optional action. Only actual departures are excluded
   from the observed cards still in the library. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$revealed_plural_filter}, count:AnyNumber, constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_reveal_any_battlefield_remainder ::= reveal_top "." "you" "may" "put" "any" "number" "of" revealed_plural_filter "from" "among" "them" "onto" "the" "battlefield" "." "then" "put" "all" "cards" "revealed" "this" "way" "that" "weren't" "put" "onto" "the" "battlefield" "into" "your" "graveyard"

/* The one chosen card's actual battlefield incarnation receives the grant.
   Its nested holder scope remains separate from the revealing source. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$card_filter}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:$revealed_entry_grants, duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(3), phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
instructions_reveal_grant_remainder ::= reveal_top "." "you" "may" "put" ("a" | "an") card_filter "card" "from" "among" "them" "onto" "the" "battlefield" "." "it" "gains" revealed_entry_grants "then" "put" "the" "rest" "of" "the" "cards" "revealed" "this" "way" "on" "the" "bottom" "of" "your" "library" library_order
top_card_life_loss_amount ::= moved_card_mana_life | life_number
/* @sem Expr::ObjectProperty{object:Query{objects:Transition{result:@marked, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown} */
moved_card_mana_life ::= "life" "equal" "to" "its" "mana" "value"

/* The noun precedes `cards`; subsequent modifiers still restrict that noun. */
revealed_plural_filter ::= revealed_plural_plain | revealed_plural_modified
/* @sem $card_filter */
revealed_plural_plain ::= card_filter "cards"
/* @sem @and($card_filter, $modifiers) */
revealed_plural_modified ::= card_filter "cards" modifiers

revealed_entry_grants ::= closed_grants | revealed_terminated_grants
/* @sem $grants */
revealed_terminated_grants ::= grants "."

/* The declared two-part activation cost places its one self-discard at [1].
   Follow the performed post-cost incarnation and preserve the expected zone.
   An absent card still causes one library shuffle; drawing is unconditional. */
/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Ordinary, cost:Cost{parts:[Mana($mana_symbols), Discard{count:Constant(1), filter:SameObject(Source), random:false}]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[...$clause, If{condition:ObjectMatches{object:Query{objects:CostObjects{payment:Activation, component:[1], view:Performed, phase:After}, index:0}, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Query{objects:CostObjects{payment:Activation, component:[1], view:Performed, phase:After}, index:0}), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}]}})} */
activated_discard_self_shuffle ::= mana_symbols "," ("↑")? "discard" "this" "card" ":" clause "." "shuffle" "this" "card" "into" "your" "library" "from" "your" "graveyard" "," "then" "draw" card_count "."

/* Exiling cards from the top of your library. */
/* @sem Operation::Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$card_count, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_top_cards_of_your_library ::= "exile" "the" "top" card_count "of" "your" "library"

/* A following shuffle. */
/* @sem Operation::Shuffle{players:$players_singular} */
then_players_shuffle ::= "then" players_singular "shuffles"

/* The where clause owns the observed program, including later X selections.
   Bind a repeated value before looking, while preserving the look mark and
   every selection and move receipt. */
/* @sem @where(Program::Program{instructions:[Effect{result:@mark, operation:$look_top}, ...$look_where_follow]}, $value) */
program_look_where ::= ("you")? look_top "," "where" "X" "is" value "." look_where_follow

look_where_follow ::= look_put_split | dig_follow | look_cast_split | look_top_split | look_top_condition_split | look_exile_cast_split

/* Declining to look also declines the following top/bottom selection. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:@where(Program::Program{instructions:[Effect{result:@mark, operation:$look_top}, ...$look_top_split]}, $value)}]} */
program_optional_look_where ::= "you" "may" look_top "," "where" "X" "is" value "." "if" "you" "do" "," look_top_split

/* @sem @where(Program::Program{instructions:[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:$look_restore}]}, $value) */
program_look_where_restore ::= look_top "," "where" "X" "is" value "," "then" look_restore

/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Top, order:Chosen} */
look_restore ::= "put" "them" "back" "in" "any" "order"

/* A standalone look definition cannot leave later X amounts unresolved. Whole
   look/selection programs above own those uses together. */
/* @sem Operation::@look_inline(Operation::LookAt{player:AbilityController, objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$value, from:Top}}) */
look_at_top_x_cards ::= "look" "at" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" value

/* Shuffling your library. */
/* @sem Operation::Shuffle{players:One(AbilityController)} */
shuffle_your_library ::= "shuffle" "your" "library"

/* Searching your library for any cards. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:Any, count:AsManyAsCan($card_count)}]} */
search_library_for_cards ::= "search" "your" "library" "for" card_count

/* "Exile the top two cards of your library. Choose one of them.": one of the cards
   just exiled is chosen, and the permission names that card. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$ordered_cards, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Transition{result:@prior, phase:After}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:$play_that_card_permission}] */
clause_exile_choose_one_play ::= "exile" ordered_cards "." "choose" "one" "of" "them" "." play_that_card_permission

/* Permission to play the prior card. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:$duration, evaluation:LiveObjects} */
play_that_card_permission ::= duration "," "you" "may" "play" "that" "card"
    | "you" "may" "play" ("it" | "that" "card") ("from" "exile")? duration
/* Permission to cast the prior card. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:CastSpell, filter:Any})], duration:$duration, evaluation:LiveObjects} */
cast_that_card_permission ::= duration "," "you" "may" "cast" "that" "card"
    | "you" "may" "cast" "that" "card" duration
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:CastSpell, filter:Any}, terms:_{cost:Normal, spend_as:$exiled_spending}})], duration:$duration, evaluation:LiveObjects} */
cast_that_card_permission_spending ::= duration "," "you" "may" "cast" "that" "card" "and" exiled_spending

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One($exiled_card_ref), from:Exile, action:CastSpell, filter:Any})], duration:$this_duration, evaluation:LiveObjects} */
cast_exiled_card_permission ::= "you" "may" "cast" exiled_card_ref this_duration
/* "You may cast that card for as long as it remains exiled": the permission lasts while
   the card it names stays in exile; "it" is that card. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One($exiled_card_ref), from:Exile, action:$exiled_play_action, filter:Any})], duration:WhileExiled($exiled_card_ref), evaluation:LiveObjects} */
exiled_card_while_exiled ::= "you" "may" exiled_play_action exiled_card_ref "for" "as" "long" "as" "it" "remains" "exiled"
/* "..., and mana of any type can be spent to cast that spell": the same permission under
   spending terms. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One($exiled_card_ref), from:Exile, action:$exiled_play_action, filter:Any}, terms:_{cost:Normal, spend_as:$exiled_spending}})], duration:WhileExiled($exiled_card_ref), evaluation:LiveObjects} */
exiled_card_while_exiled_spending ::= "you" "may" exiled_play_action exiled_card_ref "for" "as" "long" "as" "it" "remains" "exiled" "," "and" exiled_spending
/* "Exile target nonland permanent. You may cast that card for as long as it remains
   exiled": that card is the one the exile just moved, whatever named it. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_objects}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:$exiled_play_action, filter:Any})], duration:WhileExiled(Result{result:@prior, phase:After, index:0}), evaluation:LiveObjects}}] */
clause_exile_while_exiled ::= exile_objects "." "you" "may" exiled_play_action "that" "card" "for" "as" "long" "as" "it" "remains" "exiled"
/* @sem Instruction::[Effect{result:@next, operation:$exile_objects}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:$exiled_play_action, filter:Any}, terms:_{cost:Normal, spend_as:$exiled_spending}})], duration:WhileExiled(Result{result:@prior, phase:After, index:0}), evaluation:LiveObjects}}] */
clause_exile_while_exiled_spending ::= exile_objects "." "you" "may" exiled_play_action "that" "card" "for" "as" "long" "as" "it" "remains" "exiled" "," "and" exiled_spending
exiled_play_action ::= exiled_cast_action | exiled_play_either
/* @sem CardPlayAction::CastSpell */
exiled_cast_action ::= "cast"
/* @sem CardPlayAction::Either */
exiled_play_either ::= "play"
exiled_spending ::= exiled_spending_any_type | exiled_spending_any_color | exiled_spending_colorless
/* @sem SpendAs::AnyType */
exiled_spending_any_type ::= "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" exiled_spell_ref
/* @sem SpendAs::AnyColor */
exiled_spending_any_color ::= "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" exiled_spell_ref
/* @sem SpendAs::ColorlessAsAnyColor */
exiled_spending_colorless ::= "you" "may" "spend" "colorless" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" exiled_spell_ref
/* @sem () */
exiled_spell_ref ::= "that" "spell" | "it"

/* "You may cast target creature card from your graveyard this turn": one target card,
   cast from the graveyard it is in. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One($target_card_your_graveyard), from:Graveyard, action:CastSpell, filter:Any})], duration:$this_duration, evaluation:LiveObjects} */
cast_target_graveyard_permission ::= "you" "may" "cast" target_card_your_graveyard this_duration

/* Permission to play the prior cards. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:Either, filter:Any})], duration:$duration, evaluation:LiveObjects} */
play_those_cards_permission ::= duration "," "you" "may" "play" "those" "cards"
    | "you" "may" "play" ("them" | "those" "cards") duration

/* All players finish shuffling before the draw phase. Each draw reads only
   that player's actual original cards in the aggregate shuffle receipt. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@mark, operation:Move{objects:Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}}, ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(Bound(0)), amount:CountObjects(MovedBy{result:@marked, phase:Before, player:Bound(0)})}}]}}] */
clause_shuffle_hands_draw ::= players_singular "shuffles" "the" "cards" "from" "their" "hand" "into" "their" "library" "," "then" "draws" "that" "many" "cards"

/* Oracle may omit the already established group after the number. */
look_hand_count ::= look_count | look_hand_count_of
/* @sem $look_count */
look_hand_count_of ::= look_count "of" ("them" | "those" "cards")

/* An unqualified search for two cards requires both when available. */
/* @sem SearchChoice::SearchChoice{filter:Any, count:AsManyAsCan(Constant(2))} */
search_two_any ::= "two" "cards"
/* Search selections retain original library identities after the hand move. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_two}, ...$search_hand_other, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_search_hand_other ::= search_two "." search_hand_other "." "then" "shuffle"
/* @sem Instruction::[Effect{result:@mark, operation:$search_two}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, ...$search_hand_other, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_search_reveal_hand_other ::= search_two "and" "reveal" "them" "." search_hand_other "." "then" "shuffle"
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Selected(@marked), count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
search_hand_other ::= "put" "one" "into" "your" "hand" "and" "the" "other" "into" "your" "graveyard"

/* Only a pair supplies the written singular other card. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_two_choice]} */
search_two ::= "search" "your" "library" "for" search_two_choice
search_two_choice ::= search_two_any | search_two_filtered
/* @sem SearchChoice::SearchChoice{filter:$search_filter_many, count:UpTo(Constant(2))} */
search_two_filtered ::= "up" "to" "two" search_filter_many

/* With no intervening action, the same single library top is inspected and
   optionally moved. Its owner remains the independently announced player. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:$looked_library_top}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:$looked_library_top, destination:$looked_top_destination, qualifiers:[]}}]}}] */
instructions_look_one_optional_move ::= "look" "at" looked_library_top "." "you" "may" "put" "that" "card" looked_top_destination
/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One($looked_library_owner)}, kind:Card, filter:Any}, count:Constant(1), from:Top} */
looked_library_top ::= "the" "top" "card" "of" looked_library_owner "library"
looked_library_owner ::= target_possessive | possessive_defending
looked_top_destination ::= looked_top_graveyard | looked_top_bottom
/* @sem MovementDestination::OwnersGraveyard(CardArrival{counters:[], states:[]}) */
looked_top_graveyard ::= "into" looked_top_owner "graveyard"
/* @sem MovementDestination::Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
looked_top_bottom ::= "on" "the" "bottom" "of" looked_top_owner "library"
/* @sem () */
looked_top_owner ::= "their" | "that" "player's"

/* A shared final card noun qualifies every subtype in this disjunction. The
   unordered filter remains printable after native canonicalization. */
/* @sem $search_subtype_list */
search_filter_subtype_list ::= search_subtype_list "card"
search_subtype_list ::= search_subtype_more | search_subtype_last
/* @sem ObjectFilter::@or($subtype, $search_subtype_list) */
search_subtype_more ::= subtype "," search_subtype_list
/* @sem ObjectFilter::@or($subtype, $subtype_2) */
search_subtype_last ::= subtype ","? "or" subtype

/* The complete search episode is a program: its final shuffle sentence cannot
   become part of an unrelated conditional's instruction prefix. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:$search}, Effect{result:@next, operation:$found_action}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]} */
program_sentence_search_and_move ::= search "and" found_action "." "then" "shuffle" "."

/* These branches are immediately inside the explicit one-card reveal above.
   A pure condition does not move the top card; each branch names that reveal's
   actual observation. The live-query branch remains separate for unpaid
   reveal/move payments, which have supplied no observation receipt. */
observed_top_reveal_branch ::= observed_top_reveal_put | observed_top_reveal_may_put | top_reveal_draw | top_reveal_continuous | clause_you | top_reveal_you_and
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Observed(@marked), destination:$top_reveal_destination, qualifiers:[]}}] */
observed_top_reveal_put ::= "put" top_reveal_it top_reveal_destination
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:$observed_top_reveal_put}}] */
observed_top_reveal_may_put ::= "you" "may" observed_top_reveal_put

/* Distinctness constrains the announced group, independently of the count. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_plural_count, filter:$graveyard_scope, constraints:[DifferentProperty(ManaValue)]})) */
graveyard_distinct_values_many ::= graveyard_plural_count "target" "cards" "with" "different" "mana" "values" graveyard_scope

/* One bounded observation and its immediately moved top card. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}, Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
reveal_top_hand_that ::= "reveal" "the" "top" "card" "of" "your" "library" "and" "put" "that" "card" "into" "your" "hand"

/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}, Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
reveal_top_hand_it ::= "reveal" "the" "top" "card" "of" "your" "library" "and" "put" "it" "into" "your" "hand"

/* @sem Instruction::[...$reveal_top_hand_that, ...$observed_mana_gain] */
reveal_top_hand_value_gain ::= reveal_top_hand_that "." observed_mana_gain

/* @sem Instruction::[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:ObjectProperty{object:Query{objects:Observed(0), index:0}, property:ManaValue, information:CurrentOrLastKnown}}}] */
observed_mana_gain ::= "you" "gain" "life" "equal" "to" "its" "mana" "value"

/* @sem Instruction::[...$reveal_top_hand_it, ...$observed_mana_saddled] */
reveal_top_hand_value_saddled ::= reveal_top_hand_it "." observed_mana_saddled

/* @sem Instruction::[If{condition:ObjectMatches{object:$object_ref, filter:Not(State(Saddled))}, then:_{instructions:[Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:ObjectProperty{object:Query{objects:Observed(0), index:0}, property:ManaValue, information:CurrentOrLastKnown}}}]}, otherwise:_{instructions:[Effect{result:@next, operation:LoseLife{players:$players_singular, amount:ObjectProperty{object:Query{objects:Observed(0), index:0}, property:ManaValue, information:CurrentOrLastKnown}}}]}}] */
observed_mana_saddled ::= "you" "lose" "life" "equal" "to" "that" "card's" "mana" "value" "if" object_ref "isn't" "saddled" "." "otherwise" "," players_singular "loses" "that" "much" "life"

/* The owner chooses a library position; the ordinal remains an editable operand. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseAction{actor:One(OwnerOf($library_choice_owner_object)), options:[Program{instructions:[Effect{result:@next, operation:Move{objects:$affected, destination:Library{position:FromTop($library_depth), order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}, Program{instructions:[Effect{result:@next, operation:Move{objects:$affected, destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}]}}] */
clause_owner_library_depth_choice ::= library_choice_owner_object "puts" affected "into" "their" "library" library_depth "from" "the" "top" "or" "on" "the" "bottom"

/* The subject owns the hand and the library; the verb supplies the destination. */
/* @sem Operation::Move{objects:Zone{scope:Players{zone:Hand, players:$players_singular}, kind:Card, filter:Any}, destination:Library{position:$hand_library_placement, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
player_hand_to_library ::= players_singular hand_library_placement

/* @sem Operation::Move{objects:Zone{scope:Players{zone:Hand, players:@subject}, kind:Card, filter:Any}, destination:Library{position:$hand_library_placement, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
hand_to_library_third ::= hand_library_placement
/* @sem LibraryPosition::Bottom */
hand_library_bottom ::= "puts" "the" "cards" "in" "their" "hand" "on" "the" "bottom" "of" "their" "library" "in" "any" "order"
/* @sem LibraryPosition::Shuffled */
hand_library_shuffled ::= "shuffles" "their" "hand" "into" "their" "library"
hand_library_placement ::= hand_library_bottom | hand_library_shuffled

/* The count is the before receipt of this very hand-to-library move. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Zone{scope:Players{zone:Hand, players:One($player_ref)}, kind:Card, filter:Any}, destination:Library{position:$hand_library_placement, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Draw{players:One($player_ref), amount:CountObjects(Transition{result:@marked, phase:Before})}}] */
clause_hand_to_library_draw_receipt ::= player_ref hand_library_placement "," "then" "draws" "that" "many" "cards"

/* A single explicit library top is shared by the reveal and its immediate
   play continuation; both sides print from this same current operand. */
/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One($player_possessive)}, kind:Card, filter:Any}, count:Constant(1), from:Top} */
single_library_top ::= "the" "top" "card" "of" player_possessive "library"

/* @sem PlayAction::Either */
revealed_it_free_action ::= "play" "it" "without" "paying" "its" "mana" "cost"

/* @sem PlayAction::CastSpell */
revealed_it_free_cast ::= "cast" "it" "without" "paying" "its" "mana" "cost"

revealed_it_free ::= revealed_it_free_action | revealed_it_free_cast

/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:$single_library_top}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:$revealed_it_free, cards:$single_library_top, count:Exactly(Constant(1)), terms:_{cost:Free}}}]}}] */
instructions_reveal_single_free ::= "reveal" single_library_top "." "you" "may" revealed_it_free

/* @sem ObjectFilter::Shares{property:ManaValues, with:EventSubject} */
same_event_spell_mana_value ::= "if" "the" "two" "spells" "have" "the" "same" "mana" "value"

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Reveal{objects:$single_library_top}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:$single_library_top, filter:$same_event_spell_mana_value}, count:Exactly(Constant(1)), terms:_{cost:Free}}}]}}]}, otherwise:Program{}}] */
instructions_optional_reveal_same_value_cast ::= "you" "may" "reveal" single_library_top "." "if" "you" "do" "," "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" same_event_spell_mana_value

/* Search compares against the last-known mana value of the event subject. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}}]), count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]} */
death_lesser_search_program ::= "search" "your" "library" "for" "a" card_filter "card" "with" "lesser" "mana" "value" "," "put" "it" "onto" "the" "battlefield" "tapped" "," "then" "shuffle"

/* The look supplies the exact library observation for both the separation and
   the cards left after the chosen pile moves to its owners' hands. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$face_pile_separation, ...$face_pile_choice, Effect{result:@next, operation:$face_pile_remainder}] */
instructions_look_face_piles ::= look_top "and" face_pile_separation "." face_pile_choice "." face_pile_remainder

/* @sem Instruction::[Effect{result:@next, operation:Piles{actor:One(AbilityController), objects:InZone{objects:Observed(@marked), zone:Library}, count:Constant(2), names:['face up', 'face down']}}] */
face_pile_separation ::= "separate" "them" "into" "a" "face-down" "pile" "and" "a" "face-up" "pile"

/* @sem Instruction::[Effect{result:@next, operation:ChoosePile{actor:OpponentsOf(AbilityController), then:OwnersHand}}] */
face_pile_choice ::= "an" "opponent" "chooses" "one" "of" "those" "piles"

face_pile_remainder ::= face_pile_remainder_bottom | face_pile_remainder_graveyard

/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:Chosen} */
face_pile_remainder_bottom ::= "put" "the" "cards" "in" "that" "pile" "into" "your" "hand" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "any" "order"

/* @sem Operation::Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]} */
face_pile_remainder_graveyard ::= "put" "that" "pile" "into" "your" "hand" "and" "the" "other" "into" "your" "graveyard"

/* Hand cast offers share the hand population while keeping their count and
   eligibility operands independent of the surrounding instruction. */
/* @sem ObjectFilter::SharesNameWithAny(FromHistory{event:Spell{event:Cast, players:All, spells:Any}, window:ThisTurn}) */
hand_spell_history_name ::= "if" "it" "has" "the" "same" "name" "as" "a" "spell" "that" "was" "cast" "this" "turn"

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:@and($hand_spell_choice, $hand_spell_history_name)}, count:Exactly(Constant(1)), cost:Free} */
cast_free_hand_qualified ::= "cast" hand_spell_choice "from" "your" "hand" "without" "paying" "its" "mana" "cost" hand_spell_history_name

/* @sem Count::UpTo($value) */
hand_cast_plural_count_up_to ::= "up" "to" value

/* @sem Count::AnyNumber */
hand_cast_plural_count_any ::= "any" "number" "of"

hand_cast_plural_count ::= hand_cast_plural_count_up_to | hand_cast_plural_count_any

/* @sem ObjectFilter::Any */
hand_cast_plural_any ::= "spells"

/* @sem $spell_adjectives */
hand_cast_plural_filtered ::= spell_adjectives "spells"

hand_cast_plural_filter ::= hand_cast_plural_any | hand_cast_plural_filtered

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$hand_cast_plural_filter}, count:$hand_cast_plural_count, cost:Free} */
cast_free_hand_plural ::= "you" "may" "cast" hand_cast_plural_count hand_cast_plural_filter "from" "your" "hand" "without" "paying" "their" "mana" "costs"

top_card_reveal_head ::= top_card_reveal_chosen_type | top_card_reveal_typed | top_card_reveal_chosen | top_card_reveal_shared | top_card_reveal_snow | top_card_reveal_legendary

/* @sem ObjectFilter::$card_filter */
top_card_reveal_typed ::= "if" "it's" ("a" | "an") card_filter "card" "," "you" "may" "reveal" "it"

/* @sem ObjectFilter::AllOf([$filter_phrase, Chosen(CreatureType)]) */
top_card_reveal_chosen ::= "if" "it's" ("a" | "an") filter_phrase "card" "of" "the" "chosen" "type" "," "you" "may" "reveal" "it"

/* @sem ObjectFilter::Shares{property:CardTypes, with:$object_ref} */
top_card_reveal_shared ::= "if" "it" "shares" "a" "card" "type" "with" object_ref "," "you" "may" "reveal" "that" "card"

/* @sem ObjectFilter::Supertype(Snow) */
top_card_reveal_snow ::= "if" "that" "card" "is" "snow" "," "you" "may" "reveal" "it"

/* @sem ObjectFilter::Supertype(Legendary) */
top_card_reveal_legendary ::= "if" "that" "card" "is" "legendary" "," "you" "may" "reveal" "it"

/* Scope the observation and both destinations together, so the remainder refers
   to the very same reveal and excludes the immediately preceding hand move. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$chosen_type_reveal_split] */
chosen_type_reveal_partition ::= reveal_top "." chosen_type_reveal_split

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:Chosen(CardType)}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:$rest_graveyard}] */
chosen_type_reveal_split ::= "put" "all" "cards" "of" "the" "chosen" "type" "revealed" "this" "way" "into" "your" "hand" "and" rest_graveyard

/* The stopping condition and the transferred card share the chosen filter. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:ChosenFilter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:ChosenFilter}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:$rest_bottom}] */
chosen_kind_reveal_partition ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "a" "card" "of" "the" "chosen" "kind" "." "put" "that" "card" "into" "your" "hand" "and" rest_bottom

/* The choice and following observation are consecutive sentences in one ability. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$choose_card_types_pair}, ...$chosen_type_reveal_partition] */
chosen_type_choice_partition ::= choose_card_types_pair "." chosen_type_reveal_partition

/* Filtered cards in the controller's library can be used as an effect subject. */
library_perpetual_subject ::= library_filtered_cards | library_topmost_filtered_card

/* @sem ObjectSet::Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$filter_phrase} */
library_filtered_cards ::= filter_phrase "cards" "in" "your" "library"

/* @sem ObjectSet::Take{objects:$library_filtered_card_set, count:Constant(1), from:Top} */
library_topmost_filtered_card ::= "the" "topmost" library_filtered_card_set

/* @sem ObjectSet::Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$filter_phrase} */
library_filtered_card_set ::= filter_phrase "card" "in" "your" "library"

/* Search for a attached_search_subtype with a name distinct from an attached subtype, then attach the selection. */
/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:AllOf([$attached_search_subtype, Not(SharesNameWithAny(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$attached_search_subtype_2, AttachedToPlayer(EnchantedBy(Source))])}))]), count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedToPlayer(EnchantedBy(Source))]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}}] */
instructions_may_search_attached_distinct ::= "you" "may" "search" "your" "library" "for" "a" attached_search_subtype "card" "that" "doesn't" "have" "the" "same" "name" "as" "a" attached_search_subtype "attached" "to" "enchanted" "player" "," "put" "it" "onto" "the" "battlefield" "attached" "to" "that" "player" "," "then" "shuffle"

attached_search_subtype ::= st_curse | st_cartouche | st_role

/* The count is scoped by its enclosing adjacent destruction instruction. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:$filter_phrase, count:UpTo(CountObjects(Matching{objects:Transition{result:@prior, phase:Before}, filter:$filter_plural}))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
search_destroyed_count_tapped ::= "search" "your" "library" "for" "up" "to" "X" filter_phrase "cards" "," "where" "X" "is" "the" "number" "of" filter_plural "destroyed" "this" "way" "," "put" "those" "cards" "onto" "the" "battlefield" "tapped" "," "then" "shuffle"

/* Only a destruction may supply the receipt for the following search. */
/* @sem Instruction::[...$clause_destroy_required_opponent_targets, ...$search_destroyed_count_tapped] */
instructions_destroy_search_count ::= clause_destroy_required_opponent_targets "." search_destroyed_count_tapped

/* Search and move the chosen card, comparing its mana value to the event subject. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}}]), count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
next_cast_search_instructions ::= "search" "your" "library" "for" "a" filter_phrase "card" "with" "lesser" "mana" "value" "," "put" "it" "onto" "the" "battlefield" "," "then" "shuffle"

/* The observation, selected move and remainder form one receipt scope. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$observed_exile_one_other_hand] */
dig_look_exile_other ::= look_top "." observed_exile_one_other_hand

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
observed_exile_one_other_hand ::= "exile" "one" "of" "them" "and" "put" "the" "other" "into" "your" "hand"

/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$opponent_choose_observed_other_silver] */
dig_reveal_opponent_other ::= reveal_top "." opponent_choose_observed_other_silver

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:OneOf(OpponentsOf(AbilityController)), objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[[Named(SilverCounter), Constant(1)]], states:[]}}, qualifiers:[]}}] */
opponent_choose_observed_other_silver ::= "an" "opponent" "chooses" "one" "of" "them" "." "put" "that" "card" "into" "your" "hand" "and" "exile" "the" "other" "with" "a" "silver" "counter" "on" "it"

/* A single hidden top card supplies the same receipt to both permissions. */
/* @sem Operation::Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
hidden_top_card ::= "exile" "the" "top" "card" "of" "your" "library" "face" "down"

/* @sem Instruction::[Effect{result:@mark, operation:$hidden_top_card}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:One(Result{result:@marked, phase:After, index:0}), audience:AffectedPlayer})], duration:WhileExiled(Result{result:@marked, phase:After, index:0}), evaluation:LiveObjects}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:$exiled_play_action, filter:Any}, terms:_{cost:Free}})], duration:WhileOnBattlefield($self_explicit_ref), evaluation:LiveObjects}}] */
clause_hidden_top_access ::= hidden_top_card "." "you" "may" "look" "at" "that" "card" "for" "as" "long" "as" "it" "remains" "exiled" "." "you" "may" exiled_play_action "that" "card" "without" "paying" "its" "mana" "cost" "for" "as" "long" "as" self_explicit_ref "remains" "on" "the" "battlefield"

/* Each offer consumes the enclosing reveal receipt; the later moves partition it. */
/* @sem Instruction::[ForEachObject{objects:InZone{objects:Observed(@marked), zone:Library}, binding:0, body:_{instructions:[Effect{result:@next, operation:PayCost{player:FirstWilling(OpponentsOf(AbilityController)), cost:_{parts:[Life($value)]}, optional:true}}]}}, Effect{result:@next, operation:Move{objects:Unpaid(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
revealed_opponent_offers ::= "for" "each" "of" "those" "cards" "," "put" "that" "card" "into" "your" "hand" "unless" "any" "opponent" "pays" value "life" "." "then" "exile" "the" "rest"

/* The producer is explicitly a reveal from the controller's library. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$revealed_opponent_offers] */
instructions_reveal_opponent_offers ::= reveal_top "." revealed_opponent_offers

/* The same player's top card is observed and remains the object of the free play. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:$revealed_it_free, cards:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, count:Exactly(Constant(1)), terms:_{cost:Free}}}]}}]}, otherwise:Program{}}] */
instructions_player_top_conditional_free ::= player_ref "reveals" "the" "top" "card" "of" "their" "library" "." "if" "it's" top_reveal_quality "," "you" "may" revealed_it_free

/* Reveal and hand movement share one receipt; the callback reads its revealed values. */
/* @sem Instruction::[Effect{result:@next, operation:WithReflexive{action:Reveal{objects:$your_top}, when:Revealed($card_filter), body:Ability(@scope(Ability::Spell{body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any})), amount:Earlier{what:Revealed, measure:Total(ManaValue)}, preventable:true}}]}, announcement:@announcement}))}}, Effect{result:@next, operation:Move{objects:AnyZone(InSet(Recorded(@back(3)))), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_reveal_hand_reflexive_total ::= "reveal" your_top "and" "put" "them" "into" "your" "hand" "." "when" "you" "reveal" "one" "or" "more" card_filter "cards" "this" "way" "," "this" "scheme" "deals" "damage" "equal" "to" "their" "total" "mana" "value" "to" "any" "target"

/* Draw payment and a subsequent, independently authored continuation share
   the actual payment result; the continuation owns its own bindings. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Draw{count:$card_count}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$chosen_drawn_hand_followup}, otherwise:Program{}}] */
optional_draw_chosen_followup ::= "you" "may" "draw" card_count "." "if" "you" "do" "," chosen_drawn_hand_followup

/* The selected hand cards remain a fixed choice, while their history is a
   this-turn draw predicate, independent of the preceding draw payment. */
/* @sem Instruction::[Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:History{event:Drawn(None), window:ThisTurn}}, count:AsManyAsCan($card_count)}}, ForEachObject{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Selected(@marked))}, binding:0, body:Program{instructions:$chosen_card_pay_or_top}}] */
chosen_drawn_hand_followup ::= "choose" card_count "in" "your" "hand" "drawn" "this" "turn" "." "for" "each" "of" "those" "cards" "," chosen_card_pay_or_top

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$cost, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Bound(0)), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{}}] */
chosen_card_pay_or_top ::= cost "or" "put" "the" "card" "on" "top" "of" "your" "library"

/* The two zones belong to the player bound by the enclosing loop. */
/* @sem ObjectSet::Union([Zone(_{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any})]) */
bound_hand_and_graveyard ::= "their" "hand" "and" "graveyard"

/* The choice receipt belongs to the shuffle in the same player's loop. */
/* @sem Instruction::[ForEachPlayer{players:$shuffle_plural_players, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@next, operation:Move{objects:$bound_hand_and_graveyard, destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}]}}, Effect{result:@next, operation:Draw{players:Matching{binding:0, condition:PlayerTook{player:Bound(0), result:@prior}}, amount:$card_count}}] */
clause_optional_shuffle_follow_draw ::= shuffle_plural_players "may" "shuffle" bound_hand_and_graveyard "into" "their" "library" "," "then" "each" "player" "who" "does" "draws" card_count

/* @sem Instruction::[ForEachPlayer{players:$shuffle_plural_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:DrawUpTo{players:One(Bound(0)), amount:$card_count}}]}}] */
clause_each_draw_up_to ::= shuffle_plural_players "draws" "up" "to" card_count

/* @sem Instruction::[Effect{result:@next, operation:$exile_top_cards_of_your_library}] */
clause_you_exile_top_cards ::= "you" exile_top_cards_of_your_library

/* @sem Instruction::[...$clause_shuffle_hands_graveyards, ...$clause_you_exile_top_cards, ...$clause_each_draw_up_to] */
clause_shuffle_exile_then_draw ::= clause_shuffle_hands_graveyards "." clause_you_exile_top_cards "." "then" clause_each_draw_up_to

/* The modifier applies to each target; the scope identifies its graveyard. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_plural_count, filter:@and($modifier_mana_value_numeric, $graveyard_scope)})) */
graveyard_modified_any_many ::= graveyard_plural_count "target" "cards" modifier_mana_value_numeric graveyard_scope

/* Keep the shuffle payment and its conditional body in the same scope: the
   owner is the actor and the payment result controls the subsequent program. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:OwnerOf(Source), cost:Cost{parts:[PlayerAction{player:OwnerOf(Source), body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Source), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}}]}, optional:false}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$owner_named_reveal}, otherwise:Program{}}] */
instructions_owner_shuffle_reveal ::= "this" "creature's" "owner" "shuffles" "it" "into" "their" "library" "." "if" "that" "player" "does" "," owner_named_reveal

/* The two moves consume the reveal receipt and the first move's before
   receipt, respectively; neither may bind to a different producer. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:OwnerOf(Source), filter:Name(@card_name), count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:Name(@card_name)}, destination:Battlefield{controller:Player(OwnerOf(Source)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
owner_named_reveal ::= "they" "reveal" "cards" "from" "the" "top" "of" "that" "library" "until" "a" "card" "named" SELF_NAME "is" "revealed" "." "the" "player" "puts" "that" "card" "onto" "the" "battlefield" "and" "all" "other" "cards" "revealed" "this" "way" "into" "their" "graveyard"

/* A choice and observation share the same targeted library owner. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0}), kind:CardName, terms:_{count:Exactly(Constant(1)), options:[Term{family:CardsInOracle, form:AnyOracleCard}]}}}, Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Target{slot:0, index:0})}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}] */
named_top_choice ::= "target" "player" "chooses" "a" "card" "name" "," "then" "reveals" "the" "top" "card" "of" "their" "library"

/* @sem Instruction::[...$named_top_choice, $named_top_result] */
named_top_choice_branches ::= named_top_choice "." named_top_result

/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:Chosen(CardName)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:_{instructions:[Effect{result:@next, operation:Move{objects:Observed(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:_{instructions:[Effect{result:@next, operation:Move{objects:Observed(@marked), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}} */
named_top_result ::= "if" "that" "card" "has" "the" "chosen" "name" "," "that" "player" "puts" "it" "into" "their" "hand" "." "if" "it" "doesn't" "," "the" "player" "puts" "it" "into" "their" "graveyard"

/* @sem Instruction::[...$named_top_choice, $named_top_damage_result] */
named_top_choice_damage ::= named_top_choice "." named_top_damage_result

/* @sem Instruction::If{condition:Compare{left:CountObjects(Observed(@marked)), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:_{instructions:[If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:Chosen(CardName)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:_{instructions:[Effect{result:@next, operation:Move{objects:Observed(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:_{instructions:[Effect{result:@next, operation:Move{objects:Observed(@marked), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(One(Target{slot:0, index:0})), amount:$number, preventable:true}}]}}]}, otherwise:_{}} */
named_top_damage_result ::= "if" "that" "card" "has" "the" "chosen" "name" "," "that" "player" "puts" "it" "into" "their" "hand" "." "otherwise" "," "they" "put" "it" "into" "their" "graveyard" "and" "this" "artifact" "deals" number "damage" "to" "them"

/* The permission refers to the single card produced by this exact exile. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:EndOfTurn, evaluation:LiveObjects}}] */
instructions_exile_top_play_this_turn ::= "exile" "the" "top" "card" "of" "your" "library" "." "you" "may" "play" "that" "card" "this" "turn"

/* The plural permission is scoped to its own top-library exile producer. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[$impulse_discard_part]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:_{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$card_count, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:Either, filter:Any})], duration:UntilEndOfNextTurn(AbilityController), evaluation:LiveObjects}}]}, otherwise:_{}}] */
instructions_paid_discard_exile_play ::= "you" "may" impulse_discard_part "." "if" "you" "do" "," "exile" "the" "top" card_count "of" "your" "library" "." "you" "may" "play" "them" "until" "the" "end" "of" "your" "next" "turn"

/* The subject exiles cards from that same player's library. */
/* @sem Operation::Move{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
player_exiles_all_library ::= player_ref "exiles" "all" "cards" "from" "their" "library"

/* The same player looks at the library slice and separates that observation.
   The two face-down labels describe exactly two piles. */
/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:$player_ref, objects:$your_top}}, Effect{result:@next, operation:Piles{actor:One($player_ref), objects:InZone{objects:Observed(@marked), zone:Library}, count:Constant(2), names:['face down', 'face down']}}] */
clause_player_look_split_face_down ::= player_ref "looks" "at" your_top "and" "separates" "them" "into" "two" "face-down" "piles"

/* A whole hand is revealed immediately before its matching cards determine damage.
   Both the hand population and the damaged player use the same player operand. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($hand_player)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:Players(One($hand_player)), amount:Multiply([$number, CountObjects(Matching{objects:Zone{scope:Players{zone:Hand, players:One($hand_player)}, kind:Card, filter:Any}, filter:$revealed_count_chosen_card})]), preventable:true}}] */
instructions_revealed_hand_damage ::= hand_player "reveals" "their" "hand" "." damage_source_ref "deals" number "damage" "to" "that" "player" "for" "each" revealed_count_chosen_card "revealed" "this" "way"

/* A live count of cards matching a filter in the ability controller’s library. */
/* @sem Expr::CountObjects(Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}) */
count_each_filtered_library ::= filter_phrase "card" "in" "your" "library"

/* The observer and library owner are independent. */
/* @sem Operation::LookAt{player:$player_ref, objects:$your_top_slice} */
player_looks_at_your_top ::= player_ref "looks" "at" your_top_slice

/* @sem Instruction::[Instruction::Effect{result:@mark, operation:$search_library_graveyard_pair}, ...$search_plural_follow] */
clause_search_graveyard_pair ::= search_library_graveyard_pair search_plural_follow

/* @sem Operation::Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
found_plural_hand ::= "put" "them" "into" "your" "hand"

/* Two independent choices share the searched zones and the selected receipt. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_filtered, $search_choice_modified], also:[Graveyard]} */
search_library_graveyard_pair ::= "search" "your" "library" "and" "graveyard" "for" search_choice_filtered "and" search_choice_modified

/* @sem () */
mill_take_origin ::= "from" "among" "them" | "milled" "this" "way"

/* The single revealed top card remains the current top card throughout this
   immediate payment-dependent branch. Keep the anaphor inside this scope. */
/* @sem Expr::ObjectProperty{object:Query{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), index:0}, property:ManaValue, information:CurrentOrLastKnown} */
revealed_top_card_mana_value ::= "life" "equal" "to" "that" "card's" "mana" "value"

/* @sem Operation::LoseLife{players:$players_singular, amount:$revealed_top_card_mana_value} */
revealed_top_card_loss ::= players_singular "loses" revealed_top_card_mana_value

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:$revealed_top_card_loss}]}, otherwise:Program{}}] */
clause_optional_reveal_top_card_loss ::= "you" "may" "reveal" "the" "top" "card" "of" "your" "library" "." "if" "you" "do" "," revealed_top_card_loss

/* Both references to the milled cards belong to this same mill instruction. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$mill_take_choice}, count:Exactly(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:$number}}]}, otherwise:Program{}}] */
instructions_mill_take_and_test ::= "mill" card_count "." "you" "may" "put" mill_take_choice "milled" "this" "way" "into" "your" "hand" "." "you" "gain" number "life" "if" "a" filter_phrase "card" "is" "milled" "this" "way"

/* @sem ConjureDestination::Library{position:Shuffled, arrival:CardArrival{counters:[], states:[]}} */
conjure_shuffled_library ::= "into" "your" "library" "," "then" "shuffle"

/* A fraction is measured against the current size of the searched library. */
/* @sem Expr::Divide{numerator:CountObjects(Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), denominator:$search_fraction_denominator, rounding:$rounding_words} */
search_library_fraction ::= "the" "top" search_fraction_denominator "of" "your" "library" "," rounding_words

search_fraction_denominator ::= ordinal_third | library_depth_fourth | library_depth_fifth

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, top:$search_library_fraction, choices:[$search_fraction_choice]} */
search_fraction ::= "search" search_library_fraction "," "for" search_fraction_choice

search_fraction_choice ::= search_choice | foreign_choice_count

/* The selected cards remain the referent across the sentence boundary. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_fraction}, Effect{result:@next, operation:$found_action}, ...$search_follow] */
clause_search_sentence_follow ::= search_fraction "." found_action search_follow

/* Implied alternatives retain their independently scoped targets and move results. */
/* @sem Ability::Spell{announcement:_{modes:_{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:Any}), index:0}), destination:Library{position:TopOrBottom{chooser:Owners}, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$mixed_library_permanent}), index:0}), destination:Library{position:TopOrBottom{chooser:Owners}, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied}}, body:_{}} */
owner_mixed_library_choice ::= "the" "owner" "of" "target" "spell" "or" mixed_library_permanent "puts" "it" "on" "their" "choice" "of" "the" "top" "or" "bottom" "of" "their" "library" "."

/* @sem Ability::Spell{announcement:_{modes:_{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:Any}), index:0}), destination:Library{position:FromTop($library_ordinal), order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$mixed_library_permanent}), index:0}), destination:Library{position:FromTop($library_ordinal), order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied}}, body:_{}} */
put_mixed_library_depth ::= "put" "target" "spell" "or" mixed_library_permanent "into" "its" "owner's" "library" library_ordinal "from" "the" "top" "."

/* @sem Ability::Spell{announcement:_{modes:_{count:ModeCount{minimum:Constant(1), maximum:Constant(1)}, options:[@scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Spell, zones:[Stack]}), count:Exactly(Constant(1)), filter:$mixed_library_color_pair}), index:0}), destination:Library{position:TopOrBottom{chooser:Owners}, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}, weight:1}), @scope(Mode::Mode{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$mixed_library_color_pair}), index:0}), destination:Library{position:TopOrBottom{chooser:Owners}, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}, weight:1})], rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Implied}}, body:_{}} */
choose_mixed_color_library ::= "choose" "target" "spell" "or" "permanent" "that's" mixed_library_color_pair "." "its" "owner" "puts" "it" "on" "their" "choice" "of" "the" "top" "or" "bottom" "of" "their" "library" "."

mixed_library_permanent ::= mixed_permanent_noun | mixed_library_non_type

/* @sem ObjectFilter::$adjective_nontype */
mixed_library_non_type ::= adjective_nontype "permanent"

/* @sem Expr::Constant(2) */
library_ordinal_second ::= "second"

/* @sem Expr::Constant(3) */
library_ordinal_third ::= "third"

library_ordinal ::= library_ordinal_second | library_ordinal_third

/* @sem ObjectFilter::AnyOf([$adjective_color, $adjective_color_2]) */
mixed_library_color_pair ::= adjective_color "or" adjective_color

/* A player's library is revealed as a group and the observed cards are exiled.
   The two endings preserve Oracle's distinct referring phrases. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:RevealUntilGroup{library:Bound(0), constraints:[TotalProperty{property:ManaValue, comparison:GreaterOrEqual, amount:$exile_library_mana_threshold}]}}, Effect{result:@next, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
clause_exile_library_mana_threshold ::= players_singular "exiles" "cards" "from" "the" "top" "of" "their" "library" "until" exile_library_mana_threshold

exile_library_mana_threshold ::= exile_library_mana_threshold_they | exile_library_mana_threshold_that_player

/* @sem $value */
exile_library_mana_threshold_they ::= "they" "have" "exiled" "cards" "with" "total" "mana" "value" value "or" "greater" "this" "way"

/* @sem $value */
exile_library_mana_threshold_that_player ::= "that" "player" "has" "exiled" "cards" "with" "total" "mana" "value" value "or" "greater"

/* The permission refers specifically to the preceding library exile loop. */
/* @sem Instruction::[...$clause_exile_library_mana_threshold, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:CastSpell, filter:Any}, terms:_{cost:Free}})], duration:EndOfTurn, evaluation:LiveObjects}}] */
instructions_exile_library_mana_free ::= clause_exile_library_mana_threshold "." "until" "end" "of" "turn" "," "you" "may" "cast" "cards" "exiled" "this" "way" "without" "paying" "their" "mana" "costs"

/* Search the named card owner's zones, then exile the selection and shuffle. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:OwnerOf($current_card_ref), choices:[_{filter:SharesNameWith($current_card_ref), count:$name_search_count}], also:[Graveyard, Hand]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(OwnerOf($current_card_ref))}}] */
clause_search_owner_same_name_exile ::= "search" "its" "owner's" "graveyard" "," "hand" "," "and" "library" "for" name_search_count "cards" "with" "the" "same" "name" "as" current_card_ref "and" "exile" "them" "." "then" "that" "player" "shuffles"

/* The selected card remains the search receipt through its move and shuffle. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$player_search_one_choice]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]} */
search_that_card_hand_program ::= "you" "search" "your" "library" "for" player_search_one_choice "," "put" "that" "card" "into" "your" "hand" "," "then" "shuffle" "."

/* @sem @scope(Mode::Mode{announcement:@announcement, body:$search_that_card_hand_program, weight:1}) */
mode_search_that_card_hand ::= "•" search_that_card_hand_program

/* The controller moves their whole graveyard and shuffles their library. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Union([Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any})]), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
shuffle_own_graveyard ::= "shuffle" "your" "graveyard" "into" "your" "library"

/* The remainder branches follow the take that produced their movement receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top_for_conditional_rest}, ...$dig_put_take, $dig_conditional_rest] */
dig_look_conditional_rest ::= look_top_for_conditional_rest "." dig_put_take "." dig_conditional_rest

/* @sem Instruction::If{condition:$condition_one, then:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(2), phase:Before}])}, zone:Library}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(3), phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}]}} */
dig_conditional_rest ::= "then" "if" condition_one "," "put" "the" "rest" "into" "your" "hand" "." "otherwise" "," "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

look_top_for_conditional_rest ::= look_top_spelled_count | look_top

/* Retain written cardinal numbers in the initial look of this rest clause. */
/* @prefer always */
/* @sem Operation::LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:$count_plural, from:Top}} */
look_top_spelled_count ::= "look" "at" "the" "top" count_plural "cards" "of" "your" "library"

/* Keep the mill and its selected arrivals in one inverse-print contract. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$count_plural}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$card_filter}, count:UpTo($count_plural_2)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
instructions_mill_put_battlefield ::= "mill" count_plural "cards" "." "put" "up" "to" count_plural card_filter "cards" "from" "among" "the" "milled" "cards" "onto" "the" "battlefield"

/* Randomly exile part of a looked-at library slice, then reorder the cards
   still in that library. The look owns the observation used by both steps. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:$look_random_exile}, Effect{result:@next, operation:$look_remaining_top}] */
dig_look_random_exile ::= look_top "." look_random_exile "," "then" look_remaining_top

/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), chooser:Chance, objects:InZone{objects:Observed(@marked), zone:Library}, count:Exactly($value), constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}} */
look_random_exile ::= "exile" value "of" "them" "at" "random"

/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Top, order:$library_order} */
look_remaining_top ::= "put" "the" "rest" "on" "top" "of" "your" "library" library_order

/* The owner chooses the end of their own library for the named object. */
/* @sem MovementDestination::Library{position:TopOrBottom{chooser:Owners}, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
owner_chosen_library_end ::= "its" "owner" "puts" "it" "on" "their" "choice" "of" "the" "top" "or" "bottom" "of" "their" "library"

/* One card at the specified end of the ability controller's library. */
/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:$ordered_end} */
single_your_library_end ::= "the" ordered_end "card" "of" "your" "library"

/* @sem $card_count */
pile_top_count ::= "the" "top" card_count "of" "your" "library"

/* A chance-selected subset of a named player's hand is observed by the ability controller. */
/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), objects:Zone(_{scope:Players{zone:Hand, players:One($player_possessive)}, kind:Card, filter:Any}), chooser:Chance, count:AsManyAsCan($card_count)}], action:LookAt{player:AbilityController, objects:Prepared(@selection_id(0))}} */
look_random_hand_cards ::= "look" "at" card_count "at" "random" "in" player_possessive "hand"

/* Select from the looked-at library cards by a name shared with a battlefield permanent. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:SharesNameWithAny(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase})}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
dig_put_same_name ::= "you" "may" "put" "one" "of" "those" "cards" "onto" "the" "battlefield" "if" "it" "has" "the" "same" "name" "as" "a" filter_phrase

/* The cast consumes the singular selection of the immediately preceding search. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:$target_possessive, choices:[$search_cast_single_choice]}}, Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Selected(@prior), count:AnyNumber, terms:_{cost:Free}}}] */
clause_search_selected_free_cast ::= "search" target_possessive "library" "for" search_cast_single_choice "." "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost"

search_cast_single_choice ::= search_choice_filtered | search_choice_any | search_choice_modified | search_named_one

/* Move the named private-zone populations together before shuffling. */
/* @sem ObjectSet::Union([Zone{scope:Players{zone:$your_zone, players:One(AbilityController)}, kind:Card, filter:Any}, Zone{scope:Players{zone:$shuffle_own_zone, players:One(AbilityController)}, kind:Card, filter:Any}]) */
shuffle_own_zone_pair ::= your_zone "and" shuffle_own_zone

/* @sem EventZone::Hand */
shuffle_own_hand ::= "hand"

/* @sem EventZone::Graveyard */
shuffle_own_zone_graveyard ::= "graveyard"

shuffle_own_zone ::= shuffle_own_hand | shuffle_own_zone_graveyard

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$shuffle_own_zone_pair, destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
clause_shuffle_own_zones ::= "shuffle" shuffle_own_zone_pair "into" "your" "library"

/* Plural counted searches use plural follow-ups, preserving agreement. */
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:$search_counted}, ...$search_counted_reorder] */
clause_search_counted ::= search_counted search_counted_reorder

/* Reordering takes the selected cards out of the shuffle and then places them. */
search_counted_reorder ::= search_shuffle_top_any_order | search_shuffle_bottom_any_order | search_shuffle_top_random_order

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_counted_choice]} */
search_counted ::= "search" "your" "library" "for" search_counted_choice

search_counted_choice ::= search_choice_counted | search_choice_counted_filtered

/* Counted searches retain their selected cards for the shared follow-ups. */
/* @sem SearchChoice::SearchChoice{filter:Any, count:AsManyAsCan($count)} */
search_choice_counted ::= count "cards"

/* @sem SearchChoice::SearchChoice{filter:$search_filter_many, count:AsManyAsCan($count)} */
search_choice_counted_filtered ::= count search_filter_many

/* The found cards remain excluded from the shuffle before their chosen placement. */
/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::Shuffle{players:One(PlayerRef::AbilityController), excluding:Selected(@marked)}}, Instruction::Effect{result:@next, operation:Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@marked), end:Bottom, order:Chosen}}] */
search_shuffle_bottom_any_order ::= "," "then" "shuffle" "and" "put" "those" "cards" "on" "the" "bottom" "in" "any" "order"

/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::Shuffle{players:One(PlayerRef::AbilityController), excluding:Selected(@marked)}}, Instruction::Effect{result:@next, operation:Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@marked), end:Top, order:Random}}] */
search_shuffle_top_random_order ::= "," "then" "shuffle" "and" "put" "those" "cards" "on" "top" "in" "a" "random" "order"

/* Keep the singular search receipt across the shuffle and the placement. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_single_library}, ...$search_shuffle_depth] */
clause_search_single_depth ::= search_single_library search_shuffle_depth

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_single_choice]} */
search_single_library ::= "search" "your" "library" "for" search_single_choice

search_single_choice ::= search_choice_any | search_choice_filtered | search_choice_modified | search_choice_optional_one

/* @sem Instruction::[Effect{result:@next, operation:Shuffle{players:One(AbilityController), excluding:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Library{position:FromTop($library_depth), order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
search_shuffle_depth ::= "," "then" "shuffle" "and" "put" "that" "card" library_depth "from" "the" "top"

/* The observation, optional selection and both follow-ups share the same hand owner and selection receipt. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One($target_possessive)}, kind:Card, filter:Any}}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(2)), zone:Hand}, filter:@and($a_card, ObjectFilter::OwnedBy(One($target_possessive)))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:DiscardObjects{objects:One(Result{result:@prior, phase:After, index:0})}}, Effect{result:@next, operation:Draw{players:One($target_possessive), amount:$card_count}}]}}] */
instructions_look_hand_optional_discard_draw ::= "look" "at" target_possessive "hand" "." "you" "may" "choose" a_card "from" "it" "." "if" "you" "do" "," "that" "player" "discards" "that" "card" "," "then" "draws" card_count

/* The observed hand and the optional choice share the same targeted owner. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One($target_possessive)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(3)), zone:Hand}, filter:@and($adjective_nontype, ObjectFilter::OwnedBy(One($target_possessive)))}, count:AsManyAsCan(Constant(1))}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:_{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Draw{players:One($target_possessive), amount:$card_count}}]}, otherwise:_{}}] */
clause_look_hand_optional_exile_draw ::= "look" "at" target_possessive "hand" "." "you" "may" "choose" "a" adjective_nontype "card" "from" "it" "." "if" "you" "do" "," "that" "player" "exiles" "that" "card" "," "then" "draws" card_count

/* The first qualifying card is selected from the controller's library. */
/* @sem ObjectSet::Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, Not(HasKeyword($keyword_name))])}), count:Constant(1), from:Top} */
topmost_card_without_keyword ::= "the" "topmost" filter_phrase "card" "in" "your" "library" "without" keyword_name

/* Three independent color choices share the search receipt. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:$adjective_color, count:UpTo(Constant(1))}, _{filter:$adjective_color_2, count:UpTo(Constant(1))}, _{filter:$adjective_color_3, count:UpTo(Constant(1))}]} */
search_three_colors ::= "search" "your" "library" "for" "a" adjective_color "card" "," "a" adjective_color "card" "," "and" "a" adjective_color "card"

/* @sem Operation::Move{objects:Selected(@marked), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]} */
found_those_graveyard ::= "put" "those" "cards" "into" "your" "graveyard"

/* @sem Instruction::[Effect{result:@mark, operation:$search_three_colors}, Effect{result:@next, operation:$found_those_graveyard}, ...$search_shuffle] */
clause_search_three_colors_graveyard ::= search_three_colors "." found_those_graveyard search_shuffle

/* The filtered reveal and the selection share the target hand and filter. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($target_opponent)}, kind:Card, filter:$adjective_nontype}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(Target{slot:0, index:0})}, kind:Card, filter:$adjective_nontype}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
observed_filtered_hand_choose_exile ::= target_opponent "reveals" "each" adjective_nontype "card" "in" "their" "hand" "." "you" "choose" "one" "of" "those" "cards" "and" "exile" "it"

/* The optional choice is bounded to the immediately revealed whole hand. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($target_opponent)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@prior), zone:Hand}, filter:@and($adjective_nontype, ObjectFilter::OwnedBy(One(Target{slot:0, index:0})))}, count:UpTo(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
observed_hand_optional_choose_exile ::= target_opponent "reveals" "their" "hand" "." "you" "may" "choose" "a" adjective_nontype "card" "from" "it" "." "if" "you" "do" "," "exile" "that" "card"

/* A single observed hand supplies the optional choice and its conditional move;
   the targeted player also receives the named conjured card. */
/* @sem Instruction::[Effect{result:@next, operation:RevealFromHand{actor:One($target_player), cards:$adjective_nontype}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(3)), zone:Hand}, filter:@and(ObjectFilter::Any, ObjectFilter::OwnedBy(One(Target{slot:0, index:0})))}, count:AsManyAsCan(Constant(1))}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:_{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Conjure{actor:One(Target{slot:0, index:0}), card:Named($referenced_card_name), count:Constant(1), destination:Hand(CardArrival{counters:[], states:[]})}}]}, otherwise:_{}}] */
observed_hand_optional_exile_conjure ::= target_player "reveals" "all" adjective_nontype "cards" "in" "their" "hand" "." "you" "may" "choose" "one" "of" "those" "cards" "." "if" "you" "do" "," "that" "player" "exiles" "it" "and" "conjures" "a" "card" "named" referenced_card_name "into" "their" "hand"

/* Keep the search selection in scope through its reveal, optional entry,
   hand fallback, and shuffle. The fallback moves any card still selected. */
/* @sem Instruction::[Effect{result:@mark, operation:$search}, Effect{result:@next, operation:$search_selected_reveal}, If{condition:Controls{player:AbilityController, filter:$filter_phrase, minimum:1}, then:Program{instructions:[Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Selected(@marked), count:AnyNumber, constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:Battlefield{controller:Owner, arrival:$search_option_entry}, qualifiers:[]}}}]}, otherwise:Program{}}, Effect{result:@next, operation:$search_selected_hand}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
clause_search_conditional_entry ::= search "and" search_selected_reveal "." "you" "may" "put" "that" "card" search_option_entry "if" "you" "control" "a" filter_phrase "." "otherwise" "," search_selected_hand "." "then" "shuffle"

/* @sem Operation::Reveal{objects:Selected(@marked)} */
search_selected_reveal ::= "reveal" "it"

/* @sem Operation::Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
search_selected_hand ::= "put" "that" "card" "into" "your" "hand"

/* @sem Expr::Constant(7) */
library_depth_seventh ::= "seventh"

/* A look at the top supplies both alternative branches. The same look and
   count are printed in both branches from their current operands. */
/* @sem Instruction::[If{condition:$condition_cast_not_from_caster_hand, then:_{instructions:[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:_{instructions:[Effect{result:@mark, operation:$look_top}, ...$look_put_split]}}] */
look_split_cast_origin_instead ::= look_top "." look_put_split "." "if" condition_cast_not_from_caster_hand "," "put" "each" "of" "those" "cards" "into" "your" "hand" "instead"

/* The permission follows the actual selection and exile, after the remainder is reordered. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$look_exile_card, ...$look_put_remainder, Effect{result:@next, operation:$look_exiled_permission}] */
instructions_look_exile_permission ::= look_top "." look_exile_card "." look_put_remainder "." look_exiled_permission

look_exiled_permission ::= look_exiled_free_permission | look_exiled_undaunted_permission

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@back(2), phase:After, index:0}), from:Exile, action:CastSpell, filter:Any}, terms:_{cost:Free}})], duration:$duration, evaluation:LiveObjects} */
look_exiled_free_permission ::= duration "," "you" "may" "cast" "the" "exiled" "card" "without" "paying" "its" "mana" "cost"

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@back(2), phase:After, index:0}), from:Exile, action:CastSpell, filter:Any}, terms:_{cost:Normal, effects:[List([Term{family:SpellEffect, form:Undaunted}])]}})], duration:WhileExiled(Result{result:@back(2), phase:After, index:0}), evaluation:LiveObjects} */
look_exiled_undaunted_permission ::= "for" "as" "long" "as" "that" "card" "remains" "exiled" "," "you" "may" "cast" "it" "." "that" "spell" "has" "undaunted"

/* Reveal until a card's mana value matches the most recent die roll. The
   selected card and the remainder share the same observed receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:$value_die_result}}]), count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:$value_die_result}}])}, destination:$until_destination, qualifiers:[]}}, Effect{result:@next, operation:$rest_bottom}] */
instructions_reveal_until_die_value ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "a" card_filter "card" "with" "mana" "value" "equal" "to" value_die_result "." "put" "that" "card" until_destination "and" rest_bottom

/* Card predicates compose with seek and other single-card choices. */
/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:CountCounters(_{recipients:Players(One($player_ref)), kind:$counter_kind, information:CurrentOrLastKnown})}} */
a_card_mana_equal_player_counters ::= "a" "card" "with" "mana" "value" "equal" "to" "the" "number" "of" counter_kind "counters" player_ref "has"

/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value_counters_on_object}}}), property:ManaValue, aggregation:Maximum}}} */
a_card_maximum_mana ::= "a" "card" "with" "the" "highest" "mana" "value" "among" "cards" "in" "your" "library" "with" "mana" "value" "X" "or" "less" "," "where" "X" "is" value_counters_on_object

/* @sem ObjectFilter::AllOf([$card_filter, MostCommonCreatureTypeIn(AbilityController)]) */
a_card_prevalent_type ::= "a" card_filter "card" "of" "the" "most" "prevalent" "creature" "type" "in" "your" "library"

/* The player chooses from their own graveyard; the count remains an operand. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$player_ref, objects:Zone{scope:Players{zone:Graveyard, players:One($player_ref)}, kind:Card, filter:Any}, count:AsManyAsCan($card_count_many)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_player_exiles_graveyard_many ::= player_ref "exiles" card_count_many "from" "their" "graveyard"

/* Complete private-library populations and a slice leaving the bottom card. */
/* @sem ObjectSet::Zone{scope:Players{zone:Library, players:One($player_possessive)}, kind:Card, filter:Any} */
all_private_library_cards ::= "all" "the" "cards" "from" player_possessive "library"

/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One($player_possessive)}, kind:Card, filter:Any}, count:Subtract(CountObjects(Zone{scope:Players{zone:Library, players:One($player_possessive)}, kind:Card, filter:Any}), Constant(1)), from:Top} */
library_except_bottom ::= "all" "but" "the" "bottom" "card" "of" player_possessive "library"

/* A single exiled top card supplies the object for both conditional branches.
   Keep the producer and consumers in the same instruction span. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_top_card_receipt}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$card_filter}, then:Program{instructions:$exiled_top_branch}, otherwise:Program{instructions:$exiled_top_branch_2}}] */
instructions_exiled_top_object_otherwise ::= exile_top_card_receipt "." "if" "it's" "a" card_filter "card" "," exiled_top_branch "." "otherwise" "," exiled_top_branch

/* @sem Operation::@exiled_card_result(Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}) */
exile_top_card_you ::= "exile" "the" "top" "card" "of" "your" "library"

exiled_top_branch ::= exiled_top_create_tokens | exiled_top_cast_it | exiled_top_to_hand | exiled_top_put_counter

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
exiled_top_to_hand ::= "put" "it" "into" "your" "hand"

/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(Result{result:@marked, phase:After, index:0})), kind:$counter_kind, amount:Constant(1)}]}}] */
exiled_top_put_counter ::= "put" "a" counter_kind "counter" "on" "it"

/* The test consumes the observation produced by this very reveal. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:$reveal_top}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:CardType(Creature)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:$clause}, otherwise:Program{}}]}}] */
clause_optional_reveal_matching ::= "you" "may" reveal_top "." "if" "a" "creature" "card" "is" "revealed" "this" "way" "," clause

/* The revealed-card permission consumes the exact reveal receipt, and all
   three follow-up actions use the targeted spell's controller. */
/* @sem Instruction::[Effect{result:@next, operation:Counter{objects:One($target_stack_spell), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}, Effect{result:@mark, operation:RevealUntil{library:ControllerOf(Target{slot:@next_slot, index:0}), filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:PlayCards{actor:One(ControllerOf(Target{slot:@next_slot, index:0})), action:CastSpell, cards:Matching{objects:Observed(@marked), filter:$card_filter}, count:UpTo(Constant(1)), cost:Free}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf(Target{slot:@next_slot, index:0}))}}] */
instructions_counter_reveal_cast ::= "counter" target_stack_spell "." prior_controller_reveals_until "an" card_filter "card" "." "that" "player" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" "." "then" "the" "player" "shuffles"

/* A choice of library end belongs to the moved object's owner. */
/* @sem MovementDestination::Library{position:TopOrBottom{chooser:Owners}, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
owner_library_choice_destination ::= "on" "their" "choice" "of" "the" "top" "or" "bottom" "of" "their" "library"

/* @sem $card_ability_qualifier */
search_many_ability ::= "cards" card_ability_qualifier

/* Search, exile and shuffle retain one selected receipt and its pile state. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$foreign_choice_count]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[ExilePile{shuffled:true}]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
clause_search_exile_shuffled_pile ::= "search" "your" "library" "for" foreign_choice_count "," "exile" "them" "in" "a" "face-down" "pile" "," "and" "shuffle" "that" "pile" "." "then" "shuffle" "your" "library"

/* The entire movement and shuffle share the same group. */
/* @sem $shuffle_own_graveyard */
clause_then_shuffle_own_graveyard ::= "then" shuffle_own_graveyard

/* The moved selection determines the remainder of the observed library. */
/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(2), phase:Before}])}, zone:Library}, end:Bottom, order:$library_order} */
rest_bottom_implicit_library ::= "the" "rest" "on" "the" "bottom" library_order

/* The mana-value predicate belongs to the chosen cards, before they move. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
dig_reveal_battlefield_value ::= "you" "may" "reveal" "a" card_filter "card" "with" "mana" "value" "less" "than" "or" "equal" "to" value "from" "among" "them" "and" "put" "it" "onto" "the" "battlefield"

/* The convoke threshold describes the selected cards; the final shuffle is separate. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$dig_convoke_to_hand, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
dig_look_convoke_shuffle ::= look_top "." dig_convoke_to_hand "," "then" "shuffle"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:History{event:Convoked($object_ref), window:ThisGame}})}}])}, count:UpTo($count), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
dig_convoke_to_hand ::= "you" "may" "reveal" "up" "to" count card_filter "cards" "with" "mana" "value" "X" "or" "less" "from" "among" "them" "," "where" "X" "is" "the" "number" "of" "creatures" "that" "convoked" object_ref "." "put" "the" "revealed" "cards" "into" "your" "hand"

/* The battlefield selection names its observed remainder without a library possessive. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$dig_follow_battlefield_value] */
dig_look_battlefield_value ::= look_top "." dig_follow_battlefield_value

/* @sem Instruction::[...$dig_reveal_battlefield_value, $dig_implicit_rest_put] */
dig_follow_battlefield_value ::= dig_reveal_battlefield_value "." dig_implicit_rest_put

/* @sem Instruction::Effect{result:@next, operation:$rest_bottom_implicit_library} */
dig_implicit_rest_put ::= "put" rest_bottom_implicit_library

/* A library observation and its replacement share the same selection and receipts. */
/* @sem Instruction::[If{condition:Compare{left:CountObjects(Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$dig_graveyard_threshold_filter})), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$dig_graveyard_threshold_count}}, then:_{instructions:[Effect{result:@next, operation:$look_top_spelled_count}, Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@prior), zone:Library}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:_{instructions:[Effect{result:@next, operation:$look_top_spelled_count}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@prior), zone:Library}, count:AsManyAsCan($dig_observed_hand_count), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Chosen}}]}}] */
dig_observed_hand_replacement ::= look_top_spelled_count "." dig_observed_hand_count "." "put" "each" "of" "those" "cards" "into" "your" "hand" "instead" "if" "there" "are" dig_graveyard_threshold_count "or" "more" dig_graveyard_threshold_filter "cards" "in" "your" "graveyard"

/* @sem $value */
dig_observed_hand_count ::= "put" value "of" "those" "cards" "into" "your" "hand" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "any" "order"

/* @sem $value */
dig_graveyard_threshold_count ::= value

/* @sem $filter_phrase */
dig_graveyard_threshold_filter ::= filter_phrase

/* The receipt count is tied to the move of the entire graveyard into this library. */
/* @sem Instruction::[...$shuffle_graveyard_receipt, Effect{result:@next, operation:Mill{players:$players_singular, amount:CountObjects(Transition{result:@marked, phase:Before})}}] */
shuffle_graveyard_mill_receipt ::= shuffle_graveyard_receipt "." players_singular "mills" "that" "many" "cards"

/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Union([Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any})]), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
shuffle_graveyard_receipt ::= "shuffle" "all" "cards" "from" "your" "graveyard" "into" "your" "library"

/* A command-zone ownership predicate and the controller's graveyard are distinct. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Zone(_{scope:Shared(Command), kind:Card, filter:AllOf([State(Commander), OwnedBy(One(AbilityController))])}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:State(Commander)}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
return_owned_commanders_zones ::= "put" "all" "commanders" "you" "own" "from" "the" "command" "zone" "and" "from" "your" "graveyard" "into" "your" "hand"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$dig_observed_hand_replacement}} */
spell_dig_observed_replacement ::= dig_observed_hand_replacement "."

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$shuffle_graveyard_mill_receipt}} */
spell_shuffle_graveyard_mill ::= shuffle_graveyard_mill_receipt "."

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[...$return_owned_commanders_zones, ...$shuffle_own_graveyard]}} */
activated_return_commanders_shuffle ::= cost ":" return_owned_commanders_zones "." "then" shuffle_own_graveyard "."

/* Card restrictions compose with any selection that accepts a singular card. */
/* @sem ObjectFilter::AllOf([$card_filter, AnyOf([Subtype(Forest), Subtype(Island), Subtype(Mountain), Subtype(Plains), Subtype(Swamp)])]) */
a_card_basic_type ::= "a" card_filter "card" "with" "a" "basic" "land" "type"

/* @sem ObjectFilter::AllOf([$card_filter, Subtype(Urzas)]) */
a_card_urzas ::= "an" "Urza's" card_filter "card"

/* @sem ObjectFilter::AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}]) */
a_card_value_limit ::= "a" card_filter "card" "with" "mana" "value" value "or" "less"

/* Each player chooses from their own library and moves the selected card to its owner. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone(_{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:$a_card}), count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
clause_each_player_seeks ::= "each" "player" "seeks" a_card

/* The selected card's arrival is the object manifested. */
/* @sem Instruction::[...$clause_seek_card, Effect{result:@next, operation:Manifest{actor:One(AbilityController), source:Cards(One(Result{result:@prior, phase:After, index:0})), entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
clause_seek_manifest ::= clause_seek_card "and" "manifest" "it"

/* This continuation is scoped to the immediately preceding look at a library. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($value), constraints:[CanMoveTo{destination:OwnersGraveyard(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Top, order:Chosen}}] */
instructions_look_put_graveyard ::= look_top "." "put" value "of" "them" "into" "your" "graveyard"

/* The two kinds share the final card noun. */
/* @sem ObjectFilter::AnyOf([$card_filter, $card_filter_2]) */
a_card_shared_or ::= "an" card_filter "or" card_filter "card"

/* Ordered slices preserve the card filter, owner, and count independently. */
/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One($player_possessive)}, kind:Card, filter:$filter_phrase}, count:Constant(1), from:$ordered_end} */
ordered_filtered_card ::= "the" ordered_end filter_phrase "card" "of" player_possessive "library"

/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One(OwnerOf(EventSubject))}, kind:Card, filter:Any}, count:$card_count, from:Top} */
ordered_event_owner_cards ::= card_count "from" "the" "top" "of" "its" "owner's" "library"

/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One($player_possessive)}, kind:Card, filter:Any}, count:$value_differently_named, from:Top} */
ordered_named_count ::= "a" "number" "of" "cards" "from" "the" "top" "of" player_possessive "library" "equal" "to" value_differently_named

/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One($player_possessive)}, kind:Card, filter:Any}, count:CountPlayers($players_singular), from:Top} */
ordered_card_per_player ::= "a" "card" "from" "the" "top" "of" player_possessive "library" "face" "down" "for" players_singular "you" "have"

/* @sem ObjectSet::Union([$affected, $ordered_cards]) */
ordered_with_affected ::= affected "and" ordered_cards

/* The permission follows this very top-of-library exile; its receipt cannot
   refer to an unrelated move or a different destination. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:Either, filter:Any}, terms:_{limit:Total(1), cost:Normal}})], duration:$duration, evaluation:LiveObjects}}] */
clause_exile_top_play_one ::= exile_top_cards_of_your_library "." duration "," "you" "may" "play" "one" "of" "those" "cards"

/* The same exile receipt supplies both land plays and free spell casts.
   The selected library slice remains an operand of the producer. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$ordered_cards, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:PlayLand, filter:Any}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:CastSpell, filter:Any}, terms:_{cost:Free}})], duration:WhileAnyExiled(Transition{result:@prior, phase:After}), evaluation:LiveObjects}}] */
clause_exile_ordered_play_free ::= "exile" ordered_cards "." "you" "may" "play" "lands" "and" "cast" "spells" "from" "among" "cards" "exiled" "this" "way" "without" "paying" "their" "mana" "costs"

/* Two independent search choices share the ordinary found-card follow-ups. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_pair_subtype_choice, $search_pair_subtype_choice_2]} */
search_library_pair_and ::= "search" "your" "library" "for" search_pair_subtype_choice "and" search_pair_subtype_choice

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_filtered, $search_choice_filtered_2]} */
search_library_pair_and_or ::= "search" "your" "library" "for" search_choice_filtered "and" "/" "or" search_choice_filtered

/* @sem ObjectFilter::AnyOf([$card_filter, $card_filter_2]) */
search_filter_either_bare ::= card_filter "card" "or" card_filter "card"

/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::Shuffle{players:One(PlayerRef::AbilityController), excluding:Selected(@marked)}}, Instruction::Effect{result:@next, operation:Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@marked), end:Top, order:Chosen}}] */
search_shuffle_top_the_card ::= "," "then" "shuffle" "and" "put" "the" "card" "on" "top"

/* Two search choices name one plural receipt through all follow-up actions. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_library_pair}, ...$search_plural_follow] */
clause_search_library_pair ::= search_library_pair search_plural_follow

search_library_pair ::= search_library_pair_and | search_library_pair_and_or

/* @sem SearchChoice::SearchChoice{filter:$subtype, count:UpTo(Constant(1))} */
search_pair_subtype_choice ::= ("a" | "an") subtype "card"

/* One random qualifying card from a bounded top-of-library population. */
/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), chooser:Chance, objects:Matching{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$card_count, from:Top}, filter:$filter_phrase}, count:AsManyAsCan(Constant(1)), constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}} */
random_top_card_to_hand ::= "put" "a" "random" filter_phrase "card" "from" "among" "the" "top" card_count "of" "your" "library" "into" "your" "hand"

/* Keep the arrival reference tied to the immediately preceding move. */
/* @sem Instruction::[Effect{result:@next, operation:$random_top_card_to_hand}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:[GrantAbility(Casting(ReduceCost([_{amount:$braced_amount}])))]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_random_top_cost ::= random_top_card_to_hand "." "it" "perpetually" "gains" '"' "this" "spell" "costs" braced_amount "less" "to" "cast" "." '"' "then" "shuffle"

/* The explicit actor still chooses from the same current card pool. */
/* @sem $clause_put_from */
clause_you_put_from ::= "you" clause_put_from

/* Search predicates preserve the referenced object's identity and battlefield scope. */
/* @sem ObjectFilter::AllOf([$filter_phrase, Not(SharesNameWithAny(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase_2}))]) */
search_filter_distinct_controlled_name ::= filter_phrase "card" "that" "doesn't" "have" "the" "same" "name" "as" "a" filter_phrase

/* @sem ObjectFilter::AllOf([$card_filter, SharesNameWith($object_ref)]) */
search_filter_shared_object_name ::= card_filter "card" "with" "the" "same" "name" "as" object_ref

/* The search selection remains the antecedent of the singular pronoun. */
/* @sem Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player($possessive_target_player), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]} */
found_battlefield_tapped_target_controller ::= "put" "it" "onto" "the" "battlefield" "tapped" "under" possessive_target_player "control"

/* @sem Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedToPlayer($player_ref)]}}, qualifiers:[]} */
found_battlefield_attached_player ::= "put" "it" "onto" "the" "battlefield" "attached" "to" player_ref

/* A choice between a typed card and a card with a keyword. */
/* @sem ObjectFilter::AnyOf([$card_filter, HasKeyword($keyword_value)]) */
search_filter_keyword_alternative ::= card_filter "card" "or" "a" "card" "with" keyword_value

/* The foretell designation applies to the card just moved face down from hand. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:EffectOn{subject:Objects(One(Result{result:@prior, phase:After, index:0})), effects:[Term{family:ExiledCardEffect, form:IsForetoldForCost, operands:[Cost{parts:[ManaCostReduced{reduction:Term{family:CostReductionSymbol, form:CostReduceGeneric, operands:[Integer($number)]}}]}]}]}}] */
clause_foretell_exiled_hand ::= "exile" "a" "card" "from" "your" "hand" "face" "down" "." "it" "becomes" "foretold" "." "its" "foretell" "cost" "is" "its" "mana" "cost" "reduced" "by" "{" NUMBER "}"

/* @sem SearchChoice::SearchChoice{filter:$filter_phrase, count:AnyNumber} */
search_choice_any_number_filtered ::= "any" "number" "of" filter_phrase "cards"

/* @sem SearchChoice::SearchChoice{filter:AllOf([Colorless, $adjective_nontype]), count:AnyNumber} */
search_choice_any_number_colorless ::= "any" "number" "of" "colorless" adjective_nontype "cards"

/* These complete search/exile sequences keep their cast permissions attached to
   the exile receipt, including across the intervening shuffle. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$search_any_number}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:1, phase:After}, from:Exile, action:Either, filter:Any}, terms:_{cost:Free}})], duration:$duration, evaluation:LiveObjects}}]} */
program_search_exile_permission ::= search_any_number "," "exile" "them" "," "then" "shuffle" "." duration "," "you" "may" "cast" "those" "cards" "without" "paying" "their" "mana" "costs" "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:AllOf([$filter_instant_or_sorcery, Shares{property:Colors, with:$object_ref}]), count:UpTo($counter_amount)}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}, Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Result{result:1, phase:After, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}]} */
program_search_exile_cast_one ::= "search" "your" "library" "for" counter_amount filter_instant_or_sorcery "card" "that" "shares" "a" "color" "with" object_ref "," "exile" "that" "card" "," "then" "shuffle" "." "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" "."

/* @sem Program::Program{instructions:[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:Bound(0), choices:[_{filter:$adjective_nontype, count:UpTo($counter_amount)}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}, Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Transition{result:1, phase:After}, count:AnyNumber, cost:Free}}]}}]} */
program_each_search_exile_cast ::= "for" players_singular "," "search" "that" "player's" "library" "for" counter_amount adjective_nontype "card" "and" "exile" "it" "," "then" "that" "player" "shuffles" "." "you" "may" "cast" "those" "cards" "without" "paying" "their" "mana" "costs" "."

/* The destination phrase supplies both the hand source wording and visibility;
   the same selection-and-move instruction composes with either spelling. */
hand_selection_exile_destination ::= hand_selection_exile_up | hand_selection_exile_down

/* @sem MovementDestination::Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}} */
hand_selection_exile_up ::= "from" "their" "hand"

/* @sem MovementDestination::Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}} */
hand_selection_exile_down ::= "from" "their" "hand" "face" "down"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$player_ref, objects:Zone{scope:Players{zone:Hand, players:One($player_ref)}, kind:Card, filter:Any}, count:AsManyAsCan($card_count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$hand_selection_exile_destination, qualifiers:[]}}] */
clause_player_hand_selection_exile ::= player_ref "exiles" card_count hand_selection_exile_destination

/* The distinct-owner target group corresponds to at most one card per opponent. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:AnyNumber, filter:@and($card_filter, ObjectFilter::OwnedBy(OpponentsOf(AbilityController))), constraints:[DifferentOwners]})) */
opponent_graveyard_cast_targets ::= "up" "to" "one" "target" card_filter "card" "from" "that" "player's" "graveyard"

/* The replacement sentence belongs to the cast, not a separate move. */
/* @sem Instruction::[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:$opponent_graveyard_cast_targets, count:AnyNumber, cost:Free, into_exile:true}}] */
instructions_opponent_graveyard_free_cast ::= "for" "each" "opponent" "," "you" "may" "cast" opponent_graveyard_cast_targets "without" "paying" "its" "mana" "cost" "." "if" "a" "spell" "cast" "this" "way" "would" "be" "put" "into" "a" "graveyard" "," "exile" "it" "instead"

/* The draw is measured from the immediately preceding hand-to-library move.
   Keeping the producer in this phrase constrains both recognition and printing. */
/* @sem Instruction::[Effect{result:@next, operation:$recycle_hand_move}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:CountObjects(Transition{result:@prior, phase:Before})}}] */
clause_recycle_hand_draw ::= recycle_hand_move "," "then" "draw" "that" "many" "cards"

recycle_hand_move ::= recycle_hand_bottom | recycle_hand_shuffle

/* @sem Operation::Move{objects:$recycle_hand_cards, destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
recycle_hand_bottom ::= "put" recycle_hand_cards "on" "the" "bottom" "of" "your" "library" "in" "any" "order"

/* @sem Operation::Move{objects:$recycle_hand_cards_from, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
recycle_hand_shuffle ::= "shuffle" recycle_hand_cards_from "into" "your" "library"

/* @sem ObjectSet::Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any} */
recycle_hand_cards ::= "the" "cards" "in" "your" "hand"

/* @sem ObjectSet::Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any} */
recycle_hand_cards_from ::= "the" "cards" "from" "your" "hand"

/* A player iteration binds the actor, payer, and owner of the acted-on cards. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:$bound_optional_library_action}}] */
clause_each_player_optional_library_action ::= players_singular "may" bound_optional_library_action

/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:Bound(0), cost:Cost{parts:[PlayerAction{player:Bound(0), body:Program{instructions:[Effect{result:@next, operation:$bound_ante_top}]}}]}, optional:true}}] */
bound_optional_library_action ::= bound_ante_top

/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Ante(CardArrival{counters:[], states:[]}), qualifiers:[]} */
bound_ante_top ::= "ante" "the" "top" "card" "of" "their" "library"

/* The follow-up selects players who took the immediately preceding optional
   player action; the two phrases share its result within this scope. */
/* @sem Instruction::[...$clause_each_player_optional_library_action, ForEachPlayer{players:Matching{binding:0, condition:PlayerTook{player:Bound(0), result:@prior}}, binding:0, body:Program{instructions:[Effect{result:@next, operation:SetLifeTotal{players:One(Bound(0)), amount:$value}}]}}] */
instructions_player_optional_life ::= clause_each_player_optional_library_action "." "if" "a" "player" "does" "," "that" "player's" "life" "total" "becomes" value

/* An optional look guards the subsequent test; the test and reveal both name the
   same single top card of the controller's library. */
/* @sem Cost::Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:$top_card_look}}]} */
optional_top_look_payment ::= top_card_look

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$optional_top_look_payment, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$looked_top_conditional_reveal}, otherwise:Program{}}] */
instructions_optional_top_look_test ::= "you" "may" optional_top_look_payment looked_top_conditional_reveal

/* @sem Instruction::[If{condition:ObjectMatches{object:Query{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), index:0}, filter:$card_filter}, then:Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:$program, otherwise:Program{}}]}, otherwise:Program{}}] */
looked_top_conditional_reveal ::= "if" "it's" "a" card_filter "card" "," "you" "may" "reveal" "it" "and" program

/* Reveal both disjoint choices, then move the cards just revealed. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$filter_phrase}, count:UpTo($counter_amount), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Difference{objects:InZone{objects:Observed(@marked), zone:Library}, excluding:Union([Selected(@prior)])}, filter:$filter_phrase_2}, count:UpTo($counter_amount_2), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Reveal{objects:Union([Selected(@back(3)), Selected(@prior)])}}, Effect{result:@next, operation:Move{objects:Union([Selected(@back(4)), Selected(@back(3))]), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
dig_reveal_each_to_hand ::= "you" "may" "reveal" counter_amount filter_phrase "card" "and" "/" "or" counter_amount filter_phrase "card" "from" "among" "them" "and" "put" "the" "revealed" "cards" "into" "your" "hand"

/* The retained bottom count belongs to each player's own library. */
/* @sem Instruction::[ForEachPlayer{players:$optional_player_population, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}, count:Subtract(CountObjects(Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}), $card_count), from:Top}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
clause_each_exiles_except_bottom ::= optional_player_population "exiles" "all" "but" "the" "bottom" card_count "of" "their" "library" "face" "down"

/* The amount is the enclosing event's amount; the library belongs to the named player. */
/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:$players_singular}, kind:Card, filter:Any}, count:EventAmount, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
player_exiles_event_amount ::= players_singular "exiles" "that" "many" "cards" "from" "the" "top" "of" "their" "library"

/* The permission is tied to this exact exile producer and its arrival receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:Either, filter:Any})], duration:$receipt_span_duration, evaluation:LiveObjects}}, ...$clause] */
instructions_exile_top_play_then ::= exile_top_cards_of_your_library "." "you" "may" "play" "cards" "exiled" "this" "way" receipt_span_duration "." NEWLINE clause

/* A single top-card exile, its damage measurement and its play permission share
   one producer. The fixed singleton prevents a plural receipt from being used as
   the antecedent of "that card". */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Bound(0))), amount:ObjectProperty{object:Result{result:@prior, phase:After, index:0}, property:$stat, information:CurrentOrLastKnown}, preventable:true}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@back(3), phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:$duration, evaluation:LiveObjects}}] */
exile_single_top_damage_play ::= "exile" "the" "top" "card" "of" "your" "library" "," "then" SELF_NAME "deals" "damage" "equal" "to" "that" "card's" stat "to" "that" "permanent" "or" "player" "." "you" "may" "play" "the" "exiled" "cards" duration

/* A selected observed card's conditional arrival applies equally to the choice and move. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$a_card}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:$dig_conditional_entry}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_conditional_entry, qualifiers:[]}}] */
dig_put_conditional_entry ::= "you" "may" "put" a_card "from" "among" "them" dig_conditional_entry

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[When{filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$number_digits}}, entry:BattlefieldArrival{tapped:false, counters:[[$counter_kind, $count_plural]], states:[]}}]}} */
dig_conditional_entry ::= "onto" "the" "battlefield" "." "if" "that" "card" "has" "mana" "value" number_digits "or" "less" "," "it" "enters" "with" count_plural "additional" counter_kind "counters" "on" "it"

/* The move is tied to the same library-top population as the reveal. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:LibraryTops($optional_player_population)}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Move{selections:[_{objects:LibraryTops($optional_player_population)}], destination:OwnersGraveyard(CardArrival{counters:[], states:[]})}]}, optional:true}}] */
reveal_tops_optional_graveyard ::= optional_player_population "reveals" "the" "top" "card" "of" "their" "library" "." "you" "may" "put" "the" "revealed" "cards" "into" "their" "owners'" "graveyards"

/* @sem Instruction::[...$reveal_tops_optional_graveyard, If{condition:Not(PaymentChosen(@last_result)), then:$program, otherwise:Program{}}] */
instructions_reveal_tops_declined ::= reveal_tops_optional_graveyard "." "if" "you" "don't" "," program

/* The look, optional reveal and move refer to the same single top card. The
   mana value is read from the moved card's before receipt. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:_{instructions:[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:ObjectProperty{object:Query{objects:Transition{result:@marked, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}]}, otherwise:_{}}] */
instructions_look_optional_reveal_hand_value ::= "look" "at" "the" "top" "card" "of" "your" "library" "." "you" "may" "reveal" "that" "card" "and" "put" "it" "into" "your" "hand" "." "if" "you" "do" "," "you" "lose" "life" "equal" "to" "its" "mana" "value"

/* The optional look owns the observation used by both return instructions. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:$look_top}, ...$look_reveal_return]}}] */
clause_optional_look_reveal_return ::= "you" "may" look_top "." "if" "you" "do" "," look_reveal_return

look_reveal_return ::= look_reveal_return_one | look_reveal_return_many

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$card_filter}, count:UpTo($value)}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@back(3)), end:Top, order:Chosen}}, Effect{result:@next, operation:$look_return_rest}] */
look_reveal_return_one ::= "reveal" "up" "to" value card_filter "card" "from" "among" "them" "," "then" "put" "that" "card" "on" "top" "of" "your" "library" "and" look_return_rest

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$card_filter}, count:AnyNumber}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@back(3)), end:Top, order:Chosen}}, Effect{result:@next, operation:$look_return_rest}] */
look_reveal_return_many ::= "reveal" "any" "number" "of" card_filter "cards" "from" "among" "them" "," "then" "put" "those" "cards" "on" "top" "of" "your" "library" "in" "any" "order" "and" look_return_rest

/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order} */
look_return_rest ::= "the" "rest" "on" "the" "bottom" library_order

/* A seek's moved card is the referent of the subsequent temporary grant. */
/* @sem Instruction::[...$clause_seek_card, ...$seek_card_grant] */
clause_seek_card_grant ::= clause_seek_card "." seek_card_grant

/* @sem Instruction::[Effect{result:@next, operation:EffectOn{subject:Objects(One($current_card_ref)), effects:[Term{family:CardEffect, form:AddAbility, operands:[Ability($keyword_warp)]}], until:EndOfTurn}}] */
seek_card_grant ::= current_card_ref "gains" keyword_warp "until" "end" "of" "turn"

/* A face-up exile target is announced before its owner's shuffle. */
/* @sem ObjectSet::InZone{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Exile]}), count:Exactly(Constant(1)), filter:Not(State(FaceDown))}), index:0}), zone:Exile} */
face_up_exile_target ::= "target" "face-up" "exiled" "card"

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$face_up_exile_target, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_choose_exile_owner_shuffle ::= "choose" face_up_exile_target "." "its" "owner" "shuffles" "it" "into" "their" "library"

/* Per-player top slices retain each library owner and exile visibility. */
/* @sem Instruction::[ForEachPlayer{players:$optional_player_population, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}, count:$top_count, from:Top}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
clause_each_exiles_top_down ::= optional_player_population "exiles" "the" "top" top_count "of" "their" "library" "face" "down"

/* The where-definition is the count of each player's own library slice. */
/* @sem Instruction::[ForEachPlayer{players:$optional_player_population, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}, count:$exile_mana_spent, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
clause_each_exiles_top_mana ::= optional_player_population "exiles" "the" "top" "X" "cards" "of" "their" "library" "," "where" "X" "is" exile_mana_spent

/* @sem Expr::ManaSpent{object:$object_ref, filter:SpentManaFilter{}, aggregation:Count} */
exile_mana_spent ::= "the" "amount" "of" "mana" "spent" "to" "cast" object_ref

/* The same library population supplies both operations; the wording names the
   top card of every member and the move preserves face-down visibility. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:$library_tops}}, Effect{result:@next, operation:Move{objects:$library_tops, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
instructions_look_library_tops_exile_down ::= "look" "at" library_tops "and" "exile" "those" "cards" "face" "down"

/* An owner-bound population is shared by the player test and the move. */
/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Attacking, $filter_phrase, OwnedBy(One(Bound(0)))])} */
owned_attacking_population ::= "attacking" filter_phrase

/* @sem Instruction::[ForEachPlayer{players:Matching{binding:0, condition:Compare{left:CountObjects($owned_attacking_population), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:$owned_attacking_population, destination:Library{position:TopOrBottom{chooser:Owners}, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
clause_each_owned_attacker ::= "for" "each" owned_attacking_population "," "its" "owner" "puts" "it" "on" "their" "choice" "of" "the" "top" "or" "bottom" "of" "their" "library"

/* A union of card characteristics, used for a revealed population. */
/* @sem ObjectFilter::AnyOf([$filter_phrase, $filter_phrase_2, $filter_phrase_3]) */
revealed_type_union_three ::= filter_phrase "," filter_phrase "," "and" filter_phrase

/* @sem ObjectFilter::AnyOf([$filter_phrase, $filter_phrase_2, $filter_phrase_3, $filter_phrase_4]) */
revealed_type_union_four ::= filter_phrase "," filter_phrase "," filter_phrase "," "and" filter_phrase

revealed_type_union ::= revealed_type_union_three | revealed_type_union_four

/* This phrase scopes both the shuffle and its per-owner reveal count. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Any, OwnedBy(One(Bound(0)))])}, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}}, ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}, count:CountObjects(Matching{objects:Transition{result:@prior, phase:Before}, filter:OwnedBy(One(Bound(0)))}), from:Top}}}]}}] */
shuffle_owned_then_reveal ::= "each" "player" "shuffles" "all" "permanents" "they" "own" "into" "their" "library" "," "then" "reveals" "that" "many" "cards" "from" "the" "top" "of" "their" "library"

/* The second movement repeats the same player, observed set, and destination. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:AllOf([$revealed_type_union, InSet(Observed(@marked)), OwnedBy(One(Bound(0)))])}, destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}, ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:AllOf([$filter_phrase, InSet(Observed(@marked)), OwnedBy(One(Bound(0)))])}, destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}] */
put_revealed_types_then_same ::= "each" "player" "puts" "all" revealed_type_union "cards" "revealed" "this" "way" "onto" "the" "battlefield" "," "then" "does" "the" "same" "for" filter_phrase "cards"

/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:AllOf([InSet(Observed(@marked)), OwnedBy(One(Bound(0)))])}, destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
put_revealed_remainder_bottom ::= "puts" "all" "cards" "revealed" "this" "way" "that" "weren't" "put" "onto" "the" "battlefield" "on" "the" "bottom" "of" "their" "library" ("in" "any" "order")?

/* @sem Instruction::[...$shuffle_owned_then_reveal, ...$put_revealed_types_then_same, ...$put_revealed_remainder_bottom] */
instructions_shuffle_reveal_types ::= shuffle_owned_then_reveal "." put_revealed_types_then_same "," "then" put_revealed_remainder_bottom

/* The chosen creature type is the filter on the looked-at top card. */
/* @sem ObjectFilter::Chosen(CreatureType) */
top_card_reveal_chosen_type ::= "if" "it's" "a" "card" "of" "the" "chosen" "type" "," "you" "may" "reveal" "it"

/* The permission is tied to the arrival of the singular card selected by
   this search. The shuffle and both receipt identities remain in scope. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$search_single_library}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:$hand_exile_visibility, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:Indefinite, evaluation:LiveObjects}}]} */
program_search_singular_exile_permission ::= search_single_library "," "exile" "it" hand_exile_visibility "," "then" "shuffle" "." "for" "as" "long" "as" "that" "card" "remains" "exiled" "," "you" "may" "play" "it"

/* The observation, optional reveal, hand movement, and value read form one
   scoped top-card contract. The movement receipt supplies the life amount. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:_{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:ObjectProperty{object:Query{objects:Transition{result:@prior, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}]}, otherwise:_{}}] */
instructions_look_optional_reveal_value ::= "look" "at" "the" "top" "card" "of" "your" "library" "." "you" "may" "reveal" "that" "card" "and" "put" "it" "into" "your" "hand" "." "if" "you" "do" "," "you" "lose" "life" "equal" "to" "its" "mana" "value"

/* Keep the mill and its arrival receipt together for both parse and print. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:Move{objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$search_filter_many}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_mill_all_to_hand ::= "mill" card_count "." "put" "all" search_filter_many "from" "among" "them" "into" "your" "hand"

/* Reveal a library slice, move its matching cards, and put the remaining
   observed cards still in that library into their owners' hands. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, Effect{result:@next, operation:Move{objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$filter_phrase}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_reveal_all_battlefield_hand ::= reveal_top "." "put" "all" filter_phrase "cards" "from" "among" "them" "onto" "the" "battlefield" "and" "the" "rest" "into" "your" "hand"

search_plural ::= search_any_number | search_any_nontype | search_fixed_plural | search_basic_land_types

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[SearchChoice{filter:$adjective_nontype, count:AnyNumber}]} */
search_any_nontype ::= "search" "your" "library" "for" "any" "number" "of" adjective_nontype "cards"

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[SearchChoice{filter:Any, count:AsManyAsCan($card_count_many)}]} */
search_fixed_plural ::= "search" "your" "library" "for" card_count_many

/* The singular hand choice can compose with any preceding instruction. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, count:AsManyAsCan($card_count_one)}}, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_shuffle_one_from_hand ::= "shuffle" card_count_one "from" "your" "hand" "into" "your" "library"

/* The draw receipt is scoped to this specific hand-to-bottom producer. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, count:AnyNumber}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_hand_any_number_bottom ::= "put" "any" "number" "of" "cards" "from" "your" "hand" "on" "the" "bottom" "of" "your" "library"

/* @sem Instruction::[...$clause_hand_any_number_bottom, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Add(CountObjects(Transition{result:@prior, phase:Before}), $value)}}] */
clause_hand_bottom_draw_plus ::= clause_hand_any_number_bottom "," "then" "draw" "that" "many" "cards" "plus" value

/* The inspected singleton remains the top of the controller's library until the
   immediately following optional move. Both operations share that object set. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:$own_library_top_card}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:$own_library_top_card, destination:$own_looked_top_destination, qualifiers:[]}}]}}] */
instructions_look_own_optional_move ::= "look" "at" own_library_top_card "." "you" "may" "put" "that" "card" own_looked_top_destination

/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top} */
own_library_top_card ::= "the" "top" "card" "of" "your" "library"

own_looked_top_destination ::= own_looked_top_graveyard | own_looked_top_bottom

/* @sem MovementDestination::OwnersGraveyard(CardArrival{counters:[], states:[]}) */
own_looked_top_graveyard ::= "into" "your" "graveyard"

/* @sem MovementDestination::Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
own_looked_top_bottom ::= "on" "the" "bottom" "of" "your" "library"

/* The search choice carries the selected cards through the battlefield move.
   Each player performs and decides their own search and shuffle. */
/* @sem Instruction::[ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[$each_search_entry_choice]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(Bound(0)), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}]}}] */
each_may_search_then_each_shuffle ::= hand_plural_players "may" "search" "their" "library" "for" each_search_entry_choice search_option_entry "." "then" "each" "player" "who" "searched" "their" "library" "this" "way" "shuffles"

each_search_entry_choice ::= each_search_entry_it | each_search_entry_that | each_search_entry_them

/* @sem $player_search_one_choice */
each_search_entry_it ::= player_search_one_choice "and" "put" "it"

/* @sem $player_search_one_choice */
each_search_entry_that ::= player_search_one_choice "and" "put" "that" "card"

/* @sem $player_search_many_choice */
each_search_entry_them ::= player_search_many_choice "and" "put" "them"

/* A search may relate the color of a found card to a live permanent set. */
/* @sem SearchChoice::SearchChoice{filter:SharesColorWithAny(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}), count:UpTo(Constant(1))} */
search_choice_shared_color ::= "a" "card" "that" "shares" "a" "color" "with" "a" filter_phrase

/* This continuation is tied to an actual land-destruction producer, not
   an arbitrary prior transition. The before receipt preserves controllers. */
/* @sem Instruction::[Effect{result:@mark, operation:Destroy{objects:$destroy_land_population, regeneration:true}}, ForEachPlayer{players:Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:ControlledBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@next, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[_{filter:$filter_phrase, count:UpTo(CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:ControlledBy(One(Bound(0)))}))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}]}}] */
destroy_lands_search_replacement ::= "destroy" destroy_land_population "." "for" "each" "land" "destroyed" "this" "way" "," "its" "controller" "may" "search" "their" "library" "for" "a" filter_phrase "card" "and" "put" "it" "onto" "the" "battlefield" "." "then" "each" "player" "who" "searched" "their" "library" "this" "way" "shuffles"

destroy_land_population ::= destroy_all_lands | destroy_all_nonbasic_lands

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Land)} */
destroy_all_lands ::= "all" "lands"

/* @sem ObjectSet::Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(Supertype(Basic)), CardType(Land)])} */
destroy_all_nonbasic_lands ::= "all" "nonbasic" "lands"

/* Both choices refer to the card established by the adjacent exile-until
   producer; the hand belongs to that card's owner. */
/* @sem Instruction::[...$clause_exile_until_card, ChooseOne{decider:AbilityController, options:[_{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One($exiled_that_card), zone:Exile}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, _{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One($exiled_that_card), zone:Exile}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}]}] */
instructions_exile_until_hand_or_battlefield ::= clause_exile_until_card "." "put" exiled_that_card "onto" "the" "battlefield" "or" "into" "your" "hand"

/* This scope keeps the search, exile arrival and both measured stats together. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_any_number]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}}]}, optional:true}}, If{condition:PaymentChosen(@back(4)), then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($self_explicit_ref)), changes:[SetBasePowerToughness{power:CountObjects(Transition{result:@back(3), phase:After}), toughness:CountObjects(Transition{result:@back(3), phase:After})}], duration:Indefinite, evaluation:Snapshot}}]}, otherwise:_{}}] */
instructions_optional_search_exile_base ::= "you" "may" "search" "your" "library" "for" search_choice_any_number "," "exile" "them" "," "then" "shuffle" "." "if" "you" "do" "," self_explicit_ref "has" "base" "power" "and" "base" "toughness" "each" "equal" "to" "the" "number" "of" "cards" "exiled" "this" "way"

/* The permanent target anchors both the reveal filter and the moved observation. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_permanent), destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:Shares{property:CardTypes, with:$target_permanent}, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:Shares{property:CardTypes, with:$target_permanent}}, destination:$until_destination, qualifiers:[]}}, Effect{result:@next, operation:$rest_bottom}] */
instructions_target_reveal_shared_type ::= "put" target_permanent "on" "the" "bottom" "of" "your" "library" "." "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "a" "card" "that" "shares" "a" "card" "type" "with" "that" "permanent" "." "put" "that" "card" until_destination "and" rest_bottom

/* The selection is bounded to the cards just revealed from this library. The
   remainder is still in that library after the selected cards move. */
/* @sem Instruction::[Group($revealed_type_program)] */
instructions_reveal_type_selection ::= revealed_type_program

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:$reveal_top}, Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:InZone{objects:Observed(@marked), zone:Library}, count:AnyNumber, constraints:[OneForEachCardType(All)]}], action:Move{objects:Prepared(@selection_id(0)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:$library_order}}]} */
revealed_type_program ::= reveal_top "." "for" "each" "card" "type" "," "you" "may" "put" "a" "card" "of" "that" "type" "from" "among" "the" "revealed" "cards" "into" "your" "hand" "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order



/* Keep the observation and immediate move together with its value consumer. */
/* @sem Instruction::[...$reveal_top_hand_that, Effect{result:@next, operation:LoseLife{players:$players_singular, amount:ObjectProperty{object:Query{objects:Observed(0), index:0}, property:ManaValue, information:CurrentOrLastKnown}}}] */
reveal_top_hand_value_loss ::= reveal_top_hand_that "." players_singular "loses" "life" "equal" "to" "that" "card's" "mana" "value"

/* The choice and its inverse are scoped to the controller's immediately preceding mill. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Move{selections:[_{objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase}, choose:Exactly($counter_amount)}], destination:OwnersHand(CardArrival{counters:[], states:[]})}]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:$program, otherwise:Program{}}] */
instructions_mill_payment_milled ::= "mill" card_count "." "you" "may" "put" counter_amount filter_phrase "card" "from" "among" "the" "cards" "milled" "this" "way" "into" "your" "hand" "." "if" "you" "don't" "," program

/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase}, count:Exactly($counter_amount)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:$program, otherwise:Program{}}] */
instructions_mill_payment_them ::= "mill" card_count "." "you" "may" "put" counter_amount filter_phrase "card" "from" "among" "them" "into" "your" "hand" "." "if" "you" "don't" "," program

/* Bind the reveal, matching card and library player in one producer scope. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:$player_ref, filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$card_filter}, destination:Battlefield{controller:Player($player_ref), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($player_ref)}}] */
instructions_player_reveal_until_battlefield_shuffle ::= player_ref "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" "a" card_filter "card" "." "the" "player" "puts" "that" "card" "onto" "the" "battlefield" "," "then" "shuffles" "all" "other" "cards" "revealed" "this" "way" "into" "their" "library"

/* The searcher chooses whether the library is searched; the shuffle is conditional
   on that same search receipt, and the revealed card is the selected object. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:$search_player, library_owner:$search_player, choices:[$search_choice_modified], also:[Graveyard], either:true}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, If{condition:Searched(@marked), then:Program{instructions:[Effect{result:@next, operation:Shuffle{players:One($search_player)}}]}, otherwise:Program{}}] */
clause_player_search_either_reveal_hand ::= search_player "searches" "their" "library" "and" "/" "or" "graveyard" "for" search_choice_modified "," "reveals" "it" "," "and" "puts" "it" "into" "their" "hand" "." "if" "they" "search" "their" "library" "this" "way" "," "they" "shuffle"

/* This target is announced once and remains the graveyard owner in the follow-up. */
/* @sem Instruction::Effect{result:@next, operation:Mill{players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0}), amount:$number}} */
target_opponent_mill_cards ::= "target" "opponent" "mills" number "cards"

/* The choice is from that opponent's entire graveyard, independent of the
   mill receipt. The grant follows the moved object's actual arrival. */
/* @sem Vec<Instruction>::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Graveyard, players:One(Target{slot:0, index:0})}, kind:Card, filter:$noun}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[$graveyard_land_departure_grant], duration:Indefinite, evaluation:Snapshot}}] */
opponent_graveyard_land_grant ::= "put" "a" noun "card" "from" "their" "graveyard" "onto" "the" "battlefield" "tapped" "under" "your" "control" "." "it" "gains" graveyard_land_departure_grant

/* @sem Change::GrantAbility(Replacement{active:Battlefield, event:Object{event:LeavesBattlefield, objects:SameObject(Source)}, body:_{instructions:[Effect{result:@next, operation:ModifyEvent{change:SetDestination(Exile)}}]}}) */
graveyard_land_departure_grant ::= '"' "if" "this" "land" "would" "leave" "the" "battlefield" "," "exile" "it" "instead" "of" "putting" "it" "anywhere" "else" "." '"'

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:_{instructions:[$target_opponent_mill_cards, ...$opponent_graveyard_land_grant]}} */
activated_opponent_mill_graveyard_land_grant ::= cost ":" target_opponent_mill_cards "." opponent_graveyard_land_grant

/* @sem Count::UpTo(@times(Expr::Constant(2), $value)) */
graveyard_up_to_twice ::= "up" "to" "twice" value

/* @sem Count::UpTo(@times($number_words, $value)) */
graveyard_up_to_times ::= "up" "to" number_words "times" value

/* A top-library slice whose X is defined by a live battlefield population.
   The player whose library is used and the counted population are independent. */
/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One($player_possessive)}, kind:Card, filter:Any}, count:$value_number_of, from:$ordered_end} */
library_population_slice ::= "the" ordered_end "X" "cards" "of" player_possessive "library" "," "where" "X" "is" value_number_of

/* @sem Operation::Move{objects:$library_population_slice, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_top_library_population ::= "exile" library_population_slice

/* A paid optional look gates a separate optional move of the same top card. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:LookAt{player:AbilityController, objects:$looked_library_top}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:$looked_library_top, destination:$optional_look_destination, qualifiers:[]}}]}}]}, otherwise:Program{}}] */
instructions_optional_look_move ::= "you" "may" "look" "at" looked_library_top "." "if" "you" "do" "," "you" "may" "put" "that" "card" optional_look_destination

optional_look_destination ::= optional_look_bottom | optional_look_top

/* @sem MovementDestination::Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
optional_look_bottom ::= "on" "the" "bottom" "of" "that" "player's" "library"

/* @sem MovementDestination::Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
optional_look_top ::= "on" "top" "of" "that" "player's" "library"

/* The battlefield follow-up consumes exactly the hand arrival of the seek.
   Keeping the producer in this clause proves the receipt's source and zone. */
/* @sem Instruction::[...$clause_seek_cards, Effect{result:@next, operation:Move{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@prior, phase:After})}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
clause_seek_cards_battlefield ::= clause_seek_cards "and" "put" "them" "onto" "the" "battlefield"

/* The named removal and its seek stay together so the threshold refers to
   the actual study-counter removal, including when no counters were removed. */
/* @sem Instruction::[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:Named(StudyCounter), amount:All}]}}, ...$seek_two_study_threshold] */
remove_study_seek_two ::= "remove" "all" "study" "counters" "from" affected "." seek_two_study_threshold

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:CountersRemoved(@prior)}}])}, count:AsManyAsCan(Constant(2)), constraints:[AtRandom]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
seek_two_study_threshold ::= "seek" "two" filter_phrase "cards" "with" "mana" "value" "less" "than" "or" "equal" "to" "the" "number" "of" "study" "counters" "removed" "this" "way"

/* The pair consumes the hand arrival of that seek; after the first card
   moves, only the remaining arrival can still be in that hand. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@marked, phase:After})}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@marked, phase:After})}, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
seek_pair_battlefield_shuffle ::= "put" "one" "of" "them" "onto" "the" "battlefield" "and" "shuffle" "the" "other" "into" "your" "library"

/* @sem Instruction::[...$remove_study_seek_two, ...$seek_pair_battlefield_shuffle] */
instructions_study_seek_pair ::= remove_study_seek_two "." seek_pair_battlefield_shuffle

/* The search quantity is the before receipt of this exact hand-to-library move.
   The whole sequence stays together so its inverse cannot claim another receipt. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Move{objects:Zone{scope:Players{zone:Hand, players:One($hand_exchange_target)}, kind:Card, filter:Any}, destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:$hand_exchange_target, choices:[_{filter:Any, count:AsManyAsCan(CountObjects(Transition{result:@marked, phase:Before}))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($hand_exchange_target)}}]} */
hand_exchange_search_program ::= hand_exchange_target "puts" "the" "cards" "from" "their" "hand" "on" "top" "of" "their" "library" "." "search" "that" "player's" "library" "for" "that" "many" "cards" "." "that" "player" "puts" "those" "cards" "into" "their" "hand" "," "then" "shuffles" "."

hand_exchange_target ::= target_opponent | target_player

/* Restrict the inverse to activations, preserving spell print choices. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:$hand_exchange_search_program} */
activated_hand_exchange_search ::= cost ":" hand_exchange_search_program

/* The payment receipt determines the size of this library observation. The
   chosen cards and remainder stay tied to that observation and move. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayAnyAmount{actor:One(AbilityController), resource:Mana}}, ...$paid_mana_library_choice]} */
program_paid_mana_library_choice ::= "pay" "any" "amount" "of" "mana" "." paid_mana_library_choice

/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Performed(@prior), from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($number), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:$rest_bottom}] */
paid_mana_library_choice ::= "look" "at" "that" "many" "cards" "from" "the" "top" "of" "your" "library" "," "then" "put" number "of" "those" "cards" "into" "your" "hand" "and" rest_bottom

/* A vote-dependent search and its conditional shuffle are one scoped phrase. */
/* @sem Instruction::[If{condition:Voted(Word($vote_word)), then:_{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:AllOf([Supertype(Basic), $noun]), count:UpTo(Votes(Word($vote_word)))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:_{}}] */
clause_vote_search_tapped ::= "for" "each" vote_word "vote" "," "search" "your" "library" "for" "a" "basic" noun "card" "and" "put" "it" "onto" "the" "battlefield" "tapped" "." "if" "you" "search" "your" "library" "this" "way" "," "shuffle"

/* Both alternatives test the same observed card. */
/* @sem ObjectFilter::AnyOf([$filter_phrase, State(DoubleFaced)]) */
top_reveal_union_double_faced ::= "a" filter_phrase "or" "double-faced" "card"

/* Both actions belong to the owner of the event subject. */
/* @sem Instruction::[Effect{result:@next, operation:LoseLife{players:One(OwnerOf(EventSubject)), amount:$life_phrase}}, Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(OwnerOf(EventSubject))}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
instructions_event_owner_life_exile_top ::= "that" "card's" "owner" "loses" life_phrase "life" "and" "exiles" "the" "top" "card" "of" "their" "library"

/* This choice is from the preceding player's revealed library slice. */
/* @sem Instruction::[Effect{result:@mark, operation:$player_reveals_top}, Effect{result:@next, operation:ChooseObjects{player:OneOf(One(AbilityController)), objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$selected_revealed_card_destination, qualifiers:[]}}] */
instructions_player_reveal_choose_move ::= player_reveals_top "." "you" "choose" "one" "of" "those" "cards" "and" "put" "it" "into" selected_revealed_card_destination

selected_revealed_card_destination ::= selected_revealed_card_graveyard | selected_revealed_card_hand

/* @sem MovementDestination::OwnersGraveyard(CardArrival{counters:[], states:[]}) */
selected_revealed_card_graveyard ::= "their" "graveyard"

/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
selected_revealed_card_hand ::= "their" "hand"

/* Selection and permission refer to the immediately preceding exile. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$ordered_cards, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Transition{result:@prior, phase:After}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:$play_that_card_permission}] */
clause_exile_choose_play ::= "exile" ordered_cards "." "choose" "one" "." play_that_card_permission

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[Loyalty($loyalty)]}, limits:ActivationLimits{sorcery:true}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$operation}, ...$clause_exile_choose_play]}} */
activated_action_exile_choose_play ::= "[" loyalty "]" ":" operation "." clause_exile_choose_play "."

/* A reveal-until selection and its exile arrival retain the same filter. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$reveal_qualified_filter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$reveal_qualified_filter}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[[Named(TimeCounter), $counter_amount]], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:EffectOn{subject:Objects(One(Result{result:@prior, phase:After, index:0})), effects:[Term{family:ExiledCardEffect, form:AddAbilityIfItDoesntHaveIt, operands:[Ability(Mechanic{mechanic:BasicSuspend})]}]}}, Effect{result:@next, operation:$revealed_exile_rest_bottom}] */
instructions_reveal_exile_suspend ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "a" reveal_qualified_filter "." "exile" "that" "card" "with" counter_amount "time" "counters" "on" "it" "." "if" "it" "doesn't" "have" "suspend" "," "it" "gains" "suspend" "." "put" revealed_exile_rest_bottom

/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(3), phase:Before}])}, zone:Library}, end:Bottom, order:$library_order} */
revealed_exile_rest_bottom ::= "the" "rest" "of" "the" "revealed" "cards" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem ObjectFilter::AllOf([ $adjective_nontype, Property{property:ManaValue, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number_digits}} ]) */
reveal_qualified_filter ::= adjective_nontype "card" "with" "mana" "value" number_digits "or" "greater"

/* The look, selection, move, remainder, and permission share the same owner and receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One($look_target_opponent)}, kind:Card, filter:Any}, count:$number, from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:$look_target_opponent, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@back(3), phase:After, index:0}), from:Exile, action:CastSpell, filter:Any}, terms:_{cost:Normal, spend_as:AnyType}})], duration:WhileExiled(Result{result:@back(3), phase:After, index:0}), evaluation:LiveObjects}}] */
instructions_opponent_look_exile_cast ::= "look" "at" "the" "top" number "cards" "of" look_target_opponent "library" "," "exile" "one" "of" "them" "face" "down" "," "then" "put" "the" "rest" "on" "the" "bottom" "of" "that" "library" library_order "." "you" "may" "cast" "that" "card" "for" "as" "long" "as" "it" "remains" "exiled" "," "and" "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "that" "spell"

/* @sem PlayerRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0} */
look_target_opponent ::= "target" "opponent's"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}, count:AsManyAsCan($card_count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
graveyard_cards_to_library_top ::= "put" card_count "from" "your" "graveyard" "on" "top" "of" "your" "library" "in" "any" "order"

/* @sem () */
prior_controller_reveals_until ::= "its" "controller" "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal"

/* @sem Instruction::[Effect{result:@mark, operation:$destroy}, Effect{result:@next, operation:RevealUntil{library:ControllerOf(Result{result:@marked, phase:Before, index:0}), filter:$destroyed_shared_card_filter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@prior), filter:$destroyed_shared_card_filter}, destination:$destroyed_reveal_destination, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:ControllerOf(Result{result:@marked, phase:Before, index:0}), library_owner:ControllerOf(Result{result:@marked, phase:Before, index:0}), objects:InZone{objects:Difference{objects:Observed(@back(3)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
instructions_destroy_reveal_shared ::= destroy "." prior_controller_reveals_until "a" destroyed_shared_card_filter "." "they" "put" "that" "card" destroyed_reveal_destination "and" "the" "rest" "on" "the" "bottom" "of" "their" "library" library_order

/* @sem ObjectFilter::AllOf([AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]), SharesWithAny{property:CardTypes, with:Transition{result:@marked, phase:Before}}]) */
destroyed_shared_card_filter ::= "permanent" "card" "that" "shares" "a" "card" "type" "with" "that" "permanent"

destroyed_reveal_destination ::= destroyed_reveal_battlefield | destroyed_reveal_battlefield_tapped

/* @sem MovementDestination::Battlefield{controller:Player(ControllerOf(Result{result:@marked, phase:Before, index:0})), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
destroyed_reveal_battlefield ::= "onto" "the" "battlefield"

/* @sem MovementDestination::Battlefield{controller:Player(ControllerOf(Result{result:@marked, phase:Before, index:0})), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}} */
destroyed_reveal_battlefield_tapped ::= "onto" "the" "battlefield" "tapped"

/* The two consumers refer to the same singular exile arrival, across the shuffle.
   Keep the producer in the same program as the cast and fallback. */
/* @sem Instruction::[Effect{result:@next, operation:$search_single_library}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:$hand_exile_visibility, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
search_single_exile_shuffle ::= search_single_library "," "exile" "it" hand_exile_visibility "," "then" "shuffle"

/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:One(Result{result:@marked, phase:After, index:0}), filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}}, count:Exactly(Constant(1)), cost:Free}}]}}]}, otherwise:Program{}}, Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
conditional_cast_exiled_or_hand ::= "if" condition "," "you" "may" "cast" "the" "exiled" "card" "without" "paying" "its" "mana" "cost" "if" "that" "spell's" "mana" "value" "is" value "or" "less" "." "put" "the" "exiled" "card" "into" "your" "hand" "if" "it" "wasn't" "cast" "this" "way"

/* @sem Program::Program{instructions:[...$search_single_exile_shuffle, ...$conditional_cast_exiled_or_hand]} */
program_search_exile_conditional_cast ::= search_single_exile_shuffle "." conditional_cast_exiled_or_hand

/* A searched set is revealed before an opponent partitions it.  The explicit
   shapes keep the singular remainder tied to two cards, and the plural
   remainder to the supported larger counts. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$partition_search_script]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:ChooseObjects{player:OneOf(OpponentsOf(AbilityController)), objects:Selected(@marked), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Unselected(@back(3)), destination:OwnersGraveyard(CardArrival{}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}}] */
instructions_optional_search_opponent_partition ::= "you" "may" "search" "your" "library" "for" partition_search_script

partition_search_script ::= partition_search_two | partition_search_many

/* @sem SearchChoice::SearchChoice{filter:Not(Name(@card_name)), count:Exactly($n2), constraints:[DifferentNames]} */
partition_search_two ::= "exactly" n2 "cards" "not" "named" SELF_NAME "that" "have" "different" "names" partition_search_one_remainder

/* @sem SearchChoice::SearchChoice{filter:Not(Name(@card_name)), count:Exactly($partition_search_many_count), constraints:[DifferentNames]} */
partition_search_many ::= "exactly" partition_search_many_count "cards" "not" "named" SELF_NAME "that" "have" "different" "names" partition_search_many_remainder

partition_search_many_count ::= n3 | n4

/* @sem () */
partition_search_one_remainder ::= partition_search_choose_one "and" "the" "other" "into" "your" "graveyard" "," "then" "shuffle"

/* @sem () */
partition_search_many_remainder ::= partition_search_choose_one "and" "the" "other" "cards" "into" "your" "graveyard" "," "then" "shuffle"

/* @sem () */
partition_search_choose_one ::= "." "if" "you" "do" "," "reveal" "those" "cards" "." "an" "opponent" "chooses" "one" "of" "them" "." "put" "the" "chosen" "card" "into" "your" "hand"

/* Reveal-until phrases share the library owner independently from the
   qualifying card and amount. The prior-result form follows a movement. */
reveal_until_operation ::= reveal_until_other_one | reveal_until_other_many | reveal_until_your_one | reveal_until_chosen_name | reveal_until_qualified_card | reveal_until_shared_type | reveal_until_chosen_creature_type

/* @sem Operation::RevealUntil{library:$reveal_until_named_prefix, filter:$reveal_until_filter, count:$counter_amount} */
reveal_until_other_one ::= reveal_until_named_prefix counter_amount reveal_until_filter "card"

/* @sem Operation::RevealUntil{library:$reveal_until_other_library, filter:$reveal_until_filter, count:$value} */
reveal_until_other_many ::= reveal_until_other_library "until" value reveal_until_filter "cards" "are" "revealed"

/* @sem Operation::RevealUntil{library:AbilityController, filter:$reveal_until_filter, count:$counter_amount} */
reveal_until_your_one ::= reveal_until_it_library counter_amount reveal_until_filter "card"

/* @sem Operation::RevealUntil{library:AbilityController, filter:$reveal_until_card_quality, count:$card_count} */
reveal_until_chosen_name ::= reveal_until_your_library card_count reveal_until_card_quality

/* @sem Operation::RevealUntil{library:$reveal_until_other_prefix, filter:$reveal_until_card_quality, count:$card_count} */
reveal_until_qualified_card ::= reveal_until_other_prefix card_count reveal_until_card_quality

/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:Add([$value, ObjectProperty{object:Query{objects:CostObjects{payment:Activation, component:[2], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown}])}} */
reveal_until_mana_quality ::= "with" "mana" "value" "equal" "to" value "plus" "the" "exiled" "spell's" "mana" "value"

reveal_until_card_quality ::= reveal_until_mana_quality | reveal_until_name_quality

/* @sem ObjectFilter::Chosen(CardName) */
reveal_until_name_quality ::= "with" "the" "chosen" "name"

/* @sem Operation::RevealUntil{library:$reveal_until_prior_prefix, filter:$reveal_until_shared_type_filter, count:Constant(1)} */
reveal_until_shared_type ::= reveal_until_prior_prefix "a" reveal_until_shared_type_filter

/* @sem ObjectFilter::AllOf([AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]), SharesWithAny{property:CardTypes, with:Transition{result:@prior, phase:Before}}]) */
reveal_until_shared_type_filter ::= "permanent" "card" "that" "shares" "a" "card" "type" "with" "that" "permanent"

/* @sem $reveal_until_other_library */
reveal_until_other_prefix ::= reveal_until_other_library "until" "they" "reveal"

reveal_until_other_library ::= reveal_until_named_library

/* @sem $reveal_until_named_player */
reveal_until_named_library ::= reveal_until_named_player "reveals" "cards" "from" "the" "top" "of" "their" "library"

reveal_until_named_player ::= mined_player | target_player | target_opponent | that_player | defending_player | its_owner | target_player_dealt | stack_controller | history_damage_controller | explicit_object_controller | explicit_object_owner

/* @sem $reveal_until_named_library */
reveal_until_named_prefix ::= reveal_until_named_library "until" "they" "reveal"

/* @sem $reveal_until_prior_library */
reveal_until_prior_prefix ::= reveal_until_prior_library "until" "they" "reveal"

/* @sem PlayerRef::ControllerOf(Result{result:@prior, phase:Before, index:0}) */
reveal_until_prior_library ::= "its" "controller" "reveals" "cards" "from" "the" "top" "of" "their" "library"

reveal_until_your_prefix ::= reveal_until_your_library | reveal_until_it_library

/* @sem () */
reveal_until_your_library ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal"

/* @sem () */
reveal_until_it_library ::= "reveal" "cards" "from" "the" "top" "of" "it" "until" "you" "reveal"

reveal_until_filter ::= filter_phrase | adjective_nontype

/* An opponent chooses an observed card; its later move and remainder share the
   same observed library slice as other reveal-and-take instructions. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$dig_opponent_choice, $dig_rest_and] */
dig_reveal_opponent_choice ::= reveal_top "." dig_opponent_choice dig_rest_and

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:OneOf(OpponentsOf(AbilityController)), objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$a_card}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}] */
dig_opponent_choice ::= "an" "opponent" "chooses" a_card "from" "among" "them" "." "put" "that" "card" dig_destination

/* Selection by keyword is kept separate from the disposition of the chosen
   and unchosen observed cards. Each listed keyword names one choice class. */
/* @sem Instruction::Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:UpTo(Constant(12)), constraints:[OneForEach([HasKeyword($keyword_name), HasKeyword($keyword_name_2), HasKeyword($keyword_name_3), HasKeyword($keyword_name_4), HasKeyword($keyword_name_5), HasKeywordFamily(Hexproof), HasKeyword($keyword_name_6), HasKeyword($keyword_name_7), HasKeyword($keyword_name_8), HasKeyword($keyword_name_9), HasKeyword($keyword_name_10), HasKeyword($keyword_name_11)])]}} */
dig_choose_keyword_classes ::= "choose" "from" "among" "them" "a" "card" "with" keyword_name "," "a" "card" "with" keyword_name "," "and" "so" "on" "for" keyword_name "," keyword_name "," keyword_name "," "hexproof" "," keyword_name "," keyword_name "," keyword_name "," keyword_name "," keyword_name "," "and" keyword_name

/* The first destination constrains the selection; the second receives the other
   selected cards, and the remainder excludes both actual move receipts. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Selected(@prior), count:AsManyAsCan($number), constraints:[CanMoveTo{destination:$dig_destination}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Difference{objects:Selected(@back(4)), excluding:Selected(@back(3))}, destination:$until_hand, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(3), phase:Before}, Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
dig_distribute_chosen ::= "put" number "of" "the" "chosen" "cards" dig_destination "," "the" "other" "chosen" "cards" until_hand "," "and" "the" "rest" "into" "your" "graveyard"

/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, $dig_choose_keyword_classes, ...$dig_distribute_chosen] */
dig_reveal_keyword_distribution ::= reveal_top "." dig_choose_keyword_classes "." dig_distribute_chosen

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AnyNumber}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:@that_player, objects:Selected(@prior), end:Bottom, order:Chosen}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:@that_player, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Top, order:Chosen}}] */
foreign_look_reorder_split ::= "put" "any" "number" "of" "them" "on" "the" "bottom" "of" "that" "library" "in" "any" "order" "and" "the" "rest" "on" "top" "of" "the" "library" "in" "any" "order"

/* The library owner and the observed slice are shared across this split. */
/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One($target_possessive)}, kind:Card, filter:Any}, count:$top_count, from:Top}}}, ...$foreign_look_reorder_split] */
instructions_foreign_look_split ::= "look" "at" "the" "top" top_count "of" target_possessive "library" "." foreign_look_reorder_split

/* A private choice among independently eligible top-card moves.  The preceding
   look fixes the library and the card; declining all three leaves it in place. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[_{instructions:$top_card_put_action}, _{instructions:$top_card_reveal_action}, _{instructions:$top_card_graveyard_action}, _{}]}] */
top_card_private_choice ::= top_card_put_action "." top_card_reveal_action "." top_card_graveyard_action

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
top_card_graveyard_action ::= "otherwise" "," "you" "may" "put" "it" "into" "your" "graveyard"

/* @sem Program::Program{instructions:[...$top_card_look, ...$top_card_private_choice]} */
top_card_private_choice_program ::= top_card_look top_card_private_choice "."

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:$top_card_private_choice_program} */
activated_top_card_private_choice ::= cost ":" top_card_private_choice_program

/* The matching card and shuffle are scoped to this reveal-until producer. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:AllOf([$filter_phrase, Chosen(CreatureType)]), count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:AllOf([$filter_phrase, Chosen(CreatureType)])}, destination:$until_destination, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
reveal_chosen_type_shuffle_rest ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "a" filter_phrase "card" "of" "that" "type" "." "put" "that" "card" until_destination "and" "shuffle" "the" "rest" "into" "your" "library"

/* Piles use the immediately preceding top-library exile receipt.  The outer
   production fixes that producer so inverse printing cannot attach this text
   to an unrelated transition. */
/* @sem Vec<Instruction>::[Effect{result:@next, operation:SeparatePiles{separator:OneOf(OpponentsOf(AbilityController)), chooser:AbilityController, objects:Zone(_{scope:Shared(Exile), kind:Card, filter:InSet(Transition{result:@marked, phase:After})})}}, Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:Either, cards:Matching{objects:Selected(@prior), filter:AnyOf([$filter_plural, Any])}, count:AnyNumber, terms:_{cost:Free}}}] */
exiled_piles_free_play ::= "an" "opponent" "separates" "those" "cards" "into" "two" "piles" "." "you" "may" "play" filter_plural "and" "cast" "spells" "from" "one" "of" "those" "piles" "." "if" "you" "cast" "a" "spell" "this" "way" "," "you" "cast" "it" "without" "paying" "its" "mana" "cost"

/* @sem Instruction::[Effect{result:@mark, operation:$exile_top_cards_of_your_library}, ...$exiled_piles_free_play] */
instructions_exile_top_piles_free_play ::= exile_top_cards_of_your_library "." exiled_piles_free_play

/* The observation and split share the same marked receipt in both directions. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$look_put_split] */
look_instead_put_split ::= look_top "instead" "." look_put_split

/* Filtered cards come from this reveal, and the rest excludes the actual move. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, Effect{result:@next, operation:Move{objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$noun}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:$rest_bottom}] */
reveal_matching_hand_rest ::= reveal_top "." "put" "all" noun "cards" "revealed" "this" "way" "into" "your" "hand" "and" rest_bottom

/* The singular receipt also owns the duration and the mana-spending term. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_possessive)}, kind:Card, filter:Any}, count:Constant(1), from:$ordered_end}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:One(Result{result:@marked, phase:After, index:0}), audience:AffectedPlayer}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:Either, filter:Any}, terms:_{cost:Normal, spend_as:AnyColor}})], duration:WhileExiled(Result{result:@marked, phase:After, index:0}), evaluation:LiveObjects}}] */
instructions_exiled_hidden_one_play ::= "exile" "the" ordered_end "card" "of" player_possessive "library" "face" "down" "." "you" "may" "look" "at" "and" "play" "that" "card" "for" "as" "long" "as" "it" "remains" "exiled" "," "and" "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "that" "spell"

/* Keep the singleton exile producer and its permission in the same print scope. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$exile_top_card_named}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:$exiled_play_action, filter:Any}, terms:_{cost:Normal, spend_as:$exiled_spending}})], duration:WhileExiled(Result{result:@prior, phase:After, index:0}), evaluation:LiveObjects}}] */
clause_exile_top_while_exiled_spending ::= exile_top_card_named "." "you" "may" exiled_play_action "that" "card" "for" "as" "long" "as" "it" "remains" "exiled" "," "and" exiled_spending

/* The chosen type qualifies the revealed card independently of its card filter. */
/* @sem ObjectFilter::AllOf([$filter_phrase, Chosen(CreatureType)]) */
reveal_card_of_chosen_creature_type ::= filter_phrase "card" "of" "that" "type"

/* @sem Operation::RevealUntil{library:AbilityController, filter:$reveal_card_of_chosen_creature_type, count:$counter_amount} */
reveal_until_chosen_creature_type ::= reveal_until_your_library counter_amount reveal_card_of_chosen_creature_type

/* A bound player reveals through the matching card and exiles the observed cards. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:Bound(0), filter:$adjective_nontype, count:$counter_amount}}, Effect{result:@next, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
bound_exile_until_card ::= "exiles" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "exile" counter_amount adjective_nontype "card"

/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[...$bound_exile_until_card]}}] */
clause_players_exile_until_card ::= players_singular bound_exile_until_card

/* The alternate discard payment belongs to the cast of the card selected by the
   preceding exile-until instruction. The discarded amount is independent. */
/* @sem Operation::PlayWith{actor:One(AbilityController), action:CastSpell, cards:One($exiled_that_card), count:Exactly(Constant(1)), terms:_{cost:Alternate(Cost{parts:[Discard{count:$exile_discard_count, filter:Any}]})}} */
cast_exiled_card_discard ::= "cast" exiled_that_card "by" "discarding" exile_discard_count "rather" "than" "paying" "its" "mana" "cost"

exile_discard_count ::= exile_discard_one | exile_discard_many

/* @sem Expr::Constant(1) */
exile_discard_one ::= ("a" | "one") "card"

/* @sem $number_words */
exile_discard_many ::= number_words "cards"

/* @sem Instruction::[...$clause_exile_until_card, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$cast_exiled_card_discard}]}}] */
instructions_exile_until_discard_cast ::= clause_exile_until_card "." "you" "may" cast_exiled_card_discard

/* Restrictions on a searched card compose with ordinary search continuations. */
/* @sem SearchChoice::SearchChoice{filter:$a_card_basic_type, count:UpTo(Constant(1))} */
search_choice_basic_land_type ::= a_card_basic_type

/* @sem SearchChoice::SearchChoice{filter:AllOf([$card_filter, CouldEnchant(Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase})]), count:UpTo(Constant(1))} */
search_choice_enchant_host ::= "an" card_filter "card" "with" "enchant" filter_phrase

/* Search constraints remain attached to the choice through its follow-ups. */
/* @sem SearchChoice::SearchChoice{filter:SharesNameWith($object_ref), count:UpTo($card_count)} */
search_choice_same_name ::= "up" "to" card_count "with" "the" "same" "name" "as" object_ref

/* @sem SearchChoice::SearchChoice{filter:AllOf([$filter_phrase, $modifier_not_named_self]), count:UpTo($value), constraints:[DifferentNames]} */
search_choice_distinct_not_self ::= "up" "to" value filter_phrase "cards" modifier_not_named_self "that" "each" "have" "different" "names"

/* Plural selections retain plural anaphors in every follow-up. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_constrained_plural}, ...$search_plural_follow] */
clause_search_constrained_plural ::= search_constrained_plural search_plural_follow

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$constrained_plural_choice]} */
search_constrained_plural ::= "search" "your" "library" "for" constrained_plural_choice

constrained_plural_choice ::= search_choice_same_name | search_choice_distinct_not_self

/* The selection is restricted to the arrivals of this exact library-exile action. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:Move{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_phrase, InSet(Transition{result:@prior, phase:After})])}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
instructions_exile_top_put_matching ::= exile_top_cards_of_your_library "." "put" "all" filter_phrase "cards" "from" "among" "them" "onto" "the" "battlefield"

/* A revealed slice, two independently selected categories, and their remaining cards.
   Both departures belong to this observation and to the same destination. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$dig_two_entries, $dig_two_entries_rest] */
dig_reveal_two_entries ::= reveal_top "." dig_two_entries "." dig_two_entries_rest

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$filter_phrase}, count:UpTo($counter_amount), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, filter:$filter_phrase_2}, count:UpTo($counter_amount_2), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
dig_two_entries ::= "you" "may" "put" counter_amount filter_phrase "card" "and" "/" "or" counter_amount filter_phrase "card" "from" "among" "them" "onto" "the" "battlefield"

/* @sem Instruction::Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(3), phase:Before}, Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}} */
dig_two_entries_rest ::= "put" "the" "rest" "on" "the" "bottom" library_order

/* Keep the departure and the explicit battlefield remainder in one scope. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$dig_entry_take, $dig_entry_remainder] */
dig_reveal_entry_remainder ::= reveal_top "." dig_entry_take "." dig_entry_remainder

/* @sem Instruction::Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}} */
dig_entry_remainder ::= "then" "put" "all" "cards" "revealed" "this" "way" "that" "weren't" "put" "onto" "the" "battlefield" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$revealed_plural_filter}, count:AnyNumber, constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
dig_entry_take ::= "you" "may" "put" "any" "number" "of" revealed_plural_filter "from" "among" "them" "onto" "the" "battlefield"

/* A negative test reverses the branches, keeping each branch under the same
   single-card observation. A following grant refers to the moved incarnation. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:$observed_reveal_entry_grant}, otherwise:Program{instructions:$observed_top_reveal_put}}] */
instructions_top_reveal_unless_entry ::= "reveal" "the" "top" "card" "of" "your" "library" "." "if" "it" "isn't" top_reveal_quality "," observed_top_reveal_put "." "otherwise" "," observed_reveal_entry_grant

/* @sem Instruction::[...$observed_reveal_battlefield, ...$entered_creature_grant_sacrifice] */
observed_reveal_entry_grant ::= observed_reveal_battlefield "." entered_creature_grant_sacrifice

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Observed(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
observed_reveal_battlefield ::= "put" "that" "card" "onto" "the" "battlefield"

/* Adjacent look and exile share the exact singular top-of-library query. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}, Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
instructions_look_own_top_exile_then ::= "look" "at" "the" "top" "card" "of" "your" "library" "," "then" "exile" "it" "face" "down"

/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:$look_top_exile_destination, qualifiers:[]}}]}}] */
instructions_look_own_top_exile_optional ::= "look" "at" "the" "top" "card" "of" "your" "library" "." "you" "may" look_top_exile_destination

look_top_exile_destination ::= look_top_exile_face_down | look_top_exile_face_up

/* @sem MovementDestination::Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}} */
look_top_exile_face_down ::= "exile" "it" "face" "down"

/* @sem MovementDestination::Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}} */
look_top_exile_face_up ::= "exile" "that" "card"

/* The permission consumes the immediately preceding top-of-library exile. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:Either, filter:Any})], duration:$duration, evaluation:LiveObjects}}] */
clause_top_exile_play_receipt ::= exile_top_cards_of_your_library "." duration "," "you" "may" "play" "cards" "exiled" "this" "way"

/* @sem Instruction::[Effect{result:@next, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:CastSpell, filter:AnyOf([CardType(Instant), CardType(Sorcery)])}, terms:_{cost:Free}})], duration:$this_duration, evaluation:LiveObjects}}] */
clause_top_exile_cast_receipt ::= exile_top_cards_of_your_library "." "you" "may" "cast" "instant" "and" "sorcery" "spells" "from" "among" "them" this_duration "without" "paying" "their" "mana" "costs"

/* The singleton permission follows this exact top-card exile. */
/* @sem Instruction::[Effect{result:@next, operation:$shuffle_your_library}, Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:Either, filter:Any}, terms:_{cost:Free}})], duration:$duration, evaluation:LiveObjects}}] */
clause_top_card_exile_free_play ::= shuffle_your_library "," "then" "exile" "the" "top" "card" "." duration "," "you" "may" "play" "that" "card" "without" "paying" "its" "mana" "cost"

/* The observed cards are the immediately preceding top-of-library reveal.
   The singular choice supplies the selected card for the following move. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, Effect{result:@next, operation:ChooseObjects{player:OneOf($players_singular), objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_reveal_opponent_choice_graveyard ::= reveal_top "." players_singular "chooses" "one" "of" "those" "cards" "." "put" "that" "card" "into" "your" "graveyard"

/* The reveal receipt is consumed by the following owner-graveyard moves. */
/* @sem Instruction::[Effect{result:@mark, operation:EachPlayer{players:$players_singular, action:RevealUntil{library:Acting, filter:$card_filter, count:$number}}}, ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:Move{objects:AnyZone(InSet(Recorded(@marked))), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
instructions_each_reveal_until_graveyard ::= players_singular "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" number card_filter "cards" "," "then" "puts" "all" "cards" "revealed" "this" "way" "into" "their" "graveyard"

/* The casting restriction precedes the instructions in the spell IR. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:LimitX{test:Compare{comparison:Greater, value:Constant(0)}}}, ...$instructions]}} */
spell_instructions_positive_x ::= instructions "." "x" "can't" "be" "0" "."

/* A choice from your hand moves into your shuffled library. The move receipt
   remains available to an ordinary following instruction. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$shuffle_hand_card_kind}, count:$shuffle_hand_count}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_shuffle_hand_choice ::= "shuffle" shuffle_hand_count shuffle_hand_card_kind "from" "your" "hand" "into" "your" "library"

/* @sem Count::AnyNumber */
shuffle_hand_any_count ::= "any" "number" "of"

/* @sem Count::UpTo($count_plural) */
shuffle_hand_up_to_count ::= "up" "to" count_plural

shuffle_hand_count ::= shuffle_hand_any_count | shuffle_hand_up_to_count

/* @sem ObjectFilter::Any */
shuffle_hand_any_cards ::= "cards"

/* @sem $card_filter */
shuffle_hand_filtered_cards ::= card_filter "cards"

shuffle_hand_card_kind ::= shuffle_hand_any_cards | shuffle_hand_filtered_cards

/* The observation is bound by the adjacent reveal, and both consumers use it. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:LibraryTops(All)}}, Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:CopyEach{objects:Zone{scope:Players{zone:Library, players:All}, kind:Card, filter:AllOf([$filter_phrase, InSet(Observed(@marked))])}, exceptions:$revealed_copy_exceptions}}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$filter_phrase_2}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}, then:$then_condition_program, otherwise:Program{}}] */
instructions_reveal_tops_copy_if_none ::= "each" "player" "reveals" "the" "top" "card" "of" "their" "library" "." "for" "each" filter_phrase "card" "revealed" "this" "way" "," "create" "a" "token" "that's" "a" "copy" "of" "that" "card" "," "except" revealed_copy_exceptions "." "if" "no" filter_phrase "cards" "were" "revealed" "this" "way" "," then_condition_program

/* The copy's characteristic exceptions retain their independently printed operands. */
/* @sem Vec<CopyException>::[$revealed_copy_stats, $copy_add_creature_type, $copy_keyword_ability] */
revealed_copy_exceptions ::= revealed_copy_stats "," copy_add_creature_type "," "and" copy_keyword_ability

/* @sem CopyException::SetPowerToughness{power:$value, toughness:$value_2} */
revealed_copy_stats ::= "it's" value "/" value

/* A plural subject governs two independent player actions, followed by an
   exile from each player's own library. The repeated population binds all
   three actions while the library owner stays local to the loop. */
/* @sem Instruction::[Effect{result:@next, operation:@apply($optional_player_population, $verb_operation_third)}, Effect{result:@next, operation:@apply($optional_player_population, $verb_operation_third_2)}, ForEachPlayer{players:$optional_player_population, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}, count:$top_count, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
clause_plural_verbs_exile_tops ::= optional_player_population verb_operation_third "," verb_operation_third "," "and" "exiles" "the" "top" top_count "of" "their" "library"

/* A whole opposing hand is observed before choosing from that same owner's
   hand. The observed receipt and owner guard preserve the immediate choice. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0})}, kind:Card, filter:Any}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(2)), zone:Hand}, filter:@and($adjective_nontype, ObjectFilter::OwnedBy(One(Target{slot:0, index:0})))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_revealed_opponent_hand_exile_one ::= "target" "opponent" "reveals" "their" "hand" "." "you" "choose" "a" adjective_nontype "card" "from" "it" "and" "exile" "that" "card"

/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0})}, kind:Card, filter:Any}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(2)), zone:Hand}, filter:@and($adjective_nontype, ObjectFilter::OwnedBy(One(Target{slot:0, index:0})))}, count:AsManyAsCan(AnnouncedX)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_revealed_opponent_hand_exile_x ::= "target" "opponent" "reveals" "their" "hand" "." "you" "choose" "up" "to" "X" adjective_nontype "cards" "from" "it" "and" "exile" "them"

/* This continuation is available only after the single-card exile producer;
   its same-name reference is the producer's recorded result. */
/* @sem Instruction::[...$clause_revealed_opponent_hand_exile_one, If{condition:$condition_card_types_graveyard, then:Program{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:Target{slot:0, index:0}, choices:[_{filter:SharesNameWith(Result{result:@prior, phase:After, index:0}), count:AnyNumber}], also:[Graveyard, Hand]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Target{slot:0, index:0})}}]}, otherwise:Program{}}] */
instructions_revealed_hand_exile_same_name ::= clause_revealed_opponent_hand_exile_one "." NEWLINE "if" condition_card_types_graveyard "," "search" "that" "player's" "graveyard" "," "hand" "," "and" "library" "for" "any" "number" "of" "cards" "with" "the" "same" "name" "as" "the" "exiled" "card" "," "exile" "those" "cards" "," "then" "that" "player" "shuffles"

/* The mill and its optional selection share the same recorded arrival, even
   across the intervening operation. The enclosing rule proves the producer. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:$milled_intervening_operation}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$milled_choice_filter}, count:Exactly(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
instructions_mill_intervening_take ::= "mill" card_count "," "then" milled_intervening_operation "." "you" "may" "put" ("an" | "a") milled_choice_filter "card" "from" "among" "the" "milled" "cards" "into" "your" "hand"

/* @sem ObjectFilter::AnyOf([$subtype, $noun]) */
milled_choice_filter ::= subtype "or" noun

/* @sem Operation::EffectOn{subject:Objects(AnyZone(AllOf([$noun, InZone(Players{zone:Graveyard, players:One(AbilityController)})]))), effects:[Term{family:PerpetualEffect, form:AdjustPT, operands:[Integer($number), Integer($number_2)]}]} */
milled_intervening_operation ::= "each" noun "card" "in" "your" "graveyard" "perpetually" "gets" "+" NUMBER "/" "+" NUMBER

/* This complete span ties the observed library tops, their test, and the
   per-player moves together. No other reveal can supply its antecedent. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:LibraryTops($optional_player_population)}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:Not($card_filter)}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}, then:Program{instructions:[ForEachPlayer{players:$optional_player_population, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}]}, otherwise:Program{}}] */
instructions_revealed_tops_all_put ::= optional_player_population "reveals" "the" "top" "card" "of" "their" "library" "." "if" "all" "cards" "revealed" "this" "way" "are" card_filter "cards" "," "put" "those" "cards" "onto" "the" "battlefield" "under" "their" "owners'" "control"

/* The target owner remains the library owner and actor of the follow-up. */
/* @sem Operation::Move{objects:One($target_permanent), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
owner_shuffles_target ::= "the" "owner" "of" target_permanent "shuffles" "it" "into" "their" "library"

/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(OwnerOf(Target{slot:@last_slot, index:0}))}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, Effect{result:@next, operation:MoveTopCard{actor:One(OwnerOf(Target{slot:@last_slot, index:0})), cards:$card_filter, reveal:false, destination:$top_card_battlefield}}] */
owner_reveal_top_conditional_entry ::= "then" "reveals" "the" "top" "card" "of" "their" "library" "." "if" "it's" "a" card_filter "card" "," "they" "put" "it" top_card_battlefield

/* @sem Instruction::[Effect{result:@next, operation:$owner_shuffles_target}, ...$owner_reveal_top_conditional_entry] */
instructions_owner_shuffle_top_entry ::= owner_shuffles_target "," owner_reveal_top_conditional_entry

/* The final shuffle refers to the search within this same optional loop. */
/* @sem Instruction::[ForEachPlayer{players:$players_control_threshold_fewer, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[$search_difference_choice]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}]}}] */
each_threshold_search_difference ::= players_control_threshold_fewer "may" "search" "their" "library" "for" search_difference_choice "." "then" "each" "player" "who" "searched" "their" "library" "this" "way" "shuffles"

/* @sem SearchChoice::SearchChoice{filter:$filter_phrase, count:UpTo(Subtract($value, CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])})))} */
search_difference_choice ::= "up" "to" "X" filter_phrase "cards" "and" "put" "them" "onto" "the" "battlefield" "," "where" "X" "is" value "minus" "the" "number" "of" filter_plural "they" "control"

/* Keep the random selection, hand arrival, and its perpetual recipient together. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$a_card}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@marked, phase:After, index:0}), changes:$seek_perpetual_changes}}] */
seek_perpetual_instruction ::= "seek" a_card "." "that" "card" "perpetually" seek_perpetual_changes

/* @sem Change::[GrantKeyword($keyword_value), GrantAbility(Casting(ReduceCost([_{amount:$braced_amount}]))), GrantAbility(@scope(Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$program}))] */
seek_perpetual_changes ::= "gains" keyword_value "," '"' "this" "spell" "costs" braced_amount "less" "to" "cast" "," '"' "and" '"' "at" turn_event "," program "." '"'

/* The reveal and both uses of its observation are one producer contract. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Observed(@marked), filter:$card_filter}, count:UpTo(Constant(1)), cost:Free}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:Random}}]} */
reveal_until_cast_remainder ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "a" card_filter "card" "." "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" "." "then" "put" "all" "revealed" "cards" "not" "cast" "this" "way" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$operation}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:$reveal_until_cast_remainder, otherwise:Program{}}] */
optional_action_reveal_followup ::= "you" "may" operation "." "if" "you" "do" "," reveal_until_cast_remainder

/* The selected cards remain linked to the immediately enclosing search. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
search_selected_it_to_hand_shuffle ::= "put" "it" "into" "your" "hand" "," "then" "shuffle"

/* Seek a filtered quantity, with a separate property constraint and its hand arrival. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:@and($seek_value_kind, $modifier_mana_value_exact)}, count:$seek_plural_count, constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_seek_value_cards ::= "seek" seek_plural_count seek_value_kind "cards" modifier_mana_value_exact

seek_value_kind ::= seek_value_instant_sorcery | filter_phrase

/* @prefer always */
/* @sem ObjectFilter::AnyOf([CardType(Instant), CardType(Sorcery)]) */
seek_value_instant_sorcery ::= "instant" "and" "/" "or" "sorcery"

/* The hand arrival of the qualified seek is the exact input to exile. */
/* @sem Instruction::[...$clause_seek_value_cards, Effect{result:@next, operation:Move{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@prior, phase:After})}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}] */
clause_seek_value_exile ::= clause_seek_value_cards "," "then" "exile" "them"

/* The selected hand cards establish the receipt used by the replacement and return. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$hand_exile_card_filter}, count:AnyNumber}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:$hand_exile_visibility, arrival:ExileArrival{}}, qualifiers:[]}}] */
hand_selection_exile ::= "exile" "any" "number" "of" hand_exile_card_filter "from" "your" "hand" hand_exile_visibility

/* This continuation is only exposed inside the producer scope below. */
/* @sem Vec<Instruction>::[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:CountObjects(InZone{objects:Transition{result:@marked, phase:Before}, zone:Hand}), from:Top}, destination:OwnersHand(CardArrival{}), qualifiers:[]}}, Effect{result:@next, operation:LookAt{player:AbilityController, objects:Transition{result:@marked, phase:After}}}, Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{}}, qualifiers:[]}}] */
hand_exile_replace_return ::= "put" "that" "many" "cards" "from" "the" "top" "of" "your" "library" "into" "your" "hand" "." "then" "look" "at" "the" "exiled" "cards" "and" "put" "them" "on" "top" "of" "your" "library" "in" "any" "order"

/* The full contract binds both count and exiled cards to this hand movement. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[...$hand_selection_exile, ...$hand_exile_replace_return]}} */
activated_hand_exile_replace ::= cost ":" hand_selection_exile "." hand_exile_replace_return "."

/* The enclosing trigger keeps its event independent of the seek's filter. */
/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[...$clause_seek_value_exile]}} */
triggered_seek_value_exile ::= event_clause "," clause_seek_value_exile "."

/* The play permission refers specifically to the immediately preceding exile. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}] */
clause_exile_top_play_cards ::= exile_top_cards_of_your_library "." "you" "may" "play" "those" "cards" this_duration

/* The payment and its seek share a single receipt; the seek's hand arrival
   supplies the immediately following perpetual change. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:Add(ObjectProperty{object:Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0}, property:ManaValue, information:CurrentOrLastKnown}, $value)}}])}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:@seek_move_result(Operation::Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]})}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$static_changes}}] */
paid_seek_mana_perpetual ::= "seek" "a" card_filter "card" "with" "mana" "value" "equal" "to" "the" "mana" "value" "of" "that" "card" "plus" value "." "that" "card" "perpetually" static_changes

/* @sem Cost::Cost{parts:[Move{selections:[_{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:UpTo(Constant(1)), filter:AllOf([$card_filter, InZone(Players{zone:Graveyard, players:One(AbilityController)})])})), choose:Exactly(Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]} */
paid_exile_graveyard_target ::= "exile" "up" "to" "one" "target" card_filter "card" "from" "your" "graveyard"

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$paid_exile_graveyard_target, optional:false}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$paid_seek_mana_perpetual}, otherwise:Program{}}] */
clause_paid_exile_seek_perpetual ::= paid_exile_graveyard_target "." "if" "you" "do" "," paid_seek_mana_perpetual

/* A single scoped look, choice, exile, remainder and cast contract retains
   both the observed population and the specific exile receipt. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:EventAmount, from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:$adjective_nontype}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Random}}, Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Result{result:@back(3), phase:After, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}]} */
combat_look_exile_cast_program ::= "look" "at" "that" "many" "cards" "from" "the" "top" "of" "your" "library" "." "exile" "up" "to" "one" adjective_nontype "card" "from" "among" "them" "and" "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order" "." "you" "may" "cast" "the" "exiled" "card" "without" "paying" "its" "mana" "cost" "."

/* This phrase binds the permission to the immediately preceding exile. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:EventAmount, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:Either, filter:Any})], duration:UntilEndOfNextTurn(AbilityController), evaluation:LiveObjects}}]} */
combat_exile_play_program ::= "exile" "that" "many" "cards" "from" "the" "top" "of" "your" "library" "." "until" "the" "end" "of" "your" "next" "turn" "," "you" "may" "play" "those" "cards" "."

/* Three independently described finds share the same search receipt. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_filtered, $search_choice_filtered_2, $search_choice_filtered_3]} */
search_three_filtered ::= "search" "your" "library" "for" search_choice_filtered "," search_choice_filtered "," "and" search_choice_filtered

/* The reveal and hand movement consume the complete selection from that search. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_three_filtered}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
clause_search_three_reveal_hand ::= search_three_filtered "." "reveal" "those" "cards" "," "put" "them" "into" "your" "hand" "," "then" "shuffle"

/* The same selected card is revealed, then either branch moves that selection. */
/* @sem Instruction::[Effect{result:@mark, operation:$search}, Effect{result:@next, operation:$search_selected_reveal}, If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:$search_branch_tapped}]}, otherwise:Program{instructions:[Effect{result:@next, operation:$search_branch_hand}]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
clause_search_reveal_branch ::= search "and" search_selected_reveal "." "if" condition "," search_branch_tapped "." "otherwise" "," search_branch_hand "." "then" "shuffle"

/* @sem Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]} */
search_branch_tapped ::= "put" "it" "onto" "the" "battlefield" "tapped"

/* @sem Operation::Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
search_branch_hand ::= "put" "it" "into" "your" "hand"

/* This search choice is used only in the matching single-creature casting
   sacrifice scope; its query refers to that payment's input. */
/* @sem SearchChoice::SearchChoice{filter:AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:Add($number_digits, ObjectProperty{object:Query{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown})}}]), count:UpTo(Constant(1))} */
casting_sacrifice_value_search_choice ::= "a" filter_phrase "card" "with" "mana" "value" "equal" "to" number_digits "plus" "the" "sacrificed" "creature's" "mana" "value"

/* @sem Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[]}}, qualifiers:[]} */
found_with_additional_counter ::= "put" "that" "card" "onto" "the" "battlefield" "with" "an" "additional" counter_kind "counter" "on" "it"

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$casting_sacrifice_value_search_choice]}}, Effect{result:@next, operation:$found_with_additional_counter}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]} */
casting_sacrifice_value_search_program ::= "search" "your" "library" "for" casting_sacrifice_value_search_choice "," found_with_additional_counter "," "then" "shuffle" "."

/* @sem Ability::[Casting(AdditionalCost{cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:Exactly(Constant(1))}]}, repetition:Once}), Spell{announcement:@announcement, body:$casting_sacrifice_value_search_program}] */
line_casting_sacrifice_value_search ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "sacrifice" "a" "creature" "." NEWLINE casting_sacrifice_value_search_program

/* The observation test is scoped to the immediately preceding reveal. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:LibraryTops(All)}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:Not($filter_phrase)}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}, then:Program{instructions:$reveal_each_top_branch}, otherwise:Program{}}] */
instructions_each_top_reveal_all_if ::= "each" "player" "reveals" "the" "top" "card" "of" "their" "library" "." "if" "all" "cards" "revealed" "this" "way" "are" filter_phrase "cards" "," reveal_each_top_branch

/* Each player moves their own top card; ownership determines its controller. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{}}, qualifiers:[]}}]}}] */
reveal_each_top_branch ::= "put" "those" "cards" "onto" "the" "battlefield" "under" "their" "owners'" "control"

/* A keyword-qualified seek exposes its random selection and hand arrival as
   one phrase. The following scoped continuation consumes that arrival. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$card_ability_qualifier}, count:$seek_plural_count, constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_seek_ability_cards ::= "seek" seek_plural_count "cards" card_ability_qualifier

/* @sem Instruction::[...$clause_seek_ability_cards, ...$seek_arrivals_graveyard] */
clause_seek_ability_graveyard ::= clause_seek_ability_cards "and" seek_arrivals_graveyard

/* This phrase is only used in the enclosing seek span, so @prior is the
   actual hand arrival rather than an arbitrary movement receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@prior, phase:After})}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
seek_arrivals_graveyard ::= "put" "them" "into" "your" "graveyard"

/* An event quantity is distinct from a literal count; the enclosing clause
   supplies the damage event and binds the arrival consumed by the delay. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$adjective_nontype}, count:AsManyAsCan(EventAmount), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_seek_event_cards ::= "seek" "that" "many" adjective_nontype "cards"

/* @sem Instruction::[...$clause_seek_event_cards, ...$seek_arrivals_next_end_discard] */
clause_seek_event_delayed_discard ::= clause_seek_event_cards "." seek_arrivals_next_end_discard

/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:One(AbilityController)}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:DiscardObjects{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@prior, phase:After})}}}]}}}] */
seek_arrivals_next_end_discard ::= "at" "the" "beginning" "of" "your" "next" "end" "step" "," "discard" "those" "cards"

/* The two reveals share one targeted owner. The follow-up consumes the hand
   observation and the unchanged top-card query in separate choice branches. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($reveal_hand_top_target)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($reveal_hand_top_target)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}] */
reveal_hand_and_top ::= reveal_hand_top_target "reveals" "their" "hand" "and" "the" "top" "card" "of" "their" "library"

reveal_hand_top_target ::= target_player | target_opponent

/* Both branches put the chosen object at the same current library position. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(3)), zone:Hand}, filter:@and(ObjectFilter::Any, ObjectFilter::OwnedBy(One(Target{slot:0, index:0})))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Library{position:$owner_library_position, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}, _{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Target{slot:0, index:0})}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:Library{position:$owner_library_position, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}]}] */
choose_revealed_hand_or_top ::= "you" "choose" "a" "card" "revealed" "this" "way" "." "that" "player" "puts" "the" "chosen" "card" owner_library_position "of" "their" "library"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$reveal_hand_and_top, ...$choose_revealed_hand_or_top]}} */
spell_reveal_hand_top_choose ::= reveal_hand_and_top "." choose_revealed_hand_or_top "."

/* The selection and follow-up consume the immediately revealed whole hand.
   The same player owns both the revealed population and the chosen card. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($player_ref)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@prior), zone:Hand}, filter:@and(ObjectFilter::OwnedBy(One($player_ref)), $modifier_mana_value_numeric)}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:$observed_hand_selected_action}] */
instructions_revealed_hand_mana_choice ::= player_ref "reveals" "their" "hand" "." "you" "choose" "a" "card" "from" "it" modifier_mana_value_numeric "and" observed_hand_selected_action

/* @sem Operation::Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
observed_hand_selected_action ::= "exile" "that" "card"

/* Both comparisons refer to the same controlled population. */
/* @sem ObjectFilter::@agree($filter_plural, $filter_plural_2) */
search_fewer_than_maximum_kind ::= filter_plural "than" "the" "player" "who" "controls" "the" "most" filter_plural

/* The loop binds each searcher and keeps the chosen cards through reveal and move. */
/* @sem Instruction::[Effect{result:@next, operation:BindValue{value:AmongPlayers{players:All, number:Permanents($search_fewer_than_maximum_kind), aggregation:Maximum}}}, ForEachPlayer{players:Matching{binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$search_fewer_than_maximum_kind, ControlledBy(One(Bound(0)))])}), test:NumberTest::Compare{comparison:Less, value:BoundValue(@prior)}}}, binding:0, body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[_{filter:AllOf([Supertype(Basic), $filter_phrase]), count:UpTo(Subtract(BoundValue(@prior), CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$search_fewer_than_maximum_kind, ControlledBy(One(Bound(0)))])})))}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}] */
instructions_each_search_difference ::= "each" "player" "who" "controls" "fewer" search_fewer_than_maximum_kind "searches" "their" "library" "for" "a" "number" "of" "basic" filter_phrase "cards" "less" "than" "or" "equal" "to" "the" "difference" "," "reveals" "them" "," "puts" "them" "into" "their" "hand" "," "then" "shuffles"

/* A reveal, a count of named cards in that same library, and a common shuffle
   retain the revealing player in both branches. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}}}, If{condition:Compare{left:CountObjects(Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Chosen(CardName)}), test:NumberTest::Compare{comparison:Equal, value:ChosenNumber}}, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$damage_source_ref, recipients:Players(One($player_ref)), amount:$number_digits, preventable:true}}, Effect{result:@next, operation:Shuffle{players:One($player_ref)}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Shuffle{players:One($player_ref)}}]}}] */
instructions_reveal_named_count_damage_shuffle ::= player_ref "reveals" "their" "library" "." "if" "that" "library" "contains" "exactly" "the" "chosen" "number" "of" "cards" "with" "the" "chosen" "name" "," damage_source_ref "deals" number_digits "damage" "to" "that" "player" "." "then" "that" "player" "shuffles"

/* The remaining observed cards stay in the same library and are ordered on top. */
/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(2), phase:Before}])}, zone:Library}, end:Top, order:Chosen} */
rest_top ::= "the" "rest" "on" "top" "of" "your" "library" "in" "any" "order"

/* Reveal, select and move share one filter and one observation receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$until_entry_filter, count:Constant(1)}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Observed(@marked), filter:$until_entry_filter}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
until_optional_entry ::= reveal_until_your_library "a" until_entry_filter "card" "." "you" "may" "put" "that" "card" "onto" "the" "battlefield"

until_entry_filter ::= until_entry_permanent_filter | subtype | noun_creature | noun_artifact | noun_enchantment | noun_land | noun_planeswalker | noun_battle

/* @sem ObjectFilter::AllOf([$adjective_nontype, AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)])]) */
until_entry_permanent_filter ::= adjective_nontype "permanent"

/* The remainder is tied to the entry move made by the preceding phrase. */
/* @sem Instruction::[...$until_optional_entry, $dig_entry_remainder] */
reveal_until_optional_entry_remainder ::= until_optional_entry "." dig_entry_remainder

/* The bound player's reveal and its observed library cards stay in one loop body. */
/* @sem Instruction::[ForEachPlayer{players:$loop_player_population, binding:0, body:Program{instructions:[...$bound_reveal_until, ...$bound_revealed_to_graveyard]}}] */
instructions_each_player_reveal_until_graveyard ::= loop_player_population bound_reveal_until "," "then" bound_revealed_to_graveyard

/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:Bound(0), filter:$card_filter, count:Constant(1)}}] */
bound_reveal_until ::= "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" "a" card_filter "card"

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
bound_revealed_to_graveyard ::= "puts" "those" "cards" "into" "their" "graveyard"

/* A single target is exiled before its owner receives the linked permission. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_permanent), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(OwnerOf(Result{result:@prior, phase:After, index:0}))), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:CastSpell, filter:Any}, terms:_{cost:Free}})], duration:WhileExiled(Result{result:@prior, phase:After, index:0}), evaluation:LiveObjects}}] */
clause_exile_target_owner_cast ::= "exile" target_permanent "." "for" "as" "long" "as" "that" "card" "remains" "exiled" "," "its" "owner" "may" "cast" "it" "without" "paying" "its" "mana" "cost"

/* The branch consumes the same singular exile receipt as the surrounding test. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:$token_groups, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
exiled_top_create_tokens ::= "create" token_groups

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), from:Exile, action:CastSpell, filter:Any})], duration:$until_end_of_your_next_turn, evaluation:LiveObjects}}] */
exiled_top_cast_it ::= "you" "may" "cast" "it" until_end_of_your_next_turn

/* The post-entry test uses the battlefield arrival of this reveal-and-move
   sequence, even though the intervening shuffle produces its own result. */
/* @sem Instruction::[...$reveal_creature_battlefield_shuffle, $entered_creature_type_damage] */
clause_reveal_creature_entry_damage ::= reveal_creature_battlefield_shuffle "." entered_creature_type_damage

/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:CardType(Creature), count:Constant(1)}}, Effect{result:@mark, operation:Move{objects:Matching{objects:Observed(@prior), filter:CardType(Creature)}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
reveal_creature_battlefield_shuffle ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "a" "creature" "card" "." "put" "that" "card" "onto" "the" "battlefield" "," "then" "shuffle" "the" "rest" "into" "your" "library"

/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Result{result:@marked, phase:After, index:0}, recipients:$recipients, amount:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:Power, information:CurrentOrLastKnown}, preventable:true}}]}, otherwise:Program{}} */
entered_creature_type_damage ::= "if" "that" "creature" "is" "a" filter_phrase "," "it" "deals" "damage" "equal" "to" "its" "power" "to" recipients

/* The target, not the destruction receipt, identifies the searching controller. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:One($target_object), regeneration:true}}, Effect{result:@next, operation:Search{searcher:ControllerOf($target_object), library_owner:ControllerOf($target_object), choices:[_{filter:$filter_phrase, count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(ControllerOf($target_object)), arrival:BattlefieldArrival{tapped:true, counters:[[$counter_kind, Constant(1)]], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf($target_object))}}] */
instructions_destroy_target_controller_search_counter ::= "destroy" target_object "." "its" "controller" "searches" "their" "library" "for" "a" filter_phrase "card" "," "puts" "it" "onto" "the" "battlefield" "tapped" "with" "a" counter_kind "counter" "on" "it" "," "then" "shuffles"

/* The choice to search belongs to the target's controller, who also moves and
   shuffles. Failure to destroy does not change the identity of that player. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:One($target_object), regeneration:true}}, Optional{decider:ControllerOf($target_object), body:Program{instructions:[Effect{result:@next, operation:Search{searcher:ControllerOf($target_object), library_owner:ControllerOf($target_object), choices:[_{filter:$filter_phrase, count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(ControllerOf($target_object)), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf($target_object))}}]}}] */
instructions_destroy_target_controller_may_search ::= "destroy" target_object "." "its" "controller" "may" "search" "their" "library" "for" "a" filter_phrase "card" "," "put" "it" "onto" "the" "battlefield" "tapped" "," "then" "shuffle"

/* A single revealed matching card and the remainder share the observation.
   The destination and the disposition of the remainder are independent operands. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$card_filter}, destination:$until_destination, qualifiers:[]}}, Effect{result:@next, operation:$reveal_other_disposition}] */
reveal_until_move_partition ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" ("a" | "an") card_filter "card" "." "if" "you" "do" "," "put" "that" "card" until_destination "and" "put" reveal_other_disposition

/* @sem Operation::Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(2), phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]} */
reveal_other_disposition ::= "all" "other" "cards" "revealed" "this" "way" "into" "your" "graveyard"

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:$reveal_until_move_partition}}] */
instructions_may_reveal_partition ::= "you" "may" reveal_until_move_partition

/* The reveal and both destinations share one observation and the moved subset. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, Effect{result:@next, operation:Move{objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:Chosen(CardName)}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
reveal_named_to_hand_exile_rest ::= reveal_top "and" "put" "all" "of" "them" "with" "that" "name" "into" "your" "hand" "." "exile" "the" "rest"

/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$choose_a_card_name}, ...$reveal_named_to_hand_exile_rest]}} */
spell_choose_name_reveal_partition ::= choose_a_card_name "." reveal_named_to_hand_exile_rest "."

/* The observed library and the optional shuffle share its target owner. Keeping
   both sentences in one phrase also bounds the antecedent of "that library". */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One($target_possessive)}, kind:Card, filter:Any}, count:$top_count, from:Top}}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Shuffle{players:One($target_possessive)}}]}}] */
look_target_library_optional_shuffle ::= "look" "at" "the" "top" top_count "of" target_possessive "library" "." "you" "may" "then" "have" "that" "player" "shuffle" "that" "library"

/* Both quantities are measured for the drawing player; the last sentence
   supplies the rounding mode for each independent calculation. */
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One($player_ref), amount:Divide{numerator:CountObjects(Zone{scope:Players{zone:$fraction_count_draw_words, players:One($player_ref)}, kind:Card, filter:Any}), denominator:Constant(2), rounding:$fraction_round_each}}}, Effect{result:@next, operation:LoseLife{players:One($player_ref), amount:Divide{numerator:PlayerNumber{player:$player_ref, number:Life}, denominator:Constant(2), rounding:$fraction_round_each}}}] */
instructions_player_half_draw_life ::= player_ref fraction_count_draw_words "and" "loses" "half" "their" "life" "." fraction_round_each

/* @sem Zone::$fraction_count_zone */
fraction_count_draw_words ::= "draws" "cards" "equal" "to" "half" "the" "number" "of" "cards" "in" "their" fraction_count_zone

fraction_count_zone ::= fraction_count_library | fraction_count_hand | fraction_count_graveyard

/* @sem Zone::Library */
fraction_count_library ::= "library"

/* @sem Zone::Hand */
fraction_count_hand ::= "hand"

/* @sem Zone::Graveyard */
fraction_count_graveyard ::= "graveyard"

fraction_round_each ::= fraction_round_up_each | fraction_round_down_each

/* @sem Rounding::Up */
fraction_round_up_each ::= "round" "up" "each" "time"

/* @sem Rounding::Down */
fraction_round_down_each ::= "round" "down" "each" "time"

/* The observed hand, the choice, and the discard share one targeted owner.
   Keep the entire sequence together so the selection receipt cannot be borrowed
   from a different hand or intervening action. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One($target_possessive)}, kind:Card, filter:Any})}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Recorded(@prior), count:$hand_choice_up_to}}, Effect{result:@next, operation:DiscardObjects{objects:Zone(_{scope:Players{zone:Hand, players:One($target_possessive)}, kind:Card, filter:InSet(Earlier{what:Selected})})}}] */
clause_look_choose_discard ::= "look" "at" target_possessive "hand" "and" hand_choice_up_to "." "that" "player" "discards" "those" "cards"

/* @sem Count::UpTo($number) */
hand_choice_up_to ::= "choose" "up" "to" number "cards" "from" "it"

/* The reveal and its immediate damage consumer share one observation receipt.
   The target is announced before either instruction. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:$single_library_top}}, Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any})), amount:ObjectProperty{object:Query{objects:Observed(@marked), index:0}, property:ManaValue, information:CurrentOrLastKnown}, preventable:true}}] */
observed_top_value_target_damage ::= "reveal" single_library_top "." self_explicit_ref "deals" "damage" "equal" "to" "that" "card's" "mana" "value" "to" "that" "permanent" "or" "player"

/* @sem Instruction::[...$observed_top_value_target_damage] */
instructions_choose_target_observed_damage ::= "choose" "any" "target" "." observed_top_value_target_damage

/* @sem Instruction::[...$clause_before_then, ...$observed_top_value_target_damage] */
instructions_choose_target_then_observed_damage ::= "choose" "any" "target" "." clause_before_then "," "then" observed_top_value_target_damage

/* The singular reveal and the following permission share the same top card. */
/* @sem Instruction::[Effect{result:@next, operation:$shuffle_your_library}, Effect{result:@next, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:$revealed_top_play_changes, duration:$revealed_top_play_duration, evaluation:LiveObjects}}] */
instructions_reveal_top_revealed_play ::= shuffle_your_library "," "then" "reveal" "the" "top" "card" "." revealed_top_play_duration "," revealed_top_play_changes

/* @sem Duration::Either([$until_end_of_turn, UntilLibraryTopChanges(AbilityController)]) */
revealed_top_play_duration ::= until_end_of_turn "," "for" "as" "long" "as" "that" "card" "remains" "on" "top" "of" "your" "library"

/* @sem Change::[PlayerRule(Visibility{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, audience:Everyone}), ...$revealed_top_free_permission] */
revealed_top_play_changes ::= "play" "with" "the" "top" "card" "of" "your" "library" "revealed" "and" revealed_top_free_permission

/* @sem Change::[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Affected)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, from:Library, action:Either, filter:Any}, terms:_{cost:Free}})] */
revealed_top_free_permission ::= "you" "may" "play" "that" "card" "without" "paying" "its" "mana" "cost"

/* The event player's library supplies the actual exile arrivals. */
/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(EventSubject)}, kind:Card, filter:Any}, count:$card_count, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_event_player_top ::= "exile" "the" "top" card_count "of" "that" "player's" "library"

/* This consumer is used only with the immediately preceding exile producer. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$filter_phrase, InSet(Transition{result:@marked, phase:After})])}, count:AsManyAsCan($counter_amount)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
put_exile_arrival_under_your_control ::= "put" counter_amount filter_phrase "card" "from" "among" "them" "onto" "the" "battlefield" "under" "your" "control"

/* Keep the producer and its consumer together for inverse matching. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_event_player_top}, ...$put_exile_arrival_under_your_control] */
clause_exile_event_top_put ::= exile_event_player_top "," "then" put_exile_arrival_under_your_control

/* Scope the observation and both consumers to the same reveal receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, Effect{result:@next, operation:Mill{players:$players_singular, amount:CountManaSymbols{objects:Observed(@marked), colors:[$mana_color_word]}}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:Chosen}}] */
instructions_reveal_color_mill_bottom ::= reveal_top "." "for" "each" mana_color_word "mana" "symbol" "in" "the" "mana" "costs" "of" "the" "revealed" "cards" "," players_singular "mills" "a" "card" "." "then" "put" "the" "cards" "you" "revealed" "this" "way" "on" "the" "bottom" "of" "your" "library" "in" "any" "order"

/* The reveal, battlefield move and remainder form one observed partition. */
/* @sem Instruction::[...$player_reveal_partition_program] */
player_reveal_partition_graveyard ::= player_reveal_partition_program

/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:$player_ref, filter:$card_filter, count:$value}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$card_filter}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
player_reveal_partition_program ::= player_ref "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" value card_filter "cards" "." "put" "those" "cards" "onto" "the" "battlefield" "under" "your" "control" "." "that" "player" "puts" "the" "rest" "into" "their" "graveyard"

/* The observation counted by damage is the same reveal that produced the partition. */
/* @sem Instruction::[...$own_reveal_partition_program, Effect{result:@next, operation:DealDamage{source:Source, recipients:Players(One(AbilityController)), amount:CountObjects(Observed(@back(4))), preventable:true}}] */
reveal_partition_damage ::= own_reveal_partition_program "." "this" "creature" "deals" "damage" "to" "you" "equal" "to" "the" "number" "of" "cards" "revealed" "this" "way"

/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$card_filter, count:$counter_amount}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$card_filter}, destination:$until_destination, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
own_reveal_partition_program ::= reveal_until_your_library counter_amount card_filter "card" "." "put" "that" "card" until_destination "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* The target is retained across its move and the controller's reveal. */
/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:CardType(Creature)}), index:0} */
reveal_target_creature ::= "target" "creature"

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($reveal_target_creature), destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, ...$controller_reveal_partition_program] */
target_creature_bottom_reveal ::= "put" reveal_target_creature "on" "the" "bottom" "of" "its" "owner's" "library" "." controller_reveal_partition_program

/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:ControllerOf(@that_object), filter:$card_filter, count:$counter_amount}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$card_filter}, destination:Battlefield{controller:Player(ControllerOf(@that_object)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:ControllerOf(@that_object), library_owner:ControllerOf(@that_object), objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
controller_reveal_partition_program ::= "that" "creature's" "controller" "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" counter_amount card_filter "card" "." "the" "player" "puts" "that" "card" "onto" "the" "battlefield" "and" "the" "rest" "on" "the" "bottom" "of" "their" "library" library_order

/* The mana comparison uses the actual exile arrival of this target. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:One($target_qualified_creature), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, ...$greater_value_reveal_program] */
exile_creature_greater_reveal ::= "exile" target_qualified_creature "," "then" greater_value_reveal_program

/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:Greater, value:ObjectProperty{object:Result{result:@prior, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}]), count:$counter_amount}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:Greater, value:ObjectProperty{object:Result{result:@back(3), phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}])}, destination:$until_destination, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
greater_value_reveal_program ::= reveal_until_your_library counter_amount card_filter "card" "with" "greater" "mana" "value" "." "put" "that" "card" until_destination "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* The destination follows the owners of the plural selection. */
/* @sem MovementDestination::Library{position:$cost_library_end, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
cost_plural_owner_library ::= cost_library_end "of" "their" "owner's" "library"

/* @sem LibraryPosition::Bottom */
cost_library_end_bottom ::= "on" "the" "bottom"

/* @sem LibraryPosition::Top */
cost_library_end_top ::= "on" "top"

cost_library_end ::= cost_library_end_bottom | cost_library_end_top

/* The conditional tests the controller's top card; the following anaphor
   refers to that same card, so keep the two clauses in one scoped production. */
/* @sem Condition::ObjectMatches{object:Query{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, index:0}, filter:$card_filter} */
condition_own_top_card_kind_a ::= "the" "top" "card" "of" "your" "library" "is" "a" card_filter "card"

/* @sem Condition::ObjectMatches{object:Query{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, index:0}, filter:$card_filter} */
condition_own_top_card_kind_an ::= "the" "top" "card" "of" "your" "library" "is" "an" card_filter "card"

condition_own_top_card_kind ::= condition_own_top_card_kind_a | condition_own_top_card_kind_an

/* @sem Change::[GainAbilitiesOf{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, kinds:Term{family:CheckHasable, form:ActivatedAbility}}] */
change_own_top_card_activated ::= "has" "all" "activated" "abilities" "of" "that" "card"

/* @sem Ability::Conditional{condition:$condition_own_top_card_kind, then:[Static(_{kind:Ordinary, affected:Objects($affected), changes:$change_own_top_card_activated})]} */
conditional_own_top_card_abilities ::= "as" "long" "as" condition_own_top_card_kind "," affected change_own_top_card_activated "."

/* The look supplies the library observation used by both following effects. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top_two}, ...$manifest_observed_one, $manifest_observed_other] */
dig_look_manifest_other ::= look_top_two "." manifest_observed_one "," "then" manifest_observed_other

/* @sem Operation::LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(2), from:Top}} */
look_top_two ::= "look" "at" "the" "top" "two" "cards" "of" "your" "library"

/* @sem Instruction::[Effect{result:@next, operation:@manifest_result(Operation::WithSelections{steps:[_{binding:@selection_id(0), objects:InZone{objects:Observed(@marked), zone:Library}, chooser:Players(One(AbilityController)), count:Exactly(Constant(1))}], action:Manifest{actor:One(AbilityController), source:Cards(Prepared(@selection_id(0))), entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}})}] */
manifest_observed_one ::= "manifest" "one" "of" "those" "cards"

/* Only the cards still in the observed library population are moved. */
/* @sem Instruction::Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:Library{position:TopOrBottom{chooser:Players(One(AbilityController))}, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}} */
manifest_observed_other ::= "put" "the" "other" "on" "the" "top" "or" "bottom" "of" "your" "library"

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$manifest_observed_count, $manifest_observed_rest] */
dig_look_manifest_rest ::= look_top "." manifest_observed_count "," "then" manifest_observed_rest

/* @sem Instruction::[Effect{result:@next, operation:@manifest_result(Operation::WithSelections{steps:[_{binding:@selection_id(0), objects:InZone{objects:Observed(@marked), zone:Library}, chooser:Players(One(AbilityController)), count:Exactly($value)}], action:Manifest{actor:One(AbilityController), source:Cards(Prepared(@selection_id(0))), entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}})}] */
manifest_observed_count ::= "manifest" value "of" "those" "cards"

/* @sem Instruction::Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:Library{position:TopOrBottom{chooser:Players(One(AbilityController))}, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}} */
manifest_observed_rest ::= "put" "the" "rest" "on" "the" "top" "or" "bottom" "of" "your" "library"

/* The shuffle identifies the owner whose top card is exiled; both branches
   consume that exact exile receipt. */
/* @sem Instruction::[Effect{result:@next, operation:$owner_shuffles_target}, ...$owner_exile_top_type_choice] */
instructions_owner_shuffle_exile_choice ::= owner_shuffles_target "," owner_exile_top_type_choice

/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(OwnerOf(Target{slot:@last_slot, index:0}))}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}, destination:Battlefield{controller:Player(OwnerOf(Target{slot:@last_slot, index:0})), arrival:BattlefieldArrival{}}, qualifiers:[]}}]}, otherwise:Program{instructions:[Optional{decider:OwnerOf(Target{slot:@last_slot, index:0}), body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(OwnerOf(Target{slot:@last_slot, index:0})), action:CastSpell, cards:One(Result{result:@marked, phase:After, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}]}}] */
owner_exile_top_type_choice ::= "then" "exiles" "the" "top" "card" "of" "their" "library" "." "if" "it's" "a" card_filter "card" "," "they" "put" "it" "onto" "the" "battlefield" "." "otherwise" "," "they" "may" "cast" "it" "without" "paying" "its" "mana" "cost"

/* Both uses of the exiled cards are scoped to this top-library producer. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_top_cards_of_your_library}, ...$exiled_choice_type_permission] */
instructions_top_exile_choice_type_permission ::= exile_top_cards_of_your_library "." exiled_choice_type_permission

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$card_filter, InSet(Transition{result:@marked, phase:After})])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone{scope:Shared(Exile), kind:Card, filter:InSet(Transition{result:@marked, phase:After})}, from:Exile, action:CastSpell, filter:Any}, terms:_{limit:OnePerCardType(Nonland), cost:Free}})], duration:$duration, evaluation:LiveObjects}}] */
exiled_choice_type_permission ::= "you" "may" "put" "a" card_filter "card" "from" "among" "them" "onto" "the" "battlefield" "." duration "," "for" "each" "nonland" "card" "type" "," "you" "may" "cast" "a" "spell" "of" "that" "type" "from" "among" "the" "exiled" "cards" "without" "paying" "its" "mana" "cost"

/* The target exile supplies both the compared incarnation and its controller. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_opponent_nontoken_union}, ...$controller_random_lesser_entry] */
instructions_exile_union_random_lesser ::= exile_opponent_nontoken_union "." controller_random_lesser_entry

/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([Not(Token), AnyOf([$noun, $noun_2, $noun_3]), ControlledBy(OpponentsOf(AbilityController))])}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]} */
exile_opponent_nontoken_union ::= "exile" "target" "nontoken" noun "," noun "," "or" noun "an" "opponent" "controls"

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:@selection(SelectionStep::_{binding:0, objects:Zone{scope:Players{zone:Library, players:One(ControllerOf(Target{slot:@last_slot, index:0}))}, kind:Card, filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}])}, chooser:Chance, count:AsManyAsCan(Constant(1))}), destination:Battlefield{controller:Player(ControllerOf(Target{slot:@last_slot, index:0})), arrival:BattlefieldArrival{tapped:true}}, qualifiers:[]}}] */
controller_random_lesser_entry ::= "that" "player" "puts" "a" "random" card_filter "card" "with" "lesser" "mana" "value" "from" "their" "library" "onto" "the" "battlefield" "tapped"

/* Each selected opponent exiles one card from their own library. */
/* @sem Instruction::[ForEachPlayer{players:$poisoned_opponents, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
clause_poisoned_opponents_exile_top ::= poisoned_opponents "exiles" "the" "top" "card" "of" "their" "library" "face" "down"

/* The permission applies to the arrivals produced by this exact exile loop. */
/* @sem Instruction::[...$clause_poisoned_opponents_exile_top, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:Transition{result:@prior, phase:After}, audience:AffectedPlayer}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:Either, filter:Any}, terms:_{cost:Normal, spend_as:AnyColor}})], duration:WhileAnyExiled(Transition{result:@prior, phase:After}), evaluation:LiveObjects}}] */
instructions_poisoned_exile_play ::= clause_poisoned_opponents_exile_top "." "you" "may" "look" "at" "and" "play" "those" "cards" "for" "as" "long" "as" "they" "remain" "exiled" "," "and" "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "those" "spells"

/* The option covers the entire reveal and its subsequent partition. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:$dig_reveal_joined}}] */
dig_optional_reveal_joined ::= "you" "may" dig_reveal_joined

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$a_card}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:$dig_destination}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}] */
dig_put_revealed_one ::= "put" a_card "revealed" "this" "way" dig_destination

/* A random library selection with a separately specified extreme measurement. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$seek_three_kinds}, count:AsManyAsCan($seek_measured_extreme), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
seek_measured_cards ::= "seek" "X" seek_three_kinds "cards" "," "where" "X" "is" seek_measured_extreme

/* @sem ObjectFilter::AnyOf([$card_word, $card_word_2, $card_word_3]) */
seek_three_kinds ::= card_word "," card_word "," "and" "/" "or" card_word

/* @sem Expr::Aggregate{objects:$extreme_controlled, property:$stat, aggregation:$extreme_aggregation} */
seek_measured_extreme ::= "the" extreme_aggregation stat "among" extreme_controlled

/* The follow-up uses the actual arrival from the preceding seek. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$seek_measured_cards, Effect{result:@next, operation:Move{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@prior, phase:After})}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}} */
spell_seek_measured_battlefield ::= seek_measured_cards "." "put" "those" "cards" "onto" "the" "battlefield" "."

/* The revealed card is the one just inspected, and the branch consumes this payment. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[RevealTop($filter_phrase)]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:$program, otherwise:Program{}}, Effect{result:@next, operation:$operation}]} */
program_look_reveal_conditional_then ::= "look" "at" "the" "top" "card" "of" "your" "library" "." "you" "may" "reveal" "it" "if" "it's" "a" filter_phrase "card" "." program "if" "you" "revealed" "it" "this" "way" "." "then" operation "."

/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$program_look_reveal_conditional_then} */
trigger_turn_look_reveal_conditional ::= "at" turn_event "," program_look_reveal_conditional_then

/* The selection consumes the immediately preceding top-library exile receipt. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Matching{objects:Transition{result:@prior, phase:After}, filter:AnyOf([$filter_phrase, $filter_phrase_2])}, count:AnyNumber, constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}}] */
instructions_exile_top_any_battlefield ::= exile_top_cards_of_your_library "." "you" "may" "put" "any" "number" "of" filter_phrase "and" "/" "or" filter_phrase "cards" "from" "among" "them" "onto" "the" "battlefield"

library_choice_owner_object ::= library_choice_owner_of | library_choice_target_owner

/* @sem ObjectRef::$object_ref */
library_choice_owner_of ::= "the" "owner" "of" object_ref

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:$adjective_nontype}), index:0} */
library_choice_target_owner ::= "target" adjective_nontype "permanent's" "owner"

/* The reveal and both destinations share the same observation. Cards moved to
   the graveyard no longer belong to the remaining library population. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, Effect{result:@next, operation:Move{objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$filter_phrase}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:$library_order}}] */
dig_reveal_matching_graveyard ::= reveal_top "." "put" "all" filter_phrase "cards" "revealed" "this" "way" "into" "your" "graveyard" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* A selection from observed cards still in their library, bounded by mana value. */
/* @sem ObjectSet::Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:AllOf([$filter_phrase, AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]), Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}])} */
observed_library_permanent_card ::= filter_phrase "card" "with" "mana" "value" number "or" "less" "from" "among" "them"

/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:$observed_library_permanent_card, count:UpTo(Constant(1)), constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:$observed_entry_destination, qualifiers:[]}} */
put_observed_library_card ::= "you" "may" "put" "a" observed_library_permanent_card observed_entry_destination

/* @sem MovementDestination::$battlefield_control_yours */
observed_entry_destination ::= "onto" "the" "battlefield" battlefield_control_yours

/* One reveal supplies the matching card and the observed library remainder.
   Reusing the filter makes the inverse require both consumers to agree. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$reveal_cast_filter, count:Constant(1)}}, Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Observed(@marked), filter:$reveal_cast_filter}, count:UpTo(Constant(1)), cost:Free}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:Random}}]} */
reveal_until_free_cast_program ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "a" reveal_cast_filter "." "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" "." "put" "all" "revealed" "cards" "not" "cast" "this" "way" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* @sem @and($card_filter, $modifier_mana_value_numeric) */
reveal_cast_filter ::= card_filter "card" modifier_mana_value_numeric

/* The named player performs both actions on the ability controller's library. */
/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:$player_ref, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:$top_count, from:Top}}}, Effect{result:@next, operation:ReorderLibrary{chooser:$player_ref, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Top, order:Chosen}}] */
clause_player_looks_reorders ::= player_ref "looks" "at" "the" "top" top_count "of" "your" "library" "," "then" "puts" "them" "back" "in" "any" "order"

/* An alternative card type may have its own mana-value bound. */
/* @sem ObjectFilter::AnyOf([$filter_phrase, AllOf([$filter_phrase_2, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:CountCounters(_{recipients:Objects($affected), kind:$counter_kind, information:CurrentOrLastKnown})}}])]) */
top_card_counter_bounded_alternative ::= filter_phrase "card" "or" "a" filter_phrase "card" "with" "mana" "value" "less" "than" "or" "equal" "to" "the" "number" "of" counter_kind "counters" "on" affected

/* @sem Operation::MoveTopCard{actor:One(AbilityController), cards:$top_card_counter_bounded_alternative, reveal:false, destination:$top_card_battlefield} */
top_card_put_qualified ::= "if" "it's" "a" top_card_counter_bounded_alternative "," "you" "may" "put" "that" "card" top_card_battlefield

/* @sem Instruction::[Effect{result:@next, operation:$top_card_put_qualified}] */
top_card_put_qualified_action ::= top_card_put_qualified

/* @sem Instruction::[...$top_card_look, Optional{decider:AbilityController, body:Program{instructions:$top_card_put_qualified_action}}] */
clause_top_card_put_qualified ::= top_card_look top_card_put_qualified_action

/* A live battlefield count governs a reveal; the matching observation moves,
   and the remaining library cards are randomized at the bottom. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:@agree($card_filter, $card_filter_2), count:$value_number_of}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@prior), filter:@agree($card_filter, $card_filter_2)}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(3)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Random}}] */
instructions_reveal_counted_battlefield ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "X" card_filter "cards" "," "where" "X" "is" value_number_of "." "put" "those" card_filter "cards" "onto" "the" "battlefield" "tapped" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* @sem $instructions_reveal_counted_battlefield */
instructions_then_reveal_counted_battlefield ::= "then" instructions_reveal_counted_battlefield

/* The exile consumes the inspected library tops; the following permission and
   visibility refer to that same face-down movement receipt. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:$library_tops}}, Effect{result:@next, operation:Move{objects:$library_tops, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
look_library_tops_exile_down ::= "look" "at" library_tops "," "then" "exile" "those" "cards" "face" "down"

/* @sem Instruction::[...$look_library_tops_exile_down, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:Transition{result:@prior, phase:After}, audience:AffectedPlayer}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:$exiled_play_action, filter:Any}, terms:_{cost:$exiled_plural_cost}})], duration:WhileAnyExiled(Transition{result:@prior, phase:After}), evaluation:LiveObjects}}] */
instructions_look_tops_exile_free ::= look_library_tops_exile_down "." "you" "may" exiled_play_action "them" exiled_plural_cost

exiled_plural_cost ::= exiled_plural_cost_free | exiled_plural_cost_normal

/* @sem PlayCost::Free */
exiled_plural_cost_free ::= "without" "paying" "their" "mana" "costs" "for" "as" "long" "as" "they" "remain" "exiled"

/* @sem PlayCost::Normal */
exiled_plural_cost_normal ::= "for" "as" "long" "as" "they" "remain" "exiled"

/* Keep the search and exile producer in the same print contract as its hand
   receipt; the named player both shuffles and draws. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:$target_possessive, choices:[_{filter:Chosen(CardName), count:$named_search_count}], also:[Graveyard, Hand]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($target_possessive)}}, Effect{result:@next, operation:Draw{players:One($target_possessive), amount:CountObjects(InZone{objects:Transition{result:@marked, phase:Before}, zone:Hand})}}] */
instructions_search_name_exile_hand_draw ::= "search" target_possessive "graveyard" "," "hand" "," "and" "library" "for" named_search_count "cards" "with" "that" "name" "and" "exile" "them" "." "that" "player" "shuffles" "," "then" "draws" "a" "card" "for" "each" "card" "exiled" "from" "their" "hand" "this" "way"

/* The perpetual effect applies to the arrival of the single searched card,
   after its reveal, move to its owner's hand, and shuffle. */
/* @sem Instruction::[Effect{result:@next, operation:$search_single_library}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:Transition{result:@back(3), phase:After}, changes:$search_hand_perpetual_changes}}] */
instructions_search_hand_perpetual ::= search_single_library "," "reveal" "it" "," "put" "it" "into" "your" "hand" "," "then" "shuffle" "." "it" "perpetually" search_hand_perpetual_changes

/* @sem Change::[AddArtifactType(Clue), GrantAbility(@scope(Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$program}))] */
search_hand_perpetual_changes ::= "becomes" "a" "Clue" "artifact" "in" "addition" "to" "its" "other" "types" "and" "gains" '"' cost ":" program "." '"'

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_search_hand_perpetual}} */
spell_search_hand_perpetual ::= instructions_search_hand_perpetual

/* The amount and slice refer to the same player's library. */
/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:@recipient_value(Recipients::Players(One($player_ref)), $fraction_top_library_amount), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
player_exiles_top_fraction ::= player_ref "exiles" "the" "top" fraction_top_library_amount

/* @sem Expr::Divide{numerator:CountObjects(Zone{scope:Players{zone:Library, players:One(@that_player)}, kind:Card, filter:Any}), denominator:Constant(2), rounding:$rounding_words} */
fraction_top_library_amount ::= "half" "of" "their" "library" "," rounding_words

/* The two phases form one receipt contract: the search count refers to the
   total of the optional mana payments, and the move uses that search's result. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, starting_with:$shared_payment_first_player, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@next, operation:PayAnyAmount{actor:One(Bound(0)), resource:Mana}}]}}]}}, ForEachPlayer{players:$players_singular_2, binding:0, body:Program{instructions:[Effect{result:@next, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[_{filter:$filter_phrase, count:UpTo(PerformedTotal(@prior))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$shared_search_destination, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}] */
shared_payment_search_instructions ::= "starting" "with" shared_payment_first_player "," players_singular "may" "pay" "any" "amount" "of" "mana" "." players_singular "searches" "their" "library" "for" "up" "to" "X" filter_phrase "cards" "," "where" "X" "is" "the" "total" "amount" "of" "mana" "paid" "this" "way" "," "puts" "them" shared_search_destination "," "then" "shuffles"

shared_search_destination ::= shared_search_battlefield | shared_search_hand

/* @sem MovementDestination::Battlefield{controller:Player(Bound(0)), arrival:$search_option_entry} */
shared_search_battlefield ::= search_option_entry

/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
shared_search_hand ::= "into" "their" "hand"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$shared_payment_search_instructions]}} */
shared_payment_search_spell ::= shared_payment_search_instructions "."

/* Postposed eligibility is scoped to the short declined-payment wording. */
/* @sem Instruction::[Effect{result:@next, operation:MoveTopCard{actor:One(AbilityController), cards:$top_reveal_kind, reveal:false, destination:$top_card_battlefield}}] */
top_card_put_short_action ::= "you" "may" "put" "it" top_card_battlefield "if" "it's" top_reveal_kind

/* @sem Cost::Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:$top_card_put_short_action}}]} */
top_card_put_short_payment ::= top_card_put_short_action

/* @sem Instruction::[...$top_card_look, Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$top_card_put_short_payment, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:$top_reveal_branch}, otherwise:Program{}}] */
clause_top_card_put_declined_short ::= top_card_look top_card_put_short_payment "." "if" "you" "don't" "," top_reveal_branch

/* A search of either the library or outside the game keeps the owned,
   differently named selection available to the following instructions. */
/* @sem SearchChoice::SearchChoice{filter:AllOf([Supertype(Legendary), $noun, OwnedBy(One(AbilityController))]), count:Exactly($number), constraints:[DifferentNames]} */
owned_distinct_legendary_search_choice ::= "exactly" number "legendary" noun "cards" "you" "own" "with" "different" "names"

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$owned_distinct_legendary_search_choice], either:true, outside:true} */
search_library_or_outside_owned ::= "search" "your" "library" "and" "/" "or" "outside" "the" "game" "for" owned_distinct_legendary_search_choice

/* The opponent's selection is a new receipt; the remainder is taken from
   that choice, excluding cards which are already in the library. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:ChooseObjects{player:OneOf(OpponentsOf(AbilityController)), objects:Selected(@back(3)), count:AsManyAsCan($number)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Difference{objects:Unselected(@back(3)), excluding:InZone{objects:Unselected(@back(3)), zone:Library}}, destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
revealed_selection_opponent_partition ::= "," "then" "reveal" "those" "cards" "." "an" "opponent" "chooses" number "of" "them" "." "put" "the" "chosen" "cards" "into" "your" "hand" "and" "shuffle" "the" "rest" "into" "your" "library"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$search_library_or_outside_owned}, ...$revealed_selection_opponent_partition]}} */
spell_search_outside_opponent_partition ::= search_library_or_outside_owned revealed_selection_opponent_partition "."

/* The reveal, property payment, and both moves share the same library top.
   Keeping them in one program prevents an unrelated observation from becoming
   the antecedent of "that card". */
/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top} */
process_your_top_card ::= "the" "top" "card" "of" "your" "library"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Reveal{objects:$process_your_top_card}}, Effect{result:@next, operation:PayCost{player:Acting, cost:Cost{parts:[Life(ObjectProperty{object:Query{objects:Observed(@prior), index:0}, property:$receipt_stat, information:CurrentOrLastKnown})]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:Move{objects:$process_your_top_card, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Move{objects:$process_your_top_card, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]} */
process_reveal_pay_property ::= "reveal" process_your_top_card "." "that" "player" "may" "pay" "life" "equal" "to" "that" "card's" receipt_stat "." "if" "they" "do" "," "exile" "that" "card" "." "otherwise" "," "put" "it" "into" "your" "hand"

/* These two branches refer to the card discarded by the enclosing cycle event.
   Keep them under that event so the anaphor cannot acquire another producer. */
/* @sem Operation::Move{objects:One(Query{objects:InZone{objects:One(Discarded), zone:Graveyard}, index:0}), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
cycle_discard_shuffle ::= "shuffle" "it" "into" "your" "library" "from" "your" "graveyard"

/* @sem Operation::Move{objects:One(Query{objects:InZone{objects:One(Discarded), zone:Graveyard}, index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
cycle_discard_battlefield ::= "put" "it" "onto" "the" "battlefield" "from" "your" "graveyard"

/* @sem Program::Program{instructions:[If{condition:$condition_cycled_named_game, then:Program{instructions:[Effect{result:@next, operation:$cycle_discard_battlefield}]}, otherwise:Program{instructions:[Effect{result:@next, operation:$cycle_discard_shuffle}]}}]} */
cycle_discard_conditional_move ::= cycle_discard_shuffle "." "if" condition_cycled_named_game "," cycle_discard_battlefield "instead" "."

/* @sem Ability::Scoped{zones:[Battlefield, Graveyard, Hand, Library, Stack, Exile, Command, Ante], ability:@scope(Ability::Triggered{event:$repeat_card_cycle, limits:TriggerLimits{}, announcement:@announcement, body:$cycle_discard_conditional_move})} */
cycle_discard_conditional_trigger ::= "when" repeat_card_cycle "," cycle_discard_conditional_move

/* Search the event player's zones for the name of the previously chosen card. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:EventSubject, choices:[_{filter:SharesNameWith(Result{result:@prior, phase:After, index:0}), count:$name_search_count}], also:[Graveyard, Hand]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(EventSubject)}}] */
clause_search_event_hand_choice ::= "search" "that" "player's" "graveyard" "," "hand" "," "and" "library" "for" name_search_count "cards" "with" "the" "same" "name" "as" "that" "card" "and" "exile" "them" "." "then" "that" "player" "shuffles"

/* Three phases preserve the player-wide reveal before either movement. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@mark, operation:$bound_reveal_top}]}}, ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_put_revealed}]}}, ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:$bound_exile_revealed_rest}]}}] */
player_reveal_split_phases ::= players_singular bound_reveal_top "," bound_put_revealed "," "and" bound_exile_revealed_rest

/* @sem Operation::Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}, count:$card_count, from:Top}} */
bound_reveal_top ::= "reveals" "the" "top" card_count "of" "their" "library"

/* @sem Operation::Move{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:AllOf([$filter_phrase, InSet(Observed(@marked)), OwnedBy(One(Bound(0)))])}, destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]} */
bound_put_revealed ::= "puts" "all" filter_phrase "cards" "revealed" "this" "way" "onto" "the" "battlefield" "tapped"

/* @sem Operation::Move{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:AllOf([InSet(Observed(@marked)), OwnedBy(One(Bound(0)))])}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
bound_exile_revealed_rest ::= "exiles" "the" "rest"

/* Keep the reveal, selected movement, remainder, and attachment in one
   producer-consumer phrase: both references name this movement's receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$card_filter}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Random}}, Effect{result:@next, operation:Attach{attachments:One(GrantingObject), host:Result{result:@back(3), phase:After, index:0}}}] */
instructions_reveal_attach_remainder ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "a" card_filter "card" "." "put" "that" "card" "onto" "the" "battlefield" "and" "attach" SELF_NAME "to" "it" "," "then" "put" "all" "other" "cards" "revealed" "this" "way" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* Keep the permission and its exile producer in one inverse contract. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$captured_top_card_count, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:CastSpell, filter:Any})], duration:$duration, evaluation:LiveObjects}}] */
clause_top_exile_cast_permission ::= "exile" "the" "top" captured_top_card_count "of" "your" "library" "." duration "," "you" "may" "cast" "spells" "from" "among" "those" "exiled" "cards"

captured_top_card_count ::= captured_top_x_cards | captured_top_fixed_cards

/* @sem $number_words */
captured_top_fixed_cards ::= number_words "cards"

/* @sem Expr::BoundValue(@marked) */
captured_top_x_cards ::= "X" "cards"

/* Keep the selected cards, exile arrival, shuffle and cast permission in one scope. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_any_number_colored_spells], also:[Graveyard]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@marked, phase:After}, from:Exile, action:CastSpell, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}] */
search_graveyard_library_exile_cast ::= "search" "your" "graveyard" "and" "library" "for" search_choice_any_number_colored_spells "," "exile" "them" "," "then" "shuffle" "." "you" "may" "cast" "them" this_duration

/* @sem SearchChoice::SearchChoice{filter:AllOf([$adjective_color, $filter_instant_and_or_sorcery]), count:AnyNumber} */
search_choice_any_number_colored_spells ::= "any" "number" "of" adjective_color filter_instant_and_or_sorcery "cards"

/* The trailing operation composes independently with the scoped search sequence. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[Loyalty($loyalty)]}, limits:ActivationLimits{sorcery:true}, announcement:@announcement, body:Program{instructions:[...$search_graveyard_library_exile_cast, Effect{result:@next, operation:$mana_add_counted}]}} */
loyalty_search_exile_cast_mana ::= "[" loyalty "]" ":" search_graveyard_library_exile_cast "." mana_add_counted "."

/* The permission is tied to the immediately preceding random library selection
   and its move to the owner's hand; its reference is that move's arrival. */
/* @sem Program::Program{instructions:[...$clause_seek_card, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Hand, action:CastSpell, filter:Any}, terms:_{cost:Free}})], duration:$until_end_of_turn, evaluation:LiveObjects}}]} */
program_sentence_seek_free_cast ::= clause_seek_card "." until_end_of_turn "," "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" "."

/* Select independently from a player's graveyard and hand, then exile those
   selections together with the top of that same player's library. */
/* @sem Instruction::[Effect{result:@mark, operation:ChooseObjects{player:$player_ref, objects:Zone{scope:Players{zone:Graveyard, players:One($player_ref)}, kind:Card, filter:Any}, count:AsManyAsCan($card_count), constraints:[AtRandom]}}, Effect{result:@next, operation:ChooseObjects{player:$player_ref, objects:Zone{scope:Players{zone:Hand, players:One($player_ref)}, kind:Card, filter:Any}, count:AsManyAsCan($card_count_2), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Union([Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:$top_count, from:Top}, Selected(@marked), Selected(@prior)]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_player_exiles_three_zones ::= player_ref "exiles" "the" "top" top_count "of" "their" "library" "," card_count "at" "random" "from" "their" "graveyard" "," "and" card_count "at" "random" "from" "their" "hand"

/* The cast consumes the arrival of the preceding exile, within this pair. */
/* @sem Instruction::[...$clause_player_exiles_three_zones, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Transition{result:@prior, phase:After}, count:Exactly(Constant(1)), cost:Free}}]}}] */
instructions_three_zones_free_cast ::= clause_player_exiles_three_zones "." "you" "may" "cast" "a" "spell" "from" "among" "cards" "exiled" "this" "way" "without" "paying" "its" "mana" "cost"

/* Search across three chosen zones. The marked search owns both the selected
   object and the conditional library shuffle. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_three_singular_choice], also:[Graveyard, Hand], either:true}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, If{condition:Searched(@marked), then:Program{instructions:[Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:Program{}}] */
clause_search_three_zones_battlefield ::= "search" "your" "graveyard" "," "hand" "," "and" "/" "or" "library" "for" search_three_singular_choice "and" "put" "it" "onto" "the" "battlefield" "." "if" "you" "search" "your" "library" "this" "way" "," "shuffle"

search_three_singular_choice ::= search_choice_filtered | search_choice_modified | search_named_one

/* Keep the reveal, exile, cast and remainder together: both later references
   use the arrival of this very exile operation. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:Shares{property:CardTypes, with:Scoped}, count:Constant(1)}}, Effect{result:@mark, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Query{objects:Matching{objects:Transition{result:@marked, phase:After}, filter:Shares{property:CardTypes, with:Scoped}}, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:Library{position:BottomRandom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]} */
exile_until_cycled_type_cast_remainder ::= "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" "a" "card" "that" "shares" "a" "card" "type" "with" "the" "cycled" "card" "." "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" "." "then" "put" "the" "exiled" "cards" "that" "weren't" "cast" "this" "way" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* A complete observed top-card test is a reusable program. */
/* @sem Program::Program{instructions:$top_reveal_test} */
program_top_reveal_test ::= top_reveal_test

/* The choice and its draw are one episode: only players who shuffled draw. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@next, operation:Move{objects:Union([Zone(_{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any})]), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}]}}, Effect{result:@next, operation:Draw{players:Matching{binding:0, condition:PlayerState{player:Bound(0), state:ShuffledThisWay}}, amount:$card_count}}] */
clause_optional_shuffle_hands_graveyards_draw ::= "each" "player" "may" "shuffle" "their" "hand" "and" "graveyard" "into" "their" "library" "." "each" "player" "who" "does" "draws" card_count

/* The conditional and cast refer to the cards from this repeated exile payment. */
/* @sem Instruction::[$repeat_top_exile, If{condition:Compare{left:Aggregate{objects:Earlier{what:Exiled}, property:ManaValue, aggregation:Sum}, test:NumberTest::Compare{comparison:LessOrEqual, value:$number_digits}}, then:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Earlier{what:Exiled}, count:AnyNumber, cost:Free}}]}, otherwise:Program{}}] */
instructions_repeat_exile_cast ::= repeat_top_exile "." "if" "the" "total" "mana" "value" "of" "the" "cards" "exiled" "this" "way" "is" number_digits "or" "less" "," "you" "may" "cast" "any" "number" "of" "spells" "from" "among" "those" "cards" "without" "paying" "their" "mana" "costs"

/* @sem Instruction::Repeatable{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[$repeat_top_exile_part]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}]} */
repeat_top_exile ::= "as" "many" "times" "as" "you" "choose" "," "you" "may" repeat_top_exile_part

repeat_top_exile_part ::= repeat_top_exile_one

/* @sem CostPart::Move{selections:[_{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, choose:Exactly(Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
repeat_top_exile_one ::= "exile" "the" "top" "card" "of" "your" "library"

/* The stopping and moved filters are independent. The remainder excludes the
   actual objects moved before querying the library again. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$card_filter, count:ObjectProperty{object:EventSubject, property:SpellX, information:CurrentOrLastKnown}}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$card_filter_2}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:$rest_bottom}] */
instructions_reveal_x_move_remainder ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "X" card_filter "cards" "." "put" "all" card_filter "cards" "revealed" "this" "way" "into" "your" "graveyard" "," "then" "put" rest_bottom

/* This X names the spell in the cast event; keep the phrase in that scope. */
/* @sem Ability::Scoped{zones:[Stack], ability:@scope(Ability::Triggered{event:$repeat_cast_header, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$instructions_reveal_x_move_remainder}})} */
cast_reveal_x_move_trigger ::= repeat_cast_header "," instructions_reveal_x_move_remainder "."

/* The reveal, exile arrival and both uses of that arrival form one scoped block. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:$card_filter, count:Constant(1)}}, Effect{result:@mark, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:One(Query{objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$card_filter}, index:0}), zone:Exile}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:Library{position:BottomRandom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_exile_until_battlefield_bottom ::= "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" "a" card_filter "card" "." "put" "that" "card" "onto" "the" "battlefield" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* The revealed single library top is the same operand in both branches. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:$single_library_top}}, Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:Either, cards:$single_library_top, count:Exactly(Constant(1)), terms:_{cost:Free}}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:Move{objects:$single_library_top, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{}}] */
instructions_reveal_single_play_or_exile ::= "reveal" single_library_top "." "you" "may" "play" "that" "card" "without" "paying" "its" "mana" "cost" "." "if" "you" "don't" "," "exile" "it"

/* The life loss counts the arrival receipt of this specific hand move. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$named_hand_life, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:$library_order}}] */
dig_look_named_hand ::= look_top "." named_hand_life "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Instruction::[Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:InZone{objects:Observed(@marked), zone:Library}, count:AnyNumber, constraints:[AllWithChosenName]}], action:Move{objects:Prepared(@selection_id(0)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:CountObjects(Transition{result:@prior, phase:After})}}] */
named_hand_life ::= "choose" "one" "of" "them" "and" "put" "all" "cards" "with" "the" "same" "name" "as" "the" "chosen" "card" "from" "among" "them" "into" "your" "hand" "." "you" "lose" "1" "life" "for" "each" "card" "put" "into" "your" "hand" "this" "way"

/* The two phases share one player population and one exile producer. */
/* @sem Program::Program{instructions:[ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}), count:$top_count, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}, ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(Bound(0))), changes:[PlayerRule(PlayPermission{cards:Zone(_{scope:Shared(Exile), kind:Card, filter:InSet(Earlier{what:Exiled, by:One(Bound(0))})}), from:Exile, action:Either, filter:Any}), PlayerRule(Prohibit(PlayCard(InZone(Players{zone:Hand, players:One(Affected)}))))], duration:$duration, evaluation:LiveObjects}}]}}]} */
program_each_exiles_top_play_permission ::= "each" "player" "exiles" "the" "top" top_count "of" "their" "library" "." duration "," "players" "may" "play" "cards" "they" "exiled" "this" "way" "," "and" "they" "can't" "play" "cards" "from" "their" "hand" "."

/* Three separate filters are sought once each. The parent retains the seek
   receipt while later selections move cards from the controller's hand. */
/* @sem Operation::Seek{actor:One(AbilityController), cards:[$filter_phrase, $filter_phrase_2, $filter_phrase_3], count:Constant(1)} */
seek_three_distinct_cards ::= "seek" "a" filter_phrase "card" "," "a" filter_phrase "card" "," "and" "a" filter_phrase "card"

/* @sem Instruction::[Effect{result:@mark, operation:$seek_three_distinct_cards}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@marked, phase:After})}, count:AsManyAsCan($value)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Recorded(@marked))}, count:AsManyAsCan($value_2)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
seek_three_split_destinations ::= seek_three_distinct_cards "." "put" value "of" "them" "onto" "the" "battlefield" "and" "put" value "of" "them" "into" "your" "graveyard"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$seek_three_split_destinations}} */
spell_seek_three_split ::= seek_three_split_destinations "."

/* The remainder excludes the in-library reorder of the selected observed card.
   Keep the producer and both consumers in one inverse contract. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:UpTo(Constant(1))}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@prior), end:Top, order:Chosen}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:Exile{visibility:FaceUp, arrival:_{}}}}] */
dig_look_keep_exile ::= look_top "." "you" "may" "put" "one" "of" "those" "cards" "back" "on" "top" "of" "your" "library" "." "exile" "the" "rest"

/* Scope the exile producer with its permission and delayed cleanup: both
   consumers refer to the same arrival receipt. */
/* @sem Vec<Instruction>::[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$exile_cleanup_count, from:Top}, destination:Exile{visibility:FaceUp, arrival:_{}}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Zone(_{scope:Shared(Exile), kind:Card, filter:InSet(Transition{result:@prior, phase:After})}), from:Exile, action:Either, filter:Any})], duration:EndOfTurn, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, intervening_if:Compare{left:CountObjects(Zone(_{scope:Shared(Exile), kind:Card, filter:InSet(Transition{result:@back(3), phase:After})})), test:Compare{comparison:Greater, value:Constant(0)}}, body:_{instructions:[Effect{result:@next, operation:Move{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:InSet(Transition{result:@back(4), phase:After})}), destination:Library{position:$exile_cleanup_position, order:DestinationDefault, arrival:_{}}}}]}}}] */
instructions_exile_top_play_cleanup ::= "exile" "the" "top" exile_cleanup_count "." "you" "may" "play" "those" "cards" "this" "turn" "." "at" "the" "beginning" "of" "the" "next" "end" "step" "," "if" "any" "of" "those" "cards" "remain" "exiled" "," "put" "them" "on" "the" exile_cleanup_position "of" "your" "library" "in" "any" "order"

exile_cleanup_count ::= exile_cleanup_visited | exile_cleanup_life | exile_cleanup_fixed

/* @sem Expr::PlayerNumber{player:AbilityController, number:AttractionsVisitedThisTurn} */
exile_cleanup_visited ::= "X" "cards" "of" "your" "library" "," "where" "X" "is" "the" "number" "of" "Attractions" "you've" "visited" "this" "turn"

/* @sem Expr::PlayerNumber{player:AbilityController, number:Life} */
exile_cleanup_life ::= "X" "cards" "of" "your" "library" "," "where" "X" "is" "your" "life" "total"

/* @sem $count_plural */
exile_cleanup_fixed ::= count_plural "cards" "of" "your" "library"

exile_cleanup_position ::= exile_cleanup_bottom | exile_cleanup_top

/* @sem LibraryPosition::Bottom */
exile_cleanup_bottom ::= "bottom"

/* @sem LibraryPosition::Top */
exile_cleanup_top ::= "top"

/* The count is the Before receipt of this exact creature sacrifice.  Keeping
   producer and consumer together proves the receipt in both directions. */
/* @sem Instruction::[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:AnyNumber})}, Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:CountObjects(Transition{result:@prior, phase:Before})}}]), count:UpTo(Constant(1))}], also:[Graveyard], either:true}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, If{condition:Searched(@prior), then:_{instructions:[Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:_{}}] */
instructions_sacrifice_creatures_search ::= "sacrifice" "any" "number" "of" "creatures" "." "search" "your" "library" "and" "/" "or" "graveyard" "for" "a" filter_phrase "card" "with" "mana" "value" "less" "than" "or" "equal" "to" "the" "number" "of" "creatures" "sacrificed" "this" "way" "and" "put" "it" "onto" "the" "battlefield" "." "if" "you" "search" "your" "library" "this" "way" "," "shuffle"

/* A destruction producer and its dependent reveal/exile continuation share one scope. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$destroy_explicit_targets}, ...$destroyed_controller_reveal_followup]}} */
spell_destroy_controller_reveal ::= destroy_explicit_targets "." destroyed_controller_reveal_followup

/* @sem Operation::Destroy{objects:$objects_targets_plain, regeneration:true} */
destroy_explicit_targets ::= "destroy" objects_targets_plain

/* @sem Vec<Instruction>::[ForEachObject{objects:Transition{result:0, phase:Before}, binding:0, body:_{instructions:[Effect{result:@next, operation:RevealUntil{library:ControllerOf(Bound(0)), filter:$filter_phrase, count:$counter_amount}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@prior), filter:$filter_phrase}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}, ForEachPlayer{players:Matching{binding:0, condition:Compare{left:CountObjects(MovedBy{result:2, phase:After, player:Bound(0)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}, binding:0, body:_{instructions:[Effect{result:@next, operation:Move{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:InSet(Earlier{what:Exiled, by:One(Bound(0))})}), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}, Effect{result:@next, operation:Shuffle{players:Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:Transition{result:0, phase:Before}, filter:ControlledBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}}}] */
destroyed_controller_reveal_followup ::= "for" "each" "permanent" "destroyed" "this" "way" "," "its" "controller" "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" counter_amount filter_phrase "card" "is" "revealed" "and" "exiles" "that" "card" "." "those" "players" "put" "the" "exiled" "cards" "onto" "the" "battlefield" "," "then" "shuffle" "."

/* Keep the exile producer and its choice together so the receipt cannot refer to another action. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:ObjectProperty{object:EventSubject, property:$death_exile_stat, information:CurrentOrLastKnown}, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Transition{result:@prior, phase:After}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:$play_that_card_permission}]} */
death_exile_top_choose_play_program ::= "exile" "a" "number" "of" "cards" "from" "the" "top" "of" "your" "library" "equal" "to" "its" death_exile_stat "," "then" "choose" "a" "card" "exiled" "this" "way" "." play_that_card_permission

death_exile_stat ::= stat_power | stat_toughness

/* The seek's hand arrival is the subject of the perpetual change. */
/* @prefer always */
/* @sem Instruction::[...$clause_seek_card, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$change_base_retained_creature}}] */
clause_seek_perpetual_retained ::= clause_seek_card "." "that" "card" "perpetually" change_base_retained_creature

/* Base statistics and added creature types remain independent operands. */
/* @sem Change::[SetBasePowerToughness{power:$value, toughness:$value_2}, CreatureTypes{mode:Add, types:Listed($becomes_types)}, AddCardType(Creature)] */
change_base_retained_creature ::= "has" "base" "power" "and" "toughness" value "/" value "and" "becomes" "a" becomes_types "creature" "in" "addition" "to" "its" "other" "types"

/* Search choices restricted to cards with at least one basic land type. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:@and($filter_phrase, ObjectFilter::AnyOf([Subtype(Forest), Subtype(Island), Subtype(Mountain), Subtype(Plains), Subtype(Swamp)])), count:UpTo($value)}]} */
search_basic_land_types ::= "search" "your" "library" "for" "up" "to" value filter_phrase "cards" "that" "each" "have" "a" "basic" "land" "type"

/* A completed instruction precedes a separately defined library observation. */
/* @sem Program::Program{instructions:[...$clause, Effect{result:@next, operation:BindValue{value:$value}}, Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:BoundValue(@prior), from:Top}}}, ...$look_top_split]} */
program_clause_look_where ::= clause "." "look" "at" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" value "." look_top_split

/* Keep the search selection attached to the immediately preceding search. */
/* @sem Instruction::[Effect{result:@next, operation:$search_basic_land_types}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
clause_search_basic_types_tapped ::= search_basic_land_types "," "put" "them" "onto" "the" "battlefield" "tapped" "," "then" "shuffle"

/* The initial graveyard choice and the subsequent search/exile are both
   producers: keep them in scope when spelling the owner's draw count. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:OpponentsOf(AbilityController)}, kind:Card, filter:Any}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:OwnerOf(Result{result:@prior, phase:After, index:0}), choices:[_{filter:SharesNameWith(Result{result:@prior, phase:After, index:0}), count:$named_search_count}], also:[Graveyard, Hand]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(OwnerOf(Result{result:@back(4), phase:After, index:0}))}}, Effect{result:@next, operation:Draw{players:One(OwnerOf(Result{result:@back(3), phase:After, index:0})), amount:CountObjects(InZone{objects:Transition{result:@back(3), phase:Before}, zone:Hand})}}] */
graveyard_name_exile_draw ::= "exile" "a" "card" "from" "an" "opponent's" "graveyard" "." "then" "search" "its" "owner's" "graveyard" "," "hand" "," "and" "library" "for" named_search_count "cards" "with" "that" "name" "and" "exile" "them" "." "that" "player" "shuffles" "," "then" "draws" "a" "card" "for" "each" "card" "exiled" "from" "their" "hand" "this" "way"

/* An independent preceding action and condition compose with the scoped episode. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$destroy}, If{condition:$condition, then:Program{instructions:$graveyard_name_exile_draw}, otherwise:Program{}}]}} */
spell_destroy_conditional_graveyard_names ::= destroy "." "if" condition "," graveyard_name_exile_draw "."

/* The observation and movement receipts are scoped together with the remainder. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$noun}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{player:EventSubject}]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{player:EventSubject}]}}, qualifiers:[]}}, Effect{result:@next, operation:$rest_bottom}] */
instructions_look_attacking_remainder ::= look_top "." "you" "may" "put" "a" noun "card" "from" "among" "them" "onto" "the" "battlefield" "tapped" "and" "attacking" "that" "player" "." "put" rest_bottom

/* The permission consumes the search's exile move; keep the producer and
   consumer together so inverse printing proves the destination and receipt. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$named_exile_target}, Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:OwnerOf(Result{result:@prior, phase:After, index:0}), choices:[_{filter:SharesNameWith(Result{result:@prior, phase:After, index:0}), count:AnyNumber}], also:[Graveyard, Hand]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(OwnerOf(Result{result:@back(4), phase:After, index:0}))}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@back(3), phase:After}, from:Exile, action:$exiled_play_action, filter:Any}, terms:_{limit:Total(1), cost:Normal, spend_as:AnyColor}})], duration:WhileControlled{player:AbilityController, object:$self_explicit_ref}, evaluation:LiveObjects}}]} */
named_exile_search_permission_program ::= named_exile_target "." "search" "that" "player's" "graveyard" "," "hand" "," "and" "library" "for" "any" "number" "of" "cards" "with" "the" "same" "name" "as" "that" "card" "and" "exile" "them" "." "then" "that" "player" "shuffles" "." "for" "as" "long" "as" "you" "control" self_explicit_ref "," "you" "may" exiled_play_action "one" "of" "the" "exiled" "cards" "," "and" "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "it" "."

/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([Not(AllOf([Supertype(Basic), $noun])), InZone(Players{zone:Graveyard, players:OpponentsOf(AbilityController)})])}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
named_exile_target ::= "exile" "target" "card" "other" "than" "a" "basic" noun "card" "from" "an" "opponent's" "graveyard"

/* The single revealed query is reused by the test and the subsequent cast.
   The opponent who may cast is the controller of the event spell. */
/* @sem ObjectFilter::Shares{property:CardTypes, with:EventSubject} */
reveal_shares_event_property ::= "shares" "a" "card" "type" "with" "that" "spell"

/* @sem ObjectFilter::Shares{property:Colors, with:EventSubject} */
reveal_shares_event_color ::= "shares" "a" "color" "with" "that" "spell"

/* @sem ObjectFilter::Shares{property:CreatureTypes, with:EventSubject} */
reveal_shares_event_creature_type ::= "shares" "a" "creature" "type" "with" "that" "spell"

reveal_shares_event ::= reveal_shares_event_property | reveal_shares_event_color | reveal_shares_event_creature_type

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Reveal{objects:$single_library_top}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[If{condition:Compare{left:CountObjects(Matching{objects:$single_library_top, filter:$reveal_shares_event}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:Counter{objects:One(EventSubject), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}, Optional{decider:ControllerOf(EventSubject), body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(ControllerOf(EventSubject)), action:CastSpell, cards:$single_library_top, count:Exactly(Constant(1)), terms:_{cost:Free}}}]}}]}, otherwise:Program{}}]}, otherwise:Program{}}] */
instructions_optional_reveal_shared_counter ::= "you" "may" "reveal" single_library_top "." "if" "it" reveal_shares_event "," "counter" "that" "spell" "and" "that" "opponent" "may" "cast" "the" "revealed" "card" "without" "paying" "its" "mana" "cost"

/* This continuation keeps the reveal, exile, optional cast and bottom move
   together so that both uses of the arrival receipt name this exile. */
/* @sem Instruction::[Effect{result:@next, operation:Mill{players:One(ControllerOf(Target{slot:0, index:0})), amount:ChosenNumber}}, Effect{result:@next, operation:RevealUntil{library:ControllerOf(Target{slot:0, index:0}), filter:AllOf([$card_filter, Not(SharesNameWith(Target{slot:0, index:0}))]), count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Optional{decider:ControllerOf(Target{slot:0, index:0}), body:_{instructions:[Effect{result:@next, operation:PlayCards{actor:One(ControllerOf(Target{slot:0, index:0})), action:CastSpell, cards:One(Query{objects:Matching{objects:Transition{result:@prior, phase:After}, filter:AllOf([$card_filter, Not(SharesNameWith(Target{slot:0, index:0}))])}, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@back(3), phase:After}, zone:Exile}, destination:Library{position:BottomRandom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
spell_controller_mill_exile_cast_bottom ::= "its" "controller" "mills" "that" "many" "cards" "," "then" "exiles" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "exile" "a" card_filter "card" "with" "a" "different" "name" "than" "that" "spell" "." "they" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" "." "then" "they" "put" "the" "exiled" "cards" "on" "the" "bottom" "of" "their" "library" "in" "a" "random" "order"

/* The counter announces the spell which anchors every controller and name. */
/* @sem Instruction::[Effect{result:@next, operation:Counter{objects:One($target_stack_spell), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}, Effect{result:@next, operation:$choose_three_numbers_random}, ...$spell_controller_mill_exile_cast_bottom] */
instructions_counter_random_controller_exile ::= "counter" target_stack_spell "." choose_three_numbers_random "." spell_controller_mill_exile_cast_bottom

/* A complete spell owns the sole target slot used by the continuation. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_counter_random_controller_exile}} */
spell_counter_random_controller_exile ::= instructions_counter_random_controller_exile "."

/* Keep both reveal choices and their respective observations in one scope. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[_{instructions:[Effect{result:@next, operation:RevealFromHand{actor:One(AbilityController), cards:Any, count:Constant(1)}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@last_result), filter:$reveal_choice_filter}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:_{instructions:[Effect{result:@next, operation:Move{objects:One(Query{objects:Observed(@prior), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:_{}}]}, _{instructions:[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@last_result), filter:$reveal_choice_filter}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:_{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:_{}}]}]}] */
instructions_reveal_hand_or_top_battlefield ::= "reveal" "a" "card" "from" "your" "hand" "or" "the" "top" "card" "of" "your" "library" "." "if" "you" "reveal" "a" reveal_choice_filter "card" "this" "way" "," "put" "it" "onto" "the" "battlefield"

reveal_choice_filter ::= filter_phrase | spell_instant | spell_sorcery

/* The damage receipt and its excess count are constructed together, so the
   count cannot be printed for an unrelated producer. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AnyOf([$noun, $noun_2, CardType(Battle)])}), index:0})), amount:$number, preventable:true}}, Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:ExcessDamage{result:@prior, to:Any}, from:Top}}}] */
damage_excess_look_top ::= self_named "deals" number "damage" "to" "target" noun "," noun "," "or" "battle" "." "look" "at" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" "the" "excess" "damage" "dealt" "this" "way"

/* Selection, exile, remainder and permission share the observed and moved
   receipts. Their destinations are part of this inverse contract. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@back(3), phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}] */
look_exile_one_play_remainder ::= "you" "may" "exile" "one" "of" "those" "cards" "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order "." "you" "may" "play" "the" "exiled" "card" this_duration

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$damage_excess_look_top, ...$look_exile_one_play_remainder]}} */
spell_damage_excess_look_play ::= damage_excess_look_top "." look_exile_one_play_remainder "."

/* The permission and the remainder both refer to this face-down exile, not
   an arbitrary earlier transition. The singular pronoun fixes the choice to one. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
look_exile_one_face_down ::= "exile" "one" "face" "down"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:One(Result{result:@back(3), phase:After, index:0}), audience:AffectedPlayer}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@back(3), phase:After, index:0}), from:Exile, action:CastSpell, filter:$noun}, terms:_{cost:Normal}})], duration:WhileExiled(Result{result:@back(3), phase:After, index:0}), evaluation:LiveObjects}}] */
look_exiled_singular_permission ::= "for" "as" "long" "as" "it" "remains" "exiled" "," "you" "may" "cast" "it" "if" "it's" "a" noun "spell"

/* @sem Instruction::[Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
look_exile_remainder ::= "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$look_exile_one_face_down, ...$look_exile_remainder, ...$look_exiled_singular_permission] */
instructions_look_exile_hidden_permission ::= look_top "." look_exile_one_face_down "and" look_exile_remainder "." look_exiled_singular_permission

/* A private look followed by selection for face-up exile and a shuffle. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$noun}, count:UpTo($number), constraints:[CanMoveTo{destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
look_exile_up_to_shuffle ::= look_top "," "exile" "up" "to" number noun "cards" "from" "among" "them" "," "then" "shuffle"

/* The two later moves both name the actual exile above; keeping the whole
   span together prevents an unrelated transition from printing as exiled. */
/* @sem Instruction::[...$look_exile_up_to_shuffle, Optional{decider:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0}, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:Target{slot:0, index:0}, objects:Transition{result:@back(3), phase:After}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(Target{slot:0, index:0}), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@back(5), phase:After}, zone:Exile}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
instructions_look_exile_opponent_split ::= look_exile_up_to_shuffle "." "target" "opponent" "may" "choose" "one" "of" "the" "exiled" "cards" "and" "put" "it" "onto" "the" "battlefield" "under" "their" "control" "." "put" "the" "rest" "onto" "the" "battlefield" "under" "your" "control"

/* One observed library slice supplies the choice and the remainder; the
   remainder excludes the actual move, not the preceding choice. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:CardType(Creature)}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
look_optional_attacking_entry ::= look_top "." "you" "may" "put" "a" "creature" "card" "from" "among" "them" "onto" "the" "battlefield" "tapped" "and" "attacking" "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* The delayed return names the actual battlefield arrival. */
/* @sem Program::Program{instructions:[...$look_optional_attacking_entry, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, expires:EndOfCombat, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@back(4), phase:After, index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}}]} */
program_look_attacking_return ::= look_optional_attacking_entry "." "return" "that" "creature" "to" "its" "owner's" "hand" "at" "end" "of" "combat" "."

/* The observation, the top-card exile payment and its permission are scoped
   together: the condition and payment both refer to the same top card. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PlayersDo{players:One(AbilityController), any_one:false, optional:true, once_each_turn:true, body:[Program(_{instructions:[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@last_result), filter:Property{property:ManaValue, test:$die_result_comparison}}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:_{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:_{parts:[Move{selections:[_{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, choose:Exactly(Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0}), from:Exile, action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}]}, otherwise:_{}}]}, otherwise:_{}}]})], otherwise:[]}}]} */
program_sentence_reveal_die_result ::= "you" "may" "reveal" "the" "top" "card" "of" "your" "library" "." action_once_suffix "whenever" "you" "reveal" "a" "card" "with" "mana" "value" die_result_comparison "this" "way" "," "you" "may" "exile" "it" "." "if" "you" "do" "," "you" "may" "play" "it" this_duration "."

die_result_comparison ::= die_result_less | die_result_greater

/* @sem NumberTest::Compare{comparison:Less, value:Dice(Result)} */
die_result_less ::= "less" "than" "the" "result"

/* @sem NumberTest::Compare{comparison:Greater, value:Dice(Result)} */
die_result_greater ::= "greater" "than" "the" "result"

/* The granted ability belongs to the actual exiled card. The fixed producer
   and its marked arrival are matched together in both directions. */
/* @sem Instruction::[...$card_exile_value_producer, Effect{result:@next, operation:EffectOn{subject:Objects(One(Result{result:@marked, phase:After, index:0})), effects:[Term{family:ExiledCardEffect, form:AddAbility, operands:[Ability(Scoped{zones:[Exile], condition:$condition_cast_another_spell, ability:Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Source), from:Exile, action:CastSpell, filter:Any})]})})]}]}}] */
instructions_exile_top_grant_cast_condition ::= card_exile_value_producer "." "for" "as" "long" "as" "it" "remains" "exiled" "," "it" "has" '"' "you" "may" "cast" "this" "card" "from" "exile" "as" "long" "as" condition_cast_another_spell "." '"'

/* Keep the exile producer, choice receipt and spending permission in one scope. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$ordered_cards, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Transition{result:@prior, phase:After}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:Either, filter:Any}, terms:_{cost:Normal, spend_as:$exiled_spending}})], duration:$duration, evaluation:LiveObjects}}] */
clause_exile_choose_one_play_spending ::= "exile" ordered_cards "." "choose" "one" "of" "them" "." duration "," "you" "may" "play" "that" "card" "," "and" exiled_spending

/* A card's mana value is compared with the current expression. */
/* @sem ObjectFilter::Property{property:ManaValue, test:$seek_mana_value_test} */
a_card_mana_value_comparison ::= "a" "card" "with" "mana" "value" seek_mana_value_test

seek_mana_value_test ::= seek_mana_value_less | seek_mana_value_greater

/* @sem NumberTest::Compare{comparison:Less, value:$live_card_count_value} */
seek_mana_value_less ::= "less" "than" live_card_count_value

/* @sem NumberTest::Compare{comparison:Greater, value:$live_card_count_value} */
seek_mana_value_greater ::= "greater" "than" live_card_count_value

/* Count only an explicit live zone population; receipt counts need a producer proof. */
/* @sem Expr::CountObjects($card_population_plain) */
live_card_count_value ::= "the" "number" "of" card_population_plain

/* The optional reveal and its conditional move share the same top-card query. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:_{instructions:[If{condition:Compare{left:CountObjects(Matching{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:_{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:_{}}]}, otherwise:_{}}] */
instructions_optional_top_reveal_move ::= "you" "may" "reveal" "the" "top" "card" "of" "your" "library" "." "if" top_reveal_quality "is" "revealed" "this" "way" "," "put" "it" "onto" "the" "battlefield" "tapped"

/* One revealed card can satisfy any of the independently named alternatives. */
reveal_until_card ::= reveal_until_single_card | reveal_until_companion_card_union

/* @sem ObjectFilter::$card_filter */
reveal_until_single_card ::= ("a" | "an") card_filter "card"

/* @sem ObjectFilter::AnyOf([$filter_phrase, HasKeywordFamily(DoctorsCompanion), $filter_phrase_2]) */
reveal_until_companion_card_union ::= "a" filter_phrase "card" "," "a" "card" "with" "doctor's" "companion" "," "or" "a" filter_phrase "card"

/* The permission is tied to the single card actually exiled by this producer. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:UntilEndOfNextTurn(AbilityController), evaluation:LiveObjects}}] */
instructions_exile_top_next_turn_play_it ::= "exile" "the" "top" "card" "of" "your" "library" "." "until" "the" "end" "of" "your" "next" "turn" "," "you" "may" "play" "it"

/* The permission refers to the single card produced by this exact exile. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:Either, filter:Any}, terms:_{cost:Normal, condition:Compare{left:EventHistory{event:Batch{event:Counters(_{change:Put, kind:Named(LoreCounter), objects:SameObject(Source), by:One(AbilityController)}), per:Subject}, window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}})], duration:Indefinite, evaluation:LiveObjects}}] */
instructions_exile_top_saga_permission ::= "exile" "the" "top" "card" "of" "your" "library" "." "during" "any" "turn" "you" "put" "a" "lore" "counter" "on" "this" "Saga" "," "you" "may" "play" "that" "card"

/* Move both private zones together, shuffle, then draw the stated amount. */
/* @sem Instruction::[Group(Program{instructions:[Effect{result:@next, operation:Move{objects:Union([Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any})]), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}), Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}] */
clause_your_hand_graveyard_shuffle_draw ::= "shuffle" "your" "hand" "and" "graveyard" "into" "your" "library" "," "then" "draw" card_count

/* The additional players finish shuffling before drawing. */
/* @sem Instruction::[ForEachPlayer{players:$shuffle_plural_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Union([Zone(_{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any})]), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}, Effect{result:@next, operation:Draw{players:$shuffle_plural_players, amount:$card_count}}] */
clause_also_shuffle_hands_graveyards_draw ::= shuffle_plural_players "also" "shuffles" "their" "hand" "and" "graveyard" "into" "their" "library" "," "then" "draws" card_count

/* The chosen card returns to the same targeted library; the remainder excludes
   precisely that reorder's input. */
/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One($target_possessive)}, kind:Card, filter:Any}, count:$number_words, from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:$target_possessive, objects:Selected(@prior), end:Top, order:Chosen}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_target_library_partition ::= "look" "at" "the" "top" number_words "cards" "of" target_possessive "library" "." "put" "one" "back" "and" "the" "rest" "into" "that" "player's" "graveyard"

/* The choice and the remainder are kept within each alternative, so the
   remainder excludes that alternative's actual move receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($number), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
observed_cards_to_hand ::= "put" number "of" "those" "cards" "into" "your" "hand"

/* @sem Instruction::Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}} */
observed_hand_remainder ::= "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Ability::CostBranch{keyword:Kicker, cost:$kicker_branch_header, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:$look_at_top_x_cards}, ...$observed_cards_to_hand_2, $observed_hand_remainder]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:$look_at_top_x_cards}, ...$observed_cards_to_hand, $observed_hand_remainder]}})} */
spell_kicker_look_hand ::= kicker_branch_header NEWLINE look_at_top_x_cards "." observed_cards_to_hand "." "if" "this" "spell" "was" "kicked" "," observed_cards_to_hand "instead" "." observed_hand_remainder "."

/* Keep the reveal, exile arrival, permission, and remainder together: both
   references are derived from this producer and use the same stopping filter. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:$spell_filter}, duration:EndOfTurn, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:@and($filter_phrase, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}}), count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Query{objects:Matching{objects:Transition{result:@prior, phase:After}, filter:@and($filter_phrase, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}})}, index:0}), from:Exile, action:CastSpell, filter:Any}, terms:_{cost:Free}})], duration:EndOfTurn, evaluation:LiveObjects}}, Effect{result:@next, operation:Move{objects:InZone{objects:Matching{objects:Transition{result:@back(3), phase:After}, filter:Not(@and($filter_phrase, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}}))}, zone:Exile}, destination:Library{position:BottomRandom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}, once:true}}] */
clause_next_cast_exile_until_free ::= "when" "you" "next" "cast" spell_filter "this" "turn" "," "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" "an" filter_phrase "card" "with" "lesser" "mana" "value" "." "until" "end" "of" "turn" "," "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" "." "put" "each" "other" "card" "exiled" "this" "way" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* Keep the look, selection, exile destination and remaining cards in one
   producer-consumer scope for recognition and inverse printing. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[[$counter_kind, $counter_amount]], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[[$counter_kind, $counter_amount]], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Chosen}}] */
dig_look_exile_counter ::= look_top "." "exile" "one" "of" "them" "face" "down" "with" counter_amount counter_kind "counter" "on" "it" "," "then" "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "any" "order"

/* The same searched card is revealed and routed by its printed type test. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_filtered]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, If{condition:Compare{left:CountObjects(Matching{objects:Selected(@marked), filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_search_reveal_partition ::= "search" "your" "library" "for" search_choice_filtered "and" "reveal" "it" "." "put" "it" "onto" "the" "battlefield" "tapped" "if" "it's" "a" card_filter "card" "." "otherwise" "," "put" "it" "into" "your" "hand" "." "then" "shuffle"

/* The paid life determines the observed library population and the remainder
   excludes the cards actually moved to their owners' hands. */
/* @sem Instruction::[Effect{result:@next, operation:PayAnyAmount{actor:One(AbilityController), resource:Life}}, Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Performed(@prior), from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($number_words), constraints:[CanMoveTo{destination:OwnersHand{}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand{}}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(2), phase:Before}])}, zone:Library}, destination:Exile{visibility:FaceUp, arrival:_{}}}}] */
instructions_pay_life_look_choose_exile ::= "pay" "any" "amount" "of" "life" "," "then" "look" "at" "that" "many" "cards" "from" "the" "top" "of" "your" "library" "." "put" number_words "of" "those" "cards" "into" "your" "hand" "and" "exile" "the" "rest"

/* Keep the reveal, exile receipt, permission and remainder in one scope: the
   stopped card and the rest are both derived from this exact exile. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:$card_filter, count:Constant(1)}}, Effect{result:@mark, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:$object_ref, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Query{objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$card_filter}, index:0}), from:Exile, action:Either, filter:Any})], duration:WhileOnBattlefield($object_ref), evaluation:LiveObjects}}, Effect{result:@next, operation:Move{objects:InZone{objects:Matching{objects:Transition{result:@marked, phase:After}, filter:Not($card_filter)}, zone:Exile}, destination:Library{position:BottomRandom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
instructions_exile_until_play_remainder ::= "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" "a" card_filter "card" "." "you" "may" "play" "that" "card" "for" "as" "long" "as" object_ref "remains" "on" "the" "battlefield" "." "put" "the" "rest" "of" "those" "exiled" "cards" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* Three independent choices retain the same search receipt through the follow-up. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_filtered, $search_choice_filtered_2, $search_choice_filtered_3]} */
search_three_choices ::= "search" "your" "library" "for" search_choice_filtered "," search_choice_filtered "," "and" search_choice_filtered

/* @sem Instruction::[Effect{result:@mark, operation:$search_three_choices}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_search_three_reveal_hand ::= search_three_choices "." "reveal" "those" "cards" "," "put" "them" "into" "your" "hand" "," "then" "shuffle"

/* @sem Instruction::[Effect{result:@mark, operation:$search}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Discard{players:One(AbilityController), amount:$card_count, random:true}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_search_reveal_hand_discard ::= search "and" "reveal" "that" "card" "." "put" "it" "into" "your" "hand" "," "then" "discard" card_count "at" "random" "." "then" "shuffle"

/* One top card per named vote, from the ability controller's library. */
/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:$count_each_vote, from:Top} */
library_top_per_vote ::= "the" "top" "card" "of" "your" "library" "for" "each" count_each_vote

/* The named-per-creature choice retains its population independently of the
   card filter. The ordinary found-card action and shuffle follow the search. */
/* @sem SearchChoice::SearchChoice{filter:$filter_phrase, count:AnyNumber, constraints:[NamedAfterOneEach($each_counter_creature)]} */
search_choice_named_each_creature ::= "for" each_counter_creature "," "you" "may" "search" "your" "library" "for" ("a" | "an") filter_phrase "card" "with" "the" "same" "name" "as" "that" "creature"

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_named_each_creature]}}, Effect{result:@next, operation:$found_those_action}, ...$search_follow]}}] */
clause_search_named_each ::= search_choice_named_each_creature "." found_those_action search_follow

found_those_action ::= found_those_battlefield | found_those_battlefield_tapped | found_those_exile | found_those_reveal

/* @sem Operation::@search_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}) */
found_those_battlefield ::= "put" "those" "cards" "onto" "the" "battlefield"

/* @sem Operation::@search_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}) */
found_those_battlefield_tapped ::= "put" "those" "cards" "onto" "the" "battlefield" "tapped"

/* @sem Operation::Reveal{objects:Selected(@marked)} */
found_those_reveal ::= "reveal" "those" "cards"

/* @sem Operation::Move{objects:Selected(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
found_those_exile ::= "exile" "those" "cards"

/* The observation and its remaining library cards share one scoped receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:$cloak_observed_cards}, Effect{result:@next, operation:$observed_remainder_bottom}] */
dig_look_cloak ::= look_top "," cloak_observed_cards "," "and" observed_remainder_bottom

/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), objects:InZone{objects:Observed(@marked), zone:Library}, chooser:Players(One(AbilityController)), count:Exactly($value)}], action:Manifest{actor:One(AbilityController), source:Cards(Prepared(@selection_id(0))), cloak:true, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}} */
cloak_observed_cards ::= "cloak" value "of" "them"

/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:$library_order} */
observed_remainder_bottom ::= "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order
