/* @sem Instruction::[Effect{result:@next, operation:Mill{players:One(ControllerOf(Target{slot:0, index:0})), amount:ChosenNumber}}, Effect{result:@next, operation:RevealUntil{library:ControllerOf(Target{slot:0, index:0}), filter:AllOf([$card_filter, Not(SharesNameWith(Target{slot:0, index:0}))]), count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Optional{decider:ControllerOf(Target{slot:0, index:0}), body:_{instructions:[Effect{result:@next, operation:PlayCards{actor:One(ControllerOf(Target{slot:0, index:0})), action:CastSpell, cards:One(Query{objects:Matching{objects:Transition{result:@prior, phase:After}, filter:AllOf([$card_filter, Not(SharesNameWith(Target{slot:0, index:0}))])}, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@back(3), phase:After}, zone:Exile}, destination:Library{position:BottomRandom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
spell_controller_mill_exile_cast_bottom ::= "its" "controller" "mills" "that" "many" "cards" "," "then" "exiles" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "exile" "a" card_filter "card" "with" "a" "different" "name" "than" "that" "spell" "." "they" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" "." "then" "they" "put" "the" "exiled" "cards" "on" "the" "bottom" "of" "their" "library" "in" "a" "random" "order"

/* The counter announces the spell which anchors every controller and name. */
/* @sem Instruction::[Effect{result:@next, operation:Counter{objects:One($target_stack_spell), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}, Effect{result:@next, operation:$choose_three_numbers_random}, ...$spell_controller_mill_exile_cast_bottom] */
instructions_counter_random_controller_exile ::= "counter" target_stack_spell "." choose_three_numbers_random "." spell_controller_mill_exile_cast_bottom

/* A complete spell owns the sole target slot used by the continuation. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_counter_random_controller_exile}} */
spell_counter_random_controller_exile ::= instructions_counter_random_controller_exile "."

/* Keep both reveal choices and their respective observations in one scope. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[_{instructions:[Effect{result:@next, operation:RevealFromHand{actor:One(AbilityController), cards:Any, count:Constant(1)}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@last_result), filter:$reveal_choice_filter}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:_{instructions:[Effect{result:@next, operation:Move{objects:One(Query{objects:Observed(@prior), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:_{}}]}, _{instructions:[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@last_result), filter:$reveal_choice_filter}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:_{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:_{}}]}]}] */
instructions_reveal_hand_or_top_battlefield ::= "reveal" "a" "card" "from" "your" "hand" "or" "the" "top" "card" "of" "your" "library" "." "if" "you" "reveal" "a" reveal_choice_filter "card" "this" "way" "," "put" "it" "onto" "the" "battlefield"

reveal_choice_filter ::= filter_phrase | spell_instant | spell_sorcery

/* The damage receipt and its excess count are constructed together, so the
   count cannot be printed for an unrelated producer. */
/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AnyOf([$noun, $noun_2, CardType(Battle)])}), index:0})), amount:$number, preventable:true}}, Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:ExcessDamage{result:@prior, to:Any}, from:Top}}}] */
damage_excess_look_top ::= self_named "deals" number "damage" "to" "target" noun "," noun "," "or" "battle" "." "look" "at" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" "the" "excess" "damage" "dealt" "this" "way"

/* Selection, exile, remainder and permission share the observed and moved
   receipts. Their destinations are part of this inverse contract. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@back(3), phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}] */
look_exile_one_play_remainder ::= "you" "may" "exile" "one" "of" "those" "cards" "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order "." "you" "may" "play" "the" "exiled" "card" this_duration

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$damage_excess_look_top, ...$look_exile_one_play_remainder]}} */
spell_damage_excess_look_play ::= damage_excess_look_top "." look_exile_one_play_remainder "."

/* The permission and the remainder both refer to this face-down exile, not
   an arbitrary earlier transition. The singular pronoun fixes the choice to one. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
look_exile_one_face_down ::= "exile" "one" "face" "down"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:One(Result{result:@back(3), phase:After, index:0}), audience:AffectedPlayer}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@back(3), phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:CastSpell, filter:$noun}, terms:_{cost:Normal}})], duration:WhileExiled(Result{result:@back(3), phase:After, index:0}), evaluation:LiveObjects}}] */
look_exiled_singular_permission ::= "for" "as" "long" "as" "it" "remains" "exiled" "," "you" "may" "cast" "it" "if" "it's" "a" noun "spell"

/* @sem Instruction::[Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
look_exile_remainder ::= "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$look_exile_one_face_down, ...$look_exile_remainder, ...$look_exiled_singular_permission] */
instructions_look_exile_hidden_permission ::= look_top "." look_exile_one_face_down "and" look_exile_remainder "." look_exiled_singular_permission

/* A private look followed by selection for face-up exile and a shuffle. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$noun}, count:UpTo($number), constraints:[CanMoveTo{destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
look_exile_up_to_shuffle ::= look_top "," "exile" "up" "to" number noun "cards" "from" "among" "them" "," "then" "shuffle"

/* The two later moves both name the actual exile above; keeping the whole
   span together prevents an unrelated transition from printing as exiled. */
/* @sem Instruction::[...$look_exile_up_to_shuffle, Optional{decider:Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:OpponentsOf(AbilityController)}), index:0}, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:Target{slot:0, index:0}, objects:Transition{result:@back(3), phase:After}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(Target{slot:0, index:0}), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@back(5), phase:After}, zone:Exile}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
instructions_look_exile_opponent_split ::= look_exile_up_to_shuffle "." "target" "opponent" "may" "choose" "one" "of" "the" "exiled" "cards" "and" "put" "it" "onto" "the" "battlefield" "under" "their" "control" "." "put" "the" "rest" "onto" "the" "battlefield" "under" "your" "control"

/* One observed library slice supplies the choice and the remainder; the
   remainder excludes the actual move, not the preceding choice. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:CardType(Creature)}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
look_optional_attacking_entry ::= look_top "." "you" "may" "put" "a" "creature" "card" "from" "among" "them" "onto" "the" "battlefield" "tapped" "and" "attacking" "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* The delayed return names the actual battlefield arrival. */
/* @sem Program::Program{instructions:[...$look_optional_attacking_entry, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:CombatEnds, players:All}, start:Immediately, expires:EndOfCombat, body:_{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@back(4), phase:After, index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}}]} */
program_look_attacking_return ::= look_optional_attacking_entry "." "return" "that" "creature" "to" "its" "owner's" "hand" "at" "end" "of" "combat" "."

/* The observation, the top-card exile payment and its permission are scoped
   together: the condition and payment both refer to the same top card. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:PlayersDo{players:One(AbilityController), any_one:false, optional:true, once_each_turn:true, body:[Program(_{instructions:[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@last_result), filter:Property{property:ManaValue, test:$die_result_comparison}}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:_{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:_{parts:[Move{selections:[_{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, choose:Exactly(Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}]}, otherwise:_{}}]}, otherwise:_{}}]})], otherwise:[]}}]} */
program_sentence_reveal_die_result ::= "you" "may" "reveal" "the" "top" "card" "of" "your" "library" "." action_once_suffix "whenever" "you" "reveal" "a" "card" "with" "mana" "value" die_result_comparison "this" "way" "," "you" "may" "exile" "it" "." "if" "you" "do" "," "you" "may" "play" "it" this_duration "."

die_result_comparison ::= die_result_less | die_result_greater

/* @sem NumberTest::Compare{comparison:Less, value:Dice(Result)} */
die_result_less ::= "less" "than" "the" "result"

/* @sem NumberTest::Compare{comparison:Greater, value:Dice(Result)} */
die_result_greater ::= "greater" "than" "the" "result"

/* The granted ability belongs to the actual exiled card. The fixed producer
   and its marked arrival are matched together in both directions. */
/* @sem Instruction::[...$card_exile_value_producer, Effect{result:@next, operation:EffectOn{subject:Objects(One(Result{result:@marked, phase:After, index:0})), effects:[Term{family:ExiledCardEffect, form:AddAbility, operands:[Ability(Scoped{zones:[Exile], condition:$condition_cast_another_spell, ability:Static(_{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Source), origins:CardPlayOrigins([Exile]), action:CastSpell, filter:Any})]})})]}]}}] */
instructions_exile_top_grant_cast_condition ::= card_exile_value_producer "." "for" "as" "long" "as" "it" "remains" "exiled" "," "it" "has" '"' "you" "may" "cast" "this" "card" "from" "exile" "as" "long" "as" condition_cast_another_spell "." '"'

/* Keep the exile producer, choice receipt and spending permission in one scope. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$ordered_cards, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Transition{result:@prior, phase:After}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any}, terms:_{cost:Normal, spend_as:$exiled_spending}})], duration:$duration, evaluation:LiveObjects}}] */
clause_exile_choose_one_play_spending ::= "exile" ordered_cards "." "choose" "one" "of" "them" "." duration "," "you" "may" "play" "that" "card" "," "and" exiled_spending

/* A card's mana value is compared with the current expression. */
/* @sem ObjectFilter::Property{property:ManaValue, test:$seek_mana_value_test} */
a_card_mana_value_comparison ::= "a" "card" "with" "mana" "value" seek_mana_value_test

seek_mana_value_test ::= seek_mana_value_less | seek_mana_value_greater

/* @sem NumberTest::Compare{comparison:Less, value:$live_card_count_value} */
seek_mana_value_less ::= "less" "than" live_card_count_value

/* @sem NumberTest::Compare{comparison:Greater, value:$live_card_count_value} */
seek_mana_value_greater ::= "greater" "than" live_card_count_value

/* Count only an explicit live zone population; receipt counts need a producer proof. */
/* @sem Expr::CountObjects($card_population_plain) */
live_card_count_value ::= "the" "number" "of" card_population_plain

/* The optional reveal and its conditional move share the same top-card query. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:_{instructions:[If{condition:Compare{left:CountObjects(Matching{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:_{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:$optional_reveal_destination, qualifiers:[]}}]}, otherwise:_{}}]}, otherwise:_{}}] */
instructions_optional_top_reveal_move ::= "you" "may" "reveal" "the" "top" "card" "of" "your" "library" "." "if" top_reveal_quality "is" "revealed" "this" "way" "," "put" "it" optional_reveal_destination

/* One revealed card can satisfy any of the independently named alternatives. */
reveal_until_card ::= reveal_until_instant_or_sorcery | reveal_until_single_card | reveal_until_companion_card_union | reveal_until_shared_creature_type | reveal_until_shared_creature_type_an

/* @sem ObjectFilter::$card_filter */
reveal_until_single_card ::= ("a" | "an") card_filter "card"

/* @sem ObjectFilter::AnyOf([$filter_phrase, HasKeywordFamily(DoctorsCompanion), $filter_phrase_2]) */
reveal_until_companion_card_union ::= "a" filter_phrase "card" "," "a" "card" "with" "doctor's" "companion" "," "or" "a" filter_phrase "card"

/* The permission is tied to the single card actually exiled by this producer. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:UntilEndOfNextTurn(AbilityController), evaluation:LiveObjects}}] */
instructions_exile_top_next_turn_play_it ::= "exile" "the" "top" "card" "of" "your" "library" "." "until" "the" "end" "of" "your" "next" "turn" "," "you" "may" "play" "it"

/* The permission refers to the single card produced by this exact exile. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any}, terms:_{cost:Normal, condition:Compare{left:EventHistory{event:Batch{event:Counters(_{change:Put, kind:Named(LoreCounter), objects:SameObject(Source), by:One(AbilityController)}), per:Subject}, window:ThisTurn, measure:TotalAmount}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}})], duration:Indefinite, evaluation:LiveObjects}}] */
instructions_exile_top_saga_permission ::= "exile" "the" "top" "card" "of" "your" "library" "." "during" "any" "turn" "you" "put" "a" "lore" "counter" "on" "this" "Saga" "," "you" "may" "play" "that" "card"

/* Move both private zones together, shuffle, then draw the stated amount. */
/* @sem Instruction::[Group(Program{instructions:[Effect{result:@next, operation:Move{objects:Union([Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}), Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any})]), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}), Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}] */
clause_your_hand_graveyard_shuffle_draw ::= "shuffle" "your" "hand" "and" "graveyard" "into" "your" "library" "," "then" "draw" card_count

/* The additional players finish shuffling before drawing. */
/* @sem Instruction::[ForEachPlayer{players:$shuffle_plural_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Union([Zone(_{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any})]), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}, Effect{result:@next, operation:Draw{players:$shuffle_plural_players, amount:$card_count}}] */
clause_also_shuffle_hands_graveyards_draw ::= shuffle_plural_players "also" "shuffles" "their" "hand" "and" "graveyard" "into" "their" "library" "," "then" "draws" card_count

/* The chosen card returns to the same targeted library; the remainder excludes
   precisely that reorder's input. */
/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One($target_possessive)}, kind:Card, filter:Any}, count:$number_words, from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:$target_possessive, objects:Selected(@prior), end:Top, order:Chosen}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_target_library_partition ::= "look" "at" "the" "top" number_words "cards" "of" target_possessive "library" "." "put" "one" "back" "and" "the" "rest" "into" "that" "player's" "graveyard"

/* The choice and the remainder are kept within each alternative, so the
   remainder excludes that alternative's actual move receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($number), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
observed_cards_to_hand ::= "put" number "of" "those" "cards" "into" "your" "hand"

/* @sem Instruction::Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}} */
observed_hand_remainder ::= "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Ability::@optional_cost_reminder(Ability::CostBranch{keyword:Kicker, cost:$kicker_branch_header, paid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:$look_at_top_x_cards}, ...$observed_cards_to_hand_2, $observed_hand_remainder]}}), unpaid:@scope(Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:$look_at_top_x_cards}, ...$observed_cards_to_hand, $observed_hand_remainder]}})}, $kicker_branch_note) */
spell_kicker_look_hand ::= kicker_branch_header kicker_branch_note? NEWLINE look_at_top_x_cards "." observed_cards_to_hand "." "if" "this" "spell" "was" "kicked" "," observed_cards_to_hand "instead" "." observed_hand_remainder "."

/* Keep the reveal, exile arrival, permission, and remainder together: both
   references are derived from this producer and use the same stopping filter. */
/* @sem Instruction::[Effect{result:@next, operation:CreateTrigger{event:Spell{event:Cast, players:One(AbilityController), spells:$spell_filter}, duration:EndOfTurn, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:@and($filter_phrase, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}}), count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Query{objects:Matching{objects:Transition{result:@prior, phase:After}, filter:@and($filter_phrase, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}})}, index:0}), origins:CardPlayOrigins([Exile]), action:CastSpell, filter:Any}, terms:_{cost:Free}})], duration:EndOfTurn, evaluation:LiveObjects}}, Effect{result:@next, operation:Move{objects:InZone{objects:Matching{objects:Transition{result:@back(3), phase:After}, filter:Not(@and($filter_phrase, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}}))}, zone:Exile}, destination:Library{position:BottomRandom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}, once:true}}] */
clause_next_cast_exile_until_free ::= "when" "you" "next" "cast" spell_filter "this" "turn" "," "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" "an" filter_phrase "card" "with" "lesser" "mana" "value" "." "until" "end" "of" "turn" "," "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" "." "put" "each" "other" "card" "exiled" "this" "way" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* Keep the look, selection, exile destination and remaining cards in one
   producer-consumer scope for recognition and inverse printing. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[[$counter_kind, $counter_amount]], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[[$counter_kind, $counter_amount]], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Chosen}}] */
dig_look_exile_counter ::= look_top "." "exile" "one" "of" "them" "face" "down" "with" counter_amount counter_kind "counter" "on" "it" "," "then" "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "any" "order"

/* The same searched card is revealed and routed by its printed type test. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_filtered]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, If{condition:Compare{left:CountObjects(Matching{objects:Selected(@marked), filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_search_reveal_partition ::= "search" "your" "library" "for" search_choice_filtered "and" "reveal" "it" "." "put" "it" "onto" "the" "battlefield" "tapped" "if" "it's" "a" card_filter "card" "." "otherwise" "," "put" "it" "into" "your" "hand" "." "then" "shuffle"

/* The paid life determines the observed library population and the remainder
   excludes the cards actually moved to their owners' hands. */
/* @sem Instruction::[Effect{result:@next, operation:PayAnyAmount{actor:One(AbilityController), resource:Life}}, Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Performed(@prior), from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($number_words), constraints:[CanMoveTo{destination:OwnersHand{}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand{}}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(2), phase:Before}])}, zone:Library}, destination:Exile{visibility:FaceUp, arrival:_{}}}}] */
instructions_pay_life_look_choose_exile ::= "pay" "any" "amount" "of" "life" "," "then" "look" "at" "that" "many" "cards" "from" "the" "top" "of" "your" "library" "." "put" number_words "of" "those" "cards" "into" "your" "hand" "and" "exile" "the" "rest"

/* Keep the reveal, exile receipt, permission and remainder in one scope: the
   stopped card and the rest are both derived from this exact exile. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:$card_filter, count:Constant(1)}}, Effect{result:@mark, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:$object_ref, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Query{objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$card_filter}, index:0}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:WhileOnBattlefield($object_ref), evaluation:LiveObjects}}, Effect{result:@next, operation:Move{objects:InZone{objects:Matching{objects:Transition{result:@marked, phase:After}, filter:Not($card_filter)}, zone:Exile}, destination:Library{position:BottomRandom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
instructions_exile_until_play_remainder ::= "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" "a" card_filter "card" "." "you" "may" "play" "that" "card" "for" "as" "long" "as" object_ref "remains" "on" "the" "battlefield" "." "put" "the" "rest" "of" "those" "exiled" "cards" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* Three independent choices retain the same search receipt through the follow-up. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:$search_filtered_three} */
search_three_choices ::= "search" "your" "library" "for" search_filtered_three

/* @sem SearchChoice::[$search_choice_filtered, $search_choice_filtered_2, $search_choice_filtered_3] */
search_filtered_three ::= search_choice_filtered "," search_choice_filtered "," "and" search_choice_filtered

/* @sem Instruction::[Effect{result:@mark, operation:$search}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Discard{players:One(AbilityController), amount:$card_count, random:true}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_search_reveal_hand_discard ::= search "and" "reveal" "that" "card" "." "put" "it" "into" "your" "hand" "," "then" "discard" card_count "at" "random" "." "then" "shuffle"

/* One top card per named vote, from the ability controller's library. */
/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:$count_each_vote, from:Top} */
library_top_per_vote ::= "the" "top" "card" "of" "your" "library" "for" "each" count_each_vote

/* The named-per-creature choice retains its population independently of the
   card filter. The ordinary found-card action and shuffle follow the search. */
/* @sem SearchChoice::SearchChoice{filter:$filter_phrase, count:AnyNumber, constraints:[NamedAfterOneEach($each_counter_creature)]} */
search_choice_named_each_creature ::= "for" each_counter_creature "," "you" "may" "search" "your" "library" "for" ("a" | "an") filter_phrase "card" "with" "the" "same" "name" "as" "that" "creature"

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_named_each_creature]}}, Effect{result:@next, operation:$found_those_action}, ...$search_follow]}}] */
clause_search_named_each ::= search_choice_named_each_creature "." found_those_action search_follow

found_those_action ::= found_those_battlefield | found_those_battlefield_tapped | found_those_exile | found_those_reveal

/* @sem Operation::@search_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}) */
found_those_battlefield ::= "put" "those" "cards" "onto" "the" "battlefield"

/* @sem Operation::@search_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}) */
found_those_battlefield_tapped ::= "put" "those" "cards" "onto" "the" "battlefield" "tapped"

/* @sem Operation::Reveal{objects:Selected(@marked)} */
found_those_reveal ::= "reveal" "those" "cards"

/* @sem Operation::Move{objects:Selected(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
found_those_exile ::= "exile" "those" "cards"

/* The observation and its remaining library cards share one scoped receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:$cloak_observed_cards}, Effect{result:@next, operation:$observed_remainder_bottom}] */
dig_look_cloak ::= look_top "," cloak_observed_cards "," "and" observed_remainder_bottom

/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), objects:InZone{objects:Observed(@marked), zone:Library}, chooser:Players(One(AbilityController)), count:Exactly($value)}], action:Manifest{actor:One(AbilityController), source:Cards(Prepared(@selection_id(0))), cloak:true, entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}} */
cloak_observed_cards ::= "cloak" value "of" "them"

/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:$library_order} */
observed_remainder_bottom ::= "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* Three private zones share the same selected receipt and conditional shuffle. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_private_either}, ...$private_search_follow, If{condition:Searched(@marked), then:Program{instructions:[Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:Program{}}] */
clause_search_private_either ::= search_private_either private_search_follow "." "if" "you" "search" "your" "library" "this" "way" "," "shuffle"

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice], also:[Graveyard, Hand], either:true} */
search_private_either ::= "search" "your" "library" "," "hand" "," "and" "/" "or" "graveyard" "for" search_choice

private_search_follow ::= search_either_follow | private_search_attached_follow

/* @sem Instruction::[Effect{result:@next, operation:$search_found_attached}] */
private_search_attached_follow ::= "and" search_found_attached

/* @sem Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo($object_ref)]}}, qualifiers:[]} */
search_found_attached ::= "put" "it" "onto" "the" "battlefield" "attached" "to" object_ref

/* The selected cards are moved by the same search episode that produced them. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_hand_episode_choice]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
search_hand_episode ::= "search" "your" "library" "for" search_hand_episode_choice

search_hand_episode_choice ::= search_hand_episode_one | search_hand_episode_many

/* @sem SearchChoice::$player_search_one_choice */
search_hand_episode_one ::= player_search_one_choice "and" "put" "that" "card" "into" "your" "hand"

/* @sem SearchChoice::$search_counted_choice */
search_hand_episode_many ::= search_counted_choice "and" "put" "those" "cards" "into" "your" "hand"

/* The singular search, graveyard arrival and shuffle establish the card tested
   by the following branch. The move result stays distinct from the shuffle. */
/* @sem Instruction::[Group{instructions:[Effect{result:@next, operation:$search_single_library}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$card_filter}, then:Program{instructions:$instructions}, otherwise:Program{}}] */
instructions_search_graveyard_type_followup ::= search_single_library "," "put" "it" "into" "your" "graveyard" "," "then" "shuffle" "." "if" "it's" "an" card_filter "card" "," instructions

/* The event creature's controller searches their own library. */
/* @prefer always */
/* @sem PlayerRef::ControllerOf(EventSubject) */
search_event_creature_controller ::= "that" "creature's" "controller"

/* The named card is compared to the event subject, independently of the searcher. */
/* @sem SearchChoice::SearchChoice{filter:SharesNameWith(EventSubject), count:UpTo(Constant(1))} */
search_event_creature_name ::= "a" "card" "with" "the" "same" "name" "as" "that" "creature"

/* Keep the chosen name, observed library slice and both movement receipts in scope. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_a_card_name}, ...$chosen_name_reveal_partition] */
chosen_name_reveal_choice_partition ::= choose_a_card_name "." chosen_name_reveal_partition

/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$chosen_name_reveal_split] */
chosen_name_reveal_partition ::= reveal_top "and" chosen_name_reveal_split

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:Chosen(CardName)}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:$rest_graveyard}] */
chosen_name_reveal_split ::= "put" "all" "of" "them" "with" "that" "name" "into" "your" "hand" "." "put" rest_graveyard

/* The owner, the qualifying relation, and the sought quantity are independent. */
/* @sem PlayerRef::OwnerOf($linked_exiled_card_possessive) */
seek_card_owner ::= linked_exiled_card_possessive "owner"

/* @sem ObjectFilter::Shares{property:CardTypes, with:$shared_type_antecedent} */
seek_shares_card_type_singular ::= "that" "shares" "a" "card" "type" "with" shared_type_antecedent

/* @sem ObjectFilter::Shares{property:CardTypes, with:$shared_type_antecedent} */
seek_shares_card_type_plural ::= "that" "share" "a" "card" "type" "with" shared_type_antecedent

/* @sem ObjectFilter::Shares{property:CreatureTypes, with:$shared_type_antecedent} */
seek_shares_creature_type_singular ::= "that" "shares" "a" "creature" "type" "with" shared_type_antecedent

/* @sem ObjectFilter::Shares{property:CreatureTypes, with:$shared_type_antecedent} */
seek_shares_creature_type_plural ::= "that" "share" "a" "creature" "type" "with" shared_type_antecedent

seek_shared_singular ::= seek_shares_card_type_singular | seek_shares_creature_type_singular

seek_shared_plural ::= seek_shares_card_type_plural | seek_shares_creature_type_plural

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$seek_card_owner, objects:Zone{scope:Players{zone:Library, players:One($seek_card_owner)}, kind:Card, filter:$seek_shared_singular}, count:AsManyAsCan($card_count_one), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_owner_seeks_shared_singular ::= seek_card_owner "seeks" card_count_one seek_shared_singular

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$seek_card_owner, objects:Zone{scope:Players{zone:Library, players:One($seek_card_owner)}, kind:Card, filter:$seek_shared_plural}, count:AsManyAsCan($card_count_many), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_owner_seeks_shared_plural ::= seek_card_owner "seeks" card_count_many seek_shared_plural

/* Each named choice retains its own count and name; the search receipt owns
   both the battlefield move and the conditional library shuffle. */
/* @sem SearchChoice::SearchChoice{filter:Name($referenced_card_name), count:UpTo($card_count)} */
search_named_count_choice ::= card_count "named" referenced_card_name

/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_named_count_choice, $search_named_count_choice_2], also:[Graveyard, Hand], either:true}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, If{condition:Searched(@marked), then:Program{instructions:[Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:Program{}}] */
clause_search_three_zones_named_pair ::= "search" "your" "graveyard" "," "hand" "and" "/" "or" "library" "for" search_named_count_choice "and" "/" "or" search_named_count_choice "and" "put" "them" "onto" "the" "battlefield" "." "if" "you" "search" "your" "library" "this" "way" "," "shuffle"

/* The referenced object supplies the name for a singular search choice. */
/* @sem SearchChoice::SearchChoice{filter:SharesNameWith($object_ref), count:UpTo(Constant(1))} */
search_choice_singular_same_name ::= "a" "card" "with" "the" "same" "name" "as" object_ref

/* The observation, selected exile, plotted arrival and remainder share one scope. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$dig_plot_take, $dig_plot_rest] */
dig_look_plot ::= look_top "." dig_plot_take "." dig_plot_rest

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$adjective_nontype}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:EffectOn{subject:Objects(One(Result{result:@prior, phase:After, index:0})), effects:[Term{family:ExiledCardEffect, form:IsPlotted}]}}] */
dig_plot_take ::= "you" "may" "exile" "a" adjective_nontype "card" "from" "among" "them" "." "if" "you" "do" "," "it" "becomes" "plotted"

/* @sem Instruction::Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(3), phase:Before}])}, zone:Library}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}} */
dig_plot_rest ::= "put" "the" "rest" "into" "your" "hand"

/* The continuation consumes the observed library slice and records its actual exile receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($number_words), constraints:[CanMoveTo{destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:Target{slot:@last_slot, index:0}, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Top, order:Chosen}}] */
observed_library_exile_count ::= "exile" number_words "of" "them"

/* The untouched remainder stays on top of the same targeted library. */
/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One($target_possessive)}, kind:Card, filter:Any}, count:$number_words, from:Top}}}, ...$observed_library_exile_count] */
clause_look_target_library_exile ::= "look" "at" "the" "top" number_words "cards" "of" target_possessive "library" "," "then" observed_library_exile_count

/* The discard, relative seek, hand arrival, exile and permission share one
   payment and movement chain. The inverse must match every receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$discard_one_payment]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:$seek_relative_comparison, value:ObjectProperty{object:Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:$seek_permission_duration, evaluation:LiveObjects}}]}, otherwise:Program{}}] */
optional_discard_relative_seek_exile_play ::= "you" "may" discard_one_payment "." "if" "you" "do" "," "seek" "a" "card" "with" seek_relative_comparison "mana" "value" "and" "exile" "it" "." seek_permission_duration "," "you" "may" "play" "the" "exiled" "card"

seek_relative_comparison ::= kin_greater | kin_lesser

seek_permission_duration ::= until_end_of_your_next_turn | until_end_of_turn

/* The reusable body is independent of the turn event. */
/* @sem Ability::Triggered{event:$relative_seek_turn, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$optional_discard_relative_seek_exile_play}} */
trigger_relative_seek_exile_play ::= "at" relative_seek_turn "," optional_discard_relative_seek_exile_play "."

relative_seek_turn ::= relative_seek_precombat | relative_seek_first_main | turn_upkeep

/* @prefer always */
/* @sem EventSpec::Turn{point:FirstMainPhaseBegins, players:One(AbilityController)} */
relative_seek_precombat ::= "the" "beginning" "of" "your" "precombat" "main" "phase"

/* @sem EventSpec::Turn{point:FirstMainPhaseBegins, players:One(AbilityController)} */
relative_seek_first_main ::= "the" "beginning" "of" "your" "first" "main" "phase"

/* A chosen-kind qualifier intersects the permanent-card population with the
   previously chosen filter. */
/* @sem ObjectFilter::AllOf([$chosen_permanent_card_filter, ChosenFilter]) */
a_card_chosen_permanent ::= "a" chosen_permanent_card_filter "card" "of" "the" "chosen" "kind"

/* @sem ObjectFilter::AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]) */
chosen_permanent_card_filter ::= "permanent"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:AllOf([$chosen_permanent_card_filter, ChosenFilter])}, count:$seek_plural_count, constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_seek_chosen_permanents ::= "seek" seek_plural_count chosen_permanent_card_filter "cards" "of" "the" "chosen" "kind"

/* Select from the immediately preceding observation and keep the unexiled cards in order. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AnyNumber, constraints:[CanMoveTo{destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Top, order:Chosen}}] */
look_exile_any_restore ::= "exile" "any" "number" "of" "them" "and" "put" "the" "rest" "back" "on" "top" "of" "your" "library" "in" "any" "order"

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$look_exile_any_restore] */
clause_look_exile_any_restore ::= look_top "," "then" look_exile_any_restore

/* The follow-up uses the actual hand arrival of the immediately preceding seek. */
/* @sem Instruction::[...$clause_seek_card, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}] */
clause_seek_then_tapped_battlefield ::= clause_seek_card "," "then" "put" "it" "onto" "the" "battlefield" "tapped"

/* The observation, matching card and remainder share the same library and
   receipt. Keeping the branch with its producer makes the inverse safe. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:$reveal_until_named_library, filter:Chosen(CardName), count:Constant(1)}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@last_result), filter:Chosen(CardName)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:ReorderLibrary{chooser:$reveal_until_named_library, library_owner:$reveal_until_named_library, objects:Matching{objects:Observed(@prior), filter:Chosen(CardName)}, end:$named_reveal_end, order:Chosen}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@back(3)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:$named_reveal_rest_destination, qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Shuffle{players:One($reveal_until_named_library)}}]}}] */
named_reveal_conditional_partition ::= reveal_until_named_library "until" "a" "card" "with" "that" "name" "is" "revealed" "." "if" "it" "is" "," "that" "player" "puts" "the" "rest" "of" "the" "revealed" "cards" named_reveal_rest_destination "and" "puts" "the" "card" "with" "the" "chosen" "name" "on" named_reveal_end "of" "their" "library" "." "otherwise" "," "the" "player" "shuffles"

named_reveal_rest_destination ::= named_reveal_graveyard | named_reveal_hand

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$choose_reveal_name}, ...$named_reveal_conditional_partition]}} */
spell_choose_named_reveal_partition ::= choose_reveal_name "." named_reveal_conditional_partition "."

named_reveal_end ::= ordered_top | planar_first_bottom

choose_reveal_name ::= choose_a_card_name | choose_reveal_expansion_name

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:CardName, terms:_{count:Exactly(Constant(1)), options:[Term{family:CardsInOracle, form:FromTheLorwynEclipsedExpansion}]}} */
choose_reveal_expansion_name ::= "choose" "a" "card" "name" "from" "the" "Lorwyn" "Eclipsed" "expansion"

/* An epic spell resolves its search sentence before the epic action. The
   reusable search clause retains its own search receipt and follow-ups. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$clause_search_general, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Epic}}]}} */
spell_search_epic ::= clause_search_general "." NEWLINE "epic"

/* The reveal and its consumers share a single observation and X binding. */
reveal_definition ::= value_event_spell_mana | value

cast_observed_bounded_mana ::= cast_observed_bounded_one | cast_observed_bounded_many

/* @sem Operation::PlayWith{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:BoundValue(@back(4))}}}, count:UpTo($counter_amount), terms:_{cost:Free}} */
cast_observed_bounded_one ::= "you" "may" "cast" counter_amount "spell" "with" "mana" "value" "X" "or" "less" "from" "among" "cards" "revealed" "this" "way" "without" "paying" "its" "mana" "cost"

/* @sem Operation::PlayWith{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:BoundValue(@back(4))}}}, count:UpTo($number_words), terms:_{cost:Free}} */
cast_observed_bounded_many ::= "you" "may" "cast" number_words "spells" "with" "mana" "value" "X" "or" "less" "from" "among" "cards" "revealed" "this" "way" "without" "paying" "their" "mana" "costs"

/* @sem Instruction::[Effect{result:@next, operation:BindValue{value:$reveal_definition}}, Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:BoundValue(@prior), from:Top}}}, Effect{result:@next, operation:$cast_observed_bounded_mana}, Effect{result:@next, operation:$observed_remainder_bottom}] */
dig_defined_reveal_cast ::= "reveal" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" reveal_definition "." cast_observed_bounded_mana "." observed_remainder_bottom

/* The target supplies both the library owner and the compared name. The
   selected search result remains the object moved before that player shuffles. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:ControllerOf($opponent_controlled_search_target), choices:[_{filter:SharesNameWith($opponent_controlled_search_target), count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:$named_search_entry, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf($opponent_controlled_search_target))}}] */
instructions_chosen_opponent_name_search ::= "choose" opponent_controlled_search_target "." "search" "that" "player's" "library" "for" "a" "card" "with" "the" "same" "name" "and" "put" "it" "onto" "the" "battlefield" named_search_entry "." "then" "that" "player" "shuffles"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$noun, $named_search_controller])}), index:0} */
opponent_controlled_search_target ::= "target" noun named_search_controller

named_search_controller ::= modifier_opponent_controls | modifier_not_controlled

named_search_entry ::= battlefield_control | linked_battlefield_tapped

/* Four independently described card types form one choice. */
/* @prefer always */
/* @sem $noun_or_four */
search_filter_four_alternatives ::= noun_or_four "card"

/* A four-kind search with a separately stated found-card action. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:$target_possessive, choices:[$search_choice_four]}}, Effect{result:@next, operation:$found_that_battlefield_yours}, Effect{result:@next, operation:Shuffle{players:One($target_possessive)}}] */
clause_search_target_four_sentence ::= "search" target_possessive "library" "for" search_choice_four "." found_that_battlefield_yours "." "then" "that" "player" "shuffles"

/* @prefer always */
/* @sem SearchChoice::SearchChoice{filter:$search_filter_four_alternatives, count:UpTo(Constant(1))} */
search_choice_four ::= "an" search_filter_four_alternatives

/* @prefer always */
/* @sem Operation::@search_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}) */
found_that_battlefield_yours ::= "put" "that" "card" "onto" "the" "battlefield" "under" "your" "control"

dig_reveal_selection ::= dig_reveal_double_faced_that | dig_reveal_selection_shared_creature_type | dig_reveal_selection_general | dig_reveal_selection_qualified_union

/* Preserve the established wording for this shared card union. */
/* @prefer always */
/* @sem $top_reveal_union_double_faced */
dig_reveal_double_faced_that ::= top_reveal_union_double_faced "from" "among" "them" "and" "put" "that" "card"

/* @sem $a_card */
dig_reveal_selection_general ::= a_card "from" "among" "them" "and" "put" found_one

/* A controlled battlefield choice supplies the names used by the search. */
/* @sem Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(AbilityController)))}, count:AsManyAsCan($number)} */
choose_controlled_permanents_count ::= "choose" number filter_plural "you" "control"

/* The search consumes the immediately preceding selection; its own receipt
   is the group moved to the battlefield before the library is shuffled. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:Any, count:AnyNumber, constraints:[NamedAfterOneEach(Selected(@prior))]}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
search_each_selected_name_entry ::= "for" "each" "of" "those" "permanents" "," "you" "may" "search" "your" "library" "for" "a" "card" "with" "the" "same" "name" "as" "that" "permanent" "." "put" "those" "cards" search_option_entry "," "then" "shuffle"

/* @sem Instruction::[Effect{result:@next, operation:$choose_controlled_permanents_count}, ...$search_each_selected_name_entry] */
instructions_choose_named_search ::= choose_controlled_permanents_count "." search_each_selected_name_entry

/* An optional mana payment governs the complete observed-library selection. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$pay_mana, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:$dig_look_split}, otherwise:Program{}}] */
clause_paid_library_selection ::= "you" "may" pay_mana "." "if" "you" "do" "," dig_look_split

/* The event subject owns the inspected library; the observed slice feeds the
   bounded exile choice and the remainder in the same optional program. */
/* @sem Operation::LookAt{player:AbilityController, objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(EventSubject)}, kind:Card, filter:Any}), count:$card_count, from:Top}} */
look_event_library_top ::= "look" "at" "the" "top" card_count "of" "that" "library"

/* The selection, move and remainder share the actual move receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:UpTo($value), constraints:[CanMoveTo{destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:EventSubject, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Top, order:Chosen}}] */
exile_observed_library_up_to ::= "you" "may" "exile" value "of" "those" "cards" "." "then" "put" "the" "rest" "on" "top" "of" "that" "library" "in" "any" "order"

/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@mark, operation:$look_event_library_top}, ...$exile_observed_library_up_to]}}] */
instructions_optional_event_library_split ::= "you" "may" look_event_library_top "." exile_observed_library_up_to

/* The first choice remains in both conditional branches; the extra choice is
   available only when the condition holds. Both branches reveal and move the
   actual search selection before shuffling. */
/* @sem Instruction::[If{condition:$condition, then:_{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_filtered, $additional_search_choice]}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:_{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_filtered]}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}}] */
clause_search_conditional_additional ::= "search" "your" "library" "for" search_choice_filtered "." "if" condition "," "you" "may" "search" "your" "library" "for" additional_search_choice "." "reveal" "those" "cards" "," "put" "them" "into" "your" "hand" "," "then" "shuffle"

/* @sem SearchChoice::SearchChoice{filter:$search_filter, count:UpTo(Constant(1))} */
additional_search_choice ::= "an" "additional" search_filter

/* The cost-bearing wrapper fixes the unique sacrificed creature at component 2;
   this program reads that input before payment and keeps the searched card's
   exile result for the subsequent cast. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:AllOf([$filter_phrase, Property{property:ColorCount, test:NumberTest::Compare{comparison:Equal, value:Add(ObjectProperty{object:Query{objects:CostObjects{payment:Activation, component:[2], view:Inputs, phase:Before}, index:0}, property:ColorCount, information:CurrentOrLastKnown}, $number_words)}}]), count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}, Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Result{result:@back(3), phase:After, index:0}), count:Exactly(Constant(1)), cost:Normal}}]}}]} */
sacrificed_creature_color_search_cast ::= "count" "the" "colors" "of" "the" "sacrificed" "creature" "," "then" "search" "your" "library" "for" "a" filter_phrase "card" "that's" "exactly" "that" "many" "colors" "plus" number_words "." "exile" "that" "card" "," "then" "shuffle" "." "you" "may" "cast" "the" "exiled" "card"

/* The searched card's exile arrival is shared by the temporary permission and
   its delayed destination; the entire producer is kept in this scope. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:$look_target_opponent, choices:[_{filter:Any, count:AsManyAsCan(Constant(1))}]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Target{slot:0, index:0})}}] */
opponent_search_exile_shuffle ::= "search" look_target_opponent "library" "for" "a" "card" "and" "exile" "it" "." "then" "that" "player" "shuffles"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:UntilNext{point:UpkeepBegins, players:One(AbilityController)}, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:UpkeepBegins, players:One(AbilityController)}, start:Immediately, intervening_if:Compare{left:CountObjects(InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, body:_{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}, destination:OwnersGraveyard(CardArrival{}), qualifiers:[]}}]}}}] */
searched_exile_upkeep_permission ::= "until" "the" "beginning" "of" "your" "next" "upkeep" "," "you" "may" "play" "that" "card" "." "at" "the" "beginning" "of" "your" "next" "upkeep" "," "if" "you" "haven't" "played" "it" "," "put" "it" "into" "its" "owner's" "graveyard"

/* @sem Program::Program{instructions:[...$opponent_search_exile_shuffle, ...$searched_exile_upkeep_permission]} */
opponent_search_exile_upkeep_program ::= opponent_search_exile_shuffle "." searched_exile_upkeep_permission

/* A damage event supplies the amount; the random selection and hand move
   remain a group so the following instruction can refer to its arrival. */
/* @sem Instruction::[Group{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$adjective_nontype}, count:AsManyAsCan(EventAmount), constraints:[AtRandom]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}] */
seek_damage_amount_cards ::= "seek" "that" "many" adjective_nontype "cards"

/* Scope the delayed discard to the hand arrival made by this seek. */
/* @sem Instruction::[...$seek_damage_amount_cards, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:One(AbilityController)}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:DiscardObjects{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@marked, phase:After})}}}]}}}] */
seek_damage_cards_delayed_discard ::= seek_damage_amount_cards "." "at" "the" "beginning" "of" "your" "next" "end" "step" "," "discard" "those" "cards"

seek_damage_event ::= event_dealt_damage | event_dealt_combat_damage

/* @sem Ability::Triggered{event:$seek_damage_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$seek_damage_cards_delayed_discard}} */
triggered_seek_damage_delayed_discard ::= "whenever" seek_damage_event "," seek_damage_cards_delayed_discard "."

/* @prefer always */
/* @sem Operation::Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}, count:$card_count, from:Top}} */
bound_reveal_fixed_top ::= "reveals" "the" "top" card_count "of" "their" "library"

/* @prefer always */
/* @sem Operation::Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}, count:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}), from:Top}} */
bound_reveal_controlled_count ::= "reveals" "a" "number" "of" "cards" "from" "the" "top" "of" "their" "library" "equal" "to" "the" "number" "of" filter_plural "they" "control"

/* @prefer always */
/* @sem Operation::Move{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:AllOf([$filter_phrase, InSet(Observed(@marked)), OwnedBy(One(Bound(0)))])}, destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]} */
bound_put_revealed_tapped ::= "puts" "all" filter_phrase "cards" "revealed" "this" "way" "onto" "the" "battlefield" "tapped"

/* @sem Operation::Move{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:AllOf([$bound_permanent_card_filter, InSet(Observed(@marked)), OwnedBy(One(Bound(0)))])}, destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
bound_put_revealed_untapped ::= "puts" "all" bound_permanent_card_filter "cards" "they" "revealed" "this" "way" "onto" "the" "battlefield"

/* @sem Operation::Move{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:AllOf([$bound_permanent_card_filter, InSet(Observed(@marked)), OwnedBy(One(Bound(0)))])}, destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]} */
bound_put_they_revealed_tapped ::= "puts" "all" bound_permanent_card_filter "cards" "they" "revealed" "this" "way" "onto" "the" "battlefield" "tapped"

/* @prefer always */
/* @sem ObjectFilter::AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]) */
bound_permanent_card_filter ::= "permanent"

bound_revealed_rest ::= bound_exile_revealed_rest | bound_graveyard_revealed_rest

/* @sem Operation::Move{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:AllOf([InSet(Observed(@marked)), OwnedBy(One(Bound(0)))])}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]} */
bound_graveyard_revealed_rest ::= "puts" "the" "rest" "into" "their" "graveyard"

/* A random library selection and its hand arrival remain a single reusable
   seek phrase. Its count and mana value comparison are independent operands. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Property{property:ManaValue, test:$seek_bounded_mana_test}}, count:AsManyAsCan($card_count), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
seek_bounded_mana_cards ::= card_count "with" "mana" "value" seek_bounded_mana_test

seek_bounded_mana_test ::= prohibited_at_most | seek_bounded_mana_greater

/* @sem NumberTest::Compare{comparison:GreaterOrEqual, value:$value} */
seek_bounded_mana_greater ::= value "or" "greater"

/* Both receipts are produced by the two seek phrases in this same span. */
/* @sem Instruction::[...$seek_bounded_mana_cards, ...$seek_bounded_mana_cards_2, ...$seek_pair_discard_next_turn] */
clause_seek_pair_delayed_discard ::= "seek" seek_bounded_mana_cards "and" seek_bounded_mana_cards "." seek_pair_discard_next_turn

/* This continuation is only composed with the two preceding seek arrivals. */
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:One(AbilityController)}, start:PlayersNextTurn(AbilityController), body:Program{instructions:[Effect{result:@next, operation:DiscardObjects{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Union([Transition{result:@back(5), phase:After}, Transition{result:@back(3), phase:After}]))}}}]}}}] */
seek_pair_discard_next_turn ::= "discard" "those" "cards" "at" "the" "beginning" "of" "your" "next" "turn's" "end" "step"

/* The observation and its ability-sharing consumer stay together: the native
   perpetual term has no explicit observed-set operand. */
/* @sem Instruction::[Effect{result:@next, operation:$look_top}, Effect{result:@next, operation:$observed_perpetual_keywords}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_look_shared_perpetual ::= look_top "." observed_perpetual_keywords "." "then" "shuffle"

/* @sem Operation::EffectOn{subject:Objects($affected), effects:[Term{family:PerpetualEffect, form:AddAbilityFromCardsHasable, operands:[Term{family:CheckHasable, form:Flying}, ...$sharing_kind_tail]}]} */
observed_perpetual_keywords ::= "if" "a" "card" "among" "them" "has" "flying" "," affected "perpetually" "gains" "flying" "." "the" "same" "is" "true" "for" sharing_kind_tail

/* The count belongs to this sacrifice, not an arbitrary earlier transition. */
/* @sem Instruction::[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Land)}, choose:AnyNumber})}, Effect{result:@next, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:CountObjects(Transition{result:@prior, phase:Before}), from:Top}}}] */
sacrifice_lands_reveal_receipt ::= "sacrifice" "any" "number" "of" "lands" "." "reveal" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" "the" "number" "of" "lands" "sacrificed" "this" "way"

/* The observed cards, their selection, and both movement receipts share scope. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:AnyOf([$noun, CardType(Land)])}, count:AnyNumber}}, Effect{result:@next, operation:Move{objects:Matching{objects:Selected(@prior), filter:$adjective_nontype}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Matching{objects:Selected(@back(3)), filter:CardType(Land)}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(5)), excluding:Union([Transition{result:@back(3), phase:Before}, Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Random}}] */
revealed_choice_land_entry_partition ::= "choose" "any" "number" "of" noun "and" "/" "or" "land" "cards" "revealed" "this" "way" "." "put" "all" adjective_nontype "cards" "chosen" "this" "way" "onto" "the" "battlefield" "," "then" "put" "all" "land" "cards" "chosen" "this" "way" "onto" "the" "battlefield" "tapped" "," "then" "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* @sem Instruction::[...$sacrifice_lands_reveal_receipt, ...$revealed_choice_land_entry_partition] */
instructions_sacrifice_reveal_land_partition ::= sacrifice_lands_reveal_receipt "." revealed_choice_land_entry_partition

/* The found-card measure and the reordered observations share this reveal,
   within the current recipient iteration. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:$adjective_nontype, count:Constant(1)}}, Effect{result:@next, operation:DealDamage{source:Source, recipients:Objects(One(Bound(0))), amount:Earlier{what:Found, measure:Of(ManaValue), result:@prior}, preventable:true}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@back(3)), zone:Library}, end:Bottom, order:$library_order}}] */
chosen_player_or_planeswalker_body ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "a" adjective_nontype "card" "," SELF_NAME "deals" "damage" "equal" "to" "that" "card's" "mana" "value" "to" "that" "player" "or" "planeswalker" "," "then" "you" "put" "the" "revealed" "cards" "on" "the" "bottom" "of" "your" "library" library_order

/* The exile arrival feeds both permission and delayed cleanup. The cleanup's
   graveyard move, in turn, supplies the counted token receipt. */
/* @sem Vec<Instruction>::[Effect{result:@next, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@prior, phase:After}, origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:EndOfTurn, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, intervening_if:Compare{left:CountObjects(Matching{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:Any}), filter:InSet(Transition{result:@back(3), phase:After})}), test:Compare{comparison:Greater, value:Constant(0)}}, body:_{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@back(4), phase:After}, zone:Exile}, destination:OwnersGraveyard{}}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:CountObjects(Transition{result:@prior, phase:Before}), words:CreatingEffect, recipe:@token_abilities($token_recipe_base, $token_abilities_quoted)}], entry:_{}}}]}}}] */
exile_play_graveyard_counted_tokens ::= exile_top_cards_of_your_library "." "you" "may" "play" "those" "cards" "this" "turn" "." "at" "the" "beginning" "of" "the" "next" "end" "step" "," "if" "any" "of" "those" "cards" "remain" "exiled" "," "put" "them" "into" "your" "graveyard" "," "then" "create" "a" token_recipe_base "for" "each" "card" "put" "into" "your" "graveyard" "this" "way" "." "those" "tokens" "have" token_abilities_quoted

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$exile_play_graveyard_counted_tokens}} */
spell_exile_play_graveyard_counted_tokens ::= exile_play_graveyard_counted_tokens

/* The three later effects share this own-library face-down exile receipt.
   Only its still-exiled arrivals remain for the delayed graveyard move. */
/* @sem Operation::Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$card_count_many, from:Top}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
hidden_own_top_many ::= "exile" "the" "top" card_count_many "of" "your" "library" "face" "down"

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:$hidden_own_top_many}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:Transition{result:@marked, phase:After}, audience:AffectedPlayer})], duration:WhileAnyExiled(Transition{result:@marked, phase:After}), evaluation:LiveObjects}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@marked, phase:After}, origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:$duration, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:UpkeepBegins, players:One(AbilityController)}, start:Immediately, body:_{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:OwnersGraveyard{}, qualifiers:[]}}]}}}]} */
hidden_top_access_upkeep_program ::= hidden_own_top_many "." "you" "may" "look" "at" "those" "cards" "for" "as" "long" "as" "they" "remain" "exiled" "." duration "," "you" "may" "play" "those" "cards" "." "at" "the" "beginning" "of" "your" "next" "upkeep" "," "put" "any" "of" "those" "cards" "you" "didn't" "play" "into" "your" "graveyard" "."

/* @sem Ability::Spell{body:$hidden_top_access_upkeep_program, announcement:@announcement} */
hidden_top_access_upkeep_spell ::= hidden_top_access_upkeep_program

/* The optional payment shuffles only cards arriving in hand from this seek.
   Keep both independent seeks and the payment in one inverse contract. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:$seek_plural_count, constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@back(3), phase:After})}, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:$seek_plural_count_2, constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{}}] */
seek_shuffle_seek ::= "seek" seek_plural_count "cards" "." "you" "may" "shuffle" "them" "into" "your" "library" "." "if" "you" "do" "," "seek" seek_plural_count "cards"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$seek_shuffle_seek, ...$clause_no_maximum_hand_size_rest]}} */
spell_seek_shuffle_hand_size ::= seek_shuffle_seek "." NEWLINE clause_no_maximum_hand_size_rest "."

/* The choice and remainder both refer to this seek's hand arrival.  The
   single chosen card is excluded by its actual result identity. */
/* @sem Instruction::[...$clause_seek_cards, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@prior, phase:After})}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:AllOf([Not(SameObject(Result{result:@prior, phase:After, index:0})), InSet(Transition{result:@back(3), phase:After})])}, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
instructions_seek_choose_shuffle_remainder ::= clause_seek_cards "." "choose" "one" "of" "those" "cards" "and" "shuffle" "the" "rest" "into" "your" "library"

/* The observed card and the destination share the bound player's identity. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$card_filter}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:Observed(@marked), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{}}, qualifiers:[]}}]}, otherwise:Program{}}]} */
bound_top_reveal_conditional_entry ::= "reveals" "the" "top" "card" "of" "their" "library" "," "then" "puts" "it" "onto" "the" "battlefield" "if" "it's" "a" card_filter "card"

/* Both members of the pile retain their own selection and zone. */
/* @sem ObjectSet::Union([$owned_nontoken_target_set, Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$pile_top_count, from:Top}]) */
owned_target_and_library_top ::= owned_nontoken_target_set "and" pile_top_count

/* @sem Instruction::[Effect{result:@next, operation:$search_single_library}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
search_single_exile_shuffle_bare ::= search_single_library "," "exile" "it" "," "then" "shuffle"

/* The offer refers to the singular exile arrival produced by the immediately
   preceding search and shuffle. The fallback is an ordinary instruction. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:FirstWilling(OpponentsOf(AbilityController)), cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@prior)), then:Program{instructions:$offer_you_instruction}, otherwise:Program{}}] */
opponent_offer_exiled_card_fallback ::= "any" "opponent" "may" "have" "you" "put" "that" "card" "into" "your" "hand" "." "if" "no" "player" "does" "," offer_you_instruction

/* @sem Instruction::[Effect{result:@next, operation:$operation_imperative}] */
offer_you_instruction ::= "you" operation_imperative

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$search_single_exile_shuffle_bare, ...$opponent_offer_exiled_card_fallback]}} */
spell_search_exile_opponent_offer ::= search_single_exile_shuffle_bare "." opponent_offer_exiled_card_fallback "."

/* A singleton permanent exile supplies the arrival checked by the conditional.
   The branch is scoped here so its receipt cannot name an unrelated action. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_permanent), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@last_result, phase:After}, filter:$subtype}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:$exile_arrival_conditional_branch, otherwise:Program{}}] */
exile_target_arrival_type_branch ::= "exile" target_permanent "." "if" "the" "exiled" "card" "is" "a" subtype "card" "," exile_arrival_conditional_branch

/* The name is taken from the arrival; the searched zones and shuffle belong
   to the controller of the original target. This branch requires the enclosing
   singleton exile above. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:ControllerOf(Target{slot:0, index:0}), choices:[_{filter:SharesNameWith(Result{result:@prior, phase:After, index:0}), count:$named_search_count}], also:[Graveyard, Hand]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf(Target{slot:0, index:0}))}}]} */
exile_arrival_conditional_branch ::= "search" "its" "controller's" "graveyard" "," "hand" "," "and" "library" "for" named_search_count "cards" "with" "the" "same" "name" "as" "that" "card" "and" "exile" "them" "." "then" "that" "player" "shuffles"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$exile_target_arrival_type_branch}} */
spell_exile_target_arrival_type_branch ::= exile_target_arrival_type_branch "."

/* This search owns the exile receipt counted by the subsequent draw. The
   controller and the shared-name object are both the named permanent. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:ControllerOf($controller_name_search_ref), choices:[_{filter:SharesNameWith($controller_name_search_ref), count:$named_search_count}], also:[Graveyard, Hand]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf($controller_name_search_ref))}}, Effect{result:@next, operation:Draw{players:One(ControllerOf($controller_name_search_ref)), amount:CountObjects(InZone{objects:Transition{result:@marked, phase:Before}, zone:Hand})}}] */
instructions_search_controller_name_exile_hand_draw ::= "search" "its" "controller's" "graveyard" "," "hand" "," "and" "library" "for" named_search_count "cards" "with" "the" "same" "name" "as" controller_name_search_ref "and" "exile" "them" "." "that" "player" "shuffles" "," "then" "draws" "a" "card" "for" "each" "card" "exiled" "from" "their" "hand" "this" "way"

/* @sem ObjectRef::@remember_operand($named_permanent) */
controller_name_search_ref ::= named_permanent

/* The maximum is computed over the entire hand, independently of eligibility. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$target_opponent, objects:Zone{scope:Players{zone:Hand, players:One($target_opponent)}, kind:Card, filter:AllOf([$adjective_nontype, Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone{scope:Players{zone:Hand, players:One($target_opponent)}, kind:Card, filter:Any}, property:ManaValue, aggregation:Maximum}}}])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}] */
clause_greatest_hand_discard ::= target_opponent "discards" "a" adjective_nontype "card" "with" "the" "greatest" "mana" "value" "among" "cards" "in" "their" "hand"

/* The revealed card remains the selected object, available to later clauses. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}] */
clause_reveal_one_in_hand ::= "reveal" "a" filter_phrase "card" "in" "your" "hand"

/* This continuation requires a preceding selected reveal; retain both selections. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:SharesNameWithAny(Selected(@back(3))), count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
clause_search_same_revealed_hand ::= "search" "your" "library" "for" "a" "card" "with" "the" "same" "name" "as" "that" "card" "," "reveal" "it" "," "put" "it" "into" "your" "hand" "," "then" "shuffle"

/* The search antecedent is scoped to this immediately preceding reveal. */
/* @sem Instruction::[...$clause_reveal_one_in_hand, ...$clause_search_same_revealed_hand] */
instructions_reveal_search_same_hand ::= clause_reveal_one_in_hand "." clause_search_same_revealed_hand

/* The discard producer is in the same phrase as its count consumer. The hand
   observation and its owner are the same announced player. */
/* @sem Instruction::[...$variable_discard_reflexive, Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($target_player)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@prior), zone:Hand}, filter:@and($adjective_nontype, ObjectFilter::OwnedBy(One($target_player)))}, count:AsManyAsCan(CountObjects(Transition{result:@back(3), phase:Before}))}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}] */
instructions_discard_observed_hand ::= variable_discard_reflexive "." target_player "reveals" "their" "hand" "," "then" "you" "choose" "a" adjective_nontype "card" "from" "it" "for" "each" "card" "discarded" "this" "way" "." "that" "player" "discards" "those" "cards"

/* The owner of the targeted card is the player named by the follow-up.
   The complete program fixes the antecedent within one ability frame. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:Expr::@in_filter($number)}}, InZone(Players{zone:Graveyard, players:OpponentsOf(AbilityController)})])}), index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Mill{players:One(OwnerOf(Target{slot:0, index:0})), amount:$card_count}}]} */
opponent_graveyard_put_owner_mill ::= "put" "target" filter_phrase "card" "with" "mana" "value" number "from" "an" "opponent's" "graveyard" "onto" "the" "battlefield" "tapped" "under" "your" "control" "." "then" "that" "player" "mills" card_count "."

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:$opponent_graveyard_put_owner_mill} */
activated_opponent_graveyard_owner_mill ::= cost ":" opponent_graveyard_put_owner_mill

/* The exile producer, permission and tests share one marked arrival receipt.
   The bounded token branches have no independent receipt-derived operands. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@marked, phase:After}, origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:$this_turn, evaluation:LiveObjects}}, $exile_receipt_token_branch, $exile_receipt_token_branch_2] */
instructions_exile_play_conditional_tokens ::= exile_top_cards_of_your_library "." "you" "may" "play" "them" this_turn "." exile_receipt_token_branch "." exile_receipt_token_branch

/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$discard_receipt_bonus_token], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}, otherwise:Program{}} */
exile_receipt_token_branch ::= "if" "you" "exiled" "a" card_filter "card" "this" "way" "," "create" discard_receipt_bonus_token

/* The repeated card filter describes the sought card; the move and both
   perpetual effects stay in one scope so the anaphor has a proven producer. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:@agree($filter_phrase, $seek_pair_filter)}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:$affected, changes:$plural_private_pump}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@marked, phase:After, index:0}), changes:$plural_private_pump}}] */
instructions_seek_pair_perpetual ::= "seek" "a" filter_phrase "card" "." affected "and" "that" seek_pair_filter "card" "each" "perpetually" plural_private_pump

seek_pair_filter ::= filter_phrase

/* The target's controller remains the library owner, entrant controller, and shuffler. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([$filter_phrase, ControlledBy(OpponentsOf(AbilityController))])}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
exile_opponent_controlled_target ::= "exile" "target" filter_phrase "an" "opponent" "controls"

/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:ControllerOf(Target{slot:0, index:0}), filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$card_filter}, destination:Battlefield{controller:Player(ControllerOf(Target{slot:0, index:0})), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf(Target{slot:0, index:0}))}}] */
controller_reveal_until_battlefield_shuffle ::= "that" "player" "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "a" card_filter "card" "is" "revealed" "." "the" "player" "puts" "that" "card" "onto" "the" "battlefield" "," "then" "shuffles" "the" "rest" "into" "their" "library"

/* @sem Instruction::[...$exile_opponent_controlled_target, ...$controller_reveal_until_battlefield_shuffle] */
instructions_exile_controller_reveal ::= exile_opponent_controlled_target "." controller_reveal_until_battlefield_shuffle

/* A private-zone move and its search continuation share one receipt.  Keeping
   the producer in this scope makes the counted transition safe to print. */
/* private_cards_hand is shared as exchange_private_hand. */

private_cards_origin ::= exchange_private_hand | hand_exile_graveyard

counted_search_filter ::= random_any_cards | search_filter_many

hand_search_target ::= target_player | target_opponent

/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Zone{scope:Players{zone:$private_cards_origin, players:One($hand_search_target)}, kind:Card, filter:Any}, destination:Library{position:$owner_library_position, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:$hand_search_target, choices:[_{filter:$counted_search_filter, count:AsManyAsCan(CountObjects(Transition{result:@marked, phase:Before}))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($hand_search_target)}}] */
clause_private_move_search_receipt ::= hand_search_target "puts" "the" "cards" "from" "their" private_cards_origin owner_library_position "of" "their" "library" "." "search" "that" "player's" "library" "for" "that" "many" counted_search_filter "." "the" "player" "puts" "those" "cards" "into" "their" "hand" "," "then" "shuffles"

/* These follow-ups are scoped to the immediately preceding single-card exile.
   Their references and the exile destination are checked together for printing. */
/* @sem Program::Program{instructions:[...$card_exile_value_producer, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:@agree($noun, $noun_2)}, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[Pump{power:ObjectProperty{object:Result{result:@marked, phase:Before, index:0}, property:$stat, information:CurrentOrLastKnown}, toughness:Earlier{what:Exiled, measure:Of($stat_2)}}], duration:$duration, evaluation:Snapshot}}]}, otherwise:Program{}}]} */
program_top_exile_type_stats ::= card_exile_value_producer "." "if" "it's" "a" noun "card" "," "this" "creature" "gets" "+" "X" "/" "+" "Y" duration "," "where" "X" "is" "the" "exiled" noun "card's" stat "and" "Y" "is" "its" stat "."

/* @sem Program::Program{instructions:[...$card_exile_value_producer, If{condition:$condition_completed_dungeon, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:Either, cards:One(Result{result:@marked, phase:After, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}]}}]} */
program_top_exile_dungeon_play ::= card_exile_value_producer "." "if" condition_completed_dungeon "," "you" "may" "play" "that" "card" "this" "turn" "without" "paying" "its" "mana" "cost" "." "otherwise" "," "you" "may" "play" "that" "card" this_duration "."

/* @sem ObjectFilter::State(HasX) */
mill_take_has_x ::= "a" "card" "with" "{" "X" "}" "in" "its" "mana" "cost"

/* The hand selection and move are shared by the two scoped continuations. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One($target_possessive)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(Target{slot:0, index:0})}, kind:Card, filter:$adjective_nontype}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
hand_look_optional_exile_selection ::= "look" "at" target_possessive "hand" "." "you" "may" "exile" "a" adjective_nontype "card" "from" "it"

/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(Target{slot:0, index:0})}, kind:Card, filter:Any}}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[...$hand_look_optional_exile_selection, Effect{result:@next, operation:ReturnAfter{objects:Transition{result:@prior, phase:After}, duration:WhileOnBattlefield(Source)}}]}}]}, optional:true}}] */
instructions_hand_exile_until_source_leaves ::= hand_look_optional_exile_selection "until" "this" "creature" "leaves" "the" "battlefield"

/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(Target{slot:0, index:0})}, kind:Card, filter:Any}}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:$hand_look_optional_exile_selection}}]}, optional:true}}, If{condition:PaymentChosen(@back(4)), then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(OwnerOf(Result{result:@prior, phase:After, index:0}))), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:CastSpell, filter:Any}, terms:_{cost:Additional(Cost{parts:[Mana($mana_symbols)]})}})], duration:WhileExiled(Result{result:@prior, phase:After, index:0}), evaluation:LiveObjects}}]}, otherwise:_{}}] */
instructions_hand_exile_owner_play_cost ::= hand_look_optional_exile_selection "." "for" "as" "long" "as" "that" "card" "remains" "exiled" "," "its" "owner" "may" "play" "it" "." "a" "spell" "cast" "this" "way" "costs" mana_symbols "more" "to" "cast"

/* A searched selection is revealed before another player partitions it. The
   choice and both moves retain the original search and choice receipts. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$searched_partition_episode]}} */
spell_searched_partition ::= searched_partition_episode "."

/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$partition_search_choice]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, ...$partition_choice_and_move, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
searched_partition_episode ::= "search" "your" "library" "for" partition_search_choice "and" "reveal" "them" "." partition_choice_and_move "." "then" "shuffle"

partition_search_choice ::= partition_search_count | partition_search_distinct

/* @sem SearchChoice::SearchChoice{filter:$random_any_cards, count:AsManyAsCan($count)} */
partition_search_count ::= count random_any_cards

/* @sem SearchChoice::SearchChoice{filter:$random_any_cards, count:UpTo($count), constraints:[DifferentNames]} */
partition_search_distinct ::= "up" "to" count random_any_cards "with" "different" "names"

partition_choice_and_move ::= partition_choice_one | partition_choice_many

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$target_opponent, objects:Selected(@marked), count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$partition_destination, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Unselected(@back(3)), destination:$partition_destination_2, qualifiers:[]}}] */
partition_choice_one ::= target_opponent "chooses" "one" "." "put" "that" "card" partition_destination "and" "the" "rest" partition_destination

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$target_opponent, objects:Selected(@marked), count:AsManyAsCan($count_plural), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$partition_destination, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Unselected(@back(3)), destination:$partition_destination_2, qualifiers:[]}}] */
partition_choice_many ::= target_opponent "chooses" count_plural "of" "those" "cards" "." "put" "the" "chosen" "cards" partition_destination "and" "the" "rest" partition_destination

partition_destination ::= until_hand | top_reveal_graveyard

/* The color population defines both X and the available color choices; the permission refers to the actual exile move. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:$card_filter, count:CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, property:Colors}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@prior), zone:Library}, count:UpTo(Constant(5)), constraints:[OneForEach([AllOf([Color(White), Condition(Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, filter:Color(White)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})]), AllOf([Color(Blue), Condition(Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, filter:Color(Blue)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})]), AllOf([Color(Black), Condition(Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, filter:Color(Black)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})]), AllOf([Color(Red), Condition(Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, filter:Color(Red)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})]), AllOf([Color(Green), Condition(Compare{left:CountObjects(Matching{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, filter:Color(Green)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}})])]), CanMoveTo{destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@marked, phase:After}, origins:CardPlayOrigins([Exile]), action:CastSpell, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}]} */
reveal_colors_exile_cast_program ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "X" card_filter "cards" "," "where" "X" "is" "the" "number" "of" "colors" "among" filter_plural "." "for" "each" "of" "those" "colors" "," "you" "may" "exile" "a" "card" "of" "that" "color" "from" "among" "the" "revealed" "cards" "." "then" "shuffle" "." "you" "may" "cast" "the" "exiled" "cards" this_duration "."

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$reveal_colors_exile_cast_program} */
trigger_turn_reveal_colors_exile ::= "at" turn_event "," reveal_colors_exile_cast_program

/* The mill, entry, and delayed return share the same proved movement receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Mill{players:One(AbilityController), amount:$count_plural}}, Effect{result:@mark, operation:Move{objects:Matching{objects:Recorded(@prior), filter:CardType(Creature)}, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Transition{result:@marked, phase:After}), changes:$grants, duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Transition{result:@marked, phase:After}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}}] */
mill_creatures_entry_return ::= "mill" count_plural "cards" "." "put" "each" "creature" "card" "milled" "this" "way" "onto" "the" "battlefield" "." "they" "gain" grants "." "at" "the" "beginning" "of" "the" "next" "end" "step" "," "return" "those" "creatures" "to" "their" "owner's" "hand"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}, ...$mill_creatures_entry_return]}} */
shuffle_mill_creatures_entry_return ::= "shuffle" "your" "library" "," "then" mill_creatures_entry_return "."

/* The comparison uses the proved singular sacrifice payment in this ability. */
/* @sem ObjectFilter::@and($card_filter, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:Expr::ObjectProperty{object:@sacrificed_object, property:ManaValue, information:CurrentOrLastKnown}}}) */
reveal_card_less_than_sacrifice ::= "a" card_filter "card" "with" "lesser" "mana" "value"

/* The reveal, entry and remainder share their observation and move receipts. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$reveal_card_less_than_sacrifice, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$reveal_card_less_than_sacrifice}, destination:$until_destination, qualifiers:[]}}, Effect{result:@next, operation:$rest_bottom}] */
/* @prefer always */
instructions_reveal_less_sacrifice ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" reveal_card_less_than_sacrifice "," "put" "it" until_destination "," "then" "put" rest_bottom

/* A single named player searches their own library, moves the selection under their control, and shuffles. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:$search_player, library_owner:$search_player, choices:[$player_search_one_choice]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player($search_player), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($search_player)}}] */
player_search_battlefield ::= search_player "searches" "their" "library" "for" player_search_one_choice "," "puts" found_one search_option_entry "," "then" "shuffles"

/* The permission names the arrival of this specific exile, across its return instruction. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_another), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReturnAfter{objects:Transition{result:@prior, phase:After}, duration:WhileOnBattlefield($self_ref)}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@back(3), phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:$exiled_play_action, filter:Any}, terms:_{cost:Normal, spend_as:$exile_return_spending}})], duration:WhileExiled(Result{result:@back(3), phase:After, index:0}), evaluation:LiveObjects}}] */
instructions_exile_until_leaves_cast_spending ::= "exile" target_another "until" self_ref "leaves" "the" "battlefield" "." "you" "may" exiled_play_action "that" "card" "for" "as" "long" "as" "it" "remains" "exiled" "," "and" exile_return_spending

exile_return_spending ::= hidden_exile_any_type | exiled_spending

/* The alternatives form one choice; the name constraint applies to the whole selection. */
/* @sem SearchChoice::SearchChoice{filter:AnyOf([AllOf([Supertype(Basic), $noun]), $subtype]), count:UpTo($number), constraints:[DifferentNames]} */
search_choice_basic_or_subtype_distinct ::= "up" "to" number "basic" noun "cards" "and" "/" "or" subtype "cards" "with" "different" "names"

/* @sem ObjectFilter::Shares{property:CreatureTypes, with:$object_ref} */
dig_reveal_selection_shared_creature_type ::= "a" "card" "that" "shares" "a" "creature" "type" "with" object_ref "from" "among" "them" "and" "put" "it"

/* A card qualified by its exact number of colors. */
/* @sem $filter_exact_color_count */
a_card_exact_colors ::= "a" "card" filter_exact_color_count

/* @sem Program::Program{instructions:[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$number, from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:AllOf([$adjective_nontype, AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)])])}, count:AnyNumber, constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, TotalProperty{property:ManaValue, comparison:LessOrEqual, amount:$number_2}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Random}}]} */
program_sentence_look_permanents_total_value ::= "look" "at" "the" "top" number "cards" "of" "your" "library" "." "put" "any" "number" "of" adjective_nontype "permanent" "cards" "with" "total" "mana" "value" number "or" "less" "from" "among" "them" "onto" "the" "battlefield" "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order" "."

/* Keep the observation, entry, conditional attachment and remainder in one
   program: both uses of the movement receipt depend on this battlefield move. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$look_top_spelled_count}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(0), zone:Library}, filter:$filter_phrase}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:2, phase:After, index:0}, filter:$filter_phrase_2}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase_3}, count:AsManyAsCan($counter_a)}}, Effect{result:@next, operation:Attach{attachments:One(Result{result:2, phase:After, index:0}), host:Result{result:@prior, phase:After, index:0}}}]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(0), excluding:Union([Transition{result:2, phase:Before}])}, zone:Library}, end:Bottom, order:Random}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(0), excluding:Union([Transition{result:2, phase:Before}])}, zone:Library}, end:Bottom, order:Random}}]}}]} */
program_look_entry_optional_attach_remainder ::= look_top_spelled_count "." "you" "may" "put" "an" filter_phrase "card" "from" "among" "them" "onto" "the" "battlefield" "." "if" "an" filter_phrase "is" "put" "onto" "the" "battlefield" "this" "way" "," "you" "may" "attach" "it" "to" counter_a filter_phrase "." "put" "the" "rest" "of" "those" "cards" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order" "."

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$program_look_entry_optional_attach_remainder} */
trigger_look_entry_optional_attach_remainder ::= event_clause "," program_look_entry_optional_attach_remainder

/* @sem ObjectSet::Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), count:Constant(1), from:Top} */
topmost_library_card ::= "the" "topmost" filter_phrase "card" "in" "your" "library"

/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$dig_put_shared_creature_type, $dig_rest_put] */
dig_reveal_shared_split ::= reveal_top "." dig_put_shared_creature_type "." dig_rest_put

/* The observed card shares a creature type with the named reference. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:Shares{property:CreatureTypes, with:$object_ref}}, count:UpTo($card_count_one), constraints:[CanMoveTo{destination:$dig_destination}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}] */
dig_put_shared_creature_type ::= "you" "may" "put" card_count_one "that" "shares" "a" "creature" "type" "with" object_ref "from" "among" "them" dig_destination

/* The look, optional reveal, and test all refer to the same unchanged top card.
   Keep the whole sequence together so the reveal wording cannot describe another producer. */
/* @sem Program::Program{instructions:[...$top_card_look, Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[If{condition:Compare{left:CountObjects(Matching{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, filter:$look_reveal_card_filter}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:$program, otherwise:Program{}}]}, otherwise:Program{}}]} */
program_look_optional_reveal_qualified ::= top_card_look "you" "may" "reveal" "that" "card" "." "if" look_reveal_card_filter "is" "revealed" "this" "way" "," program "."

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$program_look_optional_reveal_qualified} */
triggered_turn_look_optional_reveal ::= "at" turn_event "," program_look_optional_reveal_qualified

/* @sem ObjectFilter::AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number_digits}}]) */
look_reveal_qualified_filter ::= filter_phrase "card" "with" "mana" "value" number_digits "or" "greater"

/* This remainder belongs to the revealed library slice and excludes the
   immediately preceding move. Keep the producer and both consumers together. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, $dig_put_all_revealed, $dig_reveal_rest_hand] */
dig_reveal_all_hand ::= reveal_top "." dig_put_all_revealed dig_reveal_rest_hand

/* @sem Instruction::Effect{result:@next, operation:Move{objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$search_filter_many}, destination:$dig_destination, qualifiers:[]}} */
dig_put_all_revealed ::= "put" "all" search_filter_many "revealed" "this" "way" dig_destination

/* @sem Instruction::Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(2), phase:Before}])}, zone:Library}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}} */
dig_reveal_rest_hand ::= "and" "the" "rest" "into" "your" "hand"

/* The delayed count is tied to the preceding exile move.  Keeping both
   instructions in this contract makes its inverse verify the producer too. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:$object_set, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:_{instructions:$exile_count_reveal_body}}}] */
instructions_exile_count_reveal ::= "exile" object_set "." "at" "the" "beginning" "of" "the" "next" "end" "step" "," exile_count_reveal_body

/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:@agree($card_filter, $card_filter_2), count:CountObjects(Transition{result:@marked, phase:Before})}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@prior), filter:@agree($card_filter, $card_filter_2)}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
exile_count_reveal_body ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "that" "many" card_filter "cards" "," "put" "all" card_filter "cards" "revealed" "this" "way" "onto" "the" "battlefield" "," "then" "shuffle" "the" "rest" "of" "the" "revealed" "cards" "into" "your" "library"

/* The reveal, matching exile, remainder and cast share one receipt contract. */
/* @sem Instruction::[...$reveal_until_exile_remainder, ...$look_cast_exiled] */
reveal_until_exile_remainder_cast ::= reveal_until_exile_remainder "." look_cast_exiled

/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$reveal_until_card, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$reveal_until_card}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:$rest_bottom}] */
reveal_until_exile_remainder ::= reveal_until_exile_prefix reveal_until_card "." "exile" "that" "card" "and" "put" rest_bottom

reveal_until_exile_prefix ::= reveal_until_it_library

/* An initial instruction can precede the scoped reveal and exile sequence. */
/* @sem Instruction::[Effect{result:@next, operation:$shuffle_your_library}, ...$reveal_until_exile_remainder_cast] */
reveal_until_exile_prefixed ::= shuffle_your_library "," "then" reveal_until_exile_remainder_cast

/* A singular search result is moved to exile before its current mana value is
   used. The final shuffle belongs to the library's targeted player. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:$target_possessive, choices:[$search_exile_single_choice]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
search_foreign_single_exile ::= "search" target_possessive "library" "for" search_exile_single_choice "and" "exile" "it"

/* @sem SearchChoice::SearchChoice{filter:$search_filter, count:AsManyAsCan(Constant(1))} */
search_exile_filtered_choice ::= ("a" | "an") search_filter

search_exile_single_choice ::= search_choice_any | search_exile_filtered_choice

/* @sem Instruction::[...$search_foreign_single_exile, Effect{result:@next, operation:$exiled_single_value_life}, Effect{result:@next, operation:Shuffle{players:One(Target{slot:@last_slot, index:0})}}] */
clause_search_exile_value_shuffle ::= search_foreign_single_exile "." exiled_single_value_life "." "then" "that" "player" "shuffles"

/* @sem Operation::GainLife{players:One(AbilityController), amount:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:$stat, information:CurrentOrLastKnown}} */
exiled_single_value_life ::= "you" "gain" "life" "equal" "to" "its" stat

/* Count the actual still-present targets, not the optional exile payments. */
/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Targets(0), filter:InZone(Shared(Battlefield))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:_{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:$noun, count:UpTo(CountObjects(InZone{objects:Targets(0), zone:Battlefield}))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:_{}} */
search_for_remaining_targets_tapped ::= "then" "if" "one" "or" "more" "of" "the" "chosen" "permanents" "are" "still" "on" "the" "battlefield" "," "you" "search" "your" "library" "for" "up" "to" "that" "many" noun "cards" "," "put" "them" "onto" "the" "battlefield" "tapped" "," "then" "shuffle"

/* The ability boundary proves target slot zero is the selected population. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[$per_opponent_target_controller_exile, $search_for_remaining_targets_tapped]}} */
spell_per_opponent_choice_remaining_search ::= per_opponent_target_controller_exile "." search_for_remaining_targets_tapped "."

/* A single-card exile supplies both the tested card and the optional move.
   Keep the producer in this span so the pronoun cannot bind to another action. */
repeat_exile_one_library_card ::= exile_top_card_receipt | repeat_exile_bottom_card

/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Bottom}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
repeat_exile_bottom_card ::= "exile" "the" "bottom" "card" "of" "your" "library"

repeat_exiled_card_filter ::= chosen_permanent_card_filter | card_filter

repeat_exiled_battlefield ::= selected_onto_battlefield | look_battlefield_tapped

/* @sem Cost::Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}, destination:$repeat_exiled_battlefield, qualifiers:[]}}]}}]} */
repeat_exiled_put_cost ::= "you" "may" "put" "it" repeat_exiled_battlefield

/* @sem Instruction::[Repeatable{instructions:[Effect{result:@mark, operation:$repeat_exile_one_library_card}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$repeat_exiled_card_filter}, then:Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$repeat_exiled_put_cost, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}]}, otherwise:Program{}}]}] */
instructions_repeat_exiled_card ::= repeat_exile_one_library_card "." "if" "it's" "a" repeat_exiled_card_filter "card" "," repeat_exiled_put_cost "." "if" "you" "do" "," "repeat" "this" "process"

/* The counted token creation is tied to this particular search and exile. */
/* @sem Instruction::[Effect{result:@next, operation:$search_any_number}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:CountObjects(Transition{result:@prior, phase:Before}), words:CreatingEffect, recipe:$token_recipe_plain}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
clause_search_exile_create_tokens ::= search_any_number "," "exile" "them" "," "then" "create" "that" "many" token_recipe_plain "." "then" "shuffle"

/* The producer and the optional selection share the same mill receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Move{selections:[_{objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$mill_payment_filter}, choose:Exactly($counter_amount)}], destination:OwnersHand(CardArrival{counters:[], states:[]})}]}, optional:true}}, If{condition:Not(PaymentChosen(@last_result)), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
instructions_mill_optional_hand_payment ::= "mill" card_count "." "you" "may" "put" counter_amount mill_payment_filter "from" "among" "the" "cards" "milled" "this" "way" "into" "your" "hand" "." "if" "you" "don't" "," conjoined

mill_payment_filter ::= mill_payment_union | negative_card_pair

/* @sem ObjectFilter::AnyOf([$filter_phrase, AllOf([$filter_phrase_2, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])]) */
mill_payment_union ::= filter_phrase "card" "or" "a" filter_phrase "card" "with" "mana" "value" value "or" "less"

/* A choice among three card qualities shares a single selection. */
/* @sem ObjectFilter::AnyOf([$subtype_spelled, Subtype(Plains), $filter_phrase]) */
a_card_three_types ::= "a" subtype_spelled "," "↑" "plains" "," "or" filter_phrase "card"

/* Sequential distinct selections from one observed library population. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$filter_phrase}, count:UpTo($counter_amount), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Difference{objects:InZone{objects:Observed(@marked), zone:Library}, excluding:Union([Selected(@prior)])}, filter:$filter_phrase_2}, count:UpTo($counter_amount_2), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Difference{objects:InZone{objects:Observed(@marked), zone:Library}, excluding:Union([Selected(@back(3)), Selected(@prior)])}, filter:$filter_phrase_3}, count:UpTo($counter_amount_3), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Reveal{objects:Union([Selected(@back(4)), Selected(@back(3)), Selected(@prior)])}}, Effect{result:@next, operation:Move{objects:Union([Selected(@back(5)), Selected(@back(4)), Selected(@back(3))]), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
dig_reveal_three_each ::= "you" "may" "reveal" counter_amount filter_phrase "card" "," counter_amount filter_phrase "card" "," "and" "/" "or" counter_amount filter_phrase "card" "from" "among" "them" "and" "put" "them" "into" "your" "hand"

/* Sequential distinct selections from one observed library population. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$filter_phrase}, count:UpTo($counter_amount), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Difference{objects:InZone{objects:Observed(@marked), zone:Library}, excluding:Union([Selected(@prior)])}, filter:$filter_phrase_2}, count:UpTo($counter_amount_2), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Difference{objects:InZone{objects:Observed(@marked), zone:Library}, excluding:Union([Selected(@back(3)), Selected(@prior)])}, filter:$filter_phrase_3}, count:UpTo($counter_amount_3), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Difference{objects:InZone{objects:Observed(@marked), zone:Library}, excluding:Union([Selected(@back(4)), Selected(@back(3)), Selected(@prior)])}, filter:$filter_phrase_4}, count:UpTo($counter_amount_4), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Reveal{objects:Union([Selected(@back(5)), Selected(@back(4)), Selected(@back(3)), Selected(@prior)])}}, Effect{result:@next, operation:Move{objects:Union([Selected(@back(6)), Selected(@back(5)), Selected(@back(4)), Selected(@back(3))]), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
dig_reveal_four_each ::= "you" "may" "reveal" counter_amount filter_phrase "card" "," counter_amount filter_phrase "card" "," counter_amount filter_phrase "card" "," "and" "/" "or" counter_amount filter_phrase "card" "from" "among" "them" "and" "put" "those" "cards" "into" "your" "hand"

/* @prefer always */
/* @sem $card_ability_qualifier */
a_card_ability ::= "a" "card" card_ability_qualifier

/* The immediately preceding look fixes the revealed card and its library. */
/* @sem Instruction::[...$top_card_look, Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[RevealTop($card_filter)]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:$token_groups, entry:BattlefieldArrival{}}}]}, otherwise:Program{}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}] */
look_reveal_create_then_draw ::= top_card_look "you" "may" "reveal" "it" "if" "it's" "a" card_filter "card" "." "create" token_groups "if" "you" "revealed" "it" "this" "way" "." "then" "draw" card_count

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$look_reveal_create_then_draw}} */
triggered_look_reveal_create_then_draw ::= "at" turn_event "," look_reveal_create_then_draw "."

/* The selected cards and shuffling player belong to the enclosing player loop. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}] */
bound_search_put_tapped_shuffle ::= "puts" "those" "cards" "onto" "the" "battlefield" "tapped" "," "then" "shuffles"

/* The maximum and each player's count remain distinct operands. */
/* @sem Instruction::[Effect{result:@next, operation:BindValue{value:AmongPlayers{players:$players_singular, number:Permanents($filter_plural_2), aggregation:Maximum}}}, ForEachPlayer{players:Matching{binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}), test:NumberTest::Compare{comparison:Less, value:BoundValue(0)}}}, binding:0, body:Program{instructions:[Effect{result:@next, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[_{filter:$filter_phrase, count:UpTo(Subtract(BoundValue(@prior), CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])})))}]}}, ...$bound_search_put_tapped_shuffle]}}] */
players_fewer_max_search_difference ::= players_singular "who" "controls" "fewer" filter_plural "than" "the" "player" "who" "controls" "the" "most" filter_plural "searches" "their" "library" "for" "a" "number" "of" filter_phrase "cards" "less" "than" "or" "equal" "to" "the" "difference" "," bound_search_put_tapped_shuffle

/* A singular player searches their own library, moves the selection under their
   control, and shuffles. The selection remains tied to this search. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:$search_player, library_owner:$search_player, choices:[$player_search_one_choice]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player($search_player), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($search_player)}}] */
clause_player_search_battlefield ::= search_player "searches" "their" "library" "for" player_search_one_choice "," "puts" "it" search_option_entry "," "then" "shuffles"

/* A revealed match can enter or remain to be put into its owner's hand.
   The follow-up retains both movement receipts for the library remainder. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$until_entry_filter, count:Constant(1)}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Observed(@marked), filter:$until_entry_filter}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$until_entry_filter}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
until_entry_or_hand_an ::= reveal_until_your_library "an" until_entry_filter "card" "." "you" "may" "put" "that" "card" "onto" "the" "battlefield" "." "if" "you" "don't" "," "put" "it" "into" "your" "hand"

/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(3), phase:Before}, Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order} */
reveal_entry_hand_rest ::= "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Instruction::[...$until_entry_or_hand_an, Effect{result:@next, operation:$reveal_entry_hand_rest}] */
reveal_until_entry_or_hand_remainder ::= until_entry_or_hand_an "." reveal_entry_hand_rest

/* The observation, selected matching card, and remainder share one loop player. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:Bound(0), filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$card_filter}, destination:$bound_reveal_destination, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:Bound(0), library_owner:Bound(0), objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Random}}] */
bound_reveal_entry_remainder ::= "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" "a" card_filter "card" "," "puts" "it" bound_reveal_destination "," "and" "puts" "the" "rest" "on" "the" "bottom" "of" "their" "library" "in" "a" "random" "order"

/* @sem Instruction::[ForEachPlayer{players:$loop_player_population, binding:0, body:Program{instructions:$bound_reveal_entry_remainder}}] */
bound_players_reveal_entry ::= loop_player_population bound_reveal_entry_remainder

/* @sem $bound_players_reveal_entry */
instructions_then_bound_reveal_entry ::= "then" bound_players_reveal_entry

/* @prefer always */
/* @sem MovementDestination::Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
bound_reveal_entry_destination ::= "onto" "the" "battlefield"

/* @sem MovementDestination::Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}} */
bound_reveal_entry_tapped_destination ::= "onto" "the" "battlefield" "tapped"

bound_reveal_destination ::= bound_reveal_entry_destination | bound_reveal_entry_tapped_destination

/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:Bound(0), filter:$card_filter, count:$bound_reveal_plural_number}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$card_filter}, destination:$bound_reveal_destination, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:Bound(0), library_owner:Bound(0), objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Random}}] */
bound_reveal_entries_remainder ::= "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" bound_reveal_plural_number card_filter "cards" "," "puts" "them" bound_reveal_destination "," "and" "puts" "the" "rest" "on" "the" "bottom" "of" "their" "library" "in" "a" "random" "order"

/* @sem Instruction::[ForEachPlayer{players:$loop_player_population, binding:0, body:Program{instructions:$bound_reveal_entries_remainder}}] */
bound_players_reveal_entries ::= loop_player_population bound_reveal_entries_remainder

/* @sem $bound_players_reveal_entries */
instructions_then_bound_reveal_entries ::= "then" bound_players_reveal_entries

bound_reveal_plural_number ::= n2 | n3 | n4 | n5 | n6 | n7 | n8 | n9 | n10 | n11 | n12 | n13 | n14 | n15 | n20 | n30 | number_hundred

/* Keep the random selection, exile and permission in one receipt contract. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(EventSubject)}, kind:Card, filter:$adjective_nontype}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:CastSpell, filter:Any}, terms:_{cost:Normal, spend_as:$random_library_cast_spending, condition:$attacked_type_pair_condition}})], duration:WhileExiled(Result{result:@prior, phase:After, index:0}), evaluation:LiveObjects}}]} */
program_random_library_conditional_cast ::= "exile" "a" adjective_nontype "card" "from" "their" "library" "at" "random" "." "during" "any" "turn" attacked_type_pair_condition "," "you" "may" "cast" "that" "card" "and" random_library_cast_spending "."

/* The singular top-library exile supplies both the conditional change and
   the permission. Keeping the whole sequence together proves the receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($zone_that_player)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:AllOf([Not(CardType(Land)), AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)])])}, then:Program{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@marked, phase:After, index:0}), changes:[AddCardType($vowel_card_type)]}}]}, otherwise:Program{}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:$duration, evaluation:LiveObjects}}] */
exile_top_perpetual_type_permission ::= "exile" "the" "top" "card" "of" zone_that_player "library" "." "it" "perpetually" "becomes" "an" vowel_card_type "if" "it's" "a" "nonland" "permanent" "card" "." duration "," "you" "may" "play" "the" "exiled" "card"

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$exile_top_perpetual_type_permission}} */
triggered_exile_top_perpetual_permission ::= event_clause "," exile_top_perpetual_type_permission "."

/* Choosing any number already permits choosing none. */
/* @sem $clause_hand_any_number_battlefield */
clause_may_hand_any_number_battlefield ::= "you" "may" clause_hand_any_number_battlefield

/* A revealed top card can be offered to opponents before its two outcomes. */
/* @sem Cost::Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]} */
top_card_opponent_graveyard_offer ::= "any" "opponent" "may" "have" "you" "put" "that" "card" "into" "your" "graveyard"

/* @sem Instruction::[Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(One(Performer(@marked))), amount:Earlier{what:PutInGraveyard, measure:Of(ManaValue)}, preventable:true}}] */
top_card_offer_damage ::= object_ref "deals" "damage" "to" "that" "player" "equal" "to" "that" "card's" "mana" "value"

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:$top_reveal_destination, qualifiers:[]}}] */
top_card_offer_fallback ::= "put" "that" "card" top_reveal_destination

/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, Effect{result:@mark, operation:PayCost{player:FirstWilling(OpponentsOf(AbilityController)), cost:$top_card_opponent_graveyard_offer, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$top_card_offer_damage}, otherwise:Program{instructions:$top_card_offer_fallback}}] */
instructions_reveal_opponent_graveyard_offer ::= "reveal" "the" "top" "card" "of" "your" "library" "." top_card_opponent_graveyard_offer "." "if" "a" "player" "does" "," top_card_offer_damage "." "otherwise" "," top_card_offer_fallback

/* Both choices are made from the controller's revealed library. The grouped
   producer proves that the selected cards' owners receive them in your hand. */
dig_reveal_selected_split ::= dig_reveal_opponent_selected | dig_reveal_color_selected

/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ForEachPlayer{players:$players_singular, binding:0, starting_with:Seat{of:AbilityController, side:Next}, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$adjective_nontype}, count:AsManyAsCan($counter_amount), constraints:[Unpicked]}}]}}, Effect{result:@next, operation:$selected_library_hand}, $dig_rest_and] */
dig_reveal_opponent_selected ::= reveal_top "." "starting" "with" "the" "next" "opponent" "in" "turn" "order" "," players_singular "chooses" counter_amount "different" adjective_nontype "card" "from" "among" "them" "." selected_library_hand dig_rest_and

/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AnyNumber, constraints:[NoCommonProperty(ColorPairs)]}}, Effect{result:@next, operation:$selected_library_hand}, $dig_rest_and] */
dig_reveal_color_selected ::= reveal_top "." "for" "each" "color" "pair" "," "choose" "a" "card" "that's" "exactly" "those" "colors" "from" "among" "them" "." selected_library_hand dig_rest_and

/* @sem Operation::Move{objects:Selected(@prior), destination:$partition_destination, qualifiers:[]} */
selected_library_hand ::= "put" "the" "chosen" "cards" partition_destination

/* The observation and both payment-partition moves share the same library receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top_for_conditional_rest}, ...$observed_payment_graveyard_rest_hand] */
dig_look_payment_partition ::= look_top_for_conditional_rest "." observed_payment_graveyard_rest_hand

/* @sem Instruction::[ForEachObject{objects:InZone{objects:Observed(@marked), zone:Library}, binding:0, body:_{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$cost, optional:true}}]}}, Effect{result:@next, operation:Move{objects:Unpaid(@prior), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
observed_payment_graveyard_rest_hand ::= "for" "each" "card" "," "put" "that" "card" "into" "your" "graveyard" "unless" "you" cost "." "then" "put" "the" "rest" "into" "your" "hand"

/* The reveal and cast share the same single library-top operand. The
   parity test is on the observation and the fallback runs on either failure. */
/* @sem ObjectFilter::Property{property:ManaValue, test:$number_parity} */
revealed_mana_value_parity ::= "if" "its" "mana" "value" "is" number_parity

/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:$single_library_top}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$revealed_mana_value_parity}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:$revealed_it_free_cast, cards:$single_library_top, count:Exactly(Constant(1)), terms:_{cost:Free}}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@prior)), then:$program, otherwise:Program{}}]}, otherwise:$program}] */
instructions_reveal_parity_free_fallback ::= "reveal" single_library_top "." "you" "may" revealed_it_free_cast revealed_mana_value_parity "." "if" "you" "don't" "cast" "it" "," program

/* Keep the reveal receipt, independently filtered hand move and remainder in
   one scope, so revealed wording cannot print from a look or movement receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$adjective_nontype, count:$count_plural}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$adjective_nontype_2}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:$revealed_partition_remainder}] */
reveal_until_filtered_hand_partition ::= reveal_until_your_library count_plural adjective_nontype "cards" "." "put" "the" adjective_nontype "cards" "revealed" "this" "way" "into" "your" "hand" "," "then" "put" revealed_partition_remainder

/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(2), phase:Before}])}, zone:Library}, end:Bottom, order:$library_order} */
revealed_partition_remainder ::= "the" "rest" "of" "the" "revealed" "cards" "on" "the" "bottom" "of" "your" "library" library_order

/* Repeat a single-card reveal after moving that same observation. */
/* @sem Instruction::[Repeatable{instructions:[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[...$observed_top_reveal_put, Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}]}] */
instructions_repeat_observed_top ::= "reveal" "the" "top" "card" "of" "your" "library" "." "if" "it's" top_reveal_quality "," observed_top_reveal_put "and" "repeat" "this" "process"

/* A general follow-up can act on a separately referenced object. */
/* @sem Instruction::[Repeatable{instructions:[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}]}] */
instructions_repeat_top_followup ::= "reveal" "the" "top" "card" "of" "your" "library" "." "if" "it's" top_reveal_quality "," operation "and" "repeat" "this" "process"

/* The revealed card enters with its counter and retained added card type. */
/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[Changes([AddCardType($vowel_card_type)])]}} */
top_reveal_counter_added_vowel ::= "onto" "the" "battlefield" "with" "a" counter_kind "counter" "on" "it" "." "that" "permanent" "is" "an" vowel_card_type "in" "addition" "to" "its" "other" "types"

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, Constant(1)]], states:[Changes([AddCardType($consonant_card_type)])]}} */
top_reveal_counter_added_consonant ::= "onto" "the" "battlefield" "with" "a" counter_kind "counter" "on" "it" "." "that" "permanent" "is" "a" consonant_card_type "in" "addition" "to" "its" "other" "types"

/* These two spellings feed the same card filter to the reveal and move. */
/* shuffle_reveal_card_a is shared as mill_test_card_filter. */

/* @sem $filter_phrase */
shuffle_reveal_card_an ::= "an" filter_phrase "card"

shuffle_reveal_card ::= mill_test_card_filter | shuffle_reveal_card_an

/* The reveal, battlefield move and remainder share one observation. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:RevealUntil{library:Bound(0), filter:$shuffle_reveal_card, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$shuffle_reveal_card}, destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:Bound(0), library_owner:Bound(0), objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Random}}]} */
bound_shuffle_reveal_remainder ::= "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" shuffle_reveal_card "," "then" "puts" "that" "card" "onto" "the" "battlefield" "and" "the" "rest" "on" "the" "bottom" "of" "their" "library" "in" "a" "random" "order"

/* The receipt test is valid only for the immediately preceding bound shuffle. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@mark, operation:$bound_shuffle_owned_permanents}]}}, ForEachPlayer{players:Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:MovedBy{result:@marked, phase:Before, player:Bound(0)}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}, binding:0, body:$bound_shuffle_reveal_remainder}] */
clause_owned_shuffle_reveal ::= players_singular bound_shuffle_owned_permanents "." "each" "player" "who" "shuffled" "a" filter_phrase "into" "their" "library" "this" "way" bound_shuffle_reveal_remainder

/* The matching arrivals must be produced by this same mill action. */
/* @sem ObjectFilter::HasActivatedAbility(Not(Mana)) */
nonmana_activated_ability_filter ::= "with" "activated" "abilities" "that" "aren't" "mana" "abilities"

/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:Move{objects:Matching{objects:Transition{result:@marked, phase:After}, filter:AllOf([$filter_phrase, $nonmana_activated_ability_filter])}, destination:$until_hand, qualifiers:[]}}] */
instructions_mill_matching_abilities_hand ::= "mill" card_count "." "put" "all" filter_phrase "cards" nonmana_activated_ability_filter "from" "among" "the" "milled" "cards" until_hand

/* A single library card moves to its owner's graveyard. The fixed singleton
   makes its arrival a safe antecedent for a following singular test. */
/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Bottom}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]} */
library_bottom_card_to_graveyard ::= "put" "the" "bottom" "card" "of" "your" "library" "into" "your" "graveyard"

/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]} */
library_top_card_to_graveyard ::= "put" "the" "top" "card" "of" "your" "library" "into" "your" "graveyard"

library_single_card_to_graveyard ::= library_bottom_card_to_graveyard | library_top_card_to_graveyard

/* The producer and its singular receipt stay in the same instruction scope. */
/* @sem Instruction::[Effect{result:@mark, operation:$library_single_card_to_graveyard}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$receipt_card_power_bound}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Query{objects:Transition{result:@marked, phase:After}, index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{}}] */
library_single_graveyard_test_entry ::= library_single_card_to_graveyard "." "if" "it's" receipt_card_power_bound "," "put" "it" "onto" "the" "battlefield"

/* The observation and both pure branches share one top-of-library producer.
   Each branch replaces the original event independently. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, ...$replacement_top_branch]}, otherwise:Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, ...$replacement_top_branch_2]}}] */
replacement_observed_top_split ::= reveal_top "instead" "." "if" "it's" top_reveal_quality "," replacement_top_branch "." "otherwise" "," replacement_top_branch

replacement_top_branch ::= top_reveal_branch | independent_top_continuation

/* A continuation can name an independent object. A bare move of the revealed
   card uses its own top-card production and keeps its antecedent. */
/* @sem Vec<Instruction>::@independent_top_continuation($payment_leading_operation) */
independent_top_continuation ::= payment_leading_operation

/* Independent choices and follow-ups preserve the original search receipt. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_filtered, $search_choice_filtered_2, ...$search_filtered_three]} */
search_five_choices ::= "search" "your" "library" "for" search_choice_filtered "," search_choice_filtered "," search_filtered_three

/* @sem Instruction::[Effect{result:@mark, operation:$search_five_choices}, Effect{result:@next, operation:$found_those_reveal}, ...$search_plural_follow] */
clause_search_five_choices ::= search_five_choices "." found_those_reveal search_plural_follow

/* The selected card remains the referent across the intervening operation. */
/* @sem Instruction::[Effect{result:@mark, operation:$search}, Effect{result:@next, operation:$found_that_card_reveal}, Effect{result:@next, operation:$found_it_hand}, Effect{result:@next, operation:$operation}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
clause_search_then_operation ::= search "and" found_that_card_reveal "." found_it_hand "," "then" operation "." "then" "shuffle"

/* A permanent card is one of the six permanent card types. */
/* @sem ObjectFilter::AllOf([$filter_phrase, AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)])]) */
search_filter_permanent_kind ::= filter_phrase "permanent" "card"

/* @sem ObjectFilter::AllOf([$filter_phrase, AnyOf(@unordered([HasKeywordFamily(Eternalize), HasKeywordFamily(Embalm)]))]) */
search_filter_embalm_or_eternalize ::= filter_phrase "card" "with" "eternalize" "or" "embalm"

/* The condition tests the search selection, independently of the moved card. */
/* @sem Instruction::[Effect{result:@mark, operation:$search}, Effect{result:@next, operation:$found_graveyard}, If{condition:Compare{left:CountObjects(Selected(@marked)), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:$search_found_copy_program, otherwise:Program{}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
clause_search_if_found ::= search "and" found_graveyard "." "if" "you" "do" "," search_found_copy_program "." "then" "shuffle"

/* Copy the card selected by the enclosing search, for the stated duration. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One($self_explicit_ref)), changes:[CopyOf{object:Result{result:@marked, phase:After, index:0}, exceptions:[]}], duration:$duration, evaluation:Snapshot}}]} */
search_found_copy_program ::= self_explicit_ref "becomes" "a" "copy" "of" "that" "card" duration

/* Singular references keep their stated form through a split follow-up. */
/* @sem Operation::Reveal{objects:Selected(@marked)} */
found_that_card_reveal ::= "reveal" "that" "card"

/* @sem Operation::Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
found_it_hand ::= "put" "it" "into" "your" "hand"

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:$search_filter_embalm_or_eternalize, count:UpTo(Constant(1))}]} */
search_keyword_library ::= "search" "your" "library" "for" ("a" | "an") search_filter_embalm_or_eternalize

/* @sem Operation::Move{objects:Selected(@marked), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]} */
found_that_card_graveyard ::= "put" "that" "card" "into" "your" "graveyard"

/* @sem Instruction::[Effect{result:@mark, operation:$search_keyword_library}, Effect{result:@next, operation:$found_that_card_graveyard}, ...$search_shuffle] */
clause_search_keyword_graveyard ::= search_keyword_library "," found_that_card_graveyard search_shuffle

/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:Move{objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$mill_plural_ability}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
mill_all_to_hand_milled ::= "mill" card_count "." "then" "put" "all" mill_plural_ability "from" "among" "the" "milled" "cards" "into" "your" "hand"

/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:Move{objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$search_filter_many}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
mill_all_to_hand_them ::= "mill" card_count mill_hand_join "put" "all" search_filter_many "from" "among" "them" "into" "your" "hand"

/* @sem $card_plural_ability */
mill_plural_ability ::= "cards" card_plural_ability

/* @sem ObjectFilter::State(HasAdventure) */
card_plural_ability ::= "that" "have" "an" "Adventure"

/* Reveal and divide a controller's top cards; the opponent picks one pile. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$revealed_controller_piles] */
dig_reveal_opponent_piles ::= reveal_top "and" revealed_controller_piles

/* @sem Instruction::[Effect{result:@next, operation:SeparatePiles{separator:AbilityController, chooser:OneOf(OpponentsOf(AbilityController)), objects:InZone{objects:Observed(@marked), zone:Library}}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
revealed_controller_piles ::= "separate" "them" "into" "two" "piles" "." "an" "opponent" "chooses" "one" "of" "those" "piles" "." "put" "that" "pile" "into" "your" "hand" "and" "the" "other" "into" "your" "graveyard"

/* @sem Ability::Spell{body:_{instructions:$dig_reveal_opponent_piles}, announcement:@announcement} */
spell_reveal_opponent_piles ::= dig_reveal_opponent_piles "."

/* The same singular player performs each verb. */
/* @sem Operation::Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:@subject}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_own_top_third ::= "exiles" "the" "top" "card" "of" "their" "library"

/* @sem Instruction::[Effect{result:@next, operation:$lose_life_amount}, Effect{result:@next, operation:$exile_own_top_third}] */
life_exile_verbs ::= lose_life_amount "and" exile_own_top_third

/* The selected filter controls both the stopping test and the hand move. The
   remainder excludes that same move, within each independently chosen branch. */
/* @sem Instruction::Effect{result:@next, operation:ChooseAction{actor:One(AbilityController), options:[Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:@agree($noun, $draw_kind_complement), count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@prior), filter:@agree($noun, $draw_kind_complement)}, destination:$until_destination, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(3)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}]}, Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:Not(@agree($noun, $draw_kind_complement)), count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@prior), filter:Not(@agree($noun, $draw_kind_complement))}, destination:$until_destination, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(3)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}]}, Program{instructions:[Effect{result:@next, operation:ModifyEvent{change:Cancel}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:Constant(1)}}]}]}} */
draw_choose_kind_reveal_partition ::= "you" "may" "instead" "choose" noun "or" draw_kind_complement "and" "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "a" "card" "of" "the" "chosen" "kind" "." "put" "that" "card" until_destination "and" "put" "all" "other" "cards" "revealed" "this" "way" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem ObjectFilter::CardType(Land) */
draw_kind_complement ::= "nonland"

/* This producer constrains the receipt used by the name-based library search. */
/* @sem Operation::Move{objects:Zone(_{scope:Players{zone:Graveyard, players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0})}, kind:Card, filter:Not(AllOf([Supertype(Basic), $noun]))}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_target_graveyard_except_basic ::= "exile" "all" "cards" "from" "target" "player's" "graveyard" "other" "than" "basic" noun "cards"

/* Search uses precisely that exile producer's arrival and the targeted owner. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_target_graveyard_except_basic}, Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:Target{slot:@last_slot, index:0}, choices:[_{filter:SharesNameWithAny(Transition{result:@prior, phase:After}), count:AnyNumber}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
instructions_graveyard_name_exile ::= exile_target_graveyard_except_basic "." "for" "each" "card" "exiled" "this" "way" "," "search" "that" "player's" "library" "for" "all" "cards" "with" "the" "same" "name" "as" "that" "card" "and" "exile" "them"

/* @sem Instruction::[...$instructions_graveyard_name_exile, Effect{result:@next, operation:Shuffle{players:One(Target{slot:@last_slot, index:0})}}] */
instructions_graveyard_name_exile_shuffle ::= instructions_graveyard_name_exile "." "then" "that" "player" "shuffles"

/* The producer selects at most one land per player, so each successful
   destruction has a distinct controller. Keep the receipt and the search
   together in both directions. */
/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$destroy_per_player_land_filter}, count:PerPlayer{players:All, each:UpTo(Constant(1))}, constraints:[]}], action:Destroy{objects:Prepared(@selection_id(0)), regeneration:true}} */
destroy_per_player_land ::= "for" "each" "player" "," "destroy" "up" "to" "one" destroy_per_player_land_filter "that" "player" "controls"

destroy_per_player_land_filter ::= destroy_per_player_nonbasic_land | sacrificed_basic_land | destroy_per_player_nonsnow_land

/* @sem ObjectFilter::AllOf([Not(Supertype(Basic)), CardType(Land)]) */
destroy_per_player_nonbasic_land ::= "nonbasic" "land"

/* @sem ObjectFilter::AllOf([Not(Supertype(Snow)), CardType(Land)]) */
destroy_per_player_nonsnow_land ::= "nonsnow" "land"

/* @sem Instruction::[Effect{result:@mark, operation:$destroy_per_player_land}, ForEachPlayer{players:Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:ControlledBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@next, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[_{filter:$filter_phrase, count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}]}}] */
destroy_per_player_land_search ::= destroy_per_player_land "." "for" "each" "land" "destroyed" "this" "way" "," "its" "controller" "may" "search" "their" "library" "for" "a" filter_phrase "card" "," "put" "it" "onto" "the" "battlefield" "tapped" "," "then" "shuffle"

/* The name comparison retains the earlier sacrificed object as the referent. */
/* @sem SearchChoice::SearchChoice{filter:SharesNameWith(Earlier{what:Sacrificed}), count:UpTo($card_count_one)} */
search_choice_sacrificed_creature_name ::= card_count_one "with" "the" "same" "name" "as" "the" "sacrificed" "creature"

/* Preserve the explicit observation wording for this choice; later actions
   still use the ordinary search follow-up and the same selected receipt. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_sacrificed_creature_name]} */
search_sacrificed_creature_name ::= "search" "your" "library" "for" search_choice_sacrificed_creature_name

/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:$search_sacrificed_creature_name}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, ...$search_follow] */
clause_search_sacrificed_reveal ::= search_sacrificed_creature_name "," "reveal" "that" "card" search_follow

/* A selected population makes individual choices with the same bound actor. */
/* @sem Instruction::[ForEachPlayer{players:$announced_many_players, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:$bound_search_control_program}]}}] */
announced_may_each_search ::= announced_many_players "may" "each" bound_search_control_program

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[$bound_search_find]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]} */
bound_search_control_program ::= "search" "their" "library" "for" bound_search_find "onto" "the" "battlefield" "under" "their" "control" "," "then" "shuffle"

bound_search_find ::= bound_search_find_one | bound_search_find_many

/* @sem $player_search_one_choice */
bound_search_find_one ::= player_search_one_choice "," "put" "it"

/* @sem $player_search_many_choice */
bound_search_find_many ::= player_search_many_choice "," "put" "them"

/* The selected search choice supplies the card moved to its owner's hand. */
/* @sem Instruction::[ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[$each_search_hand_choice]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}]}}] */
each_may_search_hand_then_each_shuffle ::= hand_plural_players "may" "search" "their" "library" "for" each_search_hand_choice "into" "their" "hand" "." "then" "each" "player" "who" "searched" "their" "library" "this" "way" "shuffles"

each_search_hand_choice ::= each_search_entry_it | each_search_hand_that | each_search_hand_counted

/* @prefer always */
/* @sem SearchChoice::$each_search_entry_that */
each_search_hand_that ::= each_search_entry_that

/* @sem SearchChoice::SearchChoice{filter:Any, count:AsManyAsCan($count)} */
each_search_hand_counted ::= count "cards" "and" "put" "those" "cards"

/* The random selection composes with ordinary search continuations. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_random_filtered_card}, ...$random_search_follow] */
clause_random_search ::= search_random_filtered_card random_search_follow

random_search_follow ::= random_search_reveal_follow | search_follow

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, ...$search_follow] */
random_search_reveal_follow ::= "," "reveal" "that" "card" search_follow

/* A randomly selected matching card remains the search receipt for the ordinary follow-ups. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:$filter_phrase, count:AsManyAsCan($counter_a), constraints:[AtRandom]}]} */
search_random_filtered_card ::= "choose" counter_a filter_phrase "card" "at" "random" "from" "your" "library"

/* The search quantity is the before receipt of the immediately preceding exile.
   The player who chooses, searches, receives the cards, and shuffles is the same. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_objects}, Optional{decider:$that_player, body:Program{instructions:[Effect{result:@next, operation:Search{searcher:$that_player, library_owner:$that_player, choices:[_{filter:$filter_phrase, count:UpTo(CountObjects(Transition{result:@marked, phase:Before}))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player($that_player), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($that_player)}}]}}] */
exile_count_player_search ::= exile_objects "." that_player "may" "search" "their" "library" "for" "that" "many" filter_phrase "cards" "," "put" "those" "cards" "onto" "the" "battlefield" "tapped" "," "then" "shuffle"

/* A loop-bound player searches their own library and retains the search
   selection across the shuffle before putting it on top. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[$bound_player_search_top_choice]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0)), excluding:Selected(@marked)}}, Effect{result:@next, operation:ReorderLibrary{chooser:Bound(0), library_owner:Bound(0), objects:Selected(@marked), end:Top, order:Chosen}}] */
bound_player_search_top ::= bound_player_search_top_choice

bound_player_search_top_choice ::= bound_player_search_top_that | bound_player_search_top_counted | player_search_top

/* @prefer always */
/* @sem $player_search_one_choice */
bound_player_search_top_that ::= "searches" "their" "library" "for" player_search_one_choice "," "then" "shuffles" "and" "puts" "that" "card" "on" "top"

/* @sem Instruction::ForEachPlayer{players:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly($number), filter:Any, players:All})), binding:0, body:Program{instructions:$chosen_players_action}} */
chosen_players_loop ::= "choose" number "target" "players" "." "each" "of" "them" chosen_players_action

chosen_players_action ::= bound_player_search_top

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[$chosen_players_loop]}} */
spell_chosen_players_loop ::= chosen_players_loop "."

/* A plural selection remains the search receipt through the shuffle. */
/* @sem $foreign_choice_count */
bound_player_search_top_counted ::= "searches" "their" "library" "for" foreign_choice_count "," "then" "shuffles" "and" "puts" "those" "cards" "on" "top"

/* The name refers to the preceding action’s resulting card. */
/* @sem SearchChoice::SearchChoice{filter:SharesNameWith(Result{result:@prior, phase:After, index:0}), count:$named_search_count} */
search_choice_prior_card_name ::= named_search_count "cards" "with" "the" "same" "name" "as" "that" "card"

each_search_selection ::= each_search_selection_one | each_search_selection_many

/* @prefer always */
/* @sem SearchChoice::$player_search_one_choice */
each_search_selection_one ::= player_search_one_choice "," "puts" found_one

/* @sem SearchChoice::$player_search_many_choice */
each_search_selection_many ::= player_search_many_choice "," "puts" found_many

/* Search for one name per member of a controlled battlefield population.
   The target is introduced once and is both library owner and controller. */
/* @sem ObjectFilter::AllOf([Tapped, $adjective_nontype]) */
named_search_tapped_population ::= "tapped" adjective_nontype "permanent"

named_search_target ::= target_opponent | target_player

/* @sem Operation::Search{searcher:AbilityController, library_owner:$named_search_target, choices:[_{filter:Any, count:AnyNumber, constraints:[NamedAfterOneEach(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($named_search_tapped_population, ObjectFilter::ControlledBy(One($named_search_target)))})]}]} */
search_named_population ::= "for" "each" named_search_tapped_population named_search_target "controls" "," "search" "that" "player's" "library" "for" "a" "card" "with" "the" "same" "name" "as" "that" "permanent"

/* @sem Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:$named_search_arrival}, qualifiers:[]} */
move_named_search_cards ::= "put" "those" "cards" named_search_arrival "under" "your" "control"

named_search_arrival ::= search_option_normal | search_option_tapped

/* @sem Instruction::[Effect{result:@mark, operation:$search_named_population}, Effect{result:@next, operation:$move_named_search_cards}, Effect{result:@next, operation:Shuffle{players:One(Target{slot:@last_slot, index:0})}}] */
clause_search_named_population ::= search_named_population "." move_named_search_cards "," "then" "that" "player" "shuffles"

/* The observed hand, single selection and exile establish the card tested by
   the following property predicate; the property and branch remain operands. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($target_opponent)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@prior), zone:Hand}, filter:@and($card_filter, ObjectFilter::OwnedBy(One(Target{slot:@last_slot, index:0})))}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:$hand_exile_property_test}, then:Program{instructions:$clause}, otherwise:Program{}}] */
instructions_observed_hand_exile_property ::= target_opponent "reveals" "their" "hand" "." "you" "choose" "a" card_filter "card" "from" "it" "." "exile" "that" "card" "." "if" hand_exile_property_test "," clause

/* @sem ObjectFilter::Property{property:$stat, test:NumberTest::Compare{comparison:$bound, value:$number}} */
hand_exile_property_test ::= "the" "card's" stat "is" number "or" bound

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_observed_hand_exile_property}} */
spell_observed_hand_exile_property ::= instructions_observed_hand_exile_property "."

/* The optional look and the following permission refer to the same top card. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:LookAt{player:AbilityController, objects:$single_library_top}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:$single_library_top, filter:$optional_look_spell_filter}, count:Exactly(Constant(1)), terms:_{cost:Free}}}]}}]}, otherwise:Program{}}] */
instructions_optional_look_top_free_cast ::= "you" "may" "look" "at" single_library_top "." "you" "may" "cast" "it" "without" "paying" "its" "mana" "cost" "if" "it's" optional_look_spell_filter "spell"

optional_look_spell_filter ::= next_hand_spell_filter | optional_look_artifact_or_sorcery

/* @sem ObjectFilter::AnyOf([$noun_artifact, $spell_sorcery]) */
optional_look_artifact_or_sorcery ::= "an" noun_artifact "or" spell_sorcery

/* This continuation is scoped to a preceding roll and its first consumer. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:$search_filter_many, count:UpTo(DieResultAt{result:@back(3), index:1})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
search_other_die_result ::= "search" "your" "library" "for" "a" "number" "of" search_filter_many "equal" "to" "the" "other" "result" "," "put" "them" search_option_entry "," "then" "shuffle"

/* The owner chooses which end of their library receives the object. */
/* owner_library_end_choice is shared as owner_library_choice_destination. */

shuffle_owned_population ::= plural_permanent | plural_creature | plural_artifact | plural_enchantment | plural_land | plural_planeswalker | plural_token

/* Keep the movement receipt attached to the reveal that counts it. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and( $shuffle_owned_population, ObjectFilter::OwnedBy(One(AbilityController)))}, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:CountObjects(Transition{result:@prior, phase:Before}), from:Top}}}] */
shuffle_owned_reveal_count ::= "shuffle" "all" shuffle_owned_population "you" "own" "into" "your" "library" "," "then" "reveal" "that" "many" "cards" "from" "the" "top" "of" "your" "library"

/* Both departures and the remainder are bound to the same observation. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:AllOf([$subtype_negated, AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)])])}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Matching{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, filter:$filter_phrase}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(3), phase:Before}, Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
put_revealed_pair_and_rest ::= "put" "all" subtype_negated "permanent" "cards" "revealed" "this" "way" "onto" "the" "battlefield" "," "then" "do" "the" "same" "for" filter_phrase "cards" "," "then" "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Instruction::[...$shuffle_owned_reveal_count, ...$put_revealed_pair_and_rest] */
shuffle_owned_reveal_partition ::= shuffle_owned_reveal_count "." put_revealed_pair_and_rest

/* The selection is tied to this controller's mill and its arrival receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase}, count:UpTo(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_mill_choose_one_to_hand ::= "mill" card_count "." "put" "up" "to" "one" filter_phrase "card" "milled" "this" "way" "into" "your" "hand"

/* The look permission is tied to the actual face-down exile arrival. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(EventSubject)}, kind:Card, filter:Any}, count:Constant(1), from:$ordered_end}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:One(Result{result:@prior, phase:After, index:0}), audience:AffectedPlayer})], duration:WhileExiled(Result{result:@prior, phase:After, index:0}), evaluation:LiveObjects}}]} */
program_hidden_event_player_card ::= "exile" "the" ordered_end "card" "of" "that" "player's" "library" "face" "down" "." "you" "may" "look" "at" "it" "for" "as" "long" "as" "it" "remains" "exiled" "."

/* A search bounded by attackers retains its selection through the plural action. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_attacking_where]}}, Effect{result:@next, operation:$found_those_action}, ...$search_follow] */
clause_search_attacking_where ::= "search" "your" "library" "for" search_choice_attacking_where "," found_those_action search_follow

/* @sem SearchChoice::SearchChoice{filter:$search_filter_many, count:UpTo($value_attacking_you)} */
search_choice_attacking_where ::= "up" "to" "X" search_filter_many "," "where" "X" "is" value_attacking_you

/* The exile-until producer and the cast continuation share its actual arrival receipt. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:RevealUntil{library:Bound(0), filter:$adjective_nontype, count:$counter_amount}}, Effect{result:@mark, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Transition{result:@marked, phase:After}, filter:$adjective_nontype_2}, count:AnyNumber, cost:Free}}]}}] */
instructions_players_exile_until_cast_any ::= players_singular "exiles" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "exile" counter_amount adjective_nontype "card" "." "you" "may" "cast" "any" "number" "of" "spells" "from" "among" "the" adjective_nontype "cards" "exiled" "this" "way" "without" "paying" "their" "mana" "costs"

/* The observer also separates the observed library cards.  The following
   choice composes with a separately expressed remainder destination. */
/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:$player_ref, objects:$your_top}}, Effect{result:@next, operation:Piles{actor:One($player_ref), objects:InZone{objects:Observed(@marked), zone:Library}, count:Constant(2), names:['face up', 'face down']}}] */
player_look_separate_face_piles ::= player_ref "looks" "at" your_top "and" "separates" "them" "into" "a" "face-down" "pile" "and" "a" "face-up" "pile"

/* @sem Instruction::[Effect{result:@next, operation:ChoosePile{actor:One(AbilityController), then:OwnersHand}}, Effect{result:@next, operation:$face_pile_other_remainder}] */
choose_face_pile_then_remainder ::= "put" "one" "pile" "into" "your" "hand" "and" face_pile_other_remainder

/* @sem Operation::Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]} */
face_pile_other_remainder ::= "the" "other" "into" "your" "graveyard"

/* @sem Instruction::[...$player_look_separate_face_piles, ...$choose_face_pile_then_remainder] */
instructions_player_face_piles ::= player_look_separate_face_piles "." choose_face_pile_then_remainder

/* One observed planar pair is placed at specified deck ends. The producer and
   both moves stay together so the remainder always refers to this observation. */
/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:PlanarDeck, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(2), from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:PlanarDeck}, count:Exactly(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersPlanarDeck{end:$planar_first_end, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:PlanarDeck}, destination:OwnersPlanarDeck{end:$planar_other_end, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
planar_look_split ::= "look" "at" "the" "top" "two" "cards" "of" "your" "planar" "deck" "," "put" "one" "on" planar_first_end "of" "your" "planar" "deck" "and" "the" "other" "on" planar_other_end

/* @sem SequenceEnd::Bottom */
planar_first_bottom ::= "the" "bottom"

/* @sem SequenceEnd::Top */
planar_first_top ::= "the" "top"

planar_first_end ::= planar_first_bottom | planar_first_top

planar_other_end ::= ordered_top | ordered_bottom

/* The opponent partitions the search selection. Keep both moves tied to that
   choice even though the first move intervenes before the remainder. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_distinct_partition_choice]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:ChooseObjects{player:OneOf(OpponentsOf(AbilityController)), objects:Selected(@marked), count:AsManyAsCan($count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersGraveyard(CardArrival{}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Unselected(@back(3)), destination:Battlefield{controller:Player(AbilityController), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_search_reveal_opponent_partition ::= "search" "your" "library" "for" search_distinct_partition_choice "and" "reveal" "them" "." "an" "opponent" "chooses" count "of" "those" "cards" "." "put" "the" "chosen" "cards" "into" "your" "graveyard" "and" "the" "rest" search_option_entry "," "then" "shuffle"

/* @sem SearchChoice::SearchChoice{filter:$search_filter_many, count:UpTo($count), constraints:[DifferentNames]} */
search_distinct_partition_choice ::= "up" "to" count search_filter_many "with" "different" "names"

/* The payment and the search are scoped together: the comparison below reads
   the input of this one-artifact sacrifice and this search's selection. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Artifact)}, choose:Exactly(Constant(1))}]}, optional:false}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@mark, operation:$paid_singular_search}, $sacrificed_artifact_search_value_branch, $paid_search_shuffle]}, otherwise:Program{}}]}} */
spell_sacrificed_artifact_search_value ::= "sacrifice" "an" "artifact" "." "if" "you" "do" "," paid_singular_search "." sacrificed_artifact_search_value_branch "." paid_search_shuffle "."

/* Compare the found card with the paid artifact, then offer the difference. */
/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Selected(@marked), filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:ObjectProperty{object:Query{objects:CostObjects{payment:Resolution(@prior), component:[0], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[ManaWithX{mana:[X], x:Subtract(Earlier{what:Found, measure:Of(ManaValue)}, ObjectProperty{object:Query{objects:CostObjects{payment:Resolution(@back(4)), component:[0], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown})}]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]}} */
sacrificed_artifact_search_value_branch ::= "if" "that" "card's" "mana" "value" "is" "less" "than" "or" "equal" "to" "the" "sacrificed" "artifact's" "mana" "value" "," "put" "it" "onto" "the" "battlefield" "." "if" "it's" "greater" "," "you" "may" "pay" "{" "X" "}" "," "where" "X" "is" "the" "difference" "." "if" "you" "do" "," "put" "it" "onto" "the" "battlefield" "." "if" "you" "don't" "," "put" "it" "into" "its" "owner's" "graveyard"

/* A singular search selection for receipt-bound continuations. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_filtered]} */
paid_singular_search ::= "search" "your" "library" "for" search_choice_filtered

/* @sem Instruction::Effect{result:@next, operation:Shuffle{players:One(AbilityController)}} */
paid_search_shuffle ::= "then" "shuffle"

/* The optional entry and the subsequent shuffle retain their separate results. */
/* @sem Instruction::[...$until_optional_entry, $paid_search_shuffle] */
reveal_until_optional_entry_shuffle ::= until_optional_entry "." paid_search_shuffle

/* The loop consumes only the immediately preceding exile move, including its destination. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:$exile_permanent_population_action}, ForEachObject{objects:Transition{result:@marked, phase:After}, binding:0, body:Program{instructions:$exiled_controller_shared_type_reveal}}]}} */
spell_exile_each_controller_reveal ::= exile_permanent_population_action "." "for" "each" "permanent" "exiled" "this" "way" "," exiled_controller_shared_type_reveal "."

/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:ControllerOf(Bound(0)), filter:Shares{property:CardTypes, with:Bound(0)}, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:Shares{property:CardTypes, with:Bound(0)}}, destination:Battlefield{controller:Player(ControllerOf(Bound(0))), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf(Bound(0)))}}] */
exiled_controller_shared_type_reveal ::= "its" "controller" "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" "a" "card" "that" "shares" "a" "card" "type" "with" "it" "," "puts" "that" "card" "onto" "the" "battlefield" "," "then" "shuffles"

/* The controller, revealed card, destination and shuffle share one bound object. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:RevealUntil{library:ControllerOf(Bound(0)), filter:$filter_phrase, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$filter_phrase}, destination:Battlefield{controller:Player(ControllerOf(Bound(0))), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf(Bound(0)))}}]} */
bound_controller_reveal_card_battlefield_shuffle ::= "its" "controller" "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" ("a" | "an") filter_phrase "card" "," "puts" "that" "card" "onto" "the" "battlefield" "," "then" "shuffles" "the" "rest" "into" "their" "library"

/* The demonstrative is tied to the target filter and the exile arrival receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:$plural_target_count, filter:@agree($filter_plural, $filter_plural_2)})), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, ForEachObject{objects:Transition{result:@marked, phase:After}, binding:0, body:$bound_controller_reveal_card_battlefield_shuffle}] */
instructions_exile_targets_each_controller_reveal ::= "exile" plural_target_count "target" filter_plural "." "for" "each" "of" "those" filter_plural "," bound_controller_reveal_card_battlefield_shuffle

/* One singular player loses life and exiles from that same player's library. */
/* @sem Instruction::[Effect{result:@next, operation:LoseLife{players:One($player_ref), amount:$life_amount}}, Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}] */
clause_shared_life_exile_top ::= player_ref "loses" life_amount "and" "exiles" "the" "top" "card" "of" "their" "library"

/* A required selection into its owner's hand, followed by a library remainder.
   The later miss test refers to that particular move, not the reorder. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$a_card}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
dig_required_observed_hand ::= "put" a_card "from" "among" "them" "into" "your" "hand"

/* @sem Instruction::Effect{result:@next, operation:$rest_bottom} */
dig_required_hand_remainder ::= "and" rest_bottom

/* @sem Instruction::If{condition:Not(ObjectMatches{object:Result{result:@back(2), phase:After, index:0}, filter:Any}), then:Program{instructions:$conjoined}, otherwise:Program{}} */
dig_required_hand_miss ::= "if" "you" "didn't" "put" "a" "card" "into" "your" "hand" "this" "way" "," conjoined

/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$dig_required_observed_hand, $dig_required_hand_remainder] */
dig_reveal_required_hand_partition ::= reveal_top "." dig_required_observed_hand dig_required_hand_remainder

/* @sem Instruction::[...$dig_reveal_required_hand_partition, $dig_required_hand_miss] */
dig_reveal_required_hand_miss ::= dig_reveal_required_hand_partition "." dig_required_hand_miss

/* The immediate battlefield entry supplies the incarnation used by both continuations. */
/* @sem Instruction::[...$observed_top_reveal_battlefield, ...$entered_creature_timed_grant_sacrifice] */
observed_top_entry_grant_sacrifice ::= observed_top_reveal_battlefield "." entered_creature_timed_grant_sacrifice

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Observed(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
observed_top_reveal_battlefield ::= "put" "it" "onto" "the" "battlefield"

/* Scope the look, sacrifice payment, its mana-value query and both reorder
   branches together, so the inverse cannot attach the receipt to another cost. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$look_top_spelled_count}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:Exactly(Constant(1))}]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(3)), zone:Library}, filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:Add($number_digits, ObjectProperty{object:Query{objects:CostObjects{payment:Resolution(1), component:[0], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown})}}])}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(5)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}]}, otherwise:_{instructions:[Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@back(6)), zone:Library}, end:Bottom, order:$library_order}}]}}]} */
look_sacrifice_mana_value_entry ::= look_top_spelled_count "." "then" "you" "may" "sacrifice" "a" "creature" "." "if" "you" "do" "," "you" "may" "put" "a" card_filter "card" "with" "mana" "value" "X" "or" "less" "from" "among" "those" "cards" "onto" "the" "battlefield" "," "where" "X" "is" number_digits "plus" "the" "sacrificed" "creature's" "mana" "value" "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order "."

/* The partition and its damage consumer share the reveal observation. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$own_reveal_partition_program, Effect{result:@next, operation:$reveal_partition_source_damage}]}} */
spell_reveal_partition_source_damage ::= own_reveal_partition_program "." reveal_partition_source_damage "."

/* @sem Operation::DealDamage{source:Source, recipients:Players(One(AbilityController)), amount:CountObjects(Observed(@back(4))), preventable:true} */
reveal_partition_source_damage ::= SELF_NAME "deals" "damage" "to" "you" "equal" "to" "the" "number" "of" "cards" "revealed" "this" "way"

/* Keep the sacrificed population and its counted reveal together so the
   inverse cannot attach this wording to a different transition producer. */
/* @sem Instruction::[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:@agree($filter_plural, $filter_plural_2)}, choose:AsManyAsCan($number)})}, Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$filter_phrase, count:CountObjects(Transition{result:@prior, phase:Before})}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$filter_phrase}, destination:$until_destination, qualifiers:[]}}, Effect{result:@next, operation:$rest_bottom}] */
sacrifice_count_reveal_partition ::= "sacrifice" number filter_plural "," "then" reveal_until_your_library "a" "number" "of" filter_phrase "cards" "equal" "to" "the" "number" "of" filter_plural "sacrificed" "this" "way" "." "put" "those" "cards" until_destination "and" rest_bottom

/* Keep the revealed partition together before an independent following instruction. */
/* @sem Instruction::[...$instructions_reveal_until, ...$instructions] */
reveal_until_then_instructions ::= instructions_reveal_until "." instructions

/* The selected cards leave the observed target library; its remainder stays on top. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($value), constraints:[CanMoveTo{destination:OwnersGraveyard(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:Target{slot:@last_slot, index:0}, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Top, order:Chosen}}] */
observed_target_library_to_graveyard ::= "put" value "of" "them" "into" "their" "graveyard"

/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One($possessive_target_player)}, kind:Card, filter:Any}, count:$top_count, from:Top}}}, ...$observed_target_library_to_graveyard] */
target_player_look_graveyard ::= "look" "at" "the" "top" top_count "of" possessive_target_player "library" "." observed_target_library_to_graveyard

/* The selected cards move to their owners' graveyards; the rest stays in the
   same targeted library, excluding the actual move's before receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($value), constraints:[CanMoveTo{destination:OwnersGraveyard(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:Target{slot:@last_slot, index:0}, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Top, order:Chosen}}] */
foreign_observed_graveyard_split ::= "put" value "of" "those" "cards" "into" "that" "player's" "graveyard" "and" "the" "rest" "on" "top" "of" "their" "library" "in" "any" "order"

/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One($target_possessive)}, kind:Card, filter:Any}, count:$top_count, from:Top}}}, ...$foreign_observed_graveyard_split] */
foreign_look_graveyard_partition ::= "look" "at" "the" "top" top_count "of" target_possessive "library" "." foreign_observed_graveyard_split

/* This producer fixes the hand destination before the receipt is tested. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($look_hand_count), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:$dig_hand_rest}, If{condition:Compare{left:CountObjects(Matching{objects:Union([Transition{result:@back(2), phase:Before}]), filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:$program, otherwise:_{}}] */
dig_reveal_hand_graveyard_if ::= reveal_top "." "put" look_hand_count "into" "your" "hand" "and" dig_hand_rest "." "if" "you" "put" "an" filter_phrase "card" "into" "your" "hand" "this" "way" "," program

dig_hand_rest ::= hand_other_graveyard | rest_graveyard

/* @prefer always */
/* @sem Operation::Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(2), phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]} */
hand_other_graveyard ::= "the" "other" "into" "your" "graveyard"

/* The activation's third cost is the matching eyeball-counter payment. */
/* @sem Operation::LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:PaidCountersRemoved{payment:Activation, component:[2]}, from:Top}} */
look_paid_eyeball_counters ::= "look" "at" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" "the" "number" "of" "eyeball" "counters" "removed" "this" "way"

/* Reuse the observed-card hand partition within the scoped payment ability. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, TapSymbol, $cost_all_eyeball_counters]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:$look_paid_eyeball_counters}, ...$look_put_split]}} */
activation_look_paid_eyeball ::= cost_mana "," "{T}" "," "↑" cost_all_eyeball_counters ":" look_paid_eyeball_counters "." look_put_split "."

/* The defined look and its take share the observed library population. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top_defined_life}, ...$observed_take_hand_shuffle] */
look_defined_take_shuffle ::= look_top_defined_life "." observed_take_hand_shuffle

/* @sem Operation::LookAt{player:AbilityController, objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$life_paid_with_source, from:Top}} */
look_top_defined_life ::= "look" "at" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" life_paid_with_source

/* @sem Expr::Game(LifePaid) */
life_paid_with_source ::= "the" "amount" "of" "life" "paid" "with" SELF_NAME

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($value), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
observed_take_hand_shuffle ::= "put" value "of" "them" "into" "your" "hand" "," "then" "shuffle"

shuffle_choice_zone ::= shuffle_choice_hand | your_graveyard

/* @prefer always */
/* @sem $your_hand */
shuffle_choice_hand ::= your_hand

/* @prefer always */
/* @sem $clause_shuffle_hand_choice */
shuffle_choice_before_then ::= clause_shuffle_hand_choice

/* @prefer always */
/* @sem $clause_shuffle_hand_choice */
clause_you_shuffle_choice ::= "you" clause_shuffle_hand_choice

/* Keep the seek producer in scope for both references to its hand arrival. */
/* @sem Instruction::[...$clause_seek_card, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Duplicate(One(Result{result:@back(3), phase:After, index:0})), count:$count_plural, destination:Graveyard(CardArrival{counters:[], states:[]})}}] */
clause_seek_put_duplicate ::= clause_seek_card "and" "put" "it" "into" "your" "graveyard" "," "then" "conjure" count_plural "duplicates" "of" "it" "into" "your" "graveyard"

/* @sem SearchChoice::SearchChoice{filter:$card_filter, count:UpTo($count), constraints:[DifferentNames]} */
search_choice_different_names ::= "up" "to" count card_filter "cards" "that" "have" "different" "names"

/* A revealed library slice and a required selection from that same slice. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$look_choose_them_hand] */
reveal_selected_hand ::= reveal_top "." look_choose_them_hand

/* The remaining stages retain the initial observation, the chosen opponent and
   each preceding selection's actual move or reorder receipt. */
/* @prefer always */
/* @sem Instruction::[...$reveal_fixed_partition_start, ...$observed_choose_opponent, ...$observed_opponent_first_bottom, ...$observed_controller_second_hand, ...$observed_opponent_second_bottom, $observed_final_hand] */
reveal_alternating_partition ::= reveal_fixed_partition_start "." observed_choose_opponent "." observed_opponent_first_bottom "." observed_controller_second_hand "." observed_opponent_second_bottom "." observed_final_hand

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:Chosen, objects:InZone{objects:Difference{objects:Observed(@back(5)), excluding:Union([Transition{result:@back(3), phase:Before}])}, zone:Library}, count:AsManyAsCan($n1)}}, Effect{result:@next, operation:ReorderLibrary{chooser:Chosen, library_owner:AbilityController, objects:Selected(@prior), end:Bottom, order:Chosen}}] */
observed_opponent_first_bottom ::= "they" "put" n1 "on" "the" "bottom" "of" "your" "library"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(7)), excluding:Union([Transition{result:@back(5), phase:Before}, Transition{result:@prior, phase:Before}])}, zone:Library}, count:AsManyAsCan($n1), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
observed_controller_second_hand ::= "then" "you" "put" n1 "into" "your" "hand"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:Chosen, objects:InZone{objects:Difference{objects:Observed(@back(9)), excluding:Union([Transition{result:@back(7), phase:Before}, Transition{result:@back(4), phase:Before}, Transition{result:@prior, phase:Before}])}, zone:Library}, count:AsManyAsCan($n1)}}, Effect{result:@next, operation:ReorderLibrary{chooser:Chosen, library_owner:AbilityController, objects:Selected(@prior), end:Bottom, order:Chosen}}] */
observed_opponent_second_bottom ::= "then" "they" "put" n1 "on" "the" "bottom" "of" "your" "library"

/* @prefer always */
/* @sem Instruction::Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@back(11)), excluding:Union([Transition{result:@back(9), phase:Before}, Transition{result:@back(6), phase:Before}, Transition{result:@back(4), phase:Before}, Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}} */
observed_final_hand ::= "put" "the" "other" "into" "your" "hand"

/* @sem Instruction::[Effect{result:@next, operation:$choose_opponent}] */
observed_choose_opponent ::= "then" choose_opponent

/* Five revealed cards, four single choices: the final other is singular. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(5), from:Top}}}, ...$revealed_one_to_hand] */
reveal_fixed_partition_start ::= "reveal" "the" "top" "five" "cards" "of" "your" "library" "." revealed_one_to_hand

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
revealed_one_to_hand ::= "put" "one" "of" "them" "into" "your" "hand"

/* The plural remainder allows different initial slice and selection counts. */
/* @sem Instruction::[...$reveal_selected_hand, ...$observed_choose_opponent, ...$observed_opponent_first_bottom, ...$observed_controller_second_hand, ...$observed_opponent_second_bottom, $observed_rest_hand] */
reveal_alternating_rest_partition ::= reveal_selected_hand "." observed_choose_opponent "." observed_opponent_first_bottom "." observed_controller_second_hand "." observed_opponent_second_bottom "." observed_rest_hand

/* @sem Instruction::Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@back(11)), excluding:Union([Transition{result:@back(9), phase:Before}, Transition{result:@back(6), phase:Before}, Transition{result:@back(4), phase:Before}, Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}} */
observed_rest_hand ::= "put" "the" "rest" "into" "your" "hand"

/* The count is read from the immediately preceding counter removal.  Keep
   the producer in the enclosing clause to constrain the inverse as well. */
/* @sem Instruction::[Effect{result:@next, operation:$remove_counted_counters}, ...$removed_counters_look_hand] */
clause_remove_counters_look_hand ::= remove_counted_counters "." removed_counters_look_hand

/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:CountersRemoved(@prior), from:Top}}}, ...$look_put_split] */
removed_counters_look_hand ::= "look" "at" "that" "many" "cards" "from" "the" "top" "of" "your" "library" "." look_put_split

/* The abbreviated top refers to the library shuffled immediately before it. */
/* @sem Instruction::[Effect{result:@next, operation:$shuffle_your_library}, Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$card_count, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
shuffle_then_exile_top ::= shuffle_your_library "," "then" "exile" "the" "top" card_count

/* The casting permission consumes the immediately preceding exile arrival. */
/* @sem Instruction::[...$shuffle_then_exile_top, Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Transition{result:@prior, phase:After}, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}}, count:AnyNumber, cost:Free}}] */
shuffle_exile_cast_bounded ::= shuffle_then_exile_top "." "you" "may" "cast" "any" "number" "of" "spells" "with" "mana" "value" value "or" "less" "from" "among" "them" "without" "paying" "their" "mana" "costs"

/* Each player's two selections are distinct, and the remainder excludes the
   cards actually moved from that player's observation. */
/* @sem Instruction::[ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:LookAt{player:Bound(0), objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}), count:$card_count, from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:$filter_phrase}, count:UpTo($counter_amount), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Matching{objects:Difference{objects:InZone{objects:Observed(0), zone:Library}, excluding:Union([Selected(@prior)])}, filter:$filter_phrase_2}, count:UpTo($counter_amount_2), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Reveal{objects:Union([Selected(1), Selected(@prior)])}}, Effect{result:@next, operation:Move{objects:Union([Selected(1), Selected(2)]), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:Bound(0), library_owner:Bound(0), objects:InZone{objects:Difference{objects:Observed(0), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}]}}] */
each_player_look_two_choices ::= "each" "player" "looks" "at" "the" "top" card_count "of" "their" "library" "and" "may" "reveal" counter_amount filter_phrase "card" "and" "/" "or" counter_amount filter_phrase "card" "from" "among" "them" "." "each" "player" "puts" "the" "cards" "they" "revealed" "this" "way" "into" "their" "hand" "and" "the" "rest" "on" "the" "bottom" "of" "their" "library" library_order

/* @sem Instruction::[...$each_player_look_two_choices, ...$instructions] */
each_player_look_two_choices_more ::= each_player_look_two_choices "." instructions

/* The one-card reveal, non-moving copy effect and optional bottom move share
   the same library top. The bounded branch cannot move the revealed card. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}, If{condition:ObjectMatches{object:Query{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), index:0}, filter:$revealed_top_card_kind}, then:Program{instructions:$revealed_top_copy_branch}, otherwise:Program{}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
instructions_revealed_top_copy_bottom ::= "reveal" "the" "top" "card" "of" "your" "library" "." "if" revealed_top_card_kind "card" "is" "revealed" "this" "way" "," revealed_top_copy_branch "." "you" "may" "put" "that" "card" "on" "the" "bottom" "of" "your" "library"

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects($affected), changes:[CopyOf{object:Earlier{what:Revealed}, exceptions:[]}], duration:$duration, evaluation:Snapshot}}]}}] */
revealed_top_copy_branch ::= "you" "may" "have" affected "become" "copies" "of" "that" "card" duration

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$instructions_revealed_top_copy_bottom}} */
trigger_revealed_top_copy_bottom ::= "at" turn_event "," instructions_revealed_top_copy_bottom "."

revealed_top_card_kind ::= revealed_top_card_kind_a | aura_target_artifact

/* @sem $revealed_top_consonant_kind */
revealed_top_card_kind_a ::= "a" revealed_top_consonant_kind

revealed_top_consonant_kind ::= noun_creature | noun_land | noun_planeswalker | noun_battle | spell_sorcery

/* Keep the single face-down exile and its visibility and play permission together. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_possessive)}, kind:Card, filter:Any}, count:Constant(1), from:$ordered_end}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:One(Result{result:@marked, phase:After, index:0}), audience:AffectedPlayer}), PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:$exiled_play_action, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}] */
instructions_hidden_single_look_play ::= "exile" "the" ordered_end "card" "of" player_possessive "library" "face" "down" "." "you" "may" "look" "at" "and" exiled_play_action "that" "card" this_duration

/* The observation and its immediately moved card stay in the same process. */
/* @sem Instruction::[...$reveal_top_hand_that, ...$observed_card_value_life] */
reveal_hand_card_value_life ::= reveal_top_hand_that "." observed_card_value_life

observed_card_value_life ::= observed_card_value_loss | observed_card_value_gain

/* @sem Instruction::[Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:ObjectProperty{object:Query{objects:Observed(0), index:0}, property:$stat, information:CurrentOrLastKnown}}}] */
observed_card_value_loss ::= "you" "lose" "life" "equal" "to" "its" stat

/* @sem Instruction::[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:ObjectProperty{object:Query{objects:Observed(0), index:0}, property:$stat, information:CurrentOrLastKnown}}}] */
observed_card_value_gain ::= "you" "gain" "life" "equal" "to" "its" stat

/* The optional repeat belongs to the entire producer-consumer process. */
/* @sem Instruction::[Repeatable{instructions:[...$reveal_hand_card_value_life, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}}]}] */
instructions_repeat_revealed_hand_value ::= reveal_hand_card_value_life "." "you" "may" "repeat" "this" "process" "any" "number" "of" "times"

/* A single observation supplies both the type-limited selection and the remaining cards. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:InZone{objects:Observed(@marked), zone:Library}, count:AnyNumber, constraints:[OneForEachCardType(AmongCasts{by:One(AbilityController), filter:$adjective_nontype, window:ThisTurn})]}], action:Move{objects:Prepared(@selection_id(0)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:Random}}] */
reveal_cast_types_partition ::= reveal_top "." "for" "each" "card" "type" "among" adjective_nontype "spells" "you've" "cast" "this" "turn" "," "you" "may" "put" "a" "card" "of" "that" "type" "from" "among" "the" "revealed" "cards" "into" "your" "hand" "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* A plural search with its player-count definition closes before its found cards move. */
/* @sem SearchChoice::SearchChoice{filter:$search_filter_many, count:UpTo($value_players_control_margin)} */
search_choice_player_margin ::= "up" "to" "X" search_filter_many "," "where" "X" "is" value_players_control_margin

/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_player_margin]}}, Effect{result:@next, operation:$found_those_action}, ...$search_follow] */
clause_search_player_margin_split ::= "search" "your" "library" "for" search_choice_player_margin "." found_those_action search_follow

/* The revealed singleton is tested against the previously chosen creature type. */
/* @sem ObjectFilter::AllOf([$card_filter, Chosen(CreatureType)]) */
top_reveal_chosen_creature_kind ::= "a" card_filter "card" "of" "the" "chosen" "type"

/* Both branches consume this exact one-card observation. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:Expr::Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}, then:Program{instructions:$observed_top_reveal_branch}, otherwise:Program{instructions:$observed_top_reveal_branch_2}}] */
instructions_top_reveal_that_card_otherwise ::= "reveal" "the" "top" "card" "of" "your" "library" "." "if" "that" "card" "is" top_reveal_quality "," observed_top_reveal_branch "." "otherwise" "," observed_top_reveal_branch

/* @sem ObjectFilter::AllOf([$card_filter, Chosen(CreatureType)]) */
top_reveal_chosen_creature_kind_vowel ::= "an" card_filter "card" "of" "the" "chosen" "type"

/* An independent otherwise program retains its own references. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:Expr::Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}, then:Program{instructions:$observed_top_reveal_branch}, otherwise:$program}] */
instructions_top_reveal_that_card_otherwise_program ::= "reveal" "the" "top" "card" "of" "your" "library" "." "if" "that" "card" "is" top_reveal_quality "," observed_top_reveal_branch "." "otherwise" "," program

/* The singular after-result and its test belong to this particular bottom-card move. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($target_player)}, kind:Card, filter:Any}, count:Constant(1), from:Bottom}, destination:OwnersGraveyard(CardArrival{}), qualifiers:[]}}, If{condition:ObjectMatches{object:Result{result:@last_result, phase:After, index:0}, filter:$noun}, then:Program{instructions:$clause_you}, otherwise:Program{}}] */
bottom_card_conditional ::= target_player "puts" "the" "bottom" "card" "of" "their" "library" "into" "their" "graveyard" "." "if" "it's" "a" noun "card" "," clause_you

/* The searched singleton, the chosen name, and the conditional entry share one
   receipt. Keeping the producer in this phrase also constrains inverse printing. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:EventSubject, choices:[_{filter:Any, count:AsManyAsCan(Constant(1))}]}}, Effect{result:@next, operation:ChooseValue{choosers:One(EventSubject), kind:CardName, terms:_{count:Exactly(Constant(1)), options:[Term{family:CardsInOracle, form:AnyOracleCard}]}}}, If{condition:Compare{left:CountObjects(Matching{objects:Selected(@marked), filter:AllOf([$noun, Not(Chosen(CardName))])}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:_{instructions:[Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Selected(@marked), count:AnyNumber, constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}}]}, otherwise:_{}}, Effect{result:@next, operation:Shuffle{players:One(EventSubject)}}]} */
search_chosen_name_conditional_entry ::= "search" "that" "player's" "library" "for" "a" "card" "," "then" "that" "player" "chooses" "a" "card" "name" "." "if" "you" "searched" "for" ("a" | "an") noun "card" "that" "doesn't" "have" "that" "name" "," "you" "may" "put" "it" "onto" "the" "battlefield" "under" "your" "control" "." "then" "that" "player" "shuffles"

/* @sem Ability::Triggered{event:$search_chosen_name_damage_event, limits:TriggerLimits{}, announcement:@announcement, body:$search_chosen_name_conditional_entry} */
triggered_search_chosen_name_entry ::= "whenever" search_chosen_name_damage_event "," search_chosen_name_conditional_entry "."

search_chosen_name_damage_event ::= event_combat_damage_player | event_combat_damage_opponent | event_damage_player

look_reveal_card_filter ::= look_reveal_qualified_card | look_reveal_instant_sorcery_card | look_reveal_creature_or_spell_card | look_reveal_creature_card | look_reveal_land_card | look_reveal_artifact_card

/* @prefer always */
/* @sem ObjectFilter::$look_reveal_qualified_filter */
look_reveal_qualified_card ::= "a" look_reveal_qualified_filter

/* @sem ObjectFilter::$filter_instant_or_sorcery */
look_reveal_instant_sorcery_card ::= "an" filter_instant_or_sorcery "card"

/* @sem ObjectFilter::AnyOf([$noun_creature, $spell_sorcery]) */
look_reveal_creature_or_spell_card ::= "a" noun_creature "or" spell_sorcery "card"

/* @sem ObjectFilter::$noun_creature */
look_reveal_creature_card ::= "a" noun_creature "card"

/* @sem ObjectFilter::$noun_land */
look_reveal_land_card ::= "a" noun_land "card"

/* @sem ObjectFilter::$noun_artifact */
look_reveal_artifact_card ::= "an" noun_artifact "card"

/* The observation, the immediate move, and its damage consumer share one
   top-card query; the reflexive recipient is the named damage source. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:DealDamage{source:$self_ref_named, recipients:Objects(One($self_ref_named)), amount:ObjectProperty{object:Query{objects:Observed(@marked), index:0}, property:ManaValue, information:CurrentOrLastKnown}, preventable:true}}] */
reveal_top_hand_reflexive_damage ::= "reveal" "the" "top" "card" "of" "your" "library" "and" "put" "it" "into" "your" "hand" "." self_ref_named "deals" "damage" "to" "himself" "equal" "to" "that" "card's" "mana" "value"

/* The selected damage recipient is announced before the mill; the maximum
   measures exactly that mill's arrival receipt. */
/* @sem Vec<Instruction>::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any})), amount:Aggregate{objects:Transition{result:@marked, phase:After}, property:ManaValue, aggregation:Maximum}, preventable:true}}] */
choose_target_mill_max_damage ::= "choose" "any" "target" "," "then" "mill" card_count "." self_explicit_ref "deals" "damage" "to" "that" "permanent" "or" "player" "equal" "to" "the" "greatest" "mana" "value" "among" "the" "milled" "cards"

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:$choose_target_mill_max_damage}} */
activated_choose_target_mill_max_damage ::= cost ":" choose_target_mill_max_damage "."

/* Both the test and its inverse are tied to the event player's mill. */
/* @sem Vec<Instruction>::[Effect{result:@mark, operation:Mill{players:One(EventSubject), amount:CountObjects(Damage(Source))}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$clause}, otherwise:Program{}}] */
event_player_damage_mill_test ::= "that" "player" "mills" "a" "card" "for" "each" "1" "damage" "dealt" "to" "them" "." "if" "the" "player" "mills" "at" "least" "one" filter_phrase "card" "this" "way" "," clause

/* @sem Ability::Triggered{event:$event_group_combat_damage_to_player, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$event_player_damage_mill_test}} */
triggered_group_damage_mill_test ::= "whenever" event_group_combat_damage_to_player "," event_player_damage_mill_test "."

/* The reveal, selection and both destinations form one scoped receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(2), from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@prior), zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_reveal_two_hand_other ::= "reveal" "the" "top" "two" "cards" "of" "your" "library" "." "put" "one" "of" "them" "into" "your" "hand" "and" "the" "other" "into" "your" "graveyard"

/* The selected pile and remainder both derive from the same reveal. */
/* @sem Instruction::[Effect{result:@next, operation:$reveal_top}, Effect{result:@next, operation:SeparatePiles{separator:AbilityController, chooser:OneOf(OpponentsOf(AbilityController)), objects:InZone{objects:Observed(@prior), zone:Library}}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_reveal_pile_hand_other ::= reveal_top "and" "separate" "them" "into" "two" "piles" "." "an" "opponent" "chooses" "one" "of" "those" "piles" "." "put" "that" "pile" "into" "your" "hand" "and" "the" "other" "into" "your" "graveyard"

/* The plus operand remains part of the revealed library slice. */
/* @sem Expr::Add([AnnouncedX, $number]) */
top_x_plus ::= "X" "plus" number "cards"

/* Both actions name the same target's owner. */
/* @sem Instruction::[Effect{result:@next, operation:$owner_shuffles_target}, Effect{result:@next, operation:Draw{players:One(OwnerOf(Target{slot:@last_slot, index:0})), amount:$card_count}}] */
instructions_owner_shuffle_draw ::= owner_shuffles_target "," "then" "draws" card_count

/* The conditional tests the hand move from the immediately preceding pair. */
/* @sem Instruction::[...$instructions_reveal_two_hand_other, If{condition:Compare{left:CountObjects(Matching{objects:Union([Transition{result:@back(2), phase:Before}]), filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:$number}}]}, otherwise:Program{}}] */
instructions_reveal_two_hand_other_gain ::= instructions_reveal_two_hand_other "." "if" "you" "put" "an" card_filter "card" "into" "your" "hand" "this" "way" "," "you" "gain" number "life"

/* The discover actor and measured object are tied to the shuffled target. */
/* @sem Instruction::[Effect{result:@next, operation:$owner_shuffles_target}, Effect{result:@next, operation:Keyword{actor:One(OwnerOf(Target{slot:@last_slot, index:0})), action:Discover{amount:ObjectProperty{object:Target{slot:@last_slot, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}}] */
instructions_owner_shuffle_discover ::= owner_shuffles_target "." "then" "that" "player" "discovers" "X" "," "where" "X" "is" "its" "mana" "value"

/* Search, move, shuffle, and the hand-count consumer share the same
   targeted owner and the exact exile movement receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:$target_possessive, choices:[_{filter:Chosen(CardName), count:$named_exile_token_count}], also:[Graveyard, Hand]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($target_possessive)}}, Effect{result:@next, operation:CreateTokens{players:One($target_possessive), tokens:[_{amount:CountObjects(InZone{objects:Transition{result:@marked, phase:Before}, zone:Hand}), words:CreatingEffect, recipe:$token_recipe_plain}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
named_search_exile_hand_tokens ::= "search" target_possessive "graveyard" "," "hand" "," "and" "library" "for" named_exile_token_count "cards" "with" "that" "name" "and" "exile" "them" "." "that" "player" "shuffles" "," "then" "creates" "a" token_recipe_plain "for" "each" "card" "exiled" "from" "their" "hand" "this" "way"

/* The search and shuffle are a single ordered action group. */
/* @sem Instruction::[...$clause_search_name_exile, Effect{result:@next, operation:Shuffle{players:One(@that_player)}}] */
named_search_exile_then_shuffle ::= clause_search_name_exile "." "then" "that" "player" "shuffles"

/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$choose_a_card_name}, ...$named_search_exile_hand_tokens]}} */
spell_choose_name_search_hand_tokens ::= choose_a_card_name "." named_search_exile_hand_tokens "."

/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$choose_a_card_name}, ...$instructions_revealed_hand_damage, ...$named_search_exile_then_shuffle]}} */
spell_choose_name_reveal_damage_search ::= choose_a_card_name "." instructions_revealed_hand_damage "." named_search_exile_then_shuffle "."

named_exile_token_count ::= named_exile_token_any | name_search_all | named_search_upto

/* @prefer always */
/* @sem Count::AnyNumber */
named_exile_token_any ::= "any" "number" "of"

/* A single filtered reveal from the controller's library. */
/* @sem Operation::RevealUntil{library:AbilityController, filter:$reveal_until_singular_filter, count:$counter_amount} */
reveal_until_your_filtered_card ::= reveal_until_your_library counter_amount reveal_until_singular_filter "card"

reveal_until_singular_filter ::= adjective_nontype | adjective_color

/* Keep the selected card and the remainder tied to the same reveal. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$reveal_until_singular_filter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$reveal_until_singular_filter}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
instructions_reveal_matching_hand_exile_rest ::= reveal_until_your_library "a" reveal_until_singular_filter "card" "." "put" "that" "card" "into" "your" "hand" "and" "exile" "all" "other" "cards" "revealed" "this" "way"

/* The top-card continuation is scoped to its observation and to the event
   whose spell or damage supplies the comparison. */
/* @sem CostPart::PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}}}, count:Exactly(Constant(1)), terms:_{cost:Free}}}]}} */
top_revealed_lesser_cast_payment ::= "cast" "it" "without" "paying" "its" "mana" "cost" "if" "it's" "a" "spell" "with" "lesser" "mana" "value"

/* @sem CostPart::PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:EventAmount}}}, count:Exactly(Constant(1)), terms:_{cost:Free}}}]}} */
top_damage_free_cast_payment ::= "cast" "a" "spell" "with" "mana" "value" "less" "than" "or" "equal" "to" "the" "damage" "dealt" "from" "the" "top" "of" "your" "library" "without" "paying" "its" "mana" "cost"

/* @sem Cost::Cost{parts:[Choice([Cost{parts:[PlayFromTop($filter_phrase)]}, Cost{parts:[$top_damage_free_cast_payment]}])]} */
top_damage_play_choice ::= "play" "a" filter_phrase "from" "the" "top" "of" "your" "library" "or" top_damage_free_cast_payment

/* @sem Cost::Cost{parts:[$top_revealed_lesser_cast_payment]} */
top_revealed_cast_cost ::= top_revealed_lesser_cast_payment

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$top_revealed_cast_cost, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{}}] */
revealed_top_cast_or_hand ::= "you" "may" top_revealed_cast_cost "." "if" "you" "don't" "cast" "it" "," "put" "it" "into" "your" "hand" "."

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$top_damage_play_choice, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{}}] */
looked_top_play_or_hand ::= "you" "may" top_damage_play_choice "." "if" "you" "don't" "," "put" "that" "card" "into" "your" "hand" "."

/* @sem Program::Program{instructions:[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, ...$revealed_top_cast_or_hand]} */
revealed_top_cast_program ::= "reveal" "the" "top" "card" "of" "your" "library" "." revealed_top_cast_or_hand

/* @sem Program::Program{instructions:[...$top_card_look, ...$looked_top_play_or_hand]} */
looked_top_damage_program ::= top_card_look looked_top_play_or_hand

/* This choice is confined to the same single-creature casting payment scope. */
/* @sem SearchChoice::SearchChoice{filter:AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:Add($number_digits, ObjectProperty{object:Query{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown})}}]), count:UpTo(Constant(1))} */
casting_sacrifice_capped_choice ::= "a" filter_phrase "card" "with" "mana" "value" "X" "or" "less" "," "where" "X" "is" number_digits "plus" "the" "sacrificed" "creature's" "mana" "value"

/* The selected card and the shuffle share the immediately preceding search. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$casting_sacrifice_capped_choice]}}, Effect{result:@next, operation:$scoped_found_battlefield}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
casting_sacrifice_capped_search ::= "search" "your" "library" "for" casting_sacrifice_capped_choice "." scoped_found_battlefield "," "then" "shuffle"

/* @sem Program::Program{instructions:[...$casting_sacrifice_capped_search, Effect{result:@next, operation:$operation}]} */
casting_sacrifice_capped_followup ::= casting_sacrifice_capped_search "." operation "."

casting_sacrifice_value_program ::= casting_sacrifice_value_search_program | casting_sacrifice_capped_followup

/* The named library owner is also the player who moves the observed cards.
   Keep the producer and consumer together so the anaphor cannot select a
   different player or an unrelated observation. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_until_other_many}, Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_reveal_until_owner_graveyard ::= reveal_until_other_many "." "that" "player" "puts" "all" "cards" "revealed" "this" "way" "into" "their" "graveyard"

/* Four independently described keyword predicates qualify the found card. */
/* @sem ObjectFilter::@and($card_filter, ObjectFilter::AnyOf(@unordered([$search_keyword_predicate, ...$search_keyword_list_tail]))) */
search_filter_serial_keywords ::= card_filter "card" "with" search_keyword_predicate "," search_keyword_list_tail

search_keyword_list_tail ::= search_keyword_list_pair | search_keyword_list_more
/* @sem ObjectFilter::[$search_keyword_predicate, $search_keyword_predicate_2] */
search_keyword_list_pair ::= search_keyword_predicate "," "or" search_keyword_predicate
/* @sem ObjectFilter::[$search_keyword_predicate, ...$search_keyword_list_tail] */
search_keyword_list_more ::= search_keyword_predicate "," search_keyword_list_tail

search_keyword_predicate ::= so_on_hexproof | search_keyword_plain_predicate

/* @sem ObjectFilter::HasKeyword($search_keyword_plain) */
search_keyword_plain_predicate ::= search_keyword_plain

search_keyword_plain ::= kn_islandwalk | kn_flying | kn_first_strike | kn_double_strike | kn_trample | kn_lifelink | kn_deathtouch | kn_vigilance | kn_haste | kn_reach | kn_indestructible | kn_shroud | kn_menace | kn_defender | kn_flash | kn_fear | kn_intimidate | kn_infect | kn_wither | kn_prowess | kn_flanking | kn_horsemanship | kn_shadow | kn_skulk

/* The singular search selection remains the same through the sentence break. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, ...$search_shuffle_sentence_top_that] */
search_follow_reveal_it_sentence ::= "and" "reveal" "it" search_shuffle_sentence_top_that

/* @sem Instruction::[Effect{result:@next, operation:Shuffle{players:One(AbilityController), excluding:Selected(@marked)}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@marked), end:Top, order:Chosen}}] */
search_shuffle_sentence_top_that ::= "." "shuffle" "and" "put" "that" "card" "on" "top"

/* The stopping filter, counted battlefield population and destination are independent.
   Both the move and shuffle remain scoped to this particular revelation. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:@and($filter_phrase, ObjectFilter::Chosen(CreatureType)), count:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(AbilityController)), ObjectFilter::Chosen(CreatureType))})}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:@and($filter_phrase, ObjectFilter::Chosen(CreatureType))}, destination:$until_destination, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_reveal_chosen_count_shuffle ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "X" filter_phrase "cards" "of" "the" "chosen" "type" "," "where" "X" "is" "the" "number" "of" filter_plural "you" "control" "of" "that" "type" "." "put" "those" "cards" until_destination "," "then" "shuffle" "the" "rest" "of" "the" "revealed" "cards" "into" "your" "library"

/* The chooser selects cards from their own hand and moves that selection to
   their own library; keeping both actions together proves the pronouns. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$target_player_ref, objects:Zone{scope:Players{zone:Hand, players:One($target_player_ref)}, kind:Card, filter:Any}, count:AsManyAsCan($card_count_many), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:$chosen_hand_library_position, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
chosen_hand_cards_to_library ::= target_player_ref "chooses" card_count_many "from" "their" "hand" "and" "puts" "them" chosen_hand_library_position "of" "their" "library" "in" "any" "order"

chosen_hand_library_position ::= library_end_top | library_end_bottom

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$chosen_hand_cards_to_library}} */
spell_chosen_hand_cards_to_library ::= chosen_hand_cards_to_library "."

/* The revealed library and its remainder belong to the revealing player.
   The selection can move a card away; InZone retains only the observed cards still there. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:$top_many, from:Top}}}, Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:AllOf([$filter_phrase, AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]), Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}])}, count:UpTo(Constant(1)), constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:$observed_entry_destination, qualifiers:[]}}}, Effect{result:@next, operation:ReorderLibrary{chooser:$player_ref, library_owner:$player_ref, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:$library_order}}] */
player_reveal_selection_bottom ::= player_ref "reveals" "the" "top" top_many "of" "their" "library" "." "you" "may" "put" "a" filter_phrase "card" "with" "mana" "value" number "or" "less" "from" "among" "them" observed_entry_destination "." "that" "player" "puts" "the" "rest" "on" "the" "bottom" "of" "their" "library" library_order

/* The selected card, its hand destination, and shuffle belong to this search. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_single_library}, Effect{result:@next, operation:$found_it_hand}, ...$search_shuffle] */
search_single_hand_shuffle ::= search_single_library "," found_it_hand search_shuffle

/* Compose the search episode with a separate change of control. */
/* @sem Program::Program{instructions:[...$search_single_hand_shuffle, Effect{result:@next, operation:$opponent_gains_control}]} */
program_search_hand_then_opponent_control ::= search_single_hand_shuffle "." opponent_gains_control

/* A single card choice with an exact mana value is shared by ordinary and
   repeated searches. */
/* @sem SearchChoice::SearchChoice{filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:$value}}]), count:UpTo(Constant(1))} */
search_choice_mana_value_exact ::= ("a" | "an") card_filter "card" "with" "mana" "value" value

/* The repeated process applies the same receipt actions to each choice. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_mana_value_exact, _{filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:$value}}]), count:UpTo(Constant(1))}, _{filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:$value_2}}]), count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:$found_reveal}, Effect{result:@next, operation:$found_hand}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
clause_search_repeat_values ::= "search" "your" "library" "for" search_choice_mana_value_exact "," found_reveal "," "and" found_hand "." "then" "repeat" "this" "process" "for" card_filter "cards" "with" "mana" "values" value "and" value "." "then" "shuffle"

/* The singular search receipt is the card moved before shuffling. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_single_library}, Effect{result:@next, operation:$search_selected_hand}, ...$search_shuffle] */
clause_search_single_sentence_hand ::= search_single_library "." search_selected_hand search_shuffle

/* A single observation supplies both disjoint movements; all three printed
   card-type mentions must agree with the reveal's stopping condition. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:$reveal_until_named_player, filter:@agree(@agree($reveal_partition_type, $reveal_partition_complement), $reveal_partition_type_2), count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Difference{objects:InZone{objects:Observed(@marked), zone:Library}, excluding:Matching{objects:Observed(@marked), filter:@agree(@agree($reveal_partition_type, $reveal_partition_complement), $reveal_partition_type_2)}}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:@agree(@agree($reveal_partition_type, $reveal_partition_complement), $reveal_partition_type_2)}, destination:$reveal_partition_destination, qualifiers:[]}}] */
grouped_reveal_opponent_partition ::= reveal_until_named_player "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" "a" reveal_partition_type "card" "." "that" "player" "puts" "all" reveal_partition_complement "cards" "revealed" "this" "way" "into" "their" "graveyard" "," "then" "you" "put" "the" reveal_partition_type "card" reveal_partition_destination

reveal_partition_type ::= noun_creature | noun_land

/* The positive type is the excluded portion of the observation. */
reveal_partition_complement ::= reveal_partition_noncreature | draw_kind_complement

/* @sem ObjectFilter::CardType(Creature) */
reveal_partition_noncreature ::= "noncreature"

reveal_partition_destination ::= reveal_partition_entry | reveal_partition_entry_tapped

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
reveal_partition_entry ::= "onto" "the" "battlefield" "under" "your" "control"

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}} */
reveal_partition_entry_tapped ::= "onto" "the" "battlefield" "tapped" "under" "your" "control"

/* Both searches retain their own selected cards through the shared continuation. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_many]} */
search_up_to_many ::= "search" "your" "library" "for" search_choice_many

/* Shared wording for the continuation; its branch-local receipt is bound by the enclosing contract. */
/* @sem () */
search_reveal_those_to_hand ::= "reveal" "those" "cards" "," "put" "them" "into" "your" "hand" "," "then" "shuffle"

/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:$search_up_to_many_2}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:$search_up_to_many}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}}] */
clause_search_instead_reveal ::= search_up_to_many "." "if" condition "," "instead" search_up_to_many "." search_reveal_those_to_hand

/* The selection is shared by the reveal and the distinct-name test. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:$filter_phrase, count:UpTo($value)}]} */
search_filtered_count_cards ::= "search" "your" "library" "for" value filter_phrase "cards"

/* @sem Instruction::If{condition:Compare{left:CountDistinct{objects:Selected(@marked), property:Names}, test:NumberTest::Compare{comparison:Equal, value:$card_count}}, then:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Selected(@marked), count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{instructions:[]}} */
searched_distinct_random_hand ::= "if" "you" "reveal" card_count "with" "different" "names" "," "choose" "one" "of" "them" "at" "random" "and" "put" "that" "card" "into" "your" "hand"

/* @sem Instruction::[Effect{result:@mark, operation:$search_filtered_count_cards}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, $searched_distinct_random_hand, ...$search_shuffle_remainder] */
clause_search_reveal_distinct_random ::= search_filtered_count_cards "and" "reveal" "them" "." searched_distinct_random_hand "." search_shuffle_remainder

/* @sem Instruction::[Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
search_shuffle_remainder ::= "shuffle" "the" "rest" "into" "your" "library"

/* Scope the observation and its consumer together: only this reveal receipt
   licenses the revealed-card wording in both directions. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_until_all_head}, Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:$until_destination, qualifiers:[]}}] */
reveal_until_all_observed ::= reveal_until_all_head "," "then" "put" "all" "cards" "revealed" "this" "way" until_destination

reveal_until_all_head ::= reveal_until_all_one | reveal_until_all_many

/* @sem Operation::RevealUntil{library:AbilityController, filter:$reveal_until_card, count:Constant(1)} */
reveal_until_all_one ::= reveal_until_your_library reveal_until_card

/* @sem Operation::RevealUntil{library:AbilityController, filter:$card_filter, count:$count_plural} */
reveal_until_all_many ::= reveal_until_your_library count_plural card_filter "cards"

/* A plural search keeps plural references in its follow-up actions. */
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:$search}, ...$search_plural_follow] */
clause_search_plural_follow ::= search search_plural_follow

/* Keep the mill producer and its counted arrival receipt in one print contract. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:CreateTrigger{event:Object{event:Attacks, objects:CardType(Creature)}, duration:EndOfTurn, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(EventSubject)), changes:[Pump{power:@times($number_digits, Expr::CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$noun})), toughness:@times($number_digits_2, Expr::CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$noun}))}], duration:EndOfTurn, evaluation:Snapshot}}]}}}] */
instructions_mill_attack_receipt_pump ::= "mill" card_count "." "whenever" "a" "creature" "attacks" "this" "turn" "," "it" "gets" "+" number_digits "/" "+" number_digits "until" "end" "of" "turn" "for" "each" noun "card" "put" "into" "your" "graveyard" "this" "way"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_mill_attack_receipt_pump}} */
spell_mill_attack_receipt_pump ::= instructions_mill_attack_receipt_pump "."

/* The selected player's bottom card remains distinct from the top-card receipt. */
/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:Constant(1), from:Bottom}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
player_exiles_bottom_card ::= player_ref "exiles" "the" "bottom" "card" "of" "their" "library"

/* The counter amount names the graveyard move in the preceding pile process.
   Keep that producer inside this contract so inverse printing checks its destination. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$instructions_reveal_pile_hand_other, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[$token_defined], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Created(@prior)), kind:$counter_kind, amount:CountObjects(Transition{result:@back(3), phase:Before})}]}}]}} */
spell_revealed_pile_graveyard_token_counters ::= instructions_reveal_pile_hand_other "." "create" token_defined "," "then" "put" "a" counter_kind "counter" "on" "it" "for" "each" "card" "put" "into" "your" "graveyard" "this" "way" "."

/* A revealed library slice supplies the pile population and the eventual
   remainder; the chosen cards' move supplies the exclusion receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$revealed_pile_split, ...$revealed_pile_take, Effect{result:@next, operation:$revealed_pile_rest}] */
instructions_reveal_pile_selection ::= reveal_top "and" revealed_pile_split "." revealed_pile_take "," "then" revealed_pile_rest

/* @sem Instruction::[Effect{result:@next, operation:SeparatePiles{separator:AbilityController, chooser:OneOf(OpponentsOf(AbilityController)), objects:InZone{objects:Observed(@marked), zone:Library}}}] */
revealed_pile_split ::= "separate" "them" "into" "two" "piles" "." "an" "opponent" "chooses" "one" "of" "those" "piles"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Selected(@prior), count:AsManyAsCan($pile_card_count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
revealed_pile_take ::= "put" pile_card_count "from" "the" "chosen" "pile" "into" "your" "hand"

pile_card_count ::= count_a_card | top_many

/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(1), phase:Before}])}, zone:Library}, end:Bottom, order:$library_order} */
revealed_pile_rest ::= "put" "all" "other" "cards" "revealed" "this" "way" "on" "the" "bottom" "of" "your" "library" library_order

/* A player's observed top card is tested before the branch resolves. The
   branch is restricted to consumers of that same observation. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:$player_observed_top_branch}, otherwise:Program{}}] */
player_observed_top_test ::= player_ref "reveals" "the" "top" "card" "of" "their" "library" "." "if" "it's" top_reveal_quality "," player_observed_top_branch

player_observed_top_branch ::= player_observed_top_move_copy | top_reveal_draw

/* The move consumes the observation and the copy refers to the revealed card. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Observed(@marked), destination:$player_observed_destination, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[CopyOf{object:Earlier{what:Revealed}, exceptions:[]}], duration:Indefinite, evaluation:Snapshot}}] */
player_observed_top_move_copy ::= "the" "player" "puts" "the" "card" player_observed_destination "and" "this" "enchantment" "becomes" "a" "copy" "of" "that" "card"

player_observed_destination ::= named_reveal_graveyard | named_reveal_hand

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$player_observed_top_test}} */
trigger_player_observed_top_test ::= "at" turn_event "," player_observed_top_test "."

/* A whole-library observation feeds a categorized choice; the next actions
   consume that choice rather than an independent query. */
/* @sem Operation::Reveal{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}} */
reveal_own_library_cards ::= "reveal" "the" "cards" "in" "your" "library"

/* @sem ObjectFilter::AllOf([$adjective_nontype, $adjective_nontype_2]) */
negative_card_pair ::= adjective_nontype "," adjective_nontype "card"

/* The three filters are independently reusable selection operands. */
/* @sem SelectionConstraint::OneForEach([$noun, $noun_2, $negative_card_pair]) */
observed_three_card_kinds ::= "a" noun "card" "," "a" noun "card" "," "and" "a" negative_card_pair

/* The producer and both consumers share one instruction scope. */
/* @sem Instruction::[Effect{result:@next, operation:$reveal_own_library_cards}, Effect{result:@next, operation:ChooseObjects{player:OneOf(OpponentsOf(AbilityController)), objects:InZone{objects:Observed(@prior), zone:Library}, count:AsManyAsCan(Constant(3)), constraints:[$observed_three_card_kinds]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_reveal_library_choose_kinds ::= reveal_own_library_cards "." "an" "opponent" "chooses" "from" "among" "them" observed_three_card_kinds "." "you" "put" "the" "chosen" "cards" "into" "your" "hand" "." "then" "shuffle"

/* Basic qualifies each member of the subtype disjunction. */
/* @sem ObjectFilter::AllOf([Supertype(Basic), AnyOf([$subtype, Subtype(Plains), $subtype_2])]) */
search_filter_basic_plains_list ::= "basic" subtype "," "↑" "plains" "," "or" subtype "card"

/* A revealed library slice supplies both the choice and its remainder. */
/* @sem SelectionConstraint::NoCommonProperty(ColorPairs) */
revealed_color_pair_constraint ::= "for" "each" "color" "pair" "," "choose" "a" "card" "that's" "exactly" "those" "colors" "from" "among" "them"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AnyNumber, constraints:[$revealed_color_pair_constraint]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
revealed_distinct_choice_hand ::= revealed_color_pair_constraint "." "put" "the" "chosen" "cards" "into" "your" "hand"

/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$revealed_distinct_choice_hand, $dig_rest_and] */
dig_reveal_distinct_choice ::= reveal_top "." revealed_distinct_choice_hand dig_rest_and

/* A reveal-until observation supplies the following characteristic change and
   the library reorder. The whole contract retains its producer for printing. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_until_stat_head}, Effect{result:@next, operation:$revealed_stat_effect}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:$library_order}}] */
reveal_until_stat_reorder ::= reveal_until_stat_head "." revealed_stat_effect "." "put" "the" "revealed" "cards" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[SetPower(Multiply([$revealed_stat_factor, Earlier{what:Revealed, measure:Of(Power)}])), SetToughness(Multiply([$revealed_stat_factor_2, Earlier{what:Revealed, measure:Of(Toughness)}]))], duration:$duration, evaluation:Snapshot} */
revealed_stat_effect ::= duration "," "this" "creature's" "base" "power" "becomes" revealed_stat_factor "that" "card's" "power" "and" "its" "base" "toughness" "becomes" revealed_stat_factor "that" "card's" "toughness"

/* @sem Expr::Constant(2) */
revealed_stat_factor ::= "twice"

/* @sem Operation::RevealUntil{library:AbilityController, filter:$filter_phrase, count:$counter_amount} */
reveal_until_stat_head ::= reveal_until_your_library counter_amount filter_phrase "card"

/* The consumer is only available inside this scoped mill-and-move sequence. */
/* @sem Instruction::[...$mill_hand_origin, ...$mill_hand_choices, If{condition:$mill_hand_none, then:Program{instructions:$conjoined}, otherwise:Program{}}] */
instructions_mill_any_hand_none ::= mill_hand_origin "." mill_hand_choices "." "if" mill_hand_none "," conjoined

/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}] */
mill_hand_origin ::= "you" "mill" card_count

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:AnyOf(@unordered([$quality_unscoped, $filter_phrase]))}, count:AnyNumber, constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
mill_hand_choices ::= "you" "may" "put" "any" "number" "of" quality_unscoped "and" "/" "or" filter_phrase "cards" "from" "among" "them" "into" "your" "hand"

/* @sem Condition::Compare{left:CountObjects(Transition{result:@last_result, phase:Before}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}} */
mill_hand_none ::= "you" "put" "no" "cards" "into" "your" "hand" "this" "way"

/* A tested observation remains in scope for the immediately following move. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:Observed(@marked), destination:$named_reveal_graveyard, qualifiers:[]}}, Effect{result:@next, operation:$revealed_card_copy_self}]}, otherwise:Program{}}] */
instructions_player_reveal_test_move ::= player_ref "reveals" "the" "top" "card" "of" "their" "library" "." "if" "it's" top_reveal_quality "," "the" "player" "puts" "the" "card" named_reveal_graveyard "and" revealed_card_copy_self

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Objects(One($self_explicit_ref)), changes:[CopyOf{object:Earlier{what:Revealed}, exceptions:[]}], duration:Indefinite, evaluation:Snapshot} */
revealed_card_copy_self ::= self_explicit_ref "becomes" "a" "copy" "of" "that" "card"

/* The observed card and the remaining library are tied to this reveal. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$reveal_until_card, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$reveal_until_card}, destination:$until_destination, qualifiers:[]}}, Effect{result:@next, operation:$shuffle_other_revealed_library}] */
reveal_single_move_shuffle ::= reveal_until_your_library reveal_until_card "," "put" "that" "card" until_destination "," shuffle_other_revealed_library

/* @sem Operation::Shuffle{players:One(AbilityController)} */
shuffle_other_revealed_library ::= "then" "shuffle" "all" "other" "cards" "revealed" "this" "way" "into" "your" "library"

/* The sacrificed target determines the controller in the following reveal sequence. */
/* @sem Instruction::[Effect{result:@next, operation:@sacrificed_result(Operation::Sacrifice{players:One(ControllerOf($target_permanent)), objects:One($target_permanent)})}] */
controller_sacrifices_target ::= "the" "controller" "of" target_permanent "sacrifices" "it"

/* Keep the reveal, its matching card, and the player who shuffles in one scope. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:ControllerOf(Target{slot:@last_slot, index:0}), filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$card_filter}, destination:Battlefield{controller:Player(ControllerOf(Target{slot:@last_slot, index:0})), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf(Target{slot:@last_slot, index:0}))}}] */
controller_reveals_an_entry_shuffle ::= "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" "an" card_filter "card" "." "that" "player" "puts" "that" "card" "onto" "the" "battlefield" "," "then" "shuffles" "all" "other" "cards" "revealed" "this" "way" "into" "their" "library"

/* @sem Instruction::[...$controller_sacrifices_target, ...$controller_reveals_an_entry_shuffle] */
sacrifice_controller_reveal_entry ::= controller_sacrifices_target "," "then" controller_reveals_an_entry_shuffle

/* The cast and declined branch refer to this single top-card exile receipt. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Move{objects:$own_library_top_card, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Result{result:@marked, phase:After, index:0}), count:Exactly(Constant(1)), cost:Normal}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@prior)), then:$program, otherwise:Program{}}]} */
program_exile_top_cast_declined ::= "exile" own_library_top_card "." "you" "may" "cast" "that" "card" "." "if" "you" "don't" "," program

/* The choice consumes the immediately preceding exile's actual arrivals. The
   producer and choice are one unit so inverse printing proves the receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:$choice_exile_top, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Transition{result:@marked, phase:After}, count:AsManyAsCan(Constant(1))}}] */
clause_exile_top_choose_one ::= "exile" choice_exile_top choice_exile_join "choose" "one" "of" "them"

choice_exile_top ::= choice_exile_top_fixed | choice_exile_top_event

/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:$top_count, from:Top} */
choice_exile_top_fixed ::= "the" "top" top_count "of" "your" "library"

/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:EventAmount, from:Top} */
choice_exile_top_event ::= "that" "many" "cards" "from" "the" "top" "of" "your" "library"

/* @sem () */
choice_exile_join ::= "." | "," "then"

/* The chosen opponent and the difference search share one population filter. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Player, terms:_{count:Exactly(Constant(1)), options:[Players(Intersection([OpponentsOf(AbilityController), Matching{binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Bound(0)))])}), test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])})}}}]))]}}}, Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:$filter_phrase, count:UpTo(Subtract(CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(Chosen))])}), CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_plural, ControlledBy(One(AbilityController))])})))}]}}] */
choose_more_and_search_difference ::= "choose" "an" "opponent" "who" "controls" "more" filter_plural "than" "you" "." "search" "your" "library" "for" "a" "number" "of" filter_phrase "cards" "equal" "to" "the" "difference"

/* Partition the searched selection, retaining its receipt for both moves. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Selected(@back(3)), count:AsManyAsCan($value)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Selected(@back(5)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
searched_reveal_partition_tapped_hand ::= "reveal" "those" "cards" "," "put" value "of" "them" "onto" "the" "battlefield" "tapped" "and" "the" "rest" "into" "your" "hand" "," "then" "shuffle"

/* @sem Instruction::[...$choose_more_and_search_difference, ...$searched_reveal_partition_tapped_hand] */
instructions_choose_more_search_partition ::= choose_more_and_search_difference "," searched_reveal_partition_tapped_hand

/* The search receipt is shared by the exclusion and library reorder. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:Any, count:AsManyAsCan($card_count)}], also:[Graveyard]}}, Effect{result:@next, operation:Move{objects:Difference{objects:Union([Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any})]), excluding:Selected(@marked)}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@marked), end:$cost_library_end, order:$library_order}}] */
search_two_zones_exile_rest_reorder ::= "search" "your" "library" "and" "graveyard" "for" card_count "and" "exile" "the" "rest" "." "put" "the" "chosen" "cards" cost_library_end "of" "your" "library" library_order

/* A concrete top slice supplies the observation for the following partition. */
/* @sem Operation::Reveal{objects:$your_top_slice} */
reveal_top_slice_for_chosen_type ::= "reveal" your_top_slice

/* Keep the observation, the chosen-type move, and the remainder together. */
/* @sem Instruction::[Effect{result:@next, operation:$choose_a_card_type}, Effect{result:@next, operation:$reveal_top_slice_for_chosen_type}, Effect{result:@next, operation:Move{objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:Chosen(CardType)}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(3)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Chosen}}] */
choose_type_reveal_hand_remainder ::= choose_a_card_type "," "then" reveal_top_slice_for_chosen_type "." "put" "all" "cards" "of" "the" "chosen" "type" "revealed" "this" "way" "into" "your" "hand" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "any" "order"

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$choose_type_reveal_hand_remainder}} */
trigger_choose_type_reveal_hand_remainder ::= "at" turn_event "," choose_type_reveal_hand_remainder "."

/* A sacrificed artifact's value is meaningful only within the matching
   activation payment below. Keep the count separate for reuse by both bodies. */
/* @sem Expr::Add($value, ObjectProperty{object:Query{objects:CostObjects{payment:Activation, component:[1], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown}) */
paid_artifact_plus_value ::= value "plus" "the" "mana" "value" "of" "the" "sacrificed" "artifact"

/* @sem Operation::Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$paid_artifact_plus_value, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
paid_artifact_exile_top ::= "exile" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" paid_artifact_plus_value

/* The fixed cost establishes both the identity and the singular artifact type
   of component [1]. The permission is linked to this exact exile producer. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[TapSymbol, Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), CardType(Artifact)])}, choose:Exactly(Constant(1))}]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:$paid_artifact_exile_top}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@marked, phase:After}, origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}]}} */
activated_paid_artifact_exile_play ::= "{" "T" "}" "," "↑" "sacrifice" "another" "artifact" ":" paid_artifact_exile_top "." "you" "may" "play" "those" "cards" this_duration "."

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[TapSymbol, Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), CardType(Artifact)])}, choose:Exactly(Constant(1))}]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$paid_artifact_exile_top}]}} */
activated_paid_artifact_exile ::= "{" "T" "}" "," "↑" "sacrifice" "another" "artifact" ":" paid_artifact_exile_top "."

/* The permission is tied to the immediately preceding top-of-library exile. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@prior, phase:After}, origins:CardPlayOrigins([Exile]), action:CastSpell, filter:$adjective_nontype}, terms:_{cost:Free}})], duration:$duration, evaluation:LiveObjects}}] */
clause_top_exile_filtered_free_cast ::= exile_top_cards_of_your_library "." duration "," "you" "may" "cast" adjective_nontype "spells" "from" "among" "those" "cards" "without" "paying" "their" "mana" "costs"

/* The observation and its reorder share the same own-library receipt. */
/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@prior), zone:Library}, end:Bottom, order:$library_order} */
observed_cards_bottom ::= "put" "those" "cards" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Instruction::[Effect{result:@next, operation:$observe_own_library}, Effect{result:@next, operation:$observed_cards_bottom}] */
grouped_observe_reorder_bottom ::= observe_own_library "," "then" observed_cards_bottom

observe_own_library ::= reveal_top | look_top

/* The observed population stays restricted to cards still in the library. */
/* @sem ObjectSet::InZone{objects:Observed(@marked), zone:Library} */
revealed_library_population ::= "the" "revealed" "cards"

/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:$revealed_library_population, end:$planar_first_end, order:$library_order} */
reorder_observed_library ::= "put" revealed_library_population "on" planar_first_end "of" "your" "library" library_order

/* Keep the reveal receipt in scope through its intervening characteristic effect. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_until_all_one}, Effect{result:@next, operation:$leading_observed_base_stats}, Effect{result:@next, operation:$reorder_observed_library}] */
reveal_until_stats_reorder ::= reveal_until_all_one "." leading_observed_base_stats "." reorder_observed_library

/* Reveal and move share the observed card; the destination and filter remain operands. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$filter_phrase, count:$counter_a}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$filter_phrase}, destination:$until_destination, qualifiers:[]}}, Effect{result:@next, operation:$shuffle_revealed_other_cards}] */
reveal_matching_move_shuffle ::= reveal_until_your_library counter_a filter_phrase "card" "." "if" "you" "do" "," "put" "that" "card" until_destination "and" shuffle_revealed_other_cards

/* @sem Operation::Shuffle{players:One(AbilityController)} */
shuffle_revealed_other_cards ::= "shuffle" "all" "other" "cards" "revealed" "this" "way" "into" "your" "library"

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:$reveal_matching_move_shuffle}}] */
/* @prefer always */
instructions_may_reveal_shuffle ::= "you" "may" reveal_matching_move_shuffle

/* @sem Instruction::[$target_opponent_mill_cards] */
clause_target_opponent_mill ::= target_opponent_mill_cards

/* The observed collection is the receipt of this immediately adjacent reveal. */
/* @sem Instruction::[Effect{result:@mark, operation:$players_reveal_tops}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:Shares{property:CardTypes, with:$object_ref}}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:$conjoined}, otherwise:Program{instructions:$conjoined_2}}] */
instructions_reveal_shared_type_otherwise ::= players_reveal_tops "." "if" "any" "of" "those" "cards" "shares" "a" "card" "type" "with" object_ref "," conjoined "." "otherwise" "," conjoined

/* The search receipt identifies the card attached to the independent host. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo($object_ref)]}}, qualifiers:[]}}] */
search_either_attached ::= "and" "put" "it" "onto" "the" "battlefield" "attached" "to" object_ref

/* The graveyard-first form preserves its usual spelling for attached results. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice], also:[Graveyard], either:true}}, ...$search_either_attached, If{condition:Searched(@marked), then:Program{instructions:[Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:Program{}}] */
clause_search_either_graveyard_attached ::= "search" "your" "graveyard" "and" "/" "or" "library" "for" search_choice search_either_attached "." "if" "you" "search" "your" "library" "this" "way" "," "shuffle"

/* @prefer always */
/* @sem () */
mill_take_origin_existing ::= "from" "among" "them" | "milled" "this" "way"

/* @prefer always */
/* @sem () */
mill_take_origin_milled ::= "from" "among" "the" "milled" "cards"

/* The removal, counted exile, and permission form one receipt-scoped sequence. */
/* @sem Instruction::[Effect{result:@next, operation:RemoveCounters{removals:[_{player:AbilityController, recipients:Objects($affected), kind:$counter_kind, amount:Count(Exactly($counter_amount)), selection:_{player:AbilityController, count:AnyNumber}}]}}, Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:CountersRemoved(@prior), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@prior, phase:After}, origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}] */
remove_each_exile_count_play ::= "remove" counter_amount counter_kind "counter" "from" "each" "of" "any" "number" "of" affected "." "exile" "that" "many" "cards" "from" "the" "top" "of" "your" "library" "." "you" "may" "play" "them" this_duration

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[Loyalty($loyalty_heading)]}, limits:ActivationLimits{sorcery:true}, announcement:@announcement, body:Program{instructions:[...$remove_each_exile_count_play]}} */
loyalty_remove_each_exile_play ::= loyalty_heading ":" remove_each_exile_count_play "."

/* @prefer always */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[Loyalty(Constant(0))]}, limits:ActivationLimits{sorcery:true}, announcement:@announcement, body:Program{instructions:[...$remove_each_exile_count_play]}} */
loyalty_zero_remove_each_exile_play ::= loyalty_zero_heading ":" remove_each_exile_count_play "."

/* The comparison is valid only in the immediate branch of this exact reveal. */
/* @sem Condition::Compare{left:CountObjects(Matching{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, filter:Shares{property:ManaValues, with:$object_ref}}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
revealed_top_same_mana_value ::= object_ref "has" "the" "same" "mana" "value" "as" "the" "revealed" "card"

/* The operation and comparison compose inside the scope of the reveal. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[If{condition:$revealed_top_same_mana_value, then:Program{instructions:[Effect{result:@next, operation:$operation_plain}]}, otherwise:Program{}}]}, otherwise:Program{}}] */
clause_optional_reveal_top_same_value ::= "you" "may" "reveal" "the" "top" "card" "of" "your" "library" "." "if" "you" "do" "," operation_plain "if" revealed_top_same_mana_value

/* Search choices and their destination independently retain the referenced host. */
/* @sem SearchChoice::SearchChoice{filter:AllOf([$filter_phrase, CouldEnchant(One($object_ref))]), count:UpTo(Constant(1))} */
search_choice_could_enchant ::= "an" filter_phrase "card" "that" "could" "enchant" object_ref

/* Keep this destination scoped to the search that establishes the enchantment host. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_could_enchant]} */
search_could_enchant ::= "search" "your" "library" "for" search_choice_could_enchant

/* @sem Instruction::[Effect{result:@mark, operation:$search_could_enchant}, Effect{result:@next, operation:$search_found_attached}, ...$search_shuffle] */
clause_search_enchant_attached ::= search_could_enchant "," search_found_attached search_shuffle

/* The selected search result goes to hand; the later discard has an independent count. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:$search_unrestricted_up_to}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}, Effect{result:@next, operation:$discard_random_hand}] */
search_hand_shuffle_random_discard ::= search_unrestricted_up_to "," "put" "them" "into" "your" "hand" "," "shuffle" "," "then" discard_random_hand

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:Any, count:AsManyAsCan($count)}]} */
search_unrestricted_up_to ::= "search" "your" "library" "for" "up" "to" count "cards"

/* The inspected top card stays in the same library until the optional entry
   payment or its declined fallback. The subtype disjunction and card type
   remain independent, printable operands. */
/* @sem Instruction::[...$top_card_look, Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:MoveTopCard{actor:One(AbilityController), cards:@and($look_entry_subtype_list, $noun), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}}]}, otherwise:Program{}}] */
instructions_look_filtered_entry_or_bottom ::= top_card_look "if" "it's" "a" look_entry_subtype_list noun "card" "," "you" "may" "put" "it" "onto" "the" "battlefield" "." "if" "you" "don't" "put" "the" "card" "onto" "the" "battlefield" "," "you" "may" "put" "it" "on" "the" "bottom" "of" "your" "library"

look_entry_subtype_list ::= look_entry_subtype_more | look_entry_subtype_last

/* @sem ObjectFilter::@or($subtype_spelled, $look_entry_subtype_list) */
look_entry_subtype_more ::= subtype_spelled "," look_entry_subtype_list

/* @sem ObjectFilter::@or($subtype_spelled, $subtype_spelled_2) */
look_entry_subtype_last ::= subtype_spelled ","? "or" subtype_spelled

/* The condition governs the complete random selection and move. */
/* @prefer always */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:$instead_seek_action}, otherwise:Program{}}] */
clause_seek_postcondition ::= instead_seek_action "if" condition

/* The looked-at query and the exile producer must address the same top card;
   the permission names the resulting exile arrival. */
/* @sem ObjectSet::Take{objects:Zone(_{scope:Players{zone:Library, players:One($look_exile_library_owner)}, kind:Card, filter:Any}), count:Constant(1), from:Top} */
look_exile_library_top ::= "the" "top" "card" "of" look_exile_library_owner "library"

look_exile_library_owner ::= look_exile_event_owner | zone_your

/* @sem PlayerRef::EventSubject */
look_exile_event_owner ::= "that" "player's"

/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:$look_exile_library_top}}, Effect{result:@mark, operation:Move{objects:$look_exile_library_top, destination:$look_top_exile_destination, qualifiers:[]}}, ...$linked_single_play_spending] */
look_exile_top_play ::= "look" "at" look_exile_library_top "," "then" look_top_exile_destination "." linked_single_play_spending

/* @sem Ability::Triggered{event:$look_exile_cast_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$look_exile_top_play}} */
look_exile_cast_trigger ::= "whenever" look_exile_cast_event "," look_exile_top_play "."

look_exile_cast_event ::= event_first_spell_opponents_turn | event_cast_nth

/* All three populations belong to the player bound by the shuffle loop. */
/* @sem ObjectSet::Union([Zone(_{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any}), Zone{scope:Shared(Battlefield), kind:Permanent, filter:OwnedBy(One(Bound(0))) }]) */
bound_hand_graveyard_owned_permanents ::= "their" "hand" "," "graveyard" "," "and" "all" "permanents" "they" "own"

/* Each player's shuffle completes before the shared draw. */
/* @sem Instruction::[ForEachPlayer{players:$shuffle_plural_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:$bound_hand_graveyard_owned_permanents, destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}, Effect{result:@next, operation:Draw{players:$shuffle_plural_players, amount:$card_count}}] */
clause_shuffle_owned_zones_draw ::= shuffle_plural_players "shuffles" bound_hand_graveyard_owned_permanents "into" "their" "library" "," "then" "draws" card_count

/* A literal life total belongs to each player in the quantified set. */
/* @sem Instruction::[ForEachPlayer{players:$possessive_loop_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:SetLifeTotal{players:One(Bound(0)), amount:$number_digits}}]}}] */
clause_each_life_total_literal ::= possessive_loop_players "life" "total" "becomes" number_digits

/* The library owner is supplied by the player phrase; the observation and
   its exile are separate effects so other continuations can compose them. */
/* @sem $player_ref */
exile_until_player_prefix ::= player_ref "exiles" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "exile"

exile_until_player_filter ::= mill_test_card_filter | shuffle_reveal_card_an | exile_until_player_filter_an_pair

/* @sem Operation::RevealUntil{library:$exile_until_player_prefix, filter:$exile_until_player_filter, count:Constant(1)} */
exile_until_player_observation ::= exile_until_player_prefix exile_until_player_filter

/* @sem Instruction::[Effect{result:@next, operation:$exile_until_player_observation}, Effect{result:@next, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_player_exile_until_observed ::= exile_until_player_observation

/* Keep the singleton exile and its later permission in one scoped phrase. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:$exile_top_single_library_card}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::GainEnergy{amount:$energy_amount_spelled}}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@prior)), then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}]}, otherwise:Program{}}]} */
top_card_energy_or_play_program ::= exile_top_single_library_card "." "you" "may" "get" energy_amount_spelled "." "if" "you" "don't" "," "you" "may" "play" "that" "card" this_duration "."

/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_top_single_library_card ::= "exile" "the" "top" "card" "of" "your" "library"

/* The searched selection remains in the library while an opponent partitions it.
   The unchosen subset is excluded from the shuffle and then moved to hand. */
/* @sem SearchChoice::SearchChoice{filter:$card_filter, count:UpTo($count), constraints:[DifferentProperty(Power)]} */
search_choice_different_powers ::= "up" "to" count card_filter "cards" "with" "different" "powers"

/* @sem Instruction::[Effect{result:@mark, operation:$search_constrained_plural}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, ...$searched_opponent_partition_hand] */
clause_search_reveal_opponent_partition ::= search_constrained_plural "and" "reveal" "them" "." searched_opponent_partition_hand

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:OneOf(OpponentsOf(AbilityController)), objects:Selected(@marked), count:AsManyAsCan($value)}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController), excluding:Unselected(@prior)}}, Effect{result:@next, operation:Move{objects:Unselected(@back(3)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
searched_opponent_partition_hand ::= "an" "opponent" "chooses" value "of" "those" "cards" "." "shuffle" "the" "chosen" "cards" "into" "your" "library" "and" "put" "the" "rest" "into" "your" "hand"

/* Four independently described choices share one search selection. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_filtered, ...$search_filtered_three]} */
search_four_choices ::= "search" "your" "library" "for" search_choice_filtered "," search_filtered_three

/* Follow-ups refer to the complete selection produced by the search. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_four_choices}, Effect{result:@next, operation:$found_those_reveal}, ...$search_plural_follow] */
clause_search_four_choices ::= search_four_choices "." found_those_reveal search_plural_follow

/* The snapshot and subsequent shuffle refer to the very slice just looked at. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:$face_down_pile_library_cards}}, Effect{result:@mark, operation:NoteObjects{objects:InZone{objects:$face_down_pile_library_cards, zone:Library}}}, ...$last_look_shuffle_top] */
instructions_look_shuffle_last ::= "look" "at" face_down_pile_library_cards "." last_look_shuffle_top

/* Bind both inspections to the same slice and retain it across the repeat and shuffle. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:@agree($count_plural, $count_plural_2), from:Top}}}, Repeatable{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Life($number)]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:@agree($count_plural, $count_plural_2), from:Top}, zone:Library}, end:Bottom, order:Chosen}}, Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:@agree($count_plural, $count_plural_2), from:Top}}}, Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}]}, Effect{result:@mark, operation:NoteObjects{objects:InZone{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:@agree($count_plural, $count_plural_2), from:Top}, zone:Library}}}, ...$last_look_shuffle_top] */
instructions_repeat_look_shuffle ::= "look" "at" "the" "top" count_plural "cards" "of" "your" "library" "." "as" "many" "times" "as" "you" "choose" "," "you" "may" "pay" number "life" "," "put" "those" "cards" "on" "the" "bottom" "of" "your" "library" "in" "any" "order" "," "then" "look" "at" "the" "top" count_plural "cards" "of" "your" "library" "." last_look_shuffle_top

/* @sem Instruction::[Effect{result:@next, operation:Shuffle{players:One(AbilityController), excluding:Selected(@marked)}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@marked), end:Top, order:Chosen}}] */
last_look_shuffle_top ::= "then" "shuffle" "and" "put" "the" "last" "cards" "you" "looked" "at" "this" "way" "on" "top" "in" "any" "order"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_repeat_look_shuffle}} */
spell_repeat_look_shuffle ::= instructions_repeat_look_shuffle "."

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$instructions_look_shuffle_last}} */
spell_look_shuffle_last ::= instructions_look_shuffle_last "."

/* A singular library search supplies the exact receipt revealed by this phrase. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_single_library}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}] */
search_single_reveal_it ::= search_single_library "and" "reveal" "it"

/* The intervening operation can consume the selected card before shuffling. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$search_single_reveal_it, Effect{result:@next, operation:$operation}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}} */
spell_search_reveal_followup_shuffle ::= search_single_reveal_it "." operation "." "then" "shuffle" "."

/* The reveal establishes the observation used by both movements. The second
   movement excludes exactly the cards moved by the first. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, Effect{result:@next, operation:Move{objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:Chosen(CardName)}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
reveal_chosen_name_hand_graveyard ::= reveal_top "." "put" "all" "cards" "with" "the" "chosen" "name" "from" "among" "them" "into" "your" "hand" "and" "the" "rest" "into" "your" "graveyard"

/* The revealed top card, optional entry, and fallback are one contract.
   The entry's eligibility and both destinations remain current operands. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:MoveTopCard{actor:One(AbilityController), cards:$a_card_value_limit, reveal:false, destination:$top_card_battlefield}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:$revealed_top_fallback}, otherwise:Program{}}] */
clause_reveal_top_optional_entry_fallback ::= "reveal" "the" "top" "card" "of" "your" "library" "." "you" "may" "put" "that" "card" top_card_battlefield "if" "it's" a_card_value_limit "." "otherwise" "," revealed_top_fallback

revealed_top_fallback ::= revealed_top_fallback_that | revealed_top_fallback_it

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:$top_reveal_destination, qualifiers:[]}}] */
revealed_top_fallback_that ::= "put" "that" "card" top_reveal_destination

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:$top_reveal_destination, qualifiers:[]}}] */
revealed_top_fallback_it ::= "put" "it" top_reveal_destination

/* Scoped to a successful sacrifice of the current target by its controller. */
sacrificed_target_reveal_group ::= sacrificed_target_reveal_one | sacrificed_target_reveal_many

/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:ControllerOf(Target{slot:@last_slot, index:0}), filter:AllOf([$sacrificed_target_reveal_filter, Shares{property:CardTypes, with:Target{slot:@last_slot, index:0}}]), count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:AllOf([$sacrificed_target_reveal_filter, Shares{property:CardTypes, with:Target{slot:@last_slot, index:0}}])}, destination:Battlefield{controller:Player(ControllerOf(Target{slot:@last_slot, index:0})), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf(Target{slot:@last_slot, index:0}))}}] */
sacrificed_target_reveal_one ::= "they" "reveal" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" "a" sacrificed_target_reveal_filter "that" "shares" "a" "card" "type" "with" "the" "sacrificed" "permanent" "," "put" "that" "card" "onto" "the" "battlefield" "," "then" "shuffle"

/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:ControllerOf(Target{slot:@last_slot, index:0}), filter:AllOf([$dig_permanent_cards, Shares{property:CardTypes, with:Target{slot:@last_slot, index:0}}]), count:$count_plural}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:AllOf([$dig_permanent_cards, Shares{property:CardTypes, with:Target{slot:@last_slot, index:0}}])}, destination:Battlefield{controller:Player(ControllerOf(Target{slot:@last_slot, index:0})), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf(Target{slot:@last_slot, index:0}))}}] */
sacrificed_target_reveal_many ::= "they" "reveal" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" count_plural dig_permanent_cards "that" "share" "a" "card" "type" "with" "the" "sacrificed" "permanent" "," "put" "those" "cards" "onto" "the" "battlefield" "," "then" "shuffle"

/* @sem ObjectFilter::AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]) */
sacrificed_target_reveal_filter ::= "permanent" "card"

/* Independent search choices share their selection through both follow-up actions. */
search_choices_reveal_producer ::= search_three_graveyard_choices | search_four_choices

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_three_singular_choice, $search_three_singular_choice_2, $search_three_singular_choice_3], also:[Graveyard]} */
search_three_graveyard_choices ::= "search" "your" "library" "and" "graveyard" "for" search_three_singular_choice "," search_three_singular_choice "," "and" search_three_singular_choice

/* The marked search selection remains the antecedent across reveal and move. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:$search_choices_reveal_producer}, ...$search_those_reveal_hand_follow] */
clause_search_choices_reveal_hand ::= search_choices_reveal_producer "." search_those_reveal_hand_follow

/* @sem Instruction::[Effect{result:@next, operation:$found_those_reveal}, Effect{result:@next, operation:$found_plural_hand}, ...$search_shuffle] */
search_those_reveal_hand_follow ::= found_those_reveal "," found_plural_hand search_shuffle

/* Strictly more of the same population, measured for each player. */
/* @sem Expr::CountPlayers(Matching{binding:0, condition:Compare{left:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(Bound(0))))}), test:NumberTest::Compare{comparison:Greater, value:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:@and($filter_plural, ObjectFilter::ControlledBy(One(AbilityController)))})}}}) */
value_players_control_more ::= "the" "number" "of" "players" "who" "control" "more" filter_plural "than" "you"

/* @sem SearchChoice::SearchChoice{filter:$search_filter_many, count:UpTo($value_players_control_more)} */
search_choice_more_players ::= "up" "to" "X" search_filter_many "," "where" "X" "is" value_players_control_more

/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_more_players]}}, ...$search_those_reveal_hand_follow] */
clause_search_more_players_split ::= "search" "your" "library" "for" search_choice_more_players "." search_those_reveal_hand_follow

/* A conditional cast filter and an independently reusable spell change. */
/* @sem $filter_phrase */
cast_conditional_filter ::= "if" "you" "cast" "a" filter_phrase "spell" "this" "way" ","

/* @sem Operation::ChangeSpell{subject:One(Query{objects:Affected(@prior), index:0}), changes:[GrantKeyword($keyword_value), GrantAbility(@scope(Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$program}))]} */
spell_grant_keyword_trigger ::= "it" "gains" keyword_value "and" '"' "at" turn_event "," program "." '"'

/* Keep the reveal filter and exile arrival tied to the cast of the stopped card. */
/* @sem ObjectFilter::@or(ObjectFilter::AnyOf([CardType(Instant), CardType(Sorcery)]), $filter_phrase) */
exile_until_instant_sorcery_or ::= "an" "instant" "," "sorcery" "," "or" filter_phrase "card"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:RevealUntil{library:$exile_until_player_prefix, filter:$exile_until_instant_sorcery_or, count:Constant(1)}}, Effect{result:@mark, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Query{objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$exile_until_instant_sorcery_or}, index:0}), count:Exactly(Constant(1)), cost:Free}}, If{condition:Compare{left:CountObjects(Matching{objects:Recorded(@last_result), filter:$cast_conditional_filter}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:$spell_grant_keyword_trigger}]}, otherwise:Program{}}]}}]} */
program_player_exile_until_cast_grant ::= exile_until_player_prefix exile_until_instant_sorcery_or "." "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" "." cast_conditional_filter spell_grant_keyword_trigger

/* A choice of an exile arrival stays scoped to the library-exile loop that produced it. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:RevealUntil{library:Bound(0), filter:$adjective_nontype, count:Constant(1)}}, Effect{result:@mark, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}, Effect{result:@next, operation:ChooseObjects{player:OneOf(OpponentsOf(AbilityController)), objects:Zone{scope:Shared(Exile), kind:Card, filter:AllOf([$adjective_nontype_2, InSet(Transition{result:@marked, phase:After})])}, count:AsManyAsCan(Constant(1))}}] */
clause_each_library_exile_opponent_choice ::= players_singular "exiles" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "exile" "a" adjective_nontype "card" "." "an" "opponent" "chooses" "a" adjective_nontype "card" "exiled" "this" "way"

/* The singleton payment supplies the name. The searched cards' own exile
   move supplies the hand-origin receipt for the subsequent seek. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$cost_exile_hand]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:SharesNameWith(Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0}), count:$named_search_count}], also:[Hand]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$a_card}, count:AsManyAsCan(CountObjects(InZone{objects:Transition{result:@marked, phase:Before}, zone:Hand})), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{}}] */
optional_hand_exile_named_seek ::= "you" "may" cost_exile_hand "." "if" "you" "do" "," "search" "your" "hand" "and" "library" "for" named_search_count "cards" "with" "the" "same" "name" "," "exile" "them" "," "then" "shuffle" "." "seek" a_card "for" "each" "card" "exiled" "from" "your" "hand" "this" "way"

/* Preserve the explicit sequencing when this continuation follows a clause. */
/* @prefer always */
/* @sem Instruction::[...$clause, ...$optional_hand_exile_named_seek] */
instructions_then_hand_exile_named_seek ::= clause "." "then" optional_hand_exile_named_seek

/* The referenced creature's controller performs the complete reveal partition. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:ControllerOf(Target{slot:@last_slot, index:0}), filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$card_filter}, destination:Battlefield{controller:Player(ControllerOf(Target{slot:@last_slot, index:0})), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf(Target{slot:@last_slot, index:0}))}}] */
creature_controller_reveal_entry_shuffle ::= "that" "creature's" "controller" "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" "a" card_filter "card" "." "that" "player" "puts" "that" "card" "onto" "the" "battlefield" "," "then" "shuffles" "the" "rest" "into" "their" "library"

/* This antecedent establishes the creature described by the continuation. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($reveal_creature_target), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, ...$creature_controller_reveal_entry_shuffle] */
exile_creature_controller_reveal ::= "exile" reveal_creature_target "." creature_controller_reveal_entry_shuffle

reveal_creature_target ::= reveal_target_creature | target_qualified_creature

/* One filter applies to both private-zone populations of the ability controller. */
/* @sem ObjectSet::Union([Zone(_{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$filter_phrase}), Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$filter_phrase})]) */
hand_library_filtered_cards ::= filter_phrase "cards" "in" "your" "hand" "and" "library"

/* @sem $number */
look_hand_up_to_them ::= "up" "to" number "of" "them"

/* Announced X is the observed quantity; the chosen cap remains an operand. */
/* @prefer always */
/* @sem @scope(Mode::Mode{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:AnnouncedX, from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($number), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:$rest_bottom}]}, weight:1}) */
mode_look_announced_x_hand ::= "•" "look" "at" "the" "top" "X" "cards" "of" "your" "library" "." "put" "up" "to" number "of" "them" "into" "your" "hand" "and" rest_bottom "."

/* A repeated mill and its conditional use share the same recorded arrival. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:MillUntil{actor:$players_singular, cards:$filter_phrase, at_most:$card_count}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase_2}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}, then:Program{instructions:[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase_2}, count:AsManyAsCan($value_2)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}]}, otherwise:Program{}}]} */
repeated_mill_conditional_entry ::= players_singular "mills" "a" "card" "," "then" "repeats" "this" "process" "until" "a" filter_phrase "card" "or" card_count "have" "been" "put" "into" "their" "graveyard" "this" "way" "," "whichever" "comes" "first" "." "if" value "or" "more" filter_phrase "cards" "were" "put" "into" "that" "graveyard" "this" "way" "," operation "and" "put" value "of" "them" "onto" "the" "battlefield" "under" "your" "control"

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:$limit_x_nonzero, announcement:@announcement, body:$repeated_mill_conditional_entry} */
activated_repeated_mill_nonzero ::= cost ":" repeated_mill_conditional_entry "." limit_x_nonzero "."

/* These X values refer to the spell that caused the enclosing cast event. */
/* @sem Expr::ObjectProperty{object:EventSubject, property:SpellX, information:CurrentOrLastKnown} */
cast_event_spell_x ::= "X"

cast_event_amount ::= cast_event_spell_x | number_digits | number_words

/* @sem Operation::Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:$cast_event_amount, from:Top}} */
cast_event_reveal_top ::= "reveal" "the" "top" cast_event_amount "cards" "of" "your" "library"

/* @sem ObjectFilter::AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$cast_event_amount}}]) */
cast_event_bounded_card ::= "a" card_filter "card" "with" "mana" "value" cast_event_amount "or" "less"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$cast_event_bounded_card}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:$dig_destination}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}] */
cast_event_take_observed ::= "you" "may" "put" cast_event_bounded_card "from" "among" "them" dig_destination

/* The reveal supplies the observation for the selection and its library remainder. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:$cast_event_reveal_top}, ...$cast_event_take_observed, ...$search_shuffle_remainder]} */
cast_event_reveal_take_shuffle ::= cast_event_reveal_top "." cast_event_take_observed "." "then" search_shuffle_remainder "."

/* Capture the defined quantity before a bounded observation and its continuation. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:BindValue{value:$value}}, Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:BoundValue(@prior), from:Top}}}, ...$look_captured_follow]} */
program_look_captured_follow ::= "look" "at" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" value "." look_captured_follow

look_captured_follow ::= look_put_any_shuffle | captured_top_choice_rest

/* The selection and movement share the observed cards and destination. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$search_filter_many}, count:AnyNumber, constraints:[CanMoveTo{destination:$dig_destination}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
look_put_any_shuffle ::= "you" "may" "put" "any" "number" "of" search_filter_many "from" "among" "them" dig_destination "." "then" "shuffle"

/* The shuffle and draw are separate phases, with each draw counting that player's shuffle. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Union([Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}, Zone{scope:Shared(Battlefield), kind:Permanent, filter:OwnedBy(One(Bound(0)))}]), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}}, ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(Bound(0)), amount:Earlier{what:Shuffled, measure:Count, by:Bound(0)}}}]}}] */
clause_shuffle_hand_owned_permanents_draw ::= players_singular "shuffles" "all" "cards" "from" "their" "hand" "and" "all" "permanents" "they" "own" "into" "their" "library" "," "then" "draws" "that" "many" "cards"

/* Each player's choice and arrival controller refer to that same player. */
/* @sem Instruction::[ForEachPlayer{players:$hand_entry_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:$card_filter}, count:AnyNumber}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}] */
clause_each_any_hand_entry ::= hand_entry_players "may" "put" "any" "number" "of" card_filter "cards" "from" "their" "hand" "onto" "the" "battlefield"

/* Continue the two-phase shuffle with the next sentence. */
/* @prefer always */
/* @sem Instruction::[...$clause_shuffle_hand_owned_permanents_draw, ...$instructions] */
instructions_shuffle_hand_owned_permanents_draw ::= clause_shuffle_hand_owned_permanents_draw "." instructions

/* Both conditional branches retain their own reveal, selection, and move receipts. */
/* @sem Vec<Instruction>::@unlabelled_instructions($dig_conditional_reveal_selection_paragraph) */
dig_conditional_reveal_selection ::= dig_conditional_reveal_selection_paragraph

/* @sem Ability::@optional_ability_label(Spell{announcement:@announcement, body:Program{instructions:[If{condition:$dig_conditional_test, then:Program{instructions:[Effect{result:@next, operation:$reveal_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:@agree($a_card, $search_filter_many)}, count:UpTo($count), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:$top_reveal_graveyard, qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:$reveal_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:@agree($a_card, $search_filter_many)}, count:UpTo(Expr::@agree(Constant(1), $number)), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:$top_reveal_graveyard, qualifiers:[]}}]}}]}}, $spell_paragraph_break) */
dig_conditional_reveal_selection_paragraph ::= reveal_top "." "you" "may" "put" a_card "from" "among" "them" "into" "your" "hand" "." "put" "the" "rest" top_reveal_graveyard "." spell_paragraph_break "if" dig_conditional_test "," "put" "up" "to" count search_filter_many "from" "among" "the" "revealed" "cards" "into" "your" "hand" "instead" "of" number

dig_conditional_test ::= dig_conditional_graveyard_union | condition

/* @prefer always */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AnyOf([$card_word, $card_word_2])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}} */
dig_conditional_graveyard_union ::= "there" "are" count "or" "more" card_word "and" "/" "or" card_word "cards" "in" "your" "graveyard"

/* The reveal, selected movement, and remainder exile share one observation.
   The life count is scoped to that exile's departure receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$reveal_loss_filter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$reveal_loss_filter}, destination:$until_destination, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:$reveal_loss_remainder, qualifiers:[]}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:CountObjects(Transition{result:@prior, phase:Before})}}] */
reveal_move_exile_loss ::= reveal_until_your_library reveal_loss_filter "," "then" "put" "that" "card" until_destination "." reveal_loss_remainder "," "and" "you" "lose" "1" "life" "for" "each" "of" "the" "exiled" "cards"

/* @sem ObjectFilter::Chosen(CardName) */
reveal_loss_chosen_name ::= "a" "card" "with" "that" "name"

reveal_loss_filter ::= reveal_loss_chosen_name | reveal_until_single_card

/* @sem MovementDestination::Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}} */
reveal_loss_remainder_up ::= "exile" "all" "other" "cards" "revealed" "this" "way"

/* @sem MovementDestination::Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}} */
reveal_loss_remainder_down ::= "exile" "all" "other" "cards" "revealed" "this" "way" "face" "down"

reveal_loss_remainder ::= reveal_loss_remainder_up | reveal_loss_remainder_down

/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$choose_a_card_name}, ...$reveal_move_exile_loss]}} */
spell_choose_name_reveal_exile_loss ::= choose_a_card_name "." reveal_move_exile_loss "."

/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$discard_chosen_name, count:$count_plural}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$discard_chosen_name}, destination:$until_destination, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:$reveal_loss_remainder, qualifiers:[]}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:CountObjects(Transition{result:@prior, phase:Before})}}] */
reveal_move_exile_loss_plural ::= reveal_until_your_library count_plural discard_chosen_name "," "then" "put" "those" "cards" until_destination "." reveal_loss_remainder "," "and" "you" "lose" "1" "life" "for" "each" "of" "the" "exiled" "cards"

/* @sem Ability::Spell{announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$choose_a_card_name}, ...$reveal_move_exile_loss_plural]}} */
spell_choose_name_reveal_exile_loss_plural ::= choose_a_card_name "." reveal_move_exile_loss_plural "."

/* The search selection is revealed before the opponent chooses; both destinations
   retain the opponent's choice as their selection receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_distinct_partition_choice]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, ...$search_opponent_graveyard_hand] */
clause_search_opponent_graveyard_hand ::= "search" "your" "library" "for" search_distinct_partition_choice "and" "reveal" "them" "." search_opponent_graveyard_hand

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:OneOf(OpponentsOf(AbilityController)), objects:Selected(@marked), count:AsManyAsCan($count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersGraveyard(CardArrival{}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Unselected(@back(3)), destination:OwnersHand(CardArrival{}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
search_opponent_graveyard_hand ::= "an" "opponent" "chooses" count "of" "those" "cards" "." "put" "the" "chosen" "cards" "into" "your" "graveyard" "and" "the" "rest" "into" "your" "hand" "." "then" "shuffle"

/* The reveal, optional entry and fallback all refer to the same top card.
   Keeping the three actions together prevents an anaphor from escaping its producer. */
/* @sem Operation::MoveTopCard{actor:One(AbilityController), cards:$reveal_entry_card_filter, reveal:false, destination:$top_card_battlefield} */
reveal_optional_entry_move ::= "you" "may" "put" "that" "card" top_card_battlefield "if" "it's" "a" reveal_entry_card_filter

/* @sem ObjectFilter::@and($card_filter, $modifier_mana_value_numeric) */
reveal_entry_card_filter ::= card_filter "card" modifier_mana_value_numeric

/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$reveal_optional_entry_move}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{}}] */
instructions_reveal_optional_entry_fallback ::= "reveal" "the" "top" "card" "of" "your" "library" "." reveal_optional_entry_move "." "otherwise" "," "put" "that" "card" "into" "your" "hand"

/* A relative mana-value restriction compares the qualifying card with the named object. */
/* @prefer always */
/* @sem ObjectFilter::AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}}]) */
a_card_lesser_mana ::= "a" filter_phrase "card" "with" "lesser" "mana" "value"

relative_seek_card ::= a_card_lesser_mana | an_card_lesser_mana

/* A relative seek is kept inside its cast-spell trigger, which supplies the event subject. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$relative_seek_card}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:@seek_move_result(Operation::Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]})}] */
clause_seek_relative_card ::= "seek" relative_seek_card

/* The second move uses the singular arrival from this seek. */
/* @prefer always */
/* @sem Instruction::[...$clause_seek_relative_card, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
clause_seek_card_then_battlefield ::= clause_seek_relative_card "," "then" "put" "it" "onto" "the" "battlefield"

/* @prefer always */
/* @sem Ability::Triggered{event:$relative_cast_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[...$clause_seek_card_then_battlefield]}} */
triggered_seek_card_then_battlefield ::= relative_cast_clause "," clause_seek_card_then_battlefield "."

relative_cast_clause ::= relative_cast_whenever

/* @prefer recurs */
/* @sem $event_cast */
relative_cast_whenever ::= "whenever" event_cast

/* @sem ObjectFilter::AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}}]) */
an_card_lesser_mana ::= "an" filter_phrase "card" "with" "lesser" "mana" "value"

/* The remainder excludes the actual reordered selection from this look. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:$look_top_count}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@prior), end:Top, order:Chosen}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_look_return_some_graveyard ::= look_top "," "then" "put" look_top_count "of" "them" "back" "on" "top" "of" "your" "library" "in" "any" "order" "and" "the" "rest" "into" "your" "graveyard"

/* The total measures the enclosing event group, not a previous action receipt. */
/* @sem Expr::Aggregate{objects:EventGroup, property:$event_total_stat, aggregation:Sum} */
event_group_total ::= "their" "total" event_total_stat

/* @sem ObjectSet::Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$event_group_total, from:Top} */
event_total_top_library_cards ::= "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" event_group_total

/* @sem Operation::Move{objects:$event_total_top_library_cards, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_event_total_library_cards ::= "exile" event_total_top_library_cards

/* Keep the single-card exile and its later permission in one producer-consumer
   phrase, including the intervening optional payment. */
/* @sem CostPart::Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), AnyOf([$noun, $noun_2])])}, choose:Exactly(Constant(1))} */
exile_permission_other_pair_cost ::= "sacrifice" "another" noun "or" noun

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$exile_top_card_named}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[$exile_permission_other_pair_cost]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@back(3), phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:$exiled_play_action, filter:Any}, terms:_{cost:Normal, spend_as:AnyType}})], duration:$this_duration, evaluation:LiveObjects}}]}, otherwise:_{}}]} */
program_exile_top_pay_for_permission ::= exile_top_card_named "." "then" "you" "may" exile_permission_other_pair_cost "." "if" "you" "do" "," "you" "may" exiled_play_action "the" "exiled" "card" this_duration "," "and" "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "it"

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$program_exile_top_pay_for_permission} */
triggered_exile_top_pay_for_permission ::= event_clause "," program_exile_top_pay_for_permission "."

/* @sem $look_put_then_body */
clause_look_put_hand_then ::= ("you")? look_put_then_body

/* The continuation is scoped to the immediately preceding look at your library. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($value), constraints:[CanMoveTo{destination:OwnersGraveyard(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Top, order:Chosen}}] */
looked_put_graveyard ::= "put" value "of" "them" "into" "your" "graveyard"

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$looked_put_graveyard] */
clause_look_put_graveyard ::= look_top "," "then" looked_put_graveyard

/* The revealed slice, opponent's selection, exile, and hand remainder share
   the same observation and transition receipts. */
/* @sem Instruction::[Effect{result:@next, operation:$reveal_top}, Effect{result:@next, operation:ChooseObjects{player:OneOf(OpponentsOf(AbilityController)), objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:$adjective_nontype}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
reveal_opponent_exile_hand_partition ::= reveal_top "." "an" "opponent" "exiles" "a" adjective_nontype "card" "from" "among" "them" "," "then" "you" "put" "the" "rest" "into" "your" "hand"

/* Keep the casting actor and card bound to that specific partition. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$reveal_opponent_exile_hand_partition, Optional{decider:Performer(1), body:_{instructions:[Effect{result:@next, operation:PlayCards{actor:One(Performer(1)), action:CastSpell, cards:One(Result{result:2, phase:After, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}]}} */
spell_reveal_opponent_exile_hand_cast ::= reveal_opponent_exile_hand_partition "." "that" "opponent" "may" "cast" "the" "exiled" "card" "without" "paying" "its" "mana" "cost" "."

/* Two separate filters are sought once each; neither filter determines the other. */
/* @sem Instruction::[Effect{result:@next, operation:Seek{actor:One(AbilityController), cards:[$filter_phrase, $adjective_nontype], count:Constant(1)}}] */
clause_seek_distinct_pair ::= "seek" "a" filter_phrase "card" "and" "a" adjective_nontype "card"

/* The two branches retain their own independent selection operations. */
/* @sem Instruction::[If{condition:$condition_no_filtered_cards_hand, then:Program{instructions:$clause_seek_distinct_pair}, otherwise:Program{instructions:$clause_seek_cards}}] */
conditional_seek_pair_otherwise ::= "if" condition_no_filtered_cards_hand "," clause_seek_distinct_pair "." "otherwise" "," clause_seek_cards

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$conditional_seek_pair_otherwise}} */
spell_conditional_seek_pair ::= conditional_seek_pair_otherwise "."

/* A named player chooses cards from their own hand for their library. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:@that_player, objects:Zone{scope:Players{zone:Hand, players:One(@that_player)}, kind:Card, filter:Any}, count:AsManyAsCan($card_count_one)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
puts_own_hand_card_on_top ::= "puts" card_count_one "from" "their" "hand" "on" "top" "of" "their" "library"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:@that_player, objects:Zone{scope:Players{zone:Hand, players:One(@that_player)}, kind:Card, filter:Any}, count:AsManyAsCan($count_plural)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
puts_own_hand_cards_on_top ::= "puts" count_plural "cards" "from" "their" "hand" "on" "top" "of" "their" "library" "in" "any" "order"

/* @sem Instruction::[Effect{result:@next, operation:@apply($players_singular, $verb_operation_third)}, ...$puts_own_hand_card_on_top] */
clause_player_verb_and_hand_top_one ::= players_singular verb_operation_third "and" puts_own_hand_card_on_top

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:@apply($players_singular, $verb_operation_third)}, ...$puts_own_hand_cards_on_top] */
clause_player_verb_and_hand_top_many ::= players_singular verb_operation_third "and" puts_own_hand_cards_on_top

clause_player_verb_and_hand_top ::= clause_player_verb_and_hand_top_one | clause_player_verb_and_hand_top_many

/* The shared head supplies the stopping filter; its consumers must bind the
   observation and exile arrival together with every use of that receipt. */
/* @sem $card_filter */
exile_until_your_single_filter ::= "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" "a" card_filter "card"

/* @sem $value */
exiled_single_free_cast_limit ::= "you" "may" "cast" "it" "without" "paying" "its" "mana" "cost" "if" "that" "spell's" "mana" "value" "is" value "or" "less"

/* The stopping filter and both consumers refer to the same exile arrival. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:$exile_until_your_single_filter, count:Constant(1)}}, Effect{result:@mark, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:One(Query{objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$exile_until_your_single_filter}, index:0}), filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$exiled_single_free_cast_limit}}}, count:Exactly(Constant(1)), cost:Free}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@prior)), then:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One(Query{objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$exile_until_your_single_filter}, index:0}), zone:Exile}, destination:$until_destination, qualifiers:[]}}]}, otherwise:Program{}}] */
instructions_exile_until_bounded_cast_or_move ::= exile_until_your_single_filter "." exiled_single_free_cast_limit "." "if" "you" "don't" "," "put" "that" "card" until_destination

/* The limit applies to the qualified permanent branch of this union. */
/* @sem ObjectFilter::AnyOf([$noun, AllOf([$quality_unscoped, AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]), Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}])]) */
choice_type_or_qualified_permanent ::= noun "and" "/" "or" quality_unscoped "permanent" "cards" "with" "mana" "value" number "or" "less"

/* The choice and remainder share the observation and the actual move receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$choice_type_or_qualified_permanent}, count:AnyNumber, constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
dig_look_choice_entry_graveyard ::= look_top "." "you" "may" "put" "any" "number" "of" choice_type_or_qualified_permanent "from" "among" "them" "onto" "the" "battlefield" "." "put" "the" "rest" "into" "your" "graveyard"

/* Separate anaphors keep their own spelling and expose their independent counts. */
/* @sem $number */
conditional_hand_those ::= "put" number "of" "those" "cards" "into" "your" "hand"

/* @sem $number */
conditional_hand_them ::= "put" number "of" "them" "into" "your" "hand"

/* Each branch carries the same observation and its own selected-card receipt.
   The condition reads the battlefield and is unaffected by looking. */
/* @sem Instruction::[If{condition:$condition_control_more_each_other, then:_{instructions:[Effect{result:@next, operation:$look_top_spelled_count}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@prior), zone:Library}, count:AsManyAsCan($conditional_hand_those), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Chosen}}]}, otherwise:_{instructions:[Effect{result:@next, operation:$look_top_spelled_count}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@prior), zone:Library}, count:AsManyAsCan($conditional_hand_them), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Chosen}}]}}] */
dig_look_conditional_choice ::= look_top_spelled_count "." "if" condition_control_more_each_other "," conditional_hand_those "." "otherwise" "," conditional_hand_them "." "then" "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "any" "order"

/* Both alternatives describe cards selected from the immediately preceding mill. */
/* @sem ObjectFilter::AnyOf([$filter_phrase, $filter_phrase_2]) */
mill_take_either_card ::= ("a" | "an") filter_phrase "card" "or" filter_phrase "card"

/* @sem () */
mill_take_origin_cards_milled ::= "from" "among" "the" "cards" "milled" "this" "way"

/* A single observed library card supplies both the intervening damage and
   the later test. The mark stays on the reveal across the damage result. */
/* @sem Instruction::[Effect{result:@mark, operation:$player_reveals_single_top}, Effect{result:@next, operation:$observed_card_value_damage}, If{condition:$observed_card_kind_test, then:$program, otherwise:Program{}}] */
instructions_reveal_value_damage_test ::= player_reveals_single_top "." observed_card_value_damage "." "if" observed_card_kind_test "," program

/* @sem Operation::DealDamage{source:$self_ref, recipients:Union([Players(One($that_player)), Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun, ControlledBy(One($that_player))])})]), amount:ObjectProperty{object:Query{objects:Observed(@marked), index:0}, property:ManaValue, information:CurrentOrLastKnown}, preventable:true} */
observed_card_value_damage ::= self_ref "deals" "damage" "equal" "to" "the" "revealed" "card's" "mana" "value" "to" that_player "and" "each" noun "that" "player" "controls"

/* @sem Condition::Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$filter_phrase}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}} */
observed_card_kind_test ::= "a" filter_phrase "card" "is" "revealed" "this" "way"

/* @sem Operation::Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:Constant(1), from:Top}} */
player_reveals_single_top ::= player_ref "reveals" "the" "top" "card" "of" "their" "library"

/* The test and cast branch are restricted to the immediately preceding top-card reveal. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$revealed_shared_type_filter}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:$revealed_top_cast_declined}, otherwise:Program{}}] */
instructions_reveal_shared_type_cast ::= "reveal" "the" "top" "card" "of" "your" "library" "." "if" "it's" revealed_shared_type_filter "," revealed_top_cast_declined

/* @sem ObjectFilter::AllOf([$card_filter, SharesWithAny{property:CreatureTypes, with:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase}}]) */
revealed_shared_type_filter ::= "a" card_filter "card" "that" "shares" "a" "creature" "type" "with" "a" filter_phrase

/* The cast payment and its declined continuation share the same result. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, count:Exactly(Constant(1)), terms:_{cost:Free}}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:$revealed_top_cast_decline}, otherwise:Program{}}] */
revealed_top_cast_declined ::= "you" "may" "cast" "it" "without" "paying" "its" "mana" "cost" "." "if" "you" "don't" "cast" "it" "," revealed_top_cast_decline

revealed_top_cast_decline ::= top_reveal_put | independent_top_continuation

/* A name comparison consumes the immediately preceding single-card observation. */
/* @sem ObjectFilter::SharesNameWithAny(Zone(_{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$a_card})) */
revealed_name_in_graveyard ::= "it" "has" "the" "same" "name" "as" a_card "in" "your" "graveyard"

/* Branches retain either the observation or their independently parsed operands. */
reveal_name_branch ::= reveal_name_observed_branch | program

/* @prefer always */
/* @sem Program::Program{instructions:$observed_top_reveal_branch} */
reveal_name_observed_branch ::= observed_top_reveal_branch

/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$revealed_name_in_graveyard}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:$reveal_name_branch, otherwise:$reveal_name_branch_2}] */
instructions_top_reveal_name_branch ::= "reveal" "the" "top" "card" "of" "your" "library" "." "if" revealed_name_in_graveyard "," reveal_name_branch "." "otherwise" "," reveal_name_branch

/* The singular seek's moved card receives the quoted cost reduction. */
/* @sem Instruction::[...$clause_seek_card, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:[GrantAbility(Casting(ReduceCost([_{amount:$braced_number}])))]}}] */
seek_card_perpetual_cost ::= clause_seek_card "." "it" "perpetually" "gains" '"' "this" "spell" "costs" braced_number "less" "to" "cast" "." '"'

/* Search choices can describe a card by its type and lack of abilities. */
/* @sem ObjectFilter::AllOf([$filter_phrase, $modifier_no_abilities]) */
search_filter_no_abilities ::= filter_phrase "card" modifier_no_abilities

/* The graveyard receipt and its consumer stay together in both directions. */
/* @sem Instruction::[...$look_hand_rest_grave, $look_grave_max_life] */
dig_hand_grave_max_life ::= look_hand_rest_grave "." look_grave_max_life

/* @sem Instruction::Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:Aggregate{objects:Matching{objects:Transition{result:@prior, phase:After}, filter:$noun}, property:Power, aggregation:Maximum}}} */
look_grave_max_life ::= "you" "gain" "life" "equal" "to" "the" "greatest" "power" "among" noun "cards" "put" "into" "your" "graveyard" "this" "way"

/* A looked-at slice is split between its owner's hand and graveyard. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top_spelled_count}, ...$look_hand_grave_tail] */
look_hand_rest_grave ::= look_top_spelled_count "." look_hand_grave_tail

/* @sem Instruction::[...$look_choose_them_hand, $look_rest_grave_and] */
look_hand_grave_tail ::= look_choose_them_hand look_rest_grave_and

/* @sem Instruction::Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}} */
look_rest_grave_and ::= "and" "the" "rest" "into" "your" "graveyard"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($number), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
look_choose_them_hand ::= "put" number "of" "them" "into" "your" "hand"

/* @sem MovementDestination::Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
owner_shuffled_library ::= "into" "their" "library"

/* Relative depth is a position independent of the moved object. */
/* @sem LibraryPosition::FromTop(Add($card_count, Constant(1))) */
library_position_beneath_top ::= "just" "beneath" "the" "top" card_count "of" "that" "library"

/* @sem Operation::Move{objects:$affected, destination:Library{position:$library_position_beneath_top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
put_owner_library_relative ::= "put" affected "into" "its" "owner's" "library" library_position_beneath_top

/* The defined quantity is a live total; the library belongs to the acting player. */
/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:$players_singular}, kind:Card, filter:Any}, count:$value_total_population, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
player_exiles_top_defined_total ::= players_singular "exiles" "the" "top" "X" "cards" "of" "their" "library" "," "where" "X" "is" value_total_population

/* The selected single card is exiled, and its actual arrival can be named later. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_filtered]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
clause_search_single_exile_shuffle ::= "search" "your" "library" "for" search_choice_filtered "," "exile" "that" "card" "," "then" "shuffle"

/* @sem ObjectFilter::@and($card_filter, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}) */
search_filter_mana_ceiling ::= card_filter "card" "with" "mana" "value" "less" "than" "or" "equal" "to" value

/* The free cast refers to the same singular exile arrival produced by the search. */
/* @sem Instruction::[...$clause_search_single_exile_shuffle, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$cast_searched_exile_free}]}}] */
instructions_search_single_exile_cast ::= clause_search_single_exile_shuffle "." "you" "may" cast_searched_exile_free

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Result{result:@marked, phase:After, index:0}), count:Exactly(Constant(1)), cost:Free} */
cast_searched_exile_free ::= "cast" "that" "card" "without" "paying" "its" "mana" "cost"

/* @sem Operation::Move{objects:$library_depth_objects, destination:Library{position:FromTop($library_depth), order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
put_owners_library_depth_base ::= "put" library_depth_objects "into" library_depth_owner "library" library_depth "from" "the" "top" /* @prefer always */

/* The attached permanent retains the number of cards above it as an offset. */
/* The observation and the selected cards share the same receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_at_top_x_cards}, ...$defined_look_selection] */
/* @prefer always */
look_defined_selection ::= look_at_top_x_cards "." defined_look_selection

defined_look_selection ::= defined_look_those_cards | look_put_split

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($look_count), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:$look_rest}] */
/* @prefer always */
defined_look_those_cards ::= "put" look_count "of" "those" "cards" "into" "your" "hand" "and" look_rest

/* An unshuffled search moves its selected card under the searcher's control. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_filtered]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
search_and_put_unshuffled ::= "search" "your" "library" "for" search_choice_filtered "and" "put" "it" "onto" "the" "battlefield"

/* The optional searches and their follow-up share one loop receipt. Reaching
   the move immediately follows the search even when the selection is empty. */
/* @sem Instruction::[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@next, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[$search_choice_filtered]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}]}}, Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:$filter_phrase, count:UpTo(CountPlayers(Matching{binding:0, condition:PlayerTook{player:Bound(0), result:@marked}}))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:Union([One(AbilityController), Matching{binding:0, condition:PlayerTook{player:Bound(0), result:@marked}}])}}] */
opponents_search_then_count ::= "each" "opponent" "may" "search" "their" "library" "for" search_choice_filtered "and" "put" "it" "onto" "the" "battlefield" "." "for" "each" "opponent" "who" "searches" "a" "library" "this" "way" "," "search" "your" "library" "for" "a" filter_phrase "card" "and" "put" "it" "onto" "the" "battlefield" "." "then" "each" "player" "who" "searched" "a" "library" "this" "way" "shuffles"

/* @sem Instruction::[...$search_and_put_unshuffled, ...$opponents_search_then_count] */
search_with_opponent_searches ::= search_and_put_unshuffled "." opponents_search_then_count

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$search_with_opponent_searches}} */
search_with_opponent_searches_spell ::= search_with_opponent_searches "."

/* The damaged player owns the library; the source creature's controller acts.
   Both queries name the same card, and the permission consumes its exile arrival. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:ControllerOf(EventSubject), objects:$damaged_opponent_top}}, Effect{result:@mark, operation:Move{objects:$damaged_opponent_top, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, ...$damage_source_controller_play_exiled] */
damage_source_controller_look_exile_play ::= "its" "controller" "looks" "at" damaged_opponent_top "and" "exiles" "it" "face" "down" "." damage_source_controller_play_exiled

/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One(EventSubject)}, kind:Card, filter:Any}, count:Constant(1), from:Top} */
damaged_opponent_top ::= "the" "top" "card" "of" "that" "opponent's" "library"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(ControllerOf(EventSubject))), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:$exiled_play_action, filter:Any}, terms:_{cost:Normal, spend_as:AnyType}})], duration:WhileExiled(Result{result:@marked, phase:After, index:0}), evaluation:LiveObjects}}] */
damage_source_controller_play_exiled ::= "they" "may" exiled_play_action "that" "card" "for" "as" "long" "as" "it" "remains" "exiled" "." "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "a" "spell" "this" "way"

/* The body requires a source-recipient combat event with an opponent recipient. */
/* @sem Ability::Triggered{event:$event_combat_damage_one_opponent, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$damage_source_controller_look_exile_play}} */
damage_opponent_controller_library_trigger ::= "whenever" event_combat_damage_one_opponent "," damage_source_controller_look_exile_play "."

/* The two piles consume the same observed library population, with the
   remaining cards evaluated after the first move. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$observed_exile_face_piles, Effect{result:@next, operation:$defender_choose_exile_pile_hand}] */
observed_exile_face_piles_group ::= look_top "." observed_exile_face_piles "." defender_choose_exile_pile_hand

/* @sem Instruction::[Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:InZone{objects:Observed(@marked), zone:Library}, count:AnyNumber, constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[ExilePile{shuffled:false}]}}, qualifiers:[]}}}, Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[ExilePile{shuffled:false}]}}, qualifiers:[]}}] */
observed_exile_face_piles ::= "exile" "any" "number" "of" "them" "in" "a" "face-down" "pile" "and" "the" "rest" "in" "a" "face-up" "pile"

/* @sem Operation::ChoosePile{actor:One($defending_player), then:OwnersHand} */
defender_choose_exile_pile_hand ::= defending_player "chooses" "one" "of" "those" "piles" "." "put" "that" "pile" "into" "your" "hand"

/* Party classes and another eligible subtype are independent filter operands. */
/* @prefer always */
/* @sem ObjectFilter::AnyOf([$subtype, Subtype(Cleric), Subtype(Rogue), Subtype(Warrior), Subtype(Wizard)]) */
search_party_union_cards ::= "Cleric" "," "Rogue" "," "Warrior" "," "Wizard" "," "and" "/" "or" subtype "cards"

/* The searched card's value refers to the entering Aura; the distinct-name
   population is an independent controlled permanent filter. */
/* @prefer always */
/* @sem SearchChoice::SearchChoice{filter:AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}}, Not(SharesNameWithAny(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$filter_phrase_2, ControlledBy(One(AbilityController))])}))]), count:UpTo(Constant(1))} */
search_choice_event_cap_distinct_controlled ::= "an" filter_phrase "card" "with" "mana" "value" "less" "than" "or" "equal" "to" "that" "Aura" "and" "with" "a" "different" "name" "than" "each" filter_phrase "you" "control"

/* @prefer always */
/* @sem Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo($object_ref)]}}, qualifiers:[]} */
found_battlefield_attached_that_card ::= "put" "that" "card" "onto" "the" "battlefield" "attached" "to" object_ref

/* The comparison's anaphor is licensed by this Aura-entry event. */
/* @prefer always */
/* @sem Ability::Triggered{event:Player{event:EntersUnderControl, players:All, objects:AllOf([Subtype(Aura), ControlledBy(One(AbilityController))])}, intervening_if:ObjectMatches{object:EventSubject, filter:Cast{by:One(AbilityController)}}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_event_cap_distinct_controlled]}}, ...$aura_search_follow]}}]}} */
aura_entry_cast_capped_search ::= "whenever" "an" "Aura" "you" "control" "enters" "," "if" "you" "cast" "it" "," "you" "may" "search" "your" "library" "for" search_choice_event_cap_distinct_controlled aura_search_follow "."

/* @sem Instruction::[Effect{result:@next, operation:$found_battlefield_attached_that_card}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
aura_search_follow ::= "," found_battlefield_attached_that_card "," "then" "shuffle"

/* Keep the payment, counted library movement and permission together so the
   receipt and its exile destination are proved in both directions. */
/* @sem Instruction::[Effect{result:@next, operation:PayAnyAmount{actor:One(AbilityController), resource:Energy}}, If{condition:Compare{left:Performed(@last_result), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:_{instructions:[Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}, Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Performed(@back(3)), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:Either, cards:Transition{result:@prior, phase:After}, count:Exactly(Constant(1)), cost:Free}}]}}]}, otherwise:_{}}] */
instructions_energy_paid_exile_play ::= "pay" "any" "amount" "of" "{E}" "." "if" "you" "paid" "one" "or" "more" "{E}" "this" "way" "," "shuffle" "your" "library" "," "then" "exile" "that" "many" "cards" "from" "the" "top" "." "you" "may" "play" "one" "of" "those" "cards" "without" "paying" "its" "mana" "cost"

/* Two independent basic subtype choices, each retaining its own filter. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_basic_pair_choice, $search_basic_pair_choice_2]} */
search_library_basic_pair ::= "search" "your" "library" "for" search_basic_pair_choice "and" search_basic_pair_choice

/* @sem SearchChoice::SearchChoice{filter:AllOf([Supertype(Basic), $subtype]), count:UpTo(Constant(1))} */
search_basic_pair_choice ::= "a" "basic" subtype "card"

/* The selection from this search supplies both the reveal and the move. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_library_basic_pair}, ...$search_those_reveal_hand_follow] */
clause_search_pair_those ::= search_library_basic_pair "," search_those_reveal_hand_follow

/* The play permission consumes the immediately preceding library-exile receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_top_permission_producer}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@marked, phase:After}, origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:$exiled_cards_play_duration, evaluation:LiveObjects}}] */
clause_top_exile_play_those ::= exile_top_permission_producer "." exiled_cards_play_duration

exile_top_permission_producer ::= exile_top_cards_of_your_library | exile_top_defined_library
/* @sem Operation::Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$value, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_top_defined_library ::= "exile" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" value

/* The same one-card exile receipt supplies both the life amount and permission.
   Keep the producer in this phrase so the printed card is proved to be exiled. */
/* @sem Vec<Instruction>::[Effect{result:@mark, operation:$exile_top_card_receipt}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:$receipt_stat, information:CurrentOrLastKnown}}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:CastSpell, filter:Any}, terms:_{cost:Normal, spend_as:$exiled_spending}})], duration:$duration, evaluation:LiveObjects}}] */
exile_top_gain_and_cast ::= exile_top_card_receipt "." "you" "gain" "life" "equal" "to" "that" "card's" receipt_stat "." duration "," "you" "may" "cast" "that" "card" "and" exiled_spending

/* @sem Ability::Triggered{event:$event_combat_damage_player, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$exile_top_gain_and_cast}} */
triggered_combat_exile_gain_cast ::= "whenever" event_combat_damage_player "," exile_top_gain_and_cast "."

/* Random library selection and hand arrival with an independent comparison referent. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:ObjectProperty{object:$object_ref, property:ManaValue, information:CurrentOrLastKnown}}}}, count:AsManyAsCan($card_count), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_seek_same_mana ::= "seek" card_count "with" "the" "same" "mana" "value" "as" object_ref

/* The permission and its immediately preceding top-library exile are one
   receipt-scoped program; the inverse checks both actions together. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@prior, phase:After}, origins:CardPlayOrigins([Exile]), action:PlayLand, filter:Any}), PlayerRule(PlayPermission{cards:Transition{result:@prior, phase:After}, origins:CardPlayOrigins([Exile]), action:CastSpell, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}]} */
program_top_exile_play_those ::= exile_top_cards_of_your_library "." "you" "may" "play" "those" "cards" this_duration "."

/* A paid look and partition share the same observation and move receipts. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$pay_mana, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$look_paid_other_partition}, otherwise:Program{}}] */
clause_paid_look_hand_split ::= "you" "may" pay_mana "." "if" "you" "do" "," look_paid_other_partition

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$look_other_hand_split] */
look_paid_other_partition ::= look_top "." look_other_hand_split

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($look_hand_count), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:$hand_other_graveyard}] */
look_other_hand_split ::= "put" look_hand_count "into" "your" "hand" "and" hand_other_graveyard

/* The selected cards come from this mill payment, not an arbitrary prior receipt. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$mill_receipt_payment]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, filter:$mill_receipt_card_filter}, count:Exactly(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]}, otherwise:Program{}}]} */
program_optional_mill_receipt_hand ::= "you" "may" mill_receipt_payment "." "if" "you" "do" "," "you" "may" "put" mill_receipt_card_filter "card" "from" "among" "them" "into" "your" "hand"

/* @sem CostPart::Mill{count:$mill_receipt_amount} */
mill_receipt_payment ::= "mill" mill_receipt_amount

mill_receipt_amount ::= mill_cast_event_amount | card_count

/* @sem $milled_return_filter */
mill_receipt_card_a ::= "a" milled_return_filter

/* @sem ObjectFilter::CardType(Artifact) */
mill_receipt_card_artifact ::= "an" "artifact"

mill_receipt_card_filter ::= mill_receipt_card_a | mill_receipt_card_artifact

/* Keep the observed library slice, its two piles, the exiled pile and the
   remaining selection together. The remaining observed cards stay in the
   controller's library before that library is shuffled. */
/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:$player_ref, objects:$your_top}}, Effect{result:@next, operation:Piles{actor:One($player_ref), objects:InZone{objects:Observed(@marked), zone:Library}, count:Constant(2), names:['face down', 'face down']}}, Effect{result:@next, operation:$choose_pile_destination}, Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:InZone{objects:Observed(@marked), zone:Library}, count:Exactly(Constant(1)), constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_observed_pile_search_shuffle ::= player_ref "looks" "at" your_top "and" "separates" "them" "into" "two" "face-down" "piles" "." choose_pile_destination "." "search" "the" "other" "pile" "for" "a" "card" "," "put" "it" "into" "your" "hand" "," "then" "shuffle" "the" "rest" "of" "that" "pile" "into" "your" "library"

/* The other card is the remainder of this exact two-card observation. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top_two}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:OwnersGraveyard(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Top, order:Chosen}}] */
look_two_graveyard_other_top ::= look_top_two "." "put" "one" "of" "them" "into" "your" "graveyard" "and" "the" "other" "back" "on" "top" "of" "your" "library"

/* Keep the mill and the chosen arrival receipt together for both directions. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Mill{players:One(AbilityController), amount:$number}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@back(3), phase:After}, filter:$noun}, count:Exactly(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]}}}, If{condition:Not(PaymentChosen(@back(3))), then:$then_condition_program, otherwise:_{}}]} */
program_mill_receipt_hand_failure ::= "mill" number "cards" "." "put" "a" noun "card" "from" "among" "the" "milled" "cards" "into" "your" "hand" "." "if" "you" "can't" "," then_condition_program

/* The two type tests partition a single revealed top card. The second branch
   only moves that same top card, so an empty library leaves both branches inert. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:Not(CardType(Land))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:$top_reveal_nonland_action}, otherwise:Program{instructions:$observed_top_reveal_put}}] */
top_reveal_nonland_land_split ::= "reveal" "the" "top" "card" "of" "your" "library" "." "if" "it's" "a" "nonland" "card" "," top_reveal_nonland_action "." "if" "it's" "a" "land" "card" "," observed_top_reveal_put

/* An alternate payment casts the one card whose reveal encloses this branch. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, count:Exactly(Constant(1)), terms:_{cost:Alternate(Cost($cost))}}}]}}] */
top_reveal_nonland_action ::= "you" "may" "cast" "it" "by" "paying" cost "rather" "than" "paying" "its" "mana" "cost"

/* The exile producer and its loop are kept together so the receipt has a proved destination. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:Move{objects:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:PerPlayer{players:All, each:UpTo(Constant(1))}, filter:@agree($filter_plural, $filter_phrase)})), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, ForEachObject{objects:Transition{result:@marked, phase:After}, binding:0, body:$bound_controller_reveal_bottom_program}]}} */
spell_exile_distinct_controllers_reveal_bottom ::= "exile" "any" "number" "of" "target" filter_plural "controlled" "by" "different" "players" "." "for" "each" filter_phrase "exiled" "this" "way" "," bound_controller_reveal_bottom_program "."

/* One controller reveals a matching card and puts the remainder on the bottom. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:RevealUntil{library:ControllerOf(Bound(0)), filter:$filter_phrase, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$filter_phrase}, destination:Battlefield{controller:Player(ControllerOf(Bound(0))), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:ControllerOf(Bound(0)), library_owner:ControllerOf(Bound(0)), objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Random}}]} */
bound_controller_reveal_bottom_program ::= "its" "controller" "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" "a" filter_phrase "card" "," "puts" "that" "card" "onto" "the" "battlefield" "," "then" "puts" "the" "rest" "on" "the" "bottom" "of" "their" "library" "in" "a" "random" "order"

/* The controller test refers to the chosen permanent move; the remainder is
   selected only from the exile arrivals of the reveal immediately before it. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:$each_player_distinct_negative_targets, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, ForEachPlayer{players:Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:ControlledBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}, binding:0, body:Program{instructions:[Effect{result:@next, operation:RevealUntil{library:Bound(0), filter:$adjective_nontype, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}, ForEachPlayer{players:Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:ControlledBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Matching{objects:Transition{result:@prior, phase:After}, filter:Not($adjective_nontype)}, zone:Exile}, destination:Library{position:BottomRandom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
clause_each_player_shuffle_exile_until ::= each_player_distinct_negative_targets "." "those" "permanents'" "owners" "shuffle" "them" "into" "their" "libraries" "." "each" "player" "who" "controlled" "one" "of" "those" "permanents" "exiles" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "exile" "a" adjective_nontype "card" "," "then" "puts" "the" "rest" "on" "the" "bottom" "of" "their" "library" "in" "a" "random" "order"

/* The same filter governs both the stopping condition and the moved card. */
/* @sem ObjectFilter::AllOf([$card_filter, Shares{property:CreatureTypes, with:$object_ref}]) */
reveal_until_shared_creature_type ::= "a" card_filter "card" "that" "shares" "a" "creature" "type" "with" object_ref

/* @sem ObjectFilter::AllOf([$card_filter, Shares{property:CreatureTypes, with:$object_ref}]) */
reveal_until_shared_creature_type_an ::= "an" card_filter "card" "that" "shares" "a" "creature" "type" "with" object_ref

/* The stopping filter and the selected exile arrival are one contract. */
exile_until_count_filter ::= card_filter | chosen_permanent_card_filter

/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:@agree($exile_until_count_filter, $exile_until_count_filter_2), count:$value_times_mutated}}, Effect{result:@next, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:One(Query{objects:Matching{objects:Transition{result:@prior, phase:After}, filter:@agree($exile_until_count_filter, $exile_until_count_filter_2)}, index:0}), zone:Exile}, destination:$until_destination, qualifiers:[]}}] */
instructions_exile_until_count_entry ::= "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" "X" exile_until_count_filter "cards" "," "where" "X" "is" value_times_mutated "." "put" "those" exile_until_count_filter "cards" until_destination

/* A sacrifice followed by an independent library-search instruction. */
/* @sem Instruction::[Effect{result:@next, operation:$sacrifice_objects}, ...$clause_search] */
sacrifice_comma_search ::= sacrifice_objects "," clause_search

/* Check the marked hand move after the option, including when the search was declined. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$search_single_library}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@mark, operation:Move{objects:Selected(@back(3)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}}, If{condition:Compare{left:CountObjects(Transition{result:@marked, phase:Before}), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}, then:Program{instructions:$clause}, otherwise:Program{}}] */
instructions_optional_search_hand_failure ::= "you" "may" search_single_library "," "reveal" "it" "," "put" "it" "into" "your" "hand" "," "then" "shuffle" "." "if" "you" "don't" "put" "a" "card" "into" "your" "hand" "this" "way" "," clause

/* The reveal, matching move and remaining cards share one observation and move receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$reveal_until_card, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$reveal_until_card}, destination:$until_destination, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
shared_reveal_until_entry_graveyard ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" reveal_until_card "." "put" "that" "card" until_destination "and" "put" "all" "other" "cards" "revealed" "this" "way" "into" "your" "graveyard"

/* A resolution payment governs the complete continuation. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$shared_exile_affected_payment]}, optional:true}}, If{condition:PaymentChosen(@marked), then:$shared_payment_reveal_continuation, otherwise:Program{}}] */
shared_optional_payment_if_done ::= "you" "may" shared_exile_affected_payment "." "if" "you" "do" "," shared_payment_reveal_continuation

shared_payment_reveal_continuation ::= shared_payment_reveal_graveyard | shared_payment_reveal_partition

/* @sem CostPart::Move{selections:[_{objects:$affected}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}} */
shared_exile_affected_payment ::= "exile" affected

/* One private-zone population moves before its controller shuffles. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Union([Zone(_{scope:Players{zone:$shuffle_own_zone, players:One(AbilityController)}, kind:Card, filter:Any})]), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
clause_shuffle_own_zone ::= "shuffle" "your" shuffle_own_zone "into" "your" "library"

/* The observed slice and the revealing player bind the subsequent choice and reorder. */
/* @sem Instruction::[Effect{result:@mark, operation:$player_reveals_top}, ...$revealed_choose_graveyard_rest] */
instructions_player_reveal_choose_rest ::= player_reveals_top "." revealed_choose_graveyard_rest

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:OneOf(One(AbilityController)), objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($number)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:@that_player, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Top, order:Chosen}}] */
revealed_choose_graveyard_rest ::= "you" "choose" number "of" "those" "cards" "and" "put" "them" "into" "that" "player's" "graveyard" "." "put" "the" "rest" "on" "top" "of" "their" "library" "in" "any" "order"

/* A looked-at selection and its two distinct battlefield arrivals. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:$dig_value_entry_choice}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Duplicate(One(Result{result:@prior, phase:After, index:0})), count:Constant(1), destination:Battlefield(BattlefieldArrival{tapped:false, counters:[], states:[]})}}, Effect{result:@next, operation:CreatePerpetualEffect{objects:One(Result{result:@prior, phase:After, index:0}), changes:$singular_base_stats}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(4), phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
dig_look_entry_duplicate ::= look_top "." dig_value_entry_choice "," "then" "conjure" "a" "duplicate" "of" "that" "card" "onto" "the" "battlefield" "." "the" "duplicate" "perpetually" singular_base_stats "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Operation::ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
dig_value_entry_choice ::= "you" "may" "put" "a" card_filter "card" "with" "mana" "value" value "or" "less" "from" "among" "them" "onto" "the" "battlefield"

/* The chosen filter remains a runtime choice, not a fixed card type. */
/* @sem ObjectFilter::ChosenFilter */
a_card_chosen_kind ::= "a" "card" "of" "the" "chosen" "kind"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:ChosenFilter}, count:$seek_plural_count, constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_seek_chosen_kind_plural ::= "seek" seek_plural_count "cards" "of" "the" "chosen" "kind"

/* Keep the mill producer with its filtered arrival receipt and the described
   face-down entry. The controller is the ability controller, not each owner. */
/* @sem Instruction::[Effect{result:@next, operation:Mill{players:$players_singular, amount:$milled_face_down_amount}}, Effect{result:@next, operation:Move{objects:Matching{objects:Recorded(@prior), filter:$filter_phrase}, destination:Battlefield{controller:Player(AbilityController), arrival:$milled_face_down_arrival}, qualifiers:[]}}] */
instructions_mill_face_down_arrival ::= players_singular "mills" milled_face_down_amount "." "put" "all" filter_phrase "cards" "milled" "this" "way" "onto" "the" "battlefield" milled_face_down_arrival

milled_face_down_amount ::= milled_face_down_cast_x | mill_cast_fixed_amount

/* @sem Expr::CastX(Source) */
milled_face_down_cast_x ::= "X" "cards"

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[], states:[FaceDownAs{power:$number_digits, toughness:$number_digits_2, creature_type:@subtype_name($subtype), artifact:true}]} */
milled_face_down_arrival ::= "face" "down" "under" "your" "control" "." "they're" number_digits "/" number_digits subtype "artifact" "creatures"

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$instructions_mill_face_down_arrival}} */
triggered_mill_face_down_arrival ::= event_clause "," instructions_mill_face_down_arrival "."

/* @sem ConjureDestination::Library{position:AmongTop($card_count), arrival:CardArrival{counters:[], states:[]}} */
conjure_top_library ::= "into" "the" "top" card_count "of" "your" "library" "at" "random"

/* The library move loop and permissions share the same exile arrival receipt. */
/* @sem Instruction::[ForEachPlayer{players:$pilot_library_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}, count:Constant(1), from:$ordered_end}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:Transition{result:@prior, phase:After}, audience:AffectedPlayer}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@prior, phase:After}, origins:CardPlayOrigins([Exile]), action:CastSpell, filter:$hidden_library_cast_filter}, terms:_{cost:Normal, spend_as:AnyColor}})], duration:WhileAnyExiled(Transition{result:@prior, phase:After}), evaluation:LiveObjects}}] */
face_down_library_cast_permission ::= "exile" "the" ordered_end "card" "of" pilot_library_players "library" "face" "down" "." "for" "as" "long" "as" "those" "cards" "remain" "exiled" "," "you" "may" "look" "at" "them" "," "you" "may" "cast" hidden_library_cast_filter "from" "among" "them" "," "and" "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "those" "spells"

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$face_down_library_cast_permission}} */
triggered_face_down_library_cast ::= "at" turn_event "," face_down_library_cast_permission "."

/* Permanent spells exclude nonpermanent spells; land remains a card type in the permission. */
/* @sem ObjectFilter::AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]) */
hidden_library_permanent_spells ::= "permanent" "spells"

/* @sem ObjectFilter::CardType(Creature) */
hidden_library_creature_spells ::= "creature" "spells"

hidden_library_cast_filter ::= hidden_library_permanent_spells | hidden_library_creature_spells

/* The two actions share the upkeep player and the singular mill receipt.  Keeping
   the producer in this program makes the mana-value aggregate printable only
   when it refers to this particular mill action. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Mill{players:One(EventSubject), amount:Constant(1)}}, Effect{result:@next, operation:CreateTokens{players:One(EventSubject), tokens:[TokenSpec{amount:Aggregate{objects:Transition{result:@prior, phase:After}, property:ManaValue, aggregation:Sum}, words:CreatingEffect, recipe:$paid_mana_plural_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]} */
upkeep_player_mill_mana_tokens_program ::= "that" "player" "mills" "a" "card" "." "then" "they" "create" "X" paid_mana_plural_token_recipe "," "where" "X" "is" "the" "milled" "card's" "mana" "value" "."

/* The named player decides the exile and owns the library. The permission
   consumes only the arrival receipt of this move, within the same choice. */
/* @sem Instruction::Optional{decider:$event_exile_player, body:Program{instructions:[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($event_exile_player)}, kind:Card, filter:Any}, count:$event_exile_count, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One($event_exile_player)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@marked, phase:After}, origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:UntilEndOfNextTurn($event_exile_player), evaluation:LiveObjects}}]}} */
optional_player_top_exile_play ::= event_exile_player "may" "exile" event_exile_count "cards" "from" "the" "top" "of" "their" "library" "." "they" "may" "play" "those" "cards" "until" "the" "end" "of" "their" "next" "turn"

/* @sem PlayerRef::ControllerOf(EventSubject) */
event_exile_controller ::= "its" "controller"

event_exile_player ::= event_exile_controller

/* @sem Expr::EventAmount */
event_exile_amount ::= "that" "many"

event_exile_count ::= event_exile_amount | count_plural

/* @sem Ability::Triggered{event:$event_dealt_damage_object, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[$optional_player_top_exile_play]}} */
triggered_damage_optional_top_play ::= "whenever" event_dealt_damage_object "," optional_player_top_exile_play "."

/* A cloak consumes the single hand arrival of the immediately preceding seek. */
/* @sem Program::Program{instructions:[...$clause_seek_card, Effect{result:@next, operation:Manifest{actor:One(AbilityController), source:Cards(One(Result{result:@prior, phase:After, index:0})), cloak:true, entry:_{}}}]} */
program_seek_cloak_shared ::= clause_seek_card "and" "cloak" "it" "."

/* The opponent's whole graveyard remains distinct from the earlier mill receipt. */
/* @sem Vec<Instruction>::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Graveyard, players:One(Target{slot:@last_slot, index:0})}, kind:Card, filter:AllOf([$adjective_nontype, $adjective_nontype_2])}), count:UpTo(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
opponent_graveyard_exile_one_pair ::= "exile" "up" "to" "one" adjective_nontype "," adjective_nontype "card" "from" "that" "player's" "graveyard"

/* This permission refers to the immediately preceding single exile arrival. */
/* @sem Instruction::Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:CastSpell, filter:Any}, terms:_{during:One(AbilityController), cost:Alternate(Cost{parts:[WaterbendX{mana:[X], x:Earlier{what:It, measure:Of(ManaValue)}}]})}})], duration:$while_you_control, evaluation:LiveObjects}} */
exiled_one_waterbend_permission ::= while_you_control "," "you" "may" "cast" "the" "exiled" "card" "during" "your" "turn" "by" "waterbending" "{" "X" "}" "rather" "than" "paying" "its" "mana" "cost" "," "where" "X" "is" "its" "mana" "value"

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:_{instructions:[$target_opponent_mill_cards, ...$opponent_graveyard_exile_one_pair, $exiled_one_waterbend_permission]}} */
trigger_opponent_mill_graveyard_exile_permission ::= event_clause "," target_opponent_mill_cards "." opponent_graveyard_exile_one_pair "." exiled_one_waterbend_permission "."

/* The comparison applies to the stopped-on exile receipt; the alternative move
   is conditional on that comparison failing, and keeps the actual receipt. */
/* @sem Instruction::If{condition:ObjectMatches{object:@exiled_card_reference, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:$stat_comparison, value:$value}}}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(@exiled_card_reference), count:Exactly(Constant(1)), cost:Free}}]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One(@exiled_card_reference), zone:Exile}, destination:OwnersHand(CardArrival{}), qualifiers:[]}}]}} */
exiled_card_cast_value_otherwise_hand ::= "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" "if" "the" "spell's" "mana" "value" "is" stat_comparison value "." "otherwise" "," "put" "it" "into" "your" "hand"

/* @sem Instruction::[...$clause_exile_until_card, $exiled_card_cast_value_otherwise_hand] */
exile_until_cast_value_otherwise_hand ::= clause_exile_until_card "." exiled_card_cast_value_otherwise_hand

/* The search receipt is the antecedent for both mutually exclusive moves. */
/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Selected(@marked), filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}} */
searched_value_route ::= "put" "it" "onto" "the" "battlefield" "if" "its" "mana" "value" "is" value "or" "less" "." "otherwise" "," "put" "it" "into" "your" "hand"

/* Search, reveal and routing retain the same singular search selection. */
/* @sem Instruction::[...$search_single_reveal_it, $searched_value_route, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
clause_search_reveal_value_route ::= search_single_reveal_it "." searched_value_route "." "if" "you" "search" "your" "library" "this" "way" "," "shuffle"

/* One look can enumerate a targeted player's hand, library top, and a
   separately described population. The population retains its own filters. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One($target_possessive)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One($target_possessive)}, kind:Card, filter:Any}, count:$top_count, from:Top}}}, Effect{result:@next, operation:LookAt{player:AbilityController, objects:$affected}}] */
look_hand_library_population ::= "look" "at" target_possessive "hand" "," "the" "top" top_count "of" "that" "player's" "library" "," "and" "any" affected

/* @sem Instruction::[...$look_hand_library_population, ...$instructions] */
look_hand_library_population_more ::= look_hand_library_population "." instructions

/* Keep the reveal, move and remainder in one partition; the library owner and
   the controller who loses life are independent. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:$reveal_until_named_player, filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$card_filter}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:Earlier{what:Found, measure:Of($receipt_stat)}}}, Effect{result:@next, operation:ReorderLibrary{chooser:$reveal_until_named_player, library_owner:$reveal_until_named_player, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(3), phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
player_reveal_entry_value_remainder ::= reveal_until_named_player "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" "a" card_filter "card" "." "you" "put" "that" "card" "onto" "the" "battlefield" "under" "your" "control" "and" "lose" "life" "equal" "to" "that" "permanent's" receipt_stat "." "that" "player" "puts" "the" "rest" "of" "the" "revealed" "cards" "on" "the" "bottom" "of" "their" "library" library_order

/* Random colored library search bounded by a dynamic mana value. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:AllOf([Not(Colorless), $filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:$value}}]), count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}]} */
search_random_colored_lesser_mv ::= "search" "your" "library" "for" "a" "colored" filter_phrase "card" "chosen" "at" "random" "whose" "mana" "value" "is" "less" "than" value

/* The optional free play and declined bottom-of-library placement share the search selection. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_random_colored_lesser_mv}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:Either, cards:Selected(@marked), count:Exactly(Constant(1)), cost:Free, into_exile:false}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@prior)), then:Program{instructions:[Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@marked), end:Bottom, order:Chosen}}]}, otherwise:Program{}}] */
instructions_search_play_free_or_bottom ::= search_random_colored_lesser_mv "." "you" "may" "play" "that" "card" "without" "paying" "its" "mana" "cost" "." "if" "you" "don't" "," "put" "that" "card" "on" "the" "bottom" "of" "your" "library"

/* Singular defined token recipe without plural alternation for exact singular printing. */
/* token_recipe_defined_singular is shared as singular_counted_token_recipe. */

/* All three repeated top-library exile steps feed the nonland exiled-this-way token count. */
/* @sem Instruction::[Repeatable{instructions:[Effect{result:@next, operation:$exile_top_single_library_card}, Effect{result:@next, operation:$exile_top_single_library_card_2}, Effect{result:@next, operation:$exile_top_single_library_card_3}, If{condition:Not(ObjectMatches{object:Result{result:@last_result, phase:After, index:0}, filter:CardType(Land)}), then:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}]}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[_{amount:CountObjects(Matching{objects:Union([Transition{result:@back(5), phase:After}, Transition{result:@back(4), phase:After}, Transition{result:@back(3), phase:After}]), filter:Not(CardType(Land))}), words:CreatingEffect, recipe:$singular_counted_token_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
instructions_triple_exile_repeat_nonland_tokens ::= exile_top_single_library_card "." exile_top_single_library_card "." exile_top_single_library_card "." "if" "the" "last" "card" "exiled" "isn't" "a" "land" "card" "," "repeat" "this" "process" "." "create" "a" singular_counted_token_recipe "for" "each" "nonland" "card" "exiled" "this" "way"

/* Look at top cards, optionally reveal up to N matching cards, route them to battlefield or hand by condition, then shuffle. */
/* @sem Instruction::[Effect{result:@next, operation:$look_top}, Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:$filter_phrase}, count:UpTo($number_words)}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_look_reveal_conditional_battlefield_or_hand_shuffle ::= look_top "." "you" "may" "reveal" "up" "to" number_words filter_phrase "cards" "from" "among" "them" "." "if" condition "," "put" "the" "revealed" "cards" "onto" "the" "battlefield" "." "otherwise" "," "put" "the" "revealed" "cards" "into" "your" "hand" "." "then" "shuffle"

/* Optional library search whose conditional follow-up bottoms the source and shuffles only if the search occurred. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:$search_library}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:$search_option_entry}, qualifiers:[]}}, If{condition:Searched(@marked), then:Program{instructions:[Effect{result:@next, operation:Move{objects:One($self_ref_holder), destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:Program{}}]}}] */
instructions_may_search_put_if_searched_self_bottom_shuffle ::= "you" "may" search_library "and" "put" "it" search_option_entry "." "if" "you" "search" "your" "library" "this" "way" "," "put" self_ref_holder "on" "the" "bottom" "of" "its" "owner's" "library" "," "then" "shuffle"

/* Look at top cards, optionally reveal one bounded-mana-value card, optionally put it onto the battlefield if condition holds else hand, and reorder the rest on bottom. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])}, count:UpTo(Constant(1))}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, If{condition:Compare{left:CountObjects(Selected(@back(2))), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Selected(@back(3)), count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Selected(@back(5)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(3), phase:Before}, Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Move{objects:Selected(@back(7)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Transition{result:@prior, phase:Before}}, zone:Library}, end:Bottom, order:$library_order}}]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:$library_order}}]}}] */
instructions_look_reveal_mv_conditional_battlefield_or_hand_bottom ::= look_top "." "you" "may" "reveal" "a" filter_phrase "card" "with" "mana" "value" value "or" "less" "from" "among" "them" "." "you" "may" "put" "it" "onto" "the" "battlefield" "if" condition "." "if" "you" "don't" "put" "it" "onto" "the" "battlefield" "," "put" "it" "into" "your" "hand" "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* Partition a searched selection by choosing the battlefield count first, then
   moving any remaining selected cards to your hand and shuffling. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_library}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Selected(@marked), count:AsManyAsCan($count_plural)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
clause_search_reveal_split_plural_tapped_hand ::= search_library "and" "reveal" "them" "." "put" count_plural "of" "them" "onto" "the" "battlefield" "tapped" "and" "the" "other" "into" "your" "hand" "," "then" "shuffle"

/* Shuffling and revealing the top card tests nonland and land outcomes separately
   so an empty library triggers neither and the optional self-return stays tied to
   putting the revealed land onto the battlefield. */
/* @sem Instruction::[Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}, Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:Not(CardType(Land))}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, count:Exactly(Constant(1)), terms:_{cost:Free}}}]}}]}, otherwise:Program{}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:CardType(Land)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Observed(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:One($self_explicit_ref), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]}, otherwise:Program{}}] */
instructions_shuffle_reveal_top_nonland_land_return ::= "shuffle" "your" "library" "," "then" "reveal" "the" "top" "card" "." "if" "it's" "a" "nonland" "card" "," "you" "may" "cast" "it" "without" "paying" "its" "mana" "cost" "." "if" "it's" "a" "land" "card" "," "you" "may" "put" "it" "onto" "the" "battlefield" "and" "return" self_explicit_ref "to" "its" "owner's" "hand"

/* Exiling until a matching card grants a timed free-cast permission only for
   the matching card exiled by that transition, never an earlier nonmatching card. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:$player_ref, filter:$adjective_nontype, count:$counter_amount}}, Effect{result:@mark, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Matching{objects:Transition{result:@marked, phase:After}, filter:$adjective_nontype}, origins:CardPlayOrigins([Exile]), action:CastSpell, filter:Any}, terms:_{cost:Free}})], duration:$until_end_of_turn, evaluation:LiveObjects}}] */
instructions_player_exile_until_free_cast ::= player_ref "exiles" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "exile" counter_amount adjective_nontype "card" "." until_end_of_turn "," "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost"

/* Putting top cards of a player's library onto the battlefield face down under
   your control preserves both the library owner and your entry control. */
/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($zone_that_player)}, kind:Card, filter:Any}, count:$card_count, from:Top}, destination:Battlefield{controller:Player(AbilityController), arrival:$milled_face_down_arrival}, qualifiers:[]} */
put_top_player_library_face_down ::= "put" "the" "top" card_count "of" zone_that_player "library" "onto" "the" "battlefield" milled_face_down_arrival

look_where_value ::= history_life_opponents_lost_simple | value | look_where_creature_types

/* @sem Expr::CountDistinct{objects:$affected, property:CreatureTypes} */
look_where_creature_types ::= "the" "number" "of" "creature" "types" "among" affected

/* A single library search supplies the card cast before its controller shuffles. */
/* @sem Instruction::[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Selected(@marked), count:Exactly(Constant(1)), terms:_{cost:Free}}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
search_cast_selected_then_shuffle ::= "and" "cast" "that" "card" "without" "paying" "its" "mana" "cost" "." "then" "shuffle"

/* @sem Instruction::[Effect{result:@mark, operation:$search_single_library}, ...$search_cast_selected_then_shuffle] */
clause_search_single_cast ::= search_single_library search_cast_selected_then_shuffle

/* Shuffle private zones and owned permanents as one action. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Union([Zone{scope:Players{zone:$your_zone, players:One(AbilityController)}, kind:Card, filter:Any}, Zone{scope:Players{zone:$your_zone_2, players:One(AbilityController)}, kind:Card, filter:Any}, Zone{scope:Shared(Battlefield), kind:Permanent, filter:OwnedBy(One(AbilityController))}]), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
clause_shuffle_own_zones_and_permanents ::= "shuffle" your_zone "," your_zone "," "and" "all" "permanents" "you" "own" "into" "your" "library"

/* A required selection from an observed library slice, retaining the move's
   before receipt when the remainder goes to exile. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($number), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
observed_number_hand_bare ::= "put" number "into" "your" "hand"

/* This operation is scoped by the activation below: component 2 is the
   unique singleton creature sacrifice, including during inverse printing. */
/* @sem Operation::Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:ObjectProperty{object:Query{objects:CostObjects{payment:Activation, component:[2], view:Inputs, phase:Before}, index:0}, property:$receipt_stat, information:CurrentOrLastKnown}, from:Top}} */
reveal_activation_sacrifice_stat ::= "reveal" "a" "number" "of" "cards" "from" "the" "top" "of" "your" "library" "equal" "to" "the" "sacrificed" "creature's" receipt_stat

/* @sem Instruction::[Effect{result:@mark, operation:$reveal_activation_sacrifice_stat}, ...$observed_number_hand_bare, $look_rest_exile_and] */
activation_sacrifice_reveal_partition ::= reveal_activation_sacrifice_stat "." observed_number_hand_bare look_rest_exile_and

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, $cost_tap, $receipt_cast_sacrifice_creature]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:$activation_sacrifice_reveal_partition}} */
activated_sacrifice_reveal_partition ::= cost_mana "," cost_tap "," "↑" receipt_cast_sacrifice_creature ":" activation_sacrifice_reveal_partition "."

/* The observation, chosen hand movement, and its remaining library cards share one scope. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top_spelled_count}, ...$look_choose_them_hand, $look_rest_exile_and] */
dig_look_hand_exile ::= look_top_spelled_count "," look_choose_them_hand "," look_rest_exile_and

/* @sem Instruction::Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}} */
look_rest_exile_and ::= "and" "exile" "the" "rest"

/* @prefer always */
/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}} */
optional_reveal_battlefield_tapped ::= "onto" "the" "battlefield" "tapped"

optional_reveal_destination ::= optional_reveal_battlefield_tapped | until_hand

/* The observation belongs to the revealed hand card, while the following
   search actions keep the search selection as their referent. */
/* @sem Instruction::[Effect{result:@next, operation:RevealFromHand{actor:One(AbilityController), cards:$a_card, count:Constant(1)}}, Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:SharesNameWithAny(Observed(@prior)), count:UpTo(Constant(1))}]}}, ...$search_follow] */
reveal_hand_same_name_search ::= "reveal" a_card "from" "your" "hand" "." "search" "your" "library" "for" "a" "card" "with" "the" "same" "name" "as" "that" "card" search_follow

/* A postposed condition replaces the entire preceding instruction sequence. */
/* @sem Ability::@optional_ability_label(Spell{announcement:@announcement, body:Program{instructions:[If{condition:$condition, then:Program{instructions:$replacement_search}, otherwise:Program{instructions:$reveal_hand_same_name_search}}]}}, $spell_paragraph_break) */
spell_reveal_search_instead ::= reveal_hand_same_name_search "." spell_paragraph_break "if" condition "," "instead" replacement_search "."

replacement_search ::= clause_search_general | replacement_counted_search

/* @sem Instruction::[Effect{result:@mark, operation:$search_counted}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
replacement_counted_search ::= search_counted "," "put" "them" "into" "your" "hand" "," "then" "shuffle"

/* Keep the reveal, battlefield move and randomized remainder together: the
   remainder excludes the actual movement receipt, not a fresh filter query. */
/* @sem Instruction::[Effect{result:@next, operation:$reveal_top}, Effect{result:@next, operation:Move{objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:CardType(Land)}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(3)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Random}}] */
reveal_lands_tapped_remainder ::= reveal_top "." "put" "all" "land" "cards" "from" "among" "them" "onto" "the" "battlefield" "tapped" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* The follow-up refers to the battlefield arrivals of that exact move. */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:AnyOf([$card_word, $card_word_2])}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}} */
condition_revealed_lands_graveyard ::= "there" "are" count "or" "more" card_word "and" "/" "or" card_word "cards" "in" "your" "graveyard"

/* @prefer always */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$reveal_lands_tapped_remainder, $revealed_lands_untap]}} */
spell_revealed_lands_untap ::= reveal_lands_tapped_remainder "." NEWLINE revealed_lands_untap
/* @prefer always */
/* @sem Ability::WithPresentation{label:$ability_label, reminder:false, ability:Spell{announcement:@announcement, body:Program{instructions:[...$reveal_lands_tapped_remainder, $revealed_lands_untap]}}} */
spell_revealed_lands_untap_labelled ::= reveal_lands_tapped_remainder "." NEWLINE ability_label "—" revealed_lands_untap
/* @sem Instruction::If{condition:$condition_revealed_lands_graveyard, then:Program{instructions:[Effect{result:@next, operation:SetTapped{objects:Transition{result:@back(3), phase:After}, tapped:false}}]}, otherwise:Program{}} */
revealed_lands_untap ::= "if" condition_revealed_lands_graveyard "," "untap" "those" "lands" "."

/* @sem Operation::@search_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}) */
found_plural_battlefield_those ::= "put" "those" "cards" "onto" "the" "battlefield"

/* Each-type searches share the selection and ordinary plural continuations. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_each_type}, ...$search_each_type_follow] */
clause_search_each_type ::= search_each_type search_each_type_follow

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_each_basic_type]} */
search_each_type ::= "search" "your" "library" "for" search_choice_each_basic_type

search_each_type_follow ::= search_each_type_those | search_plural_follow

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$found_plural_battlefield_those}, ...$search_shuffle] */
search_each_type_those ::= "," found_plural_battlefield_those search_shuffle

/* @sem SearchChoice::SearchChoice{filter:$filter_phrase, count:AnyNumber, constraints:[OneForEach([Subtype(Plains), Subtype(Island), Subtype(Swamp), Subtype(Mountain), Subtype(Forest)])]} */
search_choice_each_basic_type ::= "a" filter_phrase "card" "of" "each" "basic" "land" "type"

/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($look_hand_count), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Instruction::Effect{result:@next, operation:Operation::Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
look_put_hand ::= "put" look_hand_count "into" "your" "hand"

/* @sem Instruction::[...$look_put_hand, Instruction::Effect{result:@next, operation:$rest_bottom}] */
look_put_split_ordered ::= look_put_hand "and" rest_bottom

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$look_put_split_ordered] */
look_put_ordered ::= look_top "." look_put_split_ordered

/* A look-and-hand split can be followed by an independent life change. */
/* @prefer always */
/* @sem Instruction::[...$look_put_ordered, ...$clause_you_life] */
look_put_more ::= look_put_ordered "." clause_you_life

/* Each alternative independently describes the same single card. */
/* @sem ObjectFilter::AnyOf(@unordered([$card_filter, $card_filter_2, $card_filter_3])) */
search_filter_three_repeated ::= card_filter "card" "," "a" card_filter "card" "," "or" "a" card_filter "card"

/* @sem SearchChoice::SearchChoice{filter:$filter_phrase, count:AnyNumber, constraints:[TotalProperty{property:ManaValue, comparison:LessOrEqual, amount:$value}]} */
search_choice_any_number_total_mana ::= "any" "number" "of" filter_phrase "cards" "with" "total" "mana" "value" value "or" "less"

/* The declined draw and its mill are scoped together with the loss measured
   from those milled cards; the opponent and both quantities remain operands. */
/* @sem Vec<Instruction>::[Effect{result:@mark, operation:PayCost{player:$target_opponent, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:Mill{players:One(AbilityController), amount:$value_counters_on_object}}, Effect{result:@next, operation:LoseLife{players:One(Target{slot:@last_slot, index:0}), amount:Earlier{what:Milled, measure:Total(ManaValue)}}}]}, otherwise:Program{}}] */
instructions_opponent_draw_or_mill_loss ::= target_opponent "may" "have" "you" "draw" card_count "." "if" "that" "player" "doesn't" "," "you" "mill" "X" "cards" "," "where" "X" "is" value_counters_on_object "," "and" "that" "player" "loses" "life" "equal" "to" "the" "total" "mana" "value" "of" "those" "cards"

/* Distinct names constrain the announced cards, independently of their destination. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_plural_count, filter:@and($card_filter, $graveyard_scope), constraints:[DifferentNames]})) */
graveyard_different_names_typed_many ::= graveyard_plural_count "target" card_filter "cards" "with" "different" "names" graveyard_scope

/* Exile through a matching card and move that exact arrival to its owner's hand. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@mark, operation:Move{objects:InZone{objects:One(Query{objects:Matching{objects:Transition{result:@prior, phase:After}, filter:$card_filter}, index:0}), zone:Exile}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
exile_until_card_to_hand ::= "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" "a" card_filter "card" "," "then" "put" "that" "card" "into" "your" "hand"

/* The condition and damage both count the hand arrival of this producer. */
/* @sem Instruction::[Repeatable{instructions:[...$exile_until_card_to_hand, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:_{instructions:[Effect{result:@next, operation:RepeatProcess}]}, otherwise:_{}}]}, Effect{result:@next, operation:DealDamage{source:$object_ref, recipients:Players(One(AbilityController)), amount:Multiply($value_2, CountObjects(Transition{result:@marked, phase:After})), preventable:true}}] */
instructions_exile_until_hand_repeat_damage ::= exile_until_card_to_hand "." "if" "the" "card's" "mana" "value" "is" value "or" "greater" "," "repeat" "this" "process" "." object_ref "deals" value "damage" "to" "you" "for" "each" "card" "put" "into" "your" "hand" "this" "way"

/* Keep the mill receipt, its selection, and its destination in one inverse contract. */
/* @sem Vec<Instruction>::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$instant_sorcery_or_subtype}, count:Exactly(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
mill_select_type_to_hand ::= "mill" card_count "." "then" "put" "an" instant_sorcery_or_subtype "card" "from" "among" "the" "milled" "cards" "into" "your" "hand"

/* @sem ObjectFilter::AnyOf([$subtype, CardType(Instant), CardType(Sorcery)]) */
instant_sorcery_or_subtype ::= "instant" "," "sorcery" "," "or" subtype

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$mill_select_type_to_hand}} */
spell_mill_select_type_to_hand ::= mill_select_type_to_hand "."

/* The life swing uses the one card revealed immediately before it was put
   into its owner's hand. Both life effects share the captured property. */
/* @sem Instruction::[...$reveal_top_hand_it, ...$revealed_top_property_life_swing] */
reveal_top_hand_property_life_swing ::= reveal_top_hand_it "." revealed_top_property_life_swing

/* @sem Instruction::[Effect{result:@mark, operation:BindValue{value:ObjectProperty{object:ObjectRef::@revealed_card_receipt, property:$receipt_stat, information:CurrentOrLastKnown}}}, Effect{result:@next, operation:LoseLife{players:$players_singular, amount:BoundValue(@marked)}}, Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:BoundValue(@marked)}}] */
revealed_top_property_life_swing ::= players_singular "loses" "X" "life" "and" "you" "gain" "X" "life" "," "where" "X" "is" "that" "card's" receipt_stat

/* An ordered slice from the library of the player bound by the enclosing loop. */
/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}, count:$top_count, from:$ordered_end} */
personal_ordered_library_cards ::= "the" ordered_end top_count "of" "their" "library"

/* A singular selection can match either independently named card. */
/* @sem SearchChoice::SearchChoice{filter:AnyOf(@unordered([Name($referenced_card_name), Name($referenced_card_name_2)])), count:UpTo(Constant(1))} */
search_choice_two_names ::= "a" "card" "named" referenced_card_name "or" referenced_card_name

/* The library belongs to the player who performs this exile. */
/* @sem $player_ref */
player_exile_until_prefix ::= player_ref "exiles" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "exile" "a"

/* @sem CostPart::LifeEqualToOwnManaValue */
cast_spell_life_mana_value_cost ::= "paying" "life" "equal" "to" "the" "spell's" "mana" "value" "rather" "than" "paying" "its" "mana" "cost"

/* Alternative payments can vary independently of the card's filter. */
exile_until_cast_payment ::= cast_spell_life_mana_value_cost | cast_spell_discard_cost

/* @sem CostPart::Discard{count:$exile_discard_count, filter:Any} */
cast_spell_discard_cost ::= "discarding" exile_discard_count "rather" "than" "paying" "its" "mana" "cost"

/* The stopped-on card is selected from this very exile's arrival receipt. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:$player_exile_until_prefix, filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:One(Query{objects:Matching{objects:Transition{result:@prior, phase:After}, filter:$card_filter}, index:0}), count:Exactly(Constant(1)), terms:_{cost:Alternate(Cost{parts:[$exile_until_cast_payment]})}}}]}}] */
instructions_player_exile_until_life_cast ::= player_exile_until_prefix card_filter "card" "." "you" "may" "cast" "that" "card" "by" exile_until_cast_payment

/* Card type, ability, count and graveyard scope remain independent operands. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_plural_count, filter:@and(@and($card_filter, $plural_card_ability), $graveyard_scope)})) */
graveyard_typed_ability_many ::= graveyard_plural_count "target" card_filter "cards" plural_card_ability graveyard_scope

plural_card_ability ::= plural_card_cycling | plural_card_mana | plural_card_activated

/* @sem ObjectFilter::HasActivatedAbility(Cycling) */
plural_card_cycling ::= "with" "cycling" "abilities"

/* @sem ObjectFilter::HasActivatedAbility(Mana) */
plural_card_mana ::= "with" "mana" "abilities"

/* @sem ObjectFilter::HasActivatedAbility(Any) */
plural_card_activated ::= "with" "activated" "abilities"

/* @sem ObjectFilter::InZone(Players{zone:Graveyard, players:One(Active)}) */
graveyard_scope_active ::= "from" "the" "active" "player's" "graveyard"

/* A plural search choice retains the chosen card name and its current count. */
/* @sem SearchChoice::SearchChoice{filter:Chosen(CardName), count:$named_search_count} */
search_choice_chosen_name ::= named_search_count "cards" "with" "that" "name"

/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$count_plural}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$card_filter}, count:UpTo($count_plural_2)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
mill_put_plural_battlefield ::= "mill" count_plural "cards" "." "put" "up" "to" count_plural card_filter "cards" "from" "among" "the" "milled" "cards" "onto" "the" "battlefield"

/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase}, count:AsManyAsCan($counter_amount)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
mill_put_one_battlefield ::= "mill" card_count "." "then" "put" counter_amount filter_phrase "card" "from" "among" "the" "milled" "cards" "onto" "the" "battlefield"

/* The destination receives the same selected search receipt. */
/* @sem Operation::Move{objects:Selected(@marked), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]} */
found_plural_graveyard ::= "put" "them" "into" "your" "graveyard"

/* A plural card population qualified by its mana value. */
/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:$value}} */
search_many_mana_value ::= "cards" "that" "have" "mana" "value" value

/* @sem SearchChoice::SearchChoice{filter:$search_many_mana_value, count:AnyNumber} */
search_choice_any_number_mana_value ::= "any" "number" "of" search_many_mana_value

/* Keep the mill and its selected cards together in the inverse contract. */
/* @sem Vec<Instruction>::@then_sequence($mill_return_producer, $mill_return_selection) */
instructions_mill_return_selected ::= mill_return_producer "," "then" mill_return_selection

/* @sem Instruction::[Effect{result:@next, operation:Mill{players:One(AbilityController), amount:$card_count}}] */
mill_return_producer ::= "mill" card_count

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@prior, phase:After}, filter:$card_filter}, count:UpTo($count_plural)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
mill_return_selection ::= "return" "up" "to" count_plural card_filter "cards" "from" "among" "them" "to" "your" "hand"

/* Two independently bounded named choices share the ordinary search follow-ups. */
/* search_named_bounded_choice is shared as search_named_count_choice. */

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_named_count_choice, $search_named_count_choice_2]} */
search_library_named_pair ::= "search" "your" "library" "for" search_named_count_choice "and" "/" "or" search_named_count_choice

/* Each searcher chooses a subset of the found cards for one controller; the
   remaining selected cards go to their owners. Keep the two receipts local to
   the optional search and preserve the searcher's own shuffle. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[$search_choice_many]}}, ...$search_split_control_follow]}}]}}] */
each_may_search_split_control ::= players_singular "may" "search" "their" "library" "for" search_choice_many "." search_split_control_follow

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Selected(@marked), count:AsManyAsCan($value)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}] */
search_split_control_follow ::= "they" "each" "put" value "of" "those" "cards" "onto" "the" "battlefield" "tapped" "under" "your" "control" "and" "the" "rest" "onto" "the" "battlefield" "tapped" "under" "their" "control" "." "then" "each" "player" "who" "searched" "their" "library" "this" "way" "shuffles"

/* The sacrifice producer and its controller-specific search consume the same
   before receipt; keeping them together also constrains inverse printing. */
/* @sem Instruction::[Effect{result:@mark, operation:$sacrifice_all_controlled_plural}, ForEachPlayer{players:Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:MovedBy{result:@marked, phase:Before, player:Bound(0)}, filter:$filter_phrase}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}, binding:0, body:_{instructions:[Optional{decider:Bound(0), body:_{instructions:[Effect{result:@next, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[_{filter:$filter_phrase_2, count:UpTo(CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:AllOf([$filter_phrase, ControlledBy(One(Bound(0)))])}))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(Bound(0)), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}]}}] */
sacrifice_controlled_search_replacement ::= sacrifice_all_controlled_plural "." "for" "each" filter_phrase "sacrificed" "this" "way" "," "its" "controller" "may" "search" "their" "library" "for" "a" filter_phrase "card" "and" "put" "it" "onto" "the" "battlefield" "tapped" "." "then" "each" "player" "who" "searched" "their" "library" "this" "way" "shuffles"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$sacrifice_controlled_search_replacement}} */
spell_sacrifice_controlled_search ::= sacrifice_controlled_search_replacement "."

/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:$filter_phrase, count:CountPlayers(OpponentsOf(AbilityController))}}, Effect{result:@mark, operation:Move{objects:Matching{objects:Observed(@prior), filter:$filter_phrase_2}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
reveal_opponents_count_battlefield_shuffle ::= reveal_until_your_library "X" filter_phrase "cards" "," "where" "X" "is" "the" "number" "of" "opponents" "you" "have" "." "put" "those" filter_phrase "cards" "onto" "the" "battlefield" "," "then" "shuffle"

/* Keep the observed reveal, partition and characteristic-based damage in one
   scope: the later damage consumer refers to this reveal's observation. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:@agree($card_filter, $card_filter_2), count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@prior), filter:@agree($card_filter, $card_filter_2)}, destination:$until_destination, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(3)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}, Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any})), amount:ObjectProperty{object:Query{objects:Observed(@back(4)), index:0}, property:$receipt_stat, information:CurrentOrLastKnown}, preventable:true}}] */
/* @prefer always */
reveal_partition_observed_damage ::= "choose" "any" "target" "." reveal_until_your_library "a" card_filter "card" "." self_explicit_ref "deals" "damage" "equal" "to" "that" "card's" receipt_stat "to" "that" "permanent" "or" "player" "." "put" "the" card_filter "card" until_destination "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* The change reads the reveal observation; its enclosing contract keeps
   that producer and the library reorder in scope for printing. */
/* @sem Change::Pump{power:ObjectProperty{object:Query{objects:Observed(@marked), index:0}, property:ManaValue, information:CurrentOrLastKnown}, toughness:Multiply([Constant(-1), ObjectProperty{object:Query{objects:Observed(@marked), index:0}, property:ManaValue, information:CurrentOrLastKnown}])} */
observed_mana_value_inverse_pump ::= "gets" "+" "X" "/" "-" "X"

/* @sem Instruction::[Effect{result:@mark, operation:$reveal_until_all_one}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:$library_order}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@agree($noun, $noun_2)}), index:0})), changes:[$observed_mana_value_inverse_pump], duration:$duration, evaluation:Snapshot}}] */
choose_reveal_observed_pump_reorder ::= "choose" "target" noun "." reveal_until_all_one "." "that" noun observed_mana_value_inverse_pump duration "," "where" "X" "is" "that" "card's" "mana" "value" "." "put" "all" "cards" "revealed" "this" "way" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$choose_reveal_observed_pump_reorder}} */
spell_choose_reveal_observed_pump ::= choose_reveal_observed_pump_reorder "."

/* Both outcomes retain their own observation and selection receipts. */
/* @sem Vec<Instruction>::@unlabelled_instructions($dig_conditional_reveal_battlefield_paragraph) */
dig_conditional_reveal_battlefield ::= dig_conditional_reveal_battlefield_paragraph

/* @sem Ability::@optional_ability_label(Spell{announcement:@announcement, body:Program{instructions:[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:$reveal_top}, Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:@agree($a_card, $search_filter_many)}, count:UpTo($number), constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}}, Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@back(3)), zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:$reveal_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:@agree($a_card, $search_filter_many)}, count:UpTo(Expr::@agree(Constant(1), $number_2)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]}}, $spell_paragraph_break) */
dig_conditional_reveal_battlefield_paragraph ::= reveal_top "." "you" "may" "put" a_card "from" "among" "them" "onto" "the" "battlefield" "." "put" "the" "rest" "into" "your" "graveyard" "." spell_paragraph_break "if" condition "," "you" "may" "put" number search_filter_many "onto" "the" "battlefield" "instead" "of" number

/* The partition retains the observation and the selected hand arrival.  The
   life sentence refers to the one card moved to hand, even though its words
   precede the disposition of the remainder. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
dig_observed_one_hand ::= "put" "one" "of" "them" "into" "your" "hand"

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@back(5)), excluding:Union([Transition{result:@marked, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
dig_other_revealed_graveyard ::= "put" "all" "other" "cards" "revealed" "this" "way" "into" "your" "graveyard"

/* @sem Instruction::[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}] */
dig_hand_card_value_gain ::= "you" "gain" "life" "equal" "to" "that" "card's" "mana" "value"

/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$dig_observed_one_hand, ...$dig_other_revealed_graveyard, ...$dig_hand_card_value_gain] */
reveal_hand_value_partition ::= reveal_top "and" dig_observed_one_hand "." dig_hand_card_value_gain "." dig_other_revealed_graveyard

/* Library slices form explicit exile piles; visibility and count are independent. */
/* @sem ExileVisibility::FaceDown */
library_pile_face_down ::= "face-down"

/* @sem ExileVisibility::FaceUp */
library_pile_face_up ::= "face-up"

library_pile_visibility ::= library_pile_face_down | library_pile_face_up

/* @sem Operation::Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$card_count, from:Top}, destination:Exile{visibility:$library_pile_visibility, arrival:ExileArrival{counters:[], states:[ExilePile{}]}}, qualifiers:[]} */
exile_top_in_face_pile ::= "exile" "the" "top" card_count "of" "your" "library" "in" "a" library_pile_visibility "pile"

/* @sem $exile_top_in_face_pile */
first_library_pile ::= exile_top_in_face_pile

/* @sem $exile_top_in_face_pile */
second_library_pile ::= exile_top_in_face_pile

/* Scope the chosen and other piles to the complete two-pile sequence. */
/* @sem Instruction::[Effect{result:@mark, operation:ChoosePile{actor:One(OneOf(OpponentsOf(AbilityController)))}}, Effect{result:@next, operation:Move{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:InSet(Recorded(@marked))}), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:LookAt{player:AbilityController, objects:Zone(_{scope:Shared(Exile), kind:Card, filter:Not(InSet(Recorded(@marked)))})}}, Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Zone(_{scope:Shared(Exile), kind:Card, filter:Not(InSet(Recorded(@marked)))}), count:Exactly(Constant(1)), cost:Free}}]}}, Effect{result:@next, operation:Move{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:Not(InSet(Recorded(@marked)))}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
opponent_pile_cast_remainder ::= "an" "opponent" "chooses" "one" "of" "those" "piles" "." "put" "that" "pile" "into" "your" "graveyard" "." "look" "at" "the" "cards" "in" "the" "other" "pile" "." "you" "may" "cast" "a" "spell" "from" "among" "them" "without" "paying" "its" "mana" "cost" "." "put" "the" "rest" "into" "your" "hand"

/* @sem Instruction::[Effect{result:@next, operation:$first_library_pile}, Effect{result:@next, operation:$second_library_pile}, ...$opponent_pile_cast_remainder] */
library_piles_opponent_cast ::= first_library_pile "," "then" second_library_pile "." opponent_pile_cast_remainder

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$library_piles_opponent_cast}} */
spell_library_piles_opponent_cast ::= library_piles_opponent_cast "."

/* Restrict the paired subject to the same nonland population as this seek.
   Keeping the producer in the enclosing instruction proves the hand receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Not(CardType(Land))}, count:$seek_plural_count, constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_seek_nonland_cards ::= "seek" seek_plural_count "nonland" "cards"

/* @sem Instruction::[...$clause_seek_nonland_cards, Effect{result:@next, operation:CreatePerpetualEffect{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@prior, phase:After})}, changes:[GrantAbility($quoted_cost_reduction)]}}] */
seek_nonland_hand_cost_grant ::= clause_seek_nonland_cards "," "then" "nonland" "cards" "in" "your" "hand" "perpetually" "gain" quoted_cost_reduction

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$seek_nonland_hand_cost_grant}} */
spell_seek_nonland_hand_cost_grant ::= seek_nonland_hand_cost_grant

/* Keep the observation and its hand/graveyard partition in one scope. */
/* @sem Instruction::[Effect{result:@mark, operation:$scaled_look_top}, ...$look_choose_among_hand, $look_rest_grave_and] */
scaled_look_partition ::= scaled_look_top "." look_choose_among_hand look_rest_grave_and

scaled_look_top ::= look_twice_top | look_times_top

/* @sem Operation::LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Multiply(Constant(2), $number), from:Top}} */
look_twice_top ::= "look" "at" "twice" number "cards" "from" "the" "top" "of" "your" "library"

/* @sem Operation::LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Multiply($number_words, $number), from:Top}} */
look_times_top ::= "look" "at" number_words "times" number "cards" "from" "the" "top" "of" "your" "library"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($number), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
look_choose_among_hand ::= "put" number "cards" "from" "among" "them" "into" "your" "hand"

/* @sem Instruction::[...$scaled_look_partition, ...$instructions] */
scaled_look_partition_followed ::= scaled_look_partition "." instructions

/* Keep the reveal, exile arrival, cast and return together: both consumers
   refer to this exact exile producer, including its destination. */
/* @sem ObjectFilter::Shares{property:CardTypes, with:EventSubject} */
exile_shared_event_card_type ::= "a" "card" "that" "shares" "a" "card" "type" "with" "it"

/* @sem ObjectFilter::Shares{property:Colors, with:EventSubject} */
exile_shared_event_color ::= "a" "card" "that" "shares" "a" "color" "with" "it"

exile_shared_event_filter ::= exile_shared_event_card_type | exile_shared_event_color

/* @sem Operation::Move{objects:One(EventSubject), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
player_exile_event_subject ::= "that" "player" "exiles" "it"

/* @sem Program::Program{instructions:[Effect{result:@next, operation:$player_exile_event_subject}, Effect{result:@next, operation:RevealUntil{library:EventSubject, filter:$exile_shared_event_filter, count:Constant(1)}}, Effect{result:@mark, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Optional{decider:EventSubject, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(EventSubject), action:CastSpell, cards:One(Query{objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$exile_shared_event_filter}, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:Library{position:BottomRandom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]} */
program_player_exile_until_shared_cast ::= player_exile_event_subject "," "then" "exiles" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "exile" exile_shared_event_filter "." "that" "player" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" "." "then" "they" "put" "all" "cards" "exiled" "with" "this" "enchantment" "on" "the" "bottom" "of" "their" "library" "in" "a" "random" "order" "."

/* @sem Ability::Triggered{event:$event_player_casts_from_own_zone, limits:TriggerLimits{}, announcement:@announcement, body:$program_player_exile_until_shared_cast} */
triggered_cast_origin_exile_shared ::= "whenever" event_player_casts_from_own_zone "," program_player_exile_until_shared_cast

/* The damage consumes the arrival of this exact exile-until operation. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:$exile_until_your_single_filter, count:Constant(1)}}, Effect{result:@mark, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:DealDamage{source:$self_ref_named, recipients:$recipients, amount:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}, preventable:true}}] */
exile_until_receipt_value_damage ::= exile_until_your_single_filter "." self_ref_named "deals" "damage" "to" recipients "equal" "to" "that" "card's" "mana" "value"

/* Scope the cast to the actual reveal, exile and remainder producers. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:$each_player_distinct_negative_targets, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, ForEachPlayer{players:Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:ControlledBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}, binding:0, body:Program{instructions:[Effect{result:@next, operation:RevealUntil{library:Bound(0), filter:@agree($adjective_nontype, $adjective_nontype_2), count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}, ForEachPlayer{players:Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:ControlledBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}, binding:0, body:Program{instructions:[Effect{result:@mark, operation:Move{objects:InZone{objects:Matching{objects:Transition{result:@prior, phase:After}, filter:Not(@agree($adjective_nontype, $adjective_nontype_2))}, zone:Exile}, destination:Library{position:BottomRandom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}}, ForEachPlayer{players:Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:ControlledBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(Bound(0)), action:CastSpell, cards:One(Query{objects:Matching{objects:Transition{result:@back(3), phase:After}, filter:AllOf([@agree($adjective_nontype, $adjective_nontype_2), OwnedBy(One(Bound(0)))])}, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}]}}] */
clause_each_player_shuffle_exile_cast ::= each_player_distinct_negative_targets "." "those" "permanents'" "owners" "shuffle" "them" "into" "their" "libraries" "." "each" "player" "who" "controlled" "one" "of" "those" "permanents" "exiles" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "exile" "a" adjective_nontype "card" "," "then" "puts" "the" "rest" "on" "the" "bottom" "of" "their" "library" "in" "a" "random" "order" "." "each" "player" "may" "cast" "the" adjective_nontype "card" "they" "exiled" "without" "paying" "its" "mana" "cost"

/* The two exile arrivals and their pile choices stay in the same program, so
   each recorded reference has its actual producer and zone. */
/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:$count_plural, from:Top} */
face_down_pile_library_cards ::= "the" "top" count_plural "cards" "of" "your" "library"

/* @sem Operation::Move{objects:$face_down_pile_library_cards, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[ExilePile{}]}}, qualifiers:[]} */
exile_first_library_pile ::= "exile" face_down_pile_library_cards "in" "a" "face-down" "pile"

/* @sem Operation::Move{objects:$face_down_pile_library_cards, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[ExilePile{}]}}, qualifiers:[]} */
exile_another_library_pile ::= "exile" face_down_pile_library_cards "in" "another" "face-down" "pile"

/* @sem Instruction::[Effect{result:@next, operation:$exile_first_library_pile}, Effect{result:@next, operation:$exile_another_library_pile}, Effect{result:@next, operation:LookAt{player:AbilityController, objects:Zone{scope:Shared(Exile), kind:Card, filter:InSet(Recorded(@prior))}}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::TurnPileFaceUp}}, Effect{result:@next, operation:ChoosePile{actor:One(OneOf(OpponentsOf(AbilityController)))}}, Effect{result:@next, operation:Move{objects:Zone{scope:Shared(Exile), kind:Card, filter:InSet(Recorded(@prior))}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Zone{scope:Shared(Exile), kind:Card, filter:InSet(Recorded(@prior))}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_exile_two_library_piles ::= exile_first_library_pile "," "then" exile_another_library_pile "." "look" "at" "the" "cards" "in" "each" "pile" "," "then" "turn" "a" "pile" "of" "your" "choice" "face" "up" "." "an" "opponent" "chooses" "one" "of" "those" "piles" "." "put" "that" "pile" "into" "your" "hand" "and" "the" "other" "into" "your" "graveyard"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$instructions_exile_two_library_piles, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:$number_digits}}]}} */
spell_exile_piles_lose_life ::= instructions_exile_two_library_piles "." "you" "lose" number_digits "life" "."

/* A captured look may keep observed cards on top before ordering the rest. */
/* @sem Instruction::[...$captured_top_choice, $dig_rest_put] */
captured_top_choice_rest ::= captured_top_choice "." dig_rest_put

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:UpTo($number)}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@prior), end:Top, order:Chosen}}] */
captured_top_choice ::= "you" "may" "put" number "of" "those" "cards" "on" "top" "of" "your" "library"

/* Combat removal leaves the observed library top unchanged; all operands
   share this single-card reveal contract. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$filter_phrase}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:$remove_from_combat_action}, Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:$top_reveal_destination, qualifiers:[]}}]}, otherwise:Program{}}] */
reveal_top_filtered_combat_then_move ::= "reveal" "the" "top" "card" "of" "your" "library" "." "if" "it's" "a" filter_phrase "card" "," remove_from_combat_action "." "then" "put" "the" "revealed" "card" top_reveal_destination

/* Keep the revealed population and the selected exile receipt in one group. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:InZone{objects:Observed(@marked), zone:Library}, count:AnyNumber, constraints:[OneForEachCardType(All)]}], action:Move{objects:Prepared(@selection_id(0)), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}}, Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
revealed_types_exile_graveyard ::= reveal_top "." "for" "each" "card" "type" "," "you" "may" "exile" "a" "card" "of" "that" "type" "from" "among" "them" "." "put" "the" "rest" "into" "your" "graveyard"

/* Both consumers refer to the selection's exile arrival, not the graveyard move. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$revealed_types_exile_graveyard, If{condition:Compare{left:CountObjects(Transition{result:@back(2), phase:After}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$exiled_threshold_amount}}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Transition{result:@back(3), phase:After}, count:Exactly(Constant(1)), cost:Free}}]}}]}, otherwise:Program{}}, Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@back(4), phase:After}, zone:Exile}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}} */
spell_revealed_types_exile_cast ::= revealed_types_exile_graveyard "." "you" "may" "cast" "a" "spell" "from" "among" "the" "exiled" "cards" "without" "paying" "its" "mana" "cost" "if" "you" "exiled" exiled_threshold_amount "or" "more" "cards" "this" "way" "." "then" "put" "the" "rest" "of" "the" "exiled" "cards" "into" "your" "hand" "."

exiled_threshold_amount ::= exiled_threshold_words | number_digits | number_x | number_x_plus

/* @prefer always */
/* @sem $number_words */
exiled_threshold_words ::= number_words

/* The revealed-card count and conditional damage share the same observation;
   this consumer is registered only inside its reveal-and-reorder producer. */
/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$filter_phrase}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}}, then:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:$recipients, amount:Multiply([Constant(2), CountObjects(Matching{objects:Observed(@marked), filter:Not(CardType(Land))})]), preventable:true}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Source, recipients:$recipients, amount:CountObjects(Matching{objects:Observed(@marked), filter:Not(CardType(Land))}), preventable:true}}]}} */
revealed_nonland_damage_if ::= "this" "artifact" "deals" "damage" "equal" "to" "the" "number" "of" "nonland" "cards" "revealed" "this" "way" "to" recipients "." "if" "the" "revealed" "land" "card" "was" counter_amount filter_phrase "," "this" "artifact" "deals" "double" "that" "damage" "instead"

/* The fixed land producer proves which observation the dependent damage counts. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:CardType(Land), count:Constant(1)}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:$library_order}}, $revealed_nonland_damage_if] */
reveal_land_damage_reorder ::= reveal_until_your_library "a" "land" "card" "." revealed_nonland_damage_if "." "put" "the" "revealed" "cards" "on" "the" "bottom" "of" "your" "library" library_order

/* Sentence form of the same receipt-scoped continuation. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:$card_filter, count:CountObjects(Transition{result:@marked, phase:Before})}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@prior), filter:$card_filter_2}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
exile_count_reveal_sentence ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "that" "many" card_filter "cards" "." "put" "all" card_filter "cards" "revealed" "this" "way" "onto" "the" "battlefield" "," "then" "shuffle" "the" "rest" "of" "the" "revealed" "cards" "into" "your" "library"

/* The count consumes the before receipt of this exact face-up exile. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:$object_set, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, ...$exile_count_reveal_sentence] */
exile_then_reveal_count ::= "exile" object_set "," "then" exile_count_reveal_sentence

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$exile_then_reveal_count}} */
spell_exile_then_reveal_count ::= exile_then_reveal_count "."

/* Keep the reveal receipt, its graveyard destination and the count used by
   the event creature's pump in one phrase. The player who moves the cards is
   the same player whose library supplied the reveal. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:$reveal_until_named_player, filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(EventSubject)), changes:[Pump{power:@times($signed, Expr::CountObjects(Observed(@marked))), toughness:@times($signed_2, Expr::CountObjects(Observed(@marked)))}], duration:$duration, evaluation:Snapshot}}] */
reveal_until_event_creature_pump_graveyard ::= reveal_until_named_player "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" "a" card_filter "card" "." "the" "creature" "gets" signed "/" signed duration "for" "each" "card" "revealed" "this" "way" "." "that" "player" "puts" "the" "revealed" "cards" "into" "their" "graveyard"

/* This consumer is used only with an established hand-to-exile receipt. */
/* @sem Operation::Conjure{actor:One(AbilityController), card:Duplicate(OutsideTheGame($card_filter)), count:CountObjects(InZone{objects:Transition{result:@marked, phase:Before}, zone:Hand}), destination:Hand(CardArrival{counters:[], states:[]})} */
conjure_duplicate_per_hand_exile ::= "choose" ("a" | "an") card_filter "card" "you" "own" "from" "outside" "the" "game" "." "conjure" "a" "duplicate" "of" "that" "card" "into" "your" "hand" "for" "each" "card" "exiled" "from" "your" "hand" "this" "way"

/* The search's exile move supplies the hand-origin receipt used by the
   duplicate count. The name comes from the enclosing singleton payment. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:SharesNameWith(Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, index:0}), count:$named_search_count}], also:[Hand]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}, Effect{result:@next, operation:$conjure_duplicate_per_hand_exile}] */
search_paid_name_exile_conjure ::= "search" "your" "hand" "and" "library" "for" named_search_count "cards" "with" "the" "same" "name" "," "exile" "them" "," "then" "shuffle" "." conjure_duplicate_per_hand_exile

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$cost_exile_hand]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$search_paid_name_exile_conjure}, otherwise:Program{}}] */
optional_hand_exile_named_conjure ::= "you" "may" cost_exile_hand "." "if" "you" "do" "," search_paid_name_exile_conjure

/* The repeated noun and controller refer to the target even if destruction
   is prevented. The controller can still search. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:One($destroy_receipt_named_target), regeneration:true}}, Optional{decider:ControllerOf($destroy_receipt_named_target), body:Program{instructions:[Effect{result:@next, operation:Search{searcher:ControllerOf($destroy_receipt_named_target), library_owner:ControllerOf($destroy_receipt_named_target), choices:[$search_choice_filtered]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(ControllerOf($destroy_receipt_named_target)), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf($destroy_receipt_named_target))}}]}}] */
clause_destroy_receipt_controller_search ::= destroy_receipt_named_target "controller" "may" "search" "their" "library" "for" search_choice_filtered "," "put" "it" search_option_entry "," "then" "shuffle"

destroy_receipt_named_target ::= destroy_receipt_land_target | destroy_receipt_creature_target

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($adjective_nonbasic, @and($noun_land, $modifier_opponent_controls))}), index:0} */
destroy_receipt_land_target ::= "destroy" "target" adjective_nonbasic noun_land modifier_opponent_controls "." "that" "land's"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($adjective_nonbasic, @and($noun_creature, $modifier_opponent_controls))}), index:0} */
destroy_receipt_creature_target ::= "destroy" "target" adjective_nonbasic noun_creature modifier_opponent_controls "." "that" "creature's"

/* @prefer always */
/* @sem Instruction::[...$clause_destroy_receipt_controller_search, ...$instructions] */
instructions_destroy_receipt_sequence ::= clause_destroy_receipt_controller_search "." instructions

/* The cast consumes the adjacent face-down exile receipt from the looked-at cards. */
/* @sem Instruction::[Effect{result:@next, operation:$look_top}, Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@prior), zone:Library}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Transition{result:@prior, phase:After}, filter:AnyOf([$filter_phrase, $adjective_nontype])}, count:Exactly($counter_amount), cost:Free}}]}}] */
instructions_look_exile_filtered_cast ::= look_top "," "then" "exile" "them" "face" "down" "." "then" "you" "may" "cast" counter_amount filter_phrase "or" adjective_nontype "spell" "from" "among" "cards" "exiled" "with" SELF_NAME "without" "paying" "its" "mana" "cost"

/* Keep the reveal, its observed library reorder, and the measured pump in one
   producer-consumer contract. The grouped reorder retains the observation. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_until_all_one}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:$library_order}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[Pump{power:ObjectProperty{object:Query{objects:Observed(@marked), index:0}, property:ManaValue, information:CurrentOrLastKnown}, toughness:$value}], duration:$duration, evaluation:Snapshot}}] */
reveal_until_observed_pump_reorder ::= reveal_until_all_one "." affected "gets" "+" "X" "/" "+" value duration "," "where" "X" "is" "that" "card's" "mana" "value" "." "put" "the" "revealed" "cards" "on" "the" "bottom" "of" "your" "library" library_order

/* A search, its chosen-card action and shuffle form one episode. The callback
   retains the episode's final result identity and its own target frame. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:$search_library}, Effect{result:@next, operation:$found_action}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, announcement:@announcement, body:$reflexive_callback_program})}]} */
search_shuffle_reflexive_program ::= search_library "," found_action "," "then" "shuffle" "." "when" "you" "search" "your" "library" "this" "way" "," reflexive_callback_program

/* @sem Ability::Spell{announcement:_{targets:[]}, body:$search_shuffle_reflexive_program} */
spell_search_shuffle_reflexive ::= search_shuffle_reflexive_program "."

/* The permission is coupled to one card exiled from each player's library;
   its transition receipt cannot be reused with a different producer. */
/* @sem Program::Program{instructions:[ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Shared(Exile), kind:Card, filter:InSet(Earlier{what:Exiled, by:One(AbilityController)})}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any}, terms:_{cost:Free}}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Zone(_{scope:Shared(Exile), kind:Card, filter:AllOf([InSet(Transition{result:@prior, phase:After}), Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:Aggregate{objects:Zone(_{scope:Shared(Exile), kind:Card, filter:InSet(Earlier{what:Exiled, by:One(AbilityController)})}), property:ManaValue, aggregation:Sum}}}])}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any}, terms:_{cost:Free}})], duration:$duration, evaluation:LiveObjects}}]} */
program_each_top_exile_lesser_permission ::= "each" "player" "exiles" "the" "top" "card" "of" "their" "library" "." duration "," "you" "may" "play" "the" "card" "you" "own" "exiled" "this" "way" "and" "each" "other" "card" "exiled" "this" "way" "with" "lesser" "mana" "value" "than" "it" "without" "paying" "their" "mana" "costs" "."

/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$program_each_top_exile_lesser_permission} */
trigger_each_top_exile_lesser_permission ::= "at" turn_event "," program_each_top_exile_lesser_permission

/* The exile producer, remainder and die table share the same arrival and filter. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:RevealUntil{library:Bound(0), filter:@agree($filter_phrase, $filter_phrase_2), count:Constant(1)}}, Effect{result:@mark, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}, ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Matching{objects:Transition{result:@marked, phase:After}, filter:Not(@agree($filter_phrase, $filter_phrase_2))}, zone:Exile}, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}}, If{condition:AllOf([Compare{left:DieResult(@die_roll), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number_digits}}, Compare{left:DieResult(@die_roll), test:NumberTest::Compare{comparison:LessOrEqual, value:$number_digits_2}}]), then:_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Transition{result:@marked, phase:After}, filter:@agree($filter_phrase, $filter_phrase_2)}, count:UpTo($number_words), cost:Free}}]}}]}, otherwise:_{}}, If{condition:AllOf([Compare{left:DieResult(@die_roll), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number_digits_3}}, Compare{left:DieResult(@die_roll), test:NumberTest::Compare{comparison:LessOrEqual, value:$number_digits_4}}]), then:_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Transition{result:@marked, phase:After}, filter:@agree($filter_phrase, $filter_phrase_2)}, count:UpTo($number_words_2), cost:Free}}]}}]}, otherwise:_{}}, If{condition:Compare{left:DieResult(@die_roll), test:NumberTest::Compare{comparison:Equal, value:$number_digits_5}}, then:_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Transition{result:@marked, phase:After}, filter:@agree($filter_phrase, $filter_phrase_2)}, count:UpTo($number_words_3), cost:Free}}]}}]}, otherwise:_{}}] */
instructions_players_exile_until_die_cast ::= players_singular "exiles" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "exile" "an" filter_phrase "card" "," "then" "shuffles" "the" "rest" "into" "their" "library" "." "you" "may" "cast" "up" "to" "X" filter_phrase "spells" "from" "among" "cards" "exiled" "this" "way" "without" "paying" "their" "mana" "costs" "." NEWLINE number_digits "―" number_digits "|" "x" "is" number_words "." NEWLINE number_digits "―" number_digits "|" "x" "is" number_words "." NEWLINE number_digits "|" "x" "is" number_words "."

/* A top-library exile counts controlled creatures at the given power. */
/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController)), Property{property:Power, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number}}])}), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]} */
exile_top_count_controlled_power ::= "exile" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" "the" "number" "of" "creatures" "you" "control" "with" "power" number "or" "greater"

/* The permission and delayed count refer to this exact exile producer. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:$exile_top_count_controlled_power}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Zone{scope:Shared(Exile), kind:Card, filter:InSet(Transition{result:@marked, phase:After})}, origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:UntilNext{point:EndStepBegins, players:One(AbilityController)}, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:One(AbilityController)}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Players(OpponentsOf(AbilityController)), amount:Multiply([$number, CountObjects(Transition{result:@marked, phase:After})]), preventable:true}}]}}}]} */
program_exile_power_play_delayed_damage ::= exile_top_count_controlled_power "." "you" "may" "play" "those" "cards" "until" "your" "next" "end" "step" "." "at" "the" "beginning" "of" "your" "next" "end" "step" "," self_explicit_ref "deals" number "damage" "to" "each" "opponent" "for" "each" "of" "those" "cards" "that" "are" "still" "exiled"

/* The repeated producer is a single card moved from this player's ordered zone to
   exile. Both the name comparison and the optional move consume that receipt. */
repeat_own_library_exile ::= exile_top_card_you | repeat_exile_bottom_card | repeat_exile_top_graveyard

/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
repeat_exile_top_graveyard ::= "exile" "the" "top" "card" "of" "your" "graveyard"

/* @sem Cost::Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]} */
repeat_name_choice_hand ::= "you" "may" "put" "that" "card" "into" "your" "hand"

/* @sem Cost::Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]} */
repeat_name_stop_hand ::= "you" "put" "a" "card" "into" "your" "hand"

/* @sem Cost::Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]} */
repeat_name_choice_graveyard ::= "you" "may" "put" "that" "card" "into" "your" "graveyard"

/* @sem Cost::Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@marked, phase:After, index:0}), zone:Exile}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]} */
repeat_name_stop_graveyard ::= "you" "put" "a" "card" "into" "your" "graveyard"

repeat_name_choice ::= repeat_name_choice_hand | repeat_name_choice_graveyard

repeat_name_stop ::= repeat_name_stop_hand | repeat_name_stop_graveyard

/* @sem Instruction::If{condition:Not(ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:SharesNameWithAny(Zone{scope:Shared(Exile), kind:Card, filter:InSet(Transition{result:@marked, phase:After})})}), then:Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:@agree($repeat_name_choice, $repeat_name_stop), optional:true}}, If{condition:Not(PaymentChosen(@prior)), then:Program{instructions:[Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}]}, otherwise:Program{}} */
repeat_exile_distinct_name_choice ::= repeat_name_choice "unless" "it" "has" "the" "same" "name" "as" "another" "card" "exiled" "this" "way" "." "repeat" "this" "process" "until" repeat_name_stop "or" "you" "exile" "two" "cards" "with" "the" "same" "name" "," "whichever" "comes" "first"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Repeatable{instructions:[Effect{result:@mark, operation:$repeat_own_library_exile}, $repeat_exile_distinct_name_choice]}]}} */
spell_repeat_library_exile_choice ::= repeat_own_library_exile "." repeat_exile_distinct_name_choice "."

/* Unrestricted searches may end in a bare shuffle before a later instruction.
   The singular and plural selected-card references keep their own print shapes. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_any]} */
search_unrestricted_one ::= "search" "your" "library" "for" search_choice_any

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$foreign_choice_count]} */
search_unrestricted_many ::= "search" "your" "library" "for" foreign_choice_count

/* @sem Instruction::[Effect{result:@next, operation:$found_it_hand}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
search_plain_one_follow ::= "," found_it_hand "," "shuffle"

/* @sem Instruction::[Effect{result:@next, operation:$found_plural_hand}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
search_plain_many_follow ::= "," found_plural_hand "," "shuffle"

/* @sem Instruction::[Effect{result:@mark, operation:$search_unrestricted_one}, ...$search_plain_one_follow] */
clause_search_plain_single ::= search_unrestricted_one search_plain_one_follow

/* @sem Instruction::[Effect{result:@mark, operation:$search_unrestricted_many}, ...$search_plain_many_follow] */
clause_search_plain_many ::= search_unrestricted_many search_plain_many_follow

/* A bound player chooses from their own hand, then moves that selection. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}, count:AsManyAsCan($card_count), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:$chosen_hand_library_position, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]} */
bound_hand_library_selection ::= "puts" card_count "from" "their" "hand" chosen_hand_library_position "of" "their" "library"

/* @sem Instruction::[ForEachPlayer{players:$players_each, binding:0, body:$bound_hand_library_selection}] */
clause_each_hand_library_selection ::= players_each bound_hand_library_selection

/* The definition is captured once for the revelation and its bounded selection. */
/* @sem Instruction::[Effect{result:@next, operation:BindValue{value:$value}}, Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:BoundValue(@prior), from:Top}}}, ...$captured_reveal_entry_follow] */
dig_captured_reveal_entry ::= "reveal" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" value "." captured_reveal_entry_follow

/* The choice and its remainder are tied to this observation and move. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:AllOf([$filter_phrase, AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]), Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:BoundValue(@back(3))}}])}, count:UpTo($counter_amount), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
captured_reveal_entry_follow ::= "you" "may" "put" counter_amount filter_phrase "card" "with" "mana" "value" "X" "or" "less" "from" "among" "them" "onto" "the" "battlefield" "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* The reveal, its observed-value consumer, and library reorder share one
   observation receipt. The target is announced before the sequence. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_until_your_filtered_card}, Effect{result:@next, operation:$observed_library_bottom}, Effect{result:@next, operation:$observed_value_target_damage}] */
observed_until_value_damage_reorder ::= "choose" "any" "target" "." reveal_until_your_filtered_card "." observed_value_target_damage "." observed_library_bottom

/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:$library_order} */
observed_library_bottom ::= "put" "the" "revealed" "cards" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Operation::DealDamage{source:$self_explicit_ref, recipients:Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:DamageRecipient, count:Exactly(Constant(1)), filter:Any})), amount:ObjectProperty{object:Query{objects:Observed(@marked), index:0}, property:ManaValue, information:CurrentOrLastKnown}, preventable:true} */
observed_value_target_damage ::= self_explicit_ref "deals" "damage" "equal" "to" "that" "card's" "mana" "value" "to" "that" "permanent" "or" "player"

/* Distinct-name library searches retain their own quality and count. */
/* @sem SearchChoice::SearchChoice{filter:$distinct_search_quality, count:UpTo($count), constraints:[DifferentNames]} */
distinct_search_choice ::= "up" "to" count distinct_search_quality "cards" "with" "different" "names"

distinct_search_quality ::= adjective_monocolored | adjective_multicolored

/* The choice and shuffle operate on the recorded exile receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$distinct_search_choice]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ChooseObjects{player:OneOf(OpponentsOf(AbilityController)), objects:Transition{result:@prior, phase:After}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
distinct_search_opponent_return ::= "search" "your" "library" "for" distinct_search_choice "and" "exile" "them" "." "an" "opponent" "chooses" "one" "of" "those" "cards" "." "shuffle" "that" "card" "into" "your" "library"

/* @sem Instruction::[...$distinct_search_opponent_return, Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Recorded(@marked), count:AnyNumber, cost:Free}}] */
distinct_search_opponent_cast ::= distinct_search_opponent_return "." "you" "may" "cast" "the" "other" "cards" "without" "paying" "their" "mana" "costs"

/* @sem Instruction::[...$distinct_search_opponent_cast, ...$instructions] */
distinct_search_opponent_cast_more ::= distinct_search_opponent_cast "." instructions

/* Keep the stopped-on exile receipt through both the optional cast and the
   subsequent move of the same card if it remains in exile. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:One(@exiled_card_reference), filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:$stat_comparison, value:$value}}}, count:Exactly(Constant(1)), cost:Free}}]}}, Effect{result:@next, operation:Move{objects:InZone{objects:One(@exiled_card_reference), zone:Exile}, destination:OwnersHand(CardArrival{}), qualifiers:[]}}] */
exiled_card_cast_value_uncast_hand ::= "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" "if" "the" "spell's" "mana" "value" "is" stat_comparison value "." "if" "you" "don't" "cast" "that" "card" "this" "way" "," "put" "it" "into" "your" "hand"

/* @sem Instruction::[...$clause_exile_until_card, ...$exiled_card_cast_value_uncast_hand] */
exile_until_cast_value_uncast_hand ::= clause_exile_until_card "." exiled_card_cast_value_uncast_hand

/* Each player keeps a chosen hand subset; the rest goes to that player's shuffled library. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), objects:Zone(_{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), chooser:Players(One(Bound(0))), count:Exactly($card_count)}], action:Move{objects:Difference{objects:Zone(_{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), excluding:Prepared(@selection_id(0))}, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}}]}}] */
clause_each_keep_hand_shuffle_rest ::= players_singular "chooses" "up" "to" card_count "in" "their" "hand" "," "then" "shuffles" "the" "rest" "into" "their" "library"

/* Compose the hand partition with a separate per-player action. */
/* @sem Instruction::[...$clause_each_keep_hand_shuffle_rest, ...$clause_each_lose_unspent_mana] */
instructions_keep_hand_then_mana ::= clause_each_keep_hand_shuffle_rest "." clause_each_lose_unspent_mana

/* A searched subtype's battlefield arrival is the subject of a temporary
   change; agree ties the repeated noun to the current search filter. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:AllOf([@agree($subtype, $subtype_2), AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)])]), count:UpTo(Constant(1))}]}}, Effect{result:@mark, operation:@search_move_result(Operation::Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]})}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(@qualified_object(ObjectKind::Permanent, @agree($subtype, $subtype_2)))), changes:$static_changes, duration:$duration, evaluation:Snapshot}}] */
search_permanent_subtype_temporary_change ::= "search" "your" "library" "for" "a" subtype "permanent" "card" "," "put" "that" "card" "onto" "the" "battlefield" "," "then" "shuffle" "." "that" subtype static_changes duration

/* Keep the any-number search selection bound through reveal, shuffle and reorder. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_any_number}, Effect{result:@next, operation:$found_those_reveal}, ...$search_shuffle_top_them] */
clause_search_any_number_reveal_top ::= search_any_number "," found_those_reveal search_shuffle_top_them

/* @sem Instruction::[Effect{result:@next, operation:Shuffle{players:One(AbilityController), excluding:Selected(@marked)}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@marked), end:Top, order:Chosen}}] */
search_shuffle_top_them ::= "," "then" "shuffle" "and" "put" "them" "on" "top"

/* Keep the reveal, exile arrival, comparison and cast in one scope: both
   references identify the card on which this particular reveal stopped. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:@agree($card_filter, $card_filter_2), count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:DealDamage{source:Source, recipients:$damage_each_recipient, amount:Maximum(Subtract(ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}, ObjectProperty{object:Query{objects:Matching{objects:Transition{result:@prior, phase:After}, filter:@agree($card_filter, $card_filter_2)}, index:0}, property:ManaValue, information:CurrentOrLastKnown}), Subtract(ObjectProperty{object:Query{objects:Matching{objects:Transition{result:@prior, phase:After}, filter:@agree($card_filter, $card_filter_2)}, index:0}, property:ManaValue, information:CurrentOrLastKnown}, ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown})), preventable:true}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Query{objects:Matching{objects:Transition{result:@back(3), phase:After}, filter:@agree($card_filter, $card_filter_2)}, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}] */
exile_until_difference_cast ::= "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" "a" card_filter "card" "." SELF_NAME "deals" "damage" "to" damage_each_recipient "equal" "to" "the" "difference" "between" "that" "spell's" "mana" "value" "and" "that" card_filter "card's" "mana" "value" "." "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost"

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One(EventSubject), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, ...$exile_until_difference_cast] */
exile_subject_then_difference_cast ::= "exile" "it" "," "then" exile_until_difference_cast

/* @sem Ability::Triggered{event:$first_cast_difference_event, limits:_{}, announcement:@announcement, body:Program{instructions:$exile_subject_then_difference_cast}} */
triggered_first_cast_exile_difference ::= "whenever" first_cast_difference_event "," exile_subject_then_difference_cast "."

first_cast_difference_event ::= event_cast_first_spell_each_turn | event_first_instant_sorcery_subtype

/* The choice and remainder share the observation and the actual battlefield move. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$filter_phrase}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Random}}] */
observed_optional_tapped_remainder ::= "you" "may" "put" "a" filter_phrase "card" "from" "among" "them" "onto" "the" "battlefield" "tapped" "." "put" "the" "rest" "on" "the" "bottom" "in" "a" "random" "order"

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$observed_optional_tapped_remainder] */
dig_look_optional_tapped_remainder ::= look_top "." observed_optional_tapped_remainder

/* One announced player owns the library and receives the casting restriction;
   both continuous effects expire together. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One($library_access_target)), changes:[PlayerRule(Prohibit(CastSpell{filter:$cast_spells_filter}))], duration:$library_access_duration, evaluation:LiveObjects}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One($library_access_target)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, origins:CardPlayOrigins([Library]), action:$exiled_play_action, filter:Any}, terms:_{cost:Normal, spend_as:AnyColor, may_look:true}})], duration:$library_access_duration, evaluation:LiveObjects}}]} */
chosen_player_library_program ::= "choose" library_access_target "." library_access_duration "," "that" "player" "can't" "cast" cast_spells_filter "," "you" "may" "look" "at" "the" "top" "card" "of" "their" "library" "any" "time" "," "you" "may" exiled_play_action "the" "top" "card" "of" "their" "library" "," "and" "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "spells" "this" "way"

library_access_target ::= target_opponent | target_player

library_access_duration ::= library_access_end_combat | duration

/* @prefer always */
/* @sem Duration::EndOfCombat */
library_access_end_combat ::= "until" "end" "of" "combat"

/* Two independently bounded choices consume the same observation in sequence. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$dig_first_bounded_card, ...$dig_second_bounded_card, $dig_two_choices_rest] */
dig_reveal_two_choices ::= reveal_top "." dig_first_bounded_card "and" dig_second_bounded_card "." "put" dig_two_choices_rest

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$filter_phrase}, count:UpTo($n1), constraints:[CanMoveTo{destination:$dig_destination}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}] */
dig_first_bounded_card ::= "you" "may" "put" "up" "to" n1 filter_phrase "card" "from" "among" "them" dig_destination

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, filter:$filter_phrase}, count:UpTo($n1), constraints:[CanMoveTo{destination:$dig_destination}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}] */
dig_second_bounded_card ::= "up" "to" n1 filter_phrase "card" "from" "among" "them" dig_destination

/* @sem Instruction::Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(4), phase:Before}, Transition{result:@back(2), phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}} */
dig_two_choices_rest ::= "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* Keep the mill and its damage measure together: those cards are the cards
   just milled by this program, not an arbitrary earlier movement receipt. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:$mill_choice_target, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$count_plural}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:[Effect{result:@next, operation:Mill{players:One(AbilityController), amount:$count_plural_2}}, Effect{result:@next, operation:DealDamage{source:$self_explicit_ref, recipients:Players(One(Target{slot:@last_slot, index:0})), amount:Earlier{what:Milled, measure:Total(ManaValue)}, preventable:true}}]}, otherwise:Program{}}]} */
mill_choice_damage_program ::= mill_choice_target "may" "have" "you" "draw" count_plural "cards" "." "if" "the" "player" "doesn't" "," "you" "mill" count_plural "cards" "," "then" self_explicit_ref "deals" "damage" "to" "that" "player" "equal" "to" "the" "total" "mana" "value" "of" "those" "cards" "."

mill_choice_target ::= target_opponent | target_player

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$mill_choice_damage_program} */
triggered_mill_choice_damage ::= event_clause "," mill_choice_damage_program

/* The activation wrapper proves the sacrifice receipt and its component address. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$observed_sacrifice_value_entry] */
reveal_sacrifice_value_entry ::= reveal_top "." observed_sacrifice_value_entry

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$filter_phrase}, count:UpTo($value), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}, TotalProperty{property:ManaValue, comparison:LessOrEqual, amount:ObjectProperty{object:Query{objects:CostObjects{payment:Activation, component:[2], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(2), phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
observed_sacrifice_value_entry ::= "put" "up" "to" value filter_phrase "cards" "with" "total" "mana" "value" "less" "than" "or" "equal" "to" "the" "sacrificed" "artifact's" "mana" "value" "from" "among" "them" "onto" "the" "battlefield" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, $cost_tap, Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(Source)), CardType(Artifact)])}, choose:Exactly(Constant(1))}]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:$reveal_sacrifice_value_entry}} */
activated_reveal_sacrifice_value_entry ::= cost_mana "," cost_tap "," "↑" "sacrifice" "another" "artifact" ":" reveal_sacrifice_value_entry "."

/* The total mana value limits the chosen group; both effects share its destination. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$search_filter_many}, count:UpTo($count), constraints:[CanMoveTo{destination:$dig_destination}, TotalProperty{property:ManaValue, comparison:LessOrEqual, amount:$value}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}] */
dig_put_upto_total_mana ::= "put" "up" "to" count search_filter_many "with" "total" "mana" "value" value "or" "less" "from" "among" "them" dig_destination

/* A second selection excludes the first departure; the final remainder excludes both.
   The complete sequence keeps the observation and both move receipts in scope. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$dig_put_may_one, ...$dig_second_optional_take, $dig_two_move_graveyard] */
dig_reveal_two_destinations ::= reveal_top "." dig_put_may_one "." dig_second_optional_take "." dig_two_move_graveyard

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, filter:$a_card}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:$dig_destination}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}] */
dig_second_optional_take ::= "you" "may" "put" a_card "from" "among" "them" dig_destination

/* @sem Instruction::Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(4), phase:Before}, Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}} */
dig_two_move_graveyard ::= "put" "the" "rest" "into" "your" "graveyard"

/* The look establishes the observation; the continuation owns the selection,
   battlefield move and its reflexive attachment together. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$dig_entry_attach] */
dig_look_entry_attach ::= look_top "." dig_entry_attach

/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:@agree($filter_phrase, $filter_phrase_2)}, count:AnyNumber, constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:AttachChosen{actor:One(AbilityController), attachments:Transition{result:@marked, phase:After}, count:Exactly($counter_amount), hosts:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase_3}}}]}}]}})}]}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::RemainingToBottomAtRandom}}] */
dig_entry_attach ::= "you" "may" "put" "any" "number" "of" filter_phrase "cards" "from" "among" "them" "onto" "the" "battlefield" "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order" "." "when" "you" "put" "one" "or" "more" filter_phrase "onto" "the" "battlefield" "this" "way" "," "you" "may" "attach" counter_amount "of" "them" "to" "a" filter_phrase

/* The search, selected-card exile and owner's shuffle share one player and receipt. */
foreign_exile_library_owner ::= target_possessive | zone_that_player

/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:$foreign_exile_library_owner, choices:[$player_search_many_choice]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($foreign_exile_library_owner)}}] */
clause_foreign_library_exile ::= "search" foreign_exile_library_owner "library" "for" player_search_many_choice "," "exile" "them" "," "then" "that" "player" "shuffles"

/* Reveal a vote-counted population and move its matching members before shuffling. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:@agree($filter_phrase, $filter_phrase_2), count:Votes(Word($vote_word))}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:@agree($filter_phrase, $filter_phrase_2)}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
reveal_vote_filtered_battlefield_shuffle ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "a" filter_phrase "card" "for" "each" vote_word "vote" "." "put" "those" filter_phrase "cards" "onto" "the" "battlefield" "," "then" "shuffle" "the" "rest" "into" "your" "library"

/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:@agree($vote_vowel_noun, $vote_vowel_noun_2), count:Votes(Word($vote_word))}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:@agree($vote_vowel_noun, $vote_vowel_noun_2)}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
reveal_vote_vowel_battlefield_shuffle ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "an" vote_vowel_noun "card" "for" "each" vote_word "vote" "." "put" "those" vote_vowel_noun "cards" "onto" "the" "battlefield" "," "then" "shuffle" "the" "rest" "into" "your" "library"

vote_vowel_noun ::= noun_artifact | noun_enchantment

/* The sequence establishes the target before using its controller as an antecedent. */
/* @sem Instruction::[Effect{result:@next, operation:$target_controller_sacrifice}, $target_controller_optional_search] */
instructions_controller_sacrifice_optional_search ::= target_controller_sacrifice "." target_controller_optional_search

/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:One(ControllerOf($sacrifice_controller_target)), objects:One($sacrifice_controller_target)}) */
target_controller_sacrifice ::= sacrifice_controller_target "controller" "sacrifices" "it"

/* The target supplies every player role; the search receipt supplies the moved card. */
/* @sem Instruction::Optional{decider:ControllerOf(Target{slot:0, index:0}), body:Program{instructions:[Effect{result:@next, operation:Search{searcher:ControllerOf(Target{slot:0, index:0}), library_owner:ControllerOf(Target{slot:0, index:0}), choices:[$search_choice_filtered]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(ControllerOf(Target{slot:0, index:0})), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf(Target{slot:0, index:0}))}}]}} */
target_controller_optional_search ::= "that" "player" "may" "search" "their" "library" "for" search_choice_filtered "," "put" "it" "onto" "the" "battlefield" "," "then" "shuffle"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@and($sacrifice_creature_qualifier, ObjectFilter::CardType(Creature))}), index:0} */
sacrifice_controller_target ::= "target" sacrifice_creature_qualifier "creature's"

sacrifice_creature_qualifier ::= noun_artifact | noun_enchantment

/* A repeated look uses the same library slice before and after each payment.
   The recorded slice is retained for the subsequent shuffle and reorder. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:@agree($top_count, $top_count_2), from:Top}}}, Repeatable{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$cost, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:@agree($top_count, $top_count_2), from:Top}, zone:Library}, end:Bottom, order:Chosen}}, Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:@agree($top_count, $top_count_2), from:Top}}}, Effect{result:@next, operation:RepeatProcess}]}, otherwise:Program{}}]}, Effect{result:@mark, operation:NoteObjects{objects:InZone{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:@agree($top_count, $top_count_2), from:Top}, zone:Library}}}] */
look_repeat_paid_bottom ::= "look" "at" "the" "top" top_count "of" "your" "library" "." "as" "many" "times" "as" "you" "choose" "," "you" "may" cost "," "put" "those" "cards" "on" "the" "bottom" "of" "your" "library" "in" "any" "order" "," "then" "look" "at" "the" "top" top_count "of" "your" "library"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$look_repeat_paid_bottom, ...$last_look_shuffle_top]}} */
spell_repeat_paid_look ::= look_repeat_paid_bottom "." last_look_shuffle_top "."

/* The permission consumes the arrival of this exact exile action. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@prior, phase:After}, origins:CardPlayOrigins([Exile]), action:CastSpell, filter:Any})], duration:$duration, evaluation:LiveObjects}}] */
instructions_top_exile_timed_cast ::= exile_top_cards_of_your_library "." duration "," "you" "may" "cast" "spells" "from" "among" "them"

/* The selected card comes from the damaged player's library and the move supplies its arrival. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(EventSubject)}, kind:Card, filter:$filter_phrase}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_random_event_library_exile ::= "exile" "a" "random" filter_phrase "card" "from" "that" "player's" "library"

/* A random library selection moves face down before its controller looks at
   the actual arrival receipt. The access continuation consumes that receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:AsManyAsCan($random_library_amount), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:LookAt{player:AbilityController, objects:Transition{result:@prior, phase:After}}}] */
random_library_exile_look ::= "exile" random_library_amount "random" "cards" "from" "your" "library" "face" "down" "and" "look" "at" "them"

/* @sem Instruction::[...$random_library_exile_look, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@back(3), phase:After}, origins:CardPlayOrigins([Exile]), action:$exiled_play_action, filter:Any}, terms:_{limit:Total($random_access_limit), cost:Normal}})], duration:WhileAnyExiled(Transition{result:@back(3), phase:After}), evaluation:LiveObjects}}] */
instructions_random_library_exile_access ::= random_library_exile_look "." "for" "as" "long" "as" "they" "remain" "exiled" "," "you" "may" exiled_play_action random_access_limit "of" "those" "cards"

/* @sem u32::1 */
random_access_limit ::= "one"

random_library_amount ::= exiled_threshold_words | value

/* Two players independently reveal a library slice, put at most one matching
   card onto their own battlefield, and move the untaken cards to their owners'
   graveyards. The repeated instruction copies the original filter and choice. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($target_opponent)}, kind:Card, filter:Any}, count:$top_many, from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:$target_opponent, objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:$a_card}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player($target_opponent), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player($target_opponent), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:$card_count, from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:$a_card}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
mirrored_entry_pair ::= target_opponent "reveals" "the" "top" top_many "of" "their" "library" "," "may" "put" a_card "from" "among" "them" "onto" "the" "battlefield" "," "then" "puts" "the" "rest" "into" "their" "graveyard" "." "you" "do" "the" "same" "with" "the" "top" card_count "of" "your" "library"

/* This continuation is available only after the two singleton entry choices;
   each fight participant is the arrival from the corresponding choice. */
/* @sem Instruction::[...$mirrored_entry_pair, $mirrored_entry_fight] */
mirrored_entry_pair_fight ::= mirrored_entry_pair "." mirrored_entry_fight

/* @sem Instruction::If{condition:AllOf([Compare{left:Earlier{what:Entered, measure:Count, result:@back(6), filter:ObjectFilter::@agree($filter_plural, $filter_plural_2), by:Target{slot:@last_slot, index:0}}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, Compare{left:Earlier{what:Entered, measure:Count, result:@prior, filter:ObjectFilter::@agree($filter_plural, $filter_plural_2), by:AbilityController}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}]), then:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:Recorded{result:@back(3), by:AbilityController}, second:Recorded{result:@back(7), by:Target{slot:@last_slot, index:0}}}}}]}, otherwise:Program{}} */
mirrored_entry_fight ::= "if" "two" filter_plural "are" "put" "onto" "the" "battlefield" "this" "way" "," "those" filter_plural "fight" "each" "other"

/* @sem Instruction::[...$dig_put_take, $dig_rest_and] */
dig_follow_joined_regular ::= dig_put_take dig_rest_and

dig_many_filter ::= search_filter_many | dig_permanent_cards

/* @sem ObjectFilter::AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]) */
dig_permanent_cards ::= "permanent" "cards"

/* The remainder excludes the immediately preceding selected-card move. */
/* @sem Instruction::[...$dig_put_any, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
dig_any_rest_hand ::= dig_put_any "and" "the" "rest" "into" "your" "hand"

/* Shared noun alternatives retain the basic qualifier on the second branch. */
/* @sem ObjectFilter::AnyOf([$noun, @and(ObjectFilter::Supertype(Basic), $noun_2)]) */
search_filter_noun_or_basic ::= noun "or" "basic" noun "card"

/* A paid search keeps the selection receipt shared by its follow-ups. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[SearchChoice{filter:$search_filter_noun_or_basic, count:UpTo(Constant(1))}]}}, ...$search_follow]}, otherwise:Program{}}] */
clause_paid_search_noun_or_basic ::= "you" "may" payment "." "if" "you" "do" "," "search" "your" "library" "for" ("a" | "an") search_filter_noun_or_basic search_follow

/* A card may satisfy either of two named keyword families. */
/* @sem SearchChoice::SearchChoice{filter:AnyOf(@unordered([HasKeywordFamily($search_keyword_family), HasKeywordFamily($search_keyword_family_2)])), count:UpTo(Constant(1))} */
search_choice_keyword_family_pair ::= "a" "card" "with" search_keyword_family "or" search_keyword_family

search_keyword_family ::= payment_keyword | mechanic_disturb_name | mechanic_embalm_name | mechanic_eternalize_name | mechanic_mutate_name

/* The selected cards and the remainder share the reveal observation. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:ObjectProperty{object:Source, property:$stat, information:CurrentOrLastKnown}, from:Top}}}, Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:AnyOf([$noun, $subtype])}, count:AnyNumber, constraints:[$return_different_property]}], action:Move{objects:Prepared(@selection_id(0)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@back(3)), zone:Library}, end:Bottom, order:$library_order}}]} */
reveal_distinct_selection_program ::= "reveal" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" "its" stat "." "put" "any" "number" "of" noun "and" "/" "or" subtype "cards" "with" "different" return_different_property "from" "among" "them" "into" "your" "hand" "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* Either named card is one search choice, with both names retained as operands. */
/* @sem SearchChoice::SearchChoice{filter:AnyOf(@unordered([Name($referenced_card_name), Name($referenced_card_name_2)])), count:UpTo(Constant(1))} */
search_choice_named_pair ::= "a" "card" "named" referenced_card_name "or" referenced_card_name

/* Each name is an independent operand of the library search choice. */
/* @sem SearchChoice::SearchChoice{filter:AnyOf(@unordered([Name($referenced_card_name), Name($referenced_card_name_2)])), count:UpTo(Constant(1))} */
search_choice_named_pair_one ::= "a" "card" "named" referenced_card_name "or" referenced_card_name

/* @sem SearchChoice::SearchChoice{filter:AnyOf(@unordered([Name($referenced_card_name), Name($referenced_card_name_2)])), count:UpTo($count)} */
search_choice_named_pair_many ::= "up" "to" count "cards" "named" referenced_card_name "or" referenced_card_name

/* The plural choice feeds plural anaphors in its follow-up instructions. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_named_pair_many]} */
search_named_pair_plural ::= "search" "your" "library" "for" search_choice_named_pair_many

/* The reveal and the two dispositions share one observation and its move receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:BoundValue(@prior), from:Top}}}, Effect{result:@next, operation:Move{objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:AnyOf([$subtype, $subtype_2])}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
paid_x_reveal_subtypes ::= "reveal" "the" "top" "X" "cards" "of" "your" "library" "," "put" "all" subtype "and" subtype "cards" "from" "among" "them" "into" "your" "hand" "," "then" "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[ManaWithX{mana:[X]}]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:_{instructions:$paid_x_reveal_subtypes}, otherwise:_{}}]} */
paid_x_reveal_program ::= "you" "may" "pay" "{" "X" "}" "." "if" "you" "do" "," paid_x_reveal_subtypes

/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$paid_x_reveal_program} */
triggered_paid_x_reveal ::= event_clause "," paid_x_reveal_program "."

/* A bounded plural search can use any post-nominal card filter. */
/* @sem SearchChoice::SearchChoice{filter:$modifier, count:UpTo($count)} */
search_choice_many_modified ::= "up" "to" count "cards" modifier

/* Plural follow-ups keep their pronouns tied to this bounded choice. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_many_modified]} */
search_library_many_modified ::= "search" "your" "library" "for" search_choice_many_modified

/* A comparative card filter retains both its base kind and the linked reference. */
/* @sem ObjectFilter::AllOf([$adjective_nontype, Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:$linked_exiled_card, property:ManaValue, information:CurrentOrLastKnown}}}]) */
a_card_lesser_linked ::= "a" adjective_nontype "card" "with" "lesser" "mana" "value" "than" linked_exiled_card

/* A named player's seek chooses from that player's own library. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$linked_exiled_card_owner, objects:Zone{scope:Players{zone:Library, players:One($linked_exiled_card_owner)}, kind:Card, filter:$a_card}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_linked_owner_seeks ::= linked_exiled_card_owner "seeks" a_card

/* Each alternative is a singular library search; the shared continuation
   consumes the selection produced in the branch actually taken. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:$filter_phrase, count:UpTo(Constant(1))}]} */
search_singular_filtered_phrase ::= "search" "your" "library" "for" "a" filter_phrase "card"

/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@mark, operation:$search_singular_filtered_phrase_2}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:Program{instructions:[Effect{result:@mark, operation:$search_singular_filtered_phrase}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}}] */
instructions_conditional_search_hand ::= search_singular_filtered_phrase "." "if" condition "," "instead" search_singular_filtered_phrase "." "reveal" "that" "card" "," "put" "it" "into" "your" "hand" "," "then" "shuffle"

/* This anaphoric action is used only after an explicit source-creature condition. */
/* @sem Operation::Move{objects:One(Source), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
owner_shuffles_condition_source ::= "its" "owner" "shuffles" "it" "into" "their" "library"

/* @sem Ability::Triggered{event:$turn_event, intervening_if:$condition_source_attacked_or_blocked_this_turn, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$source_owner_library_action}]}} */
triggered_source_combat_owner_shuffle ::= "at" turn_event "," "if" condition_source_attacked_or_blocked_this_turn "," source_owner_library_action "."

source_owner_library_action ::= owner_shuffles_condition_source | owner_puts_condition_source_on_top

/* @sem Operation::Move{objects:One(Source), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
owner_puts_condition_source_on_top ::= "its" "owner" "puts" "it" "on" "top" "of" "their" "library"

/* Random selection and its exile arrival are a reusable singleton producer. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_random_library_exile ::= "exile" "a" "random" "card" "from" "your" "library"

/* The singleton permission is scoped to the preceding exile arrival. */
/* @sem Instruction::[...$clause_random_library_exile, Effect{result:@next, operation:$exile_singleton_free_permission}] */
instructions_random_exile_free_play ::= clause_random_library_exile "." exile_singleton_free_permission

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any}, terms:_{cost:Free}})], duration:$duration, evaluation:LiveObjects} */
exile_singleton_free_permission ::= duration "," "you" "may" "play" "that" "card" "without" "paying" "its" "mana" "cost"

/* Naming and revealing are independent instructions; the two following
   player-scoped clauses preserve the player's own choice and library. */
/* @sem Instruction::ForEachPlayer{players:All, binding:0, body:_{instructions:[Effect{result:@next, operation:ChooseValue{choosers:One(Bound(0)), kind:CardName, terms:_{count:Exactly(Constant(1)), options:[Term{family:CardsInOracle, form:AnyOracleCard}]}}}]}} */
each_player_names_card ::= "each" "player" "chooses" "a" "card" "name"

/* @sem Instruction::Effect{result:@next, operation:Reveal{objects:LibraryTops(All)}} */
each_player_reveals_library_top ::= "then" "each" "player" "reveals" "the" "top" "card" "of" "their" "library"

/* @sem Instruction::ForEachPlayer{players:Matching{binding:0, condition:Compare{left:Earlier{what:Revealed, measure:Count, filter:Chosen(CardName), by:Bound(0)}, test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}}, binding:0, body:_{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:$named_reveal_destination, qualifiers:[]}}]}} */
matching_named_reveal_move ::= "if" "the" "card" "a" "player" "revealed" "has" "the" "name" "they" "chose" "," "that" "player" "puts" "it" named_reveal_destination

/* @sem Instruction::ForEachPlayer{players:Matching{binding:0, condition:Compare{left:Earlier{what:Revealed, measure:Count, filter:Chosen(CardName), by:Bound(0)}, test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}}, binding:0, body:_{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:$named_reveal_destination, qualifiers:[]}}]}} */
nonmatching_named_reveal_move ::= "if" "it" "doesn't" "," "that" "player" "puts" "it" named_reveal_destination

named_reveal_destination ::= named_reveal_hand | named_reveal_bottom | named_reveal_top | named_reveal_graveyard

/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
named_reveal_hand ::= "into" "their" "hand"

/* @sem MovementDestination::Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
named_reveal_bottom ::= "on" "the" "bottom" "of" "their" "library"

/* @sem MovementDestination::OwnersGraveyard(CardArrival{counters:[], states:[]}) */
named_reveal_graveyard ::= "into" "their" "graveyard"

/* @sem Instruction::[$each_player_names_card, $each_player_reveals_library_top, $matching_named_reveal_move, $nonmatching_named_reveal_move] */
instructions_each_names_reveal_branches ::= each_player_names_card "." each_player_reveals_library_top "." matching_named_reveal_move "." nonmatching_named_reveal_move

/* @sem MovementDestination::Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
named_reveal_top ::= "on" "the" "top" "of" "their" "library"

/* The life measurements refer to the card revealed by the enclosing top-card test. */
/* @sem Instruction::[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:Earlier{what:Revealed, measure:Of($revealed_card_stat)}}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:Earlier{what:Revealed, measure:Of($revealed_card_stat_2)}}}, ...$top_reveal_put] */
observed_reveal_life_pair_then_put ::= "you" "gain" "life" "equal" "to" "that" "card's" revealed_card_stat "," "lose" "life" "equal" "to" "its" revealed_card_stat "," "then" top_reveal_put

revealed_card_stat ::= stat_power | stat_toughness

/* Consecutive searches keep each selected-card identity within its own sentence. */
/* @sem Instruction::[Effect{result:@mark, operation:$search}, Effect{result:@next, operation:$found_action}] */
search_action_before_followup ::= search "and" found_action

/* @prefer always */
/* @sem Instruction::[...$search_action_before_followup, ...$clause_search] */
instructions_search_action_followup ::= search_action_before_followup "." clause_search

/* The comparison and its life-history threshold are operands of the population
   over which the maximum is computed. */
/* @sem ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:Aggregate{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:$stat_comparison, value:$life_gained_bound}}}), property:ManaValue, aggregation:Maximum}}} */
a_card_maximum_mana_life ::= "a" "card" "with" "the" "highest" "mana" "value" "among" "cards" "in" "your" "library" "with" "mana" "value" stat_comparison life_gained_bound

/* A single revealed library card supplies both the type test and branch references. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:$observed_top_reveal_branch}, otherwise:Program{}}] */
observed_top_revealed_test ::= "reveal" "the" "top" "card" "of" "your" "library" "." "if" top_reveal_quality "is" "revealed" "this" "way" "," observed_top_reveal_branch

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:$observed_top_revealed_test}}]}} */
trigger_optional_observed_top_test ::= event_clause "," "you" "may" observed_top_revealed_test "."

/* A look-and-hand split can be followed by an independent instruction. */
/* @sem Instruction::[...$look_put_ordered, ...$instructions] */
look_put_following ::= look_put_ordered "." instructions

/* The selection and subsequent random discard have independent counts. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_unrestricted_one}, Effect{result:@next, operation:$search_selected_hand}, ...$random_discard_search_tail] */
clause_search_unrestricted_random_one ::= search_unrestricted_one "," search_selected_hand random_discard_search_tail

/* @sem Instruction::[Effect{result:@mark, operation:$unrestricted_search_many}, Effect{result:@next, operation:$found_plural_those_hand}, ...$random_discard_search_tail] */
clause_search_unrestricted_random_many ::= unrestricted_search_many "," found_plural_those_hand random_discard_search_tail

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[SearchChoice{filter:Any, count:AsManyAsCan($count_plural)}]} */
unrestricted_search_many ::= "search" "your" "library" "for" count_plural "cards"

/* @sem Instruction::[Effect{result:@next, operation:$search_random_discard}, ...$search_shuffle] */
random_discard_search_tail ::= "," search_random_discard search_shuffle

/* @sem Operation::Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
found_plural_those_hand ::= "put" "those" "cards" "into" "your" "hand"

/* @sem Operation::Discard{players:One(AbilityController), amount:$card_count, random:true} */
search_random_discard ::= "discard" card_count "at" "random"

/* @sem Program::Program{instructions:$shared_reveal_until_entry_graveyard} */
shared_payment_reveal_graveyard ::= shared_reveal_until_entry_graveyard

own_reveal_partition_destination ::= until_destination | until_battlefield_tapped_attacking

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}} */
until_battlefield_tapped_attacking ::= "onto" "the" "battlefield" "tapped" "and" "attacking"

/* @sem Program::Program{instructions:$own_reveal_partition_program} */
shared_payment_reveal_partition ::= own_reveal_partition_program

/* The look supplies the observed population; the choice retains the cards not
   reordered. Both references belong to this same producer-consumer phrase. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($number_words)}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Selected(@prior)])}, zone:Library}, end:Bottom, order:$library_order}}] */
look_leave_some_bottom ::= look_top "," "put" "all" "but" number_words "of" "them" "on" "the" "bottom" "of" "your" "library" library_order

/* The same target owns both the revealed hand and the graveyard; the
   two alternatives each move only their own selected card. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone(_{scope:Players{zone:Hand, players:One($target_opponent)}, kind:Card, filter:Any})}}, ChooseOne{decider:AbilityController, options:[_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One($target_opponent)}, kind:Card, filter:$adjective_nontype}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}, _{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Graveyard, players:One($target_opponent)}, kind:Card, filter:Any}), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}]}] */
clause_revealed_hand_or_graveyard_exile ::= target_opponent "reveals" "their" "hand" "." "you" "choose" "a" adjective_nontype "card" "from" "it" "or" "a" "card" "from" "their" "graveyard" "." "exile" "that" "card"

/* Keep the next instruction as its own sentence after this choice. */
/* @prefer always */
/* @sem Instruction::[...$clause_revealed_hand_or_graveyard_exile, ...$instructions] */
instructions_revealed_hand_or_graveyard_more ::= clause_revealed_hand_or_graveyard_exile "." instructions

/* The singular search, entry and shuffle form one group. Both later effects
   refer to that group's battlefield arrival, not the intervening shuffle. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$search_single_library}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@marked, phase:After, index:0})), changes:$static_changes, duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Result{result:@marked, phase:After, index:0}), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}}]} */
program_search_entry_grant_return ::= search_single_library "," "put" "it" "onto" "the" "battlefield" "," "then" "shuffle" "." "it" static_changes "." "return" "it" "to" "your" "hand" "at" "the" "beginning" "of" "the" "next" "end" "step" "."

/* The condition observes precisely the immediately preceding reveal. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:$reveal_top}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$filter_phrase}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$counter_amount}}, then:Program{instructions:[Effect{result:@next, operation:$reveal_matching_followup}]}, otherwise:Program{}}]}}] */
optional_reveal_matching_followup ::= "you" "may" reveal_top "." "if" "you" "reveal" counter_amount filter_phrase "card" "this" "way" "," reveal_matching_followup

reveal_matching_followup ::= copy_revealed_for_duration | operation

/* The animation refers to the arrivals of this specific land search, not the
   search selection or an arbitrary preceding transition. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:AllOf([Supertype(Basic), CardType(Land)]), count:AnyNumber}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
search_basic_lands_to_battlefield ::= "search" "your" "library" "for" "any" "number" "of" "basic" "land" "cards" "," "put" "them" "onto" "the" "battlefield" "," "then" "shuffle"

/* @sem Program::Program{instructions:[...$search_basic_lands_to_battlefield, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Transition{result:@back(3), phase:After}), changes:$land_arrival_animation, duration:Indefinite, evaluation:Snapshot}}]} */
program_search_lands_animate ::= search_basic_lands_to_battlefield "." "those" "lands" land_arrival_animation "." "they're" "still" "lands" "."

until_reveal_destination ::= until_reveal_ordinary | until_reveal_attached

/* @sem $until_destination */
until_reveal_ordinary ::= until_destination "and"

/* @sem $until_battlefield_attached_event */
until_reveal_attached ::= until_battlefield_attached_event "," "then" "put"

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo(EventSubject)]}} */
until_battlefield_attached_event ::= "onto" "the" "battlefield" "attached" "to" "that" "creature"

/* The reference in this choice is scoped to the third activation cost, a
   single sacrificed creature, by the enclosing activation below. */
/* @sem SearchChoice::SearchChoice{filter:AllOf([$filter_phrase, Shares{property:CreatureTypes, with:Query{objects:CostObjects{payment:Activation, component:[2], view:Inputs, phase:Before}, index:0}}, Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:Add($number_digits, ObjectProperty{object:Query{objects:CostObjects{payment:Activation, component:[2], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown})}}]), count:UpTo(Constant(1))} */
activation_sacrificed_shared_type_choice ::= "a" filter_phrase "card" "that" "shares" "a" "creature" "type" "with" "the" "sacrificed" "creature" "and" "has" "mana" "value" "equal" "to" number_digits "plus" "that" "creature's" "mana" "value"

/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$activation_sacrificed_shared_type_choice]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
activation_sacrificed_shared_type_search ::= "search" "your" "library" "for" activation_sacrificed_shared_type_choice "." "put" "that" "card" "onto" "the" "battlefield" "," "then" "shuffle"

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_mana, $cost_tap, Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:CardType(Creature)}, choose:Exactly(Constant(1))}]}, limits:$limit_sorcery, announcement:@announcement, body:Program{instructions:$activation_sacrificed_shared_type_search}} */
activation_sacrifice_creature_shared_type_search ::= cost_mana "," cost_tap "," "↑" "sacrifice" "a" "creature" ":" activation_sacrificed_shared_type_search "." limit_sorcery "."

/* The searched selection remains in scope through optional entry and the hand fallback. */
/* @sem Instruction::[Effect{result:@mark, operation:$search}, Effect{result:@next, operation:$search_selected_reveal}, If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:$search_optional_that_card_entry}]}, otherwise:Program{}}, Effect{result:@next, operation:$found_it_hand}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
clause_search_optional_entry_fallback ::= search "and" search_selected_reveal "." "if" condition "," search_optional_that_card_entry "." "if" "you" "don't" "put" "the" "card" "onto" "the" "battlefield" "," found_it_hand "." "then" "shuffle"

/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Selected(@marked), count:AnyNumber, constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:Battlefield{controller:Owner, arrival:$search_option_entry}, qualifiers:[]}} */
search_optional_that_card_entry ::= "you" "may" "put" "that" "card" search_option_entry

/* Shared player and stopping-filter phrases. The enclosing instruction proves
   the exile arrival for both the cast and the cleanup. */
/* @sem PlayerRef::$player_ref */
exile_until_player_library ::= player_ref "exiles" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "exile"

/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:$exile_until_player_library, filter:$reveal_until_single_card, count:Constant(1)}}, Effect{result:@mark, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Query{objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$reveal_until_single_card}, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:Library{position:BottomRandom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
instructions_exile_until_cast_cleanup ::= exile_until_player_library reveal_until_single_card "." "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" "." "then" "put" "the" "exiled" "cards" "that" "weren't" "cast" "this" "way" "on" "the" "bottom" "of" "that" "library" "in" "a" "random" "order"

/* A choice of library ends keeps the same selected hand population in each arm. */
/* @sem Instruction::[ChooseOne{decider:AbilityController, options:[_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$hand_library_choice_cards}, count:AsManyAsCan($n2)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:$cost_library_end, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}, _{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$hand_library_choice_cards}, count:AsManyAsCan($n2)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:$cost_library_end_2, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}]}] */
clause_hand_library_end_choice ::= "put" n2 hand_library_choice_cards "from" "your" "hand" "both" cost_library_end "of" "your" "library" "or" "both" cost_library_end "of" "your" "library"

hand_library_choice_cards ::= random_any_cards | search_many_plain

/* The complete span proves that the name search consumes the preceding
   hand selection's exile arrivals, including during inverse printing. */
/* @sem Instruction::[...$clause_revealed_opponent_hand_exile_x, Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:Target{slot:0, index:0}, choices:[_{filter:SharesNameWithAny(Transition{result:@prior, phase:After}), count:AnyNumber}], also:[Graveyard, Hand]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Target{slot:0, index:0})}}] */
instructions_hand_exile_names_search ::= clause_revealed_opponent_hand_exile_x "." "for" "each" "card" "exiled" "this" "way" "," "search" "that" "player's" "graveyard" "," "hand" "," "and" "library" "for" "any" "number" "of" "cards" "with" "the" "same" "name" "as" "that" "card" "and" "exile" "them" "." "then" "that" "player" "shuffles"

/* @sem Instruction::[...$player_reveal_single_tapped_partition] */
player_reveal_tapped_graveyard ::= player_reveal_single_tapped_partition

/* One reveal produces both the stopped card and the remainder. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:$player_ref, filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$card_filter}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
player_reveal_single_tapped_partition ::= player_ref "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" "a" card_filter "card" "." "put" "that" "card" "onto" "the" "battlefield" "tapped" "under" "your" "control" "and" "the" "rest" "into" "their" "graveyard"

/* The look and selection share a library owner, and the remainder excludes the
   actual face-down move. Both counts and the order remain printable operands. */
/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One($look_target_opponent)}, kind:Card, filter:Any}, count:$number, from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($value), constraints:[CanMoveTo{destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:$look_target_opponent, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
opponent_look_exile_remainder ::= "look" "at" "the" "top" number "cards" "of" look_target_opponent "library" "," "exile" value "of" "them" "face" "down" "," "then" "put" "the" "rest" "on" "the" "bottom" "of" "their" "library" library_order

/* The permission consumes the face-down exile arrival in the immediately
   preceding group, rather than an arbitrary prior transition. */
/* @sem Instruction::[...$opponent_look_exile_remainder, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@back(3), phase:After}, origins:CardPlayOrigins([Exile]), action:Either, filter:Any}, terms:_{cost:Normal, spend_as:AnyType}})], duration:WhileAnyExiled(Transition{result:@back(3), phase:After}), evaluation:LiveObjects}}] */
instructions_opponent_look_exile_play ::= opponent_look_exile_remainder "." "you" "may" "play" "the" "exiled" "cards" "for" "as" "long" "as" "they" "remain" "exiled" "." "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "spells" "this" "way"

/* Keep the single-card exile and its permission together so the inverse proves
   the permission refers to the actual exile arrival. */
/* @sem Program::_{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(EventSubject)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(EventSubject)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any}, terms:_{cost:Normal, spend_as:AnyColor}})], duration:$duration, evaluation:LiveObjects}}]} */
curse_combat_exile_permission ::= "that" "player" "exiles" "the" "top" "card" "of" "their" "library" "." duration "," "that" "creature's" "controller" "may" "play" "that" "card" "and" "they" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "that" "spell" "."

/* The whole reveal, matching move, and remainder share their producer receipts. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$reveal_until_card, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$reveal_until_card}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
reveal_until_hand_grave_partition ::= reveal_until_your_library reveal_until_card "." "put" "that" "card" "into" "your" "hand" "and" "the" "rest" "into" "your" "graveyard"

/* The optional payment scopes the following independent library program. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$cost, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$reveal_until_hand_grave_partition}, otherwise:Program{}}] */
optional_paid_library_continuation ::= "you" "may" "pay" cost "." "if" "you" "do" "," reveal_until_hand_grave_partition

/* The comma form keeps the same observed library and ordering contract. */
/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One($reorder_library_owner)}, kind:Card, filter:Any}, count:$top_count, from:Top}}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:$reorder_library_owner, objects:InZone{objects:Observed(@marked), zone:Library}, end:Top, order:Chosen}}] */
clause_library_reorder_comma ::= "look" "at" "the" "top" top_count "of" reorder_library_owner "library" "," "put" "them" "back" "in" "any" "order"

/* Group the look and reorder before the independent choice and guess. */
/* @sem Instruction::[...$clause_library_reorder_comma, Effect{result:@next, operation:$choose_land_or_nonland}, ...$instructions_opponent_guesses_kind] */
instructions_reordered_kind_guess ::= clause_library_reorder_comma "," "then" choose_land_or_nonland "." instructions_opponent_guesses_kind

/* Guessing the chosen kind and revealing the same top card owns the two branches. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(OneOf(OpponentsOf(AbilityController))), kind:Filter, terms:_{count:Exactly(Constant(1)), options:[Filter(CardType(Land)), Filter(Not(CardType(Land)))]}}}, Effect{result:@next, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@last_result), filter:ChosenFilter}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:$program, otherwise:$guess_otherwise_program}] */
instructions_opponent_guesses_kind ::= "an" "opponent" "guesses" "whether" "the" "top" "card" "of" "your" "library" "is" "the" "chosen" "kind" "." "reveal" "that" "card" "." "if" "they" "guessed" "right" "," program "." "otherwise" "," guess_otherwise_program

/* Prefer the explicitly joined controller action in this contrast. */
guess_otherwise_program ::= guess_you_and_clause | program

/* @prefer always */
/* @sem Program::Program{instructions:[...$clause_you, ...$clause]} */
guess_you_and_clause ::= clause_you "and" clause

/* A foreign search, selected-card exile, and shuffle share the library owner. */
/* @sem SearchChoice::SearchChoice{filter:Any, count:AsManyAsCan($card_count)} */
foreign_search_bounded_cards ::= card_count

/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:$target_possessive, choices:[$foreign_search_bounded_cards]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($target_possessive)}}] */
search_foreign_counted_exile_shuffle ::= "search" target_possessive "library" "for" foreign_search_bounded_cards "and" "exile" "them" "." "then" "that" "player" "shuffles"

/* @sem Ability::Triggered{event:$event_clause, intervening_if:$trigger_condition, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$search_foreign_counted_exile_shuffle}} */
triggered_if_foreign_search_exile ::= event_clause "," "if" trigger_condition "," search_foreign_counted_exile_shuffle "."

/* Partition an observation of at most three cards into a hand choice, a
   bottom choice, and an exile remainder. Both departures are retained. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@prior), end:Bottom, order:Chosen}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(4), phase:Before}, Transition{result:@prior, phase:Before}])}, zone:Library}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
observed_hand_bottom_exile_partition ::= "put" "one" "of" "them" "into" "your" "hand" "," "put" "one" "of" "them" "on" "the" "bottom" "of" "your" "library" "," "and" "exile" "one" "of" "them"

/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:$partition_observation_count, from:Top}}}, ...$observed_hand_bottom_exile_partition] */
look_hand_bottom_exile_partition ::= "look" "at" "the" "top" partition_observation_count "cards" "of" "your" "library" "." observed_hand_bottom_exile_partition

partition_observation_count ::= n2 | n3

/* The permission refers to the arrival of this partition's exile move. */
/* @sem Instruction::Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects}} */
partition_play_exiled_card ::= "you" "may" "play" "the" "exiled" "card" this_duration

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$look_hand_bottom_exile_partition, $partition_play_exiled_card]}} */
spell_partition_play_exiled ::= look_hand_bottom_exile_partition "." partition_play_exiled_card "."

/* The stopped-on subset and the exile arrival are kept together so every
   later selection uses the same filter and the same movement receipt. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:AllOf([$adjective_nontype, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}]), count:@agree($count_plural, $count_plural_2)}}, Effect{result:@mark, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Transition{result:@marked, phase:After}, filter:AllOf([$adjective_nontype, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])}, count:Exactly($n1), cost:Free}}]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:AllOf([$adjective_nontype, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])}, count:AsManyAsCan($value_2)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{}), qualifiers:[]}}] */
exile_until_filtered_cast_hand ::= "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" count_plural adjective_nontype "cards" "with" "mana" "value" value "or" "less" "." "you" "may" "cast" n1 "of" "those" count_plural "cards" "without" "paying" "its" "mana" "cost" "." "put" value "of" "them" "into" "your" "hand"

/* Only the remainder of that exact exile receipt stays in exile. */
/* @sem Instruction::Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:Library{position:BottomRandom, order:DestinationDefault, arrival:CardArrival{}}, qualifiers:[]}} */
exile_until_remainder_bottom ::= "then" "put" "the" "other" "cards" "exiled" "this" "way" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* @sem Instruction::[...$exile_until_filtered_cast_hand, $exile_until_remainder_bottom] */
exile_until_filtered_cast_hand_remainder ::= exile_until_filtered_cast_hand "." exile_until_remainder_bottom

/* A library observation is divided by two sequential selections. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_partition_slice}, Effect{result:@next, operation:$observed_hand_choice}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, filter:$observed_entry_choice}, count:AnyNumber, constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(4), phase:Before}, Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
dig_look_hand_entry_graveyard ::= look_partition_slice "." observed_hand_choice "." "then" observed_entry_choice "and" "the" "rest" "into" "your" "graveyard"

/* @sem Operation::ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:UpTo($value), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]} */
observed_hand_choice ::= "you" "may" "put" value "of" "them" "into" "your" "hand"

/* @sem $filter_phrase */
observed_entry_choice ::= "put" "any" "number" "of" filter_phrase "cards" "from" "among" "them" "onto" "the" "battlefield" "tapped"

/* @sem Operation::LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:EventAmount, from:Top}} */
look_event_slice ::= "look" "at" "that" "many" "cards" "from" "the" "top" "of" "your" "library"

look_partition_slice ::= look_event_slice | look_top_spelled_count

/* The target's controller chooses whether to search even when a legal
   target survives the destruction. The search, move, and shuffle share the decision. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:One($target_up_to_one), regeneration:true}}, Optional{decider:ControllerOf($target_up_to_one), body:Program{instructions:[Effect{result:@next, operation:Search{searcher:ControllerOf($target_up_to_one), library_owner:ControllerOf($target_up_to_one), choices:[_{filter:$filter_phrase, count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(ControllerOf($target_up_to_one)), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf($target_up_to_one))}}]}}] */
instructions_destroy_optional_target_controller_search ::= "destroy" target_up_to_one "." "its" "controller" "may" "search" "their" "library" "for" "a" filter_phrase "card" "," "put" "it" search_option_entry "," "then" "shuffle"

/* The three-card partition has two explicit selections and one remaining card.
   The producer is fixed here because the final singular wording needs that proof. */
/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(3), from:Top}}}, ...$partition_one_hand, ...$partition_one_grave, $partition_bottom_one] */
look_three_partition_single ::= "look" "at" "the" "top" "three" "cards" "of" "your" "library" "." partition_one_hand "," partition_one_grave "," "and" partition_bottom_one

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
partition_one_hand ::= "put" "one" "of" "those" "cards" "into" "your" "hand"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:OwnersGraveyard(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
partition_one_grave ::= "one" "into" "your" "graveyard"

/* @sem Instruction::Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(4), phase:Before}, Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Chosen}} */
partition_bottom_one ::= "one" "on" "the" "bottom" "of" "your" "library"

/* General counts use explicit remainder wording, keeping the observed producer and
   both selection receipts in the inverse as well as in parsing. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top_spelled_count}, ...$partition_hand_count, ...$partition_grave_count, $partition_bottom_rest] */
look_partition_remainder ::= look_top_spelled_count "." partition_hand_count "," partition_grave_count "," "and" partition_bottom_rest

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($value), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
partition_hand_count ::= "put" value "of" "those" "cards" "into" "your" "hand"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, count:AsManyAsCan($value), constraints:[CanMoveTo{destination:OwnersGraveyard(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
partition_grave_count ::= value "into" "your" "graveyard"

/* @sem Instruction::Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(4), phase:Before}, Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Chosen}} */
partition_bottom_rest ::= "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "any" "order"

/* The producer and permission share the exact exile arrival in both directions. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@prior, phase:After}, origins:CardPlayOrigins([Exile]), action:Either, filter:Any}, terms:_{limit:Total(1), cost:Normal}})], duration:$top_exile_play_deadline, evaluation:LiveObjects}}] */
clause_top_exile_play_one_trailing ::= exile_top_cards_of_your_library "." "you" "may" "play" "one" "of" "those" "cards" top_exile_play_deadline
top_exile_play_deadline ::= this_duration | until_end_of_turn

/* @sem Program::Program{instructions:$clause_top_exile_play_one_trailing} */
program_top_exile_play_one ::= clause_top_exile_play_one_trailing "."

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$clause_top_exile_play_one_trailing}} */
spell_top_exile_play_one ::= clause_top_exile_play_one_trailing "."

/* Continue the selected arrival of a reveal-until exile with counters and a suspend grant. */
/* @prefer always */
/* @sem Operation::PutCounters{placements:[_{recipients:Objects(One($exiled_that_card)), kind:$counter_kind, amount:$counter_amount}]} */
put_exile_until_card_counters ::= "put" counter_amount counter_kind "counters" "on" exiled_that_card

/* @sem Instruction::[...$clause_exile_until_card, Effect{result:@next, operation:$put_exile_until_card_counters}, ...$clause_exiled_card_suspend_grant] */
exile_until_counter_suspend ::= clause_exile_until_card "." put_exile_until_card_counters "." clause_exiled_card_suspend_grant

/* A conditional replacement changes the cast count while each branch keeps the
   same revealing player, observed library slice, filter, and remainder. */
/* @sem Vec<Instruction>::@unlabelled_instructions($dig_conditional_reveal_cast_paragraph) */
dig_conditional_reveal_cast ::= dig_conditional_reveal_cast_paragraph

/* @sem Ability::@optional_ability_label(Spell{announcement:@announcement, body:Program{instructions:[If{condition:$dig_conditional_test, then:Program{instructions:[Effect{result:@mark, operation:$player_reveals_top}, Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:@agree($spell_filter, $filter_instant_and_or_sorcery)}, count:UpTo($count), terms:_{cost:Free}}}, Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@mark, operation:$player_reveals_top}, Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:@agree($spell_filter, $filter_instant_and_or_sorcery)}, count:UpTo(Expr::@agree(Constant(1), $number)), terms:_{cost:Free}}}, Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]}}, $spell_paragraph_break) */
dig_conditional_reveal_cast_paragraph ::= player_reveals_top "." "you" "may" "cast" spell_filter "from" "among" "them" "without" "paying" "its" "mana" "cost" "." "then" "that" "player" "puts" "the" "rest" "into" "their" "graveyard" "." spell_paragraph_break "if" dig_conditional_test "," "you" "may" "cast" "up" "to" count filter_instant_and_or_sorcery "spells" "from" "among" "the" "revealed" "cards" "instead" "of" number

/* The reveal and both moves share the observation and the immediately preceding move receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$reveal_until_card, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$reveal_until_card}, destination:$until_hand, qualifiers:[]}}, Effect{result:@next, operation:$reveal_other_disposition}] */
reveal_until_hand_graveyard_partition ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" reveal_until_card "." "put" "that" "card" until_hand "and" reveal_other_disposition

/* The final all-player shuffle completes the other-player searches and the
   controller's independent search. Each selection keeps its own receipt. */
/* @sem Instruction::[$split_other_search, ...$split_controller_search] */
split_other_and_controller_search ::= split_other_search "." "then" split_controller_search "." "each" "player" "shuffles"

split_other_search ::= split_other_search_one | split_other_search_many

/* @sem Instruction::ForEachPlayer{players:OthersThan(AbilityController), binding:0, body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[$player_search_one_choice]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}} */
split_other_search_one ::= "each" "other" "player" "searches" "their" "library" "for" player_search_one_choice "," "reveals" "it" "," "and" "puts" "it" "into" "their" "hand"

/* @sem Instruction::ForEachPlayer{players:OthersThan(AbilityController), binding:0, body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[_{filter:Any, count:AsManyAsCan($card_count_many)}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}} */
split_other_search_many ::= "each" "other" "player" "searches" "their" "library" "for" card_count_many "," "reveals" "them" "," "and" "puts" "them" "into" "their" "hand"

/* @sem Instruction::[Effect{result:@mark, operation:$search_library_for_cards}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
split_controller_search ::= "you" search_library_for_cards "and" "put" "them" "into" "your" "hand"

/* The observation and its optional bottom movement form one scoped producer. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, If{condition:Not(Outcome(CostPaid)), then:Program{}, otherwise:Program{}}] */
look_optional_observed_bottom ::= look_top "." "you" "may" "put" "those" "cards" "on" "the" "bottom" "of" "your" "library" "in" "any" "order"

/* The choice branches retain independent programs and the preceding group. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$look_optional_observed_bottom, If{condition:Outcome(CostPaid), then:$program_plain, otherwise:$program_plain_2}]}} */
spell_observed_bottom_choice ::= look_optional_observed_bottom "." "if" "you" "do" "," program_plain "." "otherwise" "," program_plain "."

/* A three-card slice divided into three singleton destinations. The singleton
   bottom wording is scoped to this exact producer and the two singleton choices. */
/* @sem Operation::LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(3), from:Top}} */
partition_look_three ::= "look" "at" "the" "top" "three" "cards" "of" "your" "library"

/* @sem Instruction::[Effect{result:@mark, operation:$partition_look_three}, ...$partition_singletons] */
/* @prefer always */
dig_three_partition ::= partition_look_three "." partition_singletons

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@prior), end:Top, order:Chosen}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(4), phase:Before}, Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Chosen}}] */
/* @prefer always */
partition_singletons ::= "put" "one" "of" "those" "cards" "into" "your" "hand" "," "one" "on" "top" "of" "your" "library" "," "and" "one" "on" "the" "bottom" "of" "your" "library"

/* A variable slice and two independent counts leave the rest on the bottom. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$partition_hand_top_rest] */
dig_variable_partition ::= look_top "." partition_hand_top_rest

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($value), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, count:AsManyAsCan($value_2)}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@prior), end:Top, order:Chosen}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(4), phase:Before}, Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Chosen}}] */
partition_hand_top_rest ::= "put" value "of" "those" "cards" "into" "your" "hand" "," value "on" "top" "of" "your" "library" "," "and" "the" "rest" "on" "the" "bottom" "of" "your" "library"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:EventSubject, objects:Zone{scope:Players{zone:Hand, players:One(EventSubject)}, kind:Card, filter:Any}, count:AsManyAsCan($card_count_one)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
event_player_hand_one_top ::= "that" "player" "puts" card_count_one "from" "their" "hand" "on" "top" "of" "their" "library"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:EventSubject, objects:Zone{scope:Players{zone:Hand, players:One(EventSubject)}, kind:Card, filter:Any}, count:AsManyAsCan($card_count_one)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
event_player_hand_one_bottom ::= "that" "player" "puts" card_count_one "from" "their" "hand" "on" "the" "bottom" "of" "their" "library"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:EventSubject, objects:Zone{scope:Players{zone:Hand, players:One(EventSubject)}, kind:Card, filter:Any}, count:AsManyAsCan($count_plural)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
event_player_hand_many_top ::= "that" "player" "puts" count_plural "cards" "from" "their" "hand" "on" "top" "of" "their" "library"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:EventSubject, objects:Zone{scope:Players{zone:Hand, players:One(EventSubject)}, kind:Card, filter:Any}, count:AsManyAsCan($count_plural)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
event_player_hand_many_bottom ::= "that" "player" "puts" count_plural "cards" "from" "their" "hand" "on" "the" "bottom" "of" "their" "library"

event_player_hand_library ::= event_player_hand_one_top | event_player_hand_many_top | event_player_hand_one_bottom | event_player_hand_many_bottom

/* @sem Ability::Triggered{event:$event_shuffle_caused_controller, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$event_player_hand_library}} */
triggered_event_player_hand_library ::= "whenever" event_shuffle_caused_controller "," event_player_hand_library "."

/* This seek marks its hand arrival for the paired destination follow-up. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:@and($filter_phrase, $modifier_mana_value_bound)}, count:AsManyAsCan(Constant(2)), constraints:[AtRandom]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
seek_two_qualified_cards ::= "seek" "two" filter_phrase "cards" modifier_mana_value_bound

/* The paired follow-up is scoped to this particular seek's hand arrival. */
/* @sem Instruction::[...$seek_two_qualified_cards, ...$seek_pair_battlefield_shuffle] */
seek_two_qualified_split ::= seek_two_qualified_cards "." seek_pair_battlefield_shuffle

/* The cast condition refers to the entering event subject. */
/* @sem Ability::Triggered{event:ZoneChange{objects:SameObject($self_ref), to:Battlefield}, intervening_if:AllOf([ObjectMatches{object:$self_ref, filter:Cast{}}, $condition_three_zones_qualified_threshold]), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$seek_two_qualified_split}} */
triggered_entry_cast_qualified_seek ::= "when" self_ref "enters" "," "if" "you" "cast" "it" "and" condition_three_zones_qualified_threshold "," seek_two_qualified_split "."

/* An observed library slice can be placed at a specified end before the
   choice-dependent continuation. Keep the observation and move in one scope. */
/* @sem MovementDestination::Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
observed_optional_library_bottom ::= "on" "the" "bottom" "of" "your" "library" "in" "any" "order"

/* @sem Instruction::[Effect{result:@next, operation:$look_top_spelled_count}, Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@prior), zone:Library}, destination:$observed_optional_library_bottom, qualifiers:[]}}, If{condition:Not(Outcome(CostPaid)), then:Program{}, otherwise:Program{}}] */
observed_optional_library_move ::= look_top_spelled_count "." "you" "may" "put" "those" "cards" observed_optional_library_bottom

/* @sem Instruction::If{condition:Outcome(CostPaid), then:$program, otherwise:$program_2} */
observed_optional_branches ::= "if" "you" "do" "," program "." "otherwise" "," program

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$observed_optional_library_move, $observed_optional_branches]}} */
spell_observed_optional_branches ::= observed_optional_library_move "." observed_optional_branches "."

/* A one-card observation supplies the condition, while the library owner
   remains the player who shuffles after the conditional. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($look_target_opponent)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$noun}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:$clause_you}, otherwise:Program{}}, Effect{result:@next, operation:Shuffle{players:One($look_target_opponent)}}] */
opponent_top_reveal_test_shuffle ::= "reveal" "the" "top" "card" "of" look_target_opponent "library" "." "if" "it's" "a" noun "," clause_you "." "then" "that" "player" "shuffles"

/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:UpkeepBegins, players:All}, start:NextTurn, body:Program{instructions:$top_reveal_draw}}}] */
next_turn_draw_delay ::= top_reveal_draw "at" "the" "beginning" "of" "the" "next" "turn's" "upkeep"

/* @sem Ability::[Spell{announcement:@announcement, body:Program{instructions:[...$opponent_top_reveal_test_shuffle, ...$next_turn_draw_delay]}}] */
line_reveal_shuffle_delayed_draw ::= opponent_top_reveal_test_shuffle "." NEWLINE next_turn_draw_delay "."

/* The other chosen name is relative to the spell in this trigger. Keeping
   the event and search together supplies that antecedent for both directions. */
/* @sem EventSpec::Spell{event:Cast, players:One(AbilityController), spells:AllOf([$filter_phrase, Chosen(CardName)])} */
event_cast_one_chosen_name ::= "you" "cast" "a" filter_phrase "spell" "with" "one" "of" "the" "chosen" "names"

/* @sem SearchChoice::SearchChoice{filter:AllOf([$filter_phrase, Chosen(CardName), Not(SharesNameWith(EventSubject))]), count:UpTo(Constant(1))} */
search_choice_other_chosen_name ::= "a" filter_phrase "card" "with" "the" "other" "chosen" "name"

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_other_chosen_name]} */
search_library_other_chosen_name ::= "search" "your" "library" "for" search_choice_other_chosen_name

/* @sem Instruction::[Effect{result:@mark, operation:$search_library_other_chosen_name}, ...$search_follow] */
search_other_chosen_name_follow ::= search_library_other_chosen_name search_follow

/* @sem Ability::Triggered{event:$event_cast_one_chosen_name, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[...$search_other_chosen_name_follow]}}]}} */
triggered_search_other_chosen_name ::= "whenever" event_cast_one_chosen_name "," "you" "may" search_other_chosen_name_follow "."

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
look_exile_one_among_face_down ::= "exile" "one" "of" "them" "face" "down"

/* Bind the remainder and permission to the face-down movement within this
   complete look-and-split phrase. */
/* @sem Instruction::[Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:Target{slot:0, index:0}, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Chosen}}] */
opponent_look_other_bottom ::= "put" "the" "other" "on" "the" "bottom" "of" "that" "library"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@back(3), phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any}, terms:_{cost:Normal, spend_as:AnyColor}})], duration:WhileExiled(Result{result:@back(3), phase:After, index:0}), evaluation:LiveObjects}}] */
opponent_look_exiled_play ::= "you" "may" "play" "the" "exiled" "card" "for" "as" "long" "as" "it" "remains" "exiled" "," "and" "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "that" "spell"

/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One($look_target_opponent)}, kind:Card, filter:Any}, count:Constant(2), from:Top}}}, ...$look_exile_one_among_face_down, ...$opponent_look_other_bottom, ...$opponent_look_exiled_play] */
/* @prefer always */
instructions_opponent_look_hidden_play ::= "look" "at" "the" "top" "two" "cards" "of" look_target_opponent "library" "." look_exile_one_among_face_down "and" opponent_look_other_bottom "." opponent_look_exiled_play

/* A larger observed slice leaves a remainder whose order is specified. */
/* @sem Instruction::[Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:Target{slot:0, index:0}, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
opponent_look_rest_bottom ::= "put" "the" "rest" "on" "the" "bottom" "of" "that" "library" library_order

/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One($look_target_opponent)}, kind:Card, filter:Any}, count:$number, from:Top}}}, ...$look_exile_one_among_face_down, ...$opponent_look_rest_bottom, ...$opponent_look_exiled_play] */
instructions_opponent_look_rest_play ::= "look" "at" "the" "top" number "cards" "of" look_target_opponent "library" "." look_exile_one_among_face_down "and" opponent_look_rest_bottom "." opponent_look_exiled_play

/* The look establishes the observation for the exile-and-reorder follow-up. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_target_library_top}, ...$observed_exile_and_return] */
dig_target_look_exile_remainder ::= look_target_library_top "." observed_exile_and_return

/* @sem Operation::LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One($target_possessive)}, kind:Card, filter:Any}, count:$top_count, from:Top}} */
look_target_library_top ::= "look" "at" "the" "top" top_count "of" target_possessive "library"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AnyNumber, constraints:[CanMoveTo{destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:Target{slot:@last_slot, index:0}, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Top, order:Chosen}}] */
observed_exile_and_return ::= "exile" "any" "number" "of" "those" "cards" "," "then" "put" "the" "rest" "back" "in" "any" "order"

/* Keep the observed slice, selected battlefield arrival, grant, and remainder in one receipt scope. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$filter_phrase}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:[GrantKeyword($keyword_name)], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(3), phase:Before}])}, zone:Library}, end:Bottom, order:Random}}] */
instructions_look_attacking_grant_remainder ::= look_top "." "you" "may" "put" "a" filter_phrase "card" "from" "among" "them" "onto" "the" "battlefield" "tapped" "and" "attacking" "." "it" "gains" keyword_name duration "." "put" "the" "rest" "of" "the" "cards" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* Both branches use the same singular search and selected card; only the
   destination changes with this spell's immutable casting origin. */
/* @sem Condition::ObjectMatches{object:Source, filter:Cast{from:Players{zone:Graveyard, players:All}}} */
search_cast_graveyard ::= "this" "spell" "was" "cast" "from" "a" "graveyard"

/* @sem Instruction::[If{condition:$search_cast_graveyard, then:_{instructions:[Effect{result:@next, operation:$search_single_library}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:Battlefield{controller:Player(AbilityController), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:_{instructions:[Effect{result:@next, operation:$search_single_library}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}}] */
clause_search_revealed_cast_origin ::= search_single_library "," "reveal" "it" "," "and" "put" "it" "into" "your" "hand" "." "if" search_cast_graveyard "," "put" "that" "card" search_option_entry "instead" "." "then" "shuffle"

/* Each alternative describes its own card; the ability qualifies only the first. */
/* @sem ObjectFilter::AnyOf([AllOf([$filter_phrase, HasActivatedAbility(Mana)]), $filter_phrase_2]) */
search_filter_mana_ability_or ::= filter_phrase "card" "with" "a" "mana" "ability" "or" "a" filter_phrase "card"

/* Keep the separate-sentence spelling for this observed attacking entry. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$dig_put_may_attacking, $dig_rest_put] */
dig_look_attacking_split ::= look_top "." dig_put_may_attacking "." dig_rest_put

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$a_card}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:$until_battlefield_tapped_attacking}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$until_battlefield_tapped_attacking, qualifiers:[]}}] */
dig_put_may_attacking ::= "you" "may" "put" a_card "from" "among" "them" until_battlefield_tapped_attacking

/* The inspected library slice and its exile receipt stay within one phrase. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_possessive)}, kind:Card, filter:Any}, count:$top_many, from:Top}}}, Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@prior), zone:Library}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@prior, phase:After}, origins:CardPlayOrigins([Exile]), action:Either, filter:Any}, terms:_{cost:Normal, spend_as:AnyType}})], duration:WhileAnyExiled(Transition{result:@prior, phase:After}), evaluation:LiveObjects}}] */
clause_look_exile_play_any_type ::= "look" "at" "the" "top" top_many "of" player_possessive "library" "and" "exile" "those" "cards" "face" "down" "." "you" "may" "play" "those" "cards" "for" "as" "long" "as" "they" "remain" "exiled" "," "and" "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "them"

/* @prefer always */
/* @sem Instruction::[...$clause_look_exile_play_any_type, ...$instructions] */
instructions_look_exile_play_more ::= clause_look_exile_play_any_type "." instructions

/* A shared card noun can cover an unqualified kind or a qualified kind. */
/* @sem ObjectFilter::AnyOf([$card_word, $card_stacked]) */
dig_reveal_selection_qualified_union ::= ("a" | "an") card_word "or" card_stacked "card" "from" "among" "them" "and" "put" "it"

/* The choice and remainder consume the same observed library cards. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:$look_top_count}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@prior), end:Top, order:Chosen}}, Effect{result:@next, operation:$rest_bottom_implicit_library}] */
look_top_split_implicit ::= "put" look_top_count "of" "them" "on" "top" "of" "your" "library" "and" rest_bottom_implicit_library

/* @sem Instruction::[Effect{result:@next, operation:BindValue{value:$value}}, Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:BoundValue(@prior), from:Top}}}, ...$look_top_split_implicit] */
bound_look_top_split_implicit ::= "look" "at" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" value "." look_top_split_implicit

/* @sem Program::Program{instructions:[...$bound_look_top_split_implicit, ...$then_land_types_program]} */
program_bound_look_land_types ::= bound_look_top_split_implicit "." then_land_types_program

/* @sem Instruction::[If{condition:$look_land_types_equal, then:$program, otherwise:Program{}}] */
then_land_types_program ::= "then" "if" look_land_types_equal "," program

/* @sem Condition::Compare{left:CountDistinct{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_plural}, property:BasicLandTypes}, test:NumberTest::Compare{comparison:Equal, value:$count}} */
look_land_types_equal ::= "there" "are" count "basic" "land" "types" "among" filter_plural

/* A single-clause basic/subtype search that reveals them and divides tapped entry and hand. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[SearchChoice{filter:$search_plain_card_filter, count:UpTo($value)}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Selected(@marked), count:AsManyAsCan($value_2)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, ...$search_shuffle] */
instructions_search_reveal_them_divide ::= "search" "your" "library" "for" "up" "to" value search_plain_card_filter "cards" "," "reveal" "them" "," "put" value search_option_entry "and" "the" "other" "into" "your" "hand" search_shuffle

/* @sem @and($adjective_basic, $noun) */
search_basic_noun_filter ::= adjective_basic noun
search_plain_card_filter ::= search_basic_noun_filter | noun

/* Reveal-until with tapped-and-attacking destination retains filter and library order operands. */
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:Operation::RevealUntil{library:AbilityController, filter:$reveal_until_card, count:Expr::Constant(1)}}, Instruction::Effect{result:@next, operation:Operation::Move{objects:Matching{objects:Observed(@marked), filter:$reveal_until_card}, destination:$until_battlefield_tapped_attacking, qualifiers:[]}}, Instruction::Effect{result:@next, operation:$rest_bottom}] */
instructions_reveal_until_attacking ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" reveal_until_card "." "put" "that" "card" until_battlefield_tapped_attacking "and" rest_bottom

/* Search all three owned zones and compose its selected cards with ordinary follow-ups. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice], also:[Graveyard, Hand]} */
search_three_zones ::= "search" "your" "graveyard" "," "hand" "," "and" "library" "for" search_choice

/* @sem Instruction::[Effect{result:@mark, operation:$search_three_zones}, ...$search_and_follow] */
clause_search_three_zones ::= search_three_zones search_and_follow

/* @sem Instruction::[Effect{result:@next, operation:$found_action}, ...$search_follow] */
search_and_follow ::= "and" found_action search_follow

/* Preserve the existing canonical default for the and-follow-up form. */
/* @prefer always */
/* @sem Ability::Triggered{event:$event_self_enters, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$clause_search_three_zones}} */
triggered_search_three_zones ::= "when" event_self_enters "," clause_search_three_zones "."

/* Match both canonical alphabetical and raw WUBRG order of the five basic land types. */
basic_land_type_card ::= a_card_basic_type | a_card_basic_type_wubrg

/* @sem ObjectFilter::AllOf([$card_filter, AnyOf([Subtype(Plains), Subtype(Island), Subtype(Swamp), Subtype(Mountain), Subtype(Forest)])]) */
a_card_basic_type_wubrg ::= "a" card_filter "card" "with" "a" "basic" "land" "type"

/* The target controller chooses the search and controls its destination. */
/* @prefer always */
instructions_destroy_target_player_basic_type_pref ::= instructions_destroy_target_player_basic_type | instructions_destroy_target_player_basic_type_grouped

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:One($target_object), regeneration:true}}, Optional{decider:ControllerOf(Target{slot:@last_slot, index:0}), body:Program{instructions:[Effect{result:@next, operation:Search{searcher:ControllerOf(Target{slot:@last_slot, index:0}), library_owner:ControllerOf(Target{slot:@last_slot, index:0}), choices:[_{filter:$basic_land_type_card, count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(ControllerOf(Target{slot:@last_slot, index:0})), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf(Target{slot:@last_slot, index:0}))}}]}}] */
instructions_destroy_target_player_basic_type ::= "destroy" target_object "." "that" "player" "may" "search" "their" "library" "for" basic_land_type_card "," "put" "it" "onto" "the" "battlefield" "," "then" "shuffle"

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:One($target_object), regeneration:true}}, Optional{decider:ControllerOf(Target{slot:@last_slot, index:0}), body:Program{instructions:[Group(Program{instructions:[Effect{result:@next, operation:Search{searcher:ControllerOf(Target{slot:@last_slot, index:0}), library_owner:ControllerOf(Target{slot:@last_slot, index:0}), choices:[_{filter:$basic_land_type_card, count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(ControllerOf(Target{slot:@last_slot, index:0})), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf(Target{slot:@last_slot, index:0}))}}]})]}}] */
instructions_destroy_target_player_basic_type_grouped ::= "destroy" target_object "." "that" "player" "may" "search" "their" "library" "for" basic_land_type_card "," "put" "it" "onto" "the" "battlefield" "," "then" "shuffle"

/* A two-type stopping condition retains each current type operand. */
exile_until_vowel_type ::= spell_instant | noun_artifact | noun_enchantment
exile_until_card_type ::= spell_instant | spell_sorcery | noun_artifact | noun_creature | noun_enchantment | noun_land | noun_planeswalker | noun_battle
/* @sem ObjectFilter::AnyOf([$exile_until_vowel_type, $exile_until_card_type]) */
exile_until_player_filter_an_pair ::= "an" exile_until_vowel_type "or" exile_until_card_type "card"

/* Both consumers are scoped to this reveal-and-exile producer without altering shared clause_player_exile_until_observed. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_until_player_observation}, Effect{result:@mark, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Result{result:@marked, phase:After, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:Library{position:BottomRandom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
player_exile_until_cast_bottom ::= exile_until_player_observation "." "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" "." "then" "that" "player" "puts" "the" "exiled" "cards" "that" "weren't" "cast" "this" "way" "on" "the" "bottom" "of" "their" "library" "in" "a" "random" "order"

/* The reveal, exile, shuffle, and free cast share the same activation-cost mana-value filter and library owner. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:$reveal_until_named_player, filter:$reveal_until_mana_quality, count:$card_count}}, Effect{result:@mark, operation:Move{objects:Matching{objects:Observed(@prior), filter:$reveal_until_mana_quality}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($reveal_until_named_player)}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Result{result:@marked, phase:After, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}] */
instructions_reveal_until_exile_cast ::= reveal_until_named_player "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" card_count reveal_until_mana_quality "." "exile" "that" "card" "," "then" "that" "player" "shuffles" "." "you" "may" "cast" "that" "exiled" "card" "without" "paying" "its" "mana" "cost"

/* Prefer "this spell was bargained" over "it's bargained" in conditional deeper-look spells. */
look_hand_bottom_condition ::= look_hand_bottom_bargained | condition
/* @prefer always */
/* @sem $condition_this_spell_bargained */
look_hand_bottom_bargained ::= condition_this_spell_bargained

/* A conditional deeper look shares the same hand/bottom-random partition across both branches. */
/* @sem Instruction::[If{condition:$look_hand_bottom_condition, then:Program{instructions:[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$number_2, from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@prior), zone:Library}, count:AsManyAsCan($number_3), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Random}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$number, from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@prior), zone:Library}, count:AsManyAsCan($number_3), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Random}}]}}] */
clause_conditional_look_hand_bottom_random ::= "look" "at" "the" "top" number "cards" "of" "your" "library" "." "if" look_hand_bottom_condition "," "look" "at" "the" "top" number "cards" "of" "your" "library" "instead" "." "put" number "of" "them" "into" "your" "hand" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* Both possible entries use the triggering object for its mana value. */
/* @sem Ability::[Triggered{event:@either_event(EventSpec::ZoneChange{objects:$event_self, to:Battlefield}, EventSpec::Player{event:EntersUnderControl, players:All, objects:$controlled_entrant_another}), limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}, from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:AllOf([$noun, Not(SharesWithAny{property:CreatureTypes, with:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$noun_2, ControlledBy(One(AbilityController))])}})])}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(5)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Random}}]}}] */
line_self_or_another_controlled_dig_unshared ::= "whenever" event_self "or" controlled_entrant_another "enters" "," "look" "at" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" "that" "creature's" "mana" "value" "." "you" "may" "reveal" "a" noun "card" "that" "doesn't" "share" "a" "creature" "type" "with" "a" noun "you" "control" "from" "among" "those" "cards" "and" "put" "it" "into" "your" "hand" "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order" "."

/* Naming a card, exiling top library cards, then revealing until a card with the chosen name and exiling all other revealed cards. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$choose_a_card_name}, Effect{result:@next, operation:$exile_top_cards_of_your_library}, Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:Chosen(CardName), count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:Chosen(CardName)}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
choose_name_exile_top_then_reveal_partition ::= choose_a_card_name "." exile_top_cards_of_your_library "," "then" "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "a" "card" "with" "the" "chosen" "name" "." "put" "that" "card" "into" "your" "hand" "and" "exile" "all" "other" "cards" "revealed" "this" "way"

/* The reveal, exile, shuffle, and cast share one matching card receipt. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:$reveal_until_other_prefix, filter:$reveal_until_card_quality, count:Constant(1)}}, Effect{result:@mark, operation:Move{objects:Matching{objects:Observed(@prior), filter:$reveal_until_card_quality}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($reveal_until_other_prefix)}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Result{result:@marked, phase:After, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}] */
reveal_matching_exile_shuffle_cast ::= reveal_until_other_prefix "a" "card" reveal_until_card_quality "." "exile" "that" "card" "," "then" "that" "player" "shuffles" "." "you" "may" "cast" "that" "exiled" "card" "without" "paying" "its" "mana" "cost"

/* The stopped-on card and its mana value both refer to this exile's arrival. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:One(Query{objects:Matching{objects:Transition{result:@prior, phase:After}, filter:$card_filter}, index:0}), count:Exactly(Constant(1)), terms:_{cost:Alternate(Cost{parts:[Energy(ObjectProperty{object:Query{objects:Matching{objects:Transition{result:@prior, phase:After}, filter:$card_filter}, index:0}, property:ManaValue, information:CurrentOrLastKnown})]})}}}]}}] */
exile_until_energy_cast ::= "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" "a" card_filter "card" "." "you" "may" "cast" "that" "card" "by" "paying" "an" "amount" "of" "{" "E" "}" "equal" "to" "its" "mana" "value" "rather" "than" "paying" "its" "mana" "cost"

/* This branch is scoped by an optional reveal of the controller's top card.
   The entry filter, entry destination and fallback remain independent operands. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:MoveTopCard{actor:One(AbilityController), cards:$card_filter, reveal:false, destination:$top_card_battlefield}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:$revealed_top_it_fallback}, otherwise:Program{}}] */
revealed_top_filtered_entry_or_fallback ::= "if" "a" card_filter "card" "is" "revealed" "this" "way" "," "you" "may" "put" "it" top_card_battlefield "." "if" "you" "revealed" "a" "card" "but" "didn't" "put" "it" "onto" "the" "battlefield" "," revealed_top_it_fallback

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$revealed_top_filtered_entry_or_fallback}, otherwise:Program{}}] */
clause_optional_top_reveal_entry_fallback ::= "you" "may" "reveal" "the" "top" "card" "of" "your" "library" "." revealed_top_filtered_entry_or_fallback

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
revealed_top_fallback_it_top ::= "put" "it" "on" "top" "of" "your" "library"

revealed_top_it_fallback ::= revealed_top_fallback_it | revealed_top_fallback_it_top

/* The enclosing attack-batch trigger supplies this quantity. */
/* @sem SearchChoice::SearchChoice{filter:$search_filter_many, count:UpTo(EventAmount)} */
attack_batch_search_choice ::= "up" "to" "that" "many" search_filter_many

/* The choice and its follow-up share the search result identity. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$attack_batch_search_choice]}}, ...$search_plural_follow] */
attack_batch_search_instructions ::= "search" "your" "library" "for" attack_batch_search_choice search_plural_follow

/* The selected card remains outside the shuffle and is routed by the condition. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_single_library}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController), excluding:Selected(@marked)}}, If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@marked), end:Top, order:Chosen}}]}}] */
clause_search_reveal_shuffle_branch ::= search_single_library "," "reveal" "it" "," "then" "shuffle" "." "put" "that" "card" "into" "your" "hand" "if" condition "." "otherwise" "," "put" "that" "card" "on" "top" "of" "your" "library"

/* The same targeted player is milled by both branches; the condition selects the scaled count. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:Mill{players:One($target_player), amount:Multiply([$scaled_mill_factor, $card_count])}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Mill{players:One(Target{slot:@last_slot, index:0}), amount:$card_count}}]}}] */
instructions_target_player_mill_conditional_scaled ::= target_player "mills" card_count "." "if" condition "," "that" "player" "mills" scaled_mill_factor "that" "many" "cards" "instead"

scaled_mill_factor ::= revealed_stat_factor | entry_roll_three_times

/* @sem Operation::Conjure{actor:One(AbilityController), card:Random(Term{family:CardsInOracle, form:And, operands:[Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Creature}]}, Term{family:CardsInOracle, form:ManaValueIs, operands:[Comparison(Equal, AnnouncedX)]}]}), count:Constant(1), destination:Battlefield(BattlefieldArrival{tapped:false, counters:[], states:[]})} */
conjure_random_creature_mv_x_battlefield ::= "conjure" "a" "random" "creature" "card" "with" "mana" "value" "X" "onto" "the" "battlefield"

/* @sem Operation::@sacrificed_result(Operation::Sacrifice{players:OpponentsOf(AbilityController), objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$noun}, choose:AsManyAsCan(Constant(1))}) */
opponents_sacrifice_of_choice ::= "each" "opponent" "sacrifices" ("a" | "an") noun "of" "their" "choice"

/* Four X-gated spell branches whose final branch replays the first three bodies in order. */
/* @prefer always */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[If{condition:Compare{left:AnnouncedX, test:NumberTest::Compare{comparison:Equal, value:$number}}, then:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$card_filter}), count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{}}, If{condition:Compare{left:AnnouncedX, test:NumberTest::Compare{comparison:Equal, value:$number_2}}, then:Program{instructions:[Effect{result:@next, operation:$opponents_sacrifice_of_choice}]}, otherwise:Program{}}, If{condition:Compare{left:AnnouncedX, test:NumberTest::Compare{comparison:Equal, value:$number_3}}, then:Program{instructions:[Effect{result:@next, operation:$conjure_random_creature_mv_x_battlefield}]}, otherwise:Program{}}, If{condition:Compare{left:AnnouncedX, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number_4}}, then:Program{instructions:[...$clause, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$card_filter}), count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:$opponents_sacrifice_of_choice}, Effect{result:@next, operation:$conjure_random_creature_mv_x_battlefield}]}, otherwise:Program{}}]}} */
spell_variable_x_do_all_above ::= "if" "X" "is" number "," "seek" "a" card_filter "card" "and" "put" "it" "onto" "the" "battlefield" "tapped" "." NEWLINE "if" "X" "is" number "," opponents_sacrifice_of_choice "." NEWLINE "if" "X" "is" number "," conjure_random_creature_mv_x_battlefield "." NEWLINE "if" "X" "is" number "or" "more" "," clause "." "then" "do" "all" "of" "the" "above" "."

/* Seek a card matching the source's counter count and exile its hand arrival face down. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:CountCounters{recipients:Objects(One(Source)), kind:$counter_kind, information:CurrentOrLastKnown}}}}), count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_seek_source_counters_exile_face_down ::= "seek" "a" "card" "with" "mana" "value" "equal" "to" "the" "number" "of" counter_kind "counters" "on" "it" "and" "exile" "that" "card" "face" "down"

/* Search for a card that could enchant the triggering object; attach if still on battlefield, else reveal to hand. */
/* @prefer always */
/* @sem Instruction::[If{condition:ObjectMatches{object:EventSubject, filter:InZone(Shared(Battlefield))}, then:Program{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:AllOf([@agree($subtype, @agree($subtype_2, $subtype_3)), CouldEnchant(One(EventSubject))]), count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo(EventSubject)]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:AllOf([@agree($subtype, @agree($subtype_2, $subtype_3)), CouldEnchant(One(EventSubject))]), count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}}] */
clause_search_enchant_battlefield_or_hand ::= "search" "your" "library" "for" "an" subtype "card" "that" "could" "enchant" "it" "." "if" self_holder_text "is" "still" "on" "the" "battlefield" "," "put" "that" subtype "card" "onto" "the" "battlefield" "attached" "to" "it" "." "otherwise" "," "reveal" "the" subtype "card" "and" "put" "it" "into" "your" "hand" "." "then" "shuffle"

/* Reveal and exile the matching card as one producer; its filter is shared,
   and the named library owner performs the shuffle. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:$reveal_until_other_prefix, filter:$reveal_until_card_quality, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$reveal_until_card_quality}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($reveal_until_other_prefix)}}] */
reveal_matching_exile_shuffle ::= reveal_until_other_prefix "a" "card" reveal_until_card_quality "." "exile" "that" "card" "," "then" "that" "player" "shuffles"

/* @sem Instruction::[...$reveal_matching_exile_shuffle, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$revealed_exile_free_cast}]}}] */
reveal_matching_exile_shuffle_more ::= reveal_matching_exile_shuffle "." "you" "may" revealed_exile_free_cast

/* The shuffle intervenes, so the card is the preceding matching exile's arrival. */
/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Result{result:@back(3), phase:After, index:0}), count:Exactly(Constant(1)), cost:Free} */
revealed_exile_free_cast ::= "cast" "that" "exiled" "card" "without" "paying" "its" "mana" "cost"

/* The event player owns the searched library and performs its shuffle.
   The selection and shuffle remain part of the same search episode. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:EventSubject, choices:[$search_event_player_choice]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(EventSubject)}}] */
search_event_player_library_group ::= "search" "that" "player's" "library" "for" search_event_player_choice "and" "exile" "it" "," "then" "the" "player" "shuffles"

search_event_player_choice ::= search_choice_any | search_choice_filtered | search_choice_modified

/* The play permission consumes exactly the preceding damage recipients’ library exile. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:LibraryTops(DamageRecipients), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@prior, phase:After}, origins:CardPlayOrigins([Exile]), action:Either, filter:Any}, terms:_{cost:Normal, spend_as:AnyColor}})], duration:$this_duration, evaluation:LiveObjects}}] */
clause_damage_recipients_exile_play ::= "exile" "the" "top" "card" "of" "each" "of" "those" "opponents'" "libraries" "." "you" "may" "play" "those" "cards" this_duration "," "and" "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "those" "spells"

/* The anaphoric opponents are the recipients of this batch damage event. */
/* @sem Ability::Triggered{event:$event_group_damage_opponents, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$clause_damage_recipients_exile_play}} */
triggered_damage_recipients_exile_play ::= "whenever" event_group_damage_opponents "," clause_damage_recipients_exile_play "."

/* A player observes their own top cards; the partition keeps the same player
   as chooser and library owner, and excludes the cards reordered before exile. */
partition_target_player ::= target_player | target_opponent

/* @sem Operation::LookAt{player:$partition_target_player, objects:Take{objects:Zone{scope:Players{zone:Library, players:One($partition_target_player)}, kind:Card, filter:Any}, count:$card_count, from:Top}} */
player_looks_own_top ::= partition_target_player "looks" "at" "the" "top" card_count "of" "their" "library"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:@that_player, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($value)}}, Effect{result:@next, operation:ReorderLibrary{chooser:@that_player, library_owner:@that_player, objects:Selected(@prior), end:Top, order:Chosen}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
player_puts_top_exiles_rest ::= "puts" value "of" "them" "back" "on" "top" "of" "their" "library" "," "then" "exiles" "the" "rest"

/* @sem Instruction::[Effect{result:@mark, operation:$player_looks_own_top}, ...$player_puts_top_exiles_rest] */
dig_player_look_partition ::= player_looks_own_top "," player_puts_top_exiles_rest

/* A single observed library slice remains bound across an optional payment and
   either outcome. Unselected cards retain their order on top of the library. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:$observed_branch_payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:$observed_hand_keep_top}, otherwise:Program{instructions:$observed_bottom_keep_top}}] */
look_payment_observed_branches ::= look_top "." "you" "may" observed_branch_payment "." "if" "you" "do" "," observed_hand_keep_top "." "if" "you" "don't" "," observed_bottom_keep_top

/* @sem Cost::Cost{parts:[$cost_sacrifice_affected, Mana($mana_symbols)]} */
observed_branch_payment ::= cost_sacrifice_affected "and" "pay" mana_symbols

/* @sem Instruction::[...$observed_cards_to_hand, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Top, order:Chosen}}] */
observed_hand_keep_top ::= observed_cards_to_hand

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($number)}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@prior), end:Bottom, order:Chosen}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Top, order:Chosen}}] */
observed_bottom_keep_top ::= "put" number "of" "those" "cards" "on" "the" "bottom" "of" "your" "library"

/* A single discard payment owns the receipt used by both dependent seeks.
   The operation and the word-conditioned seeks remain independent operands. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[$discard_one_payment]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:$operation}, Effect{result:@next, operation:$choose_ambitious_expedient}, $chosen_discard_seek, $chosen_discard_seek_2]}, otherwise:Program{}}] */
instructions_optional_discard_word_seeks ::= "you" "may" discard_one_payment "." "if" "you" "do" "," operation "and" choose_ambitious_expedient "." chosen_discard_seek "." chosen_discard_seek

/* @sem Operation::ChooseValue{choosers:One(AbilityController), kind:Word, terms:_{count:Exactly(Constant(1)), options:[Text(Ambitious), Text(Expedient)]}} */
choose_ambitious_expedient ::= "choose" "ambitious" "or" "expedient"

/* @sem Instruction::If{condition:ChosenWord($discard_choice_word), then:Program{instructions:$discard_mana_value_seek}, otherwise:Program{}} */
chosen_discard_seek ::= "if" "you" "chose" discard_choice_word "," discard_mana_value_seek

/* @sem Text::Ambitious */
discard_choice_word_ambitious ::= "ambitious"

/* @sem Text::Expedient */
discard_choice_word_expedient ::= "expedient"

discard_choice_word ::= discard_choice_word_ambitious | discard_choice_word_expedient

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:$discard_value_comparison, value:ObjectProperty{object:Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}}, count:AsManyAsCan($card_count), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
discard_mana_value_seek ::= "seek" card_count "with" discard_value_comparison "mana" "value" "than" "the" "discarded" "card"

discard_value_comparison ::= kin_greater | kin_lesser

/* A loop over players moves each player's own top library cards to exile. */
/* @sem Instruction::ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]}} */
player_exile_own_top_one ::= players_singular "exiles" "the" "top" "card" "of" "their" "library"

/* @sem Instruction::ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}, count:$count_plural, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]}} */
player_exile_own_top_many ::= players_singular "exiles" "the" "top" count_plural "cards" "of" "their" "library"

player_exile_own_top ::= player_exile_own_top_one | player_exile_own_top_many

/* Scope the permission to this producer, including its exile destination. */
/* @sem Instruction::[$player_exile_own_top, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@prior, phase:After}, origins:CardPlayOrigins([Exile]), action:CastSpell, filter:Any}, terms:_{cost:Alternate(Cost{parts:[$cast_life_for_spell_mana_value]})}})], duration:$this_duration, evaluation:LiveObjects}}] */
instructions_player_exile_top_cast_life ::= player_exile_own_top "." "you" "may" "cast" "spells" "from" "among" "those" "cards" this_duration "." cast_life_for_spell_mana_value

/* The same announced player owns both the inspected hand and the castable cards. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Zone(_{scope:Players{zone:Hand, players:One(Target{slot:0, index:0})}, kind:Card, filter:Any})}}, Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Zone(_{scope:Players{zone:Hand, players:One(Target{slot:0, index:0})}, kind:Card, filter:Any}), count:UpTo(Constant(1)), terms:_{cost:Free}}}] */
instructions_target_hand_look_cast ::= "look" "at" "that" "player's" "hand" "and" "you" "may" "cast" "a" "spell" "from" "their" "hand" "without" "paying" "its" "mana" "cost"

/* A singular player's library supplies the cards of this face-down exile. */
/* @sem Operation::Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:$players_singular}, kind:Card, filter:Any}), count:$card_count, from:Top}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
player_exiles_top_face_down ::= players_singular "exiles" "the" "top" card_count "of" "their" "library" "face" "down"

/* @sem Operation::Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:$players_singular}, kind:Card, filter:Any}), count:$card_count, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
player_exiles_top_face_up ::= players_singular "exiles" "the" "top" card_count "of" "their" "library" "face" "up"

player_exiles_top_hidden ::= player_exiles_top_face_down | player_exiles_top_face_up

/* The visibility, permission and duration all refer to this exile's arrivals. */
/* @sem Instruction::[Effect{result:@next, operation:$player_exiles_top_hidden}, Effect{result:@next, operation:CreateContinuousEffect{source:$object_ref, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:Transition{result:@prior, phase:After}, audience:AffectedPlayer}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@prior, phase:After}, origins:CardPlayOrigins([Exile]), action:Either, filter:Any}, terms:_{cost:Normal, spend_as:$hidden_top_mana_kind}})], duration:WhileAnyExiled(Transition{result:@prior, phase:After}), evaluation:LiveObjects}}] */
player_hidden_top_play_any_mana ::= player_exiles_top_hidden "." "you" "may" "look" "at" "and" "play" "those" "cards" "for" "as" "long" "as" "they" "remain" "exiled" "." "if" "you" "cast" "a" "spell" "this" "way" "," "you" "may" "spend" "mana" "as" "though" object_ref "were" "mana" "of" "any" hidden_top_mana_kind "to" "cast" "it"

/* @sem SpendAs::AnyType */
hidden_top_mana_type ::= "type"

/* @sem SpendAs::AnyColor */
hidden_top_mana_color ::= "color"

hidden_top_mana_kind ::= hidden_top_mana_type | hidden_top_mana_color

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$player_hidden_top_play_any_mana}} */
spell_player_hidden_top_play ::= player_hidden_top_play_any_mana "."

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
search_shuffle_bare ::= "," "shuffle"

/* The bare shuffle is used before a following comma-then instruction. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:$search}, ...$search_follow_bare_shuffle] */
clause_search_bare_shuffle ::= search search_follow_bare_shuffle

search_follow_bare_shuffle ::= search_follow_bare_more | search_shuffle_bare

/* @sem Instruction::[Effect{result:@next, operation:$found_action}, ...$search_follow_bare_shuffle] */
search_follow_bare_more ::= "," found_action search_follow_bare_shuffle

/* The mana-value ceiling qualifies only the second alternative. */
/* @sem ObjectFilter::AnyOf([$card_filter, AllOf([$card_filter_2, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])]) */
search_filter_either_mana_ceiling ::= card_filter "card" "or" "a" card_filter "card" "with" "mana" "value" value "or" "less"

/* The selection and remainder are bound to the same private look. */
/* look_exile_one_of_them_face_down is shared as look_exile_one_among_face_down. */

/* This continuation refers to the one face-down exile produced by the enclosing
   look/selection/reorder sequence. Its fallback uses that same arrival. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:One(Result{result:@back(4), phase:After, index:0}), filter:AllOf([$exile_cast_instant, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$number_digits}}])}, count:Exactly(Constant(1)), cost:Free}}]}}]}, optional:true}}, If{condition:Not(PaymentChosen(@prior)), then:_{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:One(Result{result:@back(5), phase:After, index:0}), zone:Exile}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:_{}}] */
look_hidden_exile_cast_or_hand ::= "you" "may" "cast" "the" "exiled" "card" "without" "paying" "its" "mana" "cost" "if" "it's" exile_cast_instant "spell" "with" "mana" "value" number_digits "or" "less" "." "if" "you" "don't" "," "put" "that" "card" "into" "your" "hand"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:$look_top}, ...$look_exile_one_among_face_down, ...$look_exile_remainder, ...$look_hidden_exile_cast_or_hand]}} */
spell_look_hidden_exile_cast_or_hand ::= look_top "." look_exile_one_among_face_down "and" look_exile_remainder "." look_hidden_exile_cast_or_hand "."

/* The searched selection remains the referent after its reveal and move. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_single_library}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, If{condition:Compare{left:CountObjects(Matching{objects:Selected(@marked), filter:$search_selected_trait}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:$program, otherwise:_{}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
clause_search_reveal_hand_if_card ::= search_single_library "," "reveal" "it" "," "and" "put" "it" "into" "your" "hand" "." "if" "that" "card" "is" search_selected_trait "," program "." "then" "shuffle"

/* A searched card may be constrained by a counter-derived mana value. */
/* @sem SearchChoice::SearchChoice{filter:AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:CountCounters(_{recipients:Objects($affected), kind:$counter_kind, information:CurrentOrLastKnown})}}]), count:UpTo($counter_a)} */
search_choice_counter_mana_value ::= counter_a filter_phrase "card" "with" "mana" "value" "equal" "to" "the" "number" "of" counter_kind "counters" "on" affected

search_selected_trait ::= adjective_legendary | adjective_nonlegendary | adjective_snow

/* A one-card reveal tests a creature before its battlefield move.  The later
   reflexive sentence belongs to that move, not to the otherwise branch. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:CardType(Creature)}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:Observed(@marked), destination:$reveal_attack_destination, qualifiers:[]}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@prior, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Fight{first:Result{result:@reflexive_performed, phase:After, index:0}, second:$self_explicit_ref}}}]}})}]}, otherwise:Program{instructions:$reveal_fight_otherwise}}]} */
program_reveal_creature_entry_fight ::= "reveal" "the" "top" "card" "of" "your" "library" "." "if" "it's" "a" "creature" "card" "," "put" "it" reveal_attack_destination "." "otherwise" "," reveal_fight_otherwise "." "when" "you" "put" "a" "creature" "card" "onto" "the" "battlefield" "this" "way" "," "it" "fights" self_explicit_ref "."

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{player:DefendingPlayerOf(Source), or_planeswalker:true}]}} */
reveal_attack_tapped ::= "onto" "the" "battlefield" "tapped" "and" "attacking" "defending" "player" "or" "a" "planeswalker" "they" "control"

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[Attacking{player:DefendingPlayerOf(Source), or_planeswalker:true}]}} */
reveal_attack_untapped ::= "onto" "the" "battlefield" "attacking" "defending" "player" "or" "a" "planeswalker" "they" "control"

reveal_attack_destination ::= reveal_attack_tapped | reveal_attack_untapped | reveal_attack_player_tapped

/* @sem Ability::Triggered{event:Object{event:Attacks, objects:$event_self}, limits:TriggerLimits{}, announcement:@announcement, body:$program_reveal_creature_entry_fight} */
triggered_attack_reveal_entry_fight ::= "whenever" event_self "attacks" "," program_reveal_creature_entry_fight

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{player:DefendingPlayerOf(Source), or_planeswalker:false}]}} */
reveal_attack_player_tapped ::= "onto" "the" "battlefield" "tapped" "and" "attacking" "defending" "player"

reveal_fight_otherwise ::= reveal_fight_that_card_put | observed_top_reveal_branch

/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Observed(@marked), destination:$top_reveal_destination, qualifiers:[]}}] */
reveal_fight_that_card_put ::= "put" "that" "card" top_reveal_destination

/* Keep the search, its exile arrival, and its permission in one producer scope. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:EventSubject, choices:[_{filter:$noun, count:UpTo(Constant(1))}]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(EventSubject)}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:$duration, evaluation:LiveObjects}}]} */
search_event_player_exile_play_program ::= "search" "that" "player's" "library" "for" "an" noun "card" "and" "exile" "it" "." "then" "that" "player" "shuffles" "." duration "," "you" "may" "play" "that" "card" "."

/* A singular search and its battlefield arrival, composed by the scoped line. */
/* scoped_single_search is shared as paid_singular_search. */

/* @sem Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
scoped_found_battlefield ::= "put" "that" "card" "onto" "the" "battlefield"

/* The line scopes the casting payment and the search arrival together. */
/* @sem Ability::[Casting(AdditionalCost{cost:Cost{parts:[Sacrifice{objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$cast_sacrifice_head}, choose:Exactly(Constant(1))}]}, repetition:Once}), Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:$paid_singular_search}, Effect{result:@next, operation:$scoped_found_battlefield}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}, If{condition:ObjectMatches{object:Result{result:@back(2), phase:After, index:0}, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:Query{objects:CostObjects{payment:Casting{ability:0}, component:[0], view:Inputs, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}}, then:$program, otherwise:Program{}}]}}] */
line_cast_sacrifice_search_value ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," "sacrifice" cast_sacrifice_head "." NEWLINE paid_singular_search "," scoped_found_battlefield "," "then" "shuffle" "." "if" "it" "has" "mana" "value" "less" "than" "the" "sacrificed" "permanent's" "mana" "value" "," program "."

/* The comparison population belongs to the choice, so ordinary search
   continuations retain the selected cards and their destination. */
/* @sem SearchChoice::SearchChoice{filter:AllOf([Supertype(Basic), $filter_phrase, Not(SharesWithAny{property:LandTypes, with:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase_2}})]), count:UpTo(Constant(1))} */
search_choice_distinct_land_type ::= "a" "basic" filter_phrase "card" "that" "doesn't" "share" "a" "land" "type" "with" "a" filter_phrase

/* The compared permanent is another controlled object relative to the named
   object in this ability, independently of the card found by the search. */
/* @sem SearchChoice::SearchChoice{filter:SharesNameWithAny(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([Not(SameObject(@named_object)), $filter_phrase, ControlledBy(One(AbilityController))])}), count:UpTo(Constant(1))} */
search_choice_another_controlled_name ::= "a" "card" "with" "the" "same" "name" "as" "another" filter_phrase "you" "control"

/* A revealed top card supplies the test; both branches refer to the event-bound creature, independently of the
   player whose library was revealed. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(PlayerRef::EventSubject)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:$aura_reveal_then}, otherwise:Program{instructions:$aura_reveal_otherwise}}]} */
aura_upkeep_reveal_conditional ::= "that" "player" "reveals" "the" "top" "card" "of" "their" "library" "." "if" "that" "card" "is" top_reveal_quality "," aura_reveal_then "." "otherwise" "," aura_reveal_otherwise

/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:One(ObjectRef::EventSubject), regeneration:true}}] */
aura_reveal_then ::= "destroy" "that" "creature"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(ObjectRef::EventSubject)), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot}}] */
aura_reveal_otherwise ::= "it" "gets" signed "/" signed duration

/* The look, reveal payment, mana choice and both moves share the same top card.
   The colors are taken from the reveal payment's recorded card. */
/* @sem Program::Program{instructions:[...$top_card_look, Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[RevealTop($colored_symbol_threshold)]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:AddMana{players:One(AbilityController), mana:Repeat{amount:$value, production:ColorsAmong{objects:One(Recorded{result:@prior})}, choice:EachUnit}}}, Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]} */
program_look_reveal_colors_hand ::= top_card_look "you" "may" "reveal" "that" "card" "if" "it" "has" colored_symbol_threshold "." "if" "you" "do" "," "add" value "mana" "in" "any" "combination" "of" "its" "colors" "and" "put" "it" "into" "your" "hand" "." "if" "you" "don't" "reveal" "it" "," "put" "it" "into" "your" "hand" "."

/* @sem ObjectFilter::Property{property:ColorSymbolCount, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}} */
colored_symbol_threshold ::= value "or" "more" "colored" "mana" "symbols" "in" "its" "mana" "cost"

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$program_look_reveal_colors_hand} */
trigger_turn_look_reveal_colors_hand ::= "at" turn_event "," program_look_reveal_colors_hand

/* The observed cards remain in the library until the chosen cards move. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$filter_phrase}, count:AnyNumber, constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
look_any_tapped_shuffle ::= "put" "any" "number" "of" filter_phrase "cards" "from" "among" "them" "onto" "the" "battlefield" "tapped" "," "then" "shuffle"

dig_look_any_tapped_shuffle ::= dig_look_any_tapped_shuffle_period | dig_look_any_tapped_shuffle_comma

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$look_any_tapped_shuffle] */
dig_look_any_tapped_shuffle_period ::= look_top "." look_any_tapped_shuffle

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$look_any_tapped_shuffle] */
dig_look_any_tapped_shuffle_comma ::= look_top "," look_any_tapped_shuffle

/* A two-card search retains the search receipt across the reveal and split.
   The chosen card enters tapped; the remainder goes to its owner's hand. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:$filter_phrase, count:UpTo(Constant(2))}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Selected(@marked), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
clause_search_revealed_pair_split ::= "search" "your" "library" "for" "up" "to" "two" filter_phrase "cards" "and" "reveal" "them" "." "put" "one" "of" "them" "onto" "the" "battlefield" "tapped" "and" "the" "other" "into" "your" "hand" "," "then" "shuffle"

/* The threshold and difference measure the arrivals of this exact selected
   battlefield move. Keep its producer in the same inverse-printing scope. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:@agree($search_filter_many, $filter_plural)}, count:UpTo(@agree($count, $count_2)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@back(2), phase:After}, filter:@agree($search_filter_many, $filter_plural)}), test:NumberTest::Compare{comparison:Less, value:@agree($count, $count_2)}}, then:_{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Proliferate{times:Subtract(@agree($count, $count_2), CountObjects(Matching{objects:Transition{result:@back(3), phase:After}, filter:@agree($search_filter_many, $filter_plural)}))}}}]}, otherwise:_{}}] */
dig_entry_shortfall_proliferate ::= look_top "." "put" "up" "to" count search_filter_many "from" "among" "them" "onto" "the" "battlefield" "tapped" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order "." "if" "you" "put" "fewer" "than" count filter_plural "onto" "the" "battlefield" "this" "way" "," "proliferate" "a" "number" "of" "times" "equal" "to" "the" "difference" "."

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$dig_entry_shortfall_proliferate}} */
dig_entry_shortfall_spell ::= dig_entry_shortfall_proliferate

/* The selection and remainder both refer to the marked library observation.
   The move receipt excludes only cards actually moved from that observation. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($value), constraints:[CanMoveTo{destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:@that_player, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Top, order:$library_order}}] */
foreign_look_exile_remainder ::= "exile" value "of" "those" "cards" "and" "put" "the" "rest" "back" "on" "top" "of" "that" "player's" "library" library_order

/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One($target_possessive)}, kind:Card, filter:Any}, count:$top_count, from:Top}}}, ...$foreign_look_exile_remainder] */
instructions_foreign_look_exile ::= "look" "at" "the" "top" top_count "of" target_possessive "library" "." foreign_look_exile_remainder

/* The observation, selected entry, and remaining library cards share one scoped sequence. */
/* @sem Program::Program{instructions:[ForEachPlayer{players:$loop_player_population, binding:0, body:Program{instructions:[Effect{result:@mark, operation:RevealUntil{library:Bound(0), filter:$partition_reveal_filter, count:Constant(1)}}]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Observed(@marked), filter:$partition_choice_filter}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}]} */
reveal_each_choose_entry_partition ::= loop_player_population "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" "a" partition_reveal_filter "card" "." "choose" "one" "of" "the" "revealed" partition_choice_filter "cards" "and" "put" "it" "onto" "the" "battlefield" "under" "your" "control" "." "put" "all" "other" "cards" "revealed" "this" "way" "into" "their" "owners'" "graveyards"

/* @sem $card_filter */
partition_reveal_filter ::= card_filter

/* @sem $card_filter */
partition_choice_filter ::= card_filter

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:$reveal_each_choose_entry_partition} */
triggered_reveal_each_choose_entry_partition ::= event_clause "," reveal_each_choose_entry_partition "."

/* A counted observation and its independently reusable selection continuation. */
/* @sem Operation::LookAt{player:AbilityController, objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$distribution_counter_count, from:Top}} */
look_top_counter_quantity ::= "look" "at" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" distribution_counter_count

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:AllOf([$filter_phrase, AnyOf([CardType(Artifact), CardType(Battle), CardType(Creature), CardType(Enchantment), CardType(Land), CardType(Planeswalker)]), Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}])}, count:UpTo($counter_amount), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:$rest_bottom}] */
look_permanent_value_entry_remainder ::= "you" "may" "put" counter_amount filter_phrase "card" "with" "mana" "value" value "or" "less" "from" "among" "them" "onto" "the" "battlefield" "." "put" rest_bottom

/* @sem Instruction::[Effect{result:@mark, operation:$look_top_counter_quantity}, ...$look_permanent_value_entry_remainder] */
instructions_library_counter_look ::= look_top_counter_quantity "." look_permanent_value_entry_remainder

/* @sem Vec<Instruction>::@then_sequence($clause_before_then, $instructions_library_counter_look) */
instructions_then_library_observation ::= clause_before_then "." "then" instructions_library_counter_look

/* The event's mana value qualifies the stopping card, and the exile receipt
   identifies that same card in following instructions. */
/* @sem ObjectFilter::@and($card_filter, ObjectFilter::Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}}) */
exile_until_lesser_filter ::= card_filter "card" "with" "lesser" "mana" "value"

/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:$exile_until_lesser_filter, count:Constant(1)}}, Effect{result:@mark, operation:Operation::@exiled_card_result(Operation::Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]})}] */
clause_exile_until_lesser ::= "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" "a" exile_until_lesser_filter

/* Scope the remainder to the producer's exile receipt, including across the
   optional cast. */
/* @sem Instruction::[...$clause_exile_until_lesser, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$cast_exiled_card_free}]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, destination:Library{position:BottomRandom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
instructions_exile_until_lesser_cast_bottom ::= clause_exile_until_lesser "." "you" "may" cast_exiled_card_free "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* The tested top card and moved card are the same query, and the library
   belongs to the player whose graveyard was named. */
/* @prefer always */
/* @sem Instruction::[If{condition:ObjectMatches{object:Query{objects:Zone{scope:Players{zone:Graveyard, players:One($target_possessive)}, kind:Card, filter:Any}, index:0}, filter:$card_filter}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Graveyard, players:One($target_possessive)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:$graveyard_top_library_destination, qualifiers:[]}}]}, otherwise:Program{}}] */
clause_top_graveyard_kind_to_library ::= "if" "the" "top" "card" "of" target_possessive "graveyard" "is" "a" card_filter "card" "," "put" "that" "card" graveyard_top_library_destination

graveyard_top_library_destination ::= optional_look_top | optional_look_bottom

/* @sem MovementDestination::Library{position:BottomRandom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
graveyard_move_random_bottom ::= "on" "the" "bottom" "of" "their" "library" "in" "a" "random" "order"

/* @sem MovementDestination::Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
graveyard_move_library_top ::= "on" "top" "of" "their" "library"

/* @sem MovementDestination::Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
graveyard_move_library_bottom ::= "on" "the" "bottom" "of" "their" "library" "in" "any" "order"

graveyard_move_destination ::= graveyard_move_random_bottom | graveyard_move_library_top | graveyard_move_library_bottom

/* The selected card and the conditional library shuffle both refer to this search. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:$search_two_zones_cast_source}, Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Selected(@marked), count:AnyNumber, terms:_{cost:Free}}}, If{condition:Searched(@marked), then:Program{instructions:[Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:Program{}}]} */
program_search_hand_library_cast ::= search_two_zones_cast_source "." "you" "may" "cast" "it" "without" "paying" "its" "mana" "cost" "." "if" "you" "search" "your" "library" "this" "way" "," "shuffle"

search_hand_library_choice ::= search_choice_filtered | search_choice_optional_one | search_choice_draft_noted_name

/* @sem SearchChoice::SearchChoice{filter:DraftNoted(_{kind:Name, player:AbilityController, card:@card_name}), count:UpTo(Constant(1))} */
search_choice_draft_noted_name ::= "a" "card" "with" "a" "name" "noted" "as" "you" "drafted" "cards" "named" SELF_NAME

search_two_zones_cast_source ::= search_hand_library_either | search_graveyard_library_either | search_hand_library_both

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_hand_library_choice], also:[Hand], either:true} */
search_hand_library_either ::= "search" "your" "hand" "and" "/" "or" "library" "for" search_hand_library_choice

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_hand_library_choice], also:[Graveyard], either:true} */
search_graveyard_library_either ::= "search" "your" "graveyard" "and" "/" "or" "library" "for" search_hand_library_choice

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_hand_library_choice], also:[Hand], either:false} */
search_hand_library_both ::= "search" "your" "hand" "and" "library" "for" search_hand_library_choice

/* An immediate choice from the whole revealed hand retains its observation and owner. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($target_opponent)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@prior), zone:Hand}, filter:@and($a_card, ObjectFilter::OwnedBy(One(Target{slot:0, index:0})))}, count:AsManyAsCan(Constant(1))}}] */
revealed_opponent_hand_choice ::= target_opponent "reveals" "their" "hand" "." "you" "choose" a_card "from" "it"

/* Both choices retain their independent filters and the resulting objects. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(Target{slot:0, index:0})}, kind:Card, filter:$a_card}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Union([One(Result{result:@back(3), phase:After, index:0}), One(Result{result:@prior, phase:After, index:0})]), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
choose_opponent_graveyard_and_exile_choices ::= "then" "choose" a_card "from" "their" "graveyard" "." "exile" "the" "chosen" "cards"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$revealed_opponent_hand_choice, ...$choose_opponent_graveyard_and_exile_choices]}} */
spell_revealed_hand_and_graveyard_choices ::= revealed_opponent_hand_choice "," choose_opponent_graveyard_and_exile_choices "."

/* This continuation binds the choice, face-down move and its remainder together. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($value), constraints:[CanMoveTo{destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
observed_exile_down_remainder ::= "exile" value "face" "down" "," "then" "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$observed_exile_down_remainder] */
dig_look_exile_down_remainder ::= look_top "," observed_exile_down_remainder

/* Keep the optional reveal, its test, and the moved top card in one scope. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:_{parts:[PlayerAction{player:AbilityController, body:_{instructions:[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}]}}]}, optional:true}}, If{condition:PaymentChosen(@prior), then:_{instructions:[If{condition:Compare{left:CountObjects(Matching{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:_{instructions:[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[Attacking{}]}}, qualifiers:[]}}, ...$arriving_conditional_keyword_pair]}, otherwise:_{}}]}, otherwise:_{}}] */
optional_revealed_attacker_grants ::= "you" "may" "reveal" "the" "top" "card" "of" "your" "library" "." "if" top_reveal_quality "is" "revealed" "this" "way" "," "put" "it" "onto" "the" "battlefield" "tapped" "and" "attacking" "." arriving_conditional_keyword_pair

/* Both grants refer to the same immediately preceding battlefield arrival. */
/* @sem Instruction::[...$arriving_keyword_if_a, ...$arriving_keyword_if_an] */
arriving_conditional_keyword_pair ::= "until" "your" "next" "turn" "," "it" "gains" arriving_keyword_if_a "and" arriving_keyword_if_an

/* @sem Instruction::[If{condition:Controls{player:AbilityController, filter:$subtype, minimum:1}, then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@marked, phase:After, index:0})), changes:[GrantKeyword($keyword_name)], duration:UntilNextTurn(AbilityController), evaluation:Snapshot}}]}, otherwise:_{}}] */
arriving_keyword_if_a ::= keyword_name "if" "you" "control" "a" subtype

/* @sem Instruction::[If{condition:Controls{player:AbilityController, filter:$subtype, minimum:1}, then:_{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@marked, phase:After, index:0})), changes:[GrantKeyword($keyword_name)], duration:UntilNextTurn(AbilityController), evaluation:Snapshot}}]}, otherwise:_{}}] */
arriving_keyword_if_an ::= keyword_name "if" "you" "control" "an" subtype

/* A scry may precede the scoped optional reveal after any supported trigger. */
/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:@apply(PlayerSet::One(AbilityController), $scry_base)}, ...$optional_revealed_attacker_grants]}} */
triggered_scry_optional_revealed_attacker ::= event_clause "," scry_base "," "then" optional_revealed_attacker_grants "."

/* The cast uses the singleton proved by the immediately preceding exile-until. */
/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:One(@exiled_card_reference), filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value_self_stat}}}, count:Exactly(Constant(1)), cost:Free} */
cast_exile_until_bounded_spell ::= "cast" "the" "exiled" "card" "without" "paying" "its" "mana" "cost" "if" "it's" "a" "spell" "with" "mana" "value" "less" "than" "or" "equal" "to" value_self_stat

/* Scope the cleanup to the exile producer and its immediately following cast. */
/* @sem Instruction::[...$clause_exile_until_card, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$cast_exile_until_bounded_spell}]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Transition{result:@back(3), phase:After}, zone:Exile}, destination:Library{position:BottomRandom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
instructions_exile_until_bounded_cast_cleanup ::= clause_exile_until_card "." "you" "may" cast_exile_until_bounded_spell "." "put" "the" "exiled" "cards" "not" "cast" "this" "way" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* A search compares each candidate's total to the event subject as it last existed. */
/* @prefer always */
/* @sem ObjectFilter::AllOf([$card_filter, Property{property:TotalPowerAndToughness, test:NumberTest::Compare{comparison:Equal, value:ObjectProperty{object:EventSubject, property:TotalPowerAndToughness, information:CurrentOrLastKnown}}}]) */
search_filter_same_total_event ::= card_filter "card" "with" "the" "same" "total" "power" "and" "toughness"

/* An intervening trigger may contain an optional matching-card search episode. */
/* @prefer always */
/* @sem Ability::Triggered{event:$event_clause, intervening_if:$condition, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:$search_same_total_episode}}]}} */
triggered_if_optional_same_total_search ::= event_clause "," "if" condition "," "you" "may" search_same_total_episode "."

/* @sem Instruction::[Effect{result:@mark, operation:$search_library_same_total}, ...$search_follow] */
search_same_total_episode ::= search_library_same_total search_follow

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[SearchChoice{filter:$search_filter_same_total_event, count:UpTo(Constant(1))}]} */
search_library_same_total ::= "search" "your" "library" "for" "a" search_filter_same_total_event

/* Reveal one targeted player's whole hand and choose one card outside a basic type. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Zone{scope:Players{zone:Hand, players:One($revealed_choice_target)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@prior), zone:Hand}, filter:@and(ObjectFilter::Not(AllOf([Supertype(Basic), $noun])), ObjectFilter::OwnedBy(One(Target{slot:0, index:0})))}, count:AsManyAsCan(Constant(1))}}] */
revealed_hand_except_basic_choice ::= revealed_choice_target "reveals" "their" "hand" "," "then" "you" "choose" "a" "card" "other" "than" "a" "basic" noun "card" "from" "it"

revealed_choice_target ::= target_player | target_opponent

/* Search that same player's zones for cards matching the immediately chosen card. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:Target{slot:0, index:0}, choices:[_{filter:SharesNameWith(Result{result:@prior, phase:After, index:0}), count:$name_search_count}], also:[Graveyard, Hand]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Target{slot:0, index:0})}}] */
chosen_card_name_search_exile ::= "search" "that" "player's" "graveyard" "," "hand" "," "and" "library" "for" name_search_count "cards" "with" "the" "same" "name" "as" "the" "chosen" "card" "and" "exile" "them" "." "then" "that" "player" "shuffles"

/* The choice is the adjacent search's name source and fixes its player. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$revealed_hand_except_basic_choice, ...$chosen_card_name_search_exile]}} */
spell_hand_choice_name_search ::= revealed_hand_except_basic_choice "." chosen_card_name_search_exile "."

/* The producer and consumer share a scope: that many counts this sacrifice's
   Before receipt, and the search selection supplies the battlefield move. */
/* @sem Instruction::[Effect{result:@next, operation:$sacrifice_variable_population}, ...$sacrifice_count_search_battlefield] */
instructions_sacrifice_count_search ::= sacrifice_variable_population "." sacrifice_count_search_battlefield

/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:$filter_phrase, count:UpTo(CountObjects(Transition{result:@prior, phase:Before}))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
sacrifice_count_search_battlefield ::= "search" "your" "library" "for" "up" "to" "that" "many" filter_phrase "cards" "," "put" "them" "onto" "the" "battlefield" "tapped" "," "then" "shuffle"

/* The hand move and remainder share the observation, and retain the hand receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AnyNumber, constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
observed_any_hand_graveyard ::= "you" "may" "put" "any" "number" "of" "them" "into" "your" "hand" "and" "the" "rest" "into" "your" "graveyard"

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$observed_any_hand_graveyard] */
dig_look_any_hand_graveyard ::= look_top "." observed_any_hand_graveyard

/* This continuation is only exposed with its hand-move producer. */
/* @sem Instruction::Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:Multiply($number, CountObjects(Transition{result:@back(3), phase:After}))}} */
observed_hand_move_life_loss ::= "you" "lose" number "life" "for" "each" "card" "you" "put" "into" "your" "hand" "this" "way"

/* @sem Instruction::[...$dig_look_any_hand_graveyard, $observed_hand_move_life_loss] */
dig_look_any_hand_loss ::= dig_look_any_hand_graveyard "." observed_hand_move_life_loss

/* The comparison population belongs to the named player's graveyard. */
/* @sem @and($card_filter, ObjectFilter::SharesNameWithAny(Zone(_{scope:Players{zone:Graveyard, players:One($player_possessive)}, kind:Card, filter:Any}))) */
search_filter_same_name_graveyard ::= card_filter "card" "with" "the" "same" "name" "as" "a" "card" "in" player_possessive "graveyard"

/* A top-library exile and the permission that uses its actual arrival receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@marked, phase:After}, origins:CardPlayOrigins([Exile]), action:PlayLand, filter:Any}), PlayerRule(PlayPermission{cards:Transition{result:@marked, phase:After}, origins:CardPlayOrigins([Exile]), action:CastSpell, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}] */
exile_top_play_both_actions ::= exile_top_cards_of_your_library "." "you" "may" "play" "those" "cards" this_duration

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$exile_top_play_both_actions}} */
triggered_exile_top_play_both_actions ::= event_clause "," exile_top_play_both_actions "."

/* The look, singular exile and permission share one library query and one
   immediately produced exile arrival. */
/* linked_look_event_owner is shared as look_exile_event_owner. */

linked_look_library_owner ::= look_exile_event_owner | zone_your

/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One($linked_look_library_owner)}, kind:Card, filter:Any}, count:Constant(1), from:Top}}}, Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($linked_look_library_owner)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:$look_top_exile_destination, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:$exiled_play_action, filter:Any}, terms:_{cost:Normal, spend_as:$linked_look_spending}})], duration:WhileExiled(Result{result:@prior, phase:After, index:0}), evaluation:LiveObjects}}] */
linked_look_top_exile_play ::= "look" "at" "the" "top" "card" "of" linked_look_library_owner "library" "," "then" look_top_exile_destination "." "you" "may" exiled_play_action "it" "for" "as" "long" "as" "it" "remains" "exiled" "." linked_look_spending

/* @sem SpendAs::AnyType */
linked_look_spending_type ::= "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "a" "spell" "this" "way"

/* @sem SpendAs::AnyColor */
linked_look_spending_color ::= "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "a" "spell" "this" "way"

linked_look_spending ::= linked_look_spending_type | linked_look_spending_color

/* Self combat damage binds the damaged player for the reusable linked phrase. */
/* @sem Ability::Triggered{event:Damage(_{source_kind:Permanent, sources:$event_self, recipients:Players($combat_damage_player_set), kind:Combat, grouping:SourceRecipient, subject:Source}), limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$linked_look_top_exile_play}} */
triggered_self_combat_linked_look ::= ("when" | "whenever") event_self "deals" "combat" "damage" "to" combat_damage_player_set "," linked_look_top_exile_play "."

/* The search, exile and draw share one producer and its hand receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:ControllerOf($that_noun), choices:[_{filter:SharesNameWith($that_noun), count:$named_search_count}], also:[Graveyard, Hand]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf($that_noun))}}, Effect{result:@next, operation:Draw{players:One(ControllerOf($that_noun)), amount:CountObjects(InZone{objects:Transition{result:@marked, phase:Before}, zone:Hand})}}] */
clause_search_controller_name_exile_draw ::= "search" "its" "controller's" "graveyard" "," "hand" "," "and" "library" "for" named_search_count "cards" "with" "the" "same" "name" "as" that_noun "and" "exile" "them" "." "that" "player" "shuffles" "," "then" "draws" "a" "card" "for" "each" "card" "exiled" "from" "their" "hand" "this" "way"

/* Countering establishes the antecedent before the shared search episode. */
/* @sem Instruction::[Effect{result:@next, operation:$counter_stack_action}, ...$clause_search_controller_name_exile_draw] */
instructions_counter_search_name_exile_draw ::= counter_stack_action "." clause_search_controller_name_exile_draw

/* The permission names the arrival of this exact face-down top-card move. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(EventSubject)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}, Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(EventSubject)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:CastSpell, filter:Any})], duration:WhileExiled(Result{result:@prior, phase:After, index:0}), evaluation:LiveObjects}}] */
instructions_event_top_hidden_permission ::= "look" "at" "the" "top" "card" "of" "that" "player's" "library" "and" "exile" "it" "face" "down" "." "you" "may" "cast" "that" "card" "for" "as" "long" "as" "it" "remains" "exiled"

/* The singleton lookup, exile and permission share the same library query and
   the exact exile arrival; the owner and play terms remain independent. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One($hidden_top_library_owner)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}, Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One($hidden_top_library_owner)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:$exiled_play_action, filter:Any}, terms:_{cost:Normal, spend_as:$hidden_top_spending}})], duration:WhileExiled(Result{result:@prior, phase:After, index:0}), evaluation:LiveObjects}}] */
instructions_look_top_hidden_play ::= "look" "at" "the" "top" "card" "of" hidden_top_library_owner "library" "," "then" "exile" "it" "face" "down" "." "for" "as" "long" "as" "it" "remains" "exiled" "," "you" "may" exiled_play_action "it" "," "and" hidden_top_spending

hidden_top_library_owner ::= hidden_top_their | zone_your

/* @sem PlayerRef::EventSubject */
hidden_top_their ::= "their"

hidden_top_spending ::= chosen_exile_spending_type | chosen_exile_spending_color

/* This entry pairs the reusable instruction with an equipped-creature event. */
/* @sem Ability::Triggered{event:$hidden_equipped_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$instructions_look_top_hidden_play}} */
hidden_equipped_trigger ::= "whenever" hidden_equipped_event "," instructions_look_top_hidden_play "."

/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:SameObject(AttachedTo(Source)), recipients:Players(All), kind:Combat, grouping:SourceRecipient, subject:Source}) */
hidden_equipped_event ::= "equipped" "creature" "deals" "combat" "damage" "to" "a" "player"

/* The permission and duration refer to the immediately preceding exile arrival. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_top_card_you}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:$exiled_play_action, filter:Any}, terms:_{cost:Normal, condition:$exile_permission_condition}})], duration:WhileExiled(Result{result:@prior, phase:After, index:0}), evaluation:LiveObjects}}] */
clause_exile_top_conditional_permission ::= exile_top_card_you "." "for" "as" "long" "as" "that" "card" "remains" "exiled" "," "you" "may" exiled_play_action "it" "if" exile_permission_condition

/* @sem Condition::Controls{player:AbilityController, filter:$filter_phrase, minimum:1} */
exile_permission_condition ::= "you" "control" "a" filter_phrase

/* Keep the visibility permission bound to this singular face-down exile arrival. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Constant(1), from:$ordered_end}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:One(Result{result:@prior, phase:After, index:0}), audience:AffectedPlayer})], duration:WhileExiled(Result{result:@prior, phase:After, index:0}), evaluation:LiveObjects}}]} */
program_hidden_own_library_card ::= "exile" "the" ordered_end "card" "of" "your" "library" "face" "down" "." "you" "may" "look" "at" "that" "card" "for" "as" "long" "as" "it" "remains" "exiled" "."

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:$program_hidden_own_library_card} */
triggered_hidden_own_library_card ::= "at" turn_event "," program_hidden_own_library_card

/* Keep the observed slice, selected cards and movement receipt in one contract. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:$look_top_spelled_count}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$filter_phrase}, count:AnyNumber, constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}]} */
program_look_reveal_any_hand_bottom ::= look_top_spelled_count "." "you" "may" "reveal" "any" "number" "of" filter_phrase "cards" "from" "among" "them" "and" "put" "them" "into" "your" "hand" "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* The target is established before its controller makes the optional search. */
/* @sem Instruction::[Effect{result:@next, operation:Destroy{objects:One($target_object), regeneration:true}}, $target_controller_optional_search] */
destroy_target_controller_optional_search ::= "destroy" target_object "." target_controller_optional_search

/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[...$destroy_target_controller_optional_search, Effect{result:@next, operation:$operation_you}]}} */
activated_destroy_controller_search_follow ::= cost ":" destroy_target_controller_optional_search "." operation_you "."

/* The search selection supplies the test, optional entry and remaining-card move. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_any]}}, If{condition:Compare{left:CountObjects(Matching{objects:Selected(@marked), filter:$noun}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Selected(@marked), count:AnyNumber, constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{}}, qualifiers:[]}}}]}, otherwise:Program{}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
search_single_test_entry_hand ::= "search" "your" "library" "for" search_choice_any "." "if" "it's" "an" noun "card" "," "you" "may" "put" "it" "onto" "the" "battlefield" "." "otherwise" "," "put" "that" "card" "into" "your" "hand" "." "then" "shuffle"

/* A named target supplies the name to compare; the search result remains
   available to the ordinary search follow-ups. */
/* @sem SearchChoice::SearchChoice{filter:SharesNameWith($target_object), count:UpTo($card_count_one)} */
search_choice_target_same_name ::= card_count_one "with" "the" "same" "name" "as" target_object

/* This surface form keeps its explicit found-card anaphor without changing
   the default anaphor for unrelated searches. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:$search_target_same_name}, Effect{result:@next, operation:$found_target_named_battlefield}, ...$search_follow] */
clause_search_target_same_name ::= search_target_same_name "," found_target_named_battlefield search_follow

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_target_same_name]} */
search_target_same_name ::= "search" "your" "library" "for" search_choice_target_same_name

/* @sem Operation::@search_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}) */
found_target_named_battlefield ::= "put" "that" "card" "onto" "the" "battlefield"

/* The remainder excludes the selected cards actually moved to their owners' hands. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($number), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
look_put_some_hand_remainder ::= look_top "." "put" number "of" "them" "into" "your" "hand" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* A singular player's revealed card comes from that player's own library. */
/* @sem Operation::Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:$players_singular}, kind:Card, filter:Any}, count:Constant(1), from:Top}} */
player_reveals_top_one ::= players_singular "reveals" "the" "top" "card" "of" "their" "library"

/* Search and opponent partition share the selection and its unselected remainder. */
/* @sem SearchChoice::SearchChoice{filter:AllOf([$filter_phrase, Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}]), count:UpTo($value), constraints:[DifferentNames]} */
search_choice_distinct_value_ceiling ::= "up" "to" value filter_phrase "cards" "with" "different" "names" "that" "each" "have" "mana" "value" number "or" "less"

/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_distinct_value_ceiling], also:[Graveyard]}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:ChooseObjects{player:OneOf(OpponentsOf(AbilityController)), objects:Selected(@back(3)), count:AsManyAsCan($value)}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController), excluding:Unselected(@prior)}}, Effect{result:@next, operation:Move{objects:Unselected(@back(3)), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
clause_search_opponent_partition ::= "search" "your" "library" "and" "graveyard" "for" search_choice_distinct_value_ceiling "and" "reveal" "them" "." "an" "opponent" "chooses" value "of" "those" "cards" "." "shuffle" "the" "chosen" "cards" "into" "your" "library" "and" "put" "the" "rest" "onto" "the" "battlefield"

/* The random singleton, its exile arrival, and the permission name one receipt.
   The event provides both the library owner and the damage amount. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(EventSubject)}, kind:Card, filter:Property{property:$stat, test:NumberTest::Compare{comparison:$stat_comparison, value:EventAmount}}}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:CastSpell, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}] */
random_event_library_exile_cast ::= "exile" "from" "that" "player's" "library" "a" "random" "card" "with" stat stat_comparison "the" "damage" "dealt" "." "you" "may" "cast" "that" "card" this_duration

/* A preceding independent clause may use the same linked exile continuation. */
/* @sem Instruction::[...$clause, ...$random_event_library_exile_cast] */
instructions_then_random_library_cast ::= clause "." "then" random_event_library_exile_cast

/* The damage event supplies the specific player and amount used by the continuation. */
/* @sem Ability::Triggered{event:$event_combat_damage_player, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$instructions_then_random_library_cast}} */
triggered_combat_random_library_cast ::= "whenever" event_combat_damage_player "," instructions_then_random_library_cast "."

/* The look and immediate move name the same current top card. The permission
   refers to the actual exile arrival, not an unrelated preceding receipt. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:LookAt{player:AbilityController, objects:$look_move_library_top}}, Effect{result:@next, operation:Move{objects:$look_move_library_top, destination:$look_top_exile_destination, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:$exiled_play_action, filter:Any})], duration:WhileExiled(Result{result:@prior, phase:After, index:0}), evaluation:LiveObjects}}]} */
program_look_top_move_play_while_exiled ::= "look" "at" look_move_library_top "," "then" look_top_exile_destination "." "you" "may" exiled_play_action "that" "card" "for" "as" "long" "as" "it" "remains" "exiled" "."

look_move_library_top ::= look_move_top_that_player | single_library_top

/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One(@that_player)}, kind:Card, filter:Any}, count:Constant(1), from:Top} */
/* @prefer always */
look_move_top_that_player ::= "the" "top" "card" "of" "that" "player's" "library"

dig_any_tail ::= dig_any_existing_tail | dig_any_chosen_type_tail

/* @prefer always */
/* @sem $search_filter_many */
dig_any_existing_tail ::= search_filter_many "from" "among" "them" "and" "put" dig_found_many

/* @sem ObjectFilter::Chosen(CreatureType) */
dig_any_chosen_type_tail ::= "cards" "of" "the" "chosen" "type" "from" "among" "them" "and" "put" "the" "revealed" "cards"

/* A type choice can precede any supported look-and-partition. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$choose_creature_type_plain}, ...$dig_look_split] */
chosen_creature_type_look_partition ::= choose_creature_type_plain "." dig_look_split

/* The observation and its conditional payment remain in one instruction scope.
   The graveyard destination belongs to the observed card's owner. */
/* @sem Operation::LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly(Constant(1)), filter:Any, players:All}), index:0})}, kind:Card, filter:Any}, count:Constant(1), from:Top}} */
look_target_player_top_card ::= "look" "at" "the" "top" "card" "of" "target" "player's" "library"

/* @sem Instruction::[If{condition:ObjectMatches{object:Query{objects:Observed(@marked), index:0}, filter:$adjective_nontype}, then:Program{instructions:[Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Life($number)]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:Move{objects:Observed(@marked), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{}}]}, otherwise:Program{}}] */
looked_card_paid_graveyard ::= "if" "it's" "a" adjective_nontype "card" "," "you" "may" "pay" number "life" "." "if" "you" "do" "," "put" "it" "into" "that" "player's" "graveyard"

/* @sem Instruction::[Effect{result:@mark, operation:$look_target_player_top_card}, ...$looked_card_paid_graveyard] */
instructions_looked_card_paid_graveyard ::= look_target_player_top_card "." looked_card_paid_graveyard

/* The permission consumes the arrival receipt of this specific exile producer. */
/* @sem Instruction::[Effect{result:@mark, operation:$player_exiles_top_cards}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@marked, phase:After}, origins:CardPlayOrigins([Exile]), action:Either, filter:Any}, terms:_{cost:Free, into_exile:false, effects:[], flash:false, may_look:false}})], duration:EndOfTurn, evaluation:LiveObjects}}] */
instructions_player_exile_top_free_play ::= player_exiles_top_cards "." "until" "end" "of" "turn" "," "you" "may" "play" "those" "cards" "without" "paying" "their" "mana" "costs"

/* The explicit order spells the same chosen ordering of the remaining cards. */
/* @sem $clause_opponent_piles_bottom */
clause_opponent_piles_bottom_ordered ::= clause_opponent_piles_bottom "in" "any" "order"

/* Search and place one selected card; the shuffle can be deferred by its enclosing process. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$repeat_search_one_choice]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}] */
search_one_put_tapped ::= "search" "your" "library" "for" repeat_search_one_choice "and" "put" "it" "onto" "the" "battlefield" "tapped"

repeat_search_one_choice ::= search_choice_filtered | search_choice_optional_one

/* @sem Instruction::Optional{decider:AbilityController, body:Program{instructions:$search_one_put_tapped}} */
optional_search_one_put_tapped ::= "you" "may" search_one_put_tapped

/* The deferred shuffle belongs to this search process, including any repetitions. */
/* @sem Instruction::[Repeatable{instructions:[$optional_search_one_put_tapped, $conditional_repeat_once]}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::ShuffleIfSearched}}] */
repeat_optional_search_shuffle ::= optional_search_one_put_tapped "." conditional_repeat_once "." "if" "you" "search" "your" "library" "this" "way" "," "shuffle"

/* The remainder is the observed library slice less the preceding move. */
/* @sem Operation::Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(2), phase:Before}])}, zone:Library}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
rest_hand ::= "the" "rest" "into" "your" "hand"

/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$dig_opponent_observed_one, $opponent_observed_rest] */
dig_reveal_opponent_observed ::= reveal_top "." dig_opponent_observed_one opponent_observed_rest

/* @sem Instruction::Effect{result:@next, operation:$opponent_observed_rest_destination} */
opponent_observed_rest ::= "and" opponent_observed_rest_destination

opponent_observed_rest_destination ::= rest_hand | look_rest

/* A singular choice from the revealed slice, followed by its disposition. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:OneOf(OpponentsOf(AbilityController)), objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$observed_choice_destination, qualifiers:[]}}] */
dig_opponent_observed_one ::= "an" "opponent" "chooses" "one" "of" "them" "." "put" "that" "card" observed_choice_destination

observed_choice_destination ::= top_reveal_graveyard | until_hand

/* Reveal a library slice and choose at most one card for each named filter.
   The observation and the choice remain in the same instruction scope. */
/* @sem Operation::Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:Add($number, $card_count), from:Top}} */
reveal_top_plus ::= "reveal" "the" "top" number "plus" card_count "of" "your" "library"

reveal_choice_source ::= reveal_top | reveal_top_plus

/* @sem SelectionConstraint::OneForEach([$filter_phrase, $filter_phrase_2]) */
choose_two_types ::= "choose" "a" filter_phrase "card" "and" "/" "or" "a" filter_phrase "card" "from" "among" "them"

/* @sem $library_order */
chosen_pair_hand_order ::= "put" "those" "cards" "into" "your" "hand" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem $library_order */
chosen_pair_split_order ::= "put" "the" "chosen" "cards" "onto" "the" "battlefield" "or" "into" "your" "hand" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Instruction::[Effect{result:@next, operation:$reveal_choice_source}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@prior), zone:Library}, count:UpTo(Constant(2)), constraints:[$choose_two_types]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$chosen_pair_hand_order}}] */
reveal_pair_hand ::= reveal_choice_source "." choose_two_types "." chosen_pair_hand_order

/* @sem Instruction::[If{condition:Compare{left:$number, test:NumberTest::Compare{comparison:GreaterOrEqual, value:$value}}, then:Program{instructions:[Effect{result:@next, operation:$reveal_choice_source}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@prior), zone:Library}, count:UpTo(Constant(2)), constraints:[$choose_two_types]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Selected(@prior), count:AnyNumber, constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Difference{objects:Selected(@back(4)), excluding:Selected(@back(3))}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(6)), excluding:Union([Transition{result:@back(3), phase:Before}, Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$chosen_pair_split_order}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:$reveal_choice_source}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@prior), zone:Library}, count:UpTo(Constant(2)), constraints:[$choose_two_types]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$chosen_pair_hand_order}}]}}] */
reveal_pair_conditional_destination ::= reveal_choice_source "." choose_two_types "." chosen_pair_hand_order "." "if" number "is" value "or" "more" "," "instead" chosen_pair_split_order

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$reveal_pair_conditional_destination}} */
spell_reveal_pair_conditional ::= reveal_pair_conditional_destination "."

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$reveal_pair_hand}} */
spell_reveal_pair_hand ::= reveal_pair_hand "."

/* The prior target supplies the controller, while the selected card retains its owner. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:ControllerOf(Target{slot:@last_slot, index:0}), objects:Zone{scope:Players{zone:Library, players:One(ControllerOf(Target{slot:@last_slot, index:0}))}, kind:Card, filter:$a_card}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_target_controller_seeks ::= "its" "controller" "seeks" a_card

/* Scope the pronoun to the one target named by the preceding exile. */
/* @sem Operation::Move{objects:One($seek_exile_target), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
seek_exile_target_action ::= "exile" seek_exile_target

seek_exile_target ::= target_up_to_one | target_permanent

/* @sem Instruction::[Effect{result:@next, operation:$seek_exile_target_action}, ...$clause_target_controller_seeks] */
instructions_exile_target_controller_seeks ::= seek_exile_target_action "." clause_target_controller_seeks

/* The alternative replaces the top placement, while both destinations retain
   the selection made by the enclosing search. */
/* @sem Instruction::[Effect{result:@next, operation:Shuffle{players:One(AbilityController), excluding:Selected(@marked)}}, If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:$search_conditional_entry}]}, otherwise:Program{instructions:[Effect{result:@next, operation:$search_conditional_top}]}}] */
search_shuffle_conditional_top ::= "," "then" "shuffle" "and" search_conditional_top "." "if" condition "," search_conditional_entry "instead"

/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@marked), end:Top, order:Chosen} */
search_conditional_top ::= "put" "that" "card" "on" "top"

/* @sem Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:$search_option_entry}, qualifiers:[]} */
search_conditional_entry ::= "put" "that" "card" search_option_entry

/* The choice is from the same player's whole hand that was just inspected. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One($hand_look_that)}, kind:Card, filter:Any}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One($hand_look_that)}, kind:Card, filter:$a_card}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:DiscardObjects{objects:Selected(@prior)}}] */
clause_look_hand_choose_discard ::= "look" "at" hand_look_that "hand" "and" "choose" a_card "from" "it" "." "the" "player" "discards" "that" "card"

/* A looked-at creature's entry is the producer of its reflexive damage. The
   callback's target and measured property remain operands of that callback. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$look_entry_reflexive_damage] */
instructions_look_entry_reflexive_damage ::= look_top "." look_entry_reflexive_damage

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$noun_creature}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:_{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:_{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:@reflexive(Operation::ReflexiveTrigger{performed:@marked, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:DealDamage{source:Result{result:@reflexive_performed, phase:After, index:0}, recipients:$recipients_target_opponent_controls, amount:ObjectProperty{object:Result{result:@reflexive_performed, phase:After, index:0}, property:$stat, information:CurrentOrLastKnown}, preventable:true}}]}})}]}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:RemainingToBottomAtRandom}}] */
look_entry_reflexive_damage ::= "you" "may" "put" "a" noun_creature "card" "from" "among" "them" "onto" "the" "battlefield" "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order" "." "when" "a" "creature" "is" "put" "onto" "the" "battlefield" "this" "way" "," "it" "deals" "damage" "equal" "to" "its" stat "to" recipients_target_opponent_controls

/* Keep the optional mill and the selection of its arrivals in one contract. */
/* optional_mill_event_count is shared as mill_cast_event_amount. */

/* @sem $card_count_many */
optional_mill_fixed_count ::= card_count_many

optional_mill_count ::= mill_cast_event_amount | optional_mill_fixed_count

/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$optional_mill_count}}]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase}, count:AnyNumber}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$look_battlefield_tapped, qualifiers:[]}}] */
instructions_optional_mill_choose_battlefield ::= "you" "may" "mill" optional_mill_count "." "put" "any" "number" "of" filter_phrase "cards" "from" "among" "them" look_battlefield_tapped

/* The visibility permission refers to the immediately preceding face-down
   library exile, and both uses retain the same arrival receipt. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($target_possessive)}, kind:Card, filter:Any}, count:$card_count_many, from:Top}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:Transition{result:@marked, phase:After}, audience:AffectedPlayer})], duration:WhileAnyExiled(Transition{result:@marked, phase:After}), evaluation:LiveObjects}}] */
hidden_target_top_access ::= "exile" "the" "top" card_count_many "of" target_possessive "library" "face" "down" "." "you" "may" "look" "at" "those" "cards" "for" "as" "long" "as" "they" "remain" "exiled"

/* The selected cards are arrivals of this mill, even across the payment. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:PayCost{player:AbilityController, cost:Cost{parts:[Mana($mana_symbols), Life($value)]}, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Transition{result:@marked, phase:After}, count:Exactly($card_count_2)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{}}] */
instructions_mill_pay_take_cards ::= "mill" card_count "." "then" "you" "may" "pay" mana_symbols "and" value "life" "." "if" "you" "do" "," "put" card_count "from" "among" "those" "cards" "into" "your" "hand"

/* @sem Ability::Triggered{event:$turn_event, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$instructions_mill_pay_take_cards}} */
triggered_mill_pay_take_cards ::= "at" turn_event "," instructions_mill_pay_take_cards "."

/* Keep the observed library, the selected exile arrival, and the remainder in
   one scope: the permission names that same singular exile result. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(EventSubject)}, kind:Card, filter:Any}), count:$count_plural, from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@prior), zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@back(3), phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:$exiled_play_action, filter:Any}, terms:_{cost:Normal, spend_as:$event_library_spending}})], duration:WhileExiled(Result{result:@back(3), phase:After, index:0}), evaluation:LiveObjects}}]} */
event_library_exile_remainder_permission ::= "look" "at" "the" "top" count_plural "cards" "of" "that" "player's" "library" "," "exile" "one" "of" "them" "face" "down" "," "then" "put" "the" "rest" "into" "their" "graveyard" "." "you" "may" exiled_play_action "that" "card" "for" "as" "long" "as" "it" "remains" "exiled" "," "and" event_library_spending

event_library_spending ::= hidden_exile_any_type | hidden_exile_any_type_it | choice_two_zones_spending_color | exile_table_spending_it | event_library_spending_colorless | event_library_spending_colorless_it

/* @prefer always */
/* @sem SpendAs::ColorlessAsAnyColor */
event_library_spending_colorless ::= "you" "may" "spend" "colorless" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "that" "spell"

/* @sem SpendAs::ColorlessAsAnyColor */
event_library_spending_colorless_it ::= "you" "may" "spend" "colorless" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "it"

/* @sem Ability::Triggered{event:$event_combat_damage_player, limits:_{}, announcement:@announcement, body:$event_library_exile_remainder_permission} */
combat_damage_event_library_permission ::= "whenever" event_combat_damage_player "," event_library_exile_remainder_permission "."

/* A looked-at slice, optional entry, fallback hand move, and both remainder paths share their actual receipts. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$observed_entry_fallback] */
dig_look_optional_entry_fallback ::= look_top "." observed_entry_fallback

/* @sem Instruction::[...$observed_optional_entry, $observed_entry_fallback_branch] */
observed_entry_fallback ::= observed_optional_entry "." observed_entry_fallback_branch

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:$noun}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}] */
observed_optional_entry ::= "you" "may" "put" "a" noun "card" "from" "among" "them" "onto" "the" "battlefield" "tapped"

/* @sem Instruction::If{condition:Not(Compare{left:CountObjects(Union([Transition{result:@last_result, phase:Before}])), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}), then:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(6)), excluding:Union([Transition{result:@back(4), phase:Before}, Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}]}, otherwise:_{instructions:[Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(7)), excluding:Union([Transition{result:@back(5), phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}]}} */
observed_entry_fallback_branch ::= "if" "you" "don't" "," "put" "a" "card" "from" "among" "them" "into" "your" "hand" "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* Keep the revealed singleton, its battlefield move and the remaining library cards in one scoped partition. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:$player_ref, filter:$reveal_single_card, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$reveal_single_card}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
player_reveal_single_partition ::= player_ref "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" reveal_single_card "card" "." "put" "that" "card" "onto" "the" "battlefield" "under" "your" "control" "." "that" "player" "puts" "the" "rest" "of" "the" "revealed" "cards" "into" "their" "graveyard"

/* @sem $card_filter */
reveal_single_card ::= ("a" | "an") card_filter

/* Both sentences are complete searches; the latter replaces the former when the condition holds. */
/* @sem Instruction::[If{condition:$condition, then:Program{instructions:$clause_search_general_2}, otherwise:Program{instructions:$clause_search_general}}] */
conditional_search_instead ::= clause_search_general "." NEWLINE "if" condition "," "instead" clause_search_general

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$conditional_search_instead}} */
spell_conditional_search_instead ::= conditional_search_instead "."

/* @sem SearchChoice::SearchChoice{filter:Any, count:AsManyAsCan(Constant(1))} */
search_choice_any_card ::= "any" "card"

/* The two alternative exiles and their joined receipt remain in one scope. */
/* @sem Instruction::[If{condition:$conditional_exile_condition, then:Program{instructions:[Effect{result:@next, operation:$exile_top_cards_of_your_library_2}]}, otherwise:Program{instructions:[Effect{result:@next, operation:$exile_top_cards_of_your_library}]}}, Effect{result:@next, operation:JoinResults{results:[0, 1]}}, Effect{result:@next, operation:JoinResults{results:[0, 1]}}] */
conditional_top_exile_receipt ::= exile_top_cards_of_your_library "." "if" conditional_exile_condition "," exile_top_cards_of_your_library "instead"

/* @sem Condition::Outcome(FreerunningPaid) */
conditional_exile_condition ::= "this" "spell's" "freerunning" "cost" "was" "paid"

/* The permission names only the receipt from this conditional exile. */
/* @sem Instruction::[...$conditional_top_exile_receipt, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@back(3), phase:After}, origins:CardPlayOrigins([Exile]), action:$exiled_play_action, filter:Any})], duration:$duration, evaluation:LiveObjects}}] */
conditional_top_exile_play ::= conditional_top_exile_receipt "." "you" "may" exiled_play_action "the" "exiled" "cards" duration

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$conditional_top_exile_play}} */
conditional_top_exile_play_spell ::= conditional_top_exile_play "."

/* The singular remainder is scoped to a search for at most two cards. */
/* @sem SearchChoice::SearchChoice{filter:AnyOf([$filter_phrase, $filter_phrase_2]), count:UpTo(Constant(2))} */
search_two_union ::= "up" "to" "two" filter_phrase "cards" "and" "/" "or" filter_phrase "cards"

/* Reuse the search and its original selected identities for both destinations. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_two}, Effect{result:@next, operation:$found_those_reveal}, ...$search_pair_battlefield_hand, ...$search_shuffle] */
clause_search_pair_reveal_split ::= search_two "," found_those_reveal "," search_pair_battlefield_hand search_shuffle

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Selected(@marked), count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
search_pair_battlefield_hand ::= "put" "one" "onto" "the" "battlefield" "tapped" "and" "the" "other" "into" "your" "hand"

/* Scope both branches over their own search and selection results. */
/* @sem Instruction::[If{condition:$condition_alternative_mana_paid, then:Program{instructions:[Effect{result:@next, operation:$search}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Selected(@back(3)), count:AsManyAsCan($count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(OneOf(OpponentsOf(AbilityController))), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Selected(@back(5)), count:Exactly($count_2), constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:Battlefield{controller:Player(AbilityController), arrival:$search_option_entry_2}, qualifiers:[]}}}, Effect{result:@next, operation:Move{objects:Selected(@back(6)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:$search}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Selected(@back(3)), count:Exactly($count_2), constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:Battlefield{controller:Player(AbilityController), arrival:$search_option_entry_2}, qualifiers:[]}}}, Effect{result:@next, operation:Move{objects:Selected(@back(4)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}}] */
clause_search_conditional_opponent_partition ::= search "and" "reveal" "them" "." "put" count "of" "them" search_option_entry "under" "an" "opponent's" "control" "if" condition_alternative_mana_paid "." "put" count "of" "them" search_option_entry "under" "your" "control" "and" "the" "rest" "into" "your" "hand" "." "then" "shuffle"

/* The choice, reveal, conditional entry and remainder share one look receipt. */
/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:$filter_phrase}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, If{condition:Compare{left:CountObjects(Matching{objects:Selected(@prior), filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$value}}}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:_{instructions:[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:Move{objects:Selected(1), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:$object_ref, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:$static_changes, duration:$duration, evaluation:Snapshot}}]}}, Effect{result:@next, operation:Move{objects:Selected(1), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:_{instructions:[Effect{result:@next, operation:Move{objects:Selected(1), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(0), excluding:Union([Selected(1)])}, zone:Library}, end:Bottom, order:Random}}] */
dig_reveal_bounded_entry_rest ::= "you" "may" "reveal" "a" filter_phrase "card" "from" "among" "them" "." "if" "that" "card" "has" "mana" "value" value "or" "less" "," "you" "may" "put" object_ref "onto" "the" "battlefield" "and" "it" static_changes duration "." "if" "you" "didn't" "put" "the" "revealed" "card" "onto" "the" "battlefield" "this" "way" "," "put" "it" "into" "your" "hand" "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$look_top_spelled_count}, ...$dig_reveal_bounded_entry_rest]}} */
spell_look_reveal_bounded_entry ::= look_top_spelled_count "." dig_reveal_bounded_entry_rest "."

/* The graveyard move and its counted token reward share one producer contract. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$search_filter_many}, count:AnyNumber, constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:CountObjects(Transition{result:@prior, phase:Before}), words:Rules, recipe:$token_named_recipe}], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}}}] */
dig_reveal_graveyard_named_tokens ::= reveal_top "." "put" "any" "number" "of" search_filter_many "from" "among" "them" "into" "your" "hand" "and" "the" "rest" "into" "your" "graveyard" "." "create" "a" token_named_recipe "token" "for" "each" "card" "put" "into" "your" "graveyard" "this" "way"

/* The conditional keeps both uses of the actual selected and moved cards. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$dig_reveal_one, $dig_selected_gain_rest] */
dig_look_reveal_conditional_gain ::= look_top "." dig_reveal_one "." dig_selected_gain_rest

/* @sem Instruction::If{condition:Compare{left:CountObjects(Matching{objects:Selected(@back(3)), filter:$dig_selected_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:$you_gain_life}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(3), phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(4), phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}]}} */
dig_selected_gain_rest ::= "if" "it's" dig_selected_quality "," you_gain_life "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

dig_selected_quality ::= adjective_legendary | adjective_nonlegendary | adjective_basic | adjective_nonbasic

/* The omitted library in an instead clause inherits the preceding producer. */
/* @sem Operation::Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$card_count, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_top_instead ::= "exile" "the" "top" card_count

/* The single sought card moves from the seek's hand arrival to the battlefield. */
/* @sem Instruction::[...$clause_seek_card, Effect{result:@next, operation:Move{objects:One(Result{result:@prior, phase:After, index:0}), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
clause_seek_single_battlefield ::= clause_seek_card "and" "put" "it" "onto" "the" "battlefield"

/* Keep the battlefield producer with its singular arrival condition. */
/* @sem Instruction::[...$clause_seek_single_battlefield, If{condition:ObjectMatches{object:Result{result:@last_result, phase:After, index:0}, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:$number}}}, then:Program{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:$affected, changes:[$seek_extra_cast_cost]}}, Effect{result:@next, operation:$operation}]}, otherwise:Program{}}] */
seek_arrival_cost_followup ::= clause_seek_single_battlefield "." "if" "a" "card" "with" "mana" "value" "less" "than" number "is" "put" "onto" "the" "battlefield" "this" "way" "," affected "perpetually" "gains" '"' seek_extra_cast_cost "," '"' "then" operation

/* @sem Change::GrantAbility(Casting(AdditionalCost{cost:$cost, repetition:Once})) */
seek_extra_cast_cost ::= "this" "spell" "costs" cost "more" "to" "cast"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$seek_arrival_cost_followup}} */
seek_arrival_cost_spell ::= seek_arrival_cost_followup "."

/* Independent heads retain their individual qualifiers in a search choice. */
/* @sem $head_list_unshared_right */
search_filter_head_union ::= head_list_unshared_right "card"

/* The payment supplies the sacrificed object throughout this reveal episode. */
/* @sem ObjectFilter::AllOf([$card_filter, Shares{property:CreatureTypes, with:Query{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Inputs, phase:Before}, index:0}}]) */
sacrificed_source_shared_type ::= ("a" | "an") card_filter "card" "that" "shares" "a" "creature" "type" "with" "the" "sacrificed" "creature"

/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:$sacrificed_source_shared_type, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@prior), filter:$sacrificed_source_shared_type}, destination:$until_destination, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(3)), excluding:Union([Transition{result:@back(2), phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
reveal_until_sacrificed_source ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" sacrificed_source_shared_type "." "put" "that" "card" until_destination "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Sacrifice{objects:Damage(Source), choose:Exactly(Constant(1))}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$reveal_until_sacrificed_source}, otherwise:Program{}}] */
sacrifice_source_then_reveal ::= "you" "may" "sacrifice" "one" "of" "them" "." "if" "you" "do" "," reveal_until_sacrificed_source

/* The delayed test and exile refer to the hand arrival of this seek. */
/* @sem Instruction::[...$clause_seek_card, ...$seek_delayed_hand_exile] */
clause_seek_delayed_hand_exile ::= clause_seek_card "." seek_delayed_hand_exile

/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, intervening_if:ObjectMatches{object:@it, filter:InZone(Players{zone:Hand, players:One(AbilityController)})}, body:Program{instructions:[Effect{result:@next, operation:Move{objects:One(@it), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}}] */
seek_delayed_hand_exile ::= "at" "the" "beginning" "of" "the" "next" "end" "step" "," "if" "that" "card" "is" "in" "your" "hand" "," "exile" "it"

/* A random library choice and its move form one seek receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:SharesColorWithAny($affected)}, count:AsManyAsCan($value), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_seek_shared_color ::= "seek" "X" "cards" "that" "each" "share" "a" "color" "with" "one" "or" "more" affected "," "where" "X" "is" value

/* The continuation consumes the seek's actual hand arrival. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$clause_seek_shared_color, RepeatableWithLimit{amount:$count_each_color_among, body:Program{instructions:[Effect{result:@next, operation:CreatePerpetualEffect{objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:InSet(Transition{result:@prior, phase:After})}, changes:[GrantAbility(Casting(ReduceCost([_{amount:$braced_amount}])))]}}]}}]}} */
spell_seek_shared_color_reduction ::= clause_seek_shared_color "." "for" "each" count_each_color_among "," "those" "cards" "perpetually" "gain" '"' "this" "spell" "costs" braced_amount "less" "to" "cast" "." '"'

/* The permission refers to the arrivals produced by this exact per-player exile. */
/* @sem Program::Program{instructions:[ForEachPlayer{players:$players_singular, binding:0, body:_{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}), count:$card_count, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@prior, phase:After}, origins:CardPlayOrigins([Exile]), action:Either, filter:Any}, terms:_{cost:Free}})], duration:$duration, evaluation:LiveObjects}}]} */
player_library_exile_free_play_program ::= players_singular "exiles" "the" "top" card_count "of" "their" "library" "." duration "," "you" "may" "play" "those" "cards" "without" "paying" "their" "mana" "costs"

/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[Loyalty($loyalty_heading)]}, limits:ActivationLimits{sorcery:true}, announcement:@announcement, body:$player_library_exile_free_play_program} */
loyalty_player_library_exile_free_play ::= loyalty_heading ":" player_library_exile_free_play_program "."

/* One selection can satisfy either the described filter or the named card. */
/* @sem SearchChoice::SearchChoice{filter:@or($filter_phrase, ObjectFilter::Name($referenced_card_name)), count:UpTo(Constant(1))} */
search_choice_filtered_or_named ::= "a" filter_phrase "card" "or" "a" "card" "named" referenced_card_name

/* Both the selected card and remainder come from the marked library observation. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:AllOf([$a_card, Shares{property:CreatureTypes, with:$object_ref}])}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
look_shared_entry_remainder ::= "you" "may" "put" a_card "that" "shares" "a" "creature" "type" "with" object_ref "from" "among" "them" "onto" "the" "battlefield" "," "then" "you" "put" "the" "rest" "of" "those" "cards" "on" "the" "bottom" "of" "your" "library" library_order

/* A conditional replacement changes the search limit while retaining the complete split-destination episode. Both written filters and the replaced limit must agree. */
/* @sem Vec<Instruction>::@unlabelled_instructions($conditional_search_split_paragraph) */
conditional_search_split ::= conditional_search_split_paragraph

/* @sem Ability::@optional_ability_label(Spell{announcement:@announcement, body:Program{instructions:[If{condition:$split_search_condition, then:Program{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:@agree($card_filter, $card_filter_2), count:UpTo($number_2)}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Selected(@back(3)), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Selected(@back(5)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:@agree($card_filter, $card_filter_2), count:UpTo(@agree($number, $split_search_replaced_count))}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Selected(@back(3)), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Selected(@back(5)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}}]}}, $spell_paragraph_break) */
conditional_search_split_paragraph ::= "search" "your" "library" "for" "up" "to" number card_filter "cards" "," "reveal" "those" "cards" "," "and" "put" "one" search_option_entry "and" "the" "rest" "into" "your" "hand" "." "then" "shuffle" "." spell_paragraph_break "if" split_search_condition "," "search" "your" "library" "for" "up" "to" number card_filter "cards" "instead" "of" split_search_replaced_count "."

/* Keep the spell's written replacement count and graveyard union as local defaults. */
split_search_replaced_count ::= exiled_threshold_words | number_digits

split_search_condition ::= split_search_graveyard_union | condition

/* @prefer always */
/* @sem Condition::Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$filter_instant_and_or_sorcery}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$count}} */
split_search_graveyard_union ::= "there" "are" count "or" "more" filter_instant_and_or_sorcery "cards" "in" "your" "graveyard"

/* @sem $conditional_search_split_paragraph */
conditional_search_split_spell ::= conditional_search_split_paragraph

/* A pair search keeps its original selection across a die table. The singular
   "other" is licensed only by the at-most-two search and one-card choice. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:$search_filter_many, count:UpTo(Constant(2))}]} */
search_up_to_pair ::= "search" "your" "library" "for" "up" "to" "two" search_filter_many

/* Each row consumes the original search selection and the same die result.
   The selected library identities remain valid for the subsequent hand move. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:$search_up_to_pair}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:$search_table_single_die}, If{condition:Compare{left:DieResult(@last_result), test:NumberTest::Compare{comparison:LessOrEqual, value:$number}}, then:_{instructions:[Effect{result:@next, operation:Move{objects:Selected(@back(4)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:_{}}, If{condition:AllOf([Compare{left:DieResult(@back(3)), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number_2}}, Compare{left:DieResult(@back(3)), test:NumberTest::Compare{comparison:LessOrEqual, value:$number_3}}]), then:_{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Selected(@back(6)), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Selected(@back(8)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:_{}}, If{condition:Compare{left:DieResult(@back(7)), test:NumberTest::Compare{comparison:GreaterOrEqual, value:$number_4}}, then:_{instructions:[Effect{result:@next, operation:Move{objects:Selected(@back(10)), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:_{}}]} */
search_pair_reveal_die_table ::= search_up_to_pair "and" "reveal" "them" "," "then" search_table_single_die "." NEWLINE number "or" "less" "|" "put" "those" "cards" "into" "your" "hand" "," "then" "shuffle" "." NEWLINE number "―" number "|" "put" "one" "of" "those" "cards" "onto" "the" "battlefield" "tapped" "and" "the" "other" "into" "your" "hand" "," "then" "shuffle" "." NEWLINE number "⁺" "|" "put" "those" "cards" "onto" "the" "battlefield" "tapped" "," "then" "shuffle" "."

/* A table reads one die result, never a multi-die roll. */
search_table_single_die ::= plain_roll_d20 | roll_d4 | roll_d6 | roll_d6_notation | roll_d8 | roll_d10 | roll_d12

/* The chosen cards share a land type, regardless of their later destination. */
/* @sem SearchChoice::SearchChoice{filter:$filter_phrase, count:UpTo($value), constraints:[CommonProperty(LandTypes)]} */
search_choice_shared_land_type ::= "up" "to" value filter_phrase "cards" "that" "share" "a" "land" "type"

/* The look and its continuation share the observed and exiled receipts. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$look_exile_cast_split] */
instructions_look_exile_remainder_cast ::= look_top "." look_exile_cast_split

/* The observation is simultaneous. Each player's loss uses only their own
   observed card; the subsequent moves are a separate phase. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:LibraryTops($players_singular)}}, ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(Bound(0)), amount:Aggregate{objects:Matching{objects:Recorded(@marked), filter:OwnedBy(One(Bound(0)))}, property:$receipt_stat, aggregation:Sum}}}]}}, ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:$each_revealed_top_destination, qualifiers:[]}}]}}] */
instructions_each_reveal_value_move ::= players_singular "reveals" "the" "top" "card" "of" "their" "library" "," "loses" "life" "equal" "to" "that" "card's" receipt_stat "," "then" "puts" "it" each_revealed_top_destination

each_revealed_top_destination ::= named_reveal_hand | named_reveal_graveyard

/* A single library slice is both inspected and offered for casting. */
/* look_cast_single_top is shared as own_library_top_card. */

/* @sem Program::Program{instructions:[Effect{result:@next, operation:PlayersDo{players:One(AbilityController), any_one:false, optional:true, once_each_turn:true, body:[Program{instructions:[Effect{result:@next, operation:LookAt{player:AbilityController, objects:$own_library_top_card}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:$own_library_top_card, count:Exactly(Constant(1)), terms:_{cost:Free}}}]}}]}], otherwise:[]}}]} */
program_look_top_cast_once ::= "look" "at" own_library_top_card "." "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" "." "do" "this" "only" "once" "each" "turn" "."

/* Permanent cards use the common permanent-type union. */
/* @sem $bound_permanent_card_filter */
search_many_permanent ::= bound_permanent_card_filter "cards"

/* Search and move the single found card, retaining the search receipt. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:$search_single_library}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
search_single_that_card_graveyard ::= search_single_library "," "put" "that" "card" "into" "your" "graveyard" "," "then" "shuffle"

/* The single hidden library arrival is marked for both later references.
   Its library owner and end remain independently printable operands. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_possessive)}, kind:Card, filter:Any}, count:Constant(1), from:$ordered_end}, destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
hidden_library_card_producer ::= "exile" "the" ordered_end "card" "of" player_possessive "library" "face" "down"

/* Both access rules and their duration name that same marked arrival. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(Visibility{objects:One(Result{result:@marked, phase:After, index:0}), audience:AffectedPlayer}), PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:$exiled_play_action, filter:Any}, terms:_{cost:Normal, spend_as:$hidden_exile_spending}})], duration:WhileExiled(Result{result:@marked, phase:After, index:0}), evaluation:LiveObjects}}] */
hidden_exile_access ::= "you" "may" "look" "at" "and" exiled_play_action "that" "card" "for" "as" "long" "as" "it" "remains" "exiled" "," "and" hidden_exile_spending

hidden_exile_spending ::= hidden_exile_any_type | hidden_exile_any_type_it | exiled_spending_any_color | exiled_spending_colorless

/* @prefer always */
/* @sem SpendAs::AnyType */
hidden_exile_any_type ::= "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "that" "spell"

/* @sem SpendAs::AnyType */
hidden_exile_any_type_it ::= "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "it"

/* The producer and both consumers share one physical receipt in each direction. */
/* @sem Program::Program{instructions:[...$hidden_library_card_producer, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:ObjectProperty{object:Result{result:@marked, phase:After, index:0}, property:ManaValue, information:CurrentOrLastKnown}}}, ...$hidden_exile_access]} */
hidden_exile_value_access_program ::= hidden_library_card_producer "." "you" "lose" "life" "equal" "to" "its" "mana" "value" "." hidden_exile_access "."

/* The chosen opponent observes the library slice and divides that observation. */
/* @sem Operation::LookAt{player:OneOf(OpponentsOf(AbilityController)), objects:$your_top} */
chosen_opponent_look_top ::= "choose" "an" "opponent" "." "they" "look" "at" your_top

/* @sem Instruction::[Effect{result:@next, operation:Piles{actor:One(OneOf(OpponentsOf(AbilityController))), objects:InZone{objects:Observed(@marked), zone:Library}, count:Constant(2), names:['face up', 'face down']}}] */
chosen_opponent_face_piles ::= "separate" "them" "into" "a" "face-down" "pile" "and" "a" "face-up" "pile"

/* The controller chooses the pile for its owners' hands; the other remains in the library until moved. */
/* @sem Instruction::[Effect{result:@next, operation:ChoosePile{actor:One(AbilityController), then:OwnersHand}}, Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
controller_face_piles_hand_graveyard ::= "put" "one" "pile" "into" "your" "hand" "and" "the" "other" "into" "your" "graveyard"

/* @sem Instruction::[Effect{result:@mark, operation:$chosen_opponent_look_top}, ...$chosen_opponent_face_piles, ...$controller_face_piles_hand_graveyard] */
clause_chosen_opponent_face_piles ::= chosen_opponent_look_top "and" chosen_opponent_face_piles "." controller_face_piles_hand_graveyard

/* The exile producer and its consumer share the marked result. */
/* @sem Instruction::[Effect{result:@mark, operation:$exile_top_cards_of_your_library}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(SpecialAction{body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_phrase}, count:Exactly($counter_a), terms:_{cost:Normal, effects:[$cast_affinity_effect]}}}]}, limit:Total(1)})], duration:$this_duration, evaluation:LiveObjects}}] */
instructions_exile_top_cast_affinity ::= exile_top_cards_of_your_library "." "you" "may" "cast" counter_a filter_phrase "spell" "from" "among" "them" this_duration "." "if" "you" "do" "," "it" "has" cast_affinity_effect

/* @sem Operand::Term{family:SpellEffect, form:Affinity, operands:[Objects($affected)]} */
cast_affinity_effect ::= "affinity" "for" affected

/* The event group is meaningful here only under the surrounding discard trigger. */
/* @sem ObjectFilter::SharesWithAny{property:CardTypes, with:EventGroup} */
discard_event_shared_card_type_singular ::= "that" "shares" "a" "card" "type" "with" "one" "of" "the" "discarded" "cards"

/* @sem ObjectFilter::SharesWithAny{property:CardTypes, with:EventGroup} */
discard_event_shared_card_type_plural ::= "that" "share" "a" "card" "type" "with" "one" "of" "the" "discarded" "cards"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$discard_event_shared_card_type_singular}, count:AsManyAsCan($card_count_one), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
discard_event_seek_one ::= "seek" card_count_one discard_event_shared_card_type_singular

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$discard_event_shared_card_type_plural}, count:AsManyAsCan($card_count_many), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
discard_event_seek_many ::= "seek" card_count_many discard_event_shared_card_type_plural

discard_event_seek ::= discard_event_seek_one | discard_event_seek_many

/* @sem Ability::Triggered{event:$event_discard_many, limits:TriggerLimits{per_turn:1}, announcement:@announcement, body:Program{instructions:$discard_event_seek}} */
discard_event_seek_once ::= "whenever" event_discard_many "," discard_event_seek "." "this" "ability" "triggers" "only" "once" "each" "turn" "."

/* @sem Expr::CountDistinct{objects:$affected, property:CardTypes} */
card_types_among_affected ::= "the" "number" "of" "card" "types" "among" affected

/* @sem Operation::Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$card_types_among_affected, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_top_cards_defined ::= "exile" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" card_types_among_affected

/* A bounded plural search composes with its selected-card follow-ups. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_many]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]} */
named_discard_search_follow ::= "search" "your" "library" "for" search_choice_many "," "put" "them" search_option_entry "," "then" "shuffle"

/* Named discard is scoped to this search program, avoiding unrelated X readings. */
/* @sem Ability::Activated{origin:Ordinary, cost:Cost{parts:[$cost_discard_another_named]}, limits:ActivationLimits{}, announcement:@announcement, body:$named_discard_search_follow} */
named_discard_search_activation ::= cost_discard_another_named ":" named_discard_search_follow "."

/* Look at the referenced object's controller or owner's private zone. */
/* @sem Operation::LookAt{player:AbilityController, objects:$referenced_private_cards} */
look_referenced_private_cards ::= "look" "at" referenced_private_cards

/* A later conditional option shares the original searched selection. */
/* @sem Instruction::[If{condition:$condition_died, then:Program{instructions:[Effect{result:@next, operation:$search_optional_that_card_entry}]}, otherwise:Program{}}] */
search_later_death_option ::= search_optional_that_card_entry "instead" "of" "putting" "it" "into" "your" "hand" "if" condition_died

/* @sem Instruction::[Effect{result:@mark, operation:$search_single_library}, Effect{result:@next, operation:$search_selected_reveal}, ...$search_later_death_option, Effect{result:@next, operation:$found_it_hand}, ...$search_shuffle] */
clause_search_later_death_option ::= search_single_library "," search_selected_reveal "," found_it_hand search_shuffle "." NEWLINE search_later_death_option

/* The choice and search remain together to bind the name to the chosen land. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Land), ControlledBy(One(AbilityController))])}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:AllOf([Supertype(Basic), $filter_phrase, SharesNameWith(Result{result:@prior, phase:After, index:0})]), count:UpTo($value)}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]} */
program_choose_land_name_search ::= "choose" "a" "land" "you" "control" "." "then" "search" "your" "library" "for" "up" "to" value "basic" filter_phrase "cards" "which" "have" "the" "same" "name" "as" "the" "chosen" "land" "," "put" "them" "onto" "the" "battlefield" "tapped" "," "then" "shuffle"

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}] */
opponent_damage_exile_instructions ::= "exile" "the" "top" "card" "of" "your" "library" "." "you" "may" "play" "it" this_duration

/* The searched zones, name comparison, and shuffle all refer to the same
   previously announced spell. The selected cards are the search receipt. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:ControllerOf(Target{slot:@last_slot, index:0}), choices:[_{filter:SharesNameWith(Target{slot:@last_slot, index:0}), count:$named_search_count}], also:[Graveyard, Hand]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf(Target{slot:@last_slot, index:0}))}}] */
search_countered_spell_name_exile ::= "search" "the" "graveyard" "," "hand" "," "and" "library" "of" "that" "spell's" "controller" "for" named_search_count "cards" "with" "the" "same" "name" "as" "that" "spell" "," "exile" "those" "cards" "," "then" "that" "player" "shuffles"

/* Keep the spell target in scope for the search continuation. */
/* @sem Ability::@optional_ability_label(Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Counter{objects:One($target_stack_spell), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), destination_when:None}}, If{condition:$condition_card_types_graveyard, then:Program{instructions:$search_countered_spell_name_exile}, otherwise:Program{}}]}}, $spell_paragraph_break) */
spell_counter_graveyard_types_search ::= "counter" target_stack_spell "." spell_paragraph_break "if" condition_card_types_graveyard "," search_countered_spell_name_exile "."

/* @sem Operation::PutCounters{placements:[_{recipients:Objects(One(@exiled_card_reference)), kind:$counter_kind, amount:$counter_amount}]} */
put_exile_until_it_counters ::= "put" counter_amount counter_kind "counters" "on" "it"

/* @sem Instruction::[...$clause_exile_until_card, Effect{result:@next, operation:$put_exile_until_it_counters}, ...$clause_exiled_card_suspend_grant] */
exile_until_it_counter_suspend ::= clause_exile_until_card "." put_exile_until_it_counters "." clause_exiled_card_suspend_grant

/* A singleton from the damage recipient's library supplies the cast receipt. */
/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(EventSubject)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_event_player_single_top ::= "exile" "the" "top" "card" "of" "that" "player's" "library"

/* Search an owned-card choice across library, graveyard and outside the game.
   The shared continuation retains the search receipt for every follow-up. */
/* @sem SearchChoice::SearchChoice{filter:AllOf([$owned_search_filter, OwnedBy(One(AbilityController))]), count:UpTo($counter_amount)} */
owned_three_zone_choice ::= counter_amount owned_search_filter "card" "you" "own"

owned_search_filter ::= owned_search_canonical | owned_search_union | filter_phrase

/* @prefer always */
/* @sem $filter_instant_or_sorcery */
owned_search_canonical ::= filter_instant_or_sorcery

owned_search_atom ::= noun_atomic | spell_instant | spell_sorcery

/* @sem ObjectFilter::AnyOf([$owned_search_atom, $owned_search_atom_2]) */
owned_search_union ::= owned_search_atom "or" owned_search_atom

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$owned_three_zone_choice], also:[Graveyard], either:true, outside:true} */
search_owned_three_zones ::= "search" "your" "library" "," "graveyard" "," "and" "/" "or" "outside" "the" "game" "for" owned_three_zone_choice

/* @sem Instruction::[Effect{result:@mark, operation:$search_owned_three_zones}, ...$search_either_follow, If{condition:Searched(@marked), then:Program{instructions:[Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:Program{}}] */
clause_search_owned_three_zones ::= search_owned_three_zones search_either_follow "." "if" "you" "search" "your" "library" "this" "way" "," "shuffle"

/* A distinct-name selection and the shared reveal/hand continuation retain the
   search receipt through both actions. */
/* @sem SearchChoice::SearchChoice{filter:$card_filter, count:UpTo($count), constraints:[DifferentNames]} */
search_choice_with_different_names ::= "up" "to" count card_filter "cards" "with" "different" "names"

/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_distinct_name_choice]}}, ...$search_selected_reveal_hand] */
search_distinct_reveal_hand ::= "search" "your" "library" "for" search_distinct_name_choice search_selected_reveal_hand

/* @sem Instruction::[Effect{result:@next, operation:$found_plural_reveal}, Effect{result:@next, operation:$found_plural_hand}, ...$search_shuffle] */
search_selected_reveal_hand ::= "," found_plural_reveal "," found_plural_hand search_shuffle

/* The name and controller come from the announced target's original object.
   Use its last-known information if it left the battlefield. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:@agree($exile_name_target, $exile_name_target_2)}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:$exile_name_controller_zones, choices:[_{filter:SharesNameWith(Target{slot:@last_slot, index:0}), count:$name_search_count}], also:[Graveyard, Hand]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($exile_name_controller_zones)}}] */
exile_target_controller_name_search ::= "exile" "target" exile_name_target "." exile_name_controller_zones name_search_count "cards" "with" "the" "same" "name" "as" "that" exile_name_target exile_name_search_finish

exile_name_target ::= noun_artifact | noun_creature | noun_land

/* @sem PlayerRef::ControllerOf(Target{slot:@last_slot, index:0}) */
exile_name_controller_zones ::= "search" "its" "controller's" "graveyard" "," "hand" "," "and" "library" "for"

/* @sem () */
exile_name_search_finish ::= "and" "exile" "them" "." "then" "that" "player" "shuffles"

/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:$exile_target_controller_name_search}} */
spell_exile_target_controller_name_search ::= exile_target_controller_name_search "."

hand_choice_target_h2 ::= target_player | target_opponent

/* A player chooses cards from that same player's hand; the enclosing move
   determines their destination. */
/* @sem Operation::ChooseObjects{player:$hand_choice_target_h2, objects:Zone{scope:Players{zone:Hand, players:One($hand_choice_target_h2)}, kind:Card, filter:Any}, count:AsManyAsCan($card_count)} */
player_chooses_hand_cards ::= hand_choice_target_h2 "puts" card_count "from" "their" "hand"

/* @sem Instruction::[Effect{result:@next, operation:$player_chooses_hand_cards}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_player_hand_cards_top ::= player_chooses_hand_cards "on" "top" "of" "their" "library"

/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@marked, phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any}, terms:_{cost:Normal, spend_as:AnyType}})], duration:WhileExiled(Result{result:@marked, phase:After, index:0}), evaluation:LiveObjects}}] */
look_exile_play_permission_spell ::= "you" "may" "play" "that" "card" "for" "as" "long" "as" "it" "remains" "exiled" "," "and" "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "that" "spell"

/* @sem EventSpec::Damage(_{source_kind:Permanent, sources:AllOf([$plural, ControlledBy(One(AbilityController))]), recipients:Players(All), kind:Combat, grouping:Recipient, subject:Source}) */
event_controlled_group_combat_player_h2 ::= "one" "or" "more" plural "you" "control" "deal" "combat" "damage" "to" "a" "player"

/* The two operations share the same library query and the permission consumes that exile. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:$look_exile_library_top}}, Effect{result:@mark, operation:Move{objects:$look_exile_library_top, destination:$look_top_exile_destination, qualifiers:[]}}, ...$look_exile_play_permission_spell] */
look_exile_top_play_spell ::= "look" "at" look_exile_library_top "," "then" look_top_exile_destination "." look_exile_play_permission_spell

/* @sem Ability::Triggered{event:$event_controlled_group_combat_player_h2, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$look_exile_top_play_spell}} */
controlled_group_look_exile_trigger ::= "whenever" event_controlled_group_combat_player_h2 "," look_exile_top_play_spell "."

/* The cast consumes the same card-producing move, including its actual destination. */
/* @sem Operation::Move{objects:$library_tops, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_library_tops_h2 ::= "exile" library_tops

/* @sem Instruction::[Effect{result:@mark, operation:$exile_library_tops_h2}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$cast_library_tops_receipt}]}}] */
instructions_library_tops_cast ::= exile_library_tops_h2 "." "you" "may" cast_library_tops_receipt

/* A separately named card retains its own name operand. */
/* @sem SearchChoice::SearchChoice{filter:Name($referenced_card_name), count:UpTo(Constant(1))} */
search_choice_other_named_one ::= "a" "card" "named" referenced_card_name

/* A named-card search across all three zones composes with comma-led follow-ups. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_other_named_one], also:[Graveyard, Hand]} */
search_three_zones_other_named ::= "search" "your" "graveyard" "," "hand" "," "and" "library" "for" search_choice_other_named_one

/* @sem Instruction::[Effect{result:@mark, operation:$search_three_zones_other_named}, ...$search_follow] */
clause_search_three_zones_other_named ::= search_three_zones_other_named search_follow

/* @sem Ability::Triggered{event:$event_self_enters, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:$clause_search_three_zones_other_named}} */
triggered_search_three_zones_other_named ::= "when" event_self_enters "," clause_search_three_zones_other_named "."

/* @sem Instruction::[Instruction::Effect{result:@mark, operation:Operation::RevealUntil{library:AbilityController, filter:$reveal_until_card, count:Expr::Constant(1)}}, Instruction::Effect{result:@next, operation:Operation::Move{objects:Matching{objects:Observed(@marked), filter:$reveal_until_card}, destination:$until_reveal_destination, qualifiers:[]}}, Instruction::Effect{result:@next, operation:$rest_bottom}] */
reveal_until_single_partition ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" reveal_until_card "." "put" "that" "card" until_reveal_destination rest_bottom

/* The two filters describe the same revealed population; the remainder excludes the actual movement. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:@agree($filter_phrase, $filter_phrase_2), count:$number}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:@agree($filter_phrase, $filter_phrase_2)}, destination:$until_destination, qualifiers:[]}}, Effect{result:@next, operation:$rest_bottom}] */
reveal_until_plural_partition ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" number filter_phrase "cards" "." "put" "those" filter_phrase "cards" until_destination "and" rest_bottom

/* Haste paired with comma-followed named three-zone search and trailing abilities. */
/* @prefer always */
/* @sem Ability::[Keyword(Haste), $triggered_search_three_zones_other_named, ...$abilities] */
abilities_haste_search_three_zones_comma_h3 ::= "haste" NEWLINE triggered_search_three_zones_other_named NEWLINE abilities

/* Search for up to value cards with different names and put them onto the battlefield, then shuffle. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[SearchChoice{filter:$filter_phrase, count:UpTo($value), constraints:[DifferentNames]}]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
clause_search_distinct_battlefield_h3 ::= "search" "your" "library" "for" "up" "to" value filter_phrase "cards" "with" "different" "names" "," "put" "them" "onto" "the" "battlefield" "," "then" "shuffle"

/* Defined top-X revelation with greatest owned commander mana value. */
/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:$value_greatest_owned_commander_mana, from:Top} */
your_top_defined_commander_h3 ::= "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" value_greatest_owned_commander_mana

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$dig_many_filter}, count:AnyNumber, constraints:[CanMoveTo{destination:$dig_destination}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}] */
dig_put_any_may_h3 ::= "you" "may" "put" "any" "number" "of" dig_many_filter "from" "among" "them" dig_destination

/* @prefer always */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:$your_top_defined_commander_h3}}, ...$dig_put_any_may_h3, $dig_rest_put] */
dig_reveal_defined_any_h3 ::= "reveal" your_top_defined_commander_h3 "." dig_put_any_may_h3 "." dig_rest_put

/* @prefer always */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Group{instructions:$dig_reveal_defined_any_h3}]}} */
spell_defined_reveal_partition_h3 ::= dig_reveal_defined_any_h3 "."

/* Search for a card, put it onto the battlefield, attach that exact arrival to a chosen host, then shuffle. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:$filter_phrase, count:UpTo($counter_amount)}]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Battlefield), kind:Permanent, filter:$filter_phrase_2}, count:AsManyAsCan($counter_amount_2)}}, Effect{result:@next, operation:Attach{attachments:One(Result{result:@marked, phase:After, index:0}), host:Result{result:@prior, phase:After, index:0}}}] */
instructions_search_battlefield_attach_shuffle_h3 ::= "search" "your" "library" "for" counter_amount filter_phrase "card" "," "put" "it" "onto" "the" "battlefield" "," "attach" "it" "to" counter_amount filter_phrase "," "then" "shuffle"

/* Seek a card matching an exact mana value expression. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:$value}}}, count:AsManyAsCan($card_count), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_seek_mana_value_equal_h3 ::= "seek" card_count "with" "mana" "value" "equal" "to" value

/* @sem $instructions_revealed_hand_exile_same_name_paragraph */
instructions_revealed_hand_exile_same_name_spell ::= instructions_revealed_hand_exile_same_name_paragraph "."

/* @sem $dig_conditional_reveal_selection_paragraph */
dig_conditional_reveal_selection_spell ::= dig_conditional_reveal_selection_paragraph "."

/* @sem $dig_conditional_reveal_battlefield_paragraph */
dig_conditional_reveal_battlefield_spell ::= dig_conditional_reveal_battlefield_paragraph "."

/* @sem $dig_conditional_reveal_cast_paragraph */
dig_conditional_reveal_cast_spell ::= dig_conditional_reveal_cast_paragraph "."


/* The current visit is already counted when the visit ability resolves. */
/* @sem $exile_cleanup_visited */
exile_cleanup_visited_including_this ::= exile_cleanup_visited "(" "↓" "including" "this" "one" ")"


/* Color-only spending and any-type spending have different permissions. */
random_library_cast_spending ::= random_library_cast_any_type | random_library_cast_any_color
/* @sem SpendAs::AnyType */
random_library_cast_any_type ::= "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "it"
/* @sem SpendAs::AnyColor */
random_library_cast_any_color ::= "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "that" "spell"

/* The counters belong to the selected card's arrival. */
/* @sem Operation::@search_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{counters:[[$counter_kind, $counter_amount]]}}, qualifiers:[]}) */
found_battlefield_counters ::= "put" found "onto" "the" "battlefield" "with" counter_amount counter_kind "counters" "on" "it"

/* One reading of X sizes the original observed slice. Moved cards are excluded
   from its ordered remainder; the remaining cards stay in the same library. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:$value, from:Top}}}, Effect{result:@next, operation:Move{objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$filter_phrase}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Transition{result:@prior, phase:Before}}, zone:Library}, end:Bottom, order:$library_order}}]} */
program_reveal_counted_put_all_and_rest ::= "reveal" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" value "." "put" "all" filter_phrase "cards" "revealed" "this" "way" "onto" "the" "battlefield" "tapped" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order "."

/* @sem Ability::Spell{announcement:@announcement, body:$program_reveal_counted_put_all_and_rest} */
spell_reveal_counted_put_all_and_rest ::= program_reveal_counted_put_all_and_rest

/* The target of the hand move is chosen from the public mill receipt. */
/* @sem Vec<Instruction>::@then_sequence($mill_return_producer, $mill_optional_selected_hand) */
instructions_mill_optional_selected_hand ::= mill_return_producer "." mill_optional_selected_hand

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@prior, phase:After}, filter:$card_filter}, count:UpTo($count_plural)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{}), qualifiers:[]}}] */
mill_optional_selected_hand ::= "you" "may" "put" "up" "to" count_plural card_filter "cards" "from" "among" "them" "into" "your" "hand"

/* All players reveal first. The counters use the observation, not the
   cards actually drawn, so replaced draws do not change the count. */
/* @sem Instruction::[Effect{result:@mark,operation:Reveal{objects:LibraryTops(All)}},Effect{result:@next,operation:Draw{players:All,amount:Constant(1)}},Effect{result:@next,operation:PutCounters{placements:[_{recipients:Objects(One($self_explicit_ref)),kind:$counter_kind,amount:CountObjects(Matching{objects:Observed(@marked),filter:$card_filter})}]}}] */
instructions_counter_after_drawn_reveals ::= "each" "player" "reveals" "the" "top" "card" "of" "their" "library" "," "then" "draws" "a" "card" "." "for" "each" card_filter "card" "revealed" "this" "way" "," "put" "a" counter_kind "counter" "on" self_explicit_ref

/* The value limit qualifies the second alternative. Reveal only the
   selected card, and keep the original look receipt for reordering. */
/* @sem Instruction::[Effect{result:@mark,operation:$look_top},Effect{result:@next,operation:ChooseObjects{player:AbilityController,objects:Matching{objects:InZone{objects:Observed(@marked),zone:Library},filter:AnyOf([$filter_phrase,AllOf([$nonland_permanent_card_word,$modifier_mana_value_bound])])},count:UpTo(Constant(1))}},Effect{result:@next,operation:Reveal{objects:Selected(@prior)}},Effect{result:@next,operation:Move{objects:Selected(@back(3)),destination:OwnersHand(CardArrival{}),qualifiers:[]}},Effect{result:@next,operation:ReorderLibrary{chooser:AbilityController,library_owner:AbilityController,objects:InZone{objects:Difference{objects:Observed(@marked),excluding:Transition{result:@prior,phase:Before}},zone:Library},end:Bottom,order:$library_order}}] */
dig_look_reveal_filtered_disjunction_hand ::= look_top "." "you" "may" "reveal" "a" filter_phrase "card" "or" nonland_permanent_card_word "card" modifier_mana_value_bound "from" "among" "them" "and" "put" "it" "into" "your" "hand" "." "put" "the" "rest" "on" "the" "bottom" library_order

/* The bound applies to the particular proposed spell, including its face. */
/* @sem Instruction::[Effect{result:@next,operation:$exile_top_cards_of_your_library},Effect{result:@next,operation:PlayWith{actor:One(AbilityController),action:CastSpell,cards:InZone{objects:Transition{result:@prior,phase:After},zone:Exile},count:AnyNumber,terms:_{cost:Free,cast_filter:Property{property:ManaValue,test:NumberTest::Compare{comparison:LessOrEqual,value:$value}}}}}] */
instructions_cast_bounded_from_top_exile ::= exile_top_cards_of_your_library "." "you" "may" "cast" "any" "number" "of" "spells" "with" "mana" "value" "less" "than" "or" "equal" "to" value "from" "among" "those" "cards" "without" "paying" "their" "mana" "costs"

/* The target owns the source library and handles the cards left in exile. */
/* @sem Instruction::[Effect{result:@mark,operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library,players:One($target_opponent)},kind:Card,filter:Any},count:$value,from:Top},destination:Exile{visibility:FaceUp,arrival:ExileArrival{}},qualifiers:[]}},Effect{result:@next,operation:PlayWith{actor:One(AbilityController),action:CastSpell,cards:InZone{objects:Transition{result:@marked,phase:After},zone:Exile},count:UpTo(Constant(1)),terms:_{cost:Free,cast_filter:$instant_or_sorcery_cast_filter}}},Effect{result:@next,operation:Move{objects:InZone{objects:Transition{result:@marked,phase:After},zone:Exile},destination:Library{position:Bottom,order:$library_order,arrival:CardArrival{}},qualifiers:[]}}] */
instructions_exile_opponent_cast_then_bottom ::= target_opponent "exiles" "the" "top" "X" "cards" "of" "their" "library" "," "where" "X" "is" value "." "you" "may" "cast" instant_or_sorcery_cast_filter "from" "among" "them" "without" "paying" "its" "mana" "cost" "." "then" "that" "player" "puts" "the" "rest" "on" "the" "bottom" "of" "their" "library" library_order

/* @sem ObjectFilter::AnyOf([CardType(Instant),CardType(Sorcery)]) */
instant_or_sorcery_cast_filter ::= "an" "instant" "or" "sorcery" "spell"

/* Keep the quest counter, timed permission, and later threshold in
   printed execution order. Earlier nonmatches remain in exile. */
/* @sem Instruction::[Effect{result:@next,operation:$put_counters_direct},Effect{result:@next,operation:RevealUntil{library:AbilityController,filter:$card_filter,count:Constant(1)}},Effect{result:@mark,operation:Move{objects:Observed(@prior),destination:Exile{visibility:FaceUp,arrival:ExileArrival{}},qualifiers:[]}},Effect{result:@next,operation:CreateContinuousEffect{source:Source,affected:Players(One(AbilityController)),changes:[PlayerRule(PlayPermission{cards:Matching{objects:InZone{objects:Transition{result:@marked,phase:After},zone:Exile},filter:$card_filter},origins:CardPlayOrigins([Exile]),action:Either,filter:Any})],duration:EndOfTurn,evaluation:LiveObjects}},If{condition:$condition,then:_{instructions:$clause},otherwise:_{}}] */
instructions_counters_then_exile_stopped_timed_play ::= put_counters_direct "." "then" "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" "a" card_filter "card" "." "you" "may" "play" "that" "card" "this" "turn" "." "if" condition "," clause

/* @sem Instruction::[Effect{result:@next,operation:$sacrifice_variable_population},...$sacrifice_count_search_battlefield] */
instructions_sacrifice_then_search_receipt ::= sacrifice_variable_population "," "then" sacrifice_count_search_battlefield

/* Both choices are legal during resolution; only the reveal choice can draw.
   Its follow-up checks the actual draw even if an effect replaces it. */
/* @sem Instruction::[Effect{result:@next,operation:@apply(PlayerSet::One(AbilityController),$surveil_base)},ChooseOne{decider:AbilityController,options:[_{instructions:[Effect{result:@mark,operation:$reveal_top},If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked),filter:$card_filter}),test:NumberTest::Compare{comparison:GreaterOrEqual,value:Constant(1)}},then:_{instructions:[Effect{result:@mark,operation:@apply(PlayerSet::One(AbilityController),$draw_base)},If{condition:Compare{left:Performed(@marked),test:NumberTest::Compare{comparison:Equal,value:Constant(0)}},then:_{instructions:[Effect{result:@next,operation:$put_counters_direct}]},otherwise:_{}}]},otherwise:_{instructions:[Effect{result:@next,operation:$put_counters_direct}]}}]},_{instructions:[Effect{result:@next,operation:$put_counters_direct}]}]}] */
instructions_surveil_optional_reveal_receipt ::= surveil_base "," "then" "you" "may" reveal_top "." "if" "an" card_filter "card" "is" "revealed" "this" "way" "," draw_base "." "if" "you" "don't" "draw" "a" "card" "this" "way" "," put_counters_direct

/* The sampled opponent is independent of the observed tops and the later draws. */
/* @sem Instruction::[Effect{result:@mark,operation:Reveal{objects:LibraryTops(All)}},Effect{result:@next,operation:Draw{players:All,amount:Constant(1)}},Effect{result:@next,operation:ChooseValue{choosers:One(AbilityController),kind:Player,terms:_{options:[Players(OpponentsOf(AbilityController))],count:Exactly(Constant(1)),random:true}}},Effect{result:@next,operation:DealDamage{source:$self_explicit_ref,recipients:Players(One(Named{result:@prior,index:0})),amount:Aggregate{objects:Observed(@marked),property:ManaValue,aggregation:Maximum},preventable:true}}] */
instructions_draw_revealed_random_opponent_damage ::= "each" "player" "reveals" "the" "top" "card" "of" "their" "library" "," "then" "draws" "a" "card" "." self_explicit_ref "deals" "X" "damage" "to" "a" "random" "opponent" "," "where" "X" "is" "the" "greatest" "mana" "value" "among" "cards" "revealed" "this" "way"

/* The delay follows the actual land incarnations that entered from the
   reveal, and waits for this controller's next end step. */
/* @sem Instruction::[Effect{result:@mark,operation:RevealUntil{library:AbilityController,filter:CardType(Land),count:$count_plural}},Effect{result:@next,operation:Move{objects:Matching{objects:Observed(@marked),filter:CardType(Land)},destination:Battlefield{controller:Player(AbilityController),arrival:BattlefieldArrival{}},qualifiers:[]}},Effect{result:@next,operation:ReorderLibrary{chooser:AbilityController,library_owner:AbilityController,objects:Matching{objects:InZone{objects:Observed(@marked),zone:Library},filter:Not(CardType(Land))},end:Bottom,order:$library_order}},Effect{result:@next,operation:CreateDelayedTrigger{event:$delayed_move_your_end,start:Immediately,body:_{instructions:[Effect{result:@next,operation:Sacrifice{players:One(AbilityController),objects:InZone{objects:Transition{result:@back(3),phase:After},zone:Battlefield}}}]}}}] */
instructions_reveal_lands_delayed_sacrifice ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" count_plural "land" "cards" "." "put" "those" "land" "cards" "onto" "the" "battlefield" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order "." "sacrifice" "those" "lands" "at" delayed_move_your_end

/* Read the announced spell's value to permit the cast. Both continuations
   refer to the exact revealed object and never to a new library top. */
/* @sem Instruction::[Effect{result:@mark,operation:$reveal_top},Effect{result:@next,operation:PlayWith{actor:One(AbilityController),action:CastSpell,cards:InZone{objects:Observed(@marked),zone:Library},count:UpTo(Constant(1)),terms:_{cost:Free,cast_filter:Property{property:ManaValue,test:NumberTest::Compare{comparison:LessOrEqual,value:$value}}}}},Effect{result:@next,operation:ChooseObjects{player:AbilityController,objects:Matching{objects:InZone{objects:Observed(@marked),zone:Library},filter:CardType(Land)},count:UpTo(Constant(1)),constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController),arrival:BattlefieldArrival{tapped:true}}}]}},Effect{result:@next,operation:Move{objects:Selected(@prior),destination:Battlefield{controller:Player(AbilityController),arrival:BattlefieldArrival{tapped:true}},qualifiers:[]}},If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked),filter:InSet(Take{objects:Zone{scope:Players{zone:Library,players:One(AbilityController)},kind:Card,filter:Any},count:Constant(1),from:Top})}),test:NumberTest::Compare{comparison:GreaterOrEqual,value:Constant(1)}},then:_{instructions:[Effect{result:@next,operation:@apply(PlayerSet::One(AbilityController),$draw_base)}]},otherwise:_{}}] */
instructions_revealed_top_cast_move_or_draw ::= reveal_top "." "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" "if" "that" "spell's" "mana" "value" "is" "equal" "to" "or" "less" "than" value "." "if" "it's" "a" "land" "card" "," "you" "may" "put" "it" "onto" "the" "battlefield" "tapped" "." "if" "that" "card" "is" "still" "on" "top" "of" "your" "library" "," draw_base

/* The grant goes on the nonland exile arrival. Its own activation pays
   from the holder controller's hand and can function only while exiled. */
/* @sem Program::Program{instructions:[Effect{result:@next,operation:Shuffle{players:One(AbilityController)}},Effect{result:@next,operation:RevealUntil{library:AbilityController,filter:Not(CardType(Land)),count:Constant(1)}},Effect{result:@next,operation:Move{objects:Observed(@prior),destination:Exile{visibility:FaceUp,arrival:ExileArrival{}},qualifiers:[]}},Effect{result:@next,operation:CreateContinuousEffect{source:Source,affected:Objects(Matching{objects:InZone{objects:Transition{result:@prior,phase:After},zone:Exile},filter:Not(CardType(Land))}),changes:[GrantAbility(@holder($quoted_exile_copy_activation))],duration:Indefinite,evaluation:Snapshot}}]} */
program_shuffle_exile_until_grant_copy ::= "shuffle" "your" "library" "," "then" "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" "a" "nonland" "card" "." "that" "nonland" "card" "gains" '"' quoted_exile_copy_activation '"'

/* @sem Ability::Scoped{zones:[Exile],ability:@scope(Ability::Activated{origin:Ordinary,cost:Cost{parts:[$cost_exile_hand_card_plain]},limits:ActivationLimits{condition:PlayerIsActive(AbilityController)},announcement:@announcement,body:_{instructions:[Effect{result:@next,operation:CopyCards{actor:One(AbilityController),objects:One(Source),times:Constant(1)}},Effect{result:@next,operation:PlayCards{actor:One(AbilityController),action:CastSpell,cards:Copies(@prior),count:UpTo(Constant(1)),cost:Normal}}]}})} */
quoted_exile_copy_activation ::= cost_exile_hand_card_plain ":" "create" "a" "copy" "of" "this" "card" "." "you" "may" "cast" "the" "copy" "." "activate" "only" "during" "your" "turn" "and" "only" "if" "this" "card" "is" "exiled" "."

/* @sem CostPart::Move{selections:[_{objects:Zone{scope:Players{zone:Hand,players:One(AbilityController)},kind:Card,filter:Any},choose:Exactly(Constant(1))}],destination:Exile{visibility:FaceUp,arrival:ExileArrival{}}} */
cost_exile_hand_card_plain ::= "exile" "a" "card" "from" "your" "hand"

/* Take one snapshot of X. Each choice reads only that opponent's original
   exile receipt, and the resulting permissions follow those selected cards. */
/* @sem Instruction::[Effect{result:@mark,operation:BindValue{value:$value}},ForEachPlayer{players:OpponentsOf(AbilityController),binding:0,body:_{instructions:[Effect{result:@mark,operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library,players:One(Bound(0))},kind:Card,filter:Any},count:BoundValue(@prior),from:Top},destination:Exile{visibility:FaceUp,arrival:ExileArrival{}},qualifiers:[]}}]}},ForEachPlayer{players:OpponentsOf(AbilityController),binding:0,body:_{instructions:[Effect{result:@next,operation:ChooseObjects{player:AbilityController,objects:Matching{objects:InZone{objects:MovedBy{result:@marked,phase:After,player:Bound(0)},zone:Exile},filter:AllOf([CardType(Land),OwnedBy(One(Bound(0)))])},count:AsManyAsCan(Constant(1))}},Effect{result:@next,operation:CreateContinuousEffect{source:Source,affected:Players(One(AbilityController)),changes:[PlayerRule(PlayPermission{cards:Selected(@prior),origins:CardPlayOrigins([Exile]),action:Either,filter:Any})],duration:WhileAnyExiled(Selected(@prior)),evaluation:LiveObjects}}]}}] */
instructions_each_opponent_top_exile_pick_land ::= "each" "opponent" "exiles" "the" "top" "X" "cards" "of" "their" "library" "," "where" "X" "is" value "." "for" "each" "opponent" "," "choose" "a" "land" "card" "that" "player" "owns" "exiled" "this" "way" "." "you" "may" "play" "the" "chosen" "cards" "for" "as" "long" "as" "they" "remain" "exiled"

/* Each permission belongs to the player instructed to exile that distinct
   looked-at slice. Hidden cards and the spending rule stay tied to it. */
/* @sem Ability::Spell{announcement:@announcement,body:_{instructions:[Effect{result:@next,operation:LookAt{player:$target_opponent,objects:Take{objects:Zone{scope:Players{zone:Library,players:One(AbilityController)},kind:Card,filter:Any},count:Constant(1),from:Top}}},Effect{result:@next,operation:Move{objects:Observed(@prior),destination:Exile{visibility:FaceDown,arrival:ExileArrival{}},qualifiers:[]}},Effect{result:@next,operation:LookAt{player:AbilityController,objects:Take{objects:Zone{scope:Players{zone:Library,players:One($target_opponent)},kind:Card,filter:Any},count:$card_count,from:Top}}},Effect{result:@next,operation:Move{objects:Observed(@prior),destination:Exile{visibility:FaceDown,arrival:ExileArrival{}},qualifiers:[]}},Effect{result:@next,operation:CreateContinuousEffect{source:Source,affected:Players(One($target_opponent)),changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:1,phase:After},origins:CardPlayOrigins([Exile]),action:Either,filter:Any},terms:_{cost:Normal,spend_as:AnyType,may_look:true}})],duration:WhileAnyExiled(Transition{result:1,phase:After}),evaluation:LiveObjects}},Effect{result:@next,operation:CreateContinuousEffect{source:Source,affected:Players(One(AbilityController)),changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:3,phase:After},origins:CardPlayOrigins([Exile]),action:Either,filter:Any},terms:_{cost:Normal,spend_as:AnyType,may_look:true}})],duration:WhileAnyExiled(Transition{result:3,phase:After}),evaluation:LiveObjects}}]}} */
spell_reciprocal_look_exile_play ::= target_opponent "looks" "at" "the" "top" "card" "of" "your" "library" "," "then" "exiles" "it" "face" "down" "." "you" "look" "at" "the" "top" card_count "of" "their" "library" "," "then" "exile" "them" "face" "down" "." "for" "each" "card" "exiled" "this" "way" "," "the" "player" "who" "exiled" "it" "may" "play" "it" "for" "as" "long" "as" "it" "remains" "exiled" "." "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "spells" "this" "way" "."

mill_hand_join ::= mill_hand_period | mill_hand_then
/* @sem () */
mill_hand_period ::= "."
/* @sem () */
mill_hand_then ::= "," "then"

/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$filter_instant_or_sorcery}, count:Exactly(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{}), qualifiers:[]}}] */
mill_choose_instant_or_sorcery ::= "mill" card_count "," "then" "put" "an" filter_instant_or_sorcery "card" "from" "among" "them" "into" "your" "hand"

/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$card_filter}, count:UpTo($count_plural)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{}), qualifiers:[]}}] */
mill_choose_up_to_matching ::= "mill" card_count "," "then" "put" "up" "to" count_plural card_filter "cards" "from" "among" "them" "into" "your" "hand"

/* The condition reads the one revealed card and both actions refer to source. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:$reveal_top}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:SetTapped{objects:One(Source), tapped:false}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Source)), changes:[Pump{power:$signed, toughness:$signed_2}], duration:$duration, evaluation:Snapshot}}]}, otherwise:Program{}}]}} */
activated_reveal_untap_and_pump ::= cost ":" reveal_top "." "if" "it's" "a" card_filter "card" "," "untap" self_creature "and" "it" "gets" signed "/" signed duration "." activation_limits "."

/* Both destinations consume the same reveal episode and preserve its order. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$reveal_until_card, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:$reveal_until_card}, destination:OwnersHand(CardArrival{}), qualifiers:[]}}, Effect{result:@next, operation:$rest_bottom}] */
reveal_until_single_partition_in_hand ::= reveal_until_your_library reveal_until_card "." "put" "that" "card" "into" "your" "hand" "and" rest_bottom

/* @sem ObjectFilter::AnyOf([CardType(Instant), CardType(Sorcery)]) */
reveal_until_instant_or_sorcery ::= "an" "instant" "or" "sorcery" "card"

/* The choice is optional and may show one of either printed card filters. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:AnyOf(@unordered([$a_card, $mill_take_has_x]))}, count:UpTo(Constant(1))}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:OwnersHand(CardArrival{}), qualifiers:[]}}, Effect{result:@next, operation:$rest_bottom}] */
dig_look_reveal_x_disjunction_hand ::= look_top "." "you" "may" "reveal" a_card "or" mill_take_has_x "from" "among" "them" "and" "put" "it" "into" "your" "hand" "." "put" rest_bottom

/* The value limit applies to the proposed spell, including a chosen card face. */
/* @sem Instruction::[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:InZone{objects:Observed(@marked), zone:Library}, count:UpTo(Constant(1)), terms:_{cost:Free, cast_filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:LessOrEqual, value:$greatest_controlled_stat}}}}}, Effect{result:@next, operation:$look_cast_rest}] */
look_cast_bounded_split ::= "you" "may" "cast" "a" "spell" "from" "among" "them" "with" "mana" "value" "less" "than" "or" "equal" "to" greatest_controlled_stat "without" "paying" "its" "mana" "cost" "." "put" look_cast_rest

/* @sem Operation::Move{objects:One(Source), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{}}, qualifiers:[]} */
named_owner_shuffles_him ::= SELF_NAME "'s" "owner" "shuffles" "him" "into" "their" "library"

search_distinct_name_choice ::= search_choice_with_different_names | search_choice_distinct_value_equal

/* @sem SearchChoice::SearchChoice{filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:Equal, value:$value}}]), count:UpTo($count), constraints:[DifferentNames]} */
search_choice_distinct_value_equal ::= "up" "to" count card_filter "cards" "with" "different" "names" "that" "each" "have" "mana" "value" value

/* A written count and a tapped arrival retain the selected cards until the move. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_counted_filtered]}}, Effect{result:@next, operation:$found_plural_battlefield_tapped}, ...$search_shuffle] */
clause_search_counted_tapped ::= "search" "your" "library" "for" search_choice_counted_filtered "," found_plural_battlefield_tapped search_shuffle

/* The searcher chooses the destination of the same selected card. */
/* @sem Operation::ChooseAction{actor:One(AbilityController), options:[Program{instructions:[Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{}), qualifiers:[]}}]}, Program{instructions:[Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersGraveyard(CardArrival{}), qualifiers:[]}}]}]} */
found_hand_or_graveyard ::= "put" "it" "into" "your" "hand" "or" "graveyard"

/* @sem Instruction::[...$reveal_top_hand_that, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:ObjectProperty{object:Query{objects:Observed(0), index:0}, property:ManaValue, information:CurrentOrLastKnown}}}] */
reveal_top_hand_controller_value_loss ::= reveal_top_hand_that "." "you" "lose" "life" "equal" "to" "the" "card's" "mana" "value"

/* A single cast picks across three origin populations while retaining the owner restriction on exile. */
/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:Union([Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$hand_spell_choice}, Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$hand_spell_choice}, Zone{scope:Shared(Exile), kind:Card, filter:@and($hand_spell_choice, ObjectFilter::OwnedBy(One(AbilityController)))}]), count:Exactly(Constant(1)), cost:Free} */
cast_free_own_three_zones ::= "cast" hand_spell_choice "from" "your" "hand" "," "from" "your" "graveyard" "," "or" "from" "among" "cards" "you" "own" "in" "exile" "without" "paying" "its" "mana" "cost"

/* Select randomly from the revealed slice, then put its unmoved remainder on the bottom. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$filter_phrase}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:$rest_bottom}] */
dig_reveal_random_battlefield ::= reveal_top "." "put" "a" "random" filter_phrase "card" "from" "among" "them" "onto" "the" "battlefield" "." "put" rest_bottom

/* The casting permission follows the actual exile arrival, with normal costs. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@back(3), phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:CastSpell, filter:Any})], duration:EndOfTurn, evaluation:LiveObjects}}] */
look_cast_exiled_this_turn ::= "you" "may" "cast" "the" "exiled" "card" "this" "turn"

/* @sem Instruction::[...$look_exile_card, ...$look_put_remainder, ...$look_cast_exiled_this_turn] */
look_exile_cast_this_turn_split ::= look_exile_card "." look_put_remainder "." look_cast_exiled_this_turn

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$look_exile_cast_this_turn_split, $next_combat_this_turn_trigger] */
instructions_look_then_combat ::= look_top "." look_exile_cast_this_turn_split "." next_combat_this_turn_trigger

/* The next combat must occur this turn. Its targets belong to the new trigger. */
/* @sem Instruction::Effect{result:@next, operation:@scope(Operation::CreateTrigger{event:Turn{point:CombatBegins, players:All}, duration:EndOfTurn, announcement:@announcement, body:$combat_trigger_creature_damage, once:true})} */
next_combat_this_turn_trigger ::= "at" "the" "beginning" "of" "the" "next" "combat" "phase" "this" "turn" "," combat_trigger_creature_damage

/* The source and recipient are separate targets of the combat trigger. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:DealDamage{source:$combat_damage_controlled_target, recipients:Objects(One($combat_damage_optional_other_target)), amount:ObjectProperty{object:$combat_damage_controlled_target, property:$creature_stat, information:CurrentOrLastKnown}, preventable:true}}]} */
combat_trigger_creature_damage ::= combat_damage_controlled_target "deals" "damage" "equal" "to" "its" creature_stat "to" combat_damage_optional_other_target

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), ControlledBy(One(AbilityController))])}), index:0} */
combat_damage_controlled_target ::= "target" "creature" "you" "control"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(Constant(1)), filter:AllOf([CardType(Creature), Not(ControlledBy(One(AbilityController)))])}), index:0} */
combat_damage_optional_other_target ::= "up" "to" "one" "target" "creature" "you" "don't" "control"

/* Only a library actually searched by this action is shuffled. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_three_singular_choice], also:[Graveyard, Hand], either:true}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(AbilityController), arrival:_{states:[AttachedTo(Source)]}}, qualifiers:[]}}, If{condition:Searched(@marked), then:_{instructions:[Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}, otherwise:_{}}] */
clause_search_three_zones_attached ::= "search" "your" "graveyard" "," "hand" "," "and" "/" "or" "library" "for" search_three_singular_choice "and" "put" "it" "onto" "the" "battlefield" "attached" "to" "this" "creature" "." "if" "you" "search" "your" "library" "this" "way" "," "shuffle"

/* The chosen card is the battlefield card, even if only one was found or
   its arrival is replaced. The other comes from the distinct selection. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:$search_filter_many, count:UpTo(Constant(2))}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Selected(@marked), count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:_{tapped:true}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Unselected(@back(3)), destination:OwnersHand(CardArrival{}), qualifiers:[]}}] */
clause_search_reveal_one_battlefield_other ::= "search" "your" "library" "for" "up" "to" "two" search_filter_many "," "reveal" "those" "cards" "," "and" "put" "one" "onto" "the" "battlefield" "tapped" "and" "the" "other" "into" "your" "hand"

/* Use one look, one mandatory selection and a permission on the exile arrival. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Selected(@back(3))])}, zone:Library}, end:Bottom, order:$library_order}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@back(3), phase:After, index:0}), origins:CardPlayOrigins([Exile]), action:Either, filter:Any})], duration:$this_duration, evaluation:LiveObjects}}] */
look_required_exile_reorder_play ::= "exile" "one" "of" "those" "cards" "and" "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order "." "you" "may" "play" "the" "exiled" "card" this_duration

/* The play permission consumes this exile receipt; its alternative applies to spells. */
/* @sem Instruction::[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($target_possessive)}, kind:Card, filter:Any}, count:$card_count, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:InZone{objects:Transition{result:@marked, phase:After}, zone:Exile}, origins:CardPlayOrigins([Exile]), action:Either, filter:Any}, terms:_{cost:Alternate(Cost{parts:[LifeEqualToOwnManaValue]})}})], duration:EndOfTurn, evaluation:LiveObjects}}] */
exile_target_library_play_life ::= "exile" "the" "top" card_count "of" target_possessive "library" "." "you" "may" "play" "those" "cards" "this" "turn" "." "if" "you" "cast" "a" "spell" "this" "way" "," "pay" "life" "equal" "to" "its" "mana" "value" "rather" "than" "pay" "its" "mana" "cost"

/* The triggering spell supplies X, even if it later leaves the stack. */
/* @sem Ability::Triggered{event:Spell{event:Cast, players:One(AbilityController), spells:State(HasX)}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:ObjectProperty{object:EventSubject, property:SpellX, information:CurrentOrLastKnown}, from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Random}}]}} */
triggered_cast_x_spell_dig ::= "whenever" "you" "cast" "a" "spell" "with" "{" "X" "}" "in" "its" "mana" "cost" "," "look" "at" "the" "top" "X" "cards" "of" "your" "library" "." "put" "one" "of" "them" "into" "your" "hand" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order" "."

/* The graveyard condition selects the number before the hand choice. */
/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:$number, from:Top}}}, If{condition:AllOf([Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:CardType(Instant)}), test:Compare{comparison:GreaterOrEqual, value:Constant(1)}}, Compare{left:CountObjects(Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:CardType(Sorcery)}), test:Compare{comparison:GreaterOrEqual, value:Constant(1)}}]), then:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(2)), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Chosen}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{})}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Chosen}}]}}] */
look_conditional_spell_types ::= "look" "at" "the" "top" number "cards" "of" "your" "library" "." "put" "one" "of" "them" "into" "your" "hand" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "any" "order" "." "if" "there" "is" "an" "instant" "card" "and" "a" "sorcery" "card" "in" "your" "graveyard" "," "instead" "put" "two" "of" "them" "into" "your" "hand" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "any" "order"

/* A single choice partitions the looked-at cards. Both moves happen together. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:UpTo($number_words), constraints:[]}}, Effect{result:@next, operation:Together([Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{}), qualifiers:[]}, Move{objects:Unselected(@prior), destination:OwnersGraveyard(CardArrival{}), qualifiers:[]}])}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:$life_amount}}] */
look_partition_hand_grave_then_life_loss ::= "put" "up" "to" number_words "of" "them" "into" "your" "hand" "and" "the" "rest" "into" "your" "graveyard" "." "you" "lose" life_amount

/* ControllerOf retains the target's controller when the destroy moves it away. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:Destroy{objects:One($target_object), regeneration:true}}, If{condition:Compare{left:PlayerNumber{player:ControllerOf($target_object), number:CardsInHand}, test:NumberTest::Compare{comparison:Greater, value:$number_words}}, then:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:ControllerOf($target_object), objects:Zone{scope:Players{zone:Hand, players:One(ControllerOf($target_object))}, kind:Card, filter:Any}, count:Exactly(Subtract([PlayerNumber{player:ControllerOf($target_object), number:CardsInHand}, $number_words])), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}]}, otherwise:Program{}}]}} */
spell_destroy_controller_exiles_hand_excess ::= "destroy" target_object "." "if" "its" "controller" "has" "more" "than" number_words "cards" "in" "hand" "," "they" "exile" "cards" "from" "their" "hand" "equal" "to" "the" "difference" "."

/* The first revealed creature is distinct from the noncreature remainder. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:CardType(Creature), count:Constant(1)}}, Effect{result:@mark, operation:NoteObjects{objects:Matching{objects:Observed(@prior), filter:CardType(Creature)}}}, If{condition:ObjectMatches{object:Result{result:@marked, phase:After, index:0}, filter:Property{property:ManaValue, test:Compare{comparison:LessOrEqual, value:CountObjects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([CardType(Land), ControlledBy(One(AbilityController))])})}}}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Selected(@marked), zone:Library}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:Selected(@marked), zone:Library}, destination:OwnersHand(CardArrival{}), qualifiers:[]}}]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(5)), excluding:Selected(@marked)}, zone:Library}, end:Bottom, order:Random}}] */
reveal_creature_land_threshold_split ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "a" "creature" "card" "." "if" "its" "mana" "value" "is" "less" "than" "or" "equal" "to" "the" "number" "of" "lands" "you" "control" "," "put" "it" "onto" "the" "battlefield" "." "otherwise" "," "put" "it" "into" "your" "hand" "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* The chosen revealed identities are fixed before the library is reordered. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:$number, from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:AnyOf([CardType(Creature), CardType(Land)])}, count:UpTo($number_2)}}, Effect{result:@mark, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Observed(@marked)}, zone:Library}, end:Bottom, order:Random}}, Effect{result:@next, operation:Move{objects:InZone{objects:Matching{objects:Observed(@marked), filter:CardType(Land)}, zone:Library}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Matching{objects:Observed(@marked), filter:CardType(Creature)}, zone:Library}, destination:OwnersHand(CardArrival{}), qualifiers:[]}}] */
look_reveal_split_land_creature ::= "look" "at" "the" "top" number "cards" "of" "your" "library" "." "you" "may" "reveal" "up" "to" number "creature" "and/or" "land" "cards" "from" "among" "them" "," "then" "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order" "." "put" "all" "land" "cards" "revealed" "this" "way" "onto" "the" "battlefield" "tapped" "and" "put" "all" "creature" "cards" "revealed" "this" "way" "into" "your" "hand"

/* The life condition raises the optional reveal bound from one to two. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}, count:$number, from:Top}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@prior), zone:Library}, filter:AnyOf([CardType(Creature), CardType(Land)])}, count:UpTo(Conditional{condition:$condition_gained_life_this_turn, then:Constant(2), otherwise:Constant(1)})}}, Effect{result:@mark, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:OwnersHand(CardArrival{}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(5)), excluding:Observed(@marked)}, zone:Library}, end:Bottom, order:Random}}] */
look_life_conditional_reveal_land_creature ::= "look" "at" "the" "top" number "cards" "of" "your" "library" "." "you" "may" "reveal" "a" "creature" "or" "land" "card" "from" "among" "them" "and" "put" "it" "into" "your" "hand" "." "if" condition_gained_life_this_turn "," "you" "may" "instead" "reveal" "two" "creature" "and/or" "land" "cards" "from" "among" "them" "and" "put" "them" "into" "your" "hand" "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* @sem Instruction::[Effect{result:@next, operation:Conjure{actor:One(AbilityController), card:Random(Term{family:CardsInOracle, form:And, operands:[Term{family:CardsInOracle, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Creature}]}, Term{family:CardsInOracle, form:ManaValueIs, operands:[Comparison(Equal, $value_departed_cards_greatest_mana)]}]}), count:Constant(1), destination:Battlefield(BattlefieldArrival{tapped:false, counters:[], states:[]})}}] */
conjure_random_creature_event_mana ::= "conjure" "a" "random" "creature" "card" "with" "mana" "value" "X" "onto" "the" "battlefield" "," "where" "X" "is" value_departed_cards_greatest_mana

/* The randomly selected craft material is the only card this action can cast. */
/* @sem Instruction::[Effect{result:@mark, operation:ChooseObjects{player:AbilityController, objects:$craft_trait_origin, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Result{result:@marked, phase:After, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}] */
instructions_random_crafted_card_free_cast ::= "choose" craft_trait_origin "at" "random" "." "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost"

/* Counter placement reads the observed cards before the independent draws. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:LibraryTops(All)}}, Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One($self_explicit_ref)), kind:$counter_kind, amount:CountObjects(Matching{objects:Observed(@marked), filter:$card_filter})}]}}, Effect{result:@next, operation:Draw{players:All, amount:$card_count}}] */
instructions_top_reveals_counters_then_draw ::= "each" "player" "reveals" "the" "top" "card" "of" "their" "library" "." "for" "each" card_filter "card" "revealed" "this" "way" "," "put" "a" counter_kind "counter" "on" self_explicit_ref "." "then" "each" "player" "draws" card_count

/* The departing incarnation provides each exiled creature's controller.
   Each affected player searches once for that many cards (CR 701.23h).
   All found lands enter together before those players shuffle. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Move{objects:One($target_permanent_not_controlled), destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, ForEachPlayer{players:Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:TransitionWhere{result:@marked, phase:Before, from:Battlefield, to:Exile}, filter:ControlledBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}, binding:0, body:Program{instructions:[Effect{result:@next, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[SearchChoice{filter:$search_filter, count:UpTo(CountObjects(Matching{objects:TransitionWhere{result:@marked, phase:Before, from:Battlefield, to:Exile}, filter:ControlledBy(One(Bound(0)))}))}]}}]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Selected(@prior), zone:Library}, destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:TransitionWhere{result:@marked, phase:Before, from:Battlefield, to:Exile}, filter:ControlledBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}}}}]} */
program_exile_granted_land_search ::= "exile" target_permanent_not_controlled "." "for" "each" "creature" "exiled" "this" "way" "," "its" "controller" "searches" "their" "library" "for" "a" search_filter "." "those" "players" "put" "those" "cards" "onto" "the" "battlefield" "tapped" "," "then" "shuffle" "."

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:Exactly(Constant(1)), filter:AllOf([CardType(Creature), Not(ControlledBy(One(AbilityController)))])}), index:0} */
target_permanent_not_controlled ::= "target" "creature" "you" "don't" "control"

/* The caster still uses a valid spell proposal for the free cast. Declining
   it or having no valid proposal leaves a normal end-of-turn permission. */
/* @sem Ability::Triggered{event:Filtered{event:FirstEachTurn(Spell{event:Cast, players:One(AbilityController), spells:Any}), condition:PlayerIsActive(AbilityController)}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($possessive_target_opponent)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{}}, qualifiers:[]}}, Effect{result:@next, operation:CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:CreatingEffect, recipe:$token_named_recipe}], entry:BattlefieldArrival{}}}, Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:InZone{objects:TransitionWhere{result:@marked, phase:After, from:Library, to:Exile}, zone:Exile}, count:UpTo(Constant(1)), terms:PlayTerms{cost:Free, cast_filter:Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:$value}}}}}, If{condition:Compare{left:Performed(@last_result), test:NumberTest::Compare{comparison:Equal, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:TransitionWhere{result:@marked, phase:After, from:Library, to:Exile}, origins:CardPlayOrigins([Exile]), action:CastSpell, filter:Any})], duration:EndOfTurn, evaluation:LiveObjects}}]}, otherwise:Program{}}]}} */
triggered_first_cast_exiled_spell_offer ::= "whenever" "you" "cast" "your" "first" "spell" "during" "each" "of" "your" "turns" "," "exile" "the" "top" "card" "of" possessive_target_opponent "library" "and" "create" "a" token_named_recipe "token" "." "then" "you" "may" "cast" "the" "exiled" "card" "without" "paying" "its" "mana" "cost" "if" "it's" "a" "spell" "with" "mana" "value" "less" "than" value "." "if" "you" "don't" "cast" "it" "this" "way" "," "you" "may" "cast" "it" "this" "turn" "."

/* Count each player whose permanent was destroyed. One qualified search
   gathers the cards before the tapped move and final shuffle. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:$operation_destroy_all_filtered}, If{condition:Compare{left:CountPlayers($players_with_destroyed_objects), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[SearchChoice{filter:$destroy_search_pair, count:UpTo(CountPlayers($players_with_destroyed_objects))}]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Selected(@prior), zone:Library}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true}}, qualifiers:[]}}]}, otherwise:Program{}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]} */
program_destroy_then_search_by_controller ::= operation_destroy_all_filtered "." "for" "each" players_with_destroyed_objects "," "search" "your" "library" "for" "a" destroy_search_pair "." "put" "those" "cards" "onto" "the" "battlefield" "tapped" "," "then" "shuffle" "."

/* @sem PlayerSet::Matching{binding:0, condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:Before}, filter:ControlledBy(One(Bound(0)))}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}} */
players_with_destroyed_objects ::= "player" "who" "controlled" "a" "permanent" "destroyed" "this" "way"

/* @sem ObjectFilter::AnyOf(@unordered([$search_filter, $search_filter_2])) */
destroy_search_pair ::= search_filter "or" "a" search_filter

/* @sem Ability::Triggered{event:$event_clause, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:0, operation:ExileLibraryUntil{actor:$exile_until_player_library, library:$exile_until_player_library, stop:Matching{filter:@agree($reveal_until_single_card, $card_filter), count:Constant(1)}}}, Effect{result:1, operation:PayCost{player:AbilityController, cost:Cost{parts:[PutCounters([_{recipients:Objects(One($self_ref_named)), kind:$counter_kind, amount:@agree($counter_amount, Constant(1))}])]}, optional:true}}, If{condition:Not(PaymentChosen(1)), then:Program{instructions:[Effect{result:4294967295, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:ExileUntilMatches(0), origins:CardPlayOrigins([Exile]), action:CastSpell, filter:Any}, terms:_{cost:Normal, spend_as:AnyType}})], duration:$duration, evaluation:LiveObjects}}]}, otherwise:Program{}}]}} */
/* @prefer always */
exile_until_optional_source_counter_or_cast ::= event_clause ","  exile_until_player_library reveal_until_single_card "." "you" "may" "put" counter_amount counter_kind "counter" "on" self_ref_named "." "if" "you" "don't" "," "you" "may" "cast" "the" "exiled" card_filter "card" duration "and" "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" "that" "spell" "."

/* @sem Instruction::[Effect{result:@mark, operation:ExileLibraryUntil{actor:AbilityController, library:AbilityController, stop:CumulativeAtLeast{property:ManaValue, threshold:$value}}}, Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Transition{result:@marked, phase:After}, count:AnyNumber, cost:Free}}] */
exile_mana_threshold_free_cast ::= "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" "cards" "with" "total" "mana" "value" value "or" "greater" "." "you" "may" "cast" "any" "number" "of" "spells" "from" "among" "them" "without" "paying" "their" "mana" "costs"

/* Only cards still in that discard's owner's graveyard can pay the optional
   cost. The delayed trigger moves that cost's actual exile arrival. */
/* @sem Ability::Triggered{event:$event_you_discard_filtered_batch, limits:TriggerLimits{}, announcement:@announcement, body:$discard_group_exile_tapped_later} */
triggered_discard_group_exile_delayed_arrival ::= "whenever" event_you_discard_filtered_batch "," discard_group_exile_tapped_later "."

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[Move{selections:[_{objects:Matching{objects:InZone{objects:EventGroup, zone:Graveyard}, filter:OwnedBy(One(AbilityController))}, choose:Exactly(Constant(1))}], destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@next, operation:CreateDelayedTrigger{event:$delayed_move_any_end, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:Move{objects:InZone{objects:CostObjects{payment:Resolution(@marked), component:[0], view:Performed, phase:After}, zone:Exile}, destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}]}}}]}, otherwise:Program{}}]} */
discard_group_exile_tapped_later ::= "you" "may" "exile" "one" "of" "them" "from" "your" "graveyard" "." "if" "you" "do" "," "put" "that" "card" "onto" "the" "battlefield" "tapped" "at" delayed_move_any_end

/* Each eligible owner is read from the corresponding face-up exile arrival,
   and the same card supplies both the life amount and plotted designation. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:Move{objects:LibraryTops($target_num_player_libraries), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, ForEachObject{objects:Matching{objects:TransitionWhere{result:@marked, phase:After, from:Library, to:Exile}, filter:Not(CardType(Land))}, binding:0, body:Program{instructions:[Effect{result:@next, operation:LoseLife{players:One(OwnerOf(Bound(0))), amount:ObjectProperty{object:Bound(0), property:ManaValue, information:CurrentOrLastKnown}}}, Effect{result:@next, operation:EffectOn{subject:Objects(One(Bound(0))), effects:[Term{family:ExiledCardEffect, form:IsPlotted}]}}]}}]} */
target_library_tops_exile_and_plot ::= "exile" "the" "top" "card" "of" target_num_player_libraries "." "for" "each" "nonland" "card" "exiled" "this" "way" "," "its" "owner" "loses" "life" "equal" "to" "its" "mana" "value" "and" "it" "becomes" "plotted" "."

/* @sem PlayerSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Player, count:Exactly($number), filter:Any, players:All})) */
target_num_player_libraries ::= number "target" "players'" "libraries"

/* The return interval belongs to the independently announced Shard. During
   activation the reduction checks either of the two actual target slots. */
/* @prefer always */
/* @sem Ability::Activated{origin:Ordinary, cost:$activation_cost, limits:ActivationLimits{modifiers:[ActivationRule(Cost{modifier:Reduce{reductions:[ManaReduction{amount:$number_digits}],spill_into_generic:true},condition:AnyOf(@unordered([ObjectMatches{object:Target{slot:0,index:0},filter:AllOf([CardType(Creature),ControlledBy(One(AbilityController))])},ObjectMatches{object:Target{slot:1,index:0},filter:AllOf([CardType(Creature),ControlledBy(One(AbilityController))])}]))})]}, announcement:@announcement, body:Program{instructions:[Effect{result:@mark, operation:Move{objects:One($source_excluded_exile_creature),destination:Exile{visibility:FaceUp,arrival:ExileArrival{}},qualifiers:[]}},Effect{result:@next,operation:ReturnAfter{objects:Transition{result:@marked,phase:After},duration:WhileOnBattlefield($exile_return_linked_shard)}}]}} */
activated_exile_target_until_second_target ::= activation_cost ":" "exile" source_excluded_exile_creature "until" exile_return_linked_shard "leaves" "the" "battlefield" "." "this" "ability" "costs" number_digits "less" "to" "activate" "if" "it" "targets" "a" "creature" "you" "control" "."

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot,kind:Object(ObjectDomain{kind:Permanent,zones:[Battlefield]}),count:Exactly(Constant(1)),filter:AllOf([CardType(Creature), Not(SameObject(Source))])}),index:0} */
source_excluded_exile_creature ::= "another" "target" "creature"

/* @sem ObjectRef::Target{slot:@target(TargetSpec::TargetSpec{slot:@slot,kind:Object(ObjectDomain{kind:Permanent,zones:[Battlefield]}),count:Exactly(Constant(1)),filter:Subtype(Shard)}),index:0} */
exile_return_linked_shard ::= "target" "Shard"

/* Play permissions refer to every actual arrival of the sequential exile,
   including cards passed over before the matching card. */
/* @sem Ability::Triggered{event:$turn_event,limits:TriggerLimits{},announcement:@announcement,body:Program{instructions:[Effect{result:@mark,operation:ExileLibraryUntil{actor:AbilityController,library:AbilityController,stop:Matching{filter:$card_filter,count:Constant(1)}}},Effect{result:@next,operation:CreateContinuousEffect{source:Source,affected:Players(One(AbilityController)),changes:[PlayerRule(PlayPermission{cards:Transition{result:@marked,phase:After},origins:CardPlayOrigins([Exile]),action:Either,filter:Any})],duration:$this_duration,evaluation:LiveObjects}}]}} */
triggered_exile_until_play_receipts ::= "at" turn_event "," "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" "a" card_filter "card" "." "you" "may" "play" "those" "cards" this_duration "."

/* Transform only the actual battlefield arrival; retain the looked-at remainder. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$a_card}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}}]}}, Effect{result:@mark, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{}}, qualifiers:[]}}, If{condition:Compare{left:CountObjects(Matching{objects:InZone{objects:Transition{result:@marked, phase:After}, zone:Battlefield}, filter:State(DoubleFaced)}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Transform{object:Result{result:@marked, phase:After, index:0}}}}]}}]}, otherwise:Program{}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(5)), excluding:Union([Transition{result:@marked, phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
dig_look_entry_optional_transform ::= look_top "." "you" "may" "put" a_card "from" "among" "them" "onto" "the" "battlefield" "." "if" "it's" "a" "double-faced" "card" "," "you" "may" "transform" "it" "." "put" "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* The compound subject distributes the search, arrival, and shuffle by player. */
/* @sem Instruction::[ForEachPlayer{players:Union(@unordered([One(AbilityController), One($target_opponent)])), binding:0, body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[$player_search_one_choice]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(Bound(0)), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}] */
controller_and_opponent_each_search ::= "you" "and" target_opponent "each" "search" "your" "library" "for" player_search_one_choice "," "put" "it" search_option_entry "," "then" "shuffle"

/* The written definition is shared across the three printing effects. */
/* @sem ObjectFilter::AnyOf([PrintingHas(Foil), PrintingHas(SecretLair)]) */
shiny_printing_filter ::= "shiny"

/* @sem Ability::WithPresentation{reminder:true, ability:Triggered{event:$event_planeswalk_here, limits:_{}, announcement:@announcement, body:Program{instructions:[ForEachPlayer{players:All, binding:0, body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[SearchChoice{filter:$shiny_printing_filter, count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}]}}} */
triggered_planeswalk_each_printing_search ::= "when" event_planeswalk_here "," "each" "player" "searches" "their" "library" "for" "a" shiny_printing_filter "card" "," "reveals" "it" "," "puts" "it" "into" "their" "hand" "," "then" "shuffles" "." "(" "foil" "cards" "and" "Secret" "Lair" "cards" "are" "shiny" "." ")"

/* Protection names the source's card printing even when it is a spell. */
/* @sem Ability::Static{kind:Ordinary, affected:Objects(AnyZone($shiny_printing_filter)), changes:[GrantKeyword(Protection(Objects{kind:Card, filter:$nonshiny_printing_filter}))]} */
static_printing_protection ::= shiny_printing_filter "cards" "have" "protection" "from" nonshiny_printing_filter "cards" "."

/* @sem ObjectFilter::Not(AnyOf([PrintingHas(Foil), PrintingHas(SecretLair)])) */
nonshiny_printing_filter ::= "non-shiny"

/* The one matching revealed card is retained separately from the rest. */
/* @sem Ability::Triggered{event:$event_chaos_ensues, limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:RevealUntil{library:AbilityController, filter:$shiny_nonland_card_filter, count:Constant(1)}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Observed(0), filter:$shiny_nonland_card_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:Selected(1), count:UpTo(Constant(1)), cost:Free}}, If{condition:Not(CastPerformed(2)), then:Program{instructions:[Effect{result:@next, operation:Move{objects:Selected(1), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(0), excluding:Selected(1)}, zone:Library}, end:Bottom, order:Random}}]}} */
triggered_chaos_reveal_printing_cast ::= "whenever" event_chaos_ensues "," "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "a" shiny_nonland_card_filter "." "you" "may" "cast" "it" "without" "paying" "its" "mana" "cost" "." "if" "you" "don't" "," "put" "it" "into" "your" "hand" "." "put" "the" "other" "revealed" "cards" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order" "."

/* @sem ObjectFilter::@and($shiny_printing_filter, ObjectFilter::Not(CardType(Land))) */
shiny_nonland_card_filter ::= shiny_printing_filter "nonland" "card"

/* The observed library supplies the omitted destination owner. */
/* @sem Instruction::[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$spell_filter}, count:UpTo(Constant(1)), terms:_{cost:Free}}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:$library_order}}] */
look_cast_split_implicit_bottom ::= "you" "may" "cast" spell_filter "from" "among" "them" "without" "paying" "its" "mana" "cost" "." "put" "the" "rest" "on" "the" "bottom" library_order

exiled_cards_play_duration ::= exiled_cards_play_before | exiled_cards_play_after

/* @sem Duration::$duration */
exiled_cards_play_before ::= duration "," "you" "may" "play" "those" "cards"

/* @sem Duration::$duration */
exiled_cards_play_after ::= "you" "may" "play" "those" "cards" duration
