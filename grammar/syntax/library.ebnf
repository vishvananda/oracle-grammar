/* Searching and inspecting a library. */

/* What was found stays the referent of `it` until the search is over. */
clause_search ::= clause_search_general | clause_search_any_number
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:$search}, ...$search_follow] */
clause_search_general ::= search search_follow
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:$search_any_number}, ...$search_plural_follow] */
clause_search_any_number ::= search_any_number search_plural_follow
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_any_number]} */
search_any_number ::= "search" "your" "library" "for" search_choice_any_number
search_plural_follow ::= search_plural_more | search_shuffle | search_shuffle_top_any_order
/* @sem Instruction::[Instruction::Effect{result:@next, operation:$found_plural_action}, ...$search_plural_follow] */
search_plural_more ::= "," found_plural_action search_plural_follow
found_plural_action ::= found_plural_reveal | found_plural_exile | found_plural_battlefield | found_plural_battlefield_tapped
/* @sem Operation::Reveal{objects:Selected(@marked)} */
found_plural_reveal ::= "reveal" "them"
/* @sem Operation::Move{objects:Selected(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
found_plural_exile ::= "exile" "them"
/* @sem Operation::@search_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}) */
found_plural_battlefield ::= "put" "them" "onto" "the" "battlefield"
/* @sem Operation::@search_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}) */
found_plural_battlefield_tapped ::= "put" "them" "onto" "the" "battlefield" "tapped"

/* A where-X definition can close the search sentence; the next sentence moves
   what was found. */
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice_many_where]}}, Instruction::Effect{result:@next, operation:$found_action}, ...$search_follow] */
clause_search_where_split ::= "search" "your" "library" "for" search_choice_many_where "." found_action search_follow

/* A named player searches their own library and keeps the selected identities
   through the following move or shuffle/reorder. These subjects use third person. */
search_player ::= target_player | target_opponent | that_player | defending_player | search_possessive_controller | search_possessive_owner | its_controller | its_owner | attacking_player | stack_controller

/* @sem PlayerRef::ControllerOf($self_possessive) */
search_possessive_controller ::= self_possessive "controller"
/* @sem PlayerRef::OwnerOf($self_possessive) */
search_possessive_owner ::= self_possessive "owner"

/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:$search_player, library_owner:$search_player, choices:[$player_search_hand]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($search_player)}}] */
clause_player_search_hand ::= search_player player_search_hand

/* @sem Instruction::[Effect{result:@next, operation:LoseLife{players:One($search_player), amount:$life_phrase}}, Effect{result:@mark, operation:Search{searcher:$search_player, library_owner:$search_player, choices:[$player_search_hand]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($search_player)}}] */
clause_player_loss_search ::= search_player "loses" life_phrase "," player_search_hand

/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:$search_player, library_owner:$search_player, choices:[$player_search_top]}}, Effect{result:@next, operation:Shuffle{players:One($search_player), excluding:Selected(@marked)}}, Effect{result:@next, operation:ReorderLibrary{chooser:$search_player, library_owner:$search_player, objects:Selected(@marked), end:Top, order:Chosen}}] */
clause_player_search_top ::= search_player player_search_top

/* A named player may search their own library. What they find enters under their
   control or goes to their hand, and they shuffle. Each player of a plural subject
   decides and searches separately; without "may" each of them searches. */
clause_player_may_search ::= player_may_search_battlefield | player_may_search_reveal_hand | each_may_search_battlefield | each_may_search_reveal_hand | each_search_battlefield
/* @sem Instruction::[ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[$player_search_one_choice]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(Bound(0)), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}] */
each_search_battlefield ::= hand_plural_players "searches" "their" "library" "for" player_search_one_choice "," "puts" found_one search_option_entry "," "then" "shuffles"
/* @sem Instruction::[Optional{decider:$search_player, body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:$search_player, library_owner:$search_player, choices:[$may_search_choice]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player($search_player), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($search_player)}}]}}] */
player_may_search_battlefield ::= search_player "may" "search" "their" "library" "for" may_search_choice "," "put" found search_option_entry "," "then" "shuffle"
/* @sem Instruction::[Optional{decider:$search_player, body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:$search_player, library_owner:$search_player, choices:[$may_search_choice]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($search_player)}}]}}] */
player_may_search_reveal_hand ::= search_player "may" "search" "their" "library" "for" may_search_choice "," "reveal" found "," "put" found "into" "their" "hand" "," "then" "shuffle"
/* @sem Instruction::[ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[$may_search_choice]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:Battlefield{controller:Player(Bound(0)), arrival:$search_option_entry}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}]}}] */
each_may_search_battlefield ::= hand_plural_players "may" "search" "their" "library" "for" may_search_choice "," "put" found search_option_entry "," "then" "shuffle"
/* @sem Instruction::[ForEachPlayer{players:$hand_plural_players, binding:0, body:Program{instructions:[Optional{decider:Bound(0), body:Program{instructions:[Effect{result:@mark, operation:Search{searcher:Bound(0), library_owner:Bound(0), choices:[$may_search_choice]}}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}]}}] */
each_may_search_reveal_hand ::= hand_plural_players "may" "search" "their" "library" "for" may_search_choice "," "reveal" found "," "put" found "into" "their" "hand" "," "then" "shuffle"
may_search_choice ::= player_search_one_choice | player_search_many_choice

player_search_hand ::= player_search_hand_one | player_search_hand_many
/* @sem $player_search_one_choice */
player_search_hand_one ::= "searches" "their" "library" "for" player_search_one_choice "," "puts" found_one "into" "their" "hand" "," "then" "shuffles"
/* @sem $player_search_many_choice */
player_search_hand_many ::= "searches" "their" "library" "for" player_search_many_choice "," "puts" found_many "into" "their" "hand" "," "then" "shuffles"

player_search_top ::= player_search_top_one | player_search_top_many
/* @sem $player_search_one_choice */
player_search_top_one ::= "searches" "their" "library" "for" player_search_one_choice "," "then" "shuffles" "and" "puts" found_one "on" "top"
/* @sem $player_search_many_choice */
player_search_top_many ::= "searches" "their" "library" "for" player_search_many_choice "," "then" "shuffles" "and" "puts" found_many "on" "top"

/* @sem () */
found_one ::= "it" | "that" "card"
/* @sem () */
found_many ::= "them" | "those" "cards"

player_search_one_choice ::= search_choice_any | search_choice_filtered | search_choice_optional_one
player_search_many_choice ::= search_choice_many | search_choice_many_any

/* After milling, you may put one matching card of those milled into your hand. */
/* @sem Instruction::[Effect{result:@mark, operation:Mill{players:One(AbilityController), amount:$card_count}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:Transition{result:@marked, phase:After}, filter:$mill_take_choice}, count:Exactly(Constant(1))}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}}] */
clause_mill_take ::= "mill" card_count "." "you" "may" "put" mill_take_choice "from" "among" "them" "into" "your" "hand"
mill_take_choice ::= mill_take_filtered | mill_take_modified
/* @sem $search_filter */
mill_take_filtered ::= ("a" | "an") search_filter
/* @sem $modifier */
mill_take_modified ::= "a" "card" modifier

/* What a search looks for: one find clause. */
search_choice ::= search_choice_filtered | search_choice_any | search_choice_modified | search_choice_many | search_choice_many_any | search_named_one | search_named_many | search_choice_many_where
/* An unrestricted plural choice composes with the ordinary search follow-ups. */
/* @sem SearchChoice::SearchChoice{filter:$filter_phrase, count:AnyNumber} */
search_choice_any_number ::= "any" "number" "of" filter_phrase "cards"

/* The count's definition follows the cards it counts. */
/* @sem SearchChoice::SearchChoice{filter:$search_filter_many, count:UpTo($value)} */
search_choice_many_where ::= "up" "to" "X" search_filter_many "," "where" "X" "is" value
/* @sem SearchChoice::SearchChoice{filter:Any, count:AsManyAsCan(Constant(1))} */
search_choice_any ::= "a" "card"
/* @sem SearchChoice::SearchChoice{filter:$search_filter, count:UpTo(Constant(1))} */
search_choice_filtered ::= ("a" | "an") search_filter
/* A card described only by what follows the noun, as `a card named Jiang Yanggu`. */
/* @sem SearchChoice::SearchChoice{filter:$modifier, count:UpTo(Constant(1))} */
search_choice_modified ::= "a" "card" modifier
/* @sem SearchChoice::SearchChoice{filter:Any, count:UpTo(Constant(1))} */
search_choice_optional_one ::= "up" "to" ("one" | "1") "card"
/* @sem SearchChoice::SearchChoice{filter:$search_filter_many, count:UpTo($count)} */
search_choice_many ::= "up" "to" count search_filter_many
/* @sem SearchChoice::SearchChoice{filter:Any, count:UpTo($count)} */
search_choice_many_any ::= "up" "to" count "cards"

/* A later paragraph offers an alternative destination for the same original
   selection. Selected retains those identities: the normal hand move follows
   the optional change, and the shuffle remains outside its condition. */
/* @sem Ability::WithPresentation{label:$ability_label, reminder:false, ability:Spell{announcement:@announcement, body:Program{instructions:[...$search_option_start, ...$search_option_if, Effect{result:@next, operation:$found_hand}, ...$search_shuffle]}}} */
labelled_search_option ::= search_option_start "," found_hand search_shuffle "." NEWLINE ability_label "—" search_option_if "."

search_option_start ::= search_option_plain | search_option_revealed

/* @sem Instruction::[Effect{result:@mark, operation:$search}] */
search_option_plain ::= search

/* @sem Instruction::[Effect{result:@mark, operation:$search}, Effect{result:@next, operation:$found_reveal}] */
search_option_revealed ::= search "," found_reveal

/* @sem Instruction::[If{condition:$condition, then:Program{instructions:[Effect{result:@next, operation:$search_option_move}]}, otherwise:Program{}}] */
search_option_if ::= search_option_move "instead" "of" "putting" found "into" owners ("hand" | "hands") "if" condition

/* @sem Operation::WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(PlayerRef::AbilityController)), objects:Selected(@marked), count:AnyNumber, constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:Battlefield{controller:Owner, arrival:$search_option_entry}, qualifiers:[]}} */
search_option_move ::= "you" "may" "put" found search_option_entry

search_option_entry ::= search_option_normal | search_option_tapped

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:false, counters:[], states:[]} */
search_option_normal ::= "onto" "the" "battlefield"

/* @sem BattlefieldArrival::BattlefieldArrival{tapped:true, counters:[], states:[]} */
search_option_tapped ::= "onto" "the" "battlefield" "tapped"

search ::= search_library | search_library_graveyard

/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice]} */
search_library ::= "search" "your" "library" "for" search_choice

/* The graveyard is searched along with the library, which is still shuffled. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice], also:[Graveyard]} */
search_library_graveyard ::= "search" "your" "library" "and" "graveyard" "for" search_choice

/* With `and/or` the searcher chooses where to look, and shuffles only if that
   included the library. The search stays the referent until the shuffle. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_choice], also:[Graveyard], either:true}}, ...$search_either_follow, If{condition:Searched(@marked), then:Program{instructions:[Effect{result:@next, operation:Shuffle{players:One(PlayerRef::AbilityController)}}]}, otherwise:Program{}}] */
clause_search_either ::= "search" "your" search_either_zones "for" search_choice search_either_follow "." "if" "you" "search" "your" "library" "this" "way" "," "shuffle"

/* @sem () */
search_either_zones ::= "library" "and" "/" "or" "graveyard" | "graveyard" "and" "/" "or" "library"

search_either_follow ::= search_either_one | search_either_two
/* @sem Instruction::[Effect{result:@next, operation:$found_action}] */
search_either_one ::= "and" found_action
/* @sem Instruction::[Effect{result:@next, operation:$found_action}, Effect{result:@next, operation:$found_action_2}] */
search_either_two ::= "," found_action "," ("and" | "then") found_action

search_filter ::= search_filter_subtype_list | search_filter_plain | search_filter_modified | search_filter_either

/* "A basic land card or a Desert card": either kind, each with its own noun. */
/* @sem ObjectFilter::AnyOf([$card_filter, $card_filter_2]) */
search_filter_either ::= card_filter "card" "or" ("a" | "an") card_filter "card"

/* @sem $card_filter */
search_filter_plain ::= card_filter "card"

/* @sem @and($card_filter, $modifiers) */
search_filter_modified ::= card_filter "card" modifiers

search_filter_many ::= search_many_plain | search_many_modified

/* @sem $card_filter */
search_many_plain ::= card_filter "cards"

/* @sem @and($card_filter, $modifiers) */
search_many_modified ::= card_filter "cards" modifiers

/* You search a named player's library, act on what was found, and that player
   shuffles. What was found keeps its owner. A sentence between the two would
   need what was found as its referent, so it is not part of this form. */
/* @sem Instruction::[Effect{result:@mark, operation:Search{searcher:AbilityController, library_owner:$target_possessive, choices:[$foreign_search_choice]}}, Effect{result:@next, operation:$foreign_found_action}, Effect{result:@next, operation:Shuffle{players:One($target_possessive)}}] */
clause_search_target_library ::= "search" target_possessive "library" "for" foreign_search_choice "and" foreign_found_action "." "then" "that" "player" "shuffles"
foreign_search_choice ::= search_choice | foreign_choice_count | foreign_choice_where | foreign_choice_up_to_where
/* @sem SearchChoice::SearchChoice{filter:Any, count:AsManyAsCan($count)} */
foreign_choice_count ::= count "cards"
/* @sem SearchChoice::SearchChoice{filter:Any, count:AsManyAsCan($value)} */
foreign_choice_where ::= "X" "cards" "," "where" "X" "is" value ","
/* @sem SearchChoice::SearchChoice{filter:Any, count:UpTo($value)} */
foreign_choice_up_to_where ::= "up" "to" "X" "cards" "," "where" "X" "is" value ","
foreign_found_action ::= found_exile | found_graveyard | found_battlefield_yours
/* @sem Operation::@search_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}) */
found_battlefield_yours ::= "put" found "onto" "the" "battlefield" "under" "your" "control"

search_follow ::= search_follow_more | search_follow_last

/* @sem Instruction::[Instruction::Effect{result:@next, operation:$found_action}, ...$search_follow] */
search_follow_more ::= "," found_action search_follow

search_follow_last ::= search_shuffle | search_shuffle_top | search_shuffle_top_any_order

/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::Shuffle{players:One(PlayerRef::AbilityController)}}] */
search_shuffle ::= "," "then" "shuffle" ("your" "library")?

/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::Shuffle{players:One(PlayerRef::AbilityController), excluding:Selected(@marked)}}, Instruction::Effect{result:@next, operation:Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@marked), end:Top, order:Chosen}}] */
search_shuffle_top ::= "," "then" "shuffle" "and" "put" found "on" "top"

/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::Shuffle{players:One(PlayerRef::AbilityController), excluding:Selected(@marked)}}, Instruction::Effect{result:@next, operation:Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@marked), end:Top, order:Chosen}}] */
search_shuffle_top_any_order ::= "," "then" "shuffle" "and" "put" "those" "cards" "on" "top" "in" "any" "order"

/* @sem () */
found ::= "it" | "them" | "that" "card" | "those" "cards"

found_action ::= found_reveal | found_exile | found_hand | found_graveyard | found_top | found_battlefield | found_battlefield_tapped

/* @sem Operation::Reveal{objects:Selected(@marked)} */
found_reveal ::= "reveal" found
/* @sem Operation::Move{objects:Selected(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
found_exile ::= "exile" found
/* @sem Operation::Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]} */
found_hand ::= "put" found "into" owners ("hand" | "hands")
/* @sem Operation::Move{objects:Selected(@marked), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]} */
found_graveyard ::= "put" found "into" owners ("graveyard" | "graveyards")
/* @sem Operation::Move{objects:Selected(@marked), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
found_top ::= "put" found "on" "top" "of" owners ("library" | "libraries")
/* @sem Operation::@search_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}) */
found_battlefield ::= "put" found "onto" "the" "battlefield"
/* @sem Operation::@search_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}) */
found_battlefield_tapped ::= "put" found "onto" "the" "battlefield" "tapped"

/* An end of one player's library or graveyard: "the top two cards of target player's
   library", "the bottom card of your graveyard". */
ordered_cards ::= ordered_slice | ordered_counted | library_tops

/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:$ordered_zone, players:One($player_possessive)}, kind:Card, filter:Any}, count:$top_count, from:$ordered_end} */
ordered_slice ::= "the" ordered_end top_count "of" player_possessive ordered_zone

/* "That many cards from the top of your library": the same slice, counted first. */
/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:$ordered_zone, players:One($player_possessive)}, kind:Card, filter:Any}, count:$card_count, from:$ordered_end} */
ordered_counted ::= card_count "from" "the" ordered_end "of" player_possessive ordered_zone

/* "The top card of each player's library" is one card from each library, not the top
   card of all of them together. */
/* @sem ObjectSet::LibraryTops($players_possessive) */
library_tops ::= "the" "top" "card" "of" players_possessive "library"

/* The top card itself, read where it is: "if the top card of your library is a land
   card". */
/* @sem ObjectRef::Query{objects:Zone{scope:Players{zone:$ordered_zone, players:One($player_possessive)}, kind:Card, filter:Any}, index:0} */
ordered_top_card ::= "the" "top" "card" "of" player_possessive ordered_zone

ordered_end ::= ordered_top | ordered_bottom
/* @sem SequenceEnd::Top */
ordered_top ::= "top"
/* @sem SequenceEnd::Bottom */
ordered_bottom ::= "bottom"

ordered_zone ::= ordered_library | ordered_graveyard
/* @sem EventZone::Library */
ordered_library ::= "library"
/* @sem EventZone::Graveyard */
ordered_graveyard ::= "graveyard"

/* The top of your library, looked at or shown. What follows the look names your own
   library and hand. */
your_top ::= your_top_slice | your_top_counted

/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:$top_count, from:Top} */
your_top_slice ::= "the" "top" top_count "of" "your" "library"

/* "That many cards from the top of your library": the same slice, counted first. */
/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:$card_count_that_many, from:Top} */
your_top_counted ::= card_count_that_many "from" "the" "top" "of" "your" "library"

top_count ::= top_one | top_many

/* @sem Expr::Constant(1) */
top_one ::= "card"

/* @sem $number */
top_many ::= number "cards"

/* @sem Operation::Reveal{objects:$your_top} */
reveal_top ::= "reveal" your_top

/* @sem Operation::LookAt{player:AbilityController, objects:$your_top} */
look_top ::= "look" "at" your_top

/* Inspect the specified objects without moving or choosing any of them. */
/* @sem Operation::LookAt{player:AbilityController, objects:$affected} */
look_objects ::= "look" "at" affected

/* Cards looked at stay observed; what is left of them is what was not moved. */
/* @sem CardOrder::Random */
order_random ::= "in" "a" "random" "order"
/* @sem CardOrder::Chosen */
order_any ::= "in" "any" "order"

library_order ::= order_random | order_any

/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(2), phase:Before}])}, zone:Library}, end:Bottom, order:$library_order} */
rest_bottom ::= "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Operation::Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(2), phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]} */
rest_graveyard ::= ("the" "rest" | "the" "other") "into" "your" "graveyard"

/* With one card left, Oracle names no order for it. */
/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(2), phase:Before}])}, zone:Library}, end:Bottom, order:Chosen} */
rest_other_bottom ::= "the" "other" "on" "the" "bottom" "of" "your" "library"

look_rest ::= rest_bottom | rest_other_bottom | rest_graveyard

/* @sem Instruction::[Instruction::Effect{result:@next, operation:Operation::ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:AsManyAsCan($look_hand_count), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Instruction::Effect{result:@next, operation:Operation::Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Instruction::Effect{result:@next, operation:$look_rest}] */
look_put_split ::= "put" look_hand_count "into" "your" "hand" "and" look_rest

/* @sem Instruction::[Instruction::Effect{result:@mark, operation:$look_top}, ...$look_put_split] */
instructions_look_put ::= ("you")? look_top "." look_put_split

/* "Look ..., then put ..." is one sentence, so a condition before it governs the
   whole look and split; the two-sentence form above is not a clause. */
/* @sem $look_put_then_body */
clause_look_put_then ::= ("you")? look_put_then_body

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$look_put_split] */
look_put_then_body ::= look_top ("," "then" | "and") look_put_split

look_count ::= number

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}} */
look_battlefield_tapped ::= "onto" "the" "battlefield" "tapped"

/* Looking at or revealing the top of your library, taking some of those cards and
   putting the rest away. The take chooses from the observed cards still in the
   library; the rest excludes what the move took. Later sentences follow the block. */
instructions_dig ::= dig_block | dig_block_more | dig_block_untaken

/* @sem Instruction::[...$dig_block, ...$instructions] */
dig_block_more ::= dig_block "." instructions

/* Only a look-and-take states the miss this way; a revealed required take names
   its move's result instead. */
/* @sem Instruction::[...$dig_look_split, $dig_untaken_if] */
dig_block_untaken ::= dig_look_split "." dig_untaken_if

/* Nothing was taken when the take's move, just before the rest, moved no card. */
/* @sem Instruction::If{condition:Not(Compare{left:CountObjects(Union([Transition{result:@back(2), phase:Before}])), test:Compare{comparison:Greater, value:Constant(0)}}), then:Program{instructions:$conjoined}, otherwise:Program{}} */
dig_untaken_if ::= "if" "you" "didn't" "put" "a" "card" "into" "your" "hand" "this" "way" "," conjoined

dig_block ::= dig_look_split | dig_look_joined | dig_reveal_split | dig_reveal_joined

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$dig_follow_split] */
dig_look_split ::= look_top "." dig_follow_split

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$dig_follow_joined] */
dig_look_joined ::= look_top "." dig_follow_joined

/* What follows a look: a take, then the rest, in two sentences or one. */
dig_follow ::= dig_follow_split | dig_follow_joined

/* @sem Instruction::[...$dig_look_take, $dig_rest_put] */
dig_follow_split ::= dig_look_take "." dig_rest_put

/* @sem Instruction::[...$dig_put_take, $dig_rest_and] */
dig_follow_joined ::= dig_put_take dig_rest_and

/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$dig_put_take, $dig_rest_put] */
dig_reveal_split ::= reveal_top "." dig_put_take "." dig_rest_put

/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$dig_put_take, $dig_rest_and] */
dig_reveal_joined ::= reveal_top "." dig_put_take dig_rest_and

/* "Reveal the top card of your library. If it's a land card, put it onto the
   battlefield. Otherwise, put that card into your hand." The test reads the revealed
   card; "it" in each branch is still the top card of your library, which the branch
   takes. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:Expr::Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}, then:Program{instructions:$observed_top_reveal_branch}, otherwise:Program{}}] */
instructions_top_reveal_if ::= "reveal" "the" "top" "card" "of" "your" "library" "." "if" "it's" top_reveal_quality "," observed_top_reveal_branch
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:Expr::Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}, then:Program{instructions:$observed_top_reveal_branch}, otherwise:Program{instructions:$observed_top_reveal_branch_2}}] */
instructions_top_reveal_if_otherwise ::= "reveal" "the" "top" "card" "of" "your" "library" "." "if" "it's" top_reveal_quality "," observed_top_reveal_branch "." "otherwise" "," observed_top_reveal_branch

/* "Defending player reveals the top card of their library. If it's a land card, that
   player puts it into their hand": another player's single revealed card, tested and
   moved by that player. */
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:Expr::Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:Observed(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}]}, otherwise:Program{}}] */
instructions_player_reveal_to_hand ::= player_ref "reveals" "the" "top" "card" "of" "their" "library" "." "if" "it's" top_reveal_quality "," "that" "player" "puts" "it" "into" "their" "hand"
/* @sem Instruction::[Effect{result:@mark, operation:Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:Expr::Constant(1), from:Top}}}, If{condition:Compare{left:CountObjects(Matching{objects:Observed(@marked), filter:$top_reveal_quality}), test:NumberTest::Compare{comparison:GreaterOrEqual, value:Expr::Constant(1)}}, then:Program{instructions:[Optional{decider:$player_ref, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Observed(@marked), destination:Battlefield{controller:Player($player_ref), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}]}, otherwise:Program{}}] */
instructions_player_reveal_may_battlefield ::= player_ref "reveals" "the" "top" "card" "of" "their" "library" "." "if" "it's" top_reveal_quality "," "the" "player" "may" "put" "it" "onto" "the" "battlefield"

/* "You may pay {2}{R}. If you do, reveal the top card of your library. If it's ...": the
   test of the revealed card stays inside the paid branch that revealed it. */
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:Program{instructions:$top_reveal_test}, otherwise:Program{}}] */
clause_if_you_do_reveal_test ::= "you" "may" payment "." "if" "you" "do" "," top_reveal_test
top_reveal_test ::= instructions_top_reveal_if | instructions_top_reveal_if_otherwise
top_reveal_quality ::= top_reveal_kind | top_reveal_kind_with
/* @sem $card_filter */
top_reveal_kind ::= ("a" | "an") card_filter "card"
/* @sem @and($card_filter, $modifiers) */
top_reveal_kind_with ::= ("a" | "an") card_filter "card" modifiers
top_reveal_branch ::= top_reveal_put | top_reveal_may_put | top_reveal_draw | top_reveal_continuous | clause_you | top_reveal_you_and
/* @sem Instruction::[...$clause_you, ...$clause_you_2] */
top_reveal_you_and ::= clause_you "and" clause_you
/* @sem Instruction::[Effect{result:@next, operation:$continuous_snapshot}] */
top_reveal_continuous ::= continuous_snapshot
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:Expr::Constant(1), from:Top}, destination:$top_reveal_destination, qualifiers:[]}}] */
top_reveal_put ::= "put" top_reveal_it top_reveal_destination
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:$top_reveal_put}}] */
top_reveal_may_put ::= "you" "may" top_reveal_put
/* @sem Instruction::[Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}] */
top_reveal_draw ::= "draw" card_count
/* @sem () */
top_reveal_it ::= "it" | "that" "card"
top_reveal_destination ::= until_hand | until_battlefield | look_battlefield_tapped | top_reveal_graveyard | top_reveal_bottom
/* @sem MovementDestination::OwnersGraveyard(CardArrival{counters:[], states:[]}) */
top_reveal_graveyard ::= "into" "your" "graveyard"
/* @sem MovementDestination::Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
top_reveal_bottom ::= "on" "the" "bottom" "of" "your" "library"

/* The rest is numbered where its words start, after the take it excludes. */
/* @sem Instruction::Effect{result:@next, operation:$look_rest} */
dig_rest_put ::= ("then")? "put" look_rest
/* @sem Instruction::Effect{result:@next, operation:$look_rest} */
dig_rest_and ::= "and" look_rest

/* Looked-at cards are revealed as they are taken; revealed ones are already shown. */
dig_look_take ::= dig_reveal_one | dig_reveal_upto | dig_reveal_any | dig_reveal_top | dig_top_one | dig_put_take

/* A revealed card put back on top stays in the library; the reorder is its receipt. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$a_card}, count:UpTo(Constant(1))}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@back(3)), end:Top, order:Chosen}}] */
dig_reveal_top ::= "you" "may" "reveal" a_card "from" "among" "them" "and" "put" found_one "on" "top" "of" "your" "library"

/* Keeping one card on top reorders it in place; the rest exclude that reorder. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:UpTo(Constant(1))}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@prior), end:Top, order:Chosen}}] */
dig_top_one ::= "you" "may" "put" "one" "of" ("them" | "those" "cards") ("back")? "on" "top" "of" "your" "library"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$a_card}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
dig_reveal_one ::= "you" "may" "reveal" a_card "from" "among" "them" "and" "put" found_one "into" "your" "hand"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$search_filter_many}, count:UpTo($count), constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
dig_reveal_upto ::= "you" "may" "reveal" "up" "to" count search_filter_many "from" "among" "them" "and" "put" dig_found_many "into" "your" "hand"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$search_filter_many}, count:AnyNumber, constraints:[CanMoveTo{destination:OwnersHand(CardArrival{counters:[], states:[]})}]}}, Effect{result:@next, operation:Reveal{objects:Selected(@prior)}}, Effect{result:@next, operation:Move{objects:Selected(@back(3)), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
dig_reveal_any ::= "you" "may" "reveal" "any" "number" "of" search_filter_many "from" "among" "them" "and" "put" dig_found_many "into" "your" "hand"

/* @sem () */
dig_found_many ::= "them" | "those" "cards" | "the" "revealed" "cards"

/* "You may put a card" takes at most one; "put a card" takes one if there is one. */
dig_put_take ::= dig_put_may_one | dig_put_one | dig_put_upto | dig_put_any | dig_put_all | dig_put_one_each

/* "A creature card and/or a land card": up to one card of each kind. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:UpTo(Constant(2)), constraints:[OneForEach([$card_filter, $card_filter_2])]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}] */
dig_put_one_each ::= "you" "may" "put" ("a" | "an") card_filter "card" "and" "/" "or" ("a" | "an") card_filter "card" "from" "among" "them" dig_destination

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$a_card}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:$dig_destination}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}] */
dig_put_may_one ::= "you" "may" "put" a_card "from" "among" "them" dig_destination

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$a_card}, count:AsManyAsCan(Constant(1)), constraints:[CanMoveTo{destination:$dig_destination}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}] */
dig_put_one ::= "put" a_card "from" "among" "them" dig_destination

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$search_filter_many}, count:UpTo($count), constraints:[CanMoveTo{destination:$dig_destination}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}] */
dig_put_upto ::= ("you" "may")? "put" "up" "to" count search_filter_many "from" "among" "them" dig_destination

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$search_filter_many}, count:AnyNumber, constraints:[CanMoveTo{destination:$dig_destination}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:$dig_destination, qualifiers:[]}}] */
dig_put_any ::= ("you" "may")? "put" "any" "number" "of" search_filter_many "from" "among" "them" dig_destination

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$search_filter_many}, destination:$dig_destination, qualifiers:[]}}] */
dig_put_all ::= "put" "all" search_filter_many dig_all_among dig_destination

/* @sem () */
dig_all_among ::= "from" "among" "them" | "revealed" "this" "way"

dig_destination ::= until_hand | until_battlefield | look_battlefield_tapped | look_battlefield_counter

/* @sem MovementDestination::Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$counter_kind, $counter_amount]], states:[]}} */
look_battlefield_counter ::= "onto" "the" "battlefield" "with" counter_amount counter_kind "counter" "on" "it"

/* Casting removes cards from the observed library directly. The remainder is
   the observed population still in that zone, independent of cast receipts. */
/* @sem Instruction::[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$spell_filter}, count:UpTo(Constant(1)), terms:_{cost:Free}}}, Effect{result:@next, operation:$look_cast_rest}] */
look_cast_split ::= "you" "may" "cast" spell_filter "from" "among" "them" "without" "paying" "its" "mana" "cost" "." "put" look_cast_rest

/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:$library_order} */
look_cast_rest ::= "the" "rest" "on" "the" "bottom" "of" "your" "library" library_order

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$look_cast_split] */
instructions_look_cast ::= look_top "." look_cast_split

/* Reordering the chosen card does not change its zone. The other observed
   cards exclude that reorder receipt's original selected identities. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, count:$look_top_count}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:Selected(@prior), end:Top, order:Chosen}}, Effect{result:@next, operation:$rest_bottom}] */
look_top_split ::= "put" look_top_count "of" ("them" | "those" "cards") "on" "top" "of" "your" "library" "and" rest_bottom

look_top_count ::= look_top_upto | look_top_required
/* @sem Count::UpTo($number) */
look_top_upto ::= "up" "to" number
/* @sem Count::AsManyAsCan($number) */
look_top_required ::= number

/* @sem Instruction::[...$look_top_split, ...$clause_if] */
look_top_condition_split ::= look_top_split "." clause_if

/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$look_top_split] */
instructions_look_top ::= look_top "." look_top_split

/* Each phrase owns its result introductions at its own source position. This
   keeps reordering and a later cast from advancing the exile receipt early. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$a_card}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
look_exile_card ::= "you" "may" "exile" a_card "from" "among" "them"

/* @sem Instruction::[Effect{result:@next, operation:$rest_bottom}] */
look_put_remainder ::= "put" rest_bottom

/* The actual exile incarnation stays the cast operand after reordering. */
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:One(Result{result:@back(3), phase:After, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}] */
look_cast_exiled ::= "you" "may" "cast" "the" "exiled" "card" "without" "paying" "its" "mana" "cost"

/* @sem Instruction::[...$look_exile_card, ...$look_put_remainder, ...$look_cast_exiled] */
look_exile_cast_split ::= look_exile_card "." look_put_remainder "." look_cast_exiled

/* @sem Instruction::[Instruction::Effect{result:@mark, operation:Operation::RevealUntil{library:AbilityController, filter:$card_filter, count:Expr::Constant(1)}}, Instruction::Effect{result:@next, operation:Operation::Move{objects:Matching{objects:Observed(@marked), filter:$card_filter}, destination:$until_destination, qualifiers:[]}}, Instruction::Effect{result:@next, operation:$rest_bottom}] */
instructions_reveal_until ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" ("a" | "an") card_filter "card" "." "put" "that" "card" until_destination "and" rest_bottom

until_destination ::= until_hand | until_battlefield | look_battlefield_tapped

/* @sem MovementDestination::OwnersHand(CardArrival{counters:[], states:[]}) */
until_hand ::= "into" "your" "hand"
/* @sem MovementDestination::Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
until_battlefield ::= "onto" "the" "battlefield"


/* "If it's a land card, you may reveal it and put it into your hand": an optional move
   of the top card that only a matching card can make. A later sentence about putting
   the card into your hand tests that move as a payment. The payment and its action
   start on the same word, so the test names the payment by its mark. */
/* The head carries the eligibility filter; the common action retains the
   controller, reveal, destination, and result of the optional move. */
/* @sem Operation::MoveTopCard{actor:One(AbilityController), cards:$top_card_reveal_head, reveal:true, destination:OwnersHand(CardArrival{counters:[], states:[]})} */
top_card_revealed_to_hand ::= top_card_reveal_head "and" "put" "it" "into" "your" "hand"
/* @sem Instruction::[Effect{result:@next, operation:$top_card_revealed_to_hand}] */
top_card_reveal_action ::= top_card_revealed_to_hand
/* @sem Cost::Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:$top_card_reveal_action}}]} */
top_card_reveal_payment ::= top_card_reveal_action
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:$top_card_reveal_action}}] */
clause_top_card_revealed ::= top_card_reveal_action
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$top_card_reveal_payment, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:$top_reveal_branch}, otherwise:Program{}}] */
clause_top_card_revealed_declined ::= top_card_reveal_payment "." "if" "you" "don't" "put" ("it" | "the" "card") "into" "your" "hand" "," top_reveal_branch
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$top_card_reveal_payment, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_top_card_revealed_taken ::= top_card_reveal_payment "." "if" "you" "put" "a" "card" "into" "your" "hand" "this" "way" "," conjoined

/* "If it's a land card, you may put it onto the battlefield tapped": the same optional move
   without a reveal. The card enters under its owner's control. A later sentence about not
   putting it onto the battlefield, or "Otherwise", tests that move as a payment. */
/* @sem Operation::MoveTopCard{actor:One(AbilityController), cards:$card_filter, reveal:false, destination:$top_card_battlefield} */
top_card_put_onto_battlefield ::= "if" "it's" ("a" | "an") card_filter "card" "," "you" "may" "put" "it" top_card_battlefield
top_card_battlefield ::= top_card_battlefield_untapped | top_card_battlefield_tapped
/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}} */
top_card_battlefield_untapped ::= "onto" "the" "battlefield"
/* @sem MovementDestination::Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}} */
top_card_battlefield_tapped ::= "onto" "the" "battlefield" "tapped"
/* @sem Instruction::[Effect{result:@next, operation:$top_card_put_onto_battlefield}] */
top_card_put_action ::= top_card_put_onto_battlefield
/* @sem Cost::Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:$top_card_put_action}}]} */
top_card_put_payment ::= top_card_put_action
/* The look comes first in these productions, so a reveal's card is never moved this way. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:Expr::Constant(1), from:Top}}}] */
top_card_look ::= "look" "at" "the" "top" "card" "of" "your" "library" "."
/* @sem Instruction::[...$top_card_look, Optional{decider:AbilityController, body:Program{instructions:$top_card_put_action}}] */
clause_top_card_put ::= top_card_look top_card_put_action
/* Most such cards name "the card" they didn't put, so that wording outranks "it" and
   "Otherwise". */
/* @prefer always */
/* @sem Instruction::[...$top_card_look, Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$top_card_put_payment, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:$top_reveal_branch}, otherwise:Program{}}] */
clause_top_card_put_declined ::= top_card_look top_card_put_payment "." "if" "you" "don't" "put" "the" "card" "onto" "the" "battlefield" "," top_reveal_branch
/* @sem Instruction::[...$top_card_look, Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$top_card_put_payment, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:$top_reveal_branch}, otherwise:Program{}}] */
clause_top_card_put_declined_it ::= top_card_look top_card_put_payment "." "if" "you" "don't" "put" "it" "onto" "the" "battlefield" "," top_reveal_branch
/* @sem Instruction::[...$top_card_look, Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$top_card_put_payment, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:$conjoined}, otherwise:Program{}}] */
clause_top_card_put_this_way ::= top_card_look top_card_put_payment "." "if" "you" "didn't" "put" "a" "card" "onto" "the" "battlefield" "this" "way" "," conjoined
/* @sem Instruction::[...$top_card_look, Effect{result:@mark, operation:PayCost{player:AbilityController, cost:$top_card_put_payment, optional:true}}, If{condition:Not(PaymentChosen(@marked)), then:Program{instructions:$top_reveal_branch}, otherwise:Program{}}] */
clause_top_card_put_otherwise ::= top_card_look top_card_put_payment "." "otherwise" "," top_reveal_branch

/* Kinship: an optional look at the top card; if it shares a creature type with this
   creature, an optional reveal of it; and what follows only once it is revealed. Each
   optional action is a payment with its own guard, as in Wandering Graybeard. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:LookAt{player:AbilityController, objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[If{condition:ObjectMatches{object:Query{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), index:0}, filter:Shares{property:CreatureTypes, with:$self_ref}}, then:Program{instructions:[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:$kinship_revealed, otherwise:Program{}}]}, otherwise:Program{}}]}, otherwise:Program{}}] */
instructions_kinship_reveal ::= "you" "may" "look" "at" "the" "top" "card" "of" "your" "library" "." "if" "it" "shares" "a" "creature" "type" "with" self_ref "," "you" "may" "reveal" "it" "." "if" "you" "do" "," kinship_revealed

kinship_revealed ::= kinship_free_play | program

/* "You may play that card without paying its mana cost": the revealed top card. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:Either, cards:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, count:Exactly(Constant(1)), terms:_{cost:Free}}}]}}]} */
kinship_free_play ::= "you" "may" "play" "that" "card" "without" "paying" "its" "mana" "cost"

/* Choosing a card from a zone, then acting on it. */
your_zone ::= your_hand | your_graveyard

/* A resolving cast offer selects one eligible hand card; timing and the
   optional decision belong to the enclosing instruction, not to a static rule. */
/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$hand_spell_choice}, count:Exactly(Constant(1)), cost:Free} */
cast_free_hand_spell ::= "cast" hand_spell_choice "from" "your" "hand" "without" "paying" "its" "mana" "cost"
hand_spell_choice ::= spell_any | spell_filtered | spell_modified | spell_described

/* Searching one player's graveyard, hand and library for cards with a name
   and exiling them. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:$player_possessive, choices:[_{filter:Chosen(CardName), count:$name_search_count}], also:[Graveyard, Hand]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_search_name_exile ::= "search" player_possessive "graveyard" "," "hand" "," "and" "library" "for" name_search_count "cards" "with" ("that" | "the" "chosen") "name" "and" "exile" "them"
name_search_count ::= named_search_count | name_search_all

/* Searching the zones of a named object's controller for cards sharing its
   name; that controller shuffles. */
/* @sem Instruction::[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:ControllerOf($that_noun), choices:[_{filter:SharesNameWith($that_noun), count:$name_search_count}], also:[Graveyard, Hand]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(ControllerOf($that_noun))}}] */
clause_search_same_name_exile ::= "search" "its" "controller's" "graveyard" "," "hand" "," "and" "library" "for" name_search_count "cards" "with" "the" "same" "name" "as" that_noun "and" "exile" "them" "." "then" "that" "player" "shuffles"
/* @sem Count::AnyNumber */
name_search_all ::= "all"

/* A resolving cast of a target card for free. A card named by a pronoun
   needs the earlier action that names it, not this operation. */
/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:One($target_card), count:Exactly(Constant(1)), cost:Free, into_exile:false} */
cast_card_free ::= "cast" target_card "without" "paying" "its" "mana" "cost"

/* The card an exile-until stopped on, cast for free while resolving. */
/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:One($exiled_that_card), count:Exactly(Constant(1)), cost:Free, into_exile:false} */
cast_exiled_card_free ::= "cast" exiled_that_card "without" "paying" "its" "mana" "cost"
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One($exiled_that_card), from:Exile, action:CastSpell, filter:Any})], duration:$this_duration, evaluation:LiveObjects} */
cast_exiled_that_card_permission ::= "you" "may" "cast" exiled_that_card this_duration

/* A spell cast while resolving is exiled instead of going to a graveyard.
   The next sentence names that spell, so both sentences make one cast. */
/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:$affected, count:Exactly(Constant(1)), cost:Normal, into_exile:true}}]}}] */
clause_may_cast_exiled ::= "you" "may" "cast" affected "." "if" "that" "spell" "would" "be" "put" "into" ("a" | "your" | "their") "graveyard" "," "exile" "it" "instead"
/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:[Effect{result:@next, operation:PlayCards{actor:One(AbilityController), action:CastSpell, cards:$affected, count:Exactly(Constant(1)), cost:Free, into_exile:true}}]}}] */
clause_may_cast_free_exiled ::= "you" "may" "cast" affected "without" "paying" "its" "mana" "cost" "." "if" "that" "spell" "would" "be" "put" "into" ("a" | "your" | "their") "graveyard" "," "exile" "it" "instead"

/* @sem EventZone::Hand */
your_hand ::= "your" "hand"
/* @sem EventZone::Graveyard */
your_graveyard ::= "your" "graveyard"

/* Cards put from your hand into your library are chosen first, so a short
   hand puts what it has. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, count:AsManyAsCan($card_count_one)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_hand_on_top ::= "put" card_count_one "from" "your" "hand" "on" "top" "of" "your" "library"
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, count:AsManyAsCan($card_count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_hand_on_bottom ::= "put" card_count "from" "your" "hand" "on" "the" "bottom" "of" "your" "library"
/* Two or more cards go "in any order": still the owner's default library order. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, count:AsManyAsCan($count_plural)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_hand_on_top_any_order ::= "put" count_plural "cards" "from" "your" "hand" "on" "top" "of" "your" "library" "in" "any" "order"
/* Oracle puts two or more cards on the bottom "in any order". */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:Any}, count:AsManyAsCan($count_plural)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_hand_on_bottom_any_order ::= "put" count_plural "cards" "from" "your" "hand" "on" "the" "bottom" "of" "your" "library" "in" "any" "order"
/* @sem CostPart::PlayerAction{player:AbilityController, body:Program{instructions:$clause_hand_on_top}} */
cost_hand_on_top ::= clause_hand_on_top
/* Any number of cards from your hand: you choose them, then they enter together. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:AnyNumber, constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}] */
clause_hand_any_number_battlefield ::= "put" "any" "number" "of" card_filter "cards" "from" "your" "hand" "onto" "the" "battlefield"

a_card ::= a_card_any_with | a_card_any | a_card_kind | a_card_with | a_card_another | a_card_or

/* "A Mount creature card or a Plains card": either kind, each with its own noun. */
/* @sem ObjectFilter::AnyOf([$card_filter, $card_filter_2]) */
a_card_or ::= ("a" | "an") card_filter "card" "or" ("a" | "an")? card_filter "card"

/* "Another creature card from your graveyard": any but this card. */
/* @sem @and($card_filter, ObjectFilter::Not(ObjectFilter::SameObject(ObjectRef::Source))) */
a_card_another ::= "another" card_filter "card"

/* @sem ObjectFilter::Any */
a_card_any ::= "a" "card"
/* @sem $card_filter */
a_card_kind ::= ("a" | "an") card_filter "card"
/* @sem @and($card_filter, $modifiers) */
a_card_with ::= ("a" | "an") card_filter "card" modifiers

/* @sem Instruction::[Instruction::Effect{result:@mark, operation:Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:$your_zone, players:One(PlayerRef::AbilityController)}, kind:Card, filter:$a_card}, count:AsManyAsCan(Expr::Constant(1))}}, Instruction::Effect{result:@next, operation:Operation::@exiled_card_result(Operation::Move{objects:Selected(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]})}] */
/* "Exile a creature card from your graveyard. Create a token that's a copy of it.": the
   following pronoun names the one exiled card. */
clause_exile_from ::= "exile" a_card "from" your_zone

/* "Exile a card from your hand face down": you choose the cards, hidden once exiled. */
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Hand, players:One(PlayerRef::AbilityController)}, kind:Card, filter:Any}, count:AsManyAsCan($card_count)}}, Instruction::Effect{result:@next, operation:Operation::Move{objects:Selected(@marked), destination:Exile{visibility:FaceDown, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_exile_hand_face_down ::= "exile" card_count "from" "your" "hand" "face" "down"

/* @sem Instruction::[Instruction::Effect{result:@mark, operation:Operation::ChooseObjects{player:AbilityController, objects:$battlefield_card_choice, count:AsManyAsCan(Expr::Constant(1))}}, Instruction::Effect{result:@next, operation:Operation::@choice_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]})}] */
clause_put_from ::= battlefield_card_choice ("onto" | "to") "the" "battlefield" ("under" "your" "control")?

/* @sem Instruction::[Instruction::Effect{result:@mark, operation:Operation::ChooseObjects{player:AbilityController, objects:$battlefield_card_choice, count:AsManyAsCan(Expr::Constant(1))}}, Instruction::Effect{result:@next, operation:Operation::@choice_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]})}] */
clause_put_from_tapped ::= battlefield_card_choice ("onto" | "to") "the" "battlefield" "tapped" ("under" "your" "control")?

/* An Aura or Equipment card chosen this way enters attached to its host. */
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:Operation::ChooseObjects{player:AbilityController, objects:$battlefield_card_choice, count:AsManyAsCan(Expr::Constant(1))}}, Instruction::Effect{result:@next, operation:Operation::@choice_move_result(Operation::Move{objects:Selected(@marked), destination:Battlefield{controller:Player(PlayerRef::AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[AttachedTo($object_ref)]}}, qualifiers:[]})}] */
clause_put_from_attached ::= battlefield_card_choice "onto" "the" "battlefield" "attached" "to" object_ref

/* "Return an instant or sorcery card exiled with this creature to its owner's hand". */
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:Operation::ChooseObjects{player:AbilityController, objects:$resolving_card_pool, count:AsManyAsCan(Expr::Constant(1))}}, Instruction::Effect{result:@next, operation:Operation::Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_return_pool_owner_hand ::= "return" resolving_card_pool "to" "its" "owner's" "hand"

battlefield_card_choice ::= explicit_battlefield_card_choice | putting_another_card
/* @sem $resolving_card_pool */
explicit_battlefield_card_choice ::= ("put" | "return") resolving_card_pool
/* Preserve the existing put-another idiom. Returning another after sacrificing
   has a different antecedent and uses its independent receipt-aware clause. */
/* @sem ObjectSet::Zone{scope:Players{zone:$your_zone, players:One(AbilityController)}, kind:Card, filter:$a_card_another} */
putting_another_card ::= "put" a_card_another "from" your_zone

resolving_card_pool ::= own_resolving_card_pool | own_hand_or_graveyard_pool | any_graveyard_card_pool | exiled_with_card_pool
explicit_card_choice ::= a_card_any_with | a_card_any | a_card_kind | a_card_with
/* @sem ObjectSet::Zone{scope:Players{zone:$your_zone, players:One(AbilityController)}, kind:Card, filter:$explicit_card_choice} */
own_resolving_card_pool ::= explicit_card_choice "from" your_zone
/* @sem ObjectSet::Zone{scope:Players{zone:Graveyard, players:All}, kind:Card, filter:$explicit_card_choice} */
any_graveyard_card_pool ::= explicit_card_choice "from" "a" "graveyard"
/* "From your hand or graveyard": one choice among the cards of both zones. */
/* @sem ObjectSet::Union([Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$explicit_card_choice}, Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$explicit_card_choice}]) */
own_hand_or_graveyard_pool ::= explicit_card_choice "from" "your" "hand" "or" "graveyard"
/* "A creature card exiled with this permanent": one of the exiled cards linked to it. */
/* @sem ObjectSet::Zone{scope:Shared(Exile), kind:Card, filter:@and(ObjectFilter::ExiledWith($object_ref), $explicit_card_choice)} */
exiled_with_card_pool ::= explicit_card_choice "exiled" "with" object_ref

/* "Return a card you own exiled with this artifact to your hand": only your own
   cards can go to your hand. */
/* @sem Instruction::[Instruction::Effect{result:@mark, operation:Operation::ChooseObjects{player:AbilityController, objects:Zone{scope:Shared(Exile), kind:Card, filter:@and(ObjectFilter::OwnedBy(One(PlayerRef::AbilityController)), ObjectFilter::ExiledWith($object_ref), $explicit_card_choice)}, count:AsManyAsCan(Expr::Constant(1))}}, Instruction::Effect{result:@next, operation:Operation::Move{objects:Selected(@marked), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_return_owned_exiled_with ::= "return" explicit_card_choice "you" "own" "exiled" "with" object_ref "to" "your" "hand"

/* The observed hand remains the population even if another object was named
   earlier. Selection and discard refer to the same single physical card. */
/* @sem Instruction::[Effect{result:@next, operation:$hand_observation}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@back(2)), zone:Hand}, filter:@and($card_filter, ObjectFilter::OwnedBy($players_singular))}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:DiscardObjects{objects:One(Result{result:@prior, phase:After, index:0})}}] */
clause_observed_single_discard ::= hand_observation "," "you" "choose" ("a" | "one") card_filter "card" "from" "it" "," "then" players_singular "discards" "that" "card"

/* The previous action's before snapshot supplies the library, choice and
   caster. Relative addresses keep preceding effects independent of this unit. */
/* @sem Instruction::[Effect{result:@next, operation:RevealUntil{library:ControllerOf(Result{result:@prior, phase:Before, index:0}), filter:Not(CardType(Land)), count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Observed(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Optional{decider:ControllerOf(Result{result:@back(3), phase:Before, index:0}), body:Program{instructions:[Effect{result:@next, operation:PlayCards{actor:One(ControllerOf(Result{result:@back(4), phase:Before, index:0})), action:CastSpell, cards:One(Query{objects:Matching{objects:Transition{result:@prior, phase:After}, filter:Not(CardType(Land))}, index:0}), count:Exactly(Constant(1)), cost:Free}}]}}] */
controller_exile_until_cast ::= "its" "controller" "exiles" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "exile" ("a" | "one") "nonland" "card" "," "then" "they" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost"

/* Announce the player before the cards, even though Move stores that player's
   identity only in the target-card zone filter. choose is binding metadata. */
/* @sem Instruction::[@choose($shuffle_player), Effect{result:@next, operation:Move{objects:$shuffle_target_cards, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}] */
clause_shuffle_target_cards ::= shuffle_player "shuffles" shuffle_target_cards "into" "their" "library"
shuffle_player ::= target_player | target_opponent | that_player | defending_player | its_controller | its_owner

shuffle_target_cards ::= shuffle_target_card | shuffle_target_many_cards
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$shuffle_singular_count, filter:InZone(Players{zone:Graveyard, players:One(@that_player)})})) */
shuffle_target_card ::= shuffle_singular_count "target" "card" "from" "their" "graveyard"
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$shuffle_plural_count, filter:InZone(Players{zone:Graveyard, players:One(@that_player)})})) */
shuffle_target_many_cards ::= shuffle_plural_count "target" "cards" "from" "their" "graveyard"
/* @sem Count::@singular_count($target_count) */
shuffle_singular_count ::= target_count
/* @sem Count::@plural_count($target_count_any) */
shuffle_plural_count ::= target_count_any

/* Every iteration moves only its player's cards and then shuffles that library.
   The existing IR retains a singleton Union and explicit shuffle operation. */
/* @sem Instruction::[ForEachPlayer{players:$shuffle_plural_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Union([Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any})]), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}] */
clause_shuffle_graveyards ::= shuffle_plural_players "shuffles" "their" "graveyard" "into" "their" "library"
/* One player's graveyard goes into their library, then that library is shuffled. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Union([Zone(_{scope:Players{zone:Graveyard, players:One($player_ref)}, kind:Card, filter:Any})]), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One($player_ref)}}] */
clause_player_shuffles_graveyard ::= player_ref "shuffles" "their" "graveyard" "into" "their" "library"
/* A hand and graveyard go into their library together, then that library is shuffled. */
/* @sem Instruction::[ForEachPlayer{players:$shuffle_plural_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Union([Zone(_{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any})]), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}] */
clause_shuffle_hands_graveyards ::= shuffle_plural_players "shuffles" "their" "hand" "and" "graveyard" "into" "their" "library"
/* Then each of those players draws. */
/* @sem Instruction::[ForEachPlayer{players:$shuffle_plural_players, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Union([Zone(_{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}), Zone(_{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any})]), destination:Library{position:Top, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(Bound(0))}}]}}, Effect{result:@next, operation:Draw{players:$shuffle_plural_players, amount:$card_count}}] */
clause_shuffle_hands_graveyards_draw ::= shuffle_plural_players "shuffles" "their" "hand" "and" "graveyard" "into" "their" "library" "," "then" "draws" card_count
shuffle_plural_players ::= players_each | players_each_opponent | players_each_other | players_each_other_opponent

/* Names written after named denote a card name, independently of holder roles. */
/* @sem SearchChoice::SearchChoice{filter:Name(@card_name), count:UpTo(Expr::Constant(1))} */
search_named_one ::= "a" "card" "named" SELF_NAME

/* @sem SearchChoice::SearchChoice{filter:Name(@card_name), count:$named_search_count} */
search_named_many ::= named_search_count "cards" "named" SELF_NAME

named_search_count ::= named_search_upto | named_search_any
/* @sem Count::UpTo($number) */
named_search_upto ::= "up" "to" number
/* @sem Count::AnyNumber */
named_search_any ::= "any" "number" "of"

/* Card targets keep their graveyard domain, quantity and owner restrictions. */
graveyard_target_cards ::= graveyard_distinct_values_many | graveyard_typed_modified_many | graveyard_budget_one | graveyard_budget_many | graveyard_any_one | graveyard_any_many | graveyard_typed_one | graveyard_typed_many
    | graveyard_common_any_one | graveyard_common_any_many | graveyard_common_typed_one | graveyard_common_typed_many
    | graveyard_target_owner_one | graveyard_target_owner_typed_one

/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:$graveyard_scope_target}), index:0}) */
graveyard_target_owner_one ::= "target" "card" graveyard_scope_target
/* @sem ObjectSet::One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:@and($card_filter, $graveyard_scope_target)}), index:0}) */
graveyard_target_owner_typed_one ::= "target" card_filter "card" graveyard_scope_target

graveyard_target_count ::= target_count_any | graveyard_one_or_two
/* @sem Count::Between{minimum:Constant(1), maximum:Constant(2)} */
graveyard_one_or_two ::= ("one" | "1") "or" ("two" | "2")
/* @sem Count::@singular_count($graveyard_target_count) */
graveyard_singular_count ::= graveyard_target_count
/* @sem Count::@plural_count($graveyard_target_count) */
graveyard_plural_count ::= graveyard_target_count

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_singular_count, filter:$graveyard_scope})) */
graveyard_any_one ::= graveyard_singular_count "target" "card" graveyard_scope

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_plural_count, filter:$graveyard_scope})) */
graveyard_any_many ::= graveyard_plural_count "target" "cards" graveyard_scope

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_singular_count, filter:@and($card_filter, $graveyard_scope)})) */
graveyard_typed_one ::= graveyard_singular_count "target" card_filter "card" graveyard_scope

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_plural_count, filter:@and($card_filter, $graveyard_scope)})) */
graveyard_typed_many ::= graveyard_plural_count "target" card_filter "cards" graveyard_scope

/* Each announced card must satisfy the written characteristic restriction. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_plural_count, filter:@and($card_filter, @and($modifiers, $graveyard_scope))})) */
graveyard_typed_modified_many ::= graveyard_plural_count "target" card_filter "cards" modifiers graveyard_scope

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_singular_count, filter:$graveyard_common_scope, constraints:[CommonProperty(Owners)]})) */
graveyard_common_any_one ::= graveyard_singular_count "target" "card" graveyard_common_scope

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_plural_count, filter:$graveyard_common_scope, constraints:[CommonProperty(Owners)]})) */
graveyard_common_any_many ::= graveyard_plural_count "target" "cards" graveyard_common_scope

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_singular_count, filter:@and($card_filter, $graveyard_common_scope), constraints:[CommonProperty(Owners)]})) */
graveyard_common_typed_one ::= graveyard_singular_count "target" card_filter "card" graveyard_common_scope

/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_plural_count, filter:@and($card_filter, $graveyard_common_scope), constraints:[CommonProperty(Owners)]})) */
graveyard_common_typed_many ::= graveyard_plural_count "target" card_filter "cards" graveyard_common_scope

graveyard_scope ::= graveyard_scope_yours | graveyard_scope_all | graveyard_scope_any | graveyard_scope_opponents | graveyard_scope_target
/* @sem ObjectFilter::InZone(Players{zone:Graveyard, players:One(AbilityController)}) */
graveyard_scope_yours ::= ("from" | "in") "your" "graveyard"
/* @sem ObjectFilter::Any */
graveyard_scope_all ::= ("from" | "in") "graveyards"
/* Any one graveyard is still every graveyard's cards. */
/* @sem ObjectFilter::Any */
graveyard_scope_any ::= ("from" | "in") "a" "graveyard"
/* @sem ObjectFilter::InZone(Players{zone:Graveyard, players:OpponentsOf(AbilityController)}) */
graveyard_scope_opponents ::= ("from" | "in") "your" "opponents'" "graveyards"

/* The zone owner is its own announced player, independently of the card
   targets whose eligibility uses that player's graveyard. */
/* @sem ObjectFilter::InZone(Players{zone:Graveyard, players:One($target_possessive)}) */
graveyard_scope_target ::= ("from" | "in") target_possessive "graveyard"


/* One opponent's graveyard is a common owner, not an independent opponent
   choice for each targeted card. A single graveyard has the same constraint. */
graveyard_common_scope ::= graveyard_one_opponent | graveyard_one_any
/* @sem ObjectFilter::InZone(Players{zone:Graveyard, players:OpponentsOf(AbilityController)}) */
graveyard_one_opponent ::= ("from" | "in") ("an" | "one") "opponent's" "graveyard"
/* @sem ObjectFilter::Any */
graveyard_one_any ::= ("from" | "in") ("a" | "one") "single" "graveyard"

/* Library positions retain their native Expr operand in both directions. */
/* @sem Operation::Move{objects:$library_depth_objects, destination:Library{position:FromTop($library_depth), order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
put_owners_library_depth ::= "put" library_depth_objects "into" library_depth_owner "library" library_depth "from" "the" "top"

library_depth_objects ::= affected | library_depth_her
/* @sem ObjectSet::One(@it) */
library_depth_her ::= "her" | "him"

/* @sem () */
library_depth_owner ::= ("its" | "her" | "his" | "their") "owner's" | "their" "owners'"

library_depth ::= ordinal | library_depth_fourth | library_depth_fifth
/* @sem Expr::Constant(4) */
library_depth_fourth ::= "fourth"
/* @sem Expr::Constant(5) */
library_depth_fifth ::= "fifth"

/* Looking and putting back retain exactly the observed cards in that library.
   The chosen ordering belongs to the ability controller, not the library owner. */
/* @sem Instruction::[Effect{result:@mark, operation:LookAt{player:AbilityController, objects:Take{objects:Zone{scope:Players{zone:Library, players:One($reorder_library_owner)}, kind:Card, filter:Any}, count:$top_count, from:Top}}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:$reorder_library_owner, objects:InZone{objects:Observed(@marked), zone:Library}, end:Top, order:Chosen}}] */
clause_library_reorder ::= "look" "at" "the" "top" top_count "of" reorder_library_owner "library" "," "then" "put" "them" "back" "in" "any" "order"

reorder_library_owner ::= zone_your | target_possessive

/* A printed total constrains the announced target group. It is not a
   per-card property filter or a resolution-time selection. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_singular_count, filter:@and($card_filter, $budget_graveyard_scope), constraints:[$graveyard_total_constraint]})) */
graveyard_budget_one ::= graveyard_singular_count "target" card_filter "card" graveyard_total_constraint budget_graveyard_scope
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_plural_count, filter:@and($card_filter, $budget_graveyard_scope), constraints:[$graveyard_total_constraint]})) */
graveyard_budget_many ::= graveyard_plural_count "target" card_filter "cards" graveyard_total_constraint budget_graveyard_scope

/* @sem SelectionConstraint::TotalProperty{property:$stat, comparison:$bound, amount:$value} */
graveyard_total_constraint ::= "with" "total" stat value "or" bound

budget_graveyard_scope ::= graveyard_scope | budget_graveyard_that_player
/* @sem ObjectFilter::InZone(Players{zone:Graveyard, players:One(@that_player)}) */
budget_graveyard_that_player ::= ("from" | "in") "that" "player's" "graveyard"

/* "Exile cards from the top of your library until you exile a nonland card": the reveal
   stops on one card and the next instruction exiles every card it showed. The card it stopped on is the
   receipt the next instruction names. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:Operation::@exiled_card_result(Operation::Move{objects:Observed(@marked), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]})}] */
clause_exile_until_card ::= "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" ("a" | "an") card_filter "card"

/* The card it stopped on may be cast: from exile with a permission, or right away for free. */
/* @sem Instruction::[...$clause_exile_until_card, Effect{result:@next, operation:$cast_exiled_that_card_permission}] */
instructions_exile_until_permission ::= clause_exile_until_card "." cast_exiled_that_card_permission
/* @sem Instruction::[...$clause_exile_until_card, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:$cast_exiled_card_free}]}}] */
instructions_exile_until_free_cast ::= clause_exile_until_card "." "you" "may" cast_exiled_card_free

/* A receipt names the actual moved incarnation, never the pre-exile input. */
/* @sem ObjectRef::@exiled_card_reference */
exiled_card_ref ::= "it" | "that" "card"
/* After an exile-until, Oracle names the card it stopped on "that card", 10 times in 11. */
/* @sem ObjectRef::@exiled_card_reference */
exiled_that_card ::= "that" "card"

/* One player's top card establishes one actual resulting incarnation. */
exile_top_card_receipt ::= exile_top_card_player | exile_top_card_named
/* @sem Operation::@exiled_card_result(Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}) */
exile_top_card_player ::= player_ref "exiles" "the" "top" "card" "of" "their" "library"
/* "Exile the top card of that player's library": the card the event or target's player
   loses is what a later `it` or `that card` names. */
/* @sem Operation::@exiled_card_result(Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($zone_that_player)}, kind:Card, filter:Any}, count:Constant(1), from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}) */
exile_top_card_named ::= "exile" "the" "top" "card" "of" zone_that_player "library"

/* "Target opponent exiles the top three cards of their library": the acting player's own
   library. */
/* @sem Operation::Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:$top_many, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
player_exiles_top_cards ::= player_ref "exiles" "the" "top" top_many "of" "their" "library"

/* A pronoun after one revealed card ("if it's a nonland card") names that card, which
   the binder does not yet follow from a revealing player; one card keeps its own rules. */
/* @sem Operation::Reveal{objects:Take{objects:Zone{scope:Players{zone:Library, players:One($player_ref)}, kind:Card, filter:Any}, count:$top_many, from:Top}} */
player_reveals_top ::= player_ref "reveals" "the" "top" top_many "of" "their" "library"

/* "Each player reveals the top card of their library" shows one card from each library
   at once; "each opponent exiles the top card of their library" is one exile for each
   player, from that player's library. */
/* @sem Operation::Reveal{objects:LibraryTops($optional_player_population)} */
players_reveal_tops ::= optional_player_population "reveals" "the" "top" "card" "of" "their" "library"

/* @sem Instruction::[ForEachPlayer{players:$optional_player_population, binding:0, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Take{objects:Zone{scope:Players{zone:Library, players:One(Bound(0))}, kind:Card, filter:Any}, count:$top_count, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
clause_each_exiles_top ::= optional_player_population "exiles" "the" "top" top_count "of" "their" "library"

/* "Target opponent exiles a card from their hand": that player chooses the
   card, then exiles it. The exiled card is what "it" and "that card" name next. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$player_ref, objects:Zone{scope:Players{zone:Hand, players:One($player_ref)}, kind:Card, filter:Any}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Operation::@exiled_card_result(Operation::Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]})}] */
clause_player_exiles_hand ::= player_ref "exiles" "a" "card" "from" "their" "hand"

/* Each player chooses from their own hand. */
/* @sem Instruction::[ForEachPlayer{players:$optional_player_population, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}, count:AsManyAsCan($card_count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
clause_each_exiles_hand ::= optional_player_population "exiles" card_count "from" "their" "hand"

/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:$player_ref, objects:Zone{scope:Players{zone:Graveyard, players:One($player_ref)}, kind:Card, filter:Any}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:Operation::@exiled_card_result(Operation::Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]})}] */
clause_player_exiles_graveyard ::= player_ref "exiles" "a" "card" "from" "their" "graveyard"

/* @sem Instruction::[ForEachPlayer{players:$optional_player_population, binding:0, body:Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:Bound(0), objects:Zone{scope:Players{zone:Graveyard, players:One(Bound(0))}, kind:Card, filter:Any}, count:AsManyAsCan($card_count)}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}]}}] */
clause_each_exiles_graveyard ::= optional_player_population "exiles" card_count "from" "their" "graveyard"

/* After a player exiles their top card, "it's a <type> card" counts the exiled
   card with that type, as in Audacious Swap, Dimensional Infiltrator and Mind's
   Dilation. */
instructions_exiled_top_type ::= instructions_exiled_top_type_only | instructions_exiled_top_type_otherwise

/* @sem Vec<Instruction>::[Effect{result:@mark, operation:$exile_top_card_receipt}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$clause}, otherwise:Program{}}] */
instructions_exiled_top_type_only ::= exile_top_card_receipt "." "if" "it's" ("a" | "an") card_filter "card" "," clause

/* @sem Vec<Instruction>::[Effect{result:@mark, operation:$exile_top_card_receipt}, If{condition:Compare{left:CountObjects(Matching{objects:Transition{result:@marked, phase:After}, filter:$card_filter}), test:NumberTest::Compare{comparison:Greater, value:Constant(0)}}, then:Program{instructions:$clause}, otherwise:Program{instructions:$clause_2}}] */
instructions_exiled_top_type_otherwise ::= exile_top_card_receipt "." "if" "it's" ("a" | "an") card_filter "card" "," clause "." "otherwise" "," clause

/* Player and card references have independent typed scopes. */
/* @sem Operation::Move{objects:InZone{objects:One($exiled_card_ref), zone:Exile}, destination:Battlefield{controller:Player(@that_player), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]} */
exiled_card_put ::= "the" "player" "puts" exiled_card_ref "onto" "the" "battlefield"

/* @sem Operation::PlayCards{actor:One(@that_player), action:CastSpell, cards:One($exiled_card_ref), count:Exactly(Constant(1)), cost:Free} */
exiled_card_cast ::= "the" "player" "casts" exiled_card_ref "without" "paying" "its" "mana" "cost" "if" "able"

/* One owning reveal/selection/remainder span. The Card filters independently
   govern stopping and selection. The written X has one use at the reveal; its
   definition supplies that count directly. Only the final remainder is
   re-queried in Library after the Move. */
/* @sem Instruction::[Group($reveal_until_selection_program)] */
instructions_reveal_until_select_cards ::= reveal_until_selection_program

/* @sem Program::Program{instructions:[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:$card_filter, count:$value}}, Effect{result:@next, operation:WithSelections{steps:[_{binding:@selection_id(0), chooser:Players(One(AbilityController)), objects:Matching{objects:Observed(@marked), filter:$card_filter_2}, count:AnyNumber, constraints:[]}], action:Move{objects:Prepared(@selection_id(0)), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:Random}}]} */
reveal_until_selection_program ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "X" card_filter "cards" "," "where" "X" "is" value "." "put" "any" "number" "of" "those" card_filter "cards" "onto" "the" "battlefield" "," "then" "put" "the" "rest" "of" "the" "revealed" "cards" "on" "the" "bottom" "of" "your" "library" "in" "a" "random" "order"

/* The opponent is chosen before either card. Each player chooses from the
   other's graveyard; the optional single move reads both actual selections. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseValue{choosers:One(AbilityController), kind:Player, terms:_{count:Exactly(Constant(1)), options:[Players(OpponentsOf(AbilityController))]}}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Graveyard, players:One(Chosen)}, kind:Card, filter:$card_filter}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:ChooseObjects{player:Chosen, objects:Zone{scope:Players{zone:Graveyard, players:One(AbilityController)}, kind:Card, filter:$card_filter_2}, count:AsManyAsCan(Constant(1))}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:Union([Selected(@back(3)), Selected(@prior)]), destination:Battlefield{controller:Owner, arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}]}}] */
instructions_reciprocal_graveyard_choices ::= "choose" ("a" | "an") card_filter "card" "in" ("an" | "one") "opponent's" "graveyard" "," "then" "that" "player" "chooses" ("a" | "an") card_filter "card" "in" "your" "graveyard" "." "you" "may" "return" "those" "cards" "to" "the" "battlefield" "under" "their" ("owner's" | "owners'") "control"

/* @sem $modifiers */
a_card_any_with ::= "a" "card" modifiers

/* A seek is a random qualifying library selection followed by its move.
   Both instructions use fresh result addresses, including after a prefix. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$a_card}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:@seek_move_result(Operation::Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]})}] */
clause_seek_card ::= "you"? "seek" a_card

/* Seeking several qualifying cards makes one random selection of that size. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$card_filter}, count:$seek_plural_count, constraints:[AtRandom]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_seek_cards ::= "you"? "seek" seek_plural_count card_filter "cards"
/* @sem Count::AsManyAsCan(@plural_amount($number)) */
seek_plural_count ::= number

/* The named ability's exclamation mark also closes this seek sentence. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:HasKeywordFamily(StartYourEngines)}, count:AsManyAsCan(Constant(1)), constraints:[AtRandom]}}, Effect{result:@next, operation:@seek_move_result(Operation::Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]})}]} */
program_sentence_seek_engines ::= "you"? "seek" "a" "card" "with" "start" "your" "engines" "!"

/* The paired clause establishes the later card pronoun through the seek's
   moved-card marker. Child clauses retain their own lexical result positions. */
/* @sem Instruction::[...$clause_seek_card, ...$seek_delayed_discard] */
clause_seek_delayed_discard ::= clause_seek_card "." seek_delayed_discard
/* @sem Instruction::[Effect{result:@next, operation:CreateDelayedTrigger{event:Turn{point:EndStepBegins, players:All}, start:Immediately, body:Program{instructions:[Effect{result:@next, operation:DiscardObjects{objects:One($current_card_ref)}}]}}}] */
seek_delayed_discard ::= "discard" current_card_ref "at" "the" "beginning" "of" "the" "next" "end" "step"

/* The reveal choice gates both moving the top card and its later life loss.
   The amount reads the card's pre-move information, not the new top card. */
/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Reveal{objects:$your_top}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Effect{result:@mark, operation:Move{objects:$your_top, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:$top_card_life_loss_amount}}]}, otherwise:Program{}}] */
clause_optional_top_card_life ::= "you" "may" "reveal" your_top "and" "put" "it" "into" "your" "hand" "." "if" "you" "do" "," "you" "lose" top_card_life_loss_amount

/* "An opponent separates those cards into two piles. Put one pile into your hand and the
   other into your graveyard.": the piles split the cards the previous instruction
   revealed; you choose the pile for your hand, and the rest of those cards move on. */
/* @sem Instruction::[Effect{result:@next, operation:SeparatePiles{separator:OneOf(OpponentsOf(AbilityController)), chooser:AbilityController, objects:InZone{objects:Observed(@prior), zone:Library}}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
clause_opponent_piles_graveyard ::= "an" "opponent" "separates" "those" "cards" "into" "two" "piles" "." "put" "one" "pile" "into" "your" "hand" "and" "the" "other" "into" "your" "graveyard"
/* @sem Instruction::[Effect{result:@next, operation:SeparatePiles{separator:OneOf(OpponentsOf(AbilityController)), chooser:AbilityController, objects:InZone{objects:Observed(@prior), zone:Library}}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@back(4)), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, end:Bottom, order:Chosen}}] */
clause_opponent_piles_bottom ::= "an" "opponent" "separates" "those" "cards" "into" "two" "piles" "." "put" "one" "pile" "into" "your" "hand" "and" "the" "other" "on" "the" "bottom" "of" "your" "library"

/* Copying a revealed card does not move it. The final reorder retains the
   owning reveal receipt across that intervening continuous effect. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:$player_ref, filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(@zone_card_members($affected)), changes:[CopyOf{object:Query{objects:Matching{objects:Observed(@marked), filter:$card_filter}, index:0}, exceptions:[]}], duration:$duration, evaluation:Snapshot}}, Effect{result:@next, operation:ReorderLibrary{chooser:$player_ref_2, library_owner:$player_ref_2, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:$library_order}}] */
instructions_reveal_copy_reorder ::= player_ref "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" ("a" | "an") card_filter "card" "." affected "becomes" "a" "copy" "of" "that" "card" duration "." ("then")? player_ref "puts" "all" "cards" "revealed" "this" "way" "on" "the" "bottom" "of" "their" "library" library_order
/* "Target player reveals cards from the top of their library until they reveal a land
   card, then puts those cards into their graveyard": every revealed card still in that
   library is milled, the land card included. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:$player_ref, filter:$card_filter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_player_reveal_until_mill ::= player_ref "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" ("a" | "an") card_filter "card" "," "then" "puts" "those" "cards" "into" "their" "graveyard"
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:$player_ref, filter:$card_filter, count:$number}}, Effect{result:@next, operation:Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_player_reveal_until_many_mill ::= player_ref "reveals" "cards" "from" "the" "top" "of" "their" "library" "until" "they" "reveal" number card_filter "cards" "," "then" "puts" "those" "cards" "into" "their" "graveyard"

/* Choosing none is the optional action. Only actual departures are excluded
   from the observed cards still in the library. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$revealed_plural_filter}, count:AnyNumber, constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Move{objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@prior, phase:Before}])}, zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
instructions_reveal_any_battlefield_remainder ::= reveal_top "." "you" "may" "put" "any" "number" "of" revealed_plural_filter "from" "among" "them" "onto" "the" "battlefield" "." "then" "put" "all" "cards" "revealed" "this" "way" "that" "weren't" "put" "onto" "the" "battlefield" "into" "your" "graveyard"

/* The one chosen card's actual battlefield incarnation receives the grant.
   Its nested holder scope remains separate from the revealing source. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:$card_filter}, count:UpTo(Constant(1)), constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(Result{result:@prior, phase:After, index:0})), changes:$revealed_entry_grants, duration:Indefinite, evaluation:Snapshot}}, Effect{result:@next, operation:ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Difference{objects:Observed(@marked), excluding:Union([Transition{result:@back(3), phase:Before}])}, zone:Library}, end:Bottom, order:$library_order}}] */
instructions_reveal_grant_remainder ::= reveal_top "." "you" "may" "put" ("a" | "an") card_filter "card" "from" "among" "them" "onto" "the" "battlefield" "." "it" "gains" revealed_entry_grants "then" "put" "the" "rest" "of" "the" "cards" "revealed" "this" "way" "on" "the" "bottom" "of" "your" "library" library_order
top_card_life_loss_amount ::= moved_card_mana_life | life_number
/* @sem Expr::ObjectProperty{object:Query{objects:Transition{result:@marked, phase:Before}, index:0}, property:ManaValue, information:CurrentOrLastKnown} */
moved_card_mana_life ::= "life" "equal" "to" "its" "mana" "value"

/* The noun precedes `cards`; subsequent modifiers still restrict that noun. */
revealed_plural_filter ::= revealed_plural_plain | revealed_plural_modified
/* @sem $card_filter */
revealed_plural_plain ::= card_filter "cards"
/* @sem @and($card_filter, $modifiers) */
revealed_plural_modified ::= card_filter "cards" modifiers

revealed_entry_grants ::= closed_grants | revealed_terminated_grants
/* @sem $grants */
revealed_terminated_grants ::= grants "."

/* The declared two-part activation cost places its one self-discard at [1].
   Follow the performed post-cost incarnation and preserve the expected zone.
   An absent card still causes one library shuffle; drawing is unconditional. */
/* @sem Ability::Scoped{zones:[Hand], ability:@scope(Ability::Activated{origin:Ordinary, cost:Cost{parts:[Mana($mana_symbols), Discard{count:Constant(1), filter:SameObject(Source), random:false}]}, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[...$clause, If{condition:ObjectMatches{object:Query{objects:CostObjects{payment:Activation, component:[1], view:Performed, phase:After}, index:0}, filter:InZone(Players{zone:Graveyard, players:One(AbilityController)})}, then:Program{instructions:[Effect{result:@next, operation:Move{objects:One(Query{objects:CostObjects{payment:Activation, component:[1], view:Performed, phase:After}, index:0}), destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}, otherwise:Program{instructions:[Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]}}, Effect{result:@next, operation:Draw{players:One(AbilityController), amount:$card_count}}]}})} */
activated_discard_self_shuffle ::= mana_symbols "," ("↑")? "discard" "this" "card" ":" clause "." "shuffle" "this" "card" "into" "your" "library" "from" "your" "graveyard" "," "then" "draw" card_count "."

/* Exiling cards from the top of your library. */
/* @sem Operation::Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$card_count, from:Top}, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
exile_top_cards_of_your_library ::= "exile" "the" "top" card_count "of" "your" "library"

/* A following shuffle. */
/* @sem Operation::Shuffle{players:$players_singular} */
then_players_shuffle ::= "then" players_singular "shuffles"

/* The where clause owns the observed program, including later X selections.
   Bind a repeated value before looking, while preserving the look mark and
   every selection and move receipt. */
/* @sem @where(Program::Program{instructions:[Effect{result:@mark, operation:$look_top}, ...$look_where_follow]}, $value) */
program_look_where ::= ("you")? look_top "," "where" "X" "is" value "." look_where_follow

look_where_follow ::= look_put_split | dig_follow | look_cast_split | look_top_split | look_top_condition_split | look_exile_cast_split

/* Declining to look also declines the following top/bottom selection. */
/* @sem Program::Program{instructions:[Optional{decider:AbilityController, body:@where(Program::Program{instructions:[Effect{result:@mark, operation:$look_top}, ...$look_top_split]}, $value)}]} */
program_optional_look_where ::= "you" "may" look_top "," "where" "X" "is" value "." "if" "you" "do" "," look_top_split

/* @sem @where(Program::Program{instructions:[Effect{result:@mark, operation:$look_top}, Effect{result:@next, operation:$look_restore}]}, $value) */
program_look_where_restore ::= look_top "," "where" "X" "is" value "," "then" look_restore

/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Top, order:Chosen} */
look_restore ::= "put" "them" "back" "in" "any" "order"

/* A standalone look definition cannot leave later X amounts unresolved. Whole
   look/selection programs above own those uses together. */
/* @sem Operation::@look_inline(Operation::LookAt{player:AbilityController, objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:$value, from:Top}}) */
look_at_top_x_cards ::= "look" "at" "the" "top" "X" "cards" "of" "your" "library" "," "where" "X" "is" value

/* Shuffling your library. */
/* @sem Operation::Shuffle{players:One(AbilityController)} */
shuffle_your_library ::= "shuffle" "your" "library"

/* Searching your library for any cards. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:Any, count:AsManyAsCan($card_count)}]} */
search_library_for_cards ::= "search" "your" "library" "for" card_count

/* "Exile the top two cards of your library. Choose one of them.": one of the cards
   just exiled is chosen, and the permission names that card. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:$ordered_cards, destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Transition{result:@prior, phase:After}, count:AsManyAsCan(Constant(1))}}, Effect{result:@next, operation:$play_that_card_permission}] */
clause_exile_choose_one_play ::= "exile" ordered_cards "." "choose" "one" "of" "them" "." play_that_card_permission

/* Permission to play the prior card. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:Either, filter:Any})], duration:$duration, evaluation:LiveObjects} */
play_that_card_permission ::= duration "," "you" "may" "play" "that" "card"
    | "you" "may" "play" ("it" | "that" "card") ("from" "exile")? duration
/* Permission to cast the prior card. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:CastSpell, filter:Any})], duration:$duration, evaluation:LiveObjects} */
cast_that_card_permission ::= duration "," "you" "may" "cast" "that" "card"
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:CastSpell, filter:Any}, terms:_{cost:Normal, spend_as:$exiled_spending}})], duration:$duration, evaluation:LiveObjects} */
cast_that_card_permission_spending ::= duration "," "you" "may" "cast" "that" "card" "and" exiled_spending

/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One($exiled_card_ref), from:Exile, action:CastSpell, filter:Any})], duration:$this_duration, evaluation:LiveObjects} */
cast_exiled_card_permission ::= "you" "may" "cast" exiled_card_ref this_duration
/* "You may cast that card for as long as it remains exiled": the permission lasts while
   the card it names stays in exile; "it" is that card. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One($exiled_card_ref), from:Exile, action:$exiled_play_action, filter:Any})], duration:WhileExiled($exiled_card_ref), evaluation:LiveObjects} */
exiled_card_while_exiled ::= "you" "may" exiled_play_action exiled_card_ref "for" "as" "long" "as" "it" "remains" "exiled"
/* "..., and mana of any type can be spent to cast that spell": the same permission under
   spending terms. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One($exiled_card_ref), from:Exile, action:$exiled_play_action, filter:Any}, terms:_{cost:Normal, spend_as:$exiled_spending}})], duration:WhileExiled($exiled_card_ref), evaluation:LiveObjects} */
exiled_card_while_exiled_spending ::= "you" "may" exiled_play_action exiled_card_ref "for" "as" "long" "as" "it" "remains" "exiled" "," "and" exiled_spending
/* "Exile target nonland permanent. You may cast that card for as long as it remains
   exiled": that card is the one the exile just moved, whatever named it. */
/* @sem Instruction::[Effect{result:@next, operation:$exile_objects}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:$exiled_play_action, filter:Any})], duration:WhileExiled(Result{result:@prior, phase:After, index:0}), evaluation:LiveObjects}}] */
clause_exile_while_exiled ::= exile_objects "." "you" "may" exiled_play_action "that" "card" "for" "as" "long" "as" "it" "remains" "exiled"
/* @sem Instruction::[Effect{result:@next, operation:$exile_objects}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:One(Result{result:@prior, phase:After, index:0}), from:Exile, action:$exiled_play_action, filter:Any}, terms:_{cost:Normal, spend_as:$exiled_spending}})], duration:WhileExiled(Result{result:@prior, phase:After, index:0}), evaluation:LiveObjects}}] */
clause_exile_while_exiled_spending ::= exile_objects "." "you" "may" exiled_play_action "that" "card" "for" "as" "long" "as" "it" "remains" "exiled" "," "and" exiled_spending
exiled_play_action ::= exiled_cast_action | exiled_play_either
/* @sem CardPlayAction::CastSpell */
exiled_cast_action ::= "cast"
/* @sem CardPlayAction::Either */
exiled_play_either ::= "play"
exiled_spending ::= exiled_spending_any_type | exiled_spending_any_color | exiled_spending_colorless
/* @sem SpendAs::AnyType */
exiled_spending_any_type ::= "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" exiled_spell_ref
/* @sem SpendAs::AnyColor */
exiled_spending_any_color ::= "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" exiled_spell_ref
/* @sem SpendAs::ColorlessAsAnyColor */
exiled_spending_colorless ::= "you" "may" "spend" "colorless" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" exiled_spell_ref
/* @sem () */
exiled_spell_ref ::= "that" "spell" | "it"

/* "You may cast target creature card from your graveyard this turn": one target card,
   cast from the graveyard it is in. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:One($target_card_your_graveyard), from:Graveyard, action:CastSpell, filter:Any})], duration:$this_duration, evaluation:LiveObjects} */
cast_target_graveyard_permission ::= "you" "may" "cast" target_card_your_graveyard this_duration

/* Permission to play the prior cards. */
/* @sem Operation::CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermission{cards:Transition{result:@prior, phase:After}, from:Exile, action:Either, filter:Any})], duration:$duration, evaluation:LiveObjects} */
play_those_cards_permission ::= duration "," "you" "may" "play" "those" "cards"
    | "you" "may" "play" ("them" | "those" "cards") duration

/* All players finish shuffling before the draw phase. Each draw reads only
   that player's actual original cards in the aggregate shuffle receipt. */
/* @sem Instruction::[ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@mark, operation:Move{objects:Zone{scope:Players{zone:Hand, players:One(Bound(0))}, kind:Card, filter:Any}, destination:Library{position:Shuffled, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}}, ForEachPlayer{players:$players_singular, binding:0, body:Program{instructions:[Effect{result:@next, operation:Draw{players:One(Bound(0)), amount:CountObjects(MovedBy{result:@marked, phase:Before, player:Bound(0)})}}]}}] */
clause_shuffle_hands_draw ::= players_singular "shuffles" "the" "cards" "from" "their" "hand" "into" "their" "library" "," "then" "draws" "that" "many" "cards"

/* Oracle may omit the already established group after the number. */
look_hand_count ::= look_count | look_hand_count_of
/* @sem $look_count */
look_hand_count_of ::= look_count "of" ("them" | "those" "cards")

/* An unqualified search for two cards requires both when available. */
/* @sem SearchChoice::SearchChoice{filter:Any, count:AsManyAsCan(Constant(2))} */
search_two_any ::= "two" "cards"
/* Search selections retain original library identities after the hand move. */
/* @sem Instruction::[Effect{result:@mark, operation:$search_two}, ...$search_hand_other, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_search_hand_other ::= search_two "." search_hand_other "." "then" "shuffle"
/* @sem Instruction::[Effect{result:@mark, operation:$search_two}, Effect{result:@next, operation:Reveal{objects:Selected(@marked)}}, ...$search_hand_other, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}] */
instructions_search_reveal_hand_other ::= search_two "and" "reveal" "them" "." search_hand_other "." "then" "shuffle"
/* @sem Instruction::[Effect{result:@next, operation:ChooseObjects{player:AbilityController, objects:Selected(@marked), count:AsManyAsCan(Constant(1)), constraints:[]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:Move{objects:Selected(@marked), destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
search_hand_other ::= "put" "one" "into" "your" "hand" "and" "the" "other" "into" "your" "graveyard"

/* Only a pair supplies the written singular other card. */
/* @sem Operation::Search{searcher:AbilityController, library_owner:AbilityController, choices:[$search_two_choice]} */
search_two ::= "search" "your" "library" "for" search_two_choice
search_two_choice ::= search_two_any | search_two_filtered
/* @sem SearchChoice::SearchChoice{filter:$search_filter_many, count:UpTo(Constant(2))} */
search_two_filtered ::= "up" "to" "two" search_filter_many

/* With no intervening action, the same single library top is inspected and
   optionally moved. Its owner remains the independently announced player. */
/* @sem Instruction::[Effect{result:@next, operation:LookAt{player:AbilityController, objects:$looked_library_top}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Move{objects:$looked_library_top, destination:$looked_top_destination, qualifiers:[]}}]}}] */
instructions_look_one_optional_move ::= "look" "at" looked_library_top "." "you" "may" "put" "that" "card" looked_top_destination
/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One($looked_library_owner)}, kind:Card, filter:Any}, count:Constant(1), from:Top} */
looked_library_top ::= "the" "top" "card" "of" looked_library_owner "library"
looked_library_owner ::= target_possessive | possessive_defending
looked_top_destination ::= looked_top_graveyard | looked_top_bottom
/* @sem MovementDestination::OwnersGraveyard(CardArrival{counters:[], states:[]}) */
looked_top_graveyard ::= "into" looked_top_owner "graveyard"
/* @sem MovementDestination::Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}} */
looked_top_bottom ::= "on" "the" "bottom" "of" looked_top_owner "library"
/* @sem () */
looked_top_owner ::= "their" | "that" "player's"

/* A shared final card noun qualifies every subtype in this disjunction. The
   unordered filter remains printable after native canonicalization. */
/* @sem $search_subtype_list */
search_filter_subtype_list ::= search_subtype_list "card"
search_subtype_list ::= search_subtype_more | search_subtype_last
/* @sem ObjectFilter::@or($subtype, $search_subtype_list) */
search_subtype_more ::= subtype "," search_subtype_list
/* @sem ObjectFilter::@or($subtype, $subtype_2) */
search_subtype_last ::= subtype ","? "or" subtype

/* The complete search episode is a program: its final shuffle sentence cannot
   become part of an unrelated conditional's instruction prefix. */
/* @sem Program::Program{instructions:[Effect{result:@mark, operation:$search}, Effect{result:@next, operation:$found_action}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]} */
program_sentence_search_and_move ::= search "and" found_action "." "then" "shuffle" "."

/* These branches are immediately inside the explicit one-card reveal above.
   A pure condition does not move the top card; each branch names that reveal's
   actual observation. The live-query branch remains separate for unpaid
   reveal/move payments, which have supplied no observation receipt. */
observed_top_reveal_branch ::= observed_top_reveal_put | observed_top_reveal_may_put | top_reveal_draw | top_reveal_continuous | clause_you | top_reveal_you_and
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Observed(@marked), destination:$top_reveal_destination, qualifiers:[]}}] */
observed_top_reveal_put ::= "put" top_reveal_it top_reveal_destination
/* @sem Instruction::[Optional{decider:AbilityController, body:Program{instructions:$observed_top_reveal_put}}] */
observed_top_reveal_may_put ::= "you" "may" observed_top_reveal_put

/* Distinctness constrains the announced group, independently of the count. */
/* @sem ObjectSet::Targets(@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(ObjectDomain{kind:Card, zones:[Graveyard]}), count:$graveyard_plural_count, filter:$graveyard_scope, constraints:[DifferentProperty(ManaValue)]})) */
graveyard_distinct_values_many ::= graveyard_plural_count "target" "cards" "with" "different" "mana" "values" graveyard_scope

/* One bounded observation and its immediately moved top card. */
/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}, Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
reveal_top_hand_that ::= "reveal" "the" "top" "card" "of" "your" "library" "and" "put" "that" "card" "into" "your" "hand"

/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}}}, Effect{result:@next, operation:Move{objects:Take{objects:Zone(_{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:Any}), count:Constant(1), from:Top}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}] */
reveal_top_hand_it ::= "reveal" "the" "top" "card" "of" "your" "library" "and" "put" "it" "into" "your" "hand"

/* @sem Instruction::[...$reveal_top_hand_that, ...$observed_mana_gain] */
reveal_top_hand_value_gain ::= reveal_top_hand_that "." observed_mana_gain

/* @sem Instruction::[Effect{result:@next, operation:GainLife{players:One(AbilityController), amount:ObjectProperty{object:Query{objects:Observed(0), index:0}, property:ManaValue, information:CurrentOrLastKnown}}}] */
observed_mana_gain ::= "you" "gain" "life" "equal" "to" "its" "mana" "value"

/* @sem Instruction::[...$reveal_top_hand_it, ...$observed_mana_saddled] */
reveal_top_hand_value_saddled ::= reveal_top_hand_it "." observed_mana_saddled

/* @sem Instruction::[If{condition:ObjectMatches{object:$object_ref, filter:Not(State(Saddled))}, then:_{instructions:[Effect{result:@next, operation:LoseLife{players:One(AbilityController), amount:ObjectProperty{object:Query{objects:Observed(0), index:0}, property:ManaValue, information:CurrentOrLastKnown}}}]}, otherwise:_{instructions:[Effect{result:@next, operation:LoseLife{players:$players_singular, amount:ObjectProperty{object:Query{objects:Observed(0), index:0}, property:ManaValue, information:CurrentOrLastKnown}}}]}}] */
observed_mana_saddled ::= "you" "lose" "life" "equal" "to" "that" "card's" "mana" "value" "if" object_ref "isn't" "saddled" "." "otherwise" "," players_singular "loses" "that" "much" "life"

/* The owner chooses a library position; the ordinal remains an editable operand. */
/* @sem Instruction::[Effect{result:@next, operation:ChooseAction{actor:One(OwnerOf($object_ref)), options:[Program{instructions:[Effect{result:@next, operation:Move{objects:$affected, destination:Library{position:FromTop($library_depth), order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}, Program{instructions:[Effect{result:@next, operation:Move{objects:$affected, destination:Library{position:Bottom, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]}}]}]}}] */
clause_owner_library_depth_choice ::= "the" "owner" "of" object_ref "puts" affected "into" "their" "library" library_depth "from" "the" "top" "or" "on" "the" "bottom"

/* The subject owns the hand and the library; the verb supplies the destination. */
/* @sem Operation::Move{objects:Zone{scope:Players{zone:Hand, players:$players_singular}, kind:Card, filter:Any}, destination:Library{position:$hand_library_placement, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
player_hand_to_library ::= players_singular hand_library_placement

/* @sem Operation::Move{objects:Zone{scope:Players{zone:Hand, players:@subject}, kind:Card, filter:Any}, destination:Library{position:$hand_library_placement, order:DestinationDefault, arrival:CardArrival{counters:[], states:[]}}, qualifiers:[]} */
hand_to_library_third ::= hand_library_placement
/* @sem LibraryPosition::Bottom */
hand_library_bottom ::= "puts" "the" "cards" "in" "their" "hand" "on" "the" "bottom" "of" "their" "library" "in" "any" "order"
/* @sem LibraryPosition::Shuffled */
hand_library_shuffled ::= "shuffles" "their" "hand" "into" "their" "library"
hand_library_placement ::= hand_library_bottom | hand_library_shuffled

/* The count is the before receipt of this very hand-to-library move. */
/* @sem Instruction::[Effect{result:@mark, operation:@apply($player_one, $hand_to_library_third)}, Effect{result:@next, operation:Draw{players:$player_one, amount:CountObjects(Transition{result:@marked, phase:Before})}}] */
clause_hand_to_library_draw_receipt ::= player_one hand_to_library_third "," "then" "draws" "that" "many" "cards"

/* A single explicit library top is shared by the reveal and its immediate
   play continuation; both sides print from this same current operand. */
/* @sem ObjectSet::Take{objects:Zone{scope:Players{zone:Library, players:One($player_possessive)}, kind:Card, filter:Any}, count:Constant(1), from:Top} */
single_library_top ::= "the" "top" "card" "of" player_possessive "library"

/* @sem PlayAction::Either */
revealed_it_free_action ::= "play" "it" "without" "paying" "its" "mana" "cost"

/* @sem PlayAction::CastSpell */
revealed_it_free_cast ::= "cast" "it" "without" "paying" "its" "mana" "cost"

revealed_it_free ::= revealed_it_free_action | revealed_it_free_cast

/* @sem Instruction::[Effect{result:@next, operation:Reveal{objects:$single_library_top}}, Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:$revealed_it_free, cards:$single_library_top, count:Exactly(Constant(1)), terms:_{cost:Free}}}]}}] */
instructions_reveal_single_free ::= "reveal" single_library_top "." "you" "may" revealed_it_free

/* @sem ObjectFilter::Shares{property:ManaValues, with:EventSubject} */
same_event_spell_mana_value ::= "if" "the" "two" "spells" "have" "the" "same" "mana" "value"

/* @sem Instruction::[Effect{result:@mark, operation:PayCost{player:AbilityController, cost:Cost{parts:[PlayerAction{player:AbilityController, body:Program{instructions:[Effect{result:@next, operation:Reveal{objects:$single_library_top}}]}}]}, optional:true}}, If{condition:PaymentChosen(@marked), then:Program{instructions:[Optional{decider:AbilityController, body:Program{instructions:[Effect{result:@next, operation:PlayWith{actor:One(AbilityController), action:CastSpell, cards:Matching{objects:$single_library_top, filter:$same_event_spell_mana_value}, count:Exactly(Constant(1)), terms:_{cost:Free}}}]}}]}, otherwise:Program{}}] */
instructions_optional_reveal_same_value_cast ::= "you" "may" "reveal" single_library_top "." "if" "you" "do" "," "you" "may" "cast" "that" "card" "without" "paying" "its" "mana" "cost" same_event_spell_mana_value

/* Search compares against the last-known mana value of the event subject. */
/* @sem Program::Program{instructions:[Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:AbilityController, choices:[_{filter:AllOf([$card_filter, Property{property:ManaValue, test:NumberTest::Compare{comparison:Less, value:ObjectProperty{object:EventSubject, property:ManaValue, information:CurrentOrLastKnown}}}]), count:UpTo(Constant(1))}]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:true, counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(AbilityController)}}]} */
death_lesser_search_program ::= "search" "your" "library" "for" "a" card_filter "card" "with" "lesser" "mana" "value" "," "put" "it" "onto" "the" "battlefield" "tapped" "," "then" "shuffle"

/* The look supplies the exact library observation for both the separation and
   the cards left after the chosen pile moves to its owners' hands. */
/* @sem Instruction::[Effect{result:@mark, operation:$look_top}, ...$face_pile_separation, ...$face_pile_choice, Effect{result:@next, operation:$face_pile_remainder}] */
instructions_look_face_piles ::= look_top "and" face_pile_separation "." face_pile_choice "." face_pile_remainder

/* @sem Instruction::[Effect{result:@next, operation:Piles{actor:One(AbilityController), objects:InZone{objects:Observed(@marked), zone:Library}, count:Constant(2), names:['face up', 'face down']}}] */
face_pile_separation ::= "separate" "them" "into" "a" "face-down" "pile" "and" "a" "face-up" "pile"

/* @sem Instruction::[Effect{result:@next, operation:ChoosePile{actor:OpponentsOf(AbilityController), then:OwnersHand}}] */
face_pile_choice ::= "an" "opponent" "chooses" "one" "of" "those" "piles"

face_pile_remainder ::= face_pile_remainder_bottom | face_pile_remainder_graveyard

/* @sem Operation::ReorderLibrary{chooser:AbilityController, library_owner:AbilityController, objects:InZone{objects:Observed(@marked), zone:Library}, end:Bottom, order:Chosen} */
face_pile_remainder_bottom ::= "put" "the" "cards" "in" "that" "pile" "into" "your" "hand" "and" "the" "rest" "on" "the" "bottom" "of" "your" "library" "in" "any" "order"

/* @sem Operation::Move{objects:InZone{objects:Observed(@marked), zone:Library}, destination:OwnersGraveyard(CardArrival{counters:[], states:[]}), qualifiers:[]} */
face_pile_remainder_graveyard ::= "put" "that" "pile" "into" "your" "hand" "and" "the" "other" "into" "your" "graveyard"

/* Hand cast offers share the hand population while keeping their count and
   eligibility operands independent of the surrounding instruction. */
/* @sem ObjectFilter::SharesNameWithAny(FromHistory{event:Spell{event:Cast, players:All, spells:Any}, window:ThisTurn}) */
hand_spell_history_name ::= "if" "it" "has" "the" "same" "name" "as" "a" "spell" "that" "was" "cast" "this" "turn"

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:@and($hand_spell_choice, $hand_spell_history_name)}, count:Exactly(Constant(1)), cost:Free} */
cast_free_hand_qualified ::= "cast" hand_spell_choice "from" "your" "hand" "without" "paying" "its" "mana" "cost" hand_spell_history_name

/* @sem Count::UpTo($value) */
hand_cast_plural_count_up_to ::= "up" "to" value

/* @sem Count::AnyNumber */
hand_cast_plural_count_any ::= "any" "number" "of"

hand_cast_plural_count ::= hand_cast_plural_count_up_to | hand_cast_plural_count_any

/* @sem ObjectFilter::Any */
hand_cast_plural_any ::= "spells"

/* @sem $spell_adjectives */
hand_cast_plural_filtered ::= spell_adjectives "spells"

hand_cast_plural_filter ::= hand_cast_plural_any | hand_cast_plural_filtered

/* @sem Operation::PlayCards{actor:One(AbilityController), action:CastSpell, cards:Zone{scope:Players{zone:Hand, players:One(AbilityController)}, kind:Card, filter:$hand_cast_plural_filter}, count:$hand_cast_plural_count, cost:Free} */
cast_free_hand_plural ::= "you" "may" "cast" hand_cast_plural_count hand_cast_plural_filter "from" "your" "hand" "without" "paying" "their" "mana" "costs"

top_card_reveal_head ::= top_card_reveal_typed | top_card_reveal_chosen | top_card_reveal_shared | top_card_reveal_snow | top_card_reveal_legendary

/* @sem ObjectFilter::$card_filter */
top_card_reveal_typed ::= "if" "it's" ("a" | "an") card_filter "card" "," "you" "may" "reveal" "it"

/* @sem ObjectFilter::AllOf([$filter_phrase, Chosen(CreatureType)]) */
top_card_reveal_chosen ::= "if" "it's" ("a" | "an") filter_phrase "card" "of" "the" "chosen" "type" "," "you" "may" "reveal" "it"

/* @sem ObjectFilter::Shares{property:CardTypes, with:$object_ref} */
top_card_reveal_shared ::= "if" "it" "shares" "a" "card" "type" "with" object_ref "," "you" "may" "reveal" "that" "card"

/* @sem ObjectFilter::Supertype(Snow) */
top_card_reveal_snow ::= "if" "that" "card" "is" "snow" "," "you" "may" "reveal" "it"

/* @sem ObjectFilter::Supertype(Legendary) */
top_card_reveal_legendary ::= "if" "that" "card" "is" "legendary" "," "you" "may" "reveal" "it"

/* Scope the observation and both destinations together, so the remainder refers
   to the very same reveal and excludes the immediately preceding hand move. */
/* @sem Instruction::[Effect{result:@mark, operation:$reveal_top}, ...$chosen_type_reveal_split] */
chosen_type_reveal_partition ::= reveal_top "." chosen_type_reveal_split

/* @sem Instruction::[Effect{result:@next, operation:Move{objects:Matching{objects:InZone{objects:Observed(@marked), zone:Library}, filter:Chosen(CardType)}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:$rest_graveyard}] */
chosen_type_reveal_split ::= "put" "all" "cards" "of" "the" "chosen" "type" "revealed" "this" "way" "into" "your" "hand" "and" rest_graveyard

/* The stopping condition and the transferred card share the chosen filter. */
/* @sem Instruction::[Effect{result:@mark, operation:RevealUntil{library:AbilityController, filter:ChosenFilter, count:Constant(1)}}, Effect{result:@next, operation:Move{objects:Matching{objects:Observed(@marked), filter:ChosenFilter}, destination:OwnersHand(CardArrival{counters:[], states:[]}), qualifiers:[]}}, Effect{result:@next, operation:$rest_bottom}] */
chosen_kind_reveal_partition ::= "reveal" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "reveal" "a" "card" "of" "the" "chosen" "kind" "." "put" "that" "card" "into" "your" "hand" "and" rest_bottom

/* The choice and following observation are consecutive sentences in one ability. */
/* @prefer always */
/* @sem Instruction::[Effect{result:@next, operation:$choose_card_types_pair}, ...$chosen_type_reveal_partition] */
chosen_type_choice_partition ::= choose_card_types_pair "." chosen_type_reveal_partition

/* Filtered cards in the controller's library can be used as an effect subject. */
library_perpetual_subject ::= library_filtered_cards | library_topmost_filtered_card

/* @sem ObjectSet::Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$filter_phrase} */
library_filtered_cards ::= filter_phrase "cards" "in" "your" "library"

/* @sem ObjectSet::Take{objects:$library_filtered_card_set, count:Constant(1), from:Top} */
library_topmost_filtered_card ::= "the" "topmost" library_filtered_card_set

/* @sem ObjectSet::Zone{scope:Players{zone:Library, players:One(AbilityController)}, kind:Card, filter:$filter_phrase} */
library_filtered_card_set ::= filter_phrase "card" "in" "your" "library"
