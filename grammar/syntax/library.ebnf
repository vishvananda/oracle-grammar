/* @sem Program::Program{instructions:[Effect{result:@next, operation:$named_exile_target}, Effect{result:@next, operation:Search{searcher:AbilityController, library_owner:OwnerOf(Result{result:@prior, phase:After, index:0}), choices:[_{filter:SharesNameWith(Result{result:@prior, phase:After, index:0}), count:AnyNumber}], also:[Graveyard, Hand]}}, Effect{result:@next, operation:Move{objects:Selected(@prior), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]}}, Effect{result:@next, operation:Shuffle{players:One(OwnerOf(Result{result:@back(4), phase:After, index:0}))}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Players(One(AbilityController)), changes:[PlayerRule(PlayPermissionWith{permission:PlayPermission{cards:Transition{result:@back(3), phase:After}, origins:CardPlayOrigins([Exile]), action:$exiled_play_action, filter:Any}, terms:_{limit:Total(1), cost:Normal, spend_as:AnyColor}})], duration:WhileControlled{player:AbilityController, object:$self_explicit_ref}, evaluation:LiveObjects}}]} */
named_exile_search_permission_program ::= named_exile_target "." "search" "that" "player's" "graveyard" "," "hand" "," "and" "library" "for" "any" "number" "of" "cards" "with" "the" "same" "name" "as" "that" "card" "and" "exile" "them" "." "then" "that" "player" "shuffles" "." "for" "as" "long" "as" "you" "control" self_explicit_ref "," "you" "may" exiled_play_action "one" "of" "the" "exiled" "cards" "," "and" "you" "may" "spend" "mana" "as" "though" "it" "were" "mana" "of" "any" "color" "to" "cast" "it" "."

/* @sem Operation::Move{objects:One(Target{slot:@target(TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Card, zones:[Graveyard]}), count:Exactly(Constant(1)), filter:AllOf([Not(AllOf([Supertype(Basic), $noun])), InZone(Players{zone:Graveyard, players:OpponentsOf(AbilityController)})])}), index:0}), destination:Exile{visibility:FaceUp, arrival:ExileArrival{counters:[], states:[]}}, qualifiers:[]} */
named_exile_target ::= "exile" "target" "card" "other" "than" "a" "basic" noun "card" "from" "an" "opponent's" "graveyard"

/* The single revealed query is reused by the test and the subsequent cast.
   The opponent who may cast is the controller of the event spell. */
