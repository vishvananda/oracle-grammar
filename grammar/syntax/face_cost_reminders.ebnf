/* These explanations refer to a keyword's native cost; they add no operations. */
/* @sem Ability::Mechanic{mechanic:Morph, cost:$keyword_payment} */
keyword_morph ::= "morph" keyword_payment
/* @sem Ability::Mechanic{mechanic:Megamorph, cost:$keyword_payment} */
keyword_megamorph ::= "megamorph" keyword_payment
/* @sem Ability::Mechanic{mechanic:Disguise, cost:$keyword_payment} */
keyword_disguise ::= "disguise" keyword_payment
keyword_foretell ::= keyword_foretell_fixed | keyword_foretell_variable
/* @sem Ability::Mechanic{mechanic:Foretell, cost:Cost::@fixed_mana($keyword_payment)} */
keyword_foretell_fixed ::= "foretell" keyword_payment
/* @sem Ability::Mechanic{mechanic:ForetellX, cost:Cost::@variable_mana($keyword_payment)} */
keyword_foretell_variable ::= "foretell" keyword_payment
/* @sem Ability::Casting(Permission{origin:Flashback, player:OwnerOf(Source), from:Players{zone:Graveyard, players:One(OwnerOf(Source))}, require:AnyOf([CardType(Instant), CardType(Sorcery)]), cost:$keyword_payment, leave_stack:Exile}) */
keyword_flashback ::= "flashback" keyword_payment

/* @sem Ability::WithPresentation{reminder:true, ability:$face_cost_reminded_text} */
reminded_face_cost ::= face_cost_reminded_text
/* @sem Ability::WithPresentation{label:$ability_label, reminder:true, ability:$face_cost_reminded_text} */
labelled_face_cost_reminder ::= ability_label "—" face_cost_reminded_text

face_cost_reminded_text ::= morph_reminded_text | megamorph_reminded_text | disguise_reminded_text | foretell_reminded_text | flashback_reminded_text

/* @sem $keyword_morph */
morph_reminded_text ::= keyword_morph "(" face_down_cast "." "turn" "it" "face" "up" "any" "time" "for" "its" "morph" "cost" "." ")"
/* @sem $keyword_megamorph */
megamorph_reminded_text ::= keyword_megamorph "(" face_down_cast "." "turn" "it" "face" "up" "any" "time" "for" "its" "megamorph" "cost" "and" "put" "a" "+" "1" "/" "+" "1" "counter" "on" "it" "." ")"
/* @sem $keyword_disguise */
disguise_reminded_text ::= keyword_disguise "(" "you" "may" "cast" "this" "card" "face" "down" "for" "{" "3" "}" "as" "a" "2" "/" "2" "creature" "with" "ward" "{" "2" "}" "." "turn" "it" "face" "up" "any" "time" "for" "its" "disguise" "cost" "." ")"
/* @sem $keyword_foretell */
foretell_reminded_text ::= keyword_foretell "(" "during" "your" "turn" "," "you" "may" "pay" "{" "2" "}" "and" "exile" "this" "card" "from" "your" "hand" "face" "down" "." "cast" "it" "on" "a" "later" "turn" "for" "its" "foretell" "cost" "." ")"
/* @sem $keyword_flashback */
flashback_reminded_text ::= keyword_flashback "(" "you" "may" "cast" "this" "card" "from" "your" "graveyard" "for" "its" "flashback" "cost" ("and" "any" "additional" "costs")? "." "then" "exile" "it" "." ")"

/* @sem () */
face_down_cast ::= "you" "may" "cast" "this" "card" "face" "down" "as" "a" "2" "/" "2" "creature" "for" "{" "3" "}"
