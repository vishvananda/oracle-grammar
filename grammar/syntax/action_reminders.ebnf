/* Action reminders describe existing native actions. The enclosing ability
   carries one presentation flag; explanation words create no extra program. */
/* A shared game rule can be explained after several effects. The native
   operand remains part of the immediately preceding ability. */
line_contextual_reminder ::= line_contextual_group | line_measured_reminder | line_explicit_self_regeneration_reminder | line_cost_symbol_reminder | line_ward_grant_reminder | line_equip_payment_reminder | line_historic_copy_reminder | line_spent_pair_reminder | line_hexproof_indestructible_reminder | line_role_fight_reminder
/* @sem Vec<Ability>::@contextual_reminder($remindable_line, $ability_explanation) */
line_contextual_group ::= remindable_line "(" ability_explanation ")"
remindable_line ::= line_one | line_prototype | line_named_flash_if | line_pair_blocks_blocked
    | line_repeat_card_last | line_pair_enters_put | line_spell_paragraphs | line_saga | static_form_grants_goad

/* Both sentences describe the same spell-copy trigger. */
/* @sem Vec<Ability>::@contextual_reminder(@contextual_reminder($remindable_line, $historic_explanation), $token_copy_spell_rule_context_explanation) */
line_historic_copy_reminder ::= remindable_line "(" historic_explanation token_copy_spell_rule_context_explanation ")"

/* @sem Vec<Ability>::@contextual_reminder(@contextual_reminder($remindable_line, $grant_hexproof_explanation), $grant_indestructible_explanation) */
line_hexproof_indestructible_reminder ::= remindable_line "(" grant_hexproof_explanation grant_indestructible_explanation ")"

/* @sem Vec<Ability>::@contextual_reminder(@contextual_reminder($remindable_line, $monster_role_explanation), $fight_creatures_explanation) */
line_role_fight_reminder ::= remindable_line "(" monster_role_explanation fight_creatures_explanation ")"
/* @sem String::'Fight' */
fight_creatures_explanation ::= "creatures" "that" "fight" "each" "deal" "damage" "equal" "to" "their" "power" "to" "the" "other" "."

/* @sem Vec<Ability>::@ward_grant_reminder($remindable_line, $ward_grant_explanation) */
line_ward_grant_reminder ::= remindable_line "(" ward_grant_explanation ")"

/* @sem Ability::[@equip_payment_reminder($equip_reduced_line, $equip_explained_cost)] */
line_equip_payment_reminder ::= equip_reduced_line "(" equip_explained_cost ")"
equip_reduced_line ::= equip_live_reduction | keyword_equip_target_reduction | equip_conditional_activation_reduction

/* @sem Vec<Ability>::@spent_pair_reminder($remindable_line, $spent_pair_explanation) */
line_spent_pair_reminder ::= remindable_line "(" spent_pair_explanation ")"
/* @sem Operand::Cost(Cost{parts:[Mana($mana_symbols)]}) */
spent_pair_explanation ::= "do" "both" "if" mana_symbols "was" "spent" "."

/* The activation and the explanation designate the same source creature. */
/* @sem Ability::[WithPresentation{reminder:true, ability:Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateRegenerationShields{objects:One(Source)}}]}}}] */
line_explicit_self_regeneration_reminder ::= cost ":" "regenerate" "this" "creature" "." "(" self_regeneration_rule_words ")"

/* An explanation following a payment belongs to the ability's own cost. */
/* @sem Ability::[@cost_symbol_reminder($ability_cost_note_head, $cost_note)] */
line_cost_symbol_reminder ::= ability_cost_note_head cost_note
ability_cost_note_head ::= ability | keyword_equip | keyword_equip_once_word | keyword_flashback

/* The explanation repeats a numeric operand from the native action. */
/* @sem Vec<Ability>::@measured_reminder($remindable_line, $measured_explanation) */
/* @prefer always */
line_measured_reminder ::= remindable_line "(" measured_explanation ")"
measured_explanation ::= monstrosity_explanation | mill_number_explanation | incubation_explanation | discover_explanation | toxic_number_explanation
    | scry_context_amount | surveil_context_amount | surveil_defining_amount | mill_controller_explanation
    | adapt_context_amount | renown_one_explanation | renown_number_explanation | bloodthirst_one_explanation | bloodthirst_number_explanation
    | earthbend_measured_explanation | bolster_measured_explanation | amass_zombies_measured_explanation | amass_orcs_measured_explanation
    | expend_four_measured_explanation | mill_them_measured_explanation | mill_them_one_explanation | mill_any_actor_measured_explanation
    | mill_controller_one_explanation | collect_evidence_measured_explanation
    | scry_defining_one_explanation | scry_defining_many_explanation
    | firebending_granted_explanation | monstrosity_x_explanation | collect_evidence_short_explanation
    | surveil_defining_one_explanation | optional_controller_mill_explanation | optional_controller_mill_one_explanation
    | blight_measured_explanation | incubation_defining_explanation | adapt_one_explanation
    | toxic_recipient_one_explanation | toxic_group_one_explanation
/* @sem Operand::List([Text(Monstrosity), Number($number_words)]) */
monstrosity_explanation ::= "if" "this" "creature" "isn't" "monstrous" "," "put" number_words "+" "1" "/" "+" "1" "counters" "on" "it" "and" "it" "becomes" "monstrous" "."
/* @sem Operand::List([Text(Mill), Number(@agree($number_words, $number_words_2))]) */
mill_number_explanation ::= "to" "mill" number_words "cards" "," "put" "the" "top" number_words "cards" "of" "your" "library" "into" "your" "graveyard" "."
/* @sem Operand::List([Text(Incubate), Number($incubation_explanation_amount)]) */
incubation_explanation ::= incubation_explanation_amount
/* @sem Operand::List([Text(Incubate), Number(@agree($number_digits, $incubation_explanation_amount))]) */
incubation_defining_explanation ::= "to" "incubate" number_digits "," incubation_explanation_amount
/* @sem $printed_plus_one_counters */
incubation_explanation_amount ::= "create" "an" "Incubator" "token" "with" printed_plus_one_counters "on" "it" "and" '"' "{" "2" "}" ":" "transform" "this" "token" "." '"' "it" "transforms" "into" "a" "0" "/" "0" "Phyrexian" "artifact" "creature" "."
/* @sem Operand::List([Text(Discover), Number($number_digits)]) */
discover_explanation ::= "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" "a" "nonland" "card" "with" "mana" "value" number_digits "or" "less" "." discover_explanation_resolution
/* @sem Operand::List([Text(Toxic), Number($number_words)]) */
toxic_number_explanation ::= "players" "dealt" "combat" "damage" "by" "this" "creature" "also" "get" number_words "poison" "counters" "."
/* @sem Operand::List([Text(Toxic), Number(Constant(1))]) */
toxic_recipient_one_explanation ::= "players" "dealt" "combat" "damage" "by" "it" "also" "get" "a" "poison" "counter" "."
/* @sem Operand::List([Text(Toxic), Number(Constant(1))]) */
toxic_group_one_explanation ::= "players" "dealt" "combat" "damage" "by" "them" "also" "get" "a" "poison" "counter" "."
/* @sem Operand::List([Text(Scry), Number($scry_look_explanation)]) */
scry_context_amount ::= scry_look_explanation
/* @sem Operand::List([Text(Surveil), Number($surveil_look_explanation)]) */
surveil_context_amount ::= surveil_look_explanation
/* @sem Operand::List([Text(Surveil), Number(@agree($number_digits, $surveil_look_many))]) */
surveil_defining_amount ::= "to" "surveil" number_digits "," surveil_look_many
/* @sem Operand::List([Text(Surveil), Number(@agree($number_digits, $surveil_look_one_explanation))]) */
surveil_defining_one_explanation ::= "to" "surveil" number_digits "," surveil_look_one_explanation
surveil_look_one_explanation ::= surveil_look_one | surveil_look_one_named
/* @sem Operand::List([Text(ControllerMill), Number($number_words)]) */
mill_controller_explanation ::= "put" "the" "top" number_words "cards" "of" "your" "library" "into" "your" "graveyard" "."
/* @sem Operand::List([Text(OptionalControllerMill), Number($number_words)]) */
optional_controller_mill_explanation ::= "you" "may" "put" "the" "top" number_words "cards" "of" "your" "library" "into" "your" "graveyard" "."
/* @sem Operand::List([Text(OptionalControllerMill), Number(Constant(1))]) */
optional_controller_mill_one_explanation ::= "you" "may" "put" "the" "top" "card" "of" "your" "library" "into" "your" "graveyard" "."
/* @sem Operand::List([Text(Blight), Number(@agree($number_digits, $blight_explanation_counters))]) */
blight_measured_explanation ::= "to" "blight" number_digits "," "put" blight_explanation_counters "on" "a" "creature" "you" "control" "."
blight_explanation_counters ::= blight_explanation_one | blight_explanation_many
/* @sem Expr::Constant(1) */
blight_explanation_one ::= "a" "-" "1" "/" "-" "1" "counter"
/* @sem $number_words */
blight_explanation_many ::= number_words "-" "1" "/" "-" "1" "counters"
/* @sem Operand::List([Text(Adapt), Number($number_words)]) */
adapt_context_amount ::= "if" "this" "creature" "has" "no" "+" "1" "/" "+" "1" "counters" "on" "it" "," "put" number_words "+" "1" "/" "+" "1" "counters" "on" "it" "."
/* @sem Operand::List([Text(Adapt), Number(Constant(1))]) */
adapt_one_explanation ::= "if" "this" "creature" "has" "no" "+" "1" "/" "+" "1" "counters" "on" "it" "," "put" "a" "+" "1" "/" "+" "1" "counter" "on" "it" "."
/* @sem () */
renown_context_head ::= "when" "this" "creature" "deals" "combat" "damage" "to" "a" "player" "," "if" "it" "isn't" "renowned" "," "put"
/* @sem Operand::List([Text(Renown), Number(Constant(1))]) */
renown_one_explanation ::= renown_context_head "a" "+" "1" "/" "+" "1" "counter" "on" "it" "and" "it" "becomes" "renowned" "."
/* @sem Operand::List([Text(Renown), Number($number_words)]) */
renown_number_explanation ::= renown_context_head number_words "+" "1" "/" "+" "1" "counters" "on" "it" "and" "it" "becomes" "renowned" "."
/* @sem () */
bloodthirst_context_head ::= "if" "an" "opponent" "was" "dealt" "damage" "this" "turn" "," "this" "creature" "enters" "with"
/* @sem Operand::List([Text(Bloodthirst), Number(Constant(1))]) */
bloodthirst_one_explanation ::= bloodthirst_context_head "a" "+" "1" "/" "+" "1" "counter" "on" "it" "."
/* @sem Operand::List([Text(Bloodthirst), Number($number_words)]) */
bloodthirst_number_explanation ::= bloodthirst_context_head number_words "+" "1" "/" "+" "1" "counters" "on" "it" "."

/* @sem Operand::List([Text(Earthbend), Number($printed_plus_one_counters)]) */
earthbend_measured_explanation ::= "target" "land" "you" "control" "becomes" "a" "0" "/" "0" "creature" "with" "haste" "that's" "still" "a" "land" "." "put" printed_plus_one_counters "on" "it" "." "when" "it" "dies" "or" "is" "exiled" "," "return" "it" "to" "the" "battlefield" "tapped" "."

/* @sem Operand::List([Text(Bolster), Number($printed_plus_one_counters)]) */
bolster_measured_explanation ::= "choose" "a" "creature" "with" "the" "least" "toughness" "among" "creatures" "you" "control" "and" "put" printed_plus_one_counters "on" "it" "."

/* @sem Operand::List([Text(AmassZombies), Number($printed_plus_one_counters)]) */
amass_zombies_measured_explanation ::= "put" printed_plus_one_counters "on" "an" "Army" "you" "control" "." "it's" "also" "a" "Zombie" "." "if" "you" "don't" "control" "an" "Army" "," "create" "a" "0" "/" "0" "black" "Zombie" "Army" "creature" "token" "first" "."

/* @sem Operand::List([Text(AmassOrcs), Number($printed_plus_one_counters)]) */
amass_orcs_measured_explanation ::= "put" printed_plus_one_counters "on" "an" "Army" "you" "control" "." "it's" "also" "an" "Orc" "." "if" "you" "don't" "control" "an" "Army" "," "create" "a" "0" "/" "0" "black" "Orc" "Army" "creature" "token" "first" "."

/* @sem Operand::List([Text(Expend), Number(Constant(4))]) */
expend_four_measured_explanation ::= "you" "expend" "4" "as" "you" "spend" "your" "fourth" "total" "mana" "to" "cast" "spells" "during" "a" "turn" "."

/* @sem Operand::List([Text(OtherMill), Number($number_words)]) */
mill_them_measured_explanation ::= "they" "put" "the" "top" number_words "cards" "of" "their" "library" "into" "their" "graveyard" "."

/* @sem Operand::List([Text(OtherMill), Number(Constant(1))]) */
mill_them_one_explanation ::= "they" "put" "the" "top" "card" "of" "their" "library" "into" "their" "graveyard" "."

/* @sem Operand::List([Text(Mill), Number(@agree($number_words, $number_words_2))]) */
mill_any_actor_measured_explanation ::= "to" "mill" number_words "cards" "," "a" "player" "puts" "the" "top" number_words "cards" "of" "their" "library" "into" "their" "graveyard" "."

/* @sem Operand::List([Text(ControllerMill), Number(Constant(1))]) */
mill_controller_one_explanation ::= "put" "the" "top" "card" "of" "your" "library" "into" "your" "graveyard" "."

/* @sem Operand::List([Text(CollectEvidence), Number(@agree($number_digits, $number_digits_2))]) */
collect_evidence_measured_explanation ::= "to" "collect" "evidence" number_digits "," "exile" "cards" "with" "total" "mana" "value" number_digits "or" "greater" "from" "your" "graveyard" "."

/* @sem Operand::List([Text(Scry), Number(Constant(1))]) */
scry_defining_one_explanation ::= "to" "scry" "1" "," "look" "at" "the" "top" "card" "of" "your" "library" "," "then" "you" "may" "put" "that" "card" "on" "the" "bottom" "."

/* @sem Operand::List([Text(Scry), Number(@agree($number_digits, $scry_look_many))]) */
scry_defining_many_explanation ::= "to" "scry" number_digits "," scry_look_many

/* @sem Operand::List([Text(Firebending), Number(@agree($number_digits, $firebending_reminder_mana))]) */
firebending_granted_explanation ::= "whenever" "a" "creature" "with" "firebending" number_digits "attacks" "," "add" firebending_reminder_mana "." "this" "mana" "lasts" "until" "end" "of" "combat" "."

/* @sem Operand::List([Text(Monstrosity), Number($number_x)]) */
monstrosity_x_explanation ::= "if" "this" "creature" "isn't" "monstrous" "," "put" number_x "+" "1" "/" "+" "1" "counters" "on" "it" "and" "it" "becomes" "monstrous" "."

/* @sem Operand::List([Text(CollectEvidence), Number($number_digits)]) */
collect_evidence_short_explanation ::= "exile" "cards" "with" "total" "mana" "value" number_digits "or" "greater" "from" "your" "graveyard" "."

ability_explanation ::= stun_explanation | modified_explanation | historic_explanation
    | shield_explanation | venture_explanation | learn_explanation | explore_explanation
    | manifest_dread_explanation | populate_explanation | mill_explanation | goad_explanation
    | exert_explanation | party_explanation | crime_explanation | clash_explanation
    | snow_explanation | colorless_explanation | waterbend_explanation | indefinite_explanation
    | splice_explanation | overload_explanation | bargain_explanation | prototype_explanation
    | nonmana_ability_explanation | grant_keyword_explanation | additional_rule_explanations
    | context_explanations | token_context_explanations | role_explanation

additional_rule_explanations ::= ward_cant_counter_explanation | zero_even_explanation | prepared_cast_explanation
    | flashback_granted_cast_explanation | flashback_owner_cast_explanation | charge_sunburst_explanation
    | deathtouch_it_explanation | deathtouch_creature_explanation | deathtouch_dealt_it_explanation
    | lifelink_keyword_explanation | lifelink_this_explanation | trample_creature_explanation | trample_they_explanation
    | vigilance_plural_explanation | haste_plural_explanation | reach_plural_explanation
    | first_strike_plural_explanation | double_strike_plural_explanation
    | airbend_it_explanation | airbend_them_explanation | airbend_creature_explanation
    | noncreature_form_explanation | battlefield_return_explanation
    | player_hexproof_explanation | power_up_explanation | fear_plural_explanation | time_travel_explanation
    | discover_value_explanation | cloak_explanation | detain_explanation | persist_current_explanation | exalted_count_explanation
    | flash_permission_it_explanation | regeneration_it_explanation | regeneration_creature_explanation
    | banding_controller_explanation | banding_player_explanation | legendary_bands_explanation
    | exert_recipient_explanation | empty_piles_explanation | attack_declaration_cost_explanation
    | escape_grant_explanation | exiled_creature_returns_explanation
    | sticker_vowels_explanation | end_turn_explanation | end_turn_spell_explanation

/* @sem String::'StickerVowels' */
sticker_vowels_explanation ::= "the" "vowels" "are" "A" "," "E" "," "↑" "i" "," "O" "," "U" "," "and" "Y" "."

/* @sem String::'EndTheTurn' */
end_turn_explanation ::= end_turn_stack_words "." end_turn_cleanup_words
/* @sem String::'EndTurnFromSpell' */
end_turn_spell_explanation ::= end_turn_stack_words "," "including" "this" "card" "." end_turn_cleanup_words
/* @sem () */
end_turn_stack_words ::= "exile" "all" "spells" "and" "abilities" "from" "the" "stack"
/* @sem () */
end_turn_cleanup_words ::= "the" "player" "whose" "turn" "it" "is" "discards" "down" "to" "their" "maximum" "hand" "size" "." "damage" "wears" "off" "," "and" '"' "↓" "this" "turn" '"' "and" '"' "↓" "until" "end" "of" "turn" '"' "effects" "end" "."

/* @sem String::'ReturnExiledCreature' */
exiled_creature_returns_explanation ::= "that" "creature" "returns" "under" "its" "owner's" "control" "."

/* @sem String::'Escape' */
escape_grant_explanation ::= "you" "may" "cast" "cards" "from" "your" "graveyard" "for" "their" "escape" "cost" "."

/* @sem String::'Exert' */
exert_recipient_explanation ::= "it" "won't" "untap" "during" "your" "next" "untap" "step" "."
/* @sem String::'EmptyPiles' */
empty_piles_explanation ::= "piles" "can" "be" "empty" "."
/* @sem String::'AttackDeclarationCost' */
attack_declaration_cost_explanation ::= "this" "cost" "is" "paid" "as" "attackers" "are" "declared" "."

/* @sem String::'PlayerHexproof' */
player_hexproof_explanation ::= "you" "can't" "be" "the" "target" "of" "spells" "or" "abilities" "your" "opponents" "control" "."
/* @sem String::'PowerUp' */
power_up_explanation ::= power_up_explanation_head power_up_source_reduction
/* @sem () */
power_up_explanation_head ::= "activate" "each" "power-up" "ability" "only" "once" "." "reduce" "the" "cost" "by"
power_up_source_reduction ::= power_up_his_cost | power_up_her_cost | power_up_its_cost
/* @sem () */
power_up_his_cost ::= "his" "mana" "cost" "if" "he" "entered" "this" "turn" "."
/* @sem () */
power_up_her_cost ::= "her" "mana" "cost" "if" "she" "entered" "this" "turn" "."
/* @sem () */
power_up_its_cost ::= "its" "mana" "cost" "if" "it" "entered" "this" "turn" "."
/* @sem String::'Fear' */
fear_plural_explanation ::= "they" "can't" "be" "blocked" "except" "by" "artifact" "creatures" "and/or" "black" "creatures" "."
/* @sem String::'TimeTravel' */
time_travel_explanation ::= "for" "each" "suspended" "card" "you" "own" "and" "each" "permanent" "you" "control" "with" "a" "time" "counter" "on" "it" "," "you" "may" "add" "or" "remove" "a" "time" "counter" "."
/* @sem String::'Discover' */
discover_value_explanation ::= "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" "a" "nonland" "card" "with" "that" "mana" "value" "or" "less" "." discover_explanation_resolution
/* @sem () */
discover_explanation_resolution ::= "cast" "it" "without" "paying" "its" "mana" "cost" "or" "put" "it" "into" "your" "hand" "." "put" "the" "rest" "on" "the" "bottom" "in" "a" "random" "order" "."
/* @sem String::'Cloak' */
cloak_explanation ::= "to" "cloak" "a" "card" "," "put" "it" "onto" "the" "battlefield" "face" "down" "as" "a" "2" "/" "2" "creature" "with" "ward" "{" "2" "}" "." "turn" "it" "face" "up" "any" "time" "for" "its" "mana" "cost" "if" "it's" "a" "creature" "card" "."
/* @sem String::'Detain' */
detain_explanation ::= "until" "your" "next" "turn" "," "that" "creature" "can't" "attack" "or" "block" "and" "its" "activated" "abilities" "can't" "be" "activated" "."
/* @sem String::'Persist' */
persist_current_explanation ::= "when" "it" "dies" "," "if" "it" "had" "no" "-" "1" "/" "-" "1" "counters" "on" "it" "," "return" "it" "to" "the" "battlefield" "under" "its" "owner's" "control" "with" "a" "-" "1" "/" "-" "1" "counter" "on" "it" "."
/* @sem String::'Exalted' */
exalted_count_explanation ::= "whenever" "a" "creature" "you" "control" "attacks" "alone" "," "it" "gets" "+" "1" "/" "+" "1" "until" "end" "of" "turn" "for" "each" "instance" "of" "exalted" "among" "permanents" "you" "control" "."
/* @sem String::'FlashPermission' */
flash_permission_it_explanation ::= "you" "may" "cast" "it" "any" "time" "you" "could" "cast" "an" "instant" "."
/* @sem String::'RegenerationShield' */
regeneration_it_explanation ::= "the" "next" "time" "it" "would" "be" "destroyed" regeneration_effect_explanation
/* @sem String::'RegenerationShield' */
regeneration_creature_explanation ::= "the" "next" "time" "that" "creature" "would" "be" "destroyed" regeneration_effect_explanation
/* @sem () */
regeneration_effect_explanation ::= "this" "turn" "," "instead" "tap" "it" "," "remove" "it" "from" "combat" "," "and" "heal" "all" "damage" "on" "it" "."

/* @sem String::'NoncreatureForm' */
noncreature_form_explanation ::= "it's" "not" "a" "creature" "."
/* @sem String::'BattlefieldReturn' */
battlefield_return_explanation ::= "return" "it" "only" "if" "it's" "on" "the" "battlefield" "."

/* @sem String::'CounterProhibited' */
ward_cant_counter_explanation ::= "this" "includes" "by" "the" "ward" "ability" "."
/* @sem String::'Parity' */
zero_even_explanation ::= "zero" "is" "even" "."
/* @sem String::'PreparedSource' */
prepared_cast_explanation ::= "while" "it's" "prepared" "," "you" "may" "cast" "a" "copy" "of" "its" "spell" "." "doing" "so" "unprepares" "it" "."
/* @sem String::'Flashback' */
flashback_granted_cast_explanation ::= "you" "may" "cast" "that" "card" "from" "your" "graveyard" "for" "its" "flashback" "cost" "." "then" "exile" "it" "."
/* @sem String::'FlashbackAtManaCost' */
flashback_owner_cast_explanation ::= "its" "owner" "may" "cast" "the" "card" "from" "their" "graveyard" "for" "its" "mana" "cost" "." "then" "they" "exile" "it" "."
/* @sem String::'Sunburst' */
charge_sunburst_explanation ::= "this" "artifact" "enters" "with" "a" "charge" "counter" "on" "it" "for" "each" "color" "of" "mana" "spent" "to" "cast" "it" "."
/* @sem String::'Deathtouch' */
deathtouch_it_explanation ::= "any" "amount" "of" "damage" "it" "deals" "to" "a" "creature" "is" "enough" "to" "destroy" "that" "creature" "."
/* @sem String::'Deathtouch' */
deathtouch_creature_explanation ::= "any" "amount" "of" "damage" "a" "creature" "with" "deathtouch" "deals" "to" "a" "creature" "is" "enough" "to" "destroy" "it" "."
/* @sem String::'Deathtouch' */
deathtouch_dealt_it_explanation ::= "any" "amount" "of" "damage" "a" "creature" "with" "deathtouch" "deals" "to" "a" "creature" "is" "enough" "to" "destroy" "that" "creature" "."
/* @sem String::'Lifelink' */
lifelink_keyword_explanation ::= "damage" "dealt" "by" "a" "creature" "with" "lifelink" "also" "causes" "its" "controller" "to" "gain" "that" "much" "life" "."
/* @sem String::'Lifelink' */
lifelink_this_explanation ::= "damage" "dealt" "by" "this" "creature" "also" "causes" "you" "to" "gain" "that" "much" "life" "."
/* @sem String::'Trample' */
trample_creature_explanation ::= "a" "creature" "with" "trample" "can" "deal" "excess" "combat" "damage" "to" "the" "player" "or" "planeswalker" "it's" "attacking" "."
/* @sem String::'Trample' */
trample_they_explanation ::= "each" "of" "those" "creatures" "can" "deal" "excess" "combat" "damage" "to" "the" "player" "or" "planeswalker" "it's" "attacking" "."
/* @sem String::'Vigilance' */
vigilance_plural_explanation ::= "attacking" "doesn't" "cause" "them" "to" "tap" "."
/* @sem String::'Haste' */
haste_plural_explanation ::= "they" "can" "attack" "and" "{" "T" "}" "as" "soon" "as" "they" "come" "under" "your" "control" "."
/* @sem String::'Reach' */
reach_plural_explanation ::= "they" "can" "block" "creatures" "with" "flying" "."
/* @sem String::'FirstStrike' */
first_strike_plural_explanation ::= "they" "deal" "combat" "damage" "before" "creatures" "without" "first" "strike" "."
/* @sem String::'DoubleStrike' */
double_strike_plural_explanation ::= "they" "deal" "both" "first-strike" "and" "regular" "combat" "damage" "."
/* @sem String::'AirbendOne' */
airbend_it_explanation ::= "exile" "it" "." "while" "it's" "exiled" "," airbend_explanation_cost
/* @sem String::'AirbendMany' */
airbend_them_explanation ::= "exile" "them" "." "while" "each" "one" "is" "exiled" "," airbend_explanation_cost
/* @sem String::'AirbendRule' */
airbend_creature_explanation ::= "to" "airbend" "a" "creature" "," "exile" "it" "." "while" "it's" "exiled" "," airbend_explanation_cost
/* @sem () */
airbend_explanation_cost ::= "its" "owner" "may" "cast" "it" "for" "{" "2" "}" "rather" "than" "its" "mana" "cost" "."
/* @sem String::'Stun' */
stun_explanation ::= "if" "a" "permanent" "with" "a" "stun" "counter" "would" "become" "untapped" "," "remove" "one" "from" "it" "instead" "."
/* @sem String::'Modified' */
modified_explanation ::= "Equipment" "," "↑" "auras" "you" "control" "," "and" "counters" "are" "modifications" "."
/* @sem String::'Historic' */
historic_explanation ::= "artifacts" "," "legendaries" "," "and" "Sagas" "are" "historic" "."
/* @sem String::'Shield' */
shield_explanation ::= "if" "it" "would" "be" "dealt" "damage" "or" "destroyed" "," "remove" "a" "shield" "counter" "from" "it" "instead" "."
/* @sem String::'Venture' */
venture_explanation ::= "enter" "the" "first" "room" "or" "advance" "to" "the" "next" "room" "."
/* @sem String::'Learn' */
learn_explanation ::= "you" "may" "reveal" "a" "Lesson" "card" "you" "own" "from" "outside" "the" "game" "and" "put" "it" "into" "your" "hand" "," "or" "discard" "a" "card" "to" "draw" "a" "card" "."
/* @sem String::'Explore' */
explore_explanation ::= "reveal" "the" "top" "card" "of" "your" "library" "." "put" "that" "card" "into" "your" "hand" "if" "it's" "a" "land" "." "otherwise" "," "put" "a" "+" "1" "/" "+" "1" "counter" "on" "this" "creature" "," "then" "put" "the" "card" "back" "or" "put" "it" "into" "your" "graveyard" "."
/* @sem String::'ManifestDread' */
manifest_dread_explanation ::= "look" "at" "the" "top" "two" "cards" "of" "your" "library" "." "put" "one" "onto" "the" "battlefield" "face" "down" "as" "a" "2" "/" "2" "creature" "and" "the" "other" "into" "your" "graveyard" "." "turn" "it" "face" "up" "any" "time" "for" "its" "mana" "cost" "if" "it's" "a" "creature" "card" "."
/* @sem String::'Populate' */
populate_explanation ::= "create" "a" "token" "that's" "a" "copy" "of" "a" "creature" "token" "you" "control" "."
/* @sem String::'Mill' */
mill_explanation ::= "to" "mill" "a" "card" "," "put" "the" "top" "card" "of" "your" "library" "into" "your" "graveyard" "."
/* @sem String::'Goad' */
goad_explanation ::= "until" "your" "next" "turn" "," "that" "creature" "attacks" "each" "combat" "if" "able" "and" "attacks" "a" "player" "other" "than" "you" "if" "able" "."
/* @sem String::'Exert' */
exert_explanation ::= "an" "exerted" "creature" "won't" "untap" "during" "your" "next" "untap" "step" "."
/* @sem String::'Party' */
party_explanation ::= "your" "party" "consists" "of" "up" "to" "one" "each" "of" "Cleric" "," "Rogue" "," "Warrior" "," "and" "Wizard" "."
/* @sem String::'Crime' */
crime_explanation ::= "targeting" "opponents" "," "anything" "they" "control" "," "and/or" "cards" "in" "their" "graveyards" "is" "a" "crime" "."
/* @sem String::'Clash' */
clash_explanation ::= "each" "clashing" "player" "reveals" "the" "top" "card" "of" "their" "library" "," "then" "puts" "that" "card" "on" "their" "choice" "of" "the" "top" "or" "bottom" "." "a" "player" "wins" "if" "their" "card" "had" "a" "greater" "mana" "value" "."
/* @sem String::'Snow' */
snow_explanation ::= snow_explanation_words | snow_mana_explanation_words
/* @sem () */
snow_explanation_words ::= "{" "S" "}" "can" "be" "paid" "with" "one" "mana" "from" "a" "snow" "source" "."
/* @sem () */
snow_mana_explanation_words ::= "{" "S" "}" "is" "mana" "from" "a" "snow" "source" "."
/* @sem String::'ColorlessMana' */
colorless_explanation ::= colorless_explanation_words
/* @sem () */
colorless_explanation_words ::= "{" "C" "}" "represents" "colorless" "mana" "."
/* @sem String::'Waterbend' */
waterbend_explanation ::= "while" "paying" "a" "waterbend" "cost" "," "you" "can" "tap" "your" "artifacts" "and" "creatures" "to" "help" "." "each" "one" "pays" "for" "{" "1" "}" "."
/* @sem String::'Indefinite' */
indefinite_explanation ::= "this" "effect" "lasts" "indefinitely" "."
/* @sem String::'SpliceArcane' */
splice_explanation ::= "as" "you" "cast" "an" "Arcane" "spell" "," "you" "may" "reveal" "this" "card" "from" "your" "hand" "and" "pay" "its" "splice" "cost" "." "if" "you" "do" "," "add" "this" "card's" "effects" "to" "that" "spell" "."
/* @sem String::'Overload' */
overload_explanation ::= "you" "may" "cast" "this" "spell" "for" "its" "overload" "cost" "." "if" "you" "do" "," "change" '"' "↓" "target" '"' "in" "its" "text" "to" '"' "↓" "each" "." '"'
/* @sem String::'Bargain' */
bargain_explanation ::= "you" "may" "sacrifice" "an" "artifact" "," "enchantment" "," "or" "token" "as" "you" "cast" "this" "spell" "."
/* @sem String::'Prototype' */
prototype_explanation ::= "you" "may" "cast" "this" "spell" "with" "different" "mana" "cost" "," "color" "," "and" "size" "." "it" "keeps" "its" "abilities" "and" "types" "."
/* @sem String::'TargetedAbility' */
nonmana_ability_explanation ::= "mana" "abilities" "can't" "be" "targeted" "."

/* The same reminder wording can follow an ability that grants the keyword. */
grant_keyword_explanation ::= grant_indestructible_explanation | grant_menace_explanation
    | grant_hexproof_explanation | grant_shroud_explanation | grant_trample_explanation
    | grant_fear_explanation | grant_deathtouch_explanation | grant_lifelink_explanation
    | grant_haste_explanation | grant_flying_explanation | grant_vigilance_explanation
    | grant_first_strike_explanation | grant_double_strike_explanation | grant_reach_explanation
    | grant_reach_creature_explanation | grant_reach_creatures_explanation
/* @sem String::'Indestructible' */
grant_indestructible_explanation ::= reminder_indestructible
/* @sem String::'Menace' */
grant_menace_explanation ::= reminder_menace
/* @sem String::'Hexproof' */
grant_hexproof_explanation ::= reminder_hexproof
/* @sem String::'Shroud' */
grant_shroud_explanation ::= reminder_shroud
/* @sem String::'Trample' */
grant_trample_explanation ::= reminder_trample
/* @sem String::'Fear' */
grant_fear_explanation ::= reminder_fear
/* @sem String::'Deathtouch' */
grant_deathtouch_explanation ::= reminder_deathtouch
/* @sem String::'Lifelink' */
grant_lifelink_explanation ::= reminder_lifelink
/* @sem String::'Haste' */
grant_haste_explanation ::= reminder_haste
/* @sem String::'Flying' */
grant_flying_explanation ::= reminder_flying
/* @sem String::'Vigilance' */
grant_vigilance_explanation ::= reminder_vigilance
/* @sem String::'FirstStrike' */
grant_first_strike_explanation ::= reminder_first_strike
/* @sem String::'DoubleStrike' */
grant_double_strike_explanation ::= reminder_double_strike
/* @sem String::'Reach' */
grant_reach_explanation ::= "it" reach_blockers "."
/* @sem String::'Reach' */
grant_reach_creature_explanation ::= "a" "creature" "with" "reach" reach_blockers "."
/* @sem String::'Reach' */
grant_reach_creatures_explanation ::= "creatures" "with" "reach" reach_blockers "."

/* @sem Ability::WithPresentation{reminder:true, ability:$action_reminder_ability} */
reminded_action_ability ::= action_reminder_ability
/* @sem Ability::WithPresentation{label:$ability_label, reminder:true, ability:$action_reminder_ability} */
labelled_action_reminder ::= ability_label "—" action_reminder_ability

action_reminder_ability ::= reminder_spell | reminder_activated | reminder_activated_limited | reminder_activated_trailing
    | reminder_triggered | reminder_triggered_if | reminder_triggered_once
    | reminder_turn | reminder_turn_if | reminder_spell_modal | reminder_activated_modal
    | reminder_triggered_modal | reminder_turn_modal | reminder_loyalty | reminder_spell_ascend

/* @sem Ability::Spell{announcement:@announcement, body:$reminder_program_sentence} */
reminder_spell ::= reminder_program_sentence
/* The spell performs ascend before continuing with the rest of its program. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$ascend_instruction, ...$instructions]}} */
reminder_spell_ascend ::= ascend_instruction ascend_explanation NEWLINE instructions "."
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$reminder_program_sentence} */
reminder_activated ::= cost ":" reminder_program_sentence
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:$reminder_program_sentence} */
reminder_activated_limited ::= cost ":" reminder_program_sentence activation_limits "."
/* A trailing explanation can follow an activation restriction. Its action
   operand is still explicit, so it cannot attach to an unrelated program. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$proliferate_action}]}} */
reminder_activated_trailing ::= cost ":" proliferate_action "." activation_limits "." "(" proliferate_explanation "." ")"
/* @sem Ability::Activated{origin:Ordinary, cost:_{parts:[Loyalty($loyalty_heading)]}, limits:_{sorcery:true}, announcement:@announcement, body:$reminder_program_sentence} */
reminder_loyalty ::= loyalty_heading ":" reminder_program_sentence
/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$reminder_program_sentence} */
reminder_triggered ::= event_clause "," reminder_program_sentence
/* @sem Ability::Triggered{event:$event_clause, intervening_if:$condition, limits:_{}, announcement:@announcement, body:$reminder_program_sentence} */
reminder_triggered_if ::= event_clause "," "if" condition "," reminder_program_sentence
/* @sem Ability::Triggered{event:$event_clause, limits:_{per_turn:1}, announcement:@announcement, body:$reminder_program_sentence} */
reminder_triggered_once ::= event_clause "," reminder_program_sentence "this" "ability" "triggers" "only" "once" "each" "turn" "."
/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$reminder_program_sentence} */
reminder_turn ::= "at" turn_event "," reminder_program_sentence
/* @sem Ability::Triggered{event:$turn_event, intervening_if:$condition, limits:_{}, announcement:@announcement, body:$reminder_program_sentence} */
reminder_turn_if ::= "at" turn_event "," "if" condition "," reminder_program_sentence

/* Each program contains at least one closed reminder, including in a mode.
   Ordinary clauses on either side retain their order, definitions and targets. */
/* @sem Program::Program{instructions:$reminder_instructions} */
reminder_program_sentence ::= reminder_instructions
reminder_instructions ::= reminder_closed | reminder_before | reminder_closed_before
    | reminder_after_plain | reminder_after_reminder | reminder_open_then_plain | reminder_open_then_reminder
reminder_before ::= reminder_before_period | reminder_before_then | reminder_before_line
/* @sem Instruction::[...$clause, ...$reminder_instructions] */
reminder_before_period ::= clause sequencer reminder_instructions
/* @sem Instruction::[...$instructions, ...$reminder_instructions] */
reminder_before_line ::= instructions "." NEWLINE reminder_instructions
/* @sem Vec<Instruction>::@then_sequence($clause_before_then, $reminder_instructions) */
reminder_before_then ::= clause_before_then "," "then" reminder_instructions
/* @sem Instruction::[...$clause_closed, ...$reminder_instructions] */
reminder_closed_before ::= clause_closed "." NEWLINE? reminder_instructions
/* @sem Instruction::[...$reminder_closed, ...$instructions] */
reminder_after_plain ::= reminder_closed NEWLINE? instructions "."
/* @sem Instruction::[...$reminder_closed, ...$reminder_instructions] */
reminder_after_reminder ::= reminder_closed NEWLINE? reminder_instructions

/* @sem Instruction::[...$reminder_open, ...$instructions] */
reminder_open_then_plain ::= reminder_open (sequencer | "," "then") instructions "."
/* @sem Instruction::[...$reminder_open, ...$reminder_instructions] */
reminder_open_then_reminder ::= reminder_open (sequencer | "," "then") reminder_instructions
/* @sem $reminder_open */
reminder_open_closed ::= reminder_open "."

reminder_closed ::= limited_mana_cost_spending_reminded | reminder_open_closed | proliferate_reminded | proliferate_twice_reminded | proliferate_pair_reminded
    | scry_reminded | surveil_reminded | investigate_reminded | named_token_reminded | fight_reminded
    | reminder_if | reminder_optional | reminder_paid | support_reminded
/* @sem Instruction::[@leading_if(Instruction::If{condition:$condition, then:_{instructions:$reminder_closed}, otherwise:_{}})] */
reminder_if ::= "if" condition "," reminder_closed
/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:$reminder_closed}}] */
reminder_optional ::= "you" "may" reminder_closed
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:_{instructions:$reminder_closed}, otherwise:_{}}] */
reminder_paid ::= "you" "may" payment "." "if" "you" "do" "," reminder_closed

/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Targets(@target($support_explained_target))), kind:PowerToughness([1, 1]), amount:Constant(1)}]}}] */
support_reminded ::= "support" support_explained_target
/* @sem TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(@agree($number, $support_explained_count)), filter:@support_filter($support_explained_creatures)} */
support_explained_target ::= number "." "(" "put" "a" "+" "1" "/" "+" "1" "counter" "on" "each" "of" "up" "to" support_explained_count support_explained_creatures "." ")"
support_explained_count ::= number_words | number_x
support_explained_creatures ::= support_other_creatures | support_any_creatures
/* @sem bool::true */
support_other_creatures ::= "other" "target" "creatures"
/* @sem bool::false */
support_any_creatures ::= "target" "creatures"

/* A single application uses the native absent amount. Explicit repeated
   applications retain an amount, rather than expanding the explanation. */
proliferate_action ::= proliferate_once_action | proliferate_twice_action | proliferate_count_action
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Proliferate{}} */
proliferate_once_action ::= "proliferate"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Proliferate{times:Constant(2)}} */
proliferate_twice_action ::= "proliferate" "twice" | "proliferate" "," "then" "proliferate" "again"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Proliferate{times:$number}} */
proliferate_count_action ::= "proliferate" number "times"
/* @sem Instruction::[Effect{result:@next, operation:$proliferate_action}] */
proliferate_reminded ::= proliferate_action "." "(" proliferate_explanation "." ")"
/* @sem Instruction::[Effect{result:@next, operation:$proliferate_twice_action}] */
proliferate_twice_reminded ::= proliferate_twice_action "." "(" proliferate_explanation "." "then" "do" "it" "again" "." ")"
/* @sem $proliferate_pair */
proliferate_pair_reminded ::= proliferate_pair "." "(" proliferate_explanation "." ("then" "do" "it" "again" ".")? ")"
/* @sem () */
proliferate_explanation ::= ("to" "proliferate" ",")? "choose" "any" "number" "of" "permanents" "and/or" "players" "," "then" "give" "each" "another" "counter" "of" "each" "kind" "already" "there"

/* The numeral and the reminder's written count must agree in both directions. */
/* @sem Instruction::[Effect{result:@next, operation:Scry{players:One(AbilityController), amount:@agree($number, $scry_look_explanation)}}] */
scry_reminded ::= "scry" number "." "(" scry_look_explanation ")"
scry_look_explanation ::= scry_look_one | scry_look_many
/* @sem Expr::Constant(1) */
scry_look_one ::= "look" "at" "the" "top" "card" "of" "your" "library" "." "you" "may" "put" "that" "card" "on" "the" "bottom" "."
/* @sem $number_words */
scry_look_many ::= "look" "at" "the" "top" number_words "cards" "of" "your" "library" "," "then" "put" "any" "number" "of" "them" "on" "the" "bottom" "and" "the" "rest" "on" "top" "in" "any" "order" "."

/* @sem Instruction::[Effect{result:@next, operation:Surveil{players:One(AbilityController), amount:@agree($number, $surveil_look_explanation)}}] */
surveil_reminded ::= "surveil" number "." "(" surveil_look_explanation ")"
surveil_look_explanation ::= surveil_look_one | surveil_look_one_named | surveil_look_many
/* @sem Expr::Constant(1) */
surveil_look_one ::= "look" "at" "the" "top" "card" "of" "your" "library" "." "you" "may" "put" "it" "into" "your" "graveyard" "."
/* @sem Expr::Constant(1) */
surveil_look_one_named ::= "look" "at" "the" "top" "card" "of" "your" "library" "." "you" "may" "put" "that" "card" "into" "your" "graveyard" "."
/* @sem $number_words */
surveil_look_many ::= "look" "at" "the" "top" number_words "cards" "of" "your" "library" "," "then" "put" "any" "number" "of" "them" "into" "your" "graveyard" "and" "the" "rest" "on" "top" ("of" "your" "library")? "in" "any" "order" "."

/* @sem Instruction::[Effect{result:@next, operation:$fight_action}] */
fight_reminded ::= fight_action "." "(" "each" "deals" "damage" "equal" "to" "its" "power" "to" "the" "other" "." ")"

/* @sem Instruction::[Effect{result:@next, operation:$investigate_once}] */
investigate_reminded ::= investigate_once "." "(" "create" "a" "Clue" "token" "." clue_explanation ")"
/* The receipt and token's activated abilities come from the existing recipe.
   The recognized explanation contributes no extra instructions. */
/* @sem Instruction::[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$reminded_token_batch], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
named_token_reminded ::= "create" reminded_token_batch
reminded_token_batch ::= reminded_token_single | reminded_token_multiple
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:Rules, recipe:$reminded_named_token} */
reminded_token_single ::= "a" reminded_named_token
/* @sem TokenSpec::TokenSpec{amount:@plural_amount($token_amount), words:Rules, recipe:$reminded_named_tokens} */
reminded_token_multiple ::= token_amount reminded_named_tokens

reminded_named_token ::= reminded_treasure_token | reminded_food_token | reminded_clue_token | reminded_blood_token
/* @sem $tn_treasure */
reminded_treasure_token ::= tn_treasure "token" "." "(" "it's" "an" "artifact" "with" treasure_reminder_cost ")"
/* @sem $tn_food */
reminded_food_token ::= tn_food "token" "." "(" "it's" "an" "artifact" "with" food_reminder_cost ")"
/* @sem $tn_clue */
reminded_clue_token ::= tn_clue "token" "." "(" clue_explanation ")"
/* @sem $tn_blood */
reminded_blood_token ::= tn_blood "token" "." "(" "it's" "an" "artifact" "with" '"' "{" "1" "}" "," "{" "T" "}" "," "↑" "discard" "a" "card" "," "↑" "sacrifice" "this" "token" ":" "draw" "a" "card" "." '"' ")"
/* @sem () */
clue_explanation ::= "it's" "an" "artifact" "with" clue_reminder_cost

reminded_named_tokens ::= reminded_treasure_tokens | reminded_food_tokens | reminded_clue_tokens
/* @sem $tn_treasure */
reminded_treasure_tokens ::= tn_treasure "tokens" "." "(" "they're" "artifacts" "with" treasure_reminder_cost ")"
/* @sem $tn_food */
reminded_food_tokens ::= tn_food "tokens" "." "(" "they're" "artifacts" "with" food_reminder_cost ")"
/* @sem $tn_clue */
reminded_clue_tokens ::= tn_clue "tokens" "." "(" "they're" "artifacts" "with" clue_reminder_cost ")"
/* @sem () */
treasure_reminder_cost ::= '"' "{" "T" "}" "," "↑" "sacrifice" "this" ("token" | "artifact") ":" "add" "one" "mana" "of" "any" "color" "." '"'
/* @sem () */
food_reminder_cost ::= '"' "{" "2" "}" "," "{" "T" "}" "," "↑" "sacrifice" "this" ("token" | "artifact") ":" "you" "gain" "3" "life" "." '"'
/* @sem () */
clue_reminder_cost ::= '"' "{" "2" "}" "," "↑" "sacrifice" "this" ("token" | "artifact") ":" "draw" "a" "card" "." '"'

/* The mode list has at least one reminder-bearing mode. Plain modes keep their
   own scopes; the presentation belongs to the complete modal ability. */
/* @sem Ability::Spell{announcement:_{modes:$reminder_mode_selection}, body:_{}} */
reminder_spell_modal ::= reminder_mode_selection
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:_{modes:$reminder_mode_selection}, body:_{}} */
reminder_activated_modal ::= cost ":" reminder_mode_selection
/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:_{modes:$reminder_mode_selection}, body:_{}} */
reminder_triggered_modal ::= event_clause "," reminder_mode_selection
/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:_{modes:$reminder_mode_selection}, body:_{}} */
reminder_turn_modal ::= "at" turn_event "," reminder_mode_selection
reminder_mode_selection ::= reminder_choose_number | reminder_choose_both | reminder_choose_more
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$reminder_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
reminder_choose_number ::= "choose" number_words "—" NEWLINE reminder_modes
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(2)}, options:$reminder_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
reminder_choose_both ::= "choose" "one" "or" "both" "—" NEWLINE reminder_modes
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:@length($reminder_modes)}, options:$reminder_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
reminder_choose_more ::= "choose" "one" "or" "more" "—" NEWLINE reminder_modes
/* @sem @scope(Mode::Mode{announcement:@announcement, body:$reminder_program_sentence, weight:1}) */
reminder_mode ::= "•" reminder_program_sentence
reminder_modes ::= reminder_mode_one | reminder_modes_before | reminder_modes_after | reminder_modes_multiple
/* @sem Mode::[$reminder_mode] */
reminder_mode_one ::= reminder_mode
/* @sem Mode::[$mode, ...$reminder_modes] */
reminder_modes_before ::= mode NEWLINE reminder_modes
/* @sem Mode::[$reminder_mode, ...$modes] */
reminder_modes_after ::= reminder_mode NEWLINE modes
/* @sem Mode::[$reminder_mode, ...$reminder_modes] */
reminder_modes_multiple ::= reminder_mode NEWLINE reminder_modes

/* Explicitly repeating the instruction also retains the native two-effect
   reading. The counted native form above remains a distinct reading. */
/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Proliferate{}}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Proliferate{}}}] */
proliferate_pair ::= "proliferate" "," "then" "proliferate" "again"


/* North Star's reminder restates the payment scope without granting another action. */
/* @sem Instruction::[Effect{result:@next, operation:$temporary_one_spell_spending}] */
limited_mana_cost_spending_reminded ::= temporary_one_spell_spending "." "(" "additional" "costs" "are" "still" "paid" "normally" "." ")"
