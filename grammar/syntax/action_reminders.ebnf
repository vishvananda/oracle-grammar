/* The printed subtype of the lifelink group is repeated in the reminder. */
/* @sem Instruction::[Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([@agree($subtype, $subtype_plural), CardType(Creature), ControlledBy(One(AbilityController))])}), changes:[GrantKeyword($kn_lifelink)], duration:EndOfTurn, evaluation:Snapshot}}] */
subtype_lifelink_reminded ::= subtype "creatures" "you" "control" "gain" kn_lifelink "until" "end" "of" "turn" "." "(" "damage" "dealt" "by" "those" subtype_plural "also" "causes" "their" "controller" "to" "gain" "that" "much" "life" "." ")"

/* The explanation names the same Sliver population as its grant. */
/* @sem Ability::[WithPresentation{reminder:true, ability:Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Battlefield), kind:Permanent, filter:AllOf([$st_sliver, CardType(Creature)])}), changes:[$sliver_rules_grant]}}] */
line_sliver_grant_reminder ::= "all" st_sliver "creatures" "have" sliver_rules_grant
sliver_rules_grant ::= sliver_flanking_reminded | sliver_frenzy_reminded | sliver_absorb_reminded
/* @sem Change::GrantKeyword($kn_flanking) */
