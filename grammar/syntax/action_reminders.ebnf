/* @sem Ability::[WithPresentation{reminder:true,ability:Spell{announcement:@announcement,body:_{instructions:[ForEachPlayer{players:OpponentsOf(AbilityController),binding:0,body:_{instructions:[Effect{result:@mark,operation:RevealUntil{library:Bound(0),filter:CardType(Creature),count:Constant(1)}}]}},Effect{result:@next,operation:ChooseObjects{player:AbilityController,objects:Matching{objects:Observed(@marked),filter:CardType(Creature)},count:AsManyAsCan(Constant(1)),constraints:[CanMoveTo{destination:Battlefield{controller:Player(AbilityController),arrival:BattlefieldArrival{}}}]}},ForEachObject{objects:Selected(1),binding:0,body:_{instructions:[Effect{result:@next,operation:Keyword{actor:One(AbilityController),action:Assimilate{object:Bound(0)}}}]}},ForEachPlayer{players:OpponentsOf(AbilityController),binding:0,body:_{instructions:[Effect{result:@next,operation:ReorderLibrary{chooser:Bound(0),library_owner:Bound(0),objects:Matching{objects:InZone{objects:Difference{objects:Observed(@marked),excluding:Selected(1)},zone:Library},filter:OwnedBy(One(Bound(0)))},end:Bottom,order:$library_order}}]}}]}}}] */
