/* @sem Ability::WithPresentation{reminder:true, ability:$action_reminder_ability} */
reminded_action_ability ::= action_reminder_ability
/* @sem Ability::WithPresentation{label:$ability_label, reminder:true, ability:$action_reminder_ability} */
labelled_action_reminder ::= ability_label "—" action_reminder_ability

action_reminder_ability ::= optional_combat_end_reminded | return_as_spirit_detective_reminded | attacker_selector_reminded | lasting_blaze_grant_reminded | named_land_legendary_reminded | source_combat_return_reminded | crime_return_from_battlefield_reminded | targeted_creature_return_reminded | scry_surveillance_look_reminded | dilemma_draw_reminded | sustain_endure_x_reminded | mana_cost_color_reminded | time_travel_three_reminded | grant_departure_trigger_reminded | pay_exiled_spell_reminded | end_turn_activated_your_turn_reminded | reminder_spell | reminder_activated | reminder_activated_limited | reminder_activated_trailing
    | reminder_triggered | reminder_triggered_if | reminder_triggered_once | reminder_triggered_natural_twenty
    | self_enter_explore_twice_reminded | defined_echo_reminded
    | cascade_entry_reminded | all_damage_withers_reminded | static_afflict_reminded
    | equipped_afflict_reminded | equipped_landwalk_reminded
    | reminder_turn | reminder_turn_if | reminder_spell_modal | reminder_activated_modal
    | reminder_triggered_if_modal | reminder_triggered_modal | reminder_turn_modal | reminder_loyalty | reminder_spell_ascend

/* @sem Ability::Spell{announcement:@announcement, body:$reminder_program_sentence} */
reminder_spell ::= reminder_program_sentence
/* The spell performs ascend before continuing with the rest of its program. */
/* @sem Ability::Spell{announcement:@announcement, body:Program{instructions:[...$ascend_instruction, ...$instructions]}} */
reminder_spell_ascend ::= ascend_instruction ascend_explanation NEWLINE instructions "."
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:@announcement, body:$reminder_program_sentence} */
reminder_activated ::= cost ":" reminder_program_sentence
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:$reminder_program_sentence} */
reminder_activated_limited ::= cost ":" reminder_program_sentence activation_limits "."
/* A trailing explanation can follow an activation restriction. Its action
   operand is still explicit, so it cannot attach to an unrelated program. */
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:$activation_limits, announcement:@announcement, body:_{instructions:[Effect{result:@next, operation:$proliferate_action}]}} */
reminder_activated_trailing ::= cost ":" proliferate_action "." activation_limits "." "(" proliferate_explanation "." ")"
/* @sem Ability::Activated{origin:Ordinary, cost:_{parts:[Loyalty($loyalty_heading)]}, limits:_{sorcery:true}, announcement:@announcement, body:$reminder_program_sentence} */
reminder_loyalty ::= loyalty_heading ":" reminder_program_sentence
/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:@announcement, body:$reminder_program_sentence} */
reminder_triggered ::= event_clause "," reminder_program_sentence
/* @sem Ability::Triggered{event:$event_clause, intervening_if:$condition, limits:_{}, announcement:@announcement, body:$reminder_program_sentence} */
reminder_triggered_if ::= event_clause "," "if" condition "," reminder_program_sentence
/* The same event and reminder both specify the natural die face of 20. */
/* @sem Ability::Scoped{zones:[Graveyard], ability:@scope(Ability::Triggered{event:$event_natural_twenty, limits:_{}, announcement:@announcement, body:$graveyard_self_program})} */
reminder_triggered_natural_twenty ::= "when" event_natural_twenty "," graveyard_self_program "(" "a" "natural" "20" "is" "a" "roll" "that" "displays" "20" "on" "the" "die" "." ")"
/* @sem Ability::Triggered{event:$event_clause, limits:_{per_turn:1}, announcement:@announcement, body:$reminder_program_sentence} */
reminder_triggered_once ::= event_clause "," reminder_program_sentence "this" "ability" "triggers" "only" "once" "each" "turn" "."
/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:@announcement, body:$reminder_program_sentence} */
reminder_turn ::= "at" turn_event "," reminder_program_sentence
/* @sem Ability::Triggered{event:$turn_event, intervening_if:$condition, limits:_{}, announcement:@announcement, body:$reminder_program_sentence} */
reminder_turn_if ::= "at" turn_event "," "if" condition "," reminder_program_sentence

/* Each program contains at least one closed reminder, including in a mode.
   Ordinary clauses on either side retain their order, definitions and targets. */
/* @sem Program::Program{instructions:$reminder_instructions} */
reminder_program_sentence ::= reminder_instructions
reminder_instructions ::= reminder_sacrifice_excess_callback | instructions_damage_target_excess_empower | source_named_phaseout_next_turn_reminded | destroy_target_attraction_reminded | reminder_closed | reminder_before | reminder_closed_before
    | reminder_after_plain | reminder_after_reminder | reminder_open_then_plain | reminder_open_then_reminder
reminder_before ::= reminder_before_surveil | reminder_before_period | reminder_before_then | reminder_before_line | reminder_before_controller_energy
/* @sem Instruction::[...$clause, ...$reminder_you] */
reminder_before_controller_energy ::= clause "and" reminder_you "."
/* @sem Instruction::[...$clause, ...$reminder_instructions] */
reminder_before_period ::= clause sequencer reminder_instructions
/* @sem Instruction::[...$instructions, ...$reminder_instructions] */
reminder_before_line ::= instructions "." NEWLINE reminder_instructions
/* @sem Vec<Instruction>::@then_sequence($clause_before_then, $reminder_instructions) */
reminder_before_then ::= clause_before_then "," "then" reminder_instructions
/* @sem Instruction::[...$clause_closed, ...$reminder_instructions] */
reminder_closed_before ::= clause_closed "." NEWLINE? reminder_instructions
/* @sem Instruction::[...$reminder_closed, ...$instructions] */
reminder_after_plain ::= reminder_closed NEWLINE? instructions "."
/* @sem Instruction::[...$reminder_closed, ...$reminder_instructions] */
reminder_after_reminder ::= reminder_closed NEWLINE? reminder_instructions

/* @sem Instruction::[...$reminder_open, ...$instructions] */
reminder_open_then_plain ::= reminder_open (sequencer | "," "then") instructions "."
/* @sem Instruction::[...$reminder_open, ...$reminder_instructions] */
reminder_open_then_reminder ::= reminder_open (sequencer | "," "then") reminder_instructions
/* @sem $reminder_open */
reminder_open_closed ::= reminder_open "."

reminder_closed ::= amass_excess_receipt_reminded | empower_jace_excess_damage_reminded | replacement_land_quoted_reminded | retained_land_indefinite_reminded | returned_mutant_reminded | bird_giant_type_reminded | delayed_return_battlefield_reminded | legendary_animation_loyalty_reminded | control_change_source_combat_reminded | gideon_animation_attack_note | return_artifact_form_reminded | return_face_down_land_reminded | mana_produced_types_reminded | source_face_down_stats_reminded | source_copy_without_counters_reminded | phased_return_reminded | returned_attachments_reminded | shield_group_reminded | mill_target_power_reminded | mill_target_defined_reminded | devour_spell_reminded | devour_token_reminded | event_damage_counters_survival_reminded | connive_target_reminded | adapt_current_source_reminded | next_cast_sunburst_reminded | opponents_mill_reminded | amass_goblin_defined_reminded | amass_goblins_reminded | double_team_grant_reminded | owner_discovers_explanation_reminded | created_tokens_goaded_reminded | remove_lore_reminded | mill_select_life_reminded | four_targets_destroy_reminded | incubate_numeric_reminded | incubate_numeric_twice_reminded | incubate_twice_defined_reminded | controller_incubates_x_reminded | populate_announced_times_reminded | cloak_one_from_hand_reminded | manifest_player_top_reminded | endure_entry_defined_reminded | annihilator_token_reminded | temporary_rampage_reminded | encore_granted_reminded | embalm_granted_reminded | afterlife_followed_by_draw_reminded | granted_landwalk_reminded | exile_spell_no_effect_reminded | exile_top_card_public_reminded | end_combat_phase_reminded | end_turn_your_turn_reminded | control_change_combat_reminded | target_creature_copied_abilities_reminded | group_colored_hexproof_reminded | counter_announced_value_reminded | explore_twice_reminded | explores_many_reminded | each_explores_reminded | surveil_defined_with_followup_reminder | shield_counter_reminded | tap_stun_counter_reminded | surveil_defined_reminded | open_attraction_reminded | open_two_attractions_reminded | limited_mana_cost_spending_reminded | reminder_open_closed | proliferate_reminded | proliferate_twice_reminded | proliferate_pair_reminded | amass_slivers_reminded | phase_out_target_reminded | blight_opponents_reminded | future_flash_reminded | flying_target_reminded | recruit_reminded | empower_jace_reminded | empower_jace_defined_reminded | paradigm_reminded
    | redistribution_reminded | graveyard_type_change_reminded | perpetual_selected_casualty_reminded | return_finality_reminded | exile_pair_suspend_reminded | controller_investigates_reminded | typed_protection_reminded | protection_then_counter_reminded | player_protection_reminded | group_hexproof_reminded | exiled_undaunted_reminded | exile_max_power_target_reminded | destroy_min_mana_target_reminded | foretold_hand_card_reminded | exile_target_spell_plot_reminded | copy_controlled_permanent_spell_reminded | group_exile_until_reminded | each_opponent_exile_until_reminded | redirected_to_chosen_permanent_reminded | mixed_word_change_reminded | exile_target_until_source_leaves_reminded | take_target_spell_reminded | subtype_lifelink_reminded
    | scry_reminded | surveil_reminded | investigate_reminded | named_token_reminded | fight_reminded
    | reminder_if | reminder_optional | reminder_paid | support_reminded
    | incubate_x_reminded | exile_incubate_x_reminded | vibranium_reminded | heartwood_tapped_reminded | becomes_prepared_reminded

/* The explanatory X has the same definition as the written action. */
/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:Incubate{amount:$keyword_defined_x}}}] */
incubate_x_reminded ::= "incubate" keyword_defined_x "." incubator_x_explanation
/* @sem $instructions_exile_incubate_count */
exile_incubate_x_reminded ::= instructions_exile_incubate_count "." incubator_x_explanation
/* @sem () */
incubator_x_explanation ::= "(" "create" incubator_x_recipe_note ")"
/* @sem () */
incubator_x_recipe_note ::= "an" "Incubator" "token" "with" "X" "+" "1" "/" "+" "1" "counters" "on" "it" "and" '"' "{" "2" "}" ":" "transform" "this" "token" "." '"' "it" "transforms" "into" "a" "0" "/" "0" "Phyrexian" "artifact" "creature" "."
/* @sem Instruction::[@leading_if(Instruction::If{condition:$condition, then:_{instructions:$reminder_closed}, otherwise:_{}})] */
reminder_if ::= "if" condition "," reminder_closed
/* @sem Instruction::[Optional{decider:AbilityController, body:_{instructions:$reminder_closed}}] */
reminder_optional ::= "you" "may" reminder_closed
/* @sem Instruction::[Effect{result:@next, operation:PayCost{player:AbilityController, cost:$payment, optional:true}}, If{condition:PaymentChosen(@last_result), then:_{instructions:$reminder_closed}, otherwise:_{}}] */
reminder_paid ::= "you" "may" payment "." "if" "you" "do" "," reminder_closed

/* @sem Instruction::[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(Targets(@target($support_explained_target))), kind:PowerToughness([1, 1]), amount:Constant(1)}]}}] */
support_reminded ::= "support" support_explained_target
/* @sem TargetSpec::TargetSpec{slot:@slot, kind:Object(_{kind:Permanent, zones:[Battlefield]}), count:UpTo(@agree($number, $support_explained_count)), filter:@support_filter($support_explained_creatures)} */
support_explained_target ::= number "." "(" "put" "a" "+" "1" "/" "+" "1" "counter" "on" "each" "of" "up" "to" support_explained_count support_explained_creatures "." ")"
support_explained_count ::= number_words | number_x
support_explained_creatures ::= support_other_creatures | support_any_creatures
/* @sem bool::true */
support_other_creatures ::= "other" "target" "creatures"
/* @sem bool::false */
support_any_creatures ::= "target" "creatures"

/* A single application uses the native absent amount. Explicit repeated
   applications retain an amount, rather than expanding the explanation. */
proliferate_action ::= proliferate_once_action | proliferate_twice_action | proliferate_count_action
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Proliferate{}} */
proliferate_once_action ::= "proliferate"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Proliferate{times:Constant(2)}} */
proliferate_twice_action ::= "proliferate" "twice"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Proliferate{times:$number}} */
proliferate_count_action ::= "proliferate" number "times"
/* @sem Instruction::[Effect{result:@next, operation:$proliferate_action}] */
proliferate_reminded ::= proliferate_action "." "(" proliferate_explanation "." ")"
/* @sem Instruction::[Effect{result:@next, operation:$proliferate_twice_action}] */
proliferate_twice_reminded ::= proliferate_twice_action "." "(" proliferate_explanation "." "then" "do" "it" "again" "." ")"
/* The note explains phasing of the very target in this mode. */
/* @sem Instruction::[Effect{result:@next, operation:$object_phases_out}] */
phase_out_target_reminded ::= object_phases_out "." "(" phaseout_attached_words ")"

/* @sem Instruction::[ForEachPlayer{players:OpponentsOf(AbilityController), binding:0, body:Program{instructions:[Effect{result:@next, operation:Keyword{actor:One(Bound(0)), action:Blight{amount:Expr::@agree($value, $blight_each_reminder_amount)}}}]}}] */
blight_opponents_reminded ::= "each" "opponent" "blights" value "." "(" blight_each_reminder_amount ")"
/* @sem Expr::Constant(1) */
blight_each_reminder_amount ::= "they" "each" "put" "a" "-" "1" "/" "-" "1" "counter" "on" "a" "creature" "they" "control" "."

/* @sem $proliferate_pair */
proliferate_pair_reminded ::= proliferate_pair "." "(" proliferate_explanation "." ("then" "do" "it" "again" ".")? ")"
/* @sem () */
proliferate_explanation ::= ("to" "proliferate" ",")? proliferate_instruction_words
/* @sem () */
proliferate_instruction_words ::= "choose" "any" "number" "of" "permanents" "and/or" "players" "," "then" "give" "each" "another" "counter" "of" "each" "kind" "already" "there"

/* The numeral and the reminder's written count must agree in both directions. */
/* @sem Instruction::[Effect{result:@next, operation:Scry{players:One(AbilityController), amount:@agree($number, $scry_look_explanation)}}] */
scry_reminded ::= "scry" number "." "(" scry_look_explanation ")"
scry_look_explanation ::= scry_look_one | scry_look_one_it | scry_look_many
/* @sem Expr::Constant(1) */
scry_look_one ::= "look" "at" "the" "top" "card" "of" "your" "library" "." "you" "may" "put" "that" "card" "on" "the" "bottom" "."
/* @sem Expr::Constant(1) */
scry_look_one_it ::= "look" "at" "the" "top" "card" "of" "your" "library" "." "you" "may" "put" "it" "on" "the" "bottom" "."
/* @sem $number_words */
scry_look_many ::= "look" "at" "the" "top" number_words "cards" "of" "your" "library" "," "then" "put" "any" "number" "of" "them" "on" "the" "bottom" "and" "the" "rest" "on" "top" "in" "any" "order" "."

/* @sem Instruction::[Effect{result:@next, operation:Surveil{players:One(AbilityController), amount:@agree($number, $surveil_look_explanation)}}] */
surveil_reminded ::= "surveil" number "." "(" surveil_look_explanation ")"
surveil_look_explanation ::= surveil_look_one | surveil_look_one_named | surveil_look_many
/* @sem Expr::Constant(1) */
surveil_look_one ::= "look" "at" "the" "top" "card" "of" "your" "library" "." "you" "may" "put" "it" "into" "your" "graveyard" "."
/* @sem Expr::Constant(1) */
surveil_look_one_named ::= "look" "at" "the" "top" "card" "of" "your" "library" "." "you" "may" "put" "that" "card" "into" "your" "graveyard" "."
/* @sem $number_words */
surveil_look_many ::= "look" "at" "the" "top" number_words "cards" "of" "your" "library" "," "then" "put" "any" "number" "of" "them" "into" "your" "graveyard" "and" "the" "rest" "on" "top" ("of" "your" "library")? "in" "any" "order" "."

/* @sem Instruction::[Effect{result:@next, operation:$fight_action}] */
fight_reminded ::= fight_action "." "(" "each" "deals" "damage" "equal" "to" "its" "power" "to" "the" "other" "." ")"

/* @sem Instruction::[Effect{result:@next, operation:$investigate_once}] */
investigate_reminded ::= investigate_once "." "(" "create" "a" "Clue" "token" "." clue_explanation ")"
/* The receipt and token's activated abilities come from the existing recipe.
   The recognized explanation contributes no extra instructions. */
/* @sem Instruction::[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[$reminded_token_batch], entry:BattlefieldArrival{tapped:false, counters:[], states:[]}})}] */
named_token_reminded ::= "create" reminded_token_batch
/* @sem Instruction::[Effect{result:@next, operation:@created_result(Operation::CreateTokens{players:One(AbilityController), tokens:[TokenSpec{amount:Constant(1), words:Rules, recipe:$tn_vibranium}], entry:BattlefieldArrival{tapped:true, counters:[], states:[]}})}] */
vibranium_reminded ::= "create" "a" "tapped" tn_vibranium "token" "." "(" "it's" "an" "artifact" "with" "indestructible" "and" '"' "{" "T" "}" ":" "add" "{" "C" "}" "." "this" "mana" "can't" "be" "spent" "to" "cast" "a" "nonartifact" "spell" "." '"' ")"
reminded_token_batch ::= reminded_token_single | reminded_token_multiple
/* @sem TokenSpec::TokenSpec{amount:Constant(1), words:Rules, recipe:$reminded_named_token} */
reminded_token_single ::= "a" reminded_named_token
/* @sem TokenSpec::TokenSpec{amount:@plural_amount($token_amount), words:Rules, recipe:$reminded_named_tokens} */
reminded_token_multiple ::= token_amount reminded_named_tokens

reminded_named_token ::= reminded_heartwood_token | reminded_treasure_token | reminded_food_token | reminded_clue_token | reminded_blood_token
/* @sem $tn_treasure */
reminded_treasure_token ::= tn_treasure "token" "." "(" "it's" "an" "artifact" "with" treasure_reminder_cost ")"
/* @sem $tn_food */
reminded_food_token ::= tn_food "token" "." "(" "it's" "an" "artifact" "with" food_reminder_cost ")"
/* @sem $tn_clue */
reminded_clue_token ::= tn_clue "token" "." "(" clue_explanation ")"
/* @sem $tn_blood */
reminded_blood_token ::= tn_blood "token" "." "(" "it's" "an" "artifact" "with" '"' "{" "1" "}" "," "{" "T" "}" "," "↑" "discard" "a" "card" "," "↑" "sacrifice" "this" "token" ":" "draw" "a" "card" "." '"' ")"
/* @sem () */
clue_explanation ::= "it's" "an" "artifact" "with" clue_reminder_cost

reminded_named_tokens ::= reminded_heartwood_tokens | reminded_treasure_tokens | reminded_food_tokens | reminded_clue_tokens
/* @sem $tn_treasure */
reminded_treasure_tokens ::= tn_treasure "tokens" "." "(" "they're" "artifacts" "with" treasure_reminder_cost ")"
/* @sem $tn_food */
reminded_food_tokens ::= tn_food "tokens" "." "(" "they're" "artifacts" "with" food_reminder_cost ")"
/* @sem $tn_clue */
reminded_clue_tokens ::= tn_clue "tokens" "." "(" "they're" "artifacts" "with" clue_reminder_cost ")"
/* @sem () */
treasure_reminder_cost ::= '"' "{" "T" "}" "," "↑" "sacrifice" "this" ("token" | "artifact") ":" "add" "one" "mana" "of" "any" "color" "." '"'
/* @sem String::'FoodToken' */
food_token_rules_explanation ::= "a" "Food" "token" "is" "an" "artifact" "with" food_token_reminder_cost
/* @sem () */
food_token_reminder_cost ::= food_reminder_cost_start "token" food_reminder_cost_end
/* @sem () */
food_artifact_reminder_cost ::= food_reminder_cost_start "artifact" food_reminder_cost_end
/* @sem () */
food_reminder_cost ::= food_token_reminder_cost | food_artifact_reminder_cost
/* @sem () */
food_reminder_cost_start ::= '"' "{" "2" "}" "," "{" "T" "}" "," "↑" "sacrifice" "this"
/* @sem () */
food_reminder_cost_end ::= ":" "you" "gain" "3" "life" "." '"'
/* @sem () */
clue_reminder_cost ::= '"' "{" "2" "}" "," "↑" "sacrifice" "this" ("token" | "artifact") ":" "draw" "a" "card" "." '"'

/* The mode list has at least one reminder-bearing mode. Plain modes keep their
   own scopes; the presentation belongs to the complete modal ability. */
/* @sem Ability::Spell{announcement:_{modes:$reminder_mode_selection}, body:_{}} */
reminder_spell_modal ::= reminder_mode_selection
/* @sem Ability::Activated{origin:Ordinary, cost:$cost, limits:_{}, announcement:_{modes:$reminder_mode_selection}, body:_{}} */
reminder_activated_modal ::= cost ":" reminder_mode_selection
/* @sem Ability::Triggered{event:$event_clause, limits:_{}, announcement:_{modes:$reminder_mode_selection}, body:_{}} */
reminder_triggered_modal ::= event_clause "," reminder_mode_selection
/* @sem Ability::Triggered{event:$turn_event, limits:_{}, announcement:_{modes:$reminder_mode_selection}, body:_{}} */
reminder_turn_modal ::= "at" turn_event "," reminder_mode_selection
reminder_mode_selection ::= reminder_choose_up_to_number | reminder_choose_number | reminder_choose_repeatable | reminder_choose_both | reminder_choose_more
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$reminder_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
reminder_choose_number ::= "choose" number_words "—" NEWLINE reminder_modes
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:$number_words, maximum:$number_words}, options:$reminder_modes, rules:ModeRules{repetition:MayRepeat, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
reminder_choose_repeatable ::= "choose" number_words "." "you" "may" "choose" "the" "same" "mode" "more" "than" "once" "." NEWLINE reminder_modes
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:Constant(2)}, options:$reminder_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
reminder_choose_both ::= "choose" "one" "or" "both" "—" NEWLINE reminder_modes
/* @sem ModeSelection::ModeSelection{count:ModeCount{minimum:Constant(1), maximum:@length($reminder_modes)}, options:$reminder_modes, rules:ModeRules{repetition:OnceEach, availability:Any, targets:MayShare, acceptance:Required}, mechanism:ModeMechanism::Announced{chooser:Controller, method:PlayerChoice}} */
reminder_choose_more ::= "choose" "one" "or" "more" "—" NEWLINE reminder_modes
reminder_mode ::= word_replacement_reminded_mode | reminder_mode_scout_flavor | reminder_mode_plain | reminder_mode_with_flavor
reminder_modes ::= reminder_mode_one | reminder_modes_before | reminder_modes_after | reminder_modes_multiple
/* @sem Mode::[$reminder_mode] */
reminder_mode_one ::= reminder_mode
/* @sem Mode::[$mode, ...$reminder_modes] */
reminder_modes_before ::= mode NEWLINE reminder_modes
/* @sem Mode::[$reminder_mode, ...$modes] */
reminder_modes_after ::= reminder_mode NEWLINE modes
/* @sem Mode::[$reminder_mode, ...$reminder_modes] */
reminder_modes_multiple ::= reminder_mode NEWLINE reminder_modes

/* Explicitly repeating the instruction also retains the native two-effect
   reading. The counted native form above remains a distinct reading. */
/* @sem Instruction::[Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Proliferate{}}}, Effect{result:@next, operation:Keyword{actor:One(AbilityController), action:KeywordAction::Proliferate{}}}] */
proliferate_pair ::= "proliferate" "," "then" "proliferate" "again"

/* North Star's reminder restates the payment scope without granting another action. */
/* @sem Instruction::[Effect{result:@next, operation:$temporary_one_spell_spending}] */
limited_mana_cost_spending_reminded ::= temporary_one_spell_spending "." "(" "additional" "costs" "are" "still" "paid" "normally" "." ")"

/* @sem Cost::Cost{parts:[Behold{count:Constant(1), what:$behold_explained_operand}]} */
behold_one_payment_note ::= "you" "may" behold_explained_operand "."
behold_explained_operand ::= behold_explained_type | behold_explained_creature_type | behold_explained_jace
/* @sem Operand::Term{family:CardsInHand, form:IsCreatureType, operands:[Vocabulary{family:CreatureType, form:@subtype_name(ObjectFilter::@agree($creature_subtype, $creature_subtype_2))}]} */
behold_explained_type ::= "choose" ("a" | "an") creature_subtype "you" "control" "or" "reveal" ("a" | "an") creature_subtype "card" "from" "your" "hand"
/* @sem Operand::Term{family:CardsInHand, form:And, operands:[Term{family:CardsInHand, form:IsCreatureType, operands:[Vocabulary{family:CreatureType, form:@subtype_name(ObjectFilter::@agree($creature_subtype, $creature_subtype_2))}]}, Term{family:CardsInHand, form:IsCardtype, operands:[Vocabulary{family:CardType, form:Creature}]}]} */
behold_explained_creature_type ::= "choose" ("a" | "an") creature_subtype "creature" "you" "control" "or" "reveal" ("a" | "an") creature_subtype "creature" "card" "from" "your" "hand"

/* @sem Ability::WithPresentation{reminder:true, ability:@additional_branch($behold_reminded_header, Ability::Spell{announcement:@announcement, body:$kicker_branch_program})} */
spell_behold_branch_reminded ::= optional_cost_opening behold_reminded_header NEWLINE kicker_branch_program
/* @sem Cost::@agree(Cost{parts:[$cost_behold]}, $behold_one_payment_note) */
behold_reminded_header ::= cost_behold "." "(" behold_one_payment_note ")"

/* @sem Ability::[WithPresentation{reminder:true, ability:Casting(AdditionalCost{cost:_{parts:[Choice([@agree(Cost{parts:[$cost_behold]}, $behold_definition_note), $cost])]}, repetition:Once})}] */
line_behold_choice_explained ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," cost_behold "or" "pay" cost "." "(" behold_definition_note ")"
/* @sem Cost::@agree(Cost{parts:[$cost_behold]}, Cost{parts:[Behold{count:Constant(1), what:$behold_explained_operand}]}) */
behold_definition_note ::= "to" cost_behold "," behold_explained_operand "."

/* @sem Ability::[WithPresentation{reminder:true, ability:Casting(Flash{additional_cost:Cost::@agree(Cost{parts:[$cost_behold]}, $behold_definition_note)})}] */
line_behold_flash_explained ::= "you" "may" "cast" "this" "spell" "as" "though" "it" "had" "flash" "if" "you" cost_behold "as" "an" "additional" "cost" "to" "cast" "it" "." "(" behold_definition_note ")"

/* @sem Ability::[WithPresentation{reminder:true, ability:Casting(AdditionalCost{cost:@agree(Cost{parts:[$cost_behold_exile]}, $behold_exile_note), repetition:Once})}] */
line_behold_exile_explained ::= "as" "an" "additional" "cost" "to" "cast" "this" "spell" "," cost_behold_exile "." "(" behold_exile_note ")"
/* @sem Cost::Cost{parts:[BeholdAndExile(Term{family:CardsInHand, form:IsCreatureType, operands:[Vocabulary{family:CreatureType, form:@subtype_name(ObjectFilter::@agree($creature_subtype, $creature_subtype_2))}]})]} */
behold_exile_note ::= "exile" ("a" | "an") creature_subtype "you" "control" "or" ("a" | "an") creature_subtype "card" "from" "your" "hand" "."

/* Explanations of the keyword that the current ability grants. */
combat_keyword_explanation ::= deathtouch_they_explanation | deathtouch_destroy_it_explanation | defender_definition_explanation
    | fear_definition_explanation | flying_definition_explanation | flying_it_explanation
    | double_strike_definition_explanation | first_strike_definition_explanation | indestructible_it_explanation
    | indestructible_him_explanation | indestructible_creature_explanation | indestructible_those_creatures_explanation
    | menace_it_explanation | horsemanship_group_explanation | haste_attack_anytime_explanation
    | haste_attack_this_turn_explanation

/* @sem String::'Deathtouch' */
deathtouch_they_explanation ::= "any" "amount" "of" "damage" "they" "deal" deathtouch_destroy_it_words

/* @sem String::'Deathtouch' */
