    | remove_colors_replace_creature_types_explanation | replace_names_and_creature_types_explanation
    | replace_card_and_creature_types_explanation | replace_colors_and_creature_types_explanation
    | replace_colors_and_types_explanation | replace_colors_types_and_names_explanation
