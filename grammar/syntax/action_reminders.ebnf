/* Both sentences prove a claim in the same native ability. */
line_combat_notes ::= line_lifelink_target_indestructible_note | line_vigilance_fear_note | line_first_strike_immediate_haste_note | line_deathtouch_lifelink_note | line_trample_first_strike_note | line_vigilance_lifelink_note | line_first_strike_lifelink_note
