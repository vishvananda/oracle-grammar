/* @sem () */
convoke_tap_own ::= "each" "creature" "you" "tap" "while" "casting"
/* @sem () */
convoke_payment_words ::= "pays" "for" "{" "1" "}" "or" "one" "mana" "of" "that" "creature's" "color" "."

