/* The exploring subject is the creature that entered. */
/* @sem Ability::Triggered{event:$event_self_enters, limits:_{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:$self_entry_explore}, Effect{result:@next, operation:$self_entry_explore}]}} */
self_enter_explore_twice_reminded ::= "when" event_self_enters "," self_entry_explore "," "then" "it" "explores" "again" "." "(" explore_rules_prefix "this" "creature" explore_rules_suffix "then" "repeat" "this" "process" "." ")"
/* @sem Operation::Keyword{actor:One(AbilityController), action:KeywordAction::Explore{object:@it}} */
self_entry_explore ::= "it" "explores"

/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(One(Source)), changes:[GrantAbility($granted_echo_defined)]}) */
defined_echo_reminded ::= self_creature "has" granted_echo_defined "." "(" echo_cost_explanation ")"

/* A granted afflict ability repeats the amount in the condition and life loss. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects($static_affected), changes:[GrantAbility(Mechanic{mechanic:Afflict, amount:Expr::@agree($number_digits, $granted_afflict_rule_amount)})]}) */
static_afflict_reminded ::= static_affected "have" "afflict" number_digits "." "(" granted_afflict_rule_amount ")"
/* @sem Expr::@agree($number_digits, $number_digits_2) */
granted_afflict_rule_amount ::= "whenever" "a" "creature" "with" "afflict" number_digits "becomes" "blocked" "," "defending" "player" "loses" number_digits "life" "."

/* The described combat trigger and blocking rule belong to the equipped holder. */
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(One($equipped_ref)), changes:[...$change_pump, GrantAbility(Mechanic{mechanic:Afflict, amount:Expr::@agree($number_digits, $number_digits_2)})]}) */
equipped_afflict_reminded ::= equipped_ref change_pump "and" "has" "afflict" number_digits "." "(" "whenever" "it" "becomes" "blocked" "," "defending" "player" "loses" number_digits "life" "." ")"
/* @sem Ability::Static(_{kind:Ordinary, affected:Objects(One($equipped_ref)), changes:[...$change_pump, GrantKeyword(@agree($walk_card_type, $walk_reminder_clause))]}) */
equipped_landwalk_reminded ::= equipped_ref change_pump "and" "has" walk_card_type "." "(" walk_reminder_clause "." ")"

