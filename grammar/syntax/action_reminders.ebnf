/* Action reminders describe existing native actions. The enclosing ability
   carries one presentation flag; explanation words create no extra program. */
/* A shared game rule can be explained after several effects. The native
   operand remains part of the immediately preceding ability. */
line_contextual_reminder ::= line_tap_twice_x_stun_reminded | line_controlled_spells_split_second_reminded | line_hone_counter_reminded | line_assimilate_linked_or_exile | line_opponent_exile_until_assimilate | line_reveal_each_assimilate_remainder | line_dilemma_paid_graveyard_return | line_next_pair_undaunted_reminded | line_pump_cant_block_replace_types_reminded | line_artifact_spells_replicate_reminded | line_once_graveyard_artifact_cast_reminded | line_stun_and_investigate_modes_reminded | line_dilemma_history_exile_cast | line_goad_source_and_chosen_reminded | line_graveyard_card_beam_up_grant | line_assimilate_linked_card_reminded | line_assimilate_each_opponent_reminded | line_self_and_target_phaseout_reminded | combat_reselection_reminded | line_vehicle_token_crew_reminded | line_named_perpetual_equipped_death | line_hand_choice_shield_reminded | line_vibranium_entry_reminded | line_counter_fight_adamant_reminded | line_exile_even_adamant_reminded | line_surveil_void_reminded | line_aggregate_discover_reminded | line_perpetual_enchantment_reminded | line_harness_infinity_reminded | line_raid_named_header | line_conditional_top_land_play_reminded | line_blight_cap_reminded | line_revealed_card_copy_reminded | line_optional_copy_until_turn_reminded | line_damage_unpreventable_reminded | line_win_empty_library_reminded | line_enchantment_control_reminded | line_snow_landwalk_reminded | line_combined_keywords_reminded | line_shapeshifter_full_text_reminded | line_mulligan_optional_reminded | line_no_life_change_reminded | line_conjure_secret_hand_reminded | line_hidden_top_look_reminded | line_hand_graveyard_shuffle_reminded | line_ordered_creature_pump_reminded | line_named_protection_reminded | line_opponents_protection_reminded | line_commander_guest_protection_reminded | line_targeted_extra_turn_protection_reminded | line_planeswalk_phasing_reminded | line_loyalty_phasing_reminded | line_discard_simultaneous_reminded | hideaway_doubled_reminded | line_attraction_destroy_after_discard_reminded | line_shared_demonstrate_reminded | line_spell_replicate_mana_reminded | line_spell_replicate_paid_reminded | line_evolution_token_reminded | line_monarch_loss_reminded | line_scry_then_energy_reminded | line_descended_count_reminded | line_assimilate_reminded | line_optional_reveal_damage_reminded | line_one_exile_choice_reminded | line_host_poisonous_reminded | line_sliver_poisonous_reminded | line_static_subtype_provoke_reminded | line_triggered_subtype_provoke_reminded | line_shared_exploit_reminded | line_host_mobilize_reminded | line_static_modular_one_reminded | line_static_ripple_reminded | line_temporary_graveyard_escape_reminded | line_paying_symbol_infect_reminded | line_granted_sticker_kicker_reminded | line_granted_offspring_reminded | line_granted_hand_warp_reminded | line_labelled_graveyard_mayhem_reminded | line_granted_web_slinging_reminded | line_generic_reduction_reminded | line_graveyard_warp_reminded | line_behold_optional_type_reminded | line_colored_reduction_spill_reminded | line_protection_group_reminded | line_graveyard_batch_battlefield_reminded | line_remove_from_combat_untap_reminded | line_trample_over_planeswalkers_reminded | line_party_choice_reminded | line_divided_damage_kicker_reminded | line_single_fateseal_grant_reminded | line_double_fateseal_spell_reminded | line_untap_counter_replacement_reminded | line_landwalk_sacrificed_reminded | line_combat_declaration_payment_reminded | line_random_single_retarget_reminded | line_copy_sacrificial_activation_reminded | line_counter_grant_last_reminded | line_variant_phyrexian_toxic_reminded | line_lands_mountain_reminded | line_enchantment_only_reminded | line_vehicle_crew_type_reminded | line_face_clue_type_reminded | line_attached_creature_type_loss_reminded | line_forest_creatures_reminded | line_villainous_repeat_reminded | line_devour_cast_group_reminded | line_damage_source_counters_reminded | line_granted_umbra_reminded | line_kind_replacement_reminded | line_mutate_loss_reminded | line_counted_ability_once_reminded | line_life_infect_reminded | line_enchant_modified_reminded | line_sacrifice_powerstones_reminded | line_graveyard_dredge_reminded | line_scry_and_surveil_draw_reminded | line_moonmist_transform_note | line_reminded_annihilator_equipment | line_reminded_rampage_choice | line_rebound_cast_from_hand_reminded | line_soulshift_defined_reminded | line_temporary_melee_delayed_main | line_reminded_graveyard_mechanic_grant | line_reminded_madness_grant | line_reminded_blitz_discount | line_reminded_blitz_from_hand | line_reminded_evoke_from_hand | line_reminded_saddle_grant | line_reminded_annihilator_aura | line_added_land_no_mana_reminded | line_group_ward_reminded | line_attach_filtered_ward_reminded | line_all_colors_protection_keeps_reminded | line_colored_subtype_reduction_example | line_creature_type_pump_example | line_mana_cost_diversity_example | line_untapped_spell_cost_floor_example | line_contextual_group | line_paid_permanent_copy_note | line_combat_notes | line_measured_reminder | line_explicit_self_regeneration_reminder | line_controller_flash_reminder | line_stun_counter_removal_reminder | line_word_replacement_example | line_redirect_and_death_reminded | line_suspend_access_reminded | line_own_cast_grants_suspend_reminded | line_dying_creature_suspend_reminded | line_dash_reduction_reminded | line_named_spell_prohibition_reminded | line_graveyard_type_choice_reminded | line_morph_cost_reminded | line_top_card_copied_abilities_reminded | line_granted_subtype_affinity_reminded | line_granted_spell_casualty_reminded | line_granted_vanishing_reminded | line_assist_with_payer_reminder | line_preserved_loyalty_reminded | line_animated_planeswalkers_reminded | line_block_all_reminded | line_activation_color_prevention_reminded | line_noncreature_conspire_reminded | line_bushido_defined_reminder | line_life_loss_energy_reminder | line_blocker_destroy_reminder | line_exile_damaged_creature_reminder | line_sliver_grant_reminder | line_exchange_spell_controller_reminder | line_cost_symbol_reminder | line_ward_grant_reminder | line_equip_payment_reminder | line_unearth_grant_reminder | line_cycling_grant_reminder | line_historic_copy_reminder | line_spent_pair_reminder | line_hexproof_indestructible_reminder | line_role_fight_reminder | line_phaseout_group_reminder | line_behold_choice_explained | line_behold_flash_explained | line_behold_exile_explained | line_milling_mana_note | line_token_description_reminder | line_two_contextual_claims | line_measured_then_contextual_claims | line_contextual_then_measured_claims | line_two_measured_claims
/* @sem Vec<Ability>::@contextual_reminder($remindable_line, $ability_explanation) */
line_contextual_group ::= remindable_line "(" ability_explanation ")"
remindable_line ::= line_one | line_prototype | line_named_flash_if | line_counter_exile_free_permission
    | line_repeat_card_last | line_pair_enters_put | line_spell_paragraphs | line_saga | static_form_grants_goad | line_host_base_restrictions

/* The description checks the created recipe in the producing ability. */
line_token_description_reminder ::= line_single_token_description | line_plural_token_description
/* @sem Vec<Ability>::@single_token_description($token_described_line, $single_token_description) */
line_single_token_description ::= token_described_line "(" single_token_description ")"
/* @sem Vec<Ability>::@plural_token_description($token_described_line, $plural_token_description) */
line_plural_token_description ::= token_described_line "(" plural_token_description ")"
token_described_line ::= line_one | line_saga
single_token_description ::= token_artifact_single_description | the_token_artifact_description | baneslayer_angel_description | akroma_angel_of_wrath_description | giant_badger_description | tarmogoyf_description | mutavault_description | spellgorger_weird_description | gingerbrute_description | feroz_ban_description | black_lotus_description | lord_of_the_pit_description
plural_token_description ::= token_artifact_plural_description | token_enchantment_plural_description | token_creature_plural_description | scryb_sprites_description

/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], abilities:[$token_quoted]} */
token_artifact_single_description ::= "it's" "an" "artifact" "with" token_quoted
/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], abilities:[$token_quoted]} */
the_token_artifact_description ::= "the" "token" "is" "an" "artifact" "with" token_quoted
/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Artifact], abilities:[$token_quoted]} */
token_artifact_plural_description ::= "they're" "artifacts" "with" token_quoted
/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Enchantment], abilities:[$token_quoted]} */
token_enchantment_plural_description ::= "they're" "enchantments" "with" token_quoted
/* @sem TokenRecipe::Defined{name:FromSubtypes, card_types:[Creature], colors:$token_colors, subtypes:$token_subtypes, power_toughness:[$number_digits, $number_digits_2]} */
token_creature_plural_description ::= "they're" number_digits "/" number_digits token_colors token_subtypes "creatures" "."

/* Named recipes refer to a fixed definition outside the creating ability. */
/* @sem TokenRecipe::Named('Scryb Sprites') */
scryb_sprites_description ::= "they're" "{" "G" "}" "1" "/" "1" "Faerie" "creatures" "with" "flying" "."

/* @sem TokenRecipe::Named('Baneslayer Angel') */
baneslayer_angel_description ::= "it's" "a" "{" "3" "}" "{" "W" "}" "{" "W" "}" "5" "/" "5" "Angel" "creature" "with" "flying" "," "first" "strike" "," "lifelink" "," "and" "protection" "from" "Demons" "and" "from" "Dragons" "."

/* @sem TokenRecipe::Named('Giant Badger') */
giant_badger_description ::= "it's" "a" "{" "1" "}" "{" "G" "}" "{" "G" "}" "2" "/" "2" "Badger" "creature" "with" '"' "whenever" "this" "token" "blocks" "," "it" "gets" "+" "2" "/" "+" "2" "until" "end" "of" "turn" "." '"'

/* @sem TokenRecipe::Named('Tarmogoyf') */
tarmogoyf_description ::= "it's" "a" "{" "1" "}" "{" "G" "}" "Lhurgoyf" "creature" "with" '"' "Tarmogoyf's" "power" "is" "equal" "to" "the" "number" "of" "card" "types" "among" "cards" "in" "all" "graveyards" "and" "its" "toughness" "is" "equal" "to" "that" "number" "plus" "1" "." '"'

/* @sem TokenRecipe::Named('Mutavault') */
mutavault_description ::= "it's" "a" "land" "with" '"' "{" "T" "}" ":" "add" "{" "C" "}" '"' "and" '"' "{" "1" "}" ":" "this" "token" "becomes" "a" "2" "/" "2" "creature" "with" "all" "creature" "types" "until" "end" "of" "turn" "." "it's" "still" "a" "land" "." '"'

/* @sem TokenRecipe::Named('Spellgorger Weird') */
spellgorger_weird_description ::= "it's" "a" "{" "2" "}" "{" "R" "}" "2" "/" "2" "Weird" "creature" "with" '"' "whenever" "you" "cast" "a" "noncreature" "spell" "," "put" "a" "+" "1" "/" "+" "1" "counter" "on" "Spellgorger" "Weird" "." '"'

/* @sem TokenRecipe::Named('Gingerbrute') */
gingerbrute_description ::= "it's" "a" "{" "1" "}" "1" "/" "1" "Food" "Golem" "artifact" "creature" "with" "haste" "," '"' "{" "1" "}" ":" "this" "token" "can't" "be" "blocked" "this" "turn" "except" "by" "creatures" "with" "haste" "," '"' "and" '"' "{" "2" "}" "," "{" "T" "}" "," "↑" "sacrifice" "this" "token" ":" "you" "gain" "3" "life" "." '"'

/* @sem TokenRecipe::Named('Feroz''s Ban') */
feroz_ban_description ::= "it's" "a" "{" "6" "}" "artifact" "with" '"' "creature" "spells" "cost" "{" "2" "}" "more" "to" "cast" "." '"'

/* @sem TokenRecipe::Named('Black Lotus') */
black_lotus_description ::= "it's" "a" "{" "0" "}" "artifact" "with" '"' "{" "T" "}" "," "↑" "sacrifice" "this" "token" ":" "add" "three" "mana" "of" "any" "one" "color" "." '"'

/* @sem TokenRecipe::Named('Lord of the Pit') */
lord_of_the_pit_description ::= "it's" "a" "{" "4" "}" "{" "B" "}" "{" "B" "}" "{" "B" "}" "7" "/" "7" "Demon" "creature" "with" "flying" "," "trample" "," "and" '"' "at" "the" "beginning" "of" "your" "upkeep" "," "sacrifice" "another" "creature" "." "if" "you" "can't" "," "this" "token" "deals" "7" "damage" "to" "you" "." '"'

/* A single native ability owns the complete phased-out group. */
/* @sem Vec<Ability>::@contextual_reminder($line_one, $phaseout_each_controller_explanation) */
line_phaseout_group_reminder ::= line_one "(" phaseout_each_controller_explanation ")"

/* Both sentences describe the same spell-copy trigger. */
/* @sem Vec<Ability>::@contextual_reminder(@contextual_reminder($remindable_line, $historic_explanation), $token_copy_spell_rule_context_explanation) */
line_historic_copy_reminder ::= remindable_line "(" historic_explanation token_copy_spell_rule_context_explanation ")"

/* @sem Vec<Ability>::@contextual_reminder(@contextual_reminder($remindable_line, $grant_hexproof_explanation), $grant_indestructible_explanation) */
line_hexproof_indestructible_reminder ::= remindable_line "(" grant_hexproof_explanation grant_indestructible_explanation ")"

/* @sem Vec<Ability>::@contextual_reminder(@contextual_reminder($remindable_line, $monster_role_explanation), $fight_creatures_explanation) */
line_role_fight_reminder ::= remindable_line "(" monster_role_explanation fight_creatures_explanation ")"
/* @sem String::'Fight' */
fight_creatures_explanation ::= "creatures" "that" "fight" "each" "deal" "damage" "equal" "to" "their" "power" "to" "the" "other" "."

/* @sem Vec<Ability>::@ward_grant_reminder($remindable_line, $ward_grant_explanation) */
line_ward_grant_reminder ::= remindable_line "(" ward_grant_explanation ")"

/* @sem Ability::[@equip_payment_reminder($equip_reduced_line, $equip_explained_cost)] */
line_equip_payment_reminder ::= equip_reduced_line "(" equip_explained_cost ")"
equip_reduced_line ::= equip_live_reduction | keyword_equip_target_reduction | equip_conditional_activation_reduction

/* @sem Vec<Ability>::@spent_pair_reminder($remindable_line, $spent_pair_explanation) */
line_spent_pair_reminder ::= remindable_line "(" spent_pair_explanation ")"
/* @sem Operand::Cost(Cost{parts:[Mana($mana_symbols)]}) */
spent_pair_explanation ::= "do" "both" "if" mana_symbols "was" "spent" "."

/* The activation and the explanation designate the same source creature. */
/* @sem Ability::[WithPresentation{reminder:true, ability:Activated{origin:Ordinary, cost:$cost, limits:ActivationLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:CreateRegenerationShields{objects:One(Source)}}]}}}] */
line_explicit_self_regeneration_reminder ::= cost ":" "regenerate" "this" "creature" "." "(" self_regeneration_rule_words ")"

/* An explanation following a payment belongs to the ability's own cost. */
/* @sem Ability::[@cost_symbol_reminder($ability_cost_note_head, $cost_note)] */
line_cost_symbol_reminder ::= ability_cost_note_head cost_note
ability_cost_note_head ::= ability | keyword_equip | keyword_equip_once_word | keyword_flashback

/* The explanation repeats a numeric operand from the native action. */
/* @sem Vec<Ability>::@measured_reminder($remindable_line, $measured_explanation) */
/* @prefer always */
line_measured_reminder ::= remindable_line "(" measured_explanation ")"
measured_explanation ::= token_surveil_library_explanation | expend_six_explanation | expend_eight_explanation | token_surveil_two_explanation | granted_renown_singular_explanation | bolster_written_x_explanation | mill_others_each_top_explanation | mill_every_player_top_explanation | discover_number_definition | monstrosity_explanation | monstrosity_one_explanation | mill_number_explanation | incubation_explanation | discover_explanation | toxic_number_explanation
    | scry_context_amount | surveil_context_amount | surveil_defining_amount | mill_controller_explanation
    | adapt_context_amount | renown_one_explanation | renown_number_explanation | bloodthirst_one_explanation | bloodthirst_number_explanation | bloodthirst_granted_number_explanation
    | earthbend_measured_explanation | earthbend_definition_explanation | earthbend_x_definition_explanation | bolster_measured_explanation | amass_zombies_measured_explanation | amass_orcs_measured_explanation | connive_x_explanation
    | bolster_definition_explanation | amass_orcs_definition_explanation | amass_zombies_definition_explanation
    | expend_four_measured_explanation | mill_them_measured_explanation | mill_them_one_explanation | mill_any_actor_measured_explanation
    | mill_each_player_one_explanation | mill_each_player_top_card_explanation
    | mill_controller_one_explanation | collect_evidence_measured_explanation | collect_evidence_x_explanation
    | scry_defining_one_explanation | scry_defining_many_explanation
    | scry_defining_one_separate_sentence | surveil_defining_x_explanation
    | firebending_granted_explanation | firebending_source_explanation | monstrosity_x_explanation | collect_evidence_short_explanation
    | surveil_defining_one_explanation | optional_controller_mill_explanation | optional_controller_mill_one_explanation
    | blight_measured_explanation | blight_effect_explanation | incubation_defining_explanation | adapt_one_explanation
    | surveil_look_x_explanation | firebending_token_explanation
    | toxic_recipient_one_explanation | toxic_group_one_explanation | toxic_equipped_one_explanation
    | toxic_recipient_many_explanation | toxic_creature_one_explanation
    | impending_explanation | endure_one_explanation | endure_many_explanation
/* @sem Operand::List([Text(Impending), Number($number_words)]) */
impending_explanation ::= "if" "you" "cast" "this" "spell" "for" "its" "impending" "cost" "," "it" "enters" "with" number_words "time" "counters" "and" "isn't" "a" "creature" "until" "the" "last" "is" "removed" "." "at" "the" "beginning" "of" "your" "end" "step" "," "remove" "a" "time" "counter" "from" "it" "."
/* @sem Operand::List([Text(Endure), Number(Constant(1))]) */
endure_one_explanation ::= "put" "a" "+" "1" "/" "+" "1" "counter" "on" "it" "or" "create" "a" "1" "/" "1" "white" "Spirit" "creature" "token" "."
/* @sem Operand::List([Text(Endure), Number(@agree($printed_many_plus_one_counters, $endure_spirit_stats))]) */
endure_many_explanation ::= "put" printed_many_plus_one_counters "on" "it" "or" "create" "a" endure_spirit_stats "white" "Spirit" "creature" "token" "."
/* @sem Expr::@agree($number_digits, $number_digits_2) */
endure_spirit_stats ::= number_digits "/" number_digits
/* @sem Operand::List([Text(Monstrosity), Number($number_words)]) */
monstrosity_explanation ::= "if" "this" "creature" "isn't" "monstrous" "," "put" number_words "+" "1" "/" "+" "1" "counters" "on" "it" "and" "it" "becomes" "monstrous" "."
/* @sem Operand::List([Text(Monstrosity), Number(Constant(1))]) */
monstrosity_one_explanation ::= "if" "this" "creature" "isn't" "monstrous" "," "put" "a" "+" "1" "/" "+" "1" "counter" "on" "it" "and" "it" "becomes" "monstrous" "."
/* @sem Operand::List([Text(Mill), Number(@agree($number_words, $number_words_2))]) */
mill_number_explanation ::= "to" "mill" number_words "cards" "," "put" "the" "top" number_words "cards" "of" "your" "library" "into" "your" "graveyard" "."
/* @sem Operand::List([Text(Incubate), Number($incubation_explanation_amount)]) */
incubation_explanation ::= incubation_explanation_amount
/* @sem Operand::List([Text(Incubate), Number(@agree($number_digits, $incubation_explanation_amount))]) */
incubation_defining_explanation ::= "to" "incubate" number_digits "," incubation_explanation_amount
/* @sem $printed_plus_one_counters */
incubation_explanation_amount ::= "create" "an" "Incubator" "token" "with" printed_plus_one_counters "on" "it" "and" '"' "{" "2" "}" ":" "transform" "this" "token" "." '"' "it" "transforms" "into" "a" "0" "/" "0" "Phyrexian" "artifact" "creature" "."
/* @sem Operand::List([Text(Discover), Number($number_digits)]) */
discover_explanation ::= "exile" "cards" "from" "the" "top" "of" "your" "library" "until" "you" "exile" "a" "nonland" "card" "with" "mana" "value" number_digits "or" "less" "." discover_explanation_resolution
/* @sem Operand::List([Text(Toxic), Number($number_words)]) */
toxic_number_explanation ::= "players" "dealt" "combat" "damage" "by" "this" "creature" "also" "get" number_words "poison" "counters" "."
/* @sem Operand::List([Text(Toxic), Number(Constant(1))]) */
toxic_recipient_one_explanation ::= "players" "dealt" "combat" "damage" "by" "it" "also" "get" "a" "poison" "counter" "."
/* @sem Operand::List([Text(Toxic), Number(Constant(1))]) */
toxic_group_one_explanation ::= "players" "dealt" "combat" "damage" "by" "them" "also" "get" "a" "poison" "counter" "."
/* @sem Operand::List([Text(Scry), Number($scry_look_explanation)]) */
scry_context_amount ::= scry_look_explanation
/* @sem Operand::List([Text(Surveil), Number($surveil_look_explanation)]) */
surveil_context_amount ::= surveil_look_explanation
/* @sem Operand::List([Text(Surveil), Number(@agree($number_digits, $surveil_look_many))]) */
surveil_defining_amount ::= "to" "surveil" number_digits "," surveil_look_many
/* @sem Operand::List([Text(Surveil), Number(@agree($number_digits, $surveil_look_one_explanation))]) */
surveil_defining_one_explanation ::= "to" "surveil" number_digits "," surveil_look_one_explanation
surveil_look_one_explanation ::= surveil_look_one | surveil_look_one_named
/* @sem Operand::List([Text(ControllerMill), Number($number_words)]) */
mill_controller_explanation ::= "put" "the" "top" number_words "cards" "of" "your" "library" "into" "your" "graveyard" "."
/* @sem Operand::List([Text(OptionalControllerMill), Number($number_words)]) */
optional_controller_mill_explanation ::= "you" "may" "put" "the" "top" number_words "cards" "of" "your" "library" "into" "your" "graveyard" "."
/* @sem Operand::List([Text(OptionalControllerMill), Number(Constant(1))]) */
optional_controller_mill_one_explanation ::= "you" "may" "put" "the" "top" "card" "of" "your" "library" "into" "your" "graveyard" "."
/* @sem Operand::List([Text(Blight), Number(@agree($number_digits, $blight_explanation_counters))]) */
blight_measured_explanation ::= "to" "blight" number_digits "," "put" blight_explanation_counters "on" "a" "creature" "you" "control" "."
blight_explanation_counters ::= blight_explanation_one | blight_explanation_many
/* @sem Expr::Constant(1) */
blight_explanation_one ::= "a" "-" "1" "/" "-" "1" "counter"
/* @sem $number_words */
