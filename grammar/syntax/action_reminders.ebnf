explores_many_reminded ::= object_explores_number_times "." "(" "to" "have" "it" "explore" "," explore_rules_prefix "that" "creature" explore_rules_suffix ")"
/* @sem Instruction::[Effect{result:@next, operation:$each_explores}] */
each_explores_reminded ::= each_explores "." "(" explore_rules_prefix "the" "exploring" "creature" explore_rules_suffix ")"

/* @sem Instruction::[...$clause, ...$surveil_reminded] */
reminder_before_surveil ::= clause "and" surveil_reminded

