foretold_hand_card_reminded ::= instructions_draw_foretell "." "(" "on" "a" "later" "turn" "," "you" "may" "cast" "it" "for" "its" "foretell" "cost" "," "even" "if" "this" "creature" "has" "left" "the" "battlefield" "." ")"

/* The Dash reduction has ordinary battlefield activity. */
/* @sem Ability::[WithPresentation{reminder:true, ability:Static{kind:Ordinary, affected:Players($target_tax_casters), changes:[PlayerRule(KeywordCost{keyword:$reduced_payment_keyword, cards:Any, change:Reduce($single_generic_reduction)})]}}] */
line_dash_reduction_reminded ::= reduced_payment_keyword "costs" target_tax_casters "pay" "cost" single_generic_reduction "less" "(" "↓" "as" "long" "as" "this" "creature" "is" "on" "the" "battlefield" ")" "."

/* The reminder belongs to the typed Assist grant for the same first spell. */
/* @sem Ability::[$first_unqualified_assist_turn_grant, WithPresentation{reminder:true, ability:$first_spell_other_payer_trigger}] */
line_assist_with_payer_reminder ::= first_unqualified_assist_turn_grant first_spell_other_payer_trigger "(" "as" "you" "cast" "a" "spell" "with" "assist" "," "you" "may" "choose" "another" "player" "." "they" "may" "pay" "some" "or" "all" "of" "the" "generic" "mana" "in" "the" "spell's" "cost" "." ")"
/* @sem Ability::Conditional{condition:PlayerIsActive(AbilityController), then:[Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellsHaveAbilities{spells:Any, nth_each_turn:Constant(1), abilities:List([$first_spell_effect_assist])})]}]} */
first_unqualified_assist_turn_grant ::= "the" "first" "spell" "you" "cast" "during" "each" "of" "your" "turns" "has" first_spell_effect_assist "."

/* The casting and copy explanation matches the exact scope of the Conspire grant. */
/* @sem Ability::[WithPresentation{reminder:true, ability:Static{kind:Ordinary, affected:Objects(Zone{scope:Shared(Stack), kind:Spell, filter:AllOf([$non_creature, Cast{by:One(AbilityController)}])}), changes:[GrantAbility(@holder($bare_conspire))]}}] */
line_noncreature_conspire_reminded ::= "each" non_creature "spell" "you" "cast" "has" bare_conspire "." "(" "as" "you" "cast" "a" "noncreature" "spell" "," "you" "may" "tap" "two" "untapped" "creatures" "you" "control" "that" "share" "a" "color" "with" "it" "." "when" "you" "do" "," "copy" "it" "and" "you" "may" "choose" "new" "targets" "for" "the" "copy" "." permanent_spell_copy_rule_words ")"

/* Each explanation repeats the sacrifice's native power floor. */
/* @sem $number_digits */
casualty_reminder_power_floor ::= "you" "may" "sacrifice" "a" "creature" "with" "power" number_digits "or" "greater" "."

line_granted_spell_casualty_reminded ::= line_first_retarget_casualty_reminded | line_first_artifact_casualty_reminded
/* @sem Ability::[WithPresentation{reminder:true, ability:Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellsHaveAbilities{spells:$first_player_spell_filter, nth_each_turn:Constant(1), abilities:List([$first_retarget_casualty_reminded])})]}}] */
line_first_retarget_casualty_reminded ::= "the" "first" first_player_spell_filter "spell" "you" "cast" "each" "turn" "has" first_retarget_casualty_reminded
/* @sem Ability::[WithPresentation{reminder:true, ability:Static{kind:Ordinary, affected:Players(One(AbilityController)), changes:[PlayerRule(SpellsHaveAbilities{spells:$first_casualty_artifact_filter, nth_each_turn:Constant(1), abilities:List([$first_artifact_casualty_reminded])})]}}] */
line_first_artifact_casualty_reminded ::= "the" "first" first_casualty_artifact_filter "spell" "you" "cast" "each" "turn" "has" first_artifact_casualty_reminded
/* @sem ObjectFilter::AllOf([Not(Supertype(Legendary)), $noun_artifact]) */
first_casualty_artifact_filter ::= "nonlegendary" noun_artifact
/* @sem Operand::Term{family:SpellEffect, form:Casualty, operands:[Number(Expr::@agree($value, $casualty_reminder_power_floor))]} */
first_retarget_casualty_reminded ::= "casualty" value "." "(" "as" "you" "cast" "that" "spell" "," casualty_reminder_power_floor "when" "you" "do" "," "copy" "the" "spell" "and" "you" "may" "choose" "new" "targets" "for" "the" "copy" "." ")"
/* @sem Operand::Term{family:SpellEffect, form:Casualty, operands:[Number(Expr::@agree($value, $casualty_reminder_power_floor))]} */
first_artifact_casualty_reminded ::= "casualty" value "." "(" "as" "you" "cast" "it" "," casualty_reminder_power_floor "when" "you" "do" "," "copy" "it" "." "a" "copy" "of" "an" "artifact" "spell" "becomes" "a" "token" "." ")"

/* The ability belongs to the same card selected earlier in the resolving program. */
/* @sem Instruction::[Effect{result:@next, operation:CreatePerpetualEffect{objects:$perpetual_affected_subject, changes:[GrantAbility(Mechanic{mechanic:$mechanic_casualty_name, amount:Expr::@agree($value, $casualty_reminder_power_floor)})]}}] */
perpetual_selected_casualty_reminded ::= perpetual_affected_subject "perpetually" "gains" mechanic_casualty_name value "." "(" "as" "you" "cast" "this" "spell" "," casualty_reminder_power_floor "when" "you" "do" "," "copy" "this" "spell" "and" "you" "may" "choose" "a" "new" "target" "for" "the" "copy" "." ")"

/* Vanishing is granted to the creature receiving the time counters. */
/* @sem Ability::[WithPresentation{reminder:true, ability:Triggered{event:Object{event:TurnsFaceUp, objects:SameObject(Source)}, limits:TriggerLimits{}, announcement:@announcement, body:Program{instructions:[Effect{result:@next, operation:PutCounters{placements:[_{recipients:Objects(One(EventSubject)), kind:$cn_time, amount:$number_words}]}}, Effect{result:@next, operation:CreateContinuousEffect{source:Source, affected:Objects(One(EventSubject)), changes:[GrantAbility($bare_vanishing)], duration:Indefinite, evaluation:Snapshot}}]}}}] */
line_granted_vanishing_reminded ::= "when" self_creature "is" "turned" "face" "up" "," "put" number_words cn_time "counters" "on" "it" "and" "it" "gains" bare_vanishing "." "(" "at" "the" "beginning" "of" "your" "upkeep" "," "remove" "a" "time" "counter" "from" "it" "." "when" "the" "last" "is" "removed" "," "sacrifice" "it" "." ")"

/* The return binds the finality counter to the arriving card. */
/* @sem Instruction::[Effect{result:@next, operation:Move{objects:One($target_card), destination:Battlefield{controller:Player(AbilityController), arrival:BattlefieldArrival{tapped:false, counters:[[$cn_finality, $entry_counter_amount]], states:[]}}}}] */
return_finality_reminded ::= "return" target_card "to" "the" "battlefield" "with" entry_counter_amount cn_finality "counter" "on" "it" "." "(" "if" "it" "would" "die" "," "exile" "it" "instead" "." ")"
