/* The printed activation belongs to the granted card's graveyard ability. */
/* @sem Vec<Ability>::@unearth_grant_reminder($remindable_line, $unearth_grant_explanation) */
line_unearth_grant_reminder ::= remindable_line "(" unearth_grant_explanation ")"
unearth_grant_explanation ::= unearth_return_card_explanation | unearth_return_from_your_graveyard | unearth_pay_its_mana_cost

/* @sem Operand::Cost($cost) */
unearth_return_card_explanation ::= cost ":" "return" "the" "card" "to" "the" "battlefield" "." "the" "creature" "gains" "haste" "." unearth_delayed_exile_words
/* @sem Operand::Cost($cost) */
unearth_return_from_your_graveyard ::= cost ":" "return" "the" "card" "from" "your" "graveyard" "to" "the" "battlefield" "." "it" "gains" "haste" "." unearth_delayed_exile_words
/* @sem Operand::Cost(Cost{parts:[ManaCostOf(Source)]}) */
unearth_pay_its_mana_cost ::= "pay" "the" "card's" "mana" "cost" ":" "return" "it" "to" "the" "battlefield" "." "the" "creature" "gains" "haste" "." unearth_delayed_exile_words
/* @sem () */
unearth_delayed_exile_words ::= "exile" "it" "at" "the" "beginning" "of" "the" "next" "end" "step" "or" "if" "it" "would" "leave" "the" "battlefield" "." "unearth" "only" "as" "a" "sorcery" "."

/* The receiving card is the source of its own hand-zone activation. */
/* @sem Vec<Ability>::@cycling_grant_reminder($remindable_line, $cycling_grant_explanation) */
line_cycling_grant_reminder ::= remindable_line "(" cycling_grant_explanation ")"
/* @sem Operand::Cost(Cost{parts:[...$cost_parts, Discard{count:Constant(1), filter:SameObject(Source)}]}) */
cycling_grant_explanation ::= cost_parts "," "↑" "discard" "that" "card" ":" "draw" "a" "card" "."

