cascade_entry_reminded ::= static_cascade_entry_permission "(" "do" "this" "after" "the" "last" "card" "is" "exiled" "but" "before" "deciding" "whether" "to" "cast" "a" "nonland" "card" "." ")"

/* @sem $unique_all_damage_withers */
all_damage_withers_reminded ::= unique_all_damage_withers "(" "a" "source" "with" "wither" "deals" "damage" "to" "creatures" "in" "the" "form" "of" "-" "1" "/" "-" "1" "counters" "." ")"

/* @sem $instructions_explore_twice */
explore_twice_reminded ::= instructions_explore_twice "." "(" repeated_explore_rules ")"
/* @sem () */
repeated_explore_rules ::= explore_rules_prefix "that" "creature" explore_rules_suffix "then" "repeat" "this" "process" "."
/* @sem () */
explore_rules_prefix ::= "reveal" "the" "top" "card" "of" "your" "library" "." "put" "that" "card" "into" "your" "hand" "if" "it's" "a" "land" "." "otherwise" "," "put" "a" "+" "1" "/" "+" "1" "counter" "on"
/* @sem () */
explore_rules_suffix ::= "," "then" "put" "the" "card" "back" "or" "put" "it" "into" "your" "graveyard" "."

