/* The stopping card is the only creature card in the exile receipt; the
   other cards return to the original owner's library. */
/* @sem Ability::[WithPresentation{reminder:true,ability:Triggered{event:$assimilate_trigger_header,limits:TriggerLimits{},announcement:@announcement,body:_{instructions:[Effect{result:@next,operation:RevealUntil{library:$target_opponent,filter:CardType(Creature),count:Constant(1)}},Effect{result:@mark,operation:Move{objects:Observed(@prior),destination:Exile{visibility:FaceUp,arrival:ExileArrival{}},qualifiers:[]}},ForEachObject{objects:Matching{objects:InZone{objects:Transition{result:@marked,phase:After},zone:Exile},filter:CardType(Creature)},binding:0,body:_{instructions:[Effect{result:@next,operation:Keyword{actor:One(AbilityController),action:Assimilate{object:Bound(0)}}}]}},Effect{result:@next,operation:Move{objects:Matching{objects:InZone{objects:Transition{result:@marked,phase:After},zone:Exile},filter:Not(CardType(Creature))},destination:Library{position:Bottom,order:$library_order,arrival:CardArrival{}},qualifiers:[]}}]}}}] */
