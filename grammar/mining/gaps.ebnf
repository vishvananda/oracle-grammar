/* The tail as the phrase miner loads it: no single-card rules, and each phrase family
   able to read a gap token. A reading through a gap holds that family's sentinel, and
   the IR at the sentinel's place says what the words in the gap mean. */
tail_ability ::= never_tail_ability
/* @sem () */
never_tail_ability ::= "never"
tail_instruction ::= gap_instruction
/* @sem Instruction::[@gap(15)] */
gap_instruction ::= "□"
tail_instructions ::= never_tail_instructions
/* @sem () */
never_tail_instructions ::= "never"
tail_condition ::= gap_condition
/* @sem @gap(0) */
gap_condition ::= "□"
tail_event ::= gap_event
/* @sem @gap(1) */
gap_event ::= "□"
tail_change ::= gap_change
/* @sem @gap(2) */
gap_change ::= "□"
tail_filter ::= gap_filter
/* @sem @gap(3) */
gap_filter ::= "□"
tail_plural ::= gap_plural
/* @sem @gap(4) */
gap_plural ::= "□"
tail_value ::= gap_value
/* @sem @gap(5) */
gap_value ::= "□"
tail_cards ::= gap_cards
/* @sem @gap(6) */
gap_cards ::= "□"
tail_ref ::= gap_ref
/* @sem @gap(7) */
gap_ref ::= "□"
tail_set ::= gap_set
/* @sem @gap(8) */
gap_set ::= "□"
tail_player ::= gap_player
/* @sem @gap(9) */
gap_player ::= "□"
tail_players ::= gap_players
/* @sem @gap(10) */
gap_players ::= "□"
tail_each ::= gap_each
/* @sem @gap(11) */
gap_each ::= "□"
tail_recipients ::= gap_recipients
/* @sem @gap(12) */
gap_recipients ::= "□"
tail_operation ::= gap_operation
/* @sem @gap(13) */
gap_operation ::= "□"
tail_costpart ::= gap_costpart
/* @sem @gap(14) */
gap_costpart ::= "□"
