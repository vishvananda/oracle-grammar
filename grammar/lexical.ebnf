/* Lexical grammar. These classes are what src/tokens.rs produces. A syntactic
   rule refers to them by name; every other terminal there is one whole token. */
NUMBER ::= [0-9]+
WORD ::= [A-Za-z] [A-Za-z'-]*
CAPITALIZED ::= [A-Z] [A-Za-z'-]*
/* Bound to the card's name and short names, which the tokenizer takes as input. */
SELF_NAME ::= WORD
NEWLINE ::= #xA
