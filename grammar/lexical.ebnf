/* Lexical grammar. These classes are what src/tokens.rs produces. A syntactic
   rule refers to them by name; every other terminal there is one whole token. */
/* The exact marker … represents the spaced ellipsis ". . ." as one token. */
/* The exact marker ” represents an unpaired closing ASCII quote in a reminder. */
/* Thousands separators group exactly three digits, as in 1,000. */
NUMBER ::= [0-9]+ | [0-9] [0-9]? [0-9]? ("," [0-9] [0-9] [0-9])+
/* Numeric words, including ordinals and die notation, are exact syntax literals. */
WORD ::= [A-Za-z] [A-Za-z'-]*
CAPITALIZED ::= [A-Z] [A-Za-z'-]*
/* Bound to the card's name and short names, which the tokenizer takes as input. */
SELF_NAME ::= WORD
/* The unshortened spelling, from the same bounded card name context. */
SELF_FULL_NAME ::= WORD
NEWLINE ::= #xA
