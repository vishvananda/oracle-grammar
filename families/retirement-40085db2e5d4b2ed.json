    {
      "name": "Oura, the Imitator",
      "text": "As long as the top card of your library is a Faerie or instant card, you may look at it any time and you may cast it.",
      "expected": [
        {
          "kind": "Conditional",
          "args": {
            "condition": {
              "kind": "ObjectMatches",
