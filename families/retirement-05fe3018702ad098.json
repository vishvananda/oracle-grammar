    {
      "name": "baseline",
      "text": "During your turn, spells you cast from your hand with mana value X or less have cascade, where X is the total amount of life your opponents have lost this turn.",
      "types": [
        "Creature"
      ],
      "expected": [
        {
          "kind": "Conditional",
          "args": {
            "condition": {
